      "formatted_start": "01:50:20.000",
      "formatted_end": "01:50:22.000",
      "text": "روزی 3 باش بهش."
    },
    {
      "id": 11,
      "start": 6622.0,
      "end": 6624.0,
      "formatted_start": "01:50:22.000",
      "formatted_end": "01:50:24.000",
      "text": "روزی 3 باش بهش."
    },
    {
      "id": 12,
      "start": 6624.0,
      "end": 6626.0,
      "formatted_start": "01:50:24.000",
      "formatted_end": "01:50:26.000",
      "text": "مانتا چون این ویروسه،"
    },
    {
      "id": 13,
      "start": 6626.0,
      "end": 6628.0,
      "formatted_start": "01:50:26.000",
      "formatted_end": "01:50:28.000",
      "text": "و سیستم ایمینشون رو تغییر کنید"
    },
    {
      "id": 14,
      "start": 6628.0,
      "end": 6631.0,
      "formatted_start": "01:50:28.000",
      "formatted_end": "01:50:31.000",
      "text": "3 شهبت به وینک براش داریم"
    },
    {
      "id": 15,
      "start": 6631.0,
      "end": 6634.0,
      "formatted_start": "01:50:31.000",
      "formatted_end": "01:50:34.000",
      "text": "روزی 10 کلیسی بهش بده"
