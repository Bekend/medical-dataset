      "text": "باشه بگیم"
    },
    {
      "id": 78,
      "start": 6775.54,
      "end": 6777.54,
      "formatted_start": "01:52:55.540",
      "formatted_end": "01:52:57.540",
      "text": "باشه"
    },
    {
      "id": 79,
      "start": 6777.54,
      "end": 6779.54,
      "formatted_start": "01:52:57.540",
      "formatted_end": "01:52:59.540",
      "text": "از دفعه من سخت هم میگرم"
    },
    {
      "id": 80,
      "start": 6779.54,
      "end": 6781.54,
      "formatted_start": "01:52:59.540",
      "formatted_end": "01:53:01.540",
      "text": "ماشالله قدرتو برداشت خوبه"
    },
    {
      "id": 81,
      "start": 6781.54,
      "end": 6783.54,
      "formatted_start": "01:53:01.540",
      "formatted_end": "01:53:03.540",
      "text": "بچه چهار ساله بعد یه متر باشن"
    },
    {
      "id": 82,
      "start": 6783.54,
      "end": 6785.54,
      "formatted_start": "01:53:03.540",
      "formatted_end": "01:53:05.540",
      "text": "دفعه لبلا بردیم"
    },
    {
      "id": 83,
      "start": 6785.54,
      "end": 6787.54,
      "formatted_start": "01:53:05.540",
      "formatted_end": "01:53:07.540",
      "text": "میجنم سی ست بود"
    },
    {
      "id": 84,
      "start": 6787.54,
      "end": 6789.54,
      "formatted_start": "01:53:07.540",
      "formatted_end": "01:53:09.540",
      "text": "دوباره از اون دستی کنید"
    },
    {
      "id": 85,
      "start": 6791.86,
      "end": 6794.3,
      "formatted_start": "01:53:11.860",
      "formatted_end": "01:53:14.300",
      "text": "خب اول از کن خستو شدید یه فایدی"
    },
    {
      "id": 86,
      "start": 6794.3,
      "end": 6796.3,
      "formatted_start": "01:53:14.300",
      "formatted_end": "01:53:16.300",
      "text": "تو رو برداشتون"
    },
    {
      "id": 87,
      "start": 6796.3,
      "end": 6797.3,
      "formatted_start": "01:53:16.300",
      "formatted_end": "01:53:17.300",
      "text": "یه در من؟"
    },
    {
      "id": 88,
      "start": 6797.3,
      "end": 6799.3,
      "formatted_start": "01:53:17.300",
      "formatted_end": "01:53:19.300",
      "text": "یه پنکه دیگه جدی کن کنه"
    },
    {
      "id": 89,
      "start": 6799.3,
      "end": 6801.3,
      "formatted_start": "01:53:19.300",
      "formatted_end": "01:53:21.300",
      "text": "اینو خب دکتر از پنکه ای تو داره، دیدی؟"
    },
    {
      "id": 90,
      "start": 6801.3,
      "end": 6803.3,
      "formatted_start": "01:53:21.300",
      "formatted_end": "01:53:23.300",
      "text": "ای از اون نداری؟"
    },
    {
      "id": 91,
      "start": 6803.3,
      "end": 6806.3,
      "formatted_start": "01:53:23.300",
      "formatted_end": "01:53:26.300",
      "text": "یه دونه آریا بقیه داد مال فوتوشه"
    },
    {
      "id": 92,
      "start": 6807.3,
      "end": 6809.3,
      "formatted_start": "01:53:27.300",
      "formatted_end": "01:53:29.300",
      "text": "اون بچه ای اون پنکه دیگهش"
    },
    {
      "id": 93,
      "start": 6810.3,
      "end": 6813.3,
      "formatted_start": "01:53:30.300",
      "formatted_end": "01:53:33.300",
      "text": "فقط این چون فلنگیه خیلی موازنه باشه"
    },
    {
      "id": 94,
      "start": 6813.3,
      "end": 6817.3,
      "formatted_start": "01:53:33.300",
      "formatted_end": "01:53:37.300",
      "text": "آره، نمیگی داره، اصلا دستش"
    },
    {
      "id": 95,
      "start": 6817.3,
      "end": 6819.3,
      "formatted_start": "01:53:37.300",
      "formatted_end": "01:53:39.300",
      "text": "دیدید؟"
    },
    {
      "id": 96,
      "start": 6819.3,
      "end": 6821.3,
      "formatted_start": "01:53:39.300",
      "formatted_end": "01:53:41.300",
      "text": "خدمتش"
    },
    {
      "id": 97,
      "start": 6821.3,
      "end": 6823.3,
      "formatted_start": "01:53:41.300",
      "formatted_end": "01:53:43.300",
      "text": "خوش آمدید"
    },
    {
      "id": 98,
      "start": 6823.3,
      "end": 6825.3,
      "formatted_start": "01:53:43.300",
      "formatted_end": "01:53:45.300",
      "text": "اشاده سو خوب میشه"
    },
    {
      "id": 99,
      "start": 6825.3,
      "end": 6827.3,
      "formatted_start": "01:53:45.300",
      "formatted_end": "01:53:47.300",
      "text": "استراحه خوب کنه مایه آده بیاد بشکنید"
    },
    {
      "id": 100,
      "start": 6827.3,
      "end": 6829.3,
      "formatted_start": "01:53:47.300",
      "formatted_end": "01:53:49.300",
      "text": "بخوره سوپ بشکنید"
    },
    {
      "id": 101,
      "start": 6829.3,
      "end": 6831.3,
      "formatted_start": "01:53:49.300",
      "formatted_end": "01:53:51.300",
      "text": "چیزایی پر پروتین مثل گشت و مرگ و"
    },
    {
      "id": 102,
      "start": 6831.3,
      "end": 6833.3,
      "formatted_start": "01:53:51.300",
      "formatted_end": "01:53:53.300",
      "text": "این هم بشکنید اشاده سو خود"
    },
    {
      "id": 103,
      "start": 6833.3,
      "end": 6835.3,
      "formatted_start": "01:53:53.300",
      "formatted_end": "01:53:55.300",
      "text": "خوش آمدید خادم"
    },
    {
      "id": 104,
      "start": 6835.3,
      "end": 6837.3,
      "formatted_start": "01:53:55.300",
      "formatted_end": "01:53:57.300",
      "text": "اینو برم بگم"
    },
    {
      "id": 105,
      "start": 6837.3,
      "end": 6839.3,
      "formatted_start": "01:53:57.300",
      "formatted_end": "01:53:59.300",
      "text": "خدا نگردید"
    },
    {
      "id": 106,
      "start": 6839.3,
      "end": 6841.3,
      "formatted_start": "01:53:59.300",
      "formatted_end": "01:54:01.300",
      "text": "خاندو گردید"
    },
    {
      "id": 107,
      "start": 6841.3,
      "end": 6843.3,
      "formatted_start": "01:54:01.300",
      "formatted_end": "01:54:03.300",
      "text": "خاندو سو بچه"
    },
    {
      "id": 108,
      "start": 6843.3,
      "end": 6845.3,
      "formatted_start": "01:54:03.300",
      "formatted_end": "01:54:05.300",
      "text": "چهل و چهار روزه میتونه"
    },
    {
      "id": 109,
      "start": 6845.3,
      "end": 6846.3,
      "formatted_start": "01:54:05.300",
      "formatted_end": "01:54:06.300",
      "text": "بخوره؟"
    },
    {
      "id": 110,
      "start": 6846.3,
      "end": 6847.3,
      "formatted_start": "01:54:06.300",
      "formatted_end": "01:54:07.300",
      "text": "آمیدوار"
    },
    {
      "id": 111,
      "start": 6847.3,
      "end": 6849.3,
      "formatted_start": "01:54:07.300",
      "formatted_end": "01:54:09.300",
      "text": "خب، انا آنجنانی دیروز اومده بود"
    },
    {
      "id": 112,
      "start": 6849.3,
      "end": 6852.3,
      "formatted_start": "01:54:09.300",
      "formatted_end": "01:54:12.300",
      "text": "میگه خانداشو تو سیستم برنامه سخت نکرده"
    },
    {
      "id": 113,
      "start": 6852.3,
      "end": 6853.3,
      "formatted_start": "01:54:12.300",
      "formatted_end": "01:54:13.300",
      "text": "سلام"
    },
    {
      "id": 114,
      "start": 6853.3,
      "end": 6855.3,
      "formatted_start": "01:54:13.300",
      "formatted_end": "01:54:15.300",
      "text": "سلام، حالشون؟ خوبی؟"
    },
    {
      "id": 115,
      "start": 6855.3,
      "end": 6857.3,
      "formatted_start": "01:54:15.300",
      "formatted_end": "01:54:17.300",
      "text": "خیلی مرسی، ممنون"
    },
    {
      "id": 116,
      "start": 6857.3,
      "end": 6859.3,
      "formatted_start": "01:54:17.300",
      "formatted_end": "01:54:19.300",
      "text": "چه برنامه؟"
    },
    {
      "id": 117,
      "start": 6859.3,
      "end": 6861.3,
      "formatted_start": "01:54:19.300",
      "formatted_end": "01:54:21.300",
      "text": "بخورم قطعه"
    },
    {
      "id": 118,
      "start": 6861.3,
      "end": 6863.3,
      "formatted_start": "01:54:21.300",
      "formatted_end": "01:54:23.300",
      "text": "کوالی فول"
    },
    {
      "id": 119,
      "start": 6863.3,
      "end": 6864.3,
      "formatted_start": "01:54:23.300",
      "formatted_end": "01:54:24.300",
      "text": "آزاده؟"
    },
    {
      "id": 120,
      "start": 6864.3,
      "end": 6865.3,
      "formatted_start": "01:54:24.300",
      "formatted_end": "01:54:25.300",
      "text": "آره"
    },
    {
      "id": 121,
      "start": 6869.3,
      "end": 6871.3,
      "formatted_start": "01:54:29.300",
      "formatted_end": "01:54:31.300",
      "text": "کوالی فول"
    },
    {
      "id": 122,
      "start": 6872.3,
      "end": 6874.3,
      "formatted_start": "01:54:32.300",
      "formatted_end": "01:54:34.300",
      "text": "آره، اینو بگیره، روزی اکتسیب"
    },
    {
      "id": 123,
      "start": 6875.3,
      "end": 6877.3,
      "formatted_start": "01:54:35.300",
      "formatted_end": "01:54:37.300",
      "text": "از اینجا میتونیم شروع کنیم"
    },
    {
      "id": 124,
      "start": 6877.3,
      "end": 6879.3,
      "formatted_start": "01:54:37.300",
      "formatted_end": "01:54:39.300",
      "text": "آره از این نیست"
    },
    {
      "id": 125,
      "start": 6879.3,
      "end": 6881.3,
      "formatted_start": "01:54:39.300",
      "formatted_end": "01:54:41.300",
      "text": "خب ایل هن چطوری؟"
    },
    {
      "id": 126,
      "start": 6881.3,
      "end": 6883.3,
      "formatted_start": "01:54:41.300",
      "formatted_end": "01:54:43.300",
      "text": "چی شده؟"
    },
    {
      "id": 127,
      "start": 6883.3,
      "end": 6885.3,
      "formatted_start": "01:54:43.300",
      "formatted_end": "01:54:45.300",
      "text": "ایل هن کنار از پایی روز"
    },
    {
      "id": 128,
      "start": 6885.3,
      "end": 6887.3,
      "formatted_start": "01:54:45.300",
      "formatted_end": "01:54:47.300",
      "text": "آقای مرگان شده"
    },
    {
      "id": 129,
      "start": 6887.3,
      "end": 6889.3,
      "formatted_start": "01:54:47.300",
      "formatted_end": "01:54:49.300",
      "text": "شب ها هم کنار سرپه میکنید"
    },
    {
      "id": 130,
      "start": 6889.3,
      "end": 6891.3,
      "formatted_start": "01:54:49.300",
      "formatted_end": "01:54:51.300",
      "text": "شب ها تب داره و سرپه"
    },
    {
      "id": 131,
      "start": 6891.3,
      "end": 6893.3,
      "formatted_start": "01:54:51.300",
      "formatted_end": "01:54:53.300",
      "text": "خب ایل هن آلرژی هم داشتن"
    },
    {
      "id": 132,
      "start": 6893.3,
      "end": 6895.3,
      "formatted_start": "01:54:53.300",
      "formatted_end": "01:54:55.300",
      "text": "آره"
    },
    {
      "id": 133,
      "start": 6895.3,
      "end": 6897.3,
      "formatted_start": "01:54:55.300",
      "formatted_end": "01:54:57.300",
      "text": "آسما هم داشتن"
    },
    {
      "id": 134,
      "start": 6897.3,
      "end": 6899.3,
      "formatted_start": "01:54:57.300",
      "formatted_end": "01:54:59.300",
      "text": "آره"
    }
  ],
  "status": "completed"
}