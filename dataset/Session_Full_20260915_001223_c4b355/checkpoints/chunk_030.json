  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9030.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:30.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا ب"
    },
    {
      "id": 1,
      "start": 9030.0,
      "end": 9060.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:31:00.000",
      "text": "نمیخواد بزرگ رو بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزرگ بزر"
    },
    {
      "id": 2,
      "start": 9060.0,
      "end": 9060.5,
      "formatted_start": "02:31:00.000",
      "formatted_end": "02:31:00.500",
      "text": "داریم"
    },
    {
      "id": 3,
      "start": 9060.5,
      "end": 9061.0,
      "formatted_start": "02:31:00.500",
      "formatted_end": "02:31:01.000",
      "text": "طبیعیه؟"
    },
    {
      "id": 4,
      "start": 9061.0,
      "end": 9062.5,
      "formatted_start": "02:31:01.000",
      "formatted_end": "02:31:02.500",
      "text": "آره طبیعیه"
    },
    {
      "id": 5,
      "start": 9062.5,
      "end": 9064.5,
      "formatted_start": "02:31:02.500",
      "formatted_end": "02:31:04.500",
      "text": "از اینکه نمی کنه گریه اتنامی ریاشه"
    },
    {
      "id": 6,
      "start": 9064.5,
      "end": 9065.0,
      "formatted_start": "02:31:04.500",
      "formatted_end": "02:31:05.000",
      "text": "نه نه خدار شده"
    },
    {
      "id": 7,
      "start": 9065.0,
      "end": 9066.0,
      "formatted_start": "02:31:05.000",
      "formatted_end": "02:31:06.000",
      "text": "نه مشکلی نداره"
    },
    {
      "id": 8,
      "start": 9066.0,
      "end": 9068.0,
      "formatted_start": "02:31:06.000",
      "formatted_end": "02:31:08.000",
      "text": "برخوام توی یه قطعه برده ببین برای خوابش"
    },
    {
      "id": 9,
      "start": 9068.0,
      "end": 9069.0,
      "formatted_start": "02:31:08.000",
      "formatted_end": "02:31:09.000",
      "text": "امم"
    },
    {
      "id": 10,
      "start": 9069.0,
      "end": 9070.0,
      "formatted_start": "02:31:09.000",
      "formatted_end": "02:31:10.000",
      "text": "یعنی گفتم که نمی خوابش"
    },
    {
      "id": 11,
      "start": 9070.0,
      "end": 9072.0,
      "formatted_start": "02:31:10.000",
      "formatted_end": "02:31:12.000",
      "text": "همه شبه اونو چی کنم؟"
    },
    {
      "id": 12,
      "start": 9072.0,
      "end": 9073.0,
      "formatted_start": "02:31:12.000",
      "formatted_end": "02:31:13.000",
      "text": "یعنی اونو نقوره نمی خوابه"
    },
    {
      "id": 13,
      "start": 9073.0,
      "end": 9074.0,
      "formatted_start": "02:31:13.000",
      "formatted_end": "02:31:14.000",
      "text": "بده بشه"
    },
    {
      "id": 14,
      "start": 9074.0,
      "end": 9075.0,
      "formatted_start": "02:31:14.000",
      "formatted_end": "02:31:15.000",
      "text": "الان چند سیزی میدی بهش؟"
    },
    {
      "id": 15,
      "start": 9075.0,
      "end": 9078.0,
      "formatted_start": "02:31:15.000",
      "formatted_end": "02:31:18.000",
      "text": "الان همچنین خودت گفتی دیگه های کمشگرد هست"
    },
    {
      "id": 16,
      "start": 9078.0,
      "end": 9080.0,
      "formatted_start": "02:31:18.000",
      "formatted_end": "02:31:20.000",
      "text": "خب الان چند سیزیدی؟"
    },
    {
      "id": 17,
      "start": 9080.0,
      "end": 9083.0,
      "formatted_start": "02:31:20.000",
      "formatted_end": "02:31:23.000",
      "text": "الان تقریبا در حد پنجتا قطره"
    },
    {
      "id": 18,
      "start": 9083.0,
      "end": 9086.0,
      "formatted_start": "02:31:23.000",
      "formatted_end": "02:31:26.000",
      "text": "پنج قطره؟ بره بهش، حالا بخون سه قطره"
    },
    {
      "id": 19,
      "start": 9086.0,
      "end": 9088.0,
      "formatted_start": "02:31:26.000",
      "formatted_end": "02:31:28.000",
      "text": "سه قطره؟ بره بگو اگه از اینو بردم اگه از اینو بردم"
    },
    {
      "id": 20,
      "start": 9088.0,
      "end": 9090.0,
      "formatted_start": "02:31:28.000",
      "formatted_end": "02:31:30.000",
      "text": "آره، از اون سه قطره هیچی زیر هم تزنه"
    },
    {
      "id": 21,
      "start": 9090.0,
      "end": 9095.0,
      "formatted_start": "02:31:30.000",
      "formatted_end": "02:31:35.000",
      "text": "آره، بخون دکتور من پنج رو شیخوش بی بلدون دادم"
    },
    {
      "id": 22,
      "start": 9095.0,
      "end": 9097.0,
      "formatted_start": "02:31:35.000",
      "formatted_end": "02:31:37.000",
      "text": "چند روز خیلی استحال میشد"
    },
    {
      "id": 23,
      "start": 9097.0,
      "end": 9099.0,
      "formatted_start": "02:31:37.000",
      "formatted_end": "02:31:39.000",
      "text": "یعنی اوشت روز شهر پنج بار"
    },
    {
      "id": 24,
      "start": 9099.0,
      "end": 9105.0,
      "formatted_start": "02:31:39.000",
      "formatted_end": "02:31:45.000",
      "text": "بعد به شانان نشیخوش نام میدن بس یکمش هیچ صرف رو بز کار نمیکنه"
    },
    {
      "id": 25,
      "start": 9105.0,
      "end": 9110.0,
      "formatted_start": "02:31:45.000",
      "formatted_end": "02:31:50.000",
      "text": "ببین بهترین چیز اینه که بهش نان کانفورت بدهیم"
    },
    {
      "id": 26,
      "start": 9110.0,
      "end": 9112.0,
      "formatted_start": "02:31:50.000",
      "formatted_end": "02:31:52.000",
      "text": "به بلاک یه نده؟"
    },
    {
      "id": 27,
      "start": 9112.0,
      "end": 9115.0,
      "formatted_start": "02:31:52.000",
      "formatted_end": "02:31:55.000",
      "text": "نان کانفورت یا به بلاک کانفورت"
    },
    {
      "id": 28,
      "start": 9115.0,
      "end": 9119.0,
      "formatted_start": "02:31:55.000",
      "formatted_end": "02:31:59.000",
      "text": "این کانفورت ها نه اصحال میدن نه ایوست هستید"
    },
    {
      "id": 29,
      "start": 9119.0,
      "end": 9121.0,
      "formatted_start": "02:31:59.000",
      "formatted_end": "02:32:01.000",
      "text": "خب"
    },
    {
      "id": 30,
      "start": 9123.0,
      "end": 9127.0,
      "formatted_start": "02:32:03.000",
      "formatted_end": "02:32:07.000",
      "text": "پس اون معمولهاشو دیگه قطع کنم از دیگه قطع کنم"
    },
    {
      "id": 31,
      "start": 9127.0,
      "end": 9130.24,
      "formatted_start": "02:32:07.000",
      "formatted_end": "02:32:10.240",
      "text": "حالا مهمولی هم نگه دار"
    },
    {
      "id": 32,
      "start": 9130.24,
      "end": 9131.96,
      "formatted_start": "02:32:10.240",
      "formatted_end": "02:32:11.960",
      "text": "اینها رو بساش بگیر"
    },
    {
      "id": 33,
      "start": 9131.96,
      "end": 9133.44,
      "formatted_start": "02:32:11.960",
      "formatted_end": "02:32:13.440",
      "text": "چون شاید اولش که اینو بگیر"
    },
    {
      "id": 34,
      "start": 9133.44,
      "end": 9135.7,
      "formatted_start": "02:32:13.440",
      "formatted_end": "02:32:15.700",
      "text": "شاید مثلا مزه شجیب باشه نخماره"
    },
    {
      "id": 35,
      "start": 9135.7,
      "end": 9137.18,
      "formatted_start": "02:32:15.700",
      "formatted_end": "02:32:17.180",
      "text": "اول قاطی کن"
    },
    {
      "id": 36,
      "start": 9137.18,
      "end": 9139.22,
      "formatted_start": "02:32:17.180",
      "formatted_end": "02:32:19.220",
      "text": "مثلا چهار تا پیمونه درست میکنی"
    },
    {
      "id": 37,
      "start": 9139.22,
      "end": 9141.04,
      "formatted_start": "02:32:19.220",
      "formatted_end": "02:32:21.040",
      "text": "دوتا مهمولی بده"
    },
    {
      "id": 38,
      "start": 9141.04,
      "end": 9142.82,
      "formatted_start": "02:32:21.040",
      "formatted_end": "02:32:22.820",
      "text": "دوتا از این کامفورت بده"
    },
    {
      "id": 39,
      "start": 9142.82,
      "end": 9145.74,
      "formatted_start": "02:32:22.820",
      "formatted_end": "02:32:25.740",
      "text": "بعد کم کم اونو دیگه مهمولی هروقت کن"
    },
    {
      "id": 40,
      "start": 9145.74,
      "end": 9146.5,
      "formatted_start": "02:32:25.740",
      "formatted_end": "02:32:26.500",
      "text": "فقط کامفورت"
    },
    {
      "id": 41,
      "start": 9146.5,
      "end": 9148.52,
      "formatted_start": "02:32:26.500",
      "formatted_end": "02:32:28.520",
      "text": "دست درست کنید"
    },
    {
      "id": 42,
      "start": 9148.52,
      "end": 9151.5,
      "formatted_start": "02:32:28.520",
      "formatted_end": "02:32:31.500",
      "text": "خدا خدا خدا"
    },
    {
      "id": 43,
      "start": 9151.5,
      "end": 9156.5,
      "formatted_start": "02:32:31.500",
      "formatted_end": "02:32:36.500",
      "text": "خدا خدا"
    },
    {
      "id": 44,
      "start": 9156.5,
      "end": 9158.5,
      "formatted_start": "02:32:36.500",
      "formatted_end": "02:32:38.500",
      "text": "خدا خواهی شدن"
    },
    {
      "id": 45,
      "start": 9158.5,
      "end": 9160.5,
      "formatted_start": "02:32:38.500",
      "formatted_end": "02:32:40.500",
      "text": "باشون مریض"
    },
    {
      "id": 46,
      "start": 9174.5,
      "end": 9176.5,
      "formatted_start": "02:32:54.500",
      "formatted_end": "02:32:56.500",
      "text": "سلام"
    },
    {
      "id": 47,
      "start": 9176.5,
      "end": 9178.5,
      "formatted_start": "02:32:56.500",
      "formatted_end": "02:32:58.500",
      "text": "مرحبا باشین"
    },
    {
      "id": 48,
      "start": 9178.5,
      "end": 9180.5,
      "formatted_start": "02:32:58.500",
      "formatted_end": "02:33:00.500",
      "text": "برسید"
    },
    {
      "id": 49,
      "start": 9180.5,
      "end": 9182.5,
      "formatted_start": "02:33:00.500",
      "formatted_end": "02:33:02.500",
      "text": "خواهی شدن"
    },
    {
      "id": 50,
      "start": 9182.5,
      "end": 9184.5,
      "formatted_start": "02:33:02.500",
      "formatted_end": "02:33:04.500",
      "text": "چی شده؟"
    },
    {
      "id": 51,
      "start": 9184.5,
      "end": 9188.5,
      "formatted_start": "02:33:04.500",
      "formatted_end": "02:33:08.500",
      "text": "سرون که نوشته که رو خونده تو اونجا خواهد"
    },
    {
      "id": 52,
      "start": 9194.5,
      "end": 9198.5,
      "formatted_start": "02:33:14.500",
      "formatted_end": "02:33:18.500",
      "text": "یک طرف هست دیگه، یه درم همون فرقه"
    },
    {
      "id": 53,
      "start": 9198.5,
      "end": 9202.5,
      "formatted_start": "02:33:18.500",
      "formatted_end": "02:33:22.500",
      "text": "تونه یه چپشه که تو ناس وره نداره"
    },
    {
      "id": 54,
      "start": 9202.5,
      "end": 9206.5,
      "formatted_start": "02:33:22.500",
      "formatted_end": "02:33:26.500",
      "text": "ما تونه ما سرونو میکنیم، دو طرفشو چک می کنیم که اگه دو طرفش باشه"
    },
    {
      "id": 55,
      "start": 9206.5,
      "end": 9212.5,
      "formatted_start": "02:33:26.500",
      "formatted_end": "02:33:32.500",
      "text": "کابی نه ببرش دکترون شفید بود کاب یا برده وقت عمل برمانه براشید"
    },
    {
      "id": 56,
      "start": 9212.5,
      "end": 9213.5,
      "formatted_start": "02:33:32.500",
      "formatted_end": "02:33:33.500",
      "text": "او دیگه چیز"
    },
    {
      "id": 57,
      "start": 9213.5,
      "end": 9214.5,
      "formatted_start": "02:33:33.500",
      "formatted_end": "02:33:34.500",
      "text": "کاب چی باشه"
    },
    {
      "id": 58,
      "start": 9214.5,
      "end": 9217.5,
      "formatted_start": "02:33:34.500",
      "formatted_end": "02:33:37.500",
      "text": "کاب از دربه بخوام دکترون شما بردن"
    },
    {
      "id": 59,
      "start": 9217.5,
      "end": 9220.5,
      "formatted_start": "02:33:37.500",
      "formatted_end": "02:33:40.500",
      "text": "در اینجا باید ببرینش گربان"
    },
    {
      "id": 60,
      "start": 9220.5,
      "end": 9225.5,
      "formatted_start": "02:33:40.500",
      "formatted_end": "02:33:45.500",
      "text": "دکتر سبوهی بسکی بیوشی مثلا سبایی"
    },
    {
      "id": 61,
      "start": 9225.5,
      "end": 9227.5,
      "formatted_start": "02:33:45.500",
      "formatted_end": "02:33:47.500",
      "text": "سبایی"
    },
    {
      "id": 62,
      "start": 9227.5,
      "end": 9234.5,
      "formatted_start": "02:33:47.500",
      "formatted_end": "02:33:54.500",
      "text": "باید بردن که چون شما هم بیمه تکمیلی ندارین و هم مثلا چیز ببرین گربان"
    },
    {
      "id": 63,
      "start": 9234.5,
      "end": 9236.5,
      "formatted_start": "02:33:54.500",
      "formatted_end": "02:33:56.500",
      "text": "دکتر زناخرانی خیلی خوبه"
    },
    {
      "id": 64,
      "start": 9236.5,
      "end": 9238.5,
      "formatted_start": "02:33:56.500",
      "formatted_end": "02:33:58.500",
      "text": "خیلی دکتر خوبه"
    },
    {
      "id": 65,
      "start": 9238.5,
      "end": 9240.5,
      "formatted_start": "02:33:58.500",
      "formatted_end": "02:34:00.500",
      "text": "شما اگه تا"
    },
    {
      "id": 66,
      "start": 9240.5,
      "end": 9242.5,
      "formatted_start": "02:34:00.500",
      "formatted_end": "02:34:02.500",
      "text": "نه اطلا فوقالاده هست"
    },
    {
      "id": 67,
      "start": 9242.5,
      "end": 9244.5,
      "formatted_start": "02:34:02.500",
      "formatted_end": "02:34:04.500",
      "text": "خودتونم برید"
    },
    {
      "id": 68,
      "start": 9244.5,
      "end": 9246.5,
      "formatted_start": "02:34:04.500",
      "formatted_end": "02:34:06.500",
      "text": "میبینید چقدر این هست"
    },
    {
      "id": 69,
      "start": 9246.5,
      "end": 9248.5,
      "formatted_start": "02:34:06.500",
      "formatted_end": "02:34:08.500",
      "text": "واضح کنم بابشدان و کاربرده هست"
    },
    {
      "id": 70,
      "start": 9248.5,
      "end": 9250.5,
      "formatted_start": "02:34:08.500",
      "formatted_end": "02:34:10.500",
      "text": "همونان"
    },
    {
      "id": 71,
      "start": 9250.5,
      "end": 9252.5,
      "formatted_start": "02:34:10.500",
      "formatted_end": "02:34:12.500",
      "text": "چون خود دکتر شفی پون خیلی برد همینه"
    },
    {
      "id": 72,
      "start": 9252.5,
      "end": 9254.5,
      "formatted_start": "02:34:12.500",
      "formatted_end": "02:34:14.500",
      "text": "و این که کاملا هم"
    },
    {
      "id": 73,
      "start": 9254.5,
      "end": 9256.5,
      "formatted_start": "02:34:14.500",
      "formatted_end": "02:34:16.500",
      "text": "دولتی عمل میشد"
    },
    {
      "id": 74,
      "start": 9256.5,
      "end": 9258.5,
      "formatted_start": "02:34:16.500",
      "formatted_end": "02:34:18.500",
      "text": "مرور اگر نم بزکی"
    },
    {
      "id": 75,
      "start": 9258.5,
      "end": 9260.5,
      "formatted_start": "02:34:18.500",
      "formatted_end": "02:34:20.500",
      "text": "یا حتی اگر مثلا گرگان ببرن"
    },
    {
      "id": 76,
      "start": 9260.5,
      "end": 9262.5,
      "formatted_start": "02:34:20.500",
      "formatted_end": "02:34:22.500",
      "text": "دکتر تنه"
    },
    {
      "id": 77,
      "start": 9262.5,
      "end": 9267.24,
      "formatted_start": "02:34:22.500",
      "formatted_end": "02:34:27.240",
      "text": "به قال یکی از همکاران و یکی از مریضان بخواست رفتن دکتر ترینه گرگان"
    },
    {
      "id": 78,
      "start": 9267.24,
      "end": 9271.04,
      "formatted_start": "02:34:27.240",
      "formatted_end": "02:34:31.040",
      "text": "میگفت 50 میلیون همونجا از من گرفته"
    },
    {
      "id": 79,
      "start": 9271.04,
      "end": 9272.04,
      "formatted_start": "02:34:31.040",
      "formatted_end": "02:34:32.040",
      "text": "های"
    },
    {
      "id": 80,
      "start": 9272.04,
      "end": 9274.74,
      "formatted_start": "02:34:32.040",
      "formatted_end": "02:34:34.740",
      "text": "30 تومن هم پولی مارس دادن"
    },
    {
      "id": 81,
      "start": 9274.74,
      "end": 9281.44,
      "formatted_start": "02:34:34.740",
      "formatted_end": "02:34:41.440",
      "text": "حالا اوناش بهمونه استرسی که اینه مامان باباش دارن الان کلی اینجا نشسته گریه کردی تا درسته بیاریم"
    },
    {
      "id": 82,
      "start": 9281.44,
      "end": 9283.44,
      "formatted_start": "02:34:41.440",
      "formatted_end": "02:34:43.440",
      "text": "چرا؟ نه خب باید همه از این سرکاریه"
    },
    {
      "id": 83,
      "start": 9283.44,
      "end": 9284.44,
      "formatted_start": "02:34:43.440",
      "formatted_end": "02:34:44.440",
      "text": "چون کچی دوی میاد"
    },
    {
      "id": 84,
      "start": 9284.44,
      "end": 9290.54,
      "formatted_start": "02:34:44.440",
      "formatted_end": "02:34:50.540",
      "text": "اشغال نداره ببین اینو که فهمیدی یه دفعه ببین من چرا میدیم فتخو زودتر آمد کن"
    },
    {
      "id": 85,
      "start": 9290.54,
      "end": 9296.08,
      "formatted_start": "02:34:50.540",
      "formatted_end": "02:34:56.080",
      "text": "گفتم بهتون دفعه این روده بیاد خب اینجا الان یه راه لول هست خب"
    },
    {
      "id": 86,
      "start": 9296.08,
      "end": 9299.54,
      "formatted_start": "02:34:56.080",
      "formatted_end": "02:34:59.540",
      "text": "نه این فشار که میاره زور که میزنه روده"
    }
  ],
  "status": "completed"
}