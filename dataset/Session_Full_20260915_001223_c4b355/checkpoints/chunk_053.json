  "stt_segments": [
    {
      "id": 0,
      "start": 15900.0,
      "end": 15908.0,
      "formatted_start": "04:25:00.000",
      "formatted_end": "04:25:08.000",
      "text": "خودم میگن برای گرماست. من و مادر شوهرم باید باهم اختلاف داشتیم. من بخواهم گرماست. اون گفت نه، صرزه، فضا صرزه. این باید گرم بمونه."
    },
    {
      "id": 1,
      "start": 15908.0,
      "end": 15912.0,
      "formatted_start": "04:25:08.000",
      "formatted_end": "04:25:12.000",
      "text": "نه، نه، گرم هم نباید باشه. گرما هم بدترش میکنه."
    },
    {
      "id": 2,
      "start": 15912.0,
      "end": 15914.0,
      "formatted_start": "04:25:12.000",
      "formatted_end": "04:25:14.000",
      "text": "مومی، تنجان هم باید همون 22 درجه باشه."
    },
    {
      "id": 3,
      "start": 15914.0,
      "end": 15916.0,
      "formatted_start": "04:25:14.000",
      "formatted_end": "04:25:16.000",
      "text": "24 الا 25."
    },
    {
      "id": 4,
      "start": 15916.0,
      "end": 15918.0,
      "formatted_start": "04:25:16.000",
      "formatted_end": "04:25:18.000",
      "text": "آها."
    },
    {
      "id": 5,
      "start": 15918.0,
      "end": 15920.0,
      "formatted_start": "04:25:18.000",
      "formatted_end": "04:25:20.000",
      "text": "22، 3 این هم کم هم."
    },
    {
      "id": 6,
      "start": 15920.0,
      "end": 15922.0,
      "formatted_start": "04:25:20.000",
      "formatted_end": "04:25:22.000",
      "text": "آها، پس 22، نه."
    },
    {
      "id": 7,
      "start": 15922.0,
      "end": 15924.0,
      "formatted_start": "04:25:22.000",
      "formatted_end": "04:25:24.000",
      "text": "از این درخواهد بینام چی ها نوشته بودن؟"
    },
    {
      "id": 8,
      "start": 15924.0,
      "end": 15926.0,
      "formatted_start": "04:25:24.000",
      "formatted_end": "04:25:26.000",
      "text": "باید آرام سوار اومدن به سریب"
    },
    {
      "id": 9,
      "start": 15926.0,
      "end": 15928.0,
      "formatted_start": "04:25:26.000",
      "formatted_end": "04:25:28.000",
      "text": "باشون بگیم"
    },
    {
      "id": 10,
      "start": 15928.0,
      "end": 15930.0,
      "formatted_start": "04:25:28.000",
      "formatted_end": "04:25:30.000",
      "text": "ببینید یه گیاش برو این مونه ها"
    },
    {
      "id": 11,
      "start": 15930.0,
      "end": 15932.0,
      "formatted_start": "04:25:30.000",
      "formatted_end": "04:25:32.000",
      "text": "این رو باشیم"
    },
    {
      "id": 12,
      "start": 15932.0,
      "end": 15934.0,
      "formatted_start": "04:25:32.000",
      "formatted_end": "04:25:34.000",
      "text": "تو خونه هم باید کلا ساشته باشه؟"
    },
    {
      "id": 13,
      "start": 15934.0,
      "end": 15936.0,
      "formatted_start": "04:25:34.000",
      "formatted_end": "04:25:36.000",
      "text": "بس دیگه در مورد خونه هم ندارم"
    },
    {
      "id": 14,
      "start": 15936.0,
      "end": 15938.0,
      "formatted_start": "04:25:36.000",
      "formatted_end": "04:25:38.000",
      "text": "اگه همون 24-25 باشه؟"
    },
    {
      "id": 15,
      "start": 15938.0,
      "end": 15940.0,
      "formatted_start": "04:25:38.000",
      "formatted_end": "04:25:40.000",
      "text": "نه دیگه"
    },
    {
      "id": 16,
      "start": 15940.0,
      "end": 15942.0,
      "formatted_start": "04:25:40.000",
      "formatted_end": "04:25:42.000",
      "text": "اولا دیگه بیمونتاش داشته باشه"
    },
    {
      "id": 17,
      "start": 15942.0,
      "end": 15944.0,
      "formatted_start": "04:25:42.000",
      "formatted_end": "04:25:44.000",
      "text": "بعد یه قطره بینیم زاده بود این قطره دیولات"
    },
    {
      "id": 18,
      "start": 15944.0,
      "end": 15946.0,
      "formatted_start": "04:25:44.000",
      "formatted_end": "04:25:46.000",
      "text": "اگه شبانه برد"
    },
    {
      "id": 19,
      "start": 15946.0,
      "end": 15948.0,
      "formatted_start": "04:25:46.000",
      "formatted_end": "04:25:48.000",
      "text": "اون قطره رو یکی دو شب که بهش دادیم"
    },
    {
      "id": 20,
      "start": 15948.0,
      "end": 15952.4,
      "formatted_start": "04:25:48.000",
      "formatted_end": "04:25:52.400",
      "text": "این شب که بهش دادین، تو روز بهش دادن اوکی بود، یکی دوباره که تو روز کرد"
    },
    {
      "id": 21,
      "start": 15952.4,
      "end": 15956.12,
      "formatted_start": "04:25:52.400",
      "formatted_end": "04:25:56.120",
      "text": "ولی شب که اون قطره رو بهش دادن تا صبح جیغ میزن"
    },
    {
      "id": 22,
      "start": 15956.12,
      "end": 15958.12,
      "formatted_start": "04:25:56.120",
      "formatted_end": "04:25:58.120",
      "text": "قشنگ به خودش میپیچید"
    },
    {
      "id": 23,
      "start": 15959.32,
      "end": 15961.8,
      "formatted_start": "04:25:59.320",
      "formatted_end": "04:26:01.800",
      "text": "برهم من یه تامین ندادم بهش"
    },
    {
      "id": 24,
      "start": 15961.8,
      "end": 15963.8,
      "formatted_start": "04:26:01.800",
      "formatted_end": "04:26:03.800",
      "text": "چیزی به خاطر آن باشه"
    },
    {
      "id": 25,
      "start": 15963.8,
      "end": 15965.16,
      "formatted_start": "04:26:03.800",
      "formatted_end": "04:26:05.160",
      "text": "برامونیست؟"
    },
    {
      "id": 26,
      "start": 15965.16,
      "end": 15968.56,
      "formatted_start": "04:26:05.160",
      "formatted_end": "04:26:08.560",
      "text": "خب اینجور برای حساسیتش میلویستم"
    },
    {
      "id": 27,
      "start": 15968.56,
      "end": 15972.28,
      "formatted_start": "04:26:08.560",
      "formatted_end": "04:26:12.280",
      "text": "خلاص بایولاک هم داره، یعنی برای پرویوتیک هم هست"
    },
    {
      "id": 28,
      "start": 15972.28,
      "end": 15974.28,
      "formatted_start": "04:26:12.280",
      "formatted_end": "04:26:14.280",
      "text": "ولی برای آلرژی هم هست"
    },
    {
      "id": 29,
      "start": 15974.28,
      "end": 15978.52,
      "formatted_start": "04:26:14.280",
      "formatted_end": "04:26:18.520",
      "text": "روزی پنج قطر از این بجاش بند به جای وایلا"
    },
    {
      "id": 30,
      "start": 15978.52,
      "end": 15980.52,
      "formatted_start": "04:26:18.520",
      "formatted_end": "04:26:20.520",
      "text": "پنج قطر"
    },
    {
      "id": 31,
      "start": 15980.52,
      "end": 15982.52,
      "formatted_start": "04:26:20.520",
      "formatted_end": "04:26:22.520",
      "text": "و"
    },
    {
      "id": 32,
      "start": 15982.52,
      "end": 15984.52,
      "formatted_start": "04:26:22.520",
      "formatted_end": "04:26:24.520",
      "text": "یکی امیلی کن براش"
    },
    {
      "id": 33,
      "start": 15984.52,
      "end": 15986.52,
      "formatted_start": "04:26:24.520",
      "formatted_end": "04:26:26.520",
      "text": "اینو بزن به صورتش"
    },
    {
      "id": 34,
      "start": 15986.52,
      "end": 15989.52,
      "formatted_start": "04:26:26.520",
      "formatted_end": "04:26:29.520",
      "text": "خب حالا شما سارای دیگه تو بجه"
    },
    {
      "id": 35,
      "start": 15989.52,
      "end": 15994.52,
      "formatted_start": "04:26:29.520",
      "formatted_end": "04:26:34.520",
      "text": "بعد آها الان این درداش درده دل بیچه ای ممکنه باشه"
    },
    {
      "id": 36,
      "start": 15994.52,
      "end": 15996.52,
      "formatted_start": "04:26:34.520",
      "formatted_end": "04:26:36.520",
      "text": "میشه برش گیری میچه ادار"
    },
    {
      "id": 37,
      "start": 15996.52,
      "end": 15999.52,
      "formatted_start": "04:26:36.520",
      "formatted_end": "04:26:39.520",
      "text": "ببین بچه ها وقتی که دلشون درد میکنه"
    },
    {
      "id": 38,
      "start": 15999.52,
      "end": 16005.52,
      "formatted_start": "04:26:39.520",
      "formatted_end": "04:26:45.520",
      "text": "بازم چون بچه ها تو این سن فکر میکنن همه مشکلاتشون با خوردن حرمشون"
    },
    {
      "id": 39,
      "start": 16005.52,
      "end": 16008.52,
      "formatted_start": "04:26:45.520",
      "formatted_end": "04:26:48.520",
      "text": "تا کلا خوارشون داره میخورن"
    },
    {
      "id": 40,
      "start": 16008.52,
      "end": 16012.52,
      "formatted_start": "04:26:48.520",
      "formatted_end": "04:26:52.520",
      "text": "دلشون درد میگیره خوابشون میاد میخورن"
    },
    {
      "id": 41,
      "start": 16012.52,
      "end": 16015.52,
      "formatted_start": "04:26:52.520",
      "formatted_end": "04:26:55.520",
      "text": "خب فکر میکنن همه چی بایدشون آرامش پیدا میکنن"
    },
    {
      "id": 42,
      "start": 16015.52,
      "end": 16023.52,
      "formatted_start": "04:26:55.520",
      "formatted_end": "04:27:03.520",
      "text": "حالا این تزه شانب یعنی دل درداش هم بیقراری هاش بخاطر دل درداش هم بیتونه باشه"
    },
    {
      "id": 43,
      "start": 16023.52,
      "end": 16029.52,
      "formatted_start": "04:27:03.520",
      "formatted_end": "04:27:09.520",
      "text": "که بالاخره معمولا ده خونزردگی شروع میشه دلدرد و زیاد میشه میره تا دو ماهگی"
    },
    {
      "id": 44,
      "start": 16029.52,
      "end": 16033.52,
      "formatted_start": "04:27:09.520",
      "formatted_end": "04:27:13.520",
      "text": "دوره از ده ماهگی کم میشه تا دیگه چهار پای ماهگی بشن خوب میشن"
    },
    {
      "id": 45,
      "start": 16033.52,
      "end": 16034.52,
      "formatted_start": "04:27:13.520",
      "formatted_end": "04:27:14.520",
      "text": "تلتر باشون"
    },
    {
      "id": 46,
      "start": 16034.52,
      "end": 16038.52,
      "formatted_start": "04:27:14.520",
      "formatted_end": "04:27:18.520",
      "text": "برای دلدردش هم میتونی گیل میکسچر رو بدی بلی بهتر از گیل میکسچر هم هست"
    },
    {
      "id": 47,
      "start": 16038.52,
      "end": 16040.52,
      "formatted_start": "04:27:18.520",
      "formatted_end": "04:27:20.520",
      "text": "که براتون میره بیستن خب؟"
    },
    {
      "id": 48,
      "start": 16040.52,
      "end": 16041.52,
      "formatted_start": "04:27:20.520",
      "formatted_end": "04:27:21.520",
      "text": "آهان خوب"
    },
    {
      "id": 49,
      "start": 16044.52,
      "end": 16047.52,
      "formatted_start": "04:27:24.520",
      "formatted_end": "04:27:27.520",
      "text": "بر آمان افزردی صورتش هم هر وقت نرده"
    },
    {
      "id": 50,
      "start": 16047.52,
      "end": 16048.52,
      "formatted_start": "04:27:27.520",
      "formatted_end": "04:27:28.520",
      "text": "آره منیم"
    },
    {
      "id": 51,
      "start": 16048.52,
      "end": 16049.52,
      "formatted_start": "04:27:28.520",
      "formatted_end": "04:27:29.520",
      "text": "درمونده همیجوری"
    },
    {
      "id": 52,
      "start": 16053.52,
      "end": 16055.52,
      "formatted_start": "04:27:33.520",
      "formatted_end": "04:27:35.520",
      "text": "آزما شاخه ایماری که دادیم روی یازدن باشیم"
    },
    {
      "id": 53,
      "start": 16055.52,
      "end": 16057.52,
      "formatted_start": "04:27:35.520",
      "formatted_end": "04:27:37.520",
      "text": "اون رو میشه دادیم"
    },
    {
      "id": 54,
      "start": 16057.52,
      "end": 16058.52,
      "formatted_start": "04:27:37.520",
      "formatted_end": "04:27:38.520",
      "text": "اینم خوبه"
    },
    {
      "id": 55,
      "start": 16058.52,
      "end": 16061.52,
      "formatted_start": "04:27:38.520",
      "formatted_end": "04:27:41.520",
      "text": "گیر میکشنر خارجی رو بیتره بعد از یه ماه بگیم"
    },
    {
      "id": 56,
      "start": 16061.52,
      "end": 16062.52,
      "formatted_start": "04:27:41.520",
      "formatted_end": "04:27:42.520",
      "text": "آره"
    },
    {
      "id": 57,
      "start": 16062.52,
      "end": 16063.52,
      "formatted_start": "04:27:42.520",
      "formatted_end": "04:27:43.520",
      "text": "الان یه ماه شده"
    },
    {
      "id": 58,
      "start": 16063.52,
      "end": 16064.52,
      "formatted_start": "04:27:43.520",
      "formatted_end": "04:27:44.520",
      "text": "نبیشه داریم"
    },
    {
      "id": 59,
      "start": 16064.52,
      "end": 16065.52,
      "formatted_start": "04:27:44.520",
      "formatted_end": "04:27:45.520",
      "text": "بسیار شارج"
    },
    {
      "id": 60,
      "start": 16065.52,
      "end": 16067.52,
      "formatted_start": "04:27:45.520",
      "formatted_end": "04:27:47.520",
      "text": "بس هفته دیگه میتونیم اون رو بشنم"
    },
    {
      "id": 61,
      "start": 16067.52,
      "end": 16068.52,
      "formatted_start": "04:27:47.520",
      "formatted_end": "04:27:48.520",
      "text": "آه"
    },
    {
      "id": 62,
      "start": 16068.52,
      "end": 16070.52,
      "formatted_start": "04:27:48.520",
      "formatted_end": "04:27:50.520",
      "text": "این یکی لغت رو بش دادیم آره"
    },
    {
      "id": 63,
      "start": 16070.52,
      "end": 16071.52,
      "formatted_start": "04:27:50.520",
      "formatted_end": "04:27:51.520",
      "text": "دیگه خیلی دیگه"
    },
    {
      "id": 64,
      "start": 16071.52,
      "end": 16072.52,
      "formatted_start": "04:27:51.520",
      "formatted_end": "04:27:52.520",
      "text": "آره یه دوباره"
    },
    {
      "id": 65,
      "start": 16072.52,
      "end": 16073.52,
      "formatted_start": "04:27:52.520",
      "formatted_end": "04:27:53.520",
      "text": "آره شونه دادیم آره شونه"
    },
    {
      "id": 66,
      "start": 16073.52,
      "end": 16074.52,
      "formatted_start": "04:27:53.520",
      "formatted_end": "04:27:54.520",
      "text": "آره آرم شده"
    },
    {
      "id": 67,
      "start": 16074.52,
      "end": 16080.52,
      "formatted_start": "04:27:54.520",
      "formatted_end": "04:28:00.520",
      "text": "برای یک زمانی آروم شد دیگه مثلا دوباره یه ساعت بعدش دوباره شروع کرد دیشمان"
    },
    {
      "id": 68,
      "start": 16081.52,
      "end": 16084.52,
      "formatted_start": "04:28:01.520",
      "formatted_end": "04:28:04.520",
      "text": "بس خیلی بیقراره خیلی آروم هست"
    },
    {
      "id": 69,
      "start": 16084.52,
      "end": 16085.52,
      "formatted_start": "04:28:04.520",
      "formatted_end": "04:28:05.520",
      "text": "آروم هست"
    },
    {
      "id": 70,
      "start": 16085.52,
      "end": 16086.52,
      "formatted_start": "04:28:05.520",
      "formatted_end": "04:28:06.520",
      "text": "آروم هست"
    },
    {
      "id": 71,
      "start": 16086.52,
      "end": 16087.52,
      "formatted_start": "04:28:06.520",
      "formatted_end": "04:28:07.520",
      "text": "چون اینجوری جیغ میزن"
    },
    {
      "id": 72,
      "start": 16087.52,
      "end": 16088.52,
      "formatted_start": "04:28:07.520",
      "formatted_end": "04:28:08.520",
      "text": "دیگه نفسش رفت"
    },
    {
      "id": 73,
      "start": 16088.52,
      "end": 16089.52,
      "formatted_start": "04:28:08.520",
      "formatted_end": "04:28:09.520",
      "text": "رفت هست"
    },
    {
      "id": 74,
      "start": 16089.52,
      "end": 16091.52,
      "formatted_start": "04:28:09.520",
      "formatted_end": "04:28:11.520",
      "text": "خیلی جیغ میزن آروم هست"
    },
    {
      "id": 75,
      "start": 16091.52,
      "end": 16094.52,
      "formatted_start": "04:28:11.520",
      "formatted_end": "04:28:14.520",
      "text": "بس در طریق روز بچه نسبتا آرومیه"
    },
    {
      "id": 76,
      "start": 16094.52,
      "end": 16096.52,
      "formatted_start": "04:28:14.520",
      "formatted_end": "04:28:16.520",
      "text": "بس امروز استثناء از صبح شروع کرد"
    },
    {
      "id": 77,
      "start": 16096.52,
      "end": 16100.52,
      "formatted_start": "04:28:16.520",
      "formatted_end": "04:28:20.520",
      "text": "بس دیشمان جیغ داد تا صبح دوباره صبح همونطوری جیغ داد تا الان"
    },
    {
      "id": 78,
      "start": 16100.52,
      "end": 16108.52,
      "formatted_start": "04:28:20.520",
      "formatted_end": "04:28:28.520",
      "text": "ببین من براش درهایی که نمیشتم یه قطره پروتکت روزی 5 قطره بشم"
    },
    {
      "id": 79,
      "start": 16108.52,
      "end": 16110.52,
      "formatted_start": "04:28:28.520",
      "formatted_end": "04:28:30.520",
      "text": "سر بزرگ شروعش نشید؟"
    },
    {
      "id": 80,
      "start": 16110.52,
      "end": 16112.52,
      "formatted_start": "04:28:30.520",
      "formatted_end": "04:28:32.520",
      "text": "هیچ فرق نیست"
    },
    {
      "id": 81,
      "start": 16112.52,
      "end": 16122.52,
      "formatted_start": "04:28:32.520",
      "formatted_end": "04:28:42.520",
      "text": "بعد یه شربت کامیکال در صورت بیقراری 2.5 سی سی تا روزی 4 الا 5 بار هم میتونی بشم"
    },
    {
      "id": 82,
      "start": 16122.52,
      "end": 16129.52,
      "formatted_start": "04:28:42.520",
      "formatted_end": "04:28:49.520",
      "text": "مهمتر از اون یه که خودت این رژیم غذایی که بهتون میگم رایت بکنی"
    },
    {
      "id": 83,
      "start": 16129.52,
      "end": 16143.52,
      "formatted_start": "04:28:49.520",
      "formatted_end": "04:29:03.520",
      "text": "چیزایی که نباید بخواده، یکی فرق بوده، نشابه گازدار، بوبوبات، فلفل دلبه، بادمجون و شیرگاه"
    },
    {
      "id": 84,
      "start": 16143.52,
      "end": 16147.52,
      "formatted_start": "04:29:03.520",
      "formatted_end": "04:29:07.520",
      "text": "شیرگاه و گوشتگاه"
    },
    {
      "id": 85,
      "start": 16147.52,
      "end": 16152.2,
      "formatted_start": "04:29:07.520",
      "formatted_end": "04:29:12.200",
      "text": "حالا شیرگاه ببین ماست و پنیر میتونی بخوری"
    },
    {
      "id": 86,
      "start": 16152.2,
      "end": 16154.74,
      "formatted_start": "04:29:12.200",
      "formatted_end": "04:29:14.740",
      "text": "بسیار چیزهایی که تو شیر خالص داره نخور"
    },
    {
      "id": 87,
      "start": 16154.74,
      "end": 16156.8,
      "formatted_start": "04:29:14.740",
      "formatted_end": "04:29:16.800",
      "text": "مثل چی؟ مثل خامه"
    },
    {
      "id": 88,
      "start": 16156.8,
      "end": 16158.44,
      "formatted_start": "04:29:16.800",
      "formatted_end": "04:29:18.440",
      "text": "مثل بستنی"
    },
    {
      "id": 89,
      "start": 16158.44,
      "end": 16160.5,
      "formatted_start": "04:29:18.440",
      "formatted_end": "04:29:20.500",
      "text": "شیر کاکاو"
    },
    {
      "id": 90,
      "start": 16160.5,
      "end": 16162.82,
      "formatted_start": "04:29:20.500",
      "formatted_end": "04:29:22.820",
      "text": "اصلا کاکاو بچه ها بیقرارون کنی"
    },
    {
      "id": 91,
      "start": 16162.82,
      "end": 16164.88,
      "formatted_start": "04:29:22.820",
      "formatted_end": "04:29:24.880",
      "text": "دوشت میزن حساسیت میگه"
    },
    {
      "id": 92,
      "start": 16164.88,
      "end": 16167.94,
      "formatted_start": "04:29:24.880",
      "formatted_end": "04:29:27.940",
      "text": "با قدر کاکاو"
    },
    {
      "id": 93,
      "start": 16167.94,
      "end": 16169.54,
      "formatted_start": "04:29:27.940",
      "formatted_end": "04:29:29.540",
      "text": "با قدر گردانی"
    },
    {
      "id": 94,
      "start": 16169.54,
      "end": 16172.8,
      "formatted_start": "04:29:29.540",
      "formatted_end": "04:29:32.800",
      "text": "خامه، بستنی، شیر کاکاو، فرنین"
    },
    {
      "id": 95,
      "start": 16172.8,
      "end": 16174.32,
      "formatted_start": "04:29:32.800",
      "formatted_end": "04:29:34.320",
      "text": "اینا رو نخور"
    },
    {
      "id": 96,
      "start": 16174.32,
      "end": 16176.24,
      "formatted_start": "04:29:34.320",
      "formatted_end": "04:29:36.240",
      "text": "اینا رایت بکن"
    },
    {
      "id": 97,
      "start": 16176.24,
      "end": 16180.24,
      "formatted_start": "04:29:36.240",
      "formatted_end": "04:29:40.240",
      "text": "ما الان نمیگم هیچی نخور برای این فرقون کمتر خور"
    },
    {
      "id": 98,
      "start": 16180.24,
      "end": 16184.24,
      "formatted_start": "04:29:40.240",
      "formatted_end": "04:29:44.240",
      "text": "توی میبه ها هم خربوزه حساسیت میگن"
    },
    {
      "id": 99,
      "start": 16184.24,
      "end": 16186.24,
      "formatted_start": "04:29:44.240",
      "formatted_end": "04:29:46.240",
      "text": "و تو آجین هم بادوزن میگن"
    },
    {
      "id": 100,
      "start": 16186.24,
      "end": 16190.24,
      "formatted_start": "04:29:46.240",
      "formatted_end": "04:29:50.240",
      "text": "خربوزه خود نمیگی بردم توی این ها"
    },
    {
      "id": 101,
      "start": 16190.24,
      "end": 16192.24,
      "formatted_start": "04:29:50.240",
      "formatted_end": "04:29:52.240",
      "text": "توی دکاتر هایی گفتیم خونه که این خربوزه بردم"
    },
    {
      "id": 102,
      "start": 16192.24,
      "end": 16194.24,
      "formatted_start": "04:29:52.240",
      "formatted_end": "04:29:54.240",
      "text": "آره این ها را رایت بکن"
    },
    {
      "id": 103,
      "start": 16194.24,
      "end": 16196.24,
      "formatted_start": "04:29:54.240",
      "formatted_end": "04:29:56.240",
      "text": "آره این ها را رایت بکن"
    },
    {
      "id": 104,
      "start": 16196.24,
      "end": 16198.24,
      "formatted_start": "04:29:56.240",
      "formatted_end": "04:29:58.240",
      "text": "این ها را هم که نمشتم بهش بده بخوره"
    },
    {
      "id": 105,
      "start": 16198.24,
      "end": 16200.24,
      "formatted_start": "04:29:58.240",
      "formatted_end": "04:30:00.240",
      "text": "انشالله خوب میشه"
    }
  ],
  "status": "completed"
}