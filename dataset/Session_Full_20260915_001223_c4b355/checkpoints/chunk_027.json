  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8113.24,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:13.240",
      "text": "اگر بردر شیر گرفت خوابید، اگر نخوابید، بازم میقراریش ادامه داشت، یه شروط گل گیریت نوشتم، مثل گیریت میتشرفت."
    },
    {
      "id": 1,
      "start": 8113.24,
      "end": 8119.0,
      "formatted_start": "02:15:13.240",
      "formatted_end": "02:15:19.000",
      "text": "خب دو سی سی در صورت بیقراری بعد از شیر بده"
    },
    {
      "id": 2,
      "start": 8119.0,
      "end": 8119.62,
      "formatted_start": "02:15:19.000",
      "formatted_end": "02:15:19.620",
      "text": "خب"
    },
    {
      "id": 3,
      "start": 8119.62,
      "end": 8130.86,
      "formatted_start": "02:15:19.620",
      "formatted_end": "02:15:30.860",
      "text": "این همه"
    },
    {
      "id": 4,
      "start": 8130.86,
      "end": 8136.48,
      "formatted_start": "02:15:30.860",
      "formatted_end": "02:15:36.480",
      "text": "دو سی سی دوندونی نه"
    },
    {
      "id": 5,
      "start": 8136.48,
      "end": 8137.86,
      "formatted_start": "02:15:36.480",
      "formatted_end": "02:15:37.860",
      "text": "رو باشه پاندکتر"
    },
    {
      "id": 6,
      "start": 8137.86,
      "end": 8140.18,
      "formatted_start": "02:15:37.860",
      "formatted_end": "02:15:40.180",
      "text": "آره اونو از دونی"
    },
    {
      "id": 7,
      "start": 8140.18,
      "end": 8140.82,
      "formatted_start": "02:15:40.180",
      "formatted_end": "02:15:40.820",
      "text": "اونو"
    },
    {
      "id": 8,
      "start": 8140.82,
      "end": 8161.16,
      "formatted_start": "02:15:40.820",
      "formatted_end": "02:16:01.160",
      "text": "خب باید ببینید اون دماغسنجتو رو اولا که باید تنظیم کنید"
    },
    {
      "id": 9,
      "start": 8161.16,
      "end": 8165.4,
      "formatted_start": "02:16:01.160",
      "formatted_end": "02:16:05.400",
      "text": "حالا اگه تنظیم نتونستی بکنید هر عددی که اونجا نوشته"
    },
    {
      "id": 10,
      "start": 8165.4,
      "end": 8172.4,
      "formatted_start": "02:16:05.400",
      "formatted_end": "02:16:12.400",
      "text": "منهای سی و دو کن، خب تقسیم برای یک ممیزه هشت بکن"
    },
    {
      "id": 11,
      "start": 8172.4,
      "end": 8176.4,
      "formatted_start": "02:16:12.400",
      "formatted_end": "02:16:16.400",
      "text": "این میشه دمای بچه"
    },
    {
      "id": 12,
      "start": 8176.4,
      "end": 8178.4,
      "formatted_start": "02:16:16.400",
      "formatted_end": "02:16:18.400",
      "text": "آره، اینجا بسات نمشتم"
    },
    {
      "id": 13,
      "start": 8178.4,
      "end": 8180.4,
      "formatted_start": "02:16:18.400",
      "formatted_end": "02:16:20.400",
      "text": "چون اون به فارنهایت هست"
    },
    {
      "id": 14,
      "start": 8180.4,
      "end": 8182.4,
      "formatted_start": "02:16:20.400",
      "formatted_end": "02:16:22.400",
      "text": "نه قبل اون رو..."
    },
    {
      "id": 15,
      "start": 8182.4,
      "end": 8184.4,
      "formatted_start": "02:16:22.400",
      "formatted_end": "02:16:24.400",
      "text": "کنارش اص نمشته احتمالا"
    },
    {
      "id": 16,
      "start": 8184.4,
      "end": 8187.4,
      "formatted_start": "02:16:24.400",
      "formatted_end": "02:16:27.400",
      "text": "آره میده، قبل اون رو سی و هشت باشه و همه چی نشانون نه"
    },
    {
      "id": 17,
      "start": 8187.4,
      "end": 8188.4,
      "formatted_start": "02:16:27.400",
      "formatted_end": "02:16:28.400",
      "text": "خب"
    },
    {
      "id": 18,
      "start": 8188.4,
      "end": 8190.4,
      "formatted_start": "02:16:28.400",
      "formatted_end": "02:16:30.400",
      "text": "وقتی این رو برسو پرشن، آن رو خرابش کرد"
    },
    {
      "id": 19,
      "start": 8190.4,
      "end": 8192.4,
      "formatted_start": "02:16:30.400",
      "formatted_end": "02:16:32.400",
      "text": "پس از این که نداری، بخوی از اوها داری"
    },
    {
      "id": 20,
      "start": 8192.4,
      "end": 8194.4,
      "formatted_start": "02:16:32.400",
      "formatted_end": "02:16:34.400",
      "text": "آره این ها میدهیم، مثل این"
    },
    {
      "id": 21,
      "start": 8194.4,
      "end": 8196.4,
      "formatted_start": "02:16:34.400",
      "formatted_end": "02:16:36.400",
      "text": "بسیار دوست داریم"
    },
    {
      "id": 22,
      "start": 8196.4,
      "end": 8198.4,
      "formatted_start": "02:16:36.400",
      "formatted_end": "02:16:38.400",
      "text": "بسیار همونه بگیر آوی درگیز شد"
    },
    {
      "id": 23,
      "start": 8198.4,
      "end": 8200.4,
      "formatted_start": "02:16:38.400",
      "formatted_end": "02:16:40.400",
      "text": "دفترش بزنی خوشنگ میشه"
    },
    {
      "id": 24,
      "start": 8200.4,
      "end": 8202.4,
      "formatted_start": "02:16:40.400",
      "formatted_end": "02:16:42.400",
      "text": "یک ال و یکی میاد"
    },
    {
      "id": 25,
      "start": 8202.4,
      "end": 8204.4,
      "formatted_start": "02:16:42.400",
      "formatted_end": "02:16:44.400",
      "text": "رو بخوک سدامه داریم"
    },
    {
      "id": 26,
      "start": 8204.4,
      "end": 8206.4,
      "formatted_start": "02:16:44.400",
      "formatted_end": "02:16:46.400",
      "text": "آره آره همونه"
    },
    {
      "id": 27,
      "start": 8206.4,
      "end": 8208.4,
      "formatted_start": "02:16:46.400",
      "formatted_end": "02:16:48.400",
      "text": "ولی مانتو اینجا افت نوشته باید سی نوشته باشه"
    },
    {
      "id": 28,
      "start": 8208.4,
      "end": 8210.4,
      "formatted_start": "02:16:48.400",
      "formatted_end": "02:16:50.400",
      "text": "این تنظیمش به هم خورده"
    },
    {
      "id": 29,
      "start": 8214.4,
      "end": 8216.4,
      "formatted_start": "02:16:54.400",
      "formatted_end": "02:16:56.400",
      "text": "بیا عزیزم اینم کود رهتیریش"
    },
    {
      "id": 30,
      "start": 8218.4,
      "end": 8220.4,
      "formatted_start": "02:16:58.400",
      "formatted_end": "02:17:00.400",
      "text": "این بازم گوش نشد"
    },
    {
      "id": 31,
      "start": 8220.4,
      "end": 8222.4,
      "formatted_start": "02:17:00.400",
      "formatted_end": "02:17:02.400",
      "text": "آره"
    },
    {
      "id": 32,
      "start": 8222.4,
      "end": 8226.4,
      "formatted_start": "02:17:02.400",
      "formatted_end": "02:17:06.400",
      "text": "میخوای باید چون آتا بهش شیر بده"
    },
    {
      "id": 33,
      "start": 8226.4,
      "end": 8228.4,
      "formatted_start": "02:17:06.400",
      "formatted_end": "02:17:08.400",
      "text": "ببینیم"
    },
    {
      "id": 34,
      "start": 8228.4,
      "end": 8230.4,
      "formatted_start": "02:17:08.400",
      "formatted_end": "02:17:10.400",
      "text": "ببینیم"
    },
    {
      "id": 35,
      "start": 8230.4,
      "end": 8232.4,
      "formatted_start": "02:17:10.400",
      "formatted_end": "02:17:12.400",
      "text": "این صبح بشک آگوش نوای آگوش باقی نده"
    },
    {
      "id": 36,
      "start": 8232.4,
      "end": 8234.4,
      "formatted_start": "02:17:12.400",
      "formatted_end": "02:17:14.400",
      "text": "من از اون نن ندهش"
    },
    {
      "id": 37,
      "start": 8234.4,
      "end": 8236.4,
      "formatted_start": "02:17:14.400",
      "formatted_end": "02:17:16.400",
      "text": "من میگم اینجورش گفته نده مادر منم بش بده"
    },
    {
      "id": 38,
      "start": 8236.4,
      "end": 8238.4,
      "formatted_start": "02:17:16.400",
      "formatted_end": "02:17:18.400",
      "text": "نه نه اصلا بش نده فقط شیر"
    },
    {
      "id": 39,
      "start": 8238.4,
      "end": 8240.4,
      "formatted_start": "02:17:18.400",
      "formatted_end": "02:17:20.400",
      "text": "بز نمیگیره ها اونو بش بده"
    },
    {
      "id": 40,
      "start": 8240.4,
      "end": 8242.4,
      "formatted_start": "02:17:20.400",
      "formatted_end": "02:17:22.400",
      "text": "بزش کم میشه"
    },
    {
      "id": 41,
      "start": 8242.4,
      "end": 8244.4,
      "formatted_start": "02:17:22.400",
      "formatted_end": "02:17:24.400",
      "text": "کم میشه"
    },
    {
      "id": 42,
      "start": 8250.4,
      "end": 8252.4,
      "formatted_start": "02:17:30.400",
      "formatted_end": "02:17:32.400",
      "text": "همینطور بره بره بکنی"
    },
    {
      "id": 43,
      "start": 8252.4,
      "end": 8254.4,
      "formatted_start": "02:17:32.400",
      "formatted_end": "02:17:34.400",
      "text": "نه نه اصلا نه بکنی"
    },
    {
      "id": 44,
      "start": 8254.4,
      "end": 8256.4,
      "formatted_start": "02:17:34.400",
      "formatted_end": "02:17:36.400",
      "text": "کنوتو کده وقتی اینه؟"
    },
    {
      "id": 45,
      "start": 8256.4,
      "end": 8258.4,
      "formatted_start": "02:17:36.400",
      "formatted_end": "02:17:38.400",
      "text": "بله بله"
    },
    {
      "id": 46,
      "start": 8266.4,
      "end": 8268.4,
      "formatted_start": "02:17:46.400",
      "formatted_end": "02:17:48.400",
      "text": "باید درست برم شیطون"
    },
    {
      "id": 47,
      "start": 8268.4,
      "end": 8270.4,
      "formatted_start": "02:17:48.400",
      "formatted_end": "02:17:50.400",
      "text": "نه دیگه"
    },
    {
      "id": 48,
      "start": 8270.4,
      "end": 8273.4,
      "formatted_start": "02:17:50.400",
      "formatted_end": "02:17:53.400",
      "text": "حالا روشت باید جونه شدی بیار همه کامل به واسه نمیشتم"
    },
    {
      "id": 49,
      "start": 8273.4,
      "end": 8274.4,
      "formatted_start": "02:17:53.400",
      "formatted_end": "02:17:54.400",
      "text": "خودش بردن"
    },
    {
      "id": 50,
      "start": 8274.4,
      "end": 8275.4,
      "formatted_start": "02:17:54.400",
      "formatted_end": "02:17:55.400",
      "text": "خودش بردن"
    },
    {
      "id": 51,
      "start": 8275.4,
      "end": 8276.4,
      "formatted_start": "02:17:55.400",
      "formatted_end": "02:17:56.400",
      "text": "خودش بردن"
    },
    {
      "id": 52,
      "start": 8276.4,
      "end": 8277.4,
      "formatted_start": "02:17:56.400",
      "formatted_end": "02:17:57.400",
      "text": "خوش بشین"
    },
    {
      "id": 53,
      "start": 8277.4,
      "end": 8278.4,
      "formatted_start": "02:17:57.400",
      "formatted_end": "02:17:58.400",
      "text": "خوش بشین"
    },
    {
      "id": 54,
      "start": 8278.4,
      "end": 8279.4,
      "formatted_start": "02:17:58.400",
      "formatted_end": "02:17:59.400",
      "text": "خودش بردن"
    },
    {
      "id": 55,
      "start": 8279.4,
      "end": 8280.4,
      "formatted_start": "02:17:59.400",
      "formatted_end": "02:18:00.400",
      "text": "خودش بردن"
    },
    {
      "id": 56,
      "start": 8280.4,
      "end": 8281.4,
      "formatted_start": "02:18:00.400",
      "formatted_end": "02:18:01.400",
      "text": "خودش بردن"
    },
    {
      "id": 57,
      "start": 8285.4,
      "end": 8287.4,
      "formatted_start": "02:18:05.400",
      "formatted_end": "02:18:07.400",
      "text": "خوش همه درها"
    },
    {
      "id": 58,
      "start": 8288.4,
      "end": 8290.4,
      "formatted_start": "02:18:08.400",
      "formatted_end": "02:18:10.400",
      "text": "میجه دونم جانت خونم"
    },
    {
      "id": 59,
      "start": 8290.4,
      "end": 8292.4,
      "formatted_start": "02:18:10.400",
      "formatted_end": "02:18:12.400",
      "text": "بکنم همه اشتاق عزیزش کنم"
    },
    {
      "id": 60,
      "start": 8292.4,
      "end": 8293.4,
      "formatted_start": "02:18:12.400",
      "formatted_end": "02:18:13.400",
      "text": "دوتا بیرونن"
    },
    {
      "id": 61,
      "start": 8293.4,
      "end": 8294.4,
      "formatted_start": "02:18:13.400",
      "formatted_end": "02:18:14.400",
      "text": "البته یکیش ماه نست"
    },
    {
      "id": 62,
      "start": 8294.4,
      "end": 8296.4,
      "formatted_start": "02:18:14.400",
      "formatted_end": "02:18:16.400",
      "text": "یکیش تابع بازمانش عزیزی"
    },
    {
      "id": 63,
      "start": 8297.4,
      "end": 8299.4,
      "formatted_start": "02:18:17.400",
      "formatted_end": "02:18:19.400",
      "text": "همه بازمانی هم عوض کن ماما"
    },
    {
      "id": 64,
      "start": 8299.4,
      "end": 8301.4,
      "formatted_start": "02:18:19.400",
      "formatted_end": "02:18:21.400",
      "text": "امروز رو باید نظرم کنم"
    },
    {
      "id": 65,
      "start": 8301.4,
      "end": 8302.4,
      "formatted_start": "02:18:21.400",
      "formatted_end": "02:18:22.400",
      "text": "نه نه باشه"
    },
    {
      "id": 66,
      "start": 8302.4,
      "end": 8305.4,
      "formatted_start": "02:18:22.400",
      "formatted_end": "02:18:25.400",
      "text": "بعد فائضه افغانش که پمبه میداری"
    },
    {
      "id": 67,
      "start": 8305.4,
      "end": 8307.4,
      "formatted_start": "02:18:25.400",
      "formatted_end": "02:18:27.400",
      "text": "یه فره کمتر افغان کن"
    },
    {
      "id": 68,
      "start": 8307.4,
      "end": 8310.4,
      "formatted_start": "02:18:27.400",
      "formatted_end": "02:18:30.400",
      "text": "بعد مثلا هر روزهای دیگه مثلا دیگه خوش خوده"
    },
    {
      "id": 69,
      "start": 8310.4,
      "end": 8312.4,
      "formatted_start": "02:18:30.400",
      "formatted_end": "02:18:32.400",
      "text": "دوباره یه زنش اتفاق میخواد"
    },
    {
      "id": 70,
      "start": 8312.4,
      "end": 8315.4,
      "formatted_start": "02:18:32.400",
      "formatted_end": "02:18:35.400",
      "text": "میچکر کن و بعد این رو"
    },
    {
      "id": 71,
      "start": 8315.4,
      "end": 8317.4,
      "formatted_start": "02:18:35.400",
      "formatted_end": "02:18:37.400",
      "text": "بعد میخوام بزنم تو گوش بچه"
    },
    {
      "id": 72,
      "start": 8317.4,
      "end": 8319.4,
      "formatted_start": "02:18:37.400",
      "formatted_end": "02:18:39.400",
      "text": "افغان یخ میکنه"
    },
    {
      "id": 73,
      "start": 8319.4,
      "end": 8320.4,
      "formatted_start": "02:18:39.400",
      "formatted_end": "02:18:40.400",
      "text": "خب؟"
    },
    {
      "id": 74,
      "start": 8320.4,
      "end": 8322.4,
      "formatted_start": "02:18:40.400",
      "formatted_end": "02:18:42.400",
      "text": "بعد هیون تکونش بدم"
    },
    {
      "id": 75,
      "start": 8322.4,
      "end": 8326.4,
      "formatted_start": "02:18:42.400",
      "formatted_end": "02:18:46.400",
      "text": "با خود پارتر لباساشو من خوش میکنم"
    },
    {
      "id": 76,
      "start": 8326.4,
      "end": 8327.4,
      "formatted_start": "02:18:46.400",
      "formatted_end": "02:18:47.400",
      "text": "خب؟"
    },
    {
      "id": 77,
      "start": 8327.4,
      "end": 8329.4,
      "formatted_start": "02:18:47.400",
      "formatted_end": "02:18:49.400",
      "text": "چه خود؟"
    },
    {
      "id": 78,
      "start": 8329.4,
      "end": 8330.4,
      "formatted_start": "02:18:49.400",
      "formatted_end": "02:18:50.400",
      "text": "چه خود؟"
    },
    {
      "id": 79,
      "start": 8330.4,
      "end": 8333.4,
      "formatted_start": "02:18:50.400",
      "formatted_end": "02:18:53.400",
      "text": "بستنده شوشوشو"
    },
    {
      "id": 80,
      "start": 8334.4,
      "end": 8337.4,
      "formatted_start": "02:18:54.400",
      "formatted_end": "02:18:57.400",
      "text": "اینه آب مصرف کردن مثل"
    },
    {
      "id": 81,
      "start": 8340.4,
      "end": 8341.4,
      "formatted_start": "02:19:00.400",
      "formatted_end": "02:19:01.400",
      "text": "کلن؟"
    },
    {
      "id": 82,
      "start": 8341.4,
      "end": 8342.4,
      "formatted_start": "02:19:01.400",
      "formatted_end": "02:19:02.400",
      "text": "این تفلاک شوهره"
    },
    {
      "id": 83,
      "start": 8342.4,
      "end": 8344.4,
      "formatted_start": "02:19:02.400",
      "formatted_end": "02:19:04.400",
      "text": "این تو مایه آب؟"
    },
    {
      "id": 84,
      "start": 8344.4,
      "end": 8346.4,
      "formatted_start": "02:19:04.400",
      "formatted_end": "02:19:06.400",
      "text": "یعنی اینو برشکسته کامل می کنی"
    },
    {
      "id": 85,
      "start": 8346.4,
      "end": 8348.4,
      "formatted_start": "02:19:06.400",
      "formatted_end": "02:19:08.400",
      "text": "می شوندیش تو خوده"
    },
    {
      "id": 86,
      "start": 8350.4,
      "end": 8352.4,
      "formatted_start": "02:19:10.400",
      "formatted_end": "02:19:12.400",
      "text": "کم او با بیزا"
    },
    {
      "id": 87,
      "start": 8352.4,
      "end": 8355.4,
      "formatted_start": "02:19:12.400",
      "formatted_end": "02:19:15.400",
      "text": "قضا قطعا بخوایی درست بکنی؟"
    },
    {
      "id": 88,
      "start": 8355.4,
      "end": 8359.72,
      "formatted_start": "02:19:15.400",
      "formatted_end": "02:19:19.720",
      "text": "اگه تازه گوشت خریده باشه که تمام اینها رو درست میکنه"
    },
    {
      "id": 89,
      "start": 8360.44,
      "end": 8363.24,
      "formatted_start": "02:19:20.440",
      "formatted_end": "02:19:23.240",
      "text": "دوتا بسته بوده باشه توی این پیلی سره"
    },
    {
      "id": 90,
      "start": 8363.24,
      "end": 8365.64,
      "formatted_start": "02:19:23.240",
      "formatted_end": "02:19:25.640",
      "text": "هر دوتا رو درست میکنه زودتر تمام میشه"
    },
    {
      "id": 91,
      "start": 8368.2,
      "end": 8370.76,
      "formatted_start": "02:19:28.200",
      "formatted_end": "02:19:30.760",
      "text": "این همین چه عادتیه خیلی خوبی"
    },
    {
      "id": 92,
      "start": 8372.04,
      "end": 8373.0,
      "formatted_start": "02:19:32.040",
      "formatted_end": "02:19:33.000",
      "text": "خیلی خوبی"
    },
    {
      "id": 93,
      "start": 8373.64,
      "end": 8377.08,
      "formatted_start": "02:19:33.640",
      "formatted_end": "02:19:37.080",
      "text": "ببین اینا چیزها انگار جز شخصیت یادر میشه"
    },
    {
      "id": 94,
      "start": 8377.08,
