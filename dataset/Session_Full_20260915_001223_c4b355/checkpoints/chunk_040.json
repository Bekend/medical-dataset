  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12017.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:17.000",
      "text": "این کشت ها ببینم، این کشت ها ببینم، به حال مریضان نمیدونن ویروس جدیده رو گرفتن."
    },
    {
      "id": 1,
      "start": 12017.0,
      "end": 12021.0,
      "formatted_start": "03:20:17.000",
      "formatted_end": "03:20:21.000",
      "text": "یک تپ میدن، همه علامتی رو دیدم ندارن"
    },
    {
      "id": 2,
      "start": 12021.0,
      "end": 12024.0,
      "formatted_start": "03:20:21.000",
      "formatted_end": "03:20:24.000",
      "text": "حالا بعضی از بچه ها گلی داردن شاکی هستن"
    },
    {
      "id": 3,
      "start": 12024.0,
      "end": 12027.0,
      "formatted_start": "03:20:24.000",
      "formatted_end": "03:20:27.000",
      "text": "بعد اینها سه بز مهمونم تپ میکنن"
    },
    {
      "id": 4,
      "start": 12027.0,
      "end": 12032.0,
      "formatted_start": "03:20:27.000",
      "formatted_end": "03:20:32.000",
      "text": "بعد تپشون قد میشه، ممکنه بعد از که تپشون قد بشه تنشون گونه برزه به رو"
    },
    {
      "id": 5,
      "start": 12032.0,
      "end": 12035.0,
      "formatted_start": "03:20:32.000",
      "formatted_end": "03:20:35.000",
      "text": "اگه اینجوری شد یعنی خوب شدن"
    },
    {
      "id": 6,
      "start": 12035.0,
      "end": 12039.0,
      "formatted_start": "03:20:35.000",
      "formatted_end": "03:20:39.000",
      "text": "پس فقط برم به کیان تپ بر بده"
    },
    {
      "id": 7,
      "start": 12039.0,
      "end": 12043.0,
      "formatted_start": "03:20:39.000",
      "formatted_end": "03:20:43.000",
      "text": "یک شربت پلاشین، این دو تار بهش بده"
    },
    {
      "id": 8,
      "start": 12043.0,
      "end": 12048.0,
      "formatted_start": "03:20:43.000",
      "formatted_end": "03:20:48.000",
      "text": "برده برده اگر دیدی علامت جدیدی ده بکن به من خبر بده"
    },
    {
      "id": 9,
      "start": 12048.0,
      "end": 12055.0,
      "formatted_start": "03:20:48.000",
      "formatted_end": "03:20:55.000",
      "text": "خب حالا این چه بروفن داری؟ تو اصلا شیاف هم داری؟"
    },
    {
      "id": 10,
      "start": 12055.0,
      "end": 12058.0,
      "formatted_start": "03:20:55.000",
      "formatted_end": "03:20:58.000",
      "text": "شیاف درستم بیشتر بگم بزرگ منت بگیم"
    },
    {
      "id": 11,
      "start": 12058.0,
      "end": 12065.0,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:05.000",
      "text": "باشه ببین شیاف اصلا منافع 325 یا 125"
    },
    {
      "id": 12,
      "start": 12065.0,
      "end": 12067.0,
      "formatted_start": "03:21:05.000",
      "formatted_end": "03:21:07.000",
      "text": "125 رو دوتا بزن برش"
    },
    {
      "id": 13,
      "start": 12067.0,
      "end": 12067.66,
      "formatted_start": "03:21:07.000",
      "formatted_end": "03:21:07.660",
      "text": "خب؟"
    },
    {
      "id": 14,
      "start": 12067.66,
      "end": 12068.24,
      "formatted_start": "03:21:07.660",
      "formatted_end": "03:21:08.240",
      "text": "بگو"
    },
    {
      "id": 15,
      "start": 12068.24,
      "end": 12070.0,
      "formatted_start": "03:21:08.240",
      "formatted_end": "03:21:10.000",
      "text": "5 کلوه چهار زمانی میگرد"
    },
    {
      "id": 16,
      "start": 12070.0,
      "end": 12070.58,
      "formatted_start": "03:21:10.000",
      "formatted_end": "03:21:10.580",
      "text": "دوتا بزن"
    },
    {
      "id": 17,
      "start": 12070.58,
      "end": 12072.06,
      "formatted_start": "03:21:10.580",
      "formatted_end": "03:21:12.060",
      "text": "یا یکی و نصفی برش"
    },
    {
      "id": 18,
      "start": 12072.06,
      "end": 12073.42,
      "formatted_start": "03:21:12.060",
      "formatted_end": "03:21:13.420",
      "text": "اما دوتا بزن"
    },
    {
      "id": 19,
      "start": 12073.42,
      "end": 12074.42,
      "formatted_start": "03:21:13.420",
      "formatted_end": "03:21:14.420",
      "text": "دوتا بزن"
    },
    {
      "id": 20,
      "start": 12074.42,
      "end": 12076.0,
      "formatted_start": "03:21:14.420",
      "formatted_end": "03:21:16.000",
      "text": "اگر طب بالا بود"
    },
    {
      "id": 21,
      "start": 12076.0,
      "end": 12077.0,
      "formatted_start": "03:21:16.000",
      "formatted_end": "03:21:17.000",
      "text": "خب؟"
    },
    {
      "id": 22,
      "start": 12077.0,
      "end": 12080.62,
      "formatted_start": "03:21:17.000",
      "formatted_end": "03:21:20.620",
      "text": "وگرنکه شروط رفت نامی آسانی"
    },
    {
      "id": 23,
      "start": 12080.62,
      "end": 12082.38,
      "formatted_start": "03:21:20.620",
      "formatted_end": "03:21:22.380",
      "text": "هر چهار ساعت"
    },
    {
      "id": 24,
      "start": 12082.38,
      "end": 12084.24,
      "formatted_start": "03:21:22.380",
      "formatted_end": "03:21:24.240",
      "text": "بهش 7 سی سی میدی"
    },
    {
      "id": 25,
      "start": 12084.24,
      "end": 12086.52,
      "formatted_start": "03:21:24.240",
      "formatted_end": "03:21:26.520",
      "text": "اگه طبش قد نشد"
    },
    {
      "id": 26,
      "start": 12086.52,
      "end": 12088.2,
      "formatted_start": "03:21:26.520",
      "formatted_end": "03:21:28.200",
      "text": "6 سی سی هم"
    },
    {
      "id": 27,
      "start": 12088.2,
      "end": 12089.62,
      "formatted_start": "03:21:28.200",
      "formatted_end": "03:21:29.620",
      "text": "هیوکار فردش میدی"
    },
    {
      "id": 28,
      "start": 12089.62,
      "end": 12091.42,
      "formatted_start": "03:21:29.620",
      "formatted_end": "03:21:31.420",
      "text": "خب؟"
    },
    {
      "id": 29,
      "start": 12091.42,
      "end": 12094.12,
      "formatted_start": "03:21:31.420",
      "formatted_end": "03:21:34.120",
      "text": "اگر طب قد نشد"
    },
    {
      "id": 30,
      "start": 12094.12,
      "end": 12097.12,
      "formatted_start": "03:21:34.120",
      "formatted_end": "03:21:37.120",
      "text": "بعد پیلارژین هم بهش میدهیم"
    },
    {
      "id": 31,
      "start": 12097.12,
      "end": 12100.12,
      "formatted_start": "03:21:37.120",
      "formatted_end": "03:21:40.120",
      "text": "هر هشت ساعت دونست بزنیم"
    },
    {
      "id": 32,
      "start": 12100.12,
      "end": 12103.12,
      "formatted_start": "03:21:40.120",
      "formatted_end": "03:21:43.120",
      "text": "یه شهرت بلدین کم بهش بده"
    },
    {
      "id": 33,
      "start": 12103.12,
      "end": 12105.12,
      "formatted_start": "03:21:43.120",
      "formatted_end": "03:21:45.120",
      "text": "اینکه سیسته میدنی شد"
    },
    {
      "id": 34,
      "start": 12105.12,
      "end": 12107.12,
      "formatted_start": "03:21:45.120",
      "formatted_end": "03:21:47.120",
      "text": "روزی درستی درست بشه"
    },
    {
      "id": 35,
      "start": 12107.12,
      "end": 12109.12,
      "formatted_start": "03:21:47.120",
      "formatted_end": "03:21:49.120",
      "text": "یه قشنگ قطعه آن"
    },
    {
      "id": 36,
      "start": 12109.12,
      "end": 12113.12,
      "formatted_start": "03:21:49.120",
      "formatted_end": "03:21:53.120",
      "text": "حالا می کنم عرض جدیدی فیلتر کرده من خبرتش"
    },
    {
      "id": 37,
      "start": 12113.12,
      "end": 12115.12,
      "formatted_start": "03:21:53.120",
      "formatted_end": "03:21:55.120",
      "text": "بیا بیا بیا"
    },
    {
      "id": 38,
      "start": 12115.12,
      "end": 12118.12,
      "formatted_start": "03:21:55.120",
      "formatted_end": "03:21:58.120",
      "text": "چونه بزن؟ ببین سرم"
    },
    {
      "id": 39,
      "start": 12118.12,
      "end": 12123.12,
      "formatted_start": "03:21:58.120",
      "formatted_end": "03:22:03.120",
      "text": "خب از این ایبو پروفرم براش بنویسن"
    },
    {
      "id": 40,
      "start": 12123.12,
      "end": 12125.62,
      "formatted_start": "03:22:03.120",
      "formatted_end": "03:22:05.620",
      "text": "من یعنی اون رو ماما داشتم"
    },
    {
      "id": 41,
      "start": 12125.62,
      "end": 12128.56,
      "formatted_start": "03:22:05.620",
      "formatted_end": "03:22:08.560",
      "text": "یعنی کارن بهش داده بودیم، میگرد ماما کارن دارم شد"
    },
    {
      "id": 42,
      "start": 12131.56,
      "end": 12133.16,
      "formatted_start": "03:22:11.560",
      "formatted_end": "03:22:13.160",
      "text": "همه از اون خونه ماما رو تجمعیم"
    },
    {
      "id": 43,
      "start": 12133.16,
      "end": 12133.66,
      "formatted_start": "03:22:13.160",
      "formatted_end": "03:22:13.660",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 12136.3,
      "end": 12136.96,
      "formatted_start": "03:22:16.300",
      "formatted_end": "03:22:16.960",
      "text": "اون برخونه ای بود"
    },
    {
      "id": 45,
      "start": 12136.96,
      "end": 12138.46,
      "formatted_start": "03:22:16.960",
      "formatted_end": "03:22:18.460",
      "text": "اون برخونه همسرم نبود خب"
    },
    {
      "id": 46,
      "start": 12138.46,
      "end": 12140.18,
      "formatted_start": "03:22:18.460",
      "formatted_end": "03:22:20.180",
      "text": "بعد عادت کرده بودیم خونه ماما"
    },
    {
      "id": 47,
      "start": 12140.18,
      "end": 12140.68,
      "formatted_start": "03:22:20.180",
      "formatted_end": "03:22:20.680",
      "text": "آها"
    },
    {
      "id": 48,
      "start": 12140.68,
      "end": 12142.48,
      "formatted_start": "03:22:20.680",
      "formatted_end": "03:22:22.480",
      "text": "بعد یوسف برشنه بود"
    },
    {
      "id": 49,
      "start": 12142.48,
      "end": 12144.88,
      "formatted_start": "03:22:22.480",
      "formatted_end": "03:22:24.880",
      "text": "بعد همه تازه شیش ماه انتقالش گربه هم درست شده"
    },
    {
      "id": 50,
      "start": 12144.88,
      "end": 12146.78,
      "formatted_start": "03:22:24.880",
      "formatted_end": "03:22:26.780",
      "text": "فقط آخر هفته ها من میردم خونه"
    },
    {
      "id": 51,
      "start": 12146.78,
      "end": 12149.22,
      "formatted_start": "03:22:26.780",
      "formatted_end": "03:22:29.220",
      "text": "دیوان از شامت تجمع مامان"
    },
    {
      "id": 52,
      "start": 12149.22,
      "end": 12151.22,
      "formatted_start": "03:22:29.220",
      "formatted_end": "03:22:31.220",
      "text": "اون خوهره هم که شوهرش دیگه"
    },
    {
      "id": 53,
      "start": 12151.22,
      "end": 12153.22,
      "formatted_start": "03:22:31.220",
      "formatted_end": "03:22:33.220",
      "text": "اونم شوهر خوهره هسته"
    },
    {
      "id": 54,
      "start": 12153.22,
      "end": 12156.22,
      "formatted_start": "03:22:33.220",
      "formatted_end": "03:22:36.220",
      "text": "پونده روز که میست خب اینجاست پونده از گل تا بعدت رو بشه"
    },
    {
      "id": 55,
      "start": 12156.22,
      "end": 12159.22,
      "formatted_start": "03:22:36.220",
      "formatted_end": "03:22:39.220",
      "text": "شاید باید روز اخیرین کرده چند تا مرد"
    },
    {
      "id": 56,
      "start": 12161.22,
      "end": 12163.22,
      "formatted_start": "03:22:41.220",
      "formatted_end": "03:22:43.220",
      "text": "صرف نکی بابا ماما اینجاست"
    },
    {
      "id": 57,
      "start": 12163.22,
      "end": 12166.22,
      "formatted_start": "03:22:43.220",
      "formatted_end": "03:22:46.220",
      "text": "تو باید نفت راهت بگیر"
    },
    {
      "id": 58,
      "start": 12167.22,
      "end": 12169.22,
      "formatted_start": "03:22:47.220",
      "formatted_end": "03:22:49.220",
      "text": "ولی خب خیف دارست"
    },
    {
      "id": 59,
      "start": 12169.22,
      "end": 12171.22,
      "formatted_start": "03:22:49.220",
      "formatted_end": "03:22:51.220",
      "text": "خیلی ازا دوست ندارم و ببین"
    },
    {
      "id": 60,
      "start": 12171.22,
      "end": 12173.22,
      "formatted_start": "03:22:51.220",
      "formatted_end": "03:22:53.220",
      "text": "مرمون باید بردارید"
    },
    {
      "id": 61,
      "start": 12173.22,
      "end": 12175.22,
      "formatted_start": "03:22:53.220",
      "formatted_end": "03:22:55.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 62,
      "start": 12175.22,
      "end": 12177.22,
      "formatted_start": "03:22:55.220",
      "formatted_end": "03:22:57.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 63,
      "start": 12177.22,
      "end": 12179.22,
      "formatted_start": "03:22:57.220",
      "formatted_end": "03:22:59.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 64,
      "start": 12179.22,
      "end": 12181.22,
      "formatted_start": "03:22:59.220",
      "formatted_end": "03:23:01.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 65,
      "start": 12181.22,
      "end": 12183.22,
      "formatted_start": "03:23:01.220",
      "formatted_end": "03:23:03.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 66,
      "start": 12183.22,
      "end": 12185.22,
      "formatted_start": "03:23:03.220",
      "formatted_end": "03:23:05.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 67,
      "start": 12185.22,
      "end": 12187.22,
      "formatted_start": "03:23:05.220",
      "formatted_end": "03:23:07.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 68,
      "start": 12187.22,
      "end": 12189.22,
      "formatted_start": "03:23:07.220",
      "formatted_end": "03:23:09.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 69,
      "start": 12189.22,
      "end": 12191.22,
      "formatted_start": "03:23:09.220",
      "formatted_end": "03:23:11.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 70,
      "start": 12191.22,
      "end": 12193.22,
      "formatted_start": "03:23:11.220",
      "formatted_end": "03:23:13.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 71,
      "start": 12193.22,
      "end": 12195.22,
      "formatted_start": "03:23:13.220",
      "formatted_end": "03:23:15.220",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 72,
      "start": 12195.22,
      "end": 12197.22,
      "formatted_start": "03:23:15.220",
      "formatted_end": "03:23:17.220",
      "text": "ماما درسته؟"
    },
    {
      "id": 73,
      "start": 12197.22,
      "end": 12199.22,
      "formatted_start": "03:23:17.220",
      "formatted_end": "03:23:19.220",
      "text": "آره آره ماما داخله بزنگیده"
    },
    {
      "id": 74,
      "start": 12199.22,
      "end": 12201.22,
      "formatted_start": "03:23:19.220",
      "formatted_end": "03:23:21.220",
      "text": "آره"
    },
    {
      "id": 75,
      "start": 12201.22,
      "end": 12203.22,
      "formatted_start": "03:23:21.220",
      "formatted_end": "03:23:23.220",
      "text": "ماما اینه چرا به شما شرم شد؟ خاموش میشه"
    },
    {
      "id": 76,
      "start": 12203.22,
      "end": 12205.22,
      "formatted_start": "03:23:23.220",
      "formatted_end": "03:23:25.220",
      "text": "آره بره"
    },
    {
      "id": 77,
      "start": 12205.22,
      "end": 12207.22,
      "formatted_start": "03:23:25.220",
      "formatted_end": "03:23:27.220",
      "text": "ماما بریم"
    },
    {
      "id": 78,
      "start": 12207.22,
      "end": 12209.22,
      "formatted_start": "03:23:27.220",
      "formatted_end": "03:23:29.220",
      "text": "خاموش شد دیگه"
    },
    {
      "id": 79,
      "start": 12209.22,
      "end": 12211.22,
      "formatted_start": "03:23:29.220",
      "formatted_end": "03:23:31.220",
      "text": "الان میریم دیگه"
    },
    {
      "id": 80,
      "start": 12213.22,
      "end": 12215.22,
      "formatted_start": "03:23:33.220",
      "formatted_end": "03:23:35.220",
      "text": "شیخه ها رو نداره"
    },
    {
      "id": 81,
      "start": 12217.22,
      "end": 12219.22,
      "formatted_start": "03:23:37.220",
      "formatted_end": "03:23:39.220",
      "text": "الان این خود هم"
    },
    {
      "id": 82,
      "start": 12219.22,
      "end": 12221.22,
      "formatted_start": "03:23:39.220",
      "formatted_end": "03:23:41.220",
      "text": "میده درد شده و میره ویروسه"
    },
    {
      "id": 83,
      "start": 12221.22,
      "end": 12223.22,
      "formatted_start": "03:23:41.220",
      "formatted_end": "03:23:43.220",
      "text": "ماما"
    },
    {
      "id": 84,
      "start": 12223.22,
      "end": 12253.22,
      "formatted_start": "03:23:43.220",
      "formatted_end": "03:24:13.220",
      "text": "اینکه درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که باید درسته که بای"
    },
    {
      "id": 85,
      "start": 12253.22,
      "end": 12255.22,
      "formatted_start": "03:24:13.220",
      "formatted_end": "03:24:15.220",
      "text": "شب قبل خود"
    },
    {
      "id": 86,
      "start": 12255.22,
      "end": 12257.22,
      "formatted_start": "03:24:15.220",
      "formatted_end": "03:24:17.220",
      "text": "شب قبل"
    },
    {
      "id": 87,
      "start": 12257.22,
      "end": 12259.22,
      "formatted_start": "03:24:17.220",
      "formatted_end": "03:24:19.220",
      "text": "آنت رو دلتو صبح ناشتا بکن"
    },
    {
      "id": 88,
      "start": 12259.22,
      "end": 12261.22,
      "formatted_start": "03:24:19.220",
      "formatted_end": "03:24:21.220",
      "text": "خب"
    },
    {
      "id": 89,
      "start": 12261.22,
      "end": 12263.22,
      "formatted_start": "03:24:21.220",
      "formatted_end": "03:24:23.220",
      "text": "الان این وسط"
    },
    {
      "id": 90,
      "start": 12263.22,
      "end": 12265.22,
      "formatted_start": "03:24:23.220",
      "formatted_end": "03:24:25.220",
      "text": "هر موقعی که مثلا بده درد داشتی"
    },
    {
      "id": 91,
      "start": 12265.22,
      "end": 12267.22,
      "formatted_start": "03:24:25.220",
      "formatted_end": "03:24:27.220",
      "text": "اون شربت رو بکن شربت بده تو بکن"
    },
    {
      "id": 92,
      "start": 12267.22,
      "end": 12269.22,
      "formatted_start": "03:24:27.220",
      "formatted_end": "03:24:29.220",
      "text": "ولی این دوتا رو بکنی خیلی مهم کن"
    },
    {
      "id": 93,
      "start": 12269.22,
      "end": 12271.22,
      "formatted_start": "03:24:29.220",
      "formatted_end": "03:24:31.220",
      "text": "جوابی داری"
    },
    {
      "id": 94,
      "start": 12271.22,
      "end": 12273.22,
      "formatted_start": "03:24:31.220",
      "formatted_end": "03:24:33.220",
      "text": "دیگه"
    },
    {
      "id": 95,
      "start": 12273.22,
      "end": 12275.22,
      "formatted_start": "03:24:33.220",
      "formatted_end": "03:24:35.220",
      "text": "باردیت قبضی دیده چهر"
    },
    {
      "id": 96,
      "start": 12275.22,
      "end": 12277.22,
      "formatted_start": "03:24:35.220",
      "formatted_end": "03:24:37.220",
      "text": "باردیت چهر"
    },
    {
      "id": 97,
      "start": 12277.22,
      "end": 12279.22,
      "formatted_start": "03:24:37.220",
      "formatted_end": "03:24:39.220",
      "text": "دستگاه شما دیده"
    },
    {
      "id": 98,
      "start": 12279.22,
      "end": 12281.22,
      "formatted_start": "03:24:39.220",
      "formatted_end": "03:24:41.220",
      "text": "برگرده"
    },
    {
      "id": 99,
      "start": 12281.22,
      "end": 12283.22,
      "formatted_start": "03:24:41.220",
      "formatted_end": "03:24:43.220",
      "text": "که میخواد افراد؟"
    }
  ],
  "status": "completed"
}