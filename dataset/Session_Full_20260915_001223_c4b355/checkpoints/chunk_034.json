  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10202.3,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:02.300",
      "text": "الان بهتر شبا چیز میشه؟"
    },
    {
      "id": 1,
      "start": 10202.3,
      "end": 10205.3,
      "formatted_start": "02:50:02.300",
      "formatted_end": "02:50:05.300",
      "text": "الان بهش، آخرین بار که بهش تقبر دادی که..."
    },
    {
      "id": 2,
      "start": 10205.3,
      "end": 10205.8,
      "formatted_start": "02:50:05.300",
      "formatted_end": "02:50:05.800",
      "text": "نداریم."
    },
    {
      "id": 3,
      "start": 10205.8,
      "end": 10206.8,
      "formatted_start": "02:50:05.800",
      "formatted_end": "02:50:06.800",
      "text": "نداریم."
    },
    {
      "id": 4,
      "start": 10209.6,
      "end": 10212.6,
      "formatted_start": "02:50:09.600",
      "formatted_end": "02:50:12.600",
      "text": "به دارو خونه گفتم، گفت کچیکه باید دارو دکتر."
    },
    {
      "id": 5,
      "start": 10214.8,
      "end": 10218.8,
      "formatted_start": "02:50:14.800",
      "formatted_end": "02:50:18.800",
      "text": "چه عجب، یه دارو خونه چیزی به نداریم."
    },
    {
      "id": 6,
      "start": 10220.6,
      "end": 10222.8,
      "formatted_start": "02:50:20.600",
      "formatted_end": "02:50:22.800",
      "text": "باید دارو دکتر با همینجور داریم."
    },
    {
      "id": 7,
      "start": 10222.8,
      "end": 10223.8,
      "formatted_start": "02:50:22.800",
      "formatted_end": "02:50:23.800",
      "text": "همینجور داریم."
    },
    {
      "id": 8,
      "start": 10223.8,
      "end": 10224.8,
      "formatted_start": "02:50:23.800",
      "formatted_end": "02:50:24.800",
      "text": "باید داریم."
    },
    {
      "id": 9,
      "start": 10227.3,
      "end": 10228.8,
      "formatted_start": "02:50:27.300",
      "formatted_end": "02:50:28.800",
      "text": "شکر میکنیم."
    },
    {
      "id": 10,
      "start": 10228.8,
      "end": 10258.8,
      "formatted_start": "02:50:28.800",
      "formatted_end": "02:50:58.800",
      "text": "برای شیرشان برای بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون بیرون"
