      "start": 10477.4,
      "end": 10482.28,
      "formatted_start": "02:54:37.400",
      "formatted_end": "02:54:42.280",
      "text": "روزی دو بار بهش نیم سیسی بده"
    },
    {
      "id": 89,
      "start": 10482.28,
      "end": 10485.56,
      "formatted_start": "02:54:42.280",
      "formatted_end": "02:54:45.560",
      "text": "خب اون پدیلاکتوینات هم که داری بهش بده"
    },
    {
      "id": 90,
      "start": 10485.56,
      "end": 10487.24,
      "formatted_start": "02:54:45.560",
      "formatted_end": "02:54:47.240",
      "text": "خب اسپره بینیش هم"
    },
    {
      "id": 91,
      "start": 10487.24,
      "end": 10492.7,
      "formatted_start": "02:54:47.240",
      "formatted_end": "02:54:52.700",
      "text": "هر دو ساعت یک پاف بزن داخل بینیش"
    },
    {
      "id": 92,
      "start": 10492.7,
      "end": 10495.22,
      "formatted_start": "02:54:52.700",
      "formatted_end": "02:54:55.220",
      "text": "خب، یه قطره بینی نمیشتم"
    },
    {
      "id": 93,
      "start": 10495.22,
      "end": 10499.4,
      "formatted_start": "02:54:55.220",
      "formatted_end": "02:54:59.400",
      "text": "شبیه یک قطره قبل خواب براش برسید که شب راحت بچنیم"
    }
