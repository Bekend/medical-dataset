      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:02.000",
      "text": "این رودش از اینجا میده اینجا."
    },
    {
      "id": 1,
      "start": 9302.0,
      "end": 9307.0,
      "formatted_start": "02:35:02.000",
      "formatted_end": "02:35:07.000",
      "text": "اگر این بوده، دوره یک زمین که چیز میکنی، بر میگرده."
    },
    {
      "id": 2,
      "start": 9307.0,
      "end": 9312.0,
      "formatted_start": "02:35:07.000",
      "formatted_end": "02:35:12.000",
      "text": "اگر اینجا بره ورم کنه، بر نگرده، رودش سیاه میشه."
    },
    {
      "id": 3,
      "start": 9312.0,
      "end": 9315.0,
      "formatted_start": "02:35:12.000",
      "formatted_end": "02:35:15.000",
      "text": "بعد اون وقت یه عمل بزرگ لازم."
    },
    {
      "id": 4,
      "start": 9315.0,
      "end": 9320.0,
      "formatted_start": "02:35:15.000",
      "formatted_end": "02:35:20.000",
      "text": "یعنی شکر رو باید باز کنن، رودش رو باید ببهن، رودش رو دوباره چیز بکنن،"
    },
    {
      "id": 5,
      "start": 9320.0,
      "end": 9322.0,
      "formatted_start": "02:35:20.000",
      "formatted_end": "02:35:22.000",
      "text": "تا مدت خواه چیزی نمیتونه بر چه خواه."
    },
    {
      "id": 6,
      "start": 9322.0,
      "end": 9325.0,
      "formatted_start": "02:35:22.000",
      "formatted_end": "02:35:25.000",
      "text": "یعنی یه عمل موقعات پردر بسن."
    },
    {
      "id": 7,
      "start": 9325.0,
      "end": 9329.0,
      "formatted_start": "02:35:25.000",
      "formatted_end": "02:35:29.000",
      "text": "برای چون این عده ای جون برای این قدر باز می کنه اینو می دوزه می رونده"
    },
    {
      "id": 8,
      "start": 9329.0,
      "end": 9334.0,
      "formatted_start": "02:35:29.000",
      "formatted_end": "02:35:34.000",
      "text": "یعنی در حد یک خیلی یعنی اگر مثلا من شاید یادم داده کنم باشه"
    },
    {
      "id": 9,
      "start": 9334.0,
      "end": 9337.0,
      "formatted_start": "02:35:34.000",
      "formatted_end": "02:35:37.000",
      "text": "یعنی حتی از این بدون بیهوشی هم رنجاب بشه"
    },
    {
      "id": 10,
      "start": 9337.0,
      "end": 9339.0,
      "formatted_start": "02:35:37.000",
      "formatted_end": "02:35:39.000",
      "text": "و اینجور بچه هست باید بیهوش بشه"
    },
    {
      "id": 11,
      "start": 9339.0,
      "end": 9342.0,
      "formatted_start": "02:35:39.000",
      "formatted_end": "02:35:42.000",
      "text": "باید بیهوشی خیلی ضعیفه کتا"
    },
    {
      "id": 12,
      "start": 9342.0,
      "end": 9345.0,
      "formatted_start": "02:35:42.000",
      "formatted_end": "02:35:45.000",
      "text": "خط باشه هم بیکنه از اون عده ایش می آرده باشه میره بکنه"
    },
    {
      "id": 13,
      "start": 9345.0,
      "end": 9347.0,
      "formatted_start": "02:35:45.000",
      "formatted_end": "02:35:47.000",
      "text": "خب نگران نماشنستن"
    },
    {
      "id": 14,
      "start": 9347.0,
      "end": 9353.38,
      "formatted_start": "02:35:47.000",
      "formatted_end": "02:35:53.380",
      "text": "اصلا چیزو یعنی من خودم سر عمل فتح واقعا یکی دو ماه پیش بودم"
    },
    {
      "id": 15,
      "start": 9353.38,
      "end": 9357.34,
      "formatted_start": "02:35:53.380",
      "formatted_end": "02:35:57.340",
      "text": "اصلا چون نمیدونی در یک چشم به هم زنن هم رو بشه"
    },
    {
      "id": 16,
      "start": 9357.34,
      "end": 9361.3,
      "formatted_start": "02:35:57.340",
      "formatted_end": "02:36:01.300",
      "text": "خب؟ خب شاید بچه ها تا بره بیاد از اتاق اولیه سرچون بگشه"
    },
    {
      "id": 17,
      "start": 9361.3,
      "end": 9363.42,
      "formatted_start": "02:36:01.300",
      "formatted_end": "02:36:03.420",
      "text": "چون قبلش تا برن آمادهش بکنن"
    },
    {
      "id": 18,
      "start": 9363.42,
      "end": 9367.46,
      "formatted_start": "02:36:03.420",
      "formatted_end": "02:36:07.460",
      "text": "بعدش تا خیالش رو رد بشه کاملا به هونش اومده بیرون نمیارنش"
    },
    {
      "id": 19,
      "start": 9367.46,
      "end": 9370.64,
      "formatted_start": "02:36:07.460",
      "formatted_end": "02:36:10.640",
      "text": "ولی در واقع عمل ده دقیقه بیشتر زونه می کشه"
    },
    {
      "id": 20,
      "start": 9370.64,
      "end": 9372.98,
      "formatted_start": "02:36:10.640",
      "formatted_end": "02:36:12.980",
      "text": "خب؟ نگران نباشه اصلا"
    },
    {
      "id": 21,
      "start": 9372.98,
      "end": 9376.18,
      "formatted_start": "02:36:12.980",
      "formatted_end": "02:36:16.180",
      "text": "بلکه شما نکتر زنده برد"
    },
    {
      "id": 22,
      "start": 9376.18,
      "end": 9379.34,
      "formatted_start": "02:36:16.180",
      "formatted_end": "02:36:19.340",
      "text": "خاندوفین چشمش هنوز هم خوب نشده که از صفا"
    },
    {
      "id": 23,
      "start": 9379.34,
      "end": 9382.18,
      "formatted_start": "02:36:19.340",
      "formatted_end": "02:36:22.180",
      "text": "نه داری که ما قطره داده بودم"
    },
    {
      "id": 24,
      "start": 9382.18,
      "end": 9383.46,
      "formatted_start": "02:36:22.180",
      "formatted_end": "02:36:23.460",
      "text": "قطره داده بودیم"
    },
    {
      "id": 25,
      "start": 9383.46,
      "end": 9384.5,
      "formatted_start": "02:36:23.460",
      "formatted_end": "02:36:24.500",
      "text": "چانس دوادی کردی؟"
    },
    {
      "id": 26,
      "start": 9384.5,
      "end": 9386.38,
      "formatted_start": "02:36:24.500",
      "formatted_end": "02:36:26.380",
      "text": "هران 20 فیل یک کم هست"
    },
    {
      "id": 27,
      "start": 9386.38,
      "end": 9388.5,
      "formatted_start": "02:36:26.380",
      "formatted_end": "02:36:28.500",
      "text": "هنوز هم چشم خوب نشده"
    },
    {
      "id": 28,
      "start": 9388.5,
      "end": 9392.1,
      "formatted_start": "02:36:28.500",
      "formatted_end": "02:36:32.100",
      "text": "ببینی تا خوب بشه یه 3-4 ماه تون میکشن"
    },
    {
      "id": 29,
      "start": 9392.1,
      "end": 9393.98,
      "formatted_start": "02:36:32.100",
      "formatted_end": "02:36:33.980",
      "text": "خوب میشه بقیه دوباره هی میزن"
    },
    {
      "id": 30,
      "start": 9393.98,
      "end": 9395.78,
      "formatted_start": "02:36:33.980",
      "formatted_end": "02:36:35.780",
      "text": "این خساره بینی عذیب میکنه"
    },
    {
      "id": 31,
      "start": 9395.78,
      "end": 9396.74,
      "formatted_start": "02:36:35.780",
      "formatted_end": "02:36:36.740",
      "text": "نشانه نداره"
    },
    {
      "id": 32,
      "start": 9396.74,
      "end": 9398.74,
      "formatted_start": "02:36:36.740",
      "formatted_end": "02:36:38.740",
      "text": "از این طبیعی عزیزم بیاد خوب"
    },
    {
      "id": 33,
      "start": 9398.74,
      "end": 9400.74,
      "formatted_start": "02:36:38.740",
      "formatted_end": "02:36:40.740",
      "text": "باسته این چیزها رو نخوردید"
    },
    {
      "id": 34,
      "start": 9400.74,
      "end": 9402.74,
      "formatted_start": "02:36:40.740",
      "formatted_end": "02:36:42.740",
      "text": "یه قطر سیپلکس رو برسم"
    },
    {
      "id": 35,
      "start": 9402.74,
      "end": 9404.74,
      "formatted_start": "02:36:42.740",
      "formatted_end": "02:36:44.740",
      "text": "هر هیچ ساعت یه قطر"
    },
    {
      "id": 36,
      "start": 9404.74,
      "end": 9406.74,
      "formatted_start": "02:36:44.740",
      "formatted_end": "02:36:46.740",
      "text": "به داخلی از چشمش دیگه خوبه"
    },
    {
      "id": 37,
      "start": 9406.74,
      "end": 9408.74,
      "formatted_start": "02:36:46.740",
      "formatted_end": "02:36:48.740",
      "text": "خوب میشه"
    },
    {
      "id": 38,
      "start": 9408.74,
      "end": 9410.74,
      "formatted_start": "02:36:48.740",
      "formatted_end": "02:36:50.740",
      "text": "بعدی مادخواست دو سر از این رو مون میده"
    },
    {
      "id": 39,
      "start": 9410.74,
      "end": 9412.74,
      "formatted_start": "02:36:50.740",
      "formatted_end": "02:36:52.740",
      "text": "به خاطر تزشن"
    },
    {
      "id": 40,
      "start": 9412.74,
      "end": 9414.74,
      "formatted_start": "02:36:52.740",
      "formatted_end": "02:36:54.740",
      "text": "شیرخشک و"
    },
    {
      "id": 41,
      "start": 9414.74,
      "end": 9416.74,
      "formatted_start": "02:36:54.740",
      "formatted_end": "02:36:56.740",
      "text": "ویتامینش"
    },
    {
      "id": 42,
      "start": 9416.74,
      "end": 9418.74,
      "formatted_start": "02:36:56.740",
      "formatted_end": "02:36:58.740",
      "text": "اسمش کیان بود"
    },
    {
      "id": 43,
      "start": 9418.74,
      "end": 9420.74,
      "formatted_start": "02:36:58.740",
      "formatted_end": "02:37:00.740",
      "text": "خب نگهره برم"
    },
    {
      "id": 44,
      "start": 9420.74,
      "end": 9422.74,
      "formatted_start": "02:37:00.740",
      "formatted_end": "02:37:02.740",
      "text": "خواهش"
    },
    {
      "id": 45,
      "start": 9422.74,
      "end": 9424.74,
      "formatted_start": "02:37:02.740",
      "formatted_end": "02:37:04.740",
      "text": "خدا و شاه خواهش رو متوجه شدیم"
    },
    {
      "id": 46,
      "start": 9424.74,
      "end": 9428.42,
      "formatted_start": "02:37:04.740",
      "formatted_end": "02:37:08.420",
      "text": "پس همین فردا ایشالا دام کنیم برای بردنش"
    },
    {
      "id": 47,
      "start": 9428.42,
      "end": 9430.9,
      "formatted_start": "02:37:08.420",
      "formatted_end": "02:37:10.900",
      "text": "فردا که پنج شمبه است اینجا شانه شمبه"
    },
    {
      "id": 48,
      "start": 9430.9,
      "end": 9432.5,
      "formatted_start": "02:37:10.900",
      "formatted_end": "02:37:12.500",
      "text": "شمبه که بردنش"
    },
    {
      "id": 49,
      "start": 9432.5,
      "end": 9438.5,
      "formatted_start": "02:37:12.500",
      "formatted_end": "02:37:18.500",
      "text": "برای باید یک کار اضافه است که ببری اون رو بری کنی جایی برای کار تمرد بزن نمازش پنه دیگه"
    },
    {
      "id": 50,
      "start": 9438.5,
      "end": 9439.5,
      "formatted_start": "02:37:18.500",
      "formatted_end": "02:37:19.500",
      "text": "آه آه"
    },
    {
      "id": 51,
      "start": 9439.5,
      "end": 9441.5,
      "formatted_start": "02:37:19.500",
      "formatted_end": "02:37:21.500",
      "text": "پس بری بیایی بری بیایی که نمیشه"
    },
    {
      "id": 52,
      "start": 9441.5,
      "end": 9442.5,
      "formatted_start": "02:37:21.500",
      "formatted_end": "02:37:22.500",
      "text": "پس همون شمبه بره"
    },
    {
      "id": 53,
      "start": 9442.5,
      "end": 9443.5,
      "formatted_start": "02:37:22.500",
      "formatted_end": "02:37:23.500",
      "text": "شمبه بره"
    },
    {
      "id": 54,
      "start": 9443.5,
      "end": 9444.5,
      "formatted_start": "02:37:23.500",
      "formatted_end": "02:37:24.500",
      "text": "دست کشیده"
    },
    {
      "id": 55,
      "start": 9444.5,
      "end": 9445.5,
      "formatted_start": "02:37:24.500",
      "formatted_end": "02:37:25.500",
      "text": "من من من من"
    },
    {
      "id": 56,
      "start": 9445.5,
      "end": 9447.5,
      "formatted_start": "02:37:25.500",
      "formatted_end": "02:37:27.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 57,
      "start": 9447.5,
      "end": 9449.5,
      "formatted_start": "02:37:27.500",
      "formatted_end": "02:37:29.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 58,
      "start": 9449.5,
      "end": 9451.5,
      "formatted_start": "02:37:29.500",
      "formatted_end": "02:37:31.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 59,
      "start": 9451.5,
      "end": 9453.5,
      "formatted_start": "02:37:31.500",
      "formatted_end": "02:37:33.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 60,
      "start": 9453.5,
      "end": 9455.5,
      "formatted_start": "02:37:33.500",
      "formatted_end": "02:37:35.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 61,
      "start": 9455.5,
      "end": 9457.5,
      "formatted_start": "02:37:35.500",
      "formatted_end": "02:37:37.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 62,
      "start": 9457.5,
      "end": 9459.5,
      "formatted_start": "02:37:37.500",
      "formatted_end": "02:37:39.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 63,
      "start": 9459.5,
      "end": 9461.5,
      "formatted_start": "02:37:39.500",
      "formatted_end": "02:37:41.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 64,
      "start": 9461.5,
      "end": 9463.5,
      "formatted_start": "02:37:41.500",
      "formatted_end": "02:37:43.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 65,
      "start": 9463.5,
      "end": 9465.5,
      "formatted_start": "02:37:43.500",
      "formatted_end": "02:37:45.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 66,
      "start": 9465.5,
      "end": 9467.5,
      "formatted_start": "02:37:45.500",
      "formatted_end": "02:37:47.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 67,
      "start": 9467.5,
      "end": 9469.5,
      "formatted_start": "02:37:47.500",
      "formatted_end": "02:37:49.500",
      "text": "باید برسو تلقه کنید"
    },
    {
      "id": 68,
      "start": 9469.5,
      "end": 9499.5,
      "formatted_start": "02:37:49.500",
      "formatted_end": "02:38:19.500",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینج"
    },
    {
      "id": 69,
      "start": 9499.5,
      "end": 9501.5,
      "formatted_start": "02:38:19.500",
      "formatted_end": "02:38:21.500",
      "text": "من باهم با چه انویلیه کنم"
    },
    {
      "id": 70,
      "start": 9501.5,
      "end": 9503.5,
      "formatted_start": "02:38:21.500",
      "formatted_end": "02:38:23.500",
      "text": "خودت کچی"
    },
    {
      "id": 71,
      "start": 9503.5,
      "end": 9505.5,
      "formatted_start": "02:38:23.500",
      "formatted_end": "02:38:25.500",
      "text": "خودم از موقع پجابتی کنم"
    },
    {
      "id": 72,
      "start": 9505.5,
      "end": 9507.5,
      "formatted_start": "02:38:25.500",
      "formatted_end": "02:38:27.500",
      "text": "بعد افراد"
    },
    {
      "id": 73,
      "start": 9507.5,
      "end": 9509.5,
      "formatted_start": "02:38:27.500",
      "formatted_end": "02:38:29.500",
      "text": "خواست داری؟"
    },
    {
      "id": 74,
      "start": 9509.5,
      "end": 9511.5,
      "formatted_start": "02:38:29.500",
      "formatted_end": "02:38:31.500",
      "text": "نه نه نه بعدش هم پرکیز یاد دارم"
    },
    {
      "id": 75,
      "start": 9511.5,
      "end": 9513.5,
      "formatted_start": "02:38:31.500",
      "formatted_end": "02:38:33.500",
      "text": "از اینجا برداریم"
    },
    {
      "id": 76,
      "start": 9513.5,
      "end": 9515.5,
      "formatted_start": "02:38:33.500",
      "formatted_end": "02:38:35.500",
      "text": "بفرمایی"
    },
    {
      "id": 77,
      "start": 9515.5,
      "end": 9517.5,
      "formatted_start": "02:38:35.500",
      "formatted_end": "02:38:37.500",
      "text": "سلام خداشان ما خوب هستیم؟"
    },
    {
      "id": 78,
      "start": 9517.5,
      "end": 9519.5,
      "formatted_start": "02:38:37.500",
      "formatted_end": "02:38:39.500",
      "text": "بفرمایی سلام"
    },
    {
      "id": 79,
      "start": 9519.5,
      "end": 9521.5,
      "formatted_start": "02:38:39.500",
      "formatted_end": "02:38:41.500",
      "text": "بردار"
    },
    {
      "id": 80,
      "start": 9521.5,
      "end": 9523.5,
      "formatted_start": "02:38:41.500",
      "formatted_end": "02:38:43.500",
      "text": "بردار"
    },
    {
      "id": 81,
      "start": 9523.5,
      "end": 9525.5,
      "formatted_start": "02:38:43.500",
      "formatted_end": "02:38:45.500",
      "text": "سلام"
    },
    {
      "id": 82,
      "start": 9525.5,
      "end": 9527.5,
      "formatted_start": "02:38:45.500",
      "formatted_end": "02:38:47.500",
      "text": "خانم عطا"
    },
    {
      "id": 83,
      "start": 9527.5,
      "end": 9530.5,
      "formatted_start": "02:38:47.500",
      "formatted_end": "02:38:50.500",
      "text": "بفرمایید. آه اینه؟ آرمی."
    },
    {
      "id": 84,
      "start": 9530.5,
      "end": 9533.5,
      "formatted_start": "02:38:50.500",
      "formatted_end": "02:38:53.500",
      "text": "خب آرمی سه سالشه درسته؟"
    },
    {
      "id": 85,
      "start": 9533.5,
      "end": 9536.5,
      "formatted_start": "02:38:53.500",
      "formatted_end": "02:38:56.500",
      "text": "آرمی اینجا چیز گذاره؟"
    },
    {
      "id": 86,
      "start": 9536.5,
      "end": 9539.5,
      "formatted_start": "02:38:56.500",
      "formatted_end": "02:38:59.500",
      "text": "آرمی میدونم میدونم."
    },
    {
      "id": 87,
      "start": 9539.5,
      "end": 9542.5,
      "formatted_start": "02:38:59.500",
      "formatted_end": "02:39:02.500",
      "text": "حرف نمیزنه؟ آرمی؟"
    },
    {
      "id": 88,
      "start": 9542.5,
      "end": 9546.5,
      "formatted_start": "02:39:02.500",
      "formatted_end": "02:39:06.500",
      "text": "به دنیا آمد نارست نبود؟"
    },
    {
      "id": 89,
      "start": 9546.5,
      "end": 9553.5,
      "formatted_start": "02:39:06.500",
      "formatted_end": "02:39:13.500",
      "text": "نه. وقتی یکی دو سالش بود، یکمی سالش بود حرف نمیزنه."
    },
    {
      "id": 90,
      "start": 9553.5,
      "end": 9554.5,
      "formatted_start": "02:39:13.500",
      "formatted_end": "02:39:14.500",
      "text": "آهان خب؟"
    },
    {
      "id": 91,
      "start": 9554.5,
      "end": 9556.5,
      "formatted_start": "02:39:14.500",
      "formatted_end": "02:39:16.500",
      "text": "برای الان حرف میمیزنم"
    },
    {
      "id": 92,
      "start": 9556.5,
      "end": 9558.5,
      "formatted_start": "02:39:16.500",
      "formatted_end": "02:39:18.500",
      "text": "ای بابا اینو بگیر"
    },
    {
      "id": 93,
      "start": 9560.5,
      "end": 9562.5,
      "formatted_start": "02:39:20.500",
      "formatted_end": "02:39:22.500",
      "text": "پرمه میگه"
    },
    {
      "id": 94,
      "start": 9562.5,
      "end": 9564.5,
      "formatted_start": "02:39:22.500",
      "formatted_end": "02:39:24.500",
      "text": "مثلا بابا ماما رو صدا میزنه یا نه"
    },
    {
      "id": 95,
      "start": 9564.5,
      "end": 9566.5,
      "formatted_start": "02:39:24.500",
      "formatted_end": "02:39:26.500",
      "text": "این دورو صدا نمیزنه"
    },
    {
      "id": 96,
      "start": 9566.5,
      "end": 9568.5,
      "formatted_start": "02:39:26.500",
      "formatted_end": "02:39:28.500",
      "text": "بعضی موقع صدا میزنه"
    },
    {
      "id": 97,
      "start": 9568.5,
      "end": 9570.5,
      "formatted_start": "02:39:28.500",
      "formatted_end": "02:39:30.500",
      "text": "برای"
    },
    {
      "id": 98,
      "start": 9570.5,
      "end": 9572.5,
      "formatted_start": "02:39:30.500",
      "formatted_end": "02:39:32.500",
      "text": "با بچه های دیگه بازی میکنه"
    },
    {
      "id": 99,
      "start": 9572.5,
      "end": 9574.5,
      "formatted_start": "02:39:32.500",
      "formatted_end": "02:39:34.500",
      "text": "دیگه هم بازی میکنه"
    },
    {
      "id": 100,
      "start": 9574.5,
      "end": 9576.5,
      "formatted_start": "02:39:34.500",
      "formatted_end": "02:39:36.500",
      "text": "تلویزیون گوشه زیاد نگاه میکنه"
    },
    {
      "id": 101,
      "start": 9576.5,
      "end": 9578.5,
      "formatted_start": "02:39:36.500",
      "formatted_end": "02:39:38.500",
      "text": "آره تلویزیون گوشه زیاد نگاه میکنه"
    },
    {
      "id": 102,
      "start": 9578.5,
      "end": 9580.5,
      "formatted_start": "02:39:38.500",
      "formatted_end": "02:39:40.500",
      "text": "جانم"
    },
    {
      "id": 103,
      "start": 9580.5,
      "end": 9582.5,
      "formatted_start": "02:39:40.500",
      "formatted_end": "02:39:42.500",
      "text": "چیه من با شما نیستم که"
    },
    {
      "id": 104,
      "start": 9582.5,
      "end": 9585.5,
      "formatted_start": "02:39:42.500",
      "formatted_end": "02:39:45.500",
      "text": "آره دختر خوشگیر"
    },
    {
      "id": 105,
      "start": 9585.5,
      "end": 9587.5,
      "formatted_start": "02:39:45.500",
      "formatted_end": "02:39:47.500",
      "text": "این چند وقت شد؟"
    },
    {
      "id": 106,
      "start": 9587.5,
      "end": 9588.5,
      "formatted_start": "02:39:47.500",
      "formatted_end": "02:39:48.500",
      "text": "اون یک سال شد"
    },
    {
      "id": 107,
      "start": 9588.5,
      "end": 9589.5,
      "formatted_start": "02:39:48.500",
      "formatted_end": "02:39:49.500",
      "text": "یک سال شد"
    },
    {
      "id": 108,
      "start": 9589.5,
      "end": 9592.5,
      "formatted_start": "02:39:49.500",
      "formatted_end": "02:39:52.500",
      "text": "خب تا بین نشستنش را رفتن ایست تر وقت بود"
    },
    {
      "id": 109,
      "start": 9592.5,
      "end": 9594.5,
      "formatted_start": "02:39:52.500",
      "formatted_end": "02:39:54.500",
      "text": "یعنی اونا دیرتر بود"
    },
    {
      "id": 110,
      "start": 9594.5,
      "end": 9596.5,
      "formatted_start": "02:39:54.500",
      "formatted_end": "02:39:56.500",
      "text": "او؟"
    },
    {
      "id": 111,
      "start": 9597.5,
      "end": 9599.5,
      "formatted_start": "02:39:57.500",
      "formatted_end": "02:39:59.500",
      "text": "یک... از این گذار..."
    }
  ],
  "status": "completed"
}