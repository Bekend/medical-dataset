  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9930.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:30.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 1,
      "start": 9930.0,
      "end": 9933.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:33.000",
      "text": "اگر بسیاری هستید، حضینه رو به شما بگیریم."
    },
    {
      "id": 2,
      "start": 9933.0,
      "end": 9934.0,
      "formatted_start": "02:45:33.000",
      "formatted_end": "02:45:34.000",
      "text": "خوب؟"
    },
    {
      "id": 3,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "باید بریم بسیاری؟"
    },
    {
      "id": 4,
      "start": 9936.0,
      "end": 9939.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:39.000",
      "text": "یه پرونده باید درش تشکیل بینیم"
    },
    {
      "id": 5,
      "start": 9939.0,
      "end": 9941.0,
      "formatted_start": "02:45:39.000",
      "formatted_end": "02:45:41.000",
      "text": "و جوابت بهتون تخفیص میده."
    },
    {
      "id": 6,
      "start": 9941.0,
      "end": 9942.0,
      "formatted_start": "02:45:41.000",
      "formatted_end": "02:45:42.000",
      "text": "آره؟"
    },
    {
      "id": 7,
      "start": 9942.0,
      "end": 9943.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:43.000",
      "text": "آره."
    },
    {
      "id": 8,
      "start": 9943.0,
      "end": 9946.0,
      "formatted_start": "02:45:43.000",
      "formatted_end": "02:45:46.000",
      "text": "اگر دلتون خواست، باید تخفیص بگیریم."
    },
    {
      "id": 9,
      "start": 9946.0,
      "end": 9949.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:49.000",
      "text": "اگر دلتون نخواست تخفیص بگیرید، که نمیخواست."
    },
    {
      "id": 10,
      "start": 9953.0,
      "end": 9954.0,
