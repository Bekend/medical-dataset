      "start": 16430.76,
      "end": 16432.76,
      "formatted_start": "04:33:50.760",
      "formatted_end": "04:33:52.760",
      "text": "آره"
    },
    {
      "id": 95,
      "start": 16432.76,
      "end": 16434.76,
      "formatted_start": "04:33:52.760",
      "formatted_end": "04:33:54.760",
      "text": "آره"
    },
    {
      "id": 96,
      "start": 16434.76,
      "end": 16439.68,
      "formatted_start": "04:33:54.760",
      "formatted_end": "04:33:59.680",
      "text": "خیلی برای این کشت چپش"
    },
    {
      "id": 97,
      "start": 16439.68,
      "end": 16441.78,
      "formatted_start": "04:33:59.680",
      "formatted_end": "04:34:01.780",
      "text": "بسیار تر نکرده؟"
    },
    {
      "id": 98,
      "start": 16441.78,
      "end": 16442.82,
      "formatted_start": "04:34:01.780",
      "formatted_end": "04:34:02.820",
      "text": "نه"
    },
    {
      "id": 99,
      "start": 16442.82,
      "end": 16445.72,
      "formatted_start": "04:34:02.820",
      "formatted_end": "04:34:05.720",
      "text": "پاسه نشد تازه زنم تاید یه روز دونه برم"
    },
    {
      "id": 100,
      "start": 16445.72,
      "end": 16451.62,
      "formatted_start": "04:34:05.720",
      "formatted_end": "04:34:11.620",
      "text": "ای قرار شده؟"
    },
    {
      "id": 101,
      "start": 16451.62,
      "end": 16452.82,
      "formatted_start": "04:34:11.620",
      "formatted_end": "04:34:12.820",
      "text": "میردی کشش آره"
    },
    {
      "id": 102,
      "start": 16452.82,
      "end": 16456.16,
      "formatted_start": "04:34:12.820",
      "formatted_end": "04:34:16.160",
      "text": "ایجان"
    },
    {
      "id": 103,
      "start": 16456.16,
      "end": 16457.36,
      "formatted_start": "04:34:16.160",
      "formatted_end": "04:34:17.360",
      "text": "ایجان"
    },
    {
      "id": 104,
      "start": 16457.36,
      "end": 16460.5,
      "formatted_start": "04:34:17.360",
      "formatted_end": "04:34:20.500",
      "text": "کشش سالمه"
    },
    {
      "id": 105,
      "start": 16460.5,
      "end": 16461.66,
      "formatted_start": "04:34:20.500",
      "formatted_end": "04:34:21.660",
      "text": "خب"
    },
    {
      "id": 106,
      "start": 16461.66,
      "end": 16464.44,
      "formatted_start": "04:34:21.660",
      "formatted_end": "04:34:24.440",
      "text": "فقط مشکلی که داره جم نره"
    },
    {
      "id": 107,
      "start": 16464.44,
      "end": 16468.44,
      "formatted_start": "04:34:24.440",
      "formatted_end": "04:34:28.440",
      "text": "این جرماتکو میخوره تو بوشش خارش ایجاز میکنه"
    },
    {
      "id": 108,
      "start": 16468.44,
      "end": 16471.44,
      "formatted_start": "04:34:28.440",
      "formatted_end": "04:34:31.440",
      "text": "وقتی تو ماساش میدی انگار داری میخارونش آرومش"
    },
    {
      "id": 109,
      "start": 16471.44,
      "end": 16473.44,
      "formatted_start": "04:34:31.440",
      "formatted_end": "04:34:33.440",
      "text": "خب؟ بلی اصفنت نداره"
    },
    {
      "id": 110,
      "start": 16480.44,
      "end": 16482.44,
      "formatted_start": "04:34:40.440",
      "formatted_end": "04:34:42.440",
      "text": "خب، شیرشو پسر میده؟"
    },
    {
      "id": 111,
      "start": 16486.44,
      "end": 16488.44,
      "formatted_start": "04:34:46.440",
      "formatted_end": "04:34:48.440",
      "text": "شیر مادر بود"
    },
    {
      "id": 112,
      "start": 16494.44,
      "end": 16496.44,
      "formatted_start": "04:34:54.440",
      "formatted_end": "04:34:56.440",
      "text": "خوب، چند که این رو به دنیا اون رو مارد؟"
    },
    {
      "id": 113,
      "start": 16496.44,
      "end": 16497.44,
      "formatted_start": "04:34:56.440",
      "formatted_end": "04:34:57.440",
      "text": "نه"
    },
    {
      "id": 114,
      "start": 16497.44,
      "end": 16499.44,
      "formatted_start": "04:34:57.440",
      "formatted_end": "04:34:59.440",
      "text": "سه رو بشه داریم"
    }
  ],
