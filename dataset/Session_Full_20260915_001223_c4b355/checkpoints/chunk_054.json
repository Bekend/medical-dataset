  "stt_segments": [
    {
      "id": 0,
      "start": 16200.0,
      "end": 16204.0,
      "formatted_start": "04:30:00.000",
      "formatted_end": "04:30:04.000",
      "text": "این هم، اون ماسترلا رو داشته باش، بذار دو ماهیگی باید استفاده کن."
    },
    {
      "id": 1,
      "start": 16204.0,
      "end": 16207.0,
      "formatted_start": "04:30:04.000",
      "formatted_end": "04:30:07.000",
      "text": "الان این هایی از این شامپور استفاده کن."
    },
    {
      "id": 2,
      "start": 16208.0,
      "end": 16212.0,
      "formatted_start": "04:30:08.000",
      "formatted_end": "04:30:12.000",
      "text": "باید برای آرامش آرام شده هم، بعضی موردی که خیلی غیر قراره چیکار کنی؟"
    },
    {
      "id": 3,
      "start": 16212.0,
      "end": 16213.0,
      "formatted_start": "04:30:12.000",
      "formatted_end": "04:30:13.000",
      "text": "همین دیگه."
    },
    {
      "id": 4,
      "start": 16214.0,
      "end": 16216.0,
      "formatted_start": "04:30:14.000",
      "formatted_end": "04:30:16.000",
      "text": "کامیکال کارم یعنی آرامش."
    },
    {
      "id": 5,
      "start": 16216.0,
      "end": 16217.0,
      "formatted_start": "04:30:16.000",
      "formatted_end": "04:30:17.000",
      "text": "هر بار دو سی سی؟"
    },
    {
      "id": 6,
      "start": 16217.0,
      "end": 16218.0,
      "formatted_start": "04:30:17.000",
      "formatted_end": "04:30:18.000",
      "text": "دو و نیم تا نیم."
    },
    {
      "id": 7,
      "start": 16218.0,
      "end": 16219.0,
      "formatted_start": "04:30:18.000",
      "formatted_end": "04:30:19.000",
      "text": "دو و نیم، دو و نیم."
    },
    {
      "id": 8,
      "start": 16219.0,
      "end": 16223.0,
      "formatted_start": "04:30:19.000",
      "formatted_end": "04:30:23.000",
      "text": "برای زندگی صورتش نیاز نیست دوباره آزمایشیم"
    },
    {
      "id": 9,
      "start": 16223.0,
      "end": 16227.0,
      "formatted_start": "04:30:23.000",
      "formatted_end": "04:30:27.000",
      "text": "چون آخرین بار یازده بود ولی داشتونی من پایین"
    },
    {
      "id": 10,
      "start": 16227.0,
      "end": 16229.0,
      "formatted_start": "04:30:27.000",
      "formatted_end": "04:30:29.000",
      "text": "این عدال در حد 6 و 7"
    },
    {
      "id": 11,
      "start": 16229.0,
      "end": 16234.0,
      "formatted_start": "04:30:29.000",
      "formatted_end": "04:30:34.000",
      "text": "بعد خانم دکتر محمود برگاه تحکید دارن که برش دب و خوراکی بدیم"
    },
    {
      "id": 12,
      "start": 16234.0,
      "end": 16238.0,
      "formatted_start": "04:30:34.000",
      "formatted_end": "04:30:38.000",
      "text": "از این خوراکو هایی که در درد میدن"
    },
    {
      "id": 13,
      "start": 16238.0,
      "end": 16241.0,
      "formatted_start": "04:30:38.000",
      "formatted_end": "04:30:41.000",
      "text": "ما خیلی مقابلت کردیم"
    },
    {
      "id": 14,
      "start": 16241.0,
      "end": 16243.0,
      "formatted_start": "04:30:41.000",
      "formatted_end": "04:30:43.000",
      "text": "در جایی که میتونی مقابلت باشیم"
    },
    {
      "id": 15,
      "start": 16243.0,
      "end": 16247.12,
      "formatted_start": "04:30:43.000",
      "formatted_end": "04:30:47.120",
      "text": "نه نه این یه نداره برای که دلشون خوش باشه یه باشاخ با داشتن دو درنش افتاده"
    },
    {
      "id": 16,
      "start": 16247.12,
      "end": 16248.18,
      "formatted_start": "04:30:47.120",
      "formatted_end": "04:30:48.180",
      "text": "ولی سرکوزی ها داره"
    },
    {
      "id": 17,
      "start": 16248.18,
      "end": 16250.88,
      "formatted_start": "04:30:48.180",
      "formatted_end": "04:30:50.880",
      "text": "ما خودمون اوکییم ولی"
    },
    {
      "id": 18,
      "start": 16250.88,
      "end": 16253.64,
      "formatted_start": "04:30:50.880",
      "formatted_end": "04:30:53.640",
      "text": "دیگه چی؟ بیقراری ها؟"
    },
    {
      "id": 19,
      "start": 16253.64,
      "end": 16255.06,
      "formatted_start": "04:30:53.640",
      "formatted_end": "04:30:55.060",
      "text": "بچه منم میدادن"
    },
    {
      "id": 20,
      "start": 16255.06,
      "end": 16259.98,
      "formatted_start": "04:30:55.060",
      "formatted_end": "04:30:59.980",
      "text": "سر منه که دور میدیدم میدادم که استفراخی کرده"
    },
    {
      "id": 21,
      "start": 16259.98,
      "end": 16263.36,
      "formatted_start": "04:30:59.980",
      "formatted_end": "04:31:03.360",
      "text": "چیزایی از درش داریم میتونیم میگم این چیه؟"
    },
    {
      "id": 22,
      "start": 16263.36,
      "end": 16265.66,
      "formatted_start": "04:31:03.360",
      "formatted_end": "04:31:05.660",
      "text": "میگم تو نبودی بهش به دانتینو بگیرم"
    },
    {
      "id": 23,
      "start": 16265.66,
      "end": 16268.48,
      "formatted_start": "04:31:05.660",
      "formatted_end": "04:31:08.480",
      "text": "ولی اتفاق بیقراری شیر نمیگیره؟"
    },
    {
      "id": 24,
      "start": 16268.48,
      "end": 16273.16,
      "formatted_start": "04:31:08.480",
      "formatted_end": "04:31:13.160",
      "text": "به خاطر اینه که نفتانشه کمش دلش درد میکنه"
    },
    {
      "id": 25,
      "start": 16273.16,
      "end": 16276.72,
      "formatted_start": "04:31:13.160",
      "formatted_end": "04:31:16.720",
      "text": "ببین از در طرف این شیطان باید بالا"
    },
    {
      "id": 26,
      "start": 16276.72,
      "end": 16280.88,
      "formatted_start": "04:31:16.720",
      "formatted_end": "04:31:20.880",
      "text": "خب از این برد میخواد بخوره نمیتونه دیگرش"
    },
    {
      "id": 27,
      "start": 16280.88,
      "end": 16285.04,
      "formatted_start": "04:31:20.880",
      "formatted_end": "04:31:25.040",
      "text": "آره چون میاد دهنش هم تپرامیده و بعدی چیز میزنه به این تونه بخوره"
    },
    {
      "id": 28,
      "start": 16285.04,
      "end": 16287.04,
      "formatted_start": "04:31:25.040",
      "formatted_end": "04:31:27.040",
      "text": "آره بخواد اینکه دلش درد میکنه"
    },
    {
      "id": 29,
      "start": 16287.04,
      "end": 16289.04,
      "formatted_start": "04:31:27.040",
      "formatted_end": "04:31:29.040",
      "text": "خب این چیزی که آزمون هست از درد بخوره"
    },
    {
      "id": 30,
      "start": 16289.04,
      "end": 16291.76,
      "formatted_start": "04:31:29.040",
      "formatted_end": "04:31:31.760",
      "text": "آره محسوس بقیه رفت از آن بگیرش که من خدا شما"
    },
    {
      "id": 31,
      "start": 16291.76,
      "end": 16293.76,
      "formatted_start": "04:31:31.760",
      "formatted_end": "04:31:33.760",
      "text": "عزیزه دلاله"
    },
    {
      "id": 32,
      "start": 16298.48,
      "end": 16300.48,
      "formatted_start": "04:31:38.480",
      "formatted_end": "04:31:40.480",
      "text": "برای اینجا، با اینکه اینجا باید برداریم."
    },
    {
      "id": 33,
      "start": 16300.48,
      "end": 16302.48,
      "formatted_start": "04:31:40.480",
      "formatted_end": "04:31:42.480",
      "text": "برای اینجا، با اینجا باید برداریم."
    },
    {
      "id": 34,
      "start": 16302.48,
      "end": 16304.48,
      "formatted_start": "04:31:42.480",
      "formatted_end": "04:31:44.480",
      "text": "برای اینجا باید برداریم."
    },
    {
      "id": 35,
      "start": 16304.48,
      "end": 16306.48,
      "formatted_start": "04:31:44.480",
      "formatted_end": "04:31:46.480",
      "text": "برای اینجا باید برداریم."
    },
    {
      "id": 36,
      "start": 16306.48,
      "end": 16308.48,
      "formatted_start": "04:31:46.480",
      "formatted_end": "04:31:48.480",
      "text": "برای اینجا باید برداریم."
    },
    {
      "id": 37,
      "start": 16308.48,
      "end": 16311.2,
      "formatted_start": "04:31:48.480",
      "formatted_end": "04:31:51.200",
      "text": "فقط هفته دیگه چه خواب یا نکش بود دیگه نیاز نیست؟"
    },
    {
      "id": 38,
      "start": 16311.2,
      "end": 16312.88,
      "formatted_start": "04:31:51.200",
      "formatted_end": "04:31:52.880",
      "text": "دیگه نه، دیگه هفته دیگه نیاز نیست"
    },
    {
      "id": 39,
      "start": 16312.88,
      "end": 16314.56,
      "formatted_start": "04:31:52.880",
      "formatted_end": "04:31:54.560",
      "text": "دیگه چه روز به شادی بیارش"
    },
    {
      "id": 40,
      "start": 16314.56,
      "end": 16315.76,
      "formatted_start": "04:31:54.560",
      "formatted_end": "04:31:55.760",
      "text": "هشت"
    },
    {
      "id": 41,
      "start": 16315.76,
      "end": 16318.72,
      "formatted_start": "04:31:55.760",
      "formatted_end": "04:31:58.720",
      "text": "خوشی من دیگه کاربونه شامل برم برم"
    },
    {
      "id": 42,
      "start": 16318.72,
      "end": 16319.52,
      "formatted_start": "04:31:58.720",
      "formatted_end": "04:31:59.520",
      "text": "خوشی من دیگه کاربونه شامل برم برم برم"
    },
    {
      "id": 43,
      "start": 16319.52,
      "end": 16322.72,
      "formatted_start": "04:31:59.520",
      "formatted_end": "04:32:02.720",
      "text": "خوشی خیلی بیقرار میکنه، شیرم نمیدیده"
    },
    {
      "id": 44,
      "start": 16322.72,
      "end": 16325.2,
      "formatted_start": "04:32:02.720",
      "formatted_end": "04:32:05.200",
      "text": "بهترین چیزی دیگه کنارش یه صدا باشن"
    },
    {
      "id": 45,
      "start": 16325.2,
      "end": 16326.16,
      "formatted_start": "04:32:05.200",
      "formatted_end": "04:32:06.160",
      "text": "مثل سشوار"
    },
    {
      "id": 46,
      "start": 16326.16,
      "end": 16327.84,
      "formatted_start": "04:32:06.160",
      "formatted_end": "04:32:07.840",
      "text": "آره، روشن کردم"
    },
    {
      "id": 47,
      "start": 16327.84,
      "end": 16330.08,
      "formatted_start": "04:32:07.840",
      "formatted_end": "04:32:10.080",
      "text": "سشوار، جار ورده، خب"
    },
    {
      "id": 48,
      "start": 16330.08,
      "end": 16334.0,
      "formatted_start": "04:32:10.080",
      "formatted_end": "04:32:14.000",
      "text": "اینه خواهیست میشه که یه ذره بچه احساسی کنه"
    },
    {
      "id": 49,
      "start": 16334.0,
      "end": 16338.6,
      "formatted_start": "04:32:14.000",
      "formatted_end": "04:32:18.600",
      "text": "سر توی شکم مادر بوده اون صدایی که مثلا به اروق مادر بوده مثل سشوار بوده"
    },
    {
      "id": 50,
      "start": 16338.6,
      "end": 16340.4,
      "formatted_start": "04:32:18.600",
      "formatted_end": "04:32:20.400",
      "text": "بلکه آرامش میدامونه"
    },
    {
      "id": 51,
      "start": 16340.4,
      "end": 16341.4,
      "formatted_start": "04:32:20.400",
      "formatted_end": "04:32:21.400",
      "text": "این کارم میتونی بود"
    },
    {
      "id": 52,
      "start": 16341.4,
      "end": 16342.08,
      "formatted_start": "04:32:21.400",
      "formatted_end": "04:32:22.080",
      "text": "مرد میشه"
    },
    {
      "id": 53,
      "start": 16342.08,
      "end": 16343.08,
      "formatted_start": "04:32:22.080",
      "formatted_end": "04:32:23.080",
      "text": "مرد مرد مرد"
    },
    {
      "id": 54,
      "start": 16343.08,
      "end": 16345.2,
      "formatted_start": "04:32:23.080",
      "formatted_end": "04:32:25.200",
      "text": "یه شیر خودتونم بشه بدم"
    },
    {
      "id": 55,
      "start": 16345.2,
      "end": 16346.08,
      "formatted_start": "04:32:25.200",
      "formatted_end": "04:32:26.080",
      "text": "میخوره؟"
    },
    {
      "id": 56,
      "start": 16346.08,
      "end": 16347.24,
      "formatted_start": "04:32:26.080",
      "formatted_end": "04:32:27.240",
      "text": "با شیر خودمون"
    },
    {
      "id": 57,
      "start": 16347.24,
      "end": 16348.6,
      "formatted_start": "04:32:27.240",
      "formatted_end": "04:32:28.600",
      "text": "از خدا شرکت"
    },
    {
      "id": 58,
      "start": 16348.6,
      "end": 16349.88,
      "formatted_start": "04:32:28.600",
      "formatted_end": "04:32:29.880",
      "text": "دیگه من گیرم شیشه بگیرم"
    },
    {
      "id": 59,
      "start": 16349.88,
      "end": 16350.76,
      "formatted_start": "04:32:29.880",
      "formatted_end": "04:32:30.760",
      "text": "چون راه همین"
    },
    {
      "id": 60,
      "start": 16350.76,
      "end": 16352.76,
      "formatted_start": "04:32:30.760",
      "formatted_end": "04:32:32.760",
      "text": "نه نه نه"
    },
    {
      "id": 61,
      "start": 16352.76,
      "end": 16354.76,
      "formatted_start": "04:32:32.760",
      "formatted_end": "04:32:34.760",
      "text": "از لباس"
    },
    {
      "id": 62,
      "start": 16354.76,
      "end": 16356.76,
      "formatted_start": "04:32:34.760",
      "formatted_end": "04:32:36.760",
      "text": "به هش رو نده"
    },
    {
      "id": 63,
      "start": 16356.76,
      "end": 16358.76,
      "formatted_start": "04:32:36.760",
      "formatted_end": "04:32:38.760",
      "text": "آه"
    },
    {
      "id": 64,
      "start": 16358.76,
      "end": 16360.76,
      "formatted_start": "04:32:38.760",
      "formatted_end": "04:32:40.760",
      "text": "این هم درسته"
    },
    {
      "id": 65,
      "start": 16360.76,
      "end": 16362.76,
      "formatted_start": "04:32:40.760",
      "formatted_end": "04:32:42.760",
      "text": "این هم درسته"
    },
    {
      "id": 66,
      "start": 16362.76,
      "end": 16364.76,
      "formatted_start": "04:32:42.760",
      "formatted_end": "04:32:44.760",
      "text": "بذاره شما"
    },
    {
      "id": 67,
      "start": 16364.76,
      "end": 16366.76,
      "formatted_start": "04:32:44.760",
      "formatted_end": "04:32:46.760",
      "text": "خب تنبختشه"
    },
    {
      "id": 68,
      "start": 16366.76,
      "end": 16368.76,
      "formatted_start": "04:32:46.760",
      "formatted_end": "04:32:48.760",
      "text": "دو برنامه"
    },
    {
      "id": 69,
      "start": 16368.76,
      "end": 16370.76,
      "formatted_start": "04:32:48.760",
      "formatted_end": "04:32:50.760",
      "text": "دو برنامه"
    },
    {
      "id": 70,
      "start": 16370.76,
      "end": 16372.76,
      "formatted_start": "04:32:50.760",
      "formatted_end": "04:32:52.760",
      "text": "خب چی شده"
    },
    {
      "id": 71,
      "start": 16372.76,
      "end": 16374.76,
      "formatted_start": "04:32:52.760",
      "formatted_end": "04:32:54.760",
      "text": "خب چی شده"
    },
    {
      "id": 72,
      "start": 16374.76,
      "end": 16376.76,
      "formatted_start": "04:32:54.760",
      "formatted_end": "04:32:56.760",
      "text": "دست شما درسته"
    },
    {
      "id": 73,
      "start": 16376.76,
      "end": 16378.76,
      "formatted_start": "04:32:56.760",
      "formatted_end": "04:32:58.760",
      "text": "خب دست شما درسته"
    },
    {
      "id": 74,
      "start": 16378.76,
      "end": 16380.76,
      "formatted_start": "04:32:58.760",
      "formatted_end": "04:33:00.760",
