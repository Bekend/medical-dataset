  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4802.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 4802.0,
      "end": 4804.0,
      "formatted_start": "01:20:02.000",
      "formatted_end": "01:20:04.000",
      "text": "باید برداریم."
    },
    {
      "id": 2,
      "start": 4804.0,
      "end": 4806.0,
      "formatted_start": "01:20:04.000",
      "formatted_end": "01:20:06.000",
      "text": "خدای شبا خیلی خوبه."
    },
    {
      "id": 3,
      "start": 4806.0,
      "end": 4810.0,
      "formatted_start": "01:20:06.000",
      "formatted_end": "01:20:10.000",
      "text": "خدایی که برو تبلیغ کن، عزت بگو بیان اینجا رو میشه. خدایی جوانمه."
    },
    {
      "id": 4,
      "start": 4810.0,
      "end": 4812.0,
      "formatted_start": "01:20:10.000",
      "formatted_end": "01:20:12.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 5,
      "start": 4812.0,
      "end": 4814.0,
      "formatted_start": "01:20:12.000",
      "formatted_end": "01:20:14.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 6,
      "start": 4814.0,
      "end": 4816.0,
      "formatted_start": "01:20:14.000",
      "formatted_end": "01:20:16.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 7,
      "start": 4816.0,
      "end": 4818.0,
      "formatted_start": "01:20:16.000",
      "formatted_end": "01:20:18.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 8,
      "start": 4818.0,
      "end": 4820.0,
      "formatted_start": "01:20:18.000",
      "formatted_end": "01:20:20.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 9,
      "start": 4820.0,
      "end": 4822.0,
      "formatted_start": "01:20:20.000",
      "formatted_end": "01:20:22.000",
      "text": "برو خدایی خواهد بیان برو شد."
    },
    {
      "id": 10,
      "start": 4822.0,
      "end": 4825.0,
      "formatted_start": "01:20:22.000",
      "formatted_end": "01:20:25.000",
      "text": "داده که محبوظه که اشتراک زد بیرون شب با همونطور صحبت کردی"
    },
    {
      "id": 11,
      "start": 4825.0,
      "end": 4827.0,
      "formatted_start": "01:20:25.000",
      "formatted_end": "01:20:27.000",
      "text": "بزرگ بگیرم دابر مجدده"
    },
    {
      "id": 12,
      "start": 4828.0,
      "end": 4832.0,
      "formatted_start": "01:20:28.000",
      "formatted_end": "01:20:32.000",
      "text": "آره که اون نفر اصلا به خاطر ادرافش اومده بود"
    },
    {
      "id": 13,
      "start": 4832.0,
      "end": 4833.0,
      "formatted_start": "01:20:32.000",
      "formatted_end": "01:20:33.000",
      "text": "تب تشکرش"
    },
    {
      "id": 14,
      "start": 4833.0,
      "end": 4834.0,
      "formatted_start": "01:20:33.000",
      "formatted_end": "01:20:34.000",
      "text": "آره آره"
    },
    {
      "id": 15,
      "start": 4835.0,
      "end": 4836.0,
      "formatted_start": "01:20:35.000",
      "formatted_end": "01:20:36.000",
      "text": "آره داده همه اتفاق"
    },
    {
      "id": 16,
      "start": 4836.0,
      "end": 4850.0,
      "formatted_start": "01:20:36.000",
      "formatted_end": "01:20:50.000",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 4866.0,
      "end": 4868.0,
      "formatted_start": "01:21:06.000",
      "formatted_end": "01:21:08.000",
      "text": "اوه، مازه مثلو نمیشه"
    },
    {
      "id": 18,
      "start": 4868.0,
      "end": 4870.0,
      "formatted_start": "01:21:08.000",
      "formatted_end": "01:21:10.000",
      "text": "مشهد اینقدر دست اندازه برم"
    },
    {
      "id": 19,
      "start": 4870.0,
      "end": 4872.0,
      "formatted_start": "01:21:10.000",
      "formatted_end": "01:21:12.000",
      "text": "جان، سلام"
    },
    {
      "id": 20,
      "start": 4872.0,
      "end": 4874.0,
      "formatted_start": "01:21:12.000",
      "formatted_end": "01:21:14.000",
      "text": "برای پسر گرم"
    },
    {
      "id": 21,
      "start": 4874.0,
      "end": 4876.0,
      "formatted_start": "01:21:14.000",
      "formatted_end": "01:21:16.000",
      "text": "خب بشین اینجا برای پسر"
    },
    {
      "id": 22,
      "start": 4876.0,
      "end": 4878.0,
      "formatted_start": "01:21:16.000",
      "formatted_end": "01:21:18.000",
      "text": "جان دلم"
    },
    {
      "id": 23,
      "start": 4878.0,
      "end": 4880.0,
      "formatted_start": "01:21:18.000",
      "formatted_end": "01:21:20.000",
      "text": "سلام، بیروی خوبی؟"
    },
    {
      "id": 24,
      "start": 4880.0,
      "end": 4882.0,
      "formatted_start": "01:21:20.000",
      "formatted_end": "01:21:22.000",
      "text": "توش بیریم"
    },
    {
      "id": 25,
      "start": 4882.0,
      "end": 4884.0,
      "formatted_start": "01:21:22.000",
      "formatted_end": "01:21:24.000",
      "text": "آسانسار چی شده؟"
    },
    {
      "id": 26,
      "start": 4884.0,
      "end": 4886.0,
      "formatted_start": "01:21:24.000",
      "formatted_end": "01:21:26.000",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 4886.0,
      "end": 4888.0,
      "formatted_start": "01:21:26.000",
      "formatted_end": "01:21:28.000",
      "text": "نه، برد نمیره امروز"
    },
    {
      "id": 28,
      "start": 4888.0,
      "end": 4890.0,
      "formatted_start": "01:21:28.000",
      "formatted_end": "01:21:30.000",
      "text": "آره، آره، دستت در نکنه"
    },
    {
      "id": 29,
      "start": 4890.0,
      "end": 4892.0,
      "formatted_start": "01:21:30.000",
      "formatted_end": "01:21:32.000",
      "text": "آره، بستش کن"
    },
    {
      "id": 30,
      "start": 4892.0,
      "end": 4894.0,
      "formatted_start": "01:21:32.000",
      "formatted_end": "01:21:34.000",
      "text": "آره، برد نمیره، باشه، خدا خدا"
    },
    {
      "id": 31,
      "start": 4894.0,
      "end": 4896.0,
      "formatted_start": "01:21:34.000",
      "formatted_end": "01:21:36.000",
      "text": "نه، الان کمان."
    },
    {
      "id": 32,
      "start": 4896.0,
      "end": 4904.0,
      "formatted_start": "01:21:36.000",
      "formatted_end": "01:21:44.000",
      "text": "برکرد آسانفورونه چون گفته بود که یازت ها یکی قبلش قط میکنه، یکی رو بیس به به کسی نمونه توش."
    },
    {
      "id": 33,
      "start": 4904.0,
      "end": 4934.0,
      "formatted_start": "01:21:44.000",
      "formatted_end": "01:22:14.000",
      "text": "خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خب، خ"
    },
    {
      "id": 34,
      "start": 4934.0,
      "end": 4938.16,
      "formatted_start": "01:22:14.000",
      "formatted_end": "01:22:18.160",
      "text": "و از دیگه دلیلتر نخوابید. اما از آبریزش بینی هستن هیچی دیگه."
    },
    {
      "id": 35,
      "start": 4938.16,
      "end": 4940.0,
      "formatted_start": "01:22:18.160",
      "formatted_end": "01:22:20.000",
      "text": "پرابون آبریزش بینی داره دیگه."
    },
    {
      "id": 36,
      "start": 4940.0,
      "end": 4941.0,
      "formatted_start": "01:22:20.000",
      "formatted_end": "01:22:21.000",
      "text": "چیه ایش میاد یه آب نیاد؟"
    },
    {
      "id": 37,
      "start": 4941.0,
      "end": 4943.0,
      "formatted_start": "01:22:21.000",
      "formatted_end": "01:22:23.000",
      "text": "نه آب سفیده. معمولیه."
    },
    {
      "id": 38,
      "start": 4946.0,
      "end": 4948.0,
      "formatted_start": "01:22:26.000",
      "formatted_end": "01:22:28.000",
      "text": "صرفه ها شبه بیشتر یاد بزن."
    },
    {
      "id": 39,
      "start": 4948.0,
      "end": 4950.0,
      "formatted_start": "01:22:28.000",
      "formatted_end": "01:22:30.000",
      "text": "شبه ها؟"
    },
    {
      "id": 40,
      "start": 4950.0,
      "end": 4952.0,
      "formatted_start": "01:22:30.000",
      "formatted_end": "01:22:32.000",
      "text": "میگویی خواب بینیش که از دلیلتر نمیداره بخوابه."
    },
    {
      "id": 41,
      "start": 4952.0,
      "end": 4957.0,
      "formatted_start": "01:22:32.000",
      "formatted_end": "01:22:37.000",
      "text": "اینقدر این بینی استفاده اون کلورنگ دیگه اونو میدانم که فعال نکه نداره."
    },
    {
      "id": 42,
      "start": 4957.0,
      "end": 4959.0,
      "formatted_start": "01:22:37.000",
      "formatted_end": "01:22:39.000",
      "text": "خب سرشانه گرده"
    },
    {
      "id": 43,
      "start": 4959.0,
      "end": 4961.0,
      "formatted_start": "01:22:39.000",
      "formatted_end": "01:22:41.000",
      "text": "بگو آآآ"
    },
    {
      "id": 44,
      "start": 4961.0,
      "end": 4963.0,
      "formatted_start": "01:22:41.000",
      "formatted_end": "01:22:43.000",
      "text": "آآآ عزیزم"
    },
    {
      "id": 45,
      "start": 4963.0,
      "end": 4965.0,
      "formatted_start": "01:22:43.000",
      "formatted_end": "01:22:45.000",
      "text": "ماشالله"
    },
    {
      "id": 46,
      "start": 4965.0,
      "end": 4967.0,
      "formatted_start": "01:22:45.000",
      "formatted_end": "01:22:47.000",
      "text": "ماشالله بسر گلن"
    },
    {
      "id": 47,
      "start": 4967.0,
      "end": 4969.0,
      "formatted_start": "01:22:47.000",
      "formatted_end": "01:22:49.000",
      "text": "خب چه کار میکنی"
    },
    {
      "id": 48,
      "start": 4969.0,
      "end": 4971.0,
      "formatted_start": "01:22:49.000",
      "formatted_end": "01:22:51.000",
      "text": "با بچه داری؟"
    },
    {
      "id": 49,
      "start": 4971.0,
      "end": 4973.0,
      "formatted_start": "01:22:51.000",
      "formatted_end": "01:22:53.000",
      "text": "بهتر شد ریسترس و کمتر شد"
    },
    {
      "id": 50,
      "start": 4973.0,
      "end": 4975.0,
      "formatted_start": "01:22:53.000",
      "formatted_end": "01:22:55.000",
      "text": "ایه اوه ایه اوه کمتر شد ولی بازم"
    },
    {
      "id": 51,
      "start": 4975.0,
      "end": 4977.0,
      "formatted_start": "01:22:55.000",
      "formatted_end": "01:22:57.000",
      "text": "بهش کار نمیره تو که"
    },
    {
      "id": 52,
      "start": 4977.0,
      "end": 4979.0,
      "formatted_start": "01:22:57.000",
      "formatted_end": "01:22:59.000",
      "text": "خب داره دیگه"
    },
    {
      "id": 53,
      "start": 4979.0,
      "end": 4981.0,
      "formatted_start": "01:22:59.000",
      "formatted_end": "01:23:01.000",
      "text": "ساله به حالت از بچه بچه"
    },
    {
      "id": 54,
      "start": 4981.0,
      "end": 4983.0,
      "formatted_start": "01:23:01.000",
      "formatted_end": "01:23:03.000",
      "text": "و کار دیگه نمیباید برسید"
    },
    {
      "id": 55,
      "start": 4983.0,
      "end": 4985.0,
      "formatted_start": "01:23:03.000",
      "formatted_end": "01:23:05.000",
      "text": "خب دیگه نترس داره بچه"
    },
    {
      "id": 56,
      "start": 4985.0,
      "end": 4988.44,
      "formatted_start": "01:23:05.000",
      "formatted_end": "01:23:08.440",
      "text": "از نه هم تیمه رو از دا بار باشم و دیگه باید بریم و..."
    },
    {
      "id": 57,
      "start": 4988.44,
      "end": 4990.36,
      "formatted_start": "01:23:08.440",
      "formatted_end": "01:23:10.360",
      "text": "آه شما معلمی هستید"
    },
    {
      "id": 58,
      "start": 4990.36,
      "end": 4990.86,
      "formatted_start": "01:23:10.360",
      "formatted_end": "01:23:10.860",
      "text": "آه"
    },
    {
      "id": 59,
      "start": 4991.52,
      "end": 4995.0,
      "formatted_start": "01:23:11.520",
      "formatted_end": "01:23:15.000",
      "text": "خب ببینید با من این یه سرم و خوردگی لیروسیه خب"
    },
    {
      "id": 60,
      "start": 4995.0,
      "end": 4999.16,
      "formatted_start": "01:23:15.000",
      "formatted_end": "01:23:19.160",
      "text": "محتوی این به خاطر اینکه شب می کنه به خلطهش میلیزه پشتر حلقهش"
    },
    {
      "id": 61,
      "start": 4999.16,
      "end": 5000.36,
      "formatted_start": "01:23:19.160",
      "formatted_end": "01:23:20.360",
      "text": "این صرفه ها خواهی سیاد میشه"
    },
    {
      "id": 62,
      "start": 5000.36,
      "end": 5003.16,
      "formatted_start": "01:23:20.360",
      "formatted_end": "01:23:23.160",
      "text": "بعد یه داروی بدیم که خلطهش رو کم بکنه"
    },
    {
      "id": 63,
      "start": 5003.16,
      "end": 5007.0,
      "formatted_start": "01:23:23.160",
      "formatted_end": "01:23:27.000",
      "text": "بعد اون تحت نشم کمتر بکنه"
    },
    {
      "id": 64,
      "start": 5007.0,
      "end": 5009.3,
      "formatted_start": "01:23:27.000",
      "formatted_end": "01:23:29.300",
      "text": "بسش دارون بینم بسه هم استفاده خواه خوبه خوب میشه"
    },
    {
      "id": 65,
      "start": 5009.3,
      "end": 5011.3,
      "formatted_start": "01:23:29.300",
      "formatted_end": "01:23:31.300",
      "text": "از ریاهاش نام مشکل نداره؟"
    },
    {
      "id": 66,
      "start": 5011.3,
      "end": 5012.3,
      "formatted_start": "01:23:31.300",
      "formatted_end": "01:23:32.300",
      "text": "نه، از اینکه نه"
    },
    {
      "id": 67,
      "start": 5012.3,
      "end": 5015.4,
      "formatted_start": "01:23:32.300",
      "formatted_end": "01:23:35.400",
      "text": "بس هم دکتر این بیسته مه دیگه یک سال میشین"
    },
    {
      "id": 68,
      "start": 5015.4,
      "end": 5017.1,
      "formatted_start": "01:23:35.400",
      "formatted_end": "01:23:37.100",
      "text": "گره هم یاد بخواهی نه"
    },
    {
      "id": 69,
      "start": 5017.1,
      "end": 5018.8,
      "formatted_start": "01:23:37.100",
      "formatted_end": "01:23:38.800",
      "text": "بعد در نور پایین درورده"
    },
    {
      "id": 70,
      "start": 5018.8,
      "end": 5020.1,
      "formatted_start": "01:23:38.800",
      "formatted_end": "01:23:40.100",
      "text": "دوتا بالا درورده"
    },
    {
      "id": 71,
      "start": 5020.1,
      "end": 5022.1,
      "formatted_start": "01:23:40.100",
      "formatted_end": "01:23:42.100",
      "text": "از میشه می کنم دوتای بغل هم داره میشین"
    },
    {
      "id": 72,
      "start": 5022.1,
      "end": 5023.5,
      "formatted_start": "01:23:42.100",
      "formatted_end": "01:23:43.500",
      "text": "زیر از که خوبه"
    },
    {
      "id": 73,
      "start": 5023.5,
      "end": 5024.3,
      "formatted_start": "01:23:43.500",
      "formatted_end": "01:23:44.300",
      "text": "آه"
    },
    {
      "id": 74,
      "start": 5024.3,
      "end": 5026.3,
      "formatted_start": "01:23:44.300",
      "formatted_end": "01:23:46.300",
      "text": "یه قدوه هست میشه هم نگاه میکرده؟"
    },
    {
      "id": 75,
      "start": 5026.3,
      "end": 5027.3,
      "formatted_start": "01:23:46.300",
      "formatted_end": "01:23:47.300",
      "text": "از اینکه همه"
    },
    {
      "id": 76,
      "start": 5027.3,
      "end": 5033.3,
      "formatted_start": "01:23:47.300",
      "formatted_end": "01:23:53.300",
      "text": "بعد مهم قبل از اینکه برم واکستان افتادی بگنم"
    },
    {
      "id": 77,
      "start": 5033.3,
      "end": 5035.3,
      "formatted_start": "01:23:53.300",
      "formatted_end": "01:23:55.300",
      "text": "یه سمی ها میاد جا تونه چکاک کنه"
    },
    {
      "id": 78,
      "start": 5035.3,
      "end": 5039.3,
      "formatted_start": "01:23:55.300",
      "formatted_end": "01:23:59.300",
      "text": "بعد بگن قطعه استامینوفن چقدر بدم چجوری بدم"
    },
    {
      "id": 79,
      "start": 5039.3,
      "end": 5041.3,
      "formatted_start": "01:23:59.300",
      "formatted_end": "01:24:01.300",
      "text": "خوش"
    },
    {
      "id": 80,
      "start": 5054.3,
      "end": 5056.3,
      "formatted_start": "01:24:14.300",
      "formatted_end": "01:24:16.300",
      "text": "خب، یه بعدش کنیم"
    },
    {
      "id": 81,
      "start": 5056.3,
      "end": 5059.3,
      "formatted_start": "01:24:16.300",
      "formatted_end": "01:24:19.300",
      "text": "خب، بوده بعد من شیفتی میدن"
    },
    {
      "id": 82,
      "start": 5059.3,
      "end": 5061.3,
      "formatted_start": "01:24:19.300",
      "formatted_end": "01:24:21.300",
      "text": "قرده رو میدن، چونم رو بود خورید"
    },
    {
      "id": 83,
      "start": 5061.3,
      "end": 5063.3,
      "formatted_start": "01:24:21.300",
      "formatted_end": "01:24:23.300",
      "text": "چونم برد برسنن"
    },
    {
      "id": 84,
      "start": 5063.3,
      "end": 5065.3,
      "formatted_start": "01:24:23.300",
      "formatted_end": "01:24:25.300",
      "text": "برد برسنن، قرده رو"
    },
    {
      "id": 85,
      "start": 5065.3,
      "end": 5067.3,
      "formatted_start": "01:24:25.300",
      "formatted_end": "01:24:27.300",
      "text": "قرده رو؟ ببین دیگه از یک سال"
    },
    {
      "id": 86,
      "start": 5067.3,
      "end": 5071.3,
      "formatted_start": "01:24:27.300",
      "formatted_end": "01:24:31.300",
      "text": "قبل از یک سالگی شیر غذای اصلیه"
    },
    {
      "id": 87,
      "start": 5071.3,
      "end": 5073.3,
      "formatted_start": "01:24:31.300",
      "formatted_end": "01:24:33.300",
      "text": "با ما غذا رو کمک کردیم"
    },
    {
      "id": 88,
      "start": 5073.3,
      "end": 5075.3,
      "formatted_start": "01:24:33.300",
      "formatted_end": "01:24:35.300",
      "text": "ما شانو خب یازها قصد همون عملیم"
    },
    {
      "id": 89,
      "start": 5075.3,
      "end": 5077.3,
      "formatted_start": "01:24:35.300",
      "formatted_end": "01:24:37.300",
      "text": "خب"
    },
    {
      "id": 90,
      "start": 5077.3,
      "end": 5081.3,
      "formatted_start": "01:24:37.300",
      "formatted_end": "01:24:41.300",
      "text": "بعد از یک سالگی برقص غذا میشه اصلی"
    },
    {
      "id": 91,
      "start": 5081.3,
      "end": 5083.3,
      "formatted_start": "01:24:41.300",
      "formatted_end": "01:24:43.300",
      "text": "شیر میشه کمکی"
    },
    {
      "id": 92,
      "start": 5083.3,
      "end": 5085.3,
      "formatted_start": "01:24:43.300",
      "formatted_end": "01:24:45.300",
      "text": "من الان خیلی داند برگاه چقدر بدم"
    },
    {
      "id": 93,
      "start": 5085.3,
      "end": 5087.3,
      "formatted_start": "01:24:45.300",
      "formatted_end": "01:24:47.300",
      "text": "خب مثلا میدم بعضی روزا نیستی کاسی میخوره"
    },
    {
      "id": 94,
      "start": 5087.3,
      "end": 5089.3,
      "formatted_start": "01:24:47.300",
      "formatted_end": "01:24:49.300",
      "text": "بعضی روزا کم گاشت میخوره"
    },
    {
      "id": 95,
      "start": 5089.3,
      "end": 5091.3,
      "formatted_start": "01:24:49.300",
      "formatted_end": "01:24:51.300",
      "text": "چرا باید بگو داره؟"
    },
    {
      "id": 96,
      "start": 5091.3,
      "end": 5093.3,
      "formatted_start": "01:24:51.300",
      "formatted_end": "01:24:53.300",
      "text": "هر چقدر خواست"
    },
    {
      "id": 97,
      "start": 5093.3,
      "end": 5095.3,
      "formatted_start": "01:24:53.300",
      "formatted_end": "01:24:55.300",
      "text": "ولی شیرشو دیگه کم کم کم کم"
    },
    {
      "id": 98,
      "start": 5095.3,
      "end": 5097.3,
      "formatted_start": "01:24:55.300",
      "formatted_end": "01:24:57.300",
      "text": "چند بار چند پرده"
    },
    {
      "id": 99,
      "start": 5097.3,
      "end": 5099.3,
      "formatted_start": "01:24:57.300",
      "formatted_end": "01:24:59.300",
      "text": "شبه منو که ازتر جاشه"
    },
    {
      "id": 100,
      "start": 5099.3,
      "end": 5101.3,
