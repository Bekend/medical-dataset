  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5430.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:30.000",
      "text": "باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برد"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5432.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:32.000",
      "text": "مایان"
    },
    {
      "id": 2,
      "start": 5432.0,
      "end": 5434.0,
      "formatted_start": "01:30:32.000",
      "formatted_end": "01:30:34.000",
      "text": "مایان"
    },
    {
      "id": 3,
      "start": 5434.0,
      "end": 5436.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:36.000",
      "text": "دوست شمایش تب کرد"
    },
    {
      "id": 4,
      "start": 5436.0,
      "end": 5438.0,
      "formatted_start": "01:30:36.000",
      "formatted_end": "01:30:38.000",
      "text": "بعد بردیم برجان سر بیمار سند"
    },
    {
      "id": 5,
      "start": 5438.0,
      "end": 5440.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:40.000",
      "text": "برداخانی استامینوفن داد با سیتریزی"
    },
    {
      "id": 6,
      "start": 5440.0,
      "end": 5442.0,
      "formatted_start": "01:30:40.000",
      "formatted_end": "01:30:42.000",
      "text": "یک ساره ابریزش هم راشت"
    },
    {
      "id": 7,
      "start": 5442.0,
      "end": 5444.0,
      "formatted_start": "01:30:42.000",
      "formatted_end": "01:30:44.000",
      "text": "بهتر بود"
    },
    {
      "id": 8,
      "start": 5444.0,
      "end": 5446.0,
      "formatted_start": "01:30:44.000",
      "formatted_end": "01:30:46.000",
      "text": "پاز دیشب صرفش شروع شد بیقراره"
    },
    {
      "id": 9,
      "start": 5446.0,
      "end": 5448.0,
      "formatted_start": "01:30:46.000",
      "formatted_end": "01:30:48.000",
      "text": "الان میدی تبش قد شده"
    },
    {
      "id": 10,
      "start": 5448.0,
      "end": 5450.0,
      "formatted_start": "01:30:48.000",
      "formatted_end": "01:30:50.000",
      "text": "آره تبش هم اونشب قد شد"
    },
    {
      "id": 11,
      "start": 5450.0,
      "end": 5452.0,
      "formatted_start": "01:30:50.000",
      "formatted_end": "01:30:52.000",
      "text": "سی و هفت و نیمی ناشده بود"
    },
    {
      "id": 12,
      "start": 5452.0,
      "end": 5454.0,
      "formatted_start": "01:30:52.000",
      "formatted_end": "01:30:54.000",
      "text": "تبش ترسیدم بردم"
    },
    {
      "id": 13,
      "start": 5454.0,
      "end": 5456.0,
      "formatted_start": "01:30:54.000",
      "formatted_end": "01:30:56.000",
      "text": "چه؟"
    },
    {
      "id": 14,
      "start": 5456.0,
      "end": 5458.0,
      "formatted_start": "01:30:56.000",
      "formatted_end": "01:30:58.000",
      "text": "باباش سرم خورده بود از باباش"
    },
    {
      "id": 15,
      "start": 5458.0,
      "end": 5462.4,
      "formatted_start": "01:30:58.000",
      "formatted_end": "01:31:02.400",
      "text": "سنش خسن خشخش بکن"
    },
    {
      "id": 16,
      "start": 5462.4,
      "end": 5464.46,
      "formatted_start": "01:31:02.400",
      "formatted_end": "01:31:04.460",
      "text": "یه ها شروع شد دیشم"
    },
    {
      "id": 17,
      "start": 5464.46,
      "end": 5470.4,
      "formatted_start": "01:31:04.460",
      "formatted_end": "01:31:10.400",
      "text": "سنشو نگه دارم"
    },
    {
      "id": 18,
      "start": 5470.4,
      "end": 5479.34,
      "formatted_start": "01:31:10.400",
      "formatted_end": "01:31:19.340",
      "text": "باید گرده دختر خوب"
    },
    {
      "id": 19,
      "start": 5479.34,
      "end": 5481.52,
      "formatted_start": "01:31:19.340",
      "formatted_end": "01:31:21.520",
      "text": "نه بشامه شده"
    },
    {
      "id": 20,
      "start": 5481.52,
      "end": 5483.14,
      "formatted_start": "01:31:21.520",
      "formatted_end": "01:31:23.140",
      "text": "باید گرده"
    },
    {
      "id": 21,
      "start": 5483.14,
      "end": 5485.34,
      "formatted_start": "01:31:23.140",
      "formatted_end": "01:31:25.340",
      "text": "باید گرده"
    },
    {
      "id": 22,
      "start": 5485.34,
      "end": 5487.34,
      "formatted_start": "01:31:25.340",
      "formatted_end": "01:31:27.340",
      "text": "خیلی خوب"
    },
    {
      "id": 23,
      "start": 5487.34,
      "end": 5489.34,
      "formatted_start": "01:31:27.340",
      "formatted_end": "01:31:29.340",
      "text": "خیلی خوب"
    },
    {
      "id": 24,
      "start": 5489.34,
      "end": 5491.34,
      "formatted_start": "01:31:29.340",
      "formatted_end": "01:31:31.340",
      "text": "خیلی خوب"
    },
    {
      "id": 25,
      "start": 5491.34,
      "end": 5493.34,
      "formatted_start": "01:31:31.340",
      "formatted_end": "01:31:33.340",
      "text": "خیلی خوب"
    },
    {
      "id": 26,
      "start": 5493.34,
      "end": 5495.34,
      "formatted_start": "01:31:33.340",
      "formatted_end": "01:31:35.340",
      "text": "خیلی خوب"
    },
    {
      "id": 27,
      "start": 5495.34,
      "end": 5497.34,
      "formatted_start": "01:31:35.340",
      "formatted_end": "01:31:37.340",
      "text": "خیلی خوب"
    },
    {
      "id": 28,
      "start": 5497.34,
      "end": 5499.34,
      "formatted_start": "01:31:37.340",
      "formatted_end": "01:31:39.340",
      "text": "خیلی خوب"
    },
    {
      "id": 29,
      "start": 5499.34,
      "end": 5501.34,
      "formatted_start": "01:31:39.340",
      "formatted_end": "01:31:41.340",
      "text": "خیلی خوب"
    },
    {
      "id": 30,
      "start": 5501.34,
      "end": 5503.34,
      "formatted_start": "01:31:41.340",
      "formatted_end": "01:31:43.340",
      "text": "خیلی خوب"
    },
    {
      "id": 31,
      "start": 5503.34,
      "end": 5505.34,
      "formatted_start": "01:31:43.340",
      "formatted_end": "01:31:45.340",
      "text": "خیلی خوب"
    },
    {
      "id": 32,
      "start": 5505.34,
      "end": 5507.34,
      "formatted_start": "01:31:45.340",
      "formatted_end": "01:31:47.340",
      "text": "خیلی خوب"
    },
    {
      "id": 33,
      "start": 5507.34,
      "end": 5509.34,
      "formatted_start": "01:31:47.340",
      "formatted_end": "01:31:49.340",
      "text": "خیلی خوب"
    },
    {
      "id": 34,
      "start": 5509.34,
      "end": 5511.34,
      "formatted_start": "01:31:49.340",
      "formatted_end": "01:31:51.340",
      "text": "خیلی خوب"
    },
    {
      "id": 35,
      "start": 5511.34,
      "end": 5513.34,
      "formatted_start": "01:31:51.340",
      "formatted_end": "01:31:53.340",
      "text": "خیلی خوب"
    },
    {
      "id": 36,
      "start": 5513.34,
      "end": 5541.34,
      "formatted_start": "01:31:53.340",
      "formatted_end": "01:32:21.340",
      "text": "موسیقی"
    },
    {
      "id": 37,
      "start": 5543.34,
      "end": 5549.86,
      "formatted_start": "01:32:23.340",
      "formatted_end": "01:32:29.860",
      "text": "الان یازده ماه و پنج شش روزه شد"
    },
    {
      "id": 38,
      "start": 5549.86,
      "end": 5554.38,
      "formatted_start": "01:32:29.860",
      "formatted_end": "01:32:34.380",
      "text": "در این مرد به دنیا آمده دوزه هیران"
    },
    {
      "id": 39,
      "start": 5554.38,
      "end": 5556.86,
      "formatted_start": "01:32:34.380",
      "formatted_end": "01:32:36.860",
      "text": "طریق تولدش دوازده هشت"
    },
    {
      "id": 40,
      "start": 5556.86,
      "end": 5558.86,
      "formatted_start": "01:32:36.860",
      "formatted_end": "01:32:38.860",
      "text": "هفته چارصد و چانچار"
    },
    {
      "id": 41,
      "start": 5558.86,
      "end": 5560.86,
      "formatted_start": "01:32:38.860",
      "formatted_end": "01:32:40.860",
      "text": "ایشته چار روزه شد"
    },
    {
      "id": 42,
      "start": 5560.86,
      "end": 5563.26,
      "formatted_start": "01:32:40.860",
      "formatted_end": "01:32:43.260",
      "text": "ایشته چار"
    },
    {
      "id": 43,
      "start": 5563.26,
      "end": 5565.26,
      "formatted_start": "01:32:43.260",
      "formatted_end": "01:32:45.260",
      "text": "یک ماه پیش تقریبا"
    },
    {
      "id": 44,
      "start": 5565.26,
      "end": 5567.26,
      "formatted_start": "01:32:45.260",
      "formatted_end": "01:32:47.260",
      "text": "دو ماه پیش هشت و سی ست بود"
    },
    {
      "id": 45,
      "start": 5567.26,
      "end": 5569.26,
      "formatted_start": "01:32:47.260",
      "formatted_end": "01:32:49.260",
      "text": "الان ده ماه پیش خوب شده"
    },
    {
      "id": 46,
      "start": 5569.26,
      "end": 5573.26,
      "formatted_start": "01:32:49.260",
      "formatted_end": "01:32:53.260",
      "text": "براتون تولدش شد با سه و هشت ست"
    },
    {
      "id": 47,
      "start": 5573.26,
      "end": 5578.62,
      "formatted_start": "01:32:53.260",
      "formatted_end": "01:32:58.620",
      "text": "ببین کلن وزن دهانه این وردی بچه ای که داره یه سالش میشه خیلی وزن خوبی"
    },
    {
      "id": 48,
      "start": 5578.62,
      "end": 5580.54,
      "formatted_start": "01:32:58.620",
      "formatted_end": "01:33:00.540",
      "text": "الان راه هم بیده دختر؟"
    },
    {
      "id": 49,
      "start": 5580.54,
      "end": 5583.02,
      "formatted_start": "01:33:00.540",
      "formatted_end": "01:33:03.020",
      "text": "آه، وردی، وردی که الان"
    },
    {
      "id": 50,
      "start": 5583.02,
      "end": 5585.18,
      "formatted_start": "01:33:03.020",
      "formatted_end": "01:33:05.180",
      "text": "خب دهانه این که ای"
    },
    {
      "id": 51,
      "start": 5585.18,
      "end": 5588.26,
      "formatted_start": "01:33:05.180",
      "formatted_end": "01:33:08.260",
      "text": "ببین، یه صرفه های ما داریم تو بچه ها"
    },
    {
      "id": 52,
      "start": 5588.26,
      "end": 5590.86,
      "formatted_start": "01:33:08.260",
      "formatted_end": "01:33:10.860",
      "text": "البته تو بزرگ سالان هم داریم"
    },
    {
      "id": 53,
      "start": 5590.86,
      "end": 5593.34,
      "formatted_start": "01:33:10.860",
      "formatted_end": "01:33:13.340",
      "text": "وقتی یه سرمکردگی و یه ویروسی میدینن"
    },
    {
      "id": 54,
      "start": 5593.34,
      "end": 5597.58,
      "formatted_start": "01:33:13.340",
      "formatted_end": "01:33:17.580",
      "text": "بعدش، بعد از یک چند روز دوچار برونشیت میشن"
    },
    {
      "id": 55,
      "start": 5597.58,
      "end": 5599.76,
      "formatted_start": "01:33:17.580",
      "formatted_end": "01:33:19.760",
      "text": "که بهش میگن برونشیت های ناشی از ویروس"
    },
    {
      "id": 56,
      "start": 5599.76,
      "end": 5606.76,
      "formatted_start": "01:33:19.760",
      "formatted_end": "01:33:26.760",
      "text": "این باناش اینطور در واقع چرک نیست، یه سیستم التحابیه، التحاب مجاری هواییه"
    },
    {
      "id": 57,
      "start": 5606.76,
      "end": 5609.76,
      "formatted_start": "01:33:26.760",
      "formatted_end": "01:33:29.760",
      "text": "واسه دارو می نمیسن، داروش اصلافاتو کم کم شما باشن"
    },
    {
      "id": 58,
      "start": 5609.76,
      "end": 5611.76,
      "formatted_start": "01:33:29.760",
      "formatted_end": "01:33:31.760",
      "text": "قبلت کرده سرما خوردگی ها"
    },
    {
      "id": 59,
      "start": 5611.76,
      "end": 5615.76,
      "formatted_start": "01:33:31.760",
      "formatted_end": "01:33:35.760",
      "text": "دیگه طبیعیش وقتی قد شده، دیگه سرما خوردگیه بهتره خب"
    },
    {
      "id": 60,
      "start": 5615.76,
      "end": 5619.76,
      "formatted_start": "01:33:35.760",
      "formatted_end": "01:33:39.760",
      "text": "آخر این به صورته میافتن، آره ببین طب نمی کنه"
    },
    {
      "id": 61,
      "start": 5619.76,
      "end": 5626.32,
      "formatted_start": "01:33:39.760",
      "formatted_end": "01:33:46.320",
      "text": "نه، یعنی که یک عفونت صانویه روی سوار بشه، مثلا گوشش عفونت بخونه، سیروزیت بشه، این دیگه..."
    },
    {
      "id": 62,
      "start": 5626.32,
      "end": 5627.52,
      "formatted_start": "01:33:46.320",
      "formatted_end": "01:33:47.520",
      "text": "برای برابر باشن اینجا"
    },
    {
      "id": 63,
      "start": 5627.52,
      "end": 5631.12,
      "formatted_start": "01:33:47.520",
      "formatted_end": "01:33:51.120",
      "text": "آره، برای برابر باشن، آره، اشنا برابر بشن، بیمه داری خود فراموش کنید"
    },
    {
      "id": 64,
      "start": 5631.12,
      "end": 5632.0,
      "formatted_start": "01:33:51.120",
      "formatted_end": "01:33:52.000",
      "text": "برای تنبیل"
    },
    {
      "id": 65,
      "start": 5637.76,
      "end": 5643.76,
      "formatted_start": "01:33:57.760",
      "formatted_end": "01:34:03.760",
      "text": "در حالاتو، یازده ماهشت خیلی اصلا بهمی گیر شده، آره، دیر براتش"
    },
    {
      "id": 66,
      "start": 5643.76,
      "end": 5644.72,
      "formatted_start": "01:34:03.760",
      "formatted_end": "01:34:04.720",
      "text": "دیر براتش"
    },
    {
      "id": 67,
      "start": 5644.72,
      "end": 5647.32,
      "formatted_start": "01:34:04.720",
      "formatted_end": "01:34:07.320",
      "text": "یه چیزی از رستشو میگیرن و بجید میزن"
    },
    {
      "id": 68,
      "start": 5647.32,
      "end": 5649.32,
      "formatted_start": "01:34:07.320",
      "formatted_end": "01:34:09.320",
      "text": "بلین بچه ها توی یه سنی"
    },
    {
      "id": 69,
      "start": 5649.32,
      "end": 5651.18,
      "formatted_start": "01:34:09.320",
      "formatted_end": "01:34:11.180",
      "text": "خیلی خوب میفهمن"
    },
    {
      "id": 70,
      "start": 5651.18,
      "end": 5652.98,
      "formatted_start": "01:34:11.180",
      "formatted_end": "01:34:12.980",
      "text": "میخوان حرف بزنن"
    },
    {
      "id": 71,
      "start": 5652.98,
      "end": 5655.26,
      "formatted_start": "01:34:12.980",
      "formatted_end": "01:34:15.260",
      "text": "منظورشون رو بدن ولی هنوز حرف زدنشون"
    },
    {
      "id": 72,
      "start": 5655.26,
      "end": 5655.64,
      "formatted_start": "01:34:15.260",
      "formatted_end": "01:34:15.640",
      "text": "کامل نشوند"
    },
    {
      "id": 73,
      "start": 5655.64,
      "end": 5658.94,
      "formatted_start": "01:34:15.640",
      "formatted_end": "01:34:18.940",
      "text": "با جیخ زدن و نقلق کردن"
    },
    {
      "id": 74,
      "start": 5658.94,
      "end": 5661.2,
      "formatted_start": "01:34:18.940",
      "formatted_end": "01:34:21.200",
      "text": "میخواد به هدفش برسه"
    },
    {
      "id": 75,
      "start": 5661.2,
      "end": 5662.24,
      "formatted_start": "01:34:21.200",
      "formatted_end": "01:34:22.240",
      "text": "این طبیعیه"
    },
    {
      "id": 76,
      "start": 5662.24,
      "end": 5665.14,
      "formatted_start": "01:34:22.240",
      "formatted_end": "01:34:25.140",
      "text": "حالا تو این سن باید خودتون حواظش باشه"
    },
    {
      "id": 77,
      "start": 5665.14,
      "end": 5667.22,
      "formatted_start": "01:34:25.140",
      "formatted_end": "01:34:27.220",
      "text": "اگر که مثلا کارای نکنید"
    },
    {
      "id": 78,
      "start": 5667.22,
      "end": 5668.16,
      "formatted_start": "01:34:27.220",
      "formatted_end": "01:34:28.160",
      "text": "کلت بازیش"
    },
    {
      "id": 79,
      "start": 5668.16,
      "end": 5670.58,
      "formatted_start": "01:34:28.160",
      "formatted_end": "01:34:30.580",
      "text": "حالا از رستش بخوان بگیرن"
    },
    {
      "id": 80,
      "start": 5670.58,
      "end": 5673.58,
      "formatted_start": "01:34:30.580",
      "formatted_end": "01:34:33.580",
      "text": "این مرحله رو سرگرمش می کنن و خواستشون نکنن"
    },
    {
      "id": 81,
      "start": 5673.58,
      "end": 5678.58,
      "formatted_start": "01:34:33.580",
      "formatted_end": "01:34:38.580",
      "text": "اگر شما بتونید قللش رو دستتون بگیرید دیگه این مرحله رو راحت رفت می کنن"
    },
    {
      "id": 82,
      "start": 5678.58,
      "end": 5682.58,
      "formatted_start": "01:34:38.580",
      "formatted_end": "01:34:42.580",
      "text": "ولی خانواده هایی که لجبازی می کنن با بچه ها"
    },
    {
      "id": 83,
      "start": 5682.58,
      "end": 5685.58,
      "formatted_start": "01:34:42.580",
      "formatted_end": "01:34:45.580",
      "text": "مثلا اون جگ می زنه این هم به زون نمیدن بهش"
    },
    {
      "id": 84,
      "start": 5685.58,
      "end": 5688.58,
      "formatted_start": "01:34:45.580",
      "formatted_end": "01:34:48.580",
      "text": "یکی خواربرده بزرگتر داره که باش لجبازی می کنن"
    },
    {
      "id": 85,
      "start": 5688.58,
      "end": 5691.58,
      "formatted_start": "01:34:48.580",
      "formatted_end": "01:34:51.580",
      "text": "یا برعکس تا یه چیزی جگ می زنه می خواد فوراً بهش می ده"
    },
    {
      "id": 86,
      "start": 5691.58,
      "end": 5693.58,
      "formatted_start": "01:34:51.580",
      "formatted_end": "01:34:53.580",
      "text": "این هم اشتباهه"
    },
    {
      "id": 87,
      "start": 5693.58,
      "end": 5698.44,
      "formatted_start": "01:34:53.580",
      "formatted_end": "01:34:58.440",
      "text": "باید خودتون مدیریتش بکنید که این نهایت را راحت تیرو کنید"
    }
  ],
  "status": "completed"
}