  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13509.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:09.000",
      "text": "مغز ها در حال رشت کرده. مغز های نوزار وقتی به دنیا میان، دو سال بعد مغز های هشتاد درصد یادم بزرگ سال."
    },
    {
      "id": 1,
      "start": 13509.0,
      "end": 13518.0,
      "formatted_start": "03:45:09.000",
      "formatted_end": "03:45:18.000",
      "text": "چون سلیل های مغز های رشت کرده هستند، ما باید مراقبت از مغز بیشتر کنیم. باید این را لای شیشه بزرگ کنیم."
    },
    {
      "id": 2,
      "start": 13518.0,
      "end": 13524.0,
      "formatted_start": "03:45:18.000",
      "formatted_end": "03:45:24.000",
      "text": "متوجه شدید؟ بله یه آدم بزرگ سال نه، اصلا یه بچه هشت نو ساله بیاد با تب تشننش کنه."
    },
    {
      "id": 3,
      "start": 13524.0,
      "end": 13529.0,
      "formatted_start": "03:45:24.000",
      "formatted_end": "03:45:29.000",
      "text": "من اصلا نگرانش نیستم به مادرشم میگم نگران نباش این تشمجا خشقیمه"
    },
    {
      "id": 4,
      "start": 13529.0,
      "end": 13531.0,
      "formatted_start": "03:45:29.000",
      "formatted_end": "03:45:31.000",
      "text": "هیچ مشکل در بر بچه ها دیجات نمیکنه"
    },
    {
      "id": 5,
      "start": 13531.0,
      "end": 13538.0,
      "formatted_start": "03:45:31.000",
      "formatted_end": "03:45:38.000",
      "text": "کما اینکه من بعضی وقت مادران نگرانم بگم ببین برادر خود من سه بار تشنج کرد"
    },
    {
      "id": 6,
      "start": 13538.0,
      "end": 13543.0,
      "formatted_start": "03:45:38.000",
      "formatted_end": "03:45:43.000",
      "text": "تو اولمپیاد فیزیک اول شد الان فوق لسانس الکترونیکه"
    },
    {
      "id": 7,
      "start": 13543.0,
      "end": 13548.0,
      "formatted_start": "03:45:43.000",
      "formatted_end": "03:45:48.000",
      "text": "پس اصلا روحوشش تاثری نذاشته نگران نباشید خب؟"
    },
    {
      "id": 8,
      "start": 13548.0,
      "end": 13551.0,
      "formatted_start": "03:45:48.000",
      "formatted_end": "03:45:51.000",
      "text": "ولی تو نوازاد ما باید یک کم حواسمون بیشتر باشید"
    },
    {
      "id": 9,
      "start": 13551.0,
      "end": 13561.0,
      "formatted_start": "03:45:51.000",
      "formatted_end": "03:46:01.000",
      "text": "از اینکه بچه شما رو اومدن همه ازمایش رو گرفتن، همه کار کردن، ببین این ازمایش گرفتن از بچه شما به من سودی نبیده سوده"
    },
    {
      "id": 10,
      "start": 13561.0,
      "end": 13569.0,
      "formatted_start": "03:46:01.000",
      "formatted_end": "03:46:09.000",
      "text": "خب که مثلا بچه ها رو موشه ازماشگاهی کنن، ما میخواییم به بچه کمک کنیم که بتونه بعدا که بزرگ میشه یه آدم صالح بگیرش"
    },
    {
      "id": 11,
      "start": 13569.0,
      "end": 13572.0,
      "formatted_start": "03:46:09.000",
      "formatted_end": "03:46:12.000",
      "text": "خب، حالا بزنید اینجا من گردنشم ببینم"
    },
    {
      "id": 12,
      "start": 13572.0,
      "end": 13577.0,
      "formatted_start": "03:46:12.000",
      "formatted_end": "03:46:17.000",
      "text": "گردنشم با سنگرافی که کردن، خودشون و براشون"
    },
    {
      "id": 13,
      "start": 13581.0,
      "end": 13591.0,
      "formatted_start": "03:46:21.000",
      "formatted_end": "03:46:31.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 13611.0,
      "end": 13613.0,
      "formatted_start": "03:46:51.000",
      "formatted_end": "03:46:53.000",
      "text": "یعنی آقا سنگی باید یک سنگی کنید."
    },
    {
      "id": 15,
      "start": 13613.0,
      "end": 13616.0,
      "formatted_start": "03:46:53.000",
      "formatted_end": "03:46:56.000",
      "text": "این بزرگون طور تا خود کنید که ماقی سوگی شیدیم."
    },
    {
      "id": 16,
      "start": 13616.0,
      "end": 13619.0,
      "formatted_start": "03:46:56.000",
      "formatted_end": "03:46:59.000",
      "text": "خدا ما سنگوار داریم؟ سنگوار داریم؟"
    },
    {
      "id": 17,
      "start": 13619.0,
      "end": 13620.0,
      "formatted_start": "03:46:59.000",
      "formatted_end": "03:47:00.000",
      "text": "نشان داریم."
    },
    {
      "id": 18,
      "start": 13620.0,
      "end": 13622.0,
      "formatted_start": "03:47:00.000",
      "formatted_end": "03:47:02.000",
      "text": "نشان داشتون داریم. دیدم سانج."
    },
    {
      "id": 19,
      "start": 13622.0,
      "end": 13624.0,
      "formatted_start": "03:47:02.000",
      "formatted_end": "03:47:04.000",
      "text": "دست نویس بداشتون داشتون."
    },
    {
      "id": 20,
      "start": 13624.0,
      "end": 13626.0,
      "formatted_start": "03:47:04.000",
      "formatted_end": "03:47:06.000",
      "text": "سنگوار باید."
    },
    {
      "id": 21,
      "start": 13626.0,
      "end": 13627.0,
      "formatted_start": "03:47:06.000",
      "formatted_end": "03:47:07.000",
      "text": "هچون؟"
    },
    {
      "id": 22,
      "start": 13627.0,
      "end": 13628.0,
      "formatted_start": "03:47:07.000",
      "formatted_end": "03:47:08.000",
      "text": "سنگوار در کلش برم."
    },
    {
      "id": 23,
      "start": 13628.0,
      "end": 13632.0,
      "formatted_start": "03:47:08.000",
      "formatted_end": "03:47:12.000",
      "text": "سنگوار، سنگوار."
    },
    {
      "id": 24,
      "start": 13632.0,
      "end": 13635.0,
      "formatted_start": "03:47:12.000",
      "formatted_end": "03:47:15.000",
      "text": "خدا."
    },
    {
      "id": 25,
      "start": 13635.0,
      "end": 13638.0,
      "formatted_start": "03:47:15.000",
      "formatted_end": "03:47:18.000",
      "text": "میخنده؟ لبخنده در خودتون."
    },
    {
      "id": 26,
      "start": 13638.0,
      "end": 13639.0,
      "formatted_start": "03:47:18.000",
      "formatted_end": "03:47:19.000",
      "text": "آره آره."
    },
    {
      "id": 27,
      "start": 13639.0,
      "end": 13642.0,
      "formatted_start": "03:47:19.000",
      "formatted_end": "03:47:22.000",
      "text": "برای اینکه این چیز رو بخوریم"
    },
    {
      "id": 28,
      "start": 13642.0,
      "end": 13645.0,
      "formatted_start": "03:47:22.000",
      "formatted_end": "03:47:25.000",
      "text": "دروش کم شده بود"
    },
    {
      "id": 29,
      "start": 13645.0,
      "end": 13648.0,
      "formatted_start": "03:47:25.000",
      "formatted_end": "03:47:28.000",
      "text": "چند دروش بود؟"
    },
    {
      "id": 30,
      "start": 13648.0,
      "end": 13652.0,
      "formatted_start": "03:47:28.000",
      "formatted_end": "03:47:32.000",
      "text": "دروش اول نیم نیم بود"
    },
    {
      "id": 31,
      "start": 13652.0,
      "end": 13655.0,
      "formatted_start": "03:47:32.000",
      "formatted_end": "03:47:35.000",
      "text": "آخر نیم نیم بود بعد نیم یک"
    },
    {
      "id": 32,
      "start": 13655.0,
      "end": 13657.0,
      "formatted_start": "03:47:35.000",
      "formatted_end": "03:47:37.000",
      "text": "به کامل"
    },
    {
      "id": 33,
      "start": 13657.0,
      "end": 13659.0,
      "formatted_start": "03:47:37.000",
      "formatted_end": "03:47:39.000",
      "text": "برایش برگان که مثلا محشد که رفتیم"
    },
    {
      "id": 34,
      "start": 13659.0,
      "end": 13661.0,
      "formatted_start": "03:47:39.000",
      "formatted_end": "03:47:41.000",
      "text": "گفت که یک چهار و یک چهار نشوند"
    },
    {
      "id": 35,
      "start": 13661.0,
      "end": 13663.0,
      "formatted_start": "03:47:41.000",
      "formatted_end": "03:47:43.000",
      "text": "که آخر شب با یک چهار بشن"
    },
    {
      "id": 36,
      "start": 13663.0,
      "end": 13665.0,
      "formatted_start": "03:47:43.000",
      "formatted_end": "03:47:45.000",
      "text": "آخرش آخر"
    },
    {
      "id": 37,
      "start": 13669.0,
      "end": 13671.0,
      "formatted_start": "03:47:49.000",
      "formatted_end": "03:47:51.000",
      "text": "مردم رو بردارید"
    },
    {
      "id": 38,
      "start": 13671.0,
      "end": 13673.0,
      "formatted_start": "03:47:51.000",
      "formatted_end": "03:47:53.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 39,
      "start": 13673.0,
      "end": 13675.0,
      "formatted_start": "03:47:53.000",
      "formatted_end": "03:47:55.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 40,
      "start": 13675.0,
      "end": 13677.0,
      "formatted_start": "03:47:55.000",
      "formatted_end": "03:47:57.000",
      "text": "از اینجا بردارید"
    },
    {
      "id": 41,
      "start": 13677.0,
      "end": 13679.0,
      "formatted_start": "03:47:57.000",
      "formatted_end": "03:47:59.000",
      "text": "از اینجا بردارید"
    },
    {
