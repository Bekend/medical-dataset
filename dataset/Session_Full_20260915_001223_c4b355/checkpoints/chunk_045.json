      "start": 13679.0,
      "end": 13681.0,
      "formatted_start": "03:47:59.000",
      "formatted_end": "03:48:01.000",
      "text": "از اینجا بردارید"
    },
    {
      "id": 43,
      "start": 13681.0,
      "end": 13683.0,
      "formatted_start": "03:48:01.000",
      "formatted_end": "03:48:03.000",
