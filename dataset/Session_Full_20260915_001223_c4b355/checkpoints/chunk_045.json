      "id": 68,
      "start": 13757.0,
      "end": 13759.0,
      "formatted_start": "03:49:17.000",
      "formatted_end": "03:49:19.000",
      "text": "به خودت قندش افتنه کنن"
    },
    {
      "id": 69,
      "start": 13759.0,
      "end": 13761.0,
      "formatted_start": "03:49:19.000",
      "formatted_end": "03:49:21.000",
      "text": "باید الان شکر و خدا"
    },
    {
      "id": 70,
      "start": 13761.0,
      "end": 13763.0,
      "formatted_start": "03:49:21.000",
      "formatted_end": "03:49:23.000",
      "text": "دایی وقتا خودش یک خوابش تردیبه"
    },
    {
      "id": 71,
      "start": 13763.0,
      "end": 13765.0,
      "formatted_start": "03:49:23.000",
      "formatted_end": "03:49:25.000",
      "text": "مثلا دیشتر ساعت گه هاره"
    },
    {
      "id": 72,
      "start": 13765.0,
      "end": 13767.0,
      "formatted_start": "03:49:25.000",
      "formatted_end": "03:49:27.000",
      "text": "گه مثلا خوابی دوازنه میداشت"
    },
    {
      "id": 73,
      "start": 13767.0,
      "end": 13769.0,
      "formatted_start": "03:49:27.000",
      "formatted_end": "03:49:29.000",
      "text": "دایی وقتی چهار ساعت میشه خوابه"
    },
    {
      "id": 74,
      "start": 13769.0,
      "end": 13771.0,
      "formatted_start": "03:49:29.000",
      "formatted_end": "03:49:31.000",
      "text": "چهار ساعت خوابش"
    },
