      "start": 13693.0,
      "end": 13695.0,
      "formatted_start": "03:48:13.000",
      "formatted_end": "03:48:15.000",
      "text": "از اینجا بردارید"
    },
    {
      "id": 50,
      "start": 13695.0,
      "end": 13697.0,
      "formatted_start": "03:48:15.000",
      "formatted_end": "03:48:17.000",
      "text": "از اینجا بردارید"
    },
    {
      "id": 51,
      "start": 13697.0,
      "end": 13703.0,
      "formatted_start": "03:48:17.000",
      "formatted_end": "03:48:23.000",
      "text": "نبی آقا نبی آقا نبی پسری خوب"
    },
    {
      "id": 52,
      "start": 13703.0,
      "end": 13708.0,
      "formatted_start": "03:48:23.000",
      "formatted_end": "03:48:28.000",
      "text": "خب برای گردنش یه سند خب این خاردرمالی به دلیلش نبوردی نه؟"
    },
    {
      "id": 53,
      "start": 13708.0,
      "end": 13709.0,
      "formatted_start": "03:48:28.000",
      "formatted_end": "03:48:29.000",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 13709.0,
      "end": 13713.0,
      "formatted_start": "03:48:29.000",
      "formatted_end": "03:48:33.000",
      "text": "خب اینکه ماساج میدم، یه ماساج با یه سری حرکات"
    },
    {
      "id": 55,
      "start": 13713.0,
      "end": 13717.0,
      "formatted_start": "03:48:33.000",
      "formatted_end": "03:48:37.000",
      "text": "باعث میشه که گردن استعمال میشه ببین به هر دقیقی کشیدگی سر"
    },
    {
      "id": 56,
      "start": 13717.0,
      "end": 13720.0,
      "formatted_start": "03:48:37.000",
      "formatted_end": "03:48:40.000",
      "text": "یا این که تو شکن بوده به اینش سند بوده"
    },
    {
      "id": 57,
      "start": 13720.0,
      "end": 13723.0,
      "formatted_start": "03:48:40.000",
      "formatted_end": "03:48:43.000",
      "text": "یه سند چی میشه؟ این اضاله جمع میشه"
    },
    {
      "id": 58,
      "start": 13723.0,
      "end": 13730.0,
      "formatted_start": "03:48:43.000",
      "formatted_end": "03:48:50.000",
      "text": "و باعث میشه که یک گلوله اینجا باشه و بعد به همه سر میمونه"
    },
    {
      "id": 59,
      "start": 13730.0,
      "end": 13735.0,
      "formatted_start": "03:48:50.000",
      "formatted_end": "03:48:55.000",
      "text": "اینو باید با ورزش دیده یه ازادهی که میگیره با ورزش سرش میگیره"
    },
    {
      "id": 60,
      "start": 13735.0,
      "end": 13736.0,
      "formatted_start": "03:48:55.000",
      "formatted_end": "03:48:56.000",
      "text": "آره باید بایدش بگیره"
    },
    {
      "id": 61,
      "start": 13736.0,
      "end": 13742.0,
      "formatted_start": "03:48:56.000",
      "formatted_end": "03:49:02.000",
      "text": "آره کار که شامل می کنیم اون کاری که دستشو خونده فرق داره دیگه"
    },
    {
      "id": 62,
      "start": 13742.0,
      "end": 13745.0,
      "formatted_start": "03:49:02.000",
      "formatted_end": "03:49:05.000",
      "text": "چون اگه در باری خودو نکرده کار در مایه داره"
    },
    {
      "id": 63,
      "start": 13745.0,
      "end": 13749.0,
      "formatted_start": "03:49:05.000",
      "formatted_end": "03:49:09.000",
      "text": "بعد چقدر بعد از شب بخوابه"
    },
    {
      "id": 64,
      "start": 13749.0,
      "end": 13751.0,
      "formatted_start": "03:49:09.000",
      "formatted_end": "03:49:11.000",
      "text": "من که در باری بخوابه"
    },
    {
      "id": 65,
      "start": 13751.0,
      "end": 13753.0,
      "formatted_start": "03:49:11.000",
      "formatted_end": "03:49:13.000",
      "text": "این هر دو ساعت دو ساعت اونو بیداشت میده"
    },
    {
      "id": 66,
      "start": 13753.0,
      "end": 13755.0,
      "formatted_start": "03:49:13.000",
      "formatted_end": "03:49:15.000",
      "text": "دو ساعت اونو بیداشت میده"
    },
    {
      "id": 67,
      "start": 13755.0,
      "end": 13757.0,
      "formatted_start": "03:49:15.000",
      "formatted_end": "03:49:17.000",
      "text": "چرا؟"
    },
