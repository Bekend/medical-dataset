      "end": 11429.98,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 11430.0,
      "end": 11450.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:10:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 11450.0,
      "end": 11480.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:11:20.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 3,
      "start": 11480.0,
      "end": 11508.0,
      "formatted_start": "03:11:20.000",
      "formatted_end": "03:11:48.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 11508.0,
      "end": 11510.0,
      "formatted_start": "03:11:48.000",
      "formatted_end": "03:11:50.000",
      "text": "سلام"
    },
    {
      "id": 5,
      "start": 11510.0,
      "end": 11512.0,
      "formatted_start": "03:11:50.000",
      "formatted_end": "03:11:52.000",
      "text": "سلام عزیزم"
    },
    {
      "id": 6,
      "start": 11512.0,
      "end": 11514.0,
      "formatted_start": "03:11:52.000",
      "formatted_end": "03:11:54.000",
      "text": "مرحبا برنامه این"
    },
    {
      "id": 7,
      "start": 11518.0,
      "end": 11520.0,
      "formatted_start": "03:11:58.000",
      "formatted_end": "03:12:00.000",
      "text": "خوب کنی باز هفت شد"
    },
    {
      "id": 8,
      "start": 11520.0,
      "end": 11522.0,
      "formatted_start": "03:12:00.000",
      "formatted_end": "03:12:02.000",
      "text": "چی شده عزیزم؟"
    },
    {
      "id": 9,
      "start": 11522.0,
      "end": 11524.0,
      "formatted_start": "03:12:02.000",
      "formatted_end": "03:12:04.000",
      "text": "این پسان همه چند روزی که کلنن تب دارست"
    },
    {
      "id": 10,
      "start": 11524.0,
      "end": 11526.0,
      "formatted_start": "03:12:04.000",
      "formatted_end": "03:12:06.000",
      "text": "اون تبش کمی نمی آمد"
    },
    {
      "id": 11,
      "start": 11526.0,
      "end": 11528.0,
      "formatted_start": "03:12:06.000",
      "formatted_end": "03:12:08.000",
      "text": "بی قدر شدید"
    },
    {
      "id": 12,
      "start": 11528.0,
      "end": 11530.0,
      "formatted_start": "03:12:08.000",
      "formatted_end": "03:12:10.000",
      "text": "چند مانشه؟"
    },
    {
      "id": 13,
      "start": 11530.0,
      "end": 11532.0,
      "formatted_start": "03:12:10.000",
      "formatted_end": "03:12:12.000",
      "text": "چند مانشه؟"
    },
    {
      "id": 14,
      "start": 11532.0,
      "end": 11534.0,
      "formatted_start": "03:12:12.000",
      "formatted_end": "03:12:14.000",
      "text": "از که شده تبش"
    },
    {
      "id": 15,
      "start": 11534.0,
      "end": 11536.0,
      "formatted_start": "03:12:14.000",
      "formatted_end": "03:12:16.000",
      "text": "اون دو روزش تب بگذاره"
    },
    {
      "id": 16,
      "start": 11536.0,
      "end": 11540.0,
      "formatted_start": "03:12:16.000",
      "formatted_end": "03:12:20.000",
      "text": "نه، شیر هم جدا نمی کنه، غذا هم نمی کنه، نه داره به اون صورت"
    },
    {
      "id": 17,
      "start": 11540.0,
      "end": 11542.0,
      "formatted_start": "03:12:20.000",
      "formatted_end": "03:12:22.000",
      "text": "اصحال نشده؟"
    },
    {
      "id": 18,
      "start": 11542.0,
      "end": 11544.0,
      "formatted_start": "03:12:22.000",
      "formatted_end": "03:12:24.000",
      "text": "نه، یکم شرسه و اصحال چیز نیست"
    },
    {
      "id": 19,
      "start": 11544.0,
      "end": 11545.0,
      "formatted_start": "03:12:24.000",
      "formatted_end": "03:12:25.000",
      "text": "بالا نیست؟"
    },
    {
      "id": 20,
      "start": 11545.0,
      "end": 11546.0,
      "formatted_start": "03:12:25.000",
      "formatted_end": "03:12:26.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 11560.0,
      "end": 11562.0,
      "formatted_start": "03:12:40.000",
      "formatted_end": "03:12:42.000",
      "text": "چرا یک قدر اینو باشه؟"
    },
    {
      "id": 22,
      "start": 11566.0,
      "end": 11596.0,
      "formatted_start": "03:12:46.000",
      "formatted_end": "03:13:16.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 23,
      "start": 11626.0,
      "end": 11628.0,
      "formatted_start": "03:13:46.000",
      "formatted_end": "03:13:48.000",
      "text": "خواهید بردارید که اینجا باید بردارید."
    },
    {
      "id": 24,
      "start": 11628.0,
      "end": 11630.0,
      "formatted_start": "03:13:48.000",
      "formatted_end": "03:13:50.000",
      "text": "خواهید بردارید که اینجا باید بردارید."
    },
    {
      "id": 25,
      "start": 11630.0,
      "end": 11632.0,
      "formatted_start": "03:13:50.000",
      "formatted_end": "03:13:52.000",
      "text": "خواهید بردارید که اینجا باید بردارید."
    },
    {
      "id": 26,
      "start": 11632.0,
      "end": 11634.0,
      "formatted_start": "03:13:52.000",
      "formatted_end": "03:13:54.000",
      "text": "خواهید بردارید که اینجا بردارید که اینجا بردارید."
    },
    {
      "id": 27,
      "start": 11634.0,
      "end": 11663.98,
      "formatted_start": "03:13:54.000",
      "formatted_end": "03:14:23.980",
      "text": "باید بردارید که اینجا باید بردارید"
    },
    {
      "id": 28,
      "start": 11664.0,
      "end": 11672.0,
      "formatted_start": "03:14:24.000",
      "formatted_end": "03:14:32.000",
      "text": "این چیزی که از این حدود بخشید، سینه ساله، گلوش ساله، یک بره شروع بکنه مدفوع"
    },
    {
      "id": 29,
      "start": 11672.0,
      "end": 11674.0,
      "formatted_start": "03:14:32.000",
      "formatted_end": "03:14:34.000",
      "text": "این روزه و راز احتمال هست"
    },
    {
      "id": 30,
      "start": 11674.0,
      "end": 11686.0,
      "formatted_start": "03:14:34.000",
      "formatted_end": "03:14:46.000",
      "text": "اگر تبش قط شد، تبش بیرون، اگر بیرون، یعنی که بچه هست، خوب شده، آخر مدیشه"
    },
    {
      "id": 31,
      "start": 11686.0,
