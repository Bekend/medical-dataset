    {
      "id": 3,
      "start": 7511.0,
      "end": 7512.0,
      "formatted_start": "02:05:11.000",
      "formatted_end": "02:05:12.000",
      "text": "فقط یه آزمایش هم؟"
    },
    {
      "id": 4,
      "start": 7512.0,
      "end": 7516.0,
      "formatted_start": "02:05:12.000",
      "formatted_end": "02:05:16.000",
      "text": "یه آزمایش اضرار و یه آزمایش غرب. ببین چه همونش واسه من پیان بدم."
    },
    {
      "id": 5,
      "start": 7516.0,
      "end": 7517.0,
      "formatted_start": "02:05:16.000",
      "formatted_end": "02:05:17.000",
      "text": "خیلی چون؟"
    },
    {
      "id": 6,
      "start": 7517.0,
      "end": 7522.0,
      "formatted_start": "02:05:17.000",
      "formatted_end": "02:05:22.000",
      "text": "کشت اضرارش دیر آماده باشه، مثلا دوزگیر، ولی آزمایش اولیهش آماده شد و من خواهدم."
    },
    {
      "id": 7,
      "start": 7522.0,
      "end": 7524.0,
      "formatted_start": "02:05:22.000",
      "formatted_end": "02:05:24.000",
      "text": "من پردیس بیدم دیگه، پردیس."
    },
    {
      "id": 8,
      "start": 7524.0,
      "end": 7525.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:25.000",
      "text": "پردیس نباشه."
    },
    {
      "id": 9,
      "start": 7525.0,
      "end": 7527.0,
      "formatted_start": "02:05:25.000",
      "formatted_end": "02:05:27.000",
      "text": "تشکر شما دارد نمی کنید"
    },
    {
      "id": 10,
      "start": 7527.0,
      "end": 7529.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:29.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 11,
      "start": 7529.0,
      "end": 7531.0,
      "formatted_start": "02:05:29.000",
      "formatted_end": "02:05:31.000",
      "text": "باید بیا بیا بیا"
    },
    {
      "id": 12,
      "start": 7531.0,
      "end": 7533.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:33.000",
      "text": "باید بیا خوشگل بده"
    },
    {
      "id": 13,
      "start": 7533.0,
      "end": 7535.0,
      "formatted_start": "02:05:33.000",
      "formatted_end": "02:05:35.000",
      "text": "مرسی"
    },
    {
      "id": 14,
      "start": 7535.0,
      "end": 7537.0,
      "formatted_start": "02:05:35.000",
      "formatted_end": "02:05:37.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 15,
      "start": 7537.0,
      "end": 7539.0,
      "formatted_start": "02:05:37.000",
      "formatted_end": "02:05:39.000",
      "text": "خدا شما دید"
    },
    {
      "id": 16,
      "start": 7539.0,
      "end": 7541.0,
      "formatted_start": "02:05:39.000",
      "formatted_end": "02:05:41.000",
      "text": "بوده برو"
    },
    {
      "id": 17,
      "start": 7555.0,
      "end": 7584.98,
      "formatted_start": "02:05:55.000",
      "formatted_end": "02:06:24.980",
      "text": "باید فهم بگید"
    },
    {
      "id": 18,
      "start": 7585.0,
      "end": 7587.0,
      "formatted_start": "02:06:25.000",
      "formatted_end": "02:06:27.000",
      "text": "چند داره میداره؟"
    },
    {
      "id": 19,
      "start": 7587.0,
      "end": 7589.0,
      "formatted_start": "02:06:27.000",
      "formatted_end": "02:06:29.000",
      "text": "یعنی دستش کن دختر"
    },
    {
      "id": 20,
      "start": 7589.0,
      "end": 7591.0,
      "formatted_start": "02:06:29.000",
      "formatted_end": "02:06:31.000",
      "text": "من گرس در این بچه پیگی می کنه"
    },
    {
      "id": 21,
      "start": 7591.0,
      "end": 7593.0,
      "formatted_start": "02:06:31.000",
      "formatted_end": "02:06:33.000",
      "text": "پیلا روشنا منش شستم"
    },
    {
      "id": 22,
      "start": 7593.0,
      "end": 7595.0,
      "formatted_start": "02:06:33.000",
      "formatted_end": "02:06:35.000",
      "text": "شستم و بعد نرس کردم"
    },
    {
      "id": 23,
      "start": 7595.0,
      "end": 7597.0,
      "formatted_start": "02:06:35.000",
      "formatted_end": "02:06:37.000",
      "text": "دسترس پیگی"
    },
    {
      "id": 24,
      "start": 7597.0,
      "end": 7599.0,
      "formatted_start": "02:06:37.000",
      "formatted_end": "02:06:39.000",
      "text": "دسترس پیگی"
    },
    {
      "id": 25,
      "start": 7599.0,
      "end": 7601.0,
      "formatted_start": "02:06:39.000",
      "formatted_end": "02:06:41.000",
      "text": "چه درست کرد؟"
    },
    {
      "id": 26,
      "start": 7601.0,
      "end": 7603.0,
      "formatted_start": "02:06:41.000",
      "formatted_end": "02:06:43.000",
      "text": "که درستش میده"
    },
    {
      "id": 27,
      "start": 7603.0,
      "end": 7605.0,
      "formatted_start": "02:06:43.000",
      "formatted_end": "02:06:45.000",
      "text": "بعد بیرون خوب شدی"
    },
    {
      "id": 28,
      "start": 7605.0,
      "end": 7607.0,
      "formatted_start": "02:06:45.000",
      "formatted_end": "02:06:47.000",
      "text": "و از آنجا که شد"
    },
    {
      "id": 29,
      "start": 7607.0,
      "end": 7609.0,
      "formatted_start": "02:06:47.000",
      "formatted_end": "02:06:49.000",
      "text": "این خیلی بیتابه خیلی بیشتر"
    },
    {
      "id": 30,
      "start": 7609.0,
      "end": 7611.0,
      "formatted_start": "02:06:49.000",
      "formatted_end": "02:06:51.000",
      "text": "هیچ گره هم گریه میکنه"
    },
    {
      "id": 31,
      "start": 7611.0,
      "end": 7613.0,
      "formatted_start": "02:06:51.000",
      "formatted_end": "02:06:53.000",
      "text": "ساخت نفر باشد"
    },
    {
      "id": 32,
      "start": 7613.0,
      "end": 7619.0,
      "formatted_start": "02:06:53.000",
      "formatted_end": "02:06:59.000",
      "text": "اینکه تا ساخنه همونی بود که باید بلا و من نگاه شدم که باید کنیم تب کردیم این مریض شده بودم"
    },
    {
      "id": 33,
      "start": 7619.0,
      "end": 7622.0,
      "formatted_start": "02:06:59.000",
      "formatted_end": "02:07:02.000",
      "text": "در این شکل دیگه تبترین فراموش دادم"
    },
    {
      "id": 34,
      "start": 7622.0,
      "end": 7626.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:06.000",
      "text": "از اینجورم بودم دکتر، دکتر برپیش من گفت که این دکتر در موقع براترین شد"
    },
    {
      "id": 35,
      "start": 7626.0,
      "end": 7629.0,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:09.000",
      "text": "از اون شرک شرک گذاریم، بودم بیمارستان بسترش کنم"
    },
    {
      "id": 36,
      "start": 7629.0,
      "end": 7632.0,
      "formatted_start": "02:07:09.000",
      "formatted_end": "02:07:12.000",
      "text": "یا باید آزمش ازش بگیم یا باید بسترش کنم"
    },
    {
      "id": 37,
      "start": 7632.0,
      "end": 7634.0,
      "formatted_start": "02:07:12.000",
      "formatted_end": "02:07:14.000",
      "text": "تب داشت با من؟"
    },
    {
      "id": 38,
      "start": 7634.0,
      "end": 7635.0,
      "formatted_start": "02:07:14.000",
      "formatted_end": "02:07:15.000",
      "text": "تب داشت"
    },
    {
      "id": 39,
      "start": 7635.0,
      "end": 7665.0,
      "formatted_start": "02:07:15.000",
      "formatted_end": "02:07:45.000",
      "text": "در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت"
    },
    {
      "id": 40,
      "start": 7665.0,
      "end": 7668.0,
      "formatted_start": "02:07:45.000",
      "formatted_end": "02:07:48.000",
      "text": "آخری باری که بهش اصلا مطمئن دادی که ای بود؟"
    },
    {
      "id": 41,
      "start": 7670.0,
      "end": 7672.0,
      "formatted_start": "02:07:50.000",
      "formatted_end": "02:07:52.000",
      "text": "ریز که کنم سو دو دفتر میکنم"
    },
    {
      "id": 42,
      "start": 7672.0,
      "end": 7674.0,
      "formatted_start": "02:07:52.000",
      "formatted_end": "02:07:54.000",
      "text": "دیروز که دادی دیگه نداری"
    },
    {
      "id": 43,
      "start": 7674.0,
      "end": 7675.0,
      "formatted_start": "02:07:54.000",
      "formatted_end": "02:07:55.000",
      "text": "نه دیرندم دیگه"
    },
    {
      "id": 44,
      "start": 7675.0,
      "end": 7677.0,
      "formatted_start": "02:07:55.000",
      "formatted_end": "02:07:57.000",
      "text": "دیرندم همش کم که درنگه"
    },
    {
      "id": 45,
      "start": 7678.0,
      "end": 7679.0,
      "formatted_start": "02:07:58.000",
      "formatted_end": "02:07:59.000",
      "text": "ندارم"
    },
    {
      "id": 46,
      "start": 7679.0,
      "end": 7680.0,
      "formatted_start": "02:07:59.000",
      "formatted_end": "02:08:00.000",
      "text": "ندارن؟"
    },
    {
      "id": 47,
      "start": 7680.0,
      "end": 7683.0,
      "formatted_start": "02:08:00.000",
      "formatted_end": "02:08:03.000",
      "text": "من این تفسرش رو که اون کار روش دادم"
    },
    {
      "id": 48,
      "start": 7683.0,
      "end": 7684.0,
      "formatted_start": "02:08:03.000",
      "formatted_end": "02:08:04.000",
      "text": "از این ها که؟"
    },
    {
      "id": 49,
      "start": 7684.0,
      "end": 7686.0,
      "formatted_start": "02:08:04.000",
      "formatted_end": "02:08:06.000",
      "text": "از هم ندارم دیگه"
    },
    {
      "id": 50,
      "start": 7686.0,
      "end": 7687.0,
      "formatted_start": "02:08:06.000",
      "formatted_end": "02:08:07.000",
      "text": "با این هم دیگه"
    },
    {
      "id": 51,
      "start": 7687.0,
      "end": 7689.0,
      "formatted_start": "02:08:07.000",
      "formatted_end": "02:08:09.000",
      "text": "امین نبوده نمونشو بگیرم"
    },
    {
      "id": 52,
      "start": 7689.0,
      "end": 7692.0,
      "formatted_start": "02:08:09.000",
      "formatted_end": "02:08:12.000",
      "text": "خب هنو باید چیز کنی"
    },
    {
      "id": 53,
      "start": 7692.0,
      "end": 7696.0,
      "formatted_start": "02:08:12.000",
      "formatted_end": "02:08:16.000",
      "text": "ببین، سانتیگراد داره فارنهایت داره"
    },
    {
      "id": 54,
      "start": 7696.0,
      "end": 7699.0,
      "formatted_start": "02:08:16.000",
      "formatted_end": "02:08:19.000",
      "text": "والدتا بر اساس فارنهایت تبدیل شده"
    },
    {
      "id": 55,
      "start": 7699.0,
      "end": 7701.0,
      "formatted_start": "02:08:19.000",
      "formatted_end": "02:08:21.000",
      "text": "یه دو پیه خودشونی سرده"
    },
    {
      "id": 56,
      "start": 7701.0,
      "end": 7704.0,
      "formatted_start": "02:08:21.000",
      "formatted_end": "02:08:24.000",
      "text": "فارنهایتشو باید تبدیل می کنید به سانتیگراد"
    },
    {
      "id": 57,
      "start": 7704.0,
      "end": 7706.0,
      "formatted_start": "02:08:24.000",
      "formatted_end": "02:08:26.000",
      "text": "کجایی باید دارن نویسون آمده؟"
    },
    {
      "id": 58,
      "start": 7706.0,
      "end": 7707.0,
      "formatted_start": "02:08:26.000",
      "formatted_end": "02:08:27.000",
      "text": "نه نه بگیر"
    },
    {
      "id": 59,
      "start": 7708.0,
      "end": 7711.0,
      "formatted_start": "02:08:28.000",
      "formatted_end": "02:08:31.000",
      "text": "ای جان دلنم، ای جان"
    },
    {
      "id": 60,
      "start": 7711.0,
      "end": 7713.0,
      "formatted_start": "02:08:31.000",
      "formatted_end": "02:08:33.000",
      "text": "چی رو باید هم می آره؟"
    },
    {
      "id": 61,
      "start": 7713.0,
      "end": 7715.0,
      "formatted_start": "02:08:33.000",
      "formatted_end": "02:08:35.000",
      "text": "نه نه نه، چی رو می خوره؟"
    },
    {
      "id": 62,
      "start": 7715.0,
      "end": 7718.0,
      "formatted_start": "02:08:35.000",
      "formatted_end": "02:08:38.000",
      "text": "ای جان، ای جان"
    },
    {
      "id": 63,
      "start": 7718.0,
      "end": 7720.0,
      "formatted_start": "02:08:38.000",
      "formatted_end": "02:08:40.000",
