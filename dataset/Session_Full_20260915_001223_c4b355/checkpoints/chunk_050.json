  "stt_segments": [
    {
      "id": 0,
      "start": 15000.0,
      "end": 15005.64,
      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:05.640",
      "text": "بردم این بیمارسان، یک رو ببرم که دکتر اطفالی تو خود بیمارسان، فولی گفت باید بستریش کنی."
    },
    {
      "id": 1,
      "start": 15005.64,
      "end": 15013.64,
      "formatted_start": "04:10:05.640",
      "formatted_end": "04:10:13.640",
      "text": "بعد این چیز من اطافت زن زدن، اینجا که نوبت هم بگیرم شروع بود، از روی ادویان و اینا، بردم بشه یک دکتر دیگر."
    },
    {
      "id": 2,
      "start": 15013.64,
      "end": 15020.64,
      "formatted_start": "04:10:13.640",
      "formatted_end": "04:10:20.640",
      "text": "گفتم منتظر دارم بگیرم چی کار کنن به همکه یک دکتر زیده کنن، بشه دکتر طریقتی بردم."
    },
    {
      "id": 3,
      "start": 15020.64,
      "end": 15031.64,
      "formatted_start": "04:10:20.640",
      "formatted_end": "04:10:31.640",
      "text": "از اینجورم بسرگیر شده بودم و از اینجورم برم بیرون از بیمارستان ندارم"
    },
    {
      "id": 4,
      "start": 15031.64,
      "end": 15037.64,
      "formatted_start": "04:10:31.640",
      "formatted_end": "04:10:37.640",
      "text": "بیمارستان رو بسرگیر کردن و از آزمایش هم هیچی هم نیسته"
    },
    {
      "id": 5,
      "start": 15037.64,
      "end": 15040.64,
      "formatted_start": "04:10:37.640",
      "formatted_end": "04:10:40.640",
      "text": "یک کچوری بدنش کماب شده بوده"
    },
    {
      "id": 6,
      "start": 15040.64,
      "end": 15044.64,
      "formatted_start": "04:10:40.640",
      "formatted_end": "04:10:44.640",
      "text": "بعد دیگه پرونده شو نداری؟"
    },
    {
      "id": 7,
      "start": 15044.64,
      "end": 15050.64,
      "formatted_start": "04:10:44.640",
      "formatted_end": "04:10:50.640",
      "text": "چی ندارم. آزمایشی کشت ادرار و ادرار نگرده همه ش مرفی شد و این امتناب نداره"
    },
    {
      "id": 8,
      "start": 15050.64,
      "end": 15058.64,
      "formatted_start": "04:10:50.640",
      "formatted_end": "04:10:58.640",
      "text": "بعد دیگه چیز شده برو ملخصش کردن که دیگه از این مقابله خامدوتو خودم احساس میکنم شیرم کنی شد"
    },
    {
      "id": 9,
      "start": 15058.64,
      "end": 15060.64,
      "formatted_start": "04:10:58.640",
      "formatted_end": "04:11:00.640",
      "text": "خیلی؟"
    },
    {
      "id": 10,
      "start": 15060.64,
      "end": 15062.64,
      "formatted_start": "04:11:00.640",
      "formatted_end": "04:11:02.640",
      "text": "ازش خوردیش"
    },
    {
      "id": 11,
      "start": 15062.64,
      "end": 15066.64,
      "formatted_start": "04:11:02.640",
      "formatted_end": "04:11:06.640",
      "text": "آخه خامدوتو اومدن رگ از این بگیرم پدرشو در آوردن"
    },
    {
      "id": 12,
      "start": 15066.64,
      "end": 15068.64,
      "formatted_start": "04:11:06.640",
      "formatted_end": "04:11:08.640",
      "text": "هفت گروه"
    },
    {
      "id": 13,
      "start": 15068.64,
      "end": 15070.64,
      "formatted_start": "04:11:08.640",
      "formatted_end": "04:11:10.640",
      "text": "هفت گروه؟"
    },
    {
      "id": 14,
      "start": 15070.64,
      "end": 15074.64,
      "formatted_start": "04:11:10.640",
      "formatted_end": "04:11:14.640",
      "text": "اما در درگزیر بگیرم پدرشو در آبوردن"
    },
    {
      "id": 15,
      "start": 15074.64,
      "end": 15078.64,
      "formatted_start": "04:11:14.640",
      "formatted_end": "04:11:18.640",
      "text": "بعد یه حامدو شیر و روش گمبی میخوره"
    },
    {
      "id": 16,
      "start": 15078.64,
      "end": 15082.64,
      "formatted_start": "04:11:18.640",
      "formatted_end": "04:11:22.640",
      "text": "بعد دوستی شیر چرا گریه میکنه اینم"
    },
    {
      "id": 17,
      "start": 15082.64,
      "end": 15086.64,
      "formatted_start": "04:11:22.640",
      "formatted_end": "04:11:26.640",
      "text": "وضع خوبه؟ آهانی"
    },
    {
      "id": 18,
      "start": 15086.64,
      "end": 15090.64,
      "formatted_start": "04:11:26.640",
      "formatted_end": "04:11:30.640",
      "text": "تنگ کلو به ددنیا؟ دو هیستد و هفته"
    },
    {
      "id": 19,
      "start": 15090.64,
      "end": 15092.64,
      "formatted_start": "04:11:30.640",
      "formatted_end": "04:11:32.640",
      "text": "آهانی باشه"
    },
    {
      "id": 20,
      "start": 15092.64,
      "end": 15096.64,
      "formatted_start": "04:11:32.640",
      "formatted_end": "04:11:36.640",
      "text": "خوب الان چقدر تضابطه؟ اصلا بگیم سه کلو بوده اما چهار کلو اضافه شده"
    },
    {
      "id": 21,
      "start": 15096.64,
      "end": 15099.64,
      "formatted_start": "04:11:36.640",
      "formatted_end": "04:11:39.640",
      "text": "اینما یه کلو اضافه کرده چه خبرشه؟"
    },
    {
      "id": 22,
      "start": 15099.64,
      "end": 15104.64,
      "formatted_start": "04:11:39.640",
      "formatted_end": "04:11:44.640",
      "text": "خب، شیر کم نشانه، این خیلی میخوره"
    },
    {
      "id": 23,
      "start": 15104.64,
      "end": 15107.64,
      "formatted_start": "04:11:44.640",
      "formatted_end": "04:11:47.640",
      "text": "این زیاد خوش داره، خیلی میخوره دیگه"
    },
    {
      "id": 24,
      "start": 15107.64,
      "end": 15137.64,
      "formatted_start": "04:11:47.640",
      "formatted_end": "04:12:17.640",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 25,
      "start": 15137.64,
      "end": 15146.64,
      "formatted_start": "04:12:17.640",
      "formatted_end": "04:12:26.640",
      "text": "اینکه توی کشورهای جمهوری سزمان ممکنه خانواده هایی باشن از در اقتصادی از در اجتماعی لیول پایینی باشن"
    },
    {
      "id": 26,
      "start": 15146.64,
      "end": 15149.64,
      "formatted_start": "04:12:26.640",
      "formatted_end": "04:12:29.640",
      "text": "و به بچه هاشون غذایی مناسب ندن"
    },
    {
      "id": 27,
      "start": 15149.64,
      "end": 15152.64,
      "formatted_start": "04:12:29.640",
      "formatted_end": "04:12:32.640",
      "text": "دیدیم دیگه ما خیلی برای میگیم غذا شروع کنم"
    },
    {
      "id": 28,
      "start": 15152.64,
      "end": 15154.64,
      "formatted_start": "04:12:32.640",
      "formatted_end": "04:12:34.640",
      "text": "میگه من بیسوید مادرم تو آب حاضر می کنم بشم"
    },
    {
      "id": 29,
      "start": 15154.64,
      "end": 15156.64,
      "formatted_start": "04:12:34.640",
      "formatted_end": "04:12:36.640",
      "text": "میگم این غذا هایی نشکه"
    },
    {
      "id": 30,
      "start": 15156.64,
      "end": 15158.64,
      "formatted_start": "04:12:36.640",
      "formatted_end": "04:12:38.640",
      "text": "اون باید غذایی درسته سایی بدی"
    },
    {
      "id": 31,
      "start": 15158.64,
      "end": 15160.64,
      "formatted_start": "04:12:38.640",
      "formatted_end": "04:12:40.640",
      "text": "اگه غذایی مناسب بدی از چهار ماه یکی هم میتونی"
    },
    {
      "id": 32,
      "start": 15160.64,
      "end": 15161.64,
      "formatted_start": "04:12:40.640",
      "formatted_end": "04:12:41.640",
      "text": "چی بهش بدن؟"
    },
    {
      "id": 33,
      "start": 15161.64,
      "end": 15162.64,
      "formatted_start": "04:12:41.640",
      "formatted_end": "04:12:42.640",
      "text": "خب، الان بگیم"
    },
    {
      "id": 34,
      "start": 15164.64,
      "end": 15166.64,
      "formatted_start": "04:12:44.640",
      "formatted_end": "04:12:46.640",
      "text": "خب، ببین از چی شروع میکنیم"
    },
    {
      "id": 35,
      "start": 15166.64,
      "end": 15171.64,
      "formatted_start": "04:12:46.640",
      "formatted_end": "04:12:51.640",
      "text": "الان دیگه بر خلاف قبل که میگفتم از فرنی و هیل بادو شروع میکنیم"
    },
    {
      "id": 36,
      "start": 15171.64,
      "end": 15176.64,
      "formatted_start": "04:12:51.640",
      "formatted_end": "04:12:56.640",
      "text": "الان بگن از پوره، سبزیجات و نیوه"
    },
    {
      "id": 37,
      "start": 15177.64,
      "end": 15178.64,
      "formatted_start": "04:12:57.640",
      "formatted_end": "04:12:58.640",
      "text": "خب، مثل چی؟"
    },
    {
      "id": 38,
      "start": 15178.64,
      "end": 15188.64,
      "formatted_start": "04:12:58.640",
      "formatted_end": "04:13:08.640",
      "text": "حویج، کدو حلمایی، بروکلی، نیوه هم سیف و گلافی"
    },
    {
      "id": 39,
      "start": 15188.64,
      "end": 15196.64,
      "formatted_start": "04:13:08.640",
      "formatted_end": "04:13:16.640",
      "text": "خب، همه رو میپذید، بخار پذ می کنید، برقشنگ لح می کنید، پوره می کنید، بشونید"
    },
    {
      "id": 40,
      "start": 15196.64,
      "end": 15198.64,
      "formatted_start": "04:13:16.640",
      "formatted_end": "04:13:18.640",
      "text": "یعنی هر دون جدا جدا رو بسیارید؟"
    },
    {
      "id": 41,
      "start": 15198.64,
      "end": 15202.64,
      "formatted_start": "04:13:18.640",
      "formatted_end": "04:13:22.640",
      "text": "جدا جدا، آفرین، مثلا یه روز هر روز بیدید، یه روز سیب میدید، یه روز گلابی میدید، یه روز..."
    },
    {
      "id": 42,
      "start": 15202.64,
      "end": 15206.64,
      "formatted_start": "04:13:22.640",
      "formatted_end": "04:13:26.640",
      "text": "حتی سیب و گلابی رو اولش بخار پذ کن، ببذر"
    },
    {
      "id": 43,
      "start": 15206.64,
      "end": 15208.64,
      "formatted_start": "04:13:26.640",
      "formatted_end": "04:13:28.640",
      "text": "آره، تو آبه جوش برم بزنم، بفرم"
    },
    {
      "id": 44,
      "start": 15208.64,
      "end": 15210.64,
      "formatted_start": "04:13:28.640",
      "formatted_end": "04:13:30.640",
      "text": "بخور پس کن"
    },
    {
      "id": 45,
      "start": 15210.64,
      "end": 15214.64,
      "formatted_start": "04:13:30.640",
      "formatted_end": "04:13:34.640",
      "text": "آبکش بخور و بزار زیرش آب برید که مواد قضایی شده باشه"
    },
    {
      "id": 46,
      "start": 15214.64,
      "end": 15216.64,
      "formatted_start": "04:13:34.640",
      "formatted_end": "04:13:36.640",
      "text": "بس پشت لعب می کنی بهش می دیم می خوریم"
    },
    {
      "id": 47,
      "start": 15216.64,
      "end": 15219.64,
      "formatted_start": "04:13:36.640",
      "formatted_end": "04:13:39.640",
      "text": "چند را داریم بهش؟ مثلا یه دونه سیب و دیگه چیز می کنم؟"
    },
    {
      "id": 48,
      "start": 15219.64,
      "end": 15222.64,
      "formatted_start": "04:13:39.640",
      "formatted_end": "04:13:42.640",
      "text": "یه دونه سیب که ندیگه مثلا یه برش سیب"
    },
    {
      "id": 49,
      "start": 15222.64,
      "end": 15225.64,
      "formatted_start": "04:13:42.640",
      "formatted_end": "04:13:45.640",
      "text": "خب مثلا به اندازه 3-4 تا قشوق مارا بخوایی بشه"
    },
    {
      "id": 50,
      "start": 15225.64,
      "end": 15229.64,
      "formatted_start": "04:13:45.640",
      "formatted_end": "04:13:49.640",
      "text": "بعد دیگه اگه دیگه دوست داره به اندازه خودش می خوره بشه برد"
    },
    {
      "id": 51,
      "start": 15229.64,
      "end": 15232.64,
      "formatted_start": "04:13:49.640",
      "formatted_end": "04:13:52.640",
      "text": "خب بعد 5-6 روز بعد"
    },
    {
      "id": 52,
      "start": 15232.64,
      "end": 15234.04,
      "formatted_start": "04:13:52.640",
      "formatted_end": "04:13:54.040",
      "text": "یکی دیگه"
    },
    {
      "id": 53,
      "start": 15234.04,
      "end": 15235.36,
      "formatted_start": "04:13:54.040",
      "formatted_end": "04:13:55.360",
      "text": "یه ورد پوره میدی"
    },
    {
      "id": 54,
      "start": 15235.36,
      "end": 15237.38,
      "formatted_start": "04:13:55.360",
      "formatted_end": "04:13:57.380",
      "text": "حالا یه ورد هم سوپ میدی"
    },
    {
      "id": 55,
      "start": 15237.38,
      "end": 15239.24,
      "formatted_start": "04:13:57.380",
      "formatted_end": "04:13:59.240",
      "text": "برنجو"
    },
    {
      "id": 56,
      "start": 15239.24,
      "end": 15241.18,
      "formatted_start": "04:13:59.240",
      "formatted_end": "04:14:01.180",
      "text": "حرویجو"
    },
    {
      "id": 57,
      "start": 15241.18,
      "end": 15243.28,
      "formatted_start": "04:14:01.180",
      "formatted_end": "04:14:03.280",
      "text": "سیرزمینی"
    },
    {
      "id": 58,
      "start": 15243.28,
      "end": 15245.92,
      "formatted_start": "04:14:03.280",
      "formatted_end": "04:14:05.920",
      "text": "یه دیکم گوشت و مرخ میرسی توش"
    },
    {
      "id": 59,
      "start": 15245.92,
      "end": 15248.48,
      "formatted_start": "04:14:05.920",
      "formatted_end": "04:14:08.480",
      "text": "دوباره مثلا"
    },
    {
      "id": 60,
      "start": 15248.48,
      "end": 15250.76,
      "formatted_start": "04:14:08.480",
      "formatted_end": "04:14:10.760",
      "text": "یه چند روزه بعدش"
    },
    {
      "id": 61,
      "start": 15250.76,
      "end": 15253.42,
      "formatted_start": "04:14:10.760",
      "formatted_end": "04:14:13.420",
      "text": "براش مثلا چیزای دیگه توش اضافه میکنیم"
    },
    {
      "id": 62,
      "start": 15253.42,
      "end": 15255.36,
      "formatted_start": "04:14:13.420",
      "formatted_end": "04:14:15.360",
      "text": "مثل جفری و گشنیز"
    },
    {
      "id": 63,
      "start": 15255.36,
      "end": 15258.02,
      "formatted_start": "04:14:15.360",
      "formatted_end": "04:14:18.020",
      "text": "بعد کم کم مثلا"
    },
    {
      "id": 64,
      "start": 15258.02,
      "end": 15260.38,
      "formatted_start": "04:14:18.020",
      "formatted_end": "04:14:20.380",
      "text": "کدو هرموی اضافه میکنیم"
    },
    {
      "id": 65,
      "start": 15260.38,
      "end": 15262.12,
      "formatted_start": "04:14:20.380",
      "formatted_end": "04:14:22.120",
      "text": "کدو سرخ اضافه میکنیم"
    },
    {
      "id": 66,
      "start": 15262.12,
      "end": 15264.12,
      "formatted_start": "04:14:22.120",
      "formatted_end": "04:14:24.120",
      "text": "سوپش رو متنبه میکنیم"
    },
    {
      "id": 67,
      "start": 15264.12,
      "end": 15266.12,
      "formatted_start": "04:14:24.120",
      "formatted_end": "04:14:26.120",
      "text": "دوباره 5-6 روز بعدش"
    },
    {
      "id": 68,
      "start": 15268.12,
      "end": 15270.12,
      "formatted_start": "04:14:28.120",
      "formatted_end": "04:14:30.120",
      "text": "فرنی بهش میدیم"
    },
    {
      "id": 69,
      "start": 15270.12,
      "end": 15272.12,
      "formatted_start": "04:14:30.120",
      "formatted_end": "04:14:32.120",
      "text": "یا فرندر"
    },
    {
      "id": 70,
      "start": 15272.12,
      "end": 15274.12,
      "formatted_start": "04:14:32.120",
      "formatted_end": "04:14:34.120",
      "text": "یا سرندر"
    },
    {
      "id": 71,
      "start": 15274.12,
      "end": 15276.12,
      "formatted_start": "04:14:34.120",
      "formatted_end": "04:14:36.120",
      "text": "یا سرندر بهش میدیم"
    },
    {
      "id": 72,
      "start": 15276.12,
      "end": 15278.12,
      "formatted_start": "04:14:36.120",
      "formatted_end": "04:14:38.120",
      "text": "فرنی رو با آب درستی کنیم"
    },
    {
      "id": 73,
      "start": 15278.12,
      "end": 15280.12,
      "formatted_start": "04:14:38.120",
      "formatted_end": "04:14:40.120",
      "text": "آخرش که آماده شد"
    },
    {
      "id": 74,
      "start": 15280.12,
      "end": 15282.12,
      "formatted_start": "04:14:40.120",
      "formatted_end": "04:14:42.120",
      "text": "یک کچولو میتونی شیر خود رو برده شیر توش بردی"
    },
    {
      "id": 75,
      "start": 15282.12,
      "end": 15284.12,
      "formatted_start": "04:14:42.120",
      "formatted_end": "04:14:44.120",
      "text": "یا میتونی"
    },
    {
      "id": 76,
      "start": 15284.12,
      "end": 15286.12,
      "formatted_start": "04:14:44.120",
      "formatted_end": "04:14:46.120",
      "text": "یک ذره گلابی توش رنده کنی"
    },
    {
      "id": 77,
      "start": 15286.12,
      "end": 15288.12,
      "formatted_start": "04:14:46.120",
      "formatted_end": "04:14:48.120",
      "text": "میتونی که مثلا یک کم تنبه گیره"
    },
    {
      "id": 78,
      "start": 15288.12,
      "end": 15290.12,
      "formatted_start": "04:14:48.120",
      "formatted_end": "04:14:50.120",
      "text": "متوجه شدی؟"
    },
    {
      "id": 79,
      "start": 15290.12,
      "end": 15292.12,
      "formatted_start": "04:14:50.120",
      "formatted_end": "04:14:52.120",
      "text": "این هم قضیه کنید"
    },
    {
      "id": 80,
      "start": 15292.12,
      "end": 15294.12,
      "formatted_start": "04:14:52.120",
      "formatted_end": "04:14:54.120",
      "text": "بقیه چیز هاش هم همیچی خوبه"
    },
    {
      "id": 81,
      "start": 15294.12,
      "end": 15296.12,
      "formatted_start": "04:14:54.120",
      "formatted_end": "04:14:56.120",
      "text": "سرما خیبت نداره"
    },
    {
      "id": 82,
      "start": 15296.12,
      "end": 15298.12,
      "formatted_start": "04:14:56.120",
      "formatted_end": "04:14:58.120",
      "text": "سرما خوردگی نداره"
    },
    {
      "id": 83,
      "start": 15298.12,
      "end": 15300.12,
      "formatted_start": "04:14:58.120",
      "formatted_end": "04:15:00.120",
      "text": "نه همیچی خوبه"
    }
  ],
  "status": "completed"
}