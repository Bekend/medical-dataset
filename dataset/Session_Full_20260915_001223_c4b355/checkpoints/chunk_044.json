    },
    {
      "id": 10,
      "start": 13220.0,
      "end": 13222.0,
      "formatted_start": "03:40:20.000",
      "formatted_end": "03:40:22.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 11,
      "start": 13222.0,
      "end": 13224.0,
      "formatted_start": "03:40:22.000",
      "formatted_end": "03:40:24.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 12,
      "start": 13224.0,
      "end": 13226.0,
      "formatted_start": "03:40:24.000",
      "formatted_end": "03:40:26.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 13,
      "start": 13226.0,
      "end": 13256.0,
      "formatted_start": "03:40:26.000",
      "formatted_end": "03:40:56.000",
      "text": "برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینک"
    },
    {
      "id": 14,
      "start": 13256.0,
      "end": 13265.0,
      "formatted_start": "03:40:56.000",
      "formatted_end": "03:41:05.000",
      "text": "گردنش رو مثلا اینجا می کرد خواب این حالت ایارتی می کرد ابراشو می رو با"
    },
    {
      "id": 15,
      "start": 13265.0,
      "end": 13269.0,
      "formatted_start": "03:41:05.000",
      "formatted_end": "03:41:09.000",
      "text": "الان الحمدلله گردنش خیلی راحت این بر بر اینو خودشو این بر می خوابه"
    },
    {
      "id": 16,
      "start": 13269.0,
      "end": 13273.0,
      "formatted_start": "03:41:09.000",
      "formatted_end": "03:41:13.000",
      "text": "اون در آن رو که سویم که در آن رو که این چیزم برام هم نیست"
    },
    {
      "id": 17,
      "start": 13273.0,
      "end": 13277.0,
      "formatted_start": "03:41:13.000",
      "formatted_end": "03:41:17.000",
      "text": "فقط گاهی وقت میریم گاهی وقت هم گردنش رو می کرد این حالت کجه"
    },
    {
      "id": 18,
      "start": 13277.0,
      "end": 13280.0,
      "formatted_start": "03:41:17.000",
      "formatted_end": "03:41:20.000",
      "text": "الان ماهی نشون کنم این رو من درده نمی کنم"
    },
    {
      "id": 19,
      "start": 13280.0,
      "end": 13285.0,
      "formatted_start": "03:41:20.000",
      "formatted_end": "03:41:25.000",
      "text": "مجلد در ماشا سونی گوید که این مورتان را باید برداریم"
    },
    {
      "id": 20,
      "start": 13290.0,
      "end": 13293.0,
      "formatted_start": "03:41:30.000",
      "formatted_end": "03:41:33.000",
      "text": "این مورتان را باید برداریم"
    },
    {
      "id": 21,
      "start": 13310.0,
      "end": 13328.0,
      "formatted_start": "03:41:50.000",
      "formatted_end": "03:42:08.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 13328.0,
      "end": 13358.0,
      "formatted_start": "03:42:08.000",
      "formatted_end": "03:42:38.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 23,
      "start": 13358.0,
      "end": 13361.0,
      "formatted_start": "03:42:38.000",
      "formatted_end": "03:42:41.000",
      "text": "این مال مشده؟"
    },
    {
      "id": 24,
      "start": 13361.0,
      "end": 13362.0,
      "formatted_start": "03:42:41.000",
      "formatted_end": "03:42:42.000",
      "text": "آره، آره"
    },
    {
      "id": 25,
      "start": 13362.0,
      "end": 13364.0,
      "formatted_start": "03:42:42.000",
      "formatted_end": "03:42:44.000",
      "text": "این مال برگانه"
    },
    {
      "id": 26,
      "start": 13373.0,
      "end": 13378.0,
      "formatted_start": "03:42:53.000",
      "formatted_end": "03:42:58.000",
      "text": "خانم، آیا حسینه گفتند که یه حاله تو مغشه خاله بشیه؟"
    },
    {
      "id": 27,
      "start": 13378.0,
      "end": 13380.0,
      "formatted_start": "03:42:58.000",
      "formatted_end": "03:43:00.000",
      "text": "حاله ما بشیه؟"
    },
    {
      "id": 28,
      "start": 13380.0,
      "end": 13384.0,
      "formatted_start": "03:43:00.000",
      "formatted_end": "03:43:04.000",
      "text": "نه، نه، نه، توی نوار مغشه، خب؟"
    },
    {
      "id": 29,
      "start": 13384.0,
      "end": 13391.0,
      "formatted_start": "03:43:04.000",
      "formatted_end": "03:43:11.000",
      "text": "مثلا بعضی از این چیزهایش یک کچون رفته بالا آمده"
    },
    {
      "id": 30,
      "start": 13391.0,
      "end": 13398.0,
      "formatted_start": "03:43:11.000",
      "formatted_end": "03:43:18.000",
      "text": "که این نشون دهنده اینه که شاید این سلولای مخصویش یک آس دانه تشنجششون یکم بالا است"
    },
    {
      "id": 31,
      "start": 13398.0,
      "end": 13403.0,
      "formatted_start": "03:43:18.000",
      "formatted_end": "03:43:23.000",
      "text": "خب؟ اون چیزها خیلی نگران کننده ببین"
    },
    {
      "id": 32,
      "start": 13403.0,
      "end": 13409.0,
      "formatted_start": "03:43:23.000",
      "formatted_end": "03:43:29.000",
      "text": "طلاقا برای اینکه من بچه شما رو معاینه کنم با توجه به اون چیزهایی که گفتید و این چیزهایی که من دیدم"
    },
    {
      "id": 33,
      "start": 13409.0,
      "end": 13413.0,
      "formatted_start": "03:43:29.000",
      "formatted_end": "03:43:33.000",
      "text": "ببین اولا که نوزدار مثل ماها نیست تشنجش با ماها فرق داره"
    },
    {
      "id": 34,
      "start": 13413.0,
      "end": 13422.0,
      "formatted_start": "03:43:33.000",
      "formatted_end": "03:43:42.000",
      "text": "مثلا آدم بازاری بخواد تشنروش کنه میفته بیهوش میشه دستابه های سفت میشه و تکون میخواهه و بگم میگم تشنروش"
    },
    {
      "id": 35,
      "start": 13422.0,
      "end": 13427.0,
      "formatted_start": "03:43:42.000",
      "formatted_end": "03:43:47.000",
      "text": "ولی تو بچه های کوچیک حتی یه خیره گیه چشم ممکنه تشنروش باشه"
    },
    {
      "id": 36,
      "start": 13427.0,
      "end": 13431.0,
      "formatted_start": "03:43:47.000",
      "formatted_end": "03:43:51.000",
      "text": "یه حالت اینجوری اینجوری کردن ممکنه تشنروش باشه"
    },
    {
      "id": 37,
      "start": 13431.0,
      "end": 13434.0,
      "formatted_start": "03:43:51.000",
      "formatted_end": "03:43:54.000",
      "text": "ممکنه سرش اینجوری عقب بیفته ممکنه تشنروش باشه"
    },
    {
      "id": 38,
      "start": 13434.0,
      "end": 13442.0,
      "formatted_start": "03:43:54.000",
      "formatted_end": "03:44:02.000",
      "text": "به خاطر همین توی نوزاد ببینی اصلا تب نوزادان با تب بزرگ سالان کاملا متفاهمه نوزادا زیر ایک ماه"
    },
    {
      "id": 39,
      "start": 13442.0,
      "end": 13450.0,
      "formatted_start": "03:44:02.000",
      "formatted_end": "03:44:10.000",
      "text": "به خاطر اینکه همه چیزشون با آدم و زرگا فرق داره به خاطر همین اصلا کتابی که مربوط به تب نوزادان هم باز"
    },
    {
      "id": 40,
      "start": 13450.0,
      "end": 13458.0,
      "formatted_start": "03:44:10.000",
      "formatted_end": "03:44:18.000",
      "text": "کتابی که مربوط به بقیه تب باز فرق داره خب؟ این عدید پس ما نمیتونیم شما بگید نه این چون این شکلی نشده بود"
    },
    {
      "id": 41,
      "start": 13458.0,
      "end": 13461.82,
      "formatted_start": "03:44:18.000",
      "formatted_end": "03:44:21.820",
      "text": "بود پس تشنج نبود اونا مثلا علتی گفتن تشنج ها"
    },
    {
      "id": 42,
      "start": 13461.82,
      "end": 13463.48,
      "formatted_start": "03:44:21.820",
      "formatted_end": "03:44:23.480",
      "text": "به خاطر این که اصلا فرق دارد"
    },
    {
      "id": 43,
      "start": 13463.48,
      "end": 13464.48,
      "formatted_start": "03:44:23.480",
      "formatted_end": "03:44:24.480",
      "text": "این یکی"
    },
    {
      "id": 44,
      "start": 13464.48,
      "end": 13468.68,
      "formatted_start": "03:44:24.480",
      "formatted_end": "03:44:28.680",
      "text": "دومن که بلاخره بچه شما یه سر مشکلاتی داشته"
    },
    {
      "id": 45,
      "start": 13468.68,
      "end": 13471.36,
      "formatted_start": "03:44:28.680",
      "formatted_end": "03:44:31.360",
      "text": "قندش سی و شیش بوده"
    },
    {
      "id": 46,
      "start": 13471.36,
      "end": 13473.42,
      "formatted_start": "03:44:31.360",
      "formatted_end": "03:44:33.420",
      "text": "مثلا یه بار بستری شد"
    },
    {
      "id": 47,
      "start": 13473.42,
      "end": 13474.82,
      "formatted_start": "03:44:33.420",
      "formatted_end": "03:44:34.820",
      "text": "دو بار بستری شده"
    },
    {
      "id": 48,
      "start": 13474.82,
      "end": 13476.52,
      "formatted_start": "03:44:34.820",
      "formatted_end": "03:44:36.520",
      "text": "آزمایش ها انجام شده"
    },
    {
      "id": 49,
      "start": 13476.52,
      "end": 13481.0,
      "formatted_start": "03:44:36.520",
      "formatted_end": "03:44:41.000",
      "text": "به خاطر این بررسی هایی که لازمه برای نوزاد انجام شده"
    },
    {
      "id": 50,
      "start": 13481.0,
      "end": 13482.64,
      "formatted_start": "03:44:41.000",
      "formatted_end": "03:44:42.640",
      "text": "باید هم این کار رو انجام می دادم"
    },
    {
      "id": 51,
      "start": 13482.64,
      "end": 13484.88,
      "formatted_start": "03:44:42.640",
      "formatted_end": "03:44:44.880",
      "text": "باید هم دارو شروع می کردم"
    },
    {
      "id": 52,
      "start": 13484.88,
      "end": 13489.5,
      "formatted_start": "03:44:44.880",
      "formatted_end": "03:44:49.500",
      "text": "چون اگر تشنوچ ها یه نقشی از نوزادی ادامه دار بشه"
    },
    {
      "id": 53,
      "start": 13489.5,
      "end": 13491.8,
      "formatted_start": "03:44:49.500",
      "formatted_end": "03:44:51.800",
      "text": "میتونه رو سلاله مغزش تأثیر بذاره"
    },
    {
      "id": 54,
      "start": 13491.8,
      "end": 13495.06,
      "formatted_start": "03:44:51.800",
      "formatted_end": "03:44:55.060",
      "text": "حتی تا ما اگر یک درصد هم شکل بکنیم"
    },
    {
      "id": 55,
      "start": 13495.06,
      "end": 13498.28,
      "formatted_start": "03:44:55.060",
      "formatted_end": "03:44:58.280",
      "text": "یه نوزاد تشنوچ داره دارور و راش شروع میکنیم"
    },
    {
      "id": 56,
      "start": 13498.28,
      "end": 13499.98,
      "formatted_start": "03:44:58.280",
      "formatted_end": "03:44:59.980",
      "text": "چون مغز یک نوزاد"
    }
  ],
  "status": "completed"
}