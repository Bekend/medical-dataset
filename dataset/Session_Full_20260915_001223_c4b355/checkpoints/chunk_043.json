  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12908.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:08.000",
      "text": "دیگه من که بیرون کردم باباش نبود، آن رو کرده چین رو خواست وزش کنم، گفتن تشناش کرده."
    },
    {
      "id": 1,
      "start": 12908.0,
      "end": 12916.0,
      "formatted_start": "03:35:08.000",
      "formatted_end": "03:35:16.000",
      "text": "حالات اونجا بودن، نظر من بسیار نمیتونه گریه نکنه، بسیار نمی کردن که بابا گریه نکنه، فهمدم گریه نکنه، من کاش نکنم دارم نه."
    },
    {
      "id": 2,
      "start": 12916.0,
      "end": 12926.0,
      "formatted_start": "03:35:16.000",
      "formatted_end": "03:35:26.000",
      "text": "ولی یه دفعه تیم بودن که آقا تشناش کرده، فهمدم بشه اصول تشناش بشه دارن و دیگه پرس تشناش، مثلا یه شش افت توی هستید."
    },
    {
      "id": 3,
      "start": 12926.0,
      "end": 12928.0,
      "formatted_start": "03:35:26.000",
      "formatted_end": "03:35:28.000",
      "text": "اون نرمایش ها رو انجام کرده همه چیز دارند"
    },
    {
      "id": 4,
      "start": 12928.0,
      "end": 12930.0,
      "formatted_start": "03:35:28.000",
      "formatted_end": "03:35:30.000",
      "text": "همه چیز دارند"
    },
    {
      "id": 5,
      "start": 12930.0,
      "end": 12932.0,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:32.000",
      "text": "و از اینجا فرستر برند"
    },
    {
      "id": 6,
      "start": 12932.0,
      "end": 12934.0,
      "formatted_start": "03:35:32.000",
      "formatted_end": "03:35:34.000",
      "text": "گرگان"
    },
    {
      "id": 7,
      "start": 12934.0,
      "end": 12936.0,
      "formatted_start": "03:35:34.000",
      "formatted_end": "03:35:36.000",
      "text": "اصلا گرگان حسینی با کهیه؟"
    },
    {
      "id": 8,
      "start": 12936.0,
      "end": 12938.0,
      "formatted_start": "03:35:36.000",
      "formatted_end": "03:35:38.000",
      "text": "اینی پفتیه"
    },
    {
      "id": 9,
      "start": 12938.0,
      "end": 12940.0,
      "formatted_start": "03:35:38.000",
      "formatted_end": "03:35:40.000",
      "text": "نه اصلا همه چیز بیاد"
    },
    {
      "id": 10,
      "start": 12940.0,
      "end": 12942.0,
      "formatted_start": "03:35:40.000",
      "formatted_end": "03:35:42.000",
      "text": "همه پر برنده شده"
    },
    {
      "id": 11,
      "start": 12942.0,
      "end": 12944.0,
      "formatted_start": "03:35:42.000",
      "formatted_end": "03:35:44.000",
      "text": "و اینجا اصلا حسینی برنده شده"
    },
    {
      "id": 12,
      "start": 12944.0,
      "end": 12946.0,
      "formatted_start": "03:35:44.000",
      "formatted_end": "03:35:46.000",
      "text": "اینجا حسینی برنده شده"
    },
    {
      "id": 13,
      "start": 12946.0,
      "end": 12948.0,
      "formatted_start": "03:35:46.000",
      "formatted_end": "03:35:48.000",
      "text": "این درم با"
    },
    {
      "id": 14,
      "start": 12948.0,
      "end": 12950.0,
      "formatted_start": "03:35:48.000",
      "formatted_end": "03:35:50.000",
      "text": "یک چارمک شروع شد"
    },
    {
      "id": 15,
      "start": 12950.0,
      "end": 12952.0,
      "formatted_start": "03:35:50.000",
      "formatted_end": "03:35:52.000",
      "text": "با نصف شروع شد نیست؟"
    },
    {
      "id": 16,
      "start": 12952.0,
      "end": 12954.0,
      "formatted_start": "03:35:52.000",
      "formatted_end": "03:35:54.000",
      "text": "با نصف شد"
    },
    {
      "id": 17,
      "start": 12954.0,
      "end": 12984.0,
      "formatted_start": "03:35:54.000",
      "formatted_end": "03:36:24.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 18,
      "start": 12984.0,
      "end": 12988.0,
      "formatted_start": "03:36:24.000",
      "formatted_end": "03:36:28.000",
      "text": "نوارمخ گرفت و دارو داد"
    },
    {
      "id": 19,
      "start": 12988.0,
      "end": 12993.0,
      "formatted_start": "03:36:28.000",
      "formatted_end": "03:36:33.000",
      "text": "هر دو هفته یکم اضافه میکرد یه نیم هفت اضافه میکرد"
    },
    {
      "id": 20,
      "start": 12993.0,
      "end": 12999.0,
      "formatted_start": "03:36:33.000",
      "formatted_end": "03:36:39.000",
      "text": "خلاصه ما خرده خود ما تصویب داریم به خانه مشهد"
    },
    {
      "id": 21,
      "start": 12999.0,
      "end": 13004.0,
      "formatted_start": "03:36:39.000",
      "formatted_end": "03:36:44.000",
      "text": "او گو بیاین اما استادو خودم نشان بگیم برده میشه مغزه اصلاب نوارمخ گرفت"
    },
    {
      "id": 22,
      "start": 13004.0,
      "end": 13007.0,
      "formatted_start": "03:36:44.000",
      "formatted_end": "03:36:47.000",
      "text": "و دیگه چشاش کرد که مشکل چشاشه"
    },
    {
      "id": 23,
      "start": 13007.0,
      "end": 13011.0,
      "formatted_start": "03:36:47.000",
      "formatted_end": "03:36:51.000",
      "text": "یک انگلیسی باید بگی چیز فزیشکی گفتن چشاش گفتن"
    },
    {
      "id": 24,
      "start": 13011.0,
      "end": 13018.6,
      "formatted_start": "03:36:51.000",
      "formatted_end": "03:36:58.600",
      "text": "بعد ما رو فرستاد اندرایی کردیم، نوار مغز هم گفت همیشه یک علم دا سالمه، متخصص چشم هم بود، این گفت خوبه"
    },
    {
      "id": 25,
      "start": 13018.6,
      "end": 13025.8,
      "formatted_start": "03:36:58.600",
      "formatted_end": "03:37:05.800",
      "text": "نه متخصص چه رو گفت که چشماش این حالت محنون تکامل پیدا نکرده است، چهارمه زمان نواره که تا تکامل پیدا کنند نوار کنند"
    },
    {
      "id": 26,
      "start": 13025.8,
      "end": 13030.8,
      "formatted_start": "03:37:05.800",
      "formatted_end": "03:37:10.800",
      "text": "این چیز هایی صالح نداره"
    },
    {
      "id": 27,
      "start": 13030.8,
      "end": 13034.8,
      "formatted_start": "03:37:10.800",
      "formatted_end": "03:37:14.800",
      "text": "ارتباط ششویش خوبه"
    },
    {
      "id": 28,
      "start": 13034.8,
      "end": 13038.8,
      "formatted_start": "03:37:14.800",
      "formatted_end": "03:37:18.800",
      "text": "قبل تشنج روش احساس میدم که ارتباط ششویش خیلی بهتره"
    },
    {
      "id": 29,
      "start": 13038.8,
      "end": 13042.8,
      "formatted_start": "03:37:18.800",
      "formatted_end": "03:37:22.800",
      "text": "با اینکه در دوابین وقتی زنده هایش هم صحبت میکرد نگاهش میکرد"
    },
    {
      "id": 30,
      "start": 13042.8,
      "end": 13046.8,
      "formatted_start": "03:37:22.800",
      "formatted_end": "03:37:26.800",
      "text": "بلکه همدروله ارتباط ششویش خوب"
    },
    {
      "id": 31,
      "start": 13046.8,
      "end": 13049.8,
      "formatted_start": "03:37:26.800",
      "formatted_end": "03:37:29.800",
      "text": "مثلا من که دراز کرد"
    },
    {
      "id": 32,
      "start": 13049.8,
      "end": 13051.8,
      "formatted_start": "03:37:29.800",
      "formatted_end": "03:37:31.800",
      "text": "چند وقت شاده؟"
    },
    {
      "id": 33,
      "start": 13051.8,
      "end": 13053.8,
      "formatted_start": "03:37:31.800",
      "formatted_end": "03:37:33.800",
      "text": "سه ماه و نیمه تقریبا"
    },
    {
      "id": 34,
      "start": 13053.8,
      "end": 13060.8,
      "formatted_start": "03:37:33.800",
      "formatted_end": "03:37:40.800",
      "text": "یا خورسش خانم آقای دکتر گفت که ترک کنی، کم کم ترک کنی، یک چار رو منو از پریش شبه تمام کنیم."
    },
    {
      "id": 35,
      "start": 13060.8,
      "end": 13062.8,
      "formatted_start": "03:37:40.800",
      "formatted_end": "03:37:42.800",
      "text": "نه دیشتر چی باشی نداریم"
    },
    {
      "id": 36,
      "start": 13062.8,
      "end": 13064.8,
      "formatted_start": "03:37:42.800",
      "formatted_end": "03:37:44.800",
      "text": "نه داریم نداریم"
    },
    {
      "id": 37,
      "start": 13064.8,
      "end": 13066.8,
      "formatted_start": "03:37:44.800",
      "formatted_end": "03:37:46.800",
      "text": "همان باباش مخالفه به نارده باشه"
    },
    {
      "id": 38,
      "start": 13066.8,
      "end": 13068.8,
      "formatted_start": "03:37:46.800",
      "formatted_end": "03:37:48.800",
      "text": "نه باشه"
    },
    {
      "id": 39,
      "start": 13068.8,
      "end": 13070.8,
      "formatted_start": "03:37:48.800",
      "formatted_end": "03:37:50.800",
      "text": "من بهش گفتن که با بزارین"
    },
    {
      "id": 40,
      "start": 13070.8,
      "end": 13072.8,
      "formatted_start": "03:37:50.800",
      "formatted_end": "03:37:52.800",
      "text": "حوارز دارو تمام بشه"
    },
    {
      "id": 41,
      "start": 13072.8,
      "end": 13074.8,
      "formatted_start": "03:37:52.800",
      "formatted_end": "03:37:54.800",
      "text": "بعد ما ببنیمش مثلا دکتورو بشیم"
    },
    {
      "id": 42,
      "start": 13074.8,
      "end": 13076.8,
      "formatted_start": "03:37:54.800",
      "formatted_end": "03:37:56.800",
      "text": "مثلا متخصص"
    },
    {
      "id": 43,
      "start": 13076.8,
      "end": 13078.8,
      "formatted_start": "03:37:56.800",
      "formatted_end": "03:37:58.800",
      "text": "مشهب که باشه متخصص"
    },
    {
      "id": 44,
      "start": 13078.8,
      "end": 13080.8,
      "formatted_start": "03:37:58.800",
      "formatted_end": "03:38:00.800",
      "text": "اطخال اونجا در جریان باشه"
    },
    {
      "id": 45,
      "start": 13080.8,
      "end": 13082.8,
      "formatted_start": "03:38:00.800",
      "formatted_end": "03:38:02.800",
      "text": "مثلا در ارتباط باشیم"
    },
    {
      "id": 46,
      "start": 13082.8,
      "end": 13084.8,
      "formatted_start": "03:38:02.800",
      "formatted_end": "03:38:04.800",
      "text": "اونطور که کلن الان"
    },
    {
      "id": 47,
      "start": 13084.8,
      "end": 13086.8,
      "formatted_start": "03:38:04.800",
      "formatted_end": "03:38:06.800",
      "text": "چون ماده از اینجا دسترکت داریم"
    },
    {
      "id": 48,
      "start": 13086.8,
      "end": 13088.8,
      "formatted_start": "03:38:06.800",
      "formatted_end": "03:38:08.800",
      "text": "یه گردن چکرچه"
    },
    {
      "id": 49,
      "start": 13088.8,
      "end": 13090.8,
      "formatted_start": "03:38:08.800",
      "formatted_end": "03:38:10.800",
      "text": "توی ما امروز چیز..."
    },
    {
      "id": 50,
      "start": 13090.8,
      "end": 13092.8,
      "formatted_start": "03:38:10.800",
      "formatted_end": "03:38:12.800",
      "text": "توی نیست"
    },
    {
      "id": 51,
      "start": 13092.8,
      "end": 13094.8,
      "formatted_start": "03:38:12.800",
      "formatted_end": "03:38:14.800",
      "text": "گردنش چیه؟"
    },
    {
      "id": 52,
      "start": 13094.8,
      "end": 13096.8,
      "formatted_start": "03:38:14.800",
      "formatted_end": "03:38:16.800",
      "text": "سونوگاکیگرد بود که"
    },
    {
      "id": 53,
      "start": 13096.8,
      "end": 13098.8,
      "formatted_start": "03:38:16.800",
      "formatted_end": "03:38:18.800",
      "text": "این توی یا بسکی"
    },
    {
      "id": 54,
      "start": 13098.8,
      "end": 13100.8,
      "formatted_start": "03:38:18.800",
      "formatted_end": "03:38:20.800",
      "text": "یا تاروانی"
    },
    {
      "id": 55,
      "start": 13100.8,
      "end": 13102.8,
      "formatted_start": "03:38:20.800",
      "formatted_end": "03:38:22.800",
      "text": "گردنش روی کشیدن یکی مایچه هاش شیست شده"
    },
    {
      "id": 56,
      "start": 13102.8,
      "end": 13104.8,
      "formatted_start": "03:38:22.800",
      "formatted_end": "03:38:24.800",
      "text": "اون چیزش رو داری؟ گذارش رو چی داری؟"
    },
    {
      "id": 57,
      "start": 13104.8,
      "end": 13106.8,
      "formatted_start": "03:38:24.800",
      "formatted_end": "03:38:26.800",
      "text": "چون موقعی تبلدش"
    },
    {
      "id": 58,
      "start": 13106.8,
      "end": 13108.8,
      "formatted_start": "03:38:26.800",
      "formatted_end": "03:38:28.800",
      "text": "خیلی خیلی خیلی آدم متوجه شده"
    },
    {
      "id": 59,
      "start": 13108.8,
      "end": 13110.8,
      "formatted_start": "03:38:28.800",
      "formatted_end": "03:38:30.800",
      "text": "سالم بود"
    },
    {
      "id": 60,
      "start": 13110.8,
      "end": 13112.8,
      "formatted_start": "03:38:30.800",
      "formatted_end": "03:38:32.800",
      "text": "گردنش کرده نمیدونه بزنه"
    },
    {
      "id": 61,
      "start": 13112.8,
      "end": 13114.8,
      "formatted_start": "03:38:32.800",
      "formatted_end": "03:38:34.800",
      "text": "اینو کشیدن مثلا یه مایچه یه طرفش کشیده"
    },
    {
      "id": 62,
      "start": 13114.8,
      "end": 13116.8,
      "formatted_start": "03:38:34.800",
      "formatted_end": "03:38:36.800",
      "text": "اینجا باید برم دارم"
    },
    {
      "id": 63,
      "start": 13116.8,
      "end": 13118.8,
      "formatted_start": "03:38:36.800",
      "formatted_end": "03:38:38.800",
      "text": "مثلا خوهرمونت ورد شد"
    },
    {
      "id": 64,
      "start": 13118.8,
      "end": 13122.8,
      "formatted_start": "03:38:38.800",
      "formatted_end": "03:38:42.800",
      "text": "بعد این تونه گرافی که این همون برگون برای کشیدیدی گرگان دیگر دوست دارم"
    },
    {
      "id": 65,
      "start": 13122.8,
      "end": 13124.8,
      "formatted_start": "03:38:42.800",
      "formatted_end": "03:38:44.800",
      "text": "بعد گو ببریم کاردرمان"
    },
    {
      "id": 66,
      "start": 13124.8,
      "end": 13126.8,
      "formatted_start": "03:38:44.800",
      "formatted_end": "03:38:46.800",
      "text": "اینجایی ببریم برای گردنش"
    },
    {
      "id": 67,
      "start": 13126.8,
      "end": 13128.8,
      "formatted_start": "03:38:46.800",
      "formatted_end": "03:38:48.800",
      "text": "اولی خود خانراسلی گو که اشکال نداره"
    },
    {
      "id": 68,
      "start": 13128.8,
      "end": 13130.8,
      "formatted_start": "03:38:48.800",
      "formatted_end": "03:38:50.800",
      "text": "این یه خوضه چیه خودش خوب میشه"
    },
    {
      "id": 69,
      "start": 13130.8,
      "end": 13132.8,
      "formatted_start": "03:38:50.800",
      "formatted_end": "03:38:52.800",
      "text": "برای خواهد موسیقی گو ببریم کاردرمان"
    },
    {
      "id": 70,
      "start": 13132.8,
      "end": 13134.8,
      "formatted_start": "03:38:52.800",
      "formatted_end": "03:38:54.800",
      "text": "اینجایی ببریم که خودنکردانی کش نشه"
    },
    {
      "id": 71,
      "start": 13134.8,
      "end": 13140.8,
      "formatted_start": "03:38:54.800",
      "formatted_end": "03:39:00.800",
      "text": "اینکه کش نشد. همین نگاه را هم گردنش را چک کنید و چیزایی کم کم بشین."
    },
    {
      "id": 72,
      "start": 13140.8,
      "end": 13142.8,
      "formatted_start": "03:39:00.800",
      "formatted_end": "03:39:02.800",
      "text": "من اول یک سطح آمید."
    },
    {
      "id": 73,
      "start": 13148.8,
      "end": 13154.8,
      "formatted_start": "03:39:08.800",
      "formatted_end": "03:39:14.800",
      "text": "ما دکتر های مرشد، اگر بودم تشنگیدیم، بکنیم که چیزایی چیز تشنگید میشوند."
    },
    {
      "id": 74,
      "start": 13154.8,
      "end": 13158.8,
      "formatted_start": "03:39:14.800",
      "formatted_end": "03:39:18.800",
      "text": "بکنیم که این را باید سو در انرافیل را بگیرم."
    },
    {
      "id": 75,
      "start": 13158.8,
      "end": 13160.8,
      "formatted_start": "03:39:18.800",
      "formatted_end": "03:39:20.800",
      "text": "بستری کردن و یک دوست دیگر را بکنیم."
    },
    {
      "id": 76,
      "start": 13160.8,
      "end": 13190.8,
      "formatted_start": "03:39:20.800",
      "formatted_end": "03:39:50.800",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 77,
      "start": 13190.8,
      "end": 13192.8,
      "formatted_start": "03:39:50.800",
      "formatted_end": "03:39:52.800",
      "text": "چیز بچه ها رو انگه داشتن؟"
    },
    {
      "id": 78,
      "start": 13192.8,
      "end": 13195.8,
      "formatted_start": "03:39:52.800",
      "formatted_end": "03:39:55.800",
      "text": "تو راست راهی درش تراشیدن"
    },
    {
      "id": 79,
      "start": 13195.8,
      "end": 13197.8,
      "formatted_start": "03:39:55.800",
      "formatted_end": "03:39:57.800",
      "text": "از اینجایی چیز نداشتن"
    },
    {
      "id": 80,
      "start": 13197.8,
      "end": 13199.8,
      "formatted_start": "03:39:57.800",
      "formatted_end": "03:39:59.800",
      "text": "نمیتونیم شما"
    }
  ],
  "status": "completed"
}