  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11130.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:30.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 1,
      "start": 11130.0,
      "end": 11133.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:33.000",
      "text": "او داره دعوه کنه همونم دوزی اکسیسیه"
    },
    {
      "id": 2,
      "start": 11133.0,
      "end": 11134.0,
      "formatted_start": "03:05:33.000",
      "formatted_end": "03:05:34.000",
      "text": "آره آنو دوزی"
    },
    {
      "id": 3,
      "start": 11137.0,
      "end": 11139.0,
      "formatted_start": "03:05:37.000",
      "formatted_end": "03:05:39.000",
      "text": "بساید بسیار کشت کنید بگیم"
    },
    {
      "id": 4,
      "start": 11139.0,
      "end": 11141.0,
      "formatted_start": "03:05:39.000",
      "formatted_end": "03:05:41.000",
      "text": "نه بردونم بگیم"
    },
    {
      "id": 5,
      "start": 11144.0,
      "end": 11145.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:45.000",
      "text": "سعدی دوباره"
    },
    {
      "id": 6,
      "start": 11145.0,
      "end": 11148.0,
      "formatted_start": "03:05:45.000",
      "formatted_end": "03:05:48.000",
      "text": "چی فکر میکنم که از اینه اون دوزی اون مال اون شکلشیه؟"
    },
    {
      "id": 7,
      "start": 11148.0,
      "end": 11150.0,
      "formatted_start": "03:05:48.000",
      "formatted_end": "03:05:50.000",
      "text": "ممنت جان خوبی؟"
    },
    {
      "id": 8,
      "start": 11150.0,
      "end": 11151.0,
      "formatted_start": "03:05:50.000",
      "formatted_end": "03:05:51.000",
      "text": "کاربونه"
    },
    {
      "id": 9,
      "start": 11151.0,
      "end": 11154.0,
      "formatted_start": "03:05:51.000",
      "formatted_end": "03:05:54.000",
      "text": "ممنت میخواستم بگیم جمعه چی شد برنامه؟"
    },
    {
      "id": 10,
      "start": 11155.0,
      "end": 11157.0,
      "formatted_start": "03:05:55.000",
      "formatted_end": "03:05:57.000",
      "text": "ازم چیز رو با؟"
    },
    {
      "id": 11,
      "start": 11160.0,
      "end": 11165.0,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:05.000",
      "text": "آره، جمعه خبر بده که من کلید آراوی بگیرم"
    },
    {
      "id": 12,
      "start": 11165.0,
      "end": 11168.0,
      "formatted_start": "03:06:05.000",
      "formatted_end": "03:06:08.000",
      "text": "آره، مرسی، مرسی"
    },
    {
      "id": 13,
      "start": 11168.0,
      "end": 11173.0,
      "formatted_start": "03:06:08.000",
      "formatted_end": "03:06:13.000",
      "text": "باشه، باشه، دست دردن کنم، برمونت خواهد افتراض خواهد افتراض"
    },
    {
      "id": 14,
      "start": 11173.0,
      "end": 11175.0,
      "formatted_start": "03:06:13.000",
      "formatted_end": "03:06:15.000",
      "text": "خواهد افتراض"
    },
    {
      "id": 15,
      "start": 11175.0,
      "end": 11178.0,
      "formatted_start": "03:06:15.000",
      "formatted_end": "03:06:18.000",
      "text": "خاموش ماری؟"
    },
    {
      "id": 16,
      "start": 11178.0,
      "end": 11182.0,
      "formatted_start": "03:06:18.000",
      "formatted_end": "03:06:22.000",
      "text": "خاموش ماری؟ آره، خواهد افتراض خواهد افتراض خواهد افتراض"
    },
    {
      "id": 17,
      "start": 11182.0,
      "end": 11185.0,
      "formatted_start": "03:06:22.000",
      "formatted_end": "03:06:25.000",
      "text": "کامتون همیشه که ازشون بگیر. جمعه خواهش نداری؟"
    },
    {
      "id": 18,
      "start": 11188.0,
      "end": 11189.0,
      "formatted_start": "03:06:28.000",
      "formatted_end": "03:06:29.000",
      "text": "پولی مکس؟"
    },
    {
      "id": 19,
      "start": 11189.0,
      "end": 11191.0,
      "formatted_start": "03:06:29.000",
      "formatted_end": "03:06:31.000",
      "text": "ها، پولی مکس. اون هم خواهی خوبه."
    },
    {
      "id": 20,
      "start": 11191.0,
      "end": 11194.0,
      "formatted_start": "03:06:31.000",
      "formatted_end": "03:06:34.000",
      "text": "آره، همون هم روزی یکتی بدی، گذبن."
    },
    {
      "id": 21,
      "start": 11195.0,
      "end": 11197.0,
      "formatted_start": "03:06:35.000",
      "formatted_end": "03:06:37.000",
      "text": "روزی یک بعد، روزی یک بعد."
    },
    {
      "id": 22,
      "start": 11197.0,
      "end": 11200.0,
      "formatted_start": "03:06:37.000",
      "formatted_end": "03:06:40.000",
      "text": "خواهش میکنه؟ هم تا دستران با خواهد نداری."
    },
    {
      "id": 23,
      "start": 11200.0,
      "end": 11203.0,
      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:43.000",
      "text": "اون مامان آره ها صحبت میگی در حد یکی دو دقیقه و بگو"
    },
    {
      "id": 24,
      "start": 11203.0,
      "end": 11205.0,
      "formatted_start": "03:06:43.000",
      "formatted_end": "03:06:45.000",
      "text": "مصفحه بازتن با خواهد نداری."
    },
    {
      "id": 25,
      "start": 11205.0,
      "end": 11207.0,
      "formatted_start": "03:06:45.000",
      "formatted_end": "03:06:47.000",
      "text": "آران کازمی خواهنده برمیشه"
    },
    {
      "id": 26,
      "start": 11207.0,
      "end": 11209.0,
      "formatted_start": "03:06:47.000",
      "formatted_end": "03:06:49.000",
      "text": "آران کازمی خواهنده برمیشه"
    },
    {
      "id": 27,
      "start": 11209.0,
      "end": 11211.0,
      "formatted_start": "03:06:49.000",
      "formatted_end": "03:06:51.000",
      "text": "آران کازمی خواهنده برمیشه"
    },
    {
      "id": 28,
      "start": 11211.0,
      "end": 11213.0,
      "formatted_start": "03:06:51.000",
      "formatted_end": "03:06:53.000",
      "text": "آران کازمی خواهنده برمیشه"
    },
    {
      "id": 29,
      "start": 11213.0,
      "end": 11215.0,
      "formatted_start": "03:06:53.000",
      "formatted_end": "03:06:55.000",
      "text": "یادت؟ تو یادت نیست؟"
    },
    {
      "id": 30,
      "start": 11215.0,
      "end": 11217.0,
      "formatted_start": "03:06:55.000",
      "formatted_end": "03:06:57.000",
      "text": "چرا میدونی؟"
    },
    {
      "id": 31,
      "start": 11217.0,
      "end": 11219.0,
      "formatted_start": "03:06:57.000",
      "formatted_end": "03:06:59.000",
      "text": "چرا میدونی؟"
    },
    {
      "id": 32,
      "start": 11219.0,
      "end": 11221.0,
      "formatted_start": "03:06:59.000",
      "formatted_end": "03:07:01.000",
      "text": "چرا میدونی؟"
    },
    {
      "id": 33,
      "start": 11221.0,
      "end": 11223.0,
      "formatted_start": "03:07:01.000",
      "formatted_end": "03:07:03.000",
      "text": "بچه از خودش خوش کرده"
    },
    {
      "id": 34,
