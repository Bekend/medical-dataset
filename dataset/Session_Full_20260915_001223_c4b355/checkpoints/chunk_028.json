  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8407.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:07.000",
      "text": "من از آن ترمان رو نفترم، یه بار من گرمشون، یه بار بیدم، براتشون رو."
    },
    {
      "id": 1,
      "start": 8407.0,
      "end": 8417.0,
      "formatted_start": "02:20:07.000",
      "formatted_end": "02:20:17.000",
      "text": "شوهر من دوست داشت، خیلی خیلی، من اینجوری بود، اول ماه که پیدا، ببین، تا ده هم همه رو قرض میکرد."
    },
    {
      "id": 2,
      "start": 8417.0,
      "end": 8429.0,
      "formatted_start": "02:20:17.000",
      "formatted_end": "02:20:29.000",
      "text": "بعد، از ده هم تا سی هم قرض میگرد، بعد که قرض میگرد، دوباره پولش رو میگرد، اول اونها رو میدارد، بعدش تموم میشه، اون رو با زنده قرض میدارد."
    },
    {
      "id": 3,
      "start": 8429.0,
      "end": 8435.0,
      "formatted_start": "02:20:29.000",
      "formatted_end": "02:20:35.000",
      "text": "آخرشم با یک عالم به بهی از مومبر رفت."
    },
    {
      "id": 4,
      "start": 8435.0,
      "end": 8438.0,
      "formatted_start": "02:20:35.000",
      "formatted_end": "02:20:38.000",
      "text": "همون هم آلمانه."
    },
    {
      "id": 5,
      "start": 8438.0,
      "end": 8440.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:40.000",
      "text": "اینجا شمومه."
    },
    {
      "id": 6,
      "start": 8440.0,
      "end": 8443.0,
      "formatted_start": "02:20:40.000",
      "formatted_end": "02:20:43.000",
      "text": "به خوبونش داشتن، بیاد گفتن."
    },
    {
      "id": 7,
      "start": 8443.0,
      "end": 8446.0,
      "formatted_start": "02:20:43.000",
      "formatted_end": "02:20:46.000",
      "text": "به برکاره؟"
    },
    {
      "id": 8,
      "start": 8446.0,
      "end": 8451.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:51.000",
      "text": "خیلی برکاره. به لباسپونش به برکاره، به سپر مارکت به برکاره."
    },
    {
      "id": 9,
      "start": 8451.0,
      "end": 8453.0,
      "formatted_start": "02:20:51.000",
      "formatted_end": "02:20:53.000",
      "text": "مجرده؟"
    },
    {
      "id": 10,
      "start": 8453.0,
      "end": 8456.0,
      "formatted_start": "02:20:53.000",
      "formatted_end": "02:20:56.000",
      "text": "نه، مجرده بود ولی الان مجرد."
    },
    {
      "id": 11,
      "start": 8456.0,
      "end": 8458.0,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:20:58.000",
      "text": "بخوادر همین کارایی منش رو باشه"
    },
    {
      "id": 12,
      "start": 8458.0,
      "end": 8460.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:00.000",
      "text": "بابا خوش باشه"
    },
    {
      "id": 13,
      "start": 8460.0,
      "end": 8462.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:02.000",
      "text": "بابا خوش باشه"
    },
    {
      "id": 14,
      "start": 8462.0,
      "end": 8464.0,
      "formatted_start": "02:21:02.000",
      "formatted_end": "02:21:04.000",
      "text": "یه بار من بود گنبه"
    },
    {
      "id": 15,
      "start": 8464.0,
      "end": 8467.0,
      "formatted_start": "02:21:04.000",
      "formatted_end": "02:21:07.000",
      "text": "من اینقدر دیگه خواست عمل شده بود که کسی نشان داشته دیگه"
    },
    {
      "id": 16,
      "start": 8467.0,
      "end": 8469.0,
      "formatted_start": "02:21:07.000",
      "formatted_end": "02:21:09.000",
      "text": "ماما شاید تحت برده بود"
    },
    {
      "id": 17,
      "start": 8469.0,
      "end": 8471.0,
      "formatted_start": "02:21:09.000",
      "formatted_end": "02:21:11.000",
      "text": "حالا اینشه پروپسوری بذاشته بود"
    },
    {
      "id": 18,
      "start": 8471.0,
      "end": 8474.0,
      "formatted_start": "02:21:11.000",
      "formatted_end": "02:21:14.000",
      "text": "که بابا اینکه اومد بیمار کن پیش من"
    },
    {
      "id": 19,
      "start": 8474.0,
      "end": 8476.0,
      "formatted_start": "02:21:14.000",
      "formatted_end": "02:21:16.000",
      "text": "گفتم باید بفرمایی"
    },
    {
      "id": 20,
      "start": 8476.0,
      "end": 8478.0,
      "formatted_start": "02:21:16.000",
      "formatted_end": "02:21:18.000",
      "text": "نافتگاه کارزدگی نزدم"
    },
    {
      "id": 21,
      "start": 8478.0,
      "end": 8481.0,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:21.000",
      "text": "بعد گفتم که بفرمایی"
    },
    {
      "id": 22,
      "start": 8481.0,
      "end": 8484.0,
      "formatted_start": "02:21:21.000",
      "formatted_end": "02:21:24.000",
      "text": "گفتی گه پیجا نگه بود"
    },
    {
      "id": 23,
      "start": 8484.0,
      "end": 8488.0,
      "formatted_start": "02:21:24.000",
      "formatted_end": "02:21:28.000",
      "text": "از اینجا که برنامه بود که کسی بازم بیرون گردن"
    },
    {
      "id": 24,
      "start": 8488.0,
      "end": 8492.0,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:32.000",
      "text": "من گوش باب هری توی اینجا چی کار می کنه؟"
    },
    {
      "id": 25,
      "start": 8492.0,
      "end": 8496.0,
      "formatted_start": "02:21:32.000",
      "formatted_end": "02:21:36.000",
      "text": "خیلی خیلی سخت شما نداشتون داریم"
    },
    {
      "id": 26,
      "start": 8496.0,
      "end": 8500.0,
      "formatted_start": "02:21:36.000",
      "formatted_end": "02:21:40.000",
      "text": "خب آدم به اندازه جیبش خرش کنه"
    },
    {
      "id": 27,
      "start": 8500.0,
      "end": 8504.0,
      "formatted_start": "02:21:40.000",
      "formatted_end": "02:21:44.000",
      "text": "خب ببینی بهترین قلبه رو می کنی"
    },
    {
      "id": 28,
      "start": 8504.0,
      "end": 8508.0,
      "formatted_start": "02:21:44.000",
      "formatted_end": "02:21:48.000",
      "text": "بهترین لباس دارو می پوشی؟"
    },
    {
      "id": 29,
      "start": 8508.0,
      "end": 8512.0,
      "formatted_start": "02:21:48.000",
      "formatted_end": "02:21:52.000",
      "text": "جیب خالی پوزه هایی"
    },
    {
      "id": 30,
      "start": 8512.0,
      "end": 8517.0,
      "formatted_start": "02:21:52.000",
      "formatted_end": "02:21:57.000",
      "text": "این مرشد رو باید از سالها شیشویش میکنیم"
    },
    {
      "id": 31,
      "start": 8517.0,
      "end": 8521.0,
      "formatted_start": "02:21:57.000",
      "formatted_end": "02:22:01.000",
      "text": "از سالها هر درده ی مدلی هست"
    },
    {
      "id": 32,
      "start": 8521.0,
      "end": 8523.0,
      "formatted_start": "02:22:01.000",
      "formatted_end": "02:22:03.000",
      "text": "هر درده ی مدلی لباس"
    },
    {
      "id": 33,
      "start": 8523.0,
      "end": 8526.0,
      "formatted_start": "02:22:03.000",
      "formatted_end": "02:22:06.000",
      "text": "خونه شو بود و یه قصه ها از اونور و اونور برسند"
    },
    {
      "id": 34,
      "start": 8526.0,
      "end": 8531.0,
      "formatted_start": "02:22:06.000",
      "formatted_end": "02:22:11.000",
      "text": "اصلا عادی شو نیست که مثلا میخواستش که ما فقط فیلم نامو کنیم"
    },
    {
      "id": 35,
      "start": 8531.0,
      "end": 8533.0,
      "formatted_start": "02:22:11.000",
      "formatted_end": "02:22:13.000",
      "text": "یک شب مثلا همه دیگه گشتن هست"
    },
    {
      "id": 36,
      "start": 8533.0,
      "end": 8534.0,
      "formatted_start": "02:22:13.000",
      "formatted_end": "02:22:14.000",
      "text": "بعد توپولی هم بود"
    },
    {
      "id": 37,
      "start": 8534.0,
      "end": 8536.0,
      "formatted_start": "02:22:14.000",
      "formatted_end": "02:22:16.000",
      "text": "مرگ ها تو شکر میشن و خود"
    },
    {
      "id": 38,
      "start": 8536.0,
      "end": 8539.0,
      "formatted_start": "02:22:16.000",
      "formatted_end": "02:22:19.000",
      "text": "بعد مرگ شکنپر میتونی تو سر"
    },
    {
      "id": 39,
      "start": 8539.0,
      "end": 8542.0,
      "formatted_start": "02:22:19.000",
      "formatted_end": "02:22:22.000",
      "text": "بسیار سه سه میخوامیم و میخوامیم"
    },
    {
      "id": 40,
      "start": 8543.0,
      "end": 8544.0,
      "formatted_start": "02:22:23.000",
      "formatted_end": "02:22:24.000",
      "text": "من جلی بودم"
    },
    {
      "id": 41,
      "start": 8544.0,
      "end": 8545.0,
      "formatted_start": "02:22:24.000",
      "formatted_end": "02:22:25.000",
      "text": "موچه"
    },
    {
      "id": 42,
      "start": 8546.0,
      "end": 8547.0,
      "formatted_start": "02:22:26.000",
      "formatted_end": "02:22:27.000",
      "text": "شکش دارم"
    },
    {
      "id": 43,
      "start": 8549.0,
      "end": 8550.0,
      "formatted_start": "02:22:29.000",
      "formatted_end": "02:22:30.000",
      "text": "موچه ها خیلی سیاق شدن"
    },
    {
      "id": 44,
      "start": 8550.0,
      "end": 8552.0,
      "formatted_start": "02:22:30.000",
      "formatted_end": "02:22:32.000",
      "text": "خونه ایم و همون هم هزار پریز نمیتونه"
    },
    {
      "id": 45,
      "start": 8553.0,
      "end": 8554.0,
      "formatted_start": "02:22:33.000",
      "formatted_end": "02:22:34.000",
      "text": "اول هر حال جیز نمیتونه"
    },
    {
      "id": 46,
      "start": 8558.0,
      "end": 8560.0,
      "formatted_start": "02:22:38.000",
      "formatted_end": "02:22:40.000",
      "text": "آقا یه جلی اینکه هم نیبون؟"
    },
    {
      "id": 47,
      "start": 8560.0,
      "end": 8561.0,
      "formatted_start": "02:22:40.000",
      "formatted_end": "02:22:41.000",
      "text": "نه نه"
    },
    {
      "id": 48,
      "start": 8561.0,
      "end": 8562.0,
      "formatted_start": "02:22:41.000",
      "formatted_end": "02:22:42.000",
      "text": "هم نیپر؟"
    },
    {
      "id": 49,
      "start": 8569.0,
      "end": 8571.0,
      "formatted_start": "02:22:49.000",
      "formatted_end": "02:22:51.000",
      "text": "مردم رایان را بردارید"
    },
    {
      "id": 50,
      "start": 8571.0,
      "end": 8573.0,
      "formatted_start": "02:22:51.000",
      "formatted_end": "02:22:53.000",
      "text": "مردم را بردارید"
    },
    {
      "id": 51,
      "start": 8573.0,
      "end": 8575.0,
      "formatted_start": "02:22:53.000",
      "formatted_end": "02:22:55.000",
      "text": "مردم را بردارید"
    },
    {
      "id": 52,
      "start": 8575.0,
      "end": 8577.0,
      "formatted_start": "02:22:55.000",
      "formatted_end": "02:22:57.000",
