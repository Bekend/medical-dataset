    },
    {
      "id": 75,
      "start": 8621.0,
      "end": 8623.0,
      "formatted_start": "02:23:41.000",
      "formatted_end": "02:23:43.000",
      "text": "افریم"
    },
    {
      "id": 76,
      "start": 8623.0,
      "end": 8625.0,
      "formatted_start": "02:23:43.000",
      "formatted_end": "02:23:45.000",
      "text": "افریم"
    },
    {
      "id": 77,
      "start": 8625.0,
      "end": 8628.0,
      "formatted_start": "02:23:45.000",
      "formatted_end": "02:23:48.000",
      "text": "گوشش که خوبه"
    },
    {
      "id": 78,
      "start": 8628.0,
      "end": 8632.0,
      "formatted_start": "02:23:48.000",
      "formatted_end": "02:23:52.000",
      "text": "خب تهوه نداره؟"
    },
    {
      "id": 79,
      "start": 8632.0,
      "end": 8635.0,
      "formatted_start": "02:23:52.000",
      "formatted_end": "02:23:55.000",
      "text": "در پیچه داشت یکی دو بار باید بخدن درد"
    },
    {
      "id": 80,
      "start": 8635.0,
      "end": 8637.0,
      "formatted_start": "02:23:55.000",
      "formatted_end": "02:23:57.000",
      "text": "صبح صبح نتونست بخورن؟"
    },
    {
      "id": 81,
      "start": 8637.0,
      "end": 8640.0,
      "formatted_start": "02:23:57.000",
      "formatted_end": "02:24:00.000",
      "text": "شیر خورده با یه دنو موز بهش دادم"
    },
    {
      "id": 82,
      "start": 8640.0,
      "end": 8643.0,
      "formatted_start": "02:24:00.000",
      "formatted_end": "02:24:03.000",
      "text": "خب خدایی که چیز توکنه و دینا سنگی نداره"
    },
    {
      "id": 83,
      "start": 8643.0,
      "end": 8646.0,
      "formatted_start": "02:24:03.000",
      "formatted_end": "02:24:06.000",
      "text": "اصحالش آوکی ها بود"
    },
    {
      "id": 84,
      "start": 8646.0,
      "end": 8649.0,
      "formatted_start": "02:24:06.000",
      "formatted_end": "02:24:09.000",
      "text": "توش خون و اینا نداره"
    },
    {
      "id": 85,
      "start": 8649.0,
      "end": 8652.0,
      "formatted_start": "02:24:09.000",
      "formatted_end": "02:24:12.000",
      "text": "توقع نکرده نه"
    },
    {
      "id": 86,
      "start": 8652.0,
      "end": 8657.54,
      "formatted_start": "02:24:12.000",
      "formatted_end": "02:24:17.540",
      "text": "ببینید ویروس های الان اومده ویروس های شمپ کولونا"
    },
    {
      "id": 87,
      "start": 8657.54,
      "end": 8661.36,
      "formatted_start": "02:24:17.540",
      "formatted_end": "02:24:21.360",
      "text": "هم علایه سرموکرده که میده هم علایه گبارشه"
    },
    {
      "id": 88,
      "start": 8661.36,
      "end": 8665.7,
      "formatted_start": "02:24:21.360",
      "formatted_end": "02:24:25.700",
      "text": "یعنی هم برزد بچه ها حتی تباری خیلی با لازم کنند"
    },
    {
      "id": 89,
      "start": 8665.7,
      "end": 8668.16,
      "formatted_start": "02:24:25.700",
      "formatted_end": "02:24:28.160",
      "text": "باباش هم همجوری میگه گلومه بقیه"
    },
    {
      "id": 90,
      "start": 8668.16,
      "end": 8669.28,
      "formatted_start": "02:24:28.160",
      "formatted_end": "02:24:29.280",
      "text": "صداش گرفته"
    },
    {
      "id": 91,
      "start": 8669.28,
      "end": 8670.02,
      "formatted_start": "02:24:29.280",
      "formatted_end": "02:24:30.020",
      "text": "دقیقا دقیقا"
    },
    {
      "id": 92,
      "start": 8670.02,
      "end": 8672.58,
      "formatted_start": "02:24:30.020",
      "formatted_end": "02:24:32.580",
      "text": "حالا تو بچه ها ببانششون معمولا بیشته هست"
    },
    {
      "id": 93,
      "start": 8672.58,
      "end": 8674.38,
      "formatted_start": "02:24:32.580",
      "formatted_end": "02:24:34.380",
      "text": "باباش دارو براشون میرسم"
    },
    {
      "id": 94,
      "start": 8674.38,
      "end": 8676.4,
      "formatted_start": "02:24:34.380",
      "formatted_end": "02:24:36.400",
      "text": "ببینید شده برش بده"
    },
    {
      "id": 95,
      "start": 8676.4,
      "end": 8679.58,
      "formatted_start": "02:24:36.400",
      "formatted_end": "02:24:39.580",
      "text": "کسی میشه هست به ببین که دیفنس"
    },
    {
      "id": 96,
      "start": 8679.58,
      "end": 8681.58,
      "formatted_start": "02:24:39.580",
      "formatted_end": "02:24:41.580",
      "text": "این بر سیسته میبینیشه"
    },
    {
      "id": 97,
      "start": 8681.58,
      "end": 8685.58,
      "formatted_start": "02:24:41.580",
      "formatted_end": "02:24:45.580",
      "text": "کلیت تو تایز منظر من یعنی مثلا الان تا یکی دو ماه بشه"
    },
