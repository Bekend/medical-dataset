    },
    {
      "id": 3,
      "start": 4590.0,
      "end": 4600.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:40.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 4620.0,
      "end": 4646.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:26.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 4646.0,
      "end": 4666.0,
      "formatted_start": "01:17:26.000",
      "formatted_end": "01:17:46.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 4676.0,
      "end": 4699.0,
      "formatted_start": "01:17:56.000",
      "formatted_end": "01:18:19.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 4699.0,
      "end": 4701.0,
      "formatted_start": "01:18:19.000",
      "formatted_end": "01:18:21.000",
      "text": "سلام سلام برق هست؟"
    },
    {
      "id": 8,
      "start": 4701.0,
      "end": 4702.0,
      "formatted_start": "01:18:21.000",
      "formatted_end": "01:18:22.000",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 4702.0,
      "end": 4705.0,
      "formatted_start": "01:18:22.000",
      "formatted_end": "01:18:25.000",
      "text": "آسان برق رفته"
    },
    {
      "id": 10,
      "start": 4705.0,
      "end": 4707.68,
      "formatted_start": "01:18:25.000",
      "formatted_end": "01:18:27.680",
      "text": "اوه، خب چجوری اومدی داخل؟"
    },
    {
      "id": 11,
      "start": 4707.68,
      "end": 4709.68,
      "formatted_start": "01:18:27.680",
      "formatted_end": "01:18:29.680",
      "text": "پیمون ده در این باطوره"
    },
    {
      "id": 12,
      "start": 4709.68,
      "end": 4712.68,
      "formatted_start": "01:18:29.680",
      "formatted_end": "01:18:32.680",
      "text": "نه، من قبلا رفتم بیمارستان"
    },
    {
      "id": 13,
      "start": 4712.68,
      "end": 4714.68,
      "formatted_start": "01:18:32.680",
      "formatted_end": "01:18:34.680",
      "text": "نه، فکر کردم یازده برم رفتن"
    },
    {
      "id": 14,
      "start": 4714.68,
      "end": 4716.68,
      "formatted_start": "01:18:34.680",
      "formatted_end": "01:18:36.680",
      "text": "نه، خدا شد"
    },
    {
      "id": 15,
      "start": 4716.68,
      "end": 4719.68,
      "formatted_start": "01:18:36.680",
      "formatted_end": "01:18:39.680",
      "text": "بس چه میخوریم این چیز رو برم؟"
    },
    {
      "id": 16,
      "start": 4719.68,
      "end": 4721.68,
      "formatted_start": "01:18:39.680",
      "formatted_end": "01:18:41.680",
      "text": "چه حال؟"
    },
    {
      "id": 17,
      "start": 4721.68,
      "end": 4723.68,
      "formatted_start": "01:18:41.680",
      "formatted_end": "01:18:43.680",
      "text": "نه، نه، نه، نه"
    },
    {
      "id": 18,
      "start": 4723.68,
      "end": 4725.68,
      "formatted_start": "01:18:43.680",
      "formatted_end": "01:18:45.680",
      "text": "خب؟"
    },
    {
      "id": 19,
      "start": 4725.68,
      "end": 4727.68,
      "formatted_start": "01:18:45.680",
      "formatted_end": "01:18:47.680",
      "text": "آیه، ایه، ایه"
    },
    {
      "id": 20,
      "start": 4731.68,
      "end": 4733.68,
      "formatted_start": "01:18:51.680",
      "formatted_end": "01:18:53.680",
      "text": "نه، نه، نه، نه"
    },
    {
      "id": 21,
      "start": 4733.68,
      "end": 4735.68,
      "formatted_start": "01:18:53.680",
      "formatted_end": "01:18:55.680",
      "text": "اینجا یکم شروع خواهد دارم."
    },
    {
      "id": 22,
      "start": 4735.68,
      "end": 4737.68,
      "formatted_start": "01:18:55.680",
      "formatted_end": "01:18:57.680",
      "text": "از ۲۰۰۰ تا بازشتم."
    },
    {
      "id": 23,
      "start": 4737.68,
      "end": 4739.68,
      "formatted_start": "01:18:57.680",
      "formatted_end": "01:18:59.680",
      "text": "آخرینم ۲ بازشتم."
    },
    {
      "id": 24,
      "start": 4745.68,
      "end": 4747.68,
      "formatted_start": "01:19:05.680",
      "formatted_end": "01:19:07.680",
      "text": "خورد خوبی؟"
    },
    {
      "id": 25,
      "start": 4747.68,
      "end": 4749.68,
      "formatted_start": "01:19:07.680",
      "formatted_end": "01:19:09.680",
      "text": "خوبی."
    },
    {
      "id": 26,
      "start": 4749.68,
      "end": 4751.68,
      "formatted_start": "01:19:09.680",
      "formatted_end": "01:19:11.680",
      "text": "اما اینجا یکی اومده خانمش نورگردیه"
    },
    {
      "id": 27,
      "start": 4751.68,
      "end": 4753.68,
      "formatted_start": "01:19:11.680",
      "formatted_end": "01:19:13.680",
      "text": "و یکی از خانمانان"
    },
    {
      "id": 28,
      "start": 4753.68,
      "end": 4755.68,
      "formatted_start": "01:19:13.680",
      "formatted_end": "01:19:15.680",
      "text": "به من ویدیو گرفتم."
    },
    {
      "id": 29,
      "start": 4755.68,
      "end": 4757.68,
      "formatted_start": "01:19:15.680",
      "formatted_end": "01:19:17.680",
      "text": "خودشون از با من نقضی داد."
    },
    {
      "id": 30,
      "start": 4757.68,
      "end": 4759.68,
      "formatted_start": "01:19:17.680",
      "formatted_end": "01:19:19.680",
      "text": "پس اونوقت من بازم بگم."
    },
    {
      "id": 31,
      "start": 4763.68,
      "end": 4770.0,
      "formatted_start": "01:19:23.680",
      "formatted_end": "01:19:30.000",
      "text": "دیگه حوالی نیست خدا رو شد"
    },
    {
      "id": 32,
      "start": 4770.0,
      "end": 4779.04,
      "formatted_start": "01:19:30.000",
      "formatted_end": "01:19:39.040",
      "text": "چرا چه بارون آمدید؟"
    },
    {
      "id": 33,
      "start": 4779.04,
      "end": 4781.4,
      "formatted_start": "01:19:39.040",
      "formatted_end": "01:19:41.400",
      "text": "خیلی خوب"
    },
    {
      "id": 34,
      "start": 4781.4,
      "end": 4782.24,
      "formatted_start": "01:19:41.400",
      "formatted_end": "01:19:42.240",
      "text": "خیلی خوب"
    },
    {
      "id": 35,
      "start": 4782.24,
      "end": 4782.78,
      "formatted_start": "01:19:42.240",
      "formatted_end": "01:19:42.780",
      "text": "خیلی خوب"
    },
    {
      "id": 36,
      "start": 4782.78,
      "end": 4784.78,
      "formatted_start": "01:19:42.780",
      "formatted_end": "01:19:44.780",
      "text": "خیلی خوب"
    },
    {
      "id": 37,
      "start": 4784.78,
      "end": 4786.58,
      "formatted_start": "01:19:44.780",
      "formatted_end": "01:19:46.580",
      "text": "خب"
    },
    {
      "id": 38,
      "start": 4786.58,
      "end": 4788.78,
      "formatted_start": "01:19:46.580",
      "formatted_end": "01:19:48.780",
      "text": "رای پیادرنی دوباره"
    },
    {
      "id": 39,
      "start": 4788.78,
      "end": 4790.04,
      "formatted_start": "01:19:48.780",
      "formatted_end": "01:19:50.040",
      "text": "مدیتیشن"
    },
    {
      "id": 40,
      "start": 4790.04,
      "end": 4793.14,
      "formatted_start": "01:19:50.040",
      "formatted_end": "01:19:53.140",
      "text": "سختم تو الان میرونی"
    },
    {
      "id": 41,
      "start": 4793.14,
      "end": 4800.14,
      "formatted_start": "01:19:53.140",
      "formatted_end": "01:20:00.140",
      "text": "ماما همه خوبه دستش بالا نبیره"
    }
  ],
  "status": "completed"
}