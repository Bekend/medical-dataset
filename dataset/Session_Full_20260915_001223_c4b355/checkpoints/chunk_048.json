  "stt_segments": [
    {
      "id": 0,
      "start": 14400.0,
      "end": 14402.0,
      "formatted_start": "04:00:00.000",
      "formatted_end": "04:00:02.000",
      "text": "خدا باش."
    },
    {
      "id": 1,
      "start": 14425.0,
      "end": 14427.0,
      "formatted_start": "04:00:25.000",
      "formatted_end": "04:00:27.000",
      "text": "چه دارو بشت دادی؟"
    },
    {
      "id": 2,
      "start": 14427.0,
      "end": 14432.28,
      "formatted_start": "04:00:27.000",
      "formatted_end": "04:00:32.280",
      "text": "نه نه همون که برای اون مریضش"
    },
    {
      "id": 3,
      "start": 14432.28,
      "end": 14450.28,
      "formatted_start": "04:00:32.280",
      "formatted_end": "04:00:50.280",
      "text": "چه خوشگون شدید؟"
    },
    {
      "id": 4,
      "start": 14452.28,
      "end": 14456.3,
      "formatted_start": "04:00:52.280",
      "formatted_end": "04:00:56.300",
      "text": "پازیترو یا موسیقی لب"
    },
    {
      "id": 5,
      "start": 14457.0,
      "end": 14459.0,
      "formatted_start": "04:00:57.000",
      "formatted_end": "04:00:59.000",
      "text": "نداده بودم"
    },
    {
      "id": 6,
      "start": 14459.0,
      "end": 14461.0,
      "formatted_start": "04:00:59.000",
      "formatted_end": "04:01:01.000",
      "text": "نداده بودم، آه خب"
    },
    {
      "id": 7,
      "start": 14461.0,
      "end": 14463.0,
      "formatted_start": "04:01:01.000",
      "formatted_end": "04:01:03.000",
      "text": "نمیخواستم ببینم که دادم"
    },
    {
      "id": 8,
      "start": 14463.0,
      "end": 14465.0,
      "formatted_start": "04:01:03.000",
      "formatted_end": "04:01:05.000",
      "text": "مثلا چیز خوشکنی چیزی دادم که"
    },
    {
      "id": 9,
      "start": 14465.0,
      "end": 14467.0,
      "formatted_start": "04:01:05.000",
      "formatted_end": "04:01:07.000",
      "text": "صد بشه"
    },
    {
      "id": 10,
      "start": 14467.0,
      "end": 14469.0,
      "formatted_start": "04:01:07.000",
      "formatted_end": "04:01:09.000",
      "text": "علایه مشکل"
    },
    {
      "id": 11,
      "start": 14469.0,
      "end": 14471.0,
      "formatted_start": "04:01:09.000",
      "formatted_end": "04:01:11.000",
      "text": "دلدر بده، ریفلاکس بده"
    },
    {
      "id": 12,
      "start": 14471.0,
      "end": 14473.0,
      "formatted_start": "04:01:11.000",
      "formatted_end": "04:01:13.000",
      "text": "مدهشو درد کن شبا که نمیخواده"
    },
    {
      "id": 13,
      "start": 14473.0,
      "end": 14475.0,
      "formatted_start": "04:01:13.000",
      "formatted_end": "04:01:15.000",
      "text": "ببین اگه اینجوریه"
    },
    {
      "id": 14,
      "start": 14475.0,
      "end": 14477.0,
      "formatted_start": "04:01:15.000",
      "formatted_end": "04:01:17.000",
      "text": "شاید گوششو خوند کرده باشه"
    },
    {
      "id": 15,
      "start": 14477.0,
      "end": 14479.0,
      "formatted_start": "04:01:17.000",
      "formatted_end": "04:01:19.000",
      "text": "خب"
    },
    {
      "id": 16,
      "start": 14479.0,
      "end": 14481.0,
      "formatted_start": "04:01:19.000",
      "formatted_end": "04:01:21.000",
      "text": "بهتره که من گوششو ببینم"
    },
    {
      "id": 17,
      "start": 14481.0,
      "end": 14483.0,
      "formatted_start": "04:01:21.000",
      "formatted_end": "04:01:23.000",
      "text": "یه بردی بیمارستان یه نتر گوششو بدینه"
    },
    {
      "id": 18,
      "start": 14483.0,
      "end": 14485.0,
      "formatted_start": "04:01:23.000",
      "formatted_end": "04:01:25.000",
      "text": "اگه گوشش مشکلی نده"
    },
    {
      "id": 19,
      "start": 14485.0,
      "end": 14488.0,
      "formatted_start": "04:01:25.000",
      "formatted_end": "04:01:28.000",
      "text": "شبا قبل خواب بهش فاموتیدین بدین"
    },
    {
      "id": 20,
      "start": 14488.0,
      "end": 14490.0,
      "formatted_start": "04:01:28.000",
      "formatted_end": "04:01:30.000",
      "text": "آره شبیه"
    },
    {
      "id": 21,
      "start": 14490.0,
      "end": 14493.0,
      "formatted_start": "04:01:30.000",
      "formatted_end": "04:01:33.000",
      "text": "نه دیگه زایی بدی کنو ندین خوب"
    },
    {
      "id": 22,
      "start": 14493.0,
      "end": 14496.0,
      "formatted_start": "04:01:33.000",
      "formatted_end": "04:01:36.000",
      "text": "شبا بهش فاموتیدین بدین ببین چطوری بشه"
    },
    {
      "id": 23,
      "start": 14496.0,
      "end": 14499.0,
      "formatted_start": "04:01:36.000",
      "formatted_end": "04:01:39.000",
      "text": "اگه بستر نشون توشش از من معاینه بشه"
    },
    {
      "id": 24,
      "start": 14499.0,
      "end": 14502.0,
      "formatted_start": "04:01:39.000",
      "formatted_end": "04:01:42.000",
      "text": "یک و نمی سی سی شبیه یک و نمی سی سی"
    },
    {
      "id": 25,
      "start": 14502.0,
      "end": 14506.0,
      "formatted_start": "04:01:42.000",
      "formatted_end": "04:01:46.000",
      "text": "نه نه شیر خوش کشو فلا نباز نکنی"
    },
    {
      "id": 26,
      "start": 14506.0,
      "end": 14509.0,
      "formatted_start": "04:01:46.000",
      "formatted_end": "04:01:49.000",
      "text": "آره آره آره"
    },
    {
      "id": 27,
      "start": 14509.0,
      "end": 14512.0,
      "formatted_start": "04:01:49.000",
      "formatted_end": "04:01:52.000",
      "text": "یه لحظه بوشید جانه"
    },
    {
      "id": 28,
      "start": 14512.0,
      "end": 14517.0,
      "formatted_start": "04:01:52.000",
      "formatted_end": "04:01:57.000",
      "text": "من قرار دونه ها بیرون همونطوری بدنشستم گریم"
    },
    {
      "id": 29,
      "start": 14517.0,
      "end": 14524.0,
      "formatted_start": "04:01:57.000",
      "formatted_end": "04:02:04.000",
      "text": "نه من کارم تموم شد به زنگی زنم"
    },
    {
      "id": 30,
      "start": 14524.0,
      "end": 14528.0,
      "formatted_start": "04:02:04.000",
      "formatted_end": "04:02:08.000",
      "text": "خدافص ببخشید به تموم"
    },
    {
      "id": 31,
      "start": 14532.0,
      "end": 14536.0,
      "formatted_start": "04:02:12.000",
      "formatted_end": "04:02:16.000",
      "text": "یا خونه گوشه یا دل دردشه"
    },
    {
      "id": 32,
      "start": 14536.0,
      "end": 14538.0,
      "formatted_start": "04:02:16.000",
      "formatted_end": "04:02:18.000",
      "text": "خوب آره"
    },
    {
      "id": 33,
      "start": 14542.0,
      "end": 14572.0,
      "formatted_start": "04:02:22.000",
      "formatted_end": "04:02:52.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 34,
      "start": 14572.0,
      "end": 14574.0,
      "formatted_start": "04:02:52.000",
      "formatted_end": "04:02:54.000",
      "text": "آره، آره، قربان شما؟"
    },
    {
      "id": 35,
      "start": 14574.0,
      "end": 14576.0,
      "formatted_start": "04:02:54.000",
      "formatted_end": "04:02:56.000",
      "text": "بله، بله، مشکل ندارم"
    },
    {
      "id": 36,
      "start": 14576.0,
      "end": 14578.0,
      "formatted_start": "04:02:56.000",
      "formatted_end": "04:02:58.000",
      "text": "قربان شما خدافرد"
    },
    {
      "id": 37,
      "start": 14602.0,
      "end": 14624.0,
      "formatted_start": "04:03:22.000",
      "formatted_end": "04:03:44.000",
      "text": "موسیقی"
    },
