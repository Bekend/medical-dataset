    },
    {
      "id": 6,
      "start": 180.0,
      "end": 209.98,
      "formatted_start": "00:03:00.000",
      "formatted_end": "00:03:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 7,
      "start": 210.0,
      "end": 238.0,
      "formatted_start": "00:03:30.000",
      "formatted_end": "00:03:58.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 240.0,
      "end": 246.0,
      "formatted_start": "00:04:00.000",
      "formatted_end": "00:04:06.000",
      "text": "من در شما از این اخلاقات نمیکنم"
    },
    {
      "id": 9,
      "start": 246.0,
      "end": 250.0,
      "formatted_start": "00:04:06.000",
      "formatted_end": "00:04:10.000",
      "text": "یعنی یک سنتور"
    },
    {
      "id": 10,
      "start": 250.0,
      "end": 256.0,
      "formatted_start": "00:04:10.000",
      "formatted_end": "00:04:16.000",
      "text": "اون سری سنتور میگه"
    },
    {
      "id": 11,
      "start": 256.0,
      "end": 260.0,
      "formatted_start": "00:04:16.000",
      "formatted_end": "00:04:20.000",
      "text": "چیز سندلیش"
    },
    {
      "id": 12,
      "start": 260.0,
      "end": 264.0,
      "formatted_start": "00:04:20.000",
      "formatted_end": "00:04:24.000",
      "text": "یک مردم افراد سندلی بالا بود"
    },
    {
      "id": 13,
      "start": 264.0,
      "end": 268.0,
      "formatted_start": "00:04:24.000",
      "formatted_end": "00:04:28.000",
      "text": "جای نشیمنش نشستنش"
    },
    {
      "id": 14,
      "start": 268.0,
      "end": 272.0,
      "formatted_start": "00:04:28.000",
      "formatted_end": "00:04:32.000",
      "text": "یک کارداش که اومدم، پایینه"
    },
    {
      "id": 15,
      "start": 272.0,
      "end": 281.0,
      "formatted_start": "00:04:32.000",
      "formatted_end": "00:04:41.000",
      "text": "میگم خب، میگه از وقتی من را بودم فقط از دیرست که من را بردم خب این دروز، کردی مادر ۶۰ روزنده بیدم؟"
    },
    {
      "id": 16,
      "start": 281.0,
      "end": 286.0,
      "formatted_start": "00:04:41.000",
      "formatted_end": "00:04:46.000",
      "text": "میگم من که نه ۶۰ روزنده بیدم، من را بودم کسی اینجا که اینجا بود؟"
    },
    {
      "id": 17,
      "start": 286.0,
      "end": 288.0,
      "formatted_start": "00:04:46.000",
      "formatted_end": "00:04:48.000",
      "text": "خب، میشه هایی بیدیم"
    },
    {
      "id": 18,
      "start": 288.0,
      "end": 290.0,
      "formatted_start": "00:04:48.000",
      "formatted_end": "00:04:50.000",
      "text": "کار کرده دوست داد"
    },
    {
      "id": 19,
      "start": 290.0,
      "end": 294.0,
      "formatted_start": "00:04:50.000",
      "formatted_end": "00:04:54.000",
      "text": "۶۰ روزنده بیدیم، چندتیه بودم؟"
    },
    {
      "id": 20,
      "start": 294.0,
      "end": 296.0,
      "formatted_start": "00:04:54.000",
      "formatted_end": "00:04:56.000",
      "text": "میگم شاید"
    },
    {
      "id": 21,
      "start": 296.0,
      "end": 298.0,
      "formatted_start": "00:04:56.000",
      "formatted_end": "00:04:58.000",
      "text": "شاید"
    }
  ],
  "status": "completed"
