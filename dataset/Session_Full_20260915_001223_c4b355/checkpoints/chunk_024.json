    },
    {
      "id": 43,
      "start": 7310.36,
      "end": 7312.36,
      "formatted_start": "02:01:50.360",
      "formatted_end": "02:01:52.360",
      "text": "کهوشون چکرد؟"
    },
    {
      "id": 44,
      "start": 7312.36,
      "end": 7314.36,
      "formatted_start": "02:01:52.360",
      "formatted_end": "02:01:54.360",
      "text": "کهوشون چکرد؟"
    },
    {
      "id": 45,
      "start": 7314.36,
      "end": 7316.36,
      "formatted_start": "02:01:54.360",
      "formatted_end": "02:01:56.360",
      "text": "یک ستاره های خوشگیر بده"
    },
    {
      "id": 46,
      "start": 7319.36,
      "end": 7321.36,
      "formatted_start": "02:01:59.360",
      "formatted_end": "02:02:01.360",
      "text": "ببینی کدومتو دوست داری"
    },
    {
      "id": 47,
      "start": 7321.36,
      "end": 7323.36,
      "formatted_start": "02:02:01.360",
      "formatted_end": "02:02:03.360",
      "text": "کدومتو دوست داری"
    },
    {
      "id": 48,
      "start": 7328.36,
      "end": 7330.36,
      "formatted_start": "02:02:08.360",
      "formatted_end": "02:02:10.360",
      "text": "چرنگیشو دوست داری؟"
    },
    {
      "id": 49,
      "start": 7331.36,
      "end": 7333.36,
      "formatted_start": "02:02:11.360",
      "formatted_end": "02:02:13.360",
      "text": "میخوایی همه اش مال خودت باشه؟"
    },
    {
      "id": 50,
      "start": 7333.36,
      "end": 7335.36,
      "formatted_start": "02:02:13.360",
      "formatted_end": "02:02:15.360",
      "text": "همین اش مال جاک میده"
    },
    {
      "id": 51,
      "start": 7336.36,
      "end": 7338.36,
      "formatted_start": "02:02:16.360",
      "formatted_end": "02:02:18.360",
      "text": "همه اش مال خودت باشه؟"
    },
    {
      "id": 52,
      "start": 7339.36,
      "end": 7341.36,
      "formatted_start": "02:02:19.360",
      "formatted_end": "02:02:21.360",
      "text": "آفراد جاکتر خوشگیر"
    },
    {
      "id": 53,
      "start": 7341.36,
      "end": 7343.36,
      "formatted_start": "02:02:21.360",
      "formatted_end": "02:02:23.360",
      "text": "لاله خوبه؟"
    },
    {
      "id": 54,
      "start": 7343.36,
      "end": 7345.36,
      "formatted_start": "02:02:23.360",
      "formatted_end": "02:02:25.360",
      "text": "نرم خواست به گفت نه یا"
    },
    {
      "id": 55,
      "start": 7347.36,
      "end": 7350.36,
      "formatted_start": "02:02:27.360",
      "formatted_end": "02:02:30.360",
      "text": "نه بسیار مشکلی خواست دارد با چسپندگی اروانه باشه"
    },
    {
      "id": 56,
      "start": 7350.36,
      "end": 7352.36,
      "formatted_start": "02:02:30.360",
      "formatted_end": "02:02:32.360",
      "text": "خب"
    },
    {
      "id": 57,
      "start": 7353.36,
      "end": 7355.36,
      "formatted_start": "02:02:33.360",
      "formatted_end": "02:02:35.360",
      "text": "بله سختی هست"
    },
    {
      "id": 58,
      "start": 7356.36,
      "end": 7363.36,
      "formatted_start": "02:02:36.360",
      "formatted_end": "02:02:43.360",
      "text": "نرم ممکنه هاوه اگه یک مومن فقط مونتی نبود این از چه میتونه باشه من چه کار باشم"
    },
    {
      "id": 59,
      "start": 7363.36,
      "end": 7368.36,
      "formatted_start": "02:02:43.360",
      "formatted_end": "02:02:48.360",
      "text": "باباشم میبین خب پوشت بگه چرا ازیتش میکنه با ما خودم رو کشتم این رو پوشت بگیرم"
    },
    {
      "id": 60,
      "start": 7368.36,
      "end": 7373.36,
      "formatted_start": "02:02:48.360",
      "formatted_end": "02:02:53.360",
      "text": "همه چی راحتش میده و یه سختش میکنه و یه دشونه"
    },
    {
      "id": 61,
      "start": 7373.36,
      "end": 7376.36,
      "formatted_start": "02:02:53.360",
      "formatted_end": "02:02:56.360",
      "text": "اول دلیلش باید مرد نشده"
    },
    {
      "id": 62,
      "start": 7376.36,
      "end": 7384.36,
      "formatted_start": "02:02:56.360",
      "formatted_end": "02:03:04.360",
      "text": "بچه میدونم یه ترابلی نداره بچه ترتیزه ببرش"
    },
    {
      "id": 63,
      "start": 7384.36,
      "end": 7388.36,
      "formatted_start": "02:03:04.360",
      "formatted_end": "02:03:08.360",
      "text": "طبیب نمیدونم، الکونه ببرشم و اونم که اصلا باید"
    },
    {
      "id": 64,
      "start": 7388.36,
      "end": 7390.36,
      "formatted_start": "02:03:08.360",
      "formatted_end": "02:03:10.360",
      "text": "بچه هم وقت طبیب باز بیشتر میترسه"
    },
    {
      "id": 65,
      "start": 7390.36,
      "end": 7393.36,
      "formatted_start": "02:03:10.360",
      "formatted_end": "02:03:13.360",
      "text": "نه ببین اصلا یه چیزهای علکیه ببرشم"
    },
    {
      "id": 66,
      "start": 7393.36,
      "end": 7396.36,
      "formatted_start": "02:03:13.360",
      "formatted_end": "02:03:16.360",
      "text": "خب ببین آزمایش های خونم میتونم برش بنویسم"
    },
    {
      "id": 67,
      "start": 7396.36,
      "end": 7402.36,
      "formatted_start": "02:03:16.360",
      "formatted_end": "02:03:22.360",
      "text": "از اضرارش هم میشه فهمید اگه غند شیر بره بالا باشه"
    },
    {
      "id": 68,
      "start": 7402.36,
      "end": 7404.36,
      "formatted_start": "02:03:22.360",
      "formatted_end": "02:03:24.360",
      "text": "که کار کنم خون برمیسم بعد غند شیر برمیسم"
    },
    {
      "id": 69,
      "start": 7404.36,
      "end": 7405.36,
      "formatted_start": "02:03:24.360",
      "formatted_end": "02:03:25.360",
      "text": "همچنین که فکر می کنیم برمی کنیم"
    },
    {
      "id": 70,
      "start": 7405.36,
      "end": 7406.36,
      "formatted_start": "02:03:25.360",
      "formatted_end": "02:03:26.360",
      "text": "که کار کنیم برمی کنیم"
    },
    {
      "id": 71,
      "start": 7406.36,
      "end": 7409.36,
      "formatted_start": "02:03:26.360",
      "formatted_end": "02:03:29.360",
      "text": "یعنی ممکنه غندش بالا باشه؟"
    },
    {
      "id": 72,
      "start": 7409.36,
      "end": 7411.36,
      "formatted_start": "02:03:29.360",
      "formatted_end": "02:03:31.360",
      "text": "ببین ما بچه ای کنیم دیگه"
    },
    {
      "id": 73,
      "start": 7411.36,
      "end": 7412.36,
      "formatted_start": "02:03:31.360",
      "formatted_end": "02:03:32.360",
      "text": "خب فعیده؟"
    },
    {
      "id": 74,
      "start": 7412.36,
      "end": 7416.36,
      "formatted_start": "02:03:32.360",
      "formatted_end": "02:03:36.360",
      "text": "اگه بچه غندش بالا باشه زیاد آب میخوره زیاد تشویق"
    },
    {
      "id": 75,
      "start": 7416.36,
      "end": 7417.36,
      "formatted_start": "02:03:36.360",
      "formatted_end": "02:03:37.360",
      "text": "خیلی آب میخوره خاندوستان"
    },
    {
      "id": 76,
      "start": 7417.36,
      "end": 7421.36,
      "formatted_start": "02:03:37.360",
      "formatted_end": "02:03:41.360",
      "text": "خیلی آب میخوره اصلا این توخونه ما داستانه"
    },
    {
      "id": 77,
      "start": 7421.36,
      "end": 7423.36,
      "formatted_start": "02:03:41.360",
      "formatted_end": "02:03:43.360",
      "text": "خب پتر از این روشنو میشه بگه"
    },
    {
      "id": 78,
      "start": 7423.36,
      "end": 7425.36,
      "formatted_start": "02:03:43.360",
      "formatted_end": "02:03:45.360",
      "text": "خب"
    },
    {
      "id": 79,
      "start": 7425.36,
      "end": 7427.36,
      "formatted_start": "02:03:45.360",
      "formatted_end": "02:03:47.360",
      "text": "اینو"
    },
    {
      "id": 80,
      "start": 7427.36,
      "end": 7429.36,
      "formatted_start": "02:03:47.360",
      "formatted_end": "02:03:49.360",
      "text": "بعد خاندویتو این روزن شما روش کرده"
    },
    {
      "id": 81,
      "start": 7429.36,
      "end": 7431.36,
      "formatted_start": "02:03:49.360",
      "formatted_end": "02:03:51.360",
      "text": "من این رو بود 15"
    },
    {
      "id": 82,
      "start": 7431.36,
      "end": 7433.36,
      "formatted_start": "02:03:51.360",
      "formatted_end": "02:03:53.360",
      "text": "چقدر"
    },
    {
      "id": 83,
      "start": 7433.36,
      "end": 7435.36,
      "formatted_start": "02:03:53.360",
      "formatted_end": "02:03:55.360",
      "text": "3 کیلو به دنیا آمد 27 به مهرم"
    },
    {
      "id": 84,
      "start": 7435.36,
      "end": 7437.36,
      "formatted_start": "02:03:55.360",
      "formatted_end": "02:03:57.360",
      "text": "دستانش پرون شد"
    },
    {
      "id": 85,
      "start": 7437.36,
      "end": 7439.36,
      "formatted_start": "02:03:57.360",
      "formatted_end": "02:03:59.360",
      "text": "آه"
    },
    {
      "id": 86,
      "start": 7439.36,
      "end": 7441.36,
      "formatted_start": "02:03:59.360",
      "formatted_end": "02:04:01.360",
      "text": "شیخواده خود چشم آمده نمیبین بچه نامه"
    },
    {
      "id": 87,
      "start": 7441.36,
      "end": 7445.36,
      "formatted_start": "02:04:01.360",
      "formatted_end": "02:04:05.360",
      "text": "نه خوبه بابا هم قدش بودن شده ما"
    },
    {
      "id": 88,
      "start": 7445.36,
      "end": 7448.56,
      "formatted_start": "02:04:05.360",
      "formatted_end": "02:04:08.560",
      "text": "او باید درموشته بگه توپله دیگه، باید کار برویم"
    },
    {
      "id": 89,
      "start": 7448.56,
      "end": 7450.64,
