      "start": 7286.68,
      "end": 7288.68,
      "formatted_start": "02:01:26.680",
      "formatted_end": "02:01:28.680",
      "text": "نگاه هم بکنم هجومش"
    },
    {
      "id": 33,
      "start": 7292.36,
      "end": 7294.36,
      "formatted_start": "02:01:32.360",
      "formatted_end": "02:01:34.360",
