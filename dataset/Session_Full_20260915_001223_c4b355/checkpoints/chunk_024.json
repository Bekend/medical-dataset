  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7206.68,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:06.680",
      "text": "تن تن دستشوی نمیده، مقاومت میکنه، بعد گفتن میگو افونت چیزی موقع نگرد مثل سری پیش."
    },
    {
      "id": 1,
      "start": 7206.68,
      "end": 7215.24,
      "formatted_start": "02:00:06.680",
      "formatted_end": "02:00:15.240",
      "text": "چون اصلا وقتی یه نفر یک جاچار بی اختیاری ادرا بیشه، تو هر شرایطی باید حتما از دار افونت ادرا و آزمایش قندخون چکمش."
    },
    {
      "id": 2,
      "start": 7215.24,
      "end": 7220.68,
      "formatted_start": "02:00:15.240",
      "formatted_end": "02:00:20.680",
      "text": "چون خیلی وقت از پوشک گرفتمش و اصلا یک پار من رو پیش نگردم."
    },
    {
      "id": 3,
      "start": 7220.68,
      "end": 7223.44,
      "formatted_start": "02:00:20.680",
      "formatted_end": "02:00:23.440",
      "text": "من افترسی که پیدا نکرده ایجاد نمیدونم."
    },
    {
      "id": 4,
      "start": 7223.44,
      "end": 7226.68,
      "formatted_start": "02:00:23.440",
      "formatted_end": "02:00:26.680",
      "text": "نمیدونم من کنم که ترسیده باشه یکی برای این نیمونش کنم"
    },
    {
      "id": 5,
      "start": 7226.68,
      "end": 7229.68,
      "formatted_start": "02:00:26.680",
      "formatted_end": "02:00:29.680",
      "text": "اصلا همچنین نه ترسوندید اتفاقی نیمونده"
    },
    {
      "id": 6,
      "start": 7229.68,
      "end": 7230.32,
      "formatted_start": "02:00:29.680",
      "formatted_end": "02:00:30.320",
      "text": "اتفاقی نیمونده"
    },
    {
      "id": 7,
      "start": 7230.32,
      "end": 7234.5,
      "formatted_start": "02:00:30.320",
      "formatted_end": "02:00:34.500",
      "text": "اصلا دو رفتر با هم دقا کنن یا خود نکرده ببرید توی مراسته نیمونده"
    },
    {
      "id": 8,
      "start": 7234.5,
      "end": 7234.66,
      "formatted_start": "02:00:34.500",
      "formatted_end": "02:00:34.660",
      "text": "نه نه نه"
    },
    {
      "id": 9,
      "start": 7234.66,
      "end": 7235.5,
      "formatted_start": "02:00:34.660",
      "formatted_end": "02:00:35.500",
      "text": "عذاب باشه فلا باشه"
    },
    {
      "id": 10,
      "start": 7235.5,
      "end": 7238.68,
      "formatted_start": "02:00:35.500",
      "formatted_end": "02:00:38.680",
      "text": "نه نه اصلا همچنین جایی نقابل باشه نمیبنید"
    },
    {
      "id": 11,
      "start": 7238.68,
      "end": 7240.8,
      "formatted_start": "02:00:38.680",
      "formatted_end": "02:00:40.800",
      "text": "من گیر که نمیدونم این موقع"
    },
    {
      "id": 12,
      "start": 7240.8,
      "end": 7243.46,
      "formatted_start": "02:00:40.800",
      "formatted_end": "02:00:43.460",
      "text": "حالا شون قبل از ساپه اونت ادرار داشته"
    },
    {
      "id": 13,
      "start": 7243.46,
      "end": 7245.54,
      "formatted_start": "02:00:43.460",
      "formatted_end": "02:00:45.540",
      "text": "دقیقا من باید یکی دو دقیقا مندازه بینم"
    },
    {
      "id": 14,
      "start": 7245.54,
      "end": 7248.64,
      "formatted_start": "02:00:45.540",
      "formatted_end": "02:00:48.640",
      "text": "بکنم اونه دقیقا تا این که میخوابه فقط"
    },
    {
      "id": 15,
      "start": 7248.64,
      "end": 7253.6,
      "formatted_start": "02:00:48.640",
      "formatted_end": "02:00:53.600",
      "text": "دهتو بسکو دهتو بسکو"
    },
    {
      "id": 16,
      "start": 7253.6,
      "end": 7257.32,
      "formatted_start": "02:00:53.600",
      "formatted_end": "02:00:57.320",
      "text": "آفری آفری لیا قشنگ من"
    },
    {
      "id": 17,
      "start": 7257.32,
      "end": 7259.12,
      "formatted_start": "02:00:57.320",
      "formatted_end": "02:00:59.120",
