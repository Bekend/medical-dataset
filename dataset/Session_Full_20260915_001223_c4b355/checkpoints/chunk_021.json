      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 6320.0,
      "end": 6322.0,
      "formatted_start": "01:45:20.000",
      "formatted_end": "01:45:22.000",
      "text": "باش باش"
    },
    {
      "id": 2,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "باش"
    },
    {
      "id": 3,
      "start": 6324.0,
      "end": 6326.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:26.000",
      "text": "آها"
    },
    {
      "id": 4,
      "start": 6326.0,
      "end": 6328.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:28.000",
      "text": "اشکال نداره"
    },
    {
      "id": 5,
      "start": 6328.0,
      "end": 6330.0,
      "formatted_start": "01:45:28.000",
      "formatted_end": "01:45:30.000",
      "text": "میمانه"
    },
    {
      "id": 6,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "اصلا فردا بیا دیگه"
    },
    {
      "id": 7,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "آره دیگه"
    },
    {
      "id": 8,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "الان دیگه فردا چیز نشده باشه"
    },
    {
      "id": 9,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "فردا بیا باشه"
    },
    {
      "id": 10,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "آخه"
    },
    {
      "id": 11,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "باز در زدن"
    },
    {
      "id": 12,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "برگونه خواهد نداره"
    },
    {
      "id": 13,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "خواهد نداره"
    },
    {
      "id": 14,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "من فکر کنم که مالیکه مزارش قرار داره"
    },
    {
      "id": 15,
      "start": 6348.0,
      "end": 6348.5,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:48.500",
      "text": "بله"
    },
    {
      "id": 16,
      "start": 6348.96,
      "end": 6349.46,
      "formatted_start": "01:45:48.960",
      "formatted_end": "01:45:49.460",
      "text": "چرا؟"
    },
    {
      "id": 17,
      "start": 6351.7,
      "end": 6353.7,
      "formatted_start": "01:45:51.700",
      "formatted_end": "01:45:53.700",
      "text": "بخشید با ما بگو"
    },
    {
      "id": 18,
      "start": 6354.7,
      "end": 6356.2,
      "formatted_start": "01:45:54.700",
      "formatted_end": "01:45:56.200",
      "text": "بچه همه بابا شد"
    },
    {
      "id": 19,
      "start": 6356.5,
      "end": 6358.5,
      "formatted_start": "01:45:56.500",
      "formatted_end": "01:45:58.500",
      "text": "بگیم یک بابایی جایی بچه بگو"
    },
    {
      "id": 20,
      "start": 6362.0,
      "end": 6363.3,
      "formatted_start": "01:46:02.000",
      "formatted_end": "01:46:03.300",
      "text": "تابلو اینجا"
    },
    {
      "id": 21,
      "start": 6365.8,
      "end": 6367.8,
      "formatted_start": "01:46:05.800",
      "formatted_end": "01:46:07.800",
      "text": "یا من میبنم، من نمیدونم"
    },
    {
      "id": 22,
      "start": 6368.3,
      "end": 6368.8,
      "formatted_start": "01:46:08.300",
      "formatted_end": "01:46:08.800",
      "text": "بله"
    },
    {
      "id": 23,
      "start": 6368.8,
      "end": 6370.0,
      "formatted_start": "01:46:08.800",
      "formatted_end": "01:46:10.000",
      "text": "تو تیزی"
    },
    {
      "id": 24,
      "start": 6371.0,
      "end": 6373.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:13.000",
      "text": "از خوش بادایی رو بخوره"
    },
    {
      "id": 25,
      "start": 6373.0,
      "end": 6375.0,
