      "id": 79,
      "start": 6568.0,
      "end": 6570.0,
      "formatted_start": "01:49:28.000",
      "formatted_end": "01:49:30.000",
      "text": "آب سرد میخوام"
    },
    {
      "id": 80,
      "start": 6570.0,
      "end": 6571.0,
      "formatted_start": "01:49:30.000",
      "formatted_end": "01:49:31.000",
      "text": "آب سرد میخوام"
    },
    {
      "id": 81,
      "start": 6571.0,
      "end": 6572.0,
      "formatted_start": "01:49:31.000",
      "formatted_end": "01:49:32.000",
      "text": "آخ عزیزم باش"
    },
