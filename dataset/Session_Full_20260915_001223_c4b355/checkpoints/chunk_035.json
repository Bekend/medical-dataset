    {
      "id": 90,
      "start": 10741.26,
      "end": 10743.26,
      "formatted_start": "02:59:01.260",
      "formatted_end": "02:59:03.260",
      "text": "شاید به کوشه حساسیت بگیرم"
    },
    {
      "id": 91,
      "start": 10743.26,
      "end": 10745.26,
      "formatted_start": "02:59:03.260",
      "formatted_end": "02:59:05.260",
      "text": "میدونم حساسیت دیگه"
    },
    {
      "id": 92,
      "start": 10745.26,
      "end": 10747.26,
      "formatted_start": "02:59:05.260",
      "formatted_end": "02:59:07.260",
      "text": "طبعا مایوی"
    },
    {
      "id": 93,
      "start": 10747.26,
      "end": 10749.26,
      "formatted_start": "02:59:07.260",
      "formatted_end": "02:59:09.260",
      "text": "میدونم موریت استفاده بگیرم"
    },
    {
      "id": 94,
      "start": 10749.26,
      "end": 10751.26,
      "formatted_start": "02:59:09.260",
      "formatted_end": "02:59:11.260",
      "text": "کماد چی میزنیم؟"
    },
    {
      "id": 95,
      "start": 10751.26,
      "end": 10753.26,
      "formatted_start": "02:59:11.260",
      "formatted_end": "02:59:13.260",
      "text": "شاید ماسترلا"
    },
    {
      "id": 96,
      "start": 10753.26,
      "end": 10755.26,
      "formatted_start": "02:59:13.260",
      "formatted_end": "02:59:15.260",
      "text": "نه کماد بده حساسیت بده"
    },
    {
      "id": 97,
      "start": 10755.26,
      "end": 10757.26,
      "formatted_start": "02:59:15.260",
      "formatted_end": "02:59:17.260",
      "text": "ماسترلا یه کمادیه که"
    },
    {
      "id": 98,
      "start": 10757.26,
      "end": 10759.26,
      "formatted_start": "02:59:17.260",
      "formatted_end": "02:59:19.260",
      "text": "پیشگیری کننده از کام"
    },
    {
      "id": 99,
      "start": 10759.26,
      "end": 10761.26,
      "formatted_start": "02:59:19.260",
      "formatted_end": "02:59:21.260",
      "text": "نمیسوزه یا ادرارسوزه که"
    },
    {
      "id": 100,
      "start": 10761.26,
      "end": 10763.26,
      "formatted_start": "02:59:21.260",
      "formatted_end": "02:59:23.260",
      "text": "این درصد جوش میزنه و ماسترلا جواب نمیده"
    },
    {
      "id": 101,
      "start": 10763.26,
      "end": 10765.26,
      "formatted_start": "02:59:23.260",
      "formatted_end": "02:59:25.260",
      "text": "باید ببینم کماده به تحصیل"
    },
    {
      "id": 102,
      "start": 10765.26,
      "end": 10767.26,
      "formatted_start": "02:59:25.260",
      "formatted_end": "02:59:27.260",
      "text": "اینجا"
    },
    {
      "id": 103,
      "start": 10767.26,
      "end": 10769.26,
      "formatted_start": "02:59:27.260",
      "formatted_end": "02:59:29.260",
      "text": "این سرداره خواهده"
    },
    {
      "id": 104,
      "start": 10769.26,
      "end": 10771.26,
      "formatted_start": "02:59:29.260",
      "formatted_end": "02:59:31.260",
      "text": "خواهده؟"
    },
    {
      "id": 105,
      "start": 10771.26,
      "end": 10773.26,
      "formatted_start": "02:59:31.260",
      "formatted_end": "02:59:33.260",
      "text": "این بخواهده ریفلاکسشه"
    },
    {
      "id": 106,
      "start": 10773.26,
      "end": 10775.26,
      "formatted_start": "02:59:33.260",
      "formatted_end": "02:59:35.260",
      "text": "اولا براتون میگن"
    },
    {
      "id": 107,
      "start": 10775.26,
      "end": 10777.26,
      "formatted_start": "02:59:35.260",
      "formatted_end": "02:59:37.260",
      "text": "براتون میگن"
    },
    {
      "id": 108,
      "start": 10777.26,
      "end": 10779.26,
      "formatted_start": "02:59:37.260",
      "formatted_end": "02:59:39.260",
      "text": "برای چشمه همونش"
    },
    {
      "id": 109,
      "start": 10779.26,
      "end": 10781.26,
      "formatted_start": "02:59:39.260",
      "formatted_end": "02:59:41.260",
      "text": "چشمه همون"
    },
    {
      "id": 110,
      "start": 10781.26,
      "end": 10783.26,
      "formatted_start": "02:59:41.260",
      "formatted_end": "02:59:43.260",
      "text": "3.8 کلو"
    },
    {
      "id": 111,
      "start": 10783.26,
      "end": 10785.26,
      "formatted_start": "02:59:43.260",
      "formatted_end": "02:59:45.260",
      "text": "چقدر بود داری؟"
    },
    {
      "id": 112,
      "start": 10785.26,
      "end": 10787.26,
      "formatted_start": "02:59:45.260",
      "formatted_end": "02:59:47.260",
      "text": "2.7 کلو"
    },
    {
      "id": 113,
      "start": 10787.26,
      "end": 10789.26,
      "formatted_start": "02:59:47.260",
      "formatted_end": "02:59:49.260",
      "text": "بچه معمولا موهبا"
    },
    {
      "id": 114,
      "start": 10789.26,
      "end": 10791.26,
      "formatted_start": "02:59:49.260",
      "formatted_end": "02:59:51.260",
      "text": "بعد 1 کلو اضافه کن"
    },
    {
      "id": 115,
      "start": 10791.26,
      "end": 10793.26,
      "formatted_start": "02:59:51.260",
      "formatted_end": "02:59:53.260",
      "text": "و یک کلو سر اضافه کن"
    },
    {
      "id": 116,
      "start": 10793.26,
      "end": 10799.26,
      "formatted_start": "02:59:53.260",
      "formatted_end": "02:59:59.260",
      "text": "موسیقی"
    }
