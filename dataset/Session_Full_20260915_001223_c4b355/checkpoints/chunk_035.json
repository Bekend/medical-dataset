  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10511.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:11.000",
      "text": "خب، الان آیتین دیگه چه علامتی داره بجز تن؟"
    },
    {
      "id": 1,
      "start": 10511.0,
      "end": 10513.0,
      "formatted_start": "02:55:11.000",
      "formatted_end": "02:55:13.000",
      "text": "گلو درد میکنه."
    },
    {
      "id": 2,
      "start": 10513.0,
      "end": 10515.0,
      "formatted_start": "02:55:13.000",
      "formatted_end": "02:55:15.000",
      "text": "آه، گلو درد داره."
    },
    {
      "id": 3,
      "start": 10515.0,
      "end": 10517.0,
      "formatted_start": "02:55:15.000",
      "formatted_end": "02:55:17.000",
      "text": "چون از این سیدن بود؟"
    },
    {
      "id": 4,
      "start": 10517.0,
      "end": 10519.0,
      "formatted_start": "02:55:17.000",
      "formatted_end": "02:55:19.000",
      "text": "اوه، یه از این سیدن بود."
    },
    {
      "id": 5,
      "start": 10519.0,
      "end": 10524.0,
      "formatted_start": "02:55:19.000",
      "formatted_end": "02:55:24.000",
      "text": "آه، بری آیتینه قیصنگه، آه، گلوش مادرب شده."
    },
    {
      "id": 6,
      "start": 10524.0,
      "end": 10526.0,
      "formatted_start": "02:55:24.000",
      "formatted_end": "02:55:26.000",
