  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15302.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:02.000",
      "text": "دکتر، این چیزه؟"
    },
    {
      "id": 1,
      "start": 15302.0,
      "end": 15304.0,
      "formatted_start": "04:15:02.000",
      "formatted_end": "04:15:04.000",
      "text": "خودم میتونم یه همچی بخورم؟"
    },
    {
      "id": 2,
      "start": 15304.0,
      "end": 15306.0,
      "formatted_start": "04:15:04.000",
      "formatted_end": "04:15:06.000",
      "text": "همه چیز."
    },
    {
      "id": 3,
      "start": 15306.0,
      "end": 15308.0,
      "formatted_start": "04:15:06.000",
      "formatted_end": "04:15:08.000",
      "text": "تو من طبضی، شیر، مثلا شیر ماجانو میگفتم خوبه؟"
    },
    {
      "id": 4,
      "start": 15308.0,
      "end": 15310.0,
      "formatted_start": "04:15:08.000",
      "formatted_end": "04:15:10.000",
      "text": "بخورم."
    },
    {
      "id": 5,
      "start": 15310.0,
      "end": 15314.0,
      "formatted_start": "04:15:10.000",
      "formatted_end": "04:15:14.000",
      "text": "ارنگ گرفتم، مثلا گفتم این چیزای پاستوروزره که میگیریم بجشونیم."
    },
    {
      "id": 6,
      "start": 15314.0,
      "end": 15316.0,
      "formatted_start": "04:15:14.000",
      "formatted_end": "04:15:16.000",
      "text": "پاستوروزره نمیاد."
    },
    {
      "id": 7,
      "start": 15316.0,
      "end": 15318.0,
      "formatted_start": "04:15:16.000",
      "formatted_end": "04:15:18.000",
      "text": "نمیاد نیسته؟"
    },
    {
      "id": 8,
      "start": 15318.0,
      "end": 15320.0,
      "formatted_start": "04:15:18.000",
      "formatted_end": "04:15:20.000",
      "text": "میخوای به این بدی؟"
    },
    {
      "id": 9,
      "start": 15320.0,
      "end": 15322.0,
      "formatted_start": "04:15:20.000",
      "formatted_end": "04:15:22.000",
      "text": "نه نه، خودم استفاده."
    },
    {
      "id": 10,
      "start": 15322.0,
      "end": 15324.0,
      "formatted_start": "04:15:22.000",
      "formatted_end": "04:15:24.000",
      "text": "من از این ببنم میتونم همه چیز بخورم، میبه بخورم."
    },
    {
      "id": 11,
      "start": 15324.0,
      "end": 15327.0,
      "formatted_start": "04:15:24.000",
      "formatted_end": "04:15:27.000",
      "text": "آره مگه نمی‌کردی می‌به سرسی چرا؟"
    },
    {
      "id": 12,
      "start": 15327.0,
      "end": 15329.0,
      "formatted_start": "04:15:27.000",
      "formatted_end": "04:15:29.000",
      "text": "کم خیلی خیلی"
    },
    {
      "id": 13,
      "start": 15329.0,
      "end": 15331.0,
      "formatted_start": "04:15:29.000",
      "formatted_end": "04:15:31.000",
      "text": "بخور همه چی بخور"
    },
    {
      "id": 14,
      "start": 15331.0,
      "end": 15337.0,
      "formatted_start": "04:15:31.000",
      "formatted_end": "04:15:37.000",
      "text": "و اگه باید می‌توشت مثلا آورکیه یا مثلا حالت کشداره این برای چی می‌شه؟"
    },
    {
      "id": 15,
      "start": 15337.0,
      "end": 15342.0,
      "formatted_start": "04:15:37.000",
      "formatted_end": "04:15:42.000",
      "text": "خاطر بعض دلخواست‌هایی که شما می‌کورید مکنه اینجور چشم خالی‌های بشه"
    },
    {
      "id": 16,
      "start": 15342.0,
      "end": 15345.0,
      "formatted_start": "04:15:42.000",
      "formatted_end": "04:15:45.000",
      "text": "مگه همه‌ی آدم‌ها هر روز دیگه مدرن‌مداری کنند"
    },
    {
      "id": 17,
      "start": 15345.0,
      "end": 15348.0,
      "formatted_start": "04:15:45.000",
      "formatted_end": "04:15:48.000",
      "text": "آره دیگه و این‌جای باقصنش می‌شوند"
    },
    {
      "id": 18,
      "start": 15348.0,
      "end": 15350.0,
      "formatted_start": "04:15:48.000",
      "formatted_end": "04:15:50.000",
      "text": "اصلا اصلا نشونم"
    },
    {
      "id": 19,
      "start": 15350.0,
      "end": 15352.0,
      "formatted_start": "04:15:50.000",
      "formatted_end": "04:15:52.000",
      "text": "اصلا باقی سن سه بچ بزنن"
    },
    {
      "id": 20,
      "start": 15352.0,
      "end": 15354.0,
      "formatted_start": "04:15:52.000",
      "formatted_end": "04:15:54.000",
      "text": "بزن دیگه"
    },
    {
      "id": 21,
      "start": 15354.0,
      "end": 15356.0,
      "formatted_start": "04:15:54.000",
      "formatted_end": "04:15:56.000",
      "text": "او راستی به ایرانش"
    },
    {
      "id": 22,
      "start": 15356.0,
      "end": 15358.0,
      "formatted_start": "04:15:56.000",
      "formatted_end": "04:15:58.000",
      "text": "او راستی به واقعیتنش نداشت"
    },
    {
      "id": 23,
      "start": 15358.0,
      "end": 15360.0,
      "formatted_start": "04:15:58.000",
      "formatted_end": "04:16:00.000",
      "text": "یعنی به چاشم رفتن"
    },
    {
      "id": 24,
      "start": 15360.0,
      "end": 15362.0,
      "formatted_start": "04:16:00.000",
      "formatted_end": "04:16:02.000",
      "text": "نخواهیدم"
    },
    {
      "id": 25,
      "start": 15362.0,
      "end": 15364.0,
      "formatted_start": "04:16:02.000",
      "formatted_end": "04:16:04.000",
      "text": "یه ویروس گرفته"
    },
    {
      "id": 26,
      "start": 15364.0,
      "end": 15366.0,
      "formatted_start": "04:16:04.000",
      "formatted_end": "04:16:06.000",
      "text": "بیقرار بوده"
    },
    {
      "id": 27,
      "start": 15366.0,
      "end": 15368.0,
      "formatted_start": "04:16:06.000",
      "formatted_end": "04:16:08.000",
      "text": "واقعا سیاست هالته بیقرار میکنه بعضی از بچه ها را"
    },
    {
      "id": 28,
      "start": 15368.0,
      "end": 15370.0,
      "formatted_start": "04:16:08.000",
      "formatted_end": "04:16:10.000",
      "text": "اصلا یه افتضاهی بود"
    },
    {
      "id": 29,
      "start": 15370.0,
      "end": 15372.0,
      "formatted_start": "04:16:10.000",
      "formatted_end": "04:16:12.000",
      "text": "بعدش هم دیگه اصلا"
    },
    {
      "id": 30,
      "start": 15372.0,
      "end": 15374.0,
      "formatted_start": "04:16:12.000",
      "formatted_end": "04:16:14.000",
      "text": "تیز نکرد که بیمارستان من"
    },
    {
      "id": 31,
      "start": 15374.0,
      "end": 15376.0,
      "formatted_start": "04:16:14.000",
      "formatted_end": "04:16:16.000",
      "text": "میگن بچه ایران بر احرام که کلن"
    },
    {
      "id": 32,
      "start": 15376.0,
      "end": 15379.94,
      "formatted_start": "04:16:16.000",
      "formatted_end": "04:16:19.940",
      "text": "شبه ها نه هدفشتن تا چهار صبح که بیداره مدام هم شیر میخواد"
    },
    {
      "id": 33,
      "start": 15379.94,
      "end": 15383.72,
      "formatted_start": "04:16:19.940",
      "formatted_end": "04:16:23.720",
      "text": "این من دیگه کلافه می کنم شیر خوشک هم اصلا نمیخورم"
    },
    {
      "id": 34,
      "start": 15383.72,
      "end": 15384.56,
      "formatted_start": "04:16:23.720",
      "formatted_end": "04:16:24.560",
      "text": "خوب می کنن"
    },
    {
      "id": 35,
      "start": 15384.56,
      "end": 15387.78,
      "formatted_start": "04:16:24.560",
      "formatted_end": "04:16:27.780",
      "text": "بعد دیگه به زیر دختر شیر خوشک امتحان کردن"
    },
    {
      "id": 36,
      "start": 15387.78,
      "end": 15389.1,
      "formatted_start": "04:16:27.780",
      "formatted_end": "04:16:29.100",
      "text": "به بلاکو"
    },
    {
      "id": 37,
      "start": 15389.1,
      "end": 15392.9,
      "formatted_start": "04:16:29.100",
      "formatted_end": "04:16:32.900",
      "text": "همون شیر خوشک ها رو نگه دار برید تو فرنش"
    },
    {
      "id": 38,
      "start": 15392.9,
      "end": 15395.6,
      "formatted_start": "04:16:32.900",
      "formatted_end": "04:16:35.600",
      "text": "خواهی نگه میگن بعد چهار هفته باطیز میشه که"
    },
    {
      "id": 39,
      "start": 15395.6,
      "end": 15396.52,
      "formatted_start": "04:16:35.600",
      "formatted_end": "04:16:36.520",
      "text": "اگه باز کردی"
    },
    {
      "id": 40,
      "start": 15396.52,
      "end": 15397.28,
      "formatted_start": "04:16:36.520",
      "formatted_end": "04:16:37.280",
      "text": "آره دیگه"
    },
    {
      "id": 41,
      "start": 15397.28,
      "end": 15397.78,
      "formatted_start": "04:16:37.280",
      "formatted_end": "04:16:37.780",
      "text": "آره"
    },
    {
      "id": 42,
      "start": 15397.78,
      "end": 15400.12,
      "formatted_start": "04:16:37.780",
      "formatted_end": "04:16:40.120",
      "text": "اما باز کرده و بعد از اون یه پیمان"
    },
    {
      "id": 43,
      "start": 15400.12,
      "end": 15400.62,
      "formatted_start": "04:16:40.120",
      "formatted_end": "04:16:40.620",
      "text": "خودم بخورم"
    },
    {
      "id": 44,
      "start": 15400.62,
      "end": 15402.94,
      "formatted_start": "04:16:40.620",
      "formatted_end": "04:16:42.940",
      "text": "خودت بخور بهتر از شیر ماجانکه"
    },
    {
      "id": 45,
      "start": 15402.94,
      "end": 15404.66,
      "formatted_start": "04:16:42.940",
      "formatted_end": "04:16:44.660",
      "text": "اشکال نداده این نواز شده؟"
    },
    {
      "id": 46,
      "start": 15404.66,
      "end": 15405.16,
      "formatted_start": "04:16:44.660",
      "formatted_end": "04:16:45.160",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 15405.16,
      "end": 15406.26,
      "formatted_start": "04:16:45.160",
      "formatted_end": "04:16:46.260",
      "text": "برای بچه میگن مثلا؟"
    },
    {
      "id": 48,
      "start": 15406.26,
      "end": 15407.36,
      "formatted_start": "04:16:46.260",
      "formatted_end": "04:16:47.360",
      "text": "آره خودت بخورم"
    },
    {
      "id": 49,
      "start": 15407.36,
      "end": 15409.12,
      "formatted_start": "04:16:47.360",
      "formatted_end": "04:16:49.120",
      "text": "چجوری بخورم؟ همچنین خالی خالی؟"
    },
    {
      "id": 50,
      "start": 15409.12,
      "end": 15410.22,
      "formatted_start": "04:16:49.120",
      "formatted_end": "04:16:50.220",
      "text": "خالی خالی بخورم"
    },
    {
      "id": 51,
      "start": 15410.22,
      "end": 15411.74,
      "formatted_start": "04:16:50.220",
      "formatted_end": "04:16:51.740",
      "text": "بستنی باش درست کن"
    },
    {
      "id": 52,
      "start": 15411.74,
      "end": 15413.36,
      "formatted_start": "04:16:51.740",
      "formatted_end": "04:16:53.360",
      "text": "برستوش فردی درست کن"
    },
    {
      "id": 53,
      "start": 15413.36,
      "end": 15413.88,
      "formatted_start": "04:16:53.360",
      "formatted_end": "04:16:53.880",
      "text": "اه"
    },
    {
      "id": 54,
      "start": 15413.88,
      "end": 15415.98,
      "formatted_start": "04:16:53.880",
      "formatted_end": "04:16:55.980",
      "text": "آره برای خود شیر بری درست کن"
    },
    {
      "id": 55,
      "start": 15415.98,
      "end": 15416.78,
      "formatted_start": "04:16:55.980",
      "formatted_end": "04:16:56.780",
      "text": "برستوش"
    },
    {
      "id": 56,
      "start": 15416.78,
      "end": 15417.68,
      "formatted_start": "04:16:56.780",
      "formatted_end": "04:16:57.680",
      "text": "آه میشه؟"
    },
    {
      "id": 57,
      "start": 15417.68,
      "end": 15418.18,
      "formatted_start": "04:16:57.680",
      "formatted_end": "04:16:58.180",
      "text": "آره"
    },
    {
      "id": 58,
      "start": 15418.18,
      "end": 15418.68,
      "formatted_start": "04:16:58.180",
      "formatted_end": "04:16:58.680",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 15418.68,
      "end": 15421.68,
      "formatted_start": "04:16:58.680",
      "formatted_end": "04:17:01.680",
      "text": "اینجا همینطور که یک آلمه شده همینطور که قصی ها یک باید پیمانه برداشتن"
    },
    {
      "id": 60,
      "start": 15421.68,
      "end": 15423.68,
      "formatted_start": "04:17:01.680",
      "formatted_end": "04:17:03.680",
      "text": "هستن این طاقه رو بخوره"
    },
    {
      "id": 61,
      "start": 15423.68,
      "end": 15425.68,
      "formatted_start": "04:17:03.680",
      "formatted_end": "04:17:05.680",
      "text": "خودت بخور"
    },
    {
      "id": 62,
      "start": 15425.68,
      "end": 15427.68,
      "formatted_start": "04:17:05.680",
      "formatted_end": "04:17:07.680",
      "text": "خیلی هم بکرد اسمش چه؟"
    },
    {
      "id": 63,
      "start": 15427.68,
      "end": 15428.68,
      "formatted_start": "04:17:07.680",
      "formatted_end": "04:17:08.680",
      "text": "نیلا"
    },
    {
      "id": 64,
      "start": 15428.68,
      "end": 15429.68,
      "formatted_start": "04:17:08.680",
      "formatted_end": "04:17:09.680",
      "text": "خیلی هم بکردیم"
    },
    {
      "id": 65,
      "start": 15429.68,
      "end": 15430.68,
      "formatted_start": "04:17:09.680",
      "formatted_end": "04:17:10.680",
      "text": "خیلی عزیزم"
    },
    {
      "id": 66,
      "start": 15430.68,
      "end": 15432.68,
      "formatted_start": "04:17:10.680",
      "formatted_end": "04:17:12.680",
      "text": "و ساموردیو من طبعا بهش چیز میدارین؟"
    },
    {
      "id": 67,
      "start": 15432.68,
      "end": 15434.68,
      "formatted_start": "04:17:12.680",
      "formatted_end": "04:17:14.680",
      "text": "قطعه پدیلاکو"
    },
    {
      "id": 68,
      "start": 15434.68,
      "end": 15436.68,
      "formatted_start": "04:17:14.680",
      "formatted_end": "04:17:16.680",
      "text": "فکر کن پدیلاکو برداشتن؟"
    },
    {
      "id": 69,
      "start": 15436.68,
      "end": 15438.68,
      "formatted_start": "04:17:16.680",
      "formatted_end": "04:17:18.680",
      "text": "پدیلاک تو بدمش"
    },
    {
      "id": 70,
      "start": 15438.68,
      "end": 15440.68,
      "formatted_start": "04:17:18.680",
      "formatted_end": "04:17:20.680",
      "text": "دیگه قطعه برداشت شروع کنیم"
    },
    {
      "id": 71,
      "start": 15440.68,
      "end": 15441.68,
      "formatted_start": "04:17:20.680",
      "formatted_end": "04:17:21.680",
      "text": "پدیلاکو بدم؟"
    },
    {
      "id": 72,
      "start": 15441.68,
      "end": 15443.68,
      "formatted_start": "04:17:21.680",
      "formatted_end": "04:17:23.680",
      "text": "از اینکه برای شروع کنی کمتر میده شده"
    },
    {
      "id": 73,
      "start": 15443.68,
      "end": 15445.68,
      "formatted_start": "04:17:23.680",
      "formatted_end": "04:17:25.680",
      "text": "اما خیلی بخته دیگه استفاده هم نمی کنم"
    },
    {
      "id": 74,
      "start": 15445.68,
      "end": 15447.68,
      "formatted_start": "04:17:25.680",
      "formatted_end": "04:17:27.680",
      "text": "چون تبانی شد دیگه نگرسن؟"
    },
    {
      "id": 75,
      "start": 15447.68,
      "end": 15449.68,
      "formatted_start": "04:17:27.680",
      "formatted_end": "04:17:29.680",
      "text": "نه گرسن"
    },
    {
      "id": 76,
      "start": 15449.68,
      "end": 15451.68,
      "formatted_start": "04:17:29.680",
      "formatted_end": "04:17:31.680",
      "text": "شروط بلگیری فرعونو دارم دیگه"
    },
    {
      "id": 77,
      "start": 15451.68,
      "end": 15453.68,
      "formatted_start": "04:17:31.680",
      "formatted_end": "04:17:33.680",
      "text": "گه بوداری"
    },
    {
      "id": 78,
      "start": 15453.68,
      "end": 15455.68,
      "formatted_start": "04:17:33.680",
      "formatted_end": "04:17:35.680",
      "text": "برای شروع کنی یه مادر پرو میوتیک بهش بده"
    },
    {
      "id": 79,
      "start": 15455.68,
      "end": 15457.68,
      "formatted_start": "04:17:35.680",
      "formatted_end": "04:17:37.680",
      "text": "این باعث میشه که دستگاه گوبالشش راحت تر باشه"
    },
    {
      "id": 80,
      "start": 15457.68,
      "end": 15459.68,
      "formatted_start": "04:17:37.680",
      "formatted_end": "04:17:39.680",
      "text": "چون روزی یه بار بدن بهش کافیه؟"
    },
    {
      "id": 81,
      "start": 15459.68,
      "end": 15461.68,
      "formatted_start": "04:17:39.680",
      "formatted_end": "04:17:41.680",
      "text": "روزی یه بار پونزه قطر"
    },
    {
      "id": 82,
      "start": 15461.68,
      "end": 15463.68,
      "formatted_start": "04:17:41.680",
      "formatted_end": "04:17:43.680",
      "text": "پس بینید که من رو دارم"
    },
    {
      "id": 83,
      "start": 15463.68,
      "end": 15465.68,
      "formatted_start": "04:17:43.680",
      "formatted_end": "04:17:45.680",
      "text": "از بینی چیزی که من رو دار کنه بگیرم"
    },
    {
      "id": 84,
      "start": 15465.68,
      "end": 15466.68,
      "formatted_start": "04:17:45.680",
      "formatted_end": "04:17:46.680",
      "text": "بله"
    },
    {
      "id": 85,
      "start": 15466.68,
      "end": 15470.68,
      "formatted_start": "04:17:46.680",
      "formatted_end": "04:17:50.680",
      "text": "و گاهی اوقات مخاطبینی داره با همون قطعه بینی اوکیه"
    },
    {
      "id": 86,
      "start": 15470.68,
      "end": 15471.68,
      "formatted_start": "04:17:50.680",
      "formatted_end": "04:17:51.680",
      "text": "آره"
    },
    {
      "id": 87,
      "start": 15471.68,
      "end": 15474.68,
      "formatted_start": "04:17:51.680",
      "formatted_end": "04:17:54.680",
      "text": "پس اون قطعه بینی رو چیز کنم از بیرون بگیرم دیگه"
    },
    {
      "id": 88,
      "start": 15474.68,
      "end": 15476.68,
      "formatted_start": "04:17:54.680",
      "formatted_end": "04:17:56.680",
      "text": "قطعه بینی"
    },
    {
      "id": 89,
      "start": 15476.68,
      "end": 15481.68,
      "formatted_start": "04:17:56.680",
      "formatted_end": "04:18:01.680",
      "text": "از همون رو کم در طور با برد باستنش اون بره بردش بهش بدن"
    },
    {
      "id": 90,
      "start": 15481.68,
      "end": 15482.68,
      "formatted_start": "04:18:01.680",
      "formatted_end": "04:18:02.680",
      "text": "آره"
    },
    {
      "id": 91,
      "start": 15482.68,
      "end": 15483.68,
      "formatted_start": "04:18:02.680",
      "formatted_end": "04:18:03.680",
      "text": "آره آره"
    },
    {
      "id": 92,
      "start": 15483.68,
      "end": 15485.68,
      "formatted_start": "04:18:03.680",
      "formatted_end": "04:18:05.680",
      "text": "پس باید بلیسم قطعه بینی هم بلیسم"
    },
    {
      "id": 93,
      "start": 15485.68,
      "end": 15486.68,
      "formatted_start": "04:18:05.680",
      "formatted_end": "04:18:06.680",
      "text": "آره"
    },
    {
      "id": 94,
      "start": 15486.68,
      "end": 15487.68,
      "formatted_start": "04:18:06.680",
      "formatted_end": "04:18:07.680",
      "text": "بله چیز"
    },
    {
      "id": 95,
      "start": 15487.68,
      "end": 15517.68,
      "formatted_start": "04:18:07.680",
      "formatted_end": "04:18:37.680",
      "text": "از اینجا باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که ب"
    },
    {
      "id": 96,
      "start": 15517.68,
      "end": 15523.68,
      "formatted_start": "04:18:37.680",
      "formatted_end": "04:18:43.680",
      "text": "این مرحله بچه، ببین سال اول تولد مرحله دهانیه"
    },
    {
      "id": 97,
      "start": 15523.68,
      "end": 15530.68,
      "formatted_start": "04:18:43.680",
      "formatted_end": "04:18:50.680",
      "text": "خب؟ یعنی بچه با بردن چیز رو داخل دهانش، حسه خوبی داره"
    },
    {
      "id": 98,
      "start": 15530.68,
      "end": 15531.68,
      "formatted_start": "04:18:50.680",
      "formatted_end": "04:18:51.680",
      "text": "این مرحله رو..."
    },
    {
      "id": 99,
      "start": 15531.68,
      "end": 15538.68,
      "formatted_start": "04:18:51.680",
      "formatted_end": "04:18:58.680",
      "text": "این برد می چوفه، و بعد یه بیرون که می گویندم تموم لباس من این چطور همه همه همه نیپا خورسته بچه تو برسته"
    },
    {
      "id": 100,
      "start": 15538.68,
      "end": 15541.68,
      "formatted_start": "04:18:58.680",
      "formatted_end": "04:19:01.680",
      "text": "نه، نه، ببین برست نگی نداره، و بعد به این خوبی گرفته"
    },
    {
      "id": 101,
      "start": 15541.68,
      "end": 15544.68,
      "formatted_start": "04:19:01.680",
      "formatted_end": "04:19:04.680",
      "text": "خب؟ این به خاطر اینه که..."
    },
    {
      "id": 102,
      "start": 15544.68,
      "end": 15545.68,
      "formatted_start": "04:19:04.680",
      "formatted_end": "04:19:05.680",
      "text": "چند دقیقه؟"
    },
    {
      "id": 103,
      "start": 15545.68,
      "end": 15551.16,
      "formatted_start": "04:19:05.680",
      "formatted_end": "04:19:11.160",
      "text": "بچه خوردن، مکیدن، این رو تو سال اول تولد رو دوست داره"
    },
    {
      "id": 104,
      "start": 15551.16,
      "end": 15553.16,
      "formatted_start": "04:19:11.160",
      "formatted_end": "04:19:13.160",
      "text": "همه چیز رو دوست داره تو دهنش بگاره"
    },
    {
      "id": 105,
      "start": 15553.16,
      "end": 15555.16,
      "formatted_start": "04:19:13.160",
      "formatted_end": "04:19:15.160",
      "text": "و همینطوری نزدیک گرست نشده"
    },
    {
      "id": 106,
      "start": 15555.16,
      "end": 15557.16,
      "formatted_start": "04:19:15.160",
      "formatted_end": "04:19:17.160",
      "text": "ای جون درم"
    },
    {
      "id": 107,
      "start": 15557.16,
      "end": 15560.16,
      "formatted_start": "04:19:17.160",
      "formatted_end": "04:19:20.160",
      "text": "و اگه قط زدن و ایناش هم دوتا تا چند مرخیبیه"
    },
    {
      "id": 108,
      "start": 15560.16,
      "end": 15562.16,
      "formatted_start": "04:19:20.160",
      "formatted_end": "04:19:22.160",
      "text": "باید از 5 ماهی تا 5 ماهی"
    },
    {
      "id": 109,
      "start": 15562.16,
      "end": 15564.16,
      "formatted_start": "04:19:22.160",
      "formatted_end": "04:19:24.160",
      "text": "الان وقت نمیدونن؟"
    },
    {
      "id": 110,
      "start": 15564.16,
      "end": 15566.16,
      "formatted_start": "04:19:24.160",
      "formatted_end": "04:19:26.160",
      "text": "یه کچولو فقط خودش رو برهم اینه"
    },
    {
      "id": 111,
      "start": 15566.16,
      "end": 15568.16,
      "formatted_start": "04:19:26.160",
      "formatted_end": "04:19:28.160",
      "text": "ولی قط نمیزنه"
    },
    {
      "id": 112,
      "start": 15568.16,
      "end": 15570.16,
      "formatted_start": "04:19:28.160",
      "formatted_end": "04:19:30.160",
      "text": "خب کنم آشانه نمیتونم این"
    },
    {
      "id": 113,
      "start": 15570.16,
      "end": 15572.16,
      "formatted_start": "04:19:30.160",
      "formatted_end": "04:19:32.160",
      "text": "دقیقا مامانم هم نمیگه"
    },
    {
      "id": 114,
      "start": 15572.16,
      "end": 15574.16,
      "formatted_start": "04:19:32.160",
      "formatted_end": "04:19:34.160",
      "text": "ازش اینکه تکور برداخته شما"
    },
    {
      "id": 115,
      "start": 15579.36,
      "end": 15582.64,
      "formatted_start": "04:19:39.360",
      "formatted_end": "04:19:42.640",
      "text": "نه برنامه چند دوباره اترازو همون کن بیا"
    },
    {
      "id": 116,
      "start": 15584.82,
      "end": 15585.82,
      "formatted_start": "04:19:44.820",
      "formatted_end": "04:19:45.820",
      "text": "خانه شما این؟"
    },
    {
      "id": 117,
      "start": 15585.82,
      "end": 15587.82,
      "formatted_start": "04:19:45.820",
      "formatted_end": "04:19:47.820",
      "text": "نخواهد آتران بیدید"
    },
    {
      "id": 118,
      "start": 15591.66,
      "end": 15594.66,
      "formatted_start": "04:19:51.660",
      "formatted_end": "04:19:54.660",
      "text": "نخواهد آتران بیدید، سه سفت دوباره اترازو بیا"
    },
    {
      "id": 119,
      "start": 15596.08,
      "end": 15598.08,
      "formatted_start": "04:19:56.080",
      "formatted_end": "04:19:58.080",
      "text": "مخلب نشست شما"
    },
    {
      "id": 120,
      "start": 15598.08,
      "end": 15600.08,
      "formatted_start": "04:19:58.080",
      "formatted_end": "04:20:00.080",
      "text": "به پایان راستی دانه بده"
    }
  ],
  "status": "completed"
}