  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14102.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:02.000",
      "text": "این ها توی درش معاین من نرم سوشه."
    },
    {
      "id": 1,
      "start": 14102.0,
      "end": 14106.0,
      "formatted_start": "03:55:02.000",
      "formatted_end": "03:55:06.000",
      "text": "نه، عزیزمانه، نه، این هاش طبیعیه."
    },
    {
      "id": 2,
      "start": 14108.0,
      "end": 14110.0,
      "formatted_start": "03:55:08.000",
      "formatted_end": "03:55:10.000",
      "text": "شیر خودتو بدی آن."
    },
    {
      "id": 3,
      "start": 14110.0,
      "end": 14115.0,
      "formatted_start": "03:55:10.000",
      "formatted_end": "03:55:15.000",
      "text": "نه، شیر خود من اینو مکنم، بکنم، بعد درمیانم، اون شیر چرم بکنم."
    },
    {
      "id": 4,
      "start": 14115.0,
      "end": 14118.0,
      "formatted_start": "03:55:15.000",
      "formatted_end": "03:55:18.000",
      "text": "گاهی از درمتی صرف مکنه، نمیمون، گاهی ببین مکنه."
    },
    {
      "id": 5,
      "start": 14118.0,
      "end": 14120.0,
      "formatted_start": "03:55:18.000",
      "formatted_end": "03:55:20.000",
      "text": "آره، اون است شیر مادر."
    },
    {
      "id": 6,
      "start": 14120.0,
      "end": 14121.0,
      "formatted_start": "03:55:20.000",
      "formatted_end": "03:55:21.000",
      "text": "خوب؟"
    },
    {
      "id": 7,
      "start": 14121.0,
      "end": 14151.0,
      "formatted_start": "03:55:21.000",
      "formatted_end": "03:55:51.000",
      "text": "آره اون یه ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای ای"
    },
    {
      "id": 8,
      "start": 14151.0,
      "end": 14153.0,
      "formatted_start": "03:55:51.000",
      "formatted_end": "03:55:53.000",
      "text": "این روزه یک در اینجا میفرکنم شما در این پشت"
    },
    {
      "id": 9,
      "start": 14153.0,
      "end": 14155.0,
      "formatted_start": "03:55:53.000",
      "formatted_end": "03:55:55.000",
      "text": "روزه یک در اینجا"
    },
    {
      "id": 10,
      "start": 14157.0,
      "end": 14159.0,
      "formatted_start": "03:55:57.000",
      "formatted_end": "03:55:59.000",
      "text": "این برای تکامل ورزش خیلی خوبه"
    },
    {
      "id": 11,
      "start": 14159.0,
      "end": 14161.0,
      "formatted_start": "03:55:59.000",
      "formatted_end": "03:56:01.000",
      "text": "باید فرق نیم کنید"
    },
    {
      "id": 12,
      "start": 14161.0,
      "end": 14163.0,
      "formatted_start": "03:56:01.000",
      "formatted_end": "03:56:03.000",
      "text": "چه ساعتی بشویدیم"
    },
    {
      "id": 13,
      "start": 14163.0,
      "end": 14165.0,
      "formatted_start": "03:56:03.000",
      "formatted_end": "03:56:05.000",
      "text": "نه"
    },
    {
      "id": 14,
      "start": 14165.0,
      "end": 14167.0,
      "formatted_start": "03:56:05.000",
      "formatted_end": "03:56:07.000",
      "text": "آده رو نه"
    },
    {
      "id": 15,
      "start": 14167.0,
      "end": 14169.0,
      "formatted_start": "03:56:07.000",
      "formatted_end": "03:56:09.000",
      "text": "همه ماه رو دوست داشتیم بهش بودیم"
    },
    {
      "id": 16,
      "start": 14169.0,
      "end": 14171.0,
      "formatted_start": "03:56:09.000",
      "formatted_end": "03:56:11.000",
      "text": "این آده خارجی نگهرسی"
    },
    {
      "id": 17,
      "start": 14171.0,
      "end": 14173.0,
      "formatted_start": "03:56:11.000",
      "formatted_end": "03:56:13.000",
      "text": "اون رو فرق استخدام نکنیم"
    },
    {
      "id": 18,
      "start": 14173.0,
      "end": 14175.0,
      "formatted_start": "03:56:13.000",
      "formatted_end": "03:56:15.000",
      "text": "همین آده رو راست بسازیم"
    },
    {
      "id": 19,
      "start": 14175.0,
      "end": 14177.0,
      "formatted_start": "03:56:15.000",
      "formatted_end": "03:56:17.000",
      "text": "باید یک فرق رو بشیم"
    },
    {
      "id": 20,
      "start": 14177.0,
      "end": 14179.0,
      "formatted_start": "03:56:17.000",
      "formatted_end": "03:56:19.000",
      "text": "چند ماه رو استخدمونه"
    },
    {
      "id": 21,
      "start": 14179.0,
      "end": 14180.0,
      "formatted_start": "03:56:19.000",
      "formatted_end": "03:56:20.000",
      "text": "تا شش ماهی ساپنیم"
    },
    {
      "id": 22,
      "start": 14180.0,
      "end": 14181.66,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:21.660",
      "text": "شش ماهی که درستو بگیرم گرم"
    },
    {
      "id": 23,
      "start": 14181.66,
      "end": 14183.0,
      "formatted_start": "03:56:21.660",
      "formatted_end": "03:56:23.000",
      "text": "آه، درستو بگیرم"
    },
    {
      "id": 24,
      "start": 14183.0,
      "end": 14184.0,
      "formatted_start": "03:56:23.000",
      "formatted_end": "03:56:24.000",
      "text": "شش ماهی درستو بگیرم"
    },
    {
      "id": 25,
      "start": 14184.0,
      "end": 14184.5,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:24.500",
      "text": "نه، درستو بگیرم"
    },
    {
      "id": 26,
      "start": 14184.5,
      "end": 14185.5,
      "formatted_start": "03:56:24.500",
      "formatted_end": "03:56:25.500",
      "text": "اشاله که"
    },
    {
      "id": 27,
      "start": 14185.5,
      "end": 14186.5,
      "formatted_start": "03:56:25.500",
      "formatted_end": "03:56:26.500",
      "text": "بله، درستو دارم"
    },
    {
      "id": 28,
      "start": 14186.5,
      "end": 14188.5,
      "formatted_start": "03:56:26.500",
      "formatted_end": "03:56:28.500",
      "text": "روز به روز بهتر میشه"
    },
    {
      "id": 29,
      "start": 14188.5,
      "end": 14191.0,
      "formatted_start": "03:56:28.500",
      "formatted_end": "03:56:31.000",
      "text": "دیگه قشنگ اینقدر خوب میشه"
    },
    {
      "id": 30,
      "start": 14191.0,
      "end": 14193.0,
      "formatted_start": "03:56:31.000",
      "formatted_end": "03:56:33.000",
      "text": "دیگه همه این روزهایی یادتون بره"
    },
    {
      "id": 31,
      "start": 14193.0,
      "end": 14194.5,
      "formatted_start": "03:56:33.000",
      "formatted_end": "03:56:34.500",
      "text": "نه، این شکل نیست، دست شاله داره"
    },
    {
      "id": 32,
      "start": 14194.5,
      "end": 14196.0,
      "formatted_start": "03:56:34.500",
      "formatted_end": "03:56:36.000",
      "text": "قاربنش همه خرید شده"
    },
    {
      "id": 33,
      "start": 14196.0,
      "end": 14197.0,
      "formatted_start": "03:56:36.000",
      "formatted_end": "03:56:37.000",
      "text": "خب، اینجا روشت"
    },
    {
      "id": 34,
      "start": 14197.0,
      "end": 14199.0,
      "formatted_start": "03:56:37.000",
      "formatted_end": "03:56:39.000",
      "text": "سالتتو پرسید یاد میزن"
    },
    {
      "id": 35,
      "start": 14199.0,
      "end": 14202.0,
      "formatted_start": "03:56:39.000",
      "formatted_end": "03:56:42.000",
      "text": "باید بهش میره که گریه زیاد نکنه"
    },
    {
      "id": 36,
      "start": 14202.0,
      "end": 14204.0,
      "formatted_start": "03:56:42.000",
      "formatted_end": "03:56:44.000",
      "text": "موخا تو دردش نرفته"
    },
    {
      "id": 37,
      "start": 14204.0,
      "end": 14205.0,
      "formatted_start": "03:56:44.000",
      "formatted_end": "03:56:45.000",
      "text": "نگران نباشه"
    },
    {
      "id": 38,
      "start": 14205.0,
      "end": 14207.0,
      "formatted_start": "03:56:45.000",
      "formatted_end": "03:56:47.000",
      "text": "اینه چند نشوی برادید"
    },
    {
      "id": 39,
      "start": 14207.0,
      "end": 14212.0,
      "formatted_start": "03:56:47.000",
      "formatted_end": "03:56:52.000",
      "text": "نه ببین دیگه سر کنی بچه بزرگ کردن لذت ببری دیگه"
    },
    {
      "id": 40,
      "start": 14212.0,
      "end": 14216.0,
      "formatted_start": "03:56:52.000",
      "formatted_end": "03:56:56.000",
      "text": "خب ببین به هر حال هیچوقت بچه دیگه اینقدری نمیشه"
    },
    {
      "id": 41,
      "start": 14216.0,
      "end": 14221.0,
      "formatted_start": "03:56:56.000",
      "formatted_end": "03:57:01.000",
      "text": "از هر سنی از بچهت باید لذت ببری خب"
    },
    {
      "id": 42,
      "start": 14221.0,
      "end": 14227.0,
      "formatted_start": "03:57:01.000",
      "formatted_end": "03:57:07.000",
      "text": "آره یه سری نگرانی هایی داری حق داری بخواد اینکه بچه ها خب بالاخره از امهالایی شده نمبر مقصد ندارسته"
    },
    {
      "id": 43,
      "start": 14227.0,
      "end": 14230.6,
      "formatted_start": "03:57:07.000",
      "formatted_end": "03:57:10.600",
      "text": "بله یک شده روز به روز بهتر میشه بله خب پیگیریش هم بکن دیگه"
    },
    {
      "id": 44,
      "start": 14230.6,
      "end": 14232.0,
      "formatted_start": "03:57:10.600",
      "formatted_end": "03:57:12.000",
      "text": "قام پیگیریش هم بکن که این شده"
    },
    {
      "id": 45,
      "start": 14232.0,
      "end": 14234.0,
      "formatted_start": "03:57:12.000",
      "formatted_end": "03:57:14.000",
      "text": "یه پرس پرسونی دیگه سه ماه رو عرض میشه"
    },
    {
      "id": 46,
      "start": 14234.0,
      "end": 14236.0,
      "formatted_start": "03:57:14.000",
      "formatted_end": "03:57:16.000",
      "text": "من سه یه بعد که ببین خدا دیگه؟"
    },
    {
      "id": 47,
      "start": 14236.0,
      "end": 14237.0,
      "formatted_start": "03:57:16.000",
      "formatted_end": "03:57:17.000",
      "text": "یه ماه دیگه"
    },
    {
      "id": 48,
      "start": 14237.0,
      "end": 14238.0,
      "formatted_start": "03:57:17.000",
      "formatted_end": "03:57:18.000",
      "text": "یه ماه دیگه؟"
    },
    {
      "id": 49,
      "start": 14238.0,
      "end": 14239.0,
      "formatted_start": "03:57:18.000",
      "formatted_end": "03:57:19.000",
      "text": "بله"
    },
    {
      "id": 50,
      "start": 14239.0,
      "end": 14241.0,
      "formatted_start": "03:57:19.000",
      "formatted_end": "03:57:21.000",
      "text": "خیلی شکر میکنم"
    },
    {
      "id": 51,
      "start": 14241.0,
      "end": 14243.0,
      "formatted_start": "03:57:21.000",
      "formatted_end": "03:57:23.000",
      "text": "خدافر"
    },
    {
      "id": 52,
      "start": 14243.0,
      "end": 14245.0,
      "formatted_start": "03:57:23.000",
      "formatted_end": "03:57:25.000",
      "text": "خدافر"
    },
    {
      "id": 53,
      "start": 14245.0,
      "end": 14247.0,
      "formatted_start": "03:57:25.000",
      "formatted_end": "03:57:27.000",
      "text": "خدافر"
    },
    {
      "id": 54,
      "start": 14247.0,
      "end": 14249.0,
      "formatted_start": "03:57:27.000",
      "formatted_end": "03:57:29.000",
      "text": "خدافر"
    },
    {
      "id": 55,
      "start": 14249.0,
      "end": 14251.0,
      "formatted_start": "03:57:29.000",
      "formatted_end": "03:57:31.000",
      "text": "خدافر"
    },
    {
      "id": 56,
      "start": 14251.0,
      "end": 14253.0,
      "formatted_start": "03:57:31.000",
      "formatted_end": "03:57:33.000",
      "text": "نه نه همون موقع"
    },
    {
      "id": 57,
      "start": 14253.0,
      "end": 14255.0,
      "formatted_start": "03:57:33.000",
      "formatted_end": "03:57:35.000",
      "text": "خدافر"
    },
    {
      "id": 58,
      "start": 14255.0,
      "end": 14257.0,
      "formatted_start": "03:57:35.000",
      "formatted_end": "03:57:37.000",
      "text": "نه"
    },
    {
      "id": 59,
      "start": 14257.0,
      "end": 14259.0,
      "formatted_start": "03:57:37.000",
      "formatted_end": "03:57:39.000",
      "text": "نه"
    },
    {
      "id": 60,
      "start": 14259.0,
      "end": 14261.0,
      "formatted_start": "03:57:39.000",
      "formatted_end": "03:57:41.000",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 14261.0,
      "end": 14263.0,
      "formatted_start": "03:57:41.000",
      "formatted_end": "03:57:43.000",
      "text": "نه"
    },
    {
      "id": 62,
      "start": 14263.0,
      "end": 14265.0,
      "formatted_start": "03:57:43.000",
      "formatted_end": "03:57:45.000",
      "text": "نه"
    },
    {
      "id": 63,
      "start": 14265.0,
      "end": 14267.0,
      "formatted_start": "03:57:45.000",
      "formatted_end": "03:57:47.000",
      "text": "نه"
    },
    {
      "id": 64,
      "start": 14267.0,
      "end": 14273.0,
      "formatted_start": "03:57:47.000",
      "formatted_end": "03:57:53.000",
      "text": "بله، چون پیانی که هستم برای اونجور بگه که بهزادی هم برای اونگیر کنیم"
    },
    {
      "id": 65,
      "start": 14275.0,
      "end": 14277.0,
      "formatted_start": "03:57:55.000",
      "formatted_end": "03:57:57.000",
      "text": "اینم اون شده باده بود"
    },
    {
      "id": 66,
      "start": 14277.0,
      "end": 14278.0,
      "formatted_start": "03:57:57.000",
      "formatted_end": "03:57:58.000",
      "text": "بله"
    },
    {
      "id": 67,
      "start": 14278.0,
      "end": 14280.0,
      "formatted_start": "03:57:58.000",
      "formatted_end": "03:58:00.000",
      "text": "کن باشه باسم همه چیز رو برم"
    },
    {
      "id": 68,
      "start": 14280.0,
      "end": 14281.0,
      "formatted_start": "03:58:00.000",
      "formatted_end": "03:58:01.000",
      "text": "بله"
    },
    {
      "id": 69,
      "start": 14282.0,
      "end": 14283.0,
      "formatted_start": "03:58:02.000",
      "formatted_end": "03:58:03.000",
      "text": "ببرش اینجا"
    },
    {
      "id": 70,
      "start": 14283.0,
      "end": 14284.0,
      "formatted_start": "03:58:03.000",
      "formatted_end": "03:58:04.000",
      "text": "ببرش اینجا"
    },
    {
      "id": 71,
      "start": 14284.0,
      "end": 14285.0,
      "formatted_start": "03:58:04.000",
      "formatted_end": "03:58:05.000",
      "text": "ببرش اینجا"
    },
    {
      "id": 72,
      "start": 14285.0,
      "end": 14286.0,
      "formatted_start": "03:58:05.000",
      "formatted_end": "03:58:06.000",
      "text": "ببه دیگه"
    },
    {
      "id": 73,
      "start": 14286.0,
      "end": 14287.0,
      "formatted_start": "03:58:06.000",
      "formatted_end": "03:58:07.000",
      "text": "ببه دیگه"
    },
    {
      "id": 74,
      "start": 14287.0,
      "end": 14289.0,
      "formatted_start": "03:58:07.000",
      "formatted_end": "03:58:09.000",
      "text": "برای ایالتشتش ببه"
    },
    {
      "id": 75,
      "start": 14289.0,
      "end": 14290.0,
      "formatted_start": "03:58:09.000",
      "formatted_end": "03:58:10.000",
      "text": "ببه دیگه"
    },
    {
      "id": 76,
      "start": 14290.0,
      "end": 14291.0,
      "formatted_start": "03:58:10.000",
      "formatted_end": "03:58:11.000",
      "text": "ببه دیگه"
    },
    {
      "id": 77,
      "start": 14291.0,
      "end": 14292.0,
      "formatted_start": "03:58:11.000",
      "formatted_end": "03:58:12.000",
      "text": "ببه دیگه"
    },
    {
      "id": 78,
      "start": 14292.0,
      "end": 14293.0,
      "formatted_start": "03:58:12.000",
      "formatted_end": "03:58:13.000",
      "text": "ببه دیگه"
    },
    {
      "id": 79,
      "start": 14294.0,
      "end": 14298.0,
      "formatted_start": "03:58:14.000",
      "formatted_end": "03:58:18.000",
      "text": "بکنم آرشیتا باسمی یه جایی زردو نوبرت گرفت کنم"
    },
    {
      "id": 80,
      "start": 14298.0,
      "end": 14301.0,
      "formatted_start": "03:58:18.000",
      "formatted_end": "03:58:21.000",
      "text": "چرا برای باسمی دید ببه باسمی دید ببه"
    },
    {
      "id": 81,
      "start": 14301.0,
      "end": 14305.1,
      "formatted_start": "03:58:21.000",
      "formatted_end": "03:58:25.100",
      "text": "اینکه صدای آمایی قاسمی رو نمیشنستن"
    },
    {
      "id": 82,
      "start": 14305.1,
      "end": 14308.06,
      "formatted_start": "03:58:25.100",
      "formatted_end": "03:58:28.060",
      "text": "از قرار نداره"
    },
    {
      "id": 83,
      "start": 14308.06,
      "end": 14311.88,
      "formatted_start": "03:58:28.060",
      "formatted_end": "03:58:31.880",
      "text": "دو شده؟"
    },
    {
      "id": 84,
      "start": 14311.88,
      "end": 14313.06,
      "formatted_start": "03:58:31.880",
      "formatted_end": "03:58:33.060",
      "text": "دو دقیقه"
    },
    {
      "id": 85,
      "start": 14313.06,
      "end": 14317.3,
      "formatted_start": "03:58:33.060",
      "formatted_end": "03:58:37.300",
      "text": "اگه خوبه از آشوزه باشه"
    },
    {
      "id": 86,
      "start": 14317.3,
      "end": 14319.06,
      "formatted_start": "03:58:37.300",
      "formatted_end": "03:58:39.060",
      "text": "خوبه از آشوزه هم تایم خیلی خوبه"
    },
    {
      "id": 87,
      "start": 14319.06,
      "end": 14323.8,
      "formatted_start": "03:58:39.060",
      "formatted_end": "03:58:43.800",
      "text": "خب از که زد تا موقع به سعدی تنگ"
    },
    {
      "id": 88,
      "start": 14323.8,
      "end": 14325.16,
      "formatted_start": "03:58:43.800",
      "formatted_end": "03:58:45.160",
      "text": "بزنم بیتر نباشیم"
    },
    {
      "id": 89,
      "start": 14325.16,
      "end": 14329.66,
      "formatted_start": "03:58:45.160",
      "formatted_end": "03:58:49.660",
      "text": "وقتی خودت نیزمی جواب ندیده"
    },
    {
      "id": 90,
      "start": 14329.66,
      "end": 14331.66,
      "formatted_start": "03:58:49.660",
      "formatted_end": "03:58:51.660",
      "text": "خوب تو خاله زنگ دارن تو نمارسن شیف کنن"
    },
    {
      "id": 91,
      "start": 14331.66,
      "end": 14333.66,
      "formatted_start": "03:58:51.660",
      "formatted_end": "03:58:53.660",
      "text": "اینجوری با"
    },
    {
      "id": 92,
      "start": 14333.66,
      "end": 14335.66,
      "formatted_start": "03:58:53.660",
      "formatted_end": "03:58:55.660",
      "text": "اینجوری باید زنگ دارن؟"
    },
    {
      "id": 93,
      "start": 14335.66,
      "end": 14337.66,
      "formatted_start": "03:58:55.660",
      "formatted_end": "03:58:57.660",
      "text": "اوه"
    },
