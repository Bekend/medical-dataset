  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5712.2,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:12.200",
      "text": "هر چند روز یک بار یکم بالا میاره. این رفلاکس داشت دختر من و شما چیز دادین که ایلیزول دادین. دورش کامل شد، دیگه بال آره. بهتر شد."
    },
    {
      "id": 1,
      "start": 5712.2,
      "end": 5718.2,
      "formatted_start": "01:35:12.200",
      "formatted_end": "01:35:18.200",
      "text": "الان چند وقتیه؟ دوست همه دست؟ آره. هر چند روز یک بار یکم بالا میاره. شیر بالا میاره."
    },
    {
      "id": 2,
      "start": 5720.2,
      "end": 5725.2,
      "formatted_start": "01:35:20.200",
      "formatted_end": "01:35:25.200",
      "text": "شیر خوشکش هم که ایلیزول آره، نمیتونم. حالا بعد یه سالگی هم همینها ادامه بدن؟"
    },
    {
      "id": 3,
      "start": 5725.2,
      "end": 5730.38,
      "formatted_start": "01:35:25.200",
      "formatted_end": "01:35:30.380",
      "text": "فعلا تا یه سالگی بدین بعد از یه سالگی مثلا میکنیم یک ورده در میون"
    },
    {
      "id": 4,
      "start": 5730.38,
      "end": 5731.2,
      "formatted_start": "01:35:30.380",
      "formatted_end": "01:35:31.200",
      "text": "خوب؟"
    },
    {
      "id": 5,
      "start": 5731.2,
      "end": 5732.92,
      "formatted_start": "01:35:31.200",
      "formatted_end": "01:35:32.920",
      "text": "یعنی یه شیر خشک دیگه مثلا"
    },
    {
      "id": 6,
      "start": 5732.92,
      "end": 5736.66,
      "formatted_start": "01:35:32.920",
      "formatted_end": "01:35:36.660",
      "text": "آره یه شیر خشک معمولی میکنیم و بعد تا کم کم عادت کنیم"
    },
    {
      "id": 7,
      "start": 5736.66,
      "end": 5739.14,
      "formatted_start": "01:35:36.660",
      "formatted_end": "01:35:39.140",
      "text": "یه ورده مثلا این شیر خشک رو میدونیم یه ورده بود"
    },
    {
      "id": 8,
      "start": 5739.14,
      "end": 5744.14,
      "formatted_start": "01:35:39.140",
      "formatted_end": "01:35:44.140",
      "text": "یا این که مثلا چهار تا پیمونه درست میکنیم دو تا پیمونه معمولی دو تا پیمونه ایغان"
    },
    {
      "id": 9,
      "start": 5744.14,
      "end": 5747.74,
      "formatted_start": "01:35:44.140",
      "formatted_end": "01:35:47.740",
      "text": "اگه بینی مشکلی پیدا نکرد که شروع کشت که منوش"
    },
    {
      "id": 10,
      "start": 5747.74,
      "end": 5749.06,
      "formatted_start": "01:35:47.740",
      "formatted_end": "01:35:49.060",
      "text": "پس باید کم کم بشون"
    },
    {
      "id": 11,
      "start": 5749.06,
      "end": 5749.9,
      "formatted_start": "01:35:49.060",
      "formatted_end": "01:35:49.900",
      "text": "آره کم کم"
    },
    {
      "id": 12,
      "start": 5749.9,
      "end": 5751.98,
      "formatted_start": "01:35:49.900",
      "formatted_end": "01:35:51.980",
      "text": "باید که یه سالگی چک ها بگذارن"
    },
    {
      "id": 13,
      "start": 5751.98,
      "end": 5752.86,
      "formatted_start": "01:35:51.980",
      "formatted_end": "01:35:52.860",
      "text": "بله بله"
    },
    {
      "id": 14,
      "start": 5752.86,
      "end": 5755.66,
      "formatted_start": "01:35:52.860",
      "formatted_end": "01:35:55.660",
      "text": "اگه سرشو گذاریم بعدش بیاریم منو بگنمش"
    },
    {
      "id": 15,
      "start": 5765.66,
      "end": 5769.9,
      "formatted_start": "01:36:05.660",
      "formatted_end": "01:36:09.900",
      "text": "ببینیم بچه ها که به صرفه می افتن معمولا ریفلاکسشون شبیه میشه"
    },
    {
      "id": 16,
      "start": 5769.9,
      "end": 5775.42,
      "formatted_start": "01:36:09.900",
      "formatted_end": "01:36:15.420",
      "text": "چرا؟ برای اینکه یک فشار میارن، این صرفه باعث میشه که دریچه میدهشون باز بشه"
    },
    {
      "id": 17,
      "start": 5775.42,
      "end": 5776.58,
      "formatted_start": "01:36:15.420",
      "formatted_end": "01:36:16.580",
      "text": "پس بده"
    },
    {
      "id": 18,
      "start": 5776.58,
      "end": 5777.58,
      "formatted_start": "01:36:16.580",
      "formatted_end": "01:36:17.580",
      "text": "آره، پس بده"
    },
    {
      "id": 19,
      "start": 5777.58,
      "end": 5784.38,
      "formatted_start": "01:36:17.580",
      "formatted_end": "01:36:24.380",
      "text": "به خاطر همین ما در همزمان که دارمون میکنیم صرفه شونو، باید درواز ریفلاکسشونو بدیم"
    },
    {
      "id": 20,
      "start": 5784.38,
      "end": 5788.3,
      "formatted_start": "01:36:24.380",
      "formatted_end": "01:36:28.300",
      "text": "اما از این نبیگه کیلیزورت، چون کیلیزورت دورش طولانیه"
    },
    {
      "id": 21,
      "start": 5788.3,
      "end": 5790.3,
      "formatted_start": "01:36:28.300",
      "formatted_end": "01:36:30.300",
      "text": "آره، خیلی عذیب چون این میخوره"
    },
    {
      "id": 22,
      "start": 5790.3,
      "end": 5791.3,
      "formatted_start": "01:36:30.300",
      "formatted_end": "01:36:31.300",
      "text": "فارمکسراش میده بسن"
    },
    {
      "id": 23,
      "start": 5793.94,
      "end": 5797.9,
      "formatted_start": "01:36:33.940",
      "formatted_end": "01:36:37.900",
      "text": "خب، بیایی از داشت ببینید، من برایش"
    },
    {
      "id": 24,
      "start": 5799.9,
      "end": 5803.9,
      "formatted_start": "01:36:39.900",
      "formatted_end": "01:36:43.900",
      "text": "یک اسپریه سالزوتامول نمشتم"
    },
    {
      "id": 25,
      "start": 5803.9,
      "end": 5809.9,
      "formatted_start": "01:36:43.900",
      "formatted_end": "01:36:49.900",
      "text": "صبح و زبون و شب دو پاف براش بزنیم"
    },
    {
      "id": 26,
      "start": 5809.9,
      "end": 5814.9,
      "formatted_start": "01:36:49.900",
      "formatted_end": "01:36:54.900",
      "text": "یک اسپریه این آرنجی هم نمشتم که هر دراز دست وقت بزنیم"
    },
    {
      "id": 27,
      "start": 5814.9,
      "end": 5816.9,
      "formatted_start": "01:36:54.900",
      "formatted_end": "01:36:56.900",
      "text": "قبل از زدین اسپریه براش بزنیم؟"
    },
    {
      "id": 28,
      "start": 5816.9,
      "end": 5817.9,
      "formatted_start": "01:36:56.900",
      "formatted_end": "01:36:57.900",
      "text": "نه، نه، نه"
    },
    {
      "id": 29,
      "start": 5817.9,
      "end": 5820.9,
      "formatted_start": "01:36:57.900",
      "formatted_end": "01:37:00.900",
      "text": "یک شربت سترزین افتیداری بیشتر"
    },
    {
      "id": 30,
      "start": 5820.9,
      "end": 5823.9,
      "formatted_start": "01:37:00.900",
      "formatted_end": "01:37:03.900",
      "text": "سترزینش رو فقط شما بشه برن"
    },
    {
      "id": 31,
      "start": 5823.9,
      "end": 5825.9,
      "formatted_start": "01:37:03.900",
      "formatted_end": "01:37:05.900",
      "text": "دو نیم سی سی"
    },
    {
      "id": 32,
      "start": 5825.9,
      "end": 5835.5,
      "formatted_start": "01:37:05.900",
      "formatted_end": "01:37:15.500",
      "text": "بعد یه پودره منتلوکاست هم براش نمشتم از راه این پودر رو باز میکنیم و میرزی که شیر یا ماز بهش میدونی خواهیم"
    },
    {
      "id": 33,
      "start": 5835.5,
      "end": 5839.1,
      "formatted_start": "01:37:15.500",
      "formatted_end": "01:37:19.100",
      "text": "خب این داروهاشه برای رده برم"
    },
    {
      "id": 34,
      "start": 5839.1,
      "end": 5840.5,
      "formatted_start": "01:37:19.100",
      "formatted_end": "01:37:20.500",
      "text": "ساشنگیه پودرش؟"
    },
    {
      "id": 35,
      "start": 5840.5,
      "end": 5847.1,
      "formatted_start": "01:37:20.500",
      "formatted_end": "01:37:27.100",
      "text": "آه ساشنگیه فاموتیدین نمشتم هر دوازده ساعت بهش یک سی سی هم فاموتیدین"
    },
    {
      "id": 36,
      "start": 5847.1,
      "end": 5849.1,
      "formatted_start": "01:37:27.100",
      "formatted_end": "01:37:29.100",
      "text": "فاموسیزینش رو بده تا یک هفته"
    },
    {
      "id": 37,
      "start": 5850.32,
      "end": 5852.32,
      "formatted_start": "01:37:30.320",
      "formatted_end": "01:37:32.320",
      "text": "بعد بگم فقط شبها"
    },
    {
      "id": 38,
      "start": 5852.32,
      "end": 5854.32,
      "formatted_start": "01:37:32.320",
      "formatted_end": "01:37:34.320",
      "text": "تا یک هفته"
    },
    {
      "id": 39,
      "start": 5854.32,
      "end": 5856.32,
      "formatted_start": "01:37:34.320",
      "formatted_end": "01:37:36.320",
      "text": "بعد اگه خوب بود قدرش بود"
    },
    {
      "id": 40,
      "start": 5856.32,
      "end": 5857.32,
      "formatted_start": "01:37:36.320",
      "formatted_end": "01:37:37.320",
      "text": "بافر"
    },
    {
      "id": 41,
      "start": 5857.32,
      "end": 5858.32,
      "formatted_start": "01:37:37.320",
      "formatted_end": "01:37:38.320",
      "text": "این که قدرش بود"
    },
    {
      "id": 42,
      "start": 5858.32,
      "end": 5860.32,
      "formatted_start": "01:37:38.320",
      "formatted_end": "01:37:40.320",
      "text": "اسپریشو بسمند"
    },
    {
      "id": 43,
      "start": 5860.32,
      "end": 5862.32,
      "formatted_start": "01:37:40.320",
      "formatted_end": "01:37:42.320",
      "text": "اسپریشو"
    },
    {
      "id": 44,
      "start": 5867.32,
      "end": 5869.32,
      "formatted_start": "01:37:47.320",
      "formatted_end": "01:37:49.320",
      "text": "چطوری استفاده کنی؟"
    },
    {
      "id": 45,
      "start": 5869.32,
      "end": 5871.32,
      "formatted_start": "01:37:49.320",
      "formatted_end": "01:37:51.320",
      "text": "هفته دو دو نه سته دو هشته دو نه"
    },
    {
      "id": 46,
      "start": 5871.32,
      "end": 5873.32,
      "formatted_start": "01:37:51.320",
      "formatted_end": "01:37:53.320",
      "text": "خوبی؟"
    },
    {
      "id": 47,
      "start": 5873.32,
      "end": 5875.32,
      "formatted_start": "01:37:53.320",
      "formatted_end": "01:37:55.320",
      "text": "خوبی؟"
    },
    {
      "id": 48,
      "start": 5875.32,
      "end": 5877.32,
      "formatted_start": "01:37:55.320",
      "formatted_end": "01:37:57.320",
      "text": "این رو سرکش کنید"
    },
    {
      "id": 49,
      "start": 5877.32,
      "end": 5879.32,
      "formatted_start": "01:37:57.320",
      "formatted_end": "01:37:59.320",
      "text": "این رو خشک تکونه شویدید"
    },
    {
      "id": 50,
      "start": 5879.32,
      "end": 5882.32,
      "formatted_start": "01:37:59.320",
      "formatted_end": "01:38:02.320",
      "text": "این در بوشش رو برمیدونید وست میکنید به دمیار"
    },
    {
      "id": 51,
      "start": 5882.32,
      "end": 5884.32,
      "formatted_start": "01:38:02.320",
      "formatted_end": "01:38:04.320",
      "text": "خب، مثلا این بچه است"
    },
    {
      "id": 52,
      "start": 5884.32,
      "end": 5887.32,
      "formatted_start": "01:38:04.320",
      "formatted_end": "01:38:07.320",
      "text": "این رو میزایید روی بینش، این رو میزایید روی دهنش"
    },
    {
      "id": 53,
      "start": 5887.32,
      "end": 5889.32,
      "formatted_start": "01:38:07.320",
      "formatted_end": "01:38:09.320",
      "text": "یک قاف، دو قاف میزنید"
    },
    {
      "id": 54,
      "start": 5889.32,
      "end": 5892.32,
      "formatted_start": "01:38:09.320",
      "formatted_end": "01:38:12.320",
      "text": "بعد ده سانیه سبر میکنید و بعد برش بیدید"
    },
    {
      "id": 55,
      "start": 5892.32,
      "end": 5897.32,
      "formatted_start": "01:38:12.320",
      "formatted_end": "01:38:17.320",
      "text": "خب، این خیلی سریع خشکش سینه و صرفه هاشو خوب میکنه"
    },
    {
      "id": 56,
      "start": 5897.32,
      "end": 5901.32,
      "formatted_start": "01:38:17.320",
      "formatted_end": "01:38:21.320",
      "text": "انجامه که بهتر میشه"
    },
    {
      "id": 57,
      "start": 5901.32,
      "end": 5903.32,
      "formatted_start": "01:38:21.320",
      "formatted_end": "01:38:23.320",
      "text": "چون بچه هم رفلاکس داشته"
    },
    {
      "id": 58,
      "start": 5903.32,
      "end": 5907.32,
      "formatted_start": "01:38:23.320",
      "formatted_end": "01:38:27.320",
      "text": "آیانجی نشکه معمولاً این سرده هاش رو یه مدتی باقی می کنید."
    },
    {
      "id": 59,
      "start": 5907.32,
      "end": 5908.32,
      "formatted_start": "01:38:27.320",
      "formatted_end": "01:38:28.320",
      "text": "آره."
    },
    {
      "id": 60,
      "start": 5908.32,
      "end": 5911.32,
      "formatted_start": "01:38:28.320",
      "formatted_end": "01:38:31.320",
      "text": "این دست خودتون می مونه؟"
    },
    {
      "id": 61,
      "start": 5911.32,
      "end": 5912.32,
      "formatted_start": "01:38:31.320",
      "formatted_end": "01:38:32.320",
      "text": "نه، نه."
    },
    {
      "id": 62,
      "start": 5922.32,
      "end": 5924.32,
      "formatted_start": "01:38:42.320",
      "formatted_end": "01:38:44.320",
      "text": "خیلی مزه شما هستید."
    },
    {
      "id": 63,
      "start": 5924.32,
      "end": 5926.32,
      "formatted_start": "01:38:44.320",
      "formatted_end": "01:38:46.320",
      "text": "دستتون در پشت مرده یه رام نمی کنید؟"
    },
    {
      "id": 64,
      "start": 5926.32,
      "end": 5927.32,
      "formatted_start": "01:38:46.320",
      "formatted_end": "01:38:47.320",
      "text": "خدا باشم."
    },
    {
      "id": 65,
      "start": 5933.32,
      "end": 5955.32,
      "formatted_start": "01:38:53.320",
      "formatted_end": "01:39:15.320",
      "text": "موسیقی"
    },
    {
      "id": 66,
      "start": 5955.32,
      "end": 5957.32,
      "formatted_start": "01:39:15.320",
      "formatted_end": "01:39:17.320",
      "text": "مردم"
    },
    {
      "id": 67,
      "start": 5957.32,
      "end": 5959.32,
      "formatted_start": "01:39:17.320",
      "formatted_end": "01:39:19.320",
      "text": "مردم"
    },
    {
      "id": 68,
      "start": 5959.32,
      "end": 5961.32,
      "formatted_start": "01:39:19.320",
      "formatted_end": "01:39:21.320",
      "text": "مردم"
    },
    {
      "id": 69,
      "start": 5961.32,
      "end": 5963.32,
      "formatted_start": "01:39:21.320",
      "formatted_end": "01:39:23.320",
      "text": "مردم"
    },
    {
      "id": 70,
      "start": 5963.32,
      "end": 5965.32,
      "formatted_start": "01:39:23.320",
      "formatted_end": "01:39:25.320",
      "text": "مردم"
    },
    {
      "id": 71,
      "start": 5965.32,
      "end": 5967.32,
      "formatted_start": "01:39:25.320",
      "formatted_end": "01:39:27.320",
      "text": "مردم"
    },
    {
      "id": 72,
      "start": 5967.32,
      "end": 5969.32,
      "formatted_start": "01:39:27.320",
      "formatted_end": "01:39:29.320",
      "text": "مردم"
    },
    {
      "id": 73,
      "start": 5969.32,
      "end": 5971.32,
      "formatted_start": "01:39:29.320",
      "formatted_end": "01:39:31.320",
      "text": "مردم"
    },
    {
      "id": 74,
      "start": 5971.32,
      "end": 5973.32,
      "formatted_start": "01:39:31.320",
      "formatted_end": "01:39:33.320",
      "text": "مردم"
    },
    {
      "id": 75,
      "start": 5973.32,
      "end": 5975.32,
      "formatted_start": "01:39:33.320",
      "formatted_end": "01:39:35.320",
      "text": "مردم"
    },
    {
      "id": 76,
      "start": 5975.32,
      "end": 5977.32,
      "formatted_start": "01:39:35.320",
      "formatted_end": "01:39:37.320",
      "text": "مردم"
    },
    {
      "id": 77,
      "start": 5977.32,
      "end": 5979.32,
      "formatted_start": "01:39:37.320",
      "formatted_end": "01:39:39.320",
      "text": "مردم"
    },
    {
      "id": 78,
      "start": 5979.32,
      "end": 5981.32,
      "formatted_start": "01:39:39.320",
      "formatted_end": "01:39:41.320",
      "text": "مردم"
    },
    {
      "id": 79,
      "start": 5981.32,
      "end": 5983.32,
      "formatted_start": "01:39:41.320",
      "formatted_end": "01:39:43.320",
      "text": "مردم"
    },
    {
      "id": 80,
      "start": 5983.32,
      "end": 5985.32,
      "formatted_start": "01:39:43.320",
      "formatted_end": "01:39:45.320",
      "text": "بله بله، قبلش اصلا علامتی نداشت"
    },
    {
      "id": 81,
      "start": 5985.32,
      "end": 5987.32,
      "formatted_start": "01:39:45.320",
      "formatted_end": "01:39:47.320",
      "text": "بله بله، بیشتر از این از آبریزش داشت"
    },
    {
      "id": 82,
      "start": 5987.32,
      "end": 5990.32,
      "formatted_start": "01:39:47.320",
      "formatted_end": "01:39:50.320",
      "text": "ولی تبداش خیلی استامل فونم اصلا نمیخوره"
    },
    {
      "id": 83,
      "start": 5990.32,
      "end": 5993.32,
      "formatted_start": "01:39:50.320",
      "formatted_end": "01:39:53.320",
      "text": "همجوری بهش میدم بلو میاره"
    },
    {
      "id": 84,
      "start": 5995.32,
      "end": 5997.32,
      "formatted_start": "01:39:55.320",
      "formatted_end": "01:39:57.320",
      "text": "تو شیشه تو آبریز"
    },
    {
      "id": 85,
      "start": 5997.32,
      "end": 5999.32,
      "formatted_start": "01:39:57.320",
      "formatted_end": "01:39:59.320",
      "text": "چی پارکه کنی؟"
    }
  ],
  "status": "completed"
}