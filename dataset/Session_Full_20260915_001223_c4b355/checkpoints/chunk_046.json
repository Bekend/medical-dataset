  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13814.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:14.000",
      "text": "سه ماه شده، دو کیلو ریم بوده، الان شده شیشت. ماشالله، خوب. سه ماه یک کیلو اضافه شده. خیلی خوب اضافه شده. یعنی که این بچه شیری که میخوره کافیه. خوب؟"
    },
    {
      "id": 1,
      "start": 13814.0,
      "end": 13825.0,
      "formatted_start": "03:50:14.000",
      "formatted_end": "03:50:25.000",
      "text": "ببین دیگه الان نیاز نیست هی بیدارش میکنه شیر میکنه. هر موقع خودش بیدار شد شیر میکنه. ولی اگر دیگه باید بیشتر از پنج ساعت، شیش ساعت خوابید و بیدار نشد اون موقع نشد."
    },
    {
      "id": 2,
      "start": 13825.0,
      "end": 13828.0,
      "formatted_start": "03:50:25.000",
      "formatted_end": "03:50:28.000",
      "text": "من بی سالت نمی رسید. از اینکه مثلا چهار ست می خورم."
    },
    {
      "id": 3,
      "start": 13828.0,
      "end": 13831.0,
      "formatted_start": "03:50:28.000",
      "formatted_end": "03:50:31.000",
      "text": "بله بیدی خودش بیرون شد. و چند سی سی می خوره؟"
    },
    {
      "id": 4,
      "start": 13831.0,
      "end": 13836.0,
      "formatted_start": "03:50:31.000",
      "formatted_end": "03:50:36.000",
      "text": "دیگه شست سی سی. گاهی بخوای نوت بگیره. الان اکثرا شست سی سی می خوره."
    },
    {
      "id": 5,
      "start": 13836.0,
      "end": 13838.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:38.000",
      "text": "هر یک ست و نیم. هر دوست داره."
    },
    {
      "id": 6,
      "start": 13838.0,
      "end": 13841.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:41.000",
      "text": "نه بیدی اگه هر چی بیشتر بخوره در آتش."
    },
    {
      "id": 7,
      "start": 13841.0,
      "end": 13846.0,
      "formatted_start": "03:50:41.000",
      "formatted_end": "03:50:46.000",
      "text": "گاهی بخوای بخوای ده تا بخوره. گاهی بخوای سی تا بخوره. گاهی بخوای نوت تا بخوره."
    },
    {
      "id": 8,
      "start": 13846.0,
      "end": 13850.16,
      "formatted_start": "03:50:46.000",
      "formatted_end": "03:50:50.160",
      "text": "آخه توی ست و نیم دو ست میدی خب هنوز گشتنش نشده دیگه"
    },
    {
      "id": 9,
      "start": 13850.16,
      "end": 13853.28,
      "formatted_start": "03:50:50.160",
      "formatted_end": "03:50:53.280",
      "text": "بگه اگر گرست نشده بشه سنه وقت ها میخوره"
    },
    {
      "id": 10,
      "start": 13853.28,
      "end": 13856.12,
      "formatted_start": "03:50:53.280",
      "formatted_end": "03:50:56.120",
      "text": "حتی ممکنه ست و بیست ها هم بخوره"
    },
    {
      "id": 11,
      "start": 13856.12,
      "end": 13859.04,
      "formatted_start": "03:50:56.120",
      "formatted_end": "03:50:59.040",
      "text": "تو اصلا بهش اجازه نمیدی که این گرست نشده بشه"
    },
    {
      "id": 12,
      "start": 13859.04,
      "end": 13859.62,
      "formatted_start": "03:50:59.040",
      "formatted_end": "03:50:59.620",
      "text": "خب؟"
    },
    {
      "id": 13,
      "start": 13859.62,
      "end": 13861.3,
      "formatted_start": "03:50:59.620",
      "formatted_end": "03:51:01.300",
      "text": "بیرونشو پولی میذارید"
    },
    {
      "id": 14,
      "start": 13861.3,
      "end": 13862.38,
      "formatted_start": "03:51:01.300",
      "formatted_end": "03:51:02.380",
      "text": "حق داری"
    },
    {
      "id": 15,
      "start": 13862.38,
      "end": 13865.18,
      "formatted_start": "03:51:02.380",
      "formatted_end": "03:51:05.180",
      "text": "بلد سناری بالا و بلد پولی دنیا"
    },
    {
      "id": 16,
      "start": 13865.18,
      "end": 13867.06,
      "formatted_start": "03:51:05.180",
      "formatted_end": "03:51:07.060",
      "text": "ما توی پنگا سالهی که خدا داده"
    },
    {
      "id": 17,
      "start": 13867.06,
      "end": 13868.02,
      "formatted_start": "03:51:07.060",
      "formatted_end": "03:51:08.020",
      "text": "ما خدا دادی"
    },
    {
      "id": 18,
      "start": 13868.02,
      "end": 13870.76,
      "formatted_start": "03:51:08.020",
      "formatted_end": "03:51:10.760",
      "text": "توی سی و شی سالهی زباشی هستیم"
    },
    {
      "id": 19,
      "start": 13870.76,
      "end": 13871.24,
      "formatted_start": "03:51:10.760",
      "formatted_end": "03:51:11.240",
      "text": "آها"
    },
    {
      "id": 20,
      "start": 13876.0,
      "end": 13878.0,
      "formatted_start": "03:51:16.000",
      "formatted_end": "03:51:18.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 21,
      "start": 13878.0,
      "end": 13880.0,
      "formatted_start": "03:51:18.000",
      "formatted_end": "03:51:20.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 22,
      "start": 13880.0,
      "end": 13882.0,
      "formatted_start": "03:51:20.000",
      "formatted_end": "03:51:22.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 23,
      "start": 13882.0,
      "end": 13884.0,
      "formatted_start": "03:51:22.000",
      "formatted_end": "03:51:24.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 24,
      "start": 13884.0,
      "end": 13886.0,
      "formatted_start": "03:51:24.000",
      "formatted_end": "03:51:26.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 25,
      "start": 13886.0,
      "end": 13888.0,
      "formatted_start": "03:51:26.000",
      "formatted_end": "03:51:28.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 26,
      "start": 13888.0,
      "end": 13890.0,
      "formatted_start": "03:51:28.000",
      "formatted_end": "03:51:30.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 27,
      "start": 13890.0,
      "end": 13892.0,
      "formatted_start": "03:51:30.000",
      "formatted_end": "03:51:32.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 28,
      "start": 13892.0,
      "end": 13894.0,
      "formatted_start": "03:51:32.000",
      "formatted_end": "03:51:34.000",
      "text": "این کار رو کار درمان هست"
    },
    {
      "id": 29,
      "start": 13894.0,
      "end": 13896.0,
      "formatted_start": "03:51:34.000",
      "formatted_end": "03:51:36.000",
      "text": "اون فقط برای بستداری انجام میده"
    },
    {
      "id": 30,
      "start": 13896.0,
      "end": 13898.0,
      "formatted_start": "03:51:36.000",
      "formatted_end": "03:51:38.000",
      "text": "اون فقط برای بستداری انجام میده"
    },
    {
      "id": 31,
      "start": 13898.0,
      "end": 13900.0,
      "formatted_start": "03:51:38.000",
      "formatted_end": "03:51:40.000",
      "text": "اون فقط برای بستداری انجام میده"
    },
    {
      "id": 32,
      "start": 13900.0,
      "end": 13902.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:42.000",
      "text": "اون فقط برای بستداری انجام میده"
    },
    {
      "id": 33,
      "start": 13906.0,
      "end": 13908.0,
      "formatted_start": "03:51:46.000",
      "formatted_end": "03:51:48.000",
      "text": "محفوظ افتادی"
    },
    {
      "id": 34,
      "start": 13908.0,
      "end": 13910.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:50.000",
      "text": "آره ما اول افتادی هستیم"
    },
    {
      "id": 35,
      "start": 13916.0,
      "end": 13918.0,
      "formatted_start": "03:51:56.000",
      "formatted_end": "03:51:58.000",
      "text": "اینکه ایجاز"
    },
    {
      "id": 36,
      "start": 13918.0,
      "end": 13920.0,
      "formatted_start": "03:51:58.000",
      "formatted_end": "03:52:00.000",
      "text": "کداشون بهتره"
    },
    {
      "id": 37,
      "start": 13920.0,
      "end": 13922.0,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:02.000",
      "text": "نه این خیلی خوبه"
    },
    {
      "id": 38,
      "start": 13922.0,
      "end": 13924.0,
      "formatted_start": "03:52:02.000",
      "formatted_end": "03:52:04.000",
      "text": "ارتباطشش خوبه دیگه"
    },
    {
      "id": 39,
      "start": 13924.0,
      "end": 13926.0,
      "formatted_start": "03:52:04.000",
      "formatted_end": "03:52:06.000",
      "text": "یه ضربه کمه"
    },
    {
      "id": 40,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "ولی"
    },
    {
      "id": 41,
      "start": 13928.0,
      "end": 13930.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:10.000",
      "text": "خیلی هم ایراددار نیست"
    },
    {
      "id": 42,
      "start": 13930.0,
      "end": 13932.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:12.000",
      "text": "روز به روز بهتر میشه"
    },
    {
      "id": 43,
      "start": 13932.0,
      "end": 13934.0,
      "formatted_start": "03:52:12.000",
      "formatted_end": "03:52:14.000",
      "text": "نگران نداشت"
    },
    {
      "id": 44,
      "start": 13934.0,
      "end": 13936.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:16.000",
      "text": "اینجور اصلا باش نگاهانو نیخنده باشه"
    },
    {
      "id": 45,
      "start": 13936.0,
      "end": 13942.0,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:22.000",
      "text": "ببین از اینجور بچه تو این سن بیشتر افتومت رو نمیتونه ببینه ها خب"
    },
    {
      "id": 46,
      "start": 13942.0,
      "end": 13946.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:26.000",
      "text": "بعض وقتا یه سری چیزو تو ذهن خودشو درموز میکنه خب"
    },
    {
      "id": 47,
      "start": 13946.0,
      "end": 13950.0,
      "formatted_start": "03:52:26.000",
      "formatted_end": "03:52:30.000",
      "text": "بله اینه که گاه گاهی لبخند بزنه لبخند بزنه بگیره"
    },
    {
      "id": 48,
      "start": 13950.0,
      "end": 13952.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:32.000",
      "text": "آره آره این خوبه"
    },
    {
      "id": 49,
      "start": 13952.0,
      "end": 13958.0,
      "formatted_start": "03:52:32.000",
      "formatted_end": "03:52:38.000",
      "text": "مثلا درازه اصلا که باباشه یکم باشیم مثلا من که نگاه میکنم منو بینم"
    },
    {
      "id": 50,
      "start": 13958.0,
      "end": 13960.0,
      "formatted_start": "03:52:38.000",
      "formatted_end": "03:52:40.000",
      "text": "مثلا دور که بزنم اصلا نگاه میکنم"
    },
    {
      "id": 51,
      "start": 13960.0,
      "end": 13961.0,
      "formatted_start": "03:52:40.000",
      "formatted_end": "03:52:41.000",
      "text": "نگاه میکنم"
    },
    {
      "id": 52,
      "start": 13961.0,
      "end": 13963.0,
      "formatted_start": "03:52:41.000",
      "formatted_end": "03:52:43.000",
      "text": "خیلی خوبه دیگه"
    },
    {
      "id": 53,
      "start": 13963.0,
      "end": 13966.0,
      "formatted_start": "03:52:43.000",
      "formatted_end": "03:52:46.000",
      "text": "همون مورد دادن با کتاب بخوره کتاب چاکنین کتاب اکسای دیاستی"
    },
    {
      "id": 54,
      "start": 13966.0,
      "end": 13968.0,
      "formatted_start": "03:52:46.000",
      "formatted_end": "03:52:48.000",
      "text": "دیاستی داو فرد"
    },
    {
      "id": 55,
      "start": 13968.0,
      "end": 13970.0,
      "formatted_start": "03:52:48.000",
      "formatted_end": "03:52:50.000",
      "text": "مثلا گاهی هستن میگه خربوشه نگاه میکنه"
    },
    {
      "id": 56,
      "start": 13970.0,
      "end": 13972.0,
      "formatted_start": "03:52:50.000",
      "formatted_end": "03:52:52.000",
      "text": "گاهی هستن من محسوس شده این محسدای من"
    },
    {
      "id": 57,
      "start": 13972.0,
      "end": 13976.0,
      "formatted_start": "03:52:52.000",
      "formatted_end": "03:52:56.000",
      "text": "یا محسدای برش ببرم مثلا نگاه میکنه"
    },
    {
      "id": 58,
      "start": 13976.0,
      "end": 13981.0,
      "formatted_start": "03:52:56.000",
      "formatted_end": "03:53:01.000",
      "text": "حالا مثلا گاهی هستن به صدا گفته فقط ببینید این چیزها نمیبینه مثلا"
    },
    {
      "id": 59,
      "start": 13981.0,
      "end": 13985.0,
      "formatted_start": "03:53:01.000",
      "formatted_end": "03:53:05.000",
      "text": "آره میگم که گاهی غشای نگاه میکنه"
    },
    {
      "id": 60,
      "start": 13985.0,
      "end": 14015.0,
      "formatted_start": "03:53:05.000",
      "formatted_end": "03:53:35.000",
      "text": "بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله ب"
    },
    {
      "id": 61,
      "start": 14015.0,
      "end": 14017.0,
      "formatted_start": "03:53:35.000",
      "formatted_end": "03:53:37.000",
      "text": "خیلی خوبه، هرچی بیشتر ماساجش بدید"
    },
    {
      "id": 62,
      "start": 14017.0,
      "end": 14018.0,
      "formatted_start": "03:53:37.000",
      "formatted_end": "03:53:38.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 63,
      "start": 14018.0,
      "end": 14020.0,
      "formatted_start": "03:53:38.000",
      "formatted_end": "03:53:40.000",
      "text": "هرچی قشنگ از بلاتشو ماساجش بدید"
    },
    {
      "id": 64,
      "start": 14020.0,
      "end": 14021.0,
      "formatted_start": "03:53:40.000",
      "formatted_end": "03:53:41.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 65,
      "start": 14021.0,
      "end": 14024.0,
      "formatted_start": "03:53:41.000",
      "formatted_end": "03:53:44.000",
      "text": "بخشون ستون فهرانشو کامل کنید"
    },
    {
      "id": 66,
      "start": 14024.0,
      "end": 14030.0,
      "formatted_start": "03:53:44.000",
      "formatted_end": "03:53:50.000",
      "text": "از بالا تا پایین با دستتون رو باید روغنزایتون یا روغن بچه"
    },
    {
      "id": 67,
      "start": 14030.0,
      "end": 14033.0,
      "formatted_start": "03:53:50.000",
      "formatted_end": "03:53:53.000",
      "text": "چربو کنید، بعد قشنگ رو تن لختش خب"
    },
    {
      "id": 68,
      "start": 14033.0,
      "end": 14037.0,
      "formatted_start": "03:53:53.000",
      "formatted_end": "03:53:57.000",
      "text": "از بالا تا پایین ستون رو باید اینجور گردنشو کنید"
    },
    {
      "id": 69,
      "start": 14037.0,
      "end": 14040.0,
      "formatted_start": "03:53:57.000",
      "formatted_end": "03:54:00.000",
      "text": "تا پایین ماساجش بدید، خب"
    },
    {
      "id": 70,
      "start": 14040.0,
      "end": 14044.24,
      "formatted_start": "03:54:00.000",
      "formatted_end": "03:54:04.240",
      "text": "و اینجای صورتش و اینجای بالای افراش رو به این صورت"
    },
    {
      "id": 71,
      "start": 14045.12,
      "end": 14046.42,
      "formatted_start": "03:54:05.120",
      "formatted_end": "03:54:06.420",
      "text": "بردوقت هستم بردوقت؟"
    },
    {
      "id": 72,
      "start": 14046.42,
      "end": 14048.0,
      "formatted_start": "03:54:06.420",
      "formatted_end": "03:54:08.000",
      "text": "آره بس از اون چرخ باشم"
    },
    {
      "id": 73,
      "start": 14048.0,
      "end": 14048.46,
      "formatted_start": "03:54:08.000",
      "formatted_end": "03:54:08.460",
      "text": "برد"
    },
    {
      "id": 74,
      "start": 14048.46,
      "end": 14050.66,
      "formatted_start": "03:54:08.460",
      "formatted_end": "03:54:10.660",
      "text": "بعد لب پاشو اینجایی ماساج بدی"
    },
    {
      "id": 75,
      "start": 14051.16,
      "end": 14052.54,
      "formatted_start": "03:54:11.160",
      "formatted_end": "03:54:12.540",
      "text": "چرخستش فرد نداره"
    },
    {
      "id": 76,
      "start": 14052.54,
      "end": 14053.46,
      "formatted_start": "03:54:12.540",
      "formatted_end": "03:54:13.460",
      "text": "نه فرد برد"
    },
    {
      "id": 77,
      "start": 14053.46,
      "end": 14055.0,
      "formatted_start": "03:54:13.460",
      "formatted_end": "03:54:15.000",
      "text": "لب پاشو ماساج بدی"
    },
    {
      "id": 78,
      "start": 14055.0,
      "end": 14058.8,
      "formatted_start": "03:54:15.000",
      "formatted_end": "03:54:18.800",
      "text": "بعد شکرمش رو در جهت افراش ماساج بدی"
    },
    {
      "id": 79,
      "start": 14058.8,
      "end": 14059.46,
      "formatted_start": "03:54:18.800",
      "formatted_end": "03:54:19.460",
      "text": "برد"
    },
    {
      "id": 80,
      "start": 14059.7,
