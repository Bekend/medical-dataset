      "end": 376.0,
      "formatted_start": "00:05:46.000",
      "formatted_end": "00:06:16.000",
      "text": "اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
