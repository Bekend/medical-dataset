  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6902.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:02.000",
      "text": "از پری شب شده؟"
    },
    {
      "id": 1,
      "start": 6902.0,
      "end": 6906.0,
      "formatted_start": "01:55:02.000",
      "formatted_end": "01:55:06.000",
      "text": "آره، پری شب یه مسافره برگشتیم، گفت که ماما میرد اینجا جوش در آرده."
    },
    {
      "id": 2,
      "start": 6906.0,
      "end": 6910.0,
      "formatted_start": "01:55:06.000",
      "formatted_end": "01:55:10.000",
      "text": "من همجا شکل به آب ام آبای کردم چون دنبال شکل بود."
    },
    {
      "id": 3,
      "start": 6910.0,
      "end": 6914.0,
      "formatted_start": "01:55:10.000",
      "formatted_end": "01:55:14.000",
      "text": "بعد یه فرداش رفتم سرکار، صبح دیدم یعنی واقعاً اشتراک دارم."
    },
    {
      "id": 4,
      "start": 6914.0,
      "end": 6925.0,
      "formatted_start": "01:55:14.000",
      "formatted_end": "01:55:25.000",
      "text": "از اینجا برگشتیم، گفت که ماما اینجا جوش دارد. من همونجا شکل به آب امورای بردم چون دنبال شکل بود."
    },
    {
      "id": 5,
      "start": 6925.0,
      "end": 6931.0,
      "formatted_start": "01:55:25.000",
      "formatted_end": "01:55:31.000",
      "text": "بعد دیگه فردا شرفتم سر کار، صبح دیدم، یعنی واقعا از شکل شروع شده."
    },
    {
      "id": 6,
      "start": 6931.0,
      "end": 6942.0,
      "formatted_start": "01:55:31.000",
      "formatted_end": "01:55:42.000",
      "text": "آره، توفیق دره بیشتر هم میشه. تا فردا بیشتر میشه. خب، بلی معمولا اگه آسیکلاوی رو تو چه برای ساعت اول شروع میکنید، معرضی هاشون خیلی خفیفتر میشه."
    },
    {
      "id": 7,
      "start": 6942.0,
      "end": 6972.0,
      "formatted_start": "01:55:42.000",
      "formatted_end": "01:56:12.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 8,
      "start": 6972.0,
      "end": 7002.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:42.000",
      "text": "از اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 9,
      "start": 7002.0,
      "end": 7005.0,
      "formatted_start": "01:56:42.000",
      "formatted_end": "01:56:45.000",
      "text": "هر روز همون بشه"
    },
    {
      "id": 10,
      "start": 7005.0,
      "end": 7008.0,
      "formatted_start": "01:56:45.000",
      "formatted_end": "01:56:48.000",
      "text": "با این سامون دستتو کفی کن"
    },
    {
      "id": 11,
      "start": 7008.0,
      "end": 7010.0,
      "formatted_start": "01:56:48.000",
      "formatted_end": "01:56:50.000",
      "text": "تمام بجنشو بزن"
    },
    {
      "id": 12,
      "start": 7010.0,
      "end": 7012.0,
      "formatted_start": "01:56:50.000",
      "formatted_end": "01:56:52.000",
      "text": "دوش بگیره بپیره همین"
    },
    {
      "id": 13,
      "start": 7012.0,
      "end": 7014.0,
      "formatted_start": "01:56:52.000",
      "formatted_end": "01:56:54.000",
      "text": "یعنی یه سه چهار دقیقه همون بپنه همون"
    },
    {
      "id": 14,
      "start": 7014.0,
      "end": 7016.0,
      "formatted_start": "01:56:54.000",
      "formatted_end": "01:56:56.000",
      "text": "درمانش همینه دیگه"
    },
    {
      "id": 15,
      "start": 7016.0,
      "end": 7018.0,
      "formatted_start": "01:56:56.000",
      "formatted_end": "01:56:58.000",
      "text": "خب انشاده که با همین خوب بشه"
    },
    {
      "id": 16,
      "start": 7018.0,
      "end": 7021.0,
      "formatted_start": "01:56:58.000",
      "formatted_end": "01:57:01.000",
      "text": "اگر مشکل جدید رو پیدا کرده بخواهی"
    },
    {
      "id": 17,
      "start": 7023.0,
      "end": 7027.0,
      "formatted_start": "01:57:03.000",
      "formatted_end": "01:57:07.000",
      "text": "خاندکتر یه حال دیگه بسایی نمیدونم از مهرم پرسیدم"
    },
    {
      "id": 18,
      "start": 7027.0,
      "end": 7029.0,
      "formatted_start": "01:57:07.000",
      "formatted_end": "01:57:09.000",
      "text": "گفت که نه کسی آبال مهرم نست"
    },
    {
      "id": 19,
      "start": 7029.0,
      "end": 7033.0,
      "formatted_start": "01:57:09.000",
      "formatted_end": "01:57:13.000",
      "text": "این روزه هفته پیش این با یه نفر که آوره مرخوش داشته"
    },
    {
      "id": 20,
      "start": 7033.0,
      "end": 7035.0,
      "formatted_start": "01:57:13.000",
      "formatted_end": "01:57:15.000",
      "text": "در غماس بوده خب"
    },
    {
      "id": 21,
      "start": 7035.0,
      "end": 7038.0,
      "formatted_start": "01:57:15.000",
      "formatted_end": "01:57:18.000",
      "text": "شاید نصادر مانده"
    },
    {
      "id": 22,
      "start": 7038.0,
      "end": 7041.0,
      "formatted_start": "01:57:18.000",
      "formatted_end": "01:57:21.000",
      "text": "بله الان فصل شدید دیگه"
    },
    {
      "id": 23,
      "start": 7041.0,
      "end": 7042.0,
      "formatted_start": "01:57:21.000",
      "formatted_end": "01:57:22.000",
      "text": "اون بلای پیماش هم هست"
    },
    {
      "id": 24,
      "start": 7042.0,
      "end": 7046.0,
      "formatted_start": "01:57:22.000",
      "formatted_end": "01:57:26.000",
      "text": "آره شدید گرفته سر کرد و صبح شروع کنندش دارش"
    },
    {
      "id": 25,
      "start": 7046.0,
      "end": 7050.0,
      "formatted_start": "01:57:26.000",
      "formatted_end": "01:57:30.000",
      "text": "اون یکی از این فرار میکنه که یه نزدیک هم نشونه"
    },
    {
      "id": 26,
      "start": 7050.0,
      "end": 7055.0,
      "formatted_start": "01:57:30.000",
      "formatted_end": "01:57:35.000",
      "text": "نه بگو که تو بگیره احتمالتوی هست"
    },
    {
      "id": 27,
      "start": 7055.0,
      "end": 7066.0,
      "formatted_start": "01:57:35.000",
      "formatted_end": "01:57:46.000",
      "text": "اگر بخواد از این بگیره همون سه هفته دیگه بگیره. اگر بخواد مثلا این دوتا از یه نفر دیگه گرفته روشن ممکن همین الان هم بگیره."
    },
    {
      "id": 28,
      "start": 7066.0,
      "end": 7069.0,
      "formatted_start": "01:57:46.000",
      "formatted_end": "01:57:49.000",
      "text": "بخواد بگیره."
    },
    {
      "id": 29,
      "start": 7069.0,
      "end": 7073.0,
      "formatted_start": "01:57:49.000",
      "formatted_end": "01:57:53.000",
      "text": "خوب."
    },
    {
      "id": 30,
      "start": 7073.0,
      "end": 7081.0,
      "formatted_start": "01:57:53.000",
      "formatted_end": "01:58:01.000",
      "text": "گلپه میخوام فقط سابون نرم اونو بگیره؟"
    },
    {
      "id": 31,
      "start": 7081.0,
      "end": 7089.0,
      "formatted_start": "01:58:01.000",
      "formatted_end": "01:58:09.000",
      "text": "آره هر روز همون بکنید. یک دوش پنج دقیقی. این باعث میشه که دیگه افناس سانم بیرون نکنه."
    },
    {
      "id": 32,
      "start": 7091.0,
      "end": 7100.0,
      "formatted_start": "01:58:11.000",
      "formatted_end": "01:58:20.000",
      "text": "بعد برای صورت هاش همیشه روی به اسم دارید سالبوتان بود فقط لبن. پرتون نکنه. پرتون دارن. فقط سالبوتان."
    },
    {
      "id": 33,
      "start": 7101.0,
      "end": 7105.0,
      "formatted_start": "01:58:21.000",
      "formatted_end": "01:58:25.000",
      "text": "داری یا برسن؟ سالبوتان بود دارم. داری؟"
    },
    {
      "id": 34,
      "start": 7105.0,
      "end": 7107.0,
      "formatted_start": "01:58:25.000",
      "formatted_end": "01:58:27.000",
      "text": "باید بشه بود نیدون دارم"
    },
    {
      "id": 35,
      "start": 7119.0,
      "end": 7121.0,
      "formatted_start": "01:58:39.000",
      "formatted_end": "01:58:41.000",
      "text": "چرا خوانده تو این کار رو میکنی؟"
    },
    {
      "id": 36,
      "start": 7121.0,
      "end": 7123.0,
      "formatted_start": "01:58:41.000",
      "formatted_end": "01:58:43.000",
      "text": "خوانده نیست"
    },
    {
      "id": 37,
      "start": 7125.0,
      "end": 7127.0,
      "formatted_start": "01:58:45.000",
      "formatted_end": "01:58:47.000",
      "text": "خوبونه شما"
    },
    {
      "id": 38,
      "start": 7127.0,
      "end": 7129.0,
      "formatted_start": "01:58:47.000",
      "formatted_end": "01:58:49.000",
      "text": "یه جایزه بهت برم"
    },
    {
      "id": 39,
      "start": 7129.0,
      "end": 7131.0,
      "formatted_start": "01:58:49.000",
      "formatted_end": "01:58:51.000",
      "text": "اداده شو تنبهه"
    },
    {
      "id": 40,
      "start": 7131.0,
      "end": 7133.0,
      "formatted_start": "01:58:51.000",
      "formatted_end": "01:58:53.000",
      "text": "مرد سر مرد کده شو برم"
    },
    {
      "id": 41,
      "start": 7133.0,
      "end": 7135.0,
      "formatted_start": "01:58:53.000",
      "formatted_end": "01:58:55.000",
      "text": "خوش آمده ای خدافت برم"
    },
    {
      "id": 42,
      "start": 7135.0,
      "end": 7137.0,
      "formatted_start": "01:58:55.000",
      "formatted_end": "01:58:57.000",
      "text": "خوش آمده ای خدافت برم"
    },
    {
      "id": 43,
      "start": 7137.0,
      "end": 7139.0,
      "formatted_start": "01:58:57.000",
      "formatted_end": "01:58:59.000",
      "text": "خوش آمده ای خدافت برم"
    },
    {
      "id": 44,
      "start": 7155.0,
      "end": 7157.0,
      "formatted_start": "01:59:15.000",
      "formatted_end": "01:59:17.000",
      "text": "سلام خدافت برم"
    },
    {
      "id": 45,
      "start": 7157.0,
      "end": 7159.0,
      "formatted_start": "01:59:17.000",
      "formatted_end": "01:59:19.000",
      "text": "اینجا اینجا بزرگ شده خالصه"
    },
    {
      "id": 46,
      "start": 7159.0,
      "end": 7161.0,
      "formatted_start": "01:59:19.000",
      "formatted_end": "01:59:21.000",
      "text": "خالصه"
    },
    {
      "id": 47,
      "start": 7161.0,
      "end": 7163.0,
      "formatted_start": "01:59:21.000",
      "formatted_end": "01:59:23.000",
      "text": "باید بزرگ بشه"
    },
    {
      "id": 48,
      "start": 7163.0,
      "end": 7165.0,
      "formatted_start": "01:59:23.000",
      "formatted_end": "01:59:25.000",
      "text": "خوبی شما؟"
    },
    {
      "id": 49,
      "start": 7165.0,
      "end": 7167.0,
      "formatted_start": "01:59:25.000",
      "formatted_end": "01:59:27.000",
      "text": "نیستی؟ خواست نمیشه؟"
    },
    {
      "id": 50,
      "start": 7167.0,
      "end": 7169.0,
      "formatted_start": "01:59:27.000",
      "formatted_end": "01:59:29.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 51,
      "start": 7169.0,
      "end": 7171.0,
      "formatted_start": "01:59:29.000",
      "formatted_end": "01:59:31.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 52,
      "start": 7171.0,
      "end": 7173.0,
      "formatted_start": "01:59:31.000",
      "formatted_end": "01:59:33.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 53,
      "start": 7173.0,
      "end": 7175.0,
      "formatted_start": "01:59:33.000",
      "formatted_end": "01:59:35.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 54,
      "start": 7175.0,
      "end": 7177.0,
      "formatted_start": "01:59:35.000",
      "formatted_end": "01:59:37.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 55,
      "start": 7177.0,
      "end": 7179.0,
      "formatted_start": "01:59:37.000",
      "formatted_end": "01:59:39.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 56,
      "start": 7179.0,
      "end": 7181.0,
      "formatted_start": "01:59:39.000",
      "formatted_end": "01:59:41.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 57,
      "start": 7181.0,
      "end": 7183.0,
      "formatted_start": "01:59:41.000",
      "formatted_end": "01:59:43.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 58,
      "start": 7183.0,
      "end": 7185.0,
      "formatted_start": "01:59:43.000",
      "formatted_end": "01:59:45.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 59,
      "start": 7185.0,
      "end": 7187.0,
      "formatted_start": "01:59:45.000",
      "formatted_end": "01:59:47.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 60,
      "start": 7187.0,
      "end": 7189.0,
      "formatted_start": "01:59:47.000",
      "formatted_end": "01:59:49.000",
      "text": "نیستی؟ چه حوارات؟"
    },
    {
      "id": 61,
      "start": 7189.0,
      "end": 7193.4,
      "formatted_start": "01:59:49.000",
      "formatted_end": "01:59:53.400",
      "text": "این حالت عادتی که میخوانم بیداره کامل عشیار میگه دستشوی داره"
    },
    {
      "id": 62,
      "start": 7193.4,
      "end": 7197.6,
      "formatted_start": "01:59:53.400",
      "formatted_end": "01:59:57.600",
      "text": "ولی چه ظهر بخوابه چه شب بخوابه بیداره میشه خیسته"
    },
    {
      "id": 63,
      "start": 7197.6,
      "end": 7200.0,
      "formatted_start": "01:59:57.600",
      "formatted_end": "02:00:00.000",
      "text": "و موقعی که بیداره تن تن دستشوی داره"
    }
