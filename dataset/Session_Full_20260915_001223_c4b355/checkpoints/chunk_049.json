  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14729.98,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 14760.0,
      "end": 14782.0,
      "formatted_start": "04:06:00.000",
      "formatted_end": "04:06:22.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 14790.0,
      "end": 14792.0,
      "formatted_start": "04:06:30.000",
      "formatted_end": "04:06:32.000",
      "text": "برای که اون رو برای کهان بیادشت"
    },
    {
      "id": 3,
      "start": 14792.0,
      "end": 14794.0,
      "formatted_start": "04:06:32.000",
      "formatted_end": "04:06:34.000",
      "text": "خوشتاری تقوم به شما"
    },
    {
      "id": 4,
      "start": 14794.0,
      "end": 14796.0,
      "formatted_start": "04:06:34.000",
      "formatted_end": "04:06:36.000",
      "text": "نه، زیادتر"
    },
    {
      "id": 5,
      "start": 14796.0,
      "end": 14798.0,
      "formatted_start": "04:06:36.000",
      "formatted_end": "04:06:38.000",
      "text": "خموز رو زنگ دارید بپسن؟"
    },
    {
      "id": 6,
      "start": 14798.0,
      "end": 14800.0,
      "formatted_start": "04:06:38.000",
      "formatted_end": "04:06:40.000",
      "text": "بپسن"
    },
    {
      "id": 7,
      "start": 14800.0,
      "end": 14802.0,
      "formatted_start": "04:06:40.000",
      "formatted_end": "04:06:42.000",
      "text": "بپسن، بپن و بذاریم"
    },
    {
      "id": 8,
      "start": 14808.0,
      "end": 14810.0,
      "formatted_start": "04:06:48.000",
      "formatted_end": "04:06:50.000",
      "text": "بپن خوشتاری، زلا، ممنون خوبه"
    },
    {
      "id": 9,
      "start": 14810.0,
      "end": 14812.0,
      "formatted_start": "04:06:50.000",
      "formatted_end": "04:06:52.000",
      "text": "زلا، ممنون، ممنون"
    },
    {
      "id": 10,
      "start": 14812.0,
      "end": 14814.0,
      "formatted_start": "04:06:52.000",
      "formatted_end": "04:06:54.000",
      "text": "ممنون، ممنون، ممنون، ممنون، ممنون"
    },
    {
      "id": 11,
      "start": 14814.0,
      "end": 14816.0,
      "formatted_start": "04:06:54.000",
      "formatted_end": "04:06:56.000",
      "text": "ممنون، ممنون، ممنون، ممنون"
    },
    {
      "id": 12,
      "start": 14816.0,
      "end": 14818.0,
      "formatted_start": "04:06:56.000",
      "formatted_end": "04:06:58.000",
      "text": "چی شناختم بزارید؟"
    },
    {
      "id": 13,
      "start": 14818.0,
      "end": 14826.0,
      "formatted_start": "04:06:58.000",
      "formatted_end": "04:07:06.000",
      "text": "این کامبوس رو چکش کنن، محسن چارویگی داره، که همه دوری تب و توت صرفه داره"
    },
    {
      "id": 14,
      "start": 14826.0,
      "end": 14833.0,
      "formatted_start": "04:07:06.000",
      "formatted_end": "04:07:13.000",
      "text": "و کامبوس های موزنی که در عرمان هم جدیده هست، سرش خیلی کف میشه و عرق میپازه"
    },
    {
      "id": 15,
      "start": 14833.0,
      "end": 14839.0,
      "formatted_start": "04:07:13.000",
      "formatted_end": "04:07:19.000",
      "text": "اینکه هم تب و تب داره، برای اینکه همه موزن بیره گردن و بیره سینج"
    },
    {
      "id": 16,
      "start": 14839.0,
      "end": 14846.0,
      "formatted_start": "04:07:19.000",
      "formatted_end": "04:07:26.000",
      "text": "ببین عجیزم، اولا که تب با عرق کردن متضاد داره، یعنی نمیشه یه بچه هم تب کن هم عرق کنه"
    },
    {
      "id": 17,
      "start": 14846.0,
      "end": 14852.0,
      "formatted_start": "04:07:26.000",
      "formatted_end": "04:07:32.000",
      "text": "چون کلن عرق کردن برای سرد کردن هم بردن کنید"
    },
    {
      "id": 18,
      "start": 14852.0,
      "end": 14859.0,
      "formatted_start": "04:07:32.000",
      "formatted_end": "04:07:39.000",
      "text": "و وقتی که یکی تب میکنه، بدنش داره تمام تلاش خودشو می کنه که درجه حرارت بره بالا"
    },
    {
      "id": 19,
      "start": 14859.0,
      "end": 14861.0,
      "formatted_start": "04:07:39.000",
      "formatted_end": "04:07:41.000",
      "text": "در نتیجه عرق نمی کنه"
    },
    {
      "id": 20,
      "start": 14861.0,
      "end": 14868.0,
      "formatted_start": "04:07:41.000",
      "formatted_end": "04:07:48.000",
      "text": "و وقتی ما تب بر میدیم، درجه حرارت می آییم پایین تا آزه بدن برای که خنک بشه عرق میکنه"
    },
    {
      "id": 21,
      "start": 14868.0,
      "end": 14873.0,
      "formatted_start": "04:07:48.000",
      "formatted_end": "04:07:53.000",
      "text": "فس امکان نداده یه بچه همانو تب داشته باشه هم عرق میکنه"
    },
    {
      "id": 22,
      "start": 14873.0,
      "end": 14879.0,
      "formatted_start": "04:07:53.000",
      "formatted_end": "04:07:59.000",
      "text": "بچه ها معلوم از سوت و ساز بدنشون بالا دردنشون زیاد گرم شد"
    },
    {
      "id": 23,
      "start": 14879.0,
      "end": 14884.0,
      "formatted_start": "04:07:59.000",
      "formatted_end": "04:08:04.000",
      "text": "آه بنایی که انرژی بیشتری آزاد می کنه در اصل سوت و ساز"
    },
    {
      "id": 24,
      "start": 14884.0,
      "end": 14889.0,
      "formatted_start": "04:08:04.000",
      "formatted_end": "04:08:09.000",
      "text": "آه دردنشون بدنش گرم تره و عرام همیشه عرام کنه"
    },
    {
      "id": 25,
      "start": 14889.0,
      "end": 14893.0,
      "formatted_start": "04:08:09.000",
      "formatted_end": "04:08:13.000",
      "text": "حالا وقتی بچه کمبود ویتامین دید داشته بشه این تحریک دوان آور می شه"
    },
    {
      "id": 26,
      "start": 14893.0,
      "end": 14895.0,
      "formatted_start": "04:08:13.000",
      "formatted_end": "04:08:15.000",
      "text": "شما عادل بهش می دینید بیرون؟"
    },
    {
      "id": 27,
      "start": 14895.0,
      "end": 14899.0,
      "formatted_start": "04:08:15.000",
      "formatted_end": "04:08:19.000",
      "text": "آه برون بیرون خودم هم ویتامین دید رو استفاده می کنم"
    },
    {
      "id": 28,
      "start": 14899.0,
      "end": 14902.22,
      "formatted_start": "04:08:19.000",
      "formatted_end": "04:08:22.220",
      "text": "بله"
    },
    {
      "id": 29,
      "start": 14902.22,
      "end": 14904.66,
      "formatted_start": "04:08:22.220",
      "formatted_end": "04:08:24.660",
      "text": "سلامتی زمان"
    },
    {
      "id": 30,
      "start": 14904.66,
      "end": 14905.28,
      "formatted_start": "04:08:24.660",
      "formatted_end": "04:08:25.280",
      "text": "مرسی جان"
    },
    {
      "id": 31,
      "start": 14905.28,
      "end": 14906.24,
      "formatted_start": "04:08:25.280",
      "formatted_end": "04:08:26.240",
      "text": "جان"
    },
    {
      "id": 32,
      "start": 14906.24,
      "end": 14910.26,
      "formatted_start": "04:08:26.240",
      "formatted_end": "04:08:30.260",
      "text": "دیفنس"
    },
    {
      "id": 33,
      "start": 14910.26,
      "end": 14913.38,
      "formatted_start": "04:08:30.260",
      "formatted_end": "04:08:33.380",
      "text": "چرا هستش که صبح من بر چند تا نوشتم"
    },
    {
      "id": 34,
      "start": 14913.38,
      "end": 14914.64,
      "formatted_start": "04:08:33.380",
      "formatted_end": "04:08:34.640",
      "text": "همه گرفتم"
    },
    {
      "id": 35,
      "start": 14914.64,
      "end": 14915.98,
      "formatted_start": "04:08:34.640",
      "formatted_end": "04:08:35.980",
      "text": "از کجا رفتی بگیری"
    },
    {
      "id": 36,
      "start": 14915.98,
      "end": 14920.64,
      "formatted_start": "04:08:35.980",
      "formatted_end": "04:08:40.640",
      "text": "آره گنبت که داره"
    },
    {
      "id": 37,
      "start": 14920.64,
      "end": 14923.06,
      "formatted_start": "04:08:40.640",
      "formatted_end": "04:08:43.060",
      "text": "میدونش میدونم کدوم داره خونش داشته باشه"
    },
    {
      "id": 38,
      "start": 14923.06,
      "end": 14925.18,
      "formatted_start": "04:08:43.060",
      "formatted_end": "04:08:45.180",
      "text": "بله گنبت که داره همه جا"
    },
    {
      "id": 39,
      "start": 14925.18,
      "end": 14928.42,
      "formatted_start": "04:08:45.180",
      "formatted_end": "04:08:48.420",
      "text": "آره ببین گنبت داره خونه"
    },
    {
      "id": 40,
      "start": 14928.42,
      "end": 14931.42,
      "formatted_start": "04:08:48.420",
      "formatted_end": "04:08:51.420",
      "text": "در خونه تارتار داره، در خونه کوگی داره، هر دوتاشون دارن"
    },
    {
      "id": 41,
      "start": 14931.42,
      "end": 14934.42,
      "formatted_start": "04:08:51.420",
      "formatted_end": "04:08:54.420",
      "text": "خب، پوپک حقیقت داره، در خونه دکتر حقیقت"
    },
    {
      "id": 42,
      "start": 14934.42,
      "end": 14938.42,
      "formatted_start": "04:08:54.420",
      "formatted_end": "04:08:58.420",
      "text": "اونم داره، آره عزیزم، خواهد آمده بود"
    },
    {
      "id": 43,
      "start": 14942.42,
      "end": 14944.42,
      "formatted_start": "04:09:02.420",
      "formatted_end": "04:09:04.420",
      "text": "عروض، تعمیدی شد که... آره بود"
    },
    {
      "id": 44,
      "start": 14944.42,
      "end": 14946.42,
      "formatted_start": "04:09:04.420",
      "formatted_end": "04:09:06.420",
      "text": "...در این حالت هم میگرد"
    },
    {
      "id": 45,
      "start": 14946.42,
      "end": 14948.42,
      "formatted_start": "04:09:06.420",
      "formatted_end": "04:09:08.420",
      "text": "میگم، یه گلده دیدم، مثلا در آقای آباز اونم"
    },
    {
      "id": 46,
      "start": 14948.42,
      "end": 14950.42,
      "formatted_start": "04:09:08.420",
      "formatted_end": "04:09:10.420",
      "text": "برای مثلا شیر خوردن بیشتره"
    },
    {
      "id": 47,
      "start": 14950.42,
      "end": 14953.42,
      "formatted_start": "04:09:10.420",
      "formatted_end": "04:09:13.420",
      "text": "بیشتره، مثلا تا یک سالگی هم بیرون بچه"
    },
    {
      "id": 48,
      "start": 14953.42,
      "end": 14955.42,
      "formatted_start": "04:09:13.420",
      "formatted_end": "04:09:15.420",
      "text": "حتی قای تا ایش درده"
    },
    {
      "id": 49,
      "start": 14955.42,
      "end": 14959.42,
      "formatted_start": "04:09:15.420",
      "formatted_end": "04:09:19.420",
      "text": "خواندکتر من جای باکسنج رو میگم کاریم"
    },
    {
      "id": 50,
      "start": 14959.42,
      "end": 14961.42,
      "formatted_start": "04:09:19.420",
      "formatted_end": "04:09:21.420",
      "text": "من هم باکسنج دمرگیر گردم"
    },
    {
      "id": 51,
      "start": 14961.42,
      "end": 14963.42,
      "formatted_start": "04:09:21.420",
      "formatted_end": "04:09:23.420",
      "text": "بعد هم شامورم پیشتون چکش کردم"
    },
    {
      "id": 52,
      "start": 14963.42,
      "end": 14964.42,
      "formatted_start": "04:09:23.420",
      "formatted_end": "04:09:24.420",
      "text": "کجا اینا؟"
    },
    {
      "id": 53,
      "start": 14964.42,
      "end": 14966.42,
      "formatted_start": "04:09:24.420",
      "formatted_end": "04:09:26.420",
      "text": "خواهی چپش"
    },
    {
      "id": 54,
      "start": 14966.42,
      "end": 14969.42,
      "formatted_start": "04:09:26.420",
      "formatted_end": "04:09:29.420",
      "text": "اصلا دوست دوزه اولو اوکی بود و اینا"
    },
    {
      "id": 55,
      "start": 14969.42,
      "end": 14971.42,
      "formatted_start": "04:09:29.420",
      "formatted_end": "04:09:31.420",
      "text": "یه رو این بچه تب کرد"
    },
    {
      "id": 56,
      "start": 14971.42,
      "end": 14974.42,
      "formatted_start": "04:09:31.420",
      "formatted_end": "04:09:34.420",
      "text": "بعد دوست دوست که تموم شد بعدش تب کرد"
    },
    {
      "id": 57,
      "start": 14974.42,
      "end": 14977.42,
      "formatted_start": "04:09:34.420",
      "formatted_end": "04:09:37.420",
      "text": "بعد من یک هفته دلزه چیز گردم که"
    },
    {
      "id": 58,
      "start": 14977.42,
      "end": 14980.42,
      "formatted_start": "04:09:37.420",
      "formatted_end": "04:09:40.420",
      "text": "دل نزنم، شیر، آب نزنم، پکون برای آز کنم"
    },
    {
      "id": 59,
      "start": 14980.42,
      "end": 14982.42,
      "formatted_start": "04:09:40.420",
      "formatted_end": "04:09:42.420",
      "text": "اینجا باید بچه ها تب کردند"
    },
    {
      "id": 60,
      "start": 14982.42,
      "end": 14984.42,
      "formatted_start": "04:09:42.420",
      "formatted_end": "04:09:44.420",
      "text": "بعد این تب هی باید قائم میشود"
    },
    {
      "id": 61,
      "start": 14984.42,
      "end": 14987.42,
      "formatted_start": "04:09:44.420",
      "formatted_end": "04:09:47.420",
      "text": "اما اینجا من به تفسر جهان را اعتماد کردم"
    },
    {
      "id": 62,
      "start": 14987.42,
      "end": 14990.42,
      "formatted_start": "04:09:47.420",
      "formatted_end": "04:09:50.420",
      "text": "دو درش، دو درش، دو درش، دو درش را چک می کردم"
    },
    {
      "id": 63,
      "start": 14990.42,
      "end": 14994.42,
      "formatted_start": "04:09:50.420",
      "formatted_end": "04:09:54.420",
      "text": "یک بار بفردن ۳۸ تا یک بار بفردن ۳۷۶"
    },
    {
      "id": 64,
      "start": 14994.42,
      "end": 14995.42,
      "formatted_start": "04:09:54.420",
      "formatted_end": "04:09:55.420",
      "text": "اینجا باید باید پارپانی شد"
    },
    {
      "id": 65,
      "start": 14995.42,
      "end": 14999.42,
      "formatted_start": "04:09:55.420",
      "formatted_end": "04:09:59.420",
      "text": "آخر سال یک شمبش بود"
    }
  ],
  "status": "completed"
}