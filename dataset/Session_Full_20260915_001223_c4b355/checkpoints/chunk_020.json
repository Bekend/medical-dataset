      "start": 6044.82,
      "end": 6047.04,
      "formatted_start": "01:40:44.820",
      "formatted_end": "01:40:47.040",
      "text": "ما گوشت ها ببینیم"
    },
    {
      "id": 7,
      "start": 6047.04,
      "end": 6051.28,
      "formatted_start": "01:40:47.040",
      "formatted_end": "01:40:51.280",
      "text": "این گوشت هم ببینیم"
    },
    {
      "id": 8,
      "start": 6051.28,
      "end": 6051.9,
      "formatted_start": "01:40:51.280",
      "formatted_end": "01:40:51.900",
      "text": "همه"
    },
    {
      "id": 9,
      "start": 6051.9,
      "end": 6056.04,
      "formatted_start": "01:40:51.900",
      "formatted_end": "01:40:56.040",
      "text": "مهمولاً اون بچه ها گل و درد دارن"
    },
    {
      "id": 10,
      "start": 6056.04,
      "end": 6057.1,
      "formatted_start": "01:40:56.040",
      "formatted_end": "01:40:57.100",
      "text": "اشتهاهاش خوبه"
    },
    {
      "id": 11,
      "start": 6057.1,
      "end": 6058.62,
      "formatted_start": "01:40:57.100",
      "formatted_end": "01:40:58.620",
      "text": "خیلی سخت میخوره"
    },
    {
      "id": 12,
      "start": 6058.62,
      "end": 6060.62,
      "formatted_start": "01:40:58.620",
      "formatted_end": "01:41:00.620",
      "text": "شیرک اصلن"
    },
    {
      "id": 13,
      "start": 6060.62,
      "end": 6062.62,
      "formatted_start": "01:41:00.620",
      "formatted_end": "01:41:02.620",
      "text": "خب سرشون از اینجا"
    },
    {
      "id": 14,
      "start": 6062.62,
      "end": 6064.62,
      "formatted_start": "01:41:02.620",
      "formatted_end": "01:41:04.620",
      "text": "نه بگو پیشونشون اگه بسنده"
    },
    {
      "id": 15,
      "start": 6064.62,
      "end": 6066.62,
      "formatted_start": "01:41:04.620",
      "formatted_end": "01:41:06.620",
      "text": "اینجا"
    },
    {
      "id": 16,
      "start": 6066.62,
      "end": 6068.62,
      "formatted_start": "01:41:06.620",
      "formatted_end": "01:41:08.620",
      "text": "ایه دنده باز کن"
    },
    {
      "id": 17,
      "start": 6068.62,
      "end": 6070.62,
      "formatted_start": "01:41:08.620",
      "formatted_end": "01:41:10.620",
      "text": "بزنی خوب"
    },
    {
      "id": 18,
      "start": 6070.62,
      "end": 6072.62,
      "formatted_start": "01:41:10.620",
      "formatted_end": "01:41:12.620",
      "text": "بزنی خوب"
    },
    {
      "id": 19,
      "start": 6072.62,
      "end": 6074.62,
      "formatted_start": "01:41:12.620",
      "formatted_end": "01:41:14.620",
      "text": "آره گلش قرنزه"
    },
    {
      "id": 20,
      "start": 6074.62,
      "end": 6076.62,
      "formatted_start": "01:41:14.620",
      "formatted_end": "01:41:16.620",
      "text": "گلش قرنزه"
    },
    {
      "id": 21,
      "start": 6076.62,
      "end": 6078.62,
      "formatted_start": "01:41:16.620",
      "formatted_end": "01:41:18.620",
      "text": "حالا به قول شما یه ذره آبیسش بیلی داره"
    },
    {
      "id": 22,
      "start": 6078.62,
      "end": 6080.62,
      "formatted_start": "01:41:18.620",
      "formatted_end": "01:41:20.620",
      "text": "یه ذره صرفه میکنه"
    },
    {
      "id": 23,
      "start": 6080.62,
      "end": 6082.62,
      "formatted_start": "01:41:20.620",
      "formatted_end": "01:41:22.620",
      "text": "این دیگه مشخصه یک تخونت ویروسیه"
    },
    {
      "id": 24,
      "start": 6082.62,
      "end": 6084.62,
      "formatted_start": "01:41:22.620",
      "formatted_end": "01:41:24.620",
      "text": "خب آن دیویدی که افضل داره نداره"
    },
    {
      "id": 25,
      "start": 6084.62,
      "end": 6086.62,
      "formatted_start": "01:41:24.620",
      "formatted_end": "01:41:26.620",
      "text": "و تا یه داروشون دیگه"
    },
    {
      "id": 26,
      "start": 6086.62,
      "end": 6091.62,
      "formatted_start": "01:41:26.620",
      "formatted_end": "01:41:31.620",
      "text": "یکم سیستم ایمیلیش تقریب بشه که بتونه سلکن خوبش بخوانه"
    },
    {
      "id": 27,
      "start": 6091.62,
      "end": 6093.62,
      "formatted_start": "01:41:31.620",
      "formatted_end": "01:41:33.620",
      "text": "و دارو باسه یک..."
    },
    {
      "id": 28,
      "start": 6093.62,
      "end": 6096.62,
      "formatted_start": "01:41:33.620",
      "formatted_end": "01:41:36.620",
      "text": "خواندی خوشمزده"
    },
    {
      "id": 29,
      "start": 6096.62,
      "end": 6098.62,
      "formatted_start": "01:41:36.620",
      "formatted_end": "01:41:38.620",
      "text": "کلارژین خوب"
    },
    {
      "id": 30,
      "start": 6098.62,
      "end": 6101.62,
      "formatted_start": "01:41:38.620",
      "formatted_end": "01:41:41.620",
      "text": "که خوشمزده است خیلی روزی"
    },
    {
      "id": 31,
      "start": 6101.62,
      "end": 6105.62,
      "formatted_start": "01:41:41.620",
      "formatted_end": "01:41:45.620",
      "text": "دو بار یک سی سی بهش بده"
    },
    {
      "id": 32,
      "start": 6105.62,
      "end": 6106.62,
      "formatted_start": "01:41:45.620",
      "formatted_end": "01:41:46.620",
      "text": "یه شهرته"
    },
    {
      "id": 33,
      "start": 6106.62,
      "end": 6108.62,
      "formatted_start": "01:41:46.620",
      "formatted_end": "01:41:48.620",
      "text": "یعنی یک سی سی رو تو دو بار بده"
    },
    {
      "id": 34,
      "start": 6108.62,
      "end": 6110.62,
      "formatted_start": "01:41:48.620",
      "formatted_end": "01:41:50.620",
      "text": "نه نه تو دو بار نیست هر بار یک سی سی"
    },
    {
      "id": 35,
      "start": 6110.62,
      "end": 6112.62,
      "formatted_start": "01:41:50.620",
      "formatted_end": "01:41:52.620",
      "text": "نیوتا نیم"
    },
    {
      "id": 36,
      "start": 6112.62,
      "end": 6114.62,
      "formatted_start": "01:41:52.620",
      "formatted_end": "01:41:54.620",
      "text": "هر دوازده ساعت"
    },
    {
      "id": 37,
      "start": 6114.62,
      "end": 6118.62,
      "formatted_start": "01:41:54.620",
      "formatted_end": "01:41:58.620",
      "text": "دو سی سی بهش بگیره واسه یک همه شان ایبوکو رو فردن"
    },
    {
      "id": 38,
      "start": 6118.62,
      "end": 6124.62,
      "formatted_start": "01:41:58.620",
      "formatted_end": "01:42:04.620",
      "text": "رویه هم چهار ساعت، هشت شیش ساعت بزنش کنید"
    },
    {
      "id": 39,
      "start": 6124.62,
      "end": 6128.62,
      "formatted_start": "01:42:04.620",
      "formatted_end": "01:42:08.620",
      "text": "یه ندیده همونی سرگیرش"
    },
    {
      "id": 40,
      "start": 6128.62,
      "end": 6134.62,
      "formatted_start": "01:42:08.620",
      "formatted_end": "01:42:14.620",
      "text": "رویه هم جوی جنگه بود"
    },
    {
      "id": 41,
      "start": 6134.62,
      "end": 6138.62,
      "formatted_start": "01:42:14.620",
      "formatted_end": "01:42:18.620",
      "text": "رویه هم بیا بیا بیا"
    },
    {
      "id": 42,
      "start": 6138.62,
      "end": 6140.62,
      "formatted_start": "01:42:18.620",
      "formatted_end": "01:42:20.620",
      "text": "اینجا اینجا"
    },
    {
      "id": 43,
      "start": 6140.62,
      "end": 6142.62,
      "formatted_start": "01:42:20.620",
      "formatted_end": "01:42:22.620",
      "text": "و..."
    },
    {
      "id": 44,
      "start": 6142.62,
      "end": 6144.62,
      "formatted_start": "01:42:22.620",
      "formatted_end": "01:42:24.620",
      "text": "20"
    },
    {
      "id": 45,
      "start": 6144.62,
      "end": 6146.62,
      "formatted_start": "01:42:24.620",
      "formatted_end": "01:42:26.620",
      "text": "و 105"
    },
    {
      "id": 46,
      "start": 6146.62,
      "end": 6148.62,
      "formatted_start": "01:42:26.620",
      "formatted_end": "01:42:28.620",
      "text": "برشید"
    },
    {
      "id": 47,
      "start": 6148.62,
      "end": 6150.62,
      "formatted_start": "01:42:28.620",
      "formatted_end": "01:42:30.620",
      "text": "چهار سی سی بهش بده"
    },
    {
      "id": 48,
      "start": 6150.62,
      "end": 6152.62,
      "formatted_start": "01:42:30.620",
      "formatted_end": "01:42:32.620",
      "text": "یا شیافه از دامینافرم برش بزن"
    },
    {
      "id": 49,
      "start": 6152.62,
      "end": 6154.62,
      "formatted_start": "01:42:32.620",
      "formatted_end": "01:42:34.620",
      "text": "اگه دیدید نیمی کوره یکی"
    },
    {
      "id": 50,
      "start": 6154.62,
      "end": 6156.62,
      "formatted_start": "01:42:34.620",
      "formatted_end": "01:42:36.620",
      "text": "شیافه از دامینافرم"
    },
    {
      "id": 51,
      "start": 6156.62,
      "end": 6158.62,
      "formatted_start": "01:42:36.620",
      "formatted_end": "01:42:38.620",
      "text": "125"
    },
    {
      "id": 52,
      "start": 6158.62,
      "end": 6160.62,
      "formatted_start": "01:42:38.620",
      "formatted_end": "01:42:40.620",
      "text": "هر چهار ساعت هم میتونی براش"
    },
    {
      "id": 53,
      "start": 6160.62,
      "end": 6162.62,
      "formatted_start": "01:42:40.620",
      "formatted_end": "01:42:42.620",
      "text": "اینطوره بگذارید"
    },
    {
      "id": 54,
      "start": 6162.62,
      "end": 6164.62,
      "formatted_start": "01:42:42.620",
      "formatted_end": "01:42:44.620",
      "text": "تو چند داروهای شده؟"
    },
    {
      "id": 55,
      "start": 6164.62,
      "end": 6166.62,
      "formatted_start": "01:42:44.620",
      "formatted_end": "01:42:46.620",
      "text": "داروها شده و وقتی که علامت دارد"
    },
    {
      "id": 56,
      "start": 6166.62,
      "end": 6168.62,
      "formatted_start": "01:42:46.620",
      "formatted_end": "01:42:48.620",
      "text": "که خوب شد میتونی ندید"
    },
    {
      "id": 57,
      "start": 6168.62,
      "end": 6170.62,
      "formatted_start": "01:42:48.620",
      "formatted_end": "01:42:50.620",
      "text": "اون سه سیستم ایمینش هست"
    },
    {
      "id": 58,
      "start": 6170.62,
      "end": 6174.62,
      "formatted_start": "01:42:50.620",
      "formatted_end": "01:42:54.620",
      "text": "اینش البته لیکو میان براش مینوسم"
    },
    {
      "id": 59,
      "start": 6174.62,
      "end": 6178.62,
      "formatted_start": "01:42:54.620",
      "formatted_end": "01:42:58.620",
      "text": "روزی دو سی سی بهش بدم"
    },
    {
      "id": 60,
      "start": 6178.62,
      "end": 6182.62,
      "formatted_start": "01:42:58.620",
      "formatted_end": "01:43:02.620",
      "text": "خاندکتر زینکو بهش میدم والا میاره"
    },
    {
      "id": 61,
      "start": 6182.62,
      "end": 6185.62,
      "formatted_start": "01:43:02.620",
      "formatted_end": "01:43:05.620",
      "text": "این یک دونه تو اینستایی پیج پیجاویه بود"
    },
    {
      "id": 62,
      "start": 6185.62,
      "end": 6187.62,
      "formatted_start": "01:43:05.620",
      "formatted_end": "01:43:07.620",
      "text": "اینو سفارش دادم"
    },
    {
      "id": 63,
      "start": 6187.62,
      "end": 6189.62,
      "formatted_start": "01:43:07.620",
      "formatted_end": "01:43:09.620",
      "text": "سفارش دادیم"
    },
    {
      "id": 64,
      "start": 6189.62,
      "end": 6192.62,
      "formatted_start": "01:43:09.620",
      "formatted_end": "01:43:12.620",
      "text": "هم ملتی ویتامینشو هم زینکشو هم هم"
    },
    {
      "id": 65,
      "start": 6192.62,
      "end": 6194.62,
      "formatted_start": "01:43:12.620",
      "formatted_end": "01:43:14.620",
      "text": "نمیدونم این مزه شو این دوست روشته ماشه یا نه"
    },
    {
      "id": 66,
      "start": 6194.62,
      "end": 6196.62,
      "formatted_start": "01:43:14.620",
      "formatted_end": "01:43:16.620",
      "text": "خوبتا میکرده"
    },
    {
      "id": 67,
      "start": 6196.62,
      "end": 6198.62,
      "formatted_start": "01:43:16.620",
      "formatted_end": "01:43:18.620",
      "text": "ولی خوبه"
    },
    {
      "id": 68,
      "start": 6198.62,
      "end": 6200.62,
      "formatted_start": "01:43:18.620",
      "formatted_end": "01:43:20.620",
      "text": "الان من این کمیون رو بازش نوشتم"
    },
    {
      "id": 69,
      "start": 6200.62,
      "end": 6202.62,
      "formatted_start": "01:43:20.620",
      "formatted_end": "01:43:22.620",
      "text": "پس"
    },
    {
      "id": 70,
      "start": 6220.62,
      "end": 6222.62,
      "formatted_start": "01:43:40.620",
      "formatted_end": "01:43:42.620",
      "text": "به جنشگیر رو پس من بگذارم که"
    },
    {
      "id": 71,
      "start": 6222.62,
      "end": 6224.62,
      "formatted_start": "01:43:42.620",
      "formatted_end": "01:43:44.620",
      "text": "دیفنس بنویسم"
    },
    {
      "id": 72,
      "start": 6224.62,
      "end": 6230.62,
      "formatted_start": "01:43:44.620",
      "formatted_end": "01:43:50.620",
      "text": "این روزی دو و نیم سی سی بهش بده این خوشمزده است"
    },
    {
      "id": 73,
      "start": 6230.62,
      "end": 6234.62,
      "formatted_start": "01:43:50.620",
      "formatted_end": "01:43:54.620",
      "text": "دیگه چون اونو سفارش دادید مشابه میشه دیگه من رو بادرم"
    },
    {
      "id": 74,
      "start": 6234.62,
      "end": 6237.62,
      "formatted_start": "01:43:54.620",
      "formatted_end": "01:43:57.620",
      "text": "از کاندول اجهان خود که این رو بردیم بدیم"
    },
    {
      "id": 75,
      "start": 6237.62,
      "end": 6242.62,
      "formatted_start": "01:43:57.620",
      "formatted_end": "01:44:02.620",
      "text": "که من در حال این پرو بیوتیک اون بهتر یقین"
    },
    {
      "id": 76,
      "start": 6242.62,
      "end": 6246.62,
      "formatted_start": "01:44:02.620",
      "formatted_end": "01:44:06.620",
      "text": "شیر و خشکای آبتامیل پورونوترا"
    },
    {
      "id": 77,
      "start": 6246.62,
      "end": 6248.62,
      "formatted_start": "01:44:06.620",
      "formatted_end": "01:44:08.620",
      "text": "برمون بگو"
    },
    {
      "id": 78,
      "start": 6248.62,
      "end": 6257.62,
      "formatted_start": "01:44:08.620",
      "formatted_end": "01:44:17.620",
      "text": "ببین کارخونه اومده یه لائن جدید زده اونهایی که تو این لائن جدیدش تولید میشه اسمش پراناتوست"
    },
    {
      "id": 79,
      "start": 6257.62,
      "end": 6262.62,
      "formatted_start": "01:44:17.620",
      "formatted_end": "01:44:22.620",
      "text": "بقیه ازش افراده ترکیبش پر نماید ولی اچ آب آین پراناتوست"
    },
    {
      "id": 80,
      "start": 6262.62,
      "end": 6266.62,
      "formatted_start": "01:44:22.620",
      "formatted_end": "01:44:26.620",
      "text": "اچ آب والد حساسیته زده حساسیته نه این خیلی خوبه"
    },
    {
      "id": 81,
      "start": 6266.62,
      "end": 6268.62,
      "formatted_start": "01:44:26.620",
      "formatted_end": "01:44:28.620",
      "text": "نه اگه آوردم این چطور رو نه"
    },
    {
      "id": 82,
      "start": 6268.62,
      "end": 6270.62,
      "formatted_start": "01:44:28.620",
      "formatted_end": "01:44:30.620",
      "text": "نه اگه آوردم شما دیگه دارید که"
    },
    {
      "id": 83,
      "start": 6270.62,
      "end": 6272.62,
      "formatted_start": "01:44:30.620",
      "formatted_end": "01:44:32.620",
      "text": "شیر خشک معمولی میشه"
    },
    {
      "id": 84,
      "start": 6272.62,
      "end": 6281.62,
      "formatted_start": "01:44:32.620",
      "formatted_end": "01:44:41.620",
      "text": "خب، بگو سام کشته شیشه، نه ست و پنجاه گرم، ست و پنجاه گرم بهتون کشاده؟"
    },
    {
      "id": 85,
      "start": 6281.62,
      "end": 6290.62,
      "formatted_start": "01:44:41.620",
      "formatted_end": "01:44:50.620",
      "text": "خیلی ممنون شما، برگونه شما، خوش مزدید باش."
    },
    {
      "id": 86,
      "start": 6290.62,
      "end": 6299.62,
      "formatted_start": "01:44:50.620",
      "formatted_end": "01:44:59.620",
      "text": "جانم، فلا، مرسی که خوبی، قربونت، مرسی میبینی جانم، خدافز جان."
    }
  ],
  "status": "completed"
}