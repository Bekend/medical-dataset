  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5102.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:02.000",
      "text": "از اینجوری شیر رو برمی کنی؟"
    },
    {
      "id": 1,
      "start": 5102.0,
      "end": 5121.0,
      "formatted_start": "01:25:02.000",
      "formatted_end": "01:25:21.000",
      "text": "آره، ببین شب که بیدار شده، مثلا یه بار که بیدار شد، حالا خواستی شیر بده، شب که بیدار شد، بقلش کنی کرد، مثلا لالاییش بخوند بخوند، شیر دیگه بشنند، یه ذره آبش بده بزن به خواهد خوب، این کار رو بکنی که همکرم شیر شبش کرده میشه، شیر روز شب مثلا چند سیستی بشونی؟"
    },
    {
      "id": 2,
      "start": 5121.0,
      "end": 5124.44,
      "formatted_start": "01:25:21.000",
      "formatted_end": "01:25:24.440",
      "text": "من بعضی وقتا خیلی گوشته باشه ۲۰۰ تا"
    },
    {
      "id": 3,
      "start": 5124.44,
      "end": 5126.0,
      "formatted_start": "01:25:24.440",
      "formatted_end": "01:25:26.000",
      "text": "بعضی وقتا ۲۰۰ تا"
    },
    {
      "id": 4,
      "start": 5126.0,
      "end": 5127.56,
      "formatted_start": "01:25:26.000",
      "formatted_end": "01:25:27.560",
      "text": "بیشتر ما ۲۰۰ تایه"
    },
    {
      "id": 5,
      "start": 5127.56,
      "end": 5129.96,
      "formatted_start": "01:25:27.560",
      "formatted_end": "01:25:29.960",
      "text": "او بیشتر ۲۰۰ تا ۲۰۷ تا بشه"
    },
    {
      "id": 6,
      "start": 5129.96,
      "end": 5131.36,
      "formatted_start": "01:25:29.960",
      "formatted_end": "01:25:31.360",
      "text": "چندتر ۱۸ تا"
    },
    {
      "id": 7,
      "start": 5131.36,
      "end": 5132.24,
      "formatted_start": "01:25:31.360",
      "formatted_end": "01:25:32.240",
      "text": "کم کنم برم؟"
    },
    {
      "id": 8,
      "start": 5132.24,
      "end": 5132.8,
      "formatted_start": "01:25:32.240",
      "formatted_end": "01:25:32.800",
      "text": "کم کنم"
    },
    {
      "id": 9,
      "start": 5132.8,
      "end": 5134.24,
      "formatted_start": "01:25:32.800",
      "formatted_end": "01:25:34.240",
      "text": "اگه غذا خوردنش بیشترش"
    },
    {
      "id": 10,
      "start": 5134.24,
      "end": 5135.76,
      "formatted_start": "01:25:34.240",
      "formatted_end": "01:25:35.760",
      "text": "خب معروف ۲۰۰۰ تا"
    },
    {
      "id": 11,
      "start": 5135.76,
      "end": 5137.76,
      "formatted_start": "01:25:35.760",
      "formatted_end": "01:25:37.760",
      "text": "در روز ۱۵ ویده رو شیر میخورن"
    },
    {
      "id": 12,
      "start": 5137.76,
      "end": 5139.88,
      "formatted_start": "01:25:37.760",
      "formatted_end": "01:25:39.880",
      "text": "دیگر هر چهار ساعت"
    },
    {
      "id": 13,
      "start": 5139.88,
      "end": 5141.72,
      "formatted_start": "01:25:39.880",
      "formatted_end": "01:25:41.720",
      "text": "من ۲۰۰ تا رو میدم"
    },
    {
      "id": 14,
      "start": 5141.72,
      "end": 5145.12,
      "formatted_start": "01:25:41.720",
      "formatted_end": "01:25:45.120",
      "text": "میگن میگن یک کلیم چیل میخورم یک کلیم سیر میشه"
    },
    {
      "id": 15,
      "start": 5145.12,
      "end": 5149.16,
      "formatted_start": "01:25:45.120",
      "formatted_end": "01:25:49.160",
      "text": "که من همه برای یک کلیم دو چیل بخورم یک دو قضانه اتونم بخورم دید درسته؟"
    },
    {
      "id": 16,
      "start": 5149.16,
      "end": 5150.92,
      "formatted_start": "01:25:49.160",
      "formatted_end": "01:25:50.920",
      "text": "بک میبهم که همه چی بهش میدم"
    },
    {
      "id": 17,
      "start": 5150.92,
      "end": 5154.88,
      "formatted_start": "01:25:50.920",
      "formatted_end": "01:25:54.880",
      "text": "دیده چیزهایی که گفتین اصل و کیوی و خربوشا و بازانسانی"
    },
    {
      "id": 18,
      "start": 5154.88,
      "end": 5156.52,
      "formatted_start": "01:25:54.880",
      "formatted_end": "01:25:56.520",
      "text": "آفرین آفرین خیلی هم خوبه"
    },
    {
      "id": 19,
      "start": 5156.52,
      "end": 5158.56,
      "formatted_start": "01:25:56.520",
      "formatted_end": "01:25:58.560",
      "text": "الان مفردش هم خوب بود خب میتونی؟"
    },
    {
      "id": 20,
      "start": 5158.56,
      "end": 5160.76,
      "formatted_start": "01:25:58.560",
      "formatted_end": "01:26:00.760",
      "text": "بردش اندازه بچه دو ساقست"
    },
    {
      "id": 21,
      "start": 5160.76,
      "end": 5162.0,
      "formatted_start": "01:26:00.760",
      "formatted_end": "01:26:02.000",
      "text": "خوبه پس خدا باشه"
    },
    {
      "id": 22,
      "start": 5162.0,
      "end": 5164.0,
      "formatted_start": "01:26:02.000",
      "formatted_end": "01:26:04.000",
      "text": "این هر از این اروده بود برای شما؟"
    },
    {
      "id": 23,
      "start": 5164.0,
      "end": 5166.0,
      "formatted_start": "01:26:04.000",
      "formatted_end": "01:26:06.000",
      "text": "بله، بسیاری نمی کنیم."
    },
    {
      "id": 24,
      "start": 5166.0,
      "end": 5168.0,
      "formatted_start": "01:26:06.000",
      "formatted_end": "01:26:08.000",
      "text": "این هر اروده ها از این اروده هایی نمی کنه."
    },
    {
      "id": 25,
      "start": 5168.0,
      "end": 5170.0,
      "formatted_start": "01:26:08.000",
      "formatted_end": "01:26:10.000",
      "text": "این هر اروده هایی نمی کنه."
    },
    {
      "id": 26,
      "start": 5170.0,
      "end": 5172.0,
      "formatted_start": "01:26:10.000",
      "formatted_end": "01:26:12.000",
      "text": "این هر اروده هایی نمی کنیم."
    },
    {
      "id": 27,
      "start": 5172.0,
      "end": 5174.0,
      "formatted_start": "01:26:12.000",
      "formatted_end": "01:26:14.000",
      "text": "این هر اروده هایی نمی کنیم."
    },
    {
      "id": 28,
      "start": 5174.0,
      "end": 5176.0,
      "formatted_start": "01:26:14.000",
      "formatted_end": "01:26:16.000",
      "text": "خب، بخواهم دوست شما که افتامین 52 را نده، افتامین 2 را شروع کن."
    },
    {
      "id": 29,
      "start": 5176.0,
      "end": 5178.0,
      "formatted_start": "01:26:16.000",
      "formatted_end": "01:26:18.000",
      "text": "خب، بخواهم دوست شما که افتامین 52 را نده، افتامین 2 را شروع کن."
    },
    {
      "id": 30,
      "start": 5178.0,
      "end": 5180.0,
      "formatted_start": "01:26:18.000",
      "formatted_end": "01:26:20.000",
      "text": "اصلا اونو نمیخوره"
    },
    {
      "id": 31,
      "start": 5180.0,
      "end": 5182.0,
      "formatted_start": "01:26:20.000",
      "formatted_end": "01:26:22.000",
      "text": "من اتا اومدم نت بروی"
    },
    {
      "id": 32,
      "start": 5182.0,
      "end": 5184.0,
      "formatted_start": "01:26:22.000",
      "formatted_end": "01:26:24.000",
      "text": "چیزی پپتی میخوره؟"
    },
    {
      "id": 33,
      "start": 5184.0,
      "end": 5186.0,
      "formatted_start": "01:26:24.000",
      "formatted_end": "01:26:26.000",
      "text": "پپتی بیمزه دوست داره"
    },
    {
      "id": 34,
      "start": 5186.0,
      "end": 5190.0,
      "formatted_start": "01:26:26.000",
      "formatted_end": "01:26:30.000",
      "text": "یعنی من اومدم نت بروی شیر به این لندم که گوشه اینو بشه که شار بیاره"
    },
    {
      "id": 35,
      "start": 5190.0,
      "end": 5192.0,
      "formatted_start": "01:26:30.000",
      "formatted_end": "01:26:32.000",
      "text": "مجبور بشه اپدام در دورو بخوره"
    },
    {
      "id": 36,
      "start": 5192.0,
      "end": 5194.0,
      "formatted_start": "01:26:32.000",
      "formatted_end": "01:26:34.000",
      "text": "اصلا میگه اینا نمیخوره"
    },
    {
      "id": 37,
      "start": 5194.0,
      "end": 5196.0,
      "formatted_start": "01:26:34.000",
      "formatted_end": "01:26:36.000",
      "text": "نه نه"
    },
    {
      "id": 38,
      "start": 5196.0,
      "end": 5198.0,
      "formatted_start": "01:26:36.000",
      "formatted_end": "01:26:38.000",
      "text": "همون بکنه اون دورو ادامه بریم"
    },
    {
      "id": 39,
      "start": 5198.0,
      "end": 5200.0,
      "formatted_start": "01:26:38.000",
      "formatted_end": "01:26:40.000",
      "text": "دور رفتم چند تا پاسم رو میگرد"
    },
    {
      "id": 40,
      "start": 5200.0,
      "end": 5202.0,
      "formatted_start": "01:26:40.000",
      "formatted_end": "01:26:42.000",
      "text": "من شد گرفت همون دورو ادامه بدم"
    },
    {
      "id": 41,
      "start": 5202.0,
      "end": 5204.0,
      "formatted_start": "01:26:42.000",
      "formatted_end": "01:26:44.000",
      "text": "بلش کن"
    },
    {
      "id": 42,
      "start": 5204.0,
      "end": 5205.0,
      "formatted_start": "01:26:44.000",
      "formatted_end": "01:26:45.000",
      "text": "یکی کار به من؟"
    },
    {
      "id": 43,
      "start": 5205.0,
      "end": 5208.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:48.000",
      "text": "آه، آه، من کم کم کاری بدی فکر آدم روی بخورم"
    },
    {
      "id": 44,
      "start": 5208.0,
      "end": 5209.0,
      "formatted_start": "01:26:48.000",
      "formatted_end": "01:26:49.000",
      "text": "بذارشو بیدارم"
    },
    {
      "id": 45,
      "start": 5210.0,
      "end": 5212.0,
      "formatted_start": "01:26:50.000",
      "formatted_end": "01:26:52.000",
      "text": "بله، کاملو دست بیاد بردیشم"
    },
    {
      "id": 46,
      "start": 5214.0,
      "end": 5220.0,
      "formatted_start": "01:26:54.000",
      "formatted_end": "01:27:00.000",
      "text": "ما دور آلتش افزایل ها چفت بیده"
    },
    {
      "id": 47,
      "start": 5220.0,
      "end": 5222.0,
      "formatted_start": "01:27:00.000",
      "formatted_end": "01:27:02.000",
      "text": "چرا بگویم؟ جدا میشه؟"
    },
    {
      "id": 48,
      "start": 5222.0,
      "end": 5223.0,
      "formatted_start": "01:27:02.000",
      "formatted_end": "01:27:03.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 49,
      "start": 5223.0,
      "end": 5226.0,
      "formatted_start": "01:27:03.000",
      "formatted_end": "01:27:06.000",
      "text": "ماشاله قدرش ۸۳"
    },
    {
      "id": 50,
      "start": 5226.0,
      "end": 5229.0,
      "formatted_start": "01:27:06.000",
      "formatted_end": "01:27:09.000",
      "text": "خب، اندازه بچه یکونیم سال هست"
    },
    {
      "id": 51,
      "start": 5229.0,
      "end": 5230.0,
      "formatted_start": "01:27:09.000",
      "formatted_end": "01:27:10.000",
      "text": "خب، کلونی؟"
    },
    {
      "id": 52,
      "start": 5230.0,
      "end": 5231.0,
      "formatted_start": "01:27:10.000",
      "formatted_end": "01:27:11.000",
      "text": "هم ماشاله بچه هست"
    },
    {
      "id": 53,
      "start": 5231.0,
      "end": 5236.0,
      "formatted_start": "01:27:11.000",
      "formatted_end": "01:27:16.000",
      "text": "درسته دیگه هم قدرش بالنده هم وزنش خوبه"
    },
    {
      "id": 54,
      "start": 5236.0,
      "end": 5240.0,
      "formatted_start": "01:27:16.000",
      "formatted_end": "01:27:20.000",
      "text": "مثلا همه نگران خوردنش نده نبوده دیگه خب ببین"
    },
    {
      "id": 55,
      "start": 5240.0,
      "end": 5243.0,
      "formatted_start": "01:27:20.000",
      "formatted_end": "01:27:23.000",
      "text": "به خاطر اینکه اینجا توباله کومنت میکنه"
    },
    {
      "id": 56,
      "start": 5243.0,
      "end": 5248.0,
      "formatted_start": "01:27:23.000",
      "formatted_end": "01:27:28.000",
      "text": "اما از اینکه نده نده کومنت آدم هم میشه"
    },
    {
      "id": 57,
      "start": 5248.0,
      "end": 5252.0,
      "formatted_start": "01:27:28.000",
      "formatted_end": "01:27:32.000",
      "text": "هر داره هم چسدوی هم چسدمندگی نبوده"
    },
    {
      "id": 58,
      "start": 5252.0,
      "end": 5259.0,
      "formatted_start": "01:27:32.000",
      "formatted_end": "01:27:39.000",
      "text": "این بازیش بده بازیش بده بازیش بده بامده ده خوشش میاد دیده"
    },
    {
      "id": 59,
      "start": 5259.0,
      "end": 5261.0,
      "formatted_start": "01:27:39.000",
      "formatted_end": "01:27:41.000",
      "text": "اینجا بیشتر میاد بیدارم"
    },
    {
      "id": 60,
      "start": 5261.0,
      "end": 5263.0,
      "formatted_start": "01:27:41.000",
      "formatted_end": "01:27:43.000",
      "text": "اینجا بیشتر میاد بیدارم"
    },
    {
      "id": 61,
      "start": 5263.0,
      "end": 5265.0,
      "formatted_start": "01:27:43.000",
      "formatted_end": "01:27:45.000",
      "text": "این بچه ها هم نیست فهم ها"
    },
    {
      "id": 62,
      "start": 5265.0,
      "end": 5267.0,
      "formatted_start": "01:27:45.000",
      "formatted_end": "01:27:47.000",
      "text": "و خدا هم که سردارت شیطان برون چه"
    },
    {
      "id": 63,
      "start": 5267.0,
      "end": 5269.0,
      "formatted_start": "01:27:47.000",
      "formatted_end": "01:27:49.000",
      "text": "به خودش نرم که بهتر از مومی شد"
    },
    {
      "id": 64,
      "start": 5269.0,
      "end": 5271.0,
      "formatted_start": "01:27:49.000",
      "formatted_end": "01:27:51.000",
      "text": "به خودش نرم که بهتر از مومی شد"
    },
    {
      "id": 65,
      "start": 5271.0,
      "end": 5273.0,
      "formatted_start": "01:27:51.000",
      "formatted_end": "01:27:53.000",
      "text": "پس نداره چشم برم میگید نه؟"
    },
    {
      "id": 66,
      "start": 5273.0,
      "end": 5275.0,
      "formatted_start": "01:27:53.000",
      "formatted_end": "01:27:55.000",
      "text": "پس نداره چشم برم میگید نه؟"
    },
    {
      "id": 67,
      "start": 5277.0,
      "end": 5279.0,
      "formatted_start": "01:27:57.000",
      "formatted_end": "01:27:59.000",
      "text": "بعد مورتویت ها میگنانم که ادامه بدم تا یک سال"
    },
    {
      "id": 68,
      "start": 5279.0,
      "end": 5281.0,
      "formatted_start": "01:27:59.000",
      "formatted_end": "01:28:01.000",
      "text": "بعد مورتویت ها میگنانم که ادامه بدم تا یک سال"
    },
    {
      "id": 69,
      "start": 5281.0,
      "end": 5283.0,
      "formatted_start": "01:28:01.000",
      "formatted_end": "01:28:03.000",
      "text": "تا دو سال"
    },
    {
      "id": 70,
      "start": 5283.0,
      "end": 5289.0,
      "formatted_start": "01:28:03.000",
      "formatted_end": "01:28:09.000",
      "text": "شربت روزه سیزی ها بسیار هست؟ بدم ندم"
    },
    {
      "id": 71,
      "start": 5289.0,
      "end": 5292.0,
      "formatted_start": "01:28:09.000",
      "formatted_end": "01:28:12.000",
      "text": "شربت سیتریزین براش نمیشتم"
    },
    {
      "id": 72,
      "start": 5292.0,
      "end": 5294.0,
      "formatted_start": "01:28:12.000",
      "formatted_end": "01:28:14.000",
      "text": "هر دوست درصد ساعت دو و نیم سی سی بده"
    },
    {
      "id": 73,
      "start": 5294.0,
      "end": 5296.0,
      "formatted_start": "01:28:14.000",
      "formatted_end": "01:28:16.000",
      "text": "آزیز توماکسنش رو دیگه ندارد"
    },
    {
      "id": 74,
      "start": 5296.0,
      "end": 5298.0,
      "formatted_start": "01:28:16.000",
      "formatted_end": "01:28:18.000",
      "text": "آزیز توماکسن ندارد"
    },
    {
      "id": 75,
      "start": 5298.0,
      "end": 5300.0,
      "formatted_start": "01:28:18.000",
      "formatted_end": "01:28:20.000",
      "text": "سیتریزین دو و نیم سی سی هر دوست درصد"
    },
    {
      "id": 76,
      "start": 5300.0,
      "end": 5302.0,
      "formatted_start": "01:28:20.000",
      "formatted_end": "01:28:22.000",
      "text": "قطعه به تماتزان نوشتن خدا هاش"
    },
    {
      "id": 77,
      "start": 5302.0,
      "end": 5304.0,
      "formatted_start": "01:28:22.000",
      "formatted_end": "01:28:24.000",
      "text": "روزی دو باری قطعه به زخل و بینش"
    },
    {
      "id": 78,
      "start": 5304.0,
      "end": 5306.0,
      "formatted_start": "01:28:24.000",
      "formatted_end": "01:28:26.000",
      "text": "به خصوص شب قبل خواب"
    },
    {
      "id": 79,
      "start": 5306.0,
      "end": 5309.0,
      "formatted_start": "01:28:26.000",
      "formatted_end": "01:28:29.000",
      "text": "یه پودر ما تلیکاس دار نوشتن"
    },
    {
      "id": 80,
      "start": 5309.0,
      "end": 5312.0,
      "formatted_start": "01:28:29.000",
      "formatted_end": "01:28:32.000",
      "text": "از این کازت ها می روشتن بعد از آنها این پود رو برس تو شیرش بشه"
    },
    {
      "id": 81,
      "start": 5312.0,
      "end": 5315.0,
      "formatted_start": "01:28:32.000",
      "formatted_end": "01:28:35.000",
      "text": "یا تو ماست برس یا تو قضاش برس"
    },
    {
      "id": 82,
      "start": 5315.0,
      "end": 5317.0,
      "formatted_start": "01:28:35.000",
      "formatted_end": "01:28:37.000",
      "text": "خواب این پود رو برس"
    },
    {
      "id": 83,
      "start": 5317.0,
      "end": 5319.0,
      "formatted_start": "01:28:37.000",
      "formatted_end": "01:28:39.000",
      "text": "بعد آنوان می رو پلاشین رو دیگر سه نداره"
    },
    {
      "id": 84,
      "start": 5319.0,
      "end": 5321.0,
      "formatted_start": "01:28:39.000",
      "formatted_end": "01:28:41.000",
      "text": "پلاشین رو برس برس"
    },
    {
      "id": 85,
      "start": 5321.0,
      "end": 5322.0,
      "formatted_start": "01:28:41.000",
      "formatted_end": "01:28:42.000",
      "text": "چه ها برس؟"
    },
    {
      "id": 86,
      "start": 5322.0,
      "end": 5324.0,
      "formatted_start": "01:28:42.000",
      "formatted_end": "01:28:44.000",
      "text": "پلاشین رو برسی سه بار دو هشت یک سی سی برس"
    },
    {
      "id": 87,
      "start": 5324.0,
      "end": 5327.0,
      "formatted_start": "01:28:44.000",
      "formatted_end": "01:28:47.000",
      "text": "ایوان این سی سی تیپ رفته قدر که"
    },
    {
      "id": 88,
      "start": 5327.0,
      "end": 5330.0,
      "formatted_start": "01:28:47.000",
      "formatted_end": "01:28:50.000",
      "text": "آره آره از اینجا"
    },
    {
      "id": 89,
      "start": 5330.0,
      "end": 5331.0,
      "formatted_start": "01:28:50.000",
      "formatted_end": "01:28:51.000",
      "text": "این هم از این"
    },
    {
      "id": 90,
      "start": 5331.0,
      "end": 5333.0,
      "formatted_start": "01:28:51.000",
      "formatted_end": "01:28:53.000",
      "text": "خوب میشه کم کم رگرام نباش"
    },
    {
      "id": 91,
      "start": 5333.0,
      "end": 5337.5,
      "formatted_start": "01:28:53.000",
      "formatted_end": "01:28:57.500",
      "text": "اگر دیدی که با این ها بهتر نشد یعنی صرفه هاش آن خود"
    },
    {
      "id": 92,
      "start": 5337.5,
      "end": 5341.2,
      "formatted_start": "01:28:57.500",
      "formatted_end": "01:29:01.200",
      "text": "صرفه هاش دیدی بهتر نشد یه اسپری براش میرسن"
    },
    {
      "id": 93,
      "start": 5341.2,
      "end": 5343.2,
      "formatted_start": "01:29:01.200",
      "formatted_end": "01:29:03.200",
      "text": "صبح و شب براش برسن"
    },
    {
      "id": 94,
      "start": 5343.2,
      "end": 5346.9,
      "formatted_start": "01:29:03.200",
      "formatted_end": "01:29:06.900",
      "text": "اگر بهتر نشد تا چند داروها رو بدن؟"
    },
    {
      "id": 95,
      "start": 5346.9,
      "end": 5349.4,
      "formatted_start": "01:29:06.900",
      "formatted_end": "01:29:09.400",
      "text": "تا دو روزتر روز بده انشاله بهتر نشد"
    },
    {
      "id": 96,
      "start": 5349.4,
      "end": 5351.4,
      "formatted_start": "01:29:09.400",
      "formatted_end": "01:29:11.400",
      "text": "آهان خب تا دو روزتر"
    },
    {
      "id": 97,
      "start": 5351.4,
      "end": 5356.4,
      "formatted_start": "01:29:11.400",
      "formatted_end": "01:29:16.400",
      "text": "بعد اگر اون رو تبکرد پراکیل هم 22 قطره لیگه"
    },
    {
      "id": 98,
      "start": 5356.4,
      "end": 5360.4,
      "formatted_start": "01:29:16.400",
      "formatted_end": "01:29:20.400",
      "text": "پراکیل برای کم تر برده یک و نیم سیزی بهش بده"
    },
    {
      "id": 99,
      "start": 5360.4,
      "end": 5362.4,
      "formatted_start": "01:29:20.400",
      "formatted_end": "01:29:22.400",
      "text": "یه نوع قطع چکان درست داره"
    },
    {
      "id": 100,
      "start": 5362.4,
      "end": 5364.9,
      "formatted_start": "01:29:22.400",
      "formatted_end": "01:29:24.900",
      "text": "آره یه نوع قطع چکان برد باید کم نکرد"
    },
    {
      "id": 101,
      "start": 5366.4,
      "end": 5367.4,
      "formatted_start": "01:29:26.400",
      "formatted_end": "01:29:27.400",
      "text": "بیرون سال"
    },
    {
      "id": 102,
      "start": 5367.4,
      "end": 5369.9,
      "formatted_start": "01:29:27.400",
      "formatted_end": "01:29:29.900",
      "text": "دکتر اومی رفته رفته فدر موندن برد"
    },
    {
      "id": 103,
      "start": 5369.9,
      "end": 5371.9,
      "formatted_start": "01:29:29.900",
      "formatted_end": "01:29:31.900",
      "text": "او کراکی رو دوباره برد میشه"
    },
    {
      "id": 104,
      "start": 5371.9,
      "end": 5372.9,
      "formatted_start": "01:29:31.900",
      "formatted_end": "01:29:32.900",
      "text": "اما اینجوری کم بیش نیدونه"
    },
    {
      "id": 105,
      "start": 5372.9,
      "end": 5374.9,
      "formatted_start": "01:29:32.900",
      "formatted_end": "01:29:34.900",
      "text": "از نامی نفر رو دوباره برد میدیم"
    },
    {
      "id": 106,
      "start": 5374.9,
      "end": 5376.9,
      "formatted_start": "01:29:34.900",
      "formatted_end": "01:29:36.900",
      "text": "کراکی قصرهاش درسته"
    },
    {
      "id": 107,
      "start": 5376.9,
      "end": 5377.9,
      "formatted_start": "01:29:36.900",
      "formatted_end": "01:29:37.900",
      "text": "یه مقداری باید"
    },
    {
      "id": 108,
      "start": 5377.9,
      "end": 5378.9,
      "formatted_start": "01:29:37.900",
      "formatted_end": "01:29:38.900",
      "text": "دکتر داروی باشه"
    },
    {
      "id": 109,
      "start": 5378.9,
      "end": 5380.4,
      "formatted_start": "01:29:38.900",
      "formatted_end": "01:29:40.400",
      "text": "دارش باید باید باید باید بیش نیدونه"
    },
    {
      "id": 110,
      "start": 5380.4,
      "end": 5382.4,
      "formatted_start": "01:29:40.400",
      "formatted_end": "01:29:42.400",
      "text": "من که یادم رسول آدمت دارم"
    },
    {
      "id": 111,
      "start": 5382.4,
      "end": 5384.4,
      "formatted_start": "01:29:42.400",
      "formatted_end": "01:29:44.400",
      "text": "خیلی خوب"
    },
    {
      "id": 112,
      "start": 5384.4,
      "end": 5386.4,
      "formatted_start": "01:29:44.400",
      "formatted_end": "01:29:46.400",
      "text": "کاربور شما"
    },
    {
      "id": 113,
      "start": 5386.4,
      "end": 5388.4,
      "formatted_start": "01:29:46.400",
      "formatted_end": "01:29:48.400",
      "text": "هشت کنم"
    },
    {
      "id": 114,
      "start": 5388.4,
      "end": 5390.4,
      "formatted_start": "01:29:48.400",
      "formatted_end": "01:29:50.400",
      "text": "نه آقای ببینید"
    },
    {
      "id": 115,
      "start": 5390.4,
      "end": 5392.4,
      "formatted_start": "01:29:50.400",
      "formatted_end": "01:29:52.400",
      "text": "چون برنامه یازمت و یک بوده"
    },
    {
      "id": 116,
      "start": 5392.4,
      "end": 5394.4,
      "formatted_start": "01:29:52.400",
      "formatted_end": "01:29:54.400",
      "text": "خاموش کردم"
    },
    {
      "id": 117,
      "start": 5394.4,
      "end": 5396.4,
      "formatted_start": "01:29:54.400",
      "formatted_end": "01:29:56.400",
      "text": "ببینم برق میدونیم"
    },
    {
      "id": 118,
      "start": 5396.4,
      "end": 5398.4,
      "formatted_start": "01:29:56.400",
      "formatted_end": "01:29:58.400",
      "text": "نه نردیدم نرفت"
    },
    {
      "id": 119,
      "start": 5398.4,
      "end": 5400.4,
      "formatted_start": "01:29:58.400",
      "formatted_end": "01:30:00.400",
      "text": "الان روشنم"
    }
  ],
  "status": "completed"
}