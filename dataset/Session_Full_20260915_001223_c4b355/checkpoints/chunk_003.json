    {
      "id": 32,
      "start": 1025.46,
      "end": 1055.46,
      "formatted_start": "00:17:05.460",
      "formatted_end": "00:17:35.460",
      "text": "از اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجوری با اینجور"
    },
    {
      "id": 33,
      "start": 1055.46,
      "end": 1057.46,
      "formatted_start": "00:17:35.460",
      "formatted_end": "00:17:37.460",
      "text": "باشه من که لازم اونجا"
    },
    {
      "id": 34,
      "start": 1057.46,
      "end": 1060.46,
      "formatted_start": "00:17:37.460",
      "formatted_end": "00:17:40.460",
      "text": "خب بباش لازمه رو برداره نه نه"
    },
    {
      "id": 35,
