      "end": 1062.46,
      "formatted_start": "00:17:40.460",
      "formatted_end": "00:17:42.460",
      "text": "از سوال میبرسم با لفتر رو برداره"
    },
    {
      "id": 36,
      "start": 1062.46,
      "end": 1063.46,
      "formatted_start": "00:17:42.460",
      "formatted_end": "00:17:43.460",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 1063.46,
      "end": 1064.46,
      "formatted_start": "00:17:43.460",
      "formatted_end": "00:17:44.460",
      "text": "این سوال نمیاد"
    },
    {
      "id": 38,
      "start": 1064.46,
      "end": 1065.46,
      "formatted_start": "00:17:44.460",
      "formatted_end": "00:17:45.460",
      "text": "خیلی زیب برسم"
    },
    {
      "id": 39,
      "start": 1065.46,
      "end": 1067.46,
      "formatted_start": "00:17:45.460",
      "formatted_end": "00:17:47.460",
      "text": "نه نه نیافترانی کنم"
    },
    {
      "id": 40,
      "start": 1067.46,
      "end": 1068.46,
      "formatted_start": "00:17:47.460",
      "formatted_end": "00:17:48.460",
      "text": "نمیبرسی؟"
    },
    {
      "id": 41,
      "start": 1068.46,
      "end": 1069.46,
      "formatted_start": "00:17:48.460",
      "formatted_end": "00:17:49.460",
      "text": "آره چون من"
    },
    {
      "id": 42,
      "start": 1069.46,
      "end": 1072.46,
      "formatted_start": "00:17:49.460",
      "formatted_end": "00:17:52.460",
      "text": "از این مورد من که این مورد نفرد سی روکرم باشم"
    },
    {
      "id": 43,
      "start": 1072.46,
      "end": 1073.46,
      "formatted_start": "00:17:52.460",
      "formatted_end": "00:17:53.460",
      "text": "چیز موردی؟"
    },
    {
      "id": 44,
      "start": 1073.46,
      "end": 1074.46,
      "formatted_start": "00:17:53.460",
      "formatted_end": "00:17:54.460",
      "text": "اونجا که سی روکرم نفرسی"
    },
    {
      "id": 45,
      "start": 1074.46,
      "end": 1075.46,
      "formatted_start": "00:17:54.460",
      "formatted_end": "00:17:55.460",
      "text": "نه"
    },
    {
      "id": 46,
      "start": 1075.46,
      "end": 1076.46,
      "formatted_start": "00:17:55.460",
      "formatted_end": "00:17:56.460",
      "text": "از اون پاساته نیست"
    },
    {
      "id": 47,
      "start": 1076.46,
      "end": 1077.46,
      "formatted_start": "00:17:56.460",
      "formatted_end": "00:17:57.460",
      "text": "من"
    },
