      "id": 48,
      "start": 1077.46,
      "end": 1079.46,
      "formatted_start": "00:17:57.460",
      "formatted_end": "00:17:59.460",
      "text": "از این مورد من"
    },
    {
      "id": 49,
      "start": 1079.46,
      "end": 1081.46,
