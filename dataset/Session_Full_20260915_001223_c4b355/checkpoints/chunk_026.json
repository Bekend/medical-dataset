  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7803.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:03.000",
      "text": "یک حدش کامیترون رو دیکنو، بعد بزرگ باردن."
    },
    {
      "id": 1,
      "start": 7803.0,
      "end": 7805.0,
      "formatted_start": "02:10:03.000",
      "formatted_end": "02:10:05.000",
      "text": "چه حد بود؟"
    },
    {
      "id": 2,
      "start": 7805.0,
      "end": 7807.0,
      "formatted_start": "02:10:05.000",
      "formatted_end": "02:10:07.000",
      "text": "چه حد بود؟"
    },
    {
      "id": 3,
      "start": 7807.0,
      "end": 7808.0,
      "formatted_start": "02:10:07.000",
      "formatted_end": "02:10:08.000",
      "text": "چه حد بود؟"
    },
    {
      "id": 4,
      "start": 7808.0,
      "end": 7811.0,
      "formatted_start": "02:10:08.000",
      "formatted_end": "02:10:11.000",
      "text": "چار کلی بود و بعد شد سه کلی هم سترک شد"
    },
    {
      "id": 5,
      "start": 7811.0,
      "end": 7814.0,
      "formatted_start": "02:10:11.000",
      "formatted_end": "02:10:14.000",
      "text": "باز شد چار کلی سترک شد"
    },
    {
      "id": 6,
      "start": 7814.0,
      "end": 7817.0,
      "formatted_start": "02:10:14.000",
      "formatted_end": "02:10:17.000",
      "text": "خون درزه بود"
    },
    {
      "id": 7,
      "start": 7817.0,
      "end": 7820.0,
      "formatted_start": "02:10:17.000",
      "formatted_end": "02:10:20.000",
      "text": "خیلی هم خوبه چهار سترک و بعدش هم خوبه"
    },
    {
      "id": 8,
      "start": 7820.0,
      "end": 7824.0,
      "formatted_start": "02:10:20.000",
      "formatted_end": "02:10:24.000",
      "text": "خب ببین اولا که اگه زیاد تو خونه بپوشونیش"
    },
    {
      "id": 9,
      "start": 7824.0,
      "end": 7827.0,
      "formatted_start": "02:10:24.000",
      "formatted_end": "02:10:27.000",
      "text": "خونه رو گرم گرم داری ببین چه از داخل میتردش"
    },
    {
      "id": 10,
      "start": 7827.0,
      "end": 7830.0,
      "formatted_start": "02:10:27.000",
      "formatted_end": "02:10:30.000",
      "text": "خب از اون طرف ترک میکنه"
    },
    {
      "id": 11,
      "start": 7830.0,
      "end": 7833.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:33.000",
      "text": "پس نباید زیاد بپوشونش خب دمای معمولی"
    },
    {
      "id": 12,
      "start": 7833.0,
      "end": 7836.0,
      "formatted_start": "02:10:33.000",
      "formatted_end": "02:10:36.000",
      "text": "هر دمایی که خودت راحتی تو خونه"
    },
    {
      "id": 13,
      "start": 7836.0,
      "end": 7838.5,
      "formatted_start": "02:10:36.000",
      "formatted_end": "02:10:38.500",
      "text": "بچه باید اون دیگر پشت بیشتر داشته باشه کافیه"
    },
    {
      "id": 14,
      "start": 7838.5,
      "end": 7841.34,
      "formatted_start": "02:10:38.500",
      "formatted_end": "02:10:41.340",
      "text": "زیاد میاد و بیزشون تقییم ادازه فلاکا کنه"
    },
    {
      "id": 15,
      "start": 7841.34,
      "end": 7842.0,
      "formatted_start": "02:10:41.340",
      "formatted_end": "02:10:42.000",
      "text": "آه"
    },
    {
      "id": 16,
      "start": 7842.0,
      "end": 7844.34,
      "formatted_start": "02:10:42.000",
      "formatted_end": "02:10:44.340",
      "text": "باید از این ادازه"
    },
    {
      "id": 17,
      "start": 7844.34,
      "end": 7847.48,
      "formatted_start": "02:10:44.340",
      "formatted_end": "02:10:47.480",
      "text": "بعد بیگه بچه ها معمولا از بیسته موزکی به بعد"
    },
    {
      "id": 18,
      "start": 7847.48,
      "end": 7849.34,
      "formatted_start": "02:10:47.480",
      "formatted_end": "02:10:49.340",
      "text": "نفکشون شروع میشه"
    },
    {
      "id": 19,
      "start": 7849.34,
      "end": 7851.46,
      "formatted_start": "02:10:49.340",
      "formatted_end": "02:10:51.460",
      "text": "نفکشون برداشت شروع میشه"
    },
    {
      "id": 20,
      "start": 7851.46,
      "end": 7852.84,
      "formatted_start": "02:10:51.460",
      "formatted_end": "02:10:52.840",
      "text": "بیقرار میشن"
    },
    {
      "id": 21,
      "start": 7852.84,
      "end": 7855.08,
      "formatted_start": "02:10:52.840",
      "formatted_end": "02:10:55.080",
      "text": "هی به خودشون زور میزنن"
    },
    {
      "id": 22,
      "start": 7855.08,
      "end": 7860.04,
      "formatted_start": "02:10:55.080",
      "formatted_end": "02:11:00.040",
      "text": "بعد یه مقدار چون شکمشون نفک میکنه به مدهشون فشاد"
    },
    {
      "id": 23,
      "start": 7860.04,
      "end": 7862.94,
      "formatted_start": "02:11:00.040",
      "formatted_end": "02:11:02.940",
      "text": "یه مقدار از این شیر میاد بالا"
    },
    {
      "id": 24,
      "start": 7862.94,
      "end": 7865.94,
      "formatted_start": "02:11:02.940",
      "formatted_end": "02:11:05.940",
      "text": "خب، شیر که همروخ میاد برای همروخ باشه"
    },
    {
      "id": 25,
      "start": 7865.94,
      "end": 7868.94,
      "formatted_start": "02:11:05.940",
      "formatted_end": "02:11:08.940",
      "text": "شیره ای بیداش نیست برای بادر"
    },
    {
      "id": 26,
      "start": 7868.94,
      "end": 7870.94,
      "formatted_start": "02:11:08.940",
      "formatted_end": "02:11:10.940",
      "text": "شیره ای بیداش مثل خلصه"
    },
    {
      "id": 27,
      "start": 7870.94,
      "end": 7872.94,
      "formatted_start": "02:11:10.940",
      "formatted_end": "02:11:12.940",
      "text": "این باعث میشه بینش خلخل صدا بده"
    },
    {
      "id": 28,
      "start": 7872.94,
      "end": 7875.94,
      "formatted_start": "02:11:12.940",
      "formatted_end": "02:11:15.940",
      "text": "خب، پس این اشوره فرموخوزگی نیست"
    },
    {
      "id": 29,
      "start": 7875.94,
      "end": 7877.94,
      "formatted_start": "02:11:15.940",
      "formatted_end": "02:11:17.940",
      "text": "قیرانش نماشید، خب"
    },
    {
      "id": 30,
      "start": 7877.94,
      "end": 7880.94,
      "formatted_start": "02:11:17.940",
      "formatted_end": "02:11:20.940",
      "text": "پسش دارو میده بیستم، داروش را صفاته با خوبشه"
    },
    {
      "id": 31,
      "start": 7880.94,
      "end": 7882.94,
      "formatted_start": "02:11:20.940",
      "formatted_end": "02:11:22.940",
      "text": "اصلا فرموخوزگی نیسته؟"
    },
    {
      "id": 32,
      "start": 7882.94,
      "end": 7883.94,
      "formatted_start": "02:11:22.940",
      "formatted_end": "02:11:23.940",
      "text": "نه"
    },
    {
      "id": 33,
      "start": 7883.94,
      "end": 7894.94,
      "formatted_start": "02:11:23.940",
      "formatted_end": "02:11:34.940",
      "text": "از طبیعیتون آزاد، یه زن خیلی خیلی خانه بینش طبیعیه، ولی اگر صرفه بکنه یا آب از بینش بیان چی روی کنه؟"
    },
    {
      "id": 34,
      "start": 7894.94,
      "end": 7896.94,
      "formatted_start": "02:11:34.940",
      "formatted_end": "02:11:36.940",
      "text": "یا ترک کنه؟"
    },
    {
      "id": 35,
      "start": 7896.94,
      "end": 7899.94,
      "formatted_start": "02:11:36.940",
      "formatted_end": "02:11:39.940",
      "text": "اومده خیلی کم، خیلی زندگی"
    },
    {
      "id": 36,
      "start": 7899.94,
      "end": 7901.94,
      "formatted_start": "02:11:39.940",
      "formatted_end": "02:11:41.940",
      "text": "با درمت هم نمون شیره ای بیداش بودن، خب؟"
    },
    {
      "id": 37,
      "start": 7901.94,
      "end": 7903.94,
      "formatted_start": "02:11:41.940",
      "formatted_end": "02:11:43.940",
      "text": "اینکه از دلشون"
    },
    {
      "id": 38,
      "start": 7903.94,
      "end": 7905.94,
      "formatted_start": "02:11:43.940",
      "formatted_end": "02:11:45.940",
      "text": "از دلشون، آب ریزه چون بینی ناشده"
    },
    {
      "id": 39,
      "start": 7905.94,
      "end": 7907.94,
      "formatted_start": "02:11:45.940",
      "formatted_end": "02:11:47.940",
      "text": "ای جانه دلت، شیر مادر میخوره"
    },
    {
      "id": 40,
      "start": 7907.94,
      "end": 7908.94,
      "formatted_start": "02:11:47.940",
      "formatted_end": "02:11:48.940",
      "text": "شیر ماده هم میخوره"
    },
    {
      "id": 41,
      "start": 7908.94,
      "end": 7909.94,
      "formatted_start": "02:11:48.940",
      "formatted_end": "02:11:49.940",
      "text": "آه شیر خودم خب"
    },
    {
      "id": 42,
      "start": 7909.94,
      "end": 7913.94,
      "formatted_start": "02:11:49.940",
      "formatted_end": "02:11:53.940",
      "text": "من عموما در جایی که شیر ماده هم میخورم من خیلی کم تر سرده میخورم"
    },
    {
      "id": 43,
      "start": 7913.94,
      "end": 7915.94,
      "formatted_start": "02:11:53.940",
      "formatted_end": "02:11:55.940",
      "text": "آره من توی این تنگه هم نشته بود"
    },
    {
      "id": 44,
      "start": 7916.94,
      "end": 7918.94,
      "formatted_start": "02:11:56.940",
      "formatted_end": "02:11:58.940",
      "text": "نگرانش که شانش دارون میده"
    },
    {
      "id": 45,
      "start": 7918.94,
      "end": 7921.94,
      "formatted_start": "02:11:58.940",
      "formatted_end": "02:12:01.940",
      "text": "خب من یه فرصه چیزی چشم ده بودم"
    },
    {
      "id": 46,
      "start": 7921.94,
      "end": 7925.94,
      "formatted_start": "02:12:01.940",
      "formatted_end": "02:12:05.940",
      "text": "فرصه کنید با یه یه میتوانید آله داده بودید"
    },
    {
      "id": 47,
      "start": 7925.94,
      "end": 7929.94,
      "formatted_start": "02:12:05.940",
      "formatted_end": "02:12:09.940",
      "text": "یه باید کما نفت موش مانتر نفت هست"
    },
    {
      "id": 48,
      "start": 7929.94,
      "end": 7932.94,
      "formatted_start": "02:12:09.940",
      "formatted_end": "02:12:12.940",
      "text": "خب پس من الان براش"
    },
    {
      "id": 49,
      "start": 7932.94,
      "end": 7940.94,
      "formatted_start": "02:12:12.940",
      "formatted_end": "02:12:20.940",
      "text": "یک ازخریه دیگری می نویسند برای آن، بگوینید که این شستش را برده بینید و خواهید"
    },
    {
      "id": 50,
      "start": 7949.94,
      "end": 7952.94,
      "formatted_start": "02:12:29.940",
      "formatted_end": "02:12:32.940",
      "text": "همونطور شیر برده باشید"
    },
    {
      "id": 51,
      "start": 7962.94,
      "end": 7992.94,
      "formatted_start": "02:12:42.940",
      "formatted_end": "02:13:12.940",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 52,
      "start": 7992.94,
      "end": 7997.44,
      "formatted_start": "02:13:12.940",
      "formatted_end": "02:13:17.440",
      "text": "اما از قسمت که با لب داریم مثلا پیشانی بچه رو تز کنیم، تبشه نگاه کنیم"
    },
    {
      "id": 53,
      "start": 7997.44,
      "end": 8003.94,
      "formatted_start": "02:13:17.440",
      "formatted_end": "02:13:23.940",
      "text": "و تبسنش اگر این خرابت رو با درد می‌تونیم، در تزون پیشانیش نگاه تب داریم، دو آقای در مزه"
    },
    {
      "id": 54,
      "start": 8003.94,
      "end": 8010.94,
      "formatted_start": "02:13:23.940",
      "formatted_end": "02:13:30.940",
      "text": "نه، شاید تب داشته بلی وقتی نوزان تب می‌کنه، ما اول کاری که می‌کنیم لباساشو کم می‌کنیم"
    },
    {
      "id": 55,
      "start": 8010.94,
      "end": 8012.94,
      "formatted_start": "02:13:30.940",
      "formatted_end": "02:13:32.940",
      "text": "بعد شیر بهش میدیم"
    },
    {
      "id": 56,
      "start": 8012.94,
      "end": 8014.94,
      "formatted_start": "02:13:32.940",
      "formatted_end": "02:13:34.940",
      "text": "پشت لختش میخونیم روازش رو گرم می کنیم"
    },
    {
      "id": 57,
      "start": 8014.94,
      "end": 8016.94,
      "formatted_start": "02:13:34.940",
      "formatted_end": "02:13:36.940",
      "text": "دوباره اینیم سر یه سر بعد چکش میکنیم"
    },
    {
      "id": 58,
      "start": 8016.94,
      "end": 8018.94,
      "formatted_start": "02:13:36.940",
      "formatted_end": "02:13:38.940",
      "text": "اگه آمده بود پایین"
    },
    {
      "id": 59,
      "start": 8018.94,
      "end": 8020.94,
      "formatted_start": "02:13:38.940",
      "formatted_end": "02:13:40.940",
      "text": "که دیگه اون تب نیست"
    },
    {
      "id": 60,
      "start": 8020.94,
      "end": 8022.94,
      "formatted_start": "02:13:40.940",
      "formatted_end": "02:13:42.940",
      "text": "اون گرم شدن بدنه"
    },
    {
      "id": 61,
      "start": 8022.94,
      "end": 8024.94,
      "formatted_start": "02:13:42.940",
      "formatted_end": "02:13:44.940",
      "text": "و بعد از دستورت که کلر خاموش باشد"
    },
    {
      "id": 62,
      "start": 8024.94,
      "end": 8026.94,
      "formatted_start": "02:13:44.940",
      "formatted_end": "02:13:46.940",
      "text": "دمان خونه افتاد یک نواخت باشد"
    },
    {
      "id": 63,
      "start": 8026.94,
      "end": 8028.94,
      "formatted_start": "02:13:46.940",
      "formatted_end": "02:13:48.940",
      "text": "ببین شما"
    },
    {
      "id": 64,
      "start": 8028.94,
      "end": 8030.94,
      "formatted_start": "02:13:48.940",
      "formatted_end": "02:13:50.940",
      "text": "چون که فکر کردی سرم خورده"
    },
    {
      "id": 65,
      "start": 8030.94,
      "end": 8032.94,
      "formatted_start": "02:13:50.940",
      "formatted_end": "02:13:52.940",
      "text": "هی لباس بشدیش"
    },
    {
      "id": 66,
      "start": 8032.94,
      "end": 8034.94,
      "formatted_start": "02:13:52.940",
      "formatted_end": "02:13:54.940",
      "text": "هی کلر رو خاموش کردی"
    },
    {
      "id": 67,
      "start": 8034.94,
      "end": 8036.94,
      "formatted_start": "02:13:54.940",
      "formatted_end": "02:13:56.940",
      "text": "بخواد بچه رو داخت کرده"
    },
    {
      "id": 68,
      "start": 8036.94,
      "end": 8037.94,
      "formatted_start": "02:13:56.940",
      "formatted_end": "02:13:57.940",
      "text": "داخت کرده؟"
    },
    {
      "id": 69,
      "start": 8037.94,
      "end": 8038.94,
      "formatted_start": "02:13:57.940",
      "formatted_end": "02:13:58.940",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 8038.94,
      "end": 8040.94,
      "formatted_start": "02:13:58.940",
      "formatted_end": "02:14:00.940",
      "text": "اینم گرمایی اینقدر تو خیلی سرمون شده؟"
    },
    {
      "id": 71,
      "start": 8040.94,
      "end": 8042.94,
      "formatted_start": "02:14:00.940",
      "formatted_end": "02:14:02.940",
      "text": "خب گناه داره بعد وقتی بیقرار میشه"
    },
    {
      "id": 72,
      "start": 8042.94,
      "end": 8043.94,
      "formatted_start": "02:14:02.940",
      "formatted_end": "02:14:03.940",
      "text": "خب"
    },
    {
      "id": 73,
      "start": 8043.94,
      "end": 8045.94,
      "formatted_start": "02:14:03.940",
      "formatted_end": "02:14:05.940",
      "text": "گناه داره زیاد ببین بچه"
    },
    {
      "id": 74,
      "start": 8045.94,
      "end": 8047.94,
      "formatted_start": "02:14:05.940",
      "formatted_end": "02:14:07.940",
      "text": "نه خیلی سرم نه گرم"
    },
    {
      "id": 75,
      "start": 8047.94,
      "end": 8050.94,
      "formatted_start": "02:14:07.940",
      "formatted_end": "02:14:10.940",
      "text": "معمولی دمای معمولی که خودت هم توش راحتی"
    },
    {
      "id": 76,
      "start": 8050.94,
      "end": 8051.94,
      "formatted_start": "02:14:10.940",
      "formatted_end": "02:14:11.940",
      "text": "آره"
    },
    {
      "id": 77,
      "start": 8051.94,
      "end": 8053.94,
      "formatted_start": "02:14:11.940",
      "formatted_end": "02:14:13.940",
      "text": "تو همون دما باید باشه خب"
    },
    {
      "id": 78,
      "start": 8053.94,
      "end": 8055.94,
      "formatted_start": "02:14:13.940",
      "formatted_end": "02:14:15.940",
      "text": "زیادا نباید بخشونیش"
    },
    {
      "id": 79,
      "start": 8060.94,
      "end": 8062.94,
      "formatted_start": "02:14:20.940",
      "formatted_end": "02:14:22.940",
      "text": "خب ببین خم جمع شدیم"
    },
    {
      "id": 80,
      "start": 8062.94,
      "end": 8063.94,
      "formatted_start": "02:14:22.940",
      "formatted_end": "02:14:23.940",
      "text": "جمع شدیم"
    },
    {
      "id": 81,
      "start": 8063.94,
      "end": 8067.94,
      "formatted_start": "02:14:23.940",
      "formatted_end": "02:14:27.940",
      "text": "یک براش اسطله بینی نوشتم"
    },
    {
      "id": 82,
      "start": 8067.94,
      "end": 8071.94,
      "formatted_start": "02:14:27.940",
      "formatted_end": "02:14:31.940",
      "text": "هر سه چهار ساعت"
    },
    {
      "id": 83,
      "start": 8071.94,
      "end": 8075.94,
      "formatted_start": "02:14:31.940",
      "formatted_end": "02:14:35.940",
      "text": "هر موقع ببینی بینیش اینجوری صدا میکنه"
    },
    {
      "id": 84,
      "start": 8075.94,
      "end": 8079.94,
      "formatted_start": "02:14:35.940",
      "formatted_end": "02:14:39.940",
      "text": "یک پاخت به دان داخل بینش"
    },
    {
      "id": 85,
      "start": 8079.94,
      "end": 8083.94,
      "formatted_start": "02:14:39.940",
      "formatted_end": "02:14:43.940",
      "text": "یک براش قطره پروکیت نوشتم"
    },
    {
      "id": 86,
      "start": 8083.94,
      "end": 8087.94,
      "formatted_start": "02:14:43.940",
      "formatted_end": "02:14:47.940",
      "text": "اینو هر روز بده چه دل درداش چه نداشت"
    },
    {
      "id": 87,
      "start": 8087.94,
      "end": 8091.94,
      "formatted_start": "02:14:47.940",
      "formatted_end": "02:14:51.940",
      "text": "روزی پنج قطره"
    },
    {
      "id": 88,
      "start": 8091.94,
      "end": 8095.56,
      "formatted_start": "02:14:51.940",
      "formatted_end": "02:14:55.560",
      "text": "اگر بیقرار بود"
    },
    {
      "id": 89,
      "start": 8095.56,
      "end": 8099.26,
      "formatted_start": "02:14:55.560",
      "formatted_end": "02:14:59.260",
      "text": "روزی سه بار ده قطب"
    }
  ],
  "status": "completed"
}