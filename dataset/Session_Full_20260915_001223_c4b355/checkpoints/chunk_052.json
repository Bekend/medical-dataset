      "end": 15850.0,
      "formatted_start": "04:24:08.000",
      "formatted_end": "04:24:10.000",
      "text": "یه وقت قرمز رو رمز میشه"
    },
    {
      "id": 81,
      "start": 15850.0,
      "end": 15859.0,
      "formatted_start": "04:24:10.000",
      "formatted_end": "04:24:19.000",
      "text": "این حساسیت ها میتونه به یک چیز خورده باشه یا میتونه به این چیز تنباسی باشه"
    },
    {
      "id": 82,
      "start": 15859.0,
      "end": 15867.0,
      "formatted_start": "04:24:19.000",
      "formatted_end": "04:24:27.000",
      "text": "مثلا به لباستون برخور میکنه مثلا میزنی میزاری رو دوشت آروب بگیری ممکنه لباس پرزه لباست باشه"
    },
    {
      "id": 83,
      "start": 15867.0,
      "end": 15874.0,
      "formatted_start": "04:24:27.000",
      "formatted_end": "04:24:34.000",
      "text": "ممکنه که بوسیدنش باشه ممکنه شامپوی که بهش میزنی باشه به هر حال این یکی رو حساسیت هست"
    },
    {
      "id": 84,
      "start": 15874.0,
      "end": 15880.0,
      "formatted_start": "04:24:34.000",
      "formatted_end": "04:24:40.000",
      "text": "اما این قصره برایش منویسم برای ازاده حساسیت که اتماقا برای مدهش هم خوبه"
    },
    {
      "id": 85,
      "start": 15880.0,
      "end": 15886.0,
      "formatted_start": "04:24:40.000",
      "formatted_end": "04:24:46.000",
      "text": "یه تونه دیگه برایش کمات نویسم و یه شامپ که همون بکنی باید شامپو هم بشکنی"
    },
    {
      "id": 86,
      "start": 15886.0,
      "end": 15888.0,
      "formatted_start": "04:24:46.000",
      "formatted_end": "04:24:48.000",
      "text": "تا ایشان این حساسیت چیزی نشان شده"
    },
    {
      "id": 87,
      "start": 15888.0,
      "end": 15890.0,
      "formatted_start": "04:24:48.000",
      "formatted_end": "04:24:50.000",
      "text": "پس ممکنه همون برای شامپوش باشه؟"
    },
    {
      "id": 88,
      "start": 15890.0,
      "end": 15892.0,
      "formatted_start": "04:24:50.000",
      "formatted_end": "04:24:52.000",
      "text": "یه سری همون"
    },
    {
      "id": 89,
      "start": 15892.0,
      "end": 15894.0,
      "formatted_start": "04:24:52.000",
      "formatted_end": "04:24:54.000",
      "text": "بعد از همون ها شاید شده شده"
    },
    {
      "id": 90,
      "start": 15894.0,
      "end": 15896.0,
      "formatted_start": "04:24:54.000",
      "formatted_end": "04:24:56.000",
      "text": "و شامپوش هم مسترلاس"
    },
    {
      "id": 91,
      "start": 15896.0,
      "end": 15899.0,
      "formatted_start": "04:24:56.000",
      "formatted_end": "04:24:59.000",
      "text": "قضاها رو برده می کنیم که خود نوک بخونه دیگه"
    },
    {
      "id": 92,
      "start": 15899.0,
      "end": 15900.0,
      "formatted_start": "04:24:59.000",
      "formatted_end": "04:25:00.000",
      "text": "خواهام که این باعث می شوند"
    }
  ],
  "status": "completed"
