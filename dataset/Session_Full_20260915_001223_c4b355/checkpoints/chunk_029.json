  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8702.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:02.000",
      "text": "اینجا میزنم و بعد."
    },
    {
      "id": 1,
      "start": 8702.0,
      "end": 8704.0,
      "formatted_start": "02:25:02.000",
      "formatted_end": "02:25:04.000",
      "text": "جزمانه با جزمانه."
    },
    {
      "id": 2,
      "start": 8704.0,
      "end": 8708.0,
      "formatted_start": "02:25:04.000",
      "formatted_end": "02:25:08.000",
      "text": "خب، اون آسترونش رو روزی 3 بار، چند کلی بود؟"
    },
    {
      "id": 3,
      "start": 8708.0,
      "end": 8710.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:10.000",
      "text": "15 هایسته."
    },
    {
      "id": 4,
      "start": 8710.0,
      "end": 8728.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:28.000",
      "text": "خب، 3 سی سی خبیل از قصه بده، اینو تا دو روز بده، بعد فراشه کپسول دیلیت میمونیزن، اینو روزی دو بار، پودرشو باز کن کپسولو و بریز تو ماسک بهش بده، بعد دیگه با..."
    },
    {
      "id": 5,
      "start": 8728.0,
      "end": 8730.0,
      "formatted_start": "02:25:28.000",
      "formatted_end": "02:25:30.000",
      "text": "این پور بیوتی که نیست؟"
    },
    {
      "id": 6,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "آره این پور بیوتی که نیست"
    },
    {
      "id": 7,
      "start": 8732.0,
      "end": 8734.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:34.000",
      "text": "بعد طریق عربه سرخوانه ایش"
    },
    {
      "id": 8,
      "start": 8734.0,
      "end": 8736.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:36.000",
      "text": "یه شکلت داری"
    },
    {
      "id": 9,
      "start": 8736.0,
      "end": 8738.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:38.000",
      "text": "کلزانش بره"
    },
    {
      "id": 10,
      "start": 8738.0,
      "end": 8740.0,
      "formatted_start": "02:25:38.000",
      "formatted_end": "02:25:40.000",
      "text": "روزی سه بار"
    },
    {
      "id": 11,
      "start": 8740.0,
      "end": 8742.0,
      "formatted_start": "02:25:40.000",
      "formatted_end": "02:25:42.000",
      "text": "سه سی سی"
    },
    {
      "id": 12,
      "start": 8742.0,
      "end": 8744.0,
      "formatted_start": "02:25:42.000",
      "formatted_end": "02:25:44.000",
      "text": "با جرشی بره"
    },
    {
      "id": 13,
      "start": 8744.0,
      "end": 8746.0,
      "formatted_start": "02:25:44.000",
      "formatted_end": "02:25:46.000",
      "text": "از این درخواست نداشتی؟"
    },
    {
      "id": 14,
      "start": 8746.0,
      "end": 8748.0,
      "formatted_start": "02:25:46.000",
      "formatted_end": "02:25:48.000",
      "text": "نه جرمه باقی بره"
    },
    {
      "id": 15,
      "start": 8748.0,
      "end": 8750.0,
      "formatted_start": "02:25:48.000",
      "formatted_end": "02:25:50.000",
      "text": "از این درخواست"
    },
    {
      "id": 16,
      "start": 8750.0,
      "end": 8752.0,
      "formatted_start": "02:25:50.000",
      "formatted_end": "02:25:52.000",
      "text": "از این درخواست"
    },
    {
      "id": 17,
      "start": 8752.0,
      "end": 8754.0,
      "formatted_start": "02:25:52.000",
      "formatted_end": "02:25:54.000",
      "text": "نمیدونه کجا که انتخاب کنه"
    },
    {
      "id": 18,
      "start": 8754.0,
      "end": 8756.0,
      "formatted_start": "02:25:54.000",
      "formatted_end": "02:25:56.000",
      "text": "بردن که پیش اندی اینا بردن"
    },
    {
      "id": 19,
      "start": 8756.0,
      "end": 8757.0,
      "formatted_start": "02:25:56.000",
      "formatted_end": "02:25:57.000",
      "text": "جان؟"
    },
    {
      "id": 20,
      "start": 8757.0,
      "end": 8758.0,
      "formatted_start": "02:25:57.000",
      "formatted_end": "02:25:58.000",
      "text": "ویتامین دیشه"
    },
    {
      "id": 21,
      "start": 8758.0,
      "end": 8759.0,
      "formatted_start": "02:25:58.000",
      "formatted_end": "02:25:59.000",
      "text": "ویتامین دینات رو بدم"
    },
    {
      "id": 22,
      "start": 8759.0,
      "end": 8760.0,
      "formatted_start": "02:25:59.000",
      "formatted_end": "02:26:00.000",
      "text": "مالتی ویتامین همه؟"
    },
    {
      "id": 23,
      "start": 8760.0,
      "end": 8761.0,
      "formatted_start": "02:26:00.000",
      "formatted_end": "02:26:01.000",
      "text": "آره از این سنباره"
    },
    {
      "id": 24,
      "start": 8761.0,
      "end": 8764.0,
      "formatted_start": "02:26:01.000",
      "formatted_end": "02:26:04.000",
      "text": "خب، بگیم که من از اینا بگیر"
    },
    {
      "id": 25,
      "start": 8765.0,
      "end": 8767.0,
      "formatted_start": "02:26:05.000",
      "formatted_end": "02:26:07.000",
      "text": "نه از اینا بگیرم"
    },
    {
      "id": 26,
      "start": 8767.0,
      "end": 8769.0,
      "formatted_start": "02:26:07.000",
      "formatted_end": "02:26:09.000",
      "text": "منکی؟"
    },
    {
      "id": 27,
      "start": 8769.0,
      "end": 8771.0,
      "formatted_start": "02:26:09.000",
      "formatted_end": "02:26:11.000",
      "text": "بیر؟"
    },
    {
      "id": 28,
      "start": 8771.0,
      "end": 8773.0,
      "formatted_start": "02:26:11.000",
      "formatted_end": "02:26:13.000",
      "text": "هورس؟"
    },
    {
      "id": 29,
      "start": 8773.0,
      "end": 8775.0,
      "formatted_start": "02:26:13.000",
      "formatted_end": "02:26:15.000",
      "text": "یونیکورم؟"
    },
    {
      "id": 30,
      "start": 8775.0,
      "end": 8776.0,
      "formatted_start": "02:26:15.000",
      "formatted_end": "02:26:16.000",
      "text": "اینه"
    },
    {
      "id": 31,
      "start": 8776.0,
      "end": 8778.0,
      "formatted_start": "02:26:16.000",
      "formatted_end": "02:26:18.000",
      "text": "از اون بخواهی؟ خب از این هم یک دونه میچونی"
    },
    {
      "id": 32,
      "start": 8778.0,
      "end": 8779.0,
      "formatted_start": "02:26:18.000",
      "formatted_end": "02:26:19.000",
      "text": "بگی یه منکی هم بگیر"
    },
    {
      "id": 33,
      "start": 8779.0,
      "end": 8781.0,
      "formatted_start": "02:26:19.000",
      "formatted_end": "02:26:21.000",
      "text": "بخوش یک دونه بخوش"
    },
    {
      "id": 34,
      "start": 8781.0,
      "end": 8782.0,
      "formatted_start": "02:26:21.000",
      "formatted_end": "02:26:22.000",
      "text": "اینجا"
    },
    {
      "id": 35,
      "start": 8782.0,
      "end": 8784.0,
      "formatted_start": "02:26:22.000",
      "formatted_end": "02:26:24.000",
      "text": "ستار و منکی"
    },
    {
      "id": 36,
      "start": 8784.0,
      "end": 8785.0,
      "formatted_start": "02:26:24.000",
      "formatted_end": "02:26:25.000",
      "text": "منکی"
    },
    {
      "id": 37,
      "start": 8785.0,
      "end": 8787.0,
      "formatted_start": "02:26:25.000",
      "formatted_end": "02:26:27.000",
      "text": "اینه باشه بگیر"
    },
    {
      "id": 38,
      "start": 8787.0,
      "end": 8789.0,
      "formatted_start": "02:26:27.000",
      "formatted_end": "02:26:29.000",
      "text": "باشه بگیر"
    },
    {
      "id": 39,
      "start": 8789.0,
      "end": 8791.0,
      "formatted_start": "02:26:29.000",
      "formatted_end": "02:26:31.000",
      "text": "باشه بگیر"
    },
    {
      "id": 40,
      "start": 8793.0,
      "end": 8795.0,
      "formatted_start": "02:26:33.000",
      "formatted_end": "02:26:35.000",
      "text": "و کلن تا چند روز بدم اینا رو؟"
    },
    {
      "id": 41,
      "start": 8795.0,
      "end": 8797.0,
      "formatted_start": "02:26:35.000",
      "formatted_end": "02:26:37.000",
      "text": "مثل هوریزان ما رو کت بیده"
    },
    {
      "id": 42,
      "start": 8797.0,
      "end": 8799.0,
      "formatted_start": "02:26:37.000",
      "formatted_end": "02:26:39.000",
      "text": "نه، یه ستا که پنج روز بدم"
    },
    {
      "id": 43,
      "start": 8799.0,
      "end": 8801.0,
      "formatted_start": "02:26:39.000",
      "formatted_end": "02:26:41.000",
      "text": "هوریزان هم سه روز بهش بدم"
    },
    {
      "id": 44,
      "start": 8801.0,
      "end": 8803.0,
      "formatted_start": "02:26:41.000",
      "formatted_end": "02:26:43.000",
      "text": "ولی ببین که شد هم"
    },
    {
      "id": 45,
      "start": 8803.0,
      "end": 8805.0,
      "formatted_start": "02:26:43.000",
      "formatted_end": "02:26:45.000",
      "text": "دو ماه بدم"
    },
    {
      "id": 46,
      "start": 8805.0,
      "end": 8807.0,
      "formatted_start": "02:26:45.000",
      "formatted_end": "02:26:47.000",
      "text": "همونطور دو ماه براشیش"
    },
    {
      "id": 47,
      "start": 8807.0,
      "end": 8837.0,
      "formatted_start": "02:26:47.000",
      "formatted_end": "02:27:17.000",
      "text": "از اینجا باید بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو بردنش رو برد"
    },
    {
      "id": 48,
      "start": 8837.0,
      "end": 8846.0,
      "formatted_start": "02:27:17.000",
      "formatted_end": "02:27:26.000",
      "text": "شیر خوش کم کنن، خاندکتو همونو بشم بیدن، دیگه به لاکتوز اساسیت داره همونو علاج کنه"
    },
    {
      "id": 49,
      "start": 8846.0,
      "end": 8849.0,
      "formatted_start": "02:27:26.000",
      "formatted_end": "02:27:29.000",
      "text": "خب بعد امروز شیر خوش دادی برسه"
    },
    {
      "id": 50,
      "start": 8849.0,
      "end": 8851.0,
      "formatted_start": "02:27:29.000",
      "formatted_end": "02:27:31.000",
      "text": "چی پاس تویتن رو بگیر برن؟"
    },
    {
      "id": 51,
      "start": 8851.0,
      "end": 8852.0,
      "formatted_start": "02:27:31.000",
      "formatted_end": "02:27:32.000",
      "text": "شیر خوش کم کنم"
    },
    {
      "id": 52,
      "start": 8852.0,
      "end": 8855.0,
      "formatted_start": "02:27:32.000",
      "formatted_end": "02:27:35.000",
      "text": "بخواندکتو الان که سنده شو زفتی بالا بود و شو پره"
    },
    {
      "id": 53,
      "start": 8855.0,
      "end": 8856.0,
      "formatted_start": "02:27:35.000",
      "formatted_end": "02:27:36.000",
      "text": "شیر خوش کم کنیم"
    },
    {
      "id": 54,
      "start": 8856.0,
      "end": 8861.0,
      "formatted_start": "02:27:36.000",
      "formatted_end": "02:27:41.000",
      "text": "نه شیر همونو بدون لاکتوز بدن ولی مارکاش برخ کنه چون نان پیدا نمیشه"
    },
    {
      "id": 55,
      "start": 8861.0,
      "end": 8863.0,
      "formatted_start": "02:27:41.000",
      "formatted_end": "02:27:43.000",
      "text": "یکی از دو هر کار که بگیرم، از اینکه بگیرم کار رو بگیرم"
    },
    {
      "id": 56,
      "start": 8863.0,
      "end": 8865.0,
      "formatted_start": "02:27:43.000",
      "formatted_end": "02:27:45.000",
      "text": "اولا، پیچه شو"
    },
    {
      "id": 57,
      "start": 8865.0,
      "end": 8867.0,
      "formatted_start": "02:27:45.000",
      "formatted_end": "02:27:47.000",
      "text": "پیچه شو"
    },
    {
      "id": 58,
      "start": 8867.0,
      "end": 8869.0,
      "formatted_start": "02:27:47.000",
      "formatted_end": "02:27:49.000",
      "text": "بخشو"
    },
    {
      "id": 59,
      "start": 8869.0,
      "end": 8871.0,
      "formatted_start": "02:27:49.000",
      "formatted_end": "02:27:51.000",
      "text": "بخشو"
    },
    {
      "id": 60,
      "start": 8873.0,
      "end": 8875.0,
      "formatted_start": "02:27:53.000",
      "formatted_end": "02:27:55.000",
      "text": "بخشو"
    },
    {
      "id": 61,
      "start": 8875.0,
      "end": 8877.0,
      "formatted_start": "02:27:55.000",
      "formatted_end": "02:27:57.000",
      "text": "بخشو"
    },
    {
      "id": 62,
      "start": 8881.0,
      "end": 8883.0,
      "formatted_start": "02:28:01.000",
      "formatted_end": "02:28:03.000",
      "text": "خوب"
    },
    {
      "id": 63,
      "start": 8883.0,
      "end": 8885.0,
      "formatted_start": "02:28:03.000",
      "formatted_end": "02:28:05.000",
      "text": "این هست"
    },
    {
      "id": 64,
      "start": 8891.0,
      "end": 8900.0,
      "formatted_start": "02:28:11.000",
      "formatted_end": "02:28:20.000",
      "text": "موسیقی"
    },
    {
      "id": 65,
      "start": 8921.0,
      "end": 8923.0,
      "formatted_start": "02:28:41.000",
      "formatted_end": "02:28:43.000",
      "text": "بیان دیگه یه دیگه"
    },
    {
      "id": 66,
      "start": 8923.0,
      "end": 8925.0,
      "formatted_start": "02:28:43.000",
      "formatted_end": "02:28:45.000",
      "text": "آره نه یه آدم نبیاده ازش میشه چی که خوبه داره"
    },
    {
      "id": 67,
      "start": 8925.0,
      "end": 8927.0,
      "formatted_start": "02:28:45.000",
      "formatted_end": "02:28:47.000",
      "text": "اونو سرم خوردگی اونم میخورن"
    },
    {
      "id": 68,
      "start": 8927.0,
      "end": 8929.0,
      "formatted_start": "02:28:47.000",
      "formatted_end": "02:28:49.000",
      "text": "پلاشین؟"
    },
    {
      "id": 69,
      "start": 8929.0,
      "end": 8931.0,
      "formatted_start": "02:28:49.000",
      "formatted_end": "02:28:51.000",
      "text": "یه چیزی تو همه مایه نداره"
    },
    {
      "id": 70,
      "start": 8931.0,
      "end": 8933.0,
      "formatted_start": "02:28:51.000",
      "formatted_end": "02:28:53.000",
      "text": "پلاشین یا تو کافت باب یا"
    },
    {
      "id": 71,
      "start": 8933.0,
      "end": 8935.0,
      "formatted_start": "02:28:53.000",
      "formatted_end": "02:28:55.000",
      "text": "نه نه از بزرگ سالم میخورن"
    },
    {
      "id": 72,
      "start": 8935.0,
      "end": 8937.0,
      "formatted_start": "02:28:55.000",
      "formatted_end": "02:28:57.000",
      "text": "خواه پلاشین"
    },
    {
      "id": 73,
      "start": 8937.0,
      "end": 8939.0,
      "formatted_start": "02:28:57.000",
      "formatted_end": "02:28:59.000",
      "text": "یه دیگه یا نمیدونیم"
    },
    {
      "id": 74,
      "start": 8939.0,
      "end": 8941.0,
      "formatted_start": "02:28:59.000",
      "formatted_end": "02:29:01.000",
      "text": "او نه مثلا رای مقابلن"
    },
    {
      "id": 75,
      "start": 8941.0,
      "end": 8943.0,
      "formatted_start": "02:29:01.000",
      "formatted_end": "02:29:03.000",
      "text": "مثلا توش دخم شرکتی و اونو مثلا آبشو میریزیم داره"
    },
    {
      "id": 76,
      "start": 8943.0,
      "end": 8945.0,
      "formatted_start": "02:29:03.000",
      "formatted_end": "02:29:05.000",
      "text": "آه روتارین"
    },
    {
      "id": 77,
      "start": 8945.0,
      "end": 8947.0,
      "formatted_start": "02:29:05.000",
      "formatted_end": "02:29:07.000",
      "text": "او مورد صرف هست"
    },
    {
      "id": 78,
      "start": 8947.0,
      "end": 8953.0,
      "formatted_start": "02:29:07.000",
      "formatted_end": "02:29:13.000",
      "text": "اشکال دارن از اینکه از اینکه اشکال دارن اشکال هستن"
    },
    {
      "id": 79,
      "start": 8953.0,
      "end": 8955.0,
      "formatted_start": "02:29:13.000",
      "formatted_end": "02:29:15.000",
      "text": "بعضی زبط هستن خودم سرمون خواهد نداره"
    },
    {
      "id": 80,
      "start": 8955.0,
      "end": 8957.0,
      "formatted_start": "02:29:15.000",
      "formatted_end": "02:29:17.000",
      "text": "آره خیلی روتاری خیلی خوبه"
    },
    {
      "id": 81,
      "start": 8957.0,
      "end": 8959.0,
      "formatted_start": "02:29:17.000",
      "formatted_end": "02:29:19.000",
      "text": "مامان هم میگه بشه بدم"
    },
    {
      "id": 82,
      "start": 8959.0,
      "end": 8961.0,
      "formatted_start": "02:29:19.000",
      "formatted_end": "02:29:21.000",
      "text": "آره بشه بدم کم کم بشه بدم"
    },
    {
      "id": 83,
      "start": 8961.0,
      "end": 8963.0,
      "formatted_start": "02:29:21.000",
      "formatted_end": "02:29:23.000",
      "text": "چشم نره نداره بشه بدم"
    },
    {
      "id": 84,
      "start": 8963.0,
      "end": 8965.0,
      "formatted_start": "02:29:23.000",
      "formatted_end": "02:29:25.000",
      "text": "تموم"
    },
    {
      "id": 85,
      "start": 8965.0,
      "end": 8967.0,
      "formatted_start": "02:29:25.000",
      "formatted_end": "02:29:27.000",
      "text": "Thank you"
    },
    {
      "id": 86,
      "start": 8967.0,
      "end": 8969.0,
      "formatted_start": "02:29:27.000",
      "formatted_end": "02:29:29.000",
      "text": "Thank you"
    },
    {
      "id": 87,
      "start": 8969.0,
      "end": 8971.0,
      "formatted_start": "02:29:29.000",
      "formatted_end": "02:29:31.000",
      "text": "You're welcome"
    },
    {
      "id": 88,
      "start": 8971.0,
      "end": 8973.0,
      "formatted_start": "02:29:31.000",
      "formatted_end": "02:29:33.000",
      "text": "Bye"
    },
    {
      "id": 89,
      "start": 8973.0,
