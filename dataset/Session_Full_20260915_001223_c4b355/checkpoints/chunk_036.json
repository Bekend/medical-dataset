  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10830.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:30.000",
      "text": "بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 1,
      "start": 10830.0,
      "end": 10832.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:32.000",
      "text": "بگیم"
    },
    {
      "id": 2,
      "start": 10840.0,
      "end": 10842.0,
      "formatted_start": "03:00:40.000",
      "formatted_end": "03:00:42.000",
      "text": "میبینی چجوری صرفه میکنه؟"
    },
    {
      "id": 3,
      "start": 10842.0,
      "end": 10844.0,
      "formatted_start": "03:00:42.000",
      "formatted_end": "03:00:44.000",
      "text": "اینجوری میکنه ببین"
    },
    {
      "id": 4,
      "start": 10844.0,
      "end": 10846.0,
      "formatted_start": "03:00:44.000",
      "formatted_end": "03:00:46.000",
      "text": "بچه ها کم کم"
    },
    {
      "id": 5,
      "start": 10846.0,
      "end": 10848.0,
      "formatted_start": "03:00:46.000",
      "formatted_end": "03:00:48.000",
      "text": "از دقیق روزه گیرید"
    },
    {
      "id": 6,
      "start": 10848.0,
      "end": 10850.0,
      "formatted_start": "03:00:48.000",
      "formatted_end": "03:00:50.000",
      "text": "نفتش و تنشو شروع میشه"
    },
    {
      "id": 7,
      "start": 10850.0,
      "end": 10852.0,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:00:52.000",
      "text": "خب بعد فشار میاده"
    },
    {
      "id": 8,
      "start": 10852.0,
      "end": 10854.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:00:54.000",
      "text": "به مده نفت میکنه"
    },
    {
      "id": 9,
      "start": 10854.0,
      "end": 10856.0,
      "formatted_start": "03:00:54.000",
      "formatted_end": "03:00:56.000",
      "text": "بوده هاشون به مده فشار میده"
    },
    {
      "id": 10,
      "start": 10856.0,
      "end": 10858.0,
      "formatted_start": "03:00:56.000",
      "formatted_end": "03:00:58.000",
      "text": "یه مقدار از شیعه و شیعه"
    },
    {
      "id": 11,
      "start": 10858.0,
      "end": 10865.52,
      "formatted_start": "03:00:58.000",
      "formatted_end": "03:01:05.520",
      "text": "حالا بعض وقتا بالا میاد، بعض وقتا نمیاد تا اینجا انگار یک چیزی توی گلوشه، دو تا صرفه بگو دوباره میرم"
    },
    {
      "id": 12,
      "start": 10865.52,
      "end": 10868.72,
      "formatted_start": "03:01:05.520",
      "formatted_end": "03:01:08.720",
      "text": "پس صرفه بود، مادر خانو هم گفتی مایه سفیده هست"
    },
    {
      "id": 13,
      "start": 10868.72,
      "end": 10874.0,
      "formatted_start": "03:01:08.720",
      "formatted_end": "03:01:14.000",
      "text": "آره، سفیده، اون شیره مده است، خب؟ این شیره مده مثل خلط میمونه دیگه"
    },
    {
      "id": 14,
      "start": 10874.0,
      "end": 10878.8,
      "formatted_start": "03:01:14.000",
      "formatted_end": "03:01:18.800",
      "text": "اینجا وقتی گیر کنه، موقع نفس کشیدن، خر، خر، خر صدا میده"
    },
    {
      "id": 15,
      "start": 10878.8,
      "end": 10882.56,
      "formatted_start": "03:01:18.800",
      "formatted_end": "03:01:22.560",
      "text": "بینیش میاد پشت بینیش، پشت بینیش، خر، خر، خر صدا میده"
    },
    {
      "id": 16,
      "start": 10882.56,
      "end": 10891.56,
      "formatted_start": "03:01:22.560",
      "formatted_end": "03:01:31.560",
      "text": "پس نگران که باشید سرمو خورده بینید، همه بچه هایی که نفت دارند و یک بره ریفلاکس دارند، این علاقه ما دارند."
    },
    {
      "id": 17,
      "start": 10891.56,
      "end": 10901.56,
      "formatted_start": "03:01:31.560",
      "formatted_end": "03:01:41.560",
      "text": "خب، کاری که فقط می کنیم، یک کم نفتش رو دربار می کنیم، یک اسپریت بینیم، بینیم بریزیم تو بینیم که این اسید مده و شیره مده رو شستش رو بده که این پشت نمونه، خب؟"
    },
    {
      "id": 18,
      "start": 10901.56,
      "end": 10923.56,
      "formatted_start": "03:01:41.560",
      "formatted_end": "03:02:03.560",
      "text": "در داروهای که هم بشون دارید، که از خارجی ارزش هستند، این که آده است، پدیلات و گریباترزاری بشون دارید"
    },
    {
      "id": 19,
      "start": 10923.56,
      "end": 10925.56,
      "formatted_start": "03:02:03.560",
      "formatted_end": "03:02:05.560",
      "text": "خودماش ما دیزن داریم؟"
    },
    {
      "id": 20,
      "start": 10925.56,
      "end": 10927.56,
      "formatted_start": "03:02:05.560",
      "formatted_end": "03:02:07.560",
      "text": "هم خارجی داریم، هم ایرانی نگهد"
    },
    {
      "id": 21,
      "start": 10927.56,
      "end": 10929.56,
      "formatted_start": "03:02:07.560",
      "formatted_end": "03:02:09.560",
      "text": "خب معملا ایرانی یا روزی داریم، یک ماه میدیم"
    },
    {
      "id": 22,
      "start": 10929.56,
      "end": 10931.56,
      "formatted_start": "03:02:09.560",
      "formatted_end": "03:02:11.560",
      "text": "بعد از یک ماه خارجی شویم"
    },
    {
      "id": 23,
      "start": 10931.56,
      "end": 10933.56,
      "formatted_start": "03:02:11.560",
      "formatted_end": "03:02:13.560",
      "text": "خب؟ الان میتونی شما خارجی شوش بدیم"
    },
    {
      "id": 24,
      "start": 10933.56,
      "end": 10935.56,
      "formatted_start": "03:02:13.560",
      "formatted_end": "03:02:15.560",
      "text": "روزی چند ماه؟"
    },
    {
      "id": 25,
      "start": 10935.56,
      "end": 10937.56,
      "formatted_start": "03:02:15.560",
      "formatted_end": "03:02:17.560",
      "text": "چند ماه؟ روزی پنج بار هم میتونیم بدیم"
    },
    {
      "id": 26,
      "start": 10937.56,
      "end": 10939.56,
      "formatted_start": "03:02:17.560",
      "formatted_end": "03:02:19.560",
      "text": "پنج بار؟ ببینیم"
    },
    {
      "id": 27,
      "start": 10939.56,
      "end": 10941.56,
      "formatted_start": "03:02:19.560",
      "formatted_end": "03:02:21.560",
      "text": "ببینیم، ببینیم، اما ببینیم"
    },
    {
      "id": 28,
      "start": 10941.56,
      "end": 10943.56,
      "formatted_start": "03:02:21.560",
      "formatted_end": "03:02:23.560",
      "text": "یه پیدی لاکت"
    },
    {
      "id": 29,
      "start": 10943.56,
      "end": 10945.56,
      "formatted_start": "03:02:23.560",
      "formatted_end": "03:02:25.560",
      "text": "آره، روزی پونزده قطر"
    },
    {
      "id": 30,
      "start": 10945.56,
      "end": 10947.56,
      "formatted_start": "03:02:25.560",
      "formatted_end": "03:02:27.560",
      "text": "خب"
    },
    {
      "id": 31,
      "start": 10947.56,
      "end": 10951.06,
      "formatted_start": "03:02:27.560",
      "formatted_end": "03:02:31.060",
      "text": "بعد یک شربت براش می نمیسن به نام کولیکس"
    },
    {
      "id": 32,
      "start": 10951.86,
      "end": 10955.18,
      "formatted_start": "03:02:31.860",
      "formatted_end": "03:02:35.180",
      "text": "روزی یک قطرت روزی سه بار بهش"
    },
    {
      "id": 33,
      "start": 10955.18,
      "end": 10958.8,
      "formatted_start": "03:02:35.180",
      "formatted_end": "03:02:38.800",
      "text": "هشت قطرت قبل از شیر می دید"
    },
    {
      "id": 34,
      "start": 10960.06,
      "end": 10963.8,
      "formatted_start": "03:02:40.060",
      "formatted_end": "03:02:43.800",
      "text": "حالا اگر دیدید بعد از شیر خیلی داره بیقراری می کنه"
    },
    {
      "id": 35,
      "start": 10963.8,
      "end": 10965.56,
      "formatted_start": "03:02:43.800",
      "formatted_end": "03:02:45.560",
      "text": "به خودش زور می زنه"
    },
    {
      "id": 36,
      "start": 10965.56,
      "end": 10968.56,
      "formatted_start": "03:02:45.560",
      "formatted_end": "03:02:48.560",
      "text": "دو سی سی هم بهش گریب میکس شیر می دید"
    },
    {
      "id": 37,
      "start": 10968.56,
      "end": 10970.56,
      "formatted_start": "03:02:48.560",
      "formatted_end": "03:02:50.560",
      "text": "اگر نه دلدرد نداشت نمی دید"
    },
    {
      "id": 38,
      "start": 10970.56,
      "end": 10973.56,
      "formatted_start": "03:02:50.560",
      "formatted_end": "03:02:53.560",
      "text": "بعدش این کل هم می خواهد موقعی شیر خورده هم خواهد می شوند"
    },
    {
      "id": 39,
      "start": 10973.56,
      "end": 10977.0,
      "formatted_start": "03:02:53.560",
      "formatted_end": "03:02:57.000",
      "text": "خب خدا روشت که اصلا نمیخواد فقط هم پدیلکت بشون"
    },
    {
      "id": 40,
      "start": 10977.0,
      "end": 10977.8,
      "formatted_start": "03:02:57.000",
      "formatted_end": "03:02:57.800",
      "text": "خب"
    },
    {
      "id": 41,
      "start": 10977.8,
      "end": 10978.84,
      "formatted_start": "03:02:57.800",
      "formatted_end": "03:02:58.840",
      "text": "فقط برای"
    },
    {
      "id": 42,
      "start": 10978.84,
      "end": 10980.44,
      "formatted_start": "03:02:58.840",
      "formatted_end": "03:03:00.440",
      "text": "کلیکت"
    },
    {
      "id": 43,
      "start": 10980.44,
      "end": 10985.52,
      "formatted_start": "03:03:00.440",
      "formatted_end": "03:03:05.520",
      "text": "اونو برای بپیچه بیقراری در آران"
    },
    {
      "id": 44,
      "start": 10985.52,
      "end": 10988.08,
      "formatted_start": "03:03:05.520",
      "formatted_end": "03:03:08.080",
      "text": "اگه نداری که اصلا نمیخواد اینو نمیدونیم براتون"
    },
    {
      "id": 45,
      "start": 10988.08,
      "end": 10990.84,
      "formatted_start": "03:03:08.080",
      "formatted_end": "03:03:10.840",
      "text": "پدیلکت آران رو جدا بینم"
    },
    {
      "id": 46,
      "start": 10990.84,
      "end": 10992.88,
      "formatted_start": "03:03:10.840",
      "formatted_end": "03:03:12.880",
      "text": "پدیلکت رو هر روز براش بردین"
    },
    {
      "id": 47,
      "start": 10992.88,
      "end": 10994.56,
      "formatted_start": "03:03:12.880",
      "formatted_end": "03:03:14.560",
      "text": "و یک گیریب میکسرشو"
    },
    {
      "id": 48,
      "start": 10994.56,
      "end": 10998.52,
      "formatted_start": "03:03:14.560",
      "formatted_end": "03:03:18.520",
      "text": "کلیکتشو و گیریب میکسرشو در صورت بیقراری بشون"
    },
    {
      "id": 49,
      "start": 10998.52,
      "end": 10999.68,
      "formatted_start": "03:03:18.520",
      "formatted_end": "03:03:19.680",
      "text": "خب"
    },
    {
      "id": 50,
      "start": 10999.68,
      "end": 11003.24,
      "formatted_start": "03:03:19.680",
      "formatted_end": "03:03:23.240",
      "text": "فقط پس من برای اشپره بینمی نمیسم"
    },
    {
      "id": 51,
      "start": 11003.56,
      "end": 11017.56,
      "formatted_start": "03:03:23.560",
      "formatted_end": "03:03:37.560",
      "text": "در صورت نیاز، هر بخیل خیل می کرد کسی نر، یک پاف بزنید داخل هر سراخ خیل بیدیشید."
    },
    {
      "id": 52,
      "start": 11017.56,
      "end": 11020.56,
      "formatted_start": "03:03:37.560",
      "formatted_end": "03:03:40.560",
      "text": "شما هم یه ماشین بسکی اومده بودید نیست؟"
    },
    {
      "id": 53,
      "start": 11020.56,
      "end": 11021.56,
      "formatted_start": "03:03:40.560",
      "formatted_end": "03:03:41.560",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 11021.56,
      "end": 11025.56,
      "formatted_start": "03:03:41.560",
      "formatted_end": "03:03:45.560",
      "text": "بعد بختورا یه ماشین واسه شنوای سنجی بیادید."
    },
    {
      "id": 55,
      "start": 11025.56,
      "end": 11026.56,
      "formatted_start": "03:03:45.560",
      "formatted_end": "03:03:46.560",
      "text": "آهان"
    },
    {
      "id": 56,
      "start": 11026.56,
      "end": 11031.56,
      "formatted_start": "03:03:46.560",
      "formatted_end": "03:03:51.560",
      "text": "یا بسکی بدید یا باید بیدید تو محتم خصوصیش انجام بدید."
    },
    {
      "id": 57,
      "start": 11031.56,
      "end": 11033.56,
      "formatted_start": "03:03:51.560",
      "formatted_end": "03:03:53.560",
      "text": "نه بکنم تا اون پست که بیاد کنم"
    },
    {
      "id": 58,
      "start": 11033.56,
      "end": 11035.56,
      "formatted_start": "03:03:53.560",
      "formatted_end": "03:03:55.560",
      "text": "خب"
    },
    {
      "id": 59,
      "start": 11035.56,
      "end": 11037.56,
      "formatted_start": "03:03:55.560",
      "formatted_end": "03:03:57.560",
      "text": "کامیلش چی بود؟"
    },
    {
      "id": 60,
      "start": 11037.56,
      "end": 11039.56,
      "formatted_start": "03:03:57.560",
      "formatted_end": "03:03:59.560",
      "text": "همین"
    },
    {
      "id": 61,
      "start": 11039.56,
      "end": 11041.56,
      "formatted_start": "03:03:59.560",
      "formatted_end": "03:04:01.560",
      "text": "اسمش چی بازش دی؟"
    },
    {
      "id": 62,
      "start": 11041.56,
      "end": 11043.56,
      "formatted_start": "03:04:01.560",
      "formatted_end": "03:04:03.560",
      "text": "الای"
    },
    {
      "id": 63,
      "start": 11043.56,
      "end": 11045.56,
      "formatted_start": "03:04:03.560",
      "formatted_end": "03:04:05.560",
      "text": "خب این خدمت شما"
    },
    {
      "id": 64,
      "start": 11045.56,
      "end": 11047.56,
      "formatted_start": "03:04:05.560",
      "formatted_end": "03:04:07.560",
      "text": "این کلی که داشتم جادا می نویسن؟"
    },
    {
      "id": 65,
      "start": 11047.56,
      "end": 11049.56,
      "formatted_start": "03:04:07.560",
      "formatted_end": "03:04:09.560",
      "text": "اگه بیقراریش"
    },
    {
      "id": 66,
      "start": 11049.56,
      "end": 11051.56,
      "formatted_start": "03:04:09.560",
      "formatted_end": "03:04:11.560",
      "text": "زیاد شد که معمولا"
    },
    {
      "id": 67,
      "start": 11051.56,
      "end": 11053.56,
      "formatted_start": "03:04:11.560",
      "formatted_end": "03:04:13.560",
      "text": "برده یک ماهگی تا دو ماهگی"
    },
    {
      "id": 68,
      "start": 11053.56,
      "end": 11055.56,
      "formatted_start": "03:04:13.560",
      "formatted_end": "03:04:15.560",
      "text": "بعد تا بیقرارشو زیادو شید"
    },
    {
      "id": 69,
      "start": 11055.56,
      "end": 11057.56,
      "formatted_start": "03:04:15.560",
      "formatted_end": "03:04:17.560",
      "text": "بش بدین اگه نشدم که چه بهتر"
    },
    {
      "id": 70,
      "start": 11057.56,
      "end": 11059.56,
      "formatted_start": "03:04:17.560",
      "formatted_end": "03:04:19.560",
      "text": "خدا می شد"
    },
    {
      "id": 71,
      "start": 11059.56,
      "end": 11061.56,
      "formatted_start": "03:04:19.560",
      "formatted_end": "03:04:21.560",
      "text": "مهمولا میخوابیده"
    },
    {
      "id": 72,
      "start": 11061.56,
      "end": 11063.56,
      "formatted_start": "03:04:21.560",
      "formatted_end": "03:04:23.560",
      "text": "باداشو میگیرید"
    },
    {
      "id": 73,
      "start": 11063.56,
      "end": 11065.56,
      "formatted_start": "03:04:23.560",
      "formatted_end": "03:04:25.560",
      "text": "اکسپلور میگرده"
    },
    {
      "id": 74,
      "start": 11065.56,
      "end": 11067.56,
      "formatted_start": "03:04:25.560",
      "formatted_end": "03:04:27.560",
      "text": "این رو میخونید"
    },
    {
      "id": 75,
      "start": 11067.56,
      "end": 11069.56,
      "formatted_start": "03:04:27.560",
      "formatted_end": "03:04:29.560",
      "text": "اجرا میکنید"
    },
    {
      "id": 76,
      "start": 11069.56,
      "end": 11071.56,
      "formatted_start": "03:04:29.560",
      "formatted_end": "03:04:31.560",
      "text": "نه"
    },
    {
      "id": 77,
      "start": 11071.56,
      "end": 11073.56,
      "formatted_start": "03:04:31.560",
      "formatted_end": "03:04:33.560",
      "text": "یک نوک بیا"
    },
    {
      "id": 78,
      "start": 11073.56,
      "end": 11075.56,
      "formatted_start": "03:04:33.560",
      "formatted_end": "03:04:35.560",
      "text": "نه یه روز شبا میخوابه"
    },
    {
      "id": 79,
      "start": 11075.56,
      "end": 11077.56,
      "formatted_start": "03:04:35.560",
      "formatted_end": "03:04:37.560",
      "text": "یه روز کنار نمیخوابه"
    },
    {
      "id": 80,
      "start": 11077.56,
      "end": 11079.56,
      "formatted_start": "03:04:37.560",
      "formatted_end": "03:04:39.560",
      "text": "شبایی که نمیخوابه"
    },
    {
      "id": 81,
      "start": 11079.56,
      "end": 11081.56,
      "formatted_start": "03:04:39.560",
      "formatted_end": "03:04:41.560",
      "text": "اون گلویز شرمش بنده"
    },
    {
      "id": 82,
      "start": 11081.56,
      "end": 11083.56,
      "formatted_start": "03:04:41.560",
      "formatted_end": "03:04:43.560",
      "text": "دو سی سی بهش بده"
    },
    {
      "id": 83,
      "start": 11083.56,
      "end": 11085.56,
      "formatted_start": "03:04:43.560",
      "formatted_end": "03:04:45.560",
      "text": "آرام بخش"
    },
    {
      "id": 84,
      "start": 11085.56,
      "end": 11087.56,
      "formatted_start": "03:04:45.560",
      "formatted_end": "03:04:47.560",
      "text": "خیلی متشامل"
    },
    {
      "id": 85,
      "start": 11087.56,
      "end": 11089.56,
      "formatted_start": "03:04:47.560",
      "formatted_end": "03:04:49.560",
      "text": "این نسخه ایو الان بگید"
    },
    {
      "id": 86,
      "start": 11089.56,
      "end": 11091.56,
      "formatted_start": "03:04:49.560",
      "formatted_end": "03:04:51.560",
      "text": "اینو که تا کردم"
    },
    {
      "id": 87,
      "start": 11091.56,
      "end": 11093.56,
      "formatted_start": "03:04:51.560",
      "formatted_end": "03:04:53.560",
      "text": "اگر خیلی لعب شد بگید"
    },
    {
      "id": 88,
      "start": 11093.56,
      "end": 11095.56,
      "formatted_start": "03:04:53.560",
      "formatted_end": "03:04:55.560",
      "text": "با خوش آمدید"
    }
  ],
  "status": "completed"
}