  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12312.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:12.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12330.0,
      "end": 12360.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:26:00.000",
      "text": "برای اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که"
    },
    {
      "id": 2,
      "start": 12360.0,
      "end": 12362.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:02.000",
      "text": "خدای شما چیز شده؟ برسید شما خوبی؟"
    },
    {
      "id": 3,
      "start": 12362.0,
      "end": 12364.0,
      "formatted_start": "03:26:02.000",
      "formatted_end": "03:26:04.000",
      "text": "سلام"
    },
    {
      "id": 4,
      "start": 12364.0,
      "end": 12366.0,
      "formatted_start": "03:26:04.000",
      "formatted_end": "03:26:06.000",
      "text": "سلام گلزه سر"
    },
    {
      "id": 5,
      "start": 12370.0,
      "end": 12372.0,
      "formatted_start": "03:26:10.000",
      "formatted_end": "03:26:12.000",
      "text": "محمد رسول"
    },
    {
      "id": 6,
      "start": 12372.0,
      "end": 12374.0,
      "formatted_start": "03:26:12.000",
      "formatted_end": "03:26:14.000",
      "text": "خب این الان وقت تیرزشو"
    },
    {
      "id": 7,
      "start": 12374.0,
      "end": 12376.0,
      "formatted_start": "03:26:14.000",
      "formatted_end": "03:26:16.000",
      "text": "چجوری میخوره محمد رسول؟ روزی پنجه میخوره"
    },
    {
      "id": 8,
      "start": 12376.0,
      "end": 12378.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:18.000",
      "text": "روزی پنجه هر روز؟ هر روز"
    },
    {
      "id": 9,
      "start": 12378.0,
      "end": 12380.0,
      "formatted_start": "03:26:18.000",
      "formatted_end": "03:26:20.000",
      "text": "خب"
    },
    {
      "id": 10,
      "start": 12380.0,
      "end": 12382.0,
      "formatted_start": "03:26:20.000",
      "formatted_end": "03:26:22.000",
      "text": "جمعه شو دوتا بخوره"
    },
    {
      "id": 11,
      "start": 12382.0,
      "end": 12384.0,
      "formatted_start": "03:26:22.000",
      "formatted_end": "03:26:24.000",
      "text": "دوتا؟ بله"
    },
    {
      "id": 12,
      "start": 12384.0,
      "end": 12386.0,
      "formatted_start": "03:26:24.000",
      "formatted_end": "03:26:26.000",
      "text": "جمعه ها رو یعنی سر بخوره"
    },
    {
      "id": 13,
      "start": 12386.0,
      "end": 12388.0,
      "formatted_start": "03:26:26.000",
      "formatted_end": "03:26:28.000",
      "text": "خب"
    },
    {
      "id": 14,
      "start": 12388.0,
      "end": 12390.0,
      "formatted_start": "03:26:28.000",
      "formatted_end": "03:26:30.000",
      "text": "برنویسن اینجا"
    },
    {
      "id": 15,
      "start": 12390.0,
      "end": 12393.0,
      "formatted_start": "03:26:30.000",
      "formatted_end": "03:26:33.000",
      "text": "محمد رسول"
    },
    {
      "id": 16,
      "start": 12393.64,
      "end": 12396.28,
      "formatted_start": "03:26:33.640",
      "formatted_end": "03:26:36.280",
      "text": "روزی پنجا"
    },
    {
      "id": 17,
      "start": 12396.28,
      "end": 12399.36,
      "formatted_start": "03:26:36.280",
      "formatted_end": "03:26:39.360",
      "text": "جمعه ها"
    },
    {
      "id": 18,
      "start": 12399.36,
      "end": 12399.9,
      "formatted_start": "03:26:39.360",
      "formatted_end": "03:26:39.900",
      "text": "سر"
    },
    {
      "id": 19,
      "start": 12399.9,
      "end": 12403.2,
      "formatted_start": "03:26:39.900",
      "formatted_end": "03:26:43.200",
      "text": "حالا ایلیسا"
    },
    {
      "id": 20,
      "start": 12403.2,
      "end": 12405.38,
      "formatted_start": "03:26:43.200",
      "formatted_end": "03:26:45.380",
      "text": "ایلیسا چی؟"
    },
    {
      "id": 21,
      "start": 12405.38,
      "end": 12406.82,
      "formatted_start": "03:26:45.380",
      "formatted_end": "03:26:46.820",
      "text": "اون روزی پنجا میکنه"
    },
    {
      "id": 22,
      "start": 12406.82,
      "end": 12408.26,
      "formatted_start": "03:26:46.820",
      "formatted_end": "03:26:48.260",
      "text": "ایلیسا"
    },
    {
      "id": 23,
      "start": 12408.26,
      "end": 12412.16,
      "formatted_start": "03:26:48.260",
      "formatted_end": "03:26:52.160",
      "text": "روزی پنجا"
    },
    {
      "id": 24,
      "start": 12412.16,
      "end": 12413.86,
      "formatted_start": "03:26:52.160",
      "formatted_end": "03:26:53.860",
      "text": "اینم جمعه ها سر"
    },
    {
      "id": 25,
      "start": 12413.86,
      "end": 12415.86,
      "formatted_start": "03:26:53.860",
      "formatted_end": "03:26:55.860",
      "text": "بیتامیدی بهشون میدین؟"
    },
    {
      "id": 26,
      "start": 12415.86,
      "end": 12417.86,
      "formatted_start": "03:26:55.860",
      "formatted_end": "03:26:57.860",
      "text": "آره هم گفتم."
    },
    {
      "id": 27,
      "start": 12417.86,
      "end": 12419.86,
      "formatted_start": "03:26:57.860",
      "formatted_end": "03:26:59.860",
      "text": "هفته یه بار؟"
    },
    {
      "id": 28,
      "start": 12419.86,
      "end": 12423.86,
      "formatted_start": "03:26:59.860",
      "formatted_end": "03:27:03.860",
      "text": "همه. اینها رو انجام میدن. سه ماه بعد آزمون."
    },
    {
      "id": 29,
      "start": 12423.86,
      "end": 12425.86,
      "formatted_start": "03:27:03.860",
      "formatted_end": "03:27:05.860",
      "text": "آزمونش."
    },
    {
      "id": 30,
      "start": 12425.86,
      "end": 12427.86,
      "formatted_start": "03:27:05.860",
      "formatted_end": "03:27:07.860",
      "text": "آره."
    },
    {
      "id": 31,
      "start": 12427.86,
      "end": 12429.86,
      "formatted_start": "03:27:07.860",
      "formatted_end": "03:27:09.860",
      "text": "امیدواری چند دومه؟"
    },
    {
      "id": 32,
      "start": 12429.86,
      "end": 12433.86,
      "formatted_start": "03:27:09.860",
      "formatted_end": "03:27:13.860",
      "text": "هیچ ده هیچ. سه ماه دیگه میشه هفته هشت دونه."
    },
    {
      "id": 33,
      "start": 12433.86,
      "end": 12435.86,
      "formatted_start": "03:27:13.860",
      "formatted_end": "03:27:15.860",
      "text": "آره."
    },
    {
      "id": 34,
      "start": 12435.86,
      "end": 12437.86,
      "formatted_start": "03:27:15.860",
      "formatted_end": "03:27:17.860",
      "text": "اول زلزلونی."
    },
    {
      "id": 35,
      "start": 12437.86,
      "end": 12439.86,
      "formatted_start": "03:27:17.860",
      "formatted_end": "03:27:19.860",
      "text": "آره."
    },
    {
      "id": 36,
      "start": 12439.86,
      "end": 12441.86,
      "formatted_start": "03:27:19.860",
      "formatted_end": "03:27:21.860",
      "text": "اینو فراموش کنی؟"
    },
    {
      "id": 37,
      "start": 12441.86,
      "end": 12443.86,
      "formatted_start": "03:27:21.860",
      "formatted_end": "03:27:23.860",
      "text": "این صرف های شریفی نیست"
    },
    {
      "id": 38,
      "start": 12443.86,
      "end": 12445.86,
      "formatted_start": "03:27:23.860",
      "formatted_end": "03:27:25.860",
      "text": "از که شروع شده"
    },
    {
      "id": 39,
      "start": 12445.86,
      "end": 12447.86,
      "formatted_start": "03:27:25.860",
      "formatted_end": "03:27:27.860",
      "text": "دو سه دوست"
    },
    {
      "id": 40,
      "start": 12447.86,
      "end": 12449.86,
      "formatted_start": "03:27:27.860",
      "formatted_end": "03:27:29.860",
      "text": "شروع شده"
    },
    {
      "id": 41,
      "start": 12449.86,
      "end": 12451.86,
      "formatted_start": "03:27:29.860",
      "formatted_end": "03:27:31.860",
      "text": "بسر بسرگرم"
    },
    {
      "id": 42,
      "start": 12451.86,
      "end": 12453.86,
      "formatted_start": "03:27:31.860",
      "formatted_end": "03:27:33.860",
      "text": "اینجا شمایی ورم کرده"
    },
    {
      "id": 43,
      "start": 12453.86,
      "end": 12455.86,
      "formatted_start": "03:27:33.860",
      "formatted_end": "03:27:35.860",
      "text": "اینجا شوی ورم کرده"
    },
    {
      "id": 44,
      "start": 12455.86,
      "end": 12457.86,
      "formatted_start": "03:27:35.860",
      "formatted_end": "03:27:37.860",
      "text": "این هم میخواستم بشون بده"
    },
    {
      "id": 45,
      "start": 12457.86,
      "end": 12459.86,
      "formatted_start": "03:27:37.860",
      "formatted_end": "03:27:39.860",
      "text": "نه دردو ببند"
    },
    {
      "id": 46,
      "start": 12459.86,
      "end": 12461.86,
      "formatted_start": "03:27:39.860",
      "formatted_end": "03:27:41.860",
      "text": "اینجا شوی زیاد ورم کرده"
    },
    {
      "id": 47,
      "start": 12461.86,
      "end": 12463.86,
      "formatted_start": "03:27:41.860",
      "formatted_end": "03:27:43.860",
      "text": "به چند روزی"
    },
    {
      "id": 48,
      "start": 12463.86,
      "end": 12465.86,
      "formatted_start": "03:27:43.860",
      "formatted_end": "03:27:45.860",
      "text": "اینجا شوی"
    },
    {
      "id": 49,
      "start": 12465.86,
      "end": 12467.86,
      "formatted_start": "03:27:45.860",
      "formatted_end": "03:27:47.860",
      "text": "قبل اینکه اومدن اینجا"
    },
    {
      "id": 50,
      "start": 12467.86,
      "end": 12469.86,
      "formatted_start": "03:27:47.860",
      "formatted_end": "03:27:49.860",
      "text": "بسیار شوی شدن"
    },
    {
      "id": 51,
      "start": 12469.86,
      "end": 12478.86,
      "formatted_start": "03:27:49.860",
      "formatted_end": "03:27:58.860",
      "text": "یک وقت های بزرگتر میشه یک وقت های بزرگتر میشه"
    },
    {
      "id": 52,
      "start": 12478.86,
      "end": 12481.86,
      "formatted_start": "03:27:58.860",
      "formatted_end": "03:28:01.860",
      "text": "اینجا پشت گردنش هم پره"
    },
    {
      "id": 53,
      "start": 12481.86,
      "end": 12482.86,
      "formatted_start": "03:28:01.860",
      "formatted_end": "03:28:02.860",
      "text": "اینجا هم هست"
    },
    {
      "id": 54,
      "start": 12482.86,
      "end": 12484.86,
      "formatted_start": "03:28:02.860",
      "formatted_end": "03:28:04.860",
      "text": "اون قدرت لندگرده شد دیگر"
    },
    {
      "id": 55,
      "start": 12484.86,
      "end": 12486.86,
      "formatted_start": "03:28:04.860",
      "formatted_end": "03:28:06.860",
      "text": "درانتو باز کن بگوش"
    },
    {
      "id": 56,
      "start": 12486.86,
      "end": 12489.86,
      "formatted_start": "03:28:06.860",
      "formatted_end": "03:28:09.860",
      "text": "افونت داره حتما که اینایی باز برام کرده"
    },
    {
      "id": 57,
      "start": 12489.86,
      "end": 12490.86,
      "formatted_start": "03:28:09.860",
      "formatted_end": "03:28:10.860",
      "text": "آره"
    },
    {
      "id": 58,
      "start": 12490.86,
      "end": 12493.86,
      "formatted_start": "03:28:10.860",
      "formatted_end": "03:28:13.860",
      "text": "لازه هاش هم متبرده میشه"
    },
    {
      "id": 59,
      "start": 12493.86,
      "end": 12494.86,
      "formatted_start": "03:28:13.860",
      "formatted_end": "03:28:14.860",
      "text": "آره"
    },
    {
      "id": 60,
      "start": 12494.86,
      "end": 12496.86,
      "formatted_start": "03:28:14.860",
      "formatted_end": "03:28:16.860",
      "text": "چند روزی دیگه اینجور شده"
    },
    {
      "id": 61,
      "start": 12496.86,
      "end": 12497.86,
      "formatted_start": "03:28:16.860",
      "formatted_end": "03:28:17.860",
      "text": "تب نکرده؟"
    },
    {
      "id": 62,
      "start": 12497.86,
      "end": 12499.86,
      "formatted_start": "03:28:17.860",
      "formatted_end": "03:28:19.860",
      "text": "نه تب نکرده داشته"
    },
    {
      "id": 63,
      "start": 12499.86,
      "end": 12506.86,
      "formatted_start": "03:28:19.860",
      "formatted_end": "03:28:26.860",
      "text": "من برای شعبت چرخوشگاه می نویسنم با یک هفته بهش بده"
    },
    {
      "id": 64,
      "start": 12506.86,
      "end": 12508.86,
      "formatted_start": "03:28:26.860",
      "formatted_end": "03:28:28.860",
      "text": "یک هفته دیگه بیان برینشو مخیده کنم"
    },
    {
      "id": 65,
      "start": 12508.86,
      "end": 12513.86,
      "formatted_start": "03:28:28.860",
      "formatted_end": "03:28:33.860",
      "text": "اگه دیدیم کچیک شده اگه کچیک نشده بود یه سانه که را برم"
    },
    {
      "id": 66,
      "start": 12513.86,
      "end": 12517.86,
      "formatted_start": "03:28:33.860",
      "formatted_end": "03:28:37.860",
      "text": "بیدارشت خواهید"
    },
    {
      "id": 67,
      "start": 12517.86,
      "end": 12519.86,
      "formatted_start": "03:28:37.860",
      "formatted_end": "03:28:39.860",
      "text": "باید برسی کنیم"
    },
    {
      "id": 68,
      "start": 12519.86,
      "end": 12521.86,
      "formatted_start": "03:28:39.860",
      "formatted_end": "03:28:41.860",
      "text": "خب شب بگیرم"
    },
    {
      "id": 69,
      "start": 12521.86,
      "end": 12523.86,
      "formatted_start": "03:28:41.860",
      "formatted_end": "03:28:43.860",
      "text": "فارمیتی نشین"
    },
    {
      "id": 70,
      "start": 12523.86,
      "end": 12525.86,
      "formatted_start": "03:28:43.860",
      "formatted_end": "03:28:45.860",
      "text": "۱۴۳"
    },
    {
      "id": 71,
      "start": 12525.86,
      "end": 12527.86,
      "formatted_start": "03:28:45.860",
      "formatted_end": "03:28:47.860",
      "text": "۱۲۰ ساها"
    },
    {
      "id": 72,
      "start": 12527.86,
      "end": 12529.86,
      "formatted_start": "03:28:47.860",
      "formatted_end": "03:28:49.860",
      "text": "چند کیلو بود؟"
    },
    {
      "id": 73,
      "start": 12529.86,
      "end": 12531.86,
      "formatted_start": "03:28:49.860",
      "formatted_end": "03:28:51.860",
      "text": "۱۲۰"
    },
    {
      "id": 74,
      "start": 12531.86,
      "end": 12533.86,
      "formatted_start": "03:28:51.860",
      "formatted_end": "03:28:53.860",
      "text": "یکمتر میریم برسی میکنیم"
    },
    {
      "id": 75,
      "start": 12533.86,
      "end": 12535.86,
      "formatted_start": "03:28:53.860",
      "formatted_end": "03:28:55.860",
      "text": "خواهید برسی میکنیم"
    },
    {
      "id": 76,
      "start": 12535.86,
      "end": 12537.86,
      "formatted_start": "03:28:55.860",
      "formatted_end": "03:28:57.860",
      "text": "فایده جان"
    },
    {
      "id": 77,
      "start": 12537.86,
      "end": 12539.86,
      "formatted_start": "03:28:57.860",
      "formatted_end": "03:28:59.860",
      "text": "برسی بگیرم"
    },
    {
      "id": 78,
      "start": 12539.86,
      "end": 12541.86,
      "formatted_start": "03:28:59.860",
      "formatted_end": "03:29:01.860",
      "text": "برسی بگیرم"
    },
    {
      "id": 79,
      "start": 12541.86,
      "end": 12543.86,
      "formatted_start": "03:29:01.860",
      "formatted_end": "03:29:03.860",
      "text": "برسی بگیرم"
    },
    {
      "id": 80,
      "start": 12543.86,
      "end": 12545.86,
      "formatted_start": "03:29:03.860",
      "formatted_end": "03:29:05.860",
      "text": "برسی بگیرم"
    },
    {
      "id": 81,
      "start": 12545.86,
      "end": 12547.86,
      "formatted_start": "03:29:05.860",
      "formatted_end": "03:29:07.860",
      "text": "همون رو بگیرم"
    },
    {
      "id": 82,
      "start": 12552.86,
      "end": 12554.86,
      "formatted_start": "03:29:12.860",
      "formatted_end": "03:29:14.860",
      "text": "۱۲۳۰"
    },
    {
      "id": 83,
      "start": 12559.86,
      "end": 12561.86,
      "formatted_start": "03:29:19.860",
      "formatted_end": "03:29:21.860",
      "text": "۱۲۳۰"
    },
    {
      "id": 84,
      "start": 12562.86,
      "end": 12564.86,
      "formatted_start": "03:29:22.860",
      "formatted_end": "03:29:24.860",
      "text": "یه ۱۴"
    },
    {
      "id": 85,
      "start": 12565.86,
      "end": 12567.86,
      "formatted_start": "03:29:25.860",
      "formatted_end": "03:29:27.860",
      "text": "یه نمیرم"
    },
    {
      "id": 86,
      "start": 12568.86,
      "end": 12570.86,
      "formatted_start": "03:29:28.860",
      "formatted_end": "03:29:30.860",
