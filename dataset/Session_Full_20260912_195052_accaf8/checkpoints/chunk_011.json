  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3329.98,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:29.980",
      "text": "مطب پزشکی"
    },
    {
      "id": 1,
      "start": 3330.0,
      "end": 3335.0,
      "formatted_start": "00:55:30.000",
      "formatted_end": "00:55:35.000",
      "text": "ولی وقتی فضول در حالت بریک قرار میدیم میگن زنی بهش رو افضایش میده"
    },
    {
      "id": 2,
      "start": 3335.0,
      "end": 3337.0,
      "formatted_start": "00:55:35.000",
      "formatted_end": "00:55:37.000",
      "text": "ما اینجا یه سوالی پیش میاد"
    },
    {
      "id": 3,
      "start": 3337.0,
      "end": 3342.0,
      "formatted_start": "00:55:37.000",
      "formatted_end": "00:55:42.000",
      "text": "سوال اینه که اگر ذرهت باتری ها تکمیل بود اگر باتری ها کاملی شارش شده بودن"
    },
    {
      "id": 4,
      "start": 3342.0,
      "end": 3346.0,
      "formatted_start": "00:55:42.000",
      "formatted_end": "00:55:46.000",
      "text": "چطور این یه تورموس های ایلیا کننده رو فقال میکنه"
    },
    {
      "id": 5,
      "start": 3346.0,
      "end": 3350.0,
      "formatted_start": "00:55:46.000",
      "formatted_end": "00:55:50.000",
      "text": "وقتی باتری ها پروشند بکمک موتور بنزینی این کار رو انجام میده"
    },
    {
      "id": 6,
      "start": 3350.0,
      "end": 3354.0,
      "formatted_start": "00:55:50.000",
      "formatted_end": "00:55:54.000",
      "text": "پاشش سخت به موتور بنزینی رو کردن قط میکنه"
    },
    {
      "id": 7,
      "start": 3354.0,
      "end": 3363.0,
      "formatted_start": "00:55:54.000",
      "formatted_end": "00:56:03.000",
      "text": "و با این کار باعث میشه که موتور بنزینی انرژی رو اطلاف بده و همین دوباره باعث میشه که خودروی شما شطاب مرفی به اداره کنه"
    },
    {
      "id": 8,
      "start": 3363.0,
      "end": 3373.0,
      "formatted_start": "00:56:03.000",
      "formatted_end": "00:56:13.000",
      "text": "رسویدیم قرار راجع به مسائل دیگه خودروی هیبرید تویتا صحبت کنیم و شایعات مربوط بین خودروها به پردازیم، اصلا فیجمون رو فایل داشته باشید"
    },
    {
      "id": 9,
      "start": 3373.0,
      "end": 3377.0,
      "formatted_start": "00:56:13.000",
      "formatted_end": "00:56:17.000",
      "text": "خودروهای هیبریدی تویتا رو توی شیب چجوری کنترل کنیم؟"
    },
    {
      "id": 10,
      "start": 3377.0,
      "end": 3391.0,
      "formatted_start": "00:56:17.000",
      "formatted_end": "00:56:31.000",
      "text": "تویترول کنیم. توی خود راه هیبریتی تویوتا حالتی کجور داره به نام بریک مود که شما سردندر وقتی به سطح چپ میدید باید حالت بریک مود میشید. بریم ببینیم کاربوندش چیه. در حالت عادی وقتی خودتون همچین شیره قرار میدید."
    },
    {
      "id": 11,
      "start": 3393.0,
      "end": 3396.0,
      "formatted_start": "00:56:33.000",
      "formatted_end": "00:56:36.000",
      "text": "خامسنین من میرم برگیردم."
    },
    {
      "id": 12,
      "start": 3407.0,
      "end": 3433.0,
      "formatted_start": "00:56:47.000",
      "formatted_end": "00:57:13.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 3463.0,
      "end": 3492.98,
      "formatted_start": "00:57:43.000",
      "formatted_end": "00:58:12.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 14,
      "start": 3493.0,
      "end": 3522.0,
      "formatted_start": "00:58:13.000",
