  "stt_segments": [
    {
      "id": 0,
      "start": 300.0,
      "end": 317.0,
      "formatted_start": "00:05:00.000",
      "formatted_end": "00:05:17.000",
      "text": "مردیت از این مردیت رو باید بردارید."
    },
    {
      "id": 1,
      "start": 317.0,
      "end": 320.0,
      "formatted_start": "00:05:17.000",
      "formatted_end": "00:05:20.000",
      "text": "خب وضعیت اون عمومیش خوبه خب"
    },
    {
      "id": 2,
      "start": 320.0,
      "end": 325.0,
      "formatted_start": "00:05:20.000",
      "formatted_end": "00:05:25.000",
      "text": "وقتی این آزمایش رو می کنیم از این مدیره خوبه خب"
    },
    {
      "id": 3,
      "start": 325.0,
      "end": 327.0,
      "formatted_start": "00:05:25.000",
      "formatted_end": "00:05:27.000",
      "text": "از اینکه از این آزمایش های قبلی شما می دن بگیرن"
    },
    {
      "id": 4,
      "start": 327.0,
      "end": 329.0,
      "formatted_start": "00:05:27.000",
      "formatted_end": "00:05:29.000",
      "text": "چون سیستمه دیگه"
    },
    {
      "id": 5,
      "start": 329.0,
      "end": 332.0,
      "formatted_start": "00:05:29.000",
      "formatted_end": "00:05:32.000",
      "text": "خب یه عکسی می دهد بگنم یا"
    },
    {
      "id": 6,
      "start": 332.0,
      "end": 334.0,
      "formatted_start": "00:05:32.000",
      "formatted_end": "00:05:34.000",
      "text": "کاغذی چاپ می کردن"
    },
    {
      "id": 7,
      "start": 334.0,
      "end": 338.0,
      "formatted_start": "00:05:34.000",
      "formatted_end": "00:05:38.000",
      "text": "شما به آزمایش ۱۱۵ گرفته شده"
    },
    {
      "id": 8,
      "start": 338.0,
      "end": 340.0,
      "formatted_start": "00:05:38.000",
      "formatted_end": "00:05:40.000",
      "text": "الان بچه سنیر چقدره؟"
    },
    {
      "id": 9,
      "start": 340.0,
      "end": 345.0,
      "formatted_start": "00:05:40.000",
      "formatted_end": "00:05:45.000",
      "text": "الان چهاره شش دوماش پرمی شد"
    },
    {
      "id": 10,
      "start": 345.0,
      "end": 356.0,
      "formatted_start": "00:05:45.000",
      "formatted_end": "00:05:56.000",
      "text": "فیلم با این آزمایش نیاز به دارو نداره ولی بهتره یک ماه چهر روزگیه دوباره این آزمایش دکرار بشه"
    },
    {
      "id": 11,
      "start": 356.0,
      "end": 361.0,
      "formatted_start": "00:05:56.000",
      "formatted_end": "00:06:01.000",
      "text": "بله بله خون گیری بشه از کف و پال نیست دیگه"
    },
    {
      "id": 12,
      "start": 361.0,
      "end": 366.0,
      "formatted_start": "00:06:01.000",
      "formatted_end": "00:06:06.000",
      "text": "بچه ریزه خود کسی هم که خون گیره خیلی به سخت بشه"
    },
    {
      "id": 13,
      "start": 366.0,
      "end": 372.0,
      "formatted_start": "00:06:06.000",
      "formatted_end": "00:06:12.000",
      "text": "الان تا اون موقع بزرگتر میشه ولی این آزمایش خوبه نیاز به دارو نداره"
    },
    {
      "id": 14,
      "start": 372.0,
      "end": 374.0,
      "formatted_start": "00:06:12.000",
      "formatted_end": "00:06:14.000",
      "text": "بچه چیزی نیست"
    },
    {
      "id": 15,
      "start": 374.0,
      "end": 376.0,
      "formatted_start": "00:06:14.000",
      "formatted_end": "00:06:16.000",
      "text": "بسونه بچه هم مدت شده"
    },
    {
      "id": 16,
      "start": 376.0,
      "end": 380.0,
      "formatted_start": "00:06:16.000",
      "formatted_end": "00:06:20.000",
      "text": "مرکز بیداش من براش جاوشم میدیسم"
    },
    {
      "id": 17,
      "start": 380.0,
      "end": 382.0,
      "formatted_start": "00:06:20.000",
      "formatted_end": "00:06:22.000",
      "text": "با توجه برم"
    },
    {
      "id": 18,
      "start": 382.0,
      "end": 384.0,
      "formatted_start": "00:06:22.000",
      "formatted_end": "00:06:24.000",
      "text": "برقیلی دیگه"
    },
    {
      "id": 19,
      "start": 384.0,
      "end": 386.0,
      "formatted_start": "00:06:24.000",
      "formatted_end": "00:06:26.000",
      "text": "بخ"
    },
    {
      "id": 20,
      "start": 386.0,
      "end": 388.0,
      "formatted_start": "00:06:26.000",
      "formatted_end": "00:06:28.000",
      "text": "یا"
    },
    {
      "id": 21,
      "start": 388.0,
      "end": 390.0,
      "formatted_start": "00:06:28.000",
      "formatted_end": "00:06:30.000",
      "text": "بخ ندارد"
    },
    {
      "id": 22,
      "start": 390.0,
      "end": 392.0,
      "formatted_start": "00:06:30.000",
      "formatted_end": "00:06:32.000",
      "text": "تیگیری"
    },
    {
      "id": 23,
      "start": 392.0,
      "end": 394.0,
      "formatted_start": "00:06:32.000",
      "formatted_end": "00:06:34.000",
      "text": "یک ماه"
    },
    {
      "id": 24,
      "start": 394.0,
      "end": 396.0,
      "formatted_start": "00:06:34.000",
      "formatted_end": "00:06:36.000",
      "text": "نتفض"
    },
    {
      "id": 25,
      "start": 396.0,
      "end": 398.0,
      "formatted_start": "00:06:36.000",
      "formatted_end": "00:06:38.000",
      "text": "خلیب جان"
    },
    {
      "id": 26,
      "start": 398.0,
      "end": 400.0,
      "formatted_start": "00:06:38.000",
      "formatted_end": "00:06:40.000",
      "text": "یعنی این امروز چنده ماه؟ پونزه ماه"
    },
    {
      "id": 27,
      "start": 400.0,
      "end": 402.0,
      "formatted_start": "00:06:40.000",
      "formatted_end": "00:06:42.000",
      "text": "بره بره بره بره"
    },
    {
      "id": 28,
      "start": 402.0,
      "end": 404.0,
      "formatted_start": "00:06:42.000",
      "formatted_end": "00:06:44.000",
      "text": "این دیویشه بهتر یک مایز که نمانده خواهیشون"
    },
    {
      "id": 29,
      "start": 404.0,
      "end": 406.0,
      "formatted_start": "00:06:44.000",
      "formatted_end": "00:06:46.000",
