  "stt_segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 10.0,
      "formatted_start": "00:00:00.000",
      "formatted_end": "00:00:10.000",
      "text": "خانم روش، چی شده؟"
    },
    {
      "id": 1,
      "start": 10.0,
      "end": 19.0,
      "formatted_start": "00:00:10.000",
      "formatted_end": "00:00:19.000",
      "text": "آقای دکتر، من یک چیز رو پیشم آوردم، دکتر هم همین مورد غذا کنند، اینجور نفس میکشند."
    },
    {
      "id": 2,
      "start": 19.0,
      "end": 27.0,
      "formatted_start": "00:00:19.000",
      "formatted_end": "00:00:27.000",
      "text": "بر شما یک قرص داده بودند، بعد گفتید که این رو یک چهار مرد استفاده کنند، بعد اگر خوب نشد، ببرید رو هم تزه شدید."
    },
    {
      "id": 3,
      "start": 27.0,
      "end": 30.5,
      "formatted_start": "00:00:27.000",
      "formatted_end": "00:00:30.500",
      "text": "ولی آقاون باز گفتن که بیادن پیش شما"
    },
    {
      "id": 4,
      "start": 30.5,
      "end": 33.0,
      "formatted_start": "00:00:30.500",
      "formatted_end": "00:00:33.000",
      "text": "گفتن که اگه میشی دوباره از اون پرسا برم"
    },
    {
      "id": 5,
      "start": 33.0,
      "end": 35.0,
      "formatted_start": "00:00:33.000",
      "formatted_end": "00:00:35.000",
      "text": "اون ریمی تیک هسبیه"
    },
    {
      "id": 6,
      "start": 35.0,
      "end": 36.0,
      "formatted_start": "00:00:35.000",
      "formatted_end": "00:00:36.000",
      "text": "آجانی"
    },
    {
      "id": 7,
      "start": 36.0,
      "end": 38.0,
      "formatted_start": "00:00:36.000",
      "formatted_end": "00:00:38.000",
      "text": "همینجوری میکنه"
    },
    {
      "id": 8,
      "start": 38.0,
      "end": 40.0,
      "formatted_start": "00:00:38.000",
      "formatted_end": "00:00:40.000",
      "text": "اینا استراف های رویی دارن"
    },
    {
      "id": 9,
      "start": 40.0,
      "end": 42.0,
      "formatted_start": "00:00:40.000",
      "formatted_end": "00:00:42.000",
      "text": "و یه پرسایی بود روزی دوبار دادیم"
    },
    {
      "id": 10,
      "start": 42.0,
      "end": 44.0,
      "formatted_start": "00:00:42.000",
      "formatted_end": "00:00:44.000",
      "text": "حالی پیلیدون این بود"
    },
    {
      "id": 11,
      "start": 44.0,
      "end": 46.0,
      "formatted_start": "00:00:44.000",
      "formatted_end": "00:00:46.000",
      "text": "خب بگی اینجام اونجام"
    },
    {
      "id": 12,
      "start": 46.0,
      "end": 48.0,
      "formatted_start": "00:00:46.000",
      "formatted_end": "00:00:48.000",
      "text": "هرنو مشکل دیگه هم داره"
    },
    {
      "id": 13,
      "start": 48.0,
      "end": 50.0,
      "formatted_start": "00:00:48.000",
      "formatted_end": "00:00:50.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 14,
      "start": 50.0,
      "end": 52.0,
      "formatted_start": "00:00:50.000",
      "formatted_end": "00:00:52.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 15,
      "start": 52.0,
      "end": 54.0,
      "formatted_start": "00:00:52.000",
      "formatted_end": "00:00:54.000",
      "text": "از اینجا باید برداریم"
    },
