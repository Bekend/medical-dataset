      "start": 98.0,
      "end": 100.0,
      "formatted_start": "00:01:38.000",
      "formatted_end": "00:01:40.000",
      "text": "اوارزی چیزی هم که نداریم"
    },
    {
      "id": 35,
      "start": 100.0,
      "end": 102.0,
      "formatted_start": "00:01:40.000",
      "formatted_end": "00:01:42.000",
      "text": "ببین اوارز نه"
    },
    {
      "id": 36,
      "start": 102.0,
      "end": 104.0,
      "formatted_start": "00:01:42.000",
      "formatted_end": "00:01:44.000",
      "text": "اوارز نه"
    },
    {
      "id": 37,
      "start": 104.0,
      "end": 107.5,
      "formatted_start": "00:01:44.000",
      "formatted_end": "00:01:47.500",
      "text": "از پیش هر داروی اواره زیره رو برم اینقدر تمامیدیم نه"
    },
    {
      "id": 38,
      "start": 107.5,
      "end": 108.5,
      "formatted_start": "00:01:47.500",
      "formatted_end": "00:01:48.500",
      "text": "باشه"
    },
    {
      "id": 39,
      "start": 108.5,
      "end": 112.5,
      "formatted_start": "00:01:48.500",
      "formatted_end": "00:01:52.500",
      "text": "روان پیزش میگه که ازم خودون یکی برم"
    },
    {
      "id": 40,
      "start": 112.5,
      "end": 113.5,
      "formatted_start": "00:01:52.500",
      "formatted_end": "00:01:53.500",
      "text": "روان پیزش که"
    },
    {
      "id": 41,
      "start": 113.5,
      "end": 116.5,
      "formatted_start": "00:01:53.500",
      "formatted_end": "00:01:56.500",
      "text": "یعنی کهی برم یعنی لازم همین دارو برم"
    },
    {
      "id": 42,
      "start": 116.5,
      "end": 117.5,
      "formatted_start": "00:01:56.500",
      "formatted_end": "00:01:57.500",
      "text": "آره دکتوری جمالیم"
    },
    {
      "id": 43,
      "start": 117.5,
      "end": 123.0,
      "formatted_start": "00:01:57.500",
      "formatted_end": "00:02:03.000",
      "text": "آره که این هم عرصه دیگه دارو برده و بعد اگه دیده بهتر شده برطرفش اگه نشد دکتوری جمالیم"
    },
    {
      "id": 44,
      "start": 123.0,
      "end": 126.0,
      "formatted_start": "00:02:03.000",
      "formatted_end": "00:02:06.000",
      "text": "آه باشه دبلرم عرص برده بود بهتر شده بود"
    },
    {
      "id": 45,
      "start": 126.0,
      "end": 127.0,
      "formatted_start": "00:02:06.000",
      "formatted_end": "00:02:07.000",
      "text": "آره"
    },
    {
      "id": 46,
      "start": 127.0,
      "end": 129.0,
      "formatted_start": "00:02:07.000",
      "formatted_end": "00:02:09.000",
      "text": "این روز چکرار کشت"
    },
    {
      "id": 47,
      "start": 129.0,
      "end": 135.0,
      "formatted_start": "00:02:09.000",
      "formatted_end": "00:02:15.000",
      "text": "خب همون این رو اگر این فشار تو خانواده یا محیط باشه توانته بوجوده"
    },
    {
      "id": 48,
      "start": 135.0,
      "end": 137.0,
      "formatted_start": "00:02:15.000",
      "formatted_end": "00:02:17.000",
      "text": "اون فشارم خیلی سخته برداشته بگیرم"
    },
    {
      "id": 49,
      "start": 137.0,
      "end": 141.0,
      "formatted_start": "00:02:17.000",
      "formatted_end": "00:02:21.000",
      "text": "مثلا برای اون چیزهایی هست کار بندون لاین هرده"
    },
    {
      "id": 50,
      "start": 141.0,
      "end": 147.0,
      "formatted_start": "00:02:21.000",
      "formatted_end": "00:02:27.000",
      "text": "اگه بچه رو ببینی روانشناس از در روش کار کنه مثلا بیایی آتون موقعیتهایی خیلی نارد نباشه"
    },
    {
      "id": 51,
      "start": 147.0,
      "end": 151.0,
      "formatted_start": "00:02:27.000",
      "formatted_end": "00:02:31.000",
      "text": "مثلا رد میشه میگذره زمان خودش حل میکنه"
    },
    {
      "id": 52,
      "start": 151.0,
      "end": 154.0,
      "formatted_start": "00:02:31.000",
      "formatted_end": "00:02:34.000",
      "text": "برده چند دیگه مثلا خیلی کار و کور میکنن برا خودشون"
    },
    {
      "id": 53,
      "start": 154.0,
      "end": 157.0,
      "formatted_start": "00:02:34.000",
      "formatted_end": "00:02:37.000",
      "text": "دراصل من خواهیم سپس بخواهم بخواهم"
    },
    {
      "id": 54,
      "start": 157.0,
      "end": 159.0,
      "formatted_start": "00:02:37.000",
      "formatted_end": "00:02:39.000",
      "text": "باش"
    },
    {
      "id": 55,
      "start": 171.0,
      "end": 174.0,
      "formatted_start": "00:02:51.000",
      "formatted_end": "00:02:54.000",
      "text": "بفهم اینجا سلامت شما خوبه خوش آمدید"
    },
    {
      "id": 56,
      "start": 174.0,
      "end": 176.0,
      "formatted_start": "00:02:54.000",
      "formatted_end": "00:02:56.000",
      "text": "سلامت شما خوبه"
    },
    {
      "id": 57,
      "start": 176.0,
      "end": 178.0,
      "formatted_start": "00:02:56.000",
      "formatted_end": "00:02:58.000",
      "text": "کچه دو رو بزنید روی تنگ بزنید"
    },
    {
      "id": 58,
      "start": 178.0,
      "end": 182.0,
      "formatted_start": "00:02:58.000",
      "formatted_end": "00:03:02.000",
      "text": "برکتون رو امایبر کنید"
    },
    {
      "id": 59,
      "start": 182.0,
      "end": 186.0,
      "formatted_start": "00:03:02.000",
      "formatted_end": "00:03:06.000",
      "text": "خوب چی شده؟"
    },
    {
      "id": 60,
      "start": 186.0,
      "end": 190.0,
      "formatted_start": "00:03:06.000",
      "formatted_end": "00:03:10.000",
      "text": "پرد تیرویت رو شاگردیم باشم"
    },
    {
      "id": 61,
      "start": 190.0,
      "end": 194.0,
      "formatted_start": "00:03:10.000",
      "formatted_end": "00:03:14.000",
      "text": "آزمایش تیرویت؟"
    },
    {
      "id": 62,
      "start": 194.0,
      "end": 198.0,
      "formatted_start": "00:03:14.000",
      "formatted_end": "00:03:18.000",
      "text": "قفمار رو می آردیم"
    },
    {
      "id": 63,
      "start": 198.0,
      "end": 202.0,
      "formatted_start": "00:03:18.000",
      "formatted_end": "00:03:22.000",
      "text": "مرایل قبلیش هم دارید؟"
    },
    {
      "id": 64,
      "start": 202.0,
      "end": 206.0,
      "formatted_start": "00:03:22.000",
      "formatted_end": "00:03:26.000",
      "text": "نه آزمایش ها تو سیستم بود"
    },
    {
      "id": 65,
      "start": 206.0,
      "end": 209.84,
      "formatted_start": "00:03:26.000",
      "formatted_end": "00:03:29.840",
      "text": "آزمایش های کفیر رو ندادن بگیرم نامه ندادن بهتون"
    },
    {
      "id": 66,
      "start": 209.84,
      "end": 213.24,
      "formatted_start": "00:03:29.840",
      "formatted_end": "00:03:33.240",
      "text": "معمولا نامه میدن بگیرم برگیر میدن به ما"
    },
    {
      "id": 67,
      "start": 213.24,
      "end": 215.24,
      "formatted_start": "00:03:33.240",
      "formatted_end": "00:03:35.240",
      "text": "بیداش رفتیم رفتیم"
    },
    {
      "id": 68,
      "start": 215.24,
      "end": 220.56,
      "formatted_start": "00:03:35.240",
      "formatted_end": "00:03:40.560",
      "text": "میفرستن همه پیش ما ولی اون یه نامه هم باش همراش میفرستن"
    },
    {
      "id": 69,
      "start": 220.56,
      "end": 222.76,
      "formatted_start": "00:03:40.560",
      "formatted_end": "00:03:42.760",
      "text": "ببین چیزی ندادن گفتم بینون بشو"
    },
    {
      "id": 70,
      "start": 222.76,
      "end": 225.52,
      "formatted_start": "00:03:42.760",
      "formatted_end": "00:03:45.520",
      "text": "ببینین این الان آزمایش ها نرماله"
    },
    {
      "id": 71,
      "start": 225.52,
      "end": 227.52,
      "formatted_start": "00:03:45.520",
      "formatted_end": "00:03:47.520",
      "text": "نرمال نرمال"
    },
    {
      "id": 72,
      "start": 227.52,
      "end": 229.52,
      "formatted_start": "00:03:47.520",
      "formatted_end": "00:03:49.520",
      "text": "مرکز بیداشت کجاییم"
    },
    {
      "id": 73,
      "start": 229.52,
      "end": 231.52,
      "formatted_start": "00:03:49.520",
      "formatted_end": "00:03:51.520",
      "text": "زینبابا"
    },
    {
      "id": 74,
      "start": 231.52,
      "end": 235.02,
      "formatted_start": "00:03:51.520",
      "formatted_end": "00:03:55.020",
      "text": "این آزمایش ها خوبه بیشتر تکتر بدید"
    },
    {
      "id": 75,
      "start": 235.02,
      "end": 236.52,
      "formatted_start": "00:03:55.020",
      "formatted_end": "00:03:56.520",
      "text": "آزمایش چندامه هست؟"
    },
    {
      "id": 76,
      "start": 236.52,
      "end": 237.52,
      "formatted_start": "00:03:56.520",
      "formatted_end": "00:03:57.520",
      "text": "تنجون"
    },
    {
      "id": 77,
      "start": 237.52,
      "end": 239.52,
      "formatted_start": "00:03:57.520",
      "formatted_end": "00:03:59.520",
      "text": "چارامه تنجون"
    },
    {
      "id": 78,
      "start": 239.52,
      "end": 240.52,
      "formatted_start": "00:03:59.520",
      "formatted_end": "00:04:00.520",
      "text": "هرکی گرفتیم"
    },
    {
      "id": 79,
      "start": 240.52,
      "end": 243.52,
      "formatted_start": "00:04:00.520",
      "formatted_end": "00:04:03.520",
      "text": "گرسی چیزی بهش ندارن با خواهش؟"
    },
    {
      "id": 80,
      "start": 243.52,
      "end": 245.52,
      "formatted_start": "00:04:03.520",
      "formatted_end": "00:04:05.520",
      "text": "هرچی بله یوانسان چند بستری بوده"
    },
    {
      "id": 81,
      "start": 245.52,
      "end": 246.52,
      "formatted_start": "00:04:05.520",
      "formatted_end": "00:04:06.520",
      "text": "نه همون هم گرسی نداره"
    },
    {
      "id": 82,
      "start": 246.52,
      "end": 247.52,
      "formatted_start": "00:04:06.520",
      "formatted_end": "00:04:07.520",
      "text": "نه نه آوردش شده"
    },
    {
      "id": 83,
      "start": 247.52,
      "end": 248.52,
      "formatted_start": "00:04:07.520",
      "formatted_end": "00:04:08.520",
      "text": "اونا گرسی نداره"
    },
    {
      "id": 84,
      "start": 248.52,
      "end": 249.52,
      "formatted_start": "00:04:08.520",
      "formatted_end": "00:04:09.520",
      "text": "نه"
    },
    {
      "id": 85,
      "start": 249.52,
      "end": 250.52,
      "formatted_start": "00:04:09.520",
      "formatted_end": "00:04:10.520",
      "text": "اونجاست"
    },
    {
      "id": 86,
      "start": 252.52,
      "end": 255.52,
      "formatted_start": "00:04:12.520",
      "formatted_end": "00:04:15.520",
      "text": "بچه هم افناه به داره آمده"
    },
    {
      "id": 87,
      "start": 255.52,
      "end": 256.52,
      "formatted_start": "00:04:15.520",
      "formatted_end": "00:04:16.520",
      "text": "بسیار آمده"
    },
    {
      "id": 88,
      "start": 256.52,
      "end": 259.52,
      "formatted_start": "00:04:16.520",
      "formatted_end": "00:04:19.520",
      "text": "یک نوپاوی دو دسته و مهارستان بوده"
    },
    {
      "id": 89,
      "start": 259.52,
      "end": 262.52,
      "formatted_start": "00:04:19.520",
      "formatted_end": "00:04:22.520",
      "text": "سابقه یک مشکل اتیرویی تو خانواده بودی نه"
    },
    {
      "id": 90,
      "start": 262.52,
      "end": 263.52,
      "formatted_start": "00:04:22.520",
      "formatted_end": "00:04:23.520",
      "text": "نه اصلا نه بگو"
    },
    {
      "id": 91,
      "start": 263.52,
      "end": 265.52,
      "formatted_start": "00:04:23.520",
      "formatted_end": "00:04:25.520",
      "text": "جام آما"
    },
    {
      "id": 92,
      "start": 270.52,
      "end": 272.52,
      "formatted_start": "00:04:30.520",
      "formatted_end": "00:04:32.520",
      "text": "این برجستی و استخونه اشکال دونه"
    },
    {
      "id": 93,
      "start": 272.52,
      "end": 273.52,
      "formatted_start": "00:04:32.520",
      "formatted_end": "00:04:33.520",
      "text": "آره"
    },
    {
      "id": 94,
      "start": 274.52,
      "end": 275.52,
      "formatted_start": "00:04:34.520",
      "formatted_end": "00:04:35.520",
      "text": "کسی کنه کنه"
    },
    {
      "id": 95,
      "start": 275.52,
      "end": 277.52,
      "formatted_start": "00:04:35.520",
      "formatted_end": "00:04:37.520",
      "text": "نه ماما"
    },
    {
      "id": 96,
      "start": 287.52,
      "end": 288.52,
      "formatted_start": "00:04:47.520",
      "formatted_end": "00:04:48.520",
      "text": "نه نه نه"
    },
    {
      "id": 97,
      "start": 289.52,
      "end": 293.52,
      "formatted_start": "00:04:49.520",
      "formatted_end": "00:04:53.520",
      "text": "ماما میدونه"
    },
    {
      "id": 98,
      "start": 293.52,
      "end": 299.52,
      "formatted_start": "00:04:53.520",
      "formatted_end": "00:04:59.520",
      "text": "اینکه میبینید با اون"
    }
