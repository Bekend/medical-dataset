  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5405.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:05.000",
      "text": "از اینجا همون بچه ای من رو سیناتی ببینم، والا اصلا دیگه خسته شدم، دلش شدم."
    },
    {
      "id": 1,
      "start": 5405.0,
      "end": 5412.0,
      "formatted_start": "01:30:05.000",
      "formatted_end": "01:30:12.000",
      "text": "من ارمان میباهم وقتی که من ارمان در دست پذیر باشم، یه در وقت بیرم کار مادر من انجام میدن."
    },
    {
      "id": 2,
      "start": 5412.0,
      "end": 5417.0,
      "formatted_start": "01:30:12.000",
      "formatted_end": "01:30:17.000",
      "text": "دو روز بیرم کار مادر من انجام میدن، از درم شوهرم که باشه تا الان..."
    },
    {
      "id": 3,
      "start": 5417.0,
      "end": 5420.0,
      "formatted_start": "01:30:17.000",
      "formatted_end": "01:30:20.000",
      "text": "من خمینه که دیگه در اینجا درست باید صحبت میکنم،"
    },
    {
      "id": 4,
      "start": 5420.0,
      "end": 5426.0,
      "formatted_start": "01:30:20.000",
      "formatted_end": "01:30:26.000",
      "text": "ولی جنگی که بینم فاضل آقا سبزینه یه چیه، این نمی برداشت دوست داره که بردرم خواستم این بیا."
    },
    {
      "id": 5,
      "start": 5426.0,
      "end": 5433.0,
      "formatted_start": "01:30:26.000",
      "formatted_end": "01:30:33.000",
      "text": "اما ولی فاضل آقا سبزینه یا یه جا تفریقا هسته، فهم کمشگاه بیا و برداشتون ببینم بیا خواب."
    },
    {
      "id": 6,
      "start": 5433.0,
      "end": 5438.0,
      "formatted_start": "01:30:33.000",
      "formatted_end": "01:30:38.000",
      "text": "ولی من برداشتم بگم که چی از چی از نیمه یعنی من شنیدم،"
    },
    {
      "id": 7,
      "start": 5438.0,
      "end": 5443.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:43.000",
      "text": "تا رو بیرون بیرون برم تنها تنها تنها میشتم که من خواهم میگم من وقت دارم برم."
    },
    {
      "id": 8,
      "start": 5443.0,
      "end": 5449.0,
      "formatted_start": "01:30:43.000",
      "formatted_end": "01:30:49.000",
      "text": "من از یک جانبه بخشم که تا تو رو رو از جا رو خوانم نیست"
    },
    {
      "id": 9,
      "start": 5449.0,
      "end": 5455.0,
      "formatted_start": "01:30:49.000",
      "formatted_end": "01:30:55.000",
      "text": "که دارم این رو آخوردم، بگم نمیدونم چند کار رو کنم، براته که باید باید آنها باید با هفته شب به صابو"
    },
    {
      "id": 10,
      "start": 5455.0,
      "end": 5461.0,
      "formatted_start": "01:30:55.000",
      "formatted_end": "01:31:01.000",
      "text": "به صابو به شوری بیاد، یک جایی افترن ندارم، یک جایی ندارم، در اینجا من این بودم"
    },
    {
      "id": 11,
      "start": 5461.0,
      "end": 5465.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:05.000",
      "text": "گرم من شما بردم، من بردم، بردم چی کنم، در اونکه من درد"
    },
    {
      "id": 12,
      "start": 5465.0,
      "end": 5475.0,
      "formatted_start": "01:31:05.000",
      "formatted_end": "01:31:15.000",
      "text": "اگر بگم با درگرم هایی نیستیم، بگم هایش برمشه، نیزنی ها را برمشه، که در اینجا برمشه، با مرشوشت ها برمشه، در اینجا برمشه، که در اینجا برمشه، که چکم را برمشه"
    },
    {
      "id": 13,
      "start": 5475.0,
      "end": 5505.0,
      "formatted_start": "01:31:15.000",
      "formatted_end": "01:31:45.000",
      "text": "اون رو برم، خواهد. نه، بسیار برم، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، بسیار برم، نه، ب"
    },
    {
      "id": 14,
      "start": 5505.0,
      "end": 5535.0,
      "formatted_start": "01:31:45.000",
      "formatted_end": "01:32:15.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینج"
    },
    {
      "id": 15,
      "start": 5535.0,
      "end": 5537.0,
      "formatted_start": "01:32:15.000",
      "formatted_end": "01:32:17.000",
      "text": "این باید هر درده هستید."
    },
    {
      "id": 16,
      "start": 5543.0,
      "end": 5545.0,
      "formatted_start": "01:32:23.000",
      "formatted_end": "01:32:25.000",
      "text": "آن را باید بردارید."
    },
