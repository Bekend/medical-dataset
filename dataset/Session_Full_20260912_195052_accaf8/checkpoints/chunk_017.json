  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5110.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:10.000",
      "text": "آره، آره، آم فرین، آم فرین، آره."
    },
    {
      "id": 1,
      "start": 5110.0,
      "end": 5118.0,
      "formatted_start": "01:25:10.000",
      "formatted_end": "01:25:18.000",
      "text": "تو بگه که، فرین شانه، این موقع چی میگه؟ در این ساعت، آقاون رو بگه، اینجوری که خواه."
    },
    {
      "id": 2,
      "start": 5118.0,
      "end": 5123.0,
      "formatted_start": "01:25:18.000",
      "formatted_end": "01:25:23.000",
      "text": "میدونه اگه میبین دولت بیمار به آقاون رو بگه، نه داره خواه من بیمار برای پشت با آقاون."
    },
    {
      "id": 3,
      "start": 5123.0,
      "end": 5127.4,
      "formatted_start": "01:25:23.000",
      "formatted_end": "01:25:27.400",
      "text": "اینجورم برای خواهشتگاه هم نگذاریم که روزشار سرگز میزنه"
    },
    {
      "id": 4,
      "start": 5127.4,
      "end": 5132.4,
      "formatted_start": "01:25:27.400",
      "formatted_end": "01:25:32.400",
      "text": "حالا خب با من که اونجور خواه خودمون فردی کنم با یک خواه"
    },
    {
      "id": 5,
      "start": 5132.4,
      "end": 5134.9,
      "formatted_start": "01:25:32.400",
      "formatted_end": "01:25:34.900",
      "text": "که من نمیخواهم بیایم درگه چیز برن"
    },
    {
      "id": 6,
      "start": 5134.9,
      "end": 5135.7,
      "formatted_start": "01:25:34.900",
      "formatted_end": "01:25:35.700",
      "text": "میه میه برن"
    },
    {
      "id": 7,
      "start": 5135.7,
      "end": 5138.4,
      "formatted_start": "01:25:35.700",
      "formatted_end": "01:25:38.400",
      "text": "اگر هم نخواهد با نماهت میشن"
    },
    {
      "id": 8,
      "start": 5138.4,
      "end": 5140.6,
      "formatted_start": "01:25:38.400",
      "formatted_end": "01:25:40.600",
      "text": "و اینجور با خواهشتگاه بیایم بگو خواه"
    },
    {
      "id": 9,
      "start": 5140.6,
      "end": 5143.6,
      "formatted_start": "01:25:40.600",
      "formatted_end": "01:25:43.600",
      "text": "بابا جون مرسی موخانان که رو با آق نداره"
    },
    {
      "id": 10,
      "start": 5143.6,
      "end": 5144.7,
      "formatted_start": "01:25:43.600",
      "formatted_end": "01:25:44.700",
      "text": "گا دنبه نداره"
    },
    {
      "id": 11,
      "start": 5144.7,
      "end": 5145.6,
      "formatted_start": "01:25:44.700",
      "formatted_end": "01:25:45.600",
      "text": "برم هم نداره"
    },
    {
      "id": 12,
      "start": 5145.6,
      "end": 5147.0,
      "formatted_start": "01:25:45.600",
      "formatted_end": "01:25:47.000",
      "text": "روش برم نداشته باشه"
    },
    {
      "id": 13,
      "start": 5153.0,
      "end": 5183.0,
      "formatted_start": "01:25:53.000",
      "formatted_end": "01:26:23.000",
      "text": "اینجا باید برداری که اینجا باید برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا برداری که اینجا بر"
    },
    {
      "id": 14,
      "start": 5183.0,
      "end": 5189.0,
      "formatted_start": "01:26:23.000",
      "formatted_end": "01:26:29.000",
      "text": "و در طریق سوال می گوید خواب خیلی برای حالی همان از باشیش که کار کنی"
    },
    {
      "id": 15,
      "start": 5189.0,
      "end": 5193.0,
      "formatted_start": "01:26:29.000",
      "formatted_end": "01:26:33.000",
      "text": "مطلوب خانه خانه جدی شروع همه جدی بده، مو خورده"
    },
    {
      "id": 16,
      "start": 5195.0,
      "end": 5201.0,
      "formatted_start": "01:26:35.000",
      "formatted_end": "01:26:41.000",
      "text": "من از دوره اولون برم برم وزیر دیگه و می گویم مطلوب خانه خانه جدی شروع همه جدی بده"
    },
    {
      "id": 17,
      "start": 5201.0,
      "end": 5203.0,
      "formatted_start": "01:26:41.000",
      "formatted_end": "01:26:43.000",
      "text": "من شروع مو خورده همه جدی"
    },
    {
      "id": 18,
      "start": 5204.0,
      "end": 5207.0,
      "formatted_start": "01:26:44.000",
      "formatted_end": "01:26:47.000",
      "text": "من در این وقتی تو میگیم مطلوب خانه خانه بشینه بگیرم"
    },
    {
      "id": 19,
      "start": 5207.0,
      "end": 5237.0,
      "formatted_start": "01:26:47.000",
      "formatted_end": "01:27:17.000",
      "text": "باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیراتا باید بشینم بگیرات"
    },
    {
      "id": 20,
      "start": 5237.0,
      "end": 5246.0,
      "formatted_start": "01:27:17.000",
      "formatted_end": "01:27:26.000",
      "text": "با شانس که شانس که نداری و همونی بهتر بوده برده خرید کنه که همین کار کار را کنه که نداری"
    },
    {
      "id": 21,
      "start": 5246.0,
      "end": 5276.0,
      "formatted_start": "01:27:26.000",
      "formatted_end": "01:27:56.000",
      "text": "از اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا ب"
    },
    {
      "id": 22,
      "start": 5276.0,
      "end": 5281.4,
      "formatted_start": "01:27:56.000",
      "formatted_end": "01:28:01.400",
      "text": "و گفتم که نادیده ها تبدیل کار برن و اینجا بگیرن من خریدن"
    },
    {
      "id": 23,
      "start": 5281.4,
      "end": 5297.9,
      "formatted_start": "01:28:01.400",
      "formatted_end": "01:28:17.900",
      "text": "من در اینکه بیان کشی که بار کردم خواهش من رو کار کردن و بیان رو کار کردن"
    },
    {
      "id": 24,
      "start": 5297.9,
      "end": 5298.9,
      "formatted_start": "01:28:17.900",
      "formatted_end": "01:28:18.900",
      "text": "بگویم"
    },
    {
      "id": 25,
      "start": 5300.9,
      "end": 5302.9,
      "formatted_start": "01:28:20.900",
      "formatted_end": "01:28:22.900",
      "text": "الان خیلی نشده هست"
    },
    {
      "id": 26,
      "start": 5302.9,
      "end": 5330.9,
      "formatted_start": "01:28:22.900",
      "formatted_end": "01:28:50.900",
      "text": "موسیقی"
    },
    {
      "id": 27,
      "start": 5332.9,
      "end": 5340.9,
      "formatted_start": "01:28:52.900",
      "formatted_end": "01:29:00.900",
      "text": "میگه طرف نبودن شهید نفرود، کارشنجر نفرودن، افراد باشون، برکترون باشون"
    },
    {
      "id": 28,
      "start": 5340.9,
      "end": 5353.9,
      "formatted_start": "01:29:00.900",
      "formatted_end": "01:29:13.900",
      "text": "نفر بخواهد نکنید، ببین چند هم بازم پیش آورم میاد که این کار رو کنید، میدونید نه نه، دیگه ببونید بخواهد نکنید"
    },
    {
      "id": 29,
      "start": 5353.9,
      "end": 5358.9,
      "formatted_start": "01:29:13.900",
      "formatted_end": "01:29:18.900",
      "text": "اوه، خیلی خوب."
    },
    {
      "id": 30,
      "start": 5358.9,
      "end": 5369.46,
      "formatted_start": "01:29:18.900",
      "formatted_end": "01:29:29.460",
      "text": "تا شما دیگه همون دیگه اصلا دیگه اون بابا عرب ها میکنند و با اینکه این کار در چیز هستش اشکرین یا فرده"
    },
    {
      "id": 31,
      "start": 5369.46,
      "end": 5388.88,
      "formatted_start": "01:29:29.460",
      "formatted_end": "01:29:48.880",
      "text": "دیگه از هم اصلا در جلو فرده ها میشه و میتونی که اینکه برس جنب و جلابی سختی هستش و همون دیگه اجایی با بابا همین خودتون سختی هستش و بابا همین خودتون سختی هستش"
    },
    {
      "id": 32,
      "start": 5388.88,
