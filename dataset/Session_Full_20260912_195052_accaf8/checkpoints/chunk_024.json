      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 1,
      "start": 7230.0,
      "end": 7232.0,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:32.000",
      "text": "اوه، یک خوبه موشکه"
    },
    {
      "id": 2,
      "start": 7232.0,
      "end": 7234.0,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:34.000",
      "text": "بله، خوبه"
    },
    {
      "id": 3,
      "start": 7234.0,
      "end": 7236.0,
      "formatted_start": "02:00:34.000",
      "formatted_end": "02:00:36.000",
      "text": "چیزی از آن بیدارم اشکال می کنیم"
    },
    {
      "id": 4,
      "start": 7238.0,
      "end": 7240.0,
      "formatted_start": "02:00:38.000",
      "formatted_end": "02:00:40.000",
      "text": "بله"
    },
    {
      "id": 5,
      "start": 7240.0,
      "end": 7242.0,
      "formatted_start": "02:00:40.000",
      "formatted_end": "02:00:42.000",
      "text": "مچه ها گردند"
    },
    {
      "id": 6,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "بهترون"
    },
    {
      "id": 7,
      "start": 7244.0,
      "end": 7246.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:46.000",
      "text": "بله"
    },
    {
      "id": 8,
      "start": 7248.0,
      "end": 7250.0,
      "formatted_start": "02:00:48.000",
      "formatted_end": "02:00:50.000",
      "text": "ساپنده نیست"
    },
    {
      "id": 9,
      "start": 7250.0,
      "end": 7252.0,
      "formatted_start": "02:00:50.000",
      "formatted_end": "02:00:52.000",
      "text": "پرسنده"
    },
    {
      "id": 10,
      "start": 7252.0,
      "end": 7254.0,
      "formatted_start": "02:00:52.000",
      "formatted_end": "02:00:54.000",
      "text": "بله"
    },
    {
      "id": 11,
      "start": 7254.0,
      "end": 7256.0,
      "formatted_start": "02:00:54.000",
      "formatted_end": "02:00:56.000",
      "text": "ساپنده نیست"
    },
    {
      "id": 12,
      "start": 7256.0,
      "end": 7280.0,
      "formatted_start": "02:00:56.000",
      "formatted_end": "02:01:20.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 7280.0,
      "end": 7283.0,
      "formatted_start": "02:01:20.000",
      "formatted_end": "02:01:23.000",
      "text": "خواستم این دیروز پلیز 11 ایک نبود؟"
    },
    {
      "id": 14,
      "start": 7283.0,
      "end": 7287.0,
      "formatted_start": "02:01:23.000",
      "formatted_end": "02:01:27.000",
      "text": "دیروز پلیز 11 ایک هست"
    },
    {
      "id": 15,
      "start": 7287.0,
      "end": 7291.0,
      "formatted_start": "02:01:27.000",
      "formatted_end": "02:01:31.000",
      "text": "و دیروز روز 11 هست"
    },
    {
      "id": 16,
      "start": 7291.0,
      "end": 7293.0,
      "formatted_start": "02:01:31.000",
      "formatted_end": "02:01:33.000",
      "text": "و این روز برنگ شده"
    },
    {
      "id": 17,
      "start": 7293.0,
      "end": 7296.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:36.000",
      "text": "این روز روز 11 هست"
    },
    {
      "id": 18,
      "start": 7296.0,
      "end": 7299.0,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:39.000",
      "text": "برای اینکه نمی آمد"
    },
    {
      "id": 19,
      "start": 7299.0,
      "end": 7301.0,
      "formatted_start": "02:01:39.000",
      "formatted_end": "02:01:41.000",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 7303.0,
      "end": 7305.0,
      "formatted_start": "02:01:43.000",
      "formatted_end": "02:01:45.000",
      "text": "این نسلی چورمه هست که میگم آقا"
    },
    {
      "id": 21,
      "start": 7305.0,
      "end": 7307.0,
      "formatted_start": "02:01:45.000",
      "formatted_end": "02:01:47.000",
      "text": "من الان بر میگردم"
    },
    {
      "id": 22,
      "start": 7307.0,
      "end": 7313.0,
      "formatted_start": "02:01:47.000",
      "formatted_end": "02:01:53.000",
      "text": "اون زیر صاحبان میذاره پول پیشتر میگرده یه مریخ یه باشیون گرده باشه"
    },
    {
      "id": 23,
      "start": 7313.0,
      "end": 7315.0,
      "formatted_start": "02:01:53.000",
      "formatted_end": "02:01:55.000",
      "text": "به من میگه باید اون برد باتم نما"
    },
    {
      "id": 24,
      "start": 7315.0,
      "end": 7320.0,
      "formatted_start": "02:01:55.000",
      "formatted_end": "02:02:00.000",
      "text": "اینجا قطرناکه همچنین که یه لحظه حواسم نبود ماشین رو برد"
    },
    {
      "id": 25,
      "start": 7320.0,
      "end": 7322.0,
      "formatted_start": "02:02:00.000",
      "formatted_end": "02:02:02.000",
      "text": "آدم های مختلف میاد آدم های"
    },
    {
      "id": 26,
      "start": 7322.0,
      "end": 7323.0,
      "formatted_start": "02:02:02.000",
      "formatted_end": "02:02:03.000",
      "text": "تو بودش"
    },
    {
      "id": 27,
      "start": 7323.0,
      "end": 7326.0,
      "formatted_start": "02:02:03.000",
      "formatted_end": "02:02:06.000",
      "text": "تو بودم تو اختلاف میذارم بودم اونجا نمیذارم"
    },
    {
      "id": 28,
      "start": 7326.0,
      "end": 7327.0,
      "formatted_start": "02:02:06.000",
      "formatted_end": "02:02:07.000",
      "text": "آره بیارم"
    },
    {
      "id": 29,
      "start": 7327.0,
      "end": 7328.0,
      "formatted_start": "02:02:07.000",
      "formatted_end": "02:02:08.000",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 7328.0,
      "end": 7329.0,
      "formatted_start": "02:02:08.000",
      "formatted_end": "02:02:09.000",
      "text": "بابد"
    },
    {
      "id": 31,
      "start": 7329.0,
      "end": 7335.0,
      "formatted_start": "02:02:09.000",
      "formatted_end": "02:02:15.000",
      "text": "محصول تزیر نیست که طرف فقط پول میگرده"
    },
    {
      "id": 32,
      "start": 7335.0,
      "end": 7365.0,
      "formatted_start": "02:02:15.000",
      "formatted_end": "02:02:45.000",
      "text": "از آن باید بردارید که از این مردم هایی که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که با"
    },
    {
      "id": 33,
      "start": 7365.0,
      "end": 7367.3,
      "formatted_start": "02:02:45.000",
      "formatted_end": "02:02:47.300",
      "text": "اینجا پرک فزشکان"
    },
    {
      "id": 34,
      "start": 7367.3,
      "end": 7369.88,
      "formatted_start": "02:02:47.300",
      "formatted_end": "02:02:49.880",
      "text": "خب طرف نیمی بینه دیگه میره دیگه"
    },
    {
      "id": 35,
      "start": 7369.88,
      "end": 7371.76,
      "formatted_start": "02:02:49.880",
      "formatted_end": "02:02:51.760",
      "text": "تو هم نگاه نمی کنی که اتاقیتی"
    },
    {
      "id": 36,
      "start": 7371.76,
      "end": 7373.0,
      "formatted_start": "02:02:51.760",
      "formatted_end": "02:02:53.000",
      "text": "خب؟"
    },
    {
      "id": 37,
      "start": 7374.26,
      "end": 7377.52,
      "formatted_start": "02:02:54.260",
      "formatted_end": "02:02:57.520",
      "text": "بعد تو در یه عظمه اینجا ماهانه میگیری برای اون مکان"
    },
    {
      "id": 38,
      "start": 7377.52,
      "end": 7379.72,
      "formatted_start": "02:02:57.520",
      "formatted_end": "02:02:59.720",
      "text": "ما اون مکان رو ماهانه اجاره کردیم از تو"
    },
    {
      "id": 39,
      "start": 7395.0,
      "end": 7409.0,
      "formatted_start": "02:03:15.000",
      "formatted_end": "02:03:29.000",
      "text": "موسیقی"
    },
    {
      "id": 40,
      "start": 7409.0,
      "end": 7411.0,
      "formatted_start": "02:03:29.000",
      "formatted_end": "02:03:31.000",
      "text": "خواهید کشکتی هم داریم؟"
    },
    {
      "id": 41,
      "start": 7411.0,
      "end": 7412.0,
      "formatted_start": "02:03:31.000",
      "formatted_end": "02:03:32.000",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 7412.0,
      "end": 7413.0,
      "formatted_start": "02:03:32.000",
      "formatted_end": "02:03:33.000",
      "text": "بعد از آن چی؟"
    },
    {
      "id": 43,
      "start": 7413.0,
      "end": 7415.0,
      "formatted_start": "02:03:33.000",
      "formatted_end": "02:03:35.000",
