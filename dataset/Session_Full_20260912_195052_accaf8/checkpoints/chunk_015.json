  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4509.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:09.000",
      "text": "نه، خوستم میشه با علی بهش، این همسایی رفتیم، میشه با همین که رفتیم، که برقرارش، شرکتش بوده."
    },
    {
      "id": 1,
      "start": 4509.0,
      "end": 4515.0,
      "formatted_start": "01:15:09.000",
      "formatted_end": "01:15:15.000",
      "text": "آقا من رو آشما قفتم، ای علی بده که کمار نرده، دیگر داشتون همینجوری، من دوندرم،"
    },
    {
      "id": 2,
      "start": 4515.0,
      "end": 4522.0,
      "formatted_start": "01:15:15.000",
      "formatted_end": "01:15:22.000",
      "text": "آقا شاید خوبی دینم، چار دنبالی دورو برخواهد بازم، از اینکه خواهد بزاریم، خوستم نداره که برای شاوردنبیری رو تردید،"
    },
    {
      "id": 3,
      "start": 4522.0,
      "end": 4526.0,
      "formatted_start": "01:15:22.000",
      "formatted_end": "01:15:26.000",
      "text": "و بعد باب گستونی میگه، بده از این موضوع موسم ها، این چیه؟"
    },
    {
      "id": 4,
      "start": 4526.0,
      "end": 4530.0,
      "formatted_start": "01:15:26.000",
      "formatted_end": "01:15:30.000",
      "text": "خواهند افتنانیش خوب میدهد، من اینکه موضوعی را اصلا کنم،"
    },
    {
      "id": 5,
      "start": 4530.0,
      "end": 4560.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:16:00.000",
      "text": "در اینجا باید برداری کنید که اینجا باید برداری کنید که اینجا باید برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید ک"
    },
    {
      "id": 6,
      "start": 4560.0,
      "end": 4564.0,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:04.000",
      "text": "از آنها را باید بگیرم و باید بگیرم به اینکه رفتی اشنا شنند."
    },
    {
      "id": 7,
      "start": 4564.0,
      "end": 4566.0,
      "formatted_start": "01:16:04.000",
      "formatted_end": "01:16:06.000",
      "text": "بگیرم به اینکه اون روز بگیرم و باید بگیرم به اینکه اون روز بگیرم."
    },
    {
      "id": 8,
      "start": 4566.0,
      "end": 4596.0,
      "formatted_start": "01:16:06.000",
      "formatted_end": "01:16:36.000",
      "text": "گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می‌بینید گاز نیست، می"
    },
    {
      "id": 9,
      "start": 4596.0,
      "end": 4607.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:47.000",
      "text": "اتفاق برا خونه یا خون شما بیاده دیگه دارگاز بیش، بیه، بیش، خسارت تعمیز مداره دهش و خون آقا را بگیرند."
    },
    {
      "id": 10,
      "start": 4607.0,
      "end": 4635.0,
      "formatted_start": "01:16:47.000",
      "formatted_end": "01:17:15.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 4635.0,
      "end": 4665.0,
      "formatted_start": "01:17:15.000",
      "formatted_end": "01:17:45.000",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 12,
      "start": 4665.0,
      "end": 4667.34,
      "formatted_start": "01:17:45.000",
      "formatted_end": "01:17:47.340",
      "text": "من رو مستقیم زده و برنامه مقایه شده"
    },
    {
      "id": 13,
      "start": 4667.34,
      "end": 4671.24,
      "formatted_start": "01:17:47.340",
      "formatted_end": "01:17:51.240",
      "text": "و اون آمدی کانه آشنگیت رو بگیرد"
    },
    {
      "id": 14,
      "start": 4671.24,
      "end": 4672.24,
      "formatted_start": "01:17:51.240",
      "formatted_end": "01:17:52.240",
      "text": "و اون آمدی کانه آشنگیت رو بگیرد"
    },
    {
      "id": 15,
      "start": 4672.24,
      "end": 4674.24,
      "formatted_start": "01:17:52.240",
      "formatted_end": "01:17:54.240",
      "text": "آقا من فاطم نیم، آمدی کانه آمدی کانه"
    },
    {
      "id": 16,
      "start": 4674.24,
      "end": 4676.24,
      "formatted_start": "01:17:54.240",
      "formatted_end": "01:17:56.240",
      "text": "خاطر من موچه ها شادی زده من"
    },
    {
      "id": 17,
      "start": 4676.24,
      "end": 4678.24,
      "formatted_start": "01:17:56.240",
      "formatted_end": "01:17:58.240",
      "text": "خاطر من شادی زده من"
    },
    {
      "id": 18,
      "start": 4678.24,
      "end": 4680.24,
      "formatted_start": "01:17:58.240",
      "formatted_end": "01:18:00.240",
      "text": "چی شده؟ خاطر من فاطم نیم"
    },
    {
      "id": 19,
      "start": 4680.24,
      "end": 4682.24,
      "formatted_start": "01:18:00.240",
      "formatted_end": "01:18:02.240",
      "text": "بگیردن توتون ناراحتی بودن"
    },
    {
      "id": 20,
      "start": 4682.24,
      "end": 4712.24,
      "formatted_start": "01:18:02.240",
      "formatted_end": "01:18:32.240",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداری"
    },
    {
      "id": 21,
      "start": 4712.24,
      "end": 4715.24,
      "formatted_start": "01:18:32.240",
      "formatted_end": "01:18:35.240",
      "text": "از سه روش هستن اینه دیگه دو خواب آب آب ای کنه"
    },
    {
      "id": 22,
      "start": 4715.24,
      "end": 4717.24,
      "formatted_start": "01:18:35.240",
      "formatted_end": "01:18:37.240",
      "text": "درمشونی هسته دیگه"
    },
    {
      "id": 23,
      "start": 4717.24,
      "end": 4719.24,
      "formatted_start": "01:18:37.240",
      "formatted_end": "01:18:39.240",
      "text": "اون راست بیدید"
    },
    {
      "id": 24,
      "start": 4719.24,
      "end": 4721.24,
      "formatted_start": "01:18:39.240",
      "formatted_end": "01:18:41.240",
      "text": "این همه بستن هم بره بینید"
    },
    {
      "id": 25,
      "start": 4721.24,
      "end": 4725.24,
      "formatted_start": "01:18:41.240",
      "formatted_end": "01:18:45.240",
      "text": "اون رو با آخر سنده اون خود رو بشید و با دو دو بیدید"
    },
    {
      "id": 26,
      "start": 4727.24,
      "end": 4729.24,
      "formatted_start": "01:18:47.240",
      "formatted_end": "01:18:49.240",
      "text": "خدا از بسیاری بیدید"
    },
    {
      "id": 27,
      "start": 4729.24,
      "end": 4731.24,
      "formatted_start": "01:18:49.240",
      "formatted_end": "01:18:51.240",
      "text": "ایروز یک زن نخسته"
    },
    {
      "id": 28,
      "start": 4731.24,
      "end": 4733.24,
      "formatted_start": "01:18:51.240",
      "formatted_end": "01:18:53.240",
      "text": "با این همه رو بیشتر با میرونید"
    },
    {
      "id": 29,
      "start": 4733.24,
      "end": 4736.24,
      "formatted_start": "01:18:53.240",
      "formatted_end": "01:18:56.240",
      "text": "خب من که این بار مشکل میده"
    },
    {
      "id": 30,
      "start": 4736.24,
      "end": 4739.24,
      "formatted_start": "01:18:56.240",
      "formatted_end": "01:18:59.240",
      "text": "آفره کنم بیرونیم"
    },
    {
      "id": 31,
      "start": 4739.24,
      "end": 4741.24,
      "formatted_start": "01:18:59.240",
      "formatted_end": "01:19:01.240",
      "text": "اینجا همینجوری هم بود."
    },
    {
      "id": 32,
      "start": 4741.24,
      "end": 4743.24,
      "formatted_start": "01:19:01.240",
      "formatted_end": "01:19:03.240",
      "text": "اینجوری هم بود."
    },
    {
      "id": 33,
      "start": 4743.24,
      "end": 4745.24,
      "formatted_start": "01:19:03.240",
      "formatted_end": "01:19:05.240",
      "text": "اینجوری هم بود."
    },
    {
      "id": 34,
      "start": 4745.24,
      "end": 4747.24,
      "formatted_start": "01:19:05.240",
      "formatted_end": "01:19:07.240",
      "text": "اینجوری هم بود."
    },
    {
      "id": 35,
      "start": 4747.24,
      "end": 4749.24,
      "formatted_start": "01:19:07.240",
      "formatted_end": "01:19:09.240",
