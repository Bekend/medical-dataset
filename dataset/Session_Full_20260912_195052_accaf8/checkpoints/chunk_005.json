  "stt_segments": [
    {
      "id": 0,
      "start": 1500.0,
      "end": 1502.0,
      "formatted_start": "00:25:00.000",
      "formatted_end": "00:25:02.000",
      "text": "با حال شما بود."
    },
    {
      "id": 1,
      "start": 1502.0,
      "end": 1504.0,
      "formatted_start": "00:25:02.000",
      "formatted_end": "00:25:04.000",
      "text": "چی شده دختر بلا؟ بفرم شو."
    },
    {
      "id": 2,
      "start": 1504.0,
      "end": 1508.0,
      "formatted_start": "00:25:04.000",
      "formatted_end": "00:25:08.000",
      "text": "دخترم، انا دوست دارم دیگه."
    },
    {
      "id": 3,
      "start": 1508.0,
      "end": 1510.0,
      "formatted_start": "00:25:08.000",
      "formatted_end": "00:25:10.000",
      "text": "مش دارم میریزه."
    },
    {
      "id": 4,
      "start": 1510.0,
      "end": 1512.0,
      "formatted_start": "00:25:10.000",
      "formatted_end": "00:25:12.000",
      "text": "میریزه شده، دیگه؟"
    },
    {
      "id": 5,
      "start": 1512.0,
      "end": 1517.0,
      "formatted_start": "00:25:12.000",
      "formatted_end": "00:25:17.000",
      "text": "از پاسدارم، این پاش رنگ پوستش یکم چیز شده بود."
    },
    {
      "id": 6,
      "start": 1517.0,
      "end": 1519.0,
      "formatted_start": "00:25:17.000",
      "formatted_end": "00:25:19.000",
      "text": "بعد بردم شما."
    },
    {
      "id": 7,
      "start": 1519.0,
      "end": 1521.0,
      "formatted_start": "00:25:19.000",
      "formatted_end": "00:25:21.000",
      "text": "رنگ پوستی تیره شده بود؟"
    },
    {
      "id": 8,
      "start": 1521.0,
      "end": 1522.0,
      "formatted_start": "00:25:21.000",
      "formatted_end": "00:25:22.000",
      "text": "نه، نه است."
    },
    {
      "id": 9,
      "start": 1522.0,
      "end": 1524.0,
      "formatted_start": "00:25:22.000",
      "formatted_end": "00:25:24.000",
      "text": "ببینم سیفید شده."
    },
    {
      "id": 10,
      "start": 1524.0,
      "end": 1526.0,
      "formatted_start": "00:25:24.000",
      "formatted_end": "00:25:26.000",
      "text": "نه، بیرون شو."
    },
    {
      "id": 11,
      "start": 1526.0,
      "end": 1528.0,
      "formatted_start": "00:25:26.000",
      "formatted_end": "00:25:28.000",
      "text": "باید کامش سرمی کنیم."
    },
    {
      "id": 12,
      "start": 1528.0,
      "end": 1531.24,
      "formatted_start": "00:25:28.000",
      "formatted_end": "00:25:31.240",
      "text": "درستشون باشه؟ دست می کشید، مو میاد"
    },
    {
      "id": 13,
      "start": 1531.24,
      "end": 1534.76,
      "formatted_start": "00:25:31.240",
      "formatted_end": "00:25:34.760",
      "text": "همون کمی روی می کنید، یا یک تا یک تا می شهر شده"
    },
    {
      "id": 14,
      "start": 1534.76,
      "end": 1538.42,
      "formatted_start": "00:25:34.760",
      "formatted_end": "00:25:38.420",
      "text": "کجا شد؟"
    },
    {
      "id": 15,
      "start": 1538.42,
      "end": 1541.36,
      "formatted_start": "00:25:38.420",
      "formatted_end": "00:25:41.360",
      "text": "این قسمت بره؟"
    },
    {
      "id": 16,
      "start": 1541.36,
      "end": 1544.02,
      "formatted_start": "00:25:41.360",
      "formatted_end": "00:25:44.020",
      "text": "این قسمت بره، این قسمت سره تر شده"
    },
    {
      "id": 17,
      "start": 1544.02,
      "end": 1544.98,
      "formatted_start": "00:25:44.020",
      "formatted_end": "00:25:44.980",
      "text": "همین ها باری"
    },
    {
      "id": 18,
      "start": 1544.98,
      "end": 1546.9,
      "formatted_start": "00:25:44.980",
      "formatted_end": "00:25:46.900",
      "text": "از یاد ترم می شه؟"
    },
    {
      "id": 19,
      "start": 1546.9,
      "end": 1547.66,
      "formatted_start": "00:25:46.900",
      "formatted_end": "00:25:47.660",
      "text": "نه، از پرسورت"
    },
    {
      "id": 20,
      "start": 1547.66,
      "end": 1550.1,
      "formatted_start": "00:25:47.660",
      "formatted_end": "00:25:50.100",
      "text": "جای دیگر هست که سفید شده باشه؟"
    },
    {
      "id": 21,
      "start": 1550.1,
      "end": 1550.32,
      "formatted_start": "00:25:50.100",
      "formatted_end": "00:25:50.320",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 1550.32,
      "end": 1552.52,
      "formatted_start": "00:25:50.320",
      "formatted_end": "00:25:52.520",
      "text": "نه، لباشه"
    },
    {
      "id": 23,
      "start": 1552.52,
      "end": 1554.62,
      "formatted_start": "00:25:52.520",
      "formatted_end": "00:25:54.620",
      "text": "لباشه، خوش می شه، ترک بره؟"
    },
    {
      "id": 24,
      "start": 1554.62,
      "end": 1557.4,
      "formatted_start": "00:25:54.620",
      "formatted_end": "00:25:57.400",
      "text": "صبح که بیدار می شه، کنان مثلا یکم سفیده"
    },
    {
      "id": 25,
      "start": 1557.4,
      "end": 1559.4,
      "formatted_start": "00:25:57.400",
      "formatted_end": "00:25:59.400",
      "text": "خوشکه"
    },
    {
      "id": 26,
      "start": 1559.4,
      "end": 1561.4,
      "formatted_start": "00:25:59.400",
      "formatted_end": "00:26:01.400",
      "text": "خوشکه"
    },
    {
      "id": 27,
      "start": 1561.4,
      "end": 1563.4,
      "formatted_start": "00:26:01.400",
      "formatted_end": "00:26:03.400",
      "text": "و دیگه اون روی مزه هایی که میخوره"
    },
    {
      "id": 28,
      "start": 1563.4,
      "end": 1565.4,
      "formatted_start": "00:26:03.400",
      "formatted_end": "00:26:05.400",
      "text": "به جنوب که میاد"
    },
    {
      "id": 29,
      "start": 1565.4,
      "end": 1567.4,
      "formatted_start": "00:26:05.400",
      "formatted_end": "00:26:07.400",
      "text": "به این ترمیزه"
    },
    {
      "id": 30,
      "start": 1567.4,
      "end": 1569.4,
      "formatted_start": "00:26:07.400",
      "formatted_end": "00:26:09.400",
      "text": "باید بسیاریش درمید من موهاشو ببینم"
    },
    {
      "id": 31,
      "start": 1569.4,
      "end": 1571.4,
      "formatted_start": "00:26:09.400",
      "formatted_end": "00:26:11.400",
      "text": "شاید اینجاست که"
    },
    {
      "id": 32,
      "start": 1571.4,
      "end": 1573.4,
      "formatted_start": "00:26:11.400",
      "formatted_end": "00:26:13.400",
      "text": "این تلشین ها رو باز کنم"
    },
    {
      "id": 33,
      "start": 1573.4,
      "end": 1575.4,
      "formatted_start": "00:26:13.400",
      "formatted_end": "00:26:15.400",
      "text": "دست بکشم"
    },
    {
      "id": 34,
      "start": 1575.4,
      "end": 1577.4,
      "formatted_start": "00:26:15.400",
      "formatted_end": "00:26:17.400",
      "text": "باید بازم خود درده بیدم"
    },
    {
      "id": 35,
      "start": 1577.4,
      "end": 1579.4,
      "formatted_start": "00:26:17.400",
      "formatted_end": "00:26:19.400",
      "text": "خود موهاش بود"
    },
    {
      "id": 36,
      "start": 1579.4,
      "end": 1581.4,
      "formatted_start": "00:26:19.400",
      "formatted_end": "00:26:21.400",
      "text": "خوش بودم هم"
    },
    {
      "id": 37,
      "start": 1581.4,
      "end": 1583.4,
      "formatted_start": "00:26:21.400",
      "formatted_end": "00:26:23.400",
      "text": "دیگه این ریزش باشه"
    },
    {
      "id": 38,
      "start": 1583.4,
      "end": 1585.4,
      "formatted_start": "00:26:23.400",
      "formatted_end": "00:26:25.400",
      "text": "وقتی من میکشم"
    },
    {
      "id": 39,
      "start": 1585.4,
      "end": 1587.4,
      "formatted_start": "00:26:25.400",
      "formatted_end": "00:26:27.400",
      "text": "اینو باید دستم خوره باشم"
    },
    {
      "id": 40,
      "start": 1587.4,
      "end": 1589.4,
      "formatted_start": "00:26:27.400",
      "formatted_end": "00:26:29.400",
      "text": "دستم شامه کرده؟"
    },
    {
      "id": 41,
      "start": 1589.4,
      "end": 1591.4,
      "formatted_start": "00:26:29.400",
      "formatted_end": "00:26:31.400",
      "text": "آره"
    },
    {
      "id": 42,
      "start": 1591.4,
      "end": 1593.4,
      "formatted_start": "00:26:31.400",
      "formatted_end": "00:26:33.400",
      "text": "روزی ست و بیست دا مو ریزش طبیعه"
    },
    {
      "id": 43,
      "start": 1593.4,
      "end": 1595.4,
      "formatted_start": "00:26:33.400",
      "formatted_end": "00:26:35.400",
      "text": "ولی این کار میاد خالی تر شده"
    },
    {
      "id": 44,
      "start": 1595.4,
      "end": 1597.4,
      "formatted_start": "00:26:35.400",
      "formatted_end": "00:26:37.400",
      "text": "مثلا این حالت"
    },
    {
      "id": 45,
      "start": 1597.4,
      "end": 1599.4,
      "formatted_start": "00:26:37.400",
      "formatted_end": "00:26:39.400",
      "text": "چرا؟ اما حجمش سیاد"
    },
    {
      "id": 46,
      "start": 1599.4,
      "end": 1601.4,
      "formatted_start": "00:26:39.400",
      "formatted_end": "00:26:41.400",
      "text": "آره"
    },
    {
      "id": 47,
      "start": 1601.4,
      "end": 1603.4,
      "formatted_start": "00:26:41.400",
      "formatted_end": "00:26:43.400",
      "text": "ممکنه اینا بره"
    },
    {
      "id": 48,
      "start": 1603.4,
      "end": 1605.4,
      "formatted_start": "00:26:43.400",
      "formatted_end": "00:26:45.400",
      "text": "یه شروط زنگینا براش میدیسن"
    },
    {
      "id": 49,
      "start": 1605.4,
      "end": 1607.4,
      "formatted_start": "00:26:45.400",
      "formatted_end": "00:26:47.400",
      "text": "ضربتی بیشتر"
    },
    {
      "id": 50,
      "start": 1607.4,
      "end": 1609.4,
      "formatted_start": "00:26:47.400",
      "formatted_end": "00:26:49.400",
      "text": "آزمایش نمیدونی؟"
    },
    {
      "id": 51,
      "start": 1609.4,
      "end": 1611.4,
      "formatted_start": "00:26:49.400",
      "formatted_end": "00:26:51.400",
      "text": "آزمایش هم میتونه یک چکاپ کلی بگیره"
    },
    {
      "id": 52,
      "start": 1611.4,
      "end": 1613.4,
      "formatted_start": "00:26:51.400",
      "formatted_end": "00:26:53.400",
      "text": "خیلی؟ قصانو مخورم او دیگه؟"
    },
    {
      "id": 53,
      "start": 1613.4,
      "end": 1616.4,
      "formatted_start": "00:26:53.400",
      "formatted_end": "00:26:56.400",
      "text": "اول یه آزمایش چکاب"
    },
    {
      "id": 54,
      "start": 1616.4,
      "end": 1618.4,
      "formatted_start": "00:26:56.400",
      "formatted_end": "00:26:58.400",
      "text": "من پسایی آقای دکتور"
    },
    {
      "id": 55,
      "start": 1618.4,
      "end": 1621.4,
      "formatted_start": "00:26:58.400",
      "formatted_end": "00:27:01.400",
      "text": "آقای خانم سوسرایی من یه چکاب کامل براش میبینم"
    },
    {
      "id": 56,
      "start": 1621.4,
      "end": 1623.4,
      "formatted_start": "00:27:01.400",
      "formatted_end": "00:27:03.400",
      "text": "من آزمایش هم نداده واقعا"
    },
    {
      "id": 57,
      "start": 1623.4,
      "end": 1625.4,
      "formatted_start": "00:27:03.400",
      "formatted_end": "00:27:05.400",
      "text": "اشکال نداره خیلی هم خوبه"
    },
    {
      "id": 58,
      "start": 1625.4,
      "end": 1629.4,
      "formatted_start": "00:27:05.400",
      "formatted_end": "00:27:09.400",
      "text": "ویتامین دیش و آهنش و تستایی کبدیب"
    },
    {
      "id": 59,
      "start": 1629.4,
      "end": 1632.4,
      "formatted_start": "00:27:09.400",
      "formatted_end": "00:27:12.400",
      "text": "تیرویدش و خوب"
    },
    {
      "id": 60,
      "start": 1632.4,
      "end": 1634.4,
      "formatted_start": "00:27:12.400",
      "formatted_end": "00:27:14.400",
      "text": "یه چکاب کنید"
    },
    {
      "id": 61,
      "start": 1634.4,
      "end": 1637.4,
      "formatted_start": "00:27:14.400",
      "formatted_end": "00:27:17.400",
      "text": "و دلان این چیز پوستش"
    },
    {
      "id": 62,
      "start": 1637.4,
      "end": 1639.4,
      "formatted_start": "00:27:17.400",
      "formatted_end": "00:27:19.400",
      "text": "پوستش این انده داری"
    },
    {
      "id": 63,
      "start": 1639.4,
      "end": 1643.4,
      "formatted_start": "00:27:19.400",
      "formatted_end": "00:27:23.400",
      "text": "اینجوری نیست که بیماری ایستیبی نیست"
    },
    {
      "id": 64,
      "start": 1643.4,
      "end": 1645.4,
      "formatted_start": "00:27:23.400",
      "formatted_end": "00:27:25.400",
      "text": "نه اون سفیده که بیتو لبو نیست"
    },
    {
      "id": 65,
      "start": 1645.4,
      "end": 1649.4,
      "formatted_start": "00:27:25.400",
      "formatted_end": "00:27:29.400",
      "text": "نه اون مگاشه زیاد میشه"
    },
    {
      "id": 66,
      "start": 1649.4,
      "end": 1651.4,
      "formatted_start": "00:27:29.400",
      "formatted_end": "00:27:31.400",
      "text": "داره که بشنن کنه"
    },
    {
      "id": 67,
      "start": 1651.4,
      "end": 1653.4,
      "formatted_start": "00:27:31.400",
      "formatted_end": "00:27:33.400",
      "text": "در این حدود یعنی یک کم نگاه کنید"
    },
    {
      "id": 68,
      "start": 1653.4,
      "end": 1657.4,
      "formatted_start": "00:27:33.400",
      "formatted_end": "00:27:37.400",
      "text": "آیا دکتر ولی خب مثلا اینجوری نیست"
    },
    {
      "id": 69,
      "start": 1657.4,
      "end": 1659.4,
      "formatted_start": "00:27:37.400",
      "formatted_end": "00:27:39.400",
      "text": "اینجوری نیست که اون در حال"
    },
    {
      "id": 70,
      "start": 1659.4,
      "end": 1661.4,
      "formatted_start": "00:27:39.400",
      "formatted_end": "00:27:41.400",
      "text": "مثلا میگی که منم در مال همین"
    },
    {
      "id": 71,
      "start": 1661.4,
      "end": 1663.4,
      "formatted_start": "00:27:41.400",
      "formatted_end": "00:27:43.400",
      "text": "کمبوده و بیتامون هیچی ستره"
    },
    {
      "id": 72,
      "start": 1663.4,
      "end": 1665.4,
      "formatted_start": "00:27:43.400",
      "formatted_end": "00:27:45.400",
      "text": "بس اون هست اگزما هستن"
    },
    {
      "id": 73,
      "start": 1665.4,
      "end": 1667.4,
      "formatted_start": "00:27:45.400",
      "formatted_end": "00:27:47.400",
      "text": "اگزما که زیاد دارن"
    },
    {
      "id": 74,
      "start": 1667.4,
      "end": 1671.4,
      "formatted_start": "00:27:47.400",
      "formatted_end": "00:27:51.400",
      "text": "این لکای سفید برای تو هست اگزما"
    },
    {
      "id": 75,
      "start": 1671.4,
      "end": 1673.4,
      "formatted_start": "00:27:51.400",
      "formatted_end": "00:27:53.400",
      "text": "پوست هایی که تیره هست"
    },
    {
      "id": 76,
      "start": 1673.4,
      "end": 1675.4,
      "formatted_start": "00:27:53.400",
      "formatted_end": "00:27:55.400",
      "text": "مثلا سفید پوست نیست"
    },
    {
      "id": 77,
      "start": 1675.4,
      "end": 1678.4,
      "formatted_start": "00:27:55.400",
      "formatted_end": "00:27:58.400",
      "text": "تیره اون پوست اگزما ممورن دارن"
    },
    {
      "id": 78,
      "start": 1678.4,
      "end": 1681.4,
      "formatted_start": "00:27:58.400",
      "formatted_end": "00:28:01.400",
      "text": "مثلا لکای سفید مال بچه هایی دید"
    },
    {
      "id": 79,
      "start": 1681.4,
      "end": 1683.4,
      "formatted_start": "00:28:01.400",
      "formatted_end": "00:28:03.400",
      "text": "شاید مال روی بدن اینجا هایی دیشن"
    },
    {
      "id": 80,
      "start": 1683.4,
      "end": 1685.4,
      "formatted_start": "00:28:03.400",
      "formatted_end": "00:28:05.400",
      "text": "و از یه توی افتاب هایی که"
    },
    {
      "id": 81,
      "start": 1685.4,
      "end": 1687.4,
      "formatted_start": "00:28:05.400",
      "formatted_end": "00:28:07.400",
      "text": "مثلا زیاد توی افتاب نره"
    },
    {
      "id": 82,
      "start": 1687.4,
      "end": 1689.4,
      "formatted_start": "00:28:07.400",
      "formatted_end": "00:28:09.400",
      "text": "تابستان میشه یکم مثلا اینجا"
    },
    {
      "id": 83,
      "start": 1689.4,
      "end": 1691.4,
      "formatted_start": "00:28:09.400",
      "formatted_end": "00:28:11.400",
      "text": "کم رنگتر میشه تابستان نور زیاده"
    },
    {
      "id": 84,
      "start": 1691.4,
      "end": 1693.4,
      "formatted_start": "00:28:11.400",
      "formatted_end": "00:28:13.400",
      "text": "اون سو سره اینا"
    },
    {
      "id": 85,
      "start": 1693.4,
      "end": 1696.16,
      "formatted_start": "00:28:13.400",
      "formatted_end": "00:28:16.160",
      "text": "بخاطر نور و آفتاب این ایگزم ها تشکیل میشه"
    },
    {
      "id": 86,
      "start": 1696.16,
      "end": 1701.4,
      "formatted_start": "00:28:16.160",
      "formatted_end": "00:28:21.400",
      "text": "یک کماد این اصفه زنی مباشر نور نخوره بیتره یا به آفتاب داره"
    },
    {
      "id": 87,
      "start": 1701.4,
      "end": 1705.32,
      "formatted_start": "00:28:21.400",
      "formatted_end": "00:28:25.320",
      "text": "حالا صورتش این ها رو بزنید شاید توی صورتش همین لکایی در بیرونی"
    },
    {
      "id": 88,
      "start": 1705.32,
      "end": 1707.56,
      "formatted_start": "00:28:25.320",
      "formatted_end": "00:28:27.560",
      "text": "تو از پرسو ها مثلا ما بخواهیم بگیم پیش را بکنیم"
    },
    {
      "id": 89,
      "start": 1707.56,
      "end": 1709.06,
      "formatted_start": "00:28:27.560",
      "formatted_end": "00:28:29.060",
      "text": "اوش در موهد پرسو هست"
    },
    {
      "id": 90,
      "start": 1709.06,
      "end": 1711.64,
      "formatted_start": "00:28:29.060",
      "formatted_end": "00:28:31.640",
      "text": "حالا کره درپننده هم چواب زنید"
    },
    {
      "id": 91,
      "start": 1711.64,
      "end": 1716.02,
      "formatted_start": "00:28:31.640",
      "formatted_end": "00:28:36.020",
      "text": "حالا من یک چکاب کامل آهنگ میتوانیم دیروی"
    },
    {
      "id": 92,
      "start": 1716.02,
      "end": 1718.86,
      "formatted_start": "00:28:36.020",
      "formatted_end": "00:28:38.860",
      "text": "تصدایی کبیر، تیرویل، همین را رو نوشتیم"
    },
    {
      "id": 93,
      "start": 1718.86,
      "end": 1720.7,
      "formatted_start": "00:28:38.860",
      "formatted_end": "00:28:40.700",
      "text": "بینستر فراموش بگیرم"
    },
    {
      "id": 94,
      "start": 1720.7,
      "end": 1722.42,
      "formatted_start": "00:28:40.700",
      "formatted_end": "00:28:42.420",
      "text": "آره انجام بدید جوابش رو بیاد"
    },
