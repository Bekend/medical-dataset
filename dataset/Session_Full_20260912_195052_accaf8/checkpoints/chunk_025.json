    },
    {
      "id": 13,
      "start": 7696.0,
      "end": 7698.0,
      "formatted_start": "02:08:16.000",
      "formatted_end": "02:08:18.000",
      "text": "برخیمت مرسی"
    },
    {
      "id": 14,
      "start": 7714.0,
      "end": 7716.0,
      "formatted_start": "02:08:34.000",
      "formatted_end": "02:08:36.000",
      "text": "مردی که باید برداری کنید"
    },
    {
      "id": 15,
      "start": 7716.0,
      "end": 7718.0,
      "formatted_start": "02:08:36.000",
      "formatted_end": "02:08:38.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 16,
      "start": 7718.0,
      "end": 7720.0,
      "formatted_start": "02:08:38.000",
      "formatted_end": "02:08:40.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 17,
      "start": 7720.0,
      "end": 7722.0,
      "formatted_start": "02:08:40.000",
      "formatted_end": "02:08:42.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 18,
      "start": 7722.0,
      "end": 7724.0,
      "formatted_start": "02:08:42.000",
      "formatted_end": "02:08:44.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 19,
      "start": 7724.0,
      "end": 7726.0,
      "formatted_start": "02:08:44.000",
      "formatted_end": "02:08:46.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 20,
      "start": 7726.0,
      "end": 7728.0,
      "formatted_start": "02:08:46.000",
      "formatted_end": "02:08:48.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 21,
      "start": 7728.0,
      "end": 7730.0,
      "formatted_start": "02:08:48.000",
      "formatted_end": "02:08:50.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 22,
      "start": 7730.0,
      "end": 7732.0,
      "formatted_start": "02:08:50.000",
      "formatted_end": "02:08:52.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 23,
      "start": 7732.0,
      "end": 7734.0,
      "formatted_start": "02:08:52.000",
      "formatted_end": "02:08:54.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 24,
      "start": 7734.0,
      "end": 7737.8,
      "formatted_start": "02:08:54.000",
      "formatted_end": "02:08:57.800",
      "text": "ساعت ها توی قربان بردارون کنند جرد دارند"
    },
    {
      "id": 25,
      "start": 7737.8,
      "end": 7744.8,
      "formatted_start": "02:08:57.800",
      "formatted_end": "02:09:04.800",
      "text": "جالبه تو نشون بودم در افغانستان خوردبز خورشیدی هست که یه صفحه هایی مثل دیش مانگاره میونه"
    },
    {
      "id": 26,
      "start": 7744.8,
      "end": 7751.3,
      "formatted_start": "02:09:04.800",
      "formatted_end": "02:09:11.300",
      "text": "کلسو یا قابلمه ها میزارند اینجا و بیسته ایقه ای آب جشن میاد جرا تو گذاب آش میپزند"
    },
    {
      "id": 27,
      "start": 7751.3,
      "end": 7755.1,
      "formatted_start": "02:09:11.300",
      "formatted_end": "02:09:15.100",
      "text": "خیلی جالبه اینها رو خودشونشون در سلام خسته نماشید"
    },
    {
      "id": 28,
      "start": 7755.1,
      "end": 7757.4,
      "formatted_start": "02:09:15.100",
      "formatted_end": "02:09:17.400",
      "text": "و بس آقا اسم ایناست که اینه؟"
    },
    {
      "id": 29,
      "start": 7757.4,
      "end": 7759.0,
      "formatted_start": "02:09:17.400",
      "formatted_end": "02:09:19.000",
      "text": "بیاده..."
    },
    {
      "id": 30,
      "start": 7759.0,
      "end": 7761.0,
      "formatted_start": "02:09:19.000",
      "formatted_end": "02:09:21.000",
      "text": "باشه ازه"
    },
    {
      "id": 31,
      "start": 7761.0,
      "end": 7762.0,
      "formatted_start": "02:09:21.000",
      "formatted_end": "02:09:22.000",
      "text": "چی؟"
    },
    {
      "id": 32,
      "start": 7762.0,
      "end": 7770.0,
      "formatted_start": "02:09:22.000",
      "formatted_end": "02:09:30.000",
      "text": "این ها را با چی درست می کنید؟ آینه؟ آینه های معمولی."
    },
    {
      "id": 33,
      "start": 7770.0,
      "end": 7775.0,
      "formatted_start": "02:09:30.000",
      "formatted_end": "02:09:35.000",
      "text": "و از این ها که غذا را می زنند، چند دقیقا به طول می کنند؟"
    },
    {
      "id": 34,
      "start": 7775.0,
      "end": 7781.0,
      "formatted_start": "02:09:35.000",
      "formatted_end": "02:09:41.000",
      "text": "یا آب جوش می آد. کبسی جوش می آد. آب دو دقیقا؟ ده دقیقا."
    },
    {
      "id": 35,
      "start": 7781.0,
      "end": 7786.0,
      "formatted_start": "02:09:41.000",
      "formatted_end": "02:09:46.000",
      "text": "ده دقیقا آب جوش می آد؟ آب کبسی؟ آب جوش می آد."
    },
    {
      "id": 36,
      "start": 7786.0,
      "end": 7788.0,
      "formatted_start": "02:09:46.000",
      "formatted_end": "02:09:48.000",
      "text": "باید این رو قیمت از چنده هرکی بخواد بخرد؟"
    },
    {
      "id": 37,
      "start": 7788.0,
      "end": 7790.0,
      "formatted_start": "02:09:48.000",
      "formatted_end": "02:09:50.000",
      "text": "3 هزار افغانی"
    },
    {
      "id": 38,
      "start": 7790.0,
      "end": 7792.0,
      "formatted_start": "02:09:50.000",
      "formatted_end": "02:09:52.000",
      "text": "3 هزار افغانی یک چیزی میشه؟"
    },
    {
      "id": 39,
      "start": 7792.0,
      "end": 7794.0,
      "formatted_start": "02:09:52.000",
