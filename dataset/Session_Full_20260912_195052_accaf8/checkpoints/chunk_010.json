    },
    {
      "id": 13,
      "start": 3132.0,
      "end": 3134.0,
      "formatted_start": "00:52:12.000",
      "formatted_end": "00:52:14.000",
      "text": "و از اینجا باید برداری کنید"
    },
    {
      "id": 14,
      "start": 3134.0,
      "end": 3136.0,
      "formatted_start": "00:52:14.000",
      "formatted_end": "00:52:16.000",
      "text": "و از اینجا باید برداری کنید"
    },
    {
      "id": 15,
      "start": 3136.0,
      "end": 3139.0,
      "formatted_start": "00:52:16.000",
      "formatted_end": "00:52:19.000",
      "text": "اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 16,
      "start": 3139.0,
      "end": 3142.0,
      "formatted_start": "00:52:19.000",
      "formatted_end": "00:52:22.000",
      "text": "خب، از اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 17,
      "start": 3142.0,
      "end": 3145.0,
      "formatted_start": "00:52:22.000",
      "formatted_end": "00:52:25.000",
      "text": "اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 18,
      "start": 3145.0,
      "end": 3148.0,
      "formatted_start": "00:52:25.000",
      "formatted_end": "00:52:28.000",
      "text": "اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 19,
      "start": 3148.0,
      "end": 3151.0,
      "formatted_start": "00:52:28.000",
      "formatted_end": "00:52:31.000",
      "text": "اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 20,
      "start": 3151.0,
      "end": 3154.0,
      "formatted_start": "00:52:31.000",
      "formatted_end": "00:52:34.000",
      "text": "اینجا همین کار را برای ارمین و کشور ایران می کنید."
    },
    {
      "id": 21,
      "start": 3154.0,
      "end": 3183.0,
      "formatted_start": "00:52:34.000",
      "formatted_end": "00:53:03.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 3184.0,
      "end": 3191.24,
      "formatted_start": "00:53:04.000",
      "formatted_end": "00:53:11.240",
      "text": "که در یک برقی از دیگه گوشت و گوشت با روی درست نداره و مستد به صوفه"
    },
    {
      "id": 23,
      "start": 3191.24,
      "end": 3192.76,
      "formatted_start": "00:53:11.240",
      "formatted_end": "00:53:12.760",
      "text": "این دیگه جای صالحه"
    },
    {
      "id": 24,
      "start": 3192.76,
      "end": 3196.72,
      "formatted_start": "00:53:12.760",
      "formatted_end": "00:53:16.720",
      "text": "حالا به نظرم اگر خود اما بسیار نمی اومدید سرنه رو میدید"
    },
    {
      "id": 25,
      "start": 3196.72,
      "end": 3201.28,
      "formatted_start": "00:53:16.720",
      "formatted_end": "00:53:21.280",
      "text": "این همه این شما رو جز لشکریان شم و یزی تنبیل میکرد که"
    },
    {
      "id": 26,
      "start": 3201.28,
      "end": 3206.44,
      "formatted_start": "00:53:21.280",
      "formatted_end": "00:53:26.440",
      "text": "این همه کلیز نفاش بشه از نوار و صدمت کشورهای از زن من"
    },
    {
      "id": 27,
      "start": 3206.44,
      "end": 3210.6,
      "formatted_start": "00:53:26.440",
      "formatted_end": "00:53:30.600",
      "text": "کسی نماشه به خاطر دیزیارت خودها"
    },
    {
      "id": 28,
      "start": 3210.6,
      "end": 3214.28,
      "formatted_start": "00:53:30.600",
      "formatted_end": "00:53:34.280",
      "text": "اگر به خاطر من از آن دارید این همین کیزی باشد که من نخواستم"
    },
    {
      "id": 29,
      "start": 3214.28,
      "end": 3219.36,
      "formatted_start": "00:53:34.280",
      "formatted_end": "00:53:39.360",
      "text": "میخوام جمعه بردی کنم در گل افرادی هستم که کشت پردیداران فعالیت میکنند"
    },
    {
      "id": 30,
      "start": 3240.6,
      "end": 3265.6,
      "formatted_start": "00:54:00.600",
      "formatted_end": "00:54:25.600",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 3265.6,
      "end": 3268.26,
      "formatted_start": "00:54:25.600",
      "formatted_end": "00:54:28.260",
      "text": "که شما سردندن را در صد چپ میدید"
    },
    {
      "id": 32,
      "start": 3268.26,
      "end": 3270.26,
      "formatted_start": "00:54:28.260",
      "formatted_end": "00:54:30.260",
      "text": "براد حالت بریک برد میشید"
    },
    {
      "id": 33,
      "start": 3270.26,
      "end": 3272.26,
      "formatted_start": "00:54:30.260",
      "formatted_end": "00:54:32.260",
      "text": "بریم ببینیم کاربوردش چیه"
    },
    {
      "id": 34,
      "start": 3272.26,
      "end": 3275.26,
      "formatted_start": "00:54:32.260",
      "formatted_end": "00:54:35.260",
      "text": "در حالت عادی وقتی خودتون همچین شیوی قرار میگیره"
    },
    {
      "id": 35,
      "start": 3275.26,
      "end": 3277.76,
      "formatted_start": "00:54:35.260",
      "formatted_end": "00:54:37.760",
      "text": "کم کم شروع رو کنه شتاب گیره کردن"
    },
    {
      "id": 36,
      "start": 3277.76,
      "end": 3279.76,
      "formatted_start": "00:54:37.760",
      "formatted_end": "00:54:39.760",
      "text": "که خب میتونه توی مسیرهای پوهستانی"
    },
    {
      "id": 37,
      "start": 3279.76,
      "end": 3282.76,
      "formatted_start": "00:54:39.760",
      "formatted_end": "00:54:42.760",
      "text": "مسرک شیوی زیرتی دارن خطرناک باشه"
    },
    {
      "id": 38,
      "start": 3282.76,
      "end": 3285.76,
      "formatted_start": "00:54:42.760",
      "formatted_end": "00:54:45.760",
      "text": "ولی وقتی من الان حالت بی رو فعال میکنم"
    },
    {
      "id": 39,
      "start": 3285.76,
      "end": 3289.7,
      "formatted_start": "00:54:45.760",
      "formatted_end": "00:54:49.700",
      "text": "ببینیم که حتی وقتی شیوه شدیدی رو داریم تجربه بکنیم"
    },
    {
      "id": 40,
      "start": 3289.7,
      "end": 3294.0,
      "formatted_start": "00:54:49.700",
      "formatted_end": "00:54:54.000",
      "text": "سرعت خود رو کاملا داره کنترل میشه و حتی پایی تر و میاد"
    },
    {
      "id": 41,
      "start": 3294.0,
      "end": 3296.18,
      "formatted_start": "00:54:54.000",
      "formatted_end": "00:54:56.180",
      "text": "اما خود رو چطوری کار رو انجام میده"
    },
    {
      "id": 42,
      "start": 3296.18,
      "end": 3299.88,
      "formatted_start": "00:54:56.180",
      "formatted_end": "00:54:59.880",
      "text": "توی خود روی هیبرگی تویوتا ما سیستمی داریم برای ما ریجنیتیت"
    }
  ],
