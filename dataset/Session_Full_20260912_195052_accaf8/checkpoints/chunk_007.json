    },
    {
      "id": 12,
      "start": 2124.0,
      "end": 2126.0,
      "formatted_start": "00:35:24.000",
      "formatted_end": "00:35:26.000",
      "text": "اینجور برای چیه؟"
    },
    {
      "id": 13,
      "start": 2126.0,
      "end": 2128.0,
      "formatted_start": "00:35:26.000",
      "formatted_end": "00:35:28.000",
      "text": "اینجور برای چیه؟"
    },
    {
      "id": 14,
      "start": 2128.0,
      "end": 2130.0,
      "formatted_start": "00:35:28.000",
      "formatted_end": "00:35:30.000",
      "text": "بزنیم با پخش کسان خودتون بشنیم"
    },
    {
      "id": 15,
      "start": 2135.0,
      "end": 2137.0,
      "formatted_start": "00:35:35.000",
      "formatted_end": "00:35:37.000",
      "text": "کجا؟ مرکز بیداشتو کجا؟"
    },
    {
      "id": 16,
      "start": 2137.0,
      "end": 2138.0,
      "formatted_start": "00:35:37.000",
      "formatted_end": "00:35:38.000",
      "text": "سو سلام"
    },
    {
      "id": 17,
      "start": 2138.0,
      "end": 2139.0,
      "formatted_start": "00:35:38.000",
      "formatted_end": "00:35:39.000",
      "text": "سو سلام"
    },
    {
      "id": 18,
      "start": 2147.0,
      "end": 2148.0,
      "formatted_start": "00:35:47.000",
      "formatted_end": "00:35:48.000",
      "text": "سلام"
    },
    {
      "id": 19,
      "start": 2148.0,
      "end": 2149.0,
      "formatted_start": "00:35:48.000",
      "formatted_end": "00:35:49.000",
      "text": "حالا سلام"
    },
    {
      "id": 20,
      "start": 2149.0,
      "end": 2150.0,
      "formatted_start": "00:35:49.000",
      "formatted_end": "00:35:50.000",
      "text": "خوب هستین خانم؟"
    },
    {
      "id": 21,
      "start": 2151.0,
      "end": 2154.0,
      "formatted_start": "00:35:51.000",
      "formatted_end": "00:35:54.000",
      "text": "از خیلی کنم من دفتر حسینی بای هستم"
    },
    {
      "id": 22,
      "start": 2154.0,
      "end": 2156.0,
      "formatted_start": "00:35:54.000",
      "formatted_end": "00:35:56.000",
      "text": "یه مراجعه کننده داریم فهمیدیتون؟"
    },
    {
      "id": 23,
      "start": 2156.0,
      "end": 2157.0,
      "formatted_start": "00:35:56.000",
      "formatted_end": "00:35:57.000",
      "text": "دل آرامی سو سلام"
    },
    {
      "id": 24,
      "start": 2157.0,
      "end": 2159.0,
      "formatted_start": "00:35:57.000",
      "formatted_end": "00:35:59.000",
      "text": "دلارا میشه..."
    },
    {
      "id": 25,
      "start": 2159.0,
      "end": 2162.0,
      "formatted_start": "00:35:59.000",
      "formatted_end": "00:36:02.000",
      "text": "خانه خواهش میخوام، خانه زاره روز خواهی میخوام"
    },
    {
      "id": 26,
      "start": 2162.0,
      "end": 2165.0,
      "formatted_start": "00:36:02.000",
      "formatted_end": "00:36:05.000",
      "text": "به نام دلارا از شو سرایی اومده"
    },
    {
      "id": 27,
      "start": 2165.0,
      "end": 2171.0,
      "formatted_start": "00:36:05.000",
      "formatted_end": "00:36:11.000",
      "text": "میگه که مرکز بیداش گفته تمام بچه هایی که میخوان واکسن بزنن باید پیزش متخصص نامه بده"
    },
    {
      "id": 28,
      "start": 2171.0,
      "end": 2173.0,
      "formatted_start": "00:36:11.000",
      "formatted_end": "00:36:13.000",
      "text": "نه نه نه نه آبای دوکان"
    },
    {
      "id": 29,
      "start": 2173.0,
      "end": 2174.0,
      "formatted_start": "00:36:13.000",
      "formatted_end": "00:36:14.000",
      "text": "گوش بدین؟"
    },
    {
      "id": 30,
      "start": 2174.0,
      "end": 2177.0,
      "formatted_start": "00:36:14.000",
      "formatted_end": "00:36:17.000",
      "text": "صداتون روز تخشه، صداتون رو پرشتو بشنه با خودش"
    },
    {
      "id": 31,
      "start": 2177.0,
      "end": 2178.0,
      "formatted_start": "00:36:17.000",
      "formatted_end": "00:36:18.000",
      "text": "نه درون؟"
    },
    {
      "id": 32,
      "start": 2178.0,
      "end": 2180.0,
      "formatted_start": "00:36:18.000",
      "formatted_end": "00:36:20.000",
      "text": "بله بله گوشم با شمایی بخونم"
    },
    {
      "id": 33,
      "start": 2180.0,
      "end": 2186.68,
      "formatted_start": "00:36:20.000",
      "formatted_end": "00:36:26.680",
      "text": "آبای دوستان چرا که این داداد این کلک با اینکه ماستر دو ماهگی شدنده بوده"
    },
    {
      "id": 34,
      "start": 2186.68,
      "end": 2192.76,
      "formatted_start": "00:36:26.680",
      "formatted_end": "00:36:32.760",
      "text": "دو چاره ما مو باشید که به خواستن این ماستر و چیزا چرا مارده شده بوده"
    },
    {
      "id": 35,
      "start": 2192.76,
      "end": 2193.66,
      "formatted_start": "00:36:32.760",
      "formatted_end": "00:36:33.660",
      "text": "چاره این"
    },
    {
      "id": 36,
      "start": 2193.66,
      "end": 2200.82,
      "formatted_start": "00:36:33.660",
      "formatted_end": "00:36:40.820",
      "text": "با اینکه با اینکه با اینکه چار ماهگی یا با اینکه ماستر ما به ما از مرکز دو ماهگی"
    },
    {
      "id": 37,
      "start": 2200.82,
      "end": 2204.44,
      "formatted_start": "00:36:40.820",
      "formatted_end": "00:36:44.440",
      "text": "بردید که هم خیال خود اون براده راحت داشتید"
    },
    {
      "id": 38,
      "start": 2204.44,
      "end": 2209.88,
      "formatted_start": "00:36:44.440",
      "formatted_end": "00:36:49.880",
      "text": "مالیتاً از ماله زنده چون مای اوپولشان دادیم که شاید ما از اوپولش دیگه ای بوده"
    },
    {
      "id": 39,
      "start": 2209.88,
      "end": 2213.56,
      "formatted_start": "00:36:49.880",
      "formatted_end": "00:36:53.560",
      "text": "ولی چون بچه ای گذرد سیاروت کرده بود و بکتری شده بود"
    },
    {
      "id": 40,
      "start": 2213.56,
      "end": 2216.6,
      "formatted_start": "00:36:53.560",
      "formatted_end": "00:36:56.600",
      "text": "تنظیم در دکتور بوده"
    },
    {
      "id": 41,
      "start": 2216.6,
      "end": 2223.86,
      "formatted_start": "00:36:56.600",
      "formatted_end": "00:37:03.860",
      "text": "منظوری بود من از اوپولشتن بعدی گفتیم که نامه که اونی از ماله خودست که ما ممنون شده"
    },
    {
      "id": 42,
      "start": 2223.86,
      "end": 2226.02,
      "formatted_start": "00:37:03.860",
      "formatted_end": "00:37:06.020",
      "text": "نامه و از اونی ای گذرد"
    },
    {
      "id": 43,
      "start": 2226.02,
      "end": 2227.28,
      "formatted_start": "00:37:06.020",
      "formatted_end": "00:37:07.280",
      "text": "حالا حالا گرفتم"
    },
    {
      "id": 44,
      "start": 2227.28,
      "end": 2229.66,
      "formatted_start": "00:37:07.280",
      "formatted_end": "00:37:09.660",
      "text": "نه شما کار درستی انجام دادید"
    },
    {
      "id": 45,
      "start": 2229.66,
      "end": 2235.12,
      "formatted_start": "00:37:09.660",
      "formatted_end": "00:37:15.120",
      "text": "کار شما، چون اینجا توضیحی که خانم سو سره علم به من دادی تو مرتبه است"
    },
    {
      "id": 46,
      "start": 2235.12,
      "end": 2237.36,
      "formatted_start": "00:37:15.120",
      "formatted_end": "00:37:17.360",
      "text": "یه بچه هم مشکلی نداشته اینا"
    },
    {
      "id": 47,
      "start": 2237.36,
      "end": 2241.44,
      "formatted_start": "00:37:17.360",
      "formatted_end": "00:37:21.440",
      "text": "برخواستم امکان نداره، اولین باری که من سرمیش ندارم"
    },
    {
      "id": 48,
      "start": 2241.44,
      "end": 2248.06,
      "formatted_start": "00:37:21.440",
      "formatted_end": "00:37:28.060",
      "text": "پس این واکسن قبلیش دوچار آرزش، مشکلش چی بوده؟ سیانوز شده؟"
    },
    {
      "id": 49,
      "start": 2248.06,
      "end": 2253.18,
      "formatted_start": "00:37:28.060",
      "formatted_end": "00:37:33.180",
      "text": "برخواستم از اون واکسن، این وقت شده از این وقت شده"
    },
    {
      "id": 50,
      "start": 2253.18,
      "end": 2255.18,
      "formatted_start": "00:37:33.180",
      "formatted_end": "00:37:35.180",
      "text": "چقدر پرداز واکسن؟"
    },
    {
      "id": 51,
      "start": 2255.18,
      "end": 2257.18,
      "formatted_start": "00:37:35.180",
      "formatted_end": "00:37:37.180",
      "text": "بله"
    },
    {
      "id": 52,
      "start": 2257.18,
      "end": 2259.18,
      "formatted_start": "00:37:37.180",
      "formatted_end": "00:37:39.180",
      "text": "بله"
    },
    {
      "id": 53,
      "start": 2259.18,
      "end": 2261.18,
      "formatted_start": "00:37:39.180",
      "formatted_end": "00:37:41.180",
      "text": "بله"
    },
    {
      "id": 54,
      "start": 2261.18,
      "end": 2263.18,
      "formatted_start": "00:37:41.180",
      "formatted_end": "00:37:43.180",
      "text": "بله"
    },
    {
      "id": 55,
      "start": 2263.18,
      "end": 2265.18,
      "formatted_start": "00:37:43.180",
      "formatted_end": "00:37:45.180",
      "text": "بله"
    },
    {
      "id": 56,
      "start": 2265.18,
      "end": 2267.18,
      "formatted_start": "00:37:45.180",
      "formatted_end": "00:37:47.180",
      "text": "بله"
    },
    {
      "id": 57,
      "start": 2267.18,
      "end": 2269.18,
      "formatted_start": "00:37:47.180",
      "formatted_end": "00:37:49.180",
      "text": "بله"
    },
    {
      "id": 58,
      "start": 2269.18,
      "end": 2271.18,
      "formatted_start": "00:37:49.180",
      "formatted_end": "00:37:51.180",
      "text": "بله"
    },
    {
      "id": 59,
      "start": 2271.18,
      "end": 2273.18,
      "formatted_start": "00:37:51.180",
      "formatted_end": "00:37:53.180",
      "text": "بله"
    },
    {
      "id": 60,
      "start": 2273.18,
      "end": 2275.18,
      "formatted_start": "00:37:53.180",
      "formatted_end": "00:37:55.180",
      "text": "بله"
    },
    {
      "id": 61,
      "start": 2275.18,
      "end": 2277.18,
      "formatted_start": "00:37:55.180",
      "formatted_end": "00:37:57.180",
      "text": "بله"
    },
    {
      "id": 62,
      "start": 2277.18,
      "end": 2279.18,
      "formatted_start": "00:37:57.180",
      "formatted_end": "00:37:59.180",
      "text": "بله"
    },
    {
      "id": 63,
      "start": 2279.18,
      "end": 2281.18,
      "formatted_start": "00:37:59.180",
      "formatted_end": "00:38:01.180",
      "text": "بله"
    },
    {
      "id": 64,
      "start": 2281.18,
      "end": 2286.18,
      "formatted_start": "00:38:01.180",
      "formatted_end": "00:38:06.180",
      "text": "بعد از واکسن ممکن است بچه تشنوش کنه، تب کنه، این مسائل هست"
    },
    {
      "id": 65,
      "start": 2286.18,
      "end": 2291.18,
      "formatted_start": "00:38:06.180",
      "formatted_end": "00:38:11.180",
      "text": "ولی سیانوز، معمولا ما کمتر اصلا نشنیدم سیانوز"
    },
    {
      "id": 66,
      "start": 2291.18,
      "end": 2296.18,
      "formatted_start": "00:38:11.180",
      "formatted_end": "00:38:16.180",
      "text": "ما از اینجور یک روز بعد شهر باز را داریم، این روز را نمیدونیم"
    },
    {
      "id": 67,
      "start": 2296.18,
      "end": 2300.18,
      "formatted_start": "00:38:16.180",
      "formatted_end": "00:38:20.180",
      "text": "چند روز بعد از واکسن این حالت کنجور اومده؟ نفهم"
    },
    {
      "id": 68,
      "start": 2300.18,
      "end": 2303.18,
      "formatted_start": "00:38:20.180",
      "formatted_end": "00:38:23.180",
      "text": "یک روز بعد، آمدنش بشه خود را باز داریم"
    },
    {
      "id": 69,
      "start": 2303.18,
      "end": 2307.18,
      "formatted_start": "00:38:23.180",
      "formatted_end": "00:38:27.180",
      "text": "یک روز بعد واکسن این ها، درسته؟"
    },
    {
      "id": 70,
      "start": 2307.18,
      "end": 2321.18,
      "formatted_start": "00:38:27.180",
      "formatted_end": "00:38:41.180",
      "text": "من نامه بعدش میدهم واکسن زدنش بلا مانهه خب و اگه قبلش باید استامین فون میده اینا 24 سر قبل واکسن 24 سر بعد واکسن استامین فون باید بیدن اینا"
    },
    {
      "id": 71,
      "start": 2321.18,
      "end": 2327.18,
      "formatted_start": "00:38:41.180",
      "formatted_end": "00:38:47.180",
      "text": "خواهش میکنم ممنون قربان شما خدا نگردار موفق باشین"
    },
    {
      "id": 72,
      "start": 2327.18,
      "end": 2337.18,
      "formatted_start": "00:38:47.180",
      "formatted_end": "00:38:57.180",
      "text": "یادمانی میبینیم، این ریزه اینو مثلا دو ماهی خبز ماهی خبز دست نمیبینیم اگه چیز خاصی باشه"
    },
    {
      "id": 73,
      "start": 2337.18,
      "end": 2340.18,
      "formatted_start": "00:38:57.180",
      "formatted_end": "00:39:00.180",
      "text": "ببینید این ها ممکن اصلا از واکسن نبوده باشه"
    },
    {
      "id": 74,
      "start": 2340.18,
      "end": 2345.18,
      "formatted_start": "00:39:00.180",
      "formatted_end": "00:39:05.180",
      "text": "بعد همه بچه های بیورستانی و سازن اگه خود نمیدوند این ویروس جدیده"
    },
    {
      "id": 75,
      "start": 2345.18,
      "end": 2350.18,
      "formatted_start": "00:39:05.180",
      "formatted_end": "00:39:10.180",
      "text": "آره این ویروس افناد بوده درسته، ولی به واکسن رفته اعتباد داده میشه"
    },
    {
      "id": 76,
      "start": 2350.18,
      "end": 2355.62,
      "formatted_start": "00:39:10.180",
      "formatted_end": "00:39:15.620",
      "text": "بعد بهداش نمیزنه، پیزش متخصص هم میگه آقا من چرا مسئولیت قبول کنم"
    },
    {
      "id": 77,
      "start": 2355.62,
      "end": 2359.42,
      "formatted_start": "00:39:15.620",
      "formatted_end": "00:39:19.420",
      "text": "بعد واکسن بچه هم میدونه میگونه و نمیزنم و پیزش زیده"
    },
    {
      "id": 78,
      "start": 2359.42,
      "end": 2363.94,
      "formatted_start": "00:39:19.420",
      "formatted_end": "00:39:23.940",
      "text": "انا همه فرمایی این رو برگره شدیم، دیگه بچه رکنم رو بزنم سر نام ها بردیم، تو همه برگره شدیم"
    },
    {
      "id": 79,
      "start": 2363.94,
      "end": 2367.02,
      "formatted_start": "00:39:23.940",
      "formatted_end": "00:39:27.020",
      "text": "خب اون دنب همه نیستن، خب موردهای خاص"
    },
    {
      "id": 80,
      "start": 2367.02,
      "end": 2372.54,
      "formatted_start": "00:39:27.020",
      "formatted_end": "00:39:32.540",
      "text": "اونا میگن همه، من برای همین تایترو کردم و خب زنیم، موبایل تو نمیده خب"
    },
    {
      "id": 81,
      "start": 2372.54,
      "end": 2374.54,
      "formatted_start": "00:39:32.540",
      "formatted_end": "00:39:34.540",
      "text": "مرکز بیداش"
    },
    {
      "id": 82,
      "start": 2374.54,
      "end": 2376.54,
      "formatted_start": "00:39:34.540",
      "formatted_end": "00:39:36.540",
      "text": "یه روز قبل و یه روز بعد واکسن"
    },
    {
      "id": 83,
      "start": 2376.54,
      "end": 2378.54,
      "formatted_start": "00:39:36.540",
      "formatted_end": "00:39:38.540",
      "text": "اصابه میخونید"
    },
    {
      "id": 84,
      "start": 2378.54,
      "end": 2380.54,
      "formatted_start": "00:39:38.540",
      "formatted_end": "00:39:40.540",
      "text": "خب راسترها کده کس میشه؟"
    },
    {
      "id": 85,
      "start": 2380.54,
      "end": 2382.54,
      "formatted_start": "00:39:40.540",
      "formatted_end": "00:39:42.540",
      "text": "دل آرام و سوسرایی"
    },
    {
      "id": 86,
      "start": 2382.54,
      "end": 2384.54,
      "formatted_start": "00:39:42.540",
      "formatted_end": "00:39:44.540",
      "text": "دل آرام"
    },
    {
      "id": 87,
      "start": 2384.54,
      "end": 2386.54,
      "formatted_start": "00:39:44.540",
      "formatted_end": "00:39:46.540",
      "text": "سوسرایی"
    },
    {
      "id": 88,
      "start": 2386.54,
      "end": 2388.54,
      "formatted_start": "00:39:46.540",
      "formatted_end": "00:39:48.540",
      "text": "اون روز هم دیدیده شرکت نویز میشه"
    },
    {
      "id": 89,
      "start": 2388.54,
      "end": 2390.54,
      "formatted_start": "00:39:48.540",
      "formatted_end": "00:39:50.540",
      "text": "خب اون روز ملیس بود دیگه"
    },
    {
      "id": 90,
      "start": 2390.54,
      "end": 2392.54,
      "formatted_start": "00:39:50.540",
      "formatted_end": "00:39:52.540",
      "text": "ولی چی آوردی؟"
    },
    {
      "id": 91,
      "start": 2392.54,
      "end": 2394.54,
      "formatted_start": "00:39:52.540",
      "formatted_end": "00:39:54.540",
      "text": "بردم بگوییم که بردم واکسن بزنیم"
    },
    {
      "id": 92,
      "start": 2394.54,
      "end": 2396.54,
      "formatted_start": "00:39:54.540",
      "formatted_end": "00:39:56.540",
      "text": "قبل و بعد واکسن همیشه میانده باشه"
    },
    {
      "id": 93,
      "start": 2396.54,
      "end": 2398.54,
      "formatted_start": "00:39:56.540",
      "formatted_end": "00:39:58.540",
      "text": "خب واکسیناسیون"
    },
    {
      "id": 94,
      "start": 2398.54,
      "end": 2400.54,
      "formatted_start": "00:39:58.540",
      "formatted_end": "00:40:00.540",
      "text": "براتین"
    }
  ],
