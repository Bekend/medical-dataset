  "stt_segments": [
    {
      "id": 0,
      "start": 1200.0,
      "end": 1203.5,
      "formatted_start": "00:20:00.000",
      "formatted_end": "00:20:03.500",
      "text": "باید یک کلو گروب ساعت 6-7 بیانیم، ما تا 7 هستیم."
    },
    {
      "id": 1,
      "start": 1203.5,
      "end": 1206.0,
      "formatted_start": "00:20:03.500",
      "formatted_end": "00:20:06.000",
      "text": "بعد شربت هم درش داریم، سر ساعت نیم."
    },
    {
      "id": 2,
      "start": 1206.0,
      "end": 1209.0,
      "formatted_start": "00:20:06.000",
      "formatted_end": "00:20:09.000",
      "text": "آیا مهم باشید بشه برام بزنیم، من چون سرکار میکنم برام من."
    },
    {
      "id": 3,
      "start": 1209.0,
      "end": 1214.0,
      "formatted_start": "00:20:09.000",
      "formatted_end": "00:20:14.000",
      "text": "خب، گروب بزنیم خب رو راسته ره دیگه، یعنی ساعتش میکنه."
    },
    {
      "id": 4,
      "start": 1214.0,
      "end": 1215.0,
      "formatted_start": "00:20:14.000",
      "formatted_end": "00:20:15.000",
      "text": "همونطور نرم از نیزنن."
    },
    {
      "id": 5,
      "start": 1215.0,
      "end": 1218.0,
      "formatted_start": "00:20:15.000",
      "formatted_end": "00:20:18.000",
      "text": "الان که نیزنن، دکتر رو الان میزن یک کلو از نیزن نفر نتر."
    },
    {
      "id": 6,
      "start": 1218.0,
      "end": 1219.0,
      "formatted_start": "00:20:18.000",
      "formatted_end": "00:20:19.000",
      "text": "باش."
    },
    {
      "id": 7,
      "start": 1219.0,
      "end": 1221.0,
      "formatted_start": "00:20:19.000",
      "formatted_end": "00:20:21.000",
      "text": "هرمون شما خدا نگهند"
    },
    {
      "id": 8,
      "start": 1249.0,
      "end": 1258.0,
      "formatted_start": "00:20:49.000",
      "formatted_end": "00:20:58.000",
      "text": "امروز جمعه ۲۸ و اومدیم کو ارتفاعات حلقاتی"
    },
    {
      "id": 9,
      "start": 1258.0,
      "end": 1261.0,
      "formatted_start": "00:20:58.000",
      "formatted_end": "00:21:01.000",
      "text": "درمیان ما دو گروه ما هستیم"
    },
    {
      "id": 10,
      "start": 1261.0,
      "end": 1264.0,
      "formatted_start": "00:21:01.000",
      "formatted_end": "00:21:04.000",
      "text": "دختر خانم کو نورد ۷ ساله داریم"
    },
    {
      "id": 11,
      "start": 1264.0,
      "end": 1268.0,
      "formatted_start": "00:21:04.000",
      "formatted_end": "00:21:08.000",
      "text": "نوجوان ۱۶ ساله داریم"
    },
    {
      "id": 12,
      "start": 1268.0,
      "end": 1270.0,
      "formatted_start": "00:21:08.000",
      "formatted_end": "00:21:10.000",
      "text": "دختر خانم ۲۸ ساله داریم"
    },
    {
      "id": 13,
      "start": 1270.0,
      "end": 1274.0,
      "formatted_start": "00:21:10.000",
      "formatted_end": "00:21:14.000",
      "text": "و خانم ۷۰ خدا قبر"
    },
    {
      "id": 14,
      "start": 1274.0,
      "end": 1277.0,
      "formatted_start": "00:21:14.000",
      "formatted_end": "00:21:17.000",
      "text": "عالی بودیم هاش خانم خیلی عالی بودیم"
    },
    {
      "id": 15,
      "start": 1277.0,
      "end": 1281.0,
      "formatted_start": "00:21:17.000",
      "formatted_end": "00:21:21.000",
      "text": "از 72 سال تا 7 سال می‌گیر."
    },
    {
      "id": 16,
      "start": 1281.0,
      "end": 1283.0,
      "formatted_start": "00:21:21.000",
      "formatted_end": "00:21:23.000",
      "text": "این عزلت می‌خوام. 8 سال."
    },
    {
      "id": 17,
      "start": 1283.0,
      "end": 1285.0,
      "formatted_start": "00:21:23.000",
      "formatted_end": "00:21:25.000",
      "text": "8 سال داریم."
    },
    {
      "id": 18,
      "start": 1285.0,
      "end": 1287.0,
      "formatted_start": "00:21:25.000",
      "formatted_end": "00:21:27.000",
      "text": "بلا و ازایی تیم می‌گه"
    },
    {
      "id": 19,
      "start": 1287.0,
      "end": 1292.0,
      "formatted_start": "00:21:27.000",
      "formatted_end": "00:21:32.000",
      "text": "مختلف هستن و خرسخارهایی که می‌بینید دارن می‌آم."
    },
    {
      "id": 20,
      "start": 1292.0,
      "end": 1293.0,
      "formatted_start": "00:21:32.000",
      "formatted_end": "00:21:33.000",
      "text": "خوش آمدید."
    },
    {
      "id": 21,
      "start": 1293.0,
      "end": 1295.0,
      "formatted_start": "00:21:33.000",
      "formatted_end": "00:21:35.000",
      "text": "و این خرسخارهایی می‌گه"
    },
    {
      "id": 22,
      "start": 1295.0,
      "end": 1298.0,
      "formatted_start": "00:21:35.000",
      "formatted_end": "00:21:38.000",
      "text": "خوش آمدید می‌گه"
    },
    {
      "id": 23,
      "start": 1298.0,
      "end": 1300.0,
      "formatted_start": "00:21:38.000",
      "formatted_end": "00:21:40.000",
      "text": "خند"
    },
    {
      "id": 24,
      "start": 1302.0,
      "end": 1304.0,
      "formatted_start": "00:21:42.000",
      "formatted_end": "00:21:44.000",
      "text": "دیدید دیدید"
    },
    {
      "id": 25,
      "start": 1304.0,
      "end": 1306.0,
      "formatted_start": "00:21:44.000",
      "formatted_end": "00:21:46.000",
      "text": "خانه خستن نماشه"
    },
    {
      "id": 26,
      "start": 1306.0,
      "end": 1308.0,
      "formatted_start": "00:21:46.000",
      "formatted_end": "00:21:48.000",
      "text": "باید بردارید"
    },
    {
      "id": 27,
      "start": 1336.0,
      "end": 1346.0,
      "formatted_start": "00:22:16.000",
      "formatted_end": "00:22:26.000",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 1366.0,
      "end": 1395.98,
      "formatted_start": "00:22:46.000",
      "formatted_end": "00:23:15.980",
