      "formatted_start": "02:11:40.400",
      "formatted_end": "02:11:42.400",
      "text": "او خودگی خوبیه"
    },
    {
      "id": 20,
      "start": 7902.4,
      "end": 7904.4,
      "formatted_start": "02:11:42.400",
      "formatted_end": "02:11:44.400",
      "text": "بچه رو میگه منو بیرون داری"
    },
    {
      "id": 21,
      "start": 7904.4,
