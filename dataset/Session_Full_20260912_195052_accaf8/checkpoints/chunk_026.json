  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7830.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:30.000",
      "text": "از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا"
    },
    {
      "id": 1,
      "start": 7830.0,
      "end": 7833.94,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:33.940",
      "text": "اصلا بابوگاز اونو هم قط باشه، بعضون مخته میشه"
    },
    {
      "id": 2,
      "start": 7833.94,
      "end": 7835.94,
      "formatted_start": "02:10:33.940",
      "formatted_end": "02:10:35.940",
      "text": "خیلی عالیه"
    },
    {
      "id": 3,
      "start": 7835.94,
      "end": 7837.94,
      "formatted_start": "02:10:35.940",
      "formatted_end": "02:10:37.940",
      "text": "از چون که حاله؟"
    },
    {
      "id": 4,
      "start": 7837.94,
      "end": 7841.52,
      "formatted_start": "02:10:37.940",
      "formatted_end": "02:10:41.520",
      "text": "پکنی رو کنم، هیچ جای دنیا همچین چیزی رو داشته باشه"
    },
    {
      "id": 5,
      "start": 7841.52,
      "end": 7844.78,
      "formatted_start": "02:10:41.520",
      "formatted_end": "02:10:44.780",
      "text": "این فقط مخصوص افغانستانه، اختیار افغانستان"
    },
    {
      "id": 6,
      "start": 7844.78,
      "end": 7848.4,
      "formatted_start": "02:10:44.780",
      "formatted_end": "02:10:48.400",
      "text": "اومن باید سبت جمعانی باشه، خیلی جالبه"
    },
    {
      "id": 7,
      "start": 7848.4,
      "end": 7850.4,
      "formatted_start": "02:10:48.400",
      "formatted_end": "02:10:50.400",
      "text": "دست شما لرد نکنه"
    },
    {
      "id": 8,
      "start": 7850.4,
      "end": 7852.4,
      "formatted_start": "02:10:50.400",
      "formatted_end": "02:10:52.400",
      "text": "دست شما لرد نکنه، مرسی"
    },
    {
      "id": 9,
      "start": 7852.4,
      "end": 7854.4,
      "formatted_start": "02:10:52.400",
      "formatted_end": "02:10:54.400",
      "text": "این همه نیست"
    },
    {
      "id": 10,
      "start": 7854.4,
      "end": 7856.4,
      "formatted_start": "02:10:54.400",
      "formatted_end": "02:10:56.400",
      "text": "از دانمون برای که کار داری؟"
    },
    {
      "id": 11,
      "start": 7856.4,
      "end": 7876.4,
      "formatted_start": "02:10:56.400",
      "formatted_end": "02:11:16.400",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 7886.4,
      "end": 7888.4,
      "formatted_start": "02:11:26.400",
      "formatted_end": "02:11:28.400",
      "text": "بزرگان شوهرش بوده دیگه"
    },
    {
      "id": 13,
      "start": 7888.4,
      "end": 7890.4,
      "formatted_start": "02:11:28.400",
      "formatted_end": "02:11:30.400",
      "text": "بزرگان شوهرش بوده"
    },
    {
      "id": 14,
      "start": 7890.4,
      "end": 7892.4,
      "formatted_start": "02:11:30.400",
      "formatted_end": "02:11:32.400",
      "text": "نه دیگه از گرم خودگی بزرگان شوهرش بوده"
    },
    {
      "id": 15,
      "start": 7892.4,
      "end": 7894.4,
      "formatted_start": "02:11:32.400",
      "formatted_end": "02:11:34.400",
      "text": "شوهرش بوده"
    },
    {
      "id": 16,
      "start": 7894.4,
      "end": 7896.4,
      "formatted_start": "02:11:34.400",
      "formatted_end": "02:11:36.400",
      "text": "او شوهرش خوبیه"
    },
    {
      "id": 17,
      "start": 7896.4,
      "end": 7898.4,
      "formatted_start": "02:11:36.400",
      "formatted_end": "02:11:38.400",
      "text": "او خودگی خوبیه"
    },
    {
      "id": 18,
      "start": 7898.4,
      "end": 7900.4,
      "formatted_start": "02:11:38.400",
      "formatted_end": "02:11:40.400",
      "text": "او خودگی خوبیه"
    },
    {
      "id": 19,
      "start": 7900.4,
