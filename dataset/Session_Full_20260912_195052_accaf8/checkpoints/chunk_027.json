  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8130.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:30.000",
      "text": "اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینج"
    },
    {
      "id": 1,
      "start": 8130.0,
      "end": 8132.0,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:15:32.000",
      "text": "مهم از اینجا بگیرم"
    },
    {
      "id": 2,
      "start": 8132.0,
      "end": 8134.0,
      "formatted_start": "02:15:32.000",
      "formatted_end": "02:15:34.000",
      "text": "خیلی خوب، بریم سراغ بخش اول"
    },
    {
      "id": 3,
      "start": 8134.0,
      "end": 8136.0,
      "formatted_start": "02:15:34.000",
      "formatted_end": "02:15:36.000",
      "text": "مهمای اخلاقی و کانت"
    },
    {
      "id": 4,
      "start": 8136.0,
      "end": 8138.0,
      "formatted_start": "02:15:36.000",
      "formatted_end": "02:15:38.000",
      "text": "میخوام همین اول کاری"
    },
    {
      "id": 5,
      "start": 8138.0,
      "end": 8140.0,
      "formatted_start": "02:15:38.000",
      "formatted_end": "02:15:40.000",
      "text": "سوال خیلی روک و پوست کرده ازتون ببرسم"
    },
    {
      "id": 6,
      "start": 8140.0,
      "end": 8142.0,
      "formatted_start": "02:15:40.000",
      "formatted_end": "02:15:42.000",
      "text": "و میخوام صالحانه بهش شباب بدیم"
    },
    {
      "id": 7,
      "start": 8142.0,
      "end": 8144.0,
      "formatted_start": "02:15:42.000",
      "formatted_end": "02:15:44.000",
      "text": "تا حالا شده برای فرار از این درد سر بزرگ"
    },
    {
      "id": 8,
      "start": 8144.0,
      "end": 8146.0,
      "formatted_start": "02:15:44.000",
      "formatted_end": "02:15:46.000",
      "text": "حقیقت رو یک کوچونی دستگاهی کنیم"
    },
    {
      "id": 9,
      "start": 8146.0,
      "end": 8148.0,
      "formatted_start": "02:15:46.000",
      "formatted_end": "02:15:48.000",
      "text": "یا هر تا دارین که به این افراد کمک کنید"
    },
    {
      "id": 10,
      "start": 8148.0,
      "end": 8150.0,
      "formatted_start": "02:15:48.000",
      "formatted_end": "02:15:50.000",
      "text": "این رو مصدرتی بگیم"
    },
    {
      "id": 11,
      "start": 8150.0,
      "end": 8153.5,
      "formatted_start": "02:15:50.000",
      "formatted_end": "02:15:53.500",
      "text": "اینجا کار نگاه میکنیم و با خودمون میگیم خب این هایی اصول کم تره داره"
    },
    {
      "id": 12,
      "start": 8153.5,
      "end": 8157.5,
      "formatted_start": "02:15:53.500",
      "formatted_end": "02:15:57.500",
      "text": "اما جمال کانتوی این دوراهی واقعا شکر مارند است"
    },
    {
      "id": 13,
      "start": 8157.5,
      "end": 8160.0,
      "formatted_start": "02:15:57.500",
      "formatted_end": "02:16:00.000",
      "text": "اما دروبویی تحت این هرشون دیگه"
    },
    {
      "id": 14,
      "start": 8160.0,
      "end": 8161.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:01.000",
      "text": "سلامت شوید"
    },
    {
      "id": 15,
      "start": 8161.0,
      "end": 8166.0,
      "formatted_start": "02:16:01.000",
      "formatted_end": "02:16:06.000",
      "text": "ایچ اماله اگر یه هم ندارم چرا؟ چون اصول مونیادین ابلاغی"
    },
    {
      "id": 16,
      "start": 8166.0,
      "end": 8169.0,
      "formatted_start": "02:16:06.000",
      "formatted_end": "02:16:09.000",
      "text": "بفرام بخواهیم سلامت بشید"
    },
    {
      "id": 17,
      "start": 8169.0,
      "end": 8172.0,
      "formatted_start": "02:16:09.000",
      "formatted_end": "02:16:12.000",
      "text": "این غلیش این از اون هم نگاه مارند"
    },
    {
      "id": 18,
      "start": 8172.0,
      "end": 8176.0,
      "formatted_start": "02:16:12.000",
      "formatted_end": "02:16:16.000",
      "text": "این چی هست؟ آزمایش رو اکتروید؟ دارو مصرف میکرده؟"
    },
    {
      "id": 19,
      "start": 8176.0,
      "end": 8191.0,
      "formatted_start": "02:16:16.000",
      "formatted_end": "02:16:31.000",
      "text": "این آزمایش خوبه همون نصفه را ادامه بده"
    },
    {
      "id": 20,
      "start": 8191.0,
      "end": 8193.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:33.000",
      "text": "چند شده هشت؟"
    },
    {
      "id": 21,
      "start": 8193.0,
      "end": 8195.0,
      "formatted_start": "02:16:33.000",
      "formatted_end": "02:16:35.000",
      "text": "۱۱ بوده دیگه"
    },
    {
      "id": 22,
      "start": 8195.0,
      "end": 8196.0,
      "formatted_start": "02:16:35.000",
      "formatted_end": "02:16:36.000",
      "text": "هنوز چند بشه؟"
    },
    {
      "id": 23,
      "start": 8196.0,
      "end": 8200.0,
      "formatted_start": "02:16:36.000",
      "formatted_end": "02:16:40.000",
      "text": "نه اونا دیگه شما خیلی چیز نکنه بوده هشت بوده هنوز شده سه"
    },
    {
      "id": 24,
      "start": 8200.0,
      "end": 8204.0,
      "formatted_start": "02:16:40.000",
      "formatted_end": "02:16:44.000",
      "text": "اینجا دو خوردی بوده پایین چیز بوده نرمال شده"
    },
    {
      "id": 25,
      "start": 8204.0,
      "end": 8207.76,
      "formatted_start": "02:16:44.000",
      "formatted_end": "02:16:47.760",
      "text": "این آزمایش الان دومی همه طبیعی هست"
    },
    {
      "id": 26,
      "start": 8207.76,
      "end": 8209.76,
      "formatted_start": "02:16:47.760",
      "formatted_end": "02:16:49.760",
      "text": "این دو جاش مشکل داره"
    },
    {
      "id": 27,
      "start": 8209.76,
      "end": 8211.76,
      "formatted_start": "02:16:49.760",
      "formatted_end": "02:16:51.760",
      "text": "با همین پرس تنهایی شده"
    },
    {
      "id": 28,
      "start": 8211.76,
      "end": 8213.76,
      "formatted_start": "02:16:51.760",
      "formatted_end": "02:16:53.760",
      "text": "نقرانی نیست"
    },
    {
      "id": 29,
      "start": 8213.76,
      "end": 8216.76,
      "formatted_start": "02:16:53.760",
      "formatted_end": "02:16:56.760",
      "text": "فعلا نه ولی پرس قطع نکنید سن بچه چقدره؟"
    },
    {
      "id": 30,
      "start": 8216.76,
