  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 602.0,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:02.000",
      "text": "از اینجا باید باید بیمار بشید."
    },
    {
      "id": 1,
      "start": 602.0,
      "end": 604.0,
      "formatted_start": "00:10:02.000",
      "formatted_end": "00:10:04.000",
      "text": "نه، اینجا باید بشید. اینجا باید بشید. اینجا باید بشید."
    },
    {
      "id": 2,
      "start": 604.0,
      "end": 606.0,
      "formatted_start": "00:10:04.000",
      "formatted_end": "00:10:06.000",
      "text": "اینجا باید بشید. اینجا باید بشید."
    },
    {
      "id": 3,
      "start": 606.0,
      "end": 613.0,
      "formatted_start": "00:10:06.000",
      "formatted_end": "00:10:13.000",
      "text": "اگر اصلا گیج باشید که نتونه بمکه، بی حال باشید که اصلا سینه رو نتونه بگیرید، خیلی عادیه."
    },
    {
      "id": 4,
      "start": 613.0,
      "end": 614.0,
      "formatted_start": "00:10:13.000",
      "formatted_end": "00:10:14.000",
      "text": "نه، باید بکنیم."
    },
    {
      "id": 5,
      "start": 614.0,
      "end": 618.0,
      "formatted_start": "00:10:14.000",
      "formatted_end": "00:10:18.000",
      "text": "اونجوری که چون میگید یه مدار پیزشکو بعض موقع میترسونید"
    },
    {
      "id": 6,
      "start": 618.0,
      "end": 620.0,
      "formatted_start": "00:10:18.000",
      "formatted_end": "00:10:20.000",
      "text": "میتونم کم تجربه باشد"
    },
    {
      "id": 7,
      "start": 620.0,
      "end": 623.0,
      "formatted_start": "00:10:20.000",
      "formatted_end": "00:10:23.000",
      "text": "نه این زبنتونو بیمارستان همونجوری شده"
    },
    {
      "id": 8,
      "start": 623.0,
      "end": 626.0,
      "formatted_start": "00:10:23.000",
      "formatted_end": "00:10:26.000",
      "text": "یه واکسنیلو رو زدن، چون این خوابید"
    },
    {
      "id": 9,
      "start": 626.0,
      "end": 629.0,
      "formatted_start": "00:10:26.000",
      "formatted_end": "00:10:29.000",
      "text": "بعد شما گفتید شیر نمیخورده، گفتم بسترید"
    },
    {
      "id": 10,
      "start": 629.0,
      "end": 631.0,
      "formatted_start": "00:10:29.000",
      "formatted_end": "00:10:31.000",
      "text": "نه بستری نکردیم"
    },
    {
      "id": 11,
      "start": 631.0,
      "end": 633.0,
      "formatted_start": "00:10:31.000",
      "formatted_end": "00:10:33.000",
      "text": "بعد رضایت دادیم"
    },
    {
      "id": 12,
      "start": 634.0,
      "end": 639.0,
      "formatted_start": "00:10:34.000",
      "formatted_end": "00:10:39.000",
      "text": "چون این لباسو مالی در نیوبر اونطور بازم نگیرست"
    },
    {
      "id": 13,
      "start": 639.0,
      "end": 643.0,
      "formatted_start": "00:10:39.000",
      "formatted_end": "00:10:43.000",
      "text": "نکه سینه بعض موقع کلخته، برده"
    },
    {
      "id": 14,
      "start": 643.0,
      "end": 646.0,
      "formatted_start": "00:10:43.000",
      "formatted_end": "00:10:46.000",
      "text": "بچه نیمیتونه، یکم بگیره حال نداره"
    },
    {
      "id": 15,
      "start": 647.0,
      "end": 650.0,
      "formatted_start": "00:10:47.000",
      "formatted_end": "00:10:50.000",
      "text": "یک فرصه شان درسته"
    },
    {
      "id": 16,
      "start": 650.0,
      "end": 652.0,
      "formatted_start": "00:10:50.000",
      "formatted_end": "00:10:52.000",
      "text": "خیلی خوب"
    },
    {
      "id": 17,
      "start": 652.0,
      "end": 655.0,
      "formatted_start": "00:10:52.000",
      "formatted_end": "00:10:55.000",
      "text": "این زرگی شروع شده، این پیشتر هم میشه"
    },
    {
      "id": 18,
      "start": 655.0,
      "end": 658.0,
      "formatted_start": "00:10:55.000",
      "formatted_end": "00:10:58.000",
      "text": "چون تازه روز ست ببشاره"
    },
    {
      "id": 19,
      "start": 658.0,
      "end": 662.0,
      "formatted_start": "00:10:58.000",
      "formatted_end": "00:11:02.000",
      "text": "نه تازه، دو هفته بالا روانده، بعد میاد پایین"
    },
    {
      "id": 20,
      "start": 662.0,
      "end": 666.0,
      "formatted_start": "00:11:02.000",
      "formatted_end": "00:11:06.000",
      "text": "بهترین کار هم اینه، که دستگاه ببرید"
    },
    {
      "id": 21,
      "start": 666.0,
      "end": 668.0,
      "formatted_start": "00:11:06.000",
      "formatted_end": "00:11:08.000",
      "text": "این شدیدتر میشه"
    },
    {
      "id": 22,
      "start": 668.0,
      "end": 672.0,
      "formatted_start": "00:11:08.000",
      "formatted_end": "00:11:12.000",
      "text": "به منشین بگیرید یه دو سه شهر دستگاه خوب ببرید، براش از الان بزرگید"
    },
    {
      "id": 23,
      "start": 672.0,
      "end": 674.0,
      "formatted_start": "00:11:12.000",
      "formatted_end": "00:11:14.000",
      "text": "نظر میشه آزمایش بودی؟"
    },
    {
      "id": 24,
      "start": 674.0,
      "end": 689.0,
      "formatted_start": "00:11:14.000",
      "formatted_end": "00:11:29.000",
      "text": "نه، خونگیری هم سخته، مشخصه، صورت زرده، آزمایش میگنیم که چیه، مثلا بگه ۱۰، بگه ۸، بگه ۱۵، خب، باید به نتیجه میسیم زیر دستگاه بذاریم، فرق این کنید تو اولکرم"
    },
    {
      "id": 25,
      "start": 689.0,
      "end": 694.0,
      "formatted_start": "00:11:29.000",
      "formatted_end": "00:11:34.000",
      "text": "همونو بیتر حجینه نکنید، بچه رو مذیب نکنید، دستگاه رو ببینید"
    },
    {
      "id": 26,
      "start": 694.0,
      "end": 702.0,
      "formatted_start": "00:11:34.000",
      "formatted_end": "00:11:42.000",
      "text": "آمل مشخصه، مادر منفیه، پدر مصبته، این زردی دلیلش اینه و این زردی های توفانی تنی هست"
    },
    {
      "id": 27,
      "start": 702.0,
      "end": 706.0,
      "formatted_start": "00:11:42.000",
      "formatted_end": "00:11:46.000",
      "text": "برای همین شما ترسیدی رو زودتر آورده، کار رو بودی کردید، دستگاه رو ببینید"
    },
    {
      "id": 28,
      "start": 706.0,
      "end": 707.0,
      "formatted_start": "00:11:46.000",
      "formatted_end": "00:11:47.000",
      "text": "از دیگه نمیتونید؟"
    },
    {
      "id": 29,
      "start": 707.0,
      "end": 711.0,
      "formatted_start": "00:11:47.000",
      "formatted_end": "00:11:51.000",
      "text": "هیچ چی نمیتونید، اونو تنجه میشیده خشنه، سال نمیتونید"
    },
    {
      "id": 30,
      "start": 711.0,
      "end": 715.0,
      "formatted_start": "00:11:51.000",
      "formatted_end": "00:11:55.000",
      "text": "درمان اصلی فقط دستگاهی را بیمارستان باید تریش کن"
    },
    {
      "id": 31,
      "start": 715.0,
      "end": 719.0,
      "formatted_start": "00:11:55.000",
      "formatted_end": "00:11:59.000",
      "text": "اون سخته برای تو بهترین کاری که دستگاه تو خونه برمدی اون را عرض کن"
    },
    {
      "id": 32,
      "start": 719.0,
      "end": 721.0,
      "formatted_start": "00:11:59.000",
      "formatted_end": "00:12:01.000",
      "text": "منو شیره خشنی هم ندیم"
    },
    {
      "id": 33,
      "start": 721.0,
      "end": 723.0,
      "formatted_start": "00:12:01.000",
      "formatted_end": "00:12:03.000",
      "text": "هیچی خواهی سال میداز و شور میداز"
    },
    {
      "id": 34,
      "start": 723.0,
      "end": 725.0,
      "formatted_start": "00:12:03.000",
      "formatted_end": "00:12:05.000",
      "text": "ترنجه میشی به خشن"
    },
    {
      "id": 35,
      "start": 725.0,
      "end": 729.0,
      "formatted_start": "00:12:05.000",
      "formatted_end": "00:12:09.000",
      "text": "شور میکنه باید چرا بیه های من"
    },
    {
      "id": 36,
      "start": 729.0,
      "end": 733.0,
      "formatted_start": "00:12:09.000",
      "formatted_end": "00:12:13.000",
      "text": "اینجوریان ها خوبه اینجوریان ها خوبه"
    },
    {
      "id": 37,
      "start": 733.0,
      "end": 735.0,
      "formatted_start": "00:12:13.000",
      "formatted_end": "00:12:15.000",
      "text": "بچه اکثرا خوبه شونو زیر اکتر سرات خوبه"
    },
    {
      "id": 38,
      "start": 735.0,
      "end": 737.0,
      "formatted_start": "00:12:15.000",
      "formatted_end": "00:12:17.000",
      "text": "پایانم از سال نوه شورم"
    },
    {
      "id": 39,
      "start": 737.0,
      "end": 741.0,
      "formatted_start": "00:12:17.000",
      "formatted_end": "00:12:21.000",
      "text": "اشکال نداره، هرنگ نور دهونی مردم دکساتونی کنید"
    },
    {
      "id": 40,
      "start": 741.0,
      "end": 744.0,
      "formatted_start": "00:12:21.000",
      "formatted_end": "00:12:24.000",
      "text": "خطرناک صحبت کنید، باید بسترش کنید"
    },
    {
      "id": 41,
      "start": 744.0,
      "end": 748.0,
      "formatted_start": "00:12:24.000",
      "formatted_end": "00:12:28.000",
      "text": "اصلاً، وقتی که اصلاً شیر نمیخورد، باید بسترش کنید"
    },
    {
      "id": 42,
      "start": 748.0,
      "end": 751.0,
      "formatted_start": "00:12:28.000",
      "formatted_end": "00:12:31.000",
      "text": "مثلاً، این کلمات رو دیگرد کنید"
    },
    {
      "id": 43,
      "start": 751.0,
      "end": 755.0,
      "formatted_start": "00:12:31.000",
      "formatted_end": "00:12:35.000",
      "text": "چون بچه هساسه، خیلی مامگوش میده اونها رو باشد"
    },
    {
      "id": 44,
      "start": 755.0,
      "end": 759.0,
      "formatted_start": "00:12:35.000",
      "formatted_end": "00:12:39.000",
      "text": "وقتی که کلماتی میگن، اصلاً بلند نمیشه شیر نمیخورد"
    },
    {
      "id": 45,
      "start": 759.0,
      "end": 764.24,
      "formatted_start": "00:12:39.000",
      "formatted_end": "00:12:44.240",
      "text": "این بچه ها اگر اینجوری باشه، تند و خونش میبنه، پایین تشنروش میکنه، خطرناکه"
    },
    {
      "id": 46,
      "start": 764.24,
      "end": 766.24,
      "formatted_start": "00:12:44.240",
      "formatted_end": "00:12:46.240",
      "text": "نه توی اینکسان گره صد بود"
    },
    {
      "id": 47,
      "start": 766.24,
      "end": 767.24,
      "formatted_start": "00:12:46.240",
      "formatted_end": "00:12:47.240",
      "text": "آره، آفرین"
    },
    {
      "id": 48,
      "start": 767.24,
      "end": 772.2,
      "formatted_start": "00:12:47.240",
      "formatted_end": "00:12:52.200",
      "text": "ولی مثلا این ها یه ساعت هایی میخوابند، یه دو سه ساعت میخوابند"
    },
    {
      "id": 49,
      "start": 772.2,
      "end": 776.2,
      "formatted_start": "00:12:52.200",
      "formatted_end": "00:12:56.200",
      "text": "و بعد تا میشه یکمی، ۲۰۰۰ ساعت شیر میخوره و باز میخوابه"
    },
    {
      "id": 50,
      "start": 776.2,
      "end": 780.7,
      "formatted_start": "00:12:56.200",
      "formatted_end": "00:13:00.700",
      "text": "شما از این تضایب دارید خیلی جیغه داد کنه، اونم زیر دو هفته نیمی کنه"
    },
    {
      "id": 51,
      "start": 780.7,
      "end": 783.42,
      "formatted_start": "00:13:00.700",
      "formatted_end": "00:13:03.420",
      "text": "نه وقتی بیدای میشه کرده میشه صافتشون میگه"
    },
    {
      "id": 52,
      "start": 783.42,
      "end": 784.16,
      "formatted_start": "00:13:03.420",
      "formatted_end": "00:13:04.160",
      "text": "کمان بیرون"
    },
    {
      "id": 53,
      "start": 784.16,
      "end": 786.46,
      "formatted_start": "00:13:04.160",
      "formatted_end": "00:13:06.460",
      "text": "چون این چک میشه برد ندازتشون"
    },
    {
      "id": 54,
      "start": 786.46,
      "end": 789.12,
      "formatted_start": "00:13:06.460",
      "formatted_end": "00:13:09.120",
      "text": "یه مدت جیت میشن بچه ها سرسون کردن بشن"
    },
    {
      "id": 55,
      "start": 789.12,
      "end": 793.64,
      "formatted_start": "00:13:09.120",
      "formatted_end": "00:13:13.640",
      "text": "این غربش میشه چک کنید چون نه هم ترموکیده"
    },
    {
      "id": 56,
      "start": 793.64,
      "end": 796.88,
      "formatted_start": "00:13:13.640",
      "formatted_end": "00:13:16.880",
      "text": "چی گفت؟"
    },
    {
      "id": 57,
      "start": 796.88,
      "end": 797.54,
      "formatted_start": "00:13:16.880",
      "formatted_end": "00:13:17.540",
      "text": "بیداری"
    },
    {
      "id": 58,
      "start": 797.54,
      "end": 799.36,
      "formatted_start": "00:13:17.540",
      "formatted_end": "00:13:19.360",
      "text": "چی گفت؟"
    },
    {
      "id": 59,
      "start": 799.36,
      "end": 802.9,
      "formatted_start": "00:13:19.360",
      "formatted_end": "00:13:22.900",
      "text": "مفیده چک کردیم برای غربش نه بودتن نمیدونم بیمارستن نمیدونم"
    },
    {
      "id": 60,
      "start": 802.9,
      "end": 803.42,
      "formatted_start": "00:13:22.900",
      "formatted_end": "00:13:23.420",
      "text": "سپنید"
    },
    {
      "id": 61,
      "start": 803.42,
      "end": 809.76,
      "formatted_start": "00:13:23.420",
      "formatted_end": "00:13:29.760",
      "text": "قدر خوبه"
    },
    {
      "id": 62,
      "start": 809.76,
      "end": 811.76,
      "formatted_start": "00:13:29.760",
      "formatted_end": "00:13:31.760",
      "text": "۲۰ ساعت میزنیم"
    },
    {
      "id": 63,
      "start": 815.76,
      "end": 818.76,
      "formatted_start": "00:13:35.760",
      "formatted_end": "00:13:38.760",
      "text": "خیلی خیلی خاصی میدین نزدنیه، آره فامیلیتون؟"
    },
    {
      "id": 64,
      "start": 818.76,
      "end": 820.76,
      "formatted_start": "00:13:38.760",
      "formatted_end": "00:13:40.760",
      "text": "نه"
    },
    {
      "id": 65,
      "start": 820.76,
      "end": 821.76,
      "formatted_start": "00:13:40.760",
      "formatted_end": "00:13:41.760",
      "text": "نه؟"
    },
    {
      "id": 66,
      "start": 821.76,
      "end": 823.76,
      "formatted_start": "00:13:41.760",
      "formatted_end": "00:13:43.760",
      "text": "نه، فامیل بچیشیه"
    },
    {
      "id": 67,
      "start": 823.76,
      "end": 824.76,
      "formatted_start": "00:13:43.760",
      "formatted_end": "00:13:44.760",
      "text": "نه، نه، نه"
    },
    {
      "id": 68,
      "start": 824.76,
      "end": 826.76,
      "formatted_start": "00:13:44.760",
      "formatted_end": "00:13:46.760",
      "text": "ببینید این کاری لازمید، فقط دستگاه ببرید"
    },
    {
      "id": 69,
      "start": 826.76,
      "end": 829.76,
      "formatted_start": "00:13:46.760",
      "formatted_end": "00:13:49.760",
      "text": "به موشی میگید یه دو سه شب دستگاه ببرید"
    },
    {
      "id": 70,
      "start": 829.76,
      "end": 831.76,
      "formatted_start": "00:13:49.760",
      "formatted_end": "00:13:51.760",
      "text": "یه قرصه، یه قطعه، آره"
    },
    {
      "id": 71,
      "start": 831.76,
      "end": 834.76,
      "formatted_start": "00:13:51.760",
      "formatted_end": "00:13:54.760",
      "text": "هر چی پیشتر بذارید، بهتره"
    },
    {
      "id": 72,
      "start": 834.76,
      "end": 838.76,
      "formatted_start": "00:13:54.760",
      "formatted_end": "00:13:58.760",
      "text": "این زردیایی گره وارا رو مغزه و چه هسته رو باید بگیردیم"
    },
    {
      "id": 73,
      "start": 838.76,
      "end": 839.76,
      "formatted_start": "00:13:58.760",
      "formatted_end": "00:13:59.760",
      "text": "کمزید"
    },
    {
      "id": 74,
      "start": 839.76,
      "end": 842.76,
      "formatted_start": "00:13:59.760",
      "formatted_end": "00:14:02.760",
      "text": "اون کافستونو بیزنه تا دیدی کافستونو به نوشین داریم"
    },
    {
      "id": 75,
      "start": 842.76,
      "end": 843.76,
      "formatted_start": "00:14:02.760",
      "formatted_end": "00:14:03.760",
      "text": "دیدیم"
    },
    {
      "id": 76,
      "start": 843.76,
      "end": 845.76,
      "formatted_start": "00:14:03.760",
      "formatted_end": "00:14:05.760",
      "text": "این برگیرشو نداریم"
    },
    {
      "id": 77,
      "start": 845.76,
      "end": 849.76,
      "formatted_start": "00:14:05.760",
      "formatted_end": "00:14:09.760",
      "text": "نه نه این نه این"
    },
    {
      "id": 78,
      "start": 849.76,
      "end": 851.76,
      "formatted_start": "00:14:09.760",
      "formatted_end": "00:14:11.760",
      "text": "هنوز دادم دیدم"
    },
    {
      "id": 79,
      "start": 851.76,
      "end": 853.76,
      "formatted_start": "00:14:11.760",
      "formatted_end": "00:14:13.760",
      "text": "باز اداخته بیدش کنیش"
    },
    {
      "id": 80,
      "start": 853.76,
      "end": 855.76,
      "formatted_start": "00:14:13.760",
      "formatted_end": "00:14:15.760",
      "text": "هنوز دیستیم"
    },
    {
      "id": 81,
      "start": 855.76,
      "end": 858.76,
      "formatted_start": "00:14:15.760",
      "formatted_end": "00:14:18.760",
      "text": "هره دادید که مانو باز اداخت اینجا بود"
    },
    {
      "id": 82,
      "start": 858.76,
      "end": 865.76,
      "formatted_start": "00:14:18.760",
      "formatted_end": "00:14:25.760",
      "text": "درست شویدید؟ مرموزه؟"
    },
    {
      "id": 83,
      "start": 865.76,
      "end": 872.76,
      "formatted_start": "00:14:25.760",
      "formatted_end": "00:14:32.760",
      "text": "ببینید روزی ۷۸ بار کار می کنند مثل اصحال، آبکی، شیر می کنند، قره کار می کنند، این ها طبیعی هستند"
    },
    {
      "id": 84,
      "start": 872.76,
      "end": 874.76,
      "formatted_start": "00:14:32.760",
      "formatted_end": "00:14:34.760",
      "text": "اینو سه فرمی هستند"
    },
    {
      "id": 85,
      "start": 874.76,
      "end": 877.76,
      "formatted_start": "00:14:34.760",
      "formatted_end": "00:14:37.760",
      "text": "هنوز شاید اوهایی مثل غیر سیاه کسپنه شده"
    },
    {
      "id": 86,
      "start": 877.76,
      "end": 878.76,
      "formatted_start": "00:14:37.760",
      "formatted_end": "00:14:38.760",
      "text": "اونو شوید"
    },
    {
      "id": 87,
      "start": 878.76,
      "end": 879.76,
      "formatted_start": "00:14:38.760",
      "formatted_end": "00:14:39.760",
      "text": "اونو زیاد شده نشده"
    },
    {
      "id": 88,
      "start": 879.76,
      "end": 880.76,
      "formatted_start": "00:14:39.760",
      "formatted_end": "00:14:40.760",
      "text": "آره، اونو شش فرمید"
    },
    {
      "id": 89,
      "start": 880.76,
      "end": 884.76,
      "formatted_start": "00:14:40.760",
      "formatted_end": "00:14:44.760",
      "text": "از خوراک و مادر هم پسیر نداره"
    },
    {
      "id": 90,
      "start": 884.76,
      "end": 886.76,
      "formatted_start": "00:14:44.760",
      "formatted_end": "00:14:46.760",
      "text": "تثیر نداره نه"
    },
    {
      "id": 91,
      "start": 886.76,
      "end": 892.26,
      "formatted_start": "00:14:46.760",
      "formatted_end": "00:14:52.260",
      "text": "مثلا میگن زرچوبه نخور، کره نخور، تخموخ نخور، نیش خودم تثیر رو زدی نزده"
    },
    {
      "id": 92,
      "start": 892.26,
      "end": 897.26,
      "formatted_start": "00:14:52.260",
      "formatted_end": "00:14:57.260",
      "text": "حرفای زنهایی که میشنند تو خونه تبابت های خست"
    },
    {
      "id": 93,
      "start": 897.26,
      "end": 899.26,
      "formatted_start": "00:14:57.260",
      "formatted_end": "00:14:59.260",
      "text": "خیلی مزید برنامه"
    }
  ],
  "status": "completed"
}