  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3925.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:25.000",
      "text": "سردیجه کمه؟ سردیجه، آه سنگیله، میتونه آرزه داروی هم باشه، دارواتو آوردی؟ دارو ندید، داروی یه دونه سبز بود که باید شب بخوریم، همون سبزش دیره دارد خواه، بیتایستی بیگرد، سیناریزین هم برای شب بود، دیگه صبح بیشتر سرسنگیله یا بعد از اون؟"
    },
    {
      "id": 1,
      "start": 3925.0,
      "end": 3928.44,
      "formatted_start": "01:05:25.000",
      "formatted_end": "01:05:28.440",
      "text": "از خود که پا میشم یک کم دارم خیلی کم"
    },
    {
      "id": 2,
      "start": 3928.44,
      "end": 3930.16,
      "formatted_start": "01:05:28.440",
      "formatted_end": "01:05:30.160",
      "text": "برد از رو بیشم باشم"
    },
    {
      "id": 3,
      "start": 3930.16,
      "end": 3933.76,
      "formatted_start": "01:05:30.160",
      "formatted_end": "01:05:33.760",
      "text": "برد از رو باید بازماش بدن اون ماله کبهه سرسنگی"
    },
    {
      "id": 4,
      "start": 3933.76,
      "end": 3935.0,
      "formatted_start": "01:05:33.760",
      "formatted_end": "01:05:35.000",
      "text": "اون به سر رفتی نداره"
    },
    {
      "id": 5,
      "start": 3935.0,
      "end": 3938.28,
      "formatted_start": "01:05:35.000",
      "formatted_end": "01:05:38.280",
      "text": "اون ماله کبههیه اصلا بوشتونی بردانم ببینیم"
    },
    {
      "id": 6,
      "start": 3938.28,
      "end": 3941.12,
      "formatted_start": "01:05:38.280",
      "formatted_end": "01:05:41.120",
      "text": "اون چرا بردش انجام میدی"
    },
    {
      "id": 7,
      "start": 3941.12,
      "end": 3946.96,
      "formatted_start": "01:05:41.120",
      "formatted_end": "01:05:46.960",
      "text": "اون همه درست خوبه این"
    },
    {
      "id": 8,
      "start": 3946.96,
      "end": 3951.96,
      "formatted_start": "01:05:46.960",
      "formatted_end": "01:05:51.960",
      "text": "کاملا"
    },
    {
      "id": 9,
      "start": 3951.96,
      "end": 3954.96,
      "formatted_start": "01:05:51.960",
      "formatted_end": "01:05:54.960",
      "text": "اصلا اثری اصر یه جای نداری"
    },
    {
      "id": 10,
      "start": 3954.96,
      "end": 3956.96,
      "formatted_start": "01:05:54.960",
      "formatted_end": "01:05:56.960",
      "text": "ولی چیزی که هست"
    },
    {
      "id": 11,
      "start": 3956.96,
      "end": 3960.96,
      "formatted_start": "01:05:56.960",
      "formatted_end": "01:06:00.960",
      "text": "منگیر سنگیریت یک مقدار مال آرزه سینارزینه"
    },
    {
      "id": 12,
      "start": 3960.96,
      "end": 3964.96,
      "formatted_start": "01:06:00.960",
      "formatted_end": "01:06:04.960",
      "text": "یه مقدار زیاد که بعد از اون رو میشیم مال کبدتی که"
    },
    {
      "id": 13,
      "start": 3964.96,
      "end": 3966.96,
      "formatted_start": "01:06:04.960",
      "formatted_end": "01:06:06.960",
      "text": "غذا میخوری سنگیر میشیم"
    },
    {
      "id": 14,
      "start": 3966.96,
      "end": 3967.96,
      "formatted_start": "01:06:06.960",
      "formatted_end": "01:06:07.960",
      "text": "کانال؟"
    },
    {
      "id": 15,
      "start": 3967.96,
      "end": 3970.96,
      "formatted_start": "01:06:07.960",
      "formatted_end": "01:06:10.960",
      "text": "این آزمایش کبد که دادی؟"
    },
    {
      "id": 16,
      "start": 3970.96,
      "end": 3973.96,
      "formatted_start": "01:06:10.960",
      "formatted_end": "01:06:13.960",
      "text": "من آزمایش کبد دیده هفته پیش کلن چپا و کاماش"
    },
    {
      "id": 17,
      "start": 3973.96,
      "end": 3974.96,
      "formatted_start": "01:06:13.960",
      "formatted_end": "01:06:14.960",
      "text": "چپا و کاماش"
    },
    {
      "id": 18,
      "start": 3974.96,
      "end": 3975.96,
      "formatted_start": "01:06:14.960",
      "formatted_end": "01:06:15.960",
      "text": "گفتن خوبه"
    },
    {
      "id": 19,
      "start": 3975.96,
      "end": 3977.96,
      "formatted_start": "01:06:15.960",
      "formatted_end": "01:06:17.960",
      "text": "این مارسان دو واقتین همه چه بیساره بیشیم"
    },
    {
      "id": 20,
      "start": 3977.96,
      "end": 3981.2,
      "formatted_start": "01:06:17.960",
      "formatted_end": "01:06:21.200",
      "text": "همون باعث شده که به خوردن شجاعت داشته بشی"
    },
    {
      "id": 21,
      "start": 3981.2,
      "end": 3984.04,
      "formatted_start": "01:06:21.200",
      "formatted_end": "01:06:24.040",
      "text": "الان وقتی دیگه که میگن که آزمایشت خوبه"
    },
    {
      "id": 22,
      "start": 3984.04,
      "end": 3986.14,
      "formatted_start": "01:06:24.040",
      "formatted_end": "01:06:26.140",
      "text": "شروع میکنه به خوردن آزاد"
    },
    {
      "id": 23,
      "start": 3986.14,
      "end": 3988.9,
      "formatted_start": "01:06:26.140",
      "formatted_end": "01:06:28.900",
      "text": "یعنی از ده اینش دیگه خلاص میشه"
    },
    {
      "id": 24,
      "start": 3988.9,
      "end": 3992.06,
      "formatted_start": "01:06:28.900",
      "formatted_end": "01:06:32.060",
      "text": "میگه باید دیگه خوبم دیگه آزمایشم خوب بوده راحت بخورم"
    },
    {
      "id": 25,
      "start": 3992.06,
      "end": 3994.96,
      "formatted_start": "01:06:32.060",
      "formatted_end": "01:06:34.960",
      "text": "از همون روز این خوردن آزاد میشه"
    },
    {
      "id": 26,
      "start": 3994.96,
      "end": 3996.38,
      "formatted_start": "01:06:34.960",
      "formatted_end": "01:06:36.380",
      "text": "خوردنت محدود کن"
    },
    {
      "id": 27,
      "start": 3996.38,
      "end": 3999.22,
      "formatted_start": "01:06:36.380",
      "formatted_end": "01:06:39.220",
      "text": "مواد چربی اکیدن نخور"
    },
    {
      "id": 28,
      "start": 3999.22,
      "end": 4001.84,
      "formatted_start": "01:06:39.220",
      "formatted_end": "01:06:41.840",
      "text": "قضایی که مثلا چربی داشته باشه"
    },
    {
      "id": 29,
      "start": 4001.84,
      "end": 4002.88,
      "formatted_start": "01:06:41.840",
      "formatted_end": "01:06:42.880",
      "text": "نه پرچند باشه"
    },
    {
      "id": 30,
      "start": 4002.88,
      "end": 4005.38,
      "formatted_start": "01:06:42.880",
      "formatted_end": "01:06:45.380",
      "text": "اصلا چربی داشت میشه، پشارتو بگیرم"
    },
    {
      "id": 31,
      "start": 4006.8,
      "end": 4010.7,
      "formatted_start": "01:06:46.800",
      "formatted_end": "01:06:50.700",
      "text": "این سنگی سر مربوط به سرت نیست"
    },
    {
      "id": 32,
      "start": 4010.7,
      "end": 4017.18,
      "formatted_start": "01:06:50.700",
      "formatted_end": "01:06:57.180",
      "text": "مربوط به کبد و ارز کنند که متابولیس داخلیت است"
    },
    {
      "id": 33,
      "start": 4017.18,
      "end": 4021.1,
      "formatted_start": "01:06:57.180",
      "formatted_end": "01:07:01.100",
      "text": "اصلا اون قضیه سنگی چه سرگینی نداره"
    },
    {
      "id": 34,
      "start": 4021.1,
      "end": 4021.9,
      "formatted_start": "01:07:01.100",
      "formatted_end": "01:07:01.900",
      "text": "اون یا فرانی نداره"
    },
    {
      "id": 35,
      "start": 4021.9,
      "end": 4023.86,
      "formatted_start": "01:07:01.900",
      "formatted_end": "01:07:03.860",
      "text": "خیلی داروش یه ذره سنگی می کنه"
    },
    {
      "id": 36,
      "start": 4023.86,
      "end": 4027.16,
      "formatted_start": "01:07:03.860",
      "formatted_end": "01:07:07.160",
      "text": "اما مثلا صبح یه مقدار بیدار میشی اون مال سینارسینه"
    },
    {
      "id": 37,
      "start": 4027.16,
      "end": 4030.08,
      "formatted_start": "01:07:07.160",
      "formatted_end": "01:07:10.080",
      "text": "از این سینارسینه باید بردش میکنیم"
    },
    {
      "id": 38,
      "start": 4032.88,
      "end": 4036.88,
      "formatted_start": "01:07:12.880",
      "formatted_end": "01:07:16.880",
      "text": "سینه رو سینه 25 رو به شب میخورید"
    },
    {
      "id": 39,
      "start": 4036.88,
      "end": 4039.88,
      "formatted_start": "01:07:16.880",
      "formatted_end": "01:07:19.880",
      "text": "قردش کن سنگینه صبح خوب میشه"
    },
    {
      "id": 40,
      "start": 4039.88,
      "end": 4044.88,
      "formatted_start": "01:07:19.880",
      "formatted_end": "01:07:24.880",
      "text": "سنگینه بعد از نهای مال قضای آزادیه که بیخورید"
    },
    {
      "id": 41,
      "start": 4044.88,
      "end": 4048.88,
      "formatted_start": "01:07:24.880",
      "formatted_end": "01:07:28.880",
      "text": "یعنی بعد از آسماش یه پدیده و میخسیش"
    },
    {
      "id": 42,
      "start": 4048.88,
      "end": 4049.88,
      "formatted_start": "01:07:28.880",
      "formatted_end": "01:07:29.880",
      "text": "همه افکاری"
    },
    {
      "id": 43,
      "start": 4049.88,
      "end": 4051.88,
      "formatted_start": "01:07:29.880",
      "formatted_end": "01:07:31.880",
      "text": "این الان نزدیک یک ماه همون میگه ما"
    },
    {
      "id": 44,
      "start": 4051.88,
      "end": 4052.88,
      "formatted_start": "01:07:31.880",
      "formatted_end": "01:07:32.880",
      "text": "بله"
    },
    {
      "id": 45,
      "start": 4052.88,
      "end": 4054.88,
      "formatted_start": "01:07:32.880",
      "formatted_end": "01:07:34.880",
      "text": "از همون که گفتن که مای گوشتی پا مال ده"
    },
    {
      "id": 46,
      "start": 4054.88,
      "end": 4056.88,
      "formatted_start": "01:07:34.880",
      "formatted_end": "01:07:36.880",
      "text": "من یه گوده هستم اون ضربه پیش خواهد تنگه"
    },
    {
      "id": 47,
      "start": 4056.88,
      "end": 4057.88,
      "formatted_start": "01:07:36.880",
      "formatted_end": "01:07:37.880",
      "text": "من خیلی بهترم"
    },
    {
      "id": 48,
      "start": 4057.88,
      "end": 4060.88,
      "formatted_start": "01:07:37.880",
      "formatted_end": "01:07:40.880",
      "text": "اصلا هی این ضربه ذهنتو شاید کن"
    },
    {
      "id": 49,
      "start": 4060.88,
      "end": 4066.88,
      "formatted_start": "01:07:40.880",
      "formatted_end": "01:07:46.880",
      "text": "اون مایه گوش پلم بر طرفه ورزشت ادامه بده که تکرار نشه"
    },
    {
      "id": 50,
      "start": 4066.88,
      "end": 4070.88,
      "formatted_start": "01:07:46.880",
      "formatted_end": "01:07:50.880",
      "text": "این سنگینه سرتو منگید با دارو خوب میشه"
    },
    {
      "id": 51,
      "start": 4070.88,
      "end": 4074.88,
      "formatted_start": "01:07:50.880",
      "formatted_end": "01:07:54.880",
      "text": "این ارتباطش با گوشه درسته همزمان شده"
    },
    {
      "id": 52,
      "start": 4074.88,
      "end": 4077.88,
      "formatted_start": "01:07:54.880",
      "formatted_end": "01:07:57.880",
      "text": "هر دوی اینها با چرمی گفتیم سه تا چیز دیگه"
    },
    {
      "id": 53,
      "start": 4077.88,
      "end": 4082.88,
      "formatted_start": "01:07:57.880",
      "formatted_end": "01:08:02.880",
      "text": "لبلیات، آجی، غذای چرم درسته؟"
    },
    {
      "id": 54,
      "start": 4082.88,
      "end": 4086.88,
      "formatted_start": "01:08:02.880",
      "formatted_end": "01:08:06.880",
      "text": "حالا یه چیزی تو رو شجاع کرده در غذا خوردن"
    },
    {
      "id": 55,
      "start": 4086.88,
      "end": 4092.88,
      "formatted_start": "01:08:06.880",
      "formatted_end": "01:08:12.880",
      "text": "آزمایش خوب، آزمایش دارید خوب بوده از برداشت شما راحت تر غذا کرده"
    },
    {
      "id": 56,
      "start": 4092.88,
      "end": 4096.88,
      "formatted_start": "01:08:12.880",
      "formatted_end": "01:08:16.880",
      "text": "دیگه گفتیم شما که خوب بوده، راحت بخورم"
    },
    {
      "id": 57,
      "start": 4096.88,
      "end": 4102.88,
      "formatted_start": "01:08:16.880",
      "formatted_end": "01:08:22.880",
      "text": "این راحت بخورم شما رو به سنگینی بیشتر سر مختلا کرده"
    },
    {
      "id": 58,
      "start": 4102.88,
      "end": 4107.88,
      "formatted_start": "01:08:22.880",
      "formatted_end": "01:08:27.880",
      "text": "سرگیجه هم همراه بوده، سرگیجه به برداشتیم، این سنگینی، این سر رو"
    },
    {
      "id": 59,
      "start": 4107.88,
      "end": 4113.88,
      "formatted_start": "01:08:27.880",
      "formatted_end": "01:08:33.880",
      "text": "یه مقداری تو غذا امساق بکن، غذایی سبکتر، مثلا زور به نان و هندونه بکن"
    },
    {
      "id": 60,
      "start": 4113.88,
      "end": 4119.88,
      "formatted_start": "01:08:33.880",
      "formatted_end": "01:08:39.880",
      "text": "نیشش کاری نداره، لازم میست که مثلا چون رو خورشت بخوری اینقدر بادنجار رو خوری کن"
    },
    {
      "id": 61,
      "start": 4119.88,
      "end": 4122.88,
      "formatted_start": "01:08:39.880",
      "formatted_end": "01:08:42.880",
      "text": "غذا هر چه سبک بخوری سبکتر پایی بود"
    },
    {
      "id": 62,
      "start": 4122.88,
      "end": 4129.88,
      "formatted_start": "01:08:42.880",
      "formatted_end": "01:08:49.880",
      "text": "به اضافه یه چند قدم دارو بگیرم که سر سبکتر رو از این سنگینی منگی خلاص میشه"
    },
    {
      "id": 63,
      "start": 4129.88,
      "end": 4132.88,
      "formatted_start": "01:08:49.880",
      "formatted_end": "01:08:52.880",
      "text": "حتی شما... سیجاری زین رو هم حضر کنیدم جدا"
    },
    {
      "id": 64,
      "start": 4132.88,
      "end": 4135.88,
      "formatted_start": "01:08:52.880",
      "formatted_end": "01:08:55.880",
      "text": "آره سیجاری زین رو برای سر کام من خیلی تزکم"
    },
    {
      "id": 65,
      "start": 4135.88,
      "end": 4136.88,
      "formatted_start": "01:08:55.880",
      "formatted_end": "01:08:56.880",
      "text": "خواهد تو عالی"
    },
    {
      "id": 66,
      "start": 4136.88,
      "end": 4138.88,
      "formatted_start": "01:08:56.880",
      "formatted_end": "01:08:58.880",
      "text": "کمپاک بودم با هر خوب شده بودم"
    },
    {
      "id": 67,
      "start": 4138.88,
      "end": 4143.88,
      "formatted_start": "01:08:58.880",
      "formatted_end": "01:09:03.880",
      "text": "بله، بگی صبح یکم سنگیرم بگم، آیا میخوایی نستش بگم؟"
    },
    {
      "id": 68,
      "start": 4143.88,
      "end": 4155.88,
      "formatted_start": "01:09:03.880",
      "formatted_end": "01:09:15.880",
      "text": "صبح نیست، صبح اون سنگیری و اون بعد از اون، مثلا الان بگیم الان اینجا هست سر، فراد همینجا، احساس کنید اونجا سر هست سنگیر، یا بعضی ما همون اینجا هستش آمده، دیگه؟"
    },
    {
      "id": 69,
      "start": 4155.88,
      "end": 4161.88,
      "formatted_start": "01:09:15.880",
      "formatted_end": "01:09:21.880",
      "text": "اون سرگجه نیست، حالا سینارزین اگه میبینیم بساییم برای خوابتونو نصف کنیم"
    },
    {
      "id": 70,
      "start": 4161.88,
      "end": 4165.88,
      "formatted_start": "01:09:21.880",
      "formatted_end": "01:09:25.880",
      "text": "سینارزینو نصف کنیم، ولی اثر داروی اونقدر نیست، اون فقط صبح هنگامیه"
    },
    {
      "id": 71,
      "start": 4165.88,
      "end": 4170.88,
      "formatted_start": "01:09:25.880",
      "formatted_end": "01:09:30.880",
      "text": "بقیه اش موانه متابوریسم چربیه و قندتو بدنید"
    },
    {
      "id": 72,
      "start": 4170.88,
      "end": 4174.88,
      "formatted_start": "01:09:30.880",
      "formatted_end": "01:09:34.880",
      "text": "که اینجوری تو رو باید چند تقرار اندازه بگیرم"
    },
    {
      "id": 73,
      "start": 4174.88,
      "end": 4178.88,
      "formatted_start": "01:09:34.880",
      "formatted_end": "01:09:38.880",
      "text": "خانم بارانی بیا قند آقای گستاریانو بگیر"
    },
    {
      "id": 74,
      "start": 4178.88,
      "end": 4194.5,
      "formatted_start": "01:09:38.880",
      "formatted_end": "01:09:54.500",
      "text": "مانیازی هم دارد"
    },
    {
      "id": 75,
      "start": 4194.5,
      "end": 4196.72,
      "formatted_start": "01:09:54.500",
      "formatted_end": "01:09:56.720",
      "text": "با بایش"
    },
    {
      "id": 76,
      "start": 4196.72,
      "end": 4198.4,
      "formatted_start": "01:09:56.720",
      "formatted_end": "01:09:58.400",
      "text": "بیتامو دیگه"
    }
  ],
  "status": "completed"
}