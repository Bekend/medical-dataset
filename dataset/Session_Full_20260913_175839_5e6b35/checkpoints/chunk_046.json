  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13818.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:18.000",
      "text": "ده روز بعد از پایان آدت بیاد، شهر باشو دوباره بگید، یه دارو دیده که دوباره به سرمنش میشید."
    },
    {
      "id": 1,
      "start": 13818.0,
      "end": 13820.0,
      "formatted_start": "03:50:18.000",
      "formatted_end": "03:50:20.000",
      "text": "بشه باشه"
    },
    {
      "id": 2,
      "start": 13820.0,
      "end": 13822.0,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:22.000",
      "text": "خوش داشته باشه"
    },
    {
      "id": 3,
      "start": 13822.0,
      "end": 13824.0,
      "formatted_start": "03:50:22.000",
      "formatted_end": "03:50:24.000",
      "text": "مبارک داشته"
    },
    {
      "id": 4,
      "start": 13824.0,
      "end": 13826.0,
      "formatted_start": "03:50:24.000",
      "formatted_end": "03:50:26.000",
      "text": "چه نارتی داری خواند؟"
    },
    {
      "id": 5,
      "start": 13826.0,
      "end": 13828.0,
      "formatted_start": "03:50:26.000",
      "formatted_end": "03:50:28.000",
      "text": "سرمون خوردم"
    },
    {
      "id": 6,
      "start": 13828.0,
      "end": 13830.0,
      "formatted_start": "03:50:28.000",
      "formatted_end": "03:50:30.000",
      "text": "چند روز سرمون خوردی؟"
    },
    {
      "id": 7,
      "start": 13830.0,
      "end": 13832.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:32.000",
      "text": "درخواهان رو باز کن خواند"
    },
    {
      "id": 8,
      "start": 13832.0,
      "end": 13834.0,
      "formatted_start": "03:50:32.000",
      "formatted_end": "03:50:34.000",
      "text": "سرمون رو بگیریم"
    },
    {
      "id": 9,
      "start": 13834.0,
      "end": 13836.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:36.000",
      "text": "منجوریم از این آنکولانز های"
    },
    {
      "id": 10,
      "start": 13836.0,
      "end": 13838.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:38.000",
      "text": "ماسک میزنیم"
    },
    {
      "id": 11,
      "start": 13838.0,
      "end": 13840.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:40.000",
      "text": "باید ماسک بزنیم به بچه اطرافیان"
    },
    {
      "id": 12,
      "start": 13840.0,
      "end": 13842.0,
      "formatted_start": "03:50:40.000",
      "formatted_end": "03:50:42.000",
      "text": "به سمت چند"
    },
    {
      "id": 13,
      "start": 13842.0,
      "end": 13844.0,
      "formatted_start": "03:50:42.000",
      "formatted_end": "03:50:44.000",
      "text": "یک صورتر بزن خواهید"
    },
    {
      "id": 14,
      "start": 13844.0,
      "end": 13846.0,
      "formatted_start": "03:50:44.000",
      "formatted_end": "03:50:46.000",
      "text": "گلو تا این زرخ میشه"
    },
    {
      "id": 15,
      "start": 13846.0,
      "end": 13848.0,
      "formatted_start": "03:50:46.000",
      "formatted_end": "03:50:48.000",
      "text": "از این زیر بزنید."
    },
    {
      "id": 16,
      "start": 13848.0,
      "end": 13850.0,
      "formatted_start": "03:50:48.000",
      "formatted_end": "03:50:50.000",
      "text": "از این زیر بزنید."
    },
    {
      "id": 17,
      "start": 13850.0,
      "end": 13852.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:50:52.000",
      "text": "از این زیر بزنید."
    },
    {
      "id": 18,
      "start": 13852.0,
      "end": 13854.0,
      "formatted_start": "03:50:52.000",
      "formatted_end": "03:50:54.000",
      "text": "از این زیر بزنید."
    },
    {
      "id": 19,
      "start": 13854.0,
      "end": 13856.0,
      "formatted_start": "03:50:54.000",
      "formatted_end": "03:50:56.000",
      "text": "از این زیر بزنید."
    },
    {
      "id": 20,
      "start": 13856.0,
      "end": 13858.0,
      "formatted_start": "03:50:56.000",
      "formatted_end": "03:50:58.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 21,
      "start": 13858.0,
      "end": 13860.0,
      "formatted_start": "03:50:58.000",
      "formatted_end": "03:51:00.000",
