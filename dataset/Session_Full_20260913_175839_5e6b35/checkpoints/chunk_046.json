    },
    {
      "id": 22,
      "start": 13860.0,
      "end": 13862.0,
      "formatted_start": "03:51:00.000",
      "formatted_end": "03:51:02.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 23,
      "start": 13862.0,
      "end": 13864.0,
      "formatted_start": "03:51:02.000",
      "formatted_end": "03:51:04.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 24,
      "start": 13864.0,
      "end": 13866.0,
      "formatted_start": "03:51:04.000",
      "formatted_end": "03:51:06.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 25,
      "start": 13866.0,
      "end": 13868.0,
      "formatted_start": "03:51:06.000",
      "formatted_end": "03:51:08.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 26,
      "start": 13868.0,
      "end": 13870.0,
      "formatted_start": "03:51:08.000",
      "formatted_end": "03:51:10.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 27,
      "start": 13870.0,
      "end": 13872.0,
      "formatted_start": "03:51:10.000",
      "formatted_end": "03:51:12.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 28,
      "start": 13872.0,
      "end": 13874.0,
      "formatted_start": "03:51:12.000",
      "formatted_end": "03:51:14.000",
      "text": "مشکلات ادرادی،"
    },
    {
      "id": 29,
      "start": 13874.0,
      "end": 13879.0,
      "formatted_start": "03:51:14.000",
      "formatted_end": "03:51:19.000",
      "text": "اینجایی فرقی پرداره جای کشورها در پیشوکترولیکه"
    },
    {
      "id": 30,
      "start": 13879.0,
      "end": 13882.0,
      "formatted_start": "03:51:19.000",
      "formatted_end": "03:51:22.000",
      "text": "از اون زر ساله برم"
    },
    {
      "id": 31,
      "start": 13890.0,
      "end": 13893.0,
      "formatted_start": "03:51:30.000",
      "formatted_end": "03:51:33.000",
      "text": "احتمال داره نوزادو همه جای کنه؟"
    },
    {
      "id": 32,
      "start": 13893.0,
      "end": 13898.0,
      "formatted_start": "03:51:33.000",
      "formatted_end": "03:51:38.000",
      "text": "نه، شیر مادر بخوره کمتر، بهتره که شیر مادر بخوره"
    },
    {
      "id": 33,
      "start": 13904.0,
      "end": 13912.0,
      "formatted_start": "03:51:44.000",
      "formatted_end": "03:51:52.000",
      "text": "مکیدنی"
    },
    {
      "id": 34,
      "start": 13912.0,
      "end": 13918.0,
      "formatted_start": "03:51:52.000",
      "formatted_end": "03:51:58.000",
      "text": "شکلاته"
    },
    {
      "id": 35,
      "start": 13918.0,
      "end": 13922.0,
      "formatted_start": "03:51:58.000",
      "formatted_end": "03:52:02.000",
      "text": "مکیدنی"
    },
    {
      "id": 36,
      "start": 13922.0,
      "end": 13928.0,
      "formatted_start": "03:52:02.000",
      "formatted_end": "03:52:08.000",
      "text": "شکلاته"
    },
    {
      "id": 37,
      "start": 13928.0,
      "end": 13937.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:17.000",
      "text": "خانم مغرب شما باردی کنید؟"
    },
    {
      "id": 38,
      "start": 13937.0,
      "end": 13938.0,
      "formatted_start": "03:52:17.000",
      "formatted_end": "03:52:18.000",
      "text": "برم برم"
    },
    {
      "id": 39,
      "start": 13938.0,
      "end": 13941.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:21.000",
      "text": "چرا باز کنید؟ رفته چیز کنه؟"
    },
    {
      "id": 40,
      "start": 13941.0,
      "end": 13942.0,
      "formatted_start": "03:52:21.000",
      "formatted_end": "03:52:22.000",
      "text": "آره، آنها مردم"
    },
    {
      "id": 41,
      "start": 13942.0,
      "end": 13944.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:24.000",
      "text": "آره، یه مردم"
    },
    {
      "id": 42,
      "start": 13944.0,
      "end": 13948.0,
      "formatted_start": "03:52:24.000",
      "formatted_end": "03:52:28.000",
      "text": "درست شد، مرسی، این دستره که باردی"
    },
    {
      "id": 43,
      "start": 13948.0,
      "end": 13950.0,
      "formatted_start": "03:52:28.000",
      "formatted_end": "03:52:30.000",
      "text": "این شما برم"
    },
    {
      "id": 44,
      "start": 13950.0,
      "end": 13951.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:31.000",
      "text": "برم"
    },
    {
      "id": 45,
      "start": 13951.0,
      "end": 13952.0,
      "formatted_start": "03:52:31.000",
      "formatted_end": "03:52:32.000",
      "text": "برم"
    },
    {
      "id": 46,
      "start": 13952.0,
