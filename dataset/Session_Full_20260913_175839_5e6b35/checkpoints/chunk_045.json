    {
      "id": 19,
      "start": 13572.0,
      "end": 13574.0,
      "formatted_start": "03:46:12.000",
      "formatted_end": "03:46:14.000",
      "text": "ممنون"
    },
    {
      "id": 20,
      "start": 13574.0,
      "end": 13576.0,
      "formatted_start": "03:46:14.000",
      "formatted_end": "03:46:16.000",
      "text": "بابا شان ده روز برداشت"
    },
    {
      "id": 21,
      "start": 13576.0,
      "end": 13578.0,
      "formatted_start": "03:46:16.000",
      "formatted_end": "03:46:18.000",
      "text": "بله، از مثل مشاهدتون خیلی باشه"
    },
    {
      "id": 22,
      "start": 13578.0,
      "end": 13580.0,
      "formatted_start": "03:46:18.000",
      "formatted_end": "03:46:20.000",
      "text": "نمیشه"
    },
    {
      "id": 23,
      "start": 13580.0,
      "end": 13582.0,
      "formatted_start": "03:46:20.000",
      "formatted_end": "03:46:22.000",
      "text": "قندتون 104 بوده"
    },
    {
      "id": 24,
      "start": 13582.0,
      "end": 13584.0,
      "formatted_start": "03:46:22.000",
      "formatted_end": "03:46:24.000",
      "text": "بیرون رو بینتون بالا"
    },
    {
      "id": 25,
      "start": 13584.0,
      "end": 13586.0,
      "formatted_start": "03:46:24.000",
      "formatted_end": "03:46:26.000",
      "text": "قندم برای بابا هست"
    },
    {
      "id": 26,
      "start": 13586.0,
      "end": 13588.0,
      "formatted_start": "03:46:26.000",
      "formatted_end": "03:46:28.000",
      "text": "هم قندکی شروع شده بودی"
    },
    {
      "id": 27,
      "start": 13588.0,
      "end": 13590.0,
      "formatted_start": "03:46:28.000",
      "formatted_end": "03:46:30.000",
      "text": "مامان جنان قند داشتن؟"
    },
    {
      "id": 28,
      "start": 13590.0,
      "end": 13592.0,
      "formatted_start": "03:46:30.000",
      "formatted_end": "03:46:32.000",
      "text": "جان؟ مامانت قند داشت؟"
    },
    {
      "id": 29,
      "start": 13592.0,
      "end": 13594.0,
      "formatted_start": "03:46:32.000",
      "formatted_end": "03:46:34.000",
      "text": "نه، نه، نه، نه"
    },
    {
      "id": 30,
      "start": 13594.0,
      "end": 13596.0,
      "formatted_start": "03:46:34.000",
      "formatted_end": "03:46:36.000",
      "text": "بله، بابا رو رفتاره بود، پدرم"
    },
    {
      "id": 31,
      "start": 13596.0,
      "end": 13598.0,
      "formatted_start": "03:46:36.000",
      "formatted_end": "03:46:38.000",
      "text": "پدری، امه هایی هم قندی هست"
    },
    {
      "id": 32,
      "start": 13598.0,
      "end": 13600.0,
      "formatted_start": "03:46:38.000",
      "formatted_end": "03:46:40.000",
      "text": "مامان قنده هایی ها رفتاره بود"
    },
    {
      "id": 33,
      "start": 13600.0,
      "end": 13630.0,
      "formatted_start": "03:46:40.000",
      "formatted_end": "03:47:10.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 34,
      "start": 13630.0,
      "end": 13635.0,
      "formatted_start": "03:47:10.000",
      "formatted_end": "03:47:15.000",
      "text": "اینجا باید سرم. سهرگی می بودم همجوری فقط چشم بسته می شوند و می خواهیدم فقط."
    },
    {
      "id": 35,
      "start": 13635.0,
      "end": 13636.0,
      "formatted_start": "03:47:15.000",
      "formatted_end": "03:47:16.000",
      "text": "بله؟"
    },
    {
      "id": 36,
      "start": 13636.0,
      "end": 13639.0,
      "formatted_start": "03:47:16.000",
      "formatted_end": "03:47:19.000",
      "text": "بعد خیلی چیز بودم. خودم شکر کرده بودم."
    },
    {
      "id": 37,
      "start": 13639.0,
      "end": 13640.0,
      "formatted_start": "03:47:19.000",
      "formatted_end": "03:47:20.000",
      "text": "خیلی؟"
    },
    {
      "id": 38,
      "start": 13640.0,
      "end": 13641.0,
      "formatted_start": "03:47:20.000",
      "formatted_end": "03:47:21.000",
      "text": "همچنان به خاطر چشم بودم."
    },
    {
      "id": 39,
      "start": 13641.0,
      "end": 13648.0,
      "formatted_start": "03:47:21.000",
      "formatted_end": "03:47:28.000",
      "text": "نمی کنید کلیمونی میتونم شلطه خوردی همچیزها مواد شیرینی و نشسته ها."
    },
    {
      "id": 40,
      "start": 13648.0,
      "end": 13649.0,
      "formatted_start": "03:47:28.000",
      "formatted_end": "03:47:29.000",
      "text": "نمی کنید."
    },
    {
      "id": 41,
      "start": 13649.0,
      "end": 13651.0,
      "formatted_start": "03:47:29.000",
      "formatted_end": "03:47:31.000",
      "text": "این فقط غن نیست."
    },
    {
      "id": 42,
      "start": 13651.0,
      "end": 13654.0,
      "formatted_start": "03:47:31.000",
      "formatted_end": "03:47:34.000",
      "text": "می پوستی؟ برنج هم کم کنید."
    },
    {
      "id": 43,
      "start": 13654.0,
      "end": 13655.0,
      "formatted_start": "03:47:34.000",
      "formatted_end": "03:47:35.000",
      "text": "نه برنج هم کم کنید."
    },
    {
      "id": 44,
      "start": 13655.0,
      "end": 13662.0,
      "formatted_start": "03:47:35.000",
      "formatted_end": "03:47:42.000",
      "text": "باشه باشه بیا هست بخوریتن اصلا یه دفعه بیان برش نخوری سرچ کنی میشن"
    },
    {
      "id": 45,
      "start": 13662.0,
      "end": 13672.0,
      "formatted_start": "03:47:42.000",
      "formatted_end": "03:47:52.000",
      "text": "کم کنی اصلا نشاسته بار نشاسته ای کم باشه ورسش بیاده روی داشته باشی کم هم دروار"
    },
    {
      "id": 46,
      "start": 13672.0,
      "end": 13675.0,
      "formatted_start": "03:47:52.000",
      "formatted_end": "03:47:55.000",
      "text": "که برش نشاسته بیاده روی داشته باشی"
    },
    {
      "id": 47,
      "start": 13675.0,
      "end": 13676.0,
      "formatted_start": "03:47:55.000",
      "formatted_end": "03:47:56.000",
      "text": "پشار آن رو بگیرم؟"
    },
    {
      "id": 48,
      "start": 13676.0,
      "end": 13678.0,
      "formatted_start": "03:47:56.000",
      "formatted_end": "03:47:58.000",
      "text": "برش نشاسته هونیت"
    },
    {
      "id": 49,
      "start": 13678.0,
      "end": 13679.0,
      "formatted_start": "03:47:58.000",
      "formatted_end": "03:47:59.000",
      "text": "یازده هونیت"
    },
    {
      "id": 50,
      "start": 13679.0,
      "end": 13709.0,
      "formatted_start": "03:47:59.000",
      "formatted_end": "03:48:29.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 51,
      "start": 13709.0,
      "end": 13712.66,
      "formatted_start": "03:48:29.000",
      "formatted_end": "03:48:32.660",
      "text": "ایروتول و آیروتول برای بعضی باربایی ما اومد جایید"
    },
    {
      "id": 52,
      "start": 13712.66,
      "end": 13714.46,
      "formatted_start": "03:48:32.660",
      "formatted_end": "03:48:34.460",
      "text": "نشوند کنند"
    },
    {
      "id": 53,
      "start": 13714.46,
      "end": 13717.34,
      "formatted_start": "03:48:34.460",
      "formatted_end": "03:48:37.340",
      "text": "حالا سلامتیت مهمی کرده دیگه"
    },
    {
      "id": 54,
      "start": 13717.34,
      "end": 13719.34,
      "formatted_start": "03:48:37.340",
      "formatted_end": "03:48:39.340",
      "text": "اینجا نفر باید سالمی باشید"
    },
    {
      "id": 55,
      "start": 13719.34,
      "end": 13720.34,
      "formatted_start": "03:48:39.340",
      "formatted_end": "03:48:40.340",
      "text": "بیایید"
    },
    {
      "id": 56,
      "start": 13720.34,
      "end": 13722.34,
      "formatted_start": "03:48:40.340",
      "formatted_end": "03:48:42.340",
      "text": "این درواره گرفتیم"
    },
    {
      "id": 57,
      "start": 13722.34,
      "end": 13723.7,
      "formatted_start": "03:48:42.340",
      "formatted_end": "03:48:43.700",
      "text": "بیایید درواره نشوندیم"
    },
    {
      "id": 58,
      "start": 13723.7,
      "end": 13730.8,
      "formatted_start": "03:48:43.700",
      "formatted_end": "03:48:50.800",
      "text": "برای کیل ایسپرمیان"
    },
    {
      "id": 59,
      "start": 13730.8,
      "end": 13732.6,
      "formatted_start": "03:48:50.800",
      "formatted_end": "03:48:52.600",
      "text": "آی سی و یک درصد"
    },
    {
      "id": 60,
      "start": 13732.6,
      "end": 13733.24,
      "formatted_start": "03:48:52.600",
      "formatted_end": "03:48:53.240",
      "text": "اشکال دارید"
    },
    {
      "id": 61,
      "start": 13733.24,
      "end": 13736.54,
      "formatted_start": "03:48:53.240",
      "formatted_end": "03:48:56.540",
      "text": "باریکوسه درماش کرده"
    },
    {
      "id": 62,
      "start": 13736.54,
      "end": 13740.54,
      "formatted_start": "03:48:56.540",
      "formatted_end": "03:49:00.540",
      "text": "اشکال شکلندگی شلیدیک اسپرد هست."
    },
    {
      "id": 63,
      "start": 13740.54,
      "end": 13742.54,
      "formatted_start": "03:49:00.540",
      "formatted_end": "03:49:02.540",
      "text": "۸۵ ۱۰ اشکاله."
    },
    {
      "id": 64,
      "start": 13742.54,
      "end": 13744.54,
      "formatted_start": "03:49:02.540",
      "formatted_end": "03:49:04.540",
      "text": "باید درباره طولانی مدت شده."
    },
    {
      "id": 65,
      "start": 13744.54,
      "end": 13746.54,
      "formatted_start": "03:49:04.540",
      "formatted_end": "03:49:06.540",
      "text": "دکتورش کیه اینشون؟"
    },
    {
      "id": 66,
      "start": 13746.54,
      "end": 13748.54,
      "formatted_start": "03:49:06.540",
      "formatted_end": "03:49:08.540",
      "text": "زنگتان برگان و موازن موردان."
    },
    {
      "id": 67,
      "start": 13748.54,
      "end": 13750.54,
      "formatted_start": "03:49:08.540",
      "formatted_end": "03:49:10.540",
      "text": "خیلی دکتور خوبیه. بله."
    },
    {
      "id": 68,
      "start": 13750.54,
      "end": 13752.54,
      "formatted_start": "03:49:10.540",
      "formatted_end": "03:49:12.540",
      "text": "بس این همه آیویف جواب میده بس این همشون."
    },
    {
      "id": 69,
      "start": 13752.54,
      "end": 13754.54,
      "formatted_start": "03:49:12.540",
      "formatted_end": "03:49:14.540",
      "text": "آیویف جواب میده اشون."
    },
    {
      "id": 70,
      "start": 13754.54,
      "end": 13758.54,
      "formatted_start": "03:49:14.540",
      "formatted_end": "03:49:18.540",
      "text": "بس شما دکتورش بسیار خوبیه."
    },
    {
      "id": 71,
      "start": 13758.54,
      "end": 13760.54,
      "formatted_start": "03:49:18.540",
      "formatted_end": "03:49:20.540",
      "text": "بفرما."
    },
    {
      "id": 72,
      "start": 13760.54,
      "end": 13762.54,
      "formatted_start": "03:49:20.540",
      "formatted_end": "03:49:22.540",
      "text": "بفرما."
    },
    {
      "id": 73,
      "start": 13762.54,
      "end": 13764.54,
      "formatted_start": "03:49:22.540",
      "formatted_end": "03:49:24.540",
      "text": "بفرما."
    },
    {
      "id": 74,
      "start": 13764.54,
      "end": 13776.94,
      "formatted_start": "03:49:24.540",
      "formatted_end": "03:49:36.940",
      "text": "این هرزی رو با سفر کاروران به شما خود مجاز کشید"
    },
    {
      "id": 75,
      "start": 13776.94,
      "end": 13781.5,
      "formatted_start": "03:49:36.940",
      "formatted_end": "03:49:41.500",
      "text": "بعدش قرصه رو که خورده تموم شده میگو"
    },
    {
      "id": 76,
      "start": 13781.5,
      "end": 13783.96,
      "formatted_start": "03:49:41.500",
      "formatted_end": "03:49:43.960",
      "text": "حالا یه سه چهار روزی آره میگو"
    },
    {
      "id": 77,
      "start": 13783.96,
      "end": 13786.82,
      "formatted_start": "03:49:43.960",
      "formatted_end": "03:49:46.820",
      "text": "برون شدن این سری با خاطر این قرصه که خورم"
    },
    {
      "id": 78,
      "start": 13786.82,
      "end": 13788.18,
      "formatted_start": "03:49:46.820",
      "formatted_end": "03:49:48.180",
      "text": "خیلی خونزه شده"
    },
    {
      "id": 79,
      "start": 13788.18,
      "end": 13790.84,
      "formatted_start": "03:49:48.180",
      "formatted_end": "03:49:50.840",
      "text": "و خیلی هم تیره"
    },
    {
      "id": 80,
      "start": 13790.84,
      "end": 13797.84,
      "formatted_start": "03:49:50.840",
      "formatted_end": "03:49:57.840",
      "text": "و اینکه تا قبل از این حاله خود آورش میگفت، خود بود و منظر نبود، الان هیچ کار بکنم."
    },
    {
      "id": 81,
      "start": 13797.84,
      "end": 13798.84,
      "formatted_start": "03:49:57.840",
      "formatted_end": "03:49:58.840",
      "text": "چی؟"
    },
    {
      "id": 82,
      "start": 13798.84,
      "end": 13799.84,
      "formatted_start": "03:49:58.840",
      "formatted_end": "03:49:59.840",
      "text": "باید برای پشت کنم."
    }
  ],
  "status": "completed"
}