  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13508.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:08.000",
      "text": "اونا این کشتگردم اونو که از پاس ها رو میگفت، آنکه آفتاب سختگیه، بلیس صورت اونو نزدیک دو ماه اینجا میشه."
    },
    {
      "id": 1,
      "start": 13508.0,
      "end": 13528.0,
      "formatted_start": "03:45:08.000",
      "formatted_end": "03:45:28.000",
      "text": "درست کن مهدن، اون جاز بشه، اون کار رو آب کلید شده، بگیرید ترشن بکنیم، مجاز آب نمی آرست"
    },
    {
      "id": 2,
      "start": 13528.0,
      "end": 13535.0,
      "formatted_start": "03:45:28.000",
      "formatted_end": "03:45:35.000",
      "text": "باید این دو رو ببینیم، اون رو جاز بشه، بعد کلر رو خاموش بکنیم که یک چیز، بعد مجرم برداشت شده"
    },
    {
      "id": 3,
      "start": 13535.0,
      "end": 13540.0,
      "formatted_start": "03:45:35.000",
      "formatted_end": "03:45:40.000",
      "text": "همونی بسه، همونی گردید، قبل از اون باید خیلی برداشت بکنیم که جاز بشه"
    },
    {
      "id": 4,
      "start": 13540.0,
      "end": 13543.0,
      "formatted_start": "03:45:40.000",
      "formatted_end": "03:45:43.000",
      "text": "تا دو تومیشت، برای موضوعش کامل هم نمیدونی"
    },
    {
      "id": 5,
      "start": 13543.0,
      "end": 13544.0,
      "formatted_start": "03:45:43.000",
      "formatted_end": "03:45:44.000",
      "text": "بله"
    },
    {
      "id": 6,
      "start": 13547.0,
      "end": 13548.0,
      "formatted_start": "03:45:47.000",
      "formatted_end": "03:45:48.000",
      "text": "برداشتش رو بگیریم"
    },
    {
      "id": 7,
      "start": 13548.0,
      "end": 13550.0,
      "formatted_start": "03:45:48.000",
      "formatted_end": "03:45:50.000",
      "text": "برداشتشم میگیرم"
    },
    {
      "id": 8,
      "start": 13550.0,
      "end": 13552.0,
      "formatted_start": "03:45:50.000",
      "formatted_end": "03:45:52.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 9,
      "start": 13552.0,
      "end": 13554.0,
      "formatted_start": "03:45:52.000",
      "formatted_end": "03:45:54.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 10,
