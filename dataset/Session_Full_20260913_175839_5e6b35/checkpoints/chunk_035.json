      "end": 10719.0,
      "formatted_start": "02:58:35.000",
      "formatted_end": "02:58:39.000",
      "text": "میدن بشین و بارزو برد. بفرما کنو اونا رو فارد کنو بگیری بیرین."
    },
    {
      "id": 70,
      "start": 10719.0,
      "end": 10723.0,
      "formatted_start": "02:58:39.000",
      "formatted_end": "02:58:43.000",
      "text": "داروان بانبوغان میخورن."
    },
