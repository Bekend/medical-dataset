      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:30.000",
      "text": "از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا"
    },
    {
      "id": 1,
      "start": 10530.0,
      "end": 10532.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:32.000",
      "text": "بله، من در اینکه باید برداریم."
    },
    {
      "id": 2,
      "start": 10532.0,
      "end": 10534.0,
      "formatted_start": "02:55:32.000",
      "formatted_end": "02:55:34.000",
      "text": "من مناسبی نیزه دارم."
    },
    {
      "id": 3,
      "start": 10534.0,
      "end": 10536.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:36.000",
      "text": "تو رو نوشتم."
    },
    {
      "id": 4,
      "start": 10536.0,
      "end": 10538.0,
      "formatted_start": "02:55:36.000",
      "formatted_end": "02:55:38.000",
      "text": "حالا تو مفصل دارا نوشتم."
    },
    {
      "id": 5,
      "start": 10538.0,
      "end": 10540.0,
      "formatted_start": "02:55:38.000",
      "formatted_end": "02:55:40.000",
      "text": "حالا اون مشکل نیستم."
    },
    {
      "id": 6,
      "start": 10540.0,
      "end": 10542.0,
      "formatted_start": "02:55:40.000",
      "formatted_end": "02:55:42.000",
      "text": "خب، اینم رو بیاریم توی این که"
    },
    {
      "id": 7,
      "start": 10542.0,
      "end": 10544.0,
      "formatted_start": "02:55:42.000",
      "formatted_end": "02:55:44.000",
      "text": "این نوشته چرا؟"
    },
    {
      "id": 8,
      "start": 10544.0,
      "end": 10546.0,
      "formatted_start": "02:55:44.000",
      "formatted_end": "02:55:46.000",
      "text": "من هرگزم."
    },
    {
      "id": 9,
      "start": 10546.0,
      "end": 10548.0,
      "formatted_start": "02:55:46.000",
      "formatted_end": "02:55:48.000",
      "text": "خب، مستقیم همون رو تو بیاریم دو اینه رو"
    },
    {
      "id": 10,
      "start": 10548.0,
      "end": 10550.0,
      "formatted_start": "02:55:48.000",
      "formatted_end": "02:55:50.000",
      "text": "من با اون رو یاد میدم این کار رو انجام بدن."
    },
    {
      "id": 11,
      "start": 10550.0,
      "end": 10552.0,
      "formatted_start": "02:55:50.000",
      "formatted_end": "02:55:52.000",
      "text": "خب، خانم مقدم بیا."
    },
    {
      "id": 12,
      "start": 10552.0,
      "end": 10554.0,
      "formatted_start": "02:55:52.000",
      "formatted_end": "02:55:54.000",
      "text": "خانم مقدم بیا."
    },
    {
      "id": 13,
      "start": 10554.0,
      "end": 10556.0,
      "formatted_start": "02:55:54.000",
      "formatted_end": "02:55:56.000",
      "text": "این رو برداریم."
    },
    {
      "id": 14,
      "start": 10556.0,
      "end": 10559.0,
      "formatted_start": "02:55:56.000",
      "formatted_end": "02:55:59.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 15,
      "start": 10559.0,
      "end": 10561.0,
      "formatted_start": "02:55:59.000",
