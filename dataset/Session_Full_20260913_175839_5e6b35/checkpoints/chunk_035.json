      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 25,
      "start": 10570.0,
      "end": 10571.0,
      "formatted_start": "02:56:10.000",
      "formatted_end": "02:56:11.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 26,
      "start": 10571.0,
      "end": 10572.0,
      "formatted_start": "02:56:11.000",
      "formatted_end": "02:56:12.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 27,
      "start": 10572.0,
      "end": 10573.0,
      "formatted_start": "02:56:12.000",
      "formatted_end": "02:56:13.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 28,
      "start": 10573.0,
      "end": 10574.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:14.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 29,
      "start": 10574.0,
      "end": 10575.0,
      "formatted_start": "02:56:14.000",
      "formatted_end": "02:56:15.000",
      "text": "خیلی خوب خیلی خوب"
    },
    {
      "id": 30,
      "start": 10586.0,
      "end": 10599.0,
      "formatted_start": "02:56:26.000",
      "formatted_end": "02:56:39.000",
      "text": "این مسخه رو مادرش هم توی این مسخه ادکترونیک نمیشن همینو توی اینجا جا بده"
    },
    {
      "id": 31,
      "start": 10599.0,
      "end": 10606.0,
      "formatted_start": "02:56:39.000",
      "formatted_end": "02:56:46.000",
      "text": "متیل اینجا، اینم متیل داره؟ نه این پیروکسپایل، فرد دراصله همین این مسخه رو این تو جا بده"
    },
    {
      "id": 32,
      "start": 10606.0,
      "end": 10615.0,
      "formatted_start": "02:56:46.000",
      "formatted_end": "02:56:55.000",
      "text": "سرماندین هم، کربینی ویستم سیتا، این یه میلیون رو خورده، این توی داروش میشه، چیکار کنی؟ مادر رو خورداری؟"
    },
    {
      "id": 33,
      "start": 10615.0,
      "end": 10617.0,
      "formatted_start": "02:56:55.000",
      "formatted_end": "02:56:57.000",
      "text": "چرا میشه؟"
    },
    {
      "id": 34,
      "start": 10617.0,
      "end": 10619.0,
      "formatted_start": "02:56:57.000",
      "formatted_end": "02:56:59.000",
      "text": "یکو کرده یکو داروات میشه"
    },
    {
      "id": 35,
      "start": 10619.0,
      "end": 10621.0,
      "formatted_start": "02:56:59.000",
      "formatted_end": "02:57:01.000",
      "text": "دارواتشو از اینجا بکنیم"
    },
    {
      "id": 36,
      "start": 10621.0,
      "end": 10623.0,
      "formatted_start": "02:57:01.000",
      "formatted_end": "02:57:03.000",
      "text": "از اینجا بکنیم، بله"
    },
    {
      "id": 37,
      "start": 10623.0,
      "end": 10625.0,
      "formatted_start": "02:57:03.000",
      "formatted_end": "02:57:05.000",
      "text": "سرماده ایشونو میتونم حذف بکنم"
    },
    {
      "id": 38,
      "start": 10625.0,
      "end": 10627.0,
      "formatted_start": "02:57:05.000",
      "formatted_end": "02:57:07.000",
      "text": "یه چیز دیگه بذارم"
    },
    {
      "id": 39,
      "start": 10627.0,
      "end": 10629.0,
      "formatted_start": "02:57:07.000",
      "formatted_end": "02:57:09.000",
      "text": "جاشکه"
    },
    {
      "id": 40,
      "start": 10629.0,
      "end": 10631.0,
      "formatted_start": "02:57:09.000",
      "formatted_end": "02:57:11.000",
      "text": "اینجوری باشه"
    },
    {
      "id": 41,
      "start": 10631.0,
      "end": 10633.0,
      "formatted_start": "02:57:11.000",
      "formatted_end": "02:57:13.000",
      "text": "این کم تنمش"
    },
    {
      "id": 42,
      "start": 10633.0,
      "end": 10635.0,
      "formatted_start": "02:57:13.000",
      "formatted_end": "02:57:15.000",
      "text": "اینو که ازا توی این دستوری"
    },
    {
      "id": 43,
      "start": 10635.0,
      "end": 10637.0,
      "formatted_start": "02:57:15.000",
      "formatted_end": "02:57:17.000",
      "text": "از این هر زمون بگیره"
    },
    {
      "id": 44,
      "start": 10637.0,
      "end": 10639.0,
      "formatted_start": "02:57:17.000",
      "formatted_end": "02:57:19.000",
      "text": "بعد اینه"
    },
    {
      "id": 45,
      "start": 10639.0,
      "end": 10641.0,
      "formatted_start": "02:57:19.000",
      "formatted_end": "02:57:21.000",
      "text": "داروات من و داروات مامان"
    },
    {
      "id": 46,
      "start": 10641.0,
      "end": 10643.0,
      "formatted_start": "02:57:21.000",
      "formatted_end": "02:57:23.000",
      "text": "میاریم جدا"
    },
    {
      "id": 47,
      "start": 10643.0,
      "end": 10645.0,
      "formatted_start": "02:57:23.000",
      "formatted_end": "02:57:25.000",
      "text": "باید بگویم که که اون رو بگیرم"
    },
    {
      "id": 48,
      "start": 10645.0,
      "end": 10647.0,
      "formatted_start": "02:57:25.000",
      "formatted_end": "02:57:27.000",
      "text": "باید بگویم که که اون رو بگیرم"
    },
    {
      "id": 49,
      "start": 10647.0,
      "end": 10649.0,
      "formatted_start": "02:57:27.000",
      "formatted_end": "02:57:29.000",
      "text": "باید بگویم که که اون رو بگیرم"
    },
    {
      "id": 50,
      "start": 10649.0,
      "end": 10651.0,
      "formatted_start": "02:57:29.000",
      "formatted_end": "02:57:31.000",
      "text": "باید بگویم که که اون رو بگیرم"
    },
    {
