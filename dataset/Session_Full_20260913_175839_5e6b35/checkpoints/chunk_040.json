  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12030.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:30.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 1,
      "start": 12030.0,
      "end": 12060.0,
      "formatted_start": "03:20:30.000",
      "formatted_end": "03:21:00.000",
      "text": "اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 2,
      "start": 12060.0,
      "end": 12089.98,
      "formatted_start": "03:21:00.000",
      "formatted_end": "03:21:29.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 3,
      "start": 12120.0,
      "end": 12122.0,
      "formatted_start": "03:22:00.000",
      "formatted_end": "03:22:02.000",
      "text": "نه، نه، همین چی کاری بگیره"
    },
    {
      "id": 4,
      "start": 12122.0,
      "end": 12123.0,
      "formatted_start": "03:22:02.000",
      "formatted_end": "03:22:03.000",
      "text": "بسره بگیره"
    },
    {
      "id": 5,
      "start": 12123.0,
      "end": 12125.0,
      "formatted_start": "03:22:03.000",
      "formatted_end": "03:22:05.000",
      "text": "حالا جمع باز برم تا"
    },
    {
      "id": 6,
      "start": 12125.0,
      "end": 12126.0,
      "formatted_start": "03:22:05.000",
      "formatted_end": "03:22:06.000",
      "text": "همینم"
    },
    {
      "id": 7,
      "start": 12126.0,
      "end": 12127.0,
      "formatted_start": "03:22:06.000",
      "formatted_end": "03:22:07.000",
      "text": "چطوره؟"
    },
    {
      "id": 8,
      "start": 12127.0,
      "end": 12129.0,
      "formatted_start": "03:22:07.000",
      "formatted_end": "03:22:09.000",
      "text": "یک حرکت داره، حرکت داره، اونجا باز کنه"
    },
    {
      "id": 9,
      "start": 12129.0,
      "end": 12133.0,
      "formatted_start": "03:22:09.000",
      "formatted_end": "03:22:13.000",
      "text": "این چون جا شدیده، یکم حرکت بره، آزاد شده"
    },
    {
      "id": 10,
      "start": 12133.0,
      "end": 12137.0,
      "formatted_start": "03:22:13.000",
      "formatted_end": "03:22:17.000",
      "text": "ببین، این خار بود، خار بود، اینو من خار رو آوردم توی بودی"
    },
    {
      "id": 11,
      "start": 12137.0,
      "end": 12140.0,
      "formatted_start": "03:22:17.000",
      "formatted_end": "03:22:20.000",
      "text": "حالا میگه راحت حرکت بره، حرکت بره، نترسی؟"
    },
    {
      "id": 12,
      "start": 12140.0,
      "end": 12141.0,
      "formatted_start": "03:22:20.000",
      "formatted_end": "03:22:21.000",
      "text": "نه، دست نداره"
    },
    {
      "id": 13,
      "start": 12141.0,
      "end": 12144.0,
      "formatted_start": "03:22:21.000",
      "formatted_end": "03:22:24.000",
      "text": "من از یکم درداره"
    },
    {
      "id": 14,
      "start": 12144.0,
      "end": 12146.0,
      "formatted_start": "03:22:24.000",
      "formatted_end": "03:22:26.000",
      "text": "خانه اون پای جدیدی درد میکنه"
    },
    {
      "id": 15,
      "start": 12146.0,
      "end": 12148.0,
      "formatted_start": "03:22:26.000",
      "formatted_end": "03:22:28.000",
      "text": "اون درب فلش نیست"
    },
    {
      "id": 16,
      "start": 12148.0,
      "end": 12150.0,
      "formatted_start": "03:22:28.000",
      "formatted_end": "03:22:30.000",
      "text": "درب جاواز کرده"
    },
    {
      "id": 17,
      "start": 12150.0,
      "end": 12152.0,
      "formatted_start": "03:22:30.000",
      "formatted_end": "03:22:32.000",
      "text": "ورزش که بکنی جاواز کنه"
    },
    {
      "id": 18,
      "start": 12152.0,
      "end": 12154.0,
      "formatted_start": "03:22:32.000",
      "formatted_end": "03:22:34.000",
      "text": "شاید برم اینو بگذارم"
    },
    {
      "id": 19,
      "start": 12154.0,
      "end": 12156.0,
      "formatted_start": "03:22:34.000",
      "formatted_end": "03:22:36.000",
      "text": "اینشون درد چون شفت باشه"
    },
    {
      "id": 20,
      "start": 12156.0,
      "end": 12158.0,
      "formatted_start": "03:22:36.000",
      "formatted_end": "03:22:38.000",
      "text": "اونو برم بیایید"
    },
    {
      "id": 21,
      "start": 12158.0,
      "end": 12160.0,
      "formatted_start": "03:22:38.000",
      "formatted_end": "03:22:40.000",
      "text": "چیز ندارید"
    },
    {
      "id": 22,
      "start": 12160.0,
      "end": 12162.0,
      "formatted_start": "03:22:40.000",
      "formatted_end": "03:22:42.000",
      "text": "من زنانمون"
    },
    {
      "id": 23,
      "start": 12162.0,
      "end": 12164.0,
      "formatted_start": "03:22:42.000",
      "formatted_end": "03:22:44.000",
      "text": "خوبش شما"
    },
    {
      "id": 24,
      "start": 12164.0,
      "end": 12166.0,
      "formatted_start": "03:22:44.000",
      "formatted_end": "03:22:46.000",
      "text": "زنجاداش اشرای درست کرده بودم"
    },
    {
      "id": 25,
      "start": 12166.0,
      "end": 12168.0,
      "formatted_start": "03:22:46.000",
      "formatted_end": "03:22:48.000",
      "text": "الان اومد و برم خواهش بگیرم"
    },
    {
      "id": 26,
      "start": 12168.0,
      "end": 12170.0,
      "formatted_start": "03:22:48.000",
      "formatted_end": "03:22:50.000",
      "text": "خواهش برم"
    },
    {
      "id": 27,
      "start": 12170.0,
      "end": 12172.0,
      "formatted_start": "03:22:50.000",
      "formatted_end": "03:22:52.000",
      "text": "که میاد برم"
    },
    {
      "id": 28,
      "start": 12172.0,
      "end": 12175.58,
      "formatted_start": "03:22:52.000",
      "formatted_end": "03:22:55.580",
      "text": "راق بشن، قشنگ پشار بیارش راق رو"
    },
    {
      "id": 29,
      "start": 12175.58,
      "end": 12177.58,
      "formatted_start": "03:22:55.580",
      "formatted_end": "03:22:57.580",
      "text": "من خواهم این راق پشار بیاره جا باز کنه"
    },
    {
      "id": 30,
      "start": 12177.58,
      "end": 12180.28,
      "formatted_start": "03:22:57.580",
      "formatted_end": "03:23:00.280",
      "text": "این جای جرید براش باد داره"
    },
    {
      "id": 31,
      "start": 12180.28,
      "end": 12183.56,
      "formatted_start": "03:23:00.280",
      "formatted_end": "03:23:03.560",
      "text": "یک کمی پشار بیاره جا باز کنه قشنگ حرکت می کنه"
    },
    {
      "id": 32,
      "start": 12183.56,
      "end": 12185.4,
      "formatted_start": "03:23:03.560",
      "formatted_end": "03:23:05.400",
      "text": "یک کم راق رو باید برده روپر نکس"
    },
    {
      "id": 33,
      "start": 12185.4,
      "end": 12188.32,
      "formatted_start": "03:23:05.400",
      "formatted_end": "03:23:08.320",
      "text": "قشنگ پشار بیاره"
    },
    {
      "id": 34,
      "start": 12188.32,
      "end": 12190.66,
      "formatted_start": "03:23:08.320",
      "formatted_end": "03:23:10.660",
      "text": "یه بردشیه اینجوری"
    },
    {
      "id": 35,
      "start": 12190.66,
      "end": 12192.02,
      "formatted_start": "03:23:10.660",
      "formatted_end": "03:23:12.020",
      "text": "بذاره جلو"
    },
    {
      "id": 36,
      "start": 12192.02,
      "end": 12194.62,
      "formatted_start": "03:23:12.020",
      "formatted_end": "03:23:14.620",
      "text": "کف پارو زمین"
    },
    {
      "id": 37,
      "start": 12194.62,
      "end": 12195.24,
      "formatted_start": "03:23:14.620",
      "formatted_end": "03:23:15.240",
      "text": "کف پارو زمین"
    },
    {
      "id": 38,
      "start": 12195.24,
      "end": 12195.64,
      "formatted_start": "03:23:15.240",
      "formatted_end": "03:23:15.640",
      "text": "بیاره باره"
    },
    {
      "id": 39,
      "start": 12195.64,
      "end": 12196.48,
      "formatted_start": "03:23:15.640",
      "formatted_end": "03:23:16.480",
      "text": "نه تونتون نه"
    },
    {
      "id": 40,
      "start": 12196.48,
      "end": 12197.12,
      "formatted_start": "03:23:16.480",
      "formatted_end": "03:23:17.120",
      "text": "بیاره باره"
    },
    {
      "id": 41,
      "start": 12197.12,
      "end": 12198.6,
      "formatted_start": "03:23:17.120",
      "formatted_end": "03:23:18.600",
      "text": "تا بیست بشمار"
    },
    {
      "id": 42,
      "start": 12198.6,
      "end": 12209.84,
      "formatted_start": "03:23:18.600",
      "formatted_end": "03:23:29.840",
      "text": "یک، دو، سه، چهار، پند، شیش، هم، هشت، دو، ده، یازده، ده، وازده، سیزده، چهارده، پونزده، شونده، زیفده، بیشده، نوزده، بیش سه، خواهیم"
    },
    {
      "id": 43,
      "start": 12209.84,
      "end": 12211.48,
      "formatted_start": "03:23:29.840",
      "formatted_end": "03:23:31.480",
      "text": "بزرگ است، درسته؟"
    },
    {
      "id": 44,
      "start": 12211.48,
      "end": 12213.56,
      "formatted_start": "03:23:31.480",
      "formatted_end": "03:23:33.560",
      "text": "خستگیش رفت، باز دوباره"
    },
    {
      "id": 45,
      "start": 12213.56,
      "end": 12215.28,
      "formatted_start": "03:23:33.560",
      "formatted_end": "03:23:35.280",
      "text": "این پانه تا جایی که می توانی برات"
    },
    {
      "id": 46,
      "start": 12215.28,
      "end": 12217.92,
      "formatted_start": "03:23:35.280",
      "formatted_end": "03:23:37.920",
      "text": "این باعث می شود این ازوره چهار سره اید"
    },
    {
      "id": 47,
      "start": 12217.92,
      "end": 12219.08,
      "formatted_start": "03:23:37.920",
      "formatted_end": "03:23:39.080",
      "text": "اینجا اسمش چهار سره"
    },
    {
      "id": 48,
      "start": 12219.08,
      "end": 12223.08,
      "formatted_start": "03:23:39.080",
      "formatted_end": "03:23:43.080",
      "text": "خواهیم قبیل بشین، دیگه اون در رقع از جاش"
    },
    {
      "id": 49,
      "start": 12223.08,
      "end": 12227.08,
      "formatted_start": "03:23:43.080",
      "formatted_end": "03:23:47.080",
      "text": "اینکه کشکر خارج میشه از جاشت به خاطر این ازوله ضعیف میشه"
    },
    {
      "id": 50,
      "start": 12227.08,
      "end": 12229.08,
      "formatted_start": "03:23:47.080",
      "formatted_end": "03:23:49.080",
      "text": "تا 20 باشه بشه منو بذار بزارم"
    },
    {
      "id": 51,
      "start": 12229.08,
      "end": 12231.08,
      "formatted_start": "03:23:49.080",
      "formatted_end": "03:23:51.080",
      "text": "20 دفع صبح 20 دفع زور 20 دفع شب"
    },
    {
      "id": 52,
      "start": 12231.08,
      "end": 12233.08,
      "formatted_start": "03:23:51.080",
      "formatted_end": "03:23:53.080",
      "text": "توم توم توم توم پایده نداره"
    },
    {
      "id": 53,
      "start": 12233.08,
      "end": 12237.08,
      "formatted_start": "03:23:53.080",
      "formatted_end": "03:23:57.080",
      "text": "نهایی باید هر وقت این عشق بیاری بالا بالا نگه داری"
    },
    {
      "id": 54,
      "start": 12237.08,
      "end": 12240.08,
      "formatted_start": "03:23:57.080",
      "formatted_end": "03:24:00.080",
      "text": "خواهان که این ازوله اقدر می کشه آنها"
    },
    {
      "id": 55,
      "start": 12240.08,
      "end": 12243.08,
      "formatted_start": "03:24:00.080",
      "formatted_end": "03:24:03.080",
      "text": "درسته؟ این ازوله صاف میکنه"
    },
    {
      "id": 56,
      "start": 12243.08,
      "end": 12245.08,
      "formatted_start": "03:24:03.080",
      "formatted_end": "03:24:05.080",
      "text": "یعنی از این صورت فرق کرده کامل میشه"
    },
    {
      "id": 57,
      "start": 12245.08,
      "end": 12246.08,
      "formatted_start": "03:24:05.080",
      "formatted_end": "03:24:06.080",
      "text": "از صافه"
    },
    {
      "id": 58,
      "start": 12246.08,
      "end": 12248.08,
      "formatted_start": "03:24:06.080",
      "formatted_end": "03:24:08.080",
      "text": "یعنی از این صافه شده"
    },
    {
      "id": 59,
      "start": 12248.08,
      "end": 12255.08,
      "formatted_start": "03:24:08.080",
      "formatted_end": "03:24:15.080",
      "text": "اینه، کشتکس می‌گیردیم، خواب، بیسته ای خواهر صبح، بیسته ای زور، بیسته ای شب"
    },
    {
      "id": 60,
      "start": 12255.08,
      "end": 12260.08,
      "formatted_start": "03:24:15.080",
      "formatted_end": "03:24:20.080",
      "text": "نباشه از که بیاریم تا تخت کرده شد، و شکلتش آزیز باشه"
    },
    {
      "id": 61,
      "start": 12260.08,
      "end": 12266.08,
      "formatted_start": "03:24:20.080",
      "formatted_end": "03:24:26.080",
      "text": "اگر بیارو تک رویتی، تو که این دیگه باید خامده پاتو بذارید، نه که پاتو نباشه باید بذارید"
    },
    {
      "id": 62,
      "start": 12266.08,
      "end": 12268.08,
      "formatted_start": "03:24:26.080",
      "formatted_end": "03:24:28.080",
      "text": "این کوشش کارش شد"
    },
    {
      "id": 63,
      "start": 12268.08,
      "end": 12270.08,
      "formatted_start": "03:24:28.080",
      "formatted_end": "03:24:30.080",
      "text": "بیار برم"
    },
    {
      "id": 64,
      "start": 12270.08,
      "end": 12300.06,
      "formatted_start": "03:24:30.080",
      "formatted_end": "03:25:00.060",
      "text": "موسیقی در موسیقی درسته"
    }
  ],
  "status": "completed"
}