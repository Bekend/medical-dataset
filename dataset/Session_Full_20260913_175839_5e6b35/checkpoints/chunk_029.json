  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8703.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:03.000",
      "text": "به تیروید نفتنن؟"
    },
    {
      "id": 1,
      "start": 8703.0,
      "end": 8710.0,
      "formatted_start": "02:25:03.000",
      "formatted_end": "02:25:10.000",
      "text": "باید همه دیگه، بعد اینکه دیدم، از اینکه بزنم، بعد در بشکان میرفتم، دیدم، بعد اینکه بزنم، باید نمیمیاد."
    },
    {
      "id": 2,
      "start": 8710.0,
      "end": 8716.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:16.000",
      "text": "بعد تو گشته یک نفتن وردی بگیرم، گفتیش چیز کمان، آزمایش بودش، ازا تیروید داری، دلیلش مورد تیروید نفتنن؟"
    },
    {
      "id": 3,
      "start": 8716.0,
      "end": 8720.0,
      "formatted_start": "02:25:16.000",
      "formatted_end": "02:25:20.000",
      "text": "نه، نه، نه، نه، تیروید در حد اونجوری نیست."
    },
    {
      "id": 4,
      "start": 8720.0,
      "end": 8729.0,
      "formatted_start": "02:25:20.000",
      "formatted_end": "02:25:29.000",
      "text": "اون یک مریضی تیروید برده در کمکاری تیروید که تیست هشت میره بالای پنج مثلا میشه ده ده اصلا"
    },
    {
      "id": 5,
      "start": 8729.0,
      "end": 8733.0,
      "formatted_start": "02:25:29.000",
      "formatted_end": "02:25:33.000",
      "text": "چون زیر یکی نه اون نیست"
    },
    {
      "id": 6,
      "start": 8733.0,
      "end": 8740.0,
      "formatted_start": "02:25:33.000",
      "formatted_end": "02:25:40.000",
      "text": "چون هم بلغم دارید شبها احساس خفهگی و خورخور و روزان خستگی زود رفت"
    },
    {
      "id": 7,
      "start": 8740.0,
      "end": 8756.0,
      "formatted_start": "02:25:40.000",
      "formatted_end": "02:25:56.000",
      "text": "باز کنید، باز کنید، به سمت خودتون بکشید، آرام، تیجوری که با بلدادن داخلی تردن قلبشو میگیزد، الان کمان سکره کنید، قبلی هم مرده میخواست فرار کنه، احساس کنید که موشک آمده اید."
    },
    {
      "id": 8,
      "start": 8756.0,
      "end": 8766.0,
      "formatted_start": "02:25:56.000",
      "formatted_end": "02:26:06.000",
      "text": "بشاره به داخل، باز نکنید، به سمت خودتون بکشید، باز کنید، خب این است."
    },
    {
      "id": 9,
      "start": 8766.0,
      "end": 8780.0,
      "formatted_start": "02:26:06.000",
      "formatted_end": "02:26:20.000",
      "text": "سر و بالا ببینید، اینجا ها دست نشانده شد. تیرویت اینجا است و اصلا تیرویت اینجا وقتش ها داره کارش چیزی داره."
    },
    {
      "id": 10,
      "start": 8780.0,
      "end": 8791.0,
      "formatted_start": "02:26:20.000",
      "formatted_end": "02:26:31.000",
      "text": "آله که مردم هست، آله عقب میکرده. این صورت درست که شما فرق دارد، از این بردرنه شما پی سی رو دارید."
    },
    {
      "id": 11,
      "start": 8791.0,
      "end": 8793.0,
      "formatted_start": "02:26:31.000",
      "formatted_end": "02:26:33.000",
      "text": "اون روزش رو باید دفتر کنید"
    },
    {
      "id": 12,
      "start": 8793.0,
      "end": 8795.0,
      "formatted_start": "02:26:33.000",
      "formatted_end": "02:26:35.000",
      "text": "خیلی نیست"
    },
    {
      "id": 13,
      "start": 8795.0,
      "end": 8797.0,
      "formatted_start": "02:26:35.000",
      "formatted_end": "02:26:37.000",
      "text": "این روز باید درست کنید"
    },
    {
      "id": 14,
      "start": 8797.0,
      "end": 8799.0,
      "formatted_start": "02:26:37.000",
      "formatted_end": "02:26:39.000",
      "text": "این روز باید درست کنید"
    },
    {
      "id": 15,
      "start": 8799.0,
      "end": 8801.0,
      "formatted_start": "02:26:39.000",
      "formatted_end": "02:26:41.000",
      "text": "این روز باید درست کنید"
    },
    {
      "id": 16,
      "start": 8801.0,
      "end": 8803.0,
      "formatted_start": "02:26:41.000",
      "formatted_end": "02:26:43.000",
      "text": "این روز باید درست کنید"
    },
    {
      "id": 17,
