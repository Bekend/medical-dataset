      "formatted_start": "00:02:27.000",
      "formatted_end": "00:02:29.000",
      "text": "خوش خوزنگی که شما برده بود."
    },
    {
      "id": 43,
      "start": 149.0,
      "end": 151.0,
      "formatted_start": "00:02:29.000",
      "formatted_end": "00:02:31.000",
      "text": "خوش خوزنگی."
    },
    {
      "id": 44,
      "start": 161.0,
      "end": 166.0,
      "formatted_start": "00:02:41.000",
      "formatted_end": "00:02:46.000",
      "text": "خواهد هرمه ساعتون را بسیار دیگه میبونیم با سطح برمی."
    },
    {
      "id": 45,
      "start": 166.0,
      "end": 168.0,
      "formatted_start": "00:02:46.000",
      "formatted_end": "00:02:48.000",
      "text": "خدا که شیره را ای خواست داریم."
    },
    {
      "id": 46,
      "start": 168.0,
      "end": 173.0,
      "formatted_start": "00:02:48.000",
      "formatted_end": "00:02:53.000",
      "text": "می کنیم این برگم هستنده که همین شویی بیخونده بود برای ما."
    },
    {
      "id": 47,
      "start": 173.0,
      "end": 177.0,
      "formatted_start": "00:02:53.000",
      "formatted_end": "00:02:57.000",
      "text": "بابا نه از اینجا بابا نه نمیشه میرم."
    },
    {
      "id": 48,
      "start": 177.0,
      "end": 179.0,
      "formatted_start": "00:02:57.000",
      "formatted_end": "00:02:59.000",
      "text": "نه."
    },
    {
      "id": 49,
      "start": 179.0,
      "end": 181.0,
      "formatted_start": "00:02:59.000",
      "formatted_end": "00:03:01.000",
      "text": "یه گنیایی."
    },
    {
      "id": 50,
      "start": 181.0,
      "end": 183.0,
      "formatted_start": "00:03:01.000",
      "formatted_end": "00:03:03.000",
      "text": "گنیایی."
    },
    {
      "id": 51,
      "start": 183.0,
      "end": 185.0,
      "formatted_start": "00:03:03.000",
      "formatted_end": "00:03:05.000",
      "text": "که در یه درگاه میرم."
    },
    {
      "id": 52,
      "start": 185.0,
      "end": 187.0,
      "formatted_start": "00:03:05.000",
      "formatted_end": "00:03:07.000",
      "text": "که باید با من که شیر کنیم."
    },
    {
      "id": 53,
      "start": 187.0,
      "end": 189.0,
      "formatted_start": "00:03:07.000",
      "formatted_end": "00:03:09.000",
      "text": "آزیان دارید هم یه سوره؟"
    },
    {
      "id": 54,
      "start": 189.0,
      "end": 191.0,
      "formatted_start": "00:03:09.000",
      "formatted_end": "00:03:11.000",
      "text": "نه."
    },
    {
      "id": 55,
      "start": 191.0,
      "end": 193.0,
      "formatted_start": "00:03:11.000",
      "formatted_end": "00:03:13.000",
      "text": "نه."
    },
    {
      "id": 56,
      "start": 193.0,
      "end": 195.0,
      "formatted_start": "00:03:13.000",
      "formatted_end": "00:03:15.000",
      "text": "یه را درگاه باشید؟"
    },
    {
      "id": 57,
      "start": 195.0,
      "end": 197.0,
      "formatted_start": "00:03:15.000",
      "formatted_end": "00:03:17.000",
      "text": "آزیان باشم."
    },
    {
      "id": 58,
      "start": 197.0,
      "end": 199.0,
      "formatted_start": "00:03:17.000",
      "formatted_end": "00:03:19.000",
      "text": "آزیان باشم."
    },
    {
      "id": 59,
      "start": 199.0,
      "end": 202.66,
      "formatted_start": "00:03:19.000",
      "formatted_end": "00:03:22.660",
      "text": "این بوده ایه، بیشتر خیلی گره هم، آفده رو درده"
    },
    {
      "id": 60,
      "start": 202.66,
      "end": 206.5,
      "formatted_start": "00:03:22.660",
      "formatted_end": "00:03:26.500",
      "text": "کلا از توی شهر منظم بخواه خیلی نیستون"
    },
    {
      "id": 61,
      "start": 206.5,
      "end": 211.5,
      "formatted_start": "00:03:26.500",
      "formatted_end": "00:03:31.500",
      "text": "من خدا خوره درده، پنجه پنجه بیشتر نزده میزنم خواه"
    },
    {
      "id": 62,
      "start": 211.5,
      "end": 214.0,
      "formatted_start": "00:03:31.500",
      "formatted_end": "00:03:34.000",
      "text": "کذابت یا خوشش شما"
    },
    {
      "id": 63,
      "start": 214.0,
      "end": 216.0,
      "formatted_start": "00:03:34.000",
      "formatted_end": "00:03:36.000",
      "text": "چون من دستا بگویم درده باید"
    },
    {
      "id": 64,
      "start": 216.0,
      "end": 218.0,
      "formatted_start": "00:03:36.000",
      "formatted_end": "00:03:38.000",
      "text": "یا خسید آرامون، همین"
    },
    {
      "id": 65,
      "start": 218.0,
      "end": 220.0,
      "formatted_start": "00:03:38.000",
      "formatted_end": "00:03:40.000",
      "text": "دست نده آواز میزن"
    },
    {
      "id": 66,
      "start": 220.0,
      "end": 222.0,
      "formatted_start": "00:03:40.000",
      "formatted_end": "00:03:42.000",
      "text": "باید تونه، آواز نیست"
    },
    {
      "id": 67,
      "start": 222.0,
      "end": 225.0,
      "formatted_start": "00:03:42.000",
      "formatted_end": "00:03:45.000",
      "text": "بویم از چه تیران تر بگیر، باید گذارم اون سوگه"
    },
    {
      "id": 68,
      "start": 225.0,
      "end": 232.0,
      "formatted_start": "00:03:45.000",
      "formatted_end": "00:03:52.000",
      "text": "خانشه خیلی بزرگه اید. میره اون برای میشنه. من خانشه خیلی بزرگه اید."
    },
    {
      "id": 69,
      "start": 232.0,
      "end": 235.0,
      "formatted_start": "00:03:52.000",
      "formatted_end": "00:03:55.000",
      "text": "خیلی بزرگه اید."
    },
    {
      "id": 70,
      "start": 235.0,
      "end": 237.0,
      "formatted_start": "00:03:55.000",
      "formatted_end": "00:03:57.000",
      "text": "خیلی نمیشه بزرگه اید."
    },
    {
      "id": 71,
      "start": 237.0,
      "end": 239.0,
      "formatted_start": "00:03:57.000",
      "formatted_end": "00:03:59.000",
      "text": "نیستی ها درخ نمی کنن."
    },
    {
      "id": 72,
      "start": 239.0,
      "end": 243.0,
      "formatted_start": "00:03:59.000",
      "formatted_end": "00:04:03.000",
      "text": "سرارا برای زرگه بزرگه نمیشه."
    },
    {
      "id": 73,
      "start": 243.0,
      "end": 245.0,
      "formatted_start": "00:04:03.000",
      "formatted_end": "00:04:05.000",
      "text": "نیستی ها درخون سازشونه."
    },
    {
      "id": 74,
      "start": 245.0,
      "end": 247.0,
      "formatted_start": "00:04:05.000",
      "formatted_end": "00:04:07.000",
      "text": "سازشونه."
    },
    {
      "id": 75,
      "start": 247.0,
      "end": 249.0,
      "formatted_start": "00:04:07.000",
      "formatted_end": "00:04:09.000",
      "text": "نیستی بازشونه بشنه."
    },
    {
      "id": 76,
      "start": 249.0,
      "end": 251.0,
      "formatted_start": "00:04:09.000",
      "formatted_end": "00:04:11.000",
      "text": "نیستی بازشونه."
    },
    {
      "id": 77,
      "start": 251.0,
      "end": 281.0,
      "formatted_start": "00:04:11.000",
      "formatted_end": "00:04:41.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید ک"
