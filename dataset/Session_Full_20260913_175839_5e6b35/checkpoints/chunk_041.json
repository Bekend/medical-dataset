      "start": 12558.14,
      "end": 12560.14,
      "formatted_start": "03:29:18.140",
      "formatted_end": "03:29:20.140",
      "text": "شستشون"
    },
    {
      "id": 88,
      "start": 12560.14,
      "end": 12562.14,
      "formatted_start": "03:29:20.140",
      "formatted_end": "03:29:22.140",
      "text": "بس چون نیستیم"
    },
    {
      "id": 89,
      "start": 12562.14,
      "end": 12564.14,
      "formatted_start": "03:29:22.140",
      "formatted_end": "03:29:24.140",
      "text": "من مقبل کردم"
    },
    {
      "id": 90,
      "start": 12564.14,
      "end": 12566.14,
      "formatted_start": "03:29:24.140",
      "formatted_end": "03:29:26.140",
      "text": "حتی برای کورس دیدم"
    },
    {
      "id": 91,
      "start": 12566.14,
      "end": 12568.14,
      "formatted_start": "03:29:26.140",
      "formatted_end": "03:29:28.140",
