      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:29.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12330.0,
      "end": 12332.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:32.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 12360.0,
      "end": 12362.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:02.000",
      "text": "همین کماته؟"
    },
    {
      "id": 3,
      "start": 12362.0,
      "end": 12364.0,
      "formatted_start": "03:26:02.000",
      "formatted_end": "03:26:04.000",
      "text": "بله، این نداریم رو من"
    },
    {
      "id": 4,
      "start": 12364.0,
      "end": 12366.0,
      "formatted_start": "03:26:04.000",
      "formatted_end": "03:26:06.000",
      "text": "اول این دارو همشون دارم"
    },
    {
      "id": 5,
      "start": 12366.0,
      "end": 12368.0,
      "formatted_start": "03:26:06.000",
      "formatted_end": "03:26:08.000",
      "text": "بله، بعضی هاشو داریم، این دارو هستی کنم"
    },
    {
      "id": 6,
      "start": 12368.0,
      "end": 12370.0,
      "formatted_start": "03:26:08.000",
      "formatted_end": "03:26:10.000",
      "text": "این کماته؟"
    },
    {
      "id": 7,
      "start": 12370.0,
      "end": 12372.0,
      "formatted_start": "03:26:10.000",
      "formatted_end": "03:26:12.000",
      "text": "این شاید نه، اونا هم بسیاریم"
    },
    {
      "id": 8,
      "start": 12372.0,
      "end": 12374.0,
      "formatted_start": "03:26:12.000",
      "formatted_end": "03:26:14.000",
      "text": "این همشون دارم"
    },
    {
      "id": 9,
      "start": 12374.0,
      "end": 12376.0,
      "formatted_start": "03:26:14.000",
      "formatted_end": "03:26:16.000",
      "text": "آنکولش هم داریم؟"
    },
    {
      "id": 10,
      "start": 12376.0,
      "end": 12378.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:18.000",
      "text": "آنکولش هم این آنکول ها رو داریم که"
    },
    {
      "id": 11,
      "start": 12378.0,
      "end": 12380.0,
      "formatted_start": "03:26:18.000",
      "formatted_end": "03:26:20.000",
      "text": "تو داریم"
    },
    {
      "id": 12,
      "start": 12380.0,
      "end": 12382.0,
      "formatted_start": "03:26:20.000",
      "formatted_end": "03:26:22.000",
      "text": "تو از شماحت دارو داریم"
    },
    {
      "id": 13,
      "start": 12382.0,
      "end": 12384.0,
      "formatted_start": "03:26:22.000",
      "formatted_end": "03:26:24.000",
      "text": "حرف میزنیم، میدونم چیه"
    },
    {
      "id": 14,
      "start": 12384.0,
      "end": 12386.0,
      "formatted_start": "03:26:24.000",
      "formatted_end": "03:26:26.000",
      "text": "اسم رو یکی بگیریم"
    },
    {
      "id": 15,
      "start": 12386.0,
      "end": 12388.0,
      "formatted_start": "03:26:26.000",
      "formatted_end": "03:26:28.000",
      "text": "من گفتم کمات خوبه"
    },
    {
      "id": 16,
      "start": 12388.0,
      "end": 12391.46,
      "formatted_start": "03:26:28.000",
      "formatted_end": "03:26:31.460",
      "text": "نداشتم یه داره پیشتر ندارم چون دوتاشون توی یکی نداشتم"
    },
    {
      "id": 17,
      "start": 12391.46,
      "end": 12394.16,
      "formatted_start": "03:26:31.460",
      "formatted_end": "03:26:34.160",
      "text": "خب الان زنگ میزنه بهت یه داره بیده"
    },
    {
      "id": 18,
      "start": 12394.16,
      "end": 12395.6,
      "formatted_start": "03:26:34.160",
      "formatted_end": "03:26:35.600",
      "text": "آه"
    },
    {
      "id": 19,
      "start": 12395.6,
      "end": 12398.42,
      "formatted_start": "03:26:35.600",
      "formatted_end": "03:26:38.420",
      "text": "زنگ بزنید برای آرومیکس بهش یه داره بیده"
    },
    {
      "id": 20,
      "start": 12398.42,
      "end": 12399.46,
      "formatted_start": "03:26:38.420",
      "formatted_end": "03:26:39.460",
      "text": "تو بلده بیدی؟"
    },
    {
      "id": 21,
      "start": 12399.46,
      "end": 12400.46,
      "formatted_start": "03:26:39.460",
      "formatted_end": "03:26:40.460",
      "text": "چون بلده بیده"
    },
    {
      "id": 22,
      "start": 12400.46,
      "end": 12401.76,
      "formatted_start": "03:26:40.460",
      "formatted_end": "03:26:41.760",
      "text": "الان میگیرم برای تو"
    },
    {
      "id": 23,
      "start": 12401.76,
      "end": 12407.14,
      "formatted_start": "03:26:41.760",
      "formatted_end": "03:26:47.140",
      "text": "چون توی یه دفتر چه نداشتم یکی پیشتر ندادم"
    },
    {
      "id": 24,
      "start": 12407.14,
      "end": 12436.14,
      "formatted_start": "03:26:47.140",
      "formatted_end": "03:27:16.140",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 12437.14,
      "end": 12440.14,
      "formatted_start": "03:27:17.140",
      "formatted_end": "03:27:20.140",
      "text": "نه نه نوشتی. به خودم گفتی."
    },
    {
      "id": 26,
      "start": 12440.14,
      "end": 12442.14,
      "formatted_start": "03:27:20.140",
      "formatted_end": "03:27:22.140",
      "text": "دیروز انجام داده؟"
    },
    {
      "id": 27,
      "start": 12442.14,
      "end": 12445.14,
      "formatted_start": "03:27:22.140",
      "formatted_end": "03:27:25.140",
      "text": "نه نه. نه تیگه فرار شد بیاد که امروز انجام بده."
    },
    {
      "id": 28,
      "start": 12445.14,
      "end": 12446.14,
      "formatted_start": "03:27:25.140",
      "formatted_end": "03:27:26.140",
      "text": "آه."
    },
    {
      "id": 29,
      "start": 12446.14,
      "end": 12447.14,
      "formatted_start": "03:27:26.140",
      "formatted_end": "03:27:27.140",
      "text": "آه. شدی میگو دیروز."
    },
    {
      "id": 30,
      "start": 12447.14,
      "end": 12449.14,
      "formatted_start": "03:27:27.140",
      "formatted_end": "03:27:29.140",
      "text": "هشت بوده. هشت بوده."
    },
    {
      "id": 31,
      "start": 12449.14,
      "end": 12450.14,
      "formatted_start": "03:27:29.140",
      "formatted_end": "03:27:30.140",
      "text": "نه شد."
    },
    {
      "id": 32,
      "start": 12450.14,
      "end": 12453.14,
      "formatted_start": "03:27:30.140",
      "formatted_end": "03:27:33.140",
      "text": "هشت بوده. هشت بوده."
    },
    {
      "id": 33,
      "start": 12453.14,
      "end": 12455.14,
      "formatted_start": "03:27:33.140",
      "formatted_end": "03:27:35.140",
      "text": "خب از دیروز بوده؟"
    },
    {
      "id": 34,
      "start": 12455.14,
      "end": 12458.14,
      "formatted_start": "03:27:35.140",
      "formatted_end": "03:27:38.140",
      "text": "آه میگه دیروز بوده دیروز نبوده. دیروز آمده."
    },
    {
      "id": 35,
      "start": 12458.14,
      "end": 12459.14,
      "formatted_start": "03:27:38.140",
      "formatted_end": "03:27:39.140",
      "text": "آره."
    },
    {
      "id": 36,
      "start": 12459.14,
      "end": 12460.14,
      "formatted_start": "03:27:39.140",
      "formatted_end": "03:27:40.140",
      "text": "گفته که امروز میاد."
    },
    {
      "id": 37,
      "start": 12460.14,
      "end": 12461.14,
      "formatted_start": "03:27:40.140",
      "formatted_end": "03:27:41.140",
      "text": "آره. آره. آره."
    },
    {
      "id": 38,
      "start": 12461.14,
      "end": 12462.14,
      "formatted_start": "03:27:41.140",
      "formatted_end": "03:27:42.140",
      "text": "آره. آره."
    },
    {
      "id": 39,
      "start": 12462.14,
      "end": 12464.14,
      "formatted_start": "03:27:42.140",
      "formatted_end": "03:27:44.140",
      "text": "آره تمازیم"
    },
    {
      "id": 40,
      "start": 12464.14,
      "end": 12466.14,
      "formatted_start": "03:27:44.140",
      "formatted_end": "03:27:46.140",
      "text": "آره هشتر بشون دیگه"
    },
    {
      "id": 41,
      "start": 12466.14,
      "end": 12468.14,
      "formatted_start": "03:27:46.140",
      "formatted_end": "03:27:48.140",
      "text": "خب بفرده"
    },
    {
      "id": 42,
      "start": 12468.14,
      "end": 12470.14,
      "formatted_start": "03:27:48.140",
      "formatted_end": "03:27:50.140",
      "text": "منیز بیاد که"
    },
    {
      "id": 43,
      "start": 12470.14,
      "end": 12472.14,
      "formatted_start": "03:27:50.140",
      "formatted_end": "03:27:52.140",
      "text": "این بسایدی خود گذاشته میفترد"
    },
    {
      "id": 44,
      "start": 12472.14,
      "end": 12474.14,
      "formatted_start": "03:27:52.140",
      "formatted_end": "03:27:54.140",
      "text": "دکتور جماعه"
    },
    {
      "id": 45,
      "start": 12474.14,
      "end": 12476.14,
      "formatted_start": "03:27:54.140",
      "formatted_end": "03:27:56.140",
      "text": "سلام"
    },
    {
      "id": 46,
      "start": 12476.14,
      "end": 12478.14,
      "formatted_start": "03:27:56.140",
      "formatted_end": "03:27:58.140",
      "text": "خوبی؟"
    },
    {
      "id": 47,
      "start": 12478.14,
      "end": 12480.14,
      "formatted_start": "03:27:58.140",
      "formatted_end": "03:28:00.140",
      "text": "خوبی؟"
    },
    {
      "id": 48,
      "start": 12480.14,
      "end": 12482.14,
      "formatted_start": "03:28:00.140",
      "formatted_end": "03:28:02.140",
      "text": "خوبی؟"
    },
    {
      "id": 49,
      "start": 12482.14,
      "end": 12484.14,
      "formatted_start": "03:28:02.140",
      "formatted_end": "03:28:04.140",
      "text": "با چهره سال کار"
    },
    {
      "id": 50,
      "start": 12484.14,
      "end": 12486.14,
      "formatted_start": "03:28:04.140",
      "formatted_end": "03:28:06.140",
      "text": "با چهره سال کار"
    },
    {
      "id": 51,
      "start": 12486.14,
      "end": 12488.14,
      "formatted_start": "03:28:06.140",
      "formatted_end": "03:28:08.140",
      "text": "با چهره سال کار"
    },
    {
      "id": 52,
      "start": 12488.14,
      "end": 12490.14,
      "formatted_start": "03:28:08.140",
      "formatted_end": "03:28:10.140",
      "text": "با چهره سال کار"
    },
    {
      "id": 53,
      "start": 12490.14,
      "end": 12492.14,
      "formatted_start": "03:28:10.140",
      "formatted_end": "03:28:12.140",
      "text": "خدا شماست"
    },
    {
      "id": 54,
      "start": 12492.14,
      "end": 12494.14,
      "formatted_start": "03:28:12.140",
      "formatted_end": "03:28:14.140",
      "text": "خدا شماست"
    },
    {
      "id": 55,
      "start": 12494.14,
      "end": 12496.14,
      "formatted_start": "03:28:14.140",
      "formatted_end": "03:28:16.140",
      "text": "سلامت باشی"
    },
    {
      "id": 56,
      "start": 12496.14,
      "end": 12498.14,
      "formatted_start": "03:28:16.140",
      "formatted_end": "03:28:18.140",
      "text": "من برام خساسیه باشم"
    },
    {
      "id": 57,
      "start": 12498.14,
      "end": 12500.14,
      "formatted_start": "03:28:18.140",
      "formatted_end": "03:28:20.140",
      "text": "میخواهی همه شما"
    },
    {
      "id": 58,
      "start": 12500.14,
      "end": 12502.14,
      "formatted_start": "03:28:20.140",
      "formatted_end": "03:28:22.140",
      "text": "چند وقت خوارش میشه؟"
    },
    {
      "id": 59,
      "start": 12502.14,
      "end": 12504.14,
      "formatted_start": "03:28:22.140",
      "formatted_end": "03:28:24.140",
      "text": "جایی که میرم"
    },
    {
      "id": 60,
      "start": 12504.14,
      "end": 12506.14,
      "formatted_start": "03:28:24.140",
      "formatted_end": "03:28:26.140",
      "text": "مدره یکجایی"
    },
    {
      "id": 61,
      "start": 12506.14,
      "end": 12508.14,
      "formatted_start": "03:28:26.140",
      "formatted_end": "03:28:28.140",
      "text": "بشه"
    },
    {
      "id": 62,
      "start": 12508.14,
      "end": 12510.14,
      "formatted_start": "03:28:28.140",
      "formatted_end": "03:28:30.140",
      "text": "بعد اطراف باجن هم همیشه"
    },
    {
      "id": 63,
      "start": 12510.14,
      "end": 12512.14,
      "formatted_start": "03:28:30.140",
      "formatted_end": "03:28:32.140",
      "text": "خوارش میده"
    },
    {
      "id": 64,
      "start": 12512.14,
      "end": 12514.14,
      "formatted_start": "03:28:32.140",
      "formatted_end": "03:28:34.140",
      "text": "مرد چی؟"
    },
    {
      "id": 65,
      "start": 12514.14,
      "end": 12516.14,
      "formatted_start": "03:28:34.140",
      "formatted_end": "03:28:36.140",
      "text": "اون هم خوارش میده قرمز میشه"
    },
    {
      "id": 66,
      "start": 12516.14,
      "end": 12518.14,
      "formatted_start": "03:28:36.140",
      "formatted_end": "03:28:38.140",
      "text": "میسوزه"
    },
    {
      "id": 67,
      "start": 12518.14,
      "end": 12520.14,
      "formatted_start": "03:28:38.140",
      "formatted_end": "03:28:40.140",
      "text": "اینجای دستون قطعه چند میشه؟"
    },
    {
      "id": 68,
      "start": 12520.14,
      "end": 12522.14,
      "formatted_start": "03:28:40.140",
      "formatted_end": "03:28:42.140",
      "text": "137"
    },
    {
      "id": 69,
      "start": 12522.14,
      "end": 12524.14,
      "formatted_start": "03:28:42.140",
      "formatted_end": "03:28:44.140",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 12524.14,
      "end": 12526.14,
      "formatted_start": "03:28:44.140",
      "formatted_end": "03:28:46.140",
      "text": "137"
    },
    {
      "id": 71,
      "start": 12526.14,
      "end": 12528.14,
      "formatted_start": "03:28:46.140",
      "formatted_end": "03:28:48.140",
      "text": "137"
    },
    {
      "id": 72,
      "start": 12528.14,
      "end": 12530.14,
      "formatted_start": "03:28:48.140",
      "formatted_end": "03:28:50.140",
      "text": "بادارو 137"
    },
    {
      "id": 73,
      "start": 12530.14,
      "end": 12532.14,
      "formatted_start": "03:28:50.140",
      "formatted_end": "03:28:52.140",
      "text": "بله"
    },
    {
      "id": 74,
      "start": 12532.14,
      "end": 12534.14,
      "formatted_start": "03:28:52.140",
      "formatted_end": "03:28:54.140",
      "text": "چه دروعه میخوره آقایی اسیل جان؟"
    },
    {
      "id": 75,
      "start": 12534.14,
      "end": 12536.14,
      "formatted_start": "03:28:54.140",
      "formatted_end": "03:28:56.140",
      "text": "گروریپا"
    },
    {
      "id": 76,
      "start": 12536.14,
      "end": 12538.14,
      "formatted_start": "03:28:56.140",
      "formatted_end": "03:28:58.140",
      "text": "گروریپا"
    },
    {
      "id": 77,
      "start": 12538.14,
      "end": 12540.14,
      "formatted_start": "03:28:58.140",
      "formatted_end": "03:29:00.140",
      "text": "بله"
    },
    {
      "id": 78,
      "start": 12540.14,
      "end": 12542.14,
      "formatted_start": "03:29:00.140",
      "formatted_end": "03:29:02.140",
      "text": "10ش رو میخوری گروریپا"
    },
    {
      "id": 79,
      "start": 12542.14,
      "end": 12544.14,
      "formatted_start": "03:29:02.140",
      "formatted_end": "03:29:04.140",
      "text": "25ش رو داره ته هم داره"
    },
    {
      "id": 80,
      "start": 12544.14,
      "end": 12546.14,
      "formatted_start": "03:29:04.140",
      "formatted_end": "03:29:06.140",
      "text": "اینجا اینجا اینجا"
    },
    {
      "id": 81,
      "start": 12546.14,
      "end": 12548.14,
      "formatted_start": "03:29:06.140",
      "formatted_end": "03:29:08.140",
      "text": "این برنده تقییه مشکلی هست"
    },
    {
      "id": 82,
      "start": 12548.14,
      "end": 12550.14,
      "formatted_start": "03:29:08.140",
      "formatted_end": "03:29:10.140",
      "text": "خیلی خوب"
    },
