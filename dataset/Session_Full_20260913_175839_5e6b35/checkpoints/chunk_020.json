  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6009.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:09.000",
      "text": "تا مدیریت ها، خیلی مدیریتی کنید تو هر چیزی، مساله خانه این، همه چی باید بیدارید."
    },
    {
      "id": 1,
      "start": 6009.0,
      "end": 6022.0,
      "formatted_start": "01:40:09.000",
      "formatted_end": "01:40:22.000",
      "text": "حالا که بالایی سر صدا میکنه، من به خیال هم ایشون تدیدیم، با خیاله، میگه زنگ بزن بگو سکشو جمع کنه، زنگ بزن بگو میزشو جاوی جا نکنه، بعد من چی میگم؟ من بگم بهش فکر نکن، بهش فکر نکن."
    },
    {
      "id": 2,
      "start": 6022.0,
      "end": 6024.0,
      "formatted_start": "01:40:22.000",
      "formatted_end": "01:40:24.000",
      "text": "اون رای خیلی حساس هستم، من خیلی مدتونم به سر."
    },
    {
      "id": 3,
      "start": 6024.0,
      "end": 6026.0,
      "formatted_start": "01:40:24.000",
      "formatted_end": "01:40:26.000",
      "text": "خودتان خودتان"
    },
    {
      "id": 4,
      "start": 6026.0,
      "end": 6028.0,
      "formatted_start": "01:40:26.000",
      "formatted_end": "01:40:28.000",
      "text": "آره دیگه استرس"
    },
    {
      "id": 5,
      "start": 6028.0,
      "end": 6030.0,
      "formatted_start": "01:40:28.000",
      "formatted_end": "01:40:30.000",
      "text": "اصلا اگر چیزی متعلق کنیم"
    },
    {
      "id": 6,
      "start": 6030.0,
      "end": 6033.0,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:33.000",
      "text": "بندباز ها خانوایی که روی تناب راه بیرن"
    },
    {
      "id": 7,
      "start": 6033.0,
      "end": 6035.0,
      "formatted_start": "01:40:33.000",
      "formatted_end": "01:40:35.000",
      "text": "خب اصلا عادت نمیشه"
    },
    {
      "id": 8,
      "start": 6035.0,
      "end": 6037.0,
      "formatted_start": "01:40:35.000",
      "formatted_end": "01:40:37.000",
      "text": "اصلا عادت نمیشه"
    },
    {
      "id": 9,
      "start": 6037.0,
      "end": 6040.0,
      "formatted_start": "01:40:37.000",
      "formatted_end": "01:40:40.000",
      "text": "در سالی که بندبازی کنید یک بار هم عادت نمیشه"
    },
    {
      "id": 10,
      "start": 6040.0,
      "end": 6045.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:45.000",
      "text": "بس بین این مسئله شغل و این استرس دقت"
    },
    {
      "id": 11,
      "start": 6045.0,
      "end": 6047.0,
      "formatted_start": "01:40:45.000",
      "formatted_end": "01:40:47.000",
      "text": "بین دقت و عادت شدن"
    },
    {
      "id": 12,
      "start": 6047.0,
      "end": 6051.0,
      "formatted_start": "01:40:47.000",
      "formatted_end": "01:40:51.000",
      "text": "یه رابطه مستقیم وجود داره"
    },
    {
      "id": 13,
      "start": 6051.0,
      "end": 6054.18,
      "formatted_start": "01:40:51.000",
      "formatted_end": "01:40:54.180",
      "text": "هرز بخوری چرا باید راه رفت جایی بزنی؟"
    },
    {
      "id": 14,
      "start": 6054.18,
      "end": 6058.88,
      "formatted_start": "01:40:54.180",
      "formatted_end": "01:40:58.880",
      "text": "نوعی ساختمان های ما تویین که صدا را انتقال میرن"
    },
    {
      "id": 15,
      "start": 6058.88,
      "end": 6061.88,
      "formatted_start": "01:40:58.880",
      "formatted_end": "01:41:01.880",
      "text": "جلی و نولیت بذاشته باشن، جل نذاشته باشن"
    },
    {
      "id": 16,
      "start": 6061.88,
      "end": 6066.76,
      "formatted_start": "01:41:01.880",
      "formatted_end": "01:41:06.760",
      "text": "اینها نوع سازه تویین که باید دوجه دار داشته باشه، دوجه دار نداره"
    },
    {
      "id": 17,
      "start": 6066.76,
      "end": 6070.38,
      "formatted_start": "01:41:06.760",
      "formatted_end": "01:41:10.380",
      "text": "یکی، هرش کسی راه میره، تقطر رو کشت پایین میاد دیگه"
    },
    {
      "id": 18,
      "start": 6070.38,
      "end": 6073.76,
      "formatted_start": "01:41:10.380",
      "formatted_end": "01:41:13.760",
      "text": "مخصوصا اینکه پارکت باشه بیشتر"
    },
    {
      "id": 19,
      "start": 6073.76,
      "end": 6079.3,
      "formatted_start": "01:41:13.760",
      "formatted_end": "01:41:19.300",
      "text": "هنوشون سرامیکه، پارکته، پارکت بیشتر میشه صدا"
    },
    {
      "id": 20,
      "start": 6079.3,
      "end": 6081.3,
      "formatted_start": "01:41:19.300",
      "formatted_end": "01:41:21.300",
      "text": "پارکت برای خونه های بیلایی هست"
    },
    {
      "id": 21,
      "start": 6081.3,
      "end": 6083.3,
      "formatted_start": "01:41:21.300",
      "formatted_end": "01:41:23.300",
      "text": "تو طبعا پارکت استفاده شد"
    },
    {
      "id": 22,
      "start": 6083.3,
      "end": 6085.3,
      "formatted_start": "01:41:23.300",
      "formatted_end": "01:41:25.300",
      "text": "اینه تب سداخت کنه"
    },
    {
      "id": 23,
      "start": 6085.3,
      "end": 6087.3,
      "formatted_start": "01:41:25.300",
      "formatted_end": "01:41:27.300",
      "text": "حتی ممکنه پاینی هم راه بره"
    },
    {
      "id": 24,
      "start": 6087.3,
      "end": 6089.3,
      "formatted_start": "01:41:27.300",
      "formatted_end": "01:41:29.300",
      "text": "شما فکر کنید بالایی بزنید"
    },
    {
      "id": 25,
      "start": 6089.3,
      "end": 6091.3,
      "formatted_start": "01:41:29.300",
      "formatted_end": "01:41:31.300",
      "text": "این"
    },
    {
      "id": 26,
      "start": 6091.3,
      "end": 6093.3,
      "formatted_start": "01:41:31.300",
      "formatted_end": "01:41:33.300",
      "text": "در درگشت میگن تنافر"
    },
    {
      "id": 27,
      "start": 6093.3,
      "end": 6095.3,
      "formatted_start": "01:41:33.300",
      "formatted_end": "01:41:35.300",
      "text": "سداختی"
    },
    {
      "id": 28,
      "start": 6095.3,
      "end": 6097.3,
      "formatted_start": "01:41:35.300",
      "formatted_end": "01:41:37.300",
      "text": "دردور میشه"
    },
    {
      "id": 29,
      "start": 6097.3,
      "end": 6099.3,
      "formatted_start": "01:41:37.300",
      "formatted_end": "01:41:39.300",
      "text": "پاینی یه چیزی از لسه شو بیفته"
    },
    {
      "id": 30,
      "start": 6099.3,
      "end": 6101.3,
      "formatted_start": "01:41:39.300",
      "formatted_end": "01:41:41.300",
      "text": "شما فکر میکنید بالایی بفتاد"
    },
    {
      "id": 31,
      "start": 6101.3,
      "end": 6103.3,
      "formatted_start": "01:41:41.300",
      "formatted_end": "01:41:43.300",
      "text": "همه رو به اسم بالایی بیدویسید"
    },
    {
      "id": 32,
      "start": 6103.3,
      "end": 6105.3,
      "formatted_start": "01:41:43.300",
      "formatted_end": "01:41:45.300",
      "text": "خب حتی ممکنه بالایی نباشه"
    },
    {
      "id": 33,
      "start": 6105.3,
      "end": 6107.3,
      "formatted_start": "01:41:45.300",
      "formatted_end": "01:41:47.300",
      "text": "توی خونه"
    },
    {
      "id": 34,
      "start": 6107.3,
      "end": 6111.7,
      "formatted_start": "01:41:47.300",
      "formatted_end": "01:41:51.700",
      "text": "این یه پارکته تفتفتفت بزنه شما احساس کنید از بالا میرد"
    },
    {
      "id": 35,
      "start": 6111.7,
      "end": 6113.7,
      "formatted_start": "01:41:51.700",
      "formatted_end": "01:41:53.700",
      "text": "چون شما میان تبلیت"
    },
    {
      "id": 36,
      "start": 6113.7,
      "end": 6116.7,
      "formatted_start": "01:41:53.700",
      "formatted_end": "01:41:56.700",
      "text": "توی تبلیت زندگی میگوید"
    },
    {
      "id": 37,
      "start": 6116.7,
      "end": 6118.7,
      "formatted_start": "01:41:56.700",
      "formatted_end": "01:41:58.700",
      "text": "یه تبل بالایی یه تبل پایینی"
    },
    {
      "id": 38,
      "start": 6118.7,
      "end": 6122.7,
      "formatted_start": "01:41:58.700",
      "formatted_end": "01:42:02.700",
      "text": "شما یه صدایی تنافر پیدا میدونید میره برد میره"
    },
    {
      "id": 39,
      "start": 6122.7,
      "end": 6126.7,
      "formatted_start": "01:42:02.700",
      "formatted_end": "01:42:06.700",
      "text": "بعد اگه حساس بشید دیواره میشید"
    },
    {
      "id": 40,
      "start": 6126.7,
      "end": 6128.7,
      "formatted_start": "01:42:06.700",
      "formatted_end": "01:42:08.700",
      "text": "جایی بزنش شده"
    },
    {
      "id": 41,
      "start": 6128.7,
      "end": 6133.7,
      "formatted_start": "01:42:08.700",
      "formatted_end": "01:42:13.700",
      "text": "آمانون نمیدونند که شما میشنمید حتی دارند زندگی شده بودن"
    },
    {
      "id": 42,
      "start": 6133.7,
      "end": 6136.7,
      "formatted_start": "01:42:13.700",
      "formatted_end": "01:42:16.700",
      "text": "شما هم دارید برای پایینی نخشاب کنید بگوید"
    },
    {
      "id": 43,
      "start": 6136.7,
      "end": 6138.7,
      "formatted_start": "01:42:16.700",
      "formatted_end": "01:42:18.700",
      "text": "راه میرین، میرون راه نرم؟"
    },
    {
      "id": 44,
      "start": 6139.52,
      "end": 6141.52,
      "formatted_start": "01:42:19.520",
      "formatted_end": "01:42:21.520",
      "text": "خب راه میرین اون گیش نمه"
    },
    {
      "id": 45,
      "start": 6141.52,
      "end": 6142.7,
      "formatted_start": "01:42:21.520",
      "formatted_end": "01:42:22.700",
      "text": "میزتونو بخوایید"
    },
    {
      "id": 46,
      "start": 6142.7,
      "end": 6145.7,
      "formatted_start": "01:42:22.700",
      "formatted_end": "01:42:25.700",
      "text": "سندریتی میخوایید میشه اگه آمده اینجا سندری جا بی جا کردی شستی"
    },
    {
      "id": 47,
      "start": 6145.7,
      "end": 6148.7,
      "formatted_start": "01:42:25.700",
      "formatted_end": "01:42:28.700",
      "text": "مثل عادت انسان به هر جا میرسه سندری جا بی جا"
    },
    {
      "id": 48,
      "start": 6148.7,
      "end": 6151.7,
      "formatted_start": "01:42:28.700",
      "formatted_end": "01:42:31.700",
      "text": "میخوایید پشین سندریه کم رو اون سندریه نمیشه"
    },
    {
      "id": 49,
      "start": 6151.7,
      "end": 6153.7,
      "formatted_start": "01:42:31.700",
      "formatted_end": "01:42:33.700",
      "text": "این برای شما هم اتفاق میرده"
    },
    {
      "id": 50,
      "start": 6153.7,
      "end": 6155.7,
      "formatted_start": "01:42:33.700",
      "formatted_end": "01:42:35.700",
      "text": "میخوای سبحانه رو بر سندریت جا بی جا بکنو"
    },
    {
      "id": 51,
      "start": 6155.7,
      "end": 6157.7,
      "formatted_start": "01:42:35.700",
      "formatted_end": "01:42:37.700",
      "text": "پایینی یه جور حساس میکنه"
    },
    {
      "id": 52,
      "start": 6157.7,
      "end": 6158.7,
      "formatted_start": "01:42:37.700",
      "formatted_end": "01:42:38.700",
      "text": "این هست"
    },
    {
      "id": 53,
      "start": 6158.7,
      "end": 6162.2,
      "formatted_start": "01:42:38.700",
      "formatted_end": "01:42:42.200",
      "text": "اصلا ناشنوا بشید نسبت به این مسئله"
    },
    {
      "id": 54,
      "start": 6162.2,
      "end": 6164.7,
      "formatted_start": "01:42:42.200",
      "formatted_end": "01:42:44.700",
      "text": "یعنی مسئله صدای ساختمان"
    },
    {
      "id": 55,
      "start": 6164.7,
      "end": 6169.7,
      "formatted_start": "01:42:44.700",
      "formatted_end": "01:42:49.700",
      "text": "نه اینکه جشن بگیرن، قایپوبی خاصی بکنن"
    },
    {
      "id": 56,
      "start": 6169.7,
      "end": 6172.7,
      "formatted_start": "01:42:49.700",
      "formatted_end": "01:42:52.700",
      "text": "مثلا بتذکرون زندگی عادی صدای زندگی"
    },
    {
      "id": 57,
      "start": 6172.7,
      "end": 6175.7,
      "formatted_start": "01:42:52.700",
      "formatted_end": "01:42:55.700",
      "text": "این لو اشکال ساختمانهای ماست"
    },
    {
      "id": 58,
      "start": 6175.7,
      "end": 6179.7,
      "formatted_start": "01:42:55.700",
      "formatted_end": "01:42:59.700",
      "text": "ما همشتر این بالای ما راه میرن، تبتر بزنن"
    },
    {
      "id": 59,
      "start": 6179.7,
      "end": 6182.7,
      "formatted_start": "01:42:59.700",
      "formatted_end": "01:43:02.700",
      "text": "اینجا بالا سر ما قلی هست، اینالا قلی هست"
    },
    {
      "id": 60,
      "start": 6182.7,
      "end": 6185.7,
      "formatted_start": "01:43:02.700",
      "formatted_end": "01:43:05.700",
      "text": "هرکی میاد اساشو میزنه، بردو میخورد سر من"
    },
    {
      "id": 61,
      "start": 6185.7,
      "end": 6188.7,
      "formatted_start": "01:43:05.700",
      "formatted_end": "01:43:08.700",
      "text": "بردون بزنید توجه رو بزنید"
    },
    {
      "id": 62,
      "start": 6188.7,
      "end": 6189.7,
      "formatted_start": "01:43:08.700",
      "formatted_end": "01:43:09.700",
      "text": "همسا دارید"
    },
    {
      "id": 63,
      "start": 6189.7,
      "end": 6190.7,
      "formatted_start": "01:43:09.700",
      "formatted_end": "01:43:10.700",
      "text": "چون هم باید بی خیال باشید؟"
    },
    {
      "id": 64,
      "start": 6190.7,
      "end": 6192.7,
      "formatted_start": "01:43:10.700",
      "formatted_end": "01:43:12.700",
      "text": "صد بر صد بی خیال باشید"
    },
    {
      "id": 65,
      "start": 6192.7,
      "end": 6194.7,
      "formatted_start": "01:43:12.700",
      "formatted_end": "01:43:14.700",
      "text": "نه هر کم خیال باشید"
    },
    {
      "id": 66,
      "start": 6194.7,
      "end": 6197.7,
      "formatted_start": "01:43:14.700",
      "formatted_end": "01:43:17.700",
      "text": "آقا بی خیال باشید به خودتون آسیب میزنید"
    },
    {
      "id": 67,
      "start": 6197.7,
      "end": 6198.7,
      "formatted_start": "01:43:17.700",
      "formatted_end": "01:43:18.700",
      "text": "حالا آسیبیش رو دارید میبینید"
    },
    {
      "id": 68,
      "start": 6198.7,
      "end": 6202.7,
      "formatted_start": "01:43:18.700",
      "formatted_end": "01:43:22.700",
      "text": "دقیقه زیاد باعث این ترش و شیره میشه"
    },
    {
      "id": 69,
      "start": 6202.7,
      "end": 6206.7,
      "formatted_start": "01:43:22.700",
      "formatted_end": "01:43:26.700",
      "text": "دقیقه زیاد باعث کمی قایده یک تون میشه"
    },
    {
      "id": 70,
      "start": 6206.7,
      "end": 6209.7,
      "formatted_start": "01:43:26.700",
      "formatted_end": "01:43:29.700",
      "text": "حالا برقطه فشار داده باید رهم باد میکرد"
    },
    {
      "id": 71,
      "start": 6209.7,
      "end": 6215.7,
      "formatted_start": "01:43:29.700",
      "formatted_end": "01:43:35.700",
      "text": "از این رحم به این خوشگی مثل زن یا عزه هست"
    },
    {
      "id": 72,
      "start": 6215.7,
      "end": 6221.7,
      "formatted_start": "01:43:35.700",
      "formatted_end": "01:43:41.700",
      "text": "در اینکه 74 بیاره برسه خیلی سندتون کمه"
    },
    {
      "id": 73,
      "start": 6221.7,
      "end": 6227.7,
      "formatted_start": "01:43:41.700",
      "formatted_end": "01:43:47.700",
      "text": "خیلی سندتون کمه مثل یه زن 46 سال هست"
    },
    {
      "id": 74,
      "start": 6227.7,
      "end": 6229.7,
      "formatted_start": "01:43:47.700",
      "formatted_end": "01:43:49.700",
      "text": "اینجوری"
    },
    {
      "id": 75,
      "start": 6229.7,
      "end": 6233.7,
      "formatted_start": "01:43:49.700",
      "formatted_end": "01:43:53.700",
      "text": "باید اینکه اطمئن بیخیاری رو تمرین بکنید"
    },
    {
      "id": 76,
      "start": 6233.7,
      "end": 6238.7,
      "formatted_start": "01:43:53.700",
      "formatted_end": "01:43:58.700",
      "text": "حضرت علی میگه سبوری رو اگر تصابر بکنی واقعیت بدامی کنید"
    },
    {
      "id": 77,
      "start": 6238.7,
      "end": 6241.42,
      "formatted_start": "01:43:58.700",
      "formatted_end": "01:44:01.420",
      "text": "تنها صفتیه که باید تظاهر کنی بهش"
    },
    {
      "id": 78,
      "start": 6241.42,
      "end": 6243.92,
      "formatted_start": "01:44:01.420",
      "formatted_end": "01:44:03.920",
      "text": "سبوری رو تظاهر کنی"
    },
    {
      "id": 79,
      "start": 6243.92,
      "end": 6245.92,
      "formatted_start": "01:44:03.920",
      "formatted_end": "01:44:05.920",
      "text": "باید ظاهرن سبور بهشون بیدی"
    },
    {
      "id": 80,
      "start": 6245.92,
      "end": 6247.92,
      "formatted_start": "01:44:05.920",
      "formatted_end": "01:44:07.920",
      "text": "حتی اگه خودخوری داری"
    },
    {
      "id": 81,
      "start": 6247.92,
      "end": 6250.6,
      "formatted_start": "01:44:07.920",
      "formatted_end": "01:44:10.600",
      "text": "سبوری سبوری سبوری ببینی واقعا سبور شد"
    },
    {
      "id": 82,
      "start": 6250.6,
      "end": 6252.1,
      "formatted_start": "01:44:10.600",
      "formatted_end": "01:44:12.100",
      "text": "اینه چیز بکس نکرده باید"
    },
    {
      "id": 83,
      "start": 6252.1,
      "end": 6253.46,
      "formatted_start": "01:44:12.100",
      "formatted_end": "01:44:13.460",
      "text": "آقا بهشون بگو"
    },
    {
      "id": 84,
      "start": 6253.46,
      "end": 6255.46,
      "formatted_start": "01:44:13.460",
      "formatted_end": "01:44:15.460",
      "text": "اینجوری کنند آقا بهشون بگو"
    },
    {
      "id": 85,
      "start": 6255.46,
      "end": 6257.46,
      "formatted_start": "01:44:15.460",
      "formatted_end": "01:44:17.460",
      "text": "نمیتونه آقا بهشون بگه راه نری"
    },
    {
      "id": 86,
      "start": 6258.96,
      "end": 6259.7,
      "formatted_start": "01:44:18.960",
      "formatted_end": "01:44:19.700",
      "text": "خب؟"
    },
    {
      "id": 87,
      "start": 6259.7,
      "end": 6261.3,
      "formatted_start": "01:44:19.700",
      "formatted_end": "01:44:21.300",
      "text": "چقدر بی فرهنگ هست"
    },
    {
      "id": 88,
      "start": 6261.3,
      "end": 6262.22,
      "formatted_start": "01:44:21.300",
      "formatted_end": "01:44:22.220",
      "text": "اصلا نمیفهمه"
    },
    {
      "id": 89,
      "start": 6262.22,
      "end": 6263.66,
      "formatted_start": "01:44:22.220",
      "formatted_end": "01:44:23.660",
      "text": "سگ چرا تو ساخته رو؟"
    },
    {
      "id": 90,
      "start": 6263.66,
      "end": 6266.66,
      "formatted_start": "01:44:23.660",
      "formatted_end": "01:44:26.660",
      "text": "سگشون تو سوارد. سگ اتفاق صدایی نداره."
    },
    {
      "id": 91,
      "start": 6266.66,
      "end": 6271.66,
      "formatted_start": "01:44:26.660",
      "formatted_end": "01:44:31.660",
      "text": "صدایی برقبقشه. خب باید بهش قلاده پارس ببندن."
    },
    {
      "id": 92,
      "start": 6271.66,
      "end": 6275.66,
      "formatted_start": "01:44:31.660",
      "formatted_end": "01:44:35.660",
      "text": "این قلاده پارس دوستانه بهشون یاد بدید."
    },
    {
      "id": 93,
      "start": 6275.66,
      "end": 6279.66,
      "formatted_start": "01:44:35.660",
      "formatted_end": "01:44:39.660",
      "text": "یه قلاده هایی هست که مخصوص پارس نکردنه."
    },
    {
      "id": 94,
      "start": 6279.66,
      "end": 6281.66,
      "formatted_start": "01:44:39.660",
      "formatted_end": "01:44:41.660",
      "text": "برن از دکتر آرامون ببیرن."
    },
    {
      "id": 95,
      "start": 6281.66,
      "end": 6283.66,
      "formatted_start": "01:44:41.660",
      "formatted_end": "01:44:43.660",
      "text": "به فیارون سبلان."
    },
    {
      "id": 96,
      "start": 6283.66,
      "end": 6287.66,
      "formatted_start": "01:44:43.660",
      "formatted_end": "01:44:47.660",
      "text": "دام قزشگی آرامی."
    },
    {
      "id": 97,
      "start": 6287.66,
      "end": 6294.82,
      "formatted_start": "01:44:47.660",
      "formatted_end": "01:44:54.820",
      "text": "دو ساعت پارس کرد، دو ساعت پارس کرد، این دو ساعت رو صحبت کرد، این دو ساعت رو من درست کشیدم"
    },
    {
      "id": 98,
      "start": 6294.82,
      "end": 6299.86,
      "formatted_start": "01:44:54.820",
      "formatted_end": "01:44:59.860",
      "text": "بعد دو ساعت، خودم خسته شد، باید برسیم"
    }
  ],
  "status": "completed"
}