      "id": 89,
      "start": 7155.0,
      "end": 7157.0,
      "formatted_start": "01:59:15.000",
      "formatted_end": "01:59:17.000",
      "text": "نهار به نهار میکنی"
    },
    {
      "id": 90,
      "start": 7157.0,
      "end": 7159.0,
      "formatted_start": "01:59:17.000",
      "formatted_end": "01:59:19.000",
      "text": "یک قرص دیگم که امپار"
    },
    {
      "id": 91,
      "start": 7159.0,
      "end": 7161.0,
      "formatted_start": "01:59:19.000",
      "formatted_end": "01:59:21.000",
      "text": "قلبت میزام میشه"
    },
