    },
    {
      "id": 31,
      "start": 6972.0,
      "end": 6974.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:14.000",
      "text": "این کارنه در این رو برنامه بخورید"
    },
    {
      "id": 32,
      "start": 6974.0,
      "end": 6976.0,
      "formatted_start": "01:56:14.000",
      "formatted_end": "01:56:16.000",
