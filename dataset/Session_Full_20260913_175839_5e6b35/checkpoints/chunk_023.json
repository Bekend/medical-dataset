  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6908.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:08.000",
      "text": "اگر جمعه با تاریخ روزی بند نشکه ندارد، مراجعه بعدی، آزمایش هم حاضر شد."
    },
    {
      "id": 1,
      "start": 6908.0,
      "end": 6914.0,
      "formatted_start": "01:55:08.000",
      "formatted_end": "01:55:14.000",
      "text": "با همین یکی که آزمایش برای نگهت با همگی، با زبان که دیگر زیاد نشکردن."
    },
    {
      "id": 2,
      "start": 6914.0,
      "end": 6918.0,
      "formatted_start": "01:55:14.000",
      "formatted_end": "01:55:18.000",
      "text": "اونو بزار جای قایدگی با جا او بسانه آزمایش برد."
    },
    {
      "id": 3,
      "start": 6918.0,
      "end": 6919.0,
      "formatted_start": "01:55:18.000",
      "formatted_end": "01:55:19.000",
      "text": "۵۰۰۰۰"
    },
    {
      "id": 4,
      "start": 6919.0,
      "end": 6920.0,
      "formatted_start": "01:55:19.000",
      "formatted_end": "01:55:20.000",
      "text": "بفرما."
    },
    {
      "id": 5,
      "start": 6920.0,
      "end": 6922.0,
      "formatted_start": "01:55:20.000",
      "formatted_end": "01:55:22.000",
      "text": "چند دقیقه باشی؟"
    },
    {
      "id": 6,
      "start": 6922.0,
      "end": 6923.0,
      "formatted_start": "01:55:22.000",
      "formatted_end": "01:55:23.000",
      "text": "۱۰۰۰"
    },
    {
      "id": 7,
      "start": 6923.0,
      "end": 6924.0,
      "formatted_start": "01:55:23.000",
      "formatted_end": "01:55:24.000",
      "text": "باش."
    },
    {
      "id": 8,
      "start": 6924.0,
      "end": 6925.0,
      "formatted_start": "01:55:24.000",
      "formatted_end": "01:55:25.000",
      "text": "کارشو درد میره؟"
    },
    {
      "id": 9,
      "start": 6925.0,
      "end": 6926.0,
      "formatted_start": "01:55:25.000",
      "formatted_end": "01:55:26.000",
      "text": "۱۰۰۰"
    },
    {
      "id": 10,
      "start": 6926.0,
      "end": 6928.0,
      "formatted_start": "01:55:26.000",
      "formatted_end": "01:55:28.000",
      "text": "خدا میکنم"
    },
    {
      "id": 11,
      "start": 6928.0,
      "end": 6930.0,
      "formatted_start": "01:55:28.000",
      "formatted_end": "01:55:30.000",
