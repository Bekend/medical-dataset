      "start": 7161.0,
      "end": 7163.0,
      "formatted_start": "01:59:21.000",
      "formatted_end": "01:59:23.000",
      "text": "با کپسول بیابت هم"
    },
    {
      "id": 93,
      "start": 7163.0,
      "end": 7165.0,
      "formatted_start": "01:59:23.000",
      "formatted_end": "01:59:25.000",
      "text": "بفروم شست"
    },
    {
      "id": 94,
      "start": 7165.0,
      "end": 7167.0,
      "formatted_start": "01:59:25.000",
      "formatted_end": "01:59:27.000",
      "text": "یک تا سه هم"
    },
    {
      "id": 95,
      "start": 7167.0,
      "end": 7169.0,
      "formatted_start": "01:59:27.000",
      "formatted_end": "01:59:29.000",
      "text": "یک"
    },
    {
