      "start": 6992.0,
      "end": 6994.0,
      "formatted_start": "01:56:32.000",
      "formatted_end": "01:56:34.000",
      "text": "که خواه افتاده هست"
    },
    {
      "id": 42,
      "start": 6994.0,
      "end": 6996.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:36.000",
      "text": "خب الان این پره دیگه درسته؟"
    },
    {
      "id": 43,
      "start": 6996.0,
      "end": 6998.0,
      "formatted_start": "01:56:36.000",
      "formatted_end": "01:56:38.000",
      "text": "این پیش رو باز کردم"
    },
    {
      "id": 44,
      "start": 6998.0,
      "end": 7000.0,
      "formatted_start": "01:56:38.000",
      "formatted_end": "01:56:40.000",
      "text": "پایین اینجا باز نکردم"
    },
    {
      "id": 45,
      "start": 7000.0,
      "end": 7002.0,
      "formatted_start": "01:56:40.000",
      "formatted_end": "01:56:42.000",
      "text": "خب اشکال نداره"
    },
    {
      "id": 46,
      "start": 7002.0,
      "end": 7004.0,
      "formatted_start": "01:56:42.000",
      "formatted_end": "01:56:44.000",
      "text": "از این ها؟ اشکال نداره"
    },
    {
      "id": 47,
      "start": 7004.0,
      "end": 7006.0,
      "formatted_start": "01:56:44.000",
      "formatted_end": "01:56:46.000",
      "text": "همینو شما صبح و غروب بخور"
    },
    {
      "id": 48,
      "start": 7006.0,
      "end": 7008.0,
      "formatted_start": "01:56:46.000",
      "formatted_end": "01:56:48.000",
      "text": "برای زهر اینا رو صبح و شب بخورد"
    },
    {
      "id": 49,
      "start": 7008.0,
      "end": 7010.0,
      "formatted_start": "01:56:48.000",
      "formatted_end": "01:56:50.000",
      "text": "خب زهر نداره"
    },
    {
      "id": 50,
      "start": 7010.0,
      "end": 7016.0,
      "formatted_start": "01:56:50.000",
      "formatted_end": "01:56:56.000",
      "text": "از کنار زهر 500 دیگه ای میذارم که اون رنده رو درست میکنم"
    },
    {
      "id": 51,
      "start": 7016.0,
      "end": 7018.0,
      "formatted_start": "01:56:56.000",
      "formatted_end": "01:56:58.000",
      "text": "اسمش متفاوت"
    },
    {
      "id": 52,
      "start": 7018.0,
      "end": 7022.0,
      "formatted_start": "01:56:58.000",
      "formatted_end": "01:57:02.000",
      "text": "این در مورد یک ترخ هست و یک نقومه کامل پرامون کنه"
    },
    {
      "id": 53,
      "start": 7022.0,
      "end": 7027.0,
      "formatted_start": "01:57:02.000",
      "formatted_end": "01:57:07.000",
      "text": "زهرها یک عدد، پابون مال زهر رو درست ندارم"
    },
    {
      "id": 54,
      "start": 7027.0,
      "end": 7032.0,
      "formatted_start": "01:57:07.000",
      "formatted_end": "01:57:12.000",
      "text": "و این هم که ۵۸ تشاره"
    },
    {
      "id": 55,
      "start": 7032.0,
      "end": 7037.0,
      "formatted_start": "01:57:12.000",
      "formatted_end": "01:57:17.000",
      "text": "این ۱۵۰"
    },
    {
      "id": 56,
      "start": 7037.0,
      "end": 7041.9,
      "formatted_start": "01:57:17.000",
      "formatted_end": "01:57:21.900",
      "text": "پشارم روز گرفته دیر 13 بود این ها رو درده این ها پشارم میگیرم"
    },
    {
      "id": 57,
      "start": 7041.9,
      "end": 7042.58,
      "formatted_start": "01:57:21.900",
      "formatted_end": "01:57:22.580",
      "text": "الان میگیرم الان میگیرم"
    },
    {
      "id": 58,
      "start": 7042.58,
      "end": 7045.54,
      "formatted_start": "01:57:22.580",
      "formatted_end": "01:57:25.540",
      "text": "اکی دیگه همون کنه ببخشی سوال مکنه من"
    },
    {
      "id": 59,
      "start": 7045.54,
      "end": 7046.46,
      "formatted_start": "01:57:25.540",
      "formatted_end": "01:57:26.460",
      "text": "نه بیفرما"
    },
    {
      "id": 60,
      "start": 7046.46,
      "end": 7047.18,
      "formatted_start": "01:57:26.460",
      "formatted_end": "01:57:27.180",
      "text": "چون این"
    },
    {
      "id": 61,
      "start": 7047.18,
      "end": 7048.52,
      "formatted_start": "01:57:27.180",
      "formatted_end": "01:57:28.520",
      "text": "خودت بودی؟"
    },
    {
      "id": 62,
      "start": 7048.52,
      "end": 7052.0,
      "formatted_start": "01:57:28.520",
      "formatted_end": "01:57:32.000",
      "text": "آره آره این 5-8 دارد ورم پا داری یا نه؟"
    },
    {
      "id": 63,
      "start": 7052.94,
      "end": 7056.96,
      "formatted_start": "01:57:32.940",
      "formatted_end": "01:57:36.960",
      "text": "ورم پا داری خاله؟"
    },
    {
      "id": 64,
      "start": 7056.96,
      "end": 7058.46,
      "formatted_start": "01:57:36.960",
      "formatted_end": "01:57:38.460",
      "text": "نه خونه پا مزده"
    },
    {
      "id": 65,
      "start": 7058.46,
      "end": 7059.24,
      "formatted_start": "01:57:38.460",
      "formatted_end": "01:57:39.240",
