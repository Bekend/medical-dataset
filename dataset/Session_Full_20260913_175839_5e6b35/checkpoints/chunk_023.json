    },
    {
      "id": 66,
      "start": 7059.24,
      "end": 7060.74,
      "formatted_start": "01:57:39.240",
      "formatted_end": "01:57:40.740",
      "text": "شبه دیگه بخواد"
    },
    {
      "id": 67,
      "start": 7060.74,
      "end": 7063.44,
      "formatted_start": "01:57:40.740",
      "formatted_end": "01:57:43.440",
      "text": "اون روز چند بود پشاره؟"
    },
    {
      "id": 68,
      "start": 7063.44,
      "end": 7064.32,
      "formatted_start": "01:57:43.440",
      "formatted_end": "01:57:44.320",
      "text": "13 بود"
    },
    {
      "id": 69,
      "start": 7067.0,
      "end": 7087.0,
      "formatted_start": "01:57:47.000",
      "formatted_end": "01:58:07.000",
      "text": "موسیقی"
    },
    {
      "id": 70,
      "start": 7087.0,
      "end": 7089.0,
      "formatted_start": "01:58:07.000",
      "formatted_end": "01:58:09.000",
      "text": "نوازده ایست"
    },
    {
      "id": 71,
      "start": 7089.0,
      "end": 7091.0,
      "formatted_start": "01:58:09.000",
      "formatted_end": "01:58:11.000",
      "text": "حالا دوازده ای"
    },
    {
      "id": 72,
      "start": 7091.0,
      "end": 7093.0,
      "formatted_start": "01:58:11.000",
      "formatted_end": "01:58:13.000",
      "text": "نوازده بود"
    },
    {
      "id": 73,
      "start": 7095.0,
      "end": 7097.0,
      "formatted_start": "01:58:15.000",
      "formatted_end": "01:58:17.000",
      "text": "از این چند فردی در یاد شوید؟"
    },
    {
      "id": 74,
      "start": 7097.0,
      "end": 7099.0,
      "formatted_start": "01:58:17.000",
      "formatted_end": "01:58:19.000",
      "text": "از این یه بسته دارم"
    },
    {
      "id": 75,
      "start": 7099.0,
      "end": 7101.0,
      "formatted_start": "01:58:19.000",
      "formatted_end": "01:58:21.000",
      "text": "آه داریم"
    },
    {
      "id": 76,
      "start": 7101.0,
      "end": 7103.0,
      "formatted_start": "01:58:21.000",
      "formatted_end": "01:58:23.000",
      "text": "خیلی دست داری؟"
    },
    {
      "id": 77,
      "start": 7103.0,
      "end": 7105.0,
      "formatted_start": "01:58:23.000",
      "formatted_end": "01:58:25.000",
      "text": "باشه ها خواهنم"
    },
    {
      "id": 78,
      "start": 7105.0,
      "end": 7107.0,
      "formatted_start": "01:58:25.000",
      "formatted_end": "01:58:27.000",
      "text": "باشه ها خواهنم باشه"
    },
    {
      "id": 79,
      "start": 7107.0,
      "end": 7109.0,
      "formatted_start": "01:58:27.000",
      "formatted_end": "01:58:29.000",
      "text": "باشه ها خواهنم باشه"
    },
    {
      "id": 80,
      "start": 7109.0,
      "end": 7111.0,
      "formatted_start": "01:58:29.000",
      "formatted_end": "01:58:31.000",
      "text": "باشه ها خواهنم باشه"
    },
    {
      "id": 81,
      "start": 7111.0,
      "end": 7113.0,
      "formatted_start": "01:58:31.000",
      "formatted_end": "01:58:33.000",
      "text": "باشه ها خواهنم باشه"
    },
    {
      "id": 82,
      "start": 7113.0,
      "end": 7115.0,
      "formatted_start": "01:58:33.000",
      "formatted_end": "01:58:35.000",
      "text": "باشه ها خواهنم باشه"
    },
    {
      "id": 83,
      "start": 7115.0,
      "end": 7145.0,
      "formatted_start": "01:58:35.000",
      "formatted_end": "01:59:05.000",
      "text": "این کار را برای اینجا برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای"
    },
    {
      "id": 84,
      "start": 7145.0,
      "end": 7147.0,
      "formatted_start": "01:59:05.000",
      "formatted_end": "01:59:07.000",
      "text": "حالا درست داریم"
    },
    {
      "id": 85,
      "start": 7147.0,
      "end": 7149.0,
      "formatted_start": "01:59:07.000",
      "formatted_end": "01:59:09.000",
      "text": "اینه که بود"
    },
    {
      "id": 86,
      "start": 7149.0,
      "end": 7151.0,
      "formatted_start": "01:59:09.000",
      "formatted_end": "01:59:11.000",
      "text": "اینه که سه همه سی"
    },
    {
      "id": 87,
      "start": 7151.0,
      "end": 7153.0,
      "formatted_start": "01:59:11.000",
      "formatted_end": "01:59:13.000",
      "text": "اینه پس شد صبح و شب"
    },
    {
      "id": 88,
      "start": 7153.0,
      "end": 7155.0,
      "formatted_start": "01:59:13.000",
      "formatted_end": "01:59:15.000",
      "text": "برای صبح یک قرص برق بزرگی نوشتن"
    },
