    },
    {
      "id": 27,
      "start": 6960.0,
      "end": 6962.0,
      "formatted_start": "01:56:00.000",
      "formatted_end": "01:56:02.000",
      "text": "این هزار رو سه بار بخورید"
    },
    {
      "id": 28,
      "start": 6962.0,
      "end": 6964.0,
      "formatted_start": "01:56:02.000",
      "formatted_end": "01:56:04.000",
