  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12608.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:08.000",
      "text": "این ها شجاع میشن میخورن، میدن دیگه خوب شدن دیگه میخورن. قلب خوب شدن نیداره تا آخر عمره."
    },
    {
      "id": 1,
      "start": 12608.0,
      "end": 12618.0,
      "formatted_start": "03:30:08.000",
      "formatted_end": "03:30:18.000",
      "text": "باید نوع قضاتو عوض کنید، برنج و نانو باید بزرگ کنار، مکارونی و رشته فرنگی و رشته آشه رشته و حلیمو بزرگ کنار."
    },
    {
      "id": 2,
      "start": 12618.0,
      "end": 12630.0,
      "formatted_start": "03:30:18.000",
      "formatted_end": "03:30:30.000",
      "text": "چیزهای جالیزی بخوری، کدو، کلم، کرفت، بادنجان، بوجه، خیار، اینها رو باید کت کنی اینجوری، پختنی هاشو بپذیر، خاماش هم خام بخوری"
    },
    {
      "id": 3,
      "start": 12630.0,
      "end": 12641.0,
      "formatted_start": "03:30:30.000",
      "formatted_end": "03:30:41.000",
      "text": "میوه زیاد بخوری، میوه های شیرین خیلی شیرین مثلا نکنی، نشسته رو حص بکنی، ورزش تو زندگی همیشه باشه"
    },
    {
      "id": 4,
      "start": 12641.0,
      "end": 12644.0,
      "formatted_start": "03:30:41.000",
      "formatted_end": "03:30:44.000",
      "text": "دارو هم همینو که اسپوردی خوبن"
    },
    {
      "id": 5,
      "start": 12644.0,
      "end": 12647.0,
      "formatted_start": "03:30:44.000",
      "formatted_end": "03:30:47.000",
      "text": "میت فورمینو زیب میتو"
    },
    {
      "id": 6,
      "start": 12647.0,
      "end": 12650.0,
      "formatted_start": "03:30:47.000",
      "formatted_end": "03:30:50.000",
      "text": "میدونم گلوره تاو و گلوره پاو"
    },
    {
      "id": 7,
      "start": 12650.0,
      "end": 12653.0,
      "formatted_start": "03:30:50.000",
      "formatted_end": "03:30:53.000",
      "text": "خوشتو دارو هم که باید بیانی رو زیر"
    },
    {
      "id": 8,
      "start": 12653.0,
      "end": 12656.0,
      "formatted_start": "03:30:53.000",
      "formatted_end": "03:30:56.000",
      "text": "صد و پنجاه قنده تو که همین صد و سیم میگی"
    },
    {
      "id": 9,
      "start": 12656.0,
      "end": 12659.0,
      "formatted_start": "03:30:56.000",
      "formatted_end": "03:30:59.000",
      "text": "زیر صد و پنجاه اومده دیگه ناشتا"
    },
    {
      "id": 10,
      "start": 12659.0,
      "end": 12662.0,
      "formatted_start": "03:30:59.000",
      "formatted_end": "03:31:02.000",
      "text": "زیر صد و پنجاه اومده"
    },
    {
      "id": 11,
      "start": 12662.0,
      "end": 12665.0,
      "formatted_start": "03:31:02.000",
      "formatted_end": "03:31:05.000",
      "text": "باید بگمانه که با فردا میره با الان"
    },
    {
      "id": 12,
      "start": 12665.0,
      "end": 12668.0,
      "formatted_start": "03:31:05.000",
      "formatted_end": "03:31:08.000",
      "text": "باید دیگه عشق داری هدف اینه اما این قنده"
    },
    {
      "id": 13,
      "start": 12668.0,
      "end": 12673.18,
      "formatted_start": "03:31:08.000",
      "formatted_end": "03:31:13.180",
      "text": "مسئله آلرژیت یه چیزیه که باعث داروم و دام استفاده کنید"
    },
    {
      "id": 14,
      "start": 12673.18,
      "end": 12680.48,
      "formatted_start": "03:31:13.180",
      "formatted_end": "03:31:20.480",
      "text": "خیلی از اینکه آلرژی دارید منطقه زنانه یه منطقه آرچ پرورد"
    },
    {
      "id": 15,
      "start": 12680.48,
      "end": 12683.24,
      "formatted_start": "03:31:20.480",
      "formatted_end": "03:31:23.240",
      "text": "که در غندی که همینجوری آرچ میگید"
    },
    {
      "id": 16,
      "start": 12683.24,
      "end": 12684.24,
      "formatted_start": "03:31:23.240",
      "formatted_end": "03:31:24.240",
      "text": "آرچید"
    },
    {
      "id": 17,
      "start": 12684.24,
      "end": 12685.24,
      "formatted_start": "03:31:24.240",
      "formatted_end": "03:31:25.240",
      "text": "بله"
    },
    {
      "id": 18,
      "start": 12685.24,
      "end": 12689.16,
      "formatted_start": "03:31:25.240",
      "formatted_end": "03:31:29.160",
      "text": "باید فکس و فنادین سبایشتار"
    },
    {
      "id": 19,
      "start": 12689.16,
      "end": 12691.0,
      "formatted_start": "03:31:29.160",
      "formatted_end": "03:31:31.000",
      "text": "شبیه یک دانه"
    },
    {
      "id": 20,
      "start": 12691.0,
      "end": 12693.9,
      "formatted_start": "03:31:31.000",
      "formatted_end": "03:31:33.900",
      "text": "یک دانه پرس فکس و فنادین شبکه میخوریم"
    },
    {
      "id": 21,
      "start": 12693.9,
      "end": 12697.28,
      "formatted_start": "03:31:33.900",
      "formatted_end": "03:31:37.280",
      "text": "کرمه، باجیدار، کلورترین محضور"
    },
    {
      "id": 22,
      "start": 12697.28,
      "end": 12699.28,
      "formatted_start": "03:31:37.280",
      "formatted_end": "03:31:39.280",
      "text": "همه زن ها میدن و اثر نریک کنید"
    },
    {
      "id": 23,
      "start": 12699.28,
      "end": 12701.28,
      "formatted_start": "03:31:39.280",
      "formatted_end": "03:31:41.280",
      "text": "حالا ما یه جوره دیگه میدیم"
    },
    {
      "id": 24,
      "start": 12701.28,
      "end": 12703.28,
      "formatted_start": "03:31:41.280",
      "formatted_end": "03:31:43.280",
      "text": "یه داروی دست داز میدیم"
    },
    {
      "id": 25,
      "start": 12703.28,
      "end": 12705.28,
      "formatted_start": "03:31:43.280",
      "formatted_end": "03:31:45.280",
      "text": "بیرونی بدن"
    },
    {
      "id": 26,
      "start": 12705.28,
      "end": 12707.28,
      "formatted_start": "03:31:45.280",
      "formatted_end": "03:31:47.280",
      "text": "دکترین جدیدن"
    },
    {
      "id": 27,
      "start": 12707.28,
      "end": 12709.28,
      "formatted_start": "03:31:47.280",
      "formatted_end": "03:31:49.280",
      "text": "یکم پاهاش دانه زده خیلی بی خواره"
    },
    {
      "id": 28,
      "start": 12709.28,
      "end": 12711.28,
      "formatted_start": "03:31:49.280",
      "formatted_end": "03:31:51.280",
      "text": "ببینیم جای"
    },
    {
      "id": 29,
      "start": 12711.28,
      "end": 12713.28,
      "formatted_start": "03:31:51.280",
      "formatted_end": "03:31:53.280",
      "text": "اون شروعه که بشه"
    },
    {
      "id": 30,
      "start": 12713.28,
      "end": 12715.28,
      "formatted_start": "03:31:53.280",
      "formatted_end": "03:31:55.280",
      "text": "باشو بازم نشان بده"
    },
    {
      "id": 31,
      "start": 12715.28,
      "end": 12717.28,
      "formatted_start": "03:31:55.280",
      "formatted_end": "03:31:57.280",
      "text": "هرچی نشان بیشتر بگی"
    },
    {
      "id": 32,
      "start": 12717.28,
      "end": 12719.28,
      "formatted_start": "03:31:57.280",
      "formatted_end": "03:31:59.280",
      "text": "پیزش راه نماری میشه"
    },
    {
      "id": 33,
      "start": 12719.28,
      "end": 12721.28,
      "formatted_start": "03:31:59.280",
      "formatted_end": "03:32:01.280",
      "text": "قهره راه جشن"
    },
    {
      "id": 34,
      "start": 12721.28,
      "end": 12723.28,
      "formatted_start": "03:32:01.280",
      "formatted_end": "03:32:03.280",
      "text": "پس همینهایی کلم دارم دارم ترکیب میدیسم"
    },
    {
      "id": 35,
      "start": 12723.28,
      "end": 12725.28,
      "formatted_start": "03:32:03.280",
      "formatted_end": "03:32:05.280",
      "text": "همینها هم"
    },
    {
      "id": 36,
      "start": 12725.28,
      "end": 12727.28,
      "formatted_start": "03:32:05.280",
      "formatted_end": "03:32:07.280",
      "text": "این رو بگیرم."
    },
    {
      "id": 37,
      "start": 12730.88,
      "end": 12736.34,
      "formatted_start": "03:32:10.880",
      "formatted_end": "03:32:16.340",
      "text": "در اینجا، این همه چیزهایی هستند که از آن آزمایش هایی هستند."
    },
    {
      "id": 38,
      "start": 12736.48,
      "end": 12738.48,
      "formatted_start": "03:32:16.480",
      "formatted_end": "03:32:18.480",
      "text": "بله، دیدم."
    },
    {
      "id": 39,
      "start": 12738.86,
      "end": 12740.86,
      "formatted_start": "03:32:18.860",
      "formatted_end": "03:32:20.860",
      "text": "اون کمکونی ها شد."
    },
    {
      "id": 40,
      "start": 12741.0,
      "end": 12743.0,
      "formatted_start": "03:32:21.000",
      "formatted_end": "03:32:23.000",
      "text": "به روی چشم."
    },
    {
      "id": 41,
      "start": 12755.28,
      "end": 12757.28,
      "formatted_start": "03:32:35.280",
      "formatted_end": "03:32:37.280",
      "text": "این کار رو پیرسی کنم"
    },
    {
      "id": 42,
      "start": 12761.28,
      "end": 12763.28,
      "formatted_start": "03:32:41.280",
      "formatted_end": "03:32:43.280",
      "text": "یعنی قم باید میشه که قارش بیشتر بشه؟"
    },
    {
      "id": 43,
      "start": 12763.28,
      "end": 12765.28,
      "formatted_start": "03:32:43.280",
      "formatted_end": "03:32:45.280",
      "text": "قارش بیشتر بله"
    },
    {
      "id": 44,
      "start": 12765.28,
      "end": 12767.28,
      "formatted_start": "03:32:45.280",
      "formatted_end": "03:32:47.280",
      "text": "پوست داره عرق شیرین میشه"
    },
    {
      "id": 45,
      "start": 12767.28,
      "end": 12769.28,
      "formatted_start": "03:32:47.280",
      "formatted_end": "03:32:49.280",
      "text": "عرق شیرین، آفتاب هم نمیبینه"
    },
    {
      "id": 46,
      "start": 12769.28,
      "end": 12771.28,
      "formatted_start": "03:32:49.280",
      "formatted_end": "03:32:51.280",
      "text": "جاهایی که آفتاب هم بینه"
    },
    {
      "id": 47,
      "start": 12771.28,
      "end": 12773.28,
      "formatted_start": "03:32:51.280",
      "formatted_end": "03:32:53.280",
      "text": "قارش بیشتر بشه"
    },
    {
      "id": 48,
      "start": 12773.28,
      "end": 12775.28,
      "formatted_start": "03:32:53.280",
      "formatted_end": "03:32:55.280",
      "text": "این زنده قارش خیلی خوب میده"
    },
    {
      "id": 49,
      "start": 12775.28,
      "end": 12777.28,
      "formatted_start": "03:32:55.280",
      "formatted_end": "03:32:57.280",
      "text": "شامپوی بدن میکنه"
    },
    {
      "id": 50,
      "start": 12777.28,
      "end": 12779.28,
      "formatted_start": "03:32:57.280",
      "formatted_end": "03:32:59.280",
      "text": "ظلم میده به شما"
    },
    {
      "id": 51,
      "start": 12779.28,
      "end": 12781.28,
      "formatted_start": "03:32:59.280",
      "formatted_end": "03:33:01.280",
      "text": "این خیلی شامپوی قویه"
    },
    {
      "id": 52,
      "start": 12781.28,
      "end": 12783.28,
      "formatted_start": "03:33:01.280",
      "formatted_end": "03:33:03.280",
      "text": "با این همیشه شامپوی بدن زوره"
    },
    {
      "id": 53,
      "start": 12783.28,
      "end": 12789.28,
      "formatted_start": "03:33:03.280",
      "formatted_end": "03:33:09.280",
      "text": "همین سابون گلنار، روکس، اینها به نظر تمیز می کنند، آرز را افزایش می دهند، خواهش با بیشتر بشه"
    },
    {
      "id": 54,
      "start": 12789.28,
      "end": 12803.28,
      "formatted_start": "03:33:09.280",
      "formatted_end": "03:33:23.280",
      "text": "خواهش با بیشتر بشه"
    },
    {
      "id": 55,
      "start": 12803.28,
      "end": 12809.28,
      "formatted_start": "03:33:23.280",
      "formatted_end": "03:33:29.280",
      "text": "چند جور کرپ هست مخلوق می کنند، تو کاسه به شما می دهند، این کاسه گیر را تو یخ چار بزاروند"
    },
    {
      "id": 56,
      "start": 12809.28,
      "end": 12814.42,
      "formatted_start": "03:33:29.280",
      "formatted_end": "03:33:34.420",
      "text": "از این دو بار منطقه هایی که خارج میده پای پاشن مرد هر جا هست میزن"
    },
    {
      "id": 57,
      "start": 12814.42,
      "end": 12817.12,
      "formatted_start": "03:33:34.420",
      "formatted_end": "03:33:37.120",
      "text": "یه پامات داخلی هست که شب شب یکم دست بده"
    },
    {
      "id": 58,
      "start": 12817.12,
      "end": 12826.12,
      "formatted_start": "03:33:37.120",
      "formatted_end": "03:33:46.120",
      "text": "این پماد دستاز مدتش در پوست داخلی که پمادش تو داره خارجی هم که پمادش دستازه دیگه به پوست هرجام میزنید"
    },
    {
      "id": 59,
      "start": 12826.12,
      "end": 12831.12,
      "formatted_start": "03:33:46.120",
      "formatted_end": "03:33:51.120",
      "text": "این پماد خارجی فرمولشو گم نکنید که باز باید تغییرش بدم دو همدرگه"
    },
    {
      "id": 60,
      "start": 12831.12,
      "end": 12838.12,
      "formatted_start": "03:33:51.120",
      "formatted_end": "03:33:58.120",
      "text": "دکتر جون یک چند برک ست بکس دویست اگر اضافه کنید شرمنده"
    },
    {
      "id": 61,
      "start": 12838.12,
      "end": 12841.12,
      "formatted_start": "03:33:58.120",
      "formatted_end": "03:34:01.120",
      "text": "بردی چند بردی چه پنجه دارم بردی سی پنجه"
    },
    {
      "id": 62,
      "start": 12841.12,
      "end": 12842.12,
      "formatted_start": "03:34:01.120",
      "formatted_end": "03:34:02.120",
      "text": "سی تا که میدونیم پنجه"
    },
    {
      "id": 63,
      "start": 12842.12,
      "end": 12843.12,
      "formatted_start": "03:34:02.120",
      "formatted_end": "03:34:03.120",
      "text": "آخروز دارم پاهم"
    },
    {
      "id": 64,
      "start": 12843.12,
      "end": 12845.12,
      "formatted_start": "03:34:03.120",
      "formatted_end": "03:34:05.120",
      "text": "برای چنین پنه خود میشن خوبه بخوره"
    },
    {
      "id": 65,
      "start": 12845.12,
      "end": 12847.12,
      "formatted_start": "03:34:05.120",
      "formatted_end": "03:34:07.120",
      "text": "دست شما درمه"
    },
    {
      "id": 66,
      "start": 12847.12,
      "end": 12849.12,
      "formatted_start": "03:34:07.120",
      "formatted_end": "03:34:09.120",
      "text": "گهگاه بخور همیشه بخوره"
    },
    {
      "id": 67,
      "start": 12849.12,
      "end": 12855.12,
      "formatted_start": "03:34:09.120",
      "formatted_end": "03:34:15.120",
      "text": "بله اون مسئله کمخونیت اینا هم که ایمونه اسمش مامی در سیران"
    },
    {
      "id": 68,
      "start": 12855.12,
      "end": 12859.12,
      "formatted_start": "03:34:15.120",
      "formatted_end": "03:34:19.120",
      "text": "باید از ما شدید نخور میشن"
    },
    {
      "id": 69,
      "start": 12859.12,
      "end": 12862.12,
      "formatted_start": "03:34:19.120",
      "formatted_end": "03:34:22.120",
      "text": "اول توقع به خدای شامپون بدن میکنه"
    },
    {
      "id": 70,
      "start": 12862.12,
      "end": 12864.12,
      "formatted_start": "03:34:22.120",
      "formatted_end": "03:34:24.120",
      "text": "این خیلی خوبه بخوره"
    },
    {
      "id": 71,
      "start": 12864.12,
      "end": 12867.12,
      "formatted_start": "03:34:24.120",
      "formatted_end": "03:34:27.120",
      "text": "کودشون رو بسیار برم نیم"
    },
    {
      "id": 72,
      "start": 12867.12,
      "end": 12869.12,
      "formatted_start": "03:34:27.120",
      "formatted_end": "03:34:29.120",
      "text": "خوبه باشه"
    },
    {
      "id": 73,
      "start": 12869.12,
      "end": 12878.12,
      "formatted_start": "03:34:29.120",
      "formatted_end": "03:34:38.120",
      "text": "دو هفته دیگه برای خوارشات باید دهیم"
    },
    {
      "id": 74,
      "start": 12878.12,
      "end": 12881.12,
      "formatted_start": "03:34:38.120",
      "formatted_end": "03:34:41.120",
      "text": "نسخه قبلی هم همراه باشه؟"
    },
    {
      "id": 75,
      "start": 12881.12,
      "end": 12884.12,
      "formatted_start": "03:34:41.120",
      "formatted_end": "03:34:44.120",
      "text": "حتما اگر اداره اینجایی که ندادن نیست"
    },
    {
      "id": 76,
      "start": 12884.12,
      "end": 12888.12,
      "formatted_start": "03:34:44.120",
      "formatted_end": "03:34:48.120",
      "text": "شما تکمیلیش رو از داروخانه میگیرید"
    },
    {
      "id": 77,
      "start": 12888.12,
      "end": 12890.12,
      "formatted_start": "03:34:48.120",
      "formatted_end": "03:34:50.120",
      "text": "اگر جایی میکنه ازش عکس بگیرید"
    },
    {
      "id": 78,
      "start": 12890.12,
      "end": 12891.12,
      "formatted_start": "03:34:50.120",
      "formatted_end": "03:34:51.120",
      "text": "نسخه بمانید"
    },
    {
      "id": 79,
      "start": 12891.12,
      "end": 12894.12,
      "formatted_start": "03:34:51.120",
      "formatted_end": "03:34:54.120",
      "text": "هم ببینیم از چه داروی چه هرمونی نوشتن"
    },
    {
      "id": 80,
      "start": 12894.12,
      "end": 12896.12,
      "formatted_start": "03:34:54.120",
      "formatted_end": "03:34:56.120",
      "text": "ادامه شده از دیگه ها"
    }
  ],
  "status": "completed"
}