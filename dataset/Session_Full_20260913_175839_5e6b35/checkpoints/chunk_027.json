  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8104.32,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:04.320",
      "text": "داشتم، جوری دارم، ولی اون کار راه درتباط نبوده."
    },
    {
      "id": 1,
      "start": 8104.32,
      "end": 8108.1,
      "formatted_start": "02:15:04.320",
      "formatted_end": "02:15:08.100",
      "text": "آه، تو نبودی، ولی اون شاید خوششیرین نمیکرده، تو نمیکردی؟"
    },
    {
      "id": 2,
      "start": 8108.1,
      "end": 8110.8,
      "formatted_start": "02:15:08.100",
      "formatted_end": "02:15:10.800",
      "text": "نه، بس اونها نمیدونی، دکتوری کم."
    },
    {
      "id": 3,
      "start": 8110.8,
      "end": 8111.8,
      "formatted_start": "02:15:10.800",
      "formatted_end": "02:15:11.800",
      "text": "نمیرفتی دیدنشون؟"
    },
    {
      "id": 4,
      "start": 8111.8,
      "end": 8113.8,
      "formatted_start": "02:15:11.800",
      "formatted_end": "02:15:13.800",
      "text": "نه، اونها چون تیران هست."
    },
    {
      "id": 5,
      "start": 8113.8,
      "end": 8115.0,
      "formatted_start": "02:15:13.800",
      "formatted_end": "02:15:15.000",
      "text": "مادر شوهد تیران بود از اونجا؟"
    },
    {
      "id": 6,
      "start": 8115.0,
      "end": 8116.0,
      "formatted_start": "02:15:15.000",
      "formatted_end": "02:15:16.000",
      "text": "نه، نه، جاری."
    },
    {
      "id": 7,
      "start": 8116.0,
      "end": 8117.7,
      "formatted_start": "02:15:16.000",
      "formatted_end": "02:15:17.700",
      "text": "جاری داری، مادر شوهد اینجا بود؟"
    },
    {
      "id": 8,
      "start": 8117.7,
      "end": 8118.4,
      "formatted_start": "02:15:17.700",
      "formatted_end": "02:15:18.400",
      "text": "توی فارس هست."
    },
    {
      "id": 9,
      "start": 8118.4,
      "end": 8119.8,
      "formatted_start": "02:15:18.400",
      "formatted_end": "02:15:19.800",
      "text": "آه، فاملش غفاری بود؟"
    },
    {
      "id": 10,
      "start": 8119.8,
      "end": 8121.2,
      "formatted_start": "02:15:19.800",
      "formatted_end": "02:15:21.200",
      "text": "بله."
    },
    {
      "id": 11,
      "start": 8121.2,
      "end": 8122.2,
      "formatted_start": "02:15:21.200",
      "formatted_end": "02:15:22.200",
      "text": "تو خود رجبلی؟"
    },
    {
      "id": 12,
      "start": 8122.2,
      "end": 8124.2,
      "formatted_start": "02:15:22.200",
      "formatted_end": "02:15:24.200",
      "text": "بله، مانو رامیان"
    },
    {
      "id": 13,
      "start": 8124.2,
      "end": 8126.2,
      "formatted_start": "02:15:24.200",
      "formatted_end": "02:15:26.200",
      "text": "تو رامیان، اونا؟"
    },
    {
      "id": 14,
      "start": 8126.2,
      "end": 8130.2,
      "formatted_start": "02:15:26.200",
      "formatted_end": "02:15:30.200",
      "text": "آه، شهرم و پدرم هم کار بودن تو بان"
    },
    {
      "id": 15,
      "start": 8130.2,
      "end": 8131.2,
      "formatted_start": "02:15:30.200",
      "formatted_end": "02:15:31.200",
      "text": "آه"
    },
    {
      "id": 16,
      "start": 8131.2,
      "end": 8133.2,
      "formatted_start": "02:15:31.200",
      "formatted_end": "02:15:33.200",
      "text": "دیگه این تو بود شد که"
    },
    {
      "id": 17,
      "start": 8133.2,
      "end": 8135.2,
      "formatted_start": "02:15:33.200",
      "formatted_end": "02:15:35.200",
      "text": "بانک سپر؟"
    },
    {
      "id": 18,
      "start": 8135.2,
      "end": 8137.2,
      "formatted_start": "02:15:35.200",
      "formatted_end": "02:15:37.200",
      "text": "بله"
    },
    {
      "id": 19,
      "start": 8137.2,
      "end": 8140.2,
      "formatted_start": "02:15:37.200",
      "formatted_end": "02:15:40.200",
      "text": "پدرت کدوم رجبلی؟"
    },
    {
      "id": 20,
      "start": 8140.2,
      "end": 8145.2,
      "formatted_start": "02:15:40.200",
      "formatted_end": "02:15:45.200",
      "text": "مانو تقی رجبلی، انا تو بانک سپر، گمبت نگرگانه"
    },
    {
      "id": 21,
      "start": 8145.2,
      "end": 8146.2,
      "formatted_start": "02:15:45.200",
      "formatted_end": "02:15:46.200",
      "text": "نگرگانه شابان روزی"
    },
    {
      "id": 22,
      "start": 8146.2,
      "end": 8150.2,
      "formatted_start": "02:15:46.200",
      "formatted_end": "02:15:50.200",
      "text": "آه، مامان یه چیز داری؟ رسول داری؟"
    },
    {
      "id": 23,
      "start": 8150.2,
      "end": 8152.2,
      "formatted_start": "02:15:50.200",
      "formatted_end": "02:15:52.200",
      "text": "رجبلی؟"
    },
    {
      "id": 24,
      "start": 8152.2,
      "end": 8154.2,
      "formatted_start": "02:15:52.200",
      "formatted_end": "02:15:54.200",
      "text": "این مدت رامیان بود"
    },
    {
      "id": 25,
      "start": 8154.2,
      "end": 8156.2,
      "formatted_start": "02:15:54.200",
      "formatted_end": "02:15:56.200",
      "text": "نه رسول داری؟ اسم بابا چی بود؟"
    },
    {
      "id": 26,
      "start": 8156.2,
      "end": 8158.2,
      "formatted_start": "02:15:56.200",
      "formatted_end": "02:15:58.200",
      "text": "محمد تقیی"
    },
    {
      "id": 27,
      "start": 8158.2,
      "end": 8160.2,
      "formatted_start": "02:15:58.200",
      "formatted_end": "02:16:00.200",
      "text": "این نگهبانی"
    },
    {
      "id": 28,
      "start": 8160.2,
      "end": 8162.2,
      "formatted_start": "02:16:00.200",
      "formatted_end": "02:16:02.200",
      "text": "اون رسول رئیس بود"
    },
    {
      "id": 29,
      "start": 8162.2,
      "end": 8164.2,
      "formatted_start": "02:16:02.200",
      "formatted_end": "02:16:04.200",
      "text": "نمیشه از این آقای رجبلی رو"
    },
    {
      "id": 30,
      "start": 8164.2,
      "end": 8166.2,
      "formatted_start": "02:16:04.200",
      "formatted_end": "02:16:06.200",
      "text": "رجبلی رئیس پانکه"
    },
    {
      "id": 31,
      "start": 8166.2,
      "end": 8168.2,
      "formatted_start": "02:16:06.200",
      "formatted_end": "02:16:08.200",
      "text": "الان بازشست شد"
    },
    {
      "id": 32,
      "start": 8168.2,
      "end": 8170.2,
      "formatted_start": "02:16:08.200",
      "formatted_end": "02:16:10.200",
      "text": "غذا طبیعی هست"
    },
    {
      "id": 33,
      "start": 8170.2,
      "end": 8172.2,
      "formatted_start": "02:16:10.200",
      "formatted_end": "02:16:12.200",
      "text": "اون رجبلی هست"
    },
    {
      "id": 34,
      "start": 8172.2,
      "end": 8174.2,
      "formatted_start": "02:16:12.200",
      "formatted_end": "02:16:14.200",
      "text": "من همش نازه ولی من نه"
    },
    {
      "id": 35,
      "start": 8174.2,
      "end": 8176.2,
      "formatted_start": "02:16:14.200",
      "formatted_end": "02:16:16.200",
      "text": "سمیت میشه"
    },
    {
      "id": 36,
      "start": 8176.2,
      "end": 8178.2,
      "formatted_start": "02:16:16.200",
      "formatted_end": "02:16:18.200",
      "text": "شده دختر رسولی"
    },
    {
      "id": 37,
      "start": 8178.2,
      "end": 8180.2,
      "formatted_start": "02:16:18.200",
      "formatted_end": "02:16:20.200",
      "text": "این افراد طبیع است"
    },
    {
      "id": 38,
      "start": 8184.2,
      "end": 8186.2,
      "formatted_start": "02:16:24.200",
      "formatted_end": "02:16:26.200",
      "text": "خندتن رو بشن، افراد زنان رو بشن"
    },
    {
      "id": 39,
      "start": 8186.2,
      "end": 8188.2,
      "formatted_start": "02:16:26.200",
      "formatted_end": "02:16:28.200",
      "text": "اصلابت خیلی خورده"
    },
    {
      "id": 40,
      "start": 8188.2,
      "end": 8190.2,
      "formatted_start": "02:16:28.200",
      "formatted_end": "02:16:30.200",
      "text": "خیلی خورده"
    },
    {
      "id": 41,
      "start": 8190.2,
      "end": 8192.2,
      "formatted_start": "02:16:30.200",
      "formatted_end": "02:16:32.200",
      "text": "خیلی خورده"
    },
    {
      "id": 42,
      "start": 8192.2,
      "end": 8194.2,
      "formatted_start": "02:16:32.200",
      "formatted_end": "02:16:34.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 43,
      "start": 8194.2,
      "end": 8196.2,
      "formatted_start": "02:16:34.200",
      "formatted_end": "02:16:36.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 44,
      "start": 8196.2,
      "end": 8198.2,
      "formatted_start": "02:16:36.200",
      "formatted_end": "02:16:38.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 45,
      "start": 8198.2,
      "end": 8200.2,
      "formatted_start": "02:16:38.200",
      "formatted_end": "02:16:40.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 46,
      "start": 8200.2,
      "end": 8202.2,
      "formatted_start": "02:16:40.200",
      "formatted_end": "02:16:42.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 47,
      "start": 8202.2,
      "end": 8204.2,
      "formatted_start": "02:16:42.200",
      "formatted_end": "02:16:44.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 48,
      "start": 8204.2,
      "end": 8206.2,
      "formatted_start": "02:16:44.200",
      "formatted_end": "02:16:46.200",
      "text": "خورس بیخیالی بدم بخور"
    },
    {
      "id": 49,
      "start": 8206.2,
      "end": 8208.2,
      "formatted_start": "02:16:46.200",
      "formatted_end": "02:16:48.200",
      "text": "تو کجا حیلان دادی؟"
    },
    {
      "id": 50,
      "start": 8208.2,
      "end": 8209.2,
      "formatted_start": "02:16:48.200",
      "formatted_end": "02:16:49.200",
      "text": "بله"
    },
    {
      "id": 51,
      "start": 8209.2,
      "end": 8210.2,
      "formatted_start": "02:16:49.200",
      "formatted_end": "02:16:50.200",
      "text": "تو از کجا بیماری؟"
    },
    {
      "id": 52,
      "start": 8210.2,
      "end": 8211.2,
      "formatted_start": "02:16:50.200",
      "formatted_end": "02:16:51.200",
      "text": "خونه مستجعه"
    },
    {
      "id": 53,
      "start": 8211.2,
      "end": 8214.2,
      "formatted_start": "02:16:51.200",
      "formatted_end": "02:16:54.200",
      "text": "خونه مستجعه گرفتی؟ مامانت بیماری ببینه تو به شوهر دی؟"
    },
    {
      "id": 54,
      "start": 8214.2,
      "end": 8220.2,
      "formatted_start": "02:16:54.200",
      "formatted_end": "02:17:00.200",
      "text": "آه، اینه با هم زندگی میکردیم بیرون خونه مستجعه رفتیم اونجا بیرون"
    },
    {
      "id": 55,
      "start": 8220.2,
      "end": 8223.2,
      "formatted_start": "02:17:00.200",
      "formatted_end": "02:17:03.200",
      "text": "بعد اونجا بیشتر که جدا بشم"
    },
    {
      "id": 56,
      "start": 8223.2,
      "end": 8227.2,
      "formatted_start": "02:17:03.200",
      "formatted_end": "02:17:07.200",
      "text": "از اینجا برام خود جدا خونه گرفت به شوهر؟"
    },
    {
      "id": 57,
      "start": 8227.2,
      "end": 8232.96,
      "formatted_start": "02:17:07.200",
      "formatted_end": "02:17:12.960",
      "text": "اینجا مادرش بگو که نمیدونم ازیاد میکنه"
    },
    {
      "id": 58,
      "start": 8232.96,
      "end": 8236.16,
      "formatted_start": "02:17:12.960",
      "formatted_end": "02:17:16.160",
      "text": "و من گفتم یا برام من خونه جدا بگیر من برام خونه خودم"
    },
    {
      "id": 59,
      "start": 8236.16,
      "end": 8238.16,
      "formatted_start": "02:17:16.160",
      "formatted_end": "02:17:18.160",
      "text": "الان خونه اجاره چی میده؟"
    },
    {
      "id": 60,
      "start": 8238.16,
      "end": 8243.76,
      "formatted_start": "02:17:18.160",
      "formatted_end": "02:17:23.760",
      "text": "اصلا، یه جروی هست پیشن وردی خود"
    },
    {
      "id": 61,
      "start": 8243.76,
      "end": 8246.4,
      "formatted_start": "02:17:23.760",
      "formatted_end": "02:17:26.400",
      "text": "یه جروی پیشن وردی خودم"
    },
    {
      "id": 62,
      "start": 8246.4,
      "end": 8248.4,
      "formatted_start": "02:17:26.400",
      "formatted_end": "02:17:28.400",
      "text": "به خدا بودم اینجا موجود کنم"
    },
    {
      "id": 63,
      "start": 8248.4,
      "end": 8252.56,
      "formatted_start": "02:17:28.400",
      "formatted_end": "02:17:32.560",
      "text": "یه سرکار یه جایی برام رستم تجیب و خودم روشه برم"
    },
    {
      "id": 64,
      "start": 8252.56,
      "end": 8254.72,
      "formatted_start": "02:17:32.560",
      "formatted_end": "02:17:34.720",
      "text": "تنها خواهیت توفقه یه"
    },
    {
      "id": 65,
      "start": 8254.72,
      "end": 8258.72,
      "formatted_start": "02:17:34.720",
      "formatted_end": "02:17:38.720",
      "text": "خواهد بودی و خود گفت، هوا تو دارم، کمک کنم."
    },
    {
      "id": 66,
      "start": 8258.72,
      "end": 8263.72,
      "formatted_start": "02:17:38.720",
      "formatted_end": "02:17:43.720",
      "text": "آدم خوبیه، اشوارم، ولی خانوادش نداشتم."
    },
    {
      "id": 67,
      "start": 8269.72,
      "end": 8271.72,
      "formatted_start": "02:17:49.720",
      "formatted_end": "02:17:51.720",
      "text": "می آرد پشت؟"
    },
    {
      "id": 68,
      "start": 8271.72,
      "end": 8275.72,
      "formatted_start": "02:17:51.720",
      "formatted_end": "02:17:55.720",
      "text": "می آرد پشت، بنابراین، گفت، هوا تو دارم، کمک کنم، آدم خوبیه، دوستو زده،"
    },
    {
      "id": 69,
      "start": 8275.72,
      "end": 8280.72,
      "formatted_start": "02:17:55.720",
      "formatted_end": "02:18:00.720",
      "text": "دست خیلی زیاد داره، برنامه کمک میکنه با من."
    },
    {
      "id": 70,
      "start": 8280.72,
      "end": 8299.72,
      "formatted_start": "02:18:00.720",
      "formatted_end": "02:18:19.720",
      "text": "اینجور شد که این حسابی خوشترم زیاد زدند، امدن به خانواده شوهرم دستند، من از دواج درگونم که کردم، از دواج اولم میموندن،"
    },
    {
      "id": 71,
      "start": 8299.72,
      "end": 8303.72,
      "formatted_start": "02:18:19.720",
      "formatted_end": "02:18:23.720",
      "text": "خانواده شوهرم رو گفتند که آره اینجوری بود اونجوری بود"
    },
    {
      "id": 72,
      "start": 8303.72,
      "end": 8306.72,
      "formatted_start": "02:18:23.720",
      "formatted_end": "02:18:26.720",
      "text": "برند و برنزنی کردم به این تماد زدن"
    },
    {
      "id": 73,
      "start": 8306.72,
      "end": 8311.72,
      "formatted_start": "02:18:26.720",
      "formatted_end": "02:18:31.720",
      "text": "برم حق دار بود و این هم گفته اله بله باید تلا بودیم به درتون"
    },
    {
      "id": 74,
      "start": 8311.72,
      "end": 8313.72,
      "formatted_start": "02:18:31.720",
      "formatted_end": "02:18:33.720",
      "text": "شوهرت پسر بود؟"
    },
    {
      "id": 75,
      "start": 8313.72,
      "end": 8314.72,
      "formatted_start": "02:18:33.720",
      "formatted_end": "02:18:34.720",
      "text": "نه"
    },
    {
      "id": 76,
      "start": 8314.72,
      "end": 8315.72,
      "formatted_start": "02:18:34.720",
      "formatted_end": "02:18:35.720",
      "text": "اونم به زباش بود؟"
    },
    {
      "id": 77,
      "start": 8315.72,
      "end": 8321.72,
      "formatted_start": "02:18:35.720",
      "formatted_end": "02:18:41.720",
      "text": "نه به زباش کرده بود که داشت و بگی دختر رو رو از زباج زن همونش"
    },
    {
      "id": 78,
      "start": 8321.72,
      "end": 8324.72,
      "formatted_start": "02:18:41.720",
      "formatted_end": "02:18:44.720",
      "text": "اونم به زباش همون بود"
    },
    {
      "id": 79,
      "start": 8324.72,
      "end": 8328.72,
      "formatted_start": "02:18:44.720",
      "formatted_end": "02:18:48.720",
      "text": "الان هوا تو داری، مادرش خبر نداری"
    },
    {
      "id": 80,
      "start": 8328.72,
      "end": 8332.72,
      "formatted_start": "02:18:48.720",
      "formatted_end": "02:18:52.720",
      "text": "نه، نه زن، نه مدرم، نه خواندارم، نه اون"
    },
    {
      "id": 81,
      "start": 8332.72,
      "end": 8336.72,
      "formatted_start": "02:18:52.720",
      "formatted_end": "02:18:56.720",
      "text": "گفت که پس نمی بگم تا از فردر رو برا بشی و..."
    },
    {
      "id": 82,
      "start": 8336.72,
      "end": 8338.72,
      "formatted_start": "02:18:56.720",
      "formatted_end": "02:18:58.720",
      "text": "کار چی بلدی؟"
    },
    {
      "id": 83,
      "start": 8338.72,
      "end": 8341.72,
      "formatted_start": "02:18:58.720",
      "formatted_end": "02:19:01.720",
      "text": "خواه باری که اون کار رو از کمبه ارشو شد"
    },
    {
      "id": 84,
      "start": 8341.72,
      "end": 8345.72,
      "formatted_start": "02:19:01.720",
      "formatted_end": "02:19:05.720",
      "text": "یعنی چه کار بلدی؟ که شامرزی مثلا میخوایی بری یا یه یکی اون بری مثلا؟"
    },
    {
      "id": 85,
      "start": 8345.72,
      "end": 8350.72,
      "formatted_start": "02:19:05.720",
      "formatted_end": "02:19:10.720",
