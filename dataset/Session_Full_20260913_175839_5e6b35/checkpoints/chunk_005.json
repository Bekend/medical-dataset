      "end": 1589.98,
      "formatted_start": "00:26:00.000",
      "formatted_end": "00:26:29.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 3,
      "start": 1590.0,
      "end": 1619.98,
      "formatted_start": "00:26:30.000",
      "formatted_end": "00:26:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 4,
      "start": 1620.0,
      "end": 1630.0,
      "formatted_start": "00:27:00.000",
      "formatted_end": "00:27:10.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 1630.0,
      "end": 1640.0,
      "formatted_start": "00:27:10.000",
      "formatted_end": "00:27:20.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 1640.0,
      "end": 1670.0,
      "formatted_start": "00:27:20.000",
      "formatted_end": "00:27:50.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 7,
      "start": 1670.0,
      "end": 1675.54,
      "formatted_start": "00:27:50.000",
      "formatted_end": "00:27:55.540",
      "text": "بفرما هشت خانم سلام"
    },
    {
      "id": 8,
      "start": 1675.54,
      "end": 1677.7,
      "formatted_start": "00:27:55.540",
      "formatted_end": "00:27:57.700",
      "text": "خوش آمد"
    },
    {
      "id": 9,
      "start": 1677.7,
      "end": 1684.88,
      "formatted_start": "00:27:57.700",
      "formatted_end": "00:28:04.880",
      "text": "خیالی آمدید بفرما"
    },
    {
      "id": 10,
      "start": 1700.0,
      "end": 1704.0,
      "formatted_start": "00:28:20.000",
      "formatted_end": "00:28:24.000",
      "text": "بازماشاتت خوبه ها"
    },
    {
      "id": 11,
      "start": 1704.0,
      "end": 1706.0,
      "formatted_start": "00:28:24.000",
      "formatted_end": "00:28:26.000",
      "text": "یه ذره شن ادراری داری"
    },
    {
      "id": 12,
      "start": 1706.0,
      "end": 1710.0,
      "formatted_start": "00:28:26.000",
      "formatted_end": "00:28:30.000",
      "text": "ویتامین ده هم لب مرزه"
    },
    {
      "id": 13,
      "start": 1710.0,
      "end": 1712.0,
      "formatted_start": "00:28:30.000",
      "formatted_end": "00:28:32.000",
      "text": "ویتامین ده می کردی؟"
    },
    {
      "id": 14,
      "start": 1712.0,
      "end": 1714.0,
      "formatted_start": "00:28:32.000",
      "formatted_end": "00:28:34.000",
      "text": "ویتامین ده می کردم"
    },
    {
      "id": 15,
      "start": 1714.0,
      "end": 1716.0,
      "formatted_start": "00:28:34.000",
      "formatted_end": "00:28:36.000",
      "text": "از آن آسیب کردم"
    },
    {
      "id": 16,
      "start": 1716.0,
      "end": 1718.0,
      "formatted_start": "00:28:36.000",
      "formatted_end": "00:28:38.000",
      "text": "یه نونه آمپول زدم"
    },
    {
      "id": 17,
      "start": 1718.0,
      "end": 1720.0,
      "formatted_start": "00:28:38.000",
      "formatted_end": "00:28:40.000",
      "text": "آمپول ده زدی؟ کهی زدی؟"
    },
    {
      "id": 18,
      "start": 1720.0,
      "end": 1722.0,
      "formatted_start": "00:28:40.000",
      "formatted_end": "00:28:42.000",
      "text": "تا دیگه ماهرگاه همینه هفته با من هم بشه"
    },
    {
      "id": 19,
      "start": 1722.0,
      "end": 1726.0,
      "formatted_start": "00:28:42.000",
      "formatted_end": "00:28:46.000",
      "text": "قبل از این آسمایش یا بعد این آسمایش؟"
    },
    {
      "id": 20,
      "start": 1726.0,
      "end": 1728.0,
      "formatted_start": "00:28:46.000",
      "formatted_end": "00:28:48.000",
      "text": "بعد از این آسمایش"
    },
    {
      "id": 21,
      "start": 1728.0,
      "end": 1730.0,
      "formatted_start": "00:28:48.000",
      "formatted_end": "00:28:50.000",
      "text": "بعد این آزمایش زدیم"
    },
    {
      "id": 22,
      "start": 1730.0,
      "end": 1732.0,
      "formatted_start": "00:28:50.000",
      "formatted_end": "00:28:52.000",
      "text": "بس دیگه همون خواه بسانم"
    },
    {
      "id": 23,
      "start": 1732.0,
      "end": 1736.0,
      "formatted_start": "00:28:52.000",
      "formatted_end": "00:28:56.000",
      "text": "و یه مقدار شنی ادراری داری"
    },
    {
      "id": 24,
      "start": 1736.0,
      "end": 1738.0,
      "formatted_start": "00:28:56.000",
      "formatted_end": "00:28:58.000",
      "text": "سنگ کلیه"
    },
    {
      "id": 25,
      "start": 1738.0,
      "end": 1741.0,
      "formatted_start": "00:28:58.000",
      "formatted_end": "00:29:01.000",
      "text": "خدا بیا مرز همسرتم داشت دیگه"
    },
    {
      "id": 26,
      "start": 1741.0,
      "end": 1743.0,
      "formatted_start": "00:29:01.000",
      "formatted_end": "00:29:03.000",
      "text": "نه من مادسی هم دارم"
    },
    {
      "id": 27,
      "start": 1743.0,
      "end": 1745.0,
      "formatted_start": "00:29:03.000",
      "formatted_end": "00:29:05.000",
      "text": "بله این عرصیه"
    },
    {
      "id": 28,
      "start": 1745.0,
      "end": 1747.0,
      "formatted_start": "00:29:05.000",
      "formatted_end": "00:29:07.000",
      "text": "خدایت الله"
    },
    {
      "id": 29,
      "start": 1747.0,
      "end": 1749.0,
      "formatted_start": "00:29:07.000",
      "formatted_end": "00:29:09.000",
      "text": "کمه عرصیات نیست"
    },
    {
      "id": 30,
      "start": 1749.0,
      "end": 1751.0,
      "formatted_start": "00:29:09.000",
      "formatted_end": "00:29:11.000",
      "text": "دوا میدم آب بشه دیگه ایشون"
    },
    {
      "id": 31,
      "start": 1751.0,
      "end": 1752.0,
      "formatted_start": "00:29:11.000",
      "formatted_end": "00:29:12.000",
      "text": "نه نه"
    },
    {
      "id": 32,
      "start": 1752.0,
      "end": 1754.0,
      "formatted_start": "00:29:12.000",
      "formatted_end": "00:29:14.000",
      "text": "به ادرار تونتونم میریخواده؟"
    },
    {
      "id": 33,
      "start": 1754.0,
      "end": 1756.0,
      "formatted_start": "00:29:14.000",
      "formatted_end": "00:29:16.000",
      "text": "بس ماما خیلی تونتون میره"
    },
    {
      "id": 34,
      "start": 1756.0,
      "end": 1759.0,
      "formatted_start": "00:29:16.000",
      "formatted_end": "00:29:19.000",
      "text": "میرسی به دستشویی یا نه؟"
    },
    {
      "id": 35,
      "start": 1759.0,
      "end": 1762.0,
      "formatted_start": "00:29:19.000",
      "formatted_end": "00:29:22.000",
      "text": "چرا؟"
    },
    {
      "id": 36,
      "start": 1762.0,
      "end": 1765.0,
      "formatted_start": "00:29:22.000",
      "formatted_end": "00:29:25.000",
      "text": "بعد موه ها سرما رو هم بکشید"
    },
    {
      "id": 37,
      "start": 1765.0,
      "end": 1768.0,
      "formatted_start": "00:29:25.000",
      "formatted_end": "00:29:28.000",
      "text": "نه، نگه سیب بکنه"
    },
    {
      "id": 38,
      "start": 1768.0,
      "end": 1771.0,
      "formatted_start": "00:29:28.000",
      "formatted_end": "00:29:31.000",
      "text": "بعد سرما کنه ها بگذاری"
    },
    {
      "id": 39,
      "start": 1771.0,
      "end": 1774.0,
      "formatted_start": "00:29:31.000",
      "formatted_end": "00:29:34.000",
      "text": "چشم"
    },
    {
      "id": 40,
      "start": 1774.0,
      "end": 1777.0,
      "formatted_start": "00:29:34.000",
      "formatted_end": "00:29:37.000",
      "text": "دقیقا رو باز کن ببینم"
    },
    {
      "id": 41,
      "start": 1777.0,
      "end": 1780.0,
      "formatted_start": "00:29:37.000",
      "formatted_end": "00:29:40.000",
      "text": "باز کن ببینم"
    },
    {
      "id": 42,
      "start": 1780.0,
      "end": 1783.0,
      "formatted_start": "00:29:40.000",
      "formatted_end": "00:29:43.000",
      "text": "بلد بلد دردونه خوارش شده"
    },
    {
      "id": 43,
      "start": 1783.0,
      "end": 1785.0,
      "formatted_start": "00:29:43.000",
      "formatted_end": "00:29:45.000",
      "text": "خربزه هم نباید بخورید"
    },
    {
      "id": 44,
      "start": 1785.0,
      "end": 1787.0,
      "formatted_start": "00:29:45.000",
      "formatted_end": "00:29:47.000",
      "text": "رست بزارید"
    },
    {
      "id": 45,
      "start": 1787.0,
      "end": 1789.0,
      "formatted_start": "00:29:47.000",
      "formatted_end": "00:29:49.000",
      "text": "خربزه که خوردید؟"
    },
    {
      "id": 46,
      "start": 1789.0,
      "end": 1791.0,
      "formatted_start": "00:29:49.000",
      "formatted_end": "00:29:51.000",
      "text": "خربزه زیرگاه نخوردیم"
    },
    {
      "id": 47,
      "start": 1791.0,
      "end": 1793.0,
      "formatted_start": "00:29:51.000",
      "formatted_end": "00:29:53.000",
      "text": "پیشه با نخوردید"
    },
    {
      "id": 48,
      "start": 1793.0,
      "end": 1795.0,
      "formatted_start": "00:29:53.000",
      "formatted_end": "00:29:55.000",
      "text": "اگر از اون زیرگاه خوردید هم نشان"
    },
    {
      "id": 49,
      "start": 1795.0,
      "end": 1797.0,
      "formatted_start": "00:29:55.000",
      "formatted_end": "00:29:57.000",
