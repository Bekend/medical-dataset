      "id": 59,
      "start": 2911.32,
      "end": 2916.32,
      "formatted_start": "00:48:31.320",
      "formatted_end": "00:48:36.320",
      "text": "گرگان فوقتحسوس و زانو تا تصمیم داره جراحی بکنه"
    },
