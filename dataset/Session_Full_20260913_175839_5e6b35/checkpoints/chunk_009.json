  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2702.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:02.000",
      "text": "احتمال برس انرژی میده."
    },
    {
      "id": 1,
      "start": 2702.0,
      "end": 2704.0,
      "formatted_start": "00:45:02.000",
      "formatted_end": "00:45:04.000",
      "text": "آره روش هسته."
    },
    {
      "id": 2,
      "start": 2704.0,
      "end": 2706.0,
      "formatted_start": "00:45:04.000",
      "formatted_end": "00:45:06.000",
      "text": "ششم ششم ششم"
    },
    {
      "id": 3,
      "start": 2706.0,
      "end": 2708.0,
      "formatted_start": "00:45:06.000",
      "formatted_end": "00:45:08.000",
      "text": "هفته پیش باید برسید."
    },
    {
      "id": 4,
      "start": 2708.0,
      "end": 2710.0,
      "formatted_start": "00:45:08.000",
      "formatted_end": "00:45:10.000",
      "text": "بله."
    },
    {
      "id": 5,
      "start": 2710.0,
      "end": 2712.0,
      "formatted_start": "00:45:10.000",
      "formatted_end": "00:45:12.000",
      "text": "احتمال کم نشدن وزن."
    },
    {
      "id": 6,
      "start": 2712.0,
      "end": 2714.0,
      "formatted_start": "00:45:12.000",
      "formatted_end": "00:45:14.000",
      "text": "یه نور هسته برسید."
    },
    {
      "id": 7,
      "start": 2714.0,
      "end": 2718.0,
      "formatted_start": "00:45:14.000",
      "formatted_end": "00:45:18.000",
      "text": "بله، کم نشدن وزنتون به خاطر به همدیختر قایدگی باشه."
    },
    {
      "id": 8,
      "start": 2718.0,
      "end": 2721.0,
      "formatted_start": "00:45:18.000",
      "formatted_end": "00:45:21.000",
      "text": "چون دهده خونو خوب نداشتیم،"
    },
    {
      "id": 9,
      "start": 2721.0,
      "end": 2728.0,
      "formatted_start": "00:45:21.000",
      "formatted_end": "00:45:28.000",
      "text": "حالا کار رو گفتیدم که دهده خونو، اینها، وزن توی دو هفته آینده"
    },
    {
      "id": 10,
      "start": 2728.0,
      "end": 2730.0,
      "formatted_start": "00:45:28.000",
      "formatted_end": "00:45:30.000",
      "text": "به طرز چشم گیریم"
    },
    {
      "id": 11,
      "start": 2730.0,
      "end": 2732.0,
      "formatted_start": "00:45:30.000",
      "formatted_end": "00:45:32.000",
      "text": "آرزو شما میتونید اون لباش بکنم"
    },
    {
      "id": 12,
      "start": 2732.0,
      "end": 2734.0,
      "formatted_start": "00:45:32.000",
      "formatted_end": "00:45:34.000",
      "text": "من بیشتر شما از ترستار بکنم"
    },
    {
      "id": 13,
      "start": 2734.0,
      "end": 2735.0,
      "formatted_start": "00:45:34.000",
      "formatted_end": "00:45:35.000",
      "text": "بهتره؟"
    },
    {
      "id": 14,
      "start": 2735.0,
      "end": 2736.0,
      "formatted_start": "00:45:35.000",
      "formatted_end": "00:45:36.000",
      "text": "بهتره"
    },
    {
      "id": 15,
      "start": 2736.0,
      "end": 2738.0,
      "formatted_start": "00:45:36.000",
      "formatted_end": "00:45:38.000",
      "text": "من درستار میگیرم دیگه نزدنم"
    },
    {
      "id": 16,
      "start": 2738.0,
      "end": 2739.0,
      "formatted_start": "00:45:38.000",
      "formatted_end": "00:45:39.000",
      "text": "آفرین"
    },
    {
      "id": 17,
      "start": 2739.0,
      "end": 2742.0,
      "formatted_start": "00:45:39.000",
      "formatted_end": "00:45:42.000",
      "text": "بهترین لباش لباش سبزواریه"
    },
    {
      "id": 18,
      "start": 2742.0,
      "end": 2743.0,
      "formatted_start": "00:45:42.000",
      "formatted_end": "00:45:43.000",
      "text": "حالا سبزواریه؟"
    },
    {
      "id": 19,
      "start": 2743.0,
      "end": 2746.0,
      "formatted_start": "00:45:43.000",
      "formatted_end": "00:45:46.000",
      "text": "دومت دو جا میفرشن دو سه جا یعنی میفرشن"
    },
    {
      "id": 20,
      "start": 2746.0,
      "end": 2748.0,
      "formatted_start": "00:45:46.000",
      "formatted_end": "00:45:48.000",
      "text": "پردن که آقای علوی بود برقرار بسکی"
    },
    {
      "id": 21,
      "start": 2748.0,
      "end": 2750.0,
      "formatted_start": "00:45:48.000",
      "formatted_end": "00:45:50.000",
      "text": "حالا"
    },
    {
      "id": 22,
      "start": 2751.0,
      "end": 2754.0,
      "formatted_start": "00:45:51.000",
      "formatted_end": "00:45:54.000",
      "text": "پچا روبرو شهر آجیلی خیابانه ها"
    },
    {
      "id": 23,
      "start": 2754.0,
      "end": 2755.0,
      "formatted_start": "00:45:54.000",
      "formatted_end": "00:45:55.000",
      "text": "آه اونجا"
    },
    {
      "id": 24,
      "start": 2755.0,
      "end": 2758.0,
      "formatted_start": "00:45:55.000",
      "formatted_end": "00:45:58.000",
      "text": "روش بانک سامان چی و کنید"
    },
    {
      "id": 25,
      "start": 2758.0,
      "end": 2759.0,
      "formatted_start": "00:45:58.000",
      "formatted_end": "00:45:59.000",
      "text": "اون کار رو بندون استش"
    },
    {
      "id": 26,
      "start": 2759.0,
      "end": 2760.0,
      "formatted_start": "00:45:59.000",
      "formatted_end": "00:46:00.000",
      "text": "از اینکه باشه"
    },
    {
      "id": 27,
      "start": 2760.0,
      "end": 2762.0,
      "formatted_start": "00:46:00.000",
      "formatted_end": "00:46:02.000",
      "text": "بله اونو بردین نونه سبستار که نیسته بربرایی"
    },
    {
      "id": 28,
      "start": 2762.0,
      "end": 2764.0,
      "formatted_start": "00:46:02.000",
      "formatted_end": "00:46:04.000",
      "text": "برای نونه سبستار از اونو نگیرن"
    },
    {
      "id": 29,
      "start": 2764.0,
      "end": 2765.0,
      "formatted_start": "00:46:04.000",
      "formatted_end": "00:46:05.000",
      "text": "چیمونم؟"
    },
    {
      "id": 30,
      "start": 2765.0,
      "end": 2766.0,
      "formatted_start": "00:46:05.000",
      "formatted_end": "00:46:06.000",
      "text": "اونم خوبه"
    },
    {
      "id": 31,
      "start": 2766.0,
      "end": 2769.0,
      "formatted_start": "00:46:06.000",
      "formatted_end": "00:46:09.000",
      "text": "خوبه بلی نوعی باز کنن حالت بربرایی سبستاره"
    },
    {
      "id": 32,
      "start": 2769.0,
      "end": 2773.0,
      "formatted_start": "00:46:09.000",
      "formatted_end": "00:46:13.000",
      "text": "باز بین لواش سبستار که میشه سبزه باری"
    },
    {
      "id": 33,
      "start": 2773.0,
      "end": 2775.0,
      "formatted_start": "00:46:13.000",
      "formatted_end": "00:46:15.000",
      "text": "خوشمزه هم نیستش بردین"
    },
    {
      "id": 34,
      "start": 2775.0,
      "end": 2776.0,
      "formatted_start": "00:46:15.000",
      "formatted_end": "00:46:16.000",
      "text": "سبستار بردین"
    },
    {
      "id": 35,
      "start": 2776.0,
      "end": 2777.0,
      "formatted_start": "00:46:16.000",
      "formatted_end": "00:46:17.000",
      "text": "ده ده"
    },
    {
      "id": 36,
      "start": 2777.0,
      "end": 2779.0,
      "formatted_start": "00:46:17.000",
      "formatted_end": "00:46:19.000",
      "text": "سیتون روزیه"
    },
    {
      "id": 37,
      "start": 2779.0,
      "end": 2781.0,
      "formatted_start": "00:46:19.000",
      "formatted_end": "00:46:21.000",
      "text": "یک گرسیه یک کمی هم"
    },
    {
      "id": 38,
      "start": 2785.0,
      "end": 2794.0,
      "formatted_start": "00:46:25.000",
      "formatted_end": "00:46:34.000",
      "text": "خب وزن خیلی از سر پاهت بذاشت و برای عادتتون هم کمی زفران بخورید که حتی الان نه ده هم میخوایی بشید"
    },
    {
      "id": 39,
      "start": 2794.0,
      "end": 2805.0,
      "formatted_start": "00:46:34.000",
      "formatted_end": "00:46:45.000",
      "text": "از پنجم تا ده هم پر روز یه مقدار چای زفران بروز کنید که شدت عادتتون زیاد بکنه و تو بدم برغم اضافی نرمانه"
    },
    {
      "id": 40,
      "start": 2805.0,
      "end": 2810.0,
      "formatted_start": "00:46:45.000",
      "formatted_end": "00:46:50.000",
      "text": "خب هنوشت خیلی خوب بودم ولی این دفعه نمارا خصوصا دابار و چیز دیدن روز کشیدی؟"
    },
    {
      "id": 41,
      "start": 2810.0,
      "end": 2813.44,
      "formatted_start": "00:46:50.000",
      "formatted_end": "00:46:53.440",
      "text": "این ها چیست؟ شاید استرسی داشتی که استی؟"
    },
    {
      "id": 42,
      "start": 2813.44,
      "end": 2821.76,
      "formatted_start": "00:46:53.440",
      "formatted_end": "00:47:01.760",
      "text": "استرس که آره، ماما که باتون میگه براد شهر افتاد دوباره همون ترسته اومد برا و عمدن یک تا صبح اون استرسن رو دارن"
    },
    {
      "id": 43,
      "start": 2821.76,
      "end": 2832.32,
      "formatted_start": "00:47:01.760",
      "formatted_end": "00:47:12.320",
      "text": "این ها بر این یک ماه میریم بیسم که باشم"
    },
    {
      "id": 44,
      "start": 2832.32,
      "end": 2834.32,
      "formatted_start": "00:47:12.320",
      "formatted_end": "00:47:14.320",
      "text": "صد بلغران تموم شده؟"
    },
    {
      "id": 45,
      "start": 2834.32,
      "end": 2836.32,
      "formatted_start": "00:47:14.320",
      "formatted_end": "00:47:16.320",
      "text": "نه، پیدمونو دارم"
    },
    {
      "id": 46,
      "start": 2836.32,
      "end": 2840.32,
      "formatted_start": "00:47:16.320",
      "formatted_end": "00:47:20.320",
      "text": "نه نمیستم برای یک آخر داری که نصب شده است"
    },
    {
      "id": 47,
      "start": 2840.32,
      "end": 2842.32,
      "formatted_start": "00:47:20.320",
      "formatted_end": "00:47:22.320",
      "text": "نصب بود نه بود نه بود"
    },
    {
      "id": 48,
      "start": 2842.32,
      "end": 2844.32,
      "formatted_start": "00:47:22.320",
      "formatted_end": "00:47:24.320",
      "text": "روز سه عدد بردی بخورم"
    },
    {
      "id": 49,
      "start": 2844.32,
      "end": 2846.32,
      "formatted_start": "00:47:24.320",
      "formatted_end": "00:47:26.320",
      "text": "آنتوم هم"
    },
    {
      "id": 50,
      "start": 2846.32,
      "end": 2848.32,
      "formatted_start": "00:47:26.320",
      "formatted_end": "00:47:28.320",
      "text": "آنتوم ستون"
    },
    {
      "id": 51,
      "start": 2848.32,
      "end": 2850.32,
      "formatted_start": "00:47:28.320",
      "formatted_end": "00:47:30.320",
      "text": "از که مکس ها فیلم دارم"
    },
    {
      "id": 52,
      "start": 2850.32,
      "end": 2854.32,
      "formatted_start": "00:47:30.320",
      "formatted_end": "00:47:34.320",
      "text": "مکس شست دارم شده هم پس سیتر شده هم که اون تا موشن فیلم بود"
    },
    {
      "id": 53,
      "start": 2854.32,
      "end": 2864.32,
      "formatted_start": "00:47:34.320",
      "formatted_end": "00:47:44.320",
      "text": "کپسول اوکسو کولیاکسیتین بهده اسپرازیان بسترنشتان و دوزدگی"
    },
    {
      "id": 54,
      "start": 2864.32,
      "end": 2870.32,
      "formatted_start": "00:47:44.320",
      "formatted_end": "00:47:50.320",
      "text": "برای شما یک ماه نمیشتم برای هجمانه دو هفته"
    },
    {
      "id": 55,
      "start": 2870.32,
      "end": 2875.32,
      "formatted_start": "00:47:50.320",
      "formatted_end": "00:47:55.320",
      "text": "با هجمانه دو هفته شما هم یک ماه نمیشتم"
    },
    {
      "id": 56,
      "start": 2875.32,
      "end": 2905.32,
      "formatted_start": "00:47:55.320",
      "formatted_end": "00:48:25.320",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 57,
      "start": 2905.32,
      "end": 2909.32,
      "formatted_start": "00:48:25.320",
      "formatted_end": "00:48:29.320",
      "text": "بعدش کم میشه یعنی نه قطبشه ها یه مقداری کم ترشه"
    },
    {
      "id": 58,
      "start": 2909.32,
      "end": 2911.32,
      "formatted_start": "00:48:29.320",
      "formatted_end": "00:48:31.320",
      "text": "اگه نشد باید بپرسی بیشه"
    },
