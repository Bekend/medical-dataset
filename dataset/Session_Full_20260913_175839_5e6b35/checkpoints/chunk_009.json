      "id": 62,
      "start": 2924.32,
      "end": 2926.32,
      "formatted_start": "00:48:44.320",
      "formatted_end": "00:48:46.320",
      "text": "مدنیتش بکتر شده"
    },
    {
      "id": 63,
      "start": 2926.32,
      "end": 2928.32,
      "formatted_start": "00:48:46.320",
      "formatted_end": "00:48:48.320",
      "text": "همه خیلی خوب شده ولی اینکه دردش آمده"
    },
