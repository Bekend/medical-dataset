  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11404.48,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:04.480",
      "text": "این روزگار سخت نمیشه، بیا تو قبول کن از کاندام استفاده کن."
    },
    {
      "id": 1,
      "start": 11404.48,
      "end": 11411.52,
      "formatted_start": "03:10:04.480",
      "formatted_end": "03:10:11.520",
      "text": "کاندام های خوب هستن، کاندام های پلیجور نمیشه، کاندام های که خارداری و چیزها نباشن، قضیت میشن."
    },
    {
      "id": 2,
      "start": 11411.52,
      "end": 11418.72,
      "formatted_start": "03:10:11.520",
      "formatted_end": "03:10:18.720",
      "text": "این کاندام های ساده، پلیجور نمیشه، صاف یا نرم نمیشه، از اونها استفاده کنی،"
    },
    {
      "id": 3,
      "start": 11418.72,
      "end": 11421.68,
      "formatted_start": "03:10:18.720",
      "formatted_end": "03:10:21.680",
      "text": "عزتش هم برای همسر کم نمیشه یا کشور نمیشه."
    },
    {
      "id": 4,
      "start": 11421.68,
      "end": 11426.68,
      "formatted_start": "03:10:21.680",
      "formatted_end": "03:10:26.680",
      "text": "آن دیگه میدونید چی ها رو هم قدرازی میدن. ببخشید. من میدونید بچه اولین که به دنیا آمد."
    },
    {
      "id": 5,
      "start": 11426.68,
      "end": 11434.68,
      "formatted_start": "03:10:26.680",
      "formatted_end": "03:10:34.680",
      "text": "بعد خودم از خودم مثلاً بگوید که مثلاً دیوگاه رو مثلاً چون خودم با آبجه قبلی شیر بشیم بودم."
    },
    {
      "id": 6,
      "start": 11434.68,
      "end": 11437.68,
      "formatted_start": "03:10:34.680",
      "formatted_end": "03:10:37.680",
      "text": "دیدم مثلاً سخته بود که زدگاه دیگه سخته قریب هم بینیده."
    },
    {
      "id": 7,
      "start": 11437.68,
      "end": 11440.68,
      "formatted_start": "03:10:37.680",
      "formatted_end": "03:10:40.680",
      "text": "سخته بودم میدونم تا از توی که بچه شیر بشیم بودم."
    },
    {
      "id": 8,
      "start": 11440.68,
      "end": 11444.68,
      "formatted_start": "03:10:40.680",
      "formatted_end": "03:10:44.680",
      "text": "بعد بچه دونم رو بردم. از پیش خودم ادیر رو خوردم."
    },
    {
      "id": 9,
      "start": 11444.68,
      "end": 11454.68,
      "formatted_start": "03:10:44.680",
      "formatted_end": "03:10:54.680",
      "text": "از اصابه نیست که من نارد چرا بیده من بهش گفتم که برس کنم بخاطر اینه من دارم از سریب شد"
    },
    {
      "id": 10,
      "start": 11454.68,
      "end": 11463.68,
      "formatted_start": "03:10:54.680",
      "formatted_end": "03:11:03.680",
      "text": "بعد این گفت که نخورینا و بعد کاری من که اصلا قبول نمیکرد استواده کرد اصلا قبول نکرد گذاشت کنار"
    },
    {
      "id": 11,
      "start": 11463.68,
      "end": 11465.68,
      "formatted_start": "03:11:03.680",
      "formatted_end": "03:11:05.680",
      "text": "بعد نمونده خوب استفاده می کنید؟"
    },
    {
      "id": 12,
      "start": 11465.68,
      "end": 11471.68,
      "formatted_start": "03:11:05.680",
      "formatted_end": "03:11:11.680",
      "text": "بعد اینکه آقای دکتر من برس هم گفته شدم که دختر دوم هم حامل شدم"
    },
    {
      "id": 13,
      "start": 11471.68,
      "end": 11501.68,
      "formatted_start": "03:11:11.680",
      "formatted_end": "03:11:41.680",
      "text": "دیگه از اونجا باید به آقا من نگفتم ببخشید تبعیم هم جلوی دیگه هم تبعی جلوی دیگه هم همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچنین همچ"
    },
    {
      "id": 14,
      "start": 11501.68,
      "end": 11504.68,
      "formatted_start": "03:11:41.680",
      "formatted_end": "03:11:44.680",
      "text": "از اینجا باید برداشتیم که این زمان را برداشتیم"
    },
    {
      "id": 15,
      "start": 11504.68,
      "end": 11507.68,
      "formatted_start": "03:11:44.680",
      "formatted_end": "03:11:47.680",
      "text": "نه باشیم، خالی مردم بخواهد کلم داشته"
    },
    {
      "id": 16,
      "start": 11507.68,
      "end": 11509.68,
      "formatted_start": "03:11:47.680",
      "formatted_end": "03:11:49.680",
      "text": "و پس برداشتم که برداشتم"
    },
    {
      "id": 17,
      "start": 11509.68,
      "end": 11511.68,
      "formatted_start": "03:11:49.680",
      "formatted_end": "03:11:51.680",
      "text": "در اینجا بازم نیازی از بیا و یا"
    },
    {
      "id": 18,
      "start": 11511.68,
      "end": 11513.68,
      "formatted_start": "03:11:51.680",
      "formatted_end": "03:11:53.680",
      "text": "دو هفته دیگه یه نگاهی بکنم"
    },
    {
      "id": 19,
      "start": 11513.68,
      "end": 11515.68,
      "formatted_start": "03:11:53.680",
      "formatted_end": "03:11:55.680",
      "text": "فاطوری درمان های اجام بدن"
    },
    {
      "id": 20,
      "start": 11515.68,
      "end": 11517.68,
      "formatted_start": "03:11:55.680",
      "formatted_end": "03:11:57.680",
      "text": "برای شروع و ساز بکنم"
    },
    {
      "id": 21,
      "start": 11517.68,
      "end": 11519.68,
      "formatted_start": "03:11:57.680",
      "formatted_end": "03:11:59.680",
      "text": "آه، ورزش فراموش کرده"
    },
    {
      "id": 22,
      "start": 11519.68,
      "end": 11521.68,
      "formatted_start": "03:11:59.680",
      "formatted_end": "03:12:01.680",
      "text": "سوال را گفتید، ببینیم"
    },
    {
      "id": 23,
      "start": 11521.68,
      "end": 11523.68,
      "formatted_start": "03:12:01.680",
      "formatted_end": "03:12:03.680",
      "text": "نه، به من نگاه کنیم"
    },
    {
      "id": 24,
      "start": 11523.68,
      "end": 11526.68,
      "formatted_start": "03:12:03.680",
      "formatted_end": "03:12:06.680",
      "text": "اینکه پاکتونو میزنید انگوشتو می کشید بالا"
    },
    {
      "id": 25,
      "start": 11526.68,
      "end": 11529.68,
      "formatted_start": "03:12:06.680",
      "formatted_end": "03:12:09.680",
      "text": "تا 20 میشمارید شلوی می کنید"
    },
    {
      "id": 26,
      "start": 11529.68,
      "end": 11532.68,
      "formatted_start": "03:12:09.680",
      "formatted_end": "03:12:12.680",
      "text": "درست؟ باز دوباره می آریم بالا"
    },
    {
      "id": 27,
      "start": 11532.68,
      "end": 11535.68,
      "formatted_start": "03:12:12.680",
      "formatted_end": "03:12:15.680",
      "text": "یک، دو، سه، چهار تا 20 میشمارید"
    },
    {
      "id": 28,
      "start": 11535.68,
      "end": 11536.68,
      "formatted_start": "03:12:15.680",
      "formatted_end": "03:12:16.680",
      "text": "باز میزارید"
    },
    {
      "id": 29,
      "start": 11536.68,
      "end": 11539.68,
      "formatted_start": "03:12:16.680",
      "formatted_end": "03:12:19.680",
      "text": "20 تا صبح، 20 تا صبح، 20 تا شمت"
    },
    {
      "id": 30,
      "start": 11539.68,
      "end": 11540.68,
      "formatted_start": "03:12:19.680",
      "formatted_end": "03:12:20.680",
      "text": "همهش 20"
    },
    {
      "id": 31,
      "start": 11540.68,
      "end": 11542.68,
      "formatted_start": "03:12:20.680",
      "formatted_end": "03:12:22.680",
      "text": "20 تا 20 میشمارید"
    },
    {
      "id": 32,
      "start": 11542.68,
      "end": 11544.68,
      "formatted_start": "03:12:22.680",
      "formatted_end": "03:12:24.680",
      "text": "20 دفعه صبح، 20 دفعه صبح، 20 دفعه شمت"
    },
    {
      "id": 33,
      "start": 11544.68,
      "end": 11546.68,
      "formatted_start": "03:12:24.680",
      "formatted_end": "03:12:26.680",
      "text": "این کار رو مرتب انجام می کنید"
    },
    {
      "id": 34,
      "start": 11546.68,
      "end": 11549.68,
      "formatted_start": "03:12:26.680",
      "formatted_end": "03:12:29.680",
      "text": "تا این از رده 400 اینو صاف که کردید"
    },
    {
      "id": 35,
      "start": 11549.68,
      "end": 11551.68,
      "formatted_start": "03:12:29.680",
      "formatted_end": "03:12:31.680",
      "text": "مستقیم نگه داره"
    },
    {
      "id": 36,
      "start": 11551.68,
      "end": 11555.3,
      "formatted_start": "03:12:31.680",
      "formatted_end": "03:12:35.300",
      "text": "اگر این شل بشه باز اون امکان خروجش هست"
    },
    {
      "id": 37,
      "start": 11555.3,
      "end": 11558.32,
      "formatted_start": "03:12:35.300",
      "formatted_end": "03:12:38.320",
      "text": "همین الان برو روی پله، میکنی که پله میبینی"
    },
    {
      "id": 38,
      "start": 11558.32,
      "end": 11561.86,
      "formatted_start": "03:12:38.320",
      "formatted_end": "03:12:41.860",
      "text": "باید کامل کارتو بزنید، شاید نتیجان توی پله نزدن"
    },
    {
      "id": 39,
      "start": 11561.86,
      "end": 11564.08,
      "formatted_start": "03:12:41.860",
      "formatted_end": "03:12:44.080",
      "text": "خواب؟ همین الان برو شبابوزو بگم"
    },
    {
      "id": 40,
      "start": 11564.08,
      "end": 11565.78,
      "formatted_start": "03:12:44.080",
      "formatted_end": "03:12:45.780",
      "text": "بیاید پله برو"
    },
