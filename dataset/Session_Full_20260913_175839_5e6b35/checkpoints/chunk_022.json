  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "شما وزن هم تر به جان بیدید؟"
    },
    {
      "id": 1,
      "start": 6602.0,
      "end": 6603.0,
      "formatted_start": "01:50:02.000",
      "formatted_end": "01:50:03.000",
      "text": "بله."
    },
    {
      "id": 2,
      "start": 6603.0,
      "end": 6604.0,
      "formatted_start": "01:50:03.000",
      "formatted_end": "01:50:04.000",
      "text": "چه تغییر داشتی؟"
    },
    {
      "id": 3,
      "start": 6604.0,
      "end": 6606.0,
      "formatted_start": "01:50:04.000",
      "formatted_end": "01:50:06.000",
      "text": "5 گیلو، معناه پایین تر گفتید."
    },
    {
      "id": 4,
      "start": 6606.0,
      "end": 6608.0,
      "formatted_start": "01:50:06.000",
      "formatted_end": "01:50:08.000",
      "text": "ورزش هم داشتی؟"
    },
    {
      "id": 5,
      "start": 6608.0,
      "end": 6609.0,
      "formatted_start": "01:50:08.000",
      "formatted_end": "01:50:09.000",
      "text": "نه ورزش."
    },
    {
      "id": 6,
      "start": 6609.0,
      "end": 6612.0,
      "formatted_start": "01:50:09.000",
      "formatted_end": "01:50:12.000",
      "text": "بی کم ورزش بذارید، چشمیش بهتر ایش."
    },
    {
      "id": 7,
      "start": 6612.0,
      "end": 6613.0,
      "formatted_start": "01:50:12.000",
      "formatted_end": "01:50:13.000",
      "text": "چب؟"
    },
    {
      "id": 8,
      "start": 6613.0,
      "end": 6620.0,
      "formatted_start": "01:50:13.000",
      "formatted_end": "01:50:20.000",
      "text": "ببینید، مقدار ما ورز رو کم بکنیم، مثلا 80 درصد چرکی رو کم بکنیم، 20 درصد به ازورات آسیب میزنیم."
    },
    {
      "id": 9,
      "start": 6620.0,
      "end": 6623.0,
      "formatted_start": "01:50:20.000",
      "formatted_end": "01:50:23.000",
      "text": "یعنی هر ورزشی کاشه، بهتره ورزش های بود."
    },
    {
      "id": 10,
      "start": 6623.0,
      "end": 6626.46,
      "formatted_start": "01:50:23.000",
      "formatted_end": "01:50:26.460",
      "text": "ورزش اون 20% آسیب رو کم می کنه"
    },
    {
      "id": 11,
      "start": 6626.46,
      "end": 6629.14,
      "formatted_start": "01:50:26.460",
      "formatted_end": "01:50:29.140",
      "text": "یه مدار از اول ورزش پایست می شود"
    },
    {
      "id": 12,
      "start": 6629.14,
      "end": 6631.24,
      "formatted_start": "01:50:29.140",
      "formatted_end": "01:50:31.240",
      "text": "وزن کم نکنید اتفاقا"
    },
    {
      "id": 13,
      "start": 6631.24,
      "end": 6633.56,
      "formatted_start": "01:50:31.240",
      "formatted_end": "01:50:33.560",
      "text": "چون اون صحبه 20% رو"
    },
    {
      "id": 14,
      "start": 6633.56,
      "end": 6635.56,
      "formatted_start": "01:50:33.560",
      "formatted_end": "01:50:35.560",
      "text": "ازورات می خواهید وزن حفظ می شود"
    },
    {
      "id": 15,
      "start": 6635.56,
      "end": 6636.94,
      "formatted_start": "01:50:35.560",
      "formatted_end": "01:50:36.940",
      "text": "وزن ازورات تلایی است"
    },
    {
      "id": 16,
      "start": 6636.94,
      "end": 6638.1,
      "formatted_start": "01:50:36.940",
      "formatted_end": "01:50:38.100",
      "text": "می خواهید حفظ می شود"
    },
    {
      "id": 17,
      "start": 6638.1,
      "end": 6639.14,
      "formatted_start": "01:50:38.100",
      "formatted_end": "01:50:39.140",
      "text": "چروی زبال است"
    },
    {
      "id": 18,
      "start": 6639.14,
      "end": 6640.1,
      "formatted_start": "01:50:39.140",
      "formatted_end": "01:50:40.100",
      "text": "گریزیم بیرون خام"
    },
    {
      "id": 19,
      "start": 6640.1,
      "end": 6642.1,
      "formatted_start": "01:50:40.100",
      "formatted_end": "01:50:42.100",
      "text": "اونها رو با هم داریم کم می کنیم"
    },
    {
      "id": 20,
      "start": 6642.1,
      "end": 6645.2,
      "formatted_start": "01:50:42.100",
      "formatted_end": "01:50:45.200",
      "text": "80% چروی 20% ازوره رو داریم کم می کنیم"
    },
    {
      "id": 21,
      "start": 6645.2,
      "end": 6646.64,
      "formatted_start": "01:50:45.200",
      "formatted_end": "01:50:46.640",
      "text": "این ازوره حفظ می شود"
    },
    {
      "id": 22,
      "start": 6646.64,
      "end": 6648.24,
      "formatted_start": "01:50:46.640",
      "formatted_end": "01:50:48.240",
      "text": "باز می خواهیم که"
    },
    {
      "id": 23,
      "start": 6648.24,
      "end": 6653.2,
      "formatted_start": "01:50:48.240",
      "formatted_end": "01:50:53.200",
      "text": "با ورزش در درازموده چردیه بیشتری رو آب میکنیم و تحویل میدیم"
    },
    {
      "id": 24,
      "start": 6653.2,
      "end": 6657.68,
      "formatted_start": "01:50:53.200",
      "formatted_end": "01:50:57.680",
      "text": "آب و به ترجیح بدن شاداف ازولانی قوی"
    },
    {
      "id": 25,
      "start": 6657.68,
      "end": 6662.12,
      "formatted_start": "01:50:57.680",
      "formatted_end": "01:51:02.120",
      "text": "به اضافه یک چردیه رفته به دارش که ماده مزهر ما هست"
    },
    {
      "id": 26,
      "start": 6662.12,
      "end": 6664.64,
      "formatted_start": "01:51:02.120",
      "formatted_end": "01:51:04.640",
      "text": "تو رژیمتون را رایت کردید که از اینکه از اینکه"
    },
    {
      "id": 27,
      "start": 6664.64,
      "end": 6667.28,
      "formatted_start": "01:51:04.640",
      "formatted_end": "01:51:07.280",
      "text": "با خود اون داروها رو می کنیم خودش کرد میشه"
    },
    {
      "id": 28,
      "start": 6667.28,
      "end": 6668.48,
      "formatted_start": "01:51:07.280",
      "formatted_end": "01:51:08.480",
      "text": "آفره"
    },
    {
      "id": 29,
      "start": 6668.48,
      "end": 6670.04,
      "formatted_start": "01:51:08.480",
      "formatted_end": "01:51:10.040",
      "text": "دستیبی مرد"
    },
    {
      "id": 30,
      "start": 6670.04,
      "end": 6670.64,
      "formatted_start": "01:51:10.040",
      "formatted_end": "01:51:10.640",
      "text": "آفره"
    },
    {
      "id": 31,
      "start": 6670.64,
      "end": 6675.52,
      "formatted_start": "01:51:10.640",
      "formatted_end": "01:51:15.520",
      "text": "چند مردا خوب صحبت میکنند نسبت به داروشون اونوقت"
    },
    {
      "id": 32,
      "start": 6675.52,
      "end": 6679.76,
      "formatted_start": "01:51:15.520",
      "formatted_end": "01:51:19.760",
      "text": "بابا هم بسر خواله نیست که بخواد از این داروها تمجیب بکنه"
    },
    {
      "id": 33,
      "start": 6679.76,
      "end": 6681.9,
      "formatted_start": "01:51:19.760",
      "formatted_end": "01:51:21.900",
      "text": "ولی خانم ها می آر میگن"
    },
    {
      "id": 34,
      "start": 6681.9,
      "end": 6683.92,
      "formatted_start": "01:51:21.900",
      "formatted_end": "01:51:23.920",
      "text": "آیا در یک طور هیچ اثری نکرد"
    },
    {
      "id": 35,
      "start": 6683.92,
      "end": 6685.66,
      "formatted_start": "01:51:23.920",
      "formatted_end": "01:51:25.660",
      "text": "و شاکی میشن از دارو"
    },
    {
      "id": 36,
      "start": 6685.66,
      "end": 6687.94,
      "formatted_start": "01:51:25.660",
      "formatted_end": "01:51:27.940",
      "text": "چون حضرتیه کرده"
    },
    {
      "id": 37,
      "start": 6687.94,
      "end": 6690.22,
      "formatted_start": "01:51:27.940",
      "formatted_end": "01:51:30.220",
      "text": "و میخواد یه دونه باشه داروش زیاد"
    },
    {
      "id": 38,
      "start": 6690.22,
      "end": 6691.42,
      "formatted_start": "01:51:30.220",
      "formatted_end": "01:51:31.420",
      "text": "این همه دارو نیست"
    },
    {
      "id": 39,
      "start": 6691.42,
      "end": 6693.98,
      "formatted_start": "01:51:31.420",
      "formatted_end": "01:51:33.980",
      "text": "میخواد یه راه آنفوری پیدا کنه"
    },
    {
      "id": 40,
      "start": 6693.98,
      "end": 6695.72,
      "formatted_start": "01:51:33.980",
      "formatted_end": "01:51:35.720",
      "text": "یه راه موجزهی پیدا کنه"
    },
    {
      "id": 41,
      "start": 6695.72,
      "end": 6697.06,
      "formatted_start": "01:51:35.720",
      "formatted_end": "01:51:37.060",
      "text": "انکار می کنه از خانم"
    },
    {
      "id": 42,
      "start": 6697.06,
      "end": 6699.78,
      "formatted_start": "01:51:37.060",
      "formatted_end": "01:51:39.780",
      "text": "حالا دو تا ستا قبل از شما خانم بود"
    },
    {
      "id": 43,
      "start": 6699.78,
      "end": 6701.1,
      "formatted_start": "01:51:39.780",
      "formatted_end": "01:51:41.100",
      "text": "خب دروشه کنمش"
    },
    {
      "id": 44,
      "start": 6701.1,
      "end": 6703.92,
      "formatted_start": "01:51:41.100",
      "formatted_end": "01:51:43.920",
      "text": "هفت سانت که آش بدایید با چین دارمایی"
    },
    {
      "id": 45,
      "start": 6703.92,
      "end": 6705.42,
      "formatted_start": "01:51:43.920",
      "formatted_end": "01:51:45.420",
      "text": "به توی هیچ اثری نکرده"
    },
    {
      "id": 46,
      "start": 6705.42,
      "end": 6706.76,
      "formatted_start": "01:51:45.420",
      "formatted_end": "01:51:46.760",
      "text": "اون رو اثار کرده"
    },
    {
      "id": 47,
      "start": 6706.76,
      "end": 6708.34,
      "formatted_start": "01:51:46.760",
      "formatted_end": "01:51:48.340",
      "text": "اون که هفت سانت کم شده"
    },
    {
      "id": 48,
      "start": 6708.34,
      "end": 6710.06,
      "formatted_start": "01:51:48.340",
      "formatted_end": "01:51:50.060",
      "text": "ولی خب اصلا هیچ اثری نداشت"
    },
    {
      "id": 49,
      "start": 6710.06,
      "end": 6711.58,
      "formatted_start": "01:51:50.060",
      "formatted_end": "01:51:51.580",
      "text": "خودوی چی میخوای اثار داشت"
    },
    {
      "id": 50,
      "start": 6711.58,
      "end": 6713.94,
      "formatted_start": "01:51:51.580",
      "formatted_end": "01:51:53.940",
      "text": "هفت سانت باید در رونامه کم شده بگیر"
    },
    {
      "id": 51,
      "start": 6713.94,
      "end": 6715.24,
      "formatted_start": "01:51:53.940",
      "formatted_end": "01:51:55.240",
      "text": "ساله بعد دیگه"
    },
    {
      "id": 52,
      "start": 6715.24,
      "end": 6717.32,
      "formatted_start": "01:51:55.240",
      "formatted_end": "01:51:57.320",
      "text": "بسه دیگه اون بیشتری نمیخواد"
    },
    {
      "id": 53,
      "start": 6717.32,
      "end": 6718.14,
      "formatted_start": "01:51:57.320",
      "formatted_end": "01:51:58.140",
      "text": "هفت بیشتری"
    },
    {
      "id": 54,
      "start": 6718.14,
      "end": 6722.2,
      "formatted_start": "01:51:58.140",
      "formatted_end": "01:52:02.200",
      "text": "من این داروهایی و کسری و بعضنا"
    },
    {
      "id": 55,
      "start": 6722.2,
      "end": 6723.9,
      "formatted_start": "01:52:02.200",
      "formatted_end": "01:52:03.900",
      "text": "من تو خواهم فهمیدم"
    },
    {
      "id": 56,
      "start": 6723.9,
      "end": 6724.76,
      "formatted_start": "01:52:03.900",
      "formatted_end": "01:52:04.760",
      "text": "خانم هم میدونه"
    },
    {
      "id": 57,
      "start": 6724.76,
      "end": 6726.76,
      "formatted_start": "01:52:04.760",
      "formatted_end": "01:52:06.760",
      "text": "میگه خوابت زیاد شده"
    },
    {
      "id": 58,
      "start": 6726.76,
      "end": 6727.76,
      "formatted_start": "01:52:06.760",
      "formatted_end": "01:52:07.760",
      "text": "آه راحت شده"
    },
    {
      "id": 59,
      "start": 6727.76,
      "end": 6729.76,
      "formatted_start": "01:52:07.760",
      "formatted_end": "01:52:09.760",
      "text": "من اون موقع نفسم فوق نمی آمده"
    },
    {
      "id": 60,
      "start": 6729.76,
      "end": 6730.76,
      "formatted_start": "01:52:09.760",
      "formatted_end": "01:52:10.760",
      "text": "آه نه دیگه"
    },
    {
      "id": 61,
      "start": 6730.76,
      "end": 6733.76,
      "formatted_start": "01:52:10.760",
      "formatted_end": "01:52:13.760",
      "text": "چیز میشه اصلا اکسیجرسیونه"
    },
    {
      "id": 62,
      "start": 6733.76,
      "end": 6734.76,
      "formatted_start": "01:52:13.760",
      "formatted_end": "01:52:14.760",
      "text": "آه نه"
    },
    {
      "id": 63,
      "start": 6734.76,
      "end": 6736.76,
      "formatted_start": "01:52:14.760",
      "formatted_end": "01:52:16.760",
      "text": "میخوایم کم بشه حتی خور خور"
    },
    {
      "id": 64,
      "start": 6736.76,
      "end": 6738.76,
      "formatted_start": "01:52:16.760",
      "formatted_end": "01:52:18.760",
      "text": "حتی خواب شمم کم بید"
    },
    {
      "id": 65,
      "start": 6738.76,
      "end": 6739.76,
      "formatted_start": "01:52:18.760",
      "formatted_end": "01:52:19.760",
      "text": "یعنی میخواییدم"
    },
    {
      "id": 66,
      "start": 6739.76,
      "end": 6740.76,
      "formatted_start": "01:52:19.760",
      "formatted_end": "01:52:20.760",
      "text": "بیدار شده"
    },
    {
      "id": 67,
      "start": 6740.76,
      "end": 6742.76,
      "formatted_start": "01:52:20.760",
      "formatted_end": "01:52:22.760",
      "text": "از فقط شیش صبح خیلی سنه های بیدم"
    },
    {
      "id": 68,
      "start": 6742.76,
      "end": 6744.76,
      "formatted_start": "01:52:22.760",
      "formatted_end": "01:52:24.760",
      "text": "منو بیشتر دوست دارم بخوابم"
    },
    {
      "id": 69,
      "start": 6744.76,
      "end": 6746.76,
      "formatted_start": "01:52:24.760",
      "formatted_end": "01:52:26.760",
      "text": "بنده این قولترانواره سریس یاد میده شده"
    },
    {
      "id": 70,
      "start": 6746.76,
      "end": 6748.76,
      "formatted_start": "01:52:26.760",
      "formatted_end": "01:52:28.760",
      "text": "بله بیدار بشه"
    },
    {
      "id": 71,
      "start": 6748.76,
      "end": 6752.76,
      "formatted_start": "01:52:28.760",
      "formatted_end": "01:52:32.760",
      "text": "برای دفعه، فکرارش بیشتر میشه"
    },
    {
      "id": 72,
      "start": 6759.76,
      "end": 6762.76,
      "formatted_start": "01:52:39.760",
      "formatted_end": "01:52:42.760",
      "text": "پرفورمکس ندارم این دفعه بدم به شما"
    },
    {
      "id": 73,
      "start": 6762.76,
      "end": 6766.76,
      "formatted_start": "01:52:42.760",
      "formatted_end": "01:52:46.760",
      "text": "ویتامین بیم هم تمام شده بود انداختم بیرون"
    },
    {
      "id": 74,
      "start": 6766.76,
      "end": 6768.76,
      "formatted_start": "01:52:46.760",
      "formatted_end": "01:52:48.760",
      "text": "حالا توی مصخم نداریم"
    },
    {
      "id": 75,
      "start": 6768.76,
      "end": 6770.76,
      "formatted_start": "01:52:48.760",
      "formatted_end": "01:52:50.760",
      "text": "نه، نداریم بشم"
    },
    {
      "id": 76,
      "start": 6770.76,
      "end": 6800.76,
      "formatted_start": "01:52:50.760",
      "formatted_end": "01:53:20.760",
      "text": "مرتبه از مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکسی تا مورتیفکس"
    },
    {
      "id": 77,
      "start": 6800.76,
      "end": 6818.76,
      "formatted_start": "01:53:20.760",
      "formatted_end": "01:53:38.760",
      "text": "موسیقی"
    },
    {
      "id": 78,
      "start": 6818.76,
      "end": 6819.76,
      "formatted_start": "01:53:38.760",
      "formatted_end": "01:53:39.760",
      "text": "با این یه زنون؟"
    },
    {
      "id": 79,
      "start": 6819.76,
      "end": 6820.76,
      "formatted_start": "01:53:39.760",
      "formatted_end": "01:53:40.760",
      "text": "بله زنون"
    },
    {
      "id": 80,
      "start": 6837.76,
      "end": 6840.76,
      "formatted_start": "01:53:57.760",
      "formatted_end": "01:54:00.760",
      "text": "محتاجی که ازتونو هستید، اینو بدم"
    },
    {
      "id": 81,
      "start": 6840.76,
      "end": 6844.76,
      "formatted_start": "01:54:00.760",
      "formatted_end": "01:54:04.760",
      "text": "شبیه همونی داریم، از سر بخشش بود، اسمی باید بشته بگیر"
    },
    {
      "id": 82,
      "start": 6844.76,
      "end": 6846.76,
      "formatted_start": "01:54:04.760",
      "formatted_end": "01:54:06.760",
      "text": "با آزمایش ببینید که ای بود؟"
    },
    {
      "id": 83,
      "start": 6846.76,
      "end": 6850.76,
      "formatted_start": "01:54:06.760",
      "formatted_end": "01:54:10.760",
      "text": "این هم افرادتون رو چهار سن و چهار"
    },
    {
      "id": 84,
      "start": 6850.76,
      "end": 6852.76,
      "formatted_start": "01:54:10.760",
      "formatted_end": "01:54:12.760",
      "text": "دوست کنید"
    },
    {
      "id": 85,
      "start": 6852.76,
      "end": 6855.76,
      "formatted_start": "01:54:12.760",
      "formatted_end": "01:54:15.760",
      "text": "نیاز ناشسته رو جاییدم براتون بگیرسم"
    },
    {
      "id": 86,
      "start": 6855.76,
      "end": 6860.76,
      "formatted_start": "01:54:15.760",
      "formatted_end": "01:54:20.760",
      "text": "این هم به نها"
    },
    {
      "id": 87,
      "start": 6860.76,
      "end": 6863.76,
      "formatted_start": "01:54:20.760",
      "formatted_end": "01:54:23.760",
      "text": "از دیگه ما شهسته بگیرسم"
    },
    {
      "id": 88,
      "start": 6863.76,
      "end": 6893.76,
      "formatted_start": "01:54:23.760",
      "formatted_end": "01:54:53.760",
      "text": "بسیار دوست داریم که برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه"
    },
    {
      "id": 89,
      "start": 6893.76,
      "end": 6895.76,
      "formatted_start": "01:54:53.760",
      "formatted_end": "01:54:55.760",
      "text": "اشون از اینجا برده"
    },
    {
      "id": 90,
      "start": 6895.76,
      "end": 6897.76,
      "formatted_start": "01:54:55.760",
      "formatted_end": "01:54:57.760",
      "text": "اشون اونجا بره"
    },
    {
      "id": 91,
      "start": 6897.76,
      "end": 6899.76,
      "formatted_start": "01:54:57.760",
      "formatted_end": "01:54:59.760",
      "text": "از چهار دنیا باید شدید"
    }
  ],
  "status": "completed"
}