  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3603.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:03.000",
      "text": "یک هفته دیگه دوباره باید بیاییم گوش دارم."
    },
    {
      "id": 1,
      "start": 3603.0,
      "end": 3604.0,
      "formatted_start": "01:00:03.000",
      "formatted_end": "01:00:04.000",
      "text": "بسیار."
    },
    {
      "id": 2,
      "start": 3604.0,
      "end": 3605.0,
      "formatted_start": "01:00:04.000",
      "formatted_end": "01:00:05.000",
      "text": "بسیار."
    },
    {
      "id": 3,
      "start": 3606.0,
      "end": 3607.0,
      "formatted_start": "01:00:06.000",
      "formatted_end": "01:00:07.000",
      "text": "خیلی ممنون بادیم."
    },
    {
      "id": 4,
      "start": 3607.0,
      "end": 3608.0,
      "formatted_start": "01:00:07.000",
      "formatted_end": "01:00:08.000",
      "text": "خیلی ممنون بادیم."
    },
    {
      "id": 5,
      "start": 3608.0,
      "end": 3611.0,
      "formatted_start": "01:00:08.000",
      "formatted_end": "01:00:11.000",
      "text": "بفرما، آقا رزا بیا."
    },
    {
      "id": 6,
      "start": 3612.0,
      "end": 3613.0,
      "formatted_start": "01:00:12.000",
      "formatted_end": "01:00:13.000",
      "text": "سلام."
    },
    {
      "id": 7,
      "start": 3613.0,
      "end": 3615.0,
      "formatted_start": "01:00:13.000",
      "formatted_end": "01:00:15.000",
      "text": "سلام ملیم."
    },
    {
      "id": 8,
      "start": 3616.0,
      "end": 3618.0,
      "formatted_start": "01:00:16.000",
      "formatted_end": "01:00:18.000",
      "text": "دیدم رزا ببینم."
    },
    {
      "id": 9,
      "start": 3618.0,
      "end": 3624.0,
      "formatted_start": "01:00:18.000",
      "formatted_end": "01:00:24.000",
      "text": "این خوش خود سکباده، روزی یک دانه میخوری، سکبادتو بگیره، بهتر شبا بخورید."
    },
    {
      "id": 10,
      "start": 3624.0,
      "end": 3626.0,
      "formatted_start": "01:00:24.000",
      "formatted_end": "01:00:26.000",
      "text": "شبا بخورم، درد و درد."
    },
    {
      "id": 11,
      "start": 3626.0,
      "end": 3631.0,
      "formatted_start": "01:00:26.000",
      "formatted_end": "01:00:31.000",
      "text": "این روزی سه تا میخوری که برای دردهای بدنیت"
    },
    {
      "id": 12,
      "start": 3631.0,
      "end": 3634.0,
      "formatted_start": "01:00:31.000",
      "formatted_end": "01:00:34.000",
      "text": "آمپولات اینها خارجی ها هفتهیه"
    },
    {
      "id": 13,
      "start": 3634.0,
      "end": 3638.0,
      "formatted_start": "01:00:34.000",
      "formatted_end": "01:00:38.000",
      "text": "اینها ایرانی ها یه روز درد می آمید"
    },
    {
      "id": 14,
      "start": 3638.0,
      "end": 3642.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:42.000",
      "text": "برای اون خوامساز و نامشتن"
    },
    {
      "id": 15,
      "start": 3642.0,
      "end": 3645.0,
      "formatted_start": "01:00:42.000",
      "formatted_end": "01:00:45.000",
      "text": "برای تو واقعا روشان بینیست تو دردهای هفتهیه"
    },
    {
      "id": 16,
      "start": 3645.0,
      "end": 3647.0,
      "formatted_start": "01:00:45.000",
      "formatted_end": "01:00:47.000",
      "text": "هر هفته دو بانه اینها هفته"
    },
    {
      "id": 17,
      "start": 3647.0,
      "end": 3649.0,
      "formatted_start": "01:00:47.000",
      "formatted_end": "01:00:49.000",
      "text": "کدوم دارو خانه رفتهی؟"
    },
    {
      "id": 18,
      "start": 3649.0,
      "end": 3650.0,
      "formatted_start": "01:00:49.000",
      "formatted_end": "01:00:50.000",
      "text": "باش"
    },
    {
      "id": 19,
      "start": 3650.0,
      "end": 3652.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:52.000",
      "text": "دارو خانه دور رفته"
    },
    {
      "id": 20,
      "start": 3652.0,
      "end": 3654.0,
      "formatted_start": "01:00:52.000",
      "formatted_end": "01:00:54.000",
      "text": "مردم در اینجا باید بردارید"
    },
    {
      "id": 21,
      "start": 3654.0,
      "end": 3656.0,
      "formatted_start": "01:00:54.000",
      "formatted_end": "01:00:56.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 22,
      "start": 3656.0,
      "end": 3658.0,
      "formatted_start": "01:00:56.000",
      "formatted_end": "01:00:58.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 23,
      "start": 3658.0,
      "end": 3660.0,
      "formatted_start": "01:00:58.000",
