  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9920.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:20.000",
      "text": "ازیت نمیکنه. نه، کمر اونقدر نیست، بیشتر همه سیارتی در سمت چپ. اگر بالا میشم که مثلا یک کار میکنم، دیگه شروع کنه. دیگه من همیشه عصبیم. همیشه عصبیم دیگه، این درد این عصبی سر من."
    },
    {
      "id": 1,
      "start": 9920.0,
      "end": 9928.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:28.000",
      "text": "قبل از این درد رو بگیری، عصبی نبودی؟"
    },
    {
      "id": 2,
      "start": 9928.0,
      "end": 9929.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:29.000",
      "text": "نه"
    },
    {
      "id": 3,
      "start": 9929.0,
      "end": 9930.0,
      "formatted_start": "02:45:29.000",
      "formatted_end": "02:45:30.000",
      "text": "خوش افلاق بودی؟"
    },
    {
      "id": 4,
      "start": 9930.0,
      "end": 9931.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:31.000",
      "text": "نه"
    },
    {
      "id": 5,
      "start": 9931.0,
      "end": 9934.0,
      "formatted_start": "02:45:31.000",
      "formatted_end": "02:45:34.000",
      "text": "همه میگفتند بختر خانم چقدر خوبه؟"
    },
    {
      "id": 6,
      "start": 9934.0,
      "end": 9935.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:35.000",
      "text": "نه"
    },
    {
      "id": 7,
      "start": 9935.0,
      "end": 9936.0,
      "formatted_start": "02:45:35.000",
      "formatted_end": "02:45:36.000",
      "text": "حالا؟"
    },
    {
      "id": 8,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "اصلا فالم میشم دیگه یک کار بوده"
    },
    {
      "id": 9,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "نه، دیگه حرف خوش با شوهرش نداری"
    },
    {
      "id": 10,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "هم، بیچار شوهرش برم"
    },
    {
      "id": 11,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "فالم میشم دیگه یک کار بوده"
    },
    {
      "id": 12,
      "start": 9944.0,
      "end": 9946.0,
      "formatted_start": "02:45:44.000",
      "formatted_end": "02:45:46.000",
      "text": "خوروشتو شیشه کرد"
    },
    {
      "id": 13,
      "start": 9946.0,
      "end": 9976.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:46:16.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 14,
      "start": 9976.0,
      "end": 9978.0,
      "formatted_start": "02:46:16.000",
      "formatted_end": "02:46:18.000",
      "text": "خانم بارانی؟"
    },
    {
      "id": 15,
      "start": 9978.0,
      "end": 9982.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:22.000",
      "text": "من جلاسه کردیم، این نبود، این هست"
    },
    {
      "id": 16,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "این هست، این هست، این هست"
    },
    {
      "id": 17,
      "start": 9984.0,
      "end": 9986.0,
      "formatted_start": "02:46:24.000",
      "formatted_end": "02:46:26.000",
      "text": "این هست، این هست، این هست"
    },
    {
      "id": 18,
      "start": 9986.0,
      "end": 9987.0,
      "formatted_start": "02:46:26.000",
      "formatted_end": "02:46:27.000",
      "text": "این غنده؟"
    },
    {
      "id": 19,
      "start": 9987.0,
      "end": 9988.0,
      "formatted_start": "02:46:27.000",
      "formatted_end": "02:46:28.000",
      "text": "آهان"
    },
    {
      "id": 20,
      "start": 9988.0,
      "end": 9989.0,
      "formatted_start": "02:46:28.000",
      "formatted_end": "02:46:29.000",
      "text": "سونو دواش آورده؟"
    },
    {
      "id": 21,
      "start": 9989.0,
      "end": 9990.0,
      "formatted_start": "02:46:29.000",
      "formatted_end": "02:46:30.000",
      "text": "بله"
    },
    {
      "id": 22,
      "start": 9990.0,
      "end": 9991.0,
      "formatted_start": "02:46:30.000",
      "formatted_end": "02:46:31.000",
      "text": "دادی؟"
    },
    {
      "id": 23,
      "start": 9991.0,
      "end": 9992.0,
      "formatted_start": "02:46:31.000",
      "formatted_end": "02:46:32.000",
      "text": "بله"
    },
    {
      "id": 24,
      "start": 9992.0,
      "end": 9993.0,
      "formatted_start": "02:46:32.000",
      "formatted_end": "02:46:33.000",
      "text": "من گفتیم، من گفتیم، که این هست؟"
    },
    {
      "id": 25,
      "start": 9993.0,
      "end": 9995.0,
      "formatted_start": "02:46:33.000",
      "formatted_end": "02:46:35.000",
      "text": "بله، بی غنه نامده"
    },
    {
      "id": 26,
      "start": 9995.0,
      "end": 9997.0,
      "formatted_start": "02:46:35.000",
      "formatted_end": "02:46:37.000",
      "text": "بله، بی غنه نامده"
    },
    {
      "id": 27,
      "start": 9997.0,
      "end": 10003.0,
      "formatted_start": "02:46:37.000",
      "formatted_end": "02:46:43.000",
      "text": "این رو دیدیم، دروه ها خوب هستند، ولی دروه های خیلی خوب برات نمیشتم"
    },
    {
      "id": 28,
      "start": 10003.0,
      "end": 10012.6,
      "formatted_start": "02:46:43.000",
      "formatted_end": "02:46:52.600",
      "text": "کمی خوب هستند من خیلی خوب نمیشتم انشالله با این دروبه ها کمتر میشه امروز روز سشنبه است"
    },
    {
      "id": 29,
      "start": 10012.6,
      "end": 10021.64,
      "formatted_start": "02:46:52.600",
      "formatted_end": "02:47:01.640",
      "text": "هفته دیگه سشنبه نیاد هفته بعدی سشنبه دوباره بیاد تا را تو هم پیش آرود بودی خودش بیاد دیگه با یک رایی با دلتون داشته باشید"
    },
    {
      "id": 30,
      "start": 10021.64,
      "end": 10025.64,
      "formatted_start": "02:47:01.640",
      "formatted_end": "02:47:05.640",
      "text": "نه که قریمت هم حالا قریمت هم فایده را خواهد دارید رو رشکن کنیم خب؟"
    },
    {
      "id": 31,
      "start": 10025.64,
      "end": 10026.64,
      "formatted_start": "02:47:05.640",
      "formatted_end": "02:47:06.640",
      "text": "نه دیگه"
    },
    {
      "id": 32,
      "start": 10026.64,
      "end": 10028.64,
      "formatted_start": "02:47:06.640",
      "formatted_end": "02:47:08.640",
      "text": "بله باید چند دوره بیاد؟ عمل هم داری خاله؟"
    },
    {
      "id": 33,
      "start": 10028.64,
      "end": 10032.64,
      "formatted_start": "02:47:08.640",
      "formatted_end": "02:47:12.640",
      "text": "نه، نه، نه، نه، زیاد نه"
    },
    {
      "id": 34,
      "start": 10032.64,
      "end": 10034.64,
      "formatted_start": "02:47:12.640",
      "formatted_end": "02:47:14.640",
      "text": "میخوره"
    },
    {
      "id": 35,
      "start": 10034.64,
      "end": 10038.64,
      "formatted_start": "02:47:14.640",
      "formatted_end": "02:47:18.640",
      "text": "آره، آره، میخوره، آره، من مقدر نکشم"
    },
    {
      "id": 36,
      "start": 10038.64,
      "end": 10042.64,
      "formatted_start": "02:47:18.640",
      "formatted_end": "02:47:22.640",
      "text": "اول جرمتو فکر کردی، میکشه، چقدر مصرف داری؟"
    },
    {
      "id": 37,
      "start": 10042.64,
      "end": 10044.64,
      "formatted_start": "02:47:22.640",
      "formatted_end": "02:47:24.640",
      "text": "چقدر مصرف داری؟"
    },
    {
      "id": 38,
      "start": 10044.64,
      "end": 10052.64,
      "formatted_start": "02:47:24.640",
      "formatted_end": "02:47:32.640",
      "text": "مثلا، یک گرمه دو روز، مثلا، نه، یک گرمه میکشه"
    },
    {
      "id": 39,
      "start": 10052.64,
      "end": 10055.64,
      "formatted_start": "02:47:32.640",
      "formatted_end": "02:47:35.640",
      "text": "یک گرم نه، اره ها کم کشتر"
    },
    {
      "id": 40,
      "start": 10055.64,
      "end": 10057.64,
      "formatted_start": "02:47:35.640",
      "formatted_end": "02:47:37.640",
      "text": "گرام شده، خیلی گرام شده"
    },
    {
      "id": 41,
      "start": 10057.64,
      "end": 10059.64,
      "formatted_start": "02:47:37.640",
      "formatted_end": "02:47:39.640",
      "text": "گرام شده کم کرد"
    },
    {
      "id": 42,
      "start": 10059.64,
      "end": 10061.64,
      "formatted_start": "02:47:39.640",
      "formatted_end": "02:47:41.640",
      "text": "بیا، ریپتارو باش شروع کن"
    },
    {
      "id": 43,
      "start": 10061.64,
      "end": 10063.64,
      "formatted_start": "02:47:41.640",
      "formatted_end": "02:47:43.640",
      "text": "هم توقع بخور"
    },
    {
      "id": 44,
      "start": 10063.64,
      "end": 10065.64,
      "formatted_start": "02:47:43.640",
      "formatted_end": "02:47:45.640",
      "text": "برس قردت هم بخور"
    },
    {
      "id": 45,
      "start": 10065.64,
      "end": 10067.64,
      "formatted_start": "02:47:45.640",
      "formatted_end": "02:47:47.640",
      "text": "آره، برس قردت هم خوابجی هست"
    },
    {
      "id": 46,
      "start": 10067.64,
      "end": 10069.64,
      "formatted_start": "02:47:47.640",
      "formatted_end": "02:47:49.640",
      "text": "بگو بستی؟"
    },
    {
      "id": 47,
      "start": 10069.64,
      "end": 10071.64,
      "formatted_start": "02:47:49.640",
      "formatted_end": "02:47:51.640",
      "text": "من نوبت نه، مامان من"
    },
    {
      "id": 48,
      "start": 10071.64,
      "end": 10073.64,
      "formatted_start": "02:47:51.640",
      "formatted_end": "02:47:53.640",
      "text": "ببین کار نداره، لازم شد میگه"
    },
    {
      "id": 49,
      "start": 10073.64,
      "end": 10075.64,
      "formatted_start": "02:47:53.640",
      "formatted_end": "02:47:55.640",
      "text": "میگم یه دو تا جور خیال کشتم"
    },
    {
      "id": 50,
      "start": 10075.64,
      "end": 10077.64,
      "formatted_start": "02:47:55.640",
      "formatted_end": "02:47:57.640",
      "text": "با بیل اینجوری مثلا پابل کردم"
    },
    {
      "id": 51,
      "start": 10077.64,
      "end": 10079.64,
      "formatted_start": "02:47:57.640",
      "formatted_end": "02:47:59.640",
      "text": "خب از اون موقع"
    },
    {
      "id": 52,
      "start": 10079.64,
      "end": 10081.64,
      "formatted_start": "02:47:59.640",
      "formatted_end": "02:48:01.640",
      "text": "این زامون با کف پان"
    },
    {
      "id": 53,
      "start": 10081.64,
      "end": 10083.64,
      "formatted_start": "02:48:01.640",
      "formatted_end": "02:48:03.640",
      "text": "خیلی درد شد"
    },
    {
      "id": 54,
      "start": 10083.64,
      "end": 10085.64,
      "formatted_start": "02:48:03.640",
      "formatted_end": "02:48:05.640",
      "text": "اینجا، حتما در اینجا"
    },
    {
      "id": 55,
      "start": 10085.64,
      "end": 10087.64,
      "formatted_start": "02:48:05.640",
      "formatted_end": "02:48:07.640",
      "text": "خودتو سر اینجا برم"
    },
    {
      "id": 56,
      "start": 10087.64,
      "end": 10089.64,
      "formatted_start": "02:48:07.640",
      "formatted_end": "02:48:09.640",
      "text": "خودتو بزاریم"
    },
    {
      "id": 57,
      "start": 10089.64,
      "end": 10091.64,
      "formatted_start": "02:48:09.640",
      "formatted_end": "02:48:11.640",
      "text": "خیلی یک ماه ها دارن بیرون موسیقی درمانی بیرون"
    },
    {
      "id": 58,
      "start": 10091.64,
      "end": 10093.64,
      "formatted_start": "02:48:11.640",
      "formatted_end": "02:48:13.640",
      "text": "نه نه نه، اینجا پیچیده زنو"
    },
    {
      "id": 59,
      "start": 10093.64,
      "end": 10095.64,
      "formatted_start": "02:48:13.640",
      "formatted_end": "02:48:15.640",
      "text": "این زنو صاف نیست"
    },
    {
      "id": 60,
      "start": 10095.64,
      "end": 10097.64,
      "formatted_start": "02:48:15.640",
      "formatted_end": "02:48:17.640",
      "text": "این چرخیده دیگه، درخت دیگه یه جزگی داره"
    },
    {
      "id": 61,
      "start": 10097.64,
      "end": 10099.64,
      "formatted_start": "02:48:17.640",
      "formatted_end": "02:48:19.640",
      "text": "اینو باید جاهنده زنو برم"
    },
    {
      "id": 62,
      "start": 10099.64,
      "end": 10101.64,
      "formatted_start": "02:48:19.640",
      "formatted_end": "02:48:21.640",
      "text": "هم خانم بیرون هست، همینجوره"
    },
    {
      "id": 63,
      "start": 10101.64,
      "end": 10103.64,
      "formatted_start": "02:48:21.640",
      "formatted_end": "02:48:23.640",
      "text": "کاملا جا بده زنو برم"
    },
    {
      "id": 64,
      "start": 10103.64,
      "end": 10105.64,
      "formatted_start": "02:48:23.640",
      "formatted_end": "02:48:25.640",
      "text": "نه نه، بسیار"
    },
    {
      "id": 65,
      "start": 10105.64,
      "end": 10107.64,
      "formatted_start": "02:48:25.640",
      "formatted_end": "02:48:27.640",
      "text": "این خزینه ش"
    },
    {
      "id": 66,
      "start": 10107.64,
      "end": 10109.64,
      "formatted_start": "02:48:27.640",
      "formatted_end": "02:48:29.640",
      "text": "کم آده"
    },
    {
      "id": 67,
      "start": 10109.64,
      "end": 10111.64,
      "formatted_start": "02:48:29.640",
      "formatted_end": "02:48:31.640",
      "text": "کم آده گشته"
    },
    {
      "id": 68,
      "start": 10111.64,
      "end": 10113.64,
      "formatted_start": "02:48:31.640",
      "formatted_end": "02:48:33.640",
      "text": "از این پاکانه پنجه هشت"
    },
    {
      "id": 69,
      "start": 10113.64,
      "end": 10115.64,
      "formatted_start": "02:48:33.640",
      "formatted_end": "02:48:35.640",
      "text": "کم آده گشته بود"
    },
    {
      "id": 70,
      "start": 10115.64,
      "end": 10117.64,
      "formatted_start": "02:48:35.640",
      "formatted_end": "02:48:37.640",
      "text": "کم آده داره"
    },
    {
      "id": 71,
      "start": 10117.64,
      "end": 10119.64,
      "formatted_start": "02:48:37.640",
      "formatted_end": "02:48:39.640",
      "text": "از این پاکانه هشت"
    },
    {
      "id": 72,
      "start": 10119.64,
      "end": 10121.64,
      "formatted_start": "02:48:39.640",
      "formatted_end": "02:48:41.640",
      "text": "همسر اجازه میده منو ندارم انجام بده منو"
    },
    {
      "id": 73,
      "start": 10121.64,
      "end": 10123.64,
      "formatted_start": "02:48:41.640",
      "formatted_end": "02:48:43.640",
      "text": "من همسر ندارم"
    },
    {
      "id": 74,
      "start": 10123.64,
      "end": 10125.64,
      "formatted_start": "02:48:43.640",
      "formatted_end": "02:48:45.640",
      "text": "اجازه هم دست خودم نیم"
    },
    {
      "id": 75,
      "start": 10125.64,
      "end": 10127.64,
      "formatted_start": "02:48:45.640",
      "formatted_end": "02:48:47.640",
      "text": "حاضره باشیم اسمت چی میده"
    },
    {
      "id": 76,
      "start": 10127.64,
      "end": 10129.64,
      "formatted_start": "02:48:47.640",
      "formatted_end": "02:48:49.640",
      "text": "حاضره هزینه ش اونقدر ندارم"
    },
    {
      "id": 77,
      "start": 10129.64,
      "end": 10131.64,
      "formatted_start": "02:48:49.640",
      "formatted_end": "02:48:51.640",
      "text": "ساست من دارم بیدم"
    },
    {
      "id": 78,
      "start": 10131.64,
      "end": 10133.64,
      "formatted_start": "02:48:51.640",
      "formatted_end": "02:48:53.640",
      "text": "برایش باید مادرمون این سری اومده"
    },
    {
      "id": 79,
      "start": 10133.64,
      "end": 10135.64,
      "formatted_start": "02:48:53.640",
      "formatted_end": "02:48:55.640",
      "text": "بگیرم کارتو بده و بگیرم موگلشو"
    },
    {
      "id": 80,
      "start": 10139.64,
      "end": 10141.64,
      "formatted_start": "02:48:59.640",
      "formatted_end": "02:49:01.640",
      "text": "باید دو ما خود میشم"
    },
    {
      "id": 81,
      "start": 10141.64,
      "end": 10143.64,
      "formatted_start": "02:49:01.640",
      "formatted_end": "02:49:03.640",
      "text": "به تدریج خوب میشی"
    },
    {
      "id": 82,
      "start": 10143.64,
      "end": 10145.64,
      "formatted_start": "02:49:03.640",
      "formatted_end": "02:49:05.640",
      "text": "به تدریج"
    },
    {
      "id": 83,
      "start": 10145.64,
      "end": 10147.64,
      "formatted_start": "02:49:05.640",
      "formatted_end": "02:49:07.640",
      "text": "بله به تدریج خوب میشین"
    },
    {
      "id": 84,
      "start": 10147.64,
      "end": 10149.64,
      "formatted_start": "02:49:07.640",
      "formatted_end": "02:49:09.640",
      "text": "آره"
    },
    {
      "id": 85,
      "start": 10149.64,
      "end": 10151.64,
      "formatted_start": "02:49:09.640",
      "formatted_end": "02:49:11.640",
      "text": "باید چون نیمه تر سن بالاست"
    },
    {
      "id": 86,
      "start": 10151.64,
      "end": 10153.64,
      "formatted_start": "02:49:11.640",
      "formatted_end": "02:49:13.640",
      "text": "نوات مسرح میخونی"
    },
    {
      "id": 87,
      "start": 10153.64,
      "end": 10155.64,
      "formatted_start": "02:49:13.640",
      "formatted_end": "02:49:15.640",
      "text": "بعد هم که ترسیدی از درد"
    },
    {
      "id": 88,
      "start": 10155.64,
      "end": 10157.64,
      "formatted_start": "02:49:15.640",
      "formatted_end": "02:49:17.640",
      "text": "اینو هست"
    },
    {
      "id": 89,
      "start": 10157.64,
      "end": 10159.64,
      "formatted_start": "02:49:17.640",
      "formatted_end": "02:49:19.640",
      "text": "میترسید زمینگیر بشی"
    },
    {
      "id": 90,
      "start": 10159.64,
      "end": 10161.64,
      "formatted_start": "02:49:19.640",
      "formatted_end": "02:49:21.640",
      "text": "اینجوری نیست نه"
    },
    {
      "id": 91,
      "start": 10161.64,
      "end": 10166.64,
      "formatted_start": "02:49:21.640",
      "formatted_end": "02:49:26.640",
      "text": "وقتراش خوب شدن، توقرت به خدا باشه، حالا من و دکره های دیگه هم خیلی خوب هستن"
    },
    {
      "id": 92,
      "start": 10166.64,
      "end": 10169.64,
      "formatted_start": "02:49:26.640",
      "formatted_end": "02:49:29.640",
      "text": "میدین اینجا میدین، منم درکتر خودم برمیشم"
    },
    {
      "id": 93,
      "start": 10169.64,
      "end": 10173.64,
      "formatted_start": "02:49:29.640",
      "formatted_end": "02:49:33.640",
      "text": "یه کامیره ماما دیگه، اون چیز کرده ها، آدر سلاس ها"
    },
    {
      "id": 94,
      "start": 10173.64,
      "end": 10179.64,
      "formatted_start": "02:49:33.640",
      "formatted_end": "02:49:39.640",
      "text": "ماند دختر، ماند دختر تیچیده در رفته، مثل درخوای اینجا اندازه بشه"
    },
    {
      "id": 95,
      "start": 10179.64,
      "end": 10184.64,
      "formatted_start": "02:49:39.640",
      "formatted_end": "02:49:44.640",
      "text": "من ماند شما نه، اصلا آسیبه، اصلا بدون ریکارهایی"
    },
    {
      "id": 96,
      "start": 10184.64,
      "end": 10186.64,
      "formatted_start": "02:49:44.640",
      "formatted_end": "02:49:46.640",
      "text": "دوتا کاف داریم، دوتا کاف داریم"
    },
    {
      "id": 97,
      "start": 10186.64,
      "end": 10188.64,
      "formatted_start": "02:49:46.640",
      "formatted_end": "02:49:48.640",
      "text": "این کسان خالی هست."
    },
    {
      "id": 98,
      "start": 10188.64,
      "end": 10190.64,
      "formatted_start": "02:49:48.640",
      "formatted_end": "02:49:50.640",
      "text": "این کسان خالی هست."
    },
    {
      "id": 99,
      "start": 10190.64,
      "end": 10192.64,
      "formatted_start": "02:49:50.640",
      "formatted_end": "02:49:52.640",
      "text": "خیابش بله ملت خالی هست."
    },
    {
      "id": 100,
      "start": 10192.64,
      "end": 10194.64,
      "formatted_start": "02:49:52.640",
      "formatted_end": "02:49:54.640",
      "text": "ملت میگن خالیه."
    },
    {
      "id": 101,
      "start": 10194.64,
      "end": 10196.64,
      "formatted_start": "02:49:54.640",
      "formatted_end": "02:49:56.640",
      "text": "درسته؟"
    },
    {
      "id": 102,
      "start": 10196.64,
      "end": 10198.64,
      "formatted_start": "02:49:56.640",
      "formatted_end": "02:49:58.640",
      "text": "نمیشه."
    },
    {
      "id": 103,
      "start": 10198.64,
      "end": 10200.64,
      "formatted_start": "02:49:58.640",
      "formatted_end": "02:50:00.640",
      "text": "نمیشه."
    }
  ],
  "status": "completed"
}