  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7202.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:02.000",
      "text": "فقط همون روز کنید."
    },
    {
      "id": 1,
      "start": 7202.0,
      "end": 7203.0,
      "formatted_start": "02:00:02.000",
      "formatted_end": "02:00:03.000",
      "text": "همون روز؟"
    },
    {
      "id": 2,
      "start": 7203.0,
      "end": 7210.0,
      "formatted_start": "02:00:03.000",
      "formatted_end": "02:00:10.000",
      "text": "مثلا امروز ۲۷ من نوشتم ۲۷، دیشب ۲۷، امشب ۲۷."
    },
    {
      "id": 3,
      "start": 7210.0,
      "end": 7213.0,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:13.000",
      "text": "امروز ۲۷، ایرانی هستیم ما."
    },
    {
      "id": 4,
      "start": 7213.0,
      "end": 7216.0,
      "formatted_start": "02:00:13.000",
      "formatted_end": "02:00:16.000",
      "text": "عربی اینجوریه که شب قبلش حسابه."
    },
    {
      "id": 5,
      "start": 7216.0,
      "end": 7218.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:18.000",
      "text": "مثلا امروز چند شبه است؟"
    },
    {
      "id": 6,
      "start": 7218.0,
      "end": 7219.0,
      "formatted_start": "02:00:18.000",
      "formatted_end": "02:00:19.000",
      "text": "سه شبه."
    },
    {
      "id": 7,
      "start": 7219.0,
      "end": 7221.0,
      "formatted_start": "02:00:19.000",
      "formatted_end": "02:00:21.000",
      "text": "ایشب رو میگفتن سبشب."
    },
    {
      "id": 8,
      "start": 7221.0,
      "end": 7223.0,
      "formatted_start": "02:00:21.000",
      "formatted_end": "02:00:23.000",
      "text": "عربیشو فراموش میگید."
    },
    {
      "id": 9,
      "start": 7223.0,
      "end": 7224.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:24.000",
      "text": "امشب سه شبه است."
    },
    {
      "id": 10,
      "start": 7224.0,
      "end": 7225.0,
      "formatted_start": "02:00:24.000",
      "formatted_end": "02:00:25.000",
      "text": "سمشب."
    },
    {
      "id": 11,
      "start": 7225.0,
      "end": 7229.4,
      "formatted_start": "02:00:25.000",
      "formatted_end": "02:00:29.400",
      "text": "آره، این قبضیش ایرانیش هست، عربی احساب غرب"
    },
    {
      "id": 12,
      "start": 7229.4,
      "end": 7230.6,
      "formatted_start": "02:00:29.400",
      "formatted_end": "02:00:30.600",
      "text": "آره، درسته؟"
    },
    {
      "id": 13,
      "start": 7230.6,
      "end": 7232.4,
      "formatted_start": "02:00:30.600",
      "formatted_end": "02:00:32.400",
      "text": "بعد نارا هم گفتیم که..."
    },
    {
      "id": 14,
      "start": 7232.4,
      "end": 7236.2,
      "formatted_start": "02:00:32.400",
      "formatted_end": "02:00:36.200",
      "text": "بله، کیس فریزر هم بسایی، یعنی تاریخ ها اکثر هم بیرن عربی حساب میکنن"
    },
    {
      "id": 15,
      "start": 7236.2,
      "end": 7238.8,
      "formatted_start": "02:00:36.200",
      "formatted_end": "02:00:38.800",
      "text": "اون روزش که میگن، این موردش حسابه"
    },
    {
      "id": 16,
      "start": 7238.8,
      "end": 7241.6,
      "formatted_start": "02:00:38.800",
      "formatted_end": "02:00:41.600",
      "text": "کیس فریزر هم بلا فاصله بعد از نزدیکی بسارید"
    },
    {
      "id": 17,
      "start": 7241.6,
      "end": 7246.4,
      "formatted_start": "02:00:41.600",
      "formatted_end": "02:00:46.400",
      "text": "دو ساعت ها بالا باشید، بلند نشید، استرات مطلب داشته باشید"
    },
    {
      "id": 18,
      "start": 7246.4,
      "end": 7250.4,
      "formatted_start": "02:00:46.400",
      "formatted_end": "02:00:50.400",
      "text": "فرداشم کار سختی انجام ندید بعد از دو ساعت بریم دست شوید"
    },
    {
      "id": 19,
      "start": 7250.4,
      "end": 7254.4,
      "formatted_start": "02:00:50.400",
      "formatted_end": "02:00:54.400",
      "text": "پس پند از نزدیکی حتما اطراف کرده باشید که از یه نشان"
    },
    {
      "id": 20,
      "start": 7254.4,
      "end": 7256.4,
      "formatted_start": "02:00:54.400",
      "formatted_end": "02:00:56.400",
      "text": "از همین استرسی همون توانیم"
    },
    {
      "id": 21,
      "start": 7256.4,
      "end": 7259.4,
      "formatted_start": "02:00:56.400",
      "formatted_end": "02:00:59.400",
      "text": "این مامانا به این افراد گفته باشه که مثلا مانیره چند ساله باردارن شده"
    },
    {
      "id": 22,
      "start": 7259.4,
      "end": 7263.4,
      "formatted_start": "02:00:59.400",
      "formatted_end": "02:01:03.400",
      "text": "طرف سریع فراموش نیست استرس داره مانیره که باردارن شده"
    },
    {
      "id": 23,
      "start": 7263.4,
      "end": 7268.4,
      "formatted_start": "02:01:03.400",
      "formatted_end": "02:01:08.400",
      "text": "یعنی این عامل بزرگ ناباید ولی تیپ شخصیتیه"
    },
    {
      "id": 24,
      "start": 7268.4,
      "end": 7275.9,
      "formatted_start": "02:01:08.400",
      "formatted_end": "02:01:15.900",
      "text": "اونایی که زنهایی که تازور میخوابند، تقمه میخورند، تیلیمیزیون میبام میکنند، خوابشون میبره، خواب"
    },
    {
      "id": 25,
      "start": 7275.9,
      "end": 7284.9,
      "formatted_start": "02:01:15.900",
      "formatted_end": "02:01:24.900",
      "text": "بعد حلنگ رو زیاد دارند، به وقت طلک طلک صدا میکنند، موقع صحبت کردند، قدامس میخورند، نزاکت ندارند، ایخی آدن"
    },
    {
      "id": 26,
      "start": 7284.9,
      "end": 7290.9,
      "formatted_start": "02:01:24.900",
      "formatted_end": "02:01:30.900",
      "text": "اونا راحت بچه دارمش، اصلا ما اونها را نمیبینیم در صحن یا بابا، یک دوره مریض اون شکلی ندارم"
    },
    {
      "id": 27,
      "start": 7290.9,
      "end": 7304.9,
      "formatted_start": "02:01:30.900",
      "formatted_end": "02:01:44.900",
      "text": "اونا برای دل درد می آن، اونا برای پونت می آن، اونا برای میل درد، دیگه حالا هر چی باشه قومیتشون یعنی اینقدر بی خیالن، خواب، هر اتفاقی بیفته میگن باشون، هیچ اشکال نداریم"
    },
    {
      "id": 28,
      "start": 7304.9,
      "end": 7316.9,
      "formatted_start": "02:01:44.900",
      "formatted_end": "02:01:56.900",
      "text": "زن مرده دو تا زن میگه، روی خلقه شده، سه تا بگه اشکال نداریم، به من برسن، به بقیه اشکال نداریم، این اصلا به هیچ کار ندارون راحت، بنابراین، بچه برم شده"
    },
    {
      "id": 29,
      "start": 7316.9,
      "end": 7318.9,
      "formatted_start": "02:01:56.900",
      "formatted_end": "02:01:58.900",
      "text": "کم بیشتر باید تقریب شدن؟"
    },
    {
      "id": 30,
      "start": 7318.9,
      "end": 7319.9,
      "formatted_start": "02:01:58.900",
      "formatted_end": "02:01:59.900",
      "text": "کم باید تقریب شدن"
    },
    {
      "id": 31,
      "start": 7319.9,
      "end": 7323.9,
      "formatted_start": "02:01:59.900",
      "formatted_end": "02:02:03.900",
      "text": "اصلا اگر اونها باید هیه قرص جنگردی میدهیم، یه شب اشتباه میکنن، میبخورن او"
    },
    {
      "id": 32,
      "start": 7323.9,
      "end": 7329.9,
      "formatted_start": "02:02:03.900",
      "formatted_end": "02:02:09.900",
      "text": "بیسته شب بردن شدن، یک شب بردن شدن"
    },
    {
      "id": 33,
      "start": 7329.9,
      "end": 7331.9,
      "formatted_start": "02:02:09.900",
      "formatted_end": "02:02:11.900",
      "text": "یعنی آماده بار بریه"
    },
    {
      "id": 34,
      "start": 7331.9,
      "end": 7335.9,
      "formatted_start": "02:02:11.900",
      "formatted_end": "02:02:15.900",
      "text": "زن اصلا طبیعتش اینه که باید زود بردار بشه"
    },
    {
      "id": 35,
      "start": 7335.9,
      "end": 7342.9,
      "formatted_start": "02:02:15.900",
      "formatted_end": "02:02:22.900",
      "text": "ولی زنانی که تو سحنه مدیریت وارد میشن، ذهن مدیر دارن، بیشتر بیرون بیشتر بردن"
    },
    {
      "id": 36,
      "start": 7342.9,
      "end": 7346.9,
      "formatted_start": "02:02:22.900",
      "formatted_end": "02:02:26.900",
      "text": "حالا، یعنی شیوان گرس ها در مورد چه دیگر از من؟"
    },
    {
      "id": 37,
      "start": 7346.9,
      "end": 7353.9,
      "formatted_start": "02:02:26.900",
      "formatted_end": "02:02:33.900",
      "text": "باید این توصیه ها مگه لازم نباشه، نمی کنم این توصیه ها، خیلی من باید اعتناب کنیم، بهه؟"
    },
    {
      "id": 38,
      "start": 7353.9,
      "end": 7361.9,
      "formatted_start": "02:02:33.900",
      "formatted_end": "02:02:41.900",
      "text": "فقط گرس بود، هم گرس می کشتم، این حال واسه دو تا دونا گرس وزن می کشتم، یکی هفته یک، یکی شبیه، پنج روز"
    },
    {
      "id": 39,
      "start": 7361.9,
      "end": 7369.9,
      "formatted_start": "02:02:41.900",
      "formatted_end": "02:02:49.900",
      "text": "بقیه دروار دارد. تا ببینید 13 روز تخمک قابل بار برای درست می کنی یا نه همونطور."
    },
    {
      "id": 40,
      "start": 7369.9,
      "end": 7373.9,
      "formatted_start": "02:02:49.900",
      "formatted_end": "02:02:53.900",
      "text": "سونوگرافیه به ما میگیم. سونوگرافیه کجا گفتم بریم می شو ما؟ نه گفتیم."
    },
    {
      "id": 41,
      "start": 7373.9,
      "end": 7381.9,
      "formatted_start": "02:02:53.900",
      "formatted_end": "02:03:01.900",
      "text": "خاص طریقی کنم انهار کنم. انهار کنم. هم مخلاقش خوبه. هم دقیقه ش خیلی باد است."
    },
    {
      "id": 42,
      "start": 7381.9,
      "end": 7386.9,
      "formatted_start": "02:03:01.900",
      "formatted_end": "02:03:06.900",
      "text": "بعد خوستان را ایشه میدید که شروع کنم. هفته ای از همه روز همه روز."
    },
    {
      "id": 43,
      "start": 7386.9,
      "end": 7391.0,
      "formatted_start": "02:03:06.900",
      "formatted_end": "02:03:11.000",
      "text": "از این روز دارش شد. سه بارون روز بهترین روزش بود. در ما هم هست."
    },
    {
      "id": 44,
      "start": 7391.0,
      "end": 7393.0,
      "formatted_start": "02:03:11.000",
      "formatted_end": "02:03:13.000",
      "text": "اول شو بخوایم روز."
    },
    {
      "id": 45,
      "start": 7393.0,
      "end": 7394.0,
      "formatted_start": "02:03:13.000",
      "formatted_end": "02:03:14.000",
      "text": "بفرام."
    },
    {
      "id": 46,
      "start": 7394.0,
      "end": 7395.0,
      "formatted_start": "02:03:14.000",
      "formatted_end": "02:03:15.000",
      "text": "بفرام."
    },
    {
      "id": 47,
      "start": 7395.0,
      "end": 7397.0,
      "formatted_start": "02:03:15.000",
      "formatted_end": "02:03:17.000",
      "text": "اول اون روز رو ترسیدم اشتباه کنم."
    },
    {
      "id": 48,
      "start": 7397.0,
      "end": 7398.0,
      "formatted_start": "02:03:17.000",
      "formatted_end": "02:03:18.000",
      "text": "آره."
    },
    {
      "id": 49,
      "start": 7398.0,
      "end": 7399.0,
      "formatted_start": "02:03:18.000",
      "formatted_end": "02:03:19.000",
      "text": "در این لحظه صدا تو کنیم."
    },
    {
      "id": 50,
      "start": 7399.0,
      "end": 7400.0,
      "formatted_start": "02:03:19.000",
      "formatted_end": "02:03:20.000",
      "text": "اول بخورم."
    },
    {
      "id": 51,
      "start": 7400.0,
      "end": 7401.0,
      "formatted_start": "02:03:20.000",
      "formatted_end": "02:03:21.000",
      "text": "بفرام."
    },
    {
      "id": 52,
      "start": 7401.0,
      "end": 7402.0,
      "formatted_start": "02:03:21.000",
      "formatted_end": "02:03:22.000",
      "text": "بفرام."
    },
    {
      "id": 53,
      "start": 7402.0,
      "end": 7403.0,
      "formatted_start": "02:03:22.000",
      "formatted_end": "02:03:23.000",
      "text": "بفرام."
    },
    {
      "id": 54,
      "start": 7403.0,
      "end": 7404.0,
      "formatted_start": "02:03:23.000",
      "formatted_end": "02:03:24.000",
      "text": "بفرام."
    },
    {
      "id": 55,
      "start": 7404.0,
      "end": 7405.0,
      "formatted_start": "02:03:24.000",
      "formatted_end": "02:03:25.000",
      "text": "بفرام."
    },
    {
      "id": 56,
      "start": 7405.0,
      "end": 7406.0,
      "formatted_start": "02:03:25.000",
      "formatted_end": "02:03:26.000",
      "text": "بفرام."
    },
    {
      "id": 57,
      "start": 7406.0,
      "end": 7407.0,
      "formatted_start": "02:03:26.000",
      "formatted_end": "02:03:27.000",
      "text": "بفرام."
    },
    {
      "id": 58,
      "start": 7407.0,
      "end": 7408.0,
      "formatted_start": "02:03:27.000",
      "formatted_end": "02:03:28.000",
      "text": "بفرام."
    },
    {
      "id": 59,
      "start": 7408.0,
      "end": 7409.0,
      "formatted_start": "02:03:28.000",
      "formatted_end": "02:03:29.000",
      "text": "بفرام."
    },
    {
      "id": 60,
      "start": 7409.0,
      "end": 7410.0,
      "formatted_start": "02:03:29.000",
      "formatted_end": "02:03:30.000",
      "text": "بفرام."
    },
    {
      "id": 61,
      "start": 7410.0,
      "end": 7411.0,
      "formatted_start": "02:03:30.000",
      "formatted_end": "02:03:31.000",
      "text": "بفرام."
    },
    {
      "id": 62,
      "start": 7411.0,
      "end": 7412.0,
      "formatted_start": "02:03:31.000",
      "formatted_end": "02:03:32.000",
      "text": "بفرام."
    },
    {
      "id": 63,
      "start": 7412.0,
      "end": 7413.0,
      "formatted_start": "02:03:32.000",
      "formatted_end": "02:03:33.000",
      "text": "بفرام."
    },
    {
      "id": 64,
      "start": 7443.0,
      "end": 7445.68,
      "formatted_start": "02:04:03.000",
      "formatted_end": "02:04:05.680",
      "text": "برای که از بیرون جنگ باز کنی"
    },
    {
      "id": 65,
      "start": 7445.68,
      "end": 7447.12,
      "formatted_start": "02:04:05.680",
      "formatted_end": "02:04:07.120",
      "text": "اون موقع خیلی دردش بود"
    },
    {
      "id": 66,
      "start": 7447.12,
      "end": 7449.2,
      "formatted_start": "02:04:07.120",
      "formatted_end": "02:04:09.200",
      "text": "از دارو رو رسیدی کنه دردش کم تر شده"
    },
    {
      "id": 67,
      "start": 7449.2,
      "end": 7451.36,
      "formatted_start": "02:04:09.200",
      "formatted_end": "02:04:11.360",
      "text": "اینجور نکرده دردش بهتر شد"
    },
    {
      "id": 68,
      "start": 7451.36,
      "end": 7451.96,
      "formatted_start": "02:04:11.360",
      "formatted_end": "02:04:11.960",
      "text": "آره"
    },
    {
      "id": 69,
      "start": 7451.96,
      "end": 7452.52,
      "formatted_start": "02:04:11.960",
      "formatted_end": "02:04:12.520",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 7452.52,
      "end": 7454.56,
      "formatted_start": "02:04:12.520",
      "formatted_end": "02:04:14.560",
      "text": "نه شد میگید من دیدم بگیدم"
    },
    {
      "id": 71,
      "start": 7454.56,
      "end": 7456.92,
      "formatted_start": "02:04:14.560",
      "formatted_end": "02:04:16.920",
      "text": "من چی کارم چی هم بدم چی شده"
    },
    {
      "id": 72,
      "start": 7460.84,
      "end": 7461.56,
      "formatted_start": "02:04:20.840",
      "formatted_end": "02:04:21.560",
      "text": "نه نه"
    },
    {
      "id": 73,
      "start": 7461.56,
      "end": 7463.0,
      "formatted_start": "02:04:21.560",
      "formatted_end": "02:04:23.000",
      "text": "اونجور میشه نیست"
    },
    {
      "id": 74,
      "start": 7463.0,
      "end": 7465.12,
      "formatted_start": "02:04:23.000",
      "formatted_end": "02:04:25.120",
      "text": "از شوی میشیدید خیلی عذیب میشیدید"
    },
    {
      "id": 75,
      "start": 7465.12,
      "end": 7466.04,
      "formatted_start": "02:04:25.120",
      "formatted_end": "02:04:26.040",
      "text": "نه آره"
    },
    {
      "id": 76,
      "start": 7466.04,
      "end": 7467.88,
      "formatted_start": "02:04:26.040",
      "formatted_end": "02:04:27.880",
      "text": "حسانی نه با هنجوری درد میگید"
    },
    {
      "id": 77,
      "start": 7467.88,
      "end": 7469.88,
      "formatted_start": "02:04:27.880",
      "formatted_end": "02:04:29.880",
      "text": "خودتون بیده باید برده شوید"
    },
    {
      "id": 78,
      "start": 7469.88,
      "end": 7473.88,
      "formatted_start": "02:04:29.880",
      "formatted_end": "02:04:33.880",
      "text": "بله نه جز تو همونی درست کردم"
    },
    {
      "id": 79,
      "start": 7473.88,
      "end": 7475.88,
      "formatted_start": "02:04:33.880",
      "formatted_end": "02:04:35.880",
      "text": "متوجه این پیچاری"
    },
    {
      "id": 80,
      "start": 7475.88,
      "end": 7477.88,
      "formatted_start": "02:04:35.880",
      "formatted_end": "02:04:37.880",
      "text": "زانو دیدم اینو"
    },
    {
      "id": 81,
      "start": 7477.88,
      "end": 7479.88,
      "formatted_start": "02:04:37.880",
      "formatted_end": "02:04:39.880",
      "text": "این ساده متوجه میشدم"
    },
    {
      "id": 82,
      "start": 7479.88,
      "end": 7481.88,
      "formatted_start": "02:04:39.880",
      "formatted_end": "02:04:41.880",
      "text": "از این را درست کردم"
    },
    {
      "id": 83,
      "start": 7481.88,
      "end": 7483.88,
      "formatted_start": "02:04:41.880",
      "formatted_end": "02:04:43.880",
      "text": "من خیلی دیدم اینکه زانو"
    },
    {
      "id": 84,
      "start": 7483.88,
      "end": 7485.88,
      "formatted_start": "02:04:43.880",
      "formatted_end": "02:04:45.880",
      "text": "خب نگرانم"
    },
    {
      "id": 85,
      "start": 7485.88,
      "end": 7487.88,
      "formatted_start": "02:04:45.880",
      "formatted_end": "02:04:47.880",
      "text": "حالا شما شکلیش به ذهنتون اشتباهید"
    },
    {
      "id": 86,
      "start": 7487.88,
      "end": 7489.88,
      "formatted_start": "02:04:47.880",
      "formatted_end": "02:04:49.880",
      "text": "ولی که همون شکلی باعث میشه که"
    },
    {
      "id": 87,
      "start": 7489.88,
      "end": 7491.88,
      "formatted_start": "02:04:49.880",
      "formatted_end": "02:04:51.880",
      "text": "خوردگی زانو"
    },
    {
      "id": 88,
      "start": 7491.88,
      "end": 7495.88,
      "formatted_start": "02:04:51.880",
      "formatted_end": "02:04:55.880",
      "text": "به طرز شریفتابری خیلی زیاد بشه"
    },
    {
      "id": 89,
      "start": 7495.88,
      "end": 7499.32,
      "formatted_start": "02:04:55.880",
      "formatted_end": "02:04:59.320",
      "text": "اپتدایش میان سالی"
    }
  ],
  "status": "completed"
}