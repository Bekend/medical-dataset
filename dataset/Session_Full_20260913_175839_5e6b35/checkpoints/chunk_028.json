      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:30.000",
      "text": "اینجا که کلیت بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار ب"
    },
    {
      "id": 1,
      "start": 8430.0,
      "end": 8433.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:33.000",
      "text": "بگیرم چی دارین؟ نکردونو بگیریم."
    },
    {
      "id": 2,
      "start": 8435.0,
      "end": 8438.0,
      "formatted_start": "02:20:35.000",
      "formatted_end": "02:20:38.000",
      "text": "همیشه از قریصی پوستی عکس بگیریم."
    },
    {
      "id": 3,
      "start": 8447.0,
      "end": 8449.0,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:49.000",
      "text": "پایین هم داریم؟"
    },
    {
      "id": 4,
      "start": 8449.0,
      "end": 8451.0,
      "formatted_start": "02:20:49.000",
      "formatted_end": "02:20:51.000",
      "text": "اینجا باید تنقصی شوید"
    },
    {
      "id": 5,
      "start": 8458.7,
      "end": 8460.7,
      "formatted_start": "02:20:58.700",
      "formatted_end": "02:21:00.700",
      "text": "شوینده هم داده بودم"
    },
    {
      "id": 6,
      "start": 8460.7,
      "end": 8462.7,
      "formatted_start": "02:21:00.700",
      "formatted_end": "02:21:02.700",
      "text": "شوینده به نیمه"
    },
    {
      "id": 7,
      "start": 8465.0,
      "end": 8467.0,
      "formatted_start": "02:21:05.000",
      "formatted_end": "02:21:07.000",
      "text": "برگردشانو بدید که دارو بگیرسن"
    },
    {
      "id": 8,
      "start": 8467.0,
      "end": 8468.0,
      "formatted_start": "02:21:07.000",
      "formatted_end": "02:21:08.000",
      "text": "نا"
    },
    {
      "id": 9,
      "start": 8468.0,
      "end": 8470.0,
      "formatted_start": "02:21:08.000",
      "formatted_end": "02:21:10.000",
      "text": "واسه که الان دادن شوید"
    },
    {
      "id": 10,
      "start": 8470.0,
      "end": 8472.0,
      "formatted_start": "02:21:10.000",
      "formatted_end": "02:21:12.000",
      "text": "برگردشانو بدید که دارن شوید"
    },
    {
      "id": 11,
      "start": 8474.0,
      "end": 8477.0,
      "formatted_start": "02:21:14.000",
      "formatted_end": "02:21:17.000",
      "text": "من صرف بس به مادرم به چیو نداشتم"
    },
    {
      "id": 12,
      "start": 8477.0,
      "end": 8479.0,
      "formatted_start": "02:21:17.000",
      "formatted_end": "02:21:19.000",
      "text": "درگره همین بود"
    },
    {
      "id": 13,
      "start": 8479.0,
      "end": 8481.0,
      "formatted_start": "02:21:19.000",
      "formatted_end": "02:21:21.000",
      "text": "اینجا اینجا"
    },
    {
      "id": 14,
      "start": 8481.0,
      "end": 8483.0,
      "formatted_start": "02:21:21.000",
      "formatted_end": "02:21:23.000",
      "text": "درگره همین کشید"
    },
    {
      "id": 15,
      "start": 8483.0,
      "end": 8485.0,
      "formatted_start": "02:21:23.000",
      "formatted_end": "02:21:25.000",
      "text": "درگره این بود"
    },
    {
      "id": 16,
