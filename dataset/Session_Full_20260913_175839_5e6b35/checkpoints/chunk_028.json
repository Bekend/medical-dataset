      "formatted_start": "02:22:50.820",
      "formatted_end": "02:22:52.820",
      "text": "این رو باید بردارید"
    },
    {
      "id": 55,
      "start": 8574.82,
      "end": 8580.82,
      "formatted_start": "02:22:54.820",
      "formatted_end": "02:23:00.820",
      "text": "و چون اون فی مکلار نیست دیگه نه؟ نه، بسیار نیست."
    },
    {
      "id": 56,
      "start": 8580.82,
      "end": 8592.82,
      "formatted_start": "02:23:00.820",
      "formatted_end": "02:23:12.820",
      "text": "باشه نایدراحت و یادم خیلی تیره بود مشکل کردن، شانم خیلی بگیر زن، سیاه بود، اینجوری شده، اینجوری بود، اینجوری شده، خیلی بگیر زن شده، بله."
    },
    {
      "id": 57,
      "start": 8592.82,
      "end": 8596.02,
      "formatted_start": "02:23:12.820",
      "formatted_end": "02:23:16.020",
      "text": "برای این پاکستان میشه بیده درگونش خیلی راحت"
    },
    {
      "id": 58,
      "start": 8596.02,
      "end": 8598.02,
      "formatted_start": "02:23:16.020",
      "formatted_end": "02:23:18.020",
      "text": "چرا خواهیم؟"
    },
    {
      "id": 59,
      "start": 8598.02,
      "end": 8599.02,
      "formatted_start": "02:23:18.020",
      "formatted_end": "02:23:19.020",
      "text": "توی تر؟"
    },
    {
      "id": 60,
      "start": 8599.02,
      "end": 8603.02,
      "formatted_start": "02:23:19.020",
      "formatted_end": "02:23:23.020",
      "text": "دوتا قرص هم بره، روزی یکی از این قرص ها بخوره"
    },
    {
      "id": 61,
      "start": 8603.02,
      "end": 8604.02,
      "formatted_start": "02:23:23.020",
      "formatted_end": "02:23:24.020",
      "text": "یکی"
    },
    {
      "id": 62,
      "start": 8604.02,
      "end": 8608.02,
      "formatted_start": "02:23:24.020",
      "formatted_end": "02:23:28.020",
      "text": "منطقه یکیش یک روز در می آمیده، یکیش روزی یکیه"
    },
    {
      "id": 63,
      "start": 8608.02,
      "end": 8612.02,
      "formatted_start": "02:23:28.020",
      "formatted_end": "02:23:32.020",
      "text": "ببینیم، توضیحه"
    },
    {
      "id": 64,
      "start": 8612.02,
      "end": 8613.02,
      "formatted_start": "02:23:32.020",
      "formatted_end": "02:23:33.020",
      "text": "بیا"
    },
    {
      "id": 65,
      "start": 8613.02,
      "end": 8616.02,
      "formatted_start": "02:23:33.020",
      "formatted_end": "02:23:36.020",
      "text": "حالا اکس بگیرید، اصلا تو اکس دیده نمیشه بگیری"
    },
    {
      "id": 66,
      "start": 8616.02,
      "end": 8620.02,
      "formatted_start": "02:23:36.020",
      "formatted_end": "02:23:40.020",
      "text": "آره، اکس که خواستم بگیرم، تن تو اکس زیاد برشن خواست نمیشه"
    },
    {
      "id": 67,
      "start": 8620.02,
      "end": 8622.02,
      "formatted_start": "02:23:40.020",
      "formatted_end": "02:23:42.020",
      "text": "نمیشه قبلی اون شو پس میشه"
    },
    {
      "id": 68,
      "start": 8622.02,
      "end": 8624.02,
      "formatted_start": "02:23:42.020",
      "formatted_end": "02:23:44.020",
      "text": "بله"
    },
    {
      "id": 69,
      "start": 8624.02,
      "end": 8626.02,
      "formatted_start": "02:23:44.020",
      "formatted_end": "02:23:46.020",
      "text": "بسیار دوست دارو استفاده کردی"
    },
    {
      "id": 70,
      "start": 8626.02,
      "end": 8628.02,
      "formatted_start": "02:23:46.020",
      "formatted_end": "02:23:48.020",
      "text": "باز یه تهنانده شاید داشته باشه"
    },
