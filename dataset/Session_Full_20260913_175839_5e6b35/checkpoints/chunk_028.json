      "start": 8630.02,
      "end": 8632.02,
      "formatted_start": "02:23:50.020",
      "formatted_end": "02:23:52.020",
      "text": "بسه هم"
    },
    {
      "id": 73,
      "start": 8632.02,
      "end": 8634.02,
      "formatted_start": "02:23:52.020",
      "formatted_end": "02:23:54.020",
