  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11118.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:18.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 11118.0,
      "end": 11120.0,
      "formatted_start": "03:05:18.000",
      "formatted_end": "03:05:20.000",
      "text": "5 میری بهتر بیشتر هست"
    },
    {
      "id": 2,
      "start": 11120.0,
      "end": 11122.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:22.000",
      "text": "این جایی بسیار در جایی"
    },
    {
      "id": 3,
      "start": 11122.0,
      "end": 11126.0,
      "formatted_start": "03:05:22.000",
      "formatted_end": "03:05:26.000",
      "text": "زمین هم خورده بودی قبلن درسته؟"
    },
    {
      "id": 4,
      "start": 11126.0,
      "end": 11128.0,
      "formatted_start": "03:05:26.000",
      "formatted_end": "03:05:28.000",
      "text": "یا من نیستم زمین خورده بودی"
    },
    {
      "id": 5,
      "start": 11128.0,
      "end": 11130.0,
      "formatted_start": "03:05:28.000",
      "formatted_end": "03:05:30.000",
      "text": "با این زیانو زمین نخورده بودی"
    },
    {
      "id": 6,
      "start": 11130.0,
      "end": 11132.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:32.000",
      "text": "چون همه هم رفته بود کجایی بود؟"
    },
    {
      "id": 7,
      "start": 11132.0,
      "end": 11135.0,
      "formatted_start": "03:05:32.000",
      "formatted_end": "03:05:35.000",
      "text": "از توی بچه گفت خیلی بادو شرط زمین خورده بود"
    },
    {
      "id": 8,
      "start": 11135.0,
      "end": 11136.0,
      "formatted_start": "03:05:35.000",
      "formatted_end": "03:05:36.000",
      "text": "همه دو شرط بود"
    },
    {
      "id": 9,
      "start": 11136.0,
      "end": 11138.0,
      "formatted_start": "03:05:36.000",
      "formatted_end": "03:05:38.000",
      "text": "خواهدم مثلا اون کمپ هم از سر بشه"
    },
    {
      "id": 10,
      "start": 11138.0,
      "end": 11139.0,
      "formatted_start": "03:05:38.000",
      "formatted_end": "03:05:39.000",
      "text": "بله"
    },
    {
      "id": 11,
      "start": 11139.0,
      "end": 11142.0,
      "formatted_start": "03:05:39.000",
      "formatted_end": "03:05:42.000",
      "text": "اما همه هم رفته نشونه زمین خورده داره"
    },
    {
      "id": 12,
      "start": 11142.0,
      "end": 11144.0,
      "formatted_start": "03:05:42.000",
      "formatted_end": "03:05:44.000",
      "text": "همه چیزی در اینجا باشه؟"
    },
    {
      "id": 13,
      "start": 11144.0,
      "end": 11146.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:46.000",
      "text": "آمده شوید"
    },
    {
      "id": 14,
      "start": 11146.0,
      "end": 11148.0,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:48.000",
      "text": "باید با همه چیزی باید باز می کنیم"
    },
    {
      "id": 15,
      "start": 11148.0,
      "end": 11150.0,
      "formatted_start": "03:05:48.000",
      "formatted_end": "03:05:50.000",
      "text": "باز می کنیم"
    },
    {
      "id": 16,
      "start": 11152.0,
      "end": 11154.0,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:05:54.000",
      "text": "باز می کنیم"
    },
    {
      "id": 17,
      "start": 11158.0,
      "end": 11160.0,
      "formatted_start": "03:05:58.000",
      "formatted_end": "03:06:00.000",
      "text": "دوتا باید باید ببینیم"
    },
    {
      "id": 18,
      "start": 11160.0,
      "end": 11162.0,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:02.000",
      "text": "هر روز باز می کنیم"
    },
    {
      "id": 19,
      "start": 11162.0,
      "end": 11164.0,
      "formatted_start": "03:06:02.000",
      "formatted_end": "03:06:04.000",
      "text": "با آمده آف بشونیم"
    },
    {
      "id": 20,
      "start": 11164.0,
      "end": 11166.0,
      "formatted_start": "03:06:04.000",
      "formatted_end": "03:06:06.000",
      "text": "یک ورزشی باید بهتون یاد بدم"
    },
    {
      "id": 21,
      "start": 11166.0,
      "end": 11168.0,
      "formatted_start": "03:06:06.000",
      "formatted_end": "03:06:08.000",
      "text": "هر روز انجام بدیم"
    },
    {
      "id": 22,
      "start": 11168.0,
      "end": 11170.0,
      "formatted_start": "03:06:08.000",
      "formatted_end": "03:06:10.000",
      "text": "روز یک باز ببان؟"
    },
    {
      "id": 23,
      "start": 11170.0,
      "end": 11182.0,
      "formatted_start": "03:06:10.000",
      "formatted_end": "03:06:22.000",
      "text": "روز یک بار باید داشته باز باسونیم با آب دابشونیم و خوش کنیم پومات رو بزنیم زیادت بزنیم پومات رو"
    },
    {
      "id": 24,
      "start": 11182.0,
      "end": 11184.0,
      "formatted_start": "03:06:22.000",
      "formatted_end": "03:06:24.000",
      "text": "و میپندیم"
    },
    {
      "id": 25,
      "start": 11186.0,
      "end": 11188.0,
      "formatted_start": "03:06:26.000",
      "formatted_end": "03:06:28.000",
      "text": "تو چند وقت؟"
    },
    {
      "id": 26,
      "start": 11188.0,
      "end": 11190.0,
      "formatted_start": "03:06:28.000",
      "formatted_end": "03:06:30.000",
      "text": "بره روز یک هفته در روز"
    },
    {
      "id": 27,
      "start": 11190.0,
      "end": 11194.0,
      "formatted_start": "03:06:30.000",
      "formatted_end": "03:06:34.000",
      "text": "روز یک بار برنجم بود"
    },
    {
      "id": 28,
      "start": 11194.0,
      "end": 11200.0,
      "formatted_start": "03:06:34.000",
      "formatted_end": "03:06:40.000",
      "text": "اصلا امروز الان که اینو صاف کردم"
    },
    {
      "id": 29,
      "start": 11200.0,
      "end": 11204.0,
      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:44.000",
      "text": "جاش خار و خار بوده یکی چیزی برام آوردم"
    },
    {
      "id": 30,
      "start": 11204.0,
      "end": 11206.0,
      "formatted_start": "03:06:44.000",
      "formatted_end": "03:06:46.000",
      "text": "توی میرناختم و الان بازو وزیفی کنیم"
    },
    {
      "id": 31,
      "start": 11206.0,
      "end": 11208.0,
      "formatted_start": "03:06:46.000",
      "formatted_end": "03:06:48.000",
      "text": "متوجه میشیم که همین الان که"
    },
    {
      "id": 32,
      "start": 11208.0,
      "end": 11210.0,
      "formatted_start": "03:06:48.000",
      "formatted_end": "03:06:50.000",
      "text": "تو بانده شان هر رفت رو باید عوض باشید؟"
    },
    {
      "id": 33,
      "start": 11210.0,
      "end": 11211.0,
      "formatted_start": "03:06:50.000",
      "formatted_end": "03:06:51.000",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 11211.0,
      "end": 11213.0,
      "formatted_start": "03:06:51.000",
      "formatted_end": "03:06:53.000",
      "text": "نیاز نمیدونه؟"
    },
    {
      "id": 35,
      "start": 11213.0,
      "end": 11216.0,
      "formatted_start": "03:06:53.000",
      "formatted_end": "03:06:56.000",
      "text": "بانده از امن خرابه"
    },
    {
      "id": 36,
      "start": 11216.0,
      "end": 11218.0,
      "formatted_start": "03:06:56.000",
      "formatted_end": "03:06:58.000",
      "text": "قبلا بانده ها کشی گرده"
    },
    {
      "id": 37,
      "start": 11218.0,
      "end": 11220.0,
      "formatted_start": "03:06:58.000",
      "formatted_end": "03:07:00.000",
      "text": "یه هزار و شاید نیست"
    },
    {
      "id": 38,
      "start": 11220.0,
      "end": 11223.0,
      "formatted_start": "03:07:00.000",
      "formatted_end": "03:07:03.000",
      "text": "ولی ظانو همین خرابش هم برود"
    },
    {
      "id": 39,
      "start": 11223.0,
      "end": 11227.0,
      "formatted_start": "03:07:03.000",
      "formatted_end": "03:07:07.000",
      "text": "ولی محچ دستی را بخوایید باید بانده گرون میشه"
    },
    {
      "id": 40,
      "start": 11227.0,
      "end": 11229.0,
      "formatted_start": "03:07:07.000",
      "formatted_end": "03:07:09.000",
      "text": "من را به ارزون نمیدونم"
    },
    {
      "id": 41,
      "start": 11229.0,
      "end": 11231.0,
      "formatted_start": "03:07:09.000",
      "formatted_end": "03:07:11.000",
      "text": "خیلی بلازم را بزرگ بکنم خب"
    },
    {
      "id": 42,
      "start": 11231.0,
      "end": 11233.0,
      "formatted_start": "03:07:11.000",
      "formatted_end": "03:07:13.000",
      "text": "باید شما خیلی متوجه بشین"
    },
    {
      "id": 43,
      "start": 11233.0,
      "end": 11235.0,
      "formatted_start": "03:07:13.000",
      "formatted_end": "03:07:15.000",
      "text": "یه چرا هست؟"
    },
    {
      "id": 44,
      "start": 11235.0,
      "end": 11237.0,
      "formatted_start": "03:07:15.000",
      "formatted_end": "03:07:17.000",
      "text": "همینکه باید"
    },
    {
      "id": 45,
      "start": 11237.0,
      "end": 11239.0,
      "formatted_start": "03:07:17.000",
      "formatted_end": "03:07:19.000",
      "text": "رضیعت مالی من را اومدی"
    },
    {
      "id": 46,
      "start": 11239.0,
      "end": 11241.0,
      "formatted_start": "03:07:19.000",
      "formatted_end": "03:07:21.000",
      "text": "خیلی لطف کردم"
    },
    {
      "id": 47,
      "start": 11241.0,
      "end": 11243.0,
      "formatted_start": "03:07:21.000",
      "formatted_end": "03:07:23.000",
      "text": "خدا ترسو برم"
    },
    {
      "id": 48,
      "start": 11243.0,
      "end": 11245.0,
      "formatted_start": "03:07:23.000",
      "formatted_end": "03:07:25.000",
      "text": "کم هستم"
    },
    {
      "id": 49,
      "start": 11245.0,
      "end": 11247.0,
      "formatted_start": "03:07:25.000",
      "formatted_end": "03:07:27.000",
      "text": "فرستش"
    },
    {
      "id": 50,
      "start": 11247.0,
      "end": 11249.0,
      "formatted_start": "03:07:27.000",
      "formatted_end": "03:07:29.000",
      "text": "شما نتیجه که ببینید خب"
    },
    {
      "id": 51,
      "start": 11249.0,
      "end": 11251.0,
      "formatted_start": "03:07:29.000",
      "formatted_end": "03:07:31.000",
      "text": "خدا بزن خب"
    },
    {
      "id": 52,
      "start": 11251.0,
      "end": 11253.0,
      "formatted_start": "03:07:31.000",
      "formatted_end": "03:07:33.000",
      "text": "خدا به صفت باشه"
    },
    {
      "id": 53,
      "start": 11255.0,
      "end": 11257.0,
      "formatted_start": "03:07:35.000",
      "formatted_end": "03:07:37.000",
      "text": "باید بسیار درست کنیم"
    },
    {
      "id": 54,
      "start": 11261.0,
      "end": 11263.0,
      "formatted_start": "03:07:41.000",
      "formatted_end": "03:07:43.000",
      "text": "راحت راحت بگیریم"
    },
    {
      "id": 55,
      "start": 11263.0,
      "end": 11265.0,
      "formatted_start": "03:07:43.000",
      "formatted_end": "03:07:45.000",
      "text": "این هست از نوعی خاصی دست میده"
    },
    {
      "id": 56,
      "start": 11265.0,
      "end": 11267.0,
      "formatted_start": "03:07:45.000",
      "formatted_end": "03:07:47.000",
      "text": "این هست از سوکی"
    },
    {
      "id": 57,
      "start": 11267.0,
      "end": 11269.0,
      "formatted_start": "03:07:47.000",
      "formatted_end": "03:07:49.000",
      "text": "اونجایی داره"
    },
    {
      "id": 58,
      "start": 11269.0,
      "end": 11271.0,
      "formatted_start": "03:07:49.000",
      "formatted_end": "03:07:51.000",
      "text": "اونجایی برد میده اینجایی خوبه"
    },
    {
      "id": 59,
      "start": 11271.0,
      "end": 11273.0,
      "formatted_start": "03:07:51.000",
      "formatted_end": "03:07:53.000",
      "text": "نه با ترس خوبه"
    },
    {
      "id": 60,
      "start": 11273.0,
      "end": 11275.0,
      "formatted_start": "03:07:53.000",
      "formatted_end": "03:07:55.000",
      "text": "الان بیرون دلیل احساستون بهتر شده"
    },
    {
      "id": 61,
      "start": 11275.0,
      "end": 11277.0,
      "formatted_start": "03:07:55.000",
      "formatted_end": "03:07:57.000",
      "text": "با سننه کشن"
    },
    {
      "id": 62,
      "start": 11277.0,
      "end": 11279.0,
      "formatted_start": "03:07:57.000",
      "formatted_end": "03:07:59.000",
      "text": "خوبه"
    },
    {
      "id": 63,
      "start": 11279.0,
      "end": 11283.0,
      "formatted_start": "03:07:59.000",
      "formatted_end": "03:08:03.000",
      "text": "این برقص ها برده"
    },
    {
      "id": 64,
      "start": 11283.0,
      "end": 11287.0,
      "formatted_start": "03:08:03.000",
      "formatted_end": "03:08:07.000",
      "text": "این برقص ها برده"
    },
    {
      "id": 65,
      "start": 11287.0,
      "end": 11291.0,
      "formatted_start": "03:08:07.000",
      "formatted_end": "03:08:11.000",
      "text": "این برقص ها برده"
    },
    {
      "id": 66,
      "start": 11291.0,
      "end": 11295.0,
      "formatted_start": "03:08:11.000",
      "formatted_end": "03:08:15.000",
      "text": "این کلسی ها می‌کنه"
    },
    {
      "id": 67,
      "start": 11295.0,
      "end": 11297.0,
      "formatted_start": "03:08:15.000",
      "formatted_end": "03:08:17.000",
      "text": "تو اینکه یک دلیل در اینجایی که"
    },
    {
      "id": 68,
      "start": 11297.0,
      "end": 11299.0,
      "formatted_start": "03:08:17.000",
      "formatted_end": "03:08:19.000",
      "text": "بسیار قدیتت کنی"
    },
    {
      "id": 69,
      "start": 11299.0,
      "end": 11301.0,
      "formatted_start": "03:08:19.000",
      "formatted_end": "03:08:21.000",
      "text": "یا خودمانت بودی"
    },
    {
      "id": 70,
      "start": 11301.0,
      "end": 11303.0,
      "formatted_start": "03:08:21.000",
      "formatted_end": "03:08:23.000",
      "text": "تو اینکه برده بودی"
    },
    {
      "id": 71,
      "start": 11303.0,
      "end": 11305.0,
      "formatted_start": "03:08:23.000",
      "formatted_end": "03:08:25.000",
      "text": "تو اینکه برده بودی"
    },
    {
      "id": 72,
      "start": 11305.0,
      "end": 11307.0,
      "formatted_start": "03:08:25.000",
      "formatted_end": "03:08:27.000",
      "text": "تو اینکه برده بودی"
    },
    {
      "id": 73,
      "start": 11307.0,
      "end": 11319.0,
      "formatted_start": "03:08:27.000",
      "formatted_end": "03:08:39.000",
      "text": "این روش روی اینجوریه چندان سال با قوس عیدیه."
    },
    {
      "id": 74,
      "start": 11319.0,
      "end": 11322.0,
      "formatted_start": "03:08:39.000",
      "formatted_end": "03:08:42.000",
      "text": "میگن برای اینکه برای پنجه سالی بشه."
    },
    {
      "id": 75,
      "start": 11322.0,
      "end": 11323.0,
      "formatted_start": "03:08:42.000",
      "formatted_end": "03:08:43.000",
      "text": "بله."
    },
    {
      "id": 76,
      "start": 11323.0,
      "end": 11324.0,
      "formatted_start": "03:08:43.000",
      "formatted_end": "03:08:44.000",
      "text": "بله؟"
    },
    {
      "id": 77,
      "start": 11324.0,
      "end": 11325.0,
      "formatted_start": "03:08:44.000",
      "formatted_end": "03:08:45.000",
      "text": "بله."
    },
    {
      "id": 78,
      "start": 11325.0,
      "end": 11326.0,
      "formatted_start": "03:08:45.000",
      "formatted_end": "03:08:46.000",
      "text": "خب، پنجه سالی که اینجوریه؟"
    },
    {
      "id": 79,
      "start": 11326.0,
      "end": 11328.0,
      "formatted_start": "03:08:46.000",
      "formatted_end": "03:08:48.000",
      "text": "استفاده رو باید میده کنیم."
    },
    {
      "id": 80,
      "start": 11328.0,
      "end": 11333.0,
      "formatted_start": "03:08:48.000",
      "formatted_end": "03:08:53.000",
      "text": "یک نفر از اینکه اگر از اینجوریه شاید به یک ضرری بهتر زنگیره."
    },
    {
      "id": 81,
      "start": 11333.0,
      "end": 11341.0,
      "formatted_start": "03:08:53.000",
      "formatted_end": "03:09:01.000",
      "text": "این روش هست که روش بهتر کاندوم هست که همسرتون همکاری بکنه و مدتی کاندوم استفاده بکنه"
    },
    {
      "id": 82,
      "start": 11341.0,
      "end": 11343.0,
      "formatted_start": "03:09:01.000",
      "formatted_end": "03:09:03.000",
      "text": "چند تا بچه بودیم؟ دوتا"
    },
    {
      "id": 83,
      "start": 11343.0,
      "end": 11349.0,
      "formatted_start": "03:09:03.000",
      "formatted_end": "03:09:09.000",
      "text": "ببینید به جز این روش های آمپون و این هم هم همون مرزه هستن یعنی هرمون هستن"
    },
    {
      "id": 84,
      "start": 11349.0,
      "end": 11355.0,
      "formatted_start": "03:09:09.000",
      "formatted_end": "03:09:15.000",
      "text": "هم اصلاح تو خراب میکنن و اخلاق تو بد میکنن ولی کاندوم بهترین وسیله هست که استفاده بکنه"
    },
    {
      "id": 85,
      "start": 11355.0,
      "end": 11364.0,
      "formatted_start": "03:09:15.000",
      "formatted_end": "03:09:24.000",
      "text": "اگر همسرتون همکاری رو کنه برای کاندوم، پس همتون راحت میشه. این بد اخلاقی هایی که با شوهرتون می کنید، بخواهد برس جایی توی اینکه بسیاری کنید."
    },
    {
      "id": 86,
      "start": 11364.0,
      "end": 11368.0,
      "formatted_start": "03:09:24.000",
      "formatted_end": "03:09:28.000",
      "text": "من دو تا بچه شیر و شیر آبوندم، بعد دیگه ترسیدم، دیگه سپاهیم."
    },
    {
      "id": 87,
      "start": 11368.0,
      "end": 11376.0,
      "formatted_start": "03:09:28.000",
      "formatted_end": "03:09:36.000",
      "text": "بگو با شوهرت صحبت بخواهد، بگو که این برس هایی که می خورم من رو بد اخلاق کرده، خودت بگو من رو بد اخلاق کرده."
    },
    {
      "id": 88,
      "start": 11376.0,
      "end": 11381.5,
      "formatted_start": "03:09:36.000",
      "formatted_end": "03:09:41.500",
      "text": "شاید هم متوجه و دهنابی تو الان هستید، پا بی حسله ای حسله ندارید"
    },
    {
      "id": 89,
      "start": 11381.5,
      "end": 11387.5,
      "formatted_start": "03:09:41.500",
      "formatted_end": "03:09:47.500",
      "text": "اگه این پرس رو نخورم روحی هم بهتر میشه، تا از زندگی بیشتر خیلی میبینیم"
    },
    {
      "id": 90,
      "start": 11387.5,
      "end": 11392.5,
      "formatted_start": "03:09:47.500",
      "formatted_end": "03:09:52.500",
      "text": "برای کبد من هم الان بیش از پنج سال هم میگم پرس نخوریم، پا"
    },
    {
      "id": 91,
      "start": 11392.5,
      "end": 11394.5,
      "formatted_start": "03:09:52.500",
      "formatted_end": "03:09:54.500",
      "text": "یک سال هم اضافه خوردم، پا"
    },
    {
      "id": 92,
      "start": 11394.5,
      "end": 11400.0,
      "formatted_start": "03:09:54.500",
      "formatted_end": "03:10:00.000",
      "text": "اگه بخوام باید دارم پرس بخورم، هدف اقل یکی دو سال باید فاصله بگذارم، بعدم بچه هم"
    }
  ],
  "status": "completed"
}