  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6303.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:03.000",
      "text": "سپه هوا، سپه هوا خودمون."
    },
    {
      "id": 1,
      "start": 6303.0,
      "end": 6305.0,
      "formatted_start": "01:45:03.000",
      "formatted_end": "01:45:05.000",
      "text": "این همون نزدیک سبلان بوده."
    },
    {
      "id": 2,
      "start": 6305.0,
      "end": 6310.0,
      "formatted_start": "01:45:05.000",
      "formatted_end": "01:45:10.000",
      "text": "این سبلان بشه، راهون بگن و بگن که شما براشون کادو بگیری."
    },
    {
      "id": 3,
      "start": 6310.0,
      "end": 6318.0,
      "formatted_start": "01:45:10.000",
      "formatted_end": "01:45:18.000",
      "text": "نه، دیروز پیام دادن که همسایی ما داریم جا به جا میشیم از اینجا، این حدف ما رو تعمل کنیم."
    },
    {
      "id": 4,
      "start": 6318.0,
      "end": 6322.0,
      "formatted_start": "01:45:18.000",
      "formatted_end": "01:45:22.000",
      "text": "یه هفته دمته، باید یه دور میدونن."
    },
    {
      "id": 5,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "دو، چهار، داره."
    },
    {
      "id": 6,
      "start": 6324.0,
      "end": 6331.76,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:31.760",
      "text": "نره، ببین این چیزه قلادی پارس یه چیزی شکل الکتریکی میده، تا پارس می کنه شکل میده بهش"
    },
    {
      "id": 7,
      "start": 6331.76,
      "end": 6336.4,
      "formatted_start": "01:45:31.760",
      "formatted_end": "01:45:36.400",
      "text": "بعد ساگه ظرفه یکی دو هفته یاد میگه دیگه پارسی می کنه، سایرنت میشه"
    },
    {
      "id": 8,
      "start": 6336.4,
      "end": 6337.24,
      "formatted_start": "01:45:36.400",
      "formatted_end": "01:45:37.240",
      "text": "چیزی بود؟"
    },
    {
      "id": 9,
      "start": 6337.24,
      "end": 6343.64,
      "formatted_start": "01:45:37.240",
      "formatted_end": "01:45:43.640",
      "text": "آره، اینو دانپیزشکی بهت سوال کنی، میدن میده کشن، خب پاوسی هم داره، آرامون هم داره چند فرق"
    },
    {
      "id": 10,
      "start": 6343.64,
      "end": 6350.64,
      "formatted_start": "01:45:43.640",
      "formatted_end": "01:45:50.640",
      "text": "خب این هست دانپیزشکی خلاص شده پارس خب تعمالش سخته بله راه رفتن تقویتو باید بگذیری"
    },
    {
      "id": 11,
      "start": 6350.64,
      "end": 6352.64,
      "formatted_start": "01:45:50.640",
      "formatted_end": "01:45:52.640",
      "text": "این دیگه ساخته با منه نیست"
    },
    {
      "id": 12,
      "start": 6352.64,
      "end": 6353.64,
      "formatted_start": "01:45:52.640",
      "formatted_end": "01:45:53.640",
      "text": "یا سخت دیگه با چون که نه؟"
    },
    {
      "id": 13,
      "start": 6353.64,
      "end": 6356.64,
      "formatted_start": "01:45:53.640",
      "formatted_end": "01:45:56.640",
      "text": "سخت پارس و سخت و نه نه میگم اونو بلدد و اونو چاره داره"
    },
    {
      "id": 14,
      "start": 6356.64,
      "end": 6358.64,
      "formatted_start": "01:45:56.640",
      "formatted_end": "01:45:58.640",
      "text": "از اینو پردی روخ نیاز برم؟"
    },
    {
      "id": 15,
      "start": 6358.64,
      "end": 6359.64,
      "formatted_start": "01:45:58.640",
      "formatted_end": "01:45:59.640",
      "text": "که حق دارم؟"
    },
    {
      "id": 16,
      "start": 6359.64,
      "end": 6360.64,
      "formatted_start": "01:45:59.640",
      "formatted_end": "01:46:00.640",
      "text": "نه حق داری"
    },
    {
      "id": 17,
      "start": 6360.64,
      "end": 6361.64,
      "formatted_start": "01:46:00.640",
      "formatted_end": "01:46:01.640",
      "text": "حالا میلی همه"
    },
    {
      "id": 18,
      "start": 6361.64,
      "end": 6366.64,
      "formatted_start": "01:46:01.640",
      "formatted_end": "01:46:06.640",
      "text": "از اینکه کلن حق داری اما اونجا شده خودت آسیب میزنه"
    },
    {
      "id": 19,
      "start": 6366.64,
      "end": 6369.22,
      "formatted_start": "01:46:06.640",
      "formatted_end": "01:46:09.220",
      "text": "اما زرنگیه که بتونی حلش کنی"
    },
    {
      "id": 20,
      "start": 6369.22,
      "end": 6370.22,
      "formatted_start": "01:46:09.220",
      "formatted_end": "01:46:10.220",
      "text": "تا چی؟"
    },
    {
      "id": 21,
      "start": 6370.22,
      "end": 6372.84,
      "formatted_start": "01:46:10.220",
      "formatted_end": "01:46:12.840",
      "text": "ما برای نجات خودت داریم میگیم"
    },
    {
      "id": 22,
      "start": 6372.84,
      "end": 6375.38,
      "formatted_start": "01:46:12.840",
      "formatted_end": "01:46:15.380",
      "text": "وقتی ما مردم رو میتونیم زنجی کنیم"
    },
    {
      "id": 23,
      "start": 6375.38,
      "end": 6377.46,
      "formatted_start": "01:46:15.380",
      "formatted_end": "01:46:17.460",
      "text": "راه نرنگ میدونیم، راه نکنن که"
    },
    {
      "id": 24,
      "start": 6377.46,
      "end": 6380.7,
      "formatted_start": "01:46:17.460",
      "formatted_end": "01:46:20.700",
      "text": "درست؟ این مقدار آسیدی که خودت میبینیم"
    },
    {
      "id": 25,
      "start": 6380.7,
      "end": 6382.52,
      "formatted_start": "01:46:20.700",
      "formatted_end": "01:46:22.520",
      "text": "حدف درمان شده"
    },
    {
      "id": 26,
      "start": 6382.52,
      "end": 6383.74,
      "formatted_start": "01:46:22.520",
      "formatted_end": "01:46:23.740",
      "text": "همون شماست، پداوره دیگه"
    },
    {
      "id": 27,
      "start": 6383.74,
      "end": 6385.24,
      "formatted_start": "01:46:23.740",
      "formatted_end": "01:46:25.240",
      "text": "آره، رفتی خوان شوهرتو میگی"
    },
    {
      "id": 28,
      "start": 6385.24,
      "end": 6386.96,
      "formatted_start": "01:46:25.240",
      "formatted_end": "01:46:26.960",
      "text": "چایی بریز برات نریخته؟"
    },
    {
      "id": 29,
      "start": 6386.96,
      "end": 6388.16,
      "formatted_start": "01:46:26.960",
      "formatted_end": "01:46:28.160",
      "text": "نبود ناربیش"
    },
    {
      "id": 30,
      "start": 6388.16,
      "end": 6390.16,
      "formatted_start": "01:46:28.160",
      "formatted_end": "01:46:30.160",
      "text": "تو بریز نرمشم در برد"
    },
    {
      "id": 31,
      "start": 6390.16,
      "end": 6392.82,
      "formatted_start": "01:46:30.160",
      "formatted_end": "01:46:32.820",
      "text": "خرشه هست گفت برو خود بگیر، رایش من بگیر"
    },
    {
      "id": 32,
      "start": 6392.82,
      "end": 6394.76,
      "formatted_start": "01:46:32.820",
      "formatted_end": "01:46:34.760",
      "text": "آره، زن ها اینجوری هستن"
    },
    {
      "id": 33,
      "start": 6394.76,
      "end": 6396.76,
      "formatted_start": "01:46:34.760",
      "formatted_end": "01:46:36.760",
      "text": "الان من به این میگم چای اومده بگیر"
    },
    {
      "id": 34,
      "start": 6396.76,
      "end": 6399.06,
      "formatted_start": "01:46:36.760",
      "formatted_end": "01:46:39.060",
      "text": "گفتم آقا دوتا این نیست"
    },
    {
      "id": 35,
      "start": 6399.06,
      "end": 6401.86,
      "formatted_start": "01:46:39.060",
      "formatted_end": "01:46:41.860",
      "text": "من میدونم دوتا زن هم دیگر تعمل نمی کنن"
    },
    {
      "id": 36,
      "start": 6401.86,
      "end": 6404.06,
      "formatted_start": "01:46:41.860",
      "formatted_end": "01:46:44.060",
      "text": "آه، اینجوری هستن"
    },
    {
      "id": 37,
      "start": 6404.06,
      "end": 6406.56,
      "formatted_start": "01:46:44.060",
      "formatted_end": "01:46:46.560",
      "text": "دوتا ما شاید بودیم، دوتاشون هم دیگر بودن"
    },
    {
      "id": 38,
      "start": 6406.56,
      "end": 6409.06,
      "formatted_start": "01:46:46.560",
      "formatted_end": "01:46:49.060",
      "text": "این میگه من اون دفعه چای افتادم، اون دفعه اومده بودن"
    },
    {
      "id": 39,
      "start": 6409.06,
      "end": 6410.06,
      "formatted_start": "01:46:49.060",
      "formatted_end": "01:46:50.060",
      "text": "کار دارن نیست"
    },
    {
      "id": 40,
      "start": 6410.06,
      "end": 6413.72,
      "formatted_start": "01:46:50.060",
      "formatted_end": "01:46:53.720",
      "text": "الان گفتم هر دوتا اتیم یک چای میگن، هر دوتا با هم بین چای بزنیم."
    },
    {
      "id": 41,
      "start": 6413.72,
      "end": 6414.22,
      "formatted_start": "01:46:53.720",
      "formatted_end": "01:46:54.220",
      "text": "آره دوریم."
    },
    {
      "id": 42,
      "start": 6414.22,
      "end": 6415.52,
      "formatted_start": "01:46:54.220",
      "formatted_end": "01:46:55.520",
      "text": "با هم بین دوریم با هم بزنیم."
    },
    {
      "id": 43,
      "start": 6415.52,
      "end": 6416.02,
      "formatted_start": "01:46:55.520",
      "formatted_end": "01:46:56.020",
      "text": "ایچون."
    },
    {
      "id": 44,
      "start": 6416.72,
      "end": 6418.16,
      "formatted_start": "01:46:56.720",
      "formatted_end": "01:46:58.160",
      "text": "زن با زن راه نداریم."
    },
    {
      "id": 45,
      "start": 6418.16,
      "end": 6418.66,
      "formatted_start": "01:46:58.160",
      "formatted_end": "01:46:58.660",
      "text": "نه."
    },
    {
      "id": 46,
      "start": 6418.66,
      "end": 6423.36,
      "formatted_start": "01:46:58.660",
      "formatted_end": "01:47:03.360",
      "text": "اصلا ما توقع این تیم دوتا زن با هم رفتار رو خوب داشته باشن نداریم."
    },
    {
      "id": 47,
      "start": 6423.36,
      "end": 6425.46,
      "formatted_start": "01:47:03.360",
      "formatted_end": "01:47:05.460",
      "text": "الان ما بیاییم اصابه اونو خورد بکنیم، نه."
    },
    {
      "id": 48,
      "start": 6425.46,
      "end": 6427.36,
      "formatted_start": "01:47:05.460",
      "formatted_end": "01:47:07.360",
      "text": "قد این دو زنها میموردن، خواه."
    },
    {
      "id": 49,
      "start": 6429.76,
      "end": 6431.96,
      "formatted_start": "01:47:09.760",
      "formatted_end": "01:47:11.960",
      "text": "چون زودتا هرس میخوردن بین دو زن نیست."
    },
    {
      "id": 50,
      "start": 6440.06,
      "end": 6447.06,
      "formatted_start": "01:47:20.060",
      "formatted_end": "01:47:27.060",
      "text": "این عمل هر شدنی نیست. خدا گذاشته این رو به دوتا نشن دیگه."
    },
    {
      "id": 51,
      "start": 6447.06,
      "end": 6449.06,
      "formatted_start": "01:47:27.060",
      "formatted_end": "01:47:29.060",
      "text": "و هر شدنی نیست."
    },
    {
      "id": 52,
      "start": 6449.06,
      "end": 6454.06,
      "formatted_start": "01:47:29.060",
      "formatted_end": "01:47:34.060",
      "text": "باید سیپ از این روخت. خب حالا دالاکتوره رو باید درما میکنم."
    },
    {
      "id": 53,
      "start": 6454.06,
      "end": 6456.06,
      "formatted_start": "01:47:34.060",
      "formatted_end": "01:47:36.060",
      "text": "پرس هفته ای دادن به شما یا نه؟"
    },
    {
      "id": 54,
      "start": 6456.06,
      "end": 6457.06,
      "formatted_start": "01:47:36.060",
      "formatted_end": "01:47:37.060",
      "text": "پرسو که بود؟"
    },
    {
      "id": 55,
      "start": 6457.06,
      "end": 6458.06,
      "formatted_start": "01:47:37.060",
      "formatted_end": "01:47:38.060",
      "text": "هفته ای."
    },
    {
      "id": 56,
      "start": 6458.06,
      "end": 6459.06,
      "formatted_start": "01:47:38.060",
      "formatted_end": "01:47:39.060",
      "text": "هفته ای چی؟"
    },
    {
      "id": 57,
      "start": 6459.06,
      "end": 6461.06,
      "formatted_start": "01:47:39.060",
      "formatted_end": "01:47:41.060",
      "text": "که هر هفته یکمونو بخورین."
    },
    {
      "id": 58,
      "start": 6461.06,
      "end": 6462.06,
      "formatted_start": "01:47:41.060",
      "formatted_end": "01:47:42.060",
      "text": "نه بود."
    },
    {
      "id": 59,
      "start": 6462.06,
      "end": 6463.06,
      "formatted_start": "01:47:42.060",
      "formatted_end": "01:47:43.060",
      "text": "پرسو رو بودن؟"
    },
    {
      "id": 60,
      "start": 6463.06,
      "end": 6464.06,
      "formatted_start": "01:47:43.060",
      "formatted_end": "01:47:44.060",
      "text": "نه بودن."
    },
    {
      "id": 61,
      "start": 6464.06,
      "end": 6465.06,
      "formatted_start": "01:47:44.060",
      "formatted_end": "01:47:45.060",
      "text": "نه بودن."
    },
    {
      "id": 62,
      "start": 6465.06,
      "end": 6466.06,
      "formatted_start": "01:47:45.060",
      "formatted_end": "01:47:46.060",
      "text": "نه بودن."
    },
    {
      "id": 63,
      "start": 6466.06,
      "end": 6467.06,
      "formatted_start": "01:47:46.060",
      "formatted_end": "01:47:47.060",
      "text": "نه بودن."
    },
    {
      "id": 64,
      "start": 6467.06,
      "end": 6468.06,
      "formatted_start": "01:47:47.060",
      "formatted_end": "01:47:48.060",
      "text": "نه بودن."
    },
    {
      "id": 65,
      "start": 6468.06,
      "end": 6472.06,
      "formatted_start": "01:47:48.060",
      "formatted_end": "01:47:52.060",
      "text": "یا ببینید هفته یه دنیا رو بکنید"
    },
    {
      "id": 66,
      "start": 6472.06,
      "end": 6478.06,
      "formatted_start": "01:47:52.060",
      "formatted_end": "01:47:58.060",
      "text": "و این رو بکنید و روز سیده آیلیگیتون"
    },
    {
      "id": 67,
      "start": 6478.06,
      "end": 6480.06,
      "formatted_start": "01:47:58.060",
      "formatted_end": "01:48:00.060",
      "text": "امروز روز سه بامه ده روز دیگه"
    },
    {
      "id": 68,
      "start": 6480.06,
      "end": 6482.06,
      "formatted_start": "01:48:00.060",
      "formatted_end": "01:48:02.060",
      "text": "ببینید سترانوگرافی میکنید ببینید"
    },
    {
      "id": 69,
      "start": 6482.06,
      "end": 6486.06,
      "formatted_start": "01:48:02.060",
      "formatted_end": "01:48:06.060",
      "text": "تقمکی جالب دارید یا نه"
    },
    {
      "id": 70,
      "start": 6486.06,
      "end": 6488.06,
      "formatted_start": "01:48:06.060",
      "formatted_end": "01:48:08.060",
      "text": "سیده آیلیگیتون"
    },
    {
      "id": 71,
      "start": 6488.06,
      "end": 6490.06,
      "formatted_start": "01:48:08.060",
      "formatted_end": "01:48:10.060",
      "text": "مانده این رو باشه"
    },
    {
      "id": 72,
      "start": 6490.06,
      "end": 6496.06,
      "formatted_start": "01:48:10.060",
      "formatted_end": "01:48:16.060",
      "text": "خب خوبه که این رو دارید"
    },
    {
      "id": 73,
      "start": 6496.06,
      "end": 6499.06,
      "formatted_start": "01:48:16.060",
      "formatted_end": "01:48:19.060",
      "text": "اینها را داریم و از اینجوری ها استفاده می کنیم."
    },
    {
      "id": 74,
      "start": 6499.06,
      "end": 6501.06,
      "formatted_start": "01:48:19.060",
      "formatted_end": "01:48:21.060",
      "text": "این ها به کوری تقریبی هستند."
    },
    {
      "id": 75,
      "start": 6501.06,
      "end": 6503.06,
      "formatted_start": "01:48:21.060",
      "formatted_end": "01:48:23.060",
      "text": "این ها به دوست هستند."
    },
    {
      "id": 76,
      "start": 6503.06,
      "end": 6505.06,
      "formatted_start": "01:48:23.060",
      "formatted_end": "01:48:25.060",
      "text": "این ها به دوست هستند."
    },
    {
      "id": 77,
      "start": 6505.06,
      "end": 6507.06,
      "formatted_start": "01:48:25.060",
      "formatted_end": "01:48:27.060",
      "text": "این ها به دوست هستند."
    },
    {
      "id": 78,
      "start": 6507.06,
      "end": 6509.06,
      "formatted_start": "01:48:27.060",
      "formatted_end": "01:48:29.060",
      "text": "این ها به دوست هستند."
    },
    {
      "id": 79,
      "start": 6509.06,
      "end": 6511.06,
      "formatted_start": "01:48:29.060",
      "formatted_end": "01:48:31.060",
      "text": "این صورتی را نمی کنیم."
    },
    {
      "id": 80,
      "start": 6511.06,
      "end": 6513.06,
      "formatted_start": "01:48:31.060",
      "formatted_end": "01:48:33.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 81,
      "start": 6513.06,
      "end": 6515.06,
      "formatted_start": "01:48:33.060",
      "formatted_end": "01:48:35.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 82,
      "start": 6515.06,
      "end": 6517.06,
      "formatted_start": "01:48:35.060",
      "formatted_end": "01:48:37.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 83,
      "start": 6517.06,
      "end": 6519.06,
      "formatted_start": "01:48:37.060",
      "formatted_end": "01:48:39.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 84,
      "start": 6519.06,
      "end": 6521.06,
      "formatted_start": "01:48:39.060",
      "formatted_end": "01:48:41.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 85,
      "start": 6521.06,
      "end": 6523.06,
      "formatted_start": "01:48:41.060",
      "formatted_end": "01:48:43.060",
      "text": "این ها به صورتی؟"
    },
    {
      "id": 86,
      "start": 6523.06,
      "end": 6529.06,
      "formatted_start": "01:48:43.060",
      "formatted_end": "01:48:49.060",
      "text": "چون فشارهای روحی به خودتون زیاد دارد کردین، رحمتون حالت پیر بیدا کرد."
    },
    {
      "id": 87,
      "start": 6529.06,
      "end": 6536.06,
      "formatted_start": "01:48:49.060",
      "formatted_end": "01:48:56.060",
      "text": "این چند منظور هست؟ این ما برای جلوی گیری از ثبیدی ما میدیم، جلوی گیری از چونی که صورت در خانه مایی ما میدیم."
    },
    {
      "id": 88,
      "start": 6536.06,
      "end": 6544.06,
      "formatted_start": "01:48:56.060",
      "formatted_end": "01:49:04.060",
      "text": "جلوی گیری بعد، مامان داریم؟ به مامانتون بیدیم جوان میشه، خیلی جوان برندگی زیاد در شهره داره،"
    },
    {
      "id": 89,
      "start": 6544.06,
      "end": 6551.06,
      "formatted_start": "01:49:04.060",
      "formatted_end": "01:49:11.060",
      "text": "در روی اثر، روی توخ میدار و رحم هم فوقلاده هست، این تلابه، این میگن زنان،"
    },
    {
      "id": 90,
      "start": 6551.06,
      "end": 6555.06,
      "formatted_start": "01:49:11.060",
      "formatted_end": "01:49:15.060",
      "text": "این مال چیزی مچه هاییه اینو حتما قدرت من کنید"
    },
    {
      "id": 91,
      "start": 6555.06,
      "end": 6559.06,
      "formatted_start": "01:49:15.060",
      "formatted_end": "01:49:19.060",
      "text": "یعنی ما به زخم و زور تونستیم توی نظر شده ایش میکنیم"
    },
    {
      "id": 92,
      "start": 6559.06,
      "end": 6563.06,
      "formatted_start": "01:49:19.060",
      "formatted_end": "01:49:23.060",
      "text": "سونیورافیه، دوخ مدان خون و هم"
    },
    {
      "id": 93,
      "start": 6563.06,
      "end": 6567.06,
      "formatted_start": "01:49:23.060",
      "formatted_end": "01:49:27.060",
      "text": "روزه سیزده"
    },
    {
      "id": 94,
      "start": 6567.06,
      "end": 6571.06,
      "formatted_start": "01:49:27.060",
      "formatted_end": "01:49:31.060",
      "text": "روزه سیزده، این روزه هر هفته این همه زود داره"
    },
    {
      "id": 95,
      "start": 6571.06,
      "end": 6575.06,
      "formatted_start": "01:49:31.060",
      "formatted_end": "01:49:35.060",
      "text": "های میری شما چی رو دارید؟"
    },
    {
      "id": 96,
      "start": 6575.06,
      "end": 6579.06,
      "formatted_start": "01:49:35.060",
      "formatted_end": "01:49:39.060",
      "text": "این هم قرصان پانه شده باید باشه"
    },
    {
      "id": 97,
      "start": 6579.06,
      "end": 6581.06,
      "formatted_start": "01:49:39.060",
      "formatted_end": "01:49:41.060",
      "text": "بله این رو بخورم دارم"
    },
    {
      "id": 98,
      "start": 6581.06,
      "end": 6583.06,
      "formatted_start": "01:49:41.060",
      "formatted_end": "01:49:43.060",
      "text": "بله"
    },
    {
      "id": 99,
      "start": 6583.06,
      "end": 6585.06,
      "formatted_start": "01:49:43.060",
      "formatted_end": "01:49:45.060",
      "text": "بله"
    },
    {
      "id": 100,
      "start": 6585.06,
      "end": 6587.06,
      "formatted_start": "01:49:45.060",
      "formatted_end": "01:49:47.060",
      "text": "بله سلامی"
    },
    {
      "id": 101,
      "start": 6587.06,
      "end": 6589.06,
      "formatted_start": "01:49:47.060",
      "formatted_end": "01:49:49.060",
      "text": "بله سلامی"
    },
    {
      "id": 102,
      "start": 6589.06,
      "end": 6591.06,
      "formatted_start": "01:49:49.060",
      "formatted_end": "01:49:51.060",
      "text": "بله سلامی"
    },
    {
      "id": 103,
      "start": 6591.06,
      "end": 6593.06,
      "formatted_start": "01:49:51.060",
      "formatted_end": "01:49:53.060",
      "text": "یه پرس روشواری یه پرس نقصدیگی"
    },
    {
      "id": 104,
      "start": 6593.06,
      "end": 6595.06,
      "formatted_start": "01:49:53.060",
      "formatted_end": "01:49:55.060",
      "text": "یه پرس نقصدیگی از آن کشور"
    },
    {
      "id": 105,
      "start": 6595.06,
      "end": 6597.06,
      "formatted_start": "01:49:55.060",
      "formatted_end": "01:49:57.060",
      "text": "ارما"
    },
    {
      "id": 106,
      "start": 6597.06,
      "end": 6599.06,
      "formatted_start": "01:49:57.060",
      "formatted_end": "01:49:59.060",
      "text": "ارما"
    },
    {
      "id": 107,
      "start": 6599.06,
      "end": 6601.06,
      "formatted_start": "01:49:59.060",
      "formatted_end": "01:50:01.060",
      "text": "ارما"
    }
  ],
  "status": "completed"
}