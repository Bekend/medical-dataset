  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4502.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:02.000",
      "text": "این رو بیاریم، اون رو سچک باشیم."
    },
    {
      "id": 1,
      "start": 4502.0,
      "end": 4503.0,
      "formatted_start": "01:15:02.000",
      "formatted_end": "01:15:03.000",
      "text": "خب؟"
    },
    {
      "id": 2,
      "start": 4503.0,
      "end": 4504.0,
      "formatted_start": "01:15:03.000",
      "formatted_end": "01:15:04.000",
      "text": "سچک بدم؟"
    },
    {
      "id": 3,
      "start": 4504.0,
      "end": 4505.0,
      "formatted_start": "01:15:04.000",
      "formatted_end": "01:15:05.000",
      "text": "آره."
    },
    {
      "id": 4,
      "start": 4505.0,
      "end": 4506.0,
      "formatted_start": "01:15:05.000",
      "formatted_end": "01:15:06.000",
      "text": "سلامتا سلامتا."
    },
    {
      "id": 5,
      "start": 4506.0,
      "end": 4507.0,
      "formatted_start": "01:15:06.000",
      "formatted_end": "01:15:07.000",
      "text": "سلامتا سلامتا."
    },
    {
      "id": 6,
      "start": 4507.0,
      "end": 4508.0,
      "formatted_start": "01:15:07.000",
      "formatted_end": "01:15:08.000",
      "text": "بگو بگو."
    },
    {
      "id": 7,
      "start": 4508.0,
      "end": 4510.0,
      "formatted_start": "01:15:08.000",
      "formatted_end": "01:15:10.000",
      "text": "این از این اینا یه بنایی برفتم، این رو بگو بگو بشیم."
    },
    {
      "id": 8,
      "start": 4510.0,
      "end": 4511.0,
      "formatted_start": "01:15:10.000",
      "formatted_end": "01:15:11.000",
      "text": "بگو بگو بگو."
    },
    {
      "id": 9,
      "start": 4511.0,
      "end": 4513.0,
      "formatted_start": "01:15:11.000",
      "formatted_end": "01:15:13.000",
      "text": "این جنگ زده کنه ببین."
    },
    {
      "id": 10,
      "start": 4513.0,
      "end": 4514.0,
      "formatted_start": "01:15:13.000",
      "formatted_end": "01:15:14.000",
      "text": "بگو بگو بگو."
    },
    {
      "id": 11,
      "start": 4514.0,
      "end": 4515.0,
      "formatted_start": "01:15:14.000",
      "formatted_end": "01:15:15.000",
      "text": "به ذهن جسد برم."
    },
    {
      "id": 12,
      "start": 4515.0,
      "end": 4517.0,
      "formatted_start": "01:15:15.000",
      "formatted_end": "01:15:17.000",
      "text": "چون به کن بردم به ذهن جسد بردم."
    },
    {
      "id": 13,
      "start": 4517.0,
      "end": 4518.0,
      "formatted_start": "01:15:17.000",
      "formatted_end": "01:15:18.000",
      "text": "بگو بگو بگو."
    },
    {
      "id": 14,
      "start": 4518.0,
      "end": 4519.0,
      "formatted_start": "01:15:18.000",
      "formatted_end": "01:15:19.000",
      "text": "سازده چهار برم."
    },
    {
      "id": 15,
      "start": 4519.0,
      "end": 4521.0,
      "formatted_start": "01:15:19.000",
      "formatted_end": "01:15:21.000",
      "text": "اینه ببن ازش بگیر"
    },
    {
      "id": 16,
      "start": 4529.0,
      "end": 4531.0,
      "formatted_start": "01:15:29.000",
      "formatted_end": "01:15:31.000",
      "text": "باید نشختی که دیگه هست"
    },
    {
      "id": 17,
      "start": 4531.0,
      "end": 4533.0,
      "formatted_start": "01:15:31.000",
      "formatted_end": "01:15:33.000",
      "text": "بفرد"
    },
    {
      "id": 18,
      "start": 4533.0,
      "end": 4535.0,
      "formatted_start": "01:15:33.000",
      "formatted_end": "01:15:35.000",
      "text": "خسته نباشین"
    },
    {
      "id": 19,
      "start": 4535.0,
      "end": 4537.0,
      "formatted_start": "01:15:35.000",
      "formatted_end": "01:15:37.000",
      "text": "آقایی دکتور پاها پا مایچه ها اینا خیلی میگیره"
    },
    {
      "id": 20,
      "start": 4537.0,
      "end": 4539.0,
      "formatted_start": "01:15:37.000",
      "formatted_end": "01:15:39.000",
      "text": "صفت صفت میشه"
    },
    {
      "id": 21,
      "start": 4539.0,
      "end": 4541.0,
      "formatted_start": "01:15:39.000",
      "formatted_end": "01:15:41.000",
      "text": "زانون یک لفه ویل میکنه"
    },
    {
      "id": 22,
      "start": 4541.0,
      "end": 4543.0,
      "formatted_start": "01:15:41.000",
      "formatted_end": "01:15:43.000",
      "text": "منو پرسارم بیشتر مدد"
    },
    {
      "id": 23,
      "start": 4543.0,
      "end": 4545.0,
      "formatted_start": "01:15:43.000",
      "formatted_end": "01:15:45.000",
      "text": "من زایدانم"
    },
    {
      "id": 24,
      "start": 4545.0,
      "end": 4547.0,
      "formatted_start": "01:15:45.000",
      "formatted_end": "01:15:47.000",
      "text": "اینا ویل میکنه"
    },
    {
      "id": 25,
      "start": 4547.0,
      "end": 4549.0,
      "formatted_start": "01:15:47.000",
      "formatted_end": "01:15:49.000",
      "text": "این همه بدن هست"
    },
    {
      "id": 26,
      "start": 4549.0,
      "end": 4551.0,
      "formatted_start": "01:15:49.000",
      "formatted_end": "01:15:51.000",
      "text": "مثل چون رو خواهید بگیرش کنیم"
    },
    {
      "id": 27,
      "start": 4551.0,
      "end": 4553.0,
      "formatted_start": "01:15:51.000",
      "formatted_end": "01:15:53.000",
      "text": "دوست پنجه های اون هست"
    },
    {
      "id": 28,
      "start": 4553.0,
      "end": 4555.0,
      "formatted_start": "01:15:53.000",
      "formatted_end": "01:15:55.000",
      "text": "این همه درسته"
    },
    {
      "id": 29,
      "start": 4555.0,
      "end": 4557.0,
      "formatted_start": "01:15:55.000",
      "formatted_end": "01:15:57.000",
      "text": "دوست پنجه های اون هست"
    },
    {
      "id": 30,
      "start": 4557.0,
      "end": 4559.0,
      "formatted_start": "01:15:57.000",
      "formatted_end": "01:15:59.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 31,
      "start": 4559.0,
      "end": 4561.0,
      "formatted_start": "01:15:59.000",
      "formatted_end": "01:16:01.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 32,
      "start": 4561.0,
      "end": 4563.0,
      "formatted_start": "01:16:01.000",
      "formatted_end": "01:16:03.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 33,
      "start": 4563.0,
      "end": 4565.0,
      "formatted_start": "01:16:03.000",
      "formatted_end": "01:16:05.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 34,
      "start": 4565.0,
      "end": 4567.0,
      "formatted_start": "01:16:05.000",
      "formatted_end": "01:16:07.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 35,
      "start": 4567.0,
      "end": 4569.0,
      "formatted_start": "01:16:07.000",
      "formatted_end": "01:16:09.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 36,
      "start": 4569.0,
      "end": 4571.0,
      "formatted_start": "01:16:09.000",
      "formatted_end": "01:16:11.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 37,
      "start": 4571.0,
      "end": 4573.0,
      "formatted_start": "01:16:11.000",
      "formatted_end": "01:16:13.000",
      "text": "درسته دیگه های اون هست"
    },
    {
      "id": 38,
      "start": 4573.0,
      "end": 4575.0,
      "formatted_start": "01:16:13.000",
      "formatted_end": "01:16:15.000",
      "text": "بیماری خند بخودی خوب میشه دیدی؟"
    },
    {
      "id": 39,
      "start": 4575.0,
      "end": 4577.0,
      "formatted_start": "01:16:15.000",
      "formatted_end": "01:16:17.000",
      "text": "بیماری خند دارم"
    },
    {
      "id": 40,
      "start": 4577.0,
      "end": 4581.0,
      "formatted_start": "01:16:17.000",
      "formatted_end": "01:16:21.000",
      "text": "بیماری خند دارم، قبل از ضایر و خواهی امر شده باشه"
    },
    {
      "id": 41,
      "start": 4581.0,
      "end": 4584.0,
      "formatted_start": "01:16:21.000",
      "formatted_end": "01:16:24.000",
      "text": "بیماری خند چی میخوری الان برسه؟"
    },
    {
      "id": 42,
      "start": 4584.0,
      "end": 4586.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:26.000",
      "text": "زینفلت ۵۰۰۰"
    },
    {
      "id": 43,
      "start": 4586.0,
      "end": 4588.0,
      "formatted_start": "01:16:26.000",
      "formatted_end": "01:16:28.000",
      "text": "۵۰۰۰، ۲۰۰۰"
    },
    {
      "id": 44,
      "start": 4588.0,
      "end": 4589.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:29.000",
      "text": "بله"
    },
    {
      "id": 45,
      "start": 4589.0,
      "end": 4591.0,
      "formatted_start": "01:16:29.000",
      "formatted_end": "01:16:31.000",
      "text": "دیگه چی میخوری؟"
    },
    {
      "id": 46,
      "start": 4591.0,
      "end": 4597.0,
      "formatted_start": "01:16:31.000",
      "formatted_end": "01:16:37.000",
      "text": "بله، یه برسه دیگه هم هست که ۸۰۰"
    },
    {
      "id": 47,
      "start": 4597.0,
      "end": 4598.0,
      "formatted_start": "01:16:37.000",
      "formatted_end": "01:16:38.000",
      "text": "گلوزی؟"
    },
    {
      "id": 48,
      "start": 4598.0,
      "end": 4600.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:40.000",
      "text": "آره، اونم میخوری"
    },
    {
      "id": 49,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "چی که؟ امکان میخوری؟"
    },
    {
      "id": 50,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:46.000",
      "text": "تنها داری؟"
    },
    {
      "id": 52,
      "start": 4606.0,
      "end": 4608.0,
      "formatted_start": "01:16:46.000",
      "formatted_end": "01:16:48.000",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 4608.0,
      "end": 4611.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:16:51.000",
      "text": "گرسه پشار هم میخورند"
    },
    {
      "id": 54,
      "start": 4611.0,
      "end": 4614.0,
      "formatted_start": "01:16:51.000",
      "formatted_end": "01:16:54.000",
      "text": "آهان گرسه پشار هم میخورند"
    },
    {
      "id": 55,
      "start": 4614.0,
      "end": 4616.0,
      "formatted_start": "01:16:54.000",
      "formatted_end": "01:16:56.000",
      "text": "شبیه غنم پشار"
    },
    {
      "id": 56,
      "start": 4616.0,
      "end": 4618.0,
      "formatted_start": "01:16:56.000",
      "formatted_end": "01:16:58.000",
      "text": "لا اله الا الله"
    },
    {
      "id": 57,
      "start": 4618.0,
      "end": 4620.0,
      "formatted_start": "01:16:58.000",
      "formatted_end": "01:17:00.000",
      "text": "بعد ما چرا تو ریست کنید؟"
    },
    {
      "id": 58,
      "start": 4620.0,
      "end": 4623.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:03.000",
      "text": "کلان دست پان یخ زده است و اونها داقه"
    },
    {
      "id": 59,
      "start": 4623.0,
      "end": 4627.0,
      "formatted_start": "01:17:03.000",
      "formatted_end": "01:17:07.000",
      "text": "اینکه گسته نفردید دستشو"
    },
    {
      "id": 60,
      "start": 4627.0,
      "end": 4629.0,
      "formatted_start": "01:17:07.000",
      "formatted_end": "01:17:09.000",
      "text": "شب"
    },
    {
      "id": 61,
      "start": 4629.0,
      "end": 4634.0,
      "formatted_start": "01:17:09.000",
      "formatted_end": "01:17:14.000",
      "text": "پاهم خوب باشه که بتونم راه برم. انگوشتا پاهم خیلی خرابه."
    },
    {
      "id": 62,
      "start": 4634.0,
      "end": 4635.0,
      "formatted_start": "01:17:14.000",
      "formatted_end": "01:17:15.000",
      "text": "پا چیه؟"
    },
    {
      "id": 63,
      "start": 4635.0,
      "end": 4639.0,
      "formatted_start": "01:17:15.000",
      "formatted_end": "01:17:19.000",
      "text": "جان انگوشتا پاهم مثل فیبری میمونید."
    },
    {
      "id": 64,
      "start": 4639.0,
      "end": 4641.0,
      "formatted_start": "01:17:19.000",
      "formatted_end": "01:17:21.000",
      "text": "این کاری بگن."
    },
    {
      "id": 65,
      "start": 4641.0,
      "end": 4643.0,
      "formatted_start": "01:17:21.000",
      "formatted_end": "01:17:23.000",
      "text": "نمیتونید."
    },
    {
      "id": 66,
      "start": 4643.0,
      "end": 4645.0,
      "formatted_start": "01:17:23.000",
      "formatted_end": "01:17:25.000",
      "text": "تا این دل باید بخورید."
    },
    {
      "id": 67,
      "start": 4645.0,
      "end": 4647.0,
      "formatted_start": "01:17:25.000",
      "formatted_end": "01:17:27.000",
      "text": "این انگوشتا من پاویده یا دکتر؟"
    },
    {
      "id": 68,
      "start": 4647.0,
      "end": 4649.0,
      "formatted_start": "01:17:27.000",
      "formatted_end": "01:17:29.000",
      "text": "نمیتونید."
    },
    {
      "id": 69,
      "start": 4649.0,
      "end": 4650.0,
      "formatted_start": "01:17:29.000",
      "formatted_end": "01:17:30.000",
      "text": "راست نیشت؟"
    },
    {
      "id": 70,
      "start": 4650.0,
      "end": 4651.0,
      "formatted_start": "01:17:30.000",
      "formatted_end": "01:17:31.000",
      "text": "کدوم؟"
    },
    {
      "id": 71,
      "start": 4651.0,
      "end": 4652.0,
      "formatted_start": "01:17:31.000",
      "formatted_end": "01:17:32.000",
      "text": "این یکی."
    },
    {
      "id": 72,
      "start": 4652.0,
      "end": 4653.0,
      "formatted_start": "01:17:32.000",
      "formatted_end": "01:17:33.000",
      "text": "بازش میپاید گیر میکنه؟"
    },
    {
      "id": 73,
      "start": 4653.0,
      "end": 4654.0,
      "formatted_start": "01:17:33.000",
      "formatted_end": "01:17:34.000",
      "text": "نمیشه."
    },
    {
      "id": 74,
      "start": 4654.0,
      "end": 4655.0,
      "formatted_start": "01:17:34.000",
      "formatted_end": "01:17:35.000",
      "text": "گیر میکنه."
    },
    {
      "id": 75,
      "start": 4655.0,
      "end": 4657.0,
      "formatted_start": "01:17:35.000",
      "formatted_end": "01:17:37.000",
      "text": "اون تار ارتوپدیه."
    },
    {
      "id": 76,
      "start": 4657.0,
      "end": 4659.0,
      "formatted_start": "01:17:37.000",
      "formatted_end": "01:17:39.000",
      "text": "اون دارو نداره"
    },
    {
      "id": 77,
      "start": 4659.0,
      "end": 4661.0,
      "formatted_start": "01:17:39.000",
      "formatted_end": "01:17:41.000",
      "text": "اونا یه غلافی داره"
    },
    {
      "id": 78,
      "start": 4661.0,
      "end": 4663.0,
      "formatted_start": "01:17:41.000",
      "formatted_end": "01:17:43.000",
      "text": "یا با لیزر یا با"
    },
    {
      "id": 79,
      "start": 4663.0,
      "end": 4665.0,
      "formatted_start": "01:17:43.000",
      "formatted_end": "01:17:45.000",
      "text": "جراحی که دیابت داره"
    },
    {
      "id": 80,
      "start": 4665.0,
      "end": 4667.0,
      "formatted_start": "01:17:45.000",
      "formatted_end": "01:17:47.000",
      "text": "بهتر لیزر بکنن بار پیزیوتراپیه"
    },
    {
      "id": 81,
      "start": 4667.0,
      "end": 4669.0,
      "formatted_start": "01:17:47.000",
      "formatted_end": "01:17:49.000",
      "text": "که لیزر مخصوص داشته باشه"
    },
    {
      "id": 82,
      "start": 4669.0,
      "end": 4671.0,
      "formatted_start": "01:17:49.000",
      "formatted_end": "01:17:51.000",
      "text": "یا زهر بشه"
    },
    {
      "id": 83,
      "start": 4671.0,
      "end": 4673.0,
      "formatted_start": "01:17:51.000",
      "formatted_end": "01:17:53.000",
      "text": "زاهدانی یا زابونی؟"
    },
    {
      "id": 84,
      "start": 4673.0,
      "end": 4675.0,
      "formatted_start": "01:17:53.000",
      "formatted_end": "01:17:55.000",
      "text": "زاهدان داره"
    },
    {
      "id": 85,
      "start": 4675.0,
      "end": 4677.0,
      "formatted_start": "01:17:55.000",
      "formatted_end": "01:17:57.000",
      "text": "زابون هم فامیش زیاده است"
    },
    {
      "id": 86,
      "start": 4677.0,
      "end": 4679.0,
      "formatted_start": "01:17:57.000",
      "formatted_end": "01:17:59.000",
      "text": "نه زاهدان داره"
    },
    {
      "id": 87,
      "start": 4679.0,
      "end": 4681.0,
      "formatted_start": "01:17:59.000",
      "formatted_end": "01:18:01.000",
      "text": "زابون اقرار مانده زاهدان باشه"
    },
    {
      "id": 88,
      "start": 4681.0,
      "end": 4683.0,
      "formatted_start": "01:18:01.000",
      "formatted_end": "01:18:03.000",
      "text": "زاهدان بیشتر دیگه"
    },
    {
      "id": 89,
      "start": 4683.0,
      "end": 4685.0,
      "formatted_start": "01:18:03.000",
      "formatted_end": "01:18:05.000",
      "text": "زابون هیچی نداره"
    },
    {
      "id": 90,
      "start": 4685.0,
      "end": 4690.0,
      "formatted_start": "01:18:05.000",
      "formatted_end": "01:18:10.000",
      "text": "از آیده ها باید بگیرید اسمش هست تب فیزیکی"
    },
    {
      "id": 91,
      "start": 4690.0,
      "end": 4697.0,
      "formatted_start": "01:18:10.000",
      "formatted_end": "01:18:17.000",
      "text": "باید پیدا کنید تب فیزیکی اونها فیزیکی نه هر فیزیوتورا بگیرید"
    },
    {
      "id": 92,
      "start": 4697.0,
      "end": 4703.0,
      "formatted_start": "01:18:17.000",
      "formatted_end": "01:18:23.000",
      "text": "نوشنه تب فیزیکی نوشنه باید پیدا کنید متخصص تب فیزیکی بیری این گیر کرده"
    },
    {
      "id": 93,
      "start": 4703.0,
      "end": 4707.0,
      "formatted_start": "01:18:23.000",
      "formatted_end": "01:18:27.000",
      "text": "بعد این رو برایت لیزر می کنند بدون جراحی باز بگیرید"
    },
    {
      "id": 94,
      "start": 4707.0,
      "end": 4709.0,
      "formatted_start": "01:18:27.000",
      "formatted_end": "01:18:29.000",
      "text": "این درد هم از پیر لگنه"
    },
    {
      "id": 95,
      "start": 4709.0,
      "end": 4712.0,
      "formatted_start": "01:18:29.000",
      "formatted_end": "01:18:32.000",
      "text": "اون درده درده دارم بیده اون موانه سیاتیکه"
    },
    {
      "id": 96,
      "start": 4712.0,
      "end": 4715.0,
      "formatted_start": "01:18:32.000",
      "formatted_end": "01:18:35.000",
      "text": "آره درده سیاتیکه درده درده درده شو میبنیم"
    },
    {
      "id": 97,
