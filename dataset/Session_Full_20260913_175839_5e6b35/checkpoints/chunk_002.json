  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 608.0,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:08.000",
      "text": "من نه سرگزیم، آقایی چهانه از سرگزیم. گفتگو زیر رفت اینجا نیست."
    },
    {
      "id": 1,
      "start": 608.0,
      "end": 612.0,
      "formatted_start": "00:10:08.000",
      "formatted_end": "00:10:12.000",
      "text": "من نجابت بودم، از پشتی بودم."
    },
    {
      "id": 2,
      "start": 612.0,
      "end": 616.0,
      "formatted_start": "00:10:12.000",
      "formatted_end": "00:10:16.000",
      "text": "آقا هم پسر من بود."
    },
    {
      "id": 3,
      "start": 616.0,
      "end": 620.0,
      "formatted_start": "00:10:16.000",
      "formatted_end": "00:10:20.000",
      "text": "اینجا در بشت، پسر خواهش بود."
    },
    {
      "id": 4,
      "start": 620.0,
      "end": 624.0,
      "formatted_start": "00:10:20.000",
      "formatted_end": "00:10:24.000",
      "text": "اینجا شیده بود، اینجا آمد بیرونت، سرگز بود، برای اینجا شو برده بود."
    },
    {
      "id": 5,
      "start": 624.0,
      "end": 654.0,
      "formatted_start": "00:10:24.000",
      "formatted_end": "00:10:54.000",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 6,
      "start": 654.0,
      "end": 661.0,
      "formatted_start": "00:10:54.000",
      "formatted_end": "00:11:01.000",
      "text": "این کادر را دید دوشمان مثل زندگی، برلا او خواهد دارد وشنجی می آمید."
    },
    {
      "id": 7,
      "start": 661.0,
      "end": 664.0,
      "formatted_start": "00:11:01.000",
      "formatted_end": "00:11:04.000",
      "text": "او فنا دارد و او فنا را دارد و دارد وشنجی می آمید."
    },
    {
      "id": 8,
      "start": 664.0,
      "end": 669.0,
      "formatted_start": "00:11:04.000",
      "formatted_end": "00:11:09.000",
      "text": "او بیشتر شادی می آمید."
    },
    {
      "id": 9,
      "start": 669.0,
      "end": 673.0,
      "formatted_start": "00:11:09.000",
      "formatted_end": "00:11:13.000",
      "text": "او بیشتر شادی می آمید."
    },
    {
      "id": 10,
      "start": 673.0,
      "end": 675.0,
      "formatted_start": "00:11:13.000",
      "formatted_end": "00:11:15.000",
      "text": "۳۳ ساله باز کردم."
    },
    {
      "id": 11,
      "start": 675.0,
      "end": 679.0,
      "formatted_start": "00:11:15.000",
      "formatted_end": "00:11:19.000",
      "text": "از گرم از کرونا مادرم بود کردی."
    },
    {
      "id": 12,
      "start": 679.0,
      "end": 682.0,
      "formatted_start": "00:11:19.000",
      "formatted_end": "00:11:22.000",
      "text": "پایان مادرم میگرد نیست دارد."
    },
    {
      "id": 13,
      "start": 682.0,
      "end": 686.0,
      "formatted_start": "00:11:22.000",
      "formatted_end": "00:11:26.000",
      "text": "مادرم شکر کرد از کرونا بود کردی."
    },
    {
      "id": 14,
      "start": 686.0,
      "end": 690.0,
      "formatted_start": "00:11:26.000",
      "formatted_end": "00:11:30.000",
      "text": "الان میگردم."
    },
    {
      "id": 15,
      "start": 690.0,
      "end": 693.0,
      "formatted_start": "00:11:30.000",
      "formatted_end": "00:11:33.000",
      "text": "۱۰ ساله باز کردم."
    },
    {
      "id": 16,
      "start": 693.0,
      "end": 705.0,
      "formatted_start": "00:11:33.000",
      "formatted_end": "00:11:45.000",
      "text": "این همه چیزایی کاری می کرده ایم. داره که هران نوزه بازم."
    },
    {
      "id": 17,
      "start": 705.0,
      "end": 711.0,
      "formatted_start": "00:11:45.000",
      "formatted_end": "00:11:51.000",
      "text": "این چیزی ها دیگر نمازم. هنگشن برد. چار در خواهر سنه برد."
    },
    {
      "id": 18,
      "start": 711.0,
      "end": 718.0,
      "formatted_start": "00:11:51.000",
      "formatted_end": "00:11:58.000",
      "text": "گفتیم اینکه مادر من این کلاس بیریکرد دوست من نرکتم در منی دیگر ساتمون."
    },
    {
      "id": 19,
      "start": 718.0,
      "end": 720.0,
      "formatted_start": "00:11:58.000",
      "formatted_end": "00:12:00.000",
      "text": "و این روشنی بهترین اون سوال."
    },
    {
      "id": 20,
      "start": 720.0,
      "end": 721.5,
      "formatted_start": "00:12:00.000",
      "formatted_end": "00:12:01.500",
      "text": "می گیرند."
    },
    {
      "id": 21,
      "start": 721.5,
      "end": 723.0,
      "formatted_start": "00:12:01.500",
      "formatted_end": "00:12:03.000",
      "text": "این پسراتی رو می کلیدند و می روید."
    },
    {
      "id": 22,
      "start": 723.0,
      "end": 724.5,
      "formatted_start": "00:12:03.000",
      "formatted_end": "00:12:04.500",
      "text": "و بیرون کار دید."
    },
    {
      "id": 23,
      "start": 724.5,
      "end": 727.5,
      "formatted_start": "00:12:04.500",
      "formatted_end": "00:12:07.500",
      "text": "آخرون اون تقاضی بود من خستش در مرشد مانده."
    },
    {
      "id": 24,
      "start": 727.5,
      "end": 729.0,
      "formatted_start": "00:12:07.500",
      "formatted_end": "00:12:09.000",
      "text": "و در این سال در این مرشد،"
    },
    {
      "id": 25,
      "start": 729.0,
      "end": 730.5,
      "formatted_start": "00:12:09.000",
      "formatted_end": "00:12:10.500",
      "text": "یه احساس بود."
    },
    {
      "id": 26,
      "start": 730.5,
      "end": 732.5,
      "formatted_start": "00:12:10.500",
      "formatted_end": "00:12:12.500",
      "text": "من از این رو دارم."
    },
    {
      "id": 27,
      "start": 732.5,
      "end": 734.0,
      "formatted_start": "00:12:12.500",
      "formatted_end": "00:12:14.000",
      "text": "الان از این سال دیدم."
    },
    {
      "id": 28,
      "start": 734.0,
      "end": 736.0,
      "formatted_start": "00:12:14.000",
      "formatted_end": "00:12:16.000",
      "text": "شخص من کاریست کاریست."
    },
    {
      "id": 29,
      "start": 736.0,
      "end": 738.0,
      "formatted_start": "00:12:16.000",
      "formatted_end": "00:12:18.000",
      "text": "ولی از سورت من خودتان نمی بودم."
    },
    {
      "id": 30,
      "start": 738.0,
      "end": 739.0,
      "formatted_start": "00:12:18.000",
      "formatted_end": "00:12:19.000",
      "text": "من خواهید این هر رو دادم."
    },
    {
      "id": 31,
      "start": 739.0,
      "end": 740.5,
      "formatted_start": "00:12:19.000",
      "formatted_end": "00:12:20.500",
      "text": "خواهید این رو دادم."
    },
    {
      "id": 32,
      "start": 740.5,
      "end": 770.5,
      "formatted_start": "00:12:20.500",
      "formatted_end": "00:12:50.500",
      "text": "و از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا"
    },
    {
      "id": 33,
      "start": 770.5,
      "end": 800.48,
      "formatted_start": "00:12:50.500",
      "formatted_end": "00:13:20.480",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 34,
      "start": 800.5,
      "end": 822.5,
      "formatted_start": "00:13:20.500",
