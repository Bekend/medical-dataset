  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9614.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:14.000",
      "text": "اینجوری برداری همون برس جلوگیری که خانواد دادن همون رو مصرف کنید، از این برداری فکر می آنش باشید، ولی نزدیکی را تونید سنگ کنید و کاندوم هم جمعیدید."
    },
    {
      "id": 1,
      "start": 9614.0,
      "end": 9626.0,
      "formatted_start": "02:40:14.000",
      "formatted_end": "02:40:26.000",
      "text": "افرادی که اینجوری میام و مولی مشکلی دارند یک برداری خارج از رحم پیدا می کنند، که حتی دارند برس جلوگیری می خورند، اون برداری خارج از رحم زیاد اطباع می کنید."
    },
    {
      "id": 2,
      "start": 9626.0,
      "end": 9628.52,
      "formatted_start": "02:40:26.000",
      "formatted_end": "02:40:28.520",
      "text": "اما اصلا برس استفاده امارات هستم که تنظیم بشه"
    },
    {
      "id": 3,
      "start": 9628.52,
      "end": 9629.46,
      "formatted_start": "02:40:28.520",
      "formatted_end": "02:40:29.460",
      "text": "نه دیگه"
    },
    {
      "id": 4,
      "start": 9629.46,
      "end": 9632.0,
      "formatted_start": "02:40:29.460",
      "formatted_end": "02:40:32.000",
      "text": "از غذاش یکی دو روز پیروزی من"
    },
    {
      "id": 5,
      "start": 9632.0,
      "end": 9634.16,
      "formatted_start": "02:40:32.000",
      "formatted_end": "02:40:34.160",
      "text": "تنها سه با من اینجوری شده"
    },
    {
      "id": 6,
      "start": 9634.16,
      "end": 9637.56,
      "formatted_start": "02:40:34.160",
      "formatted_end": "02:40:37.560",
      "text": "بله، کم شدن هرمون استروجهی در توی اینجوری"
    },
    {
      "id": 7,
      "start": 9637.56,
      "end": 9638.06,
      "formatted_start": "02:40:37.560",
      "formatted_end": "02:40:38.060",
      "text": "خب"
    },
    {
      "id": 8,
      "start": 9638.06,
      "end": 9641.36,
      "formatted_start": "02:40:38.060",
      "formatted_end": "02:40:41.360",
      "text": "یا پروژه سرون بشه بیشتر استروجهی داری که اینجوری میکنی"
    },
    {
      "id": 9,
      "start": 9641.36,
      "end": 9644.0,
      "formatted_start": "02:40:41.360",
      "formatted_end": "02:40:44.000",
      "text": "این هرمونی از دختران از اون کم بشه"
    },
    {
      "id": 10,
      "start": 9644.0,
      "end": 9646.0,
      "formatted_start": "02:40:44.000",
      "formatted_end": "02:40:46.000",
      "text": "تو چاره این درکه بمیشه"
    },
    {
      "id": 11,
      "start": 9646.0,
      "end": 9646.5,
      "formatted_start": "02:40:46.000",
      "formatted_end": "02:40:46.500",
      "text": "بله"
    },
    {
      "id": 12,
      "start": 9646.5,
      "end": 9649.76,
      "formatted_start": "02:40:46.500",
      "formatted_end": "02:40:49.760",
      "text": "طبعا من چیزم هم با پسی میدونم انجام میدادم"
    },
    {
      "id": 13,
      "start": 9649.76,
      "end": 9652.76,
      "formatted_start": "02:40:49.760",
      "formatted_end": "02:40:52.760",
      "text": "اگر نیاز باشید، میانان جواب شروعات نگه بفتر باشد."
    },
    {
      "id": 14,
      "start": 9652.76,
      "end": 9657.76,
      "formatted_start": "02:40:52.760",
      "formatted_end": "02:40:57.760",
      "text": "باید شروع کردیم. مشکلی داره این اقامتی که داره، او برطرف می کنه،"
    },
    {
      "id": 15,
      "start": 9657.76,
      "end": 9663.76,
      "formatted_start": "02:40:57.760",
      "formatted_end": "02:41:03.760",
      "text": "بسه دیگه این نداره، خواهد خاطرتون باشید که شما هم مشکل بارداری دارید،"
    },
    {
      "id": 16,
      "start": 9663.76,
      "end": 9669.76,
      "formatted_start": "02:41:03.760",
      "formatted_end": "02:41:09.760",
      "text": "یعنی هم احتمال بارداری خارج از راهی نه این نظر، در آینده برای تو هست، برای کانترل می سوید."
    },
    {
      "id": 17,
      "start": 9669.76,
      "end": 9671.76,
      "formatted_start": "02:41:09.760",
      "formatted_end": "02:41:11.760",
      "text": "پس بدون اینکه زیر توجه نکنم به این سوال."
    },
    {
      "id": 18,
      "start": 9671.76,
      "end": 9673.76,
      "formatted_start": "02:41:11.760",
      "formatted_end": "02:41:13.760",
      "text": "نه، نه، زهرش برم"
    },
    {
      "id": 19,
      "start": 9673.76,
      "end": 9675.76,
      "formatted_start": "02:41:13.760",
      "formatted_end": "02:41:15.760",
      "text": "با خیلی آقایی"
    },
    {
      "id": 20,
      "start": 9677.76,
      "end": 9679.76,
      "formatted_start": "02:41:17.760",
      "formatted_end": "02:41:19.760",
      "text": "نیازی هست نشون برم؟"
    },
    {
      "id": 21,
      "start": 9679.76,
      "end": 9681.76,
      "formatted_start": "02:41:19.760",
      "formatted_end": "02:41:21.760",
      "text": "برو خبار، سختش برو"
    },
    {
      "id": 22,
      "start": 9681.76,
      "end": 9683.76,
      "formatted_start": "02:41:21.760",
      "formatted_end": "02:41:23.760",
      "text": "برو سخت رو برم"
    },
    {
      "id": 23,
      "start": 9694.76,
      "end": 9696.76,
      "formatted_start": "02:41:34.760",
      "formatted_end": "02:41:36.760",
      "text": "بفرمایی، بفرمایی"
    },
    {
      "id": 24,
      "start": 9696.76,
      "end": 9697.76,
      "formatted_start": "02:41:36.760",
      "formatted_end": "02:41:37.760",
      "text": "خبار مردم"
    },
    {
      "id": 25,
      "start": 9697.76,
      "end": 9699.76,
      "formatted_start": "02:41:37.760",
      "formatted_end": "02:41:39.760",
      "text": "سلام، سلام، بفرمایی، سلام"
    },
    {
      "id": 26,
      "start": 9699.76,
      "end": 9702.76,
      "formatted_start": "02:41:39.760",
      "formatted_end": "02:41:42.760",
      "text": "سلام بخشید. سلامون حالی."
    },
    {
      "id": 27,
      "start": 9702.76,
      "end": 9704.76,
      "formatted_start": "02:41:42.760",
      "formatted_end": "02:41:44.760",
      "text": "سلام بخشید."
    },
    {
      "id": 28,
      "start": 9706.76,
      "end": 9708.76,
      "formatted_start": "02:41:46.760",
      "formatted_end": "02:41:48.760",
      "text": "بخشید. بخشید. بخشید."
    },
    {
      "id": 29,
      "start": 9708.76,
      "end": 9711.76,
      "formatted_start": "02:41:48.760",
      "formatted_end": "02:41:51.760",
      "text": "انشالله. انشالله."
    },
    {
      "id": 30,
      "start": 9711.76,
      "end": 9714.76,
      "formatted_start": "02:41:51.760",
      "formatted_end": "02:41:54.760",
      "text": "چی شده خواله جان؟ بپرما."
    },
    {
      "id": 31,
      "start": 9714.76,
      "end": 9717.76,
      "formatted_start": "02:41:54.760",
      "formatted_end": "02:41:57.760",
      "text": "آدتون. آدتون ما..."
    },
    {
      "id": 32,
      "start": 9717.76,
      "end": 9720.76,
      "formatted_start": "02:41:57.760",
      "formatted_end": "02:42:00.760",
      "text": "بخشید. افتادم. افتادم."
    },
    {
      "id": 33,
      "start": 9720.76,
      "end": 9724.76,
      "formatted_start": "02:42:00.760",
      "formatted_end": "02:42:04.760",
      "text": "یه... مثلا یه دومداری..."
    },
    {
      "id": 34,
      "start": 9724.76,
      "end": 9726.76,
      "formatted_start": "02:42:04.760",
      "formatted_end": "02:42:06.760",
      "text": "از کارای سکون؟"
    },
    {
      "id": 35,
      "start": 9726.76,
      "end": 9727.76,
      "formatted_start": "02:42:06.760",
      "formatted_end": "02:42:07.760",
      "text": "آره."
    },
    {
      "id": 36,
      "start": 9727.76,
      "end": 9728.76,
      "formatted_start": "02:42:07.760",
      "formatted_end": "02:42:08.760",
      "text": "خب؟"
    },
    {
      "id": 37,
      "start": 9728.76,
      "end": 9732.92,
      "formatted_start": "02:42:08.760",
      "formatted_end": "02:42:12.920",
      "text": "افتادم همین کچی چاله بود اون جا"
    },
    {
      "id": 38,
      "start": 9732.92,
      "end": 9734.92,
      "formatted_start": "02:42:12.920",
      "formatted_end": "02:42:14.920",
      "text": "همین پان"
    },
    {
      "id": 39,
      "start": 9734.92,
      "end": 9738.92,
      "formatted_start": "02:42:14.920",
      "formatted_end": "02:42:18.920",
      "text": "هم اولا پار سال و روز قربانی"
    },
    {
      "id": 40,
      "start": 9738.92,
      "end": 9742.52,
      "formatted_start": "02:42:18.920",
      "formatted_end": "02:42:22.520",
      "text": "دیگه نمیتوانستم پی از اینور بخوابم"
    },
    {
      "id": 41,
      "start": 9742.52,
      "end": 9748.92,
      "formatted_start": "02:42:22.520",
      "formatted_end": "02:42:28.920",
      "text": "دیگه دکترم رفتم اول که گفت که باید امر بشی"
    },
    {
      "id": 42,
      "start": 9748.92,
      "end": 9751.0,
      "formatted_start": "02:42:28.920",
      "formatted_end": "02:42:31.000",
      "text": "همون کافتن به من بیدونی که گرم زدی"
    },
    {
      "id": 43,
      "start": 9751.0,
      "end": 9754.0,
      "formatted_start": "02:42:31.000",
      "formatted_end": "02:42:34.000",
      "text": "گفته که امر بشی دکتر اسماعی"
    },
    {
      "id": 44,
      "start": 9754.0,
      "end": 9757.4,
      "formatted_start": "02:42:34.000",
      "formatted_end": "02:42:37.400",
      "text": "گفته که دسته تامورد پاسر بگوید"
    },
    {
      "id": 45,
      "start": 9757.4,
      "end": 9761.4,
      "formatted_start": "02:42:37.400",
      "formatted_end": "02:42:41.400",
      "text": "بعد اینجا امرارش میشه"
    },
    {
      "id": 46,
      "start": 9761.4,
      "end": 9765.4,
      "formatted_start": "02:42:41.400",
      "formatted_end": "02:42:45.400",
      "text": "آره امرارش رو نگهه"
    },
    {
      "id": 47,
      "start": 9765.4,
      "end": 9771.4,
      "formatted_start": "02:42:45.400",
      "formatted_end": "02:42:51.400",
      "text": "تا در باره رفتم امرار گرفتم"
    },
    {
      "id": 48,
      "start": 9771.4,
      "end": 9775.4,
      "formatted_start": "02:42:51.400",
      "formatted_end": "02:42:55.400",
      "text": "دکترون میرسادقه گفته که"
    },
    {
      "id": 49,
      "start": 9775.4,
      "end": 9779.4,
      "formatted_start": "02:42:55.400",
      "formatted_end": "02:42:59.400",
      "text": "چهار خوب شده"
    },
    {
      "id": 50,
      "start": 9779.4,
      "end": 9783.4,
      "formatted_start": "02:42:59.400",
      "formatted_end": "02:43:03.400",
      "text": "همه زن همینو بارن"
    },
    {
      "id": 51,
      "start": 9783.4,
      "end": 9788.4,
      "formatted_start": "02:43:03.400",
      "formatted_end": "02:43:08.400",
      "text": "همه زن همین پوکی و سوخان دارند"
    },
    {
      "id": 52,
      "start": 9788.4,
      "end": 9792.4,
      "formatted_start": "02:43:08.400",
      "formatted_end": "02:43:12.400",
      "text": "تو زمین افتادی خدا بهت رحم کرده از این بر بگو"
    },
    {
      "id": 53,
      "start": 9792.4,
      "end": 9796.4,
      "formatted_start": "02:43:12.400",
      "formatted_end": "02:43:16.400",
      "text": "افتادم زمین هیچیم نشد خدا به من رحم کرد"
    },
    {
      "id": 54,
      "start": 9796.4,
      "end": 9801.4,
      "formatted_start": "02:43:16.400",
      "formatted_end": "02:43:21.400",
      "text": "زرب و مغزی نشدی از دو متر در خواهی که افتادی می میره"
    },
    {
      "id": 55,
      "start": 9801.4,
      "end": 9806.4,
      "formatted_start": "02:43:21.400",
      "formatted_end": "02:43:26.400",
      "text": "پاد یکم آسیب دیده درستش می کنی؟"
    },
    {
      "id": 56,
      "start": 9806.4,
      "end": 9811.4,
      "formatted_start": "02:43:26.400",
      "formatted_end": "02:43:31.400",
      "text": "روی تخت درست بکش روی دیوار درست بکش"
    },
    {
      "id": 57,
      "start": 9811.4,
      "end": 9813.4,
      "formatted_start": "02:43:31.400",
      "formatted_end": "02:43:33.400",
      "text": "این باید حاسیب تالا باشه"
    },
    {
      "id": 58,
      "start": 9813.4,
      "end": 9815.4,
      "formatted_start": "02:43:33.400",
      "formatted_end": "02:43:35.400",
      "text": "آره از کجا میاد؟"
    },
    {
      "id": 59,
      "start": 9815.4,
      "end": 9817.4,
      "formatted_start": "02:43:35.400",
      "formatted_end": "02:43:37.400",
      "text": "من شابرود میاد"
    },
    {
      "id": 60,
      "start": 9817.4,
      "end": 9820.4,
      "formatted_start": "02:43:37.400",
      "formatted_end": "02:43:40.400",
      "text": "نراب شابرود کجا؟ شهر شده بودی؟ یا رسته هاش میاد؟"
    },
    {
      "id": 61,
      "start": 9820.4,
      "end": 9824.4,
      "formatted_start": "02:43:40.400",
      "formatted_end": "02:43:44.400",
      "text": "آره اما که شابرود بودی من شهر رو که این برگم مادر همینو نامنیک میشه"
    },
    {
      "id": 62,
      "start": 9824.4,
      "end": 9825.4,
      "formatted_start": "02:43:44.400",
      "formatted_end": "02:43:45.400",
      "text": "کجا؟"
    },
    {
      "id": 63,
      "start": 9825.4,
      "end": 9826.4,
      "formatted_start": "02:43:45.400",
      "formatted_end": "02:43:46.400",
      "text": "نامنیک"
    },
    {
      "id": 64,
      "start": 9826.4,
      "end": 9828.4,
      "formatted_start": "02:43:46.400",
      "formatted_end": "02:43:48.400",
      "text": "نامنیک به هر حال"
    },
    {
      "id": 65,
      "start": 9828.4,
      "end": 9832.4,
      "formatted_start": "02:43:48.400",
      "formatted_end": "02:43:52.400",
      "text": "باب درست بگیش خالی ببینم رو به دیوار درست بگیش نمیزن"
    },
    {
      "id": 66,
      "start": 9862.4,
      "end": 9867.82,
      "formatted_start": "02:44:22.400",
      "formatted_end": "02:44:27.820",
      "text": "این زنون صاف باشه، خاله این زنون جمع باشه که کمی، آهان، این صاف باشه"
    },
    {
      "id": 67,
      "start": 9867.82,
      "end": 9868.32,
      "formatted_start": "02:44:27.820",
      "formatted_end": "02:44:28.320",
      "text": "آره"
    },
    {
      "id": 68,
      "start": 9868.32,
      "end": 9872.56,
      "formatted_start": "02:44:28.320",
      "formatted_end": "02:44:32.560",
      "text": "خب شما، هم رو به دیوار باشین، دیوار، خب ببینم یه"
    },
    {
      "id": 69,
      "start": 9873.76,
      "end": 9874.56,
      "formatted_start": "02:44:33.760",
      "formatted_end": "02:44:34.560",
      "text": "آره، آره"
    },
    {
      "id": 70,
      "start": 9874.56,
      "end": 9875.64,
      "formatted_start": "02:44:34.560",
      "formatted_end": "02:44:35.640",
      "text": "این محسن سیادی"
    },
    {
      "id": 71,
      "start": 9875.64,
      "end": 9876.8,
      "formatted_start": "02:44:35.640",
      "formatted_end": "02:44:36.800",
      "text": "آره، آره، آره"
    },
    {
      "id": 72,
      "start": 9877.08,
      "end": 9879.36,
      "formatted_start": "02:44:37.080",
      "formatted_end": "02:44:39.360",
      "text": "خاله سیادی که، نگران نماش"
    },
    {
      "id": 73,
      "start": 9879.36,
      "end": 9881.28,
      "formatted_start": "02:44:39.360",
      "formatted_end": "02:44:41.280",
      "text": "اینجا تنفذ یا هم؟"
    },
    {
      "id": 74,
      "start": 9881.28,
      "end": 9881.92,
      "formatted_start": "02:44:41.280",
      "formatted_end": "02:44:41.920",
      "text": "آره، آره"
    },
    {
      "id": 75,
      "start": 9881.92,
      "end": 9882.28,
      "formatted_start": "02:44:41.920",
      "formatted_end": "02:44:42.280",
      "text": "اینجا تنفذ"
    },
    {
      "id": 76,
      "start": 9882.28,
      "end": 9884.28,
      "formatted_start": "02:44:42.280",
      "formatted_end": "02:44:44.280",
      "text": "اونو یکم درد میکنه"
    },
    {
      "id": 77,
      "start": 9884.28,
      "end": 9884.52,
      "formatted_start": "02:44:44.280",
      "formatted_end": "02:44:44.520",
      "text": "آره"
    },
    {
      "id": 78,
      "start": 9884.52,
      "end": 9885.32,
      "formatted_start": "02:44:44.520",
      "formatted_end": "02:44:45.320",
      "text": "زیاد نه"
    },
    {
      "id": 79,
      "start": 9885.32,
      "end": 9886.08,
      "formatted_start": "02:44:45.320",
      "formatted_end": "02:44:46.080",
      "text": "بله اینجا بشه"
    },
    {
      "id": 80,
      "start": 9886.08,
      "end": 9887.28,
      "formatted_start": "02:44:46.080",
      "formatted_end": "02:44:47.280",
      "text": "زیاد بی غرام"
    },
    {
      "id": 81,
      "start": 9887.28,
      "end": 9887.88,
      "formatted_start": "02:44:47.280",
      "formatted_end": "02:44:47.880",
      "text": "آه"
    },
    {
      "id": 82,
      "start": 9887.88,
      "end": 9889.88,
      "formatted_start": "02:44:47.880",
      "formatted_end": "02:44:49.880",
      "text": "اوه"
    },
    {
      "id": 83,
      "start": 9889.88,
      "end": 9891.88,
      "formatted_start": "02:44:49.880",
      "formatted_end": "02:44:51.880",
      "text": "اوه"
    },
    {
      "id": 84,
      "start": 9891.88,
      "end": 9893.88,
      "formatted_start": "02:44:51.880",
      "formatted_end": "02:44:53.880",
      "text": "چشم"
    },
    {
      "id": 85,
      "start": 9893.88,
      "end": 9895.88,
      "formatted_start": "02:44:53.880",
      "formatted_end": "02:44:55.880",
      "text": "چشم"
    },
    {
      "id": 86,
      "start": 9895.88,
      "end": 9897.88,
      "formatted_start": "02:44:55.880",
      "formatted_end": "02:44:57.880",
      "text": "بفرما"
    },
    {
      "id": 87,
      "start": 9897.88,
      "end": 9899.88,
      "formatted_start": "02:44:57.880",
      "formatted_end": "02:44:59.880",
      "text": "کامیره دیگه"
    }
  ],
  "status": "completed"
}