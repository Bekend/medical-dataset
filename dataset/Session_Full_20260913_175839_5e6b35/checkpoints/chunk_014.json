  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4204.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:04.000",
      "text": "این کپسول هست، کپسول انرژی فکس."
    },
    {
      "id": 1,
      "start": 4204.0,
      "end": 4217.0,
      "formatted_start": "01:10:04.000",
      "formatted_end": "01:10:17.000",
      "text": "صبح و زهر، کپسولیه نیست که انرژی فکس نباید بردار باشه، صبح، اینکه کشت بردیش من چه بود، پرد میشه، در اون صورت راست بردار باشه، تواسیبی باشه."
    },
    {
      "id": 2,
      "start": 4217.0,
      "end": 4221.0,
      "formatted_start": "01:10:17.000",
      "formatted_end": "01:10:21.000",
      "text": "صبح و زهر انرژی فکس، اینه باشه."
    },
    {
      "id": 3,
      "start": 4221.0,
      "end": 4226.0,
      "formatted_start": "01:10:21.000",
      "formatted_end": "01:10:26.000",
      "text": "صبح و زهر میخوایی، یکم شب اشتباهی نخوایی که صبح میشه."
    },
    {
      "id": 4,
      "start": 4226.0,
      "end": 4236.0,
      "formatted_start": "01:10:26.000",
      "formatted_end": "01:10:36.000",
      "text": "یکی رو صبح می کنید و یکی رو زور می کنید از همین امروز این سنگینه سرد که میگه فشار میاره با قسمت کم میشه فردا پس فردا خوب میشه"
    },
    {
      "id": 5,
      "start": 4236.0,
      "end": 4237.0,
      "formatted_start": "01:10:36.000",
      "formatted_end": "01:10:37.000",
      "text": "اشایبا"
    },
    {
      "id": 6,
      "start": 4237.0,
      "end": 4242.0,
      "formatted_start": "01:10:37.000",
      "formatted_end": "01:10:42.000",
      "text": "باید یک سرام اعمال بزنید فقط نوع پندتو بدونم"
    },
    {
      "id": 7,
      "start": 4242.0,
      "end": 4244.0,
      "formatted_start": "01:10:42.000",
      "formatted_end": "01:10:44.000",
      "text": "سایی"
    },
    {
      "id": 8,
      "start": 4244.0,
      "end": 4246.0,
      "formatted_start": "01:10:44.000",
      "formatted_end": "01:10:46.000",
      "text": "اه نه"
    },
    {
      "id": 9,
      "start": 4246.0,
      "end": 4248.0,
      "formatted_start": "01:10:46.000",
      "formatted_end": "01:10:48.000",
      "text": "سایی"
    },
    {
      "id": 10,
      "start": 4248.0,
      "end": 4250.0,
      "formatted_start": "01:10:48.000",
      "formatted_end": "01:10:50.000",
      "text": "بزرگ پندر"
    },
    {
      "id": 11,
      "start": 4250.0,
      "end": 4252.0,
      "formatted_start": "01:10:50.000",
      "formatted_end": "01:10:52.000",
      "text": "از سرورم برقص"
    },
    {
      "id": 12,
      "start": 4252.0,
      "end": 4254.0,
      "formatted_start": "01:10:52.000",
      "formatted_end": "01:10:54.000",
      "text": "حساب گردو خورده بودم"
    },
    {
      "id": 13,
      "start": 4254.0,
      "end": 4256.0,
      "formatted_start": "01:10:54.000",
      "formatted_end": "01:10:56.000",
      "text": "باش کنم"
    },
    {
      "id": 14,
      "start": 4256.0,
      "end": 4258.0,
      "formatted_start": "01:10:56.000",
      "formatted_end": "01:10:58.000",
      "text": "گردوی قرار شد نخورید دیگه؟"
    },
    {
      "id": 15,
      "start": 4258.0,
      "end": 4260.0,
      "formatted_start": "01:10:58.000",
      "formatted_end": "01:11:00.000",
      "text": "نه نه"
    },
    {
      "id": 16,
      "start": 4260.0,
      "end": 4262.0,
      "formatted_start": "01:11:00.000",
      "formatted_end": "01:11:02.000",
      "text": "امروز یه هایی"
    },
    {
      "id": 17,
      "start": 4262.0,
      "end": 4264.0,
      "formatted_start": "01:11:02.000",
      "formatted_end": "01:11:04.000",
      "text": "بوده"
    },
    {
      "id": 18,
      "start": 4264.0,
      "end": 4266.0,
      "formatted_start": "01:11:04.000",
      "formatted_end": "01:11:06.000",
      "text": "بگو دو براش"
    },
    {
      "id": 19,
      "start": 4266.0,
      "end": 4268.0,
      "formatted_start": "01:11:06.000",
      "formatted_end": "01:11:08.000",
      "text": "براش"
    },
    {
      "id": 20,
      "start": 4268.0,
      "end": 4270.0,
      "formatted_start": "01:11:08.000",
      "formatted_end": "01:11:10.000",
      "text": "خب یک سایی"
    },
    {
      "id": 21,
      "start": 4270.0,
      "end": 4272.0,
      "formatted_start": "01:11:10.000",
      "formatted_end": "01:11:12.000",
      "text": "این طرف شده هست"
    },
    {
      "id": 22,
      "start": 4272.0,
      "end": 4274.0,
      "formatted_start": "01:11:12.000",
      "formatted_end": "01:11:14.000",
      "text": "پرم مقدم؟"
    },
    {
      "id": 23,
      "start": 4276.0,
      "end": 4278.0,
      "formatted_start": "01:11:16.000",
      "formatted_end": "01:11:18.000",
      "text": "بله"
    },
    {
      "id": 24,
      "start": 4278.0,
      "end": 4280.0,
      "formatted_start": "01:11:18.000",
      "formatted_end": "01:11:20.000",
      "text": "دیابت رو داریم یا نه؟"
    },
    {
      "id": 25,
      "start": 4280.0,
      "end": 4282.0,
      "formatted_start": "01:11:20.000",
      "formatted_end": "01:11:22.000",
      "text": "از این تنجات رو گرفته بودم؟"
    },
    {
      "id": 26,
      "start": 4282.0,
      "end": 4284.0,
      "formatted_start": "01:11:22.000",
      "formatted_end": "01:11:24.000",
      "text": "حساب بکنم اونو بردم"
    },
    {
      "id": 27,
      "start": 4284.0,
      "end": 4286.0,
      "formatted_start": "01:11:24.000",
      "formatted_end": "01:11:26.000",
      "text": "بردمی؟"
    },
    {
      "id": 28,
      "start": 4286.0,
      "end": 4288.0,
      "formatted_start": "01:11:26.000",
      "formatted_end": "01:11:28.000",
      "text": "بردمی"
    },
    {
      "id": 29,
      "start": 4288.0,
      "end": 4290.0,
      "formatted_start": "01:11:28.000",
      "formatted_end": "01:11:30.000",
      "text": "بردمی یه جا کردم"
    },
    {
      "id": 30,
      "start": 4290.0,
      "end": 4292.0,
      "formatted_start": "01:11:30.000",
      "formatted_end": "01:11:32.000",
      "text": "برای قنده"
    },
    {
      "id": 31,
      "start": 4292.0,
      "end": 4294.0,
      "formatted_start": "01:11:32.000",
      "formatted_end": "01:11:34.000",
      "text": "برای؟ برای؟"
    },
    {
      "id": 32,
      "start": 4294.0,
      "end": 4296.0,
      "formatted_start": "01:11:34.000",
      "formatted_end": "01:11:36.000",
      "text": "134"
    },
    {
      "id": 33,
      "start": 4296.0,
      "end": 4298.0,
      "formatted_start": "01:11:36.000",
      "formatted_end": "01:11:38.000",
      "text": "حساب بکنید هم؟"
    },
    {
      "id": 34,
      "start": 4298.0,
      "end": 4311.5,
      "formatted_start": "01:11:38.000",
      "formatted_end": "01:11:51.500",
      "text": "اون گردوکی خواست سنگیر بکنه اما اصلا غندت باره یا باید بکنه افرادی میتونن اصلا و خام و چیزا بکنن غندشان زیر صد باشه یا حد اکثر صد باشه شما باید غندت قدیز کنید"
    },
    {
      "id": 35,
      "start": 4311.5,
      "end": 4313.5,
      "formatted_start": "01:11:51.500",
      "formatted_end": "01:11:53.500",
      "text": "غند دو بار گرد هشت شما بودن"
    },
    {
      "id": 36,
      "start": 4313.5,
      "end": 4323.0,
      "formatted_start": "01:11:53.500",
      "formatted_end": "01:12:03.000",
      "text": "اون ناشتاته ناشتات این غند غیر ناشتای اون ناشتای ما را فرید بیده خواهد کشتادون را درک و میبوخونه"
    },
    {
      "id": 37,
      "start": 4323.0,
      "end": 4326.0,
      "formatted_start": "01:12:03.000",
      "formatted_end": "01:12:06.000",
      "text": "از این حال هم که زمانی کاری یک ساعت شیریه بودن"
    },
    {
      "id": 38,
      "start": 4326.0,
      "end": 4328.0,
      "formatted_start": "01:12:06.000",
      "formatted_end": "01:12:08.000",
      "text": "باشه که هم کور باید باید چند باشه؟"
    },
    {
      "id": 39,
      "start": 4328.0,
      "end": 4331.0,
      "formatted_start": "01:12:08.000",
      "formatted_end": "01:12:11.000",
      "text": "باشه که هم کور از صد و بیس بالاتر بره اشکاره"
    },
    {
      "id": 40,
      "start": 4331.0,
      "end": 4333.0,
      "formatted_start": "01:12:11.000",
      "formatted_end": "01:12:13.000",
      "text": "صد و چهر بره بالاتر بیماره"
    },
    {
      "id": 41,
      "start": 4333.0,
      "end": 4337.0,
      "formatted_start": "01:12:13.000",
      "formatted_end": "01:12:17.000",
      "text": "صد و بیس تا صد و چهر میگیم که پرهیز باید بکنه"
    },
    {
      "id": 42,
      "start": 4337.0,
      "end": 4341.0,
      "formatted_start": "01:12:17.000",
      "formatted_end": "01:12:21.000",
      "text": "بیماری قند نداره ولی مواد قندی باید پرهیز بکنه"
    },
    {
      "id": 43,
      "start": 4341.0,
      "end": 4344.0,
      "formatted_start": "01:12:21.000",
      "formatted_end": "01:12:24.000",
      "text": "این آزمایش ناشتا میدونم خرید شیری"
    },
    {
      "id": 44,
      "start": 4344.0,
      "end": 4347.0,
      "formatted_start": "01:12:24.000",
      "formatted_end": "01:12:27.000",
      "text": "اصلا بعد از آزمایش افراد بیمار میشن"
    },
    {
      "id": 45,
      "start": 4347.0,
      "end": 4350.0,
      "formatted_start": "01:12:27.000",
      "formatted_end": "01:12:30.000",
      "text": "چون اشتباهاتشون پیزشکان توضیح ندیدن"
    },
    {
      "id": 46,
      "start": 4350.0,
      "end": 4355.0,
      "formatted_start": "01:12:30.000",
      "formatted_end": "01:12:35.000",
      "text": "ناشنه یه بیشگی هایی داره که ما برای بیماری دیابت"
    },
    {
      "id": 47,
      "start": 4355.0,
      "end": 4358.0,
      "formatted_start": "01:12:35.000",
      "formatted_end": "01:12:38.000",
      "text": "اگه مثلا اونجا شب به بالا باشه میگیم بیماری دیابت"
    },
    {
      "id": 48,
      "start": 4358.0,
      "end": 4361.0,
      "formatted_start": "01:12:38.000",
      "formatted_end": "01:12:41.000",
      "text": "الان 136 میگیم بیماری دیابت نداریم"
    },
    {
      "id": 49,
      "start": 4361.0,
      "end": 4366.0,
      "formatted_start": "01:12:41.000",
      "formatted_end": "01:12:46.000",
      "text": "برده غذا اگه از 140 بره باراتر میشه تازه بیماری"
    },
    {
      "id": 50,
      "start": 4366.0,
      "end": 4370.0,
      "formatted_start": "01:12:46.000",
      "formatted_end": "01:12:50.000",
      "text": "بیماری نداریم ولی لب مرزی دیگه 136 مساوی 140 دیگه"
    },
    {
      "id": 51,
      "start": 4370.0,
      "end": 4374.0,
      "formatted_start": "01:12:50.000",
      "formatted_end": "01:12:54.000",
      "text": "لب مرز بیماری هستیم پس باید شما پرهیز بکنید"
    },
    {
      "id": 52,
      "start": 4374.0,
      "end": 4379.0,
      "formatted_start": "01:12:54.000",
      "formatted_end": "01:12:59.000",
      "text": "همین چیزهای مقلبی هستند. حالا مثلا دیروز نهار چون پردید؟"
    },
    {
      "id": 53,
      "start": 4379.0,
      "end": 4382.0,
      "formatted_start": "01:12:59.000",
      "formatted_end": "01:13:02.000",
      "text": "نهار؟ نهار؟ نهار؟"
    },
    {
      "id": 54,
      "start": 4382.0,
      "end": 4385.0,
      "formatted_start": "01:13:02.000",
      "formatted_end": "01:13:05.000",
      "text": "میدونم بهش با چی خورششی؟ تا چی بود؟"
    },
    {
      "id": 55,
      "start": 4385.0,
      "end": 4387.0,
      "formatted_start": "01:13:05.000",
      "formatted_end": "01:13:07.000",
      "text": "فرکانتر"
    },
    {
      "id": 56,
      "start": 4387.0,
      "end": 4390.0,
      "formatted_start": "01:13:07.000",
      "formatted_end": "01:13:10.000",
      "text": "یادت هم نمی آید. اصلا حافظت هم منگ بگیر بگاره این مسئله."
    },
    {
      "id": 57,
      "start": 4390.0,
      "end": 4396.0,
      "formatted_start": "01:13:10.000",
      "formatted_end": "01:13:16.000",
      "text": "به خاطر پرغذایی هستش. این پرغذایی تو بیایی سباک غذایی کن،"
    },
    {
      "id": 58,
      "start": 4396.0,
      "end": 4401.0,
      "formatted_start": "01:13:16.000",
      "formatted_end": "01:13:21.000",
      "text": "انرژی فکس هم نکن و یک سرامونتر دادن بدنت باید بشه، برگیره کنش."
    },
    {
      "id": 59,
      "start": 4401.0,
      "end": 4404.0,
      "formatted_start": "01:13:21.000",
      "formatted_end": "01:13:24.000",
      "text": "من یزجون از خواهد باید بکنم و رو باید پرداشتیم."
    },
    {
      "id": 60,
      "start": 4404.0,
      "end": 4406.0,
      "formatted_start": "01:13:24.000",
      "formatted_end": "01:13:26.000",
      "text": "سه و پند تو دلیل چند."
    },
    {
      "id": 61,
      "start": 4406.0,
      "end": 4410.0,
      "formatted_start": "01:13:26.000",
      "formatted_end": "01:13:30.000",
      "text": "یا سختش بکنیم و اونشون فقط بنده داریم و ویزیدش مجانی بشیم."
    },
    {
      "id": 62,
      "start": 4410.0,
      "end": 4411.0,
      "formatted_start": "01:13:30.000",
      "formatted_end": "01:13:31.000",
      "text": "بله."
    },
    {
      "id": 63,
      "start": 4411.0,
      "end": 4413.0,
      "formatted_start": "01:13:31.000",
      "formatted_end": "01:13:33.000",
      "text": "این حاضر اینقدر سند کنم امشبایی."
    },
    {
      "id": 64,
      "start": 4413.0,
      "end": 4414.0,
      "formatted_start": "01:13:33.000",
      "formatted_end": "01:13:34.000",
      "text": "بله."
    },
    {
      "id": 65,
      "start": 4414.0,
      "end": 4416.0,
      "formatted_start": "01:13:34.000",
      "formatted_end": "01:13:36.000",
      "text": "جرد اقل داشتیم اینه."
    },
    {
      "id": 66,
      "start": 4416.0,
      "end": 4417.0,
      "formatted_start": "01:13:36.000",
      "formatted_end": "01:13:37.000",
      "text": "نه نه دارم."
    },
    {
      "id": 67,
      "start": 4417.0,
      "end": 4418.0,
      "formatted_start": "01:13:37.000",
      "formatted_end": "01:13:38.000",
      "text": "این؟"
    },
    {
      "id": 68,
      "start": 4418.0,
      "end": 4419.0,
      "formatted_start": "01:13:38.000",
      "formatted_end": "01:13:39.000",
      "text": "بله میگه تو."
    },
    {
      "id": 69,
      "start": 4419.0,
      "end": 4422.0,
      "formatted_start": "01:13:39.000",
      "formatted_end": "01:13:42.000",
      "text": "از همونی که توی اونه باید بکنیم."
    },
    {
      "id": 70,
      "start": 4422.0,
      "end": 4423.0,
      "formatted_start": "01:13:42.000",
      "formatted_end": "01:13:43.000",
      "text": "بله."
    },
    {
      "id": 71,
      "start": 4423.0,
      "end": 4424.0,
      "formatted_start": "01:13:43.000",
      "formatted_end": "01:13:44.000",
      "text": "اینه خوبه باشه."
    },
    {
      "id": 72,
      "start": 4424.0,
      "end": 4425.0,
      "formatted_start": "01:13:44.000",
      "formatted_end": "01:13:45.000",
