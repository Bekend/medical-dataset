  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7505.4,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:05.400",
      "text": "اینجوریت ها کچیه، فرامان همراه کشیم جلیزانو. گیدیم تر خانه در ناسن چه شکلی میشه."
    },
    {
      "id": 1,
      "start": 7505.4,
      "end": 7510.6,
      "formatted_start": "02:05:05.400",
      "formatted_end": "02:05:10.600",
      "text": "همونو میخوریم. پچیک رو رایت نکردن، اسم نکردن، اینجوری شده."
    },
    {
      "id": 2,
      "start": 7510.6,
      "end": 7514.6,
      "formatted_start": "02:05:10.600",
      "formatted_end": "02:05:14.600",
      "text": "خب، از نسخه قبلیتون چه دارهایی دارید؟"
    },
    {
      "id": 3,
      "start": 7514.6,
      "end": 7516.6,
      "formatted_start": "02:05:14.600",
      "formatted_end": "02:05:16.600",
      "text": "اون نسخه رو یادم اصلا اینجوریت."
    },
    {
      "id": 4,
      "start": 7516.6,
      "end": 7517.6,
      "formatted_start": "02:05:16.600",
      "formatted_end": "02:05:17.600",
      "text": "چند روز پیش کنی؟"
    },
    {
      "id": 5,
      "start": 7517.6,
      "end": 7522.2,
      "formatted_start": "02:05:17.600",
      "formatted_end": "02:05:22.200",
      "text": "همه، مثلا یه ماه پیش کرده اون شده. بلیدرم دادورشو همه شو نخوردم."
    },
    {
      "id": 6,
      "start": 7522.2,
      "end": 7527.2,
      "formatted_start": "02:05:22.200",
      "formatted_end": "02:05:27.200",
      "text": "چون واسه پیست هم دکتر میرفتم اونجا دارو بدم داده بود"
    },
    {
      "id": 7,
      "start": 7527.2,
      "end": 7531.2,
      "formatted_start": "02:05:27.200",
      "formatted_end": "02:05:31.200",
      "text": "میخوردم خیلی میدم درد میگرفت همه شو نخوردم مثلا یه وقت دارم"
    },
    {
      "id": 8,
      "start": 7531.2,
      "end": 7535.2,
      "formatted_start": "02:05:31.200",
      "formatted_end": "02:05:35.200",
      "text": "درد دارد مورد زنوده هم میشتر داری میده هم میده هم"
    },
    {
      "id": 9,
      "start": 7535.2,
      "end": 7540.2,
      "formatted_start": "02:05:35.200",
      "formatted_end": "02:05:40.200",
      "text": "آن دارد نه آبای من چون سابقه میده درد از درگرد داشته هم خیلی عذیب میشدم"
    },
    {
      "id": 10,
      "start": 7540.2,
      "end": 7545.2,
      "formatted_start": "02:05:40.200",
      "formatted_end": "02:05:45.200",
      "text": "چون دو سری دارو داشتن میخوردم بیایی هیقتن قطعش کردم"
    },
    {
      "id": 11,
      "start": 7545.2,
      "end": 7548.2,
      "formatted_start": "02:05:45.200",
      "formatted_end": "02:05:48.200",
      "text": "چون خیلی میدم عذیب میکردم"
    },
    {
      "id": 12,
      "start": 7548.2,
      "end": 7578.2,
      "formatted_start": "02:05:48.200",
      "formatted_end": "02:06:18.200",
      "text": "از اینکه باید باید برداری کنید، از اینکه باید برداری کنید، از اینکه باید برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید، از اینکه برداری کنید"
    },
    {
      "id": 13,
      "start": 7578.2,
      "end": 7584.2,
      "formatted_start": "02:06:18.200",
      "formatted_end": "02:06:24.200",
      "text": "سال مدشته 5 بود و حتی امسال همه وقت زیرا قدمت و پارسال رو رفته بودیم به شما"
    },
    {
      "id": 14,
      "start": 7584.2,
      "end": 7590.2,
      "formatted_start": "02:06:24.200",
      "formatted_end": "02:06:30.200",
      "text": "بابرایتون میشه من 6 تا مدار درکتوری هستم، کار سمخواده ای ندارم"
    },
    {
      "id": 15,
      "start": 7590.2,
      "end": 7596.2,
      "formatted_start": "02:06:30.200",
      "formatted_end": "02:06:36.200",
      "text": "من توی اینجا نرسم از اینجا، بابا باشن گفتن که مثلا اینجایی گفتن که دوستشون اونو بردن کنه دید"
    },
    {
      "id": 16,
      "start": 7596.2,
      "end": 7599.2,
      "formatted_start": "02:06:36.200",
      "formatted_end": "02:06:39.200",
      "text": "و گفتم نه من دکتور بیشتر قبول بدم"
    },
    {
      "id": 17,
      "start": 7599.2,
      "end": 7604.72,
      "formatted_start": "02:06:39.200",
      "formatted_end": "02:06:44.720",
      "text": "نه، اونطور که در رفته ایه کنید، این پیچهاردگی های تدریجی کارولا نیست"
    },
    {
      "id": 18,
      "start": 7604.72,
      "end": 7609.6,
      "formatted_start": "02:06:44.720",
      "formatted_end": "02:06:49.600",
      "text": "این رو نمیدونید، حتی بهزشگاه هم نمیدونند خیلی ممکن"
    },
    {
      "id": 19,
      "start": 7609.6,
      "end": 7617.6,
      "formatted_start": "02:06:49.600",
      "formatted_end": "02:06:57.600",
      "text": "این دورانه خاص داره، ما هم دو میدیار دادیم، چند ساعت پیش رفتیم، دوبه این دورانه دیده هیچیز نیست"
    },
    {
      "id": 20,
      "start": 7617.6,
      "end": 7621.84,
      "formatted_start": "02:06:57.600",
      "formatted_end": "02:07:01.840",
      "text": "من شما دو میدونید، من یکی هم مبادرستم تو لطف دارم"
    },
    {
      "id": 21,
      "start": 7621.84,
      "end": 7651.84,
      "formatted_start": "02:07:01.840",
      "formatted_end": "02:07:31.840",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم ک"
    },
    {
      "id": 22,
      "start": 7651.84,
      "end": 7653.84,
      "formatted_start": "02:07:31.840",
      "formatted_end": "02:07:33.840",
      "text": "خودتون باید بردارید."
    },
    {
      "id": 23,
      "start": 7653.84,
      "end": 7655.84,
      "formatted_start": "02:07:33.840",
      "formatted_end": "02:07:35.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 24,
      "start": 7655.84,
      "end": 7657.84,
      "formatted_start": "02:07:35.840",
      "formatted_end": "02:07:37.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 25,
      "start": 7657.84,
      "end": 7659.84,
      "formatted_start": "02:07:37.840",
      "formatted_end": "02:07:39.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 26,
      "start": 7659.84,
      "end": 7661.84,
      "formatted_start": "02:07:39.840",
      "formatted_end": "02:07:41.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 27,
      "start": 7661.84,
      "end": 7663.84,
      "formatted_start": "02:07:41.840",
      "formatted_end": "02:07:43.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 28,
      "start": 7663.84,
      "end": 7665.84,
      "formatted_start": "02:07:43.840",
      "formatted_end": "02:07:45.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 29,
      "start": 7665.84,
      "end": 7667.84,
      "formatted_start": "02:07:45.840",
      "formatted_end": "02:07:47.840",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 30,
      "start": 7667.84,
      "end": 7669.84,
      "formatted_start": "02:07:47.840",
      "formatted_end": "02:07:49.840",
      "text": "رمزش رو بفرمید"
    },
    {
      "id": 31,
      "start": 7669.84,
      "end": 7671.84,
      "formatted_start": "02:07:49.840",
      "formatted_end": "02:07:51.840",
      "text": "چرا چه روند؟"
    },
    {
      "id": 32,
      "start": 7671.84,
      "end": 7673.84,
      "formatted_start": "02:07:51.840",
      "formatted_end": "02:07:53.840",
      "text": "یه آقایی"
    },
    {
      "id": 33,
      "start": 7673.84,
      "end": 7675.84,
      "formatted_start": "02:07:53.840",
      "formatted_end": "02:07:55.840",
      "text": "یه آقایی"
    },
    {
      "id": 34,
      "start": 7675.84,
      "end": 7677.84,
      "formatted_start": "02:07:55.840",
      "formatted_end": "02:07:57.840",
      "text": "در اینجور درسته"
    },
    {
      "id": 35,
      "start": 7677.84,
      "end": 7679.84,
      "formatted_start": "02:07:57.840",
      "formatted_end": "02:07:59.840",
      "text": "یه آقایی از طایفه ای که اونو اسمشون در برم"
    },
    {
      "id": 36,
      "start": 7679.84,
      "end": 7681.84,
      "formatted_start": "02:07:59.840",
      "formatted_end": "02:08:01.840",
      "text": "که خیلی هم"
    },
    {
      "id": 37,
      "start": 7681.84,
      "end": 7683.84,
      "formatted_start": "02:08:01.840",
      "formatted_end": "02:08:03.840",
      "text": "متمند به هستن"
    },
    {
      "id": 38,
      "start": 7683.84,
      "end": 7685.84,
      "formatted_start": "02:08:03.840",
      "formatted_end": "02:08:05.840",
      "text": "خانومش"
    },
    {
      "id": 39,
      "start": 7685.84,
      "end": 7687.84,
      "formatted_start": "02:08:05.840",
      "formatted_end": "02:08:07.840",
      "text": "خیلی یاده ای بود"
    },
    {
      "id": 40,
      "start": 7687.84,
      "end": 7689.84,
      "formatted_start": "02:08:07.840",
      "formatted_end": "02:08:09.840",
      "text": "خیلی نه مربازه دارن"
    },
    {
      "id": 41,
      "start": 7689.84,
      "end": 7691.84,
      "formatted_start": "02:08:09.840",
      "formatted_end": "02:08:11.840",
      "text": "مرد خیلی خسیس بود"
    },
    {
      "id": 42,
      "start": 7691.84,
      "end": 7693.84,
      "formatted_start": "02:08:11.840",
      "formatted_end": "02:08:13.840",
      "text": "زنه رو من گفتم"
    },
    {
      "id": 43,
      "start": 7693.84,
      "end": 7695.84,
      "formatted_start": "02:08:13.840",
      "formatted_end": "02:08:15.840",
      "text": "آفن در حالت خیلی بد"
    },
    {
      "id": 44,
      "start": 7695.84,
      "end": 7699.84,
      "formatted_start": "02:08:15.840",
      "formatted_end": "02:08:19.840",
      "text": "حتما انجام میشه وگرنه به یک سال نکشیده تا ویزه زانو میخواست"
    },
    {
      "id": 45,
      "start": 7699.84,
      "end": 7704.84,
      "formatted_start": "02:08:19.840",
      "formatted_end": "02:08:24.840",
      "text": "زن اومد یه گار دو گار بیمارد و گفت اون پایده چون راقام قبول نمی کنه"
    },
    {
      "id": 46,
      "start": 7704.84,
      "end": 7709.84,
      "formatted_start": "02:08:24.840",
      "formatted_end": "02:08:29.840",
      "text": "بعد زنشتن که بشکی به تمسکی دو بشکانه است"
    },
    {
      "id": 47,
      "start": 7709.84,
      "end": 7712.84,
      "formatted_start": "02:08:29.840",
      "formatted_end": "02:08:32.840",
      "text": "با تمسکی نتونه دارد به میرم؟"
    },
    {
      "id": 48,
      "start": 7712.84,
      "end": 7713.84,
      "formatted_start": "02:08:32.840",
      "formatted_end": "02:08:33.840",
      "text": "به دکتور بشکی برم"
    },
    {
      "id": 49,
      "start": 7713.84,
      "end": 7714.84,
      "formatted_start": "02:08:33.840",
      "formatted_end": "02:08:34.840",
      "text": "این بعده درسته؟"
    },
    {
      "id": 50,
      "start": 7714.84,
      "end": 7717.84,
      "formatted_start": "02:08:34.840",
      "formatted_end": "02:08:37.840",
      "text": "نه این بچه داشتن برم"
    },
    {
      "id": 51,
      "start": 7717.84,
      "end": 7719.84,
      "formatted_start": "02:08:37.840",
      "formatted_end": "02:08:39.840",
      "text": "پشکنه دارد"
    },
    {
      "id": 52,
      "start": 7719.84,
      "end": 7721.84,
      "formatted_start": "02:08:39.840",
      "formatted_end": "02:08:41.840",
      "text": "برم چون برم بشکی برم"
    },
    {
      "id": 53,
      "start": 7721.84,
      "end": 7730.84,
      "formatted_start": "02:08:41.840",
      "formatted_end": "02:08:50.840",
      "text": "اینو تا قبل من شدم"
    },
    {
      "id": 54,
      "start": 7730.84,
      "end": 7740.84,
      "formatted_start": "02:08:50.840",
      "formatted_end": "02:09:00.840",
      "text": "از اینجا هر جای رو نمی کنیم، اون طورم برمانزنه"
    },
    {
      "id": 55,
      "start": 7740.84,
      "end": 7743.84,
      "formatted_start": "02:09:00.840",
      "formatted_end": "02:09:03.840",
      "text": "بستگاه شمنجام دادم و خوب شده بود"
    },
    {
      "id": 56,
      "start": 7743.84,
      "end": 7747.84,
      "formatted_start": "02:09:03.840",
      "formatted_end": "02:09:07.840",
      "text": "استرامپرد، افتاد پاچان رو من برمانجام میدم"
    },
    {
      "id": 57,
      "start": 7747.84,
      "end": 7753.44,
      "formatted_start": "02:09:07.840",
      "formatted_end": "02:09:13.440",
      "text": "روزی که شاهد تو راضی بودی، خوب بود، شوهر باره شد، برکرون بیاد"
    },
    {
      "id": 58,
      "start": 7753.44,
      "end": 7754.04,
      "formatted_start": "02:09:13.440",
      "formatted_end": "02:09:14.040",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 7754.54,
      "end": 7756.74,
      "formatted_start": "02:09:14.540",
      "formatted_end": "02:09:16.740",
      "text": "بعد چند دقیقا من گوشهارم هیچی بود"
    },
    {
      "id": 60,
      "start": 7756.74,
      "end": 7758.14,
      "formatted_start": "02:09:16.740",
      "formatted_end": "02:09:18.140",
      "text": "آره، واقعا"
    },
    {
      "id": 61,
      "start": 7758.14,
      "end": 7759.54,
      "formatted_start": "02:09:18.140",
      "formatted_end": "02:09:19.540",
      "text": "بعضی پردا واقعا اینجوریست"
    },
    {
      "id": 62,
      "start": 7759.54,
      "end": 7761.84,
      "formatted_start": "02:09:19.540",
      "formatted_end": "02:09:21.840",
      "text": "مرد خصیص خیلی زمان خسته بود"
    },
    {
      "id": 63,
      "start": 7761.84,
      "end": 7768.04,
      "formatted_start": "02:09:21.840",
      "formatted_end": "02:09:28.040",
      "text": "آره، خالوا خوش مرد، بگم بابشا سمیع است، خیلی خصیصه من"
    },
    {
      "id": 64,
      "start": 7768.04,
      "end": 7771.04,
      "formatted_start": "02:09:28.040",
      "formatted_end": "02:09:31.040",
      "text": "بعضی پول هم نمیدونی، آره خصیصت هم نمیدونی"
    },
    {
      "id": 65,
      "start": 7771.04,
      "end": 7778.04,
      "formatted_start": "02:09:31.040",
      "formatted_end": "02:09:38.040",
      "text": "من حقیقت بر شرایگان هم جاییم، اشکار ندارم. من اجرایم چون این زنو در خطره، واقعا در مدرن."
    },
    {
      "id": 66,
      "start": 7778.04,
      "end": 7789.04,
      "formatted_start": "02:09:38.040",
      "formatted_end": "02:09:49.040",
      "text": "به خاطرم، حالا زنو گفت بعد از بستگاه ندارم، واقعا زنو نداره و مرد از اوناست که جونش در ویدیو قیمونه بیده."
    },
    {
      "id": 67,
      "start": 7789.04,
      "end": 7795.04,
      "formatted_start": "02:09:49.040",
      "formatted_end": "02:09:55.040",
      "text": "واقعا هستند بگیر، جرادم هم هستند. انا من تو اطراف این خودم خانه را، شهست سالشه."
    },
    {
      "id": 68,
      "start": 7795.04,
      "end": 7800.0,
      "formatted_start": "02:09:55.040",
      "formatted_end": "02:10:00.000",
      "text": "شما همون رو سادم که می کنید اگه درمون نکردم تیز سنده باید کنید"
    }
  ],
  "status": "completed"
}