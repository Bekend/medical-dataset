      "end": 3412.0,
      "formatted_start": "00:56:50.000",
      "formatted_end": "00:56:52.000",
      "text": "باید درده"
    },
    {
      "id": 27,
      "start": 3414.0,
      "end": 3416.0,
      "formatted_start": "00:56:54.000",
      "formatted_end": "00:56:56.000",
      "text": "ای پارکی پردرده"
    },
    {
      "id": 28,
      "start": 3420.0,
      "end": 3422.0,
      "formatted_start": "00:57:00.000",
      "formatted_end": "00:57:02.000",
      "text": "چند وقت گوشت اینطور شده؟"
    },
    {
      "id": 29,
      "start": 3422.0,
      "end": 3424.0,
      "formatted_start": "00:57:02.000",
      "formatted_end": "00:57:04.000",
      "text": "تقریبا یک ماه باشم"
    },
    {
      "id": 30,
      "start": 3424.0,
      "end": 3426.0,
      "formatted_start": "00:57:04.000",
      "formatted_end": "00:57:06.000",
      "text": "یک ماه، زرزه ندیده بود؟"
    },
    {
      "id": 31,
      "start": 3426.0,
      "end": 3428.0,
      "formatted_start": "00:57:06.000",
      "formatted_end": "00:57:08.000",
      "text": "نه بود، دیگه سر کار بودم"
    },
    {
      "id": 32,
      "start": 3428.0,
      "end": 3430.0,
      "formatted_start": "00:57:08.000",
      "formatted_end": "00:57:10.000",
      "text": "یک کم احساس درد کردم، تفانش دادم"
    },
    {
      "id": 33,
      "start": 3430.0,
      "end": 3432.0,
      "formatted_start": "00:57:10.000",
      "formatted_end": "00:57:12.000",
      "text": "با همه گوشت"
    },
    {
      "id": 34,
      "start": 3432.0,
      "end": 3434.0,
      "formatted_start": "00:57:12.000",
      "formatted_end": "00:57:14.000",
      "text": "اینگاه یک تشکرستی بود"
    },
    {
      "id": 35,
