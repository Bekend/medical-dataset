  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3302.0,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 3302.0,
      "end": 3304.0,
      "formatted_start": "00:55:02.000",
      "formatted_end": "00:55:04.000",
      "text": "در شبه هفته دیگه باید برداریم."
    },
    {
      "id": 2,
      "start": 3304.0,
      "end": 3306.0,
      "formatted_start": "00:55:04.000",
      "formatted_end": "00:55:06.000",
      "text": "ماشکلات خیلی خوب شده شده."
    },
    {
      "id": 3,
      "start": 3306.0,
      "end": 3308.0,
      "formatted_start": "00:55:06.000",
      "formatted_end": "00:55:08.000",
      "text": "خوب خدا را شده."
    },
    {
      "id": 4,
      "start": 3308.0,
      "end": 3312.0,
      "formatted_start": "00:55:08.000",
      "formatted_end": "00:55:12.000",
      "text": "بچه های من خودمون نیست که بخورند، اولی بچه ها میگن، میگن، حساس شدند، میگن نرستید."
    },
    {
      "id": 5,
      "start": 3312.0,
      "end": 3314.0,
      "formatted_start": "00:55:12.000",
      "formatted_end": "00:55:14.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 6,
      "start": 3314.0,
      "end": 3316.0,
      "formatted_start": "00:55:14.000",
      "formatted_end": "00:55:16.000",
      "text": "در شبه ها، ممنونم، دستشو ماشکلات."
    },
    {
      "id": 7,
      "start": 3316.0,
      "end": 3318.0,
      "formatted_start": "00:55:16.000",
      "formatted_end": "00:55:18.000",
      "text": "خدا را شده."
    },
    {
      "id": 8,
      "start": 3318.0,
      "end": 3320.0,
      "formatted_start": "00:55:18.000",
      "formatted_end": "00:55:20.000",
      "text": "سلام."
    },
    {
      "id": 9,
      "start": 3320.0,
      "end": 3328.0,
      "formatted_start": "00:55:20.000",
      "formatted_end": "00:55:28.000",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 3350.0,
      "end": 3380.0,
      "formatted_start": "00:55:50.000",
      "formatted_end": "00:56:20.000",
      "text": "از این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت"
