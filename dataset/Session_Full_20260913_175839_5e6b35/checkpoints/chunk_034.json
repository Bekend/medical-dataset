  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10202.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:02.000",
      "text": "این صرف دوست چار درم."
    },
    {
      "id": 1,
      "start": 10210.0,
      "end": 10212.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:12.000",
      "text": "این سه و شش ست داری."
    },
    {
      "id": 2,
      "start": 10212.0,
      "end": 10214.0,
      "formatted_start": "02:50:12.000",
      "formatted_end": "02:50:14.000",
      "text": "خواهان؟ چیکار کنی؟"
    },
    {
      "id": 3,
      "start": 10214.0,
      "end": 10218.0,
      "formatted_start": "02:50:14.000",
      "formatted_end": "02:50:18.000",
      "text": "دو مجانشو بگش، برقیش من و داروهای مادرم رو بیرون."
    },
    {
      "id": 4,
      "start": 10218.0,
      "end": 10220.0,
      "formatted_start": "02:50:18.000",
      "formatted_end": "02:50:20.000",
      "text": "نه، خواهان چون این شوید. من بعدم بیرون."
    },
    {
      "id": 5,
      "start": 10220.0,
      "end": 10222.0,
      "formatted_start": "02:50:20.000",
      "formatted_end": "02:50:22.000",
      "text": "من خود به عرق میخونم و دکتر..."
    },
    {
      "id": 6,
      "start": 10222.0,
      "end": 10225.0,
      "formatted_start": "02:50:22.000",
      "formatted_end": "02:50:25.000",
      "text": "میدونم دخترم، این چیزی نیست، این هشته من و خودشون."
    },
    {
      "id": 7,
      "start": 10225.0,
      "end": 10228.0,
      "formatted_start": "02:50:25.000",
      "formatted_end": "02:50:28.000",
      "text": "اون الان که شروع فردن به هشتون، اون چکوچونه رو زده."
    },
    {
      "id": 8,
      "start": 10228.0,
      "end": 10230.0,
      "formatted_start": "02:50:28.000",
      "formatted_end": "02:50:30.000",
      "text": "من باز می آفد"
    },
    {
      "id": 9,
      "start": 10230.0,
      "end": 10232.0,
      "formatted_start": "02:50:30.000",
      "formatted_end": "02:50:32.000",
      "text": "می دانم تو باز می آیی"
    },
    {
      "id": 10,
      "start": 10232.0,
      "end": 10234.0,
      "formatted_start": "02:50:32.000",
      "formatted_end": "02:50:34.000",
      "text": "اگر یکم بیمه هر بر باشیم"
    },
    {
      "id": 11,
      "start": 10234.0,
      "end": 10236.0,
      "formatted_start": "02:50:34.000",
      "formatted_end": "02:50:36.000",
      "text": "اون سخت باشه"
    },
    {
      "id": 12,
      "start": 10236.0,
      "end": 10238.0,
      "formatted_start": "02:50:36.000",
      "formatted_end": "02:50:38.000",
      "text": "های دوتا نه ترس"
    },
    {
      "id": 13,
      "start": 10238.0,
      "end": 10240.0,
      "formatted_start": "02:50:38.000",
      "formatted_end": "02:50:40.000",
      "text": "اگر من بیتر بشیم"
    },
    {
      "id": 14,
      "start": 10240.0,
      "end": 10242.0,
      "formatted_start": "02:50:40.000",
      "formatted_end": "02:50:42.000",
      "text": "من تاکر بیتر نوکنم که تو"
    },
    {
      "id": 15,
      "start": 10242.0,
      "end": 10244.0,
      "formatted_start": "02:50:42.000",
      "formatted_end": "02:50:44.000",
      "text": "بیایی"
    },
    {
      "id": 16,
      "start": 10244.0,
      "end": 10246.0,
      "formatted_start": "02:50:44.000",
      "formatted_end": "02:50:46.000",
      "text": "بیتر بشیم بردم"
    },
    {
      "id": 17,
      "start": 10246.0,
      "end": 10248.0,
      "formatted_start": "02:50:46.000",
      "formatted_end": "02:50:48.000",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 10248.0,
      "end": 10250.0,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:50.000",
      "text": "چند بود؟"
    },
    {
      "id": 19,
      "start": 10250.0,
      "end": 10252.0,
      "formatted_start": "02:50:50.000",
      "formatted_end": "02:50:52.000",
      "text": "24"
    },
    {
      "id": 20,
      "start": 10252.0,
      "end": 10254.0,
      "formatted_start": "02:50:52.000",
      "formatted_end": "02:50:54.000",
      "text": "24"
    },
    {
      "id": 21,
      "start": 10254.0,
      "end": 10256.0,
      "formatted_start": "02:50:54.000",
      "formatted_end": "02:50:56.000",
      "text": "اون یکی کارتو تم دید"
    },
    {
      "id": 22,
      "start": 10256.0,
      "end": 10260.0,
      "formatted_start": "02:50:56.000",
      "formatted_end": "02:51:00.000",
      "text": "این روشت های خالیه نه، اون روشت های کار کار هست"
    },
    {
      "id": 23,
      "start": 10260.0,
      "end": 10261.0,
      "formatted_start": "02:51:00.000",
      "formatted_end": "02:51:01.000",
      "text": "رهد هیچی نداره، حالا که..."
    },
    {
      "id": 24,
      "start": 10261.0,
      "end": 10264.0,
      "formatted_start": "02:51:01.000",
      "formatted_end": "02:51:04.000",
      "text": "خالیه، باید باید دوازی نداره"
    },
    {
      "id": 25,
      "start": 10264.0,
      "end": 10267.0,
      "formatted_start": "02:51:04.000",
      "formatted_end": "02:51:07.000",
      "text": "اقتصاد رو نمونی که نداریم باید باید برمون به این چیه؟"
    },
    {
      "id": 26,
      "start": 10267.0,
      "end": 10268.0,
      "formatted_start": "02:51:07.000",
      "formatted_end": "02:51:08.000",
      "text": "کشاورسیه"
    },
    {
      "id": 27,
      "start": 10268.0,
      "end": 10269.0,
      "formatted_start": "02:51:08.000",
      "formatted_end": "02:51:09.000",
      "text": "کشاورسیه، بله"
    },
    {
      "id": 28,
      "start": 10269.0,
      "end": 10271.0,
      "formatted_start": "02:51:09.000",
      "formatted_end": "02:51:11.000",
      "text": "اینی موجودی بودی، ببینیم ببینیم چی شد"
    },
    {
      "id": 29,
      "start": 10271.0,
      "end": 10274.0,
      "formatted_start": "02:51:11.000",
      "formatted_end": "02:51:14.000",
      "text": "شاید باشتیم شما"
    },
    {
      "id": 30,
      "start": 10282.0,
      "end": 10283.0,
      "formatted_start": "02:51:22.000",
      "formatted_end": "02:51:23.000",
      "text": "رهدشو میدونی؟"
    },
    {
      "id": 31,
      "start": 10283.0,
      "end": 10284.0,
      "formatted_start": "02:51:23.000",
      "formatted_end": "02:51:24.000",
      "text": "بله"
    },
    {
      "id": 32,
      "start": 10286.0,
      "end": 10288.0,
      "formatted_start": "02:51:26.000",
      "formatted_end": "02:51:28.000",
      "text": "نمزش؟"
    },
    {
      "id": 33,
      "start": 10288.0,
      "end": 10290.0,
      "formatted_start": "02:51:28.000",
      "formatted_end": "02:51:30.000",
      "text": "صرف ۱۴ همون"
    },
    {
      "id": 34,
      "start": 10290.0,
      "end": 10292.0,
      "formatted_start": "02:51:30.000",
      "formatted_end": "02:51:32.000",
      "text": "کارت هم همون همینه"
    },
    {
      "id": 35,
      "start": 10292.0,
      "end": 10294.0,
      "formatted_start": "02:51:32.000",
      "formatted_end": "02:51:34.000",
      "text": "شما ۱۶ همه تیمه بودش اینجا"
    },
    {
      "id": 36,
      "start": 10294.0,
      "end": 10296.0,
      "formatted_start": "02:51:34.000",
      "formatted_end": "02:51:36.000",
      "text": "اونها آخره کارتی بودید ها؟"
    },
    {
      "id": 37,
      "start": 10296.0,
      "end": 10298.0,
      "formatted_start": "02:51:36.000",
      "formatted_end": "02:51:38.000",
      "text": "نه شما"
    },
    {
      "id": 38,
      "start": 10298.0,
      "end": 10300.0,
      "formatted_start": "02:51:38.000",
      "formatted_end": "02:51:40.000",
      "text": "اونها چی در شما؟"
    },
    {
      "id": 39,
      "start": 10300.0,
      "end": 10302.0,
      "formatted_start": "02:51:40.000",
      "formatted_end": "02:51:42.000",
      "text": "۲۰ تا ۷۰ تا ۲۶۰ تا"
    },
    {
      "id": 40,
      "start": 10302.0,
      "end": 10304.0,
      "formatted_start": "02:51:42.000",
      "formatted_end": "02:51:44.000",
      "text": "نه دیگه نه"
    },
    {
      "id": 41,
      "start": 10304.0,
      "end": 10306.0,
      "formatted_start": "02:51:44.000",
      "formatted_end": "02:51:46.000",
      "text": "نه کم کم"
    },
    {
      "id": 42,
      "start": 10306.0,
      "end": 10308.0,
      "formatted_start": "02:51:46.000",
      "formatted_end": "02:51:48.000",
      "text": "من در تومن تیمه عادت دارم هم سر باشم"
    },
    {
      "id": 43,
      "start": 10308.0,
      "end": 10310.0,
      "formatted_start": "02:51:48.000",
      "formatted_end": "02:51:50.000",
      "text": "خواهدم ۲۰ تا ۱۰ تا"
    },
    {
      "id": 44,
      "start": 10310.0,
      "end": 10312.0,
      "formatted_start": "02:51:50.000",
      "formatted_end": "02:51:52.000",
      "text": "۲۰ تا همینم"
    },
    {
      "id": 45,
      "start": 10312.0,
      "end": 10314.0,
      "formatted_start": "02:51:52.000",
      "formatted_end": "02:51:54.000",
      "text": "از همه ۲۰۰ تا همینم"
    },
    {
      "id": 46,
      "start": 10314.0,
      "end": 10316.0,
      "formatted_start": "02:51:54.000",
      "formatted_end": "02:51:56.000",
      "text": "بیمه داری یا آزادی؟"
    },
    {
      "id": 47,
      "start": 10316.0,
      "end": 10318.0,
      "formatted_start": "02:51:56.000",
      "formatted_end": "02:51:58.000",
      "text": "بیمه همه، بیمه تمنیشت مایی"
    },
    {
      "id": 48,
      "start": 10318.0,
      "end": 10320.0,
      "formatted_start": "02:51:58.000",
      "formatted_end": "02:52:00.000",
      "text": "بیمه تمنیشت باید خودمونیتو بینیم سنو"
    },
    {
      "id": 49,
      "start": 10320.0,
      "end": 10324.0,
      "formatted_start": "02:52:00.000",
      "formatted_end": "02:52:04.000",
      "text": "و داروهای مادر همینی شد تو پروی خودم"
    },
    {
      "id": 50,
      "start": 10324.0,
      "end": 10328.0,
      "formatted_start": "02:52:04.000",
      "formatted_end": "02:52:08.000",
      "text": "اگه من بردید اینکه داروهایش کم بشه"
    },
    {
      "id": 51,
      "start": 10328.0,
      "end": 10332.0,
      "formatted_start": "02:52:08.000",
      "formatted_end": "02:52:12.000",
      "text": "بیمه سه، بیمه سه، سه، دوست دو، چهار دقیقا"
    },
    {
      "id": 52,
      "start": 10332.0,
      "end": 10336.16,
      "formatted_start": "02:52:12.000",
      "formatted_end": "02:52:16.160",
      "text": "از این چه تورنرزه که از این همه کشید که درست باشیم"
    },
    {
      "id": 53,
      "start": 10336.16,
      "end": 10337.88,
      "formatted_start": "02:52:16.160",
      "formatted_end": "02:52:17.880",
      "text": "ایمی چی داری تو؟"
    },
    {
      "id": 54,
      "start": 10337.88,
      "end": 10338.66,
      "formatted_start": "02:52:17.880",
      "formatted_end": "02:52:18.660",
      "text": "تمیز شمایی؟"
    },
    {
      "id": 55,
      "start": 10338.66,
      "end": 10339.5,
      "formatted_start": "02:52:18.660",
      "formatted_end": "02:52:19.500",
      "text": "تمیز شمایی دارم"
    },
    {
      "id": 56,
      "start": 10339.5,
      "end": 10349.46,
      "formatted_start": "02:52:19.500",
      "formatted_end": "02:52:29.460",
      "text": "بفرمون"
    },
    {
      "id": 57,
      "start": 10349.46,
      "end": 10350.66,
      "formatted_start": "02:52:29.460",
      "formatted_end": "02:52:30.660",
      "text": "بفرمون"
    },
    {
      "id": 58,
      "start": 10350.66,
      "end": 10351.92,
      "formatted_start": "02:52:30.660",
      "formatted_end": "02:52:31.920",
      "text": "جانم بفرمون"
    },
    {
      "id": 59,
      "start": 10351.92,
      "end": 10352.18,
      "formatted_start": "02:52:31.920",
      "formatted_end": "02:52:32.180",
      "text": "سلام"
    },
    {
      "id": 60,
      "start": 10352.18,
      "end": 10358.58,
      "formatted_start": "02:52:32.180",
      "formatted_end": "02:52:38.580",
      "text": "ای بابا"
    },
    {
      "id": 61,
      "start": 10362.0,
      "end": 10367.5,
      "formatted_start": "02:52:42.000",
      "formatted_end": "02:52:47.500",
      "text": "کدوم ها روشنه؟ بگو"
    },
    {
      "id": 62,
      "start": 10367.5,
      "end": 10371.82,
      "formatted_start": "02:52:47.500",
      "formatted_end": "02:52:51.820",
      "text": "نه کدوم ها روشنه"
    },
    {
      "id": 63,
      "start": 10371.82,
      "end": 10376.58,
      "formatted_start": "02:52:51.820",
      "formatted_end": "02:52:56.580",
      "text": "میدونم شننگی آخه سد"
    },
    {
      "id": 64,
      "start": 10376.58,
      "end": 10378.98,
      "formatted_start": "02:52:56.580",
      "formatted_end": "02:52:58.980",
      "text": "شننگی نوت روشنه"
    },
    {
      "id": 65,
      "start": 10378.98,
      "end": 10384.66,
      "formatted_start": "02:52:58.980",
      "formatted_end": "02:53:04.660",
      "text": "آهان اون یکی روشنه"
    },
    {
      "id": 66,
      "start": 10384.66,
      "end": 10387.82,
      "formatted_start": "02:53:04.660",
      "formatted_end": "02:53:07.820",
      "text": "خیلی خوب در اون منور رو باز کنید"
    },
    {
      "id": 67,
      "start": 10387.82,
      "end": 10391.54,
      "formatted_start": "02:53:07.820",
      "formatted_end": "02:53:11.540",
      "text": "بعد اونجا رو باز کنید"
    },
    {
      "id": 68,
      "start": 10391.54,
      "end": 10393.7,
      "formatted_start": "02:53:11.540",
      "formatted_end": "02:53:13.700",
      "text": "یه دونه دکمه سفید رنگ میبینید"
    },
    {
      "id": 69,
      "start": 10393.7,
      "end": 10394.84,
      "formatted_start": "02:53:13.700",
      "formatted_end": "02:53:14.840",
      "text": "آن و آفشه"
    },
    {
      "id": 70,
      "start": 10394.84,
      "end": 10396.34,
      "formatted_start": "02:53:14.840",
      "formatted_end": "02:53:16.340",
      "text": "بله بله"
    },
    {
      "id": 71,
      "start": 10396.34,
      "end": 10399.12,
      "formatted_start": "02:53:16.340",
      "formatted_end": "02:53:19.120",
      "text": "دیمار رو روانی دارید"
    },
    {
      "id": 72,
      "start": 10399.12,
      "end": 10400.66,
      "formatted_start": "02:53:19.120",
      "formatted_end": "02:53:20.660",
      "text": "باز کنید اون رو بزنید"
    },
    {
      "id": 73,
      "start": 10400.66,
      "end": 10401.82,
      "formatted_start": "02:53:20.660",
      "formatted_end": "02:53:21.820",
      "text": "آموشش کنید"
    },
    {
      "id": 74,
      "start": 10401.82,
      "end": 10405.82,
      "formatted_start": "02:53:21.820",
      "formatted_end": "02:53:25.820",
      "text": "آموش شد؟"
    },
    {
      "id": 75,
      "start": 10407.64,
      "end": 10411.82,
      "formatted_start": "02:53:27.640",
      "formatted_end": "02:53:31.820",
      "text": "آره؟"
    },
    {
      "id": 76,
      "start": 10413.16,
      "end": 10414.82,
      "formatted_start": "02:53:33.160",
      "formatted_end": "02:53:34.820",
      "text": "آره کسی اون رو زده بوده"
    },
    {
      "id": 77,
      "start": 10415.48,
      "end": 10416.82,
      "formatted_start": "02:53:35.480",
      "formatted_end": "02:53:36.820",
      "text": "کسی اون رو زده بوده"
    },
    {
      "id": 78,
      "start": 10417.82,
      "end": 10420.82,
      "formatted_start": "02:53:37.820",
      "formatted_end": "02:53:40.820",
      "text": "جان؟"
    },
    {
      "id": 79,
      "start": 10420.82,
      "end": 10425.82,
      "formatted_start": "02:53:40.820",
      "formatted_end": "02:53:45.820",
      "text": "نه اصلا اصلا اصلا"
    },
    {
      "id": 80,
      "start": 10425.82,
      "end": 10430.82,
      "formatted_start": "02:53:45.820",
      "formatted_end": "02:53:50.820",
      "text": "برق رفته آمده یه کسی به احتمالا اونو دستگاهی میکرده"
    },
    {
      "id": 81,
      "start": 10430.82,
      "end": 10434.82,
      "formatted_start": "02:53:50.820",
      "formatted_end": "02:53:54.820",
      "text": "حالا بله"
    },
    {
      "id": 82,
      "start": 10434.82,
      "end": 10437.82,
      "formatted_start": "02:53:54.820",
      "formatted_end": "02:53:57.820",
      "text": "خداحافظ شما"
    },
    {
      "id": 83,
      "start": 10437.82,
      "end": 10439.82,
      "formatted_start": "02:53:57.820",
      "formatted_end": "02:53:59.820",
      "text": "خداحافظ شما"
    },
    {
      "id": 84,
      "start": 10447.82,
      "end": 10451.82,
      "formatted_start": "02:54:07.820",
      "formatted_end": "02:54:11.820",
      "text": "اما رای بعد هستم؟"
    },
    {
      "id": 85,
      "start": 10451.82,
      "end": 10455.82,
      "formatted_start": "02:54:11.820",
      "formatted_end": "02:54:15.820",
      "text": "این چهره تومن هم نداره"
    },
    {
      "id": 86,
      "start": 10455.82,
      "end": 10459.82,
      "formatted_start": "02:54:15.820",
      "formatted_end": "02:54:19.820",
      "text": "این چهره تومن خواهد که اون ویزیته را تلپار نباشی"
    },
    {
      "id": 87,
      "start": 10459.82,
      "end": 10463.82,
      "formatted_start": "02:54:19.820",
      "formatted_end": "02:54:23.820",
      "text": "این میشه"
    },
    {
      "id": 88,
      "start": 10463.82,
      "end": 10467.82,
      "formatted_start": "02:54:23.820",
      "formatted_end": "02:54:27.820",
      "text": "این داشته میشه چهره تومن"
    },
    {
      "id": 89,
      "start": 10467.82,
      "end": 10471.82,
      "formatted_start": "02:54:27.820",
      "formatted_end": "02:54:31.820",
      "text": "داشته میشه چهره تومن"
    },
    {
      "id": 90,
      "start": 10471.82,
      "end": 10475.82,
      "formatted_start": "02:54:31.820",
      "formatted_end": "02:54:35.820",
      "text": "داشته"
    },
    {
      "id": 91,
      "start": 10475.82,
      "end": 10481.82,
      "formatted_start": "02:54:35.820",
      "formatted_end": "02:54:41.820",
      "text": "از این همه بیمتر را برای شما بیمتر کنید."
    },
    {
      "id": 92,
      "start": 10481.82,
      "end": 10485.82,
      "formatted_start": "02:54:41.820",
      "formatted_end": "02:54:45.820",
      "text": "از این همه بیمتر را برای شما برای شما برای شما بیمتر کنید."
    },
    {
      "id": 93,
      "start": 10485.82,
      "end": 10487.82,
      "formatted_start": "02:54:45.820",
      "formatted_end": "02:54:47.820",
      "text": "کسی میتونه بیرون دخترم؟"
    },
    {
      "id": 94,
      "start": 10487.82,
      "end": 10489.82,
      "formatted_start": "02:54:47.820",
      "formatted_end": "02:54:49.820",
      "text": "نجم و آسیمی"
    },
    {
      "id": 95,
      "start": 10489.82,
      "end": 10491.82,
      "formatted_start": "02:54:49.820",
      "formatted_end": "02:54:51.820",
      "text": "آسیمی، کدومی؟"
    },
    {
      "id": 96,
      "start": 10491.82,
      "end": 10493.82,
      "formatted_start": "02:54:51.820",
      "formatted_end": "02:54:53.820",
      "text": "520"
    },
    {
      "id": 97,
      "start": 10493.82,
      "end": 10495.82,
      "formatted_start": "02:54:53.820",
      "formatted_end": "02:54:55.820",
      "text": "970"
    },
    {
      "id": 98,
      "start": 10495.82,
      "end": 10497.82,
      "formatted_start": "02:54:55.820",
      "formatted_end": "02:54:57.820",
      "text": "380"
    },
    {
      "id": 99,
      "start": 10497.82,
      "end": 10499.82,
      "formatted_start": "02:54:57.820",
      "formatted_end": "02:54:59.820",
      "text": "380، 8000"
    }
  ],
  "status": "completed"
}