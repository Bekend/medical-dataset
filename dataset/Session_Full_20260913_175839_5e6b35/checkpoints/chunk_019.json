  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5709.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:09.000",
      "text": "از این ازاده، میشه سه روز. اینجا یاد بگیرین نمیشه. بله، باید دیگه یه روز اضافه تر باید بگیر از مایی که تو ذهنتونه."
    },
    {
      "id": 1,
      "start": 5709.0,
      "end": 5714.0,
      "formatted_start": "01:35:09.000",
      "formatted_end": "01:35:14.000",
      "text": "حالا از پای روز تا حالا چند روزه؟ با همینگرد دو روزه نیست. درسته؟"
    },
    {
      "id": 2,
      "start": 5714.0,
      "end": 5719.0,
      "formatted_start": "01:35:14.000",
      "formatted_end": "01:35:19.000",
      "text": "ولی چون پای روز خودش هم حسابه، میشه سه روز."
    },
    {
      "id": 3,
      "start": 5719.0,
      "end": 5722.0,
      "formatted_start": "01:35:19.000",
      "formatted_end": "01:35:22.000",
      "text": "از صبح شد، مزن هم حسابی کرده."
    },
    {
      "id": 4,
      "start": 5722.0,
      "end": 5726.68,
      "formatted_start": "01:35:22.000",
      "formatted_end": "01:35:26.680",
      "text": "خودش هم پست این روز هم هست، امروز هم پست، امروز میشه روز سه بام تا"
    },
    {
      "id": 5,
      "start": 5726.68,
      "end": 5730.42,
      "formatted_start": "01:35:26.680",
      "formatted_end": "01:35:30.420",
      "text": "به این شکل تقریبا زنان اینجوری حساب میشه"
    },
    {
      "id": 6,
      "start": 5730.42,
      "end": 5734.6,
      "formatted_start": "01:35:30.420",
      "formatted_end": "01:35:34.600",
      "text": "الان ۲۵۵ شروع شده، ماه پیش ۲۳ شروع شده بود"
    },
    {
      "id": 7,
      "start": 5734.6,
      "end": 5737.2,
      "formatted_start": "01:35:34.600",
      "formatted_end": "01:35:37.200",
      "text": "پس ماه پیش خیلی کمه درد شدید داشتم"
    },
    {
      "id": 8,
      "start": 5737.2,
      "end": 5741.0,
      "formatted_start": "01:35:37.200",
      "formatted_end": "01:35:41.000",
      "text": "به حدی اینکه زنگزم، به ماشیتونم زنگزم"
    },
    {
      "id": 9,
      "start": 5741.0,
      "end": 5746.66,
      "formatted_start": "01:35:41.000",
      "formatted_end": "01:35:46.660",
      "text": "یعنی قبل از اینکه از اینجور رفتم، بعدش خیلی کمه درد شدم که شیاب اینا روشته بودیم"
    },
    {
      "id": 10,
      "start": 5746.66,
      "end": 5747.36,
      "formatted_start": "01:35:46.660",
      "formatted_end": "01:35:47.360",
      "text": "آقایی"
    },
    {
      "id": 11,
      "start": 5747.36,
      "end": 5751.36,
      "formatted_start": "01:35:47.360",
      "formatted_end": "01:35:51.360",
      "text": "استفاده کردم بعد همون پومود ماشین ها رو دیداده بودی"
    },
    {
      "id": 12,
      "start": 5751.36,
      "end": 5756.36,
      "formatted_start": "01:35:51.360",
      "formatted_end": "01:35:56.360",
      "text": "اونا هم استفاده کردم گم شد از اوکیمنتی که کم درده ازو لگه همون پیرده ازو باره"
    },
    {
      "id": 13,
      "start": 5756.36,
      "end": 5757.36,
      "formatted_start": "01:35:56.360",
      "formatted_end": "01:35:57.360",
      "text": "بله الان درد خود چه کنی؟"
    },
    {
      "id": 14,
      "start": 5757.36,
      "end": 5758.36,
      "formatted_start": "01:35:57.360",
      "formatted_end": "01:35:58.360",
      "text": "الان کمتر"
    },
    {
      "id": 15,
      "start": 5758.36,
      "end": 5760.36,
      "formatted_start": "01:35:58.360",
      "formatted_end": "01:36:00.360",
      "text": "درد کمتر"
    },
    {
      "id": 16,
      "start": 5760.36,
      "end": 5765.36,
      "formatted_start": "01:36:00.360",
      "formatted_end": "01:36:05.360",
      "text": "چه کم هم درد بشتی؟ که برای من نمیدونیم"
    },
    {
      "id": 17,
      "start": 5765.36,
      "end": 5766.36,
      "formatted_start": "01:36:05.360",
      "formatted_end": "01:36:06.360",
      "text": "سی زمان بشت کم"
    },
    {
      "id": 18,
      "start": 5766.36,
      "end": 5769.36,
      "formatted_start": "01:36:06.360",
      "formatted_end": "01:36:09.360",
      "text": "اینوانه بسیار خواهی میشون"
    },
    {
      "id": 19,
      "start": 5769.36,
      "end": 5770.36,
      "formatted_start": "01:36:09.360",
      "formatted_end": "01:36:10.360",
      "text": "بله بسیار خواهی میشون"
    },
    {
      "id": 20,
      "start": 5770.36,
      "end": 5771.36,
      "formatted_start": "01:36:10.360",
      "formatted_end": "01:36:11.360",
      "text": "درد"
    },
    {
      "id": 21,
      "start": 5771.36,
      "end": 5775.36,
      "formatted_start": "01:36:11.360",
      "formatted_end": "01:36:15.360",
      "text": "خب اینو تا درد کمتر، درد سینه چی؟"
    },
    {
      "id": 22,
      "start": 5775.36,
      "end": 5777.36,
      "formatted_start": "01:36:15.360",
      "formatted_end": "01:36:17.360",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 5777.36,
      "end": 5779.36,
      "formatted_start": "01:36:17.360",
      "formatted_end": "01:36:19.360",
      "text": "بسیار بیشتر"
    },
    {
      "id": 24,
      "start": 5779.36,
      "end": 5781.36,
      "formatted_start": "01:36:19.360",
      "formatted_end": "01:36:21.360",
      "text": "پشار میده ام"
    },
    {
      "id": 25,
      "start": 5781.36,
      "end": 5783.36,
      "formatted_start": "01:36:21.360",
      "formatted_end": "01:36:23.360",
      "text": "پشار میده ام"
    },
    {
      "id": 26,
      "start": 5783.36,
      "end": 5785.36,
      "formatted_start": "01:36:23.360",
      "formatted_end": "01:36:25.360",
      "text": "با فشار"
    },
    {
      "id": 27,
      "start": 5785.36,
      "end": 5787.36,
      "formatted_start": "01:36:25.360",
      "formatted_end": "01:36:27.360",
      "text": "تکرارش نکردید"
    },
    {
      "id": 28,
      "start": 5787.36,
      "end": 5789.36,
      "formatted_start": "01:36:27.360",
      "formatted_end": "01:36:29.360",
      "text": "با فشار"
    },
    {
      "id": 29,
      "start": 5789.36,
      "end": 5791.36,
      "formatted_start": "01:36:29.360",
      "formatted_end": "01:36:31.360",
      "text": "گالاکتوره"
    },
    {
      "id": 30,
      "start": 5791.36,
      "end": 5793.36,
      "formatted_start": "01:36:31.360",
      "formatted_end": "01:36:33.360",
      "text": "عادت خورداتونم 23"
    },
    {
      "id": 31,
      "start": 5793.36,
      "end": 5795.36,
      "formatted_start": "01:36:33.360",
      "formatted_end": "01:36:35.360",
      "text": "تیلتونم 23"
    },
    {
      "id": 32,
      "start": 5795.36,
      "end": 5797.36,
      "formatted_start": "01:36:35.360",
      "formatted_end": "01:36:37.360",
      "text": "حالا 25 شده"
    },
    {
      "id": 33,
      "start": 5797.36,
      "end": 5799.36,
      "formatted_start": "01:36:37.360",
      "formatted_end": "01:36:39.360",
      "text": "شما که مثلا"
    },
    {
      "id": 34,
      "start": 5799.36,
      "end": 5801.36,
      "formatted_start": "01:36:39.360",
      "formatted_end": "01:36:41.360",
      "text": "ما 23 روش شده بودید"
    },
    {
      "id": 35,
      "start": 5801.36,
      "end": 5803.36,
      "formatted_start": "01:36:41.360",
      "formatted_end": "01:36:43.360",
      "text": "بهتر این ماه 20 تون بشدید"
    },
    {
      "id": 36,
      "start": 5803.36,
      "end": 5808.74,
      "formatted_start": "01:36:43.360",
      "formatted_end": "01:36:48.740",
      "text": "بیستون میشونیم درستش اینه چون بیست سه روز که میشه سی و دو روز"
    },
    {
      "id": 37,
      "start": 5808.74,
      "end": 5811.24,
      "formatted_start": "01:36:48.740",
      "formatted_end": "01:36:51.240",
      "text": "بیست و دو روز میشه سی و یک روز"
    },
    {
      "id": 38,
      "start": 5811.24,
      "end": 5814.02,
      "formatted_start": "01:36:51.240",
      "formatted_end": "01:36:54.020",
      "text": "بیست و یک روز میشه سی روز"
    },
    {
      "id": 39,
      "start": 5814.02,
      "end": 5817.0,
      "formatted_start": "01:36:54.020",
      "formatted_end": "01:36:57.000",
      "text": "درسته بیست و یک روز سی روز"
    },
    {
      "id": 40,
      "start": 5817.0,
      "end": 5819.16,
      "formatted_start": "01:36:57.000",
      "formatted_end": "01:36:59.160",
      "text": "بیستون بیست و نه روز بوده"
    },
    {
      "id": 41,
      "start": 5819.16,
      "end": 5820.98,
      "formatted_start": "01:36:59.160",
      "formatted_end": "01:37:00.980",
      "text": "بیستون بهتر این حالت"
    },
    {
      "id": 42,
      "start": 5820.98,
      "end": 5823.08,
      "formatted_start": "01:37:00.980",
      "formatted_end": "01:37:03.080",
      "text": "بیست و نه روز بیست و هشت روز"
    },
    {
      "id": 43,
      "start": 5823.08,
      "end": 5824.26,
      "formatted_start": "01:37:03.080",
      "formatted_end": "01:37:04.260",
      "text": "اینجوری خوبه"
    },
    {
      "id": 44,
      "start": 5824.26,
      "end": 5827.36,
      "formatted_start": "01:37:04.260",
      "formatted_end": "01:37:07.360",
      "text": "هرچه از این عقب تربیلی"
    },
    {
      "id": 45,
      "start": 5827.36,
      "end": 5830.14,
      "formatted_start": "01:37:07.360",
      "formatted_end": "01:37:10.140",
      "text": "در قانون نابار بریم"
    },
    {
      "id": 46,
      "start": 5830.14,
      "end": 5831.68,
      "formatted_start": "01:37:10.140",
      "formatted_end": "01:37:11.680",
      "text": "هرچه عادت دیرتر باشه"
    },
    {
      "id": 47,
      "start": 5831.68,
      "end": 5833.36,
      "formatted_start": "01:37:11.680",
      "formatted_end": "01:37:13.360",
      "text": "امکان بارداری کم میشه"
    },
    {
      "id": 48,
      "start": 5833.36,
      "end": 5834.46,
      "formatted_start": "01:37:13.360",
      "formatted_end": "01:37:14.460",
      "text": "امکان بیشتر دیگه تر میشه"
    },
    {
      "id": 49,
      "start": 5834.46,
      "end": 5835.1,
      "formatted_start": "01:37:14.460",
      "formatted_end": "01:37:15.100",
      "text": "اما زود نمیشه"
    },
    {
      "id": 50,
      "start": 5835.1,
      "end": 5835.54,
      "formatted_start": "01:37:15.100",
      "formatted_end": "01:37:15.540",
      "text": "آره"
    },
    {
      "id": 51,
      "start": 5835.54,
      "end": 5836.54,
      "formatted_start": "01:37:15.540",
      "formatted_end": "01:37:16.540",
      "text": "زودتر باشه"
    },
    {
      "id": 52,
      "start": 5836.54,
      "end": 5838.42,
      "formatted_start": "01:37:16.540",
      "formatted_end": "01:37:18.420",
      "text": "امکان بارداری بیشتر میشه"
    },
    {
      "id": 53,
      "start": 5838.42,
      "end": 5840.24,
      "formatted_start": "01:37:18.420",
      "formatted_end": "01:37:20.240",
      "text": "اونایی که زودتر میشه"
    },
    {
      "id": 54,
      "start": 5840.24,
      "end": 5841.34,
      "formatted_start": "01:37:20.240",
      "formatted_end": "01:37:21.340",
      "text": "دیگه اینجا نمیان دیگه"
    },
    {
      "id": 55,
      "start": 5841.34,
      "end": 5842.68,
      "formatted_start": "01:37:21.340",
      "formatted_end": "01:37:22.680",
      "text": "اونا خبشون باردار میشه"
    },
    {
      "id": 56,
      "start": 5842.68,
      "end": 5844.4,
      "formatted_start": "01:37:22.680",
      "formatted_end": "01:37:24.400",
      "text": "اونایی که اقب میفته"
    },
    {
      "id": 57,
      "start": 5844.4,
      "end": 5846.02,
      "formatted_start": "01:37:24.400",
      "formatted_end": "01:37:26.020",
      "text": "باردارشونم اقب میفته"
    },
    {
      "id": 58,
      "start": 5846.02,
      "end": 5848.32,
      "formatted_start": "01:37:26.020",
      "formatted_end": "01:37:28.320",
      "text": "خیلی خوب"
    },
    {
      "id": 59,
      "start": 5848.32,
      "end": 5849.7,
      "formatted_start": "01:37:28.320",
      "formatted_end": "01:37:29.700",
      "text": "باید باید کنیم"
    },
    {
      "id": 60,
      "start": 5849.7,
      "end": 5851.34,
      "formatted_start": "01:37:29.700",
      "formatted_end": "01:37:31.340",
      "text": "رو تخت راست میکشیم"
    },
    {
      "id": 61,
      "start": 5861.68,
      "end": 5863.68,
      "formatted_start": "01:37:41.680",
      "formatted_end": "01:37:43.680",
      "text": "از اینجا باید باید برداریم"
    },
    {
      "id": 62,
      "start": 5863.68,
      "end": 5865.68,
      "formatted_start": "01:37:43.680",
      "formatted_end": "01:37:45.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 63,
      "start": 5865.68,
      "end": 5867.68,
      "formatted_start": "01:37:45.680",
      "formatted_end": "01:37:47.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 64,
      "start": 5867.68,
      "end": 5869.68,
      "formatted_start": "01:37:47.680",
      "formatted_end": "01:37:49.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 65,
      "start": 5869.68,
      "end": 5871.68,
      "formatted_start": "01:37:49.680",
      "formatted_end": "01:37:51.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 66,
      "start": 5871.68,
      "end": 5873.68,
      "formatted_start": "01:37:51.680",
      "formatted_end": "01:37:53.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 67,
      "start": 5873.68,
      "end": 5875.68,
      "formatted_start": "01:37:53.680",
      "formatted_end": "01:37:55.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 68,
      "start": 5875.68,
      "end": 5877.68,
      "formatted_start": "01:37:55.680",
      "formatted_end": "01:37:57.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 69,
      "start": 5877.68,
      "end": 5879.68,
      "formatted_start": "01:37:57.680",
      "formatted_end": "01:37:59.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 70,
      "start": 5879.68,
      "end": 5881.68,
      "formatted_start": "01:37:59.680",
      "formatted_end": "01:38:01.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 71,
      "start": 5881.68,
      "end": 5883.68,
      "formatted_start": "01:38:01.680",
      "formatted_end": "01:38:03.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 72,
      "start": 5883.68,
      "end": 5885.68,
      "formatted_start": "01:38:03.680",
      "formatted_end": "01:38:05.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 73,
      "start": 5885.68,
      "end": 5887.68,
      "formatted_start": "01:38:05.680",
      "formatted_end": "01:38:07.680",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 74,
      "start": 5887.68,
      "end": 5891.68,
      "formatted_start": "01:38:07.680",
      "formatted_end": "01:38:11.680",
      "text": "از این اشاره می دهند کاناشون محبت اونو می توانی جمع"
    },
    {
      "id": 75,
      "start": 5891.68,
      "end": 5894.68,
      "formatted_start": "01:38:11.680",
      "formatted_end": "01:38:14.680",
      "text": "چند باری نداری؟"
    },
    {
      "id": 76,
      "start": 5894.68,
      "end": 5896.68,
      "formatted_start": "01:38:14.680",
      "formatted_end": "01:38:16.680",
      "text": "آزانی بود نه"
    },
    {
      "id": 77,
      "start": 5896.68,
      "end": 5899.68,
      "formatted_start": "01:38:16.680",
      "formatted_end": "01:38:19.680",
      "text": "دوباره جمع خواهید؟"
    },
    {
      "id": 78,
      "start": 5899.68,
      "end": 5900.68,
      "formatted_start": "01:38:19.680",
      "formatted_end": "01:38:20.680",
      "text": "نه"
    },
    {
      "id": 79,
      "start": 5900.68,
      "end": 5906.68,
      "formatted_start": "01:38:20.680",
      "formatted_end": "01:38:26.680",
      "text": "راهم تقریبا هجمش خالی شده و خون سیادی زخیله نکرده بوده"
    },
    {
      "id": 80,
      "start": 5906.68,
      "end": 5910.68,
      "formatted_start": "01:38:26.680",
      "formatted_end": "01:38:30.680",
      "text": "باید این راهم خون را زخیله بکنه تو دیوارت"
    },
    {
      "id": 81,
      "start": 5910.68,
      "end": 5916.68,
      "formatted_start": "01:38:30.680",
      "formatted_end": "01:38:36.680",
      "text": "که باروالی روختان راهم اول جنین اول از اون خون تغذیه میکنه"
    },
    {
      "id": 82,
      "start": 5916.68,
      "end": 5924.68,
      "formatted_start": "01:38:36.680",
      "formatted_end": "01:38:44.680",
      "text": "بعدا به بندناف تشکیل میشه و از اون مادر سیاره بی کنیم"
    },
    {
      "id": 83,
      "start": 5924.68,
      "end": 5932.68,
      "formatted_start": "01:38:44.680",
      "formatted_end": "01:38:52.680",
      "text": "این کام بوده استرس بی خوابی نداشته باشید"
    },
    {
      "id": 84,
      "start": 5932.68,
      "end": 5937.68,
      "formatted_start": "01:38:52.680",
      "formatted_end": "01:38:57.680",
      "text": "شخصیت زنهایی که براحتی باردار میشن و اگه نگاه بکنیم"
    },
    {
      "id": 85,
      "start": 5937.68,
      "end": 5943.68,
      "formatted_start": "01:38:57.680",
      "formatted_end": "01:39:03.680",
      "text": "زن تو همسایاتون همسایه های مامانتون میبینید که یه اده زنها هستند زیرا بچه دارند"
    },
    {
      "id": 86,
      "start": 5943.68,
      "end": 5956.52,
      "formatted_start": "01:39:03.680",
      "formatted_end": "01:39:16.520",
      "text": "همه اش بچه دارن. شخصیتشون رو میگو میکنید بیخیارن، شبزود میخوابن، روزیات میخندا، بیارن، دیدی اونجوری زنها رو دیدی دیگه؟"
    },
    {
      "id": 87,
      "start": 5956.52,
      "end": 5958.52,
      "formatted_start": "01:39:16.520",
      "formatted_end": "01:39:18.520",
      "text": "پش پش پش میخنندن بیارند"
    },
    {
      "id": 88,
      "start": 5958.52,
      "end": 5961.52,
      "formatted_start": "01:39:18.520",
      "formatted_end": "01:39:21.520",
      "text": "همین گری هم که میپنند باز میخنندن توش"
    },
    {
      "id": 89,
      "start": 5961.52,
      "end": 5967.52,
      "formatted_start": "01:39:21.520",
      "formatted_end": "01:39:27.520",
      "text": "آه جدی نیستند همین مسائلشون رو سرسری میگیرند"
    },
    {
      "id": 90,
      "start": 5967.52,
      "end": 5969.52,
      "formatted_start": "01:39:27.520",
      "formatted_end": "01:39:29.520",
      "text": "تا این حساب نیستیم"
    },
    {
      "id": 91,
      "start": 5969.52,
      "end": 5971.52,
      "formatted_start": "01:39:29.520",
      "formatted_end": "01:39:31.520",
      "text": "حس کیمی عمیق ندارند"
    },
    {
      "id": 92,
      "start": 5971.52,
      "end": 5976.52,
      "formatted_start": "01:39:31.520",
      "formatted_end": "01:39:36.520",
      "text": "زود فراموش میکنند و سطحی نگر هستند"
    },
    {
      "id": 93,
      "start": 5976.52,
      "end": 5981.52,
      "formatted_start": "01:39:36.520",
      "formatted_end": "01:39:41.520",
      "text": "اونایی که عمیقند، دقیقند، دانشمندند، دکترند، مهندسند، اصلا بچه دارند"
    },
    {
      "id": 94,
      "start": 5981.52,
      "end": 5990.52,
      "formatted_start": "01:39:41.520",
      "formatted_end": "01:39:50.520",
      "text": "خیلی به این کار رو هستن، مثلا دارده که یک خانه مهندسی مثلا هشت رو بچه داشته شده ندارده که یک در یک نشان شده"
    },
    {
      "id": 95,
      "start": 5990.52,
      "end": 5993.52,
      "formatted_start": "01:39:50.520",
      "formatted_end": "01:39:53.520",
      "text": "منعکرون هم با درت و دکتر رو رفته اید"
    },
    {
      "id": 96,
      "start": 5993.52,
      "end": 5996.52,
      "formatted_start": "01:39:53.520",
      "formatted_end": "01:39:56.520",
      "text": "چون اون نوع شخصیت خیلی دخالت میکنه"
    },
    {
      "id": 97,
      "start": 5996.52,
      "end": 5999.52,
      "formatted_start": "01:39:56.520",
      "formatted_end": "01:39:59.520",
      "text": "مقدار خانه های دیگه هم با حرس جوش"
    }
  ],
  "status": "completed"
}