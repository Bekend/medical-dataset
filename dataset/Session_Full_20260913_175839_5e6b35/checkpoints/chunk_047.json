      "end": 14218.56,
      "formatted_start": "03:56:56.560",
      "formatted_end": "03:56:58.560",
      "text": "در فراموش نگفتم"
    },
    {
      "id": 45,
      "start": 14218.56,
      "end": 14220.56,
      "formatted_start": "03:56:58.560",
      "formatted_end": "03:57:00.560",
      "text": "گفتم اگه مثلا در این درده"
    },
    {
      "id": 46,
      "start": 14220.56,
      "end": 14222.56,
      "formatted_start": "03:57:00.560",
      "formatted_end": "03:57:02.560",
      "text": "خفه میشه مثلا"
    },
    {
      "id": 47,
      "start": 14222.56,
      "end": 14226.56,
      "formatted_start": "03:57:02.560",
      "formatted_end": "03:57:06.560",
      "text": "اینکه چیزان مشترین یه روش که نه که خودتی بیماری کنه"
    },
    {
