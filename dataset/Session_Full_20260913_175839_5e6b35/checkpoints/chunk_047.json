      "formatted_start": "03:56:36.560",
      "formatted_end": "03:56:38.560",
      "text": "من چیزی نمیخواهم"
    },
    {
      "id": 35,
      "start": 14198.56,
      "end": 14200.56,
      "formatted_start": "03:56:38.560",
      "formatted_end": "03:56:40.560",
      "text": "این خویش"
    },
    {
      "id": 36,
      "start": 14200.56,
      "end": 14202.56,
      "formatted_start": "03:56:40.560",
      "formatted_end": "03:56:42.560",
      "text": "همجور همی خواهد نداره"
