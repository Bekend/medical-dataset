  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14107.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:07.000",
      "text": "خیلی خیلی، چون هزار دیشتر داریم، شغل همین کار رو بگیرم."
    },
    {
      "id": 1,
      "start": 14107.0,
      "end": 14123.0,
      "formatted_start": "03:55:07.000",
      "formatted_end": "03:55:23.000",
      "text": "دفترشه ۱۳۳۰۰، یک بار رو بگیرم، یک بار رو بگیرم، باشیم، من هم بادر شده، باب همینه دور باشیم، گفته باید بگیرم، چون آدم میخواهش."
    },
    {
      "id": 2,
      "start": 14123.0,
      "end": 14127.28,
      "formatted_start": "03:55:23.000",
      "formatted_end": "03:55:27.280",
      "text": "اینجا باید نگهشش رو پیشی شما میاد"
    },
    {
      "id": 3,
      "start": 14127.28,
      "end": 14131.56,
      "formatted_start": "03:55:27.280",
      "formatted_end": "03:55:31.560",
      "text": "خب بگیر اگه مادرش هم خواهد نداره"
    },
    {
      "id": 4,
      "start": 14131.56,
      "end": 14138.56,
      "formatted_start": "03:55:31.560",
      "formatted_end": "03:55:38.560",
      "text": "قبل اینجا، از شارعه براش این خونه دیگه بگیرند و از درست مادرش بگیرند."
    },
    {
      "id": 5,
      "start": 14138.56,
      "end": 14140.56,
      "formatted_start": "03:55:38.560",
      "formatted_end": "03:55:40.560",
      "text": "چه بگیرند؟"
    },
    {
      "id": 6,
      "start": 14140.56,
      "end": 14142.56,
      "formatted_start": "03:55:40.560",
      "formatted_end": "03:55:42.560",
      "text": "با با من، با درست مادرش بگیرند."
    },
    {
      "id": 7,
      "start": 14142.56,
      "end": 14144.56,
      "formatted_start": "03:55:42.560",
      "formatted_end": "03:55:44.560",
      "text": "با درست مادرش بگیرند؟"
    },
    {
      "id": 8,
      "start": 14144.56,
      "end": 14146.56,
      "formatted_start": "03:55:44.560",
      "formatted_end": "03:55:46.560",
      "text": "میبینی که دیگه بیرون"
    },
    {
      "id": 9,
      "start": 14146.56,
      "end": 14148.56,
      "formatted_start": "03:55:46.560",
      "formatted_end": "03:55:48.560",
      "text": "تو مادرش باید میده که این بیرون دیگه"
    },
    {
      "id": 10,
      "start": 14148.56,
      "end": 14150.56,
      "formatted_start": "03:55:48.560",
      "formatted_end": "03:55:50.560",
      "text": "بیرون برن"
    },
    {
      "id": 11,
      "start": 14150.56,
      "end": 14152.56,
      "formatted_start": "03:55:50.560",
      "formatted_end": "03:55:52.560",
      "text": "بچه بیرون کرده"
    },
    {
      "id": 12,
      "start": 14152.56,
      "end": 14154.56,
      "formatted_start": "03:55:52.560",
      "formatted_end": "03:55:54.560",
      "text": "بیرون برن"
    },
    {
      "id": 13,
      "start": 14154.56,
      "end": 14156.56,
      "formatted_start": "03:55:54.560",
      "formatted_end": "03:55:56.560",
      "text": "برن نگردش"
    },
    {
      "id": 14,
      "start": 14156.56,
      "end": 14158.56,
      "formatted_start": "03:55:56.560",
      "formatted_end": "03:55:58.560",
      "text": "بیرون بچه بیرون درش نگرد"
    },
    {
      "id": 15,
      "start": 14158.56,
      "end": 14160.56,
      "formatted_start": "03:55:58.560",
      "formatted_end": "03:56:00.560",
