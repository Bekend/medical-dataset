      "start": 4874.0,
      "end": 4877.0,
      "formatted_start": "01:21:14.000",
      "formatted_end": "01:21:17.000",
      "text": "این ازمایی ناشی از مخلوقت زنها نیست"
    },
    {
      "id": 27,
      "start": 4877.0,
      "end": 4878.0,
      "formatted_start": "01:21:17.000",
      "formatted_end": "01:21:18.000",
      "text": "آه هم شرکت شد"
    },
    {
      "id": 28,
      "start": 4878.0,
      "end": 4880.0,
      "formatted_start": "01:21:18.000",
      "formatted_end": "01:21:20.000",
      "text": "پوست کشه"
    },
    {
      "id": 29,
      "start": 4880.0,
      "end": 4883.0,
      "formatted_start": "01:21:20.000",
      "formatted_end": "01:21:23.000",
      "text": "انا شیر خانومتون باید یک نسخه اترون بیدم"
    },
    {
      "id": 30,
      "start": 4883.0,
      "end": 4885.0,
      "formatted_start": "01:21:23.000",
      "formatted_end": "01:21:25.000",
      "text": "یک نسخه هم برای خانومتون بیدم"
    },
    {
      "id": 31,
      "start": 4885.0,
      "end": 4886.0,
      "formatted_start": "01:21:25.000",
      "formatted_end": "01:21:26.000",
      "text": "سرمار خانوم بیده نمیشه"
    },
    {
      "id": 32,
      "start": 4886.0,
      "end": 4889.0,
      "formatted_start": "01:21:26.000",
      "formatted_end": "01:21:29.000",
      "text": "در آخر این دانشگاه ها بیماری"
    },
    {
      "id": 33,
      "start": 4889.0,
      "end": 4891.0,
      "formatted_start": "01:21:29.000",
      "formatted_end": "01:21:31.000",
      "text": "اما این وقت چیز نیست"
    },
    {
      "id": 34,
      "start": 4891.0,
      "end": 4892.0,
      "formatted_start": "01:21:31.000",
      "formatted_end": "01:21:32.000",
      "text": "کاندوم استفاده می کنی؟"
    },
    {
      "id": 35,
      "start": 4892.0,
      "end": 4893.0,
      "formatted_start": "01:21:32.000",
      "formatted_end": "01:21:33.000",
      "text": "نه"
    },
    {
      "id": 36,
      "start": 4893.0,
      "end": 4895.0,
      "formatted_start": "01:21:33.000",
      "formatted_end": "01:21:35.000",
      "text": "بلاخره قانوندگی داره"
    },
    {
      "id": 37,
      "start": 4895.0,
      "end": 4899.0,
      "formatted_start": "01:21:35.000",
      "formatted_end": "01:21:39.000",
      "text": "این قانوندگی از خانومتهای واجه ها اینجا میشه"
    },
    {
      "id": 38,
      "start": 4899.0,
      "end": 4902.0,
      "formatted_start": "01:21:39.000",
      "formatted_end": "01:21:42.000",
      "text": "اول مثلا اگه نزدیکی کرده"
    },
    {
      "id": 39,
      "start": 4902.0,
      "end": 4904.0,
      "formatted_start": "01:21:42.000",
      "formatted_end": "01:21:44.000",
      "text": "بعد کاندوم استفاده کرده"
    },
    {
      "id": 40,
      "start": 4904.0,
      "end": 4906.0,
      "formatted_start": "01:21:44.000",
      "formatted_end": "01:21:46.000",
      "text": "قانوندگی این بوده که"
    },
    {
      "id": 41,
      "start": 4906.0,
      "end": 4908.0,
      "formatted_start": "01:21:46.000",
      "formatted_end": "01:21:48.000",
      "text": "بچه ازن نمیدونه"
    },
    {
      "id": 42,
      "start": 4908.0,
      "end": 4908.5,
      "formatted_start": "01:21:48.000",
      "formatted_end": "01:21:48.500",
      "text": "جان؟"
    },
    {
      "id": 43,
      "start": 4908.5,
      "end": 4909.0,
      "formatted_start": "01:21:48.500",
      "formatted_end": "01:21:49.000",
      "text": "بیسیم نمیدونه"
    },
    {
      "id": 44,
      "start": 4909.0,
      "end": 4910.0,
      "formatted_start": "01:21:49.000",
      "formatted_end": "01:21:50.000",
      "text": "میترسیم از بچه ای؟"
    },
    {
      "id": 45,
      "start": 4910.0,
      "end": 4911.0,
      "formatted_start": "01:21:50.000",
      "formatted_end": "01:21:51.000",
      "text": "نه، نه، نمیشه"
    },
    {
      "id": 46,
      "start": 4911.0,
      "end": 4914.0,
      "formatted_start": "01:21:51.000",
      "formatted_end": "01:21:54.000",
      "text": "بله ها که این کلومیگی مشترکی"
    },
    {
      "id": 47,
      "start": 4914.0,
      "end": 4918.0,
      "formatted_start": "01:21:54.000",
      "formatted_end": "01:21:58.000",
      "text": "اگر همیشه کاندومه فقط به شما بدم"
    },
    {
      "id": 48,
      "start": 4918.0,
      "end": 4922.0,
      "formatted_start": "01:21:58.000",
      "formatted_end": "01:22:02.000",
      "text": "اگر نه، امکان داره یه وقت بدون کاندوم هم تاشته باشید"
    },
    {
      "id": 49,
      "start": 4922.0,
      "end": 4924.0,
      "formatted_start": "01:22:02.000",
      "formatted_end": "01:22:04.000",
      "text": "حتی یک بار، باید دو درست نداریم"
    },
    {
      "id": 50,
      "start": 4924.0,
      "end": 4926.0,
      "formatted_start": "01:22:04.000",
      "formatted_end": "01:22:06.000",
      "text": "کدوم دوستش بگیر"
    },
    {
      "id": 51,
      "start": 4926.0,
      "end": 4926.5,
      "formatted_start": "01:22:06.000",
      "formatted_end": "01:22:06.500",
      "text": "نه؟"
    },
    {
      "id": 52,
      "start": 4926.5,
      "end": 4928.0,
      "formatted_start": "01:22:06.500",
      "formatted_end": "01:22:08.000",
      "text": "در جدار برنامه بگیرم"
    },
    {
      "id": 53,
      "start": 4928.0,
      "end": 4930.0,
      "formatted_start": "01:22:08.000",
      "formatted_end": "01:22:10.000",
      "text": "از اینجور را سپاده بودید و نمیدونید به شما"
    },
    {
      "id": 54,
      "start": 4930.0,
      "end": 4932.0,
      "formatted_start": "01:22:10.000",
      "formatted_end": "01:22:12.000",
      "text": "و از اینجور را بزیار میگیرید"
    },
    {
      "id": 55,
      "start": 4932.0,
      "end": 4934.0,
      "formatted_start": "01:22:12.000",
      "formatted_end": "01:22:14.000",
      "text": "خاله جزمان من این نوشته بودم"
    },
    {
      "id": 56,
      "start": 4934.0,
      "end": 4936.0,
      "formatted_start": "01:22:14.000",
      "formatted_end": "01:22:16.000",
      "text": "مثلا من شما"
    },
    {
      "id": 57,
      "start": 4936.0,
      "end": 4938.0,
      "formatted_start": "01:22:16.000",
      "formatted_end": "01:22:18.000",
      "text": "من به موضوعی برای خودم هستم"
    },
    {
      "id": 58,
      "start": 4938.0,
      "end": 4940.0,
      "formatted_start": "01:22:18.000",
      "formatted_end": "01:22:20.000",
      "text": "از زمان که رافت از دنبال نزدیک جمع کرده"
    },
    {
      "id": 59,
      "start": 4940.0,
      "end": 4942.0,
      "formatted_start": "01:22:20.000",
      "formatted_end": "01:22:22.000",
      "text": "من خیلی سرگاه شدید دارم"
    },
    {
      "id": 60,
      "start": 4942.0,
      "end": 4944.0,
      "formatted_start": "01:22:22.000",
      "formatted_end": "01:22:24.000",
      "text": "اخیرا هم"
    },
    {
      "id": 61,
      "start": 4944.0,
      "end": 4946.0,
      "formatted_start": "01:22:24.000",
      "formatted_end": "01:22:26.000",
      "text": "چند ماه پیش"
    },
    {
      "id": 62,
      "start": 4946.0,
      "end": 4948.0,
      "formatted_start": "01:22:26.000",
      "formatted_end": "01:22:28.000",
      "text": "خیلی بسیار نادر انتفاق میخوادم"
    },
    {
      "id": 63,
      "start": 4948.0,
      "end": 4950.0,
      "formatted_start": "01:22:28.000",
      "formatted_end": "01:22:30.000",
      "text": "احساس از"
    },
    {
      "id": 64,
      "start": 4950.0,
      "end": 4952.0,
      "formatted_start": "01:22:30.000",
      "formatted_end": "01:22:32.000",
      "text": "احساس از چیز میگردم"
    },
    {
      "id": 65,
      "start": 4952.0,
      "end": 4954.0,
      "formatted_start": "01:22:32.000",
      "formatted_end": "01:22:34.000",
      "text": "برد عفونت بودید"
    },
    {
      "id": 66,
      "start": 4954.0,
      "end": 4984.0,
      "formatted_start": "01:22:34.000",
      "formatted_end": "01:23:04.000",
      "text": "اینکه اینکه اون رو بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر ب"
    },
    {
      "id": 67,
      "start": 4984.0,
      "end": 4988.0,
      "formatted_start": "01:23:04.000",
      "formatted_end": "01:23:08.000",
      "text": "یک محلوله یک فهمات درست کردن"
    },
    {
      "id": 68,
      "start": 4988.0,
      "end": 4992.0,
      "formatted_start": "01:23:08.000",
      "formatted_end": "01:23:12.000",
      "text": "این مسئله ای آلت روزی دو باری سه باری سپاره گویی بهتر"
    },
    {
      "id": 69,
      "start": 4992.0,
      "end": 4996.0,
      "formatted_start": "01:23:12.000",
      "formatted_end": "01:23:16.000",
      "text": "ظرف دردن ده روز از شما برداشته میشه"
    },
    {
      "id": 70,
      "start": 4996.0,
      "end": 4998.0,
      "formatted_start": "01:23:16.000",
      "formatted_end": "01:23:18.000",
      "text": "این شامل میشه خیلی راحت باشه"
    },
    {
      "id": 71,
      "start": 4998.0,
      "end": 5000.0,
      "formatted_start": "01:23:18.000",
      "formatted_end": "01:23:20.000",
      "text": "نه شامل خوب میشه"
    },
    {
      "id": 72,
      "start": 5000.0,
      "end": 5002.0,
      "formatted_start": "01:23:20.000",
      "formatted_end": "01:23:22.000",
      "text": "این است حالا اون خیلی بخشت"
    },
    {
      "id": 73,
      "start": 5002.0,
      "end": 5004.0,
      "formatted_start": "01:23:22.000",
      "formatted_end": "01:23:24.000",
      "text": "نه بخشت"
    },
    {
      "id": 74,
      "start": 5004.0,
      "end": 5006.0,
      "formatted_start": "01:23:24.000",
      "formatted_end": "01:23:26.000",
      "text": "به هانو باز کن نه تنمونش نمون باشه"
    },
    {
      "id": 75,
      "start": 5006.0,
      "end": 5008.0,
      "formatted_start": "01:23:26.000",
      "formatted_end": "01:23:28.000",
      "text": "صبح خیلی زیادی مشکل است"
    },
    {
      "id": 76,
      "start": 5008.0,
      "end": 5010.0,
      "formatted_start": "01:23:28.000",
      "formatted_end": "01:23:30.000",
      "text": "شبیه به بابا"
    },
    {
      "id": 77,
      "start": 5010.0,
      "end": 5012.0,
      "formatted_start": "01:23:30.000",
      "formatted_end": "01:23:32.000",
      "text": "آب دهره بخشت بودیم"
    },
    {
      "id": 78,
      "start": 5012.0,
      "end": 5014.0,
      "formatted_start": "01:23:32.000",
      "formatted_end": "01:23:34.000",
      "text": "همه ده هنگورتونیم"
    },
    {
      "id": 79,
      "start": 5014.8,
      "end": 5016.8,
      "formatted_start": "01:23:34.800",
      "formatted_end": "01:23:36.800",
      "text": "من جهان میدیم باشم"
    },
    {
      "id": 80,
      "start": 5022.48,
      "end": 5024.48,
      "formatted_start": "01:23:42.480",
      "formatted_end": "01:23:44.480",
      "text": "این کف نقص میرسه"
    },
    {
      "id": 81,
      "start": 5024.48,
      "end": 5026.48,
      "formatted_start": "01:23:44.480",
      "formatted_end": "01:23:46.480",
      "text": "این برگشت نسید برگشت"
    },
    {
      "id": 82,
      "start": 5026.48,
      "end": 5028.48,
      "formatted_start": "01:23:46.480",
      "formatted_end": "01:23:48.480",
      "text": "از زمان ایمان هم یادمدید هست با ما"
    },
    {
      "id": 83,
      "start": 5038.16,
      "end": 5041.52,
      "formatted_start": "01:23:58.160",
      "formatted_end": "01:24:01.520",
      "text": "بعد توضیح کنم مثلا خریدازی میبینم"
    },
    {
      "id": 84,
      "start": 5041.52,
      "end": 5045.52,
      "formatted_start": "01:24:01.520",
      "formatted_end": "01:24:05.520",
      "text": "این تنگ افناست و باید تیار را ازن رو هم بگماز دست"
    },
    {
      "id": 85,
      "start": 5062.52,
      "end": 5063.52,
      "formatted_start": "01:24:22.520",
      "formatted_end": "01:24:23.520",
      "text": "اسم خانم چه بود؟"
    },
    {
      "id": 86,
      "start": 5064.52,
      "end": 5065.52,
      "formatted_start": "01:24:24.520",
      "formatted_end": "01:24:25.520",
      "text": "سریده سریده فقری"
    },
    {
      "id": 87,
      "start": 5065.52,
      "end": 5066.52,
      "formatted_start": "01:24:25.520",
      "formatted_end": "01:24:26.520",
      "text": "سریده؟"
    },
    {
      "id": 88,
      "start": 5066.52,
      "end": 5067.52,
      "formatted_start": "01:24:26.520",
      "formatted_end": "01:24:27.520",
      "text": "سریده فقری"
    },
    {
      "id": 89,
      "start": 5067.52,
      "end": 5097.52,
      "formatted_start": "01:24:27.520",
      "formatted_end": "01:24:57.520",
      "text": "از اینجوری کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید کنید"
    },
    {
      "id": 90,
      "start": 5097.52,
      "end": 5099.88,
      "formatted_start": "01:24:57.520",
      "formatted_end": "01:24:59.880",
      "text": "کامل استفاده کنید. شما کسی دیگه ای نداشتید"
    }
  ],
