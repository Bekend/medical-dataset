  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3002.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:02.000",
      "text": "این برای سنگ کنی هست."
    },
    {
      "id": 1,
      "start": 3002.0,
      "end": 3004.0,
      "formatted_start": "00:50:02.000",
      "formatted_end": "00:50:04.000",
      "text": "روزی کند رو باید کنم؟"
    },
    {
      "id": 2,
      "start": 3004.0,
      "end": 3009.0,
      "formatted_start": "00:50:04.000",
      "formatted_end": "00:50:09.000",
      "text": "نوشته روزی دوتا. این برای کنترل ادرار روزی دوتا. این برای افغانته."
    },
    {
      "id": 3,
      "start": 3009.0,
      "end": 3016.0,
      "formatted_start": "00:50:09.000",
      "formatted_end": "00:50:16.000",
      "text": "یه دونه خورسم مکیدنیه. الان بذارو زبونت بمکه دیگه. اشتباه نکنه. غرق نباید بدی."
    },
    {
      "id": 4,
      "start": 3016.0,
      "end": 3020.0,
      "formatted_start": "00:50:16.000",
      "formatted_end": "00:50:20.000",
      "text": "اینو بذارو زبان، بچفش رو باید تورانیه."
    },
    {
      "id": 5,
      "start": 3020.0,
      "end": 3023.0,
      "formatted_start": "00:50:20.000",
      "formatted_end": "00:50:23.000",
      "text": "بذار باید تورانیه بکنم؟"
    },
    {
      "id": 6,
      "start": 3023.0,
      "end": 3025.0,
      "formatted_start": "00:50:23.000",
      "formatted_end": "00:50:25.000",
      "text": "آره، آره بگم بچفش بگم."
    },
    {
      "id": 7,
      "start": 3025.0,
      "end": 3026.0,
      "formatted_start": "00:50:25.000",
      "formatted_end": "00:50:26.000",
      "text": "سلام."
    },
    {
      "id": 8,
      "start": 3026.0,
      "end": 3027.0,
      "formatted_start": "00:50:26.000",
      "formatted_end": "00:50:27.000",
      "text": "سلامت شما."
    },
    {
      "id": 9,
      "start": 3027.0,
      "end": 3029.0,
      "formatted_start": "00:50:27.000",
      "formatted_end": "00:50:29.000",
      "text": "بره دوش هم اومدن"
    },
    {
      "id": 10,
      "start": 3029.0,
      "end": 3031.0,
      "formatted_start": "00:50:29.000",
      "formatted_end": "00:50:31.000",
      "text": "این رو باید روز یکی؟"
    },
    {
      "id": 11,
      "start": 3031.0,
      "end": 3033.0,
      "formatted_start": "00:50:31.000",
      "formatted_end": "00:50:33.000",
      "text": "نه سه دن"
    },
    {
      "id": 12,
      "start": 3033.0,
      "end": 3035.0,
      "formatted_start": "00:50:33.000",
      "formatted_end": "00:50:35.000",
      "text": "صبح زمان؟"
    },
    {
      "id": 13,
      "start": 3035.0,
      "end": 3037.0,
      "formatted_start": "00:50:35.000",
      "formatted_end": "00:50:37.000",
      "text": "صبح زمان شبه"
    },
    {
      "id": 14,
      "start": 3037.0,
      "end": 3039.0,
      "formatted_start": "00:50:37.000",
      "formatted_end": "00:50:39.000",
      "text": "افتر افر اومدن باید درمان نوشتیم برای تو افتر باید نوشتیم"
    },
    {
      "id": 15,
      "start": 3039.0,
      "end": 3041.0,
      "formatted_start": "00:50:39.000",
      "formatted_end": "00:50:41.000",
      "text": "نه اون نسخه ها هست"
    },
    {
      "id": 16,
      "start": 3041.0,
      "end": 3043.0,
      "formatted_start": "00:50:41.000",
      "formatted_end": "00:50:43.000",
      "text": "چشم"
    },
    {
      "id": 17,
      "start": 3043.0,
      "end": 3045.0,
      "formatted_start": "00:50:43.000",
      "formatted_end": "00:50:45.000",
      "text": "در روز شده بیسته مریض دوشتون دیگه"
    },
    {
      "id": 18,
      "start": 3045.0,
      "end": 3047.0,
      "formatted_start": "00:50:45.000",
      "formatted_end": "00:50:47.000",
      "text": "برای تو نمان بکیم"
    },
    {
      "id": 19,
      "start": 3047.0,
      "end": 3049.0,
      "formatted_start": "00:50:47.000",
      "formatted_end": "00:50:49.000",
      "text": "آره"
    },
    {
      "id": 20,
      "start": 3049.0,
      "end": 3051.0,
      "formatted_start": "00:50:49.000",
      "formatted_end": "00:50:51.000",
      "text": "قطعه دوم کلورام پریکل"
    },
    {
      "id": 21,
      "start": 3051.0,
      "end": 3053.0,
      "formatted_start": "00:50:51.000",
      "formatted_end": "00:50:53.000",
      "text": "تو یک چارمی سه"
    },
    {
      "id": 22,
      "start": 3053.0,
      "end": 3055.0,
      "formatted_start": "00:50:53.000",
      "formatted_end": "00:50:55.000",
      "text": "برای تو باید بره دوشتون"
    },
    {
      "id": 23,
      "start": 3055.0,
      "end": 3057.0,
      "formatted_start": "00:50:55.000",
      "formatted_end": "00:50:57.000",
      "text": "دو هم کلوران پلیکوت رو یک چهار میزشتی؟"
    },
    {
      "id": 24,
      "start": 3057.0,
      "end": 3058.0,
      "formatted_start": "00:50:57.000",
      "formatted_end": "00:50:58.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 3058.0,
      "end": 3059.0,
      "formatted_start": "00:50:58.000",
      "formatted_end": "00:50:59.000",
      "text": "بسیار خوب"
    },
    {
      "id": 26,
      "start": 3059.0,
      "end": 3063.0,
      "formatted_start": "00:50:59.000",
      "formatted_end": "00:51:03.000",
      "text": "الان جک و افزادش کم شده؟"
    },
    {
      "id": 27,
      "start": 3063.0,
      "end": 3067.0,
      "formatted_start": "00:51:03.000",
      "formatted_end": "00:51:07.000",
      "text": "والا من آیا دوتور چیزی که نداریدم از که بوشم بوشم"
    },
    {
      "id": 28,
      "start": 3067.0,
      "end": 3069.0,
      "formatted_start": "00:51:07.000",
      "formatted_end": "00:51:09.000",
      "text": "خوب میدونید"
    },
    {
      "id": 29,
      "start": 3069.0,
      "end": 3073.0,
      "formatted_start": "00:51:09.000",
      "formatted_end": "00:51:13.000",
      "text": "یکی باید تکم بدی و چه میدونم اونجوری ماساج میدونید تا روارو بودید"
    },
    {
      "id": 30,
      "start": 3073.0,
      "end": 3075.0,
      "formatted_start": "00:51:13.000",
      "formatted_end": "00:51:15.000",
      "text": "الان ناراحتی که احساس میکنید چیه خب؟"
    },
    {
      "id": 31,
      "start": 3075.0,
      "end": 3077.0,
      "formatted_start": "00:51:15.000",
      "formatted_end": "00:51:17.000",
      "text": "اینه که گم میشنن"
    },
    {
      "id": 32,
      "start": 3077.0,
      "end": 3079.0,
      "formatted_start": "00:51:17.000",
      "formatted_end": "00:51:19.000",
      "text": "یه چیزو ده بار باید بگم"
    },
    {
      "id": 33,
      "start": 3079.0,
      "end": 3081.0,
      "formatted_start": "00:51:19.000",
      "formatted_end": "00:51:21.000",
      "text": "الان که من راحت صحبت میکنم گم میشن"
    },
    {
      "id": 34,
      "start": 3085.0,
      "end": 3089.0,
      "formatted_start": "00:51:25.000",
      "formatted_end": "00:51:29.000",
      "text": "چرا ما میشنرم و ما چرا بعد میشنرم؟ خودم اخوان حس میکنم"
    },
    {
      "id": 35,
      "start": 3089.0,
      "end": 3091.0,
      "formatted_start": "00:51:29.000",
      "formatted_end": "00:51:31.000",
      "text": "آره آره"
    },
    {
      "id": 36,
      "start": 3091.0,
      "end": 3094.0,
      "formatted_start": "00:51:31.000",
      "formatted_end": "00:51:34.000",
      "text": "خیلی بهتر شده"
    },
    {
      "id": 37,
      "start": 3094.0,
      "end": 3096.0,
      "formatted_start": "00:51:34.000",
      "formatted_end": "00:51:36.000",
      "text": "بهتر شده؟"
    },
    {
      "id": 38,
      "start": 3096.0,
      "end": 3098.0,
      "formatted_start": "00:51:36.000",
      "formatted_end": "00:51:38.000",
      "text": "آره آره"
    },
    {
      "id": 39,
      "start": 3098.0,
      "end": 3100.0,
      "formatted_start": "00:51:38.000",
      "formatted_end": "00:51:40.000",
      "text": "اینجور بیرونه"
    },
    {
      "id": 40,
      "start": 3100.0,
      "end": 3103.0,
      "formatted_start": "00:51:40.000",
      "formatted_end": "00:51:43.000",
      "text": "شبیه خواهده با من برم"
    },
    {
      "id": 41,
      "start": 3103.0,
      "end": 3105.0,
      "formatted_start": "00:51:43.000",
      "formatted_end": "00:51:45.000",
      "text": "اینجور برم"
    },
    {
      "id": 42,
      "start": 3105.0,
      "end": 3106.0,
      "formatted_start": "00:51:45.000",
      "formatted_end": "00:51:46.000",
      "text": "خواهده برم"
    },
    {
      "id": 43,
      "start": 3106.0,
      "end": 3107.0,
      "formatted_start": "00:51:46.000",
      "formatted_end": "00:51:47.000",
      "text": "خواهده برم"
    },
    {
      "id": 44,
      "start": 3107.0,
      "end": 3108.0,
      "formatted_start": "00:51:47.000",
      "formatted_end": "00:51:48.000",
      "text": "به خاطر الکول"
    },
    {
      "id": 45,
      "start": 3108.0,
      "end": 3111.0,
      "formatted_start": "00:51:48.000",
      "formatted_end": "00:51:51.000",
      "text": "به خاطر این جرگره درونه میره توش"
    },
    {
      "id": 46,
      "start": 3111.0,
      "end": 3113.0,
      "formatted_start": "00:51:51.000",
      "formatted_end": "00:51:53.000",
      "text": "آره آره خواهده برم"
    },
    {
      "id": 47,
      "start": 3113.0,
      "end": 3120.0,
      "formatted_start": "00:51:53.000",
      "formatted_end": "00:52:00.000",
      "text": "این دو تا قطره رو مبارکت فاصله بدیم"
    },
    {
      "id": 48,
      "start": 3120.0,
      "end": 3123.0,
      "formatted_start": "00:52:00.000",
      "formatted_end": "00:52:03.000",
      "text": "بهت میگفتم سه تا قطره رو باهم برسید"
    },
    {
      "id": 49,
      "start": 3123.0,
      "end": 3126.0,
      "formatted_start": "00:52:03.000",
      "formatted_end": "00:52:06.000",
      "text": "حالا میگم هر کل برسید"
    },
    {
      "id": 50,
      "start": 3126.0,
      "end": 3128.0,
      "formatted_start": "00:52:06.000",
      "formatted_end": "00:52:08.000",
      "text": "اونو که پنج کل بود نشد"
    },
    {
      "id": 51,
      "start": 3128.0,
      "end": 3129.0,
      "formatted_start": "00:52:08.000",
      "formatted_end": "00:52:09.000",
      "text": "آره درسته"
    },
    {
      "id": 52,
      "start": 3129.0,
      "end": 3130.0,
      "formatted_start": "00:52:09.000",
      "formatted_end": "00:52:10.000",
      "text": "آره برسید"
    },
    {
      "id": 53,
      "start": 3130.0,
      "end": 3132.0,
      "formatted_start": "00:52:10.000",
      "formatted_end": "00:52:12.000",
      "text": "بعد یک رو بمان"
    },
    {
      "id": 54,
      "start": 3132.0,
      "end": 3134.0,
      "formatted_start": "00:52:12.000",
      "formatted_end": "00:52:14.000",
      "text": "یک رو روش برگرده"
    },
    {
      "id": 55,
      "start": 3134.0,
      "end": 3136.0,
      "formatted_start": "00:52:14.000",
      "formatted_end": "00:52:16.000",
      "text": "خب این کار رو انجام دادیم"
    },
    {
      "id": 56,
      "start": 3136.0,
      "end": 3138.0,
      "formatted_start": "00:52:16.000",
      "formatted_end": "00:52:18.000",
      "text": "بعد اون دو تا قطره رو برسید"
    },
    {
      "id": 57,
      "start": 3138.0,
      "end": 3139.0,
      "formatted_start": "00:52:18.000",
      "formatted_end": "00:52:19.000",
      "text": "آره یه رو"
    },
    {
      "id": 58,
      "start": 3139.0,
      "end": 3140.0,
      "formatted_start": "00:52:19.000",
      "formatted_end": "00:52:20.000",
      "text": "الان قاطع نشه"
    },
    {
      "id": 59,
      "start": 3140.0,
      "end": 3142.0,
      "formatted_start": "00:52:20.000",
      "formatted_end": "00:52:22.000",
      "text": "که هر کل بتونه اینجام رو حل کنه"
    },
    {
      "id": 60,
      "start": 3142.0,
      "end": 3147.0,
      "formatted_start": "00:52:22.000",
      "formatted_end": "00:52:27.000",
      "text": "خب، الکول با اونا که قاطع میشه قدرتش کاهش بدم می کنه"
    },
    {
      "id": 61,
      "start": 3147.0,
      "end": 3151.0,
      "formatted_start": "00:52:27.000",
      "formatted_end": "00:52:31.000",
      "text": "خب، الکول... اصلا فونتش خابیده"
    },
    {
      "id": 62,
      "start": 3151.0,
      "end": 3152.0,
      "formatted_start": "00:52:31.000",
      "formatted_end": "00:52:32.000",
      "text": "اصلا فونت دیگه..."
    },
    {
      "id": 63,
      "start": 3152.0,
      "end": 3154.0,
      "formatted_start": "00:52:32.000",
      "formatted_end": "00:52:34.000",
      "text": "الکول بوری پی یه دونه هر روز استفاده نشونه بوده"
    },
    {
      "id": 64,
      "start": 3154.0,
      "end": 3155.0,
      "formatted_start": "00:52:34.000",
      "formatted_end": "00:52:35.000",
      "text": "بله"
    },
    {
      "id": 65,
      "start": 3155.0,
      "end": 3157.0,
      "formatted_start": "00:52:35.000",
      "formatted_end": "00:52:37.000",
      "text": "اون یه روی هم پشتش نخریدم"
    },
    {
      "id": 66,
      "start": 3157.0,
      "end": 3158.0,
      "formatted_start": "00:52:37.000",
      "formatted_end": "00:52:38.000",
      "text": "افراد، الکول بوری..."
    },
    {
      "id": 67,
      "start": 3158.0,
      "end": 3159.0,
      "formatted_start": "00:52:38.000",
      "formatted_end": "00:52:39.000",
      "text": "پشتش نخریدم، پشتش نخریدم"
    },
    {
      "id": 68,
      "start": 3159.0,
      "end": 3160.0,
      "formatted_start": "00:52:39.000",
      "formatted_end": "00:52:40.000",
      "text": "پشتش نخریدم، پشتش نخریدم"
    },
    {
      "id": 69,
      "start": 3160.0,
      "end": 3161.0,
      "formatted_start": "00:52:40.000",
      "formatted_end": "00:52:41.000",
      "text": "پشتش نخریدم، پشتش نخریدم"
    },
    {
      "id": 70,
      "start": 3161.0,
      "end": 3162.0,
      "formatted_start": "00:52:41.000",
      "formatted_end": "00:52:42.000",
      "text": "پشتش نخریدم، پشتش نخریدم"
    },
    {
      "id": 71,
      "start": 3162.0,
      "end": 3164.0,
      "formatted_start": "00:52:42.000",
      "formatted_end": "00:52:44.000",
      "text": "از دو طرف دارم"
    },
    {
      "id": 72,
      "start": 3164.0,
      "end": 3166.0,
      "formatted_start": "00:52:44.000",
      "formatted_end": "00:52:46.000",
      "text": "بعد مدت یک ساعت"
    },
    {
      "id": 73,
      "start": 3166.0,
      "end": 3168.0,
      "formatted_start": "00:52:46.000",
      "formatted_end": "00:52:48.000",
      "text": "تا خواهد اون بار چشمی تموم شد"
    },
    {
      "id": 74,
      "start": 3168.0,
      "end": 3170.0,
      "formatted_start": "00:52:48.000",
      "formatted_end": "00:52:50.000",
      "text": "چشم سرش خواهد جمعه"
    },
    {
      "id": 75,
      "start": 3170.0,
      "end": 3174.0,
      "formatted_start": "00:52:50.000",
      "formatted_end": "00:52:54.000",
      "text": "کلوران خیلی کل"
    },
    {
      "id": 76,
      "start": 3174.0,
      "end": 3176.0,
      "formatted_start": "00:52:54.000",
      "formatted_end": "00:52:56.000",
      "text": "خیلی کل"
    },
    {
      "id": 77,
      "start": 3176.0,
      "end": 3178.0,
      "formatted_start": "00:52:56.000",
      "formatted_end": "00:52:58.000",
      "text": "خواهد تموم شده باشیم"
    },
    {
      "id": 78,
      "start": 3178.0,
      "end": 3180.0,
      "formatted_start": "00:52:58.000",
      "formatted_end": "00:53:00.000",
      "text": "بعد اول رکز"
    },
    {
      "id": 79,
      "start": 3180.0,
      "end": 3182.0,
      "formatted_start": "00:53:00.000",
      "formatted_end": "00:53:02.000",
      "text": "بعد از نیم ساعت"
    },
    {
      "id": 80,
      "start": 3182.0,
      "end": 3184.0,
      "formatted_start": "00:53:02.000",
      "formatted_end": "00:53:04.000",
      "text": "دو قطره دیگر"
    },
    {
      "id": 81,
      "start": 3184.0,
      "end": 3186.0,
      "formatted_start": "00:53:04.000",
      "formatted_end": "00:53:06.000",
      "text": "خیلی آری شده"
    },
    {
      "id": 82,
      "start": 3186.0,
      "end": 3188.0,
      "formatted_start": "00:53:06.000",
      "formatted_end": "00:53:08.000",
      "text": "نجار رو باز بودن"
    },
    {
      "id": 83,
      "start": 3188.0,
      "end": 3190.0,
      "formatted_start": "00:53:08.000",
      "formatted_end": "00:53:10.000",
      "text": "بعد شما تیم نگاه کردی"
    },
    {
      "id": 84,
      "start": 3190.0,
      "end": 3193.4,
      "formatted_start": "00:53:10.000",
      "formatted_end": "00:53:13.400",
      "text": "اصلا بشنرتش خوب شده فقط جرم مانده"
    },
    {
      "id": 85,
      "start": 3193.4,
      "end": 3196.96,
      "formatted_start": "00:53:13.400",
      "formatted_end": "00:53:16.960",
      "text": "اینم جرم من با فاصله دادن بین الکول اون"
    },
    {
      "id": 86,
      "start": 3196.96,
      "end": 3199.26,
      "formatted_start": "00:53:16.960",
      "formatted_end": "00:53:19.260",
      "text": "الکول میتونه به تنهایی آب کنه"
    },
    {
      "id": 87,
      "start": 3199.26,
      "end": 3201.72,
      "formatted_start": "00:53:19.260",
      "formatted_end": "00:53:21.720",
      "text": "از دیروز آقای دوتور دیگه من دارو رو قرد کردم"
    },
    {
      "id": 88,
      "start": 3201.72,
      "end": 3202.86,
      "formatted_start": "00:53:21.720",
      "formatted_end": "00:53:22.860",
      "text": "که میخواستم اون روز بیام"
    },
    {
      "id": 89,
      "start": 3202.86,
      "end": 3206.16,
      "formatted_start": "00:53:22.860",
      "formatted_end": "00:53:26.160",
      "text": "باش شدیدم تو بوشم تیت تیت داره صدا کنه"
    },
    {
      "id": 90,
      "start": 3206.16,
      "end": 3210.14,
      "formatted_start": "00:53:26.160",
      "formatted_end": "00:53:30.140",
      "text": "تا موقعی دارو میریخه هم نه"
    },
    {
      "id": 91,
      "start": 3210.14,
      "end": 3214.0,
      "formatted_start": "00:53:30.140",
      "formatted_end": "00:53:34.000",
      "text": "بابا ناشوکی بشر هست دیگه"
    },
    {
      "id": 92,
      "start": 3215.16,
      "end": 3217.54,
      "formatted_start": "00:53:35.160",
      "formatted_end": "00:53:37.540",
      "text": "بشر هیچ چیز خوبش کنه"
    },
    {
      "id": 93,
      "start": 3217.54,
      "end": 3218.8,
      "formatted_start": "00:53:37.540",
      "formatted_end": "00:53:38.800",
      "text": "بچه ها من رو اصلاس کردن"
    },
    {
      "id": 94,
      "start": 3218.8,
      "end": 3222.0,
      "formatted_start": "00:53:38.800",
      "formatted_end": "00:53:42.000",
      "text": "میگن مابان دیگه کلا خدا بخواد دوشت از بین رفته"
    },
    {
      "id": 95,
      "start": 3222.0,
      "end": 3222.84,
      "formatted_start": "00:53:42.000",
      "formatted_end": "00:53:42.840",
      "text": "این میگن مابان من"
    },
    {
      "id": 96,
      "start": 3222.84,
      "end": 3225.16,
      "formatted_start": "00:53:42.840",
      "formatted_end": "00:53:45.160",
      "text": "نه الان خیلی شنن باید بیتر شده"
    },
    {
      "id": 97,
      "start": 3225.16,
      "end": 3225.88,
      "formatted_start": "00:53:45.160",
      "formatted_end": "00:53:45.880",
      "text": "بیتر شده"
    },
    {
      "id": 98,
      "start": 3225.88,
      "end": 3227.5,
      "formatted_start": "00:53:45.880",
      "formatted_end": "00:53:47.500",
      "text": "اون دقیقه داد میزدن برای"
    },
    {
      "id": 99,
      "start": 3227.5,
      "end": 3230.04,
      "formatted_start": "00:53:47.500",
      "formatted_end": "00:53:50.040",
      "text": "الان من راحت دارم مثل آدی صحبت میکنم"
    },
    {
      "id": 100,
      "start": 3230.04,
      "end": 3231.28,
      "formatted_start": "00:53:50.040",
      "formatted_end": "00:53:51.280",
      "text": "تو هم خوب میشننی"
    },
    {
      "id": 101,
      "start": 3231.28,
      "end": 3234.04,
      "formatted_start": "00:53:51.280",
      "formatted_end": "00:53:54.040",
      "text": "اما تو هم همه اشتباه میکنی"
    },
    {
      "id": 102,
      "start": 3234.04,
      "end": 3234.56,
      "formatted_start": "00:53:54.040",
