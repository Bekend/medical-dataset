  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5411.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:11.000",
      "text": "این اصابه آرام میگوید و باید با باوسته میشه، فیلن اشکال نداره چون افراد جوانو که اصلا نمیدیم، میگه موتات میشه، پشتی گره، بیتاره دل بکنه."
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5434.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:34.000",
      "text": "اینجا اینجا خواهش میدینید که اون کارتن نیمیادی آن"
    },
    {
      "id": 2,
      "start": 5434.0,
      "end": 5436.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:36.000",
      "text": "از این طریق"
    },
    {
      "id": 3,
      "start": 5460.0,
      "end": 5490.0,
      "formatted_start": "01:31:00.000",
      "formatted_end": "01:31:30.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 4,
      "start": 5490.0,
      "end": 5492.0,
      "formatted_start": "01:31:30.000",
      "formatted_end": "01:31:32.000",
      "text": "از سوزش کف پا تم زیاده نه؟"
    },
    {
      "id": 5,
      "start": 5492.0,
      "end": 5494.0,
      "formatted_start": "01:31:32.000",
      "formatted_end": "01:31:34.000",
      "text": "نه"
    },
    {
      "id": 6,
      "start": 5494.0,
      "end": 5496.0,
      "formatted_start": "01:31:34.000",
      "formatted_end": "01:31:36.000",
      "text": "سوزش کف پا قریمتی؟"
    },
    {
      "id": 7,
      "start": 5496.0,
      "end": 5498.0,
      "formatted_start": "01:31:36.000",
      "formatted_end": "01:31:38.000",
      "text": "او نه زیاده"
    },
    {
      "id": 8,
      "start": 5498.0,
      "end": 5500.0,
      "formatted_start": "01:31:38.000",
      "formatted_end": "01:31:40.000",
      "text": "زیاده؟"
    },
    {
      "id": 9,
      "start": 5500.0,
      "end": 5502.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:42.000",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 5502.0,
      "end": 5504.0,
      "formatted_start": "01:31:42.000",
      "formatted_end": "01:31:44.000",
      "text": "میخورم مبتر"
    },
    {
      "id": 11,
      "start": 5504.0,
      "end": 5506.0,
      "formatted_start": "01:31:44.000",
      "formatted_end": "01:31:46.000",
      "text": "میخورم مبتر"
    },
    {
      "id": 12,
      "start": 5506.0,
      "end": 5508.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:31:48.000",
      "text": "داشت؟"
    },
    {
      "id": 13,
      "start": 5508.0,
      "end": 5510.0,
      "formatted_start": "01:31:48.000",
      "formatted_end": "01:31:50.000",
      "text": "اینجا که نه داشت شفت همین"
    },
    {
      "id": 14,
      "start": 5510.0,
      "end": 5512.0,
      "formatted_start": "01:31:50.000",
      "formatted_end": "01:31:52.000",
      "text": "بسیار درگاه"
    },
    {
      "id": 15,
      "start": 5512.0,
      "end": 5514.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:54.000",
      "text": "اینجا نام کرده بود؟"
    },
    {
      "id": 16,
      "start": 5514.0,
      "end": 5516.0,
      "formatted_start": "01:31:54.000",
      "formatted_end": "01:31:56.000",
      "text": "بله"
    },
    {
      "id": 17,
      "start": 5516.0,
      "end": 5518.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:31:58.000",
      "text": "چند درگاه بیس متری؟"
    },
    {
      "id": 18,
      "start": 5518.0,
      "end": 5520.0,
      "formatted_start": "01:31:58.000",
      "formatted_end": "01:32:00.000",
