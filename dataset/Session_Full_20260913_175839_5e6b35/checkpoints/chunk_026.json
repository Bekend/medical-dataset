      "formatted_start": "02:13:54.920",
      "formatted_end": "02:13:56.920",
      "text": "از اینکه برنامه بیشتر بردارید."
    },
    {
      "id": 101,
      "start": 8036.92,
      "end": 8038.92,
      "formatted_start": "02:13:56.920",
      "formatted_end": "02:13:58.920",
      "text": "از اینکه برنامه بیشتر بردارید."
    },
    {
      "id": 102,
      "start": 8038.92,
      "end": 8040.92,
      "formatted_start": "02:13:58.920",
      "formatted_end": "02:14:00.920",
      "text": "از اینکه برنامه بیشتر بردارید."
    },
    {
      "id": 103,
      "start": 8040.92,
      "end": 8042.92,
      "formatted_start": "02:14:00.920",
      "formatted_end": "02:14:02.920",
      "text": "از اینکه برنامه بیشتر بردارید."
    },
    {
      "id": 104,
      "start": 8042.92,
      "end": 8044.92,
      "formatted_start": "02:14:02.920",
      "formatted_end": "02:14:04.920",
      "text": "هست ارس جوشب هست؟"
    },
    {
      "id": 105,
      "start": 8044.92,
      "end": 8046.92,
      "formatted_start": "02:14:04.920",
      "formatted_end": "02:14:06.920",
      "text": "بله ارس جوشب زیادی بود"
    },
    {
      "id": 106,
      "start": 8056.92,
      "end": 8058.92,
      "formatted_start": "02:14:16.920",
      "formatted_end": "02:14:18.920",
      "text": "شما طلا خواستید؟"
    },
    {
      "id": 107,
      "start": 8058.92,
      "end": 8062.92,
      "formatted_start": "02:14:18.920",
      "formatted_end": "02:14:22.920",
      "text": "بیشتر اونو خواستید باشم"
    },
    {
      "id": 108,
      "start": 8062.92,
      "end": 8067.92,
      "formatted_start": "02:14:22.920",
      "formatted_end": "02:14:27.920",
      "text": "من که سایدش رو مزنگه کنیم برای خب نشونم"
    },
    {
      "id": 109,
      "start": 8067.92,
      "end": 8072.92,
      "formatted_start": "02:14:27.920",
      "formatted_end": "02:14:32.920",
      "text": "بخونه میگرد مادرش؟"
    },
    {
      "id": 110,
      "start": 8072.92,
      "end": 8079.92,
      "formatted_start": "02:14:32.920",
      "formatted_end": "02:14:39.920",
      "text": "برده یا اون باید اتخاب کنی یا من. اگه میخواد بازند باشی برو دیگه نگاه اینجا است."
    },
    {
      "id": 111,
      "start": 8079.92,
      "end": 8081.92,
      "formatted_start": "02:14:39.920",
      "formatted_end": "02:14:41.920",
      "text": "پایت اینجا ندارم."
    },
    {
      "id": 112,
      "start": 8081.92,
      "end": 8083.92,
      "formatted_start": "02:14:41.920",
      "formatted_end": "02:14:43.920",
      "text": "از شما به احترامی دیده بود؟ چی دیده بود؟"
    },
    {
      "id": 113,
      "start": 8083.92,
      "end": 8093.92,
      "formatted_start": "02:14:43.920",
      "formatted_end": "02:14:53.920",
      "text": "باید من تو جایی که بتاستم احترامشون داشتم ولی اونا دخولت میگردن. افتخار مادرش."
    },
    {
      "id": 114,
      "start": 8093.92,
      "end": 8095.92,
      "formatted_start": "02:14:53.920",
      "formatted_end": "02:14:55.920",
      "text": "اون بادشت نفر میگه"
    },
    {
      "id": 115,
      "start": 8095.92,
      "end": 8099.92,
      "formatted_start": "02:14:55.920",
      "formatted_end": "02:14:59.920",
      "text": "شما اون بادشت اصلا جاری دشتی"
    }
  ],
