  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7804.5,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:04.500",
      "text": "دیگه هم هم همین رو با اون میده هم به سختی رو میده."
    },
    {
      "id": 1,
      "start": 7804.5,
      "end": 7810.0,
      "formatted_start": "02:10:04.500",
      "formatted_end": "02:10:10.000",
      "text": "حالا دوست میدون باید بدم، دارو عوض میکنن، حالا چینی هاش صده چهر تومه هست،"
    },
    {
      "id": 2,
      "start": 7810.0,
      "end": 7814.0,
      "formatted_start": "02:10:10.000",
      "formatted_end": "02:10:14.000",
      "text": "آمریکایی هاش دوست نمانه، دوست نامیدن، دارو رو عوض میکنن،"
    },
    {
      "id": 3,
      "start": 7814.0,
      "end": 7820.0,
      "formatted_start": "02:10:14.000",
      "formatted_end": "02:10:20.000",
      "text": "بعد تازه اون نب ایرایی به هیچ وقتش نمیتونه بشه، خیلی محدودی اطراف،"
    },
    {
      "id": 4,
      "start": 7820.0,
      "end": 7823.0,
      "formatted_start": "02:10:20.000",
      "formatted_end": "02:10:23.000",
      "text": "ولی خب راه شما میره دیگه صاف میشه، راه شما میره."
    },
    {
      "id": 5,
      "start": 7823.0,
      "end": 7831.24,
      "formatted_start": "02:10:23.000",
      "formatted_end": "02:10:31.240",
      "text": "با شما محبت کنید این رو بگیرید بیارید بنده کشیه پهنم دوتا بگیرید داراتون بیارید که من"
    },
    {
      "id": 6,
      "start": 7831.24,
      "end": 7833.12,
      "formatted_start": "02:10:31.240",
      "formatted_end": "02:10:33.120",
      "text": "بردید چقدر میشه ازش میبینید؟"
    },
    {
      "id": 7,
      "start": 7833.12,
      "end": 7835.56,
      "formatted_start": "02:10:33.120",
      "formatted_end": "02:10:35.560",
      "text": "میبینم داراتون باید سختش میبینم"
    },
    {
      "id": 8,
      "start": 7835.56,
      "end": 7838.78,
      "formatted_start": "02:10:35.560",
      "formatted_end": "02:10:38.780",
      "text": "برای حرس میگم و مستاقی میبینید"
    },
    {
      "id": 9,
      "start": 7838.78,
      "end": 7843.32,
      "formatted_start": "02:10:38.780",
      "formatted_end": "02:10:43.320",
      "text": "مستاقی رو که هستیم نوشتم براتون که روز یک آره باید بگوارید"
    },
    {
      "id": 10,
      "start": 7843.32,
      "end": 7845.54,
      "formatted_start": "02:10:43.320",
      "formatted_end": "02:10:45.540",
      "text": "یه دوره کمان هست که باید بزنیم"
    },
    {
      "id": 11,
      "start": 7845.54,
      "end": 7849.52,
      "formatted_start": "02:10:45.540",
      "formatted_end": "02:10:49.520",
      "text": "آن پور زنده اتحابم دوتا دادم هفته یه دوره"
    },
    {
      "id": 12,
      "start": 7849.52,
      "end": 7851.52,
      "formatted_start": "02:10:49.520",
      "formatted_end": "02:10:51.520",
      "text": "ببینی چرا میشه"
    },
    {
      "id": 13,
      "start": 7851.52,
      "end": 7853.52,
      "formatted_start": "02:10:51.520",
      "formatted_end": "02:10:53.520",
      "text": "خیلی ممنون بلوچ کرد"
    },
    {
      "id": 14,
      "start": 7853.52,
      "end": 7855.52,
      "formatted_start": "02:10:53.520",
      "formatted_end": "02:10:55.520",
      "text": "بیاری"
    },
    {
      "id": 15,
      "start": 7855.52,
      "end": 7857.52,
      "formatted_start": "02:10:55.520",
