  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2405.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:05.000",
      "text": "اینجور ایامون آزمایش رو یارفتو اتردیم، توبت آمد."
    },
    {
      "id": 1,
      "start": 2405.0,
      "end": 2409.0,
      "formatted_start": "00:40:05.000",
      "formatted_end": "00:40:09.000",
      "text": "ایامون از سوزشکفت پانه ای هست؟"
    },
    {
      "id": 2,
      "start": 2409.0,
      "end": 2412.0,
      "formatted_start": "00:40:09.000",
      "formatted_end": "00:40:12.000",
      "text": "بله، اینجور ایامون توبت آمد."
    },
    {
      "id": 3,
      "start": 2412.0,
      "end": 2420.0,
      "formatted_start": "00:40:12.000",
      "formatted_end": "00:40:20.000",
      "text": "خب اون بیدنها آزده، گره اونو نچه دقایقا، یالان یاز میبینید، سونده یاز بوده، برای اون اثاره بیدنها که درش دارن،"
    },
    {
      "id": 4,
      "start": 2420.0,
      "end": 2429.12,
      "formatted_start": "00:40:20.000",
      "formatted_end": "00:40:29.120",
      "text": "چون سوزش کفه پای بیماری متابولیک ده مثلا کبد و بلارا مربوطه داخلیه مربوطه خود پاها مربوطه در این پنیان"
    },
    {
      "id": 5,
      "start": 2429.12,
      "end": 2434.16,
      "formatted_start": "00:40:29.120",
      "formatted_end": "00:40:34.160",
      "text": "اونا بیدن دردگیر هستن میشه هیچ فایده است روی خودی بیدن دردگیر هستن"
    },
    {
      "id": 6,
      "start": 2434.16,
      "end": 2438.84,
      "formatted_start": "00:40:34.160",
      "formatted_end": "00:40:38.840",
      "text": "محلولی دلا کفه پا"
    },
    {
      "id": 7,
      "start": 2438.84,
      "end": 2447.32,
      "formatted_start": "00:40:38.840",
      "formatted_end": "00:40:47.320",
      "text": "محسوس سوزش این کفه پا رو فکر نکنم اینها رو گمبت یه داروخانه یه باشه که اینها رو داشته باشه همه رو"
    },
    {
      "id": 8,
      "start": 2447.32,
      "end": 2454.72,
      "formatted_start": "00:40:47.320",
      "formatted_end": "00:40:54.720",
      "text": "چون اینجا ما به زحمت به صدیقه خودمون مثلا اینجا جمع کردیم"
    },
    {
      "id": 9,
      "start": 2454.72,
      "end": 2457.96,
      "formatted_start": "00:40:54.720",
      "formatted_end": "00:40:57.960",
      "text": "آره یعنی اینکه مثلا داروهایی که من میریسم"
    },
    {
      "id": 10,
      "start": 2457.96,
      "end": 2461.36,
      "formatted_start": "00:40:57.960",
      "formatted_end": "00:41:01.360",
      "text": "این داروها مثلا همین دکترها که برد بیستن همین داروها"
    },
    {
      "id": 11,
      "start": 2461.36,
      "end": 2464.56,
      "formatted_start": "00:41:01.360",
      "formatted_end": "00:41:04.560",
      "text": "حالا مثلا همین نده که هفت پاکی میگه اثر نکرد"
    },
    {
      "id": 12,
      "start": 2464.56,
      "end": 2466.62,
      "formatted_start": "00:41:04.560",
      "formatted_end": "00:41:06.620",
      "text": "تو خیلی ها اثر کرده"
    },
    {
      "id": 13,
      "start": 2466.62,
      "end": 2468.1,
      "formatted_start": "00:41:06.620",
      "formatted_end": "00:41:08.100",
      "text": "برای خب یه دونهش نیست"
    },
    {
      "id": 14,
      "start": 2468.1,
      "end": 2469.26,
      "formatted_start": "00:41:08.100",
      "formatted_end": "00:41:09.260",
      "text": "باید مرتب بزنن"
    },
    {
      "id": 15,
      "start": 2469.26,
      "end": 2472.56,
      "formatted_start": "00:41:09.260",
      "formatted_end": "00:41:12.560",
      "text": "دو ست ها که میزنن برد سوزشکفای بیماری لا علاجه"
    },
    {
      "id": 16,
      "start": 2472.56,
      "end": 2476.72,
      "formatted_start": "00:41:12.560",
      "formatted_end": "00:41:16.720",
      "text": "حالا مثلا شما به دکتر محمد ایگون باید بگه سوزش کرده و میگه علاج نداره"
    },
    {
      "id": 17,
      "start": 2476.72,
      "end": 2478.02,
      "formatted_start": "00:41:16.720",
      "formatted_end": "00:41:18.020",
      "text": "هیچ علاج نداره"
    },
    {
      "id": 18,
      "start": 2478.02,
      "end": 2480.8,
      "formatted_start": "00:41:18.020",
      "formatted_end": "00:41:20.800",
      "text": "یا دکترهای دیگه برید میگن اصلا دا علاج"
    },
    {
      "id": 19,
      "start": 2480.8,
      "end": 2482.16,
      "formatted_start": "00:41:20.800",
      "formatted_end": "00:41:22.160",
      "text": "توی انترنت هم میزن"
    },
    {
      "id": 20,
      "start": 2482.16,
      "end": 2485.9,
      "formatted_start": "00:41:22.160",
      "formatted_end": "00:41:25.900",
      "text": "توقیص یه داروی پیدا کردن همین که دادن"
    },
    {
      "id": 21,
      "start": 2485.9,
      "end": 2487.32,
      "formatted_start": "00:41:25.900",
      "formatted_end": "00:41:27.320",
      "text": "تکسی کفی پادره"
    },
    {
      "id": 22,
      "start": 2487.32,
      "end": 2493.02,
      "formatted_start": "00:41:27.320",
      "formatted_end": "00:41:33.020",
      "text": "اینو در حدود ۷۵ تا ۸۰ تا صداورت معسره"
    },
    {
      "id": 23,
      "start": 2493.02,
      "end": 2493.62,
      "formatted_start": "00:41:33.020",
      "formatted_end": "00:41:33.620",
      "text": "خواه؟"
    },
    {
      "id": 24,
      "start": 2493.62,
      "end": 2497.22,
      "formatted_start": "00:41:33.620",
      "formatted_end": "00:41:37.220",
      "text": "حالا یکیشون میزنن بگن معسره از ۲ تا ۳ تا بلخواهد بزنن"
    },
    {
      "id": 25,
      "start": 2497.22,
      "end": 2503.22,
      "formatted_start": "00:41:37.220",
      "formatted_end": "00:41:43.220",
      "text": "اینو الان همه داروخانه ها ندارن اینو ما به سختی اینجا از تبریز گرفتیم"
    },
    {
      "id": 26,
      "start": 2503.22,
      "end": 2516.22,
      "formatted_start": "00:41:43.220",
      "formatted_end": "00:41:56.220",
      "text": "با از تبریز به اینجا درون پرداشتیم نمیاد که مگه یه دکتوری بنویسه داروخانه که نانیش بسردن بگه خب این چه دارویه برم بگردم پیدا بکنم خرید بکنم با یه قیمتی بگم"
    },
    {
      "id": 27,
      "start": 2516.22,
      "end": 2522.22,
      "formatted_start": "00:41:56.220",
      "formatted_end": "00:42:02.220",
      "text": "مثلا همین افسردگی واریچ که شما بگیرون داروخانه داشت همه داروخانه های مومت ندارن اونو"
    },
    {
      "id": 28,
      "start": 2522.22,
      "end": 2524.98,
      "formatted_start": "00:42:02.220",
      "formatted_end": "00:42:04.980",
      "text": "باید پنج دارو خانه بیدی یکیش نشته باشی"
    },
    {
      "id": 29,
      "start": 2524.98,
      "end": 2529.38,
      "formatted_start": "00:42:04.980",
      "formatted_end": "00:42:09.380",
      "text": "اون همان شناخته شده است تقریبا اکثر دکترها اونو بلدن"
    },
    {
      "id": 30,
      "start": 2529.38,
      "end": 2534.38,
      "formatted_start": "00:42:09.380",
      "formatted_end": "00:42:14.380",
      "text": "ولی بعضی از داروها مثلا سرناندین نوشتن برای زان و درده ایشون"
    },
    {
      "id": 31,
      "start": 2534.38,
      "end": 2540.22,
      "formatted_start": "00:42:14.380",
      "formatted_end": "00:42:20.220",
      "text": "سرناندین شاید مثلا توی بیست دارو خانه گمبت بیدی یکیش نشته باشه"
    },
    {
      "id": 32,
      "start": 2540.22,
      "end": 2542.5,
      "formatted_start": "00:42:20.220",
      "formatted_end": "00:42:22.500",
      "text": "باز اینو باید غیر اسیر میشی برای این"
    },
    {
      "id": 33,
      "start": 2542.5,
      "end": 2543.98,
      "formatted_start": "00:42:22.500",
      "formatted_end": "00:42:23.980",
      "text": "آره باز همین کار میگیرم"
    },
    {
      "id": 34,
      "start": 2543.98,
      "end": 2546.22,
      "formatted_start": "00:42:23.980",
      "formatted_end": "00:42:26.220",
      "text": "باز همین کار میگیرم"
    },
    {
      "id": 35,
      "start": 2546.22,
      "end": 2548.22,
      "formatted_start": "00:42:26.220",
      "formatted_end": "00:42:28.220",
      "text": "باز همین کار میگیرم"
    },
    {
      "id": 36,
      "start": 2548.22,
      "end": 2578.22,
      "formatted_start": "00:42:28.220",
      "formatted_end": "00:42:58.220",
      "text": "اگر اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 37,
      "start": 2578.22,
      "end": 2580.22,
      "formatted_start": "00:42:58.220",
      "formatted_end": "00:43:00.220",
      "text": "نه، وزنم هیچی فرقی نکردم"
    },
    {
      "id": 38,
      "start": 2580.22,
      "end": 2584.22,
      "formatted_start": "00:43:00.220",
      "formatted_end": "00:43:04.220",
      "text": "بله، خب وزن یک چیزی داره، عادت باید کهی بشی؟"
    },
    {
      "id": 39,
      "start": 2584.22,
      "end": 2586.22,
      "formatted_start": "00:43:04.220",
      "formatted_end": "00:43:06.220",
      "text": "آهان"
    },
    {
      "id": 40,
      "start": 2586.22,
      "end": 2591.22,
      "formatted_start": "00:43:06.220",
      "formatted_end": "00:43:11.220",
      "text": "سه چهار برس ماده به عادت زمان و خواهدگی، وزن یه افزایش کاذب داره"
    },
    {
      "id": 41,
      "start": 2591.22,
      "end": 2594.22,
      "formatted_start": "00:43:11.220",
      "formatted_end": "00:43:14.220",
      "text": "اون چرخ ممکنه ما رو به اجتباه بده"
    },
    {
      "id": 42,
      "start": 2594.22,
      "end": 2595.22,
      "formatted_start": "00:43:14.220",
      "formatted_end": "00:43:15.220",
      "text": "بله، آهان"
    },
    {
      "id": 43,
      "start": 2595.22,
      "end": 2596.22,
      "formatted_start": "00:43:15.220",
      "formatted_end": "00:43:16.220",
      "text": "کهی باید عادت بشی؟"
    },
    {
      "id": 44,
      "start": 2596.22,
      "end": 2602.22,
      "formatted_start": "00:43:16.220",
      "formatted_end": "00:43:22.220",
      "text": "من فکر کنم همینه، امروز ده همین هم باید کنم بشم دیگه، یه ده همون دیگه"
    },
    {
      "id": 45,
      "start": 2602.22,
      "end": 2605.04,
      "formatted_start": "00:43:22.220",
      "formatted_end": "00:43:25.040",
      "text": "از که ۲۷ تون و ۲۷ تون دومه"
    },
    {
      "id": 46,
      "start": 2605.04,
      "end": 2609.46,
      "formatted_start": "00:43:25.040",
      "formatted_end": "00:43:29.460",
      "text": "حالا ۱۰ شهری بعد باید بشیم دو هفته دارم"
    },
    {
      "id": 47,
      "start": 2609.46,
      "end": 2612.42,
      "formatted_start": "00:43:29.460",
      "formatted_end": "00:43:32.420",
      "text": "کاروارو بردم همیشه میشدم ولی این درخواستان نشدم"
    },
    {
      "id": 48,
      "start": 2612.42,
      "end": 2613.02,
      "formatted_start": "00:43:32.420",
      "formatted_end": "00:43:33.020",
      "text": "خیلی کم"
    },
    {
      "id": 49,
      "start": 2613.02,
      "end": 2613.52,
      "formatted_start": "00:43:33.020",
      "formatted_end": "00:43:33.520",
      "text": "چی نشدی؟"
    },
    {
      "id": 50,
      "start": 2613.52,
      "end": 2614.92,
      "formatted_start": "00:43:33.520",
      "formatted_end": "00:43:34.920",
      "text": "عادت ما هم خیلی کم"
    },
    {
      "id": 51,
      "start": 2614.92,
      "end": 2616.68,
      "formatted_start": "00:43:34.920",
      "formatted_end": "00:43:36.680",
      "text": "یعنی رعادتون تثیر گذاشته"
    },
    {
      "id": 52,
      "start": 2616.68,
      "end": 2619.42,
      "formatted_start": "00:43:36.680",
      "formatted_end": "00:43:39.420",
      "text": "آره اصلا اونجوری که باید مثلا خودم میدونم میشدم"
    },
    {
      "id": 53,
      "start": 2619.42,
      "end": 2621.72,
      "formatted_start": "00:43:39.420",
      "formatted_end": "00:43:41.720",
      "text": "درخواستان خیلی کم کردم"
    },
    {
      "id": 54,
      "start": 2621.72,
      "end": 2622.52,
      "formatted_start": "00:43:41.720",
      "formatted_end": "00:43:42.520",
      "text": "آره ببینیم"
    },
    {
      "id": 55,
      "start": 2622.52,
      "end": 2625.22,
      "formatted_start": "00:43:42.520",
      "formatted_end": "00:43:45.220",
      "text": "۱۰ روز کشید کم شد ۱۰ روز دمام"
    },
    {
      "id": 56,
      "start": 2625.22,
      "end": 2627.22,
      "formatted_start": "00:43:45.220",
      "formatted_end": "00:43:47.220",
      "text": "خب ببینیم داروهای اینجوری داشتی هست"
    },
    {
      "id": 57,
      "start": 2627.22,
      "end": 2629.22,
      "formatted_start": "00:43:47.220",
      "formatted_end": "00:43:49.220",
      "text": "هردوکسا"
    },
    {
      "id": 58,
      "start": 2629.22,
      "end": 2631.22,
      "formatted_start": "00:43:49.220",
      "formatted_end": "00:43:51.220",
      "text": "هردوکسا"
    },
    {
      "id": 59,
      "start": 2631.22,
      "end": 2633.22,
      "formatted_start": "00:43:51.220",
      "formatted_end": "00:43:53.220",
      "text": "دارو تصمیم ندارن"
    },
    {
      "id": 60,
      "start": 2633.22,
      "end": 2635.22,
      "formatted_start": "00:43:53.220",
      "formatted_end": "00:43:55.220",
      "text": "ندارن"
    },
    {
      "id": 61,
      "start": 2635.22,
      "end": 2637.22,
      "formatted_start": "00:43:55.220",
      "formatted_end": "00:43:57.220",
      "text": "بلی خب خود"
    },
    {
      "id": 62,
      "start": 2637.22,
      "end": 2639.22,
      "formatted_start": "00:43:57.220",
      "formatted_end": "00:43:59.220",
      "text": "کم شدن سایز دور شکر"
    },
    {
      "id": 63,
      "start": 2639.22,
      "end": 2641.22,
      "formatted_start": "00:43:59.220",
      "formatted_end": "00:44:01.220",
      "text": "تخت راست بکشه"
    },
    {
      "id": 64,
      "start": 2641.22,
      "end": 2643.22,
      "formatted_start": "00:44:01.220",
      "formatted_end": "00:44:03.220",
      "text": "و شکر میکنن"
    },
    {
      "id": 65,
      "start": 2643.22,
      "end": 2645.22,
      "formatted_start": "00:44:03.220",
      "formatted_end": "00:44:05.220",
      "text": "این طرف فرمو"
    },
    {
      "id": 66,
      "start": 2645.22,
      "end": 2647.22,
      "formatted_start": "00:44:05.220",
      "formatted_end": "00:44:07.220",
      "text": "دارو که ای داری کم شده بود"
    },
    {
      "id": 67,
      "start": 2647.22,
      "end": 2649.22,
      "formatted_start": "00:44:07.220",
      "formatted_end": "00:44:09.220",
      "text": "دوباره دارو که فرم شده دوباره شروع شده"
    },
    {
      "id": 68,
      "start": 2649.22,
      "end": 2651.22,
      "formatted_start": "00:44:09.220",
      "formatted_end": "00:44:11.220",
      "text": "سمت راست بود"
    },
    {
      "id": 69,
      "start": 2651.22,
      "end": 2653.22,
      "formatted_start": "00:44:11.220",
      "formatted_end": "00:44:13.220",
      "text": "و چفت بود"
    },
    {
      "id": 70,
      "start": 2653.22,
      "end": 2655.22,
      "formatted_start": "00:44:13.220",
      "formatted_end": "00:44:15.220",
      "text": "این کمسول الهرشی بکس داره"
    },
    {
      "id": 71,
      "start": 2655.22,
      "end": 2657.22,
      "formatted_start": "00:44:15.220",
      "formatted_end": "00:44:17.220",
      "text": "و اون خستگی که میگفتی الهرشی بکس داره"
    },
    {
      "id": 72,
      "start": 2657.22,
      "end": 2659.22,
      "formatted_start": "00:44:17.220",
      "formatted_end": "00:44:19.220",
      "text": "تو خستگی که میخورم چیه؟"
    },
    {
      "id": 73,
      "start": 2659.22,
      "end": 2661.22,
      "formatted_start": "00:44:19.220",
      "formatted_end": "00:44:21.220",
      "text": "خستگی که برم"
    },
    {
      "id": 74,
      "start": 2661.22,
      "end": 2663.22,
      "formatted_start": "00:44:21.220",
      "formatted_end": "00:44:23.220",
      "text": "نه نه"
    },
    {
      "id": 75,
      "start": 2663.22,
      "end": 2665.22,
      "formatted_start": "00:44:23.220",
      "formatted_end": "00:44:25.220",
      "text": "و فرضش میتونی بکنی؟"
    },
    {
      "id": 76,
      "start": 2665.22,
      "end": 2667.22,
      "formatted_start": "00:44:25.220",
      "formatted_end": "00:44:27.220",
      "text": "پیاده نمیدونم"
    },
    {
      "id": 77,
      "start": 2667.22,
      "end": 2669.22,
      "formatted_start": "00:44:27.220",
      "formatted_end": "00:44:29.220",
      "text": "شرح نمیدونی"
    },
    {
      "id": 78,
      "start": 2669.22,
      "end": 2671.22,
      "formatted_start": "00:44:29.220",
      "formatted_end": "00:44:31.220",
      "text": "کمه؟"
    },
    {
      "id": 79,
      "start": 2671.22,
      "end": 2673.22,
      "formatted_start": "00:44:31.220",
      "formatted_end": "00:44:33.220",
      "text": "باید بیایید طولی که خیست عرق بشین"
    },
    {
      "id": 80,
      "start": 2673.22,
      "end": 2675.22,
      "formatted_start": "00:44:33.220",
      "formatted_end": "00:44:35.220",
      "text": "بباس تو اینجوری بکنی"
    },
    {
      "id": 81,
      "start": 2675.22,
      "end": 2677.22,
      "formatted_start": "00:44:35.220",
      "formatted_end": "00:44:37.220",
      "text": "شرور رو بگذاری"
    },
    {
      "id": 82,
      "start": 2677.22,
      "end": 2679.22,
      "formatted_start": "00:44:37.220",
      "formatted_end": "00:44:39.220",
      "text": "این عرق است"
    },
    {
      "id": 83,
      "start": 2679.22,
      "end": 2681.22,
      "formatted_start": "00:44:39.220",
      "formatted_end": "00:44:41.220",
      "text": "وزن کمه بگذار"
    },
    {
      "id": 84,
      "start": 2681.22,
      "end": 2686.22,
      "formatted_start": "00:44:41.220",
      "formatted_end": "00:44:46.220",
      "text": "هم هم زوردن شکلت رفته ممانعته داره"
    },
    {
      "id": 85,
      "start": 2686.22,
      "end": 2690.22,
      "formatted_start": "00:44:46.220",
      "formatted_end": "00:44:50.220",
      "text": "چربی صفت به چربی شل تر کشی"
    },
    {
      "id": 86,
      "start": 2690.22,
      "end": 2692.22,
      "formatted_start": "00:44:50.220",
      "formatted_end": "00:44:52.220",
      "text": "تموم شده ردکسا؟"
    },
    {
      "id": 87,
      "start": 2692.22,
      "end": 2694.22,
      "formatted_start": "00:44:52.220",
      "formatted_end": "00:44:54.220",
      "text": "داران خوردن تموم شده"
    },
    {
      "id": 88,
      "start": 2694.22,
      "end": 2697.22,
      "formatted_start": "00:44:54.220",
      "formatted_end": "00:44:57.220",
      "text": "برای یه دونه اون کاشه وزیر بودی بزرگه مونده"
    },
    {
      "id": 89,
      "start": 2697.22,
      "end": 2700.22,
      "formatted_start": "00:44:57.220",
      "formatted_end": "00:45:00.220",
      "text": "از پرسای از سالون همه ش تموم شده"
    }
  ],
  "status": "completed"
}