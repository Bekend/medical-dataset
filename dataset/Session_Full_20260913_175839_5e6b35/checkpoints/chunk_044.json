    {
      "id": 2,
      "start": 13260.0,
      "end": 13263.0,
      "formatted_start": "03:41:00.000",
      "formatted_end": "03:41:03.000",
      "text": "برگردید. برگردید."
    },
    {
      "id": 3,
      "start": 13263.0,
      "end": 13265.0,
      "formatted_start": "03:41:03.000",
      "formatted_end": "03:41:05.000",
      "text": "آنها برگردید."
    },
    {
      "id": 4,
      "start": 13265.0,
      "end": 13267.0,
      "formatted_start": "03:41:05.000",
      "formatted_end": "03:41:07.000",
      "text": "آنها برگردید."
    },
    {
      "id": 5,
      "start": 13269.0,
      "end": 13272.0,
      "formatted_start": "03:41:09.000",
      "formatted_end": "03:41:12.000",
      "text": "این روزی را از کف بگیرد."
    },
    {
      "id": 6,
      "start": 13272.0,
      "end": 13276.0,
      "formatted_start": "03:41:12.000",
      "formatted_end": "03:41:16.000",
      "text": "از این کم ها داری؟"
    },
    {
      "id": 7,
      "start": 13276.0,
      "end": 13278.0,
      "formatted_start": "03:41:16.000",
      "formatted_end": "03:41:18.000",
      "text": "نه"
    },
    {
      "id": 8,
      "start": 13278.0,
      "end": 13280.0,
      "formatted_start": "03:41:18.000",
      "formatted_end": "03:41:20.000",
      "text": "باید باز کنیم"
    },
    {
      "id": 9,
      "start": 13280.0,
      "end": 13282.0,
      "formatted_start": "03:41:20.000",
      "formatted_end": "03:41:22.000",
      "text": "خونه نداری از این؟"
    },
    {
      "id": 10,
