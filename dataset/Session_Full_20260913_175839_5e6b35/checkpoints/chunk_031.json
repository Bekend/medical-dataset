  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9309.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:09.000",
      "text": "باید دو روز پریویدی دارم، از اون دیگه قطع میشه، مثلا روز ۵۶ روز اونجا در شده."
    },
    {
      "id": 1,
      "start": 9309.0,
      "end": 9311.0,
      "formatted_start": "02:35:09.000",
      "formatted_end": "02:35:11.000",
      "text": "سولونارافین نبوده اینجا؟"
    },
    {
      "id": 2,
      "start": 9311.0,
      "end": 9319.0,
      "formatted_start": "02:35:11.000",
      "formatted_end": "02:35:19.000",
      "text": "نه، سولونارافین نبوده اینجا، ولی سولونارافین هفته یه روز شده، ۶۶ روز هم برده اینجا."
    },
    {
      "id": 3,
      "start": 9319.0,
      "end": 9321.0,
      "formatted_start": "02:35:19.000",
      "formatted_end": "02:35:21.000",
      "text": "خواهش انجام داد؟"
    },
    {
      "id": 4,
      "start": 9321.0,
      "end": 9323.0,
      "formatted_start": "02:35:21.000",
      "formatted_end": "02:35:23.000",
      "text": "نه، میوم نه."
    },
    {
      "id": 5,
      "start": 9323.0,
      "end": 9326.66,
      "formatted_start": "02:35:23.000",
      "formatted_end": "02:35:26.660",
      "text": "کابسولندرافی رو که چون بوده تصویر حقیق داشتن گردی؟"
    },
    {
      "id": 6,
      "start": 9326.66,
      "end": 9329.76,
      "formatted_start": "02:35:26.660",
      "formatted_end": "02:35:29.760",
      "text": "می اومدن، می اومدن، آره"
    },
    {
      "id": 7,
      "start": 9329.76,
      "end": 9333.04,
      "formatted_start": "02:35:29.760",
      "formatted_end": "02:35:33.040",
      "text": "هشت بود، هفت بود، چند تا بودن"
    },
    {
      "id": 8,
      "start": 9333.04,
      "end": 9333.76,
      "formatted_start": "02:35:33.040",
      "formatted_end": "02:35:33.760",
      "text": "چند تا بود؟"
    },
    {
      "id": 9,
      "start": 9333.76,
      "end": 9341.12,
      "formatted_start": "02:35:33.760",
      "formatted_end": "02:35:41.120",
      "text": "آره جدا از اون من اران روز شیش اون فیلوگی، یا هفته اون فیلوگی، شیش هفته اون فیلوگی من"
    },
    {
      "id": 10,
      "start": 9341.12,
      "end": 9344.98,
      "formatted_start": "02:35:41.120",
      "formatted_end": "02:35:44.980",
      "text": "تکیفی نیم ندارم چون قرصه ایرگیرون می داد"
    },
    {
      "id": 11,
      "start": 9344.98,
      "end": 9347.94,
      "formatted_start": "02:35:44.980",
      "formatted_end": "02:35:47.940",
      "text": "سه شب استفاده کردم، فرق قرصه ایرگیرون می داد"
    },
    {
      "id": 12,
      "start": 9347.94,
      "end": 9350.94,
      "formatted_start": "02:35:47.940",
      "formatted_end": "02:35:50.940",
      "text": "و روش جوبیدی هم طبیعی بوده"
    },
    {
      "id": 13,
      "start": 9352.94,
      "end": 9356.94,
      "formatted_start": "02:35:52.940",
      "formatted_end": "02:35:56.940",
      "text": "پریشت جوبیدی نکردم و من اصلا راضی نیستم از این کار"
    },
    {
      "id": 14,
      "start": 9356.94,
      "end": 9358.94,
      "formatted_start": "02:35:56.940",
      "formatted_end": "02:35:58.940",
      "text": "امروز روز چند رو بود توره؟"
    },
    {
      "id": 15,
      "start": 9359.94,
      "end": 9363.94,
      "formatted_start": "02:35:59.940",
      "formatted_end": "02:36:03.940",
      "text": "چار شمبه، پنج شمبه، جونش شمبه، یک شمبه، دوش شمبه هست؟"
    },
    {
      "id": 16,
      "start": 9363.94,
      "end": 9364.94,
      "formatted_start": "02:36:03.940",
      "formatted_end": "02:36:04.940",
      "text": "سه شمبه"
    },
    {
      "id": 17,
      "start": 9364.94,
      "end": 9366.94,
      "formatted_start": "02:36:04.940",
      "formatted_end": "02:36:06.940",
      "text": "سه شمبه، امروز روز هفته اون بود"
    },
    {
      "id": 18,
      "start": 9366.94,
      "end": 9368.94,
      "formatted_start": "02:36:06.940",
      "formatted_end": "02:36:08.940",
      "text": "روز هفته اون بود، شما پریشت نستی؟"
    },
    {
      "id": 19,
      "start": 9368.94,
      "end": 9369.94,
      "formatted_start": "02:36:08.940",
      "formatted_end": "02:36:09.940",
      "text": "پریشت"
    },
    {
      "id": 20,
      "start": 9369.94,
      "end": 9370.94,
      "formatted_start": "02:36:09.940",
      "formatted_end": "02:36:10.940",
      "text": "ساردار نمیشه"
    },
    {
      "id": 21,
      "start": 9370.94,
      "end": 9372.94,
      "formatted_start": "02:36:10.940",
      "formatted_end": "02:36:12.940",
      "text": "نمیشه"
    },
    {
      "id": 22,
      "start": 9372.94,
      "end": 9377.94,
      "formatted_start": "02:36:12.940",
      "formatted_end": "02:36:17.940",
      "text": "خدا خورم برمان چون سر بچه دومی من همینجوری با یک مرحله بارداروز"
    },
    {
      "id": 23,
      "start": 9377.94,
      "end": 9380.94,
      "formatted_start": "02:36:17.940",
      "formatted_end": "02:36:20.940",
      "text": "ده همه قایده که باید بگذره"
    },
    {
      "id": 24,
      "start": 9380.94,
      "end": 9385.94,
      "formatted_start": "02:36:20.940",
      "formatted_end": "02:36:25.940",
      "text": "ده همه قایده که نمیتونه بارداروز"
    },
    {
      "id": 25,
      "start": 9385.94,
      "end": 9389.94,
      "formatted_start": "02:36:25.940",
      "formatted_end": "02:36:29.940",
      "text": "من گفتم شما دارو ای چیزی واسه کنسو کردنش"
    },
    {
      "id": 26,
      "start": 9389.94,
      "end": 9395.94,
      "formatted_start": "02:36:29.940",
      "formatted_end": "02:36:35.940",
      "text": "اگه ایام قایده کهتون درست شما فرمایید که چند روز لکه داشتید"
    },
    {
      "id": 27,
      "start": 9395.94,
      "end": 9397.94,
      "formatted_start": "02:36:35.940",
      "formatted_end": "02:36:37.940",
      "text": "بعد عادت شدید؟"
    },
    {
      "id": 28,
      "start": 9397.94,
      "end": 9398.94,
      "formatted_start": "02:36:37.940",
      "formatted_end": "02:36:38.940",
      "text": "آره"
    },
    {
      "id": 29,
      "start": 9398.94,
      "end": 9399.94,
      "formatted_start": "02:36:38.940",
      "formatted_end": "02:36:39.940",
      "text": "عادتون چند روز شده؟ سه روز؟"
    },
    {
      "id": 30,
      "start": 9399.94,
      "end": 9400.94,
      "formatted_start": "02:36:39.940",
      "formatted_end": "02:36:40.940",
      "text": "دو روز"
    },
    {
      "id": 31,
      "start": 9400.94,
      "end": 9401.94,
      "formatted_start": "02:36:40.940",
      "formatted_end": "02:36:41.940",
      "text": "دو روز؟"
    },
    {
      "id": 32,
      "start": 9401.94,
      "end": 9403.94,
      "formatted_start": "02:36:41.940",
      "formatted_end": "02:36:43.940",
      "text": "دو روز، بعد میشه روز سه بوم، نقایه بازی"
    },
    {
      "id": 33,
      "start": 9403.94,
      "end": 9405.94,
      "formatted_start": "02:36:43.940",
      "formatted_end": "02:36:45.940",
      "text": "و خورس جنگی رو از که شروع کردی؟"
    },
    {
      "id": 34,
      "start": 9405.94,
      "end": 9407.94,
      "formatted_start": "02:36:45.940",
      "formatted_end": "02:36:47.940",
      "text": "به هم باز بودن شب چهارم باید"
    },
    {
      "id": 35,
      "start": 9407.94,
      "end": 9408.94,
      "formatted_start": "02:36:47.940",
      "formatted_end": "02:36:48.940",
      "text": "چهارم بیشتر"
    },
    {
      "id": 36,
      "start": 9408.94,
      "end": 9409.94,
      "formatted_start": "02:36:48.940",
      "formatted_end": "02:36:49.940",
      "text": "از این شب"
    },
    {
      "id": 37,
      "start": 9409.94,
      "end": 9410.94,
      "formatted_start": "02:36:49.940",
      "formatted_end": "02:36:50.940",
      "text": "الان چند تا خوردی؟"
    },
    {
      "id": 38,
      "start": 9410.94,
      "end": 9412.94,
      "formatted_start": "02:36:50.940",
      "formatted_end": "02:36:52.940",
      "text": "سه بومی"
    },
    {
      "id": 39,
      "start": 9412.94,
      "end": 9414.94,
      "formatted_start": "02:36:52.940",
      "formatted_end": "02:36:54.940",
      "text": "یکمزه"
    },
    {
      "id": 40,
      "start": 9414.94,
      "end": 9416.94,
      "formatted_start": "02:36:54.940",
      "formatted_end": "02:36:56.940",
      "text": "کن سه بومی دیشتر خوردم"
    },
    {
      "id": 41,
      "start": 9416.94,
      "end": 9418.94,
      "formatted_start": "02:36:56.940",
      "formatted_end": "02:36:58.940",
      "text": "سه بومی رو دیشتر خوردید؟"
    },
    {
      "id": 42,
      "start": 9418.94,
      "end": 9421.38,
      "formatted_start": "02:36:58.940",
      "formatted_end": "02:37:01.380",
      "text": "شما روز اولی رو که خورده بودین نزدیک کردین"
    },
    {
      "id": 43,
      "start": 9421.38,
      "end": 9421.88,
      "formatted_start": "02:37:01.380",
      "formatted_end": "02:37:01.880",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 9421.88,
      "end": 9424.52,
      "formatted_start": "02:37:01.880",
      "formatted_end": "02:37:04.520",
      "text": "روز دراز کشید شکمی بودین هم"
    },
    {
      "id": 45,
      "start": 9424.52,
      "end": 9426.9,
      "formatted_start": "02:37:04.520",
      "formatted_end": "02:37:06.900",
      "text": "الان دگرانی تو میشتر بار دارید"
    },
    {
      "id": 46,
      "start": 9426.9,
      "end": 9428.12,
      "formatted_start": "02:37:06.900",
      "formatted_end": "02:37:08.120",
      "text": "آره چون من چندان"
    },
    {
      "id": 47,
      "start": 9428.12,
      "end": 9431.1,
      "formatted_start": "02:37:08.120",
      "formatted_end": "02:37:11.100",
      "text": "کلاش جنیتیک مافق سازایی"
    },
    {
      "id": 48,
      "start": 9431.1,
      "end": 9431.66,
      "formatted_start": "02:37:11.100",
      "formatted_end": "02:37:11.660",
      "text": "بله بله"
    },
    {
      "id": 49,
      "start": 9431.66,
      "end": 9434.66,
      "formatted_start": "02:37:11.660",
      "formatted_end": "02:37:14.660",
      "text": "اگه با من طور دار باشم واسه دخترم رو با من شویم"
    },
    {
      "id": 50,
      "start": 9434.66,
      "end": 9436.58,
      "formatted_start": "02:37:14.660",
      "formatted_end": "02:37:16.580",
      "text": "بله انشاءالله"
    },
    {
      "id": 51,
      "start": 9436.58,
      "end": 9437.64,
      "formatted_start": "02:37:16.580",
      "formatted_end": "02:37:17.640",
      "text": "چند تا اراد دارید؟"
    },
    {
      "id": 52,
      "start": 9437.64,
      "end": 9438.98,
      "formatted_start": "02:37:17.640",
      "formatted_end": "02:37:18.980",
      "text": "دخترم"
    },
    {
      "id": 53,
      "start": 9438.98,
      "end": 9443.62,
      "formatted_start": "02:37:18.980",
      "formatted_end": "02:37:23.620",
      "text": "الان مامانو هم رو نمیشی"
    },
    {
      "id": 54,
      "start": 9443.62,
      "end": 9444.98,
      "formatted_start": "02:37:23.620",
      "formatted_end": "02:37:24.980",
      "text": "آقایی خب برای بچه ماند"
    },
    {
      "id": 55,
      "start": 9444.98,
      "end": 9445.18,
      "formatted_start": "02:37:24.980",
      "formatted_end": "02:37:25.180",
      "text": "بله"
    },
    {
      "id": 56,
      "start": 9445.18,
      "end": 9449.18,
      "formatted_start": "02:37:25.180",
      "formatted_end": "02:37:29.180",
      "text": "بگیرم که از این وضعیت بردنش شده"
    },
    {
      "id": 57,
      "start": 9449.18,
      "end": 9451.18,
      "formatted_start": "02:37:29.180",
      "formatted_end": "02:37:31.180",
      "text": "ترکیه ایتانه جا"
    },
    {
      "id": 58,
      "start": 9451.18,
      "end": 9453.18,
      "formatted_start": "02:37:31.180",
      "formatted_end": "02:37:33.180",
      "text": "یکمه"
    },
    {
      "id": 59,
      "start": 9453.18,
      "end": 9457.18,
      "formatted_start": "02:37:33.180",
      "formatted_end": "02:37:37.180",
      "text": "خب من اینجا یه مدار زیاد بشم و میدم براحت میشیم"
    },
    {
      "id": 60,
      "start": 9457.18,
      "end": 9459.18,
      "formatted_start": "02:37:37.180",
      "formatted_end": "02:37:39.180",
      "text": "اون موقعی که به اوجزی کفتم"
    },
    {
      "id": 61,
      "start": 9459.18,
      "end": 9461.18,
      "formatted_start": "02:37:39.180",
      "formatted_end": "02:37:41.180",
      "text": "مقدارون باید سه پشار گذاریم"
    },
    {
      "id": 62,
      "start": 9461.18,
      "end": 9463.18,
      "formatted_start": "02:37:41.180",
      "formatted_end": "02:37:43.180",
      "text": "حالا میشم"
    },
    {
      "id": 63,
      "start": 9463.18,
      "end": 9465.18,
      "formatted_start": "02:37:43.180",
      "formatted_end": "02:37:45.180",
      "text": "از اینکه"
    },
    {
      "id": 64,
      "start": 9465.18,
      "end": 9467.18,
      "formatted_start": "02:37:45.180",
      "formatted_end": "02:37:47.180",
      "text": "حاضر کنیم"
    },
    {
      "id": 65,
      "start": 9467.18,
      "end": 9469.18,
      "formatted_start": "02:37:47.180",
      "formatted_end": "02:37:49.180",
      "text": "دوباره بشم"
    },
    {
      "id": 66,
      "start": 9469.18,
      "end": 9473.18,
      "formatted_start": "02:37:49.180",
      "formatted_end": "02:37:53.180",
      "text": "نه شما اصلا"
    },
    {
      "id": 67,
      "start": 9473.18,
      "end": 9475.18,
      "formatted_start": "02:37:53.180",
      "formatted_end": "02:37:55.180",
      "text": "به بارداری فکر کنید"
    },
    {
      "id": 68,
      "start": 9475.18,
      "end": 9481.18,
      "formatted_start": "02:37:55.180",
      "formatted_end": "02:38:01.180",
      "text": "حالا اتناس بخواهیم تا زمان تا کم بزاری اونجا زندگی میکنه و بعدش کمسان میشه"
    },
    {
      "id": 69,
      "start": 9481.18,
      "end": 9483.18,
      "formatted_start": "02:38:01.180",
      "formatted_end": "02:38:03.180",
      "text": "برای خب از اینجا ایده"
    },
    {
      "id": 70,
      "start": 9483.18,
      "end": 9485.18,
      "formatted_start": "02:38:03.180",
      "formatted_end": "02:38:05.180",
      "text": "نه اینکه از اینجا برگویم"
    },
    {
      "id": 71,
      "start": 9485.18,
      "end": 9487.18,
      "formatted_start": "02:38:05.180",
      "formatted_end": "02:38:07.180",
      "text": "اولی سرگشت"
    },
    {
      "id": 72,
      "start": 9487.18,
      "end": 9491.18,
      "formatted_start": "02:38:07.180",
      "formatted_end": "02:38:11.180",
      "text": "سرگشت چند تومه داریم؟"
    },
    {
      "id": 73,
      "start": 9491.18,
      "end": 9493.18,
      "formatted_start": "02:38:11.180",
      "formatted_end": "02:38:13.180",
      "text": "آزاد بگیم"
    },
    {
      "id": 74,
      "start": 9493.18,
      "end": 9495.18,
      "formatted_start": "02:38:13.180",
      "formatted_end": "02:38:15.180",
      "text": "دوباره من برگمشم"
    },
    {
      "id": 75,
      "start": 9499.18,
      "end": 9501.18,
      "formatted_start": "02:38:19.180",
      "formatted_end": "02:38:21.180",
      "text": "چون مشکل دانبارواری دارید یکم"
    },
    {
      "id": 76,
      "start": 9501.18,
      "end": 9507.18,
      "formatted_start": "02:38:21.180",
      "formatted_end": "02:38:27.180",
      "text": "یکم دارید که این حساب برای باردار شدن شما باید مدتی داروم هستن"
    },
    {
      "id": 77,
      "start": 9507.18,
      "end": 9509.18,
      "formatted_start": "02:38:27.180",
      "formatted_end": "02:38:29.180",
      "text": "از این نیوم هست نه؟"
    },
    {
      "id": 78,
      "start": 9509.18,
      "end": 9513.18,
      "formatted_start": "02:38:29.180",
      "formatted_end": "02:38:33.180",
      "text": "هم نیوم هست هم نوله هست"
    },
    {
      "id": 79,
      "start": 9513.18,
      "end": 9517.18,
      "formatted_start": "02:38:33.180",
      "formatted_end": "02:38:37.180",
      "text": "نوله چپ دارید که چوردگی داره"
    },
    {
      "id": 80,
      "start": 9517.18,
      "end": 9520.18,
      "formatted_start": "02:38:37.180",
      "formatted_end": "02:38:40.180",
      "text": "کار باردار راحت هم ندارید"
    },
    {
      "id": 81,
      "start": 9520.18,
      "end": 9524.18,
      "formatted_start": "02:38:40.180",
      "formatted_end": "02:38:44.180",
      "text": "اعتبار از سر همون سزاریانه اینجوری شده"
    },
    {
      "id": 82,
      "start": 9524.18,
      "end": 9528.18,
      "formatted_start": "02:38:44.180",
      "formatted_end": "02:38:48.180",
      "text": "باقی دخت دوست نوله رو خیلی چکم دارید"
    },
    {
      "id": 83,
      "start": 9528.18,
      "end": 9531.18,
      "formatted_start": "02:38:48.180",
      "formatted_end": "02:38:51.180",
      "text": "از بچه اول از میام داشتم و از صبرای نه داشتم"
    },
    {
      "id": 84,
      "start": 9531.18,
      "end": 9533.18,
      "formatted_start": "02:38:51.180",
      "formatted_end": "02:38:53.180",
      "text": "نه نه میام زیده تون رو اشکال کردن"
    },
    {
      "id": 85,
      "start": 9533.18,
      "end": 9535.18,
      "formatted_start": "02:38:53.180",
      "formatted_end": "02:38:55.180",
      "text": "ازشون مشکل روله دارید"
    },
    {
      "id": 86,
      "start": 9535.18,
      "end": 9537.18,
      "formatted_start": "02:38:55.180",
      "formatted_end": "02:38:57.180",
      "text": "مشکل روله سمت چپ دارید"
    },
    {
      "id": 87,
      "start": 9537.18,
      "end": 9539.18,
      "formatted_start": "02:38:57.180",
      "formatted_end": "02:38:59.180",
      "text": "راستون هم زیاد جالب نمیده"
    },
    {
      "id": 88,
      "start": 9539.18,
      "end": 9541.18,
      "formatted_start": "02:38:59.180",
      "formatted_end": "02:39:01.180",
      "text": "تنگه ولی چین ورد برات هم"
    },
    {
      "id": 89,
      "start": 9541.18,
      "end": 9544.18,
      "formatted_start": "02:39:01.180",
      "formatted_end": "02:39:04.180",
      "text": "از دختر زید در روی باید استفاده کنیم یا نه؟"
    },
    {
      "id": 90,
      "start": 9544.18,
      "end": 9548.18,
      "formatted_start": "02:39:04.180",
      "formatted_end": "02:39:08.180",
      "text": "دختر خصوصا به مرد مردو تا زن برات"
    },
    {
      "id": 91,
      "start": 9548.18,
      "end": 9551.18,
      "formatted_start": "02:39:08.180",
      "formatted_end": "02:39:11.180",
      "text": "و خوردو خوردو لایت کنن یا نه؟"
    },
    {
      "id": 92,
      "start": 9551.18,
      "end": 9560.98,
      "formatted_start": "02:39:11.180",
      "formatted_end": "02:39:20.980",
      "text": "از دو جور اسپرم داریم. اسپرم ها وزیر یکس هم وزیر یکرگ هستن. اگه یکرگ لقاف بیدا کنه، پسر میشه."
    },
    {
      "id": 93,
      "start": 9560.98,
      "end": 9567.98,
      "formatted_start": "02:39:20.980",
      "formatted_end": "02:39:27.980",
      "text": "یکس لقاف بیدا کنه، دختر میشه. خانم خیلی لفتی نداره. میمربوطه محیط باشن، عصیبی هستن."
    },
    {
      "id": 94,
      "start": 9567.98,
      "end": 9570.98,
      "formatted_start": "02:39:27.980",
      "formatted_end": "02:39:30.980",
      "text": "مربوط به جینتیک آقا داره."
    },
    {
      "id": 95,
      "start": 9570.98,
      "end": 9574.98,
      "formatted_start": "02:39:30.980",
      "formatted_end": "02:39:34.980",
      "text": "هر دو هر خورد خورد خورد که افرادیتی بازم تصویر نداره."
    },
    {
      "id": 96,
      "start": 9574.98,
      "end": 9580.98,
      "formatted_start": "02:39:34.980",
      "formatted_end": "02:39:40.980",
      "text": "اگر دختر هایی باشه اون ریسپرم X غالب باشه از روی اسپرم میتونین بگیر"
    },
    {
      "id": 97,
      "start": 9580.98,
      "end": 9584.98,
      "formatted_start": "02:39:40.980",
      "formatted_end": "02:39:44.980",
      "text": "و اگر بخواید هر موقع انتخاب چیز داشته باشید"
    },
    {
      "id": 98,
      "start": 9584.98,
      "end": 9588.98,
      "formatted_start": "02:39:44.980",
      "formatted_end": "02:39:48.980",
      "text": "الان یک کامال باشین رو باید بدم و برای شون استفاده کنید"
    },
    {
      "id": 99,
      "start": 9588.98,
      "end": 9596.98,
      "formatted_start": "02:39:48.980",
      "formatted_end": "02:39:56.980",
      "text": "کلیندر ماکسی ای اعتهاق باشند و انتهاق برای میامتون رو کم بکنه"
    },
    {
      "id": 100,
      "start": 9596.98,
      "end": 9598.98,
      "formatted_start": "02:39:56.980",
