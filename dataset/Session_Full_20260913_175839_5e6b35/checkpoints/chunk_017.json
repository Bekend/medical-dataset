  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5130.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:30.000",
      "text": "نه، بابا، میدونم، چون مختلف شما نمیدونیم، حتما این برزین باید درمان شد، چون این در خانه ها، این خطرات داخلی داره این اگه درمان نکنیم، برای مرد خطر نداره، مرد فقط نشان دیده، ولی اگه زن رو درمان نکنیم، که اینشون حتما داشته کشان گرفتید، این برای زن میتونه مخاطرات سیلوکس، تشکرات جراحی هم کشیده در دراز با درخلا، ولی برای زن علامت این نداره متص"
    },
    {
      "id": 1,
      "start": 5130.0,
      "end": 5153.24,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:53.240",
      "text": "اینجا بگیرد سبت کنم برای اون مسئله خیلی تا گلو که میگید و ناقتیه برکشت رسیده میده"
    },
    {
      "id": 2,
      "start": 5153.24,
      "end": 5155.24,
      "formatted_start": "01:25:53.240",
      "formatted_end": "01:25:55.240",
      "text": "توشتون رو سوزشون؟"
    },
    {
      "id": 3,
      "start": 5155.24,
      "end": 5157.24,
      "formatted_start": "01:25:55.240",
      "formatted_end": "01:25:57.240",
      "text": "توشتون رو سوزشون، اون برگشت بلغمه"
    },
    {
      "id": 4,
      "start": 5157.24,
      "end": 5161.24,
      "formatted_start": "01:25:57.240",
      "formatted_end": "01:26:01.240",
      "text": "درمی گرده تفخی خاصی باید صبح این که"
    },
    {
      "id": 5,
      "start": 5161.24,
      "end": 5163.24,
      "formatted_start": "01:26:01.240",
      "formatted_end": "01:26:03.240",
      "text": "تا یه روز انتفاق رو رسید بیشتر؟"
    },
    {
      "id": 6,
      "start": 5163.24,
      "end": 5167.24,
      "formatted_start": "01:26:03.240",
      "formatted_end": "01:26:07.240",
      "text": "بله، اون شب که میخوابید این سوزتی بیشتر میاد"
    },
    {
      "id": 7,
      "start": 5167.24,
      "end": 5169.24,
      "formatted_start": "01:26:07.240",
      "formatted_end": "01:26:09.240",
      "text": "روزها و صبح ها مخصوصا بیشتر میدن"
    },
    {
      "id": 8,
      "start": 5169.24,
      "end": 5176.24,
      "formatted_start": "01:26:09.240",
      "formatted_end": "01:26:16.240",
      "text": "خب بیماری ریپلاکسه، اون بیماری مهمیه اگه خوب درمان نشه"
    },
    {
      "id": 9,
      "start": 5176.24,
      "end": 5181.62,
      "formatted_start": "01:26:16.240",
      "formatted_end": "01:26:21.620",
      "text": "مقدمه ای هست برای دور از جنگ دور از جنگ سرطان مری ای کنید"
    },
    {
      "id": 10,
      "start": 5181.62,
      "end": 5186.12,
      "formatted_start": "01:26:21.620",
      "formatted_end": "01:26:26.120",
      "text": "چون این برگشت مختبیات میده برای مری مناسب نیست"
    },
    {
      "id": 11,
      "start": 5186.12,
      "end": 5191.22,
      "formatted_start": "01:26:26.120",
      "formatted_end": "01:26:31.220",
      "text": "باید حتما درمان بشید شما اونو به شکل تلقیه دهان و خلط بشکرد و ایزا میبینید"
    },
    {
      "id": 12,
      "start": 5191.22,
      "end": 5196.42,
      "formatted_start": "01:26:31.220",
      "formatted_end": "01:26:36.420",
      "text": "ولی باید از این طرف برای صراحتیتون اون درمان بشید و باید مراجعه بکنید"
    },
    {
      "id": 13,
      "start": 5196.42,
      "end": 5202.52,
      "formatted_start": "01:26:36.420",
      "formatted_end": "01:26:42.520",
      "text": "پوستتون 99% با این یه نسخه برطرف میشه و اگه بعد دو هفته باقی مان میان"
    },
    {
      "id": 14,
      "start": 5202.52,
      "end": 5211.52,
      "formatted_start": "01:26:42.520",
      "formatted_end": "01:26:51.520",
      "text": "ولی برای این مسئلهی که گفتید که تو دهانه احساس می کنید، این دورها تقریبا روبه اتمام رفت که میشه دو هفته مراجعه بکنید."
    },
    {
      "id": 15,
      "start": 5211.52,
      "end": 5214.52,
      "formatted_start": "01:26:51.520",
      "formatted_end": "01:26:54.520",
      "text": "خب، برای خانم هم یه نسخه هست، همین کافیه."
    },
    {
      "id": 16,
      "start": 5214.52,
      "end": 5217.52,
      "formatted_start": "01:26:54.520",
      "formatted_end": "01:26:57.520",
      "text": "بردونجا صفتش بکنم و بعد برسید."
    },
    {
      "id": 17,
      "start": 5218.52,
      "end": 5223.52,
      "formatted_start": "01:26:58.520",
      "formatted_end": "01:27:03.520",
      "text": "خانم بارانی، یه به دیگه اضافه شد در خانمش رو دارو بشن."
    },
    {
      "id": 18,
      "start": 5232.52,
      "end": 5262.52,
      "formatted_start": "01:27:12.520",
      "formatted_end": "01:27:42.520",
      "text": "در اینجا، با اینکه اینکه شب نباید بخورید، اینکه شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید شب نباید"
    },
    {
      "id": 19,
      "start": 5262.52,
      "end": 5264.52,
      "formatted_start": "01:27:42.520",
      "formatted_end": "01:27:44.520",
      "text": "تا به شبهای دسته بکن"
    },
    {
      "id": 20,
      "start": 5264.52,
      "end": 5266.52,
      "formatted_start": "01:27:44.520",
      "formatted_end": "01:27:46.520",
      "text": "و بعد"
    },
    {
      "id": 21,
      "start": 5266.52,
      "end": 5268.52,
      "formatted_start": "01:27:46.520",
      "formatted_end": "01:27:48.520",
      "text": "این سنگیری به صبحگاهیش باهم مرد میشه"
    },
    {
      "id": 22,
      "start": 5268.52,
      "end": 5272.52,
      "formatted_start": "01:27:48.520",
      "formatted_end": "01:27:52.520",
      "text": "ولی زرگاهیش مردود به آزمایش خوبیه که داشتیم به شجاعت داده"
    },
    {
      "id": 23,
      "start": 5272.52,
      "end": 5274.52,
      "formatted_start": "01:27:52.520",
      "formatted_end": "01:27:54.520",
      "text": "حالا غذا داریم خوب می کنیم"
    },
    {
      "id": 24,
      "start": 5274.52,
      "end": 5276.52,
      "formatted_start": "01:27:54.520",
      "formatted_end": "01:27:56.520",
      "text": "تو غذا بترس"
    },
    {
      "id": 25,
      "start": 5276.52,
      "end": 5278.52,
      "formatted_start": "01:27:56.520",
      "formatted_end": "01:27:58.520",
      "text": "موباره شما بود نفر قدر"
    },
    {
      "id": 26,
      "start": 5278.52,
      "end": 5282.52,
      "formatted_start": "01:27:58.520",
      "formatted_end": "01:28:02.520",
      "text": "آقای موباره شجاع بذاشت"
    },
    {
      "id": 27,
      "start": 5282.52,
      "end": 5284.52,
      "formatted_start": "01:28:02.520",
      "formatted_end": "01:28:04.520",
      "text": "بیرون داخل"
    },
    {
      "id": 28,
      "start": 5284.52,
      "end": 5286.52,
      "formatted_start": "01:28:04.520",
      "formatted_end": "01:28:06.520",
      "text": "آقای بیرون"
    },
    {
      "id": 29,
      "start": 5286.52,
      "end": 5288.52,
      "formatted_start": "01:28:06.520",
      "formatted_end": "01:28:08.520",
      "text": "از همه موشک دارم"
    },
    {
      "id": 30,
      "start": 5288.52,
      "end": 5290.52,
      "formatted_start": "01:28:08.520",
      "formatted_end": "01:28:10.520",
      "text": "چی؟"
    },
    {
      "id": 31,
      "start": 5290.52,
      "end": 5296.52,
      "formatted_start": "01:28:10.520",
      "formatted_end": "01:28:16.520",
      "text": "برای ورزش کرده از یک هفته از این جاگود روی جا اندازی تمام شد ورزش راحت شد"
    },
    {
      "id": 32,
      "start": 5296.52,
      "end": 5298.52,
      "formatted_start": "01:28:16.520",
      "formatted_end": "01:28:18.520",
      "text": "یک هفته مردید"
    },
    {
      "id": 33,
      "start": 5298.52,
      "end": 5300.52,
      "formatted_start": "01:28:18.520",
      "formatted_end": "01:28:20.520",
      "text": "او که تمام"
    },
    {
      "id": 34,
      "start": 5300.52,
      "end": 5304.52,
      "formatted_start": "01:28:20.520",
      "formatted_end": "01:28:24.520",
      "text": "حرکتی که گفتم رو تکرار بکن"
    },
    {
      "id": 35,
      "start": 5304.52,
      "end": 5307.52,
      "formatted_start": "01:28:24.520",
      "formatted_end": "01:28:27.520",
      "text": "از اون خیال صد درصد تا آخر اون راحت شد"
    },
    {
      "id": 36,
      "start": 5307.52,
      "end": 5311.52,
      "formatted_start": "01:28:27.520",
      "formatted_end": "01:28:31.520",
      "text": "مگه اگه یک وقتی دیدی مثلا یه غذایی بدی کردی تکرار شد"
    },
    {
      "id": 37,
      "start": 5311.52,
      "end": 5314.52,
      "formatted_start": "01:28:31.520",
      "formatted_end": "01:28:34.520",
      "text": "همین ورزش رو انجام بده 99 درصد بر طرف شد"
    },
    {
      "id": 38,
      "start": 5314.52,
      "end": 5316.52,
      "formatted_start": "01:28:34.520",
      "formatted_end": "01:28:36.520",
      "text": "اگه همان می آیی دقیقا بزرگ شد"
    },
    {
      "id": 39,
      "start": 5316.52,
      "end": 5318.52,
      "formatted_start": "01:28:36.520",
      "formatted_end": "01:28:38.520",
      "text": "بجیباله ها سلام"
    },
    {
      "id": 40,
      "start": 5320.52,
      "end": 5322.52,
      "formatted_start": "01:28:40.520",
      "formatted_end": "01:28:42.520",
      "text": "یاد دست داریم"
    },
    {
      "id": 41,
      "start": 5327.52,
      "end": 5333.52,
      "formatted_start": "01:28:47.520",
      "formatted_end": "01:28:53.520",
      "text": "آقایی بهتر دیگه من که چی برای از کجا شکر میدم"
    },
    {
      "id": 42,
      "start": 5334.52,
      "end": 5340.52,
      "formatted_start": "01:28:54.520",
      "formatted_end": "01:29:00.520",
      "text": "این نفسم میگیره کسی خدا نبودی که فقط این داری رو دار من که از دار"
    },
    {
      "id": 43,
      "start": 5340.52,
      "end": 5343.52,
      "formatted_start": "01:29:00.520",
      "formatted_end": "01:29:03.520",
      "text": "دنبالستان که رفتن یاد دار"
    },
    {
      "id": 44,
      "start": 5344.52,
      "end": 5347.52,
      "formatted_start": "01:29:04.520",
      "formatted_end": "01:29:07.520",
      "text": "موقع میخورم متکه خواب آورم"
    },
    {
      "id": 45,
      "start": 5347.52,
      "end": 5349.52,
      "formatted_start": "01:29:07.520",
      "formatted_end": "01:29:09.520",
      "text": "بله این مواد مخدر داره"
    },
    {
      "id": 46,
      "start": 5349.52,
      "end": 5352.52,
      "formatted_start": "01:29:09.520",
      "formatted_end": "01:29:12.520",
      "text": "همینی که بوده ها رو روی کنه"
    },
    {
      "id": 47,
      "start": 5352.52,
      "end": 5355.52,
      "formatted_start": "01:29:12.520",
      "formatted_end": "01:29:15.520",
      "text": "دیگه هیچ چیز نشب داره نداره"
    },
    {
      "id": 48,
      "start": 5355.52,
      "end": 5358.52,
      "formatted_start": "01:29:15.520",
      "formatted_end": "01:29:18.520",
      "text": "اینو میخونید راحت میخواد"
    },
    {
      "id": 49,
      "start": 5358.52,
      "end": 5362.52,
      "formatted_start": "01:29:18.520",
      "formatted_end": "01:29:22.520",
      "text": "بیشتر بخورم، این ها چیزی چهار ساعت یا کم تایمش داره"
    },
    {
      "id": 50,
      "start": 5362.52,
      "end": 5369.52,
      "formatted_start": "01:29:22.520",
      "formatted_end": "01:29:29.520",
      "text": "ولی این بدش اینه که معتاد میکنه، این پشکات مخدر داره، پشکات نداره، حالا باید بخوره دیگه"
    },
    {
      "id": 51,
      "start": 5369.52,
      "end": 5375.52,
      "formatted_start": "01:29:29.520",
      "formatted_end": "01:29:35.520",
      "text": "حالا این همون من رفتم همجور آزاد بگیرم، شاید داشته باشن"
    },
    {
      "id": 52,
      "start": 5375.52,
      "end": 5381.52,
      "formatted_start": "01:29:35.520",
      "formatted_end": "01:29:41.520",
      "text": "نه، نه، نارا نمیدن، حالا این شفیه های مختلف هم داره، حالا همین میدن براشون"
    },
    {
      "id": 53,
      "start": 5381.52,
      "end": 5386.52,
      "formatted_start": "01:29:41.520",
      "formatted_end": "01:29:46.520",
      "text": "اسمش هم هست، زانک سیاز آلپرا زولان، خب شب یک دانه بخوریم"
    },
    {
      "id": 54,
      "start": 5386.52,
      "end": 5388.52,
      "formatted_start": "01:29:46.520",
      "formatted_end": "01:29:48.520",
      "text": "این فکر بی خیال می کنه"
    },
    {
      "id": 55,
      "start": 5388.52,
      "end": 5392.52,
      "formatted_start": "01:29:48.520",
      "formatted_end": "01:29:52.520",
      "text": "یعنی دیگه موقع می خواهم اینگاه نگاه که من"
    },
    {
      "id": 56,
      "start": 5392.52,
      "end": 5395.52,
      "formatted_start": "01:29:52.520",
      "formatted_end": "01:29:55.520",
      "text": "این نفس همه آخر برای چی بگیرم"
    },
    {
      "id": 57,
      "start": 5395.52,
      "end": 5398.52,
      "formatted_start": "01:29:55.520",
      "formatted_end": "01:29:58.520",
      "text": "حسابی هم می گه حسابی، مال حسابی"
    },
    {
      "id": 58,
      "start": 5398.52,
      "end": 5399.52,
      "formatted_start": "01:29:58.520",
      "formatted_end": "01:29:59.520",
      "text": "بله، حساب"
    }
  ],
  "status": "completed"
}