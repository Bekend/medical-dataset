    {
      "id": 5,
      "start": 7884.0,
      "end": 7886.0,
      "formatted_start": "02:11:24.000",
      "formatted_end": "02:11:26.000",
      "text": "برادر راسته نباشی"
    },
    {
      "id": 6,
      "start": 7886.0,
      "end": 7888.0,
      "formatted_start": "02:11:26.000",
      "formatted_end": "02:11:28.000",
      "text": "برادر راسته نباشی"
    },
    {
      "id": 7,
      "start": 7888.0,
      "end": 7890.0,
      "formatted_start": "02:11:28.000",
      "formatted_end": "02:11:30.000",
      "text": "من سویه چه بیدم"
    },
    {
      "id": 8,
      "start": 7890.0,
      "end": 7892.0,
      "formatted_start": "02:11:30.000",
      "formatted_end": "02:11:32.000",
      "text": "درده هایی بیدم"
    },
    {
      "id": 9,
      "start": 7900.0,
      "end": 7902.0,
      "formatted_start": "02:11:40.000",
      "formatted_end": "02:11:42.000",
      "text": "میدونم اونو میرم بیادم گمبه"
    },
    {
      "id": 10,
      "start": 7902.0,
      "end": 7904.0,
      "formatted_start": "02:11:42.000",
      "formatted_end": "02:11:44.000",
      "text": "باز به بیمارستان زنگ میدنم"
    },
    {
      "id": 11,
      "start": 7904.0,
      "end": 7906.0,
      "formatted_start": "02:11:44.000",
      "formatted_end": "02:11:46.000",
      "text": "باز به بیمارستان زنگ میدنم"
    },
    {
      "id": 12,
      "start": 7906.0,
      "end": 7908.0,
      "formatted_start": "02:11:46.000",
      "formatted_end": "02:11:48.000",
      "text": "اگر یک موهودای نکرده"
    },
    {
      "id": 13,
      "start": 7908.0,
      "end": 7914.58,
      "formatted_start": "02:11:48.000",
      "formatted_end": "02:11:54.580",
      "text": "اینکه اینکه مورد گلجانسی بود انجام میدم و اینجا مریضه اینجا میزارم و بعد دوباره برمی کردم"
    },
    {
      "id": 14,
      "start": 7914.58,
      "end": 7916.28,
      "formatted_start": "02:11:54.580",
      "formatted_end": "02:11:56.280",
      "text": "و اینجا همینجوری برمی کردم"
    },
    {
      "id": 15,
      "start": 7916.28,
      "end": 7917.18,
      "formatted_start": "02:11:56.280",
      "formatted_end": "02:11:57.180",
      "text": "باشه باشه"
    },
    {
      "id": 16,
      "start": 7917.18,
      "end": 7918.46,
      "formatted_start": "02:11:57.180",
      "formatted_end": "02:11:58.460",
      "text": "با همه همه هایی کردم"
    },
    {
      "id": 17,
      "start": 7918.46,
      "end": 7932.46,
      "formatted_start": "02:11:58.460",
      "formatted_end": "02:12:12.460",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 7948.46,
      "end": 7956.46,
      "formatted_start": "02:12:28.460",
      "formatted_end": "02:12:36.460",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 7978.46,
      "end": 7980.46,
      "formatted_start": "02:12:58.460",
      "formatted_end": "02:13:00.460",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 20,
      "start": 7980.46,
      "end": 7982.46,
      "formatted_start": "02:13:00.460",
      "formatted_end": "02:13:02.460",
