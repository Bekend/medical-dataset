      "end": 8000.46,
      "formatted_start": "02:13:18.460",
      "formatted_end": "02:13:20.460",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 30,
      "start": 8000.46,
      "end": 8016.46,
      "formatted_start": "02:13:20.460",
      "formatted_end": "02:13:36.460",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 8030.46,
      "end": 8036.46,
      "formatted_start": "02:13:50.460",
      "formatted_end": "02:13:56.460",
      "text": "اگر چهل ساعت کاری میزه شده یکی هست دارد مثلا از ازافت کار میسه"
    },
    {
      "id": 32,
      "start": 8036.46,
      "end": 8039.46,
      "formatted_start": "02:13:56.460",
      "formatted_end": "02:13:59.460",
      "text": "ازافت کاری بسیار مزید"
    },
    {
      "id": 33,
      "start": 8039.46,
      "end": 8041.46,
      "formatted_start": "02:13:59.460",
      "formatted_end": "02:14:01.460",
      "text": "چند ساعت ازافت کاری میزه؟"
    },
    {
      "id": 34,
      "start": 8041.46,
      "end": 8043.46,
      "formatted_start": "02:14:01.460",
      "formatted_end": "02:14:03.460",
      "text": "۱۵ ساعت"
    },
    {
      "id": 35,
      "start": 8043.46,
      "end": 8050.46,
      "formatted_start": "02:14:03.460",
      "formatted_end": "02:14:10.460",
      "text": "ازافت کار ساعت مثلا زود میوی دیگری"
    },
    {
      "id": 36,
      "start": 8050.46,
      "end": 8052.46,
      "formatted_start": "02:14:10.460",
      "formatted_end": "02:14:12.460",
      "text": "درست دارد"
    },
    {
      "id": 37,
      "start": 8052.46,
      "end": 8054.46,
      "formatted_start": "02:14:12.460",
      "formatted_end": "02:14:14.460",
      "text": "درست دارد"
    },
    {
      "id": 38,
      "start": 8054.46,
      "end": 8064.46,
      "formatted_start": "02:14:14.460",
      "formatted_end": "02:14:24.460",
      "text": "من بخواد در این تکمیت بچه هایی که یکی یک در زودتر میان چیز بکنن برشون اضافه کنیم چون کسی بخواد"
    },
    {
      "id": 39,
      "start": 8064.46,
      "end": 8071.46,
      "formatted_start": "02:14:24.460",
      "formatted_end": "02:14:31.460",
      "text": "اینجوری اونهایی که دیر میان زرار کنن و اونهایی که چون دیر میان زرار نکنن"
    },
    {
      "id": 40,
      "start": 8071.46,
      "end": 8081.46,
      "formatted_start": "02:14:31.460",
      "formatted_end": "02:14:41.460",
      "text": "بر چه این اضافه باشی که شما جایید بگیرید باز صد مازده دیرمه کم اصابه شده یعنی؟"
    },
    {
      "id": 41,
      "start": 8081.46,
      "end": 8084.46,
      "formatted_start": "02:14:41.460",
      "formatted_end": "02:14:44.460",
      "text": "140 ساعتی که می کنیم."
    },
    {
      "id": 42,
      "start": 8084.46,
      "end": 8089.46,
      "formatted_start": "02:14:44.460",
      "formatted_end": "02:14:49.460",
      "text": "از این وقت که می کنیم، 164 ساعتی که می کنیم."
    },
    {
      "id": 43,
      "start": 8089.46,
      "end": 8093.46,
      "formatted_start": "02:14:49.460",
      "formatted_end": "02:14:53.460",
      "text": "این همه چیزی که می کنیم."
    },
    {
      "id": 44,
      "start": 8093.46,
      "end": 8096.46,
      "formatted_start": "02:14:53.460",
      "formatted_end": "02:14:56.460",
      "text": "چند ساعتی که می کنیم؟"
    },
