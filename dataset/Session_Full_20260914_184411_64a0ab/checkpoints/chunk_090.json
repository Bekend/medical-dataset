      "id": 65,
      "start": 27249.0,
      "end": 27251.0,
      "formatted_start": "07:34:09.000",
      "formatted_end": "07:34:11.000",
      "text": "نهره چی میخور؟"
    },
    {
      "id": 66,
      "start": 27251.0,
      "end": 27253.0,
      "formatted_start": "07:34:11.000",
      "formatted_end": "07:34:13.000",
      "text": "نان ای آر"
    },
    {
      "id": 67,
      "start": 27253.0,
      "end": 27255.0,
      "formatted_start": "07:34:13.000",
      "formatted_end": "07:34:15.000",
      "text": "ای آر رو تبایی کردیم به دو"
    },
    {
      "id": 68,
      "start": 27255.0,
      "end": 27258.0,
      "formatted_start": "07:34:15.000",
      "formatted_end": "07:34:18.000",
      "text": "اینکه اون پارنان یه روز داره میگذرد. یه روز بالا نیاوردن."
    },
    {
      "id": 69,
      "start": 27258.0,
      "end": 27260.0,
      "formatted_start": "07:34:18.000",
      "formatted_end": "07:34:20.000",
      "text": "این به خاطر اون نیست. تب کردن."
    },
    {
      "id": 70,
      "start": 27260.0,
      "end": 27263.0,
      "formatted_start": "07:34:20.000",
      "formatted_end": "07:34:23.000",
      "text": "آره تب کردن. تبشن. پارن استفراد."
    },
    {
      "id": 71,
      "start": 27263.0,
      "end": 27267.0,
      "formatted_start": "07:34:23.000",
      "formatted_end": "07:34:27.000",
      "text": "اسحاچی. پیران. بشی شد."
    },
    {
      "id": 72,
      "start": 27273.0,
      "end": 27276.0,
      "formatted_start": "07:34:33.000",
      "formatted_end": "07:34:36.000",
      "text": "این حال سرام از که این شروع شده؟"
    },
    {
      "id": 73,
      "start": 27276.0,
      "end": 27278.0,
      "formatted_start": "07:34:36.000",
      "formatted_end": "07:34:38.000",
      "text": "سرام درسته از آن."
    },
    {
      "id": 74,
      "start": 27278.0,
      "end": 27280.0,
      "formatted_start": "07:34:38.000",
      "formatted_end": "07:34:40.000",
      "text": "آره هم سرام داره."
    },
    {
      "id": 75,
      "start": 27280.0,
      "end": 27281.0,
      "formatted_start": "07:34:40.000",
      "formatted_end": "07:34:41.000",
      "text": "آره."
    },
    {
      "id": 76,
      "start": 27281.0,
      "end": 27284.0,
      "formatted_start": "07:34:41.000",
      "formatted_end": "07:34:44.000",
      "text": "اما استفرام را باید براش نکنید"
    },
    {
      "id": 77,
      "start": 27284.0,
      "end": 27290.0,
      "formatted_start": "07:34:44.000",
      "formatted_end": "07:34:50.000",
      "text": "برای اینکه استفرام را باید استفرام کنید"
    },
    {
      "id": 78,
      "start": 27290.0,
      "end": 27292.0,
      "formatted_start": "07:34:50.000",
      "formatted_end": "07:34:52.000",
      "text": "یعنی شربت همه دیگه براتر"
    },
