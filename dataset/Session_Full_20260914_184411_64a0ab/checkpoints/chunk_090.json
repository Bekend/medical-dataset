      "formatted_end": "07:31:02.000",
      "text": "اینجا میشه درد"
    },
    {
      "id": 3,
      "start": 27078.0,
      "end": 27080.0,
      "formatted_start": "07:31:18.000",
      "formatted_end": "07:31:20.000",
      "text": "اونجا پیدا میشه دیگه"
    },
    {
      "id": 4,
      "start": 27080.0,
      "end": 27082.0,
      "formatted_start": "07:31:20.000",
      "formatted_end": "07:31:22.000",
      "text": "اونجا پیدا میشه دیگه"
    },
    {
      "id": 5,
      "start": 27082.0,
      "end": 27084.0,
      "formatted_start": "07:31:22.000",
      "formatted_end": "07:31:24.000",
      "text": "اونجا پیدا میشه دیگه"
    },
    {
      "id": 6,
      "start": 27084.0,
      "end": 27086.0,
      "formatted_start": "07:31:24.000",
      "formatted_end": "07:31:26.000",
      "text": "چون آن شیر باشه"
    },
    {
      "id": 7,
      "start": 27086.0,
      "end": 27088.0,
      "formatted_start": "07:31:26.000",
      "formatted_end": "07:31:28.000",
      "text": "چون آن شیر باشه"
    },
    {
      "id": 8,
      "start": 27088.0,
      "end": 27093.0,
      "formatted_start": "07:31:28.000",
      "formatted_end": "07:31:33.000",
      "text": "از اینکه برای ملادن، دیگه هفته نان برش نون برم نمی برم"
    },
    {
      "id": 9,
      "start": 27093.0,
      "end": 27096.0,
      "formatted_start": "07:31:33.000",
      "formatted_end": "07:31:36.000",
      "text": "از چون زیاده برم"
    },
    {
      "id": 10,
      "start": 27096.0,
      "end": 27100.0,
      "formatted_start": "07:31:36.000",
      "formatted_end": "07:31:40.000",
      "text": "نان نان"
    },
    {
      "id": 11,
      "start": 27100.0,
      "end": 27105.0,
      "formatted_start": "07:31:40.000",
      "formatted_end": "07:31:45.000",
      "text": "شکار نداره شکرم نان به خاطر نان نیست شکرم شما شده"
    },
    {
      "id": 12,
      "start": 27105.0,
      "end": 27108.0,
      "formatted_start": "07:31:45.000",
      "formatted_end": "07:31:48.000",
      "text": "به خاطر تغییرش اینکه یکتر و یکتر عادت می کنم"
    },
    {
      "id": 13,
      "start": 27108.0,
      "end": 27113.0,
      "formatted_start": "07:31:48.000",
      "formatted_end": "07:31:53.000",
      "text": "اتفاقا نان شکرم رو صرف می کنه اگه بچه از اول نان برم"
    },
    {
      "id": 14,
      "start": 27113.0,
      "end": 27116.0,
      "formatted_start": "07:31:53.000",
      "formatted_end": "07:31:56.000",
      "text": "اول بیاد بیاد و باسون برم نان"
    },
    {
      "id": 15,
      "start": 27116.0,
      "end": 27146.0,
      "formatted_start": "07:31:56.000",
      "formatted_end": "07:32:26.000",
