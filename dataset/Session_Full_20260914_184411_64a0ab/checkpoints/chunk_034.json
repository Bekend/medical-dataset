  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10210.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:10.000",
      "text": "این همه باید نامونی بیشتر ویسر هست و این پرش و کف دفتاش، کف پاش، از نظر ما این بروز نیست."
    },
    {
      "id": 1,
      "start": 10210.0,
      "end": 10221.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:21.000",
      "text": "از هم واقعی نیست، هم ما نداریم که فرق مثلا یک ماه بیوی کنیم. این گرمان موهیجه، درمان هواست، خونه است."
    },
    {
      "id": 2,
      "start": 10221.0,
      "end": 10227.0,
      "formatted_start": "02:50:21.000",
      "formatted_end": "02:50:27.000",
      "text": "ولی خب اینجا یه در آزمایش رو کنند داشته، خب بسیار خوشی کهی شده؟"
    },
    {
      "id": 3,
      "start": 10230.0,
      "end": 10260.0,
      "formatted_start": "02:50:30.000",
      "formatted_end": "02:51:00.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 4,
      "start": 10260.0,
      "end": 10290.0,
      "formatted_start": "02:51:00.000",
      "formatted_end": "02:51:30.000",
      "text": "از اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 5,
      "start": 10290.0,
      "end": 10312.0,
      "formatted_start": "02:51:30.000",
      "formatted_end": "02:51:52.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 10312.0,
      "end": 10315.0,
      "formatted_start": "02:51:52.000",
      "formatted_end": "02:51:55.000",
      "text": "این بیرون چشم ها شدنش را با بنده برده بود."
    },
    {
      "id": 7,
      "start": 10315.0,
      "end": 10317.0,
      "formatted_start": "02:51:55.000",
      "formatted_end": "02:51:57.000",
      "text": "این جا را بشید."
    },
    {
      "id": 8,
      "start": 10317.0,
      "end": 10319.0,
      "formatted_start": "02:51:57.000",
      "formatted_end": "02:51:59.000",
      "text": "بیا برات شده برده بود."
    },
    {
      "id": 9,
      "start": 10325.0,
      "end": 10327.0,
      "formatted_start": "02:52:05.000",
      "formatted_end": "02:52:07.000",
      "text": "برات بشید."
    },
    {
      "id": 10,
      "start": 10330.0,
      "end": 10332.0,
      "formatted_start": "02:52:10.000",
      "formatted_end": "02:52:12.000",
      "text": "برات بشید."
    },
    {
      "id": 11,
      "start": 10337.0,
      "end": 10339.0,
      "formatted_start": "02:52:17.000",
      "formatted_end": "02:52:19.000",
      "text": "برات بشید."
    },
    {
      "id": 12,
      "start": 10339.0,
      "end": 10369.0,
      "formatted_start": "02:52:19.000",
      "formatted_end": "02:52:49.000",
      "text": "از اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 13,
      "start": 10369.0,
      "end": 10375.0,
      "formatted_start": "02:52:49.000",
      "formatted_end": "02:52:55.000",
      "text": "اگر ادرالت مشکل باشه سومی برای این باید بید."
    },
    {
      "id": 14,
      "start": 10375.0,
      "end": 10381.0,
      "formatted_start": "02:52:55.000",
      "formatted_end": "02:53:01.000",
      "text": "چون تو حامل ایگی سومایش مشکلی نداشت و خودت دیابت داشتی."
    },
    {
      "id": 15,
      "start": 10381.0,
      "end": 10383.0,
      "formatted_start": "02:53:01.000",
      "formatted_end": "02:53:03.000",
      "text": "آیا؟"
    },
    {
      "id": 16,
      "start": 10383.0,
      "end": 10385.0,
      "formatted_start": "02:53:03.000",
      "formatted_end": "02:53:05.000",
      "text": "و خدای من ببین مشکل نداشت."
    },
    {
      "id": 17,
      "start": 10385.0,
      "end": 10387.0,
      "formatted_start": "02:53:05.000",
      "formatted_end": "02:53:07.000",
      "text": "چرا انجام میره سومایی حامل ایگی تو؟"
    },
    {
      "id": 18,
      "start": 10387.0,
      "end": 10389.0,
      "formatted_start": "02:53:07.000",
      "formatted_end": "02:53:09.000",
      "text": "چه ادرالت؟"
    },
    {
      "id": 19,
      "start": 10389.0,
      "end": 10393.0,
      "formatted_start": "02:53:09.000",
      "formatted_end": "02:53:13.000",
      "text": "یه سریعه شو ایه های خواهد نفتره میتونه ایشون رو بساریم."
    },
    {
      "id": 20,
      "start": 10393.0,
      "end": 10397.0,
      "formatted_start": "02:53:13.000",
      "formatted_end": "02:53:17.000",
      "text": "حالا فیلن این دو کامیونتی سو میره نه اسلامی باشه."
    },
    {
      "id": 21,
      "start": 10397.0,
      "end": 10427.0,
      "formatted_start": "02:53:17.000",
      "formatted_end": "02:53:47.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 22,
      "start": 10427.0,
      "end": 10429.0,
      "formatted_start": "02:53:47.000",
      "formatted_end": "02:53:49.000",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 10429.0,
      "end": 10431.0,
      "formatted_start": "02:53:49.000",
      "formatted_end": "02:53:51.000",
      "text": "که شیر مادر کنند؟"
    },
    {
      "id": 24,
      "start": 10431.0,
      "end": 10433.0,
      "formatted_start": "02:53:51.000",
      "formatted_end": "02:53:53.000",
      "text": "آره"
    },
    {
      "id": 25,
      "start": 10433.0,
      "end": 10435.0,
      "formatted_start": "02:53:53.000",
      "formatted_end": "02:53:55.000",
      "text": "پردوز ترست؟"
    },
    {
      "id": 26,
      "start": 10435.0,
      "end": 10437.0,
      "formatted_start": "02:53:55.000",
      "formatted_end": "02:53:57.000",
      "text": "بله دیگه وقتا هر روز میشه"
    },
    {
      "id": 27,
      "start": 10437.0,
      "end": 10439.0,
      "formatted_start": "02:53:57.000",
      "formatted_end": "02:53:59.000",
      "text": "الان"
    },
    {
      "id": 28,
      "start": 10439.0,
      "end": 10441.0,
      "formatted_start": "02:53:59.000",
      "formatted_end": "02:54:01.000",
      "text": "نزدیک چهار روز"
    },
    {
      "id": 29,
      "start": 10441.0,
      "end": 10443.0,
      "formatted_start": "02:54:01.000",
      "formatted_end": "02:54:03.000",
      "text": "پنج روز شد"
    },
    {
      "id": 30,
      "start": 10443.0,
      "end": 10445.0,
