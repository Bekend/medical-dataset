    },
    {
      "id": 6,
      "start": 5712.0,
      "end": 5714.0,
      "formatted_start": "01:35:12.000",
      "formatted_end": "01:35:14.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 7,
      "start": 5714.0,
      "end": 5716.0,
      "formatted_start": "01:35:14.000",
      "formatted_end": "01:35:16.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 8,
      "start": 5716.0,
      "end": 5718.0,
      "formatted_start": "01:35:16.000",
      "formatted_end": "01:35:18.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 9,
      "start": 5718.0,
      "end": 5720.0,
      "formatted_start": "01:35:18.000",
      "formatted_end": "01:35:20.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 10,
      "start": 5720.0,
      "end": 5722.0,
      "formatted_start": "01:35:20.000",
      "formatted_end": "01:35:22.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 11,
      "start": 5722.0,
      "end": 5740.0,
      "formatted_start": "01:35:22.000",
      "formatted_end": "01:35:40.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 5752.0,
      "end": 5757.0,
      "formatted_start": "01:35:52.000",
      "formatted_end": "01:35:57.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 5782.0,
      "end": 5786.0,
      "formatted_start": "01:36:22.000",
      "formatted_end": "01:36:26.000",
      "text": "اینکه این کارگیلشو بگیر انقدر خوشمزدت میتره"
    },
    {
      "id": 14,
      "start": 5786.0,
      "end": 5788.0,
      "formatted_start": "01:36:26.000",
      "formatted_end": "01:36:28.000",
      "text": "اصلا موقلاده بود"
    },
    {
      "id": 15,
      "start": 5795.0,
      "end": 5799.0,
      "formatted_start": "01:36:35.000",
      "formatted_end": "01:36:39.000",
      "text": "فهمیدید رفته از اونجا تو سرا میامده"
    },
    {
      "id": 16,
      "start": 5799.0,
      "end": 5802.0,
      "formatted_start": "01:36:39.000",
      "formatted_end": "01:36:42.000",
      "text": "و اونی که براش پیشش کار میکرده"
    },
    {
      "id": 17,
      "start": 5802.0,
      "end": 5804.0,
      "formatted_start": "01:36:42.000",
      "formatted_end": "01:36:44.000",
      "text": "مغازه زده"
    },
    {
      "id": 18,
      "start": 5804.0,
      "end": 5805.0,
      "formatted_start": "01:36:44.000",
      "formatted_end": "01:36:45.000",
      "text": "آره"
    },
    {
      "id": 19,
      "start": 5805.0,
      "end": 5810.0,
      "formatted_start": "01:36:45.000",
      "formatted_end": "01:36:50.000",
      "text": "دقیقا اونم از بیفروشی زده انقدر ناراحت بود"
    },
    {
      "id": 20,
      "start": 5810.0,
      "end": 5811.0,
      "formatted_start": "01:36:50.000",
      "formatted_end": "01:36:51.000",
      "text": "میگه؟"
    },
    {
      "id": 21,
      "start": 5811.0,
      "end": 5813.34,
      "formatted_start": "01:36:51.000",
      "formatted_end": "01:36:53.340",
      "text": "نه هر هر دفعه اصلا باید بگو دختر جوانه بود"
    },
    {
      "id": 22,
      "start": 5813.34,
      "end": 5814.24,
      "formatted_start": "01:36:53.340",
      "formatted_end": "01:36:54.240",
      "text": "خودش چیه؟"
    },
    {
      "id": 23,
      "start": 5814.24,
      "end": 5815.38,
      "formatted_start": "01:36:54.240",
      "formatted_end": "01:36:55.380",
      "text": "خودش چی؟"
    },
    {
      "id": 24,
      "start": 5815.38,
      "end": 5817.58,
      "formatted_start": "01:36:55.380",
      "formatted_end": "01:36:57.580",
      "text": "جا نیست خودش دیگه سرابی زده"
    },
    {
      "id": 25,
      "start": 5817.58,
      "end": 5819.08,
      "formatted_start": "01:36:57.580",
      "formatted_end": "01:36:59.080",
      "text": "میدونم سرابی زده"
    },
    {
      "id": 26,
      "start": 5819.08,
      "end": 5820.04,
      "formatted_start": "01:36:59.080",
      "formatted_end": "01:37:00.040",
      "text": "اطاری همون که"
    },
    {
      "id": 27,
      "start": 5820.04,
      "end": 5821.04,
      "formatted_start": "01:37:00.040",
      "formatted_end": "01:37:01.040",
      "text": "پی آبا"
    },
    {
      "id": 28,
      "start": 5821.04,
      "end": 5821.98,
      "formatted_start": "01:37:01.040",
      "formatted_end": "01:37:01.980",
      "text": "پی آبا میگم چیه؟"
    },
    {
      "id": 29,
      "start": 5821.98,
      "end": 5822.28,
      "formatted_start": "01:37:01.980",
      "formatted_end": "01:37:02.280",
      "text": "رو"
    },
    {
      "id": 30,
      "start": 5822.28,
      "end": 5823.98,
      "formatted_start": "01:37:02.280",
      "formatted_end": "01:37:03.980",
      "text": "همسنه"
    },
    {
      "id": 31,
      "start": 5823.98,
      "end": 5826.0,
      "formatted_start": "01:37:03.980",
      "formatted_end": "01:37:06.000",
      "text": "نه همسنه منم"
    },
    {
      "id": 32,
      "start": 5826.0,
      "end": 5828.0,
      "formatted_start": "01:37:06.000",
      "formatted_end": "01:37:08.000",
      "text": "بایده"
    },
    {
      "id": 33,
      "start": 5828.56,
      "end": 5831.56,
      "formatted_start": "01:37:08.560",
      "formatted_end": "01:37:11.560",
      "text": "نه هر دفعه اصلا باید بگو دختر جوانه بود"
    },
    {
      "id": 34,
      "start": 5831.56,
      "end": 5838.0,
      "formatted_start": "01:37:11.560",
      "formatted_end": "01:37:18.000",
      "text": "دختره که براش کار میکرده"
    },
    {
      "id": 35,
      "start": 5838.66,
      "end": 5839.68,
      "formatted_start": "01:37:18.660",
      "formatted_end": "01:37:19.680",
      "text": "اون کجا زده؟"
    },
    {
      "id": 36,
      "start": 5840.0,
      "end": 5844.0,
      "formatted_start": "01:37:20.000",
      "formatted_end": "01:37:24.000",
      "text": "خودو همون کنار آبای قدیم همون تو خیابو سپاس داره"
    },
    {
      "id": 37,
      "start": 5844.0,
      "end": 5848.0,
      "formatted_start": "01:37:24.000",
      "formatted_end": "01:37:28.000",
      "text": "نه چون مشتری ها ندارن که میرن همون جا میرن"
    },
    {
      "id": 38,
      "start": 5848.0,
      "end": 5852.0,
      "formatted_start": "01:37:28.000",
      "formatted_end": "01:37:32.000",
      "text": "بعد یه اتفاقی میبینن میگن"
    },
    {
      "id": 39,
      "start": 5852.0,
      "end": 5856.0,
      "formatted_start": "01:37:32.000",
      "formatted_end": "01:37:36.000",
      "text": "ای ما سراغتو میگیریم و میگه تو خونه اینیستی"
    },
    {
      "id": 40,
      "start": 5856.0,
      "end": 5858.0,
      "formatted_start": "01:37:36.000",
      "formatted_end": "01:37:38.000",
      "text": "نمیگه اون سراغیت داره"
    },
    {
      "id": 41,
      "start": 5858.0,
      "end": 5860.0,
      "formatted_start": "01:37:38.000",
      "formatted_end": "01:37:40.000",
      "text": "چقدر بچه هست"
    },
    {
      "id": 42,
      "start": 5860.0,
      "end": 5861.0,
      "formatted_start": "01:37:40.000",
      "formatted_end": "01:37:41.000",
      "text": "نه"
    },
    {
      "id": 43,
      "start": 5861.0,
      "end": 5864.0,
      "formatted_start": "01:37:41.000",
      "formatted_end": "01:37:44.000",
      "text": "اینوز رفته بودم ازش تعریف کنیم بزندا بشم"
    },
    {
      "id": 44,
      "start": 5864.0,
      "end": 5866.0,
      "formatted_start": "01:37:44.000",
      "formatted_end": "01:37:46.000",
      "text": "داشت تعریف میکرد"
    },
    {
      "id": 45,
      "start": 5866.0,
      "end": 5868.0,
      "formatted_start": "01:37:46.000",
      "formatted_end": "01:37:48.000",
      "text": "ریپوبز کرده بود"
    },
    {
      "id": 46,
      "start": 5868.0,
      "end": 5872.0,
      "formatted_start": "01:37:48.000",
      "formatted_end": "01:37:52.000",
      "text": "می گفت بسازی و بعد یه و یه و یه"
    },
    {
      "id": 47,
      "start": 5872.0,
      "end": 5874.0,
      "formatted_start": "01:37:52.000",
      "formatted_end": "01:37:54.000",
      "text": "و بعد می گفت قیمتشو الان چند برابر من می ده"
    },
    {
      "id": 48,
      "start": 5874.0,
      "end": 5877.0,
      "formatted_start": "01:37:54.000",
      "formatted_end": "01:37:57.000",
      "text": "و همه هم گفته شریک شریف بودیم"
    },
    {
      "id": 49,
      "start": 5877.0,
      "end": 5885.0,
      "formatted_start": "01:37:57.000",
      "formatted_end": "01:38:05.000",
      "text": "و بارکودهایی که مثلا ارسال می شده کارتونا براشون"
    },
    {
      "id": 50,
      "start": 5885.0,
      "end": 5889.0,
      "formatted_start": "01:38:05.000",
      "formatted_end": "01:38:09.000",
      "text": "که یکسه اتکن کرده ببینیم از کجا بوده شماره کجا بوده"
    },
    {
      "id": 51,
      "start": 5889.0,
      "end": 5893.0,
      "formatted_start": "01:38:09.000",
      "formatted_end": "01:38:13.000",
      "text": "از کجا استفاره می داد ببین چقدر زرنگ بوده"
    },
    {
      "id": 52,
      "start": 5893.0,
      "end": 5901.0,
      "formatted_start": "01:38:13.000",
      "formatted_end": "01:38:21.000",
      "text": "بعد می گفت هر مشتری می گفت می اومد اسماشو می گره شمارهشو من می گرفت"
    },
    {
      "id": 53,
      "start": 5901.0,
      "end": 5908.0,
      "formatted_start": "01:38:21.000",
      "formatted_end": "01:38:28.000",
      "text": "احتمالا بعدا ورد اسمت کرده که این برندمون این شده اسمش این شده"
    },
    {
      "id": 54,
      "start": 5908.0,
      "end": 5911.0,
      "formatted_start": "01:38:28.000",
      "formatted_end": "01:38:31.000",
      "text": "چی اینه؟ نه از افراد خواستش بود"
    },
    {
      "id": 55,
      "start": 5911.0,
      "end": 5913.0,
      "formatted_start": "01:38:31.000",
      "formatted_end": "01:38:33.000",
      "text": "اینو داشته که آره"
    },
    {
      "id": 56,
      "start": 5913.0,
      "end": 5920.0,
      "formatted_start": "01:38:33.000",
      "formatted_end": "01:38:40.000",
      "text": "بعد غذای پرنده می آورده تو مغاز قای مکی می فروخته از خودش"
    },
    {
      "id": 57,
      "start": 5920.0,
      "end": 5922.0,
      "formatted_start": "01:38:40.000",
      "formatted_end": "01:38:42.000",
      "text": "و به این هم نگفته بوده"
    },
    {
      "id": 58,
      "start": 5922.0,
      "end": 5925.0,
      "formatted_start": "01:38:42.000",
      "formatted_end": "01:38:45.000",
      "text": "بعد خودش چی کار میکنه که تو موضعش نبوده؟"
    },
    {
      "id": 59,
      "start": 5925.0,
      "end": 5926.0,
      "formatted_start": "01:38:45.000",
      "formatted_end": "01:38:46.000",
      "text": "شغل دوباره شده"
    },
    {
      "id": 60,
      "start": 5926.0,
      "end": 5928.0,
      "formatted_start": "01:38:46.000",
      "formatted_end": "01:38:48.000",
      "text": "با این بکشه دار شد"
    },
    {
      "id": 61,
      "start": 5928.0,
      "end": 5931.0,
      "formatted_start": "01:38:48.000",
      "formatted_end": "01:38:51.000",
      "text": "یه مدت خلینا یه سالی دار ورکرد موضعش رفت"
    },
    {
      "id": 62,
      "start": 5931.0,
      "end": 5932.0,
      "formatted_start": "01:38:51.000",
      "formatted_end": "01:38:52.000",
      "text": "کامیرش چیه؟"
    },
    {
      "id": 63,
      "start": 5932.0,
      "end": 5934.0,
      "formatted_start": "01:38:52.000",
      "formatted_end": "01:38:54.000",
      "text": "باید کامیرش شده، اصحاش خواهزه است"
    },
    {
      "id": 64,
      "start": 5934.0,
      "end": 5935.0,
      "formatted_start": "01:38:54.000",
      "formatted_end": "01:38:55.000",
      "text": "اصحاش خواهزه است"
    },
    {
      "id": 65,
      "start": 5935.0,
      "end": 5936.0,
      "formatted_start": "01:38:55.000",
      "formatted_end": "01:38:56.000",
      "text": "اصحاش خواهزه است"
    },
    {
      "id": 66,
      "start": 5936.0,
      "end": 5938.0,
      "formatted_start": "01:38:56.000",
      "formatted_end": "01:38:58.000",
      "text": "که کنم اونی بشتی بودن"
    },
    {
      "id": 67,
      "start": 5938.0,
      "end": 5940.0,
      "formatted_start": "01:38:58.000",
      "formatted_end": "01:39:00.000",
      "text": "آره، اونی بشتی بود، سرکتی هم چی کامیرش بود"
    },
    {
      "id": 68,
      "start": 5940.0,
      "end": 5942.0,
      "formatted_start": "01:39:00.000",
      "formatted_end": "01:39:02.000",
      "text": "آره، آره، دو"
    },
    {
      "id": 69,
      "start": 5942.0,
      "end": 5944.0,
      "formatted_start": "01:39:02.000",
      "formatted_end": "01:39:04.000",
      "text": "درسته"
    },
    {
      "id": 70,
      "start": 5944.0,
      "end": 5946.0,
      "formatted_start": "01:39:04.000",
      "formatted_end": "01:39:06.000",
      "text": "پیشش من ایستاد داشتم"
    },
    {
      "id": 71,
      "start": 5946.0,
      "end": 5948.0,
      "formatted_start": "01:39:06.000",
      "formatted_end": "01:39:08.000",
      "text": "اونو میگشم"
    },
    {
      "id": 72,
      "start": 5948.0,
      "end": 5950.0,
      "formatted_start": "01:39:08.000",
      "formatted_end": "01:39:10.000",
      "text": "اونو چیزی بوده"
    },
    {
      "id": 73,
      "start": 5956.0,
      "end": 5958.0,
      "formatted_start": "01:39:16.000",
      "formatted_end": "01:39:18.000",
      "text": "اون نقطه سرچه ای هم روسته دیگه"
    },
    {
      "id": 74,
      "start": 5958.0,
      "end": 5960.0,
      "formatted_start": "01:39:18.000",
      "formatted_end": "01:39:20.000",
      "text": "لازم کنه دیگه"
    },
    {
      "id": 75,
      "start": 5960.0,
      "end": 5962.0,
      "formatted_start": "01:39:20.000",
      "formatted_end": "01:39:22.000",
      "text": "بکسر همون میذارش"
    },
    {
      "id": 76,
      "start": 5972.0,
      "end": 5978.0,
      "formatted_start": "01:39:32.000",
      "formatted_end": "01:39:38.000",
      "text": "بعد می گفت خواهم اون یه مدت که رفته بودن بعد زای ما پیج هم هم دستش بود"
    },
    {
      "id": 77,
      "start": 5978.0,
      "end": 5987.0,
      "formatted_start": "01:39:38.000",
      "formatted_end": "01:39:47.000",
      "text": "بعد گفتن چرا اسم تو نمیشی تو پیج اسم تو نیاز نیست بوده اسم تو کلن هم خواب کرده بوده از تو سردر پیجش"
    },
    {
      "id": 78,
      "start": 5987.0,
      "end": 5990.0,
      "formatted_start": "01:39:47.000",
      "formatted_end": "01:39:50.000",
      "text": "چقدر سرنگی بوده"
    },
    {
      "id": 79,
      "start": 5990.0,
      "end": 5992.0,
      "formatted_start": "01:39:50.000",
      "formatted_end": "01:39:52.000",
      "text": "سرنگی نیست بگی؟"
    },
    {
      "id": 80,
      "start": 5992.0,
      "end": 5997.0,
      "formatted_start": "01:39:52.000",
      "formatted_end": "01:39:57.000",
      "text": "نه آره دیگه زرکان برای نشتی بالا دیزنگ کار داره"
    },
    {
      "id": 81,
      "start": 5997.0,
      "end": 5999.0,
      "formatted_start": "01:39:57.000",
      "formatted_end": "01:39:59.000",
      "text": "خیلی خوبه"
    }
  ],
  "status": "completed"
}