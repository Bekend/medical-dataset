  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10806.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:06.000",
      "text": "از این مقاربی نراغه بچه که احنا تخشش کرده که الان بیدار نمیشه ولی مهاش بردید."
    },
    {
      "id": 1,
      "start": 10806.0,
      "end": 10815.0,
      "formatted_start": "03:00:06.000",
      "formatted_end": "03:00:15.000",
      "text": "بچه که بیدار نمیشه دو تا تشکیل سطحی که او کنند را خواهد دوبی حاله، دوی که خسر است و دیدار خواهد داشته بیشتر اکنبوده خواهد خواهد دارد."
    },
    {
      "id": 2,
      "start": 10815.0,
      "end": 10819.0,
      "formatted_start": "03:00:15.000",
      "formatted_end": "03:00:19.000",
      "text": "چون معاناتش خوبه، فقط بندشن را یک طرف تا کشون بیرونده."
    },
    {
      "id": 3,
      "start": 10819.0,
      "end": 10833.0,
      "formatted_start": "03:00:19.000",
      "formatted_end": "03:00:33.000",
      "text": "برای این نرزش، هشبره بی غراری، یه سه چاروش شیرکش باید بشیدید."
    },
    {
      "id": 4,
      "start": 10833.0,
      "end": 10838.0,
      "formatted_start": "03:00:33.000",
      "formatted_end": "03:00:38.000",
      "text": "آره آره، باید دیگه در درد درد دیگه نکشیده که شنگه از این روز رو بخوره."
    },
    {
      "id": 5,
      "start": 10838.0,
      "end": 10845.0,
      "formatted_start": "03:00:38.000",
      "formatted_end": "03:00:45.000",
      "text": "و یک بسیاری منوی به دردوزیدید که یک سی تا آب بریزید، سه رسمتش باشید."
    },
    {
      "id": 6,
      "start": 10845.0,
      "end": 10852.0,
      "formatted_start": "03:00:45.000",
      "formatted_end": "03:00:52.000",
      "text": "چون از به صدایی کنه روز، یادمونی از رفتی دید هر چی قدر بگیر و خواهد بشه به جان و یه مدیره اینجا رو جمع کنه"
    },
    {
      "id": 7,
      "start": 10852.0,
      "end": 10857.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:00:57.000",
      "text": "که جان مقداری هیچ قدر بخوره مستقیقا بخوره که این بسیاری بخوره"
    },
    {
      "id": 8,
      "start": 10857.0,
      "end": 10863.0,
      "formatted_start": "03:00:57.000",
      "formatted_end": "03:01:03.000",
      "text": "یکی اون مادر داره، در صورت بیهرانیش داره، ادرارش ممکن است صورتی نارنجی بشه، یکی کم بخوره نگیز بشه"
    },
    {
      "id": 9,
      "start": 10863.0,
      "end": 10865.0,
      "formatted_start": "03:01:03.000",
      "formatted_end": "03:01:05.000",
      "text": "از اینکه این بیشتر باید برداشت باشه."
    },
    {
      "id": 10,
      "start": 10865.0,
      "end": 10867.0,
      "formatted_start": "03:01:05.000",
      "formatted_end": "03:01:07.000",
      "text": "از اینکه این بیشتر باید برداشت باشه."
    },
    {
      "id": 11,
      "start": 10867.0,
      "end": 10869.0,
      "formatted_start": "03:01:07.000",
      "formatted_end": "03:01:09.000",
      "text": "از اینکه این بیشتر باید برداشت باشه."
    },
    {
      "id": 12,
      "start": 10869.0,
      "end": 10871.0,
      "formatted_start": "03:01:09.000",
      "formatted_end": "03:01:11.000",
      "text": "این فقط گوشتگیه."
    },
    {
      "id": 13,
      "start": 10871.0,
      "end": 10873.0,
      "formatted_start": "03:01:11.000",
      "formatted_end": "03:01:13.000",
      "text": "از اینکه این نفت بشه."
    },
    {
      "id": 14,
      "start": 10873.0,
      "end": 10875.0,
      "formatted_start": "03:01:13.000",
      "formatted_end": "03:01:15.000",
      "text": "نه نه نه. هیچ راوی برای نفت ممنوع داری."
    },
    {
      "id": 15,
      "start": 10875.0,
      "end": 10877.0,
      "formatted_start": "03:01:15.000",
      "formatted_end": "03:01:17.000",
      "text": "نه نه نه. هیچ راوی برای نفت ممنوع داری."
    },
    {
      "id": 16,
      "start": 10877.0,
      "end": 10879.0,
      "formatted_start": "03:01:17.000",
      "formatted_end": "03:01:19.000",
      "text": "داینتیکون و جنگ شرقشت و پرنجبین و عرق ننایی را نوازدیر درست داشت."
    },
    {
      "id": 17,
      "start": 10879.0,
      "end": 10881.0,
      "formatted_start": "03:01:19.000",
      "formatted_end": "03:01:21.000",
      "text": "ایران های نوازدیر درسته داشته داره"
    },
    {
      "id": 18,
      "start": 10881.0,
      "end": 10883.0,
      "formatted_start": "03:01:21.000",
      "formatted_end": "03:01:23.000",
      "text": "توم وزنش همه اونکه بنا زرگیش"
    },
    {
      "id": 19,
      "start": 10883.0,
      "end": 10885.0,
      "formatted_start": "03:01:23.000",
      "formatted_end": "03:01:25.000",
      "text": "دو شیست ها درش دیگر نیست"
    },
    {
      "id": 20,
      "start": 10885.0,
      "end": 10887.0,
      "formatted_start": "03:01:25.000",
      "formatted_end": "03:01:27.000",
      "text": "چیز که باید خواهید کنید"
    },
    {
      "id": 21,
      "start": 10887.0,
      "end": 10889.0,
      "formatted_start": "03:01:27.000",
      "formatted_end": "03:01:29.000",
      "text": "درش هم باهم همون کنید"
    },
    {
      "id": 22,
      "start": 10889.0,
      "end": 10891.0,
      "formatted_start": "03:01:29.000",
      "formatted_end": "03:01:31.000",
      "text": "شیر باش مایاز باید باید بردردید"
    },
    {
      "id": 23,
      "start": 10891.0,
      "end": 10893.0,
      "formatted_start": "03:01:31.000",
      "formatted_end": "03:01:33.000",
      "text": "دو شیست ها در وزنش ها خیلی کمه"
    },
    {
      "id": 24,
      "start": 10893.0,
      "end": 10895.0,
      "formatted_start": "03:01:33.000",
      "formatted_end": "03:01:35.000",
      "text": "و شیر باشه توی شیره"
    },
    {
      "id": 25,
      "start": 10895.0,
      "end": 10897.0,
      "formatted_start": "03:01:35.000",
      "formatted_end": "03:01:37.000",
      "text": "نه نه کانفرد"
    },
    {
      "id": 26,
      "start": 10897.0,
      "end": 10899.0,
      "formatted_start": "03:01:37.000",
      "formatted_end": "03:01:39.000",
      "text": "کانفرد چرا؟"
    },
    {
      "id": 27,
      "start": 10899.0,
      "end": 10901.0,
      "formatted_start": "03:01:39.000",
      "formatted_end": "03:01:41.000",
      "text": "الان دردرد کنه این شیره"
    },
    {
      "id": 28,
      "start": 10901.0,
      "end": 10906.0,
      "formatted_start": "03:01:41.000",
      "formatted_end": "03:01:46.000",
      "text": "مخورت مال برای زچه ای که درد داره و مقاومه به درمان جواب نمیده"
    },
    {
      "id": 29,
      "start": 10906.0,
      "end": 10909.0,
      "formatted_start": "03:01:46.000",
      "formatted_end": "03:01:49.000",
      "text": "بعد یک مایلی ما تا مابی بشه و قریب میده شده"
    },
    {
      "id": 30,
      "start": 10909.0,
      "end": 10911.0,
      "formatted_start": "03:01:49.000",
      "formatted_end": "03:01:51.000",
      "text": "سرعت رفیق مخورت"
    },
    {
      "id": 31,
      "start": 10911.0,
      "end": 10913.0,
      "formatted_start": "03:01:51.000",
      "formatted_end": "03:01:53.000",
      "text": "مخورت نمیخواد"
    },
    {
      "id": 32,
      "start": 10914.0,
      "end": 10918.0,
      "formatted_start": "03:01:54.000",
      "formatted_end": "03:01:58.000",
      "text": "دوستان قرار شما ما شیطان خواهش ناری رفتیم"
    },
    {
      "id": 33,
      "start": 10918.0,
      "end": 10919.0,
      "formatted_start": "03:01:58.000",
      "formatted_end": "03:01:59.000",
      "text": "بله"
    },
    {
      "id": 34,
      "start": 10919.0,
      "end": 10924.0,
      "formatted_start": "03:01:59.000",
      "formatted_end": "03:02:04.000",
      "text": "بعد دیگه بود که زنجون با دستا چکنه چار درد"
    },
    {
      "id": 35,
      "start": 10924.0,
      "end": 10926.0,
      "formatted_start": "03:02:04.000",
      "formatted_end": "03:02:06.000",
      "text": "خب دیگه دستا بود نه"
    },
    {
      "id": 36,
      "start": 10926.0,
      "end": 10928.0,
      "formatted_start": "03:02:06.000",
      "formatted_end": "03:02:08.000",
      "text": "نه دیگه دستا من بود کار"
    },
    {
      "id": 37,
      "start": 10928.0,
      "end": 10930.0,
      "formatted_start": "03:02:08.000",
      "formatted_end": "03:02:10.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 38,
      "start": 10930.0,
      "end": 10932.0,
      "formatted_start": "03:02:10.000",
      "formatted_end": "03:02:12.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 39,
      "start": 10932.0,
      "end": 10934.0,
      "formatted_start": "03:02:12.000",
      "formatted_end": "03:02:14.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 40,
      "start": 10934.0,
      "end": 10936.0,
      "formatted_start": "03:02:14.000",
      "formatted_end": "03:02:16.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 41,
      "start": 10936.0,
      "end": 10938.0,
      "formatted_start": "03:02:16.000",
      "formatted_end": "03:02:18.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 42,
      "start": 10938.0,
      "end": 10940.0,
      "formatted_start": "03:02:18.000",
      "formatted_end": "03:02:20.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 43,
      "start": 10940.0,
      "end": 10942.0,
      "formatted_start": "03:02:20.000",
      "formatted_end": "03:02:22.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 44,
      "start": 10942.0,
      "end": 10944.0,
      "formatted_start": "03:02:22.000",
      "formatted_end": "03:02:24.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 45,
      "start": 10944.0,
      "end": 10946.0,
      "formatted_start": "03:02:24.000",
      "formatted_end": "03:02:26.000",
      "text": "از کارهایی که میخوایید بردارید."
    },
    {
      "id": 46,
      "start": 10946.0,
      "end": 10952.0,
      "formatted_start": "03:02:26.000",
      "formatted_end": "03:02:32.000",
      "text": "دردش بیاد میت شیرخوش رو بده و این شیرخوش استفاده که آقایی بچهش کشته بود."
    },
    {
      "id": 47,
      "start": 10952.0,
      "end": 10954.0,
      "formatted_start": "03:02:32.000",
      "formatted_end": "03:02:34.000",
      "text": "چی شده؟"
    },
    {
      "id": 48,
      "start": 10965.0,
      "end": 10968.0,
      "formatted_start": "03:02:45.000",
      "formatted_end": "03:02:48.000",
      "text": "این عدود دردش بیاد میتونی کاردرش دستید."
    },
    {
      "id": 49,
      "start": 10968.0,
      "end": 10972.0,
      "formatted_start": "03:02:48.000",
      "formatted_end": "03:02:52.000",
      "text": "از چندی دو روز دردو منو گفتم که از کاردر نام بچه ها داریم."
    },
    {
      "id": 50,
      "start": 10972.0,
      "end": 11002.0,
