      "start": 5460.0,
      "end": 5490.0,
      "formatted_start": "01:31:00.000",
      "formatted_end": "01:31:30.000",
      "text": "اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری که اینجوری ک"
    },
    {
      "id": 3,
      "start": 5490.0,
      "end": 5492.0,
      "formatted_start": "01:31:30.000",
      "formatted_end": "01:31:32.000",
      "text": "این رو با پشت ها خدا بخوره میتونم"
    },
    {
      "id": 4,
      "start": 5492.0,
      "end": 5494.0,
      "formatted_start": "01:31:32.000",
      "formatted_end": "01:31:34.000",
      "text": "این رو با..."
    },
    {
      "id": 5,
      "start": 5494.0,
      "end": 5496.0,
      "formatted_start": "01:31:34.000",
      "formatted_end": "01:31:36.000",
      "text": "هنوز"
    },
    {
      "id": 6,
      "start": 5496.0,
      "end": 5498.0,
      "formatted_start": "01:31:36.000",
      "formatted_end": "01:31:38.000",
      "text": "با سرشده نمانات سیاره شده"
    },
    {
      "id": 7,
      "start": 5498.0,
      "end": 5500.0,
      "formatted_start": "01:31:38.000",
      "formatted_end": "01:31:40.000",
      "text": "خوب بود تازه بخورم"
    },
    {
      "id": 8,
      "start": 5500.0,
      "end": 5502.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:42.000",
      "text": "همین رو بشه"
    },
    {
      "id": 9,
      "start": 5502.0,
      "end": 5504.0,
      "formatted_start": "01:31:42.000",
      "formatted_end": "01:31:44.000",
      "text": "الان"
    },
    {
      "id": 10,
      "start": 5504.0,
      "end": 5506.0,
      "formatted_start": "01:31:44.000",
      "formatted_end": "01:31:46.000",
      "text": "دارم ایسای نسخه کنم"
    },
    {
      "id": 11,
      "start": 5506.0,
      "end": 5508.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:31:48.000",
      "text": "دیگه به هر"
    },
    {
      "id": 12,
      "start": 5508.0,
      "end": 5510.0,
      "formatted_start": "01:31:48.000",
      "formatted_end": "01:31:50.000",
      "text": "سر نمانات"
    },
    {
      "id": 13,
      "start": 5510.0,
      "end": 5512.0,
      "formatted_start": "01:31:50.000",
      "formatted_end": "01:31:52.000",
      "text": "نسخه"
    },
    {
      "id": 14,
      "start": 5512.0,
      "end": 5514.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:54.000",
      "text": "نسخه"
    },
    {
      "id": 15,
      "start": 5514.0,
      "end": 5516.0,
      "formatted_start": "01:31:54.000",
      "formatted_end": "01:31:56.000",
      "text": "نسخه بیره از در یه تکهشو خودت"
    },
    {
      "id": 16,
      "start": 5516.0,
      "end": 5518.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:31:58.000",
      "text": "بخور بینه"
    },
    {
      "id": 17,
      "start": 5518.0,
      "end": 5520.0,
      "formatted_start": "01:31:58.000",
      "formatted_end": "01:32:00.000",
      "text": "این چیز شبه؟ این چیزی نمی کنی؟"
    },
    {
      "id": 18,
      "start": 5520.0,
      "end": 5522.0,
      "formatted_start": "01:32:00.000",
      "formatted_end": "01:32:02.000",
      "text": "اونو باست کار فرماسی نمی کنی"
    },
    {
      "id": 19,
      "start": 5522.0,
      "end": 5524.0,
      "formatted_start": "01:32:02.000",
      "formatted_end": "01:32:04.000",
      "text": "نمی کنی؟ نه نمی کنی"
    },
    {
      "id": 20,
      "start": 5524.0,
      "end": 5526.0,
      "formatted_start": "01:32:04.000",
      "formatted_end": "01:32:06.000",
      "text": "نه فرماسی نمی کنی، یه تیکرشو کنی"
    },
    {
      "id": 21,
      "start": 5526.0,
      "end": 5528.0,
      "formatted_start": "01:32:06.000",
      "formatted_end": "01:32:08.000",
      "text": "به خاطر هم میگن"
    },
    {
      "id": 22,
      "start": 5528.0,
      "end": 5530.0,
      "formatted_start": "01:32:08.000",
      "formatted_end": "01:32:10.000",
      "text": "من به شویق مستاق بگم"
    },
    {
      "id": 23,
      "start": 5530.0,
      "end": 5532.0,
      "formatted_start": "01:32:10.000",
      "formatted_end": "01:32:12.000",
      "text": "نه بخوا میزین"
    },
    {
      "id": 24,
      "start": 5532.0,
      "end": 5534.0,
      "formatted_start": "01:32:12.000",
      "formatted_end": "01:32:14.000",
      "text": "چرا؟"
    },
    {
      "id": 25,
      "start": 5534.0,
      "end": 5536.0,
      "formatted_start": "01:32:14.000",
      "formatted_end": "01:32:16.000",
      "text": "همه رژیمی شدن اینجا"
    },
    {
      "id": 26,
      "start": 5536.0,
      "end": 5538.0,
      "formatted_start": "01:32:16.000",
      "formatted_end": "01:32:18.000",
      "text": "خب خوبه، اما از خب به همه تون رژیمی شد"
    },
    {
      "id": 27,
      "start": 5538.0,
      "end": 5540.0,
      "formatted_start": "01:32:18.000",
      "formatted_end": "01:32:20.000",
      "text": "چیه؟ چیزی نمی کنی؟ نه ها چاک میشین"
    },
    {
      "id": 28,
      "start": 5542.0,
      "end": 5544.0,
      "formatted_start": "01:32:22.000",
      "formatted_end": "01:32:24.000",
      "text": "یه فیلم خواهدتری بذاش برا من"
    },
    {
      "id": 29,
      "start": 5544.0,
      "end": 5549.46,
      "formatted_start": "01:32:24.000",
      "formatted_end": "01:32:29.460",
      "text": "بیا نگاه تو رو خدا بیا"
    },
    {
      "id": 30,
      "start": 5549.46,
      "end": 5551.42,
      "formatted_start": "01:32:29.460",
      "formatted_end": "01:32:31.420",
      "text": "20 سال با این کنی خوبه"
    },
    {
      "id": 31,
      "start": 5551.42,
      "end": 5552.52,
      "formatted_start": "01:32:31.420",
      "formatted_end": "01:32:32.520",
      "text": "نسخه خوده"
    },
    {
      "id": 32,
      "start": 5552.52,
      "end": 5555.58,
      "formatted_start": "01:32:32.520",
      "formatted_end": "01:32:35.580",
      "text": "نمیادم یه نسخه با منه ایشه ندار"
    },
    {
      "id": 33,
      "start": 5555.58,
      "end": 5558.78,
      "formatted_start": "01:32:35.580",
      "formatted_end": "01:32:38.780",
      "text": "20 سال با این یه جا زندگی کردم"
    },
    {
      "id": 34,
      "start": 5558.78,
      "end": 5562.52,
      "formatted_start": "01:32:38.780",
      "formatted_end": "01:32:42.520",
      "text": "ببینید وقتی گذشت کنید"
    },
    {
      "id": 35,
      "start": 5562.52,
      "end": 5565.98,
      "formatted_start": "01:32:42.520",
      "formatted_end": "01:32:45.980",
      "text": "20 سال با این یه جا زندگی کردم نگاه کن"
    },
    {
      "id": 36,
      "start": 5565.98,
      "end": 5569.38,
      "formatted_start": "01:32:45.980",
      "formatted_end": "01:32:49.380",
      "text": "اکتفا خودوی خواهد میکنید که این شروع برم"
    },
    {
      "id": 37,
      "start": 5569.38,
      "end": 5599.38,
      "formatted_start": "01:32:49.380",
      "formatted_end": "01:33:19.380",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 38,
      "start": 5599.38,
      "end": 5603.38,
      "formatted_start": "01:33:19.380",
      "formatted_end": "01:33:23.380",
      "text": "اینجا ساده من"
    },
    {
      "id": 39,
      "start": 5603.38,
      "end": 5605.38,
      "formatted_start": "01:33:23.380",
      "formatted_end": "01:33:25.380",
      "text": "نه دیگه یکیش رو بازداشت هم یکیش هست"
    },
    {
      "id": 40,
      "start": 5605.38,
      "end": 5609.38,
      "formatted_start": "01:33:25.380",
      "formatted_end": "01:33:29.380",
      "text": "از اون نظر نصفه میگم"
    },
    {
      "id": 41,
      "start": 5609.38,
      "end": 5613.38,
      "formatted_start": "01:33:29.380",
      "formatted_end": "01:33:33.380",
      "text": "یکیش هست نصفه من هم اینجا هست"
    },
    {
      "id": 42,
      "start": 5613.38,
      "end": 5615.38,
      "formatted_start": "01:33:33.380",
      "formatted_end": "01:33:35.380",
      "text": "خدای من"
    },
    {
      "id": 43,
      "start": 5615.38,
      "end": 5621.38,
      "formatted_start": "01:33:35.380",
      "formatted_end": "01:33:41.380",
      "text": "از حتما بخورم"
    },
    {
      "id": 44,
      "start": 5621.38,
      "end": 5623.38,
      "formatted_start": "01:33:41.380",
      "formatted_end": "01:33:43.380",
      "text": "بابا از کوری فرسته برادم"
    },
    {
      "id": 45,
      "start": 5623.38,
      "end": 5625.38,
      "formatted_start": "01:33:43.380",
      "formatted_end": "01:33:45.380",
      "text": "نه دیگه من از اون رو بودم مشهر باشم"
    },
    {
      "id": 46,
      "start": 5625.38,
      "end": 5627.38,
      "formatted_start": "01:33:45.380",
      "formatted_end": "01:33:47.380",
      "text": "چرا از نزدیک پنج نمیشه"
    },
    {
      "id": 47,
      "start": 5627.38,
      "end": 5630.38,
      "formatted_start": "01:33:47.380",
      "formatted_end": "01:33:50.380",
      "text": "بشنگ برسنم میشه آره"
    },
    {
      "id": 48,
      "start": 5630.38,
      "end": 5633.38,
      "formatted_start": "01:33:50.380",
      "formatted_end": "01:33:53.380",
      "text": "خیلی بد از دورا بعده هیچی پیدا نمیشه برای خوردم"
    },
    {
      "id": 49,
      "start": 5633.38,
      "end": 5636.38,
      "formatted_start": "01:33:53.380",
      "formatted_end": "01:33:56.380",
      "text": "یک چونه باز بگو نه هیچی دوش نیست"
    },
    {
      "id": 50,
      "start": 5636.38,
      "end": 5639.38,
      "formatted_start": "01:33:56.380",
      "formatted_end": "01:33:59.380",
      "text": "اصلا من وقتی از چون میبینم گشنم نیست"
    },
    {
      "id": 51,
      "start": 5639.38,
      "end": 5641.38,
      "formatted_start": "01:33:59.380",
      "formatted_end": "01:34:01.380",
      "text": "من خیلی گشنم میشه"
    },
    {
      "id": 52,
      "start": 5641.38,
      "end": 5646.38,
      "formatted_start": "01:34:01.380",
      "formatted_end": "01:34:06.380",
      "text": "چون میدونی من تو خونه بد از دورا خیلی علکه ی حل حوله میخورم"
    },
    {
      "id": 53,
      "start": 5646.38,
      "end": 5648.38,
      "formatted_start": "01:34:06.380",
      "formatted_end": "01:34:08.380",
      "text": "آدت دارم آره"
    },
    {
      "id": 54,
      "start": 5648.38,
      "end": 5654.38,
      "formatted_start": "01:34:08.380",
      "formatted_end": "01:34:14.380",
      "text": "اصلا بدون چیز هر روز نهاره که خوردم من زبان به لپاسه نمیشورم"
    },
    {
      "id": 55,
      "start": 5654.38,
      "end": 5658.38,
      "formatted_start": "01:34:14.380",
      "formatted_end": "01:34:18.380",
      "text": "زرپاون میمیشورم به عشق اینکه الان میخوام برم دراز بکشم تقمه بخورم"
    },
    {
      "id": 56,
      "start": 5658.38,
      "end": 5664.38,
      "formatted_start": "01:34:18.380",
      "formatted_end": "01:34:24.380",
      "text": "من از کپ کمچن دیگر نمیخورم"
    },
    {
      "id": 57,
      "start": 5664.38,
      "end": 5666.38,
      "formatted_start": "01:34:24.380",
      "formatted_end": "01:34:26.380",
      "text": "از هر شب شام این نکنم"
    },
    {
      "id": 58,
      "start": 5666.38,
      "end": 5669.38,
      "formatted_start": "01:34:26.380",
      "formatted_end": "01:34:29.380",
      "text": "در اولین از کپ کمچن یه چایی بکنم"
    },
    {
      "id": 59,
      "start": 5669.38,
      "end": 5671.38,
      "formatted_start": "01:34:29.380",
      "formatted_end": "01:34:31.380",
      "text": "اما دیگر چایی رو تکرار نسان آبجوشم بگیرم"
    },
    {
      "id": 60,
      "start": 5671.38,
      "end": 5673.38,
      "formatted_start": "01:34:31.380",
      "formatted_end": "01:34:33.380",
      "text": "نه من درست میگشم"
    },
    {
      "id": 61,
      "start": 5673.38,
      "end": 5676.38,
      "formatted_start": "01:34:33.380",
      "formatted_end": "01:34:36.380",
      "text": "چا دیگر نیم ساعتی با تقمه خودم رو سرگرم میکنم"
    },
    {
      "id": 62,
      "start": 5676.38,
      "end": 5678.38,
      "formatted_start": "01:34:36.380",
      "formatted_end": "01:34:38.380",
      "text": "و ترمیزی رو تقمه فرده اون"
    },
    {
      "id": 63,
      "start": 5678.38,
      "end": 5680.38,
      "formatted_start": "01:34:38.380",
      "formatted_end": "01:34:40.380",
      "text": "اگر هم خواستن یک چورتی میزنن"
    },
    {
      "id": 64,
      "start": 5680.38,
      "end": 5682.38,
      "formatted_start": "01:34:40.380",
      "formatted_end": "01:34:42.380",
      "text": "و برم میشنم تازه نبه و دوباره چایی"
    },
    {
      "id": 65,
      "start": 5682.38,
      "end": 5684.38,
      "formatted_start": "01:34:42.380",
      "formatted_end": "01:34:44.380",
      "text": "اگه شیرنه یک چیزی داشته باشه اونو توپونه اونو"
    },
    {
      "id": 66,
      "start": 5684.38,
      "end": 5687.38,
      "formatted_start": "01:34:44.380",
      "formatted_end": "01:34:47.380",
      "text": "بسر همین انگار عادت کردم چیزی بکنم"
    },
    {
      "id": 67,
      "start": 5687.38,
      "end": 5688.38,
      "formatted_start": "01:34:47.380",
      "formatted_end": "01:34:48.380",
      "text": "عادت دارید بکنیم"
    },
    {
      "id": 68,
      "start": 5688.38,
      "end": 5690.38,
      "formatted_start": "01:34:48.380",
      "formatted_end": "01:34:50.380",
      "text": "اوه سمیه گوش نمیشه"
    },
    {
      "id": 69,
      "start": 5690.38,
      "end": 5692.38,
      "formatted_start": "01:34:50.380",
      "formatted_end": "01:34:52.380",
      "text": "نه اونوش منو همه از کک دوست کنم"
    },
    {
      "id": 70,
      "start": 5692.38,
      "end": 5694.38,
      "formatted_start": "01:34:52.380",
      "formatted_end": "01:34:54.380",
      "text": "چون نمیشه؟"
    },
    {
      "id": 71,
      "start": 5694.38,
      "end": 5696.38,
      "formatted_start": "01:34:54.380",
      "formatted_end": "01:34:56.380",
      "text": "خودت که اینقدر قدر میخورم"
    },
    {
      "id": 72,
      "start": 5696.38,
      "end": 5698.38,
