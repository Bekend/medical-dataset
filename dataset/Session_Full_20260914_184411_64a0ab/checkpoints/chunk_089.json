  "stt_segments": [
    {
      "id": 0,
      "start": 26700.0,
      "end": 26702.0,
      "formatted_start": "07:25:00.000",
      "formatted_end": "07:25:02.000",
      "text": "خوامیشی؟"
    },
    {
      "id": 1,
      "start": 26702.0,
      "end": 26704.0,
      "formatted_start": "07:25:02.000",
      "formatted_end": "07:25:04.000",
      "text": "بیزنی."
    },
    {
      "id": 2,
      "start": 26704.0,
      "end": 26706.0,
      "formatted_start": "07:25:04.000",
      "formatted_end": "07:25:06.000",
      "text": "یوم ایرانی هم دیگه دارد."
    },
    {
      "id": 3,
      "start": 26706.0,
      "end": 26710.0,
      "formatted_start": "07:25:06.000",
      "formatted_end": "07:25:10.000",
      "text": "اولا برای آفیزش و بینیش، باید یک صبح نادیم کنم."
    },
    {
      "id": 4,
      "start": 26710.0,
      "end": 26714.0,
      "formatted_start": "07:25:10.000",
      "formatted_end": "07:25:14.000",
      "text": "نیست که نیستن؟ صبح ها شب بیشتر دیگه، درسته؟"
    },
    {
      "id": 5,
      "start": 26714.0,
      "end": 26716.0,
      "formatted_start": "07:25:14.000",
      "formatted_end": "07:25:16.000",
      "text": "یه روز بیشتر شدی نیستن."
    },
    {
      "id": 6,
      "start": 26716.0,
      "end": 26718.0,
      "formatted_start": "07:25:16.000",
      "formatted_end": "07:25:18.000",
      "text": "آماده پیش؟"
    },
    {
      "id": 7,
      "start": 26718.0,
      "end": 26722.0,
      "formatted_start": "07:25:18.000",
      "formatted_end": "07:25:22.000",
      "text": "سپورتن همین، و این اصلا چیز نیست."
    },
    {
      "id": 8,
      "start": 26722.0,
      "end": 26726.0,
      "formatted_start": "07:25:22.000",
      "formatted_end": "07:25:26.000",
      "text": "به نظر من آنتیویتی کش ندهد، چایی نشان رو سپورت ندهد،"
    },
    {
      "id": 9,
      "start": 26726.0,
      "end": 26728.0,
      "formatted_start": "07:25:26.000",
      "formatted_end": "07:25:28.000",
      "text": "از اینجا باید باید بردارید"
    },
    {
      "id": 10,
      "start": 26728.0,
      "end": 26730.0,
      "formatted_start": "07:25:28.000",
      "formatted_end": "07:25:30.000",
      "text": "و از اینجا باید بردارید"
    },
    {
      "id": 11,
      "start": 26730.0,
      "end": 26732.0,
      "formatted_start": "07:25:30.000",
      "formatted_end": "07:25:32.000",
      "text": "و از اینجا باید بردارید"
    },
    {
      "id": 12,
      "start": 26732.0,
      "end": 26734.0,
      "formatted_start": "07:25:32.000",
      "formatted_end": "07:25:34.000",
      "text": "و از اینجا باید بردارید"
    },
    {
      "id": 13,
      "start": 26734.0,
      "end": 26736.0,
      "formatted_start": "07:25:34.000",
      "formatted_end": "07:25:36.000",
      "text": "و از اینجا باید بردارید"
    },
    {
      "id": 14,
      "start": 26736.0,
      "end": 26738.0,
      "formatted_start": "07:25:36.000",
      "formatted_end": "07:25:38.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 15,
      "start": 26738.0,
      "end": 26740.0,
      "formatted_start": "07:25:38.000",
      "formatted_end": "07:25:40.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 16,
      "start": 26740.0,
      "end": 26742.0,
      "formatted_start": "07:25:40.000",
      "formatted_end": "07:25:42.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 17,
      "start": 26742.0,
      "end": 26744.0,
      "formatted_start": "07:25:42.000",
      "formatted_end": "07:25:44.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 18,
      "start": 26744.0,
      "end": 26746.0,
      "formatted_start": "07:25:44.000",
      "formatted_end": "07:25:46.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 19,
      "start": 26746.0,
      "end": 26748.0,
      "formatted_start": "07:25:46.000",
      "formatted_end": "07:25:48.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 20,
      "start": 26748.0,
      "end": 26750.0,
      "formatted_start": "07:25:48.000",
      "formatted_end": "07:25:50.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 21,
      "start": 26750.0,
      "end": 26752.0,
      "formatted_start": "07:25:50.000",
      "formatted_end": "07:25:52.000",
      "text": "و از اینجا بردارید"
    },
    {
      "id": 22,
      "start": 26752.0,
      "end": 26772.0,
      "formatted_start": "07:25:52.000",
      "formatted_end": "07:26:12.000",
      "text": "از اینکه اینکه از این زایات رو برداری کنید اگر گال ببینه"
    },
    {
      "id": 23,
      "start": 26772.0,
      "end": 26778.0,
      "formatted_start": "07:26:12.000",
      "formatted_end": "07:26:18.000",
      "text": "خب، یه ما از مصمعی میشیم و 100% گال ها بسیاری خوب میتونیم بزنیم."
    },
    {
      "id": 24,
      "start": 26778.0,
      "end": 26780.0,
      "formatted_start": "07:26:18.000",
      "formatted_end": "07:26:20.000",
      "text": "میتونیم حالا انجام بدیم."
    },
    {
      "id": 25,
      "start": 26782.0,
      "end": 26785.0,
      "formatted_start": "07:26:22.000",
      "formatted_end": "07:26:25.000",
      "text": "چون قبل این هم گال گره داریم شما شده بود."
    },
    {
      "id": 26,
      "start": 26785.0,
      "end": 26788.0,
      "formatted_start": "07:26:25.000",
      "formatted_end": "07:26:28.000",
      "text": "به باره گرفت استعمال هم میشه."
    },
    {
      "id": 27,
      "start": 26788.0,
      "end": 26791.0,
      "formatted_start": "07:26:28.000",
      "formatted_end": "07:26:31.000",
      "text": "اتفاقا میشه برنامه به گال گره، گال یه گره میاد خب."
    },
    {
      "id": 28,
      "start": 26791.0,
      "end": 26794.0,
      "formatted_start": "07:26:31.000",
      "formatted_end": "07:26:34.000",
      "text": "همه که یه باره امگاهی گرفته استعمالش میشه."
    },
    {
      "id": 29,
      "start": 26795.0,
      "end": 26800.0,
      "formatted_start": "07:26:35.000",
      "formatted_end": "07:26:40.000",
      "text": "برای اینکه تره مصمعی باشید، باید بزنیم، باید بزنیم یا نیست."
    },
    {
      "id": 30,
      "start": 26800.0,
      "end": 26803.34,
      "formatted_start": "07:26:40.000",
      "formatted_end": "07:26:43.340",
      "text": "همچنین نمیتونه صد درست دارد به شما بگی این گاله یا نه"
    },
    {
      "id": 31,
      "start": 26803.34,
      "end": 26806.24,
      "formatted_start": "07:26:43.340",
      "formatted_end": "07:26:46.240",
      "text": "به مدخل صد دوست هم باید این موضوع رو ببینیم"
    },
    {
      "id": 32,
      "start": 26806.24,
      "end": 26808.0,
      "formatted_start": "07:26:46.240",
      "formatted_end": "07:26:48.000",
      "text": "ولی بیشتر به گال میخوره"
    },
    {
      "id": 33,
      "start": 26808.52,
      "end": 26812.06,
      "formatted_start": "07:26:48.520",
      "formatted_end": "07:26:52.060",
      "text": "حالا این کرم دست استفاده بود باشی"
    },
    {
      "id": 34,
      "start": 26812.06,
      "end": 26815.3,
      "formatted_start": "07:26:52.060",
      "formatted_end": "07:26:55.300",
      "text": "این کرم دست دارد"
    },
    {
      "id": 35,
      "start": 26815.3,
      "end": 26818.5,
      "formatted_start": "07:26:55.300",
      "formatted_end": "07:26:58.500",
      "text": "کشونن لباس ها پرمتری نزدیردن به پایین هفته"
    },
    {
      "id": 36,
      "start": 26818.5,
      "end": 26819.92,
      "formatted_start": "07:26:58.500",
      "formatted_end": "07:26:59.920",
      "text": "یه بار تا سه هفته"
    },
    {
      "id": 37,
      "start": 26819.92,
      "end": 26823.54,
      "formatted_start": "07:26:59.920",
      "formatted_end": "07:27:03.540",
      "text": "ولی دست دارد این رو مثلا امشب پرمتری رو زدی"
    },
    {
      "id": 38,
      "start": 26823.54,
      "end": 26826.3,
      "formatted_start": "07:27:03.540",
      "formatted_end": "07:27:06.300",
      "text": "لباس نومی کشه میخواد نومشب بزن"
    },
    {
      "id": 39,
      "start": 26826.3,
      "end": 26827.38,
      "formatted_start": "07:27:06.300",
      "formatted_end": "07:27:07.380",
      "text": "مستو ببرش کمون"
    },
    {
      "id": 40,
      "start": 26827.38,
      "end": 26835.38,
      "formatted_start": "07:27:07.380",
      "formatted_end": "07:27:15.380",
      "text": "از فردا دستازه را هم به ما رو بدن. دستازه هر روزه. تا وقتی که خواهی آد می روید."
    },
    {
      "id": 41,
      "start": 26835.38,
      "end": 26840.38,
      "formatted_start": "07:27:15.380",
      "formatted_end": "07:27:20.380",
      "text": "من خورد می کنم فردا رو بیرون شوید."
    },
    {
      "id": 42,
      "start": 26840.38,
      "end": 26848.38,
      "formatted_start": "07:27:20.380",
      "formatted_end": "07:27:28.380",
      "text": "اگر می کنم این سرلا را به نرم بهش، سرلا نمارد بگیر. سرلا تو شیر و آب داره."
    },
    {
      "id": 43,
      "start": 26848.38,
      "end": 26849.38,
      "formatted_start": "07:27:28.380",
      "formatted_end": "07:27:29.380",
      "text": "این نواتی؟"
    },
    {
      "id": 44,
      "start": 26849.38,
      "end": 26851.38,
      "formatted_start": "07:27:29.380",
      "formatted_end": "07:27:31.380",
      "text": "تا که این بردش نداره"
    },
    {
      "id": 45,
      "start": 26851.38,
      "end": 26853.38,
      "formatted_start": "07:27:31.380",
      "formatted_end": "07:27:33.380",
      "text": "این سالی دیگه برایش پرائید"
    },
    {
      "id": 46,
      "start": 26853.38,
      "end": 26854.38,
      "formatted_start": "07:27:33.380",
      "formatted_end": "07:27:34.380",
      "text": "این سالی دیگه برایش پرائید"
    },
    {
      "id": 47,
      "start": 26854.38,
      "end": 26858.38,
      "formatted_start": "07:27:34.380",
      "formatted_end": "07:27:38.380",
      "text": "سری را کسان نوات بکرد، اولی از شیرش را نوات بکرد"
    },
    {
      "id": 48,
      "start": 26858.38,
      "end": 26862.38,
      "formatted_start": "07:27:38.380",
      "formatted_end": "07:27:42.380",
      "text": "الان دیگه غذای این، توپو مخ هست، اون هم خیلی کم"
    },
    {
      "id": 49,
      "start": 26862.38,
      "end": 26864.38,
      "formatted_start": "07:27:42.380",
      "formatted_end": "07:27:44.380",
      "text": "از زرده، جمعه کل رو برون هم حساس کشه"
    },
    {
      "id": 50,
      "start": 26864.38,
      "end": 26868.38,
      "formatted_start": "07:27:44.380",
      "formatted_end": "07:27:48.380",
      "text": "واسه همین سه روز اندازه یک مخ خود بده، بیشتر نداره"
    },
    {
      "id": 51,
      "start": 26868.38,
      "end": 26872.38,
      "formatted_start": "07:27:48.380",
      "formatted_end": "07:27:52.380",
      "text": "برای سبزیجاد، سود، فرینی با آب، چیل پاشتش چیل؟"
    },
    {
      "id": 52,
      "start": 26872.38,
      "end": 26875.38,
      "formatted_start": "07:27:52.380",
      "formatted_end": "07:27:55.380",
      "text": "اون ماشه رو بوده، اون ماشه رو بشترست"
    },
    {
      "id": 53,
      "start": 26875.38,
      "end": 26880.38,
      "formatted_start": "07:27:55.380",
      "formatted_end": "07:28:00.380",
      "text": "دیگه، همین که لطفیه، یه ذره مز و سیمه رو بشون"
    },
    {
      "id": 54,
      "start": 26883.38,
      "end": 26886.38,
      "formatted_start": "07:28:03.380",
      "formatted_end": "07:28:06.380",
      "text": "دستات رو بگیریم، ورنگیه سازش براتون نداریم"
    },
    {
      "id": 55,
      "start": 26886.38,
      "end": 26888.38,
      "formatted_start": "07:28:06.380",
      "formatted_end": "07:28:08.380",
      "text": "باید نداریم، باید نداریم"
    },
    {
      "id": 56,
      "start": 26888.38,
      "end": 26889.38,
      "formatted_start": "07:28:08.380",
      "formatted_end": "07:28:09.380",
      "text": "چیه بود؟"
    },
    {
      "id": 57,
      "start": 26889.38,
      "end": 26890.38,
      "formatted_start": "07:28:09.380",
      "formatted_end": "07:28:10.380",
      "text": "اون همون سیاره رو هم گرفتن"
    },
    {
      "id": 58,
      "start": 26890.38,
      "end": 26891.38,
      "formatted_start": "07:28:10.380",
      "formatted_end": "07:28:11.380",
      "text": "تازه گرفتی؟"
    },
    {
      "id": 59,
      "start": 26891.38,
      "end": 26892.38,
      "formatted_start": "07:28:11.380",
      "formatted_end": "07:28:12.380",
      "text": "نه"
    },
    {
      "id": 60,
      "start": 26892.38,
      "end": 26895.38,
      "formatted_start": "07:28:12.380",
      "formatted_end": "07:28:15.380",
      "text": "همین همون رو گرفتی، اونو براتون نداریم"
    },
    {
      "id": 61,
      "start": 26895.38,
      "end": 26925.38,
      "formatted_start": "07:28:15.380",
      "formatted_end": "07:28:45.380",
