  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "این خود را برداشت."
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6640.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6660.0,
      "end": 6662.0,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:02.000",
      "text": "با اینکه همه چیز تلافه اید"
    },
    {
      "id": 3,
      "start": 6669.4,
      "end": 6671.4,
      "formatted_start": "01:51:09.400",
      "formatted_end": "01:51:11.400",
      "text": "بلند شید الان خرید میشه"
    },
    {
      "id": 4,
      "start": 6672.2,
      "end": 6674.2,
      "formatted_start": "01:51:12.200",
      "formatted_end": "01:51:14.200",
      "text": "به فرقی دیدی پدرسون رو خودشون دید"
    },
    {
      "id": 5,
      "start": 6677.4,
      "end": 6679.4,
      "formatted_start": "01:51:17.400",
      "formatted_end": "01:51:19.400",
      "text": "تو قراره تدرسی؟ چیزی که میتونی؟"
    },
    {
      "id": 6,
      "start": 6680.2,
      "end": 6681.2,
      "formatted_start": "01:51:20.200",
      "formatted_end": "01:51:21.200",
      "text": "خب من خیلی عجیب دارم"
    },
    {
      "id": 7,
      "start": 6681.2,
      "end": 6683.2,
      "formatted_start": "01:51:21.200",
      "formatted_end": "01:51:23.200",
      "text": "تو به من کمک کردی درست داریم"
    },
    {
      "id": 8,
      "start": 6683.2,
      "end": 6685.2,
      "formatted_start": "01:51:23.200",
      "formatted_end": "01:51:25.200",
      "text": "من نکردم برای برگزارم"
    },
    {
      "id": 9,
      "start": 6685.2,
      "end": 6687.2,
      "formatted_start": "01:51:25.200",
      "formatted_end": "01:51:27.200",
      "text": "خوشحال باش"
    },
    {
      "id": 10,
      "start": 6687.2,
      "end": 6689.2,
      "formatted_start": "01:51:27.200",
      "formatted_end": "01:51:29.200",
      "text": "باش و بید داخل"
    },
    {
      "id": 11,
      "start": 6690.0,
      "end": 6700.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:40.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 6720.0,
      "end": 6740.0,
      "formatted_start": "01:52:00.000",
      "formatted_end": "01:52:20.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 6740.0,
      "end": 6760.0,
      "formatted_start": "01:52:20.000",
      "formatted_end": "01:52:40.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 6760.0,
      "end": 6764.68,
      "formatted_start": "01:52:40.000",
      "formatted_end": "01:52:44.680",
      "text": "از اینکه سطح ماست سمن سار ردار دارد"
    },
    {
      "id": 15,
      "start": 6764.68,
      "end": 6772.88,
      "formatted_start": "01:52:44.680",
      "formatted_end": "01:52:52.880",
      "text": "امروز میخوای آقای شما به ازداد برم که دیگه ماست سمن رو از بیرون رنگ رو باید استعمال کنید"
    },
    {
      "id": 16,
      "start": 6772.88,
      "end": 6776.4,
      "formatted_start": "01:52:52.880",
      "formatted_end": "01:52:56.400",
      "text": "من صدا هستم لایک رو بخورم و یادت برم"
    },
    {
      "id": 17,
      "start": 6776.4,
      "end": 6782.08,
      "formatted_start": "01:52:56.400",
      "formatted_end": "01:53:02.080",
      "text": "شیریت از لبنیاتی گردید رو داخل قبلم یک یارو بیامدید"
    },
    {
      "id": 18,
      "start": 6782.08,
      "end": 6784.82,
      "formatted_start": "01:53:02.080",
      "formatted_end": "01:53:04.820",
      "text": "میدارید سرگاز برونه یک ساعت"
    },
    {
      "id": 19,
      "start": 6784.82,
      "end": 6786.8,
      "formatted_start": "01:53:04.820",
      "formatted_end": "01:53:06.800",
      "text": "شوشت ریز بخوره"
    },
    {
      "id": 20,
      "start": 6786.8,
      "end": 6816.8,
      "formatted_start": "01:53:06.800",
      "formatted_end": "01:53:36.800",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 21,
      "start": 6816.8,
      "end": 6822.8,
      "formatted_start": "01:53:36.800",
      "formatted_end": "01:53:42.800",
      "text": "اگر هم بدنم برمیدیم و گشیم برم توی یک درسته ای کنار"
    },
    {
      "id": 22,
      "start": 6822.8,
      "end": 6824.8,
      "formatted_start": "01:53:42.800",
      "formatted_end": "01:53:44.800",
      "text": "میدونیم شاسته"
    },
    {
      "id": 23,
      "start": 6824.8,
      "end": 6828.8,
      "formatted_start": "01:53:44.800",
      "formatted_end": "01:53:48.800",
      "text": "برسیمش داخل مایه"
    },
    {
      "id": 24,
      "start": 6828.8,
      "end": 6833.8,
      "formatted_start": "01:53:48.800",
      "formatted_end": "01:53:53.800",
      "text": "مایه مونو هم میدنیم تا شکر و نمک کاملا حل بشه"
    },
    {
      "id": 25,
      "start": 6833.8,
      "end": 6835.8,
      "formatted_start": "01:53:53.800",
      "formatted_end": "01:53:55.800",
      "text": "و یک درست بشه"
    },
    {
      "id": 26,
      "start": 6835.8,
      "end": 6839.8,
      "formatted_start": "01:53:55.800",
      "formatted_end": "01:53:59.800",
      "text": "کلیک یک ساعت بلویت بود رو میداریم کنار"
    },
    {
      "id": 27,
      "start": 6839.8,
      "end": 6842.8,
      "formatted_start": "01:53:59.800",
      "formatted_end": "01:54:02.800",
      "text": "دستمونو یه دقیقه داخل شیره می کنیم"
    },
    {
      "id": 28,
      "start": 6842.8,
      "end": 6846.8,
      "formatted_start": "01:54:02.800",
      "formatted_end": "01:54:06.800",
      "text": "اگر نفوخ می کنید مایر را بهش اضافه کنید."
    },
    {
      "id": 29,
      "start": 6846.8,
      "end": 6853.8,
      "formatted_start": "01:54:06.800",
      "formatted_end": "01:54:13.800",
      "text": "این قدود یک ساعت طول می کنید که شیره خنک بشه بعد از خنک شدنش مایر را اضافه می کنید."
    },
    {
      "id": 30,
      "start": 6853.8,
      "end": 6861.8,
      "formatted_start": "01:54:13.800",
      "formatted_end": "01:54:21.800",
      "text": "شیره سینی دارد سبت و چون نباید در درمون شیره برند اینجا خیلی آباد می کنید داخل شیره"
    },
    {
      "id": 31,
      "start": 6861.8,
      "end": 6870.8,
      "formatted_start": "01:54:21.800",
      "formatted_end": "01:54:30.800",
      "text": "و با یک پدرونش را می بندید قدود هیچ ساعت بعد از هیچ ساعتی در حیوان یمشان یک ویدو چار درد هم دستش نمی دارید."
    },
    {
      "id": 32,
      "start": 6870.8,
      "end": 6874.8,
      "formatted_start": "01:54:30.800",
      "formatted_end": "01:54:34.800",
      "text": "یه همچین ماستر سویمیتایی کنید"
    },
    {
      "id": 33,
      "start": 6874.8,
      "end": 6878.8,
      "formatted_start": "01:54:34.800",
      "formatted_end": "01:54:38.800",
      "text": "یعنی نگه فراشون که از طعمش دوشت"
    },
    {
      "id": 34,
      "start": 6878.8,
      "end": 6882.8,
      "formatted_start": "01:54:38.800",
      "formatted_end": "01:54:42.800",
      "text": "شده از در هم بزنی و کشور در روش میگرد"
    },
    {
      "id": 35,
      "start": 6882.8,
      "end": 6884.8,
      "formatted_start": "01:54:42.800",
      "formatted_end": "01:54:44.800",
      "text": "من بادر از دانشگاه هستم"
    },
    {
      "id": 36,
      "start": 6884.8,
      "end": 6888.8,
      "formatted_start": "01:54:44.800",
      "formatted_end": "01:54:48.800",
      "text": "یکی از دانشگاه ها از زمین عرضی پیترسان و فارکس فعالیت داشته"
    },
    {
      "id": 37,
      "start": 6888.8,
      "end": 6892.8,
      "formatted_start": "01:54:48.800",
      "formatted_end": "01:54:52.800",
      "text": "به من معرفی کرد و من با شکل با بادران را شروع شده هستم"
    },
    {
      "id": 38,
      "start": 6892.8,
      "end": 6894.8,
      "formatted_start": "01:54:52.800",
      "formatted_end": "01:54:54.800",
      "text": "واقعا اشکالم باید بادران"
    },
    {
      "id": 39,
      "start": 6894.8,
      "end": 6898.8,
      "formatted_start": "01:54:54.800",
      "formatted_end": "01:54:58.800",
      "text": "و تدریج اول با اسبات شروع کردم"
    },
    {
      "id": 40,
      "start": 6898.8,
      "end": 6900.8,
      "formatted_start": "01:54:58.800",
      "formatted_end": "01:55:00.800",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}