  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15302.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:02.000",
      "text": "از این طب داریم که خودم در این طب داره."
    },
    {
      "id": 1,
      "start": 15302.0,
      "end": 15304.0,
      "formatted_start": "04:15:02.000",
      "formatted_end": "04:15:04.000",
      "text": "از این طب داریم که خودم در این طب داره."
    },
    {
      "id": 2,
      "start": 15304.0,
      "end": 15306.0,
      "formatted_start": "04:15:04.000",
      "formatted_end": "04:15:06.000",
      "text": "اکثر مادراتو تابستان حسین کنن بچه طب داره؟"
    },
    {
      "id": 3,
      "start": 15306.0,
      "end": 15308.0,
      "formatted_start": "04:15:06.000",
      "formatted_end": "04:15:08.000",
      "text": "اکثر مادراتو تابستان حسین کنن بچه طب داره؟"
    },
    {
      "id": 4,
      "start": 15308.0,
      "end": 15310.0,
      "formatted_start": "04:15:08.000",
      "formatted_end": "04:15:10.000",
      "text": "نه."
    },
    {
      "id": 5,
      "start": 15310.0,
      "end": 15312.0,
      "formatted_start": "04:15:10.000",
      "formatted_end": "04:15:12.000",
      "text": "تب درجه بالای 37 و این باشه؟"
    },
    {
      "id": 6,
      "start": 15312.0,
      "end": 15314.0,
      "formatted_start": "04:15:12.000",
      "formatted_end": "04:15:14.000",
      "text": "تب درجه بالای 37 و این باشه؟"
    },
    {
      "id": 7,
      "start": 15314.0,
      "end": 15316.0,
      "formatted_start": "04:15:14.000",
      "formatted_end": "04:15:16.000",
      "text": "او درجه نه، یه نکتبه خودم هموشه داره."
    },
    {
      "id": 8,
      "start": 15316.0,
      "end": 15318.0,
      "formatted_start": "04:15:16.000",
      "formatted_end": "04:15:18.000",
      "text": "او درجه نه، یه نکتبه خودم هموشه داره."
    },
    {
      "id": 9,
      "start": 15318.0,
      "end": 15320.0,
      "formatted_start": "04:15:18.000",
      "formatted_end": "04:15:20.000",
      "text": "داقه."
    },
    {
      "id": 10,
      "start": 15320.0,
      "end": 15323.66,
      "formatted_start": "04:15:20.000",
      "formatted_end": "04:15:23.660",
      "text": "چیه منو بیخورن؟ هم میخواستن جواب و غذاویی که داریم بیخورن رو میدن"
    },
    {
      "id": 11,
      "start": 15323.66,
      "end": 15325.0,
      "formatted_start": "04:15:23.660",
      "formatted_end": "04:15:25.000",
      "text": "چند وقتشه؟"
    },
    {
      "id": 12,
      "start": 15325.0,
      "end": 15327.0,
      "formatted_start": "04:15:25.000",
      "formatted_end": "04:15:27.000",
      "text": "یک سال و سه ماه"
    },
    {
      "id": 13,
      "start": 15329.0,
      "end": 15331.0,
      "formatted_start": "04:15:29.000",
      "formatted_end": "04:15:31.000",
      "text": "هیچ دقیقه شیز؟"
    },
    {
      "id": 14,
      "start": 15331.0,
      "end": 15334.0,
      "formatted_start": "04:15:31.000",
      "formatted_end": "04:15:34.000",
      "text": "وقتش کم فقط همچین هیچ چیه بیخورن"
    },
    {
      "id": 15,
      "start": 15334.0,
      "end": 15336.0,
      "formatted_start": "04:15:34.000",
      "formatted_end": "04:15:36.000",
      "text": "هر چیه بیخورن"
    },
    {
      "id": 16,
      "start": 15336.0,
      "end": 15338.0,
      "formatted_start": "04:15:36.000",
      "formatted_end": "04:15:38.000",
      "text": "بعد یک سال دیگه باید شیر رو کم کنید تا گوش نگه شده"
    },
    {
      "id": 17,
      "start": 15338.0,
      "end": 15341.0,
      "formatted_start": "04:15:38.000",
      "formatted_end": "04:15:41.000",
      "text": "وقتش هشت و سی ست دیگه بیخورن"
    },
    {
      "id": 18,
      "start": 15341.0,
      "end": 15343.0,
      "formatted_start": "04:15:41.000",
      "formatted_end": "04:15:43.000",
      "text": "وقت تولیدش؟"
    },
    {
      "id": 19,
      "start": 15343.0,
      "end": 15346.0,
      "formatted_start": "04:15:43.000",
      "formatted_end": "04:15:46.000",
      "text": "سه کلو ست"
    },
    {
      "id": 20,
      "start": 15346.0,
      "end": 15350.0,
      "formatted_start": "04:15:46.000",
      "formatted_end": "04:15:50.000",
      "text": "سه کلو ست خب کم داره، الان هشت و سی سته ده"
    },
    {
      "id": 21,
      "start": 15350.0,
      "end": 15356.0,
      "formatted_start": "04:15:50.000",
      "formatted_end": "04:15:56.000",
      "text": "یک سال را سنگارده بود. باید دهانه این باشه. یعنی یک دو کیلوی عرق است."
    },
    {
      "id": 22,
      "start": 15356.0,
      "end": 15359.0,
      "formatted_start": "04:15:56.000",
      "formatted_end": "04:15:59.000",
      "text": "حالا اون بیشترهایش رو آهنگ و ملتی رو داری؟"
    },
    {
      "id": 23,
      "start": 15359.0,
      "end": 15362.0,
      "formatted_start": "04:15:59.000",
      "formatted_end": "04:16:02.000",
      "text": "آره. من بهش میگم. من بیشترهایی که بزرگ میدهم."
    },
    {
      "id": 24,
      "start": 15362.0,
      "end": 15366.0,
      "formatted_start": "04:16:02.000",
      "formatted_end": "04:16:06.000",
      "text": "آهنگ و ملتی و یک قطره برای اشتغال. من میلیمستم."
    },
    {
      "id": 25,
      "start": 15366.0,
      "end": 15368.0,
      "formatted_start": "04:16:06.000",
      "formatted_end": "04:16:08.000",
      "text": "منی توی این سنگ زیاد داروی اشتغال نمیتونیم."
    },
    {
      "id": 26,
      "start": 15368.0,
      "end": 15371.0,
      "formatted_start": "04:16:08.000",
      "formatted_end": "04:16:11.000",
      "text": "بدین. اما جز این قطره..."
    },
    {
      "id": 27,
      "start": 15371.0,
      "end": 15372.0,
      "formatted_start": "04:16:11.000",
      "formatted_end": "04:16:12.000",
      "text": "مابن خواره."
    },
    {
      "id": 28,
      "start": 15372.0,
      "end": 15375.0,
      "formatted_start": "04:16:12.000",
      "formatted_end": "04:16:15.000",
      "text": "به سال شنیچی، روزی شنبار..."
    },
    {
      "id": 29,
      "start": 15380.0,
      "end": 15410.0,
      "formatted_start": "04:16:20.000",
      "formatted_end": "04:16:50.000",
      "text": "اینجا بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشت"
    },
    {
      "id": 30,
      "start": 15410.0,
      "end": 15412.0,
      "formatted_start": "04:16:50.000",
      "formatted_end": "04:16:52.000",
      "text": "مرد در اینجا باید بردارید."
    },
    {
      "id": 31,
      "start": 15412.0,
      "end": 15414.0,
      "formatted_start": "04:16:52.000",
      "formatted_end": "04:16:54.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 32,
      "start": 15414.0,
      "end": 15416.0,
      "formatted_start": "04:16:54.000",
      "formatted_end": "04:16:56.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 33,
      "start": 15416.0,
      "end": 15418.0,
      "formatted_start": "04:16:56.000",
      "formatted_end": "04:16:58.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 34,
      "start": 15418.0,
      "end": 15420.0,
      "formatted_start": "04:16:58.000",
      "formatted_end": "04:17:00.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 35,
      "start": 15420.0,
      "end": 15422.0,
      "formatted_start": "04:17:00.000",
      "formatted_end": "04:17:02.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 36,
      "start": 15422.0,
      "end": 15424.0,
      "formatted_start": "04:17:02.000",
      "formatted_end": "04:17:04.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 37,
      "start": 15424.0,
      "end": 15426.0,
      "formatted_start": "04:17:04.000",
      "formatted_end": "04:17:06.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 38,
      "start": 15426.0,
      "end": 15428.0,
      "formatted_start": "04:17:06.000",
      "formatted_end": "04:17:08.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 39,
      "start": 15428.0,
      "end": 15430.0,
      "formatted_start": "04:17:08.000",
      "formatted_end": "04:17:10.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 40,
      "start": 15430.0,
      "end": 15432.0,
      "formatted_start": "04:17:10.000",
      "formatted_end": "04:17:12.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 41,
      "start": 15432.0,
      "end": 15434.0,
      "formatted_start": "04:17:12.000",
      "formatted_end": "04:17:14.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 42,
      "start": 15434.0,
      "end": 15443.0,
      "formatted_start": "04:17:14.000",
      "formatted_end": "04:17:23.000",
      "text": "اوه، میتر قد دردارم، ماما میخوایی بریم هر در زندگی بگیریم؟"
    },
    {
      "id": 43,
      "start": 15443.0,
      "end": 15452.0,
      "formatted_start": "04:17:23.000",
      "formatted_end": "04:17:32.000",
      "text": "آره؟ آره ماما؟ توستن بیریم؟ میخوایی ازشو نگاه برونیم؟"
    },
    {
      "id": 44,
      "start": 15452.0,
      "end": 15455.0,
      "formatted_start": "04:17:32.000",
      "formatted_end": "04:17:35.000",
      "text": "یا چیزا نه اون چی بره؟ اسمون چی بره؟"
    },
    {
      "id": 45,
      "start": 15455.0,
      "end": 15456.0,
      "formatted_start": "04:17:35.000",
      "formatted_end": "04:17:36.000",
      "text": "شبابش نرمشون برشون"
    },
    {
      "id": 46,
      "start": 15456.0,
      "end": 15459.0,
      "formatted_start": "04:17:36.000",
      "formatted_end": "04:17:39.000",
      "text": "بله بله، نخبر که چپ دستش باید، ماماش"
    },
    {
      "id": 47,
      "start": 15459.0,
      "end": 15460.0,
      "formatted_start": "04:17:39.000",
      "formatted_end": "04:17:40.000",
      "text": "همون که بیر بر سر میشون"
    },
    {
      "id": 48,
      "start": 15460.0,
      "end": 15462.0,
      "formatted_start": "04:17:40.000",
      "formatted_end": "04:17:42.000",
      "text": "ماما این چی؟"
    },
    {
      "id": 49,
      "start": 15462.0,
      "end": 15464.0,
      "formatted_start": "04:17:42.000",
      "formatted_end": "04:17:44.000",
      "text": "چی اون دورو خواهیدن؟"
    },
    {
      "id": 50,
      "start": 15464.0,
      "end": 15469.0,
      "formatted_start": "04:17:44.000",
      "formatted_end": "04:17:49.000",
      "text": "از توی درموید. من فکر میکنم باید درموید آشق ساله تجربه براش بکنم."
    },
    {
      "id": 51,
      "start": 15469.0,
      "end": 15471.0,
      "formatted_start": "04:17:49.000",
      "formatted_end": "04:17:51.000",
      "text": "چی روی کنم؟ مابا؟"
    },
    {
      "id": 52,
      "start": 15471.0,
      "end": 15472.0,
      "formatted_start": "04:17:51.000",
      "formatted_end": "04:17:52.000",
      "text": "چی کنی؟"
    },
    {
      "id": 53,
      "start": 15472.0,
      "end": 15473.0,
      "formatted_start": "04:17:52.000",
      "formatted_end": "04:17:53.000",
      "text": "کاری اون رو خوستی؟"
    },
    {
      "id": 54,
      "start": 15473.0,
      "end": 15476.0,
      "formatted_start": "04:17:53.000",
      "formatted_end": "04:17:56.000",
      "text": "این هشارایی که زیرا لای درک و لباس هست."
    },
    {
      "id": 55,
      "start": 15476.0,
      "end": 15479.0,
      "formatted_start": "04:17:56.000",
      "formatted_end": "04:17:59.000",
      "text": "حالا این یه پارچی یا کاری رو..."
    },
    {
      "id": 56,
      "start": 15479.0,
      "end": 15482.0,
      "formatted_start": "04:17:59.000",
      "formatted_end": "04:18:02.000",
      "text": "این لباس هست؟ نه، خوشحال خوبه یکی نفتید."
    },
    {
      "id": 57,
      "start": 15482.0,
      "end": 15484.0,
      "formatted_start": "04:18:02.000",
      "formatted_end": "04:18:04.000",
      "text": "من لباس هم رو بندی کنم."
    },
    {
      "id": 58,
      "start": 15484.0,
      "end": 15485.0,
      "formatted_start": "04:18:04.000",
      "formatted_end": "04:18:05.000",
      "text": "باید کنم."
    },
    {
      "id": 59,
      "start": 15485.0,
      "end": 15487.0,
      "formatted_start": "04:18:05.000",
      "formatted_end": "04:18:07.000",
      "text": "اوه، اون پرنده ها میان زن"
    },
    {
      "id": 60,
      "start": 15487.0,
      "end": 15489.0,
      "formatted_start": "04:18:07.000",
      "formatted_end": "04:18:09.000",
      "text": "آره، پرنده ها ما کمترن داریم تو هایی"
    },
    {
      "id": 61,
      "start": 15489.0,
      "end": 15492.0,
      "formatted_start": "04:18:09.000",
      "formatted_end": "04:18:12.000",
      "text": "کمترن نه، از قبری بخشی ها"
    },
    {
      "id": 62,
      "start": 15492.0,
      "end": 15493.0,
      "formatted_start": "04:18:12.000",
      "formatted_end": "04:18:13.000",
      "text": "آهان"
    },
    {
      "id": 63,
      "start": 15493.0,
      "end": 15495.0,
      "formatted_start": "04:18:13.000",
      "formatted_end": "04:18:15.000",
      "text": "میان تو هایی تو گوگونه میدیدیم، میفتارن و میرن"
    },
    {
      "id": 64,
      "start": 15495.0,
      "end": 15499.0,
      "formatted_start": "04:18:15.000",
      "formatted_end": "04:18:19.000",
      "text": "انا برای ضایاتش، خواهشش، داروشش ها داریم"
    },
    {
      "id": 65,
      "start": 15499.0,
      "end": 15501.0,
      "formatted_start": "04:18:19.000",
      "formatted_end": "04:18:21.000",
      "text": "نه، از اون دو هم جدیده بگیرم"
    },
    {
      "id": 66,
      "start": 15501.0,
      "end": 15502.0,
      "formatted_start": "04:18:21.000",
      "formatted_end": "04:18:22.000",
      "text": "نه، از اون دو هم جدیده بگیرم"
    },
    {
      "id": 67,
      "start": 15502.0,
      "end": 15503.0,
      "formatted_start": "04:18:22.000",
      "formatted_end": "04:18:23.000",
      "text": "نه، از اون دو هم جدیده بگیرم"
    },
    {
      "id": 68,
      "start": 15503.0,
      "end": 15504.0,
      "formatted_start": "04:18:23.000",
      "formatted_end": "04:18:24.000",
      "text": "نه، از اون دو هم جدیده بگیرم"
    },
    {
      "id": 69,
      "start": 15515.0,
      "end": 15518.0,
      "formatted_start": "04:18:35.000",
      "formatted_end": "04:18:38.000",
      "text": "این هم دارم، این که کتی"
    },
    {
      "id": 70,
      "start": 15518.0,
      "end": 15519.0,
      "formatted_start": "04:18:38.000",
      "formatted_end": "04:18:39.000",
      "text": "کتی؟"
    },
    {
      "id": 71,
      "start": 15519.0,
      "end": 15521.0,
      "formatted_start": "04:18:39.000",
      "formatted_end": "04:18:41.000",
      "text": "میبویی کتی"
    },
    {
      "id": 72,
      "start": 15521.0,
      "end": 15523.0,
      "formatted_start": "04:18:41.000",
      "formatted_end": "04:18:43.000",
      "text": "هلو کتی"
    },
    {
      "id": 73,
      "start": 15523.0,
      "end": 15525.0,
      "formatted_start": "04:18:43.000",
      "formatted_end": "04:18:45.000",
      "text": "پیاده تشکیل دردونه"
    },
    {
      "id": 74,
      "start": 15525.0,
      "end": 15529.0,
      "formatted_start": "04:18:45.000",
      "formatted_end": "04:18:49.000",
      "text": "ببین این کرمه، این کرمه حقیقی یه بار"
    },
    {
      "id": 75,
      "start": 15529.0,
      "end": 15531.0,
      "formatted_start": "04:18:49.000",
      "formatted_end": "04:18:51.000",
      "text": "چون کشوری خوارش نداره، این طریقه خود"
    },
    {
      "id": 76,
      "start": 15531.0,
      "end": 15534.0,
      "formatted_start": "04:18:51.000",
      "formatted_end": "04:18:54.000",
      "text": "این درستش کتابی نیست همه از آیاتون رو ببین"
    },
    {
      "id": 77,
      "start": 15534.0,
      "end": 15537.0,
      "formatted_start": "04:18:54.000",
      "formatted_end": "04:18:57.000",
      "text": "ولی الان از این روی که من احساس میبنم که"
    },
    {
      "id": 78,
      "start": 15537.0,
      "end": 15541.0,
      "formatted_start": "04:18:57.000",
      "formatted_end": "04:19:01.000",
      "text": "این جرامی با بیمونی کجای اجرای به ما موضوع نباشه"
    },
    {
      "id": 79,
      "start": 15541.0,
      "end": 15545.0,
      "formatted_start": "04:19:01.000",
      "formatted_end": "04:19:05.000",
      "text": "یک دو هفته این درمان رو خودش انجام دارید براش"
    },
    {
      "id": 80,
      "start": 15545.0,
      "end": 15548.0,
      "formatted_start": "04:19:05.000",
      "formatted_end": "04:19:08.000",
      "text": "اولا یک باساش آنها رو باس آب داخل رو بخونید"
    },
    {
      "id": 81,
      "start": 15548.0,
      "end": 15550.0,
      "formatted_start": "04:19:08.000",
      "formatted_end": "04:19:10.000",
      "text": "توی رگن آب داخل بندازید"
    },
    {
      "id": 82,
      "start": 15550.0,
      "end": 15552.0,
      "formatted_start": "04:19:10.000",
      "formatted_end": "04:19:12.000",
      "text": "رو باسایی که خوب کنید دیگر ها رو بیاد می پوشه"
    },
    {
      "id": 83,
      "start": 15552.0,
      "end": 15554.0,
      "formatted_start": "04:19:12.000",
      "formatted_end": "04:19:14.000",
      "text": "و بعد رخی خوابش رو"
    },
    {
      "id": 84,
      "start": 15554.0,
      "end": 15556.0,
      "formatted_start": "04:19:14.000",
      "formatted_end": "04:19:16.000",
      "text": "توی رگن آب داخل بندازید"
    },
    {
      "id": 85,
      "start": 15556.0,
      "end": 15558.0,
      "formatted_start": "04:19:16.000",
      "formatted_end": "04:19:18.000",
      "text": "یک 20 دنیا رو قابل کنید و بعد بسیاری پشت کنید"
    },
    {
      "id": 86,
      "start": 15558.0,
      "end": 15560.0,
      "formatted_start": "04:19:18.000",
      "formatted_end": "04:19:20.000",
      "text": "تو آفتا باشید"
    },
    {
      "id": 87,
      "start": 15560.0,
      "end": 15562.0,
      "formatted_start": "04:19:20.000",
      "formatted_end": "04:19:22.000",
      "text": "اشکال نداره افتاق نمی گفته"
    },
    {
      "id": 88,
      "start": 15562.0,
      "end": 15564.0,
      "formatted_start": "04:19:22.000",
      "formatted_end": "04:19:24.000",
      "text": "و بعد هیچ مشکل نیست"
    },
    {
      "id": 89,
      "start": 15564.0,
      "end": 15566.0,
      "formatted_start": "04:19:24.000",
      "formatted_end": "04:19:26.000",
      "text": "از 3 روز به آفتا باشه هفته یه باره"
    },
    {
      "id": 90,
      "start": 15566.0,
      "end": 15568.0,
      "formatted_start": "04:19:26.000",
      "formatted_end": "04:19:28.000",
      "text": "این حد توشن برست"
    },
    {
      "id": 91,
      "start": 15568.0,
      "end": 15570.0,
      "formatted_start": "04:19:28.000",
      "formatted_end": "04:19:30.000",
      "text": "با توشن به هفته یه بیگه"
    },
    {
      "id": 92,
      "start": 15570.0,
      "end": 15572.0,
      "formatted_start": "04:19:30.000",
      "formatted_end": "04:19:32.000",
      "text": "از گردم به پایین بمانید"
    },
    {
      "id": 93,
      "start": 15572.0,
      "end": 15574.0,
      "formatted_start": "04:19:32.000",
      "formatted_end": "04:19:34.000",
      "text": "تو کرما صبح فرداش همون بره"
    },
    {
      "id": 94,
