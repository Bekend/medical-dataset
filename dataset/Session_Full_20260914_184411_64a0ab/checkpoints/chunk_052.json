    },
    {
      "id": 12,
      "start": 15624.0,
      "end": 15628.0,
      "formatted_start": "04:20:24.000",
      "formatted_end": "04:20:28.000",
      "text": "با لباس نو دیگه اون لباس دیگه که الان داره می کوشه رو این شهر دیگه نکوشه"
    },
    {
      "id": 13,
      "start": 15628.0,
      "end": 15631.0,
      "formatted_start": "04:20:28.000",
      "formatted_end": "04:20:31.000",
      "text": "دوباره همه ها کردن و پفته دیگه این نو بکنید"
    },
    {
      "id": 14,
      "start": 15631.0,
      "end": 15633.0,
      "formatted_start": "04:20:31.000",
      "formatted_end": "04:20:33.000",
      "text": "نوشبه دیگه نیست؟"
    },
    {
      "id": 15,
      "start": 15633.0,
      "end": 15634.0,
      "formatted_start": "04:20:33.000",
      "formatted_end": "04:20:34.000",
      "text": "بله"
    },
    {
      "id": 16,
      "start": 15634.0,
      "end": 15637.0,
      "formatted_start": "04:20:34.000",
      "formatted_end": "04:20:37.000",
      "text": "پس اون سرابید رو قطع کنید"
    },
    {
      "id": 17,
      "start": 15637.0,
      "end": 15638.0,
      "formatted_start": "04:20:37.000",
      "formatted_end": "04:20:38.000",
      "text": "بله"
    },
    {
      "id": 18,
      "start": 15638.0,
      "end": 15641.0,
      "formatted_start": "04:20:38.000",
      "formatted_end": "04:20:41.000",
      "text": "من برای شیط نیست خودتایی نشترده هستم"
    },
    {
      "id": 19,
      "start": 15641.0,
      "end": 15644.0,
      "formatted_start": "04:20:41.000",
      "formatted_end": "04:20:44.000",
      "text": "میخوایین اون نو دیگه هم بکنم؟"
    },
    {
      "id": 20,
      "start": 15644.0,
      "end": 15645.0,
      "formatted_start": "04:20:44.000",
      "formatted_end": "04:20:45.000",
      "text": "نیست"
    },
    {
      "id": 21,
      "start": 15645.0,
      "end": 15648.0,
      "formatted_start": "04:20:45.000",
      "formatted_end": "04:20:48.000",
      "text": "میبونن چون نیست؟"
    },
    {
      "id": 22,
      "start": 15650.0,
      "end": 15652.0,
      "formatted_start": "04:20:50.000",
      "formatted_end": "04:20:52.000",
      "text": "های درسته؟"
    },
    {
      "id": 23,
      "start": 15652.0,
      "end": 15654.0,
      "formatted_start": "04:20:52.000",
      "formatted_end": "04:20:54.000",
      "text": "درسته"
    },
    {
      "id": 24,
      "start": 15668.0,
      "end": 15670.0,
      "formatted_start": "04:21:08.000",
      "formatted_end": "04:21:10.000",
      "text": "من کار کنم"
    },
    {
      "id": 25,
      "start": 15670.0,
      "end": 15672.0,
      "formatted_start": "04:21:10.000",
      "formatted_end": "04:21:12.000",
      "text": "اینجا"
    },
    {
      "id": 26,
      "start": 15676.0,
      "end": 15678.0,
      "formatted_start": "04:21:16.000",
      "formatted_end": "04:21:18.000",
      "text": "خورجا کنم"
    },
    {
      "id": 27,
      "start": 15678.0,
      "end": 15708.0,
      "formatted_start": "04:21:18.000",
      "formatted_end": "04:21:48.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا ب"
    },
    {
      "id": 28,
      "start": 15708.0,
      "end": 15710.0,
      "formatted_start": "04:21:48.000",
      "formatted_end": "04:21:50.000",
      "text": "من یک کرب دستاتم باید دارم"
    },
    {
      "id": 29,
      "start": 15710.0,
      "end": 15711.0,
      "formatted_start": "04:21:50.000",
      "formatted_end": "04:21:51.000",
      "text": "غیر اینکار"
    },
    {
      "id": 30,
      "start": 15711.0,
      "end": 15712.0,
      "formatted_start": "04:21:51.000",
      "formatted_end": "04:21:52.000",
      "text": "همه ما شخص میبینید؟"
    },
    {
      "id": 31,
      "start": 15712.0,
      "end": 15714.0,
      "formatted_start": "04:21:52.000",
      "formatted_end": "04:21:54.000",
      "text": "آره ولی خبورتی"
    },
    {
      "id": 32,
      "start": 15714.0,
      "end": 15715.0,
      "formatted_start": "04:21:54.000",
      "formatted_end": "04:21:55.000",
      "text": "بشین"
    },
    {
      "id": 33,
      "start": 15715.0,
      "end": 15717.0,
      "formatted_start": "04:21:55.000",
      "formatted_end": "04:21:57.000",
      "text": "بیاید اینجا بچه میارم"
    },
    {
      "id": 34,
      "start": 15717.0,
      "end": 15718.0,
      "formatted_start": "04:21:57.000",
      "formatted_end": "04:21:58.000",
      "text": "بیاید بچه بیارم"
    },
    {
      "id": 35,
      "start": 15718.0,
      "end": 15720.0,
      "formatted_start": "04:21:58.000",
      "formatted_end": "04:22:00.000",
      "text": "خب خواهش بشین"
    },
    {
      "id": 36,
      "start": 15720.0,
      "end": 15721.0,
      "formatted_start": "04:22:00.000",
      "formatted_end": "04:22:01.000",
      "text": "باید بشین"
    },
    {
      "id": 37,
      "start": 15721.0,
      "end": 15722.0,
      "formatted_start": "04:22:01.000",
      "formatted_end": "04:22:02.000",
      "text": "بشین"
    },
    {
      "id": 38,
      "start": 15722.0,
      "end": 15724.0,
      "formatted_start": "04:22:02.000",
      "formatted_end": "04:22:04.000",
      "text": "لازه شدید داره باید"
    },
    {
      "id": 39,
      "start": 15724.0,
      "end": 15725.0,
      "formatted_start": "04:22:04.000",
      "formatted_end": "04:22:05.000",
      "text": "خب خواهش بیاریم"
    },
    {
      "id": 40,
      "start": 15725.0,
      "end": 15729.0,
      "formatted_start": "04:22:05.000",
      "formatted_end": "04:22:09.000",
      "text": "بشین مولی اینجا بیا بازم"
    },
    {
      "id": 41,
      "start": 15729.0,
      "end": 15731.0,
      "formatted_start": "04:22:09.000",
      "formatted_end": "04:22:11.000",
      "text": "مولی"
    },
    {
      "id": 42,
      "start": 15731.0,
      "end": 15733.0,
      "formatted_start": "04:22:11.000",
      "formatted_end": "04:22:13.000",
      "text": "مولی"
    },
    {
      "id": 43,
      "start": 15733.0,
      "end": 15735.0,
      "formatted_start": "04:22:13.000",
      "formatted_end": "04:22:15.000",
      "text": "مولی"
    },
    {
      "id": 44,
      "start": 15735.0,
      "end": 15737.0,
      "formatted_start": "04:22:15.000",
      "formatted_end": "04:22:17.000",
      "text": "اینجا براش خودتونیه"
    },
    {
      "id": 45,
      "start": 15737.0,
      "end": 15739.0,
      "formatted_start": "04:22:17.000",
      "formatted_end": "04:22:19.000",
      "text": "بشین میگو کنه گلوز میگو کنه باش"
    },
    {
      "id": 46,
      "start": 15739.0,
      "end": 15741.0,
      "formatted_start": "04:22:19.000",
      "formatted_end": "04:22:21.000",
      "text": "گلوز میگو کنه باش"
    },
    {
      "id": 47,
      "start": 15741.0,
      "end": 15743.0,
      "formatted_start": "04:22:21.000",
      "formatted_end": "04:22:23.000",
      "text": "آه آه"
    },
    {
      "id": 48,
      "start": 15743.0,
      "end": 15745.0,
      "formatted_start": "04:22:23.000",
      "formatted_end": "04:22:25.000",
      "text": "خیلی شدید"
    },
    {
      "id": 49,
      "start": 15745.0,
      "end": 15747.0,
      "formatted_start": "04:22:25.000",
      "formatted_end": "04:22:27.000",
      "text": "خیلی شدید"
    },
    {
      "id": 50,
      "start": 15747.0,
      "end": 15751.0,
      "formatted_start": "04:22:27.000",
      "formatted_end": "04:22:31.000",
      "text": "واه مولی ماشه اینجا اینجا وقتی پنج سال اینجا اینجا اینجا"
    },
    {
      "id": 51,
      "start": 15751.0,
      "end": 15754.0,
      "formatted_start": "04:22:31.000",
      "formatted_end": "04:22:34.000",
      "text": "این همون میگه، محمد نکرد بودم تا پنج سال همم"
    },
    {
      "id": 52,
      "start": 15754.0,
      "end": 15756.0,
      "formatted_start": "04:22:34.000",
      "formatted_end": "04:22:36.000",
      "text": "به نظر من خیلی عذیبت هست"
    },
    {
      "id": 53,
      "start": 15756.0,
      "end": 15760.0,
      "formatted_start": "04:22:36.000",
      "formatted_end": "04:22:40.000",
      "text": "اصلا یکی از دلتهای بیاران، بیاراروری، فرخوشگری شده"
    },
    {
      "id": 54,
      "start": 15760.0,
      "end": 15762.0,
      "formatted_start": "04:22:40.000",
      "formatted_end": "04:22:42.000",
      "text": "شدتنتش همینه، اصلا ببین کارباد شده"
    },
    {
      "id": 55,
      "start": 15762.0,
      "end": 15764.0,
      "formatted_start": "04:22:42.000",
      "formatted_end": "04:22:44.000",
      "text": "چون خواب راحتی نداره"
    },
    {
      "id": 56,
      "start": 15764.0,
      "end": 15767.0,
      "formatted_start": "04:22:44.000",
      "formatted_end": "04:22:47.000",
      "text": "در تنویز که دسترشوکت بگمی کنه، تنطور مریض میشه"
    },
    {
      "id": 57,
      "start": 15767.0,
      "end": 15770.0,
      "formatted_start": "04:22:47.000",
      "formatted_end": "04:22:50.000",
      "text": "شنوایش هم کم کم تر تشکره رو میده"
    },
    {
      "id": 58,
      "start": 15770.0,
      "end": 15772.0,
      "formatted_start": "04:22:50.000",
      "formatted_end": "04:22:52.000",
      "text": "یا خونتهای گوش اونکرار داره"
    },
    {
      "id": 59,
      "start": 15772.0,
      "end": 15775.46,
      "formatted_start": "04:22:52.000",
      "formatted_end": "04:22:55.460",
      "text": "اکثران هم شرب بزرگ هم جام میدن عملشو"
    },
    {
      "id": 60,
      "start": 15775.46,
      "end": 15778.46,
      "formatted_start": "04:22:55.460",
      "formatted_end": "04:22:58.460",
      "text": "ایشون الان دو سالشون نیست دو سال چون؟"
    },
    {
      "id": 61,
      "start": 15778.46,
      "end": 15781.46,
      "formatted_start": "04:22:58.460",
      "formatted_end": "04:23:01.460",
      "text": "من معمولیت دو سال داشتم عمل شده"
    },
    {
      "id": 62,
      "start": 15781.46,
      "end": 15785.84,
      "formatted_start": "04:23:01.460",
      "formatted_end": "04:23:05.840",
      "text": "اولا اینکه سره یه دینی رو کلن هر شب باید تو عمل داشت بدم"
    },
    {
      "id": 63,
      "start": 15785.84,
      "end": 15790.76,
      "formatted_start": "04:23:05.840",
      "formatted_end": "04:23:10.760",
      "text": "دیگه براتون که از حضور ایران کشت رو دوستانه باید بفره شربت و تکتوپینانی"
    },
    {
      "id": 64,
      "start": 15790.76,
      "end": 15793.86,
      "formatted_start": "04:23:10.760",
      "formatted_end": "04:23:13.860",
      "text": "درمانهاش اینه دیگه شما پیش دوشه ها رو بگنین بین همی آیا"
    },
    {
      "id": 65,
      "start": 15793.86,
      "end": 15796.48,
      "formatted_start": "04:23:13.860",
      "formatted_end": "04:23:16.480",
      "text": "و بعد درمانی به شدت گذارده بود"
    },
    {
      "id": 66,
      "start": 15796.48,
      "end": 15798.36,
      "formatted_start": "04:23:16.480",
      "formatted_end": "04:23:18.360",
      "text": "درمانی این تا همه برداشتن"
    },
    {
      "id": 67,
      "start": 15798.36,
      "end": 15801.14,
      "formatted_start": "04:23:18.360",
      "formatted_end": "04:23:21.140",
      "text": "آقا بگو بسیاری درمانی بود"
    },
    {
      "id": 68,
      "start": 15801.14,
      "end": 15802.8,
      "formatted_start": "04:23:21.140",
      "formatted_end": "04:23:22.800",
      "text": "میگن و این میگه نه"
    },
    {
      "id": 69,
      "start": 15802.8,
      "end": 15803.74,
      "formatted_start": "04:23:22.800",
      "formatted_end": "04:23:23.740",
      "text": "این ها نمیشه"
    },
    {
      "id": 70,
      "start": 15803.74,
      "end": 15806.32,
      "formatted_start": "04:23:23.740",
      "formatted_end": "04:23:26.320",
      "text": "من گوشه هاگو بینیم"
    },
    {
      "id": 71,
      "start": 15806.32,
      "end": 15808.18,
      "formatted_start": "04:23:26.320",
      "formatted_end": "04:23:28.180",
      "text": "گنبت این رو هم عوضه میکنم"
    },
    {
      "id": 72,
      "start": 15808.18,
      "end": 15810.44,
      "formatted_start": "04:23:28.180",
      "formatted_end": "04:23:30.440",
      "text": "بلی که کل از توم همین محصول به دیگه"
    },
    {
      "id": 73,
      "start": 15810.44,
      "end": 15812.72,
      "formatted_start": "04:23:30.440",
      "formatted_end": "04:23:32.720",
      "text": "به تهران درمانی گوشه هاگو بود"
    },
    {
      "id": 74,
      "start": 15812.72,
      "end": 15814.32,
      "formatted_start": "04:23:32.720",
      "formatted_end": "04:23:34.320",
      "text": "ماما من نمیدونم"
    },
    {
      "id": 75,
      "start": 15814.32,
      "end": 15816.92,
      "formatted_start": "04:23:34.320",
      "formatted_end": "04:23:36.920",
      "text": "ماما من نمیدونم"
    },
    {
      "id": 76,
      "start": 15816.92,
      "end": 15819.56,
      "formatted_start": "04:23:36.920",
      "formatted_end": "04:23:39.560",
      "text": "مالی باب اسفنجی"
    },
    {
      "id": 77,
      "start": 15819.56,
      "end": 15821.26,
      "formatted_start": "04:23:39.560",
      "formatted_end": "04:23:41.260",
      "text": "باب اسفنجی"
    },
    {
      "id": 78,
      "start": 15821.26,
      "end": 15822.68,
      "formatted_start": "04:23:41.260",
      "formatted_end": "04:23:42.680",
      "text": "باب اسفنجی"
    },
    {
      "id": 79,
      "start": 15822.68,
      "end": 15823.18,
      "formatted_start": "04:23:42.680",
      "formatted_end": "04:23:43.180",
      "text": "نه"
    },
    {
      "id": 80,
