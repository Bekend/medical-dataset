    {
      "id": 82,
      "start": 5326.8,
      "end": 5328.8,
      "formatted_start": "01:28:46.800",
      "formatted_end": "01:28:48.800",
      "text": "آره"
    },
    {
      "id": 83,
      "start": 5328.8,
      "end": 5330.8,
      "formatted_start": "01:28:48.800",
      "formatted_end": "01:28:50.800",
      "text": "باید"
    },
    {
      "id": 84,
      "start": 5330.8,
      "end": 5335.8,
      "formatted_start": "01:28:50.800",
      "formatted_end": "01:28:55.800",
      "text": "اینجا تا نیرو آره بیار برزوماش رو برزم بره"
    },
    {
      "id": 85,
      "start": 5335.8,
      "end": 5338.8,
      "formatted_start": "01:28:55.800",
      "formatted_end": "01:28:58.800",
      "text": "آدمین یکی"
    },
    {
      "id": 86,
      "start": 5338.8,
      "end": 5343.8,
      "formatted_start": "01:28:58.800",
      "formatted_end": "01:29:03.800",
      "text": "آدمین چی؟"
    },
    {
      "id": 87,
      "start": 5343.8,
      "end": 5344.8,
      "formatted_start": "01:29:03.800",
      "formatted_end": "01:29:04.800",
      "text": "فیج"
    },
    {
      "id": 88,
      "start": 5344.8,
      "end": 5347.8,
      "formatted_start": "01:29:04.800",
      "formatted_end": "01:29:07.800",
      "text": "آدمین چی؟"
    },
    {
      "id": 89,
      "start": 5347.8,
      "end": 5348.8,
      "formatted_start": "01:29:07.800",
      "formatted_end": "01:29:08.800",
      "text": "فیج"
    },
    {
      "id": 90,
      "start": 5348.8,
      "end": 5351.8,
      "formatted_start": "01:29:08.800",
      "formatted_end": "01:29:11.800",
      "text": "فیج اینو جایی تیره هم کنم زیاد تو نگه اپنیم کجا بگیرم"
    },
    {
      "id": 91,
      "start": 5351.8,
      "end": 5353.8,
      "formatted_start": "01:29:11.800",
      "formatted_end": "01:29:13.800",
      "text": "نه نه نه پیجر اینست"
    },
    {
      "id": 92,
      "start": 5353.8,
      "end": 5354.8,
      "formatted_start": "01:29:13.800",
      "formatted_end": "01:29:14.800",
      "text": "پیجر اینست؟"
    },
    {
      "id": 93,
      "start": 5354.8,
      "end": 5355.8,
      "formatted_start": "01:29:14.800",
      "formatted_end": "01:29:15.800",
      "text": "پیجر نه"
    },
    {
      "id": 94,
      "start": 5359.8,
      "end": 5361.8,
      "formatted_start": "01:29:19.800",
      "formatted_end": "01:29:21.800",
      "text": "چرا باید تازه هست"
    },
    {
      "id": 95,
      "start": 5361.8,
      "end": 5363.8,
      "formatted_start": "01:29:21.800",
      "formatted_end": "01:29:23.800",
      "text": "تازه هست نمی کنی"
    },
    {
      "id": 96,
      "start": 5365.8,
      "end": 5367.8,
      "formatted_start": "01:29:25.800",
      "formatted_end": "01:29:27.800",
      "text": "ایشالا دوباره قسمتت بشه بری"
    },
    {
      "id": 97,
      "start": 5367.8,
      "end": 5369.8,
      "formatted_start": "01:29:27.800",
      "formatted_end": "01:29:29.800",
      "text": "کیپوس هم میدیم"
    },
    {
      "id": 98,
      "start": 5371.8,
      "end": 5373.8,
      "formatted_start": "01:29:31.800",
      "formatted_end": "01:29:33.800",
      "text": "ایشالا دوباره قسمتت بشه بری"
    },
    {
      "id": 99,
      "start": 5373.8,
      "end": 5375.8,
      "formatted_start": "01:29:33.800",
      "formatted_end": "01:29:35.800",
      "text": "نیلوهایی که میگیره میگه پایین"
    },
    {
      "id": 100,
      "start": 5375.8,
      "end": 5377.8,
      "formatted_start": "01:29:35.800",
      "formatted_end": "01:29:37.800",
      "text": "فقط تو میمونی دیگه همین جلو بکنه"
    },
    {
      "id": 101,
      "start": 5377.8,
      "end": 5379.8,
      "formatted_start": "01:29:37.800",
      "formatted_end": "01:29:39.800",
      "text": "بکنه هم"
    },
    {
      "id": 102,
      "start": 5379.8,
      "end": 5387.8,
      "formatted_start": "01:29:39.800",
      "formatted_end": "01:29:47.800",
      "text": "بگو چی کار داری؟ از درگیر بگو دوست بسنم ورد فایده بخونه"
    },
    {
      "id": 103,
      "start": 5387.8,
      "end": 5393.8,
      "formatted_start": "01:29:47.800",
      "formatted_end": "01:29:53.800",
      "text": "میخورم تمام میشه و میگرد ای شما ببخشین دارا من کشتم و حواستم نباشم"
    },
    {
      "id": 104,
      "start": 5393.8,
      "end": 5399.8,
      "formatted_start": "01:29:53.800",
      "formatted_end": "01:29:59.800",
      "text": "نه نه بچه همه چیزی که من کار دارم شوهردار شیفت شبا باید میدونیم و مشاهره هم باید کار دارم"
    }
  ],
  "status": "completed"
}