  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6030.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:30.000",
      "text": "بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 1,
      "start": 6030.0,
      "end": 6045.88,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:45.880",
      "text": "این پرنده داشته که توتی داشته"
    },
    {
      "id": 2,
      "start": 6045.88,
      "end": 6048.0,
      "formatted_start": "01:40:45.880",
      "formatted_end": "01:40:48.000",
      "text": "توتیه اصفه"
    },
    {
      "id": 3,
      "start": 6048.0,
      "end": 6049.98,
      "formatted_start": "01:40:48.000",
      "formatted_end": "01:40:49.980",
      "text": "لیموس بوده"
    },
    {
      "id": 4,
      "start": 6049.98,
      "end": 6050.68,
      "formatted_start": "01:40:49.980",
      "formatted_end": "01:40:50.680",
      "text": "چی بوده"
    },
    {
      "id": 5,
      "start": 6050.68,
      "end": 6053.34,
      "formatted_start": "01:40:50.680",
      "formatted_end": "01:40:53.340",
      "text": "اصفه موضع کده لیموس هم"
    },
    {
      "id": 6,
      "start": 6053.34,
      "end": 6056.58,
      "formatted_start": "01:40:53.340",
      "formatted_end": "01:40:56.580",
      "text": "این کجایی داره"
    },
    {
      "id": 7,
      "start": 6056.58,
      "end": 6058.06,
      "formatted_start": "01:40:56.580",
      "formatted_end": "01:40:58.060",
      "text": "آره و اکسش همینجور داده"
    },
    {
      "id": 8,
      "start": 6058.06,
      "end": 6058.72,
      "formatted_start": "01:40:58.060",
      "formatted_end": "01:40:58.720",
      "text": "تو موضع"
    },
    {
      "id": 9,
      "start": 6058.72,
      "end": 6062.72,
      "formatted_start": "01:40:58.720",
      "formatted_end": "01:41:02.720",
      "text": "بابا چه رو دوست داشته باشه"
    },
    {
      "id": 10,
      "start": 6062.72,
      "end": 6066.72,
      "formatted_start": "01:41:02.720",
      "formatted_end": "01:41:06.720",
      "text": "نه که بینجوری کادرهای خیلی دوست داشته اینه"
    },
    {
      "id": 11,
      "start": 6066.72,
      "end": 6070.72,
      "formatted_start": "01:41:06.720",
      "formatted_end": "01:41:10.720",
      "text": "نه که عاشقشون باشه و یعنی دیگه فرق نداره با بچه ها"
    },
    {
      "id": 12,
      "start": 6070.72,
      "end": 6074.72,
      "formatted_start": "01:41:10.720",
      "formatted_end": "01:41:14.720",
      "text": "مرغش میکرشم نمیخری؟ پنج میکرشم نمیخری؟"
    },
    {
      "id": 13,
      "start": 6074.72,
      "end": 6078.72,
      "formatted_start": "01:41:14.720",
      "formatted_end": "01:41:18.720",
      "text": "اونا بابا دوست دیگه نمیارن"
    },
    {
      "id": 14,
      "start": 6078.72,
      "end": 6082.72,
      "formatted_start": "01:41:18.720",
      "formatted_end": "01:41:22.720",
      "text": "نه بابا دوست دیگه نه نه پرنده اونقدر آبستگی نمیارن"
    },
    {
      "id": 15,
      "start": 6082.72,
      "end": 6086.72,
      "formatted_start": "01:41:22.720",
      "formatted_end": "01:41:26.720",
      "text": "پرنده توتی رو داری میگه بابا دوست دیگه"
    },
    {
      "id": 16,
      "start": 6086.72,
      "end": 6088.72,
      "formatted_start": "01:41:26.720",
      "formatted_end": "01:41:28.720",
      "text": "توتی میاره؟"
    },
    {
      "id": 17,
      "start": 6088.72,
      "end": 6090.72,
      "formatted_start": "01:41:28.720",
      "formatted_end": "01:41:30.720",
      "text": "توتی میاره"
    },
    {
      "id": 18,
      "start": 6090.72,
      "end": 6098.72,
      "formatted_start": "01:41:30.720",
      "formatted_end": "01:41:38.720",
      "text": "شاید چون هر بیانه توتی، کاسپو، مکادو، این ارسلندی ها اینو واقعا میارن"
    },
    {
      "id": 19,
      "start": 6104.72,
      "end": 6107.72,
      "formatted_start": "01:41:44.720",
      "formatted_end": "01:41:47.720",
      "text": "کم اطراف بابسته نشین خوبه دیگه؟"
    },
    {
      "id": 20,
      "start": 6107.72,
      "end": 6108.72,
      "formatted_start": "01:41:47.720",
      "formatted_end": "01:41:48.720",
      "text": "آره"
    },
    {
      "id": 21,
      "start": 6108.72,
      "end": 6110.72,
      "formatted_start": "01:41:48.720",
      "formatted_end": "01:41:50.720",
      "text": "بابسته نشین خوبه"
    },
    {
      "id": 22,
      "start": 6111.72,
      "end": 6113.72,
      "formatted_start": "01:41:51.720",
      "formatted_end": "01:41:53.720",
      "text": "بی خدا"
    },
    {
      "id": 23,
      "start": 6113.72,
      "end": 6119.72,
      "formatted_start": "01:41:53.720",
      "formatted_end": "01:41:59.720",
      "text": "خطوه اصنی هاست که به من که ازش میگیرم بازیم"
    },
    {
      "id": 24,
      "start": 6119.72,
      "end": 6127.72,
      "formatted_start": "01:41:59.720",
      "formatted_end": "01:42:07.720",
      "text": "نامه باید را رایش دوره چی مانه اون را بزرگ"
    },
    {
      "id": 25,
      "start": 6127.72,
      "end": 6130.72,
      "formatted_start": "01:42:07.720",
      "formatted_end": "01:42:10.720",
      "text": "این ها را یه چیز دارد؟ آره خوبه"
    },
    {
      "id": 26,
      "start": 6130.72,
      "end": 6135.72,
      "formatted_start": "01:42:10.720",
      "formatted_end": "01:42:15.720",
      "text": "چیزی دارد؟ دوت کنی؟ آتیشش میده با همون گل بسنده"
    },
    {
      "id": 27,
      "start": 6135.72,
      "end": 6138.72,
      "formatted_start": "01:42:15.720",
      "formatted_end": "01:42:18.720",
      "text": "آتیش را که این را بنده سیشتار دوت میده"
    },
    {
      "id": 28,
      "start": 6138.72,
      "end": 6141.72,
      "formatted_start": "01:42:18.720",
      "formatted_end": "01:42:21.720",
      "text": "اشکال کنید، خواهد جور کنه چیز کنید"
    },
    {
      "id": 29,
      "start": 6141.72,
      "end": 6142.72,
      "formatted_start": "01:42:21.720",
      "formatted_end": "01:42:22.720",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 6142.72,
      "end": 6145.72,
      "formatted_start": "01:42:22.720",
      "formatted_end": "01:42:25.720",
      "text": "هر چیز من برگاه این چیز می کنم، آره"
    },
    {
      "id": 31,
      "start": 6145.72,
      "end": 6147.72,
      "formatted_start": "01:42:25.720",
      "formatted_end": "01:42:27.720",
      "text": "من خیلی خوبم"
    },
    {
      "id": 32,
      "start": 6147.72,
      "end": 6150.72,
      "formatted_start": "01:42:27.720",
      "formatted_end": "01:42:30.720",
      "text": "ولی ممکنه بعضی از بوی روزمالی خوبی فهم نگه"
    },
    {
      "id": 33,
      "start": 6150.72,
      "end": 6152.72,
      "formatted_start": "01:42:30.720",
      "formatted_end": "01:42:32.720",
      "text": "یه بوی تندی داره"
    },
    {
      "id": 34,
      "start": 6152.72,
      "end": 6155.72,
      "formatted_start": "01:42:32.720",
      "formatted_end": "01:42:35.720",
      "text": "اسمها چی ها؟ اسمها چی ها؟"
    },
    {
      "id": 35,
      "start": 6156.72,
      "end": 6158.72,
      "formatted_start": "01:42:36.720",
      "formatted_end": "01:42:38.720",
      "text": "بخونم ده دلیل انرژی من"
    },
    {
      "id": 36,
      "start": 6158.72,
      "end": 6160.72,
      "formatted_start": "01:42:38.720",
      "formatted_end": "01:42:40.720",
      "text": "باید یه بخونم"
    },
    {
      "id": 37,
      "start": 6160.72,
      "end": 6162.72,
      "formatted_start": "01:42:40.720",
      "formatted_end": "01:42:42.720",
      "text": "من اینجورم چرا اعتقاد ندارم به این؟"
    },
    {
      "id": 38,
      "start": 6162.72,
      "end": 6164.72,
      "formatted_start": "01:42:42.720",
      "formatted_end": "01:42:44.720",
      "text": "این رو به چیه؟ تبا باید"
    },
    {
      "id": 39,
      "start": 6164.72,
      "end": 6165.72,
      "formatted_start": "01:42:44.720",
      "formatted_end": "01:42:45.720",
      "text": "هیچ راق نگرفتم"
    },
    {
      "id": 40,
      "start": 6165.72,
      "end": 6166.72,
      "formatted_start": "01:42:45.720",
      "formatted_end": "01:42:46.720",
      "text": "چرا؟ خوبه بابا"
    },
    {
      "id": 41,
      "start": 6166.72,
      "end": 6168.72,
      "formatted_start": "01:42:46.720",
      "formatted_end": "01:42:48.720",
      "text": "شما چرا اعتبار ندارید؟"
    },
    {
      "id": 42,
      "start": 6168.72,
      "end": 6170.72,
      "formatted_start": "01:42:48.720",
      "formatted_end": "01:42:50.720",
      "text": "از طور من از این وقت ندارم"
    },
    {
      "id": 43,
      "start": 6170.72,
      "end": 6180.72,
      "formatted_start": "01:42:50.720",
      "formatted_end": "01:43:00.720",
      "text": "موسیقی"
    },
    {
      "id": 44,
      "start": 6200.72,
      "end": 6204.72,
      "formatted_start": "01:43:20.720",
      "formatted_end": "01:43:24.720",
      "text": "همون میشه. اما هفته دو میدون تا رو بخواهم بگن تقمیل واکنشم"
    },
    {
      "id": 45,
      "start": 6204.72,
      "end": 6208.72,
      "formatted_start": "01:43:24.720",
      "formatted_end": "01:43:28.720",
      "text": "خب سه همون بوده. پس اون گفته خوبوخ نمیدن"
    },
    {
      "id": 46,
      "start": 6210.72,
      "end": 6214.72,
      "formatted_start": "01:43:30.720",
      "formatted_end": "01:43:34.720",
      "text": "خب خوبوخ نمیدون. این مدتی بسیار بالا"
    },
    {
      "id": 47,
      "start": 6218.72,
      "end": 6222.72,
      "formatted_start": "01:43:38.720",
      "formatted_end": "01:43:42.720",
      "text": "بسه همون شش میدونم"
    },
    {
      "id": 48,
      "start": 6230.72,
      "end": 6260.72,
      "formatted_start": "01:43:50.720",
      "formatted_end": "01:44:20.720",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 49,
      "start": 6260.72,
      "end": 6266.72,
      "formatted_start": "01:44:20.720",
      "formatted_end": "01:44:26.720",
      "text": "اینکه سابقی هم وقت را کسی باید بگیرد"
    },
    {
      "id": 50,
      "start": 6266.72,
      "end": 6270.72,
      "formatted_start": "01:44:26.720",
      "formatted_end": "01:44:30.720",
      "text": "کار دیگه دیگه دیگه باید بگیرد"
    },
    {
      "id": 51,
      "start": 6270.72,
      "end": 6274.72,
      "formatted_start": "01:44:30.720",
      "formatted_end": "01:44:34.720",
      "text": "ببین دو تا، یک دو گرمزر برای مریضا بذاشتن"
    },
    {
      "id": 52,
      "start": 6274.72,
      "end": 6278.72,
      "formatted_start": "01:44:34.720",
      "formatted_end": "01:44:38.720",
      "text": "اون رنگ دیگر برای خودمون بذاشتن"
    },
    {
      "id": 53,
      "start": 6278.72,
      "end": 6282.72,
      "formatted_start": "01:44:38.720",
      "formatted_end": "01:44:42.720",
      "text": "هر دو تا شما باید بذاشتن"
    },
    {
      "id": 54,
      "start": 6290.72,
      "end": 6299.72,
      "formatted_start": "01:44:50.720",
      "formatted_end": "01:44:59.720",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}