    },
    {
      "id": 10,
      "start": 9768.0,
      "end": 9772.0,
      "formatted_start": "02:42:48.000",
      "formatted_end": "02:42:52.000",
      "text": "پس من بودم، منشون از موزه میرم، سنت آل بادشهر"
    },
    {
      "id": 11,
      "start": 9772.0,
      "end": 9776.0,
      "formatted_start": "02:42:52.000",
      "formatted_end": "02:42:56.000",
      "text": "نخواهی هیچ کار، من بچه ها بردم، نخواهی هیچ کار"
    },
    {
      "id": 12,
      "start": 9780.0,
      "end": 9783.0,
      "formatted_start": "02:43:00.000",
      "formatted_end": "02:43:03.000",
      "text": "حالا برام بچه بیماده نمیخواد بدید."
    },
    {
      "id": 13,
      "start": 9783.0,
      "end": 9785.0,
      "formatted_start": "02:43:03.000",
      "formatted_end": "02:43:05.000",
      "text": "حتی در این وقت نداره."
    },
    {
      "id": 14,
      "start": 9785.0,
      "end": 9787.0,
      "formatted_start": "02:43:05.000",
      "formatted_end": "02:43:07.000",
      "text": "اما برای من از اینش گرده."
    },
    {
      "id": 15,
      "start": 9787.0,
      "end": 9793.0,
      "formatted_start": "02:43:07.000",
      "formatted_end": "02:43:13.000",
      "text": "برای اوشتا سکونه و برای اوشتا چشم و اغسطا اشتباه."
    },
    {
      "id": 16,
      "start": 9793.0,
      "end": 9795.0,
      "formatted_start": "02:43:13.000",
      "formatted_end": "02:43:15.000",
      "text": "منم مرد بودم."
    },
    {
      "id": 17,
      "start": 9795.0,
      "end": 9796.0,
      "formatted_start": "02:43:15.000",
      "formatted_end": "02:43:16.000",
      "text": "بیمه داره؟"
    },
    {
      "id": 18,
      "start": 9796.0,
      "end": 9797.0,
      "formatted_start": "02:43:16.000",
      "formatted_end": "02:43:17.000",
      "text": "بیمه نه."
    },
    {
      "id": 19,
      "start": 9797.0,
      "end": 9801.0,
      "formatted_start": "02:43:17.000",
      "formatted_end": "02:43:21.000",
      "text": "من چون خیلی برام تخلصتم که بیماده میام، بچه بسیار نداره."
    },
    {
      "id": 20,
      "start": 9801.0,
      "end": 9808.0,
      "formatted_start": "02:43:21.000",
      "formatted_end": "02:43:28.000",
      "text": "حالا اینی که من میدهم و شما که هر چه حد از این کلیسانیتی رو برام شده،"
    },
    {
      "id": 21,
      "start": 9808.0,
      "end": 9812.0,
      "formatted_start": "02:43:28.000",
      "formatted_end": "02:43:32.000",
      "text": "اما اما امیران بگیرد که بچه ها تا دو ساله دیگه آنها را بگیرد"
    },
    {
      "id": 22,
      "start": 9812.0,
      "end": 9814.0,
      "formatted_start": "02:43:32.000",
      "formatted_end": "02:43:34.000",
      "text": "و از این حال بگیرد که بچه ها تا دو ساله دیگه آنها را بگیرد"
    },
    {
      "id": 23,
      "start": 9814.0,
      "end": 9816.0,
      "formatted_start": "02:43:34.000",
      "formatted_end": "02:43:36.000",
      "text": "و از این حال بگیرد که بچه ها تا دو ساله دیگه آنها را بگیرد"
    },
    {
      "id": 24,
      "start": 9816.0,
      "end": 9818.0,
      "formatted_start": "02:43:36.000",
      "formatted_end": "02:43:38.000",
      "text": "و از این حال بگیرد که بچه ها تا دو ساله دیگه آنها را بگیرد"
    },
    {
      "id": 25,
      "start": 9818.0,
      "end": 9820.0,
      "formatted_start": "02:43:38.000",
      "formatted_end": "02:43:40.000",
      "text": "و از این حال بگیرد که بچه ها تا دو ساله دیگه آنها را بگیرد"
    },
    {
      "id": 26,
      "start": 9820.0,
      "end": 9826.0,
      "formatted_start": "02:43:40.000",
      "formatted_end": "02:43:46.000",
      "text": "اینجا برای اجتماعشون همه چند فرق هستند."
    },
    {
      "id": 27,
      "start": 9826.0,
      "end": 9828.0,
      "formatted_start": "02:43:46.000",
      "formatted_end": "02:43:48.000",
      "text": "اینجا چی هست؟"
    },
    {
      "id": 28,
      "start": 9828.0,
      "end": 9830.0,
      "formatted_start": "02:43:48.000",
      "formatted_end": "02:43:50.000",
      "text": "اینجا چی هست؟"
    },
    {
      "id": 29,
      "start": 9830.0,
      "end": 9834.0,
      "formatted_start": "02:43:50.000",
      "formatted_end": "02:43:54.000",
      "text": "اطلاعی ها چیز آرزه بود و در اینجا شما شما بیشتر شدید."
    },
    {
      "id": 30,
      "start": 9834.0,
      "end": 9836.0,
      "formatted_start": "02:43:54.000",
      "formatted_end": "02:43:56.000",
      "text": "شما بیشتر شدید."
    },
    {
      "id": 31,
      "start": 9836.0,
      "end": 9840.0,
      "formatted_start": "02:43:56.000",
      "formatted_end": "02:44:00.000",
      "text": "به دست آرزه بده اینکه در اینجا بیشتر شدید."
    },
    {
      "id": 32,
      "start": 9840.0,
      "end": 9842.0,
      "formatted_start": "02:44:00.000",
      "formatted_end": "02:44:02.000",
      "text": "در اینجا بیشتر شدید."
    },
    {
      "id": 33,
      "start": 9842.0,
      "end": 9844.0,
      "formatted_start": "02:44:02.000",
      "formatted_end": "02:44:04.000",
      "text": "در اینجا بیشتر شدید."
    },
    {
      "id": 34,
      "start": 9844.0,
      "end": 9846.0,
      "formatted_start": "02:44:04.000",
      "formatted_end": "02:44:06.000",
      "text": "در اینجا بیشتر شدید."
    },
    {
      "id": 35,
      "start": 9846.0,
      "end": 9851.24,
      "formatted_start": "02:44:06.000",
      "formatted_end": "02:44:11.240",
      "text": "چون خیلی بهتر و بهتر شکرمیه و خیلی تو افتیس داره"
    },
    {
      "id": 36,
      "start": 9851.24,
      "end": 9852.24,
      "formatted_start": "02:44:11.240",
      "formatted_end": "02:44:12.240",
      "text": "برای اشتماعش"
    },
    {
      "id": 37,
      "start": 9852.24,
      "end": 9857.24,
      "formatted_start": "02:44:12.240",
      "formatted_end": "02:44:17.240",
      "text": "برای الان افتاق نمی کنه، باید خیلی بس اعتمادش بگیره باید"
    },
    {
      "id": 38,
      "start": 9857.24,
      "end": 9862.24,
      "formatted_start": "02:44:17.240",
      "formatted_end": "02:44:22.240",
      "text": "برای اشتماعش نوشتم من و برای آقای اصطنابی نوشتم"
    },
    {
      "id": 39,
      "start": 9862.24,
      "end": 9864.24,
      "formatted_start": "02:44:22.240",
      "formatted_end": "02:44:24.240",
      "text": "تو که روزه اشتماعات روشت بگیره؟"
    },
    {
      "id": 40,
      "start": 9864.24,
      "end": 9866.24,
      "formatted_start": "02:44:24.240",
      "formatted_end": "02:44:26.240",
      "text": "تو در آخر آخر شده"
    },
    {
      "id": 41,
      "start": 9866.24,
      "end": 9869.24,
      "formatted_start": "02:44:26.240",
      "formatted_end": "02:44:29.240",
      "text": "در آخر شده، در آخر شده، تا از اینجوریتش باید اشتماعاتش بگیرم"
    },
    {
      "id": 42,
      "start": 9869.24,
      "end": 9871.24,
      "formatted_start": "02:44:29.240",
      "formatted_end": "02:44:31.240",
      "text": "از اینجوری باید بردارید."
    },
    {
      "id": 43,
      "start": 9871.24,
      "end": 9875.24,
      "formatted_start": "02:44:31.240",
      "formatted_end": "02:44:35.240",
      "text": "اما اینکه این کدران شبست که مورد اسمال است، همین اسمال است."
    },
    {
      "id": 44,
      "start": 9875.24,
      "end": 9877.24,
      "formatted_start": "02:44:35.240",
      "formatted_end": "02:44:37.240",
      "text": "اما آرزو که نگه دارد، باید بردارید."
    },
    {
      "id": 45,
      "start": 9877.24,
      "end": 9879.24,
      "formatted_start": "02:44:37.240",
      "formatted_end": "02:44:39.240",
      "text": "از اینجوری باید بردارید."
    },
    {
      "id": 46,
      "start": 9879.24,
      "end": 9881.24,
      "formatted_start": "02:44:39.240",
      "formatted_end": "02:44:41.240",
      "text": "اما اینکه اینکه همین اسمال است، همین اسمال است."
    },
    {
      "id": 47,
      "start": 9881.24,
      "end": 9883.24,
      "formatted_start": "02:44:41.240",
      "formatted_end": "02:44:43.240",
      "text": "اما اینکه همین اسمال است، همین اسمال است."
    },
    {
      "id": 48,
      "start": 9883.24,
      "end": 9885.24,
      "formatted_start": "02:44:43.240",
      "formatted_end": "02:44:45.240",
      "text": "اما اینکه همین اسمال است، همین اسمال است."
    },
    {
      "id": 49,
      "start": 9885.24,
      "end": 9887.24,
      "formatted_start": "02:44:45.240",
      "formatted_end": "02:44:47.240",
      "text": "اما اینکه همین اسمال است، همین اسمال است."
    },
    {
