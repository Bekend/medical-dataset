      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 15030.0,
      "end": 15034.0,
      "formatted_start": "04:10:30.000",
      "formatted_end": "04:10:34.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 15060.0,
      "end": 15090.0,
      "formatted_start": "04:11:00.000",
      "formatted_end": "04:11:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 3,
      "start": 15090.0,
      "end": 15092.0,
      "formatted_start": "04:11:30.000",
      "formatted_end": "04:11:32.000",
      "text": "از اینجا باید بگیرم که اینجا که چی هست"
    },
    {
      "id": 4,
      "start": 15092.0,
      "end": 15094.0,
      "formatted_start": "04:11:32.000",
      "formatted_end": "04:11:34.000",
      "text": "ماما"
    },
    {
      "id": 5,
      "start": 15098.0,
      "end": 15100.0,
      "formatted_start": "04:11:38.000",
      "formatted_end": "04:11:40.000",
      "text": "ماما"
    },
    {
      "id": 6,
      "start": 15100.0,
      "end": 15102.0,
      "formatted_start": "04:11:40.000",
      "formatted_end": "04:11:42.000",
      "text": "داره دوستی می کنه"
    },
    {
      "id": 7,
      "start": 15102.0,
      "end": 15104.0,
      "formatted_start": "04:11:42.000",
      "formatted_end": "04:11:44.000",
      "text": "داره خوبی رو می کنه"
    },
    {
      "id": 8,
      "start": 15104.0,
      "end": 15106.0,
      "formatted_start": "04:11:44.000",
      "formatted_end": "04:11:46.000",
      "text": "آرچی نلیزه"
    },
    {
      "id": 9,
      "start": 15106.0,
      "end": 15108.0,
      "formatted_start": "04:11:46.000",
      "formatted_end": "04:11:48.000",
      "text": "صبح می کنه بشه"
    },
    {
      "id": 10,
      "start": 15108.0,
      "end": 15110.0,
      "formatted_start": "04:11:48.000",
      "formatted_end": "04:11:50.000",
      "text": "خواهش داره"
    },
    {
      "id": 11,
      "start": 15110.0,
      "end": 15112.0,
      "formatted_start": "04:11:50.000",
      "formatted_end": "04:11:52.000",
      "text": "خواهش؟"
    },
    {
      "id": 12,
      "start": 15112.0,
      "end": 15114.0,
      "formatted_start": "04:11:52.000",
      "formatted_end": "04:11:54.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 15114.0,
      "end": 15116.0,
      "formatted_start": "04:11:54.000",
      "formatted_end": "04:11:56.000",
      "text": "خواهش"
    },
    {
      "id": 14,
      "start": 15116.0,
      "end": 15118.0,
      "formatted_start": "04:11:56.000",
      "formatted_end": "04:11:58.000",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 15118.0,
      "end": 15121.0,
      "formatted_start": "04:11:58.000",
      "formatted_end": "04:12:01.000",
      "text": "اینجاش دلشگید میشه طوری که میخواه اونو رو برخورد"
    },
    {
      "id": 16,
      "start": 15121.0,
      "end": 15124.0,
      "formatted_start": "04:12:01.000",
      "formatted_end": "04:12:04.000",
      "text": "اینا حالت ریتوسی داره دیگه درست داره"
    },
    {
      "id": 17,
      "start": 15124.0,
      "end": 15126.0,
      "formatted_start": "04:12:04.000",
      "formatted_end": "04:12:06.000",
      "text": "دیگه اون چه جوش نمیزنه"
    },
    {
      "id": 18,
      "start": 15126.0,
      "end": 15128.0,
      "formatted_start": "04:12:06.000",
      "formatted_end": "04:12:08.000",
      "text": "نه این موضوع"
    },
    {
      "id": 19,
      "start": 15128.0,
      "end": 15130.0,
      "formatted_start": "04:12:08.000",
      "formatted_end": "04:12:10.000",
      "text": "ده روزه میشه"
    },
    {
      "id": 20,
      "start": 15130.0,
      "end": 15132.0,
      "formatted_start": "04:12:10.000",
      "formatted_end": "04:12:12.000",
      "text": "دستاش خیلی زیاده"
    },
    {
      "id": 21,
      "start": 15132.0,
      "end": 15134.0,
      "formatted_start": "04:12:12.000",
      "formatted_end": "04:12:14.000",
      "text": "دستاش زیاده که از دستاشو میگید"
    },
    {
      "id": 22,
      "start": 15134.0,
      "end": 15136.0,
      "formatted_start": "04:12:14.000",
      "formatted_end": "04:12:16.000",
      "text": "بخشت نامیده"
    },
    {
      "id": 23,
      "start": 15136.0,
      "end": 15138.0,
      "formatted_start": "04:12:16.000",
      "formatted_end": "04:12:18.000",
      "text": "دو تا حالت هست"
    },
    {
      "id": 24,
      "start": 15138.0,
      "end": 15140.0,
      "formatted_start": "04:12:18.000",
      "formatted_end": "04:12:20.000",
      "text": "یکی آرانژه غذایی دو گاله"
    },
    {
      "id": 25,
      "start": 15140.0,
      "end": 15142.0,
      "formatted_start": "04:12:20.000",
      "formatted_end": "04:12:22.000",
      "text": "هیچ نداره نیست"
    },
    {
      "id": 26,
      "start": 15142.0,
      "end": 15144.0,
      "formatted_start": "04:12:22.000",
      "formatted_end": "04:12:24.000",
      "text": "یکی آرانژه غذایی یا گال"
    },
    {
      "id": 27,
      "start": 15144.0,
      "end": 15151.0,
      "formatted_start": "04:12:24.000",
      "formatted_end": "04:12:31.000",
      "text": "گال اگه باشه، بالاییت یکی دیگه تو خونه داشته باشه، خارشی، راه تشکیزش نمیده."
    },
    {
      "id": 28,
      "start": 15151.0,
      "end": 15153.0,
      "formatted_start": "04:12:31.000",
      "formatted_end": "04:12:33.000",
      "text": "اگه کسی دیگه نداشته باشه، گال نمیشه."
    },
    {
      "id": 29,
      "start": 15153.0,
      "end": 15156.0,
      "formatted_start": "04:12:33.000",
      "formatted_end": "04:12:36.000",
      "text": "اما آمین هم چون گال انتقال پیدا می کنه."
    },
    {
      "id": 30,
      "start": 15156.0,
      "end": 15164.0,
      "formatted_start": "04:12:36.000",
      "formatted_end": "04:12:44.000",
      "text": "و ایشون، پس حالا همزمان بر رفتن یا آبانبای اونجاست، یا قضای خورده که داره حضیتش می کنه."
    },
    {
      "id": 31,
      "start": 15164.0,
      "end": 15167.0,
      "formatted_start": "04:12:44.000",
      "formatted_end": "04:12:47.000",
      "text": "این هم نیست، هم نیست، قبل مشکل شده."
    },
    {
      "id": 32,
      "start": 15167.0,
      "end": 15169.0,
      "formatted_start": "04:12:47.000",
      "formatted_end": "04:12:49.000",
      "text": "قبل مشکل شده، قبل مشکل شده."
    },
    {
      "id": 33,
      "start": 15169.0,
      "end": 15171.5,
      "formatted_start": "04:12:49.000",
      "formatted_end": "04:12:51.500",
      "text": "خب بعدی تشکیل شما، اولی کار که"
    },
    {
      "id": 34,
      "start": 15171.5,
      "end": 15173.8,
      "formatted_start": "04:12:51.500",
      "formatted_end": "04:12:53.800",
      "text": "آزماشگاه رو برویه نمونه برداری می کنید"
    },
    {
      "id": 35,
      "start": 15173.8,
      "end": 15175.2,
      "formatted_start": "04:12:53.800",
      "formatted_end": "04:12:55.200",
      "text": "چون چون رویه تیسید"
    },
    {
      "id": 36,
      "start": 15175.2,
      "end": 15177.0,
      "formatted_start": "04:12:55.200",
      "formatted_end": "04:12:57.000",
      "text": "یه رویه که از درهاییه بیرون کنید"
    },
    {
      "id": 37,
      "start": 15177.0,
      "end": 15178.0,
      "formatted_start": "04:12:57.000",
      "formatted_end": "04:12:58.000",
      "text": "شو می گویی کنید"
    },
    {
      "id": 38,
      "start": 15178.0,
      "end": 15180.0,
      "formatted_start": "04:12:58.000",
      "formatted_end": "04:13:00.000",
      "text": "گال زیرش دیده، می شه یا نه"
    },
    {
      "id": 39,
      "start": 15180.0,
      "end": 15181.4,
      "formatted_start": "04:13:00.000",
      "formatted_end": "04:13:01.400",
      "text": "باید تشکیلش اینه داریم"
    },
    {
      "id": 40,
      "start": 15181.4,
      "end": 15183.4,
      "formatted_start": "04:13:01.400",
      "formatted_end": "04:13:03.400",
      "text": "اگه کسی دیده خونه خارج دار"
    },
    {
      "id": 41,
      "start": 15183.4,
      "end": 15186.0,
      "formatted_start": "04:13:03.400",
      "formatted_end": "04:13:06.000",
      "text": "ما خودتون ببینیم، همین که تیزی رو بیدید"
    },
    {
      "id": 42,
      "start": 15186.0,
      "end": 15188.0,
      "formatted_start": "04:13:06.000",
      "formatted_end": "04:13:08.000",
      "text": "آهان، فقط همین دو"
    },
    {
      "id": 43,
      "start": 15188.0,
      "end": 15188.8,
      "formatted_start": "04:13:08.000",
      "formatted_end": "04:13:08.800",
      "text": "آهان، یه هم"
    },
    {
      "id": 44,
      "start": 15188.8,
      "end": 15190.8,
      "formatted_start": "04:13:08.800",
      "formatted_end": "04:13:10.800",
      "text": "زرماتون رو خودتون میخورد"
    },
    {
      "id": 45,
      "start": 15190.8,
      "end": 15192.8,
      "formatted_start": "04:13:10.800",
      "formatted_end": "04:13:12.800",
      "text": "آمین"
    },
    {
      "id": 46,
      "start": 15192.8,
      "end": 15194.8,
      "formatted_start": "04:13:12.800",
      "formatted_end": "04:13:14.800",
      "text": "ولی ایشون گل نیاز نمیخورد"
    },
    {
      "id": 47,
      "start": 15194.8,
      "end": 15196.8,
      "formatted_start": "04:13:14.800",
      "formatted_end": "04:13:16.800",
      "text": "پشت اینکه گل"
    },
    {
      "id": 48,
      "start": 15196.8,
      "end": 15198.8,
      "formatted_start": "04:13:16.800",
      "formatted_end": "04:13:18.800",
      "text": "مندیتش به دارشکرد"
    },
    {
      "id": 49,
      "start": 15198.8,
      "end": 15200.8,
      "formatted_start": "04:13:18.800",
      "formatted_end": "04:13:20.800",
      "text": "از اینکه در تاولی و"
    },
    {
      "id": 50,
      "start": 15200.8,
      "end": 15202.8,
      "formatted_start": "04:13:20.800",
      "formatted_end": "04:13:22.800",
      "text": "در تشویش و از اینکه"
    },
    {
      "id": 51,
      "start": 15202.8,
      "end": 15204.8,
      "formatted_start": "04:13:22.800",
      "formatted_end": "04:13:24.800",
      "text": "خانم از خانم رو"
    },
    {
      "id": 52,
      "start": 15204.8,
      "end": 15206.8,
      "formatted_start": "04:13:24.800",
      "formatted_end": "04:13:26.800",
      "text": "برسن"
    },
    {
      "id": 53,
      "start": 15206.8,
      "end": 15208.8,
      "formatted_start": "04:13:26.800",
      "formatted_end": "04:13:28.800",
      "text": "اگه نمیخونه باید برسن فعلا"
    },
    {
      "id": 54,
      "start": 15208.8,
      "end": 15210.8,
      "formatted_start": "04:13:28.800",
      "formatted_end": "04:13:30.800",
      "text": "باید تنویر خوارشش"
    },
    {
      "id": 55,
      "start": 15210.8,
      "end": 15212.8,
      "formatted_start": "04:13:30.800",
      "formatted_end": "04:13:32.800",
      "text": "و کبیت برسن خیلی"
    },
    {
      "id": 56,
      "start": 15212.8,
      "end": 15214.8,
      "formatted_start": "04:13:32.800",
      "formatted_end": "04:13:34.800",
      "text": "کبیتش رو باید برسن"
    },
    {
      "id": 57,
      "start": 15214.8,
      "end": 15216.8,
      "formatted_start": "04:13:34.800",
      "formatted_end": "04:13:36.800",
      "text": "با سیرسی موضوع میرونش"
    },
    {
      "id": 58,
      "start": 15216.8,
      "end": 15218.8,
      "formatted_start": "04:13:36.800",
      "formatted_end": "04:13:38.800",
      "text": "کمش از بچه چندی دریا؟"
    },
    {
      "id": 59,
      "start": 15218.8,
      "end": 15220.8,
      "formatted_start": "04:13:38.800",
      "formatted_end": "04:13:40.800",
      "text": "نه، اونا خالیه"
    },
    {
      "id": 60,
      "start": 15220.8,
      "end": 15222.8,
      "formatted_start": "04:13:40.800",
      "formatted_end": "04:13:42.800",
      "text": "نه، اونا خالیه"
    },
    {
      "id": 61,
      "start": 15222.8,
      "end": 15224.8,
      "formatted_start": "04:13:42.800",
      "formatted_end": "04:13:44.800",
      "text": "میدونم، اونا میشه یک شایر اسپاس"
    },
    {
      "id": 62,
      "start": 15224.8,
      "end": 15226.8,
      "formatted_start": "04:13:44.800",
      "formatted_end": "04:13:46.800",
      "text": "اونا چشکار نداره؟"
    },
    {
      "id": 63,
      "start": 15226.8,
      "end": 15228.8,
      "formatted_start": "04:13:46.800",
      "formatted_end": "04:13:48.800",
      "text": "نه، اونا تا دو سالگی میده"
    },
    {
      "id": 64,
      "start": 15228.8,
      "end": 15230.8,
      "formatted_start": "04:13:48.800",
      "formatted_end": "04:13:50.800",
      "text": "این محکمه میشه به پایین برسه به هم وقف بشه"
    },
    {
      "id": 65,
      "start": 15230.8,
      "end": 15232.8,
      "formatted_start": "04:13:50.800",
      "formatted_end": "04:13:52.800",
      "text": "اینا خاروای مقاییه"
    },
    {
      "id": 66,
      "start": 15232.8,
      "end": 15234.8,
      "formatted_start": "04:13:52.800",
      "formatted_end": "04:13:54.800",
      "text": "هیچ مشکل نیست و بچه ها هست شایر"
    },
    {
      "id": 67,
      "start": 15234.8,
      "end": 15236.8,
      "formatted_start": "04:13:54.800",
      "formatted_end": "04:13:56.800",
      "text": "این دایه پوستی"
    },
    {
      "id": 68,
      "start": 15236.8,
      "end": 15238.8,
      "formatted_start": "04:13:56.800",
      "formatted_end": "04:13:58.800",
      "text": "دست خود امان نیست"
    },
    {
      "id": 69,
      "start": 15238.8,
      "end": 15240.8,
      "formatted_start": "04:13:58.800",
      "formatted_end": "04:14:00.800",
      "text": "یه آلشه غذایی یا گاله"
    },
    {
      "id": 70,
      "start": 15240.8,
      "end": 15242.8,
      "formatted_start": "04:14:00.800",
      "formatted_end": "04:14:02.800",
      "text": "گال و غل یا موشکتی"
    },
    {
      "id": 71,
      "start": 15242.8,
      "end": 15246.8,
      "formatted_start": "04:14:02.800",
      "formatted_end": "04:14:06.800",
      "text": "اگر ندارید من بگیم به مگاپورت و ایدروکسیزین بگیم"
    },
    {
      "id": 72,
      "start": 15246.8,
      "end": 15251.8,
      "formatted_start": "04:14:06.800",
      "formatted_end": "04:14:11.800",
      "text": "و فعلا باید بگیدید که مداری که میخوره"
    },
    {
      "id": 73,
      "start": 15251.8,
      "end": 15257.8,
      "formatted_start": "04:14:11.800",
      "formatted_end": "04:14:17.800",
      "text": "توش حالا چیز جدیدی که اگر داریم میدیم مثلا تقنو اگر جدید داریم میدیم شاید هست"
    },
    {
      "id": 74,
      "start": 15257.8,
      "end": 15262.8,
      "formatted_start": "04:14:17.800",
      "formatted_end": "04:14:22.800",
      "text": "گوجه وضعی ها حساس هستن، پسته، گردو وضعی ها حساس هستن"
    },
    {
      "id": 75,
      "start": 15262.8,
      "end": 15266.8,
      "formatted_start": "04:14:22.800",
      "formatted_end": "04:14:26.800",
      "text": "لبنیات گاوی گوستانده که اولی ممتماهه شیرین شکلات"
    },
    {
      "id": 76,
      "start": 15266.8,
      "end": 15268.8,
      "formatted_start": "04:14:26.800",
      "formatted_end": "04:14:28.800",
      "text": "که گوکوچو ویسکویت زیاد"
    },
    {
      "id": 77,
      "start": 15268.8,
      "end": 15270.8,
      "formatted_start": "04:14:28.800",
      "formatted_end": "04:14:30.800",
      "text": "اگه قبلن میخورده مشکلی نداشته نه"
    },
    {
      "id": 78,
      "start": 15270.8,
      "end": 15272.8,
      "formatted_start": "04:14:30.800",
      "formatted_end": "04:14:32.800",
      "text": "و هیچ جدید شروع کردی تو اینا"
    },
    {
      "id": 79,
      "start": 15272.8,
      "end": 15274.8,
      "formatted_start": "04:14:32.800",
      "formatted_end": "04:14:34.800",
      "text": "نه هیچ کنون جدید شروع کردی"
    },
    {
      "id": 80,
      "start": 15274.8,
      "end": 15276.8,
      "formatted_start": "04:14:34.800",
      "formatted_end": "04:14:36.800",
      "text": "سویا، حلوه ارده، کنجه، دلستر، شاکولات"
    },
    {
      "id": 81,
      "start": 15276.8,
      "end": 15278.8,
      "formatted_start": "04:14:36.800",
      "formatted_end": "04:14:38.800",
      "text": "نمیدونی"
    },
    {
      "id": 82,
      "start": 15278.8,
      "end": 15280.8,
      "formatted_start": "04:14:38.800",
      "formatted_end": "04:14:40.800",
      "text": "و این مردم مشکل ما اینه؟"
    },
    {
      "id": 83,
      "start": 15280.8,
      "end": 15282.8,
      "formatted_start": "04:14:40.800",
      "formatted_end": "04:14:42.800",
      "text": "همم داشت"
    },
    {
      "id": 84,
      "start": 15282.8,
      "end": 15284.8,
      "formatted_start": "04:14:42.800",
      "formatted_end": "04:14:44.800",
      "text": "همم خیلی داره"
    },
    {
      "id": 85,
      "start": 15284.8,
      "end": 15286.8,
      "formatted_start": "04:14:44.800",
      "formatted_end": "04:14:46.800",
      "text": "ارامو که باید وستش جدا در مورد گستش فیلم"
    },
    {
      "id": 86,
      "start": 15286.8,
      "end": 15288.8,
      "formatted_start": "04:14:46.800",
      "formatted_end": "04:14:48.800",
      "text": "ربطی به این نداره"
    },
    {
      "id": 87,
      "start": 15288.8,
      "end": 15290.8,
      "formatted_start": "04:14:48.800",
      "formatted_end": "04:14:50.800",
      "text": "همش تب داره"
    },
    {
      "id": 88,
      "start": 15290.8,
      "end": 15297.04,
      "formatted_start": "04:14:50.800",
      "formatted_end": "04:14:57.040",
      "text": "اما ما بهش افزاونم کن میدیم یا یه داروری دیگه یه تاریخ دیگر میدیم برای خودش"
    }
  ],
  "status": "completed"
}