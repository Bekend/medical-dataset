  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8102.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:02.000",
      "text": "بیشتر که رفتم، 24 هست."
    },
    {
      "id": 1,
      "start": 8102.0,
      "end": 8103.0,
      "formatted_start": "02:15:02.000",
      "formatted_end": "02:15:03.000",
      "text": "24 هست؟"
    },
    {
      "id": 2,
      "start": 8103.0,
      "end": 8103.5,
      "formatted_start": "02:15:03.000",
      "formatted_end": "02:15:03.500",
      "text": "نه."
    },
    {
      "id": 3,
      "start": 8103.5,
      "end": 8106.0,
      "formatted_start": "02:15:03.500",
      "formatted_end": "02:15:06.000",
      "text": "خب، 24 زرده را شش کنید، چند زرده چی؟"
    },
    {
      "id": 4,
      "start": 8109.0,
      "end": 8111.0,
      "formatted_start": "02:15:09.000",
      "formatted_end": "02:15:11.000",
      "text": "24 زرده چیست؟"
    },
    {
      "id": 5,
      "start": 8111.0,
      "end": 8113.0,
      "formatted_start": "02:15:11.000",
      "formatted_end": "02:15:13.000",
      "text": "144 سن."
    },
    {
      "id": 6,
      "start": 8113.0,
      "end": 8115.0,
      "formatted_start": "02:15:13.000",
      "formatted_end": "02:15:15.000",
      "text": "خب، 144 سن."
    },
    {
      "id": 7,
      "start": 8115.0,
      "end": 8116.0,
      "formatted_start": "02:15:15.000",
      "formatted_end": "02:15:16.000",
      "text": "برسته؟"
    },
    {
      "id": 8,
      "start": 8116.0,
      "end": 8117.0,
      "formatted_start": "02:15:16.000",
      "formatted_end": "02:15:17.000",
      "text": "آره."
    },
    {
      "id": 9,
      "start": 8117.0,
      "end": 8119.0,
      "formatted_start": "02:15:17.000",
      "formatted_end": "02:15:19.000",
      "text": "این عکس شیفتون مگه داشته باشی؟"
    },
    {
      "id": 10,
      "start": 8119.0,
      "end": 8120.0,
      "formatted_start": "02:15:19.000",
      "formatted_end": "02:15:20.000",
      "text": "نه، چه..."
    },
    {
      "id": 11,
      "start": 8120.0,
      "end": 8122.0,
      "formatted_start": "02:15:20.000",
      "formatted_end": "02:15:22.000",
      "text": "چه هر زرد کنید، چه برسته باشی؟"
    },
    {
      "id": 12,
      "start": 8124.0,
      "end": 8128.0,
      "formatted_start": "02:15:24.000",
      "formatted_end": "02:15:28.000",
      "text": "اونکه مال مال جدیده، این مال مال قدیم را ندارم کنید."
    },
    {
      "id": 13,
      "start": 8128.0,
      "end": 8132.0,
      "formatted_start": "02:15:28.000",
      "formatted_end": "02:15:32.000",
      "text": "او بنابراین، الان ما جنگ زن اینجا با همین سرکار داشتیم"
    },
    {
      "id": 14,
      "start": 8132.0,
      "end": 8134.0,
      "formatted_start": "02:15:32.000",
      "formatted_end": "02:15:34.000",
      "text": "آه، آه، آه"
    },
    {
      "id": 15,
      "start": 8134.0,
      "end": 8136.0,
