      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 14130.0,
      "end": 14150.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 14150.0,
      "end": 14176.0,
      "formatted_start": "03:55:50.000",
      "formatted_end": "03:56:16.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 14176.0,
      "end": 14178.0,
      "formatted_start": "03:56:16.000",
      "formatted_end": "03:56:18.000",
      "text": "آره خانسانیت کلیه بوشانه"
    },
    {
      "id": 4,
      "start": 14178.0,
      "end": 14181.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:21.000",
      "text": "کلیه این چه خاله روزان کم تازه برامون خواست بگذاریم"
    },
    {
      "id": 5,
      "start": 14181.0,
      "end": 14184.0,
      "formatted_start": "03:56:21.000",
      "formatted_end": "03:56:24.000",
      "text": "آره دیده با ببندنش سر تیشه"
    },
    {
      "id": 6,
      "start": 14184.0,
      "end": 14186.0,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:26.000",
      "text": "تمام بخونید"
    },
    {
      "id": 7,
      "start": 14189.0,
      "end": 14191.0,
      "formatted_start": "03:56:29.000",
      "formatted_end": "03:56:31.000",
      "text": "بفهمید سلام"
    },
    {
      "id": 8,
      "start": 14191.0,
      "end": 14193.0,
      "formatted_start": "03:56:31.000",
      "formatted_end": "03:56:33.000",
      "text": "سلامت بشین"
    },
    {
      "id": 9,
      "start": 14197.0,
      "end": 14198.0,
      "formatted_start": "03:56:37.000",
      "formatted_end": "03:56:38.000",
      "text": "بفهمید"
    },
    {
      "id": 10,
      "start": 14198.0,
      "end": 14201.0,
      "formatted_start": "03:56:38.000",
      "formatted_end": "03:56:41.000",
      "text": "تقرار 15-16 به پیش آباد هم بچه های اینجا"
    },
    {
      "id": 11,
      "start": 14201.0,
      "end": 14204.0,
      "formatted_start": "03:56:41.000",
      "formatted_end": "03:56:44.000",
      "text": "باشه بعد از گریه های مقدره های شما روزی بچه"
    },
    {
      "id": 12,
      "start": 14234.0,
      "end": 14236.0,
      "formatted_start": "03:57:14.000",
      "formatted_end": "03:57:16.000",
      "text": "باید بخورد که چیزی درسته میتونه بخورد"
    },
    {
      "id": 13,
      "start": 14236.0,
      "end": 14238.0,
      "formatted_start": "03:57:16.000",
      "formatted_end": "03:57:18.000",
      "text": "نمیخوابه"
    },
    {
      "id": 14,
      "start": 14238.0,
      "end": 14240.0,
      "formatted_start": "03:57:18.000",
      "formatted_end": "03:57:20.000",
      "text": "دیرو ساعت چهار و نیمه"
    },
    {
      "id": 15,
      "start": 14240.0,
      "end": 14242.0,
      "formatted_start": "03:57:20.000",
      "formatted_end": "03:57:22.000",
      "text": "از که بیدار شد"
    },
    {
      "id": 16,
      "start": 14242.0,
      "end": 14244.0,
      "formatted_start": "03:57:22.000",
      "formatted_end": "03:57:24.000",
      "text": "تا هفت صبح این روز فقط جیبه"
    },
    {
      "id": 17,
      "start": 14244.0,
      "end": 14246.0,
      "formatted_start": "03:57:24.000",
      "formatted_end": "03:57:26.000",
      "text": "نمیخوابه"
    },
    {
      "id": 18,
      "start": 14246.0,
      "end": 14248.0,
      "formatted_start": "03:57:26.000",
      "formatted_end": "03:57:28.000",
      "text": "کنونی خیلی خوشگرم شد"
    },
    {
      "id": 19,
      "start": 14248.0,
      "end": 14250.0,
      "formatted_start": "03:57:28.000",
      "formatted_end": "03:57:30.000",
      "text": "نمیره پایین نمیادید"
    },
    {
      "id": 20,
      "start": 14250.0,
      "end": 14252.0,
      "formatted_start": "03:57:30.000",
      "formatted_end": "03:57:32.000",
      "text": "من مفردی خوشگرم شدم"
    },
    {
      "id": 21,
      "start": 14252.0,
      "end": 14254.0,
      "formatted_start": "03:57:32.000",
      "formatted_end": "03:57:34.000",
      "text": "من همه مقابل نمیدونم"
    },
    {
      "id": 22,
      "start": 14254.0,
      "end": 14256.0,
      "formatted_start": "03:57:34.000",
      "formatted_end": "03:57:36.000",
      "text": "هر پاشه سری میده"
    },
    {
      "id": 23,
      "start": 14256.0,
      "end": 14258.0,
      "formatted_start": "03:57:36.000",
      "formatted_end": "03:57:38.000",
      "text": "گرمای مایی"
    },
    {
      "id": 24,
      "start": 14258.0,
      "end": 14260.0,
      "formatted_start": "03:57:38.000",
      "formatted_end": "03:57:40.000",
      "text": "سلش داخل سا"
    },
    {
      "id": 25,
      "start": 14260.0,
      "end": 14262.0,
      "formatted_start": "03:57:40.000",
      "formatted_end": "03:57:42.000",
      "text": "از این هم داره"
    },
    {
      "id": 26,
      "start": 14262.0,
      "end": 14264.0,
      "formatted_start": "03:57:42.000",
      "formatted_end": "03:57:44.000",
      "text": "خسخس هست"
    },
    {
      "id": 27,
      "start": 14264.0,
      "end": 14266.0,
      "formatted_start": "03:57:44.000",
      "formatted_end": "03:57:46.000",
      "text": "خسخس هاش بعض موقع زیاد میشه"
    },
    {
      "id": 28,
      "start": 14266.0,
      "end": 14268.0,
      "formatted_start": "03:57:46.000",
      "formatted_end": "03:57:48.000",
      "text": "بعض موقع کنید"
    },
    {
      "id": 29,
      "start": 14268.0,
      "end": 14270.0,
      "formatted_start": "03:57:48.000",
      "formatted_end": "03:57:50.000",
      "text": "خسخس های اینجا"
    },
    {
      "id": 30,
      "start": 14270.0,
      "end": 14272.0,
      "formatted_start": "03:57:50.000",
      "formatted_end": "03:57:52.000",
      "text": "خسخس های اینجا"
    },
    {
      "id": 31,
      "start": 14272.0,
      "end": 14274.0,
      "formatted_start": "03:57:52.000",
      "formatted_end": "03:57:54.000",
      "text": "ببین باید خسخس هست"
    },
    {
      "id": 32,
      "start": 14274.0,
      "end": 14276.0,
      "formatted_start": "03:57:54.000",
      "formatted_end": "03:57:56.000",
      "text": "جانه"
    },
    {
      "id": 33,
      "start": 14276.0,
      "end": 14278.0,
      "formatted_start": "03:57:56.000",
      "formatted_end": "03:57:58.000",
      "text": "ببین"
    },
    {
      "id": 34,
      "start": 14278.0,
      "end": 14280.0,
      "formatted_start": "03:57:58.000",
      "formatted_end": "03:58:00.000",
      "text": "ببین چرا آن شد"
    },
    {
      "id": 35,
      "start": 14282.0,
      "end": 14284.0,
      "formatted_start": "03:58:02.000",
      "formatted_end": "03:58:04.000",
      "text": "ببین این حسورتی گفت"
    },
    {
      "id": 36,
      "start": 14284.0,
      "end": 14286.0,
      "formatted_start": "03:58:04.000",
      "formatted_end": "03:58:06.000",
      "text": "یادی"
    },
    {
      "id": 37,
      "start": 14286.0,
      "end": 14288.0,
      "formatted_start": "03:58:06.000",
      "formatted_end": "03:58:08.000",
      "text": "یاد میره شکن"
    },
    {
      "id": 38,
      "start": 14288.0,
      "end": 14290.0,
      "formatted_start": "03:58:08.000",
      "formatted_end": "03:58:10.000",
      "text": "اینجا نمیتونه بخونه"
    },
    {
      "id": 39,
      "start": 14290.0,
      "end": 14292.0,
      "formatted_start": "03:58:10.000",
      "formatted_end": "03:58:12.000",
      "text": "این میخوابه"
    },
    {
      "id": 40,
      "start": 14292.0,
      "end": 14294.0,
      "formatted_start": "03:58:12.000",
      "formatted_end": "03:58:14.000",
      "text": "ریفلاکس داره برگشتش بوش کن"
    },
    {
      "id": 41,
      "start": 14294.0,
      "end": 14296.0,
      "formatted_start": "03:58:14.000",
      "formatted_end": "03:58:16.000",
      "text": "خوب صحبتات کردی"
    },
    {
      "id": 42,
      "start": 14296.0,
      "end": 14298.0,
      "formatted_start": "03:58:16.000",
      "formatted_end": "03:58:18.000",
      "text": "آقا صحبت دیگه هم دارم"
    },
    {
      "id": 43,
      "start": 14298.0,
      "end": 14300.0,
      "formatted_start": "03:58:18.000",
      "formatted_end": "03:58:20.000",
      "text": "آقا صحبت دیگه هم دارم"
    },
    {
      "id": 44,
      "start": 14300.0,
      "end": 14302.0,
      "formatted_start": "03:58:20.000",
      "formatted_end": "03:58:22.000",
      "text": "اینچه آرو شد خوب"
    },
    {
      "id": 45,
      "start": 14302.0,
      "end": 14304.0,
      "formatted_start": "03:58:22.000",
      "formatted_end": "03:58:24.000",
      "text": "اینو همجوری"
    },
    {
      "id": 46,
      "start": 14304.0,
      "end": 14306.0,
      "formatted_start": "03:58:24.000",
      "formatted_end": "03:58:26.000",
      "text": "این ریفلاکس داره"
    },
    {
      "id": 47,
      "start": 14306.0,
      "end": 14308.0,
      "formatted_start": "03:58:26.000",
      "formatted_end": "03:58:28.000",
      "text": "شیره بر میگردونه"
    },
    {
      "id": 48,
      "start": 14308.0,
      "end": 14310.0,
      "formatted_start": "03:58:28.000",
      "formatted_end": "03:58:30.000",
      "text": "اینو تو حلقش"
    },
    {
      "id": 49,
      "start": 14310.0,
      "end": 14312.0,
      "formatted_start": "03:58:30.000",
      "formatted_end": "03:58:32.000",
      "text": "بعد ما از دم میریزه"
    },
    {
      "id": 50,
      "start": 14312.0,
      "end": 14314.0,
      "formatted_start": "03:58:32.000",
      "formatted_end": "03:58:34.000",
      "text": "بعد ما از حلق میرسیم سینش"
    },
    {
      "id": 51,
      "start": 14314.0,
      "end": 14316.0,
      "formatted_start": "03:58:34.000",
      "formatted_end": "03:58:36.000",
      "text": "بعد تو سینش خسکس میداری"
    },
    {
      "id": 52,
      "start": 14316.0,
      "end": 14318.0,
      "formatted_start": "03:58:36.000",
      "formatted_end": "03:58:38.000",
      "text": "دست میزنی خسکس داره"
    },
    {
      "id": 53,
      "start": 14318.0,
      "end": 14321.0,
      "formatted_start": "03:58:38.000",
      "formatted_end": "03:58:41.000",
      "text": "این تب میکرد. هوای بالا فوق عابیده"
    },
    {
      "id": 54,
      "start": 14321.0,
      "end": 14323.5,
      "formatted_start": "03:58:41.000",
      "formatted_end": "03:58:43.500",
      "text": "در نتیجه شیری که میره تو ریاض"
    },
    {
      "id": 55,
      "start": 14323.5,
      "end": 14325.0,
      "formatted_start": "03:58:43.500",
      "formatted_end": "03:58:45.000",
      "text": "آخ میزنه و از نقار"
    },
    {
      "id": 56,
      "start": 14325.0,
      "end": 14327.0,
      "formatted_start": "03:58:45.000",
      "formatted_end": "03:58:47.000",
      "text": "بیا تا اینجا میره تو ریه"
    },
    {
      "id": 57,
      "start": 14327.0,
      "end": 14329.0,
      "formatted_start": "03:58:47.000",
      "formatted_end": "03:58:49.000",
      "text": "و تو ریه خسخس میلازه"
    },
    {
      "id": 58,
      "start": 14329.0,
      "end": 14332.0,
      "formatted_start": "03:58:49.000",
      "formatted_end": "03:58:52.000",
      "text": "و از یک همینی که یکی اینه هست باید خوب میشه"
    },
    {
      "id": 59,
      "start": 14332.0,
      "end": 14333.0,
      "formatted_start": "03:58:52.000",
      "formatted_end": "03:58:53.000",
      "text": "بیا"
    },
    {
      "id": 60,
      "start": 14333.0,
      "end": 14334.0,
      "formatted_start": "03:58:53.000",
      "formatted_end": "03:58:54.000",
      "text": "آیا چون یه چیز دیگه برم؟"
    },
    {
      "id": 61,
      "start": 14334.0,
      "end": 14336.0,
      "formatted_start": "03:58:54.000",
      "formatted_end": "03:58:56.000",
      "text": "برای این زمان باید بشه بگیرم"
    },
    {
      "id": 62,
      "start": 14336.0,
      "end": 14338.0,
      "formatted_start": "03:58:56.000",
      "formatted_end": "03:58:58.000",
      "text": "همون دارم یه چوکتر تو بشو"
    },
    {
      "id": 63,
      "start": 14338.0,
      "end": 14340.0,
      "formatted_start": "03:58:58.000",
      "formatted_end": "03:59:00.000",
      "text": "و برگشت به برگ نفتش که بچه سینش"
    },
    {
      "id": 64,
      "start": 14340.0,
      "end": 14345.0,
      "formatted_start": "03:59:00.000",
      "formatted_end": "03:59:05.000",
      "text": "از سینش، خیلی تا خیلی این کار از دست ما بردم و باید بگیرم واسه بستنش چه کلیتون از دست نداره"
    },
    {
      "id": 65,
      "start": 14345.0,
      "end": 14346.0,
      "formatted_start": "03:59:05.000",
      "formatted_end": "03:59:06.000",
      "text": "چه خوشکن هم میده"
    },
    {
      "id": 66,
      "start": 14346.0,
      "end": 14350.0,
      "formatted_start": "03:59:06.000",
      "formatted_end": "03:59:10.000",
      "text": "چه خوشکن سه روز آدیتون واسه نداره، اصلا یک نداشتی ترسیب هم نکرده"
    },
    {
      "id": 67,
      "start": 14350.0,
      "end": 14352.0,
      "formatted_start": "03:59:10.000",
      "formatted_end": "03:59:12.000",
      "text": "چرا روز آدیتون هم چه؟"
    },
    {
      "id": 68,
      "start": 14353.0,
      "end": 14355.0,
      "formatted_start": "03:59:13.000",
      "formatted_end": "03:59:15.000",
      "text": "آبو تا فرق نفذ چون اینجورو بگیره؟"
    },
    {
      "id": 69,
      "start": 14355.0,
      "end": 14357.0,
      "formatted_start": "03:59:15.000",
      "formatted_end": "03:59:17.000",
      "text": "نمیتونه بخواه"
    },
    {
      "id": 70,
      "start": 14357.0,
      "end": 14359.0,
      "formatted_start": "03:59:17.000",
      "formatted_end": "03:59:19.000",
      "text": "یه لحظه سپس بگیرم"
    },
    {
      "id": 71,
      "start": 14365.0,
      "end": 14366.0,
      "formatted_start": "03:59:25.000",
      "formatted_end": "03:59:26.000",
      "text": "آقایی؟"
    },
    {
      "id": 72,
      "start": 14366.0,
      "end": 14367.0,
      "formatted_start": "03:59:26.000",
      "formatted_end": "03:59:27.000",
      "text": "اسمش چه؟"
    },
    {
      "id": 73,
      "start": 14367.0,
      "end": 14368.0,
      "formatted_start": "03:59:27.000",
      "formatted_end": "03:59:28.000",
      "text": "ساباش"
    },
    {
      "id": 74,
      "start": 14368.0,
      "end": 14369.0,
      "formatted_start": "03:59:28.000",
      "formatted_end": "03:59:29.000",
      "text": "ساباش؟"
    },
    {
