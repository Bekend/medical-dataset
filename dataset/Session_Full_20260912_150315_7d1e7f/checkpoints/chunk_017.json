  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5129.98,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 5130.0,
      "end": 5154.0,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:54.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 5154.0,
      "end": 5156.82,
      "formatted_start": "01:25:54.000",
      "formatted_end": "01:25:56.820",
      "text": "بخشید سلام بخشید خوشید خوشید"
    },
    {
      "id": 3,
      "start": 5156.82,
      "end": 5159.24,
      "formatted_start": "01:25:56.820",
      "formatted_end": "01:25:59.240",
      "text": "خب ما تکره دختر خودتون سلام بسونیم"
    },
    {
      "id": 4,
      "start": 5159.24,
      "end": 5160.0,
      "formatted_start": "01:25:59.240",
      "formatted_end": "01:26:00.000",
      "text": "نه خوشید من"
    },
    {
      "id": 5,
      "start": 5160.0,
      "end": 5163.0,
      "formatted_start": "01:26:00.000",
      "formatted_end": "01:26:03.000",
      "text": "خب خودتون بیده جوابیم بگو باید بسیاریم"
    },
    {
      "id": 6,
      "start": 5163.0,
      "end": 5165.0,
      "formatted_start": "01:26:03.000",
      "formatted_end": "01:26:05.000",
      "text": "خب خوبی کردید"
    },
    {
      "id": 7,
      "start": 5167.0,
      "end": 5170.0,
      "formatted_start": "01:26:07.000",
      "formatted_end": "01:26:10.000",
      "text": "خودمون از اینکه تروجیدید میباشم فیلم نقره هم بردیم"
    },
    {
      "id": 8,
      "start": 5171.0,
      "end": 5174.0,
      "formatted_start": "01:26:11.000",
      "formatted_end": "01:26:14.000",
      "text": "و تقامات رو بردیم و فیلم"
    },
    {
      "id": 9,
      "start": 5179.0,
      "end": 5181.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:21.000",
      "text": "خودش کن چیز خواستی نیست؟"
    },
    {
      "id": 10,
      "start": 5181.0,
      "end": 5182.0,
      "formatted_start": "01:26:21.000",
      "formatted_end": "01:26:22.000",
      "text": "گفت قطران بدید"
    },
    {
      "id": 11,
      "start": 5182.0,
      "end": 5185.0,
      "formatted_start": "01:26:22.000",
      "formatted_end": "01:26:25.000",
      "text": "این هیتروژینیت میرشده"
    },
    {
      "id": 12,
      "start": 5190.0,
      "end": 5194.0,
      "formatted_start": "01:26:30.000",
      "formatted_end": "01:26:34.000",
      "text": "این هم به من گفت برای بچه هستون این آزمایش میدونیم ببینیم شیمه"
    },
    {
      "id": 13,
      "start": 5194.0,
      "end": 5198.0,
      "formatted_start": "01:26:34.000",
      "formatted_end": "01:26:38.000",
      "text": "دوباره آزمایشو مراقب استه"
    },
    {
      "id": 14,
      "start": 5198.0,
      "end": 5201.0,
      "formatted_start": "01:26:38.000",
      "formatted_end": "01:26:41.000",
      "text": "آره گفت برای بچه این تو راهه هست"
    },
    {
      "id": 15,
      "start": 5201.0,
      "end": 5206.0,
      "formatted_start": "01:26:41.000",
      "formatted_end": "01:26:46.000",
      "text": "خیلی خوب ممنون خب خدا به شکل که این چیز حقیقی نیست"
    },
    {
      "id": 16,
      "start": 5206.0,
      "end": 5208.0,
      "formatted_start": "01:26:46.000",
      "formatted_end": "01:26:48.000",
      "text": "بخیر منتظرم"
    },
    {
      "id": 17,
      "start": 5208.0,
      "end": 5215.5,
      "formatted_start": "01:26:48.000",
      "formatted_end": "01:26:55.500",
      "text": "آرزون قطعه آهنگشون مثلا از قطعه بخشید خارجی بگیره بهتر؟"
    },
    {
      "id": 18,
      "start": 5215.5,
      "end": 5223.5,
      "formatted_start": "01:26:55.500",
      "formatted_end": "01:27:03.500",
      "text": "آره جنس های خوبی اینا هست مثلا این قطعه کردن این اومده تعمی چند که اینا بخواییم به تونشین چیز کنی؟"
    },
    {
      "id": 19,
      "start": 5223.5,
      "end": 5224.5,
      "formatted_start": "01:27:03.500",
      "formatted_end": "01:27:04.500",
      "text": "چند اینا؟"
    },
    {
      "id": 20,
      "start": 5224.5,
      "end": 5230.5,
      "formatted_start": "01:27:04.500",
      "formatted_end": "01:27:10.500",
      "text": "اینا چارصده ولی مثلا قطعه آهنگ که پونزده قطعه میدن اینا هفت هشت قطعه میدن"
    },
    {
      "id": 21,
      "start": 5230.5,
      "end": 5231.5,
      "formatted_start": "01:27:10.500",
      "formatted_end": "01:27:11.500",
      "text": "خب بیست سال اطول بدید"
    },
    {
      "id": 22,
      "start": 5231.5,
      "end": 5233.5,
      "formatted_start": "01:27:11.500",
      "formatted_end": "01:27:13.500",
      "text": "خب اینا تا پونزده قطعه بدید"
    },
    {
      "id": 23,
      "start": 5233.5,
      "end": 5234.5,
      "formatted_start": "01:27:13.500",
      "formatted_end": "01:27:14.500",
      "text": "پونزده"
    },
    {
      "id": 24,
      "start": 5234.5,
      "end": 5236.96,
      "formatted_start": "01:27:14.500",
      "formatted_end": "01:27:16.960",
      "text": "این اثرده ایش خیلی بالاییه"
    },
    {
      "id": 25,
      "start": 5236.96,
      "end": 5241.26,
      "formatted_start": "01:27:16.960",
      "formatted_end": "01:27:21.260",
      "text": "این هم همش خوبه هم دندون سیاره می کنه"
    },
    {
      "id": 26,
      "start": 5241.26,
      "end": 5244.22,
      "formatted_start": "01:27:21.260",
      "formatted_end": "01:27:24.220",
      "text": "خیلی فدمت شما این عالیه"
    },
    {
      "id": 27,
      "start": 5244.22,
      "end": 5245.98,
      "formatted_start": "01:27:24.220",
      "formatted_end": "01:27:25.980",
      "text": "اینو میرویم یه آداشت"
    },
    {
      "id": 28,
      "start": 5245.98,
      "end": 5248.34,
      "formatted_start": "01:27:25.980",
      "formatted_end": "01:27:28.340",
      "text": "آره آره اون رو به منشین دیدید تا با گرم نداشت"
    },
    {
      "id": 29,
      "start": 5248.34,
      "end": 5249.26,
      "formatted_start": "01:27:28.340",
      "formatted_end": "01:27:29.260",
      "text": "باشه شدید شدید شدید"
    },
    {
      "id": 30,
      "start": 5249.26,
      "end": 5250.06,
      "formatted_start": "01:27:29.260",
      "formatted_end": "01:27:30.060",
      "text": "دربارت باشید"
    },
    {
      "id": 31,
      "start": 5250.06,
      "end": 5251.46,
      "formatted_start": "01:27:30.060",
      "formatted_end": "01:27:31.460",
      "text": "قام سمیت اینو"
    },
    {
      "id": 32,
      "start": 5251.46,
      "end": 5253.74,
      "formatted_start": "01:27:31.460",
      "formatted_end": "01:27:33.740",
      "text": "قام سمیت باشون کار رو برماشون میگه"
    },
    {
      "id": 33,
      "start": 5264.5,
      "end": 5292.5,
      "formatted_start": "01:27:44.500",
      "formatted_end": "01:28:12.500",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 5292.5,
      "end": 5305.5,
      "formatted_start": "01:28:12.500",
      "formatted_end": "01:28:25.500",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 5305.5,
      "end": 5308.5,
      "formatted_start": "01:28:25.500",
      "formatted_end": "01:28:28.500",
      "text": "چار سده این مکه آن خواهیجیه؟"
    },
    {
      "id": 36,
      "start": 5308.5,
      "end": 5309.5,
      "formatted_start": "01:28:28.500",
      "formatted_end": "01:28:29.500",
      "text": "آره آره چار سده"
    },
    {
      "id": 37,
      "start": 5309.5,
      "end": 5329.5,
      "formatted_start": "01:28:29.500",
      "formatted_end": "01:28:49.500",
      "text": "موسیقی"
    },
    {
