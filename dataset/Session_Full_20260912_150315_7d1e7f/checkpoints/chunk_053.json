      "formatted_start": "04:25:00.000",
      "formatted_end": "04:25:02.000",
      "text": "از این راستان هم باید برداریم."
    },
    {
      "id": 1,
      "start": 15902.0,
      "end": 15904.0,
      "formatted_start": "04:25:02.000",
      "formatted_end": "04:25:04.000",
      "text": "ما هم را خوندیم. از این را اشتباه می کنیم."
    },
    {
      "id": 2,
      "start": 15904.0,
      "end": 15906.0,
      "formatted_start": "04:25:04.000",
      "formatted_end": "04:25:06.000",
      "text": "از این را خوندیم. از این را اشتباه می کنیم."
    },
    {
      "id": 3,
      "start": 15906.0,
      "end": 15908.0,
      "formatted_start": "04:25:06.000",
      "formatted_end": "04:25:08.000",
      "text": "از این را خوندیم. از این را اشتباه می کنیم."
    },
    {
      "id": 4,
      "start": 15908.0,
      "end": 15910.0,
      "formatted_start": "04:25:08.000",
      "formatted_end": "04:25:10.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 5,
      "start": 15910.0,
      "end": 15912.0,
      "formatted_start": "04:25:10.000",
      "formatted_end": "04:25:12.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 6,
      "start": 15912.0,
      "end": 15914.0,
      "formatted_start": "04:25:12.000",
      "formatted_end": "04:25:14.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 7,
      "start": 15914.0,
      "end": 15916.0,
      "formatted_start": "04:25:14.000",
      "formatted_end": "04:25:16.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 8,
      "start": 15916.0,
      "end": 15918.0,
      "formatted_start": "04:25:16.000",
      "formatted_end": "04:25:18.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 9,
      "start": 15918.0,
      "end": 15920.0,
      "formatted_start": "04:25:18.000",
      "formatted_end": "04:25:20.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 10,
      "start": 15920.0,
      "end": 15922.0,
      "formatted_start": "04:25:20.000",
      "formatted_end": "04:25:22.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 11,
      "start": 15922.0,
      "end": 15924.0,
      "formatted_start": "04:25:22.000",
      "formatted_end": "04:25:24.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 12,
      "start": 15924.0,
      "end": 15926.0,
      "formatted_start": "04:25:24.000",
      "formatted_end": "04:25:26.000",
      "text": "خیلی خوب. تمام."
    },
    {
      "id": 13,
      "start": 15926.0,
      "end": 15928.0,
      "formatted_start": "04:25:26.000",
      "formatted_end": "04:25:28.000",
      "text": "اینکه خیلی نیست که بیارو برون"
    },
    {
      "id": 14,
      "start": 15928.0,
      "end": 15930.0,
      "formatted_start": "04:25:28.000",
      "formatted_end": "04:25:30.000",
      "text": "یکم زیر زده یک خیلی آورده بیرون"
    },
    {
      "id": 15,
      "start": 15930.0,
      "end": 15932.0,
      "formatted_start": "04:25:30.000",
      "formatted_end": "04:25:32.000",
      "text": "نه نه، دیوز که گذاشتون"
    },
    {
      "id": 16,
      "start": 15932.0,
      "end": 15934.0,
      "formatted_start": "04:25:32.000",
      "formatted_end": "04:25:34.000",
      "text": "دیوز بخور"
    },
    {
      "id": 17,
      "start": 15934.0,
      "end": 15936.0,
      "formatted_start": "04:25:34.000",
      "formatted_end": "04:25:36.000",
      "text": "اگر خوبه برد"
    },
    {
      "id": 18,
      "start": 15936.0,
      "end": 15938.0,
      "formatted_start": "04:25:36.000",
      "formatted_end": "04:25:38.000",
      "text": "یکم برد یک رو بشات می کنیم"
    },
    {
      "id": 19,
      "start": 15938.0,
      "end": 15940.0,
      "formatted_start": "04:25:38.000",
      "formatted_end": "04:25:40.000",
      "text": "آره، خیلی دارش"
    },
    {
      "id": 20,
      "start": 15940.0,
      "end": 15942.0,
      "formatted_start": "04:25:40.000",
      "formatted_end": "04:25:42.000",
      "text": "نه نه، اگر منحق چیز خوبه برد"
    },
    {
      "id": 21,
      "start": 15942.0,
      "end": 15944.0,
      "formatted_start": "04:25:42.000",
      "formatted_end": "04:25:44.000",
      "text": "برد"
    },
    {
      "id": 22,
      "start": 15944.0,
      "end": 15946.0,
      "formatted_start": "04:25:44.000",
      "formatted_end": "04:25:46.000",
      "text": "پس اینکه باشه یک چیز"
    },
    {
      "id": 23,
      "start": 15946.0,
      "end": 15948.0,
      "formatted_start": "04:25:46.000",
      "formatted_end": "04:25:48.000",
      "text": "یک سخته"
    },
    {
      "id": 24,
      "start": 15948.0,
      "end": 15950.0,
      "formatted_start": "04:25:48.000",
      "formatted_end": "04:25:50.000",
      "text": "بسه شما درم نکرس"
    },
    {
      "id": 25,
      "start": 15950.0,
      "end": 15952.0,
      "formatted_start": "04:25:50.000",
      "formatted_end": "04:25:52.000",
      "text": "بسه شما درم نکرس"
    },
    {
      "id": 26,
      "start": 15952.0,
      "end": 15954.0,
      "formatted_start": "04:25:52.000",
      "formatted_end": "04:25:54.000",
      "text": "بسه شما درم نکرس"
    },
    {
      "id": 27,
      "start": 15954.0,
      "end": 15956.0,
      "formatted_start": "04:25:54.000",
      "formatted_end": "04:25:56.000",
      "text": "بخیر من"
    },
    {
      "id": 28,
      "start": 15956.0,
      "end": 15958.0,
      "formatted_start": "04:25:56.000",
      "formatted_end": "04:25:58.000",
      "text": "خب ببین"
    },
    {
      "id": 29,
      "start": 15958.0,
      "end": 15960.0,
      "formatted_start": "04:25:58.000",
      "formatted_end": "04:26:00.000",
      "text": "این هشت سال عشق قطره"
    },
    {
      "id": 30,
      "start": 15960.0,
      "end": 15962.0,
      "formatted_start": "04:26:00.000",
      "formatted_end": "04:26:02.000",
      "text": "اینم روزی پونزر قطره"
    },
    {
      "id": 31,
      "start": 15962.0,
      "end": 15964.0,
      "formatted_start": "04:26:02.000",
      "formatted_end": "04:26:04.000",
      "text": "روزی یک بار پونزر قطره"
    },
    {
      "id": 32,
      "start": 15964.0,
      "end": 15966.0,
      "formatted_start": "04:26:04.000",
      "formatted_end": "04:26:06.000",
      "text": "روزی سه بار عشق قطره"
    },
    {
      "id": 33,
      "start": 15966.0,
      "end": 15968.0,
      "formatted_start": "04:26:06.000",
      "formatted_end": "04:26:08.000",
      "text": "این کلیبش اگر تمامشون دوباره تیز میشه"
    },
    {
      "id": 34,
      "start": 15968.0,
      "end": 15970.0,
      "formatted_start": "04:26:08.000",
      "formatted_end": "04:26:10.000",
      "text": "بله بله"
    },
    {
      "id": 35,
      "start": 15970.0,
      "end": 15972.0,
      "formatted_start": "04:26:10.000",
      "formatted_end": "04:26:12.000",
      "text": "اینم میتونیم اینم هر کدام"
    },
    {
      "id": 36,
      "start": 15972.0,
      "end": 15974.0,
      "formatted_start": "04:26:12.000",
      "formatted_end": "04:26:14.000",
      "text": "دوسته ما میشه دار"
    },
    {
      "id": 37,
      "start": 15974.0,
      "end": 15976.0,
      "formatted_start": "04:26:14.000",
      "formatted_end": "04:26:16.000",
      "text": "بله بله هشت مشکلشن"
    },
    {
      "id": 38,
      "start": 15976.0,
      "end": 15978.0,
      "formatted_start": "04:26:16.000",
      "formatted_end": "04:26:18.000",
      "text": "چون نفتی هیچیزی نیست که سریع خوب کشه"
    },
    {
      "id": 39,
      "start": 15978.0,
      "end": 15980.0,
      "formatted_start": "04:26:18.000",
      "formatted_end": "04:26:20.000",
      "text": "آسمائی اینم میتونیم به جسته"
    },
    {
      "id": 40,
      "start": 15980.0,
      "end": 15983.46,
      "formatted_start": "04:26:20.000",
      "formatted_end": "04:26:23.460",
      "text": "تازه همه که آبون بشه و بعد کم کم کمش کنه دوست میگه دیشون"
    },
    {
      "id": 41,
      "start": 15983.46,
      "end": 15984.46,
      "formatted_start": "04:26:23.460",
      "formatted_end": "04:26:24.460",
      "text": "بچه مورد همه"
    },
    {
      "id": 42,
      "start": 15984.46,
      "end": 15985.66,
      "formatted_start": "04:26:24.460",
      "formatted_end": "04:26:25.660",
      "text": "این ها هشت ساعت"
    },
    {
      "id": 43,
      "start": 15985.66,
      "end": 15988.16,
      "formatted_start": "04:26:25.660",
      "formatted_end": "04:26:28.160",
      "text": "ای بابا این ها چرا مثل مورچه میبینیسن"
    },
    {
      "id": 44,
      "start": 15988.16,
      "end": 15990.16,
      "formatted_start": "04:26:28.160",
      "formatted_end": "04:26:30.160",
      "text": "انا شانی میخوانی بخوریم"
    },
    {
      "id": 45,
      "start": 15990.16,
      "end": 15994.0,
      "formatted_start": "04:26:30.160",
      "formatted_end": "04:26:34.000",
      "text": "مورچه میبینیسن دیگه"
    },
    {
      "id": 46,
      "start": 15994.0,
      "end": 15996.76,
      "formatted_start": "04:26:34.000",
      "formatted_end": "04:26:36.760",
      "text": "هر هشت ساعت"
    },
    {
      "id": 47,
      "start": 15996.76,
      "end": 15998.76,
      "formatted_start": "04:26:36.760",
      "formatted_end": "04:26:38.760",
      "text": "هشت قطعه"
    },
    {
      "id": 48,
      "start": 15998.76,
      "end": 16001.34,
      "formatted_start": "04:26:38.760",
      "formatted_end": "04:26:41.340",
      "text": "بابا این چیه میبینیسن سوگویشه"
    },
    {
      "id": 49,
      "start": 16001.34,
      "end": 16005.2,
      "formatted_start": "04:26:41.340",
      "formatted_end": "04:26:45.200",
      "text": "خب این فرمادم که"
    },
    {
      "id": 50,
      "start": 16005.2,
      "end": 16007.66,
      "formatted_start": "04:26:45.200",
      "formatted_end": "04:26:47.660",
      "text": "درجه اون برای چیزشه"
    },
    {
      "id": 51,
      "start": 16007.66,
      "end": 16010.9,
      "formatted_start": "04:26:47.660",
      "formatted_end": "04:26:50.900",
      "text": "این هم هر هشت ساعت مورد بخورید"
    },
    {
      "id": 52,
      "start": 16010.9,
      "end": 16012.9,
      "formatted_start": "04:26:50.900",
      "formatted_end": "04:26:52.900",
      "text": "یک قرص خنوط"
    },
    {
      "id": 53,
      "start": 16012.9,
      "end": 16015.9,
      "formatted_start": "04:26:52.900",
      "formatted_end": "04:26:55.900",
      "text": "درده هم داشتون اون قرصه کنید"
    },
    {
      "id": 54,
      "start": 16015.9,
      "end": 16019.42,
      "formatted_start": "04:26:55.900",
      "formatted_end": "04:26:59.420",
      "text": "این رو صبح و شب یک چارمشتو آورد کنید و بکش بگیدید"
    },
    {
      "id": 55,
      "start": 16019.42,
      "end": 16021.42,
      "formatted_start": "04:26:59.420",
      "formatted_end": "04:27:01.420",
      "text": "یک چارمشتو آورد کنید"
    },
    {
      "id": 56,
      "start": 16021.42,
      "end": 16023.42,
      "formatted_start": "04:27:01.420",
      "formatted_end": "04:27:03.420",
      "text": "بیایید به سرم هستید"
    },
    {
      "id": 57,
      "start": 16023.42,
      "end": 16025.42,
      "formatted_start": "04:27:03.420",
      "formatted_end": "04:27:05.420",
      "text": "دستگاه هم ببنیم"
    },
    {
      "id": 58,
      "start": 16025.42,
      "end": 16028.66,
      "formatted_start": "04:27:05.420",
      "formatted_end": "04:27:08.660",
      "text": "تا شنبه بگو چیز کنم دستگاه ببنیم"
    },
    {
      "id": 59,
      "start": 16028.66,
      "end": 16030.66,
      "formatted_start": "04:27:08.660",
      "formatted_end": "04:27:10.660",
      "text": "خواهش داریم"
    },
    {
      "id": 60,
      "start": 16033.66,
      "end": 16035.66,
      "formatted_start": "04:27:13.660",
      "formatted_end": "04:27:15.660",
      "text": "در رو بیزنند ببندیم هم بشید"
    },
    {
      "id": 61,
      "start": 16037.66,
      "end": 16039.66,
      "formatted_start": "04:27:17.660",
      "formatted_end": "04:27:19.660",
      "text": "موسیقی"
    },
    {
      "id": 62,
      "start": 16067.66,
      "end": 16091.66,
      "formatted_start": "04:27:47.660",
      "formatted_end": "04:28:11.660",
      "text": "موسیقی"
    },
    {
      "id": 63,
      "start": 16091.66,
      "end": 16093.66,
      "formatted_start": "04:28:11.660",
      "formatted_end": "04:28:13.660",
      "text": "سلام آقاییم"
    },
    {
      "id": 64,
      "start": 16093.66,
      "end": 16095.66,
      "formatted_start": "04:28:13.660",
      "formatted_end": "04:28:15.660",
      "text": "مرسی مرسی"
    },
    {
      "id": 65,
      "start": 16095.66,
      "end": 16097.66,
      "formatted_start": "04:28:15.660",
      "formatted_end": "04:28:17.660",
      "text": "بله ساتین پولونو نوشته بودید؟"
    },
    {
      "id": 66,
      "start": 16097.66,
      "end": 16099.66,
      "formatted_start": "04:28:17.660",
      "formatted_end": "04:28:19.660",
      "text": "نره"
    },
    {
      "id": 67,
      "start": 16099.66,
      "end": 16101.66,
      "formatted_start": "04:28:19.660",
      "formatted_end": "04:28:21.660",
      "text": "مشکلش چی بود؟"
    },
    {
      "id": 68,
      "start": 16101.66,
      "end": 16103.66,
      "formatted_start": "04:28:21.660",
      "formatted_end": "04:28:23.660",
      "text": "از خواهی میرفتد آزمایش"
    },
    {
      "id": 69,
      "start": 16103.66,
      "end": 16105.66,
      "formatted_start": "04:28:23.660",
      "formatted_end": "04:28:25.660",
      "text": "آقایش هم اینجاست"
    },
    {
      "id": 70,
      "start": 16105.66,
      "end": 16107.66,
      "formatted_start": "04:28:25.660",
      "formatted_end": "04:28:27.660",
      "text": "که گفته بیرون سنهای شکل هم برده"
    },
    {
      "id": 71,
      "start": 16107.66,
      "end": 16109.66,
      "formatted_start": "04:28:27.660",
      "formatted_end": "04:28:29.660",
      "text": "آزمایش میبینن؟"
    },
    {
      "id": 72,
      "start": 16109.66,
      "end": 16121.66,
      "formatted_start": "04:28:29.660",
      "formatted_end": "04:28:41.660",
      "text": "این همون فرده شده هم صورت آمده"
    },
    {
      "id": 73,
      "start": 16121.66,
      "end": 16131.66,
      "formatted_start": "04:28:41.660",
      "formatted_end": "04:28:51.660",
      "text": "این همون فرده شده هم صورت آمده"
    },
    {
      "id": 74,
      "start": 16131.66,
      "end": 16140.66,
      "formatted_start": "04:28:51.660",
      "formatted_end": "04:29:00.660",
      "text": "برحال این یک ندار بالا زده توصیل می کنم یک ماه بعد یک آزمایش تستایی کبینی تکرار بشه"
    },
    {
      "id": 75,
      "start": 16140.66,
      "end": 16142.66,
      "formatted_start": "04:29:00.660",
      "formatted_end": "04:29:02.660",
      "text": "وقتی بالاتر نره"
    },
    {
      "id": 76,
      "start": 16142.66,
      "end": 16144.66,
      "formatted_start": "04:29:02.660",
      "formatted_end": "04:29:04.660",
      "text": "آه اینجا من شما قید کنم"
    },
    {
      "id": 77,
      "start": 16144.66,
      "end": 16148.66,
      "formatted_start": "04:29:04.660",
      "formatted_end": "04:29:08.660",
      "text": "برای این یک ماه بعد خدمت شما خودمون باشه"
    },
    {
      "id": 78,
      "start": 16161.66,
      "end": 16163.66,
      "formatted_start": "04:29:21.660",
      "formatted_end": "04:29:23.660",
      "text": "برد برد"
    },
    {
      "id": 79,
      "start": 16163.66,
      "end": 16165.66,
      "formatted_start": "04:29:23.660",
      "formatted_end": "04:29:25.660",
      "text": "برد برد"
    },
    {
      "id": 80,
      "start": 16165.66,
      "end": 16167.66,
      "formatted_start": "04:29:25.660",
      "formatted_end": "04:29:27.660",
      "text": "بخنم"
    },
    {
      "id": 81,
      "start": 16167.66,
      "end": 16169.66,
      "formatted_start": "04:29:27.660",
      "formatted_end": "04:29:29.660",
      "text": "بخنم"
    },
    {
      "id": 82,
      "start": 16169.66,
      "end": 16171.66,
      "formatted_start": "04:29:29.660",
      "formatted_end": "04:29:31.660",
      "text": "سلام بابا جان سلامت کشیم بگم"
    },
    {
      "id": 83,
      "start": 16171.66,
      "end": 16173.66,
      "formatted_start": "04:29:31.660",
      "formatted_end": "04:29:33.660",
      "text": "برگره بزنم که"
    },
    {
      "id": 84,
      "start": 16173.66,
      "end": 16175.66,
      "formatted_start": "04:29:33.660",
      "formatted_end": "04:29:35.660",
      "text": "چی شده خانمه؟"
    },
    {
      "id": 85,
      "start": 16175.66,
      "end": 16177.66,
      "formatted_start": "04:29:35.660",
      "formatted_end": "04:29:37.660",
      "text": "تروا خوده"
    },
    {
      "id": 86,
      "start": 16177.66,
      "end": 16179.66,
      "formatted_start": "04:29:37.660",
      "formatted_end": "04:29:39.660",
      "text": "گلگیش چه علایی میداره؟"
    },
    {
      "id": 87,
      "start": 16179.66,
      "end": 16181.66,
      "formatted_start": "04:29:39.660",
      "formatted_end": "04:29:41.660",
      "text": "همشتر میکنه صرفه داره"
    },
    {
      "id": 88,
      "start": 16181.66,
      "end": 16183.66,
      "formatted_start": "04:29:41.660",
      "formatted_end": "04:29:43.660",
      "text": "صرفه، آقاییزش"
    },
    {
      "id": 89,
      "start": 16183.66,
      "end": 16185.66,
      "formatted_start": "04:29:43.660",
      "formatted_end": "04:29:45.660",
      "text": "خسکس سینه"
    },
    {
      "id": 90,
      "start": 16185.66,
      "end": 16187.66,
      "formatted_start": "04:29:45.660",
      "formatted_end": "04:29:47.660",
      "text": "صرفه ها خشک یا خلیمتی؟"
    },
    {
      "id": 91,
      "start": 16187.66,
      "end": 16189.66,
      "formatted_start": "04:29:47.660",
      "formatted_end": "04:29:49.660",
      "text": "خشکی"
    },
    {
      "id": 92,
      "start": 16189.66,
      "end": 16191.66,
      "formatted_start": "04:29:49.660",
      "formatted_end": "04:29:51.660",
      "text": "پشتنم یا تک تک؟"
    },
    {
      "id": 93,
      "start": 16191.66,
      "end": 16192.66,
      "formatted_start": "04:29:51.660",
      "formatted_end": "04:29:52.660",
      "text": "تک تک"
    },
    {
      "id": 94,
      "start": 16192.66,
      "end": 16193.66,
      "formatted_start": "04:29:52.660",
      "formatted_end": "04:29:53.660",
      "text": "بیخالم شده؟"
    },
    {
      "id": 95,
      "start": 16193.66,
      "end": 16194.66,
      "formatted_start": "04:29:53.660",
      "formatted_end": "04:29:54.660",
      "text": "نه"
    },
    {
      "id": 96,
      "start": 16194.66,
      "end": 16195.66,
      "formatted_start": "04:29:54.660",
      "formatted_end": "04:29:55.660",
      "text": "بیخالم شده؟"
    },
    {
      "id": 97,
      "start": 16195.66,
      "end": 16196.66,
      "formatted_start": "04:29:55.660",
      "formatted_end": "04:29:56.660",
      "text": "نه"
    },
    {
      "id": 98,
      "start": 16197.66,
      "end": 16199.66,
      "formatted_start": "04:29:57.660",
      "formatted_end": "04:29:59.660",
      "text": "مردش، مردش، مردش"
    },
    {
      "id": 99,
      "start": 16199.66,
      "end": 16200.66,
      "formatted_start": "04:29:59.660",
      "formatted_end": "04:30:00.660",
      "text": "همش مردش شده"
    }
  ],
  "status": "completed"
}