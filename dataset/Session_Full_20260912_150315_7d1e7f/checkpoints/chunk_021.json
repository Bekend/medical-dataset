  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6330.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:30.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6333.44,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:33.440",
      "text": "چون الان خیلی از مسبباتی که ما کردیم اجرا نشوند"
    },
    {
      "id": 2,
      "start": 6333.44,
      "end": 6336.56,
      "formatted_start": "01:45:33.440",
      "formatted_end": "01:45:36.560",
      "text": "خیلی اجرا نشوند، فایده نداره"
    },
    {
      "id": 3,
      "start": 6336.56,
      "end": 6338.56,
      "formatted_start": "01:45:36.560",
      "formatted_end": "01:45:38.560",
      "text": "اصلا من دیگه..."
    },
    {
      "id": 4,
      "start": 6338.56,
      "end": 6340.56,
      "formatted_start": "01:45:38.560",
      "formatted_end": "01:45:40.560",
      "text": "آفرین، آفرین"
    },
    {
      "id": 5,
      "start": 6340.56,
      "end": 6343.2,
      "formatted_start": "01:45:40.560",
      "formatted_end": "01:45:43.200",
      "text": "اگه خواهید بزنیم، ها خواهید باشیم؟"
    },
    {
      "id": 6,
      "start": 6343.2,
      "end": 6345.84,
      "formatted_start": "01:45:43.200",
      "formatted_end": "01:45:45.840",
      "text": "نه، نمیشه، اینا امپراتوری دارن"
    },
    {
      "id": 7,
      "start": 6345.84,
      "end": 6351.36,
      "formatted_start": "01:45:45.840",
      "formatted_end": "01:45:51.360",
      "text": "امی امپراتوریشون، آره اصلا حسابداری جاهای دیگه خوب"
    },
    {
      "id": 8,
      "start": 6351.36,
      "end": 6355.92,
      "formatted_start": "01:45:51.360",
      "formatted_end": "01:45:55.920",
      "text": "این الان بسیار، الان خیلی فرصت خوبیه"
    },
    {
      "id": 9,
      "start": 6355.92,
      "end": 6360.92,
      "formatted_start": "01:45:55.920",
      "formatted_end": "01:46:00.920",
      "text": "شما میتونید بیمارسان یه اصلاحات خیلی خوبی رو به وجود بیایید خود"
    },
    {
      "id": 10,
      "start": 6360.92,
      "end": 6365.92,
      "formatted_start": "01:46:00.920",
      "formatted_end": "01:46:05.920",
      "text": "چون اینا من میرم الان من دو سال دارم یه اتکت رو نمیتونم چیز کنم"
    },
    {
      "id": 11,
      "start": 6365.92,
      "end": 6369.92,
      "formatted_start": "01:46:05.920",
      "formatted_end": "01:46:09.920",
      "text": "خواهیده نداری که از این آخرها بیمارسان"
    },
    {
      "id": 12,
      "start": 6369.92,
      "end": 6371.92,
      "formatted_start": "01:46:09.920",
      "formatted_end": "01:46:11.920",
      "text": "آره"
    },
    {
      "id": 13,
      "start": 6371.92,
      "end": 6375.92,
      "formatted_start": "01:46:11.920",
      "formatted_end": "01:46:15.920",
      "text": "ما سه نفر ببینیم"
    },
    {
      "id": 14,
      "start": 6375.92,
      "end": 6378.92,
      "formatted_start": "01:46:15.920",
      "formatted_end": "01:46:18.920",
      "text": "خانم دکتر شما ما از اول هم باهم بودیم"
    },
    {
      "id": 15,
      "start": 6378.92,
      "end": 6382.92,
      "formatted_start": "01:46:18.920",
      "formatted_end": "01:46:22.920",
      "text": "ما از اول باهم اومدیم و دوست داشتیم بیمارسان پیشتر کنیم"
    },
    {
      "id": 16,
      "start": 6382.92,
      "end": 6386.16,
      "formatted_start": "01:46:22.920",
      "formatted_end": "01:46:26.160",
      "text": "بیمارسان جدید ساخته بشه و تشنرش کن بشه"
    },
    {
      "id": 17,
      "start": 6389.54,
      "end": 6391.04,
      "formatted_start": "01:46:29.540",
      "formatted_end": "01:46:31.040",
      "text": "اون منفی میگه دیگه"
    },
    {
      "id": 18,
      "start": 6391.06,
      "end": 6392.46,
      "formatted_start": "01:46:31.060",
      "formatted_end": "01:46:32.460",
      "text": "اون میخواد آفرین"
    },
    {
      "id": 19,
      "start": 6392.48,
      "end": 6394.68,
      "formatted_start": "01:46:32.480",
      "formatted_end": "01:46:34.680",
      "text": "منفی میگه نه نه نه"
    },
    {
      "id": 20,
      "start": 6394.94,
      "end": 6396.86,
      "formatted_start": "01:46:34.940",
      "formatted_end": "01:46:36.860",
      "text": "نه آفرین اون داره رو حرف کنه"
    },
    {
      "id": 21,
      "start": 6399.42,
      "end": 6400.08,
      "formatted_start": "01:46:39.420",
      "formatted_end": "01:46:40.080",
      "text": "حالا"
    },
    {
      "id": 22,
      "start": 6402.86,
      "end": 6404.9,
      "formatted_start": "01:46:42.860",
      "formatted_end": "01:46:44.900",
      "text": "خاندکتر یه نفر شروع کنه"
    },
    {
      "id": 23,
      "start": 6404.92,
      "end": 6407.16,
      "formatted_start": "01:46:44.920",
      "formatted_end": "01:46:47.160",
      "text": "یه آرماتور برنده یه نفر تمام کنه"
    },
    {
      "id": 24,
      "start": 6407.68,
      "end": 6411.32,
      "formatted_start": "01:46:47.680",
      "formatted_end": "01:46:51.320",
      "text": "یه بامی میاد سی ست میلیاردی جایی چیزی برقال"
    },
    {
      "id": 25,
      "start": 6411.5,
      "end": 6412.32,
      "formatted_start": "01:46:51.500",
      "formatted_end": "01:46:52.320",
      "text": "میاد سا"
    },
    {
      "id": 26,
      "start": 6412.92,
      "end": 6419.92,
      "formatted_start": "01:46:52.920",
      "formatted_end": "01:46:59.920",
      "text": "نه خب برام یک امیدی یک چشمندازی به وجود میاد"
    },
    {
      "id": 27,
      "start": 6419.92,
      "end": 6422.92,
      "formatted_start": "01:46:59.920",
      "formatted_end": "01:47:02.920",
      "text": "الان یک نفر بگه بیمارستان تقدیم بگه ما باید اونو میسازیم فرصت بده"
    },
    {
      "id": 28,
      "start": 6422.92,
      "end": 6425.92,
      "formatted_start": "01:47:02.920",
      "formatted_end": "01:47:05.920",
      "text": "آه برو نگاه کن شروع کردیم اینا خب"
    },
    {
      "id": 29,
      "start": 6425.92,
      "end": 6428.92,
      "formatted_start": "01:47:05.920",
      "formatted_end": "01:47:08.920",
      "text": "بس سیچه مریاد دادیم حداقل اسکلت رو میتونیم"
    },
    {
      "id": 30,
      "start": 6428.92,
      "end": 6434.92,
      "formatted_start": "01:47:08.920",
      "formatted_end": "01:47:14.920",
      "text": "آره یک سال چون یه سال اول ما ساخته اون قبلی رو داشتیم"
    },
    {
      "id": 31,
      "start": 6434.92,
      "end": 6438.92,
      "formatted_start": "01:47:14.920",
      "formatted_end": "01:47:18.920",
      "text": "یعنی هم خودمون بیم بعد یه سال بعد اومدیم رو کوی پولیس"
    },
    {
      "id": 32,
      "start": 6438.92,
      "end": 6441.52,
      "formatted_start": "01:47:18.920",
      "formatted_end": "01:47:21.520",
      "text": "و توی مدت الان به فاظ آخر بستیم"
    },
    {
      "id": 33,
      "start": 6441.52,
      "end": 6445.08,
      "formatted_start": "01:47:21.520",
      "formatted_end": "01:47:25.080",
      "text": "اینون زیگیل حکمش بیاد با پول همه سی چهرتو ما هست"
    },
    {
      "id": 34,
      "start": 6445.08,
      "end": 6448.08,
      "formatted_start": "01:47:25.080",
      "formatted_end": "01:47:28.080",
      "text": "میتونیم ببنیم حتی قرار اسکلیتو ببندیم"
    },
    {
      "id": 35,
      "start": 6448.08,
      "end": 6450.94,
      "formatted_start": "01:47:28.080",
      "formatted_end": "01:47:30.940",
      "text": "حالا بعد سهاندارا بیان جلو بیمارستان فروخته بشه"
    },
    {
      "id": 36,
      "start": 6450.94,
      "end": 6452.22,
      "formatted_start": "01:47:30.940",
      "formatted_end": "01:47:32.220",
      "text": "وام میگیریم"
    },
    {
      "id": 37,
      "start": 6452.22,
      "end": 6456.46,
      "formatted_start": "01:47:32.220",
      "formatted_end": "01:47:36.460",
      "text": "خلاصه پل پل سه طبقه رو حتی قرار ما میتونیم بردرداری کنیم"
    },
    {
      "id": 38,
      "start": 6456.46,
      "end": 6458.92,
      "formatted_start": "01:47:36.460",
      "formatted_end": "01:47:38.920",
      "text": "جده میگم تا سه طبقه از هفت طبقه رو میشه"
    },
    {
      "id": 39,
      "start": 6458.92,
      "end": 6460.7,
      "formatted_start": "01:47:38.920",
      "formatted_end": "01:47:40.700",
      "text": "بیمارستان منتقلش کرد"
    },
    {
      "id": 40,
      "start": 6460.7,
      "end": 6468.2,
      "formatted_start": "01:47:40.700",
      "formatted_end": "01:47:48.200",
      "text": "اونو ما آسانسور میزنیم، الان بسکه هم همینه، بعض طبقاتش بسته"
    },
    {
      "id": 41,
      "start": 6468.2,
      "end": 6473.2,
      "formatted_start": "01:47:48.200",
      "formatted_end": "01:47:53.200",
      "text": "بله، اون بالا با آسانسور میاد پایین"
    },
    {
      "id": 42,
      "start": 6473.2,
      "end": 6479.2,
      "formatted_start": "01:47:53.200",
      "formatted_end": "01:47:59.200",
      "text": "حالا به اقل اون رو فکرشون می کنیم، ولی من فکر می کنم که"
    },
    {
      "id": 43,
      "start": 6479.2,
      "end": 6483.2,
      "formatted_start": "01:47:59.200",
      "formatted_end": "01:48:03.200",
      "text": "حالا فقط کلین جلسته خب"
    },
    {
      "id": 44,
      "start": 6483.2,
      "end": 6488.76,
      "formatted_start": "01:48:03.200",
      "formatted_end": "01:48:08.760",
      "text": "مدیرین این کاری انجام بشه یعنی آدمی ضرورتشون این درخواهی رو نداریم"
    },
    {
      "id": 45,
      "start": 6488.76,
      "end": 6495.36,
      "formatted_start": "01:48:08.760",
      "formatted_end": "01:48:15.360",
      "text": "خب دکتر در مورد ساخت بیمارستان الان اون موردوی علاقه بودیم دارد چیز بودن افرادی بودن کمک کنن"
    },
    {
      "id": 46,
      "start": 6495.36,
      "end": 6502.02,
      "formatted_start": "01:48:15.360",
      "formatted_end": "01:48:22.020",
      "text": "ولی الان فقط من دارم حرفش میزنم خودم بودم دیگه همه اینکار رو خاموش کردن"
    },
    {
      "id": 47,
      "start": 6502.02,
      "end": 6510.48,
      "formatted_start": "01:48:22.020",
      "formatted_end": "01:48:30.480",
      "text": "خب و من میخوام دومده یک تیپای جدیدی بیانیم با انگیزه تر خب و این کار را راه بندازیم"
    },
    {
      "id": 48,
      "start": 6510.48,
      "end": 6514.4,
      "formatted_start": "01:48:30.480",
      "formatted_end": "01:48:34.400",
      "text": "نخواهه چون الان زیر ساختار رو داریم همین چیزش آماده"
    },
    {
      "id": 49,
      "start": 6514.42,
      "end": 6519.04,
      "formatted_start": "01:48:34.420",
      "formatted_end": "01:48:39.040",
      "text": "نقشه پروانه هیچ چیز آقا هیچ چیز اینا نمیخوام بسازن"
    },
    {
      "id": 50,
      "start": 6519.52,
      "end": 6523.86,
      "formatted_start": "01:48:39.520",
      "formatted_end": "01:48:43.860",
      "text": "اینها تیپای منفع طلب دنبال منافع شخصی خودشونن"
    },
    {
      "id": 51,
      "start": 6524.16,
      "end": 6524.76,
      "formatted_start": "01:48:44.160",
      "formatted_end": "01:48:44.760",
      "text": "خوب"
    },
    {
      "id": 52,
      "start": 6528.2,
      "end": 6532.6,
      "formatted_start": "01:48:48.200",
      "formatted_end": "01:48:52.600",
      "text": "من نمیدونم من خودم من نمیدونم بازم دنبال منفعاتهای چیزیشونن"
    },
    {
      "id": 53,
      "start": 6532.8,
      "end": 6536.84,
      "formatted_start": "01:48:52.800",
      "formatted_end": "01:48:56.840",
      "text": "از ویز و دروش از خیلی چیزا خوب الان"
    },
    {
      "id": 54,
      "start": 6536.84,
      "end": 6549.04,
      "formatted_start": "01:48:56.840",
      "formatted_end": "01:49:09.040",
      "text": "از دست درست دیدن ها چیز درم این ها ببینید الان دو که پاشایی بگو که اگر منو چیز کنید من میخوام حق و مسئولیت هم ست ویست میلیونه بگیرم مثلا اون حق"
    },
    {
      "id": 55,
      "start": 6549.04,
      "end": 6554.48,
      "formatted_start": "01:49:09.040",
      "formatted_end": "01:49:14.480",
      "text": "آره مثلا اگر من از مدیران بیر نباشم این پولو میخوام خب ببینید آره"
    },
    {
      "id": 56,
      "start": 6554.48,
      "end": 6560.64,
      "formatted_start": "01:49:14.480",
      "formatted_end": "01:49:20.640",
      "text": "آره آره چیز نداره الان شست و دو میلیون حق میگیره در ما"
    },
    {
      "id": 57,
      "start": 6560.64,
      "end": 6565.64,
      "formatted_start": "01:49:20.640",
      "formatted_end": "01:49:25.640",
      "text": "62 میلیون نوشته حقوق و حق مسئولیت"
    },
    {
      "id": 58,
      "start": 6565.64,
      "end": 6568.64,
      "formatted_start": "01:49:25.640",
      "formatted_end": "01:49:28.640",
      "text": "من افراد نیمیدونم 62 میلیون چیزی نیست"
    },
    {
      "id": 59,
      "start": 6568.64,
      "end": 6570.64,
      "formatted_start": "01:49:28.640",
      "formatted_end": "01:49:30.640",
      "text": "این سری متواجد شدم"
    },
    {
      "id": 60,
      "start": 6570.64,
      "end": 6574.64,
      "formatted_start": "01:49:30.640",
      "formatted_end": "01:49:34.640",
      "text": "چون حقوق های 40-50 توم هم فیشتر نیست"
    },
    {
      "id": 61,
      "start": 6574.64,
      "end": 6577.64,
      "formatted_start": "01:49:34.640",
      "formatted_end": "01:49:37.640",
      "text": "بعد هم یه تایمای اصلا نیستن اینا"
    },
    {
      "id": 62,
      "start": 6577.64,
      "end": 6579.64,
      "formatted_start": "01:49:37.640",
      "formatted_end": "01:49:39.640",
      "text": "9 میاد 12-1 میره"
    },
    {
      "id": 63,
      "start": 6579.64,
      "end": 6581.64,
      "formatted_start": "01:49:39.640",
      "formatted_end": "01:49:41.640",
      "text": "خب فعال اصلا اونقدر چیز نیستم"
    },
    {
      "id": 64,
      "start": 6581.64,
      "end": 6585.64,
      "formatted_start": "01:49:41.640",
      "formatted_end": "01:49:45.640",
      "text": "بیمارستان را چه دفعه میتونه اگر اینس پاز بره"
    },
    {
      "id": 65,
      "start": 6585.64,
      "end": 6600.0,
      "formatted_start": "01:49:45.640",
      "formatted_end": "01:50:00.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برد"
    }
