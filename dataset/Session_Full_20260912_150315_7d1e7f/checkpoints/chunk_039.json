  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11729.98,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:29.980",
      "text": "باید بردارو بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 11730.0,
      "end": 11732.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:32.000",
      "text": "آهان خوب"
    },
    {
      "id": 2,
      "start": 11732.0,
      "end": 11734.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:34.000",
      "text": "خب"
    },
    {
      "id": 3,
      "start": 11734.0,
      "end": 11736.0,
      "formatted_start": "03:15:34.000",
      "formatted_end": "03:15:36.000",
      "text": "باش درست داریم"
    },
    {
      "id": 4,
      "start": 11736.0,
      "end": 11738.0,
      "formatted_start": "03:15:36.000",
      "formatted_end": "03:15:38.000",
      "text": "باش درست داریم نچهاریم"
    },
    {
      "id": 5,
      "start": 11738.0,
      "end": 11740.0,
      "formatted_start": "03:15:38.000",
      "formatted_end": "03:15:40.000",
      "text": "نچهاریم"
    },
    {
      "id": 6,
      "start": 11740.0,
      "end": 11742.0,
      "formatted_start": "03:15:40.000",
      "formatted_end": "03:15:42.000",
      "text": "نخواهش میکنم نچهاریم"
    },
    {
      "id": 7,
      "start": 11742.0,
      "end": 11744.0,
      "formatted_start": "03:15:42.000",
      "formatted_end": "03:15:44.000",
      "text": "نخواهش میکنم نچهاریم"
    },
    {
      "id": 8,
      "start": 11744.0,
      "end": 11746.0,
      "formatted_start": "03:15:44.000",
      "formatted_end": "03:15:46.000",
      "text": "در این حال من هر سری زمین با خونجام"
    },
    {
      "id": 9,
      "start": 11746.0,
      "end": 11748.0,
      "formatted_start": "03:15:46.000",
      "formatted_end": "03:15:48.000",
      "text": "در این حال من هر سری زمین با خونجام"
    },
    {
      "id": 10,
      "start": 11748.0,
      "end": 11750.0,
      "formatted_start": "03:15:48.000",
      "formatted_end": "03:15:50.000",
      "text": "چون من کمان هر سری درست بکنی شاید"
    },
    {
      "id": 11,
      "start": 11750.0,
      "end": 11752.0,
      "formatted_start": "03:15:50.000",
