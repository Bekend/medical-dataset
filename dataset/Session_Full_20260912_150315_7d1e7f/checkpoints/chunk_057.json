  "stt_segments": [
    {
      "id": 0,
      "start": 17100.0,
      "end": 17130.0,
      "formatted_start": "04:45:00.000",
      "formatted_end": "04:45:30.000",
      "text": "اینجا باید باید بیمار بیمار در مطب پزشکی، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نسخه، نس"
    },
    {
      "id": 1,
      "start": 17130.0,
      "end": 17154.0,
      "formatted_start": "04:45:30.000",
      "formatted_end": "04:45:54.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 17154.0,
      "end": 17156.0,
      "formatted_start": "04:45:54.000",
      "formatted_end": "04:45:56.000",
      "text": "خیلی عالی، تمام، بگیر"
    },
    {
      "id": 3,
      "start": 17156.0,
      "end": 17157.0,
      "formatted_start": "04:45:56.000",
      "formatted_end": "04:45:57.000",
      "text": "جانم مامان جلو"
    },
    {
      "id": 4,
      "start": 17157.0,
      "end": 17158.0,
      "formatted_start": "04:45:57.000",
      "formatted_end": "04:45:58.000",
      "text": "بگیر بگیر"
    },
    {
      "id": 5,
      "start": 17158.0,
      "end": 17159.0,
      "formatted_start": "04:45:58.000",
      "formatted_end": "04:45:59.000",
      "text": "باید شما درک کنید درک"
    },
    {
      "id": 6,
      "start": 17159.0,
      "end": 17160.0,
      "formatted_start": "04:45:59.000",
      "formatted_end": "04:46:00.000",
      "text": "خدا فراموش"
    },
    {
      "id": 7,
      "start": 17160.0,
      "end": 17161.0,
      "formatted_start": "04:46:00.000",
      "formatted_end": "04:46:01.000",
      "text": "خدا فراموش"
    },
    {
      "id": 8,
      "start": 17161.0,
      "end": 17163.0,
      "formatted_start": "04:46:01.000",
      "formatted_end": "04:46:03.000",
      "text": "در باز باشید"
    },
    {
      "id": 9,
      "start": 17170.0,
      "end": 17171.0,
      "formatted_start": "04:46:10.000",
      "formatted_end": "04:46:11.000",
      "text": "بخواندید"
    },
    {
      "id": 10,
      "start": 17172.0,
      "end": 17175.0,
      "formatted_start": "04:46:12.000",
      "formatted_end": "04:46:15.000",
      "text": "این طلبت روزی سه بار، کاشوها"
    },
    {
      "id": 11,
      "start": 17175.0,
      "end": 17178.0,
      "formatted_start": "04:46:15.000",
      "formatted_end": "04:46:18.000",
      "text": "کاشوهای مارفاپولی، نیشیاف"
    },
    {
      "id": 12,
      "start": 17178.0,
      "end": 17180.0,
      "formatted_start": "04:46:18.000",
      "formatted_end": "04:46:20.000",
      "text": "اگر شکمشی بشکرم نکرد، یه دونه بزنید"
    },
    {
      "id": 13,
      "start": 17180.0,
      "end": 17181.0,
      "formatted_start": "04:46:20.000",
      "formatted_end": "04:46:21.000",
      "text": "خیلی خوانشون"
    },
    {
      "id": 14,
      "start": 17181.0,
      "end": 17183.0,
      "formatted_start": "04:46:21.000",
      "formatted_end": "04:46:23.000",
      "text": "نه، نه، نه، خواهیم نمیخواهیم"
    },
    {
      "id": 15,
      "start": 17183.0,
      "end": 17185.0,
      "formatted_start": "04:46:23.000",
      "formatted_end": "04:46:25.000",
      "text": "باشه من منفضم"
    },
    {
      "id": 16,
      "start": 17185.0,
      "end": 17187.0,
      "formatted_start": "04:46:25.000",
      "formatted_end": "04:46:27.000",
      "text": "باشه من منفضم"
    },
    {
      "id": 17,
      "start": 17187.0,
      "end": 17189.0,
      "formatted_start": "04:46:27.000",
      "formatted_end": "04:46:29.000",
      "text": "در باز باشه"
    },
    {
      "id": 18,
      "start": 17195.0,
      "end": 17197.0,
      "formatted_start": "04:46:35.000",
      "formatted_end": "04:46:37.000",
      "text": "بله خب"
    },
    {
      "id": 19,
      "start": 17197.0,
      "end": 17199.0,
      "formatted_start": "04:46:37.000",
      "formatted_end": "04:46:39.000",
      "text": "تام سمیر"
    },
    {
      "id": 20,
      "start": 17199.0,
      "end": 17201.0,
      "formatted_start": "04:46:39.000",
      "formatted_end": "04:46:41.000",
      "text": "این چیزهای جدیدی بفردن طرفها رو دیگه"
    },
    {
      "id": 21,
      "start": 17201.0,
      "end": 17203.0,
      "formatted_start": "04:46:41.000",
      "formatted_end": "04:46:43.000",
      "text": "آره بله"
    },
    {
      "id": 22,
      "start": 17203.0,
      "end": 17205.0,
      "formatted_start": "04:46:43.000",
      "formatted_end": "04:46:45.000",
      "text": "بفهمی خواهشم"
    },
    {
      "id": 23,
      "start": 17205.0,
      "end": 17207.0,
      "formatted_start": "04:46:45.000",
      "formatted_end": "04:46:47.000",
      "text": "درده باشه"
    },
    {
      "id": 24,
      "start": 17207.0,
      "end": 17209.0,
      "formatted_start": "04:46:47.000",
      "formatted_end": "04:46:49.000",
      "text": "اون برگره بیزنه"
    },
    {
      "id": 25,
      "start": 17209.0,
      "end": 17211.0,
      "formatted_start": "04:46:49.000",
      "formatted_end": "04:46:51.000",
      "text": "خدمت شما"
    },
    {
      "id": 26,
      "start": 17211.0,
      "end": 17213.0,
      "formatted_start": "04:46:51.000",
      "formatted_end": "04:46:53.000",
      "text": "کاره چی شده؟"
    },
    {
      "id": 27,
      "start": 17213.0,
      "end": 17215.0,
      "formatted_start": "04:46:53.000",
      "formatted_end": "04:46:55.000",
      "text": "دکتر انگلی داره"
    },
    {
      "id": 28,
      "start": 17215.0,
      "end": 17217.0,
      "formatted_start": "04:46:55.000",
      "formatted_end": "04:46:57.000",
      "text": "کرمک؟"
    },
    {
      "id": 29,
      "start": 17217.0,
      "end": 17219.0,
      "formatted_start": "04:46:57.000",
      "formatted_end": "04:46:59.000",
      "text": "بله، هیچی هم نمیخوره"
    },
    {
      "id": 30,
      "start": 17219.0,
      "end": 17221.0,
      "formatted_start": "04:46:59.000",
      "formatted_end": "04:47:01.000",
      "text": "کرمای ریز سفیده؟"
    },
    {
      "id": 31,
      "start": 17221.0,
      "end": 17223.0,
      "formatted_start": "04:47:01.000",
      "formatted_end": "04:47:03.000",
      "text": "شبها مغدشو میخورونه؟"
    },
    {
      "id": 32,
      "start": 17223.0,
      "end": 17225.0,
      "formatted_start": "04:47:03.000",
      "formatted_end": "04:47:05.000",
      "text": "به نظرت، خیلی کم"
    },
    {
      "id": 33,
      "start": 17225.0,
      "end": 17227.0,
      "formatted_start": "04:47:05.000",
      "formatted_end": "04:47:07.000",
      "text": "بی اشتراه هم شده؟"
    },
    {
      "id": 34,
      "start": 17227.0,
      "end": 17229.0,
      "formatted_start": "04:47:07.000",
      "formatted_end": "04:47:09.000",
      "text": "بی اشتراه هستم، اصلا غذا درست همون چی نیست"
    },
    {
      "id": 35,
      "start": 17229.0,
      "end": 17231.0,
      "formatted_start": "04:47:09.000",
      "formatted_end": "04:47:11.000",
      "text": "دلدرد اینا نداره؟"
    },
    {
      "id": 36,
      "start": 17231.0,
      "end": 17233.0,
      "formatted_start": "04:47:11.000",
      "formatted_end": "04:47:13.000",
      "text": "دلدرد نه"
    },
    {
      "id": 37,
      "start": 17233.0,
      "end": 17235.0,
      "formatted_start": "04:47:13.000",
      "formatted_end": "04:47:15.000",
      "text": "دلدرد نداره"
    },
    {
      "id": 38,
      "start": 17237.0,
      "end": 17239.0,
      "formatted_start": "04:47:17.000",
      "formatted_end": "04:47:19.000",
      "text": "خیلی به خوش میذاره"
    },
    {
      "id": 39,
      "start": 17241.0,
      "end": 17247.0,
      "formatted_start": "04:47:21.000",
      "formatted_end": "04:47:27.000",
      "text": "اینجا درداره"
    },
    {
      "id": 40,
      "start": 17247.0,
      "end": 17253.0,
      "formatted_start": "04:47:27.000",
      "formatted_end": "04:47:33.000",
      "text": "اینجا"
    },
    {
      "id": 41,
      "start": 17253.0,
      "end": 17257.0,
      "formatted_start": "04:47:33.000",
      "formatted_end": "04:47:37.000",
      "text": "چند نفر با اونجا نگیر کنید؟"
    },
    {
      "id": 42,
      "start": 17257.0,
      "end": 17261.0,
      "formatted_start": "04:47:37.000",
      "formatted_end": "04:47:41.000",
      "text": "چهار نفره، یه دختر پچیک داره"
    },
    {
      "id": 43,
      "start": 17261.0,
      "end": 17265.0,
      "formatted_start": "04:47:41.000",
      "formatted_end": "04:47:45.000",
      "text": "چهار نفره؟"
    },
    {
      "id": 44,
      "start": 17265.0,
      "end": 17267.0,
      "formatted_start": "04:47:45.000",
      "formatted_end": "04:47:47.000",
      "text": "باید بشین"
    },
    {
      "id": 45,
      "start": 17269.0,
      "end": 17273.0,
      "formatted_start": "04:47:49.000",
      "formatted_end": "04:47:53.000",
      "text": "این، بله، گرمش هم افتحاف داره"
    },
    {
      "id": 46,
      "start": 17276.0,
      "end": 17281.0,
      "formatted_start": "04:47:56.000",
      "formatted_end": "04:48:01.000",
      "text": "یکم حدود بیاد می کنید که کرمکشو باید دارو منوی می بیسم"
    },
    {
      "id": 47,
      "start": 17281.0,
      "end": 17287.0,
      "formatted_start": "04:48:01.000",
      "formatted_end": "04:48:07.000",
      "text": "ولی برای اشتعاش، حلوله نخوره، یک شروط راسیب می بیسم"
    },
    {
      "id": 48,
      "start": 17289.0,
      "end": 17292.0,
      "formatted_start": "04:48:09.000",
      "formatted_end": "04:48:12.000",
      "text": "شروط مترونی دازور، چند نفر بفتیم؟"
    },
    {
      "id": 49,
      "start": 17292.0,
      "end": 17293.0,
      "formatted_start": "04:48:12.000",
      "formatted_end": "04:48:13.000",
      "text": "زنی چونه؟"
    },
    {
      "id": 50,
      "start": 17293.0,
      "end": 17294.0,
      "formatted_start": "04:48:13.000",
      "formatted_end": "04:48:14.000",
      "text": "دختر ششمو هم دارن"
    },
    {
      "id": 51,
      "start": 17294.0,
      "end": 17295.0,
      "formatted_start": "04:48:14.000",
      "formatted_end": "04:48:15.000",
      "text": "زن باردار هم دارین؟"
    },
    {
      "id": 52,
      "start": 17295.0,
      "end": 17297.0,
      "formatted_start": "04:48:15.000",
      "formatted_end": "04:48:17.000",
      "text": "نه شیرده"
    },
    {
      "id": 53,
      "start": 17299.0,
      "end": 17301.0,
      "formatted_start": "04:48:19.000",
      "formatted_end": "04:48:21.000",
      "text": "چون باید همه دارو بخورن؟"
    },
    {
      "id": 54,
      "start": 17301.0,
      "end": 17303.0,
      "formatted_start": "04:48:21.000",
      "formatted_end": "04:48:23.000",
      "text": "چون اینکه خونه بچه جشنه مشکل نداره"
    },
    {
      "id": 55,
      "start": 17303.0,
      "end": 17305.0,
      "formatted_start": "04:48:23.000",
      "formatted_end": "04:48:25.000",
      "text": "نه برای زن باردار مشکل داره شیرده نداره"
    },
    {
      "id": 56,
      "start": 17305.0,
      "end": 17307.0,
      "formatted_start": "04:48:25.000",
      "formatted_end": "04:48:27.000",
      "text": "این تو قدیر ارسی و شروطی"
    },
    {
      "id": 57,
      "start": 17307.0,
      "end": 17309.0,
      "formatted_start": "04:48:27.000",
      "formatted_end": "04:48:29.000",
      "text": "این ارسی شروطش بیدار نمیشه"
    },
    {
      "id": 58,
      "start": 17309.0,
      "end": 17311.0,
      "formatted_start": "04:48:29.000",
      "formatted_end": "04:48:31.000",
      "text": "این ارس واقعیت من داده نکردم"
    },
    {
      "id": 59,
      "start": 17313.0,
      "end": 17315.0,
      "formatted_start": "04:48:33.000",
      "formatted_end": "04:48:35.000",
      "text": "این هم شروطش بیداری"
    },
    {
      "id": 60,
      "start": 17315.0,
      "end": 17317.0,
      "formatted_start": "04:48:35.000",
      "formatted_end": "04:48:37.000",
      "text": "شروطش بیداری"
    },
    {
      "id": 61,
      "start": 17317.0,
      "end": 17319.4,
      "formatted_start": "04:48:37.000",
      "formatted_end": "04:48:39.400",
      "text": "بس اینها رو بزار همه رو توی یک مسئله بیمیسن"
    },
    {
      "id": 62,
      "start": 17319.4,
      "end": 17322.76,
      "formatted_start": "04:48:39.400",
      "formatted_end": "04:48:42.760",
      "text": "چون بعد یه شعبتش بیمیم که خودت قیمت نده"
    },
    {
      "id": 63,
      "start": 17326.2,
      "end": 17327.2,
      "formatted_start": "04:48:46.200",
      "formatted_end": "04:48:47.200",
      "text": "ببین"
    },
    {
      "id": 64,
      "start": 17329.2,
      "end": 17330.64,
      "formatted_start": "04:48:49.200",
      "formatted_end": "04:48:50.640",
      "text": "داروخان... کجا میشینیم؟"
    },
    {
      "id": 65,
      "start": 17330.64,
      "end": 17331.6,
      "formatted_start": "04:48:50.640",
      "formatted_end": "04:48:51.600",
      "text": "یه رسته میشین"
    },
    {
      "id": 66,
      "start": 17331.6,
      "end": 17332.4,
      "formatted_start": "04:48:51.600",
      "formatted_end": "04:48:52.400",
      "text": "مثل..."
    },
    {
      "id": 67,
      "start": 17332.4,
      "end": 17333.08,
      "formatted_start": "04:48:52.400",
      "formatted_end": "04:48:53.080",
      "text": "بلزکیت"
    },
    {
      "id": 68,
      "start": 17333.08,
      "end": 17336.08,
      "formatted_start": "04:48:53.080",
      "formatted_end": "04:48:56.080",
      "text": "این داروخانهای مثلا شهرهای بزرگ پیدا میده"
    },
    {
      "id": 69,
      "start": 17336.8,
      "end": 17339.48,
      "formatted_start": "04:48:56.800",
      "formatted_end": "04:48:59.480",
      "text": "مثل خان ببین، دلم، موده، آمینان"
    },
    {
      "id": 70,
      "start": 17339.48,
      "end": 17340.48,
      "formatted_start": "04:48:59.480",
      "formatted_end": "04:49:00.480",
      "text": "اینا میتونید"
    },
    {
      "id": 71,
      "start": 17340.48,
      "end": 17342.28,
      "formatted_start": "04:49:00.480",
      "formatted_end": "04:49:02.280",
      "text": "این شعبته پیدا کنید"
    },
    {
      "id": 72,
      "start": 17342.28,
      "end": 17344.04,
      "formatted_start": "04:49:02.280",
      "formatted_end": "04:49:04.040",
      "text": "مشابهش نده"
    },
    {
      "id": 73,
      "start": 17347.0,
      "end": 17354.74,
      "formatted_start": "04:49:07.000",
      "formatted_end": "04:49:14.740",
      "text": "این دومی که من اونجا نوشتم"
    },
    {
      "id": 74,
      "start": 17354.74,
      "end": 17358.72,
      "formatted_start": "04:49:14.740",
      "formatted_end": "04:49:18.720",
      "text": "این رقیب بخواهدن چیزه بگو همه را بده"
    },
    {
      "id": 75,
      "start": 17358.72,
      "end": 17360.76,
      "formatted_start": "04:49:18.720",
      "formatted_end": "04:49:20.760",
      "text": "مثلا چیز نکنه"
    },
    {
      "id": 76,
      "start": 17360.76,
      "end": 17362.46,
      "formatted_start": "04:49:20.760",
      "formatted_end": "04:49:22.460",
      "text": "ناقص نده"
    },
    {
      "id": 77,
      "start": 17362.46,
      "end": 17364.72,
      "formatted_start": "04:49:22.460",
      "formatted_end": "04:49:24.720",
      "text": "مدردگی این"
    },
    {
      "id": 78,
      "start": 17364.72,
      "end": 17367.34,
      "formatted_start": "04:49:24.720",
      "formatted_end": "04:49:27.340",
      "text": "انا دومی برای این خیلی مهمی دارست"
    },
    {
      "id": 79,
      "start": 17367.34,
      "end": 17368.06,
      "formatted_start": "04:49:27.340",
      "formatted_end": "04:49:28.060",
      "text": "آفرین باید"
    },
    {
      "id": 80,
      "start": 17368.06,
      "end": 17369.56,
      "formatted_start": "04:49:28.060",
      "formatted_end": "04:49:29.560",
      "text": "دو نوشتم برمیز"
    },
    {
      "id": 81,
      "start": 17369.56,
      "end": 17371.22,
      "formatted_start": "04:49:29.560",
      "formatted_end": "04:49:31.220",
      "text": "این خیلی مهمی"
    },
    {
      "id": 82,
      "start": 17371.22,
      "end": 17374.74,
      "formatted_start": "04:49:31.220",
      "formatted_end": "04:49:34.740",
      "text": "این داروش رو بیادی من ببینم"
    },
    {
      "id": 83,
      "start": 17374.74,
      "end": 17376.74,
      "formatted_start": "04:49:34.740",
      "formatted_end": "04:49:36.740",
      "text": "نخواهید بشین"
    },
    {
      "id": 84,
      "start": 17376.74,
      "end": 17378.74,
      "formatted_start": "04:49:36.740",
      "formatted_end": "04:49:38.740",
      "text": "از اینجا باید برم برم"
    },
    {
      "id": 85,
      "start": 17378.74,
      "end": 17380.74,
      "formatted_start": "04:49:38.740",
      "formatted_end": "04:49:40.740",
      "text": "از اینجا باید برم برم"
    },
    {
      "id": 86,
      "start": 17380.74,
      "end": 17382.74,
      "formatted_start": "04:49:40.740",
      "formatted_end": "04:49:42.740",
      "text": "از اینجا برم برم"
    },
    {
      "id": 87,
      "start": 17382.74,
      "end": 17384.74,
      "formatted_start": "04:49:42.740",
      "formatted_end": "04:49:44.740",
