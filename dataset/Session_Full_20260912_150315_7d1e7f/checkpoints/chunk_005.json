      "formatted_start": "00:25:00.000",
      "formatted_end": "00:25:04.920",
      "text": "خیلی زیر معاینه پزشکی اینا خوب، دیگه تر میدونی بهتر. خدمت شما."
    },
    {
      "id": 1,
      "start": 1504.92,
      "end": 1506.2,
      "formatted_start": "00:25:04.920",
      "formatted_end": "00:25:06.200",
      "text": "اسامل فوند داری؟"
    },
    {
      "id": 2,
      "start": 1506.2,
      "end": 1507.0,
      "formatted_start": "00:25:06.200",
      "formatted_end": "00:25:07.000",
      "text": "بله."
    },
    {
      "id": 3,
      "start": 1507.0,
      "end": 1510.0,
      "formatted_start": "00:25:07.000",
      "formatted_end": "00:25:10.000",
      "text": "دیگه من نمیدونی. خدمت شما خوشی باشید."
    },
    {
      "id": 4,
      "start": 1510.0,
      "end": 1510.5,
      "formatted_start": "00:25:10.000",
      "formatted_end": "00:25:10.500",
      "text": "شکرم."
    },
    {
      "id": 5,
      "start": 1510.5,
      "end": 1511.5,
      "formatted_start": "00:25:10.500",
      "formatted_end": "00:25:11.500",
      "text": "مرسی خداحافظ."
    },
    {
      "id": 6,
      "start": 1530.0,
      "end": 1558.0,
      "formatted_start": "00:25:30.000",
      "formatted_end": "00:25:58.000",
