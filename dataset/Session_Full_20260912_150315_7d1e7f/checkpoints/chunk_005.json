      "end": 1757.0,
      "formatted_start": "00:29:16.000",
      "formatted_end": "00:29:17.000",
      "text": "بخوند"
    },
    {
      "id": 16,
      "start": 1757.0,
      "end": 1758.0,
      "formatted_start": "00:29:17.000",
      "formatted_end": "00:29:18.000",
      "text": "سلام"
    },
    {
      "id": 17,
      "start": 1758.0,
      "end": 1760.0,
      "formatted_start": "00:29:18.000",
      "formatted_end": "00:29:20.000",
      "text": "سلام بابا جایم سلامت باشی"
    },
    {
      "id": 18,
      "start": 1764.0,
      "end": 1766.0,
      "formatted_start": "00:29:24.000",
      "formatted_end": "00:29:26.000",
      "text": "دخترم یه نگاه بنده"
    },
    {
      "id": 19,
      "start": 1766.0,
      "end": 1768.0,
      "formatted_start": "00:29:26.000",
      "formatted_end": "00:29:28.000",
      "text": "بله چی شده دختر رو کنی؟"
    },
    {
      "id": 20,
      "start": 1768.0,
      "end": 1772.0,
      "formatted_start": "00:29:28.000",
      "formatted_end": "00:29:32.000",
      "text": "سرما کنم خود باز یکم خیلی خوزنه نمیدونم"
    },
    {
      "id": 21,
      "start": 1772.0,
      "end": 1774.0,
      "formatted_start": "00:29:32.000",
      "formatted_end": "00:29:34.000",
      "text": "خب سه میز چقدره؟"
    },
    {
      "id": 22,
      "start": 1774.0,
      "end": 1777.0,
      "formatted_start": "00:29:34.000",
      "formatted_end": "00:29:37.000",
      "text": "گرج سه شونده هم بدونم بابا"
    },
    {
      "id": 23,
      "start": 1777.0,
      "end": 1781.0,
      "formatted_start": "00:29:37.000",
      "formatted_end": "00:29:41.000",
      "text": "شونده سه، چهار، پنج، دو سه پنج"
    },
    {
      "id": 24,
      "start": 1781.0,
      "end": 1783.0,
      "formatted_start": "00:29:41.000",
      "formatted_end": "00:29:43.000",
      "text": "نه سه من نیست دیده پنج هم بود"
    },
    {
      "id": 25,
      "start": 1783.0,
      "end": 1789.0,
      "formatted_start": "00:29:43.000",
      "formatted_end": "00:29:49.000",
      "text": "برگ 3 هست؟ برگ چند؟ برگ چند؟ برگ 5 هست"
    },
    {
      "id": 26,
      "start": 1789.0,
      "end": 1791.0,
      "formatted_start": "00:29:49.000",
      "formatted_end": "00:29:51.000",
      "text": "برگ 5 هست"
    },
    {
      "id": 27,
      "start": 1791.0,
      "end": 1793.0,
      "formatted_start": "00:29:51.000",
      "formatted_end": "00:29:53.000",
      "text": "دو ماه همیشه نشونه"
    },
    {
      "id": 28,
      "start": 1793.0,
      "end": 1796.0,
      "formatted_start": "00:29:53.000",
      "formatted_end": "00:29:56.000",
      "text": "حالا مهم نیست دو ماه همیشه نشونه"
    },
    {
      "id": 29,
      "start": 1796.0,
      "end": 1798.0,
      "formatted_start": "00:29:56.000",
      "formatted_end": "00:29:58.000",
      "text": "حالا خس خس میکنه درسته؟"
    },
    {
      "id": 30,
      "start": 1798.0,
      "end": 1800.0,
      "formatted_start": "00:29:58.000",
      "formatted_end": "00:30:00.000",
      "text": "این رو بگم نتیجه"
    }
  ],
