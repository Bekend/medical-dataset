  "stt_segments": [
    {
      "id": 0,
      "start": 16200.0,
      "end": 16229.98,
      "formatted_start": "04:30:00.000",
      "formatted_end": "04:30:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 16230.0,
      "end": 16260.0,
      "formatted_start": "04:30:30.000",
      "formatted_end": "04:31:00.000",
      "text": "باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید ک"
    },
    {
      "id": 2,
      "start": 16260.0,
      "end": 16264.0,
      "formatted_start": "04:31:00.000",
      "formatted_end": "04:31:04.000",
      "text": "اینجا همین شکل داره"
    },
    {
      "id": 3,
      "start": 16264.0,
      "end": 16268.0,
      "formatted_start": "04:31:04.000",
      "formatted_end": "04:31:08.000",
      "text": "چی همون میشه؟"
    },
    {
      "id": 4,
      "start": 16268.0,
      "end": 16272.0,
      "formatted_start": "04:31:08.000",
      "formatted_end": "04:31:12.000",
      "text": "یک نیمه"
    },
    {
      "id": 5,
      "start": 16290.0,
      "end": 16292.0,
      "formatted_start": "04:31:30.000",
      "formatted_end": "04:31:32.000",
      "text": "برنامه"
    },
    {
      "id": 6,
      "start": 16297.6,
      "end": 16299.6,
      "formatted_start": "04:31:37.600",
      "formatted_end": "04:31:39.600",
      "text": "برگردی، اونکه همه چیز"
    },
    {
      "id": 7,
      "start": 16299.6,
      "end": 16300.96,
      "formatted_start": "04:31:39.600",
      "formatted_end": "04:31:40.960",
      "text": "مرسی"
    },
    {
      "id": 8,
      "start": 16300.96,
      "end": 16302.96,
      "formatted_start": "04:31:40.960",
      "formatted_end": "04:31:42.960",
      "text": "برگردی"
    },
    {
      "id": 9,
      "start": 16320.0,
      "end": 16334.0,
      "formatted_start": "04:32:00.000",
      "formatted_end": "04:32:14.000",
      "text": "بخونید برگر رو بزنید و بعد دیگه ماشین داده"
    },
    {
      "id": 10,
      "start": 16334.0,
      "end": 16338.0,
      "formatted_start": "04:32:14.000",
      "formatted_end": "04:32:18.000",
      "text": "خب چی شده خانم ادرایمی؟"
    },
    {
      "id": 11,
      "start": 16338.0,
      "end": 16342.0,
      "formatted_start": "04:32:18.000",
      "formatted_end": "04:32:22.000",
      "text": "خب از اینکه من مطاعتش کنم از چه دندر دارم خودش میپیچه"
    },
    {
      "id": 12,
      "start": 16342.0,
      "end": 16346.0,
      "formatted_start": "04:32:22.000",
      "formatted_end": "04:32:26.000",
      "text": "بعد شیر من مطاعتش رو هم سیرشنه میکنه"
    },
    {
      "id": 13,
      "start": 16346.0,
      "end": 16349.0,
      "formatted_start": "04:32:26.000",
      "formatted_end": "04:32:29.000",
      "text": "یک کمکی به شیر خوش کنه شده هم اپتامیل"
    },
    {
      "id": 14,
      "start": 16349.0,
      "end": 16358.0,
      "formatted_start": "04:32:29.000",
      "formatted_end": "04:32:38.000",
      "text": "بعد از پریش شکرش کار کرد تا امروز بعد از اونم اونم اوقات که شکرمش کار کنه خیلی نیستی به خودش پسار می آنه"
    },
    {
      "id": 15,
      "start": 16358.0,
      "end": 16361.0,
      "formatted_start": "04:32:38.000",
      "formatted_end": "04:32:41.000",
      "text": "سری چقدر؟"
    },
    {
      "id": 16,
      "start": 16361.0,
      "end": 16365.0,
      "formatted_start": "04:32:41.000",
      "formatted_end": "04:32:45.000",
      "text": "از اون سری ۱۱۰ روزشه سری قبلا که دخترم آورده بودش"
    },
    {
      "id": 17,
      "start": 16365.0,
      "end": 16368.0,
      "formatted_start": "04:32:45.000",
      "formatted_end": "04:32:48.000",
      "text": "همونانینی، دسیپنانین و کولیک"
    },
    {
      "id": 18,
      "start": 16368.0,
      "end": 16369.0,
      "formatted_start": "04:32:48.000",
      "formatted_end": "04:32:49.000",
      "text": "بهش الان میدیم؟"
    },
    {
      "id": 19,
      "start": 16369.0,
      "end": 16371.0,
      "formatted_start": "04:32:49.000",
      "formatted_end": "04:32:51.000",
      "text": "آره اینها هنوز هم"
    },
    {
      "id": 20,
      "start": 16371.0,
      "end": 16372.0,
      "formatted_start": "04:32:51.000",
      "formatted_end": "04:32:52.000",
      "text": "هر روز میدیم؟"
    },
    {
      "id": 21,
      "start": 16372.0,
      "end": 16373.0,
      "formatted_start": "04:32:52.000",
      "formatted_end": "04:32:53.000",
      "text": "آره هم"
    },
    {
      "id": 22,
      "start": 16373.0,
      "end": 16377.0,
      "formatted_start": "04:32:53.000",
      "formatted_end": "04:32:57.000",
      "text": "و اون سری که آورده بودیم بهش افاظت خوب کرد مثلا یه هفته در نزدیک"
    },
    {
      "id": 23,
      "start": 16377.0,
      "end": 16378.0,
      "formatted_start": "04:32:57.000",
      "formatted_end": "04:32:58.000",
      "text": "آره هم"
    },
    {
      "id": 24,
      "start": 16378.0,
      "end": 16380.0,
      "formatted_start": "04:32:58.000",
      "formatted_end": "04:33:00.000",
      "text": "از اینجا باید برداشتیم"
    },
    {
      "id": 25,
      "start": 16384.0,
      "end": 16386.0,
      "formatted_start": "04:33:04.000",
      "formatted_end": "04:33:06.000",
      "text": "برنامه شکمش از دیگرز کار نکرده؟"
    },
    {
      "id": 26,
      "start": 16386.0,
      "end": 16388.0,
      "formatted_start": "04:33:06.000",
      "formatted_end": "04:33:08.000",
      "text": "از فری شب"
    },
    {
      "id": 27,
      "start": 16388.0,
      "end": 16390.0,
      "formatted_start": "04:33:08.000",
      "formatted_end": "04:33:10.000",
      "text": "فری شب کار کرد"
    },
    {
      "id": 28,
      "start": 16390.0,
      "end": 16392.0,
      "formatted_start": "04:33:10.000",
      "formatted_end": "04:33:12.000",
      "text": "اما امروز برداشت"
    },
    {
      "id": 29,
      "start": 16392.0,
      "end": 16394.0,
      "formatted_start": "04:33:12.000",
      "formatted_end": "04:33:14.000",
      "text": "امروز برداشت کار کرده؟"
    },
    {
      "id": 30,
      "start": 16394.0,
      "end": 16396.0,
      "formatted_start": "04:33:14.000",
      "formatted_end": "04:33:16.000",
      "text": "آره"
    },
    {
      "id": 31,
      "start": 16396.0,
      "end": 16398.0,
      "formatted_start": "04:33:16.000",
      "formatted_end": "04:33:18.000",
      "text": "شیرو پشکن"
    },
    {
      "id": 32,
      "start": 16398.0,
      "end": 16400.0,
      "formatted_start": "04:33:18.000",
      "formatted_end": "04:33:20.000",
      "text": "باید کار می کنی شکمش"
    },
    {
      "id": 33,
      "start": 16400.0,
      "end": 16402.0,
      "formatted_start": "04:33:20.000",
      "formatted_end": "04:33:22.000",
      "text": "روز می دهید"
    },
    {
      "id": 34,
      "start": 16402.0,
      "end": 16404.0,
      "formatted_start": "04:33:22.000",
      "formatted_end": "04:33:24.000",
      "text": "و گوز می شود پرش"
    },
    {
      "id": 35,
      "start": 16404.0,
      "end": 16406.0,
      "formatted_start": "04:33:24.000",
      "formatted_end": "04:33:26.000",
      "text": "امیدواریم"
    },
    {
      "id": 36,
      "start": 16406.0,
      "end": 16408.0,
      "formatted_start": "04:33:26.000",
      "formatted_end": "04:33:28.000",
      "text": "شیر مادر هم میخوره دیگه"
    },
    {
      "id": 37,
      "start": 16408.0,
      "end": 16410.0,
      "formatted_start": "04:33:28.000",
      "formatted_end": "04:33:30.000",
      "text": "هم شیر مادر هم بیبون"
    },
    {
      "id": 38,
      "start": 16410.0,
      "end": 16414.0,
      "formatted_start": "04:33:30.000",
      "formatted_end": "04:33:34.000",
      "text": "میبینید هبوبات و لبنیات گاوی و بادم جنخی ها نباید بخوره"
    },
    {
      "id": 39,
      "start": 16414.0,
      "end": 16417.0,
      "formatted_start": "04:33:34.000",
      "formatted_end": "04:33:37.000",
      "text": "لبنیات ماز شیر پنجه کش"
    },
    {
      "id": 40,
      "start": 16417.0,
      "end": 16420.0,
      "formatted_start": "04:33:37.000",
      "formatted_end": "04:33:40.000",
      "text": "اینا سنگین و کاظه این داره"
    },
    {
      "id": 41,
      "start": 16420.0,
      "end": 16422.0,
      "formatted_start": "04:33:40.000",
      "formatted_end": "04:33:42.000",
      "text": "گاوی یا روزپندی باشه اشکال نداره"
    },
    {
      "id": 42,
      "start": 16422.0,
      "end": 16424.0,
      "formatted_start": "04:33:42.000",
      "formatted_end": "04:33:44.000",
      "text": "اینا از یک نیزه داره"
    },
    {
      "id": 43,
      "start": 16424.0,
      "end": 16426.0,
      "formatted_start": "04:33:44.000",
      "formatted_end": "04:33:46.000",
      "text": "یک کم آخریزی کنید"
    },
    {
      "id": 44,
      "start": 16426.0,
      "end": 16429.0,
      "formatted_start": "04:33:46.000",
      "formatted_end": "04:33:49.000",
      "text": "بگیری میشه بچه"
    },
    {
      "id": 45,
      "start": 16436.0,
      "end": 16438.0,
      "formatted_start": "04:33:56.000",
      "formatted_end": "04:33:58.000",
      "text": "این همین گلنج پیدا کرده"
    },
    {
      "id": 46,
      "start": 16438.0,
      "end": 16440.0,
      "formatted_start": "04:33:58.000",
      "formatted_end": "04:34:00.000",
      "text": "کلیک گرفته"
    },
    {
      "id": 47,
      "start": 16440.0,
      "end": 16444.0,
      "formatted_start": "04:34:00.000",
      "formatted_end": "04:34:04.000",
      "text": "خب شیطی میگه آرومشو بگیری"
    },
    {
      "id": 48,
      "start": 16444.0,
      "end": 16446.0,
      "formatted_start": "04:34:04.000",
      "formatted_end": "04:34:06.000",
      "text": "از نظر عصبی هم"
    },
    {
      "id": 49,
      "start": 16446.0,
      "end": 16448.0,
      "formatted_start": "04:34:06.000",
      "formatted_end": "04:34:08.000",
      "text": "آروم باشی"
    },
    {
      "id": 50,
      "start": 16448.0,
      "end": 16450.0,
      "formatted_start": "04:34:08.000",
      "formatted_end": "04:34:10.000",
      "text": "خب پسر میگذاره"
    },
    {
      "id": 51,
      "start": 16452.0,
      "end": 16454.0,
      "formatted_start": "04:34:12.000",
      "formatted_end": "04:34:14.000",
      "text": "و به نظر شما این شیرخوش آبتامیل هست نه؟"
    },
    {
      "id": 52,
      "start": 16454.0,
      "end": 16456.0,
      "formatted_start": "04:34:14.000",
      "formatted_end": "04:34:16.000",
      "text": "خب آبتامیل دارم بگیرم"
    },
    {
      "id": 53,
      "start": 16456.0,
      "end": 16458.0,
      "formatted_start": "04:34:16.000",
      "formatted_end": "04:34:18.000",
      "text": "خب این شیرخوش نیست"
    },
    {
      "id": 54,
      "start": 16458.0,
      "end": 16460.0,
      "formatted_start": "04:34:18.000",
      "formatted_end": "04:34:20.000",
      "text": "از شیرخوش نیست"
    },
    {
      "id": 55,
      "start": 16460.0,
      "end": 16462.0,
      "formatted_start": "04:34:20.000",
      "formatted_end": "04:34:22.000",
      "text": "از شیرخوش؟ نه"
    },
    {
      "id": 56,
      "start": 16462.0,
      "end": 16464.0,
      "formatted_start": "04:34:22.000",
      "formatted_end": "04:34:24.000",
      "text": "از شیر مادر و تقضی مادر و استرس مادر"
    },
    {
      "id": 57,
      "start": 16464.0,
      "end": 16466.0,
      "formatted_start": "04:34:24.000",
      "formatted_end": "04:34:26.000",
      "text": "سری اول نان"
    },
    {
      "id": 58,
      "start": 16466.0,
      "end": 16468.0,
      "formatted_start": "04:34:26.000",
      "formatted_end": "04:34:28.000",
      "text": "خب نانم دردن بازم آتن"
    },
    {
      "id": 59,
      "start": 16468.0,
      "end": 16470.0,
      "formatted_start": "04:34:28.000",
      "formatted_end": "04:34:30.000",
      "text": "نانم که درده بودیم"
    },
    {
      "id": 60,
      "start": 16470.0,
      "end": 16472.0,
      "formatted_start": "04:34:30.000",
      "formatted_end": "04:34:32.000",
      "text": "بلی شکمش اینجوری دیگه کار نمیکرد"
    },
    {
      "id": 61,
      "start": 16472.0,
      "end": 16474.0,
      "formatted_start": "04:34:32.000",
      "formatted_end": "04:34:34.000",
      "text": "که میزن دیر بریم"
    },
    {
      "id": 62,
      "start": 16474.0,
      "end": 16476.0,
      "formatted_start": "04:34:34.000",
      "formatted_end": "04:34:36.000",
      "text": "حالا مثلا یه مخته درستم"
    },
    {
      "id": 63,
      "start": 16476.0,
      "end": 16478.0,
      "formatted_start": "04:34:36.000",
      "formatted_end": "04:34:38.000",
      "text": "یه بار مثلا از قریشم تا اینو بزنیم"
    },
    {
      "id": 64,
      "start": 16478.0,
      "end": 16480.0,
      "formatted_start": "04:34:38.000",
      "formatted_end": "04:34:40.000",
      "text": "یه 24 ساعت 40 ساعتی"
    },
    {
      "id": 65,
      "start": 16480.0,
      "end": 16482.0,
      "formatted_start": "04:34:40.000",
      "formatted_end": "04:34:42.000",
      "text": "ممکنه بشه تا 34 روزم شکمش کار نبود"
    },
    {
      "id": 66,
      "start": 16482.0,
      "end": 16484.0,
      "formatted_start": "04:34:42.000",
      "formatted_end": "04:34:44.000",
      "text": "برد کار نبود"
    },
    {
      "id": 67,
      "start": 16484.0,
      "end": 16486.0,
      "formatted_start": "04:34:44.000",
      "formatted_end": "04:34:46.000",
      "text": "اگه تکرار شوونده شو"
    },
    {
      "id": 68,
      "start": 16486.0,
      "end": 16488.0,
      "formatted_start": "04:34:46.000",
      "formatted_end": "04:34:48.000",
      "text": "اون بگو ما دیدیم که مثلا دارونی"
    },
    {
      "id": 69,
      "start": 16488.0,
      "end": 16490.0,
      "formatted_start": "04:34:48.000",
      "formatted_end": "04:34:50.000",
      "text": "که خیلی سرس"
    },
    {
      "id": 70,
      "start": 16490.0,
      "end": 16493.0,
      "formatted_start": "04:34:50.000",
      "formatted_end": "04:34:53.000",
      "text": "ولی یه حالت پولیج هم بهش تست داده"
    },
    {
      "id": 71,
      "start": 16495.0,
      "end": 16497.0,
      "formatted_start": "04:34:55.000",
      "formatted_end": "04:34:57.000",
      "text": "بسیار خوششو عوض نکنم برای بینشتر"
    },
    {
      "id": 72,
      "start": 16497.0,
      "end": 16498.0,
      "formatted_start": "04:34:57.000",
      "formatted_end": "04:34:58.000",
      "text": "نه نه"
    }
  ],
  "status": "completed"
}