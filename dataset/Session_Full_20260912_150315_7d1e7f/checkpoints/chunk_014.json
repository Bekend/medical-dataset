  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4208.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:08.000",
      "text": "باشید، همین دستگاه به من شیم بگین خامسرانی، یه دو سه روزی دستگاه بگرید و خوب هم استفاده کنید، چون دسبتا زیاده."
    },
    {
      "id": 1,
      "start": 4210.0,
      "end": 4212.0,
      "formatted_start": "01:10:10.000",
      "formatted_end": "01:10:12.000",
      "text": "گریه زیاد میبونی یا کم؟"
    },
    {
      "id": 2,
      "start": 4213.0,
      "end": 4216.0,
      "formatted_start": "01:10:13.000",
      "formatted_end": "01:10:16.000",
      "text": "نه، اگه همین باید گریه نمیفونیم، از یه نمیتونیم."
    },
    {
      "id": 3,
      "start": 4216.0,
      "end": 4220.0,
      "formatted_start": "01:10:16.000",
      "formatted_end": "01:10:20.000",
      "text": "از اون پرس چیزی؟ پس حالا من یه شربت چیزتر نمیشم، چون نمیفهم هزینتون زیاده باشه."
    },
    {
      "id": 4,
      "start": 4221.0,
      "end": 4223.0,
      "formatted_start": "01:10:21.000",
      "formatted_end": "01:10:23.000",
      "text": "یه قرص و یه شربت..."
    },
    {
      "id": 5,
      "start": 4225.0,
      "end": 4227.0,
      "formatted_start": "01:10:25.000",
      "formatted_end": "01:10:27.000",
      "text": "این دستگاه اجاره چجوریه؟"
    },
    {
      "id": 6,
      "start": 4227.0,
      "end": 4230.2,
      "formatted_start": "01:10:27.000",
      "formatted_end": "01:10:30.200",
      "text": "این ها 24 ساعت 400 کم هست"
    },
    {
      "id": 7,
      "start": 4230.2,
      "end": 4232.58,
      "formatted_start": "01:10:30.200",
      "formatted_end": "01:10:32.580",
      "text": "از آزمایه چیزی اینا نداریم"
    },
    {
      "id": 8,
      "start": 4232.58,
      "end": 4235.08,
      "formatted_start": "01:10:32.580",
      "formatted_end": "01:10:35.080",
      "text": "دو شبان و سه شبان و روز باید برد"
    },
    {
      "id": 9,
      "start": 4235.08,
      "end": 4238.78,
      "formatted_start": "01:10:35.080",
      "formatted_end": "01:10:38.780",
      "text": "یه شبت عبوران اینه بشم"
    },
    {
      "id": 10,
      "start": 4238.78,
      "end": 4240.32,
      "formatted_start": "01:10:38.780",
      "formatted_end": "01:10:40.320",
      "text": "چون گفتیم درد نداریم"
    },
    {
      "id": 11,
      "start": 4240.32,
      "end": 4241.86,
      "formatted_start": "01:10:40.320",
      "formatted_end": "01:10:41.860",
      "text": "این ها زیاد دارو نمیشتن"
    },
    {
      "id": 12,
      "start": 4241.86,
      "end": 4244.0,
      "formatted_start": "01:10:41.860",
      "formatted_end": "01:10:44.000",
      "text": "دیگر نه اگر شدیده بگیم بلیسن"
    },
    {
      "id": 13,
      "start": 4244.78,
      "end": 4245.46,
      "formatted_start": "01:10:44.780",
      "formatted_end": "01:10:45.460",
      "text": "نه"
    },
    {
      "id": 14,
      "start": 4245.46,
      "end": 4250.12,
      "formatted_start": "01:10:45.460",
      "formatted_end": "01:10:50.120",
      "text": "خواهش میکنم خدا باشیم"
    },
    {
      "id": 15,
      "start": 4250.12,
      "end": 4254.28,
      "formatted_start": "01:10:50.120",
      "formatted_end": "01:10:54.280",
      "text": "نه گرمی باشید جوش میده"
    },
    {
      "id": 16,
      "start": 4254.28,
      "end": 4256.58,
      "formatted_start": "01:10:54.280",
      "formatted_end": "01:10:56.580",
      "text": "اگر قدنش کم تا جوش هست اون مهمیست"
    },
    {
      "id": 17,
      "start": 4256.58,
      "end": 4260.58,
      "formatted_start": "01:10:56.580",
      "formatted_end": "01:11:00.580",
      "text": "خواهاش اینا کالمدالا بذارید"
    },
    {
      "id": 18,
      "start": 4260.58,
      "end": 4265.58,
      "formatted_start": "01:11:00.580",
      "formatted_end": "01:11:05.580",
      "text": "یا این این یا کالمدالا ببینید کماده این این بیمیدید"
    },
    {
      "id": 19,
      "start": 4265.58,
      "end": 4272.58,
      "formatted_start": "01:11:05.580",
      "formatted_end": "01:11:12.580",
      "text": "کماده دری آم سی نو نول این این هر هشت ساعت مالید شده"
    },
    {
      "id": 20,
      "start": 4272.58,
      "end": 4274.58,
      "formatted_start": "01:11:12.580",
      "formatted_end": "01:11:14.580",
      "text": "این که از هم شما"
    },
    {
      "id": 21,
      "start": 4274.58,
      "end": 4278.58,
      "formatted_start": "01:11:14.580",
      "formatted_end": "01:11:18.580",
      "text": "آمس هم یه دو سه روز دستگاه بشون بیدید درم از هم برم"
    },
    {
      "id": 22,
      "start": 4286.58,
      "end": 4296.58,
      "formatted_start": "01:11:26.580",
      "formatted_end": "01:11:36.580",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 4316.58,
      "end": 4344.58,
      "formatted_start": "01:11:56.580",
      "formatted_end": "01:12:24.580",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 4344.58,
      "end": 4354.58,
      "formatted_start": "01:12:24.580",
      "formatted_end": "01:12:34.580",
      "text": "الو سلام خاندیست رو بسخانی برم ببخشید تماس گرفته بودید برای حقوق و پرسنل"
    },
    {
      "id": 25,
      "start": 4354.58,
      "end": 4358.58,
      "formatted_start": "01:12:34.580",
      "formatted_end": "01:12:38.580",
      "text": "بله گفتم که الان باید جلسه رو تشکیل بیدیم"
    },
    {
      "id": 26,
      "start": 4358.58,
      "end": 4364.58,
      "formatted_start": "01:12:38.580",
      "formatted_end": "01:12:44.580",
      "text": "بله بله دقیقا"
    },
    {
      "id": 27,
      "start": 4364.58,
      "end": 4369.58,
      "formatted_start": "01:12:44.580",
      "formatted_end": "01:12:49.580",
      "text": "نه فردا صبح چونکه دکتر شکیم فردا کشیگه"
    },
    {
      "id": 28,
      "start": 4369.58,
      "end": 4378.22,
      "formatted_start": "01:12:49.580",
      "formatted_end": "01:12:58.220",
      "text": "چون یک زمانی باشه، فقط ما دکتر مسعود رو من امیشه باید یا الان باید صحبت کنم"
    },
    {
      "id": 29,
      "start": 4378.22,
      "end": 4382.42,
      "formatted_start": "01:12:58.220",
      "formatted_end": "01:13:02.420",
      "text": "و اوکیشه بگیرم که ما فردا دست پر بریم"
    },
    {
      "id": 30,
      "start": 4382.42,
      "end": 4386.3,
      "formatted_start": "01:13:02.420",
      "formatted_end": "01:13:06.300",
      "text": "چون من به پاشایی زنگ زدم سورت جلسه رو تنتینک کنه"
    },
    {
      "id": 31,
      "start": 4386.3,
      "end": 4390.74,
      "formatted_start": "01:13:06.300",
      "formatted_end": "01:13:10.740",
      "text": "یه بشداری دارد که مثلا مدینامه باید از صحامدارا باشه"
    },
    {
      "id": 32,
      "start": 4390.74,
      "end": 4394.18,
      "formatted_start": "01:13:10.740",
      "formatted_end": "01:13:14.180",
      "text": "مثلا کوخت و اساس نامو، اینجا رو آفرین"
    },
    {
      "id": 33,
      "start": 4394.18,
      "end": 4398.74,
      "formatted_start": "01:13:14.180",
      "formatted_end": "01:13:18.740",
      "text": "این دیگه پرغازبازی در نیاده شما، آقای روغان مولی بود و خیلی از این داستانه"
    },
    {
      "id": 34,
      "start": 4398.74,
      "end": 4401.74,
      "formatted_start": "01:13:18.740",
      "formatted_end": "01:13:21.740",
      "text": "من هنوز به دکتر زنگ میزنم"
    },
    {
      "id": 35,
      "start": 4413.74,
      "end": 4415.74,
      "formatted_start": "01:13:33.740",
      "formatted_end": "01:13:35.740",
      "text": "چرا؟"
    },
    {
      "id": 36,
      "start": 4422.74,
      "end": 4425.74,
      "formatted_start": "01:13:42.740",
      "formatted_end": "01:13:45.740",
      "text": "آره نه، عچیب بود، از من شکر شدم"
    },
    {
      "id": 37,
      "start": 4428.74,
      "end": 4436.74,
      "formatted_start": "01:13:48.740",
      "formatted_end": "01:13:56.740",
      "text": "بی که گفته؟"
    },
    {
      "id": 38,
      "start": 4436.74,
      "end": 4438.74,
      "formatted_start": "01:13:56.740",
      "formatted_end": "01:13:58.740",
      "text": "به نفسی گفته؟"
    },
    {
      "id": 39,
      "start": 4438.74,
      "end": 4440.74,
      "formatted_start": "01:13:58.740",
      "formatted_end": "01:14:00.740",
      "text": "نفسی رئیس پیشه؟"
    },
    {
      "id": 40,
      "start": 4440.74,
      "end": 4442.74,
      "formatted_start": "01:14:00.740",
      "formatted_end": "01:14:02.740",
      "text": "رئیسی چی؟"
    },
    {
      "id": 41,
      "start": 4442.74,
      "end": 4446.74,
      "formatted_start": "01:14:02.740",
      "formatted_end": "01:14:06.740",
      "text": "نه، جاپ دستانی که همین بیرون"
    },
    {
      "id": 42,
      "start": 4446.74,
      "end": 4448.74,
      "formatted_start": "01:14:06.740",
      "formatted_end": "01:14:08.740",
      "text": "خب،"
    },
    {
      "id": 43,
      "start": 4448.74,
      "end": 4456.74,
      "formatted_start": "01:14:08.740",
      "formatted_end": "01:14:16.740",
      "text": "خب، الان عجب نکنی"
    },
    {
      "id": 44,
      "start": 4456.74,
      "end": 4466.74,
      "formatted_start": "01:14:16.740",
      "formatted_end": "01:14:26.740",
      "text": "آره یه مدار اون با نفسی باید صحبته من تجار نفسی خودش افتره گفتی اینجوریه و بعد دو مرده به"
    },
    {
      "id": 45,
      "start": 4466.74,
      "end": 4474.74,
      "formatted_start": "01:14:26.740",
      "formatted_end": "01:14:34.740",
      "text": "آره اینو باید دنیا دقیقه نوزم باید صحبت کرد"
    },
    {
      "id": 46,
      "start": 4474.74,
      "end": 4476.74,
      "formatted_start": "01:14:34.740",
      "formatted_end": "01:14:36.740",
      "text": "وحرام چی میگه؟"
    },
    {
      "id": 47,
      "start": 4478.74,
      "end": 4482.74,
      "formatted_start": "01:14:38.740",
      "formatted_end": "01:14:42.740",
      "text": "من با دکتور وحرام صحبت میکنم خب"
    },
    {
      "id": 48,
      "start": 4482.74,
      "end": 4486.74,
      "formatted_start": "01:14:42.740",
      "formatted_end": "01:14:46.740",
      "text": "آره من ببینم که اول مزه دهنش چیه؟"
    },
    {
      "id": 49,
      "start": 4486.74,
      "end": 4490.74,
      "formatted_start": "01:14:46.740",
      "formatted_end": "01:14:50.740",
      "text": "جلسه رو هم عجبه نکنیم، زود نزدیم"
    },
    {
      "id": 50,
      "start": 4492.74,
      "end": 4496.74,
      "formatted_start": "01:14:52.740",
      "formatted_end": "01:14:56.740",
      "text": "همزارو گفت میتونیم چون من میترسم، خواهیم فردا بذاریم"
    },
    {
      "id": 51,
      "start": 4496.74,
      "end": 4499.74,
      "formatted_start": "01:14:56.740",
      "formatted_end": "01:14:59.740",
      "text": "خب، منظورم میبینم تنور گرم"
    }
  ],
  "status": "completed"
}