  "stt_segments": [
    {
      "id": 0,
      "start": 17700.0,
      "end": 17702.0,
      "formatted_start": "04:55:00.000",
      "formatted_end": "04:55:02.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 1,
      "start": 17730.0,
      "end": 17743.0,
      "formatted_start": "04:55:30.000",
      "formatted_end": "04:55:43.000",
      "text": "این سخته اون آخرش چیست؟ اگر ساخنانی نشاط و شاده بید و آرامش رو از دست بددید، همه جامعان رو به درگ و درگ رو بسیار میدن."
    },
    {
      "id": 2,
      "start": 17743.0,
      "end": 17753.0,
      "formatted_start": "04:55:43.000",
      "formatted_end": "04:55:53.000",
      "text": "همه شما بیش دست و چند دست و در شمال شما همون هم یک جزئه ساخنانی نشاط و آرامش رو بسیار میدن."
    },
    {
      "id": 3,
      "start": 17753.0,
      "end": 17763.0,
      "formatted_start": "04:55:53.000",
      "formatted_end": "04:56:03.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 17783.0,
      "end": 17793.0,
      "formatted_start": "04:56:23.000",
      "formatted_end": "04:56:33.000",
      "text": "در اهم دیگره این بازتان سنگار کنید به مسئله میکیان"
    },
    {
      "id": 5,
      "start": 17793.0,
      "end": 17798.0,
      "formatted_start": "04:56:33.000",
      "formatted_end": "04:56:38.000",
      "text": "من در این بازتان میگم که میکیان ماندن بیان میگه شهر را سردید"
    },
    {
      "id": 6,
      "start": 17798.0,
      "end": 17807.0,
      "formatted_start": "04:56:38.000",
      "formatted_end": "04:56:47.000",
      "text": "این میکنه که توسیع تعمیر داره که تعمیر مرد داره"
    },
    {
      "id": 7,
      "start": 17807.0,
      "end": 17814.0,
      "formatted_start": "04:56:47.000",
      "formatted_end": "04:56:54.000",
      "text": "تعمیر موریت چیز مرد رو سوال بودش از آنی"
    },
    {
      "id": 8,
      "start": 17814.0,
      "end": 17818.0,
      "formatted_start": "04:56:54.000",
      "formatted_end": "04:56:58.000",
      "text": "این هم تعمیر مرد کرده و برکش سوال داری"
    },
    {
      "id": 9,
      "start": 17818.0,
      "end": 17820.0,
      "formatted_start": "04:56:58.000",
      "formatted_end": "04:57:00.000",
      "text": "چیزی که باید داره داره"
    },
    {
      "id": 10,
      "start": 17820.0,
      "end": 17840.0,
      "formatted_start": "04:57:00.000",
      "formatted_end": "04:57:20.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 17850.0,
      "end": 17852.0,
      "formatted_start": "04:57:30.000",
      "formatted_end": "04:57:32.000",
      "text": "بخوند"
    },
    {
      "id": 12,
      "start": 17852.0,
      "end": 17854.0,
      "formatted_start": "04:57:32.000",
      "formatted_end": "04:57:34.000",
      "text": "بخوند"
    },
    {
      "id": 13,
      "start": 17854.0,
      "end": 17856.0,
      "formatted_start": "04:57:34.000",
      "formatted_end": "04:57:36.000",
      "text": "سلام در حال شما بوده"
    },
    {
      "id": 14,
      "start": 17856.0,
      "end": 17858.0,
      "formatted_start": "04:57:36.000",
      "formatted_end": "04:57:38.000",
      "text": "سلامت بشین"
    },
    {
      "id": 15,
      "start": 17858.0,
      "end": 17860.0,
      "formatted_start": "04:57:38.000",
      "formatted_end": "04:57:40.000",
      "text": "بچه های بود تخفید بشین"
    },
    {
      "id": 16,
      "start": 17860.0,
      "end": 17862.0,
      "formatted_start": "04:57:40.000",
      "formatted_end": "04:57:42.000",
      "text": "سلام"
    },
    {
      "id": 17,
      "start": 17862.0,
      "end": 17864.0,
      "formatted_start": "04:57:42.000",
      "formatted_end": "04:57:44.000",
      "text": "برگر میزن بدید"
    },
    {
      "id": 18,
      "start": 17864.0,
      "end": 17866.0,
      "formatted_start": "04:57:44.000",
      "formatted_end": "04:57:46.000",
      "text": "چی شده خانم شازی"
    },
    {
      "id": 19,
      "start": 17866.0,
      "end": 17868.0,
      "formatted_start": "04:57:46.000",
      "formatted_end": "04:57:48.000",
      "text": "آبادو پرستش هم میزن به درگاه"
    },
    {
      "id": 20,
      "start": 17868.0,
      "end": 17870.0,
      "formatted_start": "04:57:48.000",
      "formatted_end": "04:57:50.000",
      "text": "خانم بزن با آرسان"
    },
    {
      "id": 21,
      "start": 17870.0,
      "end": 17872.0,
      "formatted_start": "04:57:50.000",
      "formatted_end": "04:57:52.000",
      "text": "کش هم با شمایی"
    },
    {
      "id": 22,
      "start": 17872.0,
      "end": 17874.0,
      "formatted_start": "04:57:52.000",
      "formatted_end": "04:57:54.000",
      "text": "درگاه با این هاو"
    },
    {
      "id": 23,
      "start": 17874.0,
      "end": 17876.0,
      "formatted_start": "04:57:54.000",
      "formatted_end": "04:57:56.000",
      "text": "توشیکن مادرش بوده"
    },
    {
      "id": 24,
      "start": 17876.0,
      "end": 17878.0,
      "formatted_start": "04:57:56.000",
      "formatted_end": "04:57:58.000",
      "text": "اون درده بزنه"
    },
    {
      "id": 25,
      "start": 17878.0,
      "end": 17880.58,
      "formatted_start": "04:57:58.000",
      "formatted_end": "04:58:00.580",
      "text": "از اون دوباره بالا میاره از تو دوابش"
    },
    {
      "id": 26,
      "start": 17880.58,
      "end": 17882.18,
      "formatted_start": "04:58:00.580",
      "formatted_end": "04:58:02.180",
      "text": "الان چند روزشه؟"
    },
    {
      "id": 27,
      "start": 17882.18,
      "end": 17883.42,
      "formatted_start": "04:58:02.180",
      "formatted_end": "04:58:03.420",
      "text": "چند روزشه"
    },
    {
      "id": 28,
      "start": 17883.42,
      "end": 17884.54,
      "formatted_start": "04:58:03.420",
      "formatted_end": "04:58:04.540",
      "text": "پنج روزه؟"
    },
    {
      "id": 29,
      "start": 17884.54,
      "end": 17885.04,
      "formatted_start": "04:58:04.540",
      "formatted_end": "04:58:05.040",
      "text": "بله"
    },
    {
      "id": 30,
      "start": 17885.04,
      "end": 17886.72,
      "formatted_start": "04:58:05.040",
      "formatted_end": "04:58:06.720",
      "text": "الان شیر بر میگردونه؟"
    },
    {
      "id": 31,
      "start": 17886.72,
      "end": 17887.22,
      "formatted_start": "04:58:06.720",
      "formatted_end": "04:58:07.220",
      "text": "بله"
    },
    {
      "id": 32,
      "start": 17887.22,
      "end": 17887.72,
      "formatted_start": "04:58:07.220",
      "formatted_end": "04:58:07.720",
      "text": "خب"
    },
    {
      "id": 33,
      "start": 17887.72,
      "end": 17888.38,
      "formatted_start": "04:58:07.720",
      "formatted_end": "04:58:08.380",
      "text": "شیر بر"
    },
    {
      "id": 34,
      "start": 17888.38,
      "end": 17889.06,
      "formatted_start": "04:58:08.380",
      "formatted_end": "04:58:09.060",
      "text": "دیگه؟"
    },
    {
      "id": 35,
      "start": 17889.06,
      "end": 17890.68,
      "formatted_start": "04:58:09.060",
      "formatted_end": "04:58:10.680",
      "text": "سطحش رو نگاه کنم"
    },
    {
      "id": 36,
      "start": 17890.68,
      "end": 17892.52,
      "formatted_start": "04:58:10.680",
      "formatted_end": "04:58:12.520",
      "text": "این حالت چهرمانه هم در این همون هست"
    },
    {
      "id": 37,
      "start": 17892.52,
      "end": 17893.3,
      "formatted_start": "04:58:12.520",
      "formatted_end": "04:58:13.300",
      "text": "باش"
    },
    {
      "id": 38,
      "start": 17894.02,
      "end": 17895.02,
      "formatted_start": "04:58:14.020",
      "formatted_end": "04:58:15.020",
      "text": "بله"
    },
