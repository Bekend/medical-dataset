  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7505.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:05.000",
      "text": "باید بنابراین 500 لیتر رو داریم، اونقدر چیز نیست، نقیقا جایگزین کنید."
    },
    {
      "id": 1,
      "start": 7505.0,
      "end": 7509.0,
      "formatted_start": "02:05:05.000",
      "formatted_end": "02:05:09.000",
      "text": "چون میخواییم دیگه میدارم کمتر بخواییم چون قیمتش خیلی زیاد میشه."
    },
    {
      "id": 2,
      "start": 7509.0,
      "end": 7512.0,
      "formatted_start": "02:05:09.000",
      "formatted_end": "02:05:12.000",
      "text": "آره بگویم چون هزار لیتر..."
    },
    {
      "id": 3,
      "start": 7519.0,
      "end": 7521.0,
      "formatted_start": "02:05:19.000",
      "formatted_end": "02:05:21.000",
      "text": "همون چیزی باید چیز کرد؟"
    },
    {
      "id": 4,
      "start": 7524.0,
      "end": 7527.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:27.000",
      "text": "آره، آره، یه، یه، پیگیرش باش."
    },
    {
      "id": 5,
      "start": 7527.0,
      "end": 7531.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:31.000",
      "text": "خیلی خیلی خیلی"
    },
    {
      "id": 6,
      "start": 7531.0,
      "end": 7535.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:35.000",
      "text": "باشه یه خیلی باشه نیستی خدافت"
    },
    {
      "id": 7,
      "start": 7535.0,
      "end": 7555.0,
      "formatted_start": "02:05:35.000",
      "formatted_end": "02:05:55.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 7555.0,
      "end": 7559.0,
      "formatted_start": "02:05:55.000",
      "formatted_end": "02:05:59.000",
      "text": "حلو سلام، سلام نکتر جا، خوبی؟ بخوانم زنده باشید"
    },
    {
      "id": 9,
      "start": 7559.0,
      "end": 7565.0,
      "formatted_start": "02:05:59.000",
      "formatted_end": "02:06:05.000",
      "text": "آقای دکتر، یه حالا ما سه چهار روز آینده این جلسه رو میذاریم، خب، کرگرد مدیره"
    },
    {
      "id": 10,
      "start": 7565.0,
      "end": 7573.0,
      "formatted_start": "02:06:05.000",
      "formatted_end": "02:06:13.000",
      "text": "ولی شما برای تا این زمانی که تو اون جلسه اعتصار میدا کنه، برای اون کار مدیریتیتون رو زمین نزدگید"
    },
    {
      "id": 11,
      "start": 7573.0,
      "end": 7581.0,
      "formatted_start": "02:06:13.000",
      "formatted_end": "02:06:21.000",
      "text": "و شاید اصلا توی... آه، آره، چون خانه، آره"
    },
    {
      "id": 12,
      "start": 7581.0,
      "end": 7586.0,
      "formatted_start": "02:06:21.000",
      "formatted_end": "02:06:26.000",
      "text": "آره گفت رازاییل خانمی جرنیتی به من گفت دوت پاشایی بری گفته"
    },
    {
      "id": 13,
      "start": 7586.0,
      "end": 7597.1,
      "formatted_start": "02:06:26.000",
      "formatted_end": "02:06:37.100",
      "text": "آره نه آره آره گفتم اینجوریه"
    },
    {
      "id": 14,
      "start": 7597.1,
      "end": 7601.0,
      "formatted_start": "02:06:37.100",
      "formatted_end": "02:06:41.000",
      "text": "حالا برقرار ما تو چند روز جلسه رو میذاریم"
    },
    {
      "id": 15,
      "start": 7601.88,
      "end": 7607.88,
      "formatted_start": "02:06:41.880",
      "formatted_end": "02:06:47.880",
      "text": "بر اگر خودتون هم کاندید هستید برای مدیر آمدیدی"
    },
    {
      "id": 16,
      "start": 7607.88,
      "end": 7611.88,
      "formatted_start": "02:06:47.880",
      "formatted_end": "02:06:51.880",
      "text": "چیز کنید که مثلا ما مطرح کنیم اینا"
    },
    {
      "id": 17,
      "start": 7611.88,
      "end": 7617.88,
      "formatted_start": "02:06:51.880",
      "formatted_end": "02:06:57.880",
      "text": "نه مثلا ما به اجماع میلیستیم آقای X"
    },
    {
      "id": 18,
      "start": 7617.88,
      "end": 7619.88,
      "formatted_start": "02:06:57.880",
      "formatted_end": "02:06:59.880",
      "text": "آقای X میگه من دیگه نمیخوام بشم"
    },
    {
      "id": 19,
      "start": 7619.88,
      "end": 7623.88,
      "formatted_start": "02:06:59.880",
      "formatted_end": "02:07:03.880",
      "text": "بله خوب"
    },
    {
      "id": 20,
      "start": 7627.88,
      "end": 7633.88,
      "formatted_start": "02:07:07.880",
      "formatted_end": "02:07:13.880",
      "text": "خب ببین دکتر من اینو مطرح میکنم خب پیشنات میدهم مثلا"
    },
    {
      "id": 21,
      "start": 7633.88,
      "end": 7636.88,
      "formatted_start": "02:07:13.880",
      "formatted_end": "02:07:16.880",
      "text": "آقای دکتر پاشایی آقای مثلا دکتر X ایگریت"
    },
    {
      "id": 22,
      "start": 7636.88,
      "end": 7639.7,
      "formatted_start": "02:07:16.880",
      "formatted_end": "02:07:19.700",
      "text": "اینا هستن شما بعد کدامشون میخوایین رای بدید"
    },
    {
      "id": 23,
      "start": 7640.12,
      "end": 7642.12,
      "formatted_start": "02:07:20.120",
      "formatted_end": "02:07:22.120",
      "text": "یه مخیل هستید دیگه"
    },
    {
      "id": 24,
      "start": 7644.72,
      "end": 7645.62,
      "formatted_start": "02:07:24.720",
      "formatted_end": "02:07:25.620",
      "text": "درسته"
    },
    {
      "id": 25,
      "start": 7646.58,
      "end": 7647.08,
      "formatted_start": "02:07:26.580",
      "formatted_end": "02:07:27.080",
      "text": "باشه"
    },
    {
      "id": 26,
      "start": 7653.86,
      "end": 7658.16,
      "formatted_start": "02:07:33.860",
      "formatted_end": "02:07:38.160",
      "text": "نه از داخل حیط مویدی به کسی بعید میدونم این چیز باشه"
    },
    {
      "id": 27,
      "start": 7658.16,
      "end": 7660.16,
      "formatted_start": "02:07:38.160",
      "formatted_end": "02:07:40.160",
      "text": "باید یه استحامدارای بیرون"
    },
    {
      "id": 28,
      "start": 7660.16,
      "end": 7662.16,
      "formatted_start": "02:07:40.160",
      "formatted_end": "02:07:42.160",
      "text": "باش الان من اشتاده هستم"
    },
    {
      "id": 29,
      "start": 7663.92,
      "end": 7664.64,
      "formatted_start": "02:07:43.920",
      "formatted_end": "02:07:44.640",
      "text": "باش"
    },
    {
      "id": 30,
      "start": 7664.64,
      "end": 7666.64,
      "formatted_start": "02:07:44.640",
      "formatted_end": "02:07:46.640",
      "text": "باشه"
    },
    {
      "id": 31,
      "start": 7674.64,
      "end": 7677.64,
      "formatted_start": "02:07:54.640",
      "formatted_end": "02:07:57.640",
      "text": "دستتون لرد نکنه منون برنامه چیز نکنم"
    },
    {
      "id": 32,
      "start": 7677.64,
      "end": 7679.64,
      "formatted_start": "02:07:57.640",
      "formatted_end": "02:07:59.640",
      "text": "مرسی و شکر"
    },
    {
      "id": 33,
      "start": 7694.64,
      "end": 7722.64,
      "formatted_start": "02:08:14.640",
      "formatted_end": "02:08:42.640",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 7724.64,
      "end": 7744.64,
      "formatted_start": "02:08:44.640",
      "formatted_end": "02:09:04.640",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 7744.64,
      "end": 7774.62,
      "formatted_start": "02:09:04.640",
      "formatted_end": "02:09:34.620",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 36,
      "start": 7774.64,
      "end": 7799.64,
      "formatted_start": "02:09:34.640",
      "formatted_end": "02:09:59.640",
