  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11130.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:30.000",
      "text": "از اینجا باید باید بیشتر باید بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر"
    },
    {
      "id": 1,
      "start": 11130.0,
      "end": 11159.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:59.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 11160.0,
      "end": 11184.0,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:24.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 11184.0,
      "end": 11188.5,
      "formatted_start": "03:06:24.000",
      "formatted_end": "03:06:28.500",
      "text": "آمده، فراموش برم، خوبی؟ آفیده ببین."
    },
    {
      "id": 4,
      "start": 11188.5,
      "end": 11200.5,
      "formatted_start": "03:06:28.500",
      "formatted_end": "03:06:40.500",
      "text": "میگم تو چرا این کاره کردی باب؟ به خدا من نامرک شدم، من توی یه هرگاه ندارم یه خاله، من بهتر افراد توی خانه نشنم آمدم، اینجور بگیر، بساییم بهتر آمیدی؟"
    },
    {
      "id": 5,
      "start": 11201.5,
      "end": 11205.0,
      "formatted_start": "03:06:41.500",
      "formatted_end": "03:06:45.000",
      "text": "منه، به گوشم میرسه، منه، منه."
    },
    {
      "id": 6,
      "start": 11206.0,
      "end": 11211.0,
      "formatted_start": "03:06:46.000",
      "formatted_end": "03:06:51.000",
      "text": "تو خیلی دارت بگه، شاید این کاره چی تا میکنی؟"
    },
    {
      "id": 7,
      "start": 11214.0,
      "end": 11220.0,
      "formatted_start": "03:06:54.000",
      "formatted_end": "03:07:00.000",
      "text": "سرامر باشه تانه انگر تو خالی تو چون جامعه بچه هر سنگیدی ها خواه"
    },
    {
      "id": 8,
      "start": 11222.0,
      "end": 11230.0,
      "formatted_start": "03:07:02.000",
      "formatted_end": "03:07:10.000",
      "text": "سرامر باشه انگر تو درد ما خوردی که دیگه اگه من در زمان تو رو آمدیم که دیگه هیچی دیگه"
    },
    {
      "id": 9,
      "start": 11230.0,
      "end": 11236.0,
      "formatted_start": "03:07:10.000",
      "formatted_end": "03:07:16.000",
      "text": "این همه آمدی تو برای من سرامدن یکمون پول گرید دیگه من تو در زمینم میگیری پول میگذاری"
    },
    {
      "id": 10,
      "start": 11237.0,
      "end": 11241.0,
      "formatted_start": "03:07:17.000",
      "formatted_end": "03:07:21.000",
      "text": "چه فرق داره تو که یه جور رو بکن من یه جور دیگه خاله"
    },
    {
      "id": 11,
      "start": 11241.0,
      "end": 11244.0,
      "formatted_start": "03:07:21.000",
      "formatted_end": "03:07:24.000",
      "text": "از سری مردم بخواییم به خدا خواستم بگیر."
    },
    {
      "id": 12,
      "start": 11244.0,
      "end": 11247.0,
      "formatted_start": "03:07:24.000",
      "formatted_end": "03:07:27.000",
      "text": "طول بگو و یک نمر نداری خالد."
    },
    {
      "id": 13,
      "start": 11247.0,
      "end": 11249.0,
      "formatted_start": "03:07:27.000",
      "formatted_end": "03:07:29.000",
      "text": "جا هم."
    },
    {
      "id": 14,
      "start": 11249.0,
      "end": 11251.0,
      "formatted_start": "03:07:29.000",
      "formatted_end": "03:07:31.000",
      "text": "نه از بار بود با شکل هم بیکارم بیا."
    },
    {
      "id": 15,
      "start": 11251.0,
      "end": 11254.0,
      "formatted_start": "03:07:31.000",
      "formatted_end": "03:07:34.000",
      "text": "همون بخواستی بگو من میام."
    },
    {
      "id": 16,
      "start": 11254.0,
      "end": 11257.0,
      "formatted_start": "03:07:34.000",
      "formatted_end": "03:07:37.000",
      "text": "آره من یه شباسش هم پرشن بیکنم."
    },
    {
      "id": 17,
      "start": 11257.0,
      "end": 11260.0,
      "formatted_start": "03:07:37.000",
      "formatted_end": "03:07:40.000",
      "text": "از هر که میام هم میام بجا دارم."
    },
    {
      "id": 18,
      "start": 11260.0,
      "end": 11263.0,
      "formatted_start": "03:07:40.000",
      "formatted_end": "03:07:43.000",
      "text": "فضلت بشم خالد."
    },
    {
      "id": 19,
      "start": 11263.0,
      "end": 11265.0,
      "formatted_start": "03:07:43.000",
      "formatted_end": "03:07:45.000",
      "text": "تعلمن بشه."
    },
    {
      "id": 20,
      "start": 11265.0,
      "end": 11267.0,
      "formatted_start": "03:07:45.000",
      "formatted_end": "03:07:47.000",
      "text": "دست در من باش."
    },
    {
      "id": 21,
      "start": 11267.0,
      "end": 11268.0,
      "formatted_start": "03:07:47.000",
      "formatted_end": "03:07:48.000",
      "text": "باش دست در من."
    },
    {
      "id": 22,
      "start": 11268.0,
      "end": 11272.0,
      "formatted_start": "03:07:48.000",
      "formatted_end": "03:07:52.000",
      "text": "بله خدا یه دیگه سریع بردی اگه مخواهد کنم کنم دیگه دیچی ها"
    },
    {
      "id": 23,
      "start": 11272.0,
      "end": 11276.0,
      "formatted_start": "03:07:52.000",
      "formatted_end": "03:07:56.000",
      "text": "این درباره دیچی ها چیانه باید بیایم رسوم دادی ها"
    },
    {
      "id": 24,
      "start": 11276.0,
      "end": 11277.0,
      "formatted_start": "03:07:56.000",
      "formatted_end": "03:07:57.000",
      "text": "همان"
    },
    {
      "id": 25,
      "start": 11277.0,
      "end": 11280.0,
      "formatted_start": "03:07:57.000",
      "formatted_end": "03:08:00.000",
      "text": "نه خدا نگاه مخواهد سرعت کن"
    },
    {
      "id": 26,
      "start": 11280.0,
      "end": 11281.0,
      "formatted_start": "03:08:00.000",
      "formatted_end": "03:08:01.000",
      "text": "برای آقابا"
    },
    {
      "id": 27,
      "start": 11281.0,
      "end": 11282.0,
      "formatted_start": "03:08:01.000",
      "formatted_end": "03:08:02.000",
      "text": "جان؟"
    },
    {
      "id": 28,
      "start": 11282.0,
      "end": 11285.0,
      "formatted_start": "03:08:02.000",
      "formatted_end": "03:08:05.000",
      "text": "این بود شیش ها مخواهد"
    },
    {
      "id": 29,
      "start": 11286.0,
      "end": 11290.0,
      "formatted_start": "03:08:06.000",
      "formatted_end": "03:08:10.000",
      "text": "چیه؟ گنجی؟ گنجی خواهد میاره؟ باید آزادش"
    },
    {
      "id": 30,
      "start": 11290.0,
      "end": 11292.0,
      "formatted_start": "03:08:10.000",
      "formatted_end": "03:08:12.000",
      "text": "خواب"
    },
    {
      "id": 31,
      "start": 11293.0,
      "end": 11295.0,
      "formatted_start": "03:08:13.000",
      "formatted_end": "03:08:15.000",
      "text": "سعادت نوشتیم"
    },
    {
      "id": 32,
      "start": 11295.0,
      "end": 11298.0,
      "formatted_start": "03:08:15.000",
      "formatted_end": "03:08:18.000",
      "text": "من این سوال را باید رستو پیروی بده کارد."
    },
    {
      "id": 33,
      "start": 11300.0,
      "end": 11303.0,
      "formatted_start": "03:08:20.000",
      "formatted_end": "03:08:23.000",
      "text": "نه، جواب سوال آره، همسون برداشته."
    },
    {
      "id": 34,
      "start": 11304.0,
      "end": 11306.0,
      "formatted_start": "03:08:24.000",
      "formatted_end": "03:08:26.000",
      "text": "آره، آره، آره."
    },
    {
      "id": 35,
      "start": 11308.0,
      "end": 11311.0,
      "formatted_start": "03:08:28.000",
      "formatted_end": "03:08:31.000",
      "text": "آها، خب، جواب سردنی با داشتی؟"
    },
    {
      "id": 36,
      "start": 11312.0,
      "end": 11314.0,
      "formatted_start": "03:08:32.000",
      "formatted_end": "03:08:34.000",
      "text": "آره، آره، آره."
    },
    {
      "id": 37,
      "start": 11318.0,
      "end": 11322.0,
      "formatted_start": "03:08:38.000",
      "formatted_end": "03:08:42.000",
      "text": "خب، خاله، خاله، یک سال نیمی نیست کده دو."
    },
    {
      "id": 38,
