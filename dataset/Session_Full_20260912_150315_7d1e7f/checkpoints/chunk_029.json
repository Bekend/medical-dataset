  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8705.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:05.000",
      "text": "نه نه، کلن میگم توی مدت یه هفته هسته، از شهر زر نیاد."
    },
    {
      "id": 1,
      "start": 8707.0,
      "end": 8708.0,
      "formatted_start": "02:25:07.000",
      "formatted_end": "02:25:08.000",
      "text": "این درم بشاره؟"
    },
    {
      "id": 2,
      "start": 8708.0,
      "end": 8714.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:14.000",
      "text": "اینو آره، ضرب میکنه شاهد چیز میکنه، چیز یک تز، یک درم بشاره."
    },
    {
      "id": 3,
      "start": 8714.0,
      "end": 8725.0,
      "formatted_start": "02:25:14.000",
      "formatted_end": "02:25:25.000",
      "text": "داره سه چار تا دکتر گفته باید چیز کنن، مثلا ببینن که مثلا تزش اینه که چقدر تزش حرف میزنه، چقدر مریض."
    },
    {
      "id": 4,
      "start": 8725.0,
      "end": 8734.0,
      "formatted_start": "02:25:25.000",
      "formatted_end": "02:25:34.000",
      "text": "مثلا ببینم این زخمی کنه که مثلا ببینی که مثلا از این پنج دقیقه اومده چند دقیقه دکتر زنگی هفت زده چند دقیقه"
    },
    {
      "id": 5,
      "start": 8734.0,
      "end": 8743.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:43.000",
      "text": "نه این خودش اوتوماتیک زخمی کنه اگر نیم ساعت چیز صحبت نکنی قطع می کنه خودش"
    },
    {
      "id": 6,
      "start": 8743.0,
      "end": 8772.0,
      "formatted_start": "02:25:43.000",
      "formatted_end": "02:26:12.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 8772.0,
      "end": 8778.24,
      "formatted_start": "02:26:12.000",
      "formatted_end": "02:26:18.240",
      "text": "ولی اینکه این تفایلی جدید به یه عملی که اون چونم به گلد از اون تنها بایدن جدید شد"
    },
    {
      "id": 8,
      "start": 8778.24,
      "end": 8781.24,
      "formatted_start": "02:26:18.240",
      "formatted_end": "02:26:21.240",
      "text": "اما اینکه اون موشی موشی بیشتر چیزی دیگه بیشتر برداشت"
    },
    {
      "id": 9,
      "start": 8781.24,
      "end": 8811.24,
      "formatted_start": "02:26:21.240",
      "formatted_end": "02:26:51.240",
      "text": "اینجا باید برداری کنید که اینجا باید برداری کنید که اینجا باید برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که اینجا برداری کنید که ا"
    },
    {
      "id": 10,
      "start": 8811.24,
      "end": 8813.24,
      "formatted_start": "02:26:51.240",
      "formatted_end": "02:26:53.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 11,
      "start": 8813.24,
      "end": 8815.24,
      "formatted_start": "02:26:53.240",
      "formatted_end": "02:26:55.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 12,
