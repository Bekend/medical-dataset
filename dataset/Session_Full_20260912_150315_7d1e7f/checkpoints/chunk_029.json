    },
    {
      "id": 20,
      "start": 8831.24,
      "end": 8833.24,
      "formatted_start": "02:27:11.240",
      "formatted_end": "02:27:13.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 21,
      "start": 8833.24,
      "end": 8835.24,
      "formatted_start": "02:27:13.240",
      "formatted_end": "02:27:15.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 22,
      "start": 8835.24,
      "end": 8837.24,
      "formatted_start": "02:27:15.240",
      "formatted_end": "02:27:17.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 23,
      "start": 8837.24,
      "end": 8839.24,
      "formatted_start": "02:27:17.240",
      "formatted_end": "02:27:19.240",
      "text": "این اداره شهرداری هست"
    },
    {
      "id": 24,
      "start": 8841.24,
      "end": 8844.24,
      "formatted_start": "02:27:21.240",
      "formatted_end": "02:27:24.240",
      "text": "شرداری اوته آقا این بده ای داره؟"
    },
    {
      "id": 25,
      "start": 8844.24,
      "end": 8846.24,
      "formatted_start": "02:27:24.240",
      "formatted_end": "02:27:26.240",
      "text": "آره این آره"
    },
    {
      "id": 26,
      "start": 8848.24,
      "end": 8850.24,
      "formatted_start": "02:27:28.240",
      "formatted_end": "02:27:30.240",
      "text": "شما باید شرداری رو"
    },
    {
      "id": 27,
      "start": 8851.24,
      "end": 8854.24,
      "formatted_start": "02:27:31.240",
      "formatted_end": "02:27:34.240",
      "text": "شرداری باید جواب اونو بده"
    },
    {
      "id": 28,
      "start": 8854.24,
      "end": 8856.24,
      "formatted_start": "02:27:34.240",
      "formatted_end": "02:27:36.240",
      "text": "گاز کار نداره که گاز نمیده"
    },
    {
      "id": 29,
      "start": 8856.24,
      "end": 8858.24,
      "formatted_start": "02:27:36.240",
      "formatted_end": "02:27:38.240",
      "text": "تا شرداری چیز نکنه باید"
    },
    {
      "id": 30,
      "start": 8858.24,
      "end": 8866.24,
      "formatted_start": "02:27:38.240",
      "formatted_end": "02:27:46.240",
      "text": "نه ببین اون شرداری باید بگه که بلامانه گاز دادم این خونه"
    },
    {
      "id": 31,
      "start": 8866.24,
      "end": 8869.24,
      "formatted_start": "02:27:46.240",
      "formatted_end": "02:27:49.240",
      "text": "شرداری بگه نه این بده ای داره من نده"
    },
    {
      "id": 32,
      "start": 8869.24,
      "end": 8881.24,
      "formatted_start": "02:27:49.240",
      "formatted_end": "02:28:01.240",
      "text": "نده. تا به دیگهش ندهده. حالا شهرداری باید بیدیم با شهردار صحبت کنیم که مثلا چیزش اینها یا فرماندار به شهرداری چیز کنه که یه تعقودی بگیره"
    },
    {
      "id": 33,
      "start": 8881.24,
      "end": 8898.24,
      "formatted_start": "02:28:01.240",
      "formatted_end": "02:28:18.240",
      "text": "فرمانداری میتونه به شهرداری دستور بده. که حالا به دیگهش نگفتن چقدر؟ اگر چیز باشه که باید زیاد باشه"
    },
    {
      "id": 34,
      "start": 8898.24,
      "end": 8901.24,
      "formatted_start": "02:28:18.240",
      "formatted_end": "02:28:21.240",
      "text": "آره آره"
    },
    {
      "id": 35,
      "start": 8901.24,
      "end": 8906.24,
      "formatted_start": "02:28:21.240",
      "formatted_end": "02:28:26.240",
      "text": "آره"
    },
    {
      "id": 36,
      "start": 8906.24,
