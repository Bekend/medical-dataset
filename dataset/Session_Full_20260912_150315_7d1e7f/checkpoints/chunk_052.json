      "formatted_start": "04:21:46.940",
      "formatted_end": "04:21:48.940",
      "text": "چهار شب دستگاه به دویر و شماله"
    },
    {
      "id": 26,
      "start": 15708.94,
      "end": 15710.94,
      "formatted_start": "04:21:48.940",
      "formatted_end": "04:21:50.940",
      "text": "در ملیز نگه دارو دارن دارو ها رو بیارن"
    },
    {
      "id": 27,
      "start": 15710.94,
      "end": 15712.94,
      "formatted_start": "04:21:50.940",
      "formatted_end": "04:21:52.940",
      "text": "بفرمایی"
    },
    {
      "id": 28,
      "start": 15712.94,
      "end": 15714.94,
      "formatted_start": "04:21:52.940",
      "formatted_end": "04:21:54.940",
      "text": "اونا دارو هم نگرفتن"
    },
    {
      "id": 29,
      "start": 15714.94,
      "end": 15716.94,
      "formatted_start": "04:21:54.940",
      "formatted_end": "04:21:56.940",
      "text": "اونا رو تازه"
    },
    {
      "id": 30,
      "start": 15716.94,
      "end": 15718.94,
      "formatted_start": "04:21:56.940",
      "formatted_end": "04:21:58.940",
      "text": "مال دو هفته اخیره"
    },
    {
      "id": 31,
      "start": 15718.94,
      "end": 15720.94,
      "formatted_start": "04:21:58.940",
      "formatted_end": "04:22:00.940",
      "text": "پس سر ساعت بشه"
    },
    {
      "id": 32,
      "start": 15720.94,
      "end": 15722.94,
      "formatted_start": "04:22:00.940",
      "formatted_end": "04:22:02.940",
      "text": "خب"
    },
    {
      "id": 33,
      "start": 15722.94,
      "end": 15724.94,
      "formatted_start": "04:22:02.940",
      "formatted_end": "04:22:04.940",
      "text": "بچه نیاز بسته ایگه نداره"
    },
    {
      "id": 34,
      "start": 15724.94,
      "end": 15726.94,
      "formatted_start": "04:22:04.940",
      "formatted_end": "04:22:06.940",
      "text": "صحبت کردن موردن بسته ایگه"
    },
    {
      "id": 35,
      "start": 15726.94,
      "end": 15728.94,
      "formatted_start": "04:22:06.940",
      "formatted_end": "04:22:08.940",
      "text": "نه اینقدر تحکیم کنیم"
    },
    {
      "id": 36,
      "start": 15728.94,
      "end": 15730.94,
      "formatted_start": "04:22:08.940",
      "formatted_end": "04:22:10.940",
      "text": "نه اینقدر دوست دارن که"
    },
    {
      "id": 37,
      "start": 15730.94,
      "end": 15732.94,
      "formatted_start": "04:22:10.940",
      "formatted_end": "04:22:12.940",
      "text": "ما تفسیبی موردی نامو بسته ایگه"
    },
    {
      "id": 38,
      "start": 15732.94,
      "end": 15734.94,
      "formatted_start": "04:22:12.940",
      "formatted_end": "04:22:14.940",
      "text": "من بچه خودم باشه ببینم"
    },
    {
      "id": 39,
      "start": 15734.94,
      "end": 15736.94,
      "formatted_start": "04:22:14.940",
      "formatted_end": "04:22:16.940",
      "text": "الان خیلی سخته من میگم نیاز نداره"
    },
    {
      "id": 40,
      "start": 15736.94,
      "end": 15739.94,
      "formatted_start": "04:22:16.940",
      "formatted_end": "04:22:19.940",
      "text": "برای چی؟ برای اینکه یه همکارم گفته بستریش کن"
    },
    {
      "id": 41,
      "start": 15739.94,
      "end": 15741.34,
      "formatted_start": "04:22:19.940",
      "formatted_end": "04:22:21.340",
      "text": "من میگم بستری نکن"
    },
    {
      "id": 42,
      "start": 15741.34,
      "end": 15742.3,
      "formatted_start": "04:22:21.340",
      "formatted_end": "04:22:22.300",
      "text": "خدا نکرده"
    },
    {
      "id": 43,
      "start": 15742.3,
      "end": 15744.3,
      "formatted_start": "04:22:22.300",
      "formatted_end": "04:22:24.300",
      "text": "به بچه این ادتا رو کنه"
    },
    {
      "id": 44,
      "start": 15744.3,
      "end": 15746.54,
      "formatted_start": "04:22:24.300",
      "formatted_end": "04:22:26.540",
      "text": "دکتور فیلانی گفت"
    },
    {
      "id": 45,
      "start": 15746.54,
      "end": 15748.94,
      "formatted_start": "04:22:26.540",
      "formatted_end": "04:22:28.940",
      "text": "ما صبح گفتم"
    },
    {
      "id": 46,
      "start": 15748.94,
      "end": 15751.58,
      "formatted_start": "04:22:28.940",
      "formatted_end": "04:22:31.580",
      "text": "منسیخ بالاتره وقتی خیلی میشه من میگم آخ"
    },
    {
      "id": 47,
      "start": 15751.58,
      "end": 15753.58,
      "formatted_start": "04:22:31.580",
      "formatted_end": "04:22:33.580",
      "text": "منم نام بستری میگم"
    },
    {
      "id": 48,
      "start": 15753.58,
      "end": 15756.74,
      "formatted_start": "04:22:33.580",
      "formatted_end": "04:22:36.740",
      "text": "صبح امروز های زود بگو گفته بستری با"
    },
    {
      "id": 49,
      "start": 15756.74,
      "end": 15758.54,
      "formatted_start": "04:22:36.740",
      "formatted_end": "04:22:38.540",
      "text": "خب من ماندم باید یه دکتور کنم"
    },
    {
      "id": 50,
      "start": 15758.54,
      "end": 15761.34,
      "formatted_start": "04:22:38.540",
      "formatted_end": "04:22:41.340",
      "text": "میشه بیا بیا یه دکتور علیکی بچه برم بستری کنیم"
    },
    {
      "id": 51,
      "start": 15761.34,
      "end": 15765.64,
      "formatted_start": "04:22:41.340",
      "formatted_end": "04:22:45.640",
      "text": "با بستری گذینه بودی اینکه بگم بستری با این نامو بدم صحبت دارم اونو میبنیم"
    },
    {
      "id": 52,
      "start": 15765.64,
      "end": 15767.4,
      "formatted_start": "04:22:45.640",
      "formatted_end": "04:22:47.400",
      "text": "متنش دارید برو بستریش کن"
    },
    {
      "id": 53,
      "start": 15767.4,
      "end": 15770.58,
      "formatted_start": "04:22:47.400",
      "formatted_end": "04:22:50.580",
      "text": "ولی توی هوایی گرمون بچه را توی بیمانو سرگرم"
    },
    {
      "id": 54,
      "start": 15770.58,
      "end": 15773.34,
      "formatted_start": "04:22:50.580",
      "formatted_end": "04:22:53.340",
      "text": "اگر نیاز باشه بنده ره ندارم"
    },
    {
      "id": 55,
      "start": 15773.34,
      "end": 15775.88,
      "formatted_start": "04:22:53.340",
      "formatted_end": "04:22:55.880",
      "text": "فکر بچم فکر چیز خود من"
    },
    {
      "id": 56,
      "start": 15775.88,
      "end": 15780.04,
      "formatted_start": "04:22:55.880",
      "formatted_end": "04:23:00.040",
      "text": "وقتی میبینم این خسخس داره و این حالت بیفلاکس داره وقتی"
    },
    {
      "id": 57,
      "start": 15780.04,
      "end": 15782.44,
      "formatted_start": "04:23:00.040",
      "formatted_end": "04:23:02.440",
      "text": "اگر این خوند میشد صرفه میذار"
    },
    {
      "id": 58,
      "start": 15782.44,
      "end": 15784.2,
      "formatted_start": "04:23:02.440",
      "formatted_end": "04:23:04.200",
      "text": "تا این سینه پرده کنی خیلی پاشه"
    },
    {
      "id": 59,
      "start": 15784.2,
      "end": 15786.04,
      "formatted_start": "04:23:04.200",
      "formatted_end": "04:23:06.040",
      "text": "صرفه میدنید خلطه بیارید"
    },
    {
      "id": 60,
      "start": 15786.04,
      "end": 15789.56,
      "formatted_start": "04:23:06.040",
      "formatted_end": "04:23:09.560",
      "text": "شیر یه حالتی داره وقتی داخل ریه میده صرفه نیمیدازه"
    },
    {
      "id": 61,
      "start": 15789.56,
      "end": 15791.56,
      "formatted_start": "04:23:09.560",
      "formatted_end": "04:23:11.560",
      "text": "فقط خط خطی نیمیده"
    },
    {
      "id": 62,
      "start": 15791.56,
      "end": 15792.44,
      "formatted_start": "04:23:11.560",
      "formatted_end": "04:23:12.440",
      "text": "تمام شده بله"
    },
    {
      "id": 63,
      "start": 15792.44,
      "end": 15795.96,
      "formatted_start": "04:23:12.440",
      "formatted_end": "04:23:15.960",
      "text": "و این اوپ میزنه و از این وقت میخواد تفهه میشه"
    },
    {
      "id": 64,
      "start": 15795.96,
      "end": 15797.96,
      "formatted_start": "04:23:15.960",
      "formatted_end": "04:23:17.960",
      "text": "چون شیری میره تا گلزمونه"
    },
    {
      "id": 65,
      "start": 15797.96,
      "end": 15799.96,
      "formatted_start": "04:23:17.960",
      "formatted_end": "04:23:19.960",
      "text": "این بازی بیندگیری و از دلال بردن هست"
    },
    {
      "id": 66,
      "start": 15799.96,
      "end": 15801.96,
      "formatted_start": "04:23:19.960",
      "formatted_end": "04:23:21.960",
      "text": "این همون میگه باز دوباره سوار میده"
    },
    {
      "id": 67,
      "start": 15801.96,
      "end": 15803.96,
      "formatted_start": "04:23:21.960",
      "formatted_end": "04:23:23.960",
      "text": "میگم این استفاده رو تسریب کردم"
    },
    {
      "id": 68,
      "start": 15803.96,
      "end": 15805.96,
      "formatted_start": "04:23:23.960",
      "formatted_end": "04:23:25.960",
      "text": "نرسته از شما"
    },
    {
      "id": 69,
      "start": 15805.96,
      "end": 15807.96,
      "formatted_start": "04:23:25.960",
      "formatted_end": "04:23:27.960",
      "text": "نامشم نمیشه"
    },
    {
      "id": 70,
      "start": 15807.96,
      "end": 15809.96,
      "formatted_start": "04:23:27.960",
      "formatted_end": "04:23:29.960",
      "text": "پنج و پنجه"
    },
    {
      "id": 71,
      "start": 15809.96,
      "end": 15811.96,
      "formatted_start": "04:23:29.960",
      "formatted_end": "04:23:31.960",
      "text": "اگه تا دو روزم"
    },
    {
      "id": 72,
      "start": 15811.96,
      "end": 15813.96,
      "formatted_start": "04:23:31.960",
      "formatted_end": "04:23:33.960",
      "text": "خوب نداریم"
    },
    {
      "id": 73,
      "start": 15813.96,
      "end": 15815.96,
      "formatted_start": "04:23:33.960",
      "formatted_end": "04:23:35.960",
      "text": "دکتور نندن شما چه کدوم شیر مادر قطع کنیم"
    },
    {
      "id": 74,
      "start": 15815.96,
      "end": 15817.96,
      "formatted_start": "04:23:35.960",
      "formatted_end": "04:23:37.960",
      "text": "نه برای چی کدوم کنیم"
    },
    {
      "id": 75,
      "start": 15817.96,
      "end": 15819.96,
      "formatted_start": "04:23:37.960",
      "formatted_end": "04:23:39.960",
      "text": "خیلی خیلی خیلی خیلی"
    },
    {
      "id": 76,
      "start": 15819.96,
      "end": 15821.96,
      "formatted_start": "04:23:39.960",
      "formatted_end": "04:23:41.960",
      "text": "نه اون ارتباط شیر خشک همیدیم"
    },
    {
      "id": 77,
      "start": 15821.96,
      "end": 15823.96,
      "formatted_start": "04:23:41.960",
      "formatted_end": "04:23:43.960",
      "text": "برمیگردم"
    },
    {
      "id": 78,
      "start": 15823.96,
      "end": 15825.96,
      "formatted_start": "04:23:43.960",
      "formatted_end": "04:23:45.960",
      "text": "چون میده گشات میشه"
    },
    {
      "id": 79,
      "start": 15825.96,
      "end": 15827.96,
      "formatted_start": "04:23:45.960",
      "formatted_end": "04:23:47.960",
      "text": "دهنه میده شله میزنه بالا"
    },
    {
      "id": 80,
      "start": 15827.96,
      "end": 15829.96,
      "formatted_start": "04:23:47.960",
      "formatted_end": "04:23:49.960",
      "text": "بعضی این میده ها حساس هست"
    },
    {
      "id": 81,
      "start": 15829.96,
      "end": 15836.46,
      "formatted_start": "04:23:49.960",
      "formatted_end": "04:23:56.460",
      "text": "خانواده هایی که نراتی مرده دارن یا درشون استرس زیاده بچه هایشون اونجوری بی غراوی و بی پلاپس بستن"
    },
    {
      "id": 82,
      "start": 15836.46,
      "end": 15837.96,
      "formatted_start": "04:23:56.460",
      "formatted_end": "04:23:57.960",
      "text": "های گوشی زیاده"
    },
    {
      "id": 83,
      "start": 15837.96,
      "end": 15839.36,
      "formatted_start": "04:23:57.960",
      "formatted_end": "04:23:59.360",
      "text": "ببین پوش کن بابا جو"
    },
    {
      "id": 84,
      "start": 15839.36,
      "end": 15841.96,
      "formatted_start": "04:23:59.360",
      "formatted_end": "04:24:01.960",
      "text": "اینا یه دونه شروع تو آب باتی می کنی"
    },
    {
      "id": 85,
      "start": 15842.96,
      "end": 15845.66,
      "formatted_start": "04:24:02.960",
      "formatted_end": "04:24:05.660",
      "text": "بعد صبح ناشته به بچه می بینی"
    },
    {
      "id": 86,
      "start": 15845.66,
      "end": 15846.76,
      "formatted_start": "04:24:05.660",
      "formatted_end": "04:24:06.760",
      "text": "هر روز یه دونه"
    },
    {
      "id": 87,
      "start": 15846.76,
      "end": 15847.36,
      "formatted_start": "04:24:06.760",
      "formatted_end": "04:24:07.360",
      "text": "تو آب؟"
    },
    {
      "id": 88,
      "start": 15847.36,
      "end": 15847.96,
      "formatted_start": "04:24:07.360",
      "formatted_end": "04:24:07.960",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 15847.96,
      "end": 15849.96,
      "formatted_start": "04:24:07.960",
      "formatted_end": "04:24:09.960",
      "text": "پرامان آبی جوشی دستر شده"
    },
    {
      "id": 90,
      "start": 15849.96,
      "end": 15851.26,
      "formatted_start": "04:24:09.960",
      "formatted_end": "04:24:11.260",
      "text": "ده تا نوشتن"
    },
    {
      "id": 91,
      "start": 15851.26,
      "end": 15853.96,
      "formatted_start": "04:24:11.260",
      "formatted_end": "04:24:13.960",
      "text": "اگه دیدید این تا سه چهار روز داری خوبه"
    },
    {
      "id": 92,
      "start": 15853.96,
      "end": 15854.96,
      "formatted_start": "04:24:13.960",
      "formatted_end": "04:24:14.960",
      "text": "نه تا چهار"
    },
    {
      "id": 93,
      "start": 15854.96,
      "end": 15859.36,
      "formatted_start": "04:24:14.960",
      "formatted_end": "04:24:19.360",
      "text": "ده تا دیگه می گیریم میشه بیستارین، بیستی یک روزه یه دوره شد"
    },
    {
      "id": 94,
      "start": 15859.36,
      "end": 15862.96,
      "formatted_start": "04:24:19.360",
      "formatted_end": "04:24:22.960",
      "text": "پردم برای تست ده تا نوشتم نخواستم از اینه تو بالا برم"
    },
    {
      "id": 95,
      "start": 15862.96,
      "end": 15864.96,
      "formatted_start": "04:24:22.960",
      "formatted_end": "04:24:24.960",
      "text": "حالا دارم بهت میگم، خب؟"
    },
    {
      "id": 96,
      "start": 15864.96,
      "end": 15868.96,
      "formatted_start": "04:24:24.960",
      "formatted_end": "04:24:28.960",
      "text": "من همه دوشت دوره خونه هم ببینم، دکتر تن از این"
    },
    {
      "id": 97,
      "start": 15868.96,
      "end": 15870.96,
      "formatted_start": "04:24:28.960",
      "formatted_end": "04:24:30.960",
      "text": "دوازده یه خونه یه سی سی"
    },
    {
      "id": 98,
      "start": 15870.96,
      "end": 15872.96,
      "formatted_start": "04:24:30.960",
      "formatted_end": "04:24:32.960",
      "text": "این آشگی شاخه شاخه می کنن"
    },
    {
      "id": 99,
      "start": 15872.96,
      "end": 15874.96,
      "formatted_start": "04:24:32.960",
      "formatted_end": "04:24:34.960",
      "text": "من همین دکترون، اون دکترون بیدار برم"
    },
    {
      "id": 100,
      "start": 15874.96,
      "end": 15877.96,
      "formatted_start": "04:24:34.960",
      "formatted_end": "04:24:37.960",
      "text": "بسیار دکتر، الان اومده یه دکتر، فردا صبح یه دکتر"
    },
    {
      "id": 101,
      "start": 15877.96,
      "end": 15881.96,
      "formatted_start": "04:24:37.960",
      "formatted_end": "04:24:41.960",
      "text": "پولاتونم خرچ می کنیم، اصابتونم خورد می کنیم"
    },
    {
      "id": 102,
      "start": 15881.96,
      "end": 15883.96,
      "formatted_start": "04:24:41.960",
      "formatted_end": "04:24:43.960",
      "text": "بعد هم میگیم چه اشتباهی کردیم"
    },
    {
      "id": 103,
      "start": 15883.96,
      "end": 15886.96,
      "formatted_start": "04:24:43.960",
      "formatted_end": "04:24:46.960",
      "text": "این دوازدر ساعت یک و نیم سی سی"
    },
    {
      "id": 104,
      "start": 15886.96,
      "end": 15888.96,
      "formatted_start": "04:24:46.960",
      "formatted_end": "04:24:48.960",
      "text": "درست بدن"
