  "stt_segments": [
    {
      "id": 0,
      "start": 15600.0,
      "end": 15620.0,
      "formatted_start": "04:20:00.000",
      "formatted_end": "04:20:20.000",
      "text": "داروها رو بیار من ببینم، دستگاه رو به منشین بگو، دو کار میتونی کنید، یا تا شنبه نگه دارید که کاملن رو سکیل بشه، یا تا پنج شنبه نگه ندارید، برای تا پنج شنبه بعد از زور نیست."
    },
    {
      "id": 1,
      "start": 15620.0,
      "end": 15622.0,
      "formatted_start": "04:20:20.000",
      "formatted_end": "04:20:22.000",
      "text": "دیگه باید تا سر دوار زمان"
    },
    {
      "id": 2,
      "start": 15622.0,
      "end": 15624.0,
      "formatted_start": "04:20:22.000",
      "formatted_end": "04:20:24.000",
      "text": "این روی صدی است"
    },
    {
      "id": 3,
      "start": 15624.0,
      "end": 15626.0,
      "formatted_start": "04:20:24.000",
      "formatted_end": "04:20:26.000",
      "text": "آزمایش کار"
    },
    {
      "id": 4,
      "start": 15626.0,
      "end": 15656.0,
      "formatted_start": "04:20:26.000",
      "formatted_end": "04:20:56.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 5,
      "start": 15656.0,
      "end": 15658.66,
      "formatted_start": "04:20:56.000",
      "formatted_end": "04:20:58.660",
      "text": "نگه دارد بخیال من و تو راحت داشتید"
    },
    {
      "id": 6,
      "start": 15658.66,
      "end": 15661.66,
      "formatted_start": "04:20:58.660",
      "formatted_end": "04:21:01.660",
      "text": "بگو چهار روز بده تا شمبه"
    },
    {
      "id": 7,
      "start": 15661.66,
      "end": 15662.96,
      "formatted_start": "04:21:01.660",
      "formatted_end": "04:21:02.960",
      "text": "این داروارم میگی بیا"
    },
    {
      "id": 8,
      "start": 15662.96,
      "end": 15665.98,
      "formatted_start": "04:21:02.960",
      "formatted_end": "04:21:05.980",
      "text": "بعد به منشین بگو تا چهار روز که داده"
    },
    {
      "id": 9,
      "start": 15665.98,
      "end": 15669.48,
      "formatted_start": "04:21:05.980",
      "formatted_end": "04:21:09.480",
      "text": "بگو دکتر گفته ازیری سه زار کم هم تفریف کنید"
    },
    {
      "id": 10,
      "start": 15669.48,
      "end": 15672.34,
      "formatted_start": "04:21:09.480",
      "formatted_end": "04:21:12.340",
      "text": "باید پابل شما رو زداده باشید"
    },
    {
      "id": 11,
      "start": 15672.34,
      "end": 15674.54,
      "formatted_start": "04:21:12.340",
      "formatted_end": "04:21:14.540",
      "text": "به این کاری که این شده"
    },
    {
      "id": 12,
      "start": 15674.54,
      "end": 15679.76,
      "formatted_start": "04:21:14.540",
      "formatted_end": "04:21:19.760",
      "text": "خواهیش میکنم"
    },
    {
      "id": 13,
      "start": 15679.76,
      "end": 15684.94,
      "formatted_start": "04:21:19.760",
      "formatted_end": "04:21:24.940",
      "text": "خانم نه دارونو میگرم"
    },
    {
      "id": 14,
      "start": 15684.94,
      "end": 15686.94,
      "formatted_start": "04:21:24.940",
      "formatted_end": "04:21:26.940",
      "text": "خانم سمیت یک لذه؟"
    },
    {
      "id": 15,
      "start": 15686.94,
      "end": 15688.94,
      "formatted_start": "04:21:26.940",
      "formatted_end": "04:21:28.940",
      "text": "یک لذه"
    },
    {
      "id": 16,
      "start": 15688.94,
      "end": 15690.94,
      "formatted_start": "04:21:28.940",
      "formatted_end": "04:21:30.940",
      "text": "سمیت بگیر"
    },
    {
      "id": 17,
      "start": 15690.94,
      "end": 15692.94,
      "formatted_start": "04:21:30.940",
      "formatted_end": "04:21:32.940",
      "text": "سمیت بگیر"
    },
    {
      "id": 18,
      "start": 15692.94,
      "end": 15694.94,
      "formatted_start": "04:21:32.940",
      "formatted_end": "04:21:34.940",
      "text": "این آقایی که الان رفت"
    },
    {
      "id": 19,
      "start": 15694.94,
      "end": 15696.94,
      "formatted_start": "04:21:34.940",
      "formatted_end": "04:21:36.940",
      "text": "چهار شب دستگاه به دویر و شماله"
    },
    {
      "id": 20,
      "start": 15696.94,
