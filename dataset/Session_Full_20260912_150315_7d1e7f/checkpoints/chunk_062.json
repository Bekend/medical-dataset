    },
    {
      "start": 18899.596,
      "end": 18899.967,
      "formatted_start": "05:14:59.596",
      "formatted_end": "05:14:59.967",
      "speaker": "SPEAKER_01"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 18600.0,
      "end": 18606.0,
      "formatted_start": "05:10:00.000",
      "formatted_end": "05:10:06.000",
      "text": "این همه مریض پایده نداره که شما برو با آقای دستور کامل بده."
    },
    {
      "id": 1,
      "start": 18606.0,
      "end": 18608.0,
      "formatted_start": "05:10:06.000",
      "formatted_end": "05:10:08.000",
      "text": "آقای نداشت این همه مریض."
    },
    {
      "id": 2,
      "start": 18608.0,
      "end": 18613.0,
      "formatted_start": "05:10:08.000",
      "formatted_end": "05:10:13.000",
      "text": "آقای نداشت چون دیگه بگفتم دارو خانه دلم، رامیان، نده، این ها رو همه رو گفتم من."
    },
    {
      "id": 3,
      "start": 18613.0,
      "end": 18618.0,
      "formatted_start": "05:10:13.000",
      "formatted_end": "05:10:18.000",
      "text": "اینکه همین تا ازش اینه که واقعا اینو نوشته هستن"
    },
    {
      "id": 4,
      "start": 18618.0,
      "end": 18621.0,
      "formatted_start": "05:10:18.000",
      "formatted_end": "05:10:21.000",
      "text": "تو اینو استفاده نیم کنیم تو اونو که داشتون همینو"
    },
    {
      "id": 5,
      "start": 18621.0,
      "end": 18626.0,
      "formatted_start": "05:10:21.000",
      "formatted_end": "05:10:26.000",
      "text": "آقا اینو یه دارو کمیابه کنار این دوتا دارو میزنن که بفروشن"
    },
    {
      "id": 6,
      "start": 18626.0,
      "end": 18629.0,
      "formatted_start": "05:10:26.000",
      "formatted_end": "05:10:29.000",
      "text": "تو هر جا بیدی اینو به این میدن اگر راسته باشن"
    },
    {
      "id": 7,
      "start": 18629.0,
      "end": 18632.0,
      "formatted_start": "05:10:29.000",
      "formatted_end": "05:10:32.000",
      "text": "میزاره برای اینکه با دوتا دارو دیگه بفروشه"
    },
    {
      "id": 8,
      "start": 18632.0,
      "end": 18634.0,
      "formatted_start": "05:10:32.000",
      "formatted_end": "05:10:34.000",
      "text": "متایش داری؟"
    },
    {
      "id": 9,
      "start": 18634.0,
      "end": 18637.0,
      "formatted_start": "05:10:34.000",
      "formatted_end": "05:10:37.000",
      "text": "میگه رفته اون دوتا دارو رو از اینجایی گرفت"
    },
    {
      "id": 10,
      "start": 18637.0,
      "end": 18641.0,
      "formatted_start": "05:10:37.000",
      "formatted_end": "05:10:41.000",
      "text": "شربت به شما اونی بگی نداری"
    },
    {
      "id": 11,
      "start": 18641.0,
      "end": 18645.0,
      "formatted_start": "05:10:41.000",
      "formatted_end": "05:10:45.000",
      "text": "شما اینها رو بگو کامل یا پسکی بود؟"
    },
    {
      "id": 12,
      "start": 18645.0,
      "end": 18647.0,
      "formatted_start": "05:10:45.000",
      "formatted_end": "05:10:47.000",
      "text": "کدام دارو خانم؟"
    },
    {
      "id": 13,
      "start": 18647.0,
      "end": 18649.0,
      "formatted_start": "05:10:47.000",
      "formatted_end": "05:10:49.000",
      "text": "بگو کامل بیده"
    },
    {
      "id": 14,
      "start": 18649.0,
      "end": 18651.0,
      "formatted_start": "05:10:49.000",
      "formatted_end": "05:10:51.000",
      "text": "اطلاعا بهت گفته ندارم تا هم گفتی بده"
    },
    {
      "id": 15,
      "start": 18651.0,
      "end": 18653.0,
      "formatted_start": "05:10:51.000",
      "formatted_end": "05:10:53.000",
      "text": "ندارم گفتم دوتای دیگه رو بیده"
    },
    {
      "id": 16,
      "start": 18653.0,
      "end": 18655.0,
      "formatted_start": "05:10:53.000",
      "formatted_end": "05:10:55.000",
      "text": "بگو دکتر میگه نه"
    },
    {
      "id": 17,
      "start": 18655.0,
      "end": 18657.0,
      "formatted_start": "05:10:55.000",
      "formatted_end": "05:10:57.000",
      "text": "اصلیش همون ترمزی شد"
    },
    {
      "id": 18,
      "start": 18657.0,
      "end": 18659.0,
      "formatted_start": "05:10:57.000",
      "formatted_end": "05:10:59.000",
      "text": "بگو دکتر گفته من اصلیش همون"
    },
    {
      "id": 19,
      "start": 18659.0,
      "end": 18661.0,
      "formatted_start": "05:10:59.000",
      "formatted_end": "05:11:01.000",
      "text": "کرمکت منده"
    },
    {
      "id": 20,
      "start": 18661.0,
      "end": 18663.0,
      "formatted_start": "05:11:01.000",
      "formatted_end": "05:11:03.000",
      "text": "این اونجا اونگاه این پوماد نمیشته؟"
    },
    {
      "id": 21,
      "start": 18663.0,
      "end": 18665.0,
      "formatted_start": "05:11:03.000",
      "formatted_end": "05:11:05.000",
      "text": "اسمش پریم نومتوماده"
    },
    {
      "id": 22,
      "start": 18665.0,
      "end": 18669.0,
      "formatted_start": "05:11:05.000",
      "formatted_end": "05:11:09.000",
      "text": "شربت پیلیون پوماده نه پوماد"
    },
    {
      "id": 23,
      "start": 18669.0,
      "end": 18671.0,
      "formatted_start": "05:11:09.000",
      "formatted_end": "05:11:11.000",
      "text": "اونها دیگه بودن خوبه"
    },
    {
      "id": 24,
      "start": 18671.0,
      "end": 18674.0,
      "formatted_start": "05:11:11.000",
      "formatted_end": "05:11:14.000",
      "text": "این شروط روزی را دیگه تس بودن"
    },
    {
      "id": 25,
      "start": 18674.0,
      "end": 18677.0,
      "formatted_start": "05:11:14.000",
      "formatted_end": "05:11:17.000",
      "text": "میفرد هر چیزی خود دیگه من دیگه پیشه بگم"
    },
    {
      "id": 26,
      "start": 18677.0,
      "end": 18678.0,
      "formatted_start": "05:11:17.000",
      "formatted_end": "05:11:18.000",
      "text": "همه چیزی بوده"
    },
    {
      "id": 27,
      "start": 18678.0,
      "end": 18680.0,
      "formatted_start": "05:11:18.000",
      "formatted_end": "05:11:20.000",
      "text": "فیل توضیح هست"
    },
    {
      "id": 28,
      "start": 18680.0,
      "end": 18683.0,
      "formatted_start": "05:11:20.000",
      "formatted_end": "05:11:23.000",
      "text": "یعنی امانون نگیری فایده ای نداره"
    },
    {
      "id": 29,
      "start": 18683.0,
      "end": 18684.0,
      "formatted_start": "05:11:23.000",
      "formatted_end": "05:11:24.000",
      "text": "خودتی نداره"
    },
    {
      "id": 30,
      "start": 18684.0,
      "end": 18685.0,
      "formatted_start": "05:11:24.000",
      "formatted_end": "05:11:25.000",
      "text": "خدا به شما باشه"
    },
    {
      "id": 31,
      "start": 18685.0,
      "end": 18687.0,
      "formatted_start": "05:11:25.000",
      "formatted_end": "05:11:27.000",
      "text": "این روزی پونزه قصد به یکچا بزن"
    },
    {
      "id": 32,
      "start": 18687.0,
      "end": 18690.0,
      "formatted_start": "05:11:27.000",
      "formatted_end": "05:11:30.000",
      "text": "خدا باشه"
    },
    {
      "id": 33,
      "start": 18690.0,
      "end": 18692.0,
      "formatted_start": "05:11:30.000",
      "formatted_end": "05:11:32.000",
      "text": "یکچایی"
    },
    {
      "id": 34,
      "start": 18692.0,
      "end": 18696.0,
      "formatted_start": "05:11:32.000",
      "formatted_end": "05:11:36.000",
      "text": "اینجور دسته با قاشو ملعب بخورید برسونید"
    },
    {
      "id": 35,
      "start": 18696.0,
      "end": 18698.0,
      "formatted_start": "05:11:36.000",
      "formatted_end": "05:11:38.000",
      "text": "نام خداحال"
    },
    {
      "id": 36,
      "start": 18718.0,
      "end": 18721.0,
      "formatted_start": "05:11:58.000",
      "formatted_end": "05:12:01.000",
      "text": "سلام جای شما خوبه؟ سلام"
    },
    {
      "id": 37,
      "start": 18721.0,
      "end": 18723.0,
      "formatted_start": "05:12:01.000",
      "formatted_end": "05:12:03.000",
      "text": "بسیاری نیست"
    },
    {
      "id": 38,
      "start": 18723.0,
      "end": 18725.0,
      "formatted_start": "05:12:03.000",
      "formatted_end": "05:12:05.000",
      "text": "خوبصورت شده؟"
    },
    {
      "id": 39,
      "start": 18725.0,
      "end": 18727.0,
      "formatted_start": "05:12:05.000",
      "formatted_end": "05:12:07.000",
      "text": "امیدوارم باید شده"
    },
    {
      "id": 40,
      "start": 18727.0,
      "end": 18729.0,
      "formatted_start": "05:12:07.000",
      "formatted_end": "05:12:09.000",
      "text": "چی شده امیدوارم؟"
    },
    {
      "id": 41,
      "start": 18729.0,
      "end": 18731.0,
      "formatted_start": "05:12:09.000",
      "formatted_end": "05:12:11.000",
      "text": "سه روزه ارواد شیرمانه مخوره"
    },
    {
      "id": 42,
      "start": 18731.0,
      "end": 18733.0,
      "formatted_start": "05:12:11.000",
      "formatted_end": "05:12:13.000",
      "text": "یک برنامه همه جور مکنه بغراری"
    },
    {
      "id": 43,
      "start": 18733.0,
      "end": 18735.0,
      "formatted_start": "05:12:13.000",
      "formatted_end": "05:12:15.000",
      "text": "همه جور قیز مکنه"
    },
    {
      "id": 44,
      "start": 18735.0,
      "end": 18737.0,
      "formatted_start": "05:12:15.000",
      "formatted_end": "05:12:17.000",
      "text": "اصلا همه جور سر سر ملیتی که باره مخوره"
    },
    {
      "id": 45,
      "start": 18737.0,
      "end": 18739.0,
      "formatted_start": "05:12:17.000",
      "formatted_end": "05:12:19.000",
      "text": "صورتش و گوهانو همجوری"
    },
    {
      "id": 46,
      "start": 18739.0,
      "end": 18741.0,
      "formatted_start": "05:12:19.000",
      "formatted_end": "05:12:21.000",
      "text": "همجوری که هم در همشون میخوره"
    },
    {
      "id": 47,
      "start": 18741.0,
      "end": 18743.0,
      "formatted_start": "05:12:21.000",
      "formatted_end": "05:12:23.000",
      "text": "چون در اینجور شده باید گریه"
    },
    {
      "id": 48,
      "start": 18743.0,
      "end": 18745.0,
      "formatted_start": "05:12:23.000",
      "formatted_end": "05:12:25.000",
      "text": "ایشه افتاده صبح"
    },
    {
      "id": 49,
      "start": 18745.0,
      "end": 18747.82,
      "formatted_start": "05:12:25.000",
      "formatted_end": "05:12:27.820",
      "text": "صبح بیقراری هسته کلان همین طب شدید و بیقراری"
    },
    {
      "id": 50,
      "start": 18747.82,
      "end": 18748.82,
      "formatted_start": "05:12:27.820",
      "formatted_end": "05:12:28.820",
      "text": "زنش شقده؟"
    },
    {
      "id": 51,
      "start": 18749.82,
      "end": 18750.82,
      "formatted_start": "05:12:29.820",
      "formatted_end": "05:12:30.820",
      "text": "چهار ماه"
    },
    {
      "id": 52,
      "start": 18750.82,
      "end": 18751.32,
      "formatted_start": "05:12:30.820",
      "formatted_end": "05:12:31.320",
      "text": "چهار ماه؟"
    },
    {
      "id": 53,
      "start": 18751.32,
      "end": 18752.82,
      "formatted_start": "05:12:31.320",
      "formatted_end": "05:12:32.820",
      "text": "یه هفته ایمه پنج رفته"
    },
    {
      "id": 54,
      "start": 18752.82,
      "end": 18754.82,
      "formatted_start": "05:12:32.820",
      "formatted_end": "05:12:34.820",
      "text": "بعد بیقراریش از که شروع شده؟"
    },
    {
      "id": 55,
      "start": 18754.82,
      "end": 18756.82,
      "formatted_start": "05:12:34.820",
      "formatted_end": "05:12:36.820",
      "text": "الان روز تا روزه"
    },
    {
      "id": 56,
      "start": 18756.82,
      "end": 18760.82,
      "formatted_start": "05:12:36.820",
      "formatted_end": "05:12:40.820",
      "text": "ادرار کچیکش موقع ادرار عذیب نمیشه جیش کچیکشاش"
    },
    {
      "id": 57,
      "start": 18761.82,
      "end": 18762.82,
      "formatted_start": "05:12:41.820",
      "formatted_end": "05:12:42.820",
      "text": "مدفوش اینا خوبه؟"
    },
    {
      "id": 58,
      "start": 18762.82,
      "end": 18764.82,
      "formatted_start": "05:12:42.820",
      "formatted_end": "05:12:44.820",
      "text": "اونش خوبه سر به سر"
    },
    {
      "id": 59,
      "start": 18764.82,
      "end": 18765.82,
      "formatted_start": "05:12:44.820",
      "formatted_end": "05:12:45.820",
      "text": "کچیکو بزرگ کرده خوبه؟"
    },
    {
      "id": 60,
      "start": 18765.82,
      "end": 18766.82,
      "formatted_start": "05:12:45.820",
      "formatted_end": "05:12:46.820",
      "text": "خوبه"
    },
    {
      "id": 61,
      "start": 18766.82,
      "end": 18767.82,
      "formatted_start": "05:12:46.820",
      "formatted_end": "05:12:47.820",
      "text": "سر به سرش کمش خوبه"
    },
    {
      "id": 62,
      "start": 18767.82,
      "end": 18769.82,
      "formatted_start": "05:12:47.820",
      "formatted_end": "05:12:49.820",
      "text": "تو بقل میگیدید آروم میشه"
    },
    {
      "id": 63,
      "start": 18769.82,
      "end": 18771.82,
      "formatted_start": "05:12:49.820",
      "formatted_end": "05:12:51.820",
      "text": "کلون دیشت داری نمیستید"
    },
    {
      "id": 64,
      "start": 18771.82,
      "end": 18773.82,
      "formatted_start": "05:12:51.820",
      "formatted_end": "05:12:53.820",
      "text": "نه سوال من که جواب نمیگیدید"
    },
    {
      "id": 65,
      "start": 18773.82,
      "end": 18775.82,
      "formatted_start": "05:12:53.820",
      "formatted_end": "05:12:55.820",
      "text": "تو بقل آروم میشه یا نمیشه؟"
    },
    {
      "id": 66,
      "start": 18775.82,
      "end": 18777.82,
      "formatted_start": "05:12:55.820",
      "formatted_end": "05:12:57.820",
      "text": "اینو باید بگید"
    },
    {
      "id": 67,
      "start": 18777.82,
      "end": 18779.82,
      "formatted_start": "05:12:57.820",
      "formatted_end": "05:12:59.820",
      "text": "میشه یا نمیشه؟"
    },
    {
      "id": 68,
      "start": 18779.82,
      "end": 18781.82,
      "formatted_start": "05:12:59.820",
      "formatted_end": "05:13:01.820",
      "text": "زیاد آروم نمیشه"
    },
    {
      "id": 69,
      "start": 18781.82,
      "end": 18783.82,
      "formatted_start": "05:13:01.820",
      "formatted_end": "05:13:03.820",
      "text": "تو ماشی ساکت ده؟"
    },
    {
      "id": 70,
      "start": 18783.82,
      "end": 18785.82,
      "formatted_start": "05:13:03.820",
      "formatted_end": "05:13:05.820",
      "text": "تو ماشی ساکت ده"
    },
    {
      "id": 71,
      "start": 18785.82,
      "end": 18787.82,
      "formatted_start": "05:13:05.820",
      "formatted_end": "05:13:07.820",
      "text": "تب داشته؟"
    },
    {
      "id": 72,
      "start": 18787.82,
      "end": 18789.82,
      "formatted_start": "05:13:07.820",
      "formatted_end": "05:13:09.820",
      "text": "تب داشت"
    },
    {
      "id": 73,
      "start": 18789.82,
      "end": 18791.82,
      "formatted_start": "05:13:09.820",
      "formatted_end": "05:13:11.820",
      "text": "اما منو داریم شکمش"
    },
    {
      "id": 74,
      "start": 18791.82,
      "end": 18793.82,
      "formatted_start": "05:13:11.820",
      "formatted_end": "05:13:13.820",
      "text": "شکمش برابر همه داره؟"
    },
    {
      "id": 75,
      "start": 18793.82,
      "end": 18795.82,
      "formatted_start": "05:13:13.820",
      "formatted_end": "05:13:15.820",
      "text": "بله صدا خیلی زیاد داره"
    },
    {
      "id": 76,
      "start": 18795.82,
      "end": 18797.82,
      "formatted_start": "05:13:15.820",
      "formatted_end": "05:13:17.820",
      "text": "اره هم. شما اینجا بردون میسید؟"
    },
    {
      "id": 77,
      "start": 18799.82,
      "end": 18801.82,
      "formatted_start": "05:13:19.820",
      "formatted_end": "05:13:21.820",
      "text": "اره آقایی اصلا این کاری که من گریش بسته"
    },
    {
      "id": 78,
      "start": 18801.82,
      "end": 18803.82,
      "formatted_start": "05:13:21.820",
      "formatted_end": "05:13:23.820",
      "text": "شما خود صبح"
    },
    {
      "id": 79,
      "start": 18803.82,
      "end": 18805.82,
      "formatted_start": "05:13:23.820",
      "formatted_end": "05:13:25.820",
      "text": "چند ماه شه؟"
    },
    {
      "id": 80,
      "start": 18805.82,
      "end": 18807.82,
      "formatted_start": "05:13:25.820",
      "formatted_end": "05:13:27.820",
      "text": "نوکرد بیاییم هفته امه پنجه رو رفتیم"
    },
    {
      "id": 81,
      "start": 18807.82,
      "end": 18809.82,
      "formatted_start": "05:13:27.820",
      "formatted_end": "05:13:29.820",
      "text": "پنجه شکنم شده چهار ماه شده"
    },
    {
      "id": 82,
      "start": 18809.82,
      "end": 18811.82,
      "formatted_start": "05:13:29.820",
      "formatted_end": "05:13:31.820",
      "text": "همش دستا شده درنش بیداریم"
    },
    {
      "id": 83,
      "start": 18811.82,
      "end": 18813.82,
      "formatted_start": "05:13:31.820",
      "formatted_end": "05:13:33.820",
      "text": "همش دستا شده همش"
    },
    {
      "id": 84,
      "start": 18813.82,
      "end": 18815.82,
      "formatted_start": "05:13:33.820",
      "formatted_end": "05:13:35.820",
      "text": "اصلا او خود سمرانی که اونکه گریش بردون بکرد"
    },
    {
      "id": 85,
      "start": 18815.82,
      "end": 18817.82,
      "formatted_start": "05:13:35.820",
      "formatted_end": "05:13:37.820",
      "text": "بردون"
    },
    {
      "id": 86,
      "start": 18817.82,
      "end": 18819.82,
      "formatted_start": "05:13:37.820",
      "formatted_end": "05:13:39.820",
      "text": "بردون این اصلا یه بچه آب داره"
    },
    {
      "id": 87,
      "start": 18819.82,
      "end": 18821.82,
      "formatted_start": "05:13:39.820",
      "formatted_end": "05:13:41.820",
      "text": "بردون"
    },
    {
      "id": 88,
      "start": 18821.82,
      "end": 18823.82,
      "formatted_start": "05:13:41.820",
      "formatted_end": "05:13:43.820",
      "text": "بردون"
    },
    {
      "id": 89,
      "start": 18823.82,
      "end": 18825.82,
      "formatted_start": "05:13:43.820",
      "formatted_end": "05:13:45.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 90,
      "start": 18825.82,
      "end": 18827.82,
      "formatted_start": "05:13:45.820",
      "formatted_end": "05:13:47.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 91,
      "start": 18827.82,
      "end": 18829.82,
      "formatted_start": "05:13:47.820",
      "formatted_end": "05:13:49.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 92,
      "start": 18829.82,
      "end": 18831.82,
      "formatted_start": "05:13:49.820",
      "formatted_end": "05:13:51.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 93,
      "start": 18831.82,
      "end": 18833.82,
      "formatted_start": "05:13:51.820",
      "formatted_end": "05:13:53.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 94,
      "start": 18833.82,
      "end": 18835.82,
      "formatted_start": "05:13:53.820",
      "formatted_end": "05:13:55.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 95,
      "start": 18835.82,
      "end": 18837.82,
      "formatted_start": "05:13:55.820",
      "formatted_end": "05:13:57.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 96,
      "start": 18837.82,
      "end": 18839.82,
      "formatted_start": "05:13:57.820",
      "formatted_end": "05:13:59.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 97,
      "start": 18839.82,
      "end": 18841.82,
      "formatted_start": "05:13:59.820",
      "formatted_end": "05:14:01.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 98,
      "start": 18841.82,
      "end": 18843.82,
      "formatted_start": "05:14:01.820",
      "formatted_end": "05:14:03.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 99,
      "start": 18843.82,
      "end": 18845.82,
      "formatted_start": "05:14:03.820",
      "formatted_end": "05:14:05.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 100,
      "start": 18845.82,
      "end": 18847.82,
      "formatted_start": "05:14:05.820",
      "formatted_end": "05:14:07.820",
      "text": "این روز همه چیزی نداره"
    },
    {
      "id": 101,
      "start": 18847.82,
      "end": 18851.06,
      "formatted_start": "05:14:07.820",
      "formatted_end": "05:14:11.060",
      "text": "خب، این رو برات شده چه هست داریم"
    },
    {
      "id": 102,
      "start": 18851.06,
      "end": 18859.82,
      "formatted_start": "05:14:11.060",
      "formatted_end": "05:14:19.820",
      "text": "من درست شده دیدم که این اران اینجوری باقی کار داریم"
    },
    {
      "id": 103,
      "start": 18859.82,
      "end": 18863.58,
      "formatted_start": "05:14:19.820",
      "formatted_end": "05:14:23.580",
      "text": "من به شدن همینه چون یکم ها اینجوری بود من یک اومد برامیدم"
    },
    {
      "id": 104,
      "start": 18863.58,
      "end": 18865.22,
      "formatted_start": "05:14:23.580",
      "formatted_end": "05:14:25.220",
      "text": "اون این لک لک ها"
    },
    {
      "id": 105,
      "start": 18865.22,
      "end": 18866.06,
      "formatted_start": "05:14:25.220",
      "formatted_end": "05:14:26.060",
      "text": "این لک لک ها"
    },
    {
      "id": 106,
      "start": 18866.06,
      "end": 18867.58,
      "formatted_start": "05:14:26.060",
      "formatted_end": "05:14:27.580",
      "text": "این ها این همه اصفی لک ها"
    },
    {
      "id": 107,
      "start": 18867.58,
      "end": 18869.98,
      "formatted_start": "05:14:27.580",
      "formatted_end": "05:14:29.980",
      "text": "پرلم در واقع نکار برات شده بود"
    },
    {
      "id": 108,
      "start": 18869.98,
      "end": 18871.06,
      "formatted_start": "05:14:29.980",
      "formatted_end": "05:14:31.060",
      "text": "دور افتاح نکار"
    },
    {
      "id": 109,
      "start": 18871.06,
      "end": 18873.26,
      "formatted_start": "05:14:31.060",
      "formatted_end": "05:14:33.260",
      "text": "دور افتاح بکاره خب کسی پیشتر میشه"
    },
    {
      "id": 110,
      "start": 18873.26,
      "end": 18874.06,
      "formatted_start": "05:14:33.260",
      "formatted_end": "05:14:34.060",
      "text": "نه نه"
    },
    {
      "id": 111,
      "start": 18874.06,
      "end": 18875.82,
      "formatted_start": "05:14:34.060",
      "formatted_end": "05:14:35.820",
      "text": "بیرون میرونمش"
    },
    {
      "id": 112,
      "start": 18875.82,
      "end": 18878.14,
      "formatted_start": "05:14:35.820",
      "formatted_end": "05:14:38.140",
      "text": "من برای این موضوع یک برم بیاریم که برن نفر نفر"
    },
    {
      "id": 113,
      "start": 18878.14,
      "end": 18881.02,
      "formatted_start": "05:14:38.140",
      "formatted_end": "05:14:41.020",
      "text": "هم پیشترین این داروهاش پیشتر آزاد میخوره"
    },
    {
      "id": 114,
      "start": 18881.02,
      "end": 18883.14,
      "formatted_start": "05:14:41.020",
      "formatted_end": "05:14:43.140",
      "text": "خواهد شهرت ایلکو مایسینش"
    },
    {
      "id": 115,
      "start": 18883.14,
      "end": 18884.78,
      "formatted_start": "05:14:43.140",
      "formatted_end": "05:14:44.780",
      "text": "هستامیه کن داریم؟"
    },
    {
      "id": 116,
      "start": 18884.78,
      "end": 18887.46,
      "formatted_start": "05:14:44.780",
      "formatted_end": "05:14:47.460",
      "text": "هستامیه کنم رو صبحی که یه قطره هستم آبادرمون شدیم"
    },
    {
      "id": 117,
      "start": 18887.46,
      "end": 18888.54,
      "formatted_start": "05:14:47.460",
      "formatted_end": "05:14:48.540",
      "text": "داریم دیگه؟"
    },
    {
      "id": 118,
      "start": 18888.54,
      "end": 18890.7,
      "formatted_start": "05:14:48.540",
      "formatted_end": "05:14:50.700",
      "text": "در خانه هستیم"
    },
    {
      "id": 119,
      "start": 18890.7,
      "end": 18893.38,
      "formatted_start": "05:14:50.700",
      "formatted_end": "05:14:53.380",
      "text": "خوابی داروهاشو بیار"
    },
    {
      "id": 120,
      "start": 18893.38,
      "end": 18894.54,
      "formatted_start": "05:14:53.380",
      "formatted_end": "05:14:54.540",
      "text": "طرف هم نداشته درسته؟"
    },
    {
      "id": 121,
      "start": 18894.54,
      "end": 18896.26,
      "formatted_start": "05:14:54.540",
      "formatted_end": "05:14:56.260",
      "text": "نه بره"
    },
    {
      "id": 122,
      "start": 18896.26,
      "end": 18898.38,
      "formatted_start": "05:14:56.260",
      "formatted_end": "05:14:58.380",
      "text": "اشرفه میزنیم"
    },
    {
      "id": 123,
      "start": 18898.38,
      "end": 18899.98,
      "formatted_start": "05:14:58.380",
      "formatted_end": "05:14:59.980",
      "text": "خیلی برم"
    }
  ],
  "status": "completed"
}