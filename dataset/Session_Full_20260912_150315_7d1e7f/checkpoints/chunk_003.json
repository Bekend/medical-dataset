  "stt_segments": [
    {
      "id": 0,
      "start": 900.0,
      "end": 929.98,
      "formatted_start": "00:15:00.000",
      "formatted_end": "00:15:29.980",
      "text": "برنامه بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 930.0,
      "end": 932.0,
      "formatted_start": "00:15:30.000",
      "formatted_end": "00:15:32.000",
      "text": "دیروز هم هم داشت"
    },
    {
      "id": 2,
      "start": 932.0,
      "end": 934.0,
      "formatted_start": "00:15:32.000",
      "formatted_end": "00:15:34.000",
      "text": "صرفه"
    },
    {
      "id": 3,
      "start": 934.0,
      "end": 936.0,
      "formatted_start": "00:15:34.000",
      "formatted_end": "00:15:36.000",
      "text": "صرفه های شدید"
    },
    {
      "id": 4,
      "start": 936.0,
      "end": 938.0,
      "formatted_start": "00:15:36.000",
      "formatted_end": "00:15:38.000",
      "text": "هم خسخ سینه هم داره"
    },
    {
      "id": 5,
      "start": 938.0,
      "end": 940.0,
      "formatted_start": "00:15:38.000",
      "formatted_end": "00:15:40.000",
      "text": "صرفه ها"
    },
    {
      "id": 6,
      "start": 940.0,
      "end": 942.0,
      "formatted_start": "00:15:40.000",
      "formatted_end": "00:15:42.000",
      "text": "پشت سرهم یا دک دکه"
    },
    {
      "id": 7,
      "start": 942.0,
      "end": 944.0,
      "formatted_start": "00:15:42.000",
      "formatted_end": "00:15:44.000",
      "text": "دو سه پر صرفه میکنه"
    },
    {
      "id": 8,
      "start": 944.0,
      "end": 946.0,
      "formatted_start": "00:15:44.000",
      "formatted_end": "00:15:46.000",
      "text": "باز میره"
    },
    {
      "id": 9,
      "start": 946.0,
      "end": 948.0,
      "formatted_start": "00:15:46.000",
      "formatted_end": "00:15:48.000",
      "text": "نه ببن خواهش بگو با اقا"
    },
    {
      "id": 10,
      "start": 948.0,
      "end": 950.0,
      "formatted_start": "00:15:48.000",
      "formatted_end": "00:15:50.000",
      "text": "خواهش بگو با اقا"
    },
    {
      "id": 11,
      "start": 950.0,
      "end": 952.0,
      "formatted_start": "00:15:50.000",
      "formatted_end": "00:15:52.000",
      "text": "صرفه ها چجوریه پشت سرهم"
    },
    {
      "id": 12,
      "start": 952.0,
      "end": 954.0,
      "formatted_start": "00:15:52.000",
      "formatted_end": "00:15:54.000",
      "text": "چهار پر صرفه میکنه"
    },
    {
      "id": 13,
      "start": 954.0,
      "end": 956.0,
      "formatted_start": "00:15:54.000",
      "formatted_end": "00:15:56.000",
      "text": "باز میره باز یک چیزی میخواد بخوره"
    },
    {
      "id": 14,
      "start": 956.0,
      "end": 958.0,
      "formatted_start": "00:15:56.000",
      "formatted_end": "00:15:58.000",
      "text": "دوباره صرفه میکنه"
    },
    {
      "id": 15,
      "start": 958.0,
      "end": 960.68,
      "formatted_start": "00:15:58.000",
      "formatted_end": "00:16:00.680",
      "text": "خب تبش شدید بودی یا خفیف؟"
    },
    {
      "id": 16,
      "start": 960.68,
      "end": 963.28,
      "formatted_start": "00:16:00.680",
      "formatted_end": "00:16:03.280",
      "text": "گیرز تبش خیلی سیاد نبود"
    },
    {
      "id": 17,
      "start": 963.28,
      "end": 964.12,
      "formatted_start": "00:16:03.280",
      "formatted_end": "00:16:04.120",
      "text": "خیلی خب تبش"
    },
    {
      "id": 18,
      "start": 964.12,
      "end": 965.2,
      "formatted_start": "00:16:04.120",
      "formatted_end": "00:16:05.200",
      "text": "سنی چقدر بود؟"
    },
    {
      "id": 19,
      "start": 965.2,
      "end": 966.2,
      "formatted_start": "00:16:05.200",
      "formatted_end": "00:16:06.200",
      "text": "چهار سالشه"
    },
    {
      "id": 20,
      "start": 966.2,
      "end": 967.2,
      "formatted_start": "00:16:06.200",
      "formatted_end": "00:16:07.200",
      "text": "چهار سالشه"
    },
    {
      "id": 21,
      "start": 967.2,
      "end": 968.44,
      "formatted_start": "00:16:07.200",
      "formatted_end": "00:16:08.440",
      "text": "داروی چیزی هم دادی؟"
    },
    {
      "id": 22,
      "start": 968.44,
      "end": 970.2,
      "formatted_start": "00:16:08.440",
      "formatted_end": "00:16:10.200",
      "text": "گیرز چرات پروفین دادم"
    },
    {
      "id": 23,
      "start": 970.2,
      "end": 971.92,
      "formatted_start": "00:16:10.200",
      "formatted_end": "00:16:11.920",
      "text": "وازیب مکسیم بهش دادم"
    },
    {
      "id": 24,
      "start": 971.92,
      "end": 974.8,
      "formatted_start": "00:16:11.920",
      "formatted_end": "00:16:14.800",
      "text": "خب آیا آراد خیلی اینجا میگن؟"
    },
    {
      "id": 25,
      "start": 974.8,
      "end": 977.08,
      "formatted_start": "00:16:14.800",
      "formatted_end": "00:16:17.080",
      "text": "بیا خیلی بیا آفرین"
    },
    {
      "id": 26,
      "start": 977.08,
      "end": 979.72,
      "formatted_start": "00:16:17.080",
      "formatted_end": "00:16:19.720",
      "text": "خیلی ما شانلا حدویی هستی"
    },
    {
      "id": 27,
      "start": 979.72,
      "end": 982.24,
      "formatted_start": "00:16:19.720",
      "formatted_end": "00:16:22.240",
      "text": "و بیرون آفرین"
    },
    {
      "id": 28,
      "start": 982.24,
      "end": 984.76,
      "formatted_start": "00:16:22.240",
      "formatted_end": "00:16:24.760",
      "text": "معلومی که با دوشترها روایتت خوبه"
    },
    {
      "id": 29,
      "start": 984.76,
      "end": 986.76,
      "formatted_start": "00:16:24.760",
      "formatted_end": "00:16:26.760",
      "text": "گریه نیمی کنی؟"
    },
    {
      "id": 30,
      "start": 986.76,
      "end": 987.76,
      "formatted_start": "00:16:26.760",
      "formatted_end": "00:16:27.760",
      "text": "نه"
    },
    {
      "id": 31,
