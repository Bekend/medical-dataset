  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3902.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:02.000",
      "text": "مرسی خودتون."
    },
    {
      "id": 1,
      "start": 3921.76,
      "end": 3924.76,
      "formatted_start": "01:05:21.760",
      "formatted_end": "01:05:24.760",
      "text": "سلام بابا جایم، سلامت باشید، خوشید."
    },
    {
      "id": 2,
      "start": 3924.76,
      "end": 3939.76,
      "formatted_start": "01:05:24.760",
      "formatted_end": "01:05:39.760",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 3939.76,
      "end": 3940.76,
      "formatted_start": "01:05:39.760",
      "formatted_end": "01:05:40.760",
      "text": "خب چی شده؟"
    },
    {
      "id": 4,
      "start": 3940.76,
      "end": 3942.76,
      "formatted_start": "01:05:40.760",
      "formatted_end": "01:05:42.760",
      "text": "آویزی سرما برده"
    },
    {
      "id": 5,
      "start": 3942.76,
      "end": 3943.76,
      "formatted_start": "01:05:42.760",
      "formatted_end": "01:05:43.760",
      "text": "صرفه اینا میزنه؟"
    },
    {
      "id": 6,
      "start": 3943.76,
      "end": 3945.76,
      "formatted_start": "01:05:43.760",
      "formatted_end": "01:05:45.760",
      "text": "یکی چیزی صرفه میزنه، تب هم داره"
    },
    {
      "id": 7,
      "start": 3945.76,
      "end": 3947.76,
      "formatted_start": "01:05:45.760",
      "formatted_end": "01:05:47.760",
      "text": "صرفه، تب، آبریزش؟"
    },
    {
      "id": 8,
      "start": 3947.76,
      "end": 3949.76,
      "formatted_start": "01:05:47.760",
      "formatted_end": "01:05:49.760",
      "text": "آبریزش هم کمه، زیاد نه"
    },
    {
      "id": 9,
      "start": 3949.76,
      "end": 3950.76,
      "formatted_start": "01:05:49.760",
      "formatted_end": "01:05:50.760",
      "text": "خسخسی سینه؟"
    },
    {
      "id": 10,
      "start": 3950.76,
      "end": 3951.76,
      "formatted_start": "01:05:50.760",
      "formatted_end": "01:05:51.760",
      "text": "داره آقایتو"
    },
    {
      "id": 11,
      "start": 3951.76,
      "end": 3953.76,
      "formatted_start": "01:05:51.760",
      "formatted_end": "01:05:53.760",
      "text": "صرفه ها خوشکه یا خلدی؟"
    },
    {
      "id": 12,
      "start": 3953.76,
      "end": 3956.6,
      "formatted_start": "01:05:53.760",
      "formatted_end": "01:05:56.600",
      "text": "فیلم خوش که از این روز صرفه میزنن"
    },
    {
      "id": 13,
      "start": 3956.6,
      "end": 3958.2,
      "formatted_start": "01:05:56.600",
      "formatted_end": "01:05:58.200",
      "text": "بله، پشتن هم یه تک تکیه"
    },
    {
      "id": 14,
      "start": 3958.2,
      "end": 3958.8,
      "formatted_start": "01:05:58.200",
      "formatted_end": "01:05:58.800",
      "text": "تک تک"
    },
    {
      "id": 15,
      "start": 3958.8,
      "end": 3959.4,
      "formatted_start": "01:05:58.800",
      "formatted_end": "01:05:59.400",
      "text": "هم"
    },
    {
      "id": 16,
      "start": 3960.44,
      "end": 3963.12,
      "formatted_start": "01:06:00.440",
      "formatted_end": "01:06:03.120",
      "text": "این یه هون هم میبینم تک بودتونه دیگه خوب ها"
    },
    {
      "id": 17,
      "start": 3963.12,
      "end": 3964.4,
      "formatted_start": "01:06:03.120",
      "formatted_end": "01:06:04.400",
      "text": "یه هون میبینم تک بودتونه"
    },
    {
      "id": 18,
      "start": 3964.4,
      "end": 3965.72,
      "formatted_start": "01:06:04.400",
      "formatted_end": "01:06:05.720",
      "text": "من دیگه شما این برده بایستیم"
    },
    {
      "id": 19,
      "start": 3968.6,
      "end": 3972.76,
      "formatted_start": "01:06:08.600",
      "formatted_end": "01:06:12.760",
      "text": "یادتون باشه دو ماهگی بستری شد دیوانستانه یادتون باشه"
    },
    {
      "id": 20,
      "start": 3972.76,
      "end": 3973.36,
      "formatted_start": "01:06:12.760",
      "formatted_end": "01:06:13.360",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 3977.48,
      "end": 3978.52,
      "formatted_start": "01:06:17.480",
      "formatted_end": "01:06:18.520",
      "text": "خندومه"
    },
    {
      "id": 22,
      "start": 3978.52,
      "end": 3979.4,
      "formatted_start": "01:06:18.520",
      "formatted_end": "01:06:19.400",
      "text": "دست میشکی؟"
    },
    {
      "id": 23,
      "start": 3979.4,
      "end": 3980.2,
      "formatted_start": "01:06:19.400",
      "formatted_end": "01:06:20.200",
      "text": "خندوم"
    },
    {
      "id": 24,
      "start": 3980.48,
      "end": 3981.64,
      "formatted_start": "01:06:20.480",
      "formatted_end": "01:06:21.640",
      "text": "آفریم"
    },
    {
      "id": 25,
      "start": 3981.96,
      "end": 3983.28,
      "formatted_start": "01:06:21.960",
      "formatted_end": "01:06:23.280",
      "text": "ای، جلوه همینست"
    },
    {
      "id": 26,
      "start": 3983.76,
      "end": 4005.76,
      "formatted_start": "01:06:23.760",
      "formatted_end": "01:06:45.760",
      "text": "خوب"
    },
    {
      "id": 27,
      "start": 4005.76,
      "end": 4006.76,
      "formatted_start": "01:06:45.760",
      "formatted_end": "01:06:46.760",
      "text": "خوب"
    },
    {
      "id": 28,
      "start": 4007.76,
      "end": 4011.76,
      "formatted_start": "01:06:47.760",
      "formatted_end": "01:06:51.760",
      "text": "از طرف که برقی سینه شینا گلوش ارتحاب کرده و افونت کرده"
    },
    {
      "id": 29,
      "start": 4011.76,
      "end": 4013.76,
      "formatted_start": "01:06:51.760",
      "formatted_end": "01:06:53.760",
      "text": "چند ماه اشته خانمه؟"
    },
    {
      "id": 30,
      "start": 4013.76,
      "end": 4015.76,
      "formatted_start": "01:06:53.760",
      "formatted_end": "01:06:55.760",
      "text": "دو سه روز دیگه سه ماهه میشه"
    },
    {
      "id": 31,
      "start": 4015.76,
      "end": 4016.76,
      "formatted_start": "01:06:55.760",
      "formatted_end": "01:06:56.760",
      "text": "سه ماهه؟"
    },
    {
      "id": 32,
      "start": 4016.76,
      "end": 4017.76,
      "formatted_start": "01:06:56.760",
      "formatted_end": "01:06:57.760",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 4017.76,
      "end": 4019.76,
      "formatted_start": "01:06:57.760",
      "formatted_end": "01:06:59.760",
      "text": "برقی دارو براش میمیسم خب؟"
    },
    {
      "id": 34,
      "start": 4019.76,
      "end": 4020.76,
      "formatted_start": "01:06:59.760",
      "formatted_end": "01:07:00.760",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 4020.76,
      "end": 4022.76,
      "formatted_start": "01:07:00.760",
      "formatted_end": "01:07:02.760",
      "text": "آنوی کلکی"
    },
    {
      "id": 36,
      "start": 4024.76,
      "end": 4025.76,
      "formatted_start": "01:07:04.760",
      "formatted_end": "01:07:05.760",
      "text": "سه ماهه میشاره؟"
    },
    {
      "id": 37,
      "start": 4025.76,
      "end": 4026.76,
      "formatted_start": "01:07:05.760",
      "formatted_end": "01:07:06.760",
      "text": "آره سه ماهه میشه"
    },
    {
      "id": 38,
      "start": 4026.76,
      "end": 4029.76,
      "formatted_start": "01:07:06.760",
      "formatted_end": "01:07:09.760",
      "text": "دوی اما عصرم میزنه، افونت کرده"
    },
    {
      "id": 39,
      "start": 4029.76,
      "end": 4031.76,
      "formatted_start": "01:07:09.760",
      "formatted_end": "01:07:11.760",
      "text": "دارو خوردنش خوبه دیگه ایشان؟"
    },
    {
      "id": 40,
      "start": 4031.76,
      "end": 4032.76,
      "formatted_start": "01:07:11.760",
      "formatted_end": "01:07:12.760",
      "text": "آره، میخوای"
    },
    {
      "id": 41,
      "start": 4032.76,
      "end": 4037.76,
      "formatted_start": "01:07:12.760",
      "formatted_end": "01:07:17.760",
      "text": "شربت این ها میبینیم تزدیری خیلی نیاز نیست خوب خوبچی کم هست"
    },
    {
      "id": 42,
      "start": 4037.76,
      "end": 4048.76,
      "formatted_start": "01:07:17.760",
      "formatted_end": "01:07:28.760",
      "text": "ولی دروهاش رو سر ساعت بدید اگر تا 48 ساعت بهتر شد ادامه درمان درقی این صورت بیارید من ببینم خوب"
    },
    {
      "id": 43,
      "start": 4048.76,
      "end": 4050.76,
      "formatted_start": "01:07:28.760",
      "formatted_end": "01:07:30.760",
      "text": "باز کنیم"
    },
    {
      "id": 44,
      "start": 4050.76,
      "end": 4052.76,
      "formatted_start": "01:07:30.760",
      "formatted_end": "01:07:32.760",
      "text": "گرفتیکی بینی هم داره؟"
    },
    {
      "id": 45,
      "start": 4052.76,
      "end": 4056.76,
      "formatted_start": "01:07:32.760",
      "formatted_end": "01:07:36.760",
      "text": "گرفتیکی بینی داره ولی یه اسپرا داره"
    },
    {
      "id": 46,
      "start": 4056.76,
      "end": 4058.76,
      "formatted_start": "01:07:36.760",
      "formatted_end": "01:07:38.760",
      "text": "چند کیلو وزنشه؟"
    },
    {
      "id": 47,
      "start": 4058.76,
      "end": 4061.76,
      "formatted_start": "01:07:38.760",
      "formatted_end": "01:07:41.760",
      "text": "آخرین بار 5.2 بیست بود"
    },
    {
      "id": 48,
      "start": 4061.76,
      "end": 4063.76,
      "formatted_start": "01:07:41.760",
      "formatted_end": "01:07:43.760",
      "text": "این خدمت شما خواهند گلکی"
    },
    {
      "id": 49,
      "start": 4063.76,
      "end": 4065.76,
      "formatted_start": "01:07:43.760",
      "formatted_end": "01:07:45.760",
      "text": "آقای تو بندشو کنی؟"
    },
    {
      "id": 50,
      "start": 4065.76,
      "end": 4067.76,
      "formatted_start": "01:07:45.760",
      "formatted_end": "01:07:47.760",
      "text": "بله دو ترازو بذار"
    },
    {
      "id": 51,
      "start": 4069.76,
      "end": 4071.76,
      "formatted_start": "01:07:49.760",
      "formatted_end": "01:07:51.760",
      "text": "هر ترگو بذارم"
    },
    {
      "id": 52,
      "start": 4071.76,
      "end": 4073.76,
      "formatted_start": "01:07:51.760",
      "formatted_end": "01:07:53.760",
      "text": "برقی نداری بذار"
    },
    {
      "id": 53,
      "start": 4081.76,
      "end": 4083.76,
      "formatted_start": "01:08:01.760",
      "formatted_end": "01:08:03.760",
      "text": "پنجم بشه"
    },
    {
      "id": 54,
      "start": 4085.76,
      "end": 4087.76,
      "formatted_start": "01:08:05.760",
      "formatted_end": "01:08:07.760",
      "text": "بخند"
    },
    {
      "id": 55,
      "start": 4087.76,
      "end": 4089.76,
      "formatted_start": "01:08:07.760",
      "formatted_end": "01:08:09.760",
      "text": "پس دو روز دیگر اگه خوب نشد بیارم بشم"
    },
    {
      "id": 56,
      "start": 4089.76,
      "end": 4119.76,
      "formatted_start": "01:08:09.760",
      "formatted_end": "01:08:39.760",
      "text": "بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره بره ب"
    },
    {
      "id": 57,
      "start": 4119.76,
      "end": 4149.76,
      "formatted_start": "01:08:39.760",
      "formatted_end": "01:09:09.760",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برد"
    },
    {
      "id": 58,
      "start": 4149.76,
      "end": 4153.76,
      "formatted_start": "01:09:09.760",
      "formatted_end": "01:09:13.760",
      "text": "برنامه این برنامه هم زرده هست"
    },
    {
      "id": 59,
      "start": 4153.76,
      "end": 4157.76,
      "formatted_start": "01:09:13.760",
      "formatted_end": "01:09:17.760",
      "text": "این بیاد هم زرده هست"
    },
    {
      "id": 60,
      "start": 4157.76,
      "end": 4161.76,
      "formatted_start": "01:09:17.760",
      "formatted_end": "01:09:21.760",
      "text": "گروه خونی شیه؟"
    },
    {
      "id": 61,
      "start": 4161.76,
      "end": 4165.76,
      "formatted_start": "01:09:21.760",
      "formatted_end": "01:09:25.760",
      "text": "گروه خونی مادرش شیه؟"
    },
    {
      "id": 62,
      "start": 4165.76,
      "end": 4169.76,
      "formatted_start": "01:09:25.760",
      "formatted_end": "01:09:29.760",
      "text": "او؟ او خوبی نیست"
    },
    {
      "id": 63,
      "start": 4169.76,
      "end": 4173.76,
      "formatted_start": "01:09:29.760",
      "formatted_end": "01:09:33.760",
      "text": "اگر پدرش که اینو او باشه با هم نیمیخوره"
    },
    {
      "id": 64,
      "start": 4173.76,
      "end": 4177.76,
      "formatted_start": "01:09:33.760",
      "formatted_end": "01:09:37.760",
      "text": "در نظر چه زرده های شدید میده"
    },
    {
      "id": 65,
      "start": 4177.76,
      "end": 4179.76,
      "formatted_start": "01:09:37.760",
      "formatted_end": "01:09:39.760",
      "text": "یکی از این بازه باید بسیاری کنید"
    },
    {
      "id": 66,
      "start": 4179.76,
      "end": 4181.76,
      "formatted_start": "01:09:39.760",
      "formatted_end": "01:09:41.760",
      "text": "یکی از این بازه باید بسیاری کنید"
    },
    {
      "id": 67,
      "start": 4181.76,
      "end": 4183.76,
      "formatted_start": "01:09:41.760",
      "formatted_end": "01:09:43.760",
      "text": "یکی از این بازه باید بسیاری کنید"
    },
    {
      "id": 68,
      "start": 4183.76,
      "end": 4185.76,
      "formatted_start": "01:09:43.760",
      "formatted_end": "01:09:45.760",
      "text": "خودت کوبوبات نخورد، لبنیات گاوی نخورد، بابنجو خیال خورد"
    },
    {
      "id": 69,
      "start": 4185.76,
      "end": 4187.76,
      "formatted_start": "01:09:45.760",
      "formatted_end": "01:09:47.760",
      "text": "خودت کوبوبات نخورد، لبنیات گاوی نخورد، بابنجو خیال خورد"
    },
    {
      "id": 70,
      "start": 4187.76,
      "end": 4189.76,
      "formatted_start": "01:09:47.760",
      "formatted_end": "01:09:49.760",
      "text": "اینها تقمیل میدهد، من برایش دارون میدویسم"
    },
    {
      "id": 71,
      "start": 4189.76,
      "end": 4191.76,
      "formatted_start": "01:09:49.760",
      "formatted_end": "01:09:51.760",
      "text": "اینها تقمیل میدویسم، من برایش دارون میدویسم"
    },
    {
      "id": 72,
      "start": 4191.76,
      "end": 4196.56,
      "formatted_start": "01:09:51.760",
      "formatted_end": "01:09:56.560",
      "text": "کنید چون زرده این باید یا بستری بشه یکی ها دستگاه ببرید کنه"
    },
    {
      "id": 73,
      "start": 4196.56,
      "end": 4197.76,
      "formatted_start": "01:09:56.560",
      "formatted_end": "01:09:57.760",
      "text": "هر کدام خیلی مهم کنید"
    }
