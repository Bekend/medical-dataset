  "stt_segments": [
    {
      "id": 0,
      "start": 18900.0,
      "end": 18929.98,
      "formatted_start": "05:15:00.000",
      "formatted_end": "05:15:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 18930.0,
      "end": 18932.0,
      "formatted_start": "05:15:30.000",
      "formatted_end": "05:15:32.000",
      "text": "اینجا باید بردنش رو بیمیسن"
    },
    {
      "id": 2,
      "start": 18932.0,
      "end": 18934.0,
      "formatted_start": "05:15:32.000",
      "formatted_end": "05:15:34.000",
      "text": "اینجا شکارش بوده من اونجا بیشتر"
    },
    {
      "id": 3,
      "start": 18934.0,
      "end": 18936.0,
      "formatted_start": "05:15:34.000",
      "formatted_end": "05:15:36.000",
      "text": "یه پومت خوند بزنم"
    },
    {
      "id": 4,
      "start": 18936.0,
      "end": 18938.0,
      "formatted_start": "05:15:36.000",
      "formatted_end": "05:15:38.000",
      "text": "اون پومت اینجا دیگه خوب کرده"
    },
    {
      "id": 5,
      "start": 18938.0,
      "end": 18940.0,
      "formatted_start": "05:15:38.000",
      "formatted_end": "05:15:40.000",
      "text": "مثل این گل هم مثل این پومت پس کرده موننده"
    },
    {
      "id": 6,
      "start": 18940.0,
      "end": 18942.0,
      "formatted_start": "05:15:40.000",
      "formatted_end": "05:15:42.000",
      "text": "اما خوب شده مونده"
    },
    {
      "id": 7,
      "start": 18942.0,
      "end": 18944.0,
      "formatted_start": "05:15:42.000",
      "formatted_end": "05:15:44.000",
      "text": "اون لکه هاش اونها برای چه وضعیت شده؟"
    },
    {
      "id": 8,
      "start": 18944.0,
      "end": 18946.0,
      "formatted_start": "05:15:44.000",
      "formatted_end": "05:15:46.000",
      "text": "زده آفتاب بزنی"
    },
    {
      "id": 9,
      "start": 18946.0,
      "end": 18948.0,
      "formatted_start": "05:15:46.000",
      "formatted_end": "05:15:48.000",
      "text": "بهتره بیرون که بیورید"
    },
    {
      "id": 10,
      "start": 18948.0,
      "end": 18950.0,
      "formatted_start": "05:15:48.000",
      "formatted_end": "05:15:50.000",
      "text": "زده آفتاب بزنی"
    },
    {
      "id": 11,
      "start": 18950.0,
      "end": 18952.0,
      "formatted_start": "05:15:50.000",
      "formatted_end": "05:15:52.000",
      "text": "خوشتش حساسه"
    },
    {
      "id": 12,
      "start": 18952.0,
      "end": 18954.0,
      "formatted_start": "05:15:52.000",
      "formatted_end": "05:15:54.000",
      "text": "اون لکه ها رو پیشتر بیموند"
    },
    {
      "id": 13,
      "start": 18954.0,
      "end": 18963.0,
      "formatted_start": "05:15:54.000",
      "formatted_end": "05:16:03.000",
      "text": "این درخواهی های مادر های اینجور میشه اول تولد شدنی آمده این لحقه ها وقتی شدن گفتن نه من به متوجه نشونم"
    },
    {
      "id": 14,
      "start": 18963.0,
      "end": 18968.0,
      "formatted_start": "05:16:03.000",
      "formatted_end": "05:16:08.000",
      "text": "خب پاک پیسر این درخواهی ها رو بده صفت کنم این شربت آزاده"
    },
    {
      "id": 15,
      "start": 18968.0,
      "end": 18974.0,
      "formatted_start": "05:16:08.000",
      "formatted_end": "05:16:14.000",
      "text": "خب خود در نظر عصبی آرام باش"
    },
    {
      "id": 16,
      "start": 18974.0,
      "end": 18976.0,
      "formatted_start": "05:16:14.000",
      "formatted_end": "05:16:16.000",
      "text": "خب"
    },
    {
      "id": 17,
      "start": 18976.0,
      "end": 18982.0,
      "formatted_start": "05:16:16.000",
      "formatted_end": "05:16:22.000",
      "text": "الان در حقه نداشت شکر نشونم"
    },
    {
      "id": 18,
      "start": 18982.0,
      "end": 18986.0,
      "formatted_start": "05:16:22.000",
      "formatted_end": "05:16:26.000",
      "text": "این دختر بزنه، من بخواهیم هر چیزت میده شگرفته"
    },
    {
      "id": 19,
      "start": 18986.0,
      "end": 18988.0,
      "formatted_start": "05:16:26.000",
      "formatted_end": "05:16:28.000",
      "text": "چون شیر نداره باید بگو"
    },
    {
      "id": 20,
      "start": 18988.0,
      "end": 18990.0,
      "formatted_start": "05:16:28.000",
      "formatted_end": "05:16:30.000",
      "text": "باید بگو اصلا ساره مرسی شیر درست نداره"
    },
    {
      "id": 21,
      "start": 18990.0,
      "end": 18991.0,
      "formatted_start": "05:16:30.000",
      "formatted_end": "05:16:31.000",
      "text": "شیر خوردن نداره"
    },
    {
      "id": 22,
      "start": 18991.0,
      "end": 18993.0,
      "formatted_start": "05:16:31.000",
      "formatted_end": "05:16:33.000",
      "text": "اینها رو بگیر بیار"
    },
    {
      "id": 23,
      "start": 18993.0,
      "end": 18995.0,
      "formatted_start": "05:16:33.000",
      "formatted_end": "05:16:35.000",
      "text": "من به توضیح بدم"
    },
    {
      "id": 24,
      "start": 18995.0,
      "end": 18996.0,
      "formatted_start": "05:16:35.000",
      "formatted_end": "05:16:36.000",
      "text": "سرمان خورده"
    },
    {
      "id": 25,
      "start": 18996.0,
      "end": 18997.0,
      "formatted_start": "05:16:36.000",
      "formatted_end": "05:16:37.000",
      "text": "باید بگو"
    },
    {
      "id": 26,
      "start": 18997.0,
      "end": 18999.0,
      "formatted_start": "05:16:37.000",
      "formatted_end": "05:16:39.000",
      "text": "و یه میدارم نفت خورده بیار"
    },
    {
      "id": 27,
      "start": 18999.0,
      "end": 19000.0,
      "formatted_start": "05:16:39.000",
      "formatted_end": "05:16:40.000",
      "text": "بسیار میکنه"
    },
    {
      "id": 28,
      "start": 19000.0,
      "end": 19001.0,
      "formatted_start": "05:16:40.000",
      "formatted_end": "05:16:41.000",
      "text": "خوش میکنه"
    },
    {
      "id": 29,
      "start": 19001.0,
      "end": 19003.0,
      "formatted_start": "05:16:41.000",
      "formatted_end": "05:16:43.000",
      "text": "بنابراین یه کرمزه چه میدونه؟"
    },
    {
      "id": 30,
      "start": 19003.0,
      "end": 19005.0,
      "formatted_start": "05:16:43.000",
      "formatted_end": "05:16:45.000",
      "text": "اینه باید بیده سرمان کرمزه آزاده"
    },
    {
      "id": 31,
      "start": 19005.0,
      "end": 19017.0,
      "formatted_start": "05:16:45.000",
      "formatted_end": "05:16:57.000",
      "text": "بخشم اونجورو تشکر میکنم"
    },
    {
      "id": 32,
      "start": 19017.0,
      "end": 19021.0,
      "formatted_start": "05:16:57.000",
      "formatted_end": "05:17:01.000",
      "text": "این ببینید قطعه و خمار توی چشم"
    },
    {
      "id": 33,
      "start": 19021.0,
      "end": 19024.0,
      "formatted_start": "05:17:01.000",
      "formatted_end": "05:17:04.000",
      "text": "اول دو سه قطعه توی چشم در دقیقه بعد خمار داخلی چشم"
    },
    {
      "id": 34,
      "start": 19024.0,
      "end": 19026.0,
      "formatted_start": "05:17:04.000",
      "formatted_end": "05:17:06.000",
      "text": "خمار اینجورو نداریم"
    },
    {
      "id": 35,
      "start": 19026.0,
      "end": 19028.0,
      "formatted_start": "05:17:06.000",
      "formatted_end": "05:17:08.000",
      "text": "مرسی تشکر میکنیم"
    },
    {
      "id": 36,
      "start": 19028.0,
      "end": 19036.0,
      "formatted_start": "05:17:08.000",
      "formatted_end": "05:17:16.000",
      "text": "خداحافظ"
    },
    {
      "id": 37,
      "start": 19058.0,
      "end": 19078.0,
      "formatted_start": "05:17:38.000",
      "formatted_end": "05:17:58.000",
      "text": "موسیقی"
    },
    {
      "id": 38,
      "start": 19088.0,
      "end": 19098.0,
      "formatted_start": "05:18:08.000",
      "formatted_end": "05:18:18.000",
      "text": "موسیقی"
    },
    {
      "id": 39,
      "start": 19118.0,
      "end": 19147.98,
      "formatted_start": "05:18:38.000",
      "formatted_end": "05:19:07.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 40,
      "start": 19148.0,
      "end": 19177.98,
      "formatted_start": "05:19:08.000",
      "formatted_end": "05:19:37.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 41,
