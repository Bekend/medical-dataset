      "id": 22,
      "start": 1363.0,
      "end": 1365.0,
      "formatted_start": "00:22:43.000",
      "formatted_end": "00:22:45.000",
      "text": "بچه با سیده"
    },
    {
      "id": 23,
      "start": 1365.0,
      "end": 1367.0,
      "formatted_start": "00:22:45.000",
      "formatted_end": "00:22:47.000",
      "text": "بچه با سیده"
    },
    {
      "id": 24,
      "start": 1367.0,
      "end": 1369.0,
      "formatted_start": "00:22:47.000",
      "formatted_end": "00:22:49.000",
      "text": "بچه با سیده"
    },
    {
      "id": 25,
      "start": 1369.0,
      "end": 1373.0,
      "formatted_start": "00:22:49.000",
      "formatted_end": "00:22:53.000",
      "text": "این صرفه شدید داره، سینه شمکونتی شده، صدا میده"
    },
    {
      "id": 26,
      "start": 1373.0,
      "end": 1374.0,
      "formatted_start": "00:22:53.000",
      "formatted_end": "00:22:54.000",
      "text": "صرفه شدید؟"
    },
    {
      "id": 27,
      "start": 1374.0,
      "end": 1377.0,
      "formatted_start": "00:22:54.000",
      "formatted_end": "00:22:57.000",
      "text": "تب هم داره، آبرزش بینی هم داره"
    },
    {
      "id": 28,
      "start": 1377.0,
      "end": 1380.0,
      "formatted_start": "00:22:57.000",
      "formatted_end": "00:23:00.000",
      "text": "تب، صرفه، آبرزش، خسخس سینه؟"
    },
    {
      "id": 29,
      "start": 1380.0,
      "end": 1386.0,
      "formatted_start": "00:23:00.000",
      "formatted_end": "00:23:06.000",
      "text": "بله، خسخس سینه، بعد من چهار پر روزه از ازری... ازری سماتی؟"
    },
    {
      "id": 30,
      "start": 1386.0,
      "end": 1387.0,
      "formatted_start": "00:23:06.000",
      "formatted_end": "00:23:07.000",
      "text": "آزیت رومانی سینه؟"
    },
    {
      "id": 31,
      "start": 1387.0,
      "end": 1388.0,
      "formatted_start": "00:23:07.000",
      "formatted_end": "00:23:08.000",
      "text": "آفره"
    },
    {
      "id": 32,
      "start": 1388.0,
      "end": 1389.0,
      "formatted_start": "00:23:08.000",
      "formatted_end": "00:23:09.000",
      "text": "از این کچیکا؟"
    },
    {
      "id": 33,
      "start": 1389.0,
      "end": 1390.0,
      "formatted_start": "00:23:09.000",
      "formatted_end": "00:23:10.000",
      "text": "بله، سله"
    },
    {
      "id": 34,
      "start": 1390.0,
      "end": 1391.0,
      "formatted_start": "00:23:10.000",
      "formatted_end": "00:23:11.000",
      "text": "بله، خود؟"
    },
    {
      "id": 35,
      "start": 1391.0,
      "end": 1393.0,
      "formatted_start": "00:23:11.000",
      "formatted_end": "00:23:13.000",
      "text": "بله، کوریزان هم سلمه خوردگی، از اونها پشت دادم"
    },
    {
      "id": 36,
      "start": 1393.0,
      "end": 1395.0,
      "formatted_start": "00:23:13.000",
      "formatted_end": "00:23:15.000",
      "text": "صرفه ها خوشت یا خلطی؟"
    },
    {
      "id": 37,
      "start": 1395.0,
      "end": 1425.0,
      "formatted_start": "00:23:15.000",
      "formatted_end": "00:23:45.000",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 38,
      "start": 1425.0,
      "end": 1428.44,
      "formatted_start": "00:23:45.000",
      "formatted_end": "00:23:48.440",
      "text": "سینه شان خسخس داره خیلی صدا میده سینه شان"
    },
    {
      "id": 39,
      "start": 1430.44,
      "end": 1433.4,
      "formatted_start": "00:23:50.440",
      "formatted_end": "00:23:53.400",
      "text": "این کامل اگه باشه خیلی بشکنه"
    },
    {
      "id": 40,
      "start": 1433.4,
      "end": 1435.16,
      "formatted_start": "00:23:53.400",
      "formatted_end": "00:23:55.160",
      "text": "از که اینطوری مریض شده؟"
    },
    {
      "id": 41,
      "start": 1435.16,
      "end": 1436.76,
      "formatted_start": "00:23:55.160",
      "formatted_end": "00:23:56.760",
      "text": "اینگه چار پنوز نمیشه"
    },
    {
      "id": 42,
      "start": 1436.76,
      "end": 1438.68,
      "formatted_start": "00:23:56.760",
      "formatted_end": "00:23:58.680",
      "text": "چار پنوز یاد؟ دوتا نبودی؟"
    },
    {
      "id": 43,
      "start": 1438.68,
      "end": 1439.4,
      "formatted_start": "00:23:58.680",
      "formatted_end": "00:23:59.400",
      "text": "نه"
    },
    {
      "id": 44,
      "start": 1439.4,
      "end": 1441.4,
      "formatted_start": "00:23:59.400",
      "formatted_end": "00:24:01.400",
      "text": "بس سریعتر اینجا بشکنه"
    },
    {
      "id": 45,
      "start": 1442.36,
      "end": 1444.76,
      "formatted_start": "00:24:02.360",
      "formatted_end": "00:24:04.760",
      "text": "اون یکی هم به سرمون هم مریض شده"
    },
    {
      "id": 46,
      "start": 1444.76,
      "end": 1445.56,
      "formatted_start": "00:24:04.760",
      "formatted_end": "00:24:05.560",
      "text": "دست چون میادی؟"
    },
    {
      "id": 47,
      "start": 1448.12,
      "end": 1449.08,
      "formatted_start": "00:24:08.120",
      "formatted_end": "00:24:09.080",
      "text": "بس میشت"
    },
    {
      "id": 48,
      "start": 1450.28,
      "end": 1450.92,
      "formatted_start": "00:24:10.280",
      "formatted_end": "00:24:10.920",
      "text": "خوب"
    },
    {
      "id": 49,
      "start": 1452.12,
      "end": 1453.0,
      "formatted_start": "00:24:12.120",
      "formatted_end": "00:24:13.000",
      "text": "برم شد"
    },
    {
      "id": 50,
      "start": 1453.0,
      "end": 1456.0,
      "formatted_start": "00:24:13.000",
      "formatted_end": "00:24:16.000",
      "text": "پانکول بشین در آنکه"
    },
    {
      "id": 51,
      "start": 1456.0,
      "end": 1461.0,
      "formatted_start": "00:24:16.000",
      "formatted_end": "00:24:21.000",
      "text": "بله حتما پانکولم می نیسم شهرباز اینا سینهشم خیلی وحشتناکه خانم احسن زایی"
    },
    {
      "id": 52,
      "start": 1461.0,
      "end": 1464.0,
      "formatted_start": "00:24:21.000",
      "formatted_end": "00:24:24.000",
      "text": "بله سینه خود بردم"
    },
    {
      "id": 53,
      "start": 1464.0,
      "end": 1466.0,
      "formatted_start": "00:24:24.000",
      "formatted_end": "00:24:26.000",
      "text": "پانکول چنده؟"
    },
    {
      "id": 54,
      "start": 1466.0,
      "end": 1469.0,
      "formatted_start": "00:24:26.000",
      "formatted_end": "00:24:29.000",
      "text": "پانکول تو سه تا می نیسم سه تا دوتا را الان می زنید"
    },
    {
      "id": 55,
      "start": 1469.0,
      "end": 1471.0,
      "formatted_start": "00:24:29.000",
      "formatted_end": "00:24:31.000",
      "text": "دوتا شهران؟"
    },
    {
      "id": 56,
      "start": 1471.0,
      "end": 1472.0,
      "formatted_start": "00:24:31.000",
      "formatted_end": "00:24:32.000",
      "text": "یکیشم"
    },
    {
      "id": 57,
      "start": 1472.0,
      "end": 1473.0,
      "formatted_start": "00:24:32.000",
      "formatted_end": "00:24:33.000",
      "text": "فردا"
    },
    {
      "id": 58,
      "start": 1473.0,
      "end": 1474.0,
      "formatted_start": "00:24:33.000",
      "formatted_end": "00:24:34.000",
      "text": "فردا"
    },
    {
      "id": 59,
      "start": 1474.0,
      "end": 1475.0,
      "formatted_start": "00:24:34.000",
      "formatted_end": "00:24:35.000",
      "text": "خروب یا فردا حالا فرق نیست"
    },
    {
      "id": 60,
      "start": 1475.0,
      "end": 1476.0,
      "formatted_start": "00:24:35.000",
      "formatted_end": "00:24:36.000",
      "text": "فردا"
    },
    {
      "id": 61,
      "start": 1476.0,
      "end": 1477.0,
      "formatted_start": "00:24:36.000",
      "formatted_end": "00:24:37.000",
      "text": "خوب؟"
    },
    {
      "id": 62,
      "start": 1477.0,
      "end": 1478.0,
      "formatted_start": "00:24:37.000",
      "formatted_end": "00:24:38.000",
      "text": "بله"
    },
    {
      "id": 63,
      "start": 1478.0,
      "end": 1480.0,
      "formatted_start": "00:24:38.000",
      "formatted_end": "00:24:40.000",
      "text": "بعد این دارواشم بیا و منو ببینم"
    },
    {
      "id": 64,
      "start": 1480.0,
      "end": 1481.0,
      "formatted_start": "00:24:40.000",
      "formatted_end": "00:24:41.000",
      "text": "باشه"
    },
    {
      "id": 65,
      "start": 1481.0,
      "end": 1483.0,
      "formatted_start": "00:24:41.000",
      "formatted_end": "00:24:43.000",
      "text": "سابقه آسمواره که اینو نداشته؟"
    },
    {
      "id": 66,
      "start": 1483.0,
      "end": 1486.0,
      "formatted_start": "00:24:43.000",
      "formatted_end": "00:24:46.000",
      "text": "نه، بار اولش مریض شده تو این ششوه ها"
    },
    {
      "id": 67,
      "start": 1487.0,
      "end": 1489.0,
      "formatted_start": "00:24:47.000",
      "formatted_end": "00:24:49.000",
      "text": "نکنیم، بس نزدیک"
    },
    {
      "id": 68,
      "start": 1489.0,
      "end": 1491.0,
      "formatted_start": "00:24:49.000",
      "formatted_end": "00:24:51.000",
      "text": "نمیدونیم، با چرا بیدیم؟"
    },
    {
      "id": 69,
      "start": 1491.0,
      "end": 1493.0,
      "formatted_start": "00:24:51.000",
      "formatted_end": "00:24:53.000",
      "text": "ساعت"
    },
    {
      "id": 70,
      "start": 1496.0,
      "end": 1499.0,
      "formatted_start": "00:24:56.000",
      "formatted_end": "00:24:59.000",
      "text": "بس این پسر هم خوبه اگه از همینو بلا بگیرم"
    }
  ],
  "status": "completed"
}