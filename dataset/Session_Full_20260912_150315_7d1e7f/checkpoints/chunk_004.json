    {
      "id": 4,
      "start": 1290.0,
      "end": 1293.0,
      "formatted_start": "00:21:30.000",
      "formatted_end": "00:21:33.000",
      "text": "بعد این آروزی سه بار آمپولایش هم بدیم بزنید"
    },
    {
      "id": 5,
      "start": 1293.0,
      "end": 1295.0,
      "formatted_start": "00:21:33.000",
      "formatted_end": "00:21:35.000",
