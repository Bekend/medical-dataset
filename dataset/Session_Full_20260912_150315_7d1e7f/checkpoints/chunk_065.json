  "stt_segments": [
    {
      "id": 0,
      "start": 19500.0,
      "end": 19503.0,
      "formatted_start": "05:25:00.000",
      "formatted_end": "05:25:03.000",
      "text": "سلام موسیقی جان، کجا هستی؟"
    },
    {
      "id": 1,
      "start": 19503.0,
      "end": 19505.0,
      "formatted_start": "05:25:03.000",
      "formatted_end": "05:25:05.000",
      "text": "آزم بومبی و آزم یوی بیشتر."
    },
    {
      "id": 2,
      "start": 19505.0,
      "end": 19516.0,
      "formatted_start": "05:25:05.000",
      "formatted_end": "05:25:16.000",
      "text": "آه، عجبکاریه، خب الان بچه ها میانن فلکه هستن، همین دور فلکه الان منم میام، با ماشین از گمبت میانید اینا باشید، مرسی خدا باشید، دور فلکه خودست."
    },
    {
      "id": 3,
      "start": 19516.0,
      "end": 19517.0,
      "formatted_start": "05:25:16.000",
      "formatted_end": "05:25:17.000",
      "text": "خوب؟"
    },
    {
      "id": 4,
      "start": 19517.0,
      "end": 19520.0,
      "formatted_start": "05:25:17.000",
      "formatted_end": "05:25:20.000",
      "text": "جنب کلی که خودم حساب کردم، نو خورده ای بود."
    },
    {
      "id": 5,
      "start": 19520.0,
      "end": 19521.0,
      "formatted_start": "05:25:20.000",
      "formatted_end": "05:25:21.000",
      "text": "چی؟"
    },
    {
      "id": 6,
      "start": 19521.0,
      "end": 19524.0,
      "formatted_start": "05:25:21.000",
      "formatted_end": "05:25:24.000",
      "text": "نو خورده ای شد که خودم حساب کردم، بله."
    },
    {
      "id": 7,
      "start": 19524.0,
      "end": 19524.5,
      "formatted_start": "05:25:24.000",
      "formatted_end": "05:25:24.500",
      "text": "بله"
    },
    {
      "id": 8,
      "start": 19524.5,
      "end": 19526.28,
      "formatted_start": "05:25:24.500",
      "formatted_end": "05:25:26.280",
      "text": "بعد همه رو از یه کارتان کشیدی"
    },
    {
      "id": 9,
      "start": 19526.28,
      "end": 19526.78,
      "formatted_start": "05:25:26.280",
      "formatted_end": "05:25:26.780",
      "text": "بله"
    },
    {
      "id": 10,
      "start": 19526.78,
      "end": 19527.28,
      "formatted_start": "05:25:26.780",
      "formatted_end": "05:25:27.280",
      "text": "بله"
    },
    {
      "id": 11,
      "start": 19527.28,
      "end": 19529.74,
      "formatted_start": "05:25:27.280",
      "formatted_end": "05:25:29.740",
      "text": "این کارتان رو صبح کشیدی"
    },
    {
      "id": 12,
      "start": 19529.74,
      "end": 19531.24,
      "formatted_start": "05:25:29.740",
      "formatted_end": "05:25:31.240",
      "text": "خواستی یه کارتان دیگه می کشید"
    },
    {
      "id": 13,
      "start": 19531.24,
      "end": 19531.74,
      "formatted_start": "05:25:31.240",
      "formatted_end": "05:25:31.740",
      "text": "که"
    },
    {
      "id": 14,
      "start": 19531.74,
      "end": 19533.76,
      "formatted_start": "05:25:31.740",
      "formatted_end": "05:25:33.760",
      "text": "این کارتان که نگه شو باش کن سنگی می کشه"
    },
    {
      "id": 15,
      "start": 19533.76,
      "end": 19535.82,
      "formatted_start": "05:25:33.760",
      "formatted_end": "05:25:35.820",
      "text": "خب نه یکی دیگه جدید اومده است"
    },
    {
      "id": 16,
      "start": 19535.82,
      "end": 19538.24,
      "formatted_start": "05:25:35.820",
      "formatted_end": "05:25:38.240",
      "text": "اگه با اشکال نداته کنم همین عدد برمی آد"
    },
    {
      "id": 17,
      "start": 19538.24,
      "end": 19540.4,
      "formatted_start": "05:25:38.240",
      "formatted_end": "05:25:40.400",
      "text": "دستگاه هم دو و شیست ست بوده"
    },
    {
      "id": 18,
      "start": 19540.4,
      "end": 19541.46,
      "formatted_start": "05:25:40.400",
      "formatted_end": "05:25:41.460",
      "text": "روزیده شیست ست"
    },
    {
      "id": 19,
      "start": 19541.46,
      "end": 19542.0,
      "formatted_start": "05:25:41.460",
      "formatted_end": "05:25:42.000",
      "text": "اوه"
    },
    {
      "id": 20,
      "start": 19542.0,
      "end": 19544.52,
      "formatted_start": "05:25:42.000",
      "formatted_end": "05:25:44.520",
      "text": "اینه اما هفت ست پونسد و پنجده شیست ست"
    },
    {
      "id": 21,
      "start": 19544.52,
      "end": 19545.24,
      "formatted_start": "05:25:44.520",
      "formatted_end": "05:25:45.240",
      "text": "بله بله"
    },
    {
      "id": 22,
      "start": 19554.0,
      "end": 19558.0,
      "formatted_start": "05:25:54.000",
      "formatted_end": "05:25:58.000",
      "text": "این مریض تو داروخانه هیه؟"
    },
    {
      "id": 23,
      "start": 19558.0,
      "end": 19562.0,
      "formatted_start": "05:25:58.000",
      "formatted_end": "05:26:02.000",
      "text": "داروخانه"
    },
    {
      "id": 24,
      "start": 19562.0,
      "end": 19566.0,
      "formatted_start": "05:26:02.000",
      "formatted_end": "05:26:06.000",
      "text": "داروخانه پایینه؟"
    },
    {
      "id": 25,
      "start": 19566.0,
      "end": 19570.0,
      "formatted_start": "05:26:06.000",
      "formatted_end": "05:26:10.000",
      "text": "این پایین؟"
    },
    {
      "id": 26,
      "start": 19570.0,
      "end": 19574.0,
      "formatted_start": "05:26:10.000",
      "formatted_end": "05:26:14.000",
      "text": "خب من الان بدم داروخانه ببینم این داروها شد"
    },
    {
      "id": 27,
      "start": 19574.0,
      "end": 19578.0,
      "formatted_start": "05:26:14.000",
      "formatted_end": "05:26:18.000",
      "text": "فامیلیتون چی بود؟"
    },
    {
      "id": 28,
      "start": 19578.0,
      "end": 19608.0,
      "formatted_start": "05:26:18.000",
      "formatted_end": "05:26:48.000",
      "text": "اوه، دیگه باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 29,
      "start": 19608.0,
      "end": 19628.0,
      "formatted_start": "05:26:48.000",
      "formatted_end": "05:27:08.000",
      "text": "موسیقی"
    },
