    },
    {
      "id": 16,
      "start": 88.0,
      "end": 95.0,
      "formatted_start": "00:01:28.000",
      "formatted_end": "00:01:35.000",
      "text": "هم شیر شهزاد کمریکلیتی هستید و درخواهدش کنستران درخواهدش علمی هم موجود دارند"
    },
    {
      "id": 17,
      "start": 95.0,
      "end": 102.0,
      "formatted_start": "00:01:35.000",
      "formatted_end": "00:01:42.000",
      "text": "سپنبرو بانی یوانه ناسف کافاون و ای آر ای فوتوری تا دیگه هم درخواهدش موجود هستند"
    },
    {
      "id": 18,
      "start": 102.0,
      "end": 112.0,
      "formatted_start": "00:01:42.000",
      "formatted_end": "00:01:52.000",
      "text": "سری نیاز شد و مدن شیرهای پاکتی که مرسی دهداش میدن هم توی بیشتر داخلش اکنون داشته شد"
    },
    {
      "id": 19,
      "start": 112.0,
      "end": 117.0,
      "formatted_start": "00:01:52.000",
      "formatted_end": "00:01:57.000",
      "text": "برد نده دستتون درد نکنه ممنون سفر خدا فیلم"
    },
    {
      "id": 20,
      "start": 122.0,
      "end": 126.0,
      "formatted_start": "00:02:02.000",
      "formatted_end": "00:02:06.000",
      "text": "بپنید سلامتا چون خوبه در رو بیزن بگیرم"
    },
    {
      "id": 21,
      "start": 131.0,
      "end": 134.0,
      "formatted_start": "00:02:11.000",
      "formatted_end": "00:02:14.000",
      "text": "اون برگیر رو بیزن بگیرم"
    },
    {
      "id": 22,
      "start": 142.0,
      "end": 150.0,
      "formatted_start": "00:02:22.000",
      "formatted_end": "00:02:30.000",
