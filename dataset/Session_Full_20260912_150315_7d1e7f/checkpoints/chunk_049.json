  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14703.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:03.000",
      "text": "اگر شما خیلی نگرانید بستری شو."
    },
    {
      "id": 1,
      "start": 14703.0,
      "end": 14708.0,
      "formatted_start": "04:05:03.000",
      "formatted_end": "04:05:08.000",
      "text": "من تنها نگرانید اینکه این تا میخواب خفه میشه."
    },
    {
      "id": 2,
      "start": 14708.0,
      "end": 14709.0,
      "formatted_start": "04:05:08.000",
      "formatted_end": "04:05:09.000",
      "text": "این ها متایش شدن."
    },
    {
      "id": 3,
      "start": 14709.0,
      "end": 14714.0,
      "formatted_start": "04:05:09.000",
      "formatted_end": "04:05:14.000",
      "text": "اینکه نگرانید اینکه این نیمی خواب. این دیگه چشماش خوردنگاش صده بیرون."
    },
    {
      "id": 4,
      "start": 14714.0,
      "end": 14717.0,
      "formatted_start": "04:05:14.000",
      "formatted_end": "04:05:17.000",
      "text": "حالا عرض می کنم شما میتونید چه نقش ساعت این درگاه رو بیرون؟"
    },
    {
      "id": 5,
      "start": 14717.0,
      "end": 14718.0,
      "formatted_start": "04:05:17.000",
      "formatted_end": "04:05:18.000",
      "text": "آره."
    },
    {
      "id": 6,
      "start": 14718.0,
      "end": 14719.0,
      "formatted_start": "04:05:18.000",
      "formatted_end": "04:05:19.000",
      "text": "نشد؟ بسه."
    },
    {
      "id": 7,
      "start": 14719.0,
      "end": 14722.0,
      "formatted_start": "04:05:19.000",
      "formatted_end": "04:05:22.000",
      "text": "من اینجوری بستری خواستم خواهم بسه و بجنب بگم."
    },
    {
      "id": 8,
      "start": 14722.0,
      "end": 14724.0,
      "formatted_start": "04:05:22.000",
      "formatted_end": "04:05:24.000",
      "text": "ما استرس وارد میکنیم از دو نفر اومدیم"
    },
    {
      "id": 9,
      "start": 14724.0,
      "end": 14727.0,
      "formatted_start": "04:05:24.000",
      "formatted_end": "04:05:27.000",
      "text": "حتی نمیدونید چی نیست در حالی"
    },
    {
      "id": 10,
      "start": 14727.0,
      "end": 14729.0,
      "formatted_start": "04:05:27.000",
      "formatted_end": "04:05:29.000",
      "text": "آره میدونم دفت میکنم شرایطی کنم"
    },
    {
      "id": 11,
      "start": 14729.0,
      "end": 14732.0,
      "formatted_start": "04:05:29.000",
      "formatted_end": "04:05:32.000",
      "text": "ولی باید قرب روی یه سرات وایستیم"
    },
    {
      "id": 12,
      "start": 14732.0,
      "end": 14734.0,
      "formatted_start": "04:05:32.000",
      "formatted_end": "04:05:34.000",
      "text": "یا بستریش کنیم"
    },
    {
      "id": 13,
      "start": 14734.0,
      "end": 14736.0,
      "formatted_start": "04:05:34.000",
      "formatted_end": "04:05:36.000",
      "text": "یا اینکه دارا رو مرتب بدید"
    },
    {
      "id": 14,
      "start": 14736.0,
      "end": 14738.0,
      "formatted_start": "04:05:36.000",
      "formatted_end": "04:05:38.000",
      "text": "سعی کنید آرامش داشته باشید انشالله ببینید"
    },
    {
      "id": 15,
      "start": 14738.0,
      "end": 14740.0,
      "formatted_start": "04:05:38.000",
      "formatted_end": "04:05:40.000",
      "text": "اینفکل ماشیدمش؟"
    },
    {
      "id": 16,
      "start": 14740.0,
      "end": 14742.0,
      "formatted_start": "04:05:40.000",
      "formatted_end": "04:05:42.000",
      "text": "ببینید حتی من در این تیفون پیگی بست نوشتم"
    },
    {
      "id": 17,
      "start": 14742.0,
      "end": 14743.0,
      "formatted_start": "04:05:42.000",
      "formatted_end": "04:05:43.000",
      "text": "جنس بخوریم"
    },
    {
      "id": 18,
      "start": 14743.0,
      "end": 14747.0,
      "formatted_start": "04:05:43.000",
      "formatted_end": "04:05:47.000",
      "text": "میخواییم اونو بده یا اون اینفاکل اگر حق بدم که بدیم"
    },
    {
      "id": 19,
      "start": 14747.0,
      "end": 14749.0,
      "formatted_start": "04:05:47.000",
      "formatted_end": "04:05:49.000",
      "text": "میخواییم اینفاکل رو یکمان بدم"
    },
    {
      "id": 20,
      "start": 14749.0,
      "end": 14753.0,
      "formatted_start": "04:05:49.000",
      "formatted_end": "04:05:53.000",
      "text": "اگر جوابی نیست اینفاکل بده اگر چیز نیست اینو پیدی بسته بدیم"
    },
    {
      "id": 21,
      "start": 14753.0,
      "end": 14755.0,
      "formatted_start": "04:05:53.000",
      "formatted_end": "04:05:55.000",
      "text": "حالا میگه دیگر من بد میگم"
    },
    {
      "id": 22,
      "start": 14755.0,
      "end": 14757.0,
      "formatted_start": "04:05:55.000",
      "formatted_end": "04:05:57.000",
      "text": "ممکنه گرشت جیبای زیاده چیز نیست"
    },
    {
      "id": 23,
      "start": 14757.0,
      "end": 14760.0,
      "formatted_start": "04:05:57.000",
      "formatted_end": "04:06:00.000",
      "text": "نه نه، اکنون میگرده دیگه اینجوری نیست که"
    },
    {
      "id": 24,
      "start": 14761.0,
      "end": 14762.0,
      "formatted_start": "04:06:01.000",
      "formatted_end": "04:06:02.000",
      "text": "تمام خواهیش نمیدونی؟"
    },
    {
      "id": 25,
      "start": 14762.0,
      "end": 14763.0,
      "formatted_start": "04:06:02.000",
      "formatted_end": "04:06:03.000",
      "text": "خواهیش نمیدونی؟"
    },
    {
      "id": 26,
      "start": 14763.0,
      "end": 14764.0,
      "formatted_start": "04:06:03.000",
      "formatted_end": "04:06:04.000",
      "text": "خواهیش نمیدونی؟ دارو بشون دیگه من بگم خدا فاستم"
    },
    {
      "id": 27,
      "start": 14764.0,
      "end": 14765.0,
      "formatted_start": "04:06:04.000",
      "formatted_end": "04:06:05.000",
      "text": "خدا فاستم"
    },
    {
      "id": 28,
      "start": 14777.0,
      "end": 14778.0,
      "formatted_start": "04:06:17.000",
      "formatted_end": "04:06:18.000",
      "text": "بخوند"
    },
    {
      "id": 29,
      "start": 14778.0,
      "end": 14779.0,
      "formatted_start": "04:06:18.000",
      "formatted_end": "04:06:19.000",
      "text": "سلام عباره باشم"
    },
    {
      "id": 30,
      "start": 14779.0,
      "end": 14780.0,
      "formatted_start": "04:06:19.000",
      "formatted_end": "04:06:20.000",
      "text": "سلام عباره باشم شما خوبه؟ خوش اومدی؟"
    },
    {
      "id": 31,
      "start": 14780.0,
      "end": 14781.0,
      "formatted_start": "04:06:20.000",
      "formatted_end": "04:06:21.000",
      "text": "خوش اومدی"
    },
    {
      "id": 32,
      "start": 14781.0,
      "end": 14782.0,
      "formatted_start": "04:06:21.000",
      "formatted_end": "04:06:22.000",
      "text": "بفهمین سلام"
    },
    {
      "id": 33,
      "start": 14782.0,
      "end": 14783.0,
      "formatted_start": "04:06:22.000",
      "formatted_end": "04:06:23.000",
      "text": "سلام خواهی شما خوبه؟"
    },
    {
      "id": 34,
      "start": 14783.0,
      "end": 14784.0,
      "formatted_start": "04:06:23.000",
      "formatted_end": "04:06:24.000",
      "text": "سلام خواهی شما خوبه؟"
    },
    {
      "id": 35,
      "start": 14784.0,
      "end": 14785.0,
      "formatted_start": "04:06:24.000",
      "formatted_end": "04:06:25.000",
      "text": "بسیار خوبه"
    },
    {
      "id": 36,
      "start": 14785.0,
      "end": 14787.0,
      "formatted_start": "04:06:25.000",
      "formatted_end": "04:06:27.000",
      "text": "برگتون رو بزرگ بده"
    },
    {
      "id": 37,
      "start": 14787.0,
      "end": 14789.0,
      "formatted_start": "04:06:27.000",
      "formatted_end": "04:06:29.000",
      "text": "خانوای کویسانی"
    },
    {
      "id": 38,
      "start": 14789.0,
      "end": 14790.0,
      "formatted_start": "04:06:29.000",
      "formatted_end": "04:06:30.000",
      "text": "سنشت قدر؟"
    },
    {
      "id": 39,
      "start": 14790.0,
      "end": 14791.0,
      "formatted_start": "04:06:30.000",
      "formatted_end": "04:06:31.000",
      "text": "دو ماه"
    },
    {
      "id": 40,
      "start": 14791.0,
      "end": 14792.0,
      "formatted_start": "04:06:31.000",
      "formatted_end": "04:06:32.000",
      "text": "چی شده؟"
    },
    {
      "id": 41,
      "start": 14792.0,
      "end": 14795.0,
      "formatted_start": "04:06:32.000",
      "formatted_end": "04:06:35.000",
      "text": "ویکتور این دو سه شبه"
    },
    {
      "id": 42,
      "start": 14795.0,
      "end": 14797.0,
      "formatted_start": "04:06:35.000",
      "formatted_end": "04:06:37.000",
      "text": "یه دوامه خیلی خاصی"
    },
    {
      "id": 43,
      "start": 14797.0,
      "end": 14798.0,
      "formatted_start": "04:06:37.000",
      "formatted_end": "04:06:38.000",
      "text": "اما صبح داره"
    },
    {
      "id": 44,
      "start": 14798.0,
      "end": 14799.0,
      "formatted_start": "04:06:38.000",
      "formatted_end": "04:06:39.000",
      "text": "برسافت سر همیوری"
    },
    {
      "id": 45,
      "start": 14799.0,
      "end": 14801.0,
      "formatted_start": "04:06:39.000",
      "formatted_end": "04:06:41.000",
      "text": "هشت به بعد که میشه این شروع میمونه"
    },
    {
      "id": 46,
      "start": 14801.0,
      "end": 14803.0,
      "formatted_start": "04:06:41.000",
      "formatted_end": "04:06:43.000",
      "text": "دیده این باید بسیار"
    },
    {
      "id": 47,
      "start": 14803.0,
      "end": 14805.0,
      "formatted_start": "04:06:43.000",
      "formatted_end": "04:06:45.000",
      "text": "این"
    },
    {
      "id": 48,
      "start": 14808.0,
      "end": 14810.0,
      "formatted_start": "04:06:48.000",
      "formatted_end": "04:06:50.000",
      "text": "سلام آب موسیقی"
    },
    {
      "id": 49,
      "start": 14810.0,
      "end": 14811.0,
      "formatted_start": "04:06:50.000",
      "formatted_end": "04:06:51.000",
      "text": "خوبی؟"
    },
    {
      "id": 50,
      "start": 14811.0,
      "end": 14813.0,
      "formatted_start": "04:06:51.000",
      "formatted_end": "04:06:53.000",
      "text": "میرسی مجاکل جانم"
    },
    {
      "id": 51,
      "start": 14813.0,
      "end": 14819.42,
      "formatted_start": "04:06:53.000",
      "formatted_end": "04:06:59.420",
      "text": "من ماشین گفتم خانم سمیت 7.5 ماشین بچه ها از بومبت میام با ماشین"
    },
    {
      "id": 52,
      "start": 14819.42,
      "end": 14825.6,
      "formatted_start": "04:06:59.420",
      "formatted_end": "04:07:05.600",
      "text": "خالقش کردم فقط 7.5 باش که یه درده باشه ممنون به ازش خواهی باشی"
    },
    {
      "id": 53,
      "start": 14825.6,
      "end": 14832.38,
      "formatted_start": "04:07:05.600",
      "formatted_end": "04:07:12.380",
      "text": "خب بردن تواله از اول بگیر تا حق 8 خوبه یه مرده شروع کنه"
    },
    {
      "id": 54,
      "start": 14832.38,
      "end": 14833.86,
      "formatted_start": "04:07:12.380",
      "formatted_end": "04:07:13.860",
      "text": "8 خوبه بودیم گیری کم"
    },
    {
      "id": 55,
      "start": 14833.86,
      "end": 14834.76,
      "formatted_start": "04:07:13.860",
      "formatted_end": "04:07:14.760",
      "text": "اینگار زنبور زده"
    },
    {
      "id": 56,
      "start": 14834.76,
      "end": 14836.06,
      "formatted_start": "04:07:14.760",
      "formatted_end": "04:07:16.060",
      "text": "اینگار تو زنبور زده بچه ها"
    },
    {
      "id": 57,
      "start": 14836.06,
      "end": 14838.06,
      "formatted_start": "04:07:16.060",
      "formatted_end": "04:07:18.060",
      "text": "تو برر میگیریده کم آرومه"
    },
    {
      "id": 58,
      "start": 14838.06,
      "end": 14838.92,
      "formatted_start": "04:07:18.060",
      "formatted_end": "04:07:18.920",
      "text": "خیلی کم"
    },
    {
      "id": 59,
      "start": 14838.92,
      "end": 14841.04,
      "formatted_start": "04:07:18.920",
      "formatted_end": "04:07:21.040",
      "text": "یه کم آرومه تو ماشین ساکت میشه"
    },
    {
      "id": 60,
      "start": 14841.04,
      "end": 14843.04,
      "formatted_start": "04:07:21.040",
      "formatted_end": "04:07:23.040",
      "text": "خوب قلادی ساخته"
    },
    {
      "id": 61,
      "start": 14843.04,
      "end": 14845.04,
      "formatted_start": "04:07:23.040",
      "formatted_end": "04:07:25.040",
      "text": "پانشی 5 دقیقه 10 دقیقه بعد میخوابه"
    },
    {
      "id": 62,
      "start": 14845.04,
      "end": 14847.04,
      "formatted_start": "04:07:25.040",
      "formatted_end": "04:07:27.040",
      "text": "اصلا میخوابه"
    },
    {
      "id": 63,
      "start": 14847.04,
      "end": 14849.04,
      "formatted_start": "04:07:27.040",
      "formatted_end": "04:07:29.040",
      "text": "به مرضی که بزرگی زمین یکجایی شروع میکنه"
    },
    {
      "id": 64,
      "start": 14849.04,
      "end": 14851.04,
      "formatted_start": "04:07:29.040",
      "formatted_end": "04:07:31.040",
      "text": "آره دیگه عصبی شدید"
    },
    {
      "id": 65,
      "start": 14851.04,
      "end": 14853.04,
      "formatted_start": "04:07:31.040",
      "formatted_end": "04:07:33.040",
      "text": "این ارگن باون میشه"
    },
    {
      "id": 66,
      "start": 14853.04,
      "end": 14855.04,
      "formatted_start": "04:07:33.040",
      "formatted_end": "04:07:35.040",
      "text": "دست و پاس شکسته"
    },
    {
      "id": 67,
      "start": 14855.04,
      "end": 14857.04,
      "formatted_start": "04:07:35.040",
      "formatted_end": "04:07:37.040",
      "text": "زمان زده"
    },
    {
      "id": 68,
      "start": 14857.04,
      "end": 14859.04,
      "formatted_start": "04:07:37.040",
      "formatted_end": "04:07:39.040",
      "text": "نه شیر میخوره"
    },
    {
      "id": 69,
      "start": 14859.04,
      "end": 14861.04,
      "formatted_start": "04:07:39.040",
      "formatted_end": "04:07:41.040",
      "text": "وقتی که میگیره شما هر کاری می کنید"
    },
    {
      "id": 70,
      "start": 14861.04,
      "end": 14863.04,
      "formatted_start": "04:07:41.040",
      "formatted_end": "04:07:43.040",
      "text": "سرات مستقیلیست"
    },
    {
      "id": 71,
      "start": 14863.04,
      "end": 14865.04,
      "formatted_start": "04:07:43.040",
      "formatted_end": "04:07:45.040",
      "text": "دو شبه هم میشوند"
    },
    {
      "id": 72,
      "start": 14865.04,
      "end": 14867.04,
      "formatted_start": "04:07:45.040",
      "formatted_end": "04:07:47.040",
      "text": "در این داران دو شبه سه شبه همیتوازه"
    },
    {
      "id": 73,
      "start": 14867.04,
      "end": 14870.7,
      "formatted_start": "04:07:47.040",
      "formatted_end": "04:07:50.700",
      "text": "بعدی دوران رو خودتون دادین کلی کنین و اینی و..."
    },
    {
      "id": 74,
      "start": 14870.7,
      "end": 14872.7,
      "formatted_start": "04:07:50.700",
      "formatted_end": "04:07:52.700",
      "text": "این رو که کهی دادیم؟"
    },
    {
      "id": 75,
      "start": 14872.7,
      "end": 14874.2,
      "formatted_start": "04:07:52.700",
      "formatted_end": "04:07:54.200",
      "text": "این رو کهی دادیم؟"
    },
    {
      "id": 76,
      "start": 14874.2,
      "end": 14878.0,
      "formatted_start": "04:07:54.200",
      "formatted_end": "04:07:58.000",
      "text": "این رو ما اون بعد به تولد هفته اول آورده بودیم"
    },
    {
      "id": 77,
      "start": 14878.0,
      "end": 14881.0,
      "formatted_start": "04:07:58.000",
      "formatted_end": "04:08:01.000",
      "text": "نه، من داریم یه ماه و بیس رو در دو ماه"
    },
    {
      "id": 78,
      "start": 14881.0,
      "end": 14883.0,
      "formatted_start": "04:08:01.000",
      "formatted_end": "04:08:03.000",
      "text": "یه ماه و نمونه مقدار"
    },
    {
      "id": 79,
      "start": 14883.0,
      "end": 14885.0,
      "formatted_start": "04:08:03.000",
      "formatted_end": "04:08:05.000",
      "text": "این رو داده بودیم؟"
    },
    {
      "id": 80,
      "start": 14885.0,
      "end": 14888.8,
      "formatted_start": "04:08:05.000",
      "formatted_end": "04:08:08.800",
      "text": "نارا رو ندادیم، دیسکلامیک پرستیدیم اصلا میدیم اون رو"
    },
    {
      "id": 81,
      "start": 14888.8,
      "end": 14894.32,
      "formatted_start": "04:08:08.800",
      "formatted_end": "04:08:14.320",
      "text": "فکر کردین زیر ششمان نباید دیدین و توی اینترنت سرچ کردین و گفتین دکتر عواصش نبوده"
    },
    {
      "id": 82,
      "start": 14894.32,
      "end": 14898.48,
      "formatted_start": "04:08:14.320",
      "formatted_end": "04:08:18.480",
      "text": "خنده هاتون یعنی امینا رو گفتی"
    },
    {
      "id": 83,
      "start": 14898.48,
      "end": 14901.24,
      "formatted_start": "04:08:18.480",
      "formatted_end": "04:08:21.240",
      "text": "خب ما بگو نگفته ما خود ما دلیل میگیم به تو"
    },
    {
      "id": 84,
      "start": 14901.24,
      "end": 14905.52,
      "formatted_start": "04:08:21.240",
      "formatted_end": "04:08:25.520",
      "text": "اینم که به اندازه سه روز دادیم خوشحکنسته؟ نه سه روز داریم"
    },
    {
      "id": 85,
      "start": 14905.52,
      "end": 14907.84,
      "formatted_start": "04:08:25.520",
      "formatted_end": "04:08:27.840",
      "text": "سه چهار؟ نه این بیزیان دلیل میشه بین خب برادر من"
    },
    {
      "id": 86,
      "start": 14907.84,
      "end": 14913.96,
      "formatted_start": "04:08:27.840",
      "formatted_end": "04:08:33.960",
      "text": "خوشحکن مورد بخوریم این اگر هشت ساعت یه باشه رو مورد بخوریم"
    },
    {
      "id": 87,
      "start": 14913.96,
      "end": 14915.96,
      "formatted_start": "04:08:33.960",
      "formatted_end": "04:08:35.960",
      "text": "این توی یک هفته تمامش"
    },
    {
      "id": 88,
      "start": 14915.96,
      "end": 14916.96,
      "formatted_start": "04:08:35.960",
      "formatted_end": "04:08:36.960",
      "text": "حقیقتشو بگم"
    },
    {
      "id": 89,
      "start": 14916.96,
      "end": 14917.96,
      "formatted_start": "04:08:36.960",
      "formatted_end": "04:08:37.960",
      "text": "این اولیش"
    },
    {
      "id": 90,
      "start": 14917.96,
      "end": 14919.96,
      "formatted_start": "04:08:37.960",
      "formatted_end": "04:08:39.960",
      "text": "من از مورد که یک ماه شد مرتبش دادم"
    },
    {
      "id": 91,
      "start": 14919.96,
      "end": 14922.96,
      "formatted_start": "04:08:39.960",
      "formatted_end": "04:08:42.960",
      "text": "ولی قبل زیر یک ماه بود زیاد مرتبش نیدم"
    },
    {
      "id": 92,
      "start": 14922.96,
      "end": 14923.96,
      "formatted_start": "04:08:42.960",
      "formatted_end": "04:08:43.960",
      "text": "خیلی بی قرار نشدیم"
    },
    {
      "id": 93,
      "start": 14923.96,
      "end": 14924.96,
      "formatted_start": "04:08:43.960",
      "formatted_end": "04:08:44.960",
      "text": "داری میرنی ما"
    },
    {
      "id": 94,
      "start": 14924.96,
      "end": 14925.96,
      "formatted_start": "04:08:44.960",
      "formatted_end": "04:08:45.960",
      "text": "خیلی میرنی داری"
    },
    {
      "id": 95,
      "start": 14925.96,
      "end": 14926.96,
      "formatted_start": "04:08:45.960",
      "formatted_end": "04:08:46.960",
      "text": "نه اینو که باز نکنی"
    },
    {
      "id": 96,
      "start": 14926.96,
      "end": 14928.96,
      "formatted_start": "04:08:46.960",
      "formatted_end": "04:08:48.960",
      "text": "این که اصلا ترسیبیت نداری"
    },
    {
      "id": 97,
      "start": 14928.96,
      "end": 14930.96,
      "formatted_start": "04:08:48.960",
      "formatted_end": "04:08:50.960",
      "text": "این هم کلی کشه"
    },
    {
      "id": 98,
      "start": 14930.96,
      "end": 14931.96,
      "formatted_start": "04:08:50.960",
      "formatted_end": "04:08:51.960",
      "text": "خب؟"
    },
    {
      "id": 99,
      "start": 14931.96,
      "end": 14932.96,
      "formatted_start": "04:08:51.960",
      "formatted_end": "04:08:52.960",
      "text": "این هم کلی کشه"
    },
    {
      "id": 100,
      "start": 14932.96,
      "end": 14934.96,
      "formatted_start": "04:08:52.960",
      "formatted_end": "04:08:54.960",
      "text": "ببین بس ساله اینجا"
    },
    {
      "id": 101,
      "start": 14934.96,
      "end": 14935.96,
      "formatted_start": "04:08:54.960",
      "formatted_end": "04:08:55.960",
      "text": "نه میدونیم نه اون"
    },
    {
      "id": 102,
      "start": 14935.96,
      "end": 14945.96,
      "formatted_start": "04:08:55.960",
      "formatted_end": "04:09:05.960",
      "text": "اگر شما بدمرضایی می‌گیدید، این گنونه می‌خرید، بعد یک کل پوک می‌گید،"
    },
    {
      "id": 103,
      "start": 14945.96,
      "end": 14951.96,
      "formatted_start": "04:09:05.960",
      "formatted_end": "04:09:11.960",
      "text": "دیسکرامین، کی دادین؟ یا مثلا توی اینترنت سریتون می‌گید، این بقل نمی‌شته زیر شیش ماه،"
    },
    {
      "id": 104,
      "start": 14951.96,
      "end": 14956.96,
      "formatted_start": "04:09:11.960",
      "formatted_end": "04:09:16.960",
      "text": "بعد می‌گید اونجایی نمی‌نمشت، نهواستش نمی‌دهد، ندم بچه هم هیچ نیشته."
    },
    {
      "id": 105,
      "start": 14956.96,
      "end": 14961.96,
      "formatted_start": "04:09:16.960",
      "formatted_end": "04:09:21.960",
      "text": "خب، پدرخواست زنگی می‌زنید، مثلا بگن آهای، فیلم نیم، این چیه دادی؟"
    },
    {
      "id": 106,
      "start": 14961.96,
      "end": 14965.96,
      "formatted_start": "04:09:21.960",
      "formatted_end": "04:09:25.960",
      "text": "من اینجا یه جوری خوندم، بیایی انترنت یه جوری خوندم، من توضیح بگم"
    },
    {
      "id": 107,
      "start": 14965.96,
      "end": 14969.96,
      "formatted_start": "04:09:25.960",
      "formatted_end": "04:09:29.960",
      "text": "خب، ببین دیسیکلامین آرام بخشه"
    },
    {
      "id": 108,
      "start": 14969.96,
      "end": 14972.96,
      "formatted_start": "04:09:29.960",
      "formatted_end": "04:09:32.960",
      "text": "بچه رفتی گریه می کنه هزار طریق لرد داره"
    },
    {
      "id": 109,
      "start": 14972.96,
      "end": 14976.96,
      "formatted_start": "04:09:32.960",
      "formatted_end": "04:09:36.960",
      "text": "زبون که نداره بگه میدمدم کنه یا کلیه، همه جا شده"
    },
    {
      "id": 110,
      "start": 14976.96,
      "end": 14980.96,
      "formatted_start": "04:09:36.960",
      "formatted_end": "04:09:40.960",
      "text": "برای که خوددهرمانی نشه، دیسیکلامین فوت آرامی می کنه"
    },
    {
      "id": 111,
      "start": 14980.96,
      "end": 14982.96,
      "formatted_start": "04:09:40.960",
      "formatted_end": "04:09:42.960",
      "text": "نمی سن زیر شیشونو ندید"
    },
    {
      "id": 112,
      "start": 14982.96,
      "end": 14985.96,
      "formatted_start": "04:09:42.960",
      "formatted_end": "04:09:45.960",
      "text": "که ببندر دکتر ببینه، تشکیز که به بعد بگیره"
    },
    {
      "id": 113,
      "start": 14985.96,
      "end": 14999.96,
      "formatted_start": "04:09:45.960",
      "formatted_end": "04:09:59.960",
      "text": "بعد چون قریضه سعی می کنند که اوایل مقدار را کم بدهند. مثلا ما می رویم این موقع بیقراری پونزر قطعه که این او اصلا هیچی نمیشه، خیلی بد نمیشه، خب؟ توی مسکه ما پونزر قطعه است."
    }
  ],
  "status": "completed"
}