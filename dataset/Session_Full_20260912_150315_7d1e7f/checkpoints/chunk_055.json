  "stt_segments": [
    {
      "id": 0,
      "start": 16500.0,
      "end": 16510.0,
      "formatted_start": "04:35:00.000",
      "formatted_end": "04:35:10.000",
      "text": "معاین اینا دارید؟ پیلیوست دارید؟ اونا رو بدید. یک شیاق هم می‌گیسان. اگر شکمش یک روز خواهر نکرد، یک شیاق از اقل بذارید که جورتر کار کنه."
    },
    {
      "id": 1,
      "start": 16510.0,
      "end": 16519.0,
      "formatted_start": "04:35:10.000",
      "formatted_end": "04:35:19.000",
      "text": "یک داروی گیایی هم هست به نام فروس. خوب؟ فروس، این داروش آزادیه، شروع توش کرد."
    },
    {
      "id": 2,
      "start": 16519.0,
      "end": 16525.0,
      "formatted_start": "04:35:19.000",
      "formatted_end": "04:35:25.000",
      "text": "اگر دیدید که شکمش فازی در میاره، برید از ابتاره می‌گیدید."
    },
    {
      "id": 3,
      "start": 16525.0,
      "end": 16530.0,
      "formatted_start": "04:35:25.000",
      "formatted_end": "04:35:30.000",
      "text": "یک مقدارشو میکنید که آب بلد مثل لیمون حلش کنید"
    },
    {
      "id": 4,
      "start": 16530.0,
      "end": 16534.0,
      "formatted_start": "04:35:30.000",
      "formatted_end": "04:35:34.000",
      "text": "از آبش یکاشوخ صبح یکاشوخ شب به ویدیو میدهید"
    },
    {
      "id": 5,
      "start": 16534.0,
      "end": 16537.0,
      "formatted_start": "04:35:34.000",
      "formatted_end": "04:35:37.000",
      "text": "خوب، این دروارم میگه این من ببینم"
    },
    {
      "id": 6,
      "start": 16537.0,
      "end": 16540.0,
      "formatted_start": "04:35:37.000",
      "formatted_end": "04:35:40.000",
      "text": "اون کار چیزو پیدی بسیار حتما داشتید"
    },
    {
      "id": 7,
      "start": 16540.0,
      "end": 16543.0,
      "formatted_start": "04:35:40.000",
      "formatted_end": "04:35:43.000",
      "text": "دیسکلامی رو اون موقعی بیقراری داره بشه"
    },
    {
      "id": 8,
      "start": 16543.0,
      "end": 16546.0,
      "formatted_start": "04:35:43.000",
      "formatted_end": "04:35:46.000",
      "text": "این دیسکلامی توی آورده داره نه؟"
    },
    {
      "id": 9,
      "start": 16546.0,
      "end": 16549.0,
      "formatted_start": "04:35:46.000",
      "formatted_end": "04:35:49.000",
      "text": "نه، وقتی میگه اشغال نداره یعنی شک داری"
    },
    {
      "id": 10,
      "start": 16549.0,
      "end": 16552.0,
      "formatted_start": "04:35:49.000",
      "formatted_end": "04:35:52.000",
      "text": "وقتی شک داشته باشی خوب نیمیدید"
    },
    {
      "id": 11,
      "start": 16552.0,
      "end": 16557.16,
      "formatted_start": "04:35:52.000",
      "formatted_end": "04:35:57.160",
      "text": "برای چی شکری خونده نوشته دیر شش ماه توسعه نمیشه وقتی اینترنت زدی"
    },
    {
      "id": 12,
      "start": 16557.16,
      "end": 16559.16,
      "formatted_start": "04:35:57.160",
      "formatted_end": "04:35:59.160",
      "text": "خواستن یه لحظه کسی داری؟"
    },
    {
      "id": 13,
      "start": 16559.16,
      "end": 16560.16,
      "formatted_start": "04:35:59.160",
      "formatted_end": "04:36:00.160",
      "text": "کسی که میخواد بشه"
    },
    {
      "id": 14,
      "start": 16560.16,
      "end": 16562.16,
      "formatted_start": "04:36:00.160",
      "formatted_end": "04:36:02.160",
      "text": "موضوع قطره"
    },
    {
      "id": 15,
      "start": 16562.16,
      "end": 16567.16,
      "formatted_start": "04:36:02.160",
      "formatted_end": "04:36:07.160",
      "text": "آره این مریض ها خیلی هم مریض هم الان همچند سا میگن هفت میکنن داروایی که میدن"
    },
    {
      "id": 16,
      "start": 16567.16,
      "end": 16569.16,
      "formatted_start": "04:36:07.160",
      "formatted_end": "04:36:09.160",
      "text": "این میدن این میدن"
    },
    {
      "id": 17,
      "start": 16569.16,
      "end": 16571.16,
      "formatted_start": "04:36:09.160",
      "formatted_end": "04:36:11.160",
      "text": "این کمبه دی اینو میگیره"
    },
    {
      "id": 18,
      "start": 16571.16,
      "end": 16573.16,
      "formatted_start": "04:36:11.160",
      "formatted_end": "04:36:13.160",
      "text": "برمید"
    },
    {
      "id": 19,
      "start": 16573.16,
      "end": 16575.16,
      "formatted_start": "04:36:13.160",
      "formatted_end": "04:36:15.160",
      "text": "یعنی نصف قطر شکار"
    },
    {
      "id": 20,
      "start": 16575.16,
      "end": 16577.16,
      "formatted_start": "04:36:15.160",
      "formatted_end": "04:36:17.160",
      "text": "نه یک قطر شکار"
    },
    {
      "id": 21,
      "start": 16577.16,
      "end": 16579.16,
      "formatted_start": "04:36:17.160",
      "formatted_end": "04:36:19.160",
      "text": "یک قطر شکار"
    },
    {
      "id": 22,
      "start": 16579.16,
      "end": 16581.16,
      "formatted_start": "04:36:19.160",
      "formatted_end": "04:36:21.160",
      "text": "پرک کنی یک سی سی"
    },
    {
      "id": 23,
      "start": 16581.16,
      "end": 16583.16,
      "formatted_start": "04:36:21.160",
      "formatted_end": "04:36:23.160",
      "text": "میشه یک میل"
    },
    {
      "id": 24,
      "start": 16583.16,
      "end": 16585.16,
      "formatted_start": "04:36:23.160",
      "formatted_end": "04:36:25.160",
      "text": "یک میل پونزر قطر"
    },
    {
      "id": 25,
      "start": 16585.16,
      "end": 16587.16,
      "formatted_start": "04:36:25.160",
      "formatted_end": "04:36:27.160",
      "text": "کمبه دیش تاثیر نیست"
    },
    {
      "id": 26,
      "start": 16587.16,
      "end": 16589.16,
      "formatted_start": "04:36:27.160",
      "formatted_end": "04:36:29.160",
      "text": "کمبه دی تاثیر نیست"
    },
    {
      "id": 27,
      "start": 16589.16,
      "end": 16591.16,
      "formatted_start": "04:36:29.160",
      "formatted_end": "04:36:31.160",
      "text": "ببینی سه چاپین"
    },
    {
      "id": 28,
      "start": 16591.16,
      "end": 16593.16,
      "formatted_start": "04:36:31.160",
      "formatted_end": "04:36:33.160",
      "text": "نصف کنی میشه هفت قطره"
    },
    {
      "id": 29,
      "start": 16593.16,
      "end": 16595.16,
      "formatted_start": "04:36:33.160",
      "formatted_end": "04:36:35.160",
      "text": "یکی دو قطره دهنش آخر میشه"
    },
    {
      "id": 30,
      "start": 16595.16,
      "end": 16599.16,
      "formatted_start": "04:36:35.160",
      "formatted_end": "04:36:39.160",
      "text": "اینکه دو قطر تا میری، دو سه قطر میسان پایین که تصویر بگیر"
    },
    {
      "id": 31,
      "start": 16599.16,
      "end": 16601.16,
      "formatted_start": "04:36:39.160",
      "formatted_end": "04:36:41.160",
      "text": "پونزه قطر بشید"
    },
    {
      "id": 32,
      "start": 16601.16,
      "end": 16603.16,
      "formatted_start": "04:36:41.160",
      "formatted_end": "04:36:43.160",
      "text": "خوش ممنون"
    },
    {
      "id": 33,
      "start": 16605.16,
      "end": 16607.16,
      "formatted_start": "04:36:45.160",
      "formatted_end": "04:36:47.160",
      "text": "درم بزنیم داریم"
    },
    {
      "id": 34,
      "start": 16625.16,
      "end": 16655.14,
      "formatted_start": "04:37:05.160",
      "formatted_end": "04:37:35.140",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 35,
      "start": 16655.16,
      "end": 16685.14,
      "formatted_start": "04:37:35.160",
      "formatted_end": "04:38:05.140",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 36,
      "start": 16685.16,
      "end": 16694.16,
      "formatted_start": "04:38:05.160",
      "formatted_end": "04:38:14.160",
      "text": "موسیقی"
    },
    {
      "id": 37,
      "start": 16715.16,
      "end": 16745.14,
      "formatted_start": "04:38:35.160",
      "formatted_end": "04:39:05.140",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 38,
      "start": 16745.16,
      "end": 16765.16,
      "formatted_start": "04:39:05.160",
      "formatted_end": "04:39:25.160",
      "text": "موسیقی"
    },
    {
      "id": 39,
      "start": 16765.16,
      "end": 16771.74,
      "formatted_start": "04:39:25.160",
      "formatted_end": "04:39:31.740",
      "text": "خب یه میوه خوشگل مشکل هیچی نیست جز قهوه نه سجده نه آیوه نه این چون از اونهای دیگه"
    },
    {
      "id": 40,
      "start": 16771.74,
      "end": 16777.06,
      "formatted_start": "04:39:31.740",
      "formatted_end": "04:39:37.060",
      "text": "اگه دقیق کنید رسیدهاشو جزار میکنن و سبزهاشو میزنن ببینید تا برسه"
    },
    {
      "id": 41,
      "start": 16777.06,
      "end": 16784.92,
      "formatted_start": "04:39:37.060",
      "formatted_end": "04:39:44.920",
      "text": "بعد این میوه جزا و سیبارو بعد از اینکه برداشت کردن میبنن و بوسه روشو میگیرن"
    },
    {
      "id": 42,
      "start": 16784.92,
      "end": 16792.82,
      "formatted_start": "04:39:44.920",
      "formatted_end": "04:39:52.820",
      "text": "بوسه روشو میگرفتن دانه درونش شامل دوترنب میمیشه که خواهد رو دینید اون لپه شکل خاصی گره"
    },
    {
      "id": 43,
      "start": 16792.82,
      "end": 16800.0,
      "formatted_start": "04:39:52.820",
      "formatted_end": "04:40:00.000",
      "text": "ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده ایده اید"
    }
