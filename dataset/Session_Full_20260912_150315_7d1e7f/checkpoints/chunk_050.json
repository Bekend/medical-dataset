  "stt_segments": [
    {
      "id": 0,
      "start": 15000.0,
      "end": 15004.5,
      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:04.500",
      "text": "۱۵ قطعه که میدید، ۱۰ دقیقه یه رو بیسترگ برد، بچه خواهد."
    },
    {
      "id": 1,
      "start": 15004.5,
      "end": 15013.0,
      "formatted_start": "04:10:04.500",
      "formatted_end": "04:10:13.000",
      "text": "من برای بچه های خودم، که اولم ۲۶ سالشونه، دادم به ۲۰ سالشونه، ۲۵ سالم که از سال ۸۰ توازن شمیم دادیم، ۱۰ سالم مشتر بودیم، دادیم."
    },
    {
      "id": 2,
      "start": 15013.0,
      "end": 15016.5,
      "formatted_start": "04:10:13.000",
      "formatted_end": "04:10:16.500",
      "text": "هیچ اتفاق ندارد و خیلی هم لازی بودن وقت خواهیم بودن."
    },
    {
      "id": 3,
      "start": 15016.5,
      "end": 15026.5,
      "formatted_start": "04:10:16.500",
      "formatted_end": "04:10:26.500",
      "text": "از این مریض ها متاسفانه هم بیرن تو این بر و اون بر و بعد اطلاعات اینترنت همینه خیلی هاشون مثلا تو فضای مجازی برست نیست"
    },
    {
      "id": 4,
      "start": 15026.5,
      "end": 15029.5,
      "formatted_start": "04:10:26.500",
      "formatted_end": "04:10:29.500",
      "text": "سلام"
    },
    {
      "id": 5,
      "start": 15029.5,
      "end": 15031.5,
      "formatted_start": "04:10:29.500",
      "formatted_end": "04:10:31.500",
      "text": "سلام"
    },
    {
      "id": 6,
      "start": 15031.5,
      "end": 15034.5,
      "formatted_start": "04:10:31.500",
      "formatted_end": "04:10:34.500",
      "text": "چطوری دو ما شالله چی شده؟"
    },
    {
      "id": 7,
      "start": 15034.5,
      "end": 15036.5,
      "formatted_start": "04:10:34.500",
      "formatted_end": "04:10:36.500",
      "text": "اسمی چی بود؟"
    },
    {
      "id": 8,
      "start": 15036.5,
      "end": 15037.5,
      "formatted_start": "04:10:36.500",
      "formatted_end": "04:10:37.500",
      "text": "پناه"
    },
    {
      "id": 9,
      "start": 15037.5,
      "end": 15039.5,
      "formatted_start": "04:10:37.500",
      "formatted_end": "04:10:39.500",
      "text": "خانم پناه"
    },
    {
      "id": 10,
      "start": 15039.5,
      "end": 15041.5,
      "formatted_start": "04:10:39.500",
      "formatted_end": "04:10:41.500",
      "text": "نافش بردست شده؟"
    },
    {
      "id": 11,
      "start": 15041.5,
      "end": 15044.5,
      "formatted_start": "04:10:41.500",
      "formatted_end": "04:10:44.500",
      "text": "نافش هم افتاده میخورد چون دیگه مشکلی نداره مشکلی براش ایجاد بود"
    },
    {
      "id": 12,
      "start": 15044.5,
      "end": 15048.0,
      "formatted_start": "04:10:44.500",
      "formatted_end": "04:10:48.000",
      "text": "نه ناکش خوشگیر باید نفت بره"
    },
    {
      "id": 13,
      "start": 15048.0,
      "end": 15050.0,
      "formatted_start": "04:10:48.000",
      "formatted_end": "04:10:50.000",
      "text": "برای تو پولنج داره"
    },
    {
      "id": 14,
      "start": 15050.0,
      "end": 15052.5,
      "formatted_start": "04:10:50.000",
      "formatted_end": "04:10:52.500",
      "text": "باید اینجا واکسنگ میجاشم زخ شده"
    },
    {
      "id": 15,
      "start": 15052.5,
      "end": 15053.5,
      "formatted_start": "04:10:52.500",
      "formatted_end": "04:10:53.500",
      "text": "اون طبیعیه"
    },
    {
      "id": 16,
      "start": 15053.5,
      "end": 15054.5,
      "formatted_start": "04:10:53.500",
      "formatted_end": "04:10:54.500",
      "text": "طبیعیه؟"
    },
    {
      "id": 17,
      "start": 15054.5,
      "end": 15055.5,
      "formatted_start": "04:10:54.500",
      "formatted_end": "04:10:55.500",
      "text": "زخ میشه یعنی که از سرش خوبه"
    },
    {
      "id": 18,
      "start": 15055.5,
      "end": 15058.5,
      "formatted_start": "04:10:55.500",
      "formatted_end": "04:10:58.500",
      "text": "باید یه مدد آیلیتون دالا شیر که می کنه"
    },
    {
      "id": 19,
      "start": 15058.5,
      "end": 15059.5,
      "formatted_start": "04:10:58.500",
      "formatted_end": "04:10:59.500",
      "text": "بفلاکس بوده دیگه"
    },
    {
      "id": 20,
      "start": 15059.5,
      "end": 15061.5,
      "formatted_start": "04:10:59.500",
      "formatted_end": "04:11:01.500",
      "text": "برای این یکم کم هست"
    },
    {
      "id": 21,
      "start": 15061.5,
      "end": 15063.5,
      "formatted_start": "04:11:01.500",
      "formatted_end": "04:11:03.500",
      "text": "الان سرش بالا میده"
    },
    {
      "id": 22,
      "start": 15063.5,
      "end": 15066.5,
      "formatted_start": "04:11:03.500",
      "formatted_end": "04:11:06.500",
      "text": "زیر سرش یه مقدار بالا می کنه مشکل نداره"
    },
    {
      "id": 23,
      "start": 15066.5,
      "end": 15070.66,
      "formatted_start": "04:11:06.500",
      "formatted_end": "04:11:10.660",
      "text": "اشکال مرسی هستم از شیر میدید همین حالت بخوابونین خوبون برگشت شیر کنید"
    },
    {
      "id": 24,
      "start": 15070.66,
      "end": 15074.5,
      "formatted_start": "04:11:10.660",
      "formatted_end": "04:11:14.500",
      "text": "بعد خودتون رژیم هزاییتون را رایت میکنید"
    },
    {
      "id": 25,
      "start": 15074.5,
      "end": 15077.9,
      "formatted_start": "04:11:14.500",
      "formatted_end": "04:11:17.900",
      "text": "خوبتین بادمجون و فیار و بابا و زبانیت"
    },
    {
      "id": 26,
      "start": 15077.9,
      "end": 15079.5,
      "formatted_start": "04:11:17.900",
      "formatted_end": "04:11:19.500",
      "text": "اینها کم خرمید"
    },
    {
      "id": 27,
      "start": 15079.5,
      "end": 15085.5,
      "formatted_start": "04:11:19.500",
      "formatted_end": "04:11:25.500",
      "text": "ولی استرس نداشته باشید مادرهایی که استرس کردن بچه هاوشون خیلی دستگیری دارن"
    },
    {
      "id": 28,
      "start": 15085.5,
      "end": 15092.5,
      "formatted_start": "04:11:25.500",
      "formatted_end": "04:11:32.500",
      "text": "استرس هم حیطا توی یک ارتفاع به اتفاق افتاده که من دقیقا دوست دارم استرس کردیم"
    },
    {
      "id": 29,
      "start": 15092.5,
      "end": 15094.5,
      "formatted_start": "04:11:32.500",
      "formatted_end": "04:11:34.500",
      "text": "از این موقعی که این استرس..."
    },
    {
      "id": 30,
      "start": 15094.5,
      "end": 15096.5,
      "formatted_start": "04:11:34.500",
      "formatted_end": "04:11:36.500",
      "text": "این برنامه های اینجوری هست"
    },
    {
      "id": 31,
      "start": 15096.5,
      "end": 15098.5,
      "formatted_start": "04:11:36.500",
      "formatted_end": "04:11:38.500",
      "text": "استرسش میگه آیا که برای چیه؟"
    },
    {
      "id": 32,
      "start": 15098.5,
      "end": 15100.5,
      "formatted_start": "04:11:38.500",
      "formatted_end": "04:11:40.500",
      "text": "این یه بدن شروع به خوارش کرد"
    },
    {
      "id": 33,
      "start": 15100.5,
      "end": 15102.5,
      "formatted_start": "04:11:40.500",
      "formatted_end": "04:11:42.500",
      "text": "خوارش کرد"
    },
    {
      "id": 34,
      "start": 15102.5,
      "end": 15106.5,
      "formatted_start": "04:11:42.500",
      "formatted_end": "04:11:46.500",
      "text": "این برنامه های اینجوری همینجوری شد"
    },
    {
      "id": 35,
      "start": 15106.5,
      "end": 15108.5,
      "formatted_start": "04:11:46.500",
      "formatted_end": "04:11:48.500",
      "text": "این برنامه های اینجوری بودیم یه پاماده میدیریم که"
    },
    {
      "id": 36,
      "start": 15108.5,
      "end": 15110.5,
      "formatted_start": "04:11:48.500",
      "formatted_end": "04:11:50.500",
      "text": "به این برنامه های خوارش روزیر"
    },
    {
      "id": 37,
      "start": 15110.5,
      "end": 15112.5,
      "formatted_start": "04:11:50.500",
      "formatted_end": "04:11:52.500",
      "text": "رفتیم دکتر گفت که این چیه؟"
    },
    {
      "id": 38,
      "start": 15112.5,
      "end": 15114.5,
      "formatted_start": "04:11:52.500",
      "formatted_end": "04:11:54.500",
      "text": "چه بازیش؟ فلانه؟ گاهی داری؟"
    },
    {
      "id": 39,
      "start": 15114.5,
      "end": 15116.5,
      "formatted_start": "04:11:54.500",
      "formatted_end": "04:11:56.500",
      "text": "اینه؟ فلانه؟ نه؟"
    },
    {
      "id": 40,
      "start": 15116.5,
      "end": 15127.5,
      "formatted_start": "04:11:56.500",
      "formatted_end": "04:12:07.500",
      "text": "این دیگه شروع کرد. خانم ما هم یا یک آدم استرسی اصلا در حد از دیگه بردیمش با تخصیص و فلان و اینها پیش او های عددی گنبری رو گفت نه این کشی بفته این گانواره"
    },
    {
      "id": 41,
      "start": 15127.5,
      "end": 15134.5,
      "formatted_start": "04:12:07.500",
      "formatted_end": "04:12:14.500",
      "text": "این چیز شدیده. حساسیت شدیده. از اون موقع دیروز که باز داریم به شیر میدیم از اینجا خورده"
    },
    {
      "id": 42,
      "start": 15134.5,
      "end": 15137.5,
      "formatted_start": "04:12:14.500",
      "formatted_end": "04:12:17.500",
      "text": "دو روز بچه از من جدا بود که گفتن ترک کنیم"
    },
    {
      "id": 43,
      "start": 15137.5,
      "end": 15143.5,
      "formatted_start": "04:12:17.500",
      "formatted_end": "04:12:23.500",
      "text": "آرامش داشته باشه که سرس مادر مهمه"
    },
    {
      "id": 44,
      "start": 15143.5,
      "end": 15150.5,
      "formatted_start": "04:12:23.500",
      "formatted_end": "04:12:30.500",
      "text": "این کارها خوبه"
    },
    {
      "id": 45,
      "start": 15150.5,
      "end": 15157.5,
      "formatted_start": "04:12:30.500",
      "formatted_end": "04:12:37.500",
      "text": "اینها رو به مارسو خوبی هم گیرم"
    },
    {
      "id": 46,
      "start": 15157.5,
      "end": 15160.5,
      "formatted_start": "04:12:37.500",
      "formatted_end": "04:12:40.500",
      "text": "اینو بهداشت داده اشکال نداری؟"
    },
    {
      "id": 47,
      "start": 15160.5,
      "end": 15162.5,
      "formatted_start": "04:12:40.500",
      "formatted_end": "04:12:42.500",
      "text": "نه یکی از این بدهیم"
    },
    {
      "id": 48,
      "start": 15162.5,
      "end": 15163.5,
      "formatted_start": "04:12:42.500",
      "formatted_end": "04:12:43.500",
      "text": "فرق نه این هم خوبه دیگه"
    },
    {
      "id": 49,
      "start": 15163.5,
      "end": 15165.5,
      "formatted_start": "04:12:43.500",
      "formatted_end": "04:12:45.500",
      "text": "این همینه دیگه"
    },
    {
      "id": 50,
      "start": 15165.5,
      "end": 15166.5,
      "formatted_start": "04:12:45.500",
      "formatted_end": "04:12:46.500",
      "text": "اینو برین تا شدن؟"
    },
    {
      "id": 51,
      "start": 15166.5,
      "end": 15167.5,
      "formatted_start": "04:12:46.500",
      "formatted_end": "04:12:47.500",
      "text": "نه، ببین اینم عاده ایه"
    },
    {
      "id": 52,
      "start": 15167.5,
      "end": 15168.5,
      "formatted_start": "04:12:47.500",
      "formatted_end": "04:12:48.500",
      "text": "آره"
    },
    {
      "id": 53,
      "start": 15168.5,
      "end": 15169.5,
      "formatted_start": "04:12:48.500",
      "formatted_end": "04:12:49.500",
      "text": "آره دوتاش عاده ایه"
    },
    {
      "id": 54,
      "start": 15169.5,
      "end": 15172.5,
      "formatted_start": "04:12:49.500",
      "formatted_end": "04:12:52.500",
      "text": "هم کدام که میبینی خوب میخوره این جنس بهتریه"
    },
    {
      "id": 55,
      "start": 15172.5,
      "end": 15174.5,
      "formatted_start": "04:12:52.500",
      "formatted_end": "04:12:54.500",
      "text": "اینو بهتر ده همه رو"
    },
    {
      "id": 56,
      "start": 15174.5,
      "end": 15176.5,
      "formatted_start": "04:12:54.500",
      "formatted_end": "04:12:56.500",
      "text": "بقیه اینم مورد نداره کنی؟"
    },
    {
      "id": 57,
      "start": 15176.5,
      "end": 15178.5,
      "formatted_start": "04:12:56.500",
      "formatted_end": "04:12:58.500",
      "text": "نه، اینم مشکل نداشت"
    },
    {
      "id": 58,
      "start": 15179.5,
      "end": 15182.5,
      "formatted_start": "04:12:59.500",
      "formatted_end": "04:13:02.500",
      "text": "خب، های گستان این داروهاش آزاده"
    },
    {
      "id": 59,
      "start": 15182.5,
      "end": 15186.5,
      "formatted_start": "04:13:02.500",
      "formatted_end": "04:13:06.500",
      "text": "ببین این موقعی در زمان بیقراری 13 قطعه"
    },
    {
      "id": 60,
      "start": 15186.5,
      "end": 15188.5,
      "formatted_start": "04:13:06.500",
      "formatted_end": "04:13:08.500",
      "text": "13 قطعه"
    },
    {
      "id": 61,
      "start": 15188.5,
      "end": 15191.5,
      "formatted_start": "04:13:08.500",
      "formatted_end": "04:13:11.500",
      "text": "مثلا اگر میدونی ساعت 8 بیقرار میشه"
    },
    {
      "id": 62,
      "start": 15191.5,
      "end": 15193.5,
      "formatted_start": "04:13:11.500",
      "formatted_end": "04:13:13.500",
      "text": "این همون سر ساعت هشت بودی که نگیره"
    },
    {
      "id": 63,
      "start": 15193.5,
      "end": 15194.5,
      "formatted_start": "04:13:13.500",
      "formatted_end": "04:13:14.500",
      "text": "خب"
    },
    {
      "id": 64,
      "start": 15194.5,
      "end": 15195.5,
      "formatted_start": "04:13:14.500",
      "formatted_end": "04:13:15.500",
      "text": "هنگام شیرونو فرق نمیدونی؟"
    },
    {
      "id": 65,
      "start": 15195.5,
      "end": 15196.5,
      "formatted_start": "04:13:15.500",
      "formatted_end": "04:13:16.500",
      "text": "نه، هر چیز نداره"
    },
    {
      "id": 66,
      "start": 15196.5,
      "end": 15197.5,
      "formatted_start": "04:13:16.500",
      "formatted_end": "04:13:17.500",
      "text": "سرعت هم نداره؟"
    },
    {
      "id": 67,
      "start": 15197.5,
      "end": 15199.5,
      "formatted_start": "04:13:17.500",
      "formatted_end": "04:13:19.500",
      "text": "نه، فقط موقع بیقراری"
    },
    {
      "id": 68,
      "start": 15199.5,
      "end": 15201.5,
      "formatted_start": "04:13:19.500",
      "formatted_end": "04:13:21.500",
      "text": "اطریه..."
    },
    {
      "id": 69,
      "start": 15203.5,
      "end": 15205.5,
      "formatted_start": "04:13:23.500",
      "formatted_end": "04:13:25.500",
      "text": "اون حالتیه چون اینو الان دادید"
    },
    {
      "id": 70,
      "start": 15205.5,
      "end": 15207.5,
      "formatted_start": "04:13:25.500",
      "formatted_end": "04:13:27.500",
      "text": "قبلا شاید الان بدید مقاومت بده بهش"
    },
    {
      "id": 71,
      "start": 15207.5,
      "end": 15209.5,
      "formatted_start": "04:13:27.500",
      "formatted_end": "04:13:29.500",
      "text": "چون..."
    },
    {
      "id": 72,
      "start": 15210.5,
      "end": 15212.5,
      "formatted_start": "04:13:30.500",
      "formatted_end": "04:13:32.500",
      "text": "مثلا یه دارور زیاد بدید"
    },
    {
      "id": 73,
      "start": 15212.5,
      "end": 15213.5,
      "formatted_start": "04:13:32.500",
      "formatted_end": "04:13:33.500",
      "text": "چیز میشه"
    },
    {
      "id": 74,
      "start": 15213.5,
      "end": 15214.5,
      "formatted_start": "04:13:33.500",
      "formatted_end": "04:13:34.500",
      "text": "اصلا از این دادی؟"
    },
    {
      "id": 75,
      "start": 15214.5,
      "end": 15215.5,
      "formatted_start": "04:13:34.500",
      "formatted_end": "04:13:35.500",
      "text": "آره"
    },
    {
      "id": 76,
      "start": 15215.5,
      "end": 15216.5,
      "formatted_start": "04:13:35.500",
      "formatted_end": "04:13:36.500",
      "text": "همین یه شیشه تمام شده"
    },
    {
      "id": 77,
      "start": 15216.5,
      "end": 15217.5,
      "formatted_start": "04:13:36.500",
      "formatted_end": "04:13:37.500",
      "text": "نه، نه، نه"
    },
    {
      "id": 78,
      "start": 15217.5,
      "end": 15219.5,
      "formatted_start": "04:13:37.500",
      "formatted_end": "04:13:39.500",
      "text": "همینه این که خیلی کم دادی"
    },
    {
      "id": 79,
      "start": 15219.5,
      "end": 15222.5,
      "formatted_start": "04:13:39.500",
      "formatted_end": "04:13:42.500",
      "text": "همینه بدی من دامت زیاد نمیسن برای تو"
    },
    {
      "id": 80,
      "start": 15222.5,
      "end": 15223.5,
      "formatted_start": "04:13:42.500",
      "formatted_end": "04:13:43.500",
      "text": "باشه"
    },
    {
      "id": 81,
      "start": 15223.5,
      "end": 15224.5,
      "formatted_start": "04:13:43.500",
      "formatted_end": "04:13:44.500",
      "text": "این دوتا رو میدی"
    },
    {
      "id": 82,
      "start": 15224.5,
      "end": 15226.5,
      "formatted_start": "04:13:44.500",
      "formatted_end": "04:13:46.500",
      "text": "برسته؟"
    },
    {
      "id": 83,
      "start": 15226.5,
      "end": 15227.5,
      "formatted_start": "04:13:46.500",
      "formatted_end": "04:13:47.500",
      "text": "اینو کوریک داری؟"
    },
    {
      "id": 84,
      "start": 15227.5,
      "end": 15230.5,
      "formatted_start": "04:13:47.500",
      "formatted_end": "04:13:50.500",
      "text": "نه اینو اینشه دایمیتوکن نوشتن"
    },
    {
      "id": 85,
      "start": 15230.5,
      "end": 15231.5,
      "formatted_start": "04:13:50.500",
      "formatted_end": "04:13:51.500",
      "text": "کوریک دیگه ندی؟"
    },
    {
      "id": 86,
      "start": 15231.5,
      "end": 15234.5,
      "formatted_start": "04:13:51.500",
      "formatted_end": "04:13:54.500",
      "text": "نه همین دایمیتوکن الان میاریم جلس خوبه"
    },
    {
      "id": 87,
      "start": 15234.5,
      "end": 15235.5,
      "formatted_start": "04:13:54.500",
      "formatted_end": "04:13:55.500",
      "text": "همین کوریک دیگه"
    },
    {
      "id": 88,
      "start": 15235.5,
      "end": 15237.5,
      "formatted_start": "04:13:55.500",
      "formatted_end": "04:13:57.500",
      "text": "آه این همین همین"
    },
    {
      "id": 89,
      "start": 15237.5,
      "end": 15239.5,
      "formatted_start": "04:13:57.500",
      "formatted_end": "04:13:59.500",
      "text": "نه این چیز این بهتره"
    },
    {
      "id": 90,
      "start": 15239.5,
      "end": 15241.5,
      "formatted_start": "04:13:59.500",
      "formatted_end": "04:14:01.500",
      "text": "اما اینو دیگه ندم"
    },
    {
      "id": 91,
      "start": 15241.5,
      "end": 15246.5,
      "formatted_start": "04:14:01.500",
      "formatted_end": "04:14:06.500",
      "text": "نه نه اینه ندید این از این درش میدید یا قطعه پیدیلاف تنبیه میسن درش میدید"
    },
    {
      "id": 92,
      "start": 15249.5,
      "end": 15254.5,
      "formatted_start": "04:14:09.500",
      "formatted_end": "04:14:14.500",
      "text": "خودتان رژیم رایت کنو مسائلی که گفتم خدمت شما"
    },
    {
      "id": 93,
      "start": 15254.5,
      "end": 15260.5,
      "formatted_start": "04:14:14.500",
      "formatted_end": "04:14:20.500",
      "text": "این دوتا را با قوت و قدرت میدید و توقف رو کدار"
    },
    {
      "id": 94,
      "start": 15260.5,
      "end": 15266.5,
      "formatted_start": "04:14:20.500",
      "formatted_end": "04:14:26.500",
      "text": "این پاکستی روزی سه بار مربع خوری کم بدید بیش فایده ای نداره"
    },
    {
      "id": 95,
      "start": 15266.5,
      "end": 15268.5,
      "formatted_start": "04:14:26.500",
      "formatted_end": "04:14:28.500",
      "text": "نداره این هم موقع بی قراری هست"
    },
    {
      "id": 96,
      "start": 15268.5,
      "end": 15270.5,
      "formatted_start": "04:14:28.500",
      "formatted_end": "04:14:30.500",
      "text": "پونزه فتر"
    },
    {
      "id": 97,
      "start": 15270.5,
      "end": 15272.5,
      "formatted_start": "04:14:30.500",
      "formatted_end": "04:14:32.500",
      "text": "یا یک قطعه چکان ویتامین های پر کنی"
    },
    {
      "id": 98,
      "start": 15272.5,
      "end": 15274.5,
      "formatted_start": "04:14:32.500",
      "formatted_end": "04:14:34.500",
      "text": "میشه پونزه فتر"
    },
    {
      "id": 99,
      "start": 15274.5,
      "end": 15276.5,
      "formatted_start": "04:14:34.500",
      "formatted_end": "04:14:36.500",
      "text": "بسیار گوشش؟"
    },
    {
      "id": 100,
      "start": 15276.5,
      "end": 15278.5,
      "formatted_start": "04:14:36.500",
      "formatted_end": "04:14:38.500",
      "text": "که درمان مناسبیه؟"
    },
    {
      "id": 101,
      "start": 15278.5,
      "end": 15280.5,
      "formatted_start": "04:14:38.500",
      "formatted_end": "04:14:40.500",
      "text": "الان خوبه دیگه الان مثلا یه ماه ش پر بشه"
    },
    {
      "id": 102,
      "start": 15280.5,
      "end": 15282.5,
      "formatted_start": "04:14:40.500",
      "formatted_end": "04:14:42.500",
      "text": "الان با بشه"
    },
    {
      "id": 103,
      "start": 15282.5,
      "end": 15284.5,
      "formatted_start": "04:14:42.500",
      "formatted_end": "04:14:44.500",
      "text": "الان جوهر میشه دو ماه ش"
    },
    {
      "id": 104,
      "start": 15284.5,
      "end": 15286.5,
      "formatted_start": "04:14:44.500",
      "formatted_end": "04:14:46.500",
      "text": "خب نه اشکال نه من از یک ماه تا شیش ماه زمان میکنم"
    },
    {
      "id": 105,
      "start": 15286.5,
      "end": 15288.5,
      "formatted_start": "04:14:46.500",
      "formatted_end": "04:14:48.500",
      "text": "از یک ماه تا شیش ماه زمان"
    },
    {
      "id": 106,
      "start": 15288.5,
      "end": 15290.5,
      "formatted_start": "04:14:48.500",
      "formatted_end": "04:14:50.500",
      "text": "الان بچه نمیفهم یه درم سرخ میشه"
    },
    {
      "id": 107,
      "start": 15290.5,
      "end": 15292.5,
      "formatted_start": "04:14:50.500",
      "formatted_end": "04:14:52.500",
      "text": "از اونها یه وقت دیگه داریم"
    },
    {
      "id": 108,
      "start": 15292.5,
      "end": 15294.5,
      "formatted_start": "04:14:52.500",
      "formatted_end": "04:14:54.500",
      "text": "چرفت ها را خواستید در خیلی میکنم"
    },
    {
      "id": 109,
      "start": 15294.5,
      "end": 15296.5,
      "formatted_start": "04:14:54.500",
      "formatted_end": "04:14:56.500",
      "text": "این داروش هم بیادید من بگیم"
    },
