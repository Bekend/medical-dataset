  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3614.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:14.000",
      "text": "خانم جنتی، خانم فوقلاده، صبح می آمده بگیرم و با ساعت نو می آمده دو مرتبه مریضای چیز من رو ببینم."
    },
    {
      "id": 1,
      "start": 3614.0,
      "end": 3616.0,
      "formatted_start": "01:00:14.000",
      "formatted_end": "01:00:16.000",
      "text": "این ها دیش پرراه نشده."
    },
    {
      "id": 2,
      "start": 3616.0,
      "end": 3618.0,
      "formatted_start": "01:00:16.000",
      "formatted_end": "01:00:18.000",
      "text": "خب؟"
    },
    {
      "id": 3,
      "start": 3618.0,
      "end": 3622.0,
      "formatted_start": "01:00:18.000",
      "formatted_end": "01:00:22.000",
      "text": "خب"
    },
    {
      "id": 4,
      "start": 3622.0,
      "end": 3628.0,
      "formatted_start": "01:00:22.000",
      "formatted_end": "01:00:28.000",
      "text": "ببینید یک تعریف شده"
    },
    {
      "id": 5,
      "start": 3628.0,
      "end": 3634.0,
      "formatted_start": "01:00:28.000",
      "formatted_end": "01:00:34.000",
      "text": "بله بله بله"
    },
    {
      "id": 6,
      "start": 3634.0,
      "end": 3638.0,
      "formatted_start": "01:00:34.000",
      "formatted_end": "01:00:38.000",
      "text": "اینا درمانگاهی هستن مثلا سرخواهی"
    },
    {
      "id": 7,
      "start": 3638.0,
      "end": 3642.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:42.000",
      "text": "مریض سرخواهیه بله سرخواهیه"
    },
    {
      "id": 8,
      "start": 3642.0,
      "end": 3662.48,
      "formatted_start": "01:00:42.000",
      "formatted_end": "01:01:02.480",
      "text": "خانم جنگتی ببینین الان شما شما باید باید اقف ببینین الان من دو سال تاییگرد مدله بودم که هیچ چی اصلا قبل از اون شاید دو سه سال قبل از این شاید دکتر پاشاییو"
    },
    {
      "id": 9,
      "start": 3662.48,
      "end": 3668.98,
      "formatted_start": "01:01:02.480",
      "formatted_end": "01:01:08.980",
      "text": "آره، آره، ببینین چیز، من اول مثلا ودود 25 سال در این مجموعه هستم دیگه خب"
    },
    {
      "id": 10,
      "start": 3668.98,
      "end": 3677.98,
      "formatted_start": "01:01:08.980",
      "formatted_end": "01:01:17.980",
      "text": "بعد، اولم ودود 15 سال اینایی که میان مثلا به ملیزان چون آزادشگرنی میان همین گنبه تو درموهایی"
    },
    {
      "id": 11,
      "start": 3677.98,
      "end": 3682.98,
      "formatted_start": "01:01:17.980",
      "formatted_end": "01:01:22.980",
      "text": "چند سالی من میامدم نخلی میگرفتم یعنی پول میدادن همینجوری"
    },
    {
      "id": 12,
      "start": 3682.98,
      "end": 3689.48,
      "formatted_start": "01:01:22.980",
      "formatted_end": "01:01:29.480",
      "text": "مثلا به صندوق میدادن، صندوق اون موقع کارت مارت نبود، خب اینجوری کارتو، آره"
    },
    {
      "id": 13,
      "start": 3689.48,
      "end": 3694.94,
      "formatted_start": "01:01:29.480",
      "formatted_end": "01:01:34.940",
      "text": "اینا پول نفت میدادن. بعد من میرفتم از تندق اون قبض و پولو میگرفتم. خب؟"
    },
    {
      "id": 14,
      "start": 3694.94,
      "end": 3699.08,
      "formatted_start": "01:01:34.940",
      "formatted_end": "01:01:39.080",
      "text": "بعد دکتر پادشایی اومد بود که نه شما باید مثلا"
    },
    {
      "id": 15,
      "start": 3699.08,
      "end": 3704.78,
      "formatted_start": "01:01:39.080",
      "formatted_end": "01:01:44.780",
      "text": "10 درصد 20 درصد به بیمارستان بدید. یه درصد این طریق شد. 10 درصد بود یا 20 درصد."
    },
    {
      "id": 16,
      "start": 3704.78,
      "end": 3708.48,
      "formatted_start": "01:01:44.780",
      "formatted_end": "01:01:48.480",
      "text": "10 درصد از مالیات این پولو بدید. خب؟"
    },
    {
      "id": 17,
      "start": 3708.48,
      "end": 3712.48,
      "formatted_start": "01:01:48.480",
      "formatted_end": "01:01:52.480",
      "text": "بعد به این طریق..."
    },
    {
      "id": 18,
      "start": 3712.48,
      "end": 3720.48,
      "formatted_start": "01:01:52.480",
      "formatted_end": "01:02:00.480",
      "text": "ببین این راحت بالای..."
    },
    {
      "id": 19,
      "start": 3720.48,
      "end": 3729.48,
      "formatted_start": "01:02:00.480",
      "formatted_end": "01:02:09.480",
      "text": "خب شما بگید اقف شما از ۴۰۱ شروع کنید به این جلو"
    },
    {
      "id": 20,
      "start": 3729.48,
      "end": 3732.48,
      "formatted_start": "01:02:09.480",
      "formatted_end": "01:02:12.480",
      "text": "حتی دقیقا ۵ سال اینا هست"
    },
    {
      "id": 21,
      "start": 3732.48,
      "end": 3734.48,
      "formatted_start": "01:02:12.480",
      "formatted_end": "01:02:14.480",
      "text": "حتی دقیقا داشتون میگن"
    },
    {
      "id": 22,
      "start": 3734.48,
      "end": 3738.48,
      "formatted_start": "01:02:14.480",
      "formatted_end": "01:02:18.480",
      "text": "من میگم شاید، میگم شاید ۵ سال"
    },
    {
      "id": 23,
      "start": 3738.48,
      "end": 3753.46,
      "formatted_start": "01:02:18.480",
      "formatted_end": "01:02:33.460",
      "text": "آره بعد دستگاه فوتوترافی چیه؟ ببین خانم چه دستگاه فوتوترافی هم همجوری تریم شد دستگاه هم قرار شد آره آره آره اون دستگاه چون دستگاه فوتوترافی هم من ندیدم اینو"
    },
    {
      "id": 24,
      "start": 3753.46,
      "end": 3757.46,
      "formatted_start": "01:02:33.460",
      "formatted_end": "01:02:37.460",
      "text": "من نمی باشم شکر کنید اینو تا فردا یه اطلاع بدید"
    },
    {
      "id": 25,
      "start": 3762.46,
      "end": 3766.46,
      "formatted_start": "01:02:42.460",
      "formatted_end": "01:02:46.460",
      "text": "من ندارم بخشیم خب اشکال نداره خب"
    },
    {
      "id": 26,
      "start": 3768.48,
      "end": 3782.48,
      "formatted_start": "01:02:48.480",
      "formatted_end": "01:03:02.480",
      "text": "اما مثلا خبر ندارم با او خب، خب الان اشکال نداره چی بفتن؟ خب الان شما اتماهاشتر پد بود تجریه خب، با او او او بدین؟ شاید خانم موسیلی، خانم همشاید بفتنش رو او او نگرفتیم، درسته"
    },
    {
      "id": 27,
      "start": 3798.48,
      "end": 3806.48,
      "formatted_start": "01:03:18.480",
      "formatted_end": "01:03:26.480",
      "text": "شما دو ما دینین که حق امزای جدید و ایت مدیره جدیده"
    },
    {
      "id": 28,
      "start": 3806.48,
      "end": 3810.48,
      "formatted_start": "01:03:26.480",
      "formatted_end": "01:03:30.480",
      "text": "خب این جلسه رو ما یک شنبه بذاریم که"
    },
    {
      "id": 29,
      "start": 3810.48,
      "end": 3815.48,
      "formatted_start": "01:03:30.480",
      "formatted_end": "01:03:35.480",
      "text": "آره ببینین الان یک شنبه میشه یازده هم"
    },
    {
      "id": 30,
      "start": 3815.48,
      "end": 3818.48,
      "formatted_start": "01:03:35.480",
      "formatted_end": "01:03:38.480",
      "text": "دو که شیخی که کشیکه کشیک های باید"
    },
    {
      "id": 31,
      "start": 3818.48,
      "end": 3820.48,
      "formatted_start": "01:03:38.480",
      "formatted_end": "01:03:40.480",
      "text": "چون من دیدم میدونی یازده هم"
    },
    {
      "id": 32,
      "start": 3820.48,
      "end": 3823.48,
      "formatted_start": "01:03:40.480",
      "formatted_end": "01:03:43.480",
      "text": "فردا ما میخواییم جلسه فوقلاده بذاریم"
    },
    {
      "id": 33,
      "start": 3823.48,
      "end": 3825.48,
      "formatted_start": "01:03:43.480",
      "formatted_end": "01:03:45.480",
      "text": "که بیان اینا"
    },
    {
      "id": 34,
      "start": 3825.48,
      "end": 3827.48,
      "formatted_start": "01:03:45.480",
      "formatted_end": "01:03:47.480",
      "text": "ما تا که وقت داریم"
    },
    {
      "id": 35,
      "start": 3827.48,
      "end": 3846.62,
      "formatted_start": "01:03:47.480",
      "formatted_end": "01:04:06.620",
      "text": "خب پس اگر اونجوری ما فردا بزنیم اگر تو شکی هست ما فردا بزنیم"
    },
    {
      "id": 36,
      "start": 3846.62,
      "end": 3850.18,
      "formatted_start": "01:04:06.620",
      "formatted_end": "01:04:10.180",
      "text": "بزنیم که چون حقوق پسنده میمونه دیگه"
    },
    {
      "id": 37,
      "start": 3850.18,
      "end": 3859.18,
      "formatted_start": "01:04:10.180",
      "formatted_end": "01:04:19.180",
      "text": "نه نه ببین شما با نامه نیتونیم حقوق پرسندل رو بدین"
    },
    {
      "id": 38,
      "start": 3859.18,
      "end": 3873.18,
      "formatted_start": "01:04:19.180",
      "formatted_end": "01:04:33.180",
      "text": "خب از خشک آره ببین حالا من اگه تونستم فردا جلسه فوقلاده میذارم اگر نشد یک شنبه"
    },
    {
      "id": 39,
      "start": 3873.18,
      "end": 3877.32,
      "formatted_start": "01:04:33.180",
      "formatted_end": "01:04:37.320",
      "text": "یک شنبه چون باید یه زمانی باشه چون دکتر شیخی گرگان هسته اینا"
    },
    {
      "id": 40,
      "start": 3877.32,
      "end": 3880.34,
      "formatted_start": "01:04:37.320",
      "formatted_end": "01:04:40.340",
      "text": "توی چیشه کاش باشه ای کنم باشه درسته اوله"
    },
    {
      "id": 41,
      "start": 3880.34,
      "end": 3883.16,
      "formatted_start": "01:04:40.340",
      "formatted_end": "01:04:43.160",
      "text": "پس فردا هسته دکتر شیخی دیگه"
    },
    {
      "id": 42,
      "start": 3883.16,
      "end": 3899.5,
      "formatted_start": "01:04:43.160",
      "formatted_end": "01:04:59.500",
      "text": "آره شما میبینید فردا ببینید اگه باشه باید فردا بذارید"
    }
  ],
  "status": "completed"
}