  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15302.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:02.000",
      "text": "اینجا نیگهتار خودم."
    },
    {
      "id": 1,
      "start": 15302.0,
      "end": 15305.0,
      "formatted_start": "04:15:02.000",
      "formatted_end": "04:15:05.000",
      "text": "شیرخوشی که بشین نم شیرخوشی که نم بشین دیگه؟"
    },
    {
      "id": 2,
      "start": 15305.0,
      "end": 15306.0,
      "formatted_start": "04:15:05.000",
      "formatted_end": "04:15:06.000",
      "text": "آره."
    },
    {
      "id": 3,
      "start": 15306.0,
      "end": 15311.0,
      "formatted_start": "04:15:06.000",
      "formatted_end": "04:15:11.000",
      "text": "چون اداری که میریم، جو جفت سرون میریم اداره، مدرن هم مجموعی بشین."
    },
    {
      "id": 4,
      "start": 15311.0,
      "end": 15312.0,
      "formatted_start": "04:15:11.000",
      "formatted_end": "04:15:12.000",
      "text": "نه، شیرخوشی نم بشین."
    },
    {
      "id": 5,
      "start": 15312.0,
      "end": 15313.0,
      "formatted_start": "04:15:12.000",
      "formatted_end": "04:15:13.000",
      "text": "تمامی که خودش میاد..."
    },
    {
      "id": 6,
      "start": 15313.0,
      "end": 15315.0,
      "formatted_start": "04:15:13.000",
      "formatted_end": "04:15:15.000",
      "text": "آره، مارکو خوبیه، نه."
    },
    {
      "id": 7,
      "start": 15315.0,
      "end": 15316.0,
      "formatted_start": "04:15:15.000",
      "formatted_end": "04:15:16.000",
      "text": "شیرخوشی که نم بشین."
    },
    {
      "id": 8,
      "start": 15316.0,
      "end": 15317.0,
      "formatted_start": "04:15:16.000",
      "formatted_end": "04:15:17.000",
      "text": "بشین بیشتر بیشتر بیشتر."
    },
    {
      "id": 9,
      "start": 15317.0,
      "end": 15318.0,
      "formatted_start": "04:15:17.000",
      "formatted_end": "04:15:18.000",
      "text": "این تمام شده بخاطر شیرخوشی که بشین."
    },
    {
      "id": 10,
      "start": 15318.0,
      "end": 15322.0,
      "formatted_start": "04:15:18.000",
      "formatted_end": "04:15:22.000",
      "text": "نه نه این بخاطر استرسی که داشتی داییه بینده بچه به هم نشده هم مادر برده"
    },
    {
      "id": 11,
      "start": 15322.0,
      "end": 15323.0,
      "formatted_start": "04:15:22.000",
      "formatted_end": "04:15:23.000",
      "text": "دوست شبکه هم نداریم"
    },
    {
      "id": 12,
      "start": 15323.0,
      "end": 15324.0,
      "formatted_start": "04:15:23.000",
      "formatted_end": "04:15:24.000",
      "text": "نگران نباشید"
    },
    {
      "id": 13,
      "start": 15327.0,
      "end": 15328.0,
      "formatted_start": "04:15:27.000",
      "formatted_end": "04:15:28.000",
      "text": "داروش هم بیار من بیاریم"
    },
    {
      "id": 14,
      "start": 15330.0,
      "end": 15333.0,
      "formatted_start": "04:15:30.000",
      "formatted_end": "04:15:33.000",
      "text": "شیطان شاپونسا دیگه ها نفتر دستگاه میخواد بده"
    },
    {
      "id": 15,
      "start": 15333.0,
      "end": 15335.0,
      "formatted_start": "04:15:33.000",
      "formatted_end": "04:15:35.000",
      "text": "دستگاه فوتورافی خب دستگاه داریم بهشون بیدیم"
    },
    {
      "id": 16,
      "start": 15335.0,
      "end": 15336.0,
      "formatted_start": "04:15:35.000",
      "formatted_end": "04:15:36.000",
      "text": "برده دیدم بهشون بیدیم"
    },
    {
      "id": 17,
      "start": 15336.0,
      "end": 15338.0,
      "formatted_start": "04:15:36.000",
      "formatted_end": "04:15:38.000",
      "text": "آره آره دو روز بهشون بیدیم"
    },
    {
      "id": 18,
      "start": 15340.0,
      "end": 15341.0,
      "formatted_start": "04:15:40.000",
      "formatted_end": "04:15:41.000",
      "text": "میتونیم هم شما مدیدیم"
    },
    {
      "id": 19,
      "start": 15341.0,
      "end": 15343.0,
      "formatted_start": "04:15:41.000",
      "formatted_end": "04:15:43.000",
      "text": "چند تا پشت داریم؟"
    },
    {
      "id": 20,
      "start": 15343.0,
      "end": 15345.0,
      "formatted_start": "04:15:43.000",
      "formatted_end": "04:15:45.000",
      "text": "سه روزش"
    },
    {
      "id": 21,
      "start": 15345.0,
      "end": 15347.0,
      "formatted_start": "04:15:45.000",
      "formatted_end": "04:15:47.000",
      "text": "برش کنی با نه"
    },
    {
      "id": 22,
      "start": 15347.0,
      "end": 15349.0,
      "formatted_start": "04:15:47.000",
      "formatted_end": "04:15:49.000",
      "text": "سلامت شما خوبه؟"
    },
    {
      "id": 23,
      "start": 15349.0,
      "end": 15353.0,
      "formatted_start": "04:15:49.000",
      "formatted_end": "04:15:53.000",
      "text": "نیستی های محمده اونجا بود در این تیز همه"
    },
    {
      "id": 24,
      "start": 15353.0,
      "end": 15355.0,
      "formatted_start": "04:15:53.000",
      "formatted_end": "04:15:55.000",
      "text": "برای سلامت داشتین"
    },
    {
      "id": 25,
      "start": 15355.0,
      "end": 15357.0,
      "formatted_start": "04:15:55.000",
      "formatted_end": "04:15:57.000",
      "text": "چند روزشه؟"
    },
    {
      "id": 26,
      "start": 15357.0,
      "end": 15359.0,
      "formatted_start": "04:15:57.000",
      "formatted_end": "04:15:59.000",
      "text": "سه روزشه"
    },
    {
      "id": 27,
      "start": 15359.0,
      "end": 15361.0,
      "formatted_start": "04:15:59.000",
      "formatted_end": "04:16:01.000",
      "text": "شیر خوب کرده؟"
    },
    {
      "id": 28,
      "start": 15361.0,
      "end": 15365.0,
      "formatted_start": "04:16:01.000",
      "formatted_end": "04:16:05.000",
      "text": "نه شیر که اول پستون مادر شیر کنید از بیرون"
    },
    {
      "id": 29,
      "start": 15365.0,
      "end": 15367.0,
      "formatted_start": "04:16:05.000",
      "formatted_end": "04:16:07.000",
      "text": "بعد"
    },
    {
      "id": 30,
      "start": 15367.0,
      "end": 15369.0,
      "formatted_start": "04:16:07.000",
      "formatted_end": "04:16:09.000",
      "text": "ناراضی شیر است؟"
    },
    {
      "id": 31,
      "start": 15369.0,
      "end": 15375.0,
      "formatted_start": "04:16:09.000",
      "formatted_end": "04:16:15.000",
      "text": "دیشب من این روشیر کندم و این روش هم حالا خودم خوب نیسته و حالا بچه هم خوب نیسته"
    },
    {
      "id": 32,
      "start": 15375.0,
      "end": 15376.0,
      "formatted_start": "04:16:15.000",
      "formatted_end": "04:16:16.000",
      "text": "بچه چه نارهتی داره؟"
    },
    {
      "id": 33,
      "start": 15376.0,
      "end": 15378.0,
      "formatted_start": "04:16:16.000",
      "formatted_end": "04:16:18.000",
      "text": "شکرش کلن باد میکنه"
    },
    {
      "id": 34,
      "start": 15378.0,
      "end": 15379.0,
      "formatted_start": "04:16:18.000",
      "formatted_end": "04:16:19.000",
      "text": "نفر کنه"
    },
    {
      "id": 35,
      "start": 15379.0,
      "end": 15382.0,
      "formatted_start": "04:16:19.000",
      "formatted_end": "04:16:22.000",
      "text": "درپیچه داره"
    },
    {
      "id": 36,
      "start": 15382.0,
      "end": 15385.0,
      "formatted_start": "04:16:22.000",
      "formatted_end": "04:16:25.000",
      "text": "درپیچه داره و از این کلن سینه رو نمیگیره"
    },
    {
      "id": 37,
      "start": 15385.0,
      "end": 15390.0,
      "formatted_start": "04:16:25.000",
      "formatted_end": "04:16:30.000",
      "text": "خب سینه رو نمیگیره، اقراره و بعد گریر میکنه و بغل میکنه"
    },
    {
      "id": 38,
      "start": 15390.0,
      "end": 15394.0,
      "formatted_start": "04:16:30.000",
      "formatted_end": "04:16:34.000",
      "text": "گریر میکنه و بغل میکنه، آرومه"
    },
    {
      "id": 39,
      "start": 15394.0,
      "end": 15397.0,
      "formatted_start": "04:16:34.000",
      "formatted_end": "04:16:37.000",
      "text": "یک کم بعد آروم میشی که اصلا با دست نگهره"
    },
    {
      "id": 40,
      "start": 15397.0,
      "end": 15398.0,
      "formatted_start": "04:16:37.000",
      "formatted_end": "04:16:38.000",
      "text": "تو ماشین ساکت بود؟"
    },
    {
      "id": 41,
      "start": 15398.0,
      "end": 15399.0,
      "formatted_start": "04:16:38.000",
      "formatted_end": "04:16:39.000",
      "text": "هم تو ماشین ساکت بود"
    },
    {
      "id": 42,
      "start": 15399.0,
      "end": 15400.0,
      "formatted_start": "04:16:39.000",
      "formatted_end": "04:16:40.000",
      "text": "تو ماشین ساکت بود"
    },
    {
      "id": 43,
      "start": 15400.0,
      "end": 15401.0,
      "formatted_start": "04:16:40.000",
      "formatted_end": "04:16:41.000",
      "text": "چندش از شغل دارن؟"
    },
    {
      "id": 44,
      "start": 15401.0,
      "end": 15402.0,
      "formatted_start": "04:16:41.000",
      "formatted_end": "04:16:42.000",
      "text": "سه روزشه"
    },
    {
      "id": 45,
      "start": 15402.0,
      "end": 15403.0,
      "formatted_start": "04:16:42.000",
      "formatted_end": "04:16:43.000",
      "text": "سه روزشه"
    },
    {
      "id": 46,
      "start": 15403.0,
      "end": 15404.0,
      "formatted_start": "04:16:43.000",
      "formatted_end": "04:16:44.000",
      "text": "سه روزشه"
    },
    {
      "id": 47,
      "start": 15404.0,
      "end": 15407.0,
      "formatted_start": "04:16:44.000",
      "formatted_end": "04:16:47.000",
      "text": "چکمش پاک رو برمی کنیم سه روزشه"
    },
    {
      "id": 48,
      "start": 15407.0,
      "end": 15410.0,
      "formatted_start": "04:16:47.000",
      "formatted_end": "04:16:50.000",
      "text": "بعد شکرش از دماغ برمی کنیم"
    },
    {
      "id": 49,
      "start": 15410.0,
      "end": 15411.0,
      "formatted_start": "04:16:50.000",
      "formatted_end": "04:16:51.000",
      "text": "آه"
    },
    {
      "id": 50,
      "start": 15411.0,
      "end": 15413.0,
      "formatted_start": "04:16:51.000",
      "formatted_end": "04:16:53.000",
      "text": "یهو میگوزه دیگه"
    },
    {
      "id": 51,
      "start": 15413.0,
      "end": 15414.0,
      "formatted_start": "04:16:53.000",
      "formatted_end": "04:16:54.000",
      "text": "آه"
    },
    {
      "id": 52,
      "start": 15414.0,
      "end": 15415.0,
      "formatted_start": "04:16:54.000",
      "formatted_end": "04:16:55.000",
      "text": "دیگه نفسه"
    },
    {
      "id": 53,
      "start": 15415.0,
      "end": 15416.0,
      "formatted_start": "04:16:55.000",
      "formatted_end": "04:16:56.000",
      "text": "آه"
    },
    {
      "id": 54,
      "start": 15416.0,
      "end": 15418.0,
      "formatted_start": "04:16:56.000",
      "formatted_end": "04:16:58.000",
      "text": "و زردم هست این بچه"
    },
    {
      "id": 55,
      "start": 15418.0,
      "end": 15419.0,
      "formatted_start": "04:16:58.000",
      "formatted_end": "04:16:59.000",
      "text": "آه زردم"
    },
    {
      "id": 56,
      "start": 15419.0,
      "end": 15421.0,
      "formatted_start": "04:16:59.000",
      "formatted_end": "04:17:01.000",
      "text": "آه اصلا صورتو این از مزید کنیم"
    },
    {
      "id": 57,
      "start": 15421.0,
      "end": 15423.0,
      "formatted_start": "04:17:01.000",
      "formatted_end": "04:17:03.000",
      "text": "دماغش صورتش"
    },
    {
      "id": 58,
      "start": 15423.0,
      "end": 15424.0,
      "formatted_start": "04:17:03.000",
      "formatted_end": "04:17:04.000",
      "text": "خور"
    },
    {
      "id": 59,
      "start": 15424.0,
      "end": 15428.0,
      "formatted_start": "04:17:04.000",
      "formatted_end": "04:17:08.000",
      "text": "بعدنش اگر زردی کن سیرون نه زردی کنید"
    },
    {
      "id": 60,
      "start": 15428.0,
      "end": 15432.0,
      "formatted_start": "04:17:08.000",
      "formatted_end": "04:17:12.000",
      "text": "این زردی زیر دست من دیدی؟"
    },
    {
      "id": 61,
      "start": 15432.0,
      "end": 15433.0,
      "formatted_start": "04:17:12.000",
      "formatted_end": "04:17:13.000",
      "text": "آره"
    },
    {
      "id": 62,
      "start": 15433.0,
      "end": 15435.0,
      "formatted_start": "04:17:13.000",
      "formatted_end": "04:17:15.000",
      "text": "کاملا زردی این بچه"
    },
    {
      "id": 63,
      "start": 15435.0,
      "end": 15438.0,
      "formatted_start": "04:17:15.000",
      "formatted_end": "04:17:18.000",
      "text": "این پیشتر هم میشه، اینو زردیش معیمتر از نفخشه"
    },
    {
      "id": 64,
      "start": 15438.0,
      "end": 15442.0,
      "formatted_start": "04:17:18.000",
      "formatted_end": "04:17:22.000",
      "text": "شکنش نفخ راره، پیچش میده"
    },
    {
      "id": 65,
      "start": 15442.0,
      "end": 15444.0,
      "formatted_start": "04:17:22.000",
      "formatted_end": "04:17:24.000",
      "text": "آره خوب"
    },
    {
      "id": 66,
      "start": 15444.0,
      "end": 15446.0,
      "formatted_start": "04:17:24.000",
      "formatted_end": "04:17:26.000",
      "text": "و زردی بالا"
    },
    {
      "id": 67,
      "start": 15446.0,
      "end": 15448.0,
      "formatted_start": "04:17:26.000",
      "formatted_end": "04:17:28.000",
      "text": "بلوخونی مادر نوزاد؟"
    },
    {
      "id": 68,
      "start": 15448.0,
      "end": 15450.0,
      "formatted_start": "04:17:28.000",
      "formatted_end": "04:17:30.000",
      "text": "خوب"
    },
    {
      "id": 69,
      "start": 15450.0,
      "end": 15451.0,
      "formatted_start": "04:17:30.000",
      "formatted_end": "04:17:31.000",
      "text": "خوب، شما چی هستیم؟"
    },
    {
      "id": 70,
      "start": 15451.0,
      "end": 15452.0,
      "formatted_start": "04:17:31.000",
      "formatted_end": "04:17:32.000",
      "text": "من آبیم"
    },
    {
      "id": 71,
      "start": 15452.0,
      "end": 15454.0,
      "formatted_start": "04:17:32.000",
      "formatted_end": "04:17:34.000",
      "text": "این بلوخونی ها با هم نمیخوره"
    },
    {
      "id": 72,
      "start": 15454.0,
      "end": 15458.2,
      "formatted_start": "04:17:34.000",
      "formatted_end": "04:17:38.200",
      "text": "در نتیجه باعث میشه پیچه شدید بده"
    },
    {
      "id": 73,
      "start": 15458.2,
      "end": 15461.56,
      "formatted_start": "04:17:38.200",
      "formatted_end": "04:17:41.560",
      "text": "چه زردی شدید بده"
    },
    {
      "id": 74,
      "start": 15461.56,
      "end": 15463.28,
      "formatted_start": "04:17:41.560",
      "formatted_end": "04:17:43.280",
      "text": "دوتا بچه ما نداشتیم"
    },
    {
      "id": 75,
      "start": 15463.28,
      "end": 15463.66,
      "formatted_start": "04:17:43.280",
      "formatted_end": "04:17:43.660",
      "text": "این یکی"
    },
    {
      "id": 76,
      "start": 15463.66,
      "end": 15467.7,
      "formatted_start": "04:17:43.660",
      "formatted_end": "04:17:47.700",
      "text": "من نمیخواهم آزمایش بینو بیسن"
    },
    {
      "id": 77,
      "start": 15467.7,
      "end": 15469.08,
      "formatted_start": "04:17:47.700",
      "formatted_end": "04:17:49.080",
      "text": "مشخص هستن"
    },
    {
      "id": 78,
      "start": 15469.08,
      "end": 15470.92,
      "formatted_start": "04:17:49.080",
      "formatted_end": "04:17:50.920",
      "text": "کفا داشت ناسه"
    },
    {
      "id": 79,
      "start": 15470.92,
      "end": 15473.04,
      "formatted_start": "04:17:50.920",
      "formatted_end": "04:17:53.040",
      "text": "حضرمه کن زیاد نشه"
    },
    {
      "id": 80,
      "start": 15473.04,
      "end": 15479.64,
      "formatted_start": "04:17:53.040",
      "formatted_end": "04:17:59.640",
      "text": "خوب"
    },
    {
      "id": 81,
      "start": 15479.64,
      "end": 15481.42,
      "formatted_start": "04:17:59.640",
      "formatted_end": "04:18:01.420",
      "text": "برندشون"
    },
    {
      "id": 82,
      "start": 15481.42,
      "end": 15483.42,
      "formatted_start": "04:18:01.420",
      "formatted_end": "04:18:03.420",
      "text": "خوب"
    },
    {
      "id": 83,
      "start": 15483.42,
      "end": 15485.42,
      "formatted_start": "04:18:03.420",
      "formatted_end": "04:18:05.420",
      "text": "خوب"
    },
    {
      "id": 84,
      "start": 15485.42,
      "end": 15487.42,
      "formatted_start": "04:18:05.420",
      "formatted_end": "04:18:07.420",
      "text": "خوب"
    },
    {
      "id": 85,
      "start": 15487.42,
      "end": 15489.42,
      "formatted_start": "04:18:07.420",
      "formatted_end": "04:18:09.420",
      "text": "آدت من این شیر ندن دیگه"
    },
    {
      "id": 86,
      "start": 15489.42,
      "end": 15491.42,
      "formatted_start": "04:18:09.420",
      "formatted_end": "04:18:11.420",
      "text": "آدت من این شیر ندن دیگه"
    },
    {
      "id": 87,
      "start": 15491.42,
      "end": 15493.42,
      "formatted_start": "04:18:11.420",
      "formatted_end": "04:18:13.420",
      "text": "چی ندید؟"
    },
    {
      "id": 88,
      "start": 15493.42,
      "end": 15495.42,
      "formatted_start": "04:18:13.420",
      "formatted_end": "04:18:15.420",
      "text": "این شیر بخواه واسه باید دیگه چی بگیره؟"
    },
    {
      "id": 89,
      "start": 15495.42,
      "end": 15497.42,
      "formatted_start": "04:18:15.420",
      "formatted_end": "04:18:17.420",
      "text": "ببین خودتون رژیبیت رایت کن"
    },
    {
      "id": 90,
      "start": 15497.42,
      "end": 15499.42,
      "formatted_start": "04:18:17.420",
      "formatted_end": "04:18:19.420",
      "text": "خانم"
    },
    {
      "id": 91,
      "start": 15499.42,
      "end": 15501.42,
      "formatted_start": "04:18:19.420",
      "formatted_end": "04:18:21.420",
      "text": "محبوبیان"
    },
    {
      "id": 92,
      "start": 15501.42,
      "end": 15503.42,
      "formatted_start": "04:18:21.420",
      "formatted_end": "04:18:23.420",
      "text": "محبوبیان"
    },
    {
      "id": 93,
      "start": 15503.42,
      "end": 15505.42,
      "formatted_start": "04:18:23.420",
      "formatted_end": "04:18:25.420",
      "text": "چون بعد این ریز نوشته"
    },
    {
      "id": 94,
      "start": 15505.42,
      "end": 15507.42,
      "formatted_start": "04:18:25.420",
      "formatted_end": "04:18:27.420",
      "text": "ماشی ما محبوب"
    },
    {
      "id": 95,
      "start": 15507.42,
      "end": 15509.42,
      "formatted_start": "04:18:27.420",
      "formatted_end": "04:18:29.420",
      "text": "خانم محبوبیان"
    },
    {
      "id": 96,
      "start": 15509.42,
      "end": 15538.1,
      "formatted_start": "04:18:29.420",
      "formatted_end": "04:18:58.100",
      "text": "بادنجام، در بیچه بچه هایی را زیادی کنه، هوبوبا، روپیا، ماشد، حتی آب شد، نبنیات گاوی، ماب، شیر، خمیر، همون شیری که خوردید شیر گاو مخصوصا سنگینه، کازینی سیاده، پیچه شده و از این وحساسیت شیر گاو هم بوجود میاد، هم خودت هم بچه، و یکی هم بادنجام خیال"
    },
    {
      "id": 97,
      "start": 15538.1,
      "end": 15540.1,
      "formatted_start": "04:18:58.100",
      "formatted_end": "04:19:00.100",
      "text": "این رو کش نوشتم"
    },
    {
      "id": 98,
      "start": 15540.1,
      "end": 15542.1,
      "formatted_start": "04:19:00.100",
      "formatted_end": "04:19:02.100",
      "text": "چرا؟ شیر خورده"
    },
    {
      "id": 99,
      "start": 15542.1,
      "end": 15544.1,
      "formatted_start": "04:19:02.100",
      "formatted_end": "04:19:04.100",
      "text": "نه نه شیر نیست"
    },
    {
      "id": 100,
      "start": 15544.1,
      "end": 15546.1,
      "formatted_start": "04:19:04.100",
      "formatted_end": "04:19:06.100",
      "text": "امیدواری اینجا شدن بود"
    },
    {
      "id": 101,
      "start": 15546.1,
      "end": 15548.1,
      "formatted_start": "04:19:06.100",
      "formatted_end": "04:19:08.100",
      "text": "به من نیست فریان شیر بکنه"
    },
    {
      "id": 102,
      "start": 15548.1,
      "end": 15550.1,
      "formatted_start": "04:19:08.100",
      "formatted_end": "04:19:10.100",
      "text": "من گفتم بیشتر که شیر خورده"
    },
    {
      "id": 103,
      "start": 15550.1,
      "end": 15552.1,
      "formatted_start": "04:19:10.100",
      "formatted_end": "04:19:12.100",
      "text": "نه شیر گوزفندش باید نداره"
    },
    {
      "id": 104,
      "start": 15552.1,
      "end": 15554.1,
      "formatted_start": "04:19:12.100",
      "formatted_end": "04:19:14.100",
      "text": "گاو نه"
    },
    {
      "id": 105,
      "start": 15554.1,
      "end": 15556.1,
      "formatted_start": "04:19:14.100",
      "formatted_end": "04:19:16.100",
      "text": "اون هم فردتریه"
    },
    {
      "id": 106,
      "start": 15556.1,
      "end": 15558.1,
      "formatted_start": "04:19:16.100",
      "formatted_end": "04:19:18.100",
      "text": "بس زردیش آیه محبوبیه زیاده"
    },
    {
      "id": 107,
      "start": 15558.1,
      "end": 15560.1,
      "formatted_start": "04:19:18.100",
      "formatted_end": "04:19:20.100",
      "text": "یا بستنیش کن یا دستگاه ببر"
    },
    {
      "id": 108,
      "start": 15560.1,
      "end": 15562.1,
      "formatted_start": "04:19:20.100",
      "formatted_end": "04:19:22.100",
      "text": "دستگاه راحت تره"
    },
    {
      "id": 109,
      "start": 15562.1,
      "end": 15564.1,
      "formatted_start": "04:19:22.100",
      "formatted_end": "04:19:24.100",
      "text": "بیمارستان هوا بین گرمی وارد"
    },
    {
      "id": 110,
      "start": 15564.1,
      "end": 15566.1,
      "formatted_start": "04:19:24.100",
      "formatted_end": "04:19:26.100",
      "text": "اما زندگی توی هم بزاری"
    },
    {
      "id": 111,
      "start": 15566.1,
      "end": 15574.1,
      "formatted_start": "04:19:26.100",
      "formatted_end": "04:19:34.100",
      "text": "اینجا به منشین میداریم، دارند، جایی دیگر دستگاه فرستادون، اینجا ما دستگاه بیمونیم، خب؟"
    },
    {
      "id": 112,
      "start": 15574.1,
      "end": 15576.1,
      "formatted_start": "04:19:34.100",
      "formatted_end": "04:19:36.100",
      "text": "چند روز تو دستگاه بیمونیم؟"
    },
    {
      "id": 113,
      "start": 15576.1,
      "end": 15584.1,
      "formatted_start": "04:19:36.100",
      "formatted_end": "04:19:44.100",
      "text": "ببینید، چهار روز خوبه، اما بعدیش اینکه اینجا سه شنبه به جامعه میپرداریم، در زمانتون پیشتر میشه، خب؟"
    },
    {
      "id": 114,
      "start": 15584.1,
      "end": 15586.1,
      "formatted_start": "04:19:44.100",
      "formatted_end": "04:19:46.100",
      "text": "بله سلام"
    },
    {
      "id": 115,
      "start": 15586.1,
      "end": 15589.1,
      "formatted_start": "04:19:46.100",
      "formatted_end": "04:19:49.100",
      "text": "این داروها رو بیاریم من لطفا توضیح بدم"
    },
    {
      "id": 116,
      "start": 15589.1,
      "end": 15600.0,
