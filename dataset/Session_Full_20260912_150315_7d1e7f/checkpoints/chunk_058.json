  "stt_segments": [
    {
      "id": 0,
      "start": 17400.0,
      "end": 17429.98,
      "formatted_start": "04:50:00.000",
      "formatted_end": "04:50:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 17430.0,
      "end": 17440.0,
      "formatted_start": "04:50:30.000",
      "formatted_end": "04:50:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 17460.0,
      "end": 17480.0,
      "formatted_start": "04:51:00.000",
      "formatted_end": "04:51:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 17480.0,
      "end": 17508.0,
      "formatted_start": "04:51:20.000",
      "formatted_end": "04:51:48.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 17510.0,
      "end": 17539.98,
      "formatted_start": "04:51:50.000",
      "formatted_end": "04:52:19.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 5,
      "start": 17540.0,
      "end": 17558.0,
      "formatted_start": "04:52:20.000",
      "formatted_end": "04:52:38.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 17570.0,
      "end": 17591.0,
      "formatted_start": "04:52:50.000",
      "formatted_end": "04:53:11.000",
      "text": "نراستان ندیدار نتانیا بوباد، شناختن، کاک سفین، وزیر دفاع از شنونی بیگرد آمیکا، مانه همه این کشور به زیر ساختای انرژی اینا شده"
    },
    {
      "id": 7,
      "start": 17591.0,
      "end": 17613.0,
      "formatted_start": "04:53:11.000",
      "formatted_end": "04:53:33.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 17621.0,
      "end": 17631.0,
      "formatted_start": "04:53:41.000",
      "formatted_end": "04:53:51.000",
      "text": "مرحله اول بازیه، مثل دوران کودکی که با بی حدف بازمشه، همه چی بازیه بود، نه مسئولیتی، نه آگاهی"
    },
    {
      "id": 9,
      "start": 17631.0,
      "end": 17639.0,
      "formatted_start": "04:53:51.000",
      "formatted_end": "04:53:59.000",
      "text": "مرحله بعدی، دوران ناجمبونی که رفتم رو موالد نه با سریعت، موالد چیزایی که در اول جمعه از نه اینقدر برکرد"
    },
    {
      "id": 10,
      "start": 17639.0,
      "end": 17646.0,
      "formatted_start": "04:53:59.000",
      "formatted_end": "04:54:06.000",
      "text": "موسیقی، رفیق بازی، سریعت، ساعت ها بگشتم توی این تیز ها بشد کردن با بی کنم"
    },
    {
      "id": 11,
      "start": 17646.0,
      "end": 17653.0,
      "formatted_start": "04:54:06.000",
      "formatted_end": "04:54:13.000",
      "text": "در داران کنکی بی هدف بودم اما در داران ناجمونی هدف داشتم و در هدف اشتباه بودم."
    },
    {
      "id": 12,
      "start": 17653.0,
      "end": 17659.0,
      "formatted_start": "04:54:13.000",
      "formatted_end": "04:54:19.000",
      "text": "غافل بودم در محله بعدی زینت و آرایش تجمع و فرستی بودم."
    },
    {
      "id": 13,
      "start": 17659.0,
      "end": 17660.0,
      "formatted_start": "04:54:19.000",
      "formatted_end": "04:54:20.000",
      "text": "سنی؟"
    },
    {
      "id": 14,
      "start": 17660.0,
      "end": 17666.0,
      "formatted_start": "04:54:20.000",
      "formatted_end": "04:54:26.000",
      "text": "مامانم از سر کار مده خطر زیر یعنی پوست صورتش رو ببین؟"
    },
    {
      "id": 15,
      "start": 17666.0,
      "end": 17667.0,
      "formatted_start": "04:54:26.000",
      "formatted_end": "04:54:27.000",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 17667.0,
      "end": 17672.0,
      "formatted_start": "04:54:27.000",
      "formatted_end": "04:54:32.000",
      "text": "هنوز، هنوز سایی یک زغ زده چند ببین؟"
    },
    {
      "id": 17,
      "start": 17672.0,
      "end": 17673.0,
      "formatted_start": "04:54:32.000",
      "formatted_end": "04:54:33.000",
      "text": "چند ببین"
    },
    {
      "id": 18,
      "start": 17673.0,
      "end": 17676.0,
      "formatted_start": "04:54:33.000",
      "formatted_end": "04:54:36.000",
      "text": "در این وقت، باید برداری دورایی زدنی پنبه باشد."
    },
    {
      "id": 19,
      "start": 17676.0,
      "end": 17681.0,
      "formatted_start": "04:54:36.000",
      "formatted_end": "04:54:41.000",
      "text": "اما در دوست های هاشمگاه ها، زمین پنبه باشد."
    },
    {
      "id": 20,
      "start": 17681.0,
      "end": 17684.0,
      "formatted_start": "04:54:41.000",
      "formatted_end": "04:54:44.000",
      "text": "این سوال همانه را بردارید."
    },
    {
      "id": 21,
      "start": 17684.0,
      "end": 17687.0,
      "formatted_start": "04:54:44.000",
      "formatted_end": "04:54:47.000",
      "text": "اگر خست نماشید، براش بردارید."
    },
    {
      "id": 22,
      "start": 17687.0,
      "end": 17692.0,
      "formatted_start": "04:54:47.000",
      "formatted_end": "04:54:52.000",
      "text": "اطمئن از پروژه آقای بوچکی در دل جندگاه های بابورم،"
    },
    {
      "id": 23,
      "start": 17692.0,
      "end": 17696.0,
      "formatted_start": "04:54:52.000",
      "formatted_end": "04:54:56.000",
      "text": "پروژه بی قشنگی از این واقع نست شد و در این وقت،"
    },
    {
      "id": 24,
      "start": 17696.0,
      "end": 17697.0,
      "formatted_start": "04:54:56.000",
      "formatted_end": "04:54:57.000",
      "text": "ماشان کرد."
    },
    {
      "id": 25,
      "start": 17697.0,
      "end": 17699.0,
      "formatted_start": "04:54:57.000",
      "formatted_end": "04:54:59.000",
      "text": "برای که به دیگر سر."
    },
    {
      "id": 26,
      "start": 17699.0,
      "end": 17699.98,
      "formatted_start": "04:54:59.000",
      "formatted_end": "04:54:59.980",
      "text": "مرسی کنید"
    }
  ],
  "status": "completed"
}