  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 629.98,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 630.0,
      "end": 658.0,
      "formatted_start": "00:10:30.000",
      "formatted_end": "00:10:58.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 660.0,
      "end": 680.0,
      "formatted_start": "00:11:00.000",
      "formatted_end": "00:11:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 680.0,
      "end": 702.0,
      "formatted_start": "00:11:20.000",
      "formatted_end": "00:11:42.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 702.0,
      "end": 706.0,
      "formatted_start": "00:11:42.000",
      "formatted_end": "00:11:46.000",
      "text": "بخواهم اینجا سلام. حالا شما خوبه؟ خانم مدرباری. برخشید."
    },
    {
      "id": 5,
      "start": 706.0,
      "end": 708.0,
      "formatted_start": "00:11:46.000",
      "formatted_end": "00:11:48.000",
      "text": "چایی بخویید."
    },
    {
      "id": 6,
      "start": 708.0,
      "end": 710.0,
      "formatted_start": "00:11:48.000",
      "formatted_end": "00:11:50.000",
      "text": "در و ملت بخوایید."
    },
    {
      "id": 7,
      "start": 710.0,
      "end": 712.0,
      "formatted_start": "00:11:50.000",
      "formatted_end": "00:11:52.000",
      "text": "چی شده ببینی؟"
    },
    {
      "id": 8,
      "start": 712.0,
      "end": 714.0,
      "formatted_start": "00:11:52.000",
      "formatted_end": "00:11:54.000",
      "text": "فقط تبشتر ایده."
    },
    {
      "id": 9,
      "start": 714.0,
      "end": 715.0,
      "formatted_start": "00:11:54.000",
      "formatted_end": "00:11:55.000",
      "text": "تب بالا؟"
    },
    {
      "id": 10,
      "start": 715.0,
      "end": 716.0,
      "formatted_start": "00:11:55.000",
      "formatted_end": "00:11:56.000",
      "text": "آره."
    },
    {
      "id": 11,
      "start": 716.0,
      "end": 718.0,
      "formatted_start": "00:11:56.000",
      "formatted_end": "00:11:58.000",
      "text": "غیر از تب چی؟ صرفه، آب نیزش؟"
    },
    {
      "id": 12,
      "start": 718.0,
      "end": 721.0,
      "formatted_start": "00:11:58.000",
      "formatted_end": "00:12:01.000",
      "text": "آب نیزش که کمی داشت. الان تبشتر ایده ایده اون."
    },
    {
      "id": 13,
      "start": 721.0,
      "end": 722.0,
      "formatted_start": "00:12:01.000",
      "formatted_end": "00:12:02.000",
      "text": "فقط تب بالا؟"
    },
    {
      "id": 14,
      "start": 722.0,
      "end": 723.0,
      "formatted_start": "00:12:02.000",
      "formatted_end": "00:12:03.000",
      "text": "آره تبشتر."
    },
    {
      "id": 15,
      "start": 723.0,
      "end": 724.0,
      "formatted_start": "00:12:03.000",
      "formatted_end": "00:12:04.000",
      "text": "صرفه نداره؟"
    },
    {
      "id": 16,
      "start": 724.0,
      "end": 725.0,
      "formatted_start": "00:12:04.000",
      "formatted_end": "00:12:05.000",
      "text": "نه، خیلی کمی نداره."
    },
    {
      "id": 17,
      "start": 725.0,
      "end": 727.0,
      "formatted_start": "00:12:05.000",
      "formatted_end": "00:12:07.000",
      "text": "خسخسه سینه؟"
    },
    {
      "id": 18,
      "start": 727.0,
      "end": 729.0,
      "formatted_start": "00:12:07.000",
      "formatted_end": "00:12:09.000",
      "text": "نفس کشیدن شکر میشه"
    },
    {
      "id": 19,
      "start": 729.0,
      "end": 731.0,
      "formatted_start": "00:12:09.000",
      "formatted_end": "00:12:11.000",
      "text": "سرگید شده"
    },
    {
      "id": 20,
      "start": 731.0,
      "end": 733.0,
      "formatted_start": "00:12:11.000",
      "formatted_end": "00:12:13.000",
      "text": "سرگید چه حده؟"
    },
    {
      "id": 21,
      "start": 733.0,
      "end": 735.0,
      "formatted_start": "00:12:13.000",
      "formatted_end": "00:12:15.000",
      "text": "یه سال دیگه"
    },
    {
      "id": 22,
      "start": 735.0,
      "end": 737.0,
      "formatted_start": "00:12:15.000",
      "formatted_end": "00:12:17.000",
      "text": "دارو چیزی هم دادیم؟"
    },
    {
      "id": 23,
      "start": 737.0,
      "end": 739.0,
      "formatted_start": "00:12:17.000",
      "formatted_end": "00:12:19.000",
      "text": "فرقون و پستانه و خانه داشتن"
    },
    {
      "id": 24,
      "start": 739.0,
      "end": 741.0,
      "formatted_start": "00:12:19.000",
      "formatted_end": "00:12:21.000",
      "text": "بپرمشن"
    },
    {
      "id": 25,
      "start": 755.0,
      "end": 779.0,
      "formatted_start": "00:12:35.000",
      "formatted_end": "00:12:59.000",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 779.0,
      "end": 781.0,
      "formatted_start": "00:12:59.000",
      "formatted_end": "00:13:01.000",
      "text": "خیلی خیلی خیلی"
    },
    {
      "id": 27,
      "start": 781.0,
      "end": 783.0,
      "formatted_start": "00:13:01.000",
      "formatted_end": "00:13:03.000",
      "text": "دارو خوردن میشه یوریه؟"
    },
    {
      "id": 28,
      "start": 783.0,
      "end": 785.0,
      "formatted_start": "00:13:03.000",
      "formatted_end": "00:13:05.000",
      "text": "نه خوردن شرمتونه یه رو بزنیم"
    },
    {
      "id": 29,
      "start": 785.0,
      "end": 787.0,
      "formatted_start": "00:13:05.000",
      "formatted_end": "00:13:07.000",
      "text": "دارو میشه؟"
    },
    {
      "id": 30,
      "start": 787.0,
      "end": 789.0,
      "formatted_start": "00:13:07.000",
      "formatted_end": "00:13:09.000",
      "text": "یه رو بزنیم تا یه نتر بشه"
    },
    {
      "id": 31,
      "start": 789.0,
      "end": 791.0,
      "formatted_start": "00:13:09.000",
      "formatted_end": "00:13:11.000",
      "text": "بله تذکره هم براش میگیرم"
    },
    {
      "id": 32,
      "start": 791.0,
      "end": 793.0,
      "formatted_start": "00:13:11.000",
      "formatted_end": "00:13:13.000",
      "text": "یکی زیاده آمان کنیم نیستم"
    },
    {
      "id": 33,
      "start": 793.0,
      "end": 795.0,
      "formatted_start": "00:13:13.000",
      "formatted_end": "00:13:15.000",
      "text": "ولی با شروط هم بهش بدینیم"
    },
    {
      "id": 34,
      "start": 795.0,
      "end": 797.0,
      "formatted_start": "00:13:15.000",
      "formatted_end": "00:13:17.000",
      "text": "باشه"
    },
    {
      "id": 35,
      "start": 797.0,
      "end": 799.0,
      "formatted_start": "00:13:17.000",
      "formatted_end": "00:13:19.000",
      "text": "احتمال داره کم کم عدایم شدید ترم بشه"
    },
    {
      "id": 36,
      "start": 799.0,
      "end": 801.0,
      "formatted_start": "00:13:19.000",
      "formatted_end": "00:13:21.000",
      "text": "اگه تا دوستون روز آینده"
    },
    {
      "id": 37,
      "start": 801.0,
      "end": 803.0,
      "formatted_start": "00:13:21.000",
      "formatted_end": "00:13:23.000",
      "text": "رو به بهبود رفت"
    },
    {
      "id": 38,
      "start": 803.0,
      "end": 805.0,
      "formatted_start": "00:13:23.000",
      "formatted_end": "00:13:25.000",
      "text": "درمان درمان بگیریم ببینم"
    },
    {
      "id": 39,
      "start": 805.0,
      "end": 806.0,
      "formatted_start": "00:13:25.000",
      "formatted_end": "00:13:26.000",
      "text": "باشه"
    },
    {
      "id": 40,
      "start": 806.0,
      "end": 808.0,
      "formatted_start": "00:13:26.000",
      "formatted_end": "00:13:28.000",
      "text": "کجا میشینیم؟"
    },
    {
      "id": 41,
      "start": 808.0,
      "end": 810.0,
      "formatted_start": "00:13:28.000",
      "formatted_end": "00:13:30.000",
      "text": "مرسا و عدد"
    },
    {
      "id": 42,
      "start": 810.0,
      "end": 812.0,
      "formatted_start": "00:13:30.000",
      "formatted_end": "00:13:32.000",
      "text": "ببینی یه سالشه؟"
    },
    {
      "id": 43,
      "start": 812.0,
      "end": 814.0,
      "formatted_start": "00:13:32.000",
      "formatted_end": "00:13:34.000",
      "text": "بره ریسیزن یه سالشه"
    },
    {
      "id": 44,
      "start": 814.0,
      "end": 816.0,
      "formatted_start": "00:13:34.000",
      "formatted_end": "00:13:36.000",
      "text": "ببینم بره"
    },
    {
      "id": 45,
      "start": 816.0,
      "end": 818.0,
      "formatted_start": "00:13:36.000",
      "formatted_end": "00:13:38.000",
      "text": "مرسا و عدد"
    },
    {
      "id": 46,
      "start": 824.0,
