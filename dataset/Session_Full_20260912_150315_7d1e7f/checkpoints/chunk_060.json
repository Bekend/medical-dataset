      "formatted_end": "05:00:03.000",
      "text": "فردا نفس فردا بیرم بچه رو ببینم."
    },
    {
      "id": 1,
      "start": 18003.0,
      "end": 18005.0,
      "formatted_start": "05:00:03.000",
      "formatted_end": "05:00:05.000",
      "text": "خداحافظ شما."
    },
    {
      "id": 2,
      "start": 18005.0,
      "end": 18013.0,
      "formatted_start": "05:00:05.000",
      "formatted_end": "05:00:13.000",
      "text": "درور بیاد؟"
    },
    {
      "id": 3,
      "start": 18013.0,
      "end": 18015.0,
      "formatted_start": "05:00:13.000",
      "formatted_end": "05:00:15.000",
      "text": "درور بیاد، آره، چند درور بیاد؟"
    },
    {
