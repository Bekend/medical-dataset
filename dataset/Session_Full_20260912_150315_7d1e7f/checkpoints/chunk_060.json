      "text": "برداشتون برداشتون"
    },
    {
      "id": 11,
      "start": 18042.0,
      "end": 18044.0,
      "formatted_start": "05:00:42.000",
      "formatted_end": "05:00:44.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 12,
      "start": 18044.0,
      "end": 18046.0,
      "formatted_start": "05:00:44.000",
      "formatted_end": "05:00:46.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 13,
      "start": 18046.0,
      "end": 18048.0,
      "formatted_start": "05:00:46.000",
      "formatted_end": "05:00:48.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 14,
      "start": 18048.0,
      "end": 18050.0,
      "formatted_start": "05:00:48.000",
      "formatted_end": "05:00:50.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 15,
      "start": 18050.0,
      "end": 18052.0,
      "formatted_start": "05:00:50.000",
      "formatted_end": "05:00:52.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 16,
      "start": 18052.0,
      "end": 18054.0,
      "formatted_start": "05:00:52.000",
      "formatted_end": "05:00:54.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 17,
      "start": 18054.0,
      "end": 18056.0,
      "formatted_start": "05:00:54.000",
      "formatted_end": "05:00:56.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 18,
      "start": 18056.0,
      "end": 18058.0,
      "formatted_start": "05:00:56.000",
      "formatted_end": "05:00:58.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 19,
      "start": 18058.0,
      "end": 18060.0,
      "formatted_start": "05:00:58.000",
      "formatted_end": "05:01:00.000",
      "text": "برداشتون برداشتون"
    },
    {
      "id": 20,
      "start": 18060.0,
      "end": 18062.0,
      "formatted_start": "05:01:00.000",
      "formatted_end": "05:01:02.000",
      "text": "با شانس داریم"
    },
    {
      "id": 21,
      "start": 18062.0,
      "end": 18064.0,
      "formatted_start": "05:01:02.000",
      "formatted_end": "05:01:04.000",
      "text": "دختر دومیه"
    },
    {
      "id": 22,
      "start": 18064.0,
      "end": 18066.0,
      "formatted_start": "05:01:04.000",
      "formatted_end": "05:01:06.000",
      "text": "دختر جوش"
    },
    {
      "id": 23,
      "start": 18066.0,
      "end": 18068.0,
      "formatted_start": "05:01:06.000",
      "formatted_end": "05:01:08.000",
      "text": "نه نه نه دختر بزرگم 13 ساله شد"
    },
    {
      "id": 24,
      "start": 18068.0,
      "end": 18070.0,
      "formatted_start": "05:01:08.000",
      "formatted_end": "05:01:10.000",
      "text": "پسر بزرگم"
    },
    {
      "id": 25,
      "start": 18070.0,
      "end": 18072.0,
      "formatted_start": "05:01:10.000",
      "formatted_end": "05:01:12.000",
      "text": "هشت سال نزدیک نو ساله شد"
    },
    {
      "id": 26,
      "start": 18072.0,
      "end": 18074.0,
      "formatted_start": "05:01:12.000",
      "formatted_end": "05:01:14.000",
      "text": "چه تا دختر شد؟ چه تا دختر شد؟"
    },
    {
      "id": 27,
      "start": 18074.0,
      "end": 18076.0,
      "formatted_start": "05:01:14.000",
      "formatted_end": "05:01:16.000",
      "text": "سه پسر یه دختر خیلی خوبه"
    },
    {
      "id": 28,
      "start": 18076.0,
      "end": 18078.0,
      "formatted_start": "05:01:16.000",
      "formatted_end": "05:01:18.000",
      "text": "خیلی ممکنه"
    },
    {
      "id": 29,
      "start": 18078.0,
      "end": 18080.0,
      "formatted_start": "05:01:18.000",
      "formatted_end": "05:01:20.000",
      "text": "برای قدر را آوردین"
    },
    {
      "id": 30,
      "start": 18080.0,
      "end": 18082.0,
      "formatted_start": "05:01:20.000",
      "formatted_end": "05:01:22.000",
      "text": "مشکل چیزی ندارن"
    },
    {
      "id": 31,
      "start": 18082.0,
      "end": 18084.0,
      "formatted_start": "05:01:22.000",
      "formatted_end": "05:01:24.000",
      "text": "لرد ندارن"
    },
    {
      "id": 32,
      "start": 18084.0,
      "end": 18086.0,
      "formatted_start": "05:01:24.000",
      "formatted_end": "05:01:26.000",
      "text": "خب خبتون چک کنین دیگه"
    },
    {
      "id": 33,
      "start": 18086.0,
      "end": 18088.0,
      "formatted_start": "05:01:26.000",
      "formatted_end": "05:01:28.000",
      "text": "باشیم"
    },
    {
      "id": 34,
      "start": 18088.0,
      "end": 18090.0,
      "formatted_start": "05:01:28.000",
      "formatted_end": "05:01:30.000",
      "text": "ببخشید از اون بره"
    },
    {
      "id": 35,
      "start": 18090.0,
      "end": 18091.0,
      "formatted_start": "05:01:30.000",
      "formatted_end": "05:01:31.000",
      "text": "شکمشون کار می کنه؟"
    },
    {
      "id": 36,
      "start": 18091.0,
      "end": 18092.0,
      "formatted_start": "05:01:31.000",
      "formatted_end": "05:01:32.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 18092.0,
      "end": 18093.0,
      "formatted_start": "05:01:32.000",
      "formatted_end": "05:01:33.000",
      "text": "این ها روزی هفت-اشت-ده بار کار می کنه"
    },
    {
      "id": 38,
      "start": 18093.0,
      "end": 18096.0,
      "formatted_start": "05:01:33.000",
      "formatted_end": "05:01:36.000",
      "text": "بسیار اسحار، آبکی، دوله-دوله یه منداری"
    },
    {
      "id": 39,
      "start": 18096.0,
      "end": 18097.0,
      "formatted_start": "05:01:36.000",
      "formatted_end": "05:01:37.000",
      "text": "بله، بله"
    },
    {
      "id": 40,
      "start": 18097.0,
      "end": 18099.0,
      "formatted_start": "05:01:37.000",
      "formatted_end": "05:01:39.000",
      "text": "این ها نرماله"
    },
    {
      "id": 41,
      "start": 18099.0,
      "end": 18101.0,
      "formatted_start": "05:01:39.000",
      "formatted_end": "05:01:41.000",
      "text": "آره، این ها خسته شده"
    },
    {
      "id": 42,
      "start": 18101.0,
      "end": 18103.0,
      "formatted_start": "05:01:41.000",
      "formatted_end": "05:01:43.000",
      "text": "این همه شیر می کنه و بلوی کار می کنه"
    },
    {
      "id": 43,
      "start": 18103.0,
      "end": 18105.0,
      "formatted_start": "05:01:43.000",
      "formatted_end": "05:01:45.000",
      "text": "این ها که دوتا هم هستن"
    },
    {
      "id": 44,
      "start": 18105.0,
      "end": 18107.0,
      "formatted_start": "05:01:45.000",
      "formatted_end": "05:01:47.000",
      "text": "آه دو دوش بره، نرماله"
    },
    {
      "id": 45,
      "start": 18107.0,
      "end": 18108.0,
      "formatted_start": "05:01:47.000",
      "formatted_end": "05:01:48.000",
      "text": "نه، نرماله"
    },
    {
      "id": 46,
      "start": 18108.0,
      "end": 18109.0,
      "formatted_start": "05:01:48.000",
      "formatted_end": "05:01:49.000",
      "text": "نیروی اسحاری زیاده"
    },
    {
      "id": 47,
      "start": 18109.0,
      "end": 18111.0,
      "formatted_start": "05:01:49.000",
      "formatted_end": "05:01:51.000",
      "text": "نه، نه، نه، نه، خودشو"
    },
    {
      "id": 48,
      "start": 18118.0,
      "end": 18120.0,
      "formatted_start": "05:01:58.000",
      "formatted_end": "05:02:00.000",
      "text": "ولی اواید اینه"
    },
    {
      "id": 49,
      "start": 18120.0,
      "end": 18120.5,
      "formatted_start": "05:02:00.000",
      "formatted_end": "05:02:00.500",
      "text": "بله"
    },
    {
      "id": 50,
      "start": 18120.5,
      "end": 18122.5,
      "formatted_start": "05:02:00.500",
      "formatted_end": "05:02:02.500",
      "text": "بعد اینا فیلم ها اصحاب افتاده بچه ها"
    },
    {
      "id": 51,
      "start": 18122.5,
      "end": 18124.5,
      "formatted_start": "05:02:02.500",
      "formatted_end": "05:02:04.500",
      "text": "بعد قرمی دارم گرم خیشه بود"
    },
    {
      "id": 52,
      "start": 18124.5,
      "end": 18128.5,
      "formatted_start": "05:02:04.500",
      "formatted_end": "05:02:08.500",
      "text": "اگر ناشی باشین شربت و قطعه و خیلی دارون میمیسین و"
    },
    {
      "id": 53,
      "start": 18128.5,
      "end": 18130.5,
      "formatted_start": "05:02:08.500",
      "formatted_end": "05:02:10.500",
      "text": "خواهی هم نداری"
    },
    {
      "id": 54,
      "start": 18130.5,
      "end": 18132.5,
      "formatted_start": "05:02:10.500",
      "formatted_end": "05:02:12.500",
      "text": "شیر خوش کم بشین"
    },
    {
      "id": 55,
      "start": 18132.5,
      "end": 18135.5,
      "formatted_start": "05:02:12.500",
      "formatted_end": "05:02:15.500",
      "text": "باید دارید تغییر شیر خوش با شیر مادر فرمانید"
    },
    {
      "id": 56,
      "start": 18135.5,
      "end": 18138.5,
      "formatted_start": "05:02:15.500",
      "formatted_end": "05:02:18.500",
      "text": "هیچ اشکال نداره ولی شیشه با شیشه ندارن"
    },
    {
      "id": 57,
      "start": 18138.5,
      "end": 18142.5,
      "formatted_start": "05:02:18.500",
      "formatted_end": "05:02:22.500",
      "text": "آره شیشه بندازن دهن بچه کم کم دیگه سینه رو نیمیگره"
    },
    {
      "id": 58,
      "start": 18142.5,
      "end": 18148.5,
      "formatted_start": "05:02:22.500",
      "formatted_end": "05:02:28.500",
      "text": "شیر خشک رو با شیشه درست کنیم با قاشق یا از قطع شکار"
    },
    {
      "id": 59,
      "start": 18148.5,
      "end": 18151.5,
      "formatted_start": "05:02:28.500",
      "formatted_end": "05:02:31.500",
      "text": "شیشه بدادت می کنه بچه رو"
    },
    {
      "id": 60,
      "start": 18151.5,
      "end": 18154.5,
      "formatted_start": "05:02:31.500",
      "formatted_end": "05:02:34.500",
      "text": "شیشه بدادت می کنیم"
    },
    {
      "id": 61,
      "start": 18154.5,
      "end": 18156.5,
      "formatted_start": "05:02:34.500",
      "formatted_end": "05:02:36.500",
      "text": "خب رادمان بودیم"
    },
    {
      "id": 62,
      "start": 18156.5,
      "end": 18158.5,
      "formatted_start": "05:02:36.500",
      "formatted_end": "05:02:38.500",
      "text": "اون رادمان"
    },
    {
      "id": 63,
      "start": 18158.5,
      "end": 18164.5,
      "formatted_start": "05:02:38.500",
      "formatted_end": "05:02:44.500",
      "text": "آیا دیدار این کچیگیه قول کچیگ به بدحال بود که دستورشون بستری بوده"
    },
    {
      "id": 64,
      "start": 18164.5,
      "end": 18166.5,
      "formatted_start": "05:02:44.500",
      "formatted_end": "05:02:46.500",
      "text": "دوباره سال ۲۰۰ سال"
    },
    {
      "id": 65,
      "start": 18166.5,
      "end": 18168.5,
      "formatted_start": "05:02:46.500",
      "formatted_end": "05:02:48.500",
      "text": "خب بزنیم که تخت بودم"
    },
    {
      "id": 66,
      "start": 18168.5,
      "end": 18170.5,
      "formatted_start": "05:02:48.500",
      "formatted_end": "05:02:50.500",
      "text": "بیارم اون رو بیرون"
    },
    {
      "id": 67,
      "start": 18170.5,
      "end": 18172.5,
      "formatted_start": "05:02:50.500",
      "formatted_end": "05:02:52.500",
      "text": "درست درگاه"
    },
    {
      "id": 68,
      "start": 18172.5,
      "end": 18174.5,
      "formatted_start": "05:02:52.500",
      "formatted_end": "05:02:54.500",
      "text": "دیگه زردی خیلی خفیفی داره"
    },
    {
      "id": 69,
      "start": 18174.5,
      "end": 18178.5,
      "formatted_start": "05:02:54.500",
      "formatted_end": "05:02:58.500",
      "text": "این الان خیلی کم شده اتش اصلا مهم نیست"
    },
    {
      "id": 70,
      "start": 18178.5,
      "end": 18180.5,
      "formatted_start": "05:02:58.500",
      "formatted_end": "05:03:00.500",
      "text": "خوب؟"
    },
    {
      "id": 71,
      "start": 18190.5,
      "end": 18192.5,
      "formatted_start": "05:03:10.500",
      "formatted_end": "05:03:12.500",
      "text": "چشم شکرم رو کنم"
    },
    {
      "id": 72,
      "start": 18192.5,
      "end": 18194.5,
      "formatted_start": "05:03:12.500",
      "formatted_end": "05:03:14.500",
      "text": "چک می کنم؟"
    },
    {
      "id": 73,
      "start": 18194.5,
      "end": 18196.5,
      "formatted_start": "05:03:14.500",
      "formatted_end": "05:03:16.500",
      "text": "ببین کتر و پوماد هستم داخل چشم"
    },
    {
      "id": 74,
      "start": 18196.5,
      "end": 18198.5,
      "formatted_start": "05:03:16.500",
      "formatted_end": "05:03:18.500",
      "text": "یعنی پوماد هم توی چشم"
    },
    {
      "id": 75,
      "start": 18198.5,
      "end": 18200.5,
      "formatted_start": "05:03:18.500",
      "formatted_end": "05:03:20.500",
      "text": "بخشت کچه و بعد کمک کچه"
    },
    {
      "id": 76,
      "start": 18200.5,
      "end": 18202.5,
      "formatted_start": "05:03:20.500",
      "formatted_end": "05:03:22.500",
      "text": "شما یک برطکیب داشتید؟"
    },
    {
      "id": 77,
      "start": 18208.5,
      "end": 18210.5,
      "formatted_start": "05:03:28.500",
      "formatted_end": "05:03:30.500",
      "text": "اینو که مزنون تره"
    },
    {
      "id": 78,
      "start": 18210.5,
      "end": 18212.5,
      "formatted_start": "05:03:30.500",
      "formatted_end": "05:03:32.500",
      "text": "نه اما دوست داریم"
    },
    {
      "id": 79,
      "start": 18212.5,
      "end": 18214.5,
      "formatted_start": "05:03:32.500",
      "formatted_end": "05:03:34.500",
      "text": "دهره با ما همه"
    },
    {
      "id": 80,
      "start": 18214.5,
      "end": 18216.5,
      "formatted_start": "05:03:34.500",
      "formatted_end": "05:03:36.500",
      "text": "اینو بذاشتیمشتیم نه آرزده من"
    },
    {
      "id": 81,
      "start": 18218.5,
      "end": 18220.5,
      "formatted_start": "05:03:38.500",
      "formatted_end": "05:03:40.500",
      "text": "این هم یکم صورت هسترده"
    },
    {
      "id": 82,
      "start": 18220.5,
      "end": 18222.5,
      "formatted_start": "05:03:40.500",
      "formatted_end": "05:03:42.500",
      "text": "ولی بدن زردی"
    },
    {
      "id": 83,
      "start": 18222.5,
      "end": 18224.5,
      "formatted_start": "05:03:42.500",
      "formatted_end": "05:03:44.500",
      "text": "کار خواستی لازم نیست"
    },
    {
      "id": 84,
      "start": 18224.5,
      "end": 18226.5,
      "formatted_start": "05:03:44.500",
      "formatted_end": "05:03:46.500",
      "text": "اگر پیلو چند روزشونه؟"
    },
    {
      "id": 85,
      "start": 18226.5,
      "end": 18228.5,
      "formatted_start": "05:03:46.500",
      "formatted_end": "05:03:48.500",
      "text": "اینجا پنجتر از اینجا باشه"
    },
    {
      "id": 86,
      "start": 18228.5,
      "end": 18230.5,
      "formatted_start": "05:03:48.500",
      "formatted_end": "05:03:50.500",
      "text": "اینجا پیشتر ایشه"
    },
    {
      "id": 87,
      "start": 18251.5,
      "end": 18253.5,
      "formatted_start": "05:04:11.500",
      "formatted_end": "05:04:13.500",
      "text": "همه بند"
    },
    {
      "id": 88,
      "start": 18253.5,
      "end": 18255.5,
      "formatted_start": "05:04:13.500",
      "formatted_end": "05:04:15.500",
      "text": "این جوش ها اشکال نداره"
    },
    {
      "id": 89,
      "start": 18255.5,
      "end": 18258.5,
      "formatted_start": "05:04:15.500",
      "formatted_end": "05:04:18.500",
      "text": "نه هرمونی هست شاید در بدنشی دوتا ببین"
    },
    {
      "id": 90,
      "start": 18258.5,
      "end": 18262.5,
      "formatted_start": "05:04:18.500",
      "formatted_end": "05:04:22.500",
      "text": "اگه مثلا سختی میده یه پومات کالاندولا میبین"
    },
    {
      "id": 91,
      "start": 18262.5,
      "end": 18266.5,
      "formatted_start": "05:04:22.500",
      "formatted_end": "05:04:26.500",
      "text": "پومات نرم کننده که تلگیزو گذارم میزنم"
    },
    {
      "id": 92,
      "start": 18266.5,
      "end": 18268.5,
      "formatted_start": "05:04:26.500",
      "formatted_end": "05:04:28.500",
      "text": "تصویر میزنه؟"
    },
    {
      "id": 93,
      "start": 18268.5,
