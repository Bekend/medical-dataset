      "end": 3504.16,
      "formatted_start": "00:57:55.160",
      "formatted_end": "00:58:24.160",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 3504.16,
      "end": 3506.16,
      "formatted_start": "00:58:24.160",
      "formatted_end": "00:58:26.160",
      "text": "سلام خانم جناتی خوب هستین؟"
    },
    {
      "id": 35,
      "start": 3506.16,
      "end": 3508.16,
      "formatted_start": "00:58:26.160",
      "formatted_end": "00:58:28.160",
      "text": "تماثل کردی که بودین من"
    },
    {
      "id": 36,
      "start": 3508.16,
      "end": 3510.16,
      "formatted_start": "00:58:28.160",
      "formatted_end": "00:58:30.160",
      "text": "نه"
    },
    {
      "id": 37,
      "start": 3510.16,
      "end": 3512.16,
      "formatted_start": "00:58:30.160",
      "formatted_end": "00:58:32.160",
      "text": "اون خیلی تبروز"
    },
    {
      "id": 38,
      "start": 3512.16,
      "end": 3514.16,
      "formatted_start": "00:58:32.160",
      "formatted_end": "00:58:34.160",
      "text": "چند سال قبل نیست"
    },
    {
      "id": 39,
      "start": 3514.16,
      "end": 3516.16,
      "formatted_start": "00:58:34.160",
      "formatted_end": "00:58:36.160",
      "text": "اصلا شاید"
    },
    {
      "id": 40,
      "start": 3516.16,
      "end": 3518.16,
      "formatted_start": "00:58:36.160",
      "formatted_end": "00:58:38.160",
      "text": "چندید ساله"
    },
    {
      "id": 41,
      "start": 3518.16,
      "end": 3520.16,
      "formatted_start": "00:58:38.160",
      "formatted_end": "00:58:40.160",
      "text": "من یادم نیست"
    },
    {
      "id": 42,
      "start": 3520.16,
      "end": 3522.16,
      "formatted_start": "00:58:40.160",
      "formatted_end": "00:58:42.160",
      "text": "دوست پاشایی شاید"
    },
    {
      "id": 43,
      "start": 3522.16,
      "end": 3524.16,
      "formatted_start": "00:58:42.160",
      "formatted_end": "00:58:44.160",
      "text": "قبل از اینکه من بیام تو یکمون گیره"
    },
    {
      "id": 44,
      "start": 3524.16,
      "end": 3526.16,
      "formatted_start": "00:58:44.160",
      "formatted_end": "00:58:46.160",
      "text": "یعنی سه سال چهار ساله"
    },
    {
      "id": 45,
      "start": 3526.16,
      "end": 3528.16,
      "formatted_start": "00:58:46.160",
      "formatted_end": "00:58:48.160",
      "text": "اینکه من باید برگرده"
    },
    {
      "id": 46,
      "start": 3528.16,
      "end": 3530.16,
      "formatted_start": "00:58:48.160",
      "formatted_end": "00:58:50.160",
      "text": "که من باید برگرده"
    },
    {
