      "formatted_end": "00:55:32.000",
      "text": "بخش ۳۰۰۰۰"
    },
    {
      "id": 2,
      "start": 3346.0,
      "end": 3348.0,
      "formatted_start": "00:55:46.000",
      "formatted_end": "00:55:48.000",
      "text": "بخم"
    },
    {
      "id": 3,
      "start": 3350.0,
      "end": 3353.0,
      "formatted_start": "00:55:50.000",
      "formatted_end": "00:55:53.000",
      "text": "ببینید شعبت رو ۳۰۰۰ بار دارید"
    },
    {
      "id": 4,
      "start": 3354.0,
      "end": 3356.0,
      "formatted_start": "00:55:54.000",
      "formatted_end": "00:55:56.000",
      "text": "این قصه ۸۰۰۰"
    },
    {
      "id": 5,
      "start": 3357.0,
      "end": 3358.0,
      "formatted_start": "00:55:57.000",
      "formatted_end": "00:55:58.000",
      "text": "اینو تو یکچار میزنید"
    },
    {
      "id": 6,
      "start": 3358.0,
      "end": 3359.0,
      "formatted_start": "00:55:58.000",
      "formatted_end": "00:55:59.000",
      "text": "۸۰۰ بزن"
    },
    {
      "id": 7,
      "start": 3359.0,
      "end": 3362.2,
      "formatted_start": "00:55:59.000",
      "formatted_end": "00:56:02.200",
      "text": "ببین ۸ ساعت ۸۰ روزی ۳"
    },
    {
      "id": 8,
      "start": 3362.2,
      "end": 3365.16,
      "formatted_start": "00:56:02.200",
      "formatted_end": "00:56:05.160",
      "text": "اینو روزی ۱۵ قطره توی یخچار میزنی"
    },
    {
      "id": 9,
      "start": 3365.16,
      "end": 3367.16,
      "formatted_start": "00:56:05.160",
      "formatted_end": "00:56:07.160",
      "text": "اونو هم بزنیم"
    },
    {
      "id": 10,
      "start": 3367.16,
      "end": 3369.16,
      "formatted_start": "00:56:07.160",
      "formatted_end": "00:56:09.160",
      "text": "اونو هم این یخچاریه"
    },
    {
      "id": 11,
      "start": 3369.16,
      "end": 3371.16,
      "formatted_start": "00:56:09.160",
      "formatted_end": "00:56:11.160",
      "text": "اون دوتا مهم نیست"
    },
    {
      "id": 12,
      "start": 3371.16,
      "end": 3373.16,
      "formatted_start": "00:56:11.160",
      "formatted_end": "00:56:13.160",
      "text": "ببینید چه پار میکنیم"
    },
    {
      "id": 13,
      "start": 3373.16,
      "end": 3376.16,
      "formatted_start": "00:56:13.160",
      "formatted_end": "00:56:16.160",
      "text": "اینو یک بسته رو توی یه مقدار آب حلش کنو"
    },
    {
      "id": 14,
      "start": 3376.16,
      "end": 3378.16,
      "formatted_start": "00:56:16.160",
      "formatted_end": "00:56:18.160",
      "text": "بده آرام آرام صبح بچه بخوره"
    },
    {
      "id": 15,
      "start": 3378.16,
      "end": 3379.16,
      "formatted_start": "00:56:18.160",
      "formatted_end": "00:56:19.160",
      "text": "فقط صبح"
    },
    {
      "id": 16,
      "start": 3379.16,
      "end": 3380.16,
      "formatted_start": "00:56:19.160",
      "formatted_end": "00:56:20.160",
      "text": "فقط صبح روزی یه دونه"
    },
    {
      "id": 17,
      "start": 3380.16,
      "end": 3382.16,
      "formatted_start": "00:56:20.160",
      "formatted_end": "00:56:22.160",
      "text": "ده تا دونه برای ده روز"
    },
    {
      "id": 18,
      "start": 3382.16,
      "end": 3385.16,
      "formatted_start": "00:56:22.160",
      "formatted_end": "00:56:25.160",
      "text": "اگر دیدی اینو با این خوب جواب دار"
    },
    {
      "id": 19,
      "start": 3385.16,
      "end": 3388.66,
      "formatted_start": "00:56:25.160",
      "formatted_end": "00:56:28.660",
      "text": "از قصه هاش کم شد و بچه بیتر شد، اوخ زدنش بیتر شد"
    },
    {
      "id": 20,
      "start": 3388.66,
      "end": 3390.66,
      "formatted_start": "00:56:28.660",
      "formatted_end": "00:56:30.660",
      "text": "اینها رو میتونید تا چند هفته ایدم باشید"
    },
    {
      "id": 21,
      "start": 3390.66,
      "end": 3391.16,
      "formatted_start": "00:56:30.660",
      "formatted_end": "00:56:31.160",
      "text": "بله"
    },
    {
      "id": 22,
      "start": 3391.16,
      "end": 3392.16,
      "formatted_start": "00:56:31.160",
      "formatted_end": "00:56:32.160",
      "text": "بیایید"
    },
    {
      "id": 23,
      "start": 3392.16,
      "end": 3393.16,
      "formatted_start": "00:56:32.160",
      "formatted_end": "00:56:33.160",
      "text": "قد نه"
    },
    {
      "id": 24,
      "start": 3393.16,
      "end": 3394.16,
      "formatted_start": "00:56:33.160",
      "formatted_end": "00:56:34.160",
      "text": "باشه"
    },
    {
      "id": 25,
      "start": 3394.16,
      "end": 3396.16,
      "formatted_start": "00:56:34.160",
      "formatted_end": "00:56:36.160",
      "text": "سپس طبعاً هر موقع شویب نداره"
    },
    {
      "id": 26,
      "start": 3396.16,
      "end": 3398.16,
      "formatted_start": "00:56:36.160",
      "formatted_end": "00:56:38.160",
      "text": "صبح ناشتاتر باشه بیتر، اول صبح"
    },
    {
      "id": 27,
      "start": 3398.16,
      "end": 3399.16,
      "formatted_start": "00:56:38.160",
      "formatted_end": "00:56:39.160",
      "text": "شیر نداره بیشتر"
    },
    {
      "id": 28,
      "start": 3399.16,
      "end": 3400.16,
      "formatted_start": "00:56:39.160",
      "formatted_end": "00:56:40.160",
      "text": "حالا باشه"
    },
    {
      "id": 29,
      "start": 3400.16,
      "end": 3401.16,
      "formatted_start": "00:56:40.160",
      "formatted_end": "00:56:41.160",
      "text": "بله"
    },
    {
      "id": 30,
