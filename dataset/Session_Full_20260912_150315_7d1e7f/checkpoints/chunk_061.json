  "stt_segments": [
    {
      "id": 0,
      "start": 18300.0,
      "end": 18309.0,
      "formatted_start": "05:05:00.000",
      "formatted_end": "05:05:09.000",
      "text": "گفتن که شیرخوش که نانه یک استفاده کنیم، ما همون ارگو داریم میریم جلو. نمیدونیم باید تغییر بدیم به دستوری."
    },
    {
      "id": 1,
      "start": 18309.0,
      "end": 18312.0,
      "formatted_start": "05:05:09.000",
      "formatted_end": "05:05:12.000",
      "text": "شان تا یک سالگی نانه یک بدی، تا شیش مایگی."
    },
    {
      "id": 2,
      "start": 18312.0,
      "end": 18313.0,
      "formatted_start": "05:05:12.000",
      "formatted_end": "05:05:13.000",
      "text": "بله."
    },
    {
      "id": 3,
      "start": 18313.0,
      "end": 18321.0,
      "formatted_start": "05:05:13.000",
      "formatted_end": "05:05:21.000",
      "text": "یک مایگی تا شیش مایگی نانه یک، شیش ما تا دوازده مایگی نانه دو، بعد از یک سالگیش نانه سه."
    },
    {
      "id": 4,
      "start": 18321.0,
      "end": 18323.0,
      "formatted_start": "05:05:21.000",
      "formatted_end": "05:05:23.000",
      "text": "اوجا؟"
    },
    {
      "id": 5,
      "start": 18323.0,
      "end": 18325.0,
      "formatted_start": "05:05:23.000",
      "formatted_end": "05:05:25.000",
      "text": "هر شیش ما یه درجه میرو بالا."
    },
    {
      "id": 6,
      "start": 18325.0,
      "end": 18326.0,
      "formatted_start": "05:05:25.000",
      "formatted_end": "05:05:26.000",
      "text": "بله."
    },
    {
      "id": 7,
      "start": 18326.0,
      "end": 18328.0,
      "formatted_start": "05:05:26.000",
      "formatted_end": "05:05:28.000",
      "text": "متعه دیگه بین نگه هست بگی نانه؟"
    },
    {
      "id": 8,
      "start": 18328.0,
      "end": 18330.0,
      "formatted_start": "05:05:28.000",
      "formatted_end": "05:05:30.000",
      "text": "بگیرم بگیرم"
    },
    {
      "id": 9,
      "start": 18330.0,
      "end": 18332.0,
      "formatted_start": "05:05:30.000",
      "formatted_end": "05:05:32.000",
      "text": "بگیرم"
    },
    {
      "id": 10,
      "start": 18332.0,
      "end": 18334.0,
      "formatted_start": "05:05:32.000",
      "formatted_end": "05:05:34.000",
      "text": "باشون درست هست"
    },
    {
      "id": 11,
      "start": 18334.0,
      "end": 18336.0,
      "formatted_start": "05:05:34.000",
      "formatted_end": "05:05:36.000",
      "text": "پدر محبت داره"
    },
    {
      "id": 12,
      "start": 18336.0,
      "end": 18338.0,
      "formatted_start": "05:05:36.000",
      "formatted_end": "05:05:38.000",
      "text": "برونوش درخیر نداری"
    },
    {
      "id": 13,
      "start": 18338.0,
      "end": 18340.0,
      "formatted_start": "05:05:38.000",
      "formatted_end": "05:05:40.000",
      "text": "یک دنیا ودروپومات سریع بیار من بگیرم"
    },
    {
      "id": 14,
      "start": 18340.0,
      "end": 18342.0,
      "formatted_start": "05:05:40.000",
      "formatted_end": "05:05:42.000",
      "text": "از این چشمیه"
    },
    {
      "id": 15,
      "start": 18342.0,
      "end": 18344.0,
      "formatted_start": "05:05:42.000",
      "formatted_end": "05:05:44.000",
      "text": "باشون بگیرم"
    },
    {
      "id": 16,
      "start": 18344.0,
      "end": 18346.0,
      "formatted_start": "05:05:44.000",
      "formatted_end": "05:05:46.000",
      "text": "ششش بگیرم"
    },
    {
      "id": 17,
      "start": 18346.0,
      "end": 18348.0,
      "formatted_start": "05:05:46.000",
      "formatted_end": "05:05:48.000",
      "text": "باشون"
    },
    {
      "id": 18,
      "start": 18348.0,
      "end": 18350.0,
      "formatted_start": "05:05:48.000",
      "formatted_end": "05:05:50.000",
      "text": "بازر باید شو"
    },
    {
      "id": 19,
      "start": 18354.0,
      "end": 18356.0,
      "formatted_start": "05:05:54.000",
      "formatted_end": "05:05:56.000",
      "text": "بخونم"
    },
    {
      "id": 20,
      "start": 18356.0,
      "end": 18358.0,
      "formatted_start": "05:05:56.000",
      "formatted_end": "05:05:58.000",
      "text": "او باید بشید"
    },
    {
      "id": 21,
      "start": 18358.0,
      "end": 18360.0,
      "formatted_start": "05:05:58.000",
      "formatted_end": "05:06:00.000",
      "text": "سلامت بشید"
    },
    {
      "id": 22,
      "start": 18360.0,
      "end": 18362.0,
      "formatted_start": "05:06:00.000",
      "formatted_end": "05:06:02.000",
      "text": "چی بوده؟"
    },
    {
      "id": 23,
      "start": 18362.0,
      "end": 18364.0,
      "formatted_start": "05:06:02.000",
      "formatted_end": "05:06:04.000",
      "text": "سونه سفرانوز"
    },
    {
      "id": 24,
      "start": 18364.0,
      "end": 18366.0,
      "formatted_start": "05:06:04.000",
      "formatted_end": "05:06:06.000",
      "text": "میروز بود؟"
    },
    {
      "id": 25,
      "start": 18366.0,
      "end": 18368.0,
      "formatted_start": "05:06:06.000",
      "formatted_end": "05:06:08.000",
      "text": "آره"
    },
    {
      "id": 26,
      "start": 18368.0,
      "end": 18370.0,
      "formatted_start": "05:06:08.000",
      "formatted_end": "05:06:10.000",
      "text": "پشت میخواد تون درست بود کنم"
    },
    {
      "id": 27,
      "start": 18370.0,
      "end": 18372.0,
      "formatted_start": "05:06:10.000",
      "formatted_end": "05:06:12.000",
      "text": "درد شکم داشت؟"
    },
    {
      "id": 28,
      "start": 18372.0,
      "end": 18374.0,
      "formatted_start": "05:06:12.000",
      "formatted_end": "05:06:14.000",
      "text": "آره بعدم خیلی ترک میکرد"
    },
    {
      "id": 29,
      "start": 18374.0,
      "end": 18376.0,
      "formatted_start": "05:06:14.000",
      "formatted_end": "05:06:16.000",
      "text": "دیوز بود که آن پول بزنیم"
    },
    {
      "id": 30,
      "start": 18376.0,
      "end": 18378.0,
      "formatted_start": "05:06:16.000",
      "formatted_end": "05:06:18.000",
      "text": "تا یه مندر ساعت چار"
    },
    {
      "id": 31,
      "start": 18378.0,
      "end": 18380.0,
      "formatted_start": "05:06:18.000",
      "formatted_end": "05:06:20.000",
      "text": "اوکی بود تبشت کنترل شده"
    },
    {
      "id": 32,
      "start": 18380.0,
      "end": 18382.0,
      "formatted_start": "05:06:20.000",
      "formatted_end": "05:06:22.000",
      "text": "یه مندر سیزمون پول دوباره با سرشت"
    },
    {
      "id": 33,
      "start": 18382.0,
      "end": 18384.0,
      "formatted_start": "05:06:22.000",
      "formatted_end": "05:06:24.000",
      "text": "و سیونی و چه بود"
    },
    {
      "id": 34,
      "start": 18384.0,
      "end": 18386.0,
      "formatted_start": "05:06:24.000",
      "formatted_end": "05:06:26.000",
      "text": "اونم زده باشیم"
    },
    {
      "id": 35,
      "start": 18386.0,
      "end": 18388.0,
      "formatted_start": "05:06:26.000",
      "formatted_end": "05:06:28.000",
      "text": "صرف زدین؟"
    },
    {
      "id": 36,
      "start": 18388.0,
      "end": 18390.0,
      "formatted_start": "05:06:28.000",
      "formatted_end": "05:06:30.000",
      "text": "نه قبل از همین به نوازمونشی بگیم 120"
    },
    {
      "id": 37,
      "start": 18390.0,
      "end": 18392.0,
      "formatted_start": "05:06:30.000",
      "formatted_end": "05:06:32.000",
      "text": "120"
    },
    {
      "id": 38,
      "start": 18392.0,
      "end": 18396.0,
      "formatted_start": "05:06:32.000",
      "formatted_end": "05:06:36.000",
      "text": "خیلی نیست یه قده لنفی داخل شکن من کنار باعث درد شکن میشه"
    },
    {
      "id": 39,
      "start": 18396.0,
      "end": 18398.0,
      "formatted_start": "05:06:36.000",
      "formatted_end": "05:06:38.000",
      "text": "و بعد هم گوه میشه"
    },
    {
      "id": 40,
      "start": 18398.0,
      "end": 18400.0,
      "formatted_start": "05:06:38.000",
      "formatted_end": "05:06:40.000",
      "text": "و تبشو"
    },
    {
      "id": 41,
      "start": 18400.0,
      "end": 18402.0,
      "formatted_start": "05:06:40.000",
      "formatted_end": "05:06:42.000",
      "text": "تبشو آنتیویتیک دادیم دیگه"
    },
    {
      "id": 42,
      "start": 18402.0,
      "end": 18404.0,
      "formatted_start": "05:06:42.000",
      "formatted_end": "05:06:44.000",
      "text": "همونوی که دادیم با مولا"
    },
    {
      "id": 43,
      "start": 18404.0,
      "end": 18406.0,
      "formatted_start": "05:06:44.000",
      "formatted_end": "05:06:46.000",
      "text": "همونوی که دادیم با مولا"
    },
    {
      "id": 44,
      "start": 18406.0,
      "end": 18408.0,
      "formatted_start": "05:06:46.000",
      "formatted_end": "05:06:48.000",
      "text": "از دیوز اومده بودیم"
    },
    {
      "id": 45,
      "start": 18408.0,
      "end": 18410.0,
      "formatted_start": "05:06:48.000",
      "formatted_end": "05:06:50.000",
      "text": "همونو ادامه میدینیم"
    },
    {
      "id": 46,
      "start": 18410.0,
      "end": 18412.0,
      "formatted_start": "05:06:50.000",
      "formatted_end": "05:06:52.000",
      "text": "همونو سریع خوب نمیشه بچهانه"
    },
    {
      "id": 47,
      "start": 18412.0,
      "end": 18442.0,
      "formatted_start": "05:06:52.000",
      "formatted_end": "05:07:22.000",
      "text": "درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید که درست دارید"
    },
    {
      "id": 48,
      "start": 18442.0,
      "end": 18445.5,
      "formatted_start": "05:07:22.000",
      "formatted_end": "05:07:25.500",
      "text": "از دودتر بدید خیلی زیاد نمیشه چون آجیم هم کالوریش بالایه"
    },
    {
      "id": 49,
      "start": 18445.5,
      "end": 18448.0,
      "formatted_start": "05:07:25.500",
      "formatted_end": "05:07:28.000",
      "text": "خیلی هم آجیم خوبه ولی خب"
    },
    {
      "id": 50,
      "start": 18448.0,
      "end": 18451.0,
      "formatted_start": "05:07:28.000",
      "formatted_end": "05:07:31.000",
      "text": "خیلی مثلا در شکل قرار دیگه بودی آجیم مو خوره"
    },
    {
      "id": 51,
      "start": 18451.0,
      "end": 18454.0,
      "formatted_start": "05:07:31.000",
      "formatted_end": "05:07:34.000",
      "text": "نه نه اونشکار نداره آجیم خیلی هم خوبه"
    },
    {
      "id": 52,
      "start": 18454.0,
      "end": 18457.0,
      "formatted_start": "05:07:34.000",
      "formatted_end": "05:07:37.000",
      "text": "من گفتم برایش مثلا چون بودم چینیم خوره"
    },
    {
      "id": 53,
      "start": 18457.0,
      "end": 18459.0,
      "formatted_start": "05:07:37.000",
      "formatted_end": "05:07:39.000",
      "text": "گفتم یه مرگ یه چیزی برایش میگیرم"
    },
    {
      "id": 54,
      "start": 18459.0,
      "end": 18460.0,
      "formatted_start": "05:07:39.000",
      "formatted_end": "05:07:40.000",
      "text": "چه با کنم؟ مرگ یه مثلا؟"
    },
    {
      "id": 55,
      "start": 18460.0,
      "end": 18462.0,
      "formatted_start": "05:07:40.000",
      "formatted_end": "05:07:42.000",
      "text": "کواب یه چیز این"
    },
    {
      "id": 56,
      "start": 18462.0,
      "end": 18463.0,
      "formatted_start": "05:07:42.000",
      "formatted_end": "05:07:43.000",
      "text": "کواب خوبه"
    },
    {
      "id": 57,
      "start": 18463.0,
      "end": 18493.0,
      "formatted_start": "05:07:43.000",
      "formatted_end": "05:08:13.000",
      "text": "اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخورید، اگر نخواهید بخوری"
    },
    {
      "id": 58,
      "start": 18493.0,
      "end": 18495.0,
      "formatted_start": "05:08:13.000",
      "formatted_end": "05:08:15.000",
      "text": "در اینجا داره آیتانی بشه بده"
    },
    {
      "id": 59,
      "start": 18495.0,
      "end": 18497.0,
      "formatted_start": "05:08:15.000",
      "formatted_end": "05:08:17.000",
      "text": "ببین مثلا میگهش به چیز"
    },
    {
      "id": 60,
      "start": 18497.0,
      "end": 18499.0,
      "formatted_start": "05:08:17.000",
      "formatted_end": "05:08:19.000",
      "text": "اگه سوپه اگه مرده اگه خروسه"
    },
    {
      "id": 61,
      "start": 18499.0,
      "end": 18501.0,
      "formatted_start": "05:08:19.000",
      "formatted_end": "05:08:21.000",
      "text": "خوب من دارم اینکه"
    },
    {
      "id": 62,
      "start": 18501.0,
      "end": 18503.0,
      "formatted_start": "05:08:21.000",
      "formatted_end": "05:08:23.000",
      "text": "ذائقهه"
    },
    {
      "id": 63,
      "start": 18503.0,
      "end": 18505.0,
      "formatted_start": "05:08:23.000",
      "formatted_end": "05:08:25.000",
      "text": "هرام خودت مثلا هیچ چیزی میگه داری چیزی نداری"
    },
    {
      "id": 64,
      "start": 18505.0,
      "end": 18507.0,
      "formatted_start": "05:08:25.000",
      "formatted_end": "05:08:27.000",
      "text": "نه من گفتم خودت اینجا میگه داشت اینجوریه"
    },
    {
      "id": 65,
      "start": 18507.0,
      "end": 18509.0,
      "formatted_start": "05:08:27.000",
      "formatted_end": "05:08:29.000",
      "text": "نه من خودت نه نه"
    },
    {
      "id": 66,
      "start": 18509.0,
      "end": 18511.0,
      "formatted_start": "05:08:29.000",
      "formatted_end": "05:08:31.000",
      "text": "نه نه"
    },
    {
      "id": 67,
      "start": 18511.0,
      "end": 18513.0,
      "formatted_start": "05:08:31.000",
      "formatted_end": "05:08:33.000",
      "text": "از اون بکه هیچ چیزی نه"
    },
    {
      "id": 68,
      "start": 18513.0,
      "end": 18515.0,
      "formatted_start": "05:08:33.000",
      "formatted_end": "05:08:35.000",
      "text": "نه موردنار این راستی کن میگهش دستیب"
    },
    {
      "id": 69,
      "start": 18515.0,
      "end": 18517.0,
      "formatted_start": "05:08:35.000",
      "formatted_end": "05:08:37.000",
      "text": "نه برد برد"
    },
    {
      "id": 70,
      "start": 18517.0,
      "end": 18519.0,
      "formatted_start": "05:08:37.000",
      "formatted_end": "05:08:39.000",
      "text": "برد برد برد"
    },
    {
      "id": 71,
      "start": 18519.0,
      "end": 18524.0,
      "formatted_start": "05:08:39.000",
      "formatted_end": "05:08:44.000",
      "text": "این شعبت اسپری دسموپرسین"
    },
    {
      "id": 72,
      "start": 18524.0,
      "end": 18531.0,
      "formatted_start": "05:08:44.000",
      "formatted_end": "05:08:51.000",
      "text": "بیمه یاداد؟ بیمه هستیم بگیم اون بیمه کنم"
    },
    {
      "id": 73,
      "start": 18531.0,
      "end": 18541.0,
      "formatted_start": "05:08:51.000",
      "formatted_end": "05:09:01.000",
      "text": "باید بیمه نداشتیم چرا؟ برگرد بزنیم"
    },
    {
      "id": 74,
      "start": 18541.0,
      "end": 18547.0,
      "formatted_start": "05:09:01.000",
      "formatted_end": "05:09:07.000",
      "text": "آه سامیتین اسپری دسموپرسین بگیدید شباب دو تا هر بینش دو سه تا میگید"
    },
    {
      "id": 75,
      "start": 18547.0,
      "end": 18551.16,
      "formatted_start": "05:09:07.000",
      "formatted_end": "05:09:11.160",
      "text": "این پابیه پیمه میشه، این قرنزه میشه"
    },
    {
      "id": 76,
      "start": 18551.16,
      "end": 18553.16,
      "formatted_start": "05:09:11.160",
      "formatted_end": "05:09:13.160",
      "text": "باشید، باشید، باشید"
    },
    {
      "id": 77,
      "start": 18553.16,
      "end": 18555.16,
      "formatted_start": "05:09:13.160",
      "formatted_end": "05:09:15.160",
      "text": "باشید، باشید"
    },
    {
      "id": 78,
      "start": 18555.16,
      "end": 18557.16,
      "formatted_start": "05:09:15.160",
      "formatted_end": "05:09:17.160",
      "text": "خدا فراموشید"
    },
    {
      "id": 79,
      "start": 18557.16,
      "end": 18559.16,
      "formatted_start": "05:09:17.160",
      "formatted_end": "05:09:19.160",
      "text": "حالی سامی، این مال شمایی؟"
    },
    {
      "id": 80,
      "start": 18559.16,
      "end": 18561.16,
      "formatted_start": "05:09:19.160",
      "formatted_end": "05:09:21.160",
      "text": "آره، آره، آره، آره"
    },
    {
      "id": 81,
      "start": 18561.16,
      "end": 18563.16,
      "formatted_start": "05:09:21.160",
      "formatted_end": "05:09:23.160",
      "text": "یه فکر داریم"
    },
    {
      "id": 82,
      "start": 18565.16,
      "end": 18567.16,
      "formatted_start": "05:09:25.160",
      "formatted_end": "05:09:27.160",
      "text": "باشید"
    },
    {
      "id": 83,
      "start": 18567.16,
      "end": 18569.16,
      "formatted_start": "05:09:27.160",
      "formatted_end": "05:09:29.160",
      "text": "خدا فراموشید"
    },
    {
      "id": 84,
      "start": 18569.16,
      "end": 18571.16,
      "formatted_start": "05:09:29.160",
      "formatted_end": "05:09:31.160",
      "text": "بفرمید، سلام سلامت باشید"
    },
    {
      "id": 85,
      "start": 18571.16,
      "end": 18573.16,
      "formatted_start": "05:09:31.160",
      "formatted_end": "05:09:33.160",
      "text": "بردارم"
    },
    {
      "id": 86,
      "start": 18573.16,
      "end": 18575.16,
      "formatted_start": "05:09:33.160",
      "formatted_end": "05:09:35.160",
      "text": "این شرط داره اشتهاب روزی دو برد"
    },
    {
      "id": 87,
      "start": 18575.16,
      "end": 18578.16,
      "formatted_start": "05:09:35.160",
      "formatted_end": "05:09:38.160",
      "text": "یک روز استفاده اصلا مالشان بود انگل"
    },
    {
      "id": 88,
      "start": 18578.16,
      "end": 18579.16,
      "formatted_start": "05:09:38.160",
      "formatted_end": "05:09:39.160",
      "text": "نه نه"
    },
    {
      "id": 89,
      "start": 18579.16,
      "end": 18580.16,
      "formatted_start": "05:09:39.160",
      "formatted_end": "05:09:40.160",
      "text": "خرابت انگل رو کنه نداشت"
    },
    {
      "id": 90,
      "start": 18580.16,
      "end": 18582.16,
      "formatted_start": "05:09:40.160",
      "formatted_end": "05:09:42.160",
      "text": "با من بهت بخورتم این دومی رو دیگه"
    },
    {
      "id": 91,
      "start": 18582.16,
      "end": 18586.16,
      "formatted_start": "05:09:42.160",
      "formatted_end": "05:09:46.160",
      "text": "من تا هم نوشتم بهت بخورتم که دومی نواشه نگیر"
    },
    {
      "id": 92,
      "start": 18586.16,
      "end": 18588.16,
      "formatted_start": "05:09:46.160",
      "formatted_end": "05:09:48.160",
      "text": "یعنی هیچ که نظره نگیر رفتم"
    },
    {
      "id": 93,
      "start": 18588.16,
      "end": 18591.16,
      "formatted_start": "05:09:48.160",
      "formatted_end": "05:09:51.160",
      "text": "نه دیگه نگیر این ها اون اصر داستان کرمکشه"
    },
    {
      "id": 94,
      "start": 18591.16,
      "end": 18596.16,
      "formatted_start": "05:09:51.160",
      "formatted_end": "05:09:56.160",
      "text": "من تا هم قیل مز نوشتم بهت بخورتم دومی مشابه ندن نگیر"
    },
    {
      "id": 95,
      "start": 18596.16,
      "end": 18598.16,
      "formatted_start": "05:09:56.160",
      "formatted_end": "05:09:58.160",
      "text": "این داروخان ها پیدا سختن میده"
    },
    {
      "id": 96,
      "start": 18598.16,
      "end": 18599.98,
      "formatted_start": "05:09:58.160",
      "formatted_end": "05:09:59.980",
      "text": "این کار که با مردم در این ویدیو باید برداری کنید."
    }
  ],
  "status": "completed"
}