  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1802.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:02.000",
      "text": "از سینه شیر از بینیش؟"
    },
    {
      "id": 1,
      "start": 1802.0,
      "end": 1804.0,
      "formatted_start": "00:30:02.000",
      "formatted_end": "00:30:04.000",
      "text": "نه، از سینه شیر."
    },
    {
      "id": 2,
      "start": 1804.0,
      "end": 1822.0,
      "formatted_start": "00:30:04.000",
      "formatted_end": "00:30:22.000",
      "text": "بعد به شیر میدم، آراغشو میگیرم، وقتی آراغشو دیر میگیرم، میزارمش، یه حو مصالت یه ذره صرفه داره، درخواهی گرش بکنید، یه ذره خیلی دیر میگرده."
    },
    {
      "id": 3,
      "start": 1822.0,
      "end": 1824.0,
      "formatted_start": "00:30:22.000",
      "formatted_end": "00:30:24.000",
      "text": "شیرم بعد میگردونه؟"
    },
    {
      "id": 4,
      "start": 1824.0,
      "end": 1826.0,
      "formatted_start": "00:30:24.000",
      "formatted_end": "00:30:26.000",
      "text": "نه، بعد نمیگردونم."
    },
    {
      "id": 5,
      "start": 1826.0,
      "end": 1832.0,
      "formatted_start": "00:30:26.000",
      "formatted_end": "00:30:32.000",
      "text": "اما دو سه روز یک روزی رو شده ترسیده باید بسیار در وقت شد"
    },
    {
      "id": 6,
      "start": 1832.0,
      "end": 1834.0,
      "formatted_start": "00:30:32.000",
      "formatted_end": "00:30:34.000",
      "text": "یکی نمی نشده همه چیزی نشده"
    },
    {
      "id": 7,
      "start": 1840.0,
      "end": 1842.0,
      "formatted_start": "00:30:40.000",
      "formatted_end": "00:30:42.000",
      "text": "ببینی کمسنده شکست کنه"
    },
    {
      "id": 8,
      "start": 1842.0,
      "end": 1844.0,
      "formatted_start": "00:30:42.000",
      "formatted_end": "00:30:44.000",
      "text": "آره، داره نه؟"
    },
    {
      "id": 9,
      "start": 1844.0,
      "end": 1846.0,
      "formatted_start": "00:30:44.000",
      "formatted_end": "00:30:46.000",
      "text": "آره، کس کس کس"
    },
    {
      "id": 10,
      "start": 1846.0,
      "end": 1850.0,
      "formatted_start": "00:30:46.000",
      "formatted_end": "00:30:50.000",
      "text": "باید این موقع ها میمیز زیاد میشه و این موقع ها کم"
    },
    {
      "id": 11,
      "start": 1850.0,
      "end": 1852.0,
      "formatted_start": "00:30:50.000",
      "formatted_end": "00:30:52.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 1852.0,
      "end": 1854.0,
      "formatted_start": "00:30:52.000",
      "formatted_end": "00:30:54.000",
      "text": "که مثلا تلتون هم شیر بکره"
    },
    {
      "id": 13,
      "start": 1854.0,
      "end": 1862.0,
      "formatted_start": "00:30:54.000",
      "formatted_end": "00:31:02.000",
      "text": "از اینکه شیر بکره خوبه و یک گروهی در گروه بیدید تا زور باشه یا سول باشه"
    },
    {
      "id": 14,
      "start": 1862.0,
      "end": 1868.0,
      "formatted_start": "00:31:02.000",
      "formatted_end": "00:31:08.000",
      "text": "یک گروهی میزارمش یا آرومش گرفته میشه یا گرفته نمیشه یک گروه بالا میاره"
    },
    {
      "id": 15,
      "start": 1868.0,
      "end": 1873.0,
      "formatted_start": "00:31:08.000",
      "formatted_end": "00:31:13.000",
      "text": "بالا نمیاره و مثلا خیلی درخواه درش باشه و نمیتونه تا خوره دوری میشه"
    },
    {
      "id": 16,
      "start": 1873.0,
      "end": 1877.0,
      "formatted_start": "00:31:13.000",
      "formatted_end": "00:31:17.000",
      "text": "خیلی بیدید خاملیتون خانمه خود در رو بزنه"
    },
    {
      "id": 17,
      "start": 1877.0,
      "end": 1879.0,
      "formatted_start": "00:31:17.000",
      "formatted_end": "00:31:19.000",
      "text": "خب این صدا را داریم"
    },
    {
      "id": 18,
      "start": 1879.0,
      "end": 1881.0,
      "formatted_start": "00:31:19.000",
      "formatted_end": "00:31:21.000",
      "text": "اون محمد زده"
    },
    {
      "id": 19,
      "start": 1881.0,
      "end": 1883.0,
      "formatted_start": "00:31:21.000",
      "formatted_end": "00:31:23.000",
      "text": "ببنیم تذکیره باید بیدیم"
    },
    {
      "id": 20,
      "start": 1883.0,
      "end": 1887.0,
      "formatted_start": "00:31:23.000",
      "formatted_end": "00:31:27.000",
      "text": "خانم محمد زده ببینیم این افونت این سرما نخواهی"
    },
    {
      "id": 21,
      "start": 1887.0,
      "end": 1893.0,
      "formatted_start": "00:31:27.000",
      "formatted_end": "00:31:33.000",
      "text": "اتفاقی که افتاده اینی که این شیر را بر میگردنه میده رای گلوی اون خلتی که میگیره"
    },
    {
      "id": 22,
      "start": 1893.0,
      "end": 1895.0,
      "formatted_start": "00:31:33.000",
      "formatted_end": "00:31:35.000",
      "text": "میره داخل ریاهاش"
    },
    {
      "id": 23,
      "start": 1895.0,
      "end": 1897.0,
      "formatted_start": "00:31:35.000",
      "formatted_end": "00:31:37.000",
      "text": "بعد ریاهاش خسخس میکنه"
    },
    {
      "id": 24,
      "start": 1897.0,
      "end": 1899.0,
      "formatted_start": "00:31:37.000",
      "formatted_end": "00:31:39.000",
      "text": "شیر که داخل ریاه میره سینه میره"
    },
    {
      "id": 25,
      "start": 1899.0,
      "end": 1901.0,
      "formatted_start": "00:31:39.000",
      "formatted_end": "00:31:41.000",
      "text": "این شیر میره و باید میشه سلاکه"
    },
    {
      "id": 26,
      "start": 1901.0,
      "end": 1905.0,
      "formatted_start": "00:31:41.000",
      "formatted_end": "00:31:45.000",
      "text": "و بعد یکم این شیر جزم میشه دوباره از طریق خون"
    },
    {
      "id": 27,
      "start": 1905.0,
      "end": 1907.0,
      "formatted_start": "00:31:45.000",
      "formatted_end": "00:31:47.000",
      "text": "خوب میشه و باید دوباره اینقدر میخواد حفظ بشه"
    },
    {
      "id": 28,
      "start": 1907.0,
      "end": 1909.0,
      "formatted_start": "00:31:47.000",
      "formatted_end": "00:31:49.000",
      "text": "میاد میاد و بیرین کنه"
    },
    {
      "id": 29,
      "start": 1909.0,
