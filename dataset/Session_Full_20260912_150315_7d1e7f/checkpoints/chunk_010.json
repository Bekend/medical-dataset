  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3003.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:03.000",
      "text": "باید خیلی باشه، یعنی هر چی باشه خیلی باشه."
    },
    {
      "id": 1,
      "start": 3005.0,
      "end": 3006.0,
      "formatted_start": "00:50:05.000",
      "formatted_end": "00:50:06.000",
      "text": "حالا، راحت شدید."
    },
    {
      "id": 2,
      "start": 3008.0,
      "end": 3009.0,
      "formatted_start": "00:50:08.000",
      "formatted_end": "00:50:09.000",
      "text": "برم."
    },
    {
      "id": 3,
      "start": 3010.0,
      "end": 3011.0,
      "formatted_start": "00:50:10.000",
      "formatted_end": "00:50:11.000",
      "text": "برم."
    },
    {
      "id": 4,
      "start": 3020.0,
      "end": 3021.0,
      "formatted_start": "00:50:20.000",
      "formatted_end": "00:50:21.000",
      "text": "برم."
    },
    {
      "id": 5,
      "start": 3022.0,
      "end": 3023.0,
      "formatted_start": "00:50:22.000",
      "formatted_end": "00:50:23.000",
      "text": "درسته."
    },
    {
      "id": 6,
      "start": 3023.0,
      "end": 3024.0,
      "formatted_start": "00:50:23.000",
      "formatted_end": "00:50:24.000",
      "text": "برم."
    },
    {
      "id": 7,
      "start": 3025.0,
      "end": 3026.0,
      "formatted_start": "00:50:25.000",
      "formatted_end": "00:50:26.000",
      "text": "زنده باشیم."
    },
    {
      "id": 8,
      "start": 3026.0,
      "end": 3029.56,
      "formatted_start": "00:50:26.000",
      "formatted_end": "00:50:29.560",
      "text": "برنامه جده باشیم، درست شما درد نمونه با"
    },
    {
      "id": 9,
      "start": 3029.56,
      "end": 3034.0,
      "formatted_start": "00:50:29.560",
      "formatted_end": "00:50:34.000",
      "text": "انشالله الان یه برنامه تغییر تشکر جامعه باید از شما بشه اینا"
    },
    {
      "id": 10,
      "start": 3034.0,
      "end": 3036.44,
      "formatted_start": "00:50:34.000",
      "formatted_end": "00:50:36.440",
      "text": "خب نه الان تی کمترینه"
    },
    {
      "id": 11,
      "start": 3036.44,
      "end": 3038.24,
      "formatted_start": "00:50:36.440",
      "formatted_end": "00:50:38.240",
      "text": "تی کمترینه که باید"
    },
    {
      "id": 12,
      "start": 3038.24,
      "end": 3042.44,
      "formatted_start": "00:50:38.240",
      "formatted_end": "00:50:42.440",
      "text": "برو دکتر جان، پس اگر شما زمانیشو میتونیم بکشید که"
    },
    {
      "id": 13,
      "start": 3046.44,
      "end": 3050.4,
      "formatted_start": "00:50:46.440",
      "formatted_end": "00:50:50.400",
      "text": "خب پس این انشالله تا فردا اگر تونیستی"
    },
    {
      "id": 14,
      "start": 3056.0,
      "end": 3065.0,
      "formatted_start": "00:50:56.000",
      "formatted_end": "00:51:05.000",
      "text": "دکتر ببین ما که چند روز رایی که داشتیم من همون تعدادی که دوست داشتم رو نوشتیم"
    },
    {
      "id": 15,
      "start": 3065.0,
      "end": 3069.0,
      "formatted_start": "00:51:05.000",
      "formatted_end": "00:51:09.000",
      "text": "من اصلا شما رو اکنون خودم بود"
    },
    {
      "id": 16,
      "start": 3069.0,
      "end": 3075.0,
      "formatted_start": "00:51:09.000",
      "formatted_end": "00:51:15.000",
      "text": "شما دکتر من دو دلیل ببین"
    },
    {
      "id": 17,
      "start": 3075.0,
      "end": 3080.0,
      "formatted_start": "00:51:15.000",
      "formatted_end": "00:51:20.000",
      "text": "آره نه شما"
    },
    {
      "id": 18,
      "start": 3080.0,
      "end": 3092.0,
      "formatted_start": "00:51:20.000",
      "formatted_end": "00:51:32.000",
      "text": "دکتر جاییم، آره ببین من دو سال کلمتی آدم، میگه عصب تازی را یه تازیانه بس هست."
    },
    {
      "id": 19,
      "start": 3092.0,
      "end": 3102.0,
      "formatted_start": "00:51:32.000",
      "formatted_end": "00:51:42.000",
      "text": "یه تازه نیست. شما، من وقتی برخورد شما رو دیدم، برخورد آقایی اون رو بدم، از پرواز و شیخی و اکزیگلی کار اسمی میخوام ببرم،"
    },
    {
      "id": 20,
      "start": 3102.0,
      "end": 3112.0,
      "formatted_start": "00:51:42.000",
      "formatted_end": "00:51:52.000",
      "text": "آدم حساب شخصیت افراد را سی شده بود. شخصیت ها، نفر. شخصیت شما برای من بسیار قابلیت احترام است."
    },
    {
      "id": 21,
      "start": 3112.0,
      "end": 3122.0,
      "formatted_start": "00:51:52.000",
      "formatted_end": "00:52:02.000",
      "text": "بسیار قابلیت است. اون هیچ کنی بی عدوی، هیچ کنی کلک و حقوق و بازی، جسارت، هیچ کنی سو استفاده، هیچ کنی بغرون است."
    },
    {
      "id": 22,
      "start": 3122.0,
      "end": 3128.0,
      "formatted_start": "00:52:02.000",
      "formatted_end": "00:52:08.000",
      "text": "حالا اون عشق و کاریزمایی که به اون شخصیت که برای مدیریت داری، به نظر من باعث میشه که تو این کارها ورود کنی."
    },
    {
      "id": 23,
      "start": 3128.0,
      "end": 3133.0,
      "formatted_start": "00:52:08.000",
      "formatted_end": "00:52:13.000",
      "text": "بخاطر اون جنیتیک شمایی اون کاریزما باشید"
    },
    {
      "id": 24,
      "start": 3133.0,
      "end": 3138.0,
      "formatted_start": "00:52:13.000",
      "formatted_end": "00:52:18.000",
      "text": "نه اصلا دارید اصلا سیستم میسوزه دکتره"
    },
    {
      "id": 25,
      "start": 3138.0,
      "end": 3146.0,
      "formatted_start": "00:52:18.000",
      "formatted_end": "00:52:26.000",
      "text": "آره خب آره در این حال الان ببین این توانندی رو دارید"
    },
    {
      "id": 26,
      "start": 3146.0,
      "end": 3149.0,
      "formatted_start": "00:52:26.000",
      "formatted_end": "00:52:29.000",
      "text": "این هم کنه داره این توانندی رو هم داره"
    },
    {
      "id": 27,
      "start": 3149.0,
      "end": 3154.0,
      "formatted_start": "00:52:29.000",
      "formatted_end": "00:52:34.000",
      "text": "الان کار ندارم ولی افرادی هم بودن که گفتم دکتر"
    },
    {
      "id": 28,
      "start": 3154.0,
      "end": 3157.0,
      "formatted_start": "00:52:34.000",
      "formatted_end": "00:52:37.000",
      "text": "ببین از دو جا خوردید به نظرم"
    },
    {
      "id": 29,
      "start": 3157.0,
      "end": 3160.0,
      "formatted_start": "00:52:37.000",
      "formatted_end": "00:52:40.000",
      "text": "من در این وقت شما برادر و همکارت دارم ویم"
    },
    {
      "id": 30,
      "start": 3160.0,
      "end": 3162.0,
      "formatted_start": "00:52:40.000",
      "formatted_end": "00:52:42.000",
      "text": "از دو جا خوردید"
    },
    {
      "id": 31,
      "start": 3162.0,
      "end": 3166.0,
      "formatted_start": "00:52:42.000",
      "formatted_end": "00:52:46.000",
      "text": "یک بار اومدم و بخواهم دکتر دومتو به شیخی نبند"
    },
    {
      "id": 32,
      "start": 3166.0,
      "end": 3169.0,
      "formatted_start": "00:52:46.000",
      "formatted_end": "00:52:49.000",
      "text": "داده ترس کنم دومتو به اون نبند"
    },
    {
      "id": 33,
      "start": 3169.0,
      "end": 3170.0,
      "formatted_start": "00:52:49.000",
      "formatted_end": "00:52:50.000",
      "text": "این یکی"
    },
    {
      "id": 34,
      "start": 3170.0,
      "end": 3173.0,
      "formatted_start": "00:52:50.000",
      "formatted_end": "00:52:53.000",
      "text": "از این آمل قبیلی نبود شاید 30 درصد آمل"
    },
    {
      "id": 35,
      "start": 3173.0,
      "end": 3178.0,
      "formatted_start": "00:52:53.000",
      "formatted_end": "00:52:58.000",
      "text": "ببین 70 درصد شما مدیریت کردید موضوع خود رو مهندسی کردید"
    },
    {
      "id": 36,
      "start": 3178.0,
      "end": 3181.0,
      "formatted_start": "00:52:58.000",
      "formatted_end": "00:53:01.000",
      "text": "این رو کردید خوب هم کردید"
    },
    {
      "id": 37,
      "start": 3181.0,
      "end": 3184.24,
      "formatted_start": "00:53:01.000",
      "formatted_end": "00:53:04.240",
      "text": "ولی تو رای دادن خودتو مدیریت نکردی"
    },
    {
      "id": 38,
      "start": 3184.24,
      "end": 3187.42,
      "formatted_start": "00:53:04.240",
      "formatted_end": "00:53:07.420",
      "text": "رای خودتو مدیریت نکردی"
    },
    {
      "id": 39,
      "start": 3187.42,
      "end": 3190.0,
      "formatted_start": "00:53:07.420",
      "formatted_end": "00:53:10.000",
      "text": "حسنیت اون صداقت آفرین"
    },
    {
      "id": 40,
      "start": 3190.0,
      "end": 3197.52,
      "formatted_start": "00:53:10.000",
      "formatted_end": "00:53:17.520",
      "text": "نه ببین شما واقعا اونا وقتی که طرف میاد تو"
    },
    {
      "id": 41,
      "start": 3197.52,
      "end": 3205.0,
      "formatted_start": "00:53:17.520",
      "formatted_end": "00:53:25.000",
      "text": "نه دکتر اونا هایی که وقتی میان میگن آقا دیگه شما تاریخ مصرفتون گذشته و سنیتون فلان بمیدن"
    },
    {
      "id": 42,
      "start": 3205.0,
      "end": 3210.48,
      "formatted_start": "00:53:25.000",
      "formatted_end": "00:53:30.480",
      "text": "باز برای با اونا رای میدیم اونا که دارن تو جلسات مخالفت حرف بزنن بازم داریم رونفاز میدیم"
    },
    {
      "id": 43,
      "start": 3210.48,
      "end": 3217.48,
      "formatted_start": "00:53:30.480",
      "formatted_end": "00:53:37.480",
      "text": "اینو ماندارن میگن"
    },
    {
      "id": 44,
      "start": 3240.48,
      "end": 3241.48,
      "formatted_start": "00:54:00.480",
      "formatted_end": "00:54:01.480",
      "text": "بر"
    },
    {
      "id": 45,
      "start": 3242.72,
      "end": 3243.72,
      "formatted_start": "00:54:02.720",
      "formatted_end": "00:54:03.720",
      "text": "نمیدونم"
    },
    {
      "id": 46,
      "start": 3243.72,
      "end": 3245.56,
      "formatted_start": "00:54:03.720",
      "formatted_end": "00:54:05.560",
      "text": "بذرگش کنید گذشت تمام کند"
    },
    {
      "id": 47,
      "start": 3245.56,
      "end": 3247.56,
      "formatted_start": "00:54:05.560",
      "formatted_end": "00:54:07.560",
      "text": "انشالله خیلیتی باشه توش اینو"
    },
    {
      "id": 48,
      "start": 3247.56,
      "end": 3248.56,
      "formatted_start": "00:54:07.560",
      "formatted_end": "00:54:08.560",
      "text": "ممنون دکتر جایی"
    },
    {
      "id": 49,
      "start": 3248.56,
      "end": 3251.16,
      "formatted_start": "00:54:08.560",
      "formatted_end": "00:54:11.160",
      "text": "پس تا فردا اگر حالوش داشتید"
    },
    {
      "id": 50,
      "start": 3251.16,
      "end": 3253.16,
      "formatted_start": "00:54:11.160",
      "formatted_end": "00:54:13.160",
      "text": "بنویسید انشالله که بنویسید"
    },
    {
      "id": 51,
      "start": 3253.16,
      "end": 3257.04,
      "formatted_start": "00:54:13.160",
      "formatted_end": "00:54:17.040",
      "text": "اگر هم یه وقتی نتونستید بگین که ما بدیم یه نفر دیگه بنویسیم"
    },
    {
      "id": 52,
      "start": 3257.04,
      "end": 3259.04,
      "formatted_start": "00:54:17.040",
      "formatted_end": "00:54:19.040",
      "text": "ممنون سپاس بذارم"
    },
    {
      "id": 53,
      "start": 3270.48,
      "end": 3299.48,
      "formatted_start": "00:54:30.480",
      "formatted_end": "00:54:59.480",
      "text": "موسیقی"
    }
  ],
