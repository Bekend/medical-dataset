      "end": 4626.0,
      "formatted_start": "01:17:04.000",
      "formatted_end": "01:17:06.000",
      "text": "خیلی خوب"
    },
    {
      "id": 35,
      "start": 4626.0,
      "end": 4628.0,
      "formatted_start": "01:17:06.000",
      "formatted_end": "01:17:08.000",
      "text": "خیلی خوب"
    },
    {
      "id": 36,
      "start": 4628.0,
      "end": 4633.64,
      "formatted_start": "01:17:08.000",
      "formatted_end": "01:17:13.640",
      "text": "خب شما یه بار دیگه باشه"
    },
    {
      "id": 37,
      "start": 4633.64,
      "end": 4635.84,
      "formatted_start": "01:17:13.640",
      "formatted_end": "01:17:15.840",
      "text": "آره"
    },
    {
      "id": 38,
      "start": 4635.84,
      "end": 4637.1,
      "formatted_start": "01:17:15.840",
      "formatted_end": "01:17:17.100",
      "text": "عجیبه"
    },
    {
      "id": 39,
      "start": 4637.1,
      "end": 4638.96,
      "formatted_start": "01:17:17.100",
      "formatted_end": "01:17:18.960",
      "text": "عجیبه"
    },
    {
      "id": 40,
      "start": 4638.96,
      "end": 4640.62,
      "formatted_start": "01:17:18.960",
      "formatted_end": "01:17:20.620",
      "text": "من فکر نمی کردم"
    },
    {
      "id": 41,
      "start": 4640.62,
      "end": 4643.7,
      "formatted_start": "01:17:20.620",
      "formatted_end": "01:17:23.700",
      "text": "همین"
    },
    {
      "id": 42,
      "start": 4643.7,
      "end": 4644.38,
      "formatted_start": "01:17:23.700",
      "formatted_end": "01:17:24.380",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 4644.38,
      "end": 4647.1,
      "formatted_start": "01:17:24.380",
      "formatted_end": "01:17:27.100",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 4647.1,
      "end": 4648.7,
      "formatted_start": "01:17:27.100",
      "formatted_end": "01:17:28.700",
      "text": "اصلا ما میخواییم تغییر بشه"
    },
    {
      "id": 45,
      "start": 4648.7,
      "end": 4651.18,
      "formatted_start": "01:17:28.700",
      "formatted_end": "01:17:31.180",
      "text": "ما ستا اومدیم که تغییرات به وجود بیاد"
    },
    {
      "id": 46,
      "start": 4651.18,
      "end": 4658.48,
      "formatted_start": "01:17:31.180",
      "formatted_end": "01:17:38.480",
      "text": "حالا عجله نمی بینید"
    },
    {
      "id": 47,
      "start": 4658.48,
      "end": 4660.0,
      "formatted_start": "01:17:38.480",
      "formatted_end": "01:17:40.000",
      "text": "الان فیلن دوتا ما هستیم"
    },
    {
      "id": 48,
      "start": 4660.0,
      "end": 4661.68,
      "formatted_start": "01:17:40.000",
      "formatted_end": "01:17:41.680",
      "text": "یه نفر دیگه می خواهیم"
    },
    {
      "id": 49,
      "start": 4661.68,
      "end": 4662.84,
      "formatted_start": "01:17:41.680",
      "formatted_end": "01:17:42.840",
      "text": "یا امی شیخی"
    },
    {
      "id": 50,
      "start": 4662.84,
      "end": 4666.0,
      "formatted_start": "01:17:42.840",
      "formatted_end": "01:17:46.000",
      "text": "یا اسمش بحرام"
    },
    {
      "id": 51,
      "start": 4666.0,
      "end": 4667.34,
      "formatted_start": "01:17:46.000",
      "formatted_end": "01:17:47.340",
      "text": "بحرام اینا"
    },
    {
      "id": 52,
      "start": 4667.34,
      "end": 4668.98,
      "formatted_start": "01:17:47.340",
      "formatted_end": "01:17:48.980",
      "text": "باید باشون صحبت کردید"
    },
    {
      "id": 53,
      "start": 4668.98,
      "end": 4670.82,
      "formatted_start": "01:17:48.980",
      "formatted_end": "01:17:50.820",
      "text": "شما شیخی رو صحبت کن"
    },
    {
      "id": 54,
      "start": 4670.82,
      "end": 4672.92,
      "formatted_start": "01:17:50.820",
      "formatted_end": "01:17:52.920",
      "text": "من با نفسی و با بحرام"
    },
    {
      "id": 55,
      "start": 4672.92,
      "end": 4674.3,
      "formatted_start": "01:17:52.920",
      "formatted_end": "01:17:54.300",
      "text": "محلاقه هم صحبت می کنم"
    },
    {
      "id": 56,
      "start": 4674.3,
      "end": 4676.4,
      "formatted_start": "01:17:54.300",
      "formatted_end": "01:17:56.400",
      "text": "آره"
    },
    {
      "id": 57,
      "start": 4676.4,
      "end": 4677.42,
      "formatted_start": "01:17:56.400",
      "formatted_end": "01:17:57.420",
      "text": "باشه"
    },
    {
      "id": 58,
      "start": 4677.42,
      "end": 4679.08,
      "formatted_start": "01:17:57.420",
      "formatted_end": "01:17:59.080",
      "text": "حالا من اساسنامه رو نگاه کنم"
    },
    {
      "id": 59,
