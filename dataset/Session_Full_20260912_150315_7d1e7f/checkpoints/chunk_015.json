  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4510.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:10.000",
      "text": "خوب به شما بشه، و اون نه نه، اون با پاشایی چیزه."
    },
    {
      "id": 1,
      "start": 4510.0,
      "end": 4516.0,
      "formatted_start": "01:15:10.000",
      "formatted_end": "01:15:16.000",
      "text": "شما میتونین لفظ دیدید؟"
    },
    {
      "id": 2,
      "start": 4516.0,
      "end": 4523.0,
      "formatted_start": "01:15:16.000",
      "formatted_end": "01:15:23.000",
      "text": "خوب خوب بودنشون دقیق نیست که اون بذاره، اون با که."
    },
    {
      "id": 3,
      "start": 4523.0,
      "end": 4527.0,
      "formatted_start": "01:15:23.000",
      "formatted_end": "01:15:27.000",
      "text": "چون گفته بوده که من آزم برم کنار پاشایی بیاد جای من."
    },
    {
      "id": 4,
      "start": 4527.0,
      "end": 4532.0,
      "formatted_start": "01:15:27.000",
      "formatted_end": "01:15:32.000",
      "text": "خب این وقتی بگیریم در الارم بدیره داره میده"
    },
    {
      "id": 5,
      "start": 4532.0,
      "end": 4540.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:40.000",
      "text": "خب پاشایی هم این در ریلکس ده به نظر من دیمه داره فکر میکنه که میتونه دوباره بیاد اینا خب"
    },
    {
      "id": 6,
      "start": 4540.0,
      "end": 4546.0,
      "formatted_start": "01:15:40.000",
      "formatted_end": "01:15:46.000",
      "text": "خب الان شما یه صحبت کشید باشید چون من با شیخی خیلی چیز نیستم اینو خب"
    },
    {
      "id": 7,
      "start": 4546.0,
      "end": 4552.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:52.000",
      "text": "ببینید که اینو اینجوریه مثلا اندام کنید که مثلا در صورت چیز هست اینا"
    },
    {
      "id": 8,
      "start": 4552.0,
      "end": 4554.0,
      "formatted_start": "01:15:52.000",
      "formatted_end": "01:15:54.000",
      "text": "مسخود هست اینا"
    },
    {
      "id": 9,
      "start": 4554.0,
      "end": 4556.0,
      "formatted_start": "01:15:54.000",
      "formatted_end": "01:15:56.000",
      "text": "حالا نیستم لازمه بگیریم"
    },
    {
      "id": 10,
      "start": 4566.0,
      "end": 4568.0,
      "formatted_start": "01:16:06.000",
      "formatted_end": "01:16:08.000",
      "text": "آره نه خوبه"
    },
    {
      "id": 11,
      "start": 4568.0,
      "end": 4570.0,
      "formatted_start": "01:16:08.000",
      "formatted_end": "01:16:10.000",
      "text": "اصلا میاد یه نفر"
    },
    {
      "id": 12,
      "start": 4570.0,
      "end": 4572.0,
      "formatted_start": "01:16:10.000",
      "formatted_end": "01:16:12.000",
      "text": "ببین یه"
    },
    {
      "id": 13,
      "start": 4572.0,
      "end": 4574.0,
      "formatted_start": "01:16:12.000",
      "formatted_end": "01:16:14.000",
      "text": "نه خاندکتر ببینید اینا خیلی کار پیده"
    },
    {
      "id": 14,
      "start": 4574.0,
      "end": 4576.0,
      "formatted_start": "01:16:14.000",
      "formatted_end": "01:16:16.000",
      "text": "یه نفر قای مقام بزرگه"
    },
    {
      "id": 15,
      "start": 4576.0,
      "end": 4578.0,
      "formatted_start": "01:16:16.000",
      "formatted_end": "01:16:18.000",
      "text": "مثل شیخی"
    },
    {
      "id": 16,
      "start": 4578.0,
      "end": 4580.0,
      "formatted_start": "01:16:18.000",
      "formatted_end": "01:16:20.000",
      "text": "خودش هم توی شهر هست و هست توی بیمارستان"
    },
    {
      "id": 17,
      "start": 4580.0,
      "end": 4584.0,
      "formatted_start": "01:16:20.000",
      "formatted_end": "01:16:24.000",
      "text": "خب اشراف داره، پیشتر روزان آباسان اونجا داره عمل داره"
    },
    {
      "id": 18,
      "start": 4584.0,
      "end": 4588.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:28.000",
      "text": "یه نفر قای مقام و محکم میذاره، خودش هم هست"
    },
    {
      "id": 19,
      "start": 4588.0,
      "end": 4592.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:32.000",
      "text": "من که بسیار... آره خب شیطان... آره..."
    },
    {
      "id": 20,
      "start": 4592.0,
      "end": 4596.0,
      "formatted_start": "01:16:32.000",
      "formatted_end": "01:16:36.000",
      "text": "آره رحیمی کسی برای راه هستن بچه هایی که..."
    },
    {
      "id": 21,
      "start": 4596.0,
      "end": 4600.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:40.000",
      "text": "آباسان رحیمی چیزش بود... آره خودش هم هست دیگه"
    },
    {
      "id": 22,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "خیلی خوب"
    },
    {
      "id": 23,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "خیلی خوب"
    },
    {
      "id": 24,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
