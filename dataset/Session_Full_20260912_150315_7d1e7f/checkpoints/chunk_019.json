    {
      "id": 9,
      "start": 5968.0,
      "end": 5969.54,
      "formatted_start": "01:39:28.000",
      "formatted_end": "01:39:29.540",
      "text": "حالا صبح آمده تو"
    },
    {
      "id": 10,
      "start": 5969.54,
      "end": 5971.54,
      "formatted_start": "01:39:29.540",
      "formatted_end": "01:39:31.540",
      "text": "خوب هستین، خسته نباشید"
    },
    {
      "id": 11,
      "start": 5971.54,
      "end": 5974.96,
      "formatted_start": "01:39:31.540",
      "formatted_end": "01:39:34.960",
      "text": "برابر شما، یه دو دقیقه میتونین صرفت کنید"
    },
    {
      "id": 12,
      "start": 5974.96,
      "end": 5975.96,
      "formatted_start": "01:39:34.960",
      "formatted_end": "01:39:35.960",
      "text": "ببخشید"
    },
    {
      "id": 13,
      "start": 5975.96,
      "end": 5979.6,
      "formatted_start": "01:39:35.960",
      "formatted_end": "01:39:39.600",
      "text": "از صورت که اینجور خانم جهنتی زنی زده دید"
    },
    {
      "id": 14,
      "start": 5979.6,
      "end": 5981.4,
      "formatted_start": "01:39:39.600",
      "formatted_end": "01:39:41.400",
      "text": "در مورد تطریفش ها قرار داده که"
    },
    {
      "id": 15,
      "start": 5981.4,
      "end": 5983.4,
      "formatted_start": "01:39:41.400",
      "formatted_end": "01:39:43.400",
      "text": "شما از نظر بانک ها اینا باید"
    },
    {
      "id": 16,
      "start": 5983.4,
      "end": 5987.6,
      "formatted_start": "01:39:43.400",
      "formatted_end": "01:39:47.600",
      "text": "چون این حیات چیز عوض شده"
    },
    {
      "id": 17,
      "start": 5987.6,
      "end": 5991.4,
      "formatted_start": "01:39:47.600",
      "formatted_end": "01:39:51.400",
      "text": "مشخص کنید چون حقوق رو میخواییم بدیم اینا مشکل لگن اینا"
    },
    {
      "id": 18,
      "start": 5991.4,
      "end": 5992.4,
      "formatted_start": "01:39:51.400",
      "formatted_end": "01:39:52.400",
      "text": "خب"
    },
    {
      "id": 19,
      "start": 5992.4,
      "end": 5998.56,
      "formatted_start": "01:39:52.400",
      "formatted_end": "01:39:58.560",
      "text": "گفتم که تو اولین فرصت ما یک جلسه بزنیم که ازایی یکم دیگر..."
    },
    {
      "id": 20,
      "start": 5998.56,
      "end": 5999.98,
      "formatted_start": "01:39:58.560",
      "formatted_end": "01:39:59.980",
      "text": "آره، آفرین"
    }
  ],
