  "stt_segments": [
    {
      "id": 0,
      "start": 16800.0,
      "end": 16820.0,
      "formatted_start": "04:40:00.000",
      "formatted_end": "04:40:20.000",
      "text": "مدترین بیمار، بیمار، آزمایش و نسخه"
    },
    {
      "id": 1,
      "start": 16830.0,
      "end": 16859.98,
      "formatted_start": "04:40:30.000",
      "formatted_end": "04:40:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 16860.0,
      "end": 16889.98,
      "formatted_start": "04:41:00.000",
      "formatted_end": "04:41:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 3,
      "start": 16890.0,
      "end": 16914.0,
      "formatted_start": "04:41:30.000",
      "formatted_end": "04:41:54.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 16914.0,
      "end": 16917.0,
      "formatted_start": "04:41:54.000",
      "formatted_end": "04:41:57.000",
      "text": "بخونید سلام بابای جان سلام بابای جان"
    },
    {
      "id": 5,
      "start": 16917.0,
      "end": 16920.0,
      "formatted_start": "04:41:57.000",
      "formatted_end": "04:42:00.000",
      "text": "بخونید بخونید بخونید بخونید"
    },
    {
      "id": 6,
      "start": 16920.0,
      "end": 16923.0,
      "formatted_start": "04:42:00.000",
      "formatted_end": "04:42:03.000",
      "text": "بله گوشواره اینا را آوردیم"
    },
    {
      "id": 7,
      "start": 16923.0,
      "end": 16926.0,
      "formatted_start": "04:42:03.000",
      "formatted_end": "04:42:06.000",
      "text": "چرا دیگه خامسمی؟"
    },
    {
      "id": 8,
      "start": 16926.0,
      "end": 16929.0,
      "formatted_start": "04:42:06.000",
      "formatted_end": "04:42:09.000",
      "text": "خامسمی گوشواره پنبرل کلی اینا بدید؟"
    },
    {
      "id": 9,
      "start": 16936.0,
      "end": 16941.0,
      "formatted_start": "04:42:16.000",
      "formatted_end": "04:42:21.000",
      "text": "خب ببینید الان که گوشش را سراخ کردم"
    },
    {
      "id": 10,
      "start": 16941.0,
      "end": 16943.0,
      "formatted_start": "04:42:21.000",
      "formatted_end": "04:42:23.000",
      "text": "او فاقلیتون که نامه؟"
    },
    {
      "id": 11,
      "start": 16943.0,
      "end": 16944.0,
      "formatted_start": "04:42:23.000",
      "formatted_end": "04:42:24.000",
      "text": "ویسانی"
    },
    {
      "id": 12,
      "start": 16944.0,
      "end": 16946.0,
      "formatted_start": "04:42:24.000",
      "formatted_end": "04:42:26.000",
      "text": "اون کسی برگی ندادن بهتون؟ به کارت"
    },
    {
      "id": 13,
      "start": 16946.0,
      "end": 16949.0,
      "formatted_start": "04:42:26.000",
      "formatted_end": "04:42:29.000",
      "text": "برگی بفرم، بیرون فرم دارم، او شب می کنی باید برگی بیرون"
    },
    {
      "id": 14,
      "start": 16949.0,
      "end": 16953.0,
      "formatted_start": "04:42:29.000",
      "formatted_end": "04:42:33.000",
      "text": "نه نه، بینیم چیزی بده من از این رو مبادر کنم ببین"
    },
    {
      "id": 15,
      "start": 16953.0,
      "end": 16954.0,
      "formatted_start": "04:42:33.000",
      "formatted_end": "04:42:34.000",
      "text": "این فارمشون بخورده؟"
    },
    {
      "id": 16,
      "start": 16954.0,
      "end": 16955.0,
      "formatted_start": "04:42:34.000",
      "formatted_end": "04:42:35.000",
      "text": "نه"
    },
    {
      "id": 17,
      "start": 16955.0,
      "end": 16956.0,
      "formatted_start": "04:42:35.000",
      "formatted_end": "04:42:36.000",
      "text": "خوام سمیت؟"
    },
    {
      "id": 18,
      "start": 16956.0,
      "end": 16957.0,
      "formatted_start": "04:42:36.000",
      "formatted_end": "04:42:37.000",
      "text": "نه"
    },
    {
      "id": 19,
      "start": 16957.0,
      "end": 16959.0,
      "formatted_start": "04:42:37.000",
      "formatted_end": "04:42:39.000",
      "text": "این کارتشون رو بیزنما ساده کنیم بره"
    },
    {
      "id": 20,
      "start": 16979.0,
      "end": 17003.0,
      "formatted_start": "04:42:59.000",
      "formatted_end": "04:43:23.000",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 17003.0,
      "end": 17005.0,
      "formatted_start": "04:43:23.000",
      "formatted_end": "04:43:25.000",
      "text": "چه هست گرفتن خانمی از جنب؟"
    },
    {
      "id": 22,
      "start": 17005.0,
      "end": 17007.0,
      "formatted_start": "04:43:25.000",
      "formatted_end": "04:43:27.000",
      "text": "این کتش هم کتش هم برد"
    },
    {
      "id": 23,
      "start": 17007.0,
      "end": 17009.0,
      "formatted_start": "04:43:27.000",
      "formatted_end": "04:43:29.000",
      "text": "کشیمون"
    },
    {
      "id": 24,
      "start": 17009.0,
      "end": 17012.0,
      "formatted_start": "04:43:29.000",
      "formatted_end": "04:43:32.000",
      "text": "نه نه کشیمون این میدار تا ایزه اومده"
    },
    {
      "id": 25,
      "start": 17012.0,
      "end": 17013.0,
      "formatted_start": "04:43:32.000",
      "formatted_end": "04:43:33.000",
      "text": "یاد اونو نداریم"
    },
    {
      "id": 26,
      "start": 17013.0,
      "end": 17015.0,
      "formatted_start": "04:43:33.000",
      "formatted_end": "04:43:35.000",
      "text": "این کتش هم برده بسیار سال ها نداریم"
    },
    {
      "id": 27,
      "start": 17015.0,
      "end": 17016.0,
      "formatted_start": "04:43:35.000",
      "formatted_end": "04:43:36.000",
      "text": "بلوست ببینیم"
    },
    {
      "id": 28,
      "start": 17016.0,
      "end": 17019.0,
      "formatted_start": "04:43:36.000",
      "formatted_end": "04:43:39.000",
      "text": "خب بیزن به این عجم میداره"
    },
    {
      "id": 29,
      "start": 17019.0,
      "end": 17020.0,
      "formatted_start": "04:43:39.000",
      "formatted_end": "04:43:40.000",
      "text": "خدا خوشتانی برده"
    },
    {
      "id": 30,
      "start": 17020.0,
      "end": 17021.0,
      "formatted_start": "04:43:40.000",
      "formatted_end": "04:43:41.000",
      "text": "آقای جامعه"
    },
    {
      "id": 31,
      "start": 17021.0,
      "end": 17022.0,
      "formatted_start": "04:43:41.000",
      "formatted_end": "04:43:42.000",
      "text": "بشه برده هر که برده"
    },
    {
      "id": 32,
      "start": 17022.0,
      "end": 17024.0,
      "formatted_start": "04:43:42.000",
      "formatted_end": "04:43:44.000",
      "text": "خانمی خوشتانی ببینید"
    },
    {
      "id": 33,
      "start": 17024.0,
      "end": 17029.0,
      "formatted_start": "04:43:44.000",
      "formatted_end": "04:43:49.000",
      "text": "هران که سراخ کردن تا دو هفته بوشبال ها بیند تا فردا به بوشاش آب نخوره"
    },
    {
      "id": 34,
      "start": 17029.0,
      "end": 17032.0,
      "formatted_start": "04:43:49.000",
      "formatted_end": "04:43:52.000",
      "text": "این پماد رو روزی سه بار به بوشاش میزنی"
    },
    {
      "id": 35,
      "start": 17032.0,
      "end": 17038.0,
      "formatted_start": "04:43:52.000",
      "formatted_end": "04:43:58.000",
      "text": "خب، هلان گریه می کنه از این اتاق که رفتیم بیرون دیگه آبی نمیشه، خب؟"
    },
    {
      "id": 36,
      "start": 17038.0,
      "end": 17040.0,
      "formatted_start": "04:43:58.000",
      "formatted_end": "04:44:00.000",
      "text": "باید بیمارستان شاهده بودی؟"
    },
    {
      "id": 37,
      "start": 17040.0,
      "end": 17042.0,
      "formatted_start": "04:44:00.000",
      "formatted_end": "04:44:02.000",
      "text": "بیمارستان شاهده"
    },
    {
      "id": 38,
      "start": 17042.0,
      "end": 17044.0,
      "formatted_start": "04:44:02.000",
      "formatted_end": "04:44:04.000",
      "text": "خب اونو بگیر"
    },
    {
      "id": 39,
      "start": 17044.0,
      "end": 17046.0,
      "formatted_start": "04:44:04.000",
      "formatted_end": "04:44:06.000",
      "text": "اوزو داره دو هفته بگیر میکنه؟"
    },
    {
      "id": 40,
      "start": 17046.0,
      "end": 17048.0,
      "formatted_start": "04:44:06.000",
      "formatted_end": "04:44:08.000",
      "text": "اوزو باید چند روزی بدی"
    },
    {
      "id": 41,
      "start": 17048.0,
      "end": 17050.0,
      "formatted_start": "04:44:08.000",
      "formatted_end": "04:44:10.000",
      "text": "چار روزی"
    },
    {
      "id": 42,
      "start": 17050.0,
      "end": 17052.0,
      "formatted_start": "04:44:10.000",
      "formatted_end": "04:44:12.000",
      "text": "باید بیمارستان شاهده بودی"
    },
    {
      "id": 43,
      "start": 17052.0,
      "end": 17054.0,
      "formatted_start": "04:44:12.000",
      "formatted_end": "04:44:14.000",
      "text": "خب اونو بگیر"
    },
    {
      "id": 44,
      "start": 17054.0,
      "end": 17056.0,
      "formatted_start": "04:44:14.000",
      "formatted_end": "04:44:16.000",
      "text": "اوزو داره دو هفته بگیر میکنه؟"
    },
    {
      "id": 45,
      "start": 17056.0,
      "end": 17058.0,
      "formatted_start": "04:44:16.000",
      "formatted_end": "04:44:18.000",
      "text": "اوزو باید چند روزی بدی"
    },
    {
      "id": 46,
      "start": 17058.0,
      "end": 17060.0,
      "formatted_start": "04:44:18.000",
      "formatted_end": "04:44:20.000",
      "text": "چار روزی"
    },
    {
      "id": 47,
      "start": 17060.0,
      "end": 17062.0,
      "formatted_start": "04:44:20.000",
      "formatted_end": "04:44:22.000",
      "text": "باید بیمارستان شاهده بودی"
    },
    {
      "id": 48,
      "start": 17062.0,
      "end": 17064.0,
      "formatted_start": "04:44:22.000",
      "formatted_end": "04:44:24.000",
      "text": "خب اونو بگیر میکنه؟"
    },
    {
      "id": 49,
      "start": 17064.0,
      "end": 17066.0,
      "formatted_start": "04:44:24.000",
      "formatted_end": "04:44:26.000",
      "text": "اوزو باید چند روزی بدی"
    },
    {
      "id": 50,
      "start": 17068.0,
      "end": 17070.0,
      "formatted_start": "04:44:28.000",
      "formatted_end": "04:44:30.000",
      "text": "خب این چیز رو ببینید میگوییم"
    },
    {
      "id": 51,
      "start": 17070.0,
      "end": 17076.0,
      "formatted_start": "04:44:30.000",
      "formatted_end": "04:44:36.000",
      "text": "روی تایترون بشینه یه دست دست یه دست سرشو مکم لگه داد خود لگه داد"
    },
    {
      "id": 52,
      "start": 17076.0,
      "end": 17077.0,
      "formatted_start": "04:44:36.000",
      "formatted_end": "04:44:37.000",
      "text": "تکن نده"
    },
    {
      "id": 53,
      "start": 17077.0,
      "end": 17079.0,
      "formatted_start": "04:44:37.000",
      "formatted_end": "04:44:39.000",
      "text": "تکن نده شو باید خودت رو لباس نده"
    },
    {
      "id": 54,
      "start": 17083.0,
      "end": 17085.0,
      "formatted_start": "04:44:43.000",
      "formatted_end": "04:44:45.000",
      "text": "کافی کم شد"
    },
    {
      "id": 55,
      "start": 17085.0,
      "end": 17087.0,
      "formatted_start": "04:44:45.000",
      "formatted_end": "04:44:47.000",
      "text": "کافی نه اینا هیچ درد نده ده"
    },
    {
      "id": 56,
      "start": 17087.0,
      "end": 17089.0,
      "formatted_start": "04:44:47.000",
      "formatted_end": "04:44:49.000",
      "text": "توی پوش اونو بگوییم"
    },
    {
      "id": 57,
      "start": 17091.0,
      "end": 17093.0,
      "formatted_start": "04:44:51.000",
      "formatted_end": "04:44:53.000",
      "text": "بعد از دو هفته بشه برای تبشه نشون شده"
    },
    {
      "id": 58,
      "start": 17093.0,
      "end": 17094.0,
      "formatted_start": "04:44:53.000",
      "formatted_end": "04:44:54.000",
      "text": "بعده بعده"
    },
    {
      "id": 59,
      "start": 17094.0,
      "end": 17100.0,
      "formatted_start": "04:44:54.000",
