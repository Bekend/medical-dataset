      "end": 9050.0,
      "formatted_start": "02:30:48.000",
      "formatted_end": "02:30:50.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 16,
      "start": 9050.0,
      "end": 9052.0,
      "formatted_start": "02:30:50.000",
      "formatted_end": "02:30:52.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 17,
      "start": 9052.0,
      "end": 9054.0,
      "formatted_start": "02:30:52.000",
      "formatted_end": "02:30:54.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 18,
      "start": 9054.0,
      "end": 9060.0,
      "formatted_start": "02:30:54.000",
      "formatted_end": "02:31:00.000",
      "text": "پشت سریع میدی این خیلی زود داره راه نما میزنه"
    },
    {
      "id": 19,
      "start": 9060.0,
      "end": 9064.0,
      "formatted_start": "02:31:00.000",
      "formatted_end": "02:31:04.000",
      "text": "این نقشه اینجایی داره نگاه میکنه"
    },
    {
      "id": 20,
      "start": 9064.0,
      "end": 9069.0,
      "formatted_start": "02:31:04.000",
      "formatted_end": "02:31:09.000",
      "text": "نه این دار ماشین بزرگه از اینجا بون و رفتن سخته"
    },
    {
      "id": 21,
      "start": 9069.0,
      "end": 9074.0,
      "formatted_start": "02:31:09.000",
      "formatted_end": "02:31:14.000",
      "text": "از سرعت هم نمیتونه بره وار در جنب"
    },
    {
      "id": 22,
      "start": 9074.0,
      "end": 9077.0,
      "formatted_start": "02:31:14.000",
      "formatted_end": "02:31:17.000",
      "text": "نه باز باز اون نقشه دارن نگاه میکنن"
    },
    {
      "id": 23,
      "start": 9077.0,
      "end": 9080.0,
      "formatted_start": "02:31:17.000",
      "formatted_end": "02:31:20.000",
      "text": "نقشه دارن میگن الان باید بپیجین"
    },
    {
      "id": 24,
      "start": 9080.0,
      "end": 9082.0,
      "formatted_start": "02:31:20.000",
      "formatted_end": "02:31:22.000",
      "text": "آرام آرام دنبال اونه"
    },
    {
      "id": 25,
      "start": 9084.0,
      "end": 9088.5,
      "formatted_start": "02:31:24.000",
      "formatted_end": "02:31:28.500",
      "text": "ببین این نوع فرمان گرفتم شده خوب شده"
    },
    {
      "id": 26,
      "start": 9088.5,
      "end": 9091.06,
      "formatted_start": "02:31:28.500",
      "formatted_end": "02:31:31.060",
      "text": "این نوع من الان به چیز دستیسی ندارم"
    },
    {
      "id": 27,
      "start": 9091.06,
      "end": 9091.66,
      "formatted_start": "02:31:31.060",
      "formatted_end": "02:31:31.660",
      "text": "به چی؟"
    },
    {
      "id": 28,
      "start": 9091.66,
      "end": 9092.62,
      "formatted_start": "02:31:31.660",
      "formatted_end": "02:31:32.620",
      "text": "بوغ"
    },
    {
      "id": 29,
      "start": 9092.62,
      "end": 9094.26,
      "formatted_start": "02:31:32.620",
      "formatted_end": "02:31:34.260",
      "text": "بوغ با دست دیگه"
    },
    {
      "id": 30,
      "start": 9094.26,
      "end": 9097.16,
      "formatted_start": "02:31:34.260",
      "formatted_end": "02:31:37.160",
      "text": "نه بیده اون حالت من دستم هاشم با بوغمیده"
    },
    {
      "id": 31,
      "start": 9097.16,
      "end": 9100.56,
      "formatted_start": "02:31:37.160",
      "formatted_end": "02:31:40.560",
      "text": "نه اون حالت درست بوغه داری ولی تسلط نداری"
    },
    {
      "id": 32,
      "start": 9100.56,
      "end": 9102.0,
      "formatted_start": "02:31:40.560",
      "formatted_end": "02:31:42.000",
      "text": "این بازی کامپیتری نیست که"
    },
    {
      "id": 33,
      "start": 9103.0,
      "end": 9105.7,
      "formatted_start": "02:31:43.000",
      "formatted_end": "02:31:45.700",
      "text": "فرمان رو باید توی دست دیگه داری"
    },
    {
      "id": 34,
      "start": 9114.0,
      "end": 9122.16,
      "formatted_start": "02:31:54.000",
      "formatted_end": "02:32:02.160",
      "text": "این مثل هواپیما های ایرباسه"
    },
    {
      "id": 35,
      "start": 9122.16,
      "end": 9124.32,
      "formatted_start": "02:32:02.160",
      "formatted_end": "02:32:04.320",
      "text": "برای سلا بیرون داره یه جوریه"
    },
    {
      "id": 36,
      "start": 9124.32,
      "end": 9128.16,
      "formatted_start": "02:32:04.320",
      "formatted_end": "02:32:08.160",
      "text": "برای هواپیما های ملخی هستن که"
    },
    {
      "id": 37,
      "start": 9128.16,
      "end": 9128.58,
      "formatted_start": "02:32:08.160",
      "formatted_end": "02:32:08.580",
      "text": "مثلا"
    },
    {
      "id": 38,
      "start": 9128.58,
      "end": 9132.32,
      "formatted_start": "02:32:08.580",
      "formatted_end": "02:32:12.320",
      "text": "بزار رو فلش"
    },
    {
      "id": 39,
      "start": 9132.32,
      "end": 9133.94,
      "formatted_start": "02:32:12.320",
      "formatted_end": "02:32:13.940",
      "text": "فلش تویه؟"
    },
    {
      "id": 40,
      "start": 9133.94,
      "end": 9134.82,
      "formatted_start": "02:32:13.940",
      "formatted_end": "02:32:14.820",
      "text": "بزار رو فلش خوده"
    },
    {
      "id": 41,
      "start": 9134.82,
      "end": 9137.96,
      "formatted_start": "02:32:14.820",
      "formatted_end": "02:32:17.960",
      "text": "بزار رو فلش خوده"
    },
    {
      "id": 42,
      "start": 9137.96,
      "end": 9141.28,
      "formatted_start": "02:32:17.960",
      "formatted_end": "02:32:21.280",
      "text": "جاوی جا میگن بزار رو فلش خوده"
    },
    {
      "id": 43,
      "start": 9141.28,
      "end": 9142.16,
      "formatted_start": "02:32:21.280",
      "formatted_end": "02:32:22.160",
      "text": "که فلش خوده؟"
    },
    {
      "id": 44,
      "start": 9142.16,
      "end": 9143.7,
      "formatted_start": "02:32:22.160",
      "formatted_end": "02:32:23.700",
      "text": "بزار رو فلش خوده"
    },
    {
      "id": 45,
      "start": 9143.7,
      "end": 9146.2,
      "formatted_start": "02:32:23.700",
      "formatted_end": "02:32:26.200",
      "text": "بابا اگه الان فلش عوض توی فلش"
    },
    {
      "id": 46,
      "start": 9146.2,
      "end": 9148.6,
      "formatted_start": "02:32:26.200",
      "formatted_end": "02:32:28.600",
      "text": "فلشو ندارم گوشیمه اینا شواه دارن بینن"
    },
    {
      "id": 47,
      "start": 9148.6,
      "end": 9149.8,
      "formatted_start": "02:32:28.600",
      "formatted_end": "02:32:29.800",
      "text": "خب خب چی میگن فلش؟"
    },
    {
      "id": 48,
      "start": 9149.8,
      "end": 9150.8,
      "formatted_start": "02:32:29.800",
      "formatted_end": "02:32:30.800",
      "text": "شواه دارن بینن"
    },
    {
      "id": 49,
      "start": 9150.8,
      "end": 9152.8,
      "formatted_start": "02:32:30.800",
      "formatted_end": "02:32:32.800",
      "text": "من چرا؟ من فکر کردم فلش توی"
    },
    {
      "id": 50,
      "start": 9152.8,
      "end": 9154.8,
      "formatted_start": "02:32:32.800",
      "formatted_end": "02:32:34.800",
      "text": "نه گوشیم گذارم"
    },
    {
      "id": 51,
      "start": 9154.8,
      "end": 9156.8,
      "formatted_start": "02:32:34.800",
      "formatted_end": "02:32:36.800",
      "text": "همون بالا ببر فلش بیاد"
    },
    {
      "id": 52,
      "start": 9158.3,
      "end": 9160.3,
      "formatted_start": "02:32:38.300",
      "formatted_end": "02:32:40.300",
      "text": "رو سورس بزن"
    },
    {
      "id": 53,
      "start": 9160.3,
      "end": 9161.3,
      "formatted_start": "02:32:40.300",
      "formatted_end": "02:32:41.300",
      "text": "سفر"
    },
    {
      "id": 54,
      "start": 9161.3,
      "end": 9163.1,
      "formatted_start": "02:32:41.300",
      "formatted_end": "02:32:43.100",
      "text": "چون خود از بود فرخون عوض بگذار"
    },
    {
      "id": 55,
      "start": 9163.1,
      "end": 9165.8,
      "formatted_start": "02:32:43.100",
      "formatted_end": "02:32:45.800",
      "text": "نه الان ما مفاجر میشیم بیمیریم اونو"
    },
    {
      "id": 56,
      "start": 9165.8,
      "end": 9167.8,
      "formatted_start": "02:32:45.800",
      "formatted_end": "02:32:47.800",
      "text": "دست بیدم"
    },
    {
      "id": 57,
      "start": 9168.8,
      "end": 9169.8,
      "formatted_start": "02:32:48.800",
      "formatted_end": "02:32:49.800",
      "text": "اوه یو اس پی"
    },
    {
      "id": 58,
      "start": 9169.8,
      "end": 9171.8,
      "formatted_start": "02:32:49.800",
      "formatted_end": "02:32:51.800",
      "text": "بیر بایی یو اس پی بزن"
    },
    {
      "id": 59,
      "start": 9173.7,
      "end": 9201.7,
      "formatted_start": "02:32:53.700",
      "formatted_end": "02:33:21.700",
      "text": "موسیقی"
    },
    {
      "id": 60,
      "start": 9201.7,
      "end": 9207.7,
      "formatted_start": "02:33:21.700",
      "formatted_end": "02:33:27.700",
      "text": "موسیقی"
    },
    {
      "id": 61,
      "start": 9231.7,
      "end": 9240.02,
      "formatted_start": "02:33:51.700",
      "formatted_end": "02:34:00.020",
      "text": "داشتم اون راننده ها رو ارشاد میکردم"
    },
    {
      "id": 62,
      "start": 9240.02,
      "end": 9245.22,
      "formatted_start": "02:34:00.020",
      "formatted_end": "02:34:05.220",
      "text": "بعد این راننده داشت با این راننده سوال میکردم"
    },
    {
      "id": 63,
      "start": 9245.22,
      "end": 9246.58,
      "formatted_start": "02:34:05.220",
      "formatted_end": "02:34:06.580",
      "text": "من این راننده رو بایستاده بودم"
    },
    {
      "id": 64,
      "start": 9246.58,
      "end": 9253.18,
      "formatted_start": "02:34:06.580",
      "formatted_end": "02:34:13.180",
      "text": "بعد میگفت که آقا دروغ نگو مال مردم نخور فلان نکن"
    },
    {
      "id": 65,
      "start": 9253.18,
      "end": 9260.9,
      "formatted_start": "02:34:13.180",
      "formatted_end": "02:34:20.900",
      "text": "بعد لازم نیست برید نماز بخونی روزه بگیری فلان کنی پشمدان کنی قران بخونی"
    },
    {
      "id": 66,
      "start": 9260.9,
      "end": 9263.14,
      "formatted_start": "02:34:20.900",
      "formatted_end": "02:34:23.140",
      "text": "خب ریدم تو اینا"
    },
    {
      "id": 67,
      "start": 9263.14,
      "end": 9268.1,
      "formatted_start": "02:34:23.140",
      "formatted_end": "02:34:28.100",
      "text": "روحانده میخوفی"
    },
    {
      "id": 68,
      "start": 9268.1,
      "end": 9271.0,
      "formatted_start": "02:34:28.100",
      "formatted_end": "02:34:31.000",
      "text": "بعد من اونجا وایستا دیدم"
    },
    {
      "id": 69,
      "start": 9271.0,
      "end": 9272.84,
      "formatted_start": "02:34:31.000",
      "formatted_end": "02:34:32.840",
      "text": "این وره روح اصلا به طرف اونها نبود"
    },
    {
      "id": 70,
      "start": 9272.84,
      "end": 9274.6,
      "formatted_start": "02:34:32.840",
      "formatted_end": "02:34:34.600",
      "text": "بعد من گفت آقا درسته میگم"
    },
    {
      "id": 71,
      "start": 9274.6,
      "end": 9277.2,
      "formatted_start": "02:34:34.600",
      "formatted_end": "02:34:37.200",
      "text": "گفتم نه"
    },
    {
      "id": 72,
      "start": 9277.2,
      "end": 9278.66,
      "formatted_start": "02:34:37.200",
      "formatted_end": "02:34:38.660",
      "text": "بودم یه بخشش درست"
    },
    {
      "id": 73,
      "start": 9278.66,
      "end": 9280.02,
      "formatted_start": "02:34:38.660",
      "formatted_end": "02:34:40.020",
      "text": "یه بخشش ندرسته"
    },
    {
      "id": 74,
      "start": 9280.02,
      "end": 9282.14,
      "formatted_start": "02:34:40.020",
      "formatted_end": "02:34:42.140",
      "text": "بودم من خدا را قبول دارم دین قبول"
    },
    {
      "id": 75,
      "start": 9282.14,
      "end": 9284.68,
      "formatted_start": "02:34:42.140",
      "formatted_end": "02:34:44.680",
      "text": "بودم خدا میگه دین قبول کن"
    },
    {
      "id": 76,
      "start": 9284.68,
      "end": 9285.86,
      "formatted_start": "02:34:44.680",
      "formatted_end": "02:34:45.860",
      "text": "تو وقتی خدا را قبول داری"
    },
    {
      "id": 77,
      "start": 9285.86,
      "end": 9287.96,
      "formatted_start": "02:34:45.860",
      "formatted_end": "02:34:47.960",
      "text": "خدا میگه آقا یه دینی که من میفرستم"
    },
    {
      "id": 78,
      "start": 9287.96,
      "end": 9289.92,
      "formatted_start": "02:34:47.960",
      "formatted_end": "02:34:49.920",
      "text": "تو با همین نقشه برو جلو"
    },
    {
      "id": 79,
      "start": 9289.92,
      "end": 9293.44,
      "formatted_start": "02:34:49.920",
      "formatted_end": "02:34:53.440",
      "text": "بعد تو میگی من این نقشه رو اینجایش رو قبول دارم"
    },
    {
      "id": 80,
      "start": 9293.44,
      "end": 9295.82,
      "formatted_start": "02:34:53.440",
      "formatted_end": "02:34:55.820",
      "text": "اینجایی نقشه رو که خوشم نیمیاد"
    },
    {
      "id": 81,
      "start": 9295.82,
      "end": 9298.34,
      "formatted_start": "02:34:55.820",
      "formatted_end": "02:34:58.340",
      "text": "الان حال ندارم عبادت کنم"
    },
    {
      "id": 82,
      "start": 9298.34,
      "end": 9299.86,
      "formatted_start": "02:34:58.340",
      "formatted_end": "02:34:59.860",
      "text": "عبادت رو قبول ندارم"
    }
  ],
  "status": "completed"
}