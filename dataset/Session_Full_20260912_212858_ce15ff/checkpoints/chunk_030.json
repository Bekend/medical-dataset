  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9003.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:03.000",
      "text": "این خیلی جاداره، خواه، میرین میاد مریم؟"
    },
    {
      "id": 1,
      "start": 9003.0,
      "end": 9006.0,
      "formatted_start": "02:30:03.000",
      "formatted_end": "02:30:06.000",
      "text": "الان پیران سوا میشه میبینیم اون گاری چیه؟"
    },
    {
      "id": 2,
      "start": 9009.0,
      "end": 9011.0,
      "formatted_start": "02:30:09.000",
      "formatted_end": "02:30:11.000",
      "text": "قانون نسمی هست."
    },
    {
      "id": 3,
      "start": 9011.0,
      "end": 9018.0,
      "formatted_start": "02:30:11.000",
      "formatted_end": "02:30:18.000",
      "text": "برحال عرف زمانه اینه دیگه، فردا شاید بیست سی سال دیگه ماشین هایی دار بیاد که رو هوا راه بدنیم."
    },
    {
      "id": 4,
      "start": 9018.0,
      "end": 9021.0,
      "formatted_start": "02:30:18.000",
      "formatted_end": "02:30:21.000",
      "text": "که ما پرباز کنیم، این، بدیم، تمام."
    },
    {
      "id": 5,
      "start": 9021.0,
      "end": 9025.0,
      "formatted_start": "02:30:21.000",
      "formatted_end": "02:30:25.000",
      "text": "دیگه جاده ها منسوخ بشن، دیگه اون خواهد تو جاده ها راه میرم."
    },
    {
      "id": 6,
      "start": 9030.0,
      "end": 9032.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:32.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 7,
      "start": 9032.0,
      "end": 9034.0,
      "formatted_start": "02:30:32.000",
      "formatted_end": "02:30:34.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 8,
      "start": 9034.0,
      "end": 9036.0,
      "formatted_start": "02:30:34.000",
      "formatted_end": "02:30:36.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 9,
      "start": 9036.0,
      "end": 9038.0,
      "formatted_start": "02:30:36.000",
      "formatted_end": "02:30:38.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 10,
      "start": 9038.0,
      "end": 9040.0,
      "formatted_start": "02:30:38.000",
      "formatted_end": "02:30:40.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 11,
      "start": 9040.0,
      "end": 9042.0,
      "formatted_start": "02:30:40.000",
