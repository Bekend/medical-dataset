      "formatted_end": "00:40:54.000",
      "text": "تو خونش اگر بزرگه خطرناکه"
    },
    {
      "id": 13,
      "start": 2454.0,
      "end": 2456.0,
      "formatted_start": "00:40:54.000",
      "formatted_end": "00:40:56.000",
      "text": "باید برداشته بشه"
    },
    {
      "id": 14,
      "start": 2456.0,
      "end": 2462.0,
      "formatted_start": "00:40:56.000",
      "formatted_end": "00:41:02.000",
      "text": "این درم در پیچه داره"
    },
    {
      "id": 15,
      "start": 2462.0,
      "end": 2466.0,
      "formatted_start": "00:41:02.000",
      "formatted_end": "00:41:06.000",
      "text": "در سرور میده می پیچه"
    },
    {
      "id": 16,
      "start": 2466.0,
      "end": 2472.0,
      "formatted_start": "00:41:06.000",
      "formatted_end": "00:41:12.000",
      "text": "خلا تو قله اینجا هم دست میده دلش پیچ میده"
    },
    {
      "id": 17,
      "start": 2472.0,
      "end": 2476.0,
      "formatted_start": "00:41:12.000",
      "formatted_end": "00:41:16.000",
      "text": "تو بغل آروم"
    },
    {
      "id": 18,
      "start": 2476.0,
      "end": 2480.0,
      "formatted_start": "00:41:16.000",
      "formatted_end": "00:41:20.000",
      "text": "اولا خلوم شواد در پیچه هست"
    },
    {
      "id": 19,
      "start": 2480.0,
      "end": 2484.0,
      "formatted_start": "00:41:20.000",
      "formatted_end": "00:41:24.000",
      "text": "آیا ببینی این کلیپه یا گوشت اضافه"
    },
    {
      "id": 20,
      "start": 2484.0,
      "end": 2486.0,
      "formatted_start": "00:41:24.000",
      "formatted_end": "00:41:26.000",
      "text": "این باید برداشته بشه"
    },
    {
      "id": 21,
      "start": 2486.0,
      "end": 2487.0,
      "formatted_start": "00:41:26.000",
      "formatted_end": "00:41:27.000",
      "text": "خب؟"
    },
    {
      "id": 22,
      "start": 2487.0,
      "end": 2490.0,
      "formatted_start": "00:41:27.000",
      "formatted_end": "00:41:30.000",
      "text": "یا اینو باید ببرید جراح برداره"
    },
    {
      "id": 23,
      "start": 2490.0,
      "end": 2491.0,
      "formatted_start": "00:41:30.000",
      "formatted_end": "00:41:31.000",
      "text": "خب؟"
    },
    {
      "id": 24,
      "start": 2491.0,
      "end": 2493.0,
      "formatted_start": "00:41:31.000",
      "formatted_end": "00:41:33.000",
      "text": "یا ما برداریم"
    },
    {
      "id": 25,
      "start": 2493.0,
      "end": 2496.0,
      "formatted_start": "00:41:33.000",
      "formatted_end": "00:41:36.000",
      "text": "جراح ببرید که اصلا صدرت درم داره"
    },
    {
      "id": 26,
      "start": 2496.0,
      "end": 2499.0,
      "formatted_start": "00:41:36.000",
      "formatted_end": "00:41:39.000",
      "text": "اگر ما اینجا خودم رو هم بر می داریم"
    },
    {
      "id": 27,
      "start": 2499.0,
      "end": 2502.0,
      "formatted_start": "00:41:39.000",
      "formatted_end": "00:41:42.000",
      "text": "ما باید برداریم 25 ساله"
    },
    {
      "id": 28,
      "start": 2502.0,
      "end": 2506.0,
      "formatted_start": "00:41:42.000",
      "formatted_end": "00:41:46.000",
      "text": "اگر خواستی باید این برداشته بشه"
    },
    {
      "id": 29,
      "start": 2506.0,
      "end": 2509.0,
      "formatted_start": "00:41:46.000",
      "formatted_end": "00:41:49.000",
      "text": "و اگر نه داروی چیزی جواب نیمی داریم"
    },
    {
      "id": 30,
      "start": 2509.0,
      "end": 2512.06,
      "formatted_start": "00:41:49.000",
      "formatted_end": "00:41:52.060",
      "text": "مثلا ما فهمات میمیسیم دارش حتی دیگه نداره"
    },
    {
      "id": 31,
      "start": 2512.06,
      "end": 2514.14,
      "formatted_start": "00:41:52.060",
      "formatted_end": "00:41:54.140",
      "text": "حتما باید برداریم"
    },
    {
      "id": 32,
      "start": 2514.14,
      "end": 2516.14,
      "formatted_start": "00:41:54.140",
      "formatted_end": "00:41:56.140",
      "text": "چی میدی؟"
    },
    {
      "id": 33,
      "start": 2516.14,
      "end": 2519.14,
      "formatted_start": "00:41:56.140",
      "formatted_end": "00:41:59.140",
      "text": "نه خطر نداره"
    },
    {
      "id": 34,
      "start": 2519.14,
      "end": 2521.14,
      "formatted_start": "00:41:59.140",
      "formatted_end": "00:42:01.140",
      "text": "اون بوگنش خطرناکه"
    },
    {
