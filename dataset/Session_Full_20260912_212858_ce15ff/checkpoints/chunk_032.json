  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9603.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:03.000",
      "text": "این خیلی هم حزینه دادم، خیلی حزینه دادم."
    },
    {
      "id": 1,
      "start": 9603.0,
      "end": 9606.0,
      "formatted_start": "02:40:03.000",
      "formatted_end": "02:40:06.000",
      "text": "انجلی الکی پلکی نبوده، اجیم اجی نبوده."
    },
    {
      "id": 2,
      "start": 9606.0,
      "end": 9614.0,
      "formatted_start": "02:40:06.000",
      "formatted_end": "02:40:14.000",
      "text": "ولی هم خودم کفت می کنم، هم خانوادم، هم فامیلم، هم دوست رفیقم، شب صورت کنم. شب صورت کنم."
    },
    {
      "id": 3,
      "start": 9614.0,
      "end": 9617.0,
      "formatted_start": "02:40:14.000",
      "formatted_end": "02:40:17.000",
      "text": "اینجا هشتتت چند؟"
    },
    {
      "id": 4,
      "start": 9617.0,
      "end": 9619.0,
      "formatted_start": "02:40:17.000",
      "formatted_end": "02:40:19.000",
      "text": "خواب ببینید اون تابلو چنده؟"
    },
    {
      "id": 5,
      "start": 9619.0,
      "end": 9620.0,
      "formatted_start": "02:40:19.000",
      "formatted_end": "02:40:20.000",
      "text": "هشتت."
    },
    {
      "id": 6,
      "start": 9620.0,
      "end": 9621.0,
      "formatted_start": "02:40:20.000",
      "formatted_end": "02:40:21.000",
      "text": "هشتت."
    },
    {
      "id": 7,
      "start": 9621.0,
      "end": 9622.0,
      "formatted_start": "02:40:21.000",
      "formatted_end": "02:40:22.000",
      "text": "حالا تو ست بودی، حالا خوبه."
    },
    {
      "id": 8,
      "start": 9622.0,
      "end": 9623.0,
      "formatted_start": "02:40:22.000",
      "formatted_end": "02:40:23.000",
      "text": "چه ها بود؟"
    },
    {
      "id": 9,
      "start": 9623.0,
      "end": 9628.7,
      "formatted_start": "02:40:23.000",
      "formatted_end": "02:40:28.700",
      "text": "اون چون نزدیک مسکونیه اونو گذاشته که سرعتی دید اینجا بیاری پایی"
    },
    {
      "id": 10,
      "start": 9628.7,
      "end": 9636.9,
      "formatted_start": "02:40:28.700",
      "formatted_end": "02:40:36.900",
      "text": "دیگه ما اول مثلا به جای براکروز میخواستیم توسند بگیریم"
    },
    {
      "id": 11,
      "start": 9636.9,
      "end": 9639.16,
      "formatted_start": "02:40:36.900",
      "formatted_end": "02:40:39.160",
      "text": "مصطفى داشت"
    },
    {
      "id": 12,
      "start": 9639.16,
      "end": 9641.9,
      "formatted_start": "02:40:39.160",
      "formatted_end": "02:40:41.900",
      "text": "کچک کچکه دیگه"
    },
    {
      "id": 13,
      "start": 9641.9,
      "end": 9643.98,
      "formatted_start": "02:40:41.900",
      "formatted_end": "02:40:43.980",
      "text": "یادید میاد مریم میگفتیم توسند"
    },
    {
      "id": 14,
      "start": 9643.98,
      "end": 9646.66,
      "formatted_start": "02:40:43.980",
      "formatted_end": "02:40:46.660",
      "text": "من گفتم برکن با یه دانه براکروز"
    },
    {
      "id": 15,
      "start": 9646.66,
      "end": 9650.5,
      "formatted_start": "02:40:46.660",
      "formatted_end": "02:40:50.500",
      "text": "واقعا براکروز از دوازده سیزده ساله"
    },
    {
      "id": 16,
      "start": 9650.5,
      "end": 9654.5,
      "formatted_start": "02:40:50.500",
      "formatted_end": "02:40:54.500",
      "text": "هنوز میشینی یه عیبتی داره لعنتی"
    },
    {
      "id": 17,
      "start": 9654.5,
      "end": 9658.5,
      "formatted_start": "02:40:54.500",
      "formatted_end": "02:40:58.500",
      "text": "یعنی بروز هنوز ماشین"
    },
    {
      "id": 18,
      "start": 9658.5,
      "end": 9660.5,
      "formatted_start": "02:40:58.500",
      "formatted_end": "02:41:00.500",
      "text": "اصلا خود ایمنیش"
    },
    {
      "id": 19,
      "start": 9660.5,
      "end": 9662.5,
      "formatted_start": "02:41:00.500",
      "formatted_end": "02:41:02.500",
      "text": "ایمنیش، آره"
    },
    {
      "id": 20,
      "start": 9670.5,
      "end": 9673.5,
      "formatted_start": "02:41:10.500",
      "formatted_end": "02:41:13.500",
      "text": "یه کارو خوب و خوب باید انجام بدی"
    },
    {
      "id": 21,
      "start": 9673.5,
      "end": 9675.5,
      "formatted_start": "02:41:13.500",
      "formatted_end": "02:41:15.500",
      "text": "آیه قرآنه"
    },
    {
      "id": 22,
      "start": 9675.5,
      "end": 9678.5,
      "formatted_start": "02:41:15.500",
      "formatted_end": "02:41:18.500",
      "text": "یه کارو خوب و خوب انجام بده"
    },
    {
      "id": 23,
      "start": 9678.5,
      "end": 9682.32,
      "formatted_start": "02:41:18.500",
      "formatted_end": "02:41:22.320",
      "text": "شما هر کاری انجام بدید سایی کنید خوب انجام بدید"
    },
    {
      "id": 24,
      "start": 9682.32,
      "end": 9684.32,
      "formatted_start": "02:41:22.320",
      "formatted_end": "02:41:24.320",
      "text": "این خوب انجام دادن هزینه داره"
    },
    {
      "id": 25,
      "start": 9699.32,
      "end": 9702.32,
      "formatted_start": "02:41:39.320",
      "formatted_end": "02:41:42.320",
      "text": "اون ریست های دمده رو با جی یه رنگ بزنم"
    },
    {
      "id": 26,
      "start": 9702.32,
      "end": 9704.32,
      "formatted_start": "02:41:42.320",
      "formatted_end": "02:41:44.320",
      "text": "کدام؟ رزید؟"
    },
    {
      "id": 27,
      "start": 9704.32,
      "end": 9706.32,
      "formatted_start": "02:41:44.320",
      "formatted_end": "02:41:46.320",
      "text": "شب یه ریست دیگه گرفتم"
    },
    {
      "id": 28,
      "start": 9706.32,
      "end": 9709.56,
      "formatted_start": "02:41:46.320",
      "formatted_end": "02:41:49.560",
      "text": "منو از این چشمک زن هاستن که فلاچره"
    },
    {
      "id": 29,
      "start": 9709.56,
      "end": 9711.08,
      "formatted_start": "02:41:49.560",
      "formatted_end": "02:41:51.080",
      "text": "خب مدل های مختلف"
    },
    {
      "id": 30,
      "start": 9711.08,
      "end": 9712.32,
      "formatted_start": "02:41:51.080",
      "formatted_end": "02:41:52.320",
      "text": "نهو متره"
    },
    {
      "id": 31,
      "start": 9712.32,
      "end": 9713.96,
      "formatted_start": "02:41:52.320",
      "formatted_end": "02:41:53.960",
      "text": "دویست پنجه ها تو هم بود"
    },
    {
      "id": 32,
      "start": 9713.96,
      "end": 9718.52,
      "formatted_start": "02:41:53.960",
      "formatted_end": "02:41:58.520",
      "text": "برای رزی یا برای کومیا نمیشه اون پارکینگ"
    },
    {
      "id": 33,
      "start": 9718.52,
      "end": 9721.88,
      "formatted_start": "02:41:58.520",
      "formatted_end": "02:42:01.880",
      "text": "که را شب؟"
    },
    {
      "id": 34,
      "start": 9721.88,
      "end": 9722.72,
      "formatted_start": "02:42:01.880",
      "formatted_end": "02:42:02.720",
      "text": "یه رنگ میشه؟"
    },
    {
      "id": 35,
      "start": 9722.72,
      "end": 9723.72,
      "formatted_start": "02:42:02.720",
      "formatted_end": "02:42:03.720",
      "text": "برنگ نزدیک"
    },
    {
      "id": 36,
      "start": 9723.72,
      "end": 9725.32,
      "formatted_start": "02:42:03.720",
      "formatted_end": "02:42:05.320",
      "text": "چی میشه دارن؟"
    },
    {
      "id": 37,
      "start": 9725.32,
      "end": 9726.56,
      "formatted_start": "02:42:05.320",
      "formatted_end": "02:42:06.560",
      "text": "کالب نمیشه"
    },
    {
      "id": 38,
      "start": 9726.56,
      "end": 9729.16,
      "formatted_start": "02:42:06.560",
      "formatted_end": "02:42:09.160",
      "text": "کالب نیمیشه"
    },
    {
      "id": 39,
      "start": 9729.16,
      "end": 9731.16,
      "formatted_start": "02:42:09.160",
      "formatted_end": "02:42:11.160",
      "text": "یه بوخ بزن"
    },
    {
      "id": 40,
      "start": 9731.16,
      "end": 9732.24,
      "formatted_start": "02:42:11.160",
      "formatted_end": "02:42:12.240",
      "text": "این یارا مثلا ببین"
    },
    {
      "id": 41,
      "start": 9732.24,
      "end": 9734.32,
      "formatted_start": "02:42:12.240",
      "formatted_end": "02:42:14.320",
      "text": "بشتار میخواد بیدی یه بوخ بزن برو"
    },
    {
      "id": 42,
      "start": 9734.32,
      "end": 9746.32,
      "formatted_start": "02:42:14.320",
      "formatted_end": "02:42:26.320",
      "text": "موسیقی"
    },
    {
      "id": 43,
      "start": 9764.32,
      "end": 9765.32,
      "formatted_start": "02:42:44.320",
      "formatted_end": "02:42:45.320",
      "text": "خیلی خوبی هم بود"
    },
    {
      "id": 44,
      "start": 9765.32,
      "end": 9766.46,
      "formatted_start": "02:42:45.320",
      "formatted_end": "02:42:46.460",
      "text": "خوب"
    },
    {
      "id": 45,
      "start": 9766.46,
      "end": 9768.18,
      "formatted_start": "02:42:46.460",
      "formatted_end": "02:42:48.180",
      "text": "بعد"
    },
    {
      "id": 46,
      "start": 9768.18,
      "end": 9770.56,
      "formatted_start": "02:42:48.180",
      "formatted_end": "02:42:50.560",
      "text": "این بنده خدا"
    },
    {
      "id": 47,
      "start": 9770.56,
      "end": 9772.88,
      "formatted_start": "02:42:50.560",
      "formatted_end": "02:42:52.880",
      "text": "صحبت که می کرد همه هم سرسدا می کردن"
    },
    {
      "id": 48,
      "start": 9772.88,
      "end": 9774.16,
      "formatted_start": "02:42:52.880",
      "formatted_end": "02:42:54.160",
      "text": "از اینکه گوش نمی کرد"
    },
    {
      "id": 49,
      "start": 9774.16,
      "end": 9776.6,
      "formatted_start": "02:42:54.160",
      "formatted_end": "02:42:56.600",
      "text": "بعد از اونکه"
    },
    {
      "id": 50,
      "start": 9776.6,
      "end": 9777.44,
      "formatted_start": "02:42:56.600",
      "formatted_end": "02:42:57.440",
      "text": "تمام شد"
    },
    {
      "id": 51,
      "start": 9777.44,
      "end": 9780.66,
      "formatted_start": "02:42:57.440",
      "formatted_end": "02:43:00.660",
      "text": "من اون وقت هم صحبت کردم خوب"
    },
    {
      "id": 52,
      "start": 9780.66,
      "end": 9782.64,
      "formatted_start": "02:43:00.660",
      "formatted_end": "02:43:02.640",
      "text": "بعد همه"
    },
    {
      "id": 53,
      "start": 9782.64,
      "end": 9784.32,
      "formatted_start": "02:43:02.640",
      "formatted_end": "02:43:04.320",
      "text": "ساکت یعنی اینقدر سکوت بود"
    },
    {
      "id": 54,
      "start": 9784.32,
      "end": 9786.56,
      "formatted_start": "02:43:04.320",
      "formatted_end": "02:43:06.560",
      "text": "که اتون خدم هایی که پذیرایی نمی کنن"
    },
    {
      "id": 55,
      "start": 9786.56,
      "end": 9788.56,
      "formatted_start": "02:43:06.560",
      "formatted_end": "02:43:08.560",
      "text": "اونا با استادی بودن داشتن گوش می کردن"
    },
    {
      "id": 56,
      "start": 9788.56,
      "end": 9790.26,
      "formatted_start": "02:43:08.560",
      "formatted_end": "02:43:10.260",
      "text": "در این موابع"
    },
    {
      "id": 57,
      "start": 9790.26,
      "end": 9791.92,
      "formatted_start": "02:43:10.260",
      "formatted_end": "02:43:11.920",
      "text": "دو تا افراد شرور"
    },
    {
      "id": 58,
      "start": 9791.92,
      "end": 9793.92,
      "formatted_start": "02:43:11.920",
      "formatted_end": "02:43:13.920",
      "text": "نمیدونم این هایی در اینجا"
    },
    {
      "id": 59,
      "start": 9793.92,
      "end": 9795.92,
      "formatted_start": "02:43:13.920",
      "formatted_end": "02:43:15.920",
      "text": "به نام الهام و نهام"
    },
    {
      "id": 60,
      "start": 9795.92,
      "end": 9797.92,
      "formatted_start": "02:43:15.920",
      "formatted_end": "02:43:17.920",
      "text": "آره"
    },
    {
      "id": 61,
      "start": 9797.92,
      "end": 9801.92,
      "formatted_start": "02:43:17.920",
      "formatted_end": "02:43:21.920",
      "text": "اینا شروع به اخلالگری کردن"
    },
    {
      "id": 62,
      "start": 9801.92,
      "end": 9803.92,
      "formatted_start": "02:43:21.920",
      "formatted_end": "02:43:23.920",
      "text": "و"
    },
    {
      "id": 63,
      "start": 9803.92,
      "end": 9805.92,
      "formatted_start": "02:43:23.920",
      "formatted_end": "02:43:25.920",
      "text": "بنام و جیبا بنام"
    },
    {
      "id": 64,
      "start": 9805.92,
      "end": 9807.92,
      "formatted_start": "02:43:25.920",
      "formatted_end": "02:43:27.920",
      "text": "حالا ام تیبی بگه اونا مغصر نیستن"
    },
    {
      "id": 65,
      "start": 9807.92,
      "end": 9809.92,
      "formatted_start": "02:43:27.920",
      "formatted_end": "02:43:29.920",
      "text": "اول که میخوه بچه ها هم نبودن"
    },
    {
      "id": 66,
      "start": 9809.92,
      "end": 9811.92,
      "formatted_start": "02:43:29.920",
      "formatted_end": "02:43:31.920",
      "text": "زهره خاله بود و این بود و"
    },
    {
      "id": 67,
      "start": 9811.92,
      "end": 9813.92,
      "formatted_start": "02:43:31.920",
      "formatted_end": "02:43:33.920",
      "text": "تو پنداخت به زمین اونا"
    },
    {
      "id": 68,
      "start": 9813.92,
      "end": 9815.92,
      "formatted_start": "02:43:33.920",
      "formatted_end": "02:43:35.920",
      "text": "و آدم از خواهد زشته"
    },
    {
      "id": 69,
      "start": 9815.92,
      "end": 9817.92,
      "formatted_start": "02:43:35.920",
      "formatted_end": "02:43:37.920",
      "text": "اصلا شما ببینه همه ساکتن"
    },
    {
      "id": 70,
      "start": 9817.92,
      "end": 9819.92,
      "formatted_start": "02:43:37.920",
      "formatted_end": "02:43:39.920",
      "text": "واقعا یه سکوت مغزی هست"
    },
    {
      "id": 71,
      "start": 9819.92,
      "end": 9823.92,
      "formatted_start": "02:43:39.920",
      "formatted_end": "02:43:43.920",
      "text": "از شما بلند بلند دارید سر صدا میکنید"
    },
    {
      "id": 72,
      "start": 9823.92,
      "end": 9826.92,
      "formatted_start": "02:43:43.920",
      "formatted_end": "02:43:46.920",
      "text": "اونم بسا داییتون داره حرف میزنه"
    },
    {
      "id": 73,
      "start": 9826.92,
      "end": 9829.92,
      "formatted_start": "02:43:46.920",
      "formatted_end": "02:43:49.920",
      "text": "نکنید این کارها رو"
    },
    {
      "id": 74,
      "start": 9829.92,
      "end": 9832.92,
      "formatted_start": "02:43:49.920",
      "formatted_end": "02:43:52.920",
      "text": "بعد گفته مسوم اینا رو تحریک کرده"
    },
    {
      "id": 75,
      "start": 9832.92,
      "end": 9834.92,
      "formatted_start": "02:43:52.920",
      "formatted_end": "02:43:54.920",
      "text": "حالا مسوم هم گفتن اونجا نیست"
    },
    {
      "id": 76,
      "start": 9834.92,
      "end": 9836.92,
      "formatted_start": "02:43:54.920",
      "formatted_end": "02:43:56.920",
      "text": "مثلا هرکی دیگه ای باشه"
    },
    {
      "id": 77,
      "start": 9836.92,
      "end": 9837.92,
      "formatted_start": "02:43:56.920",
      "formatted_end": "02:43:57.920",
      "text": "نبود؟"
    },
    {
      "id": 78,
      "start": 9837.92,
      "end": 9839.92,
      "formatted_start": "02:43:57.920",
      "formatted_end": "02:43:59.920",
      "text": "مسوم کیه نه؟ کدوم مسوم میگه؟"
    },
    {
      "id": 79,
      "start": 9839.92,
      "end": 9841.92,
      "formatted_start": "02:43:59.920",
      "formatted_end": "02:44:01.920",
      "text": "مسوم امتحاره"
    },
    {
      "id": 80,
      "start": 9841.92,
      "end": 9844.92,
      "formatted_start": "02:44:01.920",
      "formatted_end": "02:44:04.920",
      "text": "مسوم امتحاره اصلا اونجا نبودم شروع نشونت بودم نگه"
    },
    {
      "id": 81,
      "start": 9844.92,
      "end": 9846.92,
      "formatted_start": "02:44:04.920",
      "formatted_end": "02:44:06.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 82,
      "start": 9846.92,
      "end": 9848.92,
      "formatted_start": "02:44:06.920",
      "formatted_end": "02:44:08.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 83,
      "start": 9848.92,
      "end": 9850.92,
      "formatted_start": "02:44:08.920",
      "formatted_end": "02:44:10.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 84,
      "start": 9850.92,
      "end": 9852.92,
      "formatted_start": "02:44:10.920",
      "formatted_end": "02:44:12.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 85,
      "start": 9852.92,
      "end": 9854.92,
      "formatted_start": "02:44:12.920",
      "formatted_end": "02:44:14.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 86,
      "start": 9854.92,
      "end": 9856.92,
      "formatted_start": "02:44:14.920",
      "formatted_end": "02:44:16.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 87,
      "start": 9856.92,
      "end": 9858.92,
      "formatted_start": "02:44:16.920",
      "formatted_end": "02:44:18.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 88,
      "start": 9858.92,
      "end": 9860.92,
      "formatted_start": "02:44:18.920",
      "formatted_end": "02:44:20.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 89,
      "start": 9860.92,
      "end": 9862.92,
      "formatted_start": "02:44:20.920",
      "formatted_end": "02:44:22.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 90,
      "start": 9862.92,
      "end": 9864.92,
      "formatted_start": "02:44:22.920",
      "formatted_end": "02:44:24.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 91,
      "start": 9864.92,
      "end": 9866.92,
      "formatted_start": "02:44:24.920",
      "formatted_end": "02:44:26.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 92,
      "start": 9866.92,
      "end": 9868.92,
      "formatted_start": "02:44:26.920",
      "formatted_end": "02:44:28.920",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 93,
      "start": 9868.92,
      "end": 9873.56,
      "formatted_start": "02:44:28.920",
      "formatted_end": "02:44:33.560",
      "text": "از کارواش ماشین رو برده ویدیو کارواش باید داشتیم بر میگشیم به ماشین من"
    },
    {
      "id": 94,
      "start": 9873.56,
      "end": 9880.8,
