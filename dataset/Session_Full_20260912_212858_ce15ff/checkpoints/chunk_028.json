      "start": 8621.02,
      "end": 8624.98,
      "formatted_start": "02:23:41.020",
      "formatted_end": "02:23:44.980",
      "text": "چیجی ترموز میزنه خودش"
    },
    {
      "id": 83,
      "start": 8624.98,
      "end": 8626.7,
      "formatted_start": "02:23:44.980",
      "formatted_end": "02:23:46.700",
      "text": "ترموز میزنه؟ آه نه نگذارم"
    },
    {
      "id": 84,
      "start": 8626.7,
      "end": 8627.88,
      "formatted_start": "02:23:46.700",
      "formatted_end": "02:23:47.880",
      "text": "این طرماز بدی میزنی"
    },
    {
      "id": 85,
      "start": 8627.88,
      "end": 8629.28,
      "formatted_start": "02:23:47.880",
      "formatted_end": "02:23:49.280",
      "text": "کجا؟ کجا میزنی؟"
    },
    {
      "id": 86,
      "start": 8629.28,
      "end": 8630.52,
      "formatted_start": "02:23:49.280",
      "formatted_end": "02:23:50.520",
      "text": "تو فلکتار کلنا"
    },
    {
      "id": 87,
      "start": 8630.52,
      "end": 8632.14,
      "formatted_start": "02:23:50.520",
      "formatted_end": "02:23:52.140",
      "text": "اون سرش آف اومد به پیچه"
    },
    {
      "id": 88,
      "start": 8632.14,
      "end": 8633.66,
      "formatted_start": "02:23:52.140",
      "formatted_end": "02:23:53.660",
      "text": "خب این خیلی نزدیک شده"
    },
    {
      "id": 89,
      "start": 8633.66,
      "end": 8634.66,
      "formatted_start": "02:23:53.660",
      "formatted_end": "02:23:54.660",
      "text": "اصلا گرف میکنه"
    },
    {
      "id": 90,
      "start": 8634.66,
      "end": 8635.44,
      "formatted_start": "02:23:54.660",
      "formatted_end": "02:23:55.440",
      "text": "آره دیگه هم باقی"
    },
    {
      "id": 91,
      "start": 8635.44,
      "end": 8636.84,
      "formatted_start": "02:23:55.440",
      "formatted_end": "02:23:56.840",
      "text": "خب خیلی بدرندی کرده"
    },
    {
      "id": 92,
      "start": 8636.84,
      "end": 8638.94,
      "formatted_start": "02:23:56.840",
      "formatted_end": "02:23:58.940",
      "text": "نه بابا اصلا سرعت کم بود"
    },
    {
      "id": 93,
      "start": 8638.94,
      "end": 8640.36,
      "formatted_start": "02:23:58.940",
      "formatted_end": "02:24:00.360",
      "text": "اصلا طرماز بودن"
    },
    {
      "id": 94,
      "start": 8640.36,
      "end": 8642.44,
      "formatted_start": "02:24:00.360",
      "formatted_end": "02:24:02.440",
      "text": "وایسته بودن به یک گفل چیز کردی"
    },
    {
      "id": 95,
      "start": 8642.44,
      "end": 8643.74,
      "formatted_start": "02:24:02.440",
      "formatted_end": "02:24:03.740",
      "text": "این که اومده جلو"
    },
    {
      "id": 96,
      "start": 8643.74,
      "end": 8646.48,
      "formatted_start": "02:24:03.740",
      "formatted_end": "02:24:06.480",
      "text": "این دیگه یه ماشین جلوی از عرض رد شد"
    },
    {
      "id": 97,
      "start": 8646.48,
      "end": 8648.68,
      "formatted_start": "02:24:06.480",
      "formatted_end": "02:24:08.680",
      "text": "بله اون خیلی نزدیک بودی"
    },
    {
      "id": 98,
      "start": 8648.68,
      "end": 8650.68,
      "formatted_start": "02:24:08.680",
      "formatted_end": "02:24:10.680",
      "text": "من دو بار اینجوری شده"
    },
    {
      "id": 99,
      "start": 8650.68,
      "end": 8653.4,
      "formatted_start": "02:24:10.680",
      "formatted_end": "02:24:13.400",
      "text": "ولی ببین باید فاصله را آیت کنیم"
    },
    {
      "id": 100,
      "start": 8653.4,
      "end": 8655.4,
      "formatted_start": "02:24:13.400",
      "formatted_end": "02:24:15.400",
      "text": "مگرنی که این نفر کل خریب یاد وزد"
    },
    {
      "id": 101,
      "start": 8656.52,
      "end": 8658.52,
      "formatted_start": "02:24:16.520",
      "formatted_end": "02:24:18.520",
      "text": "نه فاصله زیاد هم نبوده"
    },
    {
      "id": 102,
      "start": 8658.52,
      "end": 8662.32,
      "formatted_start": "02:24:18.520",
      "formatted_end": "02:24:22.320",
      "text": "اقا من یه ماه این ماشین دارم سوارم اینجوری نیست"
    },
    {
      "id": 103,
      "start": 8663.76,
      "end": 8665.76,
      "formatted_start": "02:24:23.760",
      "formatted_end": "02:24:25.760",
      "text": "تا اینان خیلی نجیب بشیم ماشین گرفت میکنه"
    },
    {
      "id": 104,
      "start": 8665.76,
      "end": 8667.76,
      "formatted_start": "02:24:25.760",
      "formatted_end": "02:24:27.760",
      "text": "بلک میزنه"
    },
    {
      "id": 105,
      "start": 8667.76,
      "end": 8669.76,
      "formatted_start": "02:24:27.760",
      "formatted_end": "02:24:29.760",
      "text": "بعد آراندیه کردیم"
    },
    {
      "id": 106,
      "start": 8669.76,
      "end": 8671.76,
      "formatted_start": "02:24:29.760",
      "formatted_end": "02:24:31.760",
      "text": "یا یکی بعد اومده ببین دو حالت بود"
    },
    {
      "id": 107,
      "start": 8671.76,
      "end": 8673.76,
      "formatted_start": "02:24:31.760",
      "formatted_end": "02:24:33.760",
      "text": "نه اصلا فاصله زیاد بوده همون"
    },
    {
      "id": 108,
      "start": 8673.76,
      "end": 8675.76,
      "formatted_start": "02:24:33.760",
      "formatted_end": "02:24:35.760",
      "text": "نه باید اینجوری بشیم"
    },
    {
      "id": 109,
      "start": 8675.76,
      "end": 8679.76,
      "formatted_start": "02:24:35.760",
      "formatted_end": "02:24:39.760",
      "text": "بار اول آره خیلی نزدیک بودم"
    },
    {
      "id": 110,
      "start": 8679.76,
      "end": 8681.76,
      "formatted_start": "02:24:39.760",
      "formatted_end": "02:24:41.760",
      "text": "این ماشین به اون فاصله زیاده به نظرم"
    },
    {
      "id": 111,
      "start": 8681.76,
      "end": 8684.76,
      "formatted_start": "02:24:41.760",
      "formatted_end": "02:24:44.760",
      "text": "یعنی این ماشین اقلا دومت فاصله داشت به نظرم هنوز"
    },
    {
      "id": 112,
      "start": 8684.76,
      "end": 8687.76,
      "formatted_start": "02:24:44.760",
      "formatted_end": "02:24:47.760",
      "text": "برای هم نباید، این ماشین هر روز سوال میشه نشده طلب"
    },
    {
      "id": 113,
      "start": 8687.76,
      "end": 8689.76,
      "formatted_start": "02:24:47.760",
      "formatted_end": "02:24:49.760",
      "text": "احساسیتش زیاده به نظرم"
    },
    {
      "id": 114,
      "start": 8689.76,
      "end": 8692.76,
      "formatted_start": "02:24:49.760",
      "formatted_end": "02:24:52.760",
      "text": "نه، قبول ندارم"
    },
    {
      "id": 115,
      "start": 8692.76,
      "end": 8695.76,
      "formatted_start": "02:24:52.760",
      "formatted_end": "02:24:55.760",
      "text": "مگه اینکه تازه اتفاق افتاده باشه ببین"
    },
    {
      "id": 116,
      "start": 8695.76,
      "end": 8697.76,
      "formatted_start": "02:24:55.760",
      "formatted_end": "02:24:57.760",
      "text": "تو من نشستم، نه سرعت زیاد بود نه"
    },
    {
      "id": 117,
      "start": 8697.76,
      "end": 8699.76,
      "formatted_start": "02:24:57.760",
      "formatted_end": "02:24:59.760",
      "text": "الان باید قرش بگیرم"
    }
  ],
  "status": "completed"
}