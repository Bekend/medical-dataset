      "end": 8480.28,
      "formatted_start": "02:21:18.600",
      "formatted_end": "02:21:20.280",
      "text": "نه، ببین اونا دیگیست انا"
    },
    {
      "id": 37,
      "start": 8480.28,
      "end": 8482.28,
      "formatted_start": "02:21:20.280",
      "formatted_end": "02:21:22.280",
      "text": "این هست دیم نماز"
    },
    {
      "id": 38,
      "start": 8482.28,
      "end": 8484.28,
      "formatted_start": "02:21:22.280",
      "formatted_end": "02:21:24.280",
      "text": "این هست دیم نماز"
    },
