      "id": 73,
      "start": 8568.28,
      "end": 8598.28,
      "formatted_start": "02:22:48.280",
      "formatted_end": "02:23:18.280",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 74,
      "start": 8598.28,
      "end": 8604.28,
      "formatted_start": "02:23:18.280",
      "formatted_end": "02:23:24.280",
      "text": "جهت ها دیگه خیلی مثلا یه بچه پنج ساله ده ساله که نیست که من بگم این جهت اینوره"
    },
    {
      "id": 75,
      "start": 8604.28,
      "end": 8610.1,
      "formatted_start": "02:23:24.280",
      "formatted_end": "02:23:30.100",
      "text": "اینا چون توجه نمی کنن دقیق ندارن مثلا گوشی رو میگنن هیت فونو میزنن"
    },
    {
      "id": 76,
      "start": 8610.1,
      "end": 8612.94,
      "formatted_start": "02:23:30.100",
      "formatted_end": "02:23:32.940",
      "text": "اصلا برایشون مهم نیست شب اجر نمیدونیم"
    },
    {
      "id": 77,
      "start": 8612.94,
      "end": 8615.82,
      "formatted_start": "02:23:32.940",
      "formatted_end": "02:23:35.820",
      "text": "مجید در یه جسم برک هست"
    },
