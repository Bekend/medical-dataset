      "start": 8508.28,
      "end": 8510.28,
      "formatted_start": "02:21:48.280",
      "formatted_end": "02:21:50.280",
      "text": "بشیم پشترمون"
    },
    {
      "id": 46,
      "start": 8510.28,
      "end": 8512.28,
      "formatted_start": "02:21:50.280",
      "formatted_end": "02:21:52.280",
      "text": "بشیم بشیم نه"
    },
    {
      "id": 47,
      "start": 8512.28,
      "end": 8514.28,
      "formatted_start": "02:21:52.280",
      "formatted_end": "02:21:54.280",
      "text": "بگیرم باید بشم"
    },
    {
      "id": 48,
      "start": 8514.28,
      "end": 8516.28,
      "formatted_start": "02:21:54.280",
      "formatted_end": "02:21:56.280",
      "text": "بگیرم بشم"
    },
    {
      "id": 49,
      "start": 8516.28,
      "end": 8518.28,
      "formatted_start": "02:21:56.280",
      "formatted_end": "02:21:58.280",
      "text": "بگیرم بشم"
    },
    {
