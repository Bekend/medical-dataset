      "formatted_end": "02:20:10.000",
      "text": "اینجا نماز نخونید، عبادت نخونید، عبادت اینجا که شما آدم ها اونه هم باشد."
    },
    {
      "id": 1,
      "start": 8410.0,
      "end": 8412.0,
      "formatted_start": "02:20:10.000",
      "formatted_end": "02:20:12.000",
      "text": "نه، خواهی داریم."
    },
    {
      "id": 2,
      "start": 8412.0,
      "end": 8414.0,
      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:14.000",
      "text": "نه، خواهی داریم."
    },
    {
      "id": 3,
      "start": 8414.0,
      "end": 8416.0,
      "formatted_start": "02:20:14.000",
      "formatted_end": "02:20:16.000",
      "text": "نه، خواهی داریم."
    },
    {
      "id": 4,
      "start": 8416.0,
      "end": 8418.0,
      "formatted_start": "02:20:16.000",
      "formatted_end": "02:20:18.000",
      "text": "نه، خواهی داریم."
    },
    {
      "id": 5,
      "start": 8418.0,
      "end": 8420.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:20.000",
      "text": "نه، خواهی داریم."
    },
    {
      "id": 6,
      "start": 8420.0,
      "end": 8422.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:22.000",
      "text": "خدا را قبول دارم، این روزها قبول ندارم."
    },
    {
      "id": 7,
      "start": 8422.0,
      "end": 8424.0,
      "formatted_start": "02:20:22.000",
      "formatted_end": "02:20:24.000",
      "text": "اگر خدا را قبول داره، خدا میده."
    },
    {
      "id": 8,
      "start": 8424.0,
      "end": 8426.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:26.000",
      "text": "خدا میده."
    },
    {
      "id": 9,
      "start": 8426.0,
      "end": 8428.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:28.000",
      "text": "باید اون را قبول ندارم، همچنین دلم رو خواهی دارم."
    },
    {
      "id": 10,
      "start": 8428.0,
      "end": 8431.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:31.000",
      "text": "نماد روزه سخته قبول نداره"
    },
    {
      "id": 11,
      "start": 8434.0,
      "end": 8436.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:36.000",
      "text": "این یزی میده یا؟"
    },
    {
      "id": 12,
      "start": 8437.0,
      "end": 8439.0,
      "formatted_start": "02:20:37.000",
      "formatted_end": "02:20:39.000",
      "text": "این زمانه چیز یزی میده؟"
    },
    {
      "id": 13,
      "start": 8440.0,
      "end": 8442.0,
      "formatted_start": "02:20:40.000",
      "formatted_end": "02:20:42.000",
      "text": "درگاه ما حالا طرف داره یزی رو ببینیم"
    },
    {
      "id": 14,
      "start": 8443.0,
      "end": 8444.0,
      "formatted_start": "02:20:43.000",
      "formatted_end": "02:20:44.000",
      "text": "نه برای کسی اینو خوب نفردی"
    },
    {
      "id": 15,
      "start": 8445.0,
      "end": 8446.0,
      "formatted_start": "02:20:45.000",
      "formatted_end": "02:20:46.000",
      "text": "ببینید حق داری آره"
    },
    {
      "id": 16,
      "start": 8447.0,
      "end": 8449.0,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:49.000",
      "text": "اون چیزی که اینا گفتن جونه خلاکیت نداره"
    },
    {
      "id": 17,
      "start": 8450.0,
      "end": 8451.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:51.000",
      "text": "چیز مراقبه داره؟"
    },
    {
      "id": 18,
      "start": 8452.0,
      "end": 8454.0,
      "formatted_start": "02:20:52.000",
      "formatted_end": "02:20:54.000",
      "text": "چیز واقعی رو به مردم نداره"
    },
    {
      "id": 19,
      "start": 8455.0,
      "end": 8456.0,
      "formatted_start": "02:20:55.000",
      "formatted_end": "02:20:56.000",
      "text": "آشقه چیزی باشن"
    },
    {
      "id": 20,
      "start": 8456.0,
      "end": 8457.28,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:20:57.280",
      "text": "اگر نماز..."
    },
    {
      "id": 21,
      "start": 8457.28,
      "end": 8458.28,
      "formatted_start": "02:20:57.280",
      "formatted_end": "02:20:58.280",
      "text": "خلافت کنید"
    },
    {
      "id": 22,
      "start": 8459.0,
      "end": 8461.76,
      "formatted_start": "02:20:59.000",
      "formatted_end": "02:21:01.760",
      "text": "نفتالات همیه علی پشاوه ممکن"
    },
    {
      "id": 23,
      "start": 8461.76,
      "end": 8463.88,
      "formatted_start": "02:21:01.760",
      "formatted_end": "02:21:03.880",
      "text": "نماز کنه از پشاوه ممکن"
    },
    {
      "id": 24,
      "start": 8463.88,
      "end": 8466.76,
      "formatted_start": "02:21:03.880",
      "formatted_end": "02:21:06.760",
      "text": "اگر نماز کنید، اون حرکتی میکنه"
    },
    {
      "id": 25,
      "start": 8466.76,
      "end": 8468.2,
      "formatted_start": "02:21:06.760",
      "formatted_end": "02:21:08.200",
      "text": "اون نماز واقعی نیست"
    },
    {
      "id": 26,
      "start": 8468.2,
      "end": 8469.76,
      "formatted_start": "02:21:08.200",
      "formatted_end": "02:21:09.760",
      "text": "چون من دیدم با جایی خوانه"
    },
    {
      "id": 27,
      "start": 8469.76,
      "end": 8470.52,
      "formatted_start": "02:21:09.760",
      "formatted_end": "02:21:10.520",
      "text": "نه، نه، اونها که..."
    },
    {
      "id": 28,
      "start": 8470.52,
      "end": 8471.0,
      "formatted_start": "02:21:10.520",
      "formatted_end": "02:21:11.000",
      "text": "مدعی؟"
    },
    {
      "id": 29,
      "start": 8471.0,
      "end": 8471.88,
      "formatted_start": "02:21:11.000",
      "formatted_end": "02:21:11.880",
      "text": "نماز واقعی نیست"
    },
    {
      "id": 30,
      "start": 8471.88,
      "end": 8472.4,
      "formatted_start": "02:21:11.880",
      "formatted_end": "02:21:12.400",
      "text": "آجی؟"
    },
    {
      "id": 31,
      "start": 8472.4,
      "end": 8473.16,
      "formatted_start": "02:21:12.400",
      "formatted_end": "02:21:13.160",
      "text": "منم دیدم"
    },
    {
      "id": 32,
      "start": 8473.16,
      "end": 8474.68,
      "formatted_start": "02:21:13.160",
      "formatted_end": "02:21:14.680",
      "text": "من طرف آشق"
    },
    {
