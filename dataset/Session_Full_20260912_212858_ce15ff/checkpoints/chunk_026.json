      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 7830.0,
      "end": 7859.98,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 7860.0,
      "end": 7888.0,
      "formatted_start": "02:11:00.000",
      "formatted_end": "02:11:28.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 7888.0,
      "end": 7892.0,
      "formatted_start": "02:11:28.000",
      "formatted_end": "02:11:32.000",
      "text": "خانسم این دستگاه رو بردم"
    },
    {
      "id": 4,
      "start": 7895.0,
      "end": 7898.0,
      "formatted_start": "02:11:35.000",
      "formatted_end": "02:11:38.000",
      "text": "این چشمی شد؟ این خانمی که اول اومد"
    },
    {
      "id": 5,
      "start": 7899.0,
      "end": 7901.0,
      "formatted_start": "02:11:39.000",
      "formatted_end": "02:11:41.000",
      "text": "اون حساب کرد"
    },
    {
      "id": 6,
      "start": 7904.0,
      "end": 7906.0,
      "formatted_start": "02:11:44.000",
      "formatted_end": "02:11:46.000",
      "text": "پیشت دکتر چوگان زنگ داده بود"
    },
    {
      "id": 7,
      "start": 7907.0,
      "end": 7909.0,
      "formatted_start": "02:11:47.000",
      "formatted_end": "02:11:49.000",
      "text": "چقدر مینادی؟"
    },
    {
      "id": 8,
      "start": 7909.0,
      "end": 7914.0,
      "formatted_start": "02:11:49.000",
      "formatted_end": "02:11:54.000",
      "text": "میگفت اصلا مریض نیست و خیلی وحشتناکه"
    },
    {
      "id": 9,
      "start": 7914.0,
      "end": 7916.0,
      "formatted_start": "02:11:54.000",
      "formatted_end": "02:11:56.000",
      "text": "مختلف"
    },
    {
      "id": 10,
      "start": 7916.0,
      "end": 7918.0,
      "formatted_start": "02:11:56.000",
      "formatted_end": "02:11:58.000",
      "text": "مختلف، حالا ما هم تو همین بلایی"
    },
    {
      "id": 11,
      "start": 7918.0,
      "end": 7920.0,
      "formatted_start": "02:11:58.000",
      "formatted_end": "02:12:00.000",
      "text": "ما هم تو همین بلایی"
    },
    {
      "id": 12,
      "start": 7920.0,
      "end": 7922.0,
      "formatted_start": "02:12:00.000",
      "formatted_end": "02:12:02.000",
      "text": "مانده دیگه"
    },
    {
      "id": 13,
      "start": 7922.0,
      "end": 7924.0,
      "formatted_start": "02:12:02.000",
      "formatted_end": "02:12:04.000",
      "text": "مانده دیگه متعیش شد"
    },
    {
      "id": 14,
      "start": 7924.0,
      "end": 7926.0,
      "formatted_start": "02:12:04.000",
      "formatted_end": "02:12:06.000",
      "text": "نمیتونم دستگاه منتر رو بشیم"
    },
    {
      "id": 15,
      "start": 7926.0,
      "end": 7928.0,
      "formatted_start": "02:12:06.000",
      "formatted_end": "02:12:08.000",
      "text": "مانده دیگه"
    },
    {
      "id": 16,
      "start": 7928.0,
      "end": 7930.0,
      "formatted_start": "02:12:08.000",
      "formatted_end": "02:12:10.000",
      "text": "من اول بشم"
    },
    {
      "id": 17,
      "start": 7930.0,
      "end": 7932.0,
      "formatted_start": "02:12:10.000",
      "formatted_end": "02:12:12.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 18,
      "start": 7932.0,
      "end": 7934.0,
      "formatted_start": "02:12:12.000",
      "formatted_end": "02:12:14.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 19,
      "start": 7934.0,
      "end": 7936.0,
      "formatted_start": "02:12:14.000",
      "formatted_end": "02:12:16.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 20,
      "start": 7936.0,
      "end": 7938.0,
      "formatted_start": "02:12:16.000",
      "formatted_end": "02:12:18.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 21,
      "start": 7938.0,
      "end": 7940.0,
      "formatted_start": "02:12:18.000",
      "formatted_end": "02:12:20.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 22,
      "start": 7940.0,
      "end": 7942.0,
      "formatted_start": "02:12:20.000",
      "formatted_end": "02:12:22.000",
      "text": "منتر رو بشم"
    },
    {
      "id": 23,
      "start": 7942.0,
      "end": 7952.0,
      "formatted_start": "02:12:22.000",
      "formatted_end": "02:12:32.000",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 7972.0,
      "end": 7984.0,
      "formatted_start": "02:12:52.000",
      "formatted_end": "02:13:04.000",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 8002.0,
      "end": 8032.0,
      "formatted_start": "02:13:22.000",
      "formatted_end": "02:13:52.000",
      "text": "بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی که برداری کنند، بچه هایی"
    },
    {
      "id": 26,
      "start": 8032.0,
      "end": 8036.0,
      "formatted_start": "02:13:52.000",
      "formatted_end": "02:13:56.000",
      "text": "و گردتاشون هیچی. سیطر از آنجا بود."
    },
    {
      "id": 27,
      "start": 8036.0,
      "end": 8040.0,
      "formatted_start": "02:13:56.000",
      "formatted_end": "02:14:00.000",
      "text": "یا شما تا کنون مردم یک بکتری براشون گردن بود."
    },
    {
      "id": 28,
      "start": 8040.0,
      "end": 8044.0,
      "formatted_start": "02:14:00.000",
      "formatted_end": "02:14:04.000",
      "text": "خب یک گردی که چرا بود بودید آنجا براتون."
    },
    {
      "id": 29,
      "start": 8044.0,
      "end": 8050.0,
      "formatted_start": "02:14:04.000",
      "formatted_end": "02:14:10.000",
      "text": "این دولت را با همین دولت"
    },
    {
      "id": 30,
      "start": 8050.0,
      "end": 8054.0,
      "formatted_start": "02:14:10.000",
      "formatted_end": "02:14:14.000",
      "text": "دیدیدی مردم اون دولت نشانه. این دولت"
    },
    {
      "id": 31,
      "start": 8054.0,
      "end": 8058.0,
      "formatted_start": "02:14:14.000",
      "formatted_end": "02:14:18.000",
      "text": "بتونه جهانی را کنترل کنه. توادر را کنترل کنه."
    },
    {
      "id": 32,
      "start": 8058.0,
      "end": 8061.0,
      "formatted_start": "02:14:18.000",
      "formatted_end": "02:14:21.000",
      "text": "این اینکه این کلیه آدم قدرت بیا کنه"
    },
    {
      "id": 33,
      "start": 8061.0,
      "end": 8063.0,
      "formatted_start": "02:14:21.000",
      "formatted_end": "02:14:23.000",
      "text": "باید درست بشه"
    },
    {
      "id": 34,
      "start": 8063.0,
      "end": 8066.0,
      "formatted_start": "02:14:23.000",
      "formatted_end": "02:14:26.000",
      "text": "الان تا اونکه خواهد تو بعد یک پنج سال باید برداری"
    },
    {
      "id": 35,
      "start": 8066.0,
      "end": 8068.0,
      "formatted_start": "02:14:26.000",
      "formatted_end": "02:14:28.000",
      "text": "پنج سال بگیر جورو"
    },
    {
      "id": 36,
      "start": 8068.0,
      "end": 8070.0,
      "formatted_start": "02:14:28.000",
      "formatted_end": "02:14:30.000",
      "text": "تو اون کلیه می کنه"
    },
    {
      "id": 37,
      "start": 8070.0,
      "end": 8072.0,
      "formatted_start": "02:14:30.000",
      "formatted_end": "02:14:32.000",
      "text": "یه باریکه عجیبنگی نیشه"
    },
    {
      "id": 38,
      "start": 8072.0,
      "end": 8074.0,
      "formatted_start": "02:14:32.000",
      "formatted_end": "02:14:34.000",
      "text": "همین شعر رو تون بشه که"
    },
    {
      "id": 39,
      "start": 8074.0,
      "end": 8076.0,
      "formatted_start": "02:14:34.000",
      "formatted_end": "02:14:36.000",
      "text": "خوب"
    },
    {
      "id": 40,
      "start": 8088.0,
      "end": 8100.0,
      "formatted_start": "02:14:48.000",
      "formatted_end": "02:15:00.000",
      "text": "موسیقی"
    }
  ],
