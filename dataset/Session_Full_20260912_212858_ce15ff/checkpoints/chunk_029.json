  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8704.5,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:04.500",
      "text": "اون ببین اینوری ماشین داشت رد میشد."
    },
    {
      "id": 1,
      "start": 8704.5,
      "end": 8706.5,
      "formatted_start": "02:25:04.500",
      "formatted_end": "02:25:06.500",
      "text": "اون فلکه با اون چایبایی نه."
    },
    {
      "id": 2,
      "start": 8706.5,
      "end": 8708.5,
      "formatted_start": "02:25:06.500",
      "formatted_end": "02:25:08.500",
      "text": "یعنی سنسور های اینجا مثلا میگیره اون میزنه."
    },
    {
      "id": 3,
      "start": 8708.5,
      "end": 8710.5,
      "formatted_start": "02:25:08.500",
      "formatted_end": "02:25:10.500",
      "text": "همون دیگه یه لحظه فکر کنم میگیره میزنه."
    },
    {
      "id": 4,
      "start": 8710.5,
      "end": 8714.5,
      "formatted_start": "02:25:10.500",
      "formatted_end": "02:25:14.500",
      "text": "بله بله اون سنسور میگیره میزنه، سنسور این بقال ها اینور."
    },
    {
      "id": 5,
      "start": 8714.5,
      "end": 8716.5,
      "formatted_start": "02:25:14.500",
      "formatted_end": "02:25:16.500",
      "text": "نه اصلا تو چایبایی ما وایستاده بودیم."
    },
    {
      "id": 6,
      "start": 8716.5,
      "end": 8718.5,
      "formatted_start": "02:25:16.500",
      "formatted_end": "02:25:18.500",
      "text": "بعد مثلا انا من تا کجا بود بیا انا بزرگ کمچورتر بردم."
    },
    {
      "id": 7,
      "start": 8718.5,
      "end": 8720.5,
      "formatted_start": "02:25:18.500",
      "formatted_end": "02:25:20.500",
      "text": "مثلا اونجا بود ماشینه."
    },
    {
      "id": 8,
      "start": 8720.5,
      "end": 8722.5,
      "formatted_start": "02:25:20.500",
      "formatted_end": "02:25:22.500",
      "text": "اجرومه داشت رد میشد"
    },
    {
      "id": 9,
      "start": 8722.5,
      "end": 8725.5,
      "formatted_start": "02:25:22.500",
      "formatted_end": "02:25:25.500",
      "text": "داشت رد میشد اجرومه دقیقا اونقدر فاصله داشت"
    },
    {
      "id": 10,
      "start": 8725.5,
      "end": 8726.5,
      "formatted_start": "02:25:25.500",
      "formatted_end": "02:25:26.500",
      "text": "نه نه نه"
    },
    {
      "id": 11,
      "start": 8726.5,
      "end": 8728.5,
      "formatted_start": "02:25:26.500",
      "formatted_end": "02:25:28.500",
      "text": "میگم دو متر حد اقل بود"
    },
    {
      "id": 12,
      "start": 8728.5,
      "end": 8732.5,
      "formatted_start": "02:25:28.500",
      "formatted_end": "02:25:32.500",
      "text": "ببین من هر روز دوسته بار ست کیلومتر با این ماشین میرم"
    },
    {
      "id": 13,
      "start": 8733.5,
      "end": 8737.5,
      "formatted_start": "02:25:33.500",
      "formatted_end": "02:25:37.500",
      "text": "دو بار شده و اون دو بار هم کاملا درست شده"
    },
    {
      "id": 14,
      "start": 8737.5,
      "end": 8739.5,
      "formatted_start": "02:25:37.500",
      "formatted_end": "02:25:39.500",
      "text": "یعنی منطقی عمل کرده"
    },
    {
      "id": 15,
      "start": 8739.5,
      "end": 8741.5,
      "formatted_start": "02:25:39.500",
      "formatted_end": "02:25:41.500",
      "text": "بار اولم که برامون زد درست بوده ببین"
    },
    {
      "id": 16,
      "start": 8741.5,
      "end": 8745.5,
      "formatted_start": "02:25:41.500",
      "formatted_end": "02:25:45.500",
      "text": "اون بار دوگم شما ببین یک جارو متوجه نشوند"
    },
    {
      "id": 17,
      "start": 8745.5,
      "end": 8748.5,
      "formatted_start": "02:25:45.500",
      "formatted_end": "02:25:48.500",
      "text": "یک لائن خطر داشته که اون زده"
    },
    {
      "id": 18,
      "start": 8750.5,
      "end": 8754.74,
      "formatted_start": "02:25:50.500",
      "formatted_end": "02:25:54.740",
      "text": "شب هیچوقت فرمان اینجوری نگه"
    },
    {
      "id": 19,
      "start": 8754.74,
      "end": 8757.56,
      "formatted_start": "02:25:54.740",
      "formatted_end": "02:25:57.560",
      "text": "یک دست درست فرمانه به چزم"
    },
    {
      "id": 20,
      "start": 8757.56,
      "end": 8760.72,
      "formatted_start": "02:25:57.560",
      "formatted_end": "02:26:00.720",
      "text": "خدا دو دست"
    },
    {
      "id": 21,
      "start": 8760.72,
      "end": 8766.96,
      "formatted_start": "02:26:00.720",
      "formatted_end": "02:26:06.960",
      "text": "یه دست روی دیگه ندار نگه داشت"
    },
    {
      "id": 22,
      "start": 8766.96,
      "end": 8768.58,
      "formatted_start": "02:26:06.960",
      "formatted_end": "02:26:08.580",
      "text": "نه چرا با یه دست نگه داشت"
    },
    {
      "id": 23,
      "start": 8768.58,
      "end": 8770.64,
      "formatted_start": "02:26:08.580",
      "formatted_end": "02:26:10.640",
      "text": "چون دست بکن با این دست نگه داشت"
    },
    {
      "id": 24,
      "start": 8770.64,
      "end": 8773.98,
      "formatted_start": "02:26:10.640",
      "formatted_end": "02:26:13.980",
      "text": "رو این دست فرمان نگه داشتن"
    },
    {
      "id": 25,
      "start": 8773.98,
      "end": 8776.46,
      "formatted_start": "02:26:13.980",
      "formatted_end": "02:26:16.460",
      "text": "تسلط رو فرمان نداریم"
    },
    {
      "id": 26,
      "start": 8776.46,
      "end": 8778.14,
      "formatted_start": "02:26:16.460",
      "formatted_end": "02:26:18.140",
      "text": "وگرنه اصلا این رینگ نیمی زدن"
    },
    {
      "id": 27,
      "start": 8778.14,
      "end": 8780.08,
      "formatted_start": "02:26:18.140",
      "formatted_end": "02:26:20.080",
      "text": "میگفتن دستتونو بزاریم همجوری به چزم"
    },
    {
      "id": 28,
      "start": 8780.08,
      "end": 8791.24,
      "formatted_start": "02:26:20.080",
      "formatted_end": "02:26:31.240",
      "text": "آه ببینیم الان نکنه الان تسلطت رو ماشین خوبه چون فرمانی چسبیدی"
    },
    {
      "id": 29,
      "start": 8802.52,
      "end": 8807.08,
      "formatted_start": "02:26:42.520",
      "formatted_end": "02:26:47.080",
      "text": "خب چه خبر فرنگی سنگ زد گفت کهی میاییم من گفتم هفت روب ما حرکت میکنیم"
    },
    {
      "id": 30,
      "start": 8807.08,
      "end": 8811.08,
      "formatted_start": "02:26:47.080",
      "formatted_end": "02:26:51.080",
      "text": "بودم به چاطه فارسیان افتادیم زنگ میزنم"
    },
    {
      "id": 31,
      "start": 8811.08,
      "end": 8815.08,
      "formatted_start": "02:26:51.080",
      "formatted_end": "02:26:55.080",
      "text": "گفتن اگه چیزی میخواییم بگرم"
    },
    {
      "id": 32,
      "start": 8815.08,
      "end": 8817.08,
      "formatted_start": "02:26:55.080",
      "formatted_end": "02:26:57.080",
      "text": "گفت نه نه بابیگه فقط گفتن"
    },
    {
      "id": 33,
      "start": 8829.08,
      "end": 8831.08,
      "formatted_start": "02:27:09.080",
      "formatted_end": "02:27:11.080",
      "text": "شب این بر ببین"
    },
    {
      "id": 34,
      "start": 8831.08,
      "end": 8833.08,
      "formatted_start": "02:27:11.080",
      "formatted_end": "02:27:13.080",
      "text": "امانه باید راست بری بهتر ببین"
    },
    {
      "id": 35,
      "start": 8833.08,
      "end": 8835.08,
      "formatted_start": "02:27:13.080",
      "formatted_end": "02:27:15.080",
      "text": "امانه چایی که دور میزنیم گمبه از مستقیم برنده"
    },
    {
      "id": 36,
      "start": 8835.08,
      "end": 8837.08,
      "formatted_start": "02:27:15.080",
      "formatted_end": "02:27:17.080",
      "text": "اون بعد مستقیم برنده"
    },
    {
      "id": 37,
      "start": 8837.08,
      "end": 8839.08,
      "formatted_start": "02:27:17.080",
      "formatted_end": "02:27:19.080",
      "text": "آره آره"
    },
    {
      "id": 38,
      "start": 8843.08,
      "end": 8845.08,
      "formatted_start": "02:27:23.080",
      "formatted_end": "02:27:25.080",
      "text": "یاوش یاوش بزرگون برد"
    },
    {
      "id": 39,
      "start": 8850.08,
      "end": 8852.08,
      "formatted_start": "02:27:30.080",
      "formatted_end": "02:27:32.080",
      "text": "برام دیگه چیزی خوردنی نداری؟"
    },
    {
      "id": 40,
      "start": 8852.08,
      "end": 8854.08,
      "formatted_start": "02:27:32.080",
      "formatted_end": "02:27:34.080",
      "text": "نه نه اون زفت میدازه"
    },
    {
      "id": 41,
      "start": 8854.08,
      "end": 8856.08,
      "formatted_start": "02:27:34.080",
      "formatted_end": "02:27:36.080",
      "text": "اون کارم"
    },
    {
      "id": 42,
      "start": 8856.08,
      "end": 8858.08,
      "formatted_start": "02:27:36.080",
      "formatted_end": "02:27:38.080",
      "text": "باید زفت میدازه"
    },
    {
      "id": 43,
      "start": 8862.08,
      "end": 8864.08,
      "formatted_start": "02:27:42.080",
      "formatted_end": "02:27:44.080",
      "text": "یاوش یاوش بزرگون بزرگون برند"
    },
    {
      "id": 44,
      "start": 8864.08,
      "end": 8866.08,
      "formatted_start": "02:27:44.080",
      "formatted_end": "02:27:46.080",
      "text": "بایستا بایستا اونا برن"
    },
    {
      "id": 45,
      "start": 8868.08,
      "end": 8870.08,
      "formatted_start": "02:27:48.080",
      "formatted_end": "02:27:50.080",
      "text": "میشه هفت رو"
    },
    {
      "id": 46,
      "start": 8870.08,
      "end": 8872.08,
      "formatted_start": "02:27:50.080",
      "formatted_end": "02:27:52.080",
      "text": "نه اینجا"
    },
    {
      "id": 47,
      "start": 8872.08,
      "end": 8874.08,
      "formatted_start": "02:27:52.080",
      "formatted_end": "02:27:54.080",
      "text": "اصلا هفت بابر پیاده نیست"
    },
    {
      "id": 48,
      "start": 8874.08,
      "end": 8876.08,
      "formatted_start": "02:27:54.080",
      "formatted_end": "02:27:56.080",
      "text": "حالا دیگه اومده شاپ پیره مرده"
    },
    {
      "id": 49,
      "start": 8876.08,
      "end": 8878.08,
      "formatted_start": "02:27:56.080",
      "formatted_end": "02:27:58.080",
      "text": "زن رو میرنش"
    },
    {
      "id": 50,
      "start": 8878.08,
      "end": 8880.08,
      "formatted_start": "02:27:58.080",
      "formatted_end": "02:28:00.080",
      "text": "نه ترسونشون"
    },
    {
      "id": 51,
      "start": 8880.08,
      "end": 8882.08,
      "formatted_start": "02:28:00.080",
      "formatted_end": "02:28:02.080",
      "text": "بنده خدا رو"
    },
    {
      "id": 52,
      "start": 8882.08,
      "end": 8884.08,
      "formatted_start": "02:28:02.080",
      "formatted_end": "02:28:04.080",
      "text": "روی خطوه آور پیاده"
    },
    {
      "id": 53,
      "start": 8884.08,
      "end": 8886.08,
      "formatted_start": "02:28:04.080",
      "formatted_end": "02:28:06.080",
      "text": "ببین در هر صورت"
    },
    {
      "id": 54,
      "start": 8886.08,
      "end": 8888.08,
      "formatted_start": "02:28:06.080",
      "formatted_end": "02:28:08.080",
      "text": "اینجا باید پل هوایی بزنن"
    },
    {
      "id": 55,
      "start": 8888.08,
      "end": 8890.08,
      "formatted_start": "02:28:08.080",
      "formatted_end": "02:28:10.080",
      "text": "حالا اینها پل مل نمیرن"
    },
    {
      "id": 56,
      "start": 8890.08,
      "end": 8892.08,
      "formatted_start": "02:28:10.080",
      "formatted_end": "02:28:12.080",
      "text": "پل هم بزنن نمیرن"
    },
    {
      "id": 57,
      "start": 8892.08,
      "end": 8894.08,
      "formatted_start": "02:28:12.080",
      "formatted_end": "02:28:14.080",
      "text": "خودم هم نمیدونیم پل اگه باشه"
    },
    {
      "id": 58,
      "start": 8894.08,
      "end": 8896.08,
      "formatted_start": "02:28:14.080",
      "formatted_end": "02:28:16.080",
      "text": "خودش تو هم میدونیم"
    },
    {
      "id": 59,
      "start": 8896.08,
      "end": 8898.08,
      "formatted_start": "02:28:16.080",
      "formatted_end": "02:28:18.080",
      "text": "ولی از این پل بغیر رو داشته باشه میدونیم"
    },
    {
      "id": 60,
      "start": 8898.08,
      "end": 8900.08,
      "formatted_start": "02:28:18.080",
      "formatted_end": "02:28:20.080",
      "text": "ببینیم باید توی رانندگی ایران تعامل کنیم"
    },
    {
      "id": 61,
      "start": 8900.08,
      "end": 8902.08,
      "formatted_start": "02:28:20.080",
      "formatted_end": "02:28:22.080",
      "text": "اون فرهنگ"
    },
    {
      "id": 62,
      "start": 8902.08,
      "end": 8904.08,
      "formatted_start": "02:28:22.080",
      "formatted_end": "02:28:24.080",
      "text": "نمیدونم دقیق رانندگی نیست"
    },
    {
      "id": 63,
      "start": 8904.08,
      "end": 8906.08,
      "formatted_start": "02:28:24.080",
      "formatted_end": "02:28:26.080",
      "text": "آقا باید ببینیم"
    },
    {
      "id": 64,
      "start": 8906.08,
      "end": 8908.08,
      "formatted_start": "02:28:26.080",
      "formatted_end": "02:28:28.080",
      "text": "اینا همین هستند اینا همین موجودند"
    },
    {
      "id": 65,
      "start": 8908.08,
      "end": 8910.08,
      "formatted_start": "02:28:28.080",
      "formatted_end": "02:28:30.080",
      "text": "ما همین موجودیم"
    },
    {
      "id": 66,
      "start": 8910.08,
      "end": 8912.08,
      "formatted_start": "02:28:30.080",
      "formatted_end": "02:28:32.080",
      "text": "یه نفر میاد"
    },
    {
      "id": 67,
      "start": 8912.08,
      "end": 8914.08,
      "formatted_start": "02:28:32.080",
      "formatted_end": "02:28:34.080",
      "text": "چیز کن"
    },
    {
      "id": 68,
      "start": 8914.08,
      "end": 8916.08,
      "formatted_start": "02:28:34.080",
      "formatted_end": "02:28:36.080",
      "text": "چیزش"
    },
    {
      "id": 69,
      "start": 8916.08,
      "end": 8918.08,
      "formatted_start": "02:28:36.080",
      "formatted_end": "02:28:38.080",
      "text": "باید چیزون نگه هم میداره"
    },
    {
      "id": 70,
      "start": 8918.08,
      "end": 8920.08,
      "formatted_start": "02:28:38.080",
      "formatted_end": "02:28:40.080",
      "text": "کجا بده والا وای میزده"
    },
    {
      "id": 71,
      "start": 8920.08,
      "end": 8922.08,
      "formatted_start": "02:28:40.080",
      "formatted_end": "02:28:42.080",
      "text": "خواهی بده بده بابا برم"
    },
    {
      "id": 72,
      "start": 8924.08,
      "end": 8926.08,
      "formatted_start": "02:28:44.080",
      "formatted_end": "02:28:46.080",
      "text": "شاید این صدا ماشینی تو چطوره؟"
    },
    {
      "id": 73,
      "start": 8926.08,
      "end": 8928.08,
      "formatted_start": "02:28:46.080",
      "formatted_end": "02:28:48.080",
      "text": "خیلی خوبه"
    },
    {
      "id": 74,
      "start": 8928.08,
      "end": 8929.08,
      "formatted_start": "02:28:48.080",
      "formatted_end": "02:28:49.080",
      "text": "نرم نیست؟"
    },
    {
      "id": 75,
      "start": 8929.08,
      "end": 8930.08,
      "formatted_start": "02:28:49.080",
      "formatted_end": "02:28:50.080",
      "text": "نرم نیست"
    },
    {
      "id": 76,
      "start": 8930.08,
      "end": 8931.08,
      "formatted_start": "02:28:50.080",
      "formatted_end": "02:28:51.080",
      "text": "این یه جوریه"
    },
    {
      "id": 77,
      "start": 8931.08,
      "end": 8932.08,
      "formatted_start": "02:28:51.080",
      "formatted_end": "02:28:52.080",
      "text": "هواپمایی؟"
    },
    {
      "id": 78,
      "start": 8932.08,
      "end": 8933.08,
      "formatted_start": "02:28:52.080",
      "formatted_end": "02:28:53.080",
      "text": "خوبه اینگاه اصلا"
    },
    {
      "id": 79,
      "start": 8933.08,
      "end": 8934.08,
      "formatted_start": "02:28:53.080",
      "formatted_end": "02:28:54.080",
      "text": "اتون نرمه بیده"
    },
    {
      "id": 80,
      "start": 8934.08,
      "end": 8935.08,
      "formatted_start": "02:28:54.080",
      "formatted_end": "02:28:55.080",
      "text": "صداییه"
    },
    {
      "id": 81,
      "start": 8935.08,
      "end": 8937.08,
      "formatted_start": "02:28:55.080",
      "formatted_end": "02:28:57.080",
      "text": "اصلا خسته نمیشی"
    },
    {
      "id": 82,
      "start": 8937.08,
      "end": 8939.08,
      "formatted_start": "02:28:57.080",
      "formatted_end": "02:28:59.080",
      "text": "متایش داری؟"
    },
    {
      "id": 83,
      "start": 8939.08,
      "end": 8940.08,
      "formatted_start": "02:28:59.080",
      "formatted_end": "02:29:00.080",
      "text": "شاید برای اینه"
    },
    {
      "id": 84,
      "start": 8940.08,
      "end": 8942.08,
      "formatted_start": "02:29:00.080",
      "formatted_end": "02:29:02.080",
      "text": "پمبه رو از تو گوشت در بیاد"
    },
    {
      "id": 85,
      "start": 8942.08,
      "end": 8943.08,
      "formatted_start": "02:29:02.080",
      "formatted_end": "02:29:03.080",
      "text": "اون پمبه؟"
    },
    {
      "id": 86,
      "start": 8943.08,
      "end": 8945.08,
      "formatted_start": "02:29:03.080",
      "formatted_end": "02:29:05.080",
      "text": "همون پمبه ای تو گوشت ده"
    },
    {
      "id": 87,
      "start": 8945.08,
      "end": 8947.08,
      "formatted_start": "02:29:05.080",
      "formatted_end": "02:29:07.080",
      "text": "یعنی خوب گوش بده خواه"
    },
    {
      "id": 88,
      "start": 8947.08,
      "end": 8949.08,
      "formatted_start": "02:29:07.080",
      "formatted_end": "02:29:09.080",
      "text": "که تو فعلا همین ماشینه داری"
    },
    {
      "id": 89,
      "start": 8949.08,
      "end": 8951.08,
      "formatted_start": "02:29:09.080",
      "formatted_end": "02:29:11.080",
      "text": "اینم مال تو یا؟"
    },
    {
      "id": 90,
      "start": 8951.08,
      "end": 8953.08,
      "formatted_start": "02:29:11.080",
      "formatted_end": "02:29:13.080",
      "text": "اینم مال تو و احسامه"
    },
    {
      "id": 91,
      "start": 8953.08,
      "end": 8955.08,
      "formatted_start": "02:29:13.080",
      "formatted_end": "02:29:15.080",
      "text": "از کنش تلاش کنه اشاله ماشین از این از بیتر بزرگ"
    },
    {
      "id": 92,
      "start": 8955.08,
      "end": 8957.08,
      "formatted_start": "02:29:15.080",
      "formatted_end": "02:29:17.080",
      "text": "آره، آره تو مخطب"
    },
    {
      "id": 93,
      "start": 8957.08,
      "end": 8959.08,
      "formatted_start": "02:29:17.080",
      "formatted_end": "02:29:19.080",
      "text": "الان همین فیلمانی اصلا ماشین خوبیه"
    },
    {
      "id": 94,
      "start": 8959.08,
      "end": 8961.08,
      "formatted_start": "02:29:19.080",
      "formatted_end": "02:29:21.080",
      "text": "یعنی اگر یه سه ویست دیگه بشه"
    },
    {
      "id": 95,
      "start": 8961.08,
      "end": 8963.08,
      "formatted_start": "02:29:21.080",
      "formatted_end": "02:29:23.080",
      "text": "از این پراید و پیجو دیویست و شیش و"
    },
    {
      "id": 96,
      "start": 8963.08,
      "end": 8965.08,
      "formatted_start": "02:29:23.080",
      "formatted_end": "02:29:25.080",
      "text": "ماشین خارجیه و ترکه خیلی"
    },
    {
      "id": 97,
      "start": 8965.08,
      "end": 8967.08,
      "formatted_start": "02:29:25.080",
      "formatted_end": "02:29:27.080",
      "text": "پرانسیه خب"
    },
    {
      "id": 98,
      "start": 8967.08,
      "end": 8969.08,
      "formatted_start": "02:29:27.080",
      "formatted_end": "02:29:29.080",
      "text": "جادار، بزرگ"
    },
    {
      "id": 99,
      "start": 8969.08,
      "end": 8971.08,
      "formatted_start": "02:29:29.080",
      "formatted_end": "02:29:31.080",
      "text": "الان از چشم ما چیزه"
    },
    {
      "id": 100,
      "start": 8971.08,
      "end": 8974.08,
      "formatted_start": "02:29:31.080",
      "formatted_end": "02:29:34.080",
      "text": "اونجا بیرون دیگه اون ماشین این چیزی بایبتیه"
    },
    {
      "id": 101,
      "start": 8974.08,
      "end": 8977.08,
      "formatted_start": "02:29:34.080",
      "formatted_end": "02:29:37.080",
      "text": "سایی کن تو بهترشه بگیری"
    },
    {
      "id": 102,
      "start": 8977.08,
      "end": 8979.08,
      "formatted_start": "02:29:37.080",
      "formatted_end": "02:29:39.080",
      "text": "بهتره بهتر این چیز بوده"
    },
    {
      "id": 103,
      "start": 8979.08,
      "end": 8984.08,
      "formatted_start": "02:29:39.080",
      "formatted_end": "02:29:44.080",
      "text": "همچنان که پدر ما وقتی پیراد خرید ما اینقدر زغزده بودیم"
    },
    {
      "id": 104,
      "start": 8984.08,
      "end": 8988.08,
      "formatted_start": "02:29:44.080",
      "formatted_end": "02:29:48.080",
      "text": "یعنی کلر هم داشته بود اون موقع پیکان تبدیل به پیراد شد"
    },
    {
      "id": 105,
      "start": 8988.08,
      "end": 8993.08,
      "formatted_start": "02:29:48.080",
      "formatted_end": "02:29:53.080",
      "text": "ما اصلا میگفتیم باید کلر چقدر خوب بخدا"
    },
    {
      "id": 106,
      "start": 8993.08,
      "end": 8995.08,
      "formatted_start": "02:29:53.080",
      "formatted_end": "02:29:55.080",
      "text": "خوب؟"
    },
    {
      "id": 107,
      "start": 8995.08,
      "end": 8997.08,
      "formatted_start": "02:29:55.080",
      "formatted_end": "02:29:57.080",
      "text": "دارید این ماشین های قدیم کلر نشونده شد"
    },
    {
      "id": 108,
      "start": 8997.08,
      "end": 9000.08,
      "formatted_start": "02:29:57.080",
      "formatted_end": "02:30:00.080",
      "text": "آره بگفتیم پیراد چقدر نرمه"
    }
  ],
  "status": "completed"
}