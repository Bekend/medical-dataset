  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10201.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:01.000",
      "text": "بابراکروز هم میره."
    },
    {
      "id": 1,
      "start": 10201.0,
      "end": 10202.68,
      "formatted_start": "02:50:01.000",
      "formatted_end": "02:50:02.680",
      "text": "نه اصلا روزم بوده، نداشته."
    },
    {
      "id": 2,
      "start": 10202.68,
      "end": 10206.0,
      "formatted_start": "02:50:02.680",
      "formatted_end": "02:50:06.000",
      "text": "ازش شبه، چون پیچاشم بذاره چیز در اینجا."
    },
    {
      "id": 3,
      "start": 10206.0,
      "end": 10207.0,
      "formatted_start": "02:50:06.000",
      "formatted_end": "02:50:07.000",
      "text": "آره آره."
    },
    {
      "id": 4,
      "start": 10207.0,
      "end": 10210.0,
      "formatted_start": "02:50:07.000",
      "formatted_end": "02:50:10.000",
      "text": "اون دون برگاره که پیچه دی، باید بگو داره."
    },
    {
      "id": 5,
      "start": 10211.0,
      "end": 10212.0,
      "formatted_start": "02:50:11.000",
      "formatted_end": "02:50:12.000",
      "text": "بکار زده."
    },
    {
      "id": 6,
      "start": 10213.0,
      "end": 10215.0,
      "formatted_start": "02:50:13.000",
      "formatted_end": "02:50:15.000",
      "text": "شب این ماشین جت خوبی داره."
    },
    {
      "id": 7,
      "start": 10217.0,
      "end": 10219.0,
      "formatted_start": "02:50:17.000",
      "formatted_end": "02:50:19.000",
      "text": "یعنی شتاب خوبی داره."
    },
    {
      "id": 8,
      "start": 10219.0,
      "end": 10222.0,
      "formatted_start": "02:50:19.000",
      "formatted_end": "02:50:22.000",
      "text": "یعنی شما تو مخوای در بری از تصویر."
    },
    {
      "id": 9,
      "start": 10222.0,
      "end": 10224.0,
      "formatted_start": "02:50:22.000",
      "formatted_end": "02:50:24.000",
      "text": "اون موضوع هم خیلی خوبیه، میخواه یه اشاره میخواه."
    },
    {
      "id": 10,
      "start": 10224.0,
      "end": 10227.04,
      "formatted_start": "02:50:24.000",
      "formatted_end": "02:50:27.040",
      "text": "در این صفر صدش خیلی خوبه"
    },
    {
      "id": 11,
      "start": 10227.04,
      "end": 10234.26,
      "formatted_start": "02:50:27.040",
      "formatted_end": "02:50:34.260",
      "text": "علکی نبوده که جز بالاترین اولین تویتا کامیری گذاشته"
    },
    {
      "id": 12,
      "start": 10234.26,
      "end": 10252.26,
      "formatted_start": "02:50:34.260",
      "formatted_end": "02:50:52.260",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 10252.26,
      "end": 10254.26,
      "formatted_start": "02:50:52.260",
      "formatted_end": "02:50:54.260",
      "text": "این دستانداز ها رو خوب درست می کنند"
    },
    {
      "id": 14,
      "start": 10254.26,
      "end": 10256.26,
      "formatted_start": "02:50:54.260",
      "formatted_end": "02:50:56.260",
      "text": "این دستانداز نزدیک خونه موزدند دیدید؟"
    },
    {
      "id": 15,
      "start": 10256.26,
      "end": 10258.26,
      "formatted_start": "02:50:56.260",
      "formatted_end": "02:50:58.260",
      "text": "آره آره"
    },
    {
      "id": 16,
      "start": 10258.26,
      "end": 10260.26,
      "formatted_start": "02:50:58.260",
      "formatted_end": "02:51:00.260",
      "text": "اون خیان نشد"
    },
    {
      "id": 17,
      "start": 10260.26,
      "end": 10262.26,
      "formatted_start": "02:51:00.260",
      "formatted_end": "02:51:02.260",
      "text": "مثلا این مقدمشو از دادن اونجور"
    },
    {
      "id": 18,
      "start": 10262.26,
      "end": 10264.26,
      "formatted_start": "02:51:02.260",
      "formatted_end": "02:51:04.260",
      "text": "اصلا نیاز نبود"
    },
    {
      "id": 19,
      "start": 10264.26,
      "end": 10266.26,
      "formatted_start": "02:51:04.260",
      "formatted_end": "02:51:06.260",
      "text": "اونجور گاز می دهند"
    },
    {
      "id": 20,
      "start": 10266.26,
      "end": 10268.26,
      "formatted_start": "02:51:06.260",
      "formatted_end": "02:51:08.260",
      "text": "این هر نقطه که امکان گاز دادند باشه"
    },
    {
      "id": 21,
      "start": 10268.26,
      "end": 10270.26,
      "formatted_start": "02:51:08.260",
      "formatted_end": "02:51:10.260",
      "text": "آره آره"
    },
    {
      "id": 22,
      "start": 10270.26,
      "end": 10272.26,
      "formatted_start": "02:51:10.260",
      "formatted_end": "02:51:12.260",
      "text": "شب؟"
    },
    {
      "id": 23,
      "start": 10272.26,
      "end": 10274.26,
      "formatted_start": "02:51:12.260",
      "formatted_end": "02:51:14.260",
      "text": "نه چار راهه"
    },
    {
      "id": 24,
      "start": 10274.26,
      "end": 10276.26,
      "formatted_start": "02:51:14.260",
      "formatted_end": "02:51:16.260",
      "text": "نه مثلا خیابون گوشادیه"
    },
    {
      "id": 25,
      "start": 10276.26,
      "end": 10278.26,
      "formatted_start": "02:51:16.260",
      "formatted_end": "02:51:18.260",
      "text": "این بولواری که اونجور دردر کنند"
    },
    {
      "id": 26,
      "start": 10278.26,
      "end": 10280.26,
      "formatted_start": "02:51:18.260",
      "formatted_end": "02:51:20.260",
      "text": "خیلی واجب نیست"
    },
    {
      "id": 27,
      "start": 10280.26,
      "end": 10282.26,
      "formatted_start": "02:51:20.260",
      "formatted_end": "02:51:22.260",
      "text": "خیلی واجب نیست"
    },
    {
      "id": 28,
      "start": 10282.26,
      "end": 10284.26,
      "formatted_start": "02:51:22.260",
      "formatted_end": "02:51:24.260",
      "text": "یک چیزی هم برسن"
    },
    {
      "id": 29,
      "start": 10284.26,
      "end": 10288.26,
      "formatted_start": "02:51:24.260",
      "formatted_end": "02:51:28.260",
      "text": "مثلا اون جلو بازار روسا اونا واجب بود به نظر"
    },
    {
      "id": 30,
      "start": 10288.26,
      "end": 10290.26,
      "formatted_start": "02:51:28.260",
      "formatted_end": "02:51:30.260",
      "text": "آره اونا از خیابون چون رو برسن"
    },
    {
      "id": 31,
      "start": 10290.26,
      "end": 10294.26,
      "formatted_start": "02:51:30.260",
      "formatted_end": "02:51:34.260",
      "text": "من خودم چند بار دیدم سرعت زیاد میاد"
    },
    {
      "id": 32,
      "start": 10294.26,
      "end": 10296.26,
      "formatted_start": "02:51:34.260",
      "formatted_end": "02:51:36.260",
      "text": "خیلی ردگیشی وحشتت میشه"
    },
    {
      "id": 33,
      "start": 10306.26,
      "end": 10308.26,
      "formatted_start": "02:51:46.260",
      "formatted_end": "02:51:48.260",
      "text": "باید شیشه شوره بزن"
    },
    {
      "id": 34,
      "start": 10308.26,
      "end": 10312.26,
      "formatted_start": "02:51:48.260",
      "formatted_end": "02:51:52.260",
      "text": "بگذاریم ششه کسیفه"
    },
    {
      "id": 35,
      "start": 10312.26,
      "end": 10314.26,
      "formatted_start": "02:51:52.260",
      "formatted_end": "02:51:54.260",
      "text": "پرام زده اونو"
    },
    {
      "id": 36,
      "start": 10314.26,
      "end": 10317.26,
      "formatted_start": "02:51:54.260",
      "formatted_end": "02:51:57.260",
      "text": "نه بعضی موقع این بیاد این هر حروبه"
    },
    {
      "id": 37,
      "start": 10317.26,
      "end": 10320.26,
      "formatted_start": "02:51:57.260",
      "formatted_end": "02:52:00.260",
      "text": "شیرون؟"
    },
    {
      "id": 38,
      "start": 10325.26,
      "end": 10327.26,
      "formatted_start": "02:52:05.260",
      "formatted_end": "02:52:07.260",
      "text": "باید دو تن هستیم"
    },
    {
      "id": 39,
      "start": 10338.26,
      "end": 10340.26,
      "formatted_start": "02:52:18.260",
      "formatted_end": "02:52:20.260",
      "text": "آسمان هم میتونیم ببینیم"
    },
    {
      "id": 40,
      "start": 10342.26,
      "end": 10344.26,
      "formatted_start": "02:52:22.260",
      "formatted_end": "02:52:24.260",
      "text": "موز باشه"
    },
    {
      "id": 41,
      "start": 10344.26,
      "end": 10346.26,
      "formatted_start": "02:52:24.260",
      "formatted_end": "02:52:26.260",
      "text": "این هم باز میشه"
    },
    {
      "id": 42,
      "start": 10346.26,
      "end": 10348.26,
      "formatted_start": "02:52:26.260",
      "formatted_end": "02:52:28.260",
      "text": "تبا شو"
    },
    {
      "id": 43,
      "start": 10350.26,
      "end": 10352.26,
      "formatted_start": "02:52:30.260",
      "formatted_end": "02:52:32.260",
      "text": "چطوره اون پشت اینو"
    },
    {
      "id": 44,
      "start": 10352.26,
      "end": 10354.26,
      "formatted_start": "02:52:32.260",
      "formatted_end": "02:52:34.260",
      "text": "تبا شو"
    },
    {
      "id": 45,
      "start": 10354.26,
      "end": 10356.26,
      "formatted_start": "02:52:34.260",
      "formatted_end": "02:52:36.260",
      "text": "موزش باید پشت باشه"
    },
    {
      "id": 46,
      "start": 10368.26,
      "end": 10377.88,
      "formatted_start": "02:52:48.260",
      "formatted_end": "02:52:57.880",
      "text": "این از آنگاه های قشنگه"
    },
    {
      "id": 47,
      "start": 10377.88,
      "end": 10397.88,
      "formatted_start": "02:52:57.880",
      "formatted_end": "02:53:17.880",
      "text": "موسیقی"
    },
    {
      "id": 48,
      "start": 10397.88,
      "end": 10399.64,
      "formatted_start": "02:53:17.880",
      "formatted_end": "02:53:19.640",
      "text": "شب خوبه دست اندازه رو خوب میبینی"
    },
    {
      "id": 49,
      "start": 10399.64,
      "end": 10401.9,
      "formatted_start": "02:53:19.640",
      "formatted_end": "02:53:21.900",
      "text": "قبلن اینجوری نبودی"
    },
    {
      "id": 50,
      "start": 10401.9,
      "end": 10405.88,
      "formatted_start": "02:53:21.900",
      "formatted_end": "02:53:25.880",
      "text": "یعنی الان نشون میدهی که چیزت بهتر شده"
    },
    {
      "id": 51,
      "start": 10405.88,
      "end": 10409.82,
      "formatted_start": "02:53:25.880",
      "formatted_end": "02:53:29.820",
      "text": "از سلوتت به جاده"
    },
    {
      "id": 52,
      "start": 10409.82,
      "end": 10412.64,
      "formatted_start": "02:53:29.820",
      "formatted_end": "02:53:32.640",
      "text": "خودش خود ماشینش همشیزه"
    },
    {
      "id": 53,
      "start": 10412.64,
      "end": 10414.3,
      "formatted_start": "02:53:32.640",
      "formatted_end": "02:53:34.300",
      "text": "نه نه"
    },
    {
      "id": 54,
      "start": 10414.3,
      "end": 10416.26,
      "formatted_start": "02:53:34.300",
      "formatted_end": "02:53:36.260",
      "text": "فرموز میزنیم من میبینم"
    },
    {
      "id": 55,
      "start": 10416.26,
      "end": 10419.32,
      "formatted_start": "02:53:36.260",
      "formatted_end": "02:53:39.320",
      "text": "قبلن رد میکردیم"
    },
    {
      "id": 56,
      "start": 10419.32,
      "end": 10420.86,
      "formatted_start": "02:53:39.320",
      "formatted_end": "02:53:40.860",
      "text": "گلتیم شب چه خبره"
    },
    {
      "id": 57,
      "start": 10420.86,
      "end": 10423.38,
      "formatted_start": "02:53:40.860",
      "formatted_end": "02:53:43.380",
      "text": "استرس داشتی"
    },
    {
      "id": 58,
      "start": 10423.38,
      "end": 10425.32,
      "formatted_start": "02:53:43.380",
      "formatted_end": "02:53:45.320",
      "text": "اینا رو نیمی دیدی اصلا"
    },
    {
      "id": 59,
      "start": 10425.32,
      "end": 10429.32,
      "formatted_start": "02:53:45.320",
      "formatted_end": "02:53:49.320",
      "text": "حالا با یه آرامش بهتری رو رندگی میکنیم"
    },
    {
      "id": 60,
      "start": 10430.16,
      "end": 10433.16,
      "formatted_start": "02:53:50.160",
      "formatted_end": "02:53:53.160",
      "text": "اینا تمرین باید بشینی بابا جون"
    },
    {
      "id": 61,
      "start": 10433.16,
      "end": 10452.16,
      "formatted_start": "02:53:53.160",
      "formatted_end": "02:54:12.160",
      "text": "موسیقی"
    },
    {
      "id": 62,
      "start": 10452.16,
      "end": 10454.16,
      "formatted_start": "02:54:12.160",
      "formatted_end": "02:54:14.160",
      "text": "ماشین آف زدی؟"
    },
    {
      "id": 63,
      "start": 10455.16,
      "end": 10459.16,
      "formatted_start": "02:54:15.160",
      "formatted_end": "02:54:19.160",
      "text": "این دوتا جوان پس برای چند؟"
    },
    {
      "id": 64,
      "start": 10461.16,
      "end": 10463.16,
      "formatted_start": "02:54:21.160",
      "formatted_end": "02:54:23.160",
      "text": "بکی میده اون باز بکی"
    },
    {
      "id": 65,
      "start": 10463.16,
      "end": 10467.16,
      "formatted_start": "02:54:23.160",
      "formatted_end": "02:54:27.160",
      "text": "من خودم میخواستم میشوستم این روز با همین کارا"
    },
    {
      "id": 66,
      "start": 10468.16,
      "end": 10469.16,
      "formatted_start": "02:54:28.160",
      "formatted_end": "02:54:29.160",
      "text": "مستقیم؟"
    },
    {
      "id": 67,
      "start": 10470.16,
      "end": 10471.16,
      "formatted_start": "02:54:30.160",
      "formatted_end": "02:54:31.160",
      "text": "مستقیم برام"
    },
    {
      "id": 68,
      "start": 10473.16,
      "end": 10476.16,
      "formatted_start": "02:54:33.160",
      "formatted_end": "02:54:36.160",
      "text": "یه دقیقه بینامی گفتیم بپرن ماشین یه آف بزنن"
    },
    {
      "id": 69,
      "start": 10482.16,
      "end": 10494.16,
      "formatted_start": "02:54:42.160",
      "formatted_end": "02:54:54.160",
      "text": "موسیقی"
    },
    {
      "id": 70,
      "start": 10494.16,
      "end": 10495.2,
      "formatted_start": "02:54:54.160",
      "formatted_end": "02:54:55.200",
      "text": "جوهدی کشا؟"
    },
    {
      "id": 71,
      "start": 10495.2,
      "end": 10496.14,
      "formatted_start": "02:54:55.200",
      "formatted_end": "02:54:56.140",
      "text": "با پورومان بیتی"
    },
    {
      "id": 72,
      "start": 10496.14,
      "end": 10499.98,
      "formatted_start": "02:54:56.140",
      "formatted_end": "02:54:59.980",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}