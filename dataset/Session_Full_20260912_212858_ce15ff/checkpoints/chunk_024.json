  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7202.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:02.000",
      "text": "الان چیزی که هست، زرده یعنی."
    },
    {
      "id": 1,
      "start": 7202.0,
      "end": 7202.5,
      "formatted_start": "02:00:02.000",
      "formatted_end": "02:00:02.500",
      "text": "آره."
    },
    {
      "id": 2,
      "start": 7202.5,
      "end": 7206.0,
      "formatted_start": "02:00:02.500",
      "formatted_end": "02:00:06.000",
      "text": "اینشو من دارا میباهم می کنم، بدن بچه زرده."
    },
    {
      "id": 3,
      "start": 7206.0,
      "end": 7207.5,
      "formatted_start": "02:00:06.000",
      "formatted_end": "02:00:07.500",
      "text": "این معمیمتر از شویده."
    },
    {
      "id": 4,
      "start": 7207.5,
      "end": 7210.0,
      "formatted_start": "02:00:07.500",
      "formatted_end": "02:00:10.000",
      "text": "این شویده بیمار خونه رو یا خیلی پوشنده این بچه داره."
    },
    {
      "id": 5,
      "start": 7210.0,
      "end": 7210.5,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:10.500",
      "text": "آهانه؟"
    },
    {
      "id": 6,
      "start": 7210.5,
      "end": 7212.0,
      "formatted_start": "02:00:10.500",
      "formatted_end": "02:00:12.000",
      "text": "پوشنده که می پوشنده."
    },
    {
      "id": 7,
      "start": 7212.0,
      "end": 7213.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:13.000",
      "text": "شیر خوب می خوره؟"
    },
    {
      "id": 8,
      "start": 7213.0,
      "end": 7214.0,
      "formatted_start": "02:00:13.000",
      "formatted_end": "02:00:14.000",
      "text": "آهانه شیر خوب می خوره."
    },
    {
      "id": 9,
      "start": 7214.0,
      "end": 7216.0,
      "formatted_start": "02:00:14.000",
      "formatted_end": "02:00:16.000",
      "text": "آهانه تفتاش راشه شیر خوب نیست."
    },
    {
      "id": 10,
      "start": 7216.0,
      "end": 7218.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:18.000",
      "text": "این بیغالتی شیر خوره."
    },
    {
      "id": 11,
      "start": 7218.0,
      "end": 7219.0,
      "formatted_start": "02:00:18.000",
      "formatted_end": "02:00:19.000",
      "text": "آهانه بیخوره."
    },
    {
      "id": 12,
      "start": 7219.0,
      "end": 7223.0,
      "formatted_start": "02:00:19.000",
      "formatted_end": "02:00:23.000",
      "text": "چار روز چیه؟ بروخونی مادر چیه؟"
    },
    {
      "id": 13,
      "start": 7223.0,
      "end": 7227.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:27.000",
      "text": "ببینید کاملا زرده شما پدرش این"
    },
    {
      "id": 14,
      "start": 7227.0,
      "end": 7231.0,
      "formatted_start": "02:00:27.000",
      "formatted_end": "02:00:31.000",
      "text": "ببینید انگاش میذارم برمیذارم زیرش زرده"
    },
    {
      "id": 15,
      "start": 7231.0,
      "end": 7235.0,
      "formatted_start": "02:00:31.000",
      "formatted_end": "02:00:35.000",
      "text": "این زرده بروخونی مادر چیه؟"
    },
    {
      "id": 16,
      "start": 7235.0,
      "end": 7239.0,
      "formatted_start": "02:00:35.000",
      "formatted_end": "02:00:39.000",
      "text": "ببینید این زرده شانان چار روزه نسبتا زیاده تا بدنش"
    },
    {
      "id": 17,
      "start": 7239.0,
      "end": 7243.0,
      "formatted_start": "02:00:39.000",
      "formatted_end": "02:00:43.000",
      "text": "کشیده شده و این تا دو هفته بالا رونده است"
    },
    {
      "id": 18,
      "start": 7243.0,
      "end": 7247.0,
      "formatted_start": "02:00:43.000",
      "formatted_end": "02:00:47.000",
      "text": "و باید زودتر بیاد پایین چون زرده های بالا"
    },
    {
      "id": 19,
      "start": 7247.0,
      "end": 7249.0,
      "formatted_start": "02:00:47.000",
      "formatted_end": "02:00:49.000",
      "text": "نهایتا خوب میشن به مرور"
    },
    {
      "id": 20,
      "start": 7249.0,
      "end": 7251.0,
      "formatted_start": "02:00:49.000",
      "formatted_end": "02:00:51.000",
      "text": "ولی از نظر ذهنی"
    },
    {
      "id": 21,
      "start": 7251.0,
      "end": 7253.0,
      "formatted_start": "02:00:51.000",
      "formatted_end": "02:00:53.000",
      "text": "توی بدن میبینیم"
    },
    {
      "id": 22,
      "start": 7253.0,
      "end": 7255.0,
      "formatted_start": "02:00:53.000",
      "formatted_end": "02:00:55.000",
      "text": "توی ذهنی"
    },
    {
      "id": 23,
      "start": 7255.0,
      "end": 7257.0,
      "formatted_start": "02:00:55.000",
      "formatted_end": "02:00:57.000",
      "text": "عقب بوده از یعنی بچه ساده بشه"
    },
    {
      "id": 24,
      "start": 7257.0,
      "end": 7259.0,
      "formatted_start": "02:00:57.000",
      "formatted_end": "02:00:59.000",
      "text": "بچه ساده بشه"
    },
    {
      "id": 25,
      "start": 7259.0,
      "end": 7261.0,
      "formatted_start": "02:00:59.000",
      "formatted_end": "02:01:01.000",
      "text": "با رسوبات مغزی"
    },
    {
      "id": 26,
      "start": 7261.0,
      "end": 7263.0,
      "formatted_start": "02:01:01.000",
      "formatted_end": "02:01:03.000",
      "text": "رسوبات ذردی رو"
    },
    {
      "id": 27,
      "start": 7263.0,
      "end": 7265.0,
      "formatted_start": "02:01:03.000",
      "formatted_end": "02:01:05.000",
      "text": "مرز اثر میزنه"
    },
    {
      "id": 28,
      "start": 7265.0,
      "end": 7267.0,
      "formatted_start": "02:01:05.000",
      "formatted_end": "02:01:07.000",
      "text": "الان شما خوب موقع ها بودید"
    },
    {
      "id": 29,
      "start": 7267.0,
      "end": 7269.0,
      "formatted_start": "02:01:07.000",
      "formatted_end": "02:01:09.000",
      "text": "اون یه ذردی متوسطی داده"
    },
    {
      "id": 30,
      "start": 7269.0,
      "end": 7271.0,
      "formatted_start": "02:01:09.000",
      "formatted_end": "02:01:11.000",
      "text": "بادرش آن پول روگام نزده؟"
    },
    {
      "id": 31,
      "start": 7271.0,
      "end": 7273.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:13.000",
      "text": "بادرش آن پول روگام نزده؟"
    },
    {
      "id": 32,
      "start": 7273.0,
      "end": 7275.0,
      "formatted_start": "02:01:13.000",
      "formatted_end": "02:01:15.000",
      "text": "بادرش آن پول روگام نزده؟"
    },
    {
      "id": 33,
      "start": 7275.0,
      "end": 7276.0,
      "formatted_start": "02:01:15.000",
      "formatted_end": "02:01:16.000",
      "text": "نمیدونیم"
    },
    {
      "id": 34,
      "start": 7276.0,
      "end": 7277.0,
      "formatted_start": "02:01:16.000",
      "formatted_end": "02:01:17.000",
      "text": "تو این آرستان باز میزنه"
    },
    {
      "id": 35,
      "start": 7277.0,
      "end": 7278.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:18.000",
      "text": "نقدر"
    },
    {
      "id": 36,
      "start": 7278.0,
      "end": 7279.0,
      "formatted_start": "02:01:18.000",
      "formatted_end": "02:01:19.000",
      "text": "الان هم تب نداره"
    },
    {
      "id": 37,
      "start": 7279.0,
      "end": 7281.0,
      "formatted_start": "02:01:19.000",
      "formatted_end": "02:01:21.000",
      "text": "الان باز میزنم"
    },
    {
      "id": 38,
      "start": 7281.0,
      "end": 7282.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:22.000",
      "text": "دماهاش خوبه"
    },
    {
      "id": 39,
      "start": 7282.0,
      "end": 7284.0,
      "formatted_start": "02:01:22.000",
      "formatted_end": "02:01:24.000",
      "text": "ولی چون بیرون آوردین گرمه"
    },
    {
      "id": 40,
      "start": 7284.0,
      "end": 7286.0,
      "formatted_start": "02:01:24.000",
      "formatted_end": "02:01:26.000",
      "text": "بچه رو خونکتر نگردن"
    },
    {
      "id": 41,
      "start": 7286.0,
      "end": 7288.0,
      "formatted_start": "02:01:26.000",
      "formatted_end": "02:01:28.000",
      "text": "الان لخت هم باشه یکی نمیشه"
    },
    {
      "id": 42,
      "start": 7288.0,
      "end": 7290.0,
      "formatted_start": "02:01:28.000",
      "formatted_end": "02:01:30.000",
      "text": "چون هوا اینقدر گرمه"
    },
    {
      "id": 43,
      "start": 7290.0,
      "end": 7292.0,
      "formatted_start": "02:01:30.000",
      "formatted_end": "02:01:32.000",
      "text": "شما باید باید زیر"
    },
    {
      "id": 44,
      "start": 7293.0,
      "end": 7295.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:35.000",
      "text": "دماه اتاق اگه کلیر چیزی هست"
    },
    {
      "id": 45,
      "start": 7295.0,
      "end": 7297.0,
      "formatted_start": "02:01:35.000",
      "formatted_end": "02:01:37.000",
      "text": "باید بیسته هشت درجه بیسته هفت باشه"
    },
    {
      "id": 46,
      "start": 7297.0,
      "end": 7299.0,
      "formatted_start": "02:01:37.000",
      "formatted_end": "02:01:39.000",
      "text": "لخت هم باشه یک اتفاقی"
    },
    {
      "id": 47,
      "start": 7299.0,
      "end": 7300.0,
      "formatted_start": "02:01:39.000",
      "formatted_end": "02:01:40.000",
      "text": "نمیاخده"
    },
    {
      "id": 48,
      "start": 7300.0,
      "end": 7304.0,
      "formatted_start": "02:01:40.000",
      "formatted_end": "02:01:44.000",
      "text": "ببینید این الان تبشک خیلی چیز نیست اون نمیشه گفتم"
    },
    {
      "id": 49,
      "start": 7304.0,
      "end": 7307.0,
      "formatted_start": "02:01:44.000",
      "formatted_end": "02:01:47.000",
      "text": "مهم زردیشه که باید درمان میشه"
    },
    {
      "id": 50,
      "start": 7307.0,
      "end": 7309.0,
      "formatted_start": "02:01:47.000",
      "formatted_end": "02:01:49.000",
      "text": "زردیشه شما دو کار میخونید باید"
    },
    {
      "id": 51,
      "start": 7309.0,
      "end": 7312.0,
      "formatted_start": "02:01:49.000",
      "formatted_end": "02:01:52.000",
      "text": "یا بستری کنید دیمارستان زیر دستگاه"
    },
    {
      "id": 52,
      "start": 7312.0,
      "end": 7316.0,
      "formatted_start": "02:01:52.000",
      "formatted_end": "02:01:56.000",
      "text": "یا دستگاه ببرید خونه یه دو سه شب زیر دستگاه ببرید"
    },
    {
      "id": 53,
      "start": 7316.0,
      "end": 7318.0,
      "formatted_start": "02:01:56.000",
      "formatted_end": "02:01:58.000",
      "text": "این بیاد پایین سریعه برد"
    },
    {
      "id": 54,
      "start": 7318.0,
      "end": 7320.0,
      "formatted_start": "02:01:58.000",
      "formatted_end": "02:02:00.000",
      "text": "پرانی نشه این"
    },
    {
      "id": 55,
      "start": 7320.0,
      "end": 7325.0,
      "formatted_start": "02:02:00.000",
      "formatted_end": "02:02:05.000",
      "text": "اگه دستگاه چیزه به منشین بگید برای تون یه دو سه شب دستگاه بردن"
    },
    {
      "id": 56,
      "start": 7325.0,
      "end": 7328.46,
      "formatted_start": "02:02:05.000",
      "formatted_end": "02:02:08.460",
      "text": "یا می کردید اگر می خواهید بستری کنید، نامش رو می سنید بستری کنید"
    },
    {
      "id": 57,
      "start": 7328.46,
      "end": 7330.46,
      "formatted_start": "02:02:08.460",
      "formatted_end": "02:02:10.460",
      "text": "بستری کنید"
    },
    {
      "id": 58,
      "start": 7330.46,
      "end": 7332.46,
      "formatted_start": "02:02:10.460",
      "formatted_end": "02:02:12.460",
      "text": "دیوانستان"
    },
    {
      "id": 59,
      "start": 7332.46,
      "end": 7334.46,
      "formatted_start": "02:02:12.460",
      "formatted_end": "02:02:14.460",
      "text": "دیوانستان سخته"
    },
    {
      "id": 60,
      "start": 7334.46,
      "end": 7339.1,
      "formatted_start": "02:02:14.460",
      "formatted_end": "02:02:19.100",
      "text": "هم خونگیری می شود، هم بچه مادر هم عزیزی"
    },
    {
      "id": 61,
      "start": 7339.1,
      "end": 7341.1,
      "formatted_start": "02:02:19.100",
      "formatted_end": "02:02:21.100",
      "text": "همون راحت تر دست کنید"
    },
    {
      "id": 62,
      "start": 7341.1,
      "end": 7345.0,
      "formatted_start": "02:02:21.100",
      "formatted_end": "02:02:25.000",
      "text": "قابل ندارید، دست کنید 24 ساعتش 400"
    },
    {
      "id": 63,
      "start": 7345.0,
      "end": 7347.0,
      "formatted_start": "02:02:25.000",
      "formatted_end": "02:02:27.000",
      "text": "از این دو شبان و روز"
    },
    {
      "id": 64,
      "start": 7347.0,
      "end": 7349.0,
      "formatted_start": "02:02:27.000",
      "formatted_end": "02:02:29.000",
      "text": "دیگه آزمایشی ندارید، دست کنید"
    },
    {
      "id": 65,
      "start": 7349.0,
      "end": 7352.38,
      "formatted_start": "02:02:29.000",
      "formatted_end": "02:02:32.380",
      "text": "دست کنید، خوب خوب استفاده کنید"
    },
    {
      "id": 66,
      "start": 7352.38,
      "end": 7354.38,
      "formatted_start": "02:02:32.380",
      "formatted_end": "02:02:34.380",
      "text": "این حرف در همسایه ها رو گوش ندید"
    },
    {
      "id": 67,
      "start": 7354.38,
      "end": 7356.38,
      "formatted_start": "02:02:34.380",
      "formatted_end": "02:02:36.380",
      "text": "هرکی میاد یه حرف"
    },
    {
      "id": 68,
      "start": 7356.38,
      "end": 7358.38,
      "formatted_start": "02:02:36.380",
      "formatted_end": "02:02:38.380",
      "text": "هرکی یکی بگه ترنجوین بده"
    },
    {
      "id": 69,
      "start": 7358.38,
      "end": 7360.38,
      "formatted_start": "02:02:38.380",
      "formatted_end": "02:02:40.380",
      "text": "یکی بگه لانک مطرحی بذار"
    },
    {
      "id": 70,
      "start": 7360.38,
      "end": 7362.38,
      "formatted_start": "02:02:40.380",
      "formatted_end": "02:02:42.380",
      "text": "یکی میگه مادری زرجوبه نخوره"
    },
    {
      "id": 71,
      "start": 7362.38,
      "end": 7364.38,
      "formatted_start": "02:02:42.380",
      "formatted_end": "02:02:44.380",
      "text": "توخ و مرخ نخوره، کره نخوره"
    },
    {
      "id": 72,
      "start": 7364.38,
      "end": 7366.38,
      "formatted_start": "02:02:44.380",
      "formatted_end": "02:02:46.380",
      "text": "اینا هیچ ترسیبی ندارن"
    },
    {
      "id": 73,
      "start": 7366.38,
      "end": 7368.38,
      "formatted_start": "02:02:46.380",
      "formatted_end": "02:02:48.380",
      "text": "آره اینا خود درمانی میکنن"
    },
    {
      "id": 74,
      "start": 7368.38,
      "end": 7370.38,
      "formatted_start": "02:02:48.380",
      "formatted_end": "02:02:50.380",
      "text": "و بعد تولانی میکنن"
    },
    {
      "id": 75,
      "start": 7370.38,
      "end": 7372.38,
      "formatted_start": "02:02:50.380",
      "formatted_end": "02:02:52.380",
      "text": "یکی هم میگه اصلا سرد میسه"
    },
    {
      "id": 76,
      "start": 7372.38,
      "end": 7374.38,
      "formatted_start": "02:02:52.380",
      "formatted_end": "02:02:54.380",
      "text": "میخواد تو خوشحال میشه"
    },
    {
      "id": 77,
      "start": 7374.38,
      "end": 7376.38,
      "formatted_start": "02:02:54.380",
      "formatted_end": "02:02:56.380",
      "text": "میدونه زردا"
    },
    {
      "id": 78,
      "start": 7376.38,
      "end": 7378.38,
      "formatted_start": "02:02:56.380",
      "formatted_end": "02:02:58.380",
      "text": "میگه مادرش نارهت نشد"
    },
    {
      "id": 79,
      "start": 7378.38,
      "end": 7383.38,
      "formatted_start": "02:02:58.380",
      "formatted_end": "02:03:03.380",
      "text": "اینه که شما الان خوشموقار بردید درمان شروع کنید"
    },
    {
      "id": 80,
      "start": 7383.38,
      "end": 7385.38,
      "formatted_start": "02:03:03.380",
      "formatted_end": "02:03:05.380",
      "text": "دارون هم نیست"
    },
    {
      "id": 81,
      "start": 7385.38,
      "end": 7386.38,
      "formatted_start": "02:03:05.380",
      "formatted_end": "02:03:06.380",
      "text": "بیچه نیست"
    },
    {
      "id": 82,
      "start": 7386.38,
      "end": 7387.38,
      "formatted_start": "02:03:06.380",
      "formatted_end": "02:03:07.380",
      "text": "فقط دستگاه بردید"
    },
    {
      "id": 83,
      "start": 7387.38,
      "end": 7389.38,
      "formatted_start": "02:03:07.380",
      "formatted_end": "02:03:09.380",
      "text": "خمسنگی دستگاه داریم؟"
    },
    {
      "id": 84,
      "start": 7389.38,
      "end": 7392.38,
      "formatted_start": "02:03:09.380",
      "formatted_end": "02:03:12.380",
      "text": "۴۸ ساعت، ۷۲ ساعت دستگاه بشونید"
    },
    {
      "id": 85,
      "start": 7392.38,
      "end": 7394.38,
      "formatted_start": "02:03:12.380",
      "formatted_end": "02:03:14.380",
      "text": "هر چهار خوب شاست"
    },
    {
      "id": 86,
      "start": 7394.38,
      "end": 7398.38,
      "formatted_start": "02:03:14.380",
      "formatted_end": "02:03:18.380",
      "text": "دمای اتاق رو ۲۸ درجه میگردارید"
    },
    {
      "id": 87,
      "start": 7398.38,
      "end": 7401.38,
      "formatted_start": "02:03:18.380",
      "formatted_end": "02:03:21.380",
      "text": "خب، شیر پیشتر بشه بده"
    },
    {
      "id": 88,
      "start": 7401.38,
      "end": 7404.38,
      "formatted_start": "02:03:21.380",
      "formatted_end": "02:03:24.380",
      "text": "هر چند میتونید زیر دستگاه بذارید"
    },
    {
      "id": 89,
      "start": 7404.38,
      "end": 7410.38,
      "formatted_start": "02:03:24.380",
      "formatted_end": "02:03:30.380",
      "text": "افراد موشیم آموزش کنیم"
    },
    {
      "id": 90,
      "start": 7410.38,
      "end": 7418.38,
      "formatted_start": "02:03:30.380",
      "formatted_end": "02:03:38.380",
      "text": "با راقبش باشید بچه خیلی خوبی خدا بهتون داده"
    },
    {
      "id": 91,
      "start": 7418.38,
      "end": 7421.38,
      "formatted_start": "02:03:38.380",
      "formatted_end": "02:03:41.380",
      "text": "خدا افزش کنه"
    },
    {
      "id": 92,
      "start": 7421.38,
      "end": 7426.38,
      "formatted_start": "02:03:41.380",
      "formatted_end": "02:03:46.380",
      "text": "خواهش میکنم زندگی باشید"
    },
    {
      "id": 93,
      "start": 7426.38,
      "end": 7428.38,
      "formatted_start": "02:03:46.380",
      "formatted_end": "02:03:48.380",
      "text": "خوضاییم"
    },
    {
      "id": 94,
      "start": 7428.38,
      "end": 7430.38,
      "formatted_start": "02:03:48.380",
      "formatted_end": "02:03:50.380",
      "text": "اما سمی رو دستگاه هم تخفیش بده بشو"
    },
    {
      "id": 95,
      "start": 7430.38,
      "end": 7432.38,
      "formatted_start": "02:03:50.380",
      "formatted_end": "02:03:52.380",
      "text": "سر باز باشید"
    },
    {
      "id": 96,
      "start": 7432.38,
      "end": 7434.38,
      "formatted_start": "02:03:52.380",
      "formatted_end": "02:03:54.380",
      "text": "خوش باشید"
    },
    {
      "id": 97,
      "start": 7458.38,
      "end": 7488.38,
      "formatted_start": "02:04:18.380",
      "formatted_end": "02:04:48.380",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 98,
      "start": 7488.38,
      "end": 7499.38,
      "formatted_start": "02:04:48.380",
      "formatted_end": "02:04:59.380",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}