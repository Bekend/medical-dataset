      "end": 2837.4,
      "formatted_start": "00:47:15.400",
      "formatted_end": "00:47:17.400",
      "text": "حدیثه نمیشه"
    },
    {
      "id": 29,
      "start": 2837.4,
      "end": 2839.4,
      "formatted_start": "00:47:17.400",
      "formatted_end": "00:47:19.400",
      "text": "حالا شما خوبه؟"
    },
    {
      "id": 30,
      "start": 2839.4,
      "end": 2841.4,
      "formatted_start": "00:47:19.400",
      "formatted_end": "00:47:21.400",
      "text": "درست نمیشه"
    },
    {
      "id": 31,
      "start": 2841.4,
      "end": 2843.4,
      "formatted_start": "00:47:21.400",
      "formatted_end": "00:47:23.400",
      "text": "بچه تو دستگاه موهرم بود و گذاشت"
    },
    {
      "id": 32,
      "start": 2843.4,
      "end": 2845.4,
      "formatted_start": "00:47:23.400",
      "formatted_end": "00:47:25.400",
      "text": "خیلی خوب شد"
    },
    {
      "id": 33,
      "start": 2845.4,
      "end": 2847.4,
      "formatted_start": "00:47:25.400",
      "formatted_end": "00:47:27.400",
      "text": "سفید شد"
    },
    {
      "id": 34,
      "start": 2847.4,
      "end": 2849.4,
      "formatted_start": "00:47:27.400",
      "formatted_end": "00:47:29.400",
      "text": "امروز از زور دیگه کردی"
    },
    {
      "id": 35,
      "start": 2849.4,
      "end": 2851.4,
      "formatted_start": "00:47:29.400",
      "formatted_end": "00:47:31.400",
      "text": "امروز زور داده کردی"
    },
    {
      "id": 36,
      "start": 2851.4,
      "end": 2853.4,
      "formatted_start": "00:47:31.400",
      "formatted_end": "00:47:33.400",
      "text": "تا الان اوکی بود"
    },
    {
      "id": 37,
      "start": 2853.4,
      "end": 2855.4,
      "formatted_start": "00:47:33.400",
      "formatted_end": "00:47:35.400",
      "text": "الان باید نیم سری سرد"
    },
    {
      "id": 38,
      "start": 2855.4,
      "end": 2857.4,
      "formatted_start": "00:47:35.400",
      "formatted_end": "00:47:37.400",
      "text": "دوباره اون حالتها برنش کنی"
    },
    {
      "id": 39,
      "start": 2857.4,
      "end": 2859.4,
      "formatted_start": "00:47:37.400",
      "formatted_end": "00:47:39.400",
      "text": "زخ شده"
    },
    {
      "id": 40,
      "start": 2859.4,
      "end": 2861.4,
      "formatted_start": "00:47:39.400",
      "formatted_end": "00:47:41.400",
      "text": "دستگاه که بیداری اثر سطی داره"
    },
    {
      "id": 41,
      "start": 2861.4,
      "end": 2863.4,
      "formatted_start": "00:47:41.400",
      "formatted_end": "00:47:43.400",
      "text": "از پود شروع میکنه"
    },
    {
      "id": 42,
      "start": 2863.4,
      "end": 2871.4,
      "formatted_start": "00:47:43.400",
      "formatted_end": "00:47:51.400",
      "text": "به قمخ خب بعد چند ساعت که اگه خاموش کنی اگه زردی شدید باشه یا خوب نزداشته باشن"
    },
    {
      "id": 43,
      "start": 2871.4,
      "end": 2882.4,
      "formatted_start": "00:47:51.400",
      "formatted_end": "00:48:02.400",
      "text": "بباره این میبین زرد شد خب ولی خفیرش ایراد نداره شدیدش شدیدتر اگه باشه یعنی زردی توند باشه"
    },
    {
      "id": 44,
      "start": 2882.4,
      "end": 2889.4,
      "formatted_start": "00:48:02.400",
      "formatted_end": "00:48:09.400",
      "text": "میشونه اینه که باید پیشتر بزارید یعنی مثلا سه روز کمه و بعد ما پنج روز شیش روز تا یه هفته هم میزاریم"
    },
    {
      "id": 45,
      "start": 2889.4,
      "end": 2891.4,
      "formatted_start": "00:48:09.400",
      "formatted_end": "00:48:11.400",
      "text": "سلام بود؟ سلام بود"
    },
    {
      "id": 46,
      "start": 2891.4,
      "end": 2893.4,
      "formatted_start": "00:48:11.400",
      "formatted_end": "00:48:13.400",
      "text": "سلام کن"
    },
    {
      "id": 47,
      "start": 2893.4,
      "end": 2897.4,
      "formatted_start": "00:48:13.400",
      "formatted_end": "00:48:17.400",
      "text": "برخونی مادش منفی بود یا؟"
    },
    {
      "id": 48,
      "start": 2897.4,
      "end": 2903.4,
      "formatted_start": "00:48:17.400",
      "formatted_end": "00:48:23.400",
      "text": "اونها ناسازگاری برخونی متاسفانه تا یک ماه بخش دو هفته اول خیلی وحشت میکرده"
    },
    {
      "id": 49,
      "start": 2903.4,
      "end": 2905.4,
      "formatted_start": "00:48:23.400",
      "formatted_end": "00:48:25.400",
      "text": "الان خیلی خوب شده"
    },
    {
      "id": 50,
      "start": 2905.4,
      "end": 2907.4,
      "formatted_start": "00:48:25.400",
      "formatted_end": "00:48:27.400",
      "text": "الان ترچه کجای؟"
    },
    {
      "id": 51,
      "start": 2907.4,
      "end": 2909.4,
      "formatted_start": "00:48:27.400",
      "formatted_end": "00:48:29.400",
      "text": "توی ماشین پایینه دیگه"
    },
    {
      "id": 52,
      "start": 2909.4,
      "end": 2911.4,
      "formatted_start": "00:48:29.400",
      "formatted_end": "00:48:31.400",
      "text": "خب ببینم بهتر"
    },
    {
      "id": 53,
      "start": 2911.4,
      "end": 2913.4,
      "formatted_start": "00:48:31.400",
      "formatted_end": "00:48:33.400",
      "text": "اگر میادیم اون چیز که ما میبینیم با شما فرق داریم"
    },
    {
      "id": 54,
      "start": 2913.4,
      "end": 2917.4,
      "formatted_start": "00:48:33.400",
      "formatted_end": "00:48:37.400",
      "text": "شما شاید یکی کچی که وحشت کنیم شاید ببینم"
    },
    {
      "id": 55,
      "start": 2917.4,
      "end": 2921.06,
      "formatted_start": "00:48:37.400",
      "formatted_end": "00:48:41.060",
      "text": "شاید هم بردر شما ببینید چیزی ما بگیم مهمی نداریم"
    },
    {
      "id": 56,
      "start": 2921.06,
      "end": 2923.78,
      "formatted_start": "00:48:41.060",
      "formatted_end": "00:48:43.780",
      "text": "ببینم بهتره ببینید سوسیم گیله بیشه"
    },
    {
      "id": 57,
      "start": 2923.78,
      "end": 2927.04,
      "formatted_start": "00:48:43.780",
      "formatted_end": "00:48:47.040",
      "text": "خب این نزدیکی نمیشه دوباره اون روادش"
    },
    {
      "id": 58,
      "start": 2927.04,
      "end": 2929.04,
      "formatted_start": "00:48:47.040",
      "formatted_end": "00:48:49.040",
      "text": "ببینید امارات دو هفته بالا میره"
    },
    {
      "id": 59,
      "start": 2929.04,
      "end": 2932.04,
      "formatted_start": "00:48:49.040",
      "formatted_end": "00:48:52.040",
      "text": "بعد از دو هفته این رو باید میسه"
    },
    {
      "id": 60,
      "start": 2932.04,
      "end": 2934.04,
      "formatted_start": "00:48:52.040",
      "formatted_end": "00:48:54.040",
      "text": "بعد از چهار هفته دومتره میاد پیدن"
    },
    {
      "id": 61,
      "start": 2934.04,
      "end": 2935.04,
      "formatted_start": "00:48:54.040",
      "formatted_end": "00:48:55.040",
      "text": "آهان"
    },
    {
      "id": 62,
      "start": 2935.04,
      "end": 2935.76,
      "formatted_start": "00:48:55.040",
      "formatted_end": "00:48:55.760",
      "text": "ولی؟"
    },
    {
      "id": 63,
      "start": 2935.76,
      "end": 2937.16,
      "formatted_start": "00:48:55.760",
      "formatted_end": "00:48:57.160",
      "text": "ولی رواد بزرگی بیشتر بشه"
    },
    {
      "id": 64,
      "start": 2937.16,
      "end": 2939.92,
      "formatted_start": "00:48:57.160",
      "formatted_end": "00:48:59.920",
      "text": "آفرین اگر پیشتر بشه آسیب های ذهنی بیداره"
    },
    {
      "id": 65,
      "start": 2939.92,
      "end": 2941.92,
      "formatted_start": "00:48:59.920",
      "formatted_end": "00:49:01.920",
      "text": "در اینجا همین را دستگاه می کنید"
    },
    {
      "id": 66,
      "start": 2941.92,
      "end": 2943.92,
      "formatted_start": "00:49:01.920",
      "formatted_end": "00:49:03.920",
      "text": "آفرین بیاید پایین از این"
    },
    {
      "id": 67,
      "start": 2943.92,
      "end": 2945.92,
      "formatted_start": "00:49:03.920",
      "formatted_end": "00:49:05.920",
      "text": "حالا اگر صورت زرد باشه مهم نیست"
    },
    {
      "id": 68,
      "start": 2945.92,
      "end": 2947.92,
      "formatted_start": "00:49:05.920",
      "formatted_end": "00:49:07.920",
      "text": "ولی سطح بدن"
    },
    {
      "id": 69,
      "start": 2947.92,
      "end": 2949.92,
      "formatted_start": "00:49:07.920",
      "formatted_end": "00:49:09.920",
      "text": "نباید زرد بشه"
    },
    {
      "id": 70,
      "start": 2949.92,
      "end": 2951.92,
      "formatted_start": "00:49:09.920",
      "formatted_end": "00:49:11.920",
      "text": "ببینید از اینجا خوب میشه میاد برای"
    },
    {
      "id": 71,
      "start": 2951.92,
      "end": 2953.92,
      "formatted_start": "00:49:11.920",
      "formatted_end": "00:49:13.920",
      "text": "پاها خوب میشه"
    },
    {
      "id": 72,
      "start": 2953.92,
      "end": 2955.92,
      "formatted_start": "00:49:13.920",
      "formatted_end": "00:49:15.920",
      "text": "بعد بدن خوب میشه"
    },
    {
      "id": 73,
      "start": 2955.92,
      "end": 2957.92,
      "formatted_start": "00:49:15.920",
      "formatted_end": "00:49:17.920",
      "text": "اگر فقط صورت مهم نیست"
    },
    {
      "id": 74,
      "start": 2957.92,
      "end": 2959.92,
      "formatted_start": "00:49:17.920",
      "formatted_end": "00:49:19.920",
      "text": "آقای نروزی آره"
    },
    {
      "id": 75,
      "start": 2959.92,
      "end": 2961.92,
      "formatted_start": "00:49:19.920",
      "formatted_end": "00:49:21.920",
      "text": "اگر فقط صورت مهم نیست"
    },
    {
      "id": 76,
      "start": 2961.92,
      "end": 2963.92,
      "formatted_start": "00:49:21.920",
      "formatted_end": "00:49:23.920",
      "text": "اگر شکم می سرده"
    },
    {
      "id": 77,
      "start": 2963.92,
      "end": 2965.92,
      "formatted_start": "00:49:23.920",
      "formatted_end": "00:49:25.920",
      "text": "توسطی میکنم دستگاه را دوباره بزنیم"
    },
    {
      "id": 78,
      "start": 2965.92,
      "end": 2967.92,
      "formatted_start": "00:49:25.920",
      "formatted_end": "00:49:27.920",
      "text": "اگر شکم هست"
    },
    {
      "id": 79,
      "start": 2967.92,
      "end": 2969.92,
      "formatted_start": "00:49:27.920",
      "formatted_end": "00:49:29.920",
      "text": "اینو حواستون باشین"
    },
    {
      "id": 80,
      "start": 2969.92,
      "end": 2973.92,
      "formatted_start": "00:49:29.920",
      "formatted_end": "00:49:33.920",
      "text": "چون مادر اویه این اویه گروه خونه نامون است"
    },
    {
      "id": 81,
      "start": 2973.92,
      "end": 2975.92,
      "formatted_start": "00:49:33.920",
      "formatted_end": "00:49:35.920",
      "text": "به شرح وضعیت"
    },
    {
      "id": 82,
      "start": 2975.92,
      "end": 2977.92,
      "formatted_start": "00:49:35.920",
      "formatted_end": "00:49:37.920",
      "text": "بعضی هستن بخسری میشن"
    },
    {
      "id": 83,
      "start": 2977.92,
      "end": 2979.92,
      "formatted_start": "00:49:37.920",
      "formatted_end": "00:49:39.920",
      "text": "بعضی ها طویز خون میشن"
    },
    {
      "id": 84,
      "start": 2979.92,
      "end": 2981.92,
      "formatted_start": "00:49:39.920",
      "formatted_end": "00:49:41.920",
      "text": "اوینا"
    },
    {
      "id": 85,
      "start": 2981.92,
      "end": 2983.92,
      "formatted_start": "00:49:41.920",
      "formatted_end": "00:49:43.920",
      "text": "طویز خون نیست"
    },
    {
      "id": 86,
      "start": 2983.92,
      "end": 2985.92,
      "formatted_start": "00:49:43.920",
      "formatted_end": "00:49:45.920",
      "text": "میرو خودتون اگه بینی فقط"
    },
    {
      "id": 87,
      "start": 2985.92,
      "end": 2987.92,
      "formatted_start": "00:49:45.920",
      "formatted_end": "00:49:47.920",
      "text": "صورت خوب نیاز نیست"
    },
    {
      "id": 88,
      "start": 2987.92,
      "end": 2989.92,
      "formatted_start": "00:49:47.920",
      "formatted_end": "00:49:49.920",
      "text": "دیگه بدن هم هست"
    },
    {
      "id": 89,
      "start": 2989.92,
      "end": 2991.92,
      "formatted_start": "00:49:49.920",
      "formatted_end": "00:49:51.920",
      "text": "یا بیا من ببینم یا دستگاه رو ببرید"
    },
    {
      "id": 90,
      "start": 2991.92,
      "end": 2993.92,
      "formatted_start": "00:49:51.920",
      "formatted_end": "00:49:53.920",
      "text": "باشید"
    },
    {
      "id": 91,
      "start": 2993.92,
      "end": 2995.92,
      "formatted_start": "00:49:53.920",
      "formatted_end": "00:49:55.920",
      "text": "بازارید بشین"
    },
    {
      "id": 92,
      "start": 2995.92,
      "end": 3000.0,
      "formatted_start": "00:49:55.920",
      "formatted_end": "00:50:00.000",
      "text": "بگو شما در اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید"
    }
  ],
