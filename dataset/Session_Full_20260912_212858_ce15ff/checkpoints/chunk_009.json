  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2713.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:13.000",
      "text": "از اینجا باید بردارید که این بچه برد ماشکلی که پیش نمی آمید یک موقعش."
    },
    {
      "id": 1,
      "start": 2713.0,
      "end": 2715.0,
      "formatted_start": "00:45:13.000",
      "formatted_end": "00:45:15.000",
      "text": "شکر نکنید و فکر هم نکنید."
    },
    {
      "id": 2,
      "start": 2715.0,
      "end": 2718.0,
      "formatted_start": "00:45:15.000",
      "formatted_end": "00:45:18.000",
      "text": "این چیزی هست که کت خدا شناسته."
    },
    {
      "id": 3,
      "start": 2718.0,
      "end": 2722.0,
      "formatted_start": "00:45:18.000",
      "formatted_end": "00:45:22.000",
      "text": "یعنی با چشم هم که می بینید، متوجه می کنید اضافه باید بردارید."
    },
    {
      "id": 4,
      "start": 2722.0,
      "end": 2723.0,
      "formatted_start": "00:45:22.000",
      "formatted_end": "00:45:23.000",
      "text": "نه، می دونیم، نه، می گوییم."
    },
    {
      "id": 5,
      "start": 2723.0,
      "end": 2729.0,
      "formatted_start": "00:45:23.000",
      "formatted_end": "00:45:29.000",
      "text": "دومی که ما الان بر می داریم، پانسوان می کنیم، شنبه می آرید، دست نمی زنید."
    },
    {
      "id": 6,
      "start": 2729.0,
      "end": 2730.3,
      "formatted_start": "00:45:29.000",
      "formatted_end": "00:45:30.300",
      "text": "هیچ کاری هم بازه نیست"
    },
    {
      "id": 7,
      "start": 2730.3,
      "end": 2734.14,
      "formatted_start": "00:45:30.300",
      "formatted_end": "00:45:34.140",
      "text": "شنبه میادید من بر میدارم خودتونم میبینید"
    },
    {
      "id": 8,
      "start": 2734.14,
      "end": 2735.76,
      "formatted_start": "00:45:34.140",
      "formatted_end": "00:45:35.760",
      "text": "خوب؟ این از این"
    },
    {
      "id": 9,
      "start": 2735.76,
      "end": 2739.48,
      "formatted_start": "00:45:35.760",
      "formatted_end": "00:45:39.480",
      "text": "بعد یه شروط هم برای نفت و دلتی چشم روشتم بهش بده"
    },
    {
      "id": 10,
      "start": 2739.48,
      "end": 2741.0,
      "formatted_start": "00:45:39.480",
      "formatted_end": "00:45:41.000",
      "text": "توی دمانه؟"
    },
    {
      "id": 11,
      "start": 2741.0,
      "end": 2741.72,
      "formatted_start": "00:45:41.000",
      "formatted_end": "00:45:41.720",
      "text": "توی دمانه؟"
    },
    {
      "id": 12,
      "start": 2741.72,
      "end": 2742.76,
      "formatted_start": "00:45:41.720",
      "formatted_end": "00:45:42.760",
      "text": "ته ته هم"
    },
    {
      "id": 13,
      "start": 2742.76,
      "end": 2744.4,
      "formatted_start": "00:45:42.760",
      "formatted_end": "00:45:44.400",
      "text": "اینو بگیر"
    },
    {
      "id": 14,
      "start": 2744.4,
      "end": 2745.4,
      "formatted_start": "00:45:44.400",
      "formatted_end": "00:45:45.400",
