      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6940.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6960.0,
      "end": 6981.0,
      "formatted_start": "01:56:00.000",
      "formatted_end": "01:56:21.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 6981.0,
      "end": 6983.0,
      "formatted_start": "01:56:21.000",
      "formatted_end": "01:56:23.000",
      "text": "کنسانی تا هشت نیستی ما"
    },
    {
      "id": 4,
      "start": 6991.6,
      "end": 6993.6,
      "formatted_start": "01:56:31.600",
      "formatted_end": "01:56:33.600",
      "text": "تا هفته روپ گیشتن نیستی ما"
    },
    {
      "id": 5,
      "start": 6993.6,
      "end": 6994.6,
      "formatted_start": "01:56:33.600",
      "formatted_end": "01:56:34.600",
      "text": "باشیم"
    },
    {
      "id": 6,
      "start": 7011.0,
      "end": 7039.0,
      "formatted_start": "01:56:51.000",
      "formatted_end": "01:57:19.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 7041.0,
      "end": 7070.98,
      "formatted_start": "01:57:21.000",
      "formatted_end": "01:57:50.980",
      "text": "موسیقی در موسیقی دیگر"
    },
    {
      "id": 8,
      "start": 7071.0,
      "end": 7099.0,
      "formatted_start": "01:57:51.000",
      "formatted_end": "01:58:19.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 7101.0,
      "end": 7129.0,
      "formatted_start": "01:58:21.000",
      "formatted_end": "01:58:49.000",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 7129.0,
      "end": 7131.0,
      "formatted_start": "01:58:49.000",
      "formatted_end": "01:58:51.000",
      "text": "دو نفر بزنمت بشن"
    },
    {
      "id": 11,
      "start": 7131.0,
      "end": 7133.0,
      "formatted_start": "01:58:51.000",
      "formatted_end": "01:58:53.000",
      "text": "بفهم"
    },
    {
      "id": 12,
      "start": 7133.0,
      "end": 7135.0,
      "formatted_start": "01:58:53.000",
      "formatted_end": "01:58:55.000",
      "text": "بفهم"
    },
    {
      "id": 13,
      "start": 7135.0,
      "end": 7137.0,
      "formatted_start": "01:58:55.000",
      "formatted_end": "01:58:57.000",
      "text": "سلام جنما خود شما خوبه"
    },
    {
      "id": 14,
      "start": 7137.0,
      "end": 7139.0,
      "formatted_start": "01:58:57.000",
      "formatted_end": "01:58:59.000",
      "text": "دو نفر بزنمت بشن"
    },
    {
      "id": 15,
      "start": 7139.0,
      "end": 7141.0,
      "formatted_start": "01:58:59.000",
      "formatted_end": "01:59:01.000",
      "text": "بعد"
    },
    {
      "id": 16,
      "start": 7141.0,
      "end": 7143.0,
      "formatted_start": "01:59:01.000",
      "formatted_end": "01:59:03.000",
      "text": "بشن"
    },
    {
      "id": 17,
      "start": 7143.0,
      "end": 7145.0,
      "formatted_start": "01:59:03.000",
      "formatted_end": "01:59:05.000",
      "text": "خب خانم دروی"
    },
    {
      "id": 18,
      "start": 7145.0,
      "end": 7147.0,
      "formatted_start": "01:59:05.000",
      "formatted_end": "01:59:07.000",
      "text": "چی شده باشم؟"
    },
    {
      "id": 19,
      "start": 7147.0,
      "end": 7149.0,
      "formatted_start": "01:59:07.000",
      "formatted_end": "01:59:09.000",
      "text": "پد دارم"
    },
    {
      "id": 20,
      "start": 7149.0,
      "end": 7151.0,
      "formatted_start": "01:59:09.000",
      "formatted_end": "01:59:11.000",
      "text": "پد کرده"
    },
    {
      "id": 21,
      "start": 7151.0,
      "end": 7153.0,
      "formatted_start": "01:59:11.000",
      "formatted_end": "01:59:13.000",
      "text": "سن بچه چقدر ده؟"
    },
    {
      "id": 22,
      "start": 7153.0,
      "end": 7155.0,
      "formatted_start": "01:59:13.000",
      "formatted_end": "01:59:15.000",
      "text": "چه روزه"
    },
    {
      "id": 23,
      "start": 7155.0,
      "end": 7157.0,
      "formatted_start": "01:59:15.000",
      "formatted_end": "01:59:17.000",
      "text": "چهار روزه است"
    },
    {
      "id": 24,
      "start": 7157.0,
      "end": 7161.0,
      "formatted_start": "01:59:17.000",
      "formatted_end": "01:59:21.000",
      "text": "بعد میبینید که خیلی گرم نبوده"
    },
    {
      "id": 25,
      "start": 7161.0,
      "end": 7163.0,
      "formatted_start": "01:59:21.000",
      "formatted_end": "01:59:23.000",
      "text": "گرم"
    },
    {
      "id": 26,
      "start": 7163.0,
      "end": 7165.0,
      "formatted_start": "01:59:23.000",
      "formatted_end": "01:59:25.000",
      "text": "چیز گرم نبوده زیاد دلوقت بشنه"
    },
    {
      "id": 27,
      "start": 7165.0,
      "end": 7168.0,
      "formatted_start": "01:59:25.000",
      "formatted_end": "01:59:28.000",
      "text": "خب دو حالت هست ها بیداروید"
    },
    {
      "id": 28,
      "start": 7168.0,
      "end": 7170.0,
      "formatted_start": "01:59:28.000",
      "formatted_end": "01:59:30.000",
      "text": "یه موقع از گرمای محیط زیاده"
    },
    {
      "id": 29,
      "start": 7170.0,
      "end": 7172.0,
      "formatted_start": "01:59:30.000",
      "formatted_end": "01:59:32.000",
      "text": "دست میزنید بچه داغه"
    },
    {
      "id": 30,
      "start": 7172.0,
      "end": 7174.0,
      "formatted_start": "01:59:32.000",
      "formatted_end": "01:59:34.000",
      "text": "بعد فکر میکنید طبه"
    },
    {
      "id": 31,
      "start": 7174.0,
      "end": 7176.0,
      "formatted_start": "01:59:34.000",
      "formatted_end": "01:59:36.000",
      "text": "تو این صورت باید"
    },
    {
      "id": 32,
      "start": 7176.0,
      "end": 7178.0,
      "formatted_start": "01:59:36.000",
      "formatted_end": "01:59:38.000",
      "text": "در واسه بچه رو کم کنید"
    },
    {
      "id": 33,
      "start": 7178.0,
      "end": 7180.0,
      "formatted_start": "01:59:38.000",
      "formatted_end": "01:59:40.000",
      "text": "لغت کنید کلی این چیزی پنکه روشن کنید"
    },
    {
      "id": 34,
      "start": 7180.0,
      "end": 7182.0,
      "formatted_start": "01:59:40.000",
      "formatted_end": "01:59:42.000",
      "text": "یه نیم ساعت بگذاره"
    },
    {
      "id": 35,
      "start": 7182.0,
      "end": 7184.0,
      "formatted_start": "01:59:42.000",
      "formatted_end": "01:59:44.000",
      "text": "بعد دو مرتبه بچه رو دست بزنید"
    },
    {
      "id": 36,
      "start": 7184.0,
      "end": 7186.0,
      "formatted_start": "01:59:44.000",
      "formatted_end": "01:59:46.000",
      "text": "دست دارید که داقه یا سخت"
    },
    {
      "id": 37,
      "start": 7186.0,
      "end": 7188.0,
      "formatted_start": "01:59:46.000",
      "formatted_end": "01:59:48.000",
      "text": "اگر بچه زرد شد از گرمایی"
    },
    {
      "id": 38,
      "start": 7188.0,
      "end": 7192.0,
      "formatted_start": "01:59:48.000",
      "formatted_end": "01:59:52.000",
      "text": "ولی اگر بچه تب داشته باشه از درون های گرمه"
    },
    {
      "id": 39,
      "start": 7192.0,
      "end": 7194.0,
      "formatted_start": "01:59:52.000",
      "formatted_end": "01:59:54.000",
      "text": "تغییری نمی کنه"
    },
    {
      "id": 40,
      "start": 7194.0,
      "end": 7196.0,
      "formatted_start": "01:59:54.000",
      "formatted_end": "01:59:56.000",
      "text": "چون تب تو نوزاد خیلی مهمه"
    },
    {
      "id": 41,
      "start": 7196.0,
      "end": 7200.0,
      "formatted_start": "01:59:56.000",
      "formatted_end": "02:00:00.000",
      "text": "اگر تب باشه باید بستری بشه این آن فرس"
    }
  ],
  "status": "completed"
}