    },
    {
      "id": 3,
      "start": 6080.0,
      "end": 6109.0,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:49.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 6109.0,
      "end": 6111.0,
      "formatted_start": "01:41:49.000",
      "formatted_end": "01:41:51.000",
      "text": "سلام و دلوت"
    },
    {
      "id": 5,
      "start": 6111.0,
      "end": 6112.2,
      "formatted_start": "01:41:51.000",
      "formatted_end": "01:41:52.200",
      "text": "سلام خوب هستیم"
    },
    {
      "id": 6,
      "start": 6112.2,
      "end": 6113.24,
      "formatted_start": "01:41:52.200",
      "formatted_end": "01:41:53.240",
      "text": "قربونش بشم"
    },
    {
      "id": 7,
      "start": 6113.24,
      "end": 6114.76,
      "formatted_start": "01:41:53.240",
      "formatted_end": "01:41:54.760",
      "text": "دنده باشی"
    },
    {
      "id": 8,
      "start": 6114.76,
      "end": 6115.24,
      "formatted_start": "01:41:54.760",
      "formatted_end": "01:41:55.240",
      "text": "خواهش میکنم"
    },
    {
      "id": 9,
      "start": 6115.24,
      "end": 6118.2,
      "formatted_start": "01:41:55.240",
      "formatted_end": "01:41:58.200",
      "text": "با زحمتهای ما زحمت افتادی"
    },
    {
      "id": 10,
      "start": 6118.2,
      "end": 6119.88,
      "formatted_start": "01:41:58.200",
      "formatted_end": "01:41:59.880",
      "text": "آره راضی نمیدونیم"
    },
    {
      "id": 11,
      "start": 6119.88,
      "end": 6120.84,
      "formatted_start": "01:41:59.880",
      "formatted_end": "01:42:00.840",
      "text": "خواهش میکنم"
    },
    {
      "id": 12,
      "start": 6120.84,
      "end": 6122.12,
      "formatted_start": "01:42:00.840",
      "formatted_end": "01:42:02.120",
      "text": "دفتر مطمئنم"
    },
    {
      "id": 13,
      "start": 6122.12,
      "end": 6125.56,
      "formatted_start": "01:42:02.120",
      "formatted_end": "01:42:05.560",
      "text": "جانم"
    },
    {
      "id": 14,
      "start": 6125.56,
      "end": 6130.52,
      "formatted_start": "01:42:05.560",
      "formatted_end": "01:42:10.520",
      "text": "ما تقریبا بعد یه تقریبا هفت و روپ دیگه"
    },
    {
      "id": 15,
      "start": 6130.52,
      "end": 6133.0,
      "formatted_start": "01:42:10.520",
      "formatted_end": "01:42:13.000",
      "text": "یه نیم سال چند دقیقه دیگه"
    },
    {
      "id": 16,
      "start": 6133.0,
      "end": 6133.88,
      "formatted_start": "01:42:13.000",
      "formatted_end": "01:42:13.880",
      "text": "آره آره"
    },
    {
      "id": 17,
      "start": 6133.88,
      "end": 6138.84,
      "formatted_start": "01:42:13.880",
      "formatted_end": "01:42:18.840",
      "text": "حالا ما به طرف فارسیان که افتادیم"
    },
    {
      "id": 18,
      "start": 6138.84,
      "end": 6140.84,
      "formatted_start": "01:42:18.840",
      "formatted_end": "01:42:20.840",
      "text": "برات زنگ می‌زنم، خوب؟"
    },
    {
      "id": 19,
      "start": 6140.84,
      "end": 6144.84,
      "formatted_start": "01:42:20.840",
      "formatted_end": "01:42:24.840",
      "text": "باشه، مثلا تو بالیکش وقت این فارسیان"
    },
    {
      "id": 20,
      "start": 6144.84,
      "end": 6146.84,
      "formatted_start": "01:42:24.840",
      "formatted_end": "01:42:26.840",
      "text": "چرا تو فارسیان رفتیدی، به زنگ می‌زن"
    },
    {
      "id": 21,
      "start": 6146.84,
      "end": 6148.84,
      "formatted_start": "01:42:26.840",
      "formatted_end": "01:42:28.840",
      "text": "باشه، مرسی، قربانت"
    },
    {
      "id": 22,
      "start": 6148.84,
      "end": 6151.84,
      "formatted_start": "01:42:28.840",
      "formatted_end": "01:42:31.840",
      "text": "چیزی لازمه بگیرم، اگر... آم؟"
    },
    {
      "id": 23,
      "start": 6151.84,
      "end": 6153.84,
      "formatted_start": "01:42:31.840",
      "formatted_end": "01:42:33.840",
      "text": "تاروخ نکنید"
    },
    {
      "id": 24,
      "start": 6153.84,
      "end": 6156.84,
      "formatted_start": "01:42:33.840",
      "formatted_end": "01:42:36.840",
      "text": "خواهش می‌کنم، زنده باشی، خدا نگهان"
    },
    {
      "id": 25,
      "start": 6168.84,
      "end": 6196.84,
      "formatted_start": "01:42:48.840",
      "formatted_end": "01:43:16.840",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 6198.84,
      "end": 6228.82,
      "formatted_start": "01:43:18.840",
      "formatted_end": "01:43:48.820",
      "text": "موسیقی در موسیقی درسته"
    },
