  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3929.98,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 3930.0,
      "end": 3932.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:32.000",
      "text": "باز کن"
    },
    {
      "id": 2,
      "start": 3932.0,
      "end": 3934.0,
      "formatted_start": "01:05:32.000",
      "formatted_end": "01:05:34.000",
      "text": "باز کن"
    },
    {
      "id": 3,
      "start": 3934.0,
      "end": 3936.0,
      "formatted_start": "01:05:34.000",
      "formatted_end": "01:05:36.000",
      "text": "خودش باز کن"
    },
    {
      "id": 4,
      "start": 3936.0,
      "end": 3938.0,
      "formatted_start": "01:05:36.000",
      "formatted_end": "01:05:38.000",
      "text": "باز کن"
    },
    {
      "id": 5,
      "start": 3938.0,
      "end": 3940.0,
      "formatted_start": "01:05:38.000",
      "formatted_end": "01:05:40.000",
      "text": "ده درست کنون"
    },
    {
      "id": 6,
      "start": 3940.0,
      "end": 3942.0,
      "formatted_start": "01:05:40.000",
      "formatted_end": "01:05:42.000",
      "text": "باز کنون"
    },
    {
      "id": 7,
      "start": 3942.0,
      "end": 3944.0,
      "formatted_start": "01:05:42.000",
      "formatted_end": "01:05:44.000",
      "text": "باز کنون"
    },
    {
      "id": 8,
      "start": 3944.0,
      "end": 3946.0,
      "formatted_start": "01:05:44.000",
      "formatted_end": "01:05:46.000",
      "text": "اینجا با اعمال شاقه"
    },
    {
      "id": 9,
      "start": 3946.0,
      "end": 3948.0,
      "formatted_start": "01:05:46.000",
      "formatted_end": "01:05:48.000",
      "text": "باز کنون"
    },
    {
      "id": 10,
      "start": 3948.0,
      "end": 3950.0,
      "formatted_start": "01:05:48.000",
      "formatted_end": "01:05:50.000",
      "text": "باز کنون"
    },
    {
      "id": 11,
      "start": 3950.0,
      "end": 3952.0,
      "formatted_start": "01:05:50.000",
      "formatted_end": "01:05:52.000",
      "text": "ده باز کنون"
    },
    {
      "id": 12,
      "start": 3952.0,
      "end": 3954.0,
      "formatted_start": "01:05:52.000",
      "formatted_end": "01:05:54.000",
      "text": "خشک کنون"
    },
    {
      "id": 13,
      "start": 3954.0,
      "end": 3956.0,
      "formatted_start": "01:05:54.000",
      "formatted_end": "01:05:56.000",
      "text": "خشک کنون"
    },
    {
      "id": 14,
      "start": 3956.0,
      "end": 3958.0,
      "formatted_start": "01:05:56.000",
      "formatted_end": "01:05:58.000",
      "text": "خشک کنون"
    },
    {
      "id": 15,
      "start": 3958.0,
      "end": 3964.0,
      "formatted_start": "01:05:58.000",
      "formatted_end": "01:06:04.000",
      "text": "این هم سرما خورده هم اصحابه"
    },
    {
      "id": 16,
      "start": 3964.0,
      "end": 3968.0,
      "formatted_start": "01:06:04.000",
      "formatted_end": "01:06:08.000",
      "text": "بهش کتماز سیر موز کش روح آب چایی"
    },
    {
      "id": 17,
      "start": 3968.0,
      "end": 3972.0,
      "formatted_start": "01:06:08.000",
      "formatted_end": "01:06:12.000",
      "text": "بیشتر میدی نوش آبه نده غذای شیرین و چرب هم نده"
    },
    {
      "id": 18,
      "start": 3972.0,
      "end": 3977.0,
      "formatted_start": "01:06:12.000",
      "formatted_end": "01:06:17.000",
      "text": "آبه دوز اصلا شربت خوردنش اصلا"
    },
    {
      "id": 19,
      "start": 3977.0,
      "end": 3980.0,
      "formatted_start": "01:06:17.000",
      "formatted_end": "01:06:20.000",
      "text": "بچه ها همه همین هم به زور دارو میدن"
    },
    {
      "id": 20,
      "start": 3980.0,
      "end": 3983.0,
      "formatted_start": "01:06:20.000",
      "formatted_end": "01:06:23.000",
      "text": "من اینکی دوتا چرا؟ می نویسم"
    },
    {
      "id": 21,
      "start": 3983.0,
      "end": 3985.0,
      "formatted_start": "01:06:23.000",
      "formatted_end": "01:06:25.000",
      "text": "ولی تمام داروهاش آمپول نیست"
    },
    {
      "id": 22,
      "start": 3985.0,
      "end": 3987.0,
      "formatted_start": "01:06:25.000",
      "formatted_end": "01:06:27.000",
      "text": "باید شربت هم بدید"
    },
    {
      "id": 23,
      "start": 3987.0,
      "end": 3989.0,
      "formatted_start": "01:06:27.000",
      "formatted_end": "01:06:29.000",
      "text": "من دماغش هم میگنم"
    },
    {
      "id": 24,
      "start": 3989.0,
      "end": 3991.0,
      "formatted_start": "01:06:29.000",
      "formatted_end": "01:06:31.000",
      "text": "نشد دیگه"
    },
    {
      "id": 25,
      "start": 3991.0,
      "end": 3993.0,
      "formatted_start": "01:06:31.000",
      "formatted_end": "01:06:33.000",
      "text": "مثلا اینکه آشرشته درست کن"
    },
    {
      "id": 26,
      "start": 3993.0,
      "end": 3995.0,
      "formatted_start": "01:06:33.000",
      "formatted_end": "01:06:35.000",
      "text": "آقایی بیدم بگم باید آقایی آشرشته درست کن"
    },
    {
      "id": 27,
      "start": 3995.0,
      "end": 3997.0,
      "formatted_start": "01:06:35.000",
      "formatted_end": "01:06:37.000",
      "text": "نمیشه که"
    },
    {
      "id": 28,
      "start": 3997.0,
      "end": 3999.0,
      "formatted_start": "01:06:37.000",
      "formatted_end": "01:06:39.000",
      "text": "باید یه مجموعی از داروها"
    },
    {
      "id": 29,
      "start": 3999.0,
      "end": 4001.0,
      "formatted_start": "01:06:39.000",
      "formatted_end": "01:06:41.000",
      "text": "با همدیگه اثر میکنه"
    },
    {
      "id": 30,
      "start": 4001.0,
      "end": 4003.0,
      "formatted_start": "01:06:41.000",
      "formatted_end": "01:06:43.000",
      "text": "خوب؟"
    },
    {
      "id": 31,
      "start": 4003.0,
      "end": 4005.0,
      "formatted_start": "01:06:43.000",
      "formatted_end": "01:06:45.000",
      "text": "خوب خوب خوب"
    },
    {
      "id": 32,
      "start": 4005.0,
      "end": 4007.0,
      "formatted_start": "01:06:45.000",
      "formatted_end": "01:06:47.000",
      "text": "برنامه مثلا ببینید این هم اسحاله"
    },
    {
      "id": 33,
      "start": 4007.0,
      "end": 4009.0,
      "formatted_start": "01:06:47.000",
      "formatted_end": "01:06:49.000",
      "text": "از اون طرف هم سرما خورده"
    },
    {
      "id": 34,
      "start": 4009.0,
      "end": 4011.0,
      "formatted_start": "01:06:49.000",
      "formatted_end": "01:06:51.000",
      "text": "آدم"
    },
    {
      "id": 35,
      "start": 4011.0,
      "end": 4013.0,
      "formatted_start": "01:06:51.000",
      "formatted_end": "01:06:53.000",
      "text": "میمونی دیگه خب"
    },
    {
      "id": 36,
      "start": 4013.0,
      "end": 4016.0,
      "formatted_start": "01:06:53.000",
      "formatted_end": "01:06:56.000",
      "text": "این طب داشته بود و بعد ازش خیلی داغمی شد"
    },
    {
      "id": 37,
      "start": 4016.0,
      "end": 4019.0,
      "formatted_start": "01:06:56.000",
      "formatted_end": "01:06:59.000",
      "text": "یه باید گلشتون بودی گرفت و بعد هم نساش"
    },
    {
      "id": 38,
      "start": 4028.0,
      "end": 4030.0,
      "formatted_start": "01:07:08.000",
      "formatted_end": "01:07:10.000",
      "text": "خواهد سرکت ده دیگه"
    },
    {
      "id": 39,
      "start": 4030.0,
      "end": 4034.0,
      "formatted_start": "01:07:10.000",
      "formatted_end": "01:07:14.000",
      "text": "آفرین، خیلی دختر خوبی بود"
    },
    {
      "id": 40,
      "start": 4034.0,
      "end": 4036.0,
      "formatted_start": "01:07:14.000",
      "formatted_end": "01:07:16.000",
      "text": "آخرها ترسیب فقط دهید"
    },
    {
      "id": 41,
      "start": 4036.0,
      "end": 4038.0,
      "formatted_start": "01:07:16.000",
      "formatted_end": "01:07:18.000",
      "text": "یعنی ممورت خیلی خوب بود"
    },
    {
      "id": 42,
      "start": 4038.0,
      "end": 4042.0,
      "formatted_start": "01:07:18.000",
      "formatted_end": "01:07:22.000",
      "text": "خیلی خوب قابلی دستات رو تشکر شد"
    },
    {
      "id": 43,
      "start": 4042.0,
      "end": 4046.0,
      "formatted_start": "01:07:22.000",
      "formatted_end": "01:07:26.000",
      "text": "و این داروها شبیه همین هم دهید، این هم یکی به توانسی میشه"
    },
    {
      "id": 44,
      "start": 4046.0,
      "end": 4047.0,
      "formatted_start": "01:07:26.000",
      "formatted_end": "01:07:27.000",
      "text": "مباشرت"
    },
    {
      "id": 45,
      "start": 4047.0,
      "end": 4048.0,
      "formatted_start": "01:07:27.000",
      "formatted_end": "01:07:28.000",
      "text": "مباشرت، اون هم خودش"
    },
    {
      "id": 46,
      "start": 4065.0,
      "end": 4070.0,
      "formatted_start": "01:07:45.000",
      "formatted_end": "01:07:50.000",
      "text": "میخوام یکی از دو در حلاق آمدان سند باقبانی و باقدایی سراسر کشتن"
    },
    {
      "id": 47,
      "start": 4070.0,
      "end": 4078.66,
      "formatted_start": "01:07:50.000",
      "formatted_end": "01:07:58.660",
      "text": "در این باب نقش تشکرهای آبیاری رو که در واقعی نقش دومنزوله دارن"
    },
    {
      "id": 48,
      "start": 4078.66,
      "end": 4083.04,
      "formatted_start": "01:07:58.660",
      "formatted_end": "01:08:03.040",
      "text": "علاقه اینکه تشکرهای آبیاری هستن مالک پوششی هستن دوره"
    },
    {
      "id": 49,
      "start": 4083.04,
      "end": 4092.26,
      "formatted_start": "01:08:03.040",
      "formatted_end": "01:08:12.260",
      "text": "صحابه نهارهای جوان و هم در آبیاری و جنگیری از اطلاق مدوبت کمک بکنن"
    },
    {
      "id": 50,
      "start": 4092.26,
      "end": 4096.32,
      "formatted_start": "01:08:12.260",
      "formatted_end": "01:08:16.320",
      "text": "و هم جنگیری بکنن از رشده لطف عرض"
    },
    {
      "id": 51,
      "start": 4096.32,
      "end": 4110.12,
      "formatted_start": "01:08:16.320",
      "formatted_end": "01:08:30.120",
      "text": "مشاهده میپرمایید که این روشت رویشی نحال ها اثر بزار بوده در حالی که در ودیف همجوار ما صرفا از مالچه کوششی استفاده کردیم"
    },
    {
      "id": 52,
      "start": 4110.12,
      "end": 4116.68,
      "formatted_start": "01:08:30.120",
      "formatted_end": "01:08:36.680",
      "text": "ببینید که نحال ها بسیار ضعیف و روشت رویشی نامترونی دارن"
    },
    {
      "id": 53,
      "start": 4116.68,
      "end": 4121.56,
      "formatted_start": "01:08:36.680",
      "formatted_end": "01:08:41.560",
      "text": "بنابراین استفاده از این دشتک های آبیاری بسیار راکشاک است"
    },
    {
      "id": 54,
      "start": 4121.56,
      "end": 4128.04,
      "formatted_start": "01:08:41.560",
      "formatted_end": "01:08:48.040",
      "text": "ما بدونه که از سم بینوز استفاده بکنیم به صورت هفتهی در این نحال های جوان"
    },
    {
      "id": 55,
      "start": 4128.04,
      "end": 4132.72,
      "formatted_start": "01:08:48.040",
      "formatted_end": "01:08:52.720",
      "text": "رشد روی شیع تابستانه خیلی خوبی رو داریم"
    },
    {
      "id": 56,
      "start": 4132.72,
      "end": 4139.18,
      "formatted_start": "01:08:52.720",
      "formatted_end": "01:08:59.180",
      "text": "و هیچ نیازی هم به سم باشی هفتهی برای کنترول بینوز نیست"
    },
    {
      "id": 57,
      "start": 4139.18,
      "end": 4141.34,
      "formatted_start": "01:08:59.180",
      "formatted_end": "01:09:01.340",
      "text": "و نحال میتونه"
    },
    {
      "id": 58,
      "start": 4151.56,
      "end": 4161.56,
      "formatted_start": "01:09:11.560",
      "formatted_end": "01:09:21.560",
      "text": "موسیقی"
    },
    {
      "id": 59,
      "start": 4181.56,
      "end": 4199.56,
      "formatted_start": "01:09:41.560",
      "formatted_end": "01:09:59.560",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}