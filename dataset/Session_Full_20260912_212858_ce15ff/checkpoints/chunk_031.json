  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9303.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:03.000",
      "text": "اخلاق قبول دارم. خوب؟"
    },
    {
      "id": 1,
      "start": 9303.0,
      "end": 9310.0,
      "formatted_start": "02:35:03.000",
      "formatted_end": "02:35:10.000",
      "text": "بعد گفتم که ببین الان اینای که اینجا نماز می کنند شاید یه تعدادشون داشت صدای ازان و این چیزا بود."
    },
    {
      "id": 2,
      "start": 9310.0,
      "end": 9315.0,
      "formatted_start": "02:35:10.000",
      "formatted_end": "02:35:15.000",
      "text": "ببین یه بخششون ممکنه اصلا برن دزدی کنند، کارهای خلاف کنند."
    },
    {
      "id": 3,
      "start": 9315.0,
      "end": 9324.0,
      "formatted_start": "02:35:15.000",
      "formatted_end": "02:35:24.000",
      "text": "اینا که دین نیستند که این، به صحبت اینای که الان از مسجد میان، اینا که دین واقعی نیستند که"
    },
    {
      "id": 4,
      "start": 9324.0,
      "end": 9330.0,
      "formatted_start": "02:35:24.000",
      "formatted_end": "02:35:30.000",
      "text": "این ها یه آدمی ها الان بگو گرفتن شاید برای ریا نفاق اومدن نماز میخونن"
    },
    {
      "id": 5,
      "start": 9330.0,
      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "شاید نفهمیدن خیلی چیزا رو"
    },
    {
      "id": 6,
      "start": 9332.0,
      "end": 9339.0,
      "formatted_start": "02:35:32.000",
      "formatted_end": "02:35:39.000",
      "text": "خب، گفتم شما اجتباد اینه که فکر میکنید دین یعنی یه نفری که تصویر دستش ریچ گذاشته نماز میده"
    },
    {
      "id": 7,
      "start": 9339.0,
      "end": 9342.0,
      "formatted_start": "02:35:39.000",
      "formatted_end": "02:35:42.000",
      "text": "گفتم این نیست، گفتم شما باید دین رو خوب متعلق کنید"
    },
    {
      "id": 8,
      "start": 9342.0,
      "end": 9347.0,
      "formatted_start": "02:35:42.000",
      "formatted_end": "02:35:47.000",
      "text": "اصلا نه قرآن رو خوندی که میگه من قرآن ببخش ایده ها چیز کردم"
    },
    {
      "id": 9,
      "start": 9347.0,
      "end": 9349.24,
      "formatted_start": "02:35:47.000",
      "formatted_end": "02:35:49.240",
      "text": "خب، خودم تو اصلا قرآن رو خوندی؟"
    },
    {
      "id": 10,
      "start": 9350.24,
      "end": 9354.9,
      "formatted_start": "02:35:50.240",
      "formatted_end": "02:35:54.900",
      "text": "خب، گفت یک کم، خودم اون یک کمش هم نخوندی، من مطمئنم نخوندی"
    },
    {
      "id": 11,
      "start": 9355.4,
      "end": 9359.5,
      "formatted_start": "02:35:55.400",
      "formatted_end": "02:35:59.500",
      "text": "خب، اگه من میگم تو همین یک کم چقدر خوندی، همین یک کمش رو به من بگو نمیدونی"
    },
    {
      "id": 12,
      "start": 9360.06,
      "end": 9364.5,
      "formatted_start": "02:36:00.060",
      "formatted_end": "02:36:04.500",
      "text": "خب، خودم یک چیزی الان مد شده، کرد همین حرفا رو"
    },
    {
      "id": 13,
      "start": 9364.86,
      "end": 9368.44,
      "formatted_start": "02:36:04.860",
      "formatted_end": "02:36:08.440",
      "text": "اخلاق خیلی خوبه، دینم میگه آقا اخلاق مدار باش"
    },
    {
      "id": 14,
      "start": 9369.36,
      "end": 9373.2,
      "formatted_start": "02:36:09.360",
      "formatted_end": "02:36:13.200",
      "text": "ولی دین میخواد تو رو به یک تعالی برسه"
    },
    {
      "id": 15,
      "start": 9373.2,
      "end": 9379.2,
      "formatted_start": "02:36:13.200",
      "formatted_end": "02:36:19.200",
      "text": "در نظر روحی، معنوی، شناختت به دنیا، معنای زندگیت"
    },
    {
      "id": 16,
      "start": 9379.2,
      "end": 9383.2,
      "formatted_start": "02:36:19.200",
      "formatted_end": "02:36:23.200",
      "text": "اینا رو همه رو شما در خالف دین میتونید مفهوم بدید"
    },
    {
      "id": 17,
      "start": 9383.2,
      "end": 9386.2,
      "formatted_start": "02:36:23.200",
      "formatted_end": "02:36:26.200",
      "text": "و دین واقعی، اینی که درست بفهمید"
    },
    {
      "id": 18,
      "start": 9386.2,
      "end": 9391.2,
      "formatted_start": "02:36:26.200",
      "formatted_end": "02:36:31.200",
      "text": "نه هر دین و خرافات و بدعوت و اینی که تو کوچه بازار و شیخ‌ها و اون دیگه"
    },
    {
      "id": 19,
      "start": 9391.2,
      "end": 9396.2,
      "formatted_start": "02:36:31.200",
      "formatted_end": "02:36:36.200",
      "text": "مثلا مدد‌ها میگن، خب؟ خودم نه، اون رو من قبول ندم"
    },
    {
      "id": 20,
      "start": 9399.2,
      "end": 9402.2,
      "formatted_start": "02:36:39.200",
      "formatted_end": "02:36:42.200",
      "text": "ارشادشون؟ نه کردید؟ ارشاد نشدید؟"
    },
    {
      "id": 21,
      "start": 9402.2,
      "end": 9407.0,
      "formatted_start": "02:36:42.200",
      "formatted_end": "02:36:47.000",
      "text": "نه، انا فکر میگم، انا ریشانو باید تیغ زدم و آسینکوتا هستم"
    },
    {
      "id": 22,
      "start": 9407.0,
      "end": 9409.0,
      "formatted_start": "02:36:47.000",
      "formatted_end": "02:36:49.000",
      "text": "آره، میگم بله، بله"
    },
    {
      "id": 23,
      "start": 9409.0,
      "end": 9411.5,
      "formatted_start": "02:36:49.000",
      "formatted_end": "02:36:51.500",
      "text": "بعد هم دیگه همین ماشین کمیری و وایسون رو دیگه خانه باشم"
    },
    {
      "id": 24,
      "start": 9411.5,
      "end": 9414.5,
      "formatted_start": "02:36:51.500",
      "formatted_end": "02:36:54.500",
      "text": "بگم، بگم یه ماشین هم دیدن که دیگه هده"
    },
    {
      "id": 25,
      "start": 9422.6,
      "end": 9425.1,
      "formatted_start": "02:37:02.600",
      "formatted_end": "02:37:05.100",
      "text": "تایر باید شنزی میسته؟"
    },
    {
      "id": 26,
      "start": 9425.1,
      "end": 9428.1,
      "formatted_start": "02:37:05.100",
      "formatted_end": "02:37:08.100",
      "text": "آره، نه، این دو بار من بردم"
    },
    {
      "id": 27,
      "start": 9428.1,
      "end": 9429.6,
      "formatted_start": "02:37:08.100",
      "formatted_end": "02:37:09.600",
      "text": "بعد گفت که..."
    },
    {
      "id": 28,
      "start": 9429.6,
      "end": 9430.6,
      "formatted_start": "02:37:09.600",
      "formatted_end": "02:37:10.600",
      "text": "شنزورشه؟"
    },
    {
      "id": 29,
      "start": 9430.6,
      "end": 9434.42,
      "formatted_start": "02:37:10.600",
      "formatted_end": "02:37:14.420",
      "text": "نه، این ها دستی با این چیزها هستند، درجه میذارند"
    },
    {
      "id": 30,
      "start": 9434.42,
      "end": 9434.92,
      "formatted_start": "02:37:14.420",
      "formatted_end": "02:37:14.920",
      "text": "آره"
    },
    {
      "id": 31,
      "start": 9434.92,
      "end": 9438.04,
      "formatted_start": "02:37:14.920",
      "formatted_end": "02:37:18.040",
      "text": "گفت روبرو سیلو یا آقای محمدی هست"
    },
    {
      "id": 32,
      "start": 9438.04,
      "end": 9441.98,
      "formatted_start": "02:37:18.040",
      "formatted_end": "02:37:21.980",
      "text": "گفت این ها خیلی دستیک های چیزی دارند، بادشان حساسه"
    },
    {
      "id": 33,
      "start": 9441.98,
      "end": 9444.26,
      "formatted_start": "02:37:21.980",
      "formatted_end": "02:37:24.260",
      "text": "گفت دستک های دیژیتالی دارند"
    },
    {
      "id": 34,
      "start": 9444.26,
      "end": 9448.6,
      "formatted_start": "02:37:24.260",
      "formatted_end": "02:37:28.600",
      "text": "گفت ببر پیش اون روبرو سیلو، اون باده برای تنظیم می کنه"
    },
    {
      "id": 35,
      "start": 9448.6,
      "end": 9450.6,
      "formatted_start": "02:37:28.600",
      "formatted_end": "02:37:30.600",
      "text": "امم"
    },
    {
      "id": 36,
      "start": 9450.6,
      "end": 9454.36,
      "formatted_start": "02:37:30.600",
      "formatted_end": "02:37:34.360",
      "text": "مثلاً باید مثلاً سی و دوتا الان این زده"
    },
    {
      "id": 37,
      "start": 9454.36,
      "end": 9456.36,
      "formatted_start": "02:37:34.360",
      "formatted_end": "02:37:36.360",
      "text": "مثلاً سی و سه و نیم باید باشه"
    },
    {
      "id": 38,
      "start": 9456.36,
      "end": 9459.36,
      "formatted_start": "02:37:36.360",
      "formatted_end": "02:37:39.360",
      "text": "اون دستیه نمیتونه اینقدر درده"
    },
    {
      "id": 39,
      "start": 9459.36,
      "end": 9462.36,
      "formatted_start": "02:37:39.360",
      "formatted_end": "02:37:42.360",
      "text": "این این پرده پشت"
    },
    {
      "id": 40,
      "start": 9462.36,
      "end": 9464.36,
      "formatted_start": "02:37:42.360",
      "formatted_end": "02:37:44.360",
      "text": "دنده اقف میزنی"
    },
    {
      "id": 41,
      "start": 9464.36,
      "end": 9466.36,
      "formatted_start": "02:37:44.360",
      "formatted_end": "02:37:46.360",
      "text": "از بیاد پایین یا بیاد بلا"
    },
    {
      "id": 42,
      "start": 9466.36,
      "end": 9468.36,
      "formatted_start": "02:37:46.360",
      "formatted_end": "02:37:48.360",
      "text": "دستیه بودو بایدش کردیم"
    },
    {
      "id": 43,
      "start": 9468.36,
      "end": 9472.36,
      "formatted_start": "02:37:48.360",
      "formatted_end": "02:37:52.360",
      "text": "ببین اینا معمولا دنده اقف میزنی پرده میاد پایین"
    },
    {
      "id": 44,
      "start": 9472.36,
      "end": 9478.36,
      "formatted_start": "02:37:52.360",
      "formatted_end": "02:37:58.360",
      "text": "موقعی که دنده جلو میزنی پرده میره بالا موقعی کامیشه پرده بالایی"
    },
    {
      "id": 45,
      "start": 9478.36,
      "end": 9480.36,
      "formatted_start": "02:37:58.360",
      "formatted_end": "02:38:00.360",
      "text": "کلو خوبه دیگه برای چی جمع کنی؟"
    },
    {
      "id": 46,
      "start": 9480.36,
      "end": 9484.36,
      "formatted_start": "02:38:00.360",
      "formatted_end": "02:38:04.360",
      "text": "شاها برنامه قصد برای نگهی داره استرس مشکلی میکنه"
    },
    {
      "id": 47,
      "start": 9484.36,
      "end": 9485.36,
      "formatted_start": "02:38:04.360",
      "formatted_end": "02:38:05.360",
      "text": "نه، نیز داره"
    },
    {
      "id": 48,
      "start": 9485.36,
      "end": 9487.36,
      "formatted_start": "02:38:05.360",
      "formatted_end": "02:38:07.360",
      "text": "من عادت دارم پشی ها را از تو این نگاه می کنم"
    },
    {
      "id": 49,
      "start": 9487.36,
      "end": 9488.36,
      "formatted_start": "02:38:07.360",
      "formatted_end": "02:38:08.360",
      "text": "نه، نور... نه چه موقع..."
    },
    {
      "id": 50,
      "start": 9488.36,
      "end": 9491.36,
      "formatted_start": "02:38:08.360",
      "formatted_end": "02:38:11.360",
      "text": "نه، الان تاریک شده بود، دیده نمی شده این ماشین ها خوب"
    },
    {
      "id": 51,
      "start": 9491.36,
      "end": 9492.36,
      "formatted_start": "02:38:11.360",
      "formatted_end": "02:38:12.360",
      "text": "نورشون هست؟"
    },
    {
      "id": 52,
      "start": 9492.36,
      "end": 9493.36,
      "formatted_start": "02:38:12.360",
      "formatted_end": "02:38:13.360",
      "text": "چون من نور..."
    },
    {
      "id": 53,
      "start": 9493.36,
      "end": 9494.36,
      "formatted_start": "02:38:13.360",
      "formatted_end": "02:38:14.360",
      "text": "نور هایی بزن؟ آره، یعنی خب"
    },
    {
      "id": 54,
      "start": 9494.36,
      "end": 9495.36,
      "formatted_start": "02:38:14.360",
      "formatted_end": "02:38:15.360",
      "text": "نه، نور میزن"
    },
    {
      "id": 55,
      "start": 9495.36,
      "end": 9497.36,
      "formatted_start": "02:38:15.360",
      "formatted_end": "02:38:17.360",
      "text": "موقعی بود که نور ها روشن نکرده بود"
    },
    {
      "id": 56,
      "start": 9497.36,
      "end": 9500.36,
      "formatted_start": "02:38:17.360",
      "formatted_end": "02:38:20.360",
      "text": "من اینجور بقیه با آین بقال ها چیزی باشم"
    },
    {
      "id": 57,
      "start": 9500.36,
      "end": 9501.36,
      "formatted_start": "02:38:20.360",
      "formatted_end": "02:38:21.360",
      "text": "آره، آین بقال ها..."
    },
    {
      "id": 58,
      "start": 9501.36,
      "end": 9502.36,
      "formatted_start": "02:38:21.360",
      "formatted_end": "02:38:22.360",
      "text": "که خیلی مشکل داشت کدیده"
    },
    {
      "id": 59,
      "start": 9514.36,
      "end": 9520.36,
      "formatted_start": "02:38:34.360",
      "formatted_end": "02:38:40.360",
      "text": "به خطر این، به نظر من چیزاش درسته"
    },
    {
      "id": 60,
      "start": 9526.36,
      "end": 9530.36,
      "formatted_start": "02:38:46.360",
      "formatted_end": "02:38:50.360",
      "text": "یعنی میخوایی با این ماشین راهاننده دوست داره بینایت بره"
    },
    {
      "id": 61,
      "start": 9530.36,
      "end": 9532.36,
      "formatted_start": "02:38:50.360",
      "formatted_end": "02:38:52.360",
      "text": "درسته شاه؟"
    },
    {
      "id": 62,
      "start": 9532.36,
      "end": 9534.36,
      "formatted_start": "02:38:52.360",
      "formatted_end": "02:38:54.360",
      "text": "درسته شاه"
    },
    {
      "id": 63,
      "start": 9534.36,
      "end": 9537.36,
      "formatted_start": "02:38:54.360",
      "formatted_end": "02:38:57.360",
      "text": "خب اونها اندازه شو زیاد کردن یکم"
    },
    {
      "id": 64,
      "start": 9537.36,
      "end": 9538.36,
      "formatted_start": "02:38:57.360",
      "formatted_end": "02:38:58.360",
      "text": "چی؟"
    },
    {
      "id": 65,
      "start": 9538.36,
      "end": 9540.36,
      "formatted_start": "02:38:58.360",
      "formatted_end": "02:39:00.360",
      "text": "یکم اندازه شو بزرگ کردن یکم فرده"
    },
    {
      "id": 66,
      "start": 9540.36,
      "end": 9541.36,
      "formatted_start": "02:39:00.360",
      "formatted_end": "02:39:01.360",
      "text": "چی شده؟"
    },
    {
      "id": 67,
      "start": 9541.36,
      "end": 9543.36,
      "formatted_start": "02:39:01.360",
      "formatted_end": "02:39:03.360",
      "text": "دروبه کرده"
    },
    {
      "id": 68,
      "start": 9543.36,
      "end": 9546.12,
      "formatted_start": "02:39:03.360",
      "formatted_end": "02:39:06.120",
      "text": "اینجا کلیت بوده"
    },
    {
      "id": 69,
      "start": 9546.12,
      "end": 9548.12,
      "formatted_start": "02:39:06.120",
      "formatted_end": "02:39:08.120",
      "text": "با حیبت دیده امشه شاپ"
    },
    {
      "id": 70,
      "start": 9548.12,
      "end": 9550.12,
      "formatted_start": "02:39:08.120",
      "formatted_end": "02:39:10.120",
      "text": "ماشین به چشم میاد"
    },
    {
      "id": 71,
      "start": 9550.12,
      "end": 9553.36,
      "formatted_start": "02:39:10.120",
      "formatted_end": "02:39:13.360",
      "text": "الان یک چیزی هست که مثلا"
    },
    {
      "id": 72,
      "start": 9553.36,
      "end": 9556.16,
      "formatted_start": "02:39:13.360",
      "formatted_end": "02:39:16.160",
      "text": "مثلا کورولا در مقابل اینجا دید"
    },
    {
      "id": 73,
      "start": 9556.16,
      "end": 9559.2,
      "formatted_start": "02:39:16.160",
      "formatted_end": "02:39:19.200",
      "text": "کورولا که با کوچیک هست داری اون کوچیک داره"
    },
    {
      "id": 74,
      "start": 9559.2,
      "end": 9567.12,
      "formatted_start": "02:39:19.200",
      "formatted_end": "02:39:27.120",
      "text": "شاپ من همیشه تو زندگی کاری نکردم"
    },
    {
      "id": 75,
      "start": 9567.12,
      "end": 9570.6,
      "formatted_start": "02:39:27.120",
      "formatted_end": "02:39:30.600",
      "text": "اگه کاری هم کردم بهترین کردم"
    },
    {
      "id": 76,
      "start": 9570.6,
      "end": 9580.28,
      "formatted_start": "02:39:30.600",
      "formatted_end": "02:39:40.280",
      "text": "یعنی یا ویلا نساختم یا ویلای ساختم که تو کومیان یا تو رزیب یا خونه خود ما یا ماشین برا کروز خب؟"
    },
    {
      "id": 77,
      "start": 9580.28,
      "end": 9580.84,
      "formatted_start": "02:39:40.280",
      "formatted_end": "02:39:40.840",
      "text": "آمد"
    },
    {
      "id": 78,
      "start": 9580.84,
      "end": 9588.4,
      "formatted_start": "02:39:40.840",
      "formatted_end": "02:39:48.400",
