  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10507.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:07.000",
      "text": "از هر زیرایی، تو عروض شهر نفسانه هایی."
    },
    {
      "id": 1,
      "start": 10507.0,
      "end": 10516.0,
      "formatted_start": "02:55:07.000",
      "formatted_end": "02:55:16.000",
      "text": "عاشقت میمانم قبر تو رو میدونم، نه یه اون روزی که بی تو بمونم."
    },
    {
      "id": 2,
      "start": 10530.0,
      "end": 10532.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:32.000",
      "text": "ببین اینجا این تابلو"
    },
    {
      "id": 3,
      "start": 10532.0,
      "end": 10535.0,
      "formatted_start": "02:55:32.000",
      "formatted_end": "02:55:35.000",
      "text": "برام این خیابانی برو جدو"
    },
    {
      "id": 4,
      "start": 10535.0,
      "end": 10536.0,
      "formatted_start": "02:55:35.000",
      "formatted_end": "02:55:36.000",
      "text": "نه این نیست"
    },
    {
      "id": 5,
      "start": 10536.0,
      "end": 10537.0,
      "formatted_start": "02:55:36.000",
      "formatted_end": "02:55:37.000",
      "text": "این نیست نه"
    },
    {
      "id": 6,
      "start": 10537.0,
      "end": 10538.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:38.000",
      "text": "همین سبسکرایب"
    },
    {
      "id": 7,
      "start": 10538.0,
      "end": 10539.0,
      "formatted_start": "02:55:38.000",
      "formatted_end": "02:55:39.000",
      "text": "نه اینم"
    },
    {
      "id": 8,
      "start": 10539.0,
      "end": 10540.0,
      "formatted_start": "02:55:39.000",
      "formatted_end": "02:55:40.000",
      "text": "اینم جدو"
    },
    {
      "id": 9,
      "start": 10540.0,
      "end": 10541.0,
      "formatted_start": "02:55:40.000",
      "formatted_end": "02:55:41.000",
      "text": "اینم جدو"
    },
    {
      "id": 10,
      "start": 10541.0,
      "end": 10542.0,
      "formatted_start": "02:55:41.000",
      "formatted_end": "02:55:42.000",
      "text": "خب من نمیشم"
    },
    {
      "id": 11,
      "start": 10554.0,
      "end": 10556.0,
      "formatted_start": "02:55:54.000",
      "formatted_end": "02:55:56.000",
      "text": "خواهید همین برم درانه داره؟"
    },
    {
      "id": 12,
      "start": 10556.0,
      "end": 10558.0,
      "formatted_start": "02:55:56.000",
      "formatted_end": "02:55:58.000",
      "text": "نه نه انجام نمیشم"
    },
    {
      "id": 13,
      "start": 10558.0,
      "end": 10559.0,
      "formatted_start": "02:55:58.000",
      "formatted_end": "02:55:59.000",
      "text": "انجام نیست برو جدو درانه"
    },
    {
      "id": 14,
      "start": 10559.0,
      "end": 10561.0,
      "formatted_start": "02:55:59.000",
      "formatted_end": "02:56:01.000",
      "text": "برو از همینجا"
    },
    {
      "id": 15,
      "start": 10561.0,
      "end": 10563.0,
      "formatted_start": "02:56:01.000",
      "formatted_end": "02:56:03.000",
      "text": "از این خیوان فرقی برو"
    },
    {
      "id": 16,
      "start": 10563.0,
      "end": 10565.0,
      "formatted_start": "02:56:03.000",
      "formatted_end": "02:56:05.000",
      "text": "اتصال میشه"
    },
    {
      "id": 17,
      "start": 10565.0,
      "end": 10567.0,
      "formatted_start": "02:56:05.000",
      "formatted_end": "02:56:07.000",
      "text": "برو جلو بعد میپیچی تو"
    },
    {
      "id": 18,
      "start": 10569.0,
      "end": 10571.0,
      "formatted_start": "02:56:09.000",
      "formatted_end": "02:56:11.000",
      "text": "بخ بزن این دار راه نما میزن"
    },
    {
      "id": 19,
      "start": 10571.0,
      "end": 10573.0,
      "formatted_start": "02:56:11.000",
      "formatted_end": "02:56:13.000",
      "text": "بخ بزن"
    },
    {
      "id": 20,
      "start": 10573.0,
      "end": 10575.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:15.000",
      "text": "راه نما بزن شاهد"
    },
    {
      "id": 21,
      "start": 10577.0,
      "end": 10579.0,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:19.000",
      "text": "یه طرفی بزن"
    },
    {
      "id": 22,
      "start": 10579.0,
      "end": 10581.0,
      "formatted_start": "02:56:19.000",
      "formatted_end": "02:56:21.000",
      "text": "نه نه برو ماشین وایسته داره"
    },
    {
      "id": 23,
      "start": 10581.0,
      "end": 10583.0,
      "formatted_start": "02:56:21.000",
      "formatted_end": "02:56:23.000",
      "text": "بزن اون بره بزن اون زنه بره"
    },
    {
      "id": 24,
      "start": 10583.0,
      "end": 10585.0,
      "formatted_start": "02:56:23.000",
      "formatted_end": "02:56:25.000",
      "text": "اون زنه خلاف اومده"
    },
    {
      "id": 25,
      "start": 10589.0,
      "end": 10591.0,
      "formatted_start": "02:56:29.000",
      "formatted_end": "02:56:31.000",
      "text": "بخش بگیرد"
    },
    {
      "id": 26,
      "start": 10619.0,
      "end": 10623.0,
      "formatted_start": "02:56:59.000",
      "formatted_end": "02:57:03.000",
      "text": "از خانم سلام خوبین"
    },
    {
      "id": 27,
      "start": 10623.0,
      "end": 10627.0,
      "formatted_start": "02:57:03.000",
      "formatted_end": "02:57:07.000",
      "text": "این خیوان فارسیان این خیوان او برای بولوار از اینجا راداره دیگه"
    },
    {
      "id": 28,
      "start": 10627.0,
      "end": 10631.0,
      "formatted_start": "02:57:07.000",
      "formatted_end": "02:57:11.000",
      "text": "آره باشه"
    },
    {
      "id": 29,
      "start": 10631.0,
      "end": 10637.0,
      "formatted_start": "02:57:11.000",
      "formatted_end": "02:57:17.000",
      "text": "نه اون باز مینداخت توی خود بولوار"
    },
    {
      "id": 30,
      "start": 10637.0,
      "end": 10641.0,
      "formatted_start": "02:57:17.000",
      "formatted_end": "02:57:21.000",
      "text": "خب شب اینجا نگه دار بذار راننده عوض بشه برو جلو سمن نگه دار"
    },
    {
      "id": 31,
      "start": 10641.0,
      "end": 10645.0,
      "formatted_start": "02:57:21.000",
      "formatted_end": "02:57:25.000",
      "text": "آره اصلا بگو از همه یه میتونی بگیر"
    },
    {
      "id": 32,
      "start": 10645.0,
      "end": 10647.0,
      "formatted_start": "02:57:25.000",
      "formatted_end": "02:57:27.000",
      "text": "آره اصلا بگیردن نه مهم"
    },
    {
      "id": 33,
      "start": 10647.0,
      "end": 10648.0,
      "formatted_start": "02:57:27.000",
      "formatted_end": "02:57:28.000",
      "text": "نه اینجا بومیم"
    },
    {
      "id": 34,
      "start": 10648.0,
      "end": 10650.0,
      "formatted_start": "02:57:28.000",
      "formatted_end": "02:57:30.000",
      "text": "نه اینجا بریم بعد اون خود برویم"
    },
    {
      "id": 35,
      "start": 10650.0,
      "end": 10651.0,
      "formatted_start": "02:57:30.000",
      "formatted_end": "02:57:31.000",
      "text": "بسیار شما درد نکنید"
    },
    {
      "id": 36,
      "start": 10651.0,
      "end": 10653.0,
      "formatted_start": "02:57:31.000",
      "formatted_end": "02:57:33.000",
      "text": "برام شما میخوای بیر جلو"
    },
    {
      "id": 37,
      "start": 10653.0,
      "end": 10654.0,
      "formatted_start": "02:57:33.000",
      "formatted_end": "02:57:34.000",
      "text": "بشم شما"
    },
    {
      "id": 38,
      "start": 10654.0,
      "end": 10655.0,
      "formatted_start": "02:57:34.000",
      "formatted_end": "02:57:35.000",
      "text": "نه نه بیر جلو میخوای"
    },
    {
      "id": 39,
      "start": 10675.0,
      "end": 10677.0,
      "formatted_start": "02:57:55.000",
      "formatted_end": "02:57:57.000",
      "text": "اوه"
    },
    {
      "id": 40,
      "start": 10683.0,
      "end": 10685.0,
      "formatted_start": "02:58:03.000",
      "formatted_end": "02:58:05.000",
      "text": "برای هم فرنگ زنده زنده شون که"
    },
    {
      "id": 41,
      "start": 10685.0,
      "end": 10687.0,
      "formatted_start": "02:58:05.000",
      "formatted_end": "02:58:07.000",
      "text": "اول جده فارسی"
    },
    {
      "id": 42,
      "start": 10687.0,
      "end": 10689.0,
      "formatted_start": "02:58:07.000",
      "formatted_end": "02:58:09.000",
      "text": "ببین ما جده فارسی هستیم"
    },
    {
      "id": 43,
      "start": 10705.0,
      "end": 10709.3,
      "formatted_start": "02:58:25.000",
      "formatted_end": "02:58:29.300",
      "text": "این کچه رو نیوا کنیم این ده چیز می کنه اون جده"
    },
    {
      "id": 44,
      "start": 10709.3,
      "end": 10713.24,
      "formatted_start": "02:58:29.300",
      "formatted_end": "02:58:33.240",
      "text": "نه میریم دور بزنیم"
    },
    {
      "id": 45,
      "start": 10713.24,
      "end": 10715.24,
      "formatted_start": "02:58:33.240",
      "formatted_end": "02:58:35.240",
      "text": "نه میریم دور بزنیم"
    },
    {
      "id": 46,
      "start": 10715.24,
      "end": 10718.04,
      "formatted_start": "02:58:35.240",
      "formatted_end": "02:58:38.040",
      "text": "اون بیتر این بود اون مسیره میرفتیم تا"
    },
    {
      "id": 47,
      "start": 10718.04,
      "end": 10720.04,
      "formatted_start": "02:58:38.040",
      "formatted_end": "02:58:40.040",
      "text": "ترافیکم بود نیم ساعت"
    },
    {
      "id": 48,
      "start": 10735.0,
      "end": 10755.0,
      "formatted_start": "02:58:55.000",
      "formatted_end": "02:59:15.000",
      "text": "موسیقی"
    },
    {
      "id": 49,
      "start": 10755.0,
      "end": 10764.0,
      "formatted_start": "02:59:15.000",
      "formatted_end": "02:59:24.000",
      "text": "مرگز خانم خوب هستیم؟ با زحمت های ما تو زحمت افتادی"
    },
    {
      "id": 50,
      "start": 10764.0,
      "end": 10771.0,
      "formatted_start": "02:59:24.000",
      "formatted_end": "02:59:31.000",
      "text": "میگم ما اول جاده فرسیانیم دیگه یعنی از گالیکش هم بیچیدیم دو جاده"
    },
    {
      "id": 51,
      "start": 10771.0,
      "end": 10777.0,
      "formatted_start": "02:59:31.000",
      "formatted_end": "02:59:37.000",
      "text": "باروانت باشه مزاهمت میشیم مرسی خداحافظ"
    },
    {
      "id": 52,
      "start": 10777.0,
      "end": 10779.0,
      "formatted_start": "02:59:37.000",
      "formatted_end": "02:59:39.000",
      "text": "نیم ساعت چطور؟"
    },
    {
      "id": 53,
      "start": 10779.0,
      "end": 10781.0,
      "formatted_start": "02:59:39.000",
      "formatted_end": "02:59:41.000",
      "text": "نیم ساعت چطور؟"
    },
    {
      "id": 54,
      "start": 10781.0,
      "end": 10783.0,
      "formatted_start": "02:59:41.000",
      "formatted_end": "02:59:43.000",
      "text": "نیم ساعت ایران است"
    },
    {
      "id": 55,
      "start": 10791.0,
      "end": 10793.0,
      "formatted_start": "02:59:51.000",
      "formatted_end": "02:59:53.000",
      "text": "از این پوله زینب شو هم رفتی"
    },
    {
      "id": 56,
      "start": 10793.0,
      "end": 10795.0,
      "formatted_start": "02:59:53.000",
      "formatted_end": "02:59:55.000",
      "text": "دیگه پوله زینب شو یکی از این کوچه ها است"
    },
    {
      "id": 57,
      "start": 10795.0,
      "end": 10797.0,
      "formatted_start": "02:59:55.000",
      "formatted_end": "02:59:57.000",
      "text": "آره"
    },
    {
      "id": 58,
      "start": 10797.0,
      "end": 10799.0,
      "formatted_start": "02:59:57.000",
      "formatted_end": "02:59:59.000",
      "text": "آره آره"
    }
  ],
  "status": "completed"
}