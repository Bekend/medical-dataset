      "formatted_start": "01:21:20.000",
      "formatted_end": "01:21:22.000",
      "text": "بسیار خوب"
    },
    {
      "id": 4,
      "start": 4886.0,
      "end": 4890.0,
      "formatted_start": "01:21:26.000",
      "formatted_end": "01:21:30.000",
      "text": "خب ببینی این شربت هاش روزی سه بار"
    },
    {
      "id": 5,
      "start": 4890.0,
      "end": 4893.0,
      "formatted_start": "01:21:30.000",
      "formatted_end": "01:21:33.000",
      "text": "دو تا مانخول داره ارامبیدی بزنه"
    },
    {
      "id": 6,
      "start": 4893.0,
      "end": 4897.0,
      "formatted_start": "01:21:33.000",
      "formatted_end": "01:21:37.000",
      "text": "اوه دکتر اما مثلا سرگاه خودتو روشش و سراپورمشی نداره"
    },
    {
      "id": 7,
      "start": 4897.0,
      "end": 4900.0,
      "formatted_start": "01:21:37.000",
      "formatted_end": "01:21:40.000",
      "text": "اشتباهاتی نداره بسیار مانخول زنه نداره"
    },
    {
