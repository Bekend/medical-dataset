  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3629.98,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3632.0,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:32.000",
      "text": "این رو میبینیم"
    },
    {
      "id": 2,
      "start": 3632.0,
      "end": 3634.0,
      "formatted_start": "01:00:32.000",
      "formatted_end": "01:00:34.000",
      "text": "این رو میبینیم"
    },
    {
      "id": 3,
      "start": 3634.0,
      "end": 3636.0,
      "formatted_start": "01:00:34.000",
      "formatted_end": "01:00:36.000",
      "text": "این گوشته"
    },
    {
      "id": 4,
      "start": 3636.0,
      "end": 3638.0,
      "formatted_start": "01:00:36.000",
      "formatted_end": "01:00:38.000",
      "text": "این راحت شد"
    },
    {
      "id": 5,
      "start": 3638.0,
      "end": 3640.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:40.000",
      "text": "خانم بیا خانم"
    },
    {
      "id": 6,
      "start": 3640.0,
      "end": 3642.0,
      "formatted_start": "01:00:40.000",
      "formatted_end": "01:00:42.000",
      "text": "مادر"
    },
    {
      "id": 7,
      "start": 3642.0,
      "end": 3644.0,
      "formatted_start": "01:00:42.000",
      "formatted_end": "01:00:44.000",
      "text": "خانم آره این"
    },
    {
      "id": 8,
      "start": 3648.0,
      "end": 3650.0,
      "formatted_start": "01:00:48.000",
      "formatted_end": "01:00:50.000",
      "text": "همش"
    },
    {
      "id": 9,
      "start": 3650.0,
      "end": 3652.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:52.000",
      "text": "ببین"
    },
    {
      "id": 10,
      "start": 3660.0,
      "end": 3670.0,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:10.000",
      "text": "ببینید که همون نیمی برید و همون نبست"
    },
    {
      "id": 11,
      "start": 3670.0,
      "end": 3675.0,
      "formatted_start": "01:01:10.000",
      "formatted_end": "01:01:15.000",
      "text": "چسبار هم باز نکنید و بچه سکن آروم باشد"
    },
    {
      "id": 12,
      "start": 3675.0,
      "end": 3679.0,
      "formatted_start": "01:01:15.000",
      "formatted_end": "01:01:19.000",
      "text": "خیلی خوبید باشد"
    },
    {
      "id": 13,
      "start": 3690.0,
      "end": 3692.0,
      "formatted_start": "01:01:30.000",
      "formatted_end": "01:01:32.000",
      "text": "باید بردارید"
    },
    {
      "id": 14,
      "start": 3700.0,
      "end": 3702.0,
      "formatted_start": "01:01:40.000",
      "formatted_end": "01:01:42.000",
      "text": "این بزرگاه خیلی بشه از این"
    },
    {
      "id": 15,
      "start": 3704.0,
      "end": 3706.0,
      "formatted_start": "01:01:44.000",
      "formatted_end": "01:01:46.000",
      "text": "همس نمیشه گرفت نمیشه"
    },
    {
      "id": 16,
      "start": 3706.0,
      "end": 3708.0,
      "formatted_start": "01:01:46.000",
      "formatted_end": "01:01:48.000",
      "text": "بزرگاه همون"
    },
    {
      "id": 17,
      "start": 3708.0,
      "end": 3710.0,
      "formatted_start": "01:01:48.000",
      "formatted_end": "01:01:50.000",
      "text": "سرده شده"
    },
    {
      "id": 18,
      "start": 3716.0,
      "end": 3718.0,
      "formatted_start": "01:01:56.000",
      "formatted_end": "01:01:58.000",
      "text": "سلام"
    },
    {
      "id": 19,
      "start": 3718.0,
      "end": 3722.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:02.000",
      "text": "شهرتاش کشوقهای غذا خورید رو تنخونم دارید تفلوکی"
    },
    {
      "id": 20,
      "start": 3722.0,
      "end": 3723.0,
      "formatted_start": "01:02:02.000",
      "formatted_end": "01:02:03.000",
      "text": "براشونیم"
    },
    {
      "id": 21,
      "start": 3723.0,
      "end": 3725.0,
      "formatted_start": "01:02:03.000",
      "formatted_end": "01:02:05.000",
      "text": "بسیاریم خیلی عافیم"
    },
    {
      "id": 22,
      "start": 3725.0,
      "end": 3726.0,
      "formatted_start": "01:02:05.000",
      "formatted_end": "01:02:06.000",
      "text": "خداحافیم زیر جا باشیم"
    },
    {
      "id": 23,
      "start": 3726.0,
      "end": 3727.0,
      "formatted_start": "01:02:06.000",
      "formatted_end": "01:02:07.000",
      "text": "بکنیم"
    },
    {
      "id": 24,
      "start": 3732.0,
      "end": 3733.0,
      "formatted_start": "01:02:12.000",
      "formatted_end": "01:02:13.000",
      "text": "حالا همجاییم"
    },
    {
      "id": 25,
      "start": 3738.0,
      "end": 3741.0,
      "formatted_start": "01:02:18.000",
      "formatted_end": "01:02:21.000",
      "text": "خانه صند بابوانی و بابداری سراسر کشورم"
    },
    {
      "id": 26,
      "start": 3741.0,
      "end": 3750.2,
      "formatted_start": "01:02:21.000",
      "formatted_end": "01:02:30.200",
      "text": "در این کار نقش دشتک های آبیاری رو که در واقعی نقش دومنزونه دارن"
    },
    {
      "id": 27,
      "start": 3750.2,
      "end": 3753.5,
      "formatted_start": "01:02:30.200",
      "formatted_end": "01:02:33.500",
      "text": "الان با این دشتک آبیاری هستن مالچه کوششی هستن"
    },
    {
      "id": 28,
      "start": 3753.5,
      "end": 3763.82,
      "formatted_start": "01:02:33.500",
      "formatted_end": "01:02:43.820",
      "text": "نوره ساغه نمال های جوان و هم در آبیاری و جمعیده اتلاقی مطورت کمک میکنن"
    },
    {
      "id": 29,
      "start": 3763.82,
      "end": 3767.9,
      "formatted_start": "01:02:43.820",
      "formatted_end": "01:02:47.900",
      "text": "و هم جمعیدی میکنن از رشده و ترس"
    },
    {
      "id": 30,
      "start": 3767.9,
      "end": 3781.7,
      "formatted_start": "01:02:47.900",
      "formatted_end": "01:03:01.700",
      "text": "مشاهده میپرمایید که این روشت رویشی نهال ها اثرگذار بوده در حالی که در ودیف همچوار ما صرفا از مارچ کوششی استفاده کردیم"
    },
    {
      "id": 31,
      "start": 3781.7,
      "end": 3788.2,
      "formatted_start": "01:03:01.700",
      "formatted_end": "01:03:08.200",
      "text": "میبینید که نهال ها بسیار ضعیف و رویشی ناحتموی دارن"
    },
    {
      "id": 32,
      "start": 3788.2,
      "end": 3793.08,
      "formatted_start": "01:03:08.200",
      "formatted_end": "01:03:13.080",
      "text": "بنابراین استفاده از این تشتک های آبیاری بسیار راخوشاب هست"
    },
    {
      "id": 33,
      "start": 3793.08,
      "end": 3803.96,
      "formatted_start": "01:03:13.080",
      "formatted_end": "01:03:23.960",
      "text": "ما بدون اینکه از سم مینوز استفاده بکنیم به صورت هفتهی در این نحال های جوان رشد رویشی اطلاعستانه خیلی خوبی رو داریم"
    },
    {
      "id": 34,
      "start": 3803.96,
      "end": 3816.48,
      "formatted_start": "01:03:23.960",
      "formatted_end": "01:03:36.480",
      "text": "و هیچ نیازی هم به سم باشی هفتهی برای کنترول مینوز نیست و نحال مینوز این شده شو محافظت بکنه در محابه داخل دو بیماری ها"
    },
    {
      "id": 35,
      "start": 3816.48,
      "end": 3821.26,
      "formatted_start": "01:03:36.480",
      "formatted_end": "01:03:41.260",
      "text": "دروب در علاقه منده های سند باقوانی و باقداری سراسر کشتر"
    },
    {
      "id": 36,
      "start": 3821.26,
      "end": 3830.12,
      "formatted_start": "01:03:41.260",
      "formatted_end": "01:03:50.120",
      "text": "در این باقی نقش تشتک های آبیاری رو که در واقعی نقش دومانزونه دارن"
    },
    {
      "id": 37,
      "start": 3830.12,
      "end": 3834.52,
      "formatted_start": "01:03:50.120",
      "formatted_end": "01:03:54.520",
      "text": "علاوه برای که تشتک آبیاری هستن، مارچه کوششی هستن دوره"
    },
    {
      "id": 38,
      "start": 3834.52,
      "end": 3843.72,
      "formatted_start": "01:03:54.520",
      "formatted_end": "01:04:03.720",
      "text": "ساقه نمال های جوان و هم در آبیاری و جنگیری از اطلاعات روی مطورت کمک می کنن"
    },
    {
      "id": 39,
      "start": 3843.72,
      "end": 3847.0,
      "formatted_start": "01:04:03.720",
      "formatted_end": "01:04:07.000",
      "text": "و هم جنگیری کنن از آبیاری"
    },
    {
      "id": 40,
      "start": 3847.0,
      "end": 3848.9,
      "formatted_start": "01:04:07.000",
      "formatted_end": "01:04:08.900",
      "text": "بله، بفرمایی، خواهش می کنم"
    },
    {
      "id": 41,
      "start": 3848.9,
      "end": 3857.9,
      "formatted_start": "01:04:08.900",
      "formatted_end": "01:04:17.900",
      "text": "خانم زارک زیاره چی شده بابا جان؟"
    },
    {
      "id": 42,
      "start": 3857.9,
      "end": 3860.9,
      "formatted_start": "01:04:17.900",
      "formatted_end": "01:04:20.900",
      "text": "نه نه آقا دکتر چهار روز تب داشته"
    },
    {
      "id": 43,
      "start": 3860.9,
      "end": 3861.9,
      "formatted_start": "01:04:20.900",
      "formatted_end": "01:04:21.900",
      "text": "تب خوب؟"
    },
    {
      "id": 44,
      "start": 3861.9,
      "end": 3865.9,
      "formatted_start": "01:04:21.900",
      "formatted_end": "01:04:25.900",
      "text": "بله یه بوی گلیش از همه مبینده شو صرفه میکرد اینجا که بالا بیاره"
    },
    {
      "id": 45,
      "start": 3865.9,
      "end": 3867.9,
      "formatted_start": "01:04:25.900",
      "formatted_end": "01:04:27.900",
      "text": "صرفه خوب؟"
    },
    {
      "id": 46,
      "start": 3867.9,
      "end": 3869.9,
      "formatted_start": "01:04:27.900",
      "formatted_end": "01:04:29.900",
      "text": "بله هنوان هم اصحال شده بله زوره"
    },
    {
      "id": 47,
      "start": 3869.9,
      "end": 3871.9,
      "formatted_start": "01:04:29.900",
      "formatted_end": "01:04:31.900",
      "text": "هنوان صرفه هم داره یا نه؟"
    },
    {
      "id": 48,
      "start": 3871.9,
      "end": 3874.9,
      "formatted_start": "01:04:31.900",
      "formatted_end": "01:04:34.900",
      "text": "صرفه خزدان داره اینجا گلیش گیر میکنه"
    },
    {
      "id": 49,
      "start": 3874.9,
      "end": 3875.9,
      "formatted_start": "01:04:34.900",
      "formatted_end": "01:04:35.900",
      "text": "هنوان افتخار صرفه میزده؟"
    },
    {
      "id": 50,
      "start": 3875.9,
      "end": 3876.9,
      "formatted_start": "01:04:35.900",
      "formatted_end": "01:04:36.900",
      "text": "بله صرفه میزده"
    },
    {
      "id": 51,
      "start": 3876.9,
      "end": 3878.9,
      "formatted_start": "01:04:36.900",
      "formatted_end": "01:04:38.900",
      "text": "و اصحالم هست"
    },
    {
      "id": 52,
      "start": 3878.9,
      "end": 3880.9,
      "formatted_start": "01:04:38.900",
      "formatted_end": "01:04:40.900",
      "text": "اصحال بعد از بوره اصحال شده"
    },
    {
      "id": 53,
      "start": 3880.9,
      "end": 3882.9,
      "formatted_start": "01:04:40.900",
      "formatted_end": "01:04:42.900",
      "text": "مثل آب یا شلو چسمنده"
    },
    {
      "id": 54,
      "start": 3882.9,
      "end": 3884.9,
      "formatted_start": "01:04:42.900",
      "formatted_end": "01:04:44.900",
      "text": "شلو چسمنده"
    },
    {
      "id": 55,
      "start": 3884.9,
      "end": 3886.9,
      "formatted_start": "01:04:44.900",
      "formatted_end": "01:04:46.900",
      "text": "خونم داشته؟ نه"
    },
    {
      "id": 56,
      "start": 3886.9,
      "end": 3888.9,
      "formatted_start": "01:04:46.900",
      "formatted_end": "01:04:48.900",
      "text": "خب این هست به تحقیق داریم"
    },
    {
      "id": 57,
      "start": 3894.9,
      "end": 3896.9,
      "formatted_start": "01:04:54.900",
      "formatted_end": "01:04:56.900",
      "text": "خب"
    },
    {
      "id": 58,
      "start": 3896.9,
      "end": 3898.9,
      "formatted_start": "01:04:56.900",
      "formatted_end": "01:04:58.900",
      "text": "شما این بالا باید بسیارش"
    },
    {
      "id": 59,
      "start": 3898.9,
      "end": 3900.9,
      "formatted_start": "01:04:58.900",
      "formatted_end": "01:05:00.900",
      "text": "شما پایش نیست"
    }
  ],
  "status": "completed"
}