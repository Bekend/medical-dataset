  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3029.98,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:29.980",
      "text": "برنامه بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 3030.0,
      "end": 3032.0,
      "formatted_start": "00:50:30.000",
      "formatted_end": "00:50:32.000",
      "text": "موضوع باشه"
    },
    {
      "id": 2,
      "start": 3032.0,
      "end": 3034.0,
      "formatted_start": "00:50:32.000",
      "formatted_end": "00:50:34.000",
      "text": "طب شدید یا خبزید؟"
    },
    {
      "id": 3,
      "start": 3034.0,
      "end": 3036.0,
      "formatted_start": "00:50:34.000",
      "formatted_end": "00:50:36.000",
      "text": "نمیشه باب شدید"
    },
    {
      "id": 4,
      "start": 3036.0,
      "end": 3038.0,
      "formatted_start": "00:50:36.000",
      "formatted_end": "00:50:38.000",
      "text": "اسفالش مثل آبی یا شون شسفنده؟"
    },
    {
      "id": 5,
      "start": 3038.0,
      "end": 3040.0,
      "formatted_start": "00:50:38.000",
      "formatted_end": "00:50:40.000",
      "text": "شون شسفنده"
    },
    {
      "id": 6,
      "start": 3040.0,
      "end": 3042.0,
      "formatted_start": "00:50:40.000",
      "formatted_end": "00:50:42.000",
      "text": "میگم زیادا نمیشه به شبه سال"
    },
    {
      "id": 7,
      "start": 3042.0,
      "end": 3044.0,
      "formatted_start": "00:50:42.000",
      "formatted_end": "00:50:44.000",
      "text": "نیمه سال؟"
    },
    {
      "id": 8,
      "start": 3044.0,
      "end": 3046.0,
      "formatted_start": "00:50:44.000",
      "formatted_end": "00:50:46.000",
      "text": "نیمه سال"
    },
    {
      "id": 9,
      "start": 3046.0,
      "end": 3048.0,
      "formatted_start": "00:50:46.000",
      "formatted_end": "00:50:48.000",
      "text": "یا عشقون میشه"
    },
    {
      "id": 10,
      "start": 3048.0,
      "end": 3050.0,
      "formatted_start": "00:50:48.000",
      "formatted_end": "00:50:50.000",
      "text": "شبه سال"
    },
    {
      "id": 11,
      "start": 3050.0,
      "end": 3052.0,
      "formatted_start": "00:50:50.000",
      "formatted_end": "00:50:52.000",
      "text": "رنگون نیست"
    },
    {
      "id": 12,
      "start": 3052.0,
      "end": 3054.0,
      "formatted_start": "00:50:52.000",
      "formatted_end": "00:50:54.000",
      "text": "رنگون نیست"
    },
    {
      "id": 13,
      "start": 3054.0,
      "end": 3056.0,
      "formatted_start": "00:50:54.000",
      "formatted_end": "00:50:56.000",
      "text": "رنگون نیست"
    },
    {
      "id": 14,
      "start": 3056.0,
      "end": 3058.0,
      "formatted_start": "00:50:56.000",
      "formatted_end": "00:50:58.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 15,
      "start": 3062.8,
      "end": 3064.8,
      "formatted_start": "00:51:02.800",
      "formatted_end": "00:51:04.800",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 16,
      "start": 3081.6,
      "end": 3083.6,
      "formatted_start": "00:51:21.600",
      "formatted_end": "00:51:23.600",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 17,
      "start": 3086.0,
      "end": 3088.0,
      "formatted_start": "00:51:26.000",
      "formatted_end": "00:51:28.000",
      "text": "خب"
    },
    {
      "id": 18,
      "start": 3088.0,
      "end": 3092.0,
      "formatted_start": "00:51:28.000",
      "formatted_end": "00:51:32.000",
      "text": "بله این که خونه رو دیگه کرده دست دهنش اینا میزنه؟"
    },
    {
      "id": 19,
      "start": 3092.0,
      "end": 3095.0,
      "formatted_start": "00:51:32.000",
      "formatted_end": "00:51:35.000",
      "text": "دست دهن دندوناش اینا میزنه؟"
    },
    {
      "id": 20,
      "start": 3095.0,
      "end": 3096.0,
      "formatted_start": "00:51:35.000",
      "formatted_end": "00:51:36.000",
      "text": "دستش کنشو تو دهن شو"
    },
    {
      "id": 21,
      "start": 3096.0,
      "end": 3098.0,
      "formatted_start": "00:51:36.000",
      "formatted_end": "00:51:38.000",
      "text": "دستشو رو نصبشون گرده"
    },
    {
      "id": 22,
      "start": 3098.0,
      "end": 3100.0,
      "formatted_start": "00:51:38.000",
      "formatted_end": "00:51:40.000",
      "text": "برای سه آرومدگی میشه"
    },
    {
      "id": 23,
      "start": 3100.0,
      "end": 3104.0,
      "formatted_start": "00:51:40.000",
      "formatted_end": "00:51:44.000",
      "text": "اگه طب زیاده یکی دوتا تزگگی بدیسه"
    },
    {
      "id": 24,
