      "formatted_end": "01:10:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 4230.0,
      "end": 4260.0,
      "formatted_start": "01:10:30.000",
      "formatted_end": "01:11:00.000",
      "text": "اینکه این کار را برای از این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای ا"
    },
    {
      "id": 2,
      "start": 4260.0,
      "end": 4289.98,
      "formatted_start": "01:11:00.000",
      "formatted_end": "01:11:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 3,
      "start": 4290.0,
      "end": 4318.0,
      "formatted_start": "01:11:30.000",
      "formatted_end": "01:11:58.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 4318.0,
      "end": 4326.0,
      "formatted_start": "01:11:58.000",
      "formatted_end": "01:12:06.000",
      "text": "ببین این روزی سه بار، این سپیده دو بار روش نوشته"
    },
    {
      "id": 5,
      "start": 4326.0,
      "end": 4330.0,
      "formatted_start": "01:12:06.000",
      "formatted_end": "01:12:10.000",
      "text": "از تا بین کن دو برابر وزدش، وزدش چند کیلوهه؟"
    },
    {
      "id": 6,
      "start": 4330.0,
      "end": 4334.0,
      "formatted_start": "01:12:10.000",
      "formatted_end": "01:12:14.000",
      "text": "چارده قطعه میدیم، آن پولش هم برین برین"
    },
    {
      "id": 7,
      "start": 4334.0,
      "end": 4336.0,
      "formatted_start": "01:12:14.000",
      "formatted_end": "01:12:16.000",
      "text": "اینجا ببین"
    },
    {
      "id": 8,
      "start": 4340.0,
      "end": 4345.0,
      "formatted_start": "01:12:20.000",
      "formatted_end": "01:12:25.000",
      "text": "زندگی را از دونه دونه، همه مستوایی کچکه"
    },
    {
      "id": 9,
      "start": 4345.0,
      "end": 4355.0,
      "formatted_start": "01:12:25.000",
      "formatted_end": "01:12:35.000",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 4375.0,
      "end": 4405.0,
      "formatted_start": "01:12:55.000",
      "formatted_end": "01:13:25.000",
      "text": "از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت"
    },
    {
      "id": 11,
      "start": 4405.0,
      "end": 4424.0,
      "formatted_start": "01:13:25.000",
      "formatted_end": "01:13:44.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 4424.0,
      "end": 4426.0,
      "formatted_start": "01:13:44.000",
      "formatted_end": "01:13:46.000",
      "text": "خدا سلام جماعت داری"
    },
    {
      "id": 13,
      "start": 4426.0,
      "end": 4428.0,
      "formatted_start": "01:13:46.000",
      "formatted_end": "01:13:48.000",
      "text": "وقتتون به خیلی"
    },
    {
      "id": 14,
      "start": 4428.0,
      "end": 4429.0,
      "formatted_start": "01:13:48.000",
      "formatted_end": "01:13:49.000",
      "text": "خوب هستیم"
    },
    {
      "id": 15,
      "start": 4429.0,
      "end": 4431.0,
      "formatted_start": "01:13:49.000",
      "formatted_end": "01:13:51.000",
      "text": "اصفرین پانمند اوسیبای هستم"
    },
    {
      "id": 16,
      "start": 4431.0,
      "end": 4437.0,
      "formatted_start": "01:13:51.000",
      "formatted_end": "01:13:57.000",
      "text": "دوست دیگه های اصلا پدر حسام بیمار بهتون که به سفر مشابهه اومده بود"
    },
    {
      "id": 17,
      "start": 4437.0,
      "end": 4445.0,
      "formatted_start": "01:13:57.000",
      "formatted_end": "01:14:05.000",
      "text": "از مجالسان اون حد فردی یه ماه پیشتر اینجا نیست و زمانش محدوده"
    },
    {
      "id": 18,
      "start": 4445.0,
      "end": 4450.0,
      "formatted_start": "01:14:05.000",
      "formatted_end": "01:14:10.000",
      "text": "جلساتشو متصدقانه این را به چه ترقید عقب میفته"
    },
    {
      "id": 19,
      "start": 4450.0,
      "end": 4460.0,
      "formatted_start": "01:14:10.000",
      "formatted_end": "01:14:20.000",
      "text": "خواستم خواهش کنم اگر براتون امکان داره این را یه مدت تصدیق کنید که برام تایم رفتنش نزدیک نشد"
    },
    {
      "id": 20,
      "start": 4460.0,
      "end": 4465.0,
      "formatted_start": "01:14:20.000",
      "formatted_end": "01:14:25.000",
      "text": "حالا کارهای شما هم یک کارهای اصلا زمان بعد مثلا با یک جلسه"
    },
    {
      "id": 21,
      "start": 4465.0,
      "end": 4468.0,
      "formatted_start": "01:14:25.000",
      "formatted_end": "01:14:28.000",
      "text": "بله"
    },
    {
      "id": 22,
      "start": 4468.0,
      "end": 4472.0,
      "formatted_start": "01:14:28.000",
      "formatted_end": "01:14:32.000",
      "text": "بله خوشید"
    },
    {
      "id": 23,
      "start": 4472.0,
      "end": 4476.0,
      "formatted_start": "01:14:32.000",
      "formatted_end": "01:14:36.000",
      "text": "خوبستی"
    },
    {
      "id": 24,
      "start": 4476.0,
      "end": 4479.0,
      "formatted_start": "01:14:36.000",
      "formatted_end": "01:14:39.000",
      "text": "انشاله سلامتی بشید"
    },
    {
      "id": 25,
      "start": 4479.0,
      "end": 4482.0,
      "formatted_start": "01:14:39.000",
      "formatted_end": "01:14:42.000",
      "text": "بله خوشید"
    },
    {
      "id": 26,
      "start": 4482.0,
      "end": 4485.0,
      "formatted_start": "01:14:42.000",
      "formatted_end": "01:14:45.000",
      "text": "زندگی"
    },
    {
      "id": 27,
      "start": 4485.0,
      "end": 4489.0,
      "formatted_start": "01:14:45.000",
      "formatted_end": "01:14:49.000",
      "text": "زنده باشه، الان بویا دوشنده فکر کنم وقت دادن دیگر"
    },
    {
      "id": 28,
      "start": 4489.0,
      "end": 4494.0,
      "formatted_start": "01:14:49.000",
      "formatted_end": "01:14:54.000",
      "text": "اگر مایوت کنیم به هر صورت بتونی چیز کنم نیشونیم"
    },
    {
      "id": 29,
      "start": 4494.0,
      "end": 4498.0,
      "formatted_start": "01:14:54.000",
      "formatted_end": "01:14:58.000",
      "text": "زنده باشیم، این شبها که صلاحاتی راستر بشه"
    },
    {
      "id": 30,
      "start": 4498.0,
      "end": 4500.0,
      "formatted_start": "01:14:58.000",
      "formatted_end": "01:15:00.000",
      "text": "خواستم اول چهارت اطلاع"
    }
  ],
