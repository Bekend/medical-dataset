      "formatted_end": "00:55:26.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3330.0,
      "end": 3350.0,
      "formatted_start": "00:55:30.000",
      "formatted_end": "00:55:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 3350.0,
      "end": 3352.0,
      "formatted_start": "00:55:50.000",
      "formatted_end": "00:55:52.000",
      "text": "بزرگ هم خیلی بزرگ باز"
    },
    {
      "id": 3,
      "start": 3352.0,
      "end": 3354.0,
      "formatted_start": "00:55:52.000",
      "formatted_end": "00:55:54.000",
      "text": "یه پولیه"
    },
    {
      "id": 4,
      "start": 3354.0,
      "end": 3356.0,
      "formatted_start": "00:55:54.000",
      "formatted_end": "00:55:56.000",
      "text": "پولیه"
    },
    {
      "id": 5,
      "start": 3356.0,
      "end": 3358.0,
      "formatted_start": "00:55:56.000",
      "formatted_end": "00:55:58.000",
      "text": "بزرگ پولیه"
    },
    {
      "id": 6,
      "start": 3358.0,
      "end": 3360.0,
      "formatted_start": "00:55:58.000",
      "formatted_end": "00:56:00.000",
      "text": "خب این درم ببندیم"
    },
    {
      "id": 7,
      "start": 3360.0,
      "end": 3362.0,
      "formatted_start": "00:56:00.000",
      "formatted_end": "00:56:02.000",
      "text": "یه نفر داریم"
    },
    {
      "id": 8,
      "start": 3362.0,
      "end": 3364.0,
      "formatted_start": "00:56:02.000",
      "formatted_end": "00:56:04.000",
      "text": "نفر من"
    },
    {
      "id": 9,
      "start": 3364.0,
      "end": 3366.0,
      "formatted_start": "00:56:04.000",
      "formatted_end": "00:56:06.000",
      "text": "یک نفر"
    },
    {
      "id": 10,
      "start": 3366.0,
      "end": 3368.0,
      "formatted_start": "00:56:06.000",
      "formatted_end": "00:56:08.000",
      "text": "نه نه"
    },
    {
      "id": 11,
      "start": 3368.0,
      "end": 3370.0,
      "formatted_start": "00:56:08.000",
      "formatted_end": "00:56:10.000",
      "text": "نه خب درم داشته باقی نیست"
    },
    {
      "id": 12,
      "start": 3370.0,
      "end": 3372.0,
      "formatted_start": "00:56:10.000",
      "formatted_end": "00:56:12.000",
      "text": "همه کار نداریم"
    },
    {
      "id": 13,
      "start": 3372.0,
      "end": 3374.0,
      "formatted_start": "00:56:12.000",
      "formatted_end": "00:56:14.000",
      "text": "همه کار نداریم"
    },
    {
      "id": 14,
      "start": 3374.0,
      "end": 3376.0,
      "formatted_start": "00:56:14.000",
      "formatted_end": "00:56:16.000",
      "text": "شما اون خوشباییستی؟"
    },
    {
      "id": 15,
      "start": 3376.0,
      "end": 3380.0,
      "formatted_start": "00:56:16.000",
      "formatted_end": "00:56:20.000",
      "text": "از این درش بیرون"
    },
    {
      "id": 16,
      "start": 3380.0,
      "end": 3384.0,
      "formatted_start": "00:56:20.000",
      "formatted_end": "00:56:24.000",
      "text": "از این درش بیرون"
    },
    {
      "id": 17,
      "start": 3384.0,
      "end": 3388.0,
      "formatted_start": "00:56:24.000",
      "formatted_end": "00:56:28.000",
      "text": "این را بسط بذار بیرون"
    },
    {
      "id": 18,
      "start": 3388.0,
      "end": 3392.0,
      "formatted_start": "00:56:28.000",
      "formatted_end": "00:56:32.000",
      "text": "این را باید دنبال داریم"
    },
    {
      "id": 19,
      "start": 3392.0,
      "end": 3396.0,
      "formatted_start": "00:56:32.000",
      "formatted_end": "00:56:36.000",
      "text": "این هم گنده هست"
    },
    {
      "id": 20,
      "start": 3396.0,
      "end": 3400.0,
      "formatted_start": "00:56:36.000",
      "formatted_end": "00:56:40.000",
      "text": "این هم خیلی گنده هست"
    },
    {
      "id": 21,
      "start": 3400.0,
      "end": 3404.0,
      "formatted_start": "00:56:40.000",
      "formatted_end": "00:56:44.000",
      "text": "این هم گرده هست"
    },
    {
      "id": 22,
      "start": 3404.0,
      "end": 3407.0,
      "formatted_start": "00:56:44.000",
      "formatted_end": "00:56:47.000",
      "text": "این تیغا کچک داشتن خواستن؟"
    },
    {
      "id": 23,
      "start": 3407.0,
      "end": 3409.0,
      "formatted_start": "00:56:47.000",
      "formatted_end": "00:56:49.000",
      "text": "تیغا کچک داشتن"
    },
    {
      "id": 24,
      "start": 3409.0,
      "end": 3410.0,
      "formatted_start": "00:56:49.000",
      "formatted_end": "00:56:50.000",
      "text": "بادر؟"
    },
    {
      "id": 25,
      "start": 3410.0,
      "end": 3411.0,
      "formatted_start": "00:56:50.000",
      "formatted_end": "00:56:51.000",
      "text": "کچک داشتن"
    },
    {
      "id": 26,
      "start": 3411.0,
      "end": 3413.0,
      "formatted_start": "00:56:51.000",
      "formatted_end": "00:56:53.000",
      "text": "این ریز باسه راحتتر"
    },
    {
      "id": 27,
      "start": 3424.0,
      "end": 3426.0,
      "formatted_start": "00:57:04.000",
      "formatted_end": "00:57:06.000",
      "text": "اوه، این یه مادر لرم نیز لرم"
    },
    {
      "id": 28,
      "start": 3426.0,
      "end": 3428.0,
      "formatted_start": "00:57:06.000",
      "formatted_end": "00:57:08.000",
      "text": "اینو باید به دکتر دیگه خواستن"
    },
    {
      "id": 29,
      "start": 3428.0,
      "end": 3429.0,
      "formatted_start": "00:57:08.000",
      "formatted_end": "00:57:09.000",
      "text": "بیا دیگه"
    },
    {
      "id": 30,
      "start": 3429.0,
      "end": 3430.0,
      "formatted_start": "00:57:09.000",
      "formatted_end": "00:57:10.000",
      "text": "برای"
    },
    {
      "id": 31,
      "start": 3430.0,
      "end": 3436.0,
      "formatted_start": "00:57:10.000",
      "formatted_end": "00:57:16.000",
      "text": "از این سیاه ها خوبه"
    },
    {
      "id": 32,
      "start": 3436.0,
      "end": 3444.0,
      "formatted_start": "00:57:16.000",
      "formatted_end": "00:57:24.000",
      "text": "ببین آقای نورین"
    },
    {
      "id": 33,
      "start": 3444.0,
      "end": 3448.0,
      "formatted_start": "00:57:24.000",
      "formatted_end": "00:57:28.000",
      "text": "اینجا رو نگه دار"
    },
    {
      "id": 34,
      "start": 3448.0,
      "end": 3452.0,
      "formatted_start": "00:57:28.000",
      "formatted_end": "00:57:32.000",
      "text": "یکی هم تست پای بچه رو برام نگه دار"
    },
    {
      "id": 35,
      "start": 3452.0,
      "end": 3456.0,
      "formatted_start": "00:57:32.000",
      "formatted_end": "00:57:36.000",
      "text": "این تست هاش رو نگه دار"
    },
