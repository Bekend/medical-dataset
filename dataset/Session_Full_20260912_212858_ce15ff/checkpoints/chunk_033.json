  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9910.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:10.000",
      "text": "مردم شام میشه مکارانی و مستقیم برون."
    },
    {
      "id": 1,
      "start": 9910.0,
      "end": 9913.0,
      "formatted_start": "02:45:10.000",
      "formatted_end": "02:45:13.000",
      "text": "نه چپ نه راست بیری میشه بیرونش."
    },
    {
      "id": 2,
      "start": 9913.0,
      "end": 9915.0,
      "formatted_start": "02:45:13.000",
      "formatted_end": "02:45:15.000",
      "text": "میخواهی مرکزشی؟ آمین."
    },
    {
      "id": 3,
      "start": 9915.0,
      "end": 9918.0,
      "formatted_start": "02:45:15.000",
      "formatted_end": "02:45:18.000",
      "text": "ببین؟ تابلارم هبه، همین راست برون."
    },
    {
      "id": 4,
      "start": 9918.0,
      "end": 9919.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:19.000",
      "text": "این؟"
    },
    {
      "id": 5,
      "start": 9919.0,
      "end": 9922.0,
      "formatted_start": "02:45:19.000",
      "formatted_end": "02:45:22.000",
      "text": "آره همینو برون. راه نما بزن."
    },
    {
      "id": 6,
      "start": 9922.0,
      "end": 9923.0,
      "formatted_start": "02:45:22.000",
      "formatted_end": "02:45:23.000",
      "text": "گلی کشی."
    },
    {
      "id": 7,
      "start": 9923.0,
      "end": 9926.0,
      "formatted_start": "02:45:23.000",
      "formatted_end": "02:45:26.000",
      "text": "آرام آرام، آرام آرام شام آرام."
    },
    {
      "id": 8,
      "start": 9926.0,
      "end": 9929.0,
      "formatted_start": "02:45:26.000",
      "formatted_end": "02:45:29.000",
      "text": "شام آرام، اصلا اینجا خیلی آرام برون."
    },
    {
      "id": 9,
      "start": 9929.0,
      "end": 9931.0,
      "formatted_start": "02:45:29.000",
      "formatted_end": "02:45:31.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 10,
      "start": 9959.0,
      "end": 9982.0,
      "formatted_start": "02:45:59.000",
      "formatted_end": "02:46:22.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "همینجا چیز داریم که بزنم"
    },
    {
      "id": 12,
      "start": 9985.0,
      "end": 9987.0,
      "formatted_start": "02:46:25.000",
      "formatted_end": "02:46:27.000",
      "text": "توی یه درزه که باشگال جمعه نمیشه"
    },
    {
      "id": 13,
      "start": 9991.0,
      "end": 9993.0,
      "formatted_start": "02:46:31.000",
      "formatted_end": "02:46:33.000",
      "text": "بنابراین انجیرها چی کار کردی؟"
    },
    {
      "id": 14,
      "start": 9993.0,
      "end": 9996.0,
      "formatted_start": "02:46:33.000",
      "formatted_end": "02:46:36.000",
      "text": "باشم دیگه یه جاوی از هر گروه باشم"
    },
    {
      "id": 15,
      "start": 9997.0,
      "end": 10000.0,
      "formatted_start": "02:46:37.000",
      "formatted_end": "02:46:40.000",
      "text": "آه این روز دفتم کومیان آفتاب گرم"
    },
    {
      "id": 16,
      "start": 10000.0,
      "end": 10003.0,
      "formatted_start": "02:46:40.000",
      "formatted_end": "02:46:43.000",
      "text": "دفتیم رو درخت انجیر این انجیرها رو چیدم"
    },
    {
      "id": 17,
      "start": 10003.0,
      "end": 10006.0,
      "formatted_start": "02:46:43.000",
      "formatted_end": "02:46:46.000",
      "text": "آو پاییندم تمام بدنم خارشک گرفت"
    },
    {
      "id": 18,
      "start": 10006.0,
      "end": 10007.0,
      "formatted_start": "02:46:46.000",
      "formatted_end": "02:46:47.000",
      "text": "مشنگی میکنی؟"
    },
    {
      "id": 19,
      "start": 10007.0,
      "end": 10012.0,
      "formatted_start": "02:46:47.000",
      "formatted_end": "02:46:52.000",
      "text": "نه دیگه همجا لباس در آوردم پیران منو تو حیات"
    },
    {
      "id": 20,
      "start": 10012.0,
      "end": 10016.5,
      "formatted_start": "02:46:52.000",
      "formatted_end": "02:46:56.500",
      "text": "بعد این شیر و آبتون شلنگه انداختم از گردن من"
    },
    {
      "id": 21,
      "start": 10016.5,
      "end": 10017.5,
      "formatted_start": "02:46:56.500",
      "formatted_end": "02:46:57.500",
      "text": "سرد نبود"
    },
    {
      "id": 22,
      "start": 10017.5,
      "end": 10019.5,
      "formatted_start": "02:46:57.500",
      "formatted_end": "02:46:59.500",
      "text": "سرد یخ بود اصلا کیف میگردیم"
    },
    {
      "id": 23,
      "start": 10019.5,
      "end": 10021.5,
      "formatted_start": "02:46:59.500",
      "formatted_end": "02:47:01.500",
      "text": "سرده خیلی"
    },
    {
      "id": 24,
      "start": 10021.5,
      "end": 10023.5,
      "formatted_start": "02:47:01.500",
      "formatted_end": "02:47:03.500",
      "text": "اصلا همینجور دست داریم"
    },
    {
      "id": 25,
      "start": 10023.5,
      "end": 10025.5,
      "formatted_start": "02:47:03.500",
      "formatted_end": "02:47:05.500",
      "text": "آره چیکار کنم دیدم اصلا بدنم میخوره"
    },
    {
      "id": 26,
      "start": 10025.5,
      "end": 10027.5,
      "formatted_start": "02:47:05.500",
      "formatted_end": "02:47:07.500",
