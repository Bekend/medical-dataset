      "text": "اینجا باید بردارید."
    },
    {
      "id": 27,
      "start": 1770.0,
      "end": 1772.0,
      "formatted_start": "00:29:30.000",
      "formatted_end": "00:29:32.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 28,
      "start": 1772.0,
      "end": 1776.0,
      "formatted_start": "00:29:32.000",
      "formatted_end": "00:29:36.000",
      "text": "من درستم دارم، من درستم نارویستم"
    },
    {
      "id": 29,
      "start": 1776.0,
      "end": 1778.0,
      "formatted_start": "00:29:36.000",
      "formatted_end": "00:29:38.000",
      "text": "کجا شده درسته؟"
    },
    {
      "id": 30,
      "start": 1778.0,
      "end": 1782.0,
      "formatted_start": "00:29:38.000",
      "formatted_end": "00:29:42.000",
      "text": "از پنجه ها، یکونه ها درسته"
    },
    {
      "id": 31,
      "start": 1782.0,
      "end": 1783.0,
      "formatted_start": "00:29:42.000",
      "formatted_end": "00:29:43.000",
      "text": "آه نزدیک هست؟"
    },
    {
      "id": 32,
      "start": 1783.0,
      "end": 1785.0,
      "formatted_start": "00:29:43.000",
      "formatted_end": "00:29:45.000",
      "text": "آره، پیاده هست"
    },
    {
      "id": 33,
      "start": 1785.0,
      "end": 1788.0,
      "formatted_start": "00:29:45.000",
      "formatted_end": "00:29:48.000",
      "text": "از اینجا یکی همه چیزی برخورد"
    },
    {
      "id": 34,
      "start": 1788.0,
      "end": 1791.0,
      "formatted_start": "00:29:48.000",
      "formatted_end": "00:29:51.000",
      "text": "خوش زندگی نمی کنی؟ من خریده همی نمی برخورد"
    },
    {
      "id": 35,
      "start": 1791.0,
      "end": 1795.0,
      "formatted_start": "00:29:51.000",
      "formatted_end": "00:29:55.000",
      "text": "آره، من خریده هستم، یکی به سوالی هست خریده"
    },
    {
      "id": 36,
      "start": 1795.0,
      "end": 1799.0,
      "formatted_start": "00:29:55.000",
      "formatted_end": "00:29:59.000",
      "text": "یکی به سوالی جا خریده، چه سال وقت من بشکت خریده"
    },
    {
      "id": 37,
      "start": 1799.0,
      "end": 1800.0,
      "formatted_start": "00:29:59.000",
      "formatted_end": "00:30:00.000",
      "text": "من زندگی رو میکنم"
    }
  ],
