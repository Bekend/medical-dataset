    },
    {
      "id": 4,
      "start": 1610.0,
      "end": 1630.0,
      "formatted_start": "00:26:50.000",
      "formatted_end": "00:27:10.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 1630.0,
      "end": 1640.0,
      "formatted_start": "00:27:10.000",
      "formatted_end": "00:27:20.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 1660.0,
      "end": 1680.0,
      "formatted_start": "00:27:40.000",
      "formatted_end": "00:28:00.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 1690.0,
      "end": 1696.0,
      "formatted_start": "00:28:10.000",
      "formatted_end": "00:28:16.000",
      "text": "خیلی برگرده بود. اینجا هوا شهرچی و این ها است و بهترین ها خیلی برگرده بود."
    },
    {
      "id": 8,
      "start": 1696.0,
      "end": 1698.0,
      "formatted_start": "00:28:16.000",
      "formatted_end": "00:28:18.000",
      "text": "چون بازم نداریدن؟"
    },
    {
      "id": 9,
      "start": 1698.0,
      "end": 1703.0,
      "formatted_start": "00:28:18.000",
      "formatted_end": "00:28:23.000",
      "text": "نه زیاد ندارم. سابق خیلی برگرده بود. خیلی تنبان شدید."
    },
    {
      "id": 10,
      "start": 1703.0,
      "end": 1705.0,
      "formatted_start": "00:28:23.000",
      "formatted_end": "00:28:25.000",
      "text": "یعنی گازگاه اینجا یه آگه است؟"
    },
    {
      "id": 11,
      "start": 1705.0,
      "end": 1707.0,
      "formatted_start": "00:28:25.000",
      "formatted_end": "00:28:27.000",
      "text": "گاز. آره گاز کشی شد."
    },
    {
      "id": 12,
      "start": 1707.0,
      "end": 1709.0,
      "formatted_start": "00:28:27.000",
      "formatted_end": "00:28:29.000",
      "text": "کل گاز کشی میست که کن شهره اینجا؟"
    },
    {
      "id": 13,
      "start": 1709.0,
      "end": 1716.0,
      "formatted_start": "00:28:29.000",
      "formatted_end": "00:28:36.000",
      "text": "کنان تا بیان ساله با هر استفاده دورترا خوش میده بودن. کل شهرش گاز کشی شد."
    },
    {
      "id": 14,
      "start": 1716.0,
      "end": 1718.0,
      "formatted_start": "00:28:36.000",
      "formatted_end": "00:28:38.000",
      "text": "بسم الله الرحمن الرحیم"
    },
    {
      "id": 15,
      "start": 1746.0,
      "end": 1748.0,
      "formatted_start": "00:29:06.000",
      "formatted_end": "00:29:08.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 16,
      "start": 1748.0,
      "end": 1750.0,
      "formatted_start": "00:29:08.000",
      "formatted_end": "00:29:10.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 17,
      "start": 1750.0,
      "end": 1752.0,
      "formatted_start": "00:29:10.000",
