  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8130.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:30.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برد"
    },
    {
      "id": 1,
      "start": 8130.0,
      "end": 8133.0,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:15:33.000",
      "text": "ببین اینکه می کنیم براتونیت نگه"
    },
    {
      "id": 2,
      "start": 8133.0,
      "end": 8138.0,
      "formatted_start": "02:15:33.000",
      "formatted_end": "02:15:38.000",
      "text": "نکنه ازا باید من وقتی گرم می کنم من درم شخصیتی می کنم"
    },
    {
      "id": 3,
      "start": 8138.0,
      "end": 8143.0,
      "formatted_start": "02:15:38.000",
      "formatted_end": "02:15:43.000",
      "text": "من که بابا هم صورتش خود زندگی می کنیم هم گیرونی هست"
    },
    {
      "id": 4,
      "start": 8143.0,
      "end": 8146.0,
      "formatted_start": "02:15:43.000",
      "formatted_end": "02:15:46.000",
      "text": "بابا گیرونی هست همونطور که شما براتونیت خود بگیرونی"
    },
    {
      "id": 5,
      "start": 8146.0,
      "end": 8148.0,
      "formatted_start": "02:15:46.000",
      "formatted_end": "02:15:48.000",
      "text": "ببین در اینکه می کنیم کارهای مونیت که"
    },
    {
      "id": 6,
      "start": 8148.0,
      "end": 8150.0,
      "formatted_start": "02:15:48.000",
      "formatted_end": "02:15:50.000",
      "text": "بله"
    },
    {
      "id": 7,
      "start": 8152.0,
      "end": 8154.0,
      "formatted_start": "02:15:52.000",
      "formatted_end": "02:15:54.000",
      "text": "حالا سلام کجاییم؟"
    },
    {
      "id": 8,
      "start": 8156.0,
      "end": 8158.0,
      "formatted_start": "02:15:56.000",
      "formatted_end": "02:15:58.000",
      "text": "خب بیا"
    },
    {
      "id": 9,
      "start": 8158.0,
      "end": 8159.0,
      "formatted_start": "02:15:58.000",
      "formatted_end": "02:15:59.000",
      "text": "باشه باشه"
    },
    {
      "id": 10,
      "start": 8160.0,
      "end": 8162.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:02.000",
      "text": "باش"
    },
    {
      "id": 11,
      "start": 8175.76,
      "end": 8183.3,
      "formatted_start": "02:16:15.760",
      "formatted_end": "02:16:23.300",
      "text": "اصلا ببین پخت پز الان سخته دیگه مثلا همین الان مثلا کیک درست می کنن"
    },
    {
      "id": 12,
      "start": 8183.3,
      "end": 8186.42,
      "formatted_start": "02:16:23.300",
      "formatted_end": "02:16:26.420",
      "text": "دیسر آخوا اینا همه مواد دخلنده"
    },
    {
      "id": 13,
      "start": 8186.42,
      "end": 8189.88,
      "formatted_start": "02:16:26.420",
      "formatted_end": "02:16:29.880",
      "text": "ما چرا باکه نه اومدیم که ما اومدیم مهمانی"
    },
    {
      "id": 14,
      "start": 8189.88,
      "end": 8192.42,
      "formatted_start": "02:16:29.880",
      "formatted_end": "02:16:32.420",
      "text": "اونو میدونم"
    },
    {
      "id": 15,
      "start": 8192.42,
      "end": 8196.92,
      "formatted_start": "02:16:32.420",
      "formatted_end": "02:16:36.920",
      "text": "هرچندی میبینیم من احترامی اگه این کار را ندارم"
    },
    {
      "id": 16,
      "start": 8196.92,
      "end": 8198.42,
      "formatted_start": "02:16:36.920",
      "formatted_end": "02:16:38.420",
      "text": "خداحافظ"
    },
    {
      "id": 17,
      "start": 8216.42,
      "end": 8246.4,
      "formatted_start": "02:16:56.420",
      "formatted_end": "02:17:26.400",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 18,
      "start": 8246.42,
      "end": 8256.42,
      "formatted_start": "02:17:26.420",
      "formatted_end": "02:17:36.420",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 8276.42,
      "end": 8286.42,
      "formatted_start": "02:17:56.420",
      "formatted_end": "02:18:06.420",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 8306.42,
      "end": 8316.42,
      "formatted_start": "02:18:26.420",
      "formatted_end": "02:18:36.420",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 8336.42,
      "end": 8338.42,
      "formatted_start": "02:18:56.420",
      "formatted_end": "02:18:58.420",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 8366.42,
      "end": 8396.42,
      "formatted_start": "02:19:26.420",
      "formatted_end": "02:19:56.420",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 23,
      "start": 8396.42,
      "end": 8398.42,
      "formatted_start": "02:19:56.420",
      "formatted_end": "02:19:58.420",
      "text": "اینکه از خدا به درست داره انتقال کن"
    },
    {
      "id": 24,
      "start": 8398.42,
      "end": 8399.98,
      "formatted_start": "02:19:58.420",
      "formatted_end": "02:19:59.980",
      "text": "به درست داره انتقال کن"
    }
  ],
