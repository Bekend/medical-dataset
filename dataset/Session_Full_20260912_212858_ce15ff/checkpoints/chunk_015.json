  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4505.64,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:05.640",
      "text": "اما خدمت رو میگم شروعیتش اینجوریه چون اگه ایران بود، هیچ مشکلی نداشت."
    },
    {
      "id": 1,
      "start": 4505.64,
      "end": 4513.44,
      "formatted_start": "01:15:05.640",
      "formatted_end": "01:15:13.440",
      "text": "اگر ما هم صبر میگردیم، نباشه چون خاطر خالد از کشوری، اینجور میگه از دست دست تور میشه اینا دیگه."
    },
    {
      "id": 2,
      "start": 4513.44,
      "end": 4518.0,
      "formatted_start": "01:15:13.440",
      "formatted_end": "01:15:18.000",
      "text": "ممنون میشم از دست و ملیت کسی که اینجوریه. سفا سفاده داره."
    },
    {
      "id": 3,
      "start": 4518.0,
      "end": 4520.0,
      "formatted_start": "01:15:18.000",
      "formatted_end": "01:15:20.000",
      "text": "خوربانشان همدی باشید."
    },
    {
      "id": 4,
      "start": 4520.0,
      "end": 4522.0,
      "formatted_start": "01:15:20.000",
      "formatted_end": "01:15:22.000",
      "text": "دست، خداحافظ."
    },
    {
      "id": 5,
      "start": 4530.0,
      "end": 4559.98,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 6,
      "start": 4560.0,
      "end": 4570.98,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:10.980",
      "text": "اما دیگه کنه، وقتی خدا بخواد یه آدم رو قدرت مند کنه، اول نمیاد تاج بذاره رو سرش، بلکه اول اون آدم رو میشکنه."
    },
    {
      "id": 7,
      "start": 4571.84,
      "end": 4583.42,
      "formatted_start": "01:16:11.840",
      "formatted_end": "01:16:23.420",
      "text": "خدا آروم آروم راحتیاشو ازش میگه، برنامهاشو به هم میزنه، تا فقط اون چیزی که واقعیه بمونه، این تبیه نیست، آموزشه."
    },
    {
      "id": 8,
      "start": 4583.42,
      "end": 4586.74,
      "formatted_start": "01:16:23.420",
      "formatted_end": "01:16:26.740",
      "text": "درد نمیاد که نابودت کنه"
    },
    {
      "id": 9,
      "start": 4586.74,
      "end": 4591.34,
      "formatted_start": "01:16:26.740",
      "formatted_end": "01:16:31.340",
      "text": "درد میاد تا اون قسمت زدیف تو قوی تر آده"
    },
    {
      "id": 10,
      "start": 4591.34,
      "end": 4595.88,
      "formatted_start": "01:16:31.340",
      "formatted_end": "01:16:35.880",
      "text": "تا بتونیم مسیر پیش رو تو به دوش بکشیم"
    },
    {
      "id": 11,
      "start": 4595.88,
      "end": 4599.84,
      "formatted_start": "01:16:35.880",
      "formatted_end": "01:16:39.840",
      "text": "هر روز بعد هر خیانت هر دل شکستگی"
    },
    {
      "id": 12,
      "start": 4599.84,
      "end": 4604.68,
      "formatted_start": "01:16:39.840",
      "formatted_end": "01:16:44.680",
      "text": "پنهش خدا هست که بره دینکه دینکه تو نسازه"
    },
    {
      "id": 13,
      "start": 4604.68,
      "end": 4607.58,
      "formatted_start": "01:16:44.680",
      "formatted_end": "01:16:47.580",
      "text": "تو داخل راحتی روشنگانی"
    },
    {
      "id": 14,
      "start": 4607.58,
      "end": 4611.0,
      "formatted_start": "01:16:47.580",
      "formatted_end": "01:16:51.000",
      "text": "تو وسط آشو روشنگانی"
    },
    {
      "id": 15,
      "start": 4611.0,
      "end": 4614.8,
      "formatted_start": "01:16:51.000",
      "formatted_end": "01:16:54.800",
      "text": "وقتی سانوزدی و فکر کردی همه چی تمومه"
    },
    {
      "id": 16,
      "start": 4614.8,
      "end": 4617.08,
      "formatted_start": "01:16:54.800",
      "formatted_end": "01:16:57.080",
      "text": "بدون که این پایان نیست"
    },
    {
      "id": 17,
      "start": 4617.08,
      "end": 4620.22,
      "formatted_start": "01:16:57.080",
      "formatted_end": "01:17:00.220",
      "text": "این شعب دواره است"
    },
    {
      "id": 18,
      "start": 4620.22,
      "end": 4624.34,
      "formatted_start": "01:17:00.220",
      "formatted_end": "01:17:04.340",
      "text": "اکثر آدم ها وقتی درد می کشند جا می زنند"
    },
    {
      "id": 19,
      "start": 4624.34,
      "end": 4626.82,
      "formatted_start": "01:17:04.340",
      "formatted_end": "01:17:06.820",
      "text": "اما آدم های انتخاب شده"
    },
    {
      "id": 20,
      "start": 4626.82,
      "end": 4629.58,
      "formatted_start": "01:17:06.820",
      "formatted_end": "01:17:09.580",
      "text": "از دل آتیش رن می شند"
    },
    {
      "id": 21,
      "start": 4629.58,
      "end": 4632.74,
      "formatted_start": "01:17:09.580",
      "formatted_end": "01:17:12.740",
      "text": "تا رسالتون را روشن می شند"
    },
    {
      "id": 22,
      "start": 4632.74,
      "end": 4636.84,
      "formatted_start": "01:17:12.740",
      "formatted_end": "01:17:16.840",
      "text": "هر امتحان، هر عشق، هر می خوابی"
    },
    {
      "id": 23,
      "start": 4636.84,
      "end": 4640.62,
      "formatted_start": "01:17:16.840",
      "formatted_end": "01:17:20.620",
      "text": "نشانه ای هست که خدا هموز در روی تو"
    },
    {
      "id": 24,
      "start": 4640.62,
      "end": 4668.62,
      "formatted_start": "01:17:20.620",
      "formatted_end": "01:17:48.620",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 4670.62,
      "end": 4698.62,
      "formatted_start": "01:17:50.620",
      "formatted_end": "01:18:18.620",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 4700.62,
      "end": 4710.62,
      "formatted_start": "01:18:20.620",
      "formatted_end": "01:18:30.620",
      "text": "موسیقی"
    },
    {
      "id": 27,
      "start": 4730.62,
      "end": 4760.6,
      "formatted_start": "01:18:50.620",
      "formatted_end": "01:19:20.600",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 28,
      "start": 4760.62,
      "end": 4770.62,
      "formatted_start": "01:19:20.620",
