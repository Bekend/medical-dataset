  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14104.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:04.000",
      "text": "برای این چه قصد، چه خیلی خوبه نده."
    },
    {
      "id": 1,
      "start": 14104.0,
      "end": 14106.0,
      "formatted_start": "03:55:04.000",
      "formatted_end": "03:55:06.000",
      "text": "بسیار دل هست."
    },
    {
      "id": 2,
      "start": 14106.0,
      "end": 14112.0,
      "formatted_start": "03:55:06.000",
      "formatted_end": "03:55:12.000",
      "text": "از اینجور داره صحبت میکنه که من به جاییتتو منم."
    },
    {
      "id": 3,
      "start": 14112.0,
      "end": 14114.0,
      "formatted_start": "03:55:12.000",
      "formatted_end": "03:55:14.000",
      "text": "اینجور خوبه ای بوده جاییتتو منم."
    },
    {
      "id": 4,
      "start": 14114.0,
      "end": 14118.0,
      "formatted_start": "03:55:14.000",
      "formatted_end": "03:55:18.000",
      "text": "اگه پر نچه با پودر استخون پارش کنه."
    },
    {
      "id": 5,
      "start": 14118.0,
      "end": 14120.0,
      "formatted_start": "03:55:18.000",
      "formatted_end": "03:55:20.000",
      "text": "باشه، اکسو شامل من بگم."
    },
    {
      "id": 6,
      "start": 14120.0,
      "end": 14122.0,
      "formatted_start": "03:55:20.000",
      "formatted_end": "03:55:22.000",
      "text": "باشه، خداحافظ."
    },
    {
      "id": 7,
      "start": 14122.0,
      "end": 14126.0,
      "formatted_start": "03:55:22.000",
      "formatted_end": "03:55:26.000",
      "text": "این فیلم های شامل."
    },
    {
      "id": 8,
      "start": 14126.0,
      "end": 14128.0,
      "formatted_start": "03:55:26.000",
      "formatted_end": "03:55:28.000",
      "text": "خوابی به داره؟"
    },
    {
      "id": 9,
      "start": 14128.0,
      "end": 14130.0,
      "formatted_start": "03:55:28.000",
      "formatted_end": "03:55:30.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 10,
      "start": 14130.0,
      "end": 14132.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:32.000",
      "text": "نه اون تا دیگه همون دیستان را تدینه"
    },
    {
      "id": 11,
      "start": 14132.0,
      "end": 14134.0,
      "formatted_start": "03:55:32.000",
      "formatted_end": "03:55:34.000",
      "text": "اینه دیگه"
    },
    {
      "id": 12,
      "start": 14134.0,
      "end": 14136.0,
      "formatted_start": "03:55:34.000",
      "formatted_end": "03:55:36.000",
      "text": "فرقای بود نشده"
    },
    {
      "id": 13,
      "start": 14136.0,
      "end": 14138.0,
      "formatted_start": "03:55:36.000",
      "formatted_end": "03:55:38.000",
      "text": "خانه فرمانی"
    },
    {
      "id": 14,
      "start": 14138.0,
      "end": 14140.0,
      "formatted_start": "03:55:38.000",
      "formatted_end": "03:55:40.000",
      "text": "خانه فرمانی"
    },
    {
      "id": 15,
      "start": 14140.0,
      "end": 14142.0,
      "formatted_start": "03:55:40.000",
      "formatted_end": "03:55:42.000",
      "text": "خانه فرمانی"
    },
    {
      "id": 16,
      "start": 14142.0,
      "end": 14144.0,
      "formatted_start": "03:55:42.000",
      "formatted_end": "03:55:44.000",
      "text": "همش روی این پاش"
    },
    {
      "id": 17,
      "start": 14144.0,
      "end": 14146.0,
      "formatted_start": "03:55:44.000",
      "formatted_end": "03:55:46.000",
      "text": "زخمی شد"
    },
    {
      "id": 18,
      "start": 14146.0,
      "end": 14148.0,
      "formatted_start": "03:55:46.000",
      "formatted_end": "03:55:48.000",
      "text": "یک کمادی هر شب داده شم داره میزنه"
    },
    {
      "id": 19,
      "start": 14148.0,
      "end": 14150.0,
      "formatted_start": "03:55:48.000",
      "formatted_end": "03:55:50.000",
      "text": "که خوب سجاده"
    },
    {
      "id": 20,
      "start": 14150.0,
      "end": 14152.0,
      "formatted_start": "03:55:50.000",
      "formatted_end": "03:55:52.000",
      "text": "این ببین هستاسیتش دیگه"
    },
    {
      "id": 21,
      "start": 14152.0,
      "end": 14154.0,
      "formatted_start": "03:55:52.000",
      "formatted_end": "03:55:54.000",
      "text": "اصلا ببین این هستاسیت درقل"
    },
    {
      "id": 22,
      "start": 14154.0,
      "end": 14156.0,
      "formatted_start": "03:55:54.000",
      "formatted_end": "03:55:56.000",
      "text": "اوزه هاشون بزرگه"
    },
    {
      "id": 23,
      "start": 14156.0,
      "end": 14160.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:56:00.000",
      "text": "این کشید ها هم هست. که کچکتر هست. این تنشو نگاه کن."
    },
    {
      "id": 24,
      "start": 14160.0,
      "end": 14162.0,
      "formatted_start": "03:56:00.000",
      "formatted_end": "03:56:02.000",
      "text": "آره. این ها رو پشت هست."
    },
    {
      "id": 25,
      "start": 14162.0,
      "end": 14166.0,
      "formatted_start": "03:56:02.000",
      "formatted_end": "03:56:06.000",
      "text": "آره. میبینی چقدر اثرش میمونه. به خاطر که پوستش هست."
    },
    {
      "id": 26,
      "start": 14166.0,
      "end": 14170.0,
      "formatted_start": "03:56:06.000",
      "formatted_end": "03:56:10.000",
      "text": "دیدی چششو نگاه کن. جلیت برنفشه. این هم نماره هست."
    },
    {
      "id": 27,
      "start": 14170.0,
      "end": 14172.0,
      "formatted_start": "03:56:10.000",
      "formatted_end": "03:56:12.000",
      "text": "از هم بچگیش پوتیه."
    },
    {
      "id": 28,
      "start": 14172.0,
      "end": 14174.0,
      "formatted_start": "03:56:12.000",
      "formatted_end": "03:56:14.000",
      "text": "آره. ببین ایراک هستشو. این ها سه با خون هست."
    },
    {
      "id": 29,
      "start": 14174.0,
      "end": 14176.0,
      "formatted_start": "03:56:14.000",
      "formatted_end": "03:56:16.000",
      "text": "آره. خوب شده."
    },
    {
      "id": 30,
      "start": 14176.0,
      "end": 14180.0,
      "formatted_start": "03:56:16.000",
      "formatted_end": "03:56:20.000",
      "text": "خب اونو نمیجبه ها. بره بیجبه. نمیجبه."
    },
    {
      "id": 31,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "من تو آبو خریدن کنم بشم میدم"
    },
    {
      "id": 32,
      "start": 14182.0,
      "end": 14185.64,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:25.640",
      "text": "خب اگه که نمیدونه پس من پودرشو براش برسم"
    },
    {
      "id": 33,
      "start": 14185.64,
      "end": 14188.0,
      "formatted_start": "03:56:25.640",
      "formatted_end": "03:56:28.000",
      "text": "چون تو آب حل بشه ازش خیلی کم میشه"
    },
