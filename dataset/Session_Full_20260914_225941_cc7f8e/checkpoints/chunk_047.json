      "id": 34,
      "start": 14188.0,
      "end": 14194.0,
      "formatted_start": "03:56:28.000",
      "formatted_end": "03:56:34.000",
      "text": "باید مکی دنی باشه تو دهنش بگذاره بمکی تا تعمل باشه"
    },
    {
      "id": 35,
      "start": 14194.0,
      "end": 14195.72,
      "formatted_start": "03:56:34.000",
      "formatted_end": "03:56:35.720",
      "text": "خب مزه میده میده"
    },
    {
      "id": 36,
      "start": 14195.72,
      "end": 14198.78,
      "formatted_start": "03:56:35.720",
      "formatted_end": "03:56:38.780",
      "text": "خب امروز بهش میگن بمکی دیده برم"
    },
    {
      "id": 37,
      "start": 14198.78,
      "end": 14205.86,
      "formatted_start": "03:56:38.780",
      "formatted_end": "03:56:45.860",
