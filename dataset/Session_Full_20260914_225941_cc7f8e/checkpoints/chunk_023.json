      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:00.500",
      "text": "بیا."
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6933.76,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:33.760",
      "text": "گرسته هم کامل، منیجوی ماشاله"
    },
    {
      "id": 2,
      "start": 6933.76,
      "end": 6936.0,
      "formatted_start": "01:55:33.760",
      "formatted_end": "01:55:36.000",
      "text": "نه کلو سرد منجو برش"
    },
    {
      "id": 3,
      "start": 6936.0,
      "end": 6938.0,
      "formatted_start": "01:55:36.000",
      "formatted_end": "01:55:38.000",
      "text": "کسی شده؟"
    },
    {
      "id": 4,
      "start": 6938.0,
      "end": 6940.0,
      "formatted_start": "01:55:38.000",
      "formatted_end": "01:55:40.000",
      "text": "من مرسیه"
    },
    {
      "id": 5,
      "start": 6940.0,
      "end": 6941.0,
      "formatted_start": "01:55:40.000",
      "formatted_end": "01:55:41.000",
      "text": "من مرسیه"
    },
    {
      "id": 6,
      "start": 6941.0,
      "end": 6943.0,
      "formatted_start": "01:55:41.000",
      "formatted_end": "01:55:43.000",
      "text": "امیدوارم اینو سلام"
    },
