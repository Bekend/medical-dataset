  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14730.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:30.000",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 1,
      "start": 14730.0,
      "end": 14734.0,
      "formatted_start": "04:05:30.000",
      "formatted_end": "04:05:34.000",
      "text": "هر هشت ساعت به این شیش سی سی میبینید"
    },
    {
      "id": 2,
      "start": 14734.0,
      "end": 14739.0,
      "formatted_start": "04:05:34.000",
      "formatted_end": "04:05:39.000",
      "text": "به این بیست و چند گیر رو بزید؟ بیست و چهار هشت"
    },
    {
      "id": 3,
      "start": 14739.0,
      "end": 14741.0,
      "formatted_start": "04:05:39.000",
      "formatted_end": "04:05:41.000",
      "text": "نه، هشت سی سی"
    },
    {
      "id": 4,
      "start": 14741.0,
      "end": 14746.0,
      "formatted_start": "04:05:41.000",
      "formatted_end": "04:05:46.000",
      "text": "خب، این این را این هم ساعت"
    },
    {
      "id": 5,
      "start": 14746.0,
      "end": 14751.0,
      "formatted_start": "04:05:46.000",
      "formatted_end": "04:05:51.000",
      "text": "یک قامت نوشتم و همینجایی که زخمه روزی سه بار این قامت رو بزید"
    },
    {
      "id": 6,
      "start": 14751.0,
      "end": 14753.0,
      "formatted_start": "04:05:51.000",
      "formatted_end": "04:05:53.000",
      "text": "خب، این هست"
    },
    {
      "id": 7,
      "start": 14753.0,
      "end": 14756.0,
      "formatted_start": "04:05:53.000",
      "formatted_end": "04:05:56.000",
      "text": "حالا برای این شعبه شد سرشون رو"
    },
    {
      "id": 8,
      "start": 14756.0,
      "end": 14762.0,
      "formatted_start": "04:05:56.000",
      "formatted_end": "04:06:02.000",
      "text": "این روسیون نقشتند که قبل از همون"
    },
    {
      "id": 9,
      "start": 14762.0,
      "end": 14767.0,
      "formatted_start": "04:06:02.000",
      "formatted_end": "04:06:07.000",
      "text": "به تمام سرشون آگشته میکنید این روسیونو"
    },
    {
      "id": 10,
      "start": 14767.0,
      "end": 14773.0,
      "formatted_start": "04:06:07.000",
      "formatted_end": "04:06:13.000",
      "text": "از ریشه به سمت پانیکا همه سرشون روسیونو نگذارید"
    },
    {
      "id": 11,
      "start": 14773.0,
      "end": 14776.0,
      "formatted_start": "04:06:13.000",
      "formatted_end": "04:06:16.000",
      "text": "قشنگی ببین دونه دونه بگیر موهاشونو"
    },
    {
      "id": 12,
      "start": 14776.0,
      "end": 14779.0,
      "formatted_start": "04:06:16.000",
      "formatted_end": "04:06:19.000",
      "text": "این روسیونو دستگیش دستگیر ببینید به موهاشونو"
    },
    {
      "id": 13,
      "start": 14779.0,
      "end": 14783.0,
      "formatted_start": "04:06:19.000",
      "formatted_end": "04:06:23.000",
      "text": "برد بیست دقیقه بمونه"
    },
    {
      "id": 14,
      "start": 14783.0,
      "end": 14786.0,
      "formatted_start": "04:06:23.000",
      "formatted_end": "04:06:26.000",
      "text": "برد شونه بکن"
    },
    {
      "id": 15,
      "start": 14786.0,
      "end": 14789.0,
      "formatted_start": "04:06:26.000",
      "formatted_end": "04:06:29.000",
      "text": "یه شونه کوچک داره تو خود این درد"
    },
    {
      "id": 16,
      "start": 14789.0,
      "end": 14790.0,
      "formatted_start": "04:06:29.000",
      "formatted_end": "04:06:30.000",
      "text": "قبل همون بزنیم؟"
    },
    {
      "id": 17,
      "start": 14790.0,
      "end": 14791.0,
      "formatted_start": "04:06:30.000",
      "formatted_end": "04:06:31.000",
      "text": "آره قبل همون"
    },
    {
      "id": 18,
      "start": 14791.0,
      "end": 14795.0,
      "formatted_start": "04:06:31.000",
      "formatted_end": "04:06:35.000",
      "text": "شونه بزن همونه این شپش های مرده بیاد زیر شونه"
    },
    {
      "id": 19,
      "start": 14795.0,
      "end": 14798.0,
      "formatted_start": "04:06:35.000",
      "formatted_end": "04:06:38.000",
      "text": "برد همونه شون کن"
    },
    {
      "id": 20,
      "start": 14798.0,
      "end": 14801.0,
      "formatted_start": "04:06:38.000",
      "formatted_end": "04:06:41.000",
      "text": "داخل همونه یه شانفونه بشن"
    },
    {
      "id": 21,
      "start": 14801.0,
      "end": 14803.0,
      "formatted_start": "04:06:41.000",
      "formatted_end": "04:06:43.000",
      "text": "این شانفون رو بزن به سرشون"
    },
    {
      "id": 22,
      "start": 14803.0,
      "end": 14807.0,
      "formatted_start": "04:06:43.000",
      "formatted_end": "04:06:47.000",
      "text": "ده دقیقه الا خونزه دقیقه دوباره بمونه"
    },
    {
      "id": 23,
      "start": 14807.0,
      "end": 14807.7,
      "formatted_start": "04:06:47.000",
      "formatted_end": "04:06:47.700",
      "text": "تا اون؟"
    },
    {
      "id": 24,
      "start": 14807.7,
      "end": 14812.88,
      "formatted_start": "04:06:47.700",
      "formatted_end": "04:06:52.880",
      "text": "چون خواهد رو سرشون بمونه، بعد هجاماشون رو میشونی، تا این بمونه، با"
    },
    {
      "id": 25,
      "start": 14812.88,
      "end": 14815.72,
      "formatted_start": "04:06:52.880",
      "formatted_end": "04:06:55.720",
      "text": "بعد از همون بیرون"
    },
    {
      "id": 26,
      "start": 14817.12,
      "end": 14822.06,
      "formatted_start": "04:06:57.120",
      "formatted_end": "04:07:02.060",
      "text": "بیرون همون دوباره اون شنه رو بگیر، بگذارم داخل"
    },
    {
      "id": 27,
      "start": 14823.88,
      "end": 14825.24,
      "formatted_start": "04:07:03.880",
      "formatted_end": "04:07:05.240",
      "text": "سرکه سفید"
    },
    {
      "id": 28,
      "start": 14825.72,
      "end": 14826.44,
      "formatted_start": "04:07:05.720",
      "formatted_end": "04:07:06.440",
      "text": "شنه رو؟"
    },
    {
      "id": 29,
      "start": 14826.44,
      "end": 14829.12,
      "formatted_start": "04:07:06.440",
      "formatted_end": "04:07:09.120",
      "text": "بله، شنه رو بکن داخل سرکه سفید شنه کن"
    },
    {
      "id": 30,
      "start": 14829.12,
      "end": 14830.62,
      "formatted_start": "04:07:09.120",
      "formatted_end": "04:07:10.620",
      "text": "بعد پوشی بولیم بیرون؟"
    },
    {
      "id": 31,
      "start": 14830.62,
      "end": 14833.08,
      "formatted_start": "04:07:10.620",
      "formatted_end": "04:07:13.080",
      "text": "نه، از اون سرکه از گذوب میپرد"
    },
    {
      "id": 32,
      "start": 14833.08,
      "end": 14837.08,
      "formatted_start": "04:07:13.080",
      "formatted_end": "04:07:17.080",
      "text": "اول با شامپوی خودش بشویم؟"
    },
    {
      "id": 33,
      "start": 14837.08,
      "end": 14839.08,
      "formatted_start": "04:07:17.080",
      "formatted_end": "04:07:19.080",
      "text": "نه، اول با این شامپوی بشویم"
    },
    {
      "id": 34,
      "start": 14839.08,
      "end": 14841.08,
      "formatted_start": "04:07:19.080",
      "formatted_end": "04:07:21.080",
      "text": "بعد با شامپوی خودش بشویم"
    },
    {
      "id": 35,
      "start": 14841.08,
      "end": 14843.08,
      "formatted_start": "04:07:21.080",
      "formatted_end": "04:07:23.080",
      "text": "این هستیم"
    },
    {
      "id": 36,
      "start": 14843.08,
      "end": 14852.08,
      "formatted_start": "04:07:23.080",
      "formatted_end": "04:07:32.080",
      "text": "چون معمولاً شخص سریعاً انتقال پیران می کنه، خودت هم یک بازواری کار رو انجام می ده"
    },
    {
      "id": 37,
      "start": 14852.08,
      "end": 14856.08,
      "formatted_start": "04:07:32.080",
      "formatted_end": "04:07:36.080",
      "text": "حالا مال این دوتا رو، این روزتیون رو شونه شونه"
    },
    {
      "id": 38,
      "start": 14856.08,
      "end": 14860.08,
      "formatted_start": "04:07:36.080",
      "formatted_end": "04:07:40.080",
      "text": "یه دونه امروز، یه دونه سه روز بعد"
    },
    {
      "id": 39,
      "start": 14860.08,
      "end": 14864.08,
      "formatted_start": "04:07:40.080",
      "formatted_end": "04:07:44.080",
      "text": "یه روزی ما رو یه هفته بعد این روزشون می‌گذاریم"
    },
    {
      "id": 40,
      "start": 14864.08,
      "end": 14872.08,
      "formatted_start": "04:07:44.080",
      "formatted_end": "04:07:52.080",
      "text": "تمام ملافه ها، گل سرها همه این‌هاشون رو می‌شونیم"
    },
    {
      "id": 41,
      "start": 14872.08,
      "end": 14875.08,
      "formatted_start": "04:07:52.080",
      "formatted_end": "04:07:55.080",
      "text": "حالا گل سرها شکر با آب و سابون می‌شونیم"
    },
    {
      "id": 42,
      "start": 14875.08,
      "end": 14881.08,
      "formatted_start": "04:07:55.080",
      "formatted_end": "04:08:01.080",
      "text": "ولی ملافه‌ها شما همه رو می‌رزید توی لگن، آب و جوش می‌ارید"
    },
    {
      "id": 43,
      "start": 14881.08,
      "end": 14886.08,
      "formatted_start": "04:08:01.080",
      "formatted_end": "04:08:06.080",
      "text": "روی ملافه‌ها می‌رزید، خوند که شد بیندازش توی ماشین رو باز جویید"
    },
    {
      "id": 44,
      "start": 14886.08,
      "end": 14898.08,
      "formatted_start": "04:08:06.080",
      "formatted_end": "04:08:18.080",
      "text": "خب، هر روز که اینها از خواب بیدار میشن، بالششون رو با یه اوتوم بکشون که هر چی اگر شبش مونده باشه روی بالش، ازدهردن."
    },
    {
      "id": 45,
      "start": 14898.08,
      "end": 14902.08,
      "formatted_start": "04:08:18.080",
      "formatted_end": "04:08:22.080",
      "text": "خب؟ کارت در آمد."
    },
    {
      "id": 46,
      "start": 14902.08,
      "end": 14904.08,
      "formatted_start": "04:08:22.080",
      "formatted_end": "04:08:24.080",
      "text": "بیاید."
    },
    {
      "id": 47,
      "start": 14904.08,
      "end": 14909.08,
      "formatted_start": "04:08:24.080",
      "formatted_end": "04:08:29.080",
      "text": "باید میتوانیم سوکن میکنم. اگر برای میتوانیم، باست خفتش چی بدن؟"
    },
    {
      "id": 48,
      "start": 14909.08,
      "end": 14911.08,
      "formatted_start": "04:08:29.080",
      "formatted_end": "04:08:31.080",
      "text": "خفتن خیلی هست."
    },
    {
      "id": 49,
      "start": 14911.08,
      "end": 14913.08,
      "formatted_start": "04:08:31.080",
      "formatted_end": "04:08:33.080",
      "text": "بس زیادیست و حقیقی بودن."
    },
    {
      "id": 50,
      "start": 14913.08,
      "end": 14915.08,
      "formatted_start": "04:08:33.080",
      "formatted_end": "04:08:35.080",
      "text": "آبیزشون میدارن"
    },
    {
      "id": 51,
      "start": 14915.08,
      "end": 14917.08,
      "formatted_start": "04:08:35.080",
      "formatted_end": "04:08:37.080",
      "text": "مثلا ستریزینم بشون"
    },
    {
      "id": 52,
      "start": 14917.08,
      "end": 14918.08,
      "formatted_start": "04:08:37.080",
      "formatted_end": "04:08:38.080",
      "text": "چرا؟"
    },
    {
      "id": 53,
      "start": 14918.08,
      "end": 14920.08,
      "formatted_start": "04:08:38.080",
      "formatted_end": "04:08:40.080",
      "text": "چون این چه خوشکنی که داری بشون میگی باسه یه این"
    },
    {
      "id": 54,
      "start": 14920.08,
      "end": 14921.08,
      "formatted_start": "04:08:40.080",
      "formatted_end": "04:08:41.080",
      "text": "سمت آش؟"
    },
    {
      "id": 55,
      "start": 14921.08,
      "end": 14923.08,
      "formatted_start": "04:08:41.080",
      "formatted_end": "04:08:43.080",
      "text": "آه، یعنی که اون رو نبشتم"
    },
    {
      "id": 56,
      "start": 14923.08,
      "end": 14925.08,
      "formatted_start": "04:08:43.080",
      "formatted_end": "04:08:45.080",
      "text": "یه جنه شربه شدیم"
    },
    {
      "id": 57,
      "start": 14925.08,
      "end": 14927.08,
      "formatted_start": "04:08:45.080",
      "formatted_end": "04:08:47.080",
      "text": "ستریزینم بش بدن"
    },
    {
      "id": 58,
      "start": 14927.08,
      "end": 14930.08,
      "formatted_start": "04:08:47.080",
      "formatted_end": "04:08:50.080",
      "text": "هر دوزده ساعت"
    },
    {
      "id": 59,
      "start": 14930.08,
      "end": 14932.08,
      "formatted_start": "04:08:50.080",
      "formatted_end": "04:08:52.080",
      "text": "سه سی سی"
    },
    {
      "id": 60,
      "start": 14932.08,
      "end": 14934.08,
      "formatted_start": "04:08:52.080",
      "formatted_end": "04:08:54.080",
      "text": "اینم بتوانم کنیم"
    },
    {
      "id": 61,
      "start": 14934.08,
      "end": 14936.08,
      "formatted_start": "04:08:54.080",
      "formatted_end": "04:08:56.080",
      "text": "خوش آمده این کادفت باید"
    },
    {
      "id": 62,
      "start": 14936.08,
      "end": 14938.08,
      "formatted_start": "04:08:56.080",
      "formatted_end": "04:08:58.080",
      "text": "یه جایزه رو هجوم بدم"
    },
    {
      "id": 63,
      "start": 14938.08,
      "end": 14939.08,
      "formatted_start": "04:08:58.080",
      "formatted_end": "04:08:59.080",
      "text": "بیا بیا بیا"
    },
    {
      "id": 64,
      "start": 14939.08,
      "end": 14941.08,
      "formatted_start": "04:08:59.080",
      "formatted_end": "04:09:01.080",
      "text": "یه جایزه رو هجوم بدم"
    },
    {
      "id": 65,
      "start": 14941.08,
      "end": 14943.08,
      "formatted_start": "04:09:01.080",
      "formatted_end": "04:09:03.080",
      "text": "این ستاره مال شما"
    },
    {
      "id": 66,
      "start": 14944.52,
      "end": 14946.52,
      "formatted_start": "04:09:04.520",
      "formatted_end": "04:09:06.520",
      "text": "این ستاره مال شما"
    },
    {
      "id": 67,
      "start": 14948.12,
      "end": 14950.12,
      "formatted_start": "04:09:08.120",
      "formatted_end": "04:09:10.120",
      "text": "خدافر"
    },
    {
      "id": 68,
      "start": 14950.12,
      "end": 14951.12,
      "formatted_start": "04:09:10.120",
      "formatted_end": "04:09:11.120",
      "text": "آره ماشی بگم"
    },
    {
      "id": 69,
      "start": 14951.12,
      "end": 14953.12,
      "formatted_start": "04:09:11.120",
      "formatted_end": "04:09:13.120",
      "text": "نه خدافرش گفتم"
    },
    {
      "id": 70,
      "start": 14953.12,
      "end": 14955.12,
      "formatted_start": "04:09:13.120",
      "formatted_end": "04:09:15.120",
      "text": "پسید بگیرش"
    },
    {
      "id": 71,
      "start": 14955.12,
      "end": 14957.12,
      "formatted_start": "04:09:15.120",
      "formatted_end": "04:09:17.120",
      "text": "خدافر"
    },
    {
      "id": 72,
      "start": 14968.52,
      "end": 14969.88,
      "formatted_start": "04:09:28.520",
      "formatted_end": "04:09:29.880",
      "text": "شامل پاک بگیرم؟"
    },
    {
      "id": 73,
      "start": 14969.88,
      "end": 14970.88,
      "formatted_start": "04:09:29.880",
      "formatted_end": "04:09:30.880",
      "text": "نه دارم"
    },
    {
      "id": 74,
      "start": 14971.08,
      "end": 14975.94,
      "formatted_start": "04:09:31.080",
      "formatted_end": "04:09:35.940",
      "text": "این ازراتی از ازرات در جان"
    },
    {
      "id": 75,
      "start": 14975.94,
      "end": 14986.74,
      "formatted_start": "04:09:35.940",
      "formatted_end": "04:09:46.740",
      "text": "سلام ها مردم شما مردم مردم"
    },
    {
      "id": 76,
      "start": 14986.74,
      "end": 14987.8,
      "formatted_start": "04:09:46.740",
      "formatted_end": "04:09:47.800",
      "text": "سلام"
    },
    {
      "id": 77,
      "start": 14987.8,
      "end": 14990.3,
      "formatted_start": "04:09:47.800",
      "formatted_end": "04:09:50.300",
      "text": "سلام پسر گو"
    },
    {
      "id": 78,
      "start": 14990.3,
      "end": 14992.2,
      "formatted_start": "04:09:50.300",
      "formatted_end": "04:09:52.200",
      "text": "حالا چطوره"
    },
    {
      "id": 79,
      "start": 14992.2,
      "end": 14992.98,
      "formatted_start": "04:09:52.200",
      "formatted_end": "04:09:52.980",
      "text": "اگر زدید"
    },
    {
      "id": 80,
      "start": 14992.98,
      "end": 14996.26,
      "formatted_start": "04:09:52.980",
      "formatted_end": "04:09:56.260",
      "text": "بشه"
    },
    {
      "id": 81,
      "start": 14996.26,
      "end": 14997.94,
      "formatted_start": "04:09:56.260",
      "formatted_end": "04:09:57.940",
      "text": "اولا زبونتو نشون نده که بزار"
    },
    {
      "id": 82,
      "start": 14997.94,
      "end": 14999.38,
      "formatted_start": "04:09:57.940",
      "formatted_end": "04:09:59.380",
      "text": "هم دو پرو خودش میگه"
    },
    {
      "id": 83,
      "start": 14999.38,
      "end": 14999.96,
      "formatted_start": "04:09:59.380",
      "formatted_end": "04:09:59.960",
      "text": "جانم"
    }
  ],
  "status": "completed"
}