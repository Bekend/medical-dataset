  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9905.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:05.000",
      "text": "از اینجا باید برام سبت کنید، هم گوبه کنید اونجا مثلا ببینم آیا مدیدش داره؟"
    },
    {
      "id": 1,
      "start": 9905.0,
      "end": 9908.0,
      "formatted_start": "02:45:05.000",
      "formatted_end": "02:45:08.000",
      "text": "نه، سبت کردن که نمیشه، من مستقش میدم."
    },
    {
      "id": 2,
      "start": 9908.0,
      "end": 9911.0,
      "formatted_start": "02:45:08.000",
      "formatted_end": "02:45:11.000",
      "text": "آه، یا پس برام اونجا دوباره اطباع بگم برام برسید، این شکل میشه؟"
    },
    {
      "id": 3,
      "start": 9911.0,
      "end": 9912.0,
      "formatted_start": "02:45:11.000",
      "formatted_end": "02:45:12.000",
      "text": "نه، از آزاده کنم."
    },
    {
      "id": 4,
      "start": 9912.0,
      "end": 9915.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:15.000",
      "text": "آزاده شما شبهرم فقط برام سبت کردید، نه؟"
    },
