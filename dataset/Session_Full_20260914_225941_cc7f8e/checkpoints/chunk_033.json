      "id": 7,
      "start": 9918.0,
      "end": 9920.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:20.000",
      "text": "خالقانی نوشته دادم"
    },
    {
      "id": 8,
      "start": 9920.0,
      "end": 9922.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:22.000",
