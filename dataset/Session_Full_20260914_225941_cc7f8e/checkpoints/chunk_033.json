      "id": 14,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "دارو خونه برای تو تفکر کرده"
    },
    {
      "id": 15,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "الان دو تا نوشتیم برای کدو میاید؟"
