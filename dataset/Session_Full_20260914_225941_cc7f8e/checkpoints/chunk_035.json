  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10512.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:12.000",
      "text": "شب گذشته، دیروز صبح هم بوده، احساس بدندردهایی داشته. معمولا سارا سرما خوردگیش به همین علایم شروع میشه."
    },
    {
      "id": 1,
      "start": 10512.0,
      "end": 10519.0,
      "formatted_start": "02:55:12.000",
      "formatted_end": "02:55:19.000",
      "text": "درد بدنش، بعد فرداییش یکم ترک میکنه، بعد یا به شبه هاش همینجوری."
    },
    {
      "id": 2,
      "start": 10519.0,
      "end": 10521.0,
      "formatted_start": "02:55:19.000",
      "formatted_end": "02:55:21.000",
      "text": "آفتش بیدنی و صرف رو بینا پیدن."
    },
    {
      "id": 3,
      "start": 10521.0,
      "end": 10528.0,
      "formatted_start": "02:55:21.000",
      "formatted_end": "02:55:28.000",
      "text": "ما بعضی وقتا مثلا یه برات چون زود میاریم خدمت شما، با داروهایی ندیگه به اونجا ها نمیرسه."
    },
    {
      "id": 4,
      "start": 10528.0,
      "end": 10532.0,
      "formatted_start": "02:55:28.000",
      "formatted_end": "02:55:32.000",
      "text": "این تو همون تبایین هایی ها میبینید که خوب شد"
    },
    {
      "id": 5,
      "start": 10532.0,
      "end": 10534.0,
      "formatted_start": "02:55:32.000",
      "formatted_end": "02:55:34.000",
      "text": "ایشالله الان همه نشد"
    },
    {
      "id": 6,
      "start": 10534.0,
      "end": 10536.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:36.000",
      "text": "ویروس ها با هم فرق کنند"
    },
    {
      "id": 7,
      "start": 10536.0,
      "end": 10537.0,
      "formatted_start": "02:55:36.000",
      "formatted_end": "02:55:37.000",
      "text": "بله"
    },
    {
      "id": 8,
      "start": 10537.0,
      "end": 10538.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:38.000",
      "text": "نفس بگیستم؟"
    },
    {
      "id": 9,
      "start": 10538.0,
      "end": 10542.0,
      "formatted_start": "02:55:38.000",
      "formatted_end": "02:55:42.000",
      "text": "هیچ کس هم درابر همون یا تو خونه ها اینا هیچ کس سرماخورده نبود"
    },
    {
      "id": 10,
      "start": 10542.0,
      "end": 10544.0,
      "formatted_start": "02:55:42.000",
      "formatted_end": "02:55:44.000",
      "text": "اصلا این ارتباطی هم با یه جا نداشت"
    },
    {
      "id": 11,
      "start": 10544.0,
      "end": 10548.0,
      "formatted_start": "02:55:44.000",
      "formatted_end": "02:55:48.000",
      "text": "و این چهار پنج روز گذشته همش خونه بود بچه ها"
    },
    {
      "id": 12,
      "start": 10548.0,
      "end": 10551.0,
      "formatted_start": "02:55:48.000",
      "formatted_end": "02:55:51.000",
      "text": "ما خودمون یکی از تحجبامون همینه کنیم"
    },
    {
      "id": 13,
      "start": 10551.0,
      "end": 10556.0,
      "formatted_start": "02:55:51.000",
      "formatted_end": "02:55:56.000",
      "text": "چونی وقت را ببینی زمان کرونا یادتونه میگوشن"
    },
    {
      "id": 14,
      "start": 10556.0,
      "end": 10560.0,
      "formatted_start": "02:55:56.000",
      "formatted_end": "02:56:00.000",
      "text": "حتی کسی علامت نداشته باشه فاصله رایت بکنه"
    },
    {
      "id": 15,
      "start": 10560.0,
      "end": 10561.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:01.000",
      "text": "تو ممکنه ناقل باشه"
    },
    {
      "id": 16,
      "start": 10561.0,
      "end": 10564.0,
      "formatted_start": "02:56:01.000",
      "formatted_end": "02:56:04.000",
      "text": "بله ممکنه ناقلش من از بیرون آورده باشم"
    },
    {
      "id": 17,
      "start": 10564.0,
      "end": 10566.0,
      "formatted_start": "02:56:04.000",
      "formatted_end": "02:56:06.000",
      "text": "ممکنه همون شما ناقل باشین"
    },
    {
      "id": 18,
      "start": 10566.0,
      "end": 10569.0,
      "formatted_start": "02:56:06.000",
      "formatted_end": "02:56:09.000",
      "text": "بلی خب سیستمی میبینی بطن قوی باشه"
    },
    {
      "id": 19,
      "start": 10569.0,
      "end": 10573.0,
      "formatted_start": "02:56:09.000",
      "formatted_end": "02:56:13.000",
      "text": "تو شما ایجاد بیماری نکرد بلی اعتبار بدی"
    },
    {
      "id": 20,
      "start": 10573.0,
      "end": 10575.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:15.000",
      "text": "خب؟ این هست"
    },
    {
      "id": 21,
      "start": 10575.0,
      "end": 10577.0,
      "formatted_start": "02:56:15.000",
      "formatted_end": "02:56:17.000",
      "text": "سامان الان گلوش قرمزه"
    },
    {
      "id": 22,
      "start": 10577.0,
      "end": 10579.0,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:19.000",
      "text": "حرفش ترشک داره"
    },
    {
      "id": 23,
      "start": 10579.0,
      "end": 10583.0,
      "formatted_start": "02:56:19.000",
      "formatted_end": "02:56:23.000",
      "text": "همیشه سالها اینجوری بود دیگه و از این روی دشون کرده سینوزیت میشد"
    },
    {
      "id": 24,
      "start": 10583.0,
      "end": 10585.0,
      "formatted_start": "02:56:23.000",
      "formatted_end": "02:56:25.000",
      "text": "سریع کشت و حرفش ترشوه"
    },
    {
      "id": 25,
      "start": 10585.0,
      "end": 10588.0,
      "formatted_start": "02:56:25.000",
      "formatted_end": "02:56:28.000",
      "text": "مالی این هموز ترشوهات چه کلو سینوزیتی نشده"
    },
    {
      "id": 26,
      "start": 10588.0,
      "end": 10592.0,
      "formatted_start": "02:56:28.000",
      "formatted_end": "02:56:32.000",
      "text": "ولی خب ترشوهات داره گوشش خوبه سینهش خوبه خدا ماشد"
    },
    {
      "id": 27,
      "start": 10592.0,
      "end": 10595.0,
      "formatted_start": "02:56:32.000",
      "formatted_end": "02:56:35.000",
      "text": "این شروع یک افونت ویروسی"
    },
    {
      "id": 28,
      "start": 10595.0,
      "end": 10601.0,
      "formatted_start": "02:56:35.000",
      "formatted_end": "02:56:41.000",
      "text": "بله و دی تو بعضی از بچه ها یه افونت ویروسی ممکنه دو چهار افونت سانویه بشن"
    },
    {
      "id": 29,
      "start": 10601.0,
      "end": 10603.0,
      "formatted_start": "02:56:41.000",
      "formatted_end": "02:56:43.000",
      "text": "افونت باکتریه بشن"
    },
    {
      "id": 30,
      "start": 10603.0,
      "end": 10608.2,
      "formatted_start": "02:56:43.000",
      "formatted_end": "02:56:48.200",
      "text": "من دارو براش می نمی سمیم اگر دیدید که ترشوهات بینی چهکی پیدا کرد"
    },
    {
      "id": 31,
      "start": 10608.2,
      "end": 10612.6,
      "formatted_start": "02:56:48.200",
      "formatted_end": "02:56:52.600",
      "text": "رو صرفه های خیلی پیدا کرد نصب دوپانشن به هیدش بینید"
    },
    {
      "id": 32,
      "start": 10612.6,
      "end": 10613.4,
      "formatted_start": "02:56:52.600",
      "formatted_end": "02:56:53.400",
      "text": "خیلی ممنون"
    },
    {
      "id": 33,
      "start": 10613.4,
      "end": 10614.84,
      "formatted_start": "02:56:53.400",
      "formatted_end": "02:56:54.840",
      "text": "باشه سارو جان"
    },
    {
      "id": 34,
      "start": 10614.84,
      "end": 10617.16,
      "formatted_start": "02:56:54.840",
      "formatted_end": "02:56:57.160",
      "text": "ما شما اسپره هات بپنیم"
    },
    {
      "id": 35,
      "start": 10617.16,
      "end": 10618.76,
      "formatted_start": "02:56:57.160",
      "formatted_end": "02:56:58.760",
      "text": "مایات دیگه بپنیم"
    },
    {
      "id": 36,
      "start": 10618.76,
      "end": 10621.0,
      "formatted_start": "02:56:58.760",
      "formatted_end": "02:57:01.000",
      "text": "جسارت هم اینها تو کنه داشتیم"
    },
    {
      "id": 37,
      "start": 10621.0,
      "end": 10623.64,
      "formatted_start": "02:57:01.000",
      "formatted_end": "02:57:03.640",
      "text": "بله نیات هادیم و فارمندیم"
    },
    {
      "id": 38,
      "start": 10623.64,
      "end": 10624.76,
      "formatted_start": "02:57:03.640",
      "formatted_end": "02:57:04.760",
      "text": "خب اینو که داریم"
    },
    {
      "id": 39,
      "start": 10624.76,
      "end": 10629.24,
      "formatted_start": "02:57:04.760",
      "formatted_end": "02:57:09.240",
      "text": "این هم این اسپره هاشه که اونم داشتیم"
    },
    {
      "id": 40,
      "start": 10629.24,
      "end": 10630.44,
      "formatted_start": "02:57:09.240",
      "formatted_end": "02:57:10.440",
      "text": "خیلی هم عالی"
    },
    {
      "id": 41,
      "start": 10630.44,
      "end": 10631.14,
      "formatted_start": "02:57:10.440",
      "formatted_end": "02:57:11.140",
      "text": "خب؟"
    },
    {
      "id": 42,
      "start": 10631.14,
      "end": 10633.34,
      "formatted_start": "02:57:11.140",
      "formatted_end": "02:57:13.340",
      "text": "بله، باید یک دونه اون اسپریه را از کنه افتاده کنیم"
    },
    {
      "id": 43,
      "start": 10633.34,
      "end": 10634.14,
      "formatted_start": "02:57:13.340",
      "formatted_end": "02:57:14.140",
      "text": "خیلی خوب"
    },
    {
      "id": 44,
      "start": 10634.14,
      "end": 10637.54,
      "formatted_start": "02:57:14.140",
      "formatted_end": "02:57:17.540",
      "text": "یک دونه تو کنه هموز دست نخوردن، تاریخم داره"
    },
    {
      "id": 45,
      "start": 10637.54,
      "end": 10638.14,
      "formatted_start": "02:57:17.540",
      "formatted_end": "02:57:18.140",
      "text": "باشی"
    },
    {
      "id": 46,
      "start": 10638.44,
      "end": 10640.54,
      "formatted_start": "02:57:18.440",
      "formatted_end": "02:57:20.540",
      "text": "پس شما شربت نیاز میدونید"
    },
    {
      "id": 47,
      "start": 10641.34,
      "end": 10644.54,
      "formatted_start": "02:57:21.340",
      "formatted_end": "02:57:24.540",
      "text": "هر دوازده ساعت تنگ سی سی بهش بدین"
    },
    {
      "id": 48,
      "start": 10645.14,
      "end": 10646.64,
      "formatted_start": "02:57:25.140",
      "formatted_end": "02:57:26.640",
      "text": "اسپریه بینی شو"
    },
    {
      "id": 49,
      "start": 10647.24,
      "end": 10650.54,
      "formatted_start": "02:57:27.240",
      "formatted_end": "02:57:30.540",
      "text": "هر دوازده ساعت یک پاک براش بزنید"
    },
    {
      "id": 50,
      "start": 10651.24,
      "end": 10655.94,
      "formatted_start": "02:57:31.240",
      "formatted_end": "02:57:35.940",
      "text": "اگر سرخفاها شدید شد"
    },
    {
      "id": 51,
      "start": 10656.64,
      "end": 10659.24,
      "formatted_start": "02:57:36.640",
      "formatted_end": "02:57:39.240",
      "text": "براش اسپریه سال بود همون"
    },
    {
      "id": 52,
      "start": 10660.44,
      "end": 10662.76,
      "formatted_start": "02:57:40.440",
      "formatted_end": "02:57:42.760",
      "text": "روزی چهار بار دو پا"
    },
    {
      "id": 53,
      "start": 10662.76,
      "end": 10667.72,
      "formatted_start": "02:57:42.760",
      "formatted_end": "02:57:47.720",
      "text": "و اسپریه اون فروتی کازانشون"
    },
    {
      "id": 54,
      "start": 10667.72,
      "end": 10671.12,
      "formatted_start": "02:57:47.720",
      "formatted_end": "02:57:51.120",
      "text": "هر دوزده ساعت دو پا بده"
    },
    {
      "id": 55,
      "start": 10671.12,
      "end": 10672.24,
      "formatted_start": "02:57:51.120",
      "formatted_end": "02:57:52.240",
      "text": "نه اونهایی که داریم"
    },
    {
      "id": 56,
      "start": 10672.24,
      "end": 10675.48,
      "formatted_start": "02:57:52.240",
      "formatted_end": "02:57:55.480",
      "text": "همون همونو که دارید. این ها چیزهایی که خودتون دارید."
    },
    {
      "id": 57,
      "start": 10675.48,
      "end": 10686.0,
      "formatted_start": "02:57:55.480",
      "formatted_end": "02:58:06.000",
      "text": "اگر چرکی شد ترشواتش، فارمتین هم که داشتید، شیستصد و چهروسته، هر دوست ده ساعت، سارجان چند کلو بودید؟"
    },
    {
      "id": 58,
      "start": 10686.0,
      "end": 10689.24,
      "formatted_start": "02:58:06.000",
      "formatted_end": "02:58:09.240",
      "text": "هم سی و خوده باید باشید."
    },
    {
      "id": 59,
      "start": 10689.24,
      "end": 10699.48,
      "formatted_start": "02:58:09.240",
      "formatted_end": "02:58:19.480",
      "text": "سی و سه رو ندیدم."
    },
    {
      "id": 60,
      "start": 10699.48,
      "end": 10713.48,
      "formatted_start": "02:58:19.480",
      "formatted_end": "02:58:33.480",
      "text": "اگر بردارید، هر دوازده ساعت 10 سی سی بشوید"
    },
    {
      "id": 61,
      "start": 10713.48,
      "end": 10715.48,
      "formatted_start": "02:58:33.480",
      "formatted_end": "02:58:35.480",
      "text": "این از داروهاش هست"
    },
    {
      "id": 62,
      "start": 10715.48,
      "end": 10717.48,
      "formatted_start": "02:58:35.480",
      "formatted_end": "02:58:37.480",
      "text": "آخری شی بود؟ شربت؟"
    },
    {
      "id": 63,
      "start": 10717.48,
      "end": 10719.48,
      "formatted_start": "02:58:37.480",
      "formatted_end": "02:58:39.480",
      "text": "همین چه کشکولی که دارید 6 ساعت چه دسته بنافشه"
    },
    {
      "id": 64,
      "start": 10719.48,
      "end": 10721.48,
      "formatted_start": "02:58:39.480",
      "formatted_end": "02:58:41.480",
      "text": "آره"
    },
    {
      "id": 65,
      "start": 10721.48,
      "end": 10723.48,
      "formatted_start": "02:58:41.480",
      "formatted_end": "02:58:43.480",
      "text": "بعد اسلامینافرن و ایبوپروفین"
    },
    {
      "id": 66,
      "start": 10723.48,
      "end": 10725.48,
      "formatted_start": "02:58:43.480",
      "formatted_end": "02:58:45.480",
      "text": "شربت دارید؟ قطره دارید؟ چی دارید؟"
    },
    {
      "id": 67,
      "start": 10725.48,
      "end": 10727.48,
      "formatted_start": "02:58:45.480",
      "formatted_end": "02:58:47.480",
      "text": "نه، این برای طب چیزی نداریم"
    },
    {
      "id": 68,
      "start": 10727.48,
      "end": 10732.48,
      "formatted_start": "02:58:47.480",
      "formatted_end": "02:58:52.480",
      "text": "نه، نه شیاف داریم، نه شربت داریم"
    },
    {
      "id": 69,
      "start": 10741.48,
      "end": 10743.48,
      "formatted_start": "02:59:01.480",
      "formatted_end": "02:59:03.480",
      "text": "خب، شربت هم"
    },
    {
      "id": 70,
      "start": 10744.48,
      "end": 10747.48,
      "formatted_start": "02:59:04.480",
      "formatted_end": "02:59:07.480",
      "text": "تانیا فرن براشونه، خورس میتونه بخواهده؟"
    },
    {
      "id": 71,
      "start": 10747.48,
      "end": 10752.48,
      "formatted_start": "02:59:07.480",
      "formatted_end": "02:59:12.480",
      "text": "وره، خورس کچی باید چونه باشه، خورس راحتتر میخواهده اتفاقا"
    },
    {
      "id": 72,
      "start": 10752.48,
      "end": 10754.48,
      "formatted_start": "02:59:12.480",
      "formatted_end": "02:59:14.480",
      "text": "خورس میتونه بخواهده از این اصلاً مفهنه ها؟"
    },
    {
      "id": 73,
      "start": 10754.48,
      "end": 10759.48,
      "formatted_start": "02:59:14.480",
      "formatted_end": "02:59:19.480",
      "text": "باید یاد بگیرم دیگه سانو"
    },
    {
      "id": 74,
      "start": 10759.48,
      "end": 10763.48,
      "formatted_start": "02:59:19.480",
      "formatted_end": "02:59:23.480",
      "text": "برس میخوره"
    },
    {
      "id": 75,
      "start": 10763.48,
      "end": 10767.48,
      "formatted_start": "02:59:23.480",
      "formatted_end": "02:59:27.480",
      "text": "مثلا حالا تروایی نمیدونی بهش"
    },
    {
      "id": 76,
      "start": 10767.48,
      "end": 10771.48,
      "formatted_start": "02:59:27.480",
      "formatted_end": "02:59:31.480",
      "text": "خوب از این هم میتونه بخوره نقایتشه دیگه اینو نصف مکنه دو تا نصفه"
    },
    {
      "id": 77,
      "start": 10771.48,
      "end": 10775.48,
      "formatted_start": "02:59:31.480",
      "formatted_end": "02:59:35.480",
      "text": "نصفه میخوره یا کپسول باشه اصلا وقت تر بیشون بشه"
    },
    {
      "id": 78,
      "start": 10775.48,
      "end": 10779.48,
      "formatted_start": "02:59:35.480",
      "formatted_end": "02:59:39.480",
      "text": "بگیر وضعت یه چونیه که بخوای شربت بدی باید خیلی شربت زیاد بدی"
    },
    {
      "id": 79,
      "start": 10779.48,
      "end": 10782.92,
      "formatted_start": "02:59:39.480",
      "formatted_end": "02:59:42.920",
      "text": "آره، زیاد هم میخوره شربت، بتر برند تاون"
    },
    {
      "id": 80,
      "start": 10782.92,
      "end": 10783.42,
      "formatted_start": "02:59:42.920",
      "formatted_end": "02:59:43.420",
      "text": "آره"
    },
    {
      "id": 81,
      "start": 10783.42,
      "end": 10784.92,
      "formatted_start": "02:59:43.420",
      "formatted_end": "02:59:44.920",
      "text": "گرس برش بهتر"
    },
    {
      "id": 82,
      "start": 10789.48,
      "end": 10791.88,
      "formatted_start": "02:59:49.480",
      "formatted_end": "02:59:51.880",
      "text": "یه گرس اینا بخوره به سرام نمیرسه"
    },
    {
      "id": 83,
      "start": 10791.88,
      "end": 10793.68,
      "formatted_start": "02:59:51.880",
      "formatted_end": "02:59:53.680",
      "text": "نه دیگه، سرام نخوره"
    },
    {
      "id": 84,
      "start": 10793.68,
      "end": 10795.68,
      "formatted_start": "02:59:53.680",
      "formatted_end": "02:59:55.680",
      "text": "گرس نخوره برده سرامی"
    }
  ],
  "status": "completed"
}