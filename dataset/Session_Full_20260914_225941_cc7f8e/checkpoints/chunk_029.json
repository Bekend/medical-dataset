      "id": 80,
      "start": 8954.1,
      "end": 8960.84,
      "formatted_start": "02:29:14.100",
      "formatted_end": "02:29:20.840",
      "text": "همون جوری که هم با من کمی درمش دارم"
    },
    {
      "id": 81,
      "start": 8960.84,
      "end": 8964.84,
      "formatted_start": "02:29:20.840",
      "formatted_end": "02:29:24.840",
      "text": "جا جا جا"
    },
    {
      "id": 82,
      "start": 8964.84,
      "end": 8968.84,
      "formatted_start": "02:29:24.840",
      "formatted_end": "02:29:28.840",
      "text": "جایی چنده مردشی؟"
    },
    {
      "id": 83,
      "start": 8968.84,
      "end": 8970.84,
      "formatted_start": "02:29:28.840",
      "formatted_end": "02:29:30.840",
      "text": "چنده شد؟"
    },
    {
      "id": 84,
      "start": 8970.84,
      "end": 8972.84,
      "formatted_start": "02:29:30.840",
      "formatted_end": "02:29:32.840",
      "text": "چنده مردشی؟"
    },
    {
      "id": 85,
      "start": 8972.84,
      "end": 8974.84,
      "formatted_start": "02:29:32.840",
      "formatted_end": "02:29:34.840",
      "text": "قدم چنده؟"
    },
    {
      "id": 86,
      "start": 8974.84,
      "end": 8976.84,
      "formatted_start": "02:29:34.840",
      "formatted_end": "02:29:36.840",
      "text": "قدم با اونجا ببینیم چنده؟"
    },
    {
      "id": 87,
      "start": 8976.84,
      "end": 8981.84,
      "formatted_start": "02:29:36.840",
      "formatted_end": "02:29:41.840",
      "text": "خوبه قدشم، ماشاله خوبه زاخه شدم"
    },
    {
      "id": 88,
      "start": 8981.84,
      "end": 8983.84,
      "formatted_start": "02:29:41.840",
      "formatted_end": "02:29:43.840",
      "text": "معمولاً؟"
    },
    {
      "id": 89,
      "start": 8983.84,
      "end": 8984.84,
      "formatted_start": "02:29:43.840",
      "formatted_end": "02:29:44.840",
      "text": "سه"
    },
    {
      "id": 90,
      "start": 8984.84,
      "end": 8986.84,
      "formatted_start": "02:29:44.840",
      "formatted_end": "02:29:46.840",
      "text": "از اونجا چه رو هشت بوده ها"
    },
    {
      "id": 91,
      "start": 8986.84,
      "end": 8988.84,
      "formatted_start": "02:29:46.840",
      "formatted_end": "02:29:48.840",
      "text": "چه رو شیش، خیلی خیلی خیلی خیلی خیلی"
    }
