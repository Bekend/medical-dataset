      "id": 68,
      "start": 8902.14,
      "end": 8906.14,
      "formatted_start": "02:28:22.140",
      "formatted_end": "02:28:26.140",
      "text": "آره، آفره، برای ریفلاکسش هم خیلی خوبه"
    },
    {
      "id": 69,
      "start": 8906.14,
      "end": 8908.72,
      "formatted_start": "02:28:26.140",
      "formatted_end": "02:28:28.720",
      "text": "روزی بهش رو بمون پنج هست"
    },
    {
      "id": 70,
      "start": 8912.84,
      "end": 8915.02,
      "formatted_start": "02:28:32.840",
      "formatted_end": "02:28:35.020",
      "text": "خب پیزانی ایش هم که میدی"
    },
    {
      "id": 71,
      "start": 8926.4,
      "end": 8927.9,
      "formatted_start": "02:28:46.400",
      "formatted_end": "02:28:47.900",
      "text": "این هم خدمتش"
    },
    {
      "id": 72,
      "start": 8929.08,
      "end": 8931.94,
      "formatted_start": "02:28:49.080",
      "formatted_end": "02:28:51.940",
      "text": "اون دوتا یک جانه به قد کش اینا خوبه؟"
    },
    {
      "id": 73,
      "start": 8931.94,
      "end": 8937.3,
      "formatted_start": "02:28:51.940",
      "formatted_end": "02:28:57.300",
      "text": "مزدش که خوب بود، قدرشون همونها یک ماه بعد بود"
    },
    {
      "id": 74,
      "start": 8937.3,
      "end": 8938.82,
      "formatted_start": "02:28:57.300",
      "formatted_end": "02:28:58.820",
      "text": "بله خب، حالا با من"
    },
    {
      "id": 75,
      "start": 8938.82,
      "end": 8942.98,
      "formatted_start": "02:28:58.820",
      "formatted_end": "02:29:02.980",
      "text": "جون دل و جون دل و جون دل"
    },
    {
      "id": 76,
      "start": 8942.98,
      "end": 8945.78,
      "formatted_start": "02:29:02.980",
      "formatted_end": "02:29:05.780",
      "text": "زدیش چرا که بیرش؟"
    },
