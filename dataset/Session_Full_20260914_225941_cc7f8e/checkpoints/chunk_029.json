  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8706.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:06.000",
      "text": "اولا نتونی این بچه رو کنترولش بکنی؟"
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "بنابراین از این حالات که با شما بردارید، با شما بردارید."
    },
    {
      "id": 2,
      "start": 8732.0,
      "end": 8734.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:34.000",
      "text": "برای این حالات که برای شما بردارید، برای شما بردارید، برای شما بردارید."
    },
    {
      "id": 3,
      "start": 8734.0,
      "end": 8737.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:37.000",
      "text": "منی به خدا سعی کنی میشه همون"
    },
    {
      "id": 4,
      "start": 8737.0,
      "end": 8740.0,
      "formatted_start": "02:25:37.000",
      "formatted_end": "02:25:40.000",
      "text": "همون دفعه میخوای شیر بگی قبلش به من برسیدن"
    },
    {
      "id": 5,
      "start": 8740.0,
      "end": 8744.0,
      "formatted_start": "02:25:40.000",
      "formatted_end": "02:25:44.000",
      "text": "خواه؟ اصلا موقعی که شیرم نمیخوره"
    },
    {
      "id": 6,
      "start": 8744.0,
      "end": 8746.0,
      "formatted_start": "02:25:44.000",
      "formatted_end": "02:25:46.000",
      "text": "صورتشو بذار برسیدن"
    },
    {
      "id": 7,
      "start": 8746.0,
      "end": 8749.0,
      "formatted_start": "02:25:46.000",
      "formatted_end": "02:25:49.000",
      "text": "بذار با پوی بدنت اخت بگیرن"
    },
    {
      "id": 8,
      "start": 8749.0,
      "end": 8754.0,
      "formatted_start": "02:25:49.000",
      "formatted_end": "02:25:54.000",
      "text": "خواه؟ بعد کم کم بگیر خودتو ببینی خودش اینکه نیاز سیرانتی خوره"
    },
    {
      "id": 9,
      "start": 8754.0,
      "end": 8758.0,
      "formatted_start": "02:25:54.000",
      "formatted_end": "02:25:58.000",
      "text": "باشه؟ با من امیدتو از دست نداری"
    },
    {
      "id": 10,
      "start": 8758.0,
      "end": 8760.0,
      "formatted_start": "02:25:58.000",
      "formatted_end": "02:26:00.000",
      "text": "تازه بزرگ بشه میتونی"
    },
    {
      "id": 11,
      "start": 8760.0,
      "end": 8763.0,
      "formatted_start": "02:26:00.000",
      "formatted_end": "02:26:03.000",
      "text": "کلی شیر خوش گرفتن براش"
    },
    {
      "id": 12,
      "start": 8763.0,
      "end": 8765.0,
      "formatted_start": "02:26:03.000",
