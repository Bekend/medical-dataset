      "formatted_start": "01:51:11.000",
      "formatted_end": "01:51:13.000",
      "text": "محمد سارو؟"
    },
    {
      "id": 11,
      "start": 6673.0,
      "end": 6675.0,
      "formatted_start": "01:51:13.000",
      "formatted_end": "01:51:15.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 6675.0,
      "end": 6677.0,
      "formatted_start": "01:51:15.000",
      "formatted_end": "01:51:17.000",
      "text": "مشایله"
    },
    {
      "id": 13,
      "start": 6677.0,
      "end": 6679.0,
      "formatted_start": "01:51:17.000",
      "formatted_end": "01:51:19.000",
      "text": "الان شده ۱۴ ساله شده"
    },
    {
      "id": 14,
      "start": 6679.0,
      "end": 6681.0,
      "formatted_start": "01:51:19.000",
      "formatted_end": "01:51:21.000",
      "text": "۱۰ سالش، آره"
    },
    {
      "id": 15,
      "start": 6681.0,
      "end": 6683.0,
      "formatted_start": "01:51:21.000",
      "formatted_end": "01:51:23.000",
      "text": "اون گوشه همه شو گوشه شو اونش رو فوند میکرد"
    },
    {
      "id": 16,
      "start": 6683.0,
      "end": 6685.0,
      "formatted_start": "01:51:23.000",
      "formatted_end": "01:51:25.000",
      "text": "دیده دیده دلان باشد"
    },
    {
      "id": 17,
      "start": 6685.0,
      "end": 6687.0,
      "formatted_start": "01:51:25.000",
      "formatted_end": "01:51:27.000",
      "text": "این گوشه شو همه شو فوند میکرد"
    },
    {
      "id": 18,
      "start": 6687.0,
      "end": 6689.0,
      "formatted_start": "01:51:27.000",
      "formatted_end": "01:51:29.000",
      "text": "یا اون اولیه بود؟"
    },
    {
      "id": 19,
      "start": 6689.0,
      "end": 6691.0,
      "formatted_start": "01:51:29.000",
      "formatted_end": "01:51:31.000",
      "text": "نه، اون"
    },
    {
      "id": 20,
      "start": 6691.0,
      "end": 6693.0,
      "formatted_start": "01:51:31.000",
      "formatted_end": "01:51:33.000",
      "text": "محسلی، دکتر محسلی"
    },
    {
      "id": 21,
      "start": 6693.0,
      "end": 6695.0,
      "formatted_start": "01:51:33.000",
      "formatted_end": "01:51:35.000",
      "text": "نه، نه، نه، اینم بود دیگه"
    },
    {
      "id": 22,
      "start": 6695.0,
      "end": 6697.0,
      "formatted_start": "01:51:35.000",
      "formatted_end": "01:51:37.000",
      "text": "محمد فاروق هم بود، آره بابا"
    },
    {
      "id": 23,
      "start": 6703.0,
      "end": 6705.0,
      "formatted_start": "01:51:43.000",
      "formatted_end": "01:51:45.000",
      "text": "چه قابل کامل؟"
    },
    {
      "id": 24,
      "start": 6705.0,
      "end": 6707.0,
      "formatted_start": "01:51:45.000",
      "formatted_end": "01:51:47.000",
      "text": "آره، تعریفش نه نمیسخم دکتر"
    },
    {
      "id": 25,
      "start": 6707.0,
      "end": 6711.0,
      "formatted_start": "01:51:47.000",
      "formatted_end": "01:51:51.000",
      "text": "از اینجا بردم بیارم هست در این آرمایش برم"
    },
    {
      "id": 26,
      "start": 6711.0,
      "end": 6713.0,
      "formatted_start": "01:51:51.000",
      "formatted_end": "01:51:53.000",
      "text": "آه شما الان تاریخ بردن هست"
    },
    {
      "id": 27,
      "start": 6713.0,
      "end": 6717.0,
      "formatted_start": "01:51:53.000",
      "formatted_end": "01:51:57.000",
      "text": "خب شما تا آخر شهری بر بخترین"
    },
    {
      "id": 28,
      "start": 6717.0,
      "end": 6718.0,
      "formatted_start": "01:51:57.000",
      "formatted_end": "01:51:58.000",
      "text": "آه باشی"
    },
    {
      "id": 29,
      "start": 6718.0,
      "end": 6720.0,
      "formatted_start": "01:51:58.000",
      "formatted_end": "01:52:00.000",
      "text": "دو هفته دیگه بخترین"
    },
    {
      "id": 30,
      "start": 6722.0,
      "end": 6725.0,
      "formatted_start": "01:52:02.000",
      "formatted_end": "01:52:05.000",
      "text": "ننده شو، چربی شو، تیرویده شو"
    },
    {
      "id": 31,
      "start": 6725.0,
      "end": 6726.0,
      "formatted_start": "01:52:05.000",
      "formatted_end": "01:52:06.000",
      "text": "چربی، همه چیز باشه"
    },
    {
      "id": 32,
      "start": 6726.0,
      "end": 6730.0,
      "formatted_start": "01:52:06.000",
      "formatted_end": "01:52:10.000",
      "text": "بیتامین بی شو، با آزما شهر باشه"
    },
    {
      "id": 33,
      "start": 6730.0,
      "end": 6732.0,
      "formatted_start": "01:52:10.000",
      "formatted_end": "01:52:12.000",
      "text": "با خودی هست"
    },
    {
      "id": 34,
      "start": 6732.0,
      "end": 6733.0,
      "formatted_start": "01:52:12.000",
      "formatted_end": "01:52:13.000",
      "text": "آه"
    },
    {
      "id": 35,
      "start": 6737.0,
      "end": 6743.0,
      "formatted_start": "01:52:17.000",
      "formatted_end": "01:52:23.000",
      "text": "موسیقی"
    },
    {
      "id": 36,
      "start": 6743.0,
      "end": 6747.0,
      "formatted_start": "01:52:23.000",
      "formatted_end": "01:52:27.000",
