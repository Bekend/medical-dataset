    },
    {
      "id": 65,
      "start": 6822.0,
      "end": 6824.7,
      "formatted_start": "01:53:42.000",
      "formatted_end": "01:53:44.700",
      "text": "بله اینقدر صافم میکنه، اینجا شکنه، خشکش میکنه"
    },
    {
      "id": 66,
      "start": 6824.7,
      "end": 6825.7,
      "formatted_start": "01:53:44.700",
      "formatted_end": "01:53:45.700",
      "text": "طب چی؟"
    },
    {
      "id": 67,
      "start": 6825.7,
      "end": 6829.5,
      "formatted_start": "01:53:45.700",
      "formatted_end": "01:53:49.500",
      "text": "طب هم داره، دیشه برم طب کرد، برای کم بوده اینجا صبح زیاد صافم"
    },
    {
      "id": 68,
      "start": 6829.5,
      "end": 6833.5,
      "formatted_start": "01:53:49.500",
      "formatted_end": "01:53:53.500",
      "text": "یا... چیه؟ چیه؟"
    },
    {
      "id": 69,
      "start": 6835.5,
      "end": 6837.5,
      "formatted_start": "01:53:55.500",
      "formatted_end": "01:53:57.500",
      "text": "چند ماه شده؟"
    },
    {
      "id": 70,
      "start": 6841.5,
      "end": 6844.5,
      "formatted_start": "01:54:01.500",
      "formatted_end": "01:54:04.500",
      "text": "یعنی تازه با کم شده؟ اگه شما یکی شده؟"
    },
    {
      "id": 71,
      "start": 6844.5,
      "end": 6845.5,
      "formatted_start": "01:54:04.500",
      "formatted_end": "01:54:05.500",
      "text": "بله یه باید شده"
    },
    {
      "id": 72,
      "start": 6845.5,
      "end": 6849.5,
      "formatted_start": "01:54:05.500",
      "formatted_end": "01:54:09.500",
