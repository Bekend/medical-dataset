  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "برنامه بیمار، بیمار، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6635.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:35.000",
      "text": "میترسم کمکودی چیز داره آره چایدم قند داره"
    },
    {
      "id": 2,
      "start": 6635.0,
      "end": 6638.0,
      "formatted_start": "01:50:35.000",
      "formatted_end": "01:50:38.000",
      "text": "چون ادرارش هم خوب نشده"
    },
    {
      "id": 3,
      "start": 6638.0,
      "end": 6643.0,
      "formatted_start": "01:50:38.000",
      "formatted_end": "01:50:43.000",
      "text": "آره من احساس میکنم چاید قند داسته باشه"
    },
    {
      "id": 4,
      "start": 6648.0,
      "end": 6651.0,
      "formatted_start": "01:50:48.000",
      "formatted_end": "01:50:51.000",
      "text": "ببخشید که لحمت بیدم"
    },
    {
      "id": 5,
      "start": 6651.0,
      "end": 6659.0,
      "formatted_start": "01:50:51.000",
      "formatted_end": "01:50:59.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 6659.0,
      "end": 6661.0,
      "formatted_start": "01:50:59.000",
      "formatted_end": "01:51:01.000",
      "text": "بگو که کدومه ایش؟"
    },
    {
      "id": 7,
      "start": 6661.0,
      "end": 6663.0,
      "formatted_start": "01:51:01.000",
      "formatted_end": "01:51:03.000",
      "text": "۲۲۱"
    },
    {
      "id": 8,
      "start": 6663.0,
      "end": 6669.0,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:09.000",
      "text": "۵۳۹۱"
    },
    {
      "id": 9,
      "start": 6669.0,
      "end": 6671.0,
      "formatted_start": "01:51:09.000",
      "formatted_end": "01:51:11.000",
      "text": "۶۱"
    },
