  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11702.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:02.000",
      "text": "خیلی خوب، خدا را شد، اشانلا."
    },
    {
      "id": 1,
      "start": 11702.0,
      "end": 11704.0,
      "formatted_start": "03:15:02.000",
      "formatted_end": "03:15:04.000",
      "text": "اشانلا، نواتو ناروم باشی."
    },
    {
      "id": 2,
      "start": 11704.0,
      "end": 11708.0,
      "formatted_start": "03:15:04.000",
      "formatted_end": "03:15:08.000",
      "text": "نه، بعدش اینکه من خوب بود. یعنی بعد از یه دو سالگی، باید بچه خوبی."
    },
    {
      "id": 3,
      "start": 11708.0,
      "end": 11710.0,
      "formatted_start": "03:15:08.000",
      "formatted_end": "03:15:10.000",
      "text": "مالا من بعدشم شیطان باشم."
    },
    {
      "id": 4,
      "start": 11710.0,
      "end": 11712.0,
      "formatted_start": "03:15:10.000",
      "formatted_end": "03:15:12.000",
      "text": "آخه، هر بچه یه مالش عزیزه."
    },
    {
      "id": 5,
      "start": 11712.0,
      "end": 11714.0,
      "formatted_start": "03:15:12.000",
      "formatted_end": "03:15:14.000",
      "text": "نستش آره."
    },
    {
      "id": 6,
      "start": 11714.0,
      "end": 11716.0,
      "formatted_start": "03:15:14.000",
      "formatted_end": "03:15:16.000",
      "text": "ماردونه در خدا باشه."
    },
    {
      "id": 7,
      "start": 11730.0,
      "end": 11759.98,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 8,
      "start": 11760.0,
      "end": 11790.0,
      "formatted_start": "03:16:00.000",
      "formatted_end": "03:16:30.000",
      "text": "برای اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 9,
      "start": 11790.0,
      "end": 11793.0,
      "formatted_start": "03:16:30.000",
      "formatted_end": "03:16:33.000",
      "text": "و داد پویا پدیان رو یه همچین چیزی"
    },
    {
      "id": 10,
      "start": 11793.0,
      "end": 11795.0,
      "formatted_start": "03:16:33.000",
      "formatted_end": "03:16:35.000",
      "text": "زیاد جواب نداشت"
    },
    {
      "id": 11,
      "start": 11795.0,
      "end": 11797.0,
      "formatted_start": "03:16:35.000",
      "formatted_end": "03:16:37.000",
      "text": "بعد مثلا مادران گفتم بهش گرمیچهر بدید"
    },
    {
      "id": 12,
      "start": 11797.0,
      "end": 11798.0,
      "formatted_start": "03:16:37.000",
      "formatted_end": "03:16:38.000",
      "text": "اون هم زیاد"
    },
    {
      "id": 13,
      "start": 11798.0,
      "end": 11800.0,
      "formatted_start": "03:16:38.000",
      "formatted_end": "03:16:40.000",
      "text": "میریم چشم کشورده"
    },
    {
      "id": 14,
      "start": 11800.0,
      "end": 11802.0,
      "formatted_start": "03:16:40.000",
      "formatted_end": "03:16:42.000",
      "text": "به میگفتن که مثلا شیرکورد"
    },
    {
      "id": 15,
      "start": 11802.0,
      "end": 11804.0,
      "formatted_start": "03:16:42.000",
      "formatted_end": "03:16:44.000",
      "text": "نیم ساعت نگرش دارین"
    },
    {
      "id": 16,
      "start": 11804.0,
      "end": 11806.0,
      "formatted_start": "03:16:44.000",
      "formatted_end": "03:16:46.000",
      "text": "که مثلا چیزش بشه"
    },
    {
      "id": 17,
      "start": 11806.0,
      "end": 11808.0,
      "formatted_start": "03:16:46.000",
      "formatted_end": "03:16:48.000",
      "text": "من نیم ساعت هم نگر میدارم"
    },
    {
      "id": 18,
      "start": 11808.0,
      "end": 11810.0,
      "formatted_start": "03:16:48.000",
      "formatted_end": "03:16:50.000",
      "text": "خب تو خواب عمیرم رو میره"
    },
    {
      "id": 19,
      "start": 11810.0,
      "end": 11812.0,
      "formatted_start": "03:16:50.000",
      "formatted_end": "03:16:52.000",
      "text": "خب بعد میگذارم نیست داریم"
    },
    {
      "id": 20,
      "start": 11812.0,
      "end": 11814.0,
      "formatted_start": "03:16:52.000",
      "formatted_end": "03:16:54.000",
      "text": "بعد نگر پشت یه چیزی میکنی که انگار داره ترش میکنه"
    },
    {
      "id": 21,
      "start": 11814.0,
      "end": 11815.0,
      "formatted_start": "03:16:54.000",
      "formatted_end": "03:16:55.000",
      "text": "یا میخواد"
    },
    {
      "id": 22,
      "start": 11815.0,
      "end": 11817.0,
      "formatted_start": "03:16:55.000",
      "formatted_end": "03:16:57.000",
      "text": "برای دماغش می‌کنه"
    },
    {
      "id": 23,
      "start": 11817.0,
      "end": 11819.0,
      "formatted_start": "03:16:57.000",
      "formatted_end": "03:16:59.000",
      "text": "زیاد باده می‌گنه"
    },
    {
      "id": 24,
      "start": 11819.0,
      "end": 11821.0,
      "formatted_start": "03:16:59.000",
      "formatted_end": "03:17:01.000",
      "text": "زیاد نه بلی همه زیاد می‌خواد آراغ بدنم"
    },
    {
      "id": 25,
      "start": 11821.0,
      "end": 11823.0,
      "formatted_start": "03:17:01.000",
      "formatted_end": "03:17:03.000",
      "text": "خیلی گریه می‌کنه موقع آراغ بدن"
    },
    {
      "id": 26,
      "start": 11823.0,
      "end": 11825.0,
      "formatted_start": "03:17:03.000",
      "formatted_end": "03:17:05.000",
      "text": "نمی‌تونه آراغ بدن"
    },
    {
      "id": 27,
      "start": 11825.0,
      "end": 11827.0,
      "formatted_start": "03:17:05.000",
      "formatted_end": "03:17:07.000",
      "text": "خب شیر ماده هم می‌کنه"
    },
    {
      "id": 28,
      "start": 11827.0,
      "end": 11829.0,
      "formatted_start": "03:17:07.000",
      "formatted_end": "03:17:09.000",
      "text": "بله"
    },
    {
      "id": 29,
      "start": 11829.0,
      "end": 11831.0,
      "formatted_start": "03:17:09.000",
      "formatted_end": "03:17:11.000",
      "text": "شیر خوش نمی‌دهید"
    },
    {
      "id": 30,
      "start": 11831.0,
      "end": 11833.0,
      "formatted_start": "03:17:11.000",
      "formatted_end": "03:17:13.000",
      "text": "چند کیلو بود بدانی آمد؟"
    },
    {
      "id": 31,
      "start": 11833.0,
      "end": 11835.0,
      "formatted_start": "03:17:13.000",
      "formatted_end": "03:17:15.000",
      "text": "سه و دویز"
    },
    {
      "id": 32,
      "start": 11841.0,
      "end": 11843.0,
      "formatted_start": "03:17:21.000",
      "formatted_end": "03:17:23.000",
      "text": "شکرم بشه خوب کار می‌کنه"
    },
    {
      "id": 33,
      "start": 11843.0,
      "end": 11847.0,
      "formatted_start": "03:17:23.000",
      "formatted_end": "03:17:27.000",
      "text": "نفخم زیاد دهه، بادشکم زیاد میده"
    },
    {
      "id": 34,
      "start": 11847.0,
      "end": 11851.0,
      "formatted_start": "03:17:27.000",
      "formatted_end": "03:17:31.000",
      "text": "آره میده، و نفرم خیلی باید زور میزنه"
    },
    {
      "id": 35,
      "start": 11851.0,
      "end": 11856.0,
      "formatted_start": "03:17:31.000",
      "formatted_end": "03:17:36.000",
      "text": "آره، دمتو باز کنه"
    },
    {
      "id": 36,
      "start": 11856.0,
      "end": 11861.0,
      "formatted_start": "03:17:36.000",
      "formatted_end": "03:17:41.000",
      "text": "خیلی مثلا اینجوری چیزی بوده، رجبانه با همین صدقه کمش"
    },
    {
      "id": 37,
      "start": 11861.0,
      "end": 11867.0,
      "formatted_start": "03:17:41.000",
      "formatted_end": "03:17:47.000",
      "text": "خیلی هم مثلا اینجوری شربتانیدارو عذیب بکنی که باید بخواهد، آره خیلی"
    },
    {
      "id": 38,
      "start": 11873.0,
      "end": 11879.0,
      "formatted_start": "03:17:53.000",
      "formatted_end": "03:17:59.000",
      "text": "من یک سوالی دیگر میشم، این پایان سرش داره از بقیه‌های اینجور بیار میشه"
    },
    {
      "id": 39,
      "start": 11879.0,
      "end": 11882.0,
      "formatted_start": "03:17:59.000",
      "formatted_end": "03:18:02.000",
      "text": "و مخصوصا یه طرفش این کار زیادتر از اینجور چی کار بر باقایی؟"
    },
    {
      "id": 40,
      "start": 11882.0,
      "end": 11884.0,
      "formatted_start": "03:18:02.000",
      "formatted_end": "03:18:04.000",
      "text": "درست میشه"
    },
    {
      "id": 41,
      "start": 11884.0,
      "end": 11886.0,
      "formatted_start": "03:18:04.000",
      "formatted_end": "03:18:06.000",
      "text": "درست میشه؟"
    },
    {
      "id": 42,
      "start": 11886.0,
      "end": 11889.0,
      "formatted_start": "03:18:06.000",
      "formatted_end": "03:18:09.000",
      "text": "درست میشه، یه قدر بزرگیردش رو دمرش بذار"
    },
    {
      "id": 43,
      "start": 11889.0,
      "end": 11890.0,
      "formatted_start": "03:18:09.000",
      "formatted_end": "03:18:10.000",
      "text": "دمر خیلی؟"
    },
    {
      "id": 44,
      "start": 11890.0,
      "end": 11894.0,
      "formatted_start": "03:18:10.000",
      "formatted_end": "03:18:14.000",
      "text": "آره، این که سرش اینجوری میخواد بیار بالا بگیرن تا مینه آن"
    },
    {
      "id": 45,
      "start": 11894.0,
      "end": 11895.0,
      "formatted_start": "03:18:14.000",
      "formatted_end": "03:18:15.000",
      "text": "آره"
    },
    {
      "id": 46,
      "start": 11895.0,
      "end": 11898.66,
      "formatted_start": "03:18:15.000",
      "formatted_end": "03:18:18.660",
      "text": "از اینجا بسیاری که از موردش کشیده باشه سرش خورده گیره"
    },
    {
      "id": 47,
      "start": 11898.66,
      "end": 11900.66,
      "formatted_start": "03:18:18.660",
      "formatted_end": "03:18:20.660",
      "text": "و بعد گردارشو ماشاله خوب هم بگم"
    },
    {
      "id": 48,
      "start": 11900.66,
      "end": 11902.66,
      "formatted_start": "03:18:20.660",
      "formatted_end": "03:18:22.660",
      "text": "خیلی هم خدا میشه"
    },
    {
      "id": 49,
      "start": 11907.66,
      "end": 11909.66,
      "formatted_start": "03:18:27.660",
      "formatted_end": "03:18:29.660",
      "text": "چه قیافه از خوبه ای تو"
    },
    {
      "id": 50,
      "start": 11909.66,
      "end": 11910.66,
      "formatted_start": "03:18:29.660",
      "formatted_end": "03:18:30.660",
      "text": "خیلی از خوبه"
    },
    {
      "id": 51,
      "start": 11910.66,
      "end": 11912.66,
      "formatted_start": "03:18:30.660",
      "formatted_end": "03:18:32.660",
      "text": "دو من از خوبه باش کن"
    },
    {
      "id": 52,
      "start": 11915.66,
      "end": 11917.66,
      "formatted_start": "03:18:35.660",
      "formatted_end": "03:18:37.660",
      "text": "از اون تست هرچی دیگه ها میشه"
    },
    {
      "id": 53,
      "start": 11917.66,
      "end": 11919.66,
      "formatted_start": "03:18:37.660",
      "formatted_end": "03:18:39.660",
      "text": "بگم اینجا اصلا باید شوخه میکنم"
    },
    {
      "id": 54,
      "start": 11919.66,
      "end": 11921.66,
      "formatted_start": "03:18:39.660",
      "formatted_end": "03:18:41.660",
      "text": "بگم با خودش بگم خب که چی؟"
    },
    {
      "id": 55,
      "start": 11921.66,
      "end": 11923.66,
      "formatted_start": "03:18:41.660",
      "formatted_end": "03:18:43.660",
      "text": "من از هم گردار کنم"
    },
    {
      "id": 56,
      "start": 11923.66,
      "end": 11953.66,
      "formatted_start": "03:18:43.660",
      "formatted_end": "03:19:13.660",
      "text": "درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای اینکه درسته اون رو برای این"
    },
    {
      "id": 57,
      "start": 11953.66,
      "end": 11957.66,
      "formatted_start": "03:19:13.660",
      "formatted_end": "03:19:17.660",
      "text": "از این گرمیچه هم داریم و خویافتی هم که به فهم داریم"
    },
    {
      "id": 58,
      "start": 11957.66,
      "end": 11963.66,
      "formatted_start": "03:19:17.660",
      "formatted_end": "03:19:23.660",
      "text": "یه از دو ماهگی به بعد خودش هم کم کلیک هاشون بهتر میشه"
    },
    {
      "id": 59,
      "start": 11963.66,
      "end": 11967.66,
      "formatted_start": "03:19:23.660",
      "formatted_end": "03:19:27.660",
      "text": "بله خب منو برم درست دارم که از اینکه"
    },
    {
      "id": 60,
      "start": 11967.66,
      "end": 11969.66,
      "formatted_start": "03:19:27.660",
      "formatted_end": "03:19:29.660",
      "text": "از اینکه خودش هم خوب میشه"
    },
    {
      "id": 61,
      "start": 11973.66,
      "end": 11976.66,
      "formatted_start": "03:19:33.660",
      "formatted_end": "03:19:36.660",
      "text": "تشا دو ماه گردی از خوب؟"
    },
    {
      "id": 62,
      "start": 11976.66,
      "end": 11978.66,
      "formatted_start": "03:19:36.660",
      "formatted_end": "03:19:38.660",
      "text": "آره تشا سن رو رویگیه"
    },
    {
      "id": 63,
      "start": 11978.66,
      "end": 11980.66,
      "formatted_start": "03:19:38.660",
      "formatted_end": "03:19:40.660",
      "text": "آره ولی میان برمیگرده"
    },
    {
      "id": 64,
      "start": 11980.66,
      "end": 11982.66,
      "formatted_start": "03:19:40.660",
      "formatted_end": "03:19:42.660",
      "text": "چون نه باباش رنگی نمیگرد"
    },
    {
      "id": 65,
      "start": 11982.66,
      "end": 11986.18,
      "formatted_start": "03:19:42.660",
      "formatted_end": "03:19:46.180",
      "text": "نه بله دیگه در این حال بگیر یه ذره برم گرده برای بچنگی رنگیجه"
    },
    {
      "id": 66,
      "start": 11986.18,
      "end": 11989.9,
      "formatted_start": "03:19:46.180",
      "formatted_end": "03:19:49.900",
      "text": "آره مامان همه میگه با قرض آسفلی نه من می کشم رنگی نه بابا"
    },
    {
      "id": 67,
      "start": 11989.9,
      "end": 11992.66,
      "formatted_start": "03:19:49.900",
      "formatted_end": "03:19:52.660",
      "text": "خب شما یه حالت میشیدن"
    },
    {
      "id": 68,
      "start": 11992.66,
      "end": 11994.66,
      "formatted_start": "03:19:52.660",
      "formatted_end": "03:19:54.660",
      "text": "نه بله ببینیم آره بچنگی نمی کشم"
    },
    {
      "id": 69,
      "start": 11994.66,
      "end": 11995.66,
      "formatted_start": "03:19:54.660",
      "formatted_end": "03:19:55.660",
      "text": "چی شدی؟"
    },
    {
      "id": 70,
      "start": 11995.66,
      "end": 11996.16,
      "formatted_start": "03:19:55.660",
      "formatted_end": "03:19:56.160",
      "text": "چی؟"
    },
    {
      "id": 71,
      "start": 11996.16,
      "end": 11996.66,
      "formatted_start": "03:19:56.160",
      "formatted_end": "03:19:56.660",
      "text": "نه چی؟"
    },
    {
      "id": 72,
      "start": 11996.66,
      "end": 11997.66,
      "formatted_start": "03:19:56.660",
      "formatted_end": "03:19:57.660",
      "text": "آره نه"
    },
    {
      "id": 73,
      "start": 11997.66,
      "end": 11998.16,
      "formatted_start": "03:19:57.660",
      "formatted_end": "03:19:58.160",
      "text": "نه چی؟"
    },
    {
      "id": 74,
      "start": 11998.16,
      "end": 11998.66,
      "formatted_start": "03:19:58.160",
      "formatted_end": "03:19:58.660",
      "text": "نه چی؟"
    },
    {
      "id": 75,
      "start": 11998.66,
      "end": 11999.16,
      "formatted_start": "03:19:58.660",
      "formatted_end": "03:19:59.160",
      "text": "نه چی؟"
    },
    {
      "id": 76,
      "start": 11999.16,
      "end": 11999.66,
      "formatted_start": "03:19:59.160",
      "formatted_end": "03:19:59.660",
      "text": "نه چی؟"
    },
    {
      "id": 77,
      "start": 11999.66,
      "end": 12000.16,
      "formatted_start": "03:19:59.660",
      "formatted_end": "03:20:00.160",
      "text": "نه چی؟"
    }
  ],
  "status": "completed"
}