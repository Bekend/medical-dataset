    },
    {
      "id": 4,
      "start": 8166.0,
      "end": 8168.0,
      "formatted_start": "02:16:06.000",
      "formatted_end": "02:16:08.000",
      "text": "آره من خیلی کردم بیشتر"
    },
    {
      "id": 5,
      "start": 8168.0,
      "end": 8170.0,
      "formatted_start": "02:16:08.000",
      "formatted_end": "02:16:10.000",
      "text": "کمالیه شو یکی هم شما بقیه بوده"
    },
    {
      "id": 6,
      "start": 8172.0,
      "end": 8173.0,
      "formatted_start": "02:16:12.000",
      "formatted_end": "02:16:13.000",
      "text": "چند وقت شد؟"
    },
    {
      "id": 7,
      "start": 8173.0,
      "end": 8174.0,
      "formatted_start": "02:16:13.000",
      "formatted_end": "02:16:14.000",
      "text": "کندم"
    },
    {
      "id": 8,
      "start": 8174.0,
      "end": 8176.0,
      "formatted_start": "02:16:14.000",
      "formatted_end": "02:16:16.000",
      "text": "بخبر که پرداخت"
    },
    {
      "id": 9,
      "start": 8178.0,
      "end": 8180.0,
      "formatted_start": "02:16:18.000",
      "formatted_end": "02:16:20.000",
      "text": "چی خوبی بود؟"
    },
    {
      "id": 10,
      "start": 8182.0,
      "end": 8183.0,
      "formatted_start": "02:16:22.000",
      "formatted_end": "02:16:23.000",
      "text": "وردی داشت؟"
    },
    {
      "id": 11,
      "start": 8183.0,
      "end": 8184.0,
      "formatted_start": "02:16:23.000",
      "formatted_end": "02:16:24.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 8184.0,
      "end": 8185.0,
      "formatted_start": "02:16:24.000",
      "formatted_end": "02:16:25.000",
      "text": "پردخمه آردی"
    },
    {
      "id": 13,
      "start": 8185.0,
      "end": 8186.0,
      "formatted_start": "02:16:25.000",
      "formatted_end": "02:16:26.000",
      "text": "خب وردی شو چی کار کردی؟"
    },
    {
      "id": 14,
      "start": 8186.0,
      "end": 8188.0,
      "formatted_start": "02:16:26.000",
      "formatted_end": "02:16:28.000",
      "text": "آزمایش داری؟ در رفتگاه بودش؟"
    },
    {
      "id": 15,
      "start": 8188.0,
      "end": 8194.4,
      "formatted_start": "02:16:28.000",
      "formatted_end": "02:16:34.400",
      "text": "من دکتر رو بردم، شب دکتر فا چنده دید و بعد دو روز ۲۴۸ سال"
    },
    {
      "id": 16,
      "start": 8194.4,
      "end": 8195.6,
      "formatted_start": "02:16:34.400",
      "formatted_end": "02:16:35.600",
      "text": "دستگاه بود"
    },
    {
      "id": 17,
      "start": 8195.6,
      "end": 8198.1,
      "formatted_start": "02:16:35.600",
      "formatted_end": "02:16:38.100",
      "text": "دستگاه بود، مسته بود با اون چیزش گرده"
    },
    {
      "id": 18,
      "start": 8198.1,
      "end": 8198.9,
      "formatted_start": "02:16:38.100",
      "formatted_end": "02:16:38.900",
      "text": "آها خب"
    },
    {
      "id": 19,
      "start": 8198.9,
      "end": 8203.2,
      "formatted_start": "02:16:38.900",
      "formatted_end": "02:16:43.200",
      "text": "بعد دوباره بردم، گفت الان نهه"
    },
    {
      "id": 20,
      "start": 8203.2,
      "end": 8203.7,
      "formatted_start": "02:16:43.200",
      "formatted_end": "02:16:43.700",
      "text": "آه"
    },
    {
      "id": 21,
      "start": 8203.7,
      "end": 8204.2,
      "formatted_start": "02:16:43.700",
      "formatted_end": "02:16:44.200",
      "text": "خب"
    },
    {
      "id": 22,
      "start": 8204.2,
      "end": 8207.5,
      "formatted_start": "02:16:44.200",
      "formatted_end": "02:16:47.500",
      "text": "باز الان حس میکنم صورتش بیشتر زاد شده"
    },
    {
      "id": 23,
      "start": 8207.5,
      "end": 8209.0,
      "formatted_start": "02:16:47.500",
      "formatted_end": "02:16:49.000",
      "text": "بیشتر زاده، خب باشم زاده"
    },
    {
      "id": 24,
      "start": 8209.0,
      "end": 8209.6,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:49.600",
      "text": "آه"
    },
    {
      "id": 25,
      "start": 8209.6,
      "end": 8211.0,
      "formatted_start": "02:16:49.600",
      "formatted_end": "02:16:51.000",
      "text": "خب کنو خونی چی؟"
    },
    {
      "id": 26,
      "start": 8211.0,
      "end": 8212.8,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:52.800",
      "text": "من آیا مثبت"
    },
    {
      "id": 27,
      "start": 8212.8,
      "end": 8214.0,
      "formatted_start": "02:16:52.800",
      "formatted_end": "02:16:54.000",
      "text": "منم آیا مثبت"
    },
    {
      "id": 28,
      "start": 8214.0,
      "end": 8215.0,
      "formatted_start": "02:16:54.000",
      "formatted_end": "02:16:55.000",
      "text": "خب"
    },
    {
      "id": 29,
      "start": 8215.0,
      "end": 8217.0,
      "formatted_start": "02:16:55.000",
      "formatted_end": "02:16:57.000",
      "text": "خب همون که مادر اونیست"
    },
    {
      "id": 30,
      "start": 8219.0,
      "end": 8221.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:01.000",
      "text": "ناپشن که خوبه"
    },
    {
      "id": 31,
      "start": 8221.0,
      "end": 8223.0,
      "formatted_start": "02:17:01.000",
      "formatted_end": "02:17:03.000",
      "text": "که که باقی اونکردیه"
    },
    {
      "id": 32,
      "start": 8223.0,
      "end": 8225.0,
      "formatted_start": "02:17:03.000",
      "formatted_end": "02:17:05.000",
      "text": "بره بیرون بره"
    },
    {
      "id": 33,
      "start": 8225.0,
      "end": 8227.0,
      "formatted_start": "02:17:05.000",
      "formatted_end": "02:17:07.000",
      "text": "بیرون که"
    },
    {
      "id": 34,
      "start": 8227.0,
      "end": 8229.0,
      "formatted_start": "02:17:07.000",
      "formatted_end": "02:17:09.000",
      "text": "حدودا یه ماهی اینجوری باید درست بشید"
    },
    {
      "id": 35,
      "start": 8231.0,
      "end": 8233.0,
      "formatted_start": "02:17:11.000",
      "formatted_end": "02:17:13.000",
      "text": "خب یه ذره بچه ها هم آره"
    },
    {
      "id": 36,
      "start": 8233.0,
      "end": 8235.0,
      "formatted_start": "02:17:13.000",
      "formatted_end": "02:17:15.000",
      "text": "معمول از 3 روزوگی"
    },
    {
      "id": 37,
      "start": 8235.0,
      "end": 8237.0,
      "formatted_start": "02:17:15.000",
      "formatted_end": "02:17:17.000",
      "text": "شروع میشه"
    },
    {
      "id": 38,
      "start": 8237.0,
      "end": 8239.0,
      "formatted_start": "02:17:17.000",
      "formatted_end": "02:17:19.000",
      "text": "میره بالا تا 7 روزوگی"
    },
    {
      "id": 39,
      "start": 8239.0,
      "end": 8241.0,
      "formatted_start": "02:17:19.000",
      "formatted_end": "02:17:21.000",
      "text": "تا 6 روزوگی"
    },
    {
      "id": 40,
      "start": 8241.0,
      "end": 8243.0,
      "formatted_start": "02:17:21.000",
      "formatted_end": "02:17:23.000",
      "text": "تا 8 روزوگی کم کم بیرون بره"
    },
    {
      "id": 41,
      "start": 8243.0,
      "end": 8247.0,
      "formatted_start": "02:17:23.000",
      "formatted_end": "02:17:27.000",
      "text": "دو هفته میشه، 15 روز بسیار زردی معمولا از زمینه"
    },
    {
      "id": 42,
      "start": 8247.0,
      "end": 8250.0,
      "formatted_start": "02:17:27.000",
      "formatted_end": "02:17:30.000",
      "text": "وانتا بعضی وقتا زردی میشه زرده تو کشیده"
    },
    {
      "id": 43,
      "start": 8250.0,
      "end": 8252.0,
      "formatted_start": "02:17:30.000",
      "formatted_end": "02:17:32.000",
      "text": "یعنی بیش از 15 روز بسیار زرده"
    },
    {
      "id": 44,
      "start": 8252.0,
      "end": 8257.0,
      "formatted_start": "02:17:32.000",
      "formatted_end": "02:17:37.000",
      "text": "و اینکه زردیش از برداشت 19 زیاد بوده"
    },
    {
      "id": 45,
      "start": 8257.0,
      "end": 8260.0,
      "formatted_start": "02:17:37.000",
      "formatted_end": "02:17:40.000",
      "text": "زردی 19 بسیار زیاد بوده"
    },
    {
      "id": 46,
      "start": 8260.0,
      "end": 8263.0,
      "formatted_start": "02:17:40.000",
      "formatted_end": "02:17:43.000",
      "text": "بعد از اینکه از دستگاه میالیش بیرون"
    },
    {
      "id": 47,
      "start": 8263.0,
      "end": 8267.0,
      "formatted_start": "02:17:43.000",
      "formatted_end": "02:17:47.000",
      "text": "خریری یک گاهی دوباره بره باید در یه حدی بره"
    },
    {
      "id": 48,
      "start": 8267.0,
      "end": 8270.0,
      "formatted_start": "02:17:47.000",
      "formatted_end": "02:17:50.000",
      "text": "بعد مدتو که کنه؟"
    },
    {
      "id": 49,
      "start": 8270.0,
      "end": 8275.0,
      "formatted_start": "02:17:50.000",
      "formatted_end": "02:17:55.000",
      "text": "این همه خواستان رو بگم. مثلا این روز بعد دو روز مدفوع کرد."
    },
    {
      "id": 50,
      "start": 8275.0,
      "end": 8276.0,
      "formatted_start": "02:17:55.000",
      "formatted_end": "02:17:56.000",
      "text": "آه."
    },
    {
      "id": 51,
      "start": 8276.0,
      "end": 8278.0,
      "formatted_start": "02:17:56.000",
      "formatted_end": "02:17:58.000",
      "text": "بعد بهش پریلاک بدم."
    },
    {
      "id": 52,
      "start": 8278.0,
      "end": 8279.0,
      "formatted_start": "02:17:58.000",
      "formatted_end": "02:17:59.000",
      "text": "شیر شیر خواهد؟"
    },
    {
      "id": 53,
      "start": 8279.0,
      "end": 8285.0,
      "formatted_start": "02:17:59.000",
      "formatted_end": "02:18:05.000",
      "text": "شیر شیر خواهد. اما که دو روز اول گرفت بعد نمیدونیم شیر شد و تا سینه منو دیگه نمیگیره."
    },
    {
      "id": 54,
      "start": 8285.0,
      "end": 8288.0,
      "formatted_start": "02:18:05.000",
      "formatted_end": "02:18:08.000",
      "text": "بعد بهش شیر خوش که نان میدم."
    },
    {
      "id": 55,
      "start": 8288.0,
      "end": 8291.0,
      "formatted_start": "02:18:08.000",
      "formatted_end": "02:18:11.000",
      "text": "با خاطر نان رو بگیر که دیگه مدفوع کن."
    },
    {
      "id": 56,
      "start": 8291.0,
      "end": 8293.0,
      "formatted_start": "02:18:11.000",
      "formatted_end": "02:18:13.000",
      "text": "بعد کیبوز رو دادم بهش اصلا نسا."
    },
    {
      "id": 57,
      "start": 8293.0,
      "end": 8294.0,
      "formatted_start": "02:18:13.000",
      "formatted_end": "02:18:14.000",
      "text": "چرا؟"
    },
    {
      "id": 58,
      "start": 8294.0,
      "end": 8300.0,
      "formatted_start": "02:18:14.000",
      "formatted_end": "02:18:20.000",
      "text": "اونا میدن همش بعد اینکه شیرها میخورد گریه میکنه، بیقرار میکنه، فشار میده به خودش"
    },
    {
      "id": 59,
      "start": 8300.0,
      "end": 8302.0,
      "formatted_start": "02:18:20.000",
      "formatted_end": "02:18:22.000",
      "text": "اصلا خوشش نمیدونه"
    },
    {
      "id": 60,
      "start": 8302.0,
      "end": 8307.0,
      "formatted_start": "02:18:22.000",
      "formatted_end": "02:18:27.000",
      "text": "خب اینا شیرها خوششی خیلی خوبیه، اونا که خیلی دیگر بزرگ شکراتون کار میکنه میتونیم اول پاریم، خب"
    },
    {
      "id": 61,
      "start": 8307.0,
      "end": 8315.0,
      "formatted_start": "02:18:27.000",
      "formatted_end": "02:18:35.000",
      "text": "ولی مشکلی نداریم، خب بچه شیرها ممکنه دوزه ده بار ده میکنه، ممکنه هم ده سیرها نمیدونه"
    },
    {
      "id": 62,
      "start": 8315.0,
      "end": 8319.0,
      "formatted_start": "02:18:35.000",
      "formatted_end": "02:18:39.000",
      "text": "بازم تقریبی کنید. اگر که باعث بیقراری شیده شده."
    },
    {
      "id": 63,
      "start": 8319.0,
      "end": 8324.0,
      "formatted_start": "02:18:39.000",
      "formatted_end": "02:18:44.000",
      "text": "خب وقت شاید بقیه به دنیا نت روشیست که تو خردید."
    },
    {
      "id": 64,
      "start": 8324.0,
      "end": 8327.0,
      "formatted_start": "02:18:44.000",
      "formatted_end": "02:18:47.000",
      "text": "باید بیشتر کم بیده."
    },
    {
      "id": 65,
      "start": 8327.0,
      "end": 8331.0,
      "formatted_start": "02:18:47.000",
      "formatted_end": "02:18:51.000",
      "text": "یه جفت ایراد دست دوتره."
    },
    {
      "id": 66,
      "start": 8331.0,
      "end": 8333.0,
      "formatted_start": "02:18:51.000",
      "formatted_end": "02:18:53.000",
      "text": "چند هم چه سی هم؟"
    },
    {
      "id": 67,
      "start": 8333.0,
      "end": 8334.0,
      "formatted_start": "02:18:53.000",
      "formatted_end": "02:18:54.000",
      "text": "سی هم."
    },
    {
      "id": 68,
      "start": 8334.0,
      "end": 8336.0,
      "formatted_start": "02:18:54.000",
      "formatted_end": "02:18:56.000",
      "text": "هفته تو چه ها خوبسته؟"
    },
    {
      "id": 69,
      "start": 8336.0,
      "end": 8338.0,
      "formatted_start": "02:18:56.000",
      "formatted_end": "02:18:58.000",
      "text": "عرشاده سکی."
    },
    {
      "id": 70,
      "start": 8338.0,
      "end": 8339.0,
      "formatted_start": "02:18:58.000",
      "formatted_end": "02:18:59.000",
      "text": "باشه."
    },
    {
      "id": 71,
      "start": 8339.0,
      "end": 8340.0,
      "formatted_start": "02:18:59.000",
      "formatted_end": "02:19:00.000",
      "text": "باشه."
    },
    {
      "id": 72,
      "start": 8340.0,
      "end": 8341.0,
      "formatted_start": "02:19:00.000",
      "formatted_end": "02:19:01.000",
      "text": "باشه."
    },
    {
      "id": 73,
      "start": 8341.0,
      "end": 8346.0,
      "formatted_start": "02:19:01.000",
      "formatted_end": "02:19:06.000",
      "text": "معمولا بچه ها تا 10 روز که باید نبیدیم از 10 روز به بعد نبیدیم"
    },
    {
      "id": 74,
      "start": 8346.0,
      "end": 8347.0,
      "formatted_start": "02:19:06.000",
      "formatted_end": "02:19:07.000",
      "text": "ولی خوب شده"
    },
    {
      "id": 75,
      "start": 8347.0,
      "end": 8349.0,
      "formatted_start": "02:19:07.000",
      "formatted_end": "02:19:09.000",
      "text": "خب"
    },
    {
      "id": 76,
      "start": 8349.0,
      "end": 8353.0,
      "formatted_start": "02:19:09.000",
      "formatted_end": "02:19:13.000",
      "text": "به نظر من یک دردی از پنجه ده نگرم کنم دیگر است"
    },
    {
      "id": 77,
      "start": 8353.0,
      "end": 8358.0,
      "formatted_start": "02:19:13.000",
      "formatted_end": "02:19:18.000",
      "text": "تو فقط چون بچه ها که یک نظر باید کار رو توی تعمیل دانیا آمده"
    },
    {
      "id": 78,
      "start": 8358.0,
      "end": 8361.0,
      "formatted_start": "02:19:18.000",
      "formatted_end": "02:19:21.000",
      "text": "ما تعمیل کار که می کنیم توی دردی روی تول کشیده"
    },
    {
      "id": 79,
      "start": 8361.0,
      "end": 8364.0,
      "formatted_start": "02:19:21.000",
      "formatted_end": "02:19:24.000",
      "text": "آیا یک آزماشه مفروض"
    },
    {
      "id": 80,
      "start": 8364.0,
      "end": 8367.0,
      "formatted_start": "02:19:24.000",
      "formatted_end": "02:19:27.000",
      "text": "یک آزماشه تیروید ببخشید ابرار و یک آزماشه تیروید بگیم"
    },
    {
      "id": 81,
      "start": 8367.0,
      "end": 8373.0,
      "formatted_start": "02:19:27.000",
      "formatted_end": "02:19:33.000",
      "text": "چون یکی از دلائل درده توکش نفر نداره، یکی از دلائلش هم کمکانه تیران"
    },
    {
      "id": 82,
      "start": 8373.0,
      "end": 8376.0,
      "formatted_start": "02:19:33.000",
      "formatted_end": "02:19:36.000",
      "text": "تیرانیش رو دوار گرفته بود"
    },
    {
      "id": 83,
      "start": 8376.0,
      "end": 8382.0,
      "formatted_start": "02:19:36.000",
      "formatted_end": "02:19:42.000",
