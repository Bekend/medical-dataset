  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15302.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:02.000",
      "text": "مامان، مامان، مامان."
    },
    {
      "id": 1,
      "start": 15302.0,
      "end": 15306.0,
      "formatted_start": "04:15:02.000",
      "formatted_end": "04:15:06.000",
      "text": "او باید بردش مثلاً بهتر اگه پونزه باشه سه سال."
    },
    {
      "id": 2,
      "start": 15306.0,
      "end": 15308.0,
      "formatted_start": "04:15:06.000",
      "formatted_end": "04:15:08.000",
      "text": "بعد همه سه سالش رو که نشونی."
    },
    {
      "id": 3,
      "start": 15308.0,
      "end": 15310.0,
      "formatted_start": "04:15:08.000",
      "formatted_end": "04:15:10.000",
      "text": "نمیشه اینکه بردش بشه."
    },
    {
      "id": 4,
      "start": 15310.0,
      "end": 15313.0,
      "formatted_start": "04:15:10.000",
      "formatted_end": "04:15:13.000",
      "text": "آره، بردش بشه بچه ها بیشتر بخواستن. هر وقت اینجور بردش بشه."
    },
    {
      "id": 5,
      "start": 15315.0,
      "end": 15317.0,
      "formatted_start": "04:15:15.000",
      "formatted_end": "04:15:17.000",
      "text": "دهی، محمد."
    },
    {
      "id": 6,
      "start": 15319.0,
      "end": 15321.0,
      "formatted_start": "04:15:19.000",
      "formatted_end": "04:15:21.000",
      "text": "تو خست نست."
    },
    {
      "id": 7,
      "start": 15322.0,
      "end": 15324.0,
      "formatted_start": "04:15:22.000",
      "formatted_end": "04:15:24.000",
      "text": "بگو خانه دکترون نه استی بری؟"
    },
    {
      "id": 8,
      "start": 15324.0,
      "end": 15325.0,
      "formatted_start": "04:15:24.000",
      "formatted_end": "04:15:25.000",
      "text": "نه است."
    },
    {
      "id": 9,
      "start": 15325.0,
      "end": 15327.0,
      "formatted_start": "04:15:25.000",
      "formatted_end": "04:15:27.000",
      "text": "اون بزرگ ما بچه ها هستی؟"
    },
    {
      "id": 10,
      "start": 15327.0,
      "end": 15328.0,
      "formatted_start": "04:15:27.000",
      "formatted_end": "04:15:28.000",
      "text": "نه."
    },
    {
      "id": 11,
      "start": 15328.0,
      "end": 15330.0,
      "formatted_start": "04:15:28.000",
      "formatted_end": "04:15:30.000",
      "text": "بگم بزنون دچا سی"
    },
    {
      "id": 12,
      "start": 15330.0,
      "end": 15332.0,
      "formatted_start": "04:15:30.000",
      "formatted_end": "04:15:32.000",
      "text": "نه ممکن نیست"
    },
    {
      "id": 13,
      "start": 15332.0,
      "end": 15334.0,
      "formatted_start": "04:15:32.000",
      "formatted_end": "04:15:34.000",
      "text": "باید اجتماعی بیرون کنیم"
    },
    {
      "id": 14,
      "start": 15334.0,
      "end": 15338.0,
      "formatted_start": "04:15:34.000",
      "formatted_end": "04:15:38.000",
      "text": "بگیم برای مهم برای شعبت نیوتالین نوشتم"
    },
    {
      "id": 15,
      "start": 15338.0,
      "end": 15340.0,
      "formatted_start": "04:15:38.000",
      "formatted_end": "04:15:40.000",
      "text": "بله"
    },
    {
      "id": 16,
      "start": 15340.0,
      "end": 15344.0,
      "formatted_start": "04:15:40.000",
      "formatted_end": "04:15:44.000",
      "text": "شبیه سلسلسی بهش میدیم اگه روزها هم دیدید خیلی میخواهید"
    },
    {
      "id": 17,
      "start": 15344.0,
      "end": 15347.0,
      "formatted_start": "04:15:44.000",
      "formatted_end": "04:15:47.000",
      "text": "ما نوخواهیم دوست دفعه افتراش بدیم"
    },
    {
      "id": 18,
      "start": 15347.0,
      "end": 15348.0,
      "formatted_start": "04:15:47.000",
      "formatted_end": "04:15:48.000",
      "text": "خب"
    },
    {
      "id": 19,
      "start": 15348.0,
      "end": 15351.0,
      "formatted_start": "04:15:48.000",
      "formatted_end": "04:15:51.000",
      "text": "بعد یه دونم براش اسپره ایبینی نوشتم"
    },
    {
      "id": 20,
      "start": 15351.0,
      "end": 15352.0,
      "formatted_start": "04:15:51.000",
      "formatted_end": "04:15:52.000",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 15352.0,
      "end": 15355.0,
      "formatted_start": "04:15:52.000",
      "formatted_end": "04:15:55.000",
      "text": "صبح و شب یک بافت بزارید داخل"
    },
    {
      "id": 22,
      "start": 15355.0,
      "end": 15356.0,
      "formatted_start": "04:15:55.000",
      "formatted_end": "04:15:56.000",
      "text": "بشیم"
    },
    {
      "id": 23,
      "start": 15356.0,
      "end": 15360.0,
      "formatted_start": "04:15:56.000",
      "formatted_end": "04:16:00.000",
      "text": "تقریتی چی باشه؟"
    },
    {
      "id": 24,
      "start": 15360.0,
      "end": 15362.0,
      "formatted_start": "04:16:00.000",
      "formatted_end": "04:16:02.000",
      "text": "تقریتی بازی نیست"
    },
    {
      "id": 25,
      "start": 15362.0,
      "end": 15364.0,
      "formatted_start": "04:16:02.000",
      "formatted_end": "04:16:04.000",
      "text": "بیتامین دی نیست"
    },
    {
      "id": 26,
      "start": 15364.0,
      "end": 15366.0,
      "formatted_start": "04:16:04.000",
      "formatted_end": "04:16:06.000",
      "text": "بیتامین دی نیست"
    },
    {
      "id": 27,
      "start": 15366.0,
      "end": 15368.0,
      "formatted_start": "04:16:06.000",
      "formatted_end": "04:16:08.000",
      "text": "محمد"
    },
    {
      "id": 28,
      "start": 15368.0,
      "end": 15372.0,
      "formatted_start": "04:16:08.000",
      "formatted_end": "04:16:12.000",
      "text": "یه دنبالش نیست"
    },
    {
      "id": 29,
      "start": 15372.0,
      "end": 15374.0,
      "formatted_start": "04:16:12.000",
      "formatted_end": "04:16:14.000",
      "text": "بیتامین دی"
    },
    {
      "id": 30,
      "start": 15374.0,
      "end": 15376.0,
      "formatted_start": "04:16:14.000",
      "formatted_end": "04:16:16.000",
      "text": "هزار واحد براش نیست"
    },
    {
      "id": 31,
      "start": 15376.0,
