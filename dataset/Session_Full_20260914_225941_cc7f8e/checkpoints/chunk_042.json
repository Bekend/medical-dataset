  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12604.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:04.000",
      "text": "از اینجا، صبح توش هبوبات رو بریزی نمیدهید؟"
    },
    {
      "id": 1,
      "start": 12604.0,
      "end": 12606.0,
      "formatted_start": "03:30:04.000",
      "formatted_end": "03:30:06.000",
      "text": "هبوبات فقط فرام دال عدست دادم."
    },
    {
      "id": 2,
      "start": 12606.0,
      "end": 12608.0,
      "formatted_start": "03:30:06.000",
      "formatted_end": "03:30:08.000",
      "text": "چیزی دیگه بشید؟"
    },
    {
      "id": 3,
      "start": 12608.0,
      "end": 12610.0,
      "formatted_start": "03:30:08.000",
      "formatted_end": "03:30:10.000",
      "text": "عدست بریز توی رزباز، دور یا سکین بریز."
    },
    {
      "id": 4,
      "start": 12610.0,
      "end": 12612.0,
      "formatted_start": "03:30:10.000",
      "formatted_end": "03:30:12.000",
      "text": "میتونم برم."
    },
    {
      "id": 5,
      "start": 12612.0,
      "end": 12614.0,
      "formatted_start": "03:30:12.000",
      "formatted_end": "03:30:14.000",
      "text": "آره، اینا خیلی خوبه."
    },
    {
      "id": 6,
      "start": 12614.0,
      "end": 12618.0,
      "formatted_start": "03:30:14.000",
      "formatted_end": "03:30:18.000",
      "text": "اصلا میتونید عدسی رو روزخونیدش بدید، مثلا قشنگه کنید، آره بهش بدید بخورید."
    },
    {
      "id": 7,
      "start": 12618.0,
      "end": 12620.0,
      "formatted_start": "03:30:18.000",
      "formatted_end": "03:30:20.000",
      "text": "حالا مثلا عدسی، خب خیلی عدسش زیاده."
    },
    {
      "id": 8,
      "start": 12620.0,
      "end": 12622.0,
      "formatted_start": "03:30:20.000",
      "formatted_end": "03:30:22.000",
      "text": "با یه چیزی قادی باشید."
    },
    {
      "id": 9,
      "start": 12622.0,
      "end": 12624.0,
      "formatted_start": "03:30:22.000",
      "formatted_end": "03:30:24.000",
      "text": "سوپ عدل"
    },
    {
      "id": 10,
      "start": 12624.0,
      "end": 12627.44,
      "formatted_start": "03:30:24.000",
      "formatted_end": "03:30:27.440",
      "text": "یا مثلا توی سوپش حتما چیزهای مختلف برین"
    },
    {
      "id": 11,
      "start": 12627.44,
      "end": 12631.44,
      "formatted_start": "03:30:27.440",
      "formatted_end": "03:30:31.440",
      "text": "هر ویژه بروکلی و یه هم دونم اینها رو همه رو توی سوپش برین"
    },
    {
      "id": 12,
      "start": 12631.44,
      "end": 12633.44,
      "formatted_start": "03:30:31.440",
      "formatted_end": "03:30:33.440",
      "text": "کد و حلوه میتونی توی سوپش برین"
    },
    {
      "id": 13,
      "start": 12633.44,
      "end": 12635.44,
      "formatted_start": "03:30:33.440",
      "formatted_end": "03:30:35.440",
      "text": "اینها رو بساش بده"
    },
    {
      "id": 14,
      "start": 12635.44,
      "end": 12637.44,
      "formatted_start": "03:30:35.440",
      "formatted_end": "03:30:37.440",
      "text": "بعد کته تعلقش داری"
    },
    {
      "id": 15,
      "start": 12637.44,
      "end": 12639.44,
      "formatted_start": "03:30:37.440",
      "formatted_end": "03:30:39.440",
      "text": "کته خود برنجو نه"
    },
    {
      "id": 16,
      "start": 12639.44,
      "end": 12641.44,
      "formatted_start": "03:30:39.440",
      "formatted_end": "03:30:41.440",
      "text": "برنجو توی غذاش ریختم"
    },
    {
      "id": 17,
      "start": 12641.44,
      "end": 12643.44,
      "formatted_start": "03:30:41.440",
      "formatted_end": "03:30:43.440",
      "text": "ولی به صورت کته ترون نرود"
    },
    {
      "id": 18,
      "start": 12643.44,
      "end": 12645.44,
      "formatted_start": "03:30:43.440",
      "formatted_end": "03:30:45.440",
      "text": "آره میتونی کته رو بشه"
    },
    {
      "id": 19,
      "start": 12645.44,
      "end": 12647.44,
      "formatted_start": "03:30:45.440",
      "formatted_end": "03:30:47.440",
      "text": "مثلا کته یه روز باشه بیت داست کن"
    },
    {
      "id": 20,
      "start": 12647.44,
      "end": 12649.44,
      "formatted_start": "03:30:47.440",
      "formatted_end": "03:30:49.440",
      "text": "یه روز با عدل بشه"
    },
    {
      "id": 21,
      "start": 12649.44,
      "end": 12651.44,
      "formatted_start": "03:30:49.440",
      "formatted_end": "03:30:51.440",
      "text": "با اینجوری بده بهش"
    },
    {
      "id": 22,
      "start": 12651.44,
      "end": 12652.44,
      "formatted_start": "03:30:51.440",
      "formatted_end": "03:30:52.440",
      "text": "بعد بگه"
    },
    {
      "id": 23,
      "start": 12652.44,
      "end": 12654.44,
      "formatted_start": "03:30:52.440",
      "formatted_end": "03:30:54.440",
      "text": "بچه همون شیربادون چی؟"
    },
    {
      "id": 24,
      "start": 12654.44,
      "end": 12655.44,
      "formatted_start": "03:30:54.440",
      "formatted_end": "03:30:55.440",
      "text": "شیربادون"
    },
    {
      "id": 25,
      "start": 12655.44,
      "end": 12657.44,
      "formatted_start": "03:30:55.440",
      "formatted_end": "03:30:57.440",
      "text": "یعنی درست میکنن کام میتونن بدم"
    },
    {
      "id": 26,
      "start": 12657.44,
      "end": 12658.44,
      "formatted_start": "03:30:57.440",
      "formatted_end": "03:30:58.440",
      "text": "یعنی تو قضاش میرونن"
    },
    {
      "id": 27,
      "start": 12658.44,
      "end": 12659.44,
      "formatted_start": "03:30:58.440",
      "formatted_end": "03:30:59.440",
      "text": "تو فرنیش میرونن"
    },
    {
      "id": 28,
      "start": 12659.44,
      "end": 12660.44,
      "formatted_start": "03:30:59.440",
      "formatted_end": "03:31:00.440",
      "text": "آره"
    },
    {
      "id": 29,
      "start": 12660.44,
      "end": 12662.44,
      "formatted_start": "03:31:00.440",
      "formatted_end": "03:31:02.440",
      "text": "نه ای که سنگینه"
    },
    {
      "id": 30,
      "start": 12662.44,
      "end": 12664.44,
      "formatted_start": "03:31:02.440",
      "formatted_end": "03:31:04.440",
      "text": "یه برای سنگینه حضرتش برده"
    },
    {
      "id": 31,
      "start": 12664.44,
      "end": 12666.44,
      "formatted_start": "03:31:04.440",
      "formatted_end": "03:31:06.440",
      "text": "اینم گوبالشش مشکل داره بگه"
    },
    {
      "id": 32,
      "start": 12666.44,
      "end": 12667.44,
      "formatted_start": "03:31:06.440",
      "formatted_end": "03:31:07.440",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 12667.44,
      "end": 12668.44,
      "formatted_start": "03:31:07.440",
      "formatted_end": "03:31:08.440",
      "text": "برنامه"
    },
    {
      "id": 34,
      "start": 12668.44,
      "end": 12669.44,
      "formatted_start": "03:31:08.440",
      "formatted_end": "03:31:09.440",
      "text": "اوش"
    },
    {
      "id": 35,
      "start": 12669.44,
      "end": 12671.44,
      "formatted_start": "03:31:09.440",
      "formatted_end": "03:31:11.440",
      "text": "یعنی دو روز چنان افخالی بود"
    },
    {
      "id": 36,
      "start": 12671.44,
      "end": 12673.44,
      "formatted_start": "03:31:11.440",
      "formatted_end": "03:31:13.440",
      "text": "پدر من در همه افخشکشو اول بی کردم"
    },
    {
      "id": 37,
      "start": 12673.44,
      "end": 12675.44,
      "formatted_start": "03:31:13.440",
      "formatted_end": "03:31:15.440",
      "text": "بعدیو میبتن دوباره"
    },
    {
      "id": 38,
      "start": 12675.44,
      "end": 12679.84,
      "formatted_start": "03:31:15.440",
      "formatted_end": "03:31:19.840",
      "text": "یک بار شما در این وقت باید بیرون رو بیداشت"
    },
    {
      "id": 39,
      "start": 12679.84,
      "end": 12680.96,
      "formatted_start": "03:31:19.840",
      "formatted_end": "03:31:20.960",
      "text": "اصلا آب شد"
    },
    {
      "id": 40,
      "start": 12680.96,
      "end": 12682.68,
      "formatted_start": "03:31:20.960",
      "formatted_end": "03:31:22.680",
      "text": "بعد چیزی هم نمیخورد"
    },
    {
      "id": 41,
      "start": 12682.68,
      "end": 12685.8,
      "formatted_start": "03:31:22.680",
      "formatted_end": "03:31:25.800",
      "text": "درمیدرد لست درم اون لست درم هم داره لست های بالاش"
    },
    {
      "id": 42,
      "start": 12685.8,
      "end": 12688.68,
      "formatted_start": "03:31:25.800",
      "formatted_end": "03:31:28.680",
      "text": "باید پسونک هم میکارد"
    },
    {
      "id": 43,
      "start": 12688.68,
      "end": 12690.76,
      "formatted_start": "03:31:28.680",
      "formatted_end": "03:31:30.760",
      "text": "اصلا پسونک نباشه هم درمیدارد"
    },
    {
      "id": 44,
      "start": 12690.76,
      "end": 12695.16,
      "formatted_start": "03:31:30.760",
      "formatted_end": "03:31:35.160",
      "text": "ببین یکی از علایه که شیر رو نمیخورد به خاطر اون پسونک هست"
    },
    {
      "id": 45,
      "start": 12695.16,
      "end": 12697.96,
      "formatted_start": "03:31:35.160",
      "formatted_end": "03:31:37.960",
      "text": "ببین هستمکیدنش با اون ارزا میشه"
    },
    {
      "id": 46,
      "start": 12697.96,
      "end": 12698.88,
      "formatted_start": "03:31:37.960",
      "formatted_end": "03:31:38.880",
      "text": "آه"
    },
    {
      "id": 47,
      "start": 12698.88,
      "end": 12703.18,
      "formatted_start": "03:31:38.880",
      "formatted_end": "03:31:43.180",
      "text": "باقی چیز هم که خودشو سیر میکنه دیگه، لزومی نداره که شیر بپرد"
    },
    {
      "id": 48,
      "start": 12703.18,
      "end": 12708.12,
      "formatted_start": "03:31:43.180",
      "formatted_end": "03:31:48.120",
      "text": "چون موقع خوب نباشه نه، دوباره شیر میکرد موقع خب بشه"
    },
    {
      "id": 49,
      "start": 12708.12,
      "end": 12710.88,
      "formatted_start": "03:31:48.120",
      "formatted_end": "03:31:50.880",
      "text": "شیر پردندش بهتر بشه"
    },
    {
      "id": 50,
      "start": 12710.88,
      "end": 12715.34,
      "formatted_start": "03:31:50.880",
      "formatted_end": "03:31:55.340",
      "text": "وقتی که داری بهش شیر میدی، حواسشو به یه چیز دیگه پرد کنی"
    },
    {
      "id": 51,
      "start": 12715.34,
      "end": 12720.08,
      "formatted_start": "03:31:55.340",
      "formatted_end": "03:32:00.080",
      "text": "ببینی، این بچه ها چون بازی بوشن، دوست دارن همه شیر برورد بخواهد"
    },
    {
      "id": 52,
      "start": 12720.08,
      "end": 12724.24,
      "formatted_start": "03:32:00.080",
      "formatted_end": "03:32:04.240",
      "text": "حسله اینکه بخواهند بخواهند بخواهند توی خواب بیشتر شد میخواهند"
    },
    {
      "id": 53,
      "start": 12724.24,
      "end": 12726.24,
      "formatted_start": "03:32:04.240",
      "formatted_end": "03:32:06.240",
      "text": "چون چشم بسند"
    },
    {
      "id": 54,
      "start": 12726.24,
      "end": 12730.08,
      "formatted_start": "03:32:06.240",
      "formatted_end": "03:32:10.080",
      "text": "مثلا براش مثلا یه چیزی بفرد"
    },
    {
      "id": 55,
      "start": 12730.08,
      "end": 12732.08,
      "formatted_start": "03:32:10.080",
      "formatted_end": "03:32:12.080",
      "text": "آهنگ که میذارند"
    },
    {
      "id": 56,
      "start": 12732.08,
      "end": 12734.08,
      "formatted_start": "03:32:12.080",
      "formatted_end": "03:32:14.080",
      "text": "با ریتم آهنگ گوش میده"
    },
    {
      "id": 57,
      "start": 12734.08,
      "end": 12737.08,
      "formatted_start": "03:32:14.080",
      "formatted_end": "03:32:17.080",
      "text": "دلت میکنه و شیرشو بهکرم میکنه"
    },
    {
      "id": 58,
      "start": 12737.08,
      "end": 12739.08,
      "formatted_start": "03:32:17.080",
      "formatted_end": "03:32:19.080",
      "text": "یا مثلا میگم"
    },
    {
      "id": 59,
      "start": 12739.08,
      "end": 12741.08,
      "formatted_start": "03:32:19.080",
      "formatted_end": "03:32:21.080",
      "text": "مثلا توی کتاب های نوشته ایدی ما نوشته که مثلا"
    },
    {
      "id": 60,
      "start": 12741.08,
      "end": 12743.08,
      "formatted_start": "03:32:21.080",
      "formatted_end": "03:32:23.080",
      "text": "گردن بردار گردن تون کنید"
    },
    {
      "id": 61,
      "start": 12743.08,
      "end": 12745.08,
      "formatted_start": "03:32:23.080",
      "formatted_end": "03:32:25.080",
      "text": "که مثلا خیلی جلب توجه کنه"
    },
    {
      "id": 62,
      "start": 12745.08,
      "end": 12747.08,
      "formatted_start": "03:32:25.080",
      "formatted_end": "03:32:27.080",
      "text": "رنگی رنگی باشه"
    },
    {
      "id": 63,
      "start": 12747.08,
      "end": 12751.38,
      "formatted_start": "03:32:27.080",
      "formatted_end": "03:32:31.380",
      "text": "بچه اصلا با همین که داره واضی میکنه یا نگاش میکنه شیر بهش بده"
    },
    {
      "id": 64,
      "start": 12751.38,
      "end": 12756.08,
      "formatted_start": "03:32:31.380",
      "formatted_end": "03:32:36.080",
      "text": "خب این بیشتر به خاطر واضی بوشیشه به خاطر این همه اش دوست داره این مرمان میداد"
    },
    {
      "id": 65,
      "start": 12756.08,
      "end": 12757.08,
      "formatted_start": "03:32:36.080",
      "formatted_end": "03:32:37.080",
      "text": "بچه ای"
    },
    {
      "id": 66,
      "start": 12757.08,
      "end": 12757.28,
      "formatted_start": "03:32:37.080",
      "formatted_end": "03:32:37.280",
      "text": "بچه ای"
    },
    {
      "id": 67,
      "start": 12757.28,
      "end": 12761.68,
      "formatted_start": "03:32:37.280",
      "formatted_end": "03:32:41.680",
      "text": "همه از کار از که گاه بدایی میذارن به زور مثلا سی تا یک شریفتا بهش میدن"
    },
    {
      "id": 68,
      "start": 12761.68,
      "end": 12764.28,
      "formatted_start": "03:32:41.680",
      "formatted_end": "03:32:44.280",
      "text": "و از خود بازی قضا همینجوری بهش میدن"
    },
    {
      "id": 69,
      "start": 12764.28,
      "end": 12766.78,
      "formatted_start": "03:32:44.280",
      "formatted_end": "03:32:46.780",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 12766.78,
      "end": 12769.34,
      "formatted_start": "03:32:46.780",
      "formatted_end": "03:32:49.340",
      "text": "چون همه اش دوست داره با یه چیزی بازی کنه"
    },
    {
      "id": 71,
      "start": 12769.34,
      "end": 12772.98,
      "formatted_start": "03:32:49.340",
      "formatted_end": "03:32:52.980",
      "text": "اصلا این که خواهد به خوابه بهشی رو بیدی اصلا دوست نداره"
    },
    {
      "id": 72,
      "start": 12772.98,
      "end": 12775.22,
      "formatted_start": "03:32:52.980",
      "formatted_end": "03:32:55.220",
      "text": "بعد خوبم خودش با خودش بازه می کنه"
    },
    {
      "id": 73,
      "start": 12775.22,
      "end": 12778.48,
      "formatted_start": "03:32:55.220",
      "formatted_end": "03:32:58.480",
      "text": "بعد صبح نمی زنم نیم ست، نیم ست اصلا بازه شروعش خودش بازه کنه"
    },
    {
      "id": 74,
      "start": 12778.48,
      "end": 12779.06,
      "formatted_start": "03:32:58.480",
      "formatted_end": "03:32:59.060",
      "text": "چه داره؟"
    },
    {
      "id": 75,
      "start": 12779.06,
      "end": 12780.7,
      "formatted_start": "03:32:59.060",
      "formatted_end": "03:33:00.700",
      "text": "از دل دل هست"
    },
    {
      "id": 76,
      "start": 12780.7,
      "end": 12782.6,
      "formatted_start": "03:33:00.700",
      "formatted_end": "03:33:02.600",
      "text": "از عرضش هم باید باشم"
    },
    {
      "id": 77,
      "start": 12782.6,
      "end": 12783.6,
      "formatted_start": "03:33:02.600",
      "formatted_end": "03:33:03.600",
      "text": "باید باشم"
    },
    {
      "id": 78,
      "start": 12783.6,
      "end": 12785.6,
      "formatted_start": "03:33:03.600",
      "formatted_end": "03:33:05.600",
      "text": "باید باشم"
    },
    {
      "id": 79,
      "start": 12785.6,
      "end": 12790.6,
      "formatted_start": "03:33:05.600",
      "formatted_end": "03:33:10.600",
      "text": "باید باشم"
    },
    {
      "id": 80,
      "start": 12790.6,
      "end": 12791.3,
      "formatted_start": "03:33:10.600",
      "formatted_end": "03:33:11.300",
      "text": "باید باشم"
    },
    {
      "id": 81,
      "start": 12791.3,
      "end": 12791.76,
      "formatted_start": "03:33:11.300",
      "formatted_end": "03:33:11.760",
      "text": "باید باشم"
    },
    {
      "id": 82,
      "start": 12791.76,
      "end": 12794.48,
      "formatted_start": "03:33:11.760",
      "formatted_end": "03:33:14.480",
      "text": "باید باشم"
    },
    {
      "id": 83,
      "start": 12794.48,
      "end": 12796.48,
      "formatted_start": "03:33:14.480",
      "formatted_end": "03:33:16.480",
      "text": "خوبه باشه"
    },
    {
      "id": 84,
      "start": 12797.48,
      "end": 12799.48,
      "formatted_start": "03:33:17.480",
      "formatted_end": "03:33:19.480",
      "text": "اینجا چیش پستاده؟"
    },
    {
      "id": 85,
      "start": 12799.48,
      "end": 12800.48,
      "formatted_start": "03:33:19.480",
      "formatted_end": "03:33:20.480",
      "text": "نه"
    },
    {
      "id": 86,
      "start": 12800.48,
      "end": 12802.48,
      "formatted_start": "03:33:20.480",
      "formatted_end": "03:33:22.480",
      "text": "خوبه باشه"
    },
    {
      "id": 87,
      "start": 12802.48,
      "end": 12804.48,
      "formatted_start": "03:33:22.480",
      "formatted_end": "03:33:24.480",
      "text": "نه داره بخواب بشین"
    },
    {
      "id": 88,
      "start": 12807.48,
      "end": 12808.48,
      "formatted_start": "03:33:27.480",
      "formatted_end": "03:33:28.480",
      "text": "بچه بچه بچه"
    },
    {
      "id": 89,
      "start": 12808.48,
      "end": 12810.48,
      "formatted_start": "03:33:28.480",
      "formatted_end": "03:33:30.480",
      "text": "چیز کنه؟ بچه بچه بچه"
    },
    {
      "id": 90,
      "start": 12810.48,
      "end": 12811.48,
      "formatted_start": "03:33:30.480",
      "formatted_end": "03:33:31.480",
      "text": "سردی برجه؟"
    },
    {
      "id": 91,
      "start": 12811.48,
      "end": 12812.48,
      "formatted_start": "03:33:31.480",
      "formatted_end": "03:33:32.480",
      "text": "سردی برجه"
    },
    {
      "id": 92,
