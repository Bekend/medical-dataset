  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12914.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:14.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12930.0,
      "end": 12938.0,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:38.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 12960.0,
      "end": 12980.0,
      "formatted_start": "03:36:00.000",
      "formatted_end": "03:36:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 12990.0,
      "end": 12999.0,
      "formatted_start": "03:36:30.000",
      "formatted_end": "03:36:39.000",
      "text": "اما چی شده؟ درگوان حرف میکنه. چی شده مکان؟ خوبی؟"
    },
    {
      "id": 4,
      "start": 12999.0,
      "end": 13002.0,
      "formatted_start": "03:36:39.000",
      "formatted_end": "03:36:42.000",
      "text": "پشت همین دور خوابید از خواب که بلند شد تب کرده."
    },
    {
      "id": 5,
      "start": 13002.0,
      "end": 13004.0,
      "formatted_start": "03:36:42.000",
      "formatted_end": "03:36:44.000",
      "text": "حد سی و هشت و دو اینها بودن."
    },
    {
      "id": 6,
      "start": 13004.0,
      "end": 13006.0,
      "formatted_start": "03:36:44.000",
      "formatted_end": "03:36:46.000",
      "text": "از این گویش قطعه دادم. اینو همه نیمیدم."
    },
    {
      "id": 7,
      "start": 13006.0,
      "end": 13008.0,
      "formatted_start": "03:36:46.000",
      "formatted_end": "03:36:48.000",
      "text": "چرا پاتر دندانش بود چون همه یه دیگه نداشت."
    },
    {
      "id": 8,
      "start": 13008.0,
      "end": 13009.0,
      "formatted_start": "03:36:48.000",
      "formatted_end": "03:36:49.000",
      "text": "تا؟"
    },
    {
      "id": 9,
      "start": 13009.0,
      "end": 13011.0,
      "formatted_start": "03:36:49.000",
      "formatted_end": "03:36:51.000",
      "text": "همه چی سالته هیچی نداشت."
    },
    {
      "id": 10,
      "start": 13011.0,
      "end": 13014.0,
      "formatted_start": "03:36:51.000",
      "formatted_end": "03:36:54.000",
      "text": "یک شمه اینها خودشو از پریش شب رو اومد دور چشمش نداره."
    },
    {
      "id": 11,
      "start": 13014.0,
      "end": 13020.3,
      "formatted_start": "03:36:54.000",
      "formatted_end": "03:37:00.300",
      "text": "اینجور چشم ها از ابرواشین ها قرمز بود و دیروز هم دیگه بردنش فقط بالاتر نه"
    },
    {
      "id": 12,
      "start": 13020.3,
      "end": 13020.8,
      "formatted_start": "03:37:00.300",
      "formatted_end": "03:37:00.800",
      "text": "اها"
    },
    {
      "id": 13,
      "start": 13020.8,
      "end": 13021.8,
      "formatted_start": "03:37:00.800",
      "formatted_end": "03:37:01.800",
      "text": "اونجوری"
    },
    {
      "id": 14,
      "start": 13021.8,
      "end": 13022.86,
      "formatted_start": "03:37:01.800",
      "formatted_end": "03:37:02.860",
      "text": "خوشتشو"
    },
    {
      "id": 15,
      "start": 13022.86,
      "end": 13025.0,
      "formatted_start": "03:37:02.860",
      "formatted_end": "03:37:05.000",
      "text": "خب تبش فقط یه روز بود؟"
    },
    {
      "id": 16,
      "start": 13025.0,
      "end": 13025.8,
      "formatted_start": "03:37:05.000",
      "formatted_end": "03:37:05.800",
      "text": "نه دو سه روز تبشید"
    },
    {
      "id": 17,
      "start": 13025.8,
      "end": 13027.42,
      "formatted_start": "03:37:05.800",
      "formatted_end": "03:37:07.420",
      "text": "دو سه روز تبشید دیگه آره"
    },
    {
      "id": 18,
      "start": 13027.42,
      "end": 13030.68,
      "formatted_start": "03:37:07.420",
      "formatted_end": "03:37:10.680",
      "text": "ببین این یه ویروسیه به نام روزه اولا"
    },
    {
      "id": 19,
      "start": 13030.68,
      "end": 13034.68,
      "formatted_start": "03:37:10.680",
      "formatted_end": "03:37:14.680",
      "text": "روزه اولا یه ویروسیه که دو سه روز تب بیده"
    },
    {
      "id": 20,
      "start": 13034.68,
      "end": 13038.04,
      "formatted_start": "03:37:14.680",
      "formatted_end": "03:37:18.040",
      "text": "هیچ علامتی ندارن فقط یه ذره بیقرارن"
    },
    {
      "id": 21,
      "start": 13038.04,
      "end": 13042.34,
      "formatted_start": "03:37:18.040",
      "formatted_end": "03:37:22.340",
      "text": "بعدش طبشون قط میشه دونه میریز و میرون خوب شد"
    },
    {
      "id": 22,
      "start": 13042.34,
      "end": 13048.04,
      "formatted_start": "03:37:22.340",
      "formatted_end": "03:37:28.040",
      "text": "یعنی در واقع مرحله آخر ویروس روزهالا همیشکیه"
    },
    {
      "id": 23,
      "start": 13048.04,
      "end": 13052.34,
      "formatted_start": "03:37:28.040",
      "formatted_end": "03:37:32.340",
      "text": "دونه های رسطورتشون و رو تنشون و دست و پاهاشون خیلی کم فراموشن"
    },
    {
      "id": 24,
      "start": 13052.34,
      "end": 13053.34,
      "formatted_start": "03:37:32.340",
      "formatted_end": "03:37:33.340",
      "text": "آره، پس پس میشون"
    },
    {
      "id": 25,
      "start": 13053.34,
      "end": 13054.34,
      "formatted_start": "03:37:33.340",
      "formatted_end": "03:37:34.340",
      "text": "توی روزهالا"
    },
    {
      "id": 26,
      "start": 13054.34,
      "end": 13056.34,
      "formatted_start": "03:37:34.340",
      "formatted_end": "03:37:36.340",
      "text": "ممنون شد؟"
    },
    {
      "id": 27,
      "start": 13056.34,
      "end": 13061.34,
      "formatted_start": "03:37:36.340",
      "formatted_end": "03:37:41.340",
      "text": "معمولا روزهالا نه، روزهالا تو بچه های زیر دو سال اتفاق میفته"
    },
    {
      "id": 28,
      "start": 13061.34,
      "end": 13063.34,
      "formatted_start": "03:37:41.340",
      "formatted_end": "03:37:43.340",
      "text": "فردش هم الانه"
    },
    {
      "id": 29,
      "start": 13063.34,
      "end": 13068.06,
      "formatted_start": "03:37:43.340",
      "formatted_end": "03:37:48.060",
      "text": "یکی تو شهری برد، یکی هم تو اسفند و فر بردین روزه‌الله زیاده"
    },
    {
      "id": 30,
      "start": 13068.06,
      "end": 13071.22,
      "formatted_start": "03:37:48.060",
      "formatted_end": "03:37:51.220",
      "text": "ممکنه یه نفر چند بارم روزه‌الله بگیره"
    },
    {
      "id": 31,
      "start": 13071.22,
      "end": 13077.86,
      "formatted_start": "03:37:51.220",
      "formatted_end": "03:37:57.860",
      "text": "مثلا اگر بچه‌هاد یه بار دیگه اینجوری شد، تب کرد، بعدش دونه ریخ بیرون، مگه یه بار گرفتی چرا دونه ریخ بیرون"
    },
    {
      "id": 32,
      "start": 13077.86,
      "end": 13083.74,
      "formatted_start": "03:37:57.860",
      "formatted_end": "03:38:03.740",
      "text": "چون روزه‌الله تبسط دو نوع ویروس هست، هم خواهیب شیش داره، هم هست"
    },
    {
      "id": 33,
      "start": 13083.74,
      "end": 13084.74,
      "formatted_start": "03:38:03.740",
      "formatted_end": "03:38:04.740",
      "text": "خواهیب شیش داره، هم هست"
    },
    {
      "id": 34,
      "start": 13084.74,
      "end": 13090.84,
      "formatted_start": "03:38:04.740",
      "formatted_end": "03:38:10.840",
      "text": "جان"
    },
    {
      "id": 35,
      "start": 13090.84,
      "end": 13092.62,
      "formatted_start": "03:38:10.840",
      "formatted_end": "03:38:12.620",
      "text": "جانا"
    },
    {
      "id": 36,
      "start": 13092.62,
      "end": 13097.84,
      "formatted_start": "03:38:12.620",
      "formatted_end": "03:38:17.840",
      "text": "چی شده"
    },
    {
      "id": 37,
      "start": 13097.84,
      "end": 13103.0,
      "formatted_start": "03:38:17.840",
      "formatted_end": "03:38:23.000",
      "text": "گوشتا ببینیم"
    },
    {
      "id": 38,
      "start": 13103.0,
      "end": 13103.92,
      "formatted_start": "03:38:23.000",
      "formatted_end": "03:38:23.920",
      "text": "اینو دیدی"
    },
    {
      "id": 39,
      "start": 13103.92,
      "end": 13106.1,
      "formatted_start": "03:38:23.920",
      "formatted_end": "03:38:26.100",
      "text": "دیدی"
    },
    {
      "id": 40,
      "start": 13106.1,
      "end": 13108.02,
      "formatted_start": "03:38:26.100",
      "formatted_end": "03:38:28.020",
      "text": "گوشتا ببینیم"
    },
    {
      "id": 41,
      "start": 13108.02,
      "end": 13110.42,
      "formatted_start": "03:38:28.020",
      "formatted_end": "03:38:30.420",
      "text": "این گوشتا ببینیم"
    },
    {
      "id": 42,
      "start": 13110.42,
      "end": 13111.1,
      "formatted_start": "03:38:30.420",
      "formatted_end": "03:38:31.100",
      "text": "خب"
    },
    {
      "id": 43,
      "start": 13111.1,
      "end": 13113.02,
      "formatted_start": "03:38:31.100",
      "formatted_end": "03:38:33.020",
      "text": "پرده میذاریم اینجا"
    },
    {
      "id": 44,
      "start": 13113.02,
      "end": 13115.9,
      "formatted_start": "03:38:33.020",
      "formatted_end": "03:38:35.900",
      "text": "گوش شامل رو میبینیم ما کن"
    },
    {
      "id": 45,
      "start": 13115.9,
      "end": 13117.02,
      "formatted_start": "03:38:35.900",
      "formatted_end": "03:38:37.020",
      "text": "تمام"
    },
    {
      "id": 46,
      "start": 13117.02,
      "end": 13118.32,
      "formatted_start": "03:38:37.020",
      "formatted_end": "03:38:38.320",
      "text": "این گوشت رو ببینم"
    },
    {
      "id": 47,
      "start": 13118.32,
      "end": 13118.88,
      "formatted_start": "03:38:38.320",
      "formatted_end": "03:38:38.880",
      "text": "ببینم"
    },
    {
      "id": 48,
      "start": 13118.88,
      "end": 13119.54,
      "formatted_start": "03:38:38.880",
      "formatted_end": "03:38:39.540",
      "text": "ببین"
    },
    {
      "id": 49,
      "start": 13119.54,
      "end": 13121.86,
      "formatted_start": "03:38:39.540",
      "formatted_end": "03:38:41.860",
      "text": "آفره"
    },
    {
      "id": 50,
      "start": 13121.86,
      "end": 13124.66,
      "formatted_start": "03:38:41.860",
      "formatted_end": "03:38:44.660",
      "text": "آفره"
    },
    {
      "id": 51,
      "start": 13124.66,
      "end": 13126.92,
      "formatted_start": "03:38:44.660",
      "formatted_end": "03:38:46.920",
      "text": "تو دهنتا ببینیم"
    },
    {
      "id": 52,
      "start": 13126.92,
      "end": 13134.46,
      "formatted_start": "03:38:46.920",
      "formatted_end": "03:38:54.460",
      "text": "آفره"
    },
    {
      "id": 53,
      "start": 13134.46,
      "end": 13136.22,
      "formatted_start": "03:38:54.460",
      "formatted_end": "03:38:56.220",
      "text": "باید کلنا ما کن"
    },
    {
      "id": 54,
      "start": 13136.22,
      "end": 13137.02,
      "formatted_start": "03:38:56.220",
      "formatted_end": "03:38:57.020",
      "text": "آفره"
    },
    {
      "id": 55,
      "start": 13137.02,
      "end": 13138.32,
      "formatted_start": "03:38:57.020",
      "formatted_end": "03:38:58.320",
      "text": "خب یه برداشت خود"
    },
    {
      "id": 56,
      "start": 13138.32,
      "end": 13140.72,
      "formatted_start": "03:38:58.320",
      "formatted_end": "03:39:00.720",
      "text": "که جشن کنن نداشت"
    },
    {
      "id": 57,
      "start": 13140.72,
      "end": 13142.72,
      "formatted_start": "03:39:00.720",
      "formatted_end": "03:39:02.720",
      "text": "موسیقی"
    },
    {
      "id": 58,
      "start": 13170.72,
      "end": 13172.72,
      "formatted_start": "03:39:30.720",
      "formatted_end": "03:39:32.720",
      "text": "اوشالا خوبه نگران نماشه"
    },
    {
      "id": 59,
      "start": 13172.72,
      "end": 13174.72,
      "formatted_start": "03:39:32.720",
      "formatted_end": "03:39:34.720",
      "text": "ببین داروی که تا بعد برات می‌گیسم"
    },
    {
      "id": 60,
      "start": 13174.72,
      "end": 13176.72,
      "formatted_start": "03:39:34.720",
      "formatted_end": "03:39:36.720",
      "text": "یه شربت رو دو شب بشه"
    },
    {
      "id": 61,
      "start": 13176.72,
      "end": 13178.72,
      "formatted_start": "03:39:36.720",
      "formatted_end": "03:39:38.720",
      "text": "بده دونه‌هاش خوب می‌شه"
    },
    {
      "id": 62,
      "start": 13178.72,
      "end": 13180.72,
      "formatted_start": "03:39:38.720",
      "formatted_end": "03:39:40.720",
      "text": "اگه ندیم خوب می‌شه؟"
    },
    {
      "id": 63,
      "start": 13180.72,
      "end": 13182.72,
      "formatted_start": "03:39:40.720",
      "formatted_end": "03:39:42.720",
      "text": "اگه ندیم نمی‌شه"
    },
    {
      "id": 64,
      "start": 13182.72,
      "end": 13184.72,
      "formatted_start": "03:39:42.720",
      "formatted_end": "03:39:44.720",
      "text": "ندیم بره که شیمیه"
    },
    {
      "id": 65,
      "start": 13184.72,
      "end": 13186.72,
      "formatted_start": "03:39:44.720",
      "formatted_end": "03:39:46.720",
      "text": "ندیم می‌شه"
    },
    {
      "id": 66,
      "start": 13186.72,
      "end": 13188.72,
      "formatted_start": "03:39:46.720",
      "formatted_end": "03:39:48.720",
      "text": "کنارش مثلا دوشانده"
    },
    {
      "id": 67,
      "start": 13188.72,
      "end": 13190.72,
      "formatted_start": "03:39:48.720",
      "formatted_end": "03:39:50.720",
      "text": "یه چیزی که بیدی"
    },
    {
      "id": 68,
      "start": 13190.72,
      "end": 13192.72,
      "formatted_start": "03:39:50.720",
      "formatted_end": "03:39:52.720",
      "text": "نه دوشانده اینو ندی"
    },
    {
      "id": 69,
      "start": 13192.72,
      "end": 13194.72,
      "formatted_start": "03:39:52.720",
      "formatted_end": "03:39:54.720",
      "text": "بعد باز دوباره ممکنه که یه حد بازی"
    },
    {
      "id": 70,
      "start": 13194.72,
      "end": 13196.72,
      "formatted_start": "03:39:54.720",
      "formatted_end": "03:39:56.720",
      "text": "نفهمینیم به خاطر اینه"
    },
    {
      "id": 71,
      "start": 13196.72,
      "end": 13200.0,
      "formatted_start": "03:39:56.720",
      "formatted_end": "03:40:00.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    }
  ],
  "status": "completed"
}