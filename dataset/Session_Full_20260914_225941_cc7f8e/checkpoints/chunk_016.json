      "start": 5015.76,
      "end": 5017.76,
      "formatted_start": "01:23:35.760",
      "formatted_end": "01:23:37.760",
      "text": "باید درست خداحافظ بشین"
    },
    {
      "id": 43,
      "start": 5017.76,
      "end": 5019.76,
      "formatted_start": "01:23:37.760",
      "formatted_end": "01:23:39.760",
