    },
    {
      "id": 17,
      "start": 4946.0,
      "end": 4948.0,
      "formatted_start": "01:22:26.000",
      "formatted_end": "01:22:28.000",
      "text": "اوضاع شما چند رو برم؟"
    },
    {
      "id": 18,
      "start": 4948.0,
      "end": 4953.0,
      "formatted_start": "01:22:28.000",
      "formatted_end": "01:22:33.000",
      "text": "مخصوصات اون هستش هم ای ای خواست هم اشعا هست هم ای آر هست هم ترومیتادا هستش"
    },
    {
      "id": 19,
      "start": 4953.0,
      "end": 4956.0,
      "formatted_start": "01:22:33.000",
      "formatted_end": "01:22:36.000",
      "text": "آره نه بسیار موضوع دارن"
    },
    {
      "id": 20,
      "start": 4956.0,
      "end": 4961.0,
      "formatted_start": "01:22:36.000",
      "formatted_end": "01:22:41.000",
      "text": "آره خوگی و تاتار موجود دارن آره تروم هم برای مادر هم موجود هست"
    },
    {
      "id": 21,
      "start": 4961.0,
      "end": 4964.0,
      "formatted_start": "01:22:41.000",
      "formatted_end": "01:22:44.000",
      "text": "آره مخصوصات اون هستش کامل"
    },
    {
      "id": 22,
      "start": 4964.0,
      "end": 4967.0,
      "formatted_start": "01:22:44.000",
      "formatted_end": "01:22:47.000",
      "text": "خانده که فیدبک ها خوب بوده مولی نبوده"
    },
    {
      "id": 23,
      "start": 4967.0,
      "end": 4970.0,
      "formatted_start": "01:22:47.000",
      "formatted_end": "01:22:50.000",
      "text": "شیرخوش که بچه هم میخورند دیگه شیرخوش که دیگه ای رو نیخورند"
    },
    {
      "id": 24,
      "start": 4970.0,
      "end": 4975.0,
      "formatted_start": "01:22:50.000",
      "formatted_end": "01:22:55.000",
      "text": "بعدیش اینه دیگه وقتی نباشه بعد این همه چیز رو بشه"
    },
    {
      "id": 25,
      "start": 4975.0,
      "end": 4976.0,
      "formatted_start": "01:22:55.000",
      "formatted_end": "01:22:56.000",
      "text": "اون شروعات مشکل داشت"
    },
    {
      "id": 26,
      "start": 4976.0,
      "end": 4977.0,
      "formatted_start": "01:22:56.000",
      "formatted_end": "01:22:57.000",
      "text": "خدا را شروع کنم"
    },
    {
      "id": 27,
      "start": 4977.0,
      "end": 4980.0,
      "formatted_start": "01:22:57.000",
      "formatted_end": "01:23:00.000",
      "text": "در این حال هستش الان رگولاران که کامالیه کورده وسته ده"
    },
    {
      "id": 28,
      "start": 4980.0,
      "end": 4983.0,
      "formatted_start": "01:23:00.000",
      "formatted_end": "01:23:03.000",
      "text": "و ای آرمون هم که اینها زیاد تولید شده"
    },
    {
      "id": 29,
      "start": 4983.0,
      "end": 4987.0,
      "formatted_start": "01:23:03.000",
      "formatted_end": "01:23:07.000",
      "text": "یک کمی اچ آل ا فران یک کمی دار و خون ها هست دار"
    },
    {
      "id": 30,
      "start": 4987.0,
      "end": 4989.0,
      "formatted_start": "01:23:07.000",
      "formatted_end": "01:23:09.000",
      "text": "این این حال این ای آرمون هم نباشه"
    },
    {
      "id": 31,
      "start": 4989.0,
      "end": 4991.0,
      "formatted_start": "01:23:09.000",
      "formatted_end": "01:23:11.000",
      "text": "ولی الان زیاد تولید کرده"
    },
    {
      "id": 32,
      "start": 4991.0,
      "end": 4992.0,
      "formatted_start": "01:23:11.000",
      "formatted_end": "01:23:12.000",
      "text": "ای آرمون هستش مشکل نیستش"
    },
    {
      "id": 33,
      "start": 4992.0,
      "end": 4996.64,
      "formatted_start": "01:23:12.000",
      "formatted_end": "01:23:16.640",
      "text": "نیستش ترماه کنم که اون مقدار زیاد مهمده دیدی که اون نهاییه وقت مورد بی بودش"
    },
    {
      "id": 34,
      "start": 4996.64,
      "end": 4998.56,
      "formatted_start": "01:23:16.640",
      "formatted_end": "01:23:18.560",
      "text": "دستاتون درد نکنه باشه اکن"
    },
    {
      "id": 35,
      "start": 4998.56,
      "end": 5000.56,
      "formatted_start": "01:23:18.560",
      "formatted_end": "01:23:20.560",
      "text": "بسیار خوب دارید بسه وقتی کنید"
    },
    {
      "id": 36,
      "start": 5000.56,
      "end": 5003.56,
      "formatted_start": "01:23:20.560",
      "formatted_end": "01:23:23.560",
      "text": "مرکز تبیه رو بسیار دیدید"
    },
    {
      "id": 37,
      "start": 5003.56,
      "end": 5007.76,
      "formatted_start": "01:23:23.560",
      "formatted_end": "01:23:27.760",
      "text": "ببینیم که به عنوان جور میشه یعنی اول دوست دارم برم"
    },
    {
      "id": 38,
      "start": 5007.76,
      "end": 5009.76,
      "formatted_start": "01:23:27.760",
      "formatted_end": "01:23:29.760",
      "text": "هستیم؟"
    },
    {
      "id": 39,
      "start": 5009.76,
      "end": 5011.76,
      "formatted_start": "01:23:29.760",
      "formatted_end": "01:23:31.760",
      "text": "من که میستم باید بکشم"
    },
    {
      "id": 40,
      "start": 5011.76,
      "end": 5013.76,
      "formatted_start": "01:23:31.760",
      "formatted_end": "01:23:33.760",
      "text": "بله بله اگر مردم حرف هم میکنید"
    },
    {
      "id": 41,
      "start": 5013.76,
      "end": 5015.76,
      "formatted_start": "01:23:33.760",
      "formatted_end": "01:23:35.760",
      "text": "او امیدوارم باشیم"
    },
    {
