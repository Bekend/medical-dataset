  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13210.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:10.000",
      "text": "من اینو بیسم، اگه تا فردا دیدیش هم رنگ شده از بینگرد که هیچی بند، اگه بیدی نداره بیشتر بیشه، اینو بشه."
    },
    {
      "id": 1,
      "start": 13210.0,
      "end": 13220.0,
      "formatted_start": "03:40:10.000",
      "formatted_end": "03:40:20.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 13240.0,
      "end": 13242.0,
      "formatted_start": "03:40:40.000",
      "formatted_end": "03:40:42.000",
      "text": "یه شهر بشه سیت ریزی نداشتم"
    },
    {
      "id": 3,
      "start": 13242.0,
      "end": 13247.0,
      "formatted_start": "03:40:42.000",
      "formatted_end": "03:40:47.000",
      "text": "اگه بهتر نشد تا فردا هر دوست ده ساعت داریم سیت ریزی"
    },
    {
      "id": 4,
      "start": 13247.0,
      "end": 13249.0,
      "formatted_start": "03:40:47.000",
      "formatted_end": "03:40:49.000",
      "text": "خوش آمدید"
    },
    {
      "id": 5,
      "start": 13249.0,
      "end": 13250.0,
      "formatted_start": "03:40:49.000",
      "formatted_end": "03:40:50.000",
      "text": "خوش شکر کردیم"
    },
    {
      "id": 6,
      "start": 13250.0,
      "end": 13252.0,
      "formatted_start": "03:40:50.000",
      "formatted_end": "03:40:52.000",
      "text": "برامون خدا خدا خدا خدا"
    },
    {
      "id": 7,
      "start": 13252.0,
      "end": 13257.0,
      "formatted_start": "03:40:52.000",
      "formatted_end": "03:40:57.000",
      "text": "برای ادرار سختگی شما چه فرمان رو دست نیکنید؟"
    },
    {
      "id": 8,
      "start": 13257.0,
      "end": 13259.0,
      "formatted_start": "03:40:57.000",
      "formatted_end": "03:40:59.000",
      "text": "برای ادرار سختگی بست نگیرم"
    },
    {
      "id": 9,
      "start": 13259.0,
      "end": 13262.0,
      "formatted_start": "03:40:59.000",
      "formatted_end": "03:41:02.000",
      "text": "اگه هست تصویر باشه باید جانب دست نگیرم"
    },
    {
      "id": 10,
      "start": 13262.0,
      "end": 13265.0,
      "formatted_start": "03:41:02.000",
      "formatted_end": "03:41:05.000",
      "text": "اگه ناشی از سختگی ادرار ناشی از اصحال باشه"
    },
    {
      "id": 11,
      "start": 13265.0,
      "end": 13267.0,
      "formatted_start": "03:41:05.000",
      "formatted_end": "03:41:07.000",
      "text": "باید داروش فرق داریم"
    },
    {
      "id": 12,
      "start": 13267.0,
      "end": 13269.0,
      "formatted_start": "03:41:07.000",
      "formatted_end": "03:41:09.000",
      "text": "مالی چجوریه؟"
    },
    {
      "id": 13,
      "start": 13269.0,
      "end": 13271.0,
      "formatted_start": "03:41:09.000",
      "formatted_end": "03:41:11.000",
      "text": "اونه یا نه؟"
    },
    {
      "id": 14,
      "start": 13271.0,
      "end": 13273.0,
      "formatted_start": "03:41:11.000",
      "formatted_end": "03:41:13.000",
      "text": "قابلاً برمز شده"
    },
    {
      "id": 15,
      "start": 13273.0,
      "end": 13275.0,
      "formatted_start": "03:41:13.000",
      "formatted_end": "03:41:15.000",
      "text": "براش که نه برمز شده"
    },
    {
      "id": 16,
      "start": 13275.0,
      "end": 13277.0,
      "formatted_start": "03:41:15.000",
      "formatted_end": "03:41:17.000",
      "text": "همونده"
    },
    {
      "id": 17,
      "start": 13277.0,
      "end": 13279.0,
      "formatted_start": "03:41:17.000",
      "formatted_end": "03:41:19.000",
      "text": "دیده ده"
    },
    {
      "id": 18,
      "start": 13279.0,
      "end": 13281.0,
      "formatted_start": "03:41:19.000",
      "formatted_end": "03:41:21.000",
      "text": "دیوان"
    },
    {
      "id": 19,
      "start": 13281.0,
      "end": 13283.0,
      "formatted_start": "03:41:21.000",
      "formatted_end": "03:41:23.000",
      "text": "یا کاراندوری"
    },
    {
      "id": 20,
      "start": 13283.0,
      "end": 13285.0,
      "formatted_start": "03:41:23.000",
      "formatted_end": "03:41:25.000",
      "text": "در اینجوری با مستقبل"
    },
    {
      "id": 21,
      "start": 13285.0,
      "end": 13287.0,
      "formatted_start": "03:41:25.000",
      "formatted_end": "03:41:27.000",
      "text": "از اون میزانی"
    },
    {
      "id": 22,
      "start": 13287.0,
      "end": 13289.0,
      "formatted_start": "03:41:27.000",
      "formatted_end": "03:41:29.000",
      "text": "میرسیم از بردن شما خواهده"
    },
    {
      "id": 23,
      "start": 13297.0,
      "end": 13304.0,
      "formatted_start": "03:41:37.000",
      "formatted_end": "03:41:44.000",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 13327.0,
      "end": 13329.0,
      "formatted_start": "03:42:07.000",
      "formatted_end": "03:42:09.000",
      "text": "بله بیشتر"
    },
    {
      "id": 25,
      "start": 13329.0,
      "end": 13332.0,
      "formatted_start": "03:42:09.000",
      "formatted_end": "03:42:12.000",
      "text": "و این که این پیر لبش"
    },
    {
      "id": 26,
      "start": 13332.0,
      "end": 13335.0,
      "formatted_start": "03:42:12.000",
      "formatted_end": "03:42:15.000",
      "text": "این الاف کام سه باین باره دونه های ریزده"
    },
    {
      "id": 27,
      "start": 13335.0,
      "end": 13337.0,
      "formatted_start": "03:42:15.000",
      "formatted_end": "03:42:17.000",
      "text": "طبعا همون رسمته"
    },
    {
      "id": 28,
      "start": 13337.0,
      "end": 13341.0,
      "formatted_start": "03:42:17.000",
      "formatted_end": "03:42:21.000",
      "text": "و تیلی موز چند تا دونه پری روزی نه ها"
    },
    {
      "id": 29,
      "start": 13341.0,
      "end": 13344.0,
      "formatted_start": "03:42:21.000",
      "formatted_end": "03:42:24.000",
      "text": "چند تا دونه دروشتر زده"
    },
    {
      "id": 30,
      "start": 13349.0,
      "end": 13351.0,
      "formatted_start": "03:42:29.000",
      "formatted_end": "03:42:31.000",
      "text": "بقلش کن بسان بقلش"
    },
    {
      "id": 31,
      "start": 13351.0,
      "end": 13352.0,
      "formatted_start": "03:42:31.000",
      "formatted_end": "03:42:32.000",
      "text": "بی"
    },
    {
      "id": 32,
      "start": 13352.0,
      "end": 13354.0,
      "formatted_start": "03:42:32.000",
      "formatted_end": "03:42:34.000",
      "text": "بی از این"
    },
    {
      "id": 33,
      "start": 13354.0,
      "end": 13356.0,
      "formatted_start": "03:42:34.000",
      "formatted_end": "03:42:36.000",
      "text": "ازمشه"
    },
    {
      "id": 34,
      "start": 13356.0,
      "end": 13358.0,
      "formatted_start": "03:42:36.000",
      "formatted_end": "03:42:38.000",
      "text": "چه دونه خواهد بود؟"
    },
    {
      "id": 35,
      "start": 13358.0,
      "end": 13360.0,
      "formatted_start": "03:42:38.000",
      "formatted_end": "03:42:40.000",
      "text": "روژی؟ ناجی"
    },
    {
      "id": 36,
      "start": 13360.0,
      "end": 13362.0,
      "formatted_start": "03:42:40.000",
      "formatted_end": "03:42:42.000",
      "text": "ناجی"
    },
    {
      "id": 37,
      "start": 13362.0,
      "end": 13364.0,
      "formatted_start": "03:42:42.000",
      "formatted_end": "03:42:44.000",
      "text": "بیا از این"
    },
    {
      "id": 38,
      "start": 13364.0,
      "end": 13366.0,
      "formatted_start": "03:42:44.000",
      "formatted_end": "03:42:46.000",
      "text": "اینم بگیر"
    },
    {
      "id": 39,
      "start": 13366.0,
      "end": 13368.0,
      "formatted_start": "03:42:46.000",
      "formatted_end": "03:42:48.000",
      "text": "قانن نیست به یکی"
    },
    {
      "id": 40,
      "start": 13368.0,
      "end": 13370.0,
      "formatted_start": "03:42:48.000",
      "formatted_end": "03:42:50.000",
      "text": "قانن"
    },
    {
      "id": 41,
      "start": 13370.0,
      "end": 13372.0,
      "formatted_start": "03:42:50.000",
      "formatted_end": "03:42:52.000",
      "text": "اینم"
    },
    {
      "id": 42,
      "start": 13372.0,
      "end": 13374.0,
      "formatted_start": "03:42:52.000",
      "formatted_end": "03:42:54.000",
      "text": "نخواهدم"
    },
    {
      "id": 43,
      "start": 13374.0,
      "end": 13376.0,
      "formatted_start": "03:42:54.000",
      "formatted_end": "03:42:56.000",
      "text": "ترتیش بکنه"
    },
    {
      "id": 44,
      "start": 13376.0,
      "end": 13378.0,
      "formatted_start": "03:42:56.000",
      "formatted_end": "03:42:58.000",
      "text": "تماشاق از سیله ها است"
    },
    {
      "id": 45,
      "start": 13378.0,
      "end": 13380.0,
      "formatted_start": "03:42:58.000",
      "formatted_end": "03:43:00.000",
      "text": "کنه از این اسپرایه ها"
    },
    {
      "id": 46,
      "start": 13380.0,
      "end": 13382.0,
      "formatted_start": "03:43:00.000",
      "formatted_end": "03:43:02.000",
      "text": "خوشش میکنه"
    },
    {
      "id": 47,
      "start": 13382.0,
      "end": 13384.0,
      "formatted_start": "03:43:02.000",
      "formatted_end": "03:43:04.000",
      "text": "برای موهاشم فکر کنم میریزه زیادی"
    },
    {
      "id": 48,
      "start": 13384.0,
      "end": 13386.0,
      "formatted_start": "03:43:04.000",
      "formatted_end": "03:43:06.000",
      "text": "تبیه"
    },
    {
      "id": 49,
      "start": 13386.0,
      "end": 13387.0,
      "formatted_start": "03:43:06.000",
      "formatted_end": "03:43:07.000",
      "text": "تبیه"
    },
    {
      "id": 50,
      "start": 13387.0,
      "end": 13389.0,
      "formatted_start": "03:43:07.000",
      "formatted_end": "03:43:09.000",
      "text": "این موها کم کم بریزه"
    },
    {
      "id": 51,
      "start": 13389.0,
      "end": 13391.0,
      "formatted_start": "03:43:09.000",
      "formatted_end": "03:43:11.000",
      "text": "تو رخت خواهی موها"
    },
    {
      "id": 52,
      "start": 13391.0,
      "end": 13395.0,
      "formatted_start": "03:43:11.000",
      "formatted_end": "03:43:15.000",
      "text": "دو سالگی تازه موهای اصلی خودشون ترده"
    },
    {
      "id": 53,
      "start": 13395.0,
      "end": 13398.0,
      "formatted_start": "03:43:15.000",
      "formatted_end": "03:43:18.000",
      "text": "این موهای دوران جهنمی هست"
    },
    {
      "id": 54,
      "start": 13398.0,
      "end": 13402.0,
      "formatted_start": "03:43:18.000",
      "formatted_end": "03:43:22.000",
      "text": "خیلی وقت تو بازر بچه ها تا شش ماه اول میرسی"
    },
    {
      "id": 55,
      "start": 13402.0,
      "end": 13405.0,
      "formatted_start": "03:43:22.000",
      "formatted_end": "03:43:25.000",
      "text": "ولی تو بازر بچه ها نه از یه سالگی میرسه"
    },
    {
      "id": 56,
      "start": 13408.0,
      "end": 13409.0,
      "formatted_start": "03:43:28.000",
      "formatted_end": "03:43:29.000",
      "text": "راه میره؟"
    },
    {
      "id": 57,
      "start": 13409.0,
      "end": 13410.0,
      "formatted_start": "03:43:29.000",
      "formatted_end": "03:43:30.000",
      "text": "بله"
    },
    {
      "id": 58,
      "start": 13410.0,
      "end": 13413.0,
      "formatted_start": "03:43:30.000",
      "formatted_end": "03:43:33.000",
      "text": "نصف شب خیلی گریدار میشه"
    },
    {
      "id": 59,
      "start": 13413.0,
      "end": 13417.0,
      "formatted_start": "03:43:33.000",
      "formatted_end": "03:43:37.000",
      "text": "برای شیر ها، بگو یعنی شیر میدن میخواد دیگه شیر خودمانه داشت"
    },
    {
      "id": 60,
      "start": 13420.0,
      "end": 13422.0,
      "formatted_start": "03:43:40.000",
      "formatted_end": "03:43:42.000",
      "text": "من نمیدونم سیر نمیشه؟"
    },
    {
      "id": 61,
      "start": 13422.0,
      "end": 13430.0,
      "formatted_start": "03:43:42.000",
      "formatted_end": "03:43:50.000",
      "text": "اصلا ببینی تو این سن بچه ها شیر رو فقط به عنوان یه مایه آرامش، آرامش دهنده میخوان"
    },
    {
      "id": 62,
      "start": 13430.0,
      "end": 13437.0,
      "formatted_start": "03:43:50.000",
      "formatted_end": "03:43:57.000",
      "text": "در نصف شب دوست داره وقتی کنار شما خوابیده دوست داره حس بکنه که کنارشون شیر بخوره"
    },
    {
      "id": 63,
      "start": 13437.0,
      "end": 13439.0,
      "formatted_start": "03:43:57.000",
      "formatted_end": "03:43:59.000",
      "text": "برای آرامش بردن"
    },
    {
      "id": 64,
      "start": 13439.0,
      "end": 13441.0,
      "formatted_start": "03:43:59.000",
      "formatted_end": "03:44:01.000",
      "text": "چجوری بعضی پستونت میخواد"
    },
    {
      "id": 65,
      "start": 13441.0,
      "end": 13443.0,
      "formatted_start": "03:44:01.000",
      "formatted_end": "03:44:03.000",
      "text": "آرامش را میخواد"
    },
    {
      "id": 66,
      "start": 13443.0,
      "end": 13445.0,
      "formatted_start": "03:44:03.000",
      "formatted_end": "03:44:05.000",
      "text": "این خواهید خواهد"
    },
    {
      "id": 67,
      "start": 13445.0,
      "end": 13447.0,
      "formatted_start": "03:44:05.000",
      "formatted_end": "03:44:07.000",
      "text": "چون تاکیبا به بچه ها آرامش بید"
    },
    {
      "id": 68,
      "start": 13447.0,
      "end": 13449.0,
      "formatted_start": "03:44:07.000",
      "formatted_end": "03:44:09.000",
      "text": "به خاطر همه"
    },
    {
      "id": 69,
      "start": 13449.0,
      "end": 13451.0,
      "formatted_start": "03:44:09.000",
      "formatted_end": "03:44:11.000",
      "text": "حالا الان"
    },
    {
      "id": 70,
      "start": 13451.0,
      "end": 13453.0,
      "formatted_start": "03:44:11.000",
      "formatted_end": "03:44:13.000",
      "text": "بعد یکی یک برگرد شیر شبش را کم کنی"
    },
    {
      "id": 71,
      "start": 13453.0,
      "end": 13455.0,
      "formatted_start": "03:44:13.000",
      "formatted_end": "03:44:15.000",
      "text": "مثلا هر دفعه که بیدار میشه بهش شیر نده"
    },
    {
      "id": 72,
      "start": 13455.0,
      "end": 13457.0,
      "formatted_start": "03:44:15.000",
      "formatted_end": "03:44:17.000",
      "text": "مثلا یک برگرد"
    },
    {
      "id": 73,
      "start": 13457.0,
      "end": 13459.0,
      "formatted_start": "03:44:17.000",
      "formatted_end": "03:44:19.000",
      "text": "برگردش کن و تکونش کنه"
    },
    {
      "id": 74,
      "start": 13459.0,
      "end": 13461.0,
      "formatted_start": "03:44:19.000",
      "formatted_end": "03:44:21.000",
      "text": "مثلا یکی لالا"
    },
    {
      "id": 75,
      "start": 13461.0,
      "end": 13463.0,
      "formatted_start": "03:44:21.000",
      "formatted_end": "03:44:23.000",
      "text": "یک برگردش کن و تکونش کنه"
    },
    {
      "id": 76,
      "start": 13463.0,
      "end": 13467.0,
      "formatted_start": "03:44:23.000",
      "formatted_end": "03:44:27.000",
      "text": "این باعث میشه کم کم شیره شبشو بگیری"
    },
    {
      "id": 77,
      "start": 13467.0,
      "end": 13471.0,
      "formatted_start": "03:44:27.000",
      "formatted_end": "03:44:31.000",
      "text": "چون شیره شب باعث میشه که دندونا هم بگه آخه پسیده بشه"
    },
    {
      "id": 78,
      "start": 13471.0,
      "end": 13475.0,
      "formatted_start": "03:44:31.000",
      "formatted_end": "03:44:35.000",
      "text": "چون شب بگه بزرگ ترشون نمیشه"
    },
    {
      "id": 79,
      "start": 13475.0,
      "end": 13477.0,
      "formatted_start": "03:44:35.000",
      "formatted_end": "03:44:37.000",
      "text": "نمیشه دهنها"
    },
    {
      "id": 80,
      "start": 13477.0,
      "end": 13479.0,
      "formatted_start": "03:44:37.000",
      "formatted_end": "03:44:39.000",
      "text": "بین همه رو دندوناش میمونن"
    },
    {
      "id": 81,
      "start": 13479.0,
      "end": 13483.0,
      "formatted_start": "03:44:39.000",
      "formatted_end": "03:44:43.000",
      "text": "و قضا چی میخوره همه چی میخوره"
    },
    {
      "id": 82,
      "start": 13483.0,
      "end": 13487.0,
      "formatted_start": "03:44:43.000",
      "formatted_end": "03:44:47.000",
      "text": "خیلی زیتونی ها هم خیلی بیشتر"
    },
    {
      "id": 83,
      "start": 13487.0,
      "end": 13491.0,
      "formatted_start": "03:44:47.000",
      "formatted_end": "03:44:51.000",
      "text": "زیتون و گوجه هایی رو خیلی بیشتر"
    },
    {
      "id": 84,
      "start": 13491.0,
      "end": 13493.0,
      "formatted_start": "03:44:51.000",
      "formatted_end": "03:44:53.000",
      "text": "شیرینی اصلا نمیخورم"
    },
    {
      "id": 85,
      "start": 13493.0,
      "end": 13495.0,
      "formatted_start": "03:44:53.000",
      "formatted_end": "03:44:55.000",
      "text": "پاپ پاری"
    },
    {
      "id": 86,
      "start": 13495.0,
      "end": 13497.0,
      "formatted_start": "03:44:55.000",
      "formatted_end": "03:44:57.000",
      "text": "شیره خوشکم که اصلا نمیخورم"
    },
    {
      "id": 87,
      "start": 13497.0,
      "end": 13499.0,
      "formatted_start": "03:44:57.000",
      "formatted_end": "03:44:59.000",
      "text": "نمانی"
    }
  ],
  "status": "completed"
}