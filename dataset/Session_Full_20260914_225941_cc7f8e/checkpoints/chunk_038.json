  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11403.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:03.000",
      "text": "ماشاله پلده بود، شیرت خوبه، خب؟"
    },
    {
      "id": 1,
      "start": 11403.0,
      "end": 11411.0,
      "formatted_start": "03:10:03.000",
      "formatted_end": "03:10:11.000",
      "text": "ببین، بچه هایی که شیر مادر میخورن، اصلا تو کتابهای ما نوشته، ممکنه روز و ده باشه کمشون کنن."
    },
    {
      "id": 2,
      "start": 11411.0,
      "end": 11415.0,
      "formatted_start": "03:10:11.000",
      "formatted_end": "03:10:15.000",
      "text": "ممکنه هر ده روز و یه باشه کمشون کنن."
    },
    {
      "id": 3,
      "start": 11415.0,
      "end": 11419.0,
      "formatted_start": "03:10:15.000",
      "formatted_end": "03:10:19.000",
      "text": "هیچ اشخالی نداره، بسیاری به تقضی مادر داره، خب؟"
    },
    {
      "id": 4,
      "start": 11419.0,
      "end": 11425.0,
      "formatted_start": "03:10:19.000",
      "formatted_end": "03:10:25.000",
      "text": "حالا میگن مادرهایی که شیرگاه میخورن، مثلا شیر، حالا شیر، هر چیزی که تو..."
    },
    {
      "id": 5,
      "start": 11425.0,
      "end": 11426.0,
      "formatted_start": "03:10:25.000",
      "formatted_end": "03:10:26.000",
      "text": "ماز میخورند، تبایی؟"
    },
    {
      "id": 6,
      "start": 11426.0,
      "end": 11428.0,
      "formatted_start": "03:10:26.000",
      "formatted_end": "03:10:28.000",
      "text": "ماز نه، ماز دو پنی روز، اینا نه"
    },
    {
      "id": 7,
      "start": 11428.0,
      "end": 11434.0,
      "formatted_start": "03:10:28.000",
      "formatted_end": "03:10:34.000",
      "text": "ببین شیر، شیر، بستنی، خامه، اینایی که فقط توی شیر دارن خب؟"
    },
    {
      "id": 8,
      "start": 11434.0,
      "end": 11437.0,
      "formatted_start": "03:10:34.000",
      "formatted_end": "03:10:37.000",
      "text": "اینا باعث میشه که یکم بچه ها دیر تر کار میکنن"
    },
    {
      "id": 9,
      "start": 11437.0,
      "end": 11442.0,
      "formatted_start": "03:10:37.000",
      "formatted_end": "03:10:42.000",
      "text": "بستنی چه، زنعتی چه، دستگاهی هیچ فرقی نمی کنه"
    },
    {
      "id": 10,
      "start": 11442.0,
      "end": 11445.0,
      "formatted_start": "03:10:42.000",
      "formatted_end": "03:10:45.000",
      "text": "بالاخره با شیر درست میشه، درسته؟"
    },
    {
      "id": 11,
      "start": 11445.0,
      "end": 11450.0,
      "formatted_start": "03:10:45.000",
      "formatted_end": "03:10:50.000",
      "text": "این باعث میشه که این شیر میله توی رودای بچه ها و حرکت رودا رو کم میکنه"
    },
    {
      "id": 12,
      "start": 11450.0,
      "end": 11452.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:10:52.000",
      "text": "در نفت دیر تر کار میکنه"
    },
    {
      "id": 13,
      "start": 11452.0,
      "end": 11456.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:56.000",
      "text": "ولی وقتی بعد از اینکه شیاف میزنی ببینی که قشن شده"
    },
    {
      "id": 14,
      "start": 11456.0,
      "end": 11461.0,
      "formatted_start": "03:10:56.000",
      "formatted_end": "03:11:01.000",
      "text": "خب فقط چون حرکت رودش کم شده این مطفوط رودش موده"
    },
    {
      "id": 15,
      "start": 11461.0,
      "end": 11467.0,
      "formatted_start": "03:11:01.000",
      "formatted_end": "03:11:07.000",
      "text": "خب هر چیزی اصلا شیاف هم نوزده یه ذره روغنزه اتونو سر گوش با کن بزنی"
    },
    {
      "id": 16,
      "start": 11467.0,
      "end": 11471.0,
      "formatted_start": "03:11:07.000",
      "formatted_end": "03:11:11.000",
      "text": "بکنه داخل مقعدش بیاری بیرون این تحقیق میکنه شکمش کنه"
    },
    {
      "id": 17,
      "start": 11471.0,
      "end": 11478.0,
      "formatted_start": "03:11:11.000",
      "formatted_end": "03:11:18.000",
      "text": "بس اشکالی نداره فقط خودت سایی کن کمتر با خوری چیزایی که شیرگاه دارن"
    },
    {
      "id": 18,
      "start": 11478.0,
      "end": 11482.0,
      "formatted_start": "03:11:18.000",
      "formatted_end": "03:11:22.000",
      "text": "مثلا بستره یک موقعی با قوانه هفته یه دونه بخوان"
    },
    {
      "id": 19,
      "start": 11482.0,
      "end": 11486.0,
      "formatted_start": "03:11:22.000",
      "formatted_end": "03:11:26.000",
      "text": "خودش این رو که افراد نخور فیلن تا وقتی که شیش ماهش بشه"
    },
    {
      "id": 20,
      "start": 11486.0,
      "end": 11491.0,
      "formatted_start": "03:11:26.000",
      "formatted_end": "03:11:31.000",
      "text": "ولی مست و پنیر و دوغو میتونی بخوار هیچ اشکالی نداره"
    },
    {
      "id": 21,
      "start": 11491.0,
      "end": 11495.0,
      "formatted_start": "03:11:31.000",
      "formatted_end": "03:11:35.000",
      "text": "یه دنم قطعه بهش میده بیسم اسمش هست کروکید"
    },
    {
      "id": 22,
      "start": 11495.0,
      "end": 11501.0,
      "formatted_start": "03:11:35.000",
      "formatted_end": "03:11:41.000",
      "text": "روزی ده قطعه بهش بده اینم کمک میکنه که شکنمش بهتر مرده جدا"
    },
    {
      "id": 23,
      "start": 11501.0,
      "end": 11504.0,
      "formatted_start": "03:11:41.000",
      "formatted_end": "03:11:44.000",
      "text": "تا که دیدم؟ تا اینکه شکنمش رو ریاض خودت کنه؟"
    },
    {
      "id": 24,
      "start": 11504.0,
      "end": 11509.14,
      "formatted_start": "03:11:44.000",
      "formatted_end": "03:11:49.140",
      "text": "بچه های پراکید هر روز هستن بدن تا شش ماهی"
    },
    {
      "id": 25,
      "start": 11509.14,
      "end": 11513.54,
      "formatted_start": "03:11:49.140",
      "formatted_end": "03:11:53.540",
      "text": "این باعث میشه نقش هم کمتر داشت و گمش هم بکتر کنه"
    },
    {
      "id": 26,
      "start": 11513.54,
      "end": 11515.54,
      "formatted_start": "03:11:53.540",
      "formatted_end": "03:11:55.540",
      "text": "روزی یه بار چه؟"
    },
    {
      "id": 27,
      "start": 11515.54,
      "end": 11517.54,
      "formatted_start": "03:11:55.540",
      "formatted_end": "03:11:57.540",
      "text": "آره روزی یه بار ترمش"
    },
    {
      "id": 28,
      "start": 11517.54,
      "end": 11521.8,
      "formatted_start": "03:11:57.540",
      "formatted_end": "03:12:01.800",
      "text": "این پوستش اینجا یه حالت قرمز میشه"
    },
    {
      "id": 29,
      "start": 11521.8,
      "end": 11523.8,
      "formatted_start": "03:12:01.800",
      "formatted_end": "03:12:03.800",
      "text": "بعد یه مدت میره"
    },
    {
      "id": 30,
      "start": 11523.8,
      "end": 11526.84,
      "formatted_start": "03:12:03.800",
      "formatted_end": "03:12:06.840",
      "text": "آره روزی خوره بگه ریجه زبره"
    },
    {
      "id": 31,
      "start": 11526.84,
      "end": 11528.84,
      "formatted_start": "03:12:06.840",
      "formatted_end": "03:12:08.840",
      "text": "پوستی پوسته میشه"
    },
    {
      "id": 32,
      "start": 11528.84,
      "end": 11529.84,
      "formatted_start": "03:12:08.840",
      "formatted_end": "03:12:09.840",
      "text": "این حساسیت"
    },
    {
      "id": 33,
      "start": 11529.84,
      "end": 11534.14,
      "formatted_start": "03:12:09.840",
      "formatted_end": "03:12:14.140",
      "text": "هم حساسیت پوستی، بیشتر در اصل بوسیدن"
    },
    {
      "id": 34,
      "start": 11534.14,
      "end": 11538.74,
      "formatted_start": "03:12:14.140",
      "formatted_end": "03:12:18.740",
      "text": "یا این هم در اصل بعضی از منابعاتی که مادر میخوره ممکنه حساسیت داره"
    },
    {
      "id": 35,
      "start": 11538.74,
      "end": 11542.24,
      "formatted_start": "03:12:18.740",
      "formatted_end": "03:12:22.240",
      "text": "خود شیر هم حساسیت گوارشی میده"
    },
    {
      "id": 36,
      "start": 11542.24,
      "end": 11544.58,
      "formatted_start": "03:12:22.240",
      "formatted_end": "03:12:24.580",
      "text": "باعث میشه یه بچه یه بوسد بشه"
    },
    {
      "id": 37,
      "start": 11544.58,
      "end": 11547.92,
      "formatted_start": "03:12:24.580",
      "formatted_end": "03:12:27.920",
      "text": "هم حساسیت پوستی میده باعث میشه یکی اکنون باشه"
    },
    {
      "id": 38,
      "start": 11547.92,
      "end": 11550.9,
      "formatted_start": "03:12:27.920",
      "formatted_end": "03:12:30.900",
      "text": "این پروکیدی دیگه بهش بدی تحصیل داره"
    },
    {
      "id": 39,
      "start": 11550.9,
      "end": 11553.58,
      "formatted_start": "03:12:30.900",
      "formatted_end": "03:12:33.580",
      "text": "یه پاپادم براش میرسن هیدروکورتیزون"
    },
    {
      "id": 40,
      "start": 11553.58,
      "end": 11556.84,
      "formatted_start": "03:12:33.580",
      "formatted_end": "03:12:36.840",
      "text": "روزی دو بار براش بخونش"
    },
    {
      "id": 41,
      "start": 11556.84,
      "end": 11558.28,
      "formatted_start": "03:12:36.840",
      "formatted_end": "03:12:38.280",
      "text": "خوابش"
    },
    {
      "id": 42,
      "start": 11558.28,
      "end": 11565.28,
      "formatted_start": "03:12:38.280",
      "formatted_end": "03:12:45.280",
      "text": "از اینجوری باکسنه باید بردارید."
    },
    {
      "id": 43,
      "start": 11565.28,
      "end": 11568.28,
      "formatted_start": "03:12:45.280",
      "formatted_end": "03:12:48.280",
      "text": "اینجوری باکسنه باید بردارید."
    },
    {
      "id": 44,
      "start": 11568.28,
      "end": 11570.28,
      "formatted_start": "03:12:48.280",
      "formatted_end": "03:12:50.280",
      "text": "از اینجوری باکسنه باید بردارید."
    },
    {
      "id": 45,
      "start": 11570.28,
      "end": 11572.28,
      "formatted_start": "03:12:50.280",
      "formatted_end": "03:12:52.280",
      "text": "از اینجوری باکسنه باید بردارید."
    },
    {
      "id": 46,
      "start": 11572.28,
      "end": 11574.28,
      "formatted_start": "03:12:52.280",
      "formatted_end": "03:12:54.280",
      "text": "از اینجوری باکسنه باید بردارید."
    },
    {
      "id": 47,
      "start": 11574.28,
      "end": 11576.28,
      "formatted_start": "03:12:54.280",
      "formatted_end": "03:12:56.280",
      "text": "اینجوری باکسنه باید بردارید."
    },
    {
      "id": 48,
      "start": 11576.28,
      "end": 11578.28,
      "formatted_start": "03:12:56.280",
      "formatted_end": "03:12:58.280",
      "text": "اینجوری باکسنه باید بردارید."
    },
    {
      "id": 49,
      "start": 11578.28,
      "end": 11580.28,
      "formatted_start": "03:12:58.280",
      "formatted_end": "03:13:00.280",
      "text": "اینجوری باکسنه باید بردارید."
    },
    {
      "id": 50,
      "start": 11580.28,
      "end": 11582.28,
      "formatted_start": "03:13:00.280",
      "formatted_end": "03:13:02.280",
      "text": "اینجوری باید بردارید."
    },
    {
      "id": 51,
      "start": 11582.28,
      "end": 11585.58,
      "formatted_start": "03:13:02.280",
      "formatted_end": "03:13:05.580",
      "text": "یعنی اینکه باکسنه ترسیبش رو گذاشته"
    },
    {
      "id": 52,
      "start": 11585.58,
      "end": 11587.46,
      "formatted_start": "03:13:05.580",
      "formatted_end": "03:13:07.460",
      "text": "بعد هی زخمیشه"
    },
    {
      "id": 53,
      "start": 11587.46,
      "end": 11589.28,
      "formatted_start": "03:13:07.460",
      "formatted_end": "03:13:09.280",
      "text": "هی سرش برم میکنه"
    },
    {
      "id": 54,
      "start": 11589.28,
      "end": 11591.08,
      "formatted_start": "03:13:09.280",
      "formatted_end": "03:13:11.080",
      "text": "چک کالی میشه دوباره زخمیشه"
    },
    {
      "id": 55,
      "start": 11591.08,
      "end": 11592.98,
      "formatted_start": "03:13:11.080",
      "formatted_end": "03:13:12.980",
      "text": "دوباره چک کالی میشه زخمیشه"
    },
    {
      "id": 56,
      "start": 11592.98,
      "end": 11594.64,
      "formatted_start": "03:13:12.980",
      "formatted_end": "03:13:14.640",
      "text": "این باکنش ایمینیه"
    },
    {
      "id": 57,
      "start": 11594.64,
      "end": 11596.56,
      "formatted_start": "03:13:14.640",
      "formatted_end": "03:13:16.560",
      "text": "این طبیعیه تا یه مدت"
    },
    {
      "id": 58,
      "start": 11596.56,
      "end": 11598.04,
      "formatted_start": "03:13:16.560",
      "formatted_end": "03:13:18.040",
      "text": "اینقدر این کارو اینجوری میشه"
    },
    {
      "id": 59,
      "start": 11598.04,
      "end": 11600.08,
      "formatted_start": "03:13:18.040",
      "formatted_end": "03:13:20.080",
      "text": "تا همه ما جاشو"
    },
    {
      "id": 60,
      "start": 11600.08,
      "end": 11601.58,
      "formatted_start": "03:13:20.080",
      "formatted_end": "03:13:21.580",
      "text": "تو بندنمون داریم"
    },
    {
      "id": 61,
      "start": 11601.58,
      "end": 11605.04,
      "formatted_start": "03:13:21.580",
      "formatted_end": "03:13:25.040",
      "text": "الان خودتن نباید کلی دسته جاشو داریم"
    },
    {
      "id": 62,
      "start": 11605.04,
      "end": 11605.38,
      "formatted_start": "03:13:25.040",
      "formatted_end": "03:13:25.380",
      "text": "خب"
    },
    {
      "id": 63,
      "start": 11605.38,
      "end": 11607.92,
      "formatted_start": "03:13:25.380",
      "formatted_end": "03:13:27.920",
      "text": "خب بس"
    },
    {
      "id": 64,
      "start": 11607.92,
      "end": 11625.98,
      "formatted_start": "03:13:27.920",
      "formatted_end": "03:13:45.980",
      "text": "بچه آرین بیانه؟"
    },
    {
      "id": 65,
      "start": 11625.98,
      "end": 11626.86,
      "formatted_start": "03:13:45.980",
      "formatted_end": "03:13:46.860",
      "text": "آرین، خدا شد"
    },
    {
      "id": 66,
      "start": 11626.86,
      "end": 11627.48,
      "formatted_start": "03:13:46.860",
      "formatted_end": "03:13:47.480",
      "text": "نه، درسته"
    },
    {
      "id": 67,
      "start": 11627.48,
      "end": 11629.96,
      "formatted_start": "03:13:47.480",
      "formatted_end": "03:13:49.960",
      "text": "اصلا گرگه نمی کنه"
    },
    {
      "id": 68,
      "start": 11629.96,
      "end": 11631.58,
      "formatted_start": "03:13:49.960",
      "formatted_end": "03:13:51.580",
      "text": "اصلا اینجا داداش بزرگش"
    },
    {
      "id": 69,
      "start": 11631.58,
      "end": 11633.12,
      "formatted_start": "03:13:51.580",
      "formatted_end": "03:13:53.120",
      "text": "مثلا عذیتش کنه"
    },
    {
      "id": 70,
      "start": 11633.12,
      "end": 11633.92,
      "formatted_start": "03:13:53.120",
      "formatted_end": "03:13:53.920",
      "text": "اصلا"
    },
    {
      "id": 71,
      "start": 11633.92,
      "end": 11636.66,
      "formatted_start": "03:13:53.920",
      "formatted_end": "03:13:56.660",
      "text": "عذیتش هم بی کنه"
    },
    {
      "id": 72,
      "start": 11636.66,
      "end": 11638.66,
      "formatted_start": "03:13:56.660",
      "formatted_end": "03:13:58.660",
      "text": "آره، اینقدر حسودش میشه"
    },
    {
      "id": 73,
      "start": 11638.66,
      "end": 11642.66,
      "formatted_start": "03:13:58.660",
      "formatted_end": "03:14:02.660",
      "text": "راگنه گشتنش همه شد، بیایی از گریه نمی کنه"
    },
    {
      "id": 74,
      "start": 11642.66,
      "end": 11646.66,
      "formatted_start": "03:14:02.660",
      "formatted_end": "03:14:06.660",
      "text": "فقط دستاش رو تو دهنش میکنه، پرون گشت نشد"
    },
    {
      "id": 75,
      "start": 11646.66,
      "end": 11648.66,
      "formatted_start": "03:14:06.660",
      "formatted_end": "03:14:08.660",
      "text": "از آن هستند، خدا شده"
    },
    {
      "id": 76,
      "start": 11648.66,
      "end": 11650.66,
      "formatted_start": "03:14:08.660",
      "formatted_end": "03:14:10.660",
      "text": "بچه چندامه؟"
    },
    {
      "id": 77,
      "start": 11650.66,
      "end": 11651.66,
      "formatted_start": "03:14:10.660",
      "formatted_end": "03:14:11.660",
      "text": "دنبال"
    },
    {
      "id": 78,
      "start": 11651.66,
      "end": 11653.66,
      "formatted_start": "03:14:11.660",
      "formatted_end": "03:14:13.660",
      "text": "آن همینجوری بود؟"
    },
    {
      "id": 79,
      "start": 11653.66,
      "end": 11655.66,
      "formatted_start": "03:14:13.660",
      "formatted_end": "03:14:15.660",
      "text": "آن هم آره بود، آره"
    },
    {
      "id": 80,
      "start": 11657.66,
      "end": 11661.66,
      "formatted_start": "03:14:17.660",
      "formatted_end": "03:14:21.660",
      "text": "آره من یه بچه بزرگ کردم، به اندازه ده تا بچه"
    },
    {
      "id": 81,
      "start": 11661.66,
      "end": 11663.66,
      "formatted_start": "03:14:21.660",
      "formatted_end": "03:14:23.660",
      "text": "خیلی خیلی خیلی خیلی خیلی"
    },
    {
      "id": 82,
      "start": 11663.66,
      "end": 11670.66,
      "formatted_start": "03:14:23.660",
      "formatted_end": "03:14:30.660",
      "text": "خواره بچهش این بیخوایی که یک چیز بود و از اونها که گریه میدی کرد کل شب و ریز نمیخواد بوده فرق گریه میده"
    },
    {
      "id": 83,
      "start": 11670.66,
      "end": 11677.66,
      "formatted_start": "03:14:30.660",
      "formatted_end": "03:14:37.660",
      "text": "بابرت میشه من دو ماهش که شده بود من آخر دیگر زایمان کردم نرزمی که ای"
    },
    {
      "id": 84,
      "start": 11677.66,
      "end": 11681.66,
      "formatted_start": "03:14:37.660",
      "formatted_end": "03:14:41.660",
      "text": "یه روز مادرشو هم باشد که بچه بود من تو برو را رشت کنم"
    },
    {
      "id": 85,
      "start": 11681.66,
      "end": 11692.66,
      "formatted_start": "03:14:41.660",
      "formatted_end": "03:14:52.660",
      "text": "اصلا وقتی که من جل آینه کنم اینقدر ابرو، سی بی، اصلا فرصت این که من یه همومه درسته سبی نرفته بودم"
    },
    {
      "id": 86,
      "start": 11692.66,
      "end": 11695.06,
      "formatted_start": "03:14:52.660",
      "formatted_end": "03:14:55.060",
      "text": "میرفتم دو شاوا بازم کردم"
    },
    {
      "id": 87,
      "start": 11695.06,
      "end": 11696.58,
      "formatted_start": "03:14:55.060",
      "formatted_end": "03:14:56.580",
      "text": "اینجا زنجیر"
    },
    {
      "id": 88,
      "start": 11696.58,
      "end": 11698.54,
      "formatted_start": "03:14:56.580",
      "formatted_end": "03:14:58.540",
      "text": "و شوهرم گفت زود باش بیا"
    },
    {
      "id": 89,
      "start": 11698.54,
      "end": 11699.3,
      "formatted_start": "03:14:58.540",
      "formatted_end": "03:14:59.300",
      "text": "زود باش بیا"
    }
  ],
  "status": "completed"
}