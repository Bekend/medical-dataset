  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9602.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:02.000",
      "text": "از طرف اینجا بگیریم که شما رو هفت میزنم."
    },
    {
      "id": 1,
      "start": 9602.0,
      "end": 9606.0,
      "formatted_start": "02:40:02.000",
      "formatted_end": "02:40:06.000",
      "text": "نه، دکتر از دکتر خواهش همکنم نمیدونه."
    },
    {
      "id": 2,
      "start": 9606.0,
      "end": 9610.0,
      "formatted_start": "02:40:06.000",
      "formatted_end": "02:40:10.000",
      "text": "میگم موقعی که سرمو خواهدیم، میگم آن فولیدیم سریع تر میشه؟"
    },
    {
      "id": 3,
      "start": 9610.0,
      "end": 9612.0,
      "formatted_start": "02:40:10.000",
      "formatted_end": "02:40:12.000",
      "text": "نه، نه، وقتی بگیریم سریع تر."
    },
    {
      "id": 4,
      "start": 9612.0,
      "end": 9620.0,
      "formatted_start": "02:40:12.000",
      "formatted_end": "02:40:20.000",
      "text": "خانم دکتر، پسرم آیهان، من در قسم می کنم یکی کنید یا دو ماه آیهان بی حسل است."
    },
    {
      "id": 5,
      "start": 9620.0,
      "end": 9626.46,
      "formatted_start": "02:40:20.000",
      "formatted_end": "02:40:26.460",
      "text": "زود خسته میشه، یکم زود بد اخلاق میشه، احساس میدونم رنگشم به نظرم پریده است"
    },
    {
      "id": 6,
      "start": 9626.46,
      "end": 9629.9,
      "formatted_start": "02:40:26.460",
      "formatted_end": "02:40:29.900",
      "text": "من میگم نکنه مثلا کمخونی باشه یه آزمایش نیشه؟"
    },
    {
      "id": 7,
      "start": 9629.9,
      "end": 9631.82,
      "formatted_start": "02:40:29.900",
      "formatted_end": "02:40:31.820",
      "text": "نه، نه، بنابراین"
    },
    {
      "id": 8,
      "start": 9631.82,
      "end": 9638.1,
      "formatted_start": "02:40:31.820",
      "formatted_end": "02:40:38.100",
      "text": "زمستون ها ایمونس میدادن ولی از اسفنده چان گفته بودن بین ویتامین باید استفاده شده؟"
    },
    {
      "id": 9,
      "start": 9638.1,
      "end": 9638.7,
      "formatted_start": "02:40:38.100",
      "formatted_end": "02:40:38.700",
      "text": "نه، نه"
    },
    {
      "id": 10,
      "start": 9638.7,
      "end": 9641.14,
      "formatted_start": "02:40:38.700",
      "formatted_end": "02:40:41.140",
      "text": "زمستون میدن تا به صورتش میپرده"
    },
    {
      "id": 11,
      "start": 9641.14,
      "end": 9643.9,
      "formatted_start": "02:40:41.140",
      "formatted_end": "02:40:43.900",
      "text": "پردون می کنیم ولی ویتامین دی رو باید ادامه بدیم"
    },
    {
      "id": 12,
      "start": 9643.9,
      "end": 9645.9,
      "formatted_start": "02:40:43.900",
      "formatted_end": "02:40:45.900",
      "text": "باید بیتامین دی چیزی نداره"
    },
    {
      "id": 13,
      "start": 9645.9,
      "end": 9647.9,
      "formatted_start": "02:40:45.900",
      "formatted_end": "02:40:47.900",
      "text": "من یعنی از فرمدن هیچ"
    },
    {
      "id": 14,
      "start": 9647.9,
      "end": 9649.9,
      "formatted_start": "02:40:47.900",
      "formatted_end": "02:40:49.900",
      "text": "بیشتره چیز که باعث خستگی"
    },
    {
      "id": 15,
      "start": 9649.9,
      "end": 9651.9,
      "formatted_start": "02:40:49.900",
      "formatted_end": "02:40:51.900",
      "text": "جزم شده بچه ها"
    },
    {
      "id": 16,
      "start": 9651.9,
      "end": 9653.9,
      "formatted_start": "02:40:51.900",
      "formatted_end": "02:40:53.900",
      "text": "کمبول آهنگ و کمبول بیتامین دیه"
    },
    {
      "id": 17,
      "start": 9653.9,
      "end": 9655.9,
      "formatted_start": "02:40:53.900",
      "formatted_end": "02:40:55.900",
      "text": "خب؟ ولی"
    },
    {
      "id": 18,
      "start": 9655.9,
      "end": 9657.9,
      "formatted_start": "02:40:55.900",
      "formatted_end": "02:40:57.900",
      "text": "یه چیز دیگه"
    },
    {
      "id": 19,
      "start": 9657.9,
      "end": 9659.9,
      "formatted_start": "02:40:57.900",
      "formatted_end": "02:40:59.900",
      "text": "که یه چیز دیگه که باعث"
    },
    {
      "id": 20,
      "start": 9659.9,
      "end": 9661.9,
      "formatted_start": "02:40:59.900",
      "formatted_end": "02:41:01.900",
      "text": "خستگی و بیهبترگی نیشه"
    },
    {
      "id": 21,
      "start": 9661.9,
      "end": 9663.9,
      "formatted_start": "02:41:01.900",
      "formatted_end": "02:41:03.900",
      "text": "افسردگی و استراف"
    },
    {
      "id": 22,
      "start": 9663.9,
      "end": 9665.9,
      "formatted_start": "02:41:03.900",
      "formatted_end": "02:41:05.900",
      "text": "همه شرایط اونجا بودین"
    },
    {
      "id": 23,
      "start": 9665.9,
      "end": 9667.9,
      "formatted_start": "02:41:05.900",
      "formatted_end": "02:41:07.900",
      "text": "مثلا به هر خواه شرایط جنگی بوده"
    },
    {
      "id": 24,
      "start": 9667.9,
      "end": 9669.9,
      "formatted_start": "02:41:07.900",
      "formatted_end": "02:41:09.900",
      "text": "نصیبه دو ماما ازا نصف برده دید"
    },
    {
      "id": 25,
      "start": 9669.9,
      "end": 9674.46,
      "formatted_start": "02:41:09.900",
      "formatted_end": "02:41:14.460",
      "text": "دو دفعه رفتم دو هفته موندم و از برگشتن ها یک و نمی مانه اینجاست"
    },
    {
      "id": 26,
      "start": 9674.46,
      "end": 9678.1,
      "formatted_start": "02:41:14.460",
      "formatted_end": "02:41:18.100",
      "text": "مثلا میگم دیشب"
    },
    {
      "id": 27,
      "start": 9678.1,
      "end": 9682.4,
      "formatted_start": "02:41:18.100",
      "formatted_end": "02:41:22.400",
      "text": "حسابی خوابوندمش دو ساعت زور شامشو دادم"
    },
    {
      "id": 28,
      "start": 9682.4,
      "end": 9687.36,
      "formatted_start": "02:41:22.400",
      "formatted_end": "02:41:27.360",
      "text": "اوکی همه چی تنگی رفتم فقط یک مغازه که براش پوشات بگیرم"
    },
    {
      "id": 29,
      "start": 9687.36,
      "end": 9690.46,
      "formatted_start": "02:41:27.360",
      "formatted_end": "02:41:30.460",
      "text": "پنج میده به بازی میکنه برید"
    },
    {
      "id": 30,
      "start": 9690.46,
      "end": 9693.9,
      "formatted_start": "02:41:30.460",
      "formatted_end": "02:41:33.900",
      "text": "رنگش که چیه؟ گرست نمه حال ندارم"
    },
    {
      "id": 31,
      "start": 9693.9,
      "end": 9695.04,
      "formatted_start": "02:41:33.900",
      "formatted_end": "02:41:35.040",
      "text": "بخواب بخواب برم"
    },
    {
      "id": 32,
      "start": 9695.04,
      "end": 9698.04,
      "formatted_start": "02:41:35.040",
      "formatted_end": "02:41:38.040",
      "text": "خود آزماشه تیرویدم حتما باید برشنجونه"
    },
    {
      "id": 33,
      "start": 9698.04,
      "end": 9700.04,
      "formatted_start": "02:41:38.040",
      "formatted_end": "02:41:40.040",
      "text": "خب پس چه کار برش بینم؟"
    },
    {
      "id": 34,
      "start": 9700.04,
      "end": 9704.04,
      "formatted_start": "02:41:40.040",
      "formatted_end": "02:41:44.040",
      "text": "خودم میگم نمیدونم یه بیرونسه بگن خوابش ترمیلی"
    },
    {
      "id": 35,
      "start": 9704.04,
      "end": 9709.04,
      "formatted_start": "02:41:44.040",
      "formatted_end": "02:41:49.040",
      "text": "بسرهای من جفتشون خون بیرون که از وچه ای خوب میخوابن"
    },
    {
      "id": 36,
      "start": 9709.04,
      "end": 9711.04,
      "formatted_start": "02:41:49.040",
      "formatted_end": "02:41:51.040",
      "text": "یعنی اگه زور مثلا بخوابید"
    },
    {
      "id": 37,
      "start": 9711.04,
      "end": 9713.04,
      "formatted_start": "02:41:51.040",
      "formatted_end": "02:41:53.040",
      "text": "زور همیشه میخواب ست شیش هم میداد بشن"
    },
    {
      "id": 38,
      "start": 9713.04,
      "end": 9717.04,
      "formatted_start": "02:41:53.040",
      "formatted_end": "02:41:57.040",
      "text": "یه جوری اگه ساعت ده باید باز دوار بر برم"
    },
    {
      "id": 39,
      "start": 9717.04,
      "end": 9719.04,
      "formatted_start": "02:41:57.040",
      "formatted_end": "02:41:59.040",
      "text": "میگن بخوابیم دیگه زود باشید بخوابیم"
    },
    {
      "id": 40,
      "start": 9719.04,
      "end": 9722.48,
      "formatted_start": "02:41:59.040",
      "formatted_end": "02:42:02.480",
      "text": "از بعد چون اینجوری بار اومده جفته شد"
    },
    {
      "id": 41,
      "start": 9722.48,
      "end": 9724.48,
      "formatted_start": "02:42:02.480",
      "formatted_end": "02:42:04.480",
      "text": "خوب بردی تربیت کنید"
    },
    {
      "id": 42,
      "start": 9724.48,
      "end": 9727.28,
      "formatted_start": "02:42:04.480",
      "formatted_end": "02:42:07.280",
      "text": "چون اینجوری دیگه ندارم زید دست خود"
    },
    {
      "id": 43,
      "start": 9727.28,
      "end": 9730.28,
      "formatted_start": "02:42:07.280",
      "formatted_end": "02:42:10.280",
      "text": "و اینجوری عادت دارن یعنی"
    },
    {
      "id": 44,
      "start": 9730.28,
      "end": 9732.28,
      "formatted_start": "02:42:10.280",
      "formatted_end": "02:42:12.280",
      "text": "حاضر دیگر از من گفت"
    },
    {
      "id": 45,
      "start": 9732.28,
      "end": 9734.28,
      "formatted_start": "02:42:12.280",
      "formatted_end": "02:42:14.280",
      "text": "چند سال داشت؟"
    },
    {
      "id": 46,
      "start": 9734.28,
      "end": 9737.28,
      "formatted_start": "02:42:14.280",
      "formatted_end": "02:42:17.280",
      "text": "الان نه رفته تو 6 ساله باید بده پیشه"
    },
    {
      "id": 47,
      "start": 9737.28,
      "end": 9739.28,
      "formatted_start": "02:42:17.280",
      "formatted_end": "02:42:19.280",
      "text": "یک یک چهار ساله تولدش"
    },
    {
      "id": 48,
      "start": 9739.28,
      "end": 9741.28,
      "formatted_start": "02:42:19.280",
      "formatted_end": "02:42:21.280",
      "text": "بعد دو سه هفته پیش"
    },
    {
      "id": 49,
      "start": 9741.28,
      "end": 9744.28,
      "formatted_start": "02:42:21.280",
      "formatted_end": "02:42:24.280",
      "text": "اسحال گرفت کنم میوهاش نمیسازه"
    },
    {
      "id": 50,
      "start": 9744.28,
      "end": 9747.28,
      "formatted_start": "02:42:24.280",
      "formatted_end": "02:42:27.280",
      "text": "میوه دادم صبحش اسحال شدید"
    },
    {
      "id": 51,
      "start": 9747.28,
      "end": 9751.28,
      "formatted_start": "02:42:27.280",
      "formatted_end": "02:42:31.280",
      "text": "بودم شوژان ساینا و چوگان رفته بودم"
    },
    {
      "id": 52,
      "start": 9751.28,
      "end": 9755.28,
      "formatted_start": "02:42:31.280",
      "formatted_end": "02:42:35.280",
      "text": "زنگ دادن گفتش بعد خوب شدنش بیده که من فراموش کردم"
    },
    {
      "id": 53,
      "start": 9755.28,
      "end": 9759.28,
      "formatted_start": "02:42:35.280",
      "formatted_end": "02:42:39.280",
      "text": "دو هفته قبل دوباره همین رو شد"
    },
    {
      "id": 54,
      "start": 9759.28,
      "end": 9763.28,
      "formatted_start": "02:42:39.280",
      "formatted_end": "02:42:43.280",
      "text": "همین آن پی به آزر گرفتم دادم آزر خواهد برام بسیار"
    },
    {
      "id": 55,
      "start": 9763.28,
      "end": 9767.28,
      "formatted_start": "02:42:43.280",
      "formatted_end": "02:42:47.280",
      "text": "خب این آیهان"
    },
    {
      "id": 56,
      "start": 9767.28,
      "end": 9769.28,
      "formatted_start": "02:42:47.280",
      "formatted_end": "02:42:49.280",
      "text": "برخواهده"
    },
    {
      "id": 57,
      "start": 9769.28,
      "end": 9771.28,
      "formatted_start": "02:42:49.280",
      "formatted_end": "02:42:51.280",
      "text": "الان میتونم برم آزماشه باید ناشته باشه"
    },
    {
      "id": 58,
      "start": 9771.28,
      "end": 9773.28,
      "formatted_start": "02:42:51.280",
      "formatted_end": "02:42:53.280",
      "text": "الان همین شوید"
    },
    {
      "id": 59,
      "start": 9773.28,
      "end": 9775.28,
      "formatted_start": "02:42:53.280",
      "formatted_end": "02:42:55.280",
      "text": "چی کاری کنه؟"
    },
    {
      "id": 60,
      "start": 9775.28,
      "end": 9781.28,
      "formatted_start": "02:42:55.280",
      "formatted_end": "02:43:01.280",
      "text": "این دکتر اینو فقط شیری نیجاد. کاکاو. ارده کاکاو هست. مثلا محسوس اونجا باید دانون باشه همیشه."
    },
    {
      "id": 61,
      "start": 9781.28,
      "end": 9788.28,
      "formatted_start": "02:43:01.280",
      "formatted_end": "02:43:08.280",
      "text": "این پسر هم پیسو سیاریست مم داره. این آیه برای کاکاو اینا زرار داره."
    },
    {
      "id": 62,
      "start": 9788.28,
      "end": 9796.28,
      "formatted_start": "02:43:08.280",
      "formatted_end": "02:43:16.280",
      "text": "کرما. کاکاو. یه دیگه هر چی گرمی جاد. مرافقا. اصلا چیزای شیری."
    },
    {
      "id": 63,
      "start": 9796.28,
      "end": 9801.28,
      "formatted_start": "02:43:16.280",
      "formatted_end": "02:43:21.280",
      "text": "خب دکتر اگه پنیر و چیزای شور نخوره شما در آنپول میدین. آنپول های کلسومی نمیدین؟"
    },
    {
      "id": 64,
      "start": 9801.28,
      "end": 9802.28,
      "formatted_start": "02:43:21.280",
      "formatted_end": "02:43:22.280",
      "text": "نمیدین."
    },
    {
      "id": 65,
      "start": 9802.28,
      "end": 9805.96,
      "formatted_start": "02:43:22.280",
      "formatted_end": "02:43:25.960",
      "text": "پسر مخالف ماست هست. شیر میخورن ولی مخالف هست."
    },
    {
      "id": 66,
      "start": 9805.96,
      "end": 9808.28,
      "formatted_start": "02:43:25.960",
      "formatted_end": "02:43:28.280",
      "text": "ببینید. دو پسر بگو. شما این چیه؟"
    },
    {
      "id": 67,
      "start": 9808.28,
      "end": 9810.28,
      "formatted_start": "02:43:28.280",
      "formatted_end": "02:43:30.280",
      "text": "ایپاسان آی ها."
    },
    {
      "id": 68,
      "start": 9810.28,
      "end": 9813.96,
      "formatted_start": "02:43:30.280",
      "formatted_end": "02:43:33.960",
      "text": "خب. ما باید همین چی بخوریم تا بزرگ بشیم."
    },
    {
      "id": 69,
      "start": 9813.96,
      "end": 9817.8,
      "formatted_start": "02:43:33.960",
      "formatted_end": "02:43:37.800",
      "text": "خب؟ هر چیزی بیشتر از همی بخوریم بیفایده نداره."
    },
    {
      "id": 70,
      "start": 9817.8,
      "end": 9821.4,
      "formatted_start": "02:43:37.800",
      "formatted_end": "02:43:41.400",
      "text": "مثلا تو هیچ شیر نیم بخوری. شیر نیم بخوری. فایده نداره."
    },
    {
      "id": 71,
      "start": 9821.4,
      "end": 9823.4,
      "formatted_start": "02:43:41.400",
      "formatted_end": "02:43:43.400",
      "text": "برای که ما بدنمون بزرگ بشه."
    },
    {
      "id": 72,
      "start": 9823.4,
      "end": 9827.4,
      "formatted_start": "02:43:43.400",
      "formatted_end": "02:43:47.400",
      "text": "هم شیر نیم باید بخوریم در حد معمولی."
    },
    {
      "id": 73,
      "start": 9832.28,
      "end": 9840.28,
      "formatted_start": "02:43:52.280",
      "formatted_end": "02:44:00.280",
      "text": "هم باید روشت بخوریم، هم باید میبه بخوریم، و هم باید پر رو بخوریم"
    },
    {
      "id": 74,
      "start": 9840.28,
      "end": 9849.28,
      "formatted_start": "02:44:00.280",
      "formatted_end": "02:44:09.280",
      "text": "فقط شیرینی جان، لیمون سبز، کش، نمیتونیم، ولی صبحی فقط شیرین"
    },
    {
      "id": 75,
      "start": 9849.28,
      "end": 9855.28,
      "formatted_start": "02:44:09.280",
      "formatted_end": "02:44:15.280",
      "text": "ایسا همون رو بگیرم، کش باید خوبه، کش بهشون رو بگیرم، چون ماست نمیخوره"
    },
    {
      "id": 76,
      "start": 9855.28,
      "end": 9859.28,
      "formatted_start": "02:44:15.280",
      "formatted_end": "02:44:19.280",
      "text": "کم کم، کم کم، که تو این همه خوشنگی ترگیرده کنی"
    },
    {
      "id": 77,
      "start": 9859.28,
      "end": 9861.78,
      "formatted_start": "02:44:19.280",
      "formatted_end": "02:44:21.780",
      "text": "این هم به تجریج مثلا صبحشون تقمه مال"
    },
    {
      "id": 78,
      "start": 9861.78,
      "end": 9863.78,
      "formatted_start": "02:44:21.780",
      "formatted_end": "02:44:23.780",
      "text": "تقمه مال یه روز در میان میدن"
    },
    {
      "id": 79,
      "start": 9863.78,
      "end": 9865.78,
      "formatted_start": "02:44:23.780",
      "formatted_end": "02:44:25.780",
      "text": "آفرین تقمه مال فریکو بخورن"
    },
    {
      "id": 80,
      "start": 9865.78,
      "end": 9867.78,
      "formatted_start": "02:44:25.780",
      "formatted_end": "02:44:27.780",
      "text": "و مثلا من براشون اوت میدارست کنم"
    },
    {
      "id": 81,
      "start": 9867.78,
      "end": 9871.78,
      "formatted_start": "02:44:27.780",
      "formatted_end": "02:44:31.780",
      "text": "آفرین که این هم مثلا چیزای من دوست دارن از این چیزا"
    },
    {
      "id": 82,
      "start": 9871.78,
      "end": 9873.78,
      "formatted_start": "02:44:31.780",
      "formatted_end": "02:44:33.780",
      "text": "مثلا جوه پردن"
    },
    {
      "id": 83,
      "start": 9873.78,
      "end": 9876.78,
      "formatted_start": "02:44:33.780",
      "formatted_end": "02:44:36.780",
      "text": "خانم دکتر صوب و مایات خوبه؟"
    },
    {
      "id": 84,
      "start": 9876.78,
      "end": 9883.28,
      "formatted_start": "02:44:36.780",
      "formatted_end": "02:44:43.280",
      "text": "این آنها از وقتی که دنیا آمده صوب، آش، هر چیزی خیلی شل مایات، به هیچ بشه"
    },
    {
      "id": 85,
      "start": 9883.28,
      "end": 9885.28,
      "formatted_start": "02:44:43.280",
      "formatted_end": "02:44:45.280",
      "text": "به هیچ بشه، هر مادری درست کردن"
    },
    {
      "id": 86,
      "start": 9885.28,
      "end": 9888.28,
      "formatted_start": "02:44:45.280",
      "formatted_end": "02:44:48.280",
      "text": "ببینی دوست داریم سمتانی و کباب بگیریم"
    },
    {
      "id": 87,
      "start": 9888.28,
      "end": 9889.28,
      "formatted_start": "02:44:48.280",
      "formatted_end": "02:44:49.280",
      "text": "نه کباب دوست داریم"
    },
    {
      "id": 88,
      "start": 9889.28,
      "end": 9890.28,
      "formatted_start": "02:44:49.280",
      "formatted_end": "02:44:50.280",
