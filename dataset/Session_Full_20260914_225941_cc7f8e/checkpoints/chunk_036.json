      "id": 60,
      "start": 11075.0,
      "end": 11077.0,
      "formatted_start": "03:04:35.000",
      "formatted_end": "03:04:37.000",
      "text": "بگو بیا"
    },
    {
      "id": 61,
      "start": 11077.0,
      "end": 11079.0,
      "formatted_start": "03:04:37.000",
      "formatted_end": "03:04:39.000",
      "text": "این دوری خالی هست؟"
    },
    {
      "id": 62,
      "start": 11079.0,
      "end": 11081.0,
      "formatted_start": "03:04:39.000",
      "formatted_end": "03:04:41.000",
      "text": "آره"
    },
    {
      "id": 63,
      "start": 11083.0,
      "end": 11085.0,
      "formatted_start": "03:04:43.000",
      "formatted_end": "03:04:45.000",
      "text": "محشد خانم دوست داره"
    },
    {
      "id": 64,
      "start": 11085.0,
      "end": 11087.0,
      "formatted_start": "03:04:45.000",
      "formatted_end": "03:04:47.000",
      "text": "محشد خانم"
    },
    {
      "id": 65,
      "start": 11087.0,
      "end": 11089.0,
      "formatted_start": "03:04:47.000",
      "formatted_end": "03:04:49.000",
      "text": "اینو من"
    },
    {
      "id": 66,
      "start": 11089.0,
      "end": 11092.86,
      "formatted_start": "03:04:49.000",
      "formatted_end": "03:04:52.860",
      "text": "مگر که خیلی اصرار می کنه"
    },
    {
      "id": 67,
      "start": 11092.86,
      "end": 11092.92,
      "formatted_start": "03:04:52.860",
      "formatted_end": "03:04:52.920",
      "text": "خیلی اصرار می کنه"
    },
    {
      "id": 68,
      "start": 11092.92,
      "end": 11097.52,
      "formatted_start": "03:04:52.920",
      "formatted_end": "03:04:57.520",
      "text": "آقای حزینی هم نیومد"
    },
    {
      "id": 69,
      "start": 11097.52,
      "end": 11098.66,
      "formatted_start": "03:04:57.520",
      "formatted_end": "03:04:58.660",
      "text": "گوشیشم"
    },
