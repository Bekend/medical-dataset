    },
    {
      "id": 54,
      "start": 11063.0,
      "end": 11065.0,
      "formatted_start": "03:04:23.000",
      "formatted_end": "03:04:25.000",
      "text": "کتاباتو بردم"
    },
    {
      "id": 55,
      "start": 11065.0,
      "end": 11067.0,
      "formatted_start": "03:04:25.000",
      "formatted_end": "03:04:27.000",
      "text": "پاندو کنید"
    },
    {
      "id": 56,
      "start": 11067.0,
      "end": 11069.0,
      "formatted_start": "03:04:27.000",
      "formatted_end": "03:04:29.000",
      "text": "آره باشه"
    },
    {
      "id": 57,
      "start": 11069.0,
      "end": 11071.0,
      "formatted_start": "03:04:29.000",
      "formatted_end": "03:04:31.000",
      "text": "خب"
    },
    {
      "id": 58,
      "start": 11071.0,
      "end": 11073.0,
      "formatted_start": "03:04:31.000",
      "formatted_end": "03:04:33.000",
      "text": "بگو چون این"
    },
    {
      "id": 59,
      "start": 11073.0,
      "end": 11075.0,
      "formatted_start": "03:04:33.000",
      "formatted_end": "03:04:35.000",
      "text": "محشد نوشته که ما را آفتن"
    },
