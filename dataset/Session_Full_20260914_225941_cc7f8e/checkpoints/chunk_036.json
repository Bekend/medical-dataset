  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10802.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:02.000",
      "text": "از اینجا باید بردارید که بزرگ شدید."
    },
    {
      "id": 1,
      "start": 10802.0,
      "end": 10804.0,
      "formatted_start": "03:00:02.000",
      "formatted_end": "03:00:04.000",
      "text": "کلس چند رو میریم سال؟"
    },
    {
      "id": 2,
      "start": 10804.0,
      "end": 10805.0,
      "formatted_start": "03:00:04.000",
      "formatted_end": "03:00:05.000",
      "text": "چهار."
    },
    {
      "id": 3,
      "start": 10805.0,
      "end": 10807.0,
      "formatted_start": "03:00:05.000",
      "formatted_end": "03:00:07.000",
      "text": "چهارون هزار ما شاید هزار بشیم."
    },
    {
      "id": 4,
      "start": 10810.0,
      "end": 10813.0,
      "formatted_start": "03:00:10.000",
      "formatted_end": "03:00:13.000",
      "text": "یک بار صحبت کن، سال رو میگیریم صدایی کلسته نگفته."
    },
    {
      "id": 5,
      "start": 10815.0,
      "end": 10816.0,
      "formatted_start": "03:00:15.000",
      "formatted_end": "03:00:16.000",
      "text": "کلسته؟"
    },
    {
      "id": 6,
      "start": 10816.0,
      "end": 10818.0,
      "formatted_start": "03:00:16.000",
      "formatted_end": "03:00:18.000",
      "text": "کلسته یه درسته."
    },
    {
      "id": 7,
      "start": 10818.0,
      "end": 10820.0,
      "formatted_start": "03:00:18.000",
      "formatted_end": "03:00:20.000",
      "text": "خب، این همه نیست."
    },
    {
      "id": 8,
      "start": 10822.0,
      "end": 10824.0,
      "formatted_start": "03:00:22.000",
      "formatted_end": "03:00:24.000",
      "text": "برای طبش هم که اصلا می نفرد،"
    },
    {
      "id": 9,
      "start": 10825.0,
      "end": 10828.0,
      "formatted_start": "03:00:25.000",
      "formatted_end": "03:00:28.000",
      "text": "هر چهار ساعت، اگر طب داشت،"
    },
    {
      "id": 10,
      "start": 10828.0,
      "end": 10830.0,
      "formatted_start": "03:00:28.000",
      "formatted_end": "03:00:30.000",
      "text": "این قرصه؟"
    },
    {
      "id": 11,
      "start": 10830.0,
      "end": 10832.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:32.000",
      "text": "یه جون سی سبیسته"
    },
    {
      "id": 12,
      "start": 10832.0,
      "end": 10834.0,
      "formatted_start": "03:00:32.000",
      "formatted_end": "03:00:34.000",
      "text": "شیاف هم نوشته این؟"
    },
    {
      "id": 13,
      "start": 10834.0,
      "end": 10836.0,
      "formatted_start": "03:00:34.000",
      "formatted_end": "03:00:36.000",
      "text": "شیاف هم برنوستن"
    },
    {
      "id": 14,
      "start": 10836.0,
      "end": 10838.0,
      "formatted_start": "03:00:36.000",
      "formatted_end": "03:00:38.000",
      "text": "شبیه هاو میبینیم"
    },
    {
      "id": 15,
      "start": 10838.0,
      "end": 10842.0,
      "formatted_start": "03:00:38.000",
      "formatted_end": "03:00:42.000",
      "text": "ما قرصه اینو نمیتونیم سریع بیاریم کنیم"
    },
    {
      "id": 16,
      "start": 10842.0,
      "end": 10846.0,
      "formatted_start": "03:00:42.000",
      "formatted_end": "03:00:46.000",
      "text": "این کود راه گیریش"
    },
    {
      "id": 17,
      "start": 10846.0,
      "end": 10850.0,
      "formatted_start": "03:00:46.000",
      "formatted_end": "03:00:50.000",
      "text": "ازافه کنم شیاف هاو"
    },
    {
      "id": 18,
      "start": 10850.0,
      "end": 10854.0,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:00:54.000",
      "text": "ما شیاف رو مجبور بشیم"
    },
    {
      "id": 19,
      "start": 10854.0,
      "end": 10856.0,
      "formatted_start": "03:00:54.000",
      "formatted_end": "03:00:56.000",
      "text": "باید بشیم استفاده باید بگم"
    },
    {
      "id": 20,
      "start": 10856.0,
      "end": 10860.0,
      "formatted_start": "03:00:56.000",
      "formatted_end": "03:01:00.000",
      "text": "سر لحظه میخوایم بیاریم"
    },
    {
      "id": 21,
      "start": 10860.0,
      "end": 10863.0,
      "formatted_start": "03:01:00.000",
      "formatted_end": "03:01:03.000",
      "text": "اشخاص داره فقط من چی شد حس خوبی نداشته باشم"
    },
    {
      "id": 22,
      "start": 10863.0,
      "end": 10866.0,
      "formatted_start": "03:01:03.000",
      "formatted_end": "03:01:06.000",
      "text": "نه نه ما هم حس خوبی نداریم خودشم هستم"
    },
    {
      "id": 23,
      "start": 10866.0,
      "end": 10869.0,
      "formatted_start": "03:01:06.000",
      "formatted_end": "03:01:09.000",
      "text": "ولی وقت مثلا نصف شبه"
    },
    {
      "id": 24,
      "start": 10869.0,
      "end": 10871.0,
      "formatted_start": "03:01:09.000",
      "formatted_end": "03:01:11.000",
      "text": "خیلی بهتر پاییدیم"
    },
    {
      "id": 25,
      "start": 10871.0,
      "end": 10874.0,
      "formatted_start": "03:01:11.000",
      "formatted_end": "03:01:14.000",
      "text": "اگه من مثلا سر کار باشه دیگه من واقعا استرس میکشم"
    },
    {
      "id": 26,
      "start": 10874.0,
      "end": 10878.0,
      "formatted_start": "03:01:14.000",
      "formatted_end": "03:01:18.000",
      "text": "خدمت شما آیده داریم اینم خود راقبی"
    },
    {
      "id": 27,
      "start": 10878.0,
      "end": 10883.0,
      "formatted_start": "03:01:18.000",
      "formatted_end": "03:01:23.000",
      "text": "و لطفا شما خانواد نمیره من منشون من نمیشنند به شما"
    },
    {
      "id": 28,
      "start": 10883.0,
      "end": 10885.0,
      "formatted_start": "03:01:23.000",
      "formatted_end": "03:01:25.000",
      "text": "نه اصلا؟"
    },
    {
      "id": 29,
      "start": 10885.0,
      "end": 10887.0,
      "formatted_start": "03:01:25.000",
      "formatted_end": "03:01:27.000",
      "text": "نه نه نه نه"
    },
    {
      "id": 30,
      "start": 10887.0,
      "end": 10889.0,
      "formatted_start": "03:01:27.000",
      "formatted_end": "03:01:29.000",
      "text": "اصلا نمیشه که"
    },
    {
      "id": 31,
      "start": 10889.0,
      "end": 10891.0,
      "formatted_start": "03:01:29.000",
      "formatted_end": "03:01:31.000",
      "text": "نه پیار داریم چرکی"
    },
    {
      "id": 32,
      "start": 10891.0,
      "end": 10893.0,
      "formatted_start": "03:01:31.000",
      "formatted_end": "03:01:33.000",
      "text": "وضعیت این ماست اصلا"
    },
    {
      "id": 33,
      "start": 10893.0,
      "end": 10895.0,
      "formatted_start": "03:01:33.000",
      "formatted_end": "03:01:35.000",
      "text": "یه سرچون خواهش میکنم"
    },
    {
      "id": 34,
      "start": 10895.0,
      "end": 10897.0,
      "formatted_start": "03:01:35.000",
      "formatted_end": "03:01:37.000",
      "text": "بسرچون"
    },
    {
      "id": 35,
      "start": 10897.0,
      "end": 10899.0,
      "formatted_start": "03:01:37.000",
      "formatted_end": "03:01:39.000",
      "text": "اینم سه تره ها"
    },
    {
      "id": 36,
      "start": 10899.0,
      "end": 10901.0,
      "formatted_start": "03:01:39.000",
      "formatted_end": "03:01:41.000",
      "text": "بزرگ شدی برای عشقم دادی؟"
    },
    {
      "id": 37,
      "start": 10901.0,
      "end": 10903.0,
      "formatted_start": "03:01:41.000",
      "formatted_end": "03:01:43.000",
      "text": "نه نه تفاهم میگو"
    },
    {
      "id": 38,
      "start": 10903.0,
      "end": 10905.0,
      "formatted_start": "03:01:43.000",
      "formatted_end": "03:01:45.000",
      "text": "چه سه دلت"
    },
    {
      "id": 39,
      "start": 10905.0,
      "end": 10907.0,
      "formatted_start": "03:01:45.000",
      "formatted_end": "03:01:47.000",
      "text": "خوش آمدی"
    },
    {
      "id": 40,
      "start": 10907.0,
      "end": 10909.0,
      "formatted_start": "03:01:47.000",
      "formatted_end": "03:01:49.000",
      "text": "خوب برقصد میده خدا من"
    },
    {
      "id": 41,
      "start": 10909.0,
      "end": 10911.0,
      "formatted_start": "03:01:49.000",
      "formatted_end": "03:01:51.000",
      "text": "آره بیزم"
    },
    {
      "id": 42,
      "start": 10911.0,
      "end": 10913.0,
      "formatted_start": "03:01:51.000",
      "formatted_end": "03:01:53.000",
      "text": "برابر شما خواهش میکنم"
    },
    {
      "id": 43,
      "start": 10913.0,
      "end": 10915.0,
      "formatted_start": "03:01:53.000",
      "formatted_end": "03:01:55.000",
      "text": "خدا خیلی مهمینم"
    },
    {
      "id": 44,
      "start": 10915.0,
      "end": 10917.0,
      "formatted_start": "03:01:55.000",
      "formatted_end": "03:01:57.000",
      "text": "اولا اشتباه نکنم"
    },
    {
      "id": 45,
      "start": 10917.0,
      "end": 10920.0,
      "formatted_start": "03:01:57.000",
      "formatted_end": "03:02:00.000",
      "text": "اون چیزی که شما تو گرفت گیری بدن همونو میگیرم برای دیگه دارون دیگه"
    },
    {
      "id": 46,
      "start": 10920.0,
      "end": 10922.0,
      "formatted_start": "03:02:00.000",
      "formatted_end": "03:02:02.000",
      "text": "آره دیگه اونو بگیرم"
    },
    {
      "id": 47,
      "start": 10922.0,
      "end": 10924.0,
      "formatted_start": "03:02:02.000",
      "formatted_end": "03:02:04.000",
      "text": "خدا خیلی مهمونم"
    },
    {
      "id": 48,
      "start": 10924.0,
      "end": 10926.0,
      "formatted_start": "03:02:04.000",
      "formatted_end": "03:02:06.000",
      "text": "برابر شما خواهش میکنم خوش آمدید خدا خیلی شکرم"
    },
    {
      "id": 49,
      "start": 10941.0,
      "end": 10947.0,
      "formatted_start": "03:02:21.000",
      "formatted_end": "03:02:27.000",
      "text": "موسیقی"
    },
    {
      "id": 50,
      "start": 10971.0,
      "end": 11000.98,
      "formatted_start": "03:02:51.000",
      "formatted_end": "03:03:20.980",
      "text": "مردم درست دارید"
    },
    {
      "id": 51,
      "start": 11001.0,
      "end": 11030.98,
      "formatted_start": "03:03:21.000",
      "formatted_end": "03:03:50.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 52,
      "start": 11031.0,
      "end": 11041.0,
      "formatted_start": "03:03:51.000",
      "formatted_end": "03:04:01.000",
      "text": "موسیقی"
    },
    {
      "id": 53,
      "start": 11061.0,
      "end": 11063.0,
      "formatted_start": "03:04:21.000",
      "formatted_end": "03:04:23.000",
