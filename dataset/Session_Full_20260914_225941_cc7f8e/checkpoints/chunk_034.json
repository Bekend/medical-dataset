      "end": 10207.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:07.000",
      "text": "از اینجوری سدای باز میاد و نمیتونم دوست نیم که تونو بخوره."
    },
    {
      "id": 1,
      "start": 10207.0,
      "end": 10213.0,
      "formatted_start": "02:50:07.000",
      "formatted_end": "02:50:13.000",
      "text": "نعم، شیر مادر خب باعث میشه نفخ و دفت بشه."
    },
    {
      "id": 2,
      "start": 10213.0,
      "end": 10215.0,
      "formatted_start": "02:50:13.000",
      "formatted_end": "02:50:15.000",
      "text": "نه، سدا میده باشه."
    },
    {
      "id": 3,
      "start": 10215.0,
      "end": 10219.0,
      "formatted_start": "02:50:15.000",
      "formatted_end": "02:50:19.000",
      "text": "چون شیر مادر سریع از مده میره چون روده."
    },
    {
      "id": 4,
      "start": 10219.0,
      "end": 10222.0,
      "formatted_start": "02:50:19.000",
      "formatted_end": "02:50:22.000",
      "text": "شیر خوش نه، شیر خوش سنگینه."
    },
    {
      "id": 5,
      "start": 10222.0,
      "end": 10225.0,
      "formatted_start": "02:50:22.000",
      "formatted_end": "02:50:25.000",
      "text": "مثلا توی مده میبونه یک صورت بد تقریه میشه."
    },
    {
      "id": 6,
      "start": 10225.0,
      "end": 10229.0,
      "formatted_start": "02:50:25.000",
      "formatted_end": "02:50:29.000",
      "text": "به خاطر همینجور زون تقریه میشه بایدش همینطور باشه."
    },
    {
      "id": 7,
      "start": 10229.0,
      "end": 10232.5,
      "formatted_start": "02:50:29.000",
      "formatted_end": "02:50:32.500",
      "text": "و من به خاطر من شیخوش گاهی میدن که عریب نشین داره"
    },
    {
      "id": 8,
      "start": 10232.5,
      "end": 10235.0,
      "formatted_start": "02:50:32.500",
      "formatted_end": "02:50:35.000",
      "text": "نه، نه، چرا عذیب بشه؟ تو من خوبه که یه رو بگیرم"
    },
    {
      "id": 9,
      "start": 10235.0,
      "end": 10237.0,
      "formatted_start": "02:50:35.000",
      "formatted_end": "02:50:37.000",
      "text": "آه، میدونم"
    },
    {
      "id": 10,
      "start": 10237.0,
      "end": 10240.0,
      "formatted_start": "02:50:37.000",
      "formatted_end": "02:50:40.000",
      "text": "آره، خب برای نفتش چی میدی دارو؟"
    },
    {
      "id": 11,
      "start": 10240.0,
      "end": 10242.0,
      "formatted_start": "02:50:40.000",
      "formatted_end": "02:50:42.000",
      "text": "چیز اهور"
    },
    {
      "id": 12,
      "start": 10242.0,
      "end": 10249.0,
      "formatted_start": "02:50:42.000",
      "formatted_end": "02:50:49.000",
      "text": "ببین این سینه شان که اینجا رو یک کمی برجسته شده، پشار ندی آه"
    },
    {
      "id": 13,
      "start": 10249.0,
      "end": 10256.0,
      "formatted_start": "02:50:49.000",
      "formatted_end": "02:50:56.000",
      "text": "آره، این یه مقدار شیر توی سینه بچه ها جرم میشه، یکی دو ماه هست و کم کم ترش داره"
    },
    {
      "id": 14,
      "start": 10256.0,
      "end": 10258.0,
      "formatted_start": "02:50:56.000",
      "formatted_end": "02:50:58.000",
      "text": "نافش هم درست میشن؟"
    },
    {
      "id": 15,
      "start": 10258.0,
      "end": 10260.0,
      "formatted_start": "02:50:58.000",
      "formatted_end": "02:51:00.000",
      "text": "این ازالت میاد و این ناخت میاد"
    },
    {
      "id": 16,
      "start": 10260.0,
      "end": 10262.0,
      "formatted_start": "02:51:00.000",
      "formatted_end": "02:51:02.000",
      "text": "این ازالت میاد و این ناخت میاد"
    },
    {
      "id": 17,
      "start": 10262.0,
      "end": 10264.0,
      "formatted_start": "02:51:02.000",
      "formatted_end": "02:51:04.000",
      "text": "وقتی بچه یه ذریعه حشت بکنه"
    },
    {
      "id": 18,
      "start": 10264.0,
      "end": 10266.0,
      "formatted_start": "02:51:04.000",
      "formatted_end": "02:51:06.000",
      "text": "این ازالت میاد"
    },
    {
      "id": 19,
      "start": 10266.0,
      "end": 10268.0,
      "formatted_start": "02:51:06.000",
      "formatted_end": "02:51:08.000",
      "text": "این ناخت میاد"
    },
    {
      "id": 20,
      "start": 10268.0,
      "end": 10270.0,
      "formatted_start": "02:51:08.000",
      "formatted_end": "02:51:10.000",
      "text": "همه چیز خوبه"
    },
    {
      "id": 21,
      "start": 10270.0,
      "end": 10272.0,
      "formatted_start": "02:51:10.000",
      "formatted_end": "02:51:12.000",
      "text": "همه چیز خوبه"
    },
    {
      "id": 22,
      "start": 10272.0,
      "end": 10274.0,
      "formatted_start": "02:51:12.000",
      "formatted_end": "02:51:14.000",
      "text": "برای نفتش من فقط دار میدم"
    },
    {
      "id": 23,
      "start": 10274.0,
      "end": 10276.0,
      "formatted_start": "02:51:14.000",
      "formatted_end": "02:51:16.000",
      "text": "ذریعه چون نگهران نباش"
    },
    {
      "id": 24,
      "start": 10276.0,
      "end": 10278.0,
      "formatted_start": "02:51:16.000",
      "formatted_end": "02:51:18.000",
      "text": "ذریعه چون نگهران نباش"
    },
    {
      "id": 25,
      "start": 10278.0,
      "end": 10280.0,
      "formatted_start": "02:51:18.000",
      "formatted_end": "02:51:20.000",
      "text": "ذریعه چون نگهران نباش"
    },
    {
      "id": 26,
      "start": 10280.0,
      "end": 10282.0,
      "formatted_start": "02:51:20.000",
      "formatted_end": "02:51:22.000",
      "text": "این یک چیز"
    },
    {
      "id": 27,
      "start": 10282.0,
      "end": 10284.0,
      "formatted_start": "02:51:22.000",
      "formatted_end": "02:51:24.000",
      "text": "این یک چیز"
    },
    {
      "id": 28,
      "start": 10284.0,
      "end": 10286.0,
      "formatted_start": "02:51:24.000",
      "formatted_end": "02:51:26.000",
      "text": "داره همه مساجرات هم اکیه"
    },
    {
      "id": 29,
      "start": 10286.0,
      "end": 10288.0,
      "formatted_start": "02:51:26.000",
      "formatted_end": "02:51:28.000",
      "text": "در آرای همون ماساج بدن اوکیه؟"
    },
    {
      "id": 30,
      "start": 10288.0,
      "end": 10290.0,
      "formatted_start": "02:51:28.000",
      "formatted_end": "02:51:30.000",
      "text": "آره آره چرکم میاد؟"
    },
    {
      "id": 31,
      "start": 10290.0,
      "end": 10294.0,
      "formatted_start": "02:51:30.000",
      "formatted_end": "02:51:34.000",
      "text": "خیلی کم زرد مثلا وقتی صبح بیدار میشه"
    },
    {
      "id": 32,
      "start": 10297.0,
      "end": 10299.0,
      "formatted_start": "02:51:37.000",
      "formatted_end": "02:51:39.000",
      "text": "اگر چرکم میاد؟"
    },
    {
      "id": 33,
      "start": 10299.0,
      "end": 10301.0,
      "formatted_start": "02:51:39.000",
      "formatted_end": "02:51:41.000",
      "text": "آره بابا پماه نمیده"
    },
    {
      "id": 34,
      "start": 10301.0,
      "end": 10305.0,
      "formatted_start": "02:51:41.000",
      "formatted_end": "02:51:45.000",
      "text": "چون پسر افراد اونم چشمش اینجوری بسیار زمانگی نخوب شده"
    },
    {
      "id": 35,
      "start": 10305.0,
      "end": 10307.0,
      "formatted_start": "02:51:45.000",
      "formatted_end": "02:51:47.000",
      "text": "آره اونم ماساج که بدی خوبش"
    },
    {
      "id": 36,
      "start": 10307.0,
      "end": 10319.0,
      "formatted_start": "02:51:47.000",
      "formatted_end": "02:51:59.000",
      "text": "برای نفرش اشاراتی بگیرم که کنه از چی داره؟"
    },
    {
      "id": 37,
      "start": 10319.0,
      "end": 10323.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:03.000",
      "text": "یه گلگلی همه ما گیریم داریم"
    },
    {
      "id": 38,
      "start": 10323.0,
      "end": 10324.0,
      "formatted_start": "02:52:03.000",
      "formatted_end": "02:52:04.000",
      "text": "آره خیلی همون"
    },
    {
      "id": 39,
      "start": 10324.0,
      "end": 10330.0,
      "formatted_start": "02:52:04.000",
      "formatted_end": "02:52:10.000",
      "text": "خب ببین داری نفرش"
    },
    {
      "id": 40,
      "start": 10330.0,
      "end": 10333.0,
      "formatted_start": "02:52:10.000",
      "formatted_end": "02:52:13.000",
      "text": "یه قطره پدیلاک نماشتن؟"
    },
    {
      "id": 41,
      "start": 10333.0,
      "end": 10337.0,
      "formatted_start": "02:52:13.000",
      "formatted_end": "02:52:17.000",
      "text": "روزی 15 قطعه شده"
    },
    {
      "id": 42,
      "start": 10337.0,
      "end": 10339.0,
      "formatted_start": "02:52:17.000",
      "formatted_end": "02:52:19.000",
      "text": "گلگیری پمکه داری؟"
    },
    {
      "id": 43,
      "start": 10339.0,
      "end": 10341.0,
      "formatted_start": "02:52:19.000",
      "formatted_end": "02:52:21.000",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 10341.0,
      "end": 10343.0,
      "formatted_start": "02:52:21.000",
      "formatted_end": "02:52:23.000",
      "text": "در صورت بیقراری"
    },
    {
      "id": 45,
      "start": 10343.0,
      "end": 10345.0,
      "formatted_start": "02:52:23.000",
      "formatted_end": "02:52:25.000",
      "text": "بهش 2.5 سی سی میگی"
    },
    {
      "id": 46,
      "start": 10345.0,
      "end": 10347.0,
      "formatted_start": "02:52:25.000",
      "formatted_end": "02:52:27.000",
      "text": "تا روزی 4"
    },
    {
      "id": 47,
      "start": 10347.0,
      "end": 10349.0,
      "formatted_start": "02:52:27.000",
      "formatted_end": "02:52:29.000",
      "text": "او 5 بار"
    },
    {
      "id": 48,
      "start": 10349.0,
      "end": 10351.0,
      "formatted_start": "02:52:29.000",
      "formatted_end": "02:52:31.000",
      "text": "میتونه"
    },
    {
      "id": 49,
      "start": 10351.0,
      "end": 10353.0,
      "formatted_start": "02:52:31.000",
      "formatted_end": "02:52:33.000",
      "text": "دیگه بقیه چیزاش خوب باشه"
    },
    {
      "id": 50,
      "start": 10353.0,
      "end": 10355.0,
      "formatted_start": "02:52:33.000",
      "formatted_end": "02:52:35.000",
      "text": "8 دو دو پیند"
    },
    {
      "id": 51,
      "start": 10355.0,
      "end": 10357.0,
      "formatted_start": "02:52:35.000",
      "formatted_end": "02:52:37.000",
      "text": "140 سایه"
    },
    {
      "id": 52,
      "start": 10357.0,
      "end": 10359.0,
      "formatted_start": "02:52:37.000",
      "formatted_end": "02:52:39.000",
      "text": "پس دردیش آزمایشون ندیم خواستی؟"
    },
    {
      "id": 53,
      "start": 10359.0,
      "end": 10361.0,
      "formatted_start": "02:52:39.000",
      "formatted_end": "02:52:41.000",
      "text": "اصلا"
    },
    {
      "id": 54,
      "start": 10361.0,
      "end": 10363.0,
      "formatted_start": "02:52:41.000",
      "formatted_end": "02:52:43.000",
      "text": "دکتر درمون کنید؟"
    },
    {
      "id": 55,
      "start": 10363.0,
      "end": 10371.48,
      "formatted_start": "02:52:43.000",
      "formatted_end": "02:52:51.480",
      "text": "نه، اونا نه، اونا دسترول اولش اون اینه که اگه یه بچه بیشتر از 15، 16، همین زرد بود به پیزاش اراده ارجاب برد"
    },
    {
      "id": 56,
      "start": 10371.48,
      "end": 10378.04,
      "formatted_start": "02:52:51.480",
      "formatted_end": "02:52:58.040",
      "text": "حالا میان اینجا، ما نگاه میکنیم، بعضیها لازم آزمایه شدید، بعضیها لازم از درگاه بذارید"
    },
    {
      "id": 57,
      "start": 10378.04,
      "end": 10385.0,
      "formatted_start": "02:52:58.040",
      "formatted_end": "02:53:05.000",
      "text": "بعضیها لازم رو بسترید کنیم، دیگه این با تشکیص ماست، ولی اونا دسترول اولش که باید ارجاب بردن"
    },
    {
      "id": 58,
      "start": 10385.0,
      "end": 10387.0,
      "formatted_start": "02:53:05.000",
      "formatted_end": "02:53:07.000",
      "text": "خواهش اومدید"
    },
    {
      "id": 59,
      "start": 10387.0,
      "end": 10417.0,
      "formatted_start": "02:53:07.000",
      "formatted_end": "02:53:37.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 60,
      "start": 10417.0,
      "end": 10419.0,
      "formatted_start": "02:53:37.000",
      "formatted_end": "02:53:39.000",
      "text": "سارا هیدری"
    },
    {
      "id": 61,
      "start": 10419.0,
      "end": 10421.0,
      "formatted_start": "02:53:39.000",
      "formatted_end": "02:53:41.000",
      "text": "بیا بیا بیا"
    },
    {
      "id": 62,
      "start": 10421.0,
      "end": 10423.0,
      "formatted_start": "02:53:41.000",
      "formatted_end": "02:53:43.000",
      "text": "بیا بیا با اینجا"
    },
    {
      "id": 63,
      "start": 10423.0,
      "end": 10425.0,
      "formatted_start": "02:53:43.000",
      "formatted_end": "02:53:45.000",
      "text": "بیا بیا بیا بیا"
    },
    {
      "id": 64,
      "start": 10425.0,
      "end": 10427.0,
      "formatted_start": "02:53:45.000",
      "formatted_end": "02:53:47.000",
      "text": "چرا؟"
    },
    {
      "id": 65,
      "start": 10427.0,
      "end": 10429.0,
      "formatted_start": "02:53:47.000",
      "formatted_end": "02:53:49.000",
      "text": "برم"
    },
    {
      "id": 66,
      "start": 10429.0,
      "end": 10431.0,
      "formatted_start": "02:53:49.000",
      "formatted_end": "02:53:51.000",
      "text": "سلام سارا جانا"
    },
    {
      "id": 67,
      "start": 10431.0,
      "end": 10433.0,
      "formatted_start": "02:53:51.000",
      "formatted_end": "02:53:53.000",
      "text": "فراموش خوبه؟"
    },
    {
      "id": 68,
      "start": 10433.0,
      "end": 10435.0,
      "formatted_start": "02:53:53.000",
      "formatted_end": "02:53:55.000",
      "text": "ممنون شما خوبی؟"
    },
    {
      "id": 69,
      "start": 10435.0,
      "end": 10437.0,
      "formatted_start": "02:53:55.000",
      "formatted_end": "02:53:57.000",
      "text": "مرسی ممنون"
    },
    {
      "id": 70,
      "start": 10437.0,
      "end": 10439.0,
      "formatted_start": "02:53:57.000",
      "formatted_end": "02:53:59.000",
      "text": "سلام خوبی؟"
    },
    {
      "id": 71,
      "start": 10439.0,
      "end": 10441.0,
      "formatted_start": "02:53:59.000",
      "formatted_end": "02:54:01.000",
      "text": "چرا؟"
    },
    {
      "id": 72,
      "start": 10441.0,
      "end": 10443.0,
      "formatted_start": "02:54:01.000",
      "formatted_end": "02:54:03.000",
      "text": "چرا صدا درد میاد؟"
    },
    {
      "id": 73,
      "start": 10443.0,
      "end": 10445.0,
      "formatted_start": "02:54:03.000",
      "formatted_end": "02:54:05.000",
      "text": "درد؟"
    },
    {
      "id": 74,
      "start": 10445.0,
      "end": 10447.0,
      "formatted_start": "02:54:05.000",
      "formatted_end": "02:54:07.000",
      "text": "آه درشو نبینم بزرگ"
    },
    {
      "id": 75,
      "start": 10449.0,
      "end": 10450.0,
      "formatted_start": "02:54:09.000",
      "formatted_end": "02:54:10.000",
      "text": "چی شده آقایی؟"
    },
    {
      "id": 76,
      "start": 10450.0,
      "end": 10452.0,
      "formatted_start": "02:54:10.000",
      "formatted_end": "02:54:12.000",
      "text": "اولا دیشب پپ کرد"
    },
    {
      "id": 77,
      "start": 10452.0,
      "end": 10459.0,
      "formatted_start": "02:54:12.000",
      "formatted_end": "02:54:19.000",
      "text": "و ما با همون شروط تبری که داشت یه خورتبشو کنترل کردیم"
    },
    {
      "id": 78,
      "start": 10459.0,
      "end": 10462.0,
      "formatted_start": "02:54:19.000",
      "formatted_end": "02:54:22.000",
      "text": "و فقط آنو علایم تبرو داشت"
    },
    {
      "id": 79,
      "start": 10462.0,
      "end": 10467.0,
      "formatted_start": "02:54:22.000",
      "formatted_end": "02:54:27.000",
      "text": "بعد شبم که خوابید مامانش یه شیافم گذاشت شروطم داده هم چهار ساعتی"
    },
    {
      "id": 80,
      "start": 10467.0,
      "end": 10473.0,
      "formatted_start": "02:54:27.000",
      "formatted_end": "02:54:33.000",
      "text": "بدن حمز هم اینجوریه یا بعد تبه میاد با دارون میره دوباره میاد"
    },
    {
      "id": 81,
      "start": 10473.0,
      "end": 10477.4,
      "formatted_start": "02:54:33.000",
      "formatted_end": "02:54:37.400",
