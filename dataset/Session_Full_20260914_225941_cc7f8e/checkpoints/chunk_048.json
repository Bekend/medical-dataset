      "start": 14652.92,
      "end": 14673.92,
      "formatted_start": "04:04:12.920",
      "formatted_end": "04:04:33.920",
      "text": "موسیقی"
    },
    {
      "id": 85,
      "start": 14673.92,
      "end": 14676.02,
      "formatted_start": "04:04:33.920",
      "formatted_end": "04:04:36.020",
      "text": "خواب چنگی رو باید؟"
    },
    {
      "id": 86,
      "start": 14676.02,
      "end": 14677.36,
      "formatted_start": "04:04:36.020",
      "formatted_end": "04:04:37.360",
