      "end": 14514.0,
      "formatted_start": "04:01:52.000",
      "formatted_end": "04:01:54.000",
      "text": "بیا سازان"
    },
    {
      "id": 43,
      "start": 14514.0,
      "end": 14543.98,
      "formatted_start": "04:01:54.000",
      "formatted_end": "04:02:23.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 44,
      "start": 14544.0,
      "end": 14555.04,
      "formatted_start": "04:02:24.000",
      "formatted_end": "04:02:35.040",
      "text": "این قبلنها سرشون شپش براش"
    },
    {
      "id": 45,
      "start": 14555.04,
      "end": 14556.04,
      "formatted_start": "04:02:35.040",
      "formatted_end": "04:02:36.040",
      "text": "چرا؟"
    },
    {
      "id": 46,
      "start": 14556.04,
      "end": 14557.78,
      "formatted_start": "04:02:36.040",
      "formatted_end": "04:02:37.780",
      "text": "من دارو بهت دادم"
    },
    {
      "id": 47,
      "start": 14557.78,
      "end": 14559.92,
      "formatted_start": "04:02:37.780",
      "formatted_end": "04:02:39.920",
      "text": "نه بخواهی شپش نباشی"
    },
    {
      "id": 48,
      "start": 14559.92,
      "end": 14560.72,
      "formatted_start": "04:02:39.920",
      "formatted_end": "04:02:40.720",
      "text": "نه باشی"
    },
    {
      "id": 49,
      "start": 14560.72,
      "end": 14562.4,
      "formatted_start": "04:02:40.720",
      "formatted_end": "04:02:42.400",
      "text": "خب بگیر از دقیقی"
    },
    {
      "id": 50,
      "start": 14562.4,
      "end": 14564.3,
      "formatted_start": "04:02:42.400",
      "formatted_end": "04:02:44.300",
      "text": "سرش پره بشه"
    },
    {
      "id": 51,
      "start": 14564.3,
      "end": 14567.66,
      "formatted_start": "04:02:44.300",
      "formatted_end": "04:02:47.660",
      "text": "چرا اینو افنات میکنه؟"
    },
    {
      "id": 52,
      "start": 14567.66,
      "end": 14569.34,
      "formatted_start": "04:02:47.660",
      "formatted_end": "04:02:49.340",
      "text": "به خاطر اینکه شپش میاد"
    },
    {
      "id": 53,
      "start": 14569.34,
      "end": 14571.38,
      "formatted_start": "04:02:49.340",
      "formatted_end": "04:02:51.380",
      "text": "پوستو سراخ میکنه"
    },
    {
      "id": 54,
      "start": 14571.38,
      "end": 14574.38,
      "formatted_start": "04:02:51.380",
      "formatted_end": "04:02:54.380",
      "text": "از خون تقلیل می کنه"
    },
    {
      "id": 55,
      "start": 14574.38,
      "end": 14575.38,
      "formatted_start": "04:02:54.380",
      "formatted_end": "04:02:55.380",
      "text": "خب؟"
    },
    {
      "id": 56,
      "start": 14575.38,
      "end": 14578.38,
      "formatted_start": "04:02:55.380",
      "formatted_end": "04:02:58.380",
      "text": "بعد حالا این شپش آلوده بوده"
    },
    {
      "id": 57,
      "start": 14578.38,
      "end": 14581.38,
      "formatted_start": "04:02:58.380",
      "formatted_end": "04:03:01.380",
      "text": "یا این خارونده سرش آلوده بوده"
    },
    {
      "id": 58,
      "start": 14581.38,
      "end": 14582.38,
      "formatted_start": "04:03:01.380",
      "formatted_end": "04:03:02.380",
      "text": "خب؟"
    },
    {
      "id": 59,
      "start": 14582.38,
      "end": 14584.38,
      "formatted_start": "04:03:02.380",
      "formatted_end": "04:03:04.380",
      "text": "بعد اینجا چی شده؟ زخم شده و افونت کرده"
    },
    {
      "id": 60,
      "start": 14584.38,
      "end": 14586.38,
      "formatted_start": "04:03:04.380",
      "formatted_end": "04:03:06.380",
      "text": "به این میگن زرد زخم"
    },
    {
      "id": 61,
      "start": 14586.38,
      "end": 14588.38,
      "formatted_start": "04:03:06.380",
      "formatted_end": "04:03:08.380",
      "text": "شما باید زرد زخمشو درمان کنید"
    },
    {
      "id": 62,
      "start": 14588.38,
      "end": 14591.38,
      "formatted_start": "04:03:08.380",
      "formatted_end": "04:03:11.380",
      "text": "و حتما باید براش"
    },
    {
      "id": 63,
      "start": 14591.38,
      "end": 14594.38,
      "formatted_start": "04:03:11.380",
      "formatted_end": "04:03:14.380",
      "text": "دارو واسه یهتیتشون استفاده بکنید"
    },
    {
      "id": 64,
      "start": 14594.38,
      "end": 14596.38,
      "formatted_start": "04:03:14.380",
      "formatted_end": "04:03:16.380",
      "text": "وگرنه این خوب باشه دوباره بکنید"
    },
    {
      "id": 65,
      "start": 14596.38,
      "end": 14597.38,
      "formatted_start": "04:03:16.380",
      "formatted_end": "04:03:17.380",
      "text": "خب؟"
    },
    {
      "id": 66,
      "start": 14597.38,
      "end": 14598.38,
      "formatted_start": "04:03:17.380",
      "formatted_end": "04:03:18.380",
      "text": "بیاییم آن شما رو ببینم"
    },
    {
      "id": 67,
      "start": 14598.38,
      "end": 14601.84,
      "formatted_start": "04:03:18.380",
      "formatted_end": "04:03:21.840",
      "text": "خب بیاسی اینجور بیشتر لازم نداشت خب؟"
    },
    {
      "id": 68,
      "start": 14601.84,
      "end": 14606.92,
      "formatted_start": "04:03:21.840",
      "formatted_end": "04:03:26.920",
      "text": "چون که خانه ازش نشون داد که دوتا سرشون اینجوری شده"
    },
    {
      "id": 69,
      "start": 14606.92,
      "end": 14608.92,
      "formatted_start": "04:03:26.920",
      "formatted_end": "04:03:28.920",
      "text": "گفتم بخوا بیار ببینم"
    },
    {
      "id": 70,
      "start": 14608.92,
      "end": 14610.92,
      "formatted_start": "04:03:28.920",
      "formatted_end": "04:03:30.920",
      "text": "اینجوری شده؟"
    },
    {
      "id": 71,
      "start": 14610.92,
      "end": 14612.92,
      "formatted_start": "04:03:30.920",
      "formatted_end": "04:03:32.920",
      "text": "اینجوری شده"
    },
    {
      "id": 72,
      "start": 14612.92,
      "end": 14616.92,
      "formatted_start": "04:03:32.920",
      "formatted_end": "04:03:36.920",
      "text": "اینجوری شده دیروز رفت بیرون بازی کرد اومد اینجوری رفت"
    },
    {
      "id": 73,
      "start": 14616.92,
      "end": 14618.92,
      "formatted_start": "04:03:36.920",
      "formatted_end": "04:03:38.920",
      "text": "آه پشت زده"
    },
    {
      "id": 74,
      "start": 14618.92,
      "end": 14620.92,
      "formatted_start": "04:03:38.920",
      "formatted_end": "04:03:40.920",
      "text": "پشت زده"
    },
    {
      "id": 75,
      "start": 14620.92,
      "end": 14622.92,
      "formatted_start": "04:03:40.920",
      "formatted_end": "04:03:42.920",
      "text": "این هم سرشون"
    },
    {
      "id": 76,
      "start": 14622.92,
      "end": 14624.92,
      "formatted_start": "04:03:42.920",
      "formatted_end": "04:03:44.920",
      "text": "برنامه های اینجا همینه بیشتر برداشت"
    },
    {
      "id": 77,
      "start": 14624.92,
      "end": 14626.92,
      "formatted_start": "04:03:44.920",
      "formatted_end": "04:03:46.920",
      "text": "برنامه های اینجا همینه بیشتر برداشت"
    },
    {
      "id": 78,
      "start": 14626.92,
      "end": 14628.92,
      "formatted_start": "04:03:46.920",
      "formatted_end": "04:03:48.920",
      "text": "برنامه های اینجا همینه بیشتر برداشت"
    },
    {
      "id": 79,
      "start": 14628.92,
      "end": 14630.92,
      "formatted_start": "04:03:48.920",
      "formatted_end": "04:03:50.920",
      "text": "برنامه های اینجا همینه بیشتر برداشت"
    },
