      "start": 12279.2,
      "end": 12281.2,
      "formatted_start": "03:24:39.200",
      "formatted_end": "03:24:41.200",
      "text": "برگرد بکنی آره باید"
    },
    {
      "id": 81,
      "start": 12281.2,
      "end": 12283.2,
      "formatted_start": "03:24:41.200",
      "formatted_end": "03:24:43.200",
      "text": "برم بخلیم"
    },
    {
      "id": 82,
      "start": 12283.2,
      "end": 12284.2,
      "formatted_start": "03:24:43.200",
      "formatted_end": "03:24:44.200",
      "text": "برم بخلیم"
    },
    {
