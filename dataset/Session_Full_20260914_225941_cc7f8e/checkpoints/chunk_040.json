  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12012.2,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:12.200",
      "text": "بچه ها رو خورد، نفق شکماشون و داله ها و بزرگاشون، همه از دفعه اون در روز که شروع میشه، بدتر میشه، یه روز به روز بدتر میشه، پر دو ماهگی."
    },
    {
      "id": 1,
      "start": 12012.2,
      "end": 12017.2,
      "formatted_start": "03:20:12.200",
      "formatted_end": "03:20:17.200",
      "text": "از دو ماهگی روز به روز بهترشن، یکی معمولاً سه ماه بشن، خوبشن."
    },
    {
      "id": 2,
      "start": 12017.2,
      "end": 12021.2,
      "formatted_start": "03:20:17.200",
      "formatted_end": "03:20:21.200",
      "text": "بعد اینجور که خیلی هم جیب و دارد و بیقراره، من این کارم."
    },
    {
      "id": 3,
      "start": 12021.2,
      "end": 12025.2,
      "formatted_start": "03:20:21.200",
      "formatted_end": "03:20:25.200",
      "text": "فقط باز آراخ زندگیش، باید این موقع ها بخواب صرفه میکنه."
    },
    {
      "id": 4,
      "start": 12025.2,
      "end": 12029.2,
      "formatted_start": "03:20:25.200",
      "formatted_end": "03:20:29.200",
      "text": "اونو بخواد اینکه شیر میاد گالا گلوش یه دفعه به طرف میاخده"
    },
    {
      "id": 5,
      "start": 12029.2,
      "end": 12031.7,
      "formatted_start": "03:20:29.200",
      "formatted_end": "03:20:31.700",
      "text": "این هم اشغال نداره بخواد به پلاکتش رو"
    },
    {
      "id": 6,
      "start": 12031.7,
      "end": 12034.2,
      "formatted_start": "03:20:31.700",
      "formatted_end": "03:20:34.200",
      "text": "خیلی عدو از چرای پلاکت رو دارم کن"
    },
    {
      "id": 7,
      "start": 12034.2,
      "end": 12037.2,
      "formatted_start": "03:20:34.200",
      "formatted_end": "03:20:37.200",
      "text": "وقتی که میخواید بخوابونید اینه دوشنگشی"
    },
    {
      "id": 8,
      "start": 12037.2,
      "end": 12039.2,
      "formatted_start": "03:20:37.200",
      "formatted_end": "03:20:39.200",
      "text": "یه بالش بگذار"
    },
    {
      "id": 9,
      "start": 12039.2,
      "end": 12040.2,
      "formatted_start": "03:20:39.200",
      "formatted_end": "03:20:40.200",
      "text": "اوه چونو شیف دارش"
    },
    {
      "id": 10,
      "start": 12040.2,
      "end": 12042.2,
      "formatted_start": "03:20:40.200",
      "formatted_end": "03:20:42.200",
      "text": "اینه که شیف دار بخوابه"
    },
    {
      "id": 11,
      "start": 12042.2,
      "end": 12045.2,
      "formatted_start": "03:20:42.200",
      "formatted_end": "03:20:45.200",
      "text": "و بعد از اینکه شیر خور آراغشو بگیر"
    },
    {
      "id": 12,
      "start": 12045.2,
      "end": 12046.2,
      "formatted_start": "03:20:45.200",
      "formatted_end": "03:20:46.200",
      "text": "بعد بخوابونش"
    },
    {
      "id": 13,
      "start": 12046.2,
      "end": 12049.2,
      "formatted_start": "03:20:46.200",
      "formatted_end": "03:20:49.200",
      "text": "یک کم کم همشش کتشه"
    },
    {
      "id": 14,
      "start": 12049.2,
      "end": 12051.2,
      "formatted_start": "03:20:49.200",
      "formatted_end": "03:20:51.200",
      "text": "این پترما براش می‌نویستم."
    },
    {
      "id": 15,
      "start": 12051.2,
      "end": 12053.2,
      "formatted_start": "03:20:51.200",
      "formatted_end": "03:20:53.200",
      "text": "باشه؟"
    },
    {
      "id": 16,
      "start": 12053.2,
      "end": 12055.2,
      "formatted_start": "03:20:53.200",
      "formatted_end": "03:20:55.200",
      "text": "باشه؟"
    },
    {
      "id": 17,
      "start": 12055.2,
      "end": 12057.2,
      "formatted_start": "03:20:55.200",
      "formatted_end": "03:20:57.200",
      "text": "باید برداریم"
    },
    {
      "id": 18,
      "start": 12057.2,
      "end": 12059.2,
      "formatted_start": "03:20:57.200",
      "formatted_end": "03:20:59.200",
      "text": "باید برداریم"
    },
    {
      "id": 19,
      "start": 12079.2,
      "end": 12081.2,
      "formatted_start": "03:21:19.200",
      "formatted_end": "03:21:21.200",
      "text": "باید برداریم"
    },
    {
      "id": 20,
      "start": 12081.2,
      "end": 12083.2,
      "formatted_start": "03:21:21.200",
      "formatted_end": "03:21:23.200",
      "text": "چون هر رو چیزی بگیرین"
    },
    {
      "id": 21,
      "start": 12083.2,
      "end": 12085.2,
      "formatted_start": "03:21:23.200",
      "formatted_end": "03:21:25.200",
      "text": "یعنی ماهی دو ساعت اضافه باشیم"
    },
    {
      "id": 22,
      "start": 12085.2,
      "end": 12087.2,
      "formatted_start": "03:21:25.200",
      "formatted_end": "03:21:27.200",
      "text": "مترکیم"
    },
    {
      "id": 23,
      "start": 12103.2,
      "end": 12105.2,
      "formatted_start": "03:21:43.200",
      "formatted_end": "03:21:45.200",
      "text": "آه بردی شیر خوش ادامه بدیده"
    },
    {
      "id": 24,
      "start": 12105.2,
      "end": 12107.2,
      "formatted_start": "03:21:45.200",
      "formatted_end": "03:21:47.200",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 12107.2,
      "end": 12109.2,
      "formatted_start": "03:21:47.200",
      "formatted_end": "03:21:49.200",
      "text": "وقتی دارم بگیم"
    },
    {
      "id": 26,
      "start": 12109.2,
      "end": 12111.2,
      "formatted_start": "03:21:49.200",
      "formatted_end": "03:21:51.200",
      "text": "شیر خوش قیده هم نمیشه. حالا همه درگیره"
    },
    {
      "id": 27,
      "start": 12111.2,
      "end": 12113.2,
      "formatted_start": "03:21:51.200",
      "formatted_end": "03:21:53.200",
      "text": "همینو برو به خود. بازم سر همین"
    },
    {
      "id": 28,
      "start": 12113.2,
      "end": 12115.2,
      "formatted_start": "03:21:53.200",
      "formatted_end": "03:21:55.200",
      "text": "اصلا مادران"
    },
    {
      "id": 29,
      "start": 12115.2,
      "end": 12117.2,
      "formatted_start": "03:21:55.200",
      "formatted_end": "03:21:57.200",
      "text": "قبل اینکه زایبان کنن"
    },
    {
      "id": 30,
      "start": 12117.2,
      "end": 12119.2,
      "formatted_start": "03:21:57.200",
      "formatted_end": "03:21:59.200",
      "text": "میاد اینجا میاد که شیر خوش برود شده"
    },
    {
      "id": 31,
      "start": 12119.2,
      "end": 12121.2,
      "formatted_start": "03:21:59.200",
      "formatted_end": "03:22:01.200",
      "text": "ببینیم"
    },
    {
      "id": 32,
      "start": 12121.2,
      "end": 12123.2,
      "formatted_start": "03:22:01.200",
      "formatted_end": "03:22:03.200",
      "text": "نه خدا شد. من شیر خوبم"
    },
    {
      "id": 33,
      "start": 12139.2,
      "end": 12141.2,
      "formatted_start": "03:22:19.200",
