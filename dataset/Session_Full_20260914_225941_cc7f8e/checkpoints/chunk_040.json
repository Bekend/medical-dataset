      "end": 12167.2,
      "formatted_start": "03:22:45.200",
      "formatted_end": "03:22:47.200",
      "text": "خیلی خوب"
    },
    {
      "id": 47,
      "start": 12167.2,
      "end": 12173.2,
      "formatted_start": "03:22:47.200",
      "formatted_end": "03:22:53.200",
      "text": "در صورت بی قراری بهش دونه سو سیده"
    },
    {
      "id": 48,
      "start": 12173.2,
      "end": 12177.2,
      "formatted_start": "03:22:53.200",
      "formatted_end": "03:22:57.200",
      "text": "تا روزی چهار الا پنج بار هم می چوند"
    },
    {
      "id": 49,
      "start": 12177.2,
      "end": 12180.2,
      "formatted_start": "03:22:57.200",
      "formatted_end": "03:23:00.200",
      "text": "اگه خیلی می پید چیز خیلی زور بزن بشوند"
    },
    {
      "id": 50,
      "start": 12180.2,
      "end": 12182.2,
      "formatted_start": "03:23:00.200",
      "formatted_end": "03:23:02.200",
      "text": "همکار بهتر می شود"
    },
    {
      "id": 51,
      "start": 12182.2,
      "end": 12185.2,
      "formatted_start": "03:23:02.200",
      "formatted_end": "03:23:05.200",
      "text": "اگه هم یکی هم یکی یاروار مختلف بشوند بخواهد"
    },
    {
      "id": 52,
      "start": 12185.2,
      "end": 12188.2,
      "formatted_start": "03:23:05.200",
      "formatted_end": "03:23:08.200",
      "text": "شست و چهار سی سن و پنج روی"
    },
    {
      "id": 53,
      "start": 12188.2,
      "end": 12190.2,
      "formatted_start": "03:23:08.200",
      "formatted_end": "03:23:10.200",
      "text": "خودت شیر گام"
    },
    {
      "id": 54,
      "start": 12190.2,
      "end": 12192.2,
      "formatted_start": "03:23:10.200",
      "formatted_end": "03:23:12.200",
      "text": "نه نه اونو رو اصلا اصلا بگویم"
    },
    {
      "id": 55,
      "start": 12192.2,
      "end": 12194.2,
      "formatted_start": "03:23:12.200",
      "formatted_end": "03:23:14.200",
      "text": "آره خامه بستنگی"
    },
    {
      "id": 56,
      "start": 12194.2,
      "end": 12196.2,
      "formatted_start": "03:23:14.200",
      "formatted_end": "03:23:16.200",
      "text": "اصلا لبنیات گامی نیمی خورد"
    },
    {
      "id": 57,
      "start": 12196.2,
      "end": 12199.2,
      "formatted_start": "03:23:16.200",
      "formatted_end": "03:23:19.200",
      "text": "ببین ماست و پنیر اونو بازارو ها؟"
    },
    {
      "id": 58,
      "start": 12199.2,
      "end": 12200.2,
      "formatted_start": "03:23:19.200",
      "formatted_end": "03:23:20.200",
      "text": "نخوردم"
    },
    {
      "id": 59,
      "start": 12200.2,
      "end": 12201.2,
      "formatted_start": "03:23:20.200",
      "formatted_end": "03:23:21.200",
      "text": "خوب خوردم"
    },
    {
      "id": 60,
      "start": 12201.2,
      "end": 12202.2,
      "formatted_start": "03:23:21.200",
      "formatted_end": "03:23:22.200",
      "text": "ولی اینها رو نخو"
    },
    {
      "id": 61,
      "start": 12202.2,
      "end": 12216.2,
      "formatted_start": "03:23:22.200",
      "formatted_end": "03:23:36.200",
      "text": "بعد لبنچه، تبوبات، نشابه گازدار، کلم، فرفر ضلمه، و بادور و مینی"
    },
    {
      "id": 62,
      "start": 12216.2,
      "end": 12217.2,
      "formatted_start": "03:23:36.200",
      "formatted_end": "03:23:37.200",
      "text": "این هم رو نخوردم"
    },
    {
      "id": 63,
      "start": 12217.2,
      "end": 12218.2,
      "formatted_start": "03:23:37.200",
      "formatted_end": "03:23:38.200",
      "text": "بادور و مینی دوست داری؟"
    },
    {
      "id": 64,
      "start": 12218.2,
      "end": 12221.2,
      "formatted_start": "03:23:38.200",
      "formatted_end": "03:23:41.200",
      "text": "دوست نداری؟ خب بیا زن"
    },
    {
      "id": 65,
      "start": 12221.2,
      "end": 12223.2,
      "formatted_start": "03:23:41.200",
      "formatted_end": "03:23:43.200",
      "text": "این هم کود راحت کرده شد"
    },
    {
      "id": 66,
      "start": 12223.2,
      "end": 12227.2,
      "formatted_start": "03:23:43.200",
      "formatted_end": "03:23:47.200",
      "text": "خوش آمدید. خداحبزدین با خدا."
    },
    {
      "id": 67,
      "start": 12227.2,
      "end": 12251.2,
      "formatted_start": "03:23:47.200",
      "formatted_end": "03:24:11.200",
      "text": "موسیقی"
    },
    {
      "id": 68,
      "start": 12251.2,
      "end": 12255.2,
      "formatted_start": "03:24:11.200",
      "formatted_end": "03:24:15.200",
      "text": "فلا باشه تو خدا شده خودی"
    },
    {
      "id": 69,
      "start": 12255.2,
      "end": 12259.2,
      "formatted_start": "03:24:15.200",
      "formatted_end": "03:24:19.200",
      "text": "ای چونه دلن"
    },
    {
      "id": 70,
      "start": 12259.2,
      "end": 12261.2,
      "formatted_start": "03:24:19.200",
      "formatted_end": "03:24:21.200",
      "text": "خوش سرگه من"
    },
    {
      "id": 71,
      "start": 12261.2,
      "end": 12263.2,
      "formatted_start": "03:24:21.200",
      "formatted_end": "03:24:23.200",
      "text": "خوبه از شما"
    },
    {
      "id": 72,
      "start": 12263.2,
      "end": 12265.2,
      "formatted_start": "03:24:23.200",
      "formatted_end": "03:24:25.200",
      "text": "ای چونه دلن"
    },
    {
      "id": 73,
      "start": 12265.2,
      "end": 12267.2,
      "formatted_start": "03:24:25.200",
      "formatted_end": "03:24:27.200",
      "text": "تو حسن خوش سرگه"
    },
    {
      "id": 74,
      "start": 12267.2,
      "end": 12269.2,
      "formatted_start": "03:24:27.200",
      "formatted_end": "03:24:29.200",
      "text": "ای چونه دلن"
    },
    {
      "id": 75,
      "start": 12269.2,
      "end": 12271.2,
      "formatted_start": "03:24:29.200",
      "formatted_end": "03:24:31.200",
      "text": "یعنی یه اکس بود یه چونه لایه یه دونه"
    },
    {
      "id": 76,
      "start": 12271.2,
      "end": 12273.2,
      "formatted_start": "03:24:31.200",
      "formatted_end": "03:24:33.200",
      "text": "هلن هلن"
    },
    {
      "id": 77,
      "start": 12273.2,
      "end": 12275.2,
      "formatted_start": "03:24:33.200",
      "formatted_end": "03:24:35.200",
      "text": "خیلی"
    },
    {
      "id": 78,
      "start": 12275.2,
      "end": 12277.2,
      "formatted_start": "03:24:35.200",
      "formatted_end": "03:24:37.200",
      "text": "جگره"
    },
    {
      "id": 79,
      "start": 12277.2,
      "end": 12279.2,
      "formatted_start": "03:24:37.200",
      "formatted_end": "03:24:39.200",
      "text": "جگری"
    },
    {
