      "formatted_start": "03:24:44.200",
      "formatted_end": "03:24:45.200",
      "text": "بگی آریا برم"
    },
    {
      "id": 84,
      "start": 12285.2,
      "end": 12287.2,
      "formatted_start": "03:24:45.200",
      "formatted_end": "03:24:47.200",
      "text": "ای خدا"
    },
    {
