  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7229.98,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:29.980",
      "text": "از اینجا، بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 7230.0,
      "end": 7231.0,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:31.000",
      "text": "چرا؟"
    },
    {
      "id": 2,
      "start": 7231.0,
      "end": 7233.0,
      "formatted_start": "02:00:31.000",
      "formatted_end": "02:00:33.000",
      "text": "آزمایشم رو محسله می آره"
    },
    {
      "id": 3,
      "start": 7233.0,
      "end": 7235.0,
      "formatted_start": "02:00:33.000",
      "formatted_end": "02:00:35.000",
      "text": "فامل اون رو بره می گه"
    },
    {
      "id": 4,
      "start": 7235.0,
      "end": 7237.0,
      "formatted_start": "02:00:35.000",
      "formatted_end": "02:00:37.000",
      "text": "من فرستم شپا"
    },
    {
      "id": 5,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "پس می رویم به شیوانی بیشه"
    },
    {
      "id": 6,
      "start": 7244.0,
      "end": 7246.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:46.000",
      "text": "شیوانی رو پوستن"
    },
    {
      "id": 7,
      "start": 7246.0,
      "end": 7248.0,
      "formatted_start": "02:00:46.000",
      "formatted_end": "02:00:48.000",
      "text": "پس اصلا می رویم به شیوانی بیشه"
    },
    {
      "id": 8,
      "start": 7248.0,
      "end": 7249.0,
      "formatted_start": "02:00:48.000",
      "formatted_end": "02:00:49.000",
      "text": "شیوانی رو بیشه"
    },
    {
      "id": 9,
      "start": 7249.0,
      "end": 7251.0,
      "formatted_start": "02:00:49.000",
      "formatted_end": "02:00:51.000",
      "text": "فرستم شپا از من تکنه من رو که پوستن"
    },
    {
      "id": 10,
      "start": 7252.0,
      "end": 7254.0,
      "formatted_start": "02:00:52.000",
      "formatted_end": "02:00:54.000",
      "text": "نمی خواستم برسنم شپا"
    },
    {
      "id": 11,
      "start": 7254.0,
      "end": 7255.0,
      "formatted_start": "02:00:54.000",
      "formatted_end": "02:00:55.000",
      "text": "یه گفتم کجا برم؟"
    },
    {
      "id": 12,
      "start": 7255.0,
      "end": 7257.0,
      "formatted_start": "02:00:55.000",
      "formatted_end": "02:00:57.000",
      "text": "می گفت نمی خواستم برای تکریم بود"
    },
    {
      "id": 13,
      "start": 7257.0,
      "end": 7259.0,
      "formatted_start": "02:00:57.000",
      "formatted_end": "02:00:59.000",
      "text": "گفتم برو سرد بشم شپا اینجا"
    },
    {
      "id": 14,
      "start": 7260.0,
      "end": 7265.24,
      "formatted_start": "02:01:00.000",
      "formatted_end": "02:01:05.240",
      "text": "چشم که ترلمان ها اینجوری دستواج میکنن زنده دوم میشن"
    },
    {
      "id": 15,
      "start": 7265.24,
      "end": 7269.64,
      "formatted_start": "02:01:05.240",
      "formatted_end": "02:01:09.640",
      "text": "بقیه اینجوری از تحکم درمت شدن"
    },
    {
      "id": 16,
      "start": 7269.64,
      "end": 7273.22,
      "formatted_start": "02:01:09.640",
      "formatted_end": "02:01:13.220",
      "text": "چقدر تحکمش هم به همچنین محسدگی هم نیخورد"
    },
    {
      "id": 17,
      "start": 7273.22,
      "end": 7275.3,
      "formatted_start": "02:01:13.220",
      "formatted_end": "02:01:15.300",
      "text": "تیپ لباس پشیدن و چیزش"
    },
    {
      "id": 18,
      "start": 7275.3,
      "end": 7280.1,
      "formatted_start": "02:01:15.300",
      "formatted_end": "02:01:20.100",
      "text": "تیپ لباس پشیدن و هجابش"
    },
    {
      "id": 19,
      "start": 7280.1,
      "end": 7281.34,
      "formatted_start": "02:01:20.100",
      "formatted_end": "02:01:21.340",
      "text": "هجابش آخ برم"
    },
    {
      "id": 20,
      "start": 7281.34,
      "end": 7284.0,
      "formatted_start": "02:01:21.340",
      "formatted_end": "02:01:24.000",
      "text": "شاید از این آقایی که شاید خوشی برم"
    },
    {
      "id": 21,
      "start": 7284.0,
      "end": 7286.48,
      "formatted_start": "02:01:24.000",
      "formatted_end": "02:01:26.480",
      "text": "نه نه شاید شاید خوشی برم"
    },
    {
      "id": 22,
      "start": 7286.48,
      "end": 7290.48,
      "formatted_start": "02:01:26.480",
      "formatted_end": "02:01:30.480",
      "text": "حالا الانو نمیدونم اون موقعی جوون بود میومد اینجا"
    },
    {
      "id": 23,
      "start": 7290.48,
      "end": 7295.48,
      "formatted_start": "02:01:30.480",
      "formatted_end": "02:01:35.480",
      "text": "بفرمایی سلام تنطوب چطوره بفرمایید عزیزم"
    },
    {
      "id": 24,
      "start": 7295.48,
      "end": 7297.48,
      "formatted_start": "02:01:35.480",
      "formatted_end": "02:01:37.480",
      "text": "حالتون خوبه؟ ممنون؟ شما خوبی؟"
    },
    {
      "id": 25,
      "start": 7297.48,
      "end": 7301.48,
      "formatted_start": "02:01:37.480",
      "formatted_end": "02:01:41.480",
      "text": "بفرمایی تنطوب چطوره؟ خوب هستی؟ بذارشون"
    },
    {
      "id": 26,
      "start": 7303.48,
      "end": 7304.48,
      "formatted_start": "02:01:43.480",
      "formatted_end": "02:01:44.480",
      "text": "بله؟"
    },
    {
      "id": 27,
      "start": 7305.48,
      "end": 7308.48,
      "formatted_start": "02:01:45.480",
      "formatted_end": "02:01:48.480",
      "text": "ممنون ممنون مستی وقت شما همگاه خوب"
    },
    {
      "id": 28,
      "start": 7308.48,
      "end": 7309.48,
      "formatted_start": "02:01:48.480",
      "formatted_end": "02:01:49.480",
      "text": "جان"
    },
    {
      "id": 29,
      "start": 7312.48,
      "end": 7313.48,
      "formatted_start": "02:01:52.480",
      "formatted_end": "02:01:53.480",
      "text": "بله بله"
    },
    {
      "id": 30,
      "start": 7316.48,
      "end": 7321.48,
      "formatted_start": "02:01:56.480",
      "formatted_end": "02:02:01.480",
      "text": "خوبه عالیه، مرخص هست شما باشه مرسی خداحافظ"
    },
    {
      "id": 31,
      "start": 7321.48,
      "end": 7327.48,
      "formatted_start": "02:02:01.480",
      "formatted_end": "02:02:07.480",
      "text": "خوب خوب این خدمت شدی؟ چطوری باید نیمی کنی؟ جلوت؟ شما خوب هستین؟"
    },
    {
      "id": 32,
      "start": 7327.48,
      "end": 7329.48,
      "formatted_start": "02:02:07.480",
      "formatted_end": "02:02:09.480",
      "text": "خوب ببینیم"
    },
    {
      "id": 33,
      "start": 7329.48,
      "end": 7332.48,
      "formatted_start": "02:02:09.480",
      "formatted_end": "02:02:12.480",
      "text": "مقرر بود جیرمش گفتی که برای بردونی شده"
    },
    {
      "id": 34,
      "start": 7332.48,
      "end": 7334.48,
      "formatted_start": "02:02:12.480",
      "formatted_end": "02:02:14.480",
      "text": "خب الان چند روزه شده؟"
    },
    {
      "id": 35,
      "start": 7334.48,
      "end": 7336.48,
      "formatted_start": "02:02:14.480",
      "formatted_end": "02:02:16.480",
      "text": "چه روزه روزه شده؟"
    },
    {
      "id": 36,
      "start": 7336.48,
      "end": 7339.48,
      "formatted_start": "02:02:16.480",
      "formatted_end": "02:02:19.480",
      "text": "سه روزه خوب شده"
    },
    {
      "id": 37,
      "start": 7339.48,
      "end": 7342.48,
      "formatted_start": "02:02:19.480",
      "formatted_end": "02:02:22.480",
      "text": "سه روزه خوب شده"
    },
    {
      "id": 38,
      "start": 7342.48,
      "end": 7344.48,
      "formatted_start": "02:02:22.480",
      "formatted_end": "02:02:24.480",
      "text": "خب الان شیر چی میخوره؟"
    },
    {
      "id": 39,
      "start": 7344.48,
      "end": 7347.98,
      "formatted_start": "02:02:24.480",
      "formatted_end": "02:02:27.980",
      "text": "الان همون نال کامپون که بخواهیم"
    },
    {
      "id": 40,
      "start": 7347.98,
      "end": 7352.48,
      "formatted_start": "02:02:27.980",
      "formatted_end": "02:02:32.480",
      "text": "های دو ساعت 60 تا میخوره دیگه"
    },
    {
      "id": 41,
      "start": 7352.48,
      "end": 7353.48,
      "formatted_start": "02:02:32.480",
      "formatted_end": "02:02:33.480",
      "text": "ای؟"
    },
    {
      "id": 42,
      "start": 7353.48,
      "end": 7355.48,
      "formatted_start": "02:02:33.480",
      "formatted_end": "02:02:35.480",
      "text": "تو خودتون 90 تا؟"
    },
    {
      "id": 43,
      "start": 7355.48,
      "end": 7357.48,
      "formatted_start": "02:02:35.480",
      "formatted_end": "02:02:37.480",
      "text": "نه میتونه بابا"
    },
    {
      "id": 44,
      "start": 7359.48,
      "end": 7362.48,
      "formatted_start": "02:02:39.480",
      "formatted_end": "02:02:42.480",
      "text": "شده در روز یکی دو بار این وقت 90 تا داده باشم"
    },
    {
      "id": 45,
      "start": 7362.48,
      "end": 7364.48,
      "formatted_start": "02:02:42.480",
      "formatted_end": "02:02:44.480",
      "text": "ولی اینکه هر سری 90 تا نه"
    },
    {
      "id": 46,
      "start": 7364.48,
      "end": 7366.48,
      "formatted_start": "02:02:44.480",
      "formatted_end": "02:02:46.480",
      "text": "خودتون دو ساعت هم داره میخوره دیگه"
    },
    {
      "id": 47,
      "start": 7366.48,
      "end": 7367.48,
      "formatted_start": "02:02:46.480",
      "formatted_end": "02:02:47.480",
      "text": "دو ساعت؟"
    },
    {
      "id": 48,
      "start": 7367.48,
      "end": 7368.48,
      "formatted_start": "02:02:47.480",
      "formatted_end": "02:02:48.480",
      "text": "دو ساعت"
    },
    {
      "id": 49,
      "start": 7368.48,
      "end": 7369.48,
      "formatted_start": "02:02:48.480",
      "formatted_end": "02:02:49.480",
      "text": "سریع هم چند کیلو بود؟"
    },
    {
      "id": 50,
      "start": 7369.48,
      "end": 7370.48,
      "formatted_start": "02:02:49.480",
      "formatted_end": "02:02:50.480",
      "text": "اوه دو ساعت"
    },
    {
      "id": 51,
      "start": 7370.48,
      "end": 7371.48,
      "formatted_start": "02:02:50.480",
      "formatted_end": "02:02:51.480",
      "text": "که رو چرا شده؟"
    },
    {
      "id": 52,
      "start": 7371.48,
      "end": 7372.48,
      "formatted_start": "02:02:51.480",
      "formatted_end": "02:02:52.480",
      "text": "که بود؟"
    },
    {
      "id": 53,
      "start": 7372.48,
      "end": 7374.48,
      "formatted_start": "02:02:52.480",
      "formatted_end": "02:02:54.480",
      "text": "این ها فراموش دو هفته هست"
    },
    {
      "id": 54,
      "start": 7374.48,
      "end": 7377.48,
      "formatted_start": "02:02:54.480",
      "formatted_end": "02:02:57.480",
      "text": "دو هفته بیسته و چارسته"
    },
    {
      "id": 55,
      "start": 7377.48,
      "end": 7379.48,
      "formatted_start": "02:02:57.480",
      "formatted_end": "02:02:59.480",
      "text": "بله بله بله"
    },
    {
      "id": 56,
      "start": 7379.48,
      "end": 7383.48,
      "formatted_start": "02:02:59.480",
      "formatted_end": "02:03:03.480",
      "text": "حالا شده سه و نوستند"
    },
    {
      "id": 57,
      "start": 7383.48,
      "end": 7385.48,
      "formatted_start": "02:03:03.480",
      "formatted_end": "02:03:05.480",
      "text": "خوب شاده"
    },
    {
      "id": 58,
      "start": 7385.48,
      "end": 7387.48,
      "formatted_start": "02:03:05.480",
      "formatted_end": "02:03:07.480",
      "text": "اونزه روز"
    },
    {
      "id": 59,
      "start": 7387.48,
      "end": 7391.48,
      "formatted_start": "02:03:07.480",
      "formatted_end": "02:03:11.480",
      "text": "میشه روز ستی گرم بخواد اضافه کنه"
    },
    {
      "id": 60,
      "start": 7391.48,
      "end": 7394.48,
      "formatted_start": "02:03:11.480",
      "formatted_end": "02:03:14.480",
      "text": "و یا چارست و پنجه گرم اضافه کنه"
    },
    {
      "id": 61,
      "start": 7394.48,
      "end": 7395.48,
      "formatted_start": "02:03:14.480",
      "formatted_end": "02:03:15.480",
      "text": "خوب؟"
    },
    {
      "id": 62,
      "start": 7395.48,
      "end": 7397.48,
      "formatted_start": "02:03:15.480",
      "formatted_end": "02:03:17.480",
      "text": "حالا هم چارست و بیست گرم است"
    },
    {
      "id": 63,
      "start": 7397.48,
      "end": 7398.48,
      "formatted_start": "02:03:17.480",
      "formatted_end": "02:03:18.480",
      "text": "خوبه"
    },
    {
      "id": 64,
      "start": 7398.48,
      "end": 7399.48,
      "formatted_start": "02:03:18.480",
      "formatted_end": "02:03:19.480",
      "text": "دیگه"
    },
    {
      "id": 65,
      "start": 7399.48,
      "end": 7401.48,
      "formatted_start": "02:03:19.480",
      "formatted_end": "02:03:21.480",
      "text": "مقدارتونی خوره کافیه"
    },
    {
      "id": 66,
      "start": 7401.48,
      "end": 7406.48,
      "formatted_start": "02:03:21.480",
      "formatted_end": "02:03:26.480",
      "text": "کم کم زیادتر درست میکنه دیگه ببینی بهتر میخوره یا نه"
    },
    {
      "id": 67,
      "start": 7406.48,
      "end": 7408.48,
      "formatted_start": "02:03:26.480",
      "formatted_end": "02:03:28.480",
      "text": "خب ادران شده؟"
    },
    {
      "id": 68,
      "start": 7408.48,
      "end": 7409.48,
      "formatted_start": "02:03:28.480",
      "formatted_end": "02:03:29.480",
      "text": "خوب نه"
    },
    {
      "id": 69,
      "start": 7409.48,
      "end": 7410.48,
      "formatted_start": "02:03:29.480",
      "formatted_end": "02:03:30.480",
      "text": "بدنشک هم چون خواهد نداره؟"
    },
    {
      "id": 70,
      "start": 7410.48,
      "end": 7411.48,
      "formatted_start": "02:03:30.480",
      "formatted_end": "02:03:31.480",
      "text": "در این کار"
    },
    {
      "id": 71,
      "start": 7411.48,
      "end": 7413.48,
      "formatted_start": "02:03:31.480",
      "formatted_end": "02:03:33.480",
      "text": "بعد بیقراری ها نداره؟"
    },
    {
      "id": 72,
      "start": 7413.48,
      "end": 7415.48,
      "formatted_start": "02:03:33.480",
      "formatted_end": "02:03:35.480",
      "text": "من خب بیشتر بابت نیم"
    },
    {
      "id": 73,
      "start": 7415.48,
      "end": 7417.48,
      "formatted_start": "02:03:35.480",
      "formatted_end": "02:03:37.480",
      "text": "بعد این روزانه هم میشه"
    },
    {
      "id": 74,
      "start": 7417.48,
      "end": 7421.48,
      "formatted_start": "02:03:37.480",
      "formatted_end": "02:03:41.480",
      "text": "مثل دیروز 16 ساعت بیدار بود"
    },
    {
      "id": 75,
      "start": 7421.48,
      "end": 7423.48,
      "formatted_start": "02:03:41.480",
      "formatted_end": "02:03:43.480",
      "text": "خب آن کم خواهید"
    },
    {
      "id": 76,
      "start": 7423.48,
      "end": 7424.48,
      "formatted_start": "02:03:43.480",
      "formatted_end": "02:03:44.480",
      "text": "ببینیم"
    },
    {
      "id": 77,
      "start": 7424.48,
      "end": 7425.48,
      "formatted_start": "02:03:44.480",
      "formatted_end": "02:03:45.480",
      "text": "بعد بیقرار بود"
    },
    {
      "id": 78,
      "start": 7425.48,
      "end": 7426.48,
      "formatted_start": "02:03:45.480",
      "formatted_end": "02:03:46.480",
      "text": "بیقرار؟"
    },
    {
      "id": 79,
      "start": 7426.48,
      "end": 7430.98,
      "formatted_start": "02:03:46.480",
      "formatted_end": "02:03:50.980",
      "text": "واسه نکه گریه بکنه مدامان نه این دابلا شده گریه بکنه"
    },
    {
      "id": 80,
      "start": 7430.98,
      "end": 7433.98,
      "formatted_start": "02:03:50.980",
      "formatted_end": "02:03:53.980",
      "text": "واسه دل نردش اینها دارو زدن آروم شده"
    },
    {
      "id": 81,
      "start": 7433.98,
      "end": 7437.98,
      "formatted_start": "02:03:53.980",
      "formatted_end": "02:03:57.980",
      "text": "ولی خب نبیخواب و نبیقراری که مثلا بیخوابه"
    },
    {
      "id": 82,
      "start": 7437.98,
      "end": 7440.98,
      "formatted_start": "02:03:57.980",
      "formatted_end": "02:04:00.980",
      "text": "شیرم نبیخواب"
    },
    {
      "id": 83,
      "start": 7440.98,
      "end": 7442.98,
      "formatted_start": "02:04:00.980",
      "formatted_end": "02:04:02.980",
      "text": "شیر رو خب به زور بهش میدادم"
    },
    {
      "id": 84,
      "start": 7442.98,
      "end": 7446.48,
      "formatted_start": "02:04:02.980",
      "formatted_end": "02:04:06.480",
      "text": "من نگه میداشتم خب من یه عادت بدیم که داره"
    },
    {
      "id": 85,
      "start": 7446.48,
      "end": 7449.48,
      "formatted_start": "02:04:06.480",
      "formatted_end": "02:04:09.480",
      "text": "باید زیر شیشه شیر خواب بره"
    },
    {
      "id": 86,
      "start": 7449.48,
      "end": 7450.48,
      "formatted_start": "02:04:09.480",
      "formatted_end": "02:04:10.480",
      "text": "نمیدونم این چیه"
    },
    {
      "id": 87,
      "start": 7450.48,
      "end": 7451.48,
      "formatted_start": "02:04:10.480",
      "formatted_end": "02:04:11.480",
      "text": "از من و بچه هم"
    },
    {
      "id": 88,
      "start": 7451.48,
      "end": 7454.48,
      "formatted_start": "02:04:11.480",
      "formatted_end": "02:04:14.480",
      "text": "خب میخوای شاید چند دقیقه باید نگرد داری که"
    },
    {
      "id": 89,
      "start": 7454.48,
      "end": 7457.48,
      "formatted_start": "02:04:14.480",
      "formatted_end": "02:04:17.480",
      "text": "زیر شیششی میخوادش عمید بشه"
    },
    {
      "id": 90,
      "start": 7457.48,
      "end": 7459.48,
      "formatted_start": "02:04:17.480",
      "formatted_end": "02:04:19.480",
      "text": "بعد بخوایی بذاری سر جاش"
    },
    {
      "id": 91,
      "start": 7459.48,
      "end": 7461.48,
      "formatted_start": "02:04:19.480",
      "formatted_end": "02:04:21.480",
      "text": "بعد شیششی رو تا آخر میخوره؟"
    },
    {
      "id": 92,
      "start": 7461.48,
      "end": 7462.48,
      "formatted_start": "02:04:21.480",
      "formatted_end": "02:04:22.480",
      "text": "نه میخورم"
    },
    {
      "id": 93,
      "start": 7462.48,
      "end": 7464.48,
      "formatted_start": "02:04:22.480",
      "formatted_end": "02:04:24.480",
      "text": "اگه باشه که میخوره"
    },
    {
      "id": 94,
      "start": 7464.48,
      "end": 7466.48,
      "formatted_start": "02:04:24.480",
      "formatted_end": "02:04:26.480",
      "text": "اگه نه میگیر نلابنا ببین کارم"
    },
    {
      "id": 95,
      "start": 7466.48,
      "end": 7467.48,
      "formatted_start": "02:04:26.480",
      "formatted_end": "02:04:27.480",
      "text": "آه"
    },
    {
      "id": 96,
      "start": 7467.48,
      "end": 7469.48,
      "formatted_start": "02:04:27.480",
      "formatted_end": "02:04:29.480",
      "text": "بله ببین خوبه"
    },
    {
      "id": 97,
      "start": 7469.48,
      "end": 7473.48,
      "formatted_start": "02:04:29.480",
      "formatted_end": "02:04:33.480",
      "text": "خب بچه ها الان داره اون وضع گیری مناسب رو پیدا کنه"
    },
    {
      "id": 98,
      "start": 7473.48,
      "end": 7476.48,
      "formatted_start": "02:04:33.480",
      "formatted_end": "02:04:36.480",
      "text": "وقتی که داره پیدا میکنی باید یک خیاله رو راحت"
    },
    {
      "id": 99,
      "start": 7476.48,
      "end": 7477.48,
      "formatted_start": "02:04:36.480",
      "formatted_end": "02:04:37.480",
      "text": "واقعا نمیاده؟"
    },
    {
      "id": 100,
      "start": 7477.48,
      "end": 7484.98,
      "formatted_start": "02:04:37.480",
      "formatted_end": "02:04:44.980",
      "text": "نه، فقط یکمار از اشتباه خودمون چون تازه خود رو دمر کردیم به پشت استادی اونجا بالا بود درجه"
    },
    {
      "id": 101,
      "start": 7484.98,
      "end": 7485.98,
      "formatted_start": "02:04:44.980",
      "formatted_end": "02:04:45.980",
      "text": "نه، اصلا بالا بود"
    },
    {
      "id": 102,
      "start": 7485.98,
      "end": 7489.98,
      "formatted_start": "02:04:45.980",
      "formatted_end": "02:04:49.980",
      "text": "اینجور که پشتش کنی ممکنه به مدش پشار بیاد و یک درخواست بیاد"
    },
    {
      "id": 103,
      "start": 7489.98,
      "end": 7490.48,
      "formatted_start": "02:04:49.980",
      "formatted_end": "02:04:50.480",
      "text": "آره"
    },
    {
      "id": 104,
      "start": 7490.48,
      "end": 7494.98,
      "formatted_start": "02:04:50.480",
      "formatted_end": "02:04:54.980",
      "text": "آره، اگر هم خواستین به پشتش بکنی، باید از قفص سیرش نکردید"
    },
    {
      "id": 105,
      "start": 7495.98,
      "end": 7497.98,
      "formatted_start": "02:04:55.980",
      "formatted_end": "02:04:57.980",
      "text": "و تا میشه هم رو شونه هم میذارم"
    },
    {
      "id": 106,
      "start": 7497.98,
      "end": 7499.98,
      "formatted_start": "02:04:57.980",
      "formatted_end": "02:04:59.980",
      "text": "آره، رو شونه هم میذارم"
    }
  ],
  "status": "completed"
}