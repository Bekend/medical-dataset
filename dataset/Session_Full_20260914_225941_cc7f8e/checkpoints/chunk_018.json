  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5406.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:06.000",
      "text": "باید نصف بخورید، حتما بعد از غذا بخورید که شکمش خالی نیست."
    },
    {
      "id": 1,
      "start": 5406.0,
      "end": 5409.0,
      "formatted_start": "01:30:06.000",
      "formatted_end": "01:30:09.000",
      "text": "باید اسپرایه سابون تعمال شد."
    },
    {
      "id": 2,
      "start": 5409.0,
      "end": 5414.0,
      "formatted_start": "01:30:09.000",
      "formatted_end": "01:30:14.000",
      "text": "سابون، زمون، اصر و شرق دوباره بزنید."
    },
    {
      "id": 3,
      "start": 5414.0,
      "end": 5424.0,
      "formatted_start": "01:30:14.000",
      "formatted_end": "01:30:24.000",
      "text": "ما تا اناتون خیلی بزرگ، اگر که راحتی کنید امروز، هر دو ساعت بزنید دوباره تا ساعت هشت شب."
    },
    {
      "id": 4,
      "start": 5424.0,
      "end": 5429.0,
      "formatted_start": "01:30:24.000",
      "formatted_end": "01:30:29.000",
      "text": "یک اشکالی بیگم براش نوشتم که هر در روز دفترها عرض و پافت بگرده"
    },
    {
      "id": 5,
      "start": 5429.0,
      "end": 5431.0,
      "formatted_start": "01:30:29.000",
      "formatted_end": "01:30:31.000",
      "text": "حتما با دمیار بگرده"
    },
    {
      "id": 6,
      "start": 5431.0,
      "end": 5434.0,
      "formatted_start": "01:30:31.000",
      "formatted_end": "01:30:34.000",
      "text": "یک گرس ایروکست نوشتم، ازرها بکنند"
    },
    {
      "id": 7,
      "start": 5434.0,
      "end": 5438.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:38.000",
      "text": "یک گرس ریتی زن هم نوشتم که شعبه بکنند"
    },
    {
      "id": 8,
      "start": 5438.0,
      "end": 5441.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:41.000",
      "text": "شعبه سلفه چی داری کنند؟"
    },
    {
      "id": 9,
      "start": 5441.0,
      "end": 5447.0,
      "formatted_start": "01:30:41.000",
      "formatted_end": "01:30:47.000",
      "text": "هر چیان در حال این صوفه هاش قرار نوشته چهار روزی شده"
    },
    {
      "id": 10,
      "start": 5447.0,
      "end": 5451.0,
      "formatted_start": "01:30:47.000",
      "formatted_end": "01:30:51.000",
      "text": "آره، بذارید شعبه سلفه رو بخونید که خلطا ورد"
    },
    {
      "id": 11,
      "start": 5451.0,
      "end": 5453.0,
      "formatted_start": "01:30:51.000",
      "formatted_end": "01:30:53.000",
      "text": "بذار خشک خلطه هاش کنده بشه"
    },
    {
      "id": 12,
      "start": 5457.0,
      "end": 5459.0,
      "formatted_start": "01:30:57.000",
      "formatted_end": "01:30:59.000",
      "text": "بیازم ایشانه که با هم خوبه خوب بشه"
    },
    {
      "id": 13,
      "start": 5459.0,
      "end": 5461.0,
      "formatted_start": "01:30:59.000",
      "formatted_end": "01:31:01.000",
      "text": "اگه چیزی برده باشه"
    },
    {
      "id": 14,
      "start": 5461.0,
      "end": 5463.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:03.000",
      "text": "اگه نشد آزمایشش هم ازمو می نمیستم"
    },
    {
      "id": 15,
      "start": 5463.0,
      "end": 5465.0,
      "formatted_start": "01:31:03.000",
      "formatted_end": "01:31:05.000",
      "text": "توی یه زنده انجام بده"
    },
    {
      "id": 16,
      "start": 5465.0,
      "end": 5467.0,
      "formatted_start": "01:31:05.000",
      "formatted_end": "01:31:07.000",
      "text": "یه خونه کشی"
    },
    {
      "id": 17,
      "start": 5467.0,
      "end": 5469.0,
      "formatted_start": "01:31:07.000",
      "formatted_end": "01:31:09.000",
      "text": "خونه کش در جه هست"
    },
    {
      "id": 18,
      "start": 5469.0,
      "end": 5471.0,
      "formatted_start": "01:31:09.000",
      "formatted_end": "01:31:11.000",
      "text": "اگر خیلی شدید باشه باید بستری بشه"
    },
    {
      "id": 19,
      "start": 5471.0,
      "end": 5473.0,
      "formatted_start": "01:31:11.000",
      "formatted_end": "01:31:13.000",
      "text": "اگه نکه دیگه"
    },
    {
      "id": 20,
      "start": 5473.0,
      "end": 5475.0,
      "formatted_start": "01:31:13.000",
      "formatted_end": "01:31:15.000",
      "text": "اوه"
    },
    {
      "id": 21,
      "start": 5475.0,
      "end": 5477.0,
      "formatted_start": "01:31:15.000",
      "formatted_end": "01:31:17.000",
      "text": "اینم از"
    },
    {
      "id": 22,
      "start": 5477.0,
      "end": 5479.0,
      "formatted_start": "01:31:17.000",
      "formatted_end": "01:31:19.000",
      "text": "باید برمشه"
    },
    {
      "id": 23,
      "start": 5479.0,
      "end": 5484.0,
      "formatted_start": "01:31:19.000",
      "formatted_end": "01:31:24.000",
      "text": "این کار رو روح گیرید هم برای دارو داشته هم برای دارو داشته"
    },
    {
      "id": 24,
      "start": 5484.0,
      "end": 5487.0,
      "formatted_start": "01:31:24.000",
      "formatted_end": "01:31:27.000",
      "text": "این الان وردش قد که شروع بخوانده تو برای سنده ش؟"
    },
    {
      "id": 25,
      "start": 5487.0,
      "end": 5491.0,
      "formatted_start": "01:31:27.000",
      "formatted_end": "01:31:31.000",
      "text": "ببین ده ساله ش دیگه یا ده ساله ش"
    },
    {
      "id": 26,
      "start": 5491.0,
      "end": 5493.0,
      "formatted_start": "01:31:31.000",
      "formatted_end": "01:31:33.000",
      "text": "یا ده ساله"
    },
    {
      "id": 27,
      "start": 5493.0,
      "end": 5495.0,
      "formatted_start": "01:31:33.000",
      "formatted_end": "01:31:35.000",
      "text": "مکان باز ۲۹۳ باشه"
    },
    {
      "id": 28,
      "start": 5495.0,
      "end": 5497.0,
      "formatted_start": "01:31:35.000",
      "formatted_end": "01:31:37.000",
      "text": "وردش"
    },
    {
      "id": 29,
      "start": 5497.0,
      "end": 5500.0,
      "formatted_start": "01:31:37.000",
      "formatted_end": "01:31:40.000",
      "text": "وردش ماشاله بخوانده بخوانده همین آخره"
    },
    {
      "id": 30,
      "start": 5500.0,
      "end": 5504.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:44.000",
      "text": "بس همین میگن ایلی اله آخره از ایله بره"
    },
    {
      "id": 31,
      "start": 5504.0,
      "end": 5505.0,
      "formatted_start": "01:31:44.000",
      "formatted_end": "01:31:45.000",
      "text": "میگن جای آره"
    },
    {
      "id": 32,
      "start": 5505.0,
      "end": 5506.0,
      "formatted_start": "01:31:45.000",
      "formatted_end": "01:31:46.000",
      "text": "آره بابا مهم قدشه"
    },
    {
      "id": 33,
      "start": 5506.0,
      "end": 5508.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:31:48.000",
      "text": "وردش که کشه"
    },
    {
      "id": 34,
      "start": 5508.0,
      "end": 5510.0,
      "formatted_start": "01:31:48.000",
      "formatted_end": "01:31:50.000",
      "text": "خوب شما خدا به خدا بگیریم"
    },
    {
      "id": 35,
      "start": 5510.0,
      "end": 5512.0,
      "formatted_start": "01:31:50.000",
      "formatted_end": "01:31:52.000",
      "text": "سلام حال شما خوبیدید؟"
    },
    {
      "id": 36,
      "start": 5512.0,
      "end": 5513.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:53.000",
      "text": "مرسی"
    },
    {
      "id": 37,
      "start": 5513.0,
      "end": 5514.0,
      "formatted_start": "01:31:53.000",
      "formatted_end": "01:31:54.000",
      "text": "خوب شما برد برد برد"
    },
    {
      "id": 38,
      "start": 5514.0,
      "end": 5516.0,
      "formatted_start": "01:31:54.000",
      "formatted_end": "01:31:56.000",
      "text": "آتماوشش هم همینه کل دیشتی"
    },
    {
      "id": 39,
      "start": 5516.0,
      "end": 5517.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:31:57.000",
      "text": "بله عزیزم بله"
    },
    {
      "id": 40,
      "start": 5517.0,
      "end": 5518.0,
      "formatted_start": "01:31:57.000",
      "formatted_end": "01:31:58.000",
      "text": "از این هم کلی برد برد برد"
    },
    {
      "id": 41,
      "start": 5518.0,
      "end": 5519.0,
      "formatted_start": "01:31:58.000",
      "formatted_end": "01:31:59.000",
      "text": "خوب چه خبرو؟"
    },
    {
      "id": 42,
      "start": 5519.0,
      "end": 5520.0,
      "formatted_start": "01:31:59.000",
      "formatted_end": "01:32:00.000",
      "text": "سلامه"
    },
    {
      "id": 43,
      "start": 5520.0,
      "end": 5521.0,
      "formatted_start": "01:32:00.000",
      "formatted_end": "01:32:01.000",
      "text": "خوب شما؟"
    },
    {
      "id": 44,
      "start": 5521.0,
      "end": 5523.0,
      "formatted_start": "01:32:01.000",
      "formatted_end": "01:32:03.000",
      "text": "مرسی همینه خب چه خبرو؟"
    },
    {
      "id": 45,
      "start": 5523.0,
      "end": 5524.0,
      "formatted_start": "01:32:03.000",
      "formatted_end": "01:32:04.000",
      "text": "سلامه"
    },
    {
      "id": 46,
      "start": 5524.0,
      "end": 5525.0,
      "formatted_start": "01:32:04.000",
      "formatted_end": "01:32:05.000",
      "text": "برگردو بده"
    },
    {
      "id": 47,
      "start": 5526.0,
      "end": 5527.0,
      "formatted_start": "01:32:06.000",
      "formatted_end": "01:32:07.000",
      "text": "خوب"
    },
    {
      "id": 48,
      "start": 5528.0,
      "end": 5529.0,
      "formatted_start": "01:32:08.000",
      "formatted_end": "01:32:09.000",
      "text": "شما چطوری؟"
    },
    {
      "id": 49,
      "start": 5529.0,
      "end": 5530.0,
      "formatted_start": "01:32:09.000",
      "formatted_end": "01:32:10.000",
      "text": "خوب"
    },
    {
      "id": 50,
      "start": 5530.0,
      "end": 5532.0,
      "formatted_start": "01:32:10.000",
      "formatted_end": "01:32:12.000",
      "text": "اسم این بود؟"
    },
    {
      "id": 51,
      "start": 5532.0,
      "end": 5534.0,
      "formatted_start": "01:32:12.000",
      "formatted_end": "01:32:14.000",
      "text": "فوزان فائزه"
    },
    {
      "id": 52,
      "start": 5534.0,
      "end": 5535.0,
      "formatted_start": "01:32:14.000",
      "formatted_end": "01:32:15.000",
      "text": "فائزه خب"
    },
    {
      "id": 53,
      "start": 5535.0,
      "end": 5536.0,
      "formatted_start": "01:32:15.000",
      "formatted_end": "01:32:16.000",
      "text": "چی شده؟"
    },
    {
      "id": 54,
      "start": 5536.0,
      "end": 5539.24,
      "formatted_start": "01:32:16.000",
      "formatted_end": "01:32:19.240",
      "text": "این هر چی می کنه چی کمش درد می کنه"
    },
    {
      "id": 55,
      "start": 5539.24,
      "end": 5539.68,
      "formatted_start": "01:32:19.240",
      "formatted_end": "01:32:19.680",
      "text": "آها"
    },
    {
      "id": 56,
      "start": 5539.68,
      "end": 5543.72,
      "formatted_start": "01:32:19.680",
      "formatted_end": "01:32:23.720",
      "text": "اه"
    },
    {
      "id": 57,
      "start": 5543.72,
      "end": 5545.4,
      "formatted_start": "01:32:23.720",
      "formatted_end": "01:32:25.400",
      "text": "کجای درد درد می گیره؟"
    },
    {
      "id": 58,
      "start": 5545.4,
      "end": 5546.14,
      "formatted_start": "01:32:25.400",
      "formatted_end": "01:32:26.140",
      "text": "اشون بده بنا"
    },
    {
      "id": 59,
      "start": 5546.14,
      "end": 5548.48,
      "formatted_start": "01:32:26.140",
      "formatted_end": "01:32:28.480",
      "text": "اینجا"
    },
    {
      "id": 60,
      "start": 5548.48,
      "end": 5551.02,
      "formatted_start": "01:32:28.480",
      "formatted_end": "01:32:31.020",
      "text": "اینجا درد نمی گیره؟"
    },
    {
      "id": 61,
      "start": 5551.02,
      "end": 5551.36,
      "formatted_start": "01:32:31.020",
      "formatted_end": "01:32:31.360",
      "text": "نه"
    },
    {
      "id": 62,
      "start": 5551.36,
      "end": 5552.52,
      "formatted_start": "01:32:31.360",
      "formatted_end": "01:32:32.520",
      "text": "درد درد درد"
    },
    {
      "id": 63,
      "start": 5552.52,
      "end": 5552.76,
      "formatted_start": "01:32:32.520",
      "formatted_end": "01:32:32.760",
      "text": "خب"
    },
    {
      "id": 64,
      "start": 5552.76,
      "end": 5554.48,
      "formatted_start": "01:32:32.760",
      "formatted_end": "01:32:34.480",
      "text": "دستشوی بزرگ راحت می روید"
    },
    {
      "id": 65,
      "start": 5554.48,
      "end": 5555.4,
      "formatted_start": "01:32:34.480",
      "formatted_end": "01:32:35.400",
      "text": "می توانی همین"
    },
    {
      "id": 66,
      "start": 5555.4,
      "end": 5556.28,
      "formatted_start": "01:32:35.400",
      "formatted_end": "01:32:36.280",
      "text": "آه"
    },
    {
      "id": 67,
      "start": 5556.28,
      "end": 5557.34,
      "formatted_start": "01:32:36.280",
      "formatted_end": "01:32:37.340",
      "text": "دستشوی بزرگی"
    },
    {
      "id": 68,
      "start": 5557.34,
      "end": 5558.1,
      "formatted_start": "01:32:37.340",
      "formatted_end": "01:32:38.100",
      "text": "زد نیست"
    },
    {
      "id": 69,
      "start": 5558.1,
      "end": 5558.98,
      "formatted_start": "01:32:38.100",
      "formatted_end": "01:32:38.980",
      "text": "خیلی خیلی خیلی"
    },
    {
      "id": 70,
      "start": 5558.98,
      "end": 5559.64,
      "formatted_start": "01:32:38.980",
      "formatted_end": "01:32:39.640",
      "text": "قطعه داره داری"
    },
    {
      "id": 71,
      "start": 5559.64,
      "end": 5560.0,
      "formatted_start": "01:32:39.640",
      "formatted_end": "01:32:40.000",
      "text": "چون"
    },
    {
      "id": 72,
      "start": 5560.0,
      "end": 5562.18,
      "formatted_start": "01:32:40.000",
      "formatted_end": "01:32:42.180",
      "text": "نه"
    },
    {
      "id": 73,
      "start": 5562.18,
      "end": 5563.72,
      "formatted_start": "01:32:42.180",
      "formatted_end": "01:32:43.720",
      "text": "اصحالی همین"
    },
    {
      "id": 74,
      "start": 5563.72,
      "end": 5569.72,
      "formatted_start": "01:32:43.720",
      "formatted_end": "01:32:49.720",
      "text": "سال موندی ایتون؟ دستی بازها کمی سال موندی؟"
    },
    {
      "id": 75,
      "start": 5569.72,
      "end": 5572.72,
      "formatted_start": "01:32:49.720",
      "formatted_end": "01:32:52.720",
      "text": "زفت شعل معمولیه کدونش؟"
    },
    {
      "id": 76,
      "start": 5572.72,
      "end": 5576.72,
      "formatted_start": "01:32:52.720",
      "formatted_end": "01:32:56.720",
      "text": "بعضی وقتا اونی، سویسی بعضی وقتا اونی"
    },
    {
      "id": 77,
      "start": 5576.72,
      "end": 5579.72,
      "formatted_start": "01:32:56.720",
      "formatted_end": "01:32:59.720",
      "text": "خب، بعد حالت هوا نداری؟"
    },
    {
      "id": 78,
      "start": 5579.72,
      "end": 5582.72,
      "formatted_start": "01:32:59.720",
      "formatted_end": "01:33:02.720",
      "text": "رامولاسیا موندی"
    },
    {
      "id": 79,
      "start": 5582.72,
      "end": 5584.72,
      "formatted_start": "01:33:02.720",
      "formatted_end": "01:33:04.720",
      "text": "داری"
    },
    {
      "id": 80,
      "start": 5584.72,
      "end": 5588.72,
      "formatted_start": "01:33:04.720",
      "formatted_end": "01:33:08.720",
      "text": "داری؟ بعضی وقتا اصطاد میکنی میخواد حالت برد بشه؟"
    },
    {
      "id": 81,
      "start": 5588.72,
      "end": 5595.72,
      "formatted_start": "01:33:08.720",
      "formatted_end": "01:33:15.720",
      "text": "از اینکه یک بار آزمایش دادیم گفتن بعدش انگل داره، میکروب داره"
    },
    {
      "id": 82,
      "start": 5595.72,
      "end": 5598.72,
      "formatted_start": "01:33:15.720",
      "formatted_end": "01:33:18.720",
      "text": "آزمایش خون دادیم یا مدفوع؟"
    },
    {
      "id": 83,
      "start": 5598.72,
      "end": 5601.72,
      "formatted_start": "01:33:18.720",
      "formatted_end": "01:33:21.720",
      "text": "خونم دادیم"
    },
    {
      "id": 84,
      "start": 5601.72,
      "end": 5609.72,
      "formatted_start": "01:33:21.720",
      "formatted_end": "01:33:29.720",
      "text": "آزمایش خون خیلی تو تشخیصه اندرنیده خیلی مهم نیست، آزمایشم مدفوعه"
    },
    {
      "id": 85,
      "start": 5611.72,
      "end": 5615.72,
      "formatted_start": "01:33:31.720",
      "formatted_end": "01:33:35.720",
      "text": "خب، بعد؟ چند سال بشه؟"
    },
    {
      "id": 86,
      "start": 5615.72,
      "end": 5619.02,
      "formatted_start": "01:33:35.720",
      "formatted_end": "01:33:39.020",
      "text": "آن هم تهبان میخونی دلاخت کنی"
    },
    {
      "id": 87,
      "start": 5619.02,
      "end": 5620.02,
      "formatted_start": "01:33:39.020",
      "formatted_end": "01:33:40.020",
      "text": "آه"
    },
    {
      "id": 88,
      "start": 5620.02,
      "end": 5624.02,
      "formatted_start": "01:33:40.020",
      "formatted_end": "01:33:44.020",
      "text": "میری دستشویی جیش میکنی نمیسوزه؟"
    },
    {
      "id": 89,
      "start": 5624.02,
      "end": 5627.32,
      "formatted_start": "01:33:44.020",
      "formatted_end": "01:33:47.320",
      "text": "آه دیم دید دست شویدم"
    },
    {
      "id": 90,
      "start": 5627.32,
      "end": 5629.02,
      "formatted_start": "01:33:47.320",
      "formatted_end": "01:33:49.020",
      "text": "خارش نداری؟"
    },
    {
      "id": 91,
      "start": 5629.02,
      "end": 5630.02,
      "formatted_start": "01:33:49.020",
      "formatted_end": "01:33:50.020",
      "text": "بی جیم زدن"
    },
    {
      "id": 92,
      "start": 5630.02,
      "end": 5637.02,
      "formatted_start": "01:33:50.020",
      "formatted_end": "01:33:57.020",
      "text": "مثلا اینجا لطف سوزه یا اینکه مثلا خارش داشته باشه یا باسنت خارش داشته باشه؟"
    },
    {
      "id": 93,
      "start": 5637.02,
      "end": 5640.52,
      "formatted_start": "01:33:57.020",
      "formatted_end": "01:34:00.520",
      "text": "پستم بی جیم دیم آه"
    },
    {
      "id": 94,
      "start": 5640.52,
      "end": 5644.02,
      "formatted_start": "01:34:00.520",
      "formatted_end": "01:34:04.020",
      "text": "پستم بی جیم دیم"
    },
    {
      "id": 95,
      "start": 5644.02,
      "end": 5674.02,
      "formatted_start": "01:34:04.020",
      "formatted_end": "01:34:34.020",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 96,
      "start": 5674.02,
      "end": 5676.02,
      "formatted_start": "01:34:34.020",
      "formatted_end": "01:34:36.020",
      "text": "میفته"
    }
  ],
  "status": "completed"
}