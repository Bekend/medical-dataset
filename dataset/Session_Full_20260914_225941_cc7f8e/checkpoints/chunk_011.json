      "formatted_end": "00:56:25.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 3385.0,
      "end": 3387.0,
      "formatted_start": "00:56:25.000",
      "formatted_end": "00:56:27.000",
      "text": "اینکه کدومی که مشتبه میگیریم"
    },
    {
      "id": 4,
      "start": 3387.0,
      "end": 3389.0,
      "formatted_start": "00:56:27.000",
      "formatted_end": "00:56:29.000",
      "text": "کدوم؟"
    },
    {
      "id": 5,
      "start": 3389.0,
      "end": 3391.0,
      "formatted_start": "00:56:29.000",
      "formatted_end": "00:56:31.000",
      "text": "اون خودم سال را"
    },
    {
      "id": 6,
      "start": 3391.0,
      "end": 3393.0,
      "formatted_start": "00:56:31.000",
      "formatted_end": "00:56:33.000",
      "text": "یه هشت و سخت داشتیم. میشیم؟"
    },
    {
      "id": 7,
      "start": 3393.0,
      "end": 3395.0,
      "formatted_start": "00:56:33.000",
      "formatted_end": "00:56:35.000",
      "text": "آره، میرامه"
    },
    {
      "id": 8,
      "start": 3395.0,
      "end": 3397.0,
      "formatted_start": "00:56:35.000",
      "formatted_end": "00:56:37.000",
      "text": "هی، همینه"
    },
    {
      "id": 9,
      "start": 3397.0,
      "end": 3399.0,
      "formatted_start": "00:56:37.000",
      "formatted_end": "00:56:39.000",
      "text": "نه، کلی را هستم"
    },
    {
      "id": 10,
      "start": 3399.0,
      "end": 3401.0,
      "formatted_start": "00:56:39.000",
      "formatted_end": "00:56:41.000",
      "text": "همه"
    },
    {
      "id": 11,
      "start": 3401.0,
      "end": 3403.0,
      "formatted_start": "00:56:41.000",
      "formatted_end": "00:56:43.000",
      "text": "خیلی خیلی بابونه"
    },
    {
      "id": 12,
      "start": 3403.0,
      "end": 3405.0,
      "formatted_start": "00:56:43.000",
      "formatted_end": "00:56:45.000",
      "text": "این بیشتر خیلی خفتیه"
    },
    {
      "id": 13,
      "start": 3405.0,
      "end": 3407.0,
      "formatted_start": "00:56:45.000",
      "formatted_end": "00:56:47.000",
      "text": "الانم بنایید بیرون"
    },
    {
      "id": 14,
      "start": 3407.0,
      "end": 3409.0,
      "formatted_start": "00:56:47.000",
      "formatted_end": "00:56:49.000",
      "text": "خیلی سرمشون"
    },
    {
      "id": 15,
      "start": 3409.0,
      "end": 3411.0,
      "formatted_start": "00:56:49.000",
      "formatted_end": "00:56:51.000",
      "text": "که سرمشون؟"
    },
    {
      "id": 16,
      "start": 3411.0,
      "end": 3413.0,
      "formatted_start": "00:56:51.000",
      "formatted_end": "00:56:53.000",
      "text": "دو، یک، یک، خب سرمشون"
    },
    {
      "id": 17,
      "start": 3413.0,
      "end": 3442.98,
      "formatted_start": "00:56:53.000",
      "formatted_end": "00:57:22.980",
