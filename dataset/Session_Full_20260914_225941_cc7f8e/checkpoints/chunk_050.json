      "formatted_start": "04:10:05.000",
      "formatted_end": "04:10:08.000",
      "text": "بعد صبح که پلند میشه مدام عدسه میزنه،"
    },
    {
      "id": 4,
      "start": 15008.0,
      "end": 15013.0,
      "formatted_start": "04:10:08.000",
      "formatted_end": "04:10:13.000",
      "text": "و یه حالتهای خیلی مزیده، اینگاه که خون مزیده کرده باشه،"
    },
    {
      "id": 5,
      "start": 15013.0,
      "end": 15016.0,
      "formatted_start": "04:10:13.000",
      "formatted_end": "04:10:16.000",
      "text": "فکر میکنم که خیلی دماغشو میکنن."
    },
    {
      "id": 6,
      "start": 15016.0,
      "end": 15019.0,
      "formatted_start": "04:10:16.000",
      "formatted_end": "04:10:19.000",
      "text": "بس صرفه هم داره؟"
    },
    {
      "id": 7,
      "start": 15019.0,
      "end": 15022.0,
      "formatted_start": "04:10:19.000",
      "formatted_end": "04:10:22.000",
      "text": "نه صرفه نداره، فقط عدسه."
    },
    {
      "id": 8,
      "start": 15022.0,
      "end": 15026.0,
      "formatted_start": "04:10:22.000",
      "formatted_end": "04:10:26.000",
      "text": "تو حیات میبری، مولا نمیدونم چون بخاطر درخت هست،"
    },
    {
      "id": 9,
      "start": 15026.0,
      "end": 15029.0,
      "formatted_start": "04:10:26.000",
      "formatted_end": "04:10:29.000",
      "text": "چون برای خیلی درخت داریم"
    },
    {
      "id": 10,
      "start": 15029.0,
      "end": 15031.0,
      "formatted_start": "04:10:29.000",
      "formatted_end": "04:10:31.000",
      "text": "و چشماشو خیلی میکنه"
    },
    {
      "id": 11,
      "start": 15031.0,
      "end": 15034.0,
      "formatted_start": "04:10:31.000",
      "formatted_end": "04:10:34.000",
      "text": "من چشم بزرگ شکر بردم و اشتباه این یک ماه پیش گفت"
    },
    {
      "id": 12,
      "start": 15034.0,
      "end": 15037.0,
      "formatted_start": "04:10:34.000",
      "formatted_end": "04:10:37.000",
      "text": "قرینه چشم خیلی گوشاده"
    },
    {
      "id": 13,
      "start": 15037.0,
      "end": 15039.0,
      "formatted_start": "04:10:37.000",
      "formatted_end": "04:10:39.000",
      "text": "و تو نور زن مثلا خیلی ازرگ میشه"
    },
    {
      "id": 14,
      "start": 15039.0,
      "end": 15041.0,
      "formatted_start": "04:10:39.000",
      "formatted_end": "04:10:41.000",
      "text": "مودام اینکه آفتیباش میزنه"
    },
    {
      "id": 15,
      "start": 15041.0,
      "end": 15045.0,
      "formatted_start": "04:10:41.000",
      "formatted_end": "04:10:45.000",
      "text": "تیلیزونو گفته بوشی که خب قدرانه براش"
    },
    {
      "id": 16,
      "start": 15045.0,
      "end": 15047.0,
      "formatted_start": "04:10:45.000",
      "formatted_end": "04:10:47.000",
      "text": "تیلیزون که نگاه میکنه"
    },
    {
      "id": 17,
      "start": 15047.0,
      "end": 15049.0,
      "formatted_start": "04:10:47.000",
      "formatted_end": "04:10:49.000",
      "text": "ساعتشو کم کرده میکنه"
    },
    {
      "id": 18,
      "start": 15049.0,
      "end": 15050.0,
      "formatted_start": "04:10:49.000",
      "formatted_end": "04:10:50.000",
      "text": "خیلی خوب"
    },
    {
      "id": 19,
      "start": 15050.0,
      "end": 15051.0,
      "formatted_start": "04:10:50.000",
      "formatted_end": "04:10:51.000",
      "text": "بله"
    },
    {
      "id": 20,
      "start": 15051.0,
      "end": 15053.0,
      "formatted_start": "04:10:51.000",
      "formatted_end": "04:10:53.000",
      "text": "نخست بکش"
    },
    {
      "id": 21,
      "start": 15053.0,
      "end": 15056.28,
      "formatted_start": "04:10:53.000",
      "formatted_end": "04:10:56.280",
      "text": "نفس بگو پسر گلند"
    },
    {
      "id": 22,
      "start": 15056.28,
      "end": 15057.92,
      "formatted_start": "04:10:56.280",
      "formatted_end": "04:10:57.920",
      "text": "گلند با کن"
    },
    {
      "id": 23,
      "start": 15057.92,
      "end": 15058.4,
      "formatted_start": "04:10:57.920",
      "formatted_end": "04:10:58.400",
      "text": "محمد"
    },
    {
      "id": 24,
      "start": 15058.4,
      "end": 15060.94,
      "formatted_start": "04:10:58.400",
      "formatted_end": "04:11:00.940",
      "text": "آره اینجور نفس بگش"
    },
    {
      "id": 25,
      "start": 15060.94,
      "end": 15062.96,
      "formatted_start": "04:11:00.940",
      "formatted_end": "04:11:02.960",
      "text": "آفرین"
    },
    {
      "id": 26,
      "start": 15062.96,
      "end": 15063.82,
      "formatted_start": "04:11:02.960",
      "formatted_end": "04:11:03.820",
      "text": "باید بگو"
    },
    {
      "id": 27,
      "start": 15063.82,
      "end": 15066.48,
      "formatted_start": "04:11:03.820",
      "formatted_end": "04:11:06.480",
      "text": "آفرین پسر گلند"
    },
    {
      "id": 28,
      "start": 15066.48,
      "end": 15067.56,
      "formatted_start": "04:11:06.480",
      "formatted_end": "04:11:07.560",
      "text": "خب"
    },
    {
      "id": 29,
      "start": 15067.56,
      "end": 15069.64,
      "formatted_start": "04:11:07.560",
      "formatted_end": "04:11:09.640",
      "text": "چند سالشه محمد؟"
    },
    {
      "id": 30,
      "start": 15069.64,
      "end": 15070.28,
      "formatted_start": "04:11:09.640",
      "formatted_end": "04:11:10.280",
      "text": "سه سالش"
    },
    {
      "id": 31,
      "start": 15070.28,
      "end": 15073.62,
      "formatted_start": "04:11:10.280",
      "formatted_end": "04:11:13.620",
      "text": "این اوله نه سه سالش خبر میشه"
    },
    {
      "id": 32,
      "start": 15073.62,
      "end": 15074.6,
      "formatted_start": "04:11:13.620",
      "formatted_end": "04:11:14.600",
      "text": "همدویتو؟"
    },
    {
      "id": 33,
      "start": 15074.6,
      "end": 15074.98,
      "formatted_start": "04:11:14.600",
      "formatted_end": "04:11:14.980",
      "text": "بله"
    },
    {
      "id": 34,
      "start": 15074.98,
      "end": 15077.0,
      "formatted_start": "04:11:14.980",
      "formatted_end": "04:11:17.000",
      "text": "همدویتو یه ساله برداری؟"
    },
    {
      "id": 35,
      "start": 15077.0,
      "end": 15079.18,
      "formatted_start": "04:11:17.000",
      "formatted_end": "04:11:19.180",
      "text": "بله"
    },
    {
      "id": 36,
      "start": 15079.18,
      "end": 15081.82,
      "formatted_start": "04:11:19.180",
      "formatted_end": "04:11:21.820",
      "text": "این گردانش پشت نیست درده"
    },
    {
      "id": 37,
      "start": 15081.82,
      "end": 15082.82,
      "formatted_start": "04:11:21.820",
      "formatted_end": "04:11:22.820",
      "text": "نه؟ بیز نوز"
    },
    {
      "id": 38,
      "start": 15082.82,
      "end": 15084.82,
      "formatted_start": "04:11:22.820",
      "formatted_end": "04:11:24.820",
      "text": "بعد اونو کارمون بردن هم خوبه؟"
    },
    {
      "id": 39,
      "start": 15084.82,
      "end": 15085.82,
      "formatted_start": "04:11:24.820",
      "formatted_end": "04:11:25.820",
      "text": "آه نه نه آفراد"
    },
    {
      "id": 40,
      "start": 15085.82,
      "end": 15086.82,
      "formatted_start": "04:11:25.820",
      "formatted_end": "04:11:26.820",
      "text": "دست اید"
    },
    {
      "id": 41,
      "start": 15086.82,
      "end": 15087.82,
      "formatted_start": "04:11:26.820",
      "formatted_end": "04:11:27.820",
      "text": "بیا دست اید"
    },
    {
      "id": 42,
      "start": 15087.82,
      "end": 15088.82,
      "formatted_start": "04:11:27.820",
      "formatted_end": "04:11:28.820",
      "text": "خیلی جدید"
    },
    {
      "id": 43,
      "start": 15088.82,
      "end": 15090.82,
      "formatted_start": "04:11:28.820",
      "formatted_end": "04:11:30.820",
      "text": "توشتو خونو بگو ببینم"
    },
    {
      "id": 44,
      "start": 15090.82,
      "end": 15091.82,
      "formatted_start": "04:11:30.820",
      "formatted_end": "04:11:31.820",
      "text": "ببینم"
    },
    {
      "id": 45,
      "start": 15091.82,
      "end": 15093.82,
      "formatted_start": "04:11:31.820",
      "formatted_end": "04:11:33.820",
      "text": "چرا شبابی فروری ببینم؟"
    },
    {
      "id": 46,
      "start": 15094.82,
      "end": 15096.82,
      "formatted_start": "04:11:34.820",
      "formatted_end": "04:11:36.820",
      "text": "این توشتو ببینم"
    },
    {
      "id": 47,
      "start": 15100.82,
      "end": 15103.82,
      "formatted_start": "04:11:40.820",
      "formatted_end": "04:11:43.820",
      "text": "خب خور خورم می کنه تو خواه"
    },
    {
      "id": 48,
      "start": 15103.82,
      "end": 15104.82,
      "formatted_start": "04:11:43.820",
      "formatted_end": "04:11:44.820",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 15104.82,
      "end": 15107.82,
      "formatted_start": "04:11:44.820",
      "formatted_end": "04:11:47.820",
      "text": "برای که از موقعات گرفتگی بینی داره"
    },
    {
      "id": 50,
      "start": 15108.82,
      "end": 15109.82,
      "formatted_start": "04:11:48.820",
      "formatted_end": "04:11:49.820",
      "text": "ده از باز کن"
    },
    {
      "id": 51,
      "start": 15109.82,
      "end": 15113.82,
      "formatted_start": "04:11:49.820",
      "formatted_end": "04:11:53.820",
      "text": "آه آه آه آه"
    },
    {
      "id": 52,
      "start": 15113.82,
      "end": 15115.82,
      "formatted_start": "04:11:53.820",
      "formatted_end": "04:11:55.820",
      "text": "خب"
    },
    {
      "id": 53,
      "start": 15115.82,
      "end": 15119.82,
      "formatted_start": "04:11:55.820",
      "formatted_end": "04:11:59.820",
      "text": "ببین اونجور که من دارم می کنم این مقدار ترشواتی پشت حلق داره"
    },
    {
      "id": 54,
      "start": 15119.82,
      "end": 15120.82,
      "formatted_start": "04:11:59.820",
      "formatted_end": "04:12:00.820",
      "text": "خب"
    },
    {
      "id": 55,
      "start": 15120.82,
      "end": 15124.82,
      "formatted_start": "04:12:00.820",
      "formatted_end": "04:12:04.820",
      "text": "این ترشواتی پشت حلق شبها که می خواهد پشت بینش میمونه"
    },
    {
      "id": 56,
      "start": 15124.82,
      "end": 15125.82,
      "formatted_start": "04:12:04.820",
      "formatted_end": "04:12:05.820",
      "text": "خب"
    },
    {
      "id": 57,
      "start": 15125.82,
      "end": 15127.82,
      "formatted_start": "04:12:05.820",
      "formatted_end": "04:12:07.820",
      "text": "خوب نمیتونی نفس بگشه"
    },
    {
      "id": 58,
      "start": 15127.82,
      "end": 15129.82,
      "formatted_start": "04:12:07.820",
      "formatted_end": "04:12:09.820",
      "text": "خب بیقرار می خواهد"
    },
    {
      "id": 59,
      "start": 15129.82,
      "end": 15132.82,
      "formatted_start": "04:12:09.820",
      "formatted_end": "04:12:12.820",
      "text": "صبح که بیدار میشه عطسه می کنه جمع تا این ترشواتش میاشه"
    },
    {
      "id": 60,
      "start": 15132.82,
      "end": 15134.82,
      "formatted_start": "04:12:12.820",
      "formatted_end": "04:12:14.820",
      "text": "حالا این پیدنش میخوردش میده"
    },
    {
      "id": 61,
      "start": 15134.82,
      "end": 15136.82,
      "formatted_start": "04:12:14.820",
      "formatted_end": "04:12:16.820",
      "text": "یکم بهتر میشه"
    },
    {
      "id": 62,
      "start": 15136.82,
      "end": 15138.82,
      "formatted_start": "04:12:16.820",
      "formatted_end": "04:12:18.820",
      "text": "این که چشمشو داره می خواهد اونه"
    },
    {
      "id": 63,
      "start": 15138.82,
      "end": 15140.82,
      "formatted_start": "04:12:18.820",
      "formatted_end": "04:12:20.820",
      "text": "این هم به خاطر آرژی شد"
    },
    {
      "id": 64,
      "start": 15140.82,
      "end": 15142.82,
      "formatted_start": "04:12:20.820",
      "formatted_end": "04:12:22.820",
      "text": "این کلن"
    },
    {
      "id": 65,
      "start": 15142.82,
      "end": 15144.82,
      "formatted_start": "04:12:22.820",
      "formatted_end": "04:12:24.820",
      "text": "تمام علایه این که شما باید گفتید"
    },
    {
      "id": 66,
      "start": 15144.82,
      "end": 15146.82,
      "formatted_start": "04:12:24.820",
      "formatted_end": "04:12:26.820",
      "text": "بیشتر میخورد که یک آرژی نشده"
    },
    {
      "id": 67,
      "start": 15146.82,
      "end": 15148.82,
      "formatted_start": "04:12:26.820",
      "formatted_end": "04:12:28.820",
      "text": "عکسه ی روزانه"
    },
    {
      "id": 68,
      "start": 15148.82,
      "end": 15150.82,
      "formatted_start": "04:12:28.820",
      "formatted_end": "04:12:30.820",
      "text": "شب دیگه قرار خوابیدن"
    },
    {
      "id": 69,
      "start": 15150.82,
      "end": 15152.82,
      "formatted_start": "04:12:30.820",
      "formatted_end": "04:12:32.820",
      "text": "دلیلیس چشاشو خاروندن"
    },
    {
      "id": 70,
      "start": 15152.82,
      "end": 15154.82,
      "formatted_start": "04:12:32.820",
      "formatted_end": "04:12:34.820",
      "text": "بعد حالا بزرگ"
    },
    {
      "id": 71,
      "start": 15154.82,
      "end": 15156.82,
      "formatted_start": "04:12:34.820",
      "formatted_end": "04:12:36.820",
      "text": "چشاشو هم بند ببینن که رفت"
    },
    {
      "id": 72,
      "start": 15158.82,
      "end": 15160.82,
      "formatted_start": "04:12:38.820",
      "formatted_end": "04:12:40.820",
      "text": "اونو هم چشاشو باز میخوان"
    },
    {
      "id": 73,
      "start": 15160.82,
      "end": 15162.82,
      "formatted_start": "04:12:40.820",
      "formatted_end": "04:12:42.820",
      "text": "دکتر ببینن"
    },
    {
      "id": 74,
      "start": 15162.82,
      "end": 15164.82,
      "formatted_start": "04:12:42.820",
      "formatted_end": "04:12:44.820",
      "text": "باشه باز"
    },
    {
      "id": 75,
      "start": 15164.82,
      "end": 15166.82,
      "formatted_start": "04:12:44.820",
      "formatted_end": "04:12:46.820",
      "text": "بامون"
    },
    {
      "id": 76,
      "start": 15168.82,
      "end": 15170.82,
      "formatted_start": "04:12:48.820",
      "formatted_end": "04:12:50.820",
      "text": "همم"
    },
    {
      "id": 77,
      "start": 15170.82,
      "end": 15172.82,
      "formatted_start": "04:12:50.820",
      "formatted_end": "04:12:52.820",
      "text": "منیگاه کن"
    },
    {
      "id": 78,
      "start": 15172.82,
      "end": 15174.82,
      "formatted_start": "04:12:52.820",
      "formatted_end": "04:12:54.820",
      "text": "تمام"
    },
    {
      "id": 79,
      "start": 15174.82,
      "end": 15180.82,
      "formatted_start": "04:12:54.820",
      "formatted_end": "04:13:00.820",
      "text": "خوالشش اینه که افمالیدن چشم بیشتر به خاطر آلرشی شد"
    },
    {
      "id": 80,
      "start": 15180.82,
      "end": 15182.82,
      "formatted_start": "04:13:00.820",
      "formatted_end": "04:13:02.820",
      "text": "آره یعنی حالا اونم که"
    },
    {
      "id": 81,
      "start": 15182.82,
      "end": 15184.82,
      "formatted_start": "04:13:02.820",
      "formatted_end": "04:13:04.820",
      "text": "اون که چشم بزرگم گفته کنارش"
    },
    {
      "id": 82,
      "start": 15184.82,
      "end": 15186.82,
      "formatted_start": "04:13:04.820",
      "formatted_end": "04:13:06.820",
      "text": "بله بیشتر به خاطر آلرشی"
    },
    {
      "id": 83,
      "start": 15186.82,
      "end": 15188.82,
      "formatted_start": "04:13:06.820",
      "formatted_end": "04:13:08.820",
      "text": "داروی زده آلرشی بشمیدیم"
    },
    {
      "id": 84,
      "start": 15188.82,
      "end": 15190.82,
      "formatted_start": "04:13:08.820",
      "formatted_end": "04:13:10.820",
      "text": "همه چشم بشه باشه؟"
    },
    {
      "id": 85,
      "start": 15190.82,
      "end": 15192.82,
      "formatted_start": "04:13:10.820",
      "formatted_end": "04:13:12.820",
      "text": "آره"
    },
    {
      "id": 86,
      "start": 15192.82,
      "end": 15194.82,
      "formatted_start": "04:13:12.820",
      "formatted_end": "04:13:14.820",
      "text": "ازید بگذاریم"
    },
    {
      "id": 87,
      "start": 15194.82,
      "end": 15196.82,
      "formatted_start": "04:13:14.820",
      "formatted_end": "04:13:16.820",
      "text": "باباشم در اینکه تصویر آلرشی باشه"
    },
    {
      "id": 88,
      "start": 15196.82,
      "end": 15200.82,
      "formatted_start": "04:13:16.820",
      "formatted_end": "04:13:20.820",
      "text": "خود شما خونه از من خیلی درنده"
    },
    {
      "id": 89,
      "start": 15202.82,
      "end": 15204.82,
      "formatted_start": "04:13:22.820",
      "formatted_end": "04:13:24.820",
      "text": "اسمش محمد سایم"
    },
    {
      "id": 90,
      "start": 15206.82,
      "end": 15208.82,
      "formatted_start": "04:13:26.820",
      "formatted_end": "04:13:28.820",
      "text": "چی میخواییم ببینیم؟"
    },
    {
      "id": 91,
      "start": 15208.82,
      "end": 15210.82,
      "formatted_start": "04:13:28.820",
      "formatted_end": "04:13:30.820",
      "text": "خب، میخوام بهت بیا"
    },
    {
      "id": 92,
      "start": 15211.82,
      "end": 15214.82,
      "formatted_start": "04:13:31.820",
      "formatted_end": "04:13:34.820",
      "text": "محمد میخوام بهت جایی ببین"
    },
    {
      "id": 93,
      "start": 15217.82,
      "end": 15219.82,
      "formatted_start": "04:13:37.820",
      "formatted_end": "04:13:39.820",
      "text": "محمدی تطارانی"
    },
    {
      "id": 94,
      "start": 15219.82,
      "end": 15221.82,
      "formatted_start": "04:13:39.820",
      "formatted_end": "04:13:41.820",
      "text": "آه، بسر"
    },
    {
      "id": 95,
      "start": 15221.82,
      "end": 15223.82,
      "formatted_start": "04:13:41.820",
      "formatted_end": "04:13:43.820",
      "text": "بگو"
    },
    {
      "id": 96,
      "start": 15223.82,
      "end": 15225.82,
      "formatted_start": "04:13:43.820",
      "formatted_end": "04:13:45.820",
      "text": "چه رنگیه؟"
    },
    {
      "id": 97,
      "start": 15225.82,
      "end": 15227.82,
      "formatted_start": "04:13:45.820",
      "formatted_end": "04:13:47.820",
      "text": "بلود"
    },
    {
      "id": 98,
      "start": 15227.82,
      "end": 15229.82,
      "formatted_start": "04:13:47.820",
      "formatted_end": "04:13:49.820",
      "text": "ره"
    },
    {
      "id": 99,
      "start": 15229.82,
      "end": 15231.82,
      "formatted_start": "04:13:49.820",
      "formatted_end": "04:13:51.820",
      "text": "این چه رنگیه؟"
    },
    {
      "id": 100,
      "start": 15231.82,
      "end": 15233.82,
      "formatted_start": "04:13:51.820",
      "formatted_end": "04:13:53.820",
      "text": "گرمی"
    },
    {
      "id": 101,
      "start": 15233.82,
      "end": 15235.82,
      "formatted_start": "04:13:53.820",
      "formatted_end": "04:13:55.820",
      "text": "همه ش مال خود"
    },
    {
      "id": 102,
      "start": 15235.82,
      "end": 15237.82,
      "formatted_start": "04:13:55.820",
      "formatted_end": "04:13:57.820",
      "text": "یک ساعت بیرون دارو باس کنی"
    },
    {
      "id": 103,
      "start": 15237.82,
      "end": 15239.82,
      "formatted_start": "04:13:57.820",
      "formatted_end": "04:13:59.820",
      "text": "باس"
    },
    {
      "id": 104,
      "start": 15239.82,
      "end": 15241.82,
      "formatted_start": "04:13:59.820",
      "formatted_end": "04:14:01.820",
      "text": "باس کنی؟"
    },
    {
      "id": 105,
      "start": 15241.82,
      "end": 15243.82,
      "formatted_start": "04:14:01.820",
      "formatted_end": "04:14:03.820",
      "text": "بریم تو ماشین و خالد زینب باس کن"
    },
    {
      "id": 106,
      "start": 15243.82,
      "end": 15245.82,
      "formatted_start": "04:14:03.820",
      "formatted_end": "04:14:05.820",
      "text": "باشه؟ بزنیم به ماشین"
    },
    {
      "id": 107,
      "start": 15245.82,
      "end": 15247.82,
      "formatted_start": "04:14:05.820",
      "formatted_end": "04:14:07.820",
      "text": "باشه؟"
    },
    {
      "id": 108,
      "start": 15247.82,
      "end": 15249.82,
      "formatted_start": "04:14:07.820",
      "formatted_end": "04:14:09.820",
      "text": "بیا بیا خاندو از تو خدا بزنی فهم"
    },
    {
      "id": 109,
      "start": 15250.62,
      "end": 15252.62,
      "formatted_start": "04:14:10.620",
      "formatted_end": "04:14:12.620",
      "text": "برو نیست خاندو از تو"
    },
    {
      "id": 110,
      "start": 15252.62,
      "end": 15254.22,
      "formatted_start": "04:14:12.620",
      "formatted_end": "04:14:14.220",
      "text": "بزنی خاندو از تو رو"
    },
    {
      "id": 111,
      "start": 15254.22,
      "end": 15255.02,
      "formatted_start": "04:14:14.220",
      "formatted_end": "04:14:15.020",
      "text": "ما آمدیم"
    },
    {
      "id": 112,
      "start": 15255.02,
      "end": 15255.94,
      "formatted_start": "04:14:15.020",
      "formatted_end": "04:14:15.940",
      "text": "میخواد دارم بالا"
    },
    {
      "id": 113,
      "start": 15255.94,
      "end": 15257.94,
      "formatted_start": "04:14:15.940",
      "formatted_end": "04:14:17.940",
      "text": "برو بالا برو بالا قدرتو بگیرم"
    },
    {
      "id": 114,
      "start": 15257.94,
      "end": 15260.98,
      "formatted_start": "04:14:17.940",
      "formatted_end": "04:14:20.980",
      "text": "برو دو قشنبای سو من قدرتو بگیرم"
    },
    {
      "id": 115,
      "start": 15260.98,
      "end": 15262.98,
      "formatted_start": "04:14:20.980",
      "formatted_end": "04:14:22.980",
      "text": "بزن خاندو از تو"
    },
    {
      "id": 116,
      "start": 15262.98,
      "end": 15264.98,
      "formatted_start": "04:14:22.980",
      "formatted_end": "04:14:24.980",
      "text": "برو دو"
    },
    {
      "id": 117,
      "start": 15264.98,
      "end": 15266.98,
      "formatted_start": "04:14:24.980",
      "formatted_end": "04:14:26.980",
      "text": "قدرتش کتا هست؟"
    },
    {
      "id": 118,
      "start": 15266.98,
      "end": 15268.98,
      "formatted_start": "04:14:26.980",
      "formatted_end": "04:14:28.980",
      "text": "این تو سه سال؟"
    },
    {
      "id": 119,
      "start": 15268.98,
      "end": 15270.66,
      "formatted_start": "04:14:28.980",
      "formatted_end": "04:14:30.660",
      "text": "خب"
    },
    {
      "id": 120,
      "start": 15270.66,
      "end": 15272.66,
      "formatted_start": "04:14:30.660",
      "formatted_end": "04:14:32.660",
      "text": "الان چند سالش هست؟"
    },
    {
      "id": 121,
      "start": 15272.66,
      "end": 15274.66,
      "formatted_start": "04:14:32.660",
      "formatted_end": "04:14:34.660",
      "text": "الان دقیقا یکی ماه تغلیل شد"
    },
    {
      "id": 122,
      "start": 15274.66,
      "end": 15276.66,
      "formatted_start": "04:14:34.660",
      "formatted_end": "04:14:36.660",
      "text": "سه سالش خوردش هست"
    },
    {
      "id": 123,
      "start": 15276.66,
      "end": 15277.16,
      "formatted_start": "04:14:36.660",
      "formatted_end": "04:14:37.160",
      "text": "خب"
    },
    {
      "id": 124,
      "start": 15277.16,
      "end": 15278.66,
      "formatted_start": "04:14:37.160",
      "formatted_end": "04:14:38.660",
      "text": "دستش چاردهه"
    },
    {
      "id": 125,
      "start": 15278.66,
      "end": 15280.66,
      "formatted_start": "04:14:38.660",
      "formatted_end": "04:14:40.660",
      "text": "پا تو چپت کن بگی باش چپت کن"
    },
    {
      "id": 126,
      "start": 15280.66,
      "end": 15282.66,
      "formatted_start": "04:14:40.660",
      "formatted_end": "04:14:42.660",
      "text": "باید نوز و پنج باشه دیگه تنها"
    },
    {
      "id": 127,
      "start": 15282.66,
      "end": 15284.66,
      "formatted_start": "04:14:42.660",
      "formatted_end": "04:14:44.660",
      "text": "چپت کن سا خواهیستان؟ سا؟ سا؟"
    },
    {
      "id": 128,
      "start": 15286.66,
      "end": 15287.66,
      "formatted_start": "04:14:46.660",
      "formatted_end": "04:14:47.660",
      "text": "دقیقا نوز و پنج"
    },
    {
      "id": 129,
      "start": 15287.66,
      "end": 15288.16,
      "formatted_start": "04:14:47.660",
      "formatted_end": "04:14:48.160",
      "text": "اوکی؟"
    },
    {
      "id": 130,
      "start": 15288.16,
      "end": 15288.66,
      "formatted_start": "04:14:48.160",
      "formatted_end": "04:14:48.660",
      "text": "آه آه"
    },
    {
      "id": 131,
      "start": 15288.66,
      "end": 15290.66,
      "formatted_start": "04:14:48.660",
      "formatted_end": "04:14:50.660",
      "text": "یه سانتاره کپشی کم کن"
    },
    {
      "id": 132,
      "start": 15290.66,
      "end": 15292.66,
      "formatted_start": "04:14:50.660",
      "formatted_end": "04:14:52.660",
      "text": "بشه نوز و پنج"
    },
    {
      "id": 133,
      "start": 15292.66,
      "end": 15294.66,
      "formatted_start": "04:14:52.660",
      "formatted_end": "04:14:54.660",
      "text": "پرونن بچه سه ساله"
    },
    {
      "id": 134,
      "start": 15294.66,
      "end": 15296.66,
      "formatted_start": "04:14:54.660",
      "formatted_end": "04:14:56.660",
      "text": "بین نوز و ستر"
    },
    {
      "id": 135,
      "start": 15296.66,
      "end": 15298.66,
      "formatted_start": "04:14:56.660",
      "formatted_end": "04:14:58.660",
      "text": "نوز و هزار"
    },
    {
      "id": 136,
      "start": 15298.66,
      "end": 15300.66,
      "formatted_start": "04:14:58.660",
      "formatted_end": "04:15:00.660",
      "text": "پشتش خوبه؟ بس نشتی؟"
    }
  ],
  "status": "completed"
}