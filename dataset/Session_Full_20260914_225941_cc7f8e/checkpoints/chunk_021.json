      "formatted_start": "01:48:21.480",
      "formatted_end": "01:48:23.480",
      "text": "اگر پایین نمی آمده باشه درسته باشه"
    },
    {
      "id": 77,
      "start": 6503.48,
      "end": 6505.48,
      "formatted_start": "01:48:23.480",
      "formatted_end": "01:48:25.480",
      "text": "اگر پایین نمی آمده باشه درسته باشه"
    },
    {
      "id": 78,
      "start": 6505.48,
      "end": 6507.48,
      "formatted_start": "01:48:25.480",
      "formatted_end": "01:48:27.480",
      "text": "اگر پایین نمی آمده باشه درسته باشه"
    },
    {
      "id": 79,
      "start": 6507.48,
      "end": 6509.48,
      "formatted_start": "01:48:27.480",
      "formatted_end": "01:48:29.480",
      "text": "شب استامی رو هندادم نه"
    },
    {
      "id": 80,
      "start": 6509.48,
      "end": 6510.48,
      "formatted_start": "01:48:29.480",
      "formatted_end": "01:48:30.480",
      "text": "یه های ده نه"
    },
    {
      "id": 81,
      "start": 6510.48,
      "end": 6511.48,
      "formatted_start": "01:48:30.480",
      "formatted_end": "01:48:31.480",
      "text": "شیاب دادی؟"
    },
    {
      "id": 82,
      "start": 6511.48,
      "end": 6512.48,
      "formatted_start": "01:48:31.480",
      "formatted_end": "01:48:32.480",
      "text": "چقدر؟"
    },
    {
      "id": 83,
      "start": 6512.48,
      "end": 6513.48,
      "formatted_start": "01:48:32.480",
      "formatted_end": "01:48:33.480",
      "text": "سی سی سی دادن"
    },
    {
      "id": 84,
      "start": 6513.48,
      "end": 6515.48,
      "formatted_start": "01:48:33.480",
      "formatted_end": "01:48:35.480",
      "text": "دو شربت"
    },
    {
      "id": 85,
      "start": 6515.48,
      "end": 6519.48,
      "formatted_start": "01:48:35.480",
      "formatted_end": "01:48:39.480",
      "text": "شربتشو باید به اندازه نصف وزن به علاقه یش بدی"
    },
    {
      "id": 86,
      "start": 6519.48,
      "end": 6522.48,
      "formatted_start": "01:48:39.480",
      "formatted_end": "01:48:42.480",
      "text": "این تقریبا ده کیلو آن و شیش سی سی بهش باشه"
    },
    {
      "id": 87,
      "start": 6522.48,
      "end": 6523.48,
      "formatted_start": "01:48:42.480",
      "formatted_end": "01:48:43.480",
      "text": "شیش سی سی؟"
    },
    {
      "id": 88,
      "start": 6523.48,
      "end": 6524.48,
      "formatted_start": "01:48:43.480",
      "formatted_end": "01:48:44.480",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 6524.48,
      "end": 6526.48,
      "formatted_start": "01:48:44.480",
      "formatted_end": "01:48:46.480",
      "text": "من قد شد شما میدونید که یک کنی نیست بیاده"
    },
    {
      "id": 90,
      "start": 6526.48,
      "end": 6529.48,
      "formatted_start": "01:48:46.480",
      "formatted_end": "01:48:49.480",
      "text": "یه هرز جدون به علاقه اون نصف بگذاره"
    },
    {
      "id": 91,
      "start": 6529.48,
      "end": 6531.48,
      "formatted_start": "01:48:49.480",
      "formatted_end": "01:48:51.480",
      "text": "من شیاب هم گذاشتم تبشه زیاد نیابده"
    },
    {
      "id": 92,
      "start": 6531.48,
      "end": 6561.48,
      "formatted_start": "01:48:51.480",
      "formatted_end": "01:49:21.480",
      "text": "اینجا با اینکه اینجا با اینکه اینجا با اینکه اینجا با اینکه اینجا با اینکه اینجا با اینکه اینجا با اینکه اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینج"
    },
    {
      "id": 93,
      "start": 6561.48,
      "end": 6563.48,
      "formatted_start": "01:49:21.480",
      "formatted_end": "01:49:23.480",
      "text": "درست داشتی؟"
    },
    {
      "id": 94,
      "start": 6563.48,
      "end": 6565.48,
      "formatted_start": "01:49:23.480",
      "formatted_end": "01:49:25.480",
      "text": "آره"
    },
    {
      "id": 95,
      "start": 6569.48,
      "end": 6571.48,
      "formatted_start": "01:49:29.480",
      "formatted_end": "01:49:31.480",
      "text": "شست و سه، شست و چهار، هشت"
    },
    {
      "id": 96,
      "start": 6575.48,
      "end": 6577.48,
      "formatted_start": "01:49:35.480",
      "formatted_end": "01:49:37.480",
      "text": "خب کلس چند رو میره؟"
    },
    {
      "id": 97,
      "start": 6577.48,
      "end": 6579.48,
      "formatted_start": "01:49:37.480",
      "formatted_end": "01:49:39.480",
      "text": "مهد میره"
    },
    {
      "id": 98,
      "start": 6579.48,
      "end": 6581.48,
      "formatted_start": "01:49:39.480",
      "formatted_end": "01:49:41.480",
      "text": "هنجا"
    },
    {
      "id": 99,
      "start": 6581.48,
      "end": 6583.48,
      "formatted_start": "01:49:41.480",
      "formatted_end": "01:49:43.480",
      "text": "هنجا"
    },
    {
      "id": 100,
      "start": 6583.48,
      "end": 6585.48,
      "formatted_start": "01:49:43.480",
      "formatted_end": "01:49:45.480",
      "text": "یه دونه بهر"
    },
    {
      "id": 101,
      "start": 6585.48,
      "end": 6587.48,
      "formatted_start": "01:49:45.480",
      "formatted_end": "01:49:47.480",
      "text": "کتاب دستان میده؟"
    },
    {
      "id": 102,
      "start": 6587.48,
      "end": 6589.48,
      "formatted_start": "01:49:47.480",
      "formatted_end": "01:49:49.480",
      "text": "دستان میره"
    },
    {
      "id": 103,
      "start": 6589.48,
      "end": 6592.92,
      "formatted_start": "01:49:49.480",
      "formatted_end": "01:49:52.920",
      "text": "مارد برچست دارم"
    },
    {
      "id": 104,
      "start": 6592.92,
      "end": 6594.54,
      "formatted_start": "01:49:52.920",
      "formatted_end": "01:49:54.540",
      "text": "ببین کدوماشو که بخورید"
    },
    {
      "id": 105,
      "start": 6594.54,
      "end": 6596.1,
      "formatted_start": "01:49:54.540",
      "formatted_end": "01:49:56.100",
      "text": "خرس دارم"
    },
    {
      "id": 106,
      "start": 6596.1,
      "end": 6597.22,
      "formatted_start": "01:49:56.100",
      "formatted_end": "01:49:57.220",
      "text": "زروافه دارم"
    },
    {
      "id": 107,
      "start": 6597.22,
      "end": 6598.0,
      "formatted_start": "01:49:57.220",
      "formatted_end": "01:49:58.000",
      "text": "سیر دارم"
    },
    {
      "id": 108,
      "start": 6598.0,
      "end": 6598.82,
      "formatted_start": "01:49:58.000",
      "formatted_end": "01:49:58.820",
      "text": "شیر دارم"
    },
    {
      "id": 109,
      "start": 6598.82,
      "end": 6599.54,
      "formatted_start": "01:49:58.820",
      "formatted_end": "01:49:59.540",
      "text": "یه مکو"
    }
