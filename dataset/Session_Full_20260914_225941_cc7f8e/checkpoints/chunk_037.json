  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11102.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:02.000",
      "text": "این شاش بود ترکی؟"
    },
    {
      "id": 1,
      "start": 11102.0,
      "end": 11104.0,
      "formatted_start": "03:05:02.000",
      "formatted_end": "03:05:04.000",
      "text": "نه دسترس هست اینجا."
    },
    {
      "id": 2,
      "start": 11104.0,
      "end": 11106.0,
      "formatted_start": "03:05:04.000",
      "formatted_end": "03:05:06.000",
      "text": "ایه؟"
    },
    {
      "id": 3,
      "start": 11106.0,
      "end": 11108.0,
      "formatted_start": "03:05:06.000",
      "formatted_end": "03:05:08.000",
      "text": "زده رو اینجا داری؟"
    },
    {
      "id": 4,
      "start": 11108.0,
      "end": 11110.0,
      "formatted_start": "03:05:08.000",
      "formatted_end": "03:05:10.000",
      "text": "خب دختر بگو ببین."
    },
    {
      "id": 5,
      "start": 11110.0,
      "end": 11112.0,
      "formatted_start": "03:05:10.000",
      "formatted_end": "03:05:12.000",
      "text": "کنو اینا."
    },
    {
      "id": 6,
      "start": 11112.0,
      "end": 11114.0,
      "formatted_start": "03:05:12.000",
      "formatted_end": "03:05:14.000",
      "text": "اینجا باز بشتن بشه."
    },
    {
      "id": 7,
      "start": 11114.0,
      "end": 11116.0,
      "formatted_start": "03:05:14.000",
      "formatted_end": "03:05:16.000",
      "text": "اون شاشه؟ من اینجا."
    },
    {
      "id": 8,
      "start": 11116.0,
      "end": 11118.0,
      "formatted_start": "03:05:16.000",
      "formatted_end": "03:05:18.000",
      "text": "اون شاش باید بزاری."
    },
    {
      "id": 9,
      "start": 11118.0,
      "end": 11120.0,
      "formatted_start": "03:05:18.000",
      "formatted_end": "03:05:20.000",
      "text": "گفت ده نه یالی دسترس."
    },
    {
      "id": 10,
      "start": 11120.0,
      "end": 11122.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:22.000",
      "text": "نه نه، اومدم ده نه، اون سطح درسته ببین."
    },
    {
      "id": 11,
      "start": 11130.0,
      "end": 11160.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:06:00.000",
      "text": "از اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 12,
      "start": 11160.0,
      "end": 11189.98,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:29.980",
      "text": "مردم درست دارید"
    },
    {
      "id": 13,
      "start": 11190.0,
      "end": 11220.0,
      "formatted_start": "03:06:30.000",
      "formatted_end": "03:07:00.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید برداری"
    },
    {
      "id": 14,
      "start": 11220.0,
      "end": 11222.0,
      "formatted_start": "03:07:00.000",
      "formatted_end": "03:07:02.000",
      "text": "اون رسیوله؟"
    },
    {
      "id": 15,
      "start": 11222.0,
      "end": 11224.0,
      "formatted_start": "03:07:02.000",
      "formatted_end": "03:07:04.000",
      "text": "اون رسیوله نرژ"
    },
    {
      "id": 16,
      "start": 11224.0,
      "end": 11226.0,
      "formatted_start": "03:07:04.000",
      "formatted_end": "03:07:06.000",
      "text": "رسیوله نرژ"
    },
    {
      "id": 17,
      "start": 11226.0,
      "end": 11230.0,
      "formatted_start": "03:07:06.000",
      "formatted_end": "03:07:10.000",
      "text": "در وقتی اونکرد من قبل از اینکه برم اونجا رفتم به بیمارستان"
    },
    {
      "id": 18,
      "start": 11230.0,
      "end": 11234.0,
      "formatted_start": "03:07:10.000",
      "formatted_end": "03:07:14.000",
      "text": "دوباره از اونجا سبیه آستم و بعدم برم به بیمارستان به درباره بیمارستان بودم"
    },
    {
      "id": 19,
      "start": 11234.0,
      "end": 11236.0,
      "formatted_start": "03:07:14.000",
      "formatted_end": "03:07:16.000",
      "text": "چجوری میرفتم یونگا از این زنم"
    },
    {
      "id": 20,
      "start": 11236.0,
      "end": 11238.0,
      "formatted_start": "03:07:16.000",
      "formatted_end": "03:07:18.000",
      "text": "آره ببین"
    },
    {
      "id": 21,
      "start": 11238.0,
      "end": 11240.0,
      "formatted_start": "03:07:18.000",
      "formatted_end": "03:07:20.000",
      "text": "این روز هم وقت داشتم برم"
    },
    {
      "id": 22,
      "start": 11240.0,
      "end": 11242.0,
      "formatted_start": "03:07:20.000",
      "formatted_end": "03:07:22.000",
      "text": "بیمارستان الان نیمیرده"
    },
    {
      "id": 23,
      "start": 11250.0,
      "end": 11280.0,
      "formatted_start": "03:07:30.000",
      "formatted_end": "03:08:00.000",
      "text": "مردم باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید"
    },
    {
      "id": 24,
      "start": 11280.0,
      "end": 11283.0,
      "formatted_start": "03:08:00.000",
      "formatted_end": "03:08:03.000",
      "text": "ببینی؟ سر طرف هم با دنده چی شده؟"
    },
    {
      "id": 25,
      "start": 11285.0,
      "end": 11288.0,
      "formatted_start": "03:08:05.000",
      "formatted_end": "03:08:08.000",
      "text": "در اینجا من چند مرد شکلش کاملی میخورم"
    },
    {
      "id": 26,
      "start": 11289.0,
      "end": 11290.0,
      "formatted_start": "03:08:09.000",
      "formatted_end": "03:08:10.000",
      "text": "خب چند ماهشه؟"
    },
    {
      "id": 27,
      "start": 11290.0,
      "end": 11292.0,
      "formatted_start": "03:08:10.000",
      "formatted_end": "03:08:12.000",
      "text": "سه ماه هست"
    },
    {
      "id": 28,
      "start": 11294.0,
      "end": 11296.0,
      "formatted_start": "03:08:14.000",
      "formatted_end": "03:08:16.000",
      "text": "حافظ بله؟"
    },
    {
      "id": 29,
      "start": 11296.0,
      "end": 11298.0,
      "formatted_start": "03:08:16.000",
      "formatted_end": "03:08:18.000",
      "text": "سه ماه و چهاره"
    },
    {
      "id": 30,
      "start": 11298.0,
      "end": 11300.0,
      "formatted_start": "03:08:18.000",
      "formatted_end": "03:08:20.000",
      "text": "سه ماه و چهاره، شیر چی میخوره؟"
    },
    {
      "id": 31,
      "start": 11300.0,
      "end": 11302.0,
      "formatted_start": "03:08:20.000",
      "formatted_end": "03:08:22.000",
      "text": "شیر و خودم"
    },
    {
      "id": 32,
      "start": 11302.0,
      "end": 11304.0,
      "formatted_start": "03:08:22.000",
      "formatted_end": "03:08:24.000",
      "text": "همیشه شیر و خودتون با درد میشون"
    },
    {
      "id": 33,
      "start": 11304.0,
      "end": 11307.0,
      "formatted_start": "03:08:24.000",
      "formatted_end": "03:08:27.000",
      "text": "خب، چند را نزدیک سه و هفته است، چه کمش خواهی می کنی؟"
    },
    {
      "id": 34,
      "start": 11307.0,
      "end": 11313.0,
      "formatted_start": "03:08:27.000",
      "formatted_end": "03:08:33.000",
      "text": "برده شیاخ کار می کنند، ولی بردهش کار نمی کنند"
    },
    {
      "id": 35,
      "start": 11313.0,
      "end": 11316.0,
      "formatted_start": "03:08:33.000",
      "formatted_end": "03:08:36.000",
      "text": "خب، مثلا چند روز می شه شیاخ می زدن؟"
    },
    {
      "id": 36,
      "start": 11316.0,
      "end": 11321.0,
      "formatted_start": "03:08:36.000",
      "formatted_end": "03:08:41.000",
      "text": "دو بار بزنشتن، با فاصله، نه بردهش کار نمی کنند"
    },
    {
      "id": 37,
      "start": 11321.0,
      "end": 11325.0,
      "formatted_start": "03:08:41.000",
      "formatted_end": "03:08:45.000",
      "text": "یعنی چهار روز که می شه کار نمی کنند، شیاخ می زدن؟"
    },
    {
      "id": 38,
      "start": 11325.0,
      "end": 11326.0,
      "formatted_start": "03:08:45.000",
      "formatted_end": "03:08:46.000",
      "text": "نه"
    },
    {
      "id": 39,
      "start": 11326.0,
      "end": 11328.0,
      "formatted_start": "03:08:46.000",
      "formatted_end": "03:08:48.000",
      "text": "و بعد از اینکه شیاخ می زدن، کار می کنند؟"
    },
    {
      "id": 40,
      "start": 11328.0,
      "end": 11333.0,
      "formatted_start": "03:08:48.000",
      "formatted_end": "03:08:53.000",
      "text": "شل زیادر هست"
    },
    {
      "id": 41,
      "start": 11333.0,
      "end": 11335.0,
      "formatted_start": "03:08:53.000",
      "formatted_end": "03:08:55.000",
      "text": "بله، خشکش هست"
    },
    {
      "id": 42,
      "start": 11345.0,
      "end": 11347.0,
      "formatted_start": "03:09:05.000",
      "formatted_end": "03:09:07.000",
      "text": "دادو چی بوده ایشون میدی؟"
    },
    {
      "id": 43,
      "start": 11347.0,
      "end": 11349.0,
      "formatted_start": "03:09:07.000",
      "formatted_end": "03:09:09.000",
      "text": "نه، چیز هست، فقط عاده"
    },
    {
      "id": 44,
      "start": 11349.0,
      "end": 11351.0,
      "formatted_start": "03:09:09.000",
      "formatted_end": "03:09:11.000",
      "text": "عاده باشی، یک قبلا نمیدادی؟"
    },
    {
      "id": 45,
      "start": 11351.0,
      "end": 11356.0,
      "formatted_start": "03:09:11.000",
      "formatted_end": "03:09:16.000",
      "text": "آره، خب لعونم که شبت برای کلیک میدادن، اون په دیابست"
    },
    {
      "id": 46,
      "start": 11356.0,
      "end": 11359.0,
      "formatted_start": "03:09:16.000",
      "formatted_end": "03:09:19.000",
      "text": "از اون میدادن که اون رو بکردن، اینکه هم ندارم"
    },
    {
      "id": 47,
      "start": 11359.0,
      "end": 11364.0,
      "formatted_start": "03:09:19.000",
      "formatted_end": "03:09:24.000",
      "text": "اونوقت که پیدا به صبح میدادی خوب کار میکرده کنه"
    },
    {
      "id": 48,
      "start": 11364.0,
      "end": 11367.0,
      "formatted_start": "03:09:24.000",
      "formatted_end": "03:09:27.000",
      "text": "اونوقت چند بر به چند بر کار میکرده"
    },
    {
      "id": 49,
      "start": 11367.0,
      "end": 11371.0,
      "formatted_start": "03:09:27.000",
      "formatted_end": "03:09:31.000",
      "text": "اون روزی چند بر کار میدهد"
    },
    {
      "id": 50,
      "start": 11371.0,
      "end": 11375.0,
      "formatted_start": "03:09:31.000",
      "formatted_end": "03:09:35.000",
      "text": "اینقدر افتاده میزیا کنه که اون روزی کنه دیگه تطریق کنه"
    },
    {
      "id": 51,
      "start": 11375.0,
      "end": 11378.0,
      "formatted_start": "03:09:35.000",
      "formatted_end": "03:09:38.000",
      "text": "خب این چند بر خوده"
    },
    {
      "id": 52,
      "start": 11378.0,
      "end": 11380.0,
      "formatted_start": "03:09:38.000",
      "formatted_end": "03:09:40.000",
      "text": "شیر بیاد نخوردی؟"
    },
    {
      "id": 53,
      "start": 11380.0,
      "end": 11381.0,
      "formatted_start": "03:09:40.000",
      "formatted_end": "03:09:41.000",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 11381.0,
      "end": 11383.0,
      "formatted_start": "03:09:41.000",
      "formatted_end": "03:09:43.000",
      "text": "نه شیر دو مثلا"
    },
    {
      "id": 55,
      "start": 11383.0,
      "end": 11385.0,
      "formatted_start": "03:09:43.000",
      "formatted_end": "03:09:45.000",
      "text": "خب اینجور با یه دیوان شیر با خود"
    },
    {
      "id": 56,
      "start": 11385.0,
      "end": 11386.0,
      "formatted_start": "03:09:45.000",
      "formatted_end": "03:09:46.000",
      "text": "بستر نمیدونی؟"
    },
    {
      "id": 57,
      "start": 11386.0,
      "end": 11388.0,
      "formatted_start": "03:09:46.000",
      "formatted_end": "03:09:48.000",
      "text": "بستر نمیخورم نمیدونی"
    },
    {
      "id": 58,
      "start": 11388.0,
      "end": 11390.0,
      "formatted_start": "03:09:48.000",
      "formatted_end": "03:09:50.000",
      "text": "بیشتر ستنتیه"
    },
    {
      "id": 59,
      "start": 11390.0,
      "end": 11392.0,
      "formatted_start": "03:09:50.000",
      "formatted_end": "03:09:52.000",
      "text": "هست دو پونست"
    },
    {
      "id": 60,
      "start": 11392.0,
      "end": 11394.0,
      "formatted_start": "03:09:52.000",
      "formatted_end": "03:09:54.000",
      "text": "چقدر دو نیمونه؟"
    },
    {
      "id": 61,
      "start": 11394.0,
      "end": 11396.0,
      "formatted_start": "03:09:54.000",
      "formatted_end": "03:09:56.000",
      "text": "ستنتیه"
    },
    {
      "id": 62,
      "start": 11396.0,
      "end": 11398.0,
      "formatted_start": "03:09:56.000",
      "formatted_end": "03:09:58.000",
      "text": "ستنتیه خیلی خوب شده باشه"
    }
  ],
  "status": "completed"
}