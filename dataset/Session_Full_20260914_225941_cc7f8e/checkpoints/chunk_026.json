  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7803.5,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:03.500",
      "text": "یعنی من نمیتونم بخواهم، نه میمونم این دار چیه."
    },
    {
      "id": 1,
      "start": 7803.5,
      "end": 7809.8,
      "formatted_start": "02:10:03.500",
      "formatted_end": "02:10:09.800",
      "text": "اوه، خب، دارو نسخه شیر. شبا، نقش حالا مثلا بچه خوابه، کمتر توی خوابه،"
    },
    {
      "id": 2,
      "start": 7809.8,
      "end": 7813.7,
      "formatted_start": "02:10:09.800",
      "formatted_end": "02:10:13.700",
      "text": "اصلا کلن بچه ها تو خواب شیر خوردنشون میفترن. باب؟"
    },
    {
      "id": 3,
      "start": 7813.7,
      "end": 7816.0,
      "formatted_start": "02:10:13.700",
      "formatted_end": "02:10:16.000",
      "text": "چون فقط قریضه این مکیدنشونه."
    },
    {
      "id": 4,
      "start": 7816.0,
      "end": 7825.0,
      "formatted_start": "02:10:16.000",
      "formatted_end": "02:10:25.000",
      "text": "ولی روزا که خوشیانترن، حالا نقشه کم، مثلا حالا یه ذره سیر بودن، یه ذره حواسشون این برنامه باشه، ترس بیدارن."
    },
    {
      "id": 5,
      "start": 7825.0,
      "end": 7828.66,
      "formatted_start": "02:10:25.000",
      "formatted_end": "02:10:28.660",
      "text": "دو فرق هم نگرد دارم که همون 60-200 رو بخوره"
    },
    {
      "id": 6,
      "start": 7828.66,
      "end": 7830.24,
      "formatted_start": "02:10:28.660",
      "formatted_end": "02:10:30.240",
      "text": "که اصلا میخواد چی بشه"
    },
    {
      "id": 7,
      "start": 7830.24,
      "end": 7831.24,
      "formatted_start": "02:10:30.240",
      "formatted_end": "02:10:31.240",
      "text": "گفت بخور خور خور"
    },
    {
      "id": 8,
      "start": 7831.24,
      "end": 7835.24,
      "formatted_start": "02:10:31.240",
      "formatted_end": "02:10:35.240",
      "text": "خیلی بولو جکیه از الان اینقدر ناس داری"
    },
    {
      "id": 9,
      "start": 7835.24,
      "end": 7837.62,
      "formatted_start": "02:10:35.240",
      "formatted_end": "02:10:37.620",
      "text": "بعد مکی رنگش باید خوب آمده"
    },
    {
      "id": 10,
      "start": 7837.62,
      "end": 7839.84,
      "formatted_start": "02:10:37.620",
      "formatted_end": "02:10:39.840",
      "text": "شب عالیه با همین سه قصد"
    },
    {
      "id": 11,
      "start": 7839.84,
      "end": 7842.2,
      "formatted_start": "02:10:39.840",
      "formatted_end": "02:10:42.200",
      "text": "ولی روز میگن بازی مفهوم"
    },
    {
      "id": 12,
      "start": 7842.2,
      "end": 7843.74,
      "formatted_start": "02:10:42.200",
      "formatted_end": "02:10:43.740",
      "text": "که بعد اصلا زور میزنیم"
    },
    {
      "id": 13,
      "start": 7843.74,
      "end": 7845.6,
      "formatted_start": "02:10:43.740",
      "formatted_end": "02:10:45.600",
      "text": "اصلا به اون خوچه چنگ میزنیم"
    },
    {
      "id": 14,
      "start": 7845.6,
      "end": 7846.82,
      "formatted_start": "02:10:45.600",
      "formatted_end": "02:10:46.820",
      "text": "یعنی این نمیاد"
    },
    {
      "id": 15,
      "start": 7846.82,
      "end": 7848.94,
      "formatted_start": "02:10:46.820",
      "formatted_end": "02:10:48.940",
      "text": "بعد پس دونک هم که نمیگیره"
    },
    {
      "id": 16,
      "start": 7848.94,
      "end": 7850.04,
      "formatted_start": "02:10:48.940",
      "formatted_end": "02:10:50.040",
      "text": "میداز و بیرون میگرد"
    },
    {
      "id": 17,
      "start": 7850.04,
      "end": 7854.04,
      "formatted_start": "02:10:50.040",
      "formatted_end": "02:10:54.040",
      "text": "از این وضعیت باید بگیرید که افتاده نمی آساند"
    },
    {
      "id": 18,
      "start": 7854.04,
      "end": 7858.04,
      "formatted_start": "02:10:54.040",
      "formatted_end": "02:10:58.040",
      "text": "این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 19,
      "start": 7858.04,
      "end": 7862.04,
      "formatted_start": "02:10:58.040",
      "formatted_end": "02:11:02.040",
      "text": "از این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 20,
      "start": 7862.04,
      "end": 7866.04,
      "formatted_start": "02:11:02.040",
      "formatted_end": "02:11:06.040",
      "text": "از این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 21,
      "start": 7866.04,
      "end": 7870.04,
      "formatted_start": "02:11:06.040",
      "formatted_end": "02:11:10.040",
      "text": "از این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 22,
      "start": 7870.04,
      "end": 7874.04,
      "formatted_start": "02:11:10.040",
      "formatted_end": "02:11:14.040",
      "text": "از این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 23,
      "start": 7874.04,
      "end": 7878.04,
      "formatted_start": "02:11:14.040",
      "formatted_end": "02:11:18.040",
      "text": "از این وضعیت باید بگیرید که شبهه است"
    },
    {
      "id": 24,
      "start": 7878.04,
      "end": 7880.04,
      "formatted_start": "02:11:18.040",
      "formatted_end": "02:11:20.040",
      "text": "از این برداره نازم کنه"
    },
    {
      "id": 25,
      "start": 7880.04,
      "end": 7882.04,
      "formatted_start": "02:11:20.040",
      "formatted_end": "02:11:22.040",
      "text": "آهان"
    },
    {
      "id": 26,
      "start": 7882.04,
      "end": 7886.04,
      "formatted_start": "02:11:22.040",
      "formatted_end": "02:11:26.040",
      "text": "بله خب این قرشنک بودرت مکینه اونش برداره"
    },
    {
      "id": 27,
      "start": 7886.04,
      "end": 7888.04,
      "formatted_start": "02:11:26.040",
      "formatted_end": "02:11:28.040",
      "text": "نه نگه با نقش"
    },
    {
      "id": 28,
      "start": 7888.04,
      "end": 7890.04,
      "formatted_start": "02:11:28.040",
      "formatted_end": "02:11:30.040",
      "text": "خب پیش فروگیوتی که همیدونی"
    },
    {
      "id": 29,
      "start": 7890.04,
      "end": 7892.04,
      "formatted_start": "02:11:30.040",
      "formatted_end": "02:11:32.040",
      "text": "چیش میدونی؟"
    },
    {
      "id": 30,
      "start": 7892.04,
      "end": 7894.04,
      "formatted_start": "02:11:32.040",
      "formatted_end": "02:11:34.040",
      "text": "مایولت برداره"
    },
    {
      "id": 31,
      "start": 7894.04,
      "end": 7896.04,
      "formatted_start": "02:11:34.040",
      "formatted_end": "02:11:36.040",
      "text": "مایولت برداره"
    },
    {
      "id": 32,
      "start": 7896.04,
      "end": 7898.04,
      "formatted_start": "02:11:36.040",
      "formatted_end": "02:11:38.040",
      "text": "من هم تموم شد بایلاسی"
    },
    {
      "id": 33,
      "start": 7898.04,
      "end": 7900.04,
      "formatted_start": "02:11:38.040",
      "formatted_end": "02:11:40.040",
      "text": "نه داره"
    },
    {
      "id": 34,
      "start": 7900.04,
      "end": 7902.04,
      "formatted_start": "02:11:40.040",
      "formatted_end": "02:11:42.040",
      "text": "بله آخرها شدید"
    },
    {
      "id": 35,
      "start": 7902.04,
      "end": 7904.04,
      "formatted_start": "02:11:42.040",
      "formatted_end": "02:11:44.040",
      "text": "بله اگه تموم شد پدیلاسی برداره"
    },
    {
      "id": 36,
      "start": 7904.04,
      "end": 7906.04,
      "formatted_start": "02:11:44.040",
      "formatted_end": "02:11:46.040",
      "text": "این سرش پدیلاس برداره"
    },
    {
      "id": 37,
      "start": 7906.04,
      "end": 7915.04,
      "formatted_start": "02:11:46.040",
      "formatted_end": "02:11:55.040",
      "text": "اینجا پدیلات بهتر. مطرح پدیلات روزی بهش 15 قطر. آقا میتونی بیرون سیارتان روشیدش."
    },
    {
      "id": 38,
      "start": 7916.04,
      "end": 7919.04,
      "formatted_start": "02:11:56.040",
      "formatted_end": "02:11:59.040",
      "text": "از کولیفتر بازیدن. دو میتر افراد نترسید."
    },
    {
      "id": 39,
      "start": 7919.04,
      "end": 7921.04,
      "formatted_start": "02:11:59.040",
      "formatted_end": "02:12:01.040",
      "text": "سه بار کولیفتر رو میتونیم بگم؟"
    },
    {
      "id": 40,
      "start": 7921.04,
      "end": 7922.04,
      "formatted_start": "02:12:01.040",
      "formatted_end": "02:12:02.040",
      "text": "هم باید."
    },
    {
      "id": 41,
      "start": 7922.04,
      "end": 7923.04,
      "formatted_start": "02:12:02.040",
      "formatted_end": "02:12:03.040",
      "text": "و هم پنج بار بگم؟"
    },
    {
      "id": 42,
      "start": 7923.04,
      "end": 7924.04,
      "formatted_start": "02:12:03.040",
      "formatted_end": "02:12:04.040",
      "text": "پنج بار بگم."
    },
    {
      "id": 43,
      "start": 7924.04,
      "end": 7926.04,
      "formatted_start": "02:12:04.040",
      "formatted_end": "02:12:06.040",
      "text": "اون هشت پنج رو هم دونیم سیستی؟"
    },
    {
      "id": 44,
      "start": 7926.04,
      "end": 7928.04,
      "formatted_start": "02:12:06.040",
      "formatted_end": "02:12:08.040",
      "text": "دونیم سیستی. آقا."
    },
    {
      "id": 45,
      "start": 7929.04,
      "end": 7931.04,
      "formatted_start": "02:12:09.040",
      "formatted_end": "02:12:11.040",
      "text": "اما دونیم میشه؟ دونیم میشه؟"
    },
    {
      "id": 46,
      "start": 7931.04,
      "end": 7933.04,
      "formatted_start": "02:12:11.040",
      "formatted_end": "02:12:13.040",
      "text": "دو و نیم سه سی"
    },
    {
      "id": 47,
      "start": 7933.04,
      "end": 7935.04,
      "formatted_start": "02:12:13.040",
      "formatted_end": "02:12:15.040",
      "text": "دو و نیم درست میشه"
    },
    {
      "id": 48,
      "start": 7935.04,
      "end": 7937.04,
      "formatted_start": "02:12:15.040",
      "formatted_end": "02:12:17.040",
      "text": "اگر پیمونه دارو داری"
    },
    {
      "id": 49,
      "start": 7937.04,
      "end": 7939.04,
      "formatted_start": "02:12:17.040",
      "formatted_end": "02:12:19.040",
      "text": "او با سرنگ میشه"
    },
    {
      "id": 50,
      "start": 7939.04,
      "end": 7941.04,
      "formatted_start": "02:12:19.040",
      "formatted_end": "02:12:21.040",
      "text": "سرنگ که چه بهتر دو و نیم"
    },
    {
      "id": 51,
      "start": 7941.04,
      "end": 7943.04,
      "formatted_start": "02:12:21.040",
      "formatted_end": "02:12:23.040",
      "text": "دو تا بکشه"
    },
    {
      "id": 52,
      "start": 7943.04,
      "end": 7945.04,
      "formatted_start": "02:12:23.040",
      "formatted_end": "02:12:25.040",
      "text": "دوستتون درست می کنیم همراه"
    },
    {
      "id": 53,
      "start": 7945.04,
      "end": 7947.04,
      "formatted_start": "02:12:25.040",
      "formatted_end": "02:12:27.040",
      "text": "سیر می کنیم"
    },
    {
      "id": 54,
      "start": 7947.04,
      "end": 7949.04,
      "formatted_start": "02:12:27.040",
      "formatted_end": "02:12:29.040",
      "text": "سیر کارو نداریم"
    },
    {
      "id": 55,
      "start": 7949.04,
      "end": 7951.04,
      "formatted_start": "02:12:29.040",
      "formatted_end": "02:12:31.040",
      "text": "بعد دو تا پیمونه درست می کنیم"
    },
    {
      "id": 56,
      "start": 7951.04,
      "end": 7953.04,
      "formatted_start": "02:12:31.040",
      "formatted_end": "02:12:33.040",
      "text": "شست تا دیگه"
    },
    {
      "id": 57,
      "start": 7953.04,
      "end": 7955.04,
      "formatted_start": "02:12:33.040",
      "formatted_end": "02:12:35.040",
      "text": "دو تا پیمونه"
    },
    {
      "id": 58,
      "start": 7957.04,
      "end": 7959.04,
      "formatted_start": "02:12:37.040",
      "formatted_end": "02:12:39.040",
      "text": "او نبیده"
    },
    {
      "id": 59,
      "start": 7959.04,
      "end": 7965.04,
      "formatted_start": "02:12:39.040",
      "formatted_end": "02:12:45.040",
      "text": "این تا زمان که میک نزنی نمی آمید"
    },
    {
      "id": 60,
      "start": 7965.04,
      "end": 7967.04,
      "formatted_start": "02:12:45.040",
      "formatted_end": "02:12:47.040",
      "text": "بعد اینقدر دیدم این چی می کنه"
    },
    {
      "id": 61,
      "start": 7967.04,
      "end": 7971.04,
      "formatted_start": "02:12:47.040",
      "formatted_end": "02:12:51.040",
      "text": "بابا می کنه سرشیشه رفتم دو قطره سرقطره پنگ قطره هم گذارد"
    },
    {
      "id": 62,
      "start": 7971.04,
      "end": 7973.04,
      "formatted_start": "02:12:51.040",
      "formatted_end": "02:12:53.040",
      "text": "پنگ قطره خیلی بیاده"
    },
    {
      "id": 63,
      "start": 7973.04,
      "end": 7975.04,
      "formatted_start": "02:12:53.040",
      "formatted_end": "02:12:55.040",
      "text": "بعد دیدم که خب داره از گوشه دهنشی می ریزه"
    },
    {
      "id": 64,
      "start": 7975.04,
      "end": 7977.04,
      "formatted_start": "02:12:55.040",
      "formatted_end": "02:12:57.040",
      "text": "بعد از کنار دهنش کلیم بیاده"
    },
    {
      "id": 65,
      "start": 7977.04,
      "end": 7979.04,
      "formatted_start": "02:12:57.040",
      "formatted_end": "02:12:59.040",
      "text": "سرقطره"
    },
    {
      "id": 66,
      "start": 7979.04,
      "end": 7981.04,
      "formatted_start": "02:12:59.040",
      "formatted_end": "02:13:01.040",
      "text": "خب اینکه حالا خودش خیلی کم"
    },
    {
      "id": 67,
      "start": 7981.04,
      "end": 7983.04,
      "formatted_start": "02:13:01.040",
      "formatted_end": "02:13:03.040",
      "text": "خب"
    },
    {
      "id": 68,
      "start": 7983.04,
      "end": 7985.04,
      "formatted_start": "02:13:03.040",
      "formatted_end": "02:13:05.040",
      "text": "واسه گریهش که دیگه کار نداره"
    },
    {
      "id": 69,
      "start": 7985.04,
      "end": 7987.04,
      "formatted_start": "02:13:05.040",
      "formatted_end": "02:13:07.040",
      "text": "چی بی خوابی آشت"
    },
    {
      "id": 70,
      "start": 7987.04,
      "end": 7995.04,
      "formatted_start": "02:13:07.040",
      "formatted_end": "02:13:15.040",
      "text": "با دردش خوب شده اگر خوابید چه بگفتم نخوابیدم دیگه همینه بگیرم"
    },
    {
      "id": 71,
      "start": 7995.04,
      "end": 7997.04,
      "formatted_start": "02:13:15.040",
      "formatted_end": "02:13:17.040",
      "text": "باب تا کم کم خواباش تنظیم باشه"
    },
    {
      "id": 72,
      "start": 7997.04,
      "end": 7999.04,
      "formatted_start": "02:13:17.040",
      "formatted_end": "02:13:19.040",
      "text": "بابا روست همونه"
    },
    {
      "id": 73,
      "start": 7999.04,
      "end": 8005.04,
      "formatted_start": "02:13:19.040",
      "formatted_end": "02:13:25.040",
      "text": "ببینید چیزه با نور خونه تنظیم"
    },
    {
      "id": 74,
      "start": 8005.04,
      "end": 8007.04,
      "formatted_start": "02:13:25.040",
      "formatted_end": "02:13:27.040",
      "text": "همین کارو می کنن"
    },
    {
      "id": 75,
      "start": 8007.04,
      "end": 8009.04,
      "formatted_start": "02:13:27.040",
      "formatted_end": "02:13:29.040",
      "text": "خیلی شوید چراها زیاد روشن نباشه"
    },
    {
      "id": 76,
      "start": 8009.04,
      "end": 8011.04,
      "formatted_start": "02:13:29.040",
      "formatted_end": "02:13:31.040",
      "text": "نه شبها که مخصوصا انسان به خوابه یک ساعت دو ساعت قبضه مشون کنن"
    },
    {
      "id": 77,
      "start": 8011.04,
      "end": 8013.04,
      "formatted_start": "02:13:31.040",
      "formatted_end": "02:13:33.040",
      "text": "صداها رو کم می کنن"
    },
    {
      "id": 78,
      "start": 8013.04,
      "end": 8015.04,
      "formatted_start": "02:13:33.040",
      "formatted_end": "02:13:35.040",
      "text": "که به نور شبه"
    },
    {
      "id": 79,
      "start": 8015.04,
      "end": 8019.34,
      "formatted_start": "02:13:35.040",
      "formatted_end": "02:13:39.340",
      "text": "اما شبون یک کار که نهایتش دیگه تا یک بخوابه"
    },
    {
      "id": 80,
      "start": 8019.34,
      "end": 8021.34,
      "formatted_start": "02:13:39.340",
      "formatted_end": "02:13:41.340",
      "text": "یعنی بیشتر از اون بخواد بیدار نباشه"
    },
    {
      "id": 81,
      "start": 8021.34,
      "end": 8023.34,
      "formatted_start": "02:13:41.340",
      "formatted_end": "02:13:43.340",
      "text": "بعدی روزا خیلی خرگوشی میخواد"
    },
    {
      "id": 82,
      "start": 8023.34,
      "end": 8026.34,
      "formatted_start": "02:13:43.340",
      "formatted_end": "02:13:46.340",
      "text": "با هر صدایی، نه امیق نمیخواد"
    },
    {
      "id": 83,
      "start": 8026.34,
      "end": 8028.34,
      "formatted_start": "02:13:46.340",
      "formatted_end": "02:13:48.340",
      "text": "از که جدید هم میده"
    },
    {
      "id": 84,
      "start": 8028.34,
      "end": 8029.34,
      "formatted_start": "02:13:48.340",
      "formatted_end": "02:13:49.340",
      "text": "بینا؟"
    },
    {
      "id": 85,
      "start": 8029.34,
      "end": 8030.34,
      "formatted_start": "02:13:49.340",
      "formatted_end": "02:13:50.340",
      "text": "گوش میده"
    },
    {
      "id": 86,
      "start": 8030.34,
      "end": 8032.34,
      "formatted_start": "02:13:50.340",
      "formatted_end": "02:13:52.340",
      "text": "اینجا میخواییم بیاییم آروم میشه"
    },
    {
      "id": 87,
      "start": 8032.34,
      "end": 8033.34,
      "formatted_start": "02:13:52.340",
      "formatted_end": "02:13:53.340",
      "text": "میخوابه"
    },
    {
      "id": 88,
      "start": 8033.34,
      "end": 8036.34,
      "formatted_start": "02:13:53.340",
      "formatted_end": "02:13:56.340",
      "text": "نه متوجه میشه که نمیرم"
    },
    {
      "id": 89,
      "start": 8037.34,
      "end": 8040.34,
      "formatted_start": "02:13:57.340",
      "formatted_end": "02:14:00.340",
      "text": "صباح باشین میشه که قشن میپنه"
    },
    {
      "id": 90,
      "start": 8040.34,
      "end": 8041.34,
      "formatted_start": "02:14:00.340",
      "formatted_end": "02:14:01.340",
      "text": "آره دوست دارم باشه"
    },
    {
      "id": 91,
      "start": 8041.34,
      "end": 8042.34,
      "formatted_start": "02:14:01.340",
      "formatted_end": "02:14:02.340",
      "text": "خیلی"
    },
    {
      "id": 92,
      "start": 8042.34,
      "end": 8055.34,
      "formatted_start": "02:14:02.340",
      "formatted_end": "02:14:15.340",
      "text": "این خیلی خوبه بچه ها ماشین رو دوست داشته باشن. اقلا بچه ها دوست دارن ولی من یه مریض داشتم بچه ها اصلا تو ماشین شدیدن میترابه میشن و تا یک ساله دی میگفت من هیچ جایی نمیخونم."
    },
    {
      "id": 93,
      "start": 8055.34,
      "end": 8062.34,
      "formatted_start": "02:14:15.340",
      "formatted_end": "02:14:22.340",
      "text": "یعنی میگه این میگفتش که مثلا ما میخوایم از اینجا تا آزاد شر بریم آخرش میخوایم سرسنا میگیریم و هم میگرم."
    },
    {
      "id": 94,
      "start": 8062.34,
      "end": 8064.34,
      "formatted_start": "02:14:22.340",
      "formatted_end": "02:14:24.340",
      "text": "دستون دست داری؟"
    },
    {
      "id": 95,
      "start": 8064.34,
      "end": 8066.34,
      "formatted_start": "02:14:24.340",
      "formatted_end": "02:14:26.340",
      "text": "اوه شما این پرمندر همون بخوایید"
    },
    {
      "id": 96,
      "start": 8066.34,
      "end": 8068.34,
      "formatted_start": "02:14:26.340",
      "formatted_end": "02:14:28.340",
      "text": "او بردی بیانش"
    },
    {
      "id": 97,
      "start": 8068.34,
      "end": 8070.34,
      "formatted_start": "02:14:28.340",
      "formatted_end": "02:14:30.340",
      "text": "دستون دست داری؟"
    },
    {
      "id": 98,
      "start": 8070.34,
      "end": 8072.34,
      "formatted_start": "02:14:30.340",
      "formatted_end": "02:14:32.340",
      "text": "دیگه دو ماه شد بیانش"
    },
    {
      "id": 99,
      "start": 8072.34,
      "end": 8074.34,
