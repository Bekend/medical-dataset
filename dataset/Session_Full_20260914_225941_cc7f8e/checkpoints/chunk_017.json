  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5101.36,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:01.360",
      "text": "چند رو برد از اینجورس؟"
    },
    {
      "id": 1,
      "start": 5101.36,
      "end": 5102.28,
      "formatted_start": "01:25:01.360",
      "formatted_end": "01:25:02.280",
      "text": "یازده تا."
    },
    {
      "id": 2,
      "start": 5102.28,
      "end": 5106.4,
      "formatted_start": "01:25:02.280",
      "formatted_end": "01:25:06.400",
      "text": "یازده تا. چون هشت گفته بود، معلم زبون."
    },
    {
      "id": 3,
      "start": 5106.4,
      "end": 5108.12,
      "formatted_start": "01:25:06.400",
      "formatted_end": "01:25:08.120",
      "text": "یک و روز بیاد."
    },
    {
      "id": 4,
      "start": 5108.12,
      "end": 5109.12,
      "formatted_start": "01:25:08.120",
      "formatted_end": "01:25:09.120",
      "text": "باشه."
    },
    {
      "id": 5,
      "start": 5110.24,
      "end": 5112.4,
      "formatted_start": "01:25:10.240",
      "formatted_end": "01:25:12.400",
      "text": "چون من آخر رو یه رو بیگذاشتم باشه."
    },
    {
      "id": 6,
      "start": 5112.4,
      "end": 5114.52,
      "formatted_start": "01:25:12.400",
      "formatted_end": "01:25:14.520",
      "text": "باید من جمع کنم، یک بردارو سیتر داشتم."
    },
    {
      "id": 7,
      "start": 5114.52,
      "end": 5115.44,
      "formatted_start": "01:25:14.520",
      "formatted_end": "01:25:15.440",
      "text": "چند ساعت کنم؟"
    },
    {
      "id": 8,
      "start": 5115.44,
      "end": 5116.72,
      "formatted_start": "01:25:15.440",
      "formatted_end": "01:25:16.720",
      "text": "درست باشه."
    },
    {
      "id": 9,
      "start": 5116.72,
      "end": 5118.72,
      "formatted_start": "01:25:16.720",
      "formatted_end": "01:25:18.720",
      "text": "پایز خانده تا باشه از لحظه؟"
    },
    {
      "id": 10,
      "start": 5118.72,
      "end": 5119.72,
      "formatted_start": "01:25:18.720",
      "formatted_end": "01:25:19.720",
      "text": "باشه."
    },
    {
      "id": 11,
      "start": 5120.52,
      "end": 5121.52,
      "formatted_start": "01:25:20.520",
      "formatted_end": "01:25:21.520",
      "text": "درست باشه."
    },
    {
      "id": 12,
      "start": 5130.0,
      "end": 5155.5,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:55.500",
      "text": "برای شما خوبی؟"
    },
    {
      "id": 13,
      "start": 5155.5,
      "end": 5158.5,
      "formatted_start": "01:25:55.500",
      "formatted_end": "01:25:58.500",
      "text": "برای دختر خوشگیرم خوبی؟"
    },
    {
      "id": 14,
      "start": 5158.5,
      "end": 5162.5,
      "formatted_start": "01:25:58.500",
      "formatted_end": "01:26:02.500",
      "text": "چه نراحتی؟ اینجا میشه بینیم"
    },
    {
      "id": 15,
      "start": 5164.5,
      "end": 5168.5,
      "formatted_start": "01:26:04.500",
      "formatted_end": "01:26:08.500",
      "text": "مرسی مرنو چه حال خمکتونه؟ هیچی شد این دختر؟"
    },
    {
      "id": 16,
      "start": 5168.5,
      "end": 5174.5,
      "formatted_start": "01:26:08.500",
      "formatted_end": "01:26:14.500",
      "text": "ای خاندکتور از هفته پیش یک شبه محبت دخترم همزمان تب گردم"
    },
    {
      "id": 17,
      "start": 5174.5,
      "end": 5175.5,
      "formatted_start": "01:26:14.500",
      "formatted_end": "01:26:15.500",
      "text": "خواب؟"
    },
    {
      "id": 18,
      "start": 5175.5,
      "end": 5176.5,
      "formatted_start": "01:26:15.500",
      "formatted_end": "01:26:16.500",
      "text": "یعنی ما تب شروع شد دیگه"
    },
    {
      "id": 19,
      "start": 5176.5,
      "end": 5179.5,
      "formatted_start": "01:26:16.500",
      "formatted_end": "01:26:19.500",
      "text": "بعد دردر به حالت تهبو"
    },
    {
      "id": 20,
      "start": 5179.5,
      "end": 5180.5,
      "formatted_start": "01:26:19.500",
      "formatted_end": "01:26:20.500",
      "text": "آها"
    },
    {
      "id": 21,
      "start": 5180.5,
      "end": 5182.5,
      "formatted_start": "01:26:20.500",
      "formatted_end": "01:26:22.500",
      "text": "بعد تبشه شدید"
    },
    {
      "id": 22,
      "start": 5182.5,
      "end": 5183.5,
      "formatted_start": "01:26:22.500",
      "formatted_end": "01:26:23.500",
      "text": "من همه چیزا خواستم"
    },
    {
      "id": 23,
      "start": 5183.5,
      "end": 5185.5,
      "formatted_start": "01:26:23.500",
      "formatted_end": "01:26:25.500",
      "text": "آره تبشه شدیده"
    },
    {
      "id": 24,
      "start": 5185.5,
      "end": 5188.5,
      "formatted_start": "01:26:25.500",
      "formatted_end": "01:26:28.500",
      "text": "این از هفته بیشتر رو تبشکای نمیده؟"
    },
    {
      "id": 25,
      "start": 5188.5,
      "end": 5193.5,
      "formatted_start": "01:26:28.500",
      "formatted_end": "01:26:33.500",
      "text": "نه اون دخترم آرام چند روز تبشکایی نمیده تب نمیکنه"
    },
    {
      "id": 26,
      "start": 5193.5,
      "end": 5198.5,
      "formatted_start": "01:26:33.500",
      "formatted_end": "01:26:38.500",
      "text": "ولی این اصلاً یک سره تب، حالش خوبه ها یه هایی تب میکنه"
    },
    {
      "id": 27,
      "start": 5198.5,
      "end": 5204.5,
      "formatted_start": "01:26:38.500",
      "formatted_end": "01:26:44.500",
      "text": "بعد صوفه هاش هم پست، اشتاق اصلاً نداره، بس از هفته یکمی فرقان دکتر"
    },
    {
      "id": 28,
      "start": 5204.5,
      "end": 5206.5,
      "formatted_start": "01:26:44.500",
      "formatted_end": "01:26:46.500",
      "text": "بعد اصحالش چطوره؟"
    },
    {
      "id": 29,
      "start": 5206.5,
      "end": 5211.5,
      "formatted_start": "01:26:46.500",
      "formatted_end": "01:26:51.500",
      "text": "نه اصحالی نداره، نه حالت تعبه داشتن، اصحال هم نداشتن"
    },
    {
      "id": 30,
      "start": 5211.5,
      "end": 5217.5,
      "formatted_start": "01:26:51.500",
      "formatted_end": "01:26:57.500",
      "text": "از اینجور باشن. صرفه هاش مثلا شب اصلا نیمونطوره بخوابه. دیشتر هم تب کرد."
    },
    {
      "id": 31,
      "start": 5219.5,
      "end": 5224.5,
      "formatted_start": "01:26:59.500",
      "formatted_end": "01:27:04.500",
      "text": "سال اینو قبلن قبلا نمیدونی؟ دیشتر از دفعه نمی کرد؟ بچه با من؟"
    },
    {
      "id": 32,
      "start": 5225.5,
      "end": 5228.5,
      "formatted_start": "01:27:05.500",
      "formatted_end": "01:27:08.500",
      "text": "پاسه سرما خورده که ایناش بگذارده ایران."
    },
    {
      "id": 33,
      "start": 5231.5,
      "end": 5235.5,
      "formatted_start": "01:27:11.500",
      "formatted_end": "01:27:15.500",
      "text": "نه، نه، دیشتر نمیدونی که بخوابه صرفه میکرد."
    },
    {
      "id": 34,
      "start": 5235.5,
      "end": 5238.5,
      "formatted_start": "01:27:15.500",
      "formatted_end": "01:27:18.500",
      "text": "آره، آره، کچیکرم هم میتونیم صرفه بگذارد."
    },
    {
      "id": 35,
      "start": 5241.5,
      "end": 5244.5,
      "formatted_start": "01:27:21.500",
      "formatted_end": "01:27:24.500",
      "text": "این الان سی و یه بود بسته هشت و اون چند"
    },
    {
      "id": 36,
      "start": 5244.5,
      "end": 5249.5,
      "formatted_start": "01:27:24.500",
      "formatted_end": "01:27:29.500",
      "text": "خب ببین آخرین ماری که بهش ترپ بردی که"
    },
    {
      "id": 37,
      "start": 5249.5,
      "end": 5253.5,
      "formatted_start": "01:27:29.500",
      "formatted_end": "01:27:33.500",
      "text": "دیشهر ساعت دوازده ای شب"
    },
    {
      "id": 38,
      "start": 5253.5,
      "end": 5255.5,
      "formatted_start": "01:27:33.500",
      "formatted_end": "01:27:35.500",
      "text": "واقعا ترپ داره"
    },
    {
      "id": 39,
      "start": 5255.5,
      "end": 5257.5,
      "formatted_start": "01:27:35.500",
      "formatted_end": "01:27:37.500",
      "text": "این فقط شکمش چیزه"
    },
    {
      "id": 40,
      "start": 5257.5,
      "end": 5259.5,
      "formatted_start": "01:27:37.500",
      "formatted_end": "01:27:39.500",
      "text": "داق میشه پاش سره"
    },
    {
      "id": 41,
      "start": 5259.5,
      "end": 5262.5,
      "formatted_start": "01:27:39.500",
      "formatted_end": "01:27:42.500",
      "text": "و ازای یکم پیشونش هم داقه ولی شکمش خیلی هست"
    },
    {
      "id": 42,
      "start": 5262.5,
      "end": 5265.5,
      "formatted_start": "01:27:42.500",
      "formatted_end": "01:27:45.500",
      "text": "دست و پاک سر باشه"
    },
    {
      "id": 43,
      "start": 5265.5,
      "end": 5268.5,
      "formatted_start": "01:27:45.500",
      "formatted_end": "01:27:48.500",
      "text": "این نشو درده که تب دماغ خیلی بالا"
    },
    {
      "id": 44,
      "start": 5268.5,
      "end": 5273.5,
      "formatted_start": "01:27:48.500",
      "formatted_end": "01:27:53.500",
      "text": "تو طب بالا شکم و پیشون میده همشه دستات های عرقی ها"
    },
    {
      "id": 45,
      "start": 5273.5,
      "end": 5280.5,
      "formatted_start": "01:27:53.500",
      "formatted_end": "01:28:00.500",
      "text": "ببین با توجه بگیر که طبش بیشتر از پنج روز طول کشیده چه داروی بهش داره جیبه؟"
    },
    {
      "id": 46,
      "start": 5280.5,
      "end": 5288.5,
      "formatted_start": "01:28:00.500",
      "formatted_end": "01:28:08.500",
      "text": "همین طب تحبول بگشتم و بعد در طور یه داروی زدگه نیروز هم دادم اونم استفاده کردم"
    },
    {
      "id": 47,
      "start": 5288.5,
      "end": 5289.5,
      "formatted_start": "01:28:08.500",
      "formatted_end": "01:28:09.500",
      "text": "تا میخلو؟"
    },
    {
      "id": 48,
      "start": 5289.5,
      "end": 5290.5,
      "formatted_start": "01:28:09.500",
      "formatted_end": "01:28:10.500",
      "text": "آره"
    },
    {
      "id": 49,
      "start": 5290.5,
      "end": 5291.5,
      "formatted_start": "01:28:10.500",
      "formatted_end": "01:28:11.500",
      "text": "آهان خب"
    },
    {
      "id": 50,
      "start": 5291.5,
      "end": 5301.5,
      "formatted_start": "01:28:11.500",
      "formatted_end": "01:28:21.500",
      "text": "بعد همین رو استفاده می کنم. رویالتویت و ایچهاش ها رو استفاده کردیم."
    },
    {
      "id": 51,
      "start": 5301.5,
      "end": 5307.5,
      "formatted_start": "01:28:21.500",
      "formatted_end": "01:28:27.500",
      "text": "خب، بگیر من داروی کناشو می نویسم. خب، قرص می توانی با پایلیت رو بکنم؟"
    },
    {
      "id": 52,
      "start": 5307.5,
      "end": 5309.5,
      "formatted_start": "01:28:27.500",
      "formatted_end": "01:28:29.500",
      "text": "آره برم. آهی."
    },
    {
      "id": 53,
      "start": 5309.5,
      "end": 5314.5,
      "formatted_start": "01:28:29.500",
      "formatted_end": "01:28:34.500",
      "text": "این دارو رو استفاده بکنه. اگر کتاب فرد دادی بزرگشت بهتر شد."
    },
    {
      "id": 54,
      "start": 5314.5,
      "end": 5319.5,
      "formatted_start": "01:28:34.500",
      "formatted_end": "01:28:39.500",
      "text": "تب بگه نکرد با که خب چه بهتر داروش تا هفت روز درمانه."
    },
    {
      "id": 55,
      "start": 5319.5,
      "end": 5324.5,
      "formatted_start": "01:28:39.500",
      "formatted_end": "01:28:44.500",
      "text": "ولی اگر دیدی که نه حتی دارو بازم تب می کنه"
    },
    {
      "id": 56,
      "start": 5324.5,
      "end": 5328.5,
      "formatted_start": "01:28:44.500",
      "formatted_end": "01:28:48.500",
      "text": "فردا هم باز دوباره تب کرد دیگه باید براش آزمایش بده"
    },
    {
      "id": 57,
      "start": 5328.5,
      "end": 5329.5,
      "formatted_start": "01:28:48.500",
      "formatted_end": "01:28:49.500",
      "text": "خب؟"
    },
    {
      "id": 58,
      "start": 5329.5,
      "end": 5334.5,
      "formatted_start": "01:28:49.500",
      "formatted_end": "01:28:54.500",
      "text": "آورده این تباش مثلا یک سره تب نداره"
    },
    {
      "id": 59,
      "start": 5334.5,
      "end": 5338.5,
      "formatted_start": "01:28:54.500",
      "formatted_end": "01:28:58.500",
      "text": "مثلا بازی می کنه شب مثلا یک تب می کنه"
    },
    {
      "id": 60,
      "start": 5338.5,
      "end": 5340.5,
      "formatted_start": "01:28:58.500",
      "formatted_end": "01:29:00.500",
      "text": "بازم سامه قد قد بشه"
    },
    {
      "id": 61,
      "start": 5340.5,
      "end": 5341.5,
      "formatted_start": "01:29:00.500",
      "formatted_end": "01:29:01.500",
      "text": "آره"
    },
    {
      "id": 62,
      "start": 5341.5,
      "end": 5345.5,
      "formatted_start": "01:29:01.500",
      "formatted_end": "01:29:05.500",
      "text": "آه پس تو فردا اگه تبی نداشته باشه مشکلی نیست"
    },
    {
      "id": 63,
      "start": 5345.5,
      "end": 5346.5,
      "formatted_start": "01:29:05.500",
      "formatted_end": "01:29:06.500",
      "text": "مشکل نیست"
    },
    {
      "id": 64,
      "start": 5346.5,
      "end": 5348.5,
      "formatted_start": "01:29:06.500",
      "formatted_end": "01:29:08.500",
      "text": "اگر نه باید آزمش بده"
    },
    {
      "id": 65,
      "start": 5348.5,
      "end": 5352.5,
      "formatted_start": "01:29:08.500",
      "formatted_end": "01:29:12.500",
      "text": "صرفه هاش رو دیگه کم کم با این دروایی که میده"
    },
    {
      "id": 66,
      "start": 5352.5,
      "end": 5355.5,
      "formatted_start": "01:29:12.500",
      "formatted_end": "01:29:15.500",
      "text": "چرا اینجوری صرفه میکنه؟ چرا از قشنگ صرفه میکنه؟"
    },
    {
      "id": 67,
      "start": 5355.5,
      "end": 5360.5,
      "formatted_start": "01:29:15.500",
      "formatted_end": "01:29:20.500",
      "text": "منم بهش میگم فلسفه بنده مثلا اینکه قشنگ صرفه میکنه"
    },
    {
      "id": 68,
      "start": 5360.5,
      "end": 5363.5,
      "formatted_start": "01:29:20.500",
      "formatted_end": "01:29:23.500",
      "text": "میشه بده تو خودشه ایگه بودم قشنگ صرفه"
    },
    {
      "id": 69,
      "start": 5368.5,
      "end": 5370.5,
      "formatted_start": "01:29:28.500",
      "formatted_end": "01:29:30.500",
      "text": "آها آها آها"
    },
    {
      "id": 70,
      "start": 5370.5,
      "end": 5374.5,
      "formatted_start": "01:29:30.500",
      "formatted_end": "01:29:34.500",
      "text": "ازشن خلطاتو بیرون از زمین خلطاتون اینجور بینده هی بکتر میشه"
    },
    {
      "id": 71,
      "start": 5374.5,
      "end": 5376.5,
      "formatted_start": "01:29:34.500",
      "formatted_end": "01:29:36.500",
      "text": "برنامه باید برداریم"
    },
    {
      "id": 72,
      "start": 5376.5,
      "end": 5378.5,
      "formatted_start": "01:29:36.500",
      "formatted_end": "01:29:38.500",
      "text": "مرس میتونی بخوریم؟"
    },
    {
      "id": 73,
      "start": 5378.5,
      "end": 5380.5,
      "formatted_start": "01:29:38.500",
      "formatted_end": "01:29:40.500",
      "text": "آره میتونی بخورم"
    },
    {
      "id": 74,
      "start": 5380.5,
      "end": 5382.5,
      "formatted_start": "01:29:40.500",
      "formatted_end": "01:29:42.500",
      "text": "کلس چند رو برم؟"
    },
    {
      "id": 75,
      "start": 5382.5,
      "end": 5384.5,
      "formatted_start": "01:29:42.500",
      "formatted_end": "01:29:44.500",
      "text": "این رو همینه پلچون"
    },
    {
      "id": 76,
      "start": 5384.5,
      "end": 5386.5,
      "formatted_start": "01:29:44.500",
      "formatted_end": "01:29:46.500",
      "text": "خوب داریم"
    },
    {
      "id": 77,
      "start": 5386.5,
      "end": 5388.5,
      "formatted_start": "01:29:46.500",
      "formatted_end": "01:29:48.500",
      "text": "کجا بگیرم بشم"
    },
    {
      "id": 78,
      "start": 5388.5,
      "end": 5390.5,
      "formatted_start": "01:29:48.500",
      "formatted_end": "01:29:50.500",
      "text": "خب بیایند یه مرس"
    },
    {
      "id": 79,
      "start": 5390.5,
      "end": 5392.5,
      "formatted_start": "01:29:50.500",
      "formatted_end": "01:29:52.500",
      "text": "طابانک"
    },
    {
      "id": 80,
      "start": 5392.5,
      "end": 5394.5,
      "formatted_start": "01:29:52.500",
      "formatted_end": "01:29:54.500",
      "text": "براش داشته"
    },
    {
      "id": 81,
      "start": 5394.5,
      "end": 5396.5,
      "formatted_start": "01:29:54.500",
      "formatted_end": "01:29:56.500",
      "text": "طابانک"
    },
    {
      "id": 82,
      "start": 5396.5,
      "end": 5398.5,
      "formatted_start": "01:29:56.500",
      "formatted_end": "01:29:58.500",
      "text": "شما"
    },
    {
      "id": 83,
      "start": 5398.5,
      "end": 5400.5,
      "formatted_start": "01:29:58.500",
      "formatted_end": "01:30:00.500",
      "text": "هر دوازده ساعت"
    }
  ],
  "status": "completed"
}