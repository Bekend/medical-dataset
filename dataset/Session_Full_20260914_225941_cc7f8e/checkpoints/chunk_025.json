  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7503.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:03.000",
      "text": "آخه ولی خوب اکسال آمنشون میده."
    },
    {
      "id": 1,
      "start": 7503.0,
      "end": 7510.0,
      "formatted_start": "02:05:03.000",
      "formatted_end": "02:05:10.000",
      "text": "چیه؟ آخه جا خیلی چیه؟ چیه که این طریق نگاه میکنه؟"
    },
    {
      "id": 2,
      "start": 7510.0,
      "end": 7512.0,
      "formatted_start": "02:05:10.000",
      "formatted_end": "02:05:12.000",
      "text": "بسه دارم."
    },
    {
      "id": 3,
      "start": 7512.0,
      "end": 7515.0,
      "formatted_start": "02:05:12.000",
      "formatted_end": "02:05:15.000",
      "text": "ببه از پیپی کنه خیلی زرزده."
    },
    {
      "id": 4,
      "start": 7515.0,
      "end": 7522.0,
      "formatted_start": "02:05:15.000",
      "formatted_end": "02:05:22.000",
      "text": "بیناره، تا سه ماهگی تغییره، خصوص بین یک ماهگی تا دو ماهگی، نفقشون رو به زور دارن."
    },
    {
      "id": 5,
      "start": 7522.0,
      "end": 7527.0,
      "formatted_start": "02:05:22.000",
      "formatted_end": "02:05:27.000",
      "text": "زرزدناشون طبیعه، خب باز خوبه که گریه نمی کنه، فقط زور میزنه."
    },
    {
      "id": 6,
      "start": 7527.0,
      "end": 7546.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:46.000",
      "text": "نفخش خیلی طرف صبح زیاد میشه مثلا هر روز بر که میخواد شیرو بخوره اح ایس که میخوره بلند میشن شیرو برن تا میان بگیرن بهش یک عالم نفخ"
    },
    {
      "id": 7,
      "start": 7546.0,
      "end": 7549.0,
      "formatted_start": "02:05:46.000",
      "formatted_end": "02:05:49.000",
      "text": "خیلی خوبه ببین حتما روز دو بار ماساج بگیر"
    },
    {
      "id": 8,
      "start": 7549.0,
      "end": 7551.0,
      "formatted_start": "02:05:49.000",
      "formatted_end": "02:05:51.000",
      "text": "میده هم ماساج خیلی میده"
    },
    {
      "id": 9,
      "start": 7551.0,
      "end": 7555.0,
      "formatted_start": "02:05:51.000",
      "formatted_end": "02:05:55.000",
      "text": "از جهت افراد رو بسیار که نفخاش دردش"
    },
    {
      "id": 10,
      "start": 7555.0,
      "end": 7558.0,
      "formatted_start": "02:05:55.000",
      "formatted_end": "02:05:58.000",
      "text": "بگیری و دارید نفش چی بشه؟"
    },
    {
      "id": 11,
      "start": 7558.0,
      "end": 7560.0,
      "formatted_start": "02:05:58.000",
      "formatted_end": "02:06:00.000",
      "text": "زده نفش هیچی نداریم"
    },
    {
      "id": 12,
      "start": 7560.0,
      "end": 7561.0,
      "formatted_start": "02:06:00.000",
      "formatted_end": "02:06:01.000",
      "text": "نفش چی بشه؟"
    },
    {
      "id": 13,
      "start": 7561.0,
      "end": 7563.0,
      "formatted_start": "02:06:01.000",
      "formatted_end": "02:06:03.000",
      "text": "تو اون کولیکس رو دارید"
    },
    {
      "id": 14,
      "start": 7563.0,
      "end": 7565.0,
      "formatted_start": "02:06:03.000",
      "formatted_end": "02:06:05.000",
      "text": "آه، کولیکس خوب زده نفش هسته"
    },
    {
      "id": 15,
      "start": 7565.0,
      "end": 7567.0,
      "formatted_start": "02:06:05.000",
      "formatted_end": "02:06:07.000",
      "text": "آه، دارید با کولیکس نیست"
    },
    {
      "id": 16,
      "start": 7567.0,
      "end": 7569.0,
      "formatted_start": "02:06:07.000",
      "formatted_end": "02:06:09.000",
      "text": "هر دوتا زده نفش هست"
    },
    {
      "id": 17,
      "start": 7569.0,
      "end": 7571.0,
      "formatted_start": "02:06:09.000",
      "formatted_end": "02:06:11.000",
      "text": "هر موضوع میبینی خیلی نفش داره"
    },
    {
      "id": 18,
      "start": 7571.0,
      "end": 7573.0,
      "formatted_start": "02:06:11.000",
      "formatted_end": "02:06:13.000",
      "text": "یعنی میتونی شیبون باره ایز"
    },
    {
      "id": 19,
      "start": 7573.0,
      "end": 7575.0,
      "formatted_start": "02:06:13.000",
      "formatted_end": "02:06:15.000",
      "text": "باید بزنه ایران برمشه"
    },
    {
      "id": 20,
      "start": 7575.0,
      "end": 7576.0,
      "formatted_start": "02:06:15.000",
      "formatted_end": "02:06:16.000",
      "text": "بهش"
    },
    {
      "id": 21,
      "start": 7576.0,
      "end": 7578.0,
      "formatted_start": "02:06:16.000",
      "formatted_end": "02:06:18.000",
      "text": "چیز مرشدیت ده؟"
    },
    {
      "id": 22,
      "start": 7578.0,
      "end": 7580.0,
      "formatted_start": "02:06:18.000",
      "formatted_end": "02:06:20.000",
      "text": "5 بار درسته"
    },
    {
      "id": 23,
      "start": 7580.0,
      "end": 7582.0,
      "formatted_start": "02:06:20.000",
      "formatted_end": "02:06:22.000",
      "text": "چرا؟"
    },
    {
      "id": 24,
      "start": 7582.0,
      "end": 7584.0,
      "formatted_start": "02:06:22.000",
      "formatted_end": "02:06:24.000",
      "text": "5 بار درسته"
    },
    {
      "id": 25,
      "start": 7584.0,
      "end": 7586.0,
      "formatted_start": "02:06:24.000",
      "formatted_end": "02:06:26.000",
      "text": "من گفتم 4 بار"
    },
    {
      "id": 26,
      "start": 7586.0,
      "end": 7588.0,
      "formatted_start": "02:06:26.000",
      "formatted_end": "02:06:28.000",
      "text": "درسته دیگه"
    },
    {
      "id": 27,
      "start": 7588.0,
      "end": 7590.0,
      "formatted_start": "02:06:28.000",
      "formatted_end": "02:06:30.000",
      "text": "درسته دیگه"
    },
    {
      "id": 28,
      "start": 7590.0,
      "end": 7592.0,
      "formatted_start": "02:06:30.000",
      "formatted_end": "02:06:32.000",
      "text": "10 بار میشه بدی؟"
    },
    {
      "id": 29,
      "start": 7592.0,
      "end": 7594.0,
      "formatted_start": "02:06:32.000",
      "formatted_end": "02:06:34.000",
      "text": "میگم"
    },
    {
      "id": 30,
      "start": 7594.0,
      "end": 7596.0,
      "formatted_start": "02:06:34.000",
      "formatted_end": "02:06:36.000",
      "text": "شمایتون به زور"
    },
    {
      "id": 31,
      "start": 7596.0,
      "end": 7598.0,
      "formatted_start": "02:06:36.000",
      "formatted_end": "02:06:38.000",
      "text": "مثلا اون دو بار بده"
    },
    {
      "id": 32,
      "start": 7598.0,
      "end": 7600.0,
      "formatted_start": "02:06:38.000",
      "formatted_end": "02:06:40.000",
      "text": "دستشون درسته"
    },
    {
      "id": 33,
      "start": 7600.0,
      "end": 7602.0,
      "formatted_start": "02:06:40.000",
      "formatted_end": "02:06:42.000",
      "text": "دو میل بودی به دارسته"
    },
    {
      "id": 34,
      "start": 7602.0,
      "end": 7604.0,
      "formatted_start": "02:06:42.000",
      "formatted_end": "02:06:44.000",
      "text": "به حتی تا 5 سی سی هم نوشته"
    },
    {
      "id": 35,
      "start": 7604.0,
      "end": 7606.0,
      "formatted_start": "02:06:44.000",
      "formatted_end": "02:06:46.000",
      "text": "برای ضروری نداره نگرم نشید"
    },
    {
      "id": 36,
      "start": 7606.0,
      "end": 7608.0,
      "formatted_start": "02:06:46.000",
      "formatted_end": "02:06:48.000",
      "text": "کلیکت نداری؟"
    },
    {
      "id": 37,
      "start": 7608.0,
      "end": 7610.0,
      "formatted_start": "02:06:48.000",
      "formatted_end": "02:06:50.000",
      "text": "روزه سه باره برم"
    },
    {
      "id": 38,
      "start": 7610.0,
      "end": 7612.0,
      "formatted_start": "02:06:50.000",
      "formatted_end": "02:06:52.000",
      "text": "کلیکتش چقدر بشویدی؟"
    },
    {
      "id": 39,
      "start": 7612.0,
      "end": 7614.0,
      "formatted_start": "02:06:52.000",
      "formatted_end": "02:06:54.000",
      "text": "هشت بطره بشوید"
    },
    {
      "id": 40,
      "start": 7614.0,
      "end": 7616.0,
      "formatted_start": "02:06:54.000",
      "formatted_end": "02:06:56.000",
      "text": "هشت بطره، الان بخورده افتاده برم"
    },
    {
      "id": 41,
      "start": 7616.0,
      "end": 7618.0,
      "formatted_start": "02:06:56.000",
      "formatted_end": "02:06:58.000",
      "text": "که بعدش رفت برم"
    },
    {
      "id": 42,
      "start": 7618.0,
      "end": 7620.0,
      "formatted_start": "02:06:58.000",
      "formatted_end": "02:07:00.000",
      "text": "پرونده داشت اینجا خواهش داره"
    },
    {
      "id": 43,
      "start": 7620.0,
      "end": 7622.0,
      "formatted_start": "02:07:00.000",
      "formatted_end": "02:07:02.000",
      "text": "خیلی از اول اونوردن جا برای پرونده"
    },
    {
      "id": 44,
      "start": 7622.0,
      "end": 7624.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:04.000",
      "text": "خواهش داشت"
    },
    {
      "id": 45,
      "start": 7624.0,
      "end": 7626.0,
      "formatted_start": "02:07:04.000",
      "formatted_end": "02:07:06.000",
      "text": "پرونده شوید"
    },
    {
      "id": 46,
      "start": 7626.0,
      "end": 7628.0,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:08.000",
      "text": "برای اونوردن شوید"
    },
    {
      "id": 47,
      "start": 7628.0,
      "end": 7630.0,
      "formatted_start": "02:07:08.000",
      "formatted_end": "02:07:10.000",
      "text": "برای اونوردن شوید"
    },
    {
      "id": 48,
      "start": 7630.0,
      "end": 7632.0,
      "formatted_start": "02:07:10.000",
      "formatted_end": "02:07:12.000",
      "text": "برای اونوردن شوید"
    },
    {
      "id": 49,
      "start": 7632.0,
      "end": 7636.56,
      "formatted_start": "02:07:12.000",
      "formatted_end": "02:07:16.560",
      "text": "بلکه یه یه هاش چیه؟ که کدر کسی از دست ندارد نمیخوامه یا..."
    },
    {
      "id": 50,
      "start": 7636.56,
      "end": 7637.68,
      "formatted_start": "02:07:16.560",
      "formatted_end": "02:07:17.680",
      "text": "خوب بشه"
    },
    {
      "id": 51,
      "start": 7637.68,
      "end": 7641.4,
      "formatted_start": "02:07:17.680",
      "formatted_end": "02:07:21.400",
      "text": "ببین بچه ها همیتونن دلیلشون باید به دست نزدیک بیادن"
    },
    {
      "id": 52,
      "start": 7641.4,
      "end": 7643.6,
      "formatted_start": "02:07:21.400",
      "formatted_end": "02:07:23.600",
      "text": "و من برنامه هر یه روز در میان میمونیم"
    },
    {
      "id": 53,
      "start": 7643.6,
      "end": 7646.4,
      "formatted_start": "02:07:23.600",
      "formatted_end": "02:07:26.400",
      "text": "ممکنه یه روزی اصلا شغل نست بخوابن"
    },
    {
      "id": 54,
      "start": 7646.4,
      "end": 7649.52,
      "formatted_start": "02:07:26.400",
      "formatted_end": "02:07:29.520",
      "text": "ممکنه یه روزی هم اصلا ببین نخوابن"
    },
    {
      "id": 55,
      "start": 7649.52,
      "end": 7651.4,
      "formatted_start": "02:07:29.520",
      "formatted_end": "02:07:31.400",
      "text": "باید به خاطر دلدردشون"
    },
    {
      "id": 56,
      "start": 7651.4,
      "end": 7654.0,
      "formatted_start": "02:07:31.400",
      "formatted_end": "02:07:34.000",
      "text": "آه؟ شما همون گریزی چرا بیادن بودن کلیتشون"
    },
    {
      "id": 57,
      "start": 7654.0,
      "end": 7654.8,
      "formatted_start": "02:07:34.000",
      "formatted_end": "02:07:34.800",
      "text": "دادم دیگه"
    },
    {
      "id": 58,
      "start": 7654.8,
      "end": 7660.68,
      "formatted_start": "02:07:34.800",
      "formatted_end": "02:07:40.680",
      "text": "آرون کنید و دل دردش ها اصلا چیلی بیکرد ولی نمیخواد بیدون"
    },
    {
      "id": 59,
      "start": 7660.68,
      "end": 7662.68,
      "formatted_start": "02:07:40.680",
      "formatted_end": "02:07:42.680",
      "text": "شیر مادر نمیخورد؟ نه"
    },
    {
      "id": 60,
      "start": 7662.68,
      "end": 7665.68,
      "formatted_start": "02:07:42.680",
      "formatted_end": "02:07:45.680",
      "text": "اسمشی بود؟ همتا"
    },
    {
      "id": 61,
      "start": 7665.68,
      "end": 7671.68,
      "formatted_start": "02:07:45.680",
      "formatted_end": "02:07:51.680",
      "text": "تاریخ تولدش؟ پنج و پنج"
    },
    {
      "id": 62,
      "start": 7671.68,
      "end": 7676.68,
      "formatted_start": "02:07:51.680",
      "formatted_end": "02:07:56.680",
      "text": "خب بعد تولدش؟"
    },
    {
      "id": 63,
      "start": 7676.68,
      "end": 7682.68,
      "formatted_start": "02:07:56.680",
      "formatted_end": "02:08:02.680",
      "text": "سه و ست بود که بعد سه روز بعد بهتاش بردم یه مقدار بعد دست خواد و دو نه و ست شده بود"
    },
    {
      "id": 64,
      "start": 7682.68,
      "end": 7684.68,
      "formatted_start": "02:08:02.680",
      "formatted_end": "02:08:04.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 65,
      "start": 7684.68,
      "end": 7686.68,
      "formatted_start": "02:08:04.680",
      "formatted_end": "02:08:06.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 66,
      "start": 7686.68,
      "end": 7688.68,
      "formatted_start": "02:08:06.680",
      "formatted_end": "02:08:08.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 67,
      "start": 7688.68,
      "end": 7690.68,
      "formatted_start": "02:08:08.680",
      "formatted_end": "02:08:10.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 68,
      "start": 7690.68,
      "end": 7692.68,
      "formatted_start": "02:08:10.680",
      "formatted_end": "02:08:12.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 69,
      "start": 7692.68,
      "end": 7694.68,
      "formatted_start": "02:08:12.680",
      "formatted_end": "02:08:14.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 70,
      "start": 7694.68,
      "end": 7696.68,
      "formatted_start": "02:08:14.680",
      "formatted_end": "02:08:16.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 71,
      "start": 7696.68,
      "end": 7698.68,
      "formatted_start": "02:08:16.680",
      "formatted_end": "02:08:18.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 72,
      "start": 7698.68,
      "end": 7700.68,
      "formatted_start": "02:08:18.680",
      "formatted_end": "02:08:20.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 73,
      "start": 7700.68,
      "end": 7702.68,
      "formatted_start": "02:08:20.680",
      "formatted_end": "02:08:22.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 74,
      "start": 7702.68,
      "end": 7704.68,
      "formatted_start": "02:08:22.680",
      "formatted_end": "02:08:24.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 75,
      "start": 7704.68,
      "end": 7706.68,
      "formatted_start": "02:08:24.680",
      "formatted_end": "02:08:26.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 76,
      "start": 7706.68,
      "end": 7708.68,
      "formatted_start": "02:08:26.680",
      "formatted_end": "02:08:28.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 77,
      "start": 7708.68,
      "end": 7710.68,
      "formatted_start": "02:08:28.680",
      "formatted_end": "02:08:30.680",
      "text": "برگشت برگشت"
    },
    {
      "id": 78,
      "start": 7710.68,
      "end": 7712.68,
      "formatted_start": "02:08:30.680",
      "formatted_end": "02:08:32.680",
      "text": "برگشت نداشت نه خودست من درست بود"
    },
    {
      "id": 79,
      "start": 7712.68,
      "end": 7714.68,
      "formatted_start": "02:08:32.680",
      "formatted_end": "02:08:34.680",
      "text": "سو پونسد بوده"
    },
    {
      "id": 80,
      "start": 7714.68,
      "end": 7716.68,
      "formatted_start": "02:08:34.680",
      "formatted_end": "02:08:36.680",
      "text": "سو چهارصد بود"
    },
    {
      "id": 81,
      "start": 7716.68,
      "end": 7720.68,
      "formatted_start": "02:08:36.680",
      "formatted_end": "02:08:40.680",
      "text": "خوبه دیگردان پونسد و بیس گره همیزمتاش بوده خیلی خوبه بوده"
    },
    {
      "id": 82,
      "start": 7720.68,
      "end": 7724.68,
      "formatted_start": "02:08:40.680",
      "formatted_end": "02:08:44.680",
      "text": "اینو برد کنش بود"
    },
    {
      "id": 83,
      "start": 7724.68,
      "end": 7726.68,
      "formatted_start": "02:08:44.680",
      "formatted_end": "02:08:46.680",
      "text": "سو نه تصدیق"
    },
    {
      "id": 84,
      "start": 7726.68,
      "end": 7728.68,
      "formatted_start": "02:08:46.680",
      "formatted_end": "02:08:48.680",
      "text": "خوب"
    },
    {
      "id": 85,
      "start": 7728.68,
      "end": 7732.68,
      "formatted_start": "02:08:48.680",
      "formatted_end": "02:08:52.680",
      "text": "همینجوری انشالله اگر ادامه بدی باید گیریش بهترش"
    },
    {
      "id": 86,
      "start": 7732.68,
      "end": 7734.68,
      "formatted_start": "02:08:52.680",
      "formatted_end": "02:08:54.680",
      "text": "همین 60 رو بدن"
    },
    {
      "id": 87,
      "start": 7734.68,
      "end": 7736.68,
      "formatted_start": "02:08:54.680",
      "formatted_end": "02:08:56.680",
      "text": "همین 60 رو برش بده"
    },
    {
      "id": 88,
      "start": 7736.68,
      "end": 7741.14,
      "formatted_start": "02:08:56.680",
      "formatted_end": "02:09:01.140",
      "text": "این هم باشه، این هم تو برز گیرش که تزدیده باشه"
    },
    {
      "id": 89,
      "start": 7741.14,
      "end": 7743.14,
      "formatted_start": "02:09:01.140",
      "formatted_end": "02:09:03.140",
      "text": "آدمی باشه"
    },
    {
      "id": 90,
      "start": 7743.14,
      "end": 7745.14,
      "formatted_start": "02:09:03.140",
      "formatted_end": "02:09:05.140",
      "text": "شست دارو باشه برده"
    },
    {
      "id": 91,
      "start": 7745.14,
      "end": 7749.14,
      "formatted_start": "02:09:05.140",
      "formatted_end": "02:09:09.140",
      "text": "اگه میبینی که تموم میکنه تا تر نوت تا دور"
    },
    {
      "id": 92,
      "start": 7749.14,
      "end": 7751.14,
      "formatted_start": "02:09:09.140",
      "formatted_end": "02:09:11.140",
      "text": "همینشو باید یه ذره شیر برمید"
    },
    {
      "id": 93,
      "start": 7751.14,
      "end": 7753.14,
      "formatted_start": "02:09:11.140",
      "formatted_end": "02:09:13.140",
      "text": "باید خودش برمید"
    },
    {
      "id": 94,
      "start": 7753.14,
      "end": 7755.14,
      "formatted_start": "02:09:13.140",
      "formatted_end": "02:09:15.140",
      "text": "نباید تموم بشه این دست از خوردن برده"
    },
    {
      "id": 95,
      "start": 7755.14,
      "end": 7757.14,
      "formatted_start": "02:09:15.140",
      "formatted_end": "02:09:17.140",
      "text": "مثل سینه مادر"
    },
    {
      "id": 96,
      "start": 7757.14,
      "end": 7759.14,
      "formatted_start": "02:09:17.140",
      "formatted_end": "02:09:19.140",
      "text": "سینه مادر تمومی هر نیمیشه"
    },
    {
      "id": 97,
      "start": 7759.14,
      "end": 7761.14,
      "formatted_start": "02:09:19.140",
      "formatted_end": "02:09:21.140",
      "text": "خودش برمید سیر شد دیگه سرشون میاد"
    },
    {
      "id": 98,
      "start": 7761.14,
      "end": 7763.14,
      "formatted_start": "02:09:21.140",
      "formatted_end": "02:09:23.140",
      "text": "این شیشن همیتون"
    },
    {
      "id": 99,
      "start": 7763.14,
      "end": 7765.14,
      "formatted_start": "02:09:23.140",
      "formatted_end": "02:09:25.140",
      "text": "بعد خود بچه دیگه به تشکر برین"
    },
    {
      "id": 100,
      "start": 7765.14,
      "end": 7768.14,
      "formatted_start": "02:09:25.140",
      "formatted_end": "02:09:28.140",
      "text": "بعد کانگلتر اون سری شیشه شیرشی که نگاه کردین"
    },
    {
      "id": 101,
      "start": 7768.14,
      "end": 7769.14,
      "formatted_start": "02:09:28.140",
      "formatted_end": "02:09:29.140",
      "text": "آه خیلی سرده"
    },
    {
      "id": 102,
      "start": 7769.14,
      "end": 7772.14,
      "formatted_start": "02:09:29.140",
      "formatted_end": "02:09:32.140",
      "text": "بعد اون اوینت ها دیدین دیگه تا مینک نزنین نمیاد"
    },
    {
      "id": 103,
      "start": 7772.14,
      "end": 7774.14,
      "formatted_start": "02:09:32.140",
      "formatted_end": "02:09:34.140",
      "text": "بعد دو قطره بود"
    },
    {
      "id": 104,
      "start": 7774.14,
      "end": 7776.14,
      "formatted_start": "02:09:34.140",
      "formatted_end": "02:09:36.140",
      "text": "بعد شما خود رو میرید دو قطره بگیرید"
    },
    {
      "id": 105,
      "start": 7776.14,
      "end": 7778.14,
      "formatted_start": "02:09:36.140",
      "formatted_end": "02:09:38.140",
      "text": "در صورت اینکه خودش دو قطره بود"
    },
    {
      "id": 106,
      "start": 7778.14,
      "end": 7780.14,
      "formatted_start": "02:09:38.140",
      "formatted_end": "02:09:40.140",
      "text": "من محققه بجه اش نباشم"
    },
    {
      "id": 107,
      "start": 7780.14,
      "end": 7782.14,
      "formatted_start": "02:09:40.140",
      "formatted_end": "02:09:42.140",
      "text": "رفتم سه قطره گرفتم"
    },
    {
      "id": 108,
      "start": 7782.14,
      "end": 7783.14,
      "formatted_start": "02:09:42.140",
      "formatted_end": "02:09:43.140",
      "text": "این به طور راحت تر بخوره"
    },
    {
      "id": 109,
      "start": 7783.14,
      "end": 7785.14,
      "formatted_start": "02:09:43.140",
      "formatted_end": "02:09:45.140",
      "text": "الان سه قطره راحته"
    },
    {
      "id": 110,
      "start": 7785.14,
      "end": 7786.14,
      "formatted_start": "02:09:45.140",
      "formatted_end": "02:09:46.140",
      "text": "کن کنو"
    },
    {
      "id": 111,
      "start": 7786.14,
      "end": 7789.46,
      "formatted_start": "02:09:46.140",
      "formatted_end": "02:09:49.460",
      "text": "انات سقطره راحته میخوره خب"
    },
    {
      "id": 112,
      "start": 7789.46,
      "end": 7793.86,
      "formatted_start": "02:09:49.460",
      "formatted_end": "02:09:53.860",
      "text": "ولی یه مشکلی که داره شب توی خواب راحت داره میخوره"
    },
    {
      "id": 113,
      "start": 7793.86,
      "end": 7796.24,
      "formatted_start": "02:09:53.860",
      "formatted_end": "02:09:56.240",
      "text": "بدون هیچ زوری که بخواد مک بسنه"
    },
    {
      "id": 114,
      "start": 7796.24,
      "end": 7799.48,
      "formatted_start": "02:09:56.240",
      "formatted_end": "02:09:59.480",
      "text": "ولی اگر بیدار باشه یه بازی بازی میکنه"
    }
  ],
