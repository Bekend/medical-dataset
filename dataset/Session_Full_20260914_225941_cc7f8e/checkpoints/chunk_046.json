  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13803.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:03.000",
      "text": "مامانش بهش قول بده که الان باز میبرن به میلی پاک."
    },
    {
      "id": 1,
      "start": 13803.0,
      "end": 13804.0,
      "formatted_start": "03:50:03.000",
      "formatted_end": "03:50:04.000",
      "text": "خوب؟"
    },
    {
      "id": 2,
      "start": 13804.0,
      "end": 13805.0,
      "formatted_start": "03:50:04.000",
      "formatted_end": "03:50:05.000",
      "text": "بگو ما یه مزاره هم باز میبریم."
    },
    {
      "id": 3,
      "start": 13805.0,
      "end": 13807.0,
      "formatted_start": "03:50:05.000",
      "formatted_end": "03:50:07.000",
      "text": "چند روز داشت میره با سره هم؟"
    },
    {
      "id": 4,
      "start": 13807.0,
      "end": 13809.0,
      "formatted_start": "03:50:07.000",
      "formatted_end": "03:50:09.000",
      "text": "جان بابا، گلشت همه."
    },
    {
      "id": 5,
      "start": 13809.0,
      "end": 13814.0,
      "formatted_start": "03:50:09.000",
      "formatted_end": "03:50:14.000",
      "text": "موهدی شهره، یه چرا خود دینه خود هم، چه خواه خدایی داره؟"
    },
    {
      "id": 6,
      "start": 13814.0,
      "end": 13816.0,
      "formatted_start": "03:50:14.000",
      "formatted_end": "03:50:16.000",
      "text": "دمت کسی داره ببین."
    },
    {
      "id": 7,
      "start": 13816.0,
      "end": 13818.0,
      "formatted_start": "03:50:16.000",
      "formatted_end": "03:50:18.000",
      "text": "یه چیز یک سانه عیلت شده باشه."
    },
    {
      "id": 8,
      "start": 13818.0,
      "end": 13820.0,
      "formatted_start": "03:50:18.000",
      "formatted_end": "03:50:20.000",
      "text": "چرا داره؟"
    },
    {
      "id": 9,
      "start": 13820.0,
      "end": 13823.0,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:23.000",
      "text": "چیزی که قشن، انتها الان عذیبتش نکن."
    },
    {
      "id": 10,
      "start": 13823.0,
      "end": 13825.0,
      "formatted_start": "03:50:23.000",
      "formatted_end": "03:50:25.000",
      "text": "چه دوره تا افتیاره؟"
    },
    {
      "id": 11,
      "start": 13825.0,
      "end": 13829.0,
      "formatted_start": "03:50:25.000",
      "formatted_end": "03:50:29.000",
      "text": "دقیقا ۷۸ بود یک ماه پیش"
    },
    {
      "id": 12,
      "start": 13829.0,
      "end": 13831.0,
      "formatted_start": "03:50:29.000",
      "formatted_end": "03:50:31.000",
      "text": "خبیه"
    },
    {
      "id": 13,
      "start": 13831.0,
      "end": 13834.0,
      "formatted_start": "03:50:31.000",
      "formatted_end": "03:50:34.000",
      "text": "پد خابیده یک و نیم ساعت از قد اصداده"
    },
    {
      "id": 14,
      "start": 13834.0,
      "end": 13837.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:37.000",
      "text": "بابا باید ناز نیم خوابیده شو"
    },
    {
      "id": 15,
      "start": 13837.0,
      "end": 13841.0,
      "formatted_start": "03:50:37.000",
      "formatted_end": "03:50:41.000",
      "text": "بیا بیار با همه دادش رو یاد بیار"
    },
    {
      "id": 16,
      "start": 13841.0,
      "end": 13843.0,
      "formatted_start": "03:50:41.000",
      "formatted_end": "03:50:43.000",
      "text": "خوابیده خوابیده؟"
    },
    {
      "id": 17,
      "start": 13843.0,
      "end": 13845.0,
      "formatted_start": "03:50:43.000",
      "formatted_end": "03:50:45.000",
      "text": "بباید بباید بباید"
    },
    {
      "id": 18,
      "start": 13845.0,
      "end": 13847.0,
      "formatted_start": "03:50:45.000",
      "formatted_end": "03:50:47.000",
      "text": "۷۰۰"
    },
    {
      "id": 19,
      "start": 13847.0,
      "end": 13849.0,
      "formatted_start": "03:50:47.000",
      "formatted_end": "03:50:49.000",
      "text": "باشه باشه باشه"
    },
    {
      "id": 20,
      "start": 13849.0,
      "end": 13851.0,
      "formatted_start": "03:50:49.000",
      "formatted_end": "03:50:51.000",
      "text": "بباید بباشه بباشه"
    },
    {
      "id": 21,
      "start": 13851.0,
      "end": 13853.0,
      "formatted_start": "03:50:51.000",
      "formatted_end": "03:50:53.000",
      "text": "اگه میخوای بخوابش"
    },
    {
      "id": 22,
      "start": 13855.0,
      "end": 13857.0,
      "formatted_start": "03:50:55.000",
      "formatted_end": "03:50:57.000",
      "text": "باید بردارو بشیم"
    },
    {
      "id": 23,
      "start": 13857.0,
      "end": 13861.0,
      "formatted_start": "03:50:57.000",
      "formatted_end": "03:51:01.000",
      "text": "بالا بالا بالا تر شده"
    },
    {
      "id": 24,
      "start": 13861.0,
      "end": 13865.0,
      "formatted_start": "03:51:01.000",
      "formatted_end": "03:51:05.000",
      "text": "مرد نامونه باید بردارو بشیم"
    },
    {
      "id": 25,
      "start": 13865.0,
      "end": 13867.0,
      "formatted_start": "03:51:05.000",
      "formatted_end": "03:51:07.000",
      "text": "برای اینکه علاقه گرده بکنه"
    },
    {
      "id": 26,
      "start": 13867.0,
      "end": 13870.0,
      "formatted_start": "03:51:07.000",
      "formatted_end": "03:51:10.000",
      "text": "اقلی من ۷۸"
    },
    {
      "id": 27,
      "start": 13870.0,
      "end": 13872.0,
      "formatted_start": "03:51:10.000",
      "formatted_end": "03:51:12.000",
      "text": "عالی"
    },
    {
      "id": 28,
      "start": 13872.0,
      "end": 13875.0,
      "formatted_start": "03:51:12.000",
      "formatted_end": "03:51:15.000",
      "text": "بکش باشه"
    },
    {
      "id": 29,
      "start": 13875.0,
      "end": 13878.0,
      "formatted_start": "03:51:15.000",
      "formatted_end": "03:51:18.000",
      "text": "در اینکه باید ۷۵ باشه"
    },
    {
      "id": 30,
      "start": 13878.0,
      "end": 13880.0,
      "formatted_start": "03:51:18.000",
      "formatted_end": "03:51:20.000",
      "text": "بردارو بشه"
    },
    {
      "id": 31,
      "start": 13880.0,
      "end": 13882.0,
      "formatted_start": "03:51:20.000",
      "formatted_end": "03:51:22.000",
      "text": "بیا شبیه بردارو بشه"
    },
    {
      "id": 32,
      "start": 13882.0,
      "end": 13884.0,
      "formatted_start": "03:51:22.000",
      "formatted_end": "03:51:24.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 33,
      "start": 13884.0,
      "end": 13886.0,
      "formatted_start": "03:51:24.000",
      "formatted_end": "03:51:26.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 34,
      "start": 13886.0,
      "end": 13888.0,
      "formatted_start": "03:51:26.000",
      "formatted_end": "03:51:28.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 35,
      "start": 13888.0,
      "end": 13890.0,
      "formatted_start": "03:51:28.000",
      "formatted_end": "03:51:30.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 36,
      "start": 13890.0,
      "end": 13892.0,
      "formatted_start": "03:51:30.000",
      "formatted_end": "03:51:32.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 37,
      "start": 13892.0,
      "end": 13894.0,
      "formatted_start": "03:51:32.000",
      "formatted_end": "03:51:34.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 38,
      "start": 13894.0,
      "end": 13896.0,
      "formatted_start": "03:51:34.000",
      "formatted_end": "03:51:36.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 39,
      "start": 13896.0,
      "end": 13898.0,
      "formatted_start": "03:51:36.000",
      "formatted_end": "03:51:38.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 40,
      "start": 13898.0,
      "end": 13900.0,
      "formatted_start": "03:51:38.000",
      "formatted_end": "03:51:40.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 41,
      "start": 13900.0,
      "end": 13902.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:42.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 42,
      "start": 13902.0,
      "end": 13904.0,
      "formatted_start": "03:51:42.000",
      "formatted_end": "03:51:44.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 43,
      "start": 13904.0,
      "end": 13906.0,
      "formatted_start": "03:51:44.000",
      "formatted_end": "03:51:46.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 44,
      "start": 13906.0,
      "end": 13908.0,
      "formatted_start": "03:51:46.000",
      "formatted_end": "03:51:48.000",
      "text": "و اینجا باید بردارید"
    },
    {
      "id": 45,
      "start": 13908.0,
      "end": 13938.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:52:18.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 46,
      "start": 13938.0,
      "end": 13940.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:20.000",
      "text": "آه، چونه؟"
    },
    {
      "id": 47,
      "start": 13940.0,
      "end": 13942.0,
      "formatted_start": "03:52:20.000",
      "formatted_end": "03:52:22.000",
      "text": "بره جلد؟ باشه مردم"
    },
    {
      "id": 48,
      "start": 13949.0,
      "end": 13951.0,
      "formatted_start": "03:52:29.000",
      "formatted_end": "03:52:31.000",
      "text": "سلام، مردم جان خوبی؟"
    },
    {
      "id": 49,
      "start": 13951.0,
      "end": 13953.0,
      "formatted_start": "03:52:31.000",
      "formatted_end": "03:52:33.000",
      "text": "کن بودت درم، مردم جان؟"
    },
    {
      "id": 50,
      "start": 13953.0,
      "end": 13955.0,
      "formatted_start": "03:52:33.000",
      "formatted_end": "03:52:35.000",
      "text": "سلام، سلام، سلام"
    },
    {
      "id": 51,
      "start": 13955.0,
      "end": 13957.0,
      "formatted_start": "03:52:35.000",
      "formatted_end": "03:52:37.000",
      "text": "تفضل خوشگل من"
    },
    {
      "id": 52,
      "start": 13957.0,
      "end": 13959.0,
      "formatted_start": "03:52:37.000",
      "formatted_end": "03:52:39.000",
      "text": "خوبی؟"
    },
    {
      "id": 53,
      "start": 13959.0,
      "end": 13961.0,
      "formatted_start": "03:52:39.000",
      "formatted_end": "03:52:41.000",
      "text": "مردم جان چه خبرم؟ چی شده؟"
    },
    {
      "id": 54,
      "start": 13961.0,
      "end": 13963.0,
      "formatted_start": "03:52:41.000",
      "formatted_end": "03:52:43.000",
      "text": "گفتم چکش کنی؟"
    },
    {
      "id": 55,
      "start": 13963.0,
      "end": 13966.0,
      "formatted_start": "03:52:43.000",
      "formatted_end": "03:52:46.000",
      "text": "آه، حالا نشونه، یه ماه که نشونه"
    },
    {
      "id": 56,
      "start": 13966.0,
      "end": 13968.52,
      "formatted_start": "03:52:46.000",
      "formatted_end": "03:52:48.520",
      "text": "همه یه بردنش مونده هم برساشتش"
    },
    {
      "id": 57,
      "start": 13968.52,
      "end": 13972.44,
      "formatted_start": "03:52:48.520",
      "formatted_end": "03:52:52.440",
      "text": "ببینم لازت در چه حاله"
    },
    {
      "id": 58,
      "start": 13972.44,
      "end": 13975.68,
      "formatted_start": "03:52:52.440",
      "formatted_end": "03:52:55.680",
      "text": "یکم باز شده به راه گرد"
    },
    {
      "id": 59,
      "start": 13975.68,
      "end": 13977.42,
      "formatted_start": "03:52:55.680",
      "formatted_end": "03:52:57.420",
      "text": "باز شده از دلتر تا باله"
    },
    {
      "id": 60,
      "start": 13977.42,
      "end": 13981.42,
      "formatted_start": "03:52:57.420",
      "formatted_end": "03:53:01.420",
      "text": "خیلی بهتر"
    },
    {
      "id": 61,
      "start": 13981.42,
      "end": 13984.16,
      "formatted_start": "03:53:01.420",
      "formatted_end": "03:53:04.160",
      "text": "هنوز هم البته لازت داره"
    },
    {
      "id": 62,
      "start": 13984.16,
      "end": 13985.88,
      "formatted_start": "03:53:04.160",
      "formatted_end": "03:53:05.880",
      "text": "اون که بخوایی بگیر از بین رفته نه"
    },
    {
      "id": 63,
      "start": 13985.88,
      "end": 13988.52,
      "formatted_start": "03:53:05.880",
      "formatted_end": "03:53:08.520",
      "text": "ولی بشنه راهش باز شده"
    },
    {
      "id": 64,
      "start": 13988.52,
      "end": 13989.24,
      "formatted_start": "03:53:08.520",
      "formatted_end": "03:53:09.240",
      "text": "خودش میگه"
    },
    {
      "id": 65,
      "start": 13989.24,
      "end": 13993.58,
      "formatted_start": "03:53:09.240",
      "formatted_end": "03:53:13.580",
      "text": "اگه توی این دستش یه خوده این مونده"
    },
    {
      "id": 66,
      "start": 13993.58,
      "end": 13994.96,
      "formatted_start": "03:53:13.580",
      "formatted_end": "03:53:14.960",
      "text": "و یه خوبه شده بود"
    },
    {
      "id": 67,
      "start": 13994.96,
      "end": 13996.96,
      "formatted_start": "03:53:14.960",
      "formatted_end": "03:53:16.960",
      "text": "نه گوشت رو توجه کنن"
    },
    {
      "id": 68,
      "start": 13996.96,
      "end": 13998.96,
      "formatted_start": "03:53:16.960",
      "formatted_end": "03:53:18.960",
      "text": "همان"
    },
    {
      "id": 69,
      "start": 14000.96,
      "end": 14002.96,
      "formatted_start": "03:53:20.960",
      "formatted_end": "03:53:22.960",
      "text": "بعد همه باباش میده که عکس بگیره ببینید"
    },
    {
      "id": 70,
      "start": 14002.96,
      "end": 14004.96,
      "formatted_start": "03:53:22.960",
      "formatted_end": "03:53:24.960",
      "text": "ببینید بخرایه پر شده که"
    },
    {
      "id": 71,
      "start": 14004.96,
      "end": 14006.96,
      "formatted_start": "03:53:24.960",
      "formatted_end": "03:53:26.960",
      "text": "نه داخل"
    },
    {
      "id": 72,
      "start": 14006.96,
      "end": 14008.96,
      "formatted_start": "03:53:26.960",
      "formatted_end": "03:53:28.960",
      "text": "اتا استخونش بوده"
    },
    {
      "id": 73,
      "start": 14008.96,
      "end": 14010.96,
      "formatted_start": "03:53:28.960",
      "formatted_end": "03:53:30.960",
      "text": "این دسته بود را من"
    },
    {
      "id": 74,
      "start": 14010.96,
      "end": 14012.96,
      "formatted_start": "03:53:30.960",
      "formatted_end": "03:53:32.960",
      "text": "آه کجای دسته بود؟ من این را دیگه نمیدونم"
    },
    {
      "id": 75,
      "start": 14012.96,
      "end": 14014.96,
      "formatted_start": "03:53:32.960",
      "formatted_end": "03:53:34.960",
      "text": "این"
    },
    {
      "id": 76,
      "start": 14014.96,
      "end": 14016.96,
      "formatted_start": "03:53:34.960",
      "formatted_end": "03:53:36.960",
      "text": "نه چه خفه بوده"
    },
    {
      "id": 77,
      "start": 14016.96,
      "end": 14018.96,
      "formatted_start": "03:53:36.960",
      "formatted_end": "03:53:38.960",
      "text": "این آه"
    },
    {
      "id": 78,
      "start": 14018.96,
      "end": 14020.96,
      "formatted_start": "03:53:38.960",
      "formatted_end": "03:53:40.960",
      "text": "بوده اینگاه بوده"
    },
    {
      "id": 79,
      "start": 14020.96,
      "end": 14022.96,
      "formatted_start": "03:53:40.960",
      "formatted_end": "03:53:42.960",
      "text": "آه بعد برداشتن"
    },
    {
      "id": 80,
      "start": 14022.96,
      "end": 14024.96,
      "formatted_start": "03:53:42.960",
      "formatted_end": "03:53:44.960",
      "text": "اینجا بود"
    },
    {
      "id": 81,
      "start": 14024.96,
      "end": 14026.96,
      "formatted_start": "03:53:44.960",
      "formatted_end": "03:53:46.960",
      "text": "چی کار کردنشون اونجا؟"
    },
    {
      "id": 82,
      "start": 14026.96,
      "end": 14028.96,
      "formatted_start": "03:53:46.960",
      "formatted_end": "03:53:48.960",
      "text": "حالا میگم که کدوم دستشه"
    },
    {
      "id": 83,
      "start": 14028.96,
      "end": 14030.96,
      "formatted_start": "03:53:48.960",
      "formatted_end": "03:53:50.960",
      "text": "کدوم دستشه؟"
    },
    {
      "id": 84,
      "start": 14030.96,
      "end": 14032.96,
      "formatted_start": "03:53:50.960",
      "formatted_end": "03:53:52.960",
      "text": "کدوم دستت بودمه؟"
    },
    {
      "id": 85,
      "start": 14032.96,
      "end": 14034.96,
      "formatted_start": "03:53:52.960",
      "formatted_end": "03:53:54.960",
      "text": "اینجا بود"
    },
    {
      "id": 86,
      "start": 14034.96,
      "end": 14036.96,
      "formatted_start": "03:53:54.960",
      "formatted_end": "03:53:56.960",
      "text": "اینجا بود"
    },
    {
      "id": 87,
      "start": 14036.96,
      "end": 14038.96,
      "formatted_start": "03:53:56.960",
      "formatted_end": "03:53:58.960",
      "text": "تانگه تانگه"
    },
    {
      "id": 88,
      "start": 14038.96,
      "end": 14040.96,
      "formatted_start": "03:53:58.960",
      "formatted_end": "03:54:00.960",
      "text": "گچ بود"
    },
    {
      "id": 89,
      "start": 14040.96,
      "end": 14042.96,
      "formatted_start": "03:54:00.960",
      "formatted_end": "03:54:02.960",
      "text": "گچ گرست"
    },
    {
      "id": 90,
      "start": 14042.96,
      "end": 14044.96,
      "formatted_start": "03:54:02.960",
      "formatted_end": "03:54:04.960",
      "text": "دیگه ازاب شده"
    },
    {
      "id": 91,
      "start": 14044.96,
      "end": 14046.96,
      "formatted_start": "03:54:04.960",
      "formatted_end": "03:54:06.960",
      "text": "الانم خوبه خوبه"
    },
    {
      "id": 92,
      "start": 14046.96,
      "end": 14048.96,
      "formatted_start": "03:54:06.960",
      "formatted_end": "03:54:08.960",
      "text": "خب برامیر که چندا میره؟"
    },
    {
      "id": 93,
      "start": 14048.96,
      "end": 14050.96,
      "formatted_start": "03:54:08.960",
      "formatted_end": "03:54:10.960",
      "text": "اول فرق"
    },
    {
      "id": 94,
      "start": 14050.96,
      "end": 14057.96,
      "formatted_start": "03:54:10.960",
      "formatted_end": "03:54:17.960",
      "text": "از این هفته دستش جریانش چی بود؟"
    },
    {
      "id": 95,
      "start": 14057.96,
      "end": 14065.96,
      "formatted_start": "03:54:17.960",
      "formatted_end": "03:54:25.960",
      "text": "خب از سرساره افتاده بود و تو دستش برکه هفته بود"
    },
    {
      "id": 96,
      "start": 14065.96,
      "end": 14072.96,
      "formatted_start": "03:54:25.960",
      "formatted_end": "03:54:32.960",
      "text": "باشه از سرساره که افتاده بوده بردنش گرمه"
    },
    {
      "id": 97,
      "start": 14072.96,
      "end": 14077.58,
      "formatted_start": "03:54:32.960",
      "formatted_end": "03:54:37.580",
      "text": "از سرساره که افتاد و بوده بردنش که عکس گردن"
    },
    {
      "id": 98,
      "start": 14077.58,
      "end": 14079.98,
      "formatted_start": "03:54:37.580",
      "formatted_end": "03:54:39.980",
      "text": "بخش من هفره جریمش چی بود ببخشه"
    },
    {
      "id": 99,
      "start": 14079.98,
      "end": 14083.28,
      "formatted_start": "03:54:39.980",
      "formatted_end": "03:54:43.280",
      "text": "این هفره که تو دست راقب مرد بود"
    },
    {
      "id": 100,
      "start": 14083.28,
      "end": 14090.96,
      "formatted_start": "03:54:43.280",
      "formatted_end": "03:54:50.960",
      "text": "کجای دستش دردگرد؟"
    },
    {
      "id": 101,
      "start": 14090.96,
      "end": 14092.96,
      "formatted_start": "03:54:50.960",
      "formatted_end": "03:54:52.960",
      "text": "تو بازوش؟"
    },
    {
      "id": 102,
      "start": 14093.76,
      "end": 14095.8,
      "formatted_start": "03:54:53.760",
      "formatted_end": "03:54:55.800",
      "text": "نه نمیدونه کجای دستش؟"
    },
    {
      "id": 103,
      "start": 14095.8,
      "end": 14097.96,
      "formatted_start": "03:54:55.800",
      "formatted_end": "03:54:57.960",
      "text": "دست راست یا چب؟"
    },
    {
      "id": 104,
      "start": 14098.52,
      "end": 14099.58,
      "formatted_start": "03:54:58.520",
      "formatted_end": "03:54:59.580",
      "text": "چب"
    }
