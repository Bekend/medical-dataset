      "text": "این گیری هایی را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این"
    },
    {
      "id": 2,
      "start": 5760.0,
      "end": 5764.0,
      "formatted_start": "01:36:00.000",
      "formatted_end": "01:36:04.000",
      "text": "از اینجا آزمایش ویتامین پی و کلسیوم هم باشه"
    },
    {
      "id": 3,
      "start": 5764.0,
      "end": 5766.0,
      "formatted_start": "01:36:04.000",
      "formatted_end": "01:36:06.000",
      "text": "به هر پشت"
    },
    {
      "id": 4,
      "start": 5766.0,
      "end": 5768.0,
      "formatted_start": "01:36:06.000",
      "formatted_end": "01:36:08.000",
      "text": "پس من یاسمه آزمایش باشم"
    },
    {
      "id": 5,
      "start": 5768.0,
      "end": 5772.0,
      "formatted_start": "01:36:08.000",
      "formatted_end": "01:36:12.000",
      "text": "همدکتر این یک مهدوار هم سویدراری داره"
    },
    {
      "id": 6,
      "start": 5772.0,
      "end": 5774.0,
      "formatted_start": "01:36:12.000",
      "formatted_end": "01:36:14.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 5774.0,
      "end": 5776.0,
      "formatted_start": "01:36:14.000",
      "formatted_end": "01:36:16.000",
      "text": "پس آزمایش ادرار رو باید بدی؟"
    },
    {
      "id": 8,
      "start": 5776.0,
      "end": 5778.0,
      "formatted_start": "01:36:16.000",
      "formatted_end": "01:36:18.000",
      "text": "همدکتر بباشیم"
    },
    {
      "id": 9,
      "start": 5778.0,
      "end": 5782.0,
      "formatted_start": "01:36:18.000",
      "formatted_end": "01:36:22.000",
      "text": "این دوالو هست دیگه"
    },
    {
      "id": 10,
      "start": 5782.0,
      "end": 5784.0,
      "formatted_start": "01:36:22.000",
      "formatted_end": "01:36:24.000",
      "text": "مثل این هم ماینه کنید"
    },
    {
      "id": 11,
      "start": 5784.0,
      "end": 5786.0,
      "formatted_start": "01:36:24.000",
      "formatted_end": "01:36:26.000",
      "text": "بایی بدید"
    },
    {
      "id": 12,
      "start": 5786.0,
      "end": 5788.0,
      "formatted_start": "01:36:26.000",
      "formatted_end": "01:36:28.000",
      "text": "باشه هم پشت"
    },
    {
      "id": 13,
      "start": 5788.0,
      "end": 5790.0,
      "formatted_start": "01:36:28.000",
      "formatted_end": "01:36:30.000",
      "text": "این همه چیزی داره. هرچی هم."
    },
    {
      "id": 14,
      "start": 5790.0,
      "end": 5793.0,
      "formatted_start": "01:36:30.000",
      "formatted_end": "01:36:33.000",
      "text": "آره. آره. شب داره. اون این بله این گاه."
    },
    {
      "id": 15,
      "start": 5793.0,
      "end": 5795.0,
      "formatted_start": "01:36:33.000",
      "formatted_end": "01:36:35.000",
      "text": "دارم گاهی."
    },
    {
      "id": 16,
      "start": 5795.0,
      "end": 5797.0,
      "formatted_start": "01:36:35.000",
      "formatted_end": "01:36:37.000",
      "text": "نه نه."
    },
    {
      "id": 17,
      "start": 5799.0,
      "end": 5801.0,
      "formatted_start": "01:36:39.000",
      "formatted_end": "01:36:41.000",
      "text": "این هم پاس چیز میشه. این هم."
    },
    {
      "id": 18,
      "start": 5801.0,
      "end": 5803.0,
      "formatted_start": "01:36:41.000",
      "formatted_end": "01:36:43.000",
      "text": "اون هم میشه. اون هم میشه."
    },
    {
      "id": 19,
      "start": 5803.0,
      "end": 5805.0,
      "formatted_start": "01:36:43.000",
      "formatted_end": "01:36:45.000",
      "text": "اون هم میشه. اون هم میشه."
    },
    {
      "id": 20,
      "start": 5810.0,
      "end": 5814.0,
      "formatted_start": "01:36:50.000",
      "formatted_end": "01:36:54.000",
      "text": "همونطور اونستی رو جدی کنه دارندگی."
    },
    {
      "id": 21,
      "start": 5814.0,
      "end": 5818.0,
      "formatted_start": "01:36:54.000",
      "formatted_end": "01:36:58.000",
      "text": "چون بچه ها رو دیرپود کردن من می کردم اینجا"
    },
    {
      "id": 22,
      "start": 5826.0,
      "end": 5828.0,
      "formatted_start": "01:37:06.000",
      "formatted_end": "01:37:08.000",
      "text": "تمامه کجا دارم؟"
    },
    {
      "id": 23,
      "start": 5831.0,
      "end": 5832.0,
      "formatted_start": "01:37:11.000",
      "formatted_end": "01:37:12.000",
      "text": "نه نه"
    },
    {
      "id": 24,
      "start": 5838.0,
      "end": 5841.0,
      "formatted_start": "01:37:18.000",
      "formatted_end": "01:37:21.000",
      "text": "آدم میشه از این شب اضراری چلو گیر کرد؟"
    },
    {
      "id": 25,
      "start": 5841.0,
      "end": 5843.0,
      "formatted_start": "01:37:21.000",
      "formatted_end": "01:37:23.000",
      "text": "درستان رفته هم"
    },
    {
      "id": 26,
      "start": 5843.0,
      "end": 5845.0,
      "formatted_start": "01:37:23.000",
      "formatted_end": "01:37:25.000",
      "text": "خوب اون شبه داری داره"
    },
    {
      "id": 27,
      "start": 5845.0,
      "end": 5847.0,
      "formatted_start": "01:37:25.000",
      "formatted_end": "01:37:27.000",
      "text": "تازرین میدیم و اسپریم میزنیم"
    },
    {
      "id": 28,
      "start": 5847.0,
      "end": 5849.0,
      "formatted_start": "01:37:27.000",
      "formatted_end": "01:37:29.000",
      "text": "آهان خب از اون درمان داری میکنیم"
    },
    {
      "id": 29,
      "start": 5849.0,
      "end": 5851.0,
      "formatted_start": "01:37:29.000",
      "formatted_end": "01:37:31.000",
      "text": "درمان میکنیم ولی"
    },
    {
      "id": 30,
      "start": 5851.0,
      "end": 5853.0,
      "formatted_start": "01:37:31.000",
      "formatted_end": "01:37:33.000",
      "text": "کلن بر طرف نمیشه"
    },
    {
      "id": 31,
      "start": 5853.0,
      "end": 5855.0,
      "formatted_start": "01:37:33.000",
      "formatted_end": "01:37:35.000",
      "text": "پام داروها"
    },
    {
      "id": 32,
      "start": 5855.0,
      "end": 5857.0,
      "formatted_start": "01:37:35.000",
      "formatted_end": "01:37:37.000",
      "text": "شبه داری"
    },
    {
      "id": 33,
      "start": 5857.0,
      "end": 5859.0,
      "formatted_start": "01:37:37.000",
      "formatted_end": "01:37:39.000",
      "text": "از این درمان"
    },
    {
      "id": 34,
      "start": 5859.0,
      "end": 5861.0,
      "formatted_start": "01:37:39.000",
      "formatted_end": "01:37:41.000",
      "text": "از این درمان"
    },
    {
      "id": 35,
      "start": 5861.0,
      "end": 5863.0,
      "formatted_start": "01:37:41.000",
      "formatted_end": "01:37:43.000",
      "text": "از این درمان"
    },
    {
      "id": 36,
      "start": 5863.0,
      "end": 5865.0,
      "formatted_start": "01:37:43.000",
      "formatted_end": "01:37:45.000",
      "text": "از این درمان"
    },
    {
      "id": 37,
      "start": 5865.0,
      "end": 5867.0,
      "formatted_start": "01:37:45.000",
      "formatted_end": "01:37:47.000",
      "text": "از این درمان"
    },
    {
      "id": 38,
      "start": 5867.0,
      "end": 5869.0,
      "formatted_start": "01:37:47.000",
      "formatted_end": "01:37:49.000",
      "text": "از این درمان"
    },
    {
      "id": 39,
      "start": 5869.0,
      "end": 5872.16,
      "formatted_start": "01:37:49.000",
      "formatted_end": "01:37:52.160",
      "text": "شب ادراریش قط میشه"
    },
    {
      "id": 40,
      "start": 5872.16,
      "end": 5874.06,
      "formatted_start": "01:37:52.160",
      "formatted_end": "01:37:54.060",
      "text": "اونو باید ببرید دکتور کلیه بگیر"
    },
    {
      "id": 41,
      "start": 5874.06,
      "end": 5875.98,
      "formatted_start": "01:37:54.060",
      "formatted_end": "01:37:55.980",
      "text": "کلیه هم بردیم"
    },
    {
      "id": 42,
      "start": 5875.98,
      "end": 5877.36,
      "formatted_start": "01:37:55.980",
      "formatted_end": "01:37:57.360",
      "text": "آره مشهد بردیم"
    },
    {
      "id": 43,
      "start": 5877.36,
      "end": 5880.18,
      "formatted_start": "01:37:57.360",
      "formatted_end": "01:38:00.180",
      "text": "میگه یک سال جا داره"
    },
    {
      "id": 44,
      "start": 5880.18,
      "end": 5881.8,
      "formatted_start": "01:38:00.180",
      "formatted_end": "01:38:01.800",
      "text": "یک سال هم تموم شد"
    },
    {
      "id": 45,
      "start": 5881.8,
      "end": 5883.26,
      "formatted_start": "01:38:01.800",
      "formatted_end": "01:38:03.260",
      "text": "بازم قط نشوند"
    },
    {
      "id": 46,
      "start": 5883.26,
      "end": 5885.02,
      "formatted_start": "01:38:03.260",
      "formatted_end": "01:38:05.020",
      "text": "باید بشه خودش ببریم"
    },
    {
      "id": 47,
      "start": 5885.02,
      "end": 5887.72,
      "formatted_start": "01:38:05.020",
      "formatted_end": "01:38:07.720",
      "text": "نوار گرفت از مسانه"
    },
    {
      "id": 48,
      "start": 5887.72,
      "end": 5890.12,
      "formatted_start": "01:38:07.720",
      "formatted_end": "01:38:10.120",
      "text": "نوار هم گرفت"
    },
    {
      "id": 49,
      "start": 5890.12,
      "end": 5893.56,
      "formatted_start": "01:38:10.120",
      "formatted_end": "01:38:13.560",
      "text": "اون دیگه در حد تشکیل"
    },
    {
      "id": 50,
      "start": 5893.56,
      "end": 5895.02,
      "formatted_start": "01:38:13.560",
      "formatted_end": "01:38:15.020",
      "text": "این تخصص اونه"
    },
    {
      "id": 51,
      "start": 5895.02,
      "end": 5896.74,
      "formatted_start": "01:38:15.020",
      "formatted_end": "01:38:16.740",
      "text": "میدونید که تخصص ما نیست"
    },
    {
      "id": 52,
      "start": 5896.74,
      "end": 5898.94,
      "formatted_start": "01:38:16.740",
      "formatted_end": "01:38:18.940",
      "text": "ما وقتی یه بچه شب ادراری داریم"
    },
    {
      "id": 53,
      "start": 5898.94,
      "end": 5901.94,
      "formatted_start": "01:38:18.940",
      "formatted_end": "01:38:21.940",
      "text": "اگر اینجا جواب نمیده به درمان میفرستیمش بهش یک کلیه"
    },
    {
      "id": 54,
      "start": 5901.94,
      "end": 5903.94,
      "formatted_start": "01:38:21.940",
      "formatted_end": "01:38:23.940",
      "text": "خب؟ تو هم بیجا ببینه"
    },
    {
      "id": 55,
      "start": 5903.94,
      "end": 5908.94,
      "formatted_start": "01:38:23.940",
      "formatted_end": "01:38:28.940",
      "text": "نه، این امان جنی نمیشه دیگه"
    },
    {
      "id": 56,
      "start": 5908.94,
      "end": 5909.94,
      "formatted_start": "01:38:28.940",
      "formatted_end": "01:38:29.940",
      "text": "چی؟"
    },
    {
      "id": 57,
      "start": 5909.94,
      "end": 5911.94,
      "formatted_start": "01:38:29.940",
      "formatted_end": "01:38:31.940",
      "text": "معلوم نیست، ورد این وقت تو جنتیکه"
    },
    {
      "id": 58,
      "start": 5911.94,
      "end": 5912.94,
      "formatted_start": "01:38:31.940",
      "formatted_end": "01:38:32.940",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 5912.94,
      "end": 5918.94,
      "formatted_start": "01:38:32.940",
      "formatted_end": "01:38:38.940",
      "text": "اینجا خانواده که نیجی نبوده، خانواده پدر، خانواده ماده، هیچکه نیجی نبوده"
    },
    {
      "id": 60,
      "start": 5918.94,
      "end": 5919.94,
      "formatted_start": "01:38:38.940",
      "formatted_end": "01:38:39.940",
      "text": "نه، جیب"
    },
    {
      "id": 61,
      "start": 5919.94,
      "end": 5921.94,
      "formatted_start": "01:38:39.940",
      "formatted_end": "01:38:41.940",
      "text": "واو، همسرت فامیلی؟"
    },
    {
      "id": 62,
      "start": 5921.94,
      "end": 5923.94,
      "formatted_start": "01:38:41.940",
      "formatted_end": "01:38:43.940",
      "text": "آره، فامیلی"
    },
    {
      "id": 63,
      "start": 5923.94,
      "end": 5925.94,
      "formatted_start": "01:38:43.940",
      "formatted_end": "01:38:45.940",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 64,
      "start": 5925.94,
      "end": 5927.94,
      "formatted_start": "01:38:45.940",
      "formatted_end": "01:38:47.940",
      "text": "باید بردارید."
    },
    {
      "id": 65,
      "start": 5927.94,
      "end": 5929.94,
      "formatted_start": "01:38:47.940",
      "formatted_end": "01:38:49.940",
      "text": "باید بردارید."
    },
    {
      "id": 66,
      "start": 5929.94,
      "end": 5931.94,
      "formatted_start": "01:38:49.940",
      "formatted_end": "01:38:51.940",
      "text": "باید بردارید."
    },
    {
      "id": 67,
      "start": 5931.94,
      "end": 5933.94,
      "formatted_start": "01:38:51.940",
      "formatted_end": "01:38:53.940",
      "text": "باید بردارید."
    },
    {
      "id": 68,
      "start": 5933.94,
      "end": 5935.94,
      "formatted_start": "01:38:53.940",
      "formatted_end": "01:38:55.940",
      "text": "باید بردارید."
    },
    {
      "id": 69,
      "start": 5935.94,
      "end": 5937.94,
      "formatted_start": "01:38:55.940",
      "formatted_end": "01:38:57.940",
      "text": "باید بردارید."
    },
    {
      "id": 70,
      "start": 5937.94,
      "end": 5939.94,
      "formatted_start": "01:38:57.940",
      "formatted_end": "01:38:59.940",
      "text": "باید بردارید."
    },
    {
      "id": 71,
      "start": 5939.94,
      "end": 5941.94,
      "formatted_start": "01:38:59.940",
      "formatted_end": "01:39:01.940",
      "text": "باید بردارید."
    },
    {
      "id": 72,
      "start": 5941.94,
      "end": 5943.94,
      "formatted_start": "01:39:01.940",
      "formatted_end": "01:39:03.940",
      "text": "باید بردارید."
    },
    {
      "id": 73,
      "start": 5943.94,
      "end": 5945.94,
      "formatted_start": "01:39:03.940",
      "formatted_end": "01:39:05.940",
      "text": "باید بردارید."
    },
    {
      "id": 74,
      "start": 5945.94,
      "end": 5947.94,
      "formatted_start": "01:39:05.940",
      "formatted_end": "01:39:07.940",
      "text": "باید بردارید."
    },
    {
      "id": 75,
      "start": 5947.94,
      "end": 5949.94,
      "formatted_start": "01:39:07.940",
      "formatted_end": "01:39:09.940",
      "text": "باید بردارید."
    },
    {
      "id": 76,
      "start": 5949.94,
      "end": 5951.94,
      "formatted_start": "01:39:09.940",
      "formatted_end": "01:39:11.940",
      "text": "باید بردارید."
    },
    {
      "id": 77,
      "start": 5951.94,
      "end": 5954.94,
      "formatted_start": "01:39:11.940",
      "formatted_end": "01:39:14.940",
      "text": "خب اینو بعد آزما شایدگاه رو بده"
    },
    {
      "id": 78,
      "start": 5954.94,
      "end": 5957.94,
      "formatted_start": "01:39:14.940",
      "formatted_end": "01:39:17.940",
      "text": "بعد آقا باسه شبه کلالشون شده"
    },
    {
      "id": 79,
      "start": 5957.94,
      "end": 5960.94,
      "formatted_start": "01:39:17.940",
      "formatted_end": "01:39:20.940",
      "text": "خود ملیشو بده؟"
    },
    {
      "id": 80,
      "start": 5960.94,
      "end": 5962.94,
      "formatted_start": "01:39:20.940",
      "formatted_end": "01:39:22.940",
      "text": "بیمه تکمیلی داریم یا نه؟"
    },
    {
      "id": 81,
      "start": 5962.94,
      "end": 5964.94,
      "formatted_start": "01:39:22.940",
      "formatted_end": "01:39:24.940",
      "text": "نه"
    },
    {
      "id": 82,
      "start": 5964.94,
      "end": 5965.94,
      "formatted_start": "01:39:24.940",
      "formatted_end": "01:39:25.940",
      "text": "قبلنگی که داشتی؟"
    },
    {
      "id": 83,
      "start": 5965.94,
      "end": 5968.94,
      "formatted_start": "01:39:25.940",
