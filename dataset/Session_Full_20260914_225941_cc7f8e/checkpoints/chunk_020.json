    {
      "start": 6294.162,
      "end": 6295.563,
      "formatted_start": "01:44:54.162",
      "formatted_end": "01:44:55.563",
      "speaker": "SPEAKER_05"
    },
    {
      "start": 6295.968,
      "end": 6298.499,
      "formatted_start": "01:44:55.968",
      "formatted_end": "01:44:58.499",
      "speaker": "SPEAKER_05"
    },
    {
      "start": 6298.972,
      "end": 6299.967,
      "formatted_start": "01:44:58.972",
      "formatted_end": "01:44:59.967",
      "speaker": "SPEAKER_04"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6029.98,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6030.0,
      "end": 6032.0,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:32.000",
      "text": "خفیزم"
    },
    {
      "id": 2,
      "start": 6032.0,
      "end": 6034.0,
      "formatted_start": "01:40:32.000",
      "formatted_end": "01:40:34.000",
      "text": "نه"
    },
    {
      "id": 3,
      "start": 6034.0,
      "end": 6036.0,
      "formatted_start": "01:40:34.000",
      "formatted_end": "01:40:36.000",
      "text": "ایز"
    },
    {
      "id": 4,
      "start": 6036.0,
      "end": 6038.0,
      "formatted_start": "01:40:36.000",
      "formatted_end": "01:40:38.000",
      "text": "هشت سد و نویت و هشت خندو بود لالی"
    },
    {
      "id": 5,
      "start": 6038.0,
      "end": 6040.0,
      "formatted_start": "01:40:38.000",
      "formatted_end": "01:40:40.000",
      "text": "چه هوا بارم بشو و برم بیا"
    },
    {
      "id": 6,
      "start": 6040.0,
      "end": 6042.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:42.000",
      "text": "باشه؟"
    },
    {
      "id": 7,
      "start": 6042.0,
      "end": 6044.0,
      "formatted_start": "01:40:42.000",
      "formatted_end": "01:40:44.000",
      "text": "خدافر"
    },
    {
      "id": 8,
      "start": 6044.0,
      "end": 6046.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:40:46.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 9,
      "start": 6046.0,
      "end": 6048.0,
      "formatted_start": "01:40:46.000",
      "formatted_end": "01:40:48.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 10,
      "start": 6048.0,
      "end": 6050.0,
      "formatted_start": "01:40:48.000",
      "formatted_end": "01:40:50.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 11,
      "start": 6050.0,
      "end": 6052.0,
      "formatted_start": "01:40:50.000",
      "formatted_end": "01:40:52.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 12,
      "start": 6052.0,
      "end": 6054.0,
      "formatted_start": "01:40:52.000",
      "formatted_end": "01:40:54.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 13,
      "start": 6054.0,
      "end": 6056.0,
      "formatted_start": "01:40:54.000",
      "formatted_end": "01:40:56.000",
      "text": "اندوپت شبهده بری درمان میشه دیگه"
    },
    {
      "id": 14,
      "start": 6056.0,
      "end": 6061.2,
      "formatted_start": "01:40:56.000",
      "formatted_end": "01:41:01.200",
      "text": "برده بودی؟ بردیم که ولی پیش دکتر کلیه نه بردیم"
    },
    {
      "id": 15,
      "start": 6061.2,
      "end": 6061.24,
      "formatted_start": "01:41:01.200",
      "formatted_end": "01:41:01.240",
      "text": "نه بردیم"
    },
    {
      "id": 16,
      "start": 6061.24,
      "end": 6063.42,
      "formatted_start": "01:41:01.240",
      "formatted_end": "01:41:03.420",
      "text": "خب ایشان لفتی دارست"
    },
    {
      "id": 17,
      "start": 6063.42,
      "end": 6064.52,
      "formatted_start": "01:41:03.420",
      "formatted_end": "01:41:04.520",
      "text": "نگرده نمیشه"
    },
    {
      "id": 18,
      "start": 6064.52,
      "end": 6066.46,
      "formatted_start": "01:41:04.520",
      "formatted_end": "01:41:06.460",
      "text": "برگون شما خودم درست داریم"
    },
    {
      "id": 19,
      "start": 6066.46,
      "end": 6068.7,
      "formatted_start": "01:41:06.460",
      "formatted_end": "01:41:08.700",
      "text": "با محصولی جوابش میاره دیگه"
    },
    {
      "id": 20,
      "start": 6068.7,
      "end": 6070.04,
      "formatted_start": "01:41:08.700",
      "formatted_end": "01:41:10.040",
      "text": "باش باش باش"
    },
    {
      "id": 21,
      "start": 6070.04,
      "end": 6072.68,
      "formatted_start": "01:41:10.040",
      "formatted_end": "01:41:12.680",
      "text": "برگون شما خودم داریم"
    },
    {
      "id": 22,
      "start": 6072.68,
      "end": 6075.12,
      "formatted_start": "01:41:12.680",
      "formatted_end": "01:41:15.120",
      "text": "سلام"
    },
    {
      "id": 23,
      "start": 6075.12,
      "end": 6077.6,
      "formatted_start": "01:41:15.120",
      "formatted_end": "01:41:17.600",
      "text": "سلام احوال شما سلام"
    },
    {
      "id": 24,
      "start": 6077.6,
      "end": 6080.48,
      "formatted_start": "01:41:17.600",
      "formatted_end": "01:41:20.480",
      "text": "سلام مادر چند دوره خوب هستی؟"
    },
    {
      "id": 25,
      "start": 6080.48,
      "end": 6080.98,
      "formatted_start": "01:41:20.480",
      "formatted_end": "01:41:20.980",
      "text": "خوب هستیم"
    },
    {
      "id": 26,
      "start": 6080.98,
      "end": 6083.1,
      "formatted_start": "01:41:20.980",
      "formatted_end": "01:41:23.100",
      "text": "ممنون برسی بخورم رید"
    },
    {
      "id": 27,
      "start": 6083.1,
      "end": 6085.1,
      "formatted_start": "01:41:23.100",
      "formatted_end": "01:41:25.100",
      "text": "خب"
    },
    {
      "id": 28,
      "start": 6085.1,
      "end": 6087.1,
      "formatted_start": "01:41:25.100",
      "formatted_end": "01:41:27.100",
      "text": "خب"
    },
    {
      "id": 29,
      "start": 6087.1,
      "end": 6089.1,
      "formatted_start": "01:41:27.100",
      "formatted_end": "01:41:29.100",
      "text": "یه نقصه"
    },
    {
      "id": 30,
      "start": 6089.1,
      "end": 6091.1,
      "formatted_start": "01:41:29.100",
      "formatted_end": "01:41:31.100",
      "text": "هم دکتر"
    },
    {
      "id": 31,
      "start": 6091.1,
      "end": 6093.1,
      "formatted_start": "01:41:31.100",
      "formatted_end": "01:41:33.100",
      "text": "همیار شما رو خیلی خوب بیشناسه"
    },
    {
      "id": 32,
      "start": 6093.1,
      "end": 6095.1,
      "formatted_start": "01:41:33.100",
      "formatted_end": "01:41:35.100",
      "text": "خب"
    },
    {
      "id": 33,
      "start": 6095.1,
      "end": 6097.1,
      "formatted_start": "01:41:35.100",
      "formatted_end": "01:41:37.100",
      "text": "دوست شما هستون قبلن بهشم"
    },
    {
      "id": 34,
      "start": 6097.1,
      "end": 6099.1,
      "formatted_start": "01:41:37.100",
      "formatted_end": "01:41:39.100",
      "text": "چست داده بودی"
    },
    {
      "id": 35,
      "start": 6099.1,
      "end": 6101.1,
      "formatted_start": "01:41:39.100",
      "formatted_end": "01:41:41.100",
      "text": "برچست داده"
    },
    {
      "id": 36,
      "start": 6101.1,
      "end": 6103.1,
      "formatted_start": "01:41:41.100",
      "formatted_end": "01:41:43.100",
      "text": "الان یه جایزه بکتر هم"
    },
    {
      "id": 37,
      "start": 6103.1,
      "end": 6105.1,
      "formatted_start": "01:41:43.100",
      "formatted_end": "01:41:45.100",
      "text": "چزه میخوام بشم"
    },
    {
      "id": 38,
      "start": 6105.1,
      "end": 6107.1,
      "formatted_start": "01:41:45.100",
      "formatted_end": "01:41:47.100",
      "text": "الان بریز ایشونه"
    },
    {
      "id": 39,
      "start": 6107.1,
      "end": 6109.1,
      "formatted_start": "01:41:47.100",
      "formatted_end": "01:41:49.100",
      "text": "میره که منو یادشه"
    },
    {
      "id": 40,
      "start": 6109.1,
      "end": 6111.1,
      "formatted_start": "01:41:49.100",
      "formatted_end": "01:41:51.100",
      "text": "با همینگاه ایک ایک نکنم"
    },
    {
      "id": 41,
      "start": 6111.1,
      "end": 6115.94,
      "formatted_start": "01:41:51.100",
      "formatted_end": "01:41:55.940",
      "text": "عزیزم، اگه میشه یادم بره دو پسر به خوش اخلاقی و خوش رویی"
    },
    {
      "id": 42,
      "start": 6115.94,
      "end": 6119.94,
      "formatted_start": "01:41:55.940",
      "formatted_end": "01:41:59.940",
      "text": "بیمتون چیه؟ خدمتون"
    },
    {
      "id": 43,
      "start": 6119.94,
      "end": 6123.94,
      "formatted_start": "01:41:59.940",
      "formatted_end": "01:42:03.940",
      "text": "ما فیلم بریم به خدمتون شما به فنبای بشینه"
    },
    {
      "id": 44,
      "start": 6123.94,
      "end": 6127.94,
      "formatted_start": "01:42:03.940",
      "formatted_end": "01:42:07.940",
      "text": "تا من این سایتش رو دست کنم"
    },
    {
      "id": 45,
      "start": 6127.94,
      "end": 6131.94,
      "formatted_start": "01:42:07.940",
      "formatted_end": "01:42:11.940",
      "text": "خیلی، سنیان اون آرهان دکتورته نه؟"
    },
    {
      "id": 46,
      "start": 6131.94,
      "end": 6134.94,
      "formatted_start": "01:42:11.940",
      "formatted_end": "01:42:14.940",
      "text": "خیلی برای این"
    },
    {
      "id": 47,
      "start": 6134.94,
      "end": 6137.94,
      "formatted_start": "01:42:14.940",
      "formatted_end": "01:42:17.940",
      "text": "خب اسم آبچی چیه؟"
    },
    {
      "id": 48,
      "start": 6137.94,
      "end": 6140.94,
      "formatted_start": "01:42:17.940",
      "formatted_end": "01:42:20.940",
      "text": "تهنا، سانیا"
    },
    {
      "id": 49,
      "start": 6140.94,
      "end": 6143.94,
      "formatted_start": "01:42:20.940",
      "formatted_end": "01:42:23.940",
      "text": "راده چه؟ نه دو تا اسم داریم"
    },
    {
      "id": 50,
      "start": 6143.94,
      "end": 6145.94,
      "formatted_start": "01:42:23.940",
      "formatted_end": "01:42:25.940",
      "text": "برگردن بگذاریم پلا"
    },
    {
      "id": 51,
      "start": 6145.94,
      "end": 6147.94,
      "formatted_start": "01:42:25.940",
      "formatted_end": "01:42:27.940",
      "text": "رئیس کل گفت بگذاریم ثانیا"
    },
    {
      "id": 52,
      "start": 6147.94,
      "end": 6149.94,
      "formatted_start": "01:42:27.940",
      "formatted_end": "01:42:29.940",
      "text": "باید گرمام حرف آخد"
    },
    {
      "id": 53,
      "start": 6149.94,
      "end": 6151.94,
      "formatted_start": "01:42:29.940",
      "formatted_end": "01:42:31.940",
      "text": "رئیسی کل قبول کرد"
    },
    {
      "id": 54,
      "start": 6151.94,
      "end": 6153.94,
      "formatted_start": "01:42:31.940",
      "formatted_end": "01:42:33.940",
      "text": "باید بگذاریم پلا"
    },
    {
      "id": 55,
      "start": 6153.94,
      "end": 6155.94,
      "formatted_start": "01:42:33.940",
      "formatted_end": "01:42:35.940",
      "text": "همه میگن پلا"
    },
    {
      "id": 56,
      "start": 6155.94,
      "end": 6157.94,
      "formatted_start": "01:42:35.940",
      "formatted_end": "01:42:37.940",
      "text": "مقصد منچکر منچکر"
    },
    {
      "id": 57,
      "start": 6157.94,
      "end": 6159.94,
      "formatted_start": "01:42:37.940",
      "formatted_end": "01:42:39.940",
      "text": "شما نشین بگه ثانیا همه مهمه"
    },
    {
      "id": 58,
      "start": 6159.94,
      "end": 6161.94,
      "formatted_start": "01:42:39.940",
      "formatted_end": "01:42:41.940",
      "text": "مهم اینه که تو شناس مومنش دیگه"
    },
    {
      "id": 59,
      "start": 6161.94,
      "end": 6163.94,
      "formatted_start": "01:42:41.940",
      "formatted_end": "01:42:43.940",
      "text": "برگرد مدرسه همه ثانیا صدا شوی کنه"
    },
    {
      "id": 60,
      "start": 6163.94,
      "end": 6167.94,
      "formatted_start": "01:42:43.940",
      "formatted_end": "01:42:47.940",
      "text": "برگرد شما هم میگه که منو حتما ثانیا صدا شوی کنه"
    },
    {
      "id": 61,
      "start": 6167.94,
      "end": 6169.94,
      "formatted_start": "01:42:47.940",
      "formatted_end": "01:42:49.940",
      "text": "برگرد مومنش"
    },
    {
      "id": 62,
      "start": 6169.94,
      "end": 6171.94,
      "formatted_start": "01:42:49.940",
      "formatted_end": "01:42:51.940",
      "text": "اولا افلاح روش کار کار"
    },
    {
      "id": 63,
      "start": 6171.94,
      "end": 6175.94,
      "formatted_start": "01:42:51.940",
      "formatted_end": "01:42:55.940",
      "text": "نه که اسم رو عوض کن فلاح بذار"
    },
    {
      "id": 64,
      "start": 6175.94,
      "end": 6179.94,
      "formatted_start": "01:42:55.940",
      "formatted_end": "01:42:59.940",
      "text": "من چرا فلاح بذار شدم؟ خواهم دکتر میخواهم از دست این فلاح رو ببرم دخترم بابا"
    },
    {
      "id": 65,
      "start": 6179.94,
      "end": 6185.94,
      "formatted_start": "01:42:59.940",
      "formatted_end": "01:43:05.940",
      "text": "خویده افتریا منتور"
    },
    {
      "id": 66,
      "start": 6185.94,
      "end": 6191.94,
      "formatted_start": "01:43:05.940",
      "formatted_end": "01:43:11.940",
      "text": "خوب سانیا خواهم"
    },
    {
      "id": 67,
      "start": 6191.94,
      "end": 6195.94,
      "formatted_start": "01:43:11.940",
      "formatted_end": "01:43:15.940",
      "text": "خوب چی شد با این سانیا؟"
    },
    {
      "id": 68,
      "start": 6195.94,
      "end": 6198.94,
      "formatted_start": "01:43:15.940",
      "formatted_end": "01:43:18.940",
      "text": "اولا از این پیسرانی نداشت"
    },
    {
      "id": 69,
      "start": 6198.94,
      "end": 6203.94,
      "formatted_start": "01:43:18.940",
      "formatted_end": "01:43:23.940",
      "text": "چاشمبه من اینو بردم بیمارستان تایوکانی"
    },
    {
      "id": 70,
      "start": 6203.94,
      "end": 6205.94,
      "formatted_start": "01:43:23.940",
      "formatted_end": "01:43:25.940",
      "text": "عدسه میکرد عدسای زیادتر شد"
    },
    {
      "id": 71,
      "start": 6205.94,
      "end": 6209.94,
      "formatted_start": "01:43:25.940",
      "formatted_end": "01:43:29.940",
      "text": "آبریزش داشت یکم بی غرابی همش عرقی نقیصه"
    },
    {
      "id": 72,
      "start": 6209.94,
      "end": 6213.94,
      "formatted_start": "01:43:29.940",
      "formatted_end": "01:43:33.940",
      "text": "و اینگار یکم بهتر شد ولی آبریزش رو داشت"
    },
    {
      "id": 73,
      "start": 6213.94,
      "end": 6217.94,
      "formatted_start": "01:43:33.940",
      "formatted_end": "01:43:37.940",
      "text": "از دیروز از صبح کلن شروع شد اصحار شدن"
    },
    {
      "id": 74,
      "start": 6217.94,
      "end": 6219.94,
      "formatted_start": "01:43:37.940",
      "formatted_end": "01:43:39.940",
      "text": "یواش یواش آبکی شدن"
    },
    {
      "id": 75,
      "start": 6219.94,
      "end": 6221.94,
      "formatted_start": "01:43:39.940",
      "formatted_end": "01:43:41.940",
      "text": "الان که اومدم اینجا راست کنم کلن آب بوده اینگار"
    },
    {
      "id": 76,
      "start": 6221.94,
      "end": 6225.94,
      "formatted_start": "01:43:41.940",
      "formatted_end": "01:43:45.940",
      "text": "بعدشم ایروز کنم تب کرده شم تا ساعت چهار و نمیم تب دارم"
    },
    {
      "id": 77,
      "start": 6225.94,
      "end": 6227.94,
      "formatted_start": "01:43:45.940",
      "formatted_end": "01:43:47.940",
      "text": "الان دیگه سرده شم"
    },
    {
      "id": 78,
      "start": 6227.94,
      "end": 6229.94,
      "formatted_start": "01:43:47.940",
      "formatted_end": "01:43:49.940",
      "text": "چند ماهشم؟"
    },
    {
      "id": 79,
      "start": 6229.94,
      "end": 6231.94,
      "formatted_start": "01:43:49.940",
      "formatted_end": "01:43:51.940",
      "text": "ایروزم بردم دکترم"
    },
    {
      "id": 80,
      "start": 6231.94,
      "end": 6232.94,
      "formatted_start": "01:43:51.940",
      "formatted_end": "01:43:52.940",
      "text": "شیر چی بخورن؟"
    },
    {
      "id": 81,
      "start": 6232.94,
      "end": 6234.94,
      "formatted_start": "01:43:52.940",
      "formatted_end": "01:43:54.940",
      "text": "شیر خودمون بخورن"
    },
    {
      "id": 82,
      "start": 6234.94,
      "end": 6238.94,
      "formatted_start": "01:43:54.940",
      "formatted_end": "01:43:58.940",
      "text": "الان من بهش ایبو بروپین میدم، اسامی رو میدم، شربت بروپین میدم"
    },
    {
      "id": 83,
      "start": 6238.94,
      "end": 6242.94,
      "formatted_start": "01:43:58.940",
      "formatted_end": "01:44:02.940",
      "text": "بعد این استری بینی داد، آزیترو داد، ولی..."
    },
    {
      "id": 84,
      "start": 6242.94,
      "end": 6244.94,
      "formatted_start": "01:44:02.940",
      "formatted_end": "01:44:04.940",
      "text": "ببینید، این چه برونی؟"
    },
    {
      "id": 85,
      "start": 6244.94,
      "end": 6246.94,
      "formatted_start": "01:44:04.940",
      "formatted_end": "01:44:06.940",
      "text": "آره با فیروزه دکتر"
    },
    {
      "id": 86,
      "start": 6246.94,
      "end": 6248.94,
      "formatted_start": "01:44:06.940",
      "formatted_end": "01:44:08.940",
      "text": "خب، دستشو نگه دار؟"
    },
    {
      "id": 87,
      "start": 6248.94,
      "end": 6250.94,
      "formatted_start": "01:44:08.940",
      "formatted_end": "01:44:10.940",
      "text": "ببین داداشی رو ماینه کنی"
    },
    {
      "id": 88,
      "start": 6250.94,
      "end": 6252.94,
      "formatted_start": "01:44:10.940",
      "formatted_end": "01:44:12.940",
      "text": "داداشی"
    },
    {
      "id": 89,
      "start": 6252.94,
      "end": 6254.94,
      "formatted_start": "01:44:12.940",
      "formatted_end": "01:44:14.940",
      "text": "داداشی"
    },
    {
      "id": 90,
      "start": 6254.94,
      "end": 6256.94,
      "formatted_start": "01:44:14.940",
      "formatted_end": "01:44:16.940",
      "text": "حالا ماما"
    },
    {
      "id": 91,
      "start": 6256.94,
      "end": 6258.94,
      "formatted_start": "01:44:16.940",
      "formatted_end": "01:44:18.940",
      "text": "حالا سانیا"
    },
    {
      "id": 92,
      "start": 6258.94,
      "end": 6260.94,
      "formatted_start": "01:44:18.940",
      "formatted_end": "01:44:20.940",
      "text": "اجاز"
    },
    {
      "id": 93,
      "start": 6262.94,
      "end": 6264.94,
      "formatted_start": "01:44:22.940",
      "formatted_end": "01:44:24.940",
      "text": "تمام"
    },
    {
      "id": 94,
      "start": 6264.94,
      "end": 6266.94,
      "formatted_start": "01:44:24.940",
      "formatted_end": "01:44:26.940",
      "text": "تیتی"
    },
    {
      "id": 95,
      "start": 6266.94,
      "end": 6268.94,
      "formatted_start": "01:44:26.940",
      "formatted_end": "01:44:28.940",
      "text": "تیتی"
    },
    {
      "id": 96,
      "start": 6268.94,
      "end": 6270.94,
      "formatted_start": "01:44:28.940",
      "formatted_end": "01:44:30.940",
      "text": "حالا داداشی دردشو مست کنه"
    },
    {
      "id": 97,
      "start": 6270.94,
      "end": 6272.94,
      "formatted_start": "01:44:30.940",
      "formatted_end": "01:44:32.940",
      "text": "حالا ساده دردشو مست کنه"
    },
    {
      "id": 98,
      "start": 6272.94,
      "end": 6274.94,
      "formatted_start": "01:44:32.940",
      "formatted_end": "01:44:34.940",
      "text": "اینجا شاید دردشو پیش بکنه"
    },
    {
      "id": 99,
      "start": 6274.94,
      "end": 6276.94,
      "formatted_start": "01:44:34.940",
      "formatted_end": "01:44:36.940",
      "text": "آه ببین آه"
    },
    {
      "id": 100,
      "start": 6276.94,
      "end": 6299.94,
      "formatted_start": "01:44:36.940",
      "formatted_end": "01:44:59.940",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}