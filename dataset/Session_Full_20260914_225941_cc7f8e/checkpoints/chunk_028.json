  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8406.46,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:06.460",
      "text": "در خطی که نگرانش بشید، یه زمین اززردی داره و پرداشت خوب، نگرانش بشید."
    },
    {
      "id": 1,
      "start": 8406.46,
      "end": 8411.46,
      "formatted_start": "02:20:06.460",
      "formatted_end": "02:20:11.460",
      "text": "اینه، پس آزمایش ادراج رو میرین، بس هم انجام بده و..."
    },
    {
      "id": 2,
      "start": 8411.46,
      "end": 8416.3,
      "formatted_start": "02:20:11.460",
      "formatted_end": "02:20:16.300",
      "text": "یعنی هم ویتامین ای هم نیمونستر رو قطع کنم؟"
    },
    {
      "id": 3,
      "start": 8416.3,
      "end": 8422.3,
      "formatted_start": "02:20:16.300",
      "formatted_end": "02:20:22.300",
      "text": "ویتامین ای شو بده تموم بشه، اون یه شیشه ای که داری، ولی نیمونسترش رو قطع کن."
    },
    {
      "id": 4,
      "start": 8422.3,
      "end": 8423.7,
      "formatted_start": "02:20:22.300",
      "formatted_end": "02:20:23.700",
      "text": "خب ببخشی من یه لحظه بخشم."
    },
    {
      "id": 5,
      "start": 8423.7,
      "end": 8428.66,
      "formatted_start": "02:20:23.700",
      "formatted_end": "02:20:28.660",
      "text": "یه کم برای این که مدخوش او بیاد نداره؟"
    },
    {
      "id": 6,
      "start": 8428.66,
      "end": 8432.66,
      "formatted_start": "02:20:28.660",
      "formatted_end": "02:20:32.660",
      "text": "آره اون هست ولی از این طرف دلدردش رو بیشتر می کنی"
    },
    {
      "id": 7,
      "start": 8432.66,
      "end": 8435.66,
      "formatted_start": "02:20:32.660",
      "formatted_end": "02:20:35.660",
      "text": "پس شیر خوش بقیه می دین؟"
    },
    {
      "id": 8,
      "start": 8435.66,
      "end": 8441.66,
      "formatted_start": "02:20:35.660",
      "formatted_end": "02:20:41.660",
      "text": "شیر خودم تقریباً 60-60 دردیل می ده"
    },
    {
      "id": 9,
      "start": 8441.66,
      "end": 8445.66,
      "formatted_start": "02:20:41.660",
      "formatted_end": "02:20:45.660",
      "text": "از درمندش احتمالاً یک برش چیشه داده که دیوتی نداره"
    },
    {
      "id": 10,
      "start": 8445.66,
      "end": 8451.66,
      "formatted_start": "02:20:45.660",
      "formatted_end": "02:20:51.660",
      "text": "دو زبط مثلاً من شیر خودم رو دادم از روز ثلاثه که می خواستم بدم اصلاً نگهر"
    },
    {
      "id": 11,
      "start": 8451.66,
      "end": 8456.66,
      "formatted_start": "02:20:51.660",
      "formatted_end": "02:20:56.660",
      "text": "چند سال تلاش کردی که بهش چیشه شیر ندی که عادت نداره اون راحت که دیگه"
    },
    {
      "id": 12,
      "start": 8456.66,
      "end": 8463.22,
      "formatted_start": "02:20:56.660",
      "formatted_end": "02:21:03.220",
      "text": "دیگه دیگه. اصلا سینه ای مانه نگرفت. حالا مثلا با شوهرمی رو میگن چشم خورده"
    },
    {
      "id": 13,
      "start": 8463.22,
      "end": 8469.86,
      "formatted_start": "02:21:03.220",
      "formatted_end": "02:21:09.860",
      "text": "فعلا. دیگه وگردن میگرفت و قشن ساعت چهر در قشن یک شیر میخورد."
    },
    {
      "id": 14,
      "start": 8469.86,
      "end": 8475.22,
      "formatted_start": "02:21:09.860",
      "formatted_end": "02:21:15.220",
      "text": "ممنون هیچ. آره. و الان هم دیگه شیرم کم داره کم میشه. آره دیگه کم داره."
    },
    {
      "id": 15,
      "start": 8475.22,
      "end": 8477.22,
      "formatted_start": "02:21:15.220",
      "formatted_end": "02:21:17.220",
      "text": "از اینجا کارتون رو سمیت بگیریم که چجوریه"
    },
    {
      "id": 16,
      "start": 8477.22,
      "end": 8479.22,
      "formatted_start": "02:21:17.220",
      "formatted_end": "02:21:19.220",
      "text": "گری گری"
    },
    {
      "id": 17,
      "start": 8479.22,
      "end": 8481.22,
      "formatted_start": "02:21:19.220",
      "formatted_end": "02:21:21.220",
      "text": "کچورو"
    },
    {
      "id": 18,
      "start": 8481.22,
      "end": 8483.22,
      "formatted_start": "02:21:21.220",
      "formatted_end": "02:21:23.220",
      "text": "پسر خوشگیر"
    },
    {
      "id": 19,
      "start": 8483.22,
      "end": 8485.22,
      "formatted_start": "02:21:23.220",
      "formatted_end": "02:21:25.220",
      "text": "پسر بشه"
    },
    {
      "id": 20,
      "start": 8487.22,
      "end": 8489.22,
      "formatted_start": "02:21:27.220",
      "formatted_end": "02:21:29.220",
      "text": "باید شیر میکردیم"
    },
    {
      "id": 21,
      "start": 8495.22,
      "end": 8497.22,
      "formatted_start": "02:21:35.220",
      "formatted_end": "02:21:37.220",
