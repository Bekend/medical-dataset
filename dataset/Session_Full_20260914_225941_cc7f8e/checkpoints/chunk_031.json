      "end": 9514.0,
      "formatted_start": "02:38:32.000",
      "formatted_end": "02:38:34.000",
      "text": "بابا بابا ببینم پسرها سنیجه"
    },
    {
      "id": 48,
      "start": 9514.0,
      "end": 9518.0,
      "formatted_start": "02:38:34.000",
      "formatted_end": "02:38:38.000",
      "text": "سلام اجوندم آفری چه پسر معدویه"
    },
