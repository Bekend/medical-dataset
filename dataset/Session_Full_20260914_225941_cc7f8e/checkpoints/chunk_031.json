      "id": 40,
      "start": 9492.0,
      "end": 9494.0,
      "formatted_start": "02:38:12.000",
      "formatted_end": "02:38:14.000",
      "text": "از دهنش نشانده"
    },
    {
      "id": 41,
      "start": 9494.0,
      "end": 9500.0,
      "formatted_start": "02:38:14.000",
      "formatted_end": "02:38:20.000",
      "text": "آفری"
    },
    {
      "id": 42,
      "start": 9500.0,
      "end": 9504.0,
      "formatted_start": "02:38:20.000",
      "formatted_end": "02:38:24.000",
      "text": "آفری پسر گونام"
    },
    {
      "id": 43,
      "start": 9504.0,
      "end": 9506.0,
      "formatted_start": "02:38:24.000",
      "formatted_end": "02:38:26.000",
      "text": "خوش آمدیم"
    },
    {
      "id": 44,
      "start": 9506.0,
      "end": 9508.0,
      "formatted_start": "02:38:26.000",
      "formatted_end": "02:38:28.000",
      "text": "سلام ممنون شما"
    },
