      "start": 9508.0,
      "end": 9510.0,
      "formatted_start": "02:38:28.000",
      "formatted_end": "02:38:30.000",
      "text": "فیستی سلام"
    },
    {
      "id": 46,
      "start": 9510.0,
      "end": 9512.0,
      "formatted_start": "02:38:30.000",
      "formatted_end": "02:38:32.000",
      "text": "پسرهای گونام"
    },
