  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9330.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:30.000",
      "text": "بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "بیا اینجا بیا برو جا بشین"
    },
    {
      "id": 2,
      "start": 9334.0,
      "end": 9336.0,
      "formatted_start": "02:35:34.000",
      "formatted_end": "02:35:36.000",
      "text": "ببین اندرهم خودماشو دوست داری"
    },
    {
      "id": 3,
      "start": 9336.0,
      "end": 9338.0,
      "formatted_start": "02:35:36.000",
      "formatted_end": "02:35:38.000",
      "text": "ببین خیلی مخلصه"
    },
    {
      "id": 4,
      "start": 9338.0,
      "end": 9340.0,
      "formatted_start": "02:35:38.000",
      "formatted_end": "02:35:40.000",
      "text": "هر خودمشو دوست داری"
    },
    {
      "id": 5,
      "start": 9340.0,
      "end": 9342.0,
      "formatted_start": "02:35:40.000",
      "formatted_end": "02:35:42.000",
      "text": "و همون"
    },
    {
      "id": 6,
      "start": 9346.0,
      "end": 9348.0,
      "formatted_start": "02:35:46.000",
      "formatted_end": "02:35:48.000",
      "text": "من اینو نمیخوام"
    },
    {
      "id": 7,
      "start": 9348.0,
      "end": 9350.0,
      "formatted_start": "02:35:48.000",
      "formatted_end": "02:35:50.000",
      "text": "من برای اینو خواهم"
    },
    {
      "id": 8,
      "start": 9350.0,
      "end": 9352.0,
      "formatted_start": "02:35:50.000",
      "formatted_end": "02:35:52.000",
      "text": "نظران خوض هم بود"
    },
    {
      "id": 9,
      "start": 9352.0,
      "end": 9354.0,
      "formatted_start": "02:35:52.000",
      "formatted_end": "02:35:54.000",
      "text": "خیلی هم خوض هم رو برد"
    },
    {
      "id": 10,
      "start": 9354.0,
      "end": 9358.0,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:35:58.000",
      "text": "خب ببینید من برای شعبت آزیز رو مایز تنمی نشتم"
    },
    {
      "id": 11,
      "start": 9358.0,
      "end": 9366.0,
      "formatted_start": "02:35:58.000",
      "formatted_end": "02:36:06.000",
      "text": "روز اول به چهار سیزی بردیم، از روز دومبون دو سیزی تا پنج سیزی"
    },
    {
      "id": 12,
      "start": 9366.0,
      "end": 9376.0,
      "formatted_start": "02:36:06.000",
      "formatted_end": "02:36:16.000",
      "text": "یک برای شروط نیوتالی نگاشتم، هر دوازده ساعت به چهار سیزی بردیم"
    },
    {
      "id": 13,
      "start": 9376.0,
      "end": 9385.0,
      "formatted_start": "02:36:16.000",
      "formatted_end": "02:36:25.000",
      "text": "و یک گرس منتلوکاز یا ایروکاز از روز ها یک برای صورتش خریدیم"
    },
    {
      "id": 14,
      "start": 9385.0,
      "end": 9395.0,
      "formatted_start": "02:36:25.000",
      "formatted_end": "02:36:35.000",
      "text": "خب، برای اون پلاشنگ که اوف می دارید، شربتش را دادید می داره روزی سه بار بهش پنجی پلاشنگ"
    },
    {
      "id": 15,
      "start": 9395.0,
      "end": 9404.0,
      "formatted_start": "02:36:35.000",
      "formatted_end": "02:36:44.000",
      "text": "یه اصفه دیگه همین رو نیستم برای این صورتها هاش و خسخ از سینه هاش، هر دوست ده ساعت دو بار و هشت هستم"
    },
    {
      "id": 16,
      "start": 9404.0,
      "end": 9406.0,
      "formatted_start": "02:36:44.000",
      "formatted_end": "02:36:46.000",
      "text": "این هم برم شویز"
    },
    {
      "id": 17,
      "start": 9413.0,
      "end": 9415.0,
      "formatted_start": "02:36:53.000",
      "formatted_end": "02:36:55.000",
      "text": "دستش تا فردا خوب میشه؟"
    },
    {
      "id": 18,
      "start": 9416.0,
      "end": 9417.0,
      "formatted_start": "02:36:56.000",
      "formatted_end": "02:36:57.000",
      "text": "تا فردا..."
    },
    {
      "id": 19,
      "start": 9418.0,
      "end": 9419.0,
      "formatted_start": "02:36:58.000",
      "formatted_end": "02:36:59.000",
      "text": "از چهره باشه؟"
    },
    {
      "id": 20,
      "start": 9419.0,
      "end": 9421.0,
      "formatted_start": "02:36:59.000",
      "formatted_end": "02:37:01.000",
      "text": "دستش تا چند ساعت دیگه خوب میشه"
    },
    {
      "id": 21,
      "start": 9421.0,
      "end": 9422.0,
      "formatted_start": "02:37:01.000",
      "formatted_end": "02:37:02.000",
      "text": "خوب میشه"
    },
    {
      "id": 22,
      "start": 9427.0,
      "end": 9429.0,
      "formatted_start": "02:37:07.000",
      "formatted_end": "02:37:09.000",
      "text": "اینو بزن"
    },
    {
      "id": 23,
      "start": 9430.0,
      "end": 9431.0,
      "formatted_start": "02:37:10.000",
      "formatted_end": "02:37:11.000",
      "text": "اینو بزن"
    },
    {
      "id": 24,
      "start": 9431.0,
      "end": 9432.0,
      "formatted_start": "02:37:11.000",
      "formatted_end": "02:37:12.000",
      "text": "خوب میشه"
    },
    {
      "id": 25,
      "start": 9434.0,
      "end": 9436.0,
      "formatted_start": "02:37:14.000",
      "formatted_end": "02:37:16.000",
      "text": "خوب کنم دستشو دیگه"
    },
    {
      "id": 26,
      "start": 9436.0,
      "end": 9438.0,
      "formatted_start": "02:37:16.000",
      "formatted_end": "02:37:18.000",
      "text": "این سودشو هم ندیدم"
    },
    {
      "id": 27,
      "start": 9438.0,
      "end": 9440.0,
      "formatted_start": "02:37:18.000",
      "formatted_end": "02:37:20.000",
      "text": "اکتبار بشو کمی بخونیم"
    },
    {
      "id": 28,
      "start": 9440.0,
      "end": 9442.0,
      "formatted_start": "02:37:20.000",
      "formatted_end": "02:37:22.000",
      "text": "سودشو شکم"
    },
    {
      "id": 29,
      "start": 9442.0,
      "end": 9444.0,
      "formatted_start": "02:37:22.000",
      "formatted_end": "02:37:24.000",
      "text": "ببینیم در این درگاه"
    },
    {
      "id": 30,
      "start": 9444.0,
      "end": 9446.0,
      "formatted_start": "02:37:24.000",
      "formatted_end": "02:37:26.000",
      "text": "دستشو بشو بگیم"
    },
    {
      "id": 31,
      "start": 9446.0,
      "end": 9448.0,
      "formatted_start": "02:37:26.000",
      "formatted_end": "02:37:28.000",
      "text": "با آب و سابون"
    },
    {
      "id": 32,
      "start": 9448.0,
      "end": 9450.0,
      "formatted_start": "02:37:28.000",
      "formatted_end": "02:37:30.000",
      "text": "برگرام شب شو"
    },
    {
      "id": 33,
      "start": 9450.0,
      "end": 9452.0,
      "formatted_start": "02:37:30.000",
      "formatted_end": "02:37:32.000",
      "text": "بله شب"
    },
    {
      "id": 34,
      "start": 9452.0,
      "end": 9454.0,
      "formatted_start": "02:37:32.000",
      "formatted_end": "02:37:34.000",
      "text": "اینو خود رفتگیری هم برات دارم"
    },
    {
      "id": 35,
      "start": 9454.0,
      "end": 9456.0,
      "formatted_start": "02:37:34.000",
      "formatted_end": "02:37:36.000",
      "text": "این خود رفتگیری هم برات دارم"
    },
    {
      "id": 36,
      "start": 9456.0,
      "end": 9458.0,
      "formatted_start": "02:37:36.000",
      "formatted_end": "02:37:38.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 9458.0,
      "end": 9460.0,
      "formatted_start": "02:37:38.000",
      "formatted_end": "02:37:40.000",
      "text": "ببین ستاره هم بیتن"
    },
    {
      "id": 38,
      "start": 9460.0,
      "end": 9462.0,
      "formatted_start": "02:37:40.000",
      "formatted_end": "02:37:42.000",
      "text": "آره ببین"
    },
    {
      "id": 39,
      "start": 9462.0,
      "end": 9491.98,
      "formatted_start": "02:37:42.000",
      "formatted_end": "02:38:11.980",
      "text": "باید برداری کنید"
    },
