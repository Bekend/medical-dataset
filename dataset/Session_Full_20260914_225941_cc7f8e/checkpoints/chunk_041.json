      "start": 12505.0,
      "end": 12507.0,
      "formatted_start": "03:28:25.000",
      "formatted_end": "03:28:27.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 89,
      "start": 12507.0,
      "end": 12509.0,
      "formatted_start": "03:28:27.000",
      "formatted_end": "03:28:29.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 90,
      "start": 12509.0,
      "end": 12511.0,
      "formatted_start": "03:28:29.000",
      "formatted_end": "03:28:31.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 91,
      "start": 12511.0,
      "end": 12513.0,
      "formatted_start": "03:28:31.000",
      "formatted_end": "03:28:33.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 92,
      "start": 12513.0,
      "end": 12515.0,
      "formatted_start": "03:28:33.000",
      "formatted_end": "03:28:35.000",
      "text": "از اینکه شیرش را برای شیر خشک را برسید."
    },
    {
      "id": 93,
      "start": 12515.0,
      "end": 12517.0,
      "formatted_start": "03:28:35.000",
      "formatted_end": "03:28:37.000",
      "text": "مثلا، از اینکه شیر خشک را برای شیر خشک را برسید."
    },
    {
      "id": 94,
      "start": 12517.0,
      "end": 12519.0,
      "formatted_start": "03:28:37.000",
      "formatted_end": "03:28:39.000",
      "text": "از اینکه شیر خشک را برای شیر خشک را برسید."
    },
    {
      "id": 95,
      "start": 12519.0,
      "end": 12521.0,
      "formatted_start": "03:28:39.000",
      "formatted_end": "03:28:41.000",
      "text": "از اینکه شیر خشک را برای شیر خشک را برای شیر خشک را برسید."
    },
    {
      "id": 96,
      "start": 12521.0,
      "end": 12527.0,
      "formatted_start": "03:28:41.000",
      "formatted_end": "03:28:47.000",
      "text": "آره، مثلا فرنی براش درست میکنی، خب شیر خشکش رو بریز داخلی"
    },
    {
      "id": 97,
      "start": 12527.0,
      "end": 12531.0,
      "formatted_start": "03:28:47.000",
      "formatted_end": "03:28:51.000",
      "text": "سرلاک میخوایی براش بدی، دو تا پیمونه شیر خشکش رو بریز بگی"
    },
    {
      "id": 98,
      "start": 12531.0,
      "end": 12536.0,
      "formatted_start": "03:28:51.000",
      "formatted_end": "03:28:56.000",
      "text": "به این صورت بهش شیرشو برسو، یا مثلا براش اطبیل درست کنی"
    },
    {
      "id": 99,
      "start": 12536.0,
      "end": 12543.0,
      "formatted_start": "03:28:56.000",
      "formatted_end": "03:29:03.000",
      "text": "مثلا با موز و نمیدونم جوی دو سرپردق و همه اینها رو بریز لح بکن"
    },
    {
      "id": 100,
      "start": 12543.0,
      "end": 12547.0,
      "formatted_start": "03:29:03.000",
      "formatted_end": "03:29:07.000",
      "text": "دو تا پیمونه شیر خشکش رو بریز، خب به این صورت شیر رو براش برسو"
    },
    {
      "id": 101,
      "start": 12547.0,
      "end": 12557.0,
      "formatted_start": "03:29:07.000",
      "formatted_end": "03:29:17.000",
      "text": "همچنین از این برنامه هایی که بخورند. از یک سال به بعد روز یک لیبان شیر بخورند کافی است."
    },
    {
      "id": 102,
      "start": 12557.0,
      "end": 12567.0,
      "formatted_start": "03:29:17.000",
      "formatted_end": "03:29:27.000",
      "text": "دوستانی بیشتر شیر بخورند. اگر اون شیر نمیخورد تو قضاها با شیر بیشتر بخورند."
    },
    {
      "id": 103,
      "start": 12567.0,
      "end": 12573.0,
      "formatted_start": "03:29:27.000",
      "formatted_end": "03:29:33.000",
      "text": "بعد از این شیر موجان رو برای شیر مزدید"
    },
    {
      "id": 104,
      "start": 12573.0,
      "end": 12577.0,
      "formatted_start": "03:29:33.000",
      "formatted_end": "03:29:37.000",
      "text": "بعد توش موز میرزم، خورما میرزم، پسته میرزم، پودر هستم"
    },
    {
      "id": 105,
      "start": 12577.0,
      "end": 12579.0,
      "formatted_start": "03:29:37.000",
      "formatted_end": "03:29:39.000",
      "text": "آخ دیگه اون شیر هر حال داره میخوره"
    },
    {
      "id": 106,
      "start": 12579.0,
      "end": 12580.0,
      "formatted_start": "03:29:39.000",
      "formatted_end": "03:29:40.000",
      "text": "آره اونو میخورم"
    },
    {
      "id": 107,
      "start": 12580.0,
      "end": 12583.0,
      "formatted_start": "03:29:40.000",
      "formatted_end": "03:29:43.000",
      "text": "بعد دهاره برایش اصولا حلیم طور دارست"
    },
    {
      "id": 108,
      "start": 12583.0,
      "end": 12586.0,
      "formatted_start": "03:29:43.000",
      "formatted_end": "03:29:46.000",
      "text": "میخورم گوشت و آب قلن و جوید و سرطن و اینا"
    },
    {
      "id": 109,
      "start": 12586.0,
      "end": 12590.0,
      "formatted_start": "03:29:46.000",
      "formatted_end": "03:29:50.000",
      "text": "میوان با پوره میوه 3-4 مدل پوره میخورم با ماست بهش میدن"
    },
    {
      "id": 110,
      "start": 12590.0,
      "end": 12592.0,
      "formatted_start": "03:29:50.000",
      "formatted_end": "03:29:52.000",
      "text": "سه را تن میخوره برای این آره"
    },
    {
      "id": 111,
      "start": 12592.0,
      "end": 12594.0,
      "formatted_start": "03:29:52.000",
      "formatted_end": "03:29:54.000",
      "text": "آره، سه را کشون باشه"
    },
    {
      "id": 112,
      "start": 12594.0,
      "end": 12596.0,
      "formatted_start": "03:29:54.000",
      "formatted_end": "03:29:56.000",
      "text": "از اینکه شیر خشک برد"
    },
    {
      "id": 113,
      "start": 12596.0,
      "end": 12598.0,
      "formatted_start": "03:29:56.000",
      "formatted_end": "03:29:58.000",
      "text": "و از حلی برد"
    },
    {
      "id": 114,
      "start": 12598.0,
      "end": 12600.0,
      "formatted_start": "03:29:58.000",
      "formatted_end": "03:30:00.000",
      "text": "و در اینکه"
    }
  ],
  "status": "completed"
}