  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10202.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:02.000",
      "text": "بازماشت یک درخوفتن نداریم."
    },
    {
      "id": 1,
      "start": 10202.0,
      "end": 10204.0,
      "formatted_start": "02:50:02.000",
      "formatted_end": "02:50:04.000",
      "text": "کم خون نمودی؟"
    },
    {
      "id": 2,
      "start": 10204.0,
      "end": 10206.0,
      "formatted_start": "02:50:04.000",
      "formatted_end": "02:50:06.000",
      "text": "کم خون نمودیم."
    },
    {
      "id": 3,
      "start": 10206.0,
      "end": 10208.0,
      "formatted_start": "02:50:06.000",
      "formatted_end": "02:50:08.000",
      "text": "پریولیت شدیده؟"
    },
    {
      "id": 4,
      "start": 10208.0,
      "end": 10210.0,
      "formatted_start": "02:50:08.000",
      "formatted_end": "02:50:10.000",
      "text": "پریولیت..."
    },
    {
      "id": 5,
      "start": 10210.0,
      "end": 10213.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:13.000",
      "text": "که از مرموی تا در اینجایش مومی زنه."
    },
    {
      "id": 6,
      "start": 10213.0,
      "end": 10215.0,
      "formatted_start": "02:50:13.000",
      "formatted_end": "02:50:15.000",
      "text": "هم؟ چرا؟"
    },
    {
      "id": 7,
      "start": 10215.0,
      "end": 10216.0,
      "formatted_start": "02:50:15.000",
      "formatted_end": "02:50:16.000",
      "text": "افتادارو خون موندید؟"
    },
    {
      "id": 8,
      "start": 10216.0,
      "end": 10217.0,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:17.000",
      "text": "خون می کنید؟"
    },
    {
      "id": 9,
      "start": 10217.0,
      "end": 10219.0,
      "formatted_start": "02:50:17.000",
      "formatted_end": "02:50:19.000",
      "text": "هر چی چاختر میشه با..."
    },
    {
      "id": 10,
      "start": 10219.0,
      "end": 10223.0,
      "formatted_start": "02:50:19.000",
      "formatted_end": "02:50:23.000",
      "text": "این باسن شاخت، این پریولیتی من چی؟ چارتر و صدرتر می کنید."
    },
    {
      "id": 11,
      "start": 10223.0,
      "end": 10224.0,
      "formatted_start": "02:50:23.000",
      "formatted_end": "02:50:24.000",
      "text": "درخواه چارتر."
    },
    {
      "id": 12,
      "start": 10224.0,
      "end": 10226.0,
      "formatted_start": "02:50:24.000",
      "formatted_end": "02:50:26.000",
      "text": "تحویل صبح کردی؟"
    },
    {
      "id": 13,
      "start": 10226.0,
      "end": 10228.0,
      "formatted_start": "02:50:26.000",
      "formatted_end": "02:50:28.000",
      "text": "صبح... نمی داریم."
    },
    {
      "id": 14,
      "start": 10228.0,
      "end": 10232.0,
      "formatted_start": "02:50:28.000",
      "formatted_end": "02:50:32.000",
      "text": "ببینید آزمایش هارمونی برگرنیسم برو"
    },
    {
      "id": 15,
      "start": 10232.0,
      "end": 10234.0,
      "formatted_start": "02:50:32.000",
      "formatted_end": "02:50:34.000",
      "text": "کارشون هست داریم از سانگرافی"
    },
    {
      "id": 16,
      "start": 10234.0,
      "end": 10237.0,
      "formatted_start": "02:50:34.000",
      "formatted_end": "02:50:37.000",
      "text": "آره، بعدی سانگرافی هم بری هدفاً دخترم"
    },
    {
      "id": 17,
      "start": 10237.0,
      "end": 10243.0,
      "formatted_start": "02:50:37.000",
      "formatted_end": "02:50:43.000",
      "text": "ببینیم چون مامان تنکست داره، بعدی اعتماد نصف شما توختان میکنن کار ببین"
    },
    {
      "id": 18,
      "start": 10243.0,
      "end": 10245.0,
      "formatted_start": "02:50:43.000",
      "formatted_end": "02:50:45.000",
      "text": "توختان میکنن؟"
    },
    {
      "id": 19,
      "start": 10245.0,
      "end": 10246.0,
      "formatted_start": "02:50:45.000",
      "formatted_end": "02:50:46.000",
      "text": "بعد بری به درو بدم"
    },
    {
      "id": 20,
      "start": 10246.0,
      "end": 10248.0,
      "formatted_start": "02:50:46.000",
      "formatted_end": "02:50:48.000",
      "text": "برگره کستیک من داشتم قبل ندارم"
    },
    {
      "id": 21,
      "start": 10248.0,
      "end": 10249.0,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:49.000",
      "text": "چه؟"
    },
    {
      "id": 22,
      "start": 10249.0,
      "end": 10251.0,
      "formatted_start": "02:50:49.000",
      "formatted_end": "02:50:51.000",
      "text": "کستیک، تنبه دخترم"
    },
    {
      "id": 23,
      "start": 10251.0,
      "end": 10252.0,
      "formatted_start": "02:50:51.000",
      "formatted_end": "02:50:52.000",
      "text": "آه پولیکستیک؟"
    },
    {
      "id": 24,
      "start": 10252.0,
      "end": 10254.0,
      "formatted_start": "02:50:52.000",
      "formatted_end": "02:50:54.000",
      "text": "آره پولیکستیک"
    },
    {
      "id": 25,
      "start": 10254.0,
      "end": 10260.0,
      "formatted_start": "02:50:54.000",
      "formatted_end": "02:51:00.000",
      "text": "ببین برای آزمایش که عادت میشی؟"
    },
    {
      "id": 26,
      "start": 10260.0,
      "end": 10262.0,
      "formatted_start": "02:51:00.000",
      "formatted_end": "02:51:02.000",
      "text": "من الان تا فریدی هستم"
    },
    {
      "id": 27,
      "start": 10262.0,
      "end": 10264.0,
      "formatted_start": "02:51:02.000",
      "formatted_end": "02:51:04.000",
      "text": "او پس ازم امجاد میده. روزو چند داده؟"
    },
    {
      "id": 28,
      "start": 10264.0,
      "end": 10269.0,
      "formatted_start": "02:51:04.000",
      "formatted_end": "02:51:09.000",
      "text": "چند داده بود؟ کنگورن و قدران بود. بیست و هشتون بود."
    },
    {
      "id": 29,
      "start": 10269.0,
      "end": 10271.0,
      "formatted_start": "02:51:09.000",
      "formatted_end": "02:51:11.000",
      "text": "کنگورن و قدران بود؟"
    },
    {
      "id": 30,
      "start": 10271.0,
      "end": 10273.0,
      "formatted_start": "02:51:11.000",
      "formatted_end": "02:51:13.000",
      "text": "نه بیست و هشتون بود."
    },
    {
      "id": 31,
      "start": 10273.0,
      "end": 10275.0,
      "formatted_start": "02:51:13.000",
      "formatted_end": "02:51:15.000",
      "text": "روزو چند داده بود؟"
    },
    {
      "id": 32,
      "start": 10275.0,
      "end": 10277.0,
      "formatted_start": "02:51:15.000",
      "formatted_end": "02:51:17.000",
      "text": "روزو چند داده بود؟"
    },
    {
      "id": 33,
      "start": 10277.0,
      "end": 10279.0,
      "formatted_start": "02:51:17.000",
      "formatted_end": "02:51:19.000",
      "text": "نه بیست و هشتون بود."
    },
    {
      "id": 34,
      "start": 10279.0,
      "end": 10281.0,
      "formatted_start": "02:51:19.000",
      "formatted_end": "02:51:21.000",
      "text": "کنگورن و قدران بود. روزو چند داده بود؟"
    },
    {
      "id": 35,
      "start": 10281.0,
      "end": 10283.0,
      "formatted_start": "02:51:21.000",
      "formatted_end": "02:51:23.000",
      "text": "از این نزدیک باید میاد پیر یا نشون پردار"
    },
    {
      "id": 36,
      "start": 10283.0,
      "end": 10285.0,
      "formatted_start": "02:51:23.000",
      "formatted_end": "02:51:25.000",
      "text": "آزمایش هاش رو باید ببینم خب"
    },
    {
      "id": 37,
      "start": 10285.0,
      "end": 10288.0,
      "formatted_start": "02:51:25.000",
      "formatted_end": "02:51:28.000",
      "text": "اگه سالم باشه و همه چیز خوب باشه"
    },
    {
      "id": 38,
      "start": 10288.0,
      "end": 10290.0,
      "formatted_start": "02:51:28.000",
      "formatted_end": "02:51:30.000",
      "text": "بسیاری تر بخورم"
    },
    {
      "id": 39,
      "start": 10290.0,
      "end": 10292.0,
      "formatted_start": "02:51:30.000",
      "formatted_end": "02:51:32.000",
      "text": "قربه هم نیست که خواب هم ببره"
    },
    {
      "id": 40,
      "start": 10292.0,
      "end": 10293.0,
      "formatted_start": "02:51:32.000",
      "formatted_end": "02:51:33.000",
      "text": "رو هیچ چی؟"
    },
    {
      "id": 41,
      "start": 10293.0,
      "end": 10296.0,
      "formatted_start": "02:51:33.000",
      "formatted_end": "02:51:36.000",
      "text": "خوابه فره کنن، قربه بخورم، بعد تن خواب هم بگیره"
    },
    {
      "id": 42,
      "start": 10296.0,
      "end": 10300.0,
      "formatted_start": "02:51:36.000",
      "formatted_end": "02:51:40.000",
      "text": "بعد یه سه آمپول میزنیم"
    },
    {
      "id": 43,
      "start": 10300.0,
      "end": 10302.0,
      "formatted_start": "02:51:40.000",
      "formatted_end": "02:51:42.000",
      "text": "اگه آب شرط برد برد بینم"
    },
    {
      "id": 44,
      "start": 10302.0,
      "end": 10304.0,
      "formatted_start": "02:51:42.000",
      "formatted_end": "02:51:44.000",
      "text": "از ازم مالی خودتون چیز شدید؟"
    },
    {
      "id": 45,
      "start": 10304.0,
      "end": 10306.0,
      "formatted_start": "02:51:44.000",
      "formatted_end": "02:51:46.000",
      "text": "آمپول هاش دوانیم میلیونه"
    },
    {
      "id": 46,
      "start": 10306.0,
      "end": 10313.5,
      "formatted_start": "02:51:46.000",
      "formatted_end": "02:51:53.500",
      "text": "و حتی دقیقا با قانون خودش اینه که هفته یه بار و بعد مثلا راحت دو هفته یه بار بزنیم"
    },
    {
      "id": 47,
      "start": 10313.5,
      "end": 10316.5,
      "formatted_start": "02:51:53.500",
      "formatted_end": "02:51:56.500",
      "text": "و کلاش داره دیگه قانونی تو ته یک سال"
    },
    {
      "id": 48,
      "start": 10316.5,
      "end": 10319.0,
      "formatted_start": "02:51:56.500",
      "formatted_end": "02:51:59.000",
      "text": "ته یک سال میتونه 20 کلو لاغر کنه"
    },
    {
      "id": 49,
      "start": 10319.0,
      "end": 10320.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:00.000",
      "text": "مثل 35 کلو"
    },
    {
      "id": 50,
      "start": 10320.0,
      "end": 10322.0,
      "formatted_start": "02:52:00.000",
      "formatted_end": "02:52:02.000",
      "text": "با اون هامپولو میتونه لاغر کنه"
    },
    {
      "id": 51,
      "start": 10322.0,
      "end": 10325.0,
      "formatted_start": "02:52:02.000",
      "formatted_end": "02:52:05.000",
      "text": "تو خانواده شما کسی سرطان تیرویت که نداشته"
    },
    {
      "id": 52,
      "start": 10325.0,
      "end": 10330.0,
      "formatted_start": "02:52:05.000",
      "formatted_end": "02:52:10.000",
      "text": "بعد به شرشی میدم و یک سری دارو میدم و اون هامپولو رو برای شروع می کنم تا لاغر میشیم"
    },
    {
      "id": 53,
      "start": 10330.0,
      "end": 10332.0,
      "formatted_start": "02:52:10.000",
      "formatted_end": "02:52:12.000",
      "text": "اینجا باید تا 20 کلو تنگرم"
    },
    {
      "id": 54,
      "start": 10332.0,
      "end": 10334.0,
      "formatted_start": "02:52:12.000",
      "formatted_end": "02:52:14.000",
      "text": "اگر از اینکه سرمون داره باید یه دفعه خرید"
    },
    {
      "id": 55,
      "start": 10334.0,
      "end": 10336.0,
      "formatted_start": "02:52:14.000",
      "formatted_end": "02:52:16.000",
      "text": "زمان میبره مثلا اتصال همش هست"
    },
    {
      "id": 56,
      "start": 10336.0,
      "end": 10338.0,
      "formatted_start": "02:52:16.000",
      "formatted_end": "02:52:18.000",
      "text": "سرمون داره باید یه دفعه خرید"
    },
    {
      "id": 57,
      "start": 10338.0,
      "end": 10340.0,
      "formatted_start": "02:52:18.000",
      "formatted_end": "02:52:20.000",
      "text": "یعنی حتما تا 20 کلو را اقر میشیم"
    },
    {
      "id": 58,
      "start": 10340.0,
      "end": 10342.0,
      "formatted_start": "02:52:20.000",
      "formatted_end": "02:52:22.000",
      "text": "بعد"
    },
    {
      "id": 59,
      "start": 10342.0,
      "end": 10344.0,
      "formatted_start": "02:52:22.000",
      "formatted_end": "02:52:24.000",
      "text": "نوتا"
    },
    {
      "id": 60,
      "start": 10344.0,
      "end": 10346.0,
      "formatted_start": "02:52:24.000",
      "formatted_end": "02:52:26.000",
      "text": "نمیتونیم همچنین یه دفعه"
    },
    {
      "id": 61,
      "start": 10346.0,
      "end": 10348.0,
      "formatted_start": "02:52:26.000",
      "formatted_end": "02:52:28.000",
      "text": "حتما باید مطمئن میشیم که همه تنگرمات"
    },
    {
      "id": 62,
      "start": 10348.0,
      "end": 10350.0,
      "formatted_start": "02:52:28.000",
      "formatted_end": "02:52:30.000",
      "text": "اختیار نداره"
    },
    {
      "id": 63,
      "start": 10350.0,
      "end": 10352.0,
      "formatted_start": "02:52:30.000",
      "formatted_end": "02:52:32.000",
      "text": "نکن از هم مشکلت کرمانی باشه"
    },
    {
      "id": 64,
      "start": 10352.0,
      "end": 10354.0,
      "formatted_start": "02:52:32.000",
      "formatted_end": "02:52:34.000",
      "text": "اعتمالا تشخیص من اینه که"
    },
    {
      "id": 65,
      "start": 10354.0,
      "end": 10360.46,
      "formatted_start": "02:52:34.000",
      "formatted_end": "02:52:40.460",
      "text": "اینه که به خاطر چربی زیاده دور شکمه، چربی دور دکتان زیاده، اون کمکار شده"
    },
    {
      "id": 66,
      "start": 10360.46,
      "end": 10365.82,
      "formatted_start": "02:52:40.460",
      "formatted_end": "02:52:45.820",
      "text": "و وقتی اون کمکار میشه هرمون مردانت بالا میده، هرمون مردانت بالا رفته گره"
    },
    {
      "id": 67,
      "start": 10365.82,
      "end": 10369.76,
      "formatted_start": "02:52:45.820",
      "formatted_end": "02:52:49.760",
      "text": "اینها رو برابردیم، بعد احتمالا تشکیل داریم"
    },
    {
      "id": 68,
      "start": 10373.76,
      "end": 10376.84,
      "formatted_start": "02:52:53.760",
      "formatted_end": "02:52:56.840",
      "text": "نه اینکه میتونید از ناشدار رو میبینید؟ ناشدارست؟"
    },
    {
      "id": 69,
      "start": 10376.84,
      "end": 10380.52,
      "formatted_start": "02:52:56.840",
      "formatted_end": "02:53:00.520",
      "text": "نه، نه، پرده صبح رو دارید؟ آره"
    },
    {
      "id": 70,
      "start": 10380.52,
      "end": 10382.72,
      "formatted_start": "02:53:00.520",
      "formatted_end": "02:53:02.720",
      "text": "همینکه از ناشدار؟ چون آره"
    },
    {
      "id": 71,
      "start": 10382.72,
      "end": 10385.72,
      "formatted_start": "02:53:02.720",
      "formatted_end": "02:53:05.720",
      "text": "اینجا هست فیلنس هشت و بیسنشن"
    },
    {
      "id": 72,
      "start": 10385.72,
      "end": 10388.72,
      "formatted_start": "02:53:05.720",
      "formatted_end": "02:53:08.720",
      "text": "تو خانده شما کسی بد که ندارد"
    },
    {
      "id": 73,
      "start": 10388.72,
      "end": 10390.72,
      "formatted_start": "02:53:08.720",
      "formatted_end": "02:53:10.720",
      "text": "هنه حضور بله ندارد"
    },
    {
      "id": 74,
      "start": 10392.72,
      "end": 10394.72,
      "formatted_start": "02:53:12.720",
      "formatted_end": "02:53:14.720",
      "text": "سرد انتیبرید هم کسی ندارد"
    },
    {
      "id": 75,
      "start": 10394.72,
      "end": 10398.72,
      "formatted_start": "02:53:14.720",
      "formatted_end": "02:53:18.720",
      "text": "خب یه سرو وقت برید کاریک برای آنکن باید انجام میدیم"
    },
    {
      "id": 76,
      "start": 10398.72,
      "end": 10401.72,
      "formatted_start": "02:53:18.720",
      "formatted_end": "02:53:21.720",
      "text": "چون بعضی همشور دیمی میزنند خب"
    },
    {
      "id": 77,
      "start": 10401.72,
      "end": 10406.72,
      "formatted_start": "02:53:21.720",
      "formatted_end": "02:53:26.720",
      "text": "بعد مریض دو چهار آرزه میشه و استرس این چیزها رو نکنید تنها"
    },
    {
      "id": 78,
      "start": 10408.72,
      "end": 10411.72,
      "formatted_start": "02:53:28.720",
      "formatted_end": "02:53:31.720",
      "text": "با خیال راحت کلندر رو منتشون کنید"
    },
    {
      "id": 79,
      "start": 10411.72,
      "end": 10413.72,
      "formatted_start": "02:53:31.720",
      "formatted_end": "02:53:33.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 80,
      "start": 10413.72,
      "end": 10415.72,
      "formatted_start": "02:53:33.720",
      "formatted_end": "02:53:35.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 81,
      "start": 10415.72,
      "end": 10417.72,
      "formatted_start": "02:53:35.720",
      "formatted_end": "02:53:37.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 82,
      "start": 10417.72,
      "end": 10419.72,
      "formatted_start": "02:53:37.720",
      "formatted_end": "02:53:39.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 83,
      "start": 10419.72,
      "end": 10421.72,
      "formatted_start": "02:53:39.720",
      "formatted_end": "02:53:41.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 84,
      "start": 10421.72,
      "end": 10423.72,
      "formatted_start": "02:53:41.720",
      "formatted_end": "02:53:43.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 85,
      "start": 10423.72,
      "end": 10425.72,
      "formatted_start": "02:53:43.720",
      "formatted_end": "02:53:45.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 86,
      "start": 10425.72,
      "end": 10427.72,
      "formatted_start": "02:53:45.720",
      "formatted_end": "02:53:47.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 87,
      "start": 10427.72,
      "end": 10429.72,
      "formatted_start": "02:53:47.720",
      "formatted_end": "02:53:49.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 88,
      "start": 10429.72,
      "end": 10431.72,
      "formatted_start": "02:53:49.720",
      "formatted_end": "02:53:51.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 89,
      "start": 10431.72,
      "end": 10433.72,
      "formatted_start": "02:53:51.720",
      "formatted_end": "02:53:53.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 90,
      "start": 10433.72,
      "end": 10435.72,
      "formatted_start": "02:53:53.720",
      "formatted_end": "02:53:55.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 91,
      "start": 10435.72,
      "end": 10437.72,
      "formatted_start": "02:53:55.720",
      "formatted_end": "02:53:57.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 92,
      "start": 10437.72,
      "end": 10439.72,
      "formatted_start": "02:53:57.720",
      "formatted_end": "02:53:59.720",
      "text": "از اینجا برده بود."
    },
    {
      "id": 93,
      "start": 10439.72,
      "end": 10467.72,
      "formatted_start": "02:53:59.720",
      "formatted_end": "02:54:27.720",
      "text": "موسیقی"
    },
    {
      "id": 94,
      "start": 10469.72,
      "end": 10499.72,
      "formatted_start": "02:54:29.720",
      "formatted_end": "02:54:59.720",
      "text": "از اینجا باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که ا"
    },
    {
      "id": 95,
      "start": 10499.72,
      "end": 10501.72,
      "formatted_start": "02:54:59.720",
      "formatted_end": "02:55:01.720",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}