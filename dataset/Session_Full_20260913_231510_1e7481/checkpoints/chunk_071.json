  "stt_segments": [
    {
      "id": 0,
      "start": 21300.0,
      "end": 21302.0,
      "formatted_start": "05:55:00.000",
      "formatted_end": "05:55:02.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 21330.0,
      "end": 21332.0,
      "formatted_start": "05:55:30.000",
      "formatted_end": "05:55:32.000",
      "text": "باید برم بگویم"
    },
    {
      "id": 2,
      "start": 21344.0,
      "end": 21346.0,
      "formatted_start": "05:55:44.000",
      "formatted_end": "05:55:46.000",
      "text": "ساده؟"
    },
    {
      "id": 3,
      "start": 21346.0,
      "end": 21348.0,
      "formatted_start": "05:55:46.000",
      "formatted_end": "05:55:48.000",
      "text": "هستم اینو فرمی خواهیم؟"
    },
    {
      "id": 4,
      "start": 21348.0,
      "end": 21350.0,
      "formatted_start": "05:55:48.000",
      "formatted_end": "05:55:50.000",
      "text": "نه"
    },
    {
      "id": 5,
      "start": 21350.0,
      "end": 21352.0,
      "formatted_start": "05:55:50.000",
      "formatted_end": "05:55:52.000",
      "text": "بله منیم"
    },
    {
      "id": 6,
      "start": 21382.0,
      "end": 21384.68,
      "formatted_start": "05:56:22.000",
      "formatted_end": "05:56:24.680",
      "text": "تیرویدش کم کار تر شده میشه"
    },
    {
      "id": 7,
      "start": 21384.68,
      "end": 21385.82,
      "formatted_start": "05:56:24.680",
      "formatted_end": "05:56:25.820",
      "text": "دیدهش کم کار"
    },
    {
      "id": 8,
      "start": 21385.82,
      "end": 21387.76,
      "formatted_start": "05:56:25.820",
      "formatted_end": "05:56:27.760",
      "text": "شاید برد تر شده بشه"
    },
    {
      "id": 9,
      "start": 21387.76,
      "end": 21390.32,
      "formatted_start": "05:56:27.760",
      "formatted_end": "05:56:30.320",
      "text": "چون زربان قلب و تیروید هم کم دو کاره"
    },
    {
      "id": 10,
      "start": 21390.32,
      "end": 21392.34,
      "formatted_start": "05:56:30.320",
      "formatted_end": "05:56:32.340",
      "text": "خیلی پایین"
    },
    {
      "id": 11,
      "start": 21392.34,
      "end": 21394.24,
      "formatted_start": "05:56:32.340",
      "formatted_end": "05:56:34.240",
      "text": "اگه این بمونه باید برای دختر برم"
    },
    {
      "id": 12,
      "start": 21394.24,
      "end": 21395.94,
      "formatted_start": "05:56:34.240",
      "formatted_end": "05:56:35.940",
      "text": "برای دختر برم"
    },
    {
      "id": 13,
      "start": 21395.94,
      "end": 21396.56,
      "formatted_start": "05:56:35.940",
      "formatted_end": "05:56:36.560",
      "text": "باید برم"
    },
    {
      "id": 14,
      "start": 21396.56,
      "end": 21399.7,
      "formatted_start": "05:56:36.560",
      "formatted_end": "05:56:39.700",
      "text": "باز پیش سرگیجه بگیره"
    },
    {
      "id": 15,
      "start": 21399.7,
      "end": 21400.6,
      "formatted_start": "05:56:39.700",
      "formatted_end": "05:56:40.600",
      "text": "ویهاد باشه"
    },
    {
      "id": 16,
      "start": 21400.6,
      "end": 21402.14,
      "formatted_start": "05:56:40.600",
      "formatted_end": "05:56:42.140",
      "text": "قلبش نمی کشه"
    },
    {
      "id": 17,
      "start": 21402.14,
      "end": 21403.64,
      "formatted_start": "05:56:42.140",
      "formatted_end": "05:56:43.640",
      "text": "اما پیشاتش هم پاریده با قلب"
    },
    {
      "id": 18,
      "start": 21403.64,
      "end": 21406.58,
      "formatted_start": "05:56:43.640",
      "formatted_end": "05:56:46.580",
      "text": "گفته شکلی نمی کنه"
    },
    {
      "id": 19,
      "start": 21406.58,
      "end": 21407.9,
      "formatted_start": "05:56:46.580",
      "formatted_end": "05:56:47.900",
      "text": "گفته شکلی نمی کنه"
    },
    {
      "id": 20,
      "start": 21407.9,
      "end": 21409.9,
      "formatted_start": "05:56:47.900",
      "formatted_end": "05:56:49.900",
      "text": "چند روز چقدر میخوری؟ یک دونه؟"
    },
    {
      "id": 21,
      "start": 21409.9,
      "end": 21411.9,
      "formatted_start": "05:56:49.900",
      "formatted_end": "05:56:51.900",
      "text": "یک دونه"
    },
    {
      "id": 22,
      "start": 21411.9,
      "end": 21413.9,
      "formatted_start": "05:56:51.900",
      "formatted_end": "05:56:53.900",
      "text": "اون رو برای صحیف صحیف دارش کنه"
    },
    {
      "id": 23,
      "start": 21413.9,
      "end": 21415.9,
      "formatted_start": "05:56:53.900",
      "formatted_end": "05:56:55.900",
      "text": "خلید این گذبه شبشی که کنه فیلم؟"
    },
    {
      "id": 24,
      "start": 21415.9,
      "end": 21417.9,
      "formatted_start": "05:56:55.900",
      "formatted_end": "05:56:57.900",
      "text": "الان دارم عوضشون کنم"
    },
    {
      "id": 25,
      "start": 21417.9,
      "end": 21419.9,
      "formatted_start": "05:56:57.900",
      "formatted_end": "05:56:59.900",
      "text": "گذبه شبشی شبت کنی؟"
    },
    {
      "id": 26,
      "start": 21419.9,
      "end": 21421.9,
      "formatted_start": "05:56:59.900",
      "formatted_end": "05:57:01.900",
      "text": "همونه یک زرقه یک کچونو کمتره"
    },
    {
      "id": 27,
      "start": 21421.9,
      "end": 21423.9,
      "formatted_start": "05:57:01.900",
      "formatted_end": "05:57:03.900",
      "text": "و از اینو نخوره؟"
    },
    {
      "id": 28,
      "start": 21423.9,
      "end": 21425.9,
      "formatted_start": "05:57:03.900",
      "formatted_end": "05:57:05.900",
      "text": "نه اگه توی کنه از این دارن دیگه نخورن"
    },
    {
      "id": 29,
      "start": 21425.9,
      "end": 21429.9,
      "formatted_start": "05:57:05.900",
      "formatted_end": "05:57:09.900",
      "text": "داره ضربانشونو خیلی میاره با این خطر نداره"
    },
    {
      "id": 30,
      "start": 21429.9,
      "end": 21431.9,
      "formatted_start": "05:57:09.900",
      "formatted_end": "05:57:11.900",
      "text": "اون که مریض بخوره زمین خدای نکرده"
    },
    {
      "id": 31,
      "start": 21437.9,
      "end": 21439.9,
      "formatted_start": "05:57:17.900",
      "formatted_end": "05:57:19.900",
      "text": "این که مثلا تهدید تو هممش که نه تحت شد"
    },
    {
      "id": 32,
      "start": 21439.9,
      "end": 21441.9,
      "formatted_start": "05:57:19.900",
      "formatted_end": "05:57:21.900",
      "text": "نه تحت نداره زرگونش رو اینا پایینه میخورد"
    },
    {
      "id": 33,
      "start": 21441.9,
      "end": 21443.9,
      "formatted_start": "05:57:21.900",
      "formatted_end": "05:57:23.900",
      "text": "میگه یه دقیق افتاده با دفت خورده اینجا"
    },
    {
      "id": 34,
      "start": 21443.9,
      "end": 21445.9,
      "formatted_start": "05:57:23.900",
      "formatted_end": "05:57:25.900",
      "text": "از همین میترسم"
    },
    {
      "id": 35,
      "start": 21445.9,
      "end": 21447.9,
      "formatted_start": "05:57:25.900",
      "formatted_end": "05:57:27.900",
      "text": "از همون رو؟"
    },
    {
      "id": 36,
      "start": 21447.9,
      "end": 21449.9,
      "formatted_start": "05:57:27.900",
      "formatted_end": "05:57:29.900",
      "text": "آره از همین تیکه داروشه"
    },
    {
      "id": 37,
      "start": 21449.9,
      "end": 21451.9,
      "formatted_start": "05:57:29.900",
      "formatted_end": "05:57:31.900",
      "text": "پایین مثلا اینم بهتر نشده"
    },
    {
      "id": 38,
      "start": 21451.9,
      "end": 21453.9,
      "formatted_start": "05:57:31.900",
      "formatted_end": "05:57:33.900",
      "text": "پس اینکه مادر اون قرصتشارت نخورد"
    },
    {
      "id": 39,
      "start": 21453.9,
      "end": 21455.9,
      "formatted_start": "05:57:33.900",
      "formatted_end": "05:57:35.900",
      "text": "قرصتشاری که خود خانم دکتر میگه اینو بخورد"
    },
    {
      "id": 40,
      "start": 21455.9,
      "end": 21457.9,
      "formatted_start": "05:57:35.900",
      "formatted_end": "05:57:37.900",
      "text": "این همینه"
    },
    {
      "id": 41,
      "start": 21457.9,
      "end": 21459.9,
      "formatted_start": "05:57:37.900",
      "formatted_end": "05:57:39.900",
      "text": "جدا کنی چون پشتاشون این همه"
    },
    {
      "id": 42,
      "start": 21459.9,
      "end": 21461.9,
      "formatted_start": "05:57:39.900",
      "formatted_end": "05:57:41.900",
      "text": "این کم هم حوض شده"
    },
    {
      "id": 43,
      "start": 21461.9,
      "end": 21462.9,
      "formatted_start": "05:57:41.900",
      "formatted_end": "05:57:42.900",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 21462.9,
      "end": 21463.9,
      "formatted_start": "05:57:42.900",
      "formatted_end": "05:57:43.900",
      "text": "برای میترسم اشتباه بکنه"
    },
    {
      "id": 45,
      "start": 21463.9,
      "end": 21465.9,
      "formatted_start": "05:57:43.900",
      "formatted_end": "05:57:45.900",
      "text": "آره نه حوضت همه"
    },
    {
      "id": 46,
      "start": 21465.9,
      "end": 21468.9,
      "formatted_start": "05:57:45.900",
      "formatted_end": "05:57:48.900",
      "text": "به خاطر همین چیز شده و خدای نکرد رسا پاشی نشده"
    },
    {
      "id": 47,
      "start": 21468.9,
      "end": 21469.9,
      "formatted_start": "05:57:48.900",
      "formatted_end": "05:57:49.900",
      "text": "پاش خواهیم بکنم"
    },
    {
      "id": 48,
      "start": 21469.9,
      "end": 21473.9,
      "formatted_start": "05:57:49.900",
      "formatted_end": "05:57:53.900",
      "text": "که همین حتما دفعه دیگه همه دارو رو با خود مریض بیار ببینم چقدر ضرورت شده"
    },
    {
      "id": 49,
      "start": 21473.9,
      "end": 21475.9,
      "formatted_start": "05:57:53.900",
      "formatted_end": "05:57:55.900",
      "text": "بابشه این هم شده"
    },
    {
      "id": 50,
      "start": 21475.9,
      "end": 21477.9,
      "formatted_start": "05:57:55.900",
      "formatted_end": "05:57:57.900",
      "text": "دیگه منه"
    },
    {
      "id": 51,
      "start": 21485.9,
      "end": 21487.9,
      "formatted_start": "05:58:05.900",
      "formatted_end": "05:58:07.900",
      "text": "همجور بکنم اون دارویات میگیرم"
    },
    {
      "id": 52,
      "start": 21489.9,
      "end": 21519.9,
      "formatted_start": "05:58:09.900",
      "formatted_end": "05:58:39.900",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 53,
      "start": 21519.9,
      "end": 21548.9,
      "formatted_start": "05:58:39.900",
      "formatted_end": "05:59:08.900",
      "text": "موسیقی"
    },
    {
      "id": 54,
      "start": 21549.9,
      "end": 21555.9,
      "formatted_start": "05:59:09.900",
      "formatted_end": "05:59:15.900",
      "text": "چون بزرگ شده تو اخوانیون شایه هست ولی بجه سمر"
    },
    {
      "id": 55,
      "start": 21555.9,
      "end": 21558.9,
      "formatted_start": "05:59:15.900",
      "formatted_end": "05:59:18.900",
      "text": "ولی یا پروستات همجام بکنه"
    },
    {
      "id": 56,
      "start": 21558.9,
      "end": 21562.9,
      "formatted_start": "05:59:18.900",
      "formatted_end": "05:59:22.900",
      "text": "و ساخن هم برخوز درمیان میکنه"
    },
    {
      "id": 57,
      "start": 21562.9,
      "end": 21567.9,
      "formatted_start": "05:59:22.900",
      "formatted_end": "05:59:27.900",
      "text": "ببینیم فقط چون ما معمولی خود مریض میگیم"
    },
    {
      "id": 58,
      "start": 21567.9,
      "end": 21572.9,
      "formatted_start": "05:59:27.900",
      "formatted_end": "05:59:32.900",
      "text": "این پروستاتو میخوره اگه توی روایت جنسش مشکل بخوره باید بگمون بگیر کنیم"
    },
    {
      "id": 59,
      "start": 21572.9,
      "end": 21574.9,
      "formatted_start": "05:59:32.900",
      "formatted_end": "05:59:34.900",
      "text": "شاید از کنیم"
    },
    {
      "id": 60,
      "start": 21574.9,
      "end": 21576.9,
      "formatted_start": "05:59:34.900",
      "formatted_end": "05:59:36.900",
      "text": "پدرنمالتونی تستون ها نمیشه؟"
    },
    {
      "id": 61,
      "start": 21576.9,
      "end": 21578.9,
      "formatted_start": "05:59:36.900",
      "formatted_end": "05:59:38.900",
      "text": "بله بله خب همه نمیزن باشه"
    },
    {
      "id": 62,
      "start": 21578.9,
      "end": 21580.9,
      "formatted_start": "05:59:38.900",
      "formatted_end": "05:59:40.900",
      "text": "سایت نورموسال نخواهد"
    },
    {
      "id": 63,
      "start": 21582.9,
      "end": 21584.9,
      "formatted_start": "05:59:42.900",
      "formatted_end": "05:59:44.900",
      "text": "انا تاون مستقیم همون میشم"
    },
    {
      "id": 64,
      "start": 21586.9,
      "end": 21590.9,
      "formatted_start": "05:59:46.900",
      "formatted_end": "05:59:50.900",
      "text": "سایت نورموسال بازی مختلف است به این جوژه سایتش"
    },
    {
      "id": 65,
      "start": 21592.9,
      "end": 21594.9,
      "formatted_start": "05:59:52.900",
      "formatted_end": "05:59:54.900",
      "text": "از اون تاون میکنم"
    }
  ],
  "status": "completed"
}