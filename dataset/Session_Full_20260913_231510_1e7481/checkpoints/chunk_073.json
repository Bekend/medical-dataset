      "start": 21980.0,
      "end": 22008.0,
      "formatted_start": "06:06:20.000",
      "formatted_end": "06:06:48.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 22010.0,
      "end": 22038.0,
      "formatted_start": "06:06:50.000",
      "formatted_end": "06:07:18.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 22040.0,
      "end": 22068.0,
      "formatted_start": "06:07:20.000",
      "formatted_end": "06:07:48.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 22068.0,
      "end": 22072.0,
      "formatted_start": "06:07:48.000",
      "formatted_end": "06:07:52.000",
      "text": "خب خوارش میدید که تویتون زیاد چرپ نیست"
    },
    {
      "id": 16,
      "start": 22072.0,
      "end": 22076.0,
      "formatted_start": "06:07:52.000",
      "formatted_end": "06:07:56.000",
      "text": "پولی هم خوبه ولی سنگ کالیه دارید"
    },
    {
      "id": 17,
      "start": 22076.0,
      "end": 22082.0,
      "formatted_start": "06:07:56.000",
      "formatted_end": "06:08:02.000",
      "text": "میام هم داره که میام هم که دیگه ریاست شده یا نشده"
    },
    {
      "id": 18,
      "start": 22082.0,
      "end": 22087.0,
      "formatted_start": "06:08:02.000",
      "formatted_end": "06:08:07.000",
      "text": "این تو دی تو رحم یا تیک گوشت اضافه تو رحم خطر هم نداره"
    },
    {
      "id": 19,
      "start": 22087.0,
      "end": 22089.0,
      "formatted_start": "06:08:07.000",
      "formatted_end": "06:08:09.000",
      "text": "مهم نیست"
    },
    {
      "id": 20,
      "start": 22089.0,
      "end": 22091.0,
      "formatted_start": "06:08:09.000",
      "formatted_end": "06:08:11.000",
      "text": "همون میام میشه"
    },
    {
      "id": 21,
      "start": 22091.0,
      "end": 22093.0,
      "formatted_start": "06:08:11.000",
      "formatted_end": "06:08:13.000",
      "text": "برای این پاشارت ها"
    },
    {
      "id": 22,
      "start": 22097.0,
      "end": 22099.0,
      "formatted_start": "06:08:17.000",
      "formatted_end": "06:08:19.000",
      "text": "صورت سنگ داشتی؟"
    },
    {
      "id": 23,
      "start": 22099.0,
      "end": 22101.0,
      "formatted_start": "06:08:19.000",
      "formatted_end": "06:08:21.000",
      "text": "آهان، خیلی چندی داره"
    },
    {
      "id": 24,
      "start": 22101.0,
      "end": 22103.0,
      "formatted_start": "06:08:21.000",
      "formatted_end": "06:08:23.000",
      "text": "یه با سنگ ها مستقل"
    },
    {
      "id": 25,
      "start": 22103.0,
      "end": 22105.0,
      "formatted_start": "06:08:23.000",
      "formatted_end": "06:08:25.000",
      "text": "اونجا همون بوده، سایزش فرق نکرد"
    },
    {
      "id": 26,
      "start": 22105.0,
      "end": 22107.0,
      "formatted_start": "06:08:25.000",
      "formatted_end": "06:08:27.000",
      "text": "آهان، آمین"
    },
    {
      "id": 27,
      "start": 22107.0,
      "end": 22109.0,
      "formatted_start": "06:08:27.000",
      "formatted_end": "06:08:29.000",
      "text": "عادت میشی؟ نه"
    },
