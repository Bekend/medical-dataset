  "stt_segments": [
    {
      "id": 0,
      "start": 15000.0,
      "end": 15008.0,
      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:08.000",
      "text": "سفکسی، خشکن با شرم آنپول آسانفن داخل صلوان."
    },
    {
      "id": 1,
      "start": 15008.0,
      "end": 15010.0,
      "formatted_start": "04:10:08.000",
      "formatted_end": "04:10:10.000",
      "text": "سفکسی یعنی آن تیزشو؟"
    },
    {
      "id": 2,
      "start": 15010.0,
      "end": 15012.0,
      "formatted_start": "04:10:10.000",
      "formatted_end": "04:10:12.000",
      "text": "آن چیز خورست؟"
    },
    {
      "id": 3,
      "start": 15012.0,
      "end": 15014.0,
      "formatted_start": "04:10:12.000",
      "formatted_end": "04:10:14.000",
      "text": "یا آن توی تیز برم نرمید؟"
    },
    {
      "id": 4,
      "start": 15014.0,
      "end": 15016.0,
      "formatted_start": "04:10:14.000",
      "formatted_end": "04:10:16.000",
      "text": "چرا؟ سفتوزوکسین تو سرامو تیز خورست."
    },
    {
      "id": 5,
      "start": 15016.0,
      "end": 15018.0,
      "formatted_start": "04:10:16.000",
      "formatted_end": "04:10:18.000",
      "text": "آهان خورست."
    },
    {
      "id": 6,
      "start": 15018.0,
      "end": 15020.0,
      "formatted_start": "04:10:18.000",
      "formatted_end": "04:10:20.000",
      "text": "چرا باید این تنشون؟"
    },
    {
      "id": 7,
      "start": 15020.0,
      "end": 15025.0,
      "formatted_start": "04:10:20.000",
      "formatted_end": "04:10:25.000",
      "text": "اون موز کتبتن، آبی معسل و هندوناینا زیاد بخور، استراجه میشه."
    },
    {
      "id": 8,
      "start": 15025.0,
      "end": 15027.0,
      "formatted_start": "04:10:25.000",
      "formatted_end": "04:10:27.000",
      "text": "در استراجه هم بزرگ مردم است."
    },
    {
      "id": 9,
      "start": 15027.0,
      "end": 15029.0,
      "formatted_start": "04:10:27.000",
      "formatted_end": "04:10:29.000",
      "text": "چرا برای چیز؟"
    },
    {
      "id": 10,
      "start": 15029.0,
      "end": 15031.0,
      "formatted_start": "04:10:29.000",
      "formatted_end": "04:10:31.000",
      "text": "ماما"
    },
    {
      "id": 11,
      "start": 15032.0,
      "end": 15033.0,
      "formatted_start": "04:10:32.000",
      "formatted_end": "04:10:33.000",
      "text": "کجا کار میکنی؟"
    },
    {
      "id": 12,
      "start": 15033.0,
      "end": 15035.0,
      "formatted_start": "04:10:33.000",
      "formatted_end": "04:10:35.000",
      "text": "بهتر را میام"
    },
    {
      "id": 13,
      "start": 15045.0,
      "end": 15046.0,
      "formatted_start": "04:10:45.000",
      "formatted_end": "04:10:46.000",
      "text": "دو روزه میبینی؟"
    },
    {
      "id": 14,
      "start": 15046.0,
      "end": 15047.0,
      "formatted_start": "04:10:46.000",
      "formatted_end": "04:10:47.000",
      "text": "بله"
    },
    {
      "id": 15,
      "start": 15047.0,
      "end": 15049.0,
      "formatted_start": "04:10:47.000",
      "formatted_end": "04:10:49.000",
      "text": "بعد اینجا تاریخ نزدن بیشتر"
    },
    {
      "id": 16,
      "start": 15049.0,
      "end": 15051.0,
      "formatted_start": "04:10:49.000",
      "formatted_end": "04:10:51.000",
      "text": "شاید مرد میشم فردا فردا"
    },
    {
      "id": 17,
      "start": 15051.0,
      "end": 15054.0,
      "formatted_start": "04:10:51.000",
      "formatted_end": "04:10:54.000",
      "text": "نمیتونی بردش که خوب میشه خوش کنم"
    },
    {
      "id": 18,
      "start": 15054.0,
      "end": 15056.0,
      "formatted_start": "04:10:54.000",
