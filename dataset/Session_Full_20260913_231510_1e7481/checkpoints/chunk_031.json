      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 9360.0,
      "end": 9380.0,
      "formatted_start": "02:36:00.000",
      "formatted_end": "02:36:20.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 9380.0,
      "end": 9408.0,
      "formatted_start": "02:36:20.000",
      "formatted_end": "02:36:48.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 9410.0,
      "end": 9430.0,
      "formatted_start": "02:36:50.000",
      "formatted_end": "02:37:10.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 9430.0,
      "end": 9446.0,
      "formatted_start": "02:37:10.000",
      "formatted_end": "02:37:26.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 9446.0,
      "end": 9448.0,
      "formatted_start": "02:37:26.000",
      "formatted_end": "02:37:28.000",
      "text": "جان نخواهد مردی نخواهد مردی"
    },
    {
      "id": 8,
      "start": 9448.0,
      "end": 9452.0,
      "formatted_start": "02:37:28.000",
      "formatted_end": "02:37:32.000",
      "text": "دکتور من در یک سال اون رو میمونم"
    },
    {
      "id": 9,
      "start": 9452.0,
      "end": 9456.0,
      "formatted_start": "02:37:32.000",
      "formatted_end": "02:37:36.000",
      "text": "مثلا بدنم حالت ترک ترک شده"
    },
    {
      "id": 10,
      "start": 9456.0,
      "end": 9458.0,
      "formatted_start": "02:37:36.000",
      "formatted_end": "02:37:38.000",
      "text": "دست و پهان بودم و باید بارش میدارم"
    },
    {
      "id": 11,
      "start": 9458.0,
      "end": 9462.0,
      "formatted_start": "02:37:38.000",
      "formatted_end": "02:37:42.000",
      "text": "یه حالت مثلا میرد این قسمت ها میرید"
    },
    {
      "id": 12,
      "start": 9462.0,
      "end": 9465.0,
      "formatted_start": "02:37:42.000",
      "formatted_end": "02:37:45.000",
      "text": "و باید باید بارش میدارم و ترک برم و گوش شده تازه"
    },
    {
      "id": 13,
      "start": 9465.0,
      "end": 9468.0,
      "formatted_start": "02:37:45.000",
      "formatted_end": "02:37:48.000",
      "text": "و اینها اصلا ترک ترک ترک برمیده شده"
    },
    {
      "id": 14,
      "start": 9468.0,
      "end": 9471.0,
      "formatted_start": "02:37:48.000",
      "formatted_end": "02:37:51.000",
      "text": "الان باز دوباره برگرشت که از پا مین ها"
    },
    {
      "id": 15,
      "start": 9471.0,
      "end": 9473.0,
      "formatted_start": "02:37:51.000",
      "formatted_end": "02:37:53.000",
      "text": "نشون بودم که اون مثلا"
    },
    {
      "id": 16,
      "start": 9473.0,
      "end": 9475.0,
      "formatted_start": "02:37:53.000",
      "formatted_end": "02:37:55.000",
      "text": "اکزما داری؟"
    },
    {
      "id": 17,
      "start": 9475.0,
      "end": 9481.0,
      "formatted_start": "02:37:55.000",
      "formatted_end": "02:38:01.000",
      "text": "بقیه رفتم دکتور پیسن که اقزام های دارو اینها رو برطرح نشوند"
    },
    {
      "id": 18,
      "start": 9481.0,
      "end": 9483.0,
      "formatted_start": "02:38:01.000",
      "formatted_end": "02:38:03.000",
      "text": "اقزام ها داریم"
    },
    {
      "id": 19,
      "start": 9483.0,
      "end": 9484.0,
      "formatted_start": "02:38:03.000",
      "formatted_end": "02:38:04.000",
