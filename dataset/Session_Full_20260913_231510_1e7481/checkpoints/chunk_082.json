      "id": 7,
      "start": 24614.0,
      "end": 24616.0,
      "formatted_start": "06:50:14.000",
      "formatted_end": "06:50:16.000",
      "text": "برای بیرون."
    },
    {
      "id": 8,
      "start": 24616.0,
      "end": 24618.0,
      "formatted_start": "06:50:16.000",
      "formatted_end": "06:50:18.000",
      "text": "برای بیرون."
    },
    {
      "id": 9,
      "start": 24618.0,
      "end": 24620.0,
      "formatted_start": "06:50:18.000",
      "formatted_end": "06:50:20.000",
      "text": "برای بیرون."
    },
    {
      "id": 10,
      "start": 24620.0,
      "end": 24622.0,
      "formatted_start": "06:50:20.000",
      "formatted_end": "06:50:22.000",
      "text": "برای بیرون."
    },
    {
      "id": 11,
      "start": 24622.0,
      "end": 24624.0,
      "formatted_start": "06:50:22.000",
      "formatted_end": "06:50:24.000",
      "text": "برای بیرون."
    },
    {
      "id": 12,
      "start": 24624.0,
      "end": 24626.0,
      "formatted_start": "06:50:24.000",
      "formatted_end": "06:50:26.000",
      "text": "برای بیرون."
    },
    {
      "id": 13,
      "start": 24626.0,
      "end": 24628.0,
      "formatted_start": "06:50:26.000",
      "formatted_end": "06:50:28.000",
      "text": "برای بیرون."
    },
    {
      "id": 14,
      "start": 24628.0,
      "end": 24630.0,
      "formatted_start": "06:50:28.000",
      "formatted_end": "06:50:30.000",
      "text": "خدا هم باید شما رو بیا موزن"
    },
    {
      "id": 15,
      "start": 24630.0,
      "end": 24632.0,
      "formatted_start": "06:50:30.000",
      "formatted_end": "06:50:32.000",
      "text": "خدا درمازه"
    },
    {
      "id": 16,
      "start": 24632.0,
      "end": 24634.0,
      "formatted_start": "06:50:32.000",
      "formatted_end": "06:50:34.000",
      "text": "خدا درمازه"
    },
    {
      "id": 17,
      "start": 24634.0,
      "end": 24636.0,
      "formatted_start": "06:50:34.000",
      "formatted_end": "06:50:36.000",
      "text": "دست شما درمازه"
    },
    {
      "id": 18,
      "start": 24636.0,
      "end": 24638.0,
      "formatted_start": "06:50:36.000",
      "formatted_end": "06:50:38.000",
      "text": "خشک کنم"
    },
    {
      "id": 19,
      "start": 24638.0,
      "end": 24640.0,
      "formatted_start": "06:50:38.000",
      "formatted_end": "06:50:40.000",
      "text": "دروار بیان بشون که یه نه"
    },
    {
      "id": 20,
      "start": 24640.0,
      "end": 24642.0,
      "formatted_start": "06:50:40.000",
      "formatted_end": "06:50:42.000",
      "text": "چون به دقات دارم نمیشتم"
    },
    {
      "id": 21,
      "start": 24642.0,
      "end": 24644.0,
      "formatted_start": "06:50:42.000",
      "formatted_end": "06:50:44.000",
      "text": "سرشبه ها کن بخورن منی از یوم هم که نمیشتم"
    },
    {
      "id": 22,
      "start": 24644.0,
      "end": 24646.0,
      "formatted_start": "06:50:44.000",
      "formatted_end": "06:50:46.000",
      "text": "که جوشانم"
    },
    {
      "id": 23,
      "start": 24646.0,
      "end": 24648.0,
      "formatted_start": "06:50:46.000",
      "formatted_end": "06:50:48.000",
      "text": "قردم که گفتم نصف قبل نامان قبل از شام"
    },
    {
      "id": 24,
      "start": 24648.0,
      "end": 24650.0,
      "formatted_start": "06:50:48.000",
      "formatted_end": "06:50:50.000",
      "text": "درمازه تو بیا"
    },
    {
      "id": 25,
      "start": 24650.0,
      "end": 24652.0,
      "formatted_start": "06:50:50.000",
      "formatted_end": "06:50:52.000",
      "text": "درمازه تو بیا"
    },
    {
      "id": 26,
      "start": 24652.0,
      "end": 24654.0,
      "formatted_start": "06:50:52.000",
      "formatted_end": "06:50:54.000",
      "text": "خب اونکه یادم برسه"
    },
    {
      "id": 27,
      "start": 24654.0,
      "end": 24656.0,
      "formatted_start": "06:50:54.000",
      "formatted_end": "06:50:56.000",
      "text": "صبح همه مدتشم درمازه"
    },
    {
      "id": 28,
      "start": 24656.0,
      "end": 24659.0,
      "formatted_start": "06:50:56.000",
      "formatted_end": "06:50:59.000",
      "text": "بهادوس و افترین ها"
    },
    {
      "id": 29,
      "start": 24659.0,
      "end": 24662.0,
      "formatted_start": "06:50:59.000",
      "formatted_end": "06:51:02.000",
      "text": "افترین به بچه پایی نکرد"
    },
    {
      "id": 30,
      "start": 24662.0,
      "end": 24663.0,
      "formatted_start": "06:51:02.000",
      "formatted_end": "06:51:03.000",
      "text": "چی میگم؟"
    },
    {
      "id": 31,
      "start": 24663.0,
      "end": 24667.0,
      "formatted_start": "06:51:03.000",
      "formatted_end": "06:51:07.000",
      "text": "از باترنه دوانی میخوام بیامانی بزرگ بگیرم"
    },
    {
      "id": 32,
      "start": 24667.0,
      "end": 24669.0,
      "formatted_start": "06:51:07.000",
      "formatted_end": "06:51:09.000",
      "text": "شماره کارز دکتر"
    },
    {
      "id": 33,
      "start": 24669.0,
      "end": 24671.0,
      "formatted_start": "06:51:09.000",
      "formatted_end": "06:51:11.000",
      "text": "خب، خب منوز بگم و کنیم"
    },
    {
      "id": 34,
      "start": 24671.0,
      "end": 24675.0,
      "formatted_start": "06:51:11.000",
      "formatted_end": "06:51:15.000",
      "text": "نسخه آزاده، نسخه عریف، سه نسخه بگم"
    },
    {
      "id": 35,
      "start": 24675.0,
      "end": 24676.0,
      "formatted_start": "06:51:15.000",
      "formatted_end": "06:51:16.000",
      "text": "خب منوز بگم"
    },
    {
      "id": 36,
      "start": 24676.0,
      "end": 24677.0,
      "formatted_start": "06:51:16.000",
      "formatted_end": "06:51:17.000",
      "text": "که رو دوستان؟"
    },
    {
      "id": 37,
      "start": 24677.0,
      "end": 24679.0,
      "formatted_start": "06:51:17.000",
      "formatted_end": "06:51:19.000",
      "text": "آره، میموندم خنجره"
    },
    {
      "id": 38,
      "start": 24679.0,
      "end": 24681.0,
      "formatted_start": "06:51:19.000",
      "formatted_end": "06:51:21.000",
      "text": "خنجره، شهرز بزرگ"
    },
    {
      "id": 39,
      "start": 24681.0,
      "end": 24683.0,
      "formatted_start": "06:51:21.000",
      "formatted_end": "06:51:23.000",
      "text": "خب، الان میخواستم اول چی کار کنم؟"
    },
    {
      "id": 40,
      "start": 24683.0,
      "end": 24685.0,
      "formatted_start": "06:51:23.000",
      "formatted_end": "06:51:25.000",
      "text": "شهرز بزرگ"
    },
    {
      "id": 41,
      "start": 24685.0,
      "end": 24688.0,
      "formatted_start": "06:51:25.000",
      "formatted_end": "06:51:28.000",
      "text": "این چیه؟ از 650 رو برنامه داری؟"
    },
    {
      "id": 42,
      "start": 24688.0,
      "end": 24694.0,
      "formatted_start": "06:51:28.000",
      "formatted_end": "06:51:34.000",
      "text": "خب، بره، جاستو ببینم، اول بهای دوست"
    },
    {
      "id": 43,
      "start": 24698.0,
      "end": 24702.0,
      "formatted_start": "06:51:38.000",
      "formatted_end": "06:51:42.000",
      "text": "میگم اون سرایی رو خاموش کنم من، اشکال نداره باید پا بهش بسله؟"
    },
    {
      "id": 44,
      "start": 24702.0,
      "end": 24705.0,
      "formatted_start": "06:51:42.000",
      "formatted_end": "06:51:45.000",
      "text": "باید بازو بسله نداره، دیگه فردا دازه برقه"
    },
    {
      "id": 45,
      "start": 24705.0,
      "end": 24708.0,
      "formatted_start": "06:51:45.000",
      "formatted_end": "06:51:48.000",
      "text": "نه، من دیگه تو برقه وقتی که بسله اشکال نداره من سرایی رو خاموش کنم ببینم"
    },
    {
      "id": 46,
      "start": 24708.0,
      "end": 24711.0,
      "formatted_start": "06:51:48.000",
      "formatted_end": "06:51:51.000",
      "text": "نه، فردا میامونم نه چیشه مخواب اون چیزش برخورده"
    },
    {
      "id": 47,
      "start": 24711.0,
      "end": 24713.66,
      "formatted_start": "06:51:51.000",
      "formatted_end": "06:51:53.660",
      "text": "فرسته شد بعدا چرا چون من خوند توزین ها رو بز کنم"
    },
    {
      "id": 48,
      "start": 24713.66,
      "end": 24715.66,
      "formatted_start": "06:51:53.660",
      "formatted_end": "06:51:55.660",
      "text": "از تعداد که میاد موردشون"
    },
    {
      "id": 49,
      "start": 24715.66,
      "end": 24719.74,
      "formatted_start": "06:51:55.660",
      "formatted_end": "06:51:59.740",
      "text": "بعدش اینه که منو برد اونقدر دور من خوند توزین ها رو بز کنم"
    },
    {
      "id": 50,
      "start": 24719.74,
      "end": 24723.74,
      "formatted_start": "06:51:59.740",
      "formatted_end": "06:52:03.740",
      "text": "سیمه لرنشون باید چقدر ببرم چونشون رو برسونم"
    },
    {
      "id": 51,
      "start": 24729.24,
      "end": 24732.44,
      "formatted_start": "06:52:09.240",
      "formatted_end": "06:52:12.440",
      "text": "چپان سیمه آبی رو ببینید از کجا است به کجا رسله"
    },
    {
      "id": 52,
      "start": 24732.44,
      "end": 24734.44,
      "formatted_start": "06:52:12.440",
      "formatted_end": "06:52:14.440",
      "text": "از توی شورا خانه اینجا"
    },
    {
      "id": 53,
      "start": 24734.44,
      "end": 24737.0,
      "formatted_start": "06:52:14.440",
      "formatted_end": "06:52:17.000",
      "text": "خب این سیمه رو باز بعد ببریم"
    },
    {
      "id": 54,
      "start": 24737.0,
      "end": 24739.0,
      "formatted_start": "06:52:17.000",
      "formatted_end": "06:52:19.000",
      "text": "خیلی بلنده سیمه آبی ها"
    },
    {
      "id": 55,
      "start": 24739.0,
      "end": 24741.0,
      "formatted_start": "06:52:19.000",
      "formatted_end": "06:52:21.000",
      "text": "اون نسلش که اینجایی بودن"
    },
    {
      "id": 56,
      "start": 24741.0,
      "end": 24743.0,
      "formatted_start": "06:52:21.000",
      "formatted_end": "06:52:23.000",
      "text": "باید آره برم"
    },
    {
      "id": 57,
      "start": 24743.0,
      "end": 24745.0,
      "formatted_start": "06:52:23.000",
      "formatted_end": "06:52:25.000",
      "text": "اینجایی"
    },
    {
      "id": 58,
      "start": 24745.0,
      "end": 24747.0,
      "formatted_start": "06:52:25.000",
      "formatted_end": "06:52:27.000",
      "text": "باید ببریم اونجا بسکنیم"
    },
    {
      "id": 59,
      "start": 24747.0,
      "end": 24749.0,
      "formatted_start": "06:52:27.000",
      "formatted_end": "06:52:29.000",
      "text": "پس همون برای رویه هم بکنیم"
    },
    {
      "id": 60,
      "start": 24749.0,
      "end": 24751.0,
      "formatted_start": "06:52:29.000",
      "formatted_end": "06:52:31.000",
      "text": "برای برکنن"
    },
    {
      "id": 61,
      "start": 24751.0,
      "end": 24753.0,
      "formatted_start": "06:52:31.000",
      "formatted_end": "06:52:33.000",
      "text": "آه"
    },
    {
      "id": 62,
      "start": 24753.0,
      "end": 24783.0,
      "formatted_start": "06:52:33.000",
      "formatted_end": "06:53:03.000",
      "text": "اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه ا"
    },
    {
      "id": 63,
      "start": 24783.0,
      "end": 24787.0,
      "formatted_start": "06:53:03.000",
      "formatted_end": "06:53:07.000",
      "text": "چند روز نداریم نتاریم یک ماه نداریم نموخوریم"
    },
    {
      "id": 64,
      "start": 24787.0,
      "end": 24791.0,
      "formatted_start": "06:53:07.000",
      "formatted_end": "06:53:11.000",
      "text": "پس اون رو درمونه ها پیچت گرفتن صبحانه نخورده بودم خوردم دهی چند"
    },
    {
      "id": 65,
      "start": 24791.0,
      "end": 24795.0,
      "formatted_start": "06:53:11.000",
      "formatted_end": "06:53:15.000",
      "text": "بینم درد گرفته"
    },
    {
      "id": 66,
      "start": 24795.0,
      "end": 24799.0,
      "formatted_start": "06:53:15.000",
      "formatted_end": "06:53:19.000",
      "text": "خوب آدم دخترش هم تیپش باشه"
    },
    {
      "id": 67,
      "start": 24799.0,
      "end": 24803.0,
      "formatted_start": "06:53:19.000",
      "formatted_end": "06:53:23.000",
      "text": "نه شفیه هر روز"
    },
    {
      "id": 68,
      "start": 24803.0,
      "end": 24807.0,
      "formatted_start": "06:53:23.000",
      "formatted_end": "06:53:27.000",
      "text": "همساری ما بگو بخوام شبه ایچی دیگه هم نرمش کردم نه"
    },
    {
      "id": 69,
      "start": 24807.0,
      "end": 24811.0,
      "formatted_start": "06:53:27.000",
      "formatted_end": "06:53:31.000",
      "text": "گوی از این روز عمر کشونه"
    },
    {
      "id": 70,
      "start": 24811.0,
      "end": 24815.92,
      "formatted_start": "06:53:31.000",
      "formatted_end": "06:53:35.920",
      "text": "خب آدم میدونم میشه لباس مشکیتو میدونم برای دختر خاله پیشه این باز دیگه نتوشی"
    },
    {
      "id": 71,
      "start": 24815.92,
      "end": 24818.7,
      "formatted_start": "06:53:35.920",
      "formatted_end": "06:53:38.700",
      "text": "بیرون سندار همسای ما در چشم"
    },
    {
      "id": 72,
      "start": 24818.7,
      "end": 24819.82,
      "formatted_start": "06:53:38.700",
      "formatted_end": "06:53:39.820",
      "text": "هنچی اومده شد"
    },
    {
      "id": 73,
      "start": 24819.82,
      "end": 24824.92,
      "formatted_start": "06:53:39.820",
      "formatted_end": "06:53:44.920",
      "text": "اومده خب دیگه اول ربیل اول شده دیگه تولد امام زمانه"
    },
    {
      "id": 74,
      "start": 24824.92,
      "end": 24826.78,
      "formatted_start": "06:53:44.920",
      "formatted_end": "06:53:46.780",
      "text": "نه بلاده دیگه"
    },
    {
      "id": 75,
      "start": 24826.78,
      "end": 24827.74,
      "formatted_start": "06:53:46.780",
      "formatted_end": "06:53:47.740",
      "text": "به امامت امام زمان"
    },
    {
      "id": 76,
      "start": 24827.74,
      "end": 24829.9,
      "formatted_start": "06:53:47.740",
      "formatted_end": "06:53:49.900",
      "text": "به امامت رسیدن امام زمانه"
    },
    {
      "id": 77,
      "start": 24829.9,
      "end": 24833.24,
      "formatted_start": "06:53:49.900",
      "formatted_end": "06:53:53.240",
      "text": "اون رو جمعه شادت امامت سندر کردی"
    },
    {
      "id": 78,
      "start": 24833.24,
      "end": 24836.68,
      "formatted_start": "06:53:53.240",
      "formatted_end": "06:53:56.680",
      "text": "با امامت دل آدم با اینا شاد رو باشن"
    },
    {
      "id": 79,
      "start": 24836.68,
      "end": 24837.78,
      "formatted_start": "06:53:56.680",
      "formatted_end": "06:53:57.780",
      "text": "باشن باشن"
    },
    {
      "id": 80,
      "start": 24837.78,
      "end": 24841.6,
      "formatted_start": "06:53:57.780",
      "formatted_end": "06:54:01.600",
      "text": "باید بوشیدی که اینکه تمام رو تو چون می نخواهی ببوش"
    },
    {
      "id": 81,
      "start": 24842.74,
      "end": 24844.74,
      "formatted_start": "06:54:02.740",
      "formatted_end": "06:54:04.740",
      "text": "بنابراین پیر زن گناه داره"
    },
    {
      "id": 82,
      "start": 24845.92,
      "end": 24847.92,
      "formatted_start": "06:54:05.920",
      "formatted_end": "06:54:07.920",
      "text": "همیشه آموزش پر براش مصد شیرها هست"
    },
    {
      "id": 83,
      "start": 24848.52,
      "end": 24852.84,
      "formatted_start": "06:54:08.520",
      "formatted_end": "06:54:12.840",
      "text": "مصد محلی، شیر محلی یا پازداباد میاره، خاناشو پازداباده"
    },
    {
      "id": 84,
      "start": 24853.82,
      "end": 24856.3,
      "formatted_start": "06:54:13.820",
      "formatted_end": "06:54:16.300",
      "text": "اینجا خواهد هست، اینجا مصد و شیر آمده"
    },
    {
      "id": 85,
      "start": 24857.58,
      "end": 24860.58,
      "formatted_start": "06:54:17.580",
      "formatted_end": "06:54:20.580",
      "text": "چرا پیرزتون پردازتون چه شد؟ تا هم کردن؟"
    },
    {
      "id": 86,
      "start": 24860.8,
      "end": 24864.54,
      "formatted_start": "06:54:20.800",
      "formatted_end": "06:54:24.540",
      "text": "دادگاه، ابلاغی آمده، گناه داره تایل بیز ابلاغی مانده"
    },
    {
      "id": 87,
      "start": 24864.54,
      "end": 24869.54,
      "formatted_start": "06:54:24.540",
      "formatted_end": "06:54:29.540",
      "text": "برای بیسی روز دیگه باید بریم تهران"
    },
    {
      "id": 88,
      "start": 24873.54,
      "end": 24875.54,
      "formatted_start": "06:54:33.540",
      "formatted_end": "06:54:35.540",
      "text": "اگه دو خواهد مار بنده نداری؟"
    },
    {
      "id": 89,
      "start": 24875.54,
      "end": 24877.54,
      "formatted_start": "06:54:35.540",
      "formatted_end": "06:54:37.540",
      "text": "اگه مار بنده نداری، بیمار بنده نداری"
    },
    {
      "id": 90,
      "start": 24877.54,
      "end": 24879.54,
      "formatted_start": "06:54:37.540",
      "formatted_end": "06:54:39.540",
      "text": "نداری، نداری، نداری، نداری، نداری، نداری"
    },
    {
      "id": 91,
      "start": 24880.54,
      "end": 24883.54,
      "formatted_start": "06:54:40.540",
      "formatted_end": "06:54:43.540",
      "text": "این فرمانه این برای تو بایدانی هیو مردم برای میار روش میکنه"
    },
    {
      "id": 92,
      "start": 24885.54,
      "end": 24886.54,
      "formatted_start": "06:54:45.540",
      "formatted_end": "06:54:46.540",
      "text": "سلام"
    },
    {
      "id": 93,
      "start": 24886.54,
      "end": 24888.54,
      "formatted_start": "06:54:46.540",
      "formatted_end": "06:54:48.540",
      "text": "داخلی تهرین جاسته؟"
    },
    {
      "id": 94,
      "start": 24888.54,
      "end": 24890.54,
      "formatted_start": "06:54:48.540",
      "formatted_end": "06:54:50.540",
      "text": "چه داخلی همجاست؟"
    },
    {
      "id": 95,
      "start": 24890.54,
      "end": 24893.54,
      "formatted_start": "06:54:50.540",
      "formatted_end": "06:54:53.540",
      "text": "من فرمان و من ویدیو مردم ها"
    },
    {
      "id": 96,
      "start": 24893.54,
      "end": 24895.54,
      "formatted_start": "06:54:53.540",
      "formatted_end": "06:54:55.540",
      "text": "بیش مندرد"
    },
    {
      "id": 97,
      "start": 24895.54,
      "end": 24897.54,
      "formatted_start": "06:54:55.540",
      "formatted_end": "06:54:57.540",
      "text": "بیوشم شه"
    }
  ],
  "status": "completed"
}