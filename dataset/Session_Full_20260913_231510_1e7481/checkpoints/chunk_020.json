  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6009.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:09.000",
      "text": "این رو خاطر دندانه هم میخورم، خضر نمیترن بخورم، شب و روز و میدون لغوما هم نمیترن بخورم."
    },
    {
      "id": 1,
      "start": 6009.0,
      "end": 6012.0,
      "formatted_start": "01:40:09.000",
      "formatted_end": "01:40:12.000",
      "text": "ببینیم که وقتی این رو بخورت، این چرا میخوری؟"
    },
    {
      "id": 2,
      "start": 6012.0,
      "end": 6014.0,
      "formatted_start": "01:40:12.000",
      "formatted_end": "01:40:14.000",
      "text": "این رو خواهم درد، خیلی."
    },
    {
      "id": 3,
      "start": 6014.0,
      "end": 6024.0,
      "formatted_start": "01:40:14.000",
      "formatted_end": "01:40:24.000",
      "text": "این رو با این خشکونا های قوی با این خشکونا قوی بخوری؟"
    },
    {
      "id": 4,
      "start": 6024.0,
      "end": 6027.0,
      "formatted_start": "01:40:24.000",
      "formatted_end": "01:40:27.000",
      "text": "یک سلق میخورم، یک سلق."
    },
    {
      "id": 5,
      "start": 6027.0,
      "end": 6029.0,
      "formatted_start": "01:40:27.000",
      "formatted_end": "01:40:29.000",
      "text": "مگه دندانه هم درست نشده؟"
    },
    {
      "id": 6,
      "start": 6029.0,
      "end": 6031.0,
      "formatted_start": "01:40:29.000",
      "formatted_end": "01:40:31.000",
      "text": "خطره اینو میخورم مردم"
    },
    {
      "id": 7,
      "start": 6031.0,
      "end": 6033.0,
      "formatted_start": "01:40:31.000",
      "formatted_end": "01:40:33.000",
      "text": "مگه نمیدونی دو هفته سامن کرد؟"
    },
    {
      "id": 8,
      "start": 6033.0,
      "end": 6035.0,
      "formatted_start": "01:40:33.000",
      "formatted_end": "01:40:35.000",
      "text": "دو هفته خود یک سر کشیدم"
    },
    {
      "id": 9,
      "start": 6035.0,
      "end": 6037.0,
      "formatted_start": "01:40:35.000",
      "formatted_end": "01:40:37.000",
      "text": "گذاشتم غرس میخورم ازم این هم"
    },
    {
      "id": 10,
      "start": 6037.0,
      "end": 6039.0,
      "formatted_start": "01:40:37.000",
      "formatted_end": "01:40:39.000",
      "text": "هرانو خطره پا میخورم"
    },
    {
      "id": 11,
      "start": 6039.0,
      "end": 6041.0,
      "formatted_start": "01:40:39.000",
      "formatted_end": "01:40:41.000",
      "text": "الان بطور بخورت یک سال بخوری؟"
    },
    {
      "id": 12,
      "start": 6041.0,
      "end": 6043.0,
      "formatted_start": "01:40:41.000",
      "formatted_end": "01:40:43.000",
      "text": "نه دیگه کن"
    },
    {
      "id": 13,
      "start": 6043.0,
      "end": 6045.0,
      "formatted_start": "01:40:43.000",
      "formatted_end": "01:40:45.000",
      "text": "نفن ما که بود کشیدم"
    },
    {
      "id": 14,
      "start": 6045.0,
      "end": 6047.0,
      "formatted_start": "01:40:45.000",
      "formatted_end": "01:40:47.000",
      "text": "غرس در دختر که بخور خوش باشه"
    },
    {
      "id": 15,
      "start": 6047.0,
      "end": 6049.0,
      "formatted_start": "01:40:47.000",
      "formatted_end": "01:40:49.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 6049.0,
      "end": 6051.0,
      "formatted_start": "01:40:49.000",
      "formatted_end": "01:40:51.000",
      "text": "خود پنج چند دره"
    },
    {
      "id": 17,
      "start": 6051.0,
      "end": 6053.0,
      "formatted_start": "01:40:51.000",
      "formatted_end": "01:40:53.000",
      "text": "بعد در دره رو گذاشتم"
    },
    {
      "id": 18,
      "start": 6053.0,
      "end": 6055.0,
      "formatted_start": "01:40:53.000",
      "formatted_end": "01:40:55.000",
      "text": "بعد بخور بخور بخور پس پای توری شد"
    },
    {
      "id": 19,
      "start": 6055.0,
      "end": 6057.0,
      "formatted_start": "01:40:55.000",
      "formatted_end": "01:40:57.000",
      "text": "سه سال پای توری هست"
    },
    {
      "id": 20,
      "start": 6057.0,
      "end": 6062.0,
      "formatted_start": "01:40:57.000",
      "formatted_end": "01:41:02.000",
      "text": "خونو بد وقتی نداشتم ببره و منش کردم بکرم"
    },
    {
      "id": 21,
      "start": 6062.0,
      "end": 6066.0,
      "formatted_start": "01:41:02.000",
      "formatted_end": "01:41:06.000",
      "text": "الان دو پتیک هم از کردم الان من تا در این از این هم بکرم"
    },
    {
      "id": 22,
      "start": 6066.0,
      "end": 6070.0,
      "formatted_start": "01:41:06.000",
      "formatted_end": "01:41:10.000",
      "text": "این رفت نداره همین توی این هست خب"
    },
    {
      "id": 23,
      "start": 6070.0,
      "end": 6075.0,
      "formatted_start": "01:41:10.000",
      "formatted_end": "01:41:15.000",
      "text": "این هر دوازده ساعته خب این هم که هر شیش ساعتی بکری"
    },
    {
      "id": 24,
      "start": 6075.0,
      "end": 6077.0,
      "formatted_start": "01:41:15.000",
      "formatted_end": "01:41:17.000",
      "text": "بعد اینو نخور"
    },
    {
      "id": 25,
      "start": 6077.0,
      "end": 6078.0,
      "formatted_start": "01:41:17.000",
      "formatted_end": "01:41:18.000",
      "text": "نخورم"
    },
    {
      "id": 26,
      "start": 6078.0,
      "end": 6081.0,
      "formatted_start": "01:41:18.000",
      "formatted_end": "01:41:21.000",
      "text": "و هر وقت خیلی بیتاقت شدی بخور"
    },
    {
      "id": 27,
      "start": 6081.0,
      "end": 6082.0,
      "formatted_start": "01:41:21.000",
      "formatted_end": "01:41:22.000",
      "text": "به نخورم که پا"
    },
    {
      "id": 28,
      "start": 6082.0,
      "end": 6089.0,
      "formatted_start": "01:41:22.000",
      "formatted_end": "01:41:29.000",
      "text": "اون داگون میکنه کلن و مدت یه ها خونزه میکنه برای من نمیتونیم غذا بخونیم"
    },
    {
      "id": 29,
      "start": 6089.0,
      "end": 6095.0,
      "formatted_start": "01:41:29.000",
      "formatted_end": "01:41:35.000",
      "text": "ناده نم شب یکی میکنم خطر قدم شب که به خوابم بالش خیست میشه از دانی آب"
    },
    {
      "id": 30,
      "start": 6095.0,
      "end": 6097.0,
      "formatted_start": "01:41:35.000",
      "formatted_end": "01:41:37.000",
      "text": "ناده من نم میکنم"
    },
    {
      "id": 31,
      "start": 6097.0,
      "end": 6099.0,
      "formatted_start": "01:41:37.000",
      "formatted_end": "01:41:39.000",
      "text": "چه کمتون کار میکنن؟"
    },
    {
      "id": 32,
      "start": 6099.0,
      "end": 6102.0,
      "formatted_start": "01:41:39.000",
      "formatted_end": "01:41:42.000",
      "text": "تر بدبختی نکه خوبه خوبه"
    },
    {
      "id": 33,
      "start": 6102.0,
      "end": 6104.0,
      "formatted_start": "01:41:42.000",
      "formatted_end": "01:41:44.000",
      "text": "نه بدداریم"
    },
    {
      "id": 34,
      "start": 6104.0,
      "end": 6107.0,
      "formatted_start": "01:41:44.000",
      "formatted_end": "01:41:47.000",
      "text": "اینجا هم درد کنه، خدا نمیتونم بخورم"
    },
    {
      "id": 35,
      "start": 6107.0,
      "end": 6109.0,
      "formatted_start": "01:41:47.000",
      "formatted_end": "01:41:49.000",
      "text": "خیلی"
    },
    {
      "id": 36,
      "start": 6116.0,
      "end": 6118.0,
      "formatted_start": "01:41:56.000",
      "formatted_end": "01:41:58.000",
      "text": "من دیرو ساعت دو بازر خوردم"
    },
    {
      "id": 37,
      "start": 6118.0,
      "end": 6121.0,
      "formatted_start": "01:41:58.000",
      "formatted_end": "01:42:01.000",
      "text": "خدایی، الان یک لغم درد نکردم"
    },
    {
      "id": 38,
      "start": 6121.0,
      "end": 6123.0,
      "formatted_start": "01:42:01.000",
      "formatted_end": "01:42:03.000",
      "text": "نمیتونم بخورم، این چشمتی رو ندارم"
    },
    {
      "id": 39,
      "start": 6123.0,
      "end": 6126.0,
      "formatted_start": "01:42:03.000",
      "formatted_end": "01:42:06.000",
      "text": "از این وقت صبح و شب ناشتایی بخور"
    },
    {
      "id": 40,
      "start": 6126.0,
      "end": 6127.0,
      "formatted_start": "01:42:06.000",
      "formatted_end": "01:42:07.000",
      "text": "اینو نخور شبا"
    },
    {
      "id": 41,
      "start": 6127.0,
      "end": 6128.0,
      "formatted_start": "01:42:07.000",
      "formatted_end": "01:42:08.000",
      "text": "جای؟ نخورم؟"
    },
    {
      "id": 42,
      "start": 6128.0,
      "end": 6131.0,
      "formatted_start": "01:42:08.000",
      "formatted_end": "01:42:11.000",
      "text": "نه، اینو که میزنم تا میکنم یعنی که نخوریم"
    },
    {
      "id": 43,
      "start": 6131.0,
      "end": 6132.0,
      "formatted_start": "01:42:11.000",
      "formatted_end": "01:42:12.000",
      "text": "ها"
    },
    {
      "id": 44,
      "start": 6132.0,
      "end": 6137.06,
      "formatted_start": "01:42:12.000",
      "formatted_end": "01:42:17.060",
      "text": "او هر وقت زوری روزش میده گرفتی نبخور"
    },
    {
      "id": 45,
      "start": 6137.06,
      "end": 6138.94,
      "formatted_start": "01:42:17.060",
      "formatted_end": "01:42:18.940",
      "text": "نه مچنی یکی بپرم"
    },
    {
      "id": 46,
      "start": 6138.94,
      "end": 6143.04,
      "formatted_start": "01:42:18.940",
      "formatted_end": "01:42:23.040",
      "text": "الان فعلا همین داراتو بپر تا یکم بهتر شده"
    },
    {
      "id": 47,
      "start": 6143.04,
      "end": 6147.88,
      "formatted_start": "01:42:23.040",
      "formatted_end": "01:42:27.880",
      "text": "کارپونم بینمیسم شکم یه روز در میان کار کنه خوبه"
    },
    {
      "id": 48,
      "start": 6147.88,
      "end": 6149.76,
      "formatted_start": "01:42:27.880",
      "formatted_end": "01:42:29.760",
      "text": "دیدی کار میکنه دیرتر بپر"
    },
    {
      "id": 49,
      "start": 6149.76,
      "end": 6150.46,
      "formatted_start": "01:42:29.760",
      "formatted_end": "01:42:30.460",
      "text": "دیرتر"
    },
    {
      "id": 50,
      "start": 6150.46,
      "end": 6154.44,
      "formatted_start": "01:42:30.460",
      "formatted_end": "01:42:34.440",
      "text": "الان بیایی داراتو نشون بده خانم مشخص کنه کدوم کار کنه"
    },
    {
      "id": 51,
      "start": 6154.44,
      "end": 6154.94,
      "formatted_start": "01:42:34.440",
      "formatted_end": "01:42:34.940",
      "text": "ها"
    },
    {
      "id": 52,
      "start": 6162.0,
      "end": 6164.5,
      "formatted_start": "01:42:42.000",
      "formatted_end": "01:42:44.500",
      "text": "اینجا چه ها بودم؟ چله بودم."
    },
    {
      "id": 53,
      "start": 6164.5,
      "end": 6167.5,
      "formatted_start": "01:42:44.500",
      "formatted_end": "01:42:47.500",
      "text": "معلوم است که رو خشکم بخوری؟"
    },
    {
      "id": 54,
      "start": 6167.5,
      "end": 6174.5,
      "formatted_start": "01:42:47.500",
      "formatted_end": "01:42:54.500",
      "text": "خشک شدم خب. اما این بلوچه از عبولی همانلی همیگه چرا نمیری دختر و از منش بگیر مریضی چطوری پیلانی؟"
    },
    {
      "id": 55,
      "start": 6174.5,
      "end": 6177.5,
      "formatted_start": "01:42:54.500",
      "formatted_end": "01:42:57.500",
      "text": "چرا تو لغت شدی؟ چه کار کردی که لغت شدی؟"
    },
    {
      "id": 56,
      "start": 6177.5,
      "end": 6181.0,
      "formatted_start": "01:42:57.500",
      "formatted_end": "01:43:01.000",
      "text": "خشک شدی، صدقی زخمات خوب بشه. خب معلوم است این رفتی دندون بودش."
    },
    {
      "id": 57,
      "start": 6181.0,
      "end": 6184.0,
      "formatted_start": "01:43:01.000",
      "formatted_end": "01:43:04.000",
      "text": "آره، خیلی خشک شدم، خیلی."
    },
    {
      "id": 58,
      "start": 6184.0,
      "end": 6188.54,
      "formatted_start": "01:43:04.000",
      "formatted_end": "01:43:08.540",
      "text": "همه اشنا میشنستن که من هستم"
    },
    {
      "id": 59,
      "start": 6188.54,
      "end": 6189.52,
      "formatted_start": "01:43:08.540",
      "formatted_end": "01:43:09.520",
      "text": "بچه ها"
    },
    {
      "id": 60,
      "start": 6189.52,
      "end": 6192.08,
      "formatted_start": "01:43:09.520",
      "formatted_end": "01:43:12.080",
      "text": "یکتا تاجب کردم که داری شدی"
    },
    {
      "id": 61,
      "start": 6192.08,
      "end": 6193.72,
      "formatted_start": "01:43:12.080",
      "formatted_end": "01:43:13.720",
      "text": "نه در موضوع شده که"
    },
    {
      "id": 62,
      "start": 6193.72,
      "end": 6195.74,
      "formatted_start": "01:43:13.720",
      "formatted_end": "01:43:15.740",
      "text": "بیتر شدی نه که داری شدی"
    },
    {
      "id": 63,
      "start": 6195.74,
      "end": 6201.14,
      "formatted_start": "01:43:15.740",
      "formatted_end": "01:43:21.140",
      "text": "سه تا تقمیتی خب"
    },
    {
      "id": 64,
      "start": 6201.14,
      "end": 6204.08,
      "formatted_start": "01:43:21.140",
      "formatted_end": "01:43:24.080",
      "text": "ارسان نوشتن جلوه اشتعادتو باز میکنه"
    },
    {
      "id": 65,
      "start": 6204.08,
      "end": 6205.98,
      "formatted_start": "01:43:24.080",
      "formatted_end": "01:43:25.980",
      "text": "صبح و بعد از صبحانه بخوری خب"
    },
    {
      "id": 66,
      "start": 6205.98,
      "end": 6207.86,
      "formatted_start": "01:43:25.980",
      "formatted_end": "01:43:27.860",
      "text": "نوشتن بچه ها بخوره"
    },
    {
      "id": 67,
      "start": 6207.86,
      "end": 6210.0,
      "formatted_start": "01:43:27.860",
      "formatted_end": "01:43:30.000",
      "text": "بیایی بالا خانگول شخوایی"
    },
    {
      "id": 68,
      "start": 6210.0,
      "end": 6211.54,
      "formatted_start": "01:43:30.000",
      "formatted_end": "01:43:31.540",
      "text": "برای تو مشخص کنه"
    },
    {
      "id": 69,
      "start": 6211.54,
      "end": 6211.88,
      "formatted_start": "01:43:31.540",
      "formatted_end": "01:43:31.880",
      "text": "باشه"
    },
    {
      "id": 70,
      "start": 6211.88,
      "end": 6213.88,
      "formatted_start": "01:43:31.880",
      "formatted_end": "01:43:33.880",
      "text": "اینجا بیارم ها؟"
    },
    {
      "id": 71,
      "start": 6213.88,
      "end": 6215.88,
      "formatted_start": "01:43:33.880",
      "formatted_end": "01:43:35.880",
      "text": "باشیم"
    },
    {
      "id": 72,
      "start": 6215.88,
      "end": 6217.88,
      "formatted_start": "01:43:35.880",
      "formatted_end": "01:43:37.880",
      "text": "من فاشکارتو دردم"
    },
    {
      "id": 73,
      "start": 6217.88,
      "end": 6219.88,
      "formatted_start": "01:43:37.880",
      "formatted_end": "01:43:39.880",
      "text": "از سیارتن شاشه پنج رو سه"
    },
    {
      "id": 74,
      "start": 6219.88,
      "end": 6221.88,
      "formatted_start": "01:43:39.880",
      "formatted_end": "01:43:41.880",
      "text": "شکر سنیم"
    },
    {
      "id": 75,
      "start": 6221.88,
      "end": 6223.88,
      "formatted_start": "01:43:41.880",
      "formatted_end": "01:43:43.880",
      "text": "شکر بودن فرکولی و مده به تارون"
    },
    {
      "id": 76,
      "start": 6223.88,
      "end": 6225.88,
      "formatted_start": "01:43:43.880",
      "formatted_end": "01:43:45.880",
      "text": "مشکل نداره؟"
    },
    {
      "id": 77,
      "start": 6225.88,
      "end": 6227.88,
      "formatted_start": "01:43:45.880",
      "formatted_end": "01:43:47.880",
      "text": "نه خدا روشد"
    },
    {
      "id": 78,
      "start": 6227.88,
      "end": 6229.88,
      "formatted_start": "01:43:47.880",
      "formatted_end": "01:43:49.880",
      "text": "خب بیماده از دو ماه مشکل نداره"
    },
    {
      "id": 79,
      "start": 6229.88,
      "end": 6231.88,
      "formatted_start": "01:43:49.880",
      "formatted_end": "01:43:51.880",
      "text": "خب دیدم که تا لغش شدم"
    },
    {
      "id": 80,
      "start": 6231.88,
      "end": 6233.88,
      "formatted_start": "01:43:51.880",
      "formatted_end": "01:43:53.880",
      "text": "همه از دلم می کشن"
    },
    {
      "id": 81,
      "start": 6233.88,
      "end": 6235.88,
      "formatted_start": "01:43:53.880",
      "formatted_end": "01:43:55.880",
      "text": "اگه لغش شدی برو دختر"
    },
    {
      "id": 82,
      "start": 6235.88,
      "end": 6237.88,
      "formatted_start": "01:43:55.880",
      "formatted_end": "01:43:57.880",
      "text": "از مهاشه سینگرافی"
    },
    {
      "id": 83,
      "start": 6237.88,
      "end": 6239.88,
      "formatted_start": "01:43:57.880",
      "formatted_end": "01:43:59.880",
      "text": "چیز دیدی؟ چرا تا روی لغش شدی؟"
    },
    {
      "id": 84,
      "start": 6239.88,
      "end": 6245.36,
      "formatted_start": "01:43:59.880",
      "formatted_end": "01:44:05.360",
      "text": "اگر دیدی خدای نکرده خود نشدی با همین کودت آزمایش داره"
    },
    {
      "id": 85,
      "start": 6245.36,
      "end": 6248.28,
      "formatted_start": "01:44:05.360",
      "formatted_end": "01:44:08.280",
      "text": "اینو گم نکن خب تا آخر برش وقت داری"
    },
    {
      "id": 86,
      "start": 6248.28,
      "end": 6251.28,
      "formatted_start": "01:44:08.280",
      "formatted_end": "01:44:11.280",
      "text": "دیدی بهتر نیستی برو آزمایشتو انجام بده باشه"
    },
    {
      "id": 87,
      "start": 6251.28,
      "end": 6252.88,
      "formatted_start": "01:44:11.280",
      "formatted_end": "01:44:12.880",
      "text": "نه ترم برم از محش میدیرم"
    },
    {
      "id": 88,
      "start": 6252.88,
      "end": 6255.3,
      "formatted_start": "01:44:12.880",
      "formatted_end": "01:44:15.300",
      "text": "آره همون برگه کودش همه رو نوشتم"
    },
    {
      "id": 89,
      "start": 6255.3,
      "end": 6257.98,
      "formatted_start": "01:44:15.300",
      "formatted_end": "01:44:17.980",
      "text": "این هم کود دارو ببینیم هم به توضیح دارم"
    },
    {
      "id": 90,
      "start": 6257.98,
      "end": 6260.2,
      "formatted_start": "01:44:17.980",
      "formatted_end": "01:44:20.200",
      "text": "باشه باشه دست گل درنشتون ممنونیم"
    },
    {
      "id": 91,
      "start": 6260.2,
      "end": 6261.82,
      "formatted_start": "01:44:20.200",
      "formatted_end": "01:44:21.820",
      "text": "من همه رو نوشتم براتون"
    },
    {
      "id": 92,
      "start": 6261.82,
      "end": 6263.5,
      "formatted_start": "01:44:21.820",
      "formatted_end": "01:44:23.500",
      "text": "دست گل درنشتون ممنونیم"
    },
    {
      "id": 93,
      "start": 6263.5,
      "end": 6265.5,
      "formatted_start": "01:44:23.500",
      "formatted_end": "01:44:25.500",
      "text": "خداحافظ، درخواهیم نکنم، ممنون"
    },
    {
      "id": 94,
      "start": 6266.5,
      "end": 6268.5,
      "formatted_start": "01:44:26.500",
      "formatted_end": "01:44:28.500",
      "text": "سلامتا فراموش"
    },
    {
      "id": 95,
      "start": 6268.5,
      "end": 6270.5,
      "formatted_start": "01:44:28.500",
      "formatted_end": "01:44:30.500",
      "text": "وقت شما بخیر بریز"
