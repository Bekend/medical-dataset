  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8118.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:18.000",
      "text": "اگر کشیاری تو اینها افت می کنه، خب بیا مثلا سردرب شدی، جدی گردهای درک گرفته، نفست تنگ سریع میری بیمارستان و حالا چون آدم امید هستند، بعد اونجوری بزنه."
    },
    {
      "id": 1,
      "start": 8118.0,
      "end": 8123.0,
      "formatted_start": "02:15:18.000",
      "formatted_end": "02:15:23.000",
      "text": "برو به چیز پیان برگیر، اقلی اینکار را کشی باشی، اینکار در چیز نه."
    },
    {
      "id": 2,
      "start": 8123.0,
      "end": 8130.5,
      "formatted_start": "02:15:23.000",
      "formatted_end": "02:15:30.500",
      "text": "این بیماری خود محدود خود به خود خوب میشه"
    },
    {
      "id": 3,
      "start": 8130.5,
      "end": 8132.84,
      "formatted_start": "02:15:30.500",
      "formatted_end": "02:15:32.840",
      "text": "این نگرانی اصلا نداره"
    },
    {
      "id": 4,
      "start": 8132.84,
      "end": 8134.5,
      "formatted_start": "02:15:32.840",
      "formatted_end": "02:15:34.500",
      "text": "نگرانی نباشه بچه"
    },
    {
      "id": 5,
      "start": 8134.5,
      "end": 8138.22,
      "formatted_start": "02:15:34.500",
      "formatted_end": "02:15:38.220",
      "text": "آفرین خطرش مال بچه ها بیشتر از زیر شیش سال"
    },
    {
      "id": 6,
      "start": 8138.22,
      "end": 8139.62,
      "formatted_start": "02:15:38.220",
      "formatted_end": "02:15:39.620",
      "text": "مال زن ها آمیل هست"
    },
    {
      "id": 7,
      "start": 8139.62,
      "end": 8141.68,
      "formatted_start": "02:15:39.620",
      "formatted_end": "02:15:41.680",
      "text": "محیط دیابدیدید"
    },
    {
      "id": 8,
      "start": 8141.68,
      "end": 8145.14,
      "formatted_start": "02:15:41.680",
      "formatted_end": "02:15:45.140",
      "text": "و این که خودت حالا چون ریاد رو اینها یکم استجایی پایینه"
    },
    {
      "id": 9,
      "start": 8145.14,
      "end": 8147.14,
      "formatted_start": "02:15:45.140",
      "formatted_end": "02:15:47.140",
      "text": "از این رو باید رایت کنید"
    },
    {
      "id": 10,
      "start": 8147.14,
      "end": 8149.72,
      "formatted_start": "02:15:47.140",
      "formatted_end": "02:15:49.720",
      "text": "دورش باید تیلش و بزاریاتت خوب بشه"
    },
    {
      "id": 11,
      "start": 8149.72,
      "end": 8150.72,
      "formatted_start": "02:15:49.720",
      "formatted_end": "02:15:50.720",
      "text": "اونها معرفی کنید"
    },
    {
      "id": 12,
      "start": 8150.72,
      "end": 8180.72,
      "formatted_start": "02:15:50.720",
      "formatted_end": "02:16:20.720",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 13,
      "start": 8180.72,
      "end": 8196.72,
      "formatted_start": "02:16:20.720",
      "formatted_end": "02:16:36.720",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 8210.72,
      "end": 8212.72,
      "formatted_start": "02:16:50.720",
      "formatted_end": "02:16:52.720",
      "text": "این همه افتیار برده"
    },
    {
      "id": 15,
      "start": 8220.48,
      "end": 8222.48,
      "formatted_start": "02:17:00.480",
      "formatted_end": "02:17:02.480",
      "text": "این همه هایی که باید برده باشید؟"
    },
    {
      "id": 16,
      "start": 8222.48,
      "end": 8223.28,
      "formatted_start": "02:17:02.480",
      "formatted_end": "02:17:03.280",
      "text": "نمیدونیم"
    },
    {
      "id": 17,
      "start": 8223.28,
      "end": 8223.78,
      "formatted_start": "02:17:03.280",
      "formatted_end": "02:17:03.780",
      "text": "این هایی که باید برده باشید؟"
    },
    {
      "id": 18,
      "start": 8223.78,
      "end": 8224.28,
      "formatted_start": "02:17:03.780",
