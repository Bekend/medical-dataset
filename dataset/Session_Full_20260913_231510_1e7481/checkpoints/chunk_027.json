      "start": 8246.72,
      "end": 8248.72,
      "formatted_start": "02:17:26.720",
      "formatted_end": "02:17:28.720",
      "text": "زمان این گرما بزنید"
    },
    {
      "id": 25,
      "start": 8248.72,
      "end": 8252.72,
      "formatted_start": "02:17:28.720",
      "formatted_end": "02:17:32.720",
      "text": "خب، فهمان میکنی تا زرایاتت خوب بشه"
    },
    {
      "id": 26,
      "start": 8252.72,
      "end": 8254.72,
      "formatted_start": "02:17:32.720",
      "formatted_end": "02:17:34.720",
      "text": "خب کار خاصی نمیشه"
    },
    {
      "id": 27,
      "start": 8254.72,
      "end": 8256.72,
      "formatted_start": "02:17:34.720",
      "formatted_end": "02:17:36.720",
      "text": "اگه میگو ببری واحد بیماری ها"
    },
    {
      "id": 28,
      "start": 8256.72,
      "end": 8258.72,
      "formatted_start": "02:17:36.720",
      "formatted_end": "02:17:38.720",
      "text": "واحد بیماری ها"
