      "end": 8328.72,
      "formatted_start": "02:18:46.720",
      "formatted_end": "02:18:48.720",
      "text": "خود که خوب میشه چیز خواستی نیست"
    },
    {
      "id": 38,
      "start": 8330.72,
      "end": 8332.72,
      "formatted_start": "02:18:50.720",
      "formatted_end": "02:18:52.720",
      "text": "نه واسه با سرم بود"
    },
    {
      "id": 39,
      "start": 8332.72,
      "end": 8334.72,
      "formatted_start": "02:18:52.720",
      "formatted_end": "02:18:54.720",
      "text": "بچه ها بودون میدونی پشت سال داشت"
    },
    {
      "id": 40,
      "start": 8334.72,
      "end": 8336.72,
      "formatted_start": "02:18:54.720",
      "formatted_end": "02:18:56.720",
      "text": "نه اصلا نه باید با شده باش بخواستی"
    },
    {
      "id": 41,
      "start": 8336.72,
      "end": 8338.72,
      "formatted_start": "02:18:56.720",
      "formatted_end": "02:18:58.720",
      "text": "نه اصلا نه باید با شده باش بخواستی"
    },
