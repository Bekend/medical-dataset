      "text": "از اینجا باید برداریم."
    },
    {
      "id": 5,
      "start": 9910.0,
      "end": 9912.0,
      "formatted_start": "02:45:10.000",
      "formatted_end": "02:45:12.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 6,
      "start": 9912.0,
      "end": 9914.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:14.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 7,
      "start": 9914.0,
      "end": 9916.0,
      "formatted_start": "02:45:14.000",
      "formatted_end": "02:45:16.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 8,
      "start": 9916.0,
      "end": 9918.0,
      "formatted_start": "02:45:16.000",
      "formatted_end": "02:45:18.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 9,
      "start": 9918.0,
      "end": 9920.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:20.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 10,
      "start": 9920.0,
      "end": 9922.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:22.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 11,
      "start": 9922.0,
      "end": 9924.0,
      "formatted_start": "02:45:22.000",
      "formatted_end": "02:45:24.000",
      "text": "سرنن کن داری؟"
    },
    {
      "id": 12,
      "start": 9924.0,
      "end": 9926.0,
      "formatted_start": "02:45:24.000",
      "formatted_end": "02:45:26.000",
      "text": "سرنت درد می کنه؟"
    },
    {
      "id": 13,
      "start": 9926.0,
      "end": 9928.0,
      "formatted_start": "02:45:26.000",
      "formatted_end": "02:45:28.000",
      "text": "درد می کنم"
    },
    {
      "id": 14,
      "start": 9928.0,
      "end": 9930.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:30.000",
      "text": "سینوزل کردی؟"
    },
    {
      "id": 15,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "سینوزل شدی؟"
    },
    {
      "id": 16,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "سینوزل یه ماشه رفتم در دردور"
    },
    {
      "id": 17,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "دیشن داده"
    },
    {
      "id": 18,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "با سود دیشن است"
    },
    {
      "id": 19,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "دیشن دردور"
    },
    {
      "id": 20,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "دیشن به تقریب 3 دورتو به دردور"
    },
    {
      "id": 21,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "دردور"
    },
    {
      "id": 22,
      "start": 9946.0,
      "end": 9948.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:48.000",
      "text": "سینوزل یعنی که اینجا چرک کرده؟"
    },
    {
      "id": 23,
      "start": 9948.0,
      "end": 9950.0,
      "formatted_start": "02:45:48.000",
      "formatted_end": "02:45:50.000",
      "text": "آره"
    },
    {
      "id": 24,
      "start": 9950.0,
      "end": 9953.0,
      "formatted_start": "02:45:50.000",
      "formatted_end": "02:45:53.000",
      "text": "اگر کنه رو پنجه جایی بشینی بدتر میشه"
    },
    {
      "id": 25,
      "start": 9955.0,
      "end": 9958.0,
      "formatted_start": "02:45:55.000",
      "formatted_end": "02:45:58.000",
      "text": "من کمها رو درد می کنم"
    },
    {
      "id": 26,
      "start": 9960.0,
      "end": 9962.0,
      "formatted_start": "02:46:00.000",
      "formatted_end": "02:46:02.000",
      "text": "سه ماه هم کلزه شما می کنم"
    },
    {
      "id": 27,
      "start": 9962.0,
      "end": 9963.0,
      "formatted_start": "02:46:02.000",
      "formatted_end": "02:46:03.000",
      "text": "چند سال داری؟"
    },
    {
      "id": 28,
      "start": 9963.0,
      "end": 9966.0,
      "formatted_start": "02:46:03.000",
      "formatted_end": "02:46:06.000",
      "text": "۲۲، ۱۲، ۱۲"
    },
    {
      "id": 29,
      "start": 9968.0,
      "end": 9969.0,
      "formatted_start": "02:46:08.000",
      "formatted_end": "02:46:09.000",
      "text": "خانوادو سوید؟"
    },
    {
      "id": 30,
      "start": 9969.0,
      "end": 9970.0,
      "formatted_start": "02:46:09.000",
      "formatted_end": "02:46:10.000",
      "text": "۱۲"
    },
    {
      "id": 31,
      "start": 9970.0,
      "end": 9973.0,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:13.000",
      "text": "مادهتون که یادتش خوش شده"
    },
    {
      "id": 32,
      "start": 9976.0,
      "end": 9977.0,
      "formatted_start": "02:46:16.000",
      "formatted_end": "02:46:17.000",
      "text": "چهار ماه میشه؟"
    },
    {
      "id": 33,
      "start": 9977.0,
      "end": 9979.0,
      "formatted_start": "02:46:17.000",
      "formatted_end": "02:46:19.000",
      "text": "نه، سه ماه هم بشه"
    },
    {
      "id": 34,
      "start": 9980.0,
      "end": 9982.0,
      "formatted_start": "02:46:20.000",
      "formatted_end": "02:46:22.000",
      "text": "مادر اشتشار مادر اش خوش شده؟"
    },
    {
      "id": 35,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "مادرم"
    },
    {
      "id": 36,
      "start": 9984.0,
      "end": 9986.0,
      "formatted_start": "02:46:24.000",
      "formatted_end": "02:46:26.000",
      "text": "نه مادرت خوهر دیگه"
    },
    {
      "id": 37,
      "start": 9986.0,
      "end": 9988.0,
      "formatted_start": "02:46:26.000",
      "formatted_end": "02:46:28.000",
      "text": "ما فکر کردیم مادر خودم"
    },
    {
      "id": 38,
      "start": 9988.0,
      "end": 9990.0,
      "formatted_start": "02:46:28.000",
      "formatted_end": "02:46:30.000",
      "text": "مادر و خوهر دیگه"
    },
    {
      "id": 39,
      "start": 9990.0,
      "end": 9992.0,
      "formatted_start": "02:46:30.000",
      "formatted_end": "02:46:32.000",
      "text": "نه یادم میشن تا"
    },
    {
      "id": 40,
      "start": 9992.0,
      "end": 9994.0,
      "formatted_start": "02:46:32.000",
      "formatted_end": "02:46:34.000",
      "text": "من کیستم آنویتا"
    },
    {
      "id": 41,
      "start": 9994.0,
      "end": 9996.0,
      "formatted_start": "02:46:34.000",
      "formatted_end": "02:46:36.000",
      "text": "و با کیستتو درما کردی؟"
    },
    {
      "id": 42,
      "start": 9996.0,
      "end": 9998.0,
      "formatted_start": "02:46:36.000",
      "formatted_end": "02:46:38.000",
      "text": "میدونم کیست دارم چون یه بار رفتم"
    },
    {
      "id": 43,
      "start": 9998.0,
      "end": 10000.0,
      "formatted_start": "02:46:38.000",
      "formatted_end": "02:46:40.000",
      "text": "اینجورم انیم شدن"
    },
    {
      "id": 44,
      "start": 10000.0,
      "end": 10002.0,
      "formatted_start": "02:46:40.000",
      "formatted_end": "02:46:42.000",
      "text": "چون باید رفتم اینجور گرفتیم"
    },
    {
      "id": 45,
      "start": 10002.0,
      "end": 10004.0,
      "formatted_start": "02:46:42.000",
      "formatted_end": "02:46:44.000",
      "text": "باید کیست داریم"
    },
    {
      "id": 46,
      "start": 10004.0,
      "end": 10006.0,
      "formatted_start": "02:46:44.000",
      "formatted_end": "02:46:46.000",
      "text": "که بگیش نشونده"
    },
    {
      "id": 47,
      "start": 10006.0,
      "end": 10008.0,
      "formatted_start": "02:46:46.000",
      "formatted_end": "02:46:48.000",
      "text": "خیلی مهمه چون هر دور اجونه"
    },
    {
      "id": 48,
      "start": 10008.0,
      "end": 10012.0,
      "formatted_start": "02:46:48.000",
      "formatted_end": "02:46:52.000",
      "text": "از این اجونه، از این سردانه باشیم، نمی‌خواهید بخیار کنید"
    },
    {
      "id": 49,
      "start": 10012.0,
      "end": 10020.0,
      "formatted_start": "02:46:52.000",
      "formatted_end": "02:47:00.000",
      "text": "شروط دیپیندرامین رو تو کلوت قلقره کن و بعد خورد بده، خب؟"
    },
    {
      "id": 50,
      "start": 10020.0,
      "end": 10022.0,
      "formatted_start": "02:47:00.000",
      "formatted_end": "02:47:02.000",
      "text": "دیپیندرامین دارم، آبیدیم"
    },
    {
      "id": 51,
      "start": 10022.0,
      "end": 10024.0,
      "formatted_start": "02:47:02.000",
      "formatted_end": "02:47:04.000",
      "text": "آره، آن رو قلقره کن، یکم تو کلوت نگه دارم"
    },
    {
      "id": 52,
      "start": 10024.0,
      "end": 10026.0,
      "formatted_start": "02:47:04.000",
      "formatted_end": "02:47:06.000",
      "text": "صرف آبیدش هم داری؟"
    },
    {
      "id": 53,
      "start": 10026.0,
      "end": 10028.0,
      "formatted_start": "02:47:06.000",
      "formatted_end": "02:47:08.000",
      "text": "آبیدش کم آورده"
    },
    {
      "id": 54,
      "start": 10028.0,
      "end": 10030.0,
      "formatted_start": "02:47:08.000",
      "formatted_end": "02:47:10.000",
      "text": "یک محال تهربان فورم است"
    },
    {
      "id": 55,
      "start": 10030.0,
      "end": 10032.0,
      "formatted_start": "02:47:10.000",
      "formatted_end": "02:47:12.000",
      "text": "سیرو سیرو"
    },
    {
      "id": 56,
      "start": 10032.0,
      "end": 10034.0,
      "formatted_start": "02:47:12.000",
      "formatted_end": "02:47:14.000",
      "text": "نه، روزو تایی خصم شده بودم"
    },
    {
      "id": 57,
      "start": 10034.0,
      "end": 10036.0,
      "formatted_start": "02:47:14.000",
      "formatted_end": "02:47:16.000",
      "text": "از حالا مفتادی؟"
    },
    {
      "id": 58,
      "start": 10036.0,
      "end": 10038.0,
      "formatted_start": "02:47:16.000",
      "formatted_end": "02:47:18.000",
      "text": "از اینجا همه چیزی برداشت"
    },
    {
      "id": 59,
      "start": 10038.0,
      "end": 10040.0,
      "formatted_start": "02:47:18.000",
      "formatted_end": "02:47:20.000",
      "text": "همه چیزی برداشت"
    },
    {
      "id": 60,
      "start": 10040.0,
      "end": 10042.0,
      "formatted_start": "02:47:20.000",
      "formatted_end": "02:47:22.000",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 10042.0,
      "end": 10044.0,
      "formatted_start": "02:47:22.000",
      "formatted_end": "02:47:24.000",
      "text": "درگی طریق"
    },
    {
      "id": 62,
      "start": 10044.0,
      "end": 10046.0,
      "formatted_start": "02:47:24.000",
      "formatted_end": "02:47:26.000",
      "text": "چون من میشم همه اینجا نبغیر نکنم"
    },
    {
      "id": 63,
      "start": 10046.0,
      "end": 10048.0,
      "formatted_start": "02:47:26.000",
      "formatted_end": "02:47:28.000",
      "text": "بس میگم یه تصور بدم"
    },
    {
      "id": 64,
      "start": 10048.0,
      "end": 10050.0,
      "formatted_start": "02:47:28.000",
      "formatted_end": "02:47:30.000",
      "text": "من توی سنگیر شدم"
    },
    {
      "id": 65,
      "start": 10050.0,
      "end": 10052.0,
      "formatted_start": "02:47:30.000",
      "formatted_end": "02:47:32.000",
      "text": "چون همچین عزیز هستم"
    },
    {
      "id": 66,
      "start": 10052.0,
      "end": 10054.0,
      "formatted_start": "02:47:32.000",
      "formatted_end": "02:47:34.000",
      "text": "من در پنج سال هم هم میشم"
    },
    {
      "id": 67,
      "start": 10054.0,
      "end": 10056.0,
      "formatted_start": "02:47:34.000",
      "formatted_end": "02:47:36.000",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 10056.0,
      "end": 10058.0,
      "formatted_start": "02:47:36.000",
      "formatted_end": "02:47:38.000",
      "text": "نه"
    },
    {
      "id": 69,
      "start": 10058.0,
      "end": 10060.0,
      "formatted_start": "02:47:38.000",
      "formatted_end": "02:47:40.000",
      "text": "بخوای شروع حامل ها نیست"
    },
    {
      "id": 70,
      "start": 10060.0,
      "end": 10062.0,
      "formatted_start": "02:47:40.000",
      "formatted_end": "02:47:42.000",
      "text": "بله خب بعد تصور بیدیم"
    },
    {
      "id": 71,
      "start": 10062.0,
      "end": 10064.0,
      "formatted_start": "02:47:42.000",
      "formatted_end": "02:47:44.000",
      "text": "قند که نداشتی حتی زن"
    },
    {
      "id": 72,
      "start": 10064.0,
      "end": 10066.0,
      "formatted_start": "02:47:44.000",
      "formatted_end": "02:47:46.000",
      "text": "من نه"
    },
    {
      "id": 73,
      "start": 10066.0,
      "end": 10070.0,
      "formatted_start": "02:47:46.000",
      "formatted_end": "02:47:50.000",
      "text": "از آزمایش در مشتمه هایی دادم که چیکار کامل دادم مشکل دادم"
    },
    {
      "id": 74,
      "start": 10072.0,
      "end": 10075.0,
      "formatted_start": "02:47:52.000",
      "formatted_end": "02:47:55.000",
      "text": "خب، تستت هم برو پایین بده"
    },
    {
      "id": 75,
      "start": 10075.0,
      "end": 10081.0,
      "formatted_start": "02:47:55.000",
      "formatted_end": "02:48:01.000",
      "text": "بعد تستت که منفی بود یه آنکول رو میزنی وازمیشه"
    },
    {
      "id": 76,
      "start": 10081.0,
      "end": 10084.0,
      "formatted_start": "02:48:01.000",
      "formatted_end": "02:48:04.000",
      "text": "و سونوگرافیت رو خطبان باید تکرار کنیم"
    },
    {
      "id": 77,
      "start": 10084.0,
      "end": 10086.0,
      "formatted_start": "02:48:04.000",
      "formatted_end": "02:48:06.000",
      "text": "بسیار همینطور"
    },
    {
      "id": 78,
      "start": 10087.0,
      "end": 10091.0,
      "formatted_start": "02:48:07.000",
      "formatted_end": "02:48:11.000",
      "text": "چون که اگر کیس باشه باید یه آزمایش محسوس انجام بدی"
    },
    {
      "id": 79,
      "start": 10091.0,
      "end": 10094.0,
      "formatted_start": "02:48:11.000",
      "formatted_end": "02:48:14.000",
      "text": "و بعد دوسته ایلی دو دوره خوشتن بخوری"
    },
    {
      "id": 80,
      "start": 10094.0,
      "end": 10097.1,
      "formatted_start": "02:48:14.000",
      "formatted_end": "02:48:17.100",
      "text": "کسی باید خوب بشه دیگه کسی چیز اضافه است"
    },
    {
      "id": 81,
      "start": 10097.1,
      "end": 10100.0,
      "formatted_start": "02:48:17.100",
      "formatted_end": "02:48:20.000",
      "text": "باشه؟"
    },
    {
      "id": 82,
      "start": 10101.74,
      "end": 10104.08,
      "formatted_start": "02:48:21.740",
      "formatted_end": "02:48:24.080",
      "text": "از اول تست بده تست منفی بود"
    },
    {
      "id": 83,
      "start": 10104.08,
      "end": 10104.8,
      "formatted_start": "02:48:24.080",
      "formatted_end": "02:48:24.800",
      "text": "امپولو بزن"
    },
    {
      "id": 84,
      "start": 10104.8,
      "end": 10111.0,
      "formatted_start": "02:48:24.800",
      "formatted_end": "02:48:31.000",
      "text": "از این امپولای پوروشسترانو فعلا نزن"
    },
    {
      "id": 85,
      "start": 10111.0,
      "end": 10113.8,
      "formatted_start": "02:48:31.000",
      "formatted_end": "02:48:33.800",
      "text": "ولی تستو بده که مطمئنشی منفیه"
    },
    {
      "id": 86,
      "start": 10113.8,
      "end": 10116.66,
      "formatted_start": "02:48:33.800",
      "formatted_end": "02:48:36.660",
      "text": "بعد که سمخوردگیت خوب شد امپولا رو بزن"
    },
    {
      "id": 87,
      "start": 10116.66,
      "end": 10117.82,
      "formatted_start": "02:48:36.660",
      "formatted_end": "02:48:37.820",
