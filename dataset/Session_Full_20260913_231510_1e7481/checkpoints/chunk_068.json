      "id": 0,
      "start": 20400.0,
      "end": 20404.0,
      "formatted_start": "05:40:00.000",
      "formatted_end": "05:40:04.000",
      "text": "از این شکل هم درد می کنه، ادرار هم با زوره."
    },
    {
      "id": 1,
      "start": 20404.0,
      "end": 20409.0,
      "formatted_start": "05:40:04.000",
      "formatted_end": "05:40:09.000",
      "text": "یه پرسی برای حاجی نوشتم، همانان بیاره خامشبایی میدونی مال از زوره ادراره."
    },
    {
      "id": 2,
      "start": 20409.0,
      "end": 20413.0,
      "formatted_start": "05:40:09.000",
      "formatted_end": "05:40:13.000",
      "text": "از اون شما هم میتونیم ببینیم، اگه باید باید اون سرخ ساله بر شما هم نداریم."
    },
    {
      "id": 3,
      "start": 20413.0,
      "end": 20414.0,
      "formatted_start": "05:40:13.000",
      "formatted_end": "05:40:14.000",
      "text": "دست نداریم."
    },
    {
      "id": 4,
      "start": 20414.0,
      "end": 20421.0,
      "formatted_start": "05:40:14.000",
      "formatted_end": "05:40:21.000",
      "text": "بعد خوشکن هم برای حاجی نوشتم، حاجی از اونانی تعمال داری؟ آمپل بزنیم؟ خوشکن تعمال داری؟"
    },
    {
      "id": 5,
      "start": 20421.0,
      "end": 20423.0,
      "formatted_start": "05:40:21.000",
      "formatted_end": "05:40:23.000",
      "text": "اینو خوشکن برایت بزنیم."
    },
    {
      "id": 6,
      "start": 20423.0,
      "end": 20425.0,
      "formatted_start": "05:40:23.000",
      "formatted_end": "05:40:25.000",
      "text": "برس داده ایشه"
    },
    {
      "id": 7,
      "start": 20430.0,
      "end": 20433.0,
      "formatted_start": "05:40:30.000",
      "formatted_end": "05:40:33.000",
      "text": "برسون البته با سرون بزنم بیتر نیسته"
    },
    {
      "id": 8,
      "start": 20433.0,
      "end": 20438.0,
      "formatted_start": "05:40:33.000",
      "formatted_end": "05:40:38.000",
      "text": "ریه شما پولن همشو توش یکم آب داره برای من سرنوشن کار نداره"
    },
    {
      "id": 9,
      "start": 20438.0,
      "end": 20441.0,
      "formatted_start": "05:40:38.000",
      "formatted_end": "05:40:41.000",
      "text": "من اینکه بگی سرونو خالی کنم تو سرسی سرنوشن بزنم"
    },
    {
      "id": 10,
      "start": 20441.0,
      "end": 20443.0,
      "formatted_start": "05:40:41.000",
      "formatted_end": "05:40:43.000",
      "text": "نصفه میزاره"
    },
    {
      "id": 11,
      "start": 20443.0,
      "end": 20446.0,
      "formatted_start": "05:40:43.000",
      "formatted_end": "05:40:46.000",
      "text": "چون سرم خودش پرستاره"
    },
    {
      "id": 12,
      "start": 20448.0,
      "end": 20450.0,
      "formatted_start": "05:40:48.000",
      "formatted_end": "05:40:50.000",
      "text": "نصفه میزاره بعد میزاره"
    },
    {
      "id": 13,
      "start": 20450.0,
      "end": 20454.0,
      "formatted_start": "05:40:50.000",
      "formatted_end": "05:40:54.000",
      "text": "بر چیز دیگه که لازم نداشته"
    },
    {
      "id": 14,
      "start": 20454.0,
      "end": 20455.0,
      "formatted_start": "05:40:54.000",
      "formatted_end": "05:40:55.000",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 20455.0,
      "end": 20458.0,
      "formatted_start": "05:40:55.000",
      "formatted_end": "05:40:58.000",
      "text": "نمی رنجیشه برم برموسیم دفتر چهار"
    },
    {
      "id": 16,
      "start": 20463.0,
      "end": 20464.0,
      "formatted_start": "05:41:03.000",
      "formatted_end": "05:41:04.000",
      "text": "خیلی برشم هم"
    },
    {
      "id": 17,
      "start": 20465.0,
      "end": 20467.0,
      "formatted_start": "05:41:05.000",
      "formatted_end": "05:41:07.000",
      "text": "دسته درمان شد"
    },
    {
      "id": 18,
      "start": 20470.0,
      "end": 20476.0,
      "formatted_start": "05:41:10.000",
      "formatted_end": "05:41:16.000",
      "text": "بس اگه دیده نخواست دوزش هاجی بهتر نشد حتما بگنشون دکتر مردم خدا باشی"
    },
    {
      "id": 19,
      "start": 20480.0,
      "end": 20509.0,
      "formatted_start": "05:41:20.000",
      "formatted_end": "05:41:49.000",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 20510.0,
      "end": 20512.0,
      "formatted_start": "05:41:50.000",
      "formatted_end": "05:41:52.000",
      "text": "برای اینجا باید برداریم."
    },
    {
      "id": 21,
      "start": 20512.0,
      "end": 20514.0,
      "formatted_start": "05:41:52.000",
      "formatted_end": "05:41:54.000",
      "text": "باید بردارید که اینجا باید بردارید."
    },
    {
      "id": 22,
      "start": 20514.0,
      "end": 20516.0,
      "formatted_start": "05:41:54.000",
      "formatted_end": "05:41:56.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 23,
      "start": 20516.0,
      "end": 20518.0,
      "formatted_start": "05:41:56.000",
      "formatted_end": "05:41:58.000",
      "text": "چی هایی؟"
    },
    {
      "id": 24,
      "start": 20518.0,
      "end": 20520.0,
      "formatted_start": "05:41:58.000",
      "formatted_end": "05:42:00.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 25,
      "start": 20520.0,
      "end": 20522.0,
      "formatted_start": "05:42:00.000",
      "formatted_end": "05:42:02.000",
      "text": "چی هایی؟"
    },
    {
      "id": 26,
      "start": 20522.0,
      "end": 20524.0,
      "formatted_start": "05:42:02.000",
      "formatted_end": "05:42:04.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 27,
      "start": 20524.0,
      "end": 20526.0,
      "formatted_start": "05:42:04.000",
      "formatted_end": "05:42:06.000",
      "text": "چی هایی؟"
    },
    {
      "id": 28,
      "start": 20526.0,
      "end": 20528.0,
      "formatted_start": "05:42:06.000",
      "formatted_end": "05:42:08.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 29,
      "start": 20528.0,
      "end": 20530.0,
      "formatted_start": "05:42:08.000",
      "formatted_end": "05:42:10.000",
      "text": "اصلا هر چهار ساعت باید غل بخوریم."
    },
    {
      "id": 30,
      "start": 20530.0,
      "end": 20532.0,
      "formatted_start": "05:42:10.000",
      "formatted_end": "05:42:12.000",
      "text": "اصلا هر چهار ساعت باید غل بخوریم."
    },
    {
      "id": 31,
      "start": 20532.0,
      "end": 20534.0,
      "formatted_start": "05:42:12.000",
      "formatted_end": "05:42:14.000",
      "text": "اصلا هر چهار ساعت باید غل بخوریم."
    },
    {
      "id": 32,
      "start": 20534.0,
      "end": 20536.0,
      "formatted_start": "05:42:14.000",
      "formatted_end": "05:42:16.000",
      "text": "اصلا هر چهار ساعت باید غل بخوریم."
    },
    {
      "id": 33,
      "start": 20536.0,
      "end": 20538.0,
      "formatted_start": "05:42:16.000",
      "formatted_end": "05:42:18.000",
      "text": "از بیوشی که هاجر؟"
    },
    {
      "id": 34,
      "start": 20538.0,
      "end": 20548.0,
      "formatted_start": "05:42:18.000",
      "formatted_end": "05:42:28.000",
      "text": "چند بشه بهتر نمیدونم. بیرون برده بودم با صدقه دو دفعه بردن و دیمارستان. برگشم نگاه کردم."
    },
    {
      "id": 35,
      "start": 20548.0,
      "end": 20558.0,
      "formatted_start": "05:42:28.000",
      "formatted_end": "05:42:38.000",
      "text": "الان شب با دو دفعه صدقه بلند شدم. یک چیزی بخورم. برنامه پشارم میگفتم."
    },
    {
      "id": 36,
      "start": 20558.0,
      "end": 20562.0,
      "formatted_start": "05:42:38.000",
      "formatted_end": "05:42:42.000",
      "text": "پشارتون نقند؟ نه، قند."
    },
    {
      "id": 37,
      "start": 20562.0,
      "end": 20566.0,
      "formatted_start": "05:42:42.000",
      "formatted_end": "05:42:46.000",
      "text": "کراتین کلیهتون رفته بالا دارین افتاقنده دارید"
    },
    {
      "id": 38,
      "start": 20566.0,
      "end": 20570.0,
      "formatted_start": "05:42:46.000",
      "formatted_end": "05:42:50.000",
      "text": "چیزی انسولین نه نه کسی بگه نمی کنه"
    },
    {
      "id": 39,
      "start": 20570.0,
      "end": 20572.0,
      "formatted_start": "05:42:50.000",
      "formatted_end": "05:42:52.000",
      "text": "هیچ داروی غندی نه"
    },
    {
      "id": 40,
      "start": 20572.0,
      "end": 20573.0,
      "formatted_start": "05:42:52.000",
      "formatted_end": "05:42:53.000",
      "text": "بدین داراتو"
    },
    {
      "id": 41,
      "start": 20573.0,
      "end": 20575.0,
      "formatted_start": "05:42:53.000",
      "formatted_end": "05:42:55.000",
      "text": "داروی من دادی غنده گفتی نخوادید"
    },
    {
      "id": 42,
      "start": 20575.0,
      "end": 20577.0,
      "formatted_start": "05:42:55.000",
      "formatted_end": "05:42:57.000",
      "text": "میترسه همه اشتباهی بکنید"
    },
    {
      "id": 43,
      "start": 20577.0,
      "end": 20578.0,
      "formatted_start": "05:42:57.000",
      "formatted_end": "05:42:58.000",
      "text": "نه نه"
    },
    {
      "id": 44,
      "start": 20578.0,
      "end": 20579.0,
      "formatted_start": "05:42:58.000",
      "formatted_end": "05:42:59.000",
      "text": "مطمئن نیست؟"
    },
    {
      "id": 45,
      "start": 20579.0,
      "end": 20580.0,
      "formatted_start": "05:42:59.000",
      "formatted_end": "05:43:00.000",
      "text": "مطمئن نمی کنید"
    },
    {
      "id": 46,
      "start": 20580.0,
      "end": 20582.0,
      "formatted_start": "05:43:00.000",
      "formatted_end": "05:43:02.000",
      "text": "اون درگشت نوشته"
    },
    {
      "id": 47,
      "start": 20582.0,
      "end": 20583.0,
      "formatted_start": "05:43:02.000",
      "formatted_end": "05:43:03.000",
      "text": "این خب غص غنده دیگه"
    },
    {
      "id": 48,
      "start": 20583.0,
      "end": 20585.0,
      "formatted_start": "05:43:03.000",
      "formatted_end": "05:43:05.000",
      "text": "اون غص غنده نمیخوانید"
    },
    {
      "id": 49,
      "start": 20585.0,
      "end": 20586.0,
      "formatted_start": "05:43:05.000",
      "formatted_end": "05:43:06.000",
      "text": "مطمئن نیست"
    },
    {
      "id": 50,
      "start": 20586.0,
      "end": 20588.0,
      "formatted_start": "05:43:06.000",
      "formatted_end": "05:43:08.000",
      "text": "ارسالی میرام نمیزنی؟"
    },
    {
      "id": 51,
      "start": 20588.0,
      "end": 20592.0,
      "formatted_start": "05:43:08.000",
      "formatted_end": "05:43:12.000",
      "text": "نه، در یک ممدادی این را بگیریم، این را منو نمیدونم"
    },
    {
      "id": 52,
      "start": 20592.0,
      "end": 20596.0,
      "formatted_start": "05:43:12.000",
      "formatted_end": "05:43:16.000",
      "text": "آمدن میشم بدم با کنن، نا کنن، چه کار کنن"
    },
    {
      "id": 53,
      "start": 20596.0,
      "end": 20603.0,
      "formatted_start": "05:43:16.000",
      "formatted_end": "05:43:23.000",
      "text": "خوب، حاجی، تو این ها افتخانت برای یه بار بود، اون هم شدید نبود دیگه"
    },
    {
      "id": 54,
      "start": 20603.0,
      "end": 20607.0,
      "formatted_start": "05:43:23.000",
      "formatted_end": "05:43:27.000",
      "text": "آره اون روزی اولش خوب بود، الان دو روز خراب شد"
    },
    {
      "id": 55,
      "start": 20607.0,
      "end": 20609.0,
      "formatted_start": "05:43:27.000",
      "formatted_end": "05:43:29.000",
      "text": "چند میشه قلبتون؟"
    },
    {
      "id": 56,
      "start": 20609.0,
      "end": 20611.0,
      "formatted_start": "05:43:29.000",
      "formatted_end": "05:43:31.000",
      "text": "هشتاد، نوید، صد و دست"
    },
    {
      "id": 57,
      "start": 20611.0,
      "end": 20617.0,
      "formatted_start": "05:43:31.000",
      "formatted_end": "05:43:37.000",
      "text": "افتقان میشه زیر هشتاد، هفتاد، ششت"
    },
    {
      "id": 58,
      "start": 20617.0,
      "end": 20620.0,
      "formatted_start": "05:43:37.000",
      "formatted_end": "05:43:40.000",
      "text": "چه هیلی پس میخوش شده؟"
    },
    {
      "id": 59,
      "start": 20620.0,
      "end": 20624.0,
      "formatted_start": "05:43:40.000",
      "formatted_end": "05:43:44.000",
      "text": "الان هم اگه میخوش میشه، الان هم اگه میخوش نمیشه"
    },
    {
      "id": 60,
      "start": 20624.0,
      "end": 20627.0,
      "formatted_start": "05:43:44.000",
      "formatted_end": "05:43:47.000",
      "text": "نه، میخوش نمیشه، من اینجا بدن شده میشه و عرب"
    },
    {
      "id": 61,
      "start": 20627.0,
      "end": 20635.0,
      "formatted_start": "05:43:47.000",
      "formatted_end": "05:43:55.000",
      "text": "ترسیدی، زفتتون ناکم شده بخاطر کالیتون، زفت دار بدنتون"
    },
    {
      "id": 62,
      "start": 20635.0,
      "end": 20638.0,
      "formatted_start": "05:43:55.000",
      "formatted_end": "05:43:58.000",
      "text": "ولی دیگه افتقان نداری"
    },
    {
      "id": 63,
      "start": 20638.0,
      "end": 20668.0,
      "formatted_start": "05:43:58.000",
      "formatted_end": "05:44:28.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که ا"
    },
    {
      "id": 64,
      "start": 20668.0,
      "end": 20670.0,
      "formatted_start": "05:44:28.000",
      "formatted_end": "05:44:30.000",
      "text": "آقایی که تو میتیه"
    },
    {
      "id": 65,
      "start": 20674.0,
      "end": 20676.0,
      "formatted_start": "05:44:34.000",
      "formatted_end": "05:44:36.000",
      "text": "تو اینو نیست بابا"
    },
    {
      "id": 66,
      "start": 20676.0,
      "end": 20678.0,
      "formatted_start": "05:44:36.000",
      "formatted_end": "05:44:38.000",
      "text": "باسه که خونم داری؟ نه"
    },
    {
      "id": 67,
      "start": 20678.0,
      "end": 20680.0,
      "formatted_start": "05:44:38.000",
      "formatted_end": "05:44:40.000",
      "text": "نه، نمیخوری اینجا"
    },
    {
      "id": 68,
      "start": 20684.0,
      "end": 20686.0,
      "formatted_start": "05:44:44.000",
      "formatted_end": "05:44:46.000",
      "text": "اینو بردارم؟"
    },
    {
      "id": 69,
      "start": 20686.0,
      "end": 20688.0,
      "formatted_start": "05:44:46.000",
      "formatted_end": "05:44:48.000",
      "text": "اینو بردارم؟ بله چی نیست؟"
    },
    {
      "id": 70,
      "start": 20688.0,
      "end": 20690.0,
      "formatted_start": "05:44:48.000",
      "formatted_end": "05:44:50.000",
      "text": "نخوریدش یه بخشت"
    },
    {
      "id": 71,
      "start": 20690.0,
      "end": 20692.0,
      "formatted_start": "05:44:50.000",
      "formatted_end": "05:44:52.000",
      "text": "نه، نمیخوریم"
    },
    {
      "id": 72,
      "start": 20692.0,
      "end": 20694.0,
      "formatted_start": "05:44:52.000",
      "formatted_end": "05:44:54.000",
      "text": "با اینو جمع کن، اینو دور کن"
    },
    {
      "id": 73,
      "start": 20694.0,
      "end": 20696.0,
      "formatted_start": "05:44:54.000",
      "formatted_end": "05:44:56.000",
      "text": "اینو سبا میزنم، آه بردم که شما نگاه خونیم"
    },
    {
      "id": 74,
      "start": 20696.0,
      "end": 20698.0,
      "formatted_start": "05:44:56.000",
      "formatted_end": "05:44:58.000",
      "text": "باش"
    },
    {
      "id": 75,
      "start": 20698.0,
      "end": 20700.0,
      "formatted_start": "05:44:58.000",
      "formatted_end": "05:45:00.000",
      "text": "اینو بسایی نیستی"
    }
  ],
  "status": "completed"
}