      "text": "اینجور عمل کرده"
    },
    {
      "id": 92,
      "start": 7991.0,
      "end": 7993.0,
      "formatted_start": "02:13:11.000",
      "formatted_end": "02:13:13.000",
      "text": "اینجور عمل کرده"
    },
    {
      "id": 93,
      "start": 7993.0,
      "end": 7995.0,
      "formatted_start": "02:13:13.000",
      "formatted_end": "02:13:15.000",
      "text": "چون ببین مخبالک"
    },
    {
      "id": 94,
      "start": 7995.0,
      "end": 7997.0,
      "formatted_start": "02:13:15.000",
      "formatted_end": "02:13:17.000",
      "text": "مخبالک خود سرخک"
    },
    {
      "id": 95,
      "start": 7997.0,
      "end": 7999.0,
      "formatted_start": "02:13:17.000",
      "formatted_end": "02:13:19.000",
      "text": "سرخک عوارض هست"
    },
    {
      "id": 96,
      "start": 7999.0,
      "end": 8001.0,
      "formatted_start": "02:13:19.000",
      "formatted_end": "02:13:21.000",
      "text": "در گیری و بیزه و بیناه هست"
    },
    {
      "id": 97,
      "start": 8001.0,
      "end": 8003.0,
      "formatted_start": "02:13:21.000",
      "formatted_end": "02:13:23.000",
      "text": "باید تو بچه ها این حال بیشتر عوارض برم"
    },
    {
      "id": 98,
      "start": 8003.0,
      "end": 8005.0,
      "formatted_start": "02:13:23.000",
      "formatted_end": "02:13:25.000",
      "text": "بچه کچکی نبوده"
    },
    {
      "id": 99,
      "start": 8005.0,
      "end": 8007.0,
      "formatted_start": "02:13:25.000",
      "formatted_end": "02:13:27.000",
      "text": "تنخواستی هم انتقال میشه"
    },
    {
      "id": 100,
      "start": 8007.0,
      "end": 8009.0,
      "formatted_start": "02:13:27.000",
      "formatted_end": "02:13:29.000",
      "text": "اینکه باید موضوع داریم"
    },
    {
      "id": 101,
      "start": 8009.0,
      "end": 8011.0,
      "formatted_start": "02:13:29.000",
      "formatted_end": "02:13:31.000",
      "text": "و دو درد و بنابراین جدا کنید"
    },
    {
      "id": 102,
      "start": 8011.0,
      "end": 8015.0,
      "formatted_start": "02:13:31.000",
      "formatted_end": "02:13:35.000",
      "text": "آنها نباید مرگ از دردشون تستاشو بسیار طبیعی نمیدونند"
    },
    {
      "id": 103,
      "start": 8015.0,
      "end": 8017.0,
      "formatted_start": "02:13:35.000",
      "formatted_end": "02:13:37.000",
      "text": "چون اینو فقط تو مراد های وکس نصیب مدارد"
    },
    {
      "id": 104,
      "start": 8017.0,
      "end": 8020.0,
      "formatted_start": "02:13:37.000",
      "formatted_end": "02:13:40.000",
      "text": "صرف این صورتشون اخبارشون تغلیم کنند"
    },
    {
      "id": 105,
      "start": 8020.0,
      "end": 8021.0,
      "formatted_start": "02:13:40.000",
      "formatted_end": "02:13:41.000",
      "text": "از اونها گذارید؟"
    },
    {
      "id": 106,
      "start": 8021.0,
      "end": 8023.0,
      "formatted_start": "02:13:41.000",
      "formatted_end": "02:13:43.000",
      "text": "آره، از اونها گذارید"
    },
    {
      "id": 107,
      "start": 8023.0,
      "end": 8026.0,
      "formatted_start": "02:13:43.000",
      "formatted_end": "02:13:46.000",
      "text": "چون اینجا بیشتر از این همه حامله هیچی در نقل نگیروند"
    },
    {
      "id": 108,
      "start": 8026.0,
      "end": 8028.0,
      "formatted_start": "02:13:46.000",
      "formatted_end": "02:13:48.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 109,
      "start": 8028.0,
      "end": 8030.0,
      "formatted_start": "02:13:48.000",
      "formatted_end": "02:13:50.000",
      "text": "و موضوع داریم کنید"
    },
    {
      "id": 110,
      "start": 8030.0,
      "end": 8032.0,
      "formatted_start": "02:13:50.000",
      "formatted_end": "02:13:52.000",
      "text": "از آنها همه چیزی هایی کلی هم خوب شد"
    },
    {
      "id": 111,
      "start": 8032.0,
      "end": 8034.0,
      "formatted_start": "02:13:52.000",
      "formatted_end": "02:13:54.000",
      "text": "در اینکه همون رو بردی کنیم"
    },
    {
      "id": 112,
      "start": 8034.0,
      "end": 8036.0,
      "formatted_start": "02:13:54.000",
      "formatted_end": "02:13:56.000",
      "text": "این همه باید بردی کنیم"
    },
    {
      "id": 113,
      "start": 8036.0,
      "end": 8038.0,
      "formatted_start": "02:13:56.000",
      "formatted_end": "02:13:58.000",
      "text": "از جاست درد پسپارو دنباله برم اصلا بخوریم"
    },
    {
      "id": 114,
      "start": 8038.0,
      "end": 8040.0,
      "formatted_start": "02:13:58.000",
      "formatted_end": "02:14:00.000",
      "text": "باید بسرات خوریم"
    },
    {
      "id": 115,
      "start": 8040.0,
      "end": 8042.0,
      "formatted_start": "02:14:00.000",
      "formatted_end": "02:14:02.000",
      "text": "یک حالت دردشت دردیدی"
    },
    {
      "id": 116,
      "start": 8042.0,
      "end": 8044.0,
      "formatted_start": "02:14:02.000",
      "formatted_end": "02:14:04.000",
      "text": "باید وقتی دو هشت محضون میده"
    },
    {
      "id": 117,
      "start": 8044.0,
      "end": 8046.0,
      "formatted_start": "02:14:04.000",
      "formatted_end": "02:14:06.000",
      "text": "باید یک خوبی قرار میشوند"
    },
    {
      "id": 118,
      "start": 8046.0,
      "end": 8048.0,
      "formatted_start": "02:14:06.000",
      "formatted_end": "02:14:08.000",
      "text": "این شروع سیار شدید"
    },
    {
      "id": 119,
      "start": 8048.0,
      "end": 8050.0,
      "formatted_start": "02:14:08.000",
      "formatted_end": "02:14:10.000",
      "text": "بردی کنم بی اثر بی خسنه نداره"
    },
    {
      "id": 120,
      "start": 8050.0,
      "end": 8052.0,
      "formatted_start": "02:14:10.000",
      "formatted_end": "02:14:12.000",
      "text": "برمی کنم"
    },
    {
      "id": 121,
      "start": 8052.0,
      "end": 8054.0,
      "formatted_start": "02:14:12.000",
      "formatted_end": "02:14:14.000",
      "text": "با شخصیتی در اینجا"
    },
    {
      "id": 122,
      "start": 8057.0,
      "end": 8059.0,
      "formatted_start": "02:14:17.000",
      "formatted_end": "02:14:19.000",
      "text": "این کار سه تا نیست"
    },
    {
      "id": 123,
      "start": 8065.0,
      "end": 8067.0,
      "formatted_start": "02:14:25.000",
      "formatted_end": "02:14:27.000",
      "text": "این خیلی خوبه"
    },
    {
      "id": 124,
      "start": 8068.0,
      "end": 8070.0,
      "formatted_start": "02:14:28.000",
      "formatted_end": "02:14:30.000",
      "text": "این کار سه تا نیست"
    },
    {
      "id": 125,
      "start": 8070.0,
      "end": 8072.0,
      "formatted_start": "02:14:30.000",
      "formatted_end": "02:14:32.000",
      "text": "سه تا نیست"
    },
    {
      "id": 126,
      "start": 8072.0,
      "end": 8074.0,
      "formatted_start": "02:14:32.000",
      "formatted_end": "02:14:34.000",
      "text": "این کار سه تا نیست"
    },
