      "id": 75,
      "start": 11326.0,
      "end": 11328.0,
      "formatted_start": "03:08:46.000",
      "formatted_end": "03:08:48.000",
      "text": "صبح میخوابم و میخوازم"
    },
    {
      "id": 76,
      "start": 11328.0,
      "end": 11330.0,
      "formatted_start": "03:08:48.000",
      "formatted_end": "03:08:50.000",
      "text": "دردش کنم باشه پیشتر میشه"
    },
    {
      "id": 77,
      "start": 11330.0,
      "end": 11332.0,
      "formatted_start": "03:08:50.000",
      "formatted_end": "03:08:52.000",
      "text": "امروز من برزش کردم"
    },
    {
      "id": 78,
      "start": 11332.0,
      "end": 11334.0,
      "formatted_start": "03:08:52.000",
      "formatted_end": "03:08:54.000",
      "text": "دیشنم برزش کردم"
    },
    {
      "id": 79,
      "start": 11334.0,
      "end": 11336.0,
      "formatted_start": "03:08:54.000",
      "formatted_end": "03:08:56.000",
      "text": "خدا میتونی که از اینکه از اینکه از اینکه"
    },
    {
      "id": 80,
      "start": 11336.0,
      "end": 11338.0,
      "formatted_start": "03:08:56.000",
      "formatted_end": "03:08:58.000",
      "text": "که از اولاهاتون میگیره"
    },
    {
      "id": 81,
      "start": 11338.0,
      "end": 11340.0,
      "formatted_start": "03:08:58.000",
