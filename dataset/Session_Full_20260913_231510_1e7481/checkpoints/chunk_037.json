      "start": 11316.0,
      "end": 11318.0,
      "formatted_start": "03:08:36.000",
      "formatted_end": "03:08:38.000",
      "text": "اینجا باید بشید"
    },
    {
      "id": 71,
      "start": 11318.0,
      "end": 11320.0,
      "formatted_start": "03:08:38.000",
      "formatted_end": "03:08:40.000",
      "text": "اینجا درد می کنه؟"
    },
