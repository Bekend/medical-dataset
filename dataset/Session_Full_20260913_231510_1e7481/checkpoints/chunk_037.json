      "formatted_start": "03:07:06.000",
      "formatted_end": "03:07:08.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 32,
      "start": 11228.0,
      "end": 11230.0,
      "formatted_start": "03:07:08.000",
      "formatted_end": "03:07:10.000",
      "text": "از اینجا باید برداری کنید"
    },
    {
      "id": 33,
      "start": 11230.0,
      "end": 11235.0,
      "formatted_start": "03:07:10.000",
      "formatted_end": "03:07:15.000",
      "text": "چیز میشه؟ این ظالمات که یه چیه؟ بعدم چند ساعته میشید این سرکار؟"
    },
    {
      "id": 34,
      "start": 11235.0,
      "end": 11238.0,
      "formatted_start": "03:07:15.000",
      "formatted_end": "03:07:18.000",
      "text": "من اونجا ساعت ملخص منه همه باید"
    },
    {
      "id": 35,
      "start": 11239.0,
      "end": 11243.0,
      "formatted_start": "03:07:19.000",
      "formatted_end": "03:07:23.000",
      "text": "قرب طولو مینام این ماشینو، من هی مخصم این ماشینم کنیم"
    },
    {
      "id": 36,
      "start": 11243.0,
      "end": 11245.0,
      "formatted_start": "03:07:23.000",
      "formatted_end": "03:07:25.000",
      "text": "در دقیقه، بیس در دقیقه"
    },
    {
      "id": 37,
      "start": 11245.0,
      "end": 11250.0,
      "formatted_start": "03:07:25.000",
      "formatted_end": "03:07:30.000",
      "text": "وقتی که کار نمی کنی، میگو کار کار داره، تو رو تو رو جمع میزنیم نکردی؟"
    },
    {
      "id": 38,
      "start": 11250.0,
      "end": 11252.0,
      "formatted_start": "03:07:30.000",
      "formatted_end": "03:07:32.000",
      "text": "چون؟"
    },
    {
      "id": 39,
      "start": 11252.0,
      "end": 11255.0,
      "formatted_start": "03:07:32.000",
      "formatted_end": "03:07:35.000",
      "text": "چون میگو اینجوری قص برداشته، خب؟"
    },
    {
      "id": 40,
      "start": 11255.0,
      "end": 11256.0,
      "formatted_start": "03:07:35.000",
      "formatted_end": "03:07:36.000",
      "text": "پنجتا"
    },
    {
      "id": 41,
      "start": 11256.0,
      "end": 11257.0,
      "formatted_start": "03:07:36.000",
      "formatted_end": "03:07:37.000",
      "text": "کلسیوم میخوری؟"
    },
    {
      "id": 42,
      "start": 11257.0,
      "end": 11258.0,
      "formatted_start": "03:07:37.000",
      "formatted_end": "03:07:38.000",
      "text": "نه"
    },
    {
      "id": 43,
      "start": 11258.0,
      "end": 11261.06,
      "formatted_start": "03:07:38.000",
      "formatted_end": "03:07:41.060",
      "text": "پنج تا وچه دارم، یکشتا بابه بود مثلا"
    },
    {
      "id": 44,
      "start": 11261.06,
      "end": 11266.24,
      "formatted_start": "03:07:41.060",
      "formatted_end": "03:07:46.240",
      "text": "سیستا دارم، ششتا وچه دارم، یه یشکا بابه برو بابه"
    },
    {
      "id": 45,
      "start": 11266.24,
      "end": 11269.1,
      "formatted_start": "03:07:46.240",
      "formatted_end": "03:07:49.100",
      "text": "برگتو میدی عزیز؟"
    },
    {
      "id": 46,
      "start": 11269.1,
      "end": 11272.14,
      "formatted_start": "03:07:49.100",
      "formatted_end": "03:07:52.140",
      "text": "چون این همه تو همه زیادی درد میکنه"
    },
    {
      "id": 47,
      "start": 11272.14,
      "end": 11274.68,
      "formatted_start": "03:07:52.140",
      "formatted_end": "03:07:54.680",
      "text": "انا با پلو همچی دوزدی ها با درد میکنه"
    },
    {
      "id": 48,
      "start": 11274.68,
      "end": 11278.86,
      "formatted_start": "03:07:54.680",
      "formatted_end": "03:07:58.860",
      "text": "ما بازدهتن هم بودیم پلو همینجی"
    },
    {
      "id": 49,
      "start": 11278.86,
      "end": 11280.78,
      "formatted_start": "03:07:58.860",
      "formatted_end": "03:08:00.780",
      "text": "برای من نمیدونم"
    },
    {
      "id": 50,
      "start": 11280.78,
      "end": 11282.56,
      "formatted_start": "03:08:00.780",
      "formatted_end": "03:08:02.560",
      "text": "چشم ارزارت همی سوزه؟"
    },
    {
      "id": 51,
      "start": 11282.56,
      "end": 11282.94,
      "formatted_start": "03:08:02.560",
      "formatted_end": "03:08:02.940",
      "text": "نه"
    },
    {
      "id": 52,
      "start": 11282.94,
      "end": 11285.0,
      "formatted_start": "03:08:02.940",
      "formatted_end": "03:08:05.000",
      "text": "برنگ برنگ نشده؟"
    },
    {
      "id": 53,
      "start": 11285.0,
      "end": 11286.0,
      "formatted_start": "03:08:05.000",
      "formatted_end": "03:08:06.000",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 11286.0,
      "end": 11290.0,
      "formatted_start": "03:08:06.000",
      "formatted_end": "03:08:10.000",
      "text": "نه، حقا این مسیر اتفالو درد میکنه، اینجا هم باقو"
    },
    {
      "id": 55,
      "start": 11290.0,
      "end": 11291.0,
      "formatted_start": "03:08:10.000",
      "formatted_end": "03:08:11.000",
      "text": "اینجا؟"
    },
    {
      "id": 56,
      "start": 11291.0,
      "end": 11294.0,
      "formatted_start": "03:08:11.000",
      "formatted_end": "03:08:14.000",
      "text": "نه، درد میکنه، اینجا ها، اینجا ها، اینجا ها"
    },
    {
      "id": 57,
      "start": 11294.0,
      "end": 11296.0,
      "formatted_start": "03:08:14.000",
      "formatted_end": "03:08:16.000",
      "text": "ببخشون، اینجا میزنن درد داردی؟"
    },
    {
      "id": 58,
      "start": 11296.0,
      "end": 11297.0,
      "formatted_start": "03:08:16.000",
      "formatted_end": "03:08:17.000",
      "text": "نه"
    },
    {
      "id": 59,
      "start": 11297.0,
      "end": 11298.0,
      "formatted_start": "03:08:17.000",
      "formatted_end": "03:08:18.000",
      "text": "اینجا ها درد دارد؟"
    },
    {
      "id": 60,
      "start": 11298.0,
      "end": 11299.0,
      "formatted_start": "03:08:18.000",
      "formatted_end": "03:08:19.000",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 11299.0,
      "end": 11300.0,
      "formatted_start": "03:08:19.000",
      "formatted_end": "03:08:20.000",
      "text": "کجا؟"
    },
    {
      "id": 62,
      "start": 11300.0,
      "end": 11304.0,
      "formatted_start": "03:08:20.000",
      "formatted_end": "03:08:24.000",
      "text": "هم اینجا ها، هم سر دنده ها اینجا، ها اینجا، اینجا"
    },
    {
      "id": 63,
      "start": 11304.0,
      "end": 11305.0,
      "formatted_start": "03:08:24.000",
      "formatted_end": "03:08:25.000",
      "text": "سر دنده ها"
    },
    {
      "id": 64,
      "start": 11305.0,
      "end": 11306.0,
      "formatted_start": "03:08:25.000",
      "formatted_end": "03:08:26.000",
      "text": "اینجا ها؟"
    },
    {
      "id": 65,
      "start": 11306.0,
      "end": 11307.0,
      "formatted_start": "03:08:26.000",
      "formatted_end": "03:08:27.000",
      "text": "آه، سر دنده ها"
    },
    {
      "id": 66,
      "start": 11307.0,
      "end": 11310.0,
      "formatted_start": "03:08:27.000",
      "formatted_end": "03:08:30.000",
      "text": "فشار میده، همه اصلا اونها کار درد میگه"
    },
    {
      "id": 67,
      "start": 11310.0,
      "end": 11312.0,
      "formatted_start": "03:08:30.000",
      "formatted_end": "03:08:32.000",
      "text": "از سر دنده ها همینجا"
    },
    {
      "id": 68,
      "start": 11312.0,
      "end": 11314.0,
      "formatted_start": "03:08:32.000",
      "formatted_end": "03:08:34.000",
      "text": "ها همین همین"
    },
    {
      "id": 69,
      "start": 11314.0,
      "end": 11316.0,
      "formatted_start": "03:08:34.000",
      "formatted_end": "03:08:36.000",
      "text": "بسیار که مردم خیلی بزنیم"
    },
