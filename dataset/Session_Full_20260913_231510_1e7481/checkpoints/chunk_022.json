  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6629.98,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6632.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:32.000",
      "text": "از که تو خوابینجی شدی؟"
    },
    {
      "id": 2,
      "start": 6632.0,
      "end": 6634.0,
      "formatted_start": "01:50:32.000",
      "formatted_end": "01:50:34.000",
      "text": "از طالع شده این همین مسیح هم درد میکنه"
    },
    {
      "id": 3,
      "start": 6634.0,
      "end": 6636.0,
      "formatted_start": "01:50:34.000",
      "formatted_end": "01:50:36.000",
      "text": "خودم برم بشم"
    },
    {
      "id": 4,
      "start": 6636.0,
      "end": 6638.0,
      "formatted_start": "01:50:36.000",
      "formatted_end": "01:50:38.000",
      "text": "دندونه خراب نداری؟"
    },
    {
      "id": 5,
      "start": 6638.0,
      "end": 6640.0,
      "formatted_start": "01:50:38.000",
      "formatted_end": "01:50:40.000",
      "text": "دندونه همه خرابه"
    },
    {
      "id": 6,
      "start": 6640.0,
      "end": 6642.0,
      "formatted_start": "01:50:40.000",
      "formatted_end": "01:50:42.000",
      "text": "پایگه هم ندارم سو کم بزنیم بزنم بردن بخورم"
    },
    {
      "id": 7,
      "start": 6642.0,
      "end": 6644.0,
      "formatted_start": "01:50:42.000",
      "formatted_end": "01:50:44.000",
      "text": "چون خرابه هم"
    },
    {
      "id": 8,
      "start": 6644.0,
      "end": 6646.0,
      "formatted_start": "01:50:44.000",
      "formatted_end": "01:50:46.000",
      "text": "چون این سمت درد میکنه؟"
    },
    {
      "id": 9,
      "start": 6646.0,
      "end": 6648.0,
      "formatted_start": "01:50:46.000",
      "formatted_end": "01:50:48.000",
      "text": "اینجا یه همینجا یه همه"
    },
    {
      "id": 10,
      "start": 6648.0,
      "end": 6650.0,
      "formatted_start": "01:50:48.000",
      "formatted_end": "01:50:50.000",
      "text": "این سلسل اخی اینجا"
    },
    {
      "id": 11,
      "start": 6650.0,
      "end": 6652.0,
      "formatted_start": "01:50:50.000",
      "formatted_end": "01:50:52.000",
      "text": "این ممکنه اصلا تلاشه باشه درد بشه"
    },
    {
      "id": 12,
      "start": 6652.0,
      "end": 6654.0,
      "formatted_start": "01:50:52.000",
      "formatted_end": "01:50:54.000",
      "text": "اینجا هم درد داره؟"
    },
    {
      "id": 13,
      "start": 6654.0,
      "end": 6656.0,
      "formatted_start": "01:50:54.000",
      "formatted_end": "01:50:56.000",
      "text": "این محصول همین خیلی جده هست"
    },
    {
      "id": 14,
      "start": 6656.0,
      "end": 6658.0,
      "formatted_start": "01:50:56.000",
      "formatted_end": "01:50:58.000",
      "text": "برای اون که اون صبح رو میزن کن دو بار"
    },
    {
      "id": 15,
      "start": 6658.0,
      "end": 6660.0,
      "formatted_start": "01:50:58.000",
      "formatted_end": "01:51:00.000",
      "text": "کلت همینی هست از این پشت هلقه؟"
    },
    {
      "id": 16,
      "start": 6660.0,
      "end": 6662.0,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:02.000",
      "text": "کم زیادی"
    },
    {
      "id": 17,
      "start": 6662.0,
      "end": 6664.0,
      "formatted_start": "01:51:02.000",
      "formatted_end": "01:51:04.000",
      "text": "بسه هم وقتی خلنگ میشه"
    },
    {
      "id": 18,
      "start": 6664.0,
      "end": 6666.0,
      "formatted_start": "01:51:04.000",
      "formatted_end": "01:51:06.000",
      "text": "یه اثر ترجیم نست"
    },
    {
      "id": 19,
      "start": 6666.0,
      "end": 6668.0,
      "formatted_start": "01:51:06.000",
      "formatted_end": "01:51:08.000",
      "text": "ولی خب اگه موجود"
    },
    {
      "id": 20,
      "start": 6668.0,
      "end": 6670.0,
      "formatted_start": "01:51:08.000",
      "formatted_end": "01:51:10.000",
      "text": "از اینجا که میزن"
    },
    {
      "id": 21,
      "start": 6670.0,
      "end": 6672.0,
      "formatted_start": "01:51:10.000",
      "formatted_end": "01:51:12.000",
      "text": "از اینجا پخش میشه"
    },
    {
      "id": 22,
      "start": 6672.0,
      "end": 6674.0,
      "formatted_start": "01:51:12.000",
      "formatted_end": "01:51:14.000",
      "text": "پخش میشه؟"
    },
    {
      "id": 23,
      "start": 6674.0,
      "end": 6676.0,
      "formatted_start": "01:51:14.000",
      "formatted_end": "01:51:16.000",
      "text": "نرم درم دیگه باید چون همشه"
    },
    {
      "id": 24,
      "start": 6676.0,
      "end": 6678.0,
      "formatted_start": "01:51:16.000",
      "formatted_end": "01:51:18.000",
      "text": "ترکیب میتونم"
    },
    {
      "id": 25,
      "start": 6678.0,
      "end": 6680.0,
      "formatted_start": "01:51:18.000",
      "formatted_end": "01:51:20.000",
      "text": "اونکه پشتارت پایین نداره"
    },
    {
      "id": 26,
      "start": 6680.0,
      "end": 6682.0,
      "formatted_start": "01:51:20.000",
      "formatted_end": "01:51:22.000",
      "text": "تو قرن درم داره بگیر"
    },
    {
      "id": 27,
      "start": 6682.0,
      "end": 6684.0,
      "formatted_start": "01:51:22.000",
      "formatted_end": "01:51:24.000",
      "text": "آقایی؟"
    },
    {
      "id": 28,
      "start": 6684.0,
      "end": 6686.0,
      "formatted_start": "01:51:24.000",
      "formatted_end": "01:51:26.000",
      "text": "نه، پشت هم نداره"
    },
    {
      "id": 29,
      "start": 6686.0,
      "end": 6688.0,
      "formatted_start": "01:51:26.000",
      "formatted_end": "01:51:28.000",
      "text": "بعد"
    },
    {
      "id": 30,
      "start": 6688.0,
      "end": 6690.0,
      "formatted_start": "01:51:28.000",
      "formatted_end": "01:51:30.000",
      "text": "سرما نخورده بودی عزیزم؟"
    },
    {
      "id": 31,
      "start": 6690.0,
      "end": 6692.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:32.000",
      "text": "به نظرم سرما خورده بود"
    },
    {
      "id": 32,
      "start": 6692.0,
      "end": 6694.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:34.000",
      "text": "داره صرفون میزنه"
    },
    {
      "id": 33,
      "start": 6694.0,
      "end": 6696.0,
      "formatted_start": "01:51:34.000",
      "formatted_end": "01:51:36.000",
      "text": "چی مریضه از رستان بود؟"
    },
    {
      "id": 34,
      "start": 6696.0,
      "end": 6698.0,
      "formatted_start": "01:51:36.000",
      "formatted_end": "01:51:38.000",
      "text": "چشم دو بیرونش درست نیست؟"
    },
    {
      "id": 35,
      "start": 6698.0,
      "end": 6700.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:40.000",
      "text": "نه"
    },
    {
      "id": 36,
      "start": 6700.0,
      "end": 6702.0,
      "formatted_start": "01:51:40.000",
      "formatted_end": "01:51:42.000",
      "text": "در تجربه نداره؟"
    },
    {
      "id": 37,
      "start": 6702.0,
      "end": 6704.0,
      "formatted_start": "01:51:42.000",
      "formatted_end": "01:51:44.000",
      "text": "نه"
    },
    {
      "id": 38,
      "start": 6704.0,
      "end": 6706.0,
      "formatted_start": "01:51:44.000",
      "formatted_end": "01:51:46.000",
      "text": "نیره تزهیب و نیره مساله بود"
    },
    {
      "id": 39,
      "start": 6706.0,
      "end": 6708.0,
      "formatted_start": "01:51:46.000",
      "formatted_end": "01:51:48.000",
      "text": "پس از پیرون قرد شده"
    },
    {
      "id": 40,
      "start": 6708.0,
      "end": 6710.0,
      "formatted_start": "01:51:48.000",
      "formatted_end": "01:51:50.000",
      "text": "اما بود جا به جا باشه معنوی چیه"
    },
    {
      "id": 41,
      "start": 6710.0,
      "end": 6713.0,
      "formatted_start": "01:51:50.000",
      "formatted_end": "01:51:53.000",
      "text": "گفتم باید باید سا شیسته با اونجا باشه"
    },
    {
      "id": 42,
      "start": 6715.0,
      "end": 6716.0,
      "formatted_start": "01:51:55.000",
      "formatted_end": "01:51:56.000",
      "text": "خاله نمیخواد بره"
    },
    {
      "id": 43,
      "start": 6716.0,
      "end": 6719.0,
      "formatted_start": "01:51:56.000",
      "formatted_end": "01:51:59.000",
      "text": "چون میخواد بره دیگه خاله نه این نداره"
    },
    {
      "id": 44,
      "start": 6719.0,
      "end": 6721.0,
      "formatted_start": "01:51:59.000",
      "formatted_end": "01:52:01.000",
      "text": "نه خاله که من رو برم"
    },
    {
      "id": 45,
      "start": 6721.0,
      "end": 6724.0,
      "formatted_start": "01:52:01.000",
      "formatted_end": "01:52:04.000",
      "text": "نه پسرش که میخواد بره فیلم پرمنده ها جلو میزنن دیگه"
    },
    {
      "id": 46,
      "start": 6724.0,
      "end": 6726.0,
      "formatted_start": "01:52:04.000",
      "formatted_end": "01:52:06.000",
      "text": "باست دوباره مطلب های دیگه میکرسن"
    },
    {
      "id": 47,
      "start": 6729.0,
      "end": 6732.0,
      "formatted_start": "01:52:09.000",
      "formatted_end": "01:52:12.000",
      "text": "اتفاق پسرها دیگهش منکارمنده بانکش"
    },
    {
      "id": 48,
      "start": 6733.0,
      "end": 6735.0,
      "formatted_start": "01:52:13.000",
      "formatted_end": "01:52:15.000",
      "text": "بیمون نکردیم برای اگه بیمون کنم"
    },
    {
      "id": 49,
      "start": 6735.0,
      "end": 6737.0,
      "formatted_start": "01:52:15.000",
      "formatted_end": "01:52:17.000",
      "text": "نمی آزاد شده با دنگمونی"
    },
    {
      "id": 50,
      "start": 6737.0,
      "end": 6738.0,
      "formatted_start": "01:52:17.000",
      "formatted_end": "01:52:18.000",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 6738.0,
      "end": 6768.0,
      "formatted_start": "01:52:18.000",
      "formatted_end": "01:52:48.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 52,
      "start": 6768.0,
      "end": 6770.0,
      "formatted_start": "01:52:48.000",
      "formatted_end": "01:52:50.000",
      "text": "جوش داده بودی؟"
    },
    {
      "id": 53,
      "start": 6770.0,
      "end": 6775.0,
      "formatted_start": "01:52:50.000",
      "formatted_end": "01:52:55.000",
      "text": "نه کسی جوش رو چی نداشتم به خداتو برم کنار محروسی بدون خوشحال بوده"
    },
    {
      "id": 54,
      "start": 6775.0,
      "end": 6779.0,
      "formatted_start": "01:52:55.000",
      "formatted_end": "01:52:59.000",
      "text": "بله بله نه سردن نه فرصد نمیدونم در بودن اتاق بخوابم"
    },
    {
      "id": 55,
      "start": 6779.0,
      "end": 6781.0,
      "formatted_start": "01:52:59.000",
      "formatted_end": "01:53:01.000",
      "text": "ایشه همه ندارم"
    },
    {
      "id": 56,
      "start": 6781.0,
      "end": 6784.0,
      "formatted_start": "01:53:01.000",
      "formatted_end": "01:53:04.000",
      "text": "ولی بالاخره هرچی هست که عصبش اضطهاب پیدا کرده"
    },
    {
      "id": 57,
      "start": 6784.0,
      "end": 6785.0,
      "formatted_start": "01:53:04.000",
      "formatted_end": "01:53:05.000",
      "text": "نه نه"
    },
    {
      "id": 58,
      "start": 6785.0,
      "end": 6787.0,
      "formatted_start": "01:53:05.000",
      "formatted_end": "01:53:07.000",
      "text": "اون اضطهاب عصب صورته"
    },
    {
      "id": 59,
      "start": 6787.0,
      "end": 6793.0,
      "formatted_start": "01:53:07.000",
      "formatted_end": "01:53:13.000",
      "text": "حالا چی شده باز خور فلش نداره گوی وقتا فلش موقعت میده نظران دستر موهر"
    },
    {
      "id": 60,
      "start": 6793.0,
      "end": 6795.0,
      "formatted_start": "01:53:13.000",
      "formatted_end": "01:53:15.000",
      "text": "هرچی بوده یه"
    },
    {
      "id": 61,
      "start": 6795.0,
      "end": 6797.0,
      "formatted_start": "01:53:15.000",
      "formatted_end": "01:53:17.000",
      "text": "این چیزی بوده"
    },
    {
      "id": 62,
      "start": 6797.0,
      "end": 6799.0,
      "formatted_start": "01:53:17.000",
      "formatted_end": "01:53:19.000",
      "text": "به بیدلی نمیشه اینجوری"
    },
    {
      "id": 63,
      "start": 6799.0,
      "end": 6801.0,
      "formatted_start": "01:53:19.000",
      "formatted_end": "01:53:21.000",
      "text": "رفتی تو فرق"
    },
    {
      "id": 64,
      "start": 6801.0,
      "end": 6805.0,
      "formatted_start": "01:53:21.000",
      "formatted_end": "01:53:25.000",
      "text": "فشارتو گرفتی و خوب بود"
    },
    {
      "id": 65,
      "start": 6805.0,
      "end": 6807.0,
      "formatted_start": "01:53:25.000",
      "formatted_end": "01:53:27.000",
      "text": "قرصه منو بزن نشان دیدم"
    },
    {
      "id": 66,
      "start": 6807.0,
      "end": 6809.0,
      "formatted_start": "01:53:27.000",
      "formatted_end": "01:53:29.000",
      "text": "یادم رفته خواهم دفت"
    },
    {
      "id": 67,
      "start": 6809.0,
      "end": 6811.0,
      "formatted_start": "01:53:29.000",
      "formatted_end": "01:53:31.000",
      "text": "من این قرصه رو میکنم"
    },
    {
      "id": 68,
      "start": 6811.0,
      "end": 6813.0,
      "formatted_start": "01:53:31.000",
      "formatted_end": "01:53:33.000",
      "text": "قرصه فشار دارم"
    },
    {
      "id": 69,
      "start": 6813.0,
      "end": 6815.0,
      "formatted_start": "01:53:33.000",
      "formatted_end": "01:53:35.000",
      "text": "قرصه این همه قرصه هم دارم"
    },
    {
      "id": 70,
      "start": 6815.0,
      "end": 6817.0,
      "formatted_start": "01:53:35.000",
      "formatted_end": "01:53:37.000",
      "text": "چربی هست"
    },
    {
      "id": 71,
      "start": 6817.0,
      "end": 6819.0,
      "formatted_start": "01:53:37.000",
      "formatted_end": "01:53:39.000",
      "text": "قرصه چربی"
    },
    {
      "id": 72,
      "start": 6819.0,
      "end": 6821.0,
      "formatted_start": "01:53:39.000",
      "formatted_end": "01:53:41.000",
      "text": "چرا دو جور چربی هست؟"
    },
    {
      "id": 73,
      "start": 6821.0,
      "end": 6823.0,
      "formatted_start": "01:53:41.000",
      "formatted_end": "01:53:43.000",
      "text": "هر دو رو میخوری؟"
    },
    {
      "id": 74,
      "start": 6823.0,
      "end": 6825.0,
      "formatted_start": "01:53:43.000",
      "formatted_end": "01:53:45.000",
      "text": "این هم میخوری این هم؟"
    },
    {
      "id": 75,
      "start": 6825.0,
      "end": 6827.0,
      "formatted_start": "01:53:45.000",
      "formatted_end": "01:53:47.000",
      "text": "نه دیگه"
    },
    {
      "id": 76,
      "start": 6827.0,
      "end": 6829.0,
      "formatted_start": "01:53:47.000",
      "formatted_end": "01:53:49.000",
      "text": "نه این هم یکیه خود همینان تختیر از اون"
    },
    {
      "id": 77,
      "start": 6829.0,
      "end": 6831.0,
      "formatted_start": "01:53:49.000",
      "formatted_end": "01:53:51.000",
      "text": "خود دو قلب بودن این هم"
    },
    {
      "id": 78,
      "start": 6831.0,
      "end": 6833.0,
      "formatted_start": "01:53:51.000",
      "formatted_end": "01:53:53.000",
      "text": "خب این هم همونه دیگه"
    },
    {
      "id": 79,
      "start": 6833.0,
      "end": 6835.0,
      "formatted_start": "01:53:53.000",
      "formatted_end": "01:53:55.000",
      "text": "این همونه باید برده"
    },
    {
      "id": 80,
      "start": 6835.0,
      "end": 6837.0,
      "formatted_start": "01:53:55.000",
      "formatted_end": "01:53:57.000",
      "text": "این ایرانی ها تک خارجی شد"
    },
    {
      "id": 81,
      "start": 6837.0,
      "end": 6839.0,
      "formatted_start": "01:53:57.000",
      "formatted_end": "01:53:59.000",
      "text": "این چه هست؟"
    },
    {
      "id": 82,
      "start": 6845.0,
      "end": 6847.0,
      "formatted_start": "01:54:05.000",
      "formatted_end": "01:54:07.000",
      "text": "الان میدونی که این دوتا یکیه آره؟"
    },
    {
      "id": 83,
      "start": 6847.0,
      "end": 6849.0,
      "formatted_start": "01:54:07.000",
      "formatted_end": "01:54:09.000",
      "text": "نه نمیدونی"
    },
    {
      "id": 84,
      "start": 6849.0,
      "end": 6851.0,
      "formatted_start": "01:54:09.000",
      "formatted_end": "01:54:11.000",
      "text": "اینو میدونی که دوتا شکلی؟"
    },
    {
      "id": 85,
      "start": 6851.0,
      "end": 6853.0,
      "formatted_start": "01:54:11.000",
      "formatted_end": "01:54:13.000",
      "text": "از اینجا باید نخواهید بردارید"
    },
    {
