      "formatted_end": "01:54:52.728",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 6893.875,
      "end": 6896.693,
      "formatted_start": "01:54:53.875",
      "formatted_end": "01:54:56.693",
      "speaker": "SPEAKER_01"
