      "formatted_start": "06:15:33.000",
      "formatted_end": "06:15:35.000",
      "text": "شکل همین صرف هر شبه نه"
    },
    {
      "id": 4,
      "start": 22535.0,
      "end": 22536.0,
      "formatted_start": "06:15:35.000",
      "formatted_end": "06:15:36.000",
      "text": "نیست"
    },
    {
      "id": 5,
      "start": 22536.0,
      "end": 22538.0,
      "formatted_start": "06:15:36.000",
      "formatted_end": "06:15:38.000",
      "text": "خوب ها داشتن"
    },
    {
      "id": 6,
      "start": 22538.0,
      "end": 22540.0,
      "formatted_start": "06:15:38.000",
      "formatted_end": "06:15:40.000",
      "text": "آلو و انگو باشه"
    },
    {
      "id": 7,
      "start": 22540.0,
      "end": 22541.0,
      "formatted_start": "06:15:40.000",
      "formatted_end": "06:15:41.000",
      "text": "خوب بزیاد بشید"
    },
    {
      "id": 8,
      "start": 22541.0,
      "end": 22544.0,
      "formatted_start": "06:15:41.000",
      "formatted_end": "06:15:44.000",
      "text": "پس فیلن اگه اون خوبه سه ماه بهش هر شب بده"
    },
    {
      "id": 9,
      "start": 22544.0,
      "end": 22545.0,
      "formatted_start": "06:15:44.000",
      "formatted_end": "06:15:45.000",
      "text": "هر شب"
    },
    {
      "id": 10,
      "start": 22545.0,
      "end": 22546.0,
      "formatted_start": "06:15:45.000",
      "formatted_end": "06:15:46.000",
      "text": "سه ماه بهش هر شب بده"
    },
    {
      "id": 11,
      "start": 22546.0,
      "end": 22549.0,
      "formatted_start": "06:15:46.000",
      "formatted_end": "06:15:49.000",
      "text": "قطران اون شربک هم که دادیم اونو یه روز در میم باشه"
    },
    {
      "id": 12,
      "start": 22549.0,
      "end": 22551.0,
      "formatted_start": "06:15:49.000",
      "formatted_end": "06:15:51.000",
      "text": "خیلی خوشمونه"
    },
    {
      "id": 13,
      "start": 22551.0,
      "end": 22552.0,
      "formatted_start": "06:15:51.000",
      "formatted_end": "06:15:52.000",
      "text": "نه نشان که"
    },
    {
      "id": 14,
      "start": 22552.0,
      "end": 22553.0,
      "formatted_start": "06:15:52.000",
      "formatted_end": "06:15:53.000",
      "text": "یه روز در میم بشن"
    },
    {
      "id": 15,
      "start": 22553.0,
      "end": 22556.0,
      "formatted_start": "06:15:53.000",
      "formatted_end": "06:15:56.000",
      "text": "خب باید فرهان داره ویتامیشن رو برده"
    },
    {
      "id": 16,
      "start": 22556.0,
      "end": 22558.0,
      "formatted_start": "06:15:56.000",
      "formatted_end": "06:15:58.000",
      "text": "از گوشت قیمت زود"
    },
    {
      "id": 17,
      "start": 22558.0,
      "end": 22560.0,
      "formatted_start": "06:15:58.000",
      "formatted_end": "06:16:00.000",
      "text": "تو شیشه میرزن"
    },
    {
      "id": 18,
      "start": 22560.0,
      "end": 22562.0,
      "formatted_start": "06:16:00.000",
      "formatted_end": "06:16:02.000",
      "text": "اونم برده"
    },
    {
      "id": 19,
      "start": 22562.0,
      "end": 22565.0,
      "formatted_start": "06:16:02.000",
      "formatted_end": "06:16:05.000",
      "text": "اصلا لازم نیست اینها رو اینقدر کاره خواست"
    },
    {
      "id": 20,
      "start": 22565.0,
      "end": 22566.0,
      "formatted_start": "06:16:05.000",
      "formatted_end": "06:16:06.000",
      "text": "چه سختی بوده"
    },
    {
      "id": 21,
      "start": 22566.0,
      "end": 22568.0,
      "formatted_start": "06:16:06.000",
      "formatted_end": "06:16:08.000",
      "text": "تو خیلی یا این کار رو می کنه برای آهنگ؟"
    },
    {
      "id": 22,
      "start": 22568.0,
      "end": 22570.0,
      "formatted_start": "06:16:08.000",
      "formatted_end": "06:16:10.000",
      "text": "این موضوع برای بچه ها نیست"
    },
    {
      "id": 23,
      "start": 22570.0,
      "end": 22572.0,
      "formatted_start": "06:16:10.000",
      "formatted_end": "06:16:12.000",
      "text": "اون دور از جونش برای بیماران افتاده است"
    },
    {
      "id": 24,
      "start": 22572.0,
      "end": 22574.0,
      "formatted_start": "06:16:12.000",
      "formatted_end": "06:16:14.000",
      "text": "اونم بیشتر ما آلبامین ها این رو می خواهیم"
    },
    {
      "id": 25,
      "start": 22574.0,
      "end": 22577.0,
      "formatted_start": "06:16:14.000",
      "formatted_end": "06:16:17.000",
      "text": "اون خیلی اتفاقا آهنگ نداره"
    },
    {
      "id": 26,
      "start": 22577.0,
      "end": 22581.0,
      "formatted_start": "06:16:17.000",
      "formatted_end": "06:16:21.000",
      "text": "آهنگ تو خود گوشته برن. مثلا ترپیون میگه آه بچن خودشتونی خوده برن."
    },
    {
      "id": 27,
      "start": 22581.0,
      "end": 22584.0,
      "formatted_start": "06:16:21.000",
      "formatted_end": "06:16:24.000",
      "text": "باید خود گوشته بخوره خودشش فایده نداره."
    },
    {
      "id": 28,
      "start": 22584.0,
      "end": 22587.0,
      "formatted_start": "06:16:24.000",
      "formatted_end": "06:16:27.000",
      "text": "آهنگ پرس داره یا براش بنویسن؟"
    },
    {
      "id": 29,
      "start": 22587.0,
      "end": 22590.0,
      "formatted_start": "06:16:27.000",
      "formatted_end": "06:16:30.000",
      "text": "دادیم دیگه همونو هست."
    },
    {
      "id": 30,
      "start": 22590.0,
      "end": 22594.0,
      "formatted_start": "06:16:30.000",
      "formatted_end": "06:16:34.000",
      "text": "بهش دادم فروسوفات. پرسش صورتیه؟"
    },
    {
      "id": 31,
      "start": 22594.0,
      "end": 22596.0,
      "formatted_start": "06:16:34.000",
      "formatted_end": "06:16:36.000",
      "text": "آره. آره دیگه."
    },
    {
      "id": 32,
      "start": 22596.0,
      "end": 22599.0,
      "formatted_start": "06:16:36.000",
      "formatted_end": "06:16:39.000",
      "text": "همونو. سه ماه بهش مردم پرشک بده."
    },
    {
      "id": 33,
      "start": 22599.0,
      "end": 22602.0,
      "formatted_start": "06:16:39.000",
      "formatted_end": "06:16:42.000",
      "text": "اگه بنویسی بریسی که اگه تمومتون بخوره."
    },
    {
      "id": 34,
      "start": 22602.0,
      "end": 22603.0,
      "formatted_start": "06:16:42.000",
      "formatted_end": "06:16:43.000",
      "text": "او برن میزامونو بخورن."
    },
    {
      "id": 35,
      "start": 22603.0,
      "end": 22605.0,
      "formatted_start": "06:16:43.000",
      "formatted_end": "06:16:45.000",
      "text": "اون بیمزده دیگه"
    },
    {
      "id": 36,
      "start": 22605.0,
      "end": 22607.0,
      "formatted_start": "06:16:45.000",
      "formatted_end": "06:16:47.000",
      "text": "نه بیمزده"
    },
    {
      "id": 37,
      "start": 22607.0,
      "end": 22609.0,
      "formatted_start": "06:16:47.000",
      "formatted_end": "06:16:49.000",
      "text": "خوبه اگه... چون فکر کنیم سما نمیشه کمه"
    },
    {
      "id": 38,
      "start": 22609.0,
      "end": 22611.0,
      "formatted_start": "06:16:49.000",
      "formatted_end": "06:16:51.000",
      "text": "فروسوفات بیمزده"
    },
    {
      "id": 39,
      "start": 22611.0,
      "end": 22613.0,
      "formatted_start": "06:16:51.000",
      "formatted_end": "06:16:53.000",
      "text": "آزادهاش مال ما بزرگ هست"
    },
    {
      "id": 40,
      "start": 22613.0,
      "end": 22615.0,
      "formatted_start": "06:16:53.000",
      "formatted_end": "06:16:55.000",
      "text": "چون این برای بچه ها"
    },
    {
      "id": 41,
      "start": 22615.0,
      "end": 22617.0,
      "formatted_start": "06:16:55.000",
      "formatted_end": "06:16:57.000",
      "text": "دوزش پایینه"
    },
    {
      "id": 42,
      "start": 22617.0,
      "end": 22619.0,
      "formatted_start": "06:16:57.000",
      "formatted_end": "06:16:59.000",
      "text": "بعد باز دوباره بیارمش"
    },
    {
      "id": 43,
      "start": 22619.0,
      "end": 22621.0,
      "formatted_start": "06:16:59.000",
      "formatted_end": "06:17:01.000",
      "text": "بعد سما آزماش دیکردم"
    },
    {
      "id": 44,
      "start": 22621.0,
      "end": 22623.0,
      "formatted_start": "06:17:01.000",
      "formatted_end": "06:17:03.000",
      "text": "شش ماه بعد یه آزماش خونده"
    },
    {
      "id": 45,
      "start": 22623.0,
      "end": 22625.0,
      "formatted_start": "06:17:03.000",
      "formatted_end": "06:17:05.000",
      "text": "فقط صفحه راهنشو چکن"
    },
    {
      "id": 46,
      "start": 22625.0,
      "end": 22627.0,
      "formatted_start": "06:17:05.000",
      "formatted_end": "06:17:07.000",
      "text": "دیگه آزماش کن یه بچه ندی"
    },
    {
      "id": 47,
      "start": 22627.0,
      "end": 22629.0,
      "formatted_start": "06:17:07.000",
      "formatted_end": "06:17:09.000",
      "text": "چون خوب داره"
    },
    {
      "id": 48,
      "start": 22629.0,
      "end": 22631.0,
      "formatted_start": "06:17:09.000",
      "formatted_end": "06:17:11.000",
      "text": "همین صفحه کافیه"
    },
    {
      "id": 49,
      "start": 22631.0,
      "end": 22634.0,
      "formatted_start": "06:17:11.000",
      "formatted_end": "06:17:14.000",
      "text": "بعد خاندرتونم خودم پیشش آورده"
    },
    {
      "id": 50,
      "start": 22634.0,
      "end": 22637.0,
      "formatted_start": "06:17:14.000",
      "formatted_end": "06:17:17.000",
      "text": "این لاخنه رو میادم را بهتون نشون دادم"
    },
    {
      "id": 51,
      "start": 22637.0,
      "end": 22641.0,
      "formatted_start": "06:17:17.000",
      "formatted_end": "06:17:21.000",
      "text": "اصلا نباش دردی شده اون چیزی شده"
    },
    {
      "id": 52,
      "start": 22641.0,
      "end": 22645.0,
      "formatted_start": "06:17:21.000",
      "formatted_end": "06:17:25.000",
      "text": "موانه ایمان میرونه در یک چپمانت میکنیدم"
    },
    {
      "id": 53,
      "start": 22645.0,
      "end": 22647.0,
      "formatted_start": "06:17:25.000",
      "formatted_end": "06:17:27.000",
      "text": "اون برای زخم است"
    },
    {
      "id": 54,
      "start": 22647.0,
      "end": 22650.0,
      "formatted_start": "06:17:27.000",
      "formatted_end": "06:17:30.000",
      "text": "من یک مدت از سال دیگه لباس استفاده کردم"
    },
    {
      "id": 55,
      "start": 22650.0,
      "end": 22652.0,
      "formatted_start": "06:17:30.000",
      "formatted_end": "06:17:32.000",
      "text": "لباسم مثلا 24 تا 22"
    },
    {
      "id": 56,
      "start": 22652.0,
      "end": 22655.0,
      "formatted_start": "06:17:32.000",
      "formatted_end": "06:17:35.000",
      "text": "تو دو هفته کم کم شستم"
    },
    {
      "id": 57,
      "start": 22655.0,
      "end": 22656.0,
      "formatted_start": "06:17:35.000",
      "formatted_end": "06:17:36.000",
      "text": "مستقبلی را درستم"
    },
    {
      "id": 58,
      "start": 22656.0,
      "end": 22659.0,
      "formatted_start": "06:17:36.000",
      "formatted_end": "06:17:39.000",
      "text": "برای این مدت را باقی شده کردم"
    },
    {
      "id": 59,
      "start": 22659.0,
      "end": 22661.82,
      "formatted_start": "06:17:39.000",
      "formatted_end": "06:17:41.820",
      "text": "یعنی من یک سال کار نکرده بودم"
    },
    {
      "id": 60,
      "start": 22661.82,
      "end": 22664.28,
      "formatted_start": "06:17:41.820",
      "formatted_end": "06:17:44.280",
      "text": "بعد یه بار تابسون شد جوی شدم"
    },
    {
      "id": 61,
      "start": 22664.28,
      "end": 22668.64,
      "formatted_start": "06:17:44.280",
      "formatted_end": "06:17:48.640",
      "text": "همه یه دواسه که لک داشتن و با همون سابون با دختم همون"
    },
    {
      "id": 62,
      "start": 22668.64,
      "end": 22671.76,
      "formatted_start": "06:17:48.640",
      "formatted_end": "06:17:51.760",
      "text": "دیگه بدن از دست کشه سابون کمتر خواهی داره باشی"
    },
    {
      "id": 63,
      "start": 22671.76,
      "end": 22674.06,
      "formatted_start": "06:17:51.760",
      "formatted_end": "06:17:54.060",
      "text": "اما من بیانم چیم؟"
    },
    {
      "id": 64,
      "start": 22674.06,
      "end": 22675.72,
      "formatted_start": "06:17:54.060",
      "formatted_end": "06:17:55.720",
      "text": "اما بدن زخم هست"
    },
    {
      "id": 65,
      "start": 22675.72,
      "end": 22678.22,
      "formatted_start": "06:17:55.720",
      "formatted_end": "06:17:58.220",
      "text": "دست زخم داری دارمی میزنیم"
    },
    {
      "id": 66,
      "start": 22678.22,
      "end": 22680.98,
      "formatted_start": "06:17:58.220",
      "formatted_end": "06:18:00.980",
      "text": "اما بزنیم نخونت خوب"
    },
    {
      "id": 67,
      "start": 22680.98,
      "end": 22684.78,
      "formatted_start": "06:18:00.980",
      "formatted_end": "06:18:04.780",
      "text": "نمی محروم نخونت خیلی دیر خوب میشه"
    },
    {
      "id": 68,
      "start": 22684.78,
      "end": 22686.62,
      "formatted_start": "06:18:04.780",
      "formatted_end": "06:18:06.620",
      "text": "اما داره میشکنه"
    },
    {
      "id": 69,
      "start": 22686.62,
      "end": 22688.62,
      "formatted_start": "06:18:06.620",
      "formatted_end": "06:18:08.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 70,
      "start": 22688.62,
      "end": 22690.62,
      "formatted_start": "06:18:08.620",
      "formatted_end": "06:18:10.620",
      "text": "از شرکتی از شرکتی"
    },
    {
      "id": 71,
      "start": 22690.62,
      "end": 22692.62,
      "formatted_start": "06:18:10.620",
      "formatted_end": "06:18:12.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 72,
      "start": 22692.62,
      "end": 22694.62,
      "formatted_start": "06:18:12.620",
      "formatted_end": "06:18:14.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 73,
      "start": 22694.62,
      "end": 22696.62,
      "formatted_start": "06:18:14.620",
      "formatted_end": "06:18:16.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 74,
      "start": 22696.62,
      "end": 22698.62,
      "formatted_start": "06:18:16.620",
      "formatted_end": "06:18:18.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 75,
      "start": 22698.62,
      "end": 22700.62,
      "formatted_start": "06:18:18.620",
      "formatted_end": "06:18:20.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 76,
      "start": 22700.62,
      "end": 22702.62,
      "formatted_start": "06:18:20.620",
      "formatted_end": "06:18:22.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 77,
      "start": 22702.62,
      "end": 22704.62,
      "formatted_start": "06:18:22.620",
      "formatted_end": "06:18:24.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 78,
      "start": 22704.62,
      "end": 22706.62,
      "formatted_start": "06:18:24.620",
      "formatted_end": "06:18:26.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 79,
      "start": 22706.62,
      "end": 22708.62,
      "formatted_start": "06:18:26.620",
      "formatted_end": "06:18:28.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 80,
      "start": 22708.62,
      "end": 22710.62,
      "formatted_start": "06:18:28.620",
      "formatted_end": "06:18:30.620",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 81,
      "start": 22710.62,
      "end": 22720.8,
      "formatted_start": "06:18:30.620",
      "formatted_end": "06:18:40.800",
      "text": "محلول شده میشن؟"
    },
    {
      "id": 82,
      "start": 22720.8,
      "end": 22722.0,
      "formatted_start": "06:18:40.800",
      "formatted_end": "06:18:42.000",
      "text": "چند دقیقه دیگه میره"
    },
    {
      "id": 83,
      "start": 22722.0,
      "end": 22723.64,
      "formatted_start": "06:18:42.000",
      "formatted_end": "06:18:43.640",
      "text": "الان میره"
    },
    {
      "id": 84,
      "start": 22723.64,
      "end": 22727.58,
      "formatted_start": "06:18:43.640",
      "formatted_end": "06:18:47.580",
