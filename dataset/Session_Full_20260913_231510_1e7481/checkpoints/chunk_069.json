  "stt_segments": [
    {
      "id": 0,
      "start": 20700.0,
      "end": 20706.0,
      "formatted_start": "05:45:00.000",
      "formatted_end": "05:45:06.000",
      "text": "از اینکه از کلیه کمکار شده، کمکار که بشه قندتونو میگیدید؟"
    },
    {
      "id": 1,
      "start": 20706.0,
      "end": 20707.0,
      "formatted_start": "05:45:06.000",
      "formatted_end": "05:45:07.000",
      "text": "آره."
    },
    {
      "id": 2,
      "start": 20707.0,
      "end": 20712.0,
      "formatted_start": "05:45:07.000",
      "formatted_end": "05:45:12.000",
      "text": "بعضی وقتا قندت بالا میزنه، گاهی وقتی."
    },
    {
      "id": 3,
      "start": 20712.0,
      "end": 20714.0,
      "formatted_start": "05:45:12.000",
      "formatted_end": "05:45:14.000",
      "text": "قبلین همش بالا بود."
    },
    {
      "id": 4,
      "start": 20714.0,
      "end": 20715.0,
      "formatted_start": "05:45:14.000",
      "formatted_end": "05:45:15.000",
      "text": "میدونم."
    },
    {
      "id": 5,
      "start": 20715.0,
      "end": 20718.0,
      "formatted_start": "05:45:15.000",
      "formatted_end": "05:45:18.000",
      "text": "حالا دیگه اومده به این کلیه کمکار شده، خب؟"
    },
    {
      "id": 6,
      "start": 20718.0,
      "end": 20721.0,
      "formatted_start": "05:45:18.000",
      "formatted_end": "05:45:21.000",
      "text": "کمکار که بشه قند میاد پایین."
    },
    {
      "id": 7,
      "start": 20721.0,
      "end": 20726.0,
      "formatted_start": "05:45:21.000",
      "formatted_end": "05:45:26.000",
      "text": "یعنی از کلیه دفعه میوفته دیگه."
    },
    {
      "id": 8,
      "start": 20726.0,
      "end": 20727.0,
      "formatted_start": "05:45:26.000",
      "formatted_end": "05:45:27.000",
      "text": "آفرین."
    },
    {
      "id": 9,
      "start": 20727.0,
      "end": 20728.0,
      "formatted_start": "05:45:27.000",
      "formatted_end": "05:45:28.000",
      "text": "ببین از این میفتیم."
    },
    {
      "id": 10,
      "start": 20728.0,
      "end": 20733.0,
      "formatted_start": "05:45:28.000",
      "formatted_end": "05:45:33.000",
      "text": "با نه هنوز یک و هفته اینجا میان با پنج و شیش و اینا دار زندگی میکنن"
    },
    {
      "id": 11,
      "start": 20733.0,
      "end": 20734.0,
      "formatted_start": "05:45:33.000",
      "formatted_end": "05:45:34.000",
      "text": "هیچ کار ندارن"
    },
    {
      "id": 12,
      "start": 20734.0,
      "end": 20739.0,
      "formatted_start": "05:45:34.000",
      "formatted_end": "05:45:39.000",
      "text": "ولی دیگه آره قند رو نمیتونه چون کلی از کار میافته دیگه قند اصلا جزمه میکنه"
    },
    {
      "id": 13,
      "start": 20739.0,
      "end": 20741.0,
      "formatted_start": "05:45:39.000",
      "formatted_end": "05:45:41.000",
      "text": "همهش میره بیرون"
    },
    {
      "id": 14,
      "start": 20741.0,
      "end": 20744.0,
      "formatted_start": "05:45:41.000",
      "formatted_end": "05:45:44.000",
      "text": "برای این دیگه قندتون مثل قدیم بلا نمیره"
    },
    {
      "id": 15,
      "start": 20744.0,
      "end": 20746.0,
      "formatted_start": "05:45:44.000",
      "formatted_end": "05:45:46.000",
      "text": "زندگی عادی بکنی"
    },
    {
      "id": 16,
      "start": 20746.0,
      "end": 20748.0,
      "formatted_start": "05:45:46.000",
      "formatted_end": "05:45:48.000",
      "text": "هر چیز دوست داری بخور"
    },
    {
      "id": 17,
      "start": 20748.0,
      "end": 20752.0,
      "formatted_start": "05:45:48.000",
      "formatted_end": "05:45:52.000",
      "text": "منتها نمک با گوشت قرمز نمک بخونی"
    },
    {
      "id": 18,
      "start": 20752.0,
      "end": 20756.0,
      "formatted_start": "05:45:52.000",
      "formatted_end": "05:45:56.000",
      "text": "شیرینی رو بهتون بر میگردونه"
    },
    {
      "id": 19,
      "start": 20756.0,
      "end": 20758.0,
      "formatted_start": "05:45:56.000",
      "formatted_end": "05:45:58.000",
      "text": "از این نقاضه نمک و عزتون میگیره"
    },
    {
      "id": 20,
      "start": 20758.0,
      "end": 20760.0,
      "formatted_start": "05:45:58.000",
      "formatted_end": "05:46:00.000",
      "text": "گشت قرمز هم میگیره"
    },
    {
      "id": 21,
      "start": 20760.0,
      "end": 20762.0,
      "formatted_start": "05:46:00.000",
      "formatted_end": "05:46:02.000",
      "text": "ماهیه بار"
    },
    {
      "id": 22,
      "start": 20762.0,
      "end": 20764.0,
      "formatted_start": "05:46:02.000",
      "formatted_end": "05:46:04.000",
      "text": "اسپیناج هم نمیتونی کنیم"
    },
    {
      "id": 23,
      "start": 20764.0,
      "end": 20766.0,
      "formatted_start": "05:46:04.000",
      "formatted_end": "05:46:06.000",
      "text": "پایاتونو ببینم"
    },
    {
      "id": 24,
      "start": 20768.0,
      "end": 20770.0,
      "formatted_start": "05:46:08.000",
      "formatted_end": "05:46:10.000",
      "text": "سامو پایاتونو ببینم"
    },
    {
      "id": 25,
      "start": 20772.0,
      "end": 20774.0,
      "formatted_start": "05:46:12.000",
      "formatted_end": "05:46:14.000",
      "text": "میاد کن"
    },
    {
      "id": 26,
      "start": 20774.0,
      "end": 20776.0,
      "formatted_start": "05:46:14.000",
      "formatted_end": "05:46:16.000",
      "text": "از این ادرالی که بگردونو ده"
    },
    {
      "id": 27,
      "start": 20778.0,
      "end": 20780.0,
      "formatted_start": "05:46:18.000",
      "formatted_end": "05:46:20.000",
      "text": "آب سیاد میخوری؟"
    },
    {
      "id": 28,
      "start": 20780.0,
      "end": 20782.0,
      "formatted_start": "05:46:20.000",
      "formatted_end": "05:46:22.000",
      "text": "نه ببین"
    },
    {
      "id": 29,
      "start": 20782.0,
      "end": 20784.0,
      "formatted_start": "05:46:22.000",
      "formatted_end": "05:46:24.000",
      "text": "در حد رفت تشنگتون خیلی نخورید خب؟"
    },
    {
      "id": 30,
      "start": 20786.0,
      "end": 20792.0,
      "formatted_start": "05:46:26.000",
      "formatted_end": "05:46:32.000",
      "text": "یک نصف گوز باید بدم با احتیاط"
    },
    {
      "id": 31,
      "start": 20792.0,
      "end": 20796.0,
      "formatted_start": "05:46:32.000",
      "formatted_end": "05:46:36.000",
      "text": "چون صبح باید نصف گوجه بخونه"
    },
    {
      "id": 32,
      "start": 20796.0,
      "end": 20800.0,
      "formatted_start": "05:46:36.000",
      "formatted_end": "05:46:40.000",
      "text": "یک نصف گوز باید نصف گوجه صبح"
    },
    {
      "id": 33,
      "start": 20800.0,
      "end": 20806.0,
      "formatted_start": "05:46:40.000",
      "formatted_end": "05:46:46.000",
      "text": "یک نصف گوز باید نصف گوجه صبح"
    },
    {
      "id": 34,
      "start": 20806.0,
      "end": 20808.0,
      "formatted_start": "05:46:46.000",
      "formatted_end": "05:46:48.000",
      "text": "بزنم؟"
    },
    {
      "id": 35,
      "start": 20808.0,
      "end": 20810.0,
      "formatted_start": "05:46:48.000",
      "formatted_end": "05:46:50.000",
      "text": "بزنم"
    },
    {
      "id": 36,
      "start": 20810.0,
      "end": 20812.0,
      "formatted_start": "05:46:50.000",
      "formatted_end": "05:46:52.000",
      "text": "آن پول داری؟"
    },
    {
      "id": 37,
      "start": 20812.0,
      "end": 20814.0,
      "formatted_start": "05:46:52.000",
      "formatted_end": "05:46:54.000",
      "text": "آن پول داریم، آن همه نه"
    },
    {
      "id": 38,
      "start": 20822.0,
      "end": 20824.0,
      "formatted_start": "05:47:02.000",
      "formatted_end": "05:47:04.000",
      "text": "برگرم هنوز نه بردن نه داده"
    },
    {
      "id": 39,
      "start": 20824.0,
      "end": 20826.0,
      "formatted_start": "05:47:04.000",
      "formatted_end": "05:47:06.000",
      "text": "برگر چیه؟"
    },
    {
      "id": 40,
      "start": 20826.0,
      "end": 20828.0,
      "formatted_start": "05:47:06.000",
      "formatted_end": "05:47:08.000",
      "text": "برگر که برن آن پول"
    },
    {
      "id": 41,
      "start": 20828.0,
      "end": 20830.0,
      "formatted_start": "05:47:08.000",
      "formatted_end": "05:47:10.000",
      "text": "می بردم برد می دادم اون دسته نیچی"
    },
    {
      "id": 42,
      "start": 20832.0,
      "end": 20834.0,
      "formatted_start": "05:47:12.000",
      "formatted_end": "05:47:14.000",
      "text": "پس دوباره برنیسم چون بیرون نمیشه دیگه"
    },
    {
      "id": 43,
      "start": 20840.0,
      "end": 20842.72,
      "formatted_start": "05:47:20.000",
      "formatted_end": "05:47:22.720",
      "text": "اون برگر اگه فردا ببنن مشکل داره بگیر"
    },
    {
      "id": 44,
      "start": 20842.72,
      "end": 20845.0,
      "formatted_start": "05:47:22.720",
      "formatted_end": "05:47:25.000",
      "text": "کود رکیلش باطل شده"
    },
    {
      "id": 45,
      "start": 20845.0,
      "end": 20849.46,
      "formatted_start": "05:47:25.000",
      "formatted_end": "05:47:29.460",
      "text": "حالا من الان دوباره می نوستم"
    },
    {
      "id": 46,
      "start": 20849.46,
      "end": 20851.84,
      "formatted_start": "05:47:29.460",
      "formatted_end": "05:47:31.840",
      "text": "اگه چی شد"
    },
    {
      "id": 47,
      "start": 20851.84,
      "end": 20853.64,
      "formatted_start": "05:47:31.840",
      "formatted_end": "05:47:33.640",
      "text": "این کود رکیلی که الان بهت می دم"
    },
    {
      "id": 48,
      "start": 20853.64,
      "end": 20855.06,
      "formatted_start": "05:47:33.640",
      "formatted_end": "05:47:35.060",
      "text": "رو کاغذ بزنیم"
    },
    {
      "id": 49,
      "start": 20855.06,
      "end": 20857.42,
      "formatted_start": "05:47:35.060",
      "formatted_end": "05:47:37.420",
      "text": "حالا این کود رکیلی همشی سه تا بهتون بیمه می ده"
    },
    {
      "id": 50,
      "start": 20857.42,
      "end": 20859.78,
      "formatted_start": "05:47:37.420",
      "formatted_end": "05:47:39.780",
      "text": "نقطه آزاد الان ادارو خونده نگیریم"
    },
    {
      "id": 51,
      "start": 20859.78,
      "end": 20861.82,
      "formatted_start": "05:47:39.780",
      "formatted_end": "05:47:41.820",
      "text": "بگیر من می برم ادارو بیمه درست می کنم"
    },
    {
      "id": 52,
      "start": 20861.82,
      "end": 20866.52,
      "formatted_start": "05:47:41.820",
      "formatted_end": "05:47:46.520",
      "text": "برگر اگه ببنن نیمی ده"
    },
    {
      "id": 53,
      "start": 20866.52,
      "end": 20870.52,
      "formatted_start": "05:47:46.520",
      "formatted_end": "05:47:50.520",
      "text": "باید بیرون برم اونجا فرضات درست کنم بدیم"
    },
    {
      "id": 54,
      "start": 20870.52,
      "end": 20874.52,
      "formatted_start": "05:47:50.520",
      "formatted_end": "05:47:54.520",
      "text": "برج عوض شده دیر اومدین"
    },
    {
      "id": 55,
      "start": 20874.52,
      "end": 20878.52,
      "formatted_start": "05:47:54.520",
      "formatted_end": "05:47:58.520",
      "text": "برج عوض شده"
    },
    {
      "id": 56,
      "start": 20878.52,
      "end": 20882.52,
      "formatted_start": "05:47:58.520",
      "formatted_end": "05:48:02.520",
      "text": "اینجا بگیم مشکلی پیش آمده اتونجاییم"
    },
    {
      "id": 57,
      "start": 20882.52,
      "end": 20886.52,
      "formatted_start": "05:48:02.520",
      "formatted_end": "05:48:06.520",
      "text": "مدت اعتبارم داره پس رو بیریم"
    },
    {
      "id": 58,
      "start": 20886.52,
      "end": 20890.52,
      "formatted_start": "05:48:06.520",
      "formatted_end": "05:48:10.520",
      "text": "اگه کود ره گیریش گفتم باطله"
    },
    {
      "id": 59,
      "start": 20890.52,
      "end": 20894.52,
      "formatted_start": "05:48:10.520",
      "formatted_end": "05:48:14.520",
      "text": "اینو نشون بدیم بگی این کود ره گیری"
    },
    {
      "id": 60,
      "start": 20894.52,
      "end": 20898.52,
      "formatted_start": "05:48:14.520",
      "formatted_end": "05:48:18.520",
      "text": "این کوده را کنیم و این را بشون بدم"
    },
    {
      "id": 61,
      "start": 20898.52,
      "end": 20902.52,
      "formatted_start": "05:48:18.520",
      "formatted_end": "05:48:22.520",
      "text": "این تقوییتی هم هر روز صبح بخوره"
    },
    {
      "id": 62,
      "start": 20902.52,
      "end": 20906.52,
      "formatted_start": "05:48:22.520",
      "formatted_end": "05:48:26.520",
      "text": "یک قضا همه چیز روست داری بخور بجازی نکنه که نمیشن"
    },
    {
      "id": 63,
      "start": 20906.52,
      "end": 20910.52,
      "formatted_start": "05:48:26.520",
      "formatted_end": "05:48:30.520",
      "text": "نمشکه نمیزن؟"
    },
    {
      "id": 64,
      "start": 20910.52,
      "end": 20914.52,
      "formatted_start": "05:48:30.520",
      "formatted_end": "05:48:34.520",
      "text": "نمک و اسفل ها"
    },
    {
      "id": 65,
      "start": 20914.52,
      "end": 20918.52,
      "formatted_start": "05:48:34.520",
      "formatted_end": "05:48:38.520",
      "text": "با هر رایت"
    },
    {
      "id": 66,
      "start": 20918.52,
      "end": 20922.52,
      "formatted_start": "05:48:38.520",
      "formatted_end": "05:48:42.520",
      "text": "این روز را بگفتی که"
    },
    {
      "id": 67,
      "start": 20922.52,
      "end": 20923.52,
      "formatted_start": "05:48:42.520",
      "formatted_end": "05:48:43.520",
      "text": "خوشتی؟"
    },
    {
      "id": 68,
      "start": 20923.52,
      "end": 20924.52,
      "formatted_start": "05:48:43.520",
      "formatted_end": "05:48:44.520",
      "text": "نه"
    },
    {
      "id": 69,
      "start": 20924.52,
      "end": 20926.52,
      "formatted_start": "05:48:44.520",
      "formatted_end": "05:48:46.520",
      "text": "نه برم"
    },
    {
      "id": 70,
      "start": 20926.52,
      "end": 20930.52,
      "formatted_start": "05:48:46.520",
      "formatted_end": "05:48:50.520",
      "text": "نصف ورس رو با گوجه بخورم"
    },
    {
      "id": 71,
      "start": 20930.52,
      "end": 20931.52,
      "formatted_start": "05:48:50.520",
      "formatted_end": "05:48:51.520",
      "text": "آره"
    },
    {
      "id": 72,
      "start": 20931.52,
      "end": 20933.52,
      "formatted_start": "05:48:51.520",
      "formatted_end": "05:48:53.520",
      "text": "بعد یه رساله"
    },
    {
      "id": 73,
      "start": 20933.52,
      "end": 20935.52,
      "formatted_start": "05:48:53.520",
      "formatted_end": "05:48:55.520",
      "text": "تا قص صبح نصف"
    },
    {
      "id": 74,
      "start": 20935.52,
      "end": 20938.52,
      "formatted_start": "05:48:55.520",
      "formatted_end": "05:48:58.520",
      "text": "بعد بهتون میگم خیلی بینیم بیرون روی دستشویه"
    },
    {
      "id": 75,
      "start": 20938.52,
      "end": 20940.52,
      "formatted_start": "05:48:58.520",
      "formatted_end": "05:49:00.520",
      "text": "زیاد بین از اتون"
    },
    {
      "id": 76,
      "start": 20940.52,
      "end": 20941.52,
      "formatted_start": "05:49:00.520",
      "formatted_end": "05:49:01.520",
      "text": "خسته نشین"
    },
    {
      "id": 77,
      "start": 20941.52,
      "end": 20943.52,
      "formatted_start": "05:49:01.520",
      "formatted_end": "05:49:03.520",
      "text": "مال این ورسیه که بینیم سند"
    },
    {
      "id": 78,
      "start": 20943.52,
      "end": 20944.52,
      "formatted_start": "05:49:03.520",
      "formatted_end": "05:49:04.520",
      "text": "مشکل نداره"
    },
    {
      "id": 79,
      "start": 20944.52,
      "end": 20945.52,
      "formatted_start": "05:49:04.520",
      "formatted_end": "05:49:05.520",
      "text": "هم نوشتیم؟"
    },
    {
      "id": 80,
      "start": 20945.52,
      "end": 20946.52,
      "formatted_start": "05:49:05.520",
      "formatted_end": "05:49:06.520",
      "text": "آره"
    },
    {
      "id": 81,
      "start": 20946.52,
      "end": 20948.52,
      "formatted_start": "05:49:06.520",
      "formatted_end": "05:49:08.520",
      "text": "نوشتم براتون با همه کودتون"
    },
    {
      "id": 82,
      "start": 20948.52,
      "end": 20949.52,
      "formatted_start": "05:49:08.520",
      "formatted_end": "05:49:09.520",
      "text": "دارونتونو بیاریم بهتون"
    },
    {
      "id": 83,
      "start": 20949.52,
      "end": 20951.52,
      "formatted_start": "05:49:09.520",
      "formatted_end": "05:49:11.520",
      "text": "باز خامشبای جدا کنم بهتون بگی کدومه"
    },
    {
      "id": 84,
      "start": 20951.52,
      "end": 20953.52,
      "formatted_start": "05:49:11.520",
      "formatted_end": "05:49:13.520",
      "text": "باید برداریم که من خود را خواهیم دارم"
    },
    {
      "id": 85,
      "start": 20953.52,
      "end": 20955.52,
      "formatted_start": "05:49:13.520",
      "formatted_end": "05:49:15.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 86,
      "start": 20955.52,
      "end": 20957.52,
      "formatted_start": "05:49:15.520",
      "formatted_end": "05:49:17.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 87,
      "start": 20957.52,
      "end": 20959.52,
      "formatted_start": "05:49:17.520",
      "formatted_end": "05:49:19.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 88,
      "start": 20959.52,
      "end": 20961.52,
      "formatted_start": "05:49:19.520",
      "formatted_end": "05:49:21.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 89,
      "start": 20961.52,
      "end": 20963.52,
      "formatted_start": "05:49:21.520",
      "formatted_end": "05:49:23.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 90,
      "start": 20963.52,
      "end": 20965.52,
      "formatted_start": "05:49:23.520",
      "formatted_end": "05:49:25.520",
      "text": "باید برداریم که من خواهیم دارم"
    },
    {
      "id": 91,
      "start": 20965.52,
      "end": 20967.52,
