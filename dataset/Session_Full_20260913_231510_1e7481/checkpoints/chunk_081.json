      "formatted_start": "06:46:04.000",
      "formatted_end": "06:46:06.000",
      "text": "هشت برق نمیده"
    },
    {
      "id": 18,
      "start": 24366.0,
      "end": 24368.0,
      "formatted_start": "06:46:06.000",
      "formatted_end": "06:46:08.000",
      "text": "هشت برق نمی کنه"
    },
    {
      "id": 19,
      "start": 24388.0,
      "end": 24412.0,
      "formatted_start": "06:46:28.000",
      "formatted_end": "06:46:52.000",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 24412.0,
      "end": 24440.0,
      "formatted_start": "06:46:52.000",
      "formatted_end": "06:47:20.000",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 24442.0,
      "end": 24472.0,
      "formatted_start": "06:47:22.000",
      "formatted_end": "06:47:52.000",
      "text": "از اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که ا"
    },
    {
      "id": 22,
      "start": 24472.0,
      "end": 24474.0,
      "formatted_start": "06:47:52.000",
      "formatted_end": "06:47:54.000",
      "text": "خوبصورت فشار"
    },
    {
      "id": 23,
      "start": 24474.0,
      "end": 24479.0,
      "formatted_start": "06:47:54.000",
      "formatted_end": "06:47:59.000",
      "text": "خوبصورت فشار هم خبتی بودم شباه با همون آمیلویدی پیش میخورم"
    },
    {
      "id": 24,
      "start": 24479.0,
      "end": 24481.0,
      "formatted_start": "06:47:59.000",
      "formatted_end": "06:48:01.000",
      "text": "چون قبلن فشارش میره بالا"
    },
    {
      "id": 25,
      "start": 24481.0,
      "end": 24483.0,
      "formatted_start": "06:48:01.000",
      "formatted_end": "06:48:03.000",
      "text": "اونو که دستور داد که شباه بخور میبینی"
    },
    {
      "id": 26,
      "start": 24483.0,
      "end": 24485.0,
      "formatted_start": "06:48:03.000",
      "formatted_end": "06:48:05.000",
      "text": "الان فشارش هم بالاست"
    },
    {
      "id": 27,
      "start": 24485.0,
      "end": 24489.0,
      "formatted_start": "06:48:05.000",
      "formatted_end": "06:48:09.000",
      "text": "الان از آمیلویدی پی نوزی یه تونه میخورن"
    },
    {
      "id": 28,
      "start": 24489.0,
      "end": 24491.0,
      "formatted_start": "06:48:09.000",
      "formatted_end": "06:48:11.000",
      "text": "شهر برم بزنید؟"
    },
    {
      "id": 29,
      "start": 24491.0,
      "end": 24492.0,
      "formatted_start": "06:48:11.000",
      "formatted_end": "06:48:12.000",
      "text": "صبح و شبه"
    },
    {
      "id": 30,
      "start": 24492.0,
      "end": 24493.0,
      "formatted_start": "06:48:12.000",
      "formatted_end": "06:48:13.000",
      "text": "هم صبح هم شب"
    },
    {
      "id": 31,
      "start": 24493.0,
      "end": 24496.0,
      "formatted_start": "06:48:13.000",
      "formatted_end": "06:48:16.000",
      "text": "پس چون امروز فشار تو یکم بالا بود"
    },
    {
      "id": 32,
      "start": 24496.0,
      "end": 24500.0,
      "formatted_start": "06:48:16.000",
      "formatted_end": "06:48:20.000",
      "text": "چون هم یه خوردار آمیلویدی پی جنب را بودم"
    },
    {
      "id": 33,
      "start": 24500.0,
      "end": 24502.0,
      "formatted_start": "06:48:20.000",
      "formatted_end": "06:48:22.000",
      "text": "مرسی"
    },
    {
      "id": 34,
      "start": 24502.0,
      "end": 24504.0,
      "formatted_start": "06:48:22.000",
      "formatted_end": "06:48:24.000",
      "text": "تو راه این هم"
    },
    {
      "id": 35,
      "start": 24504.0,
      "end": 24510.0,
      "formatted_start": "06:48:24.000",
      "formatted_end": "06:48:30.000",
      "text": "تو خانه باشم نه، اون چارده، سیزده، پونزده پر پانه نیستی"
    },
    {
      "id": 36,
      "start": 24510.0,
      "end": 24512.0,
      "formatted_start": "06:48:30.000",
      "formatted_end": "06:48:32.000",
      "text": "پونزده نه باید بشه دیگه"
    },
    {
      "id": 37,
      "start": 24512.0,
      "end": 24514.0,
      "formatted_start": "06:48:32.000",
      "formatted_end": "06:48:34.000",
      "text": "نه باید باشم"
    },
    {
      "id": 38,
      "start": 24514.0,
      "end": 24516.0,
      "formatted_start": "06:48:34.000",
      "formatted_end": "06:48:36.000",
      "text": "پرس چربی باباتون میخونن؟"
    },
    {
      "id": 39,
      "start": 24516.0,
      "end": 24518.0,
      "formatted_start": "06:48:36.000",
      "formatted_end": "06:48:38.000",
      "text": "نه"
    },
    {
      "id": 40,
      "start": 24518.0,
      "end": 24522.0,
      "formatted_start": "06:48:38.000",
      "formatted_end": "06:48:42.000",
      "text": "چون پشار داره برد بخونن، خب بفتی به چربی خونشون نداره"
    },
    {
      "id": 41,
      "start": 24522.0,
      "end": 24528.0,
      "formatted_start": "06:48:42.000",
      "formatted_end": "06:48:48.000",
      "text": "چون دورجون، ریز که دورجون است، تر ازشون میاده پایین"
    },
    {
      "id": 42,
      "start": 24530.0,
      "end": 24535.24,
      "formatted_start": "06:48:50.000",
      "formatted_end": "06:48:55.240",
      "text": "فعلا، یک سی منویستم گلی کلازی"
    },
    {
      "id": 43,
      "start": 24535.24,
      "end": 24537.86,
      "formatted_start": "06:48:55.240",
      "formatted_end": "06:48:57.860",
      "text": "اول بابا با نصف شروع کنند"
    },
    {
      "id": 44,
      "start": 24537.86,
      "end": 24540.78,
      "formatted_start": "06:48:57.860",
      "formatted_end": "06:49:00.780",
      "text": "نصف زمر، نصف شب"
    },
    {
      "id": 45,
      "start": 24540.78,
      "end": 24543.1,
      "formatted_start": "06:49:00.780",
      "formatted_end": "06:49:03.100",
      "text": "قضا میخوری هاجی؟"
    },
    {
      "id": 46,
      "start": 24543.1,
      "end": 24543.72,
      "formatted_start": "06:49:03.100",
      "formatted_end": "06:49:03.720",
      "text": "قضا بله"
    },
    {
      "id": 47,
      "start": 24543.72,
      "end": 24545.48,
      "formatted_start": "06:49:03.720",
      "formatted_end": "06:49:05.480",
      "text": "قضا درست میکنی؟"
    },
    {
      "id": 48,
      "start": 24545.48,
      "end": 24547.38,
      "formatted_start": "06:49:05.480",
      "formatted_end": "06:49:07.380",
      "text": "میخوری موردتا"
    },
    {
      "id": 49,
      "start": 24547.38,
      "end": 24548.76,
      "formatted_start": "06:49:07.380",
      "formatted_end": "06:49:08.760",
      "text": "میخورن هاجی"
    },
    {
      "id": 50,
      "start": 24548.76,
      "end": 24552.98,
      "formatted_start": "06:49:08.760",
      "formatted_end": "06:49:12.980",
      "text": "آره، کم میخوره ولی میخوره مثلا وعده های بیشتر"
    },
    {
      "id": 51,
      "start": 24552.98,
      "end": 24554.08,
      "formatted_start": "06:49:12.980",
      "formatted_end": "06:49:14.080",
      "text": "کم کم"
    },
    {
      "id": 52,
      "start": 24554.08,
      "end": 24556.64,
      "formatted_start": "06:49:14.080",
      "formatted_end": "06:49:16.640",
      "text": "آهان، فعلا با نصف شروع میکنیم"
    },
    {
      "id": 53,
      "start": 24556.64,
      "end": 24557.84,
      "formatted_start": "06:49:16.640",
      "formatted_end": "06:49:17.840",
      "text": "قبل اینها قبل شان"
    },
    {
      "id": 54,
      "start": 24557.84,
      "end": 24560.76,
      "formatted_start": "06:49:17.840",
      "formatted_end": "06:49:20.760",
      "text": "چون یه دفعه میترسم تنهان و افتاقم بدن"
    },
    {
      "id": 55,
      "start": 24560.76,
      "end": 24562.72,
      "formatted_start": "06:49:20.760",
      "formatted_end": "06:49:22.720",
      "text": "و سرگیجم که دارن باز"
    },
    {
      "id": 56,
      "start": 24562.72,
      "end": 24566.76,
      "formatted_start": "06:49:22.720",
      "formatted_end": "06:49:26.760",
      "text": "و شب بچه خوب میخوابی؟"
    },
    {
      "id": 57,
      "start": 24567.4,
      "end": 24571.22,
      "formatted_start": "06:49:27.400",
      "formatted_end": "06:49:31.220",
      "text": "شب راحت میخوابی تا صبح"
    },
    {
      "id": 58,
      "start": 24571.22,
      "end": 24574.64,
      "formatted_start": "06:49:31.220",
      "formatted_end": "06:49:34.640",
      "text": "پرس و سرگیج از این هیچتر نمیتونیم بدیم"
    },
    {
      "id": 59,
      "start": 24574.64,
      "end": 24576.66,
      "formatted_start": "06:49:34.640",
      "formatted_end": "06:49:36.660",
      "text": "من ویتامین نوشم"
    },
    {
      "id": 60,
      "start": 24576.66,
      "end": 24578.7,
      "formatted_start": "06:49:36.660",
      "formatted_end": "06:49:38.700",
      "text": "چون خواب و بر زیاد میشه"
    },
    {
      "id": 61,
      "start": 24578.7,
      "end": 24581.24,
      "formatted_start": "06:49:38.700",
      "formatted_end": "06:49:41.240",
      "text": "و چون تنهان میترسیم"
    },
    {
      "id": 62,
      "start": 24581.24,
      "end": 24583.76,
      "formatted_start": "06:49:41.240",
      "formatted_end": "06:49:43.760",
      "text": "از شکستگی تو پیرا خیلی ما میترسیم"
    },
    {
      "id": 63,
      "start": 24583.76,
      "end": 24588.76,
      "formatted_start": "06:49:43.760",
      "formatted_end": "06:49:48.760",
      "text": "بعد تا از آزمایش بابا هم نوشتم خود کنن"
    },
    {
      "id": 64,
      "start": 24588.76,
      "end": 24593.76,
      "formatted_start": "06:49:48.760",
      "formatted_end": "06:49:53.760",
      "text": "داروشونو بخورن یه هفته دیگه ببر بابا آزمایش"
    },
    {
      "id": 65,
      "start": 24593.76,
      "end": 24594.76,
      "formatted_start": "06:49:53.760",
      "formatted_end": "06:49:54.760",
      "text": "یه هفته دیگه؟"
    },
    {
      "id": 66,
      "start": 24594.76,
      "end": 24596.76,
      "formatted_start": "06:49:54.760",
      "formatted_end": "06:49:56.760",
      "text": "اوه، اون کیفو اضافه کردیم داره؟"
    },
    {
      "id": 67,
      "start": 24596.76,
      "end": 24597.76,
      "formatted_start": "06:49:56.760",
      "formatted_end": "06:49:57.760",
      "text": "آره، بده باشیم"
    },
    {
      "id": 68,
      "start": 24597.76,
      "end": 24598.76,
      "formatted_start": "06:49:57.760",
      "formatted_end": "06:49:58.760",
      "text": "تاروچان"
    },
    {
      "id": 69,
      "start": 24598.76,
      "end": 24599.76,
      "formatted_start": "06:49:58.760",
      "formatted_end": "06:49:59.760",
      "text": "چیانو دارم اینجا؟"
    }
  ],
  "status": "completed"
}