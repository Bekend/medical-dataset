      "formatted_end": "04:25:47.000",
      "text": "اوکیه یعنی توی من رو باید بینیشون که برم بیرم و دیگه تنویشو باید تقیید کنه برام"
    },
    {
      "id": 23,
      "start": 15947.0,
      "end": 15950.0,
      "formatted_start": "04:25:47.000",
      "formatted_end": "04:25:50.000",
      "text": "ببین که الان اوکیه عمل نمیشه داد عزیزم"
    },
    {
      "id": 24,
      "start": 15950.0,
      "end": 15951.0,
      "formatted_start": "04:25:50.000",
      "formatted_end": "04:25:51.000",
      "text": "نه؟"
    },
    {
      "id": 25,
      "start": 15951.0,
      "end": 15953.0,
      "formatted_start": "04:25:51.000",
      "formatted_end": "04:25:53.000",
      "text": "نمیتونی عمل کنی"
    },
    {
      "id": 26,
      "start": 15953.0,
      "end": 15955.0,
      "formatted_start": "04:25:53.000",
      "formatted_end": "04:25:55.000",
      "text": "من چربی را از بیرون میگیرم"
    },
    {
      "id": 27,
      "start": 15955.0,
      "end": 15957.0,
      "formatted_start": "04:25:55.000",
      "formatted_end": "04:25:57.000",
      "text": "چربی مار نیست که"
    },
    {
      "id": 28,
      "start": 15957.0,
      "end": 15958.0,
      "formatted_start": "04:25:57.000",
      "formatted_end": "04:25:58.000",
      "text": "چی؟"
    },
    {
      "id": 29,
      "start": 15958.0,
      "end": 15960.0,
      "formatted_start": "04:25:58.000",
      "formatted_end": "04:26:00.000",
      "text": "گندتون خیلی پادست، چربی نمیگیرم"
    },
    {
      "id": 30,
      "start": 15960.0,
      "end": 15964.0,
      "formatted_start": "04:26:00.000",
      "formatted_end": "04:26:04.000",
      "text": "کم غم که چپاو آوردن بگیر شما نداره که؟"
    },
    {
      "id": 31,
      "start": 15964.0,
      "end": 15966.0,
      "formatted_start": "04:26:04.000",
      "formatted_end": "04:26:06.000",
      "text": "خب من که چرا میگیرم؟"
    },
    {
      "id": 32,
      "start": 15966.0,
      "end": 15968.0,
      "formatted_start": "04:26:06.000",
      "formatted_end": "04:26:08.000",
      "text": "اونکه من نمیستم میخوای عملتون بگیرم"
    },
    {
      "id": 33,
      "start": 15968.0,
      "end": 15970.0,
      "formatted_start": "04:26:08.000",
      "formatted_end": "04:26:10.000",
      "text": "یادم نمیدونم که اون مریضی"
    },
    {
      "id": 34,
      "start": 15970.0,
      "end": 15972.0,
      "formatted_start": "04:26:10.000",
      "formatted_end": "04:26:12.000",
      "text": "با این گندت بمیتونن عمل کنن"
    },
    {
      "id": 35,
      "start": 15972.0,
      "end": 15974.0,
      "formatted_start": "04:26:12.000",
      "formatted_end": "04:26:14.000",
      "text": "بخیر چشم عفونت میکنن"
    },
    {
      "id": 36,
      "start": 15974.0,
      "end": 15976.0,
      "formatted_start": "04:26:14.000",
      "formatted_end": "04:26:16.000",
      "text": "چپاو بگیرم"
    },
    {
      "id": 37,
      "start": 15976.0,
      "end": 15978.0,
      "formatted_start": "04:26:16.000",
      "formatted_end": "04:26:18.000",
      "text": "میگو خونو یا خونو بگیرم"
    },
    {
      "id": 38,
      "start": 15978.0,
      "end": 15981.24,
      "formatted_start": "04:26:18.000",
      "formatted_end": "04:26:21.240",
      "text": "من چه کار آمار دارم به صفحه اون کند رو میگویم"
    },
    {
      "id": 39,
      "start": 15981.24,
      "end": 15984.2,
      "formatted_start": "04:26:21.240",
      "formatted_end": "04:26:24.200",
      "text": "من اگه کند من سال هشتر بیاد پایین حالا نمیشه"
    },
    {
      "id": 40,
      "start": 15984.2,
      "end": 15985.52,
      "formatted_start": "04:26:24.200",
      "formatted_end": "04:26:25.520",
      "text": "هشتر و هشتر"
    },
    {
      "id": 41,
      "start": 15985.52,
      "end": 15987.96,
      "formatted_start": "04:26:25.520",
      "formatted_end": "04:26:27.960",
      "text": "یکم آزمایشکایی برد مردک داشته باشه"
    },
    {
      "id": 42,
      "start": 15987.96,
      "end": 15988.48,
      "formatted_start": "04:26:27.960",
      "formatted_end": "04:26:28.480",
      "text": "خب؟"
    },
    {
      "id": 43,
      "start": 15988.48,
      "end": 15991.04,
      "formatted_start": "04:26:28.480",
      "formatted_end": "04:26:31.040",
      "text": "آزمایشکایی برد مردک داشته باشه"
    },
    {
      "id": 44,
      "start": 15991.04,
      "end": 15992.22,
      "formatted_start": "04:26:31.040",
      "formatted_end": "04:26:32.220",
      "text": "که بریم اونجا آقی عمل"
    },
    {
      "id": 45,
      "start": 15992.22,
      "end": 15993.7,
      "formatted_start": "04:26:32.220",
      "formatted_end": "04:26:33.700",
      "text": "میروی تو تا بیوشی"
    },
    {
      "id": 46,
      "start": 15993.7,
      "end": 15995.7,
      "formatted_start": "04:26:33.700",
      "formatted_end": "04:26:35.700",
      "text": "بیوشی بیوشت نمی کنه"
    },
    {
      "id": 47,
      "start": 15995.7,
      "end": 15997.4,
      "formatted_start": "04:26:35.700",
      "formatted_end": "04:26:37.400",
      "text": "قند بالا بیوش نمی کنه"
    },
    {
      "id": 48,
      "start": 15997.4,
      "end": 15998.94,
      "formatted_start": "04:26:37.400",
      "formatted_end": "04:26:38.940",
      "text": "چون اونکه مریض بیوش نگهد"
    },
    {
      "id": 49,
      "start": 15998.94,
      "end": 16002.18,
      "formatted_start": "04:26:38.940",
      "formatted_end": "04:26:42.180",
      "text": "این یک دوم جای اعمال مریض افراد کنه چشمش کنه میشه"
    },
    {
      "id": 50,
      "start": 16002.18,
      "end": 16004.18,
      "formatted_start": "04:26:42.180",
      "formatted_end": "04:26:44.180",
      "text": "هیچکی این مسئله از خبر نمی کنه"
    },
    {
      "id": 51,
      "start": 16004.18,
      "end": 16006.18,
      "formatted_start": "04:26:44.180",
      "formatted_end": "04:26:46.180",
      "text": "بعد یه آزمایش بریم"
    },
    {
      "id": 52,
      "start": 16006.18,
      "end": 16009.6,
      "formatted_start": "04:26:46.180",
      "formatted_end": "04:26:49.600",
      "text": "باید قند ناشتا بیاد زیر 120"
    },
    {
      "id": 53,
      "start": 16009.6,
      "end": 16012.6,
      "formatted_start": "04:26:49.600",
      "formatted_end": "04:26:52.600",
      "text": "قند بعد غذا بیاد زیر دیگه سو پنجه"
    },
    {
      "id": 54,
      "start": 16012.6,
      "end": 16016.44,
      "formatted_start": "04:26:52.600",
      "formatted_end": "04:26:56.440",
      "text": "ایمانستید باید در برتنگ حالت بشه زیر 8 یعنی"
    },
    {
      "id": 55,
      "start": 16016.44,
      "end": 16019.6,
      "formatted_start": "04:26:56.440",
      "formatted_end": "04:26:59.600",
      "text": "خب من نمیشه یه پستن این کنیم کنیم خب شما"
    },
    {
      "id": 56,
      "start": 16019.6,
      "end": 16021.6,
      "formatted_start": "04:26:59.600",
      "formatted_end": "04:27:01.600",
      "text": "بیماری چی داری؟"
    },
    {
      "id": 57,
      "start": 16021.6,
      "end": 16022.6,
      "formatted_start": "04:27:01.600",
      "formatted_end": "04:27:02.600",
      "text": "ترمینش کنیم"
    },
    {
      "id": 58,
      "start": 16022.6,
      "end": 16024.6,
      "formatted_start": "04:27:02.600",
      "formatted_end": "04:27:04.600",
      "text": "خب بیماری مکمل داری ترمین؟"
    },
    {
      "id": 59,
      "start": 16024.6,
      "end": 16026.6,
      "formatted_start": "04:27:04.600",
      "formatted_end": "04:27:06.600",
      "text": "نه تکمیلی نه"
    },
    {
      "id": 60,
      "start": 16026.6,
      "end": 16028.6,
      "formatted_start": "04:27:06.600",
      "formatted_end": "04:27:08.600",
      "text": "تکمیلی نه تأمینم"
    },
    {
      "id": 61,
      "start": 16028.6,
      "end": 16030.6,
      "formatted_start": "04:27:08.600",
      "formatted_end": "04:27:10.600",
      "text": "خب تأمین اگه بری بیمارسان تأمین بستایی کنه"
    },
    {
      "id": 62,
      "start": 16030.6,
      "end": 16032.6,
      "formatted_start": "04:27:10.600",
      "formatted_end": "04:27:12.600",
      "text": "چون من خصوصی هم برای فضایی نمیشه"
    },
    {
      "id": 63,
      "start": 16032.6,
      "end": 16034.6,
      "formatted_start": "04:27:12.600",
      "formatted_end": "04:27:14.600",
      "text": "خب نه هم بیمارسان تأمین اگه من اون طرف بگیرم"
    },
    {
      "id": 64,
      "start": 16034.6,
      "end": 16036.6,
      "formatted_start": "04:27:14.600",
      "formatted_end": "04:27:16.600",
      "text": "من تأمین نیستم"
    },
    {
      "id": 65,
      "start": 16036.6,
      "end": 16038.6,
      "formatted_start": "04:27:16.600",
      "formatted_end": "04:27:18.600",
      "text": "اگه نام رو بفرد بگیرم"
    },
    {
      "id": 66,
      "start": 16038.6,
      "end": 16040.6,
      "formatted_start": "04:27:18.600",
      "formatted_end": "04:27:20.600",
      "text": "شب بگم آقای این بیمار اینجایی قدرش کنترل نیست"
    },
    {
      "id": 67,
      "start": 16040.6,
      "end": 16042.6,
      "formatted_start": "04:27:20.600",
      "formatted_end": "04:27:22.600",
      "text": "میخواد عمل کنه"
    },
    {
      "id": 68,
      "start": 16042.6,
      "end": 16044.6,
      "formatted_start": "04:27:22.600",
      "formatted_end": "04:27:24.600",
      "text": "و تا اونجا با قدرش نمیتونه عملش کنه"
    },
    {
      "id": 69,
      "start": 16044.6,
      "end": 16046.6,
      "formatted_start": "04:27:24.600",
      "formatted_end": "04:27:26.600",
      "text": "بریم اونجایی که بستریت کنه همه"
    },
    {
      "id": 70,
      "start": 16046.6,
      "end": 16048.6,
      "formatted_start": "04:27:26.600",
      "formatted_end": "04:27:28.600",
      "text": "همه بره همه بره"
    },
    {
      "id": 71,
      "start": 16048.6,
      "end": 16050.6,
      "formatted_start": "04:27:28.600",
      "formatted_end": "04:27:30.600",
      "text": "دردور"
    },
    {
      "id": 72,
      "start": 16050.6,
      "end": 16052.6,
      "formatted_start": "04:27:30.600",
      "formatted_end": "04:27:32.600",
      "text": "دردور حسینی"
    },
    {
      "id": 73,
      "start": 16052.6,
      "end": 16054.6,
      "formatted_start": "04:27:32.600",
      "formatted_end": "04:27:34.600",
      "text": "خاند دردور حسینی با"
    },
    {
      "id": 74,
      "start": 16054.6,
      "end": 16056.6,
      "formatted_start": "04:27:34.600",
      "formatted_end": "04:27:36.600",
      "text": "فزشک بیمارستان تامینه"
    },
    {
      "id": 75,
      "start": 16056.6,
      "end": 16058.6,
      "formatted_start": "04:27:36.600",
      "formatted_end": "04:27:38.600",
      "text": "بر مطبعش گنبد"
    },
    {
      "id": 76,
      "start": 16058.6,
      "end": 16060.6,
      "formatted_start": "04:27:38.600",
      "formatted_end": "04:27:40.600",
      "text": "که اون خودش میتونه تو رو بستری کنه"
    },
    {
      "id": 77,
      "start": 16060.6,
      "end": 16062.6,
      "formatted_start": "04:27:40.600",
      "formatted_end": "04:27:42.600",
      "text": "یه نامه میدهم"
    },
    {
      "id": 78,
      "start": 16062.6,
      "end": 16064.6,
      "formatted_start": "04:27:42.600",
      "formatted_end": "04:27:44.600",
      "text": "اگه ارجانس قبولتون کردن که چه بهتر"
    },
    {
      "id": 79,
      "start": 16064.6,
      "end": 16066.6,
      "formatted_start": "04:27:44.600",
      "formatted_end": "04:27:46.600",
      "text": "اگه دیدی که قبول نکردن و"
    },
    {
      "id": 80,
      "start": 16066.6,
      "end": 16068.6,
      "formatted_start": "04:27:46.600",
      "formatted_end": "04:27:48.600",
      "text": "سردوندن بریم مطبع"
    },
    {
      "id": 81,
      "start": 16068.6,
      "end": 16070.6,
      "formatted_start": "04:27:48.600",
      "formatted_end": "04:27:50.600",
      "text": "دردور محسا حسینی بخواد"
    },
    {
      "id": 82,
      "start": 16070.6,
      "end": 16072.6,
      "formatted_start": "04:27:50.600",
      "formatted_end": "04:27:52.600",
      "text": "کجا نفر؟ گنبد"
    },
    {
      "id": 83,
      "start": 16072.6,
      "end": 16102.6,
      "formatted_start": "04:27:52.600",
      "formatted_end": "04:28:22.600",
      "text": "من بردن بگویم که اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 84,
      "start": 16102.6,
      "end": 16126.6,
      "formatted_start": "04:28:22.600",
      "formatted_end": "04:28:46.600",
      "text": "موسیقی"
    },
    {
      "id": 85,
      "start": 16126.6,
      "end": 16132.6,
      "formatted_start": "04:28:46.600",
      "formatted_end": "04:28:52.600",
      "text": "من اینجور میسهم چهارصد الا پونستد چون من دیگه من را بکنم که اونا بستاری کنم"
    },
    {
      "id": 86,
      "start": 16142.6,
      "end": 16150.6,
      "formatted_start": "04:29:02.600",
      "formatted_end": "04:29:10.600",
      "text": "یک کار دیگه هم میکنیم مرتبه شده نگه خود درمانگاه بیمارستان تمنی اجتماعی هم خاندکتر صبح میشینه"
    },
    {
      "id": 87,
      "start": 16150.6,
      "end": 16151.72,
      "formatted_start": "04:29:10.600",
      "formatted_end": "04:29:11.720",
      "text": "خب نوبت؟"
    },
    {
      "id": 88,
      "start": 16151.72,
      "end": 16152.22,
      "formatted_start": "04:29:11.720",
      "formatted_end": "04:29:12.220",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 16153.06,
      "end": 16154.76,
      "formatted_start": "04:29:13.060",
      "formatted_end": "04:29:14.760",
      "text": "یه صبح بگید در مانگار"
    },
    {
      "id": 90,
      "start": 16154.76,
      "end": 16157.26,
      "formatted_start": "04:29:14.760",
      "formatted_end": "04:29:17.260",
      "text": "بگید از این دکتر حسینی نوبت میخوای"
    },
    {
      "id": 91,
      "start": 16158.18,
      "end": 16159.76,
      "formatted_start": "04:29:18.180",
      "formatted_end": "04:29:19.760",
      "text": "ازش نوبت بگیری"
    },
    {
      "id": 92,
      "start": 16160.1,
      "end": 16161.8,
      "formatted_start": "04:29:20.100",
      "formatted_end": "04:29:21.800",
      "text": "وقتی گرفتی این نامر نشون بگیری"
    },
    {
      "id": 93,
      "start": 16161.8,
      "end": 16163.64,
      "formatted_start": "04:29:21.800",
      "formatted_end": "04:29:23.640",
      "text": "یعنی رو دوری بیده نوبتی"
    },
    {
      "id": 94,
      "start": 16163.64,
      "end": 16165.48,
      "formatted_start": "04:29:23.640",
      "formatted_end": "04:29:25.480",
      "text": "یعنی باید تلفنی بگیری"
    },
    {
      "id": 95,
      "start": 16165.48,
      "end": 16167.8,
      "formatted_start": "04:29:25.480",
      "formatted_end": "04:29:27.800",
      "text": "حالا حقیقتش من تالا ترمین اجتماعی نمیدونم چی جایید"
    },
    {
      "id": 96,
      "start": 16167.8,
      "end": 16170.1,
      "formatted_start": "04:29:27.800",
      "formatted_end": "04:29:30.100",
      "text": "تالا رو دوری نمیدونی باید تلفنی بیده"
    },
    {
      "id": 97,
      "start": 16170.1,
      "end": 16172.06,
      "formatted_start": "04:29:30.100",
      "formatted_end": "04:29:32.060",
      "text": "تلفنی؟ خب پس همونطوری بگیری"
    },
    {
      "id": 98,
      "start": 16172.06,
      "end": 16174.06,
      "formatted_start": "04:29:32.060",
      "formatted_end": "04:29:34.060",
      "text": "چون میتونم هر وقت اونجا میشینه سوابا"
    },
    {
      "id": 99,
      "start": 16174.06,
      "end": 16175.06,
      "formatted_start": "04:29:34.060",
      "formatted_end": "04:29:35.060",
      "text": "هر وقت میشینه"
