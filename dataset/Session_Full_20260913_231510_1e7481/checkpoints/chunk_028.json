  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8402.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:02.000",
      "text": "باید بردارید که باید بردارید."
    },
    {
      "id": 1,
      "start": 8430.0,
      "end": 8460.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:21:00.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 2,
      "start": 8460.0,
      "end": 8466.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:06.000",
      "text": "اگر بیمار داری تکمیلی من خصوصی کار می کنم"
    },
    {
      "id": 3,
      "start": 8466.0,
      "end": 8472.0,
      "formatted_start": "02:21:06.000",
      "formatted_end": "02:21:12.000",
      "text": "اگر هیچی نداشته باشه دولتی که من برام چی ندارم"
    },
    {
      "id": 4,
      "start": 8472.0,
      "end": 8478.0,
      "formatted_start": "02:21:12.000",
      "formatted_end": "02:21:18.000",
      "text": "ولی اگر یک مریضی نداشته باشه دولتی برام برام شادی رو بدم"
    },
    {
      "id": 5,
      "start": 8478.0,
      "end": 8480.0,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:20.000",
      "text": "مادرم از درم"
    },
    {
      "id": 6,
      "start": 8480.0,
      "end": 8484.0,
      "formatted_start": "02:21:20.000",
      "formatted_end": "02:21:24.000",
      "text": "حالا انشاله به اینجاها نخورم"
    },
    {
      "id": 7,
      "start": 8484.0,
      "end": 8488.0,
      "formatted_start": "02:21:24.000",
      "formatted_end": "02:21:28.000",
      "text": "چون ما دارو تا اینجاها رو شروع می کنم"
    },
    {
      "id": 8,
      "start": 8488.0,
      "end": 8491.34,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:31.340",
      "text": "تنها چیزی که بهت گفتم دو تا عرضه داره که ما میترسیم"
    },
    {
      "id": 9,
      "start": 8491.34,
      "end": 8494.86,
      "formatted_start": "02:21:31.340",
      "formatted_end": "02:21:34.860",
      "text": "یکی اینکه مغزو درگیر کنه که اگه دیدی خیلی بیقراری"
    },
    {
      "id": 10,
      "start": 8494.86,
      "end": 8497.18,
      "formatted_start": "02:21:34.860",
      "formatted_end": "02:21:37.180",
      "text": "زرهرد شدید ترید استفراق کنید"
    },
    {
      "id": 11,
      "start": 8497.18,
      "end": 8498.5,
      "formatted_start": "02:21:37.180",
      "formatted_end": "02:21:38.500",
      "text": "که خیلی هم نادره"
    },
    {
      "id": 12,
      "start": 8498.5,
      "end": 8501.0,
      "formatted_start": "02:21:38.500",
      "formatted_end": "02:21:41.000",
      "text": "اعتماد انشانه اینجور چیزی هم پیش نشد"
    },
    {
      "id": 13,
      "start": 8501.0,
      "end": 8502.18,
      "formatted_start": "02:21:41.000",
      "formatted_end": "02:21:42.180",
      "text": "بعد"
    },
    {
      "id": 14,
      "start": 8502.18,
      "end": 8505.9,
      "formatted_start": "02:21:42.180",
      "formatted_end": "02:21:45.900",
      "text": "همین ها چیز دیگه نگرنه"
    },
    {
      "id": 15,
      "start": 8505.9,
      "end": 8508.0,
      "formatted_start": "02:21:45.900",
      "formatted_end": "02:21:48.000",
      "text": "یکی هم ریادی که ما رو اینو اداره میده"
    },
    {
      "id": 16,
      "start": 8508.0,
      "end": 8512.18,
      "formatted_start": "02:21:48.000",
      "formatted_end": "02:21:52.180",
      "text": "استراحت کن آب و مایات خان و فرابون"
    },
    {
      "id": 17,
      "start": 8512.18,
      "end": 8513.72,
      "formatted_start": "02:21:52.180",
      "formatted_end": "02:21:53.720",
      "text": "هندونه گرد اگر بهش بده"
    },
    {
      "id": 18,
      "start": 8513.72,
      "end": 8515.72,
      "formatted_start": "02:21:53.720",
      "formatted_end": "02:21:55.720",
      "text": "این روند سرعت یک چاله نماشه"
    },
    {
      "id": 19,
      "start": 8515.72,
      "end": 8517.72,
      "formatted_start": "02:21:55.720",
      "formatted_end": "02:21:57.720",
      "text": "این روند فرابون بهش بده"
    },
    {
      "id": 20,
      "start": 8521.72,
      "end": 8523.72,
      "formatted_start": "02:22:01.720",
      "formatted_end": "02:22:03.720",
      "text": "باید چرا هم که یه اتاق در از بچه ها جدا باشه"
    },
    {
      "id": 21,
      "start": 8523.72,
      "end": 8525.72,
      "formatted_start": "02:22:03.720",
      "formatted_end": "02:22:05.720",
      "text": "پنجره اتاقت هم واضح باشه"
    },
    {
      "id": 22,
      "start": 8525.72,
      "end": 8527.72,
      "formatted_start": "02:22:05.720",
      "formatted_end": "02:22:07.720",
      "text": "هلو"
    },
    {
      "id": 23,
      "start": 8527.72,
      "end": 8529.72,
      "formatted_start": "02:22:07.720",
      "formatted_end": "02:22:09.720",
      "text": "هلو"
    },
    {
      "id": 24,
      "start": 8529.72,
      "end": 8531.72,
      "formatted_start": "02:22:09.720",
      "formatted_end": "02:22:11.720",
      "text": "هلو سرعت زبرای"
    },
    {
      "id": 25,
      "start": 8533.72,
      "end": 8535.72,
      "formatted_start": "02:22:13.720",
      "formatted_end": "02:22:15.720",
      "text": "سرعتی من دکتره هست"
    },
    {
      "id": 26,
      "start": 8535.72,
      "end": 8537.72,
      "formatted_start": "02:22:15.720",
      "formatted_end": "02:22:17.720",
      "text": "تو برای تو توزنگ میده"
    },
    {
      "id": 27,
      "start": 8537.72,
      "end": 8539.72,
      "formatted_start": "02:22:17.720",
      "formatted_end": "02:22:19.720",
      "text": "دکتره هم پا توزنگ میده دارم"
    },
    {
      "id": 28,
      "start": 8539.72,
      "end": 8541.72,
      "formatted_start": "02:22:19.720",
      "formatted_end": "02:22:21.720",
      "text": "شمارتون رو به منشی داده"
    },
    {
      "id": 29,
      "start": 8541.72,
      "end": 8543.72,
      "formatted_start": "02:22:21.720",
      "formatted_end": "02:22:23.720",
      "text": "شماره تون رو درمونشی دادی؟"
    },
    {
      "id": 30,
      "start": 8543.72,
      "end": 8544.72,
      "formatted_start": "02:22:23.720",
      "formatted_end": "02:22:24.720",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 8544.72,
      "end": 8545.72,
      "formatted_start": "02:22:24.720",
      "formatted_end": "02:22:25.720",
      "text": "ما؟"
    },
    {
      "id": 32,
      "start": 8545.72,
      "end": 8547.72,
      "formatted_start": "02:22:25.720",
      "formatted_end": "02:22:27.720",
      "text": "شماره تون رو درمونشی بدی؟"
    },
    {
      "id": 33,
      "start": 8547.72,
      "end": 8548.72,
      "formatted_start": "02:22:27.720",
      "formatted_end": "02:22:28.720",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 8549.72,
      "end": 8551.72,
      "formatted_start": "02:22:29.720",
      "formatted_end": "02:22:31.720",
      "text": "ببینیم که موکن بهت زنگ و زنگ شده باشه"
    },
    {
      "id": 35,
      "start": 8551.72,
      "end": 8553.72,
      "formatted_start": "02:22:31.720",
      "formatted_end": "02:22:33.720",
      "text": "نه، نه، گوما نیم"
    },
    {
      "id": 36,
      "start": 8553.72,
      "end": 8555.72,
      "formatted_start": "02:22:33.720",
      "formatted_end": "02:22:35.720",
      "text": "صرف از یه هاتون زنگ برده؟"
    },
    {
      "id": 37,
      "start": 8555.72,
      "end": 8557.72,
      "formatted_start": "02:22:35.720",
      "formatted_end": "02:22:37.720",
      "text": "نه، بله، چند ها برده"
    },
    {
      "id": 38,
      "start": 8558.72,
      "end": 8561.72,
      "formatted_start": "02:22:38.720",
      "formatted_end": "02:22:41.720",
      "text": "بابا دور برکه کجاینی چیست؟"
    },
    {
      "id": 39,
      "start": 8561.72,
      "end": 8563.72,
      "formatted_start": "02:22:41.720",
      "formatted_end": "02:22:43.720",
      "text": "تایی کجاوین؟"
    },
    {
      "id": 40,
      "start": 8565.72,
      "end": 8567.72,
      "formatted_start": "02:22:45.720",
      "formatted_end": "02:22:47.720",
      "text": "خب من تا وقت دارم"
    },
    {
      "id": 41,
      "start": 8568.72,
      "end": 8570.72,
      "formatted_start": "02:22:48.720",
      "formatted_end": "02:22:50.720",
      "text": "چی تا وقت دارم اگه تا بیا؟"
    },
    {
      "id": 42,
      "start": 8571.72,
      "end": 8573.72,
      "formatted_start": "02:22:51.720",
      "formatted_end": "02:22:53.720",
      "text": "براش بگو"
    },
    {
      "id": 43,
      "start": 8573.72,
      "end": 8575.72,
      "formatted_start": "02:22:53.720",
      "formatted_end": "02:22:55.720",
      "text": "نه من از شهر از شهر"
    },
    {
      "id": 44,
      "start": 8575.72,
      "end": 8577.72,
      "formatted_start": "02:22:55.720",
      "formatted_end": "02:22:57.720",
      "text": "براش بگو"
    },
    {
      "id": 45,
      "start": 8577.72,
      "end": 8579.72,
      "formatted_start": "02:22:57.720",
      "formatted_end": "02:22:59.720",
      "text": "براش بگو"
    },
    {
      "id": 46,
      "start": 8579.72,
      "end": 8581.72,
      "formatted_start": "02:22:59.720",
      "formatted_end": "02:23:01.720",
      "text": "چی که چی داری؟"
    },
    {
      "id": 47,
      "start": 8581.72,
      "end": 8583.72,
      "formatted_start": "02:23:01.720",
      "formatted_end": "02:23:03.720",
      "text": "چی که من درکسی دارم؟"
    },
    {
      "id": 48,
      "start": 8583.72,
      "end": 8585.72,
      "formatted_start": "02:23:03.720",
      "formatted_end": "02:23:05.720",
      "text": "نه نه هرچی هم"
    },
    {
      "id": 49,
      "start": 8585.72,
      "end": 8587.72,
      "formatted_start": "02:23:05.720",
      "formatted_end": "02:23:07.720",
      "text": "براش بگو"
    },
    {
      "id": 50,
      "start": 8589.72,
      "end": 8591.72,
      "formatted_start": "02:23:09.720",
      "formatted_end": "02:23:11.720",
      "text": "یه ماز دارد دیده رو خونه بگیری"
    },
    {
      "id": 51,
      "start": 8591.72,
      "end": 8593.72,
      "formatted_start": "02:23:11.720",
      "formatted_end": "02:23:13.720",
      "text": "خب انتخابه چون تنفسی هست"
    },
    {
      "id": 52,
      "start": 8593.72,
      "end": 8595.72,
      "formatted_start": "02:23:13.720",
      "formatted_end": "02:23:15.720",
      "text": "بیشتر تنفسی هست"
    },
    {
      "id": 53,
      "start": 8595.72,
      "end": 8597.72,
      "formatted_start": "02:23:15.720",
      "formatted_end": "02:23:17.720",
      "text": "هرچکن همه از این کاری"
    },
    {
      "id": 54,
      "start": 8597.72,
      "end": 8599.72,
      "formatted_start": "02:23:17.720",
      "formatted_end": "02:23:19.720",
      "text": "چون سرمو تونه هم بزن"
    },
    {
      "id": 55,
      "start": 8599.72,
      "end": 8601.72,
      "formatted_start": "02:23:19.720",
      "formatted_end": "02:23:21.720",
      "text": "برنامه بزن"
    },
    {
      "id": 56,
      "start": 8603.72,
      "end": 8605.72,
      "formatted_start": "02:23:23.720",
      "formatted_end": "02:23:25.720",
      "text": "سرمونی دهید بوده همه"
    },
    {
      "id": 57,
      "start": 8605.72,
      "end": 8607.72,
      "formatted_start": "02:23:25.720",
      "formatted_end": "02:23:27.720",
      "text": "آره همه بیرونه تکیه بزنیم"
    },
    {
      "id": 58,
      "start": 8607.72,
      "end": 8609.72,
      "formatted_start": "02:23:27.720",
      "formatted_end": "02:23:29.720",
      "text": "این آن پول زده احساسیت هم داره"
    },
    {
      "id": 59,
      "start": 8609.72,
      "end": 8611.72,
      "formatted_start": "02:23:29.720",
      "formatted_end": "02:23:31.720",
      "text": "بزنیم"
    },
    {
      "id": 60,
      "start": 8611.72,
      "end": 8613.72,
      "formatted_start": "02:23:31.720",
      "formatted_end": "02:23:33.720",
      "text": "یه منیت"
    },
    {
      "id": 61,
      "start": 8617.72,
      "end": 8621.72,
      "formatted_start": "02:23:37.720",
      "formatted_end": "02:23:41.720",
      "text": "اگه خود نکردید تا شمبه در وقت ترمی شد"
    },
    {
      "id": 62,
      "start": 8623.72,
      "end": 8625.72,
      "formatted_start": "02:23:43.720",
      "formatted_end": "02:23:45.720",
      "text": "سی تیزکن ویدئو های اینجام میدید"
    },
    {
      "id": 63,
      "start": 8625.72,
      "end": 8627.72,
      "formatted_start": "02:23:45.720",
      "formatted_end": "02:23:47.720",
      "text": "و از اینها هم نوشتم"
    },
    {
      "id": 64,
      "start": 8627.72,
      "end": 8630.24,
      "formatted_start": "02:23:47.720",
      "formatted_end": "02:23:50.240",
      "text": "این اوبهانت توی خونانش رو میده"
    },
    {
      "id": 65,
      "start": 8630.24,
      "end": 8632.76,
      "formatted_start": "02:23:50.240",
      "formatted_end": "02:23:52.760",
      "text": "غیر ناشتاست"
    },
    {
      "id": 66,
      "start": 8632.76,
      "end": 8633.74,
      "formatted_start": "02:23:52.760",
      "formatted_end": "02:23:53.740",
      "text": "انجام میدی"
    },
    {
      "id": 67,
      "start": 8633.74,
      "end": 8635.32,
      "formatted_start": "02:23:53.740",
      "formatted_end": "02:23:55.320",
      "text": "توشنبه صبح"
    },
    {
      "id": 68,
      "start": 8635.32,
      "end": 8636.46,
      "formatted_start": "02:23:55.320",
      "formatted_end": "02:23:56.460",
      "text": "جاوش رو میاری بینم"
    },
    {
      "id": 69,
      "start": 8636.46,
      "end": 8637.26,
      "formatted_start": "02:23:56.460",
      "formatted_end": "02:23:57.260",
      "text": "و سری میخواد"
    },
    {
      "id": 70,
      "start": 8637.26,
      "end": 8640.3,
      "formatted_start": "02:23:57.260",
      "formatted_end": "02:24:00.300",
      "text": "انا انشاءالله بکنم همه چی خوب باشه"
    },
    {
      "id": 71,
      "start": 8640.3,
      "end": 8641.64,
      "formatted_start": "02:24:00.300",
      "formatted_end": "02:24:01.640",
      "text": "و مشکل که تا نه"
    },
    {
      "id": 72,
      "start": 8641.64,
      "end": 8643.84,
      "formatted_start": "02:24:01.640",
      "formatted_end": "02:24:03.840",
      "text": "این کاده تو کنم نکنم"
    },
    {
      "id": 73,
      "start": 8643.84,
      "end": 8646.02,
      "formatted_start": "02:24:03.840",
      "formatted_end": "02:24:06.020",
      "text": "از سیتی آزمایش دارو همه نشتن"
    },
    {
      "id": 74,
      "start": 8646.02,
      "end": 8649.68,
      "formatted_start": "02:24:06.020",
      "formatted_end": "02:24:09.680",
      "text": "نه اونا ممکن آزمایش بگیرن"
    },
    {
      "id": 75,
      "start": 8649.68,
      "end": 8651.12,
      "formatted_start": "02:24:09.680",
      "formatted_end": "02:24:11.120",
      "text": "ممکنه فقط بگیره کنن"
    },
    {
      "id": 76,
      "start": 8651.12,
      "end": 8653.34,
      "formatted_start": "02:24:11.120",
      "formatted_end": "02:24:13.340",
      "text": "و سیتی بکنش نشتن"
    },
    {
      "id": 77,
      "start": 8653.34,
      "end": 8654.86,
      "formatted_start": "02:24:13.340",
      "formatted_end": "02:24:14.860",
      "text": "درسته باید شما است"
    },
    {
      "id": 78,
      "start": 8654.86,
      "end": 8656.44,
      "formatted_start": "02:24:14.860",
      "formatted_end": "02:24:16.440",
      "text": "کجا بود؟"
    },
    {
      "id": 79,
      "start": 8656.44,
      "end": 8661.44,
      "formatted_start": "02:24:16.440",
      "formatted_end": "02:24:21.440",
      "text": "همونه درست داریم. اونو عکس بگیر چون لازم داریم. این سیتی آزمایشت همه چی با همونه"
    },
    {
      "id": 80,
      "start": 8661.44,
      "end": 8662.44,
      "formatted_start": "02:24:21.440",
      "formatted_end": "02:24:22.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 81,
      "start": 8662.44,
      "end": 8663.44,
      "formatted_start": "02:24:22.440",
      "formatted_end": "02:24:23.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 82,
      "start": 8663.44,
      "end": 8664.44,
      "formatted_start": "02:24:23.440",
      "formatted_end": "02:24:24.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 83,
      "start": 8664.44,
      "end": 8665.44,
      "formatted_start": "02:24:24.440",
      "formatted_end": "02:24:25.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 84,
      "start": 8665.44,
      "end": 8666.44,
      "formatted_start": "02:24:25.440",
      "formatted_end": "02:24:26.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 85,
      "start": 8666.44,
      "end": 8667.44,
      "formatted_start": "02:24:26.440",
      "formatted_end": "02:24:27.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 86,
      "start": 8667.44,
      "end": 8668.44,
      "formatted_start": "02:24:27.440",
      "formatted_end": "02:24:28.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 87,
      "start": 8668.44,
      "end": 8669.44,
      "formatted_start": "02:24:28.440",
      "formatted_end": "02:24:29.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 88,
      "start": 8669.44,
      "end": 8670.44,
      "formatted_start": "02:24:29.440",
      "formatted_end": "02:24:30.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 89,
      "start": 8670.44,
      "end": 8671.44,
      "formatted_start": "02:24:30.440",
      "formatted_end": "02:24:31.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 90,
      "start": 8671.44,
      "end": 8672.44,
      "formatted_start": "02:24:31.440",
      "formatted_end": "02:24:32.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 91,
      "start": 8672.44,
      "end": 8673.44,
      "formatted_start": "02:24:32.440",
      "formatted_end": "02:24:33.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 92,
      "start": 8673.44,
      "end": 8674.44,
      "formatted_start": "02:24:33.440",
      "formatted_end": "02:24:34.440",
      "text": "چی خواهید بود؟"
    },
    {
      "id": 93,
      "start": 8674.44,
      "end": 8676.44,
      "formatted_start": "02:24:34.440",
      "formatted_end": "02:24:36.440",
      "text": "اینجا چند تا الافتون همه یه جشن شده گرده"
    },
    {
      "id": 94,
      "start": 8678.44,
      "end": 8682.44,
      "formatted_start": "02:24:38.440",
      "formatted_end": "02:24:42.440",
      "text": "حالا به حقیقتش باید ببینم دیگه آزمایش اجار بده ببینم مفهومتش چجوریه"
    },
    {
      "id": 95,
      "start": 8682.44,
      "end": 8684.44,
      "formatted_start": "02:24:42.440",
      "formatted_end": "02:24:44.440",
      "text": "بعد توضیحاتش بردم"
    },
    {
      "id": 96,
      "start": 8684.44,
      "end": 8686.44,
      "formatted_start": "02:24:44.440",
      "formatted_end": "02:24:46.440",
      "text": "آنطور اشاره باید"
    },
    {
      "id": 97,
      "start": 8692.44,
