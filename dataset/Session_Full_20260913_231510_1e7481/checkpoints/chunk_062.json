    },
    {
      "id": 18,
      "start": 18698.88,
      "end": 18700.88,
      "formatted_start": "05:11:38.880",
      "formatted_end": "05:11:40.880",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 19,
      "start": 18700.88,
      "end": 18702.88,
      "formatted_start": "05:11:40.880",
      "formatted_end": "05:11:42.880",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 20,
      "start": 18702.88,
      "end": 18704.88,
      "formatted_start": "05:11:42.880",
      "formatted_end": "05:11:44.880",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 21,
      "start": 18706.88,
      "end": 18710.88,
      "formatted_start": "05:11:46.880",
      "formatted_end": "05:11:50.880",
      "text": "من اینجا برن. سایه صبح هم رفته رنگی و من اینجا برم."
    },
    {
      "id": 22,
      "start": 18710.88,
      "end": 18711.88,
      "formatted_start": "05:11:50.880",
      "formatted_end": "05:11:51.880",
      "text": "این یه هفته."
    },
    {
      "id": 23,
      "start": 18711.88,
      "end": 18713.88,
      "formatted_start": "05:11:51.880",
      "formatted_end": "05:11:53.880",
      "text": "سایه صبح نمیخوند بچه بیادون نه؟"
    },
    {
      "id": 24,
      "start": 18715.88,
      "end": 18716.88,
      "formatted_start": "05:11:55.880",
      "formatted_end": "05:11:56.880",
      "text": "پیلا میگرده."
    },
    {
      "id": 25,
      "start": 18716.88,
      "end": 18718.88,
      "formatted_start": "05:11:56.880",
      "formatted_end": "05:11:58.880",
      "text": "نه درست باشه."
    },
    {
      "id": 26,
      "start": 18719.88,
      "end": 18721.88,
      "formatted_start": "05:11:59.880",
      "formatted_end": "05:12:01.880",
      "text": "صبح هم نمیدونی باید جنب برن؟"
    },
    {
      "id": 27,
      "start": 18721.88,
      "end": 18723.88,
      "formatted_start": "05:12:01.880",
      "formatted_end": "05:12:03.880",
      "text": "برنشونم جنب برم."
    },
    {
      "id": 28,
      "start": 18723.88,
      "end": 18725.88,
      "formatted_start": "05:12:03.880",
      "formatted_end": "05:12:05.880",
      "text": "اون وقت هر چی میدون؟"
    },
    {
      "id": 29,
      "start": 18725.88,
      "end": 18728.88,
      "formatted_start": "05:12:05.880",
      "formatted_end": "05:12:08.880",
      "text": "کفتر پیشمان باز کردن که میشه شرکت رو بزرگ شد."
    },
    {
      "id": 30,
      "start": 18728.88,
      "end": 18730.88,
      "formatted_start": "05:12:08.880",
      "formatted_end": "05:12:10.880",
      "text": "آساله هم اونجوره؟"
    },
    {
      "id": 31,
      "start": 18730.88,
      "end": 18731.88,
      "formatted_start": "05:12:10.880",
      "formatted_end": "05:12:11.880",
      "text": "نه آساله هست."
    },
    {
      "id": 32,
      "start": 18731.88,
      "end": 18734.88,
      "formatted_start": "05:12:11.880",
      "formatted_end": "05:12:14.880",
      "text": "از صبح مدرسه باز بشی تو باز میمدرسی؟"
    },
    {
      "id": 33,
      "start": 18734.88,
      "end": 18735.88,
      "formatted_start": "05:12:14.880",
      "formatted_end": "05:12:15.880",
      "text": "نه نه نه"
    },
    {
      "id": 34,
      "start": 18735.88,
      "end": 18736.88,
      "formatted_start": "05:12:15.880",
      "formatted_end": "05:12:16.880",
      "text": "نه نه بگی؟"
    },
    {
      "id": 35,
      "start": 18736.88,
      "end": 18737.88,
      "formatted_start": "05:12:16.880",
      "formatted_end": "05:12:17.880",
      "text": "اوه نه زشتیم"
    },
    {
      "id": 36,
      "start": 18737.88,
      "end": 18740.88,
      "formatted_start": "05:12:17.880",
      "formatted_end": "05:12:20.880",
      "text": "نه مدرسه هم دیگه بهت بگو و اینو اون رو میرفتی کن"
    },
    {
      "id": 37,
      "start": 18740.88,
      "end": 18743.88,
      "formatted_start": "05:12:20.880",
      "formatted_end": "05:12:23.880",
      "text": "آره میرفتم و از این چند و شیشت و هفت رو هم برم داریم"
    },
    {
      "id": 38,
      "start": 18743.88,
      "end": 18748.88,
      "formatted_start": "05:12:23.880",
      "formatted_end": "05:12:28.880",
      "text": "بابا میخو من در اینجا امداد جا درخواهده هر وقت نیخواد نینای هم برای"
    },
    {
      "id": 39,
      "start": 18748.88,
      "end": 18751.88,
      "formatted_start": "05:12:28.880",
      "formatted_end": "05:12:31.880",
      "text": "محلون داشته باشی برنامه میزی مثلا با زرسا"
    },
    {
      "id": 40,
      "start": 18751.88,
      "end": 18753.88,
      "formatted_start": "05:12:31.880",
      "formatted_end": "05:12:33.880",
      "text": "میگی من نیمیم جا به جا بشی"
    },
    {
      "id": 41,
      "start": 18753.88,
      "end": 18755.88,
      "formatted_start": "05:12:33.880",
      "formatted_end": "05:12:35.880",
      "text": "باید برزون میشیم"
    },
    {
      "id": 42,
      "start": 18755.88,
      "end": 18757.88,
      "formatted_start": "05:12:35.880",
      "formatted_end": "05:12:37.880",
      "text": "اما خودش برگرد میشه"
    },
    {
      "id": 43,
      "start": 18757.88,
      "end": 18759.88,
      "formatted_start": "05:12:37.880",
      "formatted_end": "05:12:39.880",
      "text": "خودتان عروض دارن همه هستی؟"
    },
    {
      "id": 44,
      "start": 18759.88,
      "end": 18761.88,
      "formatted_start": "05:12:39.880",
      "formatted_end": "05:12:41.880",
      "text": "نه اینکه خب"
    },
    {
      "id": 45,
      "start": 18761.88,
      "end": 18763.88,
      "formatted_start": "05:12:41.880",
      "formatted_end": "05:12:43.880",
      "text": "طبقیر گریه گرسو داشت"
    },
    {
      "id": 46,
      "start": 18763.88,
      "end": 18765.88,
      "formatted_start": "05:12:43.880",
      "formatted_end": "05:12:45.880",
      "text": "اما دیوز باید برگرد خوب خور داشت"
    },
    {
      "id": 47,
      "start": 18765.88,
      "end": 18767.88,
      "formatted_start": "05:12:45.880",
      "formatted_end": "05:12:47.880",
      "text": "این خب درخواست من رو زهرسته"
    },
    {
      "id": 48,
      "start": 18767.88,
      "end": 18797.86,
      "formatted_start": "05:12:47.880",
      "formatted_end": "05:13:17.860",
      "text": "از اینجا باید بردارید که اینجا باید بردارید."
    },
    {
      "id": 49,
      "start": 18797.88,
      "end": 18815.88,
      "formatted_start": "05:13:17.880",
      "formatted_end": "05:13:35.880",
      "text": "موسیقی"
    },
    {
      "id": 50,
      "start": 18815.88,
      "end": 18817.88,
      "formatted_start": "05:13:35.880",
      "formatted_end": "05:13:37.880",
      "text": "این اطلاعیش خودم من خود"
    },
    {
      "id": 51,
      "start": 18817.88,
      "end": 18822.88,
      "formatted_start": "05:13:37.880",
      "formatted_end": "05:13:42.880",
      "text": "این اطلاعیش من تغذیر کردم و اینکه رفتارون کردم به بارداری خود"
    },
    {
      "id": 52,
      "start": 18822.88,
      "end": 18827.88,
      "formatted_start": "05:13:42.880",
      "formatted_end": "05:13:47.880",
      "text": "بگی خب توی سه ماه نشد و به تحت نظر خوام دکتر احمدی بودم برگاهت"
    },
    {
      "id": 53,
      "start": 18827.88,
      "end": 18831.88,
      "formatted_start": "05:13:47.880",
      "formatted_end": "05:13:51.880",
      "text": "حتی پبل اینکه دکترها باردار بشن چون مشکل نرداری داشتیم"
    },
    {
      "id": 54,
      "start": 18831.88,
      "end": 18834.88,
      "formatted_start": "05:13:51.880",
      "formatted_end": "05:13:54.880",
      "text": "بعد دو بار آیویف کردم که نشد"
    },
    {
      "id": 55,
      "start": 18834.88,
      "end": 18839.88,
      "formatted_start": "05:13:54.880",
      "formatted_end": "05:13:59.880",
      "text": "بعد بچه اولم آیویف کردم نشد"
    },
    {
      "id": 56,
      "start": 18839.88,
      "end": 18843.88,
      "formatted_start": "05:13:59.880",
      "formatted_end": "05:14:03.880",
      "text": "بعد دقیقا انگار اسفن که آیویف کردم من پیش شد"
    },
    {
      "id": 57,
      "start": 18843.88,
      "end": 18848.88,
      "formatted_start": "05:14:03.880",
      "formatted_end": "05:14:08.880",
      "text": "من تو اردویش متوجه شدم که طبیعی باردارم یعنی بیگی کلیم بفیال شده بودم"
    },
    {
      "id": 58,
      "start": 18848.88,
      "end": 18851.88,
      "formatted_start": "05:14:08.880",
      "formatted_end": "05:14:11.880",
      "text": "من بلش کنم دیگه چون عروسی آفجی من بود دردی نبودم زیاد"
    },
    {
      "id": 59,
      "start": 18851.88,
      "end": 18857.88,
      "formatted_start": "05:14:11.880",
      "formatted_end": "05:14:17.880",
      "text": "بعد الان دیگه چند ماهیه که گفتیم حالا مثلا چون اونو هیچ سال طول کشید باردار شدیم"
    },
    {
      "id": 60,
      "start": 18857.88,
      "end": 18863.88,
      "formatted_start": "05:14:17.880",
      "formatted_end": "05:14:23.880",
      "text": "مشخصیست دیگه تبایی دو سه ماه، سه ماه چهار ماه میشه که امدام کردم نشد"
    },
    {
      "id": 61,
      "start": 18863.88,
      "end": 18867.88,
      "formatted_start": "05:14:23.880",
      "formatted_end": "05:14:27.880",
      "text": "تا ماه پیش آزمایشم چیز شد"
    },
    {
      "id": 62,
      "start": 18867.88,
      "end": 18870.88,
      "formatted_start": "05:14:27.880",
      "formatted_end": "05:14:30.880",
      "text": "عدد بفرش 19 شد خب"
    },
    {
      "id": 63,
      "start": 18870.88,
      "end": 18873.88,
      "formatted_start": "05:14:30.880",
      "formatted_end": "05:14:33.880",
      "text": "بعد مجربت... چهار روز بعد 19 بود؟"
    },
    {
      "id": 64,
      "start": 18873.88,
      "end": 18875.88,
      "formatted_start": "05:14:33.880",
      "formatted_end": "05:14:35.880",
      "text": "چهار روز بعدش 19 بود خب"
    },
    {
      "id": 65,
      "start": 18875.88,
      "end": 18880.88,
      "formatted_start": "05:14:35.880",
      "formatted_end": "05:14:40.880",
      "text": "بعد که دیدم که 19 گفتم خب مجربت آزمایش بدن"
    },
    {
      "id": 66,
      "start": 18880.88,
      "end": 18884.88,
      "formatted_start": "05:14:40.880",
      "formatted_end": "05:14:44.880",
      "text": "بعد دیدم قبلا یه روز بعد از آزمایشم تریال شد"
    },
    {
      "id": 67,
      "start": 18884.88,
      "end": 18888.88,
      "formatted_start": "05:14:44.880",
      "formatted_end": "05:14:48.880",
      "text": "بعد دیگه پیش دکتر احمدی که میرم"
    },
    {
      "id": 68,
      "start": 18888.88,
      "end": 18893.88,
      "formatted_start": "05:14:48.880",
      "formatted_end": "05:14:53.880",
      "text": "یه آزمایش کامل برامون میشه بود که چربیت بالا است"
    },
    {
      "id": 69,
      "start": 18893.88,
      "end": 18897.88,
      "formatted_start": "05:14:53.880",
      "formatted_end": "05:14:57.880",
      "text": "خب دکتر داخلی حتما برم"
    },
    {
      "id": 70,
      "start": 18897.88,
      "end": 18898.88,
      "formatted_start": "05:14:57.880",
      "formatted_end": "05:14:58.880",
      "text": "خب خیلی برم"
    },
    {
      "id": 71,
      "start": 18898.88,
      "end": 18899.88,
      "formatted_start": "05:14:58.880",
      "formatted_end": "05:14:59.880",
      "text": "بالا همینه"
    }
  ],
  "status": "completed"
}