    {
      "id": 5,
      "start": 10510.0,
      "end": 10512.0,
      "formatted_start": "02:55:10.000",
      "formatted_end": "02:55:12.000",
      "text": "از اینجا باید برگردیم و باید برگردیم."
    },
    {
      "id": 6,
      "start": 10512.0,
      "end": 10514.0,
      "formatted_start": "02:55:12.000",
      "formatted_end": "02:55:14.000",
      "text": "از اینجا باید برگردیم و باید برگردیم."
    },
    {
      "id": 7,
      "start": 10530.0,
      "end": 10560.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:56:00.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که ا"
    },
    {
      "id": 8,
      "start": 10560.0,
      "end": 10574.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:14.000",
      "text": "از اینجا هم درد میکنیم. هم برای کبد هم برای رحم هم کلی ها."
    },
    {
      "id": 9,
      "start": 10574.0,
      "end": 10580.0,
      "formatted_start": "02:56:14.000",
      "formatted_end": "02:56:20.000",
      "text": "میشه نداشتی من اون مادر از این هم خانم هست؟"
    },
    {
      "id": 10,
      "start": 10580.0,
      "end": 10588.0,
      "formatted_start": "02:56:20.000",
      "formatted_end": "02:56:28.000",
      "text": "خودتون رو شناختم. این خانمی بود که استرنگی میکرد. فاوند شما بود."
    },
    {
      "id": 11,
      "start": 10588.0,
      "end": 10590.0,
      "formatted_start": "02:56:28.000",
      "formatted_end": "02:56:30.000",
      "text": "حدی رو قید"
    },
    {
      "id": 12,
      "start": 10594.0,
      "end": 10596.0,
      "formatted_start": "02:56:34.000",
      "formatted_end": "02:56:36.000",
      "text": "نه نه خانم هم خواهد داره اینکه بیایی"
    },
    {
      "id": 13,
      "start": 10596.0,
      "end": 10598.0,
      "formatted_start": "02:56:36.000",
      "formatted_end": "02:56:38.000",
      "text": "برای دیدم"
    },
    {
      "id": 14,
      "start": 10598.0,
      "end": 10600.0,
      "formatted_start": "02:56:38.000",
      "formatted_end": "02:56:40.000",
      "text": "انشاءالله در خیلی"
    },
    {
      "id": 15,
      "start": 10600.0,
      "end": 10602.0,
      "formatted_start": "02:56:40.000",
      "formatted_end": "02:56:42.000",
      "text": "خوبه چون داریم"
    },
    {
      "id": 16,
      "start": 10604.0,
      "end": 10606.0,
      "formatted_start": "02:56:44.000",
      "formatted_end": "02:56:46.000",
      "text": "خب پس یه آسمانشی"
    },
    {
      "id": 17,
      "start": 10606.0,
      "end": 10608.0,
      "formatted_start": "02:56:46.000",
      "formatted_end": "02:56:48.000",
      "text": "آمل یه سومیگرافی کامل هم بگیرست"
    },
    {
      "id": 18,
      "start": 10608.0,
      "end": 10610.0,
      "formatted_start": "02:56:48.000",
      "formatted_end": "02:56:50.000",
      "text": "آره آره آسمانشی که منم"
    },
    {
      "id": 19,
      "start": 10610.0,
      "end": 10612.0,
      "formatted_start": "02:56:50.000",
      "formatted_end": "02:56:52.000",
      "text": "کامل چرمی قرن"
    },
    {
      "id": 20,
      "start": 10612.0,
      "end": 10614.0,
      "formatted_start": "02:56:52.000",
      "formatted_end": "02:56:54.000",
      "text": "مرسه یکامل هم کنیم"
    },
    {
      "id": 21,
      "start": 10614.0,
      "end": 10616.0,
      "formatted_start": "02:56:54.000",
      "formatted_end": "02:56:56.000",
      "text": "مرسه قرن هم بخوری"
    },
    {
      "id": 22,
      "start": 10616.0,
      "end": 10618.0,
      "formatted_start": "02:56:56.000",
      "formatted_end": "02:56:58.000",
      "text": "قانون نداره"
    },
    {
      "id": 23,
      "start": 10618.0,
      "end": 10620.0,
      "formatted_start": "02:56:58.000",
      "formatted_end": "02:57:00.000",
      "text": "اما قانونه"
    },
    {
      "id": 24,
      "start": 10620.0,
      "end": 10622.0,
      "formatted_start": "02:57:00.000",
      "formatted_end": "02:57:02.000",
      "text": "آدی میشدی"
    },
    {
      "id": 25,
      "start": 10622.0,
      "end": 10624.0,
      "formatted_start": "02:57:02.000",
      "formatted_end": "02:57:04.000",
      "text": "برای قانون میدونی"
    },
    {
      "id": 26,
      "start": 10624.0,
      "end": 10626.0,
      "formatted_start": "02:57:04.000",
      "formatted_end": "02:57:06.000",
      "text": "باشه"
    },
    {
      "id": 27,
      "start": 10626.0,
      "end": 10628.0,
      "formatted_start": "02:57:06.000",
      "formatted_end": "02:57:08.000",
      "text": "تنخوبی داشتم"
    },
    {
      "id": 28,
      "start": 10628.0,
      "end": 10630.0,
      "formatted_start": "02:57:08.000",
      "formatted_end": "02:57:10.000",
      "text": "چشم"
    },
    {
      "id": 29,
      "start": 10630.0,
      "end": 10632.0,
      "formatted_start": "02:57:10.000",
      "formatted_end": "02:57:12.000",
      "text": "دارو دادی من"
    },
    {
      "id": 30,
      "start": 10632.0,
      "end": 10634.0,
      "formatted_start": "02:57:12.000",
      "formatted_end": "02:57:14.000",
      "text": "اقل دارو هایتونو میخوری؟"
    },
    {
      "id": 31,
      "start": 10634.0,
      "end": 10636.0,
      "formatted_start": "02:57:14.000",
      "formatted_end": "02:57:16.000",
      "text": "تمام کردم"
    },
    {
      "id": 32,
      "start": 10636.0,
      "end": 10638.0,
      "formatted_start": "02:57:16.000",
      "formatted_end": "02:57:18.000",
      "text": "گفتم که باید دوارو بدم"
    },
    {
      "id": 33,
      "start": 10638.0,
      "end": 10640.0,
      "formatted_start": "02:57:18.000",
      "formatted_end": "02:57:20.000",
      "text": "ببینم چکنیم"
    },
    {
      "id": 34,
      "start": 10640.0,
      "end": 10642.0,
      "formatted_start": "02:57:20.000",
      "formatted_end": "02:57:22.000",
      "text": "چشم"
    },
    {
      "id": 35,
      "start": 10642.0,
      "end": 10644.0,
      "formatted_start": "02:57:22.000",
      "formatted_end": "02:57:24.000",
      "text": "درسته تردیم"
    },
    {
      "id": 36,
      "start": 10644.0,
      "end": 10646.0,
      "formatted_start": "02:57:24.000",
      "formatted_end": "02:57:26.000",
      "text": "خیلی ممنون"
    },
    {
      "id": 37,
      "start": 10646.0,
      "end": 10648.0,
      "formatted_start": "02:57:26.000",
      "formatted_end": "02:57:28.000",
      "text": "ناشته انشاله تشریف بگویی؟"
    },
    {
      "id": 38,
      "start": 10648.0,
      "end": 10650.0,
      "formatted_start": "02:57:28.000",
      "formatted_end": "02:57:30.000",
      "text": "هم سنو هم آزمایشتون"
    },
    {
      "id": 39,
      "start": 10650.0,
      "end": 10652.0,
      "formatted_start": "02:57:30.000",
      "formatted_end": "02:57:32.000",
      "text": "سنو منم ناشته هستم"
    },
    {
      "id": 40,
      "start": 10652.0,
      "end": 10654.0,
      "formatted_start": "02:57:32.000",
      "formatted_end": "02:57:34.000",
      "text": "باشه درست دردن میکنه؟"
    },
    {
      "id": 41,
      "start": 10654.0,
      "end": 10656.0,
      "formatted_start": "02:57:34.000",
      "formatted_end": "02:57:36.000",
      "text": "باید تون سنو مرد باشه"
    },
    {
      "id": 42,
      "start": 10656.0,
      "end": 10658.0,
      "formatted_start": "02:57:36.000",
      "formatted_end": "02:57:38.000",
      "text": "روماتیس منم نباشتی برای پاهمینه"
    },
    {
      "id": 43,
      "start": 10658.0,
      "end": 10660.0,
      "formatted_start": "02:57:38.000",
      "formatted_end": "02:57:40.000",
      "text": "دارو روماتیس میخوری؟"
    },
    {
      "id": 44,
      "start": 10660.0,
      "end": 10662.0,
      "formatted_start": "02:57:40.000",
      "formatted_end": "02:57:42.000",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 10662.0,
      "end": 10664.0,
      "formatted_start": "02:57:42.000",
      "formatted_end": "02:57:44.000",
      "text": "چون پاهمینه درد میکنه"
    },
    {
      "id": 46,
      "start": 10664.0,
      "end": 10666.0,
      "formatted_start": "02:57:44.000",
      "formatted_end": "02:57:46.000",
      "text": "باشه"
    },
    {
      "id": 47,
      "start": 10666.0,
      "end": 10668.0,
      "formatted_start": "02:57:46.000",
      "formatted_end": "02:57:48.000",
      "text": "دستان پاهمینه درد میکنه"
    },
    {
      "id": 48,
      "start": 10668.0,
      "end": 10670.0,
      "formatted_start": "02:57:48.000",
      "formatted_end": "02:57:50.000",
      "text": "چشمون اضافه امکان خواه میگرد"
    },
    {
      "id": 49,
      "start": 10670.0,
      "end": 10672.0,
      "formatted_start": "02:57:50.000",
      "formatted_end": "02:57:52.000",
      "text": "باشه درست درد نگرد نه"
    },
    {
      "id": 50,
      "start": 10672.0,
      "end": 10674.0,
      "formatted_start": "02:57:52.000",
      "formatted_end": "02:57:54.000",
      "text": "بگو نه، خداحال باشی"
    },
    {
      "id": 51,
      "start": 10702.0,
      "end": 10707.8,
      "formatted_start": "02:58:22.000",
      "formatted_end": "02:58:27.800",
      "text": "اصلا با ما کلان سپارشی لیچی بیمار دکتر فقط یاد ویزیت میکنه و آرام میده"
    },
    {
      "id": 52,
      "start": 10707.8,
      "end": 10710.1,
      "formatted_start": "02:58:27.800",
      "formatted_end": "02:58:30.100",
      "text": "با تلفون سپارشی شکر کرده"
    },
    {
      "id": 53,
      "start": 10710.1,
      "end": 10725.22,
      "formatted_start": "02:58:30.100",
      "formatted_end": "02:58:45.220",
      "text": "اصلا من کلان باید بیمار را ببینم و آرام میده"
    },
    {
      "id": 54,
      "start": 10725.22,
      "end": 10731.22,
      "formatted_start": "02:58:45.220",
      "formatted_end": "02:58:51.220",
      "text": "موسیقی"
    },
    {
      "id": 55,
      "start": 10755.22,
      "end": 10758.22,
      "formatted_start": "02:59:15.220",
      "formatted_end": "02:59:18.220",
      "text": "اون ترده رنگی چیزی به دو پناهی عشق دارد"
    },
    {
      "id": 56,
      "start": 10758.22,
      "end": 10761.22,
      "formatted_start": "02:59:18.220",
      "formatted_end": "02:59:21.220",
      "text": "همینجوری پنه مونده ای درنگ رو بازید"
    },
    {
      "id": 57,
      "start": 10785.22,
      "end": 10795.12,
      "formatted_start": "02:59:45.220",
      "formatted_end": "02:59:55.120",
      "text": "خواهم شفایی؟"
    },
    {
      "id": 58,
      "start": 10795.12,
      "end": 10797.22,
      "formatted_start": "02:59:55.120",
      "formatted_end": "02:59:57.220",
      "text": "خواهم شفایی؟"
    }
  ],
  "status": "completed"
}