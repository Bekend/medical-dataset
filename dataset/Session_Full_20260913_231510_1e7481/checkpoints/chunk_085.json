  "stt_segments": [
    {
      "id": 0,
      "start": 25500.0,
      "end": 25509.0,
      "formatted_start": "07:05:00.000",
      "formatted_end": "07:05:09.000",
      "text": "از شخصها چه چیزو بگم بهتون بگم به احمدی. من یه روز گفتم علی شوهر عطیه اومد اینجا فرمیش به احمدی بودم."
    },
    {
      "id": 1,
      "start": 25509.0,
      "end": 25514.0,
      "formatted_start": "07:05:09.000",
      "formatted_end": "07:05:14.000",
      "text": "علی گفتم فامیل احمد باید به احمدی ما داریم. میاد برون همشایی بیرچندی به احمدی بود."
    },
    {
      "id": 2,
      "start": 25514.0,
      "end": 25517.0,
      "formatted_start": "07:05:14.000",
      "formatted_end": "07:05:17.000",
      "text": "اخو با احمدی قد بلندگی. اونو تو سپر مارکت هم بود."
    },
    {
      "id": 3,
      "start": 25517.0,
      "end": 25521.0,
      "formatted_start": "07:05:17.000",
      "formatted_end": "07:05:21.000",
      "text": "پرس دیدم من اینجا گفتم خانواده تو خانواده میدونی که فامیل این با ما."
    },
    {
      "id": 4,
      "start": 25521.0,
      "end": 25524.66,
      "formatted_start": "07:05:21.000",
      "formatted_end": "07:05:24.660",
      "text": "که؟ چی گفت؟ دوست دادیتون دیگه؟"
    },
    {
      "id": 5,
      "start": 25524.66,
      "end": 25529.74,
      "formatted_start": "07:05:24.660",
      "formatted_end": "07:05:29.740",
      "text": "اوه، چقدر نرمید"
    },
    {
      "id": 6,
      "start": 25529.74,
      "end": 25537.0,
      "formatted_start": "07:05:29.740",
      "formatted_end": "07:05:37.000",
      "text": "گفتم خونه شون، گفته که دختر داری، دختر همه من اونجاست"
    },
    {
      "id": 7,
      "start": 25537.0,
      "end": 25539.0,
      "formatted_start": "07:05:37.000",
      "formatted_end": "07:05:39.000",
      "text": "گفتم بعد ما مریضه شون"
    },
    {
      "id": 8,
      "start": 25539.0,
      "end": 25545.0,
      "formatted_start": "07:05:39.000",
      "formatted_end": "07:05:45.000",
      "text": "بچه ها، برام گلو ببرم، ماریا پرباد میشه"
    },
    {
      "id": 9,
      "start": 25545.0,
      "end": 25547.0,
      "formatted_start": "07:05:45.000",
      "formatted_end": "07:05:47.000",
      "text": "بچه همینجا همش پرباد میشه"
    },
    {
      "id": 10,
      "start": 25547.0,
      "end": 25549.0,
      "formatted_start": "07:05:47.000",
      "formatted_end": "07:05:49.000",
      "text": "ناراحت میشه؟"
    },
    {
      "id": 11,
      "start": 25549.0,
      "end": 25551.0,
      "formatted_start": "07:05:49.000",
      "formatted_end": "07:05:51.000",
      "text": "باید بردک میشه"
    },
    {
      "id": 12,
      "start": 25551.0,
      "end": 25553.0,
      "formatted_start": "07:05:51.000",
      "formatted_end": "07:05:53.000",
      "text": "باید تو که را سیم بکنیم"
    },
    {
      "id": 13,
      "start": 25553.0,
      "end": 25555.0,
      "formatted_start": "07:05:53.000",
      "formatted_end": "07:05:55.000",
      "text": "نه بابا بود"
    },
    {
      "id": 14,
      "start": 25555.0,
      "end": 25557.0,
      "formatted_start": "07:05:55.000",
      "formatted_end": "07:05:57.000",
      "text": "میدونه نه"
    },
    {
      "id": 15,
      "start": 25557.0,
      "end": 25559.0,
      "formatted_start": "07:05:57.000",
      "formatted_end": "07:05:59.000",
      "text": "بابا میدونه که از اینجور بزنیم"
    },
    {
      "id": 16,
      "start": 25559.0,
      "end": 25561.0,
      "formatted_start": "07:05:59.000",
      "formatted_end": "07:06:01.000",
      "text": "تا اینجوری عریب بزنیم"
    },
    {
      "id": 17,
      "start": 25561.0,
      "end": 25563.0,
      "formatted_start": "07:06:01.000",
      "formatted_end": "07:06:03.000",
      "text": "این چرا بیست سالیه بوده"
    },
    {
      "id": 18,
      "start": 25563.0,
      "end": 25565.0,
      "formatted_start": "07:06:03.000",
      "formatted_end": "07:06:05.000",
      "text": "اینجوری عریب بزنیم"
    },
    {
      "id": 19,
      "start": 25565.0,
      "end": 25567.0,
      "formatted_start": "07:06:05.000",
      "formatted_end": "07:06:07.000",
      "text": "اینجوری عریب بزنیم"
    },
    {
      "id": 20,
      "start": 25567.0,
      "end": 25569.0,
      "formatted_start": "07:06:07.000",
      "formatted_end": "07:06:09.000",
      "text": "اینجوری عریب بزنیم"
    },
    {
      "id": 21,
      "start": 25569.0,
      "end": 25571.0,
      "formatted_start": "07:06:09.000",
      "formatted_end": "07:06:11.000",
      "text": "اینجوری عریب بزنیم"
    },
    {
      "id": 22,
      "start": 25571.0,
      "end": 25573.0,
      "formatted_start": "07:06:11.000",
