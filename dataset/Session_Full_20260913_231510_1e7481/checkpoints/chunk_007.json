  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2105.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:05.000",
      "text": "این رو باز کردی اینه. بو. کن کن راحت تر."
    },
    {
      "id": 1,
      "start": 2107.0,
      "end": 2110.0,
      "formatted_start": "00:35:07.000",
      "formatted_end": "00:35:10.000",
      "text": "خب راحت تر بیرونت تو همه شتیده."
    },
    {
      "id": 2,
      "start": 2111.0,
      "end": 2113.0,
      "formatted_start": "00:35:11.000",
      "formatted_end": "00:35:13.000",
      "text": "خب راحت تر قبول برن."
    },
    {
      "id": 3,
      "start": 2114.0,
      "end": 2115.0,
      "formatted_start": "00:35:14.000",
      "formatted_end": "00:35:15.000",
      "text": "خلاف کردی؟"
    },
    {
      "id": 4,
      "start": 2116.0,
      "end": 2118.0,
      "formatted_start": "00:35:16.000",
      "formatted_end": "00:35:18.000",
      "text": "از من کابل ستیل همه خواه کرد."
    },
    {
      "id": 5,
      "start": 2119.0,
      "end": 2120.0,
      "formatted_start": "00:35:19.000",
      "formatted_end": "00:35:20.000",
      "text": "بابا؟"
    },
    {
      "id": 6,
      "start": 2120.0,
      "end": 2121.0,
      "formatted_start": "00:35:20.000",
      "formatted_end": "00:35:21.000",
      "text": "آه های زدید اون طوری؟"
    },
    {
      "id": 7,
      "start": 2121.0,
      "end": 2122.0,
      "formatted_start": "00:35:21.000",
      "formatted_end": "00:35:22.000",
      "text": "آه خانه بابا."
    },
    {
      "id": 8,
      "start": 2122.0,
      "end": 2123.0,
      "formatted_start": "00:35:22.000",
      "formatted_end": "00:35:23.000",
      "text": "میگرده؟"
    },
    {
      "id": 9,
      "start": 2123.0,
      "end": 2124.0,
      "formatted_start": "00:35:23.000",
      "formatted_end": "00:35:24.000",
      "text": "آه نگاه کن من همین کار میکنم."
    },
    {
      "id": 10,
      "start": 2125.0,
      "end": 2127.0,
      "formatted_start": "00:35:25.000",
      "formatted_end": "00:35:27.000",
      "text": "آه بابا چرا راحت تر برن؟"
    },
    {
      "id": 11,
      "start": 2130.0,
      "end": 2132.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:32.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 12,
      "start": 2134.0,
      "end": 2136.0,
      "formatted_start": "00:35:34.000",
      "formatted_end": "00:35:36.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 13,
      "start": 2137.0,
      "end": 2139.0,
      "formatted_start": "00:35:37.000",
