  "stt_segments": [
    {
      "id": 0,
      "start": 24000.0,
      "end": 24002.0,
      "formatted_start": "06:40:00.000",
      "formatted_end": "06:40:02.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 24030.0,
      "end": 24030.5,
      "formatted_start": "06:40:30.000",
      "formatted_end": "06:40:30.500",
      "text": "خوبی؟"
    },
    {
      "id": 2,
      "start": 24030.5,
      "end": 24032.0,
      "formatted_start": "06:40:30.500",
      "formatted_end": "06:40:32.000",
      "text": "برای این زن سه والاست"
    },
    {
      "id": 3,
      "start": 24032.0,
      "end": 24034.0,
      "formatted_start": "06:40:32.000",
      "formatted_end": "06:40:34.000",
      "text": "مادر، شوپر، زن"
    },
    {
      "id": 4,
      "start": 24034.0,
      "end": 24036.0,
      "formatted_start": "06:40:34.000",
      "formatted_end": "06:40:36.000",
      "text": "خالتون چه بود؟"
    },
    {
      "id": 5,
      "start": 24036.0,
      "end": 24038.0,
      "formatted_start": "06:40:36.000",
      "formatted_end": "06:40:38.000",
      "text": "بیمار درست شده"
    },
    {
      "id": 6,
      "start": 24044.0,
      "end": 24046.0,
      "formatted_start": "06:40:44.000",
      "formatted_end": "06:40:46.000",
      "text": "بابا چی کار شده؟"
    },
    {
      "id": 7,
      "start": 24046.0,
      "end": 24050.0,
      "formatted_start": "06:40:46.000",
      "formatted_end": "06:40:50.000",
      "text": "خانه یک طرف بابا قندش میر بالا"
    },
    {
      "id": 8,
      "start": 24050.0,
      "end": 24052.0,
      "formatted_start": "06:40:50.000",
      "formatted_end": "06:40:52.000",
      "text": "بعد از این وقت تشنش اولا اینجور"
    },
    {
      "id": 9,
      "start": 24052.0,
      "end": 24055.0,
      "formatted_start": "06:40:52.000",
      "formatted_end": "06:40:55.000",
      "text": "شونزدون، خفزدون، قبلش نوادون پنده شد"
    },
    {
      "id": 10,
      "start": 24055.0,
      "end": 24057.0,
      "formatted_start": "06:40:55.000",
      "formatted_end": "06:40:57.000",
      "text": "بعد..."
    },
    {
      "id": 11,
      "start": 24057.0,
      "end": 24059.0,
      "formatted_start": "06:40:57.000",
      "formatted_end": "06:40:59.000",
      "text": "یکی سرگیجه خیلی داره"
    },
    {
      "id": 12,
      "start": 24059.0,
      "end": 24062.0,
      "formatted_start": "06:40:59.000",
      "formatted_end": "06:41:02.000",
      "text": "خب وقتی بنده بره بالا سرگجه نداره"
    },
    {
      "id": 13,
      "start": 24063.0,
      "end": 24066.0,
      "formatted_start": "06:41:03.000",
      "formatted_end": "06:41:06.000",
      "text": "اون موقع که باز باز سرگجه داره"
    },
    {
      "id": 14,
      "start": 24066.0,
      "end": 24070.0,
      "formatted_start": "06:41:06.000",
      "formatted_end": "06:41:10.000",
      "text": "یعنی چه قندش بالا باشه چه نباشه سرگجه داره"
    },
    {
      "id": 15,
      "start": 24070.0,
      "end": 24072.0,
      "formatted_start": "06:41:10.000",
      "formatted_end": "06:41:12.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 24078.0,
      "end": 24082.0,
      "formatted_start": "06:41:18.000",
      "formatted_end": "06:41:22.000",
      "text": "برس متفاویل هم بخوره برس پشه هم که آنجا باشه"
    },
    {
      "id": 17,
      "start": 24082.0,
      "end": 24088.0,
      "formatted_start": "06:41:22.000",
      "formatted_end": "06:41:28.000",
      "text": "الان چند چشم؟ قندشون؟"
    },
    {
      "id": 18,
      "start": 24088.0,
      "end": 24094.0,
      "formatted_start": "06:41:28.000",
      "formatted_end": "06:41:34.000",
      "text": "من اونجا صبح و نشت را گرفتم و بزرگم بزنیم"
    },
    {
      "id": 19,
      "start": 24094.0,
      "end": 24096.0,
      "formatted_start": "06:41:34.000",
      "formatted_end": "06:41:36.000",
      "text": "دارشون چه؟"
    },
    {
      "id": 20,
      "start": 24096.0,
      "end": 24098.0,
      "formatted_start": "06:41:36.000",
      "formatted_end": "06:41:38.000",
      "text": "متفاون نمیخورد"
    },
    {
      "id": 21,
      "start": 24098.0,
      "end": 24100.0,
      "formatted_start": "06:41:38.000",
      "formatted_end": "06:41:40.000",
      "text": "بزرگ چندتا؟"
    },
    {
      "id": 22,
      "start": 24100.0,
      "end": 24102.0,
      "formatted_start": "06:41:40.000",
      "formatted_end": "06:41:42.000",
      "text": "صبح و شب یک کامل نمیخورد و زورم نزدیک میخورد"
    },
    {
      "id": 23,
      "start": 24102.0,
      "end": 24104.0,
      "formatted_start": "06:41:42.000",
      "formatted_end": "06:41:44.000",
      "text": "و با رایت نمیکنه؟ همین دانه خرباز هست؟"
    },
    {
      "id": 24,
      "start": 24104.0,
      "end": 24106.0,
      "formatted_start": "06:41:44.000",
      "formatted_end": "06:41:46.000",
      "text": "نه نه اصلا نمیخورد این ها"
    },
    {
      "id": 25,
      "start": 24106.0,
      "end": 24108.0,
      "formatted_start": "06:41:46.000",
      "formatted_end": "06:41:48.000",
      "text": "چه میرو بلا؟"
    },
    {
      "id": 26,
      "start": 24108.0,
      "end": 24110.0,
      "formatted_start": "06:41:48.000",
      "formatted_end": "06:41:50.000",
      "text": "نه نه همه که بزنیم"
    },
    {
      "id": 27,
      "start": 24112.0,
      "end": 24114.0,
      "formatted_start": "06:41:52.000",
      "formatted_end": "06:41:54.000",
      "text": "چیزای شیری من کسان نمیخورد؟"
    },
    {
      "id": 28,
      "start": 24114.0,
      "end": 24116.0,
      "formatted_start": "06:41:54.000",
      "formatted_end": "06:41:56.000",
      "text": "چشم میزنم"
    },
    {
      "id": 29,
      "start": 24116.0,
      "end": 24146.0,
      "formatted_start": "06:41:56.000",
      "formatted_end": "06:42:26.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 30,
      "start": 24146.0,
      "end": 24148.0,
      "formatted_start": "06:42:26.000",
      "formatted_end": "06:42:28.000",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 24176.0,
      "end": 24177.0,
      "formatted_start": "06:42:56.000",
      "formatted_end": "06:42:57.000",
      "text": "دیتو دیتو"
    },
    {
      "id": 32,
      "start": 24177.0,
      "end": 24186.0,
      "formatted_start": "06:42:57.000",
      "formatted_end": "06:43:06.000",
      "text": "پایاتونو به هم بچسبونید"
    },
    {
      "id": 33,
      "start": 24186.8,
      "end": 24190.04,
      "formatted_start": "06:43:06.800",
      "formatted_end": "06:43:10.040",
      "text": "صاف بایست"
    },
    {
      "id": 34,
      "start": 24190.04,
      "end": 24193.0,
      "formatted_start": "06:43:10.040",
      "formatted_end": "06:43:13.000",
      "text": "بسطون نگیرید"
    },
    {
      "id": 35,
      "start": 24193.6,
      "end": 24196.86,
      "formatted_start": "06:43:13.600",
      "formatted_end": "06:43:16.860",
      "text": "اگه بسطون نگیرید چی میشه؟"
    },
    {
      "id": 36,
      "start": 24196.86,
      "end": 24199.0,
      "formatted_start": "06:43:16.860",
      "formatted_end": "06:43:19.000",
      "text": "از کدوم رفتید"
    },
    {
      "id": 37,
      "start": 24199.0,
      "end": 24203.02,
      "formatted_start": "06:43:19.000",
      "formatted_end": "06:43:23.020",
      "text": "پس به یه جهتی نمیافته"
    },
    {
      "id": 38,
      "start": 24203.02,
      "end": 24205.0,
      "formatted_start": "06:43:23.020",
      "formatted_end": "06:43:25.000",
      "text": "خب چشماتونو ببندید"
    },
    {
      "id": 39,
      "start": 24205.0,
      "end": 24209.0,
      "formatted_start": "06:43:25.000",
      "formatted_end": "06:43:29.000",
      "text": "برده میشی؟ یا فرق نمی کنه؟"
    },
    {
      "id": 40,
      "start": 24209.0,
      "end": 24211.0,
      "formatted_start": "06:43:29.000",
      "formatted_end": "06:43:31.000",
      "text": "فرق نمی کنه"
    },
    {
      "id": 41,
      "start": 24215.0,
      "end": 24217.0,
      "formatted_start": "06:43:35.000",
      "formatted_end": "06:43:37.000",
      "text": "بابا تنهاست؟"
    },
    {
      "id": 42,
      "start": 24217.0,
      "end": 24219.0,
      "formatted_start": "06:43:37.000",
      "formatted_end": "06:43:39.000",
      "text": "همین"
    },
    {
      "id": 43,
      "start": 24219.0,
      "end": 24221.0,
      "formatted_start": "06:43:39.000",
      "formatted_end": "06:43:41.000",
      "text": "تصویر چکر قنگ؟ خوب کسیست؟ پیشش بابا برقندشو چک کنم"
    },
    {
      "id": 44,
      "start": 24221.0,
      "end": 24223.0,
      "formatted_start": "06:43:41.000",
      "formatted_end": "06:43:43.000",
      "text": "چرا خودشون داری؟"
    },
    {
      "id": 45,
      "start": 24223.0,
      "end": 24225.0,
      "formatted_start": "06:43:43.000",
      "formatted_end": "06:43:45.000",
      "text": "خودشون داری"
    },
    {
      "id": 46,
      "start": 24225.0,
      "end": 24229.0,
      "formatted_start": "06:43:45.000",
      "formatted_end": "06:43:49.000",
      "text": "گل گلازی بایدشون شروع کنم با"
    },
    {
      "id": 47,
      "start": 24229.0,
      "end": 24231.0,
      "formatted_start": "06:43:49.000",
      "formatted_end": "06:43:51.000",
      "text": "که هم مزنشو پایین نیابه"
    },
    {
      "id": 48,
      "start": 24231.0,
      "end": 24237.14,
      "formatted_start": "06:43:51.000",
      "formatted_end": "06:43:57.140",
      "text": "این چیزی باشه که روغندشون تأثیر نداره"
    },
    {
      "id": 49,
      "start": 24237.14,
      "end": 24243.5,
      "formatted_start": "06:43:57.140",
      "formatted_end": "06:44:03.500",
      "text": "بابا رو تیرویدشون چربیشون اینها چک کردی؟"
    },
    {
      "id": 50,
      "start": 24243.5,
      "end": 24247.74,
      "formatted_start": "06:44:03.500",
      "formatted_end": "06:44:07.740",
      "text": "نه اگه میخوایید آزمایش چکاپ کامل هر چی که لازمه خودتون میدونید"
    },
    {
      "id": 51,
      "start": 24247.74,
      "end": 24249.82,
      "formatted_start": "06:44:07.740",
      "formatted_end": "06:44:09.820",
      "text": "من اینو یه چکاپ کامل نمیدونیم سم ببینیم"
    },
    {
      "id": 52,
      "start": 24249.82,
      "end": 24250.5,
      "formatted_start": "06:44:09.820",
      "formatted_end": "06:44:10.500",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 24250.5,
      "end": 24253.3,
      "formatted_start": "06:44:10.500",
      "formatted_end": "06:44:13.300",
      "text": "الان انجام نده چند روز سم ببینیم"
    },
    {
      "id": 54,
      "start": 24253.3,
      "end": 24255.0,
      "formatted_start": "06:44:13.300",
      "formatted_end": "06:44:15.000",
      "text": "یعنی داروی بابا رو بده"
    },
    {
      "id": 55,
      "start": 24255.0,
      "end": 24255.58,
      "formatted_start": "06:44:15.000",
      "formatted_end": "06:44:15.580",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 24255.58,
      "end": 24260.98,
      "formatted_start": "06:44:15.580",
      "formatted_end": "06:44:20.980",
      "text": "بعد از چار پنج روز انجام بده که ببینیم که داروها چه تأثیر بذاشته باشه"
    },
    {
      "id": 57,
      "start": 24260.98,
      "end": 24262.98,
      "formatted_start": "06:44:20.980",
      "formatted_end": "06:44:22.980",
      "text": "خودتون زمانش هم خیلی درد بکنند"
    },
    {
      "id": 58,
      "start": 24262.98,
      "end": 24264.98,
      "formatted_start": "06:44:22.980",
      "formatted_end": "06:44:24.980",
      "text": "چشم"
    },
    {
      "id": 59,
      "start": 24264.98,
      "end": 24266.98,
      "formatted_start": "06:44:24.980",
      "formatted_end": "06:44:26.980",
      "text": "پاونه کارم بکنند یا نه؟"
    },
    {
      "id": 60,
      "start": 24266.98,
      "end": 24268.98,
      "formatted_start": "06:44:26.980",
      "formatted_end": "06:44:28.980",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 24268.98,
      "end": 24270.98,
      "formatted_start": "06:44:28.980",
      "formatted_end": "06:44:30.980",
      "text": "پاونه تو خونه بیکارند؟"
    },
    {
      "id": 62,
      "start": 24270.98,
      "end": 24272.98,
      "formatted_start": "06:44:30.980",
      "formatted_end": "06:44:32.980",
      "text": "آره بگیرم"
    },
    {
      "id": 63,
      "start": 24272.98,
      "end": 24274.98,
      "formatted_start": "06:44:32.980",
      "formatted_end": "06:44:34.980",
      "text": "همینطور هیچ دور بزنیم"
    },
    {
      "id": 64,
      "start": 24274.98,
      "end": 24276.98,
      "formatted_start": "06:44:34.980",
      "formatted_end": "06:44:36.980",
      "text": "همینطور هیچ دور بزنیم"
    },
    {
      "id": 65,
      "start": 24276.98,
      "end": 24278.98,
      "formatted_start": "06:44:36.980",
      "formatted_end": "06:44:38.980",
      "text": "همینطور هیچ دور بزنیم"
    },
    {
      "id": 66,
      "start": 24278.98,
      "end": 24280.98,
      "formatted_start": "06:44:38.980",
      "formatted_end": "06:44:40.980",
      "text": "آره بگیرم"
    },
    {
      "id": 67,
      "start": 24280.98,
      "end": 24282.98,
      "formatted_start": "06:44:40.980",
      "formatted_end": "06:44:42.980",
      "text": "پاونه تو اون رو هم برسید"
    },
    {
      "id": 68,
      "start": 24282.98,
      "end": 24284.98,
      "formatted_start": "06:44:42.980",
      "formatted_end": "06:44:44.980",
      "text": "آره بگیرم"
    },
    {
      "id": 69,
      "start": 24284.98,
      "end": 24286.98,
      "formatted_start": "06:44:44.980",
      "formatted_end": "06:44:46.980",
      "text": "پاونه تو اون رو هم برسید"
    },
    {
      "id": 70,
      "start": 24286.98,
      "end": 24288.98,
      "formatted_start": "06:44:46.980",
      "formatted_end": "06:44:48.980",
      "text": "آره بگیرم"
    },
    {
      "id": 71,
      "start": 24288.98,
      "end": 24290.98,
      "formatted_start": "06:44:48.980",
      "formatted_end": "06:44:50.980",
      "text": "دوست داشته بود از شما"
    },
    {
      "id": 72,
      "start": 24290.98,
      "end": 24292.98,
      "formatted_start": "06:44:50.980",
      "formatted_end": "06:44:52.980",
      "text": "تو پرس نمیشه"
    },
    {
      "id": 73,
      "start": 24292.98,
      "end": 24294.98,
      "formatted_start": "06:44:52.980",
      "formatted_end": "06:44:54.980",
      "text": "یعنی تو چه بود"
    },
    {
      "id": 74,
      "start": 24294.98,
      "end": 24296.98,
      "formatted_start": "06:44:54.980",
      "formatted_end": "06:44:56.980",
      "text": "با خودمون یه رو سر میده"
    },
    {
      "id": 75,
      "start": 24296.98,
      "end": 24298.98,
      "formatted_start": "06:44:56.980",
      "formatted_end": "06:44:58.980",
      "text": "حالی همیشه یکی نیست"
    },
    {
      "id": 76,
      "start": 24298.98,
      "end": 24300.98,
      "formatted_start": "06:44:58.980",
      "formatted_end": "06:45:00.980",
      "text": "مثل که خواهی داریم"
    }
  ],
  "status": "completed"
}