      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6350.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6380.0,
      "end": 6387.0,
      "formatted_start": "01:46:20.000",
      "formatted_end": "01:46:27.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 6410.0,
      "end": 6413.0,
      "formatted_start": "01:46:50.000",
      "formatted_end": "01:46:53.000",
      "text": "اولا برده چیزی کرده بوده؟"
    },
    {
      "id": 4,
      "start": 6413.0,
      "end": 6416.0,
      "formatted_start": "01:46:53.000",
      "formatted_end": "01:46:56.000",
      "text": "اولا باز انجام داده بوده"
    },
    {
      "id": 5,
      "start": 6416.0,
      "end": 6420.0,
      "formatted_start": "01:46:56.000",
      "formatted_end": "01:47:00.000",
      "text": "آرتروز که داره کلن، آرتروز داره ببینم اون چیه؟"
    },
    {
      "id": 6,
      "start": 6420.0,
      "end": 6423.0,
      "formatted_start": "01:47:00.000",
      "formatted_end": "01:47:03.000",
      "text": "این ها، موره این، خب خیله"
    },
    {
      "id": 7,
      "start": 6423.0,
      "end": 6425.0,
      "formatted_start": "01:47:03.000",
      "formatted_end": "01:47:05.000",
      "text": "ببینم"
    },
    {
      "id": 8,
      "start": 6425.0,
      "end": 6427.0,
      "formatted_start": "01:47:05.000",
      "formatted_end": "01:47:07.000",
      "text": "این نام یکی؟"
    },
    {
      "id": 9,
      "start": 6427.0,
      "end": 6430.0,
      "formatted_start": "01:47:07.000",
      "formatted_end": "01:47:10.000",
      "text": "اولا بده ببین"
    },
    {
      "id": 10,
      "start": 6430.0,
      "end": 6432.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:12.000",
      "text": "یکی"
    },
    {
      "id": 11,
      "start": 6432.0,
      "end": 6435.0,
      "formatted_start": "01:47:12.000",
      "formatted_end": "01:47:15.000",
      "text": "خب فالت این طرفه، ببین"
    },
    {
      "id": 12,
      "start": 6440.0,
      "end": 6442.0,
      "formatted_start": "01:47:20.000",
      "formatted_end": "01:47:22.000",
      "text": "من این وضعیتم چند روزه"
    },
    {
      "id": 13,
      "start": 6442.0,
      "end": 6444.0,
      "formatted_start": "01:47:22.000",
      "formatted_end": "01:47:24.000",
      "text": "صدا من درمی میشه"
    },
    {
      "id": 14,
      "start": 6446.0,
      "end": 6448.0,
      "formatted_start": "01:47:26.000",
      "formatted_end": "01:47:28.000",
      "text": "پرم گفت نمیشته که برم هاتیسکوپی"
    },
    {
      "id": 15,
      "start": 6454.0,
      "end": 6456.0,
      "formatted_start": "01:47:34.000",
      "formatted_end": "01:47:36.000",
      "text": "دکتر مصرتی خانم نمیشته"
    },
    {
      "id": 16,
      "start": 6464.0,
      "end": 6467.0,
      "formatted_start": "01:47:44.000",
      "formatted_end": "01:47:47.000",
      "text": "اینکه تمومت آستانی که دکتر گفته"
    },
    {
      "id": 17,
      "start": 6467.0,
      "end": 6469.0,
      "formatted_start": "01:47:47.000",
      "formatted_end": "01:47:49.000",
      "text": "بعد بگیره کن"
    },
    {
      "id": 18,
      "start": 6470.0,
      "end": 6473.84,
      "formatted_start": "01:47:50.000",
      "formatted_end": "01:47:53.840",
      "text": "الان دارو میخوری هاجی برای صدا"
    },
    {
      "id": 19,
      "start": 6473.84,
      "end": 6475.06,
      "formatted_start": "01:47:53.840",
      "formatted_end": "01:47:55.060",
      "text": "برای صدا"
    },
    {
      "id": 20,
      "start": 6475.06,
      "end": 6476.52,
      "formatted_start": "01:47:55.060",
      "formatted_end": "01:47:56.520",
      "text": "دارو میخورم"
    },
    {
      "id": 21,
      "start": 6476.52,
      "end": 6478.6,
      "formatted_start": "01:47:56.520",
      "formatted_end": "01:47:58.600",
      "text": "ارسه میده میخورم"
    },
    {
      "id": 22,
      "start": 6478.6,
      "end": 6480.0,
      "formatted_start": "01:47:58.600",
      "formatted_end": "01:48:00.000",
      "text": "ارسه"
    },
    {
      "id": 23,
      "start": 6480.0,
      "end": 6481.88,
      "formatted_start": "01:48:00.000",
      "formatted_end": "01:48:01.880",
      "text": "خامشفایی جان"
    },
    {
      "id": 24,
      "start": 6481.88,
      "end": 6487.22,
      "formatted_start": "01:48:01.880",
      "formatted_end": "01:48:07.220",
      "text": "دکتر پس دارو بهتون داده"
    },
    {
      "id": 25,
      "start": 6487.22,
      "end": 6488.28,
      "formatted_start": "01:48:07.220",
      "formatted_end": "01:48:08.280",
      "text": "آره برو خام"
    },
    {
      "id": 26,
      "start": 6488.28,
      "end": 6492.14,
      "formatted_start": "01:48:08.280",
      "formatted_end": "01:48:12.140",
      "text": "نمیدونه وقت رامرم"
    },
    {
      "id": 27,
      "start": 6492.14,
      "end": 6494.0,
      "formatted_start": "01:48:12.140",
      "formatted_end": "01:48:14.000",
      "text": "یکی اقیم سنگیره"
    },
    {
      "id": 28,
      "start": 6494.6,
      "end": 6498.82,
      "formatted_start": "01:48:14.600",
      "formatted_end": "01:48:18.820",
      "text": "کار خاصی نکرده بودی"
    },
    {
      "id": 29,
      "start": 6498.82,
      "end": 6499.28,
      "formatted_start": "01:48:18.820",
      "formatted_end": "01:48:19.280",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 6499.28,
      "end": 6507.28,
      "formatted_start": "01:48:19.280",
      "formatted_end": "01:48:27.280",
      "text": "این برای من همه چیزی نداره."
    },
    {
      "id": 31,
      "start": 6507.28,
      "end": 6509.28,
      "formatted_start": "01:48:27.280",
      "formatted_end": "01:48:29.280",
      "text": "من ندارم."
    },
    {
      "id": 32,
      "start": 6509.28,
      "end": 6510.28,
      "formatted_start": "01:48:29.280",
      "formatted_end": "01:48:30.280",
      "text": "نه."
    },
    {
      "id": 33,
      "start": 6510.28,
      "end": 6513.28,
      "formatted_start": "01:48:30.280",
      "formatted_end": "01:48:33.280",
      "text": "فقط امپول بزن و بازشون بزن."
    },
    {
      "id": 34,
      "start": 6513.28,
      "end": 6517.28,
      "formatted_start": "01:48:33.280",
      "formatted_end": "01:48:37.280",
      "text": "دو تا امپول داری امروز بزن و دو تا پس فردا."
    },
    {
      "id": 35,
      "start": 6517.28,
      "end": 6521.28,
      "formatted_start": "01:48:37.280",
      "formatted_end": "01:48:41.280",
      "text": "برای من نفروس کنه چیزی."
    },
    {
      "id": 36,
      "start": 6521.28,
      "end": 6524.28,
      "formatted_start": "01:48:41.280",
      "formatted_end": "01:48:44.280",
      "text": "من دارم دارم این رسام."
    },
    {
      "id": 37,
      "start": 6524.28,
      "end": 6526.28,
      "formatted_start": "01:48:44.280",
      "formatted_end": "01:48:46.280",
      "text": "نفروس."
    },
    {
      "id": 38,
      "start": 6526.28,
      "end": 6528.28,
      "formatted_start": "01:48:46.280",
      "formatted_end": "01:48:48.280",
      "text": "نفروس کنه."
    },
    {
      "id": 39,
      "start": 6528.28,
      "end": 6558.28,
      "formatted_start": "01:48:48.280",
      "formatted_end": "01:49:18.280",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 40,
      "start": 6558.28,
      "end": 6561.28,
      "formatted_start": "01:49:18.280",
      "formatted_end": "01:49:21.280",
      "text": "اما آنپولا یکی امروز یکی فردا"
    },
    {
      "id": 41,
      "start": 6564.28,
      "end": 6566.28,
      "formatted_start": "01:49:24.280",
      "formatted_end": "01:49:26.280",
      "text": "آقای مزرخنگ دیواز شد؟"
    },
    {
      "id": 42,
      "start": 6566.28,
      "end": 6567.28,
      "formatted_start": "01:49:26.280",
      "formatted_end": "01:49:27.280",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 6573.28,
      "end": 6575.28,
      "formatted_start": "01:49:33.280",
      "formatted_end": "01:49:35.280",
      "text": "چیزی شخصی بودن نمیشه"
    },
    {
      "id": 44,
      "start": 6575.28,
      "end": 6577.28,
      "formatted_start": "01:49:35.280",
      "formatted_end": "01:49:37.280",
      "text": "نمیشه، خودکاری بوده"
    },
    {
      "id": 45,
      "start": 6577.28,
      "end": 6580.28,
      "formatted_start": "01:49:37.280",
      "formatted_end": "01:49:40.280",
      "text": "از روی این نسخه مریضه بود"
    },
    {
      "id": 46,
      "start": 6580.28,
      "end": 6581.28,
      "formatted_start": "01:49:40.280",
      "formatted_end": "01:49:41.280",
      "text": "چی؟"
    },
    {
      "id": 47,
      "start": 6583.28,
      "end": 6585.28,
      "formatted_start": "01:49:43.280",
      "formatted_end": "01:49:45.280",
      "text": "مرد پیر مرد کسی"
    },
    {
      "id": 48,
      "start": 6585.28,
      "end": 6587.28,
      "formatted_start": "01:49:45.280",
      "formatted_end": "01:49:47.280",
      "text": "برده کل بزنیم و بعد با دست موزنیم"
    },
    {
      "id": 49,
      "start": 6587.28,
      "end": 6589.28,
      "formatted_start": "01:49:47.280",
      "formatted_end": "01:49:49.280",
      "text": "آره چونه تموم شد"
    },
    {
      "id": 50,
      "start": 6589.28,
      "end": 6591.28,
      "formatted_start": "01:49:49.280",
      "formatted_end": "01:49:51.280",
      "text": "بفرمید برده"
    },
    {
      "id": 51,
      "start": 6591.28,
      "end": 6593.28,
      "formatted_start": "01:49:51.280",
      "formatted_end": "01:49:53.280",
      "text": "چونه تموم پر نوشته"
    },
    {
      "id": 52,
      "start": 6593.28,
      "end": 6596.28,
      "formatted_start": "01:49:53.280",
      "formatted_end": "01:49:56.280",
      "text": "چارتاست دو تا ایروپ دو تا پس پردا خب؟"
    },
    {
      "id": 53,
      "start": 6596.28,
      "end": 6598.28,
      "formatted_start": "01:49:56.280",
      "formatted_end": "01:49:58.280",
      "text": "آره دو تا ایروپ"
    },
    {
      "id": 54,
      "start": 6598.28,
      "end": 6600.28,
      "formatted_start": "01:49:58.280",
      "formatted_end": "01:50:00.280",
      "text": "یه اواله دارو به خانه کفه کنیم"
    }
  ],
