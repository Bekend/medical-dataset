      "start": 9860.0,
      "end": 9888.0,
      "formatted_start": "02:44:20.000",
      "formatted_end": "02:44:48.000",
      "text": "موسیقی"
    },
    {
      "id": 90,
      "start": 9890.0,
      "end": 9893.0,
      "formatted_start": "02:44:50.000",
      "formatted_end": "02:44:53.000",
      "text": "باید برگردید و برگردید"
    },
    {
      "id": 91,
      "start": 9893.0,
      "end": 9895.0,
      "formatted_start": "02:44:53.000",
      "formatted_end": "02:44:55.000",
