  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9603.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:03.000",
      "text": "باید برامون میشه، دیگه نمیدونم."
    },
    {
      "id": 1,
      "start": 9603.0,
      "end": 9607.0,
      "formatted_start": "02:40:03.000",
      "formatted_end": "02:40:07.000",
      "text": "ببین باعثش نیست ولی برتر اتون کاره."
    },
    {
      "id": 2,
      "start": 9607.0,
      "end": 9612.0,
      "formatted_start": "02:40:07.000",
      "formatted_end": "02:40:12.000",
      "text": "این مشکل دیگه هم دارم اینه که اصلاً کلن به حالت خواهشی دارم."
    },
    {
      "id": 3,
      "start": 9612.0,
      "end": 9616.0,
      "formatted_start": "02:40:12.000",
      "formatted_end": "02:40:16.000",
      "text": "یه چیزی رو هرچیم فکر کنم یادم نمیاد."
    },
    {
      "id": 4,
      "start": 9616.0,
      "end": 9618.0,
      "formatted_start": "02:40:16.000",
      "formatted_end": "02:40:18.000",
      "text": "در اینجا فکری زیاده؟"
    },
    {
      "id": 5,
      "start": 9618.0,
      "end": 9622.0,
      "formatted_start": "02:40:18.000",
      "formatted_end": "02:40:22.000",
      "text": "در اینجا فکری هم دارم ولی اینه میده میده، میده مثلاً گوز"
    },
    {
      "id": 6,
      "start": 9622.0,
      "end": 9627.0,
      "formatted_start": "02:40:22.000",
      "formatted_end": "02:40:27.000",
      "text": "که با من زنگ زده یادم نمیده و اینجا بیشنم فکر کنم که که با من زنگ زده."
    },
    {
      "id": 7,
      "start": 9627.0,
      "end": 9629.0,
      "formatted_start": "02:40:27.000",
      "formatted_end": "02:40:29.000",
      "text": "یا مثلا تیروید تنظیم هست؟"
    },
    {
      "id": 8,
      "start": 9629.0,
      "end": 9632.0,
      "formatted_start": "02:40:29.000",
      "formatted_end": "02:40:32.000",
      "text": "آره اون رقم دو تور برطرف شده بود"
    },
    {
      "id": 9,
      "start": 9632.0,
      "end": 9635.0,
      "formatted_start": "02:40:32.000",
      "formatted_end": "02:40:35.000",
      "text": "یا حدود برای برج دو دونا درموان"
    },
    {
      "id": 10,
      "start": 9635.0,
      "end": 9636.0,
      "formatted_start": "02:40:35.000",
      "formatted_end": "02:40:36.000",
      "text": "قطعه؟ قطعه؟"
    },
    {
      "id": 11,
      "start": 9636.0,
      "end": 9639.0,
      "formatted_start": "02:40:36.000",
      "formatted_end": "02:40:39.000",
      "text": "قطعه؟ اعتماد آن را حد کرده باشه"
    },
    {
      "id": 12,
      "start": 9640.0,
      "end": 9642.0,
      "formatted_start": "02:40:40.000",
      "formatted_end": "02:40:42.000",
      "text": "احتمال آتش زیاد"
    },
    {
      "id": 13,
      "start": 9642.0,
      "end": 9645.0,
      "formatted_start": "02:40:42.000",
      "formatted_end": "02:40:45.000",
      "text": "ببین من سه تا کلمه بهت میگم"
    },
    {
      "id": 14,
      "start": 9645.0,
      "end": 9647.0,
      "formatted_start": "02:40:45.000",
      "formatted_end": "02:40:47.000",
      "text": "میز، کتاب، میز"
    },
    {
      "id": 15,
      "start": 9647.0,
      "end": 9650.0,
      "formatted_start": "02:40:47.000",
      "formatted_end": "02:40:50.000",
      "text": "اینو کتاب در حضور بگیر و ساعت"
    },
    {
      "id": 16,
      "start": 9650.0,
      "end": 9653.0,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:53.000",
      "text": "سه تا کلمه میز، کتاب، ساعت، خب؟"
    },
    {
      "id": 17,
      "start": 9653.0,
      "end": 9659.0,
      "formatted_start": "02:40:53.000",
      "formatted_end": "02:40:59.000",
      "text": "بعد تیروید رو باید از من چک کنید با کمپون"
    },
    {
      "id": 18,
      "start": 9659.0,
      "end": 9663.0,
      "formatted_start": "02:40:59.000",
      "formatted_end": "02:41:03.000",
      "text": "کمپونی دارم، بازمش قبلن خورست دادید من یه سری"
    },
    {
      "id": 19,
      "start": 9663.0,
      "end": 9665.0,
      "formatted_start": "02:41:03.000",
      "formatted_end": "02:41:05.000",
      "text": "و خورس آهنگ داری؟"
    },
    {
      "id": 20,
      "start": 9665.0,
      "end": 9669.0,
      "formatted_start": "02:41:05.000",
      "formatted_end": "02:41:09.000",
      "text": "خورس آهنگ دادی، کلسیوم برم دادی، اینو خیلی برم دادیم استفاده کردم"
    },
    {
      "id": 21,
      "start": 9669.0,
      "end": 9673.0,
      "formatted_start": "02:41:09.000",
      "formatted_end": "02:41:13.000",
      "text": "یه مدت خوب شدن، باز دوباره نه، خورس آهنگ دارم، تاون شدم"
    },
    {
      "id": 22,
      "start": 9673.0,
      "end": 9675.0,
      "formatted_start": "02:41:13.000",
      "formatted_end": "02:41:15.000",
      "text": "خورس آهنگ داری، اتهام کردی؟"
    },
    {
      "id": 23,
      "start": 9675.0,
      "end": 9677.0,
      "formatted_start": "02:41:15.000",
      "formatted_end": "02:41:17.000",
      "text": "تاون کردم، بله"
    },
    {
      "id": 24,
      "start": 9677.0,
      "end": 9707.0,
      "formatted_start": "02:41:17.000",
      "formatted_end": "02:41:47.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 25,
      "start": 9707.0,
      "end": 9711.0,
      "formatted_start": "02:41:47.000",
      "formatted_end": "02:41:51.000",
      "text": "باید اینقدر ماساج بده که کامل جذب بشه، هیچی نمونه"
    },
    {
      "id": 26,
      "start": 9711.0,
      "end": 9714.0,
      "formatted_start": "02:41:51.000",
      "formatted_end": "02:41:54.000",
      "text": "این وقتی دستتو میزنه، هیچی نباشه"
    },
    {
      "id": 27,
      "start": 9714.0,
      "end": 9717.0,
      "formatted_start": "02:41:54.000",
      "formatted_end": "02:41:57.000",
      "text": "اگر بمونه، خودش باز مستعد رشد قارش میشه"
    },
    {
      "id": 28,
      "start": 9717.0,
      "end": 9720.0,
      "formatted_start": "02:41:57.000",
      "formatted_end": "02:42:00.000",
      "text": "هیچی زنبه بگم، درمانه دو تا سه ماه تون میگشه"
    },
    {
      "id": 29,
      "start": 9720.0,
      "end": 9722.0,
      "formatted_start": "02:42:00.000",
      "formatted_end": "02:42:02.000",
      "text": "این زخمایی که تو باقی..."
    },
    {
      "id": 30,
      "start": 9722.0,
      "end": 9724.0,
      "formatted_start": "02:42:02.000",
      "formatted_end": "02:42:04.000",
      "text": "یک سالونی در اینجا بودی؟"
    },
    {
      "id": 31,
      "start": 9724.0,
      "end": 9727.0,
      "formatted_start": "02:42:04.000",
      "formatted_end": "02:42:07.000",
      "text": "نه، دو تا سه ماه هر زخمی تون میگشه خوب بشه"
    },
    {
      "id": 32,
      "start": 9727.0,
      "end": 9729.0,
      "formatted_start": "02:42:07.000",
      "formatted_end": "02:42:09.000",
      "text": "این بیماری که باقی هست"
    },
    {
      "id": 33,
      "start": 9729.0,
      "end": 9733.5,
      "formatted_start": "02:42:09.000",
      "formatted_end": "02:42:13.500",
      "text": "این پاماده تو باید داشته باشه همیشه. من برای ترک بودم دوتا میمونستم."
    },
    {
      "id": 34,
      "start": 9733.5,
      "end": 9737.0,
      "formatted_start": "02:42:13.500",
      "formatted_end": "02:42:17.000",
      "text": "اینو باید همیشه داشته باشه. این بیماری با شما هست."
    },
    {
      "id": 35,
      "start": 9737.0,
      "end": 9741.5,
      "formatted_start": "02:42:17.000",
      "formatted_end": "02:42:21.500",
      "text": "از همین پسرم هستم. من خود همینجوریست. این نوع کنگوشتاش پست پست میشه."
    },
    {
      "id": 36,
      "start": 9741.5,
      "end": 9743.5,
      "formatted_start": "02:42:21.500",
      "formatted_end": "02:42:23.500",
      "text": "میگه ماما بیباری تو منم گرفت."
    },
    {
      "id": 37,
      "start": 9743.5,
      "end": 9747.5,
      "formatted_start": "02:42:23.500",
      "formatted_end": "02:42:27.500",
      "text": "اگه من خودم مامانم چون بیباری پستی داره و اکثر وچه همون گرفتیم."
    },
    {
      "id": 38,
      "start": 9747.5,
      "end": 9748.0,
      "formatted_start": "02:42:27.500",
      "formatted_end": "02:42:28.000",
      "text": "چونه؟"
    },
    {
      "id": 39,
      "start": 9748.0,
      "end": 9750.0,
      "formatted_start": "02:42:28.000",
      "formatted_end": "02:42:30.000",
      "text": "من اکزما شما سر گرفتم."
    },
    {
      "id": 40,
      "start": 9750.0,
      "end": 9752.0,
      "formatted_start": "02:42:30.000",
      "formatted_end": "02:42:32.000",
      "text": "اینجور دیگه شده"
    },
    {
      "id": 41,
      "start": 9752.0,
      "end": 9754.0,
      "formatted_start": "02:42:32.000",
      "formatted_end": "02:42:34.000",
      "text": "الان داری شکل پسوریازیست میشید"
    },
    {
      "id": 42,
      "start": 9754.0,
      "end": 9756.0,
      "formatted_start": "02:42:34.000",
      "formatted_end": "02:42:36.000",
      "text": "اکزم ها رو سرت زانو دو طرفه نمیگه"
    },
    {
      "id": 43,
      "start": 9756.0,
      "end": 9758.0,
      "formatted_start": "02:42:36.000",
      "formatted_end": "02:42:38.000",
      "text": "اینجا ها چی؟"
    },
    {
      "id": 44,
      "start": 9758.0,
      "end": 9760.0,
      "formatted_start": "02:42:38.000",
      "formatted_end": "02:42:40.000",
      "text": "اینجا ها میموندت شد"
    },
    {
      "id": 45,
      "start": 9760.0,
      "end": 9762.0,
      "formatted_start": "02:42:40.000",
      "formatted_end": "02:42:42.000",
      "text": "این وستنت ها شد"
    },
    {
      "id": 46,
      "start": 9762.0,
      "end": 9764.0,
      "formatted_start": "02:42:42.000",
      "formatted_end": "02:42:44.000",
      "text": "پسوریازیسته تا اکزم ها"
    },
    {
      "id": 47,
      "start": 9764.0,
      "end": 9766.0,
      "formatted_start": "02:42:44.000",
      "formatted_end": "02:42:46.000",
      "text": "قد که نداری نه؟"
    },
    {
      "id": 48,
      "start": 9766.0,
      "end": 9768.0,
      "formatted_start": "02:42:46.000",
      "formatted_end": "02:42:48.000",
      "text": "قد نه"
    },
    {
      "id": 49,
      "start": 9768.0,
      "end": 9770.0,
      "formatted_start": "02:42:48.000",
      "formatted_end": "02:42:50.000",
      "text": "تا حالا که نداشتی؟"
    },
    {
      "id": 50,
      "start": 9770.0,
      "end": 9772.0,
      "formatted_start": "02:42:50.000",
      "formatted_end": "02:42:52.000",
      "text": "نه نداشتم"
    },
    {
      "id": 51,
      "start": 9772.0,
      "end": 9774.0,
      "formatted_start": "02:42:52.000",
      "formatted_end": "02:42:54.000",
      "text": "پدر مادر جان ندارم؟"
    },
    {
      "id": 52,
      "start": 9774.0,
      "end": 9776.0,
      "formatted_start": "02:42:54.000",
      "formatted_end": "02:42:56.000",
      "text": "نه ندارم"
    },
    {
      "id": 53,
      "start": 9776.0,
      "end": 9778.0,
      "formatted_start": "02:42:56.000",
      "formatted_end": "02:42:58.000",
      "text": "نه ندارم"
    },
    {
      "id": 54,
      "start": 9778.0,
      "end": 9784.0,
      "formatted_start": "02:42:58.000",
      "formatted_end": "02:43:04.000",
      "text": "حالا هر جور خودت سلام میتونی ترجیم هایی میگه تیرویدتو چک کنی"
    },
    {
      "id": 55,
      "start": 9784.0,
      "end": 9786.0,
      "formatted_start": "02:43:04.000",
      "formatted_end": "02:43:06.000",
      "text": "حالا خوب خیلی منفصل نواز بشم"
    },
    {
      "id": 56,
      "start": 9786.0,
      "end": 9788.0,
      "formatted_start": "02:43:06.000",
      "formatted_end": "02:43:08.000",
      "text": "من لاشته باشم؟"
    },
    {
      "id": 57,
      "start": 9788.0,
      "end": 9790.0,
      "formatted_start": "02:43:08.000",
      "formatted_end": "02:43:10.000",
      "text": "آره"
    },
    {
      "id": 58,
      "start": 9790.0,
      "end": 9792.0,
      "formatted_start": "02:43:10.000",
      "formatted_end": "02:43:12.000",
      "text": "بده به بچه ها با من لاشون برن"
    },
    {
      "id": 59,
      "start": 9792.0,
      "end": 9796.0,
      "formatted_start": "02:43:12.000",
      "formatted_end": "02:43:16.000",
      "text": "اگه مشکلی داشت باید باید صحبت کنی"
    },
    {
      "id": 60,
      "start": 9796.0,
      "end": 9798.0,
      "formatted_start": "02:43:16.000",
      "formatted_end": "02:43:18.000",
      "text": "باش"
    },
    {
      "id": 61,
      "start": 9798.0,
      "end": 9800.0,
      "formatted_start": "02:43:18.000",
      "formatted_end": "02:43:20.000",
      "text": "خوب سه تنها میشه خوب سه آنها برن"
    },
    {
      "id": 62,
      "start": 9800.0,
      "end": 9802.0,
      "formatted_start": "02:43:20.000",
      "formatted_end": "02:43:22.000",
      "text": "برو سرمی و بخور"
    },
    {
      "id": 63,
      "start": 9802.0,
      "end": 9804.0,
      "formatted_start": "02:43:22.000",
      "formatted_end": "02:43:24.000",
      "text": "پریود میشی؟"
    },
    {
      "id": 64,
      "start": 9804.0,
      "end": 9806.0,
      "formatted_start": "02:43:24.000",
      "formatted_end": "02:43:26.000",
      "text": "پریود میشم آره"
    },
    {
      "id": 65,
      "start": 9806.0,
      "end": 9808.0,
      "formatted_start": "02:43:26.000",
      "formatted_end": "02:43:28.000",
      "text": "زیاد افتاده زید؟"
    },
    {
      "id": 66,
      "start": 9808.0,
      "end": 9810.0,
      "formatted_start": "02:43:28.000",
      "formatted_end": "02:43:30.000",
      "text": "یکی دو ماه خوب شده است"
    },
    {
      "id": 67,
      "start": 9810.0,
      "end": 9812.0,
      "formatted_start": "02:43:30.000",
      "formatted_end": "02:43:32.000",
      "text": "یعنی دو سویز اول زیاد شده است"
    },
    {
      "id": 68,
      "start": 9812.0,
      "end": 9815.0,
      "formatted_start": "02:43:32.000",
      "formatted_end": "02:43:35.000",
      "text": "در هر صورت بعد فرصا هم یه روز درمی بخوره خب؟"
    },
    {
      "id": 69,
      "start": 9815.0,
      "end": 9817.0,
      "formatted_start": "02:43:35.000",
      "formatted_end": "02:43:37.000",
      "text": "ببینید، از این سریتی خیلی دارم"
    },
    {
      "id": 70,
      "start": 9817.0,
      "end": 9820.0,
      "formatted_start": "02:43:37.000",
      "formatted_end": "02:43:40.000",
      "text": "آمانی، اصلا به من از ایک کمخور باشی"
    },
    {
      "id": 71,
      "start": 9820.0,
      "end": 9824.0,
      "formatted_start": "02:43:40.000",
      "formatted_end": "02:43:44.000",
      "text": "اولی بیماری که با کمخور رو بود بیمار اکزما و پیزویاتی بیماری خوب است"
    },
    {
      "id": 72,
      "start": 9828.0,
      "end": 9830.0,
      "formatted_start": "02:43:48.000",
      "formatted_end": "02:43:50.000",
      "text": "پس من بخورم براتون جسی رو اکنشتم خب؟"
    },
    {
      "id": 73,
      "start": 9830.0,
      "end": 9831.0,
      "formatted_start": "02:43:50.000",
      "formatted_end": "02:43:51.000",
      "text": "کم شد؟"
    },
    {
      "id": 74,
      "start": 9831.0,
      "end": 9832.0,
      "formatted_start": "02:43:51.000",
      "formatted_end": "02:43:52.000",
      "text": "خب"
    },
    {
      "id": 75,
      "start": 9832.0,
      "end": 9834.0,
      "formatted_start": "02:43:52.000",
      "formatted_end": "02:43:54.000",
      "text": "مردم در اینجا باید برداریم"
    },
    {
      "id": 76,
      "start": 9834.0,
      "end": 9836.0,
      "formatted_start": "02:43:54.000",
      "formatted_end": "02:43:56.000",
      "text": "باید برداریم"
    },
    {
      "id": 77,
      "start": 9836.0,
      "end": 9838.0,
      "formatted_start": "02:43:56.000",
      "formatted_end": "02:43:58.000",
      "text": "باید برداریم"
    },
    {
      "id": 78,
      "start": 9838.0,
      "end": 9840.0,
      "formatted_start": "02:43:58.000",
      "formatted_end": "02:44:00.000",
      "text": "باید برداریم"
    },
    {
      "id": 79,
      "start": 9840.0,
      "end": 9842.0,
      "formatted_start": "02:44:00.000",
      "formatted_end": "02:44:02.000",
      "text": "باید برداریم"
    },
    {
      "id": 80,
      "start": 9842.0,
      "end": 9844.0,
      "formatted_start": "02:44:02.000",
      "formatted_end": "02:44:04.000",
