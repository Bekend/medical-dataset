      "end": 3724.0,
      "formatted_start": "01:02:02.000",
      "formatted_end": "01:02:04.000",
      "text": "با رو خویه"
    },
    {
      "id": 5,
      "start": 3724.0,
      "end": 3728.0,
      "formatted_start": "01:02:04.000",
      "formatted_end": "01:02:08.000",
      "text": "به داروخانه بگو مسائل های سلام همه ندادید"
    },
    {
      "id": 6,
      "start": 3735.0,
      "end": 3737.0,
      "formatted_start": "01:02:15.000",
      "formatted_end": "01:02:17.000",
      "text": "باید"
    },
    {
      "id": 7,
      "start": 3738.0,
      "end": 3741.0,
      "formatted_start": "01:02:18.000",
      "formatted_end": "01:02:21.000",
      "text": "این را سرنگ بست داریم"
    },
    {
      "id": 8,
      "start": 3741.0,
      "end": 3744.0,
      "formatted_start": "01:02:21.000",
      "formatted_end": "01:02:24.000",
      "text": "می دارم اینجا تا پرده ها می آمید"
    },
    {
      "id": 9,
      "start": 3744.0,
      "end": 3746.0,
      "formatted_start": "01:02:24.000",
      "formatted_end": "01:02:26.000",
      "text": "بله"
    },
    {
      "id": 10,
      "start": 3752.0,
      "end": 3778.0,
      "formatted_start": "01:02:32.000",
      "formatted_end": "01:02:58.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 3778.0,
      "end": 3780.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:00.000",
      "text": "بچه ها اینو چگونه کنی؟"
    },
    {
      "id": 12,
      "start": 3780.0,
      "end": 3782.0,
      "formatted_start": "01:03:00.000",
      "formatted_end": "01:03:02.000",
