    },
    {
      "id": 4,
      "start": 5210.0,
      "end": 5239.98,
      "formatted_start": "01:26:50.000",
      "formatted_end": "01:27:19.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 5,
      "start": 5240.0,
      "end": 5268.0,
      "formatted_start": "01:27:20.000",
      "formatted_end": "01:27:48.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 5270.0,
      "end": 5290.0,
      "formatted_start": "01:27:50.000",
      "formatted_end": "01:28:10.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 5300.0,
      "end": 5310.0,
      "formatted_start": "01:28:20.000",
      "formatted_end": "01:28:30.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 5310.0,
      "end": 5324.0,
      "formatted_start": "01:28:30.000",
      "formatted_end": "01:28:44.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 5324.0,
      "end": 5326.0,
      "formatted_start": "01:28:44.000",
      "formatted_end": "01:28:46.000",
      "text": "این آقا موزی"
    },
    {
      "id": 10,
      "start": 5326.0,
      "end": 5328.0,
      "formatted_start": "01:28:46.000",
      "formatted_end": "01:28:48.000",
      "text": "چون زنبا رو کشیدین؟"
    },
    {
      "id": 11,
      "start": 5328.0,
      "end": 5330.0,
      "formatted_start": "01:28:48.000",
      "formatted_end": "01:28:50.000",
      "text": "خیلی زحمت کشیدین"
    },
    {
      "id": 12,
      "start": 5330.0,
      "end": 5334.0,
      "formatted_start": "01:28:50.000",
      "formatted_end": "01:28:54.000",
      "text": "خیلی همون اتماه به با آن همین زحمت کشیدین"
    },
    {
      "id": 13,
      "start": 5334.0,
      "end": 5337.0,
      "formatted_start": "01:28:54.000",
      "formatted_end": "01:28:57.000",
      "text": "شرمنده کردین، لستتون دردن کنن؟"
    },
    {
      "id": 14,
      "start": 5337.0,
      "end": 5339.0,
      "formatted_start": "01:28:57.000",
      "formatted_end": "01:28:59.000",
      "text": "نه، شرمنده"
    },
    {
      "id": 15,
      "start": 5339.0,
      "end": 5341.0,
      "formatted_start": "01:28:59.000",
      "formatted_end": "01:29:01.000",
      "text": "خدا خیلی اتون بده"
    },
    {
      "id": 16,
      "start": 5343.0,
      "end": 5345.0,
      "formatted_start": "01:29:03.000",
      "formatted_end": "01:29:05.000",
      "text": "ببخشید، شرمنده شما شدید"
    },
    {
      "id": 17,
      "start": 5345.0,
      "end": 5348.0,
      "formatted_start": "01:29:05.000",
      "formatted_end": "01:29:08.000",
      "text": "نه، ببخشید شما نه، آقا موزی"
    },
    {
      "id": 18,
      "start": 5348.0,
      "end": 5350.0,
      "formatted_start": "01:29:08.000",
      "formatted_end": "01:29:10.000",
      "text": "چون خواه موسیقی جا؟"
    },
    {
      "id": 19,
      "start": 5350.0,
      "end": 5352.0,
      "formatted_start": "01:29:10.000",
      "formatted_end": "01:29:12.000",
      "text": "چرا؟"
    },
    {
      "id": 20,
      "start": 5352.0,
      "end": 5353.0,
      "formatted_start": "01:29:12.000",
      "formatted_end": "01:29:13.000",
      "text": "چو شده؟"
    },
    {
      "id": 21,
      "start": 5353.0,
      "end": 5357.0,
      "formatted_start": "01:29:13.000",
      "formatted_end": "01:29:17.000",
      "text": "من قبل همه چون سر اونجا فیلی درد میکند"
    },
    {
      "id": 22,
      "start": 5357.0,
      "end": 5358.0,
      "formatted_start": "01:29:17.000",
      "formatted_end": "01:29:18.000",
      "text": "چند روزه؟"
    },
    {
      "id": 23,
      "start": 5358.0,
      "end": 5362.0,
      "formatted_start": "01:29:18.000",
      "formatted_end": "01:29:22.000",
      "text": "الان از دیروز زیاد سرم درد میکنم و بیهارم زیاد"
    },
    {
      "id": 24,
      "start": 5362.0,
      "end": 5365.0,
      "formatted_start": "01:29:22.000",
      "formatted_end": "01:29:25.000",
      "text": "بچه ها دربار سرمو نخورده بودن؟"
    },
    {
      "id": 25,
      "start": 5365.0,
      "end": 5369.0,
      "formatted_start": "01:29:25.000",
      "formatted_end": "01:29:29.000",
      "text": "نه، رفتم بشد اینا جمعیتی"
    },
    {
      "id": 26,
      "start": 5369.0,
      "end": 5371.0,
      "formatted_start": "01:29:29.000",
      "formatted_end": "01:29:31.000",
      "text": "از درمازه داشتن"
    },
    {
      "id": 27,
      "start": 5371.0,
      "end": 5374.0,
      "formatted_start": "01:29:31.000",
      "formatted_end": "01:29:34.000",
      "text": "باد تو سرسورتتون میخورد، درد از اون بدتر میشه؟"
    },
    {
      "id": 28,
      "start": 5374.0,
      "end": 5378.0,
      "formatted_start": "01:29:34.000",
      "formatted_end": "01:29:38.000",
      "text": "آره، وقتی باد زیاد میکنم، بشانی هم فیلی درد میکند"
    },
    {
      "id": 29,
      "start": 5378.0,
      "end": 5380.0,
      "formatted_start": "01:29:38.000",
      "formatted_end": "01:29:40.000",
      "text": "این پاهم منو زیاد خوارش میکند"
    },
    {
      "id": 30,
      "start": 5380.0,
      "end": 5383.0,
      "formatted_start": "01:29:40.000",
      "formatted_end": "01:29:43.000",
      "text": "ببینم زخمم شده؟"
    },
    {
      "id": 31,
      "start": 5383.0,
      "end": 5385.0,
      "formatted_start": "01:29:43.000",
      "formatted_end": "01:29:45.000",
      "text": "آه اینجوری"
    },
    {
      "id": 32,
      "start": 5385.0,
      "end": 5386.0,
      "formatted_start": "01:29:45.000",
      "formatted_end": "01:29:46.000",
      "text": "زخمم میشه نه؟"
    },
    {
      "id": 33,
      "start": 5386.0,
      "end": 5387.0,
      "formatted_start": "01:29:46.000",
      "formatted_end": "01:29:47.000",
      "text": "وقتی مقارم زیاد"
    },
    {
      "id": 34,
      "start": 5387.0,
      "end": 5389.0,
      "formatted_start": "01:29:47.000",
      "formatted_end": "01:29:49.000",
      "text": "شبها خارشش بیشتر میشه؟"
    },
    {
      "id": 35,
      "start": 5389.0,
      "end": 5392.0,
      "formatted_start": "01:29:49.000",
      "formatted_end": "01:29:52.000",
      "text": "آره شبها خارشش بیشتر میشه، نه نه نه نه خارش نمیده"
    },
    {
      "id": 36,
      "start": 5392.0,
      "end": 5394.0,
      "formatted_start": "01:29:52.000",
      "formatted_end": "01:29:54.000",
      "text": "اما شبها"
    },
    {
      "id": 37,
      "start": 5394.0,
      "end": 5396.0,
      "formatted_start": "01:29:54.000",
      "formatted_end": "01:29:56.000",
      "text": "خب گلچین جان"
    }
  ],
  "status": "completed"
}