    },
    {
      "id": 4,
      "start": 1636.0,
      "end": 1646.0,
      "formatted_start": "00:27:16.000",
      "formatted_end": "00:27:26.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 1666.0,
      "end": 1668.0,
      "formatted_start": "00:27:46.000",
      "formatted_end": "00:27:48.000",
      "text": "بیا نمر باید"
    },
    {
      "id": 6,
      "start": 1668.0,
      "end": 1670.0,
      "formatted_start": "00:27:48.000",
      "formatted_end": "00:27:50.000",
      "text": "باید"
    },
    {
      "id": 7,
      "start": 1696.0,
      "end": 1698.0,
      "formatted_start": "00:28:16.000",
      "formatted_end": "00:28:18.000",
      "text": "چیه؟"
    },
    {
      "id": 8,
      "start": 1698.0,
      "end": 1700.0,
      "formatted_start": "00:28:18.000",
      "formatted_end": "00:28:20.000",
      "text": "بیتمر"
    },
    {
      "id": 9,
      "start": 1700.0,
      "end": 1702.0,
      "formatted_start": "00:28:20.000",
      "formatted_end": "00:28:22.000",
      "text": "نه دیگه همون"
    },
    {
      "id": 10,
      "start": 1702.0,
      "end": 1704.0,
      "formatted_start": "00:28:22.000",
      "formatted_end": "00:28:24.000",
      "text": "یا گلوتریو"
    },
    {
      "id": 11,
      "start": 1704.0,
      "end": 1706.0,
      "formatted_start": "00:28:24.000",
      "formatted_end": "00:28:26.000",
      "text": "یا گلوتریو"
    },
    {
      "id": 12,
      "start": 1706.0,
      "end": 1708.0,
      "formatted_start": "00:28:26.000",
      "formatted_end": "00:28:28.000",
      "text": "اینا ترکیبی هستن"
    },
    {
      "id": 13,
      "start": 1708.0,
      "end": 1710.0,
      "formatted_start": "00:28:28.000",
      "formatted_end": "00:28:30.000",
      "text": "رفته بشو یه شگر دیگه داره"
    },
    {
      "id": 14,
      "start": 1710.0,
      "end": 1712.0,
      "formatted_start": "00:28:30.000",
      "formatted_end": "00:28:32.000",
      "text": "بچه گلوتریو نگرستی؟"
    },
    {
      "id": 15,
      "start": 1712.0,
      "end": 1714.0,
      "formatted_start": "00:28:32.000",
      "formatted_end": "00:28:34.000",
      "text": "گلوتریو چند؟"
    },
    {
      "id": 16,
      "start": 1714.0,
      "end": 1716.0,
      "formatted_start": "00:28:34.000",
      "formatted_end": "00:28:36.000",
      "text": "ده پنت هزار"
    },
    {
      "id": 17,
      "start": 1716.0,
      "end": 1718.0,
      "formatted_start": "00:28:36.000",
      "formatted_end": "00:28:38.000",
      "text": "بیسته پنت پنت هزار چند؟"
    },
    {
      "id": 18,
      "start": 1718.0,
      "end": 1720.0,
      "formatted_start": "00:28:38.000",
      "formatted_end": "00:28:40.000",
      "text": "همونه"
    },
    {
      "id": 19,
      "start": 1720.0,
      "end": 1722.0,
      "formatted_start": "00:28:40.000",
      "formatted_end": "00:28:42.000",
      "text": "همونه نه"
    },
    {
      "id": 20,
      "start": 1722.0,
      "end": 1724.0,
      "formatted_start": "00:28:42.000",
      "formatted_end": "00:28:44.000",
      "text": "قشن دقیق برگردنشون"
    },
    {
      "id": 21,
      "start": 1724.0,
      "end": 1726.0,
      "formatted_start": "00:28:44.000",
      "formatted_end": "00:28:46.000",
      "text": "دیابت هست"
    },
    {
      "id": 22,
      "start": 1726.0,
      "end": 1728.0,
      "formatted_start": "00:28:46.000",
      "formatted_end": "00:28:48.000",
      "text": "برقوتیش اینه"
    },
    {
      "id": 23,
      "start": 1728.0,
      "end": 1730.0,
      "formatted_start": "00:28:48.000",
      "formatted_end": "00:28:50.000",
      "text": "این ده پنج هزاره"
    },
    {
      "id": 24,
      "start": 1730.0,
      "end": 1732.0,
      "formatted_start": "00:28:50.000",
      "formatted_end": "00:28:52.000",
      "text": "خب ما پنج پونج هزار هم داریم"
    },
    {
      "id": 25,
      "start": 1732.0,
      "end": 1734.0,
      "formatted_start": "00:28:52.000",
      "formatted_end": "00:28:54.000",
      "text": "پنج پونج هزار هم داریم"
    },
    {
      "id": 26,
      "start": 1734.0,
      "end": 1736.0,
      "formatted_start": "00:28:54.000",
      "formatted_end": "00:28:56.000",
      "text": "پنج پونج هزار هم داریم"
    },
    {
      "id": 27,
      "start": 1736.0,
      "end": 1738.0,
      "formatted_start": "00:28:56.000",
      "formatted_end": "00:28:58.000",
      "text": "همینه"
    },
    {
      "id": 28,
      "start": 1738.0,
      "end": 1740.0,
      "formatted_start": "00:28:58.000",
      "formatted_end": "00:29:00.000",
      "text": "سلام علیک"
    },
    {
      "id": 29,
      "start": 1740.0,
      "end": 1742.0,
      "formatted_start": "00:29:00.000",
      "formatted_end": "00:29:02.000",
      "text": "حرکت سلام"
    },
    {
      "id": 30,
      "start": 1742.0,
      "end": 1744.0,
      "formatted_start": "00:29:02.000",
      "formatted_end": "00:29:04.000",
      "text": "چنده"
    },
    {
      "id": 31,
      "start": 1744.0,
      "end": 1746.0,
      "formatted_start": "00:29:04.000",
      "formatted_end": "00:29:06.000",
      "text": "خوبی"
    },
    {
      "id": 32,
      "start": 1746.0,
      "end": 1748.0,
      "formatted_start": "00:29:06.000",
      "formatted_end": "00:29:08.000",
      "text": "پلیسولات گرفتی"
    },
    {
      "id": 33,
      "start": 1748.0,
      "end": 1750.0,
      "formatted_start": "00:29:08.000",
      "formatted_end": "00:29:10.000",
      "text": "این ده په هزار"
    },
    {
      "id": 34,
      "start": 1750.0,
      "end": 1752.0,
      "formatted_start": "00:29:10.000",
      "formatted_end": "00:29:12.000",
      "text": "ده په هزار بزنم"
    },
    {
      "id": 35,
      "start": 1752.0,
      "end": 1757.0,
      "formatted_start": "00:29:12.000",
      "formatted_end": "00:29:17.000",
      "text": "باید الان ملی خود... الان باید کارتون چی نوشته؟"
    },
    {
      "id": 36,
      "start": 1757.0,
      "end": 1759.0,
      "formatted_start": "00:29:17.000",
      "formatted_end": "00:29:19.000",
      "text": "کارتون نره باشه..."
    },
    {
      "id": 37,
      "start": 1759.0,
      "end": 1762.0,
