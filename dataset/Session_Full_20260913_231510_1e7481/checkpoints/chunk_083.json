      "end": 24933.0,
      "formatted_start": "06:55:31.000",
      "formatted_end": "06:55:33.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 18,
      "start": 24933.0,
      "end": 24935.0,
      "formatted_start": "06:55:33.000",
      "formatted_end": "06:55:35.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 19,
      "start": 24935.0,
      "end": 24937.0,
      "formatted_start": "06:55:35.000",
      "formatted_end": "06:55:37.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 20,
      "start": 24937.0,
      "end": 24939.0,
      "formatted_start": "06:55:37.000",
      "formatted_end": "06:55:39.000",
      "text": "ما رایگان"
    },
    {
      "id": 21,
      "start": 24939.0,
      "end": 24941.0,
      "formatted_start": "06:55:39.000",
      "formatted_end": "06:55:41.000",
      "text": "ما رایگان"
    },
    {
      "id": 22,
      "start": 24941.0,
      "end": 24943.0,
      "formatted_start": "06:55:41.000",
      "formatted_end": "06:55:43.000",
      "text": "فردا خواستی زنگی که از تو باید تونه عوض بده"
    },
    {
      "id": 23,
      "start": 24943.0,
      "end": 24945.0,
      "formatted_start": "06:55:43.000",
      "formatted_end": "06:55:45.000",
      "text": "فردا خواستی زنگی که از تو باید تونه عوض بده"
    },
    {
      "id": 24,
      "start": 24945.0,
      "end": 24947.0,
      "formatted_start": "06:55:45.000",
      "formatted_end": "06:55:47.000",
      "text": "فردا خواستی زنگی که از تو باید تونه عوض بده"
    },
    {
      "id": 25,
      "start": 24947.0,
      "end": 24949.0,
      "formatted_start": "06:55:47.000",
      "formatted_end": "06:55:49.000",
      "text": "فردا خواستی زنگی که از تو باید تونه عوض بده"
    },
    {
      "id": 26,
      "start": 24949.0,
      "end": 24951.0,
      "formatted_start": "06:55:49.000",
      "formatted_end": "06:55:51.000",
      "text": "اون شما موشک سیفتی هستد"
    },
    {
      "id": 27,
      "start": 24951.0,
      "end": 24953.0,
      "formatted_start": "06:55:51.000",
      "formatted_end": "06:55:53.000",
      "text": "اون شما موشک سیفتی هستد"
    },
    {
      "id": 28,
      "start": 24953.0,
      "end": 24955.0,
      "formatted_start": "06:55:53.000",
      "formatted_end": "06:55:55.000",
      "text": "اون شما موشک سیفتی هستد"
    },
    {
      "id": 29,
      "start": 24955.0,
      "end": 24957.0,
      "formatted_start": "06:55:55.000",
      "formatted_end": "06:55:57.000",
      "text": "اون شما موشک سیفتی هستد"
    },
    {
      "id": 30,
      "start": 24957.0,
      "end": 24959.5,
      "formatted_start": "06:55:57.000",
      "formatted_end": "06:55:59.500",
      "text": "اداره گاز که نام رو بینداد"
    },
    {
      "id": 31,
      "start": 24959.5,
      "end": 24962.34,
      "formatted_start": "06:55:59.500",
      "formatted_end": "06:56:02.340",
      "text": "نه خیلی دیگه برم اداره گاز"
    },
    {
      "id": 32,
      "start": 24962.34,
      "end": 24964.58,
      "formatted_start": "06:56:02.340",
      "formatted_end": "06:56:04.580",
      "text": "اول سی جواد دیدم"
    },
    {
      "id": 33,
      "start": 24964.58,
      "end": 24966.88,
      "formatted_start": "06:56:04.580",
      "formatted_end": "06:56:06.880",
      "text": "سی جواد خودم و سرمان"
    },
    {
      "id": 34,
      "start": 24966.88,
      "end": 24968.92,
      "formatted_start": "06:56:06.880",
      "formatted_end": "06:56:08.920",
      "text": "برم سی جواد اینها چه برو اسکن کن"
    },
    {
      "id": 35,
      "start": 24968.92,
      "end": 24970.92,
      "formatted_start": "06:56:08.920",
      "formatted_end": "06:56:10.920",
      "text": "همه پر مفترم برد اسکن کن"
    },
    {
      "id": 36,
      "start": 24970.92,
      "end": 24972.74,
      "formatted_start": "06:56:10.920",
      "formatted_end": "06:56:12.740",
      "text": "آره رفتن تو در تبتر پیشخان نشست"
    },
    {
      "id": 37,
      "start": 24972.74,
      "end": 24975.14,
      "formatted_start": "06:56:12.740",
      "formatted_end": "06:56:15.140",
      "text": "این رو برم به دیوار بچست کنیم"
    },
    {
      "id": 38,
      "start": 24975.14,
      "end": 24976.14,
      "formatted_start": "06:56:15.140",
      "formatted_end": "06:56:16.140",
      "text": "نداری؟"
    },
    {
      "id": 39,
      "start": 24976.14,
      "end": 24977.6,
      "formatted_start": "06:56:16.140",
      "formatted_end": "06:56:17.600",
      "text": "بابا سخته خب"
    },
    {
      "id": 40,
      "start": 24977.6,
      "end": 24980.94,
      "formatted_start": "06:56:17.600",
      "formatted_end": "06:56:20.940",
      "text": "دیگه برم با این رو مساید این تا اسکن کنه"
    },
    {
      "id": 41,
      "start": 24980.94,
      "end": 24983.12,
      "formatted_start": "06:56:20.940",
      "formatted_end": "06:56:23.120",
      "text": "من برم سنده مریض بزنم کن"
    },
    {
      "id": 42,
      "start": 24983.12,
      "end": 24985.12,
      "formatted_start": "06:56:23.120",
      "formatted_end": "06:56:25.120",
      "text": "یه رو بیست اقیت بکشن"
    },
    {
      "id": 43,
      "start": 24985.12,
      "end": 24987.12,
      "formatted_start": "06:56:25.120",
      "formatted_end": "06:56:27.120",
      "text": "بعد از سنده اون زنده رو بزنم دیدم"
    },
    {
      "id": 44,
      "start": 24987.12,
      "end": 24989.12,
      "formatted_start": "06:56:27.120",
      "formatted_end": "06:56:29.120",
      "text": "لختش کردن بیچاره رو گذاشتن"
    },
    {
      "id": 45,
      "start": 24989.12,
      "end": 24991.12,
      "formatted_start": "06:56:29.120",
      "formatted_end": "06:56:31.120",
      "text": "شویر در همون"
    },
    {
      "id": 46,
      "start": 24991.12,
      "end": 24993.12,
      "formatted_start": "06:56:31.120",
      "formatted_end": "06:56:33.120",
      "text": "زورشون بزرگ نکشنندن"
    },
    {
      "id": 47,
      "start": 24993.12,
      "end": 24995.12,
      "formatted_start": "06:56:33.120",
      "formatted_end": "06:56:35.120",
      "text": "اون کارگره که دفعه هم اون پرست هایی که نگهش بیدن"
    },
    {
      "id": 48,
      "start": 24995.12,
      "end": 24997.12,
      "formatted_start": "06:56:35.120",
      "formatted_end": "06:56:37.120",
      "text": "چی؟ باید چی تو اتاق خوابیده"
    },
    {
      "id": 49,
      "start": 24997.12,
      "end": 24999.12,
      "formatted_start": "06:56:37.120",
      "formatted_end": "06:56:39.120",
      "text": "ساعتش از ساعت هشت تا یک بعد از آره مخابر"
    },
    {
      "id": 50,
      "start": 24999.12,
      "end": 25001.12,
      "formatted_start": "06:56:39.120",
      "formatted_end": "06:56:41.120",
      "text": "بزن خوابیده اون بیدانش کنیم"
    },
    {
      "id": 51,
      "start": 25001.12,
      "end": 25003.12,
      "formatted_start": "06:56:41.120",
      "formatted_end": "06:56:43.120",
      "text": "که بیا دیر ببرش همم"
    },
    {
      "id": 52,
      "start": 25003.12,
      "end": 25005.12,
      "formatted_start": "06:56:43.120",
      "formatted_end": "06:56:45.120",
      "text": "مایو 14 میدونم"
    },
    {
      "id": 53,
      "start": 25005.12,
      "end": 25007.12,
      "formatted_start": "06:56:45.120",
      "formatted_end": "06:56:47.120",
      "text": "توی توارین چی گفته؟"
    },
    {
      "id": 54,
      "start": 25007.12,
      "end": 25009.12,
      "formatted_start": "06:56:47.120",
      "formatted_end": "06:56:49.120",
      "text": "نه پرسیدن بگو"
    },
    {
      "id": 55,
      "start": 25009.12,
      "end": 25011.12,
      "formatted_start": "06:56:49.120",
      "formatted_end": "06:56:51.120",
      "text": "من دیگه لخته دیگه دو نفر من میرم برازو میاد سندشو مزنم"
    },
    {
      "id": 56,
      "start": 25011.12,
      "end": 25013.12,
      "formatted_start": "06:56:51.120",
      "formatted_end": "06:56:53.120",
      "text": "یک نداشت خوب شده"
    },
    {
      "id": 57,
      "start": 25013.12,
      "end": 25015.12,
      "formatted_start": "06:56:53.120",
      "formatted_end": "06:56:55.120",
      "text": "مایویش میکنه خانه روتو"
    },
    {
      "id": 58,
      "start": 25015.12,
      "end": 25017.12,
      "formatted_start": "06:56:55.120",
      "formatted_end": "06:56:57.120",
      "text": "اون دیگه تمام شده نفرده نداره"
    },
    {
      "id": 59,
      "start": 25017.12,
      "end": 25019.12,
      "formatted_start": "06:56:57.120",
      "formatted_end": "06:56:59.120",
      "text": "آه روتو شده شل شده"
    },
    {
      "id": 60,
      "start": 25019.12,
      "end": 25021.12,
      "formatted_start": "06:56:59.120",
      "formatted_end": "06:57:01.120",
      "text": "مگه دستشویش صرف ده یا برای مگه متوجه نمیشه"
    },
    {
      "id": 61,
      "start": 25021.12,
      "end": 25023.12,
      "formatted_start": "06:57:01.120",
      "formatted_end": "06:57:03.120",
      "text": "از حالش خوب شد"
    },
    {
      "id": 62,
      "start": 25023.12,
      "end": 25025.12,
      "formatted_start": "06:57:03.120",
      "formatted_end": "06:57:05.120",
      "text": "بابا من کل هم توبش کردم"
    },
    {
      "id": 63,
      "start": 25025.12,
      "end": 25027.12,
      "formatted_start": "06:57:05.120",
      "formatted_end": "06:57:07.120",
      "text": "پس چی باید دستشویشو نمیگه؟"
    },
    {
      "id": 64,
      "start": 25027.12,
      "end": 25029.12,
      "formatted_start": "06:57:07.120",
      "formatted_end": "06:57:09.120",
      "text": "خیلی خوب شد دیگه"
    },
    {
      "id": 65,
      "start": 25029.12,
      "end": 25031.12,
      "formatted_start": "06:57:09.120",
      "formatted_end": "06:57:11.120",
      "text": "یعنی لمجش عالی بود مؤخش شد"
    },
    {
      "id": 66,
      "start": 25031.12,
      "end": 25033.12,
      "formatted_start": "06:57:11.120",
      "formatted_end": "06:57:13.120",
      "text": "هرم خوب بود پاش و هرمش کم بود"
    },
    {
      "id": 67,
      "start": 25033.12,
      "end": 25035.12,
      "formatted_start": "06:57:13.120",
      "formatted_end": "06:57:15.120",
      "text": "بیرون خوبه قشنگ هزار میخورد"
    },
    {
      "id": 68,
      "start": 25035.12,
      "end": 25037.12,
      "formatted_start": "06:57:15.120",
      "formatted_end": "06:57:17.120",
      "text": "و یه جایی باید شمال آزاده های بینستن"
    },
    {
      "id": 69,
      "start": 25037.12,
      "end": 25039.12,
      "formatted_start": "06:57:17.120",
      "formatted_end": "06:57:19.120",
      "text": "مثلا هرم از کدومیلی بیشتر"
    },
    {
      "id": 70,
      "start": 25039.12,
      "end": 25041.12,
      "formatted_start": "06:57:19.120",
      "formatted_end": "06:57:21.120",
      "text": "شمال نیست کدومیلی خواهم دوز"
    },
    {
      "id": 71,
      "start": 25041.12,
      "end": 25043.12,
      "formatted_start": "06:57:21.120",
      "formatted_end": "06:57:23.120",
      "text": "قشنگ یاد داشت برن"
    },
    {
      "id": 72,
      "start": 25043.12,
      "end": 25045.12,
      "formatted_start": "06:57:23.120",
      "formatted_end": "06:57:25.120",
      "text": "مثل مخاطبین هست"
    },
    {
      "id": 73,
      "start": 25045.12,
      "end": 25047.12,
      "formatted_start": "06:57:25.120",
      "formatted_end": "06:57:27.120",
      "text": "آخه ببین مثلا فامیله آدم زن که"
    },
    {
      "id": 74,
      "start": 25047.12,
      "end": 25049.12,
      "formatted_start": "06:57:27.120",
      "formatted_end": "06:57:29.120",
      "text": "دارو میخوان"
    },
    {
      "id": 75,
      "start": 25049.12,
      "end": 25051.12,
      "formatted_start": "06:57:29.120",
      "formatted_end": "06:57:31.120",
      "text": "فکر میکنه"
    },
    {
      "id": 76,
      "start": 25051.12,
      "end": 25053.12,
      "formatted_start": "06:57:31.120",
      "formatted_end": "06:57:33.120",
      "text": "از اینجا همه دارو بیشتر"
    },
    {
      "id": 77,
      "start": 25053.12,
      "end": 25056.78,
      "formatted_start": "06:57:33.120",
      "formatted_end": "06:57:36.780",
      "text": "ببین مثلا فامیله آدم زن که دارو میخوان"
    },
    {
      "id": 78,
      "start": 25056.78,
      "end": 25059.28,
      "formatted_start": "06:57:36.780",
      "formatted_end": "06:57:39.280",
      "text": "فکر میکنه من مثلا چون یه بار کوده مدی دادم"
    },
    {
      "id": 79,
      "start": 25059.28,
      "end": 25061.76,
      "formatted_start": "06:57:39.280",
      "formatted_end": "06:57:41.760",
      "text": "همه اینها فکرم رو باید تیجه بی سبت کنم"
    },
    {
      "id": 80,
      "start": 25061.76,
      "end": 25063.48,
      "formatted_start": "06:57:41.760",
      "formatted_end": "06:57:43.480",
      "text": "اینها فامیله در طرف بودن"
    },
    {
      "id": 81,
      "start": 25063.48,
      "end": 25066.44,
      "formatted_start": "06:57:43.480",
      "formatted_end": "06:57:46.440",
      "text": "اونهایی که میان تکرار دارو میان میان کوده مدی میگن"
    },
    {
      "id": 82,
      "start": 25066.44,
      "end": 25067.74,
      "formatted_start": "06:57:46.440",
      "formatted_end": "06:57:47.740",
      "text": "ایوانه از باید کنن داریم"
    },
    {
      "id": 83,
      "start": 25067.74,
      "end": 25071.48,
      "formatted_start": "06:57:47.740",
      "formatted_end": "06:57:51.480",
      "text": "اونها دیگه باید خیلی جای عجیب"
    },
    {
      "id": 84,
      "start": 25071.48,
      "end": 25072.52,
      "formatted_start": "06:57:51.480",
      "formatted_end": "06:57:52.520",
      "text": "تعجب خدا"
    },
    {
      "id": 85,
      "start": 25072.52,
      "end": 25074.38,
      "formatted_start": "06:57:52.520",
      "formatted_end": "06:57:54.380",
      "text": "یه بار باید بردیم"
    },
    {
      "id": 86,
      "start": 25074.38,
      "end": 25075.5,
      "formatted_start": "06:57:54.380",
      "formatted_end": "06:57:55.500",
      "text": "یه بار صبح تازدی"
    },
    {
      "id": 87,
      "start": 25075.5,
      "end": 25077.5,
      "formatted_start": "06:57:55.500",
      "formatted_end": "06:57:57.500",
      "text": "یک بابا ما این رو تمیز کرده هم داره"
    },
    {
      "id": 88,
      "start": 25077.5,
      "end": 25079.5,
      "formatted_start": "06:57:57.500",
      "formatted_end": "06:57:59.500",
      "text": "اشین یه بیز بیشتر"
    },
    {
      "id": 89,
      "start": 25079.5,
      "end": 25081.5,
      "formatted_start": "06:57:59.500",
      "formatted_end": "06:58:01.500",
      "text": "تنبیز رو کشم داریم"
    },
    {
      "id": 90,
      "start": 25081.5,
      "end": 25083.5,
      "formatted_start": "06:58:01.500",
      "formatted_end": "06:58:03.500",
      "text": "ما میدونم"
    },
    {
      "id": 91,
      "start": 25083.5,
      "end": 25085.5,
      "formatted_start": "06:58:03.500",
      "formatted_end": "06:58:05.500",
      "text": "صبح که دیر میاد"
    },
    {
      "id": 92,
      "start": 25085.5,
      "end": 25087.5,
      "formatted_start": "06:58:05.500",
      "formatted_end": "06:58:07.500",
      "text": "از دیر زبان های با ما میاد"
    },
    {
      "id": 93,
      "start": 25087.5,
      "end": 25089.5,
      "formatted_start": "06:58:07.500",
      "formatted_end": "06:58:09.500",
      "text": "منو نمیدونم کلمه های همه داری"
    },
    {
      "id": 94,
      "start": 25089.5,
      "end": 25091.5,
      "formatted_start": "06:58:09.500",
      "formatted_end": "06:58:11.500",
      "text": "کاران میکنی که"
    },
    {
      "id": 95,
      "start": 25091.5,
      "end": 25093.5,
      "formatted_start": "06:58:11.500",
      "formatted_end": "06:58:13.500",
      "text": "تنبیز همه"
    },
    {
      "id": 96,
      "start": 25093.5,
      "end": 25095.5,
      "formatted_start": "06:58:13.500",
      "formatted_end": "06:58:15.500",
      "text": "اشین هر رو هر رو داشته"
    },
    {
      "id": 97,
      "start": 25101.5,
      "end": 25103.5,
      "formatted_start": "06:58:21.500",
      "formatted_end": "06:58:23.500",
      "text": "من خودم رو کلش کردم"
    },
    {
      "id": 98,
      "start": 25103.5,
      "end": 25105.5,
      "formatted_start": "06:58:23.500",
      "formatted_end": "06:58:25.500",
      "text": "برای خوش کردن خوب شوش"
    },
    {
      "id": 99,
      "start": 25112.7,
      "end": 25114.7,
      "formatted_start": "06:58:32.700",
      "formatted_end": "06:58:34.700",
      "text": "چیز سه"
    },
    {
      "id": 100,
      "start": 25120.78,
      "end": 25122.78,
      "formatted_start": "06:58:40.780",
      "formatted_end": "06:58:42.780",
      "text": "دیگه علی"
    },
    {
      "id": 101,
      "start": 25123.66,
      "end": 25125.66,
      "formatted_start": "06:58:43.660",
      "formatted_end": "06:58:45.660",
      "text": "آی علی نعیمه"
    },
    {
      "id": 102,
      "start": 25126.7,
      "end": 25130.94,
      "formatted_start": "06:58:46.700",
      "formatted_end": "06:58:50.940",
      "text": "مادرش او خوند که اگه سندشو باید عوض کنه توش پر چرکی بود"
    },
    {
      "id": 103,
      "start": 25130.94,
      "end": 25134.44,
      "formatted_start": "06:58:50.940",
      "formatted_end": "06:58:54.440",
      "text": "مادر نمیدونم چرا تب میگنن"
    },
    {
      "id": 104,
      "start": 25134.44,
      "end": 25136.94,
      "formatted_start": "06:58:54.440",
      "formatted_end": "06:58:56.940",
      "text": "وقت نمیدونم سندش پر از چرکه"
    },
    {
      "id": 105,
      "start": 25136.94,
      "end": 25137.94,
      "formatted_start": "06:58:56.940",
      "formatted_end": "06:58:57.940",
      "text": "که آواز کرده؟"
    },
    {
      "id": 106,
      "start": 25137.94,
      "end": 25141.94,
      "formatted_start": "06:58:57.940",
      "formatted_end": "06:59:01.940",
      "text": "یک آشنام کیشه، دختر خاله شه"
    },
    {
      "id": 107,
      "start": 25141.94,
      "end": 25144.94,
      "formatted_start": "06:59:01.940",
      "formatted_end": "06:59:04.940",
      "text": "میاد پیشش، به یار بوده پیلزنه"
    },
    {
      "id": 108,
      "start": 25156.94,
      "end": 25157.94,
      "formatted_start": "06:59:16.940",
      "formatted_end": "06:59:17.940",
      "text": "باید بهش"
    },
    {
      "id": 109,
      "start": 25157.94,
      "end": 25159.94,
      "formatted_start": "06:59:17.940",
      "formatted_end": "06:59:19.940",
      "text": "باید برند آراشو بگیرن"
    },
    {
      "id": 110,
      "start": 25160.94,
      "end": 25165.94,
      "formatted_start": "06:59:20.940",
      "formatted_end": "06:59:25.940",
      "text": "این شیعه نکرده باشه. ما بی پول داریم مادرشم بگیم."
    },
    {
      "id": 111,
      "start": 25165.94,
      "end": 25171.94,
      "formatted_start": "06:59:25.940",
      "formatted_end": "06:59:31.940",
      "text": "پول زخم وسته هست."
    },
    {
      "id": 112,
      "start": 25171.94,
      "end": 25175.94,
      "formatted_start": "06:59:31.940",
      "formatted_end": "06:59:35.940",
      "text": "پولی ملیون در دامه حدود ۶۰۰۰۰."
    },
    {
      "id": 113,
      "start": 25175.94,
      "end": 25186.94,
      "formatted_start": "06:59:35.940",
      "formatted_end": "06:59:46.940",
      "text": "این خداحالیه."
    },
    {
      "id": 114,
      "start": 25186.94,
      "end": 25188.94,
      "formatted_start": "06:59:46.940",
      "formatted_end": "06:59:48.940",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 115,
      "start": 25188.94,
      "end": 25190.94,
      "formatted_start": "06:59:48.940",
      "formatted_end": "06:59:50.940",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 116,
      "start": 25190.94,
      "end": 25192.94,
      "formatted_start": "06:59:50.940",
      "formatted_end": "06:59:52.940",
