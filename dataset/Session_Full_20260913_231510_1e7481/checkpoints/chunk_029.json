      "start": 8985.3,
      "end": 8987.3,
      "formatted_start": "02:29:45.300",
      "formatted_end": "02:29:47.300",
      "text": "این حالت داره که نداریم"
    },
    {
      "id": 88,
      "start": 8987.3,
      "end": 8989.3,
      "formatted_start": "02:29:47.300",
      "formatted_end": "02:29:49.300",
      "text": "یه زرده"
    },
    {
      "id": 89,
      "start": 8989.3,
      "end": 8991.3,
      "formatted_start": "02:29:49.300",
      "formatted_end": "02:29:51.300",
      "text": "فیلم از باید داروتون بینمیسم"
    },
    {
      "id": 90,
      "start": 8991.3,
      "end": 8994.3,
      "formatted_start": "02:29:51.300",
      "formatted_end": "02:29:54.300",
      "text": "آزمایش هست که در واقع بخوایم برالتها براتو بدیم"
