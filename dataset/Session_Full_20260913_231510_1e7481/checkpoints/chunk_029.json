      "id": 74,
      "start": 8951.3,
      "end": 8953.3,
      "formatted_start": "02:29:11.300",
      "formatted_end": "02:29:13.300",
      "text": "بعد دل پیچه ها شده ده"
    },
    {
      "id": 75,
      "start": 8953.3,
      "end": 8956.3,
      "formatted_start": "02:29:13.300",
      "formatted_end": "02:29:16.300",
      "text": "وقتی استالی استالی بیشتر میشه"
    },
