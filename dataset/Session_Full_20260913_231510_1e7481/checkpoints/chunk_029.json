      "id": 23,
      "start": 8780.4,
      "end": 8810.4,
      "formatted_start": "02:26:20.400",
      "formatted_end": "02:26:50.400",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 24,
      "start": 8810.4,
      "end": 8817.56,
      "formatted_start": "02:26:50.400",
      "formatted_end": "02:26:57.560",
      "text": "سبزی جد خام، ترشی، اینها نباید استفاده کنید"
    },
    {
      "id": 25,
      "start": 8817.56,
      "end": 8820.28,
      "formatted_start": "02:26:57.560",
      "formatted_end": "02:27:00.280",
      "text": "خیلی همه اینها رو میتونید با من از درسته بکنید"
    },
    {
      "id": 26,
      "start": 8820.28,
      "end": 8825.3,
      "formatted_start": "02:27:00.280",
      "formatted_end": "02:27:05.300",
      "text": "خصوصا سبزی، یعنی سبزی، میباهای ترش، عرق، نهنا"
    },
    {
      "id": 27,
      "start": 8825.3,
      "end": 8827.68,
      "formatted_start": "02:27:05.300",
      "formatted_end": "02:27:07.680",
      "text": "اینها بکتر اتونید کنند"
    },
    {
      "id": 28,
      "start": 8827.68,
      "end": 8829.14,
      "formatted_start": "02:27:07.680",
      "formatted_end": "02:27:09.140",
      "text": "این عرق نهنا بوده؟"
    },
    {
      "id": 29,
      "start": 8829.14,
      "end": 8830.76,
      "formatted_start": "02:27:09.140",
      "formatted_end": "02:27:10.760",
      "text": "نهده تو شدیدن تنبیدید"
    },
    {
      "id": 30,
      "start": 8830.76,
      "end": 8832.12,
      "formatted_start": "02:27:10.760",
      "formatted_end": "02:27:12.120",
      "text": "خود نهنا چی بیدید؟"
    },
