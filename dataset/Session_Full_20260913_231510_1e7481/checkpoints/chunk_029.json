      "start": 8917.3,
      "end": 8919.3,
      "formatted_start": "02:28:37.300",
      "formatted_end": "02:28:39.300",
      "text": "از اینجا باید برداری کنیم"
    },
    {
      "id": 58,
      "start": 8919.3,
      "end": 8921.3,
      "formatted_start": "02:28:39.300",
      "formatted_end": "02:28:41.300",
