      "start": 8832.12,
      "end": 8833.72,
      "formatted_start": "02:27:12.120",
      "formatted_end": "02:27:13.720",
      "text": "بردونید کنید یه اون نهنا"
    },
    {
      "id": 32,
      "start": 8833.72,
      "end": 8836.42,
      "formatted_start": "02:27:13.720",
      "formatted_end": "02:27:16.420",
      "text": "سبزی دشمنید کلن"
    },
    {
      "id": 33,
      "start": 8836.42,
      "end": 8838.3,
      "formatted_start": "02:27:16.420",
      "formatted_end": "02:27:18.300",
      "text": "خصوصا خورد سبزی نهنا بوده؟"
    },
    {
      "id": 34,
      "start": 8838.3,
      "end": 8840.3,
      "formatted_start": "02:27:18.300",
      "formatted_end": "02:27:20.300",
      "text": "این آدم جون"
    },
    {
      "id": 35,
      "start": 8840.3,
      "end": 8842.3,
      "formatted_start": "02:27:20.300",
      "formatted_end": "02:27:22.300",
      "text": "چی برایت خوبه؟"
    },
    {
      "id": 36,
      "start": 8842.3,
      "end": 8844.3,
      "formatted_start": "02:27:22.300",
      "formatted_end": "02:27:24.300",
      "text": "صبح که بدمشه یک قشنگ اصفت داری"
    },
    {
      "id": 37,
      "start": 8844.3,
      "end": 8846.3,
      "formatted_start": "02:27:24.300",
      "formatted_end": "02:27:26.300",
      "text": "نصف آدم جون"
    },
    {
      "id": 38,
      "start": 8846.3,
      "end": 8848.3,
      "formatted_start": "02:27:26.300",
      "formatted_end": "02:27:28.300",
      "text": "آره، چه روزه دارم میخورم"
    },
    {
      "id": 39,
      "start": 8848.3,
      "end": 8850.3,
      "formatted_start": "02:27:28.300",
      "formatted_end": "02:27:30.300",
      "text": "این کار رو حتم هم میخورم"
    },
    {
      "id": 40,
      "start": 8850.3,
      "end": 8852.3,
      "formatted_start": "02:27:30.300",
      "formatted_end": "02:27:32.300",
      "text": "سارو یه سنگی پیسه سر روی"
    },
    {
      "id": 41,
      "start": 8852.3,
      "end": 8854.3,
      "formatted_start": "02:27:32.300",
      "formatted_end": "02:27:34.300",
      "text": "نه که من داشتم"
    },
    {
      "id": 42,
      "start": 8854.3,
      "end": 8856.3,
      "formatted_start": "02:27:34.300",
      "formatted_end": "02:27:36.300",
      "text": "نه، نه، نه، چه روزه دارم چیز میخورم"
    },
    {
      "id": 43,
      "start": 8856.3,
      "end": 8858.3,
      "formatted_start": "02:27:36.300",
      "formatted_end": "02:27:38.300",
      "text": "همینی که من کم میده من یه زیون"
    },
    {
      "id": 44,
      "start": 8858.3,
      "end": 8860.3,
      "formatted_start": "02:27:38.300",
      "formatted_end": "02:27:40.300",
      "text": "و ده سه و اینو خورم"
    },
    {
      "id": 45,
      "start": 8860.3,
      "end": 8862.3,
      "formatted_start": "02:27:40.300",
      "formatted_end": "02:27:42.300",
      "text": "من یه زیون ده سه و اینو خورم"
    },
    {
      "id": 46,
      "start": 8862.3,
      "end": 8864.3,
      "formatted_start": "02:27:42.300",
      "formatted_end": "02:27:44.300",
      "text": "من یه زیون ده سه و اینو خورم"
    },
    {
      "id": 47,
      "start": 8864.3,
      "end": 8867.3,
      "formatted_start": "02:27:44.300",
      "formatted_end": "02:27:47.300",
      "text": "من یک یوم ده سه و این ها خوره منو نمی کنم"
    },
    {
      "id": 48,
      "start": 8867.3,
      "end": 8871.3,
      "formatted_start": "02:27:47.300",
      "formatted_end": "02:27:51.300",
      "text": "من یک یوم ده سه حضیت نمی کنم و کلسیم چرا؟ آهنجه؟"
    },
    {
      "id": 49,
      "start": 8871.3,
      "end": 8875.3,
      "formatted_start": "02:27:51.300",
      "formatted_end": "02:27:55.300",
      "text": "نه، بعد این آزمایش هم میگیرم، باید این رو خرد کنم تا آزمایش میگیرم"
    },
    {
      "id": 50,
      "start": 8875.3,
      "end": 8905.3,
      "formatted_start": "02:27:55.300",
      "formatted_end": "02:28:25.300",
