      "id": 76,
      "start": 8956.3,
      "end": 8959.3,
      "formatted_start": "02:29:16.300",
      "formatted_end": "02:29:19.300",
      "text": "نه دقیقا کمتر بگیرم"
    },
    {
      "id": 77,
      "start": 8959.3,
      "end": 8962.3,
      "formatted_start": "02:29:19.300",
      "formatted_end": "02:29:22.300",
      "text": "ولی خب از خودم فکر میکنم بعد از غذا یه دفتر چی رو میگیره"
    },
    {
      "id": 78,
      "start": 8962.3,
      "end": 8966.3,
      "formatted_start": "02:29:22.300",
      "formatted_end": "02:29:26.300",
      "text": "میگم اگه بیرون باشم من چی کنم؟ اینجوریه"
    },
    {
      "id": 79,
      "start": 8966.3,
      "end": 8967.3,
      "formatted_start": "02:29:26.300",
      "formatted_end": "02:29:27.300",
      "text": "خب درسته بگیرم"
    },
    {
      "id": 80,
      "start": 8967.3,
      "end": 8970.3,
      "formatted_start": "02:29:27.300",
      "formatted_end": "02:29:30.300",
      "text": "ولی خب فرماتی دید ولی یه مدت اون فرام بهتره"
    },
    {
      "id": 81,
      "start": 8970.3,
      "end": 8973.3,
      "formatted_start": "02:29:30.300",
      "formatted_end": "02:29:33.300",
      "text": "داری مدت کم فرام داره خب"
    },
    {
      "id": 82,
      "start": 8973.3,
      "end": 8976.3,
      "formatted_start": "02:29:33.300",
      "formatted_end": "02:29:36.300",
      "text": "بگو بگو که مدت بود توش خیلتا کف که نداره"
    },
    {
      "id": 83,
      "start": 8976.3,
      "end": 8978.3,
      "formatted_start": "02:29:36.300",
      "formatted_end": "02:29:38.300",
      "text": "نه چی دستشوی فرامگی بشه"
    },
    {
      "id": 84,
      "start": 8978.3,
      "end": 8981.3,
      "formatted_start": "02:29:38.300",
      "formatted_end": "02:29:41.300",
      "text": "خودتون بخوای خودتون تمیز کنید احساب بریم"
    },
    {
      "id": 85,
      "start": 8981.3,
      "end": 8983.3,
      "formatted_start": "02:29:41.300",
      "formatted_end": "02:29:43.300",
      "text": "این وقت خیلی تا کفتاره مطمئن سره"
    },
