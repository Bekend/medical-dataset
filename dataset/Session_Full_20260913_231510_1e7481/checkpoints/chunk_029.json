  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8704.4,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:04.400",
      "text": "دکتر من خیلی که گوشترخ بیاد دارم، نفت روی دارم."
    },
    {
      "id": 1,
      "start": 8704.4,
      "end": 8705.4,
      "formatted_start": "02:25:04.400",
      "formatted_end": "02:25:05.400",
      "text": "چند وقت هم؟"
    },
    {
      "id": 2,
      "start": 8705.4,
      "end": 8707.4,
      "formatted_start": "02:25:05.400",
      "formatted_end": "02:25:07.400",
      "text": "خیلی خیلی چند سال روی رستم."
    },
    {
      "id": 3,
      "start": 8707.4,
      "end": 8711.4,
      "formatted_start": "02:25:07.400",
      "formatted_end": "02:25:11.400",
      "text": "برات مثلا هر چی میخورم سریع نفت میخورم، نیدم وزرگ میشه."
    },
    {
      "id": 4,
      "start": 8711.4,
      "end": 8713.4,
      "formatted_start": "02:25:11.400",
      "formatted_end": "02:25:13.400",
      "text": "بعد دهرون میخوری برمدن؟"
    },
    {
      "id": 5,
      "start": 8713.4,
      "end": 8714.4,
      "formatted_start": "02:25:13.400",
      "formatted_end": "02:25:14.400",
      "text": "نه، هیچ چی."
    },
    {
      "id": 6,
      "start": 8714.4,
      "end": 8717.4,
      "formatted_start": "02:25:14.400",
      "formatted_end": "02:25:17.400",
      "text": "بعد آب و کیدین بعد غذایی میخورم."
    },
    {
      "id": 7,
      "start": 8717.4,
      "end": 8721.4,
      "formatted_start": "02:25:17.400",
      "formatted_end": "02:25:21.400",
      "text": "مثلا اما جدید از سوزش نیدم دارم، چایی هم پیری خورم."
    },
    {
      "id": 8,
      "start": 8721.4,
      "end": 8723.4,
      "formatted_start": "02:25:21.400",
      "formatted_end": "02:25:23.400",
      "text": "خوب، نه، نه، نه، نه."
    },
    {
      "id": 9,
      "start": 8723.4,
      "end": 8753.4,
      "formatted_start": "02:25:23.400",
      "formatted_end": "02:25:53.400",
      "text": "در این وقت داشتید که در این وقت داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که داشتید که د"
    },
    {
      "id": 10,
      "start": 8753.4,
      "end": 8756.4,
      "formatted_start": "02:25:53.400",
      "formatted_end": "02:25:56.400",
      "text": "تخلیه نکرد. اصلا میرم باز دوباره میام."
    },
    {
      "id": 11,
      "start": 8756.4,
      "end": 8759.4,
      "formatted_start": "02:25:56.400",
      "formatted_end": "02:25:59.400",
      "text": "خوب و بعد زیاد استفاده نکن خب."
    },
    {
      "id": 12,
      "start": 8759.4,
      "end": 8763.4,
      "formatted_start": "02:25:59.400",
      "formatted_end": "02:26:03.400",
      "text": "مکارنی و بادکلم اینها باید..."
    },
    {
      "id": 13,
      "start": 8763.4,
      "end": 8765.4,
      "formatted_start": "02:26:03.400",
      "formatted_end": "02:26:05.400",
      "text": "خب باید به داردار."
    },
    {
      "id": 14,
      "start": 8765.4,
      "end": 8767.4,
      "formatted_start": "02:26:05.400",
      "formatted_end": "02:26:07.400",
      "text": "جا دارم که میگم کاتر نه."
    },
    {
      "id": 15,
      "start": 8767.4,
      "end": 8770.4,
      "formatted_start": "02:26:07.400",
      "formatted_end": "02:26:10.400",
      "text": "باید کار دارم باید درکتر میام."
    },
    {
      "id": 16,
      "start": 8770.4,
      "end": 8773.4,
      "formatted_start": "02:26:10.400",
      "formatted_end": "02:26:13.400",
      "text": "که میتونه که بگیری در این یوم."
    },
    {
      "id": 17,
      "start": 8773.4,
      "end": 8774.4,
      "formatted_start": "02:26:13.400",
      "formatted_end": "02:26:14.400",
      "text": "چند میشه؟"
    },
    {
      "id": 18,
      "start": 8774.4,
      "end": 8775.4,
      "formatted_start": "02:26:14.400",
      "formatted_end": "02:26:15.400",
      "text": "چند میشه؟"
    },
    {
