  "stt_segments": [
    {
      "id": 0,
      "start": 23400.0,
      "end": 23422.0,
      "formatted_start": "06:30:00.000",
      "formatted_end": "06:30:22.000",
      "text": "از اینجوری هم فراموش می کنید که از اینجوری هم تراب مقابل دارو با من حرف می زنید، این برده اینجوری هم کلن هنگه، دارم نگاه می کنم، گوش می کنم ولی نمی دونم چی نگه."
    },
    {
      "id": 1,
      "start": 23422.0,
      "end": 23425.0,
      "formatted_start": "06:30:22.000",
      "formatted_end": "06:30:25.000",
      "text": "چه داروهای به جز بندت می خواهی؟"
    },
    {
      "id": 2,
      "start": 23425.0,
      "end": 23429.0,
      "formatted_start": "06:30:25.000",
      "formatted_end": "06:30:29.000",
      "text": "همین چربی و غلطه ها دیگه هیچی نیست"
    },
    {
      "id": 3,
      "start": 23429.0,
      "end": 23433.0,
      "formatted_start": "06:30:29.000",
      "formatted_end": "06:30:33.000",
      "text": "به خاطر من، ویتامنالاتی دیگه پایین آمده به دوازده ولد نشتن"
    },
    {
      "id": 4,
      "start": 23433.0,
      "end": 23437.0,
      "formatted_start": "06:30:33.000",
      "formatted_end": "06:30:37.000",
      "text": "تو دیابتیا به دوازده و منعزی رو میاد پایین"
    },
    {
      "id": 5,
      "start": 23437.0,
      "end": 23443.0,
      "formatted_start": "06:30:37.000",
      "formatted_end": "06:30:43.000",
      "text": "و بهترانسا خیلی توی در واقع آسانی تحمل دیابتیا رو میاد پایین"
    },
    {
      "id": 6,
      "start": 23443.0,
      "end": 23449.0,
      "formatted_start": "06:30:43.000",
      "formatted_end": "06:30:49.000",
      "text": "وقتی که همیشه عصبی میشی، آفرین، و تعادلتون به همین قوه محافظه ضعیفه"
    },
    {
      "id": 7,
      "start": 23449.0,
      "end": 23453.0,
      "formatted_start": "06:30:49.000",
      "formatted_end": "06:30:53.000",
      "text": "شما باید همیشه این ویتامنال مادام رو هم استفاده کنید"
    },
    {
      "id": 8,
      "start": 23453.0,
      "end": 23459.1,
      "formatted_start": "06:30:53.000",
      "formatted_end": "06:30:59.100",
      "text": "با همین پودتون هم درود کنه هم آسمان شده"
    },
    {
      "id": 9,
      "start": 23459.1,
      "end": 23459.86,
      "formatted_start": "06:30:59.100",
      "formatted_end": "06:30:59.860",
      "text": "در مجه کنیم"
    },
    {
      "id": 10,
      "start": 23459.86,
      "end": 23461.28,
      "formatted_start": "06:30:59.860",
      "formatted_end": "06:31:01.280",
      "text": "سلامت بشید خواهد بردید"
    },
    {
      "id": 11,
      "start": 23461.28,
      "end": 23462.06,
      "formatted_start": "06:31:01.280",
      "formatted_end": "06:31:02.060",
      "text": "مفید باشید"
    },
    {
      "id": 12,
      "start": 23462.06,
      "end": 23468.78,
      "formatted_start": "06:31:02.060",
      "formatted_end": "06:31:08.780",
      "text": "اما یادماش رو از جگه رو باید میاده"
    },
    {
      "id": 13,
      "start": 23468.78,
      "end": 23469.82,
      "formatted_start": "06:31:08.780",
      "formatted_end": "06:31:09.820",
      "text": "آره انشاءالله"
    },
    {
      "id": 14,
      "start": 23469.82,
      "end": 23470.74,
      "formatted_start": "06:31:09.820",
      "formatted_end": "06:31:10.740",
      "text": "در مجه کنیم"
    },
    {
      "id": 15,
      "start": 23470.74,
      "end": 23475.64,
      "formatted_start": "06:31:10.740",
      "formatted_end": "06:31:15.640",
      "text": "سلامت بشید"
    },
    {
      "id": 16,
      "start": 23475.64,
      "end": 23477.64,
      "formatted_start": "06:31:15.640",
      "formatted_end": "06:31:17.640",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 17,
      "start": 23477.64,
      "end": 23507.64,
      "formatted_start": "06:31:17.640",
      "formatted_end": "06:31:47.640",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 18,
      "start": 23507.64,
      "end": 23513.64,
      "formatted_start": "06:31:47.640",
      "formatted_end": "06:31:53.640",
      "text": "این راه نفس هم میبنده و نفس تنگیم میگیره"
    },
    {
      "id": 19,
      "start": 23513.64,
      "end": 23516.64,
      "formatted_start": "06:31:53.640",
      "formatted_end": "06:31:56.640",
      "text": "تو ارشنها نمی کنی؟ نه نه"
    },
    {
      "id": 20,
      "start": 23516.64,
      "end": 23518.64,
      "formatted_start": "06:31:56.640",
      "formatted_end": "06:31:58.640",
      "text": "زیبا پلی هم داری؟"
    },
    {
      "id": 21,
      "start": 23518.64,
      "end": 23522.64,
      "formatted_start": "06:31:58.640",
      "formatted_end": "06:32:02.640",
      "text": "نه، زیبا پلی هم نه، قلیمون من برای دو هفته پیش گشتیم"
    },
    {
      "id": 22,
      "start": 23522.64,
      "end": 23525.64,
      "formatted_start": "06:32:02.640",
      "formatted_end": "06:32:05.640",
      "text": "خاطرم این رسام نگرفت، آدم جدیگر اصلا"
    },
    {
      "id": 23,
      "start": 23525.64,
      "end": 23527.64,
      "formatted_start": "06:32:05.640",
      "formatted_end": "06:32:07.640",
      "text": "قبل هم پلی میگشتی؟"
    },
    {
      "id": 24,
      "start": 23527.64,
      "end": 23531.64,
      "formatted_start": "06:32:07.640",
      "formatted_end": "06:32:11.640",
      "text": "آره، بازده همون تک و توب باید جمع شده"
    },
    {
      "id": 25,
      "start": 23531.64,
      "end": 23534.64,
      "formatted_start": "06:32:11.640",
      "formatted_end": "06:32:14.640",
      "text": "بازده هفته یه بار باشه؟ آره"
    },
    {
      "id": 26,
      "start": 23534.64,
      "end": 23537.64,
      "formatted_start": "06:32:14.640",
      "formatted_end": "06:32:17.640",
      "text": "هفته یه بار شده تو بزرگ سی باری"
    },
    {
      "id": 27,
      "start": 23537.64,
      "end": 23539.64,
      "formatted_start": "06:32:17.640",
      "formatted_end": "06:32:19.640",
      "text": "یه پیمان زیاد می کشیده"
    },
    {
      "id": 28,
      "start": 23539.64,
      "end": 23543.64,
      "formatted_start": "06:32:19.640",
      "formatted_end": "06:32:23.640",
      "text": "هم میده تو و همین زهن تنها خوسته تو و هم رو پرداشت"
    },
    {
      "id": 29,
      "start": 23543.64,
      "end": 23544.64,
      "formatted_start": "06:32:23.640",
      "formatted_end": "06:32:24.640",
      "text": "آهانه"
    },
    {
      "id": 30,
      "start": 23544.64,
      "end": 23548.64,
      "formatted_start": "06:32:24.640",
      "formatted_end": "06:32:28.640",
      "text": "بعد سرمانو پرداشت می کنم برم برم"
    },
    {
      "id": 31,
      "start": 23548.64,
      "end": 23551.64,
      "formatted_start": "06:32:28.640",
      "formatted_end": "06:32:31.640",
      "text": "چک نکردی تیروید اینا ها مشکل نداشته؟"
    },
    {
      "id": 32,
      "start": 23551.64,
      "end": 23552.64,
      "formatted_start": "06:32:31.640",
      "formatted_end": "06:32:32.640",
      "text": "نه نه چک نکردی"
    },
    {
      "id": 33,
      "start": 23552.64,
      "end": 23554.64,
      "formatted_start": "06:32:32.640",
      "formatted_end": "06:32:34.640",
      "text": "بسیاری تو اینشو باز کنی"
    },
    {
      "id": 34,
      "start": 23554.64,
      "end": 23555.64,
      "formatted_start": "06:32:34.640",
      "formatted_end": "06:32:35.640",
      "text": "در سرمان اول اتون باز کنی"
    },
    {
      "id": 35,
      "start": 23555.64,
      "end": 23558.64,
      "formatted_start": "06:32:35.640",
      "formatted_end": "06:32:38.640",
      "text": "این میشه اوزم خود کنه اش به نیستش"
    },
    {
      "id": 36,
      "start": 23558.64,
      "end": 23562.64,
      "formatted_start": "06:32:38.640",
      "formatted_end": "06:32:42.640",
      "text": "چون تو ظاهر خب تیروید خودترز معموله"
    },
    {
      "id": 37,
      "start": 23564.64,
      "end": 23566.64,
      "formatted_start": "06:32:44.640",
      "formatted_end": "06:32:46.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 38,
      "start": 23566.64,
      "end": 23568.64,
      "formatted_start": "06:32:46.640",
      "formatted_end": "06:32:48.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 39,
      "start": 23568.64,
      "end": 23570.64,
      "formatted_start": "06:32:48.640",
      "formatted_end": "06:32:50.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 40,
      "start": 23570.64,
      "end": 23572.64,
      "formatted_start": "06:32:50.640",
      "formatted_end": "06:32:52.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 41,
      "start": 23572.64,
      "end": 23574.64,
      "formatted_start": "06:32:52.640",
      "formatted_end": "06:32:54.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 42,
      "start": 23574.64,
      "end": 23576.64,
      "formatted_start": "06:32:54.640",
      "formatted_end": "06:32:56.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 43,
      "start": 23576.64,
      "end": 23578.64,
      "formatted_start": "06:32:56.640",
      "formatted_end": "06:32:58.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 44,
      "start": 23578.64,
      "end": 23580.64,
      "formatted_start": "06:32:58.640",
      "formatted_end": "06:33:00.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 45,
      "start": 23580.64,
      "end": 23582.64,
      "formatted_start": "06:33:00.640",
      "formatted_end": "06:33:02.640",
      "text": "از اینجا باید بردار شده بودم."
    },
    {
      "id": 46,
      "start": 23582.64,
      "end": 23588.64,
      "formatted_start": "06:33:02.640",
      "formatted_end": "06:33:08.640",
      "text": "اینجا درد نمیدونی؟"
    },
    {
      "id": 47,
      "start": 23588.64,
      "end": 23592.64,
      "formatted_start": "06:33:08.640",
      "formatted_end": "06:33:12.640",
      "text": "درد نه، الان نه، ولی اون وقتی بیدار شده بودم از هم چرا"
    },
    {
      "id": 48,
      "start": 23592.64,
      "end": 23596.64,
      "formatted_start": "06:33:12.640",
      "formatted_end": "06:33:16.640",
      "text": "مثلا راه گلو میده یه جورایی درد میکرد"
    },
    {
      "id": 49,
      "start": 23596.64,
      "end": 23598.64,
      "formatted_start": "06:33:16.640",
      "formatted_end": "06:33:18.640",
      "text": "مثلا اینجا خشک بود"
    },
    {
      "id": 50,
      "start": 23598.64,
      "end": 23600.64,
      "formatted_start": "06:33:18.640",
      "formatted_end": "06:33:20.640",
      "text": "فقط اونجایی کن"
    },
    {
      "id": 51,
      "start": 23600.64,
      "end": 23609.64,
      "formatted_start": "06:33:20.640",
      "formatted_end": "06:33:29.640",
      "text": "اولا صرفه که خیلی مثلا میکنم، در حال صرفه کردن زیاد پشارم یه اون میره بالا"
    },
    {
      "id": 52,
      "start": 23609.64,
      "end": 23613.64,
      "formatted_start": "06:33:29.640",
      "formatted_end": "06:33:33.640",
      "text": "او هم، اول سرخه ها چون شد؟"
    },
    {
      "id": 53,
      "start": 23613.64,
      "end": 23617.64,
      "formatted_start": "06:33:33.640",
      "formatted_end": "06:33:37.640",
      "text": "اول سرخه ها چون شد؟"
    },
    {
      "id": 54,
      "start": 23617.64,
      "end": 23621.64,
      "formatted_start": "06:33:37.640",
      "formatted_end": "06:33:41.640",
      "text": "سرخه فشارتون مانده، زن زنی بده"
    },
    {
      "id": 55,
      "start": 23621.64,
      "end": 23625.64,
      "formatted_start": "06:33:41.640",
      "formatted_end": "06:33:45.640",
      "text": "آره، مثلا همین قضا هم میخورن"
    },
    {
      "id": 56,
      "start": 23625.64,
      "end": 23629.64,
      "formatted_start": "06:33:45.640",
      "formatted_end": "06:33:49.640",
      "text": "اون وقتی اخواب بیدار شدم، میترسیدم قضا بکنم"
    },
    {
      "id": 57,
      "start": 23629.64,
      "end": 23633.64,
      "formatted_start": "06:33:49.640",
      "formatted_end": "06:33:53.640",
      "text": "قضا میخورم فوری فشارتون میبره بالا"
    },
    {
      "id": 58,
      "start": 23633.64,
      "end": 23637.64,
      "formatted_start": "06:33:53.640",
      "formatted_end": "06:33:57.640",
      "text": "مثلا میگم یک چیزی مثل گرزو میاد رای گلو مذیدم بکنم نفسم"
    },
    {
      "id": 59,
      "start": 23637.64,
      "end": 23642.64,
      "formatted_start": "06:33:57.640",
      "formatted_end": "06:34:02.640",
      "text": "چند تا تیپا بود در زربانت بالا رفته؟"
    },
    {
      "id": 60,
      "start": 23642.64,
      "end": 23646.64,
      "formatted_start": "06:34:02.640",
      "formatted_end": "06:34:06.640",
      "text": "الان ما فرق علامتی درمان رو که حجاب باز میشه بید"
    },
    {
      "id": 61,
      "start": 23646.64,
      "end": 23650.64,
      "formatted_start": "06:34:06.640",
      "formatted_end": "06:34:10.640",
      "text": "یه باز ناشته میده حتما لرگ بخوری صبح"
    },
    {
      "id": 62,
      "start": 23650.64,
      "end": 23654.64,
      "formatted_start": "06:34:10.640",
      "formatted_end": "06:34:14.640",
      "text": "اونه که توی قطعه؟"
    },
    {
      "id": 63,
      "start": 23654.64,
      "end": 23656.64,
      "formatted_start": "06:34:14.640",
      "formatted_end": "06:34:16.640",
      "text": "من خارجی نشتیم"
    },
    {
      "id": 64,
      "start": 23656.64,
      "end": 23659.64,
      "formatted_start": "06:34:16.640",
      "formatted_end": "06:34:19.640",
      "text": "بعد یه باز در..."
    },
    {
      "id": 65,
      "start": 23659.64,
      "end": 23663.64,
      "formatted_start": "06:34:19.640",
      "formatted_end": "06:34:23.640",
      "text": "باز صرفت"
    },
    {
      "id": 66,
      "start": 23663.64,
      "end": 23669.14,
      "formatted_start": "06:34:23.640",
      "formatted_end": "06:34:29.140",
      "text": "اون شبیه رفتم در موارد عمید، نمجور نصف شب وضعیت کرد"
    },
    {
      "id": 67,
      "start": 23669.14,
      "end": 23675.14,
      "formatted_start": "06:34:29.140",
      "formatted_end": "06:34:35.140",
      "text": "رفتم اینجا خانوم، مثلا دکتر خانوم خاطبه احمدی بود"
    },
    {
      "id": 68,
      "start": 23675.14,
      "end": 23679.14,
      "formatted_start": "06:34:35.140",
      "formatted_end": "06:34:39.140",
      "text": "ولی که مثلا اگه همه نیمیدونست، من هر چی بگفتم مثلا اینجوری"
    },
    {
      "id": 69,
      "start": 23679.14,
      "end": 23685.14,
      "formatted_start": "06:34:39.140",
      "formatted_end": "06:34:45.140",
      "text": "یه سرو برم داد، دادن نمکی بود، چیجوری بود، کلی این روی دماغ، آماغ هم همه رو بسید"
    },
    {
      "id": 70,
      "start": 23685.14,
      "end": 23689.64,
      "formatted_start": "06:34:45.140",
      "formatted_end": "06:34:49.640",
      "text": "تا رسیدم بیمارستان ترمیلیت شما، یک فشار رفتم روی 18"
    },
    {
      "id": 71,
      "start": 23689.64,
      "end": 23691.64,
      "formatted_start": "06:34:49.640",
      "formatted_end": "06:34:51.640",
      "text": "از حسیت"
    },
    {
      "id": 72,
      "start": 23691.64,
      "end": 23695.64,
      "formatted_start": "06:34:51.640",
      "formatted_end": "06:34:55.640",
      "text": "آرام بیمارستان بگو خانم چیکار کردی؟"
    },
    {
      "id": 73,
      "start": 23695.64,
      "end": 23699.64,
      "formatted_start": "06:34:55.640",
      "formatted_end": "06:34:59.640",
      "text": "آخ باید بشه هستم من رفته بالا"
    }
  ],
  "status": "completed"
}