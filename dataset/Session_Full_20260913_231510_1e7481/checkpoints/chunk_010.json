  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3029.98,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 3030.0,
      "end": 3033.5,
      "formatted_start": "00:50:30.000",
      "formatted_end": "00:50:33.500",
      "text": "این روز نمر نداره و اشناده فردا"
    },
    {
      "id": 2,
      "start": 3033.5,
      "end": 3040.0,
      "formatted_start": "00:50:33.500",
      "formatted_end": "00:50:40.000",
      "text": "فردا ساعت دوازده به نامه؟"
    },
    {
      "id": 3,
      "start": 3040.88,
      "end": 3042.86,
      "formatted_start": "00:50:40.880",
      "formatted_end": "00:50:42.860",
      "text": "کارم سباقی"
    },
    {
      "id": 4,
      "start": 3042.86,
      "end": 3044.0,
      "formatted_start": "00:50:42.860",
      "formatted_end": "00:50:44.000",
      "text": "کارم ساعت دوازده به نامه؟"
    },
    {
      "id": 5,
      "start": 3045.28,
      "end": 3047.46,
      "formatted_start": "00:50:45.280",
      "formatted_end": "00:50:47.460",
      "text": "کارم ساعت دوازده به نامه"
    },
    {
      "id": 6,
      "start": 3047.46,
      "end": 3049.08,
      "formatted_start": "00:50:47.460",
      "formatted_end": "00:50:49.080",
      "text": "کارم سباقی ازشون"
    },
    {
      "id": 7,
      "start": 3049.08,
      "end": 3052.0,
      "formatted_start": "00:50:49.080",
      "formatted_end": "00:50:52.000",
      "text": "کارم ساعت دوازده به نامه"
    },
    {
      "id": 8,
      "start": 3052.0,
      "end": 3054.34,
      "formatted_start": "00:50:52.000",
      "formatted_end": "00:50:54.340",
      "text": "اینو خورده؟"
    },
    {
      "id": 9,
      "start": 3054.34,
      "end": 3056.0,
      "formatted_start": "00:50:54.340",
      "formatted_end": "00:50:56.000",
      "text": "خورده"
    },
    {
      "id": 10,
      "start": 3056.0,
      "end": 3056.68,
      "formatted_start": "00:50:56.000",
      "formatted_end": "00:50:56.680",
      "text": "خورده"
    },
    {
      "id": 11,
      "start": 3056.68,
      "end": 3057.0,
      "formatted_start": "00:50:56.680",
      "formatted_end": "00:50:57.000",
      "text": "خورده"
    },
    {
      "id": 12,
      "start": 3057.0,
      "end": 3077.0,
      "formatted_start": "00:50:57.000",
      "formatted_end": "00:51:17.000",
      "text": "از اینکه از اولادتو شن میکنه مورد درداشت. اینو شب بخوره بعد از شام بخوره. حتی اون داشته آخری شب خورداره."
    },
    {
      "id": 13,
      "start": 3077.0,
      "end": 3079.0,
      "formatted_start": "00:51:17.000",
      "formatted_end": "00:51:19.000",
      "text": "اینو بردشان کنید"
    },
    {
      "id": 14,
      "start": 3079.0,
      "end": 3081.0,
      "formatted_start": "00:51:19.000",
      "formatted_end": "00:51:21.000",
      "text": "اینو بردشان"
    },
    {
      "id": 15,
      "start": 3083.0,
      "end": 3085.0,
      "formatted_start": "00:51:23.000",
      "formatted_end": "00:51:25.000",
      "text": "اینو روزی یکی بخورید"
    },
    {
      "id": 16,
      "start": 3085.0,
      "end": 3087.0,
      "formatted_start": "00:51:25.000",
      "formatted_end": "00:51:27.000",
