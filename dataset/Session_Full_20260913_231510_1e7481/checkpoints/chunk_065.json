  "stt_segments": [
    {
      "id": 0,
      "start": 19500.0,
      "end": 19529.98,
      "formatted_start": "05:25:00.000",
      "formatted_end": "05:25:29.980",
      "text": "بیمار در مطب پزشکی، بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 19530.0,
      "end": 19537.0,
      "formatted_start": "05:25:30.000",
      "formatted_end": "05:25:37.000",
      "text": "اما اگر بیمانتون فرق دارد، مستعده جامعه نیست."
    },
    {
      "id": 2,
      "start": 19537.0,
      "end": 19540.0,
      "formatted_start": "05:25:37.000",
      "formatted_end": "05:25:40.000",
      "text": "دیگرگورد ۱۴۰ بیمه نیست."
    },
    {
      "id": 3,
      "start": 19540.0,
      "end": 19544.0,
      "formatted_start": "05:25:40.000",
      "formatted_end": "05:25:44.000",
      "text": "جامعه همه ۱۷۰ بیمه اینه."
    },
    {
      "id": 4,
      "start": 19544.0,
      "end": 19546.0,
      "formatted_start": "05:25:44.000",
      "formatted_end": "05:25:46.000",
      "text": "خوب افتاده برای آن؟"
    },
    {
      "id": 5,
      "start": 19546.0,
      "end": 19549.0,
      "formatted_start": "05:25:46.000",
      "formatted_end": "05:25:49.000",
      "text": "نه دیگه خوب نیست. اولا جواب می داد، اولا جواب می نیست."
    },
    {
      "id": 6,
      "start": 19549.0,
      "end": 19552.0,
      "formatted_start": "05:25:49.000",
      "formatted_end": "05:25:52.000",
      "text": "اینجا دو هفته در مورد خود را توقع می کنید؟"
    },
    {
      "id": 7,
      "start": 19552.0,
      "end": 19554.0,
      "formatted_start": "05:25:52.000",
      "formatted_end": "05:25:54.000",
      "text": "به خاطر چه هفته شده بود؟"
    },
    {
      "id": 8,
      "start": 19554.0,
      "end": 19557.0,
      "formatted_start": "05:25:54.000",
      "formatted_end": "05:25:57.000",
      "text": "نفت می کنید، آره، آنس ما کرده شانفت بودم."
    },
    {
      "id": 9,
      "start": 19557.0,
      "end": 19562.0,
      "formatted_start": "05:25:57.000",
      "formatted_end": "05:26:02.000",
      "text": "برای تو می نوزم ببینی چون اگر نفق نکنی من برای تو می نوزم"
    },
    {
      "id": 10,
      "start": 19562.0,
      "end": 19564.0,
      "formatted_start": "05:26:02.000",
      "formatted_end": "05:26:04.000",
      "text": "وقتی اگر می دونی خساره را که ننوزی"
    },
    {
      "id": 11,
      "start": 19564.0,
      "end": 19571.0,
      "formatted_start": "05:26:04.000",
      "formatted_end": "05:26:11.000",
      "text": "نه خب خودتون لیورگول می خوردید دیگه لیورگول خیلی نفقش کم می دهد دیگه همه کم اینجوریه"
    },
    {
      "id": 12,
      "start": 19571.0,
      "end": 19576.0,
      "formatted_start": "05:26:11.000",
      "formatted_end": "05:26:16.000",
      "text": "بعد که دوتا می خواهی بخورید برای یکی زهرا یکی شب بخورید این معمولا مریضان دلپیچه و اینجوری می شه"
    },
    {
      "id": 13,
      "start": 19576.0,
      "end": 19582.0,
      "formatted_start": "05:26:16.000",
      "formatted_end": "05:26:22.000",
      "text": "اگر شما را عذیت نمی کنند، می خواهید همه هفته تا ساله اشتراکت را برمی سمد دو ماهاتون"
    },
    {
      "id": 14,
      "start": 19582.0,
      "end": 19584.0,
      "formatted_start": "05:26:22.000",
      "formatted_end": "05:26:24.000",
      "text": "هر جا خود"
    },
    {
      "id": 15,
      "start": 19584.0,
      "end": 19586.0,
      "formatted_start": "05:26:24.000",
      "formatted_end": "05:26:26.000",
      "text": "معمولاً مومنی یک دوست"
    },
    {
      "id": 16,
      "start": 19586.0,
      "end": 19588.0,
      "formatted_start": "05:26:26.000",
      "formatted_end": "05:26:28.000",
      "text": "چون نفقش زیادی نمی کند"
    },
    {
      "id": 17,
      "start": 19588.0,
      "end": 19590.0,
      "formatted_start": "05:26:28.000",
      "formatted_end": "05:26:30.000",
      "text": "که که بخوره مونو شب؟"
    },
    {
      "id": 18,
      "start": 19590.0,
      "end": 19592.0,
      "formatted_start": "05:26:30.000",
      "formatted_end": "05:26:32.000",
      "text": "که نفقش عذیتتون نکنند"
    },
    {
      "id": 19,
      "start": 19592.0,
      "end": 19596.0,
      "formatted_start": "05:26:32.000",
      "formatted_end": "05:26:36.000",
      "text": "که می افته در خواب دیگه عذیت نمی شود"
    },
    {
      "id": 20,
      "start": 19596.0,
      "end": 19600.0,
      "formatted_start": "05:26:36.000",
      "formatted_end": "05:26:40.000",
      "text": "بگویند دلپیچ ها این ها می دهید که روز که می خورند"
    },
    {
      "id": 21,
      "start": 19600.0,
      "end": 19608.0,
      "formatted_start": "05:26:40.000",
      "formatted_end": "05:26:48.000",
      "text": "میخوای شما یه دوره همون براتون بیاریم صبح و شب بخورید"
    },
    {
      "id": 22,
      "start": 19608.0,
      "end": 19612.0,
      "formatted_start": "05:26:48.000",
      "formatted_end": "05:26:52.000",
      "text": "یه شست تا برنیم بخورید صبح و شب بخورید همه تا"
    },
    {
      "id": 23,
      "start": 19612.0,
      "end": 19619.0,
      "formatted_start": "05:26:52.000",
      "formatted_end": "05:26:59.000",
      "text": "صبح و شب بخورید اگه که دیدیم بهتون ساخت بیاریم براتون دوباره همگی برنیم بخوریم"
    },
    {
      "id": 24,
      "start": 19619.0,
      "end": 19620.0,
      "formatted_start": "05:26:59.000",
      "formatted_end": "05:27:00.000",
      "text": "باشه؟ باشه باشه"
    },
    {
      "id": 25,
      "start": 19620.0,
      "end": 19622.0,
      "formatted_start": "05:27:00.000",
      "formatted_end": "05:27:02.000",
      "text": "اما آزادتا داره"
    },
    {
      "id": 26,
      "start": 19622.0,
      "end": 19624.0,
      "formatted_start": "05:27:02.000",
      "formatted_end": "05:27:04.000",
      "text": "آفرین صبح و شب بخورید"
    },
    {
      "id": 27,
      "start": 19624.0,
      "end": 19629.0,
      "formatted_start": "05:27:04.000",
      "formatted_end": "05:27:09.000",
      "text": "اما صبح و شب در واقع بعد نهار و شم بخورید اگه دیدیم بهتون ساخت بیاریم تعداد زیاد بخوریم"
    },
    {
      "id": 28,
      "start": 19629.0,
      "end": 19633.3,
      "formatted_start": "05:27:09.000",
      "formatted_end": "05:27:13.300",
      "text": "برد به حاجی بیرون و بسایی 180 تا بر سه ماه بریم سن"
    },
    {
      "id": 29,
      "start": 19633.3,
      "end": 19635.46,
      "formatted_start": "05:27:13.300",
      "formatted_end": "05:27:15.460",
      "text": "برای بدن چیز نداره"
    },
    {
      "id": 30,
      "start": 19635.46,
      "end": 19636.52,
      "formatted_start": "05:27:15.460",
      "formatted_end": "05:27:16.520",
      "text": "بشه حاجه"
    },
    {
      "id": 31,
      "start": 19636.52,
      "end": 19638.02,
      "formatted_start": "05:27:16.520",
      "formatted_end": "05:27:18.020",
      "text": "نه نه بده ببین"
    },
    {
      "id": 32,
      "start": 19638.02,
      "end": 19640.48,
      "formatted_start": "05:27:18.020",
      "formatted_end": "05:27:20.480",
      "text": "چربی بالا تو خطره داره"
    },
    {
      "id": 33,
      "start": 19640.48,
      "end": 19641.9,
      "formatted_start": "05:27:20.480",
      "formatted_end": "05:27:21.900",
      "text": "چیز میکنه آره"
    },
    {
      "id": 34,
      "start": 19641.9,
      "end": 19644.12,
      "formatted_start": "05:27:21.900",
      "formatted_end": "05:27:24.120",
      "text": "خارش بدن میده"
    },
    {
      "id": 35,
      "start": 19644.12,
      "end": 19645.92,
      "formatted_start": "05:27:24.120",
      "formatted_end": "05:27:25.920",
      "text": "بیقراری میده"
    },
    {
      "id": 36,
      "start": 19645.92,
      "end": 19649.18,
      "formatted_start": "05:27:25.920",
      "formatted_end": "05:27:29.180",
      "text": "سنگینی اینا ها ممکن دشار باشی"
    },
    {
      "id": 37,
      "start": 19649.18,
      "end": 19650.28,
      "formatted_start": "05:27:29.180",
      "formatted_end": "05:27:30.280",
      "text": "خوابت میاد نوشه"
    },
    {
      "id": 38,
      "start": 19650.28,
      "end": 19654.06,
      "formatted_start": "05:27:30.280",
      "formatted_end": "05:27:34.060",
      "text": "از ریل خونه اما من خونه"
    },
    {
      "id": 39,
      "start": 19654.06,
      "end": 19655.78,
      "formatted_start": "05:27:34.060",
      "formatted_end": "05:27:35.780",
      "text": "نه خب قلبتون خوب"
    },
    {
      "id": 40,
      "start": 19655.78,
      "end": 19657.82,
      "formatted_start": "05:27:35.780",
      "formatted_end": "05:27:37.820",
      "text": "تا میمون سالت خواهده"
    },
    {
      "id": 41,
      "start": 19657.82,
      "end": 19659.82,
      "formatted_start": "05:27:37.820",
      "formatted_end": "05:27:39.820",
      "text": "نیومیت نون نعلق کنم وزیر شدیم"
    },
    {
      "id": 42,
      "start": 19659.82,
      "end": 19663.82,
      "formatted_start": "05:27:39.820",
      "formatted_end": "05:27:43.820",
      "text": "اگه وزیر شد برای خانم خورد جمک بلوزیر 300"
    },
    {
      "id": 43,
      "start": 19663.82,
      "end": 19665.82,
      "formatted_start": "05:27:43.820",
      "formatted_end": "05:27:45.820",
      "text": "برای شان خورد"
    },
    {
      "id": 44,
      "start": 19665.82,
      "end": 19667.82,
      "formatted_start": "05:27:45.820",
      "formatted_end": "05:27:47.820",
      "text": "20 سنه روشن هر 12 ساعت"
    },
    {
      "id": 45,
      "start": 19667.82,
      "end": 19669.82,
      "formatted_start": "05:27:47.820",
      "formatted_end": "05:27:49.820",
      "text": "میبرد برای 70"
    },
    {
      "id": 46,
      "start": 19669.82,
      "end": 19671.82,
      "formatted_start": "05:27:49.820",
      "formatted_end": "05:27:51.820",
      "text": "جامعه زن بیایی کنه"
    },
    {
      "id": 47,
      "start": 19671.82,
      "end": 19673.82,
      "formatted_start": "05:27:51.820",
      "formatted_end": "05:27:53.820",
      "text": "60 هر 12 ساعت"
    },
    {
      "id": 48,
      "start": 19673.82,
      "end": 19675.82,
      "formatted_start": "05:27:53.820",
      "formatted_end": "05:27:55.820",
      "text": "برای شان بزنیم"
    },
    {
      "id": 49,
      "start": 19675.82,
      "end": 19677.82,
      "formatted_start": "05:27:55.820",
      "formatted_end": "05:27:57.820",
      "text": "همه نیوم سنه ها"
    },
    {
      "id": 50,
      "start": 19677.82,
      "end": 19679.82,
      "formatted_start": "05:27:57.820",
      "formatted_end": "05:27:59.820",
      "text": "این رو برای شان تمام شده"
    },
    {
      "id": 51,
      "start": 19679.82,
      "end": 19681.82,
      "formatted_start": "05:27:59.820",
      "formatted_end": "05:28:01.820",
      "text": "این رو کامیران بزنه"
    },
    {
      "id": 52,
      "start": 19681.82,
      "end": 19683.82,
      "formatted_start": "05:28:01.820",
      "formatted_end": "05:28:03.820",
      "text": "این رو نمیدونی"
    },
    {
      "id": 53,
      "start": 19683.82,
      "end": 19685.82,
      "formatted_start": "05:28:03.820",
      "formatted_end": "05:28:05.820",
      "text": "این رو برای شان میشه"
    },
    {
      "id": 54,
      "start": 19685.82,
      "end": 19715.82,
      "formatted_start": "05:28:05.820",
      "formatted_end": "05:28:35.820",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید ک"
    },
    {
      "id": 55,
      "start": 19715.82,
      "end": 19719.82,
      "formatted_start": "05:28:35.820",
      "formatted_end": "05:28:39.820",
      "text": "خیلی زیاده، هیچ کار خاص نمیشه کرده"
    },
    {
      "id": 56,
      "start": 19719.82,
      "end": 19721.82,
      "formatted_start": "05:28:39.820",
      "formatted_end": "05:28:41.820",
      "text": "خطر نمیدونی؟"
    },
    {
      "id": 57,
      "start": 19721.82,
      "end": 19725.82,
      "formatted_start": "05:28:41.820",
      "formatted_end": "05:28:45.820",
      "text": "خطر نمیدونی، خطرش اینکه خطر خوب خواهده"
    },
    {
      "id": 58,
      "start": 19725.82,
      "end": 19728.82,
      "formatted_start": "05:28:45.820",
      "formatted_end": "05:28:48.820",
      "text": "کلیه رو مهم رای وقتا کم کار کنه"
    },
    {
      "id": 59,
      "start": 19728.82,
      "end": 19731.82,
      "formatted_start": "05:28:48.820",
      "formatted_end": "05:28:51.820",
      "text": "منطقه کاری که شما میتونید به امان معیز بوده"
    },
    {
      "id": 60,
      "start": 19731.82,
      "end": 19733.82,
      "formatted_start": "05:28:51.820",
      "formatted_end": "05:28:53.820",
      "text": "گوشت قرمز نمیدونید با خود"
    },
    {
      "id": 61,
      "start": 19733.82,
      "end": 19736.82,
      "formatted_start": "05:28:53.820",
      "formatted_end": "05:28:56.820",
      "text": "نمک اصلا نخواهید، گوشت قرمز مایید باید باید"
    },
    {
      "id": 62,
      "start": 19736.82,
      "end": 19738.82,
      "formatted_start": "05:28:56.820",
      "formatted_end": "05:28:58.820",
      "text": "اسفناج هم نخواهید"
    },
    {
      "id": 63,
      "start": 19738.82,
      "end": 19740.82,
      "formatted_start": "05:28:58.820",
      "formatted_end": "05:29:00.820",
      "text": "بیرون هم بالا هستن"
    },
    {
      "id": 64,
      "start": 19740.82,
      "end": 19744.82,
      "formatted_start": "05:29:00.820",
      "formatted_end": "05:29:04.820",
      "text": "گوشت قرمز و اسفناج برای تون موضوعه و نمک"
    },
    {
      "id": 65,
      "start": 19744.82,
      "end": 19746.82,
      "formatted_start": "05:29:04.820",
      "formatted_end": "05:29:06.820",
      "text": "اصلا نمک نمیدونی؟"
    },
    {
      "id": 66,
      "start": 19746.82,
      "end": 19748.82,
      "formatted_start": "05:29:06.820",
      "formatted_end": "05:29:08.820",
      "text": "اصلا نمک نمیدونی"
    },
    {
      "id": 67,
      "start": 19748.82,
      "end": 19750.82,
      "formatted_start": "05:29:08.820",
      "formatted_end": "05:29:10.820",
      "text": "من برای تون خیلی نظر دارم"
    },
    {
      "id": 68,
      "start": 19750.82,
      "end": 19754.82,
      "formatted_start": "05:29:10.820",
      "formatted_end": "05:29:14.820",
      "text": "کلیه شان پهلا کار کردش خوبه قندتون خوبه"
    },
    {
      "id": 69,
      "start": 19754.82,
      "end": 19758.82,
      "formatted_start": "05:29:14.820",
      "formatted_end": "05:29:18.820",
      "text": "گوشت قرمز ماهی یک بار"
    },
    {
      "id": 70,
      "start": 19758.82,
      "end": 19768.82,
      "formatted_start": "05:29:18.820",
      "formatted_end": "05:29:28.820",
      "text": "بعد اسفناج و نمک قرمز ماهی یک بار"
    },
    {
      "id": 71,
      "start": 19768.82,
      "end": 19771.82,
      "formatted_start": "05:29:28.820",
      "formatted_end": "05:29:31.820",
      "text": "گوشتقنگ هست شامل کرل پاچون و جگر و اینا میشه"
    },
    {
      "id": 72,
      "start": 19771.82,
      "end": 19774.82,
      "formatted_start": "05:29:31.820",
      "formatted_end": "05:29:34.820",
      "text": "بعد این از این موضوع"
    },
    {
      "id": 73,
      "start": 19774.82,
      "end": 19777.82,
      "formatted_start": "05:29:34.820",
      "formatted_end": "05:29:37.820",
      "text": "هیچیز که توی آزمایشاتون هست"
    },
    {
      "id": 74,
      "start": 19777.82,
      "end": 19780.82,
      "formatted_start": "05:29:37.820",
      "formatted_end": "05:29:40.820",
      "text": "اینو تا دوستان رو گلافتون برد بگم"
    },
    {
      "id": 75,
      "start": 19780.82,
      "end": 19783.82,
      "formatted_start": "05:29:40.820",
      "formatted_end": "05:29:43.820",
      "text": "پرساتتون خیلی بزرگ شده ادراک خالی نمیشه"
    },
    {
      "id": 76,
      "start": 19786.82,
      "end": 19788.82,
      "formatted_start": "05:29:46.820",
      "formatted_end": "05:29:48.820",
      "text": "تنها یه پرس تیرویت میخوری؟"
    },
    {
      "id": 77,
      "start": 19788.82,
      "end": 19789.82,
      "formatted_start": "05:29:48.820",
      "formatted_end": "05:29:49.820",
      "text": "نه"
    },
    {
      "id": 78,
      "start": 19789.82,
      "end": 19790.82,
      "formatted_start": "05:29:49.820",
      "formatted_end": "05:29:50.820",
      "text": "سابق مشکل تیرویت داشتی؟"
    },
    {
      "id": 79,
      "start": 19790.82,
      "end": 19791.82,
      "formatted_start": "05:29:50.820",
      "formatted_end": "05:29:51.820",
      "text": "نه نه"
    },
    {
      "id": 80,
      "start": 19791.82,
      "end": 19793.82,
      "formatted_start": "05:29:51.820",
      "formatted_end": "05:29:53.820",
      "text": "این اولین باری که پایین نشونده"
    },
    {
      "id": 81,
      "start": 19793.82,
      "end": 19796.82,
      "formatted_start": "05:29:53.820",
      "formatted_end": "05:29:56.820",
      "text": "خب الهیم پرسی اخیرا که یه دفعه لاغر نشدی"
    },
    {
      "id": 82,
      "start": 19796.82,
      "end": 19797.82,
      "formatted_start": "05:29:56.820",
      "formatted_end": "05:29:57.820",
      "text": "نه"
    },
    {
      "id": 83,
      "start": 19798.82,
      "end": 19800.0,
      "formatted_start": "05:29:58.820",
      "formatted_end": "05:30:00.000",
      "text": "اینجا همینجا هست"
    }
  ],
  "status": "completed"
}