    {
      "start": 25496.795,
      "end": 25499.191,
      "formatted_start": "07:04:56.795",
      "formatted_end": "07:04:59.191",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 25497.976,
      "end": 25498.432,
      "formatted_start": "07:04:57.976",
      "formatted_end": "07:04:58.432",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 25499.512,
      "end": 25499.967,
      "formatted_start": "07:04:59.512",
      "formatted_end": "07:04:59.967",
      "speaker": "SPEAKER_01"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 25200.0,
      "end": 25229.98,
      "formatted_start": "07:00:00.000",
      "formatted_end": "07:00:29.980",
      "text": "بیمار، گفتگو بین در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 25230.0,
      "end": 25232.0,
      "formatted_start": "07:00:30.000",
      "formatted_end": "07:00:32.000",
      "text": "جرایی بشه؟"
    },
    {
      "id": 2,
      "start": 25232.0,
      "end": 25234.0,
      "formatted_start": "07:00:32.000",
      "formatted_end": "07:00:34.000",
      "text": "آره"
    },
    {
      "id": 3,
      "start": 25234.0,
      "end": 25236.0,
      "formatted_start": "07:00:34.000",
      "formatted_end": "07:00:36.000",
      "text": "اینجوری که باید جرایی بشه"
    },
    {
      "id": 4,
      "start": 25236.0,
      "end": 25238.0,
      "formatted_start": "07:00:36.000",
      "formatted_end": "07:00:38.000",
      "text": "همینطور مایی گفته باید جرایی بشه"
    },
    {
      "id": 5,
      "start": 25238.0,
      "end": 25240.0,
      "formatted_start": "07:00:38.000",
      "formatted_end": "07:00:40.000",
      "text": "آره"
    },
    {
      "id": 6,
      "start": 25240.0,
      "end": 25242.0,
      "formatted_start": "07:00:40.000",
      "formatted_end": "07:00:42.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 25242.0,
      "end": 25244.0,
      "formatted_start": "07:00:42.000",
      "formatted_end": "07:00:44.000",
      "text": "گفته نتیجه عمل هم پنجه پنجه هست"
    },
    {
      "id": 8,
      "start": 25244.0,
      "end": 25246.0,
      "formatted_start": "07:00:44.000",
      "formatted_end": "07:00:46.000",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 25246.0,
      "end": 25248.0,
      "formatted_start": "07:00:46.000",
      "formatted_end": "07:00:48.000",
      "text": "اگه فلش دست و پانه دیگه"
    },
    {
      "id": 10,
      "start": 25248.0,
      "end": 25250.0,
      "formatted_start": "07:00:48.000",
      "formatted_end": "07:00:50.000",
      "text": "تمام اگه بخواست فلش بدی"
    },
    {
      "id": 11,
      "start": 25250.0,
      "end": 25252.0,
      "formatted_start": "07:00:50.000",
      "formatted_end": "07:00:52.000",
      "text": "فرد برد نمر کنند"
    },
    {
      "id": 12,
      "start": 25252.0,
      "end": 25254.0,
      "formatted_start": "07:00:52.000",
      "formatted_end": "07:00:54.000",
      "text": "آره دیگه"
    },
    {
      "id": 13,
      "start": 25254.0,
      "end": 25256.0,
      "formatted_start": "07:00:54.000",
      "formatted_end": "07:00:56.000",
      "text": "براخره تو هم یه نفر دیگه"
    },
    {
      "id": 14,
      "start": 25256.0,
      "end": 25258.0,
      "formatted_start": "07:00:56.000",
      "formatted_end": "07:00:58.000",
      "text": "بقیه هم هستن دیگه"
    },
    {
      "id": 15,
      "start": 25258.0,
      "end": 25288.0,
      "formatted_start": "07:00:58.000",
      "formatted_end": "07:01:28.000",
      "text": "از اینجا برای از اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای این"
    },
    {
      "id": 16,
      "start": 25288.0,
      "end": 25290.0,
      "formatted_start": "07:01:28.000",
      "formatted_end": "07:01:30.000",
      "text": "این دیوش خدت همه از باید"
    },
    {
      "id": 17,
      "start": 25290.0,
      "end": 25291.0,
      "formatted_start": "07:01:30.000",
      "formatted_end": "07:01:31.000",
      "text": "از باید"
    },
    {
      "id": 18,
      "start": 25291.0,
      "end": 25292.0,
      "formatted_start": "07:01:31.000",
      "formatted_end": "07:01:32.000",
      "text": "زباهلیه"
    },
    {
      "id": 19,
      "start": 25294.0,
      "end": 25296.0,
      "formatted_start": "07:01:34.000",
      "formatted_end": "07:01:36.000",
      "text": "تنبرا نمیدونن"
    },
    {
      "id": 20,
      "start": 25296.0,
      "end": 25297.0,
      "formatted_start": "07:01:36.000",
      "formatted_end": "07:01:37.000",
      "text": "امشه؟"
    },
    {
      "id": 21,
      "start": 25297.0,
      "end": 25300.0,
      "formatted_start": "07:01:37.000",
      "formatted_end": "07:01:40.000",
      "text": "نه بخواد این برای هم بخواد بگم به داراشو بگیرم"
    },
    {
      "id": 22,
      "start": 25301.0,
      "end": 25302.0,
      "formatted_start": "07:01:41.000",
      "formatted_end": "07:01:42.000",
      "text": "جان"
    },
    {
      "id": 23,
      "start": 25304.0,
      "end": 25306.0,
      "formatted_start": "07:01:44.000",
      "formatted_end": "07:01:46.000",
      "text": "برقان من با بخ کار ندارم که"
    },
    {
      "id": 24,
      "start": 25308.0,
      "end": 25310.0,
      "formatted_start": "07:01:48.000",
      "formatted_end": "07:01:50.000",
      "text": "نه اشکال من با بخ کار ندارم"
    },
    {
      "id": 25,
      "start": 25310.0,
      "end": 25312.0,
      "formatted_start": "07:01:50.000",
      "formatted_end": "07:01:52.000",
      "text": "به سنداجش بکنم"
    },
    {
      "id": 26,
      "start": 25312.0,
      "end": 25316.0,
      "formatted_start": "07:01:52.000",
      "formatted_end": "07:01:56.000",
      "text": "بساله هم خریدم بساله سنداج رو گذاشتم روی یخچال اتردم"
    },
    {
      "id": 27,
      "start": 25316.0,
      "end": 25319.0,
      "formatted_start": "07:01:56.000",
      "formatted_end": "07:01:59.000",
      "text": "باشه گلن خوربونه خدا نگرد"
    },
    {
      "id": 28,
      "start": 25323.0,
      "end": 25325.0,
      "formatted_start": "07:02:03.000",
      "formatted_end": "07:02:05.000",
      "text": "به که بدم اینو؟"
    },
    {
      "id": 29,
      "start": 25325.0,
      "end": 25327.0,
      "formatted_start": "07:02:05.000",
      "formatted_end": "07:02:07.000",
      "text": "به دوش؟"
    },
    {
      "id": 30,
      "start": 25327.0,
      "end": 25330.0,
      "formatted_start": "07:02:07.000",
      "formatted_end": "07:02:10.000",
      "text": "درانش باید دران خونو بگیرم"
    },
    {
      "id": 31,
      "start": 25334.0,
      "end": 25336.0,
      "formatted_start": "07:02:14.000",
      "formatted_end": "07:02:16.000",
      "text": "اینو بسرش هم نیم"
    },
    {
      "id": 32,
      "start": 25336.0,
      "end": 25338.0,
      "formatted_start": "07:02:16.000",
      "formatted_end": "07:02:18.000",
      "text": "اینو بسری مثلا موسیقی همه چیز میمانه"
    },
    {
      "id": 33,
      "start": 25338.0,
      "end": 25339.0,
      "formatted_start": "07:02:18.000",
      "formatted_end": "07:02:19.000",
      "text": "چقدر بیکاره"
    },
    {
      "id": 34,
      "start": 25339.0,
      "end": 25342.0,
      "formatted_start": "07:02:19.000",
      "formatted_end": "07:02:22.000",
      "text": "موسیقی محمدی میشونسته یکی زنش کنه شیر"
    },
    {
      "id": 35,
      "start": 25342.0,
      "end": 25344.0,
      "formatted_start": "07:02:22.000",
      "formatted_end": "07:02:24.000",
      "text": "موسیقی رضا محمدی"
    },
    {
      "id": 36,
      "start": 25344.0,
      "end": 25346.0,
      "formatted_start": "07:02:24.000",
      "formatted_end": "07:02:26.000",
      "text": "آره زن از قطعه شوهر شنوان"
    },
    {
      "id": 37,
      "start": 25346.0,
      "end": 25348.0,
      "formatted_start": "07:02:26.000",
      "formatted_end": "07:02:28.000",
      "text": "اینکه دوست داره بگه نامو هرنا باید باید بسترش کنیم"
    },
    {
      "id": 38,
      "start": 25348.0,
      "end": 25350.0,
      "formatted_start": "07:02:28.000",
      "formatted_end": "07:02:30.000",
      "text": "ولی اصلا تو شوهر شنوان داره باید باید که بسیار مردم"
    },
    {
      "id": 39,
      "start": 25350.0,
      "end": 25352.0,
      "formatted_start": "07:02:30.000",
      "formatted_end": "07:02:32.000",
      "text": "تو مایی چیز داری؟"
    },
    {
      "id": 40,
      "start": 25352.0,
      "end": 25354.0,
      "formatted_start": "07:02:32.000",
      "formatted_end": "07:02:34.000",
      "text": "اگه من بیکارم"
    },
    {
      "id": 41,
      "start": 25354.0,
      "end": 25356.0,
      "formatted_start": "07:02:34.000",
      "formatted_end": "07:02:36.000",
      "text": "همین کارو کردن که بی ما برشکست کردن"
    },
    {
      "id": 42,
      "start": 25356.0,
      "end": 25358.0,
      "formatted_start": "07:02:36.000",
      "formatted_end": "07:02:38.000",
      "text": "دیراز اومد و پایین دیگه برم نمود"
    },
    {
      "id": 43,
      "start": 25358.0,
      "end": 25360.0,
      "formatted_start": "07:02:38.000",
      "formatted_end": "07:02:40.000",
      "text": "آره دیراز همه ریم شلوغم بوده؟"
    },
    {
      "id": 44,
      "start": 25360.0,
      "end": 25362.0,
      "formatted_start": "07:02:40.000",
      "formatted_end": "07:02:42.000",
      "text": "نه من گفتیم تاییم اپلا بیان بالا"
    },
    {
      "id": 45,
      "start": 25362.0,
      "end": 25366.0,
      "formatted_start": "07:02:42.000",
      "formatted_end": "07:02:46.000",
      "text": "این بالا یکی منو کل کنه برن برن که مونو کلش کنم"
    },
    {
      "id": 46,
      "start": 25366.0,
      "end": 25370.0,
      "formatted_start": "07:02:46.000",
      "formatted_end": "07:02:50.000",
      "text": "برنامه بیو کودشو بفرست 43-0-36"
    },
    {
      "id": 47,
      "start": 25370.0,
      "end": 25372.0,
      "formatted_start": "07:02:50.000",
      "formatted_end": "07:02:52.000",
      "text": "کنم شده"
    },
    {
      "id": 48,
      "start": 25372.0,
      "end": 25374.0,
      "formatted_start": "07:02:52.000",
      "formatted_end": "07:02:54.000",
      "text": "تا نگردو شده صدایی پیدا کنم؟"
    },
    {
      "id": 49,
      "start": 25374.0,
      "end": 25376.0,
      "formatted_start": "07:02:54.000",
      "formatted_end": "07:02:56.000",
      "text": "شماش دارم این اگه"
    },
    {
      "id": 50,
      "start": 25376.0,
      "end": 25378.0,
      "formatted_start": "07:02:56.000",
      "formatted_end": "07:02:58.000",
      "text": "نه دارم آشون شده صدایی دارم بگو"
    },
    {
      "id": 51,
      "start": 25378.0,
      "end": 25380.0,
      "formatted_start": "07:02:58.000",
      "formatted_end": "07:03:00.000",
      "text": "43-0-36"
    },
    {
      "id": 52,
      "start": 25380.0,
      "end": 25384.0,
      "formatted_start": "07:03:00.000",
      "formatted_end": "07:03:04.000",
      "text": "43-3-92"
    },
    {
      "id": 53,
      "start": 25384.0,
      "end": 25386.0,
      "formatted_start": "07:03:04.000",
      "formatted_end": "07:03:06.000",
      "text": "من کهی گفتم درسته؟ 43-3-36"
    },
    {
      "id": 54,
      "start": 25386.0,
      "end": 25388.0,
      "formatted_start": "07:03:06.000",
      "formatted_end": "07:03:08.000",
      "text": "نه بودم درسته"
    },
    {
      "id": 55,
      "start": 25388.0,
      "end": 25392.0,
      "formatted_start": "07:03:08.000",
      "formatted_end": "07:03:12.000",
      "text": "میدم که تیر بودی چه نه بود مردم رو روند میدم"
    },
    {
      "id": 56,
      "start": 25392.0,
      "end": 25394.0,
      "formatted_start": "07:03:12.000",
      "formatted_end": "07:03:14.000",
      "text": "از از سه شش کد من چون؟"
    },
    {
      "id": 57,
      "start": 25406.0,
      "end": 25408.0,
      "formatted_start": "07:03:26.000",
      "formatted_end": "07:03:28.000",
      "text": "یعنی دوباری نفر بود"
    },
    {
      "id": 58,
      "start": 25408.0,
      "end": 25412.0,
      "formatted_start": "07:03:28.000",
      "formatted_end": "07:03:32.000",
      "text": "همه رفتن، همه اومدم بگویم پریبش ایش نسته؟"
    },
    {
      "id": 59,
      "start": 25422.0,
      "end": 25426.0,
      "formatted_start": "07:03:42.000",
      "formatted_end": "07:03:46.000",
      "text": "بچه از اینجا کلمه نپرده چون من نمیگم"
    },
    {
      "id": 60,
      "start": 25426.0,
      "end": 25433.0,
      "formatted_start": "07:03:46.000",
      "formatted_end": "07:03:53.000",
      "text": "بچه اگر حالش خوب نبوده گفت که دخترم داشته اینجا از کجا میامده از بیجن داشته اون پساده بشه"
    },
    {
      "id": 61,
      "start": 25433.0,
      "end": 25435.0,
      "formatted_start": "07:03:53.000",
      "formatted_end": "07:03:55.000",
      "text": "پریبش کدوم بوده اش"
    },
    {
      "id": 62,
      "start": 25435.0,
      "end": 25438.0,
      "formatted_start": "07:03:55.000",
      "formatted_end": "07:03:58.000",
      "text": "پریبش اینجا پیزنه؟ مسلط؟"
    },
    {
      "id": 63,
      "start": 25438.0,
      "end": 25443.0,
      "formatted_start": "07:03:58.000",
      "formatted_end": "07:04:03.000",
      "text": "سقرا پریبش"
    },
    {
      "id": 64,
      "start": 25443.0,
      "end": 25447.0,
      "formatted_start": "07:04:03.000",
      "formatted_end": "07:04:07.000",
      "text": "یک سیاه طوره بود"
    },
    {
      "id": 65,
      "start": 25447.0,
      "end": 25449.0,
      "formatted_start": "07:04:07.000",
      "formatted_end": "07:04:09.000",
      "text": "سیاه طوره بود چادر رنگی داشت"
    },
    {
      "id": 66,
      "start": 25449.0,
      "end": 25451.0,
      "formatted_start": "07:04:09.000",
      "formatted_end": "07:04:11.000",
      "text": "یک کم دوندون بود"
    },
    {
      "id": 67,
      "start": 25451.0,
      "end": 25452.0,
      "formatted_start": "07:04:11.000",
      "formatted_end": "07:04:12.000",
      "text": "دوندون چرا دورش"
    },
    {
      "id": 68,
      "start": 25452.0,
      "end": 25454.0,
      "formatted_start": "07:04:12.000",
      "formatted_end": "07:04:14.000",
      "text": "ها دنپای هم پاش بود"
    },
    {
      "id": 69,
      "start": 25454.0,
      "end": 25456.0,
      "formatted_start": "07:04:14.000",
      "formatted_end": "07:04:16.000",
      "text": "دو تا مارو برگرده بود"
    },
    {
      "id": 70,
      "start": 25456.0,
      "end": 25458.0,
      "formatted_start": "07:04:16.000",
      "formatted_end": "07:04:18.000",
      "text": "هالشو شد پاش رو زبطه بود"
    },
    {
      "id": 71,
      "start": 25458.0,
      "end": 25461.0,
      "formatted_start": "07:04:18.000",
      "formatted_end": "07:04:21.000",
      "text": "مگه ناماتو همی صفته کرده"
    },
    {
      "id": 72,
      "start": 25461.0,
      "end": 25463.0,
      "formatted_start": "07:04:21.000",
      "formatted_end": "07:04:23.000",
      "text": "نه ببین"
    },
    {
      "id": 73,
      "start": 25463.0,
      "end": 25465.0,
      "formatted_start": "07:04:23.000",
      "formatted_end": "07:04:25.000",
      "text": "میرن یه همه زبوری بود که مور نکرده"
    },
    {
      "id": 74,
      "start": 25465.0,
      "end": 25467.0,
      "formatted_start": "07:04:25.000",
      "formatted_end": "07:04:27.000",
      "text": "چرا زبوری نیست؟ تایبه؟"
    },
    {
      "id": 75,
      "start": 25467.0,
      "end": 25469.0,
      "formatted_start": "07:04:27.000",
      "formatted_end": "07:04:29.000",
      "text": "بیجندی ایمام"
    },
    {
      "id": 76,
      "start": 25469.0,
      "end": 25470.0,
      "formatted_start": "07:04:29.000",
      "formatted_end": "07:04:30.000",
      "text": "نه"
    },
    {
      "id": 77,
      "start": 25470.0,
      "end": 25472.0,
      "formatted_start": "07:04:30.000",
      "formatted_end": "07:04:32.000",
      "text": "آره"
    },
    {
      "id": 78,
      "start": 25472.0,
      "end": 25478.0,
      "formatted_start": "07:04:32.000",
      "formatted_end": "07:04:38.000",
      "text": "نه ببین بیجندی همه دارو ها توی نصفه کرده"
    },
    {
      "id": 79,
      "start": 25478.0,
      "end": 25480.0,
      "formatted_start": "07:04:38.000",
      "formatted_end": "07:04:40.000",
      "text": "نسختونی کرده"
    },
    {
      "id": 80,
      "start": 25480.0,
      "end": 25482.0,
      "formatted_start": "07:04:40.000",
      "formatted_end": "07:04:42.000",
      "text": "من گرده آره با کاغذ اینجا نقضو من بودو کرده"
    },
    {
      "id": 81,
      "start": 25482.0,
      "end": 25484.0,
      "formatted_start": "07:04:42.000",
      "formatted_end": "07:04:44.000",
      "text": "من جوده از دخترم دارم"
    },
    {
      "id": 82,
      "start": 25484.0,
      "end": 25486.0,
      "formatted_start": "07:04:44.000",
      "formatted_end": "07:04:46.000",
      "text": "یا پس از بی جهان می آمدن تو جاده اینه"
    },
    {
      "id": 83,
      "start": 25486.0,
      "end": 25488.0,
      "formatted_start": "07:04:46.000",
      "formatted_end": "07:04:48.000",
      "text": "من کجا؟ مایامه اینه"
    },
    {
      "id": 84,
      "start": 25488.0,
      "end": 25490.0,
      "formatted_start": "07:04:48.000",
      "formatted_end": "07:04:50.000",
      "text": "قایم، قایم تصادف کرده"
    },
    {
      "id": 85,
      "start": 25490.0,
      "end": 25492.0,
      "formatted_start": "07:04:50.000",
      "formatted_end": "07:04:52.000",
      "text": "ماشینش رو چپ کرده، یکشون این بیمارست"
    },
    {
      "id": 86,
      "start": 25492.0,
      "end": 25494.0,
      "formatted_start": "07:04:52.000",
      "formatted_end": "07:04:54.000",
      "text": "یکشون این بیمارست، دعا کنی چی نباشه"
    },
    {
      "id": 87,
      "start": 25494.0,
      "end": 25496.0,
      "formatted_start": "07:04:54.000",
      "formatted_end": "07:04:56.000",
      "text": "خدا به خیلی بگذارم"
    },
    {
      "id": 88,
      "start": 25496.0,
      "end": 25498.0,
      "formatted_start": "07:04:56.000",
      "formatted_end": "07:04:58.000",
      "text": "اینجا پرمش داره"
    },
    {
      "id": 89,
      "start": 25498.0,
      "end": 25500.0,
      "formatted_start": "07:04:58.000",
      "formatted_end": "07:05:00.000",
      "text": "اوه، خاطره تا"
    }
  ],
  "status": "completed"
}