  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13808.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:08.000",
      "text": "با اینکه من به دکتر گفته بودم براش برنویز دو تا فرادی رو، اما اصلیه رو نموشته."
    },
    {
      "id": 1,
      "start": 13808.0,
      "end": 13815.0,
      "formatted_start": "03:50:08.000",
      "formatted_end": "03:50:15.000",
      "text": "باز این همونو نویزنید یه دوباره برنید چونکه برساشو مصرف کرد."
    },
    {
      "id": 2,
      "start": 13815.0,
      "end": 13819.0,
      "formatted_start": "03:50:15.000",
      "formatted_end": "03:50:19.000",
      "text": "برش بره، خوبه، یعنی صحب شده، ولی باید آزمایش بره."
    },
    {
      "id": 3,
      "start": 13819.0,
      "end": 13825.0,
      "formatted_start": "03:50:19.000",
      "formatted_end": "03:50:25.000",
      "text": "آزمایش زلعه نداره که براش بلویستگرده، برای تیرویتش هم این زمان بلویستگرده."
    },
    {
      "id": 4,
      "start": 13825.0,
      "end": 13827.0,
      "formatted_start": "03:50:25.000",
      "formatted_end": "03:50:27.000",
      "text": "تیرویدشو چک کرده"
    },
    {
      "id": 5,
      "start": 13827.0,
      "end": 13828.0,
      "formatted_start": "03:50:27.000",
      "formatted_end": "03:50:28.000",
      "text": "پروستاد چی؟"
    },
    {
      "id": 6,
      "start": 13828.0,
      "end": 13830.0,
      "formatted_start": "03:50:28.000",
      "formatted_end": "03:50:30.000",
      "text": "پروستادش نه"
    },
    {
      "id": 7,
      "start": 13830.0,
      "end": 13832.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:32.000",
      "text": "تیرویدشو چک کرده کلی نوشته دیگه"
    },
    {
      "id": 8,
      "start": 13832.0,
      "end": 13834.0,
      "formatted_start": "03:50:32.000",
      "formatted_end": "03:50:34.000",
      "text": "یک کلیهشو چک کرده"
    },
    {
      "id": 9,
      "start": 13834.0,
      "end": 13836.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:36.000",
      "text": "قلب شرمیشو هم چک نکرده"
    },
    {
      "id": 10,
      "start": 13836.0,
      "end": 13838.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:38.000",
      "text": "و ادارهشو چک کرده"
    },
    {
      "id": 11,
      "start": 13838.0,
      "end": 13841.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:41.000",
      "text": "پس یک پروستاد رو با همون آهنگ ورش برنیس"
    },
    {
      "id": 12,
      "start": 13841.0,
      "end": 13843.0,
      "formatted_start": "03:50:41.000",
      "formatted_end": "03:50:43.000",
      "text": "همونش این هم خوب بوده بابا"
    },
    {
      "id": 13,
      "start": 13843.0,
      "end": 13845.0,
      "formatted_start": "03:50:43.000",
      "formatted_end": "03:50:45.000",
      "text": "نمیدونم اینجا اگه"
    },
    {
      "id": 14,
      "start": 13845.0,
      "end": 13847.0,
      "formatted_start": "03:50:45.000",
      "formatted_end": "03:50:47.000",
      "text": "حالا بابا همین چک نکرده خوشگل من"
    },
    {
      "id": 15,
      "start": 13847.0,
      "end": 13849.0,
      "formatted_start": "03:50:47.000",
      "formatted_end": "03:50:49.000",
      "text": "هیچی نیست در آزمایش"
    },
    {
      "id": 16,
      "start": 13849.0,
      "end": 13850.0,
      "formatted_start": "03:50:49.000",
      "formatted_end": "03:50:50.000",
      "text": "بابا از اون هم بینیس کن"
    },
    {
      "id": 17,
      "start": 13855.0,
      "end": 13857.0,
      "formatted_start": "03:50:55.000",
      "formatted_end": "03:50:57.000",
      "text": "چربی آهند این دونم"
    },
    {
      "id": 18,
      "start": 13857.0,
      "end": 13859.0,
      "formatted_start": "03:50:57.000",
      "formatted_end": "03:50:59.000",
      "text": "چیز خاصی نداشت"
    },
    {
      "id": 19,
      "start": 13859.0,
      "end": 13861.0,
      "formatted_start": "03:50:59.000",
      "formatted_end": "03:51:01.000",
      "text": "پرستادشو"
    },
    {
      "id": 20,
      "start": 13861.0,
      "end": 13863.0,
      "formatted_start": "03:51:01.000",
      "formatted_end": "03:51:03.000",
      "text": "این اصلی ها رو نداشت"
    },
    {
      "id": 21,
      "start": 13863.0,
      "end": 13867.0,
      "formatted_start": "03:51:03.000",
      "formatted_end": "03:51:07.000",
      "text": "پیس پرستاد تخصصیه"
    },
    {
      "id": 22,
      "start": 13867.0,
      "end": 13869.0,
      "formatted_start": "03:51:07.000",
      "formatted_end": "03:51:09.000",
      "text": "آه یعنی اون به نفسم نمیاد"
    },
    {
      "id": 23,
      "start": 13869.0,
      "end": 13871.0,
      "formatted_start": "03:51:09.000",
      "formatted_end": "03:51:11.000",
      "text": "آزاد هم چرا باشه"
    },
    {
      "id": 24,
      "start": 13871.0,
      "end": 13873.0,
      "formatted_start": "03:51:11.000",
      "formatted_end": "03:51:13.000",
      "text": "خواهیم جانباز هم هسته"
    },
    {
      "id": 25,
      "start": 13873.0,
      "end": 13875.0,
      "formatted_start": "03:51:13.000",
      "formatted_end": "03:51:15.000",
      "text": "دیگه جانبازی قبول بخوره"
    },
    {
      "id": 26,
      "start": 13875.0,
      "end": 13877.0,
      "formatted_start": "03:51:15.000",
      "formatted_end": "03:51:17.000",
      "text": "نبینی"
    },
    {
      "id": 27,
      "start": 13877.0,
      "end": 13880.0,
      "formatted_start": "03:51:17.000",
      "formatted_end": "03:51:20.000",
      "text": "الان امروز رفته دارواش مال خیلی مدت بوده یا"
    },
    {
      "id": 28,
      "start": 13880.0,
      "end": 13882.0,
      "formatted_start": "03:51:20.000",
      "formatted_end": "03:51:22.000",
      "text": "الان دیگه فکر کنی یه برجی"
    },
    {
      "id": 29,
      "start": 13882.0,
      "end": 13886.54,
      "formatted_start": "03:51:22.000",
      "formatted_end": "03:51:26.540",
      "text": "برای پرستای چرا رفتم بگیرم که سی تا شبا بیمه میدم سی تا رو باز پردادم"
    },
    {
      "id": 30,
      "start": 13886.54,
      "end": 13887.58,
      "formatted_start": "03:51:26.540",
      "formatted_end": "03:51:27.580",
      "text": "آره آزاد بیرون"
    },
    {
      "id": 31,
      "start": 13887.58,
      "end": 13889.88,
      "formatted_start": "03:51:27.580",
      "formatted_end": "03:51:29.880",
      "text": "از این شیط که مثلا میرون یک گوشی نشونید"
    },
    {
      "id": 32,
      "start": 13889.88,
      "end": 13891.68,
      "formatted_start": "03:51:29.880",
      "formatted_end": "03:51:31.680",
      "text": "برای چی؟"
    },
    {
      "id": 33,
      "start": 13891.68,
      "end": 13893.54,
      "formatted_start": "03:51:31.680",
      "formatted_end": "03:51:33.540",
      "text": "شب به خاطر که یه ماه میخوام بدم"
    },
    {
      "id": 34,
      "start": 13893.54,
      "end": 13895.48,
      "formatted_start": "03:51:33.540",
      "formatted_end": "03:51:35.480",
      "text": "تو وقتی اینجوری یه ماه پیشتر دارو نداری"
    },
    {
      "id": 35,
      "start": 13895.48,
      "end": 13896.52,
      "formatted_start": "03:51:35.480",
      "formatted_end": "03:51:36.520",
      "text": "گفتم دیگه خب"
    },
    {
      "id": 36,
      "start": 13896.52,
      "end": 13899.14,
      "formatted_start": "03:51:36.520",
      "formatted_end": "03:51:39.140",
      "text": "وقتی میره پیش ما بگو یه ماه برمیستیم"
    },
    {
      "id": 37,
      "start": 13899.14,
      "end": 13899.76,
      "formatted_start": "03:51:39.140",
      "formatted_end": "03:51:39.760",
      "text": "اره یه ماه"
    },
    {
      "id": 38,
      "start": 13899.76,
      "end": 13901.06,
      "formatted_start": "03:51:39.760",
      "formatted_end": "03:51:41.060",
      "text": "اینها این کار رو میکنن دیگه"
    },
    {
      "id": 39,
      "start": 13901.06,
      "end": 13902.58,
      "formatted_start": "03:51:41.060",
      "formatted_end": "03:51:42.580",
      "text": "مثلا تا یه حدی بیرونیدم"
    },
    {
      "id": 40,
      "start": 13912.0,
      "end": 13916.5,
      "formatted_start": "03:51:52.000",
      "formatted_end": "03:51:56.500",
      "text": "دولار کلت ۴۵ دو ماه میده بخیره مثلا سه ماه دارو میدن"
    },
    {
      "id": 41,
      "start": 13916.5,
      "end": 13921.5,
      "formatted_start": "03:51:56.500",
      "formatted_end": "03:52:01.500",
      "text": "بعد بعضی از بیماها یا مثلا پوستاین جامعازهای اینها که ۱۰ پول بدن"
    },
    {
      "id": 42,
      "start": 13921.5,
      "end": 13925.5,
      "formatted_start": "03:52:01.500",
      "formatted_end": "03:52:05.500",
      "text": "اونو مثلا یه سخت میزارن سی تا رای برن سی تا والتن"
    },
    {
      "id": 43,
      "start": 13925.5,
      "end": 13930.5,
      "formatted_start": "03:52:05.500",
      "formatted_end": "03:52:10.500",
      "text": "خب شما وقتی که میایید ما که نمیدونیم ما میخواییم مثلا به مریض خوبی کنیم که عذیت نشه بره بیاد"
    },
    {
      "id": 44,
      "start": 13930.5,
      "end": 13935.46,
      "formatted_start": "03:52:10.500",
      "formatted_end": "03:52:15.460",
      "text": "بگید یه ماه بگید بزیار مریض ها می آمده میگن فقط سیت های برمون دارو بگید"
    },
    {
      "id": 45,
      "start": 13935.46,
      "end": 13937.56,
      "formatted_start": "03:52:15.460",
      "formatted_end": "03:52:17.560",
      "text": "نه نیه آمده نیمه چیزش هم"
    },
    {
      "id": 46,
      "start": 13937.56,
      "end": 13941.14,
      "formatted_start": "03:52:17.560",
      "formatted_end": "03:52:21.140",
      "text": "پس الان آره دیگه همون داروی ها رو باز براش چیز کنید"
    },
    {
      "id": 47,
      "start": 13941.14,
      "end": 13944.08,
      "formatted_start": "03:52:21.140",
      "formatted_end": "03:52:24.080",
      "text": "برمیسید که من باز بعدم بگیریم دیگه آره"
    },
    {
      "id": 48,
      "start": 13944.08,
      "end": 13945.26,
      "formatted_start": "03:52:24.080",
      "formatted_end": "03:52:25.260",
      "text": "خب برژه دیگه"
    },
    {
      "id": 49,
      "start": 13945.26,
      "end": 13948.02,
      "formatted_start": "03:52:25.260",
      "formatted_end": "03:52:28.020",
      "text": "خب برژه دیگه که نسخه تون واطل میشه ازش"
    },
    {
      "id": 50,
      "start": 13948.02,
      "end": 13950.78,
      "formatted_start": "03:52:28.020",
      "formatted_end": "03:52:30.780",
      "text": "شما فقط نسخه تون تا آخر یه برژه اتباعید"
    },
    {
      "id": 51,
      "start": 13950.78,
      "end": 13954.02,
      "formatted_start": "03:52:30.780",
      "formatted_end": "03:52:34.020",
      "text": "خب آخر همین برج، اول اون برج دیگه بگیریم"
    },
    {
      "id": 52,
      "start": 13954.02,
      "end": 13955.02,
      "formatted_start": "03:52:34.020",
      "formatted_end": "03:52:35.020",
      "text": "پرستاتشه"
    },
    {
      "id": 53,
      "start": 13955.02,
      "end": 13956.28,
      "formatted_start": "03:52:35.020",
      "formatted_end": "03:52:36.280",
      "text": "آره دیگه"
    },
    {
      "id": 54,
      "start": 13956.28,
      "end": 13958.48,
      "formatted_start": "03:52:36.280",
      "formatted_end": "03:52:38.480",
      "text": "همون باریجی چیه؟"
    },
    {
      "id": 55,
      "start": 13958.48,
      "end": 13959.22,
      "formatted_start": "03:52:38.480",
      "formatted_end": "03:52:39.220",
      "text": "اونو هیچی هم"
    },
    {
      "id": 56,
      "start": 13959.22,
      "end": 13962.46,
      "formatted_start": "03:52:39.220",
      "formatted_end": "03:52:42.460",
      "text": "بارش که کلن آزاده، پرستا بارش"
    },
    {
      "id": 57,
      "start": 13962.46,
      "end": 13965.08,
      "formatted_start": "03:52:42.460",
      "formatted_end": "03:52:45.080",
      "text": "پرستات هم بیمه هست"
    },
    {
      "id": 58,
      "start": 13965.08,
      "end": 13968.6,
      "formatted_start": "03:52:45.080",
      "formatted_end": "03:52:48.600",
      "text": "پرستا بارش اینا دیگه سی فیلموس کارسای داستانی"
    },
    {
      "id": 59,
      "start": 13968.6,
      "end": 13970.06,
      "formatted_start": "03:52:48.600",
      "formatted_end": "03:52:50.060",
      "text": "برخوشن آره یکی رو"
    },
    {
      "id": 60,
      "start": 13970.06,
      "end": 13971.46,
      "formatted_start": "03:52:50.060",
      "formatted_end": "03:52:51.460",
      "text": "آره"
    },
    {
      "id": 61,
      "start": 13971.46,
      "end": 13973.48,
      "formatted_start": "03:52:51.460",
      "formatted_end": "03:52:53.480",
      "text": "الان برا من احساسی هم نمیشنی"
    },
    {
      "id": 62,
      "start": 13973.48,
      "end": 13973.88,
      "formatted_start": "03:52:53.480",
      "formatted_end": "03:52:53.880",
      "text": "آره"
    },
    {
      "id": 63,
      "start": 13973.88,
      "end": 13976.82,
      "formatted_start": "03:52:53.880",
      "formatted_end": "03:52:56.820",
      "text": "مثلا یا کن من مثلا هم هم پرستانو هن فرفولی"
    },
    {
      "id": 64,
      "start": 13976.82,
      "end": 13978.82,
      "formatted_start": "03:52:56.820",
      "formatted_end": "03:52:58.820",
      "text": "فروستورفول بیمه میخوره"
    },
    {
      "id": 65,
      "start": 13978.82,
      "end": 13980.82,
      "formatted_start": "03:52:58.820",
      "formatted_end": "03:53:00.820",
      "text": "خب اگر از این فروستورفوله میشه آزاده"
    },
    {
      "id": 66,
      "start": 13980.82,
      "end": 13984.82,
      "formatted_start": "03:53:00.820",
      "formatted_end": "03:53:04.820",
      "text": "از این چیزهایی میزنن که میبینم خودتون نمونده"
    },
    {
      "id": 67,
      "start": 13984.82,
      "end": 13986.82,
      "formatted_start": "03:53:04.820",
      "formatted_end": "03:53:06.820",
      "text": "بابا اینکه سکاره هم بینیم یه چی دارش؟"
    },
    {
      "id": 68,
      "start": 13986.82,
      "end": 13988.82,
      "formatted_start": "03:53:06.820",
      "formatted_end": "03:53:08.820",
      "text": "سکاره آزاده میزنن"
    },
    {
      "id": 69,
      "start": 13988.82,
      "end": 13989.82,
      "formatted_start": "03:53:08.820",
      "formatted_end": "03:53:09.820",
      "text": "پولاً آزاده؟"
    },
    {
      "id": 70,
      "start": 13989.82,
      "end": 13991.82,
      "formatted_start": "03:53:09.820",
      "formatted_end": "03:53:11.820",
      "text": "اما اگه بروفن بخوری با استامیلافن بیمزده"
    },
    {
      "id": 71,
      "start": 13991.82,
      "end": 13993.82,
      "formatted_start": "03:53:11.820",
      "formatted_end": "03:53:13.820",
      "text": "یعنی پولاً سکاره پولاً؟"
    },
    {
      "id": 72,
      "start": 13993.82,
      "end": 13995.82,
      "formatted_start": "03:53:13.820",
      "formatted_end": "03:53:15.820",
      "text": "سکاره آزاده"
    },
    {
      "id": 73,
      "start": 13995.82,
      "end": 13998.82,
      "formatted_start": "03:53:15.820",
      "formatted_end": "03:53:18.820",
      "text": "بلی بروفن و استامیلافن بیمزده"
    },
    {
      "id": 74,
      "start": 13998.82,
      "end": 14001.48,
      "formatted_start": "03:53:18.820",
      "formatted_end": "03:53:21.480",
      "text": "اصلا جیروفن آزاده بلی بروفن بیمه است"
    },
    {
      "id": 75,
      "start": 14001.48,
      "end": 14003.56,
      "formatted_start": "03:53:21.480",
      "formatted_end": "03:53:23.560",
      "text": "اینجا ما تو رنگا میبینیم دیگه"
    },
    {
      "id": 76,
      "start": 14003.56,
      "end": 14005.76,
      "formatted_start": "03:53:23.560",
      "formatted_end": "03:53:25.760",
      "text": "مثلا اگه انا سکاره قرمزه"
    },
    {
      "id": 77,
      "start": 14005.76,
      "end": 14007.56,
      "formatted_start": "03:53:25.760",
      "formatted_end": "03:53:27.560",
      "text": "قرمز یعنی آزاده"
    },
    {
      "id": 78,
      "start": 14007.56,
      "end": 14009.06,
      "formatted_start": "03:53:27.560",
      "formatted_end": "03:53:29.060",
      "text": "سیاه یعنی بیمه"
    },
    {
      "id": 79,
      "start": 14009.06,
      "end": 14013.88,
      "formatted_start": "03:53:29.060",
      "formatted_end": "03:53:33.880",
      "text": "یه زمان زبان یعنی دیگه نمی آلمه کردین دارید"
    },
    {
      "id": 80,
      "start": 14013.88,
      "end": 14016.12,
      "formatted_start": "03:53:33.880",
      "formatted_end": "03:53:36.120",
      "text": "خب دیگه همون کاری کردم هر شکست کردن"
    },
    {
      "id": 81,
      "start": 14016.12,
      "end": 14017.48,
      "formatted_start": "03:53:36.120",
      "formatted_end": "03:53:37.480",
      "text": "دیگه اینا هم هر چی میتونید"
    },
    {
      "id": 82,
      "start": 14017.48,
      "end": 14018.28,
      "formatted_start": "03:53:37.480",
      "formatted_end": "03:53:38.280",
      "text": "مردم هم"
    },
    {
      "id": 83,
      "start": 14018.28,
      "end": 14020.12,
      "formatted_start": "03:53:38.280",
      "formatted_end": "03:53:40.120",
      "text": "گرون گرون مینوشتن"
    },
    {
      "id": 84,
      "start": 14020.12,
      "end": 14023.56,
      "formatted_start": "03:53:40.120",
      "formatted_end": "03:53:43.560",
      "text": "نسخه هایی میخواستیم بخوایید ششخ ببینیم همون موقع"
    },
    {
      "id": 85,
      "start": 14028.82,
      "end": 14031.82,
      "formatted_start": "03:53:48.820",
      "formatted_end": "03:53:51.820",
      "text": "اونهایی که ندارن میان حق و اونهایی که واقعا نیاز دارن"
    },
    {
      "id": 86,
      "start": 14031.82,
      "end": 14034.82,
      "formatted_start": "03:53:51.820",
      "formatted_end": "03:53:54.820",
      "text": "الان که دیگه مور هم هست اینکه شن بیرون چون اینکه از آنهایی برشکست کرده"
    },
    {
      "id": 87,
      "start": 14034.82,
      "end": 14035.82,
      "formatted_start": "03:53:54.820",
      "formatted_end": "03:53:55.820",
      "text": "آمده"
    },
    {
      "id": 88,
      "start": 14035.82,
      "end": 14040.82,
      "formatted_start": "03:53:55.820",
      "formatted_end": "03:54:00.820",
      "text": "مثل من اینکه داروم هستم داروی پیونه واقعا ایتیاج دارم"
    },
    {
      "id": 89,
      "start": 14040.82,
      "end": 14043.82,
      "formatted_start": "03:54:00.820",
      "formatted_end": "03:54:03.820",
      "text": "بعضی ها خب ندارن و ندارم بگیرم"
    },
    {
      "id": 90,
      "start": 14043.82,
      "end": 14045.82,
      "formatted_start": "03:54:03.820",
      "formatted_end": "03:54:05.820",
      "text": "چی میدونی بالا؟"
    },
    {
      "id": 91,
      "start": 14045.82,
      "end": 14049.82,
      "formatted_start": "03:54:05.820",
      "formatted_end": "03:54:09.820",
      "text": "یه بزرگ پرسشو نگذارم"
    },
    {
      "id": 92,
      "start": 14049.82,
      "end": 14051.82,
      "formatted_start": "03:54:09.820",
      "formatted_end": "03:54:11.820",
      "text": "یه بیاد به دواز رو باید بابا بخوره"
    },
    {
      "id": 93,
      "start": 14051.82,
      "end": 14053.82,
      "formatted_start": "03:54:11.820",
      "formatted_end": "03:54:13.820",
      "text": "نمشتم برش آزاده بیمیرسه"
    },
    {
      "id": 94,
      "start": 14053.82,
      "end": 14055.82,
      "formatted_start": "03:54:13.820",
      "formatted_end": "03:54:15.820",
      "text": "درست کنید که این گوشت قرمز هست"
    },
