  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11430.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:30.000",
      "text": "از اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر اینجا، من دیگر ا"
    },
    {
      "id": 1,
      "start": 11430.0,
      "end": 11439.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:10:39.000",
      "text": "یکی که به اتحادی دارد. بقیه رفتم به شفارادی هم، بگوید دروهایی که مثلا مال همین تقویتی نست."
    },
    {
      "id": 2,
      "start": 11439.0,
      "end": 11444.0,
      "formatted_start": "03:10:39.000",
      "formatted_end": "03:10:44.000",
      "text": "همش از همین هم نمیشه. داد من الان مایی مفروم. تقویتی."
    },
    {
      "id": 3,
      "start": 11444.0,
      "end": 11448.0,
      "formatted_start": "03:10:44.000",
      "formatted_end": "03:10:48.000",
      "text": "کلسیوم فقط نمیشن ببین که دوتا نخورید. خب بچه ها بگی نگاه کنند."
    },
    {
      "id": 4,
      "start": 11448.0,
      "end": 11452.0,
      "formatted_start": "03:10:48.000",
      "formatted_end": "03:10:52.000",
      "text": "اگه من دروها من میاردم اون روز خوب بود. بیایی."
    },
    {
      "id": 5,
      "start": 11452.0,
      "end": 11456.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:56.000",
      "text": "آره. چون کلسیوم آزاد هم از بر پول بده."
    },
    {
      "id": 6,
      "start": 11456.0,
      "end": 11460.0,
      "formatted_start": "03:10:56.000",
      "formatted_end": "03:11:00.000",
      "text": "یه وستشه و پونسهت دارم بگیتم"
    },
    {
      "id": 7,
      "start": 11460.0,
      "end": 11462.0,
      "formatted_start": "03:11:00.000",
      "formatted_end": "03:11:02.000",
      "text": "دو ملی ها پول دارو هم شده"
    },
    {
      "id": 8,
      "start": 11462.0,
      "end": 11464.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:04.000",
      "text": "کاش می آبادی"
    },
    {
      "id": 9,
      "start": 11464.0,
      "end": 11468.0,
      "formatted_start": "03:11:04.000",
      "formatted_end": "03:11:08.000",
      "text": "حالا اگه رفتی دارو خونه دیگه پول هستی هست میشه بگو ترمیتی ما نده"
    },
    {
      "id": 10,
      "start": 11468.0,
      "end": 11472.0,
      "formatted_start": "03:11:08.000",
      "formatted_end": "03:11:12.000",
      "text": "بعد اونو بیار ببینم اگه اونا خوب بود بگم از همونا بخوری"
    },
    {
      "id": 11,
      "start": 11472.0,
      "end": 11474.0,
      "formatted_start": "03:11:12.000",
      "formatted_end": "03:11:14.000",
      "text": "بعد اگه دیدم خوب نیست بگم که بخریش"
    },
    {
      "id": 12,
      "start": 11474.0,
      "end": 11475.0,
      "formatted_start": "03:11:14.000",
      "formatted_end": "03:11:15.000",
      "text": "باشم؟"
    },
    {
      "id": 13,
      "start": 11475.0,
      "end": 11476.0,
      "formatted_start": "03:11:15.000",
      "formatted_end": "03:11:16.000",
      "text": "باشم این آزمایش کلی منیستی؟"
    },
    {
      "id": 14,
      "start": 11476.0,
      "end": 11477.0,
      "formatted_start": "03:11:16.000",
      "formatted_end": "03:11:17.000",
      "text": "باشم"
    },
    {
      "id": 15,
      "start": 11477.0,
      "end": 11479.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:19.000",
      "text": "این آزمایش هست از هرگز"
    },
    {
      "id": 16,
      "start": 11479.0,
      "end": 11483.0,
      "formatted_start": "03:11:19.000",
      "formatted_end": "03:11:23.000",
      "text": "این دامادم باشه شاید کلیه زرمون خورده"
    },
    {
      "id": 17,
      "start": 11483.0,
      "end": 11485.0,
      "formatted_start": "03:11:23.000",
      "formatted_end": "03:11:25.000",
      "text": "گفتن نمیدونم"
    },
    {
      "id": 18,
      "start": 11485.0,
      "end": 11487.0,
      "formatted_start": "03:11:25.000",
      "formatted_end": "03:11:27.000",
      "text": "آل من آزمایش کل می نویسم"
    },
    {
      "id": 19,
      "start": 11489.0,
      "end": 11491.0,
      "formatted_start": "03:11:29.000",
      "formatted_end": "03:11:31.000",
      "text": "خود منشون خواهم نفرستم"
    },
    {
      "id": 20,
      "start": 11492.0,
      "end": 11494.0,
      "formatted_start": "03:11:32.000",
      "formatted_end": "03:11:34.000",
      "text": "ولی کلیسیون ندارم فقط نکنیم"
    },
    {
      "id": 21,
      "start": 11494.0,
      "end": 11495.0,
      "formatted_start": "03:11:34.000",
      "formatted_end": "03:11:35.000",
      "text": "باش"
    },
