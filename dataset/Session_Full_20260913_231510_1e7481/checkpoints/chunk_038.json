      "id": 23,
      "start": 11497.0,
      "end": 11499.0,
      "formatted_start": "03:11:37.000",
      "formatted_end": "03:11:39.000",
      "text": "ببین داروخونو مثل اون نوشتم"
    },
    {
      "id": 24,
      "start": 11499.0,
      "end": 11500.0,
      "formatted_start": "03:11:39.000",
      "formatted_end": "03:11:40.000",
      "text": "نیسته نمیدونه"
    },
