  "stt_segments": [
    {
      "id": 0,
      "start": 19800.0,
      "end": 19802.0,
      "formatted_start": "05:30:00.000",
      "formatted_end": "05:30:02.000",
      "text": "همیشه؟"
    },
    {
      "id": 1,
      "start": 19802.0,
      "end": 19804.0,
      "formatted_start": "05:30:02.000",
      "formatted_end": "05:30:04.000",
      "text": "آره، بیشتر برم."
    },
    {
      "id": 2,
      "start": 19804.0,
      "end": 19806.0,
      "formatted_start": "05:30:04.000",
      "formatted_end": "05:30:06.000",
      "text": "کف دستاتون رو نمیدونی؟"
    },
    {
      "id": 3,
      "start": 19808.0,
      "end": 19810.0,
      "formatted_start": "05:30:08.000",
      "formatted_end": "05:30:10.000",
      "text": "دستاتون ساخت میگردم، بخشی."
    },
    {
      "id": 4,
      "start": 19810.0,
      "end": 19814.0,
      "formatted_start": "05:30:10.000",
      "formatted_end": "05:30:14.000",
      "text": "بیند، الانه پرکاری رو ندادید."
    },
    {
      "id": 5,
      "start": 19814.0,
      "end": 19820.0,
      "formatted_start": "05:30:14.000",
      "formatted_end": "05:30:20.000",
      "text": "پرکاری، در حال یه موضوع آمیز دیگه آمیز نیست، خیلی سرغبه، صورتش پرغبه، دستاش آمی چکه،"
    },
    {
      "id": 6,
      "start": 19820.0,
      "end": 19826.0,
      "formatted_start": "05:30:20.000",
      "formatted_end": "05:30:26.000",
      "text": "و یا میلرد اینجوری یه دفعه لاتر شده. این یه دونه آزمایش کنی، هیچ عرضش نداشت."
    },
    {
      "id": 7,
      "start": 19826.0,
      "end": 19828.0,
      "formatted_start": "05:30:26.000",
      "formatted_end": "05:30:28.000",
      "text": "این مدت استرس داشت"
    },
    {
      "id": 8,
      "start": 19828.0,
      "end": 19832.0,
      "formatted_start": "05:30:28.000",
      "formatted_end": "05:30:32.000",
      "text": "هر دنبه گرمایی، هواینا، ترقل فسوا و شرایطها میتونه آسماشو برم بزنید"
    },
    {
      "id": 9,
      "start": 19832.0,
      "end": 19834.0,
      "formatted_start": "05:30:32.000",
      "formatted_end": "05:30:34.000",
      "text": "سه ماه دیگه چی کنید؟"
    },
    {
      "id": 10,
      "start": 19834.0,
      "end": 19838.0,
      "formatted_start": "05:30:34.000",
      "formatted_end": "05:30:38.000",
      "text": "آسماش و پروستاتتون از نظر برخیمی مشکلی نداره"
    },
    {
      "id": 11,
      "start": 19838.0,
      "end": 19843.0,
      "formatted_start": "05:30:38.000",
      "formatted_end": "05:30:43.000",
      "text": "اما از نظر چیز در اون بزرگ شده"
    },
    {
      "id": 12,
      "start": 19843.0,
      "end": 19846.0,
      "formatted_start": "05:30:43.000",
      "formatted_end": "05:30:46.000",
      "text": "اداره داره که توش پرتین داره به خاطر آسماشو بزنه"
    },
    {
      "id": 13,
      "start": 19846.0,
      "end": 19849.0,
      "formatted_start": "05:30:46.000",
      "formatted_end": "05:30:49.000",
      "text": "خون از کجا میاد؟ از کیستای کلویت"
    },
    {
      "id": 14,
      "start": 19849.0,
      "end": 19851.0,
      "formatted_start": "05:30:49.000",
      "formatted_end": "05:30:51.000",
      "text": "کیستای کلویشی نه، همه شده"
    },
    {
      "id": 15,
      "start": 19851.0,
      "end": 19853.0,
      "formatted_start": "05:30:51.000",
      "formatted_end": "05:30:53.000",
      "text": "این پرستاد بزرگ شده و سخته"
    },
    {
      "id": 16,
      "start": 19853.0,
      "end": 19855.0,
      "formatted_start": "05:30:53.000",
      "formatted_end": "05:30:55.000",
      "text": "شما کسی پرستاد می کنید؟"
    },
    {
      "id": 17,
      "start": 19855.0,
      "end": 19857.0,
      "formatted_start": "05:30:55.000",
      "formatted_end": "05:30:57.000",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 19857.0,
      "end": 19859.0,
      "formatted_start": "05:30:57.000",
      "formatted_end": "05:30:59.000",
      "text": "برقرار دیگه هم هست"
    },
    {
      "id": 19,
      "start": 19859.0,
      "end": 19861.0,
      "formatted_start": "05:30:59.000",
      "formatted_end": "05:31:01.000",
      "text": "اونو بعد بشه"
    },
    {
      "id": 20,
      "start": 19861.0,
      "end": 19863.0,
      "formatted_start": "05:31:01.000",
      "formatted_end": "05:31:03.000",
      "text": "اونو بعد بشه"
    },
    {
      "id": 21,
      "start": 19863.0,
      "end": 19865.0,
      "formatted_start": "05:31:03.000",
      "formatted_end": "05:31:05.000",
      "text": "سافر کنم یه دارو"
    },
    {
      "id": 22,
      "start": 19875.0,
      "end": 19877.0,
      "formatted_start": "05:31:15.000",
      "formatted_end": "05:31:17.000",
      "text": "یک بار برگردین یه غرص فیناسترات"
    },
    {
      "id": 23,
      "start": 19877.0,
      "end": 19879.0,
      "formatted_start": "05:31:17.000",
      "formatted_end": "05:31:19.000",
      "text": "پنج داده بودم برگردین"
    },
    {
      "id": 24,
      "start": 19879.0,
      "end": 19881.76,
      "formatted_start": "05:31:19.000",
      "formatted_end": "05:31:21.760",
      "text": "ساید پنج داده بودن بهتون نساخته"
    },
    {
      "id": 25,
      "start": 19881.76,
      "end": 19883.76,
      "formatted_start": "05:31:21.760",
      "formatted_end": "05:31:23.760",
      "text": "یه سری بهتون داده بودن"
    },
    {
      "id": 26,
      "start": 19883.76,
      "end": 19885.76,
      "formatted_start": "05:31:23.760",
      "formatted_end": "05:31:25.760",
      "text": "من خب همیشه نمیخوردم"
    },
    {
      "id": 27,
      "start": 19885.76,
      "end": 19887.76,
      "formatted_start": "05:31:25.760",
      "formatted_end": "05:31:27.760",
      "text": "هم چرا نخوردن؟ هم خوشده بودن"
    },
    {
      "id": 28,
      "start": 19887.76,
      "end": 19889.76,
      "formatted_start": "05:31:27.760",
      "formatted_end": "05:31:29.760",
      "text": "آره دیگه همونه"
    },
    {
      "id": 29,
      "start": 19889.76,
      "end": 19891.76,
      "formatted_start": "05:31:29.760",
      "formatted_end": "05:31:31.760",
      "text": "همون دیگه بزار کردن"
    },
    {
      "id": 30,
      "start": 19891.76,
      "end": 19893.76,
      "formatted_start": "05:31:31.760",
      "formatted_end": "05:31:33.760",
      "text": "خب همه تا چه خانم بود با خضیبت میشه"
    },
    {
      "id": 31,
      "start": 19893.76,
      "end": 19895.76,
      "formatted_start": "05:31:33.760",
      "formatted_end": "05:31:35.760",
      "text": "بخاطر اینکه"
    },
    {
      "id": 32,
      "start": 19895.76,
      "end": 19897.76,
      "formatted_start": "05:31:35.760",
      "formatted_end": "05:31:37.760",
      "text": "نه خیلی هم خوشده بود"
    },
    {
      "id": 33,
      "start": 19897.76,
      "end": 19898.76,
      "formatted_start": "05:31:37.760",
      "formatted_end": "05:31:38.760",
      "text": "آه خوبه"
    },
    {
      "id": 34,
      "start": 19898.76,
      "end": 19900.76,
      "formatted_start": "05:31:38.760",
      "formatted_end": "05:31:40.760",
      "text": "50 سی سی ادرار میمونه"
    },
    {
      "id": 35,
      "start": 19900.76,
      "end": 19902.76,
      "formatted_start": "05:31:40.760",
      "formatted_end": "05:31:42.760",
      "text": "حساب کنیم 50 سی سی چه هده"
    },
    {
      "id": 36,
      "start": 19902.76,
      "end": 19904.76,
      "formatted_start": "05:31:42.760",
      "formatted_end": "05:31:44.760",
      "text": "فرنجون ها بند کچیک میشه خب"
    },
    {
      "id": 37,
      "start": 19904.76,
      "end": 19914.76,
      "formatted_start": "05:31:44.760",
      "formatted_end": "05:31:54.760",
      "text": "این اطراف گندابه دیگه، این میمونه، این افونت میکنه و شما از اون رو برد کست کلیه فکر کنید دو تا نظران یک سری نوزاد میکنن"
    },
    {
      "id": 38,
      "start": 19914.76,
      "end": 19923.76,
      "formatted_start": "05:31:54.760",
      "formatted_end": "05:32:03.760",
      "text": "اونا به شده در مرز افونت هستند، اگه افونت کنند کلیه خراب میشه، بعد اون پایین رو که اطراف مونده دیگه هم میداره، خیلی آسیب است"
    },
    {
      "id": 39,
      "start": 19923.76,
      "end": 19925.76,
      "formatted_start": "05:32:03.760",
      "formatted_end": "05:32:05.760",
      "text": "از داریات رو بخون"
    },
    {
      "id": 40,
      "start": 19953.76,
      "end": 19958.76,
      "formatted_start": "05:32:33.760",
      "formatted_end": "05:32:38.760",
      "text": "ببینید که این سنگ کل اینو بخوره یک کیست هست میبینید و راست نیست"
    },
    {
      "id": 41,
      "start": 19958.76,
      "end": 19964.76,
      "formatted_start": "05:32:38.760",
      "formatted_end": "05:32:44.760",
      "text": "خودتون شان فکر کنید که کیست یک ارگانه خب مثل انگشت بران آدم"
    },
    {
      "id": 42,
      "start": 19964.76,
      "end": 19967.76,
      "formatted_start": "05:32:44.760",
      "formatted_end": "05:32:47.760",
      "text": "اگر از ببینید کیست سنگی نیست که کیسته"
    },
    {
      "id": 43,
      "start": 19967.76,
      "end": 19970.76,
      "formatted_start": "05:32:47.760",
      "formatted_end": "05:32:50.760",
      "text": "راحتداری ها بازرگی هست داری نیست"
    },
    {
      "id": 44,
      "start": 19970.76,
      "end": 19975.76,
      "formatted_start": "05:32:50.760",
      "formatted_end": "05:32:55.760",
      "text": "اصلا کیست دارو نداره خودتون هم هم موگل هست دیگه یه سرش بگنید"
    },
    {
      "id": 45,
      "start": 19975.76,
      "end": 19978.76,
      "formatted_start": "05:32:55.760",
      "formatted_end": "05:32:58.760",
      "text": "یه سرش بگنید آیا کیست کلی درمان نداره؟ نه درمان دیگه"
    },
    {
      "id": 46,
      "start": 19978.76,
      "end": 19984.76,
      "formatted_start": "05:32:58.760",
      "formatted_end": "05:33:04.760",
      "text": "تا هشت سال تا جرایی نمیشه یعنی زودت همیشه پزشک دست برمان نمیشه براش"
    },
    {
      "id": 47,
      "start": 19984.76,
      "end": 19988.76,
      "formatted_start": "05:33:04.760",
      "formatted_end": "05:33:08.760",
      "text": "چون کلی اوزمی کنه یه که اگه عمل کنه آسیب میبینه"
    },
    {
      "id": 48,
      "start": 19988.76,
      "end": 19992.76,
      "formatted_start": "05:33:08.760",
      "formatted_end": "05:33:12.760",
      "text": "تو سوماهاتون دیدین اونجایی که عمل کردن سنگتون در برای نوشته آسیب"
    },
    {
      "id": 49,
      "start": 19992.76,
      "end": 19994.76,
      "formatted_start": "05:33:12.760",
      "formatted_end": "05:33:14.760",
      "text": "اسکار قدیلی ناشه از جرایی دیده میشه"
    },
    {
      "id": 50,
      "start": 19994.76,
      "end": 19998.76,
      "formatted_start": "05:33:14.760",
      "formatted_end": "05:33:18.760",
      "text": "یعنی اون تیکه ای که باز میکنن کلن عمل کردشو از دست میده"
    },
    {
      "id": 51,
      "start": 19998.76,
      "end": 20002.76,
      "formatted_start": "05:33:18.760",
      "formatted_end": "05:33:22.760",
      "text": "برای اون هیچ پزشک زود کلی مریض اعمال نمی کنه"
    },
    {
      "id": 52,
      "start": 20002.76,
      "end": 20012.76,
      "formatted_start": "05:33:22.760",
      "formatted_end": "05:33:32.760",
      "text": "من کتای من که عمل کرده اینا دکتور رو بند خود که بیده فروت کرده ماله بربان میرفتم دکتور کتای من"
    },
    {
      "id": 53,
      "start": 20012.76,
      "end": 20014.76,
      "formatted_start": "05:33:32.760",
      "formatted_end": "05:33:34.760",
      "text": "ایانی فردی؟ ایانی فردی؟"
    },
    {
      "id": 54,
      "start": 20014.76,
      "end": 20016.76,
      "formatted_start": "05:33:34.760",
      "formatted_end": "05:33:36.760",
      "text": "آفرین، خیلی دکتور رو ببینم خیلی خوبم"
    },
    {
      "id": 55,
      "start": 20016.76,
      "end": 20018.76,
      "formatted_start": "05:33:36.760",
      "formatted_end": "05:33:38.760",
      "text": "خیلی خوبم، آره آره"
    },
    {
      "id": 56,
      "start": 20018.76,
      "end": 20022.76,
      "formatted_start": "05:33:38.760",
      "formatted_end": "05:33:42.760",
      "text": "من، با دکتور من خیلی لذیذیت دارم اینجا من یک کار که من مرخص بشم"
    },
    {
      "id": 57,
      "start": 20022.76,
      "end": 20025.76,
      "formatted_start": "05:33:42.760",
      "formatted_end": "05:33:45.760",
      "text": "بعد از خانم من رفته به دنشوی، منم مرخص کردم"
    },
    {
      "id": 58,
      "start": 20025.76,
      "end": 20028.76,
      "formatted_start": "05:33:45.760",
      "formatted_end": "05:33:48.760",
      "text": "آوردن خونه دیگه آدم برد شد، فردا بردن دوباره"
    },
    {
      "id": 59,
      "start": 20032.76,
      "end": 20034.76,
      "formatted_start": "05:33:52.760",
      "formatted_end": "05:33:54.760",
      "text": "این همونجا ایتیاشون"
    },
    {
      "id": 60,
      "start": 20034.76,
      "end": 20036.76,
      "formatted_start": "05:33:54.760",
      "formatted_end": "05:33:56.760",
      "text": "به خاطر کسی داره که پولی هشون داره"
    },
    {
      "id": 61,
      "start": 20036.76,
      "end": 20038.76,
      "formatted_start": "05:33:56.760",
      "formatted_end": "05:33:58.760",
      "text": "میگم های اینشون خیلی زود"
    },
    {
      "id": 62,
      "start": 20038.76,
      "end": 20040.76,
      "formatted_start": "05:33:58.760",
      "formatted_end": "05:34:00.760",
      "text": "آفرونتی باشون"
    },
    {
      "id": 63,
      "start": 20040.76,
      "end": 20042.76,
      "formatted_start": "05:34:00.760",
      "formatted_end": "05:34:02.760",
      "text": "خاطر داری خوب واضح که داری بزنید"
    },
    {
      "id": 64,
      "start": 20042.76,
      "end": 20044.76,
      "formatted_start": "05:34:02.760",
      "formatted_end": "05:34:04.760",
      "text": "باشون"
    },
    {
      "id": 65,
      "start": 20044.76,
      "end": 20046.76,
      "formatted_start": "05:34:04.760",
      "formatted_end": "05:34:06.760",
      "text": "اگه بارد شون"
    },
    {
      "id": 66,
      "start": 20046.76,
      "end": 20048.76,
      "formatted_start": "05:34:06.760",
      "formatted_end": "05:34:08.760",
      "text": "باید برد شون"
    },
    {
      "id": 67,
      "start": 20048.76,
      "end": 20050.76,
      "formatted_start": "05:34:08.760",
      "formatted_end": "05:34:10.760",
      "text": "خب اون داری ها چه داری ها"
    },
    {
      "id": 68,
      "start": 20050.76,
      "end": 20052.76,
      "formatted_start": "05:34:10.760",
      "formatted_end": "05:34:12.760",
      "text": "بزنید بزنید بسیار"
    },
    {
      "id": 69,
      "start": 20052.76,
      "end": 20054.76,
      "formatted_start": "05:34:12.760",
      "formatted_end": "05:34:14.760",
      "text": "ناسترائید 5 برد بخونید"
    },
    {
      "id": 70,
      "start": 20054.76,
      "end": 20056.76,
      "formatted_start": "05:34:14.760",
      "formatted_end": "05:34:16.760",
      "text": "همیشه استفاده کنید"
    },
    {
      "id": 71,
      "start": 20056.76,
      "end": 20058.76,
      "formatted_start": "05:34:16.760",
      "formatted_end": "05:34:18.760",
      "text": "نه برد برد بخونید"
    },
    {
      "id": 72,
      "start": 20058.76,
      "end": 20060.76,
      "formatted_start": "05:34:18.760",
      "formatted_end": "05:34:20.760",
      "text": "کپسول تاوسونکسیل هم"
    },
    {
      "id": 73,
      "start": 20060.76,
      "end": 20066.76,
      "formatted_start": "05:34:20.760",
      "formatted_end": "05:34:26.760",
      "text": "اینجوری هم بود که آب بدن و کم کنن، آب بدن و کم کنن، آن هم خیلی خوبه"
    },
    {
      "id": 74,
      "start": 20066.76,
      "end": 20068.76,
      "formatted_start": "05:34:26.760",
      "formatted_end": "05:34:28.760",
      "text": "جنسینگ بود؟ آره"
    },
    {
      "id": 75,
      "start": 20068.76,
      "end": 20071.76,
      "formatted_start": "05:34:28.760",
      "formatted_end": "05:34:31.760",
      "text": "جنسینگ نه، اون توی زر شده بودیه"
    },
    {
      "id": 76,
      "start": 20071.76,
      "end": 20075.76,
      "formatted_start": "05:34:31.760",
      "formatted_end": "05:34:35.760",
      "text": "یا باشه نسخهتون رو نگاه کنن"
    },
    {
      "id": 77,
      "start": 20075.76,
      "end": 20078.76,
      "formatted_start": "05:34:35.760",
      "formatted_end": "05:34:38.760",
      "text": "توی چنده نه، ما داره رنگ شده بودیم"
    },
    {
      "id": 78,
      "start": 20078.76,
      "end": 20081.76,
      "formatted_start": "05:34:38.760",
      "formatted_end": "05:34:41.760",
      "text": "تا به خاکستری بانن، توی ششه"
    },
    {
      "id": 79,
      "start": 20081.76,
      "end": 20082.76,
      "formatted_start": "05:34:41.760",
      "formatted_end": "05:34:42.760",
      "text": "کفصور بود؟"
    },
    {
      "id": 80,
      "start": 20082.76,
      "end": 20083.76,
      "formatted_start": "05:34:42.760",
      "formatted_end": "05:34:43.760",
      "text": "کفصور بود، بله"
    },
    {
      "id": 81,
      "start": 20083.76,
      "end": 20086.76,
      "formatted_start": "05:34:43.760",
      "formatted_end": "05:34:46.760",
      "text": "خب آن بر جنسینگ باشه، آن رو ترکیبه"
    },
    {
      "id": 82,
      "start": 20086.76,
      "end": 20100.0,
      "formatted_start": "05:34:46.760",
      "formatted_end": "05:35:00.000",
      "text": "اینجا باید برگردید که اینجا باید برگردید که اینجا باید برگردید که اینجا باید برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید که اینجا برگردید ک"
    }
  ],
  "status": "completed"
}