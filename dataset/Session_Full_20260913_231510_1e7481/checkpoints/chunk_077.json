  "stt_segments": [
    {
      "id": 0,
      "start": 23100.0,
      "end": 23104.0,
      "formatted_start": "06:25:00.000",
      "formatted_end": "06:25:04.000",
      "text": "برنامه که یک گفته بنام تمام شده ویچ ویچ."
    },
    {
      "id": 1,
      "start": 23104.0,
      "end": 23108.0,
      "formatted_start": "06:25:04.000",
      "formatted_end": "06:25:08.000",
      "text": "داروها تونو سه ماه می نویسن خواه؟"
    },
    {
      "id": 2,
      "start": 23108.0,
      "end": 23110.0,
      "formatted_start": "06:25:08.000",
      "formatted_end": "06:25:10.000",
      "text": "خدا خیلی بردیم."
    },
    {
      "id": 3,
      "start": 23110.0,
      "end": 23116.0,
      "formatted_start": "06:25:10.000",
      "formatted_end": "06:25:16.000",
      "text": "شکمتون آهنگ صرف نکنه، ما یه شب درمیون بخوریم."
    },
    {
      "id": 4,
      "start": 23116.0,
      "end": 23121.0,
      "formatted_start": "06:25:16.000",
      "formatted_end": "06:25:21.000",
      "text": "دارو تونو زیاد نوشتم، انشاله مرتب بخوری، سه ماه دیگه آزمایش بود."
    },
    {
      "id": 5,
      "start": 23121.0,
      "end": 23122.0,
      "formatted_start": "06:25:21.000",
      "formatted_end": "06:25:22.000",
      "text": "خدا خیلی بردیم، یا سی دهرم."
    },
    {
      "id": 6,
      "start": 23122.0,
      "end": 23124.0,
      "formatted_start": "06:25:22.000",
      "formatted_end": "06:25:24.000",
      "text": "سلامت بشه."
    },
    {
      "id": 7,
      "start": 23124.0,
      "end": 23125.0,
      "formatted_start": "06:25:24.000",
      "formatted_end": "06:25:25.000",
      "text": "بله های خدا خدا."
    },
    {
      "id": 8,
      "start": 23125.0,
      "end": 23130.0,
      "formatted_start": "06:25:25.000",
      "formatted_end": "06:25:30.000",
      "text": "این که افتیم شما نمک هم تو غذا نزدان بوده دیگه یه ذره پشار بالاست داریم"
    },
    {
      "id": 9,
      "start": 23130.0,
      "end": 23133.0,
      "formatted_start": "06:25:30.000",
      "formatted_end": "06:25:33.000",
      "text": "چاردهه، باید بیاید دوازدوانی میدونم"
    },
    {
      "id": 10,
      "start": 23133.0,
      "end": 23135.0,
      "formatted_start": "06:25:33.000",
      "formatted_end": "06:25:35.000",
      "text": "بعد هندا جوی بگیرم از اینجا دیگه بدم"
    },
    {
      "id": 11,
      "start": 23135.0,
      "end": 23136.0,
      "formatted_start": "06:25:35.000",
      "formatted_end": "06:25:36.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 23136.0,
      "end": 23137.0,
      "formatted_start": "06:25:36.000",
      "formatted_end": "06:25:37.000",
      "text": "از اینجا بیشتر پیش شما"
    },
    {
      "id": 13,
      "start": 23137.0,
      "end": 23138.0,
      "formatted_start": "06:25:37.000",
      "formatted_end": "06:25:38.000",
      "text": "مشخصه"
    },
    {
      "id": 14,
      "start": 23138.0,
      "end": 23140.0,
      "formatted_start": "06:25:38.000",
      "formatted_end": "06:25:40.000",
      "text": "خداحافظ داریم خیلی ممنون"
    },
    {
      "id": 15,
      "start": 23140.0,
      "end": 23141.0,
      "formatted_start": "06:25:40.000",
      "formatted_end": "06:25:41.000",
      "text": "سلامه"
    },
    {
      "id": 16,
      "start": 23141.0,
      "end": 23142.0,
      "formatted_start": "06:25:41.000",
      "formatted_end": "06:25:42.000",
      "text": "دستو درد نکنه"
    },
    {
      "id": 17,
      "start": 23142.0,
      "end": 23143.0,
      "formatted_start": "06:25:42.000",
      "formatted_end": "06:25:43.000",
      "text": "ببین"
    },
    {
      "id": 18,
      "start": 23143.0,
      "end": 23144.0,
      "formatted_start": "06:25:43.000",
      "formatted_end": "06:25:44.000",
      "text": "آنجا چون؟"
    },
    {
      "id": 19,
      "start": 23144.0,
      "end": 23145.0,
      "formatted_start": "06:25:44.000",
      "formatted_end": "06:25:45.000",
      "text": "چون؟"
    },
    {
      "id": 20,
      "start": 23145.0,
      "end": 23146.0,
      "formatted_start": "06:25:45.000",
      "formatted_end": "06:25:46.000",
      "text": "میگن جفری"
    },
    {
      "id": 21,
      "start": 23146.0,
      "end": 23147.0,
      "formatted_start": "06:25:46.000",
      "formatted_end": "06:25:47.000",
      "text": "آره میبینیم"
    },
    {
      "id": 22,
      "start": 23147.0,
      "end": 23151.56,
      "formatted_start": "06:25:47.000",
      "formatted_end": "06:25:51.560",
      "text": "این شده رئیس اطلاعات مخدر فازداباد خوب"
    },
    {
      "id": 23,
      "start": 23151.56,
      "end": 23152.56,
      "formatted_start": "06:25:51.560",
      "formatted_end": "06:25:52.560",
      "text": "کن جفری"
    },
    {
      "id": 24,
      "start": 23152.56,
      "end": 23153.56,
      "formatted_start": "06:25:52.560",
      "formatted_end": "06:25:53.560",
      "text": "فازداباد گربا، جفری"
    },
    {
      "id": 25,
      "start": 23153.56,
      "end": 23154.56,
      "formatted_start": "06:25:53.560",
      "formatted_end": "06:25:54.560",
      "text": "زبرای که"
    },
    {
      "id": 26,
      "start": 23154.56,
      "end": 23156.36,
      "formatted_start": "06:25:54.560",
      "formatted_end": "06:25:56.360",
      "text": "آره تو اماکنی دیده فتا"
    },
    {
      "id": 27,
      "start": 23156.36,
      "end": 23157.36,
      "formatted_start": "06:25:56.360",
      "formatted_end": "06:25:57.360",
      "text": "بعد بگیه که"
    },
    {
      "id": 28,
      "start": 23157.36,
      "end": 23159.36,
      "formatted_start": "06:25:57.360",
      "formatted_end": "06:25:59.360",
      "text": "نکه علامتی نیست"
    },
    {
      "id": 29,
      "start": 23159.36,
      "end": 23160.36,
      "formatted_start": "06:25:59.360",
      "formatted_end": "06:26:00.360",
      "text": "میگه من دیابت دارم"
    },
    {
      "id": 30,
      "start": 23160.36,
      "end": 23162.36,
      "formatted_start": "06:26:00.360",
      "formatted_end": "06:26:02.360",
      "text": "میگه میگه اون همه زهر"
    },
    {
      "id": 31,
      "start": 23162.36,
      "end": 23164.36,
      "formatted_start": "06:26:02.360",
      "formatted_end": "06:26:04.360",
      "text": "میگه یه گودن باید پوتین ببین"
    },
    {
      "id": 32,
      "start": 23164.36,
      "end": 23166.96,
      "formatted_start": "06:26:04.360",
      "formatted_end": "06:26:06.960",
      "text": "میگه بیان خامدادو به این نامه نمیده که من پوتین هستم"
    },
    {
      "id": 33,
      "start": 23166.96,
      "end": 23168.96,
      "formatted_start": "06:26:06.960",
      "formatted_end": "06:26:08.960",
      "text": "میگه الان دو روز پوتین بیشت"
    },
    {
      "id": 34,
      "start": 23168.96,
      "end": 23170.96,
      "formatted_start": "06:26:08.960",
      "formatted_end": "06:26:10.960",
      "text": "که تراب پاهم یه تیکه میگه مثل خون شده"
    },
    {
      "id": 35,
      "start": 23170.96,
      "end": 23173.96,
      "formatted_start": "06:26:10.960",
      "formatted_end": "06:26:13.960",
      "text": "یعنی اون تا که اومد برامون خطناشون میکشیده"
    },
    {
      "id": 36,
      "start": 23173.96,
      "end": 23175.96,
      "formatted_start": "06:26:13.960",
      "formatted_end": "06:26:15.960",
      "text": "اونوش که دروهاشو بزنید که"
    },
    {
      "id": 37,
      "start": 23175.96,
      "end": 23179.96,
      "formatted_start": "06:26:15.960",
      "formatted_end": "06:26:19.960",
      "text": "آره اونو که خطناشون میکشیده واسه ماشینه تونو جریمه کنن فادم کنن"
    },
    {
      "id": 38,
      "start": 23179.96,
      "end": 23182.96,
      "formatted_start": "06:26:19.960",
      "formatted_end": "06:26:22.960",
      "text": "یعنی حرف اضافه زیاد میده"
    },
    {
      "id": 39,
      "start": 23182.96,
      "end": 23184.96,
      "formatted_start": "06:26:22.960",
      "formatted_end": "06:26:24.960",
      "text": "اون شوید رئیس مواد مخدره؟"
    },
    {
      "id": 40,
      "start": 23184.96,
      "end": 23186.96,
      "formatted_start": "06:26:24.960",
      "formatted_end": "06:26:26.960",
      "text": "رئیس مواد مخدره فازلاباد"
    },
    {
      "id": 41,
      "start": 23186.96,
      "end": 23188.96,
      "formatted_start": "06:26:26.960",
      "formatted_end": "06:26:28.960",
      "text": "هرچی دوست میبنه هم حالا رفتن"
    },
    {
      "id": 42,
      "start": 23188.96,
      "end": 23191.96,
      "formatted_start": "06:26:28.960",
      "formatted_end": "06:26:31.960",
      "text": "آه؟ میگه اصلا من مقابشم نبکنم"
    },
    {
      "id": 43,
      "start": 23191.96,
      "end": 23195.96,
      "formatted_start": "06:26:31.960",
      "formatted_end": "06:26:35.960",
      "text": "برای مویل ها من گفتم از دم‌هایی بودم پوتین نپوشم"
    },
    {
      "id": 44,
      "start": 23195.96,
      "end": 23198.96,
      "formatted_start": "06:26:35.960",
      "formatted_end": "06:26:38.960",
      "text": "بگو می‌گو می‌گو بیاییم خامدون رو ببینم"
    },
    {
      "id": 45,
      "start": 23198.96,
      "end": 23199.96,
      "formatted_start": "06:26:38.960",
      "formatted_end": "06:26:39.960",
      "text": "نه خدا داره"
    },
    {
      "id": 46,
      "start": 23199.96,
      "end": 23202.96,
      "formatted_start": "06:26:39.960",
      "formatted_end": "06:26:42.960",
      "text": "آره بدون دیدن که نمی‌شه که باید ببینم"
    },
    {
      "id": 47,
      "start": 23202.96,
      "end": 23204.96,
      "formatted_start": "06:26:42.960",
      "formatted_end": "06:26:44.960",
      "text": "ببینیم اکس بگیریم ببینیم اکس بگیریم"
    },
    {
      "id": 48,
      "start": 23204.96,
      "end": 23207.96,
      "formatted_start": "06:26:44.960",
      "formatted_end": "06:26:47.960",
      "text": "کومیسیون می‌رفه کردی آموریان همجایی طریق می‌کنه"
    },
    {
      "id": 49,
      "start": 23207.96,
      "end": 23212.96,
      "formatted_start": "06:26:47.960",
      "formatted_end": "06:26:52.960",
      "text": "ببینیم کومیسیون اکس بگیریم اگه استقلون‌هایی صاف شده باشه از منفوتین باشه"
    },
    {
      "id": 50,
      "start": 23212.96,
      "end": 23219.96,
      "formatted_start": "06:26:52.960",
      "formatted_end": "06:26:59.960",
      "text": "خوب، چربی هموز یکم بالا است. آنزیمات اومده پایین برای یک ذره بالا است."
    },
    {
      "id": 51,
      "start": 23219.96,
      "end": 23220.96,
      "formatted_start": "06:26:59.960",
      "formatted_end": "06:27:00.960",
      "text": "یک ذره بالا است."
    },
    {
      "id": 52,
      "start": 23220.96,
      "end": 23221.96,
      "formatted_start": "06:27:00.960",
      "formatted_end": "06:27:01.960",
      "text": "آره، خیلی کم بالا است."
    },
    {
      "id": 53,
      "start": 23221.96,
      "end": 23222.96,
      "formatted_start": "06:27:01.960",
      "formatted_end": "06:27:02.960",
      "text": "که در درمان صحیحت خانم درست داریم."
    },
    {
      "id": 54,
      "start": 23222.96,
      "end": 23223.96,
      "formatted_start": "06:27:02.960",
      "formatted_end": "06:27:03.960",
      "text": "آره دیگه؟"
    },
    {
      "id": 55,
      "start": 23223.96,
      "end": 23228.96,
      "formatted_start": "06:27:03.960",
      "formatted_end": "06:27:08.960",
      "text": "هم درست می کنه، هم یه احساس سوزشی مثل زخم و اینکی چون این."
    },
    {
      "id": 56,
      "start": 23228.96,
      "end": 23230.96,
      "formatted_start": "06:27:08.960",
      "formatted_end": "06:27:10.960",
      "text": "یه سوزش همیگیری هست."
    },
    {
      "id": 57,
      "start": 23230.96,
      "end": 23232.96,
      "formatted_start": "06:27:10.960",
      "formatted_end": "06:27:12.960",
      "text": "سونات که این انجام داده؟"
    },
    {
      "id": 58,
      "start": 23232.96,
      "end": 23234.96,
      "formatted_start": "06:27:12.960",
      "formatted_end": "06:27:14.960",
      "text": "تو خانم یه هفته پیش اینا بود."
    },
    {
      "id": 59,
      "start": 23234.96,
      "end": 23236.96,
      "formatted_start": "06:27:14.960",
      "formatted_end": "06:27:16.960",
      "text": "که همه در چند بود در اینجا؟"
    },
    {
      "id": 60,
      "start": 23236.96,
      "end": 23238.96,
      "formatted_start": "06:27:16.960",
      "formatted_end": "06:27:18.960",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 61,
      "start": 23238.96,
      "end": 23240.96,
      "formatted_start": "06:27:18.960",
      "formatted_end": "06:27:20.960",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 62,
      "start": 23240.96,
      "end": 23242.96,
      "formatted_start": "06:27:20.960",
      "formatted_end": "06:27:22.960",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 63,
      "start": 23242.96,
      "end": 23244.96,
      "formatted_start": "06:27:22.960",
      "formatted_end": "06:27:24.960",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 64,
      "start": 23244.96,
      "end": 23249.96,
      "formatted_start": "06:27:24.960",
      "formatted_end": "06:27:29.960",
      "text": "چربیت هم باز رایت کنید. این کاری زود کردنی چرب و چیزی نخواهید."
    },
    {
      "id": 65,
      "start": 23249.96,
      "end": 23258.96,
      "formatted_start": "06:27:29.960",
      "formatted_end": "06:27:38.960",
      "text": "مثل غذای چرب، برگرده دلسه، نوشابه، همومن برای بالا، مکارانه، اینها را بر رایت کنید."
    },
    {
      "id": 66,
      "start": 23266.96,
      "end": 23273.96,
      "formatted_start": "06:27:46.960",
      "formatted_end": "06:27:53.960",
      "text": "من یک حالت گیچی هم دارم. اصلا عدم تمرکز. اصلا خیلی خیلی ضعیب شده."
    },
    {
      "id": 67,
      "start": 23273.96,
      "end": 23275.96,
      "formatted_start": "06:27:53.960",
      "formatted_end": "06:27:55.960",
      "text": "چند وقتم؟"
    },
    {
      "id": 68,
      "start": 23275.96,
      "end": 23277.96,
      "formatted_start": "06:27:55.960",
      "formatted_end": "06:27:57.960",
      "text": "الان بدودن دو ماهی میشه"
    },
    {
      "id": 69,
      "start": 23277.96,
      "end": 23279.96,
      "formatted_start": "06:27:57.960",
      "formatted_end": "06:27:59.960",
      "text": "ده دقیقه زیاد نداشتی؟"
    },
    {
      "id": 70,
      "start": 23279.96,
      "end": 23281.96,
      "formatted_start": "06:27:59.960",
      "formatted_end": "06:28:01.960",
      "text": "نه اصلا"
    },
    {
      "id": 71,
      "start": 23281.96,
      "end": 23285.96,
      "formatted_start": "06:28:01.960",
      "formatted_end": "06:28:05.960",
      "text": "چیزهایی که میگم یادت بمونه"
    },
    {
      "id": 72,
      "start": 23285.96,
      "end": 23287.96,
      "formatted_start": "06:28:05.960",
      "formatted_end": "06:28:07.960",
      "text": "نیست؟"
    },
    {
      "id": 73,
      "start": 23287.96,
      "end": 23291.96,
      "formatted_start": "06:28:07.960",
      "formatted_end": "06:28:11.960",
      "text": "اینو فرض کن کتاب و ساعت"
    },
    {
      "id": 74,
      "start": 23291.96,
      "end": 23293.96,
      "formatted_start": "06:28:11.960",
      "formatted_end": "06:28:13.960",
      "text": "یادت باشه"
    },
    {
      "id": 75,
      "start": 23299.96,
      "end": 23301.96,
      "formatted_start": "06:28:19.960",
      "formatted_end": "06:28:21.960",
      "text": "تیروی دیده او که نداشتی هیچ وقت؟"
    },
    {
      "id": 76,
      "start": 23301.96,
      "end": 23303.96,
      "formatted_start": "06:28:21.960",
      "formatted_end": "06:28:23.960",
      "text": "نه قبل اما داشتم"
    },
    {
      "id": 77,
      "start": 23303.96,
      "end": 23304.96,
      "formatted_start": "06:28:23.960",
      "formatted_end": "06:28:24.960",
      "text": "چه کرده؟"
    },
    {
      "id": 78,
      "start": 23304.96,
      "end": 23305.96,
      "formatted_start": "06:28:24.960",
      "formatted_end": "06:28:25.960",
      "text": "نه بگیر بگیر"
    },
    {
      "id": 79,
      "start": 23305.96,
      "end": 23308.96,
      "formatted_start": "06:28:25.960",
      "formatted_end": "06:28:28.960",
      "text": "اون یه سال و یه سال و نمی پیش گفت"
    },
    {
      "id": 80,
      "start": 23308.96,
      "end": 23311.96,
      "formatted_start": "06:28:28.960",
      "formatted_end": "06:28:31.960",
      "text": "بعد یه سی چه روزی که برس بردم مرکوب شده"
    },
    {
      "id": 81,
      "start": 23313.96,
      "end": 23316.96,
      "formatted_start": "06:28:33.960",
      "formatted_end": "06:28:36.960",
      "text": "کاش اونم چون میگه عدم تمرکل سازی چیه کن کرده"
    },
    {
      "id": 82,
      "start": 23318.96,
      "end": 23320.96,
      "formatted_start": "06:28:38.960",
      "formatted_end": "06:28:40.960",
      "text": "اونت کجاست؟"
    },
    {
      "id": 83,
      "start": 23320.96,
      "end": 23322.96,
      "formatted_start": "06:28:40.960",
      "formatted_end": "06:28:42.960",
      "text": "من آزاد چند هستم"
    },
    {
      "id": 84,
      "start": 23323.96,
      "end": 23326.96,
      "formatted_start": "06:28:43.960",
      "formatted_end": "06:28:46.960",
      "text": "من یه الان دنبال آزد از شابوت داشتم"
    },
    {
      "id": 85,
      "start": 23329.96,
      "end": 23331.96,
      "formatted_start": "06:28:49.960",
      "formatted_end": "06:28:51.960",
      "text": "بعد انسونه میبری؟"
    },
    {
      "id": 86,
      "start": 23331.96,
      "end": 23333.96,
      "formatted_start": "06:28:51.960",
      "formatted_end": "06:28:53.960",
      "text": "نصف نمی کنم"
    },
    {
      "id": 87,
      "start": 23333.96,
      "end": 23334.96,
      "formatted_start": "06:28:53.960",
      "formatted_end": "06:28:54.960",
      "text": "چه صفت هست؟"
    },
    {
      "id": 88,
      "start": 23334.96,
      "end": 23335.96,
      "formatted_start": "06:28:54.960",
      "formatted_end": "06:28:55.960",
      "text": "نکرونی"
    },
    {
      "id": 89,
      "start": 23335.96,
      "end": 23336.96,
      "formatted_start": "06:28:55.960",
      "formatted_end": "06:28:56.960",
      "text": "نه"
    },
    {
      "id": 90,
      "start": 23336.96,
      "end": 23337.96,
      "formatted_start": "06:28:56.960",
      "formatted_end": "06:28:57.960",
      "text": "بندت خوبه؟"
    },
    {
      "id": 91,
      "start": 23337.96,
      "end": 23338.96,
      "formatted_start": "06:28:57.960",
      "formatted_end": "06:28:58.960",
      "text": "نه"
    },
    {
      "id": 92,
      "start": 23348.96,
      "end": 23349.96,
      "formatted_start": "06:29:08.960",
      "formatted_end": "06:29:09.960",
      "text": "زنگان داشتی؟"
    },
    {
      "id": 93,
      "start": 23349.96,
      "end": 23350.96,
      "formatted_start": "06:29:09.960",
      "formatted_end": "06:29:10.960",
      "text": "نه خیلی"
    },
    {
      "id": 94,
      "start": 23350.96,
      "end": 23351.96,
      "formatted_start": "06:29:10.960",
      "formatted_end": "06:29:11.960",
      "text": "مجرد کنی؟"
    },
    {
      "id": 95,
      "start": 23351.96,
      "end": 23353.96,
      "formatted_start": "06:29:11.960",
      "formatted_end": "06:29:13.960",
      "text": "نه مجرد کنیستم"
    },
    {
      "id": 96,
      "start": 23353.96,
      "end": 23354.96,
      "formatted_start": "06:29:13.960",
      "formatted_end": "06:29:14.960",
      "text": "بچه داری؟"
    },
    {
      "id": 97,
      "start": 23354.96,
      "end": 23355.96,
      "formatted_start": "06:29:14.960",
      "formatted_end": "06:29:15.960",
      "text": "آره"
    },
    {
      "id": 98,
      "start": 23355.96,
      "end": 23357.96,
      "formatted_start": "06:29:15.960",
      "formatted_end": "06:29:17.960",
      "text": "بیسر بزرگم 23 ساله شدم"
    },
    {
      "id": 99,
      "start": 23357.96,
      "end": 23359.96,
      "formatted_start": "06:29:17.960",
      "formatted_end": "06:29:19.960",
      "text": "دومیم که 18 ساله شد"
    },
    {
      "id": 100,
      "start": 23359.96,
      "end": 23361.96,
      "formatted_start": "06:29:19.960",
      "formatted_end": "06:29:21.960",
      "text": "چی کم پیرش موزده است"
    },
    {
      "id": 101,
      "start": 23361.96,
      "end": 23365.96,
      "formatted_start": "06:29:21.960",
      "formatted_end": "06:29:25.960",
      "text": "یک هم خونه شردگی داشته در پرونده"
    },
    {
      "id": 102,
      "start": 23365.96,
      "end": 23367.96,
      "formatted_start": "06:29:25.960",
      "formatted_end": "06:29:27.960",
      "text": "یک هم هم هست از غنو سوکین"
    },
    {
      "id": 103,
      "start": 23367.96,
      "end": 23373.96,
      "formatted_start": "06:29:27.960",
      "formatted_end": "06:29:33.960",
      "text": "و هر کم بود به دواز در این آها داشته ممکنه سبی فرموشید به خاطر این آها بشه"
    },
    {
      "id": 104,
      "start": 23373.96,
      "end": 23379.96,
      "formatted_start": "06:29:33.960",
      "formatted_end": "06:29:39.960",
      "text": "خوشتو که دفترش رو داری خب کامل می رفت و تمنی اجتماعی آزماش درست داده"
    },
    {
      "id": 105,
      "start": 23379.96,
      "end": 23382.96,
      "formatted_start": "06:29:39.960",
      "formatted_end": "06:29:42.960",
      "text": "الان نیاز دارم رو انجام برم"
    },
    {
      "id": 106,
      "start": 23382.96,
      "end": 23386.96,
      "formatted_start": "06:29:42.960",
      "formatted_end": "06:29:46.960",
      "text": "این نویست هم برای تو آزماش کامل درست داره و تمنی انجام بده خب"
    },
    {
      "id": 107,
      "start": 23386.96,
      "end": 23391.36,
      "formatted_start": "06:29:46.960",
      "formatted_end": "06:29:51.360",
      "text": "از اینجا باید از باید از باید باید تطور جانو سازمه باید"
    },
    {
      "id": 108,
      "start": 23391.36,
      "end": 23393.72,
      "formatted_start": "06:29:51.360",
      "formatted_end": "06:29:53.720",
      "text": "راست باش بگیرم سامون تمنیشتو برم"
