  "stt_segments": [
    {
      "id": 0,
      "start": 23700.0,
      "end": 23730.0,
      "formatted_start": "06:35:00.000",
      "formatted_end": "06:35:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 23730.0,
      "end": 23732.0,
      "formatted_start": "06:35:30.000",
      "formatted_end": "06:35:32.000",
      "text": "خیلی خوب"
    },
    {
      "id": 2,
      "start": 23760.0,
      "end": 23762.0,
      "formatted_start": "06:36:00.000",
      "formatted_end": "06:36:02.000",
      "text": "چرا از وایتیس؟"
    },
    {
      "id": 3,
      "start": 23762.0,
      "end": 23764.0,
      "formatted_start": "06:36:02.000",
      "formatted_end": "06:36:04.000",
      "text": "از این ترامب میترسن از خوالم نفرم"
    },
    {
      "id": 4,
      "start": 23764.0,
      "end": 23766.0,
      "formatted_start": "06:36:04.000",
      "formatted_end": "06:36:06.000",
      "text": "ولی چرا از وایتیس؟"
    },
    {
      "id": 5,
      "start": 23766.0,
      "end": 23768.0,
      "formatted_start": "06:36:06.000",
      "formatted_end": "06:36:08.000",
      "text": "یا که راست توالت رو باید بشورم؟"
    },
    {
      "id": 6,
      "start": 23768.0,
      "end": 23770.0,
      "formatted_start": "06:36:08.000",
      "formatted_end": "06:36:10.000",
      "text": "چرا؟"
    },
    {
      "id": 7,
      "start": 23772.0,
      "end": 23774.0,
      "formatted_start": "06:36:12.000",
      "formatted_end": "06:36:14.000",
      "text": "کلان الان"
    },
    {
      "id": 8,
      "start": 23774.0,
      "end": 23776.0,
      "formatted_start": "06:36:14.000",
      "formatted_end": "06:36:16.000",
      "text": "میدونم فشارم بلاه"
    },
    {
      "id": 9,
      "start": 23776.0,
      "end": 23778.0,
      "formatted_start": "06:36:16.000",
      "formatted_end": "06:36:18.000",
      "text": "چون سرم اصلا سنگینه"
    },
    {
      "id": 10,
      "start": 23778.0,
      "end": 23780.0,
      "formatted_start": "06:36:18.000",
      "formatted_end": "06:36:20.000",
      "text": "الان که فشارت خوبه"
    },
    {
      "id": 11,
      "start": 23780.0,
      "end": 23782.0,
      "formatted_start": "06:36:20.000",
      "formatted_end": "06:36:22.000",
      "text": "میدونی فشارم همشه رو نو یا دهه"
    },
    {
      "id": 12,
      "start": 23782.0,
      "end": 23784.0,
      "formatted_start": "06:36:22.000",
      "formatted_end": "06:36:24.000",
      "text": "بعد الان مثلا دوازا سیزده"
    },
    {
      "id": 13,
      "start": 23784.0,
      "end": 23786.0,
      "formatted_start": "06:36:24.000",
      "formatted_end": "06:36:26.000",
      "text": "میشه کلان اینجور"
    },
    {
      "id": 14,
      "start": 23786.0,
      "end": 23788.0,
      "formatted_start": "06:36:26.000",
      "formatted_end": "06:36:28.000",
      "text": "الان یه مترال برای شروع کردم خب"
    },
    {
      "id": 15,
      "start": 23788.0,
      "end": 23791.46,
      "formatted_start": "06:36:28.000",
      "formatted_end": "06:36:31.460",
      "text": "با یه دونه والزارتان هشتا، نمیدونم از این"
    },
    {
      "id": 16,
      "start": 23791.46,
      "end": 23794.8,
      "formatted_start": "06:36:31.460",
      "formatted_end": "06:36:34.800",
      "text": "این به عنوان تنظیم پند فشار و حمایت هست"
    },
    {
      "id": 17,
      "start": 23794.8,
      "end": 23797.4,
      "formatted_start": "06:36:34.800",
      "formatted_end": "06:36:37.400",
      "text": "نمیذاره دیگر شاید فالا بره"
    },
    {
      "id": 18,
      "start": 23797.4,
      "end": 23800.4,
      "formatted_start": "06:36:37.400",
      "formatted_end": "06:36:40.400",
      "text": "تا جاوه آزمایش شد بیاد تر ببین"
    },
    {
      "id": 19,
      "start": 23800.4,
      "end": 23805.2,
      "formatted_start": "06:36:40.400",
      "formatted_end": "06:36:45.200",
      "text": "مترار یه نصف میخوری، اگر دیدی تپش قبل پیدا کرده بیا"
    },
    {
      "id": 20,
      "start": 23805.2,
      "end": 23808.7,
      "formatted_start": "06:36:45.200",
      "formatted_end": "06:36:48.700",
      "text": "یه نصف صبح یه نصف شب میخوری، من تا درشان نصف میخوری"
    },
    {
      "id": 21,
      "start": 23808.7,
      "end": 23812.0,
      "formatted_start": "06:36:48.700",
      "formatted_end": "06:36:52.000",
      "text": "یه والزارتان هم، این هم فشار، اومد تأثیر و فشار نداره"
    },
    {
      "id": 22,
      "start": 23812.0,
      "end": 23815.0,
      "formatted_start": "06:36:52.000",
      "formatted_end": "06:36:55.000",
      "text": "اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 23,
      "start": 23815.0,
      "end": 23818.0,
      "formatted_start": "06:36:55.000",
      "formatted_end": "06:36:58.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 24,
      "start": 23818.0,
      "end": 23821.0,
      "formatted_start": "06:36:58.000",
      "formatted_end": "06:37:01.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 25,
      "start": 23821.0,
      "end": 23824.0,
      "formatted_start": "06:37:01.000",
      "formatted_end": "06:37:04.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 26,
      "start": 23824.0,
      "end": 23827.0,
      "formatted_start": "06:37:04.000",
      "formatted_end": "06:37:07.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 27,
      "start": 23827.0,
      "end": 23830.0,
      "formatted_start": "06:37:07.000",
      "formatted_end": "06:37:10.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 28,
      "start": 23830.0,
      "end": 23833.0,
      "formatted_start": "06:37:10.000",
      "formatted_end": "06:37:13.000",
      "text": "و اینجا باید برداری کنید و برداری کنید"
    },
    {
      "id": 29,
      "start": 23833.0,
      "end": 23863.0,
      "formatted_start": "06:37:13.000",
      "formatted_end": "06:37:43.000",
      "text": "از آنها باید برداریم که از اینکه باید برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه"
    },
    {
      "id": 30,
      "start": 23863.0,
      "end": 23866.0,
      "formatted_start": "06:37:43.000",
      "formatted_end": "06:37:46.000",
      "text": "از اینکه پیگون سک گرد پرنده در روی تو خونه"
    },
    {
      "id": 31,
      "start": 23866.0,
      "end": 23869.0,
      "formatted_start": "06:37:46.000",
      "formatted_end": "06:37:49.000",
      "text": "یه دونه چی داری؟"
    },
    {
      "id": 32,
      "start": 23869.0,
      "end": 23871.0,
      "formatted_start": "06:37:49.000",
      "formatted_end": "06:37:51.000",
      "text": "مانگو؟"
    },
    {
      "id": 33,
      "start": 23871.0,
      "end": 23873.0,
      "formatted_start": "06:37:51.000",
      "formatted_end": "06:37:53.000",
      "text": "حرف زندگی"
    },
    {
      "id": 34,
      "start": 23873.0,
      "end": 23874.0,
      "formatted_start": "06:37:53.000",
      "formatted_end": "06:37:54.000",
      "text": "ریتو خراب کرده"
    },
    {
      "id": 35,
      "start": 23874.0,
      "end": 23878.0,
      "formatted_start": "06:37:54.000",
      "formatted_end": "06:37:58.000",
      "text": "کاملا میگم آخه یه آمل باید باشه یه دیگه این قصد رو داده"
    },
    {
      "id": 36,
      "start": 23878.0,
      "end": 23879.0,
      "formatted_start": "06:37:58.000",
      "formatted_end": "06:37:59.000",
      "text": "هیچ و خود چهار داره"
    },
    {
      "id": 37,
      "start": 23879.0,
      "end": 23880.0,
      "formatted_start": "06:37:59.000",
      "formatted_end": "06:38:00.000",
      "text": "نه خیلی خیلی خیلی"
    },
    {
      "id": 38,
      "start": 23880.0,
      "end": 23885.0,
      "formatted_start": "06:38:00.000",
      "formatted_end": "06:38:05.000",
      "text": "از این بری رو پری شب نمون بیمارستان که رفتم سیکی استرین یه خیلی فتن از ریاض بخونش"
    },
    {
      "id": 39,
      "start": 23885.0,
      "end": 23889.0,
      "formatted_start": "06:38:05.000",
      "formatted_end": "06:38:09.000",
      "text": "ببین زایعه که نداری شکر خدا ولی ریت پر حواست"
    },
    {
      "id": 40,
      "start": 23889.0,
      "end": 23892.32,
      "formatted_start": "06:38:09.000",
      "formatted_end": "06:38:12.320",
      "text": "اصلا پرنده تو اتاقت نباید باشه خب"
    },
    {
      "id": 41,
      "start": 23892.32,
      "end": 23894.92,
      "formatted_start": "06:38:12.320",
      "formatted_end": "06:38:14.920",
      "text": "هواش نباید نفس بگشی"
    },
    {
      "id": 42,
      "start": 23894.92,
      "end": 23898.4,
      "formatted_start": "06:38:14.920",
      "formatted_end": "06:38:18.400",
      "text": "همون خود رو برد"
    },
    {
      "id": 43,
      "start": 23898.4,
      "end": 23901.24,
      "formatted_start": "06:38:18.400",
      "formatted_end": "06:38:21.240",
      "text": "همه چی مددی رو برد"
    },
    {
      "id": 44,
      "start": 23901.24,
      "end": 23902.86,
      "formatted_start": "06:38:21.240",
      "formatted_end": "06:38:22.860",
      "text": "یه مفق داره دیگه"
    },
    {
      "id": 45,
      "start": 23902.86,
      "end": 23903.66,
      "formatted_start": "06:38:22.860",
      "formatted_end": "06:38:23.660",
      "text": "همچنان بشه"
    },
    {
      "id": 46,
      "start": 23903.66,
      "end": 23905.34,
      "formatted_start": "06:38:23.660",
      "formatted_end": "06:38:25.340",
      "text": "بسیار مدد نکنیم"
    },
    {
      "id": 47,
      "start": 23905.34,
      "end": 23908.02,
      "formatted_start": "06:38:25.340",
      "formatted_end": "06:38:28.020",
      "text": "خیلی ممنون مرسیم"
    },
    {
      "id": 48,
      "start": 23908.02,
      "end": 23912.14,
      "formatted_start": "06:38:28.020",
      "formatted_end": "06:38:32.140",
      "text": "سلام خوانیدید"
    },
    {
      "id": 49,
      "start": 23912.14,
      "end": 23912.24,
      "formatted_start": "06:38:32.140",
      "formatted_end": "06:38:32.240",
      "text": "خوانیدید"
    },
    {
      "id": 50,
      "start": 23912.24,
      "end": 23912.3,
      "formatted_start": "06:38:32.240",
      "formatted_end": "06:38:32.300",
      "text": "خوانیدید"
    },
    {
      "id": 51,
      "start": 23912.3,
      "end": 23912.34,
      "formatted_start": "06:38:32.300",
      "formatted_end": "06:38:32.340",
      "text": "خوانیدید"
    },
    {
      "id": 52,
      "start": 23912.34,
      "end": 23912.4,
      "formatted_start": "06:38:32.340",
      "formatted_end": "06:38:32.400",
      "text": "خوانیدید"
    },
    {
      "id": 53,
      "start": 23912.4,
      "end": 23912.42,
      "formatted_start": "06:38:32.400",
      "formatted_end": "06:38:32.420",
      "text": "خوانیدید"
    },
    {
      "id": 54,
      "start": 23912.42,
      "end": 23912.46,
      "formatted_start": "06:38:32.420",
      "formatted_end": "06:38:32.460",
      "text": "خوانیدید"
    },
    {
      "id": 55,
      "start": 23912.46,
      "end": 23912.48,
      "formatted_start": "06:38:32.460",
      "formatted_end": "06:38:32.480",
      "text": "خوانیدید"
    },
    {
      "id": 56,
      "start": 23912.48,
      "end": 23912.54,
      "formatted_start": "06:38:32.480",
      "formatted_end": "06:38:32.540",
      "text": "خوانیدید"
    },
    {
      "id": 57,
      "start": 23912.54,
      "end": 23912.58,
      "formatted_start": "06:38:32.540",
      "formatted_end": "06:38:32.580",
      "text": "خوانیدید"
    },
    {
      "id": 58,
      "start": 23912.58,
      "end": 23912.64,
      "formatted_start": "06:38:32.580",
      "formatted_end": "06:38:32.640",
      "text": "خوانیدید"
    },
    {
      "id": 59,
      "start": 23912.64,
      "end": 23914.64,
      "formatted_start": "06:38:32.640",
      "formatted_end": "06:38:34.640",
      "text": "خوشید"
    },
    {
      "id": 60,
      "start": 23914.64,
      "end": 23917.64,
      "formatted_start": "06:38:34.640",
      "formatted_end": "06:38:37.640",
      "text": "من این گرسی که میخواستم اینا رو که نوشتم برای شما تنها داشته"
    },
    {
      "id": 61,
      "start": 23917.64,
      "end": 23920.64,
      "formatted_start": "06:38:37.640",
      "formatted_end": "06:38:40.640",
      "text": "بعد اون کپسولی که بخواستین که خیدا نکردم"
    },
    {
      "id": 62,
      "start": 23920.64,
      "end": 23922.64,
      "formatted_start": "06:38:40.640",
      "formatted_end": "06:38:42.640",
      "text": "توی دست خیلی قبلتون بوده"
    },
    {
      "id": 63,
      "start": 23922.64,
      "end": 23924.64,
      "formatted_start": "06:38:42.640",
      "formatted_end": "06:38:44.640",
      "text": "بله بله"
    },
    {
      "id": 64,
      "start": 23924.64,
      "end": 23925.64,
      "formatted_start": "06:38:44.640",
      "formatted_end": "06:38:45.640",
      "text": "توی ماشینه برم بیارم که لازم؟"
    },
    {
      "id": 65,
      "start": 23925.64,
      "end": 23927.64,
      "formatted_start": "06:38:45.640",
      "formatted_end": "06:38:47.640",
      "text": "اگه دارین برم بیارم ببخشون"
    },
    {
      "id": 66,
      "start": 23927.64,
      "end": 23928.64,
      "formatted_start": "06:38:47.640",
      "formatted_end": "06:38:48.640",
      "text": "بله بله مزارم"
    },
    {
      "id": 67,
      "start": 23928.64,
      "end": 23930.64,
      "formatted_start": "06:38:48.640",
      "formatted_end": "06:38:50.640",
      "text": "این گرسی ریوارکن هم قبل لازم هایه؟"
    },
    {
      "id": 68,
      "start": 23930.64,
      "end": 23931.64,
      "formatted_start": "06:38:50.640",
      "formatted_end": "06:38:51.640",
      "text": "بعد لازم هایه"
    },
    {
      "id": 69,
      "start": 23931.64,
      "end": 23932.64,
      "formatted_start": "06:38:51.640",
      "formatted_end": "06:38:52.640",
      "text": "آه بعد ها"
    },
    {
      "id": 70,
      "start": 23932.64,
      "end": 23933.64,
      "formatted_start": "06:38:52.640",
      "formatted_end": "06:38:53.640",
      "text": "بس من بیارم"
    },
    {
      "id": 71,
      "start": 23933.64,
      "end": 23934.64,
      "formatted_start": "06:38:53.640",
      "formatted_end": "06:38:54.640",
      "text": "قبل لازم دیرگورد بعد لازم هایه"
    },
    {
      "id": 72,
      "start": 23964.64,
      "end": 23968.64,
      "formatted_start": "06:39:24.640",
      "formatted_end": "06:39:28.640",
      "text": "اوه به درخون نشون اگه درون چیزی نیاز ببین زنگرش بگیز"
    },
    {
      "id": 73,
      "start": 23968.64,
      "end": 23970.64,
      "formatted_start": "06:39:28.640",
      "formatted_end": "06:39:30.640",
      "text": "اوه ببین شدید دارم"
    },
    {
      "id": 74,
      "start": 23972.64,
      "end": 23973.64,
      "formatted_start": "06:39:32.640",
      "formatted_end": "06:39:33.640",
      "text": "کس؟"
    },
    {
      "id": 75,
      "start": 23973.64,
      "end": 23975.64,
      "formatted_start": "06:39:33.640",
      "formatted_end": "06:39:35.640",
      "text": "درنه سوسر چون یه برگزاسی؟"
    },
    {
      "id": 76,
      "start": 23976.64,
      "end": 23978.64,
      "formatted_start": "06:39:36.640",
      "formatted_end": "06:39:38.640",
      "text": "سوسر رو یه برگزاسی"
    },
    {
      "id": 77,
      "start": 23981.64,
      "end": 23984.64,
      "formatted_start": "06:39:41.640",
      "formatted_end": "06:39:44.640",
      "text": "از این دختر، اوه ببین دخترش که کم مشکل داره"
    },
    {
      "id": 78,
      "start": 23984.64,
      "end": 23986.64,
      "formatted_start": "06:39:44.640",
      "formatted_end": "06:39:46.640",
      "text": "ببین شدید درداره"
    },
    {
      "id": 79,
      "start": 23986.64,
      "end": 23989.64,
      "formatted_start": "06:39:46.640",
      "formatted_end": "06:39:49.640",
      "text": "خواب شبه این رو انا دخترش بشین و خانمش بشین"
    },
    {
      "id": 80,
      "start": 23989.64,
      "end": 23991.64,
      "formatted_start": "06:39:49.640",
      "formatted_end": "06:39:51.640",
      "text": "بله آره، رنشه"
    },
    {
      "id": 81,
      "start": 23991.64,
      "end": 23993.64,
      "formatted_start": "06:39:51.640",
      "formatted_end": "06:39:53.640",
      "text": "شکر میکنم"
    }
  ],
