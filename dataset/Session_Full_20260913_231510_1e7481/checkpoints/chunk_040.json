  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12029.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:29.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12029.0,
      "end": 12031.0,
      "formatted_start": "03:20:29.000",
      "formatted_end": "03:20:31.000",
      "text": "به پای زنگ نزدی؟"
    },
    {
      "id": 2,
      "start": 12031.0,
      "end": 12032.0,
      "formatted_start": "03:20:31.000",
      "formatted_end": "03:20:32.000",
      "text": "جان؟"
    },
    {
      "id": 3,
      "start": 12032.0,
      "end": 12034.0,
      "formatted_start": "03:20:32.000",
      "formatted_end": "03:20:34.000",
      "text": "اگر رسیدی یه زنگ به پای بزن"
    },
    {
      "id": 4,
      "start": 12034.0,
      "end": 12035.0,
      "formatted_start": "03:20:34.000",
      "formatted_end": "03:20:35.000",
      "text": "الان زنگ زنگ بچنجش"
    },
    {
      "id": 5,
      "start": 12035.0,
      "end": 12036.0,
      "formatted_start": "03:20:35.000",
      "formatted_end": "03:20:36.000",
      "text": "مرسی"
    },
    {
      "id": 6,
      "start": 12036.0,
      "end": 12038.0,
      "formatted_start": "03:20:36.000",
      "formatted_end": "03:20:38.000",
      "text": "جان خانم"
    },
    {
      "id": 7,
      "start": 12038.0,
      "end": 12042.0,
      "formatted_start": "03:20:38.000",
      "formatted_end": "03:20:42.000",
      "text": "اون درمی خونم میسوزه"
    },
    {
      "id": 8,
      "start": 12042.0,
      "end": 12044.0,
      "formatted_start": "03:20:42.000",
      "formatted_end": "03:20:44.000",
      "text": "امخونم هستی خیلی؟"
    },
    {
      "id": 9,
      "start": 12044.0,
      "end": 12045.0,
      "formatted_start": "03:20:44.000",
      "formatted_end": "03:20:45.000",
      "text": "نه"
    },
    {
      "id": 10,
      "start": 12045.0,
      "end": 12047.0,
      "formatted_start": "03:20:45.000",
      "formatted_end": "03:20:47.000",
      "text": "از خردن دو تا فرا دی این سو چهار تا سو روکی هم پرده"
    },
    {
      "id": 11,
      "start": 12047.0,
      "end": 12050.0,
      "formatted_start": "03:20:47.000",
      "formatted_end": "03:20:50.000",
      "text": "خود دارو از دیشه هم و خیلی مردم خواهده نیواز"
    },
    {
      "id": 12,
      "start": 12050.0,
      "end": 12054.0,
      "formatted_start": "03:20:50.000",
      "formatted_end": "03:20:54.000",
      "text": "اینجا برم داره که چی میشوده"
    },
    {
      "id": 13,
      "start": 12054.0,
      "end": 12058.0,
      "formatted_start": "03:20:54.000",
      "formatted_end": "03:20:58.000",
      "text": "الان رفتم تنبیه اجتماعی موسیقی هست دارم صابت خوش"
    },
    {
      "id": 14,
      "start": 12058.0,
      "end": 12062.0,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:02.000",
