  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14106.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:06.000",
      "text": "از اینجا، شب، یک ترش و آب هم که یه دفعه مزنه می آباده همون شب رو روانم می آید."
    },
    {
      "id": 1,
      "start": 14106.0,
      "end": 14111.0,
      "formatted_start": "03:55:06.000",
      "formatted_end": "03:55:11.000",
      "text": "ترش می کنه دیگه، برس مدت رو یکی صبح، یکی شب بخوری."
    },
    {
      "id": 2,
      "start": 14111.0,
      "end": 14113.0,
      "formatted_start": "03:55:11.000",
      "formatted_end": "03:55:13.000",
      "text": "صبح ناشتاش، آره."
    },
    {
      "id": 3,
      "start": 14113.0,
      "end": 14115.0,
      "formatted_start": "03:55:13.000",
      "formatted_end": "03:55:15.000",
      "text": "صبح ناشتاتو باید یکی صبح بخوری، یکی شب بخوری."
    },
    {
      "id": 4,
      "start": 14115.0,
      "end": 14117.0,
      "formatted_start": "03:55:15.000",
      "formatted_end": "03:55:17.000",
      "text": "شب یعنی بعد از غذا؟ یا موقعی خواب؟"
    },
    {
      "id": 5,
      "start": 14117.0,
      "end": 14119.0,
      "formatted_start": "03:55:17.000",
      "formatted_end": "03:55:19.000",
      "text": "نه، شب قبل از درست چیزی."
    },
    {
      "id": 6,
      "start": 14119.0,
      "end": 14124.0,
      "formatted_start": "03:55:19.000",
      "formatted_end": "03:55:24.000",
      "text": "بابا خوب اینا همه بیمزن. اصلا اینو برای چی میدونی بابا فروپورتر نگهشی؟ به چی دارن بخورن؟"
    },
    {
      "id": 7,
      "start": 14124.0,
      "end": 14125.0,
      "formatted_start": "03:55:24.000",
      "formatted_end": "03:55:25.000",
      "text": "چی میدونی؟"
    },
    {
      "id": 8,
      "start": 14125.0,
      "end": 14127.0,
      "formatted_start": "03:55:25.000",
      "formatted_end": "03:55:27.000",
      "text": "به ترمیت یویج دردیانه"
    },
    {
      "id": 9,
      "start": 14127.0,
      "end": 14129.0,
      "formatted_start": "03:55:27.000",
      "formatted_end": "03:55:29.000",
      "text": "اونو خودش هم دیگه باید ما بردیم ده"
    },
    {
      "id": 10,
      "start": 14130.0,
      "end": 14133.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:33.000",
      "text": "بعد قضا میخواد شب بخورم یا قبل از قضا؟"
    },
    {
      "id": 11,
      "start": 14133.0,
      "end": 14134.0,
      "formatted_start": "03:55:33.000",
      "formatted_end": "03:55:34.000",
      "text": "قبل قضا"
    },
    {
      "id": 12,
      "start": 14134.0,
      "end": 14137.0,
      "formatted_start": "03:55:34.000",
      "formatted_end": "03:55:37.000",
      "text": "قبل از قضا بخورم، بعد قضا بخورم"
    },
    {
      "id": 13,
      "start": 14139.0,
      "end": 14141.0,
      "formatted_start": "03:55:39.000",
      "formatted_end": "03:55:41.000",
      "text": "هنو داری صور نشته ها؟"
    },
    {
      "id": 14,
      "start": 14141.0,
      "end": 14143.0,
      "formatted_start": "03:55:41.000",
      "formatted_end": "03:55:43.000",
      "text": "هنو گذاشته بودن برمیستو بگم"
    },
    {
      "id": 15,
      "start": 14143.0,
      "end": 14145.0,
      "formatted_start": "03:55:43.000",
      "formatted_end": "03:55:45.000",
      "text": "اگه گذاشتی زنن؟"
    },
    {
      "id": 16,
      "start": 14145.0,
      "end": 14147.0,
      "formatted_start": "03:55:45.000",
      "formatted_end": "03:55:47.000",
      "text": "نه بذاشته بودم دیگه"
    },
    {
      "id": 17,
      "start": 14154.0,
      "end": 14159.0,
      "formatted_start": "03:55:54.000",
      "formatted_end": "03:55:59.000",
      "text": "یکم مثلاً در بطیقه سر تا زده هم مثلاً میگه نوهر تا رو بیمه میگم ده تا آزاد"
    },
    {
      "id": 18,
      "start": 14159.0,
      "end": 14163.0,
      "formatted_start": "03:55:59.000",
      "formatted_end": "03:56:03.000",
      "text": "منو من کلم هم نوهر تا واسه یک تاره که اینجا دوست بودم"
    },
    {
      "id": 19,
      "start": 14163.0,
      "end": 14166.0,
      "formatted_start": "03:56:03.000",
      "formatted_end": "03:56:06.000",
      "text": "آره همون برنامه از اینکه بیمه مده بل بیست"
    },
    {
      "id": 20,
      "start": 14166.0,
      "end": 14172.0,
      "formatted_start": "03:56:06.000",
      "formatted_end": "03:56:12.000",
      "text": "باز بوجه دیگه اینو با میاد یه همین چهار داروی هم پر باشه میمونیم چکار بگیم"
    },
    {
      "id": 21,
      "start": 14175.0,
      "end": 14182.0,
      "formatted_start": "03:56:15.000",
      "formatted_end": "03:56:22.000",
      "text": "مردم هایی سالی پیروان کردن."
    },
    {
      "id": 22,
      "start": 14182.0,
      "end": 14185.0,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:25.000",
      "text": "این هیس سالی تا الان اینجوری نشوند."
    },
    {
      "id": 23,
      "start": 14185.0,
      "end": 14191.0,
      "formatted_start": "03:56:25.000",
      "formatted_end": "03:56:31.000",
      "text": "الان دیگه دو سال سالی که گاهی وقتا نمیدونم در اثر چی میشه."
    },
    {
      "id": 24,
      "start": 14191.0,
      "end": 14195.0,
      "formatted_start": "03:56:31.000",
      "formatted_end": "03:56:35.000",
      "text": "این ورم مکنه ورمش زیاد میشه."
    },
    {
      "id": 25,
      "start": 14195.0,
      "end": 14197.0,
      "formatted_start": "03:56:35.000",
      "formatted_end": "03:56:37.000",
      "text": "الان من یه دست کشی دارم."
    },
    {
      "id": 26,
      "start": 14197.0,
      "end": 14201.0,
      "formatted_start": "03:56:37.000",
      "formatted_end": "03:56:41.000",
      "text": "الان بیرون میگم شما وقتی به شب میخوادید باز یه دستتون بالش کشید."
    },
    {
      "id": 27,
      "start": 14201.0,
      "end": 14203.0,
      "formatted_start": "03:56:41.000",
      "formatted_end": "03:56:43.000",
      "text": "باید بشه"
    },
    {
      "id": 28,
      "start": 14203.0,
      "end": 14207.0,
      "formatted_start": "03:56:43.000",
      "formatted_end": "03:56:47.000",
      "text": "دستم بالشت میذارم"
    },
    {
      "id": 29,
      "start": 14207.0,
      "end": 14209.0,
      "formatted_start": "03:56:47.000",
      "formatted_end": "03:56:49.000",
      "text": "خدا باید برد"
    },
    {
      "id": 30,
      "start": 14209.0,
      "end": 14211.0,
      "formatted_start": "03:56:49.000",
      "formatted_end": "03:56:51.000",
      "text": "نه باید برد"
    },
    {
      "id": 31,
      "start": 14211.0,
      "end": 14213.0,
      "formatted_start": "03:56:51.000",
      "formatted_end": "03:56:53.000",
      "text": "نه نمیذارم"
    },
    {
      "id": 32,
      "start": 14213.0,
      "end": 14219.0,
      "formatted_start": "03:56:53.000",
      "formatted_end": "03:56:59.000",
      "text": "همیشه وقتی همه خواهر زیادتر طرف راست مخواهم و دست من همینطوری بالشت بیداری بالاتر"
    },
    {
      "id": 33,
      "start": 14219.0,
      "end": 14221.0,
      "formatted_start": "03:56:59.000",
      "formatted_end": "03:57:01.000",
      "text": "روش که نه باید بخواهی ازشون"
    },
    {
      "id": 34,
      "start": 14221.0,
      "end": 14223.0,
      "formatted_start": "03:57:01.000",
      "formatted_end": "03:57:03.000",
      "text": "برعکس باید به این نصب بخواهی چرک"
    },
    {
      "id": 35,
      "start": 14223.0,
      "end": 14225.0,
      "formatted_start": "03:57:03.000",
      "formatted_end": "03:57:05.000",
      "text": "جلوتی بالشت بزاری بزاری روش"
    },
    {
      "id": 36,
      "start": 14225.0,
      "end": 14229.0,
      "formatted_start": "03:57:05.000",
      "formatted_end": "03:57:09.000",
      "text": "من زیادتر نمیدونم به عادت رو رو رو رو"
    },
    {
      "id": 37,
      "start": 14229.0,
      "end": 14231.0,
      "formatted_start": "03:57:09.000",
      "formatted_end": "03:57:11.000",
      "text": "خب دست برم می کنی"
    },
    {
      "id": 38,
      "start": 14231.0,
      "end": 14233.0,
      "formatted_start": "03:57:11.000",
      "formatted_end": "03:57:13.000",
      "text": "راستم مخابر"
    },
    {
      "id": 39,
      "start": 14233.0,
      "end": 14235.0,
      "formatted_start": "03:57:13.000",
      "formatted_end": "03:57:15.000",
      "text": "برعکس کاری که می کنی و بعد انجام بگیری"
    },
    {
      "id": 40,
      "start": 14235.0,
      "end": 14237.0,
      "formatted_start": "03:57:15.000",
      "formatted_end": "03:57:17.000",
      "text": "دست برم"
    },
    {
      "id": 41,
      "start": 14237.0,
      "end": 14239.0,
      "formatted_start": "03:57:17.000",
      "formatted_end": "03:57:19.000",
      "text": "آره دیگه"
    },
    {
      "id": 42,
      "start": 14239.0,
      "end": 14241.0,
      "formatted_start": "03:57:19.000",
      "formatted_end": "03:57:21.000",
      "text": "دست برم می کنی"
    },
    {
      "id": 43,
      "start": 14241.0,
      "end": 14243.0,
      "formatted_start": "03:57:21.000",
      "formatted_end": "03:57:23.000",
      "text": "نه برای خبیری"
    },
    {
      "id": 44,
      "start": 14243.0,
      "end": 14245.0,
      "formatted_start": "03:57:23.000",
      "formatted_end": "03:57:25.000",
      "text": "تا موقع دست برم"
    },
    {
      "id": 45,
      "start": 14245.0,
      "end": 14247.0,
      "formatted_start": "03:57:25.000",
      "formatted_end": "03:57:27.000",
      "text": "هست کار من؟ نه هستم کجایی؟"
    },
    {
      "id": 46,
      "start": 14247.0,
      "end": 14249.0,
      "formatted_start": "03:57:27.000",
      "formatted_end": "03:57:29.000",
      "text": "این یکی یه دونه"
    },
    {
      "id": 47,
      "start": 14249.0,
      "end": 14251.0,
      "formatted_start": "03:57:29.000",
      "formatted_end": "03:57:31.000",
      "text": "آره با همون هست"
    },
    {
      "id": 48,
      "start": 14251.0,
      "end": 14253.0,
      "formatted_start": "03:57:31.000",
      "formatted_end": "03:57:33.000",
      "text": "با همون هست"
    },
    {
      "id": 49,
      "start": 14253.0,
      "end": 14255.0,
      "formatted_start": "03:57:33.000",
      "formatted_end": "03:57:35.000",
      "text": "موقع داره خودشون رو شده"
    },
    {
      "id": 50,
      "start": 14255.0,
      "end": 14285.0,
      "formatted_start": "03:57:35.000",
      "formatted_end": "03:58:05.000",
      "text": "این هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی هایی ه"
    },
    {
      "id": 51,
      "start": 14285.0,
      "end": 14287.0,
      "formatted_start": "03:58:05.000",
      "formatted_end": "03:58:07.000",
      "text": "مادره؟"
    },
    {
      "id": 52,
      "start": 14287.0,
      "end": 14289.0,
      "formatted_start": "03:58:07.000",
      "formatted_end": "03:58:09.000",
      "text": "باشه"
    },
    {
      "id": 53,
      "start": 14289.0,
      "end": 14291.0,
      "formatted_start": "03:58:09.000",
      "formatted_end": "03:58:11.000",
      "text": "الان مامان یکی بسری شده یا نه؟"
    },
    {
      "id": 54,
      "start": 14291.0,
      "end": 14293.0,
      "formatted_start": "03:58:11.000",
      "formatted_end": "03:58:13.000",
      "text": "نه، مامان نردید"
    },
    {
      "id": 55,
      "start": 14293.0,
      "end": 14295.0,
      "formatted_start": "03:58:13.000",
      "formatted_end": "03:58:15.000",
      "text": "نه، مامان خوده، خوشحال بود"
    },
    {
      "id": 56,
      "start": 14295.0,
      "end": 14297.0,
      "formatted_start": "03:58:15.000",
      "formatted_end": "03:58:17.000",
      "text": "آها"
    },
    {
      "id": 57,
      "start": 14297.0,
      "end": 14299.0,
      "formatted_start": "03:58:17.000",
      "formatted_end": "03:58:19.000",
      "text": "باشه"
    },
    {
      "id": 58,
      "start": 14299.0,
      "end": 14301.0,
      "formatted_start": "03:58:19.000",
      "formatted_end": "03:58:21.000",
      "text": "باشه، انشاءالله تو سلامتی هست"
    },
    {
      "id": 59,
      "start": 14301.0,
      "end": 14303.0,
      "formatted_start": "03:58:21.000",
      "formatted_end": "03:58:23.000",
      "text": "باشه"
    },
    {
      "id": 60,
      "start": 14303.0,
      "end": 14305.0,
      "formatted_start": "03:58:23.000",
      "formatted_end": "03:58:25.000",
      "text": "سلامت باشین، خواهش میکنم"
    },
    {
      "id": 61,
      "start": 14305.0,
      "end": 14307.0,
      "formatted_start": "03:58:25.000",
      "formatted_end": "03:58:27.000",
      "text": "خدا نگهد"
    },
    {
      "id": 62,
      "start": 14307.0,
      "end": 14309.0,
      "formatted_start": "03:58:27.000",
      "formatted_end": "03:58:29.000",
      "text": "دو دو کور که شما اون گفتین"
    },
    {
      "id": 63,
      "start": 14309.0,
      "end": 14311.0,
      "formatted_start": "03:58:29.000",
      "formatted_end": "03:58:31.000",
      "text": "یکیشون لفته خارج"
    },
    {
      "id": 64,
      "start": 14311.0,
      "end": 14313.0,
      "formatted_start": "03:58:31.000",
      "formatted_end": "03:58:33.000",
      "text": "یکیشون"
    },
    {
      "id": 65,
      "start": 14313.0,
      "end": 14343.0,
      "formatted_start": "03:58:33.000",
      "formatted_end": "03:59:03.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 66,
      "start": 14343.0,
      "end": 14345.0,
      "formatted_start": "03:59:03.000",
      "formatted_end": "03:59:05.000",
      "text": "اصلا اصلا پدر ایرانی هست"
    },
    {
      "id": 67,
      "start": 14345.0,
      "end": 14347.0,
      "formatted_start": "03:59:05.000",
      "formatted_end": "03:59:07.000",
      "text": "چیزی دیگه پدر ایرانی"
    },
    {
      "id": 68,
      "start": 14347.0,
      "end": 14349.0,
      "formatted_start": "03:59:07.000",
      "formatted_end": "03:59:09.000",
      "text": "پدر علم گوگارش ایرانی"
    },
    {
      "id": 69,
      "start": 14349.0,
      "end": 14351.0,
      "formatted_start": "03:59:09.000",
      "formatted_end": "03:59:11.000",
      "text": "پسر اونه"
    },
    {
      "id": 70,
      "start": 14351.0,
      "end": 14353.0,
      "formatted_start": "03:59:11.000",
      "formatted_end": "03:59:13.000",
      "text": "اصلا مرکز گوگارش"
    },
    {
      "id": 71,
      "start": 14353.0,
      "end": 14355.0,
      "formatted_start": "03:59:13.000",
      "formatted_end": "03:59:15.000",
      "text": "این گوگار داستان شرق ایران"
    },
    {
      "id": 72,
      "start": 14355.0,
      "end": 14357.0,
      "formatted_start": "03:59:15.000",
      "formatted_end": "03:59:17.000",
      "text": "آه دیدی زودتی نداره"
    },
    {
      "id": 73,
      "start": 14357.0,
      "end": 14359.0,
      "formatted_start": "03:59:17.000",
      "formatted_end": "03:59:19.000",
      "text": "آه اون اصلا اونها یک خانواده"
    },
    {
      "id": 74,
      "start": 14359.0,
      "end": 14361.0,
      "formatted_start": "03:59:19.000",
      "formatted_end": "03:59:21.000",
      "text": "که اصلا همون"
    },
    {
      "id": 75,
      "start": 14361.0,
      "end": 14363.0,
      "formatted_start": "03:59:21.000",
      "formatted_end": "03:59:23.000",
      "text": "پدر علم گوگارش ایرانی"
    },
    {
      "id": 76,
      "start": 14363.0,
      "end": 14365.0,
      "formatted_start": "03:59:23.000",
      "formatted_end": "03:59:25.000",
      "text": "از ماست که"
    },
    {
      "id": 77,
      "start": 14365.0,
      "end": 14367.0,
      "formatted_start": "03:59:25.000",
      "formatted_end": "03:59:27.000",
      "text": "که نامانه کنه"
    },
    {
      "id": 78,
      "start": 14367.0,
      "end": 14369.0,
      "formatted_start": "03:59:27.000",
      "formatted_end": "03:59:29.000",
      "text": "وقتی یه نفر اینقدر داده فکر میکنه"
    },
    {
      "id": 79,
      "start": 14369.0,
      "end": 14371.0,
      "formatted_start": "03:59:29.000",
      "formatted_end": "03:59:31.000",
      "text": "هر چیز پستی پر برده بهش داره"
    },
    {
      "id": 80,
      "start": 14371.0,
      "end": 14377.0,
      "formatted_start": "03:59:31.000",
      "formatted_end": "03:59:37.000",
      "text": "چه مشهد هم دارم بهت میگم. میگم رضاوی اینجا علم نداره. رضاوی هوتل."
    },
    {
      "id": 81,
      "start": 14377.0,
      "end": 14380.0,
      "formatted_start": "03:59:37.000",
      "formatted_end": "03:59:40.000",
      "text": "اون مالی یه معیزی بسه مهمه که بخواست یه دقیقه یه عمل قرار بگو بند."
    },
    {
      "id": 82,
      "start": 14380.0,
      "end": 14385.0,
      "formatted_start": "03:59:40.000",
      "formatted_end": "03:59:45.000",
      "text": "اونم تو دکتر خوب و بیرون شناختی. بیرون دو دقیقه هم بگویی حالا بشه میگم بیا."
    },
    {
      "id": 83,
      "start": 14385.0,
      "end": 14388.0,
      "formatted_start": "03:59:45.000",
      "formatted_end": "03:59:48.000",
      "text": "تو خصوصی تو یک روز عمل کن. معیز اون بر."
    },
    {
      "id": 84,
      "start": 14388.0,
      "end": 14393.0,
      "formatted_start": "03:59:48.000",
      "formatted_end": "03:59:53.000",
      "text": "نه بسه اینکه معیز اینجوری که بسه یه نقلت. این معیز تحقیقاتیه."
    },
    {
      "id": 85,
      "start": 14393.0,
      "end": 14400.0,
      "formatted_start": "03:59:53.000",
      "formatted_end": "04:00:00.000",
      "text": "اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    }
