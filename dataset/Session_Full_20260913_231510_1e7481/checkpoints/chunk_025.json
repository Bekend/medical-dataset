  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7502.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:02.000",
      "text": "یعنی از جمعه بهش هیچی نده؟"
    },
    {
      "id": 1,
      "start": 7502.0,
      "end": 7510.0,
      "formatted_start": "02:05:02.000",
      "formatted_end": "02:05:10.000",
      "text": "فقط انسلین بزن. از روز جمعه فقط انسلین بزن. برس هیچی نده."
    },
    {
      "id": 2,
      "start": 7510.0,
      "end": 7517.0,
      "formatted_start": "02:05:10.000",
      "formatted_end": "02:05:17.000",
      "text": "خب چون که سطح خونیه، دارو خونیه، برس گیر خواهیم. چون نیتونید خون، خون تو خون هست."
    },
    {
      "id": 3,
      "start": 7517.0,
      "end": 7524.0,
      "formatted_start": "02:05:17.000",
      "formatted_end": "02:05:24.000",
      "text": "تا زمانی هست بشه که بتونیم درموز رو شروع کنیم، خیلی طول می کشه. خب؟"
    },
    {
      "id": 4,
      "start": 7524.0,
      "end": 7528.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:28.000",
      "text": "تصمیم برای باشه همه رو میدن بهت"
    },
    {
      "id": 5,
      "start": 7528.0,
      "end": 7530.0,
      "formatted_start": "02:05:28.000",
      "formatted_end": "02:05:30.000",
      "text": "چون اینجوری نمیشه"
    },
    {
      "id": 6,
      "start": 7530.0,
      "end": 7534.0,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:34.000",
      "text": "مریض هم انسالین هم این همه قرص باز تو قندری باشه"
    },
    {
      "id": 7,
      "start": 7534.0,
      "end": 7538.0,
      "formatted_start": "02:05:34.000",
      "formatted_end": "02:05:38.000",
      "text": "اون دفعه سانو و آزمایشت گفتین افونت داره"
    },
    {
      "id": 8,
      "start": 7538.0,
      "end": 7542.0,
      "formatted_start": "02:05:38.000",
      "formatted_end": "02:05:42.000",
      "text": "الان اینقدر که شب از مساندت میگی تو به خاندکتر میگفتی"
    },
    {
      "id": 9,
      "start": 7542.0,
      "end": 7544.0,
      "formatted_start": "02:05:42.000",
      "formatted_end": "02:05:44.000",
      "text": "همکل برای من بیشتر بنویسه"
    },
    {
      "id": 10,
      "start": 7544.0,
      "end": 7548.0,
      "formatted_start": "02:05:44.000",
      "formatted_end": "02:05:48.000",
      "text": "خب برهم بذار بیاد بیمارستان جلو چشم خودمون خواهد"
    },
    {
      "id": 11,
      "start": 7548.0,
      "end": 7558.64,
      "formatted_start": "02:05:48.000",
      "formatted_end": "02:05:58.640",
      "text": "از این حالت با این همه بازید که ناشته دوست دوست بیست باز از اون هم میگه که می آفده"
    },
    {
      "id": 12,
      "start": 7558.64,
      "end": 7564.14,
      "formatted_start": "02:05:58.640",
      "formatted_end": "02:06:04.140",
      "text": "این هم دیگه هست کاندکتور هم آدمایش هم توناش اگه تو فرونده ش می خواهید"
    },
    {
      "id": 13,
      "start": 7564.14,
      "end": 7565.76,
      "formatted_start": "02:06:04.140",
      "formatted_end": "02:06:05.760",
      "text": "آره این هم تیپه"
    },
    {
      "id": 14,
      "start": 7565.76,
      "end": 7595.76,
      "formatted_start": "02:06:05.760",
      "formatted_end": "02:06:35.760",
