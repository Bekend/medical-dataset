  "stt_segments": [
    {
      "id": 0,
      "start": 18300.0,
      "end": 18329.98,
      "formatted_start": "05:05:00.000",
      "formatted_end": "05:05:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 18330.0,
      "end": 18358.0,
      "formatted_start": "05:05:30.000",
      "formatted_end": "05:05:58.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 18360.0,
      "end": 18387.0,
      "formatted_start": "05:06:00.000",
      "formatted_end": "05:06:27.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 18387.0,
      "end": 18389.0,
      "formatted_start": "05:06:27.000",
      "formatted_end": "05:06:29.000",
      "text": "بارداری نه نه"
    },
    {
      "id": 4,
      "start": 18404.28,
      "end": 18406.28,
      "formatted_start": "05:06:44.280",
      "formatted_end": "05:06:46.280",
      "text": "اون موهرون دو سریعتونو پایین میدونش"
    },
    {
      "id": 5,
      "start": 18406.28,
      "end": 18408.28,
      "formatted_start": "05:06:46.280",
      "formatted_end": "05:06:48.280",
      "text": "نرمال"
    },
    {
      "id": 6,
      "start": 18408.28,
      "end": 18412.04,
      "formatted_start": "05:06:48.280",
      "formatted_end": "05:06:52.040",
      "text": "اون که گاهی وقتو تو زمانه استرسی نه برای پایین میشه"
    },
    {
      "id": 7,
      "start": 18412.04,
      "end": 18414.04,
      "formatted_start": "05:06:52.040",
      "formatted_end": "05:06:54.040",
      "text": "برای نرماله"
    },
    {
      "id": 8,
      "start": 18414.04,
      "end": 18416.04,
      "formatted_start": "05:06:54.040",
      "formatted_end": "05:06:56.040",
      "text": "برای نریز نامو چی مامو کنی؟"
    },
    {
      "id": 9,
      "start": 18416.04,
      "end": 18418.04,
      "formatted_start": "05:06:56.040",
      "formatted_end": "05:06:58.040",
      "text": "از اینکه از اسلامی آزمایش برسید"
    },
    {
      "id": 10,
      "start": 18418.04,
      "end": 18419.04,
      "formatted_start": "05:06:58.040",
      "formatted_end": "05:06:59.040",
      "text": "آره"
    },
    {
      "id": 11,
      "start": 18419.04,
      "end": 18422.04,
      "formatted_start": "05:06:59.040",
      "formatted_end": "05:07:02.040",
      "text": "پس هم برای یک لحظه بازید"
    },
    {
      "id": 12,
      "start": 18437.04,
      "end": 18440.04,
      "formatted_start": "05:07:17.040",
      "formatted_end": "05:07:20.040",
      "text": "الان میرونید که اصلا پرکاری نیست"
    },
    {
      "id": 13,
      "start": 18440.04,
      "end": 18443.04,
      "formatted_start": "05:07:20.040",
      "formatted_end": "05:07:23.040",
      "text": "پرکار حتی این شکلی نمیشینه"
    },
    {
      "id": 14,
      "start": 18443.04,
      "end": 18451.04,
      "formatted_start": "05:07:23.040",
      "formatted_end": "05:07:31.040",
      "text": "بیرعراره، رستاش پر از عرق، صورتش پیشانی پر از عرقه، علم اصلا نداره"
    },
    {
      "id": 15,
      "start": 18451.04,
      "end": 18457.04,
      "formatted_start": "05:07:31.040",
      "formatted_end": "05:07:37.040",
      "text": "و معمولا توی دورای استرس های ما، باید وقتی عدد جا به جا میشه"
    },
    {
      "id": 16,
      "start": 18457.04,
      "end": 18471.04,
      "formatted_start": "05:07:37.040",
      "formatted_end": "05:07:51.040",
      "text": "منطقه علم های کلمه بالا پر میبینم، مستعد هستن، کلم، کابل، طلب، طلبچه، سویا، شفق، لبو هستن"
    },
    {
      "id": 17,
      "start": 18473.04,
      "end": 18503.04,
      "formatted_start": "05:07:53.040",
      "formatted_end": "05:08:23.040",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 18,
      "start": 18503.04,
      "end": 18505.04,
      "formatted_start": "05:08:23.040",
      "formatted_end": "05:08:25.040",
      "text": "خوبه انتو صدا های خوبه"
    },
    {
      "id": 19,
      "start": 18505.04,
      "end": 18507.04,
      "formatted_start": "05:08:25.040",
      "formatted_end": "05:08:27.040",
      "text": "باید کشوری خوندن بگرد"
    },
    {
      "id": 20,
      "start": 18527.04,
      "end": 18529.04,
      "formatted_start": "05:08:47.040",
      "formatted_end": "05:08:49.040",
      "text": "خوبه از پیان"
    },
    {
      "id": 21,
      "start": 18529.04,
      "end": 18531.04,
      "formatted_start": "05:08:49.040",
      "formatted_end": "05:08:51.040",
      "text": "خوبه از پیان"
    },
    {
      "id": 22,
      "start": 18533.04,
      "end": 18535.04,
      "formatted_start": "05:08:53.040",
      "formatted_end": "05:08:55.040",
      "text": "این از این مریضی برام هست"
    },
    {
      "id": 23,
      "start": 18546.04,
      "end": 18548.04,
      "formatted_start": "05:09:06.040",
      "formatted_end": "05:09:08.040",
      "text": "سلام، خوشحال نماشه"
    },
    {
      "id": 24,
      "start": 18548.04,
      "end": 18550.04,
      "formatted_start": "05:09:08.040",
      "formatted_end": "05:09:10.040",
      "text": "دکتر جمع شده اونها از اون خوبه هست؟ سلامت باشه"
    },
    {
      "id": 25,
      "start": 18550.04,
      "end": 18552.04,
      "formatted_start": "05:09:10.040",
      "formatted_end": "05:09:12.040",
      "text": "میگم که یه مریض میخواد برسن"
    },
    {
      "id": 26,
      "start": 18552.04,
      "end": 18554.04,
      "formatted_start": "05:09:12.040",
      "formatted_end": "05:09:14.040",
      "text": "این پذیرش نمیدونم چجوری ازشون بپسن"
    },
    {
      "id": 27,
      "start": 18554.04,
      "end": 18556.04,
      "formatted_start": "05:09:14.040",
      "formatted_end": "05:09:16.040",
      "text": "میخوان برنم بابی به تکمیلی"
    },
    {
      "id": 28,
      "start": 18556.04,
      "end": 18559.04,
      "formatted_start": "05:09:16.040",
      "formatted_end": "05:09:19.040",
      "text": "آسیه قرار داد دارن یا نه؟"
    },
    {
      "id": 29,
      "start": 18559.04,
      "end": 18562.2,
      "formatted_start": "05:09:19.040",
      "formatted_end": "05:09:22.200",
      "text": "آسیه"
    },
    {
      "id": 30,
      "start": 18562.2,
      "end": 18571.54,
      "formatted_start": "05:09:22.200",
      "formatted_end": "05:09:31.540",
      "text": "سلامهایتو خوبه؟"
    },
    {
      "id": 31,
      "start": 18571.54,
      "end": 18572.36,
      "formatted_start": "05:09:31.540",
      "formatted_end": "05:09:32.360",
      "text": "پس نماشه"
    },
    {
      "id": 32,
      "start": 18572.36,
      "end": 18575.96,
      "formatted_start": "05:09:32.360",
      "formatted_end": "05:09:35.960",
      "text": "میگم بابیم تکیلی آسیه قرار داری؟"
    },
    {
      "id": 33,
      "start": 18575.96,
      "end": 18579.22,
      "formatted_start": "05:09:35.960",
      "formatted_end": "05:09:39.220",
      "text": "آسیه یا آسیه؟"
    },
    {
      "id": 34,
      "start": 18579.22,
      "end": 18580.36,
      "formatted_start": "05:09:39.220",
      "formatted_end": "05:09:40.360",
      "text": "آسیه هم داری؟"
    },
    {
      "id": 35,
      "start": 18582.16,
      "end": 18584.16,
      "formatted_start": "05:09:42.160",
      "formatted_end": "05:09:44.160",
      "text": "منیز اشتباه میگم"
    },
    {
      "id": 36,
      "start": 18584.16,
      "end": 18585.7,
      "formatted_start": "05:09:44.160",
      "formatted_end": "05:09:45.700",
      "text": "من منطقه آسیه میشه"
    },
    {
      "id": 37,
      "start": 18585.7,
      "end": 18592.2,
      "formatted_start": "05:09:45.700",
      "formatted_end": "05:09:52.200",
      "text": "آره میتونم نردید با سیره که همون روز بسیار شد"
    },
    {
      "id": 38,
      "start": 18592.2,
      "end": 18594.04,
      "formatted_start": "05:09:52.200",
      "formatted_end": "05:09:54.040",
      "text": "که باشم این زمان های آسیب"
    },
    {
      "id": 39,
      "start": 18594.04,
      "end": 18597.76,
      "formatted_start": "05:09:54.040",
      "formatted_end": "05:09:57.760",
      "text": "آره مرسی عزیزمان ها"
    },
    {
      "id": 40,
      "start": 18597.76,
      "end": 18599.22,
      "formatted_start": "05:09:57.760",
      "formatted_end": "05:09:59.220",
      "text": "مچکرم خدا"
    }
  ],
  "status": "completed"
}