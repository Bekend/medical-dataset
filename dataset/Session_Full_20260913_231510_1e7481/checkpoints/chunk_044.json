  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13230.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:30.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13232.0,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:32.000",
      "text": "اینکه من بی کاری پا تو تن دیوار بزنم"
    },
    {
      "id": 2,
      "start": 13232.0,
      "end": 13234.0,
      "formatted_start": "03:40:32.000",
      "formatted_end": "03:40:34.000",
      "text": "چارزانه که خدا بیام مرزه دیگه"
    },
    {
      "id": 3,
      "start": 13234.0,
      "end": 13236.0,
      "formatted_start": "03:40:34.000",
      "formatted_end": "03:40:36.000",
      "text": "همینکس نمیدونی چارزانه بزنه"
    },
    {
      "id": 4,
      "start": 13236.0,
      "end": 13238.0,
      "formatted_start": "03:40:36.000",
      "formatted_end": "03:40:38.000",
      "text": "تو والد فقط فرنگی و بعد بری"
    },
    {
      "id": 5,
      "start": 13238.0,
      "end": 13240.0,
      "formatted_start": "03:40:38.000",
      "formatted_end": "03:40:40.000",
      "text": "الان دیگه او آدم های قدیمیست که"
    },
    {
      "id": 6,
      "start": 13240.0,
      "end": 13242.0,
      "formatted_start": "03:40:40.000",
      "formatted_end": "03:40:42.000",
      "text": "والا"
    },
    {
      "id": 7,
      "start": 13242.0,
      "end": 13244.0,
      "formatted_start": "03:40:42.000",
      "formatted_end": "03:40:44.000",
      "text": "من مترستنه"
    },
    {
      "id": 8,
      "start": 13244.0,
      "end": 13246.0,
      "formatted_start": "03:40:44.000",
      "formatted_end": "03:40:46.000",
      "text": "من دیگه کار سکنیم"
    },
    {
      "id": 9,
      "start": 13246.0,
      "end": 13248.0,
      "formatted_start": "03:40:46.000",
      "formatted_end": "03:40:48.000",
      "text": "اونو توی مسجد بچه بذار کنی همه پاهاشون درازه"
    },
    {
      "id": 10,
      "start": 13248.0,
      "end": 13250.0,
      "formatted_start": "03:40:48.000",
      "formatted_end": "03:40:50.000",
      "text": "کس دیگه نمیدونیش"
    },
    {
      "id": 11,
      "start": 13250.0,
      "end": 13252.0,
      "formatted_start": "03:40:50.000",
      "formatted_end": "03:40:52.000",
      "text": "نماد من مشاهسته میفرد دیگه"
    },
    {
      "id": 12,
      "start": 13252.0,
      "end": 13254.0,
      "formatted_start": "03:40:52.000",
      "formatted_end": "03:40:54.000",
      "text": "فقط تو این"
    },
    {
      "id": 13,
      "start": 13254.0,
      "end": 13260.0,
      "formatted_start": "03:40:54.000",
      "formatted_end": "03:41:00.000",
      "text": "از اینجوری که دراز می کنم خوب درد می گیره"
    },
    {
      "id": 14,
      "start": 13260.0,
      "end": 13262.0,
      "formatted_start": "03:41:00.000",
      "formatted_end": "03:41:02.000",
      "text": "و کالسیوم می خوری؟"
    },
    {
      "id": 15,
      "start": 13262.0,
      "end": 13264.0,
      "formatted_start": "03:41:02.000",
      "formatted_end": "03:41:04.000",
      "text": "کالسیوم نه ندارم"
    },
    {
      "id": 16,
      "start": 13268.0,
      "end": 13272.0,
      "formatted_start": "03:41:08.000",
      "formatted_end": "03:41:12.000",
      "text": "یک فرسیلو رو بریم بشم به همین دردش ساکر بشه"
    },
    {
      "id": 17,
      "start": 13272.0,
      "end": 13274.0,
      "formatted_start": "03:41:12.000",
      "formatted_end": "03:41:14.000",
      "text": "شب می خوابی؟"
    },
    {
      "id": 18,
      "start": 13274.0,
      "end": 13278.0,
      "formatted_start": "03:41:14.000",
      "formatted_end": "03:41:18.000",
      "text": "شب و روز ندارم درد دارم"
    },
    {
      "id": 19,
      "start": 13278.0,
      "end": 13283.18,
      "formatted_start": "03:41:18.000",
      "formatted_end": "03:41:23.180",
      "text": "کلسیوم دو روز درمیان بخور و آب گرم بخور و شکمت صرف نشه خب؟"
    },
    {
      "id": 20,
      "start": 13283.18,
      "end": 13283.72,
      "formatted_start": "03:41:23.180",
      "formatted_end": "03:41:23.720",
      "text": "نشه"
    },
    {
      "id": 21,
      "start": 13283.72,
      "end": 13290.06,
      "formatted_start": "03:41:23.720",
      "formatted_end": "03:41:30.060",
      "text": "اگه برسل واریس بهت ساخت دیگه همیشه همیه بخور"
    },
    {
      "id": 22,
      "start": 13290.06,
      "end": 13294.64,
      "formatted_start": "03:41:30.060",
      "formatted_end": "03:41:34.640",
      "text": "برسل واریسم برد میشه آمدن کنم یکی یه میخورم که آبیه"
    },
    {
      "id": 23,
      "start": 13294.64,
      "end": 13295.38,
      "formatted_start": "03:41:34.640",
      "formatted_end": "03:41:35.380",
      "text": "آبیه"
    },
    {
      "id": 24,
      "start": 13295.38,
      "end": 13299.36,
      "formatted_start": "03:41:35.380",
      "formatted_end": "03:41:39.360",
      "text": "شب خوب میخوابی؟"
    },
    {
      "id": 25,
      "start": 13299.36,
      "end": 13300.76,
      "formatted_start": "03:41:39.360",
      "formatted_end": "03:41:40.760",
      "text": "شب آره خوبم"
    },
    {
      "id": 26,
      "start": 13300.76,
      "end": 13304.1,
      "formatted_start": "03:41:40.760",
      "formatted_end": "03:41:44.100",
      "text": "خب دارو نوشتن برای"
    },
    {
      "id": 27,
      "start": 13304.1,
      "end": 13309.44,
      "formatted_start": "03:41:44.100",
      "formatted_end": "03:41:49.440",
      "text": "زربان قلب چرا خواهید قلب میخورید؟"
    },
    {
      "id": 28,
      "start": 13309.44,
      "end": 13313.92,
      "formatted_start": "03:41:49.440",
      "formatted_end": "03:41:53.920",
      "text": "قلب قبل قبلان از این خارجی ها میخوردم که اونها که پیدا نمیشه"
    },
    {
      "id": 29,
      "start": 13313.92,
      "end": 13314.52,
      "formatted_start": "03:41:53.920",
      "formatted_end": "03:41:54.520",
      "text": "خب"
    },
    {
      "id": 30,
      "start": 13314.52,
      "end": 13316.56,
      "formatted_start": "03:41:54.520",
      "formatted_end": "03:41:56.560",
      "text": "ایرانی میخورم ایرانی با من نمیشه"
    },
    {
      "id": 31,
      "start": 13316.56,
      "end": 13317.86,
      "formatted_start": "03:41:56.560",
      "formatted_end": "03:41:57.860",
      "text": "نصفش بکن"
    },
    {
      "id": 32,
      "start": 13317.86,
      "end": 13319.84,
      "formatted_start": "03:41:57.860",
      "formatted_end": "03:41:59.840",
      "text": "نصفش کن"
    },
    {
      "id": 33,
      "start": 13319.84,
      "end": 13321.1,
      "formatted_start": "03:41:59.840",
      "formatted_end": "03:42:01.100",
      "text": "یکو نصف بکنم"
    },
    {
      "id": 34,
      "start": 13321.1,
      "end": 13322.84,
      "formatted_start": "03:42:01.100",
      "formatted_end": "03:42:02.840",
      "text": "نه روزی نصف"
    },
    {
      "id": 35,
      "start": 13322.84,
      "end": 13324.1,
      "formatted_start": "03:42:02.840",
      "formatted_end": "03:42:04.100",
      "text": "نه جونه میخوری سلام"
    },
    {
      "id": 36,
      "start": 13324.1,
      "end": 13325.88,
      "formatted_start": "03:42:04.100",
      "formatted_end": "03:42:05.880",
      "text": "نصفش کن"
    },
    {
      "id": 37,
      "start": 13325.88,
      "end": 13327.0,
      "formatted_start": "03:42:05.880",
      "formatted_end": "03:42:07.000",
      "text": "روزی نصف بکن"
    },
    {
      "id": 38,
      "start": 13327.0,
      "end": 13327.62,
      "formatted_start": "03:42:07.000",
      "formatted_end": "03:42:07.620",
      "text": "سلام"
    },
    {
      "id": 39,
      "start": 13327.62,
      "end": 13328.1,
      "formatted_start": "03:42:07.620",
      "formatted_end": "03:42:08.100",
      "text": "باش"
    },
    {
      "id": 40,
      "start": 13328.1,
      "end": 13329.18,
      "formatted_start": "03:42:08.100",
      "formatted_end": "03:42:09.180",
      "text": "روزی نصف"
    },
    {
      "id": 41,
      "start": 13329.18,
      "end": 13331.16,
      "formatted_start": "03:42:09.180",
      "formatted_end": "03:42:11.160",
      "text": "باش در شما درد نکن"
    },
    {
      "id": 42,
      "start": 13331.16,
      "end": 13331.48,
      "formatted_start": "03:42:11.160",
      "formatted_end": "03:42:11.480",
      "text": "سلام"
    },
    {
      "id": 43,
      "start": 13331.48,
      "end": 13336.88,
      "formatted_start": "03:42:11.480",
      "formatted_end": "03:42:16.880",
      "text": "با همه دستش سیاد پر شده"
    },
    {
      "id": 44,
      "start": 13336.88,
      "end": 13339.6,
      "formatted_start": "03:42:16.880",
      "formatted_end": "03:42:19.600",
      "text": "یه هفته بدنش ترکه"
    },
    {
      "id": 45,
      "start": 13339.6,
      "end": 13340.72,
      "formatted_start": "03:42:19.600",
      "formatted_end": "03:42:20.720",
      "text": "همه سفتش ترکه"
    },
    {
      "id": 46,
      "start": 13340.72,
      "end": 13342.82,
      "formatted_start": "03:42:20.720",
      "formatted_end": "03:42:22.820",
      "text": "با همه دستش ترکه"
    },
    {
      "id": 47,
      "start": 13342.82,
      "end": 13344.58,
      "formatted_start": "03:42:22.820",
      "formatted_end": "03:42:24.580",
      "text": "هر یه هفته شده"
    },
    {
      "id": 48,
      "start": 13344.58,
      "end": 13346.72,
      "formatted_start": "03:42:24.580",
      "formatted_end": "03:42:26.720",
      "text": "هر یه هفته شده"
    },
    {
      "id": 49,
      "start": 13346.72,
      "end": 13348.72,
      "formatted_start": "03:42:26.720",
      "formatted_end": "03:42:28.720",
      "text": "هر یه هفته شده"
    },
    {
      "id": 50,
      "start": 13348.72,
      "end": 13351.28,
      "formatted_start": "03:42:28.720",
      "formatted_end": "03:42:31.280",
      "text": "هر یه هفته شده"
    },
    {
      "id": 51,
      "start": 13351.28,
      "end": 13354.28,
      "formatted_start": "03:42:31.280",
      "formatted_end": "03:42:34.280",
      "text": "هر یه هفته شده"
    },
    {
      "id": 52,
      "start": 13354.28,
      "end": 13355.56,
      "formatted_start": "03:42:34.280",
      "formatted_end": "03:42:35.560",
      "text": "همه چیه"
    },
    {
      "id": 53,
      "start": 13355.56,
      "end": 13356.56,
      "formatted_start": "03:42:35.560",
      "formatted_end": "03:42:36.560",
      "text": "سفتش ترکه"
    },
    {
      "id": 54,
      "start": 13356.56,
      "end": 13357.56,
      "formatted_start": "03:42:36.560",
      "formatted_end": "03:42:37.560",
      "text": "همه چیه"
    },
    {
      "id": 55,
      "start": 13357.56,
      "end": 13365.66,
      "formatted_start": "03:42:37.560",
      "formatted_end": "03:42:45.660",
      "text": "این ورنگ که زیادتر میشه افونت میکنه"
    },
    {
      "id": 56,
      "start": 13365.66,
      "end": 13367.62,
      "formatted_start": "03:42:45.660",
      "formatted_end": "03:42:47.620",
      "text": "افونت که میبونه اتر میکنه"
    },
    {
      "id": 57,
      "start": 13367.62,
      "end": 13370.94,
      "formatted_start": "03:42:47.620",
      "formatted_end": "03:42:50.940",
      "text": "ورنگ خوب شد که دیگر شد"
    },
    {
      "id": 58,
      "start": 13370.94,
      "end": 13374.48,
      "formatted_start": "03:42:50.940",
      "formatted_end": "03:42:54.480",
      "text": "نمک اصلا نمیدونی"
    },
    {
      "id": 59,
      "start": 13374.48,
      "end": 13377.86,
      "formatted_start": "03:42:54.480",
      "formatted_end": "03:42:57.860",
      "text": "این مورد آبا حاجیه"
    },
    {
      "id": 60,
      "start": 13377.86,
      "end": 13379.86,
      "formatted_start": "03:42:57.860",
      "formatted_end": "03:42:59.860",
      "text": "برای بابان"
    },
    {
      "id": 61,
      "start": 13379.86,
      "end": 13381.86,
      "formatted_start": "03:42:59.860",
      "formatted_end": "03:43:01.860",
      "text": "برای بابان خوضه بگیرم"
    },
    {
      "id": 62,
      "start": 13381.86,
      "end": 13383.86,
      "formatted_start": "03:43:01.860",
      "formatted_end": "03:43:03.860",
      "text": "بگیرم هاجی هم بشیم"
    },
    {
      "id": 63,
      "start": 13383.86,
      "end": 13385.86,
      "formatted_start": "03:43:03.860",
      "formatted_end": "03:43:05.860",
      "text": "هاجی بگیرم بشیم"
    },
    {
      "id": 64,
      "start": 13391.86,
      "end": 13393.86,
      "formatted_start": "03:43:11.860",
      "formatted_end": "03:43:13.860",
      "text": "اون بوده یه ماه شکل"
    },
    {
      "id": 65,
      "start": 13393.86,
      "end": 13395.86,
      "formatted_start": "03:43:13.860",
      "formatted_end": "03:43:15.860",
      "text": "آره دیگه"
    },
    {
      "id": 66,
      "start": 13395.86,
      "end": 13397.86,
      "formatted_start": "03:43:15.860",
      "formatted_end": "03:43:17.860",
      "text": "چون نبودی اینو"
    },
    {
      "id": 67,
      "start": 13397.86,
      "end": 13399.86,
      "formatted_start": "03:43:17.860",
      "formatted_end": "03:43:19.860",
      "text": "آره دیگه نبودی چی کردیم"
    },
    {
      "id": 68,
      "start": 13399.86,
      "end": 13401.86,
      "formatted_start": "03:43:19.860",
      "formatted_end": "03:43:21.860",
      "text": "نه من گوشت خیلی نیست"
    },
    {
      "id": 69,
      "start": 13401.86,
      "end": 13403.86,
      "formatted_start": "03:43:21.860",
      "formatted_end": "03:43:23.860",
      "text": "نه باید بخوریم"
    },
    {
      "id": 70,
      "start": 13403.86,
      "end": 13409.86,
      "formatted_start": "03:43:23.860",
      "formatted_end": "03:43:29.860",
      "text": "یک ماه، دو ماه، یک بار اتفاقی. من اینکه نمیخورم من."
    },
    {
      "id": 71,
      "start": 13409.86,
      "end": 13411.86,
      "formatted_start": "03:43:29.860",
      "formatted_end": "03:43:31.860",
      "text": "بابا چون دو نمیخورم."
    },
    {
      "id": 72,
      "start": 13416.86,
      "end": 13419.86,
      "formatted_start": "03:43:36.860",
      "formatted_end": "03:43:39.860",
      "text": "برم نمک نزنی تو غذات."
    },
    {
      "id": 73,
      "start": 13419.86,
      "end": 13421.86,
      "formatted_start": "03:43:39.860",
      "formatted_end": "03:43:41.860",
      "text": "نمک نزنم دیگه."
    },
    {
      "id": 74,
      "start": 13421.86,
      "end": 13424.86,
      "formatted_start": "03:43:41.860",
      "formatted_end": "03:43:44.860",
      "text": "نمک نزنی خب پس دیگه اون دردو همه رو تمام."
    },
    {
      "id": 75,
      "start": 13428.86,
      "end": 13430.86,
      "formatted_start": "03:43:48.860",
      "formatted_end": "03:43:50.860",
      "text": "چون نمک نزنی؟"
    },
    {
      "id": 76,
      "start": 13430.86,
      "end": 13432.86,
      "formatted_start": "03:43:50.860",
      "formatted_end": "03:43:52.860",
      "text": "این همان حاجی هست"
    },
    {
      "id": 77,
      "start": 13432.86,
      "end": 13436.86,
      "formatted_start": "03:43:52.860",
      "formatted_end": "03:43:56.860",
      "text": "ازت باید بدون نمک باشه"
    },
    {
      "id": 78,
      "start": 13436.86,
      "end": 13438.86,
      "formatted_start": "03:43:56.860",
      "formatted_end": "03:43:58.860",
      "text": "این بدون نمک باشه"
    },
    {
      "id": 79,
      "start": 13438.86,
      "end": 13440.86,
      "formatted_start": "03:43:58.860",
      "formatted_end": "03:44:00.860",
      "text": "این بدون نمک باشه"
    },
    {
      "id": 80,
      "start": 13440.86,
      "end": 13442.86,
      "formatted_start": "03:44:00.860",
      "formatted_end": "03:44:02.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 81,
      "start": 13442.86,
      "end": 13444.86,
      "formatted_start": "03:44:02.860",
      "formatted_end": "03:44:04.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 82,
      "start": 13444.86,
      "end": 13446.86,
      "formatted_start": "03:44:04.860",
      "formatted_end": "03:44:06.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 83,
      "start": 13446.86,
      "end": 13448.86,
      "formatted_start": "03:44:06.860",
      "formatted_end": "03:44:08.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 84,
      "start": 13448.86,
      "end": 13450.86,
      "formatted_start": "03:44:08.860",
      "formatted_end": "03:44:10.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 85,
      "start": 13450.86,
      "end": 13452.86,
      "formatted_start": "03:44:10.860",
      "formatted_end": "03:44:12.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 86,
      "start": 13452.86,
      "end": 13454.86,
      "formatted_start": "03:44:12.860",
      "formatted_end": "03:44:14.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 87,
      "start": 13454.86,
      "end": 13456.86,
      "formatted_start": "03:44:14.860",
      "formatted_end": "03:44:16.860",
      "text": "این باید بدون نمک باشه"
    },
    {
      "id": 88,
      "start": 13456.86,
      "end": 13458.86,
      "formatted_start": "03:44:16.860",
      "formatted_end": "03:44:18.860",
