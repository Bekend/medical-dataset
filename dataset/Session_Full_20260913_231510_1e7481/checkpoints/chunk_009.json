  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2710.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:10.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 2730.0,
      "end": 2760.0,
      "formatted_start": "00:45:30.000",
      "formatted_end": "00:46:00.000",
      "text": "برای اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که"
    },
    {
      "id": 2,
      "start": 2760.0,
      "end": 2763.0,
      "formatted_start": "00:46:00.000",
      "formatted_end": "00:46:03.000",
      "text": "از اینکه داشته باشین این پولی ازتون میگیرن"
    },
    {
      "id": 3,
      "start": 2763.0,
      "end": 2767.0,
      "formatted_start": "00:46:03.000",
      "formatted_end": "00:46:07.000",
      "text": "همین یادگار امام ایمیری دیگه ویسه گم"
    },
    {
      "id": 4,
      "start": 2767.0,
      "end": 2769.0,
      "formatted_start": "00:46:07.000",
      "formatted_end": "00:46:09.000",
      "text": "همه جایی مدار پول میگیرن"
    },
    {
      "id": 5,
      "start": 2769.0,
      "end": 2772.0,
      "formatted_start": "00:46:09.000",
      "formatted_end": "00:46:12.000",
      "text": "باشه؟ نه"
    },
    {
      "id": 6,
      "start": 2772.0,
      "end": 2776.0,
      "formatted_start": "00:46:12.000",
      "formatted_end": "00:46:16.000",
      "text": "نه نه نگرم نه نه"
    },
    {
      "id": 7,
      "start": 2776.0,
      "end": 2779.0,
      "formatted_start": "00:46:16.000",
      "formatted_end": "00:46:19.000",
      "text": "باشه خدا باشه باشه خدا نخوره"
    },
    {
      "id": 8,
      "start": 2779.0,
      "end": 2781.0,
      "formatted_start": "00:46:19.000",
      "formatted_end": "00:46:21.000",
      "text": "بعده؟"
    },
    {
      "id": 9,
      "start": 2781.0,
      "end": 2784.0,
      "formatted_start": "00:46:21.000",
      "formatted_end": "00:46:24.000",
      "text": "مرسی با چکرم"
    },
    {
      "id": 10,
      "start": 2784.0,
      "end": 2796.0,
      "formatted_start": "00:46:24.000",
      "formatted_end": "00:46:36.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 2814.0,
      "end": 2816.0,
      "formatted_start": "00:46:54.000",
      "formatted_end": "00:46:56.000",
      "text": "بله؟"
    },
    {
      "id": 12,
      "start": 2821.0,
      "end": 2826.0,
      "formatted_start": "00:47:01.000",
      "formatted_end": "00:47:06.000",
      "text": "اون ورگر از دفتر افزاوتا بگیری بیا اینجا خامدوتو فانیش چی نمیده؟"
    },
    {
      "id": 13,
      "start": 2828.0,
      "end": 2831.0,
      "formatted_start": "00:47:08.000",
      "formatted_end": "00:47:11.000",
      "text": "آره دیگه یه آزمایش هست، قرار دیگه یه آزمایش جدید"
    },
    {
      "id": 14,
      "start": 2834.0,
      "end": 2838.0,
      "formatted_start": "00:47:14.000",
      "formatted_end": "00:47:18.000",
      "text": "قرار دیگه سه ماه پیر، آخرین بار کجا آزمایش دادی؟"
    },
    {
      "id": 15,
      "start": 2838.0,
      "end": 2846.0,
      "formatted_start": "00:47:18.000",
      "formatted_end": "00:47:26.000",
      "text": "برو گمبت با گمبت همه آزمایشگاه گردی برو این آزمایشگاه از 3-4 ماه پیش منو پرینج بیده"
    },
    {
      "id": 16,
      "start": 2846.0,
      "end": 2857.0,
      "formatted_start": "00:47:26.000",
      "formatted_end": "00:47:37.000",
      "text": "آره بابا پردیس صفتی؟ برو پردیس بیش خانم جورجانی برو شفایی سلام زیاد رسانده"
    },
    {
      "id": 17,
      "start": 2857.0,
      "end": 2861.0,
      "formatted_start": "00:47:37.000",
      "formatted_end": "00:47:41.000",
      "text": "گفتی که پرینج از آزمایشگاه 3-4 ماه پیش هم داره"
    },
    {
      "id": 18,
      "start": 2861.0,
      "end": 2870.0,
      "formatted_start": "00:47:41.000",
      "formatted_end": "00:47:50.000",
      "text": "اشکال ندارد. یعنی ثابت بشه که شما یک سال پیش دو سال پیش هم دیابرد بشید. هیچ موردی ندارد."
    },
    {
      "id": 19,
      "start": 2870.0,
      "end": 2873.0,
      "formatted_start": "00:47:50.000",
      "formatted_end": "00:47:53.000",
      "text": "قربان شما خواهش بکنم خودت."
    },
    {
      "id": 20,
      "start": 2873.0,
      "end": 2875.0,
      "formatted_start": "00:47:53.000",
      "formatted_end": "00:47:55.000",
      "text": "این اشکال کنم."
    },
    {
      "id": 21,
      "start": 2875.0,
      "end": 2877.0,
      "formatted_start": "00:47:55.000",
      "formatted_end": "00:47:57.000",
      "text": "این اشکال کنم."
    },
    {
      "id": 22,
      "start": 2877.0,
      "end": 2879.0,
      "formatted_start": "00:47:57.000",
      "formatted_end": "00:47:59.000",
      "text": "این اشکال کنم."
    },
    {
      "id": 23,
      "start": 2879.0,
      "end": 2881.0,
      "formatted_start": "00:47:59.000",
      "formatted_end": "00:48:01.000",
      "text": "این اشکال کنم."
    },
    {
      "id": 24,
      "start": 2881.0,
      "end": 2883.0,
      "formatted_start": "00:48:01.000",
      "formatted_end": "00:48:03.000",
      "text": "چسانچگاه دارد؟"
    },
    {
      "id": 25,
      "start": 2883.0,
      "end": 2885.0,
      "formatted_start": "00:48:03.000",
      "formatted_end": "00:48:05.000",
      "text": "چسانچگاه دارد؟"
    },
    {
      "id": 26,
      "start": 2885.0,
      "end": 2887.0,
      "formatted_start": "00:48:05.000",
      "formatted_end": "00:48:07.000",
      "text": "نه بله شما."
    },
    {
      "id": 27,
      "start": 2887.0,
      "end": 2889.0,
      "formatted_start": "00:48:07.000",
      "formatted_end": "00:48:09.000",
      "text": "نه دارد. همین یکی دارد."
    },
    {
      "id": 28,
      "start": 2889.0,
      "end": 2917.0,
      "formatted_start": "00:48:09.000",
      "formatted_end": "00:48:37.000",
      "text": "موسیقی"
    },
    {
      "id": 29,
