      "id": 17,
      "start": 12934.0,
      "end": 12936.0,
      "formatted_start": "03:35:34.000",
      "formatted_end": "03:35:36.000",
      "text": "آبکسابان"
    },
    {
      "id": 18,
      "start": 12936.0,
      "end": 12939.0,
      "formatted_start": "03:35:36.000",
      "formatted_end": "03:35:39.000",
      "text": "آبکسابان دومونیم اینو بگیر"
    },
    {
      "id": 19,
      "start": 12939.0,
      "end": 12941.0,
      "formatted_start": "03:35:39.000",
      "formatted_end": "03:35:41.000",
      "text": "داره مهمشونه"
    },
    {
      "id": 20,
      "start": 12942.0,
      "end": 12944.0,
      "formatted_start": "03:35:42.000",
      "formatted_end": "03:35:44.000",
      "text": "بعدی گوست نفخ جویدنی مال"
    },
    {
      "id": 21,
      "start": 12944.0,
      "end": 12946.0,
      "formatted_start": "03:35:44.000",
      "formatted_end": "03:35:46.000",
      "text": "نفخ مده چربی"
    },
    {
      "id": 22,
      "start": 12948.0,
      "end": 12951.0,
      "formatted_start": "03:35:48.000",
      "formatted_end": "03:35:51.000",
      "text": "اینه ها رو ندادن تو نسخشونه شو"
    },
    {
      "id": 23,
      "start": 12951.0,
      "end": 12953.0,
      "formatted_start": "03:35:51.000",
      "formatted_end": "03:35:53.000",
      "text": "بگیر بگیر، بگیر بگیر"
    },
    {
      "id": 24,
      "start": 12953.0,
      "end": 12955.0,
      "formatted_start": "03:35:53.000",
      "formatted_end": "03:35:55.000",
      "text": "الان من ده قلم دارو برای ماما نوشتم"
    },
    {
      "id": 25,
      "start": 12955.0,
      "end": 12957.0,
      "formatted_start": "03:35:55.000",
      "formatted_end": "03:35:57.000",
      "text": "و ترامکوپیلشو بیندادن"
    },
    {
      "id": 26,
      "start": 12957.0,
      "end": 12959.0,
      "formatted_start": "03:35:57.000",
      "formatted_end": "03:35:59.000",
      "text": "سنتا نوشتم"
    },
    {
      "id": 27,
      "start": 12959.0,
      "end": 12961.0,
      "formatted_start": "03:35:59.000",
      "formatted_end": "03:36:01.000",
      "text": "آبکسابانشم"
    },
    {
      "id": 28,
      "start": 12961.0,
      "end": 12963.0,
      "formatted_start": "03:36:01.000",
      "formatted_end": "03:36:03.000",
      "text": "همینطوری نوت تا اینو جواستی تاییم"
    },
    {
      "id": 29,
      "start": 12963.0,
      "end": 12965.0,
      "formatted_start": "03:36:03.000",
      "formatted_end": "03:36:05.000",
      "text": "سنتا نوت بکنم"
    },
    {
      "id": 30,
      "start": 12965.0,
      "end": 12967.0,
      "formatted_start": "03:36:05.000",
      "formatted_end": "03:36:07.000",
      "text": "و باید باهم ترامکوپیلشم"
    },
    {
      "id": 31,
      "start": 12969.0,
      "end": 12971.0,
      "formatted_start": "03:36:09.000",
      "formatted_end": "03:36:11.000",
      "text": "چرا بگیرم؟"
    },
    {
      "id": 32,
      "start": 12971.0,
      "end": 12973.0,
      "formatted_start": "03:36:11.000",
      "formatted_end": "03:36:13.000",
      "text": "هر چون نداد، هر کن نداد بگو"
    },
    {
      "id": 33,
      "start": 12973.0,
      "end": 12975.0,
      "formatted_start": "03:36:13.000",
      "formatted_end": "03:36:15.000",
      "text": "برام ازشو بگیرس که من بدونم که مثلا"
    },
    {
      "id": 34,
      "start": 12975.0,
      "end": 12977.0,
      "formatted_start": "03:36:15.000",
      "formatted_end": "03:36:17.000",
      "text": "باشه که چی؟"
    },
    {
      "id": 35,
      "start": 12977.0,
      "end": 12979.0,
      "formatted_start": "03:36:17.000",
      "formatted_end": "03:36:19.000",
      "text": "برات اینم میخواسته ماما"
    },
    {
      "id": 36,
      "start": 12979.0,
      "end": 12983.0,
      "formatted_start": "03:36:19.000",
      "formatted_end": "03:36:23.000",
      "text": "اینجا همه چیز داشته بردارید."
    },
    {
      "id": 37,
      "start": 12983.0,
      "end": 12987.0,
      "formatted_start": "03:36:23.000",
      "formatted_end": "03:36:27.000",
      "text": "این برش چی برشید؟"
    },
    {
      "id": 38,
      "start": 12991.0,
      "end": 12993.0,
      "formatted_start": "03:36:31.000",
      "formatted_end": "03:36:33.000",
      "text": "اینها رو فکر کنم برود کنه ندارید؟"
    },
    {
      "id": 39,
      "start": 12993.0,
      "end": 12995.0,
      "formatted_start": "03:36:33.000",
      "formatted_end": "03:36:35.000",
      "text": "استقلابه خیلی گرمون میشه."
    },
    {
      "id": 40,
      "start": 12995.0,
      "end": 12997.0,
      "formatted_start": "03:36:35.000",
      "formatted_end": "03:36:37.000",
      "text": "من شست سال میشتم."
    },
    {
      "id": 41,
      "start": 12997.0,
      "end": 12998.0,
      "formatted_start": "03:36:37.000",
      "formatted_end": "03:36:38.000",
      "text": "چون خیلی گرمون."
    },
    {
      "id": 42,
      "start": 12998.0,
      "end": 12999.0,
      "formatted_start": "03:36:38.000",
      "formatted_end": "03:36:39.000",
      "text": "پس برای چیه؟"
    },
    {
      "id": 43,
      "start": 12999.0,
      "end": 13002.0,
      "formatted_start": "03:36:39.000",
      "formatted_end": "03:36:42.000",
      "text": "مانا استقلابه سرس و اصابه شو شباب میخونه."
    },
    {
      "id": 44,
      "start": 13002.0,
      "end": 13005.0,
      "formatted_start": "03:36:42.000",
      "formatted_end": "03:36:45.000",
      "text": "ترمکوپی در مرسل شب میخوانه؟"
    },
    {
      "id": 45,
      "start": 13005.0,
      "end": 13008.0,
      "formatted_start": "03:36:45.000",
      "formatted_end": "03:36:48.000",
      "text": "ترمکوپی میخوانه این اصابه شو شباب میخوانه."
    },
    {
      "id": 46,
      "start": 13008.0,
      "end": 13038.0,
      "formatted_start": "03:36:48.000",
      "formatted_end": "03:37:18.000",
      "text": "اینجوری اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه این"
    },
    {
      "id": 47,
      "start": 13038.0,
      "end": 13040.0,
      "formatted_start": "03:37:18.000",
      "formatted_end": "03:37:20.000",
      "text": "خودم را میگیرد"
    },
    {
      "id": 48,
      "start": 13040.0,
      "end": 13042.0,
      "formatted_start": "03:37:20.000",
      "formatted_end": "03:37:22.000",
      "text": "بله برخشی"
    },
    {
      "id": 49,
      "start": 13042.0,
      "end": 13044.0,
      "formatted_start": "03:37:22.000",
      "formatted_end": "03:37:24.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 50,
      "start": 13044.0,
      "end": 13046.0,
      "formatted_start": "03:37:24.000",
      "formatted_end": "03:37:26.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 51,
      "start": 13046.0,
      "end": 13048.0,
      "formatted_start": "03:37:26.000",
      "formatted_end": "03:37:28.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 52,
      "start": 13048.0,
      "end": 13050.0,
      "formatted_start": "03:37:28.000",
      "formatted_end": "03:37:30.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 53,
      "start": 13050.0,
      "end": 13052.0,
      "formatted_start": "03:37:30.000",
      "formatted_end": "03:37:32.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 54,
      "start": 13052.0,
      "end": 13054.0,
      "formatted_start": "03:37:32.000",
      "formatted_end": "03:37:34.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 55,
      "start": 13054.0,
      "end": 13056.0,
      "formatted_start": "03:37:34.000",
      "formatted_end": "03:37:36.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 56,
      "start": 13056.0,
      "end": 13058.0,
      "formatted_start": "03:37:36.000",
      "formatted_end": "03:37:38.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 57,
      "start": 13058.0,
      "end": 13060.0,
      "formatted_start": "03:37:38.000",
      "formatted_end": "03:37:40.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 58,
      "start": 13060.0,
      "end": 13062.0,
      "formatted_start": "03:37:40.000",
      "formatted_end": "03:37:42.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 59,
      "start": 13062.0,
      "end": 13064.0,
      "formatted_start": "03:37:42.000",
      "formatted_end": "03:37:44.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 60,
      "start": 13064.0,
      "end": 13066.0,
      "formatted_start": "03:37:44.000",
      "formatted_end": "03:37:46.000",
      "text": "بسانه او که نصف آخری"
    },
    {
      "id": 61,
      "start": 13066.0,
      "end": 13068.0,
      "formatted_start": "03:37:46.000",
      "formatted_end": "03:37:48.000",
      "text": "از اینکه این روز حسابی نداریم"
    },
    {
      "id": 62,
      "start": 13068.0,
      "end": 13070.0,
      "formatted_start": "03:37:48.000",
      "formatted_end": "03:37:50.000",
      "text": "چربیتون هم بالاست"
    },
    {
      "id": 63,
      "start": 13070.0,
      "end": 13072.0,
      "formatted_start": "03:37:50.000",
      "formatted_end": "03:37:52.000",
      "text": "کلن واقعا باید از غذا تونو حس بارید"
    },
    {
      "id": 64,
      "start": 13072.0,
      "end": 13074.0,
      "formatted_start": "03:37:52.000",
      "formatted_end": "03:37:54.000",
      "text": "چربیتون هم داره؟"
    },
    {
      "id": 65,
      "start": 13074.0,
      "end": 13076.0,
      "formatted_start": "03:37:54.000",
      "formatted_end": "03:37:56.000",
      "text": "آره بله"
    },
    {
      "id": 66,
      "start": 13076.0,
      "end": 13078.0,
      "formatted_start": "03:37:56.000",
      "formatted_end": "03:37:58.000",
      "text": "دارو لازم نداره برای جیب"
    },
    {
      "id": 67,
      "start": 13078.0,
      "end": 13080.0,
      "formatted_start": "03:37:58.000",
      "formatted_end": "03:38:00.000",
      "text": "پیاده در بی سرخ کردن"
    },
    {
      "id": 68,
      "start": 13080.0,
      "end": 13082.0,
      "formatted_start": "03:38:00.000",
      "formatted_end": "03:38:02.000",
      "text": "یا همه آفرز باشه"
    },
    {
      "id": 69,
      "start": 13082.0,
      "end": 13084.0,
      "formatted_start": "03:38:02.000",
      "formatted_end": "03:38:04.000",
      "text": "بعد قند چربیتون نداره"
    },
    {
      "id": 70,
      "start": 13084.0,
      "end": 13086.0,
      "formatted_start": "03:38:04.000",
      "formatted_end": "03:38:06.000",
      "text": "قندتون رو نشد و نرمه ارزه"
    },
    {
      "id": 71,
      "start": 13086.0,
      "end": 13088.0,
      "formatted_start": "03:38:06.000",
      "formatted_end": "03:38:08.000",
      "text": "من خصوصا"
    },
    {
      "id": 72,
      "start": 13088.0,
      "end": 13090.0,
      "formatted_start": "03:38:08.000",
      "formatted_end": "03:38:10.000",
      "text": "در چند سال همه چیز میخورم"
    },
    {
      "id": 73,
      "start": 13090.0,
      "end": 13092.0,
      "formatted_start": "03:38:10.000",
      "formatted_end": "03:38:12.000",
      "text": "کامپاکو میخورم"
    },
    {
      "id": 74,
      "start": 13092.0,
      "end": 13094.0,
      "formatted_start": "03:38:12.000",
      "formatted_end": "03:38:14.000",
      "text": "حس رایت کردن"
    },
    {
      "id": 75,
      "start": 13094.0,
      "end": 13096.0,
      "formatted_start": "03:38:14.000",
      "formatted_end": "03:38:16.000",
      "text": "این کسی چشم برسه در زمین میگیز"
    },
    {
      "id": 76,
      "start": 13096.0,
      "end": 13098.0,
      "formatted_start": "03:38:16.000",
      "formatted_end": "03:38:18.000",
      "text": "این خانمه خانه"
    },
    {
      "id": 77,
      "start": 13098.0,
      "end": 13100.0,
      "formatted_start": "03:38:18.000",
      "formatted_end": "03:38:20.000",
      "text": "گلگیش"
    },
    {
      "id": 78,
      "start": 13100.0,
      "end": 13106.0,
      "formatted_start": "03:38:20.000",
      "formatted_end": "03:38:26.000",
      "text": "خانم رو تو باباش که یه درموز آده داره برای این ها رو برام بشین"
    },
    {
      "id": 79,
      "start": 13106.0,
      "end": 13108.0,
      "formatted_start": "03:38:26.000",
      "formatted_end": "03:38:28.000",
      "text": "نباشه برام بشین"
    },
    {
      "id": 80,
      "start": 13108.0,
      "end": 13110.0,
      "formatted_start": "03:38:28.000",
      "formatted_end": "03:38:30.000",
      "text": "اون کسی بیمیشه"
    },
    {
      "id": 81,
      "start": 13110.0,
      "end": 13112.0,
      "formatted_start": "03:38:30.000",
      "formatted_end": "03:38:32.000",
      "text": "هرنگ بیمیشه متخصص هم داریم"
    },
    {
      "id": 82,
      "start": 13112.0,
      "end": 13114.0,
      "formatted_start": "03:38:32.000",
      "formatted_end": "03:38:34.000",
      "text": "اون کس برام نوشتی؟ نوشتی به اختلاقی داره؟"
    },
    {
      "id": 83,
      "start": 13114.0,
      "end": 13116.0,
      "formatted_start": "03:38:34.000",
      "formatted_end": "03:38:36.000",
      "text": "مایه داره؟"
    },
    {
      "id": 84,
      "start": 13116.0,
      "end": 13118.0,
      "formatted_start": "03:38:36.000",
      "formatted_end": "03:38:38.000",
      "text": "نه، تو آزمایشان"
    },
    {
      "id": 85,
      "start": 13118.0,
      "end": 13120.0,
      "formatted_start": "03:38:38.000",
      "formatted_end": "03:38:40.000",
      "text": "آزمایش تو آزمایش که کس برام شد"
    },
    {
      "id": 86,
      "start": 13120.0,
      "end": 13122.0,
      "formatted_start": "03:38:40.000",
      "formatted_end": "03:38:42.000",
      "text": "نه، کس برام نمیشه"
    },
    {
      "id": 87,
      "start": 13122.0,
      "end": 13126.0,
      "formatted_start": "03:38:42.000",
      "formatted_end": "03:38:46.000",
      "text": "اینجا کنه نمیشه که اونجا مردم"
    },
    {
      "id": 88,
      "start": 13134.0,
      "end": 13138.0,
      "formatted_start": "03:38:54.000",
      "formatted_end": "03:38:58.000",
      "text": "آهان بخواد انگل دارو میخونیم؟"
    },
    {
      "id": 89,
      "start": 13138.0,
      "end": 13140.0,
      "formatted_start": "03:38:58.000",
      "formatted_end": "03:39:00.000",
      "text": "الان که نه"
    },
    {
      "id": 90,
      "start": 13140.0,
      "end": 13142.0,
      "formatted_start": "03:39:00.000",
      "formatted_end": "03:39:02.000",
      "text": "باید بهتون دارو داری؟"
    },
    {
      "id": 91,
      "start": 13142.0,
      "end": 13144.0,
      "formatted_start": "03:39:02.000",
      "formatted_end": "03:39:04.000",
      "text": "نه"
    },
    {
      "id": 92,
      "start": 13144.0,
      "end": 13146.0,
      "formatted_start": "03:39:04.000",
      "formatted_end": "03:39:06.000",
      "text": "مترونی لازم تا نسخه ماونتونی نیستم دو هفته بخواییم"
    },
    {
      "id": 93,
      "start": 13146.0,
      "end": 13148.0,
      "formatted_start": "03:39:06.000",
      "formatted_end": "03:39:08.000",
      "text": "چه؟"
    },
    {
      "id": 94,
      "start": 13148.0,
      "end": 13150.0,
      "formatted_start": "03:39:08.000",
      "formatted_end": "03:39:10.000",
      "text": "باست مترونی لازم خواهیم"
    },
    {
      "id": 95,
      "start": 13150.0,
      "end": 13152.0,
      "formatted_start": "03:39:10.000",
      "formatted_end": "03:39:12.000",
      "text": "باید شما تا این نظر ماندید"
    },
    {
      "id": 96,
      "start": 13152.0,
      "end": 13154.0,
      "formatted_start": "03:39:12.000",
      "formatted_end": "03:39:14.000",
      "text": "باید شما تا این نظر ماندید"
    },
    {
      "id": 97,
