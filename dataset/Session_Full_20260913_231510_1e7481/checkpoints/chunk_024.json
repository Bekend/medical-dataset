      "formatted_start": "02:00:09.000",
      "formatted_end": "02:00:12.000",
      "text": "سه ماه خوردم، دیگه سه بودش رو نمیخورم."
    },
    {
      "id": 3,
      "start": 7212.0,
      "end": 7214.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:14.000",
      "text": "چون درد میزد به مقدم دیگه."
    },
    {
      "id": 4,
      "start": 7214.0,
      "end": 7217.0,
      "formatted_start": "02:00:14.000",
      "formatted_end": "02:00:17.000",
      "text": "ما چند ماه در گیرش بودیم، دیگه."
    },
    {
      "id": 5,
      "start": 7217.0,
      "end": 7219.0,
      "formatted_start": "02:00:17.000",
      "formatted_end": "02:00:19.000",
      "text": "آدمتریوز متاسفه نه؟"
    },
    {
      "id": 6,
      "start": 7221.0,
      "end": 7222.0,
      "formatted_start": "02:00:21.000",
      "formatted_end": "02:00:22.000",
      "text": "مجردی نه؟"
    },
    {
      "id": 7,
      "start": 7222.0,
      "end": 7223.0,
      "formatted_start": "02:00:22.000",
      "formatted_end": "02:00:23.000",
      "text": "بله."
    },
    {
      "id": 8,
      "start": 7223.0,
      "end": 7228.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:28.000",
      "text": "میگن که توی خانمهایی که بچه نمیارن، ریزکش بلا میره."
    },
    {
      "id": 9,
      "start": 7230.0,
      "end": 7233.0,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:33.000",
      "text": "بچه داره اینو از آن رو از بستان بگیره"
    },
    {
      "id": 10,
      "start": 7234.0,
      "end": 7236.0,
      "formatted_start": "02:00:34.000",
      "formatted_end": "02:00:36.000",
      "text": "شاید اون رو خواستیم"
    },
    {
      "id": 11,
      "start": 7239.0,
      "end": 7242.0,
      "formatted_start": "02:00:39.000",
      "formatted_end": "02:00:42.000",
      "text": "خوانده که یه آزمانش رو یه سانو هم نیبسی"
    },
    {
      "id": 12,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "تو ما یک سال پیچ رفتن"
    },
    {
      "id": 13,
      "start": 7244.0,
      "end": 7245.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:45.000",
      "text": "باشه"
    },
    {
      "id": 14,
      "start": 7246.0,
      "end": 7248.0,
      "formatted_start": "02:00:46.000",
      "formatted_end": "02:00:48.000",
      "text": "باید بزنم باشیم"
    },
    {
      "id": 15,
      "start": 7251.0,
      "end": 7253.0,
      "formatted_start": "02:00:51.000",
      "formatted_end": "02:00:53.000",
      "text": "مترول چقدر میخوری؟"
    },
    {
      "id": 16,
      "start": 7253.0,
      "end": 7256.0,
      "formatted_start": "02:00:53.000",
      "formatted_end": "02:00:56.000",
      "text": "پنجاه، نصف شفت، نصف همسه"
    },
    {
      "id": 17,
      "start": 7260.0,
      "end": 7288.0,
      "formatted_start": "02:01:00.000",
      "formatted_end": "02:01:28.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 7288.0,
      "end": 7290.0,
      "formatted_start": "02:01:28.000",
      "formatted_end": "02:01:30.000",
      "text": "بعد تو چشمه"
    },
    {
      "id": 19,
      "start": 7290.0,
      "end": 7292.0,
      "formatted_start": "02:01:30.000",
      "formatted_end": "02:01:32.000",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 7292.0,
      "end": 7294.0,
      "formatted_start": "02:01:32.000",
      "formatted_end": "02:01:34.000",
      "text": "زیاد برزی چشم تا خونه میکنه"
    },
    {
      "id": 21,
      "start": 7294.0,
      "end": 7296.0,
      "formatted_start": "02:01:34.000",
      "formatted_end": "02:01:36.000",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 7296.0,
      "end": 7298.0,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:38.000",
      "text": "من چی میریم زنی بهتون میکنم؟"
    },
    {
      "id": 23,
      "start": 7298.0,
      "end": 7300.0,
      "formatted_start": "02:01:38.000",
      "formatted_end": "02:01:40.000",
      "text": "چشم خیلی خارش میکنه"
    },
    {
      "id": 24,
      "start": 7300.0,
      "end": 7302.0,
      "formatted_start": "02:01:40.000",
      "formatted_end": "02:01:42.000",
      "text": "خب از اون برات"
    },
    {
      "id": 25,
      "start": 7302.0,
      "end": 7304.0,
      "formatted_start": "02:01:42.000",
      "formatted_end": "02:01:44.000",
      "text": "بعد گوشم هم هزفار"
    },
    {
      "id": 26,
      "start": 7304.0,
      "end": 7306.0,
      "formatted_start": "02:01:44.000",
      "formatted_end": "02:01:46.000",
      "text": "بشنام برای گوشم هستم"
    },
    {
      "id": 27,
      "start": 7306.0,
      "end": 7308.0,
      "formatted_start": "02:01:46.000",
      "formatted_end": "02:01:48.000",
      "text": "چون میدونی که کارتونه همونجا که خوبه"
    },
    {
      "id": 28,
      "start": 7308.0,
      "end": 7310.0,
      "formatted_start": "02:01:48.000",
      "formatted_end": "02:01:50.000",
      "text": "باز از اون برات چشم میکنه"
    },
    {
      "id": 29,
      "start": 7310.0,
      "end": 7312.0,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:52.000",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 7312.0,
      "end": 7314.0,
      "formatted_start": "02:01:52.000",
      "formatted_end": "02:01:54.000",
      "text": "مستعد قاش میگن"
    },
    {
      "id": 31,
      "start": 7314.0,
      "end": 7316.0,
      "formatted_start": "02:01:54.000",
      "formatted_end": "02:01:56.000",
      "text": "الان خیلی گوشم میخانه"
    },
    {
      "id": 32,
      "start": 7316.0,
      "end": 7319.0,
      "formatted_start": "02:01:56.000",
      "formatted_end": "02:01:59.000",
      "text": "بعد چکلاف هم برات بزنم و بعد سوم هم برات بزنیم"
    },
    {
      "id": 33,
      "start": 7319.0,
      "end": 7322.0,
      "formatted_start": "02:01:59.000",
      "formatted_end": "02:02:02.000",
      "text": "مارو بابا چیه؟ برات گلچین؟"
    },
    {
      "id": 34,
      "start": 7322.0,
      "end": 7324.0,
      "formatted_start": "02:02:02.000",
      "formatted_end": "02:02:04.000",
      "text": "آره زده گفت فقط چی کن بخون"
    },
    {
      "id": 35,
      "start": 7324.0,
      "end": 7328.0,
      "formatted_start": "02:02:04.000",
      "formatted_end": "02:02:08.000",
      "text": "گفت آسوویکسشو نمیدن نمیدونم"
    },
    {
      "id": 36,
      "start": 7328.0,
      "end": 7332.0,
      "formatted_start": "02:02:08.000",
      "formatted_end": "02:02:12.000",
      "text": "من ماه قرد که نمیدونم ماه برات چهار اومدم یه برات بزنیم"
    },
    {
      "id": 37,
      "start": 7332.0,
      "end": 7334.0,
      "formatted_start": "02:02:12.000",
      "formatted_end": "02:02:14.000",
      "text": "پاژو شبها چقدر میزنه؟"
    },
    {
      "id": 38,
      "start": 7334.0,
      "end": 7336.0,
      "formatted_start": "02:02:14.000",
      "formatted_end": "02:02:16.000",
      "text": "سی و پنج"
    },
    {
      "id": 39,
      "start": 7336.0,
      "end": 7338.0,
      "formatted_start": "02:02:16.000",
      "formatted_end": "02:02:18.000",
      "text": "ترایتیس چقدر میخوره؟"
    },
    {
      "id": 40,
      "start": 7338.0,
      "end": 7341.0,
      "formatted_start": "02:02:18.000",
      "formatted_end": "02:02:21.000",
      "text": "ترایتیس فرده نصف گردید شما"
    },
    {
      "id": 41,
      "start": 7341.0,
      "end": 7343.0,
      "formatted_start": "02:02:21.000",
      "formatted_end": "02:02:23.000",
      "text": "یعنی نصف صبح نصف شب"
    },
    {
      "id": 42,
      "start": 7343.0,
      "end": 7345.0,
      "formatted_start": "02:02:23.000",
      "formatted_end": "02:02:25.000",
      "text": "شبشو کامل کن"
    },
    {
      "id": 43,
      "start": 7345.0,
      "end": 7349.0,
      "formatted_start": "02:02:25.000",
      "formatted_end": "02:02:29.000",
      "text": "خیلی بابا قصد میگو یه روز صبح دیگه صبح بیست بود"
    },
    {
      "id": 44,
      "start": 7349.0,
      "end": 7353.0,
      "formatted_start": "02:02:29.000",
      "formatted_end": "02:02:33.000",
      "text": "الان خانده پیر دیروز رفته بود بیرون افتاده"
    },
    {
      "id": 45,
      "start": 7353.0,
      "end": 7355.0,
      "formatted_start": "02:02:33.000",
      "formatted_end": "02:02:35.000",
      "text": "بعد میگم که بابا چرا افتاده؟"
    },
    {
      "id": 46,
      "start": 7355.0,
      "end": 7357.0,
      "formatted_start": "02:02:35.000",
      "formatted_end": "02:02:37.000",
      "text": "دیگه هار خورد خورد خورد رفت بیرون"
    },
    {
      "id": 47,
      "start": 7357.0,
      "end": 7360.0,
      "formatted_start": "02:02:37.000",
      "formatted_end": "02:02:40.000",
      "text": "بعد میگه که سرگیجه داشتم"
    },
    {
      "id": 48,
      "start": 7360.0,
      "end": 7364.0,
      "formatted_start": "02:02:40.000",
      "formatted_end": "02:02:44.000",
      "text": "بعد افتاده الان بخوش نگاه کن من اینو چی بزنم؟"
    },
    {
      "id": 49,
      "start": 7364.0,
      "end": 7368.0,
      "formatted_start": "02:02:44.000",
      "formatted_end": "02:02:48.000",
      "text": "بعد خیلی هم انگاری اصنه چی شده؟"
    },
    {
      "id": 50,
      "start": 7368.0,
      "end": 7370.0,
      "formatted_start": "02:02:48.000",
      "formatted_end": "02:02:50.000",
      "text": "آه، قید چی شده"
    },
    {
      "id": 51,
      "start": 7370.0,
      "end": 7375.0,
      "formatted_start": "02:02:50.000",
      "formatted_end": "02:02:55.000",
      "text": "برام برام بگو که بابا افتاده نمیده که"
    },
    {
      "id": 52,
      "start": 7375.0,
      "end": 7377.0,
      "formatted_start": "02:02:55.000",
      "formatted_end": "02:02:57.000",
      "text": "داده دیگه"
    },
    {
      "id": 53,
      "start": 7377.0,
      "end": 7379.0,
      "formatted_start": "02:02:57.000",
      "formatted_end": "02:02:59.000",
      "text": "خب نه گرفتین که ببینین"
    },
    {
      "id": 54,
      "start": 7379.0,
      "end": 7381.0,
      "formatted_start": "02:02:59.000",
      "formatted_end": "02:03:01.000",
      "text": "آره"
    },
    {
      "id": 55,
      "start": 7381.0,
      "end": 7383.0,
      "formatted_start": "02:03:01.000",
      "formatted_end": "02:03:03.000",
      "text": "روز جامعه بود"
    },
    {
      "id": 56,
      "start": 7383.0,
      "end": 7385.0,
      "formatted_start": "02:03:03.000",
      "formatted_end": "02:03:05.000",
      "text": "روز جامعه این لباسش خیسته عرب"
    },
    {
      "id": 57,
      "start": 7385.0,
      "end": 7387.0,
      "formatted_start": "02:03:05.000",
      "formatted_end": "02:03:07.000",
      "text": "کلیکلازیدو که میخوره بابا؟"
    },
    {
      "id": 58,
      "start": 7387.0,
      "end": 7389.0,
      "formatted_start": "02:03:07.000",
      "formatted_end": "02:03:09.000",
      "text": "کلیکلازیدو نصفی که من خودم بهش میدم"
    },
    {
      "id": 59,
      "start": 7389.0,
      "end": 7391.0,
      "formatted_start": "02:03:09.000",
      "formatted_end": "02:03:11.000",
      "text": "سپن قبل صبحانه"
    },
    {
      "id": 60,
      "start": 7391.0,
      "end": 7393.0,
      "formatted_start": "02:03:11.000",
      "formatted_end": "02:03:13.000",
      "text": "بعد یکی هم نصفم قبل شما بهش میدم"
    },
    {
      "id": 61,
      "start": 7395.0,
      "end": 7397.0,
      "formatted_start": "02:03:15.000",
      "formatted_end": "02:03:17.000",
      "text": "خب نصفت قبل صبحانه شو حضر کن"
    },
    {
      "id": 62,
      "start": 7397.0,
      "end": 7399.0,
      "formatted_start": "02:03:17.000",
      "formatted_end": "02:03:19.000",
      "text": "اینجوری که این همه غرس میخوره"
    },
    {
      "id": 63,
      "start": 7399.0,
      "end": 7401.0,
      "formatted_start": "02:03:19.000",
      "formatted_end": "02:03:21.000",
      "text": "باید رشتهش بارست که"
    },
    {
      "id": 64,
      "start": 7401.0,
      "end": 7403.0,
      "formatted_start": "02:03:21.000",
      "formatted_end": "02:03:23.000",
      "text": "شب نوم زیاد میخوره"
    },
    {
      "id": 65,
      "start": 7403.0,
      "end": 7406.0,
      "formatted_start": "02:03:23.000",
      "formatted_end": "02:03:26.000",
      "text": "نه الان که نون بهش من خیلی برم برم"
    },
    {
      "id": 66,
      "start": 7406.0,
      "end": 7407.0,
      "formatted_start": "02:03:26.000",
      "formatted_end": "02:03:27.000",
      "text": "خودتون با بده؟"
    },
    {
      "id": 67,
      "start": 7407.0,
      "end": 7408.0,
      "formatted_start": "02:03:27.000",
      "formatted_end": "02:03:28.000",
      "text": "بله"
    },
    {
      "id": 68,
      "start": 7408.0,
      "end": 7411.0,
      "formatted_start": "02:03:28.000",
      "formatted_end": "02:03:31.000",
      "text": "یه بر بیار بستریش کن و همه داشتو تنظیم کنیم با انسانی"
    },
    {
      "id": 69,
      "start": 7411.0,
      "end": 7412.0,
      "formatted_start": "02:03:31.000",
      "formatted_end": "02:03:32.000",
      "text": "میتونی؟"
    },
    {
      "id": 70,
      "start": 7412.0,
      "end": 7413.0,
      "formatted_start": "02:03:32.000",
      "formatted_end": "02:03:33.000",
      "text": "آره"
    },
    {
      "id": 71,
      "start": 7413.0,
      "end": 7416.0,
      "formatted_start": "02:03:33.000",
      "formatted_end": "02:03:36.000",
      "text": "خودش میگه که من بسکی راحت ترم"
    },
    {
      "id": 72,
      "start": 7416.0,
      "end": 7418.0,
      "formatted_start": "02:03:36.000",
      "formatted_end": "02:03:38.000",
      "text": "من بسکی نمیتونم برم"
    },
    {
      "id": 73,
      "start": 7418.0,
      "end": 7421.0,
      "formatted_start": "02:03:38.000",
      "formatted_end": "02:03:41.000",
      "text": "چون اصلا کارا هم نمی کنم حالتش بسکی نمیرم"
    },
    {
      "id": 74,
      "start": 7421.0,
      "end": 7423.0,
      "formatted_start": "02:03:41.000",
      "formatted_end": "02:03:43.000",
      "text": "من فقط برزوه میرم"
    },
    {
      "id": 75,
      "start": 7423.0,
      "end": 7424.0,
      "formatted_start": "02:03:43.000",
      "formatted_end": "02:03:44.000",
      "text": "آره برزوه بیارم"
    },
    {
      "id": 76,
      "start": 7424.0,
      "end": 7430.0,
      "formatted_start": "02:03:44.000",
      "formatted_end": "02:03:50.000",
      "text": "اگر یه زمان که شایدتو اوکی بود بیار بابا رو بچه ست کنم"
    },
    {
      "id": 77,
      "start": 7430.0,
      "end": 7432.4,
      "formatted_start": "02:03:50.000",
      "formatted_end": "02:03:52.400",
      "text": "نیاز نیست خاندکتر نامه بیدی"
    },
    {
      "id": 78,
      "start": 7432.4,
      "end": 7433.8,
      "formatted_start": "02:03:52.400",
      "formatted_end": "02:03:53.800",
      "text": "چرا دیگه همه هم میگرد"
    },
    {
      "id": 79,
      "start": 7433.8,
      "end": 7435.76,
      "formatted_start": "02:03:53.800",
      "formatted_end": "02:03:55.760",
      "text": "خودت که قرن نداشتی نه؟"
    },
    {
      "id": 80,
      "start": 7435.76,
      "end": 7436.8,
      "formatted_start": "02:03:55.760",
      "formatted_end": "02:03:56.800",
      "text": "نه نه نداشتی"
    },
    {
      "id": 81,
      "start": 7436.8,
      "end": 7438.4,
      "formatted_start": "02:03:56.800",
      "formatted_end": "02:03:58.400",
      "text": "چون میخوام چپاوتو سرخونه"
    },
    {
      "id": 82,
      "start": 7438.4,
      "end": 7441.8,
      "formatted_start": "02:03:58.400",
      "formatted_end": "02:04:01.800",
      "text": "یه هفته دیگه مثلا بید نامه بگیر"
    },
    {
      "id": 83,
      "start": 7441.8,
      "end": 7443.94,
      "formatted_start": "02:04:01.800",
      "formatted_end": "02:04:03.940",
      "text": "بعد من بسترش کنم"
    },
    {
      "id": 84,
      "start": 7443.94,
      "end": 7446.54,
      "formatted_start": "02:04:03.940",
      "formatted_end": "02:04:06.540",
      "text": "خب الان اگه بگیرم بر هفته بعد نمیشه"
    },
    {
      "id": 85,
      "start": 7446.54,
      "end": 7447.84,
      "formatted_start": "02:04:06.540",
      "formatted_end": "02:04:07.840",
      "text": "چرا؟"
    },
    {
      "id": 86,
      "start": 7447.84,
      "end": 7449.6,
      "formatted_start": "02:04:07.840",
      "formatted_end": "02:04:09.600",
      "text": "پیگه موبنده باشم چرا؟"
    },
    {
      "id": 87,
      "start": 7450.38,
      "end": 7451.2,
      "formatted_start": "02:04:10.380",
      "formatted_end": "02:04:11.200",
      "text": "کلتو بزنم"
    },
    {
      "id": 88,
      "start": 7451.2,
      "end": 7453.6,
      "formatted_start": "02:04:11.200",
      "formatted_end": "02:04:13.600",
      "text": "نامه میدن چرا؟"
    },
    {
      "id": 89,
      "start": 7455.54,
      "end": 7457.04,
      "formatted_start": "02:04:15.540",
      "formatted_end": "02:04:17.040",
      "text": "میخوام پرساشو قرد کنیم"
    },
    {
      "id": 90,
      "start": 7457.04,
      "end": 7459.04,
      "formatted_start": "02:04:17.040",
      "formatted_end": "02:04:19.040",
      "text": "اگه بشه فقط با انسالین بابارو تنزیم"
    },
    {
      "id": 91,
      "start": 7459.04,
      "end": 7461.04,
      "formatted_start": "02:04:19.040",
      "formatted_end": "02:04:21.040",
      "text": "از آن حالت به قرصان بابر 6"
    },
    {
      "id": 92,
      "start": 7461.04,
      "end": 7463.04,
      "formatted_start": "02:04:21.040",
      "formatted_end": "02:04:23.040",
      "text": "15 روز بسکی بستاریم"
    },
    {
      "id": 93,
      "start": 7463.04,
      "end": 7465.04,
      "formatted_start": "02:04:23.040",
      "formatted_end": "02:04:25.040",
      "text": "قرصان رو کلن"
    },
    {
      "id": 94,
      "start": 7465.04,
      "end": 7467.04,
      "formatted_start": "02:04:25.040",
      "formatted_end": "02:04:27.040",
      "text": "قرص قردان رو قطع کنیم"
    },
    {
      "id": 95,
      "start": 7467.04,
      "end": 7469.04,
      "formatted_start": "02:04:27.040",
      "formatted_end": "02:04:29.040",
      "text": "از شنبه صبح ببر بستاری کن خب؟"
    },
    {
      "id": 96,
      "start": 7469.04,
      "end": 7471.04,
      "formatted_start": "02:04:29.040",
      "formatted_end": "02:04:31.040",
      "text": "شنبه صبح"
    },
    {
      "id": 97,
      "start": 7471.04,
      "end": 7473.04,
      "formatted_start": "02:04:31.040",
      "formatted_end": "02:04:33.040",
      "text": "از جامعه زورت دیگه هیچ قرص قردی نداره بابا"
    },
    {
      "id": 98,
      "start": 7473.04,
      "end": 7475.04,
      "formatted_start": "02:04:33.040",
      "formatted_end": "02:04:35.040",
      "text": "باشه؟"
    },
    {
      "id": 99,
      "start": 7475.04,
      "end": 7477.04,
      "formatted_start": "02:04:35.040",
      "formatted_end": "02:04:37.040",
      "text": "از شنبه ببرم؟ آره"
    },
    {
      "id": 100,
      "start": 7477.04,
      "end": 7479.04,
      "formatted_start": "02:04:37.040",
      "formatted_end": "02:04:39.040",
      "text": "چون بذار از سر قرصتو خون بره بیرون"
    },
    {
      "id": 101,
      "start": 7479.04,
      "end": 7481.04,
      "formatted_start": "02:04:39.040",
      "formatted_end": "02:04:41.040",
      "text": "خب؟ من بگم"
    },
    {
      "id": 102,
      "start": 7481.04,
      "end": 7483.04,
      "formatted_start": "02:04:41.040",
      "formatted_end": "02:04:43.040",
      "text": "سر ماماشو"
    },
    {
      "id": 103,
      "start": 7483.04,
      "end": 7485.04,
      "formatted_start": "02:04:43.040",
      "formatted_end": "02:04:45.040",
      "text": "اینجا باید بردارید"
    },
