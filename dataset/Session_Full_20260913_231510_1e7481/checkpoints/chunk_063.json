  "stt_segments": [
    {
      "id": 0,
      "start": 18900.0,
      "end": 18908.0,
      "formatted_start": "05:15:00.000",
      "formatted_end": "05:15:08.000",
      "text": "سرنامه تابولیکی شما. سرنامه تابولیکی نقص مادرزادی اختلاف چردیه."
    },
    {
      "id": 1,
      "start": 18908.0,
      "end": 18915.0,
      "formatted_start": "05:15:08.000",
      "formatted_end": "05:15:15.000",
      "text": "تو در اینجور در مرض به حال زودست قلیبی هستی. چردیه کنن و دست بازت هستی کنی."
    },
    {
      "id": 2,
      "start": 18915.0,
      "end": 18919.0,
      "formatted_start": "05:15:15.000",
      "formatted_end": "05:15:19.000",
      "text": "این چردیه باید بسیار بد کننده بشه چون ریست کمبالی داره."
    },
    {
      "id": 3,
      "start": 18919.0,
      "end": 18923.0,
      "formatted_start": "05:15:19.000",
      "formatted_end": "05:15:23.000",
      "text": "آره، گفت بهم دکترم. اگه یازمانش از پرمیرون رسائل اصابه نداشت گردیم،"
    },
    {
      "id": 4,
      "start": 18923.0,
      "end": 18926.0,
      "formatted_start": "05:15:23.000",
      "formatted_end": "05:15:26.000",
      "text": "گفتم به پریک نکرد که حتی من برم شوی ارالوجیست."
    },
    {
      "id": 5,
      "start": 18926.0,
      "end": 18956.0,
      "formatted_start": "05:15:26.000",
      "formatted_end": "05:15:56.000",
      "text": "اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا در اولا"
    },
    {
      "id": 6,
      "start": 18956.0,
      "end": 18960.0,
      "formatted_start": "05:15:56.000",
      "formatted_end": "05:16:00.000",
      "text": "تا اصلا بدون این هیچی پک کنی حامله نمیشه، کلن رهان بود"
    },
    {
      "id": 7,
      "start": 18960.0,
      "end": 18965.0,
      "formatted_start": "05:16:00.000",
      "formatted_end": "05:16:05.000",
      "text": "سیستم از اینجوری ما ضعیفه، تو هم میگم تا پولی تقمیلات ضعیف میشه"
    },
    {
      "id": 8,
      "start": 18965.0,
      "end": 18971.0,
      "formatted_start": "05:16:05.000",
      "formatted_end": "05:16:11.000",
      "text": "حالا این رو گفته نمیدونید کلن قبل از دنیا اومدن از توکن من کلن تنبالی تقمیلاتون داشتم"
    },
    {
      "id": 9,
      "start": 18971.0,
      "end": 18974.0,
      "formatted_start": "05:16:11.000",
      "formatted_end": "05:16:14.000",
      "text": "خوب بعد کلن هر چند ماه بریاد میشدم"
    },
    {
      "id": 10,
      "start": 18974.0,
      "end": 18982.0,
      "formatted_start": "05:16:14.000",
      "formatted_end": "05:16:22.000",
      "text": "اما اوقی که دنیا اومده سر وقت، این تا ایمایی تقمه گذاریم، درد زیر شکم دارم، افتزا، این ها رو همه رو دارم"
    },
    {
      "id": 11,
      "start": 18982.0,
      "end": 18985.0,
      "formatted_start": "05:16:22.000",
      "formatted_end": "05:16:25.000",
      "text": "اصلا باروری احتمال باردار تو شدن، این رو بالا میبرن"
    },
    {
      "id": 12,
      "start": 18985.0,
      "end": 18992.0,
      "formatted_start": "05:16:25.000",
      "formatted_end": "05:16:32.000",
      "text": "خودش رو هم گفت به هم، بعد گفت مجدد IVF، گفتم باید نه تو خدا، من وقتی مدرب شما میومدم همین یکی نداشتم"
    },
    {
      "id": 13,
      "start": 18992.0,
      "end": 18997.0,
      "formatted_start": "05:16:32.000",
      "formatted_end": "05:16:37.000",
      "text": "میگفتم اصلا اینایی که میان میگن ما یکی داریم، میگن میره از داری دوباره میریم"
    },
    {
      "id": 14,
      "start": 18997.0,
      "end": 19009.0,
      "formatted_start": "05:16:37.000",
      "formatted_end": "05:16:49.000",
      "text": "این شعبه ای که داروهایی که استفاده میکنید، من آنکولایی که استفاده میکنم مثل بازون و دور ناخونی رو واقعا جایشت میموند کبود میشود ازید میشود"
    },
    {
      "id": 15,
      "start": 19009.0,
      "end": 19013.0,
      "formatted_start": "05:16:49.000",
      "formatted_end": "05:16:53.000",
      "text": "اما هم همین یه دلار دارم دیگه نمیخوام واقعا"
    },
    {
      "id": 16,
      "start": 19013.0,
      "end": 19019.0,
      "formatted_start": "05:16:53.000",
      "formatted_end": "05:16:59.000",
      "text": "بعد الان برم گفت ای بی اف برسم نمیخوام، اگر تبیه شد شد نخود نشد دیگه نخواستم"
    },
    {
      "id": 17,
      "start": 19019.0,
      "end": 19022.0,
      "formatted_start": "05:16:59.000",
      "formatted_end": "05:17:02.000",
      "text": "چونکه ریسک سرطانسی نمیخوام"
    },
    {
      "id": 18,
      "start": 19022.0,
      "end": 19026.0,
      "formatted_start": "05:17:02.000",
      "formatted_end": "05:17:06.000",
      "text": "اصلا فراموش کشیم و من به فرم دام فهم میشم"
    },
    {
      "id": 19,
      "start": 19026.0,
      "end": 19031.0,
      "formatted_start": "05:17:06.000",
      "formatted_end": "05:17:11.000",
      "text": "دارستابرین هر نیز دارو داد اکتیدکسی داد بهش با یه خوشتگیز میشون میبینیم"
    },
    {
      "id": 20,
      "start": 19031.0,
      "end": 19032.0,
      "formatted_start": "05:17:11.000",
      "formatted_end": "05:17:12.000",
      "text": "از اینکه نخواهش دستند"
    },
    {
      "id": 21,
      "start": 19032.0,
      "end": 19036.0,
      "formatted_start": "05:17:12.000",
      "formatted_end": "05:17:16.000",
      "text": "دیگه میشن از سیرزین میگیم پیوتن میگیم، پیوتن سرعت اسپرمان بره باده"
    },
    {
      "id": 22,
      "start": 19036.0,
      "end": 19039.0,
      "formatted_start": "05:17:16.000",
      "formatted_end": "05:17:19.000",
      "text": "این معروض به اینه که واسه خوصت نداشته باشه"
    },
    {
      "id": 23,
      "start": 19039.0,
      "end": 19042.0,
      "formatted_start": "05:17:19.000",
      "formatted_end": "05:17:22.000",
      "text": "اونو باید برداشتون و خوشتگیز برداشتون"
    },
    {
      "id": 24,
      "start": 19042.0,
      "end": 19044.0,
      "formatted_start": "05:17:22.000",
      "formatted_end": "05:17:24.000",
      "text": "پکتر بود"
    },
    {
      "id": 25,
      "start": 19044.0,
      "end": 19046.0,
      "formatted_start": "05:17:24.000",
      "formatted_end": "05:17:26.000",
      "text": "نمیدونی؟ اسپرمان چند بود؟"
    },
    {
      "id": 26,
      "start": 19046.0,
      "end": 19048.0,
      "formatted_start": "05:17:26.000",
      "formatted_end": "05:17:28.000",
      "text": "این حالا یه برنده خب"
    },
    {
      "id": 27,
      "start": 19048.0,
      "end": 19050.0,
      "formatted_start": "05:17:28.000",
      "formatted_end": "05:17:30.000",
      "text": "و در اعتبارم تو همه اینا چیز میبرن"
    },
    {
      "id": 28,
      "start": 19050.0,
      "end": 19052.0,
      "formatted_start": "05:17:30.000",
      "formatted_end": "05:17:32.000",
      "text": "زین و آفرین"
    },
    {
      "id": 29,
      "start": 19052.0,
      "end": 19054.0,
      "formatted_start": "05:17:32.000",
      "formatted_end": "05:17:34.000",
      "text": "این همین ها ریستی داره"
    },
    {
      "id": 30,
      "start": 19054.0,
      "end": 19056.0,
      "formatted_start": "05:17:34.000",
      "formatted_end": "05:17:36.000",
      "text": "این هم صورت و حرکت است"
    },
    {
      "id": 31,
      "start": 19056.0,
      "end": 19058.0,
      "formatted_start": "05:17:36.000",
      "formatted_end": "05:17:38.000",
      "text": "این هم داروی خودمه"
    },
    {
      "id": 32,
      "start": 19058.0,
      "end": 19060.0,
      "formatted_start": "05:17:38.000",
      "formatted_end": "05:17:40.000",
      "text": "و این داروی که شما میدید با این که تضاخات نداره"
    },
    {
      "id": 33,
      "start": 19060.0,
      "end": 19062.0,
      "formatted_start": "05:17:40.000",
      "formatted_end": "05:17:42.000",
      "text": "این هم اینا نیرکنه"
    },
    {
      "id": 34,
      "start": 19062.0,
      "end": 19064.0,
      "formatted_start": "05:17:42.000",
      "formatted_end": "05:17:44.000",
      "text": "اوبا بوز میدید"
    },
    {
      "id": 35,
      "start": 19064.0,
      "end": 19066.0,
      "formatted_start": "05:17:44.000",
      "formatted_end": "05:17:46.000",
      "text": "کیوتر برای شما هم نوشته"
    },
    {
      "id": 36,
      "start": 19066.0,
      "end": 19068.0,
      "formatted_start": "05:17:46.000",
      "formatted_end": "05:17:48.000",
      "text": "اوبا بوز داره"
    },
    {
      "id": 37,
      "start": 19068.0,
      "end": 19070.0,
      "formatted_start": "05:17:48.000",
      "formatted_end": "05:17:50.000",
      "text": "کیوتر نوشته اوبا بوز داره"
    },
    {
      "id": 38,
      "start": 19070.0,
      "end": 19072.0,
      "formatted_start": "05:17:50.000",
      "formatted_end": "05:17:52.000",
      "text": "از اینجا با این داروی که اینا میخوان بخورم"
    },
    {
      "id": 39,
      "start": 19072.0,
      "end": 19074.0,
      "formatted_start": "05:17:52.000",
      "formatted_end": "05:17:54.000",
      "text": "کدومه دیتون میدونه هم برگ نداره؟"
    },
    {
      "id": 40,
      "start": 19074.0,
      "end": 19076.0,
      "formatted_start": "05:17:54.000",
      "formatted_end": "05:17:56.000",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 19076.0,
      "end": 19078.0,
      "formatted_start": "05:17:56.000",
      "formatted_end": "05:17:58.000",
      "text": "624 برگ نداره"
    },
    {
      "id": 42,
      "start": 19078.0,
      "end": 19080.0,
      "formatted_start": "05:17:58.000",
      "formatted_end": "05:18:00.000",
      "text": "624"
    },
    {
      "id": 43,
      "start": 19080.0,
      "end": 19082.0,
      "formatted_start": "05:18:00.000",
      "formatted_end": "05:18:02.000",
      "text": "13"
    },
    {
      "id": 44,
      "start": 19082.0,
      "end": 19084.0,
      "formatted_start": "05:18:02.000",
      "formatted_end": "05:18:04.000",
      "text": "24"
    },
    {
      "id": 45,
      "start": 19084.0,
      "end": 19086.0,
      "formatted_start": "05:18:04.000",
      "formatted_end": "05:18:06.000",
      "text": "چرا میدهی؟"
    },
    {
      "id": 46,
      "start": 19086.0,
      "end": 19088.0,
      "formatted_start": "05:18:06.000",
      "formatted_end": "05:18:08.000",
      "text": "از اینجا فیلو را سریع بردازم"
    },
    {
      "id": 47,
      "start": 19088.0,
      "end": 19090.0,
      "formatted_start": "05:18:08.000",
      "formatted_end": "05:18:10.000",
      "text": "ریمه چیه؟"
    },
    {
      "id": 48,
      "start": 19090.0,
      "end": 19092.0,
      "formatted_start": "05:18:10.000",
      "formatted_end": "05:18:12.000",
      "text": "نیرای مسلحه"
    },
    {
      "id": 49,
      "start": 19100.0,
      "end": 19124.0,
      "formatted_start": "05:18:20.000",
      "formatted_end": "05:18:44.000",
      "text": "موسیقی"
    },
    {
      "id": 50,
      "start": 19124.0,
      "end": 19128.0,
      "formatted_start": "05:18:44.000",
      "formatted_end": "05:18:48.000",
      "text": "خودم همیشه میگفتم که این سه سالش بشه یکی دیگر اون میارم"
    },
    {
      "id": 51,
      "start": 19128.0,
      "end": 19134.0,
      "formatted_start": "05:18:48.000",
      "formatted_end": "05:18:54.000",
      "text": "بعدی خودم ما این شرحه رو داریم گفت که این کلن دو میلیون تعداد اسفرم همسرته"
    },
    {
      "id": 52,
      "start": 19134.0,
      "end": 19139.0,
      "formatted_start": "05:18:54.000",
      "formatted_end": "05:18:59.000",
      "text": "بعدی میگفت بارداری طبیعی و دو میلیون اتفاق نمیفته"
    },
    {
      "id": 53,
      "start": 19139.0,
      "end": 19142.0,
      "formatted_start": "05:18:59.000",
      "formatted_end": "05:19:02.000",
      "text": "ببینید این همه احتماله دیگه خب"
    },
    {
      "id": 54,
      "start": 19142.0,
      "end": 19145.0,
      "formatted_start": "05:19:02.000",
      "formatted_end": "05:19:05.000",
      "text": "اون مریض داره مثلا آزود اسفرم بوده خواهد نمیشه"
    },
    {
      "id": 55,
      "start": 19145.0,
      "end": 19148.0,
      "formatted_start": "05:19:05.000",
      "formatted_end": "05:19:08.000",
      "text": "بعد شما اون یه وقت نست در این مورد چی؟"
    },
    {
      "id": 56,
      "start": 19148.0,
      "end": 19150.0,
      "formatted_start": "05:19:08.000",
      "formatted_end": "05:19:10.000",
      "text": "خب آره دیگه هر طور شده باید"
    },
    {
      "id": 57,
      "start": 19150.0,
      "end": 19158.0,
      "formatted_start": "05:19:10.000",
      "formatted_end": "05:19:18.000",
      "text": "آره میگم خدایش توی این هفت های سال که پول گشتی تا باردار بشم یک ماه هم از قلم نیابده"
    },
    {
      "id": 58,
      "start": 19158.0,
      "end": 19160.0,
      "formatted_start": "05:19:18.000",
      "formatted_end": "05:19:20.000",
      "text": "همه رو رفتم محصر انجام دادم"
    },
    {
      "id": 59,
      "start": 19160.0,
      "end": 19165.0,
      "formatted_start": "05:19:20.000",
      "formatted_end": "05:19:25.000",
      "text": "ولی از که اونجا میرفت راستم میگیدم طرف میگیم من دوتا بود دردارم اومدم برای پسر"
    },
    {
      "id": 60,
      "start": 19165.0,
      "end": 19171.0,
      "formatted_start": "05:19:25.000",
      "formatted_end": "05:19:31.000",
      "text": "بابا به خدا دیوانه این شما این همه آن پول و این همه حدیبه به خاطر که یه دونه به سر داشته باشی"
    },
    {
      "id": 61,
      "start": 19171.0,
      "end": 19175.0,
      "formatted_start": "05:19:31.000",
      "formatted_end": "05:19:35.000",
      "text": "این تکیه خوبه ماجره است"
    },
    {
      "id": 62,
      "start": 19175.0,
      "end": 19179.12,
      "formatted_start": "05:19:35.000",
      "formatted_end": "05:19:39.120",
      "text": "شما ریز که سرطان ها و ریز که بچه های آی بی ای پی رو نمیدونه"
    },
    {
      "id": 63,
      "start": 19179.12,
      "end": 19184.54,
      "formatted_start": "05:19:39.120",
      "formatted_end": "05:19:44.540",
      "text": "بچه های آی بی ای پی ده برای بیشتر زفرات جامعه در مرز بیماری ها بزرگ دارن"
    },
    {
      "id": 64,
      "start": 19184.54,
      "end": 19188.98,
      "formatted_start": "05:19:44.540",
      "formatted_end": "05:19:48.980",
      "text": "خیلی بچه های آی بی ای پی در مرز خطر هستن"
    },
    {
      "id": 65,
      "start": 19188.98,
      "end": 19192.52,
      "formatted_start": "05:19:48.980",
      "formatted_end": "05:19:52.520",
      "text": "واقعاً منافع داره وقتی که رای طبیعی هستن"
    },
    {
      "id": 66,
      "start": 19192.52,
      "end": 19194.62,
      "formatted_start": "05:19:52.520",
      "formatted_end": "05:19:54.620",
      "text": "تانور کنستم بچه های آی بی ای پی ده دارن"
    },
    {
      "id": 67,
      "start": 19194.62,
      "end": 19197.42,
      "formatted_start": "05:19:54.620",
      "formatted_end": "05:19:57.420",
      "text": "من باید دابری هم گذارم که من یه دونه هم دارم"
    }
  ],
  "status": "completed"
}