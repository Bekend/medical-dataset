  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9004.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:04.000",
      "text": "اگر به درمویت یکمان خوب شدی که شروع بفرد، اگر نم شدی، من اضافه در راه ندارم."
    },
    {
      "id": 1,
      "start": 9004.0,
      "end": 9005.0,
      "formatted_start": "02:30:04.000",
      "formatted_end": "02:30:05.000",
      "text": "کمچه همه در راه داری؟"
    },
    {
      "id": 2,
      "start": 9005.0,
      "end": 9011.0,
      "formatted_start": "02:30:05.000",
      "formatted_end": "02:30:11.000",
      "text": "آزمایشش آزاده یه خوب، 5600 خودمون کل پرو تکتینه، یه آزمایش بیمه اینگیست."
    },
    {
      "id": 3,
      "start": 9011.0,
      "end": 9012.0,
      "formatted_start": "02:30:11.000",
      "formatted_end": "02:30:12.000",
      "text": "باشه باید نداریم."
    },
    {
      "id": 4,
      "start": 9012.0,
      "end": 9013.0,
      "formatted_start": "02:30:12.000",
      "formatted_end": "02:30:13.000",
      "text": "بندیستم الان یه برنامه."
    },
    {
      "id": 5,
      "start": 9013.0,
      "end": 9015.0,
      "formatted_start": "02:30:13.000",
      "formatted_end": "02:30:15.000",
      "text": "بنابراین با این چکاپ بیرسیم"
    },
    {
      "id": 6,
      "start": 9015.0,
      "end": 9017.0,
      "formatted_start": "02:30:15.000",
      "formatted_end": "02:30:17.000",
      "text": "دیگه بهم بیده این چند وقت کام نمی کنیم"
    },
    {
      "id": 7,
      "start": 9017.0,
      "end": 9019.0,
      "formatted_start": "02:30:17.000",
      "formatted_end": "02:30:19.000",
      "text": "که اصلا وقت نمیشه"
    },
    {
      "id": 8,
      "start": 9019.0,
      "end": 9021.0,
      "formatted_start": "02:30:19.000",
      "formatted_end": "02:30:21.000",
      "text": "بعد دیگه الان برات بمونه دیگه میمونه"
    },
    {
      "id": 9,
      "start": 9021.0,
      "end": 9023.0,
      "formatted_start": "02:30:21.000",
      "formatted_end": "02:30:23.000",
      "text": "چون اینگی باید کن خلت"
    },
    {
      "id": 10,
      "start": 9023.0,
      "end": 9025.0,
      "formatted_start": "02:30:23.000",
      "formatted_end": "02:30:25.000",
      "text": "گاهی وقت همون حالته"
    },
    {
      "id": 11,
      "start": 9025.0,
      "end": 9027.0,
      "formatted_start": "02:30:25.000",
      "formatted_end": "02:30:27.000",
      "text": "تو خونه شما کسی کلیت که نداشته"
    },
    {
      "id": 12,
      "start": 9027.0,
      "end": 9029.0,
      "formatted_start": "02:30:27.000",
      "formatted_end": "02:30:29.000",
      "text": "من؟ چی؟"
    },
    {
      "id": 13,
      "start": 9029.0,
      "end": 9031.0,
      "formatted_start": "02:30:29.000",
      "formatted_end": "02:30:31.000",
      "text": "کلیت روده بیماری روده"
    },
    {
      "id": 14,
      "start": 9031.0,
      "end": 9033.0,
      "formatted_start": "02:30:31.000",
      "formatted_end": "02:30:33.000",
      "text": "نه فقط اون تصفیبانه برمونه"
    },
    {
      "id": 15,
      "start": 9033.0,
      "end": 9035.0,
      "formatted_start": "02:30:33.000",
      "formatted_end": "02:30:35.000",
      "text": "برم این خیلی بیدم بزرگ"
    },
    {
      "id": 16,
      "start": 9035.0,
      "end": 9037.0,
      "formatted_start": "02:30:35.000",
      "formatted_end": "02:30:37.000",
      "text": "من خودم به آخر"
    },
    {
      "id": 17,
      "start": 9037.0,
      "end": 9041.46,
      "formatted_start": "02:30:37.000",
      "formatted_end": "02:30:41.460",
      "text": "باشه که میان که چیز اینجوری زنده بیرون بعد از قبل سریع بیان بزرگ میشه"
    },
    {
      "id": 18,
      "start": 9041.46,
      "end": 9042.38,
      "formatted_start": "02:30:41.460",
      "formatted_end": "02:30:42.380",
      "text": "برم می کنه"
    },
    {
      "id": 19,
      "start": 9042.38,
      "end": 9044.8,
      "formatted_start": "02:30:42.380",
      "formatted_end": "02:30:44.800",
      "text": "بهتر میشه نگرم نمیشه"
    },
    {
      "id": 20,
      "start": 9044.8,
      "end": 9045.96,
      "formatted_start": "02:30:44.800",
      "formatted_end": "02:30:45.960",
      "text": "خیلی سرکشی"
    },
    {
      "id": 21,
      "start": 9045.96,
      "end": 9051.74,
      "formatted_start": "02:30:45.960",
      "formatted_end": "02:30:51.740",
      "text": "برم میگی صبحی باید برده سرکشی برم"
    },
    {
      "id": 22,
      "start": 9051.74,
      "end": 9057.96,
      "formatted_start": "02:30:51.740",
      "formatted_end": "02:30:57.960",
      "text": "برم میگی این آزمشگوی دوست درسته بیده برده یه نوز"
    },
    {
      "id": 23,
      "start": 9057.96,
      "end": 9059.0,
      "formatted_start": "02:30:57.960",
      "formatted_end": "02:30:59.000",
      "text": "برم برم برم"
    },
    {
      "id": 24,
      "start": 9059.0,
      "end": 9063.52,
      "formatted_start": "02:30:59.000",
      "formatted_end": "02:31:03.520",
      "text": "برم دارو نشتیم"
    },
    {
      "id": 25,
      "start": 9063.52,
      "end": 9065.42,
      "formatted_start": "02:31:03.520",
      "formatted_end": "02:31:05.420",
      "text": "دارو و آزمشگوی"
    },
    {
      "id": 26,
      "start": 9065.42,
      "end": 9065.88,
      "formatted_start": "02:31:05.420",
      "formatted_end": "02:31:05.880",
      "text": "برم"
    },
    {
      "id": 27,
      "start": 9095.88,
      "end": 9125.88,
      "formatted_start": "02:31:35.880",
      "formatted_end": "02:32:05.880",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 28,
      "start": 9125.88,
      "end": 9129.88,
      "formatted_start": "02:32:05.880",
      "formatted_end": "02:32:09.880",
      "text": "خب شما مردم بودید"
    },
    {
      "id": 29,
      "start": 9129.88,
      "end": 9133.88,
      "formatted_start": "02:32:09.880",
      "formatted_end": "02:32:13.880",
      "text": "مردم بودید"
    },
    {
      "id": 30,
      "start": 9133.88,
      "end": 9137.88,
      "formatted_start": "02:32:13.880",
      "formatted_end": "02:32:17.880",
      "text": "برای همین باستاریتون سود اوکنه"
    },
    {
      "id": 31,
      "start": 9137.88,
      "end": 9141.88,
      "formatted_start": "02:32:17.880",
      "formatted_end": "02:32:21.880",
      "text": "اگر دستتون بودید"
    },
    {
      "id": 32,
      "start": 9141.88,
      "end": 9145.88,
      "formatted_start": "02:32:21.880",
      "formatted_end": "02:32:25.880",
      "text": "ارگشتونو بده به من ارگشتون"
    },
    {
      "id": 33,
      "start": 9145.88,
      "end": 9157.8,
      "formatted_start": "02:32:25.880",
      "formatted_end": "02:32:37.800",
      "text": "خودتوشم خلط میچسبه"
    },
    {
      "id": 34,
      "start": 9157.8,
      "end": 9158.64,
      "formatted_start": "02:32:37.800",
      "formatted_end": "02:32:38.640",
      "text": "خلط؟"
    },
    {
      "id": 35,
      "start": 9158.64,
      "end": 9159.8,
      "formatted_start": "02:32:38.640",
      "formatted_end": "02:32:39.800",
      "text": "میچسبه خلط"
    },
    {
      "id": 36,
      "start": 9159.8,
      "end": 9163.64,
      "formatted_start": "02:32:39.800",
      "formatted_end": "02:32:43.640",
      "text": "خلطتون میچسبه یا خالی میشه؟"
    },
    {
      "id": 37,
      "start": 9163.64,
      "end": 9164.88,
      "formatted_start": "02:32:43.640",
      "formatted_end": "02:32:44.880",
      "text": "آه اینه خلط"
    },
    {
      "id": 38,
      "start": 9164.88,
      "end": 9166.44,
      "formatted_start": "02:32:44.880",
      "formatted_end": "02:32:46.440",
      "text": "چخمیشم"
    },
    {
      "id": 39,
      "start": 9166.44,
      "end": 9168.54,
      "formatted_start": "02:32:46.440",
      "formatted_end": "02:32:48.540",
      "text": "گلستم همه چی که گلستم همونی"
    },
    {
      "id": 40,
      "start": 9168.54,
      "end": 9170.0,
      "formatted_start": "02:32:48.540",
      "formatted_end": "02:32:50.000",
      "text": "ماله باید کل کردم"
    },
    {
      "id": 41,
      "start": 9170.0,
      "end": 9171.12,
      "formatted_start": "02:32:50.000",
      "formatted_end": "02:32:51.120",
      "text": "قلبانه"
    },
    {
      "id": 42,
      "start": 9171.12,
      "end": 9174.16,
      "formatted_start": "02:32:51.120",
      "formatted_end": "02:32:54.160",
      "text": "میرم هر چی میرم"
    },
    {
      "id": 43,
      "start": 9174.16,
      "end": 9176.16,
      "formatted_start": "02:32:54.160",
      "formatted_end": "02:32:56.160",
      "text": "این روش همار ریو و سینه هست."
    },
    {
      "id": 44,
      "start": 9176.16,
      "end": 9178.16,
      "formatted_start": "02:32:56.160",
      "formatted_end": "02:32:58.160",
      "text": "دایدن."
    },
    {
      "id": 45,
      "start": 9178.16,
      "end": 9182.16,
      "formatted_start": "02:32:58.160",
      "formatted_end": "02:33:02.160",
      "text": "خلصت اونو بیتونی بردی بیرون یا راه هر بیرون نمیده؟"
    },
    {
      "id": 46,
      "start": 9182.16,
      "end": 9184.16,
      "formatted_start": "02:33:02.160",
      "formatted_end": "02:33:04.160",
      "text": "اصلا خود نمیدونه."
    },
    {
      "id": 47,
      "start": 9184.16,
      "end": 9189.16,
      "formatted_start": "02:33:04.160",
      "formatted_end": "02:33:09.160",
      "text": "از چکو مادر از که از هم کبتر خود بیرون شده باید بیرون شده"
    },
    {
      "id": 48,
      "start": 9189.16,
      "end": 9191.16,
      "formatted_start": "02:33:09.160",
      "formatted_end": "02:33:11.160",
      "text": "اونوش خود بردی."
    },
    {
      "id": 49,
      "start": 9191.16,
      "end": 9193.16,
      "formatted_start": "02:33:11.160",
      "formatted_end": "02:33:13.160",
      "text": "باید باید بردیم هر پر که هم خود میدونه."
    },
    {
      "id": 50,
      "start": 9193.16,
      "end": 9195.16,
      "formatted_start": "02:33:13.160",
      "formatted_end": "02:33:15.160",
      "text": "از اینکه باید بردارید که باید بیادیم"
    },
    {
      "id": 51,
      "start": 9195.16,
      "end": 9197.16,
      "formatted_start": "02:33:15.160",
      "formatted_end": "02:33:17.160",
      "text": "آقایی"
    },
    {
      "id": 52,
      "start": 9197.16,
      "end": 9199.16,
      "formatted_start": "02:33:17.160",
      "formatted_end": "02:33:19.160",
      "text": "اون رو سر راپان بیدا باشیم"
    },
    {
      "id": 53,
      "start": 9199.16,
      "end": 9201.16,
      "formatted_start": "02:33:19.160",
      "formatted_end": "02:33:21.160",
      "text": "باید برداریم"
    },
    {
      "id": 54,
      "start": 9201.16,
      "end": 9203.16,
      "formatted_start": "02:33:21.160",
      "formatted_end": "02:33:23.160",
      "text": "باید برداریم"
    },
    {
      "id": 55,
      "start": 9203.16,
      "end": 9205.16,
      "formatted_start": "02:33:23.160",
      "formatted_end": "02:33:25.160",
      "text": "برداریم"
    },
    {
      "id": 56,
      "start": 9205.16,
      "end": 9207.16,
      "formatted_start": "02:33:25.160",
      "formatted_end": "02:33:27.160",
      "text": "قندر ندارید؟"
    },
    {
      "id": 57,
      "start": 9207.16,
      "end": 9209.16,
      "formatted_start": "02:33:27.160",
      "formatted_end": "02:33:29.160",
      "text": "قندر نداریم"
    },
    {
      "id": 58,
      "start": 9209.16,
      "end": 9211.16,
      "formatted_start": "02:33:29.160",
      "formatted_end": "02:33:31.160",
      "text": "صرف زیاد میزنید؟"
    },
    {
      "id": 59,
      "start": 9211.16,
      "end": 9213.16,
      "formatted_start": "02:33:31.160",
      "formatted_end": "02:33:33.160",
      "text": "صرف زیاد میزنیم"
    },
    {
      "id": 60,
      "start": 9213.16,
      "end": 9215.16,
      "formatted_start": "02:33:33.160",
      "formatted_end": "02:33:35.160",
      "text": "اگر باید صرف زیاد میزنیم"
    },
    {
      "id": 61,
      "start": 9215.16,
      "end": 9217.16,
      "formatted_start": "02:33:35.160",
      "formatted_end": "02:33:37.160",
      "text": "میگه سر راپان"
    },
    {
      "id": 62,
      "start": 9217.16,
      "end": 9219.16,
      "formatted_start": "02:33:37.160",
      "formatted_end": "02:33:39.160",
      "text": "میگه الان همه برای بیاد بگذاریم"
    },
    {
      "id": 63,
      "start": 9219.16,
      "end": 9221.16,
      "formatted_start": "02:33:39.160",
      "formatted_end": "02:33:41.160",
      "text": "نمیاد دیگه"
    },
    {
      "id": 64,
      "start": 9221.16,
      "end": 9223.16,
      "formatted_start": "02:33:41.160",
      "formatted_end": "02:33:43.160",
      "text": "از اینکه خلطتو شرم میکنه بیاد خب؟"
    },
    {
      "id": 65,
      "start": 9223.16,
      "end": 9226.16,
      "formatted_start": "02:33:43.160",
      "formatted_end": "02:33:46.160",
      "text": "وقتی که دیدی بهتر شدی دیگه قط کن"
    },
    {
      "id": 66,
      "start": 9226.16,
      "end": 9229.16,
      "formatted_start": "02:33:46.160",
      "formatted_end": "02:33:49.160",
      "text": "چون موهه خلط نیست دیدی که خلطتو شد"
    },
    {
      "id": 67,
      "start": 9229.16,
      "end": 9231.16,
      "formatted_start": "02:33:49.160",
      "formatted_end": "02:33:51.160",
      "text": "کف سفید دیگه نخونش خب؟"
    },
    {
      "id": 68,
      "start": 9231.16,
      "end": 9232.16,
      "formatted_start": "02:33:51.160",
      "formatted_end": "02:33:52.160",
      "text": "آه"
    },
    {
      "id": 69,
      "start": 9232.16,
      "end": 9233.16,
      "formatted_start": "02:33:52.160",
      "formatted_end": "02:33:53.160",
      "text": "باشه؟"
    },
    {
      "id": 70,
      "start": 9233.16,
      "end": 9236.16,
      "formatted_start": "02:33:53.160",
      "formatted_end": "02:33:56.160",
      "text": "باشه اگر شد خشکه اگر بگم خوب شبانی"
    },
    {
      "id": 71,
      "start": 9236.16,
      "end": 9239.16,
      "formatted_start": "02:33:56.160",
      "formatted_end": "02:33:59.160",
      "text": "من هم گرم ام رفتم"
    },
    {
      "id": 72,
      "start": 9239.16,
      "end": 9243.16,
      "formatted_start": "02:33:59.160",
      "formatted_end": "02:34:03.160",
      "text": "دیگه بودش نتونی زیادتر خشک نهنده داری با آن پول"
    },
    {
      "id": 73,
      "start": 9243.16,
      "end": 9245.16,
      "formatted_start": "02:34:03.160",
      "formatted_end": "02:34:05.160",
      "text": "شبان خب اصلا همونه داری"
    },
    {
      "id": 74,
      "start": 9245.16,
      "end": 9249.16,
      "formatted_start": "02:34:05.160",
      "formatted_end": "02:34:09.160",
      "text": "همون خشک نهنده توام شده آن پولاش"
    },
    {
      "id": 75,
      "start": 9249.16,
      "end": 9250.16,
      "formatted_start": "02:34:09.160",
      "formatted_end": "02:34:10.160",
      "text": "باشه"
    },
    {
      "id": 76,
      "start": 9251.16,
      "end": 9253.98,
      "formatted_start": "02:34:11.160",
      "formatted_end": "02:34:13.980",
      "text": "سرم آن پول نوشتم با خوش کننده خب؟"
    },
    {
      "id": 77,
      "start": 9253.98,
      "end": 9254.48,
      "formatted_start": "02:34:13.980",
      "formatted_end": "02:34:14.480",
      "text": "آه"
    },
    {
      "id": 78,
      "start": 9281.16,
      "end": 9300.0,
      "formatted_start": "02:34:41.160",
      "formatted_end": "02:35:00.000",
