      "end": 6956.0,
      "formatted_start": "01:55:54.000",
      "formatted_end": "01:55:56.000",
      "text": "چون ما به شرفشم"
    },
    {
      "id": 13,
      "start": 6956.0,
      "end": 6958.0,
      "formatted_start": "01:55:56.000",
      "formatted_end": "01:55:58.000",
