    },
    {
      "id": 14,
      "start": 6958.0,
      "end": 6961.0,
      "formatted_start": "01:55:58.000",
      "formatted_end": "01:56:01.000",
      "text": "این میگه فقط من بدم سوخم دکتر جمع شده"
    },
    {
      "id": 15,
      "start": 6961.0,
      "end": 6964.0,
      "formatted_start": "01:56:01.000",
      "formatted_end": "01:56:04.000",
      "text": "چون پاماد زدن"
    },
    {
