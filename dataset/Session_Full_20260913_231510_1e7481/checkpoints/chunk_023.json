      "start": 6964.0,
      "end": 6966.0,
      "formatted_start": "01:56:04.000",
      "formatted_end": "01:56:06.000",
      "text": "پاماد زدن زدن خوب شده"
    },
    {
      "id": 17,
      "start": 6966.0,
      "end": 6968.0,
      "formatted_start": "01:56:06.000",
      "formatted_end": "01:56:08.000",
      "text": "خوب شد"
    },
    {
      "id": 18,
      "start": 6968.0,
      "end": 6970.0,
      "formatted_start": "01:56:08.000",
      "formatted_end": "01:56:10.000",
      "text": "این پاماد خود خواهی نپنی"
    },
    {
      "id": 19,
      "start": 6970.0,
      "end": 6972.0,
      "formatted_start": "01:56:10.000",
      "formatted_end": "01:56:12.000",
      "text": "ولی جاش مانده خاندکتر"
    },
    {
      "id": 20,
      "start": 6972.0,
      "end": 6974.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:14.000",
      "text": "جاش مانده"
    },
    {
      "id": 21,
      "start": 6974.0,
      "end": 6976.0,
      "formatted_start": "01:56:14.000",
      "formatted_end": "01:56:16.000",
      "text": "جاش مانده دیگه سیاه بشه"
    },
    {
      "id": 22,
      "start": 6976.0,
      "end": 6978.0,
      "formatted_start": "01:56:16.000",
      "formatted_end": "01:56:18.000",
      "text": "همین پاماد زدن خوب شده"
    },
    {
      "id": 23,
      "start": 6978.0,
      "end": 6980.0,
      "formatted_start": "01:56:18.000",
      "formatted_end": "01:56:20.000",
      "text": "دوباره هم زیاد پاماد زدن"
    },
    {
      "id": 24,
      "start": 6980.0,
      "end": 6982.0,
      "formatted_start": "01:56:20.000",
      "formatted_end": "01:56:22.000",
      "text": "پامادو داره دیگه"
    },
    {
      "id": 25,
      "start": 6982.0,
      "end": 6986.0,
      "formatted_start": "01:56:22.000",
      "formatted_end": "01:56:26.000",
      "text": "از اینکه زخم کوچک تاولی میزنه بزنه"
    },
    {
      "id": 26,
      "start": 6986.0,
      "end": 6990.0,
      "formatted_start": "01:56:26.000",
      "formatted_end": "01:56:30.000",
      "text": "می نوستم داشته باشه"
    },
    {
      "id": 27,
      "start": 6990.0,
      "end": 6994.0,
      "formatted_start": "01:56:30.000",
      "formatted_end": "01:56:34.000",
      "text": "بزار تو در یخچال مادر خراب نمیشه خب؟"
    },
    {
      "id": 28,
      "start": 6994.0,
      "end": 6998.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:38.000",
      "text": "بزار تو در یخچال هر وقت خدا اگر زخم داشتی بزنه"
    },
    {
      "id": 29,
      "start": 6998.0,
      "end": 7000.0,
      "formatted_start": "01:56:38.000",
      "formatted_end": "01:56:40.000",
      "text": "آب خالیش داره نشان بزنه پا مادرم این"
    },
    {
      "id": 30,
      "start": 7000.0,
      "end": 7002.0,
      "formatted_start": "01:56:40.000",
      "formatted_end": "01:56:42.000",
      "text": "نه میتونم"
    },
    {
      "id": 31,
      "start": 7002.0,
      "end": 7004.0,
      "formatted_start": "01:56:42.000",
      "formatted_end": "01:56:44.000",
      "text": "داروار بگیرم"
    },
    {
      "id": 32,
      "start": 7004.0,
      "end": 7006.0,
      "formatted_start": "01:56:44.000",
      "formatted_end": "01:56:46.000",
      "text": "نه بگیر"
    },
    {
      "id": 33,
      "start": 7006.0,
      "end": 7010.0,
      "formatted_start": "01:56:46.000",
      "formatted_end": "01:56:50.000",
      "text": "پامادت کوچک بود درسته"
    },
    {
      "id": 34,
      "start": 7010.0,
      "end": 7016.0,
      "formatted_start": "01:56:50.000",
      "formatted_end": "01:56:56.000",
      "text": "از این کارمان رو کچی دیم و میگم خالیش نگرده و همون وقت تو گفتی که هم باید چیز بشه بزنی"
    },
    {
      "id": 35,
      "start": 7016.0,
      "end": 7036.0,
      "formatted_start": "01:56:56.000",
      "formatted_end": "01:57:16.000",
      "text": "اینو باید داشته باشید. هر وقت به منزی که یک زخم کوچیکی داشتی، مثلا در اینجور کسایی که زخم بستر دارن اینو برشون خود."
    },
    {
      "id": 36,
      "start": 7036.0,
      "end": 7039.58,
      "formatted_start": "01:57:16.000",
      "formatted_end": "01:57:19.580",
      "text": "خوب این خدمت شما"
    },
    {
      "id": 37,
      "start": 7039.58,
      "end": 7044.44,
      "formatted_start": "01:57:19.580",
      "formatted_end": "01:57:24.440",
      "text": "شماره بگی یه وقت بهتر نشد"
    },
    {
      "id": 38,
      "start": 7044.44,
      "end": 7045.98,
      "formatted_start": "01:57:24.440",
      "formatted_end": "01:57:25.980",
      "text": "خودم دارو ازافه کنم"
    },
    {
      "id": 39,
      "start": 7045.98,
      "end": 7047.24,
      "formatted_start": "01:57:25.980",
      "formatted_end": "01:57:27.240",
      "text": "راهتون دوره نگه"
    },
    {
      "id": 40,
      "start": 7047.24,
      "end": 7051.48,
      "formatted_start": "01:57:27.240",
      "formatted_end": "01:57:31.480",
      "text": "بگو شماره اونو اینو بگیر"
    },
    {
      "id": 41,
      "start": 7051.48,
      "end": 7052.28,
      "formatted_start": "01:57:31.480",
      "formatted_end": "01:57:32.280",
      "text": "کشیگه بگیر"
    },
    {
      "id": 42,
      "start": 7052.28,
      "end": 7057.72,
      "formatted_start": "01:57:32.280",
      "formatted_end": "01:57:37.720",
      "text": "شماره ما رو بگرداشته باشیم"
    },
    {
      "id": 43,
      "start": 7057.72,
      "end": 7062.56,
      "formatted_start": "01:57:37.720",
      "formatted_end": "01:57:42.560",
      "text": "بیدار سخت کنم"
    },
    {
      "id": 44,
      "start": 7062.56,
      "end": 7064.2,
      "formatted_start": "01:57:42.560",
      "formatted_end": "01:57:44.200",
      "text": "جان آره اونو بیدار سخت کنه"
    },
    {
      "id": 45,
      "start": 7064.2,
      "end": 7066.2,
      "formatted_start": "01:57:44.200",
      "formatted_end": "01:57:46.200",
      "text": "این رو ببینید؟"
    },
    {
      "id": 46,
      "start": 7066.2,
      "end": 7068.2,
      "formatted_start": "01:57:46.200",
      "formatted_end": "01:57:48.200",
      "text": "آره این رو از ماشه بکنیم"
    },
    {
      "id": 47,
      "start": 7068.2,
      "end": 7070.2,
      "formatted_start": "01:57:48.200",
      "formatted_end": "01:57:50.200",
      "text": "آره این رو بکنیم"
    },
    {
      "id": 48,
      "start": 7070.2,
      "end": 7072.2,
      "formatted_start": "01:57:50.200",
      "formatted_end": "01:57:52.200",
      "text": "جایی سلامت بذاری؟"
    },
    {
      "id": 49,
      "start": 7072.2,
      "end": 7074.2,
      "formatted_start": "01:57:52.200",
      "formatted_end": "01:57:54.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 50,
      "start": 7074.2,
      "end": 7076.2,
      "formatted_start": "01:57:54.200",
      "formatted_end": "01:57:56.200",
      "text": "جا برو"
    },
    {
      "id": 51,
      "start": 7076.2,
      "end": 7078.2,
      "formatted_start": "01:57:56.200",
      "formatted_end": "01:57:58.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 52,
      "start": 7078.2,
      "end": 7080.2,
      "formatted_start": "01:57:58.200",
      "formatted_end": "01:58:00.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 53,
      "start": 7080.2,
      "end": 7082.2,
      "formatted_start": "01:58:00.200",
      "formatted_end": "01:58:02.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 54,
      "start": 7082.2,
      "end": 7084.2,
      "formatted_start": "01:58:02.200",
      "formatted_end": "01:58:04.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 55,
      "start": 7084.2,
      "end": 7086.2,
      "formatted_start": "01:58:04.200",
      "formatted_end": "01:58:06.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 56,
      "start": 7086.2,
      "end": 7088.2,
      "formatted_start": "01:58:06.200",
      "formatted_end": "01:58:08.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 57,
      "start": 7088.2,
      "end": 7090.2,
      "formatted_start": "01:58:08.200",
      "formatted_end": "01:58:10.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 58,
      "start": 7090.2,
      "end": 7092.2,
      "formatted_start": "01:58:10.200",
      "formatted_end": "01:58:12.200",
      "text": "خست نمیشه روست دارم"
    },
    {
      "id": 59,
      "start": 7092.2,
      "end": 7094.2,
      "formatted_start": "01:58:12.200",
      "formatted_end": "01:58:14.200",
      "text": "اینجا باید بگیرم"
    },
    {
      "id": 60,
      "start": 7094.2,
      "end": 7096.2,
      "formatted_start": "01:58:14.200",
      "formatted_end": "01:58:16.200",
      "text": "خاطر آنها نمیتونی ازتون"
    },
    {
      "id": 61,
      "start": 7098.2,
      "end": 7100.2,
      "formatted_start": "01:58:18.200",
      "formatted_end": "01:58:20.200",
      "text": "فقط اینکه یکم"
    },
    {
      "id": 62,
      "start": 7100.2,
      "end": 7102.2,
      "formatted_start": "01:58:20.200",
      "formatted_end": "01:58:22.200",
      "text": "بد به من بود همشاتت"
    },
    {
      "id": 63,
      "start": 7102.2,
      "end": 7104.2,
      "formatted_start": "01:58:22.200",
      "formatted_end": "01:58:24.200",
      "text": "بد رنگ بد بکنیست؟"
    },
    {
      "id": 64,
      "start": 7104.2,
      "end": 7106.2,
      "formatted_start": "01:58:24.200",
      "formatted_end": "01:58:26.200",
      "text": "بد بو هست"
    },
    {
      "id": 65,
      "start": 7106.2,
      "end": 7108.2,
      "formatted_start": "01:58:26.200",
      "formatted_end": "01:58:28.200",
      "text": "سوزش خالش؟"
    },
    {
      "id": 66,
      "start": 7108.2,
      "end": 7110.2,
      "formatted_start": "01:58:28.200",
      "formatted_end": "01:58:30.200",
      "text": "الان دشت همه خیلی سوزش دارم"
    },
    {
      "id": 67,
      "start": 7110.2,
      "end": 7112.2,
      "formatted_start": "01:58:30.200",
      "formatted_end": "01:58:32.200",
      "text": "سوزش ادرار دارم"
    },
    {
      "id": 68,
      "start": 7112.2,
      "end": 7114.2,
      "formatted_start": "01:58:32.200",
      "formatted_end": "01:58:34.200",
      "text": "ادرار یا جلو؟"
    },
    {
      "id": 69,
      "start": 7114.2,
      "end": 7116.2,
      "formatted_start": "01:58:34.200",
      "formatted_end": "01:58:36.200",
      "text": "نه جلو هم هست"
    },
    {
      "id": 70,
      "start": 7116.2,
      "end": 7118.2,
      "formatted_start": "01:58:36.200",
      "formatted_end": "01:58:38.200",
      "text": "شاید زیاد خارونی؟"
    },
    {
      "id": 71,
      "start": 7118.2,
      "end": 7120.2,
      "formatted_start": "01:58:38.200",
      "formatted_end": "01:58:40.200",
      "text": "نه تو پریورد بودم"
    },
    {
      "id": 72,
      "start": 7120.2,
      "end": 7122.2,
      "formatted_start": "01:58:40.200",
      "formatted_end": "01:58:42.200",
      "text": "اصلا لکه های قهوهی خیلی چیه"
    },
    {
      "id": 73,
      "start": 7122.2,
      "end": 7124.2,
      "formatted_start": "01:58:42.200",
      "formatted_end": "01:58:44.200",
      "text": "خیلی آفونت هم تو تردی"
    },
    {
      "id": 74,
      "start": 7124.2,
      "end": 7126.2,
      "formatted_start": "01:58:44.200",
      "formatted_end": "01:58:46.200",
      "text": "جای مسافرتی جایی رفته بودی"
    },
    {
      "id": 75,
      "start": 7128.2,
      "end": 7130.2,
      "formatted_start": "01:58:48.200",
      "formatted_end": "01:58:50.200",
      "text": "آبوده شده بکنه داری"
    },
    {
      "id": 76,
      "start": 7130.2,
      "end": 7134.2,
      "formatted_start": "01:58:50.200",
      "formatted_end": "01:58:54.200",
      "text": "چونکه آب قد بود خونه خواهرم رفتم با آبوده آمدنی"
    },
    {
      "id": 77,
      "start": 7134.2,
      "end": 7136.2,
      "formatted_start": "01:58:54.200",
      "formatted_end": "01:58:56.200",
      "text": "منونست چند روز اینا هم بیرون بوده"
    },
    {
      "id": 78,
      "start": 7136.2,
      "end": 7139.2,
      "formatted_start": "01:58:56.200",
      "formatted_end": "01:58:59.200",
      "text": "اصلا تهارج وقت تهارت بود"
    },
    {
      "id": 79,
      "start": 7140.2,
      "end": 7142.2,
      "formatted_start": "01:59:00.200",
      "formatted_end": "01:59:02.200",
      "text": "اصلا میروی خونه میروی دوش میگیری"
    },
    {
