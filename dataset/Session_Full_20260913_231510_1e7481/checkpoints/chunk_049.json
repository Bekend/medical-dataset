      "end": 14922.0,
      "formatted_start": "04:08:40.000",
      "formatted_end": "04:08:42.000",
      "text": "و شعبت بگویی کن"
    },
    {
      "id": 29,
      "start": 14926.0,
      "end": 14928.0,
      "formatted_start": "04:08:46.000",
      "formatted_end": "04:08:48.000",
      "text": "میشه پردجلی دختر میشه"
    },
    {
      "id": 30,
      "start": 14929.0,
      "end": 14931.0,
      "formatted_start": "04:08:49.000",
      "formatted_end": "04:08:51.000",
      "text": "شانو زایمان رو کنی"
    },
    {
      "id": 31,
      "start": 14932.0,
      "end": 14934.0,
      "formatted_start": "04:08:52.000",
      "formatted_end": "04:08:54.000",
      "text": "نداریم شوست و شوش بگیر"
    },
    {
      "id": 32,
      "start": 14934.0,
      "end": 14939.0,
      "formatted_start": "04:08:54.000",
      "formatted_end": "04:08:59.000",
      "text": "اینجا با از بارگیرش هم درد می کنیم و اینجا با این چیزی هست که دارم."
    },
    {
      "id": 33,
      "start": 14939.0,
      "end": 14942.0,
      "formatted_start": "04:08:59.000",
      "formatted_end": "04:09:02.000",
      "text": "اون چیزی که باید برم در صفحه ترمیل باشم."
    },
    {
      "id": 34,
      "start": 14942.0,
      "end": 14945.0,
      "formatted_start": "04:09:02.000",
      "formatted_end": "04:09:05.000",
      "text": "دوباره از این کچوری که سنمون کنم."
    },
    {
      "id": 35,
      "start": 14945.0,
      "end": 14947.0,
      "formatted_start": "04:09:05.000",
      "formatted_end": "04:09:07.000",
      "text": "این چیزی می داشتیم برای خورجی هست."
    },
    {
      "id": 36,
      "start": 14957.0,
      "end": 14959.0,
      "formatted_start": "04:09:17.000",
      "formatted_end": "04:09:19.000",
      "text": "حساس گرما دارم با اینجا برم."
    },
    {
      "id": 37,
      "start": 14964.0,
      "end": 14966.0,
      "formatted_start": "04:09:24.000",
      "formatted_end": "04:09:26.000",
      "text": "بعد که نداشتی داخلیم"
    },
    {
      "id": 38,
      "start": 14966.0,
      "end": 14967.0,
      "formatted_start": "04:09:26.000",
      "formatted_end": "04:09:27.000",
      "text": "چا؟"
    },
    {
      "id": 39,
      "start": 14967.0,
      "end": 14968.0,
      "formatted_start": "04:09:27.000",
      "formatted_end": "04:09:28.000",
      "text": "بعد بار داری که نداشتیم"
    },
    {
      "id": 40,
      "start": 14968.0,
      "end": 14970.0,
      "formatted_start": "04:09:28.000",
      "formatted_end": "04:09:30.000",
      "text": "نه، پشت درست دارم"
    },
    {
      "id": 41,
      "start": 14971.0,
      "end": 14973.0,
      "formatted_start": "04:09:31.000",
      "formatted_end": "04:09:33.000",
      "text": "سلام بهت میدم جان"
    },
    {
      "id": 42,
      "start": 14974.0,
      "end": 14976.0,
      "formatted_start": "04:09:34.000",
      "formatted_end": "04:09:36.000",
      "text": "امور به این سلام بشه"
    },
    {
      "id": 43,
      "start": 14976.0,
      "end": 14978.0,
      "formatted_start": "04:09:36.000",
      "formatted_end": "04:09:38.000",
      "text": "ترس بزرگ و متر بده بشه"
    },
    {
      "id": 44,
      "start": 14988.0,
      "end": 14991.0,
      "formatted_start": "04:09:48.000",
      "formatted_end": "04:09:51.000",
      "text": "از صرف سی سبی صبح هم ساعت نماشه"
    },
    {
      "id": 45,
      "start": 14991.0,
      "end": 14993.0,
      "formatted_start": "04:09:51.000",
      "formatted_end": "04:09:53.000",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 46,
      "start": 14993.0,
      "end": 14995.0,
      "formatted_start": "04:09:53.000",
      "formatted_end": "04:09:55.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 47,
      "start": 14995.0,
      "end": 14997.0,
      "formatted_start": "04:09:55.000",
      "formatted_end": "04:09:57.000",
      "text": "اینجا باید بردارید."
    },
