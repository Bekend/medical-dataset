  "stt_segments": [
    {
      "id": 0,
      "start": 22800.0,
      "end": 22802.0,
      "formatted_start": "06:20:00.000",
      "formatted_end": "06:20:02.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 1,
      "start": 22830.0,
      "end": 22832.0,
      "formatted_start": "06:20:30.000",
      "formatted_end": "06:20:32.000",
      "text": "او همشه آزماشون رو میخونه"
    },
    {
      "id": 2,
      "start": 22836.0,
      "end": 22838.0,
      "formatted_start": "06:20:36.000",
      "formatted_end": "06:20:38.000",
      "text": "اون یکی هم آبی رو زده بود دینیکرال"
    },
    {
      "id": 3,
      "start": 22840.0,
      "end": 22842.0,
      "formatted_start": "06:20:40.000",
      "formatted_end": "06:20:42.000",
      "text": "کدوم؟"
    },
    {
      "id": 4,
      "start": 22842.0,
      "end": 22844.0,
      "formatted_start": "06:20:42.000",
      "formatted_end": "06:20:44.000",
      "text": "خودتی"
    },
    {
      "id": 5,
      "start": 22844.0,
      "end": 22846.0,
      "formatted_start": "06:20:44.000",
      "formatted_end": "06:20:46.000",
      "text": "مدفعی"
    },
    {
      "id": 6,
      "start": 22846.0,
      "end": 22848.0,
      "formatted_start": "06:20:46.000",
      "formatted_end": "06:20:48.000",
      "text": "مدفعی درسته؟"
    },
    {
      "id": 7,
      "start": 22848.0,
      "end": 22850.0,
      "formatted_start": "06:20:48.000",
      "formatted_end": "06:20:50.000",
      "text": "خودتی زده بود"
    },
    {
      "id": 8,
      "start": 22850.0,
      "end": 22852.0,
      "formatted_start": "06:20:50.000",
      "formatted_end": "06:20:52.000",
      "text": "ایفایتی همون آبی"
    },
    {
      "id": 9,
      "start": 22852.0,
      "end": 22854.0,
      "formatted_start": "06:20:52.000",
      "formatted_end": "06:20:54.000",
      "text": "مدفعی در مدفع"
    },
    {
      "id": 10,
      "start": 22854.0,
      "end": 22856.0,
      "formatted_start": "06:20:54.000",
      "formatted_end": "06:20:56.000",
      "text": "بله مدفعی که تو مارکر داشت"
    },
    {
      "id": 11,
      "start": 22856.0,
      "end": 22858.0,
      "formatted_start": "06:20:56.000",
      "formatted_end": "06:20:58.000",
      "text": "آبیش رو زده بود دینیکرال"
    },
    {
      "id": 12,
      "start": 22858.0,
      "end": 22862.16,
      "formatted_start": "06:20:58.000",
      "formatted_end": "06:21:02.160",
      "text": "او بیزن هم خیلی گذینه ها میاد"
    },
    {
      "id": 13,
      "start": 22862.16,
      "end": 22863.78,
      "formatted_start": "06:21:02.160",
      "formatted_end": "06:21:03.780",
      "text": "برد همیشه خونه مختی در مرد"
    },
    {
      "id": 14,
      "start": 22863.78,
      "end": 22865.7,
      "formatted_start": "06:21:03.780",
      "formatted_end": "06:21:05.700",
      "text": "او بیمشه با مختی در مرد"
    },
    {
      "id": 15,
      "start": 22865.7,
      "end": 22866.8,
      "formatted_start": "06:21:05.700",
      "formatted_end": "06:21:06.800",
      "text": "فیت میشه جناش"
    },
    {
      "id": 16,
      "start": 22866.8,
      "end": 22872.72,
      "formatted_start": "06:21:06.800",
      "formatted_end": "06:21:12.720",
      "text": "چند فرق هم بردش آزمان شد"
    },
    {
      "id": 17,
      "start": 22872.72,
      "end": 22879.02,
      "formatted_start": "06:21:12.720",
      "formatted_end": "06:21:19.020",
      "text": "ای یا الله"
    },
    {
      "id": 18,
      "start": 22879.02,
      "end": 22880.9,
      "formatted_start": "06:21:19.020",
      "formatted_end": "06:21:20.900",
      "text": "چند فرق شدیم امروز"
    },
    {
      "id": 19,
      "start": 22880.9,
      "end": 22883.42,
      "formatted_start": "06:21:20.900",
      "formatted_end": "06:21:23.420",
      "text": "مریض یاد داشتی"
    },
    {
      "id": 20,
      "start": 22883.42,
      "end": 22884.08,
      "formatted_start": "06:21:23.420",
      "formatted_end": "06:21:24.080",
      "text": "یکمه لفتر"
    },
    {
      "id": 21,
      "start": 22884.08,
      "end": 22885.24,
      "formatted_start": "06:21:24.080",
      "formatted_end": "06:21:25.240",
      "text": "آره امروز خیلی"
    },
    {
      "id": 22,
      "start": 22885.24,
      "end": 22886.98,
      "formatted_start": "06:21:25.240",
      "formatted_end": "06:21:26.980",
      "text": "خدا شکر"
    },
    {
      "id": 23,
      "start": 22886.98,
      "end": 22894.98,
      "formatted_start": "06:21:26.980",
      "formatted_end": "06:21:34.980",
      "text": "همشه هم جوان نیستی؟ قدیل مادر اصلا من بخورم نیکردم"
    },
    {
      "id": 24,
      "start": 22894.98,
      "end": 22898.98,
      "formatted_start": "06:21:34.980",
      "formatted_end": "06:21:38.980",
      "text": "حسدگی چیه؟ درد و معیزی چیه؟"
    },
    {
      "id": 25,
      "start": 22898.98,
      "end": 22900.98,
      "formatted_start": "06:21:38.980",
      "formatted_end": "06:21:40.980",
      "text": "اصلا از چهت که درد میشی بد افزار نمیشی"
    },
    {
      "id": 26,
      "start": 22900.98,
      "end": 22905.98,
      "formatted_start": "06:21:40.980",
      "formatted_end": "06:21:45.980",
      "text": "به خاطر که من 20 و 30 اصلا چیزی بودم خسته بیرون ماندم"
    },
    {
      "id": 27,
      "start": 22905.98,
      "end": 22909.98,
      "formatted_start": "06:21:45.980",
      "formatted_end": "06:21:49.980",
      "text": "یه هفته این گوستان مریض بیده 120 درسته"
    },
    {
      "id": 28,
      "start": 22909.98,
      "end": 22912.98,
      "formatted_start": "06:21:49.980",
      "formatted_end": "06:21:52.980",
      "text": "تازه با اون شو سرسانه"
    },
    {
      "id": 29,
      "start": 22912.98,
      "end": 22942.98,
      "formatted_start": "06:21:52.980",
      "formatted_end": "06:22:22.980",
      "text": "درسته که از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 30,
      "start": 22942.98,
      "end": 22944.98,
      "formatted_start": "06:22:22.980",
      "formatted_end": "06:22:24.980",
      "text": "خواستی رایی پید خودی موردتن"
    },
    {
      "id": 31,
      "start": 22944.98,
      "end": 22946.98,
      "formatted_start": "06:22:24.980",
      "formatted_end": "06:22:26.980",
      "text": "زمان کردم، زمان کردم"
    },
    {
      "id": 32,
      "start": 22946.98,
      "end": 22948.98,
      "formatted_start": "06:22:26.980",
      "formatted_end": "06:22:28.980",
      "text": "کتابه را از ماشوی گیدم"
    },
    {
      "id": 33,
      "start": 22948.98,
      "end": 22950.98,
      "formatted_start": "06:22:28.980",
      "formatted_end": "06:22:30.980",
      "text": "اینجا دوشته کرد"
    },
    {
      "id": 34,
      "start": 22950.98,
      "end": 22952.98,
      "formatted_start": "06:22:30.980",
      "formatted_end": "06:22:32.980",
      "text": "خانم شما رفتم کنبه رفتم"
    },
    {
      "id": 35,
      "start": 22952.98,
      "end": 22954.98,
      "formatted_start": "06:22:32.980",
      "formatted_end": "06:22:34.980",
      "text": "آمدم واسه"
    },
    {
      "id": 36,
      "start": 22954.98,
      "end": 22956.98,
      "formatted_start": "06:22:34.980",
      "formatted_end": "06:22:36.980",
      "text": "به سطحی با صد شما پنجمبری شده"
    },
    {
      "id": 37,
      "start": 22956.98,
      "end": 22958.98,
      "formatted_start": "06:22:36.980",
      "formatted_end": "06:22:38.980",
      "text": "اما"
    },
    {
      "id": 38,
      "start": 22958.98,
      "end": 22960.98,
      "formatted_start": "06:22:38.980",
      "formatted_end": "06:22:40.980",
      "text": "چردید رایت نمی کنید؟"
    },
    {
      "id": 39,
      "start": 22960.98,
      "end": 22962.98,
      "formatted_start": "06:22:40.980",
      "formatted_end": "06:22:42.980",
      "text": "من این زیر شخص همون درد و پایه"
    },
    {
      "id": 40,
      "start": 22962.98,
      "end": 22964.98,
      "formatted_start": "06:22:42.980",
      "formatted_end": "06:22:44.980",
      "text": "اینجا که خوب داره واسه هم به همون حرفی که شما"
    },
    {
      "id": 41,
      "start": 22964.98,
      "end": 22966.98,
      "formatted_start": "06:22:44.980",
      "formatted_end": "06:22:46.980",
      "text": "اول گفتی"
    },
    {
      "id": 42,
      "start": 22966.98,
      "end": 22968.98,
      "formatted_start": "06:22:46.980",
      "formatted_end": "06:22:48.980",
      "text": "از برطرف نشده اینجا که"
    },
    {
      "id": 43,
      "start": 22968.98,
      "end": 22972.22,
      "formatted_start": "06:22:48.980",
      "formatted_end": "06:22:52.220",
      "text": "موقعی که برم درشو خیلی ازیحت میشه، از برم میشه سر"
    },
    {
      "id": 44,
      "start": 22972.22,
      "end": 22974.22,
      "formatted_start": "06:22:52.220",
      "formatted_end": "06:22:54.220",
      "text": "خوب خالی نمیشه؟"
    },
    {
      "id": 45,
      "start": 22974.22,
      "end": 22980.22,
      "formatted_start": "06:22:54.220",
      "formatted_end": "06:23:00.220",
      "text": "نه، حرف میکنه ازیحت میشه، من بگم شاید امون پرفانیز مانده، ولی اینجا گفته خوبه"
    },
    {
      "id": 46,
      "start": 22980.22,
      "end": 22986.22,
      "formatted_start": "06:23:00.220",
      "formatted_end": "06:23:06.220",
      "text": "اینجا گفته خوب، یا کنی چند تا زایمان کرده؟"
    },
    {
      "id": 47,
      "start": 22986.22,
      "end": 22990.22,
      "formatted_start": "06:23:06.220",
      "formatted_end": "06:23:10.220",
      "text": "یک سخت کرده هم، پنجتان داره"
    },
    {
      "id": 48,
      "start": 22990.22,
      "end": 22998.22,
      "formatted_start": "06:23:10.220",
      "formatted_end": "06:23:18.220",
      "text": "از این رایتون که پایین آمده دیگه خب؟ خودمان رایتون که پایین آمده ازیتتون می کند."
    },
    {
      "id": 49,
      "start": 22998.22,
      "end": 23001.22,
      "formatted_start": "06:23:18.220",
      "formatted_end": "06:23:21.220",
      "text": "چند روز تقریبا قرص تیروید نخوردیم؟"
    },
    {
      "id": 50,
      "start": 23001.22,
      "end": 23004.22,
      "formatted_start": "06:23:21.220",
      "formatted_end": "06:23:24.220",
      "text": "یک نفته بیشتر، یک نفته بیشتر."
    },
    {
      "id": 51,
      "start": 23004.22,
      "end": 23006.22,
      "formatted_start": "06:23:24.220",
      "formatted_end": "06:23:26.220",
      "text": "هر روز بخورید، خب؟"
    },
    {
      "id": 52,
      "start": 23006.22,
      "end": 23009.22,
      "formatted_start": "06:23:26.220",
      "formatted_end": "06:23:29.220",
      "text": "آره، اینه باید قطع نکنم که تمام شد، آزادم نگرفتم."
    },
    {
      "id": 53,
      "start": 23009.22,
      "end": 23010.22,
      "formatted_start": "06:23:29.220",
      "formatted_end": "06:23:30.220",
      "text": "آنها."
    },
    {
      "id": 54,
      "start": 23010.22,
      "end": 23014.22,
      "formatted_start": "06:23:30.220",
      "formatted_end": "06:23:34.220",
      "text": "بیلانه باید یک دوت و سه می گرفتم که تا آزماهاش ما نگیرم."
    },
    {
      "id": 55,
      "start": 23014.22,
      "end": 23016.22,
      "formatted_start": "06:23:34.220",
      "formatted_end": "06:23:36.220",
      "text": "هر روز بخورید، خب؟"
    },
    {
      "id": 56,
      "start": 23016.22,
      "end": 23018.22,
      "formatted_start": "06:23:36.220",
      "formatted_end": "06:23:38.220",
      "text": "امیدوارم"
    },
    {
      "id": 57,
      "start": 23018.22,
      "end": 23020.22,
      "formatted_start": "06:23:38.220",
      "formatted_end": "06:23:40.220",
      "text": "امیدوارم"
    },
    {
      "id": 58,
      "start": 23020.22,
      "end": 23022.22,
      "formatted_start": "06:23:40.220",
      "formatted_end": "06:23:42.220",
      "text": "سوانده اردمانم کنم"
    },
    {
      "id": 59,
      "start": 23022.22,
      "end": 23024.22,
      "formatted_start": "06:23:42.220",
      "formatted_end": "06:23:44.220",
      "text": "دکتر زیاده من اون داریا کنم"
    },
    {
      "id": 60,
      "start": 23024.22,
      "end": 23026.22,
      "formatted_start": "06:23:44.220",
      "formatted_end": "06:23:46.220",
      "text": "یک علتش تیرویده"
    },
    {
      "id": 61,
      "start": 23026.22,
      "end": 23028.22,
      "formatted_start": "06:23:46.220",
      "formatted_end": "06:23:48.220",
      "text": "اون داریا که من خورده بیدم"
    },
    {
      "id": 62,
      "start": 23028.22,
      "end": 23030.22,
      "formatted_start": "06:23:48.220",
      "formatted_end": "06:23:50.220",
      "text": "که شما با کتابه دو"
    },
    {
      "id": 63,
      "start": 23030.22,
      "end": 23032.22,
      "formatted_start": "06:23:50.220",
      "formatted_end": "06:23:52.220",
      "text": "کلیه رضیع کرده"
    },
    {
      "id": 64,
      "start": 23032.22,
      "end": 23034.22,
      "formatted_start": "06:23:52.220",
      "formatted_end": "06:23:54.220",
      "text": "اضاعتون را سامو سکنو بود"
    },
    {
      "id": 65,
      "start": 23034.22,
      "end": 23036.22,
      "formatted_start": "06:23:54.220",
      "formatted_end": "06:23:56.220",
      "text": "حالا خورده بود"
    },
    {
      "id": 66,
      "start": 23036.22,
      "end": 23038.22,
      "formatted_start": "06:23:56.220",
      "formatted_end": "06:23:58.220",
      "text": "و شما کمخونی"
    },
    {
      "id": 67,
      "start": 23038.22,
      "end": 23040.22,
      "formatted_start": "06:23:58.220",
      "formatted_end": "06:24:00.220",
      "text": "کمخونی هم قوتونو میگیره"
    },
    {
      "id": 68,
      "start": 23040.22,
      "end": 23042.22,
      "formatted_start": "06:24:00.220",
      "formatted_end": "06:24:02.220",
      "text": "هم خسته ای"
    },
    {
      "id": 69,
      "start": 23042.22,
      "end": 23044.22,
      "formatted_start": "06:24:02.220",
      "formatted_end": "06:24:04.220",
      "text": "با صراحه براتون ایرانی برنیم"
    },
    {
      "id": 70,
      "start": 23044.22,
      "end": 23049.22,
      "formatted_start": "06:24:04.220",
      "formatted_end": "06:24:09.220",
      "text": "خارجی بیمه نمیخوره ولی ایرانی بیمه میخوره"
    },
    {
      "id": 71,
      "start": 23049.22,
      "end": 23051.22,
      "formatted_start": "06:24:09.220",
      "formatted_end": "06:24:11.220",
      "text": "هر کدوم شرح"
    },
    {
      "id": 72,
      "start": 23051.22,
      "end": 23053.22,
      "formatted_start": "06:24:11.220",
      "formatted_end": "06:24:13.220",
      "text": "خاصی ایرانی بیمیسه"
    },
    {
      "id": 73,
      "start": 23053.22,
      "end": 23058.22,
      "formatted_start": "06:24:13.220",
      "formatted_end": "06:24:18.220",
      "text": "سیام کنش در بیمیسه که من خاصی نیسته با من هم رای خودمرا دکتر رفتم"
    },
    {
      "id": 74,
      "start": 23058.22,
      "end": 23063.22,
      "formatted_start": "06:24:18.220",
      "formatted_end": "06:24:23.220",
      "text": "خورسه آهنگ ایرانی به خاطر که عذیتتون نکنه شب موقع خواب بخورید خب؟"
    },
    {
      "id": 75,
      "start": 23063.22,
      "end": 23067.22,
      "formatted_start": "06:24:23.220",
      "formatted_end": "06:24:27.220",
      "text": "با یک لیوان آب برای که شکمتون رو صف نکنه"
    },
    {
      "id": 76,
      "start": 23067.22,
      "end": 23069.22,
      "formatted_start": "06:24:27.220",
      "formatted_end": "06:24:29.220",
      "text": "با آلو با انجیر با"
    },
    {
      "id": 77,
      "start": 23069.22,
      "end": 23071.22,
      "formatted_start": "06:24:29.220",
      "formatted_end": "06:24:31.220",
      "text": "آره میبینم"
    },
    {
      "id": 78,
      "start": 23071.22,
      "end": 23073.22,
      "formatted_start": "06:24:31.220",
      "formatted_end": "06:24:33.220",
      "text": "بر چربیتونم خیلی بالاست"
    },
    {
      "id": 79,
      "start": 23076.22,
      "end": 23080.22,
      "formatted_start": "06:24:36.220",
      "formatted_end": "06:24:40.220",
      "text": "هر چه ارچه مراحت میکنم بچه ها که باز میان ترمیشون"
    },
    {
      "id": 80,
      "start": 23080.22,
      "end": 23082.22,
      "formatted_start": "06:24:40.220",
      "formatted_end": "06:24:42.220",
      "text": "الان قرص چربی نمیخوری نه؟"
    },
    {
      "id": 81,
      "start": 23082.22,
      "end": 23085.22,
      "formatted_start": "06:24:42.220",
      "formatted_end": "06:24:45.220",
      "text": "نه نه نخوردم، هم دو چربی اینا دیگه منو شده"
    },
    {
      "id": 82,
      "start": 23085.22,
      "end": 23087.22,
      "formatted_start": "06:24:45.220",
      "formatted_end": "06:24:47.220",
      "text": "دیگه حالا از این بعد بر قرص"
    },
    {
      "id": 83,
      "start": 23087.22,
      "end": 23093.22,
      "formatted_start": "06:24:47.220",
      "formatted_end": "06:24:53.220",
      "text": "دو تا چه دو روز پیش شما آمده بیشونید قرص مسکین مصرف نکردم، حتی ایبتونه"
    },
    {
      "id": 84,
      "start": 23093.22,
      "end": 23097.22,
      "formatted_start": "06:24:53.220",
      "formatted_end": "06:24:57.220",
      "text": "همونطوری که شما گفتید مصرف نکنید غیر از این ستا قرص من"
    },
    {
      "id": 85,
      "start": 23097.22,
      "end": 23099.22,
      "formatted_start": "06:24:57.220",
      "formatted_end": "06:24:59.220",
      "text": "هیچ قرص مصرف نکردم"
    }
  ],
  "status": "completed"
}