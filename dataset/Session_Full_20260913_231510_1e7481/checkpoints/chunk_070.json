      "id": 15,
      "start": 21106.0,
      "end": 21108.0,
      "formatted_start": "05:51:46.000",
      "formatted_end": "05:51:48.000",
      "text": "باید بگه همیشه"
    },
    {
      "id": 16,
      "start": 21108.0,
      "end": 21111.0,
      "formatted_start": "05:51:48.000",
      "formatted_end": "05:51:51.000",
      "text": "نه خب این همیشه چون خودستان تنها یا خونه"
    },
    {
      "id": 17,
      "start": 21111.0,
      "end": 21115.0,
      "formatted_start": "05:51:51.000",
      "formatted_end": "05:51:55.000",
      "text": "و همیشه میگه بدنم درد میکنه، پایم درد میکنه، کمانم درد میکنه"
    },
    {
      "id": 18,
      "start": 21115.0,
      "end": 21117.0,
      "formatted_start": "05:51:55.000",
      "formatted_end": "05:51:57.000",
      "text": "چند تا ضعیم هایی کردی؟"
    },
