      "id": 20,
      "start": 21119.0,
      "end": 21121.0,
      "formatted_start": "05:51:59.000",
      "formatted_end": "05:52:01.000",
      "text": "این همه در یکیش پوکی استخان دردار میده خب"
    },
    {
      "id": 21,
      "start": 21121.0,
      "end": 21123.0,
      "formatted_start": "05:52:01.000",
      "formatted_end": "05:52:03.000",
      "text": "فشارتون که بالا نیست وقتی درد داری"
    },
    {
      "id": 22,
      "start": 21123.0,
      "end": 21125.0,
      "formatted_start": "05:52:03.000",
      "formatted_end": "05:52:05.000",
      "text": "فشار مطلق میکنه؟"
    },
    {
      "id": 23,
      "start": 21125.0,
      "end": 21127.0,
      "formatted_start": "05:52:05.000",
      "formatted_end": "05:52:07.000",
      "text": "خب نه فشار مامان تنظیمه"
    },
