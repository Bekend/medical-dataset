      "end": 21102.0,
      "formatted_start": "05:51:40.000",
      "formatted_end": "05:51:42.000",
      "text": "بدندرد باید بیریست که نیست دماغو مثلا بیریست"
    },
    {
      "id": 13,
      "start": 21102.0,
      "end": 21104.0,
      "formatted_start": "05:51:42.000",
      "formatted_end": "05:51:44.000",
      "text": "یعنی اگه ترما خودگی که نده"
    },
    {
      "id": 14,
      "start": 21104.0,
      "end": 21106.0,
      "formatted_start": "05:51:44.000",
      "formatted_end": "05:51:46.000",
      "text": "اگه باشه مثلا چهار روز، پنج روز"
    },
