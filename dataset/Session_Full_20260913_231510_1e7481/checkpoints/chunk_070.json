  "stt_segments": [
    {
      "id": 0,
      "start": 21000.0,
      "end": 21030.0,
      "formatted_start": "05:50:00.000",
      "formatted_end": "05:50:30.000",
      "text": "از اینجا باید بردارید که در اینجا باید بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینج"
    },
    {
      "id": 1,
      "start": 21030.0,
      "end": 21060.0,
      "formatted_start": "05:50:30.000",
      "formatted_end": "05:51:00.000",
      "text": "از اینجا باید برداریم که در این وقت باید برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این وقت برداریم که در این و"
    },
    {
      "id": 2,
      "start": 21060.0,
      "end": 21063.0,
      "formatted_start": "05:51:00.000",
      "formatted_end": "05:51:03.000",
      "text": "برنامه ای بیشتر درد می کنم خانه دارم"
    },
    {
      "id": 3,
      "start": 21063.0,
      "end": 21066.0,
      "formatted_start": "05:51:03.000",
      "formatted_end": "05:51:06.000",
      "text": "از کموره سال نیم مده بودی؟"
    },
    {
      "id": 4,
      "start": 21068.0,
      "end": 21070.0,
      "formatted_start": "05:51:08.000",
      "formatted_end": "05:51:10.000",
      "text": "خیلی وقت داری"
    },
    {
      "id": 5,
      "start": 21071.0,
      "end": 21073.0,
      "formatted_start": "05:51:11.000",
      "formatted_end": "05:51:13.000",
      "text": "یه های معلومه دارم"
    },
    {
      "id": 6,
      "start": 21076.0,
      "end": 21079.0,
      "formatted_start": "05:51:16.000",
      "formatted_end": "05:51:19.000",
      "text": "من یه سری طبیعتی و بدندرد بهتون میدم خب"
    },
    {
      "id": 7,
      "start": 21079.0,
      "end": 21083.0,
      "formatted_start": "05:51:19.000",
      "formatted_end": "05:51:23.000",
      "text": "ولی آزمایشتون رو ناشته تشریف ببرید باشه"
    },
    {
      "id": 8,
      "start": 21090.0,
      "end": 21092.0,
      "formatted_start": "05:51:30.000",
      "formatted_end": "05:51:32.000",
      "text": "دارواتو نه؟"
    },
    {
      "id": 9,
      "start": 21092.0,
      "end": 21094.0,
      "formatted_start": "05:51:32.000",
      "formatted_end": "05:51:34.000",
      "text": "نه دارواتو بر..."
    },
    {
      "id": 10,
      "start": 21094.0,
      "end": 21096.0,
      "formatted_start": "05:51:34.000",
      "formatted_end": "05:51:36.000",
      "text": "نه اینو بردنیش"
    },
    {
      "id": 11,
      "start": 21096.0,
      "end": 21100.0,
      "formatted_start": "05:51:36.000",
      "formatted_end": "05:51:40.000",
      "text": "شوهره؟"
    },
