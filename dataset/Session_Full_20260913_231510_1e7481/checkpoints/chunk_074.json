  "stt_segments": [
    {
      "id": 0,
      "start": 22200.0,
      "end": 22202.0,
      "formatted_start": "06:10:00.000",
      "formatted_end": "06:10:02.000",
      "text": "خوارش داره؟"
    },
    {
      "id": 1,
      "start": 22202.0,
      "end": 22206.0,
      "formatted_start": "06:10:02.000",
      "formatted_end": "06:10:06.000",
      "text": "خوارش این برنگ از این موقع خنده که در آلمبرا خوارش داره."
    },
    {
      "id": 2,
      "start": 22206.0,
      "end": 22209.0,
      "formatted_start": "06:10:06.000",
      "formatted_end": "06:10:09.000",
      "text": "بلیو چان شما تنگ داره صدا فراد؟"
    },
    {
      "id": 3,
      "start": 22209.0,
      "end": 22211.0,
      "formatted_start": "06:10:09.000",
      "formatted_end": "06:10:11.000",
      "text": "آهان."
    },
    {
      "id": 4,
      "start": 22211.0,
      "end": 22214.0,
      "formatted_start": "06:10:11.000",
      "formatted_end": "06:10:14.000",
      "text": "خب، بس میردم نوشتم."
    },
    {
      "id": 5,
      "start": 22214.0,
      "end": 22218.0,
      "formatted_start": "06:10:14.000",
      "formatted_end": "06:10:18.000",
      "text": "این ایمی خوارش میدنه چی؟"
    },
    {
      "id": 6,
      "start": 22218.0,
      "end": 22219.0,
      "formatted_start": "06:10:18.000",
      "formatted_end": "06:10:19.000",
      "text": "به چی؟"
    },
    {
      "id": 7,
      "start": 22219.0,
      "end": 22220.0,
      "formatted_start": "06:10:19.000",
      "formatted_end": "06:10:20.000",
      "text": "ببیندم که خوارش میدنه."
    },
    {
      "id": 8,
      "start": 22220.0,
      "end": 22225.0,
      "formatted_start": "06:10:20.000",
      "formatted_end": "06:10:25.000",
      "text": "شما کلن که بدن احساسی دارید، یعنی صدا تمازبا از این احساسی ها دارید."
    },
    {
      "id": 9,
      "start": 22225.0,
      "end": 22227.0,
      "formatted_start": "06:10:25.000",
      "formatted_end": "06:10:27.000",
      "text": "چی میدونی؟"
    },
    {
      "id": 10,
      "start": 22227.0,
      "end": 22229.0,
      "formatted_start": "06:10:27.000",
      "formatted_end": "06:10:29.000",
      "text": "صدا احساسی ها خواهدتون می نویستم."
    },
    {
      "id": 11,
      "start": 22229.0,
      "end": 22231.0,
      "formatted_start": "06:10:29.000",
      "formatted_end": "06:10:31.000",
      "text": "از که حساسیتتون سویاد شده؟"
    },
    {
      "id": 12,
      "start": 22231.0,
      "end": 22232.0,
      "formatted_start": "06:10:31.000",
      "formatted_end": "06:10:32.000",
      "text": "آمینیم، از که از که"
    },
    {
      "id": 13,
      "start": 22232.0,
      "end": 22233.0,
      "formatted_start": "06:10:32.000",
      "formatted_end": "06:10:33.000",
      "text": "یه جوشون سویاد شده"
    },
    {
      "id": 14,
      "start": 22233.0,
      "end": 22234.0,
      "formatted_start": "06:10:33.000",
      "formatted_end": "06:10:34.000",
      "text": "یه جوشون سویاد شده"
    },
    {
      "id": 15,
      "start": 22234.0,
      "end": 22235.0,
      "formatted_start": "06:10:34.000",
      "formatted_end": "06:10:35.000",
      "text": "یه جوشون سویاد شده"
    },
    {
      "id": 16,
      "start": 22235.0,
      "end": 22237.0,
      "formatted_start": "06:10:35.000",
      "formatted_end": "06:10:37.000",
      "text": "یه آنکنونی سر بزن"
    },
    {
      "id": 17,
      "start": 22237.0,
      "end": 22238.0,
      "formatted_start": "06:10:37.000",
      "formatted_end": "06:10:38.000",
      "text": "یه آنکنونی سر بزن"
    },
    {
      "id": 18,
      "start": 22238.0,
      "end": 22239.0,
      "formatted_start": "06:10:38.000",
      "formatted_end": "06:10:39.000",
      "text": "یه آنکنونی سر بزن"
    },
    {
      "id": 19,
      "start": 22239.0,
      "end": 22240.0,
      "formatted_start": "06:10:39.000",
      "formatted_end": "06:10:40.000",
      "text": "چه درسته؟"
    },
    {
      "id": 20,
      "start": 22240.0,
      "end": 22241.0,
      "formatted_start": "06:10:40.000",
      "formatted_end": "06:10:41.000",
      "text": "خیلی خوب است هم"
    },
    {
