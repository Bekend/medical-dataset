  "stt_segments": [
    {
      "id": 0,
      "start": 14400.0,
      "end": 14429.98,
      "formatted_start": "04:00:00.000",
      "formatted_end": "04:00:29.980",
      "text": "مردم رو بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 14430.0,
      "end": 14432.0,
      "formatted_start": "04:00:30.000",
      "formatted_end": "04:00:32.000",
      "text": "نه، هنجا بشیم سینا برو"
    },
    {
      "id": 2,
      "start": 14437.44,
      "end": 14438.44,
      "formatted_start": "04:00:37.440",
      "formatted_end": "04:00:38.440",
      "text": "چند سال داری؟"
    },
    {
      "id": 3,
      "start": 14438.44,
      "end": 14439.44,
      "formatted_start": "04:00:38.440",
      "formatted_end": "04:00:39.440",
      "text": "سی و آخر"
    },
    {
      "id": 4,
      "start": 14439.44,
      "end": 14440.44,
      "formatted_start": "04:00:39.440",
      "formatted_end": "04:00:40.440",
      "text": "بچه داری؟"
    },
    {
      "id": 5,
      "start": 14440.44,
      "end": 14441.44,
      "formatted_start": "04:00:40.440",
      "formatted_end": "04:00:41.440",
      "text": "نه"
    },
    {
      "id": 6,
      "start": 14441.44,
      "end": 14443.44,
      "formatted_start": "04:00:41.440",
      "formatted_end": "04:00:43.440",
      "text": "بچه کلا نداری؟"
    },
    {
      "id": 7,
      "start": 14443.44,
      "end": 14445.44,
      "formatted_start": "04:00:43.440",
      "formatted_end": "04:00:45.440",
      "text": "دارم، این ملن دختر"
    },
    {
      "id": 8,
      "start": 14447.44,
      "end": 14449.44,
      "formatted_start": "04:00:47.440",
      "formatted_end": "04:00:49.440",
      "text": "صاحب چهار تا بچه شده؟"
    },
    {
      "id": 9,
      "start": 14449.44,
      "end": 14451.44,
      "formatted_start": "04:00:49.440",
      "formatted_end": "04:00:51.440",
      "text": "شیر میدین یعنی اون خواهی رو بفهمم"
    },
    {
      "id": 10,
      "start": 14451.44,
      "end": 14453.44,
      "formatted_start": "04:00:51.440",
      "formatted_end": "04:00:53.440",
      "text": "بچه ملن یازده ساله، نه"
    },
    {
      "id": 11,
      "start": 14453.44,
      "end": 14455.44,
      "formatted_start": "04:00:53.440",
      "formatted_end": "04:00:55.440",
      "text": "کچی که نازده"
    },
    {
      "id": 12,
      "start": 14455.44,
      "end": 14456.44,
      "formatted_start": "04:00:55.440",
      "formatted_end": "04:00:56.440",
      "text": "آمله نیستی؟"
    },
    {
      "id": 13,
      "start": 14456.44,
      "end": 14457.44,
      "formatted_start": "04:00:56.440",
      "formatted_end": "04:00:57.440",
      "text": "نه"
    },
    {
      "id": 14,
      "start": 14457.44,
      "end": 14458.44,
      "formatted_start": "04:00:57.440",
      "formatted_end": "04:00:58.440",
      "text": "چودگیری داری؟"
    },
    {
      "id": 15,
      "start": 14458.44,
      "end": 14459.44,
      "formatted_start": "04:00:58.440",
      "formatted_end": "04:00:59.440",
      "text": "نه، نه ایس چیم ندارم"
    },
    {
      "id": 16,
      "start": 14459.44,
      "end": 14460.44,
      "formatted_start": "04:00:59.440",
      "formatted_end": "04:01:00.440",
      "text": "تو دیگه نداری؟"
    },
    {
      "id": 17,
      "start": 14460.44,
      "end": 14460.94,
      "formatted_start": "04:01:00.440",
      "formatted_end": "04:01:00.940",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 14460.94,
      "end": 14462.44,
      "formatted_start": "04:01:00.940",
      "formatted_end": "04:01:02.440",
      "text": "از کجا میدونی؟ همه نمیستی؟"
    },
    {
      "id": 19,
      "start": 14462.44,
      "end": 14463.44,
      "formatted_start": "04:01:02.440",
      "formatted_end": "04:01:03.440",
      "text": "مریض شده"
    },
    {
      "id": 20,
      "start": 14463.44,
      "end": 14465.44,
      "formatted_start": "04:01:03.440",
      "formatted_end": "04:01:05.440",
      "text": "مریض میشه؟ مریضت نمیشه بود؟"
    },
    {
      "id": 21,
      "start": 14467.44,
      "end": 14468.44,
      "formatted_start": "04:01:07.440",
      "formatted_end": "04:01:08.440",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 14468.44,
      "end": 14469.44,
      "formatted_start": "04:01:08.440",
      "formatted_end": "04:01:09.440",
      "text": "ها؟"
    },
    {
      "id": 23,
      "start": 14469.44,
      "end": 14470.44,
      "formatted_start": "04:01:09.440",
      "formatted_end": "04:01:10.440",
      "text": "تفاصیلت نمیدونی؟"
    },
    {
      "id": 24,
      "start": 14470.44,
      "end": 14471.44,
      "formatted_start": "04:01:10.440",
      "formatted_end": "04:01:11.440",
