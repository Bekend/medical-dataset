    },
    {
      "start": 13797.166,
      "end": 13798.347,
      "formatted_start": "03:49:57.166",
      "formatted_end": "03:49:58.347",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 13798.972,
      "end": 13799.967,
      "formatted_start": "03:49:58.972",
      "formatted_end": "03:49:59.967",
      "speaker": "SPEAKER_02"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13512.4,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:12.400",
      "text": "سالم هم نصف این بر، هم این بر، برعکس هم این بر، پولی هم هسته، هم دست هم مثلا عمل چی هم هسته."
    },
    {
      "id": 1,
      "start": 13512.4,
      "end": 13519.48,
      "formatted_start": "03:45:12.400",
      "formatted_end": "03:45:19.480",
      "text": "این به خاطر دستت عمل سینته که، ولی خب وقتی که قضای اینجوری میخوری، بردتر میشه."
    },
    {
      "id": 2,
      "start": 13519.48,
      "end": 13522.36,
      "formatted_start": "03:45:19.480",
      "formatted_end": "03:45:22.360",
      "text": "این طرف هم ببین اصلا هیچ چی."
    },
    {
      "id": 3,
      "start": 13522.36,
      "end": 13526.36,
      "formatted_start": "03:45:22.360",
      "formatted_end": "03:45:26.360",
      "text": "اون ربطی نداره عزیز، اون به عمل اتراک داره، اون طرف تیش به خوری نمیشه."
    },
    {
      "id": 4,
      "start": 13526.36,
      "end": 13529.82,
      "formatted_start": "03:45:26.360",
      "formatted_end": "03:45:29.820",
      "text": "آره این بر بخاطر همون عمال چی بود برم برم"
    },
    {
      "id": 5,
      "start": 13529.82,
      "end": 13532.28,
      "formatted_start": "03:45:29.820",
      "formatted_end": "03:45:32.280",
      "text": "چی میزنی تو قضاش نمک بزنه؟"
    },
    {
      "id": 6,
      "start": 13532.28,
      "end": 13534.32,
      "formatted_start": "03:45:32.280",
      "formatted_end": "03:45:34.320",
      "text": "خودش میزنه دی من چی میدونم مثلا"
    },
    {
      "id": 7,
      "start": 13534.32,
      "end": 13537.0,
      "formatted_start": "03:45:34.320",
      "formatted_end": "03:45:37.000",
      "text": "بردی چیزار میزنه دی چی کاش کنم"
    },
    {
      "id": 8,
      "start": 13537.0,
      "end": 13541.2,
      "formatted_start": "03:45:37.000",
      "formatted_end": "03:45:41.200",
      "text": "خوش دی بر عادت کنی نزنه دی"
    },
    {
      "id": 9,
      "start": 13541.2,
      "end": 13545.2,
      "formatted_start": "03:45:41.200",
      "formatted_end": "03:45:45.200",
      "text": "درستش بکرد برکی"
    },
    {
      "id": 10,
      "start": 13545.2,
      "end": 13547.7,
      "formatted_start": "03:45:45.200",
      "formatted_end": "03:45:47.700",
      "text": "الانم زیاد سردرد میشم"
    },
    {
      "id": 11,
      "start": 13547.7,
      "end": 13549.6,
      "formatted_start": "03:45:47.700",
      "formatted_end": "03:45:49.600",
      "text": "افونت تو بدنه"
    },
    {
      "id": 12,
      "start": 13549.6,
      "end": 13551.42,
      "formatted_start": "03:45:49.600",
      "formatted_end": "03:45:51.420",
      "text": "سردرد میشم سرگیجان دارم"
    },
    {
      "id": 13,
      "start": 13551.42,
      "end": 13554.22,
      "formatted_start": "03:45:51.420",
      "formatted_end": "03:45:54.220",
      "text": "خود من ازمهش بگیرم برد بهت مطمئن بگم"
    },
    {
      "id": 14,
      "start": 13554.22,
      "end": 13555.4,
      "formatted_start": "03:45:54.220",
      "formatted_end": "03:45:55.400",
      "text": "افونت خونداری"
    },
    {
      "id": 15,
      "start": 13555.4,
      "end": 13557.4,
      "formatted_start": "03:45:55.400",
      "formatted_end": "03:45:57.400",
      "text": "از در اومدی من دستش رو دیدم"
    },
    {
      "id": 16,
      "start": 13559.4,
      "end": 13561.4,
      "formatted_start": "03:45:59.400",
      "formatted_end": "03:46:01.400",
      "text": "خب الان باید چی کنه؟"
    },
    {
      "id": 17,
      "start": 13561.4,
      "end": 13563.4,
      "formatted_start": "03:46:01.400",
      "formatted_end": "03:46:03.400",
      "text": "اینجوری شده ها"
    },
    {
      "id": 18,
      "start": 13563.4,
      "end": 13565.4,
      "formatted_start": "03:46:03.400",
      "formatted_end": "03:46:05.400",
      "text": "کلن در چند وقت اینجوری میشه قرمز میشه"
    },
    {
      "id": 19,
      "start": 13565.4,
      "end": 13567.4,
      "formatted_start": "03:46:05.400",
      "formatted_end": "03:46:07.400",
      "text": "اینگار آب جوش ریخته تا اول زده اینجوریه"
    },
    {
      "id": 20,
      "start": 13567.4,
      "end": 13569.4,
      "formatted_start": "03:46:07.400",
      "formatted_end": "03:46:09.400",
      "text": "خب خوشتانه میگه"
    },
    {
      "id": 21,
      "start": 13569.4,
      "end": 13571.4,
      "formatted_start": "03:46:09.400",
      "formatted_end": "03:46:11.400",
      "text": "خب هر وقت ماون نمک بخوره"
    },
    {
      "id": 22,
      "start": 13571.4,
      "end": 13573.4,
      "formatted_start": "03:46:11.400",
      "formatted_end": "03:46:13.400",
      "text": "گوشت قرمز یا اسپنج"
    },
    {
      "id": 23,
      "start": 13573.4,
      "end": 13575.4,
      "formatted_start": "03:46:13.400",
      "formatted_end": "03:46:15.400",
      "text": "خب خوشتانه میگه دیگه بردر"
    },
    {
      "id": 24,
      "start": 13575.4,
      "end": 13577.4,
      "formatted_start": "03:46:15.400",
      "formatted_end": "03:46:17.400",
      "text": "گوم سبزی اینجوری شده ها"
    },
    {
      "id": 25,
      "start": 13577.4,
      "end": 13579.4,
      "formatted_start": "03:46:17.400",
      "formatted_end": "03:46:19.400",
      "text": "نمک بخوره دیگه معلوم که نمک بخوره"
    },
    {
      "id": 26,
      "start": 13579.4,
      "end": 13581.4,
      "formatted_start": "03:46:19.400",
      "formatted_end": "03:46:21.400",
      "text": "اینو شما میخوریم"
    },
    {
      "id": 27,
      "start": 13581.4,
      "end": 13583.4,
      "formatted_start": "03:46:21.400",
      "formatted_end": "03:46:23.400",
      "text": "نمیدونم"
    },
    {
      "id": 28,
      "start": 13583.4,
      "end": 13585.4,
      "formatted_start": "03:46:23.400",
      "formatted_end": "03:46:25.400",
      "text": "نمیدونم"
    },
    {
      "id": 29,
      "start": 13585.4,
      "end": 13587.4,
      "formatted_start": "03:46:25.400",
      "formatted_end": "03:46:27.400",
      "text": "مال من یا مال آجیه"
    },
    {
      "id": 30,
      "start": 13587.4,
      "end": 13589.4,
      "formatted_start": "03:46:27.400",
      "formatted_end": "03:46:29.400",
      "text": "چیست؟ اسمش چیه؟"
    },
    {
      "id": 31,
      "start": 13589.4,
      "end": 13591.4,
      "formatted_start": "03:46:29.400",
      "formatted_end": "03:46:31.400",
      "text": "چانلویه دیگه نمیخوره دیگه"
    },
    {
      "id": 32,
      "start": 13591.4,
      "end": 13593.4,
      "formatted_start": "03:46:31.400",
      "formatted_end": "03:46:33.400",
      "text": "برای روماتیس میکوری؟"
    },
    {
      "id": 33,
      "start": 13593.4,
      "end": 13595.4,
      "formatted_start": "03:46:33.400",
      "formatted_end": "03:46:35.400",
      "text": "نه برای همون"
    },
    {
      "id": 34,
      "start": 13595.4,
      "end": 13597.4,
      "formatted_start": "03:46:35.400",
      "formatted_end": "03:46:37.400",
      "text": "برای همون؟"
    },
    {
      "id": 35,
      "start": 13597.4,
      "end": 13599.4,
      "formatted_start": "03:46:37.400",
      "formatted_end": "03:46:39.400",
      "text": "یه روز درمیان"
    },
    {
      "id": 36,
      "start": 13599.4,
      "end": 13601.4,
      "formatted_start": "03:46:39.400",
      "formatted_end": "03:46:41.400",
      "text": "برای دفعه پورتاینش میکوره"
    },
    {
      "id": 37,
      "start": 13601.4,
      "end": 13603.4,
      "formatted_start": "03:46:41.400",
      "formatted_end": "03:46:43.400",
      "text": "من نمیدونم"
    },
    {
      "id": 38,
      "start": 13603.4,
      "end": 13605.4,
      "formatted_start": "03:46:43.400",
      "formatted_end": "03:46:45.400",
      "text": "از همونی که پیون کردم"
    },
    {
      "id": 39,
      "start": 13605.4,
      "end": 13607.4,
      "formatted_start": "03:46:45.400",
      "formatted_end": "03:46:47.400",
      "text": "برای ملویسه"
    },
    {
      "id": 40,
      "start": 13607.4,
      "end": 13609.4,
      "formatted_start": "03:46:47.400",
      "formatted_end": "03:46:49.400",
      "text": "گفت یه روز درمیان؟"
    },
    {
      "id": 41,
      "start": 13609.4,
      "end": 13611.4,
      "formatted_start": "03:46:49.400",
      "formatted_end": "03:46:51.400",
      "text": "آره"
    },
    {
      "id": 42,
      "start": 13611.4,
      "end": 13613.4,
      "formatted_start": "03:46:51.400",
      "formatted_end": "03:46:53.400",
      "text": "اول که یکی و نیست دوتا میکوره"
    },
    {
      "id": 43,
      "start": 13613.4,
      "end": 13615.4,
      "formatted_start": "03:46:53.400",
      "formatted_end": "03:46:55.400",
      "text": "اول که یکی و نیست دوتا میکرد"
    },
    {
      "id": 44,
      "start": 13615.4,
      "end": 13617.4,
      "formatted_start": "03:46:55.400",
      "formatted_end": "03:46:57.400",
      "text": "این رو خوردم، یه دانه رو هم پنج"
    },
    {
      "id": 45,
      "start": 13617.4,
      "end": 13619.4,
      "formatted_start": "03:46:57.400",
      "formatted_end": "03:46:59.400",
      "text": "دیگه همینوی هی کم کرده"
    },
    {
      "id": 46,
      "start": 13619.4,
      "end": 13621.4,
      "formatted_start": "03:46:59.400",
      "formatted_end": "03:47:01.400",
      "text": "هی کن من این برده بالا هی کم کرده"
    },
    {
      "id": 47,
      "start": 13621.4,
      "end": 13623.4,
      "formatted_start": "03:47:01.400",
      "formatted_end": "03:47:03.400",
      "text": "علشونه یه روز در میاد"
    },
    {
      "id": 48,
      "start": 13623.4,
      "end": 13625.4,
      "formatted_start": "03:47:03.400",
      "formatted_end": "03:47:05.400",
      "text": "بیرون بطرن خواهی و پامان؟"
    },
    {
      "id": 49,
      "start": 13625.4,
      "end": 13627.4,
      "formatted_start": "03:47:05.400",
      "formatted_end": "03:47:07.400",
      "text": "بطرن"
    },
    {
      "id": 50,
      "start": 13627.4,
      "end": 13629.4,
      "formatted_start": "03:47:07.400",
      "formatted_end": "03:47:09.400",
      "text": "بطر چشم؟ آره"
    },
    {
      "id": 51,
      "start": 13631.4,
      "end": 13633.4,
      "formatted_start": "03:47:11.400",
      "formatted_end": "03:47:13.400",
      "text": "زیاد نرسی خب؟"
    },
    {
      "id": 52,
      "start": 13633.4,
      "end": 13635.4,
      "formatted_start": "03:47:13.400",
      "formatted_end": "03:47:15.400",
      "text": "چشمت"
    },
    {
      "id": 53,
      "start": 13635.4,
      "end": 13637.4,
      "formatted_start": "03:47:15.400",
      "formatted_end": "03:47:17.400",
      "text": "اوپنه اتون کنه، اون منش میاد پایین"
    },
    {
      "id": 54,
      "start": 13637.4,
      "end": 13639.4,
      "formatted_start": "03:47:17.400",
      "formatted_end": "03:47:19.400",
      "text": "سود آب مارواره دیده"
    },
    {
      "id": 55,
      "start": 13645.4,
      "end": 13675.4,
      "formatted_start": "03:47:25.400",
      "formatted_end": "03:47:55.400",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که ا"
    },
    {
      "id": 56,
      "start": 13675.4,
      "end": 13679.4,
      "formatted_start": "03:47:55.400",
      "formatted_end": "03:47:59.400",
      "text": "از این تحصیلی با فروزمار تردوتارو بزنیم"
    },
    {
      "id": 57,
      "start": 13679.4,
      "end": 13681.4,
      "formatted_start": "03:47:59.400",
      "formatted_end": "03:48:01.400",
      "text": "باید بیان بزنن"
    },
    {
      "id": 58,
      "start": 13681.4,
      "end": 13684.4,
      "formatted_start": "03:48:01.400",
      "formatted_end": "03:48:04.400",
      "text": "از قرص فروزماری گفتی چی؟"
    },
    {
      "id": 59,
      "start": 13684.4,
      "end": 13688.4,
      "formatted_start": "03:48:04.400",
      "formatted_end": "03:48:08.400",
      "text": "نه گفتم دیگه گفتم برمیسه خانه باشه همطوری ها"
    },
    {
      "id": 60,
      "start": 13688.4,
      "end": 13691.4,
      "formatted_start": "03:48:08.400",
      "formatted_end": "03:48:11.400",
      "text": "وقتایی که خیلی زیاد میشه آره بخوری خواب؟"
    },
    {
      "id": 61,
      "start": 13691.4,
      "end": 13693.4,
      "formatted_start": "03:48:11.400",
      "formatted_end": "03:48:13.400",
      "text": "آره"
    },
    {
      "id": 62,
      "start": 13693.4,
      "end": 13694.4,
      "formatted_start": "03:48:13.400",
      "formatted_end": "03:48:14.400",
      "text": "برم مام برم دارم"
    },
    {
      "id": 63,
      "start": 13694.4,
      "end": 13699.4,
      "formatted_start": "03:48:14.400",
      "formatted_end": "03:48:19.400",
      "text": "سردردم دارم قرص است از که میرفونم این ساده برام برمیسی"
    },
    {
      "id": 64,
      "start": 13699.4,
      "end": 13701.4,
      "formatted_start": "03:48:19.400",
      "formatted_end": "03:48:21.400",
      "text": "آره این کدوی این که نمیخورم اون ساده"
    },
    {
      "id": 65,
      "start": 13701.4,
      "end": 13703.4,
      "formatted_start": "03:48:21.400",
      "formatted_end": "03:48:23.400",
      "text": "آره"
    },
    {
      "id": 66,
      "start": 13703.4,
      "end": 13733.4,
      "formatted_start": "03:48:23.400",
      "formatted_end": "03:48:53.400",
      "text": "بعد شکم من هر یک هفته نه روز ده روز شکم من هر یک هفته نه روز ده روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من هر یک هفته نه روز شکم من"
    },
    {
      "id": 67,
      "start": 13733.4,
      "end": 13739.4,
      "formatted_start": "03:48:53.400",
      "formatted_end": "03:48:59.400",
      "text": "اینجوری بشه مریض اتنیک می کنه باید حتما مرتب بخوری"
    },
    {
      "id": 68,
      "start": 13739.4,
      "end": 13745.4,
      "formatted_start": "03:48:59.400",
      "formatted_end": "03:49:05.400",
      "text": "مرتب زرعه نداره؟ نه اون اصلا جست نمیشه که زرعه بشه بشه"
    },
    {
      "id": 69,
      "start": 13745.4,
      "end": 13747.4,
      "formatted_start": "03:49:05.400",
      "formatted_end": "03:49:07.400",
      "text": "از اینجوری بشه"
    },
    {
      "id": 70,
      "start": 13747.4,
      "end": 13751.4,
      "formatted_start": "03:49:07.400",
      "formatted_end": "03:49:11.400",
      "text": "از اینجوری بشه هرچی شده اکسیم هم نمیشه"
    },
    {
      "id": 71,
      "start": 13751.4,
      "end": 13754.4,
      "formatted_start": "03:49:11.400",
      "formatted_end": "03:49:14.400",
      "text": "مریضی کم هم خیلی صفتی دیگر نداره"
    },
    {
      "id": 72,
      "start": 13754.4,
      "end": 13756.4,
      "formatted_start": "03:49:14.400",
      "formatted_end": "03:49:16.400",
      "text": "این الان یک سالی نداره شده"
    },
    {
      "id": 73,
      "start": 13756.4,
      "end": 13759.4,
      "formatted_start": "03:49:16.400",
      "formatted_end": "03:49:19.400",
      "text": "شده یه روز در اینجور شربتو بخوری دازخواد"
    },
    {
      "id": 74,
      "start": 13759.4,
      "end": 13762.4,
      "formatted_start": "03:49:19.400",
      "formatted_end": "03:49:22.400",
      "text": "الان شربت منظوری تمام شده"
    },
    {
      "id": 75,
      "start": 13762.4,
      "end": 13764.4,
      "formatted_start": "03:49:22.400",
      "formatted_end": "03:49:24.400",
      "text": "دو تانه روشن"
    },
    {
      "id": 76,
      "start": 13774.4,
      "end": 13776.4,
      "formatted_start": "03:49:34.400",
      "formatted_end": "03:49:36.400",
      "text": "از این دست دو خونت کرده"
    },
    {
      "id": 77,
      "start": 13776.4,
      "end": 13778.4,
      "formatted_start": "03:49:36.400",
      "formatted_end": "03:49:38.400",
      "text": "او خونت هم که رو همه چی میلی تاثیر داره"
    },
    {
      "id": 78,
      "start": 13778.4,
      "end": 13780.4,
      "formatted_start": "03:49:38.400",
      "formatted_end": "03:49:40.400",
      "text": "دو خونت میلی تو خونه"
    },
    {
      "id": 79,
      "start": 13782.4,
      "end": 13784.4,
      "formatted_start": "03:49:42.400",
      "formatted_end": "03:49:44.400",
      "text": "این بابا میره کم خونه داشت برای شچینه شین"
    },
    {
      "id": 80,
      "start": 13784.4,
      "end": 13786.4,
      "formatted_start": "03:49:44.400",
      "formatted_end": "03:49:46.400",
      "text": "دوباره یه آزمایش باز دوباره"
    },
    {
      "id": 81,
      "start": 13786.4,
      "end": 13788.4,
      "formatted_start": "03:49:46.400",
      "formatted_end": "03:49:48.400",
      "text": "چیز کردن"
    },
    {
      "id": 82,
      "start": 13788.4,
      "end": 13790.4,
      "formatted_start": "03:49:48.400",
      "formatted_end": "03:49:50.400",
      "text": "داره بوده"
    },
    {
      "id": 83,
      "start": 13790.4,
      "end": 13792.4,
      "formatted_start": "03:49:50.400",
      "formatted_end": "03:49:52.400",
      "text": "داده بودی برای آهنگ"
    },
    {
      "id": 84,
      "start": 13792.4,
      "end": 13794.4,
      "formatted_start": "03:49:52.400",
      "formatted_end": "03:49:54.400",
      "text": "گفتی بخور یا آزمایش بده"
    },
    {
      "id": 85,
      "start": 13794.4,
      "end": 13796.4,
      "formatted_start": "03:49:54.400",
      "formatted_end": "03:49:56.400",
      "text": "من اونو برم"
    },
    {
      "id": 86,
      "start": 13796.4,
      "end": 13798.4,
      "formatted_start": "03:49:56.400",
      "formatted_end": "03:49:58.400",
      "text": "چیز شده یا نه"
    },
    {
      "id": 87,
      "start": 13798.4,
      "end": 13800.4,
      "formatted_start": "03:49:58.400",
      "formatted_end": "03:50:00.400",
      "text": "آهنگشو چک نگه"
    }
  ],
  "status": "completed"
}