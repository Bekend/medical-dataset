  "stt_segments": [
    {
      "id": 0,
      "start": 16200.0,
      "end": 16216.0,
      "formatted_start": "04:30:00.000",
      "formatted_end": "04:30:16.000",
      "text": "اگر قبول نکردن، همونجا همون تلفونی که بیدارو بگیرید، نوبت بگیرید برایشون، بعد ببنید وستری کنیم قدرشون رو بیرن پایین، اون وقت از آزمایشه بیمارستانم کوپی بگیرید."
    },
    {
      "id": 1,
      "start": 16216.0,
      "end": 16223.0,
      "formatted_start": "04:30:16.000",
      "formatted_end": "04:30:23.000",
      "text": "اونجا بعد به همون دکتر بگو نامه عمل من رو جد کن که برم عمل کنم. خب، این راهشه."
    },
    {
      "id": 2,
      "start": 16223.0,
      "end": 16227.0,
      "formatted_start": "04:30:23.000",
      "formatted_end": "04:30:27.000",
      "text": "باید کنید که این همسوری نتونه به نوستان"
    },
    {
      "id": 3,
      "start": 16227.0,
      "end": 16231.0,
      "formatted_start": "04:30:27.000",
      "formatted_end": "04:30:31.000",
      "text": "باید بگم که باید تحییلش کنم"
    },
    {
      "id": 4,
      "start": 16231.0,
      "end": 16235.0,
      "formatted_start": "04:30:31.000",
      "formatted_end": "04:30:35.000",
      "text": "مگه تا حالا همسوری نتونه؟"
    },
    {
      "id": 5,
      "start": 16235.0,
      "end": 16239.0,
      "formatted_start": "04:30:35.000",
      "formatted_end": "04:30:39.000",
      "text": "همسوری نتونه اون ریت میگیره"
    },
    {
      "id": 6,
      "start": 16239.0,
      "end": 16243.0,
      "formatted_start": "04:30:39.000",
      "formatted_end": "04:30:43.000",
      "text": "آهان همسوری شده عوض کردم من"
    },
    {
      "id": 7,
      "start": 16243.0,
      "end": 16247.0,
      "formatted_start": "04:30:43.000",
      "formatted_end": "04:30:47.000",
      "text": "خب پس باید اصلا کار داری کم"
    },
    {
      "id": 8,
      "start": 16247.0,
      "end": 16251.0,
      "formatted_start": "04:30:47.000",
      "formatted_end": "04:30:51.000",
      "text": "باید بفرسته فریمه"
    },
    {
      "id": 9,
      "start": 16251.0,
      "end": 16252.0,
      "formatted_start": "04:30:51.000",
      "formatted_end": "04:30:52.000",
      "text": "بله"
    },
    {
      "id": 10,
      "start": 16252.0,
      "end": 16255.0,
      "formatted_start": "04:30:52.000",
      "formatted_end": "04:30:55.000",
      "text": "از خوام شفایی یه فرمه تمنی اجتماعی بگیری هاجی؟"
    },
    {
      "id": 11,
      "start": 16255.0,
      "end": 16257.0,
      "formatted_start": "04:30:55.000",
      "formatted_end": "04:30:57.000",
      "text": "بیرون بیرون بیرون"
    },
    {
      "id": 12,
      "start": 16257.0,
      "end": 16287.0,
      "formatted_start": "04:30:57.000",
      "formatted_end": "04:31:27.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که ا"
    },
    {
      "id": 13,
      "start": 16287.0,
      "end": 16291.04,
      "formatted_start": "04:31:27.000",
      "formatted_end": "04:31:31.040",
      "text": "خدا من از همین بیان میمون خوشکالی خدا ایشکارم فردون"
    },
    {
      "id": 14,
      "start": 16291.04,
      "end": 16293.24,
      "formatted_start": "04:31:31.040",
      "formatted_end": "04:31:33.240",
      "text": "خودمون از این بیان خوشکالی رنگیر"
    },
    {
      "id": 15,
      "start": 16293.24,
      "end": 16296.44,
      "formatted_start": "04:31:33.240",
      "formatted_end": "04:31:36.440",
      "text": "برای همین در حقیقتش بیان من خودم خصوصیم"
    },
    {
      "id": 16,
      "start": 16296.44,
      "end": 16298.68,
      "formatted_start": "04:31:36.440",
      "formatted_end": "04:31:38.680",
      "text": "برای هم میدونم حده نتو زیادی شدیم"
    },
    {
      "id": 17,
      "start": 16298.68,
      "end": 16302.34,
      "formatted_start": "04:31:38.680",
      "formatted_end": "04:31:42.340",
      "text": "نه بسایی میگم اینجا برای که حالا بازش از تن هست"
    },
    {
      "id": 18,
      "start": 16302.34,
      "end": 16305.18,
      "formatted_start": "04:31:42.340",
      "formatted_end": "04:31:45.180",
      "text": "برای خوابی هست بردارشش که من برش میگیم"
    },
    {
      "id": 19,
      "start": 16305.18,
      "end": 16306.42,
      "formatted_start": "04:31:45.180",
      "formatted_end": "04:31:46.420",
      "text": "این از هم مادر بیان"
    },
    {
      "id": 20,
      "start": 16306.42,
      "end": 16309.24,
      "formatted_start": "04:31:46.420",
      "formatted_end": "04:31:49.240",
      "text": "همه مردم یه جوری شده مملکت که"
    },
    {
      "id": 21,
      "start": 16309.24,
      "end": 16310.88,
      "formatted_start": "04:31:49.240",
      "formatted_end": "04:31:50.880",
      "text": "هرکه هر جا هست گرفتن"
    },
    {
      "id": 22,
      "start": 16310.88,
      "end": 16314.88,
      "formatted_start": "04:31:50.880",
      "formatted_end": "04:31:54.880",
      "text": "این کلافت از اون روش که میدونیم"
    },
    {
      "id": 23,
      "start": 16314.88,
      "end": 16318.88,
      "formatted_start": "04:31:54.880",
      "formatted_end": "04:31:58.880",
      "text": "آره، اینو یادتونه پیش که رفتیم بی ماستن تمنیشتونه آقای آه"
    },
    {
      "id": 24,
      "start": 16318.88,
      "end": 16319.88,
      "formatted_start": "04:31:58.880",
      "formatted_end": "04:31:59.880",
      "text": "آقای آه برده"
    },
    {
      "id": 25,
      "start": 16319.88,
      "end": 16321.88,
      "formatted_start": "04:31:59.880",
      "formatted_end": "04:32:01.880",
      "text": "یادتونه، همونجا باید بریم"
    },
    {
      "id": 26,
      "start": 16321.88,
      "end": 16322.88,
      "formatted_start": "04:32:01.880",
      "formatted_end": "04:32:02.880",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 16325.88,
      "end": 16328.88,
      "formatted_start": "04:32:05.880",
      "formatted_end": "04:32:08.880",
      "text": "اینم اگه گفته ببین من اینو آزاد خیلی نمیدونم"
    },
    {
      "id": 28,
      "start": 16332.88,
      "end": 16334.88,
      "formatted_start": "04:32:12.880",
      "formatted_end": "04:32:14.880",
      "text": "باید کنسولرون رو هم ببرم"
    },
    {
      "id": 29,
      "start": 16334.88,
      "end": 16337.88,
      "formatted_start": "04:32:14.880",
      "formatted_end": "04:32:17.880",
      "text": "نه، من تو کود رکبی نمیشتم"
    },
    {
      "id": 30,
      "start": 16337.88,
      "end": 16338.88,
      "formatted_start": "04:32:17.880",
      "formatted_end": "04:32:18.880",
      "text": "بشمون رو ببرم"
    },
    {
      "id": 31,
      "start": 16338.88,
      "end": 16340.88,
      "formatted_start": "04:32:18.880",
      "formatted_end": "04:32:20.880",
      "text": "اینکه دستتون بدی فرم همه اتون"
    },
    {
      "id": 32,
      "start": 16342.88,
      "end": 16343.88,
      "formatted_start": "04:32:22.880",
      "formatted_end": "04:32:23.880",
      "text": "اینکه رازی باشه؟"
    },
    {
      "id": 33,
      "start": 16343.88,
      "end": 16344.88,
      "formatted_start": "04:32:23.880",
      "formatted_end": "04:32:24.880",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 16344.88,
      "end": 16346.88,
      "formatted_start": "04:32:24.880",
      "formatted_end": "04:32:26.880",
      "text": "اینکه خود نداشته همه"
    },
    {
      "id": 35,
      "start": 16362.88,
      "end": 16364.88,
      "formatted_start": "04:32:42.880",
      "formatted_end": "04:32:44.880",
      "text": "اون دکتورتون آزمایش میخواد خب؟"
    },
    {
      "id": 36,
      "start": 16364.88,
      "end": 16365.88,
      "formatted_start": "04:32:44.880",
      "formatted_end": "04:32:45.880",
      "text": "نه"
    },
    {
      "id": 37,
      "start": 16365.88,
      "end": 16367.88,
      "formatted_start": "04:32:45.880",
      "formatted_end": "04:32:47.880",
      "text": "اون آزمایش میخواد برگر"
    },
    {
      "id": 38,
      "start": 16367.88,
      "end": 16371.88,
      "formatted_start": "04:32:47.880",
      "formatted_end": "04:32:51.880",
      "text": "ما چار چک می کنیم اونا قبول ندارن که"
    },
    {
      "id": 39,
      "start": 16371.88,
      "end": 16378.88,
      "formatted_start": "04:32:51.880",
      "formatted_end": "04:32:58.880",
      "text": "بعد از همه آزمایش بیمارستان رو تو پاپی بگیریم"
    },
    {
      "id": 40,
      "start": 16378.88,
      "end": 16380.88,
      "formatted_start": "04:32:58.880",
      "formatted_end": "04:33:00.880",
      "text": "ما باید تحفیص بهتون بگیریم"
    },
    {
      "id": 41,
      "start": 16380.88,
      "end": 16383.88,
      "formatted_start": "04:33:00.880",
      "formatted_end": "04:33:03.880",
      "text": "از چندن تمنید می کنم عملش رو خوره دارم"
    },
    {
      "id": 42,
      "start": 16383.88,
      "end": 16385.88,
      "formatted_start": "04:33:03.880",
      "formatted_end": "04:33:05.880",
      "text": "خب پس خوبه دیگه"
    },
    {
      "id": 43,
      "start": 16385.88,
      "end": 16386.88,
      "formatted_start": "04:33:05.880",
      "formatted_end": "04:33:06.880",
      "text": "خوره تمنید می کنم"
    },
    {
      "id": 44,
      "start": 16386.88,
      "end": 16390.88,
      "formatted_start": "04:33:06.880",
      "formatted_end": "04:33:10.880",
      "text": "خب دیگه پس اصلا چرا همون چه بستای از او زبط خود دکتر نگفت همون گاره؟"
    },
    {
      "id": 45,
      "start": 16390.88,
      "end": 16392.88,
      "formatted_start": "04:33:10.880",
      "formatted_end": "04:33:12.880",
      "text": "اگه نگفت به ما گفت بره رو"
    },
    {
      "id": 46,
      "start": 16392.88,
      "end": 16393.88,
      "formatted_start": "04:33:12.880",
      "formatted_end": "04:33:13.880",
      "text": "آره دیگه"
    },
    {
      "id": 47,
      "start": 16393.88,
      "end": 16394.88,
      "formatted_start": "04:33:13.880",
      "formatted_end": "04:33:14.880",
      "text": "اگه می گفت که"
    },
    {
      "id": 48,
      "start": 16394.88,
      "end": 16396.88,
      "formatted_start": "04:33:14.880",
      "formatted_end": "04:33:16.880",
      "text": "یکی برند پیش خود آیا دکتر میدیست و برام کنه؟"
    },
    {
      "id": 49,
      "start": 16396.88,
      "end": 16400.88,
      "formatted_start": "04:33:16.880",
      "formatted_end": "04:33:20.880",
      "text": "نه، میانداد شد سر شد، خیلی شده بچه شد"
    },
    {
      "id": 50,
      "start": 16400.88,
      "end": 16403.88,
      "formatted_start": "04:33:20.880",
      "formatted_end": "04:33:23.880",
      "text": "هم این کارها رو بکنه، انجام میشه"
    },
    {
      "id": 51,
      "start": 16403.88,
      "end": 16408.88,
      "formatted_start": "04:33:23.880",
      "formatted_end": "04:33:28.880",
      "text": "نه شدم، یکی از مخصص های داخلیشون، دکتر حسینی بری برده توزیع نشد"
    },
    {
      "id": 52,
      "start": 16408.88,
      "end": 16413.88,
      "formatted_start": "04:33:28.880",
      "formatted_end": "04:33:33.880",
      "text": "یکی از مخصصی داخلی آقای میده، بیا آقا من خواهد هم مولست، بسترش همین چشم هم پانه مرد کن"
    },
    {
      "id": 53,
      "start": 16413.88,
      "end": 16415.88,
      "formatted_start": "04:33:33.880",
      "formatted_end": "04:33:35.880",
      "text": "همون جایی میان کارتن انجام"
    },
    {
      "id": 54,
      "start": 16415.88,
      "end": 16418.88,
      "formatted_start": "04:33:35.880",
      "formatted_end": "04:33:38.880",
      "text": "ببین، راحت فره این راهه"
    },
    {
      "id": 55,
      "start": 16418.88,
      "end": 16423.28,
      "formatted_start": "04:33:38.880",
      "formatted_end": "04:33:43.280",
      "text": "و اینجا هم بعد مثلا وندتون مطور شده در کار میدونید ویدیو تا من بستریم"
    },
    {
      "id": 56,
      "start": 16423.28,
      "end": 16426.28,
      "formatted_start": "04:33:43.280",
      "formatted_end": "04:33:46.280",
      "text": "شاید هموجا بیادم همه تو انجام داره وندتون مد کنم"
    },
    {
      "id": 57,
      "start": 16426.28,
      "end": 16429.28,
      "formatted_start": "04:33:46.280",
      "formatted_end": "04:33:49.280",
      "text": "این باله هاشو لطفا فرق کنید خب"
    },
    {
      "id": 58,
      "start": 16429.28,
      "end": 16433.28,
      "formatted_start": "04:33:49.280",
      "formatted_end": "04:33:53.280",
      "text": "از این نام هم کوپی داشته باشید وقتی باز بیرمه نخواهید"
    },
    {
      "id": 59,
      "start": 16433.28,
      "end": 16434.28,
      "formatted_start": "04:33:53.280",
      "formatted_end": "04:33:54.280",
      "text": "داشتونه"
    },
    {
      "id": 60,
      "start": 16434.28,
      "end": 16438.28,
      "formatted_start": "04:33:54.280",
      "formatted_end": "04:33:58.280",
      "text": "سلامت باشید این هم پودره کلی تعیید کنید بعد به این داره هاشونو بگیریم"
    },
    {
      "id": 61,
      "start": 16438.28,
      "end": 16440.28,
      "formatted_start": "04:33:58.280",
      "formatted_end": "04:34:00.280",
      "text": "باید بگیرم"
    },
    {
      "id": 62,
      "start": 16440.28,
      "end": 16441.28,
      "formatted_start": "04:34:00.280",
      "formatted_end": "04:34:01.280",
      "text": "بیا نه"
    },
    {
      "id": 63,
      "start": 16441.28,
      "end": 16443.28,
      "formatted_start": "04:34:01.280",
      "formatted_end": "04:34:03.280",
      "text": "نه نه داشته باشین که تایید شد"
    },
    {
      "id": 64,
      "start": 16443.28,
      "end": 16445.28,
      "formatted_start": "04:34:03.280",
      "formatted_end": "04:34:05.280",
      "text": "و بعد برید انسان نه هاشمان هم بگیریم"
    },
    {
      "id": 65,
      "start": 16445.28,
      "end": 16447.28,
      "formatted_start": "04:34:05.280",
      "formatted_end": "04:34:07.280",
      "text": "داشته باشین"
    },
    {
      "id": 66,
      "start": 16447.28,
      "end": 16449.28,
      "formatted_start": "04:34:07.280",
      "formatted_end": "04:34:09.280",
      "text": "اینجا خودتونه اعتداد شخصیه"
    },
    {
      "id": 67,
      "start": 16449.28,
      "end": 16451.28,
      "formatted_start": "04:34:09.280",
      "formatted_end": "04:34:11.280",
      "text": "پرش کنید"
    },
    {
      "id": 68,
      "start": 16451.28,
      "end": 16453.28,
      "formatted_start": "04:34:11.280",
      "formatted_end": "04:34:13.280",
      "text": "داشته باشین"
    },
    {
      "id": 69,
      "start": 16453.28,
      "end": 16455.28,
      "formatted_start": "04:34:13.280",
      "formatted_end": "04:34:15.280",
      "text": "خدا خیلی باشین"
    },
    {
      "id": 70,
      "start": 16455.28,
      "end": 16469.28,
      "formatted_start": "04:34:15.280",
      "formatted_end": "04:34:29.280",
      "text": "موسیقی"
    },
    {
      "id": 71,
      "start": 16469.28,
      "end": 16471.28,
      "formatted_start": "04:34:29.280",
      "formatted_end": "04:34:31.280",
      "text": "مرد در اینجا باید بردارید."
    },
    {
      "id": 72,
      "start": 16499.28,
      "end": 16501.28,
      "formatted_start": "04:34:59.280",
      "formatted_end": "04:35:01.280",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}