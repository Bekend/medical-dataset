    {
      "id": 33,
      "start": 11808.66,
      "end": 11810.66,
      "formatted_start": "03:16:48.660",
      "formatted_end": "03:16:50.660",
      "text": "مرسی کنید"
    },
    {
      "id": 34,
      "start": 11810.66,
      "end": 11812.66,
      "formatted_start": "03:16:50.660",
      "formatted_end": "03:16:52.660",
      "text": "مرسی کنید"
    },
    {
      "id": 35,
      "start": 11812.66,
      "end": 11814.66,
      "formatted_start": "03:16:52.660",
      "formatted_end": "03:16:54.660",
      "text": "مرسی کنید"
    },
    {
      "id": 36,
      "start": 11814.66,
      "end": 11816.66,
      "formatted_start": "03:16:54.660",
      "formatted_end": "03:16:56.660",
      "text": "مرسی کنید"
    },
    {
      "id": 37,
      "start": 11816.66,
      "end": 11818.66,
      "formatted_start": "03:16:56.660",
      "formatted_end": "03:16:58.660",
      "text": "مرسی کنید"
    },
    {
      "id": 38,
      "start": 11818.66,
      "end": 11820.66,
      "formatted_start": "03:16:58.660",
      "formatted_end": "03:17:00.660",
      "text": "مرسی کنید"
    },
    {
      "id": 39,
      "start": 11820.66,
      "end": 11822.66,
      "formatted_start": "03:17:00.660",
      "formatted_end": "03:17:02.660",
      "text": "جلو باده کله رو پنکه نم پرداشتید"
    },
    {
      "id": 40,
      "start": 11822.66,
      "end": 11824.66,
      "formatted_start": "03:17:02.660",
      "formatted_end": "03:17:04.660",
      "text": "باده بخورو تو صورتت"
    },
    {
      "id": 41,
      "start": 11824.66,
      "end": 11826.66,
      "formatted_start": "03:17:04.660",
      "formatted_end": "03:17:06.660",
      "text": "میشه"
    },
    {
      "id": 42,
      "start": 11826.66,
      "end": 11828.66,
      "formatted_start": "03:17:06.660",
      "formatted_end": "03:17:08.660",
      "text": "همون میری متقا من خوش کنی"
    },
    {
      "id": 43,
      "start": 11828.66,
      "end": 11830.66,
      "formatted_start": "03:17:08.660",
      "formatted_end": "03:17:10.660",
      "text": "با مخیص نخواد"
    },
    {
      "id": 44,
      "start": 11830.66,
      "end": 11832.66,
      "formatted_start": "03:17:10.660",
      "formatted_end": "03:17:12.660",
      "text": "بعد تا من"
    },
    {
      "id": 45,
      "start": 11832.66,
      "end": 11834.66,
      "formatted_start": "03:17:12.660",
      "formatted_end": "03:17:14.660",
      "text": "تنها میخوام"
    },
    {
      "id": 46,
      "start": 11840.66,
      "end": 11842.66,
      "formatted_start": "03:17:20.660",
      "formatted_end": "03:17:22.660",
      "text": "دو تا صافت میکنی همه"
    },
    {
      "id": 47,
      "start": 11842.66,
      "end": 11844.66,
      "formatted_start": "03:17:22.660",
      "formatted_end": "03:17:24.660",
      "text": "جا"
    },
    {
      "id": 48,
      "start": 11844.66,
      "end": 11846.66,
      "formatted_start": "03:17:24.660",
      "formatted_end": "03:17:26.660",
      "text": "یاد نه"
    },
    {
      "id": 49,
      "start": 11846.66,
      "end": 11848.66,
      "formatted_start": "03:17:26.660",
      "formatted_end": "03:17:28.660",
      "text": "خوارش نداده"
    },
    {
      "id": 50,
      "start": 11848.66,
      "end": 11852.66,
      "formatted_start": "03:17:28.660",
      "formatted_end": "03:17:32.660",
      "text": "خوشم خیلی بخوره"
    },
    {
      "id": 51,
      "start": 11852.66,
      "end": 11854.66,
      "formatted_start": "03:17:32.660",
      "formatted_end": "03:17:34.660",
      "text": "هتاب؟"
    },
    {
      "id": 52,
      "start": 11854.66,
      "end": 11858.66,
      "formatted_start": "03:17:34.660",
      "formatted_end": "03:17:38.660",
      "text": "هتاب همه روزه هاته"
    },
    {
      "id": 53,
      "start": 11863.66,
      "end": 11866.66,
      "formatted_start": "03:17:43.660",
      "formatted_end": "03:17:46.660",
      "text": "قبل از ترما خورده بودی یک هفته به ارزبه؟"
    },
    {
      "id": 54,
      "start": 11866.66,
      "end": 11868.66,
      "formatted_start": "03:17:46.660",
      "formatted_end": "03:17:48.660",
      "text": "نه نه"
    },
    {
      "id": 55,
      "start": 11868.66,
      "end": 11877.66,
      "formatted_start": "03:17:48.660",
      "formatted_end": "03:17:57.660",
      "text": "من چون به خاطر تیرویدم بود که من سال گذاشته اصلا ترما نداشتم"
    },
    {
      "id": 56,
      "start": 11877.66,
      "end": 11883.66,
      "formatted_start": "03:17:57.660",
      "formatted_end": "03:18:03.660",
      "text": "اما که تیاری بودم نرماله، بازم تیاری تسلیم من نمیدونم"
    },
    {
      "id": 57,
      "start": 11883.66,
      "end": 11887.66,
      "formatted_start": "03:18:03.660",
      "formatted_end": "03:18:07.660",
      "text": "این جاییدن زیاد زیر باز کلر همشیه که"
    },
    {
      "id": 58,
      "start": 11887.66,
      "end": 11889.66,
      "formatted_start": "03:18:07.660",
      "formatted_end": "03:18:09.660",
      "text": "آره به خاطر اونه در بودن"
    },
    {
      "id": 59,
      "start": 11889.66,
      "end": 11892.66,
      "formatted_start": "03:18:09.660",
      "formatted_end": "03:18:12.660",
      "text": "امسا خیلی گرم و عذیب هم"
    },
    {
      "id": 60,
      "start": 11892.66,
      "end": 11897.66,
      "formatted_start": "03:18:12.660",
      "formatted_end": "03:18:17.660",
      "text": "آره، اون موقع کم کار بودی، الان هم چند سالی تا از کجا"
    },
    {
      "id": 61,
      "start": 11897.66,
      "end": 11901.66,
      "formatted_start": "03:18:17.660",
      "formatted_end": "03:18:21.660",
      "text": "اون موقع دینا عادت شد و توش شد؟"
    },
    {
      "id": 62,
      "start": 11901.66,
      "end": 11905.66,
      "formatted_start": "03:18:21.660",
      "formatted_end": "03:18:25.660",
      "text": "مادرم چه رو سه چار سالی یارست شد"
    },
    {
      "id": 63,
      "start": 11905.66,
      "end": 11915.66,
      "formatted_start": "03:18:25.660",
      "formatted_end": "03:18:35.660",
      "text": "اگر پریاداتون به هم ریخ باید بررسی کنید، باید بررسی کنید."
    },
    {
      "id": 64,
      "start": 11915.66,
      "end": 11925.66,
      "formatted_start": "03:18:35.660",
      "formatted_end": "03:18:45.660",
      "text": "اگر بررسی کنید، باید بررسی کنید."
    },
    {
      "id": 65,
      "start": 11925.66,
      "end": 11955.66,
      "formatted_start": "03:18:45.660",
      "formatted_end": "03:19:15.660",
      "text": "از این وقت، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد،"
    },
    {
      "id": 66,
      "start": 11955.66,
      "end": 11962.66,
      "formatted_start": "03:19:15.660",
      "formatted_end": "03:19:22.660",
      "text": "چربی و شیرنی زیاد نخواهید. قندر شربی نداری خواهید ولی زیاد روی هم نخواهید."
    },
    {
      "id": 67,
      "start": 11962.66,
      "end": 11967.66,
      "formatted_start": "03:19:22.660",
      "formatted_end": "03:19:27.660",
      "text": "کلا رهن شیرنی نیستم ولی هم موانم و بابا دیابت دارن."
    },
    {
      "id": 68,
      "start": 11967.66,
      "end": 11971.66,
      "formatted_start": "03:19:27.660",
      "formatted_end": "03:19:31.660",
      "text": "آره جنتیک مهم. تیرویدتون قرمز و قایستتون دست دارن."
    },
    {
      "id": 69,
      "start": 11971.66,
      "end": 11974.66,
      "formatted_start": "03:19:31.660",
      "formatted_end": "03:19:34.660",
      "text": "بله بله لباتروسی هم. خوب جلنش بردید."
    },
    {
      "id": 70,
      "start": 11985.66,
      "end": 11987.66,
      "formatted_start": "03:19:45.660",
      "formatted_end": "03:19:47.660",
      "text": "از شما در اینجا هستید؟"
    },
    {
      "id": 71,
      "start": 11987.66,
      "end": 11989.66,
      "formatted_start": "03:19:47.660",
      "formatted_end": "03:19:49.660",
      "text": "چای بیان دارید؟"
    },
    {
      "id": 72,
      "start": 11989.66,
      "end": 11991.66,
      "formatted_start": "03:19:49.660",
      "formatted_end": "03:19:51.660",
      "text": "چای"
    },
    {
      "id": 73,
      "start": 11993.66,
      "end": 11995.66,
      "formatted_start": "03:19:53.660",
      "formatted_end": "03:19:55.660",
      "text": "باش"
    },
    {
      "id": 74,
      "start": 11995.66,
      "end": 11997.66,
      "formatted_start": "03:19:55.660",
      "formatted_end": "03:19:57.660",
      "text": "باش"
    }
  ],
  "status": "completed"
}