  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11715.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:15.000",
      "text": "باید کم کنی، نداریم به رکت های نرمانی و بعدها استعمالی نرمانه، سیاسی گرزش نرمانه، با سر نکن تطور دارم، برنزون خوده، کلیه خوده، چرم بی خوبه، نرم از دیگر، آدم نگه با ما نیاد، مزه خود."
    },
    {
      "id": 1,
      "start": 11715.0,
      "end": 11728.0,
      "formatted_start": "03:15:15.000",
      "formatted_end": "03:15:28.000",
      "text": "آزمای که همه نرمانه، زخمه آهنگ مترسید روی پایینه، زخمه مزه صاخی، آهنگ کم بود و ڈیتامین دیم."
    },
    {
      "id": 2,
      "start": 11728.0,
      "end": 11735.0,
      "formatted_start": "03:15:28.000",
      "formatted_end": "03:15:35.000",
      "text": "سابقه تیورید دارم قرص استفاده بکنم رو زیر دونه"
    },
    {
      "id": 3,
      "start": 11735.0,
      "end": 11737.0,
      "formatted_start": "03:15:35.000",
      "formatted_end": "03:15:37.000",
      "text": "جمعه نصف بگیر"
    },
    {
      "id": 4,
      "start": 11737.0,
      "end": 11739.24,
      "formatted_start": "03:15:37.000",
      "formatted_end": "03:15:39.240",
      "text": "جمعه نصف بخوری بگیر"
    },
    {
      "id": 5,
      "start": 11739.24,
      "end": 11742.5,
      "formatted_start": "03:15:39.240",
      "formatted_end": "03:15:42.500",
      "text": "چون اومدی از میمن به پایین"
    },
    {
      "id": 6,
      "start": 11742.5,
      "end": 11745.0,
      "formatted_start": "03:15:42.500",
      "formatted_end": "03:15:45.000",
      "text": "اونطور قرص ها هم پریاداتون شدیده؟"
    },
    {
      "id": 7,
      "start": 11745.8,
      "end": 11748.46,
      "formatted_start": "03:15:45.800",
      "formatted_end": "03:15:48.460",
      "text": "حتی این یه روز بعد از پریادی من حرف همونه"
    },
    {
      "id": 8,
      "start": 11748.46,
      "end": 11750.0,
      "formatted_start": "03:15:48.460",
      "formatted_end": "03:15:50.000",
      "text": "نه پدرین زخمیتون هم دونستاخان"
    },
    {
      "id": 9,
      "start": 11750.62,
      "end": 11752.0,
      "formatted_start": "03:15:50.620",
      "formatted_end": "03:15:52.000",
      "text": "در واقع این انباره"
    },
    {
      "id": 10,
      "start": 11752.54,
      "end": 11755.66,
      "formatted_start": "03:15:52.540",
      "formatted_end": "03:15:55.660",
      "text": "نه من خیلی شدید نیست"
    },
    {
      "id": 11,
      "start": 11755.66,
      "end": 11758.66,
      "formatted_start": "03:15:55.660",
      "formatted_end": "03:15:58.660",
      "text": "بشه همه چیزی رو میخوری یعنی یا بودی؟"
    },
    {
      "id": 12,
      "start": 11758.66,
      "end": 11761.66,
      "formatted_start": "03:15:58.660",
      "formatted_end": "03:16:01.660",
      "text": "میخورم بهتون رو ماندی، حدا هفته یکی"
    },
    {
      "id": 13,
      "start": 11761.66,
      "end": 11763.66,
      "formatted_start": "03:16:01.660",
      "formatted_end": "03:16:03.660",
      "text": "بله بسیار، هفته یکی باشه"
    },
    {
      "id": 14,
      "start": 11763.66,
      "end": 11767.66,
      "formatted_start": "03:16:03.660",
      "formatted_end": "03:16:07.660",
      "text": "خب من خورساها هم برگرده، سه ماه باید بخورم"
    },
    {
      "id": 15,
      "start": 11767.66,
      "end": 11769.66,
      "formatted_start": "03:16:07.660",
      "formatted_end": "03:16:09.660",
      "text": "میتونم کجا ناخواهیم"
    },
    {
      "id": 16,
      "start": 11769.66,
      "end": 11771.66,
      "formatted_start": "03:16:09.660",
      "formatted_end": "03:16:11.660",
      "text": "میتونید ماهی یک گره پری هزار بخورم"
    },
    {
      "id": 17,
      "start": 11771.66,
      "end": 11772.66,
      "formatted_start": "03:16:11.660",
      "formatted_end": "03:16:12.660",
      "text": "پنجه هزار بخورم"
    },
    {
      "id": 18,
      "start": 11772.66,
      "end": 11776.66,
      "formatted_start": "03:16:12.660",
      "formatted_end": "03:16:16.660",
      "text": "دو ماه باید پنجه هزار بخوریم، بعد دوبار برگردی به ماهی یک گره"
    },
    {
      "id": 19,
      "start": 11776.66,
      "end": 11784.66,
      "formatted_start": "03:16:16.660",
      "formatted_end": "03:16:24.660",
      "text": "خورسه ها رو برچون می نمی سمیدونه چون خارجی آزاده شما سه دوره دیگه دو دوره بجاز این بار بخورید خب؟"
    },
    {
      "id": 20,
      "start": 11784.66,
      "end": 11785.66,
      "formatted_start": "03:16:24.660",
      "formatted_end": "03:16:25.660",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 11787.66,
      "end": 11789.66,
      "formatted_start": "03:16:27.660",
      "formatted_end": "03:16:29.660",
      "text": "خورسه تیوید هم برای ما می نیستیم"
    },
    {
      "id": 22,
      "start": 11789.66,
      "end": 11790.66,
      "formatted_start": "03:16:29.660",
      "formatted_end": "03:16:30.660",
      "text": "آقا"
    },
    {
      "id": 23,
      "start": 11790.66,
      "end": 11791.66,
      "formatted_start": "03:16:30.660",
      "formatted_end": "03:16:31.660",
      "text": "چشم برمی سازیست؟"
    },
    {
      "id": 24,
      "start": 11791.66,
      "end": 11792.66,
      "formatted_start": "03:16:31.660",
      "formatted_end": "03:16:32.660",
      "text": "بله"
    },
    {
      "id": 25,
      "start": 11792.66,
      "end": 11794.66,
      "formatted_start": "03:16:32.660",
      "formatted_end": "03:16:34.660",
      "text": "مرسی کنید"
    },
    {
      "id": 26,
