  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15307.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:07.000",
      "text": "از رو بلند شد، شاید کار کنه زیاد انجام کنه خوب، ولی فعالیت هم زیاده چیزی رو بچه ها خیلی عذیب دارن."
    },
    {
      "id": 1,
      "start": 15307.0,
      "end": 15309.0,
      "formatted_start": "04:15:07.000",
      "formatted_end": "04:15:09.000",
      "text": "بچه ها چیزی کنه؟"
    },
    {
      "id": 2,
      "start": 15309.0,
      "end": 15320.0,
      "formatted_start": "04:15:09.000",
      "formatted_end": "04:15:20.000",
      "text": "خیلی، بشین پاشو، این کار انجام بده، بریزم خواه جمع میکنی، بخواه زرخ داشتی رو برای شما، یه سره بقیه میگن گرسته، بخواه خصوص درست کنی، بخواه این ها فعالیت داره دیگه."
    },
    {
      "id": 3,
      "start": 15320.0,
      "end": 15322.0,
      "formatted_start": "04:15:20.000",
      "formatted_end": "04:15:22.000",
      "text": "آره"
    },
    {
      "id": 4,
      "start": 15322.0,
      "end": 15326.0,
      "formatted_start": "04:15:22.000",
      "formatted_end": "04:15:26.000",
      "text": "خوشتره کار میاد و کار خیلی باقید میگرد"
    },
    {
      "id": 5,
      "start": 15326.0,
      "end": 15328.0,
      "formatted_start": "04:15:26.000",
      "formatted_end": "04:15:28.000",
      "text": "کار بینید نداره"
    },
    {
      "id": 6,
      "start": 15328.0,
      "end": 15333.0,
      "formatted_start": "04:15:28.000",
      "formatted_end": "04:15:33.000",
      "text": "الان خودم مثلا مثلا وسیله بودم توی کنه مثلا آنهایی میفروشم"
    },
    {
      "id": 7,
      "start": 15333.0,
      "end": 15335.0,
      "formatted_start": "04:15:33.000",
      "formatted_end": "04:15:35.000",
      "text": "آره آنها خود رو بود"
    },
    {
      "id": 8,
      "start": 15335.0,
      "end": 15340.0,
      "formatted_start": "04:15:35.000",
      "formatted_end": "04:15:40.000",
      "text": "از آن باید بیدونی کار برگیران تحرک داشته باشه"
    },
    {
      "id": 9,
      "start": 15343.0,
      "end": 15345.0,
      "formatted_start": "04:15:43.000",
      "formatted_end": "04:15:45.000",
      "text": "از این باقید"
    },
    {
      "id": 10,
      "start": 15345.0,
      "end": 15351.0,
      "formatted_start": "04:15:45.000",
      "formatted_end": "04:15:51.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 15375.0,
      "end": 15377.0,
      "formatted_start": "04:16:15.000",
      "formatted_end": "04:16:17.000",
      "text": "این چیز شد؟"
    },
    {
      "id": 12,
      "start": 15377.0,
      "end": 15378.0,
      "formatted_start": "04:16:17.000",
      "formatted_end": "04:16:18.000",
      "text": "خیلی خوب."
    },
    {
      "id": 13,
      "start": 15378.0,
      "end": 15380.0,
      "formatted_start": "04:16:18.000",
      "formatted_end": "04:16:20.000",
      "text": "آرام بود بابا شد و میره بشه."
    },
    {
      "id": 14,
      "start": 15380.0,
      "end": 15382.0,
      "formatted_start": "04:16:20.000",
      "formatted_end": "04:16:22.000",
      "text": "آرام بود بابا شد."
    },
    {
      "id": 15,
      "start": 15385.0,
      "end": 15387.0,
      "formatted_start": "04:16:25.000",
      "formatted_end": "04:16:27.000",
      "text": "بابا باید هر سه شد."
    },
    {
      "id": 16,
      "start": 15387.0,
      "end": 15389.0,
      "formatted_start": "04:16:27.000",
      "formatted_end": "04:16:29.000",
      "text": "دو بچه بیشتر آراده."
    },
    {
      "id": 17,
      "start": 15389.0,
      "end": 15391.0,
      "formatted_start": "04:16:29.000",
      "formatted_end": "04:16:31.000",
      "text": "دو بچه بیشتر آراده و"
    },
    {
      "id": 18,
      "start": 15391.0,
      "end": 15393.0,
      "formatted_start": "04:16:31.000",
      "formatted_end": "04:16:33.000",
      "text": "یه سه تبتش داره."
    },
    {
      "id": 19,
      "start": 15393.0,
      "end": 15395.0,
      "formatted_start": "04:16:33.000",
      "formatted_end": "04:16:35.000",
      "text": "بابا تا اصلا برد."
    },
    {
      "id": 20,
      "start": 15395.0,
      "end": 15397.0,
      "formatted_start": "04:16:35.000",
      "formatted_end": "04:16:37.000",
      "text": "بابا خوش همه یه تبتش هر زمین برد."
    },
    {
      "id": 21,
      "start": 15397.0,
      "end": 15399.0,
      "formatted_start": "04:16:37.000",
      "formatted_end": "04:16:39.000",
      "text": "بابا تا اصلا برد."
    },
    {
      "id": 22,
      "start": 15401.0,
      "end": 15403.0,
      "formatted_start": "04:16:41.000",
      "formatted_end": "04:16:43.000",
      "text": "اصلا برد و یه زن نو هست باید بیرون کنی."
    },
    {
      "id": 23,
      "start": 15403.0,
      "end": 15405.0,
      "formatted_start": "04:16:43.000",
      "formatted_end": "04:16:45.000",
      "text": "چنداس ها؟"
    },
    {
      "id": 24,
      "start": 15405.0,
      "end": 15407.0,
      "formatted_start": "04:16:45.000",
      "formatted_end": "04:16:47.000",
      "text": "چنداس نیست؟"
    },
    {
      "id": 25,
      "start": 15407.0,
      "end": 15409.0,
      "formatted_start": "04:16:47.000",
      "formatted_end": "04:16:49.000",
      "text": "چنداس ها همه چنداس ها هست؟"
    },
    {
      "id": 26,
      "start": 15409.0,
      "end": 15411.0,
      "formatted_start": "04:16:49.000",
      "formatted_end": "04:16:51.000",
      "text": "چنداس ها همه چنداس ها هست؟"
    },
    {
      "id": 27,
      "start": 15411.0,
      "end": 15413.0,
      "formatted_start": "04:16:51.000",
      "formatted_end": "04:16:53.000",
      "text": "چنداس ها همه چنداس ها هست؟"
    },
    {
      "id": 28,
      "start": 15413.0,
      "end": 15415.0,
      "formatted_start": "04:16:53.000",
      "formatted_end": "04:16:55.000",
      "text": "چنداس ها همه چنداس ها هست؟"
    },
    {
      "id": 29,
      "start": 15415.0,
      "end": 15417.0,
      "formatted_start": "04:16:55.000",
      "formatted_end": "04:16:57.000",
      "text": "شاید برده که سهمیت آواز داشت برده منو چرا برم"
    },
    {
      "id": 30,
      "start": 15417.0,
      "end": 15419.0,
      "formatted_start": "04:16:57.000",
      "formatted_end": "04:16:59.000",
      "text": "شاید برده که سهمیت آواز داشت برم"
    },
    {
      "id": 31,
      "start": 15419.0,
      "end": 15421.0,
      "formatted_start": "04:16:59.000",
      "formatted_end": "04:17:01.000",
      "text": "از سهمیت برده که خودتون رو چه نمیسون"
    },
    {
      "id": 32,
      "start": 15421.0,
      "end": 15423.0,
      "formatted_start": "04:17:01.000",
      "formatted_end": "04:17:03.000",
      "text": "خودتون رو چه نمیسون"
    },
    {
      "id": 33,
      "start": 15423.0,
      "end": 15425.0,
      "formatted_start": "04:17:03.000",
      "formatted_end": "04:17:05.000",
      "text": "خواب بابا اون سهمیت رو نه رفته"
    },
    {
      "id": 34,
      "start": 15425.0,
      "end": 15428.0,
      "formatted_start": "04:17:05.000",
      "formatted_end": "04:17:08.000",
      "text": "اینجایی سبت کنند که این سهمیه داره یا نداره"
    },
    {
      "id": 35,
      "start": 15428.0,
      "end": 15431.0,
      "formatted_start": "04:17:08.000",
      "formatted_end": "04:17:11.000",
      "text": "الان هیچ حوضی نمیدونیم جز اون برگاه"
    },
    {
      "id": 36,
      "start": 15431.0,
      "end": 15433.0,
      "formatted_start": "04:17:11.000",
      "formatted_end": "04:17:13.000",
      "text": "مثلا یه بزرگ برگاه"
    },
    {
      "id": 37,
      "start": 15433.0,
      "end": 15435.0,
      "formatted_start": "04:17:13.000",
      "formatted_end": "04:17:15.000",
      "text": "هرچی هم بهش گفتیم برو مثلا"
    },
    {
      "id": 38,
      "start": 15435.0,
      "end": 15438.0,
      "formatted_start": "04:17:15.000",
      "formatted_end": "04:17:18.000",
      "text": "یه جا بزرگ بزرگ"
    },
    {
      "id": 39,
      "start": 15438.0,
      "end": 15441.0,
      "formatted_start": "04:17:18.000",
      "formatted_end": "04:17:21.000",
      "text": "کسی که پرستاری جانواز آبراه"
    },
    {
      "id": 40,
      "start": 15441.0,
      "end": 15443.0,
      "formatted_start": "04:17:21.000",
      "formatted_end": "04:17:23.000",
      "text": "حق پرستاری هم بهش میدهند"
    },
    {
      "id": 41,
      "start": 15443.0,
      "end": 15445.0,
      "formatted_start": "04:17:23.000",
      "formatted_end": "04:17:25.000",
      "text": "مثلا به خانمش میدهند چون تورانی همون بودند اینجوری"
    },
    {
      "id": 42,
      "start": 15445.0,
      "end": 15447.0,
      "formatted_start": "04:17:25.000",
      "formatted_end": "04:17:27.000",
      "text": "گفتیم برو نه نه بخواد"
    },
    {
      "id": 43,
      "start": 15447.0,
      "end": 15449.0,
      "formatted_start": "04:17:27.000",
      "formatted_end": "04:17:29.000",
      "text": "چرا حق دیگرانه بخورم"
    },
    {
      "id": 44,
      "start": 15449.0,
      "end": 15451.0,
      "formatted_start": "04:17:29.000",
      "formatted_end": "04:17:31.000",
      "text": "برگاه همون چیز دیگه بستید"
    },
    {
      "id": 45,
      "start": 15455.0,
      "end": 15457.0,
      "formatted_start": "04:17:35.000",
      "formatted_end": "04:17:37.000",
      "text": "موقع نزدیک ترد داری؟"
    },
    {
      "id": 46,
      "start": 15459.0,
      "end": 15461.0,
      "formatted_start": "04:17:39.000",
      "formatted_end": "04:17:41.000",
      "text": "همیشه نبرده برده"
    },
    {
      "id": 47,
      "start": 15461.0,
      "end": 15463.0,
      "formatted_start": "04:17:41.000",
      "formatted_end": "04:17:43.000",
      "text": "ترشاتاتو فهم میده؟"
    },
    {
      "id": 48,
      "start": 15463.0,
      "end": 15465.0,
      "formatted_start": "04:17:43.000",
      "formatted_end": "04:17:45.000",
      "text": "آره، من او فهمت بگو برم"
    },
    {
      "id": 49,
      "start": 15465.0,
      "end": 15467.0,
      "formatted_start": "04:17:45.000",
      "formatted_end": "04:17:47.000",
      "text": "که من بگو بشم بیدم برم"
    },
    {
      "id": 50,
      "start": 15467.0,
      "end": 15469.0,
      "formatted_start": "04:17:47.000",
      "formatted_end": "04:17:49.000",
      "text": "بیمنم بگی؟"
    },
    {
      "id": 51,
      "start": 15469.0,
      "end": 15471.0,
      "formatted_start": "04:17:49.000",
      "formatted_end": "04:17:51.000",
      "text": "همین چی؟"
    },
    {
      "id": 52,
      "start": 15471.0,
      "end": 15473.0,
      "formatted_start": "04:17:51.000",
      "formatted_end": "04:17:53.000",
      "text": "خارش داری؟"
    },
    {
      "id": 53,
      "start": 15473.0,
      "end": 15475.0,
      "formatted_start": "04:17:53.000",
      "formatted_end": "04:17:55.000",
      "text": "خارش نه"
    },
    {
      "id": 54,
      "start": 15475.0,
      "end": 15477.0,
      "formatted_start": "04:17:55.000",
      "formatted_end": "04:17:57.000",
      "text": "بخوا درد لگنه اونو بیشتر سمت راست داره"
    },
    {
      "id": 55,
      "start": 15477.0,
      "end": 15479.0,
      "formatted_start": "04:17:57.000",
      "formatted_end": "04:17:59.000",
      "text": "خب درده بردی؟"
    },
    {
      "id": 56,
      "start": 15479.0,
      "end": 15481.0,
      "formatted_start": "04:17:59.000",
      "formatted_end": "04:18:01.000",
      "text": "صبح جدید هم نرم"
    },
    {
      "id": 57,
      "start": 15481.0,
      "end": 15483.0,
      "formatted_start": "04:18:01.000",
      "formatted_end": "04:18:03.000",
      "text": "از که نرم داری؟"
    },
    {
      "id": 58,
      "start": 15483.0,
      "end": 15485.0,
      "formatted_start": "04:18:03.000",
      "formatted_end": "04:18:05.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 59,
      "start": 15485.0,
      "end": 15487.0,
      "formatted_start": "04:18:05.000",
      "formatted_end": "04:18:07.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 60,
      "start": 15487.0,
      "end": 15489.0,
      "formatted_start": "04:18:07.000",
      "formatted_end": "04:18:09.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 61,
      "start": 15489.0,
      "end": 15491.0,
      "formatted_start": "04:18:09.000",
      "formatted_end": "04:18:11.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 62,
      "start": 15491.0,
      "end": 15493.0,
      "formatted_start": "04:18:11.000",
      "formatted_end": "04:18:13.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 63,
      "start": 15493.0,
      "end": 15495.0,
      "formatted_start": "04:18:13.000",
      "formatted_end": "04:18:15.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 64,
      "start": 15495.0,
      "end": 15497.0,
      "formatted_start": "04:18:15.000",
      "formatted_end": "04:18:17.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 65,
      "start": 15497.0,
      "end": 15499.0,
      "formatted_start": "04:18:17.000",
      "formatted_end": "04:18:19.000",
      "text": "اینجا همچنین باید درست داریم"
    },
    {
      "id": 66,
      "start": 15499.0,
      "end": 15501.0,
      "formatted_start": "04:18:19.000",
      "formatted_end": "04:18:21.000",
      "text": "اینجا همچنین باید درست داریم"
    },
