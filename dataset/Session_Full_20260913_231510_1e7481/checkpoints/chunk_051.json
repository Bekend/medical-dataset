      "id": 70,
      "start": 15507.0,
      "end": 15509.0,
      "formatted_start": "04:18:27.000",
      "formatted_end": "04:18:29.000",
      "text": "اندازه رابطه نه"
    },
    {
      "id": 71,
      "start": 15515.0,
      "end": 15519.0,
      "formatted_start": "04:18:35.000",
      "formatted_end": "04:18:39.000",
      "text": "چون اگه درسته بهش مشکل بودیم بهش به بانمت باشیم"
    },
    {
      "id": 72,
      "start": 15519.0,
      "end": 15521.0,
      "formatted_start": "04:18:39.000",
      "formatted_end": "04:18:41.000",
      "text": "نه الان جدیدن که عمر داشت"
    },
    {
      "id": 73,
      "start": 15521.0,
      "end": 15525.0,
      "formatted_start": "04:18:41.000",
      "formatted_end": "04:18:45.000",
      "text": "عمر نه بخصوص خوشبون و مدازه به اونو هم"
    },
    {
      "id": 74,
      "start": 15525.0,
      "end": 15527.0,
      "formatted_start": "04:18:45.000",
      "formatted_end": "04:18:47.000",
      "text": "اصلا باده کرد"
    },
    {
      "id": 75,
      "start": 15527.0,
      "end": 15529.0,
      "formatted_start": "04:18:47.000",
      "formatted_end": "04:18:49.000",
      "text": "نه عمر نه"
    },
    {
      "id": 76,
      "start": 15529.0,
      "end": 15531.0,
      "formatted_start": "04:18:49.000",
      "formatted_end": "04:18:51.000",
      "text": "اتفاقا بهش گفتم گفتم که شاید ما به نه دارم"
    },
    {
      "id": 77,
      "start": 15531.0,
      "end": 15533.0,
      "formatted_start": "04:18:51.000",
      "formatted_end": "04:18:53.000",
      "text": "از تو افتاده نداریم"
    },
    {
      "id": 78,
      "start": 15533.0,
      "end": 15535.0,
      "formatted_start": "04:18:53.000",
      "formatted_end": "04:18:55.000",
      "text": "نه ما خودمون از کجا مطمئن افتاده نداریم"
    },
    {
      "id": 79,
      "start": 15537.0,
      "end": 15539.0,
      "formatted_start": "04:18:57.000",
      "formatted_end": "04:18:59.000",
      "text": "نه"
    },
    {
      "id": 80,
      "start": 15539.0,
      "end": 15541.0,
      "formatted_start": "04:18:59.000",
      "formatted_end": "04:19:01.000",
      "text": "یه باری که هر چند وقت تو خانمون پیش میرسی"
    },
    {
      "id": 81,
      "start": 15543.0,
      "end": 15545.0,
      "formatted_start": "04:19:03.000",
      "formatted_end": "04:19:05.000",
      "text": "خانمون که درد"
    },
    {
      "id": 82,
      "start": 15545.0,
      "end": 15547.0,
      "formatted_start": "04:19:05.000",
      "formatted_end": "04:19:07.000",
      "text": "فرضی هم واسه چیه"
    },
    {
      "id": 83,
      "start": 15549.0,
      "end": 15551.0,
      "formatted_start": "04:19:09.000",
      "formatted_end": "04:19:11.000",
      "text": "اینجا بود؟"
    },
    {
      "id": 84,
      "start": 15551.0,
      "end": 15553.0,
      "formatted_start": "04:19:11.000",
      "formatted_end": "04:19:13.000",
      "text": "نه نه اینجا بود"
    },
    {
      "id": 85,
      "start": 15553.0,
      "end": 15555.0,
      "formatted_start": "04:19:13.000",
      "formatted_end": "04:19:15.000",
      "text": "مانباباتش کدام سر نداشتن؟"
    },
    {
      "id": 86,
      "start": 15555.0,
      "end": 15557.0,
      "formatted_start": "04:19:15.000",
      "formatted_end": "04:19:17.000",
      "text": "خودم قابل نشد"
    },
    {
      "id": 87,
      "start": 15557.0,
      "end": 15559.0,
      "formatted_start": "04:19:17.000",
      "formatted_end": "04:19:19.000",
