      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:02.000",
      "text": "این کلر کابل خراب می کنه."
    },
    {
      "id": 1,
      "start": 2406.0,
      "end": 2408.0,
      "formatted_start": "00:40:06.000",
      "formatted_end": "00:40:08.000",
      "text": "وای سواریم این کلر کابل خراب می کنه."
    },
    {
      "id": 2,
      "start": 2410.0,
      "end": 2412.0,
      "formatted_start": "00:40:10.000",
      "formatted_end": "00:40:12.000",
      "text": "این کلر کابل خراب می کنه."
    },
    {
      "id": 3,
      "start": 2412.0,
      "end": 2414.0,
      "formatted_start": "00:40:12.000",
      "formatted_end": "00:40:14.000",
      "text": "چجوری هم پشت کلر دادین شما؟"
    },
    {
      "id": 4,
      "start": 2414.0,
      "end": 2416.0,
      "formatted_start": "00:40:14.000",
      "formatted_end": "00:40:16.000",
      "text": "من ندارم."
    },
    {
      "id": 5,
      "start": 2416.0,
      "end": 2418.0,
      "formatted_start": "00:40:16.000",
      "formatted_end": "00:40:18.000",
      "text": "اون ترکمن احمد از دولبان."
    },
    {
      "id": 6,
      "start": 2418.0,
      "end": 2420.0,
      "formatted_start": "00:40:18.000",
      "formatted_end": "00:40:20.000",
      "text": "چه از مینده از ترکمن این کلر داد؟"
    },
    {
      "id": 7,
      "start": 2420.0,
      "end": 2422.0,
      "formatted_start": "00:40:20.000",
      "formatted_end": "00:40:22.000",
      "text": "مینده از ترکمن نداره."
    },
    {
      "id": 8,
      "start": 2426.0,
      "end": 2428.0,
      "formatted_start": "00:40:26.000",
      "formatted_end": "00:40:28.000",
      "text": "اون خراب بکنه نه؟"
    },
    {
      "id": 9,
      "start": 2428.0,
      "end": 2430.0,
      "formatted_start": "00:40:28.000",
      "formatted_end": "00:40:30.000",
      "text": "خواهید بگیرم که این را باید بگیرم"
    },
    {
      "id": 10,
      "start": 2430.0,
      "end": 2432.0,
