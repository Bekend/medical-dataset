      "formatted_end": "05:22:00.000",
      "text": "چون چهرگاتون تنگ میشه"
    },
    {
      "id": 17,
      "start": 19320.0,
      "end": 19323.0,
      "formatted_start": "05:22:00.000",
      "formatted_end": "05:22:03.000",
      "text": "دور از چون چهرگستیت به بالا میره"
    },
    {
      "id": 18,
      "start": 19323.0,
      "end": 19325.0,
      "formatted_start": "05:22:03.000",
      "formatted_end": "05:22:05.000",
      "text": "اینجا چرا؟"
    },
    {
      "id": 19,
      "start": 19325.0,
      "end": 19326.0,
      "formatted_start": "05:22:05.000",
      "formatted_end": "05:22:06.000",
      "text": "الان بخورم بینرسیم"
    },
    {
      "id": 20,
      "start": 19326.0,
      "end": 19328.0,
      "formatted_start": "05:22:06.000",
      "formatted_end": "05:22:08.000",
      "text": "امیدواری در افتاده درنگ دیگه دارم میمارم"
    },
    {
      "id": 21,
      "start": 19328.0,
      "end": 19331.0,
      "formatted_start": "05:22:08.000",
      "formatted_end": "05:22:11.000",
      "text": "در دشت قیامت از روغن کنم من هستم"
    },
    {
      "id": 22,
      "start": 19331.0,
      "end": 19333.0,
      "formatted_start": "05:22:11.000",
      "formatted_end": "05:22:13.000",
      "text": "روغن کنم این روغن نیست"
    },
    {
      "id": 23,
      "start": 19333.0,
      "end": 19335.0,
      "formatted_start": "05:22:13.000",
      "formatted_end": "05:22:15.000",
      "text": "ممکن میداری ای کنم پنج بگیدم"
    },
    {
      "id": 24,
      "start": 19335.0,
      "end": 19337.0,
      "formatted_start": "05:22:15.000",
      "formatted_end": "05:22:17.000",
      "text": "کنم روغن کنجهت خودمون میدونیم"
    },
    {
      "id": 25,
      "start": 19337.0,
      "end": 19339.0,
      "formatted_start": "05:22:17.000",
      "formatted_end": "05:22:19.000",
      "text": "این روغن که میدونیم"
    },
    {
      "id": 26,
      "start": 19339.0,
      "end": 19340.0,
      "formatted_start": "05:22:19.000",
      "formatted_end": "05:22:20.000",
      "text": "با که میدونیم"
    },
    {
      "id": 27,
      "start": 19340.0,
      "end": 19342.0,
      "formatted_start": "05:22:20.000",
      "formatted_end": "05:22:22.000",
      "text": "این اطفاقی بلند به این چربی رفته را برده باشه"
    },
    {
      "id": 28,
      "start": 19347.0,
      "end": 19349.0,
      "formatted_start": "05:22:27.000",
      "formatted_end": "05:22:29.000",
      "text": "همه چیزی به چربی رفته باشه"
    },
    {
      "id": 29,
      "start": 19349.0,
      "end": 19351.0,
      "formatted_start": "05:22:29.000",
      "formatted_end": "05:22:31.000",
      "text": "همه اتفاقی بلند به این چربی رفته باشه"
    },
    {
      "id": 30,
      "start": 19351.0,
      "end": 19353.0,
      "formatted_start": "05:22:31.000",
      "formatted_end": "05:22:33.000",
      "text": "همه یک قرصتونی که آنزیما را بالا برده"
    },
    {
      "id": 31,
      "start": 19353.0,
      "end": 19355.0,
      "formatted_start": "05:22:33.000",
      "formatted_end": "05:22:35.000",
      "text": "یا دوباره همه چیزی به هم میده"
    },
    {
      "id": 32,
      "start": 19355.0,
      "end": 19357.0,
      "formatted_start": "05:22:35.000",
      "formatted_end": "05:22:37.000",
      "text": "با یک قرص"
    },
    {
      "id": 33,
      "start": 19357.0,
      "end": 19359.0,
      "formatted_start": "05:22:37.000",
      "formatted_end": "05:22:39.000",
      "text": "با یک قرص به این چرب بلند آدم به هم میده"
    },
    {
      "id": 34,
      "start": 19359.0,
      "end": 19361.0,
      "formatted_start": "05:22:39.000",
      "formatted_end": "05:22:41.000",
      "text": "بخورم دیده دامو بیدم"
    },
    {
      "id": 35,
      "start": 19361.0,
      "end": 19363.0,
      "formatted_start": "05:22:41.000",
      "formatted_end": "05:22:43.000",
      "text": "برای این سری من از اون قرص ها داده ببینم"
    },
    {
      "id": 36,
      "start": 19363.0,
      "end": 19365.0,
      "formatted_start": "05:22:43.000",
      "formatted_end": "05:22:45.000",
      "text": "که پیروز بخورم"
    },
    {
      "id": 37,
      "start": 19365.0,
      "end": 19369.0,
      "formatted_start": "05:22:45.000",
      "formatted_end": "05:22:49.000",
      "text": "من از اون عرصه داده ببینم که پول و عرصه باید دردید کنم"
    },
    {
      "id": 38,
      "start": 19373.0,
      "end": 19377.0,
      "formatted_start": "05:22:53.000",
      "formatted_end": "05:22:57.000",
      "text": "شما عرصهش پیشتر بهتون میسازه یا کپسولش"
    },
    {
      "id": 39,
      "start": 19378.0,
      "end": 19380.0,
      "formatted_start": "05:22:58.000",
      "formatted_end": "05:23:00.000",
      "text": "همین بهتون میسازه"
    },
    {
      "id": 40,
      "start": 19381.0,
      "end": 19383.0,
      "formatted_start": "05:23:01.000",
      "formatted_end": "05:23:03.000",
      "text": "ولی که اونها زود پایین میاره"
    },
    {
      "id": 41,
      "start": 19383.0,
      "end": 19385.0,
      "formatted_start": "05:23:03.000",
      "formatted_end": "05:23:05.000",
      "text": "اون 450 ها"
    },
    {
      "id": 42,
      "start": 19385.0,
      "end": 19387.0,
      "formatted_start": "05:23:05.000",
      "formatted_end": "05:23:07.000",
      "text": "نه نه اون 20 ها"
    },
    {
      "id": 43,
      "start": 19387.0,
      "end": 19392.0,
      "formatted_start": "05:23:07.000",
      "formatted_end": "05:23:12.000",
      "text": "اون اصلا با تیلیگرسیت هیچ اثر نداره"
    },
    {
      "id": 44,
      "start": 19392.0,
      "end": 19395.0,
      "formatted_start": "05:23:12.000",
      "formatted_end": "05:23:15.000",
      "text": "اون رو اطار با اون روی کلسترون اثر داریم"
    },
    {
      "id": 45,
      "start": 19395.0,
      "end": 19396.0,
      "formatted_start": "05:23:15.000",
      "formatted_end": "05:23:16.000",
      "text": "بس همینم"
    },
    {
      "id": 46,
      "start": 19396.0,
      "end": 19397.0,
      "formatted_start": "05:23:16.000",
      "formatted_end": "05:23:17.000",
      "text": "الان نه روز روز"
    },
    {
      "id": 47,
      "start": 19397.0,
      "end": 19399.0,
      "formatted_start": "05:23:17.000",
      "formatted_end": "05:23:19.000",
      "text": "مثلا یک شب مخورم یکی هم زود"
    },
    {
      "id": 48,
      "start": 19399.0,
      "end": 19401.0,
      "formatted_start": "05:23:19.000",
      "formatted_end": "05:23:21.000",
      "text": "قبل از نهار قبل از شام"
    },
    {
      "id": 49,
      "start": 19401.0,
      "end": 19402.0,
      "formatted_start": "05:23:21.000",
      "formatted_end": "05:23:22.000",
      "text": "قبل از بعد مخورم"
    },
    {
      "id": 50,
      "start": 19402.0,
      "end": 19404.0,
      "formatted_start": "05:23:22.000",
      "formatted_end": "05:23:24.000",
      "text": "نه اون قرص چربی بعده"
    },
    {
      "id": 51,
      "start": 19404.0,
      "end": 19405.0,
      "formatted_start": "05:23:24.000",
      "formatted_end": "05:23:25.000",
      "text": "این قبله"
    },
    {
      "id": 52,
      "start": 19405.0,
      "end": 19406.0,
      "formatted_start": "05:23:25.000",
      "formatted_end": "05:23:26.000",
      "text": "آهان"
    },
    {
      "id": 53,
      "start": 19406.0,
      "end": 19407.0,
      "formatted_start": "05:23:26.000",
      "formatted_end": "05:23:27.000",
      "text": "بقیه قرص های چربی بعده"
    },
    {
      "id": 54,
      "start": 19407.0,
      "end": 19409.0,
      "formatted_start": "05:23:27.000",
      "formatted_end": "05:23:29.000",
      "text": "این یه قرص استثناس قبله"
    },
    {
      "id": 55,
      "start": 19409.0,
      "end": 19411.0,
      "formatted_start": "05:23:29.000",
      "formatted_end": "05:23:31.000",
      "text": "بس من همیشه بعد مخوردم"
    },
    {
      "id": 56,
      "start": 19411.0,
      "end": 19413.0,
      "formatted_start": "05:23:31.000",
      "formatted_end": "05:23:33.000",
      "text": "قبل نهار قبل شام"
    },
    {
      "id": 57,
      "start": 19413.0,
      "end": 19414.0,
      "formatted_start": "05:23:33.000",
      "formatted_end": "05:23:34.000",
      "text": "قبل شام"
    },
    {
      "id": 58,
      "start": 19414.0,
      "end": 19416.0,
      "formatted_start": "05:23:34.000",
      "formatted_end": "05:23:36.000",
      "text": "یه رو قبل از نهار یه رو قبل از شام"
    },
    {
      "id": 59,
      "start": 19416.0,
      "end": 19420.0,
      "formatted_start": "05:23:36.000",
      "formatted_end": "05:23:40.000",
      "text": "این کارش اینه که در واقع شما میخوید و نمیذارید چهاریتون را بزرگ"
    },
    {
      "id": 60,
      "start": 19420.0,
      "end": 19422.0,
      "formatted_start": "05:23:40.000",
      "formatted_end": "05:23:42.000",
      "text": "بسیاریم"
    },
    {
      "id": 61,
      "start": 19422.0,
      "end": 19426.0,
      "formatted_start": "05:23:42.000",
      "formatted_end": "05:23:46.000",
      "text": "این سایده نیومسلس باید برده باشید"
    },
    {
      "id": 62,
      "start": 19426.0,
      "end": 19428.0,
      "formatted_start": "05:23:46.000",
      "formatted_end": "05:23:48.000",
      "text": "یه بار نشد و بزرگ میشه"
    },
    {
      "id": 63,
      "start": 19428.0,
      "end": 19430.0,
      "formatted_start": "05:23:48.000",
      "formatted_end": "05:23:50.000",
      "text": "من دیویست را برمیستم سه ماه"
    },
    {
      "id": 64,
      "start": 19430.0,
      "end": 19433.0,
      "formatted_start": "05:23:50.000",
      "formatted_end": "05:23:53.000",
      "text": "خب؟ تا بعد سه ماه باید ببینید چطور میشه"
    },
    {
      "id": 65,
      "start": 19433.0,
      "end": 19436.0,
      "formatted_start": "05:23:53.000",
      "formatted_end": "05:23:56.000",
      "text": "قلتون بد نیست برای چیزا خوبه"
    },
    {
      "id": 66,
      "start": 19436.0,
      "end": 19439.0,
      "formatted_start": "05:23:56.000",
      "formatted_end": "05:23:59.000",
      "text": "بعد آنزیمای که بهتونم بالا رفته"
    },
    {
      "id": 67,
      "start": 19439.0,
      "end": 19442.0,
      "formatted_start": "05:23:59.000",
      "formatted_end": "05:24:02.000",
      "text": "لیورگول هم بعد سه ماه بخورید"
    },
    {
      "id": 68,
      "start": 19442.0,
      "end": 19446.0,
      "formatted_start": "05:24:02.000",
      "formatted_end": "05:24:06.000",
      "text": "دوره گول میبشه؟ دوره گول میبشه؟"
    },
    {
      "id": 69,
      "start": 19446.0,
      "end": 19450.0,
      "formatted_start": "05:24:06.000",
      "formatted_end": "05:24:10.000",
      "text": "شما دو تا نمیشته چون دوره گول ها اینجا کم بینند"
    },
    {
      "id": 70,
      "start": 19450.0,
      "end": 19454.0,
      "formatted_start": "05:24:10.000",
      "formatted_end": "05:24:14.000",
      "text": "یک چیزش نداره و شرکت رفت اونجا دید"
    },
    {
      "id": 71,
      "start": 19454.0,
      "end": 19458.0,
      "formatted_start": "05:24:14.000",
      "formatted_end": "05:24:18.000",
      "text": "نباید دوره رو برداد با ما"
    },
    {
      "id": 72,
      "start": 19458.0,
      "end": 19462.0,
      "formatted_start": "05:24:18.000",
      "formatted_end": "05:24:22.000",
      "text": "سایت ها رو باز نمیکنه"
    },
    {
      "id": 73,
      "start": 19462.0,
      "end": 19466.0,
      "formatted_start": "05:24:22.000",
      "formatted_end": "05:24:26.000",
      "text": "اونو خوب بگوشین در آن"
    },
    {
      "id": 74,
      "start": 19466.0,
      "end": 19470.0,
      "formatted_start": "05:24:26.000",
      "formatted_end": "05:24:30.000",
      "text": "لیوره گول هفتادش بیمه از هشت صد و چهدش آزاده"
    },
    {
      "id": 75,
      "start": 19470.0,
      "end": 19475.0,
      "formatted_start": "05:24:30.000",
      "formatted_end": "05:24:35.000",
      "text": "بعد شاید مثلا ما سایه چه میدیم، سه بهتون رایگان دار؟"
    },
    {
      "id": 76,
      "start": 19475.0,
      "end": 19476.0,
      "formatted_start": "05:24:35.000",
      "formatted_end": "05:24:36.000",
      "text": "آره"
    },
    {
      "id": 77,
      "start": 19476.0,
      "end": 19480.0,
      "formatted_start": "05:24:36.000",
      "formatted_end": "05:24:40.000",
      "text": "خب اون مثلا نصفشو میدن که براتون رایگان اصابت کنن"
    },
    {
      "id": 78,
      "start": 19480.0,
      "end": 19481.0,
      "formatted_start": "05:24:40.000",
      "formatted_end": "05:24:41.000",
      "text": "آهان"
    },
    {
      "id": 79,
      "start": 19481.0,
      "end": 19484.0,
      "formatted_start": "05:24:41.000",
      "formatted_end": "05:24:44.000",
      "text": "ولی اون عدد رایگانو براتون براشون میزنن، گاهی وقتا این کار میکنن"
    },
    {
      "id": 80,
      "start": 19484.0,
      "end": 19485.0,
      "formatted_start": "05:24:44.000",
      "formatted_end": "05:24:45.000",
      "text": "پس اینجوری؟"
    },
    {
      "id": 81,
      "start": 19485.0,
      "end": 19490.0,
      "formatted_start": "05:24:45.000",
      "formatted_end": "05:24:50.000",
      "text": "آره وگرنه در واقع سد چه که الان خانم باید بخورن، آزاده، کلا بیمه نمیخوره"
    },
    {
      "id": 82,
      "start": 19490.0,
      "end": 19491.0,
      "formatted_start": "05:24:50.000",
      "formatted_end": "05:24:51.000",
      "text": "ازا جامعه"
    },
    {
      "id": 83,
      "start": 19491.0,
      "end": 19492.0,
      "formatted_start": "05:24:51.000",
      "formatted_end": "05:24:52.000",
      "text": "چه باشه؟ نه آره؟"
    },
    {
      "id": 84,
      "start": 19492.0,
      "end": 19495.74,
      "formatted_start": "05:24:52.000",
      "formatted_end": "05:24:55.740",
      "text": "خب بیدن چی کار میکنن دیگه"
    },
    {
      "id": 85,
      "start": 19495.74,
      "end": 19499.0,
      "formatted_start": "05:24:55.740",
      "formatted_end": "05:24:59.000",
      "text": "ببین اونا سنشل آزاده برن که باید شما رایگان باشه"
    },
    {
      "id": 86,
      "start": 19499.0,
      "end": 19499.98,
      "formatted_start": "05:24:59.000",
      "formatted_end": "05:24:59.980",
      "text": "نصفشو میدن"
    }
  ],
  "status": "completed"
}