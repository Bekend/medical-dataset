      "formatted_end": "01:35:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 5730.0,
      "end": 5743.0,
      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:43.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 5743.0,
      "end": 5745.0,
      "formatted_start": "01:35:43.000",
      "formatted_end": "01:35:45.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 3,
      "start": 5773.0,
      "end": 5775.0,
      "formatted_start": "01:36:13.000",
      "formatted_end": "01:36:15.000",
      "text": "باید بردن باید بخورید"
    },
    {
      "id": 4,
      "start": 5775.0,
      "end": 5777.0,
      "formatted_start": "01:36:15.000",
      "formatted_end": "01:36:17.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 5,
      "start": 5777.0,
      "end": 5779.0,
      "formatted_start": "01:36:17.000",
      "formatted_end": "01:36:19.000",
      "text": "اگر بردن بردن باشد"
    },
    {
      "id": 6,
      "start": 5779.0,
      "end": 5781.0,
      "formatted_start": "01:36:19.000",
      "formatted_end": "01:36:21.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 7,
      "start": 5781.0,
      "end": 5783.0,
      "formatted_start": "01:36:21.000",
      "formatted_end": "01:36:23.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 8,
      "start": 5783.0,
      "end": 5785.0,
      "formatted_start": "01:36:23.000",
      "formatted_end": "01:36:25.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 9,
      "start": 5785.0,
      "end": 5787.0,
      "formatted_start": "01:36:25.000",
      "formatted_end": "01:36:27.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 10,
      "start": 5787.0,
      "end": 5789.0,
      "formatted_start": "01:36:27.000",
      "formatted_end": "01:36:29.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 11,
      "start": 5789.0,
      "end": 5791.0,
      "formatted_start": "01:36:29.000",
      "formatted_end": "01:36:31.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 12,
      "start": 5791.0,
      "end": 5793.0,
      "formatted_start": "01:36:31.000",
      "formatted_end": "01:36:33.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 13,
      "start": 5793.0,
      "end": 5795.0,
      "formatted_start": "01:36:33.000",
      "formatted_end": "01:36:35.000",
      "text": "برای این حالتی که باید شوید"
    },
    {
      "id": 14,
      "start": 5803.0,
      "end": 5807.0,
      "formatted_start": "01:36:43.000",
      "formatted_end": "01:36:47.000",
      "text": "من یک پومات می نوستم، اینو بزنید ببینید چون تا می شوند"
    },
    {
      "id": 15,
      "start": 5819.0,
      "end": 5824.0,
      "formatted_start": "01:36:59.000",
      "formatted_end": "01:37:04.000",
      "text": "پومات بر دوازده ساعتی بر کامل رو پاتون بکشید"
    },
    {
      "id": 16,
      "start": 5828.0,
      "end": 5830.0,
      "formatted_start": "01:37:08.000",
      "formatted_end": "01:37:10.000",
      "text": "شبا بیشتر از یه دمونه برده؟"
    },
    {
      "id": 17,
      "start": 5830.0,
      "end": 5832.0,
      "formatted_start": "01:37:10.000",
      "formatted_end": "01:37:12.000",
      "text": "با همین بیشتر نیمونه گاهی باشه"
    },
    {
      "id": 18,
      "start": 5832.0,
      "end": 5834.0,
      "formatted_start": "01:37:12.000",
      "formatted_end": "01:37:14.000",
      "text": "آره، اما روسا نه"
    },
    {
      "id": 19,
      "start": 5834.0,
      "end": 5836.0,
      "formatted_start": "01:37:14.000",
      "formatted_end": "01:37:16.000",
      "text": "روسا زیاد باشه"
    },
    {
      "id": 20,
      "start": 5836.0,
      "end": 5838.0,
      "formatted_start": "01:37:16.000",
      "formatted_end": "01:37:18.000",
      "text": "حالا ببینیم اگه پومادو زدی خوب شد که خوب شد نشد"
    },
    {
      "id": 21,
      "start": 5838.0,
      "end": 5840.0,
      "formatted_start": "01:37:18.000",
      "formatted_end": "01:37:20.000",
      "text": "باز باید شامپو شروع کنیم"
    },
    {
      "id": 22,
      "start": 5852.0,
      "end": 5854.0,
      "formatted_start": "01:37:32.000",
      "formatted_end": "01:37:34.000",
      "text": "چکاو کاملا نوشتم"
    },
    {
      "id": 23,
      "start": 5854.0,
      "end": 5856.0,
      "formatted_start": "01:37:34.000",
      "formatted_end": "01:37:36.000",
      "text": "نصف درد نکنم"
    },
    {
      "id": 24,
      "start": 5856.0,
      "end": 5858.0,
      "formatted_start": "01:37:36.000",
      "formatted_end": "01:37:38.000",
      "text": "باز باز درد نکنم"
    },
    {
      "id": 25,
      "start": 5858.0,
      "end": 5860.0,
      "formatted_start": "01:37:38.000",
      "formatted_end": "01:37:40.000",
      "text": "باید برداری کنیم"
    },
    {
      "id": 26,
      "start": 5860.0,
      "end": 5862.0,
      "formatted_start": "01:37:40.000",
      "formatted_end": "01:37:42.000",
      "text": "تا ببینیم که انشالله چطور باشه"
    },
    {
      "id": 27,
      "start": 5862.0,
      "end": 5864.0,
      "formatted_start": "01:37:42.000",
      "formatted_end": "01:37:44.000",
      "text": "پردا صبحی ها موضوع شده"
    },
    {
      "id": 28,
      "start": 5864.0,
      "end": 5866.0,
      "formatted_start": "01:37:44.000",
      "formatted_end": "01:37:46.000",
      "text": "آره انشالله"
    },
    {
      "id": 29,
      "start": 5870.0,
      "end": 5872.0,
      "formatted_start": "01:37:50.000",
      "formatted_end": "01:37:52.000",
      "text": "خوب منشورم"
    },
    {
      "id": 30,
      "start": 5872.0,
      "end": 5874.0,
      "formatted_start": "01:37:52.000",
      "formatted_end": "01:37:54.000",
      "text": "خوب براتون"
    },
    {
      "id": 31,
      "start": 5874.0,
      "end": 5876.0,
      "formatted_start": "01:37:54.000",
      "formatted_end": "01:37:56.000",
      "text": "باش اینجا اینا"
    },
    {
      "id": 32,
      "start": 5876.0,
      "end": 5878.0,
      "formatted_start": "01:37:56.000",
      "formatted_end": "01:37:58.000",
      "text": "چه اینا"
    },
    {
      "id": 33,
      "start": 5878.0,
      "end": 5880.0,
      "formatted_start": "01:37:58.000",
      "formatted_end": "01:38:00.000",
      "text": "دیدرشت هست"
    },
    {
      "id": 34,
      "start": 5880.0,
      "end": 5882.0,
      "formatted_start": "01:38:00.000",
      "formatted_end": "01:38:02.000",
      "text": "ببینم"
    },
    {
      "id": 35,
      "start": 5882.0,
      "end": 5884.0,
      "formatted_start": "01:38:02.000",
      "formatted_end": "01:38:04.000",
      "text": "دیدر"
    },
    {
      "id": 36,
      "start": 5884.0,
      "end": 5886.0,
      "formatted_start": "01:38:04.000",
      "formatted_end": "01:38:06.000",
      "text": "گردم صبح هستم"
    },
    {
      "id": 37,
      "start": 5886.0,
      "end": 5915.98,
      "formatted_start": "01:38:06.000",
      "formatted_end": "01:38:35.980",
      "text": "باید برگردیم و باید برگردیم و برگردیم"
    },
    {
      "id": 38,
      "start": 5916.0,
      "end": 5918.0,
      "formatted_start": "01:38:36.000",
      "formatted_end": "01:38:38.000",
      "text": "از شده بازم بزرگ شده"
    },
    {
      "id": 39,
      "start": 5918.0,
      "end": 5920.0,
      "formatted_start": "01:38:38.000",
      "formatted_end": "01:38:40.000",
      "text": "ایشون؟"
    },
    {
      "id": 40,
      "start": 5920.0,
      "end": 5924.0,
      "formatted_start": "01:38:40.000",
      "formatted_end": "01:38:44.000",
      "text": "اینه کار که ندارم منو جمعه رو نمونم"
    },
    {
      "id": 41,
      "start": 5924.0,
      "end": 5926.0,
      "formatted_start": "01:38:44.000",
      "formatted_end": "01:38:46.000",
      "text": "با تادشون"
    },
    {
      "id": 42,
      "start": 5926.0,
      "end": 5930.0,
      "formatted_start": "01:38:46.000",
      "formatted_end": "01:38:50.000",
      "text": "خب مزفری که گفتیم برایش اون همون تومال مارکره بزن"
    },
    {
      "id": 43,
      "start": 5930.0,
      "end": 5932.0,
      "formatted_start": "01:38:50.000",
      "formatted_end": "01:38:52.000",
      "text": "من از اون که گفتی رو زدن بزن"
    },
    {
      "id": 44,
      "start": 5932.0,
      "end": 5934.0,
      "formatted_start": "01:38:52.000",
      "formatted_end": "01:38:54.000",
      "text": "هست کناش که بهش خود داره بزن برای همین تومه"
    },
    {
      "id": 45,
      "start": 5934.0,
      "end": 5936.0,
      "formatted_start": "01:38:54.000",
      "formatted_end": "01:38:56.000",
      "text": "هست همون بیداره برای همون بزن"
    },
    {
      "id": 46,
      "start": 5936.0,
      "end": 5938.0,
      "formatted_start": "01:38:56.000",
      "formatted_end": "01:38:58.000",
      "text": "باید خودو بزن باشه"
    },
    {
      "id": 47,
      "start": 5938.0,
      "end": 5942.0,
      "formatted_start": "01:38:58.000",
      "formatted_end": "01:39:02.000",
      "text": "اینو اینو توس چیز قدیم نگهشتن فکر کنم"
    },
    {
      "id": 48,
      "start": 5942.0,
      "end": 5944.0,
      "formatted_start": "01:39:02.000",
      "formatted_end": "01:39:04.000",
      "text": "یعنی توی خدمات قدیم"
    },
    {
      "id": 49,
      "start": 5944.0,
      "end": 5946.0,
      "formatted_start": "01:39:04.000",
      "formatted_end": "01:39:06.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 50,
      "start": 5946.0,
      "end": 5948.0,
      "formatted_start": "01:39:06.000",
      "formatted_end": "01:39:08.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 51,
      "start": 5948.0,
      "end": 5950.0,
      "formatted_start": "01:39:08.000",
      "formatted_end": "01:39:10.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 52,
      "start": 5950.0,
      "end": 5952.0,
      "formatted_start": "01:39:10.000",
      "formatted_end": "01:39:12.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 53,
      "start": 5952.0,
      "end": 5954.0,
      "formatted_start": "01:39:12.000",
      "formatted_end": "01:39:14.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 54,
      "start": 5954.0,
      "end": 5956.0,
      "formatted_start": "01:39:14.000",
      "formatted_end": "01:39:16.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 55,
      "start": 5956.0,
      "end": 5958.0,
      "formatted_start": "01:39:16.000",
      "formatted_end": "01:39:18.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 56,
      "start": 5958.0,
      "end": 5960.0,
      "formatted_start": "01:39:18.000",
      "formatted_end": "01:39:20.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 57,
      "start": 5960.0,
      "end": 5962.0,
      "formatted_start": "01:39:20.000",
      "formatted_end": "01:39:22.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 58,
      "start": 5962.0,
      "end": 5964.0,
      "formatted_start": "01:39:22.000",
      "formatted_end": "01:39:24.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 59,
      "start": 5964.0,
      "end": 5966.0,
      "formatted_start": "01:39:24.000",
      "formatted_end": "01:39:26.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 60,
      "start": 5966.0,
      "end": 5968.0,
      "formatted_start": "01:39:26.000",
      "formatted_end": "01:39:28.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 61,
      "start": 5968.0,
      "end": 5971.24,
      "formatted_start": "01:39:28.000",
      "formatted_end": "01:39:31.240",
      "text": "خوب دندان رنگ کشید و دندان روز دشتم"
    },
    {
      "id": 62,
      "start": 5971.24,
      "end": 5972.24,
      "formatted_start": "01:39:31.240",
      "formatted_end": "01:39:32.240",
      "text": "خوب"
    },
    {
      "id": 63,
      "start": 5972.24,
      "end": 5975.88,
      "formatted_start": "01:39:32.240",
      "formatted_end": "01:39:35.880",
      "text": "از این موقعی دهلن من گرسی کنم باید که چیز"
    },
    {
      "id": 64,
      "start": 5975.88,
      "end": 5980.76,
      "formatted_start": "01:39:35.880",
      "formatted_end": "01:39:40.760",
      "text": "گرسی این کپسور روز چرده نگاه کن روز چرده بگم با خواب"
    },
    {
      "id": 65,
      "start": 5980.76,
      "end": 5981.76,
      "formatted_start": "01:39:40.760",
      "formatted_end": "01:39:41.760",
      "text": "برای چی؟"
    },
    {
      "id": 66,
      "start": 5981.76,
      "end": 5984.48,
      "formatted_start": "01:39:41.760",
      "formatted_end": "01:39:44.480",
      "text": "برای این پاکه عملش کرده"
    },
    {
      "id": 67,
      "start": 5984.48,
      "end": 5988.44,
      "formatted_start": "01:39:44.480",
      "formatted_end": "01:39:48.440",
      "text": "این پاکه عمل کرده نه رفته دوشت اینو وردشت"
    },
    {
      "id": 68,
      "start": 5988.44,
      "end": 5991.68,
      "formatted_start": "01:39:48.440",
      "formatted_end": "01:39:51.680",
      "text": "خب این که الان دوباره همیشه شیز برام داره"
    },
    {
      "id": 69,
      "start": 5991.68,
      "end": 5992.48,
      "formatted_start": "01:39:51.680",
      "formatted_end": "01:39:52.480",
      "text": "دو تک"
    },
    {
      "id": 70,
      "start": 5992.48,
      "end": 5993.76,
      "formatted_start": "01:39:52.480",
      "formatted_end": "01:39:53.760",
      "text": "دو تک عمل کردم بگم"
    },
    {
      "id": 71,
      "start": 5993.76,
      "end": 5994.76,
      "formatted_start": "01:39:53.760",
      "formatted_end": "01:39:54.760",
      "text": "آه تازه همه که"
    },
    {
      "id": 72,
      "start": 5994.76,
      "end": 5996.76,
      "formatted_start": "01:39:54.760",
      "formatted_end": "01:39:56.760",
      "text": "بله، تازه، تازه، از کشوم هست"
    },
    {
      "id": 73,
      "start": 5996.76,
      "end": 5998.76,
      "formatted_start": "01:39:56.760",
      "formatted_end": "01:39:58.760",
      "text": "اینه هرها، به اون خاطر اونو میخورن"
    }
  ],
