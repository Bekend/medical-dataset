      "formatted_end": "06:00:52.000",
      "text": "اینجور در این وقت باید نیست"
    },
    {
      "id": 12,
      "start": 21652.0,
      "end": 21659.5,
      "formatted_start": "06:00:52.000",
      "formatted_end": "06:00:59.500",
      "text": "خب قنده مریض میاد قط میشه از بعد هم و داچار افتخانیشه با همون دوز مصرفی قبلش"
    },
    {
      "id": 13,
      "start": 21659.5,
      "end": 21666.0,
      "formatted_start": "06:00:59.500",
      "formatted_end": "06:01:06.000",
      "text": "در رو قنده با همون وقت کمپاری ناشتهشون هشتر و چوبه مدد دیابته ۹۵-۳۸"
    },
    {
      "id": 14,
      "start": 21666.0,
      "end": 21671.0,
      "formatted_start": "06:01:06.000",
      "formatted_end": "06:01:11.000",
      "text": "خب خانم اگه چیز برای سنان برای بیدویسه که انا قده"
    },
    {
      "id": 15,
      "start": 21671.0,
      "end": 21675.0,
      "formatted_start": "06:01:11.000",
      "formatted_end": "06:01:15.000",
      "text": "خب همین فردا بگم که خودشون بیان که روزه کامل رو به خودشون بگیرن"
    },
    {
      "id": 16,
      "start": 21675.0,
      "end": 21677.0,
      "formatted_start": "06:01:15.000",
      "formatted_end": "06:01:17.000",
      "text": "با همین در روشون بیان خب"
    },
    {
      "id": 17,
      "start": 21677.0,
      "end": 21679.0,
      "formatted_start": "06:01:17.000",
      "formatted_end": "06:01:19.000",
      "text": "چون مشکل قلبی هم دارن جفتشون رو دارن"
    },
    {
      "id": 18,
      "start": 21679.0,
      "end": 21681.0,
      "formatted_start": "06:01:19.000",
      "formatted_end": "06:01:21.000",
      "text": "مادر از خوشت قند دارن؟"
    },
    {
      "id": 19,
      "start": 21681.0,
      "end": 21683.0,
      "formatted_start": "06:01:21.000",
      "formatted_end": "06:01:23.000",
      "text": "قند داره مامانم"
    },
    {
      "id": 20,
      "start": 21683.0,
      "end": 21685.0,
      "formatted_start": "06:01:23.000",
      "formatted_end": "06:01:25.000",
      "text": "مامانم پولیش برمی کشت قرمز زیاد میخونن"
    },
    {
      "id": 21,
      "start": 21685.0,
      "end": 21687.0,
      "formatted_start": "06:01:25.000",
      "formatted_end": "06:01:27.000",
      "text": "مامان در مرز نقلس هستن"
    },
    {
      "id": 22,
      "start": 21687.0,
      "end": 21689.0,
      "formatted_start": "06:01:27.000",
      "formatted_end": "06:01:29.000",
      "text": "کشت قرمزشون رو ماهی یه بار باید بکنن"
    },
    {
      "id": 23,
      "start": 21689.0,
      "end": 21691.0,
      "formatted_start": "06:01:29.000",
      "formatted_end": "06:01:31.000",
      "text": "چربیشون خوبه"
    },
    {
      "id": 24,
      "start": 21691.0,
      "end": 21693.0,
      "formatted_start": "06:01:31.000",
      "formatted_end": "06:01:33.000",
      "text": "قنده ایشون خوبه"
    },
    {
      "id": 25,
      "start": 21693.0,
      "end": 21695.0,
      "formatted_start": "06:01:33.000",
      "formatted_end": "06:01:35.000",
      "text": "هر دوشون محتوی قند دارن"
    },
    {
      "id": 26,
      "start": 21695.0,
      "end": 21697.0,
      "formatted_start": "06:01:35.000",
      "formatted_end": "06:01:37.000",
      "text": "زیاد درست هست کنون"
    },
    {
      "id": 27,
      "start": 21697.0,
      "end": 21699.0,
      "formatted_start": "06:01:37.000",
      "formatted_end": "06:01:39.000",
      "text": "انا قند مامانم خوبه؟"
    },
    {
      "id": 28,
      "start": 21699.0,
      "end": 21701.0,
      "formatted_start": "06:01:39.000",
      "formatted_end": "06:01:41.000",
      "text": "اگه آزماشون درست بشن"
    },
    {
      "id": 29,
      "start": 21703.0,
      "end": 21705.0,
      "formatted_start": "06:01:43.000",
      "formatted_end": "06:01:45.000",
      "text": "چون مامان اتفاقا خارق پاشته داره"
    },
    {
      "id": 30,
      "start": 21705.0,
      "end": 21735.0,
      "formatted_start": "06:01:45.000",
      "formatted_end": "06:02:15.000",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 31,
      "start": 21735.0,
      "end": 21737.0,
      "formatted_start": "06:02:15.000",
      "formatted_end": "06:02:17.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 32,
      "start": 21737.0,
      "end": 21739.0,
      "formatted_start": "06:02:17.000",
      "formatted_end": "06:02:19.000",
      "text": "درمان کنید."
    },
    {
      "id": 33,
      "start": 21739.0,
      "end": 21741.0,
      "formatted_start": "06:02:19.000",
      "formatted_end": "06:02:21.000",
      "text": "اگر برای نفترچه های اینقدر،"
    },
    {
      "id": 34,
      "start": 21741.0,
      "end": 21743.0,
      "formatted_start": "06:02:21.000",
      "formatted_end": "06:02:23.000",
      "text": "اینقدر هم به جای معتبر میتونند برند"
    },
    {
      "id": 35,
      "start": 21743.0,
      "end": 21745.0,
      "formatted_start": "06:02:23.000",
      "formatted_end": "06:02:25.000",
      "text": "چه اینجای درود آقا میبینید."
    },
    {
      "id": 36,
      "start": 21745.0,
      "end": 21747.0,
      "formatted_start": "06:02:25.000",
      "formatted_end": "06:02:27.000",
      "text": "درست کنید."
    },
    {
      "id": 37,
      "start": 21747.0,
      "end": 21749.0,
      "formatted_start": "06:02:27.000",
      "formatted_end": "06:02:29.000",
      "text": "درست کنید."
    },
    {
      "id": 38,
      "start": 21749.0,
      "end": 21751.0,
      "formatted_start": "06:02:29.000",
      "formatted_end": "06:02:31.000",
      "text": "درست کنید."
    },
    {
      "id": 39,
      "start": 21751.0,
      "end": 21753.0,
      "formatted_start": "06:02:31.000",
      "formatted_end": "06:02:33.000",
      "text": "درست کنید."
    },
    {
      "id": 40,
      "start": 21753.0,
      "end": 21755.0,
      "formatted_start": "06:02:33.000",
      "formatted_end": "06:02:35.000",
      "text": "درست کنید."
    },
    {
      "id": 41,
      "start": 21755.0,
      "end": 21757.0,
      "formatted_start": "06:02:35.000",
      "formatted_end": "06:02:37.000",
      "text": "درست کنید."
    },
    {
      "id": 42,
      "start": 21757.0,
      "end": 21759.0,
      "formatted_start": "06:02:37.000",
      "formatted_end": "06:02:39.000",
      "text": "درست کنید."
    },
    {
      "id": 43,
      "start": 21759.0,
      "end": 21761.0,
      "formatted_start": "06:02:39.000",
      "formatted_end": "06:02:41.000",
      "text": "درست کنید."
    },
    {
      "id": 44,
      "start": 21761.0,
      "end": 21763.0,
      "formatted_start": "06:02:41.000",
      "formatted_end": "06:02:43.000",
      "text": "درست کنید."
    },
    {
      "id": 45,
      "start": 21763.0,
      "end": 21765.0,
      "formatted_start": "06:02:43.000",
      "formatted_end": "06:02:45.000",
      "text": "خودشون به داروشون تشکیل کردن"
    },
    {
      "id": 46,
      "start": 21765.0,
      "end": 21767.0,
      "formatted_start": "06:02:45.000",
      "formatted_end": "06:02:47.000",
      "text": "چیزی شده؟"
    },
    {
      "id": 47,
      "start": 21767.0,
      "end": 21769.0,
      "formatted_start": "06:02:47.000",
      "formatted_end": "06:02:49.000",
      "text": "مامانو تو وزنشون زیاد ترین؟"
    },
    {
      "id": 48,
      "start": 21769.0,
      "end": 21771.0,
      "formatted_start": "06:02:49.000",
      "formatted_end": "06:02:51.000",
      "text": "آره"
    },
    {
      "id": 49,
      "start": 21771.0,
      "end": 21773.0,
      "formatted_start": "06:02:51.000",
      "formatted_end": "06:02:53.000",
      "text": "چیزی شده؟"
    },
    {
      "id": 50,
      "start": 21773.0,
      "end": 21775.0,
      "formatted_start": "06:02:53.000",
      "formatted_end": "06:02:55.000",
      "text": "نه منو داریم، منو کار منو دادم باشم"
    },
    {
      "id": 51,
      "start": 21775.0,
      "end": 21777.0,
      "formatted_start": "06:02:55.000",
      "formatted_end": "06:02:57.000",
      "text": "مامان تو خودشون خودشون خندشون"
    },
    {
      "id": 52,
      "start": 21777.0,
      "end": 21779.0,
      "formatted_start": "06:02:57.000",
      "formatted_end": "06:02:59.000",
      "text": "چانه کبدشون و ازره میشه"
    },
    {
      "id": 53,
      "start": 21779.0,
      "end": 21781.0,
      "formatted_start": "06:02:59.000",
      "formatted_end": "06:03:01.000",
      "text": "محساب جنجشون"
    },
    {
      "id": 54,
      "start": 21781.0,
      "end": 21783.0,
      "formatted_start": "06:03:01.000",
      "formatted_end": "06:03:03.000",
      "text": "بردشونش برده، نوشانش برده"
    },
    {
      "id": 55,
      "start": 21783.0,
      "end": 21785.0,
      "formatted_start": "06:03:03.000",
      "formatted_end": "06:03:05.000",
      "text": "بس بگو خودش بیاد خوب شد"
    },
    {
      "id": 56,
      "start": 21785.0,
      "end": 21787.0,
      "formatted_start": "06:03:05.000",
      "formatted_end": "06:03:07.000",
      "text": "چون خواهد داروش کم شد"
    },
    {
      "id": 57,
      "start": 21787.0,
      "end": 21789.0,
      "formatted_start": "06:03:07.000",
      "formatted_end": "06:03:09.000",
      "text": "برایشون سنن کبد بریم سنبت بگو"
    },
    {
      "id": 58,
      "start": 21789.0,
      "end": 21791.64,
      "formatted_start": "06:03:09.000",
      "formatted_end": "06:03:11.640",
      "text": "خودشون میباهم این آزمایش ها"
    },
    {
      "id": 59,
      "start": 21791.64,
      "end": 21795.16,
      "formatted_start": "06:03:11.640",
      "formatted_end": "06:03:15.160",
      "text": "بعد خودتون هم ترکیت کنین که این آزمایش های درست ها هم دارن"
    },
    {
      "id": 60,
      "start": 21795.16,
      "end": 21798.64,
      "formatted_start": "06:03:15.160",
      "formatted_end": "06:03:18.640",
      "text": "چون واقعاً مریض قلبی دارن و اینجوری هم"
    },
    {
      "id": 61,
      "start": 21798.64,
      "end": 21801.4,
      "formatted_start": "06:03:18.640",
      "formatted_end": "06:03:21.400",
      "text": "این دختر مریض میبنه در اون آزمایش کنه میگه که"
    },
    {
      "id": 62,
      "start": 21801.4,
      "end": 21803.6,
      "formatted_start": "06:03:21.400",
      "formatted_end": "06:03:23.600",
      "text": "جیبه اون توی شهر کچکه خب"
    },
    {
      "id": 63,
      "start": 21803.6,
      "end": 21805.4,
      "formatted_start": "06:03:23.600",
      "formatted_end": "06:03:25.400",
      "text": "نه نه نه نه"
    },
    {
      "id": 64,
      "start": 21805.4,
      "end": 21806.8,
      "formatted_start": "06:03:25.400",
      "formatted_end": "06:03:26.800",
      "text": "میگه که شما چه آزمایش های درست هم دارن"
    },
    {
      "id": 65,
      "start": 21806.8,
      "end": 21808.76,
      "formatted_start": "06:03:26.800",
      "formatted_end": "06:03:28.760",
      "text": "ما خودمون میدونیم ما خودمون داریم میگیم"
    },
    {
      "id": 66,
      "start": 21808.76,
      "end": 21810.36,
      "formatted_start": "06:03:28.760",
      "formatted_end": "06:03:30.360",
      "text": "اون رو اونجا"
    },
    {
      "id": 67,
      "start": 21810.36,
      "end": 21811.8,
      "formatted_start": "06:03:30.360",
      "formatted_end": "06:03:31.800",
      "text": "بله صدر خواهید"
    },
    {
      "id": 68,
      "start": 21811.8,
      "end": 21841.8,
      "formatted_start": "06:03:31.800",
      "formatted_end": "06:04:01.800",
      "text": "برای از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از این"
    },
    {
      "id": 69,
      "start": 21841.8,
      "end": 21845.8,
      "formatted_start": "06:04:01.800",
      "formatted_end": "06:04:05.800",
      "text": "اما تا واسه سمار بگیرم و از این طرف رو بگیرم"
    },
    {
      "id": 70,
      "start": 21845.8,
      "end": 21847.8,
      "formatted_start": "06:04:05.800",
      "formatted_end": "06:04:07.800",
      "text": "اما فقط در بود که داشت"
    },
    {
      "id": 71,
      "start": 21847.8,
      "end": 21848.8,
      "formatted_start": "06:04:07.800",
      "formatted_end": "06:04:08.800",
      "text": "اما تارگی داره؟"
    },
    {
      "id": 72,
      "start": 21848.8,
      "end": 21851.8,
      "formatted_start": "06:04:08.800",
      "formatted_end": "06:04:11.800",
      "text": "بیشتر زیادی سمار که نامان و جنگ"
    },
    {
      "id": 73,
      "start": 21851.8,
      "end": 21853.8,
      "formatted_start": "06:04:11.800",
      "formatted_end": "06:04:13.800",
      "text": "از سلسنگ نامان بگیرم"
    },
    {
      "id": 74,
      "start": 21853.8,
      "end": 21855.8,
      "formatted_start": "06:04:13.800",
      "formatted_end": "06:04:15.800",
      "text": "که کبد هم بگیره باید یک لخته یا نرژه"
    },
    {
      "id": 75,
      "start": 21855.8,
      "end": 21860.8,
      "formatted_start": "06:04:15.800",
      "formatted_end": "06:04:20.800",
      "text": "نامان جیان بود، هم سماری و سنو کنیم ببینید داره تشدار بزرگ میشه یا نه"
    },
    {
      "id": 76,
      "start": 21860.8,
      "end": 21864.8,
      "formatted_start": "06:04:20.800",
      "formatted_end": "06:04:24.800",
      "text": "اگر از این فائزش سید خودت باشه باید ستیزکن خاصی رو انجام بده"
    },
    {
      "id": 77,
      "start": 21864.8,
      "end": 21871.0,
      "formatted_start": "06:04:24.800",
      "formatted_end": "06:04:31.000",
      "text": "سیتیسکن مخصوص که که در خطر داری که نه اصلا خیلی شعبی است"
    },
    {
      "id": 78,
      "start": 21871.0,
      "end": 21874.2,
      "formatted_start": "06:04:31.000",
      "formatted_end": "06:04:34.200",
      "text": "تو جامعه چون کسی تو داره که خسته نمیشه خود رو نگذاریم"
    },
    {
      "id": 79,
      "start": 21874.2,
      "end": 21877.7,
      "formatted_start": "06:04:34.200",
      "formatted_end": "06:04:37.700",
      "text": "مادر خود هاچی سمیدی؟"
    },
    {
      "id": 80,
      "start": 21877.7,
      "end": 21879.2,
      "formatted_start": "06:04:37.700",
      "formatted_end": "06:04:39.200",
      "text": "سمیدی"
    },
    {
      "id": 81,
      "start": 21879.2,
      "end": 21880.26,
      "formatted_start": "06:04:39.200",
      "formatted_end": "06:04:40.260",
      "text": "سمیدی"
    },
    {
      "id": 82,
      "start": 21880.26,
      "end": 21880.32,
      "formatted_start": "06:04:40.260",
      "formatted_end": "06:04:40.320",
      "text": "سمیدی"
    },
    {
      "id": 83,
      "start": 21880.32,
      "end": 21880.36,
      "formatted_start": "06:04:40.320",
      "formatted_end": "06:04:40.360",
      "text": "سمیدی"
    },
    {
      "id": 84,
      "start": 21880.36,
      "end": 21880.42,
      "formatted_start": "06:04:40.360",
      "formatted_end": "06:04:40.420",
      "text": "سمیدی"
    },
    {
      "id": 85,
      "start": 21880.42,
      "end": 21880.46,
      "formatted_start": "06:04:40.420",
      "formatted_end": "06:04:40.460",
      "text": "سمیدی"
    },
    {
      "id": 86,
      "start": 21880.46,
      "end": 21880.54,
      "formatted_start": "06:04:40.460",
      "formatted_end": "06:04:40.540",
      "text": "سمیدی"
    },
    {
      "id": 87,
      "start": 21880.54,
      "end": 21880.58,
      "formatted_start": "06:04:40.540",
      "formatted_end": "06:04:40.580",
      "text": "سمیدی"
