  "stt_segments": [
    {
      "id": 0,
      "start": 15600.0,
      "end": 15605.64,
      "formatted_start": "04:20:00.000",
      "formatted_end": "04:20:05.640",
      "text": "دکتر اصلا اجازه نمیده، میگه که هیچ داروی نخواه میگه، میشه من اگه بدون داروی اونجا آدم بخواه."
    },
    {
      "id": 1,
      "start": 15605.64,
      "end": 15608.72,
      "formatted_start": "04:20:05.640",
      "formatted_end": "04:20:08.720",
      "text": "لان میگه مثلا ضرر دارو فلان و از یه افراد."
    },
    {
      "id": 2,
      "start": 15608.72,
      "end": 15612.16,
      "formatted_start": "04:20:08.720",
      "formatted_end": "04:20:12.160",
      "text": "بعد الان این مثلا دستگاه های فریز اومده انجام بیدن."
    },
    {
      "id": 3,
      "start": 15612.16,
      "end": 15614.88,
      "formatted_start": "04:20:12.160",
      "formatted_end": "04:20:14.880",
      "text": "گفتم انجام بیدن، گفت که نه الان باسه تو خوب نیسته."
    },
    {
      "id": 4,
      "start": 15614.88,
      "end": 15618.88,
      "formatted_start": "04:20:14.880",
      "formatted_end": "04:20:18.880",
      "text": "تو بعد اول وزن تو بیاری پایین، بعد این کارو انجام بدی."
    },
    {
      "id": 5,
      "start": 15620.88,
      "end": 15622.0,
      "formatted_start": "04:20:20.880",
      "formatted_end": "04:20:22.000",
      "text": "جوشی زینگست؟"
    },
    {
      "id": 6,
      "start": 15623.28,
      "end": 15624.4,
      "formatted_start": "04:20:23.280",
      "formatted_end": "04:20:24.400",
      "text": "شاید خودش نداره."
    },
    {
      "id": 7,
      "start": 15624.4,
      "end": 15628.4,
      "formatted_start": "04:20:24.400",
      "formatted_end": "04:20:28.400",
      "text": "چرا؟ همه نوع، هر چی که موجود به ناقلیت هست، اما داروها..."
    },
    {
      "id": 8,
      "start": 15628.4,
      "end": 15628.9,
      "formatted_start": "04:20:28.400",
      "formatted_end": "04:20:28.900",
      "text": "داره؟"
    },
    {
      "id": 9,
      "start": 15628.9,
      "end": 15633.4,
      "formatted_start": "04:20:28.900",
      "formatted_end": "04:20:33.400",
      "text": "همه چی رو داره، اما آمپولا، داروها، همه چی رو داره"
    },
    {
      "id": 10,
      "start": 15633.4,
      "end": 15634.4,
      "formatted_start": "04:20:33.400",
      "formatted_end": "04:20:34.400",
      "text": "دستگاه رو داره، آره؟"
    },
    {
      "id": 11,
      "start": 15634.4,
      "end": 15638.4,
      "formatted_start": "04:20:34.400",
      "formatted_end": "04:20:38.400",
      "text": "هر دستگاهی بگی داره خودش، خانمش انجام میده"
    },
    {
      "id": 12,
      "start": 15640.4,
      "end": 15645.4,
      "formatted_start": "04:20:40.400",
      "formatted_end": "04:20:45.400",
      "text": "چی بگم؟ نه، آخر این ها سه هرکی میگن، نه نیست، همچنین نمیده"
    },
    {
      "id": 13,
      "start": 15646.4,
      "end": 15652.4,
      "formatted_start": "04:20:46.400",
      "formatted_end": "04:20:52.400",
      "text": "میخواستم ول کنم، اما ول یه دکتوریه که مثلا قیبت آدم رو پیش یکی دیگه میکنه"
    },
    {
      "id": 14,
      "start": 15652.4,
      "end": 15682.4,
      "formatted_start": "04:20:52.400",
      "formatted_end": "04:21:22.400",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 15,
      "start": 15682.4,
      "end": 15687.4,
      "formatted_start": "04:21:22.400",
      "formatted_end": "04:21:27.400",
      "text": "خورمت هم نوشتم اینکه خیلی چهلی، ولی سنوف محمد"
    },
    {
      "id": 16,
      "start": 15688.4,
      "end": 15691.4,
      "formatted_start": "04:21:28.400",
      "formatted_end": "04:21:31.400",
      "text": "خودت سنگ داشت یاده؟ چند کی بگی؟"
    },
    {
      "id": 17,
      "start": 15692.4,
      "end": 15694.4,
      "formatted_start": "04:21:32.400",
      "formatted_end": "04:21:34.400",
      "text": "الان سنج چهلی و ششم"
    },
    {
      "id": 18,
      "start": 15697.4,
      "end": 15700.4,
      "formatted_start": "04:21:37.400",
      "formatted_end": "04:21:40.400",
      "text": "تو باقید یک کاری درست بگوییتی نه؟"
    },
    {
      "id": 19,
      "start": 15700.4,
      "end": 15702.4,
      "formatted_start": "04:21:40.400",
      "formatted_end": "04:21:42.400",
      "text": "سلیپا رفته بکنی؟"
    },
    {
      "id": 20,
      "start": 15702.4,
      "end": 15706.4,
      "formatted_start": "04:21:42.400",
      "formatted_end": "04:21:46.400",
      "text": "نه چی بکنیم، رفتم، پا سال چند کی برمون بوده"
    },
    {
      "id": 21,
      "start": 15706.4,
      "end": 15710.4,
      "formatted_start": "04:21:46.400",
      "formatted_end": "04:21:50.400",
      "text": "نه سنگ مامان بود رفتم، بعد چیز شد"
    },
    {
      "id": 22,
      "start": 15710.4,
      "end": 15713.7,
      "formatted_start": "04:21:50.400",
      "formatted_end": "04:21:53.700",
      "text": "گفت که اون گوه 167 میده"
    },
    {
      "id": 23,
      "start": 15713.7,
      "end": 15716.38,
      "formatted_start": "04:21:53.700",
      "formatted_end": "04:21:56.380",
      "text": "گفت که تو خود رو برسن با 50"
    },
    {
      "id": 24,
      "start": 15716.38,
      "end": 15719.5,
      "formatted_start": "04:21:56.380",
      "formatted_end": "04:21:59.500",
      "text": "باید بیامن که یه ریستش باقی روی خواد عملی میکنم"
    },
    {
      "id": 25,
      "start": 15719.5,
      "end": 15721.0,
      "formatted_start": "04:21:59.500",
      "formatted_end": "04:22:01.000",
      "text": "برد هزینه 160 میده"
    },
    {
      "id": 26,
      "start": 15721.0,
      "end": 15722.3,
      "formatted_start": "04:22:01.000",
      "formatted_end": "04:22:02.300",
      "text": "کجا تهران؟"
    },
    {
      "id": 27,
      "start": 15722.3,
      "end": 15723.2,
      "formatted_start": "04:22:02.300",
      "formatted_end": "04:22:03.200",
      "text": "نه همین گروه هم"
    },
    {
      "id": 28,
      "start": 15723.2,
      "end": 15725.46,
      "formatted_start": "04:22:03.200",
      "formatted_end": "04:22:05.460",
      "text": "تهران هم زنگ ده گوه 120 میده"
    },
    {
      "id": 29,
      "start": 15725.46,
      "end": 15727.98,
      "formatted_start": "04:22:05.460",
      "formatted_end": "04:22:07.980",
      "text": "کورکان همزون ترمی میده دوز اون گوه"
    },
    {
      "id": 30,
      "start": 15727.98,
      "end": 15728.82,
      "formatted_start": "04:22:07.980",
      "formatted_end": "04:22:08.820",
      "text": "آزاد شرحی"
    },
    {
      "id": 31,
      "start": 15728.82,
      "end": 15729.94,
      "formatted_start": "04:22:08.820",
      "formatted_end": "04:22:09.940",
      "text": "گفت که چی؟"
    },
    {
      "id": 32,
      "start": 15729.94,
      "end": 15730.44,
      "formatted_start": "04:22:09.940",
      "formatted_end": "04:22:10.440",
      "text": "اون ده"
    },
    {
      "id": 33,
      "start": 15730.44,
      "end": 15732.34,
      "formatted_start": "04:22:10.440",
      "formatted_end": "04:22:12.340",
      "text": "سه روز تهرانه سه روز اینجا"
    },
    {
      "id": 34,
      "start": 15732.34,
      "end": 15733.84,
      "formatted_start": "04:22:12.340",
      "formatted_end": "04:22:13.840",
      "text": "سه روز اینجا جوهان آزاد شرحه"
    },
    {
      "id": 35,
      "start": 15733.84,
      "end": 15737.84,
      "formatted_start": "04:22:13.840",
      "formatted_end": "04:22:17.840",
      "text": "میارن بیمارستان دولتی ارزا میبینه"
    },
    {
      "id": 36,
      "start": 15737.84,
      "end": 15739.84,
      "formatted_start": "04:22:17.840",
      "formatted_end": "04:22:19.840",
      "text": "این پرسان باید برد"
    },
    {
      "id": 37,
      "start": 15739.84,
      "end": 15741.84,
      "formatted_start": "04:22:19.840",
      "formatted_end": "04:22:21.840",
      "text": "کلت جنبی بخطر برد"
    },
    {
      "id": 38,
      "start": 15741.84,
      "end": 15743.84,
      "formatted_start": "04:22:21.840",
      "formatted_end": "04:22:23.840",
      "text": "این پرسان باید برد"
    },
    {
      "id": 39,
      "start": 15743.84,
      "end": 15745.84,
      "formatted_start": "04:22:23.840",
      "formatted_end": "04:22:25.840",
      "text": "کم کم بیارن برد"
    },
    {
      "id": 40,
      "start": 15745.84,
      "end": 15747.84,
      "formatted_start": "04:22:25.840",
      "formatted_end": "04:22:27.840",
      "text": "بعد شما دوباره چابی داره"
    },
    {
      "id": 41,
      "start": 15747.84,
      "end": 15749.84,
      "formatted_start": "04:22:27.840",
      "formatted_end": "04:22:29.840",
      "text": "همه که داری همجور آهسته میره"
    },
    {
      "id": 42,
      "start": 15749.84,
      "end": 15751.84,
      "formatted_start": "04:22:29.840",
      "formatted_end": "04:22:31.840",
      "text": "آهسته و پیبسته"
    },
    {
      "id": 43,
      "start": 15751.84,
      "end": 15754.84,
      "formatted_start": "04:22:31.840",
      "formatted_end": "04:22:34.840",
      "text": "هر چند وقتی یه شوی"
    },
    {
      "id": 44,
      "start": 15754.84,
      "end": 15756.84,
      "formatted_start": "04:22:34.840",
      "formatted_end": "04:22:36.840",
      "text": "باید همینجوری درد دارم بخواد عمل کنم"
    },
    {
      "id": 45,
      "start": 15756.84,
      "end": 15760.84,
      "formatted_start": "04:22:36.840",
      "formatted_end": "04:22:40.840",
      "text": "بعد بخواد پر نزدن و تو خونه همینجوری شواره ما"
    },
    {
      "id": 46,
      "start": 15760.84,
      "end": 15761.84,
      "formatted_start": "04:22:40.840",
      "formatted_end": "04:22:41.840",
      "text": "آره"
    },
    {
      "id": 47,
      "start": 15761.84,
      "end": 15765.84,
      "formatted_start": "04:22:41.840",
      "formatted_end": "04:22:45.840",
      "text": "مرد و زن ها شاید میگن هر بار باید برخواست کن کارم اینجا"
    },
    {
      "id": 48,
      "start": 15765.84,
      "end": 15768.84,
      "formatted_start": "04:22:45.840",
      "formatted_end": "04:22:48.840",
      "text": "من خاندویتو میتونم از بزار بزنم"
    },
    {
      "id": 49,
      "start": 15768.84,
      "end": 15769.84,
      "formatted_start": "04:22:48.840",
      "formatted_end": "04:22:49.840",
      "text": "آره"
    },
    {
      "id": 50,
      "start": 15769.84,
      "end": 15772.84,
      "formatted_start": "04:22:49.840",
      "formatted_end": "04:22:52.840",
      "text": "اما یک و دو دنباهه"
    },
    {
      "id": 51,
      "start": 15773.84,
      "end": 15778.84,
      "formatted_start": "04:22:53.840",
      "formatted_end": "04:22:58.840",
      "text": "انا اول دوباره باید یه هفته ششتن بزنیم بعد عدادات کنم"
    },
    {
      "id": 52,
      "start": 15778.84,
      "end": 15781.84,
      "formatted_start": "04:22:58.840",
      "formatted_end": "04:23:01.840",
      "text": "باید برمشیم"
    },
    {
      "id": 53,
      "start": 15781.84,
      "end": 15783.84,
      "formatted_start": "04:23:01.840",
      "formatted_end": "04:23:03.840",
      "text": "برمستم برم"
    },
    {
      "id": 54,
      "start": 15783.84,
      "end": 15785.84,
      "formatted_start": "04:23:03.840",
      "formatted_end": "04:23:05.840",
      "text": "آره"
    },
    {
      "id": 55,
      "start": 15785.84,
      "end": 15787.84,
      "formatted_start": "04:23:05.840",
      "formatted_end": "04:23:07.840",
      "text": "تا از اونکه میام آزود بگیرم"
    },
    {
      "id": 56,
      "start": 15787.84,
      "end": 15792.34,
      "formatted_start": "04:23:07.840",
      "formatted_end": "04:23:12.340",
      "text": "آرموشه نمیشه، اما روزی که یکم بدن درمی کنی، کلسیون میخوری"
    },
    {
      "id": 57,
      "start": 15792.34,
      "end": 15796.84,
      "formatted_start": "04:23:12.340",
      "formatted_end": "04:23:16.840",
      "text": "الان ببینی بگو، زینکت پایینه، زینک برام نمیشه، ولی اما..."
    },
    {
      "id": 58,
      "start": 15796.84,
      "end": 15798.84,
      "formatted_start": "04:23:16.840",
      "formatted_end": "04:23:18.840",
      "text": "خودشک با خوچون اشتاده داره"
    },
    {
      "id": 59,
      "start": 15798.84,
      "end": 15799.84,
      "formatted_start": "04:23:18.840",
      "formatted_end": "04:23:19.840",
      "text": "خودشک با خوچون اشتاده داره، ولی خودشک با خوچون اشتاده داره، ولی اما..."
    },
    {
      "id": 60,
      "start": 15799.84,
      "end": 15801.84,
      "formatted_start": "04:23:19.840",
      "formatted_end": "04:23:21.840",
      "text": "برای خوامشک پایین نشانده هم میگه نه، زینکت خوبه"
    },
    {
      "id": 61,
      "start": 15801.84,
      "end": 15804.84,
      "formatted_start": "04:23:21.840",
      "formatted_end": "04:23:24.840",
      "text": "بله، اما چه تا پردی، از از اینکه ارزش من نیستن"
    },
    {
      "id": 62,
      "start": 15804.84,
      "end": 15806.84,
      "formatted_start": "04:23:24.840",
      "formatted_end": "04:23:26.840",
      "text": "برای اینکه ویتامین دید خیلی پایینه"
    },
    {
      "id": 63,
      "start": 15806.84,
      "end": 15808.84,
      "formatted_start": "04:23:26.840",
      "formatted_end": "04:23:28.840",
      "text": "همینو میدونیم"
    },
    {
      "id": 64,
      "start": 15808.84,
      "end": 15810.84,
      "formatted_start": "04:23:28.840",
      "formatted_end": "04:23:30.840",
      "text": "من اینجا باید با این یونی فلکس میکنم"
    },
    {
      "id": 65,
      "start": 15810.84,
      "end": 15812.84,
      "formatted_start": "04:23:30.840",
      "formatted_end": "04:23:32.840",
      "text": "در اینجا بخورم"
    },
    {
      "id": 66,
      "start": 15812.84,
      "end": 15814.84,
      "formatted_start": "04:23:32.840",
      "formatted_end": "04:23:34.840",
      "text": "چون افراز چاک به شده در مرز بکی استخوانه"
    },
    {
      "id": 67,
      "start": 15814.84,
      "end": 15816.84,
      "formatted_start": "04:23:34.840",
      "formatted_end": "04:23:36.840",
      "text": "ویتامین دست هم بود دوازده"
    },
    {
      "id": 68,
      "start": 15818.84,
      "end": 15820.84,
      "formatted_start": "04:23:38.840",
      "formatted_end": "04:23:40.840",
      "text": "آورد یه ازمایشتون"
    },
    {
      "id": 69,
      "start": 15820.84,
      "end": 15822.84,
      "formatted_start": "04:23:40.840",
      "formatted_end": "04:23:42.840",
      "text": "ببینیم"
    },
    {
      "id": 70,
      "start": 15826.84,
      "end": 15828.84,
      "formatted_start": "04:23:46.840",
      "formatted_end": "04:23:48.840",
      "text": "بکی اینه"
    },
    {
      "id": 71,
      "start": 15834.84,
      "end": 15854.84,
      "formatted_start": "04:23:54.840",
      "formatted_end": "04:24:14.840",
      "text": "موسیقی"
    },
    {
      "id": 72,
      "start": 15854.84,
      "end": 15856.84,
      "formatted_start": "04:24:14.840",
      "formatted_end": "04:24:16.840",
      "text": "این تنگید خیلی خوبه"
    },
    {
      "id": 73,
      "start": 15856.84,
      "end": 15858.84,
      "formatted_start": "04:24:16.840",
      "formatted_end": "04:24:18.840",
      "text": "که کمپون هم شپروپات هم بسیار"
    },
    {
      "id": 74,
      "start": 15858.84,
      "end": 15860.84,
      "formatted_start": "04:24:18.840",
      "formatted_end": "04:24:20.840",
      "text": "این داروهاد"
    },
    {
      "id": 75,
      "start": 15860.84,
      "end": 15862.84,
      "formatted_start": "04:24:20.840",
      "formatted_end": "04:24:22.840",
      "text": "کنیدو پدر وقته"
    },
    {
      "id": 76,
      "start": 15862.84,
      "end": 15864.84,
      "formatted_start": "04:24:22.840",
      "formatted_end": "04:24:24.840",
      "text": "سه قضا رو برم"
    },
    {
      "id": 77,
      "start": 15864.84,
      "end": 15866.84,
      "formatted_start": "04:24:24.840",
      "formatted_end": "04:24:26.840",
      "text": "سریعه جه میگیرم"
    },
    {
      "id": 78,
      "start": 15866.84,
      "end": 15868.84,
      "formatted_start": "04:24:26.840",
      "formatted_end": "04:24:28.840",
      "text": "چربه چربه هست؟"
    },
    {
      "id": 79,
      "start": 15868.84,
      "end": 15870.84,
      "formatted_start": "04:24:28.840",
      "formatted_end": "04:24:30.840",
      "text": "نه مثلا صبحانه"
    },
    {
      "id": 80,
      "start": 15870.84,
      "end": 15872.84,
      "formatted_start": "04:24:30.840",
      "formatted_end": "04:24:32.840",
      "text": "بگرد یه همونو سریعه جه میگیرم"
    },
    {
      "id": 81,
      "start": 15872.84,
      "end": 15874.84,
      "formatted_start": "04:24:32.840",
      "formatted_end": "04:24:34.840",
      "text": "میدونم"
    },
    {
      "id": 82,
      "start": 15874.84,
      "end": 15876.84,
      "formatted_start": "04:24:34.840",
      "formatted_end": "04:24:36.840",
      "text": "بله همونو"
    },
    {
      "id": 83,
      "start": 15876.84,
      "end": 15878.84,
      "formatted_start": "04:24:36.840",
      "formatted_end": "04:24:38.840",
      "text": "برای چیزی یاد ندیتون"
    },
    {
      "id": 84,
      "start": 15878.84,
      "end": 15880.84,
      "formatted_start": "04:24:38.840",
      "formatted_end": "04:24:40.840",
      "text": "خب نه"
    },
    {
      "id": 85,
      "start": 15880.84,
      "end": 15882.84,
      "formatted_start": "04:24:40.840",
      "formatted_end": "04:24:42.840",
      "text": "چون خودتون"
    },
    {
      "id": 86,
      "start": 15882.84,
      "end": 15900.0,
      "formatted_start": "04:24:42.840",
      "formatted_end": "04:25:00.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برد"
    }
  ],
  "status": "completed"
}