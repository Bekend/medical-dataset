  "stt_segments": [
    {
      "id": 0,
      "start": 20400.0,
      "end": 20411.0,
      "formatted_start": "05:40:00.000",
      "formatted_end": "05:40:11.000",
      "text": "از اینجوری، اما از سباک میخورم. دیگه ببین خودش برخورشم کنه. چون اینجوری مطمئنن تا قبل سال دیگه نه چشمی داره نه کنیده داره."
    },
    {
      "id": 1,
      "start": 20411.0,
      "end": 20415.0,
      "formatted_start": "05:40:11.000",
      "formatted_end": "05:40:15.000",
      "text": "از این چشم ها باید همون کار رو برم"
    },
    {
      "id": 2,
      "start": 20415.0,
      "end": 20418.0,
      "formatted_start": "05:40:15.000",
      "formatted_end": "05:40:18.000",
      "text": "بایده نداره، فرداش دوباره خونوزی چشمی کنی"
    },
    {
      "id": 3,
      "start": 20418.0,
      "end": 20421.0,
      "formatted_start": "05:40:18.000",
      "formatted_end": "05:40:21.000",
      "text": "با این قلب هی خونوزی چشمی کنی"
    },
    {
      "id": 4,
      "start": 20421.0,
      "end": 20425.0,
      "formatted_start": "05:40:21.000",
      "formatted_end": "05:40:25.000",
      "text": "اصلا قبل اگه با این قلب هیچکی عمل نمی کنن"
    },
    {
      "id": 5,
      "start": 20425.0,
      "end": 20429.0,
      "formatted_start": "05:40:25.000",
      "formatted_end": "05:40:29.000",
      "text": "این قلبتون اینجوری باشه، اصلا شما قابل عمل شدن نیست"
    },
    {
      "id": 6,
      "start": 20429.0,
      "end": 20433.0,
      "formatted_start": "05:40:29.000",
      "formatted_end": "05:40:33.000",
      "text": "اصلا هیچ چیز، چون هیچ زخمی جوش نمیده"
    },
    {
      "id": 7,
      "start": 20433.0,
      "end": 20436.0,
      "formatted_start": "05:40:33.000",
      "formatted_end": "05:40:36.000",
      "text": "اصلا چی؟ اصلا همون کار"
    },
    {
      "id": 8,
      "start": 20436.0,
      "end": 20441.0,
      "formatted_start": "05:40:36.000",
      "formatted_end": "05:40:41.000",
      "text": "اصلا، کنداز، آب نواد قربوروتی، آب نواد رجیمی، نداریم اینجور شیطان"
    },
    {
      "id": 9,
      "start": 20441.0,
      "end": 20444.0,
      "formatted_start": "05:40:41.000",
      "formatted_end": "05:40:44.000",
      "text": "چیزی خوام دکتور من رفتم دکتور ملایی بگو"
    },
    {
      "id": 10,
      "start": 20444.0,
      "end": 20447.0,
      "formatted_start": "05:40:44.000",
      "formatted_end": "05:40:47.000",
      "text": "صبح یه کاشوق، یه کاشوق اصلا ناشنا بکنیم"
    },
    {
      "id": 11,
      "start": 20447.0,
      "end": 20449.0,
      "formatted_start": "05:40:47.000",
      "formatted_end": "05:40:49.000",
      "text": "خب، خوردی؟"
    },
    {
      "id": 12,
      "start": 20449.0,
      "end": 20452.0,
      "formatted_start": "05:40:49.000",
      "formatted_end": "05:40:52.000",
      "text": "خب من قندتو میبینیم دیگه"
    },
    {
      "id": 13,
      "start": 20452.0,
      "end": 20455.0,
      "formatted_start": "05:40:52.000",
      "formatted_end": "05:40:55.000",
      "text": "اینجور چیزی نداریم عزیزم"
    },
    {
      "id": 14,
      "start": 20455.0,
      "end": 20459.0,
      "formatted_start": "05:40:55.000",
      "formatted_end": "05:40:59.000",
      "text": "هر چیزی که شیرینه به دهن شما قند داره"
    },
    {
      "id": 15,
      "start": 20459.0,
      "end": 20462.0,
      "formatted_start": "05:40:59.000",
      "formatted_end": "05:41:02.000",
      "text": "هر چیزی شیرین قند داره عزیزم"
    },
    {
      "id": 16,
      "start": 20462.0,
      "end": 20464.0,
      "formatted_start": "05:41:02.000",
      "formatted_end": "05:41:04.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 17,
      "start": 20464.0,
      "end": 20466.0,
      "formatted_start": "05:41:04.000",
      "formatted_end": "05:41:06.000",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 18,
      "start": 20466.0,
      "end": 20468.0,
      "formatted_start": "05:41:06.000",
      "formatted_end": "05:41:08.000",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 19,
      "start": 20468.0,
      "end": 20470.0,
      "formatted_start": "05:41:08.000",
      "formatted_end": "05:41:10.000",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 20,
      "start": 20470.0,
      "end": 20472.0,
      "formatted_start": "05:41:10.000",
      "formatted_end": "05:41:12.000",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 21,
      "start": 20472.0,
      "end": 20474.0,
      "formatted_start": "05:41:12.000",
      "formatted_end": "05:41:14.000",
      "text": "برای اینجا باید برداریم"
    },
    {
      "id": 22,
      "start": 20474.0,
      "end": 20477.0,
      "formatted_start": "05:41:14.000",
      "formatted_end": "05:41:17.000",
      "text": "دکتر مگرانی رو در طرف اسلامی هستن"
    },
    {
      "id": 23,
      "start": 20477.0,
      "end": 20480.0,
      "formatted_start": "05:41:17.000",
      "formatted_end": "05:41:20.000",
      "text": "تو خودتون رو بیا چند سال و زد چند رو بیا"
    },
    {
      "id": 24,
      "start": 20483.0,
      "end": 20485.0,
      "formatted_start": "05:41:23.000",
      "formatted_end": "05:41:25.000",
      "text": "نه به اعتقاد من نمیدونم"
    },
    {
      "id": 25,
      "start": 20485.0,
      "end": 20488.0,
      "formatted_start": "05:41:25.000",
      "formatted_end": "05:41:28.000",
      "text": "نصبه مریض هایی که رو بکرده"
    },
    {
      "id": 26,
      "start": 20488.0,
      "end": 20491.0,
      "formatted_start": "05:41:28.000",
      "formatted_end": "05:41:31.000",
      "text": "نه چند رو خیلی خیلی خیلی خیلی؟ دو تون مرایه؟"
    },
    {
      "id": 27,
      "start": 20491.0,
      "end": 20493.0,
      "formatted_start": "05:41:31.000",
      "formatted_end": "05:41:33.000",
      "text": "نه یه خانده تا دو تون"
    },
    {
      "id": 28,
      "start": 20493.0,
      "end": 20496.0,
      "formatted_start": "05:41:33.000",
      "formatted_end": "05:41:36.000",
      "text": "نه همه تون هر سال در این گروه رو بگیر"
    },
    {
      "id": 29,
      "start": 20496.0,
      "end": 20497.0,
      "formatted_start": "05:41:36.000",
      "formatted_end": "05:41:37.000",
      "text": "نه همه تون"
    },
    {
      "id": 30,
      "start": 20497.0,
      "end": 20499.0,
      "formatted_start": "05:41:37.000",
      "formatted_end": "05:41:39.000",
      "text": "چند سال و پیش، درده و هزده سال و پیش"
    },
    {
      "id": 31,
      "start": 20499.0,
      "end": 20501.0,
      "formatted_start": "05:41:39.000",
      "formatted_end": "05:41:41.000",
      "text": "آزاد شده تو خودتون رو بیا"
    },
    {
      "id": 32,
      "start": 20501.0,
      "end": 20505.0,
      "formatted_start": "05:41:41.000",
      "formatted_end": "05:41:45.000",
      "text": "الان اولش یکم ضعف میافته خب داروهاد"
    },
    {
      "id": 33,
      "start": 20505.0,
      "end": 20508.0,
      "formatted_start": "05:41:45.000",
      "formatted_end": "05:41:48.000",
      "text": "قل باید دستگاه قند داشته باشه ماما"
    },
    {
      "id": 34,
      "start": 20508.0,
      "end": 20510.0,
      "formatted_start": "05:41:48.000",
      "formatted_end": "05:41:50.000",
      "text": "ماما یکی دیگه برده بگیریم"
    },
    {
      "id": 35,
      "start": 20510.0,
      "end": 20515.0,
      "formatted_start": "05:41:50.000",
      "formatted_end": "05:41:55.000",
      "text": "آره بعد اینم بهت بگم قندشون که کنترل میشه میاد پایین دیده چشم کم میشه"
    },
    {
      "id": 36,
      "start": 20515.0,
      "end": 20520.0,
      "formatted_start": "05:41:55.000",
      "formatted_end": "05:42:00.000",
      "text": "در واقع دیدش کم نمیشه آیا یعنی فکر کنی افته بینه اینو ایدا کرده"
    },
    {
      "id": 37,
      "start": 20520.0,
      "end": 20525.0,
      "formatted_start": "05:42:00.000",
      "formatted_end": "05:42:05.000",
      "text": "قند که خیلی بالاست کلیستال قند تو چشم ایجاد میکنن"
    },
    {
      "id": 38,
      "start": 20525.0,
      "end": 20532.0,
      "formatted_start": "05:42:05.000",
      "formatted_end": "05:42:12.000",
      "text": "اونا مثل آینه عمل می کنند به صورت کازه بینه های مریض رو بالا می روند چون مثل یه لنز عمل می کنند"
    },
    {
      "id": 39,
      "start": 20532.0,
      "end": 20537.0,
      "formatted_start": "05:42:12.000",
      "formatted_end": "05:42:17.000",
      "text": "وقتی قندش به میزان طبیعی برمی گرد می روند زیرا اینجوری که قند های اینقدر بالا دارند"
    },
    {
      "id": 40,
      "start": 20537.0,
      "end": 20542.0,
      "formatted_start": "05:42:17.000",
      "formatted_end": "05:42:22.000",
      "text": "به حالت طبیعی که برمی گرده مریض تازه می فهمه که چرا بینه های شخصی کم شده"
    },
    {
      "id": 41,
      "start": 20542.0,
      "end": 20550.0,
      "formatted_start": "05:42:22.000",
      "formatted_end": "05:42:30.000",
      "text": "بعد شروع می کنیم به ترکار بخودت کنیم اون طبق باشیم کم سرطانی باشیم"
    },
    {
      "id": 42,
      "start": 20550.0,
      "end": 20553.0,
      "formatted_start": "05:42:30.000",
      "formatted_end": "05:42:33.000",
      "text": "باید برای مامان... بیمه مامان چی هست؟"
    },
    {
      "id": 43,
      "start": 20553.0,
      "end": 20554.0,
      "formatted_start": "05:42:33.000",
      "formatted_end": "05:42:34.000",
      "text": "بیمه سلامتی"
    },
    {
      "id": 44,
      "start": 20554.0,
      "end": 20555.0,
      "formatted_start": "05:42:34.000",
      "formatted_end": "05:42:35.000",
      "text": "بیمه سلامتی"
    },
    {
      "id": 45,
      "start": 20555.0,
      "end": 20557.0,
      "formatted_start": "05:42:35.000",
      "formatted_end": "05:42:37.000",
      "text": "تکمیلی نداده مامان اینکه؟"
    },
    {
      "id": 46,
      "start": 20557.0,
      "end": 20558.0,
      "formatted_start": "05:42:37.000",
      "formatted_end": "05:42:38.000",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 20559.0,
      "end": 20562.0,
      "formatted_start": "05:42:39.000",
      "formatted_end": "05:42:42.000",
      "text": "قند ناشت دارد و سختن بهش بگم سخت کنه"
    },
    {
      "id": 48,
      "start": 20562.0,
      "end": 20565.0,
      "formatted_start": "05:42:42.000",
      "formatted_end": "05:42:45.000",
      "text": "ده روز بعد دعوی انجام دارد"
    },
    {
      "id": 49,
      "start": 20570.0,
      "end": 20573.0,
      "formatted_start": "05:42:50.000",
      "formatted_end": "05:42:53.000",
      "text": "اولیش هم زرف میافتی طبیعیه خب؟"
    },
    {
      "id": 50,
      "start": 20573.0,
      "end": 20576.0,
      "formatted_start": "05:42:53.000",
      "formatted_end": "05:42:56.000",
      "text": "به دوازه من از این بهشو ندادم"
    },
    {
      "id": 51,
      "start": 20576.0,
      "end": 20578.0,
      "formatted_start": "05:42:56.000",
      "formatted_end": "05:42:58.000",
      "text": "به دوازه من از این داریم"
    },
    {
      "id": 52,
      "start": 20580.0,
      "end": 20582.76,
      "formatted_start": "05:43:00.000",
      "formatted_end": "05:43:02.760",
      "text": "ملیزیون چی؟ یا چوشان ملیزیون؟"
    },
    {
      "id": 53,
      "start": 20582.76,
      "end": 20583.76,
      "formatted_start": "05:43:02.760",
      "formatted_end": "05:43:03.760",
      "text": "چوشان نرم داره"
    },
    {
      "id": 54,
      "start": 20583.76,
      "end": 20588.44,
      "formatted_start": "05:43:03.760",
      "formatted_end": "05:43:08.440",
      "text": "برد ملیزیون هم بخواد چون مامان عظمت چون اندشه یه دفعه میرده"
    },
    {
      "id": 55,
      "start": 20588.44,
      "end": 20590.72,
      "formatted_start": "05:43:08.440",
      "formatted_end": "05:43:10.720",
      "text": "قدره خوب خیلی انرژی میده به ملیز"
    },
    {
      "id": 56,
      "start": 20590.72,
      "end": 20594.0,
      "formatted_start": "05:43:10.720",
      "formatted_end": "05:43:14.000",
      "text": "یه دفعه که میاد پایین احساسا زرف شدید میدونم"
    },
    {
      "id": 57,
      "start": 20594.0,
      "end": 20608.1,
      "formatted_start": "05:43:14.000",
      "formatted_end": "05:43:28.100",
      "text": "خانگولچین جان"
    },
    {
      "id": 58,
      "start": 20608.1,
      "end": 20638.1,
      "formatted_start": "05:43:28.100",
      "formatted_end": "05:43:58.100",
      "text": "برای از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از این"
    },
    {
      "id": 59,
      "start": 20638.1,
      "end": 20642.9,
      "formatted_start": "05:43:58.100",
      "formatted_end": "05:44:02.900",
      "text": "بسط کوچه ترانسپر قیم شد پرستاختمان 19"
    },
    {
      "id": 60,
      "start": 20642.9,
      "end": 20644.9,
      "formatted_start": "05:44:02.900",
      "formatted_end": "05:44:04.900",
      "text": "واحد 3"
    },
    {
      "id": 61,
      "start": 20644.9,
      "end": 20646.9,
      "formatted_start": "05:44:04.900",
      "formatted_end": "05:44:06.900",
      "text": "طبقه دوم واحد 3"
    },
    {
      "id": 62,
      "start": 20650.4,
      "end": 20652.4,
      "formatted_start": "05:44:10.400",
      "formatted_end": "05:44:12.400",
      "text": "باشه خودت"
    },
    {
      "id": 63,
      "start": 20652.4,
      "end": 20653.4,
      "formatted_start": "05:44:12.400",
      "formatted_end": "05:44:13.400",
      "text": "این خودتو؟"
    },
    {
      "id": 64,
      "start": 20653.4,
      "end": 20655.9,
      "formatted_start": "05:44:13.400",
      "formatted_end": "05:44:15.900",
      "text": "آیا زنگ تو شما زرده داری؟ به زنگ بزنم بگو"
    },
    {
      "id": 65,
      "start": 20655.9,
      "end": 20657.9,
      "formatted_start": "05:44:15.900",
      "formatted_end": "05:44:17.900",
      "text": "دارم یک مرد از مورده"
    },
    {
      "id": 66,
      "start": 20661.9,
      "end": 20663.9,
      "formatted_start": "05:44:21.900",
      "formatted_end": "05:44:23.900",
      "text": "کمارتو خیلی زرد میکنه"
    },
    {
      "id": 67,
      "start": 20663.9,
      "end": 20665.9,
      "formatted_start": "05:44:23.900",
      "formatted_end": "05:44:25.900",
      "text": "کمارم خونده تو این وسیله"
    },
    {
      "id": 68,
      "start": 20665.9,
      "end": 20695.9,
      "formatted_start": "05:44:25.900",
      "formatted_end": "05:44:55.900",
      "text": "بلو اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا"
