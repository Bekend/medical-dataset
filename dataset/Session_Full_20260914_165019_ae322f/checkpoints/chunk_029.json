  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8702.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:02.000",
      "text": "از اینجا، من استرس دارم."
    },
    {
      "id": 1,
      "start": 8702.0,
      "end": 8704.0,
      "formatted_start": "02:25:02.000",
      "formatted_end": "02:25:04.000",
      "text": "یعنی آدم استرسی هستی؟"
    },
    {
      "id": 2,
      "start": 8704.0,
      "end": 8708.0,
      "formatted_start": "02:25:04.000",
      "formatted_end": "02:25:08.000",
      "text": "خیلی نه استرسی نیستم، ولی خب نراحت میشم."
    },
    {
      "id": 3,
      "start": 8708.0,
      "end": 8711.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:11.000",
      "text": "حال گریه هم پیدا می کنی زیاد؟"
    },
    {
      "id": 4,
      "start": 8711.0,
      "end": 8714.0,
      "formatted_start": "02:25:11.000",
      "formatted_end": "02:25:14.000",
      "text": "گریه بعضی وقتا، خیلی کمی."
    },
    {
      "id": 5,
      "start": 8714.0,
      "end": 8715.0,
      "formatted_start": "02:25:14.000",
      "formatted_end": "02:25:15.000",
      "text": "همیشه نیست؟"
    },
    {
      "id": 6,
      "start": 8715.0,
      "end": 8722.0,
      "formatted_start": "02:25:15.000",
      "formatted_end": "02:25:22.000",
      "text": "مثلا، حالا دور باشه، مثلا قبلنا خیلی، یکی که مثلا خود میشد، خیلی گریه میکردم،"
    },
    {
      "id": 7,
      "start": 8722.0,
      "end": 8725.0,
      "formatted_start": "02:25:22.000",
      "formatted_end": "02:25:25.000",
      "text": "ولی حالا بگوییم گو دلم زنگ شده."
    },
    {
      "id": 8,
      "start": 8725.0,
      "end": 8727.0,
      "formatted_start": "02:25:25.000",
      "formatted_end": "02:25:27.000",
      "text": "خوب خوب، خوب صحیحت دنیا است."
    },
    {
      "id": 9,
      "start": 8727.0,
      "end": 8729.0,
      "formatted_start": "02:25:27.000",
      "formatted_end": "02:25:29.000",
      "text": "آره، یه خوردی هم نوشته."
    },
    {
      "id": 10,
      "start": 8729.0,
      "end": 8730.0,
      "formatted_start": "02:25:29.000",
      "formatted_end": "02:25:30.000",
      "text": "این چیز هست؟"
    },
    {
      "id": 11,
      "start": 8730.0,
      "end": 8736.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:36.000",
      "text": "اول خیلی، ولی خوب مثلا دکتر طوری مثلا برخورد می کنه و می گوین خب بزرگ من هم به سیم باشم."
    },
    {
      "id": 12,
      "start": 8736.0,
      "end": 8739.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:39.000",
      "text": "یه خوردی دکتر منو بی خیال کرده بسبب این چیزا."
    },
    {
      "id": 13,
      "start": 8739.0,
      "end": 8741.0,
      "formatted_start": "02:25:39.000",
      "formatted_end": "02:25:41.000",
      "text": "خب خیلی خوبه، این چیز ها برخورد نیست."
    },
    {
      "id": 14,
      "start": 8741.0,
      "end": 8745.0,
      "formatted_start": "02:25:41.000",
      "formatted_end": "02:25:45.000",
      "text": "آره، وقتی یه پسر خالم که فوت شده بود، بود خیلی..."
    },
    {
      "id": 15,
      "start": 8747.0,
      "end": 8749.0,
      "formatted_start": "02:25:47.000",
      "formatted_end": "02:25:49.000",
      "text": "از این چی دارم؟"
    },
    {
      "id": 16,
      "start": 8749.0,
      "end": 8751.0,
      "formatted_start": "02:25:49.000",
      "formatted_end": "02:25:51.000",
      "text": "اخیراً بودم"
    },
    {
      "id": 17,
      "start": 8751.0,
      "end": 8753.0,
      "formatted_start": "02:25:51.000",
      "formatted_end": "02:25:53.000",
      "text": "اپسار میشه دوست داریم"
    },
    {
      "id": 18,
      "start": 8755.0,
      "end": 8758.0,
      "formatted_start": "02:25:55.000",
      "formatted_end": "02:25:58.000",
      "text": "و شباب اتفاقی بدم فکر میکنی یا نه؟"
    },
    {
      "id": 19,
      "start": 8758.0,
      "end": 8759.0,
      "formatted_start": "02:25:58.000",
      "formatted_end": "02:25:59.000",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 8759.0,
      "end": 8762.0,
      "formatted_start": "02:25:59.000",
      "formatted_end": "02:26:02.000",
      "text": "وقتی بیدار میشه دوباره تون میگشه به خوابی؟"
    },
    {
      "id": 21,
      "start": 8762.0,
      "end": 8764.0,
      "formatted_start": "02:26:02.000",
      "formatted_end": "02:26:04.000",
      "text": "من از خوابم میمیبرم خوابیتون"
    },
    {
      "id": 22,
      "start": 8764.0,
      "end": 8765.0,
      "formatted_start": "02:26:04.000",
      "formatted_end": "02:26:05.000",
      "text": "اصلا؟"
    },
    {
      "id": 23,
      "start": 8765.0,
      "end": 8766.0,
      "formatted_start": "02:26:05.000",
      "formatted_end": "02:26:06.000",
      "text": "اصلا"
    },
    {
      "id": 24,
      "start": 8766.0,
      "end": 8768.0,
      "formatted_start": "02:26:06.000",
      "formatted_end": "02:26:08.000",
      "text": "اختلال کامل، اختلال خوابیتون"
    },
    {
      "id": 25,
      "start": 8768.0,
      "end": 8773.2,
      "formatted_start": "02:26:08.000",
      "formatted_end": "02:26:13.200",
      "text": "آره، خیلی دوست دارم، مثلا من لشستم، خوابم می آرد، دراز میکشم، خوابم می پرد"
    },
    {
      "id": 26,
      "start": 8773.2,
      "end": 8775.2,
      "formatted_start": "02:26:13.200",
      "formatted_end": "02:26:15.200",
      "text": "آره، کار میکنه؟"
    },
    {
      "id": 27,
      "start": 8775.2,
      "end": 8777.2,
      "formatted_start": "02:26:15.200",
      "formatted_end": "02:26:17.200",
      "text": "نه، بازنشست شدم"
    },
    {
      "id": 28,
      "start": 8777.2,
      "end": 8778.2,
      "formatted_start": "02:26:17.200",
      "formatted_end": "02:26:18.200",
      "text": "چند سال بازنشست؟"
    },
    {
      "id": 29,
      "start": 8778.2,
      "end": 8780.2,
      "formatted_start": "02:26:18.200",
      "formatted_end": "02:26:20.200",
      "text": "یه سال هم، یه سال نشده"
    },
    {
      "id": 30,
      "start": 8780.2,
      "end": 8782.2,
      "formatted_start": "02:26:20.200",
      "formatted_end": "02:26:22.200",
      "text": "اول بازنشستی که این چیز شایع هست"
    },
    {
      "id": 31,
      "start": 8782.2,
      "end": 8784.2,
      "formatted_start": "02:26:22.200",
      "formatted_end": "02:26:24.200",
      "text": "آره، نمیدونم"
    },
    {
      "id": 32,
      "start": 8784.2,
      "end": 8786.2,
      "formatted_start": "02:26:24.200",
      "formatted_end": "02:26:26.200",
      "text": "چون که به عادت کنید"
    },
    {
      "id": 33,
      "start": 8786.2,
      "end": 8788.2,
      "formatted_start": "02:26:26.200",
      "formatted_end": "02:26:28.200",
      "text": "اول آبان میشه یه سال"
    },
    {
      "id": 34,
      "start": 8788.2,
      "end": 8790.2,
      "formatted_start": "02:26:28.200",
      "formatted_end": "02:26:30.200",
      "text": "عادت داشتی به کار و مشغله زیاد"
    },
    {
      "id": 35,
      "start": 8790.2,
      "end": 8794.2,
      "formatted_start": "02:26:30.200",
      "formatted_end": "02:26:34.200",
      "text": "آره، توی خونم خیلی مثلا تحرک هم زیاده"
    },
    {
      "id": 36,
      "start": 8794.2,
      "end": 8799.04,
      "formatted_start": "02:26:34.200",
      "formatted_end": "02:26:39.040",
      "text": "دائم یه نیستم که بیفتم یا سلم بگم که بلشم بازش هست شدم"
    },
    {
      "id": 37,
      "start": 8799.04,
      "end": 8799.54,
      "formatted_start": "02:26:39.040",
      "formatted_end": "02:26:39.540",
      "text": "نه"
    },
    {
      "id": 38,
      "start": 8799.54,
      "end": 8804.5,
      "formatted_start": "02:26:39.540",
      "formatted_end": "02:26:44.500",
      "text": "کارمو برموزی میکنم که هم خسته نشم من اینکه"
    },
    {
      "id": 39,
      "start": 8804.5,
      "end": 8805.64,
      "formatted_start": "02:26:44.500",
      "formatted_end": "02:26:45.640",
      "text": "پیادرگی میجه"
    },
    {
      "id": 40,
      "start": 8805.64,
      "end": 8809.08,
      "formatted_start": "02:26:45.640",
      "formatted_end": "02:26:49.080",
      "text": "نه یه مدت میرفتم باشگاه و باز خیلی کردم"
    },
    {
      "id": 41,
      "start": 8809.08,
      "end": 8812.3,
      "formatted_start": "02:26:49.080",
      "formatted_end": "02:26:52.300",
      "text": "پیادرگی ورسش مغزه خیلی خوبه"
    },
    {
      "id": 42,
      "start": 8812.3,
      "end": 8813.2,
      "formatted_start": "02:26:52.300",
      "formatted_end": "02:26:53.200",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 8813.2,
      "end": 8815.68,
      "formatted_start": "02:26:53.200",
      "formatted_end": "02:26:55.680",
      "text": "منم هوا گرمه خواهیم"
    },
    {
      "id": 44,
      "start": 8815.68,
      "end": 8817.72,
      "formatted_start": "02:26:55.680",
      "formatted_end": "02:26:57.720",
      "text": "آره الان دقیقا همین موضوعه"
    },
    {
      "id": 45,
      "start": 8817.72,
      "end": 8818.54,
      "formatted_start": "02:26:57.720",
      "formatted_end": "02:26:58.540",
      "text": "اینقدر همه"
    },
    {
      "id": 46,
      "start": 8818.54,
      "end": 8821.22,
      "formatted_start": "02:26:58.540",
      "formatted_end": "02:27:01.220",
      "text": "من باید گرمه باشگاه رو بر کردم ما خیلی گرم بودیم"
    },
    {
      "id": 47,
      "start": 8821.22,
      "end": 8824.72,
      "formatted_start": "02:27:01.220",
      "formatted_end": "02:27:04.720",
      "text": "دقیقا، الان با این دو ماه واقعا سخت شده"
    },
    {
      "id": 48,
      "start": 8824.72,
      "end": 8829.22,
      "formatted_start": "02:27:04.720",
      "formatted_end": "02:27:09.220",
      "text": "به ترامپ کوپین شروع میکنن، خب ترامپ کوپین اتیاداور نیست"
    },
    {
      "id": 49,
      "start": 8829.22,
      "end": 8833.22,
      "formatted_start": "02:27:09.220",
      "formatted_end": "02:27:13.220",
      "text": "و در معنی اختلال خوابه، خب کویتیا پیره"
    },
    {
      "id": 50,
      "start": 8833.22,
      "end": 8837.22,
      "formatted_start": "02:27:13.220",
      "formatted_end": "02:27:17.220",
      "text": "بعد من با 25 شروع میکنم، خب این داست ها به 50 جا داریم"
    },
    {
      "id": 51,
      "start": 8837.22,
      "end": 8841.22,
      "formatted_start": "02:27:17.220",
      "formatted_end": "02:27:21.220",
      "text": "شما اول با شبیه نصف شروع کنید، خب تا بعد انتو عادت کنه"
    },
    {
      "id": 52,
      "start": 8841.22,
      "end": 8846.22,
      "formatted_start": "02:27:21.220",
      "formatted_end": "02:27:26.220",
      "text": "زیر 25 واقعا اثرگزار نیست، بعد خودتون به دوت 25 بذارید"
    },
    {
      "id": 53,
      "start": 8846.22,
      "end": 8852.22,
      "formatted_start": "02:27:26.220",
      "formatted_end": "02:27:32.220",
      "text": "بعد برسونیم از ساعت هفته شب به بعد کافین و قهر استفاده نکنید"
    },
    {
      "id": 54,
      "start": 8852.22,
      "end": 8855.22,
      "formatted_start": "02:27:32.220",
      "formatted_end": "02:27:35.220",
      "text": "چای نخورید، تندوی نها نخورید"
    },
    {
      "id": 55,
      "start": 8855.22,
      "end": 8858.22,
      "formatted_start": "02:27:35.220",
      "formatted_end": "02:27:38.220",
      "text": "براتون من یزوی همون می نمی سم شبها بخورید"
    },
    {
      "id": 56,
      "start": 8858.22,
      "end": 8862.22,
      "formatted_start": "02:27:38.220",
      "formatted_end": "02:27:42.220",
      "text": "جوشان همون می نمی سم، که کفتها ها با خیلی بانده هم می برده بسیار"
    },
    {
      "id": 57,
      "start": 8863.22,
      "end": 8869.22,
      "formatted_start": "02:27:43.220",
      "formatted_end": "02:27:49.220",
      "text": "می کنم به دقات دارم این چیزها دیگه تو سیستم نورنوچی که بدن خیلی تاثیر داره"
    },
    {
      "id": 58,
      "start": 8869.22,
      "end": 8899.22,
      "formatted_start": "02:27:49.220",
      "formatted_end": "02:28:19.220",
      "text": "اما از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از این"
    },
    {
      "id": 59,
      "start": 8899.22,
      "end": 8905.22,
      "formatted_start": "02:28:19.220",
      "formatted_end": "02:28:25.220",
      "text": "دوستان خواب خیلی عمیق برم و هیچ چی متوجه نشن"
    },
    {
      "id": 60,
      "start": 8905.22,
      "end": 8907.22,
      "formatted_start": "02:28:25.220",
      "formatted_end": "02:28:27.220",
      "text": "میرو خب مامانو چون اینا اینجا رو بیاریم"
    },
    {
      "id": 61,
      "start": 8907.22,
      "end": 8908.22,
      "formatted_start": "02:28:27.220",
      "formatted_end": "02:28:28.220",
      "text": "آره بگیر"
    },
    {
      "id": 62,
      "start": 8908.22,
      "end": 8909.22,
      "formatted_start": "02:28:28.220",
      "formatted_end": "02:28:29.220",
      "text": "برس خواب خواب"
    },
    {
      "id": 63,
      "start": 8909.22,
      "end": 8911.22,
      "formatted_start": "02:28:29.220",
      "formatted_end": "02:28:31.220",
      "text": "همینش جنتی که نمیتونیم"
    },
    {
      "id": 64,
      "start": 8911.22,
      "end": 8913.22,
      "formatted_start": "02:28:31.220",
      "formatted_end": "02:28:33.220",
      "text": "همینش چیزی هست جنتی"
    },
    {
      "id": 65,
      "start": 8913.22,
      "end": 8914.22,
      "formatted_start": "02:28:33.220",
      "formatted_end": "02:28:34.220",
      "text": "آره"
    },
    {
      "id": 66,
      "start": 8914.22,
      "end": 8915.22,
      "formatted_start": "02:28:34.220",
      "formatted_end": "02:28:35.220",
      "text": "ما جنتی که نمیتونیم"
    },
    {
      "id": 67,
      "start": 8915.22,
      "end": 8917.22,
      "formatted_start": "02:28:35.220",
      "formatted_end": "02:28:37.220",
      "text": "از جگه استان که بودم فراموش بودم"
    },
    {
      "id": 68,
      "start": 8917.22,
      "end": 8920.22,
      "formatted_start": "02:28:37.220",
      "formatted_end": "02:28:40.220",
      "text": "یه بار رفته بودیم بردو با بچه ها ببینم"
    },
    {
      "id": 69,
      "start": 8920.22,
      "end": 8922.22,
      "formatted_start": "02:28:40.220",
      "formatted_end": "02:28:42.220",
      "text": "بعد من خوابیده بودم"
    },
    {
      "id": 70,
      "start": 8922.22,
      "end": 8929.22,
      "formatted_start": "02:28:42.220",
      "formatted_end": "02:28:49.220",
      "text": "مثل اینکه یک نفر اومده دور از مدیر کلا و بینام خواستن که مثل همه بچه ها باشن"
    },
    {
      "id": 71,
      "start": 8929.22,
      "end": 8933.22,
      "formatted_start": "02:28:49.220",
      "formatted_end": "02:28:53.220",
      "text": "دوستان میگن هر چی تو رو صدا زدین اتوجه نشد"
    },
    {
      "id": 72,
      "start": 8933.22,
      "end": 8936.22,
      "formatted_start": "02:28:53.220",
      "formatted_end": "02:28:56.220",
      "text": "میگه فکر کنی آتن تو مردی"
    },
    {
      "id": 73,
      "start": 8936.22,
      "end": 8941.22,
      "formatted_start": "02:28:56.220",
      "formatted_end": "02:29:01.220",
      "text": "و اگه بیدار شدن و اینا دیگه تموم شده به مراسم"
    },
    {
      "id": 74,
      "start": 8941.22,
      "end": 8945.22,
      "formatted_start": "02:29:01.220",
      "formatted_end": "02:29:05.220",
      "text": "گفتم به هستن اتوجه نشدن که رو من رو صدا زدین"
    },
    {
      "id": 75,
      "start": 8945.22,
      "end": 8947.22,
      "formatted_start": "02:29:05.220",
      "formatted_end": "02:29:07.220",
      "text": "این در دوران کدکی و این ها؟"
    },
    {
      "id": 76,
      "start": 8947.22,
      "end": 8949.22,
      "formatted_start": "02:29:07.220",
      "formatted_end": "02:29:09.220",
      "text": "اول دقیقه سامون"
    },
    {
      "id": 77,
      "start": 8949.22,
      "end": 8950.22,
      "formatted_start": "02:29:09.220",
      "formatted_end": "02:29:10.220",
      "text": "یعنی اون زمان پول نخواهید؟"
    },
    {
      "id": 78,
      "start": 8950.22,
      "end": 8952.22,
      "formatted_start": "02:29:10.220",
      "formatted_end": "02:29:12.220",
      "text": "خیلی خوابم خیلی سنیم"
    },
    {
      "id": 79,
      "start": 8952.22,
      "end": 8956.22,
      "formatted_start": "02:29:12.220",
      "formatted_end": "02:29:16.220",
      "text": "من مثلا میخوابیدم که شب بتونم بیدار بمونم"
    },
    {
      "id": 80,
      "start": 8956.22,
      "end": 8959.22,
      "formatted_start": "02:29:16.220",
      "formatted_end": "02:29:19.220",
      "text": "سریاد مثلا اون گوشین چی اونو نگاه کنم"
    },
    {
      "id": 81,
      "start": 8959.22,
      "end": 8960.22,
      "formatted_start": "02:29:19.220",
      "formatted_end": "02:29:20.220",
      "text": "تو این هست"
    },
    {
      "id": 82,
      "start": 8960.22,
      "end": 8963.22,
      "formatted_start": "02:29:20.220",
      "formatted_end": "02:29:23.220",
      "text": "خب یه چیز بهتون بگم شما میدونید که با هر دهه سمکه میزنید"
    },
    {
      "id": 83,
      "start": 8963.22,
      "end": 8965.22,
      "formatted_start": "02:29:23.220",
      "formatted_end": "02:29:25.220",
      "text": "میزنید به خواب کم شد"
    },
    {
      "id": 84,
      "start": 8965.22,
      "end": 8969.22,
      "formatted_start": "02:29:25.220",
      "formatted_end": "02:29:29.220",
      "text": "و شما اصلا حتی توی افراد محسن پنج ساعت خواب در روز کافیه"
    },
    {
      "id": 85,
      "start": 8969.22,
      "end": 8971.22,
      "formatted_start": "02:29:29.220",
      "formatted_end": "02:29:31.220",
      "text": "یعنی حتی برای بدن کافیه"
    },
    {
      "id": 86,
      "start": 8971.22,
      "end": 8973.22,
      "formatted_start": "02:29:31.220",
      "formatted_end": "02:29:33.220",
      "text": "سیستم برن انسان اینجا"
    },
    {
      "id": 87,
      "start": 8973.22,
      "end": 8975.22,
      "formatted_start": "02:29:33.220",
      "formatted_end": "02:29:35.220",
      "text": "اصلا هیچ که خواب را خواب شد"
    },
    {
      "id": 88,
      "start": 8975.22,
      "end": 8979.02,
      "formatted_start": "02:29:35.220",
      "formatted_end": "02:29:39.020",
      "text": "یک چیزی هم بهتو بگم شب که خوابت نداری بره باش برو توی اتاق دیگه کارتو بگو"
    },
    {
      "id": 89,
      "start": 8979.02,
      "end": 8980.8,
      "formatted_start": "02:29:39.020",
      "formatted_end": "02:29:40.800",
      "text": "برو کتاب بخونی و بری ندونم"
    },
    {
      "id": 90,
      "start": 8980.8,
      "end": 8982.84,
      "formatted_start": "02:29:40.800",
      "formatted_end": "02:29:42.840",
      "text": "با یه چیزی خورتون سرگن کنی"
    },
    {
      "id": 91,
      "start": 8982.84,
      "end": 8985.4,
      "formatted_start": "02:29:42.840",
      "formatted_end": "02:29:45.400",
      "text": "یعنی نه این طورت خوابت نداری"
    },
    {
      "id": 92,
      "start": 8985.4,
      "end": 8987.44,
      "formatted_start": "02:29:45.400",
      "formatted_end": "02:29:47.440",
      "text": "خوابت نداری این خیلی ازره می کنه"
    },
    {
      "id": 93,
      "start": 8987.44,
      "end": 8990.56,
      "formatted_start": "02:29:47.440",
      "formatted_end": "02:29:50.560",
      "text": "یعنی باز سیستم خوابتیتونو مختلف می کنی"
    },
    {
      "id": 94,
      "start": 8990.56,
      "end": 8991.2,
      "formatted_start": "02:29:50.560",
      "formatted_end": "02:29:51.200",
      "text": "نخوابی"
    },
    {
      "id": 95,
      "start": 8991.2,
      "end": 8992.74,
      "formatted_start": "02:29:51.200",
      "formatted_end": "02:29:52.740",
      "text": "اگه فرده صبح امتحان ده"
    },
    {
      "id": 96,
      "start": 8992.74,
      "end": 8994.7,
      "formatted_start": "02:29:52.740",
      "formatted_end": "02:29:54.700",
      "text": "اگه فرده صبح جلسه ده"
    },
    {
      "id": 97,
      "start": 8994.7,
      "end": 8996.7,
      "formatted_start": "02:29:54.700",
      "formatted_end": "02:29:56.700",
      "text": "مقررشش سپری معمولیه"
    },
    {
      "id": 98,
      "start": 8996.7,
      "end": 8997.7,
      "formatted_start": "02:29:56.700",
      "formatted_end": "02:29:57.700",
      "text": "نه"
    },
    {
      "id": 99,
      "start": 8997.7,
      "end": 8999.7,
      "formatted_start": "02:29:57.700",
      "formatted_end": "02:29:59.700",
      "text": "خب از خوابتون نبرد چه اتفاقی میاد؟"
    }
  ],
  "status": "completed"
}