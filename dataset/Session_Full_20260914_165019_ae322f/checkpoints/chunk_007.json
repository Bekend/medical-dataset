  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2102.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 2130.0,
      "end": 2132.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:32.000",
      "text": "بچه نمیدونی؟"
    },
    {
      "id": 2,
      "start": 2132.0,
      "end": 2134.0,
      "formatted_start": "00:35:32.000",
      "formatted_end": "00:35:34.000",
      "text": "باید برم برم"
    },
    {
      "id": 3,
      "start": 2134.0,
      "end": 2136.0,
      "formatted_start": "00:35:34.000",
      "formatted_end": "00:35:36.000",
      "text": "نه"
    },
    {
      "id": 4,
      "start": 2136.0,
      "end": 2138.0,
      "formatted_start": "00:35:36.000",
      "formatted_end": "00:35:38.000",
      "text": "بزن"
    },
    {
      "id": 5,
      "start": 2138.0,
      "end": 2140.0,
      "formatted_start": "00:35:38.000",
      "formatted_end": "00:35:40.000",
      "text": "راستی رو برم برم"
    },
    {
      "id": 6,
      "start": 2140.0,
      "end": 2142.0,
      "formatted_start": "00:35:40.000",
      "formatted_end": "00:35:42.000",
      "text": "تکن بره تکن بره میاد"
    },
    {
      "id": 7,
      "start": 2142.0,
      "end": 2144.0,
      "formatted_start": "00:35:42.000",
      "formatted_end": "00:35:44.000",
      "text": "تکن بره"
    },
    {
      "id": 8,
      "start": 2144.0,
      "end": 2146.0,
      "formatted_start": "00:35:44.000",
      "formatted_end": "00:35:46.000",
      "text": "اینو بره خانه زنو"
    },
    {
      "id": 9,
      "start": 2146.0,
      "end": 2148.0,
      "formatted_start": "00:35:46.000",
      "formatted_end": "00:35:48.000",
      "text": "برم"
    },
    {
      "id": 10,
      "start": 2148.0,
      "end": 2150.0,
      "formatted_start": "00:35:48.000",
      "formatted_end": "00:35:50.000",
      "text": "باید یه بره"
    },
    {
      "id": 11,
      "start": 2150.0,
      "end": 2152.0,
      "formatted_start": "00:35:50.000",
      "formatted_end": "00:35:52.000",
      "text": "برم"
    },
    {
      "id": 12,
      "start": 2152.0,
      "end": 2154.0,
      "formatted_start": "00:35:52.000",
      "formatted_end": "00:35:54.000",
      "text": "یه سی سه سه سه سه پنج شما"
    },
    {
      "id": 13,
      "start": 2154.0,
      "end": 2156.0,
      "formatted_start": "00:35:54.000",
      "formatted_end": "00:35:56.000",
      "text": "از آقای گنجی کارت بکش"
    },
    {
      "id": 14,
      "start": 2156.0,
      "end": 2172.0,
      "formatted_start": "00:35:56.000",
      "formatted_end": "00:36:12.000",
      "text": "بیایی من تعداد بالا نوشتم کم نریاری و شما همون جوری که مصرف میکنی استفاده بکنید"
    },
    {
      "id": 15,
      "start": 2172.0,
      "end": 2174.0,
      "formatted_start": "00:36:12.000",
      "formatted_end": "00:36:14.000",
      "text": "از دست خودم رو بیس از همون به بعد میشه"
    },
    {
      "id": 16,
      "start": 2174.0,
      "end": 2176.0,
      "formatted_start": "00:36:14.000",
      "formatted_end": "00:36:16.000",
      "text": "دست خودتونی؟"
    },
    {
      "id": 17,
      "start": 2176.0,
      "end": 2178.0,
      "formatted_start": "00:36:16.000",
      "formatted_end": "00:36:18.000",
      "text": "بله، از تمام عقودم رو بشکرم"
    },
    {
      "id": 18,
      "start": 2178.0,
      "end": 2180.0,
      "formatted_start": "00:36:18.000",
      "formatted_end": "00:36:20.000",
      "text": "بچه باید خودم بکر شده، میتر نشده"
    },
    {
      "id": 19,
      "start": 2180.0,
      "end": 2182.0,
      "formatted_start": "00:36:20.000",
      "formatted_end": "00:36:22.000",
      "text": "منم باید خودم همجورم"
    },
    {
      "id": 20,
      "start": 2182.0,
      "end": 2184.0,
      "formatted_start": "00:36:22.000",
      "formatted_end": "00:36:24.000",
      "text": "بچه به دکتر گرم، تا خودتون کجا رفتی؟"
    },
    {
      "id": 21,
      "start": 2184.0,
      "end": 2186.0,
      "formatted_start": "00:36:24.000",
      "formatted_end": "00:36:26.000",
      "text": "تو شالی رفتی؟"
    },
    {
      "id": 22,
      "start": 2186.0,
      "end": 2188.0,
      "formatted_start": "00:36:26.000",
      "formatted_end": "00:36:28.000",
      "text": "تو شالی رفتی؟"
    },
    {
      "id": 23,
