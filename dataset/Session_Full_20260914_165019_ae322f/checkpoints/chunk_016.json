  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4804.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:04.000",
      "text": "اما اکثر هر کار بکنید، خاطراتش بیادش میفته؟"
    },
    {
      "id": 1,
      "start": 4804.0,
      "end": 4809.0,
      "formatted_start": "01:20:04.000",
      "formatted_end": "01:20:09.000",
      "text": "نه خاطر ببینید شما، یک چیز بهت بگم نباشم، پار هیچ وقت پاک نمیشه که،"
    },
    {
      "id": 2,
      "start": 4809.0,
      "end": 4813.0,
      "formatted_start": "01:20:09.000",
      "formatted_end": "01:20:13.000",
      "text": "معاینه این مریضه قدیمی من همون پدر ماده هم تو یه روز را دست دادم،"
    },
    {
      "id": 3,
      "start": 4813.0,
      "end": 4822.0,
      "formatted_start": "01:20:13.000",
      "formatted_end": "01:20:22.000",
      "text": "پس ازن تا هر روز روز تو نیست روزی، اما دیگه اینجوری شما خیلی تو اون داده هنوز موندید،"
    },
    {
      "id": 4,
      "start": 4822.0,
      "end": 4826.0,
      "formatted_start": "01:20:22.000",
      "formatted_end": "01:20:26.000",
      "text": "بچه هم زنش میده، خودتو نداره، بچه هم زنش میده،"
    },
    {
      "id": 5,
      "start": 4826.0,
      "end": 4856.0,
      "formatted_start": "01:20:26.000",
      "formatted_end": "01:20:56.000",
      "text": "از اینجور باید برداریم که اینجور باید برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداریم که اینجور برداری"
    },
    {
      "id": 6,
      "start": 4856.0,
      "end": 4862.0,
      "formatted_start": "01:20:56.000",
      "formatted_end": "01:21:02.000",
      "text": "این ها نفت ندادم. قرصانون تمام شده دادم."
    },
    {
      "id": 7,
      "start": 4862.0,
      "end": 4866.0,
      "formatted_start": "01:21:02.000",
      "formatted_end": "01:21:06.000",
      "text": "الان چه چه باعث میخوانی؟"
    },
    {
      "id": 8,
      "start": 4866.0,
      "end": 4870.0,
      "formatted_start": "01:21:06.000",
      "formatted_end": "01:21:10.000",
      "text": "همین، خاطر همین این گزارشایی هم نگهرید."
    },
    {
      "id": 9,
      "start": 4870.0,
      "end": 4874.0,
      "formatted_start": "01:21:10.000",
      "formatted_end": "01:21:14.000",
      "text": "همین صدا منگیه."
    },
    {
      "id": 10,
      "start": 4874.0,
      "end": 4876.0,
      "formatted_start": "01:21:14.000",
      "formatted_end": "01:21:16.000",
      "text": "اینو که اون روز دیدم با موجود."
    },
    {
      "id": 11,
      "start": 4876.0,
      "end": 4877.0,
      "formatted_start": "01:21:16.000",
      "formatted_end": "01:21:17.000",
      "text": "دیدی؟"
    },
    {
      "id": 12,
      "start": 4877.0,
      "end": 4884.0,
      "formatted_start": "01:21:17.000",
      "formatted_end": "01:21:24.000",
      "text": "این توی من که خوندم، گفته که اعتمالا توی یک قسمتی از ریه افونته. خب؟"
    },
    {
      "id": 13,
      "start": 4884.0,
      "end": 4889.76,
      "formatted_start": "01:21:24.000",
      "formatted_end": "01:21:29.760",
      "text": "حالا این کار دکتر فوقتخصوص ریه است که باید بره با دستگاه ببینه"
    },
    {
      "id": 14,
      "start": 4889.76,
      "end": 4906.12,
      "formatted_start": "01:21:29.760",
      "formatted_end": "01:21:46.120",
      "text": "حالا نیمونه هم که برداره تا جواب نمونه بیاد بیس روز طول می کشه بابا جون"
    },
    {
      "id": 15,
      "start": 4906.12,
      "end": 4909.16,
      "formatted_start": "01:21:46.120",
      "formatted_end": "01:21:49.160",
      "text": "بس من گرسشی می خواهم کجا کنم"
    },
    {
      "id": 16,
      "start": 4909.16,
      "end": 4916.16,
      "formatted_start": "01:21:49.160",
      "formatted_end": "01:21:56.160",
      "text": "بخاطر صدا، همه چی که قرص کنه، اگه کاش قرص همه چی رو حل کنه، همه چی که با قرص دارست نمیشه بابا جان"
    },
    {
      "id": 17,
      "start": 4916.16,
      "end": 4924.16,
      "formatted_start": "01:21:56.160",
      "formatted_end": "01:22:04.160",
      "text": "بلی الان همه اینها که باید کم سبوری کنه، بجاز صدا، دردم داری"
    },
    {
      "id": 18,
      "start": 4924.16,
      "end": 4925.16,
      "formatted_start": "01:22:04.160",
      "formatted_end": "01:22:05.160",
      "text": "نه دردم داری"
    },
    {
      "id": 19,
      "start": 4925.16,
      "end": 4928.16,
      "formatted_start": "01:22:05.160",
      "formatted_end": "01:22:08.160",
      "text": "اون روز که من بهتون آنپول زدم، بهتر شدی"
    },
    {
      "id": 20,
      "start": 4928.16,
      "end": 4930.16,
      "formatted_start": "01:22:08.160",
      "formatted_end": "01:22:10.160",
      "text": "اون، الان پام بود"
    },
    {
      "id": 21,
      "start": 4930.16,
      "end": 4933.16,
      "formatted_start": "01:22:10.160",
      "formatted_end": "01:22:13.160",
      "text": "نه من توش آنپول گره، اتون زدم"
    },
    {
      "id": 22,
      "start": 4933.16,
      "end": 4936.16,
      "formatted_start": "01:22:13.160",
      "formatted_end": "01:22:16.160",
      "text": "ده دو، یه روز هستم، ده دو، بعد دو روز دیگه"
    },
    {
      "id": 23,
      "start": 4936.16,
      "end": 4939.56,
      "formatted_start": "01:22:16.160",
      "formatted_end": "01:22:19.560",
      "text": "خب اون روز بهتر شده یه فرق نکرده"
    },
    {
      "id": 24,
      "start": 4939.56,
      "end": 4941.02,
      "formatted_start": "01:22:19.560",
      "formatted_end": "01:22:21.020",
      "text": "نه برو صورت سیاد نه"
    },
    {
      "id": 25,
      "start": 4941.02,
      "end": 4946.8,
      "formatted_start": "01:22:21.020",
      "formatted_end": "01:22:26.800",
      "text": "من فکر نمی کنم که دارو خیلی اثر کنه"
    },
    {
      "id": 26,
      "start": 4946.8,
      "end": 4950.24,
      "formatted_start": "01:22:26.800",
      "formatted_end": "01:22:30.240",
      "text": "وگرنه که اگه اثر داشت که من برای چی برای شما دارو نمی سنم"
    },
    {
      "id": 27,
      "start": 4950.24,
      "end": 4952.96,
      "formatted_start": "01:22:30.240",
      "formatted_end": "01:22:32.960",
      "text": "من از خدا میکنم به مریض میتونم یه کمک بکنم"
    },
    {
      "id": 28,
      "start": 4952.96,
      "end": 4954.28,
      "formatted_start": "01:22:32.960",
      "formatted_end": "01:22:34.280",
      "text": "نه سه درد نکنم"
    },
    {
      "id": 29,
      "start": 4954.28,
      "end": 4957.02,
      "formatted_start": "01:22:34.280",
      "formatted_end": "01:22:37.020",
      "text": "ولی این دارو نیست این فلت شده"
    },
    {
      "id": 30,
      "start": 4957.02,
      "end": 4961.5,
      "formatted_start": "01:22:37.020",
      "formatted_end": "01:22:41.500",
      "text": "نوشته که تارای سوتین یه طرفتون فلت شده"
    },
    {
      "id": 31,
      "start": 4961.5,
      "end": 4965.24,
      "formatted_start": "01:22:41.500",
      "formatted_end": "01:22:45.240",
      "text": "درسته اموگم دکتر سینا که نگاه کرد به من کنه"
    },
    {
      "id": 32,
      "start": 4965.24,
      "end": 4971.24,
      "formatted_start": "01:22:45.240",
      "formatted_end": "01:22:51.240",
      "text": "آره، بعد وقتی که فلج میشه، خب دیگه داروی برنیم گردنه بابا جان"
    },
    {
      "id": 33,
      "start": 4971.24,
      "end": 4977.24,
      "formatted_start": "01:22:51.240",
      "formatted_end": "01:22:57.240",
      "text": "حالا ما باید این نمونه رو بگیرم ببینیم جوابش چی میریاد، انشاده که خیله"
    },
    {
      "id": 34,
      "start": 4977.24,
      "end": 4979.24,
      "formatted_start": "01:22:57.240",
      "formatted_end": "01:22:59.240",
      "text": "بنابراین چی کنم؟"
    },
    {
      "id": 35,
      "start": 4979.24,
      "end": 4992.24,
      "formatted_start": "01:22:59.240",
      "formatted_end": "01:23:12.240",
      "text": "از نظر داروینا، دردتون رو شاید بتونیم دارو بگیرم، اما برای استعداد کار نمیتونیم، من بابا بگیرم"
    },
    {
      "id": 36,
      "start": 4992.24,
      "end": 4997.24,
      "formatted_start": "01:23:12.240",
      "formatted_end": "01:23:17.240",
      "text": "من هر دیگه نام میخوردم، این نام خطاوره دیگه"
    },
    {
      "id": 37,
      "start": 4997.24,
      "end": 5000.24,
      "formatted_start": "01:23:17.240",
      "formatted_end": "01:23:20.240",
      "text": "باشه چنین"
    },
    {
      "id": 38,
      "start": 5000.24,
      "end": 5006.24,
      "formatted_start": "01:23:20.240",
      "formatted_end": "01:23:26.240",
      "text": "بعد، من دارم منو میشم، یک کم منو میشم"
    },
    {
      "id": 39,
      "start": 5006.24,
      "end": 5007.24,
      "formatted_start": "01:23:26.240",
      "formatted_end": "01:23:27.240",
      "text": "باشه"
    },
    {
      "id": 40,
      "start": 5007.24,
      "end": 5012.24,
      "formatted_start": "01:23:27.240",
      "formatted_end": "01:23:32.240",
      "text": "بعد، اخرشم یک پیزاکودی، پنج و شست، واسه خانم منو میزن شد"
    },
    {
      "id": 41,
      "start": 5012.24,
      "end": 5014.24,
      "formatted_start": "01:23:32.240",
      "formatted_end": "01:23:34.240",
      "text": "من اگه جادم"
    },
    {
      "id": 42,
      "start": 5014.24,
      "end": 5022.24,
      "formatted_start": "01:23:34.240",
      "formatted_end": "01:23:42.240",
      "text": "بازم آرده تشکیل سه شما بازم گردیم"
    },
    {
      "id": 43,
      "start": 5022.24,
      "end": 5028.24,
      "formatted_start": "01:23:42.240",
      "formatted_end": "01:23:48.240",
      "text": "گاهی وقتا"
    },
    {
      "id": 44,
      "start": 5028.24,
      "end": 5031.24,
      "formatted_start": "01:23:48.240",
      "formatted_end": "01:23:51.240",
      "text": "حالا مرسو میده هم دادید دارم همین صحبت"
    },
    {
      "id": 45,
      "start": 5031.24,
      "end": 5036.24,
      "formatted_start": "01:23:51.240",
      "formatted_end": "01:23:56.240",
      "text": "دارو نمیتونه مثلا میگو دور از جون بابا آدم خدای نکرده سکته کنه"
    },
    {
      "id": 46,
      "start": 5036.24,
      "end": 5041.24,
      "formatted_start": "01:23:56.240",
      "formatted_end": "01:24:01.240",
      "text": "خب دست که فلشه خب دارو که اینو دیگه بر نمیگردونه بابا"
    },
    {
      "id": 47,
      "start": 5041.24,
      "end": 5044.9,
      "formatted_start": "01:24:01.240",
      "formatted_end": "01:24:04.900",
      "text": "این تارسات شما یه طرفش فرق شده"
    },
    {
      "id": 48,
      "start": 5044.9,
      "end": 5048.2,
      "formatted_start": "01:24:04.900",
      "formatted_end": "01:24:08.200",
      "text": "خدا روش رو یه طرفه برمی میتونی صحبت کنی"
    },
    {
      "id": 49,
      "start": 5048.2,
      "end": 5051.84,
      "formatted_start": "01:24:08.200",
      "formatted_end": "01:24:11.840",
      "text": "بله ایتون بارش هست نتیجه داشته باشه"
    },
    {
      "id": 50,
      "start": 5051.84,
      "end": 5053.7,
      "formatted_start": "01:24:11.840",
      "formatted_end": "01:24:13.700",
      "text": "خدا بزرگه"
    },
    {
      "id": 51,
      "start": 5053.7,
      "end": 5055.72,
      "formatted_start": "01:24:13.700",
      "formatted_end": "01:24:15.720",
      "text": "برای واسه میدونیم چی میشه"
    },
    {
      "id": 52,
      "start": 5055.72,
      "end": 5057.54,
      "formatted_start": "01:24:15.720",
      "formatted_end": "01:24:17.540",
      "text": "توقف بر خدا بابا جاییم"
    },
    {
      "id": 53,
      "start": 5057.54,
      "end": 5059.72,
      "formatted_start": "01:24:17.540",
      "formatted_end": "01:24:19.720",
      "text": "بله برای مانن نمیشه برای همدوستی کنه"
    },
    {
      "id": 54,
      "start": 5059.72,
      "end": 5061.0,
      "formatted_start": "01:24:19.720",
      "formatted_end": "01:24:21.000",
      "text": "آره"
    },
    {
      "id": 55,
      "start": 5061.0,
      "end": 5062.52,
      "formatted_start": "01:24:21.000",
      "formatted_end": "01:24:22.520",
      "text": "هستی به ایرانی نه"
    },
    {
      "id": 56,
      "start": 5062.52,
      "end": 5064.82,
      "formatted_start": "01:24:22.520",
      "formatted_end": "01:24:24.820",
      "text": "برای واسه نمیدونیم"
    },
    {
      "id": 57,
      "start": 5064.82,
      "end": 5066.98,
      "formatted_start": "01:24:24.820",
      "formatted_end": "01:24:26.980",
      "text": "اونم اینجوری نیست که فکر کنی اکس میرفت"
    },
    {
      "id": 58,
      "start": 5066.98,
      "end": 5067.94,
      "formatted_start": "01:24:26.980",
      "formatted_end": "01:24:27.940",
      "text": "از جواب اومد"
    },
    {
      "id": 59,
      "start": 5067.94,
      "end": 5069.94,
      "formatted_start": "01:24:27.940",
      "formatted_end": "01:24:29.940",
      "text": "کلی طول می کشید"
    },
    {
      "id": 60,
      "start": 5072.94,
      "end": 5074.94,
      "formatted_start": "01:24:32.940",
      "formatted_end": "01:24:34.940",
      "text": "دعا با انشالله که خیلی باشه"
    },
    {
      "id": 61,
      "start": 5074.94,
      "end": 5075.94,
      "formatted_start": "01:24:34.940",
      "formatted_end": "01:24:35.940",
      "text": "نقص درد نکنم"
    },
    {
      "id": 62,
      "start": 5075.94,
      "end": 5077.94,
      "formatted_start": "01:24:35.940",
      "formatted_end": "01:24:37.940",
      "text": "ایزا کودین و"
    },
    {
      "id": 63,
      "start": 5077.94,
      "end": 5081.94,
      "formatted_start": "01:24:37.940",
      "formatted_end": "01:24:41.940",
      "text": "مسکن هم برای نافرست که نگرم بده"
    },
    {
      "id": 64,
      "start": 5083.94,
      "end": 5085.94,
      "formatted_start": "01:24:43.940",
      "formatted_end": "01:24:45.940",
      "text": "پیروز نافرست ننوشته بودن؟"
    },
    {
      "id": 65,
      "start": 5085.94,
      "end": 5087.94,
      "formatted_start": "01:24:45.940",
      "formatted_end": "01:24:47.940",
      "text": "دوتا برق نوشته بودی"
    },
    {
      "id": 66,
      "start": 5087.94,
      "end": 5089.94,
      "formatted_start": "01:24:47.940",
      "formatted_end": "01:24:49.940",
      "text": "آره بیشتر نمیدن"
    },
    {
      "id": 67,
      "start": 5089.94,
      "end": 5092.94,
      "formatted_start": "01:24:49.940",
      "formatted_end": "01:24:52.940",
      "text": "بکنم اگر پیروز نوشتم ندن"
    },
    {
      "id": 68,
      "start": 5092.94,
      "end": 5094.94,
      "formatted_start": "01:24:52.940",
      "formatted_end": "01:24:54.940",
      "text": "الان چی گفتی؟ قرص مده؟"
    },
    {
      "id": 69,
      "start": 5094.94,
      "end": 5096.94,
      "formatted_start": "01:24:54.940",
      "formatted_end": "01:24:56.940",
      "text": "نه قرص مده دارم"
    },
    {
      "id": 70,
      "start": 5096.94,
      "end": 5098.94,
      "formatted_start": "01:24:56.940",
      "formatted_end": "01:24:58.940",
      "text": "بیشتر کنیم بیشتر کنیم"
    },
    {
      "id": 71,
      "start": 5098.94,
      "end": 5100.94,
      "formatted_start": "01:24:58.940",
      "formatted_end": "01:25:00.940",
      "text": "خوش میخوایی شیعان"
    }
  ],
  "status": "completed"
}