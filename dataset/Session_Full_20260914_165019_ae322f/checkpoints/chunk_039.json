  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11730.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:30.000",
      "text": "این بازی باقی بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بی"
    },
    {
      "id": 1,
      "start": 11730.0,
      "end": 11731.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:31.000",
      "text": "باید میگرد..."
    },
    {
      "id": 2,
      "start": 11731.0,
      "end": 11732.0,
      "formatted_start": "03:15:31.000",
      "formatted_end": "03:15:32.000",
      "text": "بانی کریمی"
    },
    {
      "id": 3,
      "start": 11732.0,
      "end": 11733.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:33.000",
      "text": "بانی کریمی"
    },
    {
      "id": 4,
      "start": 11733.0,
      "end": 11736.0,
      "formatted_start": "03:15:33.000",
      "formatted_end": "03:15:36.000",
      "text": "باید شد که اونجا بگی یه مرتبه در روز بزن"
    },
    {
      "id": 5,
      "start": 11747.0,
      "end": 11749.0,
      "formatted_start": "03:15:47.000",
      "formatted_end": "03:15:49.000",
      "text": "بعد کپ پاش در میگرد"
    },
    {
      "id": 6,
      "start": 11749.0,
      "end": 11752.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:52.000",
      "text": "بعد من گفتم بزنیم یه آدماش بگیریم ببینیم چیزیه"
    },
    {
      "id": 7,
      "start": 11752.0,
      "end": 11754.0,
      "formatted_start": "03:15:52.000",
      "formatted_end": "03:15:54.000",
      "text": "یه موقعی مثلا از انگوشت نباشه"
    },
    {
      "id": 8,
      "start": 11754.0,
      "end": 11757.0,
      "formatted_start": "03:15:54.000",
      "formatted_end": "03:15:57.000",
      "text": "مثلا مال نقرست نباشه"
    },
    {
      "id": 9,
      "start": 11757.0,
      "end": 11759.0,
      "formatted_start": "03:15:57.000",
      "formatted_end": "03:15:59.000",
      "text": "نباشه درده"
    },
    {
      "id": 10,
      "start": 11787.0,
      "end": 11789.0,
      "formatted_start": "03:16:27.000",
      "formatted_end": "03:16:29.000",
      "text": "بسیاری نکرده ندارم"
    },
    {
      "id": 11,
      "start": 11791.0,
      "end": 11793.0,
      "formatted_start": "03:16:31.000",
      "formatted_end": "03:16:33.000",
      "text": "میشه که پندیشون رو بگو"
    },
    {
      "id": 12,
      "start": 11797.0,
      "end": 11799.0,
      "formatted_start": "03:16:37.000",
      "formatted_end": "03:16:39.000",
      "text": "میشه برس بگو"
    },
    {
      "id": 13,
      "start": 11799.0,
      "end": 11801.0,
      "formatted_start": "03:16:39.000",
      "formatted_end": "03:16:41.000",
      "text": "برشون دیگه"
    },
    {
      "id": 14,
      "start": 11801.0,
      "end": 11803.0,
      "formatted_start": "03:16:41.000",
      "formatted_end": "03:16:43.000",
      "text": "برشون"
    },
    {
      "id": 15,
      "start": 11803.0,
      "end": 11805.0,
      "formatted_start": "03:16:43.000",
      "formatted_end": "03:16:45.000",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 11805.0,
      "end": 11807.0,
      "formatted_start": "03:16:45.000",
      "formatted_end": "03:16:47.000",
      "text": "حقیقتشو بگم"
    },
    {
      "id": 17,
      "start": 11807.0,
      "end": 11809.0,
      "formatted_start": "03:16:47.000",
      "formatted_end": "03:16:49.000",
      "text": "اصلا اگه من بودم"
    },
    {
      "id": 18,
      "start": 11809.0,
      "end": 11811.0,
      "formatted_start": "03:16:49.000",
      "formatted_end": "03:16:51.000",
      "text": "توضیح من کردم"
    },
    {
      "id": 19,
      "start": 11811.0,
      "end": 11813.0,
      "formatted_start": "03:16:51.000",
      "formatted_end": "03:16:53.000",
      "text": "اصلا بگم بلی من اگه بودم"
    },
    {
      "id": 20,
      "start": 11813.0,
      "end": 11815.0,
      "formatted_start": "03:16:53.000",
      "formatted_end": "03:16:55.000",
      "text": "میخواهم من افتاده ساله باید برم"
    },
    {
      "id": 21,
      "start": 11815.0,
      "end": 11818.0,
      "formatted_start": "03:16:55.000",
      "formatted_end": "03:16:58.000",
      "text": "نمیدونم این انسلونش رو دقیقا میمونی کردن"
    },
    {
      "id": 22,
      "start": 11818.0,
      "end": 11820.0,
      "formatted_start": "03:16:58.000",
      "formatted_end": "03:17:00.000",
      "text": "دقیقا؟"
    },
    {
      "id": 23,
      "start": 11820.0,
      "end": 11822.0,
      "formatted_start": "03:17:00.000",
      "formatted_end": "03:17:02.000",
      "text": "نه زیاد"
    },
    {
      "id": 24,
      "start": 11822.0,
      "end": 11825.0,
      "formatted_start": "03:17:02.000",
      "formatted_end": "03:17:05.000",
      "text": "اگه حکم داره که قرص بخورد"
    },
    {
      "id": 25,
      "start": 11825.0,
      "end": 11830.0,
      "formatted_start": "03:17:05.000",
      "formatted_end": "03:17:10.000",
      "text": "یه مدر قرص هم خورد برای این ایوانسیش که مثلا بالا میره"
    },
    {
      "id": 26,
      "start": 11830.0,
      "end": 11834.0,
      "formatted_start": "03:17:10.000",
      "formatted_end": "03:17:14.000",
      "text": "یه مدر قرص بین چیزها داده بود اون خیلی بجور بود"
    },
    {
      "id": 27,
      "start": 11834.0,
      "end": 11836.0,
      "formatted_start": "03:17:14.000",
      "formatted_end": "03:17:16.000",
      "text": "یعنی افتقال شدید بهش میداد"
    },
    {
      "id": 28,
      "start": 11836.0,
      "end": 11837.0,
      "formatted_start": "03:17:16.000",
      "formatted_end": "03:17:17.000",
      "text": "کلیک لازم بود"
    },
    {
      "id": 29,
      "start": 11837.0,
      "end": 11842.0,
      "formatted_start": "03:17:17.000",
      "formatted_end": "03:17:22.000",
      "text": "آره وقتا این گویی یه دونه زور میخورد انسلون یکی صبح میدهد یکی شب میدهد"
    },
    {
      "id": 30,
      "start": 11842.0,
      "end": 11845.2,
      "formatted_start": "03:17:22.000",
      "formatted_end": "03:17:25.200",
      "text": "اون بخاطر این گفت که گرسه رو نزدیک کنیم"
    },
    {
      "id": 31,
      "start": 11845.2,
      "end": 11849.9,
      "formatted_start": "03:17:25.200",
      "formatted_end": "03:17:29.900",
      "text": "میگم این انسولین ها ناسازگار با همه انسولین ها دیگه"
    },
    {
      "id": 32,
      "start": 11849.9,
      "end": 11852.06,
      "formatted_start": "03:17:29.900",
      "formatted_end": "03:17:32.060",
      "text": "با داروها با همه چی کن"
    },
    {
      "id": 33,
      "start": 11852.06,
      "end": 11854.2,
      "formatted_start": "03:17:32.060",
      "formatted_end": "03:17:34.200",
      "text": "اصلا میکس دیگه کسی نمیدونه"
    },
    {
      "id": 34,
      "start": 11854.2,
      "end": 11856.34,
      "formatted_start": "03:17:34.200",
      "formatted_end": "03:17:36.340",
      "text": "اینه چی بگیم ناسشت یادن تونیم"
    },
    {
      "id": 35,
      "start": 11856.34,
      "end": 11859.1,
      "formatted_start": "03:17:36.340",
      "formatted_end": "03:17:39.100",
      "text": "ولی شما چون مریض قدیمیم بهتون بگم رای زده اینکه"
    },
    {
      "id": 36,
      "start": 11859.1,
      "end": 11861.0,
      "formatted_start": "03:17:39.100",
      "formatted_end": "03:17:41.000",
      "text": "سر برامت پیش ما که نسخه کنیم"
    },
    {
      "id": 37,
      "start": 11861.0,
      "end": 11863.3,
      "formatted_start": "03:17:41.000",
      "formatted_end": "03:17:43.300",
      "text": "چون والد کردن ایشکی نمیخورد"
    },
    {
      "id": 38,
      "start": 11863.3,
      "end": 11866.7,
      "formatted_start": "03:17:43.300",
      "formatted_end": "03:17:46.700",
      "text": "من اصلا اجباره بکنم نسخه کنیم"
    },
    {
      "id": 39,
      "start": 11866.7,
      "end": 11871.7,
      "formatted_start": "03:17:46.700",
      "formatted_end": "03:17:51.700",
      "text": "همون ها هست که از اون چیزی که ما میخواییم نیست مجبوریم برین اینو بگیریم"
    },
    {
      "id": 40,
      "start": 11871.7,
      "end": 11876.7,
      "formatted_start": "03:17:51.700",
      "formatted_end": "03:17:56.700",
      "text": "من خودم اصلاً برای کسی، این سر برومدن اینجا قابل نکردن برای کسی برنیستم"
    },
    {
      "id": 41,
      "start": 11876.7,
      "end": 11881.7,
      "formatted_start": "03:17:56.700",
      "formatted_end": "03:18:01.700",
      "text": "چیزی که وارد ایران کردم میخوام به زود تاثیر باشید"
    },
    {
      "id": 42,
      "start": 11881.7,
      "end": 11885.7,
      "formatted_start": "03:18:01.700",
      "formatted_end": "03:18:05.700",
      "text": "اگر نه این داستان ما همونه، حالا دوتا کارشون میتونن بکنه"
    },
    {
      "id": 43,
      "start": 11885.7,
      "end": 11892.7,
      "formatted_start": "03:18:05.700",
      "formatted_end": "03:18:12.700",
      "text": "میتونی یک قلم لانتوس شوید. مثلا تبدیل کنید به لانتوس بود. طولانی از سرشو نگهد دارید."
    },
    {
      "id": 44,
      "start": 11892.7,
      "end": 11899.7,
      "formatted_start": "03:18:12.700",
      "formatted_end": "03:18:19.700",
      "text": "ترکیب این قسمت کتا از سرشو بردارید. این کتا از سرشو با قرص بیارید پایین."
    },
    {
      "id": 45,
      "start": 11899.7,
      "end": 11903.7,
      "formatted_start": "03:18:19.700",
      "formatted_end": "03:18:23.700",
      "text": "نه دسته گلی کلاسی دارید او. چون این دسته گلی کلاسی نیست."
    },
    {
      "id": 46,
      "start": 11903.7,
      "end": 11908.7,
      "formatted_start": "03:18:23.700",
      "formatted_end": "03:18:28.700",
      "text": "تو این سرنابی خطرناکه. همراه دفت و قرن میرن. از اون میکس دار بیارید."
    },
    {
      "id": 47,
      "start": 11908.7,
      "end": 11921.7,
      "formatted_start": "03:18:28.700",
      "formatted_end": "03:18:41.700",
      "text": "اگر باید یک کار را تصویر کنید، اما اگر باید یک بار در روز تصویر کنید، اما اینکه ایرانگی را در این موضوع خود را درسید."
    },
    {
      "id": 48,
      "start": 11921.7,
      "end": 11924.7,
      "formatted_start": "03:18:41.700",
      "formatted_end": "03:18:44.700",
      "text": "اما این داده ها همچنان اونجا را برداشت می بود و از این موضوع را می شود."
    },
    {
      "id": 49,
      "start": 11924.7,
      "end": 11928.7,
      "formatted_start": "03:18:44.700",
      "formatted_end": "03:18:48.700",
      "text": "اگر هر چیزی که به دکتر می گوید، از این موضوع نکنید."
    },
    {
      "id": 50,
      "start": 11928.7,
      "end": 11932.7,
      "formatted_start": "03:18:48.700",
      "formatted_end": "03:18:52.700",
      "text": "این حالت یا همچنان بیتوجهی هست؟"
    },
    {
      "id": 51,
      "start": 11932.7,
      "end": 11933.7,
      "formatted_start": "03:18:52.700",
      "formatted_end": "03:18:53.700",
      "text": "این حالتی ایشه؟"
    },
    {
      "id": 52,
      "start": 11933.7,
      "end": 11939.7,
      "formatted_start": "03:18:53.700",
      "formatted_end": "03:18:59.700",
      "text": "نه اخوه مریض جوان این مثلا 7 تا 8 ساله که قرار نیست حجمان مریض در دور از جنش در مریض باشه"
    },
    {
      "id": 53,
      "start": 11939.7,
      "end": 11943.7,
      "formatted_start": "03:18:59.700",
      "formatted_end": "03:19:03.700",
      "text": "این دیده اینجوری نیست که بگیم عذیبتش نکن چرا با این مریض سرحان خوب باشه؟"
    },
    {
      "id": 54,
      "start": 11943.7,
      "end": 11944.7,
      "formatted_start": "03:19:03.700",
      "formatted_end": "03:19:04.700",
      "text": "سرساز زندگی کنی؟"
    },
    {
      "id": 55,
      "start": 11944.7,
      "end": 11951.7,
      "formatted_start": "03:19:04.700",
      "formatted_end": "03:19:11.700",
      "text": "نه اصلا اون که سرحان هست فقط تنهاچیدش یکی رومانسی چیزه این آرتروز شدید اوزانو داره"
    },
    {
      "id": 56,
      "start": 11951.7,
      "end": 11954.7,
      "formatted_start": "03:19:11.700",
      "formatted_end": "03:19:14.700",
      "text": "حتی مشکلش اینه هیچ مشکل دیگه ای نداره فیلن"
    },
    {
      "id": 57,
      "start": 11954.7,
      "end": 11961.7,
      "formatted_start": "03:19:14.700",
      "formatted_end": "03:19:21.700",
      "text": "اگر راضی میشن، انسولینشون رو عوض کن"
    },
    {
      "id": 58,
      "start": 11961.7,
      "end": 11968.7,
      "formatted_start": "03:19:21.700",
      "formatted_end": "03:19:28.700",
      "text": "حقیقتش از نظر علمی، از نظر کتابی هست"
    },
    {
      "id": 59,
      "start": 11968.7,
      "end": 11972.7,
      "formatted_start": "03:19:28.700",
      "formatted_end": "03:19:32.700",
      "text": "انسولین رو مکس دادن، اصلا بالای 70 سال مهمه هست"
    },
    {
      "id": 60,
      "start": 11972.7,
      "end": 11975.7,
      "formatted_start": "03:19:32.700",
      "formatted_end": "03:19:35.700",
      "text": "این کار خیلی غیر علمی هست"
    },
    {
      "id": 61,
      "start": 11975.7,
      "end": 11978.7,
      "formatted_start": "03:19:35.700",
      "formatted_end": "03:19:38.700",
      "text": "چون یا معریض قدرش بالاست، یا آفت میکنه"
    },
    {
      "id": 62,
      "start": 11978.7,
      "end": 11981.7,
      "formatted_start": "03:19:38.700",
      "formatted_end": "03:19:41.700",
      "text": "دو حالت بیشتر نداره، نمودارش این شکله"
    },
    {
      "id": 63,
      "start": 11981.7,
      "end": 11984.02,
      "formatted_start": "03:19:41.700",
      "formatted_end": "03:19:44.020",
      "text": "که هیچ وقتی آدم اینجوری راه نمیره"
    },
    {
      "id": 64,
      "start": 11984.02,
      "end": 11984.9,
      "formatted_start": "03:19:44.020",
      "formatted_end": "03:19:44.900",
      "text": "داستانشه"
    },
    {
      "id": 65,
      "start": 11984.9,
      "end": 11989.58,
      "formatted_start": "03:19:44.900",
      "formatted_end": "03:19:49.580",
      "text": "خواستن که بعد دیگه دفت بوده نم شده"
    },
    {
      "id": 66,
      "start": 11989.58,
      "end": 11997.58,
      "formatted_start": "03:19:49.580",
      "formatted_end": "03:19:57.580",
      "text": "کاری که میشه کرد مثلا به خاطر این که"
    }
  ],
  "status": "completed"
}