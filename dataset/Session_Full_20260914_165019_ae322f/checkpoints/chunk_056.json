  "stt_segments": [
    {
      "id": 0,
      "start": 16800.0,
      "end": 16829.98,
      "formatted_start": "04:40:00.000",
      "formatted_end": "04:40:29.980",
      "text": "از اینجا، بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 16830.0,
      "end": 16832.0,
      "formatted_start": "04:40:30.000",
      "formatted_end": "04:40:32.000",
      "text": "بیا بیتون"
    },
    {
      "id": 2,
      "start": 16840.0,
      "end": 16843.0,
      "formatted_start": "04:40:40.000",
      "formatted_end": "04:40:43.000",
      "text": "همدو تو برای آقای نوروزه خورس آهنگ نوشتی؟"
    },
    {
      "id": 3,
      "start": 16843.0,
      "end": 16845.0,
      "formatted_start": "04:40:43.000",
      "formatted_end": "04:40:45.000",
      "text": "آهنگ ایرانی"
    },
    {
      "id": 4,
      "start": 16845.0,
      "end": 16847.0,
      "formatted_start": "04:40:45.000",
      "formatted_end": "04:40:47.000",
      "text": "آهنگ ایرانی بهش ندادن"
    },
    {
      "id": 5,
      "start": 16847.0,
      "end": 16850.0,
      "formatted_start": "04:40:47.000",
      "formatted_end": "04:40:50.000",
      "text": "اصلا نه نوشتی، گفت نه نوشت ببین"
    },
    {
      "id": 6,
      "start": 16850.0,
      "end": 16852.0,
      "formatted_start": "04:40:50.000",
      "formatted_end": "04:40:52.000",
      "text": "این تمامی دسته هست"
    },
    {
      "id": 7,
      "start": 16852.0,
      "end": 16854.0,
      "formatted_start": "04:40:52.000",
      "formatted_end": "04:40:54.000",
      "text": "ببین گشت گفتم گفت نه نه نست ببین"
    },
    {
      "id": 8,
      "start": 16854.0,
      "end": 16856.0,
      "formatted_start": "04:40:54.000",
      "formatted_end": "04:40:56.000",
      "text": "شاید بجشت ببین"
    },
    {
      "id": 9,
      "start": 16856.0,
      "end": 16858.0,
      "formatted_start": "04:40:56.000",
      "formatted_end": "04:40:58.000",
      "text": "بیوگل صبح چه؟"
    },
    {
      "id": 10,
      "start": 16858.0,
      "end": 16888.0,
      "formatted_start": "04:40:58.000",
      "formatted_end": "04:41:28.000",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم ک"
    },
    {
      "id": 11,
      "start": 16888.0,
      "end": 16890.0,
      "formatted_start": "04:41:28.000",
      "formatted_end": "04:41:30.000",
      "text": "از این زنده که برده بود"
    },
    {
      "id": 12,
      "start": 16890.0,
      "end": 16892.0,
      "formatted_start": "04:41:30.000",
      "formatted_end": "04:41:32.000",
      "text": "خب باش بگو پس این چی نمیدونه"
    },
    {
      "id": 13,
      "start": 16892.0,
      "end": 16894.0,
      "formatted_start": "04:41:32.000",
      "formatted_end": "04:41:34.000",
      "text": "یعنی چی کارا میکنه با درخونه بکنه"
    },
    {
      "id": 14,
      "start": 16894.0,
      "end": 16896.0,
      "formatted_start": "04:41:34.000",
      "formatted_end": "04:41:36.000",
      "text": "ببخشه"
    },
    {
      "id": 15,
      "start": 16896.0,
      "end": 16898.0,
      "formatted_start": "04:41:36.000",
      "formatted_end": "04:41:38.000",
      "text": "بخشه بیرون چیزی"
    },
    {
      "id": 16,
      "start": 16898.0,
      "end": 16900.0,
      "formatted_start": "04:41:38.000",
      "formatted_end": "04:41:40.000",
      "text": "سی تاپرام درخونه بگیر"
    },
    {
      "id": 17,
      "start": 16902.0,
      "end": 16904.0,
      "formatted_start": "04:41:42.000",
      "formatted_end": "04:41:44.000",
      "text": "الان به من چیز"
    },
    {
      "id": 18,
      "start": 16904.0,
      "end": 16906.0,
      "formatted_start": "04:41:44.000",
      "formatted_end": "04:41:46.000",
      "text": "آزاد دیده"
    },
    {
      "id": 19,
      "start": 16906.0,
      "end": 16908.0,
      "formatted_start": "04:41:46.000",
      "formatted_end": "04:41:48.000",
      "text": "همین این تیره هست"
    },
    {
      "id": 20,
      "start": 16908.0,
      "end": 16910.0,
      "formatted_start": "04:41:48.000",
      "formatted_end": "04:41:50.000",
      "text": "دیده وزدار"
    },
    {
      "id": 21,
      "start": 16910.0,
      "end": 16912.0,
      "formatted_start": "04:41:50.000",
      "formatted_end": "04:41:52.000",
      "text": "اونو خوره که نفت باشه"
    },
    {
      "id": 22,
      "start": 16912.0,
      "end": 16914.0,
      "formatted_start": "04:41:52.000",
      "formatted_end": "04:41:54.000",
      "text": "خوره هست"
    },
    {
      "id": 23,
      "start": 16914.0,
      "end": 16916.0,
      "formatted_start": "04:41:54.000",
      "formatted_end": "04:41:56.000",
      "text": "باباش بگو که"
    },
    {
      "id": 24,
      "start": 16916.0,
      "end": 16919.0,
      "formatted_start": "04:41:56.000",
      "formatted_end": "04:41:59.000",
      "text": "این نقاشی هفت نمیشته که به من تحفیل هم داده"
    },
    {
      "id": 25,
      "start": 16919.0,
      "end": 16920.0,
      "formatted_start": "04:41:59.000",
      "formatted_end": "04:42:00.000",
      "text": "چیه؟"
    },
    {
      "id": 26,
      "start": 16920.0,
      "end": 16923.0,
      "formatted_start": "04:42:00.000",
      "formatted_end": "04:42:03.000",
      "text": "خورس آهنفر، سلفات، بگو این فسکو"
    },
    {
      "id": 27,
      "start": 16923.0,
      "end": 16925.0,
      "formatted_start": "04:42:03.000",
      "formatted_end": "04:42:05.000",
      "text": "نمیشته تحفیل هم داده، کشت میکنه"
    },
    {
      "id": 28,
      "start": 16925.0,
      "end": 16926.0,
      "formatted_start": "04:42:05.000",
      "formatted_end": "04:42:06.000",
      "text": "چون ما بیمه هاون اینها میده ها؟"
    },
    {
      "id": 29,
      "start": 16926.0,
      "end": 16928.0,
      "formatted_start": "04:42:06.000",
      "formatted_end": "04:42:08.000",
      "text": "نه، این اصلا بیمه هست"
    },
    {
      "id": 30,
      "start": 16928.0,
      "end": 16929.0,
      "formatted_start": "04:42:08.000",
      "formatted_end": "04:42:09.000",
      "text": "آره"
    },
    {
      "id": 31,
      "start": 16929.0,
      "end": 16932.0,
      "formatted_start": "04:42:09.000",
      "formatted_end": "04:42:12.000",
      "text": "چون از این بیمه میخوره دیگه بلند"
    },
    {
      "id": 32,
      "start": 16932.0,
      "end": 16935.0,
      "formatted_start": "04:42:12.000",
      "formatted_end": "04:42:15.000",
      "text": "ببخشه، خورس آهنفر شاید اینو داره"
    },
    {
      "id": 33,
      "start": 16935.0,
      "end": 16936.0,
      "formatted_start": "04:42:15.000",
      "formatted_end": "04:42:16.000",
      "text": "آهان داره؟"
    },
    {
      "id": 34,
      "start": 16936.0,
      "end": 16937.0,
      "formatted_start": "04:42:16.000",
      "formatted_end": "04:42:17.000",
      "text": "داشته شده"
    },
    {
      "id": 35,
      "start": 16937.0,
      "end": 16939.0,
      "formatted_start": "04:42:17.000",
      "formatted_end": "04:42:19.000",
      "text": "حالا اینو میخوره داره؟"
    },
    {
      "id": 36,
      "start": 16939.0,
      "end": 16942.0,
      "formatted_start": "04:42:19.000",
      "formatted_end": "04:42:22.000",
      "text": "تا شفع داراشو بدون بیدار میشه دیوه؟"
    },
    {
      "id": 37,
      "start": 16942.0,
      "end": 16945.0,
      "formatted_start": "04:42:22.000",
      "formatted_end": "04:42:25.000",
      "text": "دیوه گار صدیچه، خونه چکنه"
    },
    {
      "id": 38,
      "start": 16945.0,
      "end": 16949.0,
      "formatted_start": "04:42:25.000",
      "formatted_end": "04:42:29.000",
      "text": "بیدار آزدن، خونس آهنگ تبیر نداده"
    },
    {
      "id": 39,
      "start": 16949.0,
      "end": 16953.0,
      "formatted_start": "04:42:29.000",
      "formatted_end": "04:42:33.000",
      "text": "بیتامین درسه، سیپو فارکسرسی، بیتامین ازارت بیت"
    },
    {
      "id": 40,
      "start": 16953.0,
      "end": 16955.0,
      "formatted_start": "04:42:33.000",
      "formatted_end": "04:42:35.000",
      "text": "همه چیزی داره داره بگو بهتون بهتبیر داره"
    },
    {
      "id": 41,
      "start": 16955.0,
      "end": 16958.0,
      "formatted_start": "04:42:35.000",
      "formatted_end": "04:42:38.000",
      "text": "بگو به من، من تیک زدی که به من دادی"
    },
    {
      "id": 42,
      "start": 16958.0,
      "end": 16963.0,
      "formatted_start": "04:42:38.000",
      "formatted_end": "04:42:43.000",
      "text": "بگو اونهایی گو، اونهایی چک کن، ازش همه بیتبیر نداره"
    },
    {
      "id": 43,
      "start": 16965.0,
      "end": 16968.0,
      "formatted_start": "04:42:45.000",
      "formatted_end": "04:42:48.000",
      "text": "خب دخترم پس آهنگ دادی"
    },
    {
      "id": 44,
      "start": 16969.0,
      "end": 16976.7,
      "formatted_start": "04:42:49.000",
      "formatted_end": "04:42:56.700",
      "text": "یکی امپول که برای دو تا خوش کنه باشم، یکی رو در امروز تو سلام دازم، یکی رو فردا چیز کن"
    },
    {
      "id": 45,
      "start": 16976.7,
      "end": 16978.7,
      "formatted_start": "04:42:56.700",
      "formatted_end": "04:42:58.700",
      "text": "از آن رو بزن باشه"
    },
    {
      "id": 46,
      "start": 16982.7,
      "end": 16984.7,
      "formatted_start": "04:43:02.700",
      "formatted_end": "04:43:04.700",
      "text": "بچه تو شیر میده؟"
    },
    {
      "id": 47,
      "start": 16984.7,
      "end": 16986.7,
      "formatted_start": "04:43:04.700",
      "formatted_end": "04:43:06.700",
      "text": "آره، اول دقیقه آخر رو شکر میدیم"
    },
    {
      "id": 48,
      "start": 16986.7,
      "end": 16988.7,
      "formatted_start": "04:43:06.700",
      "formatted_end": "04:43:08.700",
      "text": "چند هفته شیر؟"
    },
    {
      "id": 49,
      "start": 16988.7,
      "end": 16990.7,
      "formatted_start": "04:43:08.700",
      "formatted_end": "04:43:10.700",
      "text": "بیار دستونه شیر برم، برم"
    },
    {
      "id": 50,
      "start": 16990.7,
      "end": 16991.7,
      "formatted_start": "04:43:10.700",
      "formatted_end": "04:43:11.700",
      "text": "بابایت جو میشه؟"
    },
    {
      "id": 51,
      "start": 16991.7,
      "end": 16992.7,
      "formatted_start": "04:43:11.700",
      "formatted_end": "04:43:12.700",
      "text": "بابایت جو رو رفته"
    },
    {
      "id": 52,
      "start": 16992.7,
      "end": 16993.7,
      "formatted_start": "04:43:12.700",
      "formatted_end": "04:43:13.700",
      "text": "همه دو درم؟"
    },
    {
      "id": 53,
      "start": 16993.7,
      "end": 16995.7,
      "formatted_start": "04:43:13.700",
      "formatted_end": "04:43:15.700",
      "text": "همه دو درم، دو سال میشه"
    },
    {
      "id": 54,
      "start": 16996.7,
      "end": 16997.7,
      "formatted_start": "04:43:16.700",
      "formatted_end": "04:43:17.700",
      "text": "شهر داری؟"
    },
    {
      "id": 55,
      "start": 16997.7,
      "end": 16999.7,
      "formatted_start": "04:43:17.700",
      "formatted_end": "04:43:19.700",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 56,
      "start": 16999.7,
      "end": 17001.7,
      "formatted_start": "04:43:19.700",
      "formatted_end": "04:43:21.700",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 57,
      "start": 17001.7,
      "end": 17003.7,
      "formatted_start": "04:43:21.700",
      "formatted_end": "04:43:23.700",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 58,
      "start": 17003.7,
      "end": 17005.7,
      "formatted_start": "04:43:23.700",
      "formatted_end": "04:43:25.700",
