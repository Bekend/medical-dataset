  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7230.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:30.000",
      "text": "بیمار نداشته باشه، با اینکه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه نداشته باشه، بقیه ن"
    },
    {
      "id": 1,
      "start": 7230.0,
      "end": 7234.22,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:34.220",
      "text": "یک قطعه به تامتاسون برزه اگه درد نمی کنه یا نه"
    },
    {
      "id": 2,
      "start": 7234.22,
      "end": 7236.02,
      "formatted_start": "02:00:34.220",
      "formatted_end": "02:00:36.020",
      "text": "اگه درد نداره خوب؟"
    },
    {
      "id": 3,
      "start": 7236.02,
      "end": 7240.28,
      "formatted_start": "02:00:36.020",
      "formatted_end": "02:00:40.280",
      "text": "اگه درد شدید نداره بیاد یک قطعه به تامتاسون کلانفرین کن بزنه"
    },
    {
      "id": 4,
      "start": 7240.28,
      "end": 7243.96,
      "formatted_start": "02:00:40.280",
      "formatted_end": "02:00:43.960",
      "text": "اما اگر که درد شدید باشه یه تالیه دید داشته باشه"
    },
    {
      "id": 5,
      "start": 7243.96,
      "end": 7245.36,
      "formatted_start": "02:00:43.960",
      "formatted_end": "02:00:45.360",
      "text": "بعد به چشم بزنش کنیم"
    },
    {
      "id": 6,
      "start": 7245.36,
      "end": 7247.12,
      "formatted_start": "02:00:45.360",
      "formatted_end": "02:00:47.120",
      "text": "سلام"
    },
    {
      "id": 7,
      "start": 7247.12,
      "end": 7254.42,
      "formatted_start": "02:00:47.120",
      "formatted_end": "02:00:54.420",
      "text": "مامان خانم یه درد ها داره؟"
    },
    {
      "id": 8,
      "start": 7254.42,
      "end": 7254.72,
      "formatted_start": "02:00:54.420",
      "formatted_end": "02:00:54.720",
      "text": "نه"
    },
    {
      "id": 9,
      "start": 7254.72,
      "end": 7256.72,
      "formatted_start": "02:00:54.720",
      "formatted_end": "02:00:56.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 10,
      "start": 7256.72,
      "end": 7258.72,
      "formatted_start": "02:00:56.720",
      "formatted_end": "02:00:58.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 11,
      "start": 7258.72,
      "end": 7260.72,
      "formatted_start": "02:00:58.720",
      "formatted_end": "02:01:00.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 12,
      "start": 7260.72,
      "end": 7262.72,
      "formatted_start": "02:01:00.720",
      "formatted_end": "02:01:02.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 13,
      "start": 7262.72,
      "end": 7264.72,
      "formatted_start": "02:01:02.720",
      "formatted_end": "02:01:04.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 14,
      "start": 7264.72,
      "end": 7266.72,
      "formatted_start": "02:01:04.720",
      "formatted_end": "02:01:06.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 15,
      "start": 7266.72,
      "end": 7268.72,
      "formatted_start": "02:01:06.720",
      "formatted_end": "02:01:08.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 16,
      "start": 7268.72,
      "end": 7270.72,
      "formatted_start": "02:01:08.720",
      "formatted_end": "02:01:10.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 17,
      "start": 7270.72,
      "end": 7272.72,
      "formatted_start": "02:01:10.720",
      "formatted_end": "02:01:12.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 18,
      "start": 7272.72,
      "end": 7274.72,
      "formatted_start": "02:01:12.720",
      "formatted_end": "02:01:14.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 19,
      "start": 7274.72,
      "end": 7276.72,
      "formatted_start": "02:01:14.720",
      "formatted_end": "02:01:16.720",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 20,
      "start": 7276.72,
      "end": 7278.72,
      "formatted_start": "02:01:16.720",
      "formatted_end": "02:01:18.720",
      "text": "باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 21,
      "start": 7278.72,
      "end": 7280.72,
      "formatted_start": "02:01:18.720",
      "formatted_end": "02:01:20.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 22,
      "start": 7280.72,
      "end": 7282.72,
      "formatted_start": "02:01:20.720",
      "formatted_end": "02:01:22.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 23,
      "start": 7282.72,
      "end": 7284.72,
      "formatted_start": "02:01:22.720",
      "formatted_end": "02:01:24.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 24,
      "start": 7284.72,
      "end": 7286.72,
      "formatted_start": "02:01:24.720",
      "formatted_end": "02:01:26.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 25,
      "start": 7286.72,
      "end": 7288.72,
      "formatted_start": "02:01:26.720",
      "formatted_end": "02:01:28.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 26,
      "start": 7288.72,
      "end": 7290.72,
      "formatted_start": "02:01:28.720",
      "formatted_end": "02:01:30.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 27,
      "start": 7290.72,
      "end": 7292.72,
      "formatted_start": "02:01:30.720",
      "formatted_end": "02:01:32.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 28,
      "start": 7292.72,
      "end": 7294.72,
      "formatted_start": "02:01:32.720",
      "formatted_end": "02:01:34.720",
      "text": "باید برداریم که اینجا برداریم"
    },
    {
      "id": 29,
      "start": 7294.72,
      "end": 7297.72,
      "formatted_start": "02:01:34.720",
      "formatted_end": "02:01:37.720",
      "text": "برای اینکه از این حواس هم پرت می کنند."
    },
    {
      "id": 30,
      "start": 7297.72,
      "end": 7300.72,
      "formatted_start": "02:01:37.720",
      "formatted_end": "02:01:40.720",
      "text": "تو بیاییم تا این تکلیف شده من از همه بوده پت می کنم."
    },
    {
      "id": 31,
      "start": 7300.72,
      "end": 7302.72,
      "formatted_start": "02:01:40.720",
      "formatted_end": "02:01:42.720",
      "text": "چون من عجل ندارم و دیدارم."
    },
    {
      "id": 32,
      "start": 7302.72,
      "end": 7306.72,
      "formatted_start": "02:01:42.720",
      "formatted_end": "02:01:46.720",
      "text": "چون بعد از من حواسم پرت می شود و تمرکز هم کم می شود."
    },
    {
      "id": 33,
      "start": 7306.72,
      "end": 7309.72,
      "formatted_start": "02:01:46.720",
      "formatted_end": "02:01:49.720",
      "text": "برای این همه هیچی زیادی بدقتی نگاه می کنم."
    },
    {
      "id": 34,
      "start": 7316.72,
      "end": 7318.72,
      "formatted_start": "02:01:56.720",
      "formatted_end": "02:01:58.720",
      "text": "همگل چین جا؟"
    },
    {
      "id": 35,
      "start": 7319.72,
      "end": 7321.72,
      "formatted_start": "02:01:59.720",
      "formatted_end": "02:02:01.720",
      "text": "این دو پانورا دونی؟"
    },
    {
      "id": 36,
      "start": 7321.72,
      "end": 7322.72,
      "formatted_start": "02:02:01.720",
      "formatted_end": "02:02:02.720",
      "text": "هشت خانم؟"
    },
    {
      "id": 37,
      "start": 7322.72,
      "end": 7323.72,
      "formatted_start": "02:02:02.720",
      "formatted_end": "02:02:03.720",
      "text": "هشت باش"
    },
    {
      "id": 38,
      "start": 7323.72,
      "end": 7325.72,
      "formatted_start": "02:02:03.720",
      "formatted_end": "02:02:05.720",
      "text": "روزی یه بیار... هشت خانم"
    },
    {
      "id": 39,
      "start": 7325.72,
      "end": 7326.72,
      "formatted_start": "02:02:05.720",
      "formatted_end": "02:02:06.720",
      "text": "روزی یه دونه میخوری؟"
    },
    {
      "id": 40,
      "start": 7326.72,
      "end": 7327.72,
      "formatted_start": "02:02:06.720",
      "formatted_end": "02:02:07.720",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 7327.72,
      "end": 7328.72,
      "formatted_start": "02:02:07.720",
      "formatted_end": "02:02:08.720",
      "text": "بله"
    },
    {
      "id": 42,
      "start": 7328.72,
      "end": 7330.72,
      "formatted_start": "02:02:08.720",
      "formatted_end": "02:02:10.720",
      "text": "تا حالا روزی نصف یه دونه میخوردی؟"
    },
    {
      "id": 43,
      "start": 7330.72,
      "end": 7332.72,
      "formatted_start": "02:02:10.720",
      "formatted_end": "02:02:12.720",
      "text": "یه دونه صبح میخوری یه دونه شب"
    },
    {
      "id": 44,
      "start": 7332.72,
      "end": 7334.72,
      "formatted_start": "02:02:12.720",
      "formatted_end": "02:02:14.720",
      "text": "آه یه دونه صبح میخوری یه دونه شب؟"
    },
    {
      "id": 45,
      "start": 7334.72,
      "end": 7336.72,
      "formatted_start": "02:02:14.720",
      "formatted_end": "02:02:16.720",
      "text": "آه از این به بعد نصف صبح نصف شب بخوری"
    },
    {
      "id": 46,
      "start": 7336.72,
      "end": 7339.72,
      "formatted_start": "02:02:16.720",
      "formatted_end": "02:02:19.720",
      "text": "زیاد قلبتو خیلی ضربانشو انداخته"
    },
    {
      "id": 47,
      "start": 7339.72,
      "end": 7342.72,
      "formatted_start": "02:02:19.720",
      "formatted_end": "02:02:22.720",
      "text": "خب دیگه نصف صبح نصف شب بخوری باشه؟"
    },
    {
      "id": 48,
      "start": 7342.72,
      "end": 7343.72,
      "formatted_start": "02:02:22.720",
      "formatted_end": "02:02:23.720",
      "text": "باشه زخط درست باشه"
    },
    {
      "id": 49,
      "start": 7343.72,
      "end": 7345.72,
      "formatted_start": "02:02:23.720",
      "formatted_end": "02:02:25.720",
      "text": "خب، شما قند داریم؟"
    },
    {
      "id": 50,
      "start": 7345.72,
      "end": 7347.72,
      "formatted_start": "02:02:25.720",
      "formatted_end": "02:02:27.720",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 7347.72,
      "end": 7349.72,
      "formatted_start": "02:02:27.720",
      "formatted_end": "02:02:29.720",
      "text": "ماما بود و قند داریم"
    },
    {
      "id": 52,
      "start": 7349.72,
      "end": 7351.72,
      "formatted_start": "02:02:29.720",
      "formatted_end": "02:02:31.720",
      "text": "مادرم بوده به مورد درست داریم"
    },
    {
      "id": 53,
      "start": 7351.72,
      "end": 7353.72,
      "formatted_start": "02:02:31.720",
      "formatted_end": "02:02:33.720",
      "text": "رو همون چون کنم"
    },
    {
      "id": 54,
      "start": 7353.72,
      "end": 7355.72,
      "formatted_start": "02:02:33.720",
      "formatted_end": "02:02:35.720",
      "text": "شما مستعد قندید"
    },
    {
      "id": 55,
      "start": 7355.72,
      "end": 7357.72,
      "formatted_start": "02:02:35.720",
      "formatted_end": "02:02:37.720",
      "text": "قندتون بعضی وقتها بالا میزنن"
    },
    {
      "id": 56,
      "start": 7357.72,
      "end": 7359.72,
      "formatted_start": "02:02:37.720",
      "formatted_end": "02:02:39.720",
      "text": "آه"
    },
    {
      "id": 57,
      "start": 7359.72,
      "end": 7361.72,
      "formatted_start": "02:02:39.720",
      "formatted_end": "02:02:41.720",
      "text": "شش و نیمه سا مارد"
    },
    {
      "id": 58,
      "start": 7361.72,
      "end": 7363.72,
      "formatted_start": "02:02:41.720",
      "formatted_end": "02:02:43.720",
      "text": "یعنی قندتون یه وقتها از دویست رد میشه"
    },
    {
      "id": 59,
      "start": 7363.72,
      "end": 7365.72,
      "formatted_start": "02:02:43.720",
      "formatted_end": "02:02:45.720",
      "text": "آه"
    },
    {
      "id": 60,
      "start": 7365.72,
      "end": 7367.72,
      "formatted_start": "02:02:45.720",
      "formatted_end": "02:02:47.720",
      "text": "تا حالا قضای قند رایت میکردید یا نه؟"
    },
    {
      "id": 61,
      "start": 7367.72,
      "end": 7369.72,
      "formatted_start": "02:02:47.720",
      "formatted_end": "02:02:49.720",
      "text": "رایت نمیکردم"
    },
    {
      "id": 62,
      "start": 7369.72,
      "end": 7371.72,
      "formatted_start": "02:02:49.720",
      "formatted_end": "02:02:51.720",
      "text": "خب، پس اول رایت کنید سه ماه دیگه"
    },
    {
      "id": 63,
      "start": 7371.72,
      "end": 7374.72,
      "formatted_start": "02:02:51.720",
      "formatted_end": "02:02:54.720",
      "text": "اگه این بمونه بعد یک گرسه مرمی بخوری"
    },
    {
      "id": 64,
      "start": 7374.72,
      "end": 7381.72,
      "formatted_start": "02:02:54.720",
      "formatted_end": "02:03:01.720",
      "text": "چون اولین بار شیرینی، شکولات، اینا که دیگه بختن نداره"
    },
    {
      "id": 65,
      "start": 7381.72,
      "end": 7385.72,
      "formatted_start": "02:03:01.720",
      "formatted_end": "02:03:05.720",
      "text": "شیرینی، شکولات و دلستر، اینا ها که خب معلومه برده"
    },
    {
      "id": 66,
      "start": 7385.72,
      "end": 7397.72,
      "formatted_start": "02:03:05.720",
      "formatted_end": "02:03:17.720",
      "text": "هندوانه، خربازه، انگور، مز، مکارانی"
    },
    {
      "id": 67,
      "start": 7397.72,
      "end": 7400.72,
      "formatted_start": "02:03:17.720",
      "formatted_end": "02:03:20.720",
      "text": "انجیر یکی بخورید اپ نداره بیشتر نه"
    },
    {
      "id": 68,
      "start": 7400.72,
      "end": 7401.72,
      "formatted_start": "02:03:20.720",
      "formatted_end": "02:03:21.720",
      "text": "انجیر رو؟"
    },
    {
      "id": 69,
      "start": 7401.72,
      "end": 7405.72,
      "formatted_start": "02:03:21.720",
      "formatted_end": "02:03:25.720",
      "text": "آره، هندونه، خربازه، انگور، موز و مکانی اصلا نمیخورید"
    },
    {
      "id": 70,
      "start": 7405.72,
      "end": 7411.72,
      "formatted_start": "02:03:25.720",
      "formatted_end": "02:03:31.720",
      "text": "شیمی، شکولات، مشابه، دلستر، اثر، نمیدونم روبه، کندس، درمانی، اینها نداریم اتر"
    },
    {
      "id": 71,
      "start": 7411.72,
      "end": 7416.72,
      "formatted_start": "02:03:31.720",
      "formatted_end": "02:03:36.720",
      "text": "آبنبات قره بروتی، نمیدونم آبنبات ترش رژیمی، اینها همه علکیه"
    },
    {
      "id": 72,
      "start": 7416.72,
      "end": 7417.72,
      "formatted_start": "02:03:36.720",
      "formatted_end": "02:03:37.720",
      "text": "نمیخورید"
    },
    {
      "id": 73,
      "start": 7417.72,
      "end": 7421.72,
      "formatted_start": "02:03:37.720",
      "formatted_end": "02:03:41.720",
      "text": "چایی تو با چی میخورید عزیزم؟ با دو سه دونه کشمش میخورید"
    },
    {
      "id": 74,
      "start": 7427.72,
      "end": 7429.72,
      "formatted_start": "02:03:47.720",
      "formatted_end": "02:03:49.720",
      "text": "چون اینکه چار بخش می کنید"
    },
    {
      "id": 75,
      "start": 7429.72,
      "end": 7431.72,
      "formatted_start": "02:03:49.720",
      "formatted_end": "02:03:51.720",
      "text": "توت خوش کرد چقدر دوست دارید می توانید بخورید"
    },
    {
      "id": 76,
      "start": 7431.72,
      "end": 7433.72,
      "formatted_start": "02:03:51.720",
      "formatted_end": "02:03:53.720",
      "text": "انام می توانید بخورید"
    },
    {
      "id": 77,
      "start": 7433.72,
      "end": 7435.72,
      "formatted_start": "02:03:53.720",
      "formatted_end": "02:03:55.720",
      "text": "انجیر خوش"
    },
    {
      "id": 78,
      "start": 7435.72,
      "end": 7437.72,
      "formatted_start": "02:03:55.720",
      "formatted_end": "02:03:57.720",
      "text": "قندش بالا است عزیز"
    },
    {
      "id": 79,
      "start": 7437.72,
      "end": 7439.72,
      "formatted_start": "02:03:57.720",
      "formatted_end": "02:03:59.720",
      "text": "چون مگه یک چار بخشش کنید"
    },
    {
      "id": 80,
      "start": 7439.72,
      "end": 7441.72,
      "formatted_start": "02:03:59.720",
      "formatted_end": "02:04:01.720",
      "text": "یعنی یه دو نر نخورید"
    },
    {
      "id": 81,
      "start": 7441.72,
      "end": 7443.72,
      "formatted_start": "02:04:01.720",
      "formatted_end": "02:04:03.720",
      "text": "چی باسه تو مفیده؟"
    },
    {
      "id": 82,
      "start": 7443.72,
      "end": 7445.72,
      "formatted_start": "02:04:03.720",
      "formatted_end": "02:04:05.720",
      "text": "خوب گزنه هفته یک الان دوبار بخورید"
    },
    {
      "id": 83,
      "start": 7445.72,
      "end": 7447.72,
      "formatted_start": "02:04:05.720",
      "formatted_end": "02:04:07.720",
      "text": "بیشتر نه"
    },
    {
      "id": 84,
      "start": 7447.72,
      "end": 7449.72,
      "formatted_start": "02:04:07.720",
      "formatted_end": "02:04:09.720",
      "text": "گزنه همونید؟"
    },
    {
      "id": 85,
      "start": 7449.72,
      "end": 7451.72,
      "formatted_start": "02:04:09.720",
      "formatted_end": "02:04:11.720",
      "text": "بجوشونید"
    },
    {
      "id": 86,
      "start": 7451.72,
      "end": 7453.72,
      "formatted_start": "02:04:11.720",
      "formatted_end": "02:04:13.720",
      "text": "شمبلیره رو می توانید بجوشونید"
    },
    {
      "id": 87,
      "start": 7453.72,
      "end": 7455.72,
      "formatted_start": "02:04:13.720",
      "formatted_end": "02:04:15.720",
      "text": "هفته یک بار"
    },
    {
      "id": 88,
      "start": 7455.72,
      "end": 7459.72,
      "formatted_start": "02:04:15.720",
      "formatted_end": "02:04:19.720",
      "text": "این ها رو زیاد نباید استفاده کنیم چون باز به کپ داستیق میزنن"
    },
    {
      "id": 89,
      "start": 7459.72,
      "end": 7470.72,
      "formatted_start": "02:04:19.720",
      "formatted_end": "02:04:30.720",
      "text": "دارچین اگر حساسیت ندارید تو چای بخورید بامیه خیلی بخورید بامیه آبپزی و بامیه تو آبخیستون شب تو آبخیستون بذار"
    },
    {
      "id": 90,
      "start": 7470.72,
      "end": 7475.72,
      "formatted_start": "02:04:30.720",
      "formatted_end": "02:04:35.720",
      "text": "صبح اون یه ماهه نمزه چی داره یکم آب لیمون اینا بخورن هم بزن بخورید این ها غندتو میارد باید"
    },
    {
      "id": 91,
      "start": 7475.72,
      "end": 7481.72,
      "formatted_start": "02:04:35.720",
      "formatted_end": "02:04:41.720",
      "text": "پیاده روی کنید روز سی دقیقه پیاده روی تون بخورید این کار رو می کنید"
    },
    {
      "id": 92,
      "start": 7481.72,
      "end": 7486.72,
      "formatted_start": "02:04:41.720",
      "formatted_end": "02:04:46.720",
      "text": "دوباره همینجوری قند سه ماه هم چک میکنید یعنی قند مخفی"
    },
    {
      "id": 93,
      "start": 7486.72,
      "end": 7488.72,
      "formatted_start": "02:04:46.720",
      "formatted_end": "02:04:48.720",
      "text": "این آزمایش کامل بوده"
    },
    {
      "id": 94,
      "start": 7488.72,
      "end": 7489.72,
      "formatted_start": "02:04:48.720",
      "formatted_end": "02:04:49.720",
      "text": "باز بیان ونی ویسی کنید"
    },
    {
      "id": 95,
      "start": 7489.72,
      "end": 7491.72,
      "formatted_start": "02:04:49.720",
      "formatted_end": "02:04:51.720",
      "text": "بیان خودمون براتون ونی ویسی"
    },
    {
      "id": 96,
      "start": 7491.72,
      "end": 7494.72,
      "formatted_start": "02:04:51.720",
      "formatted_end": "02:04:54.720",
      "text": "اگر بادر بود دیگه بعد یه روزی یه تون خواست قند بخویید"
    },
    {
      "id": 97,
      "start": 7494.72,
      "end": 7497.72,
      "formatted_start": "02:04:54.720",
      "formatted_end": "02:04:57.720",
      "text": "و اگر نه قلبتون شروع میکنه و قلبات توی تنگ شدن"
    },
    {
      "id": 98,
      "start": 7497.72,
      "end": 7499.72,
      "formatted_start": "02:04:57.720",
      "formatted_end": "02:04:59.720",
      "text": "و چشماتون شروع میکنه"
    }
  ],
  "status": "completed"
}