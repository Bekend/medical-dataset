      "start": 16203.0,
      "end": 16206.0,
      "formatted_start": "04:30:03.000",
      "formatted_end": "04:30:06.000",
      "text": "ما فقط همین قیمت سر بخور روزای جمعه."
    },
    {
      "id": 2,
      "start": 16206.0,
      "end": 16210.0,
      "formatted_start": "04:30:06.000",
      "formatted_end": "04:30:10.000",
      "text": "پس روزای جمعه، یه رو نه. خب، اینم دوتا؟"
    },
    {
      "id": 3,
      "start": 16210.0,
      "end": 16211.0,
      "formatted_start": "04:30:10.000",
      "formatted_end": "04:30:11.000",
      "text": "چه یا؟"
    },
    {
      "id": 4,
      "start": 16211.0,
      "end": 16219.0,
      "formatted_start": "04:30:11.000",
      "formatted_end": "04:30:19.000",
      "text": "شب و روز، دوتا، اینم پیش از خدا، خودت گفتی، دوتا پیش از نهار بخورم، دوتا بخورم پیش از نهار."
    },
    {
      "id": 5,
      "start": 16219.0,
      "end": 16221.0,
      "formatted_start": "04:30:19.000",
      "formatted_end": "04:30:21.000",
      "text": "خب، خودت گفتی."
    },
    {
      "id": 6,
      "start": 16221.0,
      "end": 16223.0,
      "formatted_start": "04:30:21.000",
      "formatted_end": "04:30:23.000",
      "text": "رفعه دیگه بعد از شما زور بین کار میکنم."
    },
    {
      "id": 7,
      "start": 16223.0,
      "end": 16227.0,
      "formatted_start": "04:30:23.000",
      "formatted_end": "04:30:27.000",
      "text": "اینم روز دوتا مخورم، اکی شب، اکی روز"
    },
    {
      "id": 8,
      "start": 16227.0,
      "end": 16229.0,
      "formatted_start": "04:30:27.000",
      "formatted_end": "04:30:29.000",
      "text": "خب توی چی کار کنم؟ این همه دارم"
    },
    {
      "id": 9,
      "start": 16229.0,
      "end": 16232.0,
      "formatted_start": "04:30:29.000",
      "formatted_end": "04:30:32.000",
      "text": "اینم خب، اینو شب اکی مخورم"
    },
    {
      "id": 10,
      "start": 16232.0,
      "end": 16235.0,
      "formatted_start": "04:30:32.000",
      "formatted_end": "04:30:35.000",
      "text": "خب پس خودتو باید بکشید باید باید مرد"
    },
    {
      "id": 11,
      "start": 16235.0,
      "end": 16237.0,
      "formatted_start": "04:30:35.000",
      "formatted_end": "04:30:37.000",
      "text": "پس بس که هندونا اینو خورید"
    },
    {
      "id": 12,
      "start": 16237.0,
      "end": 16239.0,
      "formatted_start": "04:30:37.000",
      "formatted_end": "04:30:39.000",
      "text": "پس اینو بخورم"
    },
    {
      "id": 13,
      "start": 16239.0,
      "end": 16241.0,
      "formatted_start": "04:30:39.000",
      "formatted_end": "04:30:41.000",
      "text": "کاری نمیشه برای این"
    },
    {
      "id": 14,
      "start": 16241.0,
      "end": 16244.0,
      "formatted_start": "04:30:41.000",
      "formatted_end": "04:30:44.000",
      "text": "قندار، ارزان، شکل، قدید"
    },
    {
      "id": 15,
      "start": 16244.0,
      "end": 16247.0,
      "formatted_start": "04:30:44.000",
      "formatted_end": "04:30:47.000",
      "text": "اینو شو بیست و پنج میکنم دوتا دیگه نخوری خب؟"
    },
    {
      "id": 16,
      "start": 16247.0,
      "end": 16250.0,
      "formatted_start": "04:30:47.000",
      "formatted_end": "04:30:50.000",
      "text": "دارم عزیز، یادخان بذارم بخشنیم"
    },
    {
      "id": 17,
      "start": 16250.0,
      "end": 16252.0,
      "formatted_start": "04:30:50.000",
      "formatted_end": "04:30:52.000",
      "text": "اگه داری پس دوتا دوتا بخورم"
    },
    {
      "id": 18,
      "start": 16252.0,
      "end": 16254.0,
      "formatted_start": "04:30:52.000",
      "formatted_end": "04:30:54.000",
      "text": "خب میگم دوتا بسیار بازم بخورم بین"
    },
    {
      "id": 19,
      "start": 16254.0,
      "end": 16256.0,
      "formatted_start": "04:30:54.000",
      "formatted_end": "04:30:56.000",
      "text": "خب پس اگه دوتا فکر کردم تاهم کردیم"
    },
    {
      "id": 20,
      "start": 16256.0,
      "end": 16258.0,
      "formatted_start": "04:30:56.000",
      "formatted_end": "04:30:58.000",
      "text": "نه از این دارم چند رو بسته هسته"
    },
    {
      "id": 21,
      "start": 16258.0,
      "end": 16259.0,
      "formatted_start": "04:30:58.000",
      "formatted_end": "04:30:59.000",
      "text": "از این چون؟"
    },
    {
      "id": 22,
      "start": 16259.0,
      "end": 16260.0,
      "formatted_start": "04:30:59.000",
      "formatted_end": "04:31:00.000",
      "text": "از این بیا بسته درست هست"
    },
    {
      "id": 23,
      "start": 16260.0,
      "end": 16261.0,
      "formatted_start": "04:31:00.000",
      "formatted_end": "04:31:01.000",
      "text": "با تا با باشین"
    },
    {
      "id": 24,
      "start": 16261.0,
      "end": 16262.0,
      "formatted_start": "04:31:01.000",
      "formatted_end": "04:31:02.000",
      "text": "از این کن"
    },
    {
      "id": 25,
      "start": 16262.0,
      "end": 16263.0,
      "formatted_start": "04:31:02.000",
      "formatted_end": "04:31:03.000",
      "text": "از اینم دارم"
    },
    {
      "id": 26,
      "start": 16263.0,
      "end": 16265.0,
      "formatted_start": "04:31:03.000",
      "formatted_end": "04:31:05.000",
      "text": "صبح شب میخوری؟"
    },
    {
      "id": 27,
      "start": 16265.0,
      "end": 16266.0,
      "formatted_start": "04:31:05.000",
      "formatted_end": "04:31:06.000",
      "text": "آره"
    },
    {
      "id": 28,
      "start": 16266.0,
      "end": 16267.0,
      "formatted_start": "04:31:06.000",
      "formatted_end": "04:31:07.000",
      "text": "یعنی ببین"
    },
    {
      "id": 29,
      "start": 16267.0,
      "end": 16268.0,
      "formatted_start": "04:31:07.000",
      "formatted_end": "04:31:08.000",
      "text": "هیچکار نمیشه باید کرد"
    },
    {
      "id": 30,
      "start": 16268.0,
      "end": 16272.0,
      "formatted_start": "04:31:08.000",
      "formatted_end": "04:31:12.000",
      "text": "تو خدا رای نمیتونی باید بهت انساله نظافه کنه"
    },
    {
      "id": 31,
      "start": 16272.0,
      "end": 16276.0,
      "formatted_start": "04:31:12.000",
      "formatted_end": "04:31:16.000",
      "text": "این ها دیگه مثل اینه بخواهید این رو جمعه بخورن میرن"
    },
    {
      "id": 32,
      "start": 16276.0,
      "end": 16281.0,
      "formatted_start": "04:31:16.000",
      "formatted_end": "04:31:21.000",
      "text": "نه هر روز همون یکی از این یکی از این میخوره دیگه"
    },
    {
      "id": 33,
      "start": 16281.0,
      "end": 16283.0,
      "formatted_start": "04:31:21.000",
      "formatted_end": "04:31:23.000",
      "text": "بله همش همان تو گفتی نداری"
    },
    {
      "id": 34,
      "start": 16283.0,
      "end": 16285.0,
      "formatted_start": "04:31:23.000",
      "formatted_end": "04:31:25.000",
      "text": "همش همین کار بکن جمعه ها بخواهید این رو نخواهید"
    },
    {
      "id": 35,
      "start": 16285.0,
      "end": 16287.0,
      "formatted_start": "04:31:25.000",
      "formatted_end": "04:31:27.000",
      "text": "خب خب خب"
    },
    {
      "id": 36,
      "start": 16287.0,
      "end": 16289.0,
      "formatted_start": "04:31:27.000",
      "formatted_end": "04:31:29.000",
      "text": "خب بچه دید خب"
    },
    {
      "id": 37,
      "start": 16289.0,
      "end": 16291.0,
      "formatted_start": "04:31:29.000",
      "formatted_end": "04:31:31.000",
      "text": "چروی چی چروی؟"
    },
    {
      "id": 38,
      "start": 16291.0,
      "end": 16293.0,
      "formatted_start": "04:31:31.000",
      "formatted_end": "04:31:33.000",
      "text": "چروی خیبتت"
    },
    {
      "id": 39,
      "start": 16293.0,
      "end": 16295.0,
      "formatted_start": "04:31:33.000",
      "formatted_end": "04:31:35.000",
      "text": "بیدارید تا دکتر دیدم"
    },
    {
      "id": 40,
      "start": 16295.0,
      "end": 16297.0,
      "formatted_start": "04:31:35.000",
      "formatted_end": "04:31:37.000",
      "text": "خب باید تو کار دارید بازم که این کاره"
    },
    {
      "id": 41,
      "start": 16297.0,
      "end": 16301.0,
      "formatted_start": "04:31:37.000",
      "formatted_end": "04:31:41.000",
      "text": "دکتر داری برمش که دوها خودش خوبه، خودم میدونم چی کنی"
    },
    {
      "id": 42,
      "start": 16301.0,
      "end": 16304.0,
      "formatted_start": "04:31:41.000",
      "formatted_end": "04:31:44.000",
      "text": "همه آزایش در وقتی خودش مگه چی کنی، چی بگیر"
    },
    {
      "id": 43,
      "start": 16304.0,
      "end": 16308.0,
      "formatted_start": "04:31:44.000",
      "formatted_end": "04:31:48.000",
      "text": "اصلا انقدر که قندتو هندو نخوردی"
    },
    {
      "id": 44,
      "start": 16308.0,
      "end": 16313.0,
      "formatted_start": "04:31:48.000",
      "formatted_end": "04:31:53.000",
      "text": "اصلا هندو نم چرا اینجوری میکنی؟ خودکشی داری میکنی؟"
    },
    {
      "id": 45,
      "start": 16313.0,
      "end": 16318.0,
      "formatted_start": "04:31:53.000",
      "formatted_end": "04:31:58.000",
      "text": "من یک چشم هم، من یک چند وقت چشم هم خود بخود بسته بشن"
    },
    {
      "id": 46,
      "start": 16318.0,
      "end": 16322.0,
      "formatted_start": "04:31:58.000",
      "formatted_end": "04:32:02.000",
      "text": "دو سرم دراز بگشم، همون قندم خب ببین چربی هم بالا رفته"
    },
    {
      "id": 47,
      "start": 16322.0,
      "end": 16325.0,
      "formatted_start": "04:32:02.000",
      "formatted_end": "04:32:05.000",
      "text": "قند و چربی هر دو مغز برام کردن"
    },
    {
      "id": 48,
      "start": 16325.0,
      "end": 16327.0,
      "formatted_start": "04:32:05.000",
      "formatted_end": "04:32:07.000",
      "text": "مهم خیلی آلمخوندی اینه"
    },
    {
      "id": 49,
      "start": 16327.0,
      "end": 16329.0,
      "formatted_start": "04:32:07.000",
      "formatted_end": "04:32:09.000",
      "text": "چشما بیداری که تر دقیقا غربه"
    },
    {
      "id": 50,
      "start": 16329.0,
      "end": 16331.0,
      "formatted_start": "04:32:09.000",
      "formatted_end": "04:32:11.000",
      "text": "شما دارو خیلی خوندی دیره میشن"
    },
    {
      "id": 51,
      "start": 16331.0,
      "end": 16333.0,
      "formatted_start": "04:32:11.000",
      "formatted_end": "04:32:13.000",
      "text": "این ها رو که داری همه رو"
    },
    {
      "id": 52,
      "start": 16333.0,
      "end": 16334.0,
      "formatted_start": "04:32:13.000",
      "formatted_end": "04:32:14.000",
      "text": "خواب"
    },
    {
      "id": 53,
      "start": 16334.0,
      "end": 16335.0,
      "formatted_start": "04:32:14.000",
      "formatted_end": "04:32:15.000",
      "text": "این همه رو داری؟"
    },
    {
      "id": 54,
      "start": 16335.0,
      "end": 16336.0,
      "formatted_start": "04:32:15.000",
      "formatted_end": "04:32:16.000",
      "text": "دورم"
    },
    {
      "id": 55,
      "start": 16336.0,
      "end": 16338.0,
      "formatted_start": "04:32:16.000",
      "formatted_end": "04:32:18.000",
      "text": "خب دارو جدید نباشتن"
    },
    {
      "id": 56,
      "start": 16338.0,
      "end": 16340.0,
      "formatted_start": "04:32:18.000",
      "formatted_end": "04:32:20.000",
      "text": "چربی نمیشه بید؟"
    },
    {
      "id": 57,
      "start": 16340.0,
      "end": 16342.0,
      "formatted_start": "04:32:20.000",
      "formatted_end": "04:32:22.000",
      "text": "دوتا"
    },
    {
      "id": 58,
      "start": 16342.0,
      "end": 16344.0,
      "formatted_start": "04:32:22.000",
      "formatted_end": "04:32:24.000",
      "text": "اگه پشت باید کم دارم"
    },
    {
      "id": 59,
      "start": 16344.0,
      "end": 16346.0,
      "formatted_start": "04:32:24.000",
      "formatted_end": "04:32:26.000",
      "text": "این مار شوهرم رو هست"
    },
    {
      "id": 60,
      "start": 16346.0,
      "end": 16348.0,
      "formatted_start": "04:32:26.000",
      "formatted_end": "04:32:28.000",
      "text": "آره باید بیرون باشه"
    },
    {
      "id": 61,
      "start": 16348.0,
      "end": 16349.0,
      "formatted_start": "04:32:28.000",
      "formatted_end": "04:32:29.000",
      "text": "بده"
    },
    {
      "id": 62,
      "start": 16349.0,
      "end": 16350.0,
      "formatted_start": "04:32:29.000",
      "formatted_end": "04:32:30.000",
      "text": "باید بیرون باشه"
    },
    {
      "id": 63,
      "start": 16350.0,
      "end": 16353.0,
      "formatted_start": "04:32:30.000",
      "formatted_end": "04:32:33.000",
      "text": "اونو بده بینم از کدوم کم داره"
    },
    {
      "id": 64,
      "start": 16353.0,
      "end": 16356.0,
      "formatted_start": "04:32:33.000",
      "formatted_end": "04:32:36.000",
      "text": "از کدوم که از رویت برمی کنی؟"
    },
    {
      "id": 65,
      "start": 16356.0,
      "end": 16359.0,
      "formatted_start": "04:32:36.000",
      "formatted_end": "04:32:39.000",
      "text": "تیروت کم ترون؟ اینم یه وسته دارن؟"
    },
    {
      "id": 66,
      "start": 16359.0,
      "end": 16361.0,
      "formatted_start": "04:32:39.000",
      "formatted_end": "04:32:41.000",
      "text": "این این این"
    },
    {
      "id": 67,
      "start": 16361.0,
      "end": 16366.0,
      "formatted_start": "04:32:41.000",
      "formatted_end": "04:32:46.000",
      "text": "اونو خوردنشان دارد این دارن؟ اونو دوتا بخورم اونو دارم این از اینم دارم"
    },
    {
      "id": 68,
      "start": 16366.0,
      "end": 16368.0,
      "formatted_start": "04:32:46.000",
      "formatted_end": "04:32:48.000",
      "text": "و چه دارم؟ بابانم علیکی بابان چکار؟"
    },
    {
      "id": 69,
      "start": 16368.0,
      "end": 16370.0,
      "formatted_start": "04:32:48.000",
      "formatted_end": "04:32:50.000",
      "text": "باباسا پشت کنید کنید"
    },
    {
      "id": 70,
      "start": 16370.0,
      "end": 16371.0,
      "formatted_start": "04:32:50.000",
      "formatted_end": "04:32:51.000",
      "text": "پشت روی اینجا"
    },
    {
      "id": 71,
      "start": 16371.0,
      "end": 16373.0,
      "formatted_start": "04:32:51.000",
      "formatted_end": "04:32:53.000",
      "text": "باباسا؟ شوهرم کنشتا؟"
    },
    {
      "id": 72,
      "start": 16375.0,
      "end": 16378.0,
      "formatted_start": "04:32:55.000",
      "formatted_end": "04:32:58.000",
      "text": "منم اونو بخورم اونو بخورم"
    },
    {
      "id": 73,
      "start": 16378.0,
      "end": 16381.0,
      "formatted_start": "04:32:58.000",
      "formatted_end": "04:33:01.000",
      "text": "تیروت هم توی یکی بخورم و از یک"
    },
    {
      "id": 74,
      "start": 16381.0,
      "end": 16411.0,
      "formatted_start": "04:33:01.000",
      "formatted_end": "04:33:31.000",
      "text": "درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که درسته که د"
    },
    {
      "id": 75,
      "start": 16411.0,
      "end": 16439.0,
      "formatted_start": "04:33:31.000",
      "formatted_end": "04:33:59.000",
      "text": "موسیقی"
    },
    {
      "id": 76,
      "start": 16439.0,
      "end": 16442.0,
      "formatted_start": "04:33:59.000",
      "formatted_end": "04:34:02.000",
      "text": "باید بیایی نشون بدی چون درواد فرق می کنه"
    },
    {
      "id": 77,
      "start": 16442.0,
      "end": 16444.0,
      "formatted_start": "04:34:02.000",
      "formatted_end": "04:34:04.000",
      "text": "این رو بخوری با اون رو بخوری؟"
    },
    {
      "id": 78,
      "start": 16444.0,
      "end": 16446.0,
      "formatted_start": "04:34:04.000",
      "formatted_end": "04:34:06.000",
      "text": "آره باشی هر دو"
    },
    {
      "id": 79,
      "start": 16446.0,
      "end": 16449.0,
      "formatted_start": "04:34:06.000",
      "formatted_end": "04:34:09.000",
      "text": "همین مودل رو که امبال خوردن بخورم با اون رو یک تا دیدیم"
    },
    {
      "id": 80,
      "start": 16449.0,
      "end": 16451.0,
      "formatted_start": "04:34:09.000",
      "formatted_end": "04:34:11.000",
      "text": "هستن اینی هست"
    },
    {
      "id": 81,
      "start": 16451.0,
      "end": 16455.0,
      "formatted_start": "04:34:11.000",
      "formatted_end": "04:34:15.000",
      "text": "این سایت دور بکشه حال تا تایی پلا تا واقعی"
    },
    {
      "id": 82,
      "start": 16469.0,
      "end": 16475.0,
      "formatted_start": "04:34:29.000",
      "formatted_end": "04:34:35.000",
      "text": "این ها تمام شده باید بگیرم همون ها قدیب جدیدار این ها باید یه چک کنم"
    },
    {
      "id": 83,
      "start": 16475.0,
      "end": 16478.0,
      "formatted_start": "04:34:35.000",
      "formatted_end": "04:34:38.000",
      "text": "چی؟ دارو ها که این ها تمام شد"
    },
    {
      "id": 84,
      "start": 16478.0,
      "end": 16483.0,
      "formatted_start": "04:34:38.000",
      "formatted_end": "04:34:43.000",
      "text": "همین ها رو بگیر فقط اون دهر رو بگو دفعه باید برایت قوی کنن"
    },
    {
      "id": 85,
      "start": 16483.0,
      "end": 16484.0,
      "formatted_start": "04:34:43.000",
      "formatted_end": "04:34:44.000",
      "text": "کنام؟"
    },
    {
      "id": 86,
      "start": 16484.0,
      "end": 16487.0,
      "formatted_start": "04:34:44.000",
      "formatted_end": "04:34:47.000",
      "text": "همون که تازه دهرم گفتم روز دوتا بخوریم"
    },
    {
      "id": 87,
      "start": 16487.0,
      "end": 16491.0,
      "formatted_start": "04:34:47.000",
      "formatted_end": "04:34:51.000",
      "text": "خب خب خب اینو بخورم بشه قد آدمی دوتا بخورم دیگه"
    },
    {
      "id": 88,
      "start": 16491.0,
      "end": 16493.0,
      "formatted_start": "04:34:51.000",
      "formatted_end": "04:34:53.000",
      "text": "شب نمیخورم آن"
    },
    {
      "id": 89,
      "start": 16493.0,
      "end": 16494.0,
      "formatted_start": "04:34:53.000",
      "formatted_end": "04:34:54.000",
      "text": "بخور بگیر"
    },
    {
      "id": 90,
      "start": 16496.0,
      "end": 16497.0,
      "formatted_start": "04:34:56.000",
      "formatted_end": "04:34:57.000",
      "text": "فقط دورا"
    },
    {
      "id": 91,
      "start": 16497.0,
      "end": 16498.0,
      "formatted_start": "04:34:57.000",
      "formatted_end": "04:34:58.000",
      "text": "دورا"
    }
  ],
