    },
    {
      "id": 15,
      "start": 4564.0,
      "end": 4566.0,
      "formatted_start": "01:16:04.000",
      "formatted_end": "01:16:06.000",
      "text": "درسته که بگیره"
    },
    {
      "id": 16,
      "start": 4574.0,
      "end": 4576.0,
      "formatted_start": "01:16:14.000",
      "formatted_end": "01:16:16.000",
      "text": "بشین ما وقتی میادیم"
    },
    {
      "id": 17,
      "start": 4576.0,
      "end": 4578.0,
      "formatted_start": "01:16:16.000",
      "formatted_end": "01:16:18.000",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 4578.0,
      "end": 4580.0,
      "formatted_start": "01:16:18.000",
      "formatted_end": "01:16:20.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 19,
      "start": 4580.0,
      "end": 4582.0,
      "formatted_start": "01:16:20.000",
      "formatted_end": "01:16:22.000",
      "text": "نه، نه"
    },
    {
      "id": 20,
      "start": 4582.0,
      "end": 4584.0,
      "formatted_start": "01:16:22.000",
      "formatted_end": "01:16:24.000",
      "text": "بگیرین تا بیاد باداینا یکم زمان بیدن"
    },
    {
      "id": 21,
      "start": 4584.0,
      "end": 4586.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:26.000",
      "text": "یکم زمان بیدن"
    },
    {
      "id": 22,
      "start": 4586.0,
      "end": 4588.0,
      "formatted_start": "01:16:26.000",
      "formatted_end": "01:16:28.000",
      "text": "آقای محمودی"
    },
    {
      "id": 23,
      "start": 4588.0,
      "end": 4590.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:30.000",
      "text": "مرموشی بیداری"
    },
    {
      "id": 24,
      "start": 4590.0,
      "end": 4592.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:32.000",
      "text": "مرموشی بیداری"
    },
    {
      "id": 25,
      "start": 4592.0,
      "end": 4594.0,
      "formatted_start": "01:16:32.000",
      "formatted_end": "01:16:34.000",
      "text": "سلام خوشیم"
    },
    {
      "id": 26,
      "start": 4594.0,
      "end": 4596.0,
      "formatted_start": "01:16:34.000",
      "formatted_end": "01:16:36.000",
      "text": "خوشیم"
    },
    {
      "id": 27,
      "start": 4596.0,
      "end": 4598.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:38.000",
      "text": "خوشیم"
    },
    {
      "id": 28,
      "start": 4598.0,
      "end": 4600.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:40.000",
      "text": "خوشیم"
    },
    {
      "id": 29,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "خوشیم"
    },
    {
      "id": 30,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "خوشیم"
    },
    {
      "id": 31,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:46.000",
      "text": "خوشیم"
    },
    {
      "id": 32,
      "start": 4606.0,
      "end": 4608.0,
      "formatted_start": "01:16:46.000",
      "formatted_end": "01:16:48.000",
      "text": "خوشیم"
    },
    {
      "id": 33,
      "start": 4608.0,
      "end": 4610.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:16:50.000",
      "text": "خوشیم"
    },
    {
      "id": 34,
      "start": 4610.0,
      "end": 4612.0,
      "formatted_start": "01:16:50.000",
      "formatted_end": "01:16:52.000",
      "text": "خوشیم"
    },
    {
      "id": 35,
      "start": 4612.0,
      "end": 4614.0,
      "formatted_start": "01:16:52.000",
      "formatted_end": "01:16:54.000",
      "text": "خوشیم"
    },
    {
      "id": 36,
      "start": 4614.0,
      "end": 4616.0,
      "formatted_start": "01:16:54.000",
      "formatted_end": "01:16:56.000",
      "text": "خوشیم"
    },
    {
      "id": 37,
      "start": 4616.0,
      "end": 4624.0,
      "formatted_start": "01:16:56.000",
      "formatted_end": "01:17:04.000",
      "text": "این پنتو هایی که داری، اون گرس ها همه شما در صورت سوزش میده و میده کنند"
    },
    {
      "id": 38,
      "start": 4624.0,
      "end": 4628.0,
      "formatted_start": "01:17:04.000",
      "formatted_end": "01:17:08.000",
      "text": "اونا که کدوم میده اش سوزش میده باید باید کدوم در صورت درم نداشته باشند"
    },
    {
      "id": 39,
      "start": 4628.0,
      "end": 4630.0,
      "formatted_start": "01:17:08.000",
      "formatted_end": "01:17:10.000",
      "text": "اونا همیشه نیست"
    },
    {
      "id": 40,
      "start": 4630.0,
      "end": 4632.0,
      "formatted_start": "01:17:10.000",
      "formatted_end": "01:17:12.000",
      "text": "باید باید جعبه باید فلوران که اصلا نمیخواد بخورند"
    },
    {
      "id": 41,
      "start": 4632.0,
      "end": 4635.0,
      "formatted_start": "01:17:12.000",
      "formatted_end": "01:17:15.000",
      "text": "گرس هایی باجبش که هیچ وقت نباید قرار کنند"
    },
    {
      "id": 42,
      "start": 4635.0,
      "end": 4640.0,
      "formatted_start": "01:17:15.000",
      "formatted_end": "01:17:20.000",
      "text": "یکی پنتو هایی که دینشب بهتون گفتم اونو تد دقل بعد شش ماه بخورند"
    },
    {
      "id": 43,
      "start": 4640.0,
      "end": 4642.0,
      "formatted_start": "01:17:20.000",
      "formatted_end": "01:17:22.000",
      "text": "با خورج رو میدونی زخم شده"
    },
    {
      "id": 44,
      "start": 4642.0,
      "end": 4645.0,
      "formatted_start": "01:17:22.000",
      "formatted_end": "01:17:25.000",
      "text": "بعد بزرگ فکر این چند تا داری رو که الان می نویستم خود"
    },
    {
      "id": 45,
      "start": 4645.0,
      "end": 4648.0,
      "formatted_start": "01:17:25.000",
      "formatted_end": "01:17:28.000",
      "text": "اینها رو دیگه هیچ وقت نباید قطع کنن"
    },
    {
      "id": 46,
      "start": 4648.0,
      "end": 4650.0,
      "formatted_start": "01:17:28.000",
      "formatted_end": "01:17:30.000",
      "text": "مردم شما که بودید؟"
    },
    {
      "id": 47,
      "start": 4650.0,
      "end": 4652.0,
      "formatted_start": "01:17:30.000",
      "formatted_end": "01:17:32.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 48,
      "start": 4652.0,
      "end": 4657.0,
      "formatted_start": "01:17:32.000",
      "formatted_end": "01:17:37.000",
      "text": "این طوراً بیشتر که شرکت دارید، با شما بیشتر که بودید"
    },
    {
      "id": 49,
      "start": 4657.0,
      "end": 4661.0,
      "formatted_start": "01:17:37.000",
      "formatted_end": "01:17:41.000",
      "text": "چیزی دارید، از درست دارید، درست دارید"
    },
    {
      "id": 50,
      "start": 4661.0,
      "end": 4665.0,
      "formatted_start": "01:17:41.000",
      "formatted_end": "01:17:45.000",
      "text": "شده خدا، تا خدای جمع شونده بود بگیر"
    },
    {
      "id": 51,
      "start": 4665.0,
      "end": 4667.0,
      "formatted_start": "01:17:45.000",
      "formatted_end": "01:17:47.000",
      "text": "چرا نفتن ولی خوابید؟"
    },
    {
      "id": 52,
      "start": 4667.0,
      "end": 4671.0,
      "formatted_start": "01:17:47.000",
      "formatted_end": "01:17:51.000",
      "text": "پپتیلا، تو گفتید، دیگه نخوره درسته؟"
    },
    {
      "id": 53,
      "start": 4671.0,
      "end": 4672.0,
      "formatted_start": "01:17:51.000",
      "formatted_end": "01:17:52.000",
      "text": "جان؟"
    },
    {
      "id": 54,
      "start": 4672.0,
      "end": 4673.0,
      "formatted_start": "01:17:52.000",
      "formatted_end": "01:17:53.000",
      "text": "پپتیلا"
    },
    {
      "id": 55,
      "start": 4673.0,
      "end": 4674.0,
      "formatted_start": "01:17:53.000",
      "formatted_end": "01:17:54.000",
      "text": "نگاه بیرون"
    },
    {
      "id": 56,
      "start": 4674.0,
      "end": 4677.0,
      "formatted_start": "01:17:54.000",
      "formatted_end": "01:17:57.000",
      "text": "نوشتم، اون سوزه شن میده خود"
    },
    {
      "id": 57,
      "start": 4677.0,
      "end": 4679.0,
      "formatted_start": "01:17:57.000",
      "formatted_end": "01:17:59.000",
      "text": "دو گاشوک شربت به زبان یه پپتی داری"
    },
    {
      "id": 58,
      "start": 4679.0,
      "end": 4680.0,
      "formatted_start": "01:17:59.000",
      "formatted_end": "01:18:00.000",
      "text": "یه پپتی"
    },
    {
      "id": 59,
      "start": 4680.0,
      "end": 4682.0,
      "formatted_start": "01:18:00.000",
      "formatted_end": "01:18:02.000",
      "text": "در صورت درد دو تا کلینگی"
    },
    {
      "id": 60,
      "start": 4682.0,
      "end": 4683.0,
      "formatted_start": "01:18:02.000",
      "formatted_end": "01:18:03.000",
      "text": "آفرین"
    },
    {
      "id": 61,
      "start": 4683.0,
      "end": 4684.0,
      "formatted_start": "01:18:03.000",
      "formatted_end": "01:18:04.000",
      "text": "بیسموی؟"
    },
    {
      "id": 62,
      "start": 4684.0,
      "end": 4685.0,
      "formatted_start": "01:18:04.000",
      "formatted_end": "01:18:05.000",
      "text": "بیسموی دردان دارم می نمی سمونم"
    },
    {
      "id": 63,
      "start": 4685.0,
      "end": 4686.0,
      "formatted_start": "01:18:05.000",
      "formatted_end": "01:18:06.000",
      "text": "اونو که دارم"
    },
    {
      "id": 64,
      "start": 4686.0,
      "end": 4689.0,
      "formatted_start": "01:18:06.000",
      "formatted_end": "01:18:09.000",
      "text": "بعد دو هفته بخورم زخمیتش"
    },
    {
      "id": 65,
      "start": 4689.0,
      "end": 4690.0,
      "formatted_start": "01:18:09.000",
      "formatted_end": "01:18:10.000",
      "text": "بعد سبانهاشان بیسموی تا چی؟"
    },
    {
      "id": 66,
      "start": 4690.0,
      "end": 4692.0,
      "formatted_start": "01:18:10.000",
      "formatted_end": "01:18:12.000",
      "text": "اونا هایی که هستند برقه بزنم کنم"
    },
    {
      "id": 67,
      "start": 4692.0,
      "end": 4693.0,
      "formatted_start": "01:18:12.000",
      "formatted_end": "01:18:13.000",
      "text": "اونو اقل لازم بزنید پلاسیک؟"
    },
    {
      "id": 68,
      "start": 4693.0,
      "end": 4694.0,
      "formatted_start": "01:18:13.000",
      "formatted_end": "01:18:14.000",
      "text": "باشید باشید"
    },
    {
      "id": 69,
      "start": 4694.0,
      "end": 4696.0,
      "formatted_start": "01:18:14.000",
      "formatted_end": "01:18:16.000",
      "text": "اونو تو یه پلاسیک دیگه برات بزنید"
    },
    {
      "id": 70,
      "start": 4696.0,
      "end": 4698.0,
      "formatted_start": "01:18:16.000",
      "formatted_end": "01:18:18.000",
      "text": "اینجا میشناختی که زرگ؟"
    },
    {
      "id": 71,
      "start": 4698.0,
      "end": 4699.0,
      "formatted_start": "01:18:18.000",
      "formatted_end": "01:18:19.000",
      "text": "نه"
    },
    {
      "id": 72,
      "start": 4699.0,
      "end": 4701.0,
      "formatted_start": "01:18:19.000",
      "formatted_end": "01:18:21.000",
      "text": "اینجا میشناختی که بزرگ؟"
    },
    {
      "id": 73,
      "start": 4701.0,
      "end": 4702.0,
      "formatted_start": "01:18:21.000",
      "formatted_end": "01:18:22.000",
      "text": "نه"
    },
    {
      "id": 74,
      "start": 4702.0,
      "end": 4703.0,
      "formatted_start": "01:18:22.000",
      "formatted_end": "01:18:23.000",
      "text": "من سپویده من هستم"
    },
    {
      "id": 75,
      "start": 4703.0,
      "end": 4705.0,
      "formatted_start": "01:18:23.000",
      "formatted_end": "01:18:25.000",
      "text": "آه نه، بکنم میگی کس رو میشناختی"
    },
    {
      "id": 76,
      "start": 4705.0,
      "end": 4706.0,
      "formatted_start": "01:18:25.000",
      "formatted_end": "01:18:26.000",
      "text": "نه"
    },
    {
      "id": 77,
      "start": 4706.0,
      "end": 4708.0,
      "formatted_start": "01:18:26.000",
      "formatted_end": "01:18:28.000",
      "text": "بگن کار رو ما هم هستیم"
    },
    {
      "id": 78,
      "start": 4708.0,
      "end": 4710.0,
      "formatted_start": "01:18:28.000",
      "formatted_end": "01:18:30.000",
      "text": "خودت خدای چه حدود ناسیم"
    },
    {
      "id": 79,
      "start": 4710.0,
      "end": 4711.0,
      "formatted_start": "01:18:30.000",
      "formatted_end": "01:18:31.000",
      "text": "نه واقعا"
    },
    {
      "id": 80,
      "start": 4712.0,
      "end": 4716.0,
      "formatted_start": "01:18:32.000",
      "formatted_end": "01:18:36.000",
      "text": "اون باره خودش میدانه و کارتو چی زده و کی زده و کجا زده و..."
    },
    {
      "id": 81,
      "start": 4716.0,
      "end": 4717.0,
      "formatted_start": "01:18:36.000",
      "formatted_end": "01:18:37.000",
      "text": "خدا مستقیل"
    },
    {
      "id": 82,
      "start": 4717.0,
      "end": 4718.0,
      "formatted_start": "01:18:37.000",
      "formatted_end": "01:18:38.000",
      "text": "جواب نمیدونه که"
    },
    {
      "id": 83,
      "start": 4718.0,
      "end": 4719.0,
      "formatted_start": "01:18:38.000",
      "formatted_end": "01:18:39.000",
      "text": "نه خدا مستقیل"
    },
    {
      "id": 84,
      "start": 4719.0,
      "end": 4720.0,
      "formatted_start": "01:18:39.000",
      "formatted_end": "01:18:40.000",
      "text": "خدا مستقیل"
    },
    {
      "id": 85,
      "start": 4720.0,
      "end": 4721.0,
      "formatted_start": "01:18:40.000",
      "formatted_end": "01:18:41.000",
      "text": "خدا مستقیل"
    },
    {
      "id": 86,
      "start": 4721.0,
      "end": 4723.0,
      "formatted_start": "01:18:41.000",
      "formatted_end": "01:18:43.000",
      "text": "از اینجا باید برداریم که که زده و که که که زده"
    },
    {
      "id": 87,
      "start": 4723.0,
      "end": 4725.0,
      "formatted_start": "01:18:43.000",
      "formatted_end": "01:18:45.000",
      "text": "که که که زده و که که که زده"
    },
    {
      "id": 88,
      "start": 4725.0,
      "end": 4727.0,
      "formatted_start": "01:18:45.000",
      "formatted_end": "01:18:47.000",
      "text": "که زده و که که که زده"
    },
    {
      "id": 89,
      "start": 4727.0,
      "end": 4729.0,
      "formatted_start": "01:18:47.000",
      "formatted_end": "01:18:49.000",
      "text": "که زده و که که زده"
    },
    {
      "id": 90,
