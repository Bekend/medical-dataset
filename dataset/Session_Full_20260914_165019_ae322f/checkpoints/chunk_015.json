  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4529.98,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 4530.0,
      "end": 4532.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:32.000",
      "text": "این کار کاری هست"
    },
    {
      "id": 2,
      "start": 4532.0,
      "end": 4534.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:34.000",
      "text": "چیه گوشیه؟"
    },
    {
      "id": 3,
      "start": 4534.0,
      "end": 4536.0,
      "formatted_start": "01:15:34.000",
      "formatted_end": "01:15:36.000",
      "text": "برام فولیش و برام بینه نفت های دهان"
    },
    {
      "id": 4,
      "start": 4536.0,
      "end": 4538.0,
      "formatted_start": "01:15:36.000",
      "formatted_end": "01:15:38.000",
      "text": "باش"
    },
    {
      "id": 5,
      "start": 4538.0,
      "end": 4540.0,
      "formatted_start": "01:15:38.000",
      "formatted_end": "01:15:40.000",
      "text": "اینکه سه بابش که را بردارو بگیرم"
    },
    {
      "id": 6,
      "start": 4540.0,
      "end": 4542.0,
      "formatted_start": "01:15:40.000",
      "formatted_end": "01:15:42.000",
      "text": "برای نفت های دستشید"
    },
    {
      "id": 7,
