  "stt_segments": [
    {
      "id": 0,
      "start": 17100.0,
      "end": 17105.0,
      "formatted_start": "04:45:00.000",
      "formatted_end": "04:45:05.000",
      "text": "از این موهرده بیمار، از اونو خود آهانو بیده بستم."
    },
    {
      "id": 1,
      "start": 17105.0,
      "end": 17110.0,
      "formatted_start": "04:45:05.000",
      "formatted_end": "04:45:10.000",
      "text": "اولا که بهت دادم بلازه یک ماه از بعدش ماهیه دونه بخوردم."
    },
    {
      "id": 2,
      "start": 17110.0,
      "end": 17112.0,
      "formatted_start": "04:45:10.000",
      "formatted_end": "04:45:12.000",
      "text": "چون جز نمیخورده بزرگ."
    },
    {
      "id": 3,
      "start": 17112.0,
      "end": 17116.0,
      "formatted_start": "04:45:12.000",
      "formatted_end": "04:45:16.000",
      "text": "بیهالی خیلی شدید دارم، اصلا اولا که دیگه مریض شدم."
    },
    {
      "id": 4,
      "start": 17116.0,
      "end": 17122.0,
      "formatted_start": "04:45:16.000",
      "formatted_end": "04:45:22.000",
      "text": "من یه چکار میدونستم، اگر خوب نشدیدیدی همجور بیهالی، حتما برای ازوش باشید."
    },
    {
      "id": 5,
      "start": 17122.0,
      "end": 17123.0,
      "formatted_start": "04:45:22.000",
      "formatted_end": "04:45:23.000",
      "text": "باش."
    },
    {
      "id": 6,
      "start": 17123.0,
      "end": 17124.0,
      "formatted_start": "04:45:23.000",
      "formatted_end": "04:45:24.000",
      "text": "تا مهم گردم."
    },
    {
      "id": 7,
      "start": 17124.0,
      "end": 17126.0,
      "formatted_start": "04:45:24.000",
      "formatted_end": "04:45:26.000",
      "text": "دارو کنم برم، آره؟"
    },
    {
      "id": 8,
      "start": 17126.0,
      "end": 17127.0,
      "formatted_start": "04:45:26.000",
      "formatted_end": "04:45:27.000",
      "text": "آره."
    },
    {
      "id": 9,
      "start": 17127.0,
      "end": 17128.0,
      "formatted_start": "04:45:27.000",
      "formatted_end": "04:45:28.000",
      "text": "مرسی."
    },
    {
      "id": 10,
      "start": 17128.0,
      "end": 17130.0,
      "formatted_start": "04:45:28.000",
      "formatted_end": "04:45:30.000",
      "text": "ترزی دارید من را برس کنیم؟"
    },
    {
      "id": 11,
      "start": 17130.0,
      "end": 17132.0,
      "formatted_start": "04:45:30.000",
      "formatted_end": "04:45:32.000",
      "text": "ایلا باشم نمیشه ترزی بخواهیم خیلی خوب"
    },
    {
      "id": 12,
      "start": 17132.0,
      "end": 17134.0,
      "formatted_start": "04:45:32.000",
      "formatted_end": "04:45:34.000",
      "text": "مرسی"
    },
    {
      "id": 13,
      "start": 17136.0,
      "end": 17138.0,
      "formatted_start": "04:45:36.000",
      "formatted_end": "04:45:38.000",
      "text": "سیپشاژی درست نمیدونیم"
    },
    {
      "id": 14,
      "start": 17138.0,
      "end": 17140.0,
      "formatted_start": "04:45:38.000",
      "formatted_end": "04:45:40.000",
      "text": "تانسیتو بفرامون برسیم"
    },
    {
      "id": 15,
      "start": 17140.0,
      "end": 17142.0,
      "formatted_start": "04:45:40.000",
      "formatted_end": "04:45:42.000",
      "text": "چون شابلوی مایزه که"
    },
    {
      "id": 16,
      "start": 17142.0,
      "end": 17144.0,
      "formatted_start": "04:45:42.000",
      "formatted_end": "04:45:44.000",
      "text": "موبای عرب میداده"
    },
    {
      "id": 17,
      "start": 17144.0,
      "end": 17146.0,
      "formatted_start": "04:45:44.000",
      "formatted_end": "04:45:46.000",
      "text": "خودمون برسیم؟"
    },
    {
      "id": 18,
      "start": 17146.0,
      "end": 17148.0,
      "formatted_start": "04:45:46.000",
      "formatted_end": "04:45:48.000",
      "text": "مخصوصا تو نمو برسید"
    },
    {
      "id": 19,
      "start": 17148.0,
      "end": 17150.0,
      "formatted_start": "04:45:48.000",
      "formatted_end": "04:45:50.000",
      "text": "اون کفیه میشه"
    },
    {
      "id": 20,
      "start": 17150.0,
      "end": 17152.0,
      "formatted_start": "04:45:50.000",
      "formatted_end": "04:45:52.000",
      "text": "دیگه نمتکردم آزو میگم"
    },
    {
      "id": 21,
      "start": 17152.0,
      "end": 17154.0,
      "formatted_start": "04:45:52.000",
      "formatted_end": "04:45:54.000",
      "text": "اسپره زدم چون اسپره زدم بوش عذیب هم کردم"
    },
    {
      "id": 22,
      "start": 17154.0,
      "end": 17156.0,
      "formatted_start": "04:45:54.000",
      "formatted_end": "04:45:56.000",
      "text": "برسیم جدا موقع میگرفتم"
    },
    {
      "id": 23,
      "start": 17156.0,
      "end": 17186.0,
      "formatted_start": "04:45:56.000",
      "formatted_end": "04:46:26.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 24,
      "start": 17186.0,
      "end": 17216.0,
      "formatted_start": "04:46:26.000",
      "formatted_end": "04:46:56.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
