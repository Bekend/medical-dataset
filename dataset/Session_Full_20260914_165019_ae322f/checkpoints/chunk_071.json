  "stt_segments": [
    {
      "id": 0,
      "start": 21300.0,
      "end": 21329.98,
      "formatted_start": "05:55:00.000",
      "formatted_end": "05:55:29.980",
      "text": "بیمار بیمار در مطب پزشکی، معاینه بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 21330.0,
      "end": 21332.0,
      "formatted_start": "05:55:30.000",
      "formatted_end": "05:55:32.000",
      "text": "تو مقدسی میده دنباله؟"
    },
    {
      "id": 2,
      "start": 21332.0,
      "end": 21335.0,
      "formatted_start": "05:55:32.000",
      "formatted_end": "05:55:35.000",
      "text": "نه خب او رو ختم بیان مبلا رو بشن و میخوام بیمارستان"
    },
    {
      "id": 3,
      "start": 21335.0,
      "end": 21338.0,
      "formatted_start": "05:55:35.000",
      "formatted_end": "05:55:38.000",
      "text": "اصلا میانه آقای دکتور افتخار بدن بیدار بشن"
    },
    {
      "id": 4,
      "start": 21338.0,
      "end": 21340.0,
      "formatted_start": "05:55:38.000",
      "formatted_end": "05:55:40.000",
      "text": "نه دیگه، من بیمارستان بیمارستان بیمارستان"
    },
    {
      "id": 5,
      "start": 21340.0,
      "end": 21342.0,
      "formatted_start": "05:55:40.000",
      "formatted_end": "05:55:42.000",
      "text": "الان فولی مطلع ماشه از آقایی شده"
    },
    {
      "id": 6,
      "start": 21342.0,
      "end": 21343.0,
      "formatted_start": "05:55:42.000",
      "formatted_end": "05:55:43.000",
      "text": "او بیمارستان برگردان؟"
    },
    {
      "id": 7,
      "start": 21343.0,
      "end": 21345.0,
      "formatted_start": "05:55:43.000",
      "formatted_end": "05:55:45.000",
      "text": "امشب نه، میخوام برم بیمارستان، اینجا مریض دارم"
    },
    {
      "id": 8,
      "start": 21345.0,
      "end": 21347.0,
      "formatted_start": "05:55:45.000",
      "formatted_end": "05:55:47.000",
      "text": "ارنبی گوز دیگه؟"
    },
    {
      "id": 9,
      "start": 21347.0,
      "end": 21349.0,
      "formatted_start": "05:55:47.000",
      "formatted_end": "05:55:49.000",
      "text": "اونجا حضرت محسوبان مریض داره"
    },
    {
      "id": 10,
      "start": 21349.0,
      "end": 21379.0,
      "formatted_start": "05:55:49.000",
      "formatted_end": "05:56:19.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا ب"
    },
    {
      "id": 11,
      "start": 21379.0,
      "end": 21381.0,
      "formatted_start": "05:56:19.000",
      "formatted_end": "05:56:21.000",
      "text": "بیمه چیه ماما؟"
    },
    {
      "id": 12,
      "start": 21381.0,
      "end": 21383.0,
      "formatted_start": "05:56:21.000",
      "formatted_end": "05:56:23.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 21383.0,
      "end": 21385.0,
      "formatted_start": "05:56:23.000",
      "formatted_end": "05:56:25.000",
      "text": "سرمتی"
