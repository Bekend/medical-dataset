  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12903.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:03.000",
      "text": "خیلی علاقه کنیدم به روحانو شنجون."
    },
    {
      "id": 1,
      "start": 12903.0,
      "end": 12906.0,
      "formatted_start": "03:35:03.000",
      "formatted_end": "03:35:06.000",
      "text": "همه نقمه یکی دیگه؟"
    },
    {
      "id": 2,
      "start": 12906.0,
      "end": 12908.0,
      "formatted_start": "03:35:06.000",
      "formatted_end": "03:35:08.000",
      "text": "نقمه شارودیه ها."
    },
    {
      "id": 3,
      "start": 12908.0,
      "end": 12914.0,
      "formatted_start": "03:35:08.000",
      "formatted_end": "03:35:14.000",
      "text": "بعد مرض کم کنید، بگیر خب، تخمه مرد بوشت قرنمز، هفته یه بار بیشتر نخواید تخمه مرد،"
    },
    {
      "id": 4,
      "start": 12914.0,
      "end": 12916.0,
      "formatted_start": "03:35:14.000",
      "formatted_end": "03:35:16.000",
      "text": "آفت رو خواید مثلا هفته دو بار بیشتر نخواید."
    },
    {
      "id": 5,
      "start": 12916.0,
      "end": 12918.0,
      "formatted_start": "03:35:16.000",
      "formatted_end": "03:35:18.000",
      "text": "آفت نمیدونه، اونو مخورم ایدیاد."
    },
    {
      "id": 6,
      "start": 12918.0,
      "end": 12924.0,
      "formatted_start": "03:35:18.000",
      "formatted_end": "03:35:24.000",
      "text": "آره، همون دو بار دارد، تخمه، آجی، صخ، گردنی، جگر، کلپاچه،"
    },
    {
      "id": 7,
      "start": 12924.0,
      "end": 12932.0,
      "formatted_start": "03:35:24.000",
      "formatted_end": "03:35:32.000",
      "text": "این شابه دلستر اینها همه قرارند چر بیرون برای بالا کبد را چرد می کنید و تحرک داشتید"
    },
    {
      "id": 8,
      "start": 12932.0,
      "end": 12936.0,
      "formatted_start": "03:35:32.000",
      "formatted_end": "03:35:36.000",
      "text": "اما دیگه کم کم از اینکه از دلیلت موضوع نمی بزنید"
    },
    {
      "id": 9,
      "start": 12936.0,
      "end": 12944.0,
      "formatted_start": "03:35:36.000",
      "formatted_end": "03:35:44.000",
      "text": "این چند تا چیزی هست خانمی دودو اصحابی می کنید من دخالت نبارد می شم و من یک قرار زبانم نمیزم"
    },
    {
      "id": 10,
      "start": 12944.0,
      "end": 12953.0,
      "formatted_start": "03:35:44.000",
      "formatted_end": "03:35:53.000",
      "text": "این خانم مثلا الان می بینیم من یک کارت آبر داریم من بگو آبر اوپنه اگر خودش یا بچه سر زور"
    },
    {
      "id": 11,
      "start": 12953.0,
      "end": 12956.0,
      "formatted_start": "03:35:53.000",
      "formatted_end": "03:35:56.000",
      "text": "اونگون باید از سر کوچه یه نوشاب سرد بگیمید"
    },
    {
      "id": 12,
      "start": 12956.0,
      "end": 12960.0,
      "formatted_start": "03:35:56.000",
      "formatted_end": "03:36:00.000",
      "text": "هم نوشاب قدم آبود باید دیگه"
