  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9610.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:10.000",
      "text": "این اصحال را برای این اصحال داشتی؟"
    },
    {
      "id": 1,
      "start": 9610.0,
      "end": 9620.0,
      "formatted_start": "02:40:10.000",
      "formatted_end": "02:40:20.000",
      "text": "آره، برای اصحال اونها یکم بیتر شده، من گوینم هنوز دستشویم، حالت سوزده شده اینایی هست، با اینکه متونه زورم و فرام و پرس های دروده هم داری اینا."
    },
    {
      "id": 2,
      "start": 9620.0,
      "end": 9622.0,
      "formatted_start": "02:40:20.000",
      "formatted_end": "02:40:22.000",
      "text": "ادرالت، ادرالت مثل اونه؟"
    },
    {
      "id": 3,
      "start": 9622.0,
      "end": 9626.0,
      "formatted_start": "02:40:22.000",
      "formatted_end": "02:40:26.000",
      "text": "نه، همونطور کلا، یکم خودش مثل اونه."
    },
    {
      "id": 4,
      "start": 9626.0,
      "end": 9627.0,
      "formatted_start": "02:40:26.000",
      "formatted_end": "02:40:27.000",
      "text": "پشته؟"
    },
    {
      "id": 5,
      "start": 9627.0,
      "end": 9628.0,
      "formatted_start": "02:40:27.000",
      "formatted_end": "02:40:28.000",
      "text": "نه، همون جلو."
    },
    {
      "id": 6,
      "start": 9628.0,
      "end": 9629.0,
      "formatted_start": "02:40:28.000",
      "formatted_end": "02:40:29.000",
      "text": "جلو؟"
    },
    {
      "id": 7,
      "start": 9629.0,
      "end": 9631.0,
      "formatted_start": "02:40:29.000",
      "formatted_end": "02:40:31.000",
      "text": "ادرار کردم بیستوزونه"
    },
    {
      "id": 8,
      "start": 9631.0,
      "end": 9633.0,
      "formatted_start": "02:40:31.000",
      "formatted_end": "02:40:33.000",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 9633.0,
      "end": 9635.0,
      "formatted_start": "02:40:33.000",
      "formatted_end": "02:40:35.000",
      "text": "پومات بزرگ دادم"
    },
    {
      "id": 10,
      "start": 9635.0,
      "end": 9637.0,
      "formatted_start": "02:40:35.000",
      "formatted_end": "02:40:37.000",
      "text": "نه"
    },
    {
      "id": 11,
      "start": 9637.0,
      "end": 9639.0,
      "formatted_start": "02:40:37.000",
      "formatted_end": "02:40:39.000",
      "text": "پومات بزرگ دادم"
    },
    {
      "id": 12,
      "start": 9639.0,
      "end": 9641.0,
      "formatted_start": "02:40:39.000",
      "formatted_end": "02:40:41.000",
      "text": "کبد رو خونده"
    },
    {
      "id": 13,
      "start": 9641.0,
      "end": 9645.0,
      "formatted_start": "02:40:41.000",
      "formatted_end": "02:40:45.000",
      "text": "کبد اصل شرایط رژیم غذایی"
    },
    {
      "id": 14,
      "start": 9645.0,
      "end": 9647.0,
      "formatted_start": "02:40:45.000",
      "formatted_end": "02:40:47.000",
      "text": "من برس میدونیم سمری به این اصلا درنم بگم"
    },
    {
      "id": 15,
      "start": 9647.0,
      "end": 9649.0,
      "formatted_start": "02:40:47.000",
      "formatted_end": "02:40:49.000",
      "text": "بعد دستش خود رایت کنیم"
    },
    {
      "id": 16,
      "start": 9649.0,
      "end": 9651.0,
      "formatted_start": "02:40:49.000",
      "formatted_end": "02:40:51.000",
      "text": "یعنی باید روحان اینو زیاد نخورن"
    },
    {
      "id": 17,
      "start": 9651.0,
      "end": 9653.0,
      "formatted_start": "02:40:51.000",
      "formatted_end": "02:40:53.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 9653.0,
      "end": 9655.0,
      "formatted_start": "02:40:53.000",
      "formatted_end": "02:40:55.000",
      "text": "بعد بهر"
    },
    {
      "id": 19,
      "start": 9655.0,
      "end": 9657.0,
      "formatted_start": "02:40:55.000",
      "formatted_end": "02:40:57.000",
      "text": "نسکافه"
    },
    {
      "id": 20,
      "start": 9657.0,
      "end": 9659.0,
      "formatted_start": "02:40:57.000",
      "formatted_end": "02:40:59.000",
      "text": "نسکافه این چی؟ یعنی پوت قبل؟"
    },
    {
      "id": 21,
      "start": 9659.0,
      "end": 9661.0,
      "formatted_start": "02:40:59.000",
      "formatted_end": "02:41:01.000",
      "text": "آماده شیرین شده"
    },
    {
      "id": 22,
      "start": 9661.0,
      "end": 9664.0,
      "formatted_start": "02:41:01.000",
      "formatted_end": "02:41:04.000",
      "text": "آماده چی؟ میگن محمود میگن نسکافه های در موضوع محمود اینو آماده هستن"
    },
    {
      "id": 23,
      "start": 9664.0,
      "end": 9666.0,
      "formatted_start": "02:41:04.000",
      "formatted_end": "02:41:06.000",
      "text": "خواهد اون شیرین شده هست"
    },
    {
      "id": 24,
      "start": 9666.0,
      "end": 9668.0,
      "formatted_start": "02:41:06.000",
      "formatted_end": "02:41:08.000",
      "text": "باز دوباره قبل بزن"
    },
    {
      "id": 25,
      "start": 9668.0,
      "end": 9670.0,
      "formatted_start": "02:41:08.000",
      "formatted_end": "02:41:10.000",
      "text": "خواهد اون که باز دوباره بدتر کبرده تو میکنه"
    },
    {
      "id": 26,
      "start": 9670.0,
      "end": 9672.0,
      "formatted_start": "02:41:10.000",
      "formatted_end": "02:41:12.000",
      "text": "میگن میلیم شیرینی خیلی زیاده"
    },
    {
      "id": 27,
      "start": 9672.0,
      "end": 9675.0,
      "formatted_start": "02:41:12.000",
      "formatted_end": "02:41:15.000",
      "text": "از اون که بدتره تو میکنه، که هم میتونی بگیره"
    },
    {
      "id": 28,
      "start": 9675.0,
      "end": 9678.0,
      "formatted_start": "02:41:15.000",
      "formatted_end": "02:41:18.000",
      "text": "قبل با قبل هم نیست؟"
    },
    {
      "id": 29,
      "start": 9678.0,
      "end": 9679.0,
      "formatted_start": "02:41:18.000",
      "formatted_end": "02:41:19.000",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 9679.0,
      "end": 9681.0,
      "formatted_start": "02:41:19.000",
      "formatted_end": "02:41:21.000",
      "text": "از این شهر رو بیان همه ساز بیانیم"
    },
    {
      "id": 31,
      "start": 9681.0,
      "end": 9683.0,
      "formatted_start": "02:41:21.000",
      "formatted_end": "02:41:23.000",
      "text": "قرارش هم گرون شده"
    },
    {
      "id": 32,
      "start": 9683.0,
      "end": 9685.0,
      "formatted_start": "02:41:23.000",
      "formatted_end": "02:41:25.000",
      "text": "خوبتن بخواد این باره نمیشه"
    },
    {
      "id": 33,
      "start": 9685.0,
      "end": 9687.0,
      "formatted_start": "02:41:25.000",
      "formatted_end": "02:41:27.000",
      "text": "جدید خبرش رو زدن شد"
    },
    {
      "id": 34,
      "start": 9687.0,
      "end": 9689.0,
      "formatted_start": "02:41:27.000",
      "formatted_end": "02:41:29.000",
      "text": "درستن گرون شدن"
    },
    {
      "id": 35,
      "start": 9689.0,
      "end": 9691.0,
      "formatted_start": "02:41:29.000",
      "formatted_end": "02:41:31.000",
      "text": "من تو بگفتم خب این افاده رو خریدم"
    },
    {
      "id": 36,
      "start": 9691.0,
      "end": 9693.0,
      "formatted_start": "02:41:31.000",
      "formatted_end": "02:41:33.000",
      "text": "هفت سبتون همینه تر"
    },
    {
      "id": 37,
      "start": 9693.0,
      "end": 9695.0,
      "formatted_start": "02:41:33.000",
      "formatted_end": "02:41:35.000",
      "text": "نه نه باید هر چیزی تعمالی پیدا بکنیم"
    },
    {
      "id": 38,
      "start": 9695.0,
      "end": 9697.0,
      "formatted_start": "02:41:35.000",
      "formatted_end": "02:41:37.000",
      "text": "آره بله"
    },
    {
      "id": 39,
      "start": 9697.0,
      "end": 9699.0,
      "formatted_start": "02:41:37.000",
      "formatted_end": "02:41:39.000",
      "text": "دیگه از این به بعد"
    },
    {
      "id": 40,
      "start": 9699.0,
      "end": 9701.0,
      "formatted_start": "02:41:39.000",
      "formatted_end": "02:41:41.000",
      "text": "مسافرت رفتن هم برای مردم"
    },
    {
      "id": 41,
      "start": 9701.0,
      "end": 9703.0,
      "formatted_start": "02:41:41.000",
      "formatted_end": "02:41:43.000",
      "text": "سبتون هم برسونیم"
    },
    {
      "id": 42,
      "start": 9703.0,
      "end": 9705.0,
      "formatted_start": "02:41:43.000",
      "formatted_end": "02:41:45.000",
      "text": "یه سفر میخوایی بری"
    },
    {
      "id": 43,
      "start": 9705.0,
      "end": 9709.5,
      "formatted_start": "02:41:45.000",
      "formatted_end": "02:41:49.500",
      "text": "این افزون دارم یه سالی امروز اطفال پداشهاش بدخواد شده"
    },
    {
      "id": 44,
      "start": 9709.5,
      "end": 9711.0,
      "formatted_start": "02:41:49.500",
      "formatted_end": "02:41:51.000",
      "text": "دفتر این هم ناراحته"
    },
    {
      "id": 45,
      "start": 9711.0,
      "end": 9715.0,
      "formatted_start": "02:41:51.000",
      "formatted_end": "02:41:55.000",
      "text": "رفت و برگشت گرفتن از مشهد رامساره، هفته و پنج میده"
    },
    {
      "id": 46,
      "start": 9715.0,
      "end": 9718.2,
      "formatted_start": "02:41:55.000",
      "formatted_end": "02:41:58.200",
      "text": "سه تا آدم اینجا میخوای به خانواده بری بری، هفته و پنج شفت"
    },
    {
      "id": 47,
      "start": 9718.2,
      "end": 9720.0,
      "formatted_start": "02:41:58.200",
      "formatted_end": "02:42:00.000",
      "text": "برای هواپه ما میشه"
    },
    {
      "id": 48,
      "start": 9722.0,
      "end": 9725.0,
      "formatted_start": "02:42:02.000",
      "formatted_end": "02:42:05.000",
      "text": "آیا چه کچیک داره، میجای تحضیت میکنه"
    },
    {
      "id": 49,
      "start": 9726.0,
      "end": 9730.0,
      "formatted_start": "02:42:06.000",
      "formatted_end": "02:42:10.000",
      "text": "برای مرداسین واهنگی، پراید قرار، بریم مشهد یه جنب بریم"
    },
    {
      "id": 50,
      "start": 9730.0,
      "end": 9732.0,
      "formatted_start": "02:42:10.000",
      "formatted_end": "02:42:12.000",
      "text": "آمو نمو برن مورد"
    },
    {
      "id": 51,
      "start": 9732.0,
      "end": 9736.0,
      "formatted_start": "02:42:12.000",
      "formatted_end": "02:42:16.000",
      "text": "همون هم خرش داره تو یه دقیقه یک کلام میشه باید سرویس کنی"
    },
    {
      "id": 52,
      "start": 9736.0,
      "end": 9737.0,
      "formatted_start": "02:42:16.000",
      "formatted_end": "02:42:17.000",
      "text": "همون دیگه"
    },
    {
      "id": 53,
      "start": 9737.0,
      "end": 9738.0,
      "formatted_start": "02:42:17.000",
      "formatted_end": "02:42:18.000",
      "text": "اگه میشه"
    },
    {
      "id": 54,
      "start": 9740.0,
      "end": 9744.0,
      "formatted_start": "02:42:20.000",
      "formatted_end": "02:42:24.000",
      "text": "ماشین هم وقتی میخوایی بریت و افراد سرویس کنی همین پول همه چی داره"
    },
    {
      "id": 55,
      "start": 9747.0,
      "end": 9749.0,
      "formatted_start": "02:42:27.000",
      "formatted_end": "02:42:29.000",
      "text": "انشان صادم باشه"
    },
    {
      "id": 56,
      "start": 9753.0,
      "end": 9754.0,
      "formatted_start": "02:42:33.000",
      "formatted_end": "02:42:34.000",
      "text": "چی شده تا؟"
    },
    {
      "id": 57,
      "start": 9754.0,
      "end": 9756.0,
      "formatted_start": "02:42:34.000",
      "formatted_end": "02:42:36.000",
      "text": "داری چیست؟ اونها اونها اونها مرده مرده"
    },
    {
      "id": 58,
      "start": 9756.0,
      "end": 9758.0,
      "formatted_start": "02:42:36.000",
      "formatted_end": "02:42:38.000",
      "text": "برای این آنها و این آنها من مانو دیرویت بوده زدن"
    },
    {
      "id": 59,
      "start": 9758.0,
      "end": 9760.0,
      "formatted_start": "02:42:38.000",
      "formatted_end": "02:42:40.000",
      "text": "بعد چکل میبینیم کم بزیار نشون شد"
    },
    {
      "id": 60,
      "start": 9762.0,
      "end": 9792.0,
      "formatted_start": "02:42:42.000",
      "formatted_end": "02:43:12.000",
      "text": "از اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 61,
      "start": 9792.0,
      "end": 9798.8,
      "formatted_start": "02:43:12.000",
      "formatted_end": "02:43:18.800",
      "text": "اگر تونستی یک پستیتی برای بیمارستان ازت محسوبه نوشتم بگیر"
    },
    {
      "id": 62,
      "start": 9798.8,
      "end": 9800.8,
      "formatted_start": "02:43:18.800",
      "formatted_end": "02:43:20.800",
      "text": "نوشته ره، همینجوری باید دارم کنم"
    },
    {
      "id": 63,
      "start": 9800.8,
      "end": 9802.8,
      "formatted_start": "02:43:20.800",
      "formatted_end": "02:43:22.800",
      "text": "نه، حالی ما وقت داریم، پر وقت تونستی داریم"
    },
    {
      "id": 64,
      "start": 9802.8,
      "end": 9804.8,
      "formatted_start": "02:43:22.800",
      "formatted_end": "02:43:24.800",
      "text": "دستتون در نکذبه برم"
    },
    {
      "id": 65,
      "start": 9804.8,
      "end": 9807.8,
      "formatted_start": "02:43:24.800",
      "formatted_end": "02:43:27.800",
      "text": "دستتون در نکذبه برم، اگر موهم روغر زیرتون داریم نموخویم"
    },
    {
      "id": 66,
      "start": 9807.8,
      "end": 9811.8,
      "formatted_start": "02:43:27.800",
      "formatted_end": "02:43:31.800",
      "text": "هیچم روغر، خب بعد میریم اونو هم نخوییم که کمی دست داریم"
    },
    {
      "id": 67,
      "start": 9811.8,
      "end": 9813.8,
      "formatted_start": "02:43:31.800",
      "formatted_end": "02:43:33.800",
      "text": "دست در نکذبه برم"
    },
    {
      "id": 68,
      "start": 9813.8,
      "end": 9843.8,
      "formatted_start": "02:43:33.800",
      "formatted_end": "02:44:03.800",
      "text": "برای اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه"
    },
    {
      "id": 69,
      "start": 9843.8,
      "end": 9845.8,
      "formatted_start": "02:44:03.800",
      "formatted_end": "02:44:05.800",
      "text": "خوبه"
    },
    {
      "id": 70,
      "start": 9849.8,
      "end": 9851.8,
      "formatted_start": "02:44:09.800",
      "formatted_end": "02:44:11.800",
      "text": "خوبه"
    },
    {
      "id": 71,
      "start": 9853.8,
      "end": 9855.8,
      "formatted_start": "02:44:13.800",
      "formatted_end": "02:44:15.800",
      "text": "خوبه"
    },
    {
      "id": 72,
      "start": 9855.8,
      "end": 9857.8,
      "formatted_start": "02:44:15.800",
      "formatted_end": "02:44:17.800",
      "text": "خوبه"
    },
    {
      "id": 73,
      "start": 9873.8,
      "end": 9899.8,
      "formatted_start": "02:44:33.800",
      "formatted_end": "02:44:59.800",
      "text": "موسیقی"
    }
  ],
