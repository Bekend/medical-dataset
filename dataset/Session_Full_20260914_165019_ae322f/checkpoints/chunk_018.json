      "start": 5585.3,
      "end": 5586.42,
      "formatted_start": "01:33:05.300",
      "formatted_end": "01:33:06.420",
      "text": "دیگه چک کردی؟"
    },
    {
      "id": 70,
      "start": 5586.42,
      "end": 5588.42,
      "formatted_start": "01:33:06.420",
      "formatted_end": "01:33:08.420",
      "text": "نگه نرفتم دکتر چکم نکردم"
    },
    {
      "id": 71,
      "start": 5588.42,
      "end": 5590.42,
      "formatted_start": "01:33:08.420",
      "formatted_end": "01:33:10.420",
      "text": "آره"
    },
    {
      "id": 72,
      "start": 5590.42,
      "end": 5592.42,
      "formatted_start": "01:33:10.420",
      "formatted_end": "01:33:12.420",
      "text": "برای خیلی بچه زن"
    },
    {
      "id": 73,
      "start": 5592.42,
      "end": 5594.42,
      "formatted_start": "01:33:12.420",
      "formatted_end": "01:33:14.420",
      "text": "سرخواد بودم"
    },
    {
      "id": 74,
      "start": 5594.42,
      "end": 5596.42,
      "formatted_start": "01:33:14.420",
      "formatted_end": "01:33:16.420",
      "text": "از سرخواد بودم"
    },
    {
      "id": 75,
      "start": 5596.42,
      "end": 5598.42,
      "formatted_start": "01:33:16.420",
      "formatted_end": "01:33:18.420",
      "text": "برای خواد چیزان"
    },
    {
      "id": 76,
      "start": 5598.42,
      "end": 5600.42,
      "formatted_start": "01:33:18.420",
      "formatted_end": "01:33:20.420",
      "text": "ولی فعلا برای خواد هم بستم"
    },
    {
      "id": 77,
      "start": 5600.42,
      "end": 5602.42,
      "formatted_start": "01:33:20.420",
      "formatted_end": "01:33:22.420",
      "text": "خواهد هم تصور و فعالی اتفاق نیفتاده"
    },
    {
      "id": 78,
      "start": 5602.42,
      "end": 5604.42,
      "formatted_start": "01:33:22.420",
      "formatted_end": "01:33:24.420",
      "text": "که خواه شکر خدا"
    },
    {
      "id": 79,
      "start": 5604.42,
      "end": 5606.42,
      "formatted_start": "01:33:24.420",
      "formatted_end": "01:33:26.420",
      "text": "چونه برای خواه اتفاق"
    },
    {
      "id": 80,
      "start": 5606.42,
      "end": 5608.42,
      "formatted_start": "01:33:26.420",
      "formatted_end": "01:33:28.420",
      "text": "خواه تیرویت"
    },
