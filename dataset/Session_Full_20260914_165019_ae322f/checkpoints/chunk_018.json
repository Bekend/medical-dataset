    },
    {
      "id": 47,
      "start": 5536.0,
      "end": 5538.0,
      "formatted_start": "01:32:16.000",
      "formatted_end": "01:32:18.000",
      "text": "من خوابم خوبه"
    },
    {
      "id": 48,
      "start": 5538.0,
      "end": 5539.0,
      "formatted_start": "01:32:18.000",
      "formatted_end": "01:32:19.000",
      "text": "بله"
    },
    {
      "id": 49,
      "start": 5539.0,
      "end": 5541.0,
      "formatted_start": "01:32:19.000",
      "formatted_end": "01:32:21.000",
      "text": "میگم اگه رفتیم رفتیم باید بخورم"
    },
    {
      "id": 50,
      "start": 5541.0,
      "end": 5545.0,
      "formatted_start": "01:32:21.000",
      "formatted_end": "01:32:25.000",
      "text": "این یکی از نعمت های دنیا که آدم سرشو میزاد و به نوعی راحت بخواد"
    },
    {
      "id": 51,
      "start": 5545.0,
      "end": 5547.0,
      "formatted_start": "01:32:25.000",
      "formatted_end": "01:32:27.000",
      "text": "این یکی از نعمت ها هست"
    },
    {
      "id": 52,
      "start": 5547.0,
      "end": 5549.0,
      "formatted_start": "01:32:27.000",
      "formatted_end": "01:32:29.000",
      "text": "من یکی کم همینطوری هستم"
    },
    {
      "id": 53,
      "start": 5549.0,
      "end": 5551.0,
      "formatted_start": "01:32:29.000",
      "formatted_end": "01:32:31.000",
      "text": "وقتی چشم بسته بیشه پیرم دیگه"
    },
    {
      "id": 54,
      "start": 5551.0,
      "end": 5553.0,
      "formatted_start": "01:32:31.000",
      "formatted_end": "01:32:33.000",
      "text": "نه من معمولم"
    },
    {
      "id": 55,
      "start": 5553.0,
      "end": 5554.0,
      "formatted_start": "01:32:33.000",
      "formatted_end": "01:32:34.000",
      "text": "بله خب"
    },
    {
      "id": 56,
      "start": 5554.0,
      "end": 5557.0,
      "formatted_start": "01:32:34.000",
      "formatted_end": "01:32:37.000",
      "text": "بس الان براتون تقریبیتی بریم سمیت اونجا"
    },
    {
      "id": 57,
      "start": 5557.0,
      "end": 5559.0,
      "formatted_start": "01:32:37.000",
      "formatted_end": "01:32:39.000",
      "text": "این تریندم داشته"
    },
    {
      "id": 58,
      "start": 5559.0,
      "end": 5561.0,
      "formatted_start": "01:32:39.000",
      "formatted_end": "01:32:41.000",
      "text": "من کامل نوشتم"
    },
    {
      "id": 59,
      "start": 5561.0,
      "end": 5563.0,
      "formatted_start": "01:32:41.000",
      "formatted_end": "01:32:43.000",
      "text": "کامله کامله"
    },
    {
      "id": 60,
      "start": 5563.0,
      "end": 5567.3,
      "formatted_start": "01:32:43.000",
      "formatted_end": "01:32:47.300",
      "text": "همه چیزون رو میخواد دیگه میخواد بر مدت چک کرده کامل نمیشتن"
    },
    {
      "id": 61,
      "start": 5567.3,
      "end": 5569.46,
      "formatted_start": "01:32:47.300",
      "formatted_end": "01:32:49.460",
      "text": "آه چند دکتر من انجام میدم دیگه"
    },
    {
      "id": 62,
      "start": 5569.46,
      "end": 5571.34,
      "formatted_start": "01:32:49.460",
      "formatted_end": "01:32:51.340",
      "text": "الان یک سال و نیمه نمیخواد"
    },
    {
      "id": 63,
      "start": 5571.34,
      "end": 5573.76,
      "formatted_start": "01:32:51.340",
      "formatted_end": "01:32:53.760",
      "text": "نه قشنگ همه چیزون کامل نمیشتن"
    },
    {
      "id": 64,
      "start": 5573.76,
      "end": 5575.46,
      "formatted_start": "01:32:53.760",
      "formatted_end": "01:32:55.460",
      "text": "چرا از گیرنجا میگم؟"
    },
    {
      "id": 65,
      "start": 5575.46,
      "end": 5576.56,
      "formatted_start": "01:32:55.460",
      "formatted_end": "01:32:56.560",
      "text": "آه تو ریده نه"
    },
    {
      "id": 66,
      "start": 5576.56,
      "end": 5579.46,
      "formatted_start": "01:32:56.560",
      "formatted_end": "01:32:59.460",
      "text": "اصلا این همه دکتر بود که خیلی خطرناک است"
    },
    {
      "id": 67,
      "start": 5579.46,
      "end": 5583.76,
      "formatted_start": "01:32:59.460",
      "formatted_end": "01:33:03.760",
      "text": "خیلی بخت هایی هم دکتر خانه بودن که من این حرف بدم"
    },
    {
      "id": 68,
      "start": 5583.76,
      "end": 5585.3,
      "formatted_start": "01:33:03.760",
      "formatted_end": "01:33:05.300",
      "text": "او خواستن بر سر کار"
    },
    {
