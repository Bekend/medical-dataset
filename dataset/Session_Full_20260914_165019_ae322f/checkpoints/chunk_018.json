  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5430.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:30.000",
      "text": "از اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5433.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:33.000",
      "text": "چار به بالا بودید غیرفعال کردن"
    },
    {
      "id": 2,
      "start": 5433.0,
      "end": 5435.0,
      "formatted_start": "01:30:33.000",
      "formatted_end": "01:30:35.000",
      "text": "و بعد به تدریب"
    },
    {
      "id": 3,
      "start": 5435.0,
      "end": 5438.0,
      "formatted_start": "01:30:35.000",
      "formatted_end": "01:30:38.000",
      "text": "بیمه رسایی شد؟"
    },
    {
      "id": 4,
      "start": 5438.0,
      "end": 5443.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:43.000",
      "text": "به حقای چار به بالا رو غیرفعال کردن که سال شش روان پولید"
    },
    {
      "id": 5,
      "start": 5443.0,
      "end": 5445.0,
      "formatted_start": "01:30:43.000",
      "formatted_end": "01:30:45.000",
      "text": "اما اونجا نداری؟"
    },
    {
      "id": 6,
      "start": 5445.0,
      "end": 5449.0,
      "formatted_start": "01:30:45.000",
      "formatted_end": "01:30:49.000",
      "text": "یک جمهوری اسلامی دیگه دستش داشته جیب مردم میشه از این باری"
    },
    {
      "id": 7,
      "start": 5449.0,
      "end": 5451.0,
      "formatted_start": "01:30:49.000",
      "formatted_end": "01:30:51.000",
      "text": "از اون کتر باید برد؟"
    },
    {
      "id": 8,
      "start": 5451.0,
      "end": 5454.0,
      "formatted_start": "01:30:51.000",
      "formatted_end": "01:30:54.000",
      "text": "اون دفتر رستا دی، مثلا من اون کچه جهاد"
    },
    {
      "id": 9,
      "start": 5454.0,
      "end": 5458.0,
      "formatted_start": "01:30:54.000",
      "formatted_end": "01:30:58.000",
      "text": "آره، اونجا برید پولشون رو بگنم"
    },
    {
      "id": 10,
      "start": 5458.0,
      "end": 5460.0,
      "formatted_start": "01:30:58.000",
      "formatted_end": "01:31:00.000",
      "text": "قند که نداشتی؟"
    },
    {
      "id": 11,
      "start": 5460.0,
      "end": 5462.0,
      "formatted_start": "01:31:00.000",
      "formatted_end": "01:31:02.000",
      "text": "چون؟"
    },
    {
      "id": 12,
      "start": 5462.0,
      "end": 5464.0,
      "formatted_start": "01:31:02.000",
      "formatted_end": "01:31:04.000",
      "text": "قند نداشتی"
    },
    {
      "id": 13,
      "start": 5464.0,
      "end": 5466.0,
      "formatted_start": "01:31:04.000",
      "formatted_end": "01:31:06.000",
      "text": "قند که گرفتیم قند فایل رو کنم"
    },
    {
      "id": 14,
      "start": 5466.0,
      "end": 5468.0,
      "formatted_start": "01:31:06.000",
      "formatted_end": "01:31:08.000",
      "text": "گرفت از اینجا برازومم بود"
    },
    {
      "id": 15,
      "start": 5468.0,
      "end": 5470.0,
      "formatted_start": "01:31:08.000",
      "formatted_end": "01:31:10.000",
      "text": "نه سرچاله افراد خوب بوده"
    },
    {
      "id": 16,
      "start": 5470.0,
      "end": 5472.0,
      "formatted_start": "01:31:10.000",
      "formatted_end": "01:31:12.000",
      "text": "الان من ولی قند مخفیشو چک میکنم"
    },
    {
      "id": 17,
      "start": 5472.0,
      "end": 5474.0,
      "formatted_start": "01:31:12.000",
      "formatted_end": "01:31:14.000",
      "text": "چون شما قند داری"
    },
    {
      "id": 18,
      "start": 5474.0,
      "end": 5476.0,
      "formatted_start": "01:31:14.000",
      "formatted_end": "01:31:16.000",
      "text": "آبجیتر"
    },
    {
      "id": 19,
      "start": 5476.0,
      "end": 5478.0,
      "formatted_start": "01:31:16.000",
      "formatted_end": "01:31:18.000",
      "text": "بعد تحجب میکنم که میگیر کبدشم خیلی چپ بوده"
    },
    {
      "id": 20,
      "start": 5478.0,
      "end": 5480.0,
      "formatted_start": "01:31:18.000",
      "formatted_end": "01:31:20.000",
      "text": "کبدتون؟"
    },
    {
      "id": 21,
      "start": 5480.0,
      "end": 5482.0,
      "formatted_start": "01:31:20.000",
      "formatted_end": "01:31:22.000",
      "text": "کبدن که فیلی بدتون بود"
    },
    {
      "id": 22,
      "start": 5482.0,
      "end": 5484.0,
      "formatted_start": "01:31:22.000",
      "formatted_end": "01:31:24.000",
      "text": "اما واقعا کرونا رو که زدم"
    },
    {
      "id": 23,
      "start": 5484.0,
      "end": 5486.0,
      "formatted_start": "01:31:24.000",
      "formatted_end": "01:31:26.000",
      "text": "یعنی زد دیگه بالا"
    },
    {
      "id": 24,
      "start": 5486.0,
      "end": 5489.0,
      "formatted_start": "01:31:26.000",
      "formatted_end": "01:31:29.000",
      "text": "یعنی نمیدونم فشار میدارم راه میرفتم"
    },
    {
      "id": 25,
      "start": 5489.0,
      "end": 5491.0,
      "formatted_start": "01:31:29.000",
      "formatted_end": "01:31:31.000",
      "text": "و چند شو گفت؟"
    },
    {
      "id": 26,
      "start": 5491.0,
      "end": 5494.0,
      "formatted_start": "01:31:31.000",
      "formatted_end": "01:31:34.000",
      "text": "چندشو من نمیدم گلیشی نرفت"
    },
    {
      "id": 27,
      "start": 5494.0,
      "end": 5496.0,
      "formatted_start": "01:31:34.000",
      "formatted_end": "01:31:36.000",
      "text": "سونو دیگه نرفتی؟"
    },
    {
      "id": 28,
      "start": 5496.0,
      "end": 5498.0,
      "formatted_start": "01:31:36.000",
      "formatted_end": "01:31:38.000",
      "text": "نه سونو نرفتی"
    },
    {
      "id": 29,
      "start": 5498.0,
      "end": 5500.0,
      "formatted_start": "01:31:38.000",
      "formatted_end": "01:31:40.000",
      "text": "سونوگرافی دیگه نرفتی؟"
    },
    {
      "id": 30,
      "start": 5500.0,
      "end": 5502.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:42.000",
      "text": "نه نرفتی"
    },
    {
      "id": 31,
      "start": 5502.0,
      "end": 5505.0,
      "formatted_start": "01:31:42.000",
      "formatted_end": "01:31:45.000",
      "text": "همون سال رفتی سونوگرافی؟ گفتن کبدت چرم شده؟"
    },
    {
      "id": 32,
      "start": 5505.0,
      "end": 5508.0,
      "formatted_start": "01:31:45.000",
      "formatted_end": "01:31:48.000",
      "text": "نه اصلا همجوری آزماشین رو دادن"
    },
    {
      "id": 33,
      "start": 5508.0,
      "end": 5510.0,
      "formatted_start": "01:31:48.000",
      "formatted_end": "01:31:50.000",
      "text": "میگوشتن کبرای اینجور"
    },
    {
      "id": 34,
      "start": 5510.0,
      "end": 5512.0,
      "formatted_start": "01:31:50.000",
      "formatted_end": "01:31:52.000",
      "text": "شب خوب نمیخوابی؟"
    },
    {
      "id": 35,
      "start": 5512.0,
      "end": 5514.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:54.000",
      "text": "خوبه"
    },
    {
      "id": 36,
      "start": 5514.0,
      "end": 5516.0,
      "formatted_start": "01:31:54.000",
      "formatted_end": "01:31:56.000",
      "text": "خوبه"
    },
    {
      "id": 37,
      "start": 5516.0,
      "end": 5518.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:31:58.000",
      "text": "بله"
    },
    {
      "id": 38,
      "start": 5518.0,
      "end": 5520.0,
      "formatted_start": "01:31:58.000",
      "formatted_end": "01:32:00.000",
      "text": "من خوابم خوبه"
    },
    {
      "id": 39,
      "start": 5520.0,
      "end": 5522.0,
      "formatted_start": "01:32:00.000",
      "formatted_end": "01:32:02.000",
      "text": "من خوابم خوبه"
    },
    {
      "id": 40,
      "start": 5522.0,
      "end": 5524.0,
      "formatted_start": "01:32:02.000",
      "formatted_end": "01:32:04.000",
      "text": "من خوابم خوبه"
    },
    {
      "id": 41,
      "start": 5524.0,
      "end": 5526.0,
      "formatted_start": "01:32:04.000",
      "formatted_end": "01:32:06.000",
