      "start": 5608.42,
      "end": 5610.42,
      "formatted_start": "01:33:28.420",
      "formatted_end": "01:33:30.420",
      "text": "تیرویت سرخواد باشه"
    },
    {
      "id": 82,
      "start": 5610.42,
      "end": 5612.42,
      "formatted_start": "01:33:30.420",
      "formatted_end": "01:33:32.420",
      "text": "از برای خواد چیه"
    },
    {
      "id": 83,
      "start": 5612.42,
      "end": 5614.42,
      "formatted_start": "01:33:32.420",
      "formatted_end": "01:33:34.420",
      "text": "سرخواد بودم"
    },
    {
      "id": 84,
      "start": 5614.42,
      "end": 5619.42,
      "formatted_start": "01:33:34.420",
      "formatted_end": "01:33:39.420",
      "text": "این رو هیچ وقت صدا نگردی تیروید رو ندارم"
    },
    {
      "id": 85,
      "start": 5619.42,
      "end": 5623.42,
      "formatted_start": "01:33:39.420",
      "formatted_end": "01:33:43.420",
      "text": "این صدا گرامتی تیروید رو تا انجام بدی خوبه"
    },
    {
      "id": 86,
      "start": 5623.42,
      "end": 5626.42,
      "formatted_start": "01:33:43.420",
      "formatted_end": "01:33:46.420",
      "text": "از اونو که منم سرم شده است"
    },
