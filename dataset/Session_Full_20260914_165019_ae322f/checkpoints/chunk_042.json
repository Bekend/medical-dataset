  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12602.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:02.000",
      "text": "از اینجا باید برات بخورم."
    },
    {
      "id": 1,
      "start": 12603.0,
      "end": 12605.0,
      "formatted_start": "03:30:03.000",
      "formatted_end": "03:30:05.000",
      "text": "خدا هم که الان خیلی ویدیو هستید."
    },
    {
      "id": 2,
      "start": 12605.0,
      "end": 12607.0,
      "formatted_start": "03:30:05.000",
      "formatted_end": "03:30:07.000",
      "text": "آلش بچه باید بیمارستان خواهندن است."
    },
    {
      "id": 3,
      "start": 12607.0,
      "end": 12609.0,
      "formatted_start": "03:30:07.000",
      "formatted_end": "03:30:09.000",
      "text": "ایه که ای؟"
    },
    {
      "id": 4,
      "start": 12609.0,
      "end": 12615.0,
      "formatted_start": "03:30:09.000",
      "formatted_end": "03:30:15.000",
      "text": "افتو باید مشد، از آن خورده بود، شور و ترش، به مینده هستید آلش بچه رو."
    },
    {
      "id": 5,
      "start": 12615.0,
      "end": 12618.0,
      "formatted_start": "03:30:15.000",
      "formatted_end": "03:30:18.000",
      "text": "آه نه دیگه، آخه میدونی اینو فکر میکنن شوخی."
    },
    {
      "id": 6,
      "start": 12618.0,
      "end": 12620.0,
      "formatted_start": "03:30:18.000",
      "formatted_end": "03:30:20.000",
      "text": "هر چی با بهش کنیم نرو بشن کرده"
    },
    {
      "id": 7,
      "start": 12620.0,
      "end": 12624.0,
      "formatted_start": "03:30:20.000",
      "formatted_end": "03:30:24.000",
      "text": "برای برام هر چی بودن نرو با چیزی نتونیست دیگه نرو"
    },
    {
      "id": 8,
      "start": 12624.0,
      "end": 12626.0,
      "formatted_start": "03:30:24.000",
      "formatted_end": "03:30:26.000",
      "text": "تو رئیس ایهتت هست دیگه نرو"
    },
    {
      "id": 9,
      "start": 12626.0,
      "end": 12628.0,
      "formatted_start": "03:30:26.000",
      "formatted_end": "03:30:28.000",
      "text": "خب نه برم اونجا یکم نانو"
    },
    {
      "id": 10,
      "start": 12628.0,
      "end": 12630.0,
      "formatted_start": "03:30:28.000",
      "formatted_end": "03:30:30.000",
      "text": "مثلا"
    },
    {
      "id": 11,
      "start": 12630.0,
      "end": 12632.0,
      "formatted_start": "03:30:30.000",
      "formatted_end": "03:30:32.000",
      "text": "اینکن هم نبو خورا ولی بازم را زیادش کردم"
    },
    {
      "id": 12,
      "start": 12632.0,
      "end": 12636.0,
      "formatted_start": "03:30:32.000",
      "formatted_end": "03:30:36.000",
      "text": "بابا اون غذاهای بیرون اصلا شمکنه ها نمیتونیم بخوریم"
    },
    {
      "id": 13,
      "start": 12636.0,
      "end": 12642.0,
      "formatted_start": "03:30:36.000",
      "formatted_end": "03:30:42.000",
      "text": "من خودم دیگه انقدر تو خونم غذا بینمه کردم که اصلا دیگه بیرون هیچ ریستوران نمیشم ازو خورم"
    },
    {
      "id": 14,
      "start": 12642.0,
      "end": 12646.5,
      "formatted_start": "03:30:42.000",
      "formatted_end": "03:30:46.500",
      "text": "اینجور همه هنگ کرده با این داداشو و رفتند نداشت خواهان نداشت"
    },
    {
      "id": 15,
      "start": 12646.5,
      "end": 12652.5,
      "formatted_start": "03:30:46.500",
      "formatted_end": "03:30:52.500",
      "text": "اون دوتا پایزه بستره که بابا قلبش ۱۰ درصد میزنه یعنی کار خیلی فصل میزنه"
    },
    {
      "id": 16,
      "start": 12652.5,
      "end": 12657.5,
      "formatted_start": "03:30:52.500",
      "formatted_end": "03:30:57.500",
      "text": "قلبش کنم نبود یه ۱۰۰ راقصن داشت و نمیزن راست میاد"
    },
    {
      "id": 17,
      "start": 12657.5,
      "end": 12663.0,
      "formatted_start": "03:30:57.500",
      "formatted_end": "03:31:03.000",
      "text": "اینجور نمیگم شاید اما داداشم اصلا هیچی نمال مادر نمال پدر نمیگم"
    },
    {
      "id": 18,
      "start": 12663.0,
      "end": 12664.0,
      "formatted_start": "03:31:03.000",
      "formatted_end": "03:31:04.000",
      "text": "اون راه چما خواستند؟"
    },
    {
      "id": 19,
      "start": 12664.0,
      "end": 12666.0,
      "formatted_start": "03:31:04.000",
      "formatted_end": "03:31:06.000",
      "text": "فقط خودشون ده تا مدام بودم"
    },
    {
      "id": 20,
      "start": 12666.0,
      "end": 12669.0,
      "formatted_start": "03:31:06.000",
      "formatted_end": "03:31:09.000",
      "text": "خیلی نه با پدر مادر مام دارم"
    },
    {
      "id": 21,
      "start": 12669.0,
      "end": 12671.0,
      "formatted_start": "03:31:09.000",
      "formatted_end": "03:31:11.000",
      "text": "این داداش از چون که خیلی..."
    },
    {
      "id": 22,
      "start": 12671.0,
      "end": 12675.0,
      "formatted_start": "03:31:11.000",
      "formatted_end": "03:31:15.000",
      "text": "اصلا اگه پدرم مریض باشه شاید تا صبح نرسدش میشه فقط نگاهش بکنه"
    },
    {
      "id": 23,
      "start": 12675.0,
      "end": 12678.0,
      "formatted_start": "03:31:15.000",
      "formatted_end": "03:31:18.000",
      "text": "این اصلا تا باباته یه کمچه میشه دریافت میکنه"
    },
    {
      "id": 24,
      "start": 12678.0,
      "end": 12681.0,
      "formatted_start": "03:31:18.000",
      "formatted_end": "03:31:21.000",
      "text": "خیلی بخواهید یکی باز به مادر هوا با واسه"
    },
    {
      "id": 25,
      "start": 12681.0,
      "end": 12684.0,
      "formatted_start": "03:31:21.000",
      "formatted_end": "03:31:24.000",
      "text": "همچنین به شما همه کار خودشون نخوره"
    },
    {
      "id": 26,
      "start": 12684.0,
      "end": 12686.0,
      "formatted_start": "03:31:24.000",
      "formatted_end": "03:31:26.000",
      "text": "نه اصلا همه کار خودشون"
    },
    {
      "id": 27,
      "start": 12686.0,
      "end": 12688.0,
      "formatted_start": "03:31:26.000",
      "formatted_end": "03:31:28.000",
      "text": "خدا خیلی خوب بشه"
    },
    {
      "id": 28,
      "start": 12688.0,
      "end": 12690.0,
      "formatted_start": "03:31:28.000",
      "formatted_end": "03:31:30.000",
      "text": "خدا بیده هدف هموشم کنه"
    },
    {
      "id": 29,
      "start": 12690.0,
      "end": 12691.0,
      "formatted_start": "03:31:30.000",
      "formatted_end": "03:31:31.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 30,
      "start": 12691.0,
      "end": 12694.0,
      "formatted_start": "03:31:31.000",
      "formatted_end": "03:31:34.000",
      "text": "چون شوهر داریم شوهرم شاید بزرگ شاید نزدن"
    },
    {
      "id": 31,
      "start": 12694.0,
      "end": 12700.0,
      "formatted_start": "03:31:34.000",
      "formatted_end": "03:31:40.000",
      "text": "بابا خدا خیلی شما من اصلا همیشه بچه ها میگم که چقدر این ها به درمودنش احترام کنن"
    },
    {
      "id": 32,
      "start": 12700.0,
      "end": 12702.0,
      "formatted_start": "03:31:40.000",
      "formatted_end": "03:31:42.000",
      "text": "چشماشون"
    },
    {
      "id": 33,
      "start": 12702.0,
      "end": 12704.0,
      "formatted_start": "03:31:42.000",
      "formatted_end": "03:31:44.000",
      "text": "چهارتوشون هم جو خوبن"
    },
    {
      "id": 34,
      "start": 12704.0,
      "end": 12705.0,
      "formatted_start": "03:31:44.000",
      "formatted_end": "03:31:45.000",
      "text": "خدا بشم"
    },
    {
      "id": 35,
      "start": 12705.0,
      "end": 12710.0,
      "formatted_start": "03:31:45.000",
      "formatted_end": "03:31:50.000",
      "text": "البته این مون حلال به نظرم خیلی مهم که در این زمین خیلی مردم بزرگه"
    },
    {
      "id": 36,
      "start": 12710.0,
      "end": 12713.0,
      "formatted_start": "03:31:50.000",
      "formatted_end": "03:31:53.000",
      "text": "بعضی آدم هم بزرگه"
    },
    {
      "id": 37,
      "start": 12713.0,
      "end": 12715.0,
      "formatted_start": "03:31:53.000",
      "formatted_end": "03:31:55.000",
      "text": "انشانه که سبیر ساله بشن"
    },
    {
      "id": 38,
      "start": 12715.0,
      "end": 12717.0,
      "formatted_start": "03:31:55.000",
      "formatted_end": "03:31:57.000",
      "text": "پدرم خودتون ماشور بسرایه"
    },
    {
      "id": 39,
      "start": 12717.0,
      "end": 12719.0,
      "formatted_start": "03:31:57.000",
      "formatted_end": "03:31:59.000",
      "text": "دخترها رو یک چیز برای بسر"
    },
    {
      "id": 40,
      "start": 12719.0,
      "end": 12721.0,
      "formatted_start": "03:31:59.000",
      "formatted_end": "03:32:01.000",
      "text": "مادرم پدرم بهترون بسری هست"
    },
    {
      "id": 41,
      "start": 12721.0,
      "end": 12723.0,
      "formatted_start": "03:32:01.000",
      "formatted_end": "03:32:03.000",
      "text": "پیرانی هست"
    },
    {
      "id": 42,
      "start": 12723.0,
      "end": 12725.0,
      "formatted_start": "03:32:03.000",
      "formatted_end": "03:32:05.000",
      "text": "پیرانی هست"
    },
    {
      "id": 43,
      "start": 12725.0,
      "end": 12727.0,
      "formatted_start": "03:32:05.000",
      "formatted_end": "03:32:07.000",
      "text": "ما راضیم خدا اشتراک باشه"
    },
    {
      "id": 44,
      "start": 12729.0,
      "end": 12731.0,
      "formatted_start": "03:32:09.000",
      "formatted_end": "03:32:11.000",
      "text": "اما حتی سوالم کسانی هست"
    },
    {
      "id": 45,
      "start": 12731.0,
      "end": 12733.0,
      "formatted_start": "03:32:11.000",
      "formatted_end": "03:32:13.000",
      "text": "پیرانی ها البته تو بودیم"
    },
    {
      "id": 46,
      "start": 12733.0,
      "end": 12735.0,
      "formatted_start": "03:32:13.000",
      "formatted_end": "03:32:15.000",
      "text": "من یادمم پدرتون"
    },
    {
      "id": 47,
      "start": 12735.0,
      "end": 12737.0,
      "formatted_start": "03:32:15.000",
      "formatted_end": "03:32:17.000",
      "text": "یه بار اینجا اومد"
    },
    {
      "id": 48,
      "start": 12737.0,
      "end": 12739.0,
      "formatted_start": "03:32:17.000",
      "formatted_end": "03:32:19.000",
      "text": "پدرتون که اینقدر قربی و دیگه"
    },
    {
      "id": 49,
      "start": 12739.0,
      "end": 12741.0,
      "formatted_start": "03:32:19.000",
      "formatted_end": "03:32:21.000",
      "text": "خمی به عبرو نمیگه"
    },
    {
      "id": 50,
      "start": 12741.0,
      "end": 12743.0,
      "formatted_start": "03:32:21.000",
      "formatted_end": "03:32:23.000",
      "text": "یه بار که اومد باشه"
    },
    {
      "id": 51,
      "start": 12743.0,
      "end": 12746.0,
      "formatted_start": "03:32:23.000",
      "formatted_end": "03:32:26.000",
      "text": "تا اومد حق بزنه روزش ترکیب"
    },
    {
      "id": 52,
      "start": 12746.0,
      "end": 12748.0,
      "formatted_start": "03:32:26.000",
      "formatted_end": "03:32:28.000",
      "text": "کرده این شب خودم را جیش کرده"
    },
    {
      "id": 53,
      "start": 12748.0,
      "end": 12750.0,
      "formatted_start": "03:32:28.000",
      "formatted_end": "03:32:30.000",
      "text": "یک دختر هم خواهد بکنه"
    },
    {
      "id": 54,
      "start": 12750.0,
      "end": 12752.0,
      "formatted_start": "03:32:30.000",
      "formatted_end": "03:32:32.000",
      "text": "دختر هم خواهد بکنه؟"
    },
    {
      "id": 55,
      "start": 12752.0,
      "end": 12754.0,
      "formatted_start": "03:32:32.000",
      "formatted_end": "03:32:34.000",
      "text": "آره اصلا تهمون نداشت"
    },
    {
      "id": 56,
      "start": 12754.0,
      "end": 12756.0,
      "formatted_start": "03:32:34.000",
      "formatted_end": "03:32:36.000",
      "text": "سرم درد نیست سرم درد نیست"
    },
    {
      "id": 57,
      "start": 12756.0,
      "end": 12759.0,
      "formatted_start": "03:32:36.000",
      "formatted_end": "03:32:39.000",
      "text": "اینجا نیست داربا به کلمه ماره نمی آداد"
    },
    {
      "id": 58,
      "start": 12759.0,
      "end": 12763.0,
      "formatted_start": "03:32:39.000",
      "formatted_end": "03:32:43.000",
      "text": "آره دیگه اونگنی پدر مادر نیست"
    },
    {
      "id": 59,
      "start": 12763.0,
      "end": 12765.0,
      "formatted_start": "03:32:43.000",
      "formatted_end": "03:32:45.000",
      "text": "اینقدر گریه کرد که آخر من رفتم"
    },
    {
      "id": 60,
      "start": 12765.0,
      "end": 12767.0,
      "formatted_start": "03:32:45.000",
      "formatted_end": "03:32:47.000",
      "text": "مشهر رو سر خوهره با استان"
    },
    {
      "id": 61,
      "start": 12767.0,
      "end": 12769.0,
      "formatted_start": "03:32:47.000",
      "formatted_end": "03:32:49.000",
      "text": "تو پدر وارد شد"
    },
    {
      "id": 62,
      "start": 12769.0,
      "end": 12771.0,
      "formatted_start": "03:32:49.000",
      "formatted_end": "03:32:51.000",
      "text": "خودتان مرخوا دارند، دیش بسیار"
    },
    {
      "id": 63,
      "start": 12771.0,
      "end": 12773.0,
      "formatted_start": "03:32:51.000",
      "formatted_end": "03:32:53.000",
      "text": "آره، آسان"
    },
    {
      "id": 64,
      "start": 12778.0,
      "end": 12780.0,
      "formatted_start": "03:32:58.000",
      "formatted_end": "03:33:00.000",
      "text": "شبینه مطابق بزرگ دارند"
    },
    {
      "id": 65,
      "start": 12780.0,
      "end": 12783.0,
      "formatted_start": "03:33:00.000",
      "formatted_end": "03:33:03.000",
      "text": "بله، دراصل داریم و موضوع شده"
    },
    {
      "id": 66,
      "start": 12788.0,
      "end": 12792.0,
      "formatted_start": "03:33:08.000",
      "formatted_end": "03:33:12.000",
      "text": "در این حال همه درمه بیرون دارند، در این حال باید یاد آنها باید فرقی برنم"
    },
    {
      "id": 67,
      "start": 12792.0,
      "end": 12794.0,
      "formatted_start": "03:33:12.000",
      "formatted_end": "03:33:14.000",
      "text": "چون یه بگیر همه درمه درمه سر آن"
    },
    {
      "id": 68,
      "start": 12794.0,
      "end": 12822.0,
      "formatted_start": "03:33:14.000",
      "formatted_end": "03:33:42.000",
      "text": "موسیقی"
    },
    {
      "id": 69,
      "start": 12824.0,
      "end": 12825.0,
      "formatted_start": "03:33:44.000",
      "formatted_end": "03:33:45.000",
      "text": "بچه هم فهمید؟"
    },
    {
      "id": 70,
      "start": 12825.0,
      "end": 12826.0,
      "formatted_start": "03:33:45.000",
      "formatted_end": "03:33:46.000",
      "text": "نه، ما خودمون"
    },
    {
      "id": 71,
      "start": 12827.0,
      "end": 12830.0,
      "formatted_start": "03:33:47.000",
      "formatted_end": "03:33:50.000",
      "text": "ما سنگیدید توستیم و اگه نه، چرا؟"
    },
    {
      "id": 72,
      "start": 12830.0,
      "end": 12833.0,
      "formatted_start": "03:33:50.000",
      "formatted_end": "03:33:53.000",
      "text": "چرا؟ نریفه این یاد دیگه دیگه داره جمعه بباشه"
    },
    {
      "id": 73,
      "start": 12834.0,
      "end": 12836.0,
      "formatted_start": "03:33:54.000",
      "formatted_end": "03:33:56.000",
      "text": "نه، الان دارستون رو در زمانه برنده بید"
    },
    {
      "id": 74,
      "start": 12836.0,
      "end": 12837.0,
      "formatted_start": "03:33:56.000",
      "formatted_end": "03:33:57.000",
      "text": "که ما قرضو تشکیل داشتیم"
    },
    {
      "id": 75,
      "start": 12837.0,
      "end": 12838.0,
      "formatted_start": "03:33:57.000",
      "formatted_end": "03:33:58.000",
      "text": "آبولا تو نمیره بشتن"
    },
    {
      "id": 76,
      "start": 12838.0,
      "end": 12840.0,
      "formatted_start": "03:33:58.000",
      "formatted_end": "03:34:00.000",
      "text": "قرضو ها رو بزنم"
    },
    {
      "id": 77,
      "start": 12840.0,
      "end": 12842.0,
      "formatted_start": "03:34:00.000",
      "formatted_end": "03:34:02.000",
      "text": "آره، باشه، مونه باشه"
    },
    {
      "id": 78,
      "start": 12842.0,
      "end": 12843.0,
      "formatted_start": "03:34:02.000",
      "formatted_end": "03:34:03.000",
      "text": "چون فرهنگی نه؟"
    },
    {
      "id": 79,
      "start": 12843.0,
      "end": 12845.0,
      "formatted_start": "03:34:03.000",
      "formatted_end": "03:34:05.000",
      "text": "آره، خدای خدای خدای خدای"
    },
    {
      "id": 80,
      "start": 12845.0,
      "end": 12847.0,
      "formatted_start": "03:34:05.000",
      "formatted_end": "03:34:07.000",
      "text": "ما خودمون از دست هم میزنم، آب"
    },
    {
      "id": 81,
      "start": 12847.0,
      "end": 12849.0,
      "formatted_start": "03:34:07.000",
      "formatted_end": "03:34:09.000",
      "text": "خودم تا آن پول نمیزنم"
    },
    {
      "id": 82,
      "start": 12849.0,
      "end": 12851.0,
      "formatted_start": "03:34:09.000",
      "formatted_end": "03:34:11.000",
      "text": "خودم تا آن پول نمیزنم"
    },
    {
      "id": 83,
      "start": 12851.0,
      "end": 12853.0,
      "formatted_start": "03:34:11.000",
      "formatted_end": "03:34:13.000",
      "text": "حالا تا جهب آزمایشتون کنم"
    },
    {
      "id": 84,
      "start": 12853.0,
      "end": 12855.0,
      "formatted_start": "03:34:13.000",
      "formatted_end": "03:34:15.000",
      "text": "حالا تا جهب آزمایشتون کنم"
    },
    {
      "id": 85,
      "start": 12855.0,
      "end": 12857.0,
