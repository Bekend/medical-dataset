  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12304.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:04.000",
      "text": "این گلز میگرفته و این باز باید تایید چون عوض میشه."
    },
    {
      "id": 1,
      "start": 12313.0,
      "end": 12315.0,
      "formatted_start": "03:25:13.000",
      "formatted_end": "03:25:15.000",
      "text": "که این ردگیر رو باز ببریم یه نامیدیم."
    },
    {
      "id": 2,
      "start": 12316.0,
      "end": 12320.0,
      "formatted_start": "03:25:16.000",
      "formatted_end": "03:25:20.000",
      "text": "هر طور. دیگه برگ زحمتتون از خان شفاره میگیریم بگیم برگ بیمار سلامت بده."
    },
    {
      "id": 3,
      "start": 12321.0,
      "end": 12322.0,
      "formatted_start": "03:25:21.000",
      "formatted_end": "03:25:22.000",
      "text": "میگم بیا؟"
    },
    {
      "id": 4,
      "start": 12322.0,
      "end": 12324.0,
      "formatted_start": "03:25:22.000",
      "formatted_end": "03:25:24.000",
      "text": "آره بگیم بیا رو پود کنم."
    },
    {
      "id": 5,
      "start": 12330.0,
      "end": 12350.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:50.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 12350.0,
      "end": 12356.0,
      "formatted_start": "03:25:50.000",
      "formatted_end": "03:25:56.000",
      "text": "اینجا نمیدونید. ما این سوزه را بگیم. اینجا باید بگیم."
    },
    {
      "id": 7,
      "start": 12356.0,
      "end": 12358.0,
      "formatted_start": "03:25:56.000",
      "formatted_end": "03:25:58.000",
      "text": "نه. نمیدونید."
    },
    {
      "id": 8,
      "start": 12358.0,
      "end": 12360.0,
      "formatted_start": "03:25:58.000",
      "formatted_end": "03:26:00.000",
      "text": "اینجا باید بگیم."
    },
    {
      "id": 9,
      "start": 12360.0,
      "end": 12362.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:02.000",
      "text": "نه."
    },
    {
      "id": 10,
      "start": 12362.0,
      "end": 12364.0,
      "formatted_start": "03:26:02.000",
      "formatted_end": "03:26:04.000",
      "text": "نه."
    },
    {
      "id": 11,
      "start": 12364.0,
      "end": 12366.0,
      "formatted_start": "03:26:04.000",
      "formatted_end": "03:26:06.000",
      "text": "نه."
    },
    {
      "id": 12,
      "start": 12366.0,
      "end": 12368.0,
      "formatted_start": "03:26:06.000",
      "formatted_end": "03:26:08.000",
      "text": "نه."
    },
    {
      "id": 13,
      "start": 12368.0,
      "end": 12370.0,
      "formatted_start": "03:26:08.000",
      "formatted_end": "03:26:10.000",
      "text": "نه."
    },
    {
      "id": 14,
      "start": 12370.0,
      "end": 12372.0,
      "formatted_start": "03:26:10.000",
      "formatted_end": "03:26:12.000",
      "text": "نه."
    },
    {
      "id": 15,
      "start": 12372.0,
      "end": 12374.0,
      "formatted_start": "03:26:12.000",
      "formatted_end": "03:26:14.000",
      "text": "نه."
    },
    {
      "id": 16,
      "start": 12374.0,
      "end": 12376.0,
      "formatted_start": "03:26:14.000",
      "formatted_end": "03:26:16.000",
      "text": "نه."
    },
    {
      "id": 17,
      "start": 12376.0,
      "end": 12380.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:20.000",
      "text": "سوزش کف پاشم مال غنده"
    },
    {
      "id": 18,
      "start": 12380.0,
      "end": 12382.0,
      "formatted_start": "03:26:20.000",
      "formatted_end": "03:26:22.000",
      "text": "دیگه موروپالیتیه اونو فرور داره"
    },
    {
      "id": 19,
      "start": 12382.0,
      "end": 12385.0,
      "formatted_start": "03:26:22.000",
      "formatted_end": "03:26:25.000",
      "text": "بعد مثلا به دواز دهنم دارن"
    },
    {
      "id": 20,
      "start": 12385.0,
      "end": 12386.0,
      "formatted_start": "03:26:25.000",
      "formatted_end": "03:26:26.000",
      "text": "مونستن، منگلسیون، دیگه مونستن"
    },
    {
      "id": 21,
      "start": 12386.0,
      "end": 12389.0,
      "formatted_start": "03:26:26.000",
      "formatted_end": "03:26:29.000",
      "text": "میتوانم به یک نه چیزه یکی کم"
    },
    {
      "id": 22,
      "start": 12389.0,
      "end": 12393.0,
      "formatted_start": "03:26:29.000",
      "formatted_end": "03:26:33.000",
      "text": "در از اندارو پاشم کف پاشی"
    },
    {
      "id": 23,
      "start": 12393.0,
      "end": 12395.0,
      "formatted_start": "03:26:33.000",
      "formatted_end": "03:26:35.000",
      "text": "کف پاشی؟ بله"
    },
    {
      "id": 24,
      "start": 12395.0,
      "end": 12396.0,
      "formatted_start": "03:26:35.000",
      "formatted_end": "03:26:36.000",
      "text": "بیتاملیشون خواهی نه"
    },
    {
      "id": 25,
      "start": 12396.0,
      "end": 12398.0,
      "formatted_start": "03:26:36.000",
      "formatted_end": "03:26:38.000",
      "text": "کلسیوم میخوره مامانتون؟"
    },
    {
      "id": 26,
      "start": 12398.0,
      "end": 12400.0,
      "formatted_start": "03:26:38.000",
      "formatted_end": "03:26:40.000",
      "text": "کلسیوم نمیخوره نه"
    },
    {
      "id": 27,
      "start": 12400.0,
      "end": 12401.0,
      "formatted_start": "03:26:40.000",
      "formatted_end": "03:26:41.000",
      "text": "دانشان خواهد دارن"
    },
    {
      "id": 28,
      "start": 12401.0,
      "end": 12404.0,
      "formatted_start": "03:26:41.000",
      "formatted_end": "03:26:44.000",
      "text": "خواهد کلسیوم دیگه توی شکرمش کار میکنن"
    },
    {
      "id": 29,
      "start": 12404.0,
      "end": 12406.9,
      "formatted_start": "03:26:44.000",
      "formatted_end": "03:26:46.900",
      "text": "آره مشکلی که نداره"
    },
    {
