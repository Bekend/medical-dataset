      "text": "از اینجا باید برداریم که این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از ا"
    },
    {
      "id": 2,
      "start": 15660.0,
      "end": 15662.0,
      "formatted_start": "04:21:00.000",
      "formatted_end": "04:21:02.000",
      "text": "اینجوری داریم"
    },
    {
      "id": 3,
      "start": 15667.68,
      "end": 15669.68,
      "formatted_start": "04:21:07.680",
      "formatted_end": "04:21:09.680",
      "text": "من این رو روشتون"
    },
    {
      "id": 4,
      "start": 15672.8,
      "end": 15674.8,
      "formatted_start": "04:21:12.800",
      "formatted_end": "04:21:14.800",
      "text": "اوه، سنگل شکل"
    },
    {
      "id": 5,
      "start": 15690.0,
      "end": 15720.0,
      "formatted_start": "04:21:30.000",
      "formatted_end": "04:22:00.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا ب"
    },
    {
      "id": 6,
      "start": 15720.0,
      "end": 15750.0,
      "formatted_start": "04:22:00.000",
      "formatted_end": "04:22:30.000",
      "text": "۵۵۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰"
    },
    {
      "id": 7,
      "start": 15750.0,
      "end": 15780.0,
      "formatted_start": "04:22:30.000",
      "formatted_end": "04:23:00.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 8,
      "start": 15780.0,
      "end": 15782.0,
      "formatted_start": "04:23:00.000",
      "formatted_end": "04:23:02.000",
      "text": "آسپرین به اضافه اینه"
    },
    {
      "id": 9,
      "start": 15782.0,
      "end": 15784.0,
      "formatted_start": "04:23:02.000",
      "formatted_end": "04:23:04.000",
      "text": "این دو غرسه"
    },
    {
      "id": 10,
      "start": 15784.0,
      "end": 15786.0,
      "formatted_start": "04:23:04.000",
      "formatted_end": "04:23:06.000",
      "text": "این به اضافه آسپرین"
    },
    {
      "id": 11,
      "start": 15786.0,
      "end": 15788.0,
      "formatted_start": "04:23:06.000",
      "formatted_end": "04:23:08.000",
      "text": "میشه این"
    },
    {
      "id": 12,
      "start": 15788.0,
      "end": 15790.0,
      "formatted_start": "04:23:08.000",
      "formatted_end": "04:23:10.000",
      "text": "این آسپرین نداره نه این"
    },
    {
      "id": 13,
      "start": 15790.0,
      "end": 15792.0,
      "formatted_start": "04:23:10.000",
      "formatted_end": "04:23:12.000",
      "text": "نه این اسمش از اوسویکس"
    },
    {
      "id": 14,
      "start": 15792.0,
      "end": 15794.0,
      "formatted_start": "04:23:12.000",
      "formatted_end": "04:23:14.000",
      "text": "این هم اوسویکس داره هم آسپرین داره"
    },
    {
      "id": 15,
      "start": 15794.0,
      "end": 15796.0,
      "formatted_start": "04:23:14.000",
      "formatted_end": "04:23:16.000",
      "text": "شما آسپرین هم میخوردی؟"
    },
    {
      "id": 16,
      "start": 15796.0,
      "end": 15798.0,
      "formatted_start": "04:23:16.000",
      "formatted_end": "04:23:18.000",
      "text": "آره"
    },
    {
      "id": 17,
      "start": 15798.0,
      "end": 15800.0,
      "formatted_start": "04:23:18.000",
      "formatted_end": "04:23:20.000",
      "text": "خب دیگه الان همین چند روز خوردی؟"
    },
    {
      "id": 18,
      "start": 15800.0,
      "end": 15802.0,
      "formatted_start": "04:23:20.000",
      "formatted_end": "04:23:22.000",
      "text": "این فقط من یه دانه خوردم"
    },
    {
      "id": 19,
      "start": 15802.0,
      "end": 15804.0,
      "formatted_start": "04:23:22.000",
      "formatted_end": "04:23:24.000",
      "text": "خب ترسیدم سمینا با نشون برم"
    },
    {
      "id": 20,
      "start": 15804.0,
      "end": 15806.0,
      "formatted_start": "04:23:24.000",
      "formatted_end": "04:23:26.000",
      "text": "آسپرینو نخور همه یکیو بخور"
    },
    {
      "id": 21,
      "start": 15806.0,
      "end": 15808.0,
      "formatted_start": "04:23:26.000",
      "formatted_end": "04:23:28.000",
      "text": "میشه اینو آسپرین"
    },
    {
      "id": 22,
      "start": 15808.0,
      "end": 15810.0,
      "formatted_start": "04:23:28.000",
      "formatted_end": "04:23:30.000",
      "text": "این اصلا ندارن، برسان تمام شده"
    },
    {
      "id": 23,
      "start": 15810.0,
      "end": 15812.0,
      "formatted_start": "04:23:30.000",
      "formatted_end": "04:23:32.000",
      "text": "خب، الان پشارم همون داره"
    },
    {
      "id": 24,
      "start": 15812.0,
      "end": 15816.0,
      "formatted_start": "04:23:32.000",
      "formatted_end": "04:23:36.000",
      "text": "اینم از شهرود، بیمارستان شهرود خوب بسته بیرون دارن"
    },
    {
      "id": 25,
      "start": 15816.0,
      "end": 15818.0,
      "formatted_start": "04:23:36.000",
      "formatted_end": "04:23:38.000",
      "text": "از شهرود اینو بردار، اینو داریم"
    },
    {
      "id": 26,
      "start": 15818.0,
      "end": 15820.0,
      "formatted_start": "04:23:38.000",
      "formatted_end": "04:23:40.000",
      "text": "آزاد دارستم همه"
    },
    {
      "id": 27,
      "start": 15820.0,
      "end": 15824.0,
      "formatted_start": "04:23:40.000",
      "formatted_end": "04:23:44.000",
      "text": "اینو دارم که دکتر و کلی هم نویشت"
    },
    {
      "id": 28,
      "start": 15824.0,
      "end": 15826.0,
      "formatted_start": "04:23:44.000",
      "formatted_end": "04:23:46.000",
      "text": "یک بسته اینجا دادم"
    },
    {
      "id": 29,
      "start": 15826.0,
      "end": 15828.0,
      "formatted_start": "04:23:46.000",
      "formatted_end": "04:23:48.000",
      "text": "الان همه جا هم میرون"
    },
    {
      "id": 30,
      "start": 15828.0,
      "end": 15832.0,
      "formatted_start": "04:23:48.000",
      "formatted_end": "04:23:52.000",
      "text": "از سی تا یک، ده تایی دادم"
    },
    {
      "id": 31,
      "start": 15832.0,
      "end": 15836.0,
      "formatted_start": "04:23:52.000",
      "formatted_end": "04:23:56.000",
      "text": "الان من همین ها رو میرونستم"
    },
    {
      "id": 32,
      "start": 15836.0,
      "end": 15838.0,
      "formatted_start": "04:23:56.000",
      "formatted_end": "04:23:58.000",
      "text": "من همین ها رو میرونستم"
    },
    {
      "id": 33,
      "start": 15838.0,
      "end": 15840.0,
      "formatted_start": "04:23:58.000",
      "formatted_end": "04:24:00.000",
      "text": "در ته هم بده باز خانه مانده"
    },
    {
      "id": 34,
      "start": 15840.0,
      "end": 15842.0,
      "formatted_start": "04:24:00.000",
      "formatted_end": "04:24:02.000",
      "text": "آره دقیقا بردم"
    },
    {
      "id": 35,
      "start": 15842.0,
      "end": 15844.0,
      "formatted_start": "04:24:02.000",
      "formatted_end": "04:24:04.000",
      "text": "از اونی که باید بیافتم"
    },
    {
      "id": 36,
      "start": 15844.0,
      "end": 15846.0,
      "formatted_start": "04:24:04.000",
      "formatted_end": "04:24:06.000",
      "text": "اگر پیدا نشد"
    },
    {
      "id": 37,
      "start": 15846.0,
      "end": 15848.0,
      "formatted_start": "04:24:06.000",
      "formatted_end": "04:24:08.000",
      "text": "که دیگه باز همین ها بخور"
    },
    {
      "id": 38,
      "start": 15848.0,
      "end": 15850.0,
      "formatted_start": "04:24:08.000",
      "formatted_end": "04:24:10.000",
      "text": "آسپرین وقتی اینو میخوری آسپرین نخور"
    },
    {
      "id": 39,
      "start": 15850.0,
      "end": 15852.0,
      "formatted_start": "04:24:10.000",
      "formatted_end": "04:24:12.000",
      "text": "آسپرین نخور بردم"
    },
    {
      "id": 40,
      "start": 15852.0,
      "end": 15854.0,
      "formatted_start": "04:24:12.000",
      "formatted_end": "04:24:14.000",
      "text": "الان آسپرین هم ندارن"
    },
    {
      "id": 41,
      "start": 15854.0,
      "end": 15856.0,
      "formatted_start": "04:24:14.000",
      "formatted_end": "04:24:16.000",
      "text": "بعد گرس میدم هم"
    },
    {
      "id": 42,
      "start": 15856.0,
      "end": 15858.0,
      "formatted_start": "04:24:16.000",
      "formatted_end": "04:24:18.000",
      "text": "تمام کردم"
    },
    {
      "id": 43,
      "start": 15858.0,
      "end": 15860.0,
      "formatted_start": "04:24:18.000",
      "formatted_end": "04:24:20.000",
      "text": "آشتایی و آن سبزهایی که دادی به"
    },
    {
      "id": 44,
      "start": 15860.0,
      "end": 15862.0,
      "formatted_start": "04:24:20.000",
      "formatted_end": "04:24:22.000",
      "text": "اونو تمام شد"
    },
    {
      "id": 45,
      "start": 15862.0,
      "end": 15864.0,
      "formatted_start": "04:24:22.000",
      "formatted_end": "04:24:24.000",
      "text": "چون اینجوری میدم فرمودتون اینطوری طوری میشه شب"
    },
    {
      "id": 46,
      "start": 15866.0,
      "end": 15868.0,
      "formatted_start": "04:24:26.000",
      "formatted_end": "04:24:28.000",
      "text": "سبز ریزا؟"
    },
    {
      "id": 47,
      "start": 15868.0,
      "end": 15872.0,
      "formatted_start": "04:24:28.000",
      "formatted_end": "04:24:32.000",
      "text": "آره آره، سبز ریزا و با همون، این هم شیشه ای هاشو میخورند"
    },
    {
      "id": 48,
      "start": 15872.0,
      "end": 15877.0,
      "formatted_start": "04:24:32.000",
      "formatted_end": "04:24:37.000",
      "text": "و اون قرص هایی که میدهیم مثلا تکسولیه چیه، اونا عذیب هم منده"
    },
    {
      "id": 49,
      "start": 15877.0,
      "end": 15881.0,
      "formatted_start": "04:24:37.000",
      "formatted_end": "04:24:41.000",
      "text": "اصلا میدن، هیچ کاری ندهیم، چون درد هم منه میدن"
    },
    {
      "id": 50,
      "start": 15881.0,
      "end": 15883.0,
      "formatted_start": "04:24:41.000",
      "formatted_end": "04:24:43.000",
      "text": "قرص مهده ها شیشه میخورید؟"
    },
    {
      "id": 51,
      "start": 15883.0,
      "end": 15885.0,
      "formatted_start": "04:24:43.000",
      "formatted_end": "04:24:45.000",
      "text": "آره شیشه ای ها"
    },
    {
      "id": 52,
      "start": 15885.0,
      "end": 15888.0,
      "formatted_start": "04:24:45.000",
      "formatted_end": "04:24:48.000",
      "text": "پنتپرازول شیشه ای هست دوباره"
    },
    {
      "id": 53,
      "start": 15888.0,
      "end": 15890.0,
      "formatted_start": "04:24:48.000",
      "formatted_end": "04:24:50.000",
      "text": "شیشه ای اومپرازوله"
    },
    {
      "id": 54,
      "start": 15890.0,
      "end": 15891.0,
      "formatted_start": "04:24:50.000",
      "formatted_end": "04:24:51.000",
      "text": "اومپرازوله، پنتپرازوله"
    },
    {
      "id": 55,
      "start": 15891.0,
      "end": 15895.0,
      "formatted_start": "04:24:51.000",
      "formatted_end": "04:24:55.000",
      "text": "برقی ها نمی سازن"
    },
    {
      "id": 56,
      "start": 15895.0,
      "end": 15897.0,
      "formatted_start": "04:24:55.000",
      "formatted_end": "04:24:57.000",
      "text": "هرکی یه جوره"
    },
    {
      "id": 57,
      "start": 15897.0,
      "end": 15899.0,
      "formatted_start": "04:24:57.000",
      "formatted_end": "04:24:59.000",
      "text": "اکثرا شیشه ای ها نمی سازن"
    },
    {
      "id": 58,
      "start": 15899.0,
      "end": 15901.0,
      "formatted_start": "04:24:59.000",
      "formatted_end": "04:25:01.000",
      "text": "باز هرکی بدنش یه جوره"
    }
  ],
  "status": "completed"
}