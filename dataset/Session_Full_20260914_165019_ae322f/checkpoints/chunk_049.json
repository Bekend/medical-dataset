  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14730.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:30.000",
      "text": "از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا"
    },
    {
      "id": 1,
      "start": 14730.0,
      "end": 14735.0,
      "formatted_start": "04:05:30.000",
      "formatted_end": "04:05:35.000",
      "text": "اینجوری قبل سوپانه میخورید. بعدش سیپرو رو بخورید. دوباره شام هم که قبل شام بخورید."
    },
    {
      "id": 2,
      "start": 14735.0,
      "end": 14737.0,
      "formatted_start": "04:05:35.000",
      "formatted_end": "04:05:37.000",
      "text": "و خواستتون بعد شام بخورید."
    },
    {
      "id": 3,
      "start": 14737.0,
      "end": 14738.0,
      "formatted_start": "04:05:37.000",
      "formatted_end": "04:05:38.000",
      "text": "آه درسته."
    },
    {
      "id": 4,
      "start": 14738.0,
      "end": 14739.0,
      "formatted_start": "04:05:38.000",
      "formatted_end": "04:05:39.000",
      "text": "که مدتون عذیب نشده."
    },
    {
      "id": 5,
      "start": 14739.0,
      "end": 14741.0,
      "formatted_start": "04:05:39.000",
      "formatted_end": "04:05:41.000",
      "text": "اینو بعد سیپرو رو بعد سوپانه بخوریم؟"
    },
    {
      "id": 6,
      "start": 14741.0,
      "end": 14743.0,
      "formatted_start": "04:05:41.000",
      "formatted_end": "04:05:43.000",
      "text": "بعد سوپانه و شام."
    },
    {
      "id": 7,
      "start": 14743.0,
      "end": 14748.0,
      "formatted_start": "04:05:43.000",
      "formatted_end": "04:05:48.000",
      "text": "چونکه پرستاد دیر خوب میشه. دو هفته طول می کشه."
    },
    {
      "id": 8,
      "start": 14748.0,
      "end": 14751.0,
      "formatted_start": "04:05:48.000",
      "formatted_end": "04:05:51.000",
      "text": "و اینکه خوب بشه دیگه ماسکون میشه."
    },
    {
      "id": 9,
      "start": 14751.0,
      "end": 14754.0,
      "formatted_start": "04:05:51.000",
      "formatted_end": "04:05:54.000",
      "text": "و کفزول پرستاد هم قرد نکنید."
    },
    {
      "id": 10,
      "start": 14754.0,
      "end": 14756.0,
      "formatted_start": "04:05:54.000",
      "formatted_end": "04:05:56.000",
      "text": "همه سی پرو بودی؟"
    },
    {
      "id": 11,
      "start": 14756.0,
      "end": 14758.0,
      "formatted_start": "04:05:56.000",
      "formatted_end": "04:05:58.000",
      "text": "نه، همه خوز و سینه"
    },
    {
      "id": 12,
      "start": 14758.0,
      "end": 14760.0,
      "formatted_start": "04:05:58.000",
      "formatted_end": "04:06:00.000",
      "text": "آه، چشم"
    },
    {
      "id": 13,
      "start": 14760.0,
      "end": 14762.0,
      "formatted_start": "04:06:00.000",
      "formatted_end": "04:06:02.000",
      "text": "تا که قد نخوند این زمان تمام بشه؟"
    },
    {
      "id": 14,
      "start": 14762.0,
      "end": 14768.0,
      "formatted_start": "04:06:02.000",
      "formatted_end": "04:06:08.000",
      "text": "آه، اگه برگشت کرد، بعد شد دیدی دوباره اضرار اینه، حالت پیش می آه"
    },
    {
      "id": 15,
      "start": 14768.0,
      "end": 14775.0,
      "formatted_start": "04:06:08.000",
      "formatted_end": "04:06:15.000",
      "text": "باید بخوره چون اضراری که میمونه، برمی گرد او خوند می کنه، برمی گرد پرستادتو او خوند می کنه"
    },
    {
      "id": 16,
      "start": 14775.0,
      "end": 14777.0,
      "formatted_start": "04:06:15.000",
      "formatted_end": "04:06:17.000",
      "text": "و یه دیگه پرستاد بود، دوباره بزرگ می شود"
    },
    {
      "id": 17,
      "start": 14777.0,
      "end": 14780.0,
      "formatted_start": "04:06:17.000",
      "formatted_end": "04:06:20.000",
      "text": "اگه خوب شدید، دیگه مشکل نداشتی این چیز"
    },
    {
      "id": 18,
      "start": 14780.0,
      "end": 14783.0,
      "formatted_start": "04:06:20.000",
      "formatted_end": "04:06:23.000",
      "text": "اینجا برای این حالات را به کلیه برم کرده"
    },
    {
      "id": 19,
      "start": 14783.0,
      "end": 14784.0,
      "formatted_start": "04:06:23.000",
      "formatted_end": "04:06:24.000",
      "text": "خوب؟"
    },
    {
      "id": 20,
      "start": 14784.0,
      "end": 14785.0,
      "formatted_start": "04:06:24.000",
      "formatted_end": "04:06:25.000",
      "text": "خوب"
    },
    {
      "id": 21,
      "start": 14785.0,
      "end": 14786.0,
      "formatted_start": "04:06:25.000",
      "formatted_end": "04:06:26.000",
      "text": "برنامه"
    },
    {
      "id": 22,
      "start": 14786.0,
      "end": 14788.0,
      "formatted_start": "04:06:26.000",
      "formatted_end": "04:06:28.000",
      "text": "چون می فهمیدید یا تشنام میشه اینا"
    },
    {
      "id": 23,
      "start": 14788.0,
      "end": 14790.0,
      "formatted_start": "04:06:28.000",
      "formatted_end": "04:06:30.000",
      "text": "یا مثلا حالت به چیز میشه میاد برام"
    },
    {
      "id": 24,
      "start": 14790.0,
      "end": 14792.0,
      "formatted_start": "04:06:30.000",
      "formatted_end": "04:06:32.000",
      "text": "زیاده را رو میکنم، خیلی شدید"
    },
    {
      "id": 25,
      "start": 14792.0,
      "end": 14796.0,
      "formatted_start": "04:06:32.000",
      "formatted_end": "04:06:36.000",
      "text": "کم خونیم، ویتاین دفعه، دعوزتونم خواهیم"
    },
    {
      "id": 26,
      "start": 14796.0,
      "end": 14798.0,
      "formatted_start": "04:06:36.000",
      "formatted_end": "04:06:38.000",
      "text": "سه ماه براتون دارون می نوستم"
    },
    {
      "id": 27,
      "start": 14798.0,
      "end": 14799.0,
      "formatted_start": "04:06:38.000",
      "formatted_end": "04:06:39.000",
      "text": "سونه گرفتی هم نوشتم"
    },
    {
      "id": 28,
      "start": 14799.0,
      "end": 14800.0,
      "formatted_start": "04:06:39.000",
      "formatted_end": "04:06:40.000",
      "text": "آمده نام"
    },
    {
      "id": 29,
      "start": 14800.0,
      "end": 14801.0,
      "formatted_start": "04:06:40.000",
      "formatted_end": "04:06:41.000",
      "text": "سلامه باشیم"
    },
    {
      "id": 30,
      "start": 14801.0,
      "end": 14802.0,
      "formatted_start": "04:06:41.000",
      "formatted_end": "04:06:42.000",
      "text": "باشیم"
    },
    {
      "id": 31,
      "start": 14802.0,
      "end": 14805.0,
      "formatted_start": "04:06:42.000",
      "formatted_end": "04:06:45.000",
      "text": "براتون ایرانی براتون هم یا خارجی؟"
    },
    {
      "id": 32,
      "start": 14805.0,
      "end": 14811.0,
      "formatted_start": "04:06:45.000",
      "formatted_end": "04:06:51.000",
      "text": "اینکه فرد نیست. باید باید شروع می کنیم."
    },
    {
      "id": 33,
      "start": 14815.0,
      "end": 14820.0,
      "formatted_start": "04:06:55.000",
      "formatted_end": "04:07:00.000",
      "text": "شبان موقع خواب بخوانید که عذیبتون در پیچه ای نمی آمده است."
    },
    {
      "id": 34,
      "start": 14820.0,
      "end": 14850.0,
      "formatted_start": "04:07:00.000",
      "formatted_end": "04:07:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 35,
      "start": 14850.0,
      "end": 14853.0,
      "formatted_start": "04:07:30.000",
      "formatted_end": "04:07:33.000",
      "text": "اینجا خوبه نیست؟ آوا خوب نیست نه؟"
    },
    {
      "id": 36,
      "start": 14853.0,
      "end": 14855.0,
      "formatted_start": "04:07:33.000",
      "formatted_end": "04:07:35.000",
      "text": "نه که خوب نماشه ممکنه شروع باشه"
    },
    {
      "id": 37,
      "start": 14855.0,
      "end": 14857.0,
      "formatted_start": "04:07:35.000",
      "formatted_end": "04:07:37.000",
      "text": "برای بهتر اینجایی که بیاییم"
    },
    {
      "id": 38,
      "start": 14857.0,
      "end": 14858.0,
      "formatted_start": "04:07:37.000",
      "formatted_end": "04:07:38.000",
      "text": "چشم"
    },
    {
      "id": 39,
      "start": 14858.0,
      "end": 14860.0,
      "formatted_start": "04:07:38.000",
      "formatted_end": "04:07:40.000",
      "text": "مرسی ممنون ببخشیم"
    },
    {
      "id": 40,
      "start": 14860.0,
      "end": 14865.0,
      "formatted_start": "04:07:40.000",
      "formatted_end": "04:07:45.000",
      "text": "اولا از فیلمان گرده دوره شده که..."
    },
    {
      "id": 41,
      "start": 14865.0,
      "end": 14866.0,
      "formatted_start": "04:07:45.000",
      "formatted_end": "04:07:46.000",
      "text": "مرزانه؟"
    },
    {
      "id": 42,
      "start": 14866.0,
      "end": 14867.0,
      "formatted_start": "04:07:46.000",
      "formatted_end": "04:07:47.000",
      "text": "بله دوباره شده"
    },
    {
      "id": 43,
      "start": 14867.0,
      "end": 14870.0,
      "formatted_start": "04:07:47.000",
      "formatted_end": "04:07:50.000",
      "text": "بله یک خودمیدی بشنه برای از دیوان بیشتر"
    },
    {
      "id": 44,
      "start": 14870.0,
      "end": 14872.0,
      "formatted_start": "04:07:50.000",
      "formatted_end": "04:07:52.000",
      "text": "چون اینجا شده بود؟"
    },
    {
      "id": 45,
      "start": 14872.0,
      "end": 14874.0,
      "formatted_start": "04:07:52.000",
      "formatted_end": "04:07:54.000",
      "text": "چون اینجا شده بود؟"
    },
    {
      "id": 46,
      "start": 14874.0,
      "end": 14876.0,
      "formatted_start": "04:07:54.000",
      "formatted_end": "04:07:56.000",
      "text": "چند دقیقه اولی بخوردن؟"
    },
    {
      "id": 47,
      "start": 14876.0,
      "end": 14878.0,
      "formatted_start": "04:07:56.000",
      "formatted_end": "04:07:58.000",
      "text": "اینکه بید خوکاش کردن و خیلی بندیخوردن"
    },
    {
      "id": 48,
      "start": 14878.0,
      "end": 14880.0,
      "formatted_start": "04:07:58.000",
      "formatted_end": "04:08:00.000",
      "text": "اصلا بچه مشکل نداره بود"
    },
    {
      "id": 49,
      "start": 14880.0,
      "end": 14882.0,
      "formatted_start": "04:08:00.000",
      "formatted_end": "04:08:02.000",
      "text": "نگه کن من قدرانه برنامه کنیم"
    },
    {
      "id": 50,
      "start": 14882.0,
      "end": 14884.0,
      "formatted_start": "04:08:02.000",
      "formatted_end": "04:08:04.000",
      "text": "همشه توران چیز درد کسی نمیدن"
    },
    {
      "id": 51,
      "start": 14884.0,
      "end": 14886.0,
      "formatted_start": "04:08:04.000",
      "formatted_end": "04:08:06.000",
      "text": "یعنی اینطوری که"
    },
    {
      "id": 52,
      "start": 14886.0,
      "end": 14888.0,
      "formatted_start": "04:08:06.000",
      "formatted_end": "04:08:08.000",
      "text": "بچه چیزی به قلم بگیرن درد نمیده"
    },
    {
      "id": 53,
      "start": 14888.0,
      "end": 14890.0,
      "formatted_start": "04:08:08.000",
      "formatted_end": "04:08:10.000",
      "text": "بعد کسای مویم همشه درد میدن"
    },
    {
      "id": 54,
      "start": 14890.0,
      "end": 14892.0,
      "formatted_start": "04:08:10.000",
      "formatted_end": "04:08:12.000",
      "text": "پشت"
    },
    {
      "id": 55,
      "start": 14892.0,
      "end": 14894.0,
      "formatted_start": "04:08:12.000",
      "formatted_end": "04:08:14.000",
      "text": "خواهد دارم بزیر به قلم"
    },
    {
      "id": 56,
      "start": 14894.0,
      "end": 14896.0,
      "formatted_start": "04:08:14.000",
      "formatted_end": "04:08:16.000",
      "text": "آهان"
    },
    {
      "id": 57,
      "start": 14896.0,
      "end": 14898.0,
      "formatted_start": "04:08:16.000",
      "formatted_end": "04:08:18.000",
      "text": "ولی دیشتر یک رو به بخش داشتن هم دارم"
    },
    {
      "id": 58,
      "start": 14898.0,
      "end": 14900.0,
      "formatted_start": "04:08:18.000",
      "formatted_end": "04:08:20.000",
      "text": "از اینجوری باید برداریم"
    },
    {
      "id": 59,
      "start": 14900.0,
      "end": 14903.0,
      "formatted_start": "04:08:20.000",
      "formatted_end": "04:08:23.000",
      "text": "دیشتر هیچ چیزی یکی باید دارم"
    },
    {
      "id": 60,
      "start": 14903.0,
      "end": 14906.0,
      "formatted_start": "04:08:23.000",
      "formatted_end": "04:08:26.000",
      "text": "این کیست های زیری که منم درم دارم"
    },
    {
      "id": 61,
      "start": 14906.0,
      "end": 14908.0,
      "formatted_start": "04:08:26.000",
      "formatted_end": "04:08:28.000",
      "text": "هنوز"
    },
    {
      "id": 62,
      "start": 14908.0,
      "end": 14910.0,
      "formatted_start": "04:08:28.000",
      "formatted_end": "04:08:30.000",
      "text": "اینجا"
    },
    {
      "id": 63,
      "start": 14910.0,
      "end": 14912.0,
      "formatted_start": "04:08:30.000",
      "formatted_end": "04:08:32.000",
      "text": "تهب شده درم مکنه"
    },
    {
      "id": 64,
      "start": 14912.0,
      "end": 14914.0,
      "formatted_start": "04:08:32.000",
      "formatted_end": "04:08:34.000",
      "text": "ماستیت که ندارم بگو"
    },
    {
      "id": 65,
      "start": 14914.0,
      "end": 14916.0,
      "formatted_start": "04:08:34.000",
      "formatted_end": "04:08:36.000",
      "text": "این که از هاو سینه هست"
    },
    {
      "id": 66,
      "start": 14916.0,
      "end": 14918.0,
      "formatted_start": "04:08:36.000",
      "formatted_end": "04:08:38.000",
      "text": "ماستیت اسمش"
    },
    {
      "id": 67,
      "start": 14918.0,
      "end": 14920.0,
      "formatted_start": "04:08:38.000",
      "formatted_end": "04:08:40.000",
      "text": "اما باید حتما سونا سینه بشی"
    },
    {
      "id": 68,
      "start": 14920.0,
      "end": 14927.0,
      "formatted_start": "04:08:40.000",
      "formatted_end": "04:08:47.000",
      "text": "از این هفته نزدیکی استفاده نکردیم"
    },
    {
      "id": 69,
      "start": 14927.0,
      "end": 14929.0,
      "formatted_start": "04:08:47.000",
      "formatted_end": "04:08:49.000",
      "text": "این سینت رو مزیدی نداشته"
    },
    {
      "id": 70,
      "start": 14929.0,
      "end": 14932.0,
      "formatted_start": "04:08:49.000",
      "formatted_end": "04:08:52.000",
      "text": "تو این موضوع که نه استیمت استفاده کنی"
    },
    {
      "id": 71,
      "start": 14932.0,
      "end": 14935.0,
      "formatted_start": "04:08:52.000",
      "formatted_end": "04:08:55.000",
      "text": "نه بابا از اینوزا از این قصد اترس نیست"
    },
    {
      "id": 72,
      "start": 14935.0,
      "end": 14937.0,
      "formatted_start": "04:08:55.000",
      "formatted_end": "04:08:57.000",
      "text": "یعنی بسیار برابر"
    },
    {
      "id": 73,
      "start": 14937.0,
      "end": 14939.0,
      "formatted_start": "04:08:57.000",
      "formatted_end": "04:08:59.000",
      "text": "اینجا چون یکم سر شده؟"
    },
    {
      "id": 74,
      "start": 14939.0,
      "end": 14941.0,
      "formatted_start": "04:08:59.000",
      "formatted_end": "04:09:01.000",
      "text": "اینجا نه"
    },
    {
      "id": 75,
      "start": 14941.0,
      "end": 14943.0,
      "formatted_start": "04:09:01.000",
      "formatted_end": "04:09:03.000",
      "text": "ببخشیده من این سر کارم بیدم"
    },
    {
      "id": 76,
      "start": 14943.0,
      "end": 14945.0,
      "formatted_start": "04:09:03.000",
      "formatted_end": "04:09:05.000",
      "text": "همیشه مرتبه باهم"
    },
    {
      "id": 77,
      "start": 14947.0,
      "end": 14949.0,
      "formatted_start": "04:09:07.000",
      "formatted_end": "04:09:09.000",
      "text": "اینو دستم بلا کنم باز بهتر"
    },
    {
      "id": 78,
      "start": 14951.0,
      "end": 14953.0,
      "formatted_start": "04:09:11.000",
      "formatted_end": "04:09:13.000",
      "text": "نشون ببخشیده من"
    },
    {
      "id": 79,
      "start": 14953.0,
      "end": 14955.0,
      "formatted_start": "04:09:13.000",
      "formatted_end": "04:09:15.000",
      "text": "این سر کارم بیدم"
    },
    {
      "id": 80,
      "start": 14955.0,
      "end": 14957.0,
      "formatted_start": "04:09:15.000",
      "formatted_end": "04:09:17.000",
      "text": "اینجا هست این مرید"
    },
    {
      "id": 81,
      "start": 14957.0,
      "end": 14959.0,
      "formatted_start": "04:09:17.000",
      "formatted_end": "04:09:19.000",
      "text": "این مرید دارم"
    },
    {
      "id": 82,
      "start": 14959.0,
      "end": 14961.0,
      "formatted_start": "04:09:19.000",
      "formatted_end": "04:09:21.000",
      "text": "این مرید عادت دارم"
    },
    {
      "id": 83,
      "start": 14961.0,
      "end": 14963.0,
      "formatted_start": "04:09:21.000",
      "formatted_end": "04:09:23.000",
      "text": "نه این همیشه دارم ها"
    },
    {
      "id": 84,
      "start": 14963.0,
      "end": 14965.0,
      "formatted_start": "04:09:23.000",
      "formatted_end": "04:09:25.000",
      "text": "عادت دارم"
    },
    {
      "id": 85,
      "start": 14965.0,
      "end": 14967.0,
      "formatted_start": "04:09:25.000",
      "formatted_end": "04:09:27.000",
      "text": "این همه به نظر خودمدن نیست"
    },
    {
      "id": 86,
      "start": 14967.0,
      "end": 14969.0,
