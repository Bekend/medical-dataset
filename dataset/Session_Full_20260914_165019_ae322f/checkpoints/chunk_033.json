      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:02.000",
      "text": "با شما بشه."
    },
    {
      "id": 1,
      "start": 9902.0,
      "end": 9904.0,
      "formatted_start": "02:45:02.000",
      "formatted_end": "02:45:04.000",
      "text": "با شما بشه."
    },
    {
      "id": 2,
      "start": 9916.0,
      "end": 9918.0,
      "formatted_start": "02:45:16.000",
      "formatted_end": "02:45:18.000",
      "text": "این دختر بچه هست؟"
    },
    {
      "id": 3,
      "start": 9918.0,
      "end": 9920.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:20.000",
      "text": "بله."
    },
    {
      "id": 4,
      "start": 9926.0,
      "end": 9928.0,
      "formatted_start": "02:45:26.000",
      "formatted_end": "02:45:28.000",
      "text": "خب، این بچه نداره."
    },
    {
      "id": 5,
      "start": 9928.0,
      "end": 9930.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:30.000",
      "text": "مرگ مامانش بود"
    },
    {
      "id": 6,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "ماماش این بهترانه داشت"
    },
    {
      "id": 7,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "دارای دکتر یاد باشه"
    },
    {
      "id": 8,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "بگیری باید کم عریضه رو فرستم ببینیم"
    },
    {
      "id": 9,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "باشه"
    },
    {
      "id": 10,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "چیشو زیاد بگیریم"
    },
    {
      "id": 11,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "چیشو زیاد بهترانه؟"
    },
    {
      "id": 12,
      "start": 9944.0,
      "end": 9946.0,
      "formatted_start": "02:45:44.000",
      "formatted_end": "02:45:46.000",
      "text": "آهان چیشو زیاد"
    },
    {
      "id": 13,
      "start": 9946.0,
      "end": 9948.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:48.000",
      "text": "تا روزاده بیشتر هستی"
    },
    {
      "id": 14,
      "start": 9958.0,
      "end": 9987.98,
      "formatted_start": "02:45:58.000",
      "formatted_end": "02:46:27.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 15,
      "start": 9988.0,
      "end": 10018.0,
      "formatted_start": "02:46:28.000",
      "formatted_end": "02:46:58.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 16,
      "start": 10018.0,
      "end": 10022.0,
      "formatted_start": "02:46:58.000",
      "formatted_end": "02:47:02.000",
      "text": "این دروار رو از قبل استفاده می کرد"
    },
    {
      "id": 17,
      "start": 10022.0,
      "end": 10028.0,
      "formatted_start": "02:47:02.000",
      "formatted_end": "02:47:08.000",
      "text": "هر دور شکستگی داره"
    },
    {
      "id": 18,
      "start": 10028.0,
      "end": 10032.0,
      "formatted_start": "02:47:08.000",
      "formatted_end": "02:47:12.000",
      "text": "وقتی دور چشم کبود میشه اعتماد شکستگی داره"
    },
    {
      "id": 19,
      "start": 10032.0,
      "end": 10035.0,
      "formatted_start": "02:47:12.000",
      "formatted_end": "02:47:15.000",
      "text": "ما مجدد می برویم اکس رو"
    },
    {
      "id": 20,
      "start": 10035.0,
      "end": 10037.0,
      "formatted_start": "02:47:15.000",
      "formatted_end": "02:47:17.000",
      "text": "سی تی اس گرم باید حتما می کنیم"
    },
    {
      "id": 21,
      "start": 10037.0,
      "end": 10038.0,
      "formatted_start": "02:47:17.000",
      "formatted_end": "02:47:18.000",
      "text": "درد نداره"
    },
    {
      "id": 22,
      "start": 10038.0,
      "end": 10042.0,
      "formatted_start": "02:47:18.000",
      "formatted_end": "02:47:22.000",
      "text": "اصلا مهم نیست خود نموکرد کاری هم نمیخواد خود دماغ شکستگی داره"
    },
    {
      "id": 23,
      "start": 10042.0,
      "end": 10047.0,
      "formatted_start": "02:47:22.000",
      "formatted_end": "02:47:27.000",
      "text": "اعتماد شکستگی نیست داشته باشه چون مامان دماغش خورده دیگه"
    },
    {
      "id": 24,
      "start": 10047.0,
      "end": 10051.0,
      "formatted_start": "02:47:27.000",
      "formatted_end": "02:47:31.000",
      "text": "این داده چشم که قرار داره بود که چیز خود خواهد نیست"
    },
    {
      "id": 25,
      "start": 10051.0,
      "end": 10053.0,
      "formatted_start": "02:47:31.000",
      "formatted_end": "02:47:33.000",
      "text": "شکستگیری لیز باشه"
    },
    {
      "id": 26,
      "start": 10053.0,
      "end": 10055.0,
      "formatted_start": "02:47:33.000",
      "formatted_end": "02:47:35.000",
      "text": "از در موقع آب که نمیاد مادر"
    },
    {
      "id": 27,
      "start": 10055.0,
      "end": 10056.0,
      "formatted_start": "02:47:35.000",
      "formatted_end": "02:47:36.000",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 10056.0,
      "end": 10058.0,
      "formatted_start": "02:47:36.000",
      "formatted_end": "02:47:38.000",
      "text": "ارتیاط داری بود"
    },
    {
      "id": 29,
      "start": 10058.0,
      "end": 10060.0,
      "formatted_start": "02:47:38.000",
      "formatted_end": "02:47:40.000",
      "text": "ارتیاط داری بود"
    },
    {
      "id": 30,
      "start": 10060.0,
      "end": 10063.0,
      "formatted_start": "02:47:40.000",
      "formatted_end": "02:47:43.000",
      "text": "من رفتار دوشانگا بینیم او بگیرم"
    },
    {
      "id": 31,
      "start": 10063.0,
      "end": 10065.0,
      "formatted_start": "02:47:43.000",
      "formatted_end": "02:47:45.000",
      "text": "دکتر گوشه ها با بینیم"
    },
    {
      "id": 32,
      "start": 10065.0,
      "end": 10067.0,
      "formatted_start": "02:47:45.000",
      "formatted_end": "02:47:47.000",
      "text": "دکتر هجی پور"
    },
    {
      "id": 33,
      "start": 10067.0,
      "end": 10069.0,
      "formatted_start": "02:47:47.000",
      "formatted_end": "02:47:49.000",
      "text": "دکتر افرانی با بر سورتش"
    },
    {
      "id": 34,
      "start": 10069.0,
      "end": 10071.0,
      "formatted_start": "02:47:49.000",
      "formatted_end": "02:47:51.000",
      "text": "ستیر گرفتی"
    },
    {
      "id": 35,
      "start": 10071.0,
      "end": 10073.0,
      "formatted_start": "02:47:51.000",
      "formatted_end": "02:47:53.000",
      "text": "ستیر شو بگیر بگیر با او ببینم"
    },
    {
      "id": 36,
      "start": 10073.0,
      "end": 10075.0,
      "formatted_start": "02:47:53.000",
      "formatted_end": "02:47:55.000",
      "text": "شکستگیر شد"
    },
    {
      "id": 37,
      "start": 10075.0,
      "end": 10077.0,
      "formatted_start": "02:47:55.000",
      "formatted_end": "02:47:57.000",
      "text": "مطمئن شید"
    },
    {
      "id": 38,
      "start": 10077.0,
      "end": 10081.0,
      "formatted_start": "02:47:57.000",
      "formatted_end": "02:48:01.000",
      "text": "الان مدتی 19 بوده"
    },
    {
      "id": 39,
      "start": 10081.0,
      "end": 10083.0,
      "formatted_start": "02:48:01.000",
      "formatted_end": "02:48:03.000",
      "text": "اگر چه برنامه بوده"
    },
    {
      "id": 40,
      "start": 10083.0,
      "end": 10085.0,
      "formatted_start": "02:48:03.000",
      "formatted_end": "02:48:05.000",
      "text": "اگر چه برنامه بوده"
    },
    {
      "id": 41,
      "start": 10085.0,
      "end": 10087.0,
      "formatted_start": "02:48:05.000",
      "formatted_end": "02:48:07.000",
      "text": "همه برنامه بوده"
    },
    {
      "id": 42,
      "start": 10087.0,
      "end": 10089.0,
      "formatted_start": "02:48:07.000",
      "formatted_end": "02:48:09.000",
      "text": "دیگه ساعت چند بود اتقای بودن؟"
    },
    {
      "id": 43,
      "start": 10089.0,
      "end": 10091.0,
      "formatted_start": "02:48:09.000",
      "formatted_end": "02:48:11.000",
      "text": "شش و بیمار صبح بود"
    },
    {
      "id": 44,
      "start": 10091.0,
      "end": 10093.0,
      "formatted_start": "02:48:11.000",
      "formatted_end": "02:48:13.000",
      "text": "تا هفته و بیمار رسیدیم"
    },
    {
      "id": 45,
      "start": 10093.0,
      "end": 10097.0,
      "formatted_start": "02:48:13.000",
      "formatted_end": "02:48:17.000",
      "text": "بچه ما یک روز با سه تا صبح خورده بودیم یا نخوردیم؟"
    },
    {
      "id": 46,
      "start": 10097.0,
      "end": 10099.0,
      "formatted_start": "02:48:17.000",
      "formatted_end": "02:48:19.000",
      "text": "نخوردیم، شب خورده بودم"
    },
    {
      "id": 47,
      "start": 10099.0,
      "end": 10101.0,
      "formatted_start": "02:48:19.000",
      "formatted_end": "02:48:21.000",
      "text": "ده شب خورده بودم و صبح هم نرسیم"
    },
    {
      "id": 48,
      "start": 10101.0,
      "end": 10103.0,
      "formatted_start": "02:48:21.000",
      "formatted_end": "02:48:23.000",
      "text": "شب شام چه خورده بودی؟"
    },
    {
      "id": 49,
      "start": 10103.0,
      "end": 10107.0,
      "formatted_start": "02:48:23.000",
      "formatted_end": "02:48:27.000",
      "text": "سوخ کرده؟ نه، آب قرضی تا داره"
    },
    {
      "id": 50,
      "start": 10107.0,
      "end": 10111.0,
      "formatted_start": "02:48:27.000",
      "formatted_end": "02:48:31.000",
      "text": "نمک زنید؟ آره نمک زنید"
    },
    {
      "id": 51,
      "start": 10111.0,
      "end": 10113.0,
      "formatted_start": "02:48:31.000",
      "formatted_end": "02:48:33.000",
      "text": "نمک زنید، آخذ بشون"
    },
    {
      "id": 52,
      "start": 10113.0,
      "end": 10118.0,
      "formatted_start": "02:48:33.000",
      "formatted_end": "02:48:38.000",
      "text": "تخنا مرگو نکنید؟ خودی تخنایم، آجی؟ نه، اون چیزی باشه"
    },
    {
      "id": 53,
      "start": 10118.0,
      "end": 10123.0,
      "formatted_start": "02:48:38.000",
      "formatted_end": "02:48:43.000",
      "text": "سوخ کرده، گشت قرمز زیاد نمیخوادید، یه هفته یه بار"
    },
    {
      "id": 54,
      "start": 10123.0,
      "end": 10127.0,
      "formatted_start": "02:48:43.000",
      "formatted_end": "02:48:47.000",
      "text": "گشت قرمز خیلی خوب کرده، مثلا هفته یه بار"
    },
    {
      "id": 55,
      "start": 10127.0,
      "end": 10132.0,
      "formatted_start": "02:48:47.000",
      "formatted_end": "02:48:52.000",
      "text": "او هفته یک بار تقنه مرگ و آب پزه هم هفته یک بار بیشتر نباشه"
    },
    {
      "id": 56,
      "start": 10132.0,
      "end": 10135.0,
      "formatted_start": "02:48:52.000",
      "formatted_end": "02:48:55.000",
      "text": "امروز که گوشت قرمز میخورد یک تقنه مرگ نخورید"
    },
    {
      "id": 57,
      "start": 10135.0,
      "end": 10137.0,
      "formatted_start": "02:48:55.000",
      "formatted_end": "02:48:57.000",
      "text": "نمک به غذا تون اضافه نکنید"
    },
    {
      "id": 58,
      "start": 10137.0,
      "end": 10140.0,
      "formatted_start": "02:48:57.000",
      "formatted_end": "02:49:00.000",
      "text": "یک فیاشو و تقنه و هیچ چیزا نخورید"
    },
    {
      "id": 59,
      "start": 10140.0,
      "end": 10143.0,
      "formatted_start": "02:49:00.000",
      "formatted_end": "02:49:03.000",
      "text": "کنید که اون فلکه سیا و این پشار بود و پرس بود"
    },
    {
      "id": 60,
      "start": 10143.0,
      "end": 10145.0,
      "formatted_start": "02:49:03.000",
      "formatted_end": "02:49:05.000",
      "text": "میتونه یکم بالا ببرد آره"
    },
    {
      "id": 61,
      "start": 10145.0,
      "end": 10148.0,
      "formatted_start": "02:49:05.000",
      "formatted_end": "02:49:08.000",
      "text": "غذاهای تونز میتونه دارچین"
    },
    {
      "id": 62,
      "start": 10148.0,
      "end": 10154.2,
      "formatted_start": "02:49:08.000",
      "formatted_end": "02:49:14.200",
      "text": "اطریه های تونی، گاچین و پلفل و زنجفی میتونه یکم پشار بوده بود"
    },
    {
      "id": 63,
      "start": 10154.2,
      "end": 10157.2,
      "formatted_start": "02:49:14.200",
      "formatted_end": "02:49:17.200",
      "text": "گلک گرمی جاد میتونه یکم پشار بوده بوده بوده"
    },
    {
      "id": 64,
      "start": 10157.2,
      "end": 10158.2,
      "formatted_start": "02:49:17.200",
      "formatted_end": "02:49:18.200",
      "text": "و اینها اینقدر موضوعه"
    },
    {
      "id": 65,
      "start": 10158.2,
      "end": 10162.2,
      "formatted_start": "02:49:18.200",
      "formatted_end": "02:49:22.200",
      "text": "این زمینه که امالا قبلن قلبش رو آرزه کرده بوده"
    },
    {
      "id": 66,
      "start": 10162.2,
      "end": 10163.2,
      "formatted_start": "02:49:22.200",
      "formatted_end": "02:49:23.200",
      "text": "و جوادشو چه بوده؟"
    },
    {
      "id": 67,
      "start": 10163.2,
      "end": 10164.2,
      "formatted_start": "02:49:23.200",
      "formatted_end": "02:49:24.200",
      "text": "15 ساله کشتر"
    },
    {
      "id": 68,
      "start": 10164.2,
      "end": 10167.2,
      "formatted_start": "02:49:24.200",
      "formatted_end": "02:49:27.200",
      "text": "گفتم باز بوده استنز زدن چیکاری؟"
    },
    {
      "id": 69,
      "start": 10167.2,
      "end": 10168.2,
      "formatted_start": "02:49:27.200",
      "formatted_end": "02:49:28.200",
      "text": "باز بوده باز"
    },
    {
      "id": 70,
      "start": 10168.2,
      "end": 10169.2,
      "formatted_start": "02:49:28.200",
      "formatted_end": "02:49:29.200",
      "text": "باز بوده باز"
    },
    {
      "id": 71,
      "start": 10169.2,
      "end": 10170.2,
      "formatted_start": "02:49:29.200",
      "formatted_end": "02:49:30.200",
      "text": "باز بوده باز"
    },
    {
      "id": 72,
      "start": 10170.2,
      "end": 10171.2,
      "formatted_start": "02:49:30.200",
      "formatted_end": "02:49:31.200",
      "text": "باز بوده باز"
    },
    {
      "id": 73,
      "start": 10171.2,
      "end": 10173.2,
      "formatted_start": "02:49:31.200",
      "formatted_end": "02:49:33.200",
      "text": "خب بعد اون بعد رقمت کننده خون میخوری؟"
    },
    {
      "id": 74,
      "start": 10173.2,
      "end": 10174.2,
      "formatted_start": "02:49:33.200",
      "formatted_end": "02:49:34.200",
      "text": "آره اونو داریم"
    },
    {
      "id": 75,
      "start": 10174.2,
      "end": 10175.2,
      "formatted_start": "02:49:34.200",
      "formatted_end": "02:49:35.200",
      "text": "آسپرین میخوری؟"
    },
    {
      "id": 76,
      "start": 10175.2,
      "end": 10176.2,
      "formatted_start": "02:49:35.200",
      "formatted_end": "02:49:36.200",
      "text": "آسپرین رو بخوریم"
    },
    {
      "id": 77,
      "start": 10176.2,
      "end": 10177.2,
      "formatted_start": "02:49:36.200",
      "formatted_end": "02:49:37.200",
      "text": "اوزلکس رو میخوری؟"
    },
    {
      "id": 78,
      "start": 10177.2,
      "end": 10178.2,
      "formatted_start": "02:49:37.200",
      "formatted_end": "02:49:38.200",
      "text": "نیست"
    },
    {
      "id": 79,
      "start": 10178.2,
      "end": 10179.2,
      "formatted_start": "02:49:38.200",
      "formatted_end": "02:49:39.200",
      "text": "همینو ها یه آسپرین رو میخوریم"
    },
    {
      "id": 80,
      "start": 10179.2,
      "end": 10180.2,
      "formatted_start": "02:49:39.200",
      "formatted_end": "02:49:40.200",
      "text": "همینو یه آسپرین؟"
    },
    {
      "id": 81,
      "start": 10180.2,
      "end": 10183.2,
      "formatted_start": "02:49:40.200",
      "formatted_end": "02:49:43.200",
      "text": "آسپرین رو مثلا الان کم کردم"
    },
    {
      "id": 82,
      "start": 10183.2,
      "end": 10187.2,
      "formatted_start": "02:49:43.200",
      "formatted_end": "02:49:47.200",
      "text": "دیده هر جای دستون رو رو روزه کنم خیلی چشم"
    },
    {
      "id": 83,
      "start": 10187.2,
      "end": 10189.2,
      "formatted_start": "02:49:47.200",
      "formatted_end": "02:49:49.200",
      "text": "خب این کار رو خطرناکی کردی کنی؟"
    },
    {
      "id": 84,
      "start": 10189.2,
      "end": 10192.2,
      "formatted_start": "02:49:49.200",
      "formatted_end": "02:49:52.200",
      "text": "آره اونو مثلا دو شب یکی میخورم"
    },
    {
      "id": 85,
      "start": 10192.2,
      "end": 10197.0,
      "formatted_start": "02:49:52.200",
      "formatted_end": "02:49:57.000",
      "text": "همون که دکتر وقتی آنجیو کرده با لون زده با هر روز آنسپلیم رو که"
    },
    {
      "id": 86,
      "start": 10197.0,
      "end": 10198.54,
      "formatted_start": "02:49:57.000",
      "formatted_end": "02:49:58.540",
      "text": "تا آخر آمروش"
    }
  ],
  "status": "completed"
}