      "formatted_end": "02:21:38.000",
      "text": "بیانونی برداشت"
    },
    {
      "id": 20,
      "start": 8498.0,
      "end": 8500.0,
      "formatted_start": "02:21:38.000",
      "formatted_end": "02:21:40.000",
      "text": "اوکی همونه ایکی"
    },
    {
      "id": 21,
      "start": 8500.0,
      "end": 8502.0,
      "formatted_start": "02:21:40.000",
      "formatted_end": "02:21:42.000",
      "text": "نیستی با چرم"
    },
    {
      "id": 22,
      "start": 8504.0,
      "end": 8506.0,
      "formatted_start": "02:21:44.000",
      "formatted_end": "02:21:46.000",
      "text": "یک سن هم شد"
    },
    {
      "id": 23,
      "start": 8506.0,
      "end": 8508.0,
      "formatted_start": "02:21:46.000",
      "formatted_end": "02:21:48.000",
      "text": "برداشت میخواد فرش بیانونی چی؟"
    },
    {
      "id": 24,
      "start": 8508.0,
      "end": 8510.0,
      "formatted_start": "02:21:48.000",
      "formatted_end": "02:21:50.000",
      "text": "خوب هست خب همینجور"
    },
    {
      "id": 25,
      "start": 8510.0,
      "end": 8512.0,
      "formatted_start": "02:21:50.000",
      "formatted_end": "02:21:52.000",
      "text": "بچه ها خوب هست"
    },
    {
      "id": 26,
      "start": 8512.0,
      "end": 8514.0,
      "formatted_start": "02:21:52.000",
      "formatted_end": "02:21:54.000",
      "text": "بچه ها خوب هست"
    },
    {
      "id": 27,
      "start": 8514.0,
      "end": 8516.0,
      "formatted_start": "02:21:54.000",
      "formatted_end": "02:21:56.000",
      "text": "چرا چی شد؟"
    },
    {
      "id": 28,
      "start": 8516.0,
      "end": 8519.0,
      "formatted_start": "02:21:56.000",
      "formatted_end": "02:21:59.000",
      "text": "یک کم چربی بالایه و تیروید همون ظاهرا"
    },
    {
      "id": 29,
      "start": 8519.0,
      "end": 8521.0,
      "formatted_start": "02:21:59.000",
      "formatted_end": "02:22:01.000",
      "text": "باید مشکل داری؟"
    },
    {
      "id": 30,
      "start": 8521.0,
      "end": 8523.0,
      "formatted_start": "02:22:01.000",
      "formatted_end": "02:22:03.000",
      "text": "نه، مشکل نداری"
    },
    {
      "id": 31,
      "start": 8523.0,
      "end": 8526.0,
      "formatted_start": "02:22:03.000",
      "formatted_end": "02:22:06.000",
      "text": "اما این دکتر ما را قوی ترسونه"
    },
    {
      "id": 32,
      "start": 8526.0,
      "end": 8529.0,
      "formatted_start": "02:22:06.000",
      "formatted_end": "02:22:09.000",
      "text": "دکتر خب، آدم خودش هم از خاصی رده"
    },
    {
      "id": 33,
      "start": 8529.0,
      "end": 8531.0,
      "formatted_start": "02:22:09.000",
      "formatted_end": "02:22:11.000",
      "text": "بذارش من خودم را از خاصی خیلی خوب دارم"
    },
    {
      "id": 34,
      "start": 8531.0,
      "end": 8532.0,
      "formatted_start": "02:22:11.000",
      "formatted_end": "02:22:12.000",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 8532.0,
      "end": 8534.0,
      "formatted_start": "02:22:12.000",
      "formatted_end": "02:22:14.000",
      "text": "چربی تو مزید بالاست"
    },
    {
      "id": 36,
      "start": 8534.0,
      "end": 8536.0,
      "formatted_start": "02:22:14.000",
      "formatted_end": "02:22:16.000",
      "text": "آره، چربی بالاست"
    },
    {
      "id": 37,
      "start": 8536.0,
      "end": 8540.0,
      "formatted_start": "02:22:16.000",
      "formatted_end": "02:22:20.000",
      "text": "از این مرد که از این دو تونه هایی بیشتر نرمان بوده"
    },
    {
      "id": 38,
      "start": 8540.0,
      "end": 8560.0,
      "formatted_start": "02:22:20.000",
      "formatted_end": "02:22:40.000",
      "text": "از این شکل نمیشید. بیقرار هست، صورتش پر عرق هست، کف دستاش خیسته، تفش و قلب داره، ملتحبه، اصلا در ظاهر تو نماس انام نیست."
    },
    {
      "id": 39,
      "start": 8560.0,
      "end": 8563.0,
      "formatted_start": "02:22:40.000",
      "formatted_end": "02:22:43.000",
      "text": "باید برامون عرضش نداده یا نداره"
    },
    {
      "id": 40,
      "start": 8563.0,
      "end": 8566.0,
      "formatted_start": "02:22:43.000",
      "formatted_end": "02:22:46.000",
      "text": "پس همونکه این یه دوره یه استرس بیاد تو مورد شده"
    },
    {
      "id": 41,
      "start": 8566.0,
      "end": 8569.0,
      "formatted_start": "02:22:46.000",
      "formatted_end": "02:22:49.000",
      "text": "به صورت دوره یه دفعه تیره ی دوتون مبتوانه"
    },
    {
      "id": 42,
      "start": 8569.0,
      "end": 8572.0,
      "formatted_start": "02:22:49.000",
      "formatted_end": "02:22:52.000",
      "text": "استرس که همیشه هستیه خاندکتر"
    },
    {
      "id": 43,
      "start": 8572.0,
      "end": 8574.0,
      "formatted_start": "02:22:52.000",
      "formatted_end": "02:22:54.000",
      "text": "استرس که دیگه اینجا ایرانه دیگه"
    },
    {
      "id": 44,
      "start": 8574.0,
      "end": 8576.0,
      "formatted_start": "02:22:54.000",
      "formatted_end": "02:22:56.000",
      "text": "ما باید به تاست زندگی نمیکنیم"
    },
    {
      "id": 45,
      "start": 8576.0,
      "end": 8581.0,
      "formatted_start": "02:22:56.000",
      "formatted_end": "02:23:01.000",
      "text": "دکتر میگه که توی ایران همه باید بارسته نیمدن سی سال و پرا همه مصروف"
    },
    {
      "id": 46,
      "start": 8581.0,
      "end": 8584.0,
      "formatted_start": "02:23:01.000",
      "formatted_end": "02:23:04.000",
      "text": "ادرار توسطش داره؟"
    },
    {
      "id": 47,
      "start": 8584.0,
      "end": 8585.0,
      "formatted_start": "02:23:04.000",
      "formatted_end": "02:23:05.000",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 8585.0,
      "end": 8587.0,
      "formatted_start": "02:23:05.000",
      "formatted_end": "02:23:07.000",
      "text": "اگه علامت نداره این هم عرضش من نیست"
    },
    {
      "id": 49,
      "start": 8587.0,
      "end": 8589.0,
      "formatted_start": "02:23:07.000",
      "formatted_end": "02:23:09.000",
      "text": "سابقه سنگ که نداشتیم"
    },
    {
      "id": 50,
      "start": 8589.0,
      "end": 8590.0,
      "formatted_start": "02:23:09.000",
      "formatted_end": "02:23:10.000",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 8590.0,
      "end": 8594.0,
      "formatted_start": "02:23:10.000",
      "formatted_end": "02:23:14.000",
      "text": "اولین بار چربیتون بالاست؟"
    },
    {
      "id": 52,
      "start": 8594.0,
      "end": 8595.0,
      "formatted_start": "02:23:14.000",
      "formatted_end": "02:23:15.000",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 8595.0,
      "end": 8597.0,
      "formatted_start": "02:23:15.000",
      "formatted_end": "02:23:17.000",
      "text": "دو خواهیم بالاییم"
    },
    {
      "id": 54,
      "start": 8597.0,
      "end": 8599.0,
      "formatted_start": "02:23:17.000",
      "formatted_end": "02:23:19.000",
      "text": "دو خواهیم بالاییم و دو خواهیم بخوریم"
    },
    {
      "id": 55,
      "start": 8599.0,
      "end": 8601.0,
      "formatted_start": "02:23:19.000",
      "formatted_end": "02:23:21.000",
      "text": "چون هی اروغتون تنگ میشه"
    },
    {
      "id": 56,
      "start": 8601.0,
      "end": 8603.0,
      "formatted_start": "02:23:21.000",
      "formatted_end": "02:23:23.000",
      "text": "این در واقع ریسک امورت هست"
    },
    {
      "id": 57,
      "start": 8603.0,
      "end": 8605.0,
      "formatted_start": "02:23:23.000",
      "formatted_end": "02:23:25.000",
      "text": "دو خورس چربی میخوریم"
    },
    {
      "id": 58,
      "start": 8605.0,
      "end": 8606.0,
      "formatted_start": "02:23:25.000",
      "formatted_end": "02:23:26.000",
      "text": "میخوریم؟"
    },
    {
      "id": 59,
      "start": 8606.0,
      "end": 8607.0,
      "formatted_start": "02:23:26.000",
      "formatted_end": "02:23:27.000",
      "text": "آره"
    },
    {
      "id": 60,
      "start": 8607.0,
      "end": 8609.0,
      "formatted_start": "02:23:27.000",
      "formatted_end": "02:23:29.000",
      "text": "من تازه شروع کردم بخورم"
    },
    {
      "id": 61,
      "start": 8609.0,
      "end": 8613.92,
      "formatted_start": "02:23:29.000",
      "formatted_end": "02:23:33.920",
      "text": "بخوردن. چند وقته؟ نه کنتایی بخوردن و باز پید کردن. برگه. خودش که"
    },
    {
      "id": 62,
      "start": 8613.92,
      "end": 8618.72,
      "formatted_start": "02:23:33.920",
      "formatted_end": "02:23:38.720",
      "text": "میخوره بگه مرزی میتونه بخوره. آره دیگه بخوری نظر اینکه. آره. همون آره."
    },
    {
      "id": 63,
      "start": 8618.72,
      "end": 8624.12,
      "formatted_start": "02:23:38.720",
      "formatted_end": "02:23:44.120",
      "text": "بخورن. آره. بخورن. آره. بخوری. روز یه دونه. آره. شبیه به شبیه"
    },
    {
      "id": 64,
      "start": 8624.12,
      "end": 8632.24,
      "formatted_start": "02:23:44.120",
      "formatted_end": "02:23:52.240",
      "text": "بخوری. خواهیم که خواهیم. همچنین قطع میشه وست میشه. چند وقته این"
    },
    {
      "id": 65,
      "start": 8632.24,
      "end": 8634.24,
      "formatted_start": "02:23:52.240",
      "formatted_end": "02:23:54.240",
      "text": "من خیلی ساده همه چندیجوریم"
    },
    {
      "id": 66,
      "start": 8634.24,
      "end": 8635.24,
      "formatted_start": "02:23:54.240",
      "formatted_end": "02:23:55.240",
      "text": "پریود میشه همونست؟"
    },
    {
      "id": 67,
      "start": 8635.24,
      "end": 8636.24,
      "formatted_start": "02:23:55.240",
      "formatted_end": "02:23:56.240",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 8636.24,
      "end": 8637.24,
      "formatted_start": "02:23:56.240",
      "formatted_end": "02:23:57.240",
      "text": "چند وقته؟"
    },
    {
      "id": 69,
      "start": 8637.24,
      "end": 8639.24,
      "formatted_start": "02:23:57.240",
      "formatted_end": "02:23:59.240",
      "text": "الان یه دو سالی فکر کنم میشه"
    },
    {
      "id": 70,
      "start": 8639.24,
      "end": 8641.24,
      "formatted_start": "02:23:59.240",
      "formatted_end": "02:24:01.240",
      "text": "خیلی زودن پاشی داد"
    },
    {
      "id": 71,
      "start": 8641.24,
      "end": 8642.24,
      "formatted_start": "02:24:01.240",
      "formatted_end": "02:24:02.240",
      "text": "آره"
    },
    {
      "id": 72,
      "start": 8642.24,
      "end": 8644.24,
      "formatted_start": "02:24:02.240",
      "formatted_end": "02:24:04.240",
      "text": "مادر توی منجوری بود؟"
    },
    {
      "id": 73,
      "start": 8644.24,
      "end": 8646.24,
      "formatted_start": "02:24:04.240",
      "formatted_end": "02:24:06.240",
      "text": "آره مادرم خواهندم"
    },
    {
      "id": 74,
      "start": 8646.24,
      "end": 8648.24,
      "formatted_start": "02:24:06.240",
      "formatted_end": "02:24:08.240",
      "text": "بیتاویدی رو یه دکتر بهتون دادن؟"
    },
    {
      "id": 75,
      "start": 8648.24,
      "end": 8649.24,
      "formatted_start": "02:24:08.240",
      "formatted_end": "02:24:09.240",
      "text": "نه منوز ندارم"
    },
    {
      "id": 76,
      "start": 8649.24,
      "end": 8651.24,
      "formatted_start": "02:24:09.240",
      "formatted_end": "02:24:11.240",
      "text": "میخوام بیتاویدی رو روزانه بخورم"
    },
    {
      "id": 77,
      "start": 8651.24,
      "end": 8653.24,
      "formatted_start": "02:24:11.240",
      "formatted_end": "02:24:13.240",
      "text": "توی که هفته یا موانه"
    },
    {
      "id": 78,
      "start": 8653.24,
      "end": 8655.24,
      "formatted_start": "02:24:13.240",
      "formatted_end": "02:24:15.240",
      "text": "الان روزانه اصلا جواب بکنیم"
    },
    {
      "id": 79,
      "start": 8655.24,
      "end": 8661.24,
      "formatted_start": "02:24:15.240",
      "formatted_end": "02:24:21.240",
      "text": "اول باید 300 هزار آنپول بزنیم، پنجه هزار بخوریم"
    },
    {
      "id": 80,
      "start": 8661.24,
      "end": 8667.24,
      "formatted_start": "02:24:21.240",
      "formatted_end": "02:24:27.240",
      "text": "بعد تمام که شد، حالا سطح چون که به نرمال رسید روزی دو هزار بخوریم"
    },
    {
      "id": 81,
      "start": 8667.24,
      "end": 8671.24,
      "formatted_start": "02:24:27.240",
      "formatted_end": "02:24:31.240",
      "text": "اینجوری از اینجوری خیلی پایینه"
    },
    {
      "id": 82,
      "start": 8671.24,
      "end": 8675.24,
      "formatted_start": "02:24:31.240",
      "formatted_end": "02:24:35.240",
      "text": "خیلی پایینه، خوابم هم خیلی ناشونه خانده تو، اگر خواب خوبی نرم برم"
    },
    {
      "id": 83,
      "start": 8675.24,
      "end": 8678.24,
      "formatted_start": "02:24:35.240",
      "formatted_end": "02:24:38.240",
      "text": "آیا خواب بعد هم میبینی؟"
    },
    {
      "id": 84,
      "start": 8678.24,
      "end": 8682.24,
      "formatted_start": "02:24:38.240",
      "formatted_end": "02:24:42.240",
      "text": "خواب بعد، خواب اول زیاد میده، بعد میگه خوابم رو فراموش میکنه"
    },
    {
      "id": 85,
      "start": 8682.24,
      "end": 8685.86,
      "formatted_start": "02:24:42.240",
      "formatted_end": "02:24:45.860",
      "text": "خوبی اتفاقا یعنی که خوابت باید مرحله همیخوشی بگیر"
    },
    {
      "id": 86,
      "start": 8685.86,
      "end": 8687.06,
      "formatted_start": "02:24:45.860",
      "formatted_end": "02:24:47.060",
      "text": "استرس چی؟"
    },
    {
      "id": 87,
      "start": 8687.06,
      "end": 8689.96,
      "formatted_start": "02:24:47.060",
      "formatted_end": "02:24:49.960",
      "text": "استرس که خیلی دارم من پیش مادرم هستم"
    },
    {
      "id": 88,
      "start": 8689.96,
      "end": 8694.82,
      "formatted_start": "02:24:49.960",
      "formatted_end": "02:24:54.820",
      "text": "دائم یعنی همه اش نوست داره که من پیشش باشم"
    },
    {
      "id": 89,
      "start": 8694.82,
      "end": 8699.26,
      "formatted_start": "02:24:54.820",
      "formatted_end": "02:24:59.260",
      "text": "صدا میزنه و برخی بچه ها بیمیدونم"
    }
  ],
  "status": "completed"
}