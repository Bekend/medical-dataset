  "stt_segments": [
    {
      "id": 0,
      "start": 15900.0,
      "end": 15917.0,
      "formatted_start": "04:25:00.000",
      "formatted_end": "04:25:17.000",
      "text": "خانمتون من الان سه بار رفتم اتاق امر، سه بار اینها دو بار برا من فنر بذاشتن تو کلیه که افونت این قضیه ها دود که سنگ و کلیه من لیدن و شده و الان مزنم بخونه،"
    },
    {
      "id": 1,
      "start": 15917.0,
      "end": 15926.0,
      "formatted_start": "04:25:17.000",
      "formatted_end": "04:25:26.000",
      "text": "بگذارن شوهرم اجازه نمیدونه ببینم که اینجا بخوابانی بابرینش دیران، بعدن هم گفت اگر نخوابانی مزنم بخونش، باید بخوابان، یعنی سریع خوابانم."
    },
    {
      "id": 2,
      "start": 15926.0,
      "end": 15928.0,
      "formatted_start": "04:25:26.000",
      "formatted_end": "04:25:28.000",
      "text": "الان خوش کندت به؟"
    },
    {
      "id": 3,
      "start": 15928.0,
      "end": 15933.36,
      "formatted_start": "04:25:28.000",
      "formatted_end": "04:25:33.360",
      "text": "ده تا چیز داد، سروم داد، ده تا جنتومارسین را"
    },
    {
      "id": 4,
      "start": 15933.36,
      "end": 15935.52,
      "formatted_start": "04:25:33.360",
      "formatted_end": "04:25:35.520",
      "text": "و اونها را زدم تمام شد"
    },
    {
      "id": 5,
      "start": 15935.52,
      "end": 15938.92,
      "formatted_start": "04:25:35.520",
      "formatted_end": "04:25:38.920",
      "text": "بعد رفتم دوباره اون دستگاه را برداشت"
    },
    {
      "id": 6,
      "start": 15938.92,
      "end": 15940.92,
      "formatted_start": "04:25:38.920",
      "formatted_end": "04:25:40.920",
      "text": "باز دوباره دستگاه بذاشت"
    },
    {
      "id": 7,
      "start": 15940.92,
      "end": 15944.84,
      "formatted_start": "04:25:40.920",
      "formatted_end": "04:25:44.840",
      "text": "دیگه نداد، دیگه امید دارو خوشکننده داد و کپسور بود"
    },
    {
      "id": 8,
      "start": 15944.84,
      "end": 15945.76,
      "formatted_start": "04:25:44.840",
      "formatted_end": "04:25:45.760",
      "text": "تمام شد؟"
    },
    {
      "id": 9,
      "start": 15945.76,
      "end": 15946.56,
      "formatted_start": "04:25:45.760",
      "formatted_end": "04:25:46.560",
      "text": "آره تمام شد"
    },
    {
      "id": 10,
      "start": 15946.56,
      "end": 15948.04,
      "formatted_start": "04:25:46.560",
      "formatted_end": "04:25:48.040",
      "text": "خوشکن بخور فیلا"
    },
    {
      "id": 11,
      "start": 15948.04,
      "end": 15950.44,
      "formatted_start": "04:25:48.040",
      "formatted_end": "04:25:50.440",
      "text": "تا از ما شاید جار ندادیم"
    },
    {
      "id": 12,
      "start": 15950.44,
      "end": 15951.04,
      "formatted_start": "04:25:50.440",
      "formatted_end": "04:25:51.040",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 15951.04,
      "end": 15954.64,
      "formatted_start": "04:25:51.040",
      "formatted_end": "04:25:54.640",
      "text": "بعد این از این"
    },
    {
      "id": 14,
      "start": 15954.64,
      "end": 15961.64,
      "formatted_start": "04:25:54.640",
      "formatted_end": "04:26:01.640",
      "text": "یک دروی بهتون میدن زرمان رو قلبتون میاره پایین داره میره بالا برنگی خواهدتون برد میشه خب؟"
    },
    {
      "id": 15,
      "start": 15961.64,
      "end": 15962.64,
      "formatted_start": "04:26:01.640",
      "formatted_end": "04:26:02.640",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 15962.64,
      "end": 15966.64,
      "formatted_start": "04:26:02.640",
      "formatted_end": "04:26:06.640",
      "text": "دربانت رفته بالا شبها برد میشه خب؟ روبا بخوری خب؟"
    },
    {
      "id": 17,
      "start": 15966.64,
      "end": 15971.64,
      "formatted_start": "04:26:06.640",
      "formatted_end": "04:26:11.640",
      "text": "مثلا این عمل اصلا خیلی من عذیب کرده"
    },
    {
      "id": 18,
      "start": 15971.64,
      "end": 15972.64,
      "formatted_start": "04:26:11.640",
      "formatted_end": "04:26:12.640",
      "text": "برس آهنگ میخوری؟"
    },
    {
      "id": 19,
      "start": 15972.64,
      "end": 15973.64,
      "formatted_start": "04:26:12.640",
      "formatted_end": "04:26:13.640",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 15973.64,
      "end": 15977.64,
      "formatted_start": "04:26:13.640",
      "formatted_end": "04:26:17.640",
      "text": "حتما برد بخوری؟ شکمتون صرف بیکار نه؟"
    },
    {
      "id": 21,
      "start": 15977.64,
      "end": 15980.64,
      "formatted_start": "04:26:17.640",
      "formatted_end": "04:26:20.640",
      "text": "آره چرا؟ شما یه مستت هم برسید"
    },
    {
      "id": 22,
      "start": 15980.64,
      "end": 15982.64,
      "formatted_start": "04:26:20.640",
      "formatted_end": "04:26:22.640",
      "text": "آهنگ خارجی برنیستم یا ایرانی؟"
    },
    {
      "id": 23,
      "start": 15982.64,
      "end": 15987.64,
      "formatted_start": "04:26:22.640",
      "formatted_end": "04:26:27.640",
      "text": "از اینکه از اینکه از اینکه خارجی بودن با بارم پول بدن بخرنده نه؟"
    },
    {
      "id": 24,
      "start": 15987.64,
      "end": 15990.64,
      "formatted_start": "04:26:27.640",
      "formatted_end": "04:26:30.640",
      "text": "بسته چند دنونا؟"
    },
    {
      "id": 25,
      "start": 15990.64,
      "end": 15992.64,
      "formatted_start": "04:26:30.640",
      "formatted_end": "04:26:32.640",
      "text": "650 تونه"
    },
    {
      "id": 26,
      "start": 15992.64,
      "end": 15993.64,
      "formatted_start": "04:26:32.640",
      "formatted_end": "04:26:33.640",
      "text": "ارونسته یاره؟"
    },
    {
      "id": 27,
      "start": 15993.64,
      "end": 15995.64,
      "formatted_start": "04:26:33.640",
      "formatted_end": "04:26:35.640",
      "text": "30 تونه"
    },
    {
      "id": 28,
      "start": 15995.64,
      "end": 15998.64,
      "formatted_start": "04:26:35.640",
      "formatted_end": "04:26:38.640",
      "text": "خدمت شما"
    },
    {
      "id": 29,
      "start": 16001.64,
      "end": 16006.64,
      "formatted_start": "04:26:41.640",
      "formatted_end": "04:26:46.640",
      "text": "خدا یاز من ادرهان میندسن انجام بده خواهی؟"
    },
    {
      "id": 30,
      "start": 16006.64,
      "end": 16012.64,
      "formatted_start": "04:26:46.640",
      "formatted_end": "04:26:52.640",
      "text": "این دواره که از سینوگرافی هم کرد، دواره که برد و تا نمیدونید."
    },
    {
      "id": 31,
      "start": 16012.64,
      "end": 16014.64,
      "formatted_start": "04:26:52.640",
      "formatted_end": "04:26:54.640",
      "text": "هیچی نوشته باشد درستش؟"
    },
    {
      "id": 32,
      "start": 16014.64,
      "end": 16021.64,
      "formatted_start": "04:26:54.640",
      "formatted_end": "04:27:01.640",
      "text": "چون اولی که سهر نظر کرد، آن منو گفت یه چار میل تو گوشت مانده، دکتر."
    },
    {
      "id": 33,
      "start": 16021.64,
      "end": 16024.64,
      "formatted_start": "04:27:01.640",
      "formatted_end": "04:27:04.640",
      "text": "بعد دیگه پنج رو بستری شدم."
    },
    {
      "id": 34,
      "start": 16024.64,
      "end": 16029.64,
      "formatted_start": "04:27:04.640",
      "formatted_end": "04:27:09.640",
      "text": "بعد باز آن گفت که اون میله که بشیم این اعتمالا افتاده."
    },
    {
      "id": 35,
      "start": 16029.64,
      "end": 16030.64,
      "formatted_start": "04:27:09.640",
      "formatted_end": "04:27:10.640",
      "text": "کدوم اینو بگفت؟"
    },
    {
      "id": 36,
      "start": 16030.64,
      "end": 16034.64,
      "formatted_start": "04:27:10.640",
      "formatted_end": "04:27:14.640",
      "text": "از ما شهردار می رویستم بریم می فرمیم چی خواهیم"
    },
    {
      "id": 37,
      "start": 16034.64,
      "end": 16040.64,
      "formatted_start": "04:27:14.640",
      "formatted_end": "04:27:20.640",
      "text": "بله الان باز جدیدن ادرال هم کثیب شده"
    },
    {
      "id": 38,
      "start": 16040.64,
      "end": 16042.64,
      "formatted_start": "04:27:20.640",
      "formatted_end": "04:27:22.640",
      "text": "موقعی که سوام می زدن خیلی تمیز بود"
    },
    {
      "id": 39,
      "start": 16042.64,
      "end": 16044.64,
      "formatted_start": "04:27:22.640",
      "formatted_end": "04:27:24.640",
      "text": "اونا همین من مشکولم"
    },
    {
      "id": 40,
      "start": 16044.64,
      "end": 16047.64,
      "formatted_start": "04:27:24.640",
      "formatted_end": "04:27:27.640",
      "text": "الان من خباشگاه شروع کردم چون مشکولم بودم"
    },
    {
      "id": 41,
      "start": 16047.64,
      "end": 16049.64,
      "formatted_start": "04:27:27.640",
      "formatted_end": "04:27:29.640",
      "text": "هنوز دوله داره یا کشیده هر جا؟"
    },
    {
      "id": 42,
      "start": 16049.64,
      "end": 16053.64,
      "formatted_start": "04:27:29.640",
      "formatted_end": "04:27:33.640",
      "text": "نه دوله رو دباره اصلا بردم من مردم رو بردم بیمارستان این"
    },
    {
      "id": 43,
      "start": 16053.64,
      "end": 16054.64,
      "formatted_start": "04:27:33.640",
      "formatted_end": "04:27:34.640",
      "text": "تو اونو میرم کشید؟"
    },
    {
      "id": 44,
      "start": 16054.64,
      "end": 16056.64,
      "formatted_start": "04:27:34.640",
      "formatted_end": "04:27:36.640",
      "text": "اونو بردم درش بیرم"
    },
    {
      "id": 45,
      "start": 16056.64,
      "end": 16064.14,
      "formatted_start": "04:27:36.640",
      "formatted_end": "04:27:44.140",
      "text": "در آن برای که قالب چسپندگی داشته گشات شده الان و فونت خوش شده اونو فونتی که داشتی"
    },
    {
      "id": 46,
      "start": 16064.14,
      "end": 16070.98,
      "formatted_start": "04:27:44.140",
      "formatted_end": "04:27:50.980",
      "text": "ما مرخصت دیم و کردیم بایدیم سکسیسی میاد باید در چیز دکتور بزشت باشه"
    },
    {
      "id": 47,
      "start": 16070.98,
      "end": 16074.5,
      "formatted_start": "04:27:50.980",
      "formatted_end": "04:27:54.500",
      "text": "گفتیم همه احساسیت نشان میده اونا همه را زد"
    },
    {
      "id": 48,
      "start": 16074.5,
      "end": 16079.14,
      "formatted_start": "04:27:54.500",
      "formatted_end": "04:27:59.140",
      "text": "حالا الان ببینیم جهاز آزماش ادرارتون چی میاد خب؟"
    },
    {
      "id": 49,
      "start": 16080.14,
      "end": 16081.74,
      "formatted_start": "04:28:00.140",
      "formatted_end": "04:28:01.740",
      "text": "آنها باید برن"
    },
    {
      "id": 50,
      "start": 16081.74,
      "end": 16082.96,
      "formatted_start": "04:28:01.740",
      "formatted_end": "04:28:02.960",
      "text": "دارو آن نمیشه؟"
    },
    {
      "id": 51,
      "start": 16082.96,
      "end": 16084.64,
      "formatted_start": "04:28:02.960",
      "formatted_end": "04:28:04.640",
      "text": "آن نمیشه یا ناشا باید برن"
    },
    {
      "id": 52,
      "start": 16084.64,
      "end": 16085.64,
      "formatted_start": "04:28:04.640",
      "formatted_end": "04:28:05.640",
      "text": "آره هم بود"
    },
    {
      "id": 53,
      "start": 16086.14,
      "end": 16087.14,
      "formatted_start": "04:28:06.140",
      "formatted_end": "04:28:07.140",
      "text": "اولیش رو برسید"
    },
    {
      "id": 54,
      "start": 16087.14,
      "end": 16088.88,
      "formatted_start": "04:28:07.140",
      "formatted_end": "04:28:08.880",
      "text": "اون دوست گیرده مریض همین الان اومده"
    },
    {
      "id": 55,
      "start": 16088.88,
      "end": 16090.48,
      "formatted_start": "04:28:08.880",
      "formatted_end": "04:28:10.480",
      "text": "میبینیش؟ میبینی نه هایی یا نه؟"
    },
    {
      "id": 56,
      "start": 16090.48,
      "end": 16091.88,
      "formatted_start": "04:28:10.480",
      "formatted_end": "04:28:11.880",
      "text": "ببینیش که برسید"
    },
    {
      "id": 57,
      "start": 16091.88,
      "end": 16092.64,
      "formatted_start": "04:28:11.880",
      "formatted_end": "04:28:12.640",
      "text": "سلامتا باشه"
    },
    {
      "id": 58,
      "start": 16092.64,
      "end": 16093.88,
      "formatted_start": "04:28:12.640",
      "formatted_end": "04:28:13.880",
      "text": "میخواهی برسید بودو"
    },
    {
      "id": 59,
      "start": 16094.88,
      "end": 16095.88,
      "formatted_start": "04:28:14.880",
      "formatted_end": "04:28:15.880",
      "text": "برسید برسید بودو"
    },
    {
      "id": 60,
      "start": 16098.4,
      "end": 16098.88,
      "formatted_start": "04:28:18.400",
      "formatted_end": "04:28:18.880",
      "text": "سلام"
    },
    {
      "id": 61,
      "start": 16098.88,
      "end": 16099.48,
      "formatted_start": "04:28:18.880",
      "formatted_end": "04:28:19.480",
      "text": "سلام"
    },
    {
      "id": 62,
      "start": 16099.48,
      "end": 16099.98,
      "formatted_start": "04:28:19.480",
      "formatted_end": "04:28:19.980",
      "text": "هنچی نیست؟"
    },
    {
      "id": 63,
      "start": 16099.98,
      "end": 16102.88,
      "formatted_start": "04:28:19.980",
      "formatted_end": "04:28:22.880",
      "text": "انا دارو هم نوشته برم بگم دارو خالی هاره"
    },
    {
      "id": 64,
      "start": 16107.14,
      "end": 16108.14,
      "formatted_start": "04:28:27.140",
      "formatted_end": "04:28:28.140",
      "text": "نفر سرسید شد"
    },
    {
      "id": 65,
      "start": 16108.14,
      "end": 16109.14,
      "formatted_start": "04:28:28.140",
      "formatted_end": "04:28:29.140",
      "text": "چرا؟"
    },
    {
      "id": 66,
      "start": 16110.14,
      "end": 16113.14,
      "formatted_start": "04:28:30.140",
      "formatted_end": "04:28:33.140",
      "text": "اون مو خوشگینجو براشم بردون نوشته برسید"
    },
    {
      "id": 67,
      "start": 16114.64,
      "end": 16144.64,
      "formatted_start": "04:28:34.640",
      "formatted_end": "04:29:04.640",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 68,
      "start": 16144.64,
      "end": 16146.64,
      "formatted_start": "04:29:04.640",
      "formatted_end": "04:29:06.640",
      "text": "چربیت خیلی بالا قرار کنید"
    },
    {
      "id": 69,
      "start": 16146.64,
      "end": 16148.64,
      "formatted_start": "04:29:06.640",
      "formatted_end": "04:29:08.640",
      "text": "از نظر بگیریم که تیرویت خوب شده"
    },
    {
      "id": 70,
      "start": 16148.64,
      "end": 16150.64,
      "formatted_start": "04:29:08.640",
      "formatted_end": "04:29:10.640",
      "text": "خوبه"
    },
    {
      "id": 71,
      "start": 16150.64,
      "end": 16152.64,
      "formatted_start": "04:29:10.640",
      "formatted_end": "04:29:12.640",
      "text": "قرارات خیلی بالا هست"
    },
    {
      "id": 72,
      "start": 16152.64,
      "end": 16154.64,
      "formatted_start": "04:29:12.640",
      "formatted_end": "04:29:14.640",
      "text": "قرارات خیلی بالا هست"
    },
    {
      "id": 73,
      "start": 16154.64,
      "end": 16156.64,
      "formatted_start": "04:29:14.640",
      "formatted_end": "04:29:16.640",
      "text": "چکار میکنی؟"
    },
    {
      "id": 74,
      "start": 16156.64,
      "end": 16158.64,
      "formatted_start": "04:29:16.640",
      "formatted_end": "04:29:18.640",
      "text": "هندون خرباز هم میخورید؟"
    },
    {
      "id": 75,
      "start": 16158.64,
      "end": 16160.64,
      "formatted_start": "04:29:18.640",
      "formatted_end": "04:29:20.640",
      "text": "بله اندوانا بخورم"
    },
    {
      "id": 76,
      "start": 16160.64,
      "end": 16162.64,
      "formatted_start": "04:29:20.640",
      "formatted_end": "04:29:22.640",
      "text": "اموننی هست"
    },
    {
      "id": 77,
      "start": 16162.64,
      "end": 16164.64,
      "formatted_start": "04:29:22.640",
      "formatted_end": "04:29:24.640",
      "text": "خب من چکار کنم از این هندون خرباز"
    },
    {
      "id": 78,
      "start": 16164.64,
      "end": 16166.64,
      "formatted_start": "04:29:24.640",
      "formatted_end": "04:29:26.640",
      "text": "بله چیه"
    },
    {
      "id": 79,
      "start": 16166.64,
      "end": 16168.64,
      "formatted_start": "04:29:26.640",
      "formatted_end": "04:29:28.640",
      "text": "قرص چربیت بخورید"
    },
    {
      "id": 80,
      "start": 16168.64,
      "end": 16170.64,
      "formatted_start": "04:29:28.640",
      "formatted_end": "04:29:30.640",
      "text": "بگو خودش بگیریم"
    },
    {
      "id": 81,
      "start": 16170.64,
      "end": 16172.64,
      "formatted_start": "04:29:30.640",
      "formatted_end": "04:29:32.640",
      "text": "قرارات چکار کنید"
    },
    {
