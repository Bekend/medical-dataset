  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6304.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:04.000",
      "text": "خب بچه این پروندش بد ببر اداره تعیید نمیشه."
    },
    {
      "id": 1,
      "start": 6304.0,
      "end": 6308.0,
      "formatted_start": "01:45:04.000",
      "formatted_end": "01:45:08.000",
      "text": "بر یه بد آره بد و توش دیابتش هم بنمیسیم."
    },
    {
      "id": 2,
      "start": 6308.0,
      "end": 6313.0,
      "formatted_start": "01:45:08.000",
      "formatted_end": "01:45:13.000",
      "text": "و این قنده شو خیلی با الازمان بشه و گفتم فکر کنم بر بستجی بشه تنظیم بشه."
    },
    {
      "id": 3,
      "start": 6313.0,
      "end": 6316.0,
      "formatted_start": "01:45:13.000",
      "formatted_end": "01:45:16.000",
      "text": "کلیه شو هم کمکار شده."
    },
    {
      "id": 4,
      "start": 6318.0,
      "end": 6320.0,
      "formatted_start": "01:45:18.000",
      "formatted_end": "01:45:20.000",
      "text": "هم کلیه شو کمکار شده."
    },
    {
      "id": 5,
      "start": 6320.0,
      "end": 6343.26,
      "formatted_start": "01:45:20.000",
      "formatted_end": "01:45:43.260",
      "text": "از اینجوری باید همداشت کلیش رو درست کنیم"
    },
    {
      "id": 6,
      "start": 6343.26,
      "end": 6373.26,
      "formatted_start": "01:45:43.260",
      "formatted_end": "01:46:13.260",
      "text": "اینجا باید برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم که برداریم ک"
    },
    {
      "id": 7,
      "start": 6373.26,
      "end": 6379.26,
      "formatted_start": "01:46:13.260",
      "formatted_end": "01:46:19.260",
      "text": "دوستان دارال بیاد برد بگه گلوری باشه که آقا قبل نهار بخوره"
    },
    {
      "id": 8,
      "start": 6379.26,
      "end": 6382.26,
      "formatted_start": "01:46:19.260",
      "formatted_end": "01:46:22.260",
      "text": "اگرم که چون کلیش کمکار شده"
    },
    {
      "id": 9,
      "start": 6384.26,
      "end": 6387.26,
      "formatted_start": "01:46:24.260",
      "formatted_end": "01:46:27.260",
      "text": "چون اگه جسم جون نداشته باشه کلیش خیلی کمکار شده"
    },
    {
      "id": 10,
      "start": 6387.26,
      "end": 6392.26,
      "formatted_start": "01:46:27.260",
      "formatted_end": "01:46:32.260",
      "text": "اگرم که نمیتونن که اونش دستگاه کنم قرار میشه تنظیم کنم"
    },
    {
      "id": 11,
      "start": 6392.26,
      "end": 6394.26,
      "formatted_start": "01:46:32.260",
      "formatted_end": "01:46:34.260",
      "text": "دو فردن اون رو بشم بچن"
    },
    {
      "id": 12,
      "start": 6394.26,
      "end": 6396.26,
      "formatted_start": "01:46:34.260",
      "formatted_end": "01:46:36.260",
      "text": "بعد من"
    },
    {
      "id": 13,
      "start": 6396.26,
      "end": 6424.26,
      "formatted_start": "01:46:36.260",
      "formatted_end": "01:47:04.260",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 6426.26,
      "end": 6428.26,
      "formatted_start": "01:47:06.260",
      "formatted_end": "01:47:08.260",
      "text": "این دکتر میدوند که از پیشتکین آزمایش داره"
    },
    {
      "id": 15,
      "start": 6428.26,
      "end": 6430.26,
      "formatted_start": "01:47:08.260",
      "formatted_end": "01:47:10.260",
      "text": "آره میدونم"
    },
    {
      "id": 16,
      "start": 6430.26,
      "end": 6432.26,
      "formatted_start": "01:47:10.260",
      "formatted_end": "01:47:12.260",
      "text": "این آزمایش هاشه"
    },
    {
      "id": 17,
      "start": 6432.26,
      "end": 6434.26,
      "formatted_start": "01:47:12.260",
      "formatted_end": "01:47:14.260",
      "text": "میبای کنیم"
    },
    {
      "id": 18,
      "start": 6434.26,
      "end": 6436.26,
      "formatted_start": "01:47:14.260",
      "formatted_end": "01:47:16.260",
      "text": "چیه خیلی خیلی خیلی خیلی"
    },
    {
      "id": 19,
      "start": 6436.26,
      "end": 6438.26,
      "formatted_start": "01:47:16.260",
      "formatted_end": "01:47:18.260",
      "text": "چی کنیم؟"
    },
    {
      "id": 20,
      "start": 6438.26,
      "end": 6440.26,
      "formatted_start": "01:47:18.260",
      "formatted_end": "01:47:20.260",
      "text": "مزکی از اینکه میکنه؟"
    },
    {
      "id": 21,
      "start": 6440.26,
      "end": 6442.26,
      "formatted_start": "01:47:20.260",
      "formatted_end": "01:47:22.260",
      "text": "نمیدونم پیش این آقایتو فراده رفته که میگن"
    },
    {
      "id": 22,
      "start": 6442.26,
      "end": 6444.26,
      "formatted_start": "01:47:22.260",
      "formatted_end": "01:47:24.260",
      "text": "براش این چی نه؟"
    },
    {
      "id": 23,
      "start": 6444.26,
      "end": 6446.26,
      "formatted_start": "01:47:24.260",
      "formatted_end": "01:47:26.260",
      "text": "او خیلی خیلی شدید داره"
    },
    {
      "id": 24,
      "start": 6446.26,
      "end": 6448.26,
      "formatted_start": "01:47:26.260",
      "formatted_end": "01:47:28.260",
      "text": "تیرویدش کمکار شده"
    },
    {
      "id": 25,
      "start": 6448.26,
      "end": 6450.26,
      "formatted_start": "01:47:28.260",
      "formatted_end": "01:47:30.260",
      "text": "و کلیدش داره نمیشده"
    },
    {
      "id": 26,
      "start": 6450.26,
      "end": 6452.26,
      "formatted_start": "01:47:30.260",
      "formatted_end": "01:47:32.260",
      "text": "آره این ارها"
    },
    {
      "id": 27,
      "start": 6452.26,
      "end": 6454.26,
      "formatted_start": "01:47:32.260",
      "formatted_end": "01:47:34.260",
      "text": "از اینجا که از آزمایش را برده بود."
    },
    {
      "id": 28,
      "start": 6454.26,
      "end": 6456.26,
      "formatted_start": "01:47:34.260",
      "formatted_end": "01:47:36.260",
      "text": "الان حالت خوبه؟"
    },
    {
      "id": 29,
      "start": 6456.26,
      "end": 6458.26,
      "formatted_start": "01:47:36.260",
      "formatted_end": "01:47:38.260",
      "text": "این حال بود."
    },
    {
      "id": 30,
      "start": 6458.26,
      "end": 6460.26,
      "formatted_start": "01:47:38.260",
      "formatted_end": "01:47:40.260",
      "text": "آزمایش را برده بود."
    },
    {
      "id": 31,
      "start": 6460.26,
      "end": 6462.26,
      "formatted_start": "01:47:40.260",
      "formatted_end": "01:47:42.260",
      "text": "بعد از آزمایش را برده بود."
    },
    {
      "id": 32,
      "start": 6462.26,
      "end": 6464.26,
      "formatted_start": "01:47:42.260",
      "formatted_end": "01:47:44.260",
      "text": "بعد گرده بود سونوگرافی."
    },
    {
      "id": 33,
      "start": 6464.26,
      "end": 6466.26,
      "formatted_start": "01:47:44.260",
      "formatted_end": "01:47:46.260",
      "text": "بعد گرده بود سونوگرافی."
    },
    {
      "id": 34,
      "start": 6466.26,
      "end": 6468.26,
      "formatted_start": "01:47:46.260",
      "formatted_end": "01:47:48.260",
      "text": "من خودم دیروز بردم این ها را پیچش سونوگرافی را نگاه کرد."
    },
    {
      "id": 35,
      "start": 6468.26,
      "end": 6470.26,
      "formatted_start": "01:47:48.260",
      "formatted_end": "01:47:50.260",
      "text": "گرده بود که هیچش کار نداره."
    },
    {
      "id": 36,
      "start": 6470.26,
      "end": 6472.26,
      "formatted_start": "01:47:50.260",
      "formatted_end": "01:47:52.260",
      "text": "بره هیچ درو هم لازم نداره."
    },
    {
      "id": 37,
      "start": 6472.26,
      "end": 6474.26,
      "formatted_start": "01:47:52.260",
      "formatted_end": "01:47:54.260",
      "text": "بعد من هم نارب شدم."
    },
    {
      "id": 38,
      "start": 6474.26,
      "end": 6476.26,
      "formatted_start": "01:47:54.260",
      "formatted_end": "01:47:56.260",
      "text": "از مایر کبدش این همه بلایی کنید"
    },
    {
      "id": 39,
      "start": 6476.26,
      "end": 6480.26,
      "formatted_start": "01:47:56.260",
      "formatted_end": "01:48:00.260",
      "text": "ای هست میگید فقط نگه که من برای همین نارستون یه نیز روستان دارم بریم"
    },
    {
      "id": 40,
      "start": 6480.26,
      "end": 6481.26,
      "formatted_start": "01:48:00.260",
      "formatted_end": "01:48:01.260",
      "text": "سه آوردم به شما"
    },
    {
      "id": 41,
      "start": 6481.26,
      "end": 6483.26,
      "formatted_start": "01:48:01.260",
      "formatted_end": "01:48:03.260",
      "text": "شیش برابر مامان تیرویدش"
    },
    {
      "id": 42,
      "start": 6483.26,
      "end": 6487.26,
      "formatted_start": "01:48:03.260",
      "formatted_end": "01:48:07.260",
      "text": "مامان قرص تیروید به آزمایش اوترالش و خونت خیلی شدید کرده"
    },
    {
      "id": 43,
      "start": 6487.26,
      "end": 6489.26,
      "formatted_start": "01:48:07.260",
      "formatted_end": "01:48:09.260",
      "text": "مامان قرص تیروید میخوره"
    },
    {
      "id": 44,
      "start": 6489.26,
      "end": 6490.26,
      "formatted_start": "01:48:09.260",
      "formatted_end": "01:48:10.260",
      "text": "آره"
    },
    {
      "id": 45,
      "start": 6490.26,
      "end": 6494.26,
      "formatted_start": "01:48:10.260",
      "formatted_end": "01:48:14.260",
      "text": "آره همین قرص بیرقی تیروید یه بار بهش دادی بود فکر کنیم همینطور شده"
    },
    {
      "id": 46,
      "start": 6494.26,
      "end": 6498.94,
      "formatted_start": "01:48:14.260",
      "formatted_end": "01:48:18.940",
      "text": "او خرس تیرویدشو درست نمیخوره ناشته تیرویدش خیلی کم کار شده"
    },
    {
      "id": 47,
      "start": 6498.94,
      "end": 6501.76,
      "formatted_start": "01:48:18.940",
      "formatted_end": "01:48:21.760",
      "text": "اونم میتونه کبدو اینقدر داغون کنه"
    },
    {
      "id": 48,
      "start": 6501.76,
      "end": 6505.64,
      "formatted_start": "01:48:21.760",
      "formatted_end": "01:48:25.640",
      "text": "باید مسکن اینا دیتروفناکی نمیخورن"
    },
    {
      "id": 49,
      "start": 6505.64,
      "end": 6508.56,
      "formatted_start": "01:48:25.640",
      "formatted_end": "01:48:28.560",
      "text": "باید تو زیاده فراده قبلی مامان نگاه کنن"
    },
    {
      "id": 50,
      "start": 6508.56,
      "end": 6509.94,
      "formatted_start": "01:48:28.560",
      "formatted_end": "01:48:29.940",
      "text": "مامان تو میشناستن"
    },
    {
      "id": 51,
      "start": 6509.94,
      "end": 6511.94,
      "formatted_start": "01:48:29.940",
      "formatted_end": "01:48:31.940",
      "text": "آره نه پیش اقای فراده رفته"
    },
    {
      "id": 52,
      "start": 6511.94,
      "end": 6515.78,
      "formatted_start": "01:48:31.940",
      "formatted_end": "01:48:35.780",
      "text": "اصلا وقتا داروهایی بهش میده که اصلا"
    },
    {
      "id": 53,
      "start": 6515.78,
      "end": 6522.78,
      "formatted_start": "01:48:35.780",
      "formatted_end": "01:48:42.780",
      "text": "چند بار دیگه هم همین آزمایش ها رو تکرار کرده و بی توجهی کرده این مدر قبلش چی شده؟"
    },
    {
      "id": 54,
      "start": 6522.78,
      "end": 6525.78,
      "formatted_start": "01:48:42.780",
      "formatted_end": "01:48:45.780",
      "text": "دو تا فردی هم هستند، نمیدونم"
    },
    {
      "id": 55,
      "start": 6525.78,
      "end": 6533.78,
      "formatted_start": "01:48:45.780",
      "formatted_end": "01:48:53.780",
      "text": "نه بابا دیوز رفتند که این اشکالی نداره، بعد ناراض شدند به این قمعه سونوگرافی رو با خود این آزمایش رو دادید، این آزمایش رو رو روی آنسونش دارید"
    },
    {
      "id": 56,
      "start": 6533.78,
      "end": 6535.78,
      "formatted_start": "01:48:53.780",
      "formatted_end": "01:48:55.780",
      "text": "آزمایششون مدیده دقیقا"
    },
    {
      "id": 57,
      "start": 6535.78,
      "end": 6537.78,
      "formatted_start": "01:48:55.780",
      "formatted_end": "01:48:57.780",
      "text": "نه جلوش بود دیگه"
    },
    {
      "id": 58,
      "start": 6537.78,
      "end": 6541.78,
      "formatted_start": "01:48:57.780",
      "formatted_end": "01:49:01.780",
      "text": "آزمایش نبا کرده بوده سونوگرافی فلسطین دیگه"
    },
    {
      "id": 59,
      "start": 6541.78,
      "end": 6546.78,
      "formatted_start": "01:49:01.780",
      "formatted_end": "01:49:06.780",
      "text": "من که بهش دارایی که دادم چیزی نداره که کبدشو بتونه این کار بکنه"
    },
    {
      "id": 60,
      "start": 6546.78,
      "end": 6550.78,
      "formatted_start": "01:49:06.780",
      "formatted_end": "01:49:10.780",
      "text": "الان دارم میرون باید از برج سه ماما دونه دیگه نمیمده اونجا"
    },
    {
      "id": 61,
      "start": 6550.78,
      "end": 6554.78,
      "formatted_start": "01:49:10.780",
      "formatted_end": "01:49:14.780",
      "text": "بعد برج قبلم"
    },
    {
      "id": 62,
      "start": 6554.78,
      "end": 6558.78,
      "formatted_start": "01:49:14.780",
      "formatted_end": "01:49:18.780",
      "text": "چی خورده؟ یه چیزی؟ یا دارگیاهی نخورده؟"
    },
    {
      "id": 63,
      "start": 6558.78,
      "end": 6559.78,
      "formatted_start": "01:49:18.780",
      "formatted_end": "01:49:19.780",
      "text": "نه"
    },
    {
      "id": 64,
      "start": 6559.78,
      "end": 6562.78,
      "formatted_start": "01:49:19.780",
      "formatted_end": "01:49:22.780",
      "text": "داردبای گیاهی خورده کبدشو اینجوری کرده؟"
    },
    {
      "id": 65,
      "start": 6562.78,
      "end": 6592.78,
      "formatted_start": "01:49:22.780",
      "formatted_end": "01:49:52.780",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 66,
      "start": 6592.78,
      "end": 6594.78,
      "formatted_start": "01:49:52.780",
      "formatted_end": "01:49:54.780",
      "text": "ندادن بهش"
    },
    {
      "id": 67,
      "start": 6594.78,
      "end": 6596.78,
      "formatted_start": "01:49:54.780",
      "formatted_end": "01:49:56.780",
      "text": "همون آقای فایل مالی گفتش دید"
    },
    {
      "id": 68,
      "start": 6596.78,
      "end": 6598.78,
      "formatted_start": "01:49:56.780",
      "formatted_end": "01:49:58.780",
      "text": "بلواتیروکسین سرد داده"
    },
    {
      "id": 69,
      "start": 6598.78,
      "end": 6600.78,
      "formatted_start": "01:49:58.780",
      "formatted_end": "01:50:00.780",
      "text": "میتونه پرسش"
    }
  ],
  "status": "completed"
}