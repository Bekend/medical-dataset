  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10502.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:02.000",
      "text": "همانطور که بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 10530.0,
      "end": 10533.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:33.000",
      "text": "از اینجور درست نرستیم که چکر کامل برمیستم"
    },
    {
      "id": 2,
      "start": 10533.0,
      "end": 10537.0,
      "formatted_start": "02:55:33.000",
      "formatted_end": "02:55:37.000",
      "text": "برسید برمیستیم، فرق کامل چکر کامل نرسید برمیستیم"
    },
    {
      "id": 3,
      "start": 10537.0,
      "end": 10540.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:40.000",
      "text": "اونو جدا جدا برمیستیم"
    },
    {
      "id": 4,
      "start": 10547.0,
      "end": 10549.0,
      "formatted_start": "02:55:47.000",
      "formatted_end": "02:55:49.000",
      "text": "سیاد صدا دوانو کش میشه"
    },
    {
      "id": 5,
      "start": 10549.0,
      "end": 10551.0,
      "formatted_start": "02:55:49.000",
      "formatted_end": "02:55:51.000",
      "text": "ترش زیاد میکنیم"
    },
    {
      "id": 6,
      "start": 10551.0,
      "end": 10553.0,
      "formatted_start": "02:55:51.000",
      "formatted_end": "02:55:53.000",
      "text": "ترش هم زیاد میکنه و کش برمیشه"
    },
    {
      "id": 7,
      "start": 10553.0,
      "end": 10555.0,
      "formatted_start": "02:55:53.000",
      "formatted_end": "02:55:55.000",
      "text": "یا ترش یا غندتون برمیشه"
    },
    {
      "id": 8,
      "start": 10555.0,
      "end": 10557.0,
      "formatted_start": "02:55:55.000",
      "formatted_end": "02:55:57.000",
      "text": "از خواب که بلند میشه و خیلی غندتون برمیشه"
    },
    {
      "id": 9,
      "start": 10557.0,
      "end": 10559.0,
      "formatted_start": "02:55:57.000",
      "formatted_end": "02:55:59.000",
      "text": "یا ترش زیاد میکنیم یا غندتون برمیشه"
    },
    {
      "id": 10,
      "start": 10559.0,
      "end": 10561.0,
      "formatted_start": "02:55:59.000",
      "formatted_end": "02:56:01.000",
      "text": "دوتا بیشتر حالت نداره"
    },
    {
      "id": 11,
      "start": 10561.0,
      "end": 10563.0,
      "formatted_start": "02:56:01.000",
      "formatted_end": "02:56:03.000",
      "text": "قلدش بردست"
    },
    {
      "id": 12,
      "start": 10563.0,
      "end": 10565.0,
      "formatted_start": "02:56:03.000",
      "formatted_end": "02:56:05.000",
      "text": "اعتمالا قلدتون؟"
    },
    {
      "id": 13,
      "start": 10565.0,
      "end": 10567.0,
      "formatted_start": "02:56:05.000",
      "formatted_end": "02:56:07.000",
      "text": "قلد من تصورم و خوش میشه"
    },
    {
      "id": 14,
      "start": 10571.0,
      "end": 10573.0,
      "formatted_start": "02:56:11.000",
      "formatted_end": "02:56:13.000",
      "text": "خوش ناشتایی میخونی؟"
    },
    {
      "id": 15,
      "start": 10573.0,
      "end": 10575.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:15.000",
      "text": "نه خوش ناشتایی"
    },
    {
      "id": 16,
      "start": 10579.0,
      "end": 10581.0,
      "formatted_start": "02:56:19.000",
      "formatted_end": "02:56:21.000",
      "text": "اعتمالا دیوز قلدشون ها برای برای ناشتایی"
    },
    {
      "id": 17,
      "start": 10581.0,
      "end": 10583.0,
      "formatted_start": "02:56:21.000",
      "formatted_end": "02:56:23.000",
      "text": "مرسا قلدتون رو چک نکردن؟"
    },
    {
      "id": 18,
      "start": 10583.0,
      "end": 10585.0,
      "formatted_start": "02:56:23.000",
      "formatted_end": "02:56:25.000",
      "text": "نه"
    },
    {
      "id": 19,
      "start": 10585.0,
      "end": 10587.0,
      "formatted_start": "02:56:25.000",
      "formatted_end": "02:56:27.000",
      "text": "از انگوشتون چک نکرده"
    },
    {
      "id": 20,
      "start": 10587.0,
      "end": 10589.0,
      "formatted_start": "02:56:27.000",
      "formatted_end": "02:56:29.000",
      "text": "باید بشه کنیم"
    },
    {
      "id": 21,
      "start": 10591.0,
      "end": 10593.0,
      "formatted_start": "02:56:31.000",
      "formatted_end": "02:56:33.000",
      "text": "گفتیم من قدم دارم"
    },
    {
      "id": 22,
      "start": 10593.0,
