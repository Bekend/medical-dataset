  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9007.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:07.000",
      "text": "مهمترین چیز تو اقتراحات رو دیده شما به خود اون استرس نخوابیدن وارد نکنید، نخوابید."
    },
    {
      "id": 1,
      "start": 9007.0,
      "end": 9011.0,
      "formatted_start": "02:30:07.000",
      "formatted_end": "02:30:11.000",
      "text": "بگو من بدنم همه قدقا و سروالی چه مهم است؟"
    },
    {
      "id": 2,
      "start": 9011.0,
      "end": 9014.0,
      "formatted_start": "02:30:11.000",
      "formatted_end": "02:30:14.000",
      "text": "بازم مثلا روز انرژی دارم کار بکنم."
    },
    {
      "id": 3,
      "start": 9014.0,
      "end": 9016.0,
      "formatted_start": "02:30:14.000",
      "formatted_end": "02:30:16.000",
      "text": "آفرین، نیاز بدنتون به خواب کنده."
    },
    {
      "id": 4,
      "start": 9016.0,
      "end": 9021.0,
      "formatted_start": "02:30:16.000",
      "formatted_end": "02:30:21.000",
      "text": "بله، وقتی خوابت همیه باشه، خانده تو، پستت خوب میشه، قبلات خوب میشه،"
    },
    {
      "id": 5,
      "start": 9021.0,
      "end": 9026.0,
      "formatted_start": "02:30:21.000",
      "formatted_end": "02:30:26.000",
      "text": "یه آرایش که میگوید قطعا یه آرایش نیست، خوابت خوب نمیشه."
    },
    {
      "id": 6,
      "start": 9026.0,
      "end": 9031.0,
      "formatted_start": "02:30:26.000",
      "formatted_end": "02:30:31.000",
      "text": "اینو قبول دارم. ولی میگم اینجوری به خودتون بگید که بهتون استرس بار."
    },
    {
      "id": 7,
      "start": 9031.0,
      "end": 9038.0,
      "formatted_start": "02:30:31.000",
      "formatted_end": "02:30:38.000",
      "text": "ببینید الان دو تا فشاره. یکی اینکه شما نمیخواید، یکی اینکه استرس اینو دارید، اختلاف استرسی دارید به خاطر اینکه نمیخوابند."
    },
    {
      "id": 8,
      "start": 9038.0,
      "end": 9047.0,
      "formatted_start": "02:30:38.000",
      "formatted_end": "02:30:47.000",
      "text": "یکی بذار بماند. مثلا مهم است اصلاح میشه باشه، الان امشب بابیدم خوردم نشد دیگه، نشد دیگه، مهم نیست."
    },
    {
      "id": 9,
      "start": 9047.0,
      "end": 9050.0,
      "formatted_start": "02:30:47.000",
      "formatted_end": "02:30:50.000",
      "text": "اینو خیلی خودتون عذیب نکنید."
    },
    {
      "id": 10,
      "start": 9050.0,
      "end": 9053.0,
      "formatted_start": "02:30:50.000",
      "formatted_end": "02:30:53.000",
      "text": "بس خوانستان کتاب خوندن خیلی متونه بخواهند."
    },
    {
      "id": 11,
      "start": 9053.0,
      "end": 9056.0,
      "formatted_start": "02:30:53.000",
      "formatted_end": "02:30:56.000",
      "text": "خاندورتون یه قرص سرماکور دیگه هم زمانتون میدونی؟"
    },
    {
      "id": 12,
      "start": 9056.0,
      "end": 9058.0,
      "formatted_start": "02:30:56.000",
      "formatted_end": "02:30:58.000",
      "text": "قرص سرماکور."
    },
    {
      "id": 13,
      "start": 9066.0,
      "end": 9068.0,
      "formatted_start": "02:31:06.000",
      "formatted_end": "02:31:08.000",
      "text": "دکتور بیمارستان هم میرن؟"
    },
    {
      "id": 14,
      "start": 9068.0,
      "end": 9070.0,
      "formatted_start": "02:31:08.000",
      "formatted_end": "02:31:10.000",
      "text": "آره، هفته یه سی دو شده بود."
    },
    {
      "id": 15,
      "start": 9070.0,
      "end": 9072.0,
      "formatted_start": "02:31:10.000",
      "formatted_end": "02:31:12.000",
      "text": "فکر کن دکتور همسه پاس نشستن شده نه؟"
    },
    {
      "id": 16,
      "start": 9072.0,
      "end": 9075.0,
      "formatted_start": "02:31:12.000",
      "formatted_end": "02:31:15.000",
      "text": "نه، دکتورم ۸۶ فکر کنم."
    },
    {
      "id": 17,
      "start": 9075.0,
      "end": 9078.0,
      "formatted_start": "02:31:15.000",
      "formatted_end": "02:31:18.000",
      "text": "۸۵، ۸۶ میرم."
    },
    {
      "id": 18,
      "start": 9078.0,
      "end": 9108.0,
      "formatted_start": "02:31:18.000",
      "formatted_end": "02:31:48.000",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینج"
    },
    {
      "id": 19,
      "start": 9108.0,
      "end": 9114.0,
      "formatted_start": "02:31:48.000",
      "formatted_end": "02:31:54.000",
      "text": "اگر خاطران هم باشه، چیز داره، به قول مرور نشکی داره"
    },
    {
      "id": 20,
      "start": 9114.0,
      "end": 9125.0,
      "formatted_start": "02:31:54.000",
      "formatted_end": "02:32:05.000",
      "text": "شما اگر زحمت دکیشین، یه نامه یه گواهی بدین که ایشون هم مثلا بشاروخون و دیابتو و همون برای ادرادش"
    },
    {
      "id": 21,
      "start": 9125.0,
      "end": 9133.0,
      "formatted_start": "02:32:05.000",
      "formatted_end": "02:32:13.000",
      "text": "که یه اختیاری ادراد دارن که نیاز به پرستار دارن، یه هر چیزی، اگر زحمت داشتون خواهش میکنن"
    },
    {
      "id": 22,
      "start": 9138.0,
      "end": 9146.0,
      "formatted_start": "02:32:18.000",
      "formatted_end": "02:32:26.000",
      "text": "موسیقی"
    },
