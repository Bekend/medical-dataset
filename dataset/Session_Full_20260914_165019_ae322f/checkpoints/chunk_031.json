  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9302.5,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:02.500",
      "text": "بیمار و بیجه قلب و خودان باشن."
    },
    {
      "id": 1,
      "start": 9302.5,
      "end": 9308.5,
      "formatted_start": "02:35:02.500",
      "formatted_end": "02:35:08.500",
      "text": "چون من متوسط میمونم، اینقدر چیزی علکی نمیمونم بگیرم، آزادها هم دیگه خودشون بگیرن."
    },
    {
      "id": 2,
      "start": 9308.5,
      "end": 9310.5,
      "formatted_start": "02:35:08.500",
      "formatted_end": "02:35:10.500",
      "text": "آزاده چرا بزمان نسخه میگویم؟"
    },
    {
      "id": 3,
      "start": 9310.5,
      "end": 9316.5,
      "formatted_start": "02:35:10.500",
      "formatted_end": "02:35:16.500",
      "text": "بیسته هزار، سه نمی آزاد و بیجه هم بیزا بیاخرده بیان."
    },
    {
      "id": 4,
      "start": 9316.5,
      "end": 9321.5,
      "formatted_start": "02:35:16.500",
      "formatted_end": "02:35:21.500",
      "text": "بس میدن امتحانتیتی که من اشتناس کنم."
    },
    {
      "id": 5,
      "start": 9321.5,
      "end": 9351.5,
      "formatted_start": "02:35:21.500",
      "formatted_end": "02:35:51.500",
      "text": "از اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 6,
      "start": 9351.5,
      "end": 9356.5,
      "formatted_start": "02:35:51.500",
      "formatted_end": "02:35:56.500",
      "text": "این ها را برای مدت باطل داده زیاد داره نرسان چون کشور داره نیست"
    },
    {
      "id": 7,
      "start": 9356.5,
      "end": 9359.5,
      "formatted_start": "02:35:56.500",
      "formatted_end": "02:35:59.500",
      "text": "همه هفته برای درست داده کشور سردم"
    },
    {
      "id": 8,
      "start": 9359.5,
      "end": 9361.5,
      "formatted_start": "02:35:59.500",
      "formatted_end": "02:36:01.500",
      "text": "باطل داده کم داره"
    },
    {
      "id": 9,
      "start": 9361.5,
      "end": 9363.5,
      "formatted_start": "02:36:01.500",
      "formatted_end": "02:36:03.500",
      "text": "کشور داره"
    },
    {
      "id": 10,
      "start": 9363.5,
      "end": 9365.5,
      "formatted_start": "02:36:03.500",
      "formatted_end": "02:36:05.500",
      "text": "در این وقت هم هستیم همه داره"
    },
    {
      "id": 11,
      "start": 9373.5,
      "end": 9375.5,
      "formatted_start": "02:36:13.500",
      "formatted_end": "02:36:15.500",
      "text": "کبت چرب داره"
    },
    {
      "id": 12,
      "start": 9375.5,
      "end": 9377.5,
      "formatted_start": "02:36:15.500",
      "formatted_end": "02:36:17.500",
      "text": "کبتتون یکم چرب"
    },
    {
      "id": 13,
      "start": 9377.5,
      "end": 9383.5,
      "formatted_start": "02:36:17.500",
      "formatted_end": "02:36:23.500",
      "text": "از اینجا باید برداشت کنید و پیاد رو روی کنید"
    },
    {
      "id": 14,
      "start": 9383.5,
      "end": 9387.5,
      "formatted_start": "02:36:23.500",
      "formatted_end": "02:36:27.500",
      "text": "و روی سفراتون خوبه"
    },
    {
      "id": 15,
      "start": 9387.5,
      "end": 9391.5,
      "formatted_start": "02:36:27.500",
      "formatted_end": "02:36:31.500",
      "text": "اینجا باید برداشت کنید و برداشت کنید"
    },
    {
      "id": 16,
      "start": 9391.5,
      "end": 9395.5,
      "formatted_start": "02:36:31.500",
      "formatted_end": "02:36:35.500",
      "text": "و اینجا باید برداشت کنید و برداشت کنید"
    },
    {
      "id": 17,
      "start": 9395.5,
      "end": 9399.5,
      "formatted_start": "02:36:35.500",
      "formatted_end": "02:36:39.500",
      "text": "و اینجا باید برداشت کنید و برداشت کنید"
    },
    {
      "id": 18,
      "start": 9399.5,
      "end": 9403.5,
      "formatted_start": "02:36:39.500",
      "formatted_end": "02:36:43.500",
      "text": "و اینجا باید برداشت کنید و برداشت کنید"
    },
    {
      "id": 19,
      "start": 9403.5,
      "end": 9406.5,
      "formatted_start": "02:36:43.500",
      "formatted_end": "02:36:46.500",
      "text": "اوی نه تا خدا همون روز من شهرمده کنم"
    },
    {
      "id": 20,
      "start": 9406.5,
      "end": 9408.5,
      "formatted_start": "02:36:46.500",
      "formatted_end": "02:36:48.500",
      "text": "باشیم از همه ما کدوم ما داریم چیز میکنیم"
    },
    {
      "id": 21,
      "start": 9408.5,
      "end": 9410.5,
      "formatted_start": "02:36:48.500",
      "formatted_end": "02:36:50.500",
      "text": "مرغا داریم گنده میکنیم"
    },
    {
      "id": 22,
      "start": 9410.5,
      "end": 9412.5,
      "formatted_start": "02:36:50.500",
      "formatted_end": "02:36:52.500",
      "text": "نه تا خدا همون نمیدونیم"
    },
    {
      "id": 23,
      "start": 9412.5,
      "end": 9416.5,
      "formatted_start": "02:36:52.500",
      "formatted_end": "02:36:56.500",
      "text": "نه از همه ما داریم دستون هم برد"
    },
    {
      "id": 24,
      "start": 9416.5,
      "end": 9418.5,
      "formatted_start": "02:36:56.500",
      "formatted_end": "02:36:58.500",
      "text": "و همون رو بگنم و درست بگم"
    },
    {
      "id": 25,
      "start": 9418.5,
      "end": 9420.5,
      "formatted_start": "02:36:58.500",
      "formatted_end": "02:37:00.500",
      "text": "آره ایرخام ما بچه همون باز نمیکنیم"
    },
    {
      "id": 26,
      "start": 9420.5,
      "end": 9422.5,
      "formatted_start": "02:37:00.500",
      "formatted_end": "02:37:02.500",
      "text": "بسر ما محلی نمیکنیم"
    },
    {
      "id": 27,
      "start": 9422.5,
      "end": 9424.5,
      "formatted_start": "02:37:02.500",
      "formatted_end": "02:37:04.500",
      "text": "نه گوشت ما محلی"
    },
    {
      "id": 28,
      "start": 9424.5,
      "end": 9426.5,
      "formatted_start": "02:37:04.500",
      "formatted_end": "02:37:06.500",
      "text": "نه مرغا محلی"
    },
    {
      "id": 29,
      "start": 9426.5,
      "end": 9428.5,
      "formatted_start": "02:37:06.500",
      "formatted_end": "02:37:08.500",
      "text": "بس اونجور همه 18 سالشون بسه هستن"
    },
    {
      "id": 30,
      "start": 9428.5,
      "end": 9430.5,
      "formatted_start": "02:37:08.500",
      "formatted_end": "02:37:10.500",
      "text": "نه بسه همه که پیرده میشه نیزم"
    },
    {
      "id": 31,
      "start": 9430.5,
      "end": 9432.5,
      "formatted_start": "02:37:10.500",
      "formatted_end": "02:37:12.500",
      "text": "اینجور همه خودم همین بودم"
    },
    {
      "id": 32,
      "start": 9432.5,
      "end": 9434.5,
      "formatted_start": "02:37:12.500",
      "formatted_end": "02:37:14.500",
      "text": "یعنی بابا میشه کره شیر ماسی نه چی ببینو نه"
    },
    {
      "id": 33,
      "start": 9434.5,
      "end": 9436.5,
      "formatted_start": "02:37:14.500",
      "formatted_end": "02:37:16.500",
      "text": "حرف نیست با سوریزو خوبه"
    },
    {
      "id": 34,
      "start": 9436.5,
      "end": 9438.5,
      "formatted_start": "02:37:16.500",
      "formatted_end": "02:37:18.500",
      "text": "همه ش لشست هست"
    },
    {
      "id": 35,
      "start": 9438.5,
      "end": 9440.5,
      "formatted_start": "02:37:18.500",
      "formatted_end": "02:37:20.500",
      "text": "همه خوبه"
    },
    {
      "id": 36,
      "start": 9442.5,
      "end": 9444.5,
      "formatted_start": "02:37:22.500",
      "formatted_end": "02:37:24.500",
      "text": "قلبتون در رو مادر بدرتون"
    },
    {
      "id": 37,
      "start": 9444.5,
      "end": 9446.5,
      "formatted_start": "02:37:24.500",
      "formatted_end": "02:37:26.500",
      "text": "مادر بدرتون مرد داره؟"
    },
    {
      "id": 38,
      "start": 9446.5,
      "end": 9448.5,
      "formatted_start": "02:37:26.500",
      "formatted_end": "02:37:28.500",
      "text": "نه باید باید برم"
    },
    {
      "id": 39,
      "start": 9448.5,
      "end": 9450.5,
      "formatted_start": "02:37:28.500",
      "formatted_end": "02:37:30.500",
      "text": "اوه مرز بالا نیست"
    },
    {
      "id": 40,
      "start": 9450.5,
      "end": 9452.5,
      "formatted_start": "02:37:30.500",
      "formatted_end": "02:37:32.500",
      "text": "فقط زیاد شوکولات برم"
    },
    {
      "id": 41,
      "start": 9452.5,
      "end": 9454.5,
      "formatted_start": "02:37:32.500",
      "formatted_end": "02:37:34.500",
      "text": "خیلی میل من میگیر خواهنده بود"
    },
    {
      "id": 42,
      "start": 9456.5,
      "end": 9461.78,
      "formatted_start": "02:37:36.500",
      "formatted_end": "02:37:41.780",
      "text": "اینقدر نگیره یعنی این چایی رو یه لبن چایی رو با چهار تا پنج تا پند دل هم بکنم"
    },
    {
      "id": 43,
      "start": 9461.78,
      "end": 9466.5,
      "formatted_start": "02:37:41.780",
      "formatted_end": "02:37:46.500",
      "text": "یا نسکا پنج بکنم با یه مشک هم برسم نمیدونم هر کارم برم اگر نکردم اینجا انرژی نمیگیرم"
    },
    {
      "id": 44,
      "start": 9466.5,
      "end": 9469.9,
      "formatted_start": "02:37:46.500",
      "formatted_end": "02:37:49.900",
      "text": "من مطلب کم برم با خورما بخورم"
    },
    {
      "id": 45,
      "start": 9469.9,
      "end": 9470.74,
      "formatted_start": "02:37:49.900",
      "formatted_end": "02:37:50.740",
      "text": "چون هر چی که"
    },
    {
      "id": 46,
      "start": 9470.74,
      "end": 9472.34,
      "formatted_start": "02:37:50.740",
      "formatted_end": "02:37:52.340",
      "text": "خورما برای قمش برای دیگه با"
    },
    {
      "id": 47,
      "start": 9472.34,
      "end": 9475.5,
      "formatted_start": "02:37:52.340",
      "formatted_end": "02:37:55.500",
      "text": "نه خورما برای خیلی باید نمیدونم"
    },
    {
      "id": 48,
      "start": 9475.5,
      "end": 9477.5,
      "formatted_start": "02:37:55.500",
      "formatted_end": "02:37:57.500",
      "text": "چربی تون خوبه"
    },
    {
      "id": 49,
      "start": 9477.5,
      "end": 9479.5,
      "formatted_start": "02:37:57.500",
      "formatted_end": "02:37:59.500",
      "text": "چربی پس از کبر چربه"
    },
    {
      "id": 50,
      "start": 9479.5,
      "end": 9481.5,
      "formatted_start": "02:37:59.500",
      "formatted_end": "02:38:01.500",
      "text": "نداریم"
    },
    {
      "id": 51,
      "start": 9481.5,
      "end": 9486.5,
      "formatted_start": "02:38:01.500",
      "formatted_end": "02:38:06.500",
      "text": "چرب بیشترش با شیرمی، شکلات، نوشابه، دلستر، هندونه"
    },
    {
      "id": 52,
      "start": 9486.5,
      "end": 9496.5,
      "formatted_start": "02:38:06.500",
      "formatted_end": "02:38:16.500",
      "text": "باز هندونه نوشابه داره، بیشتر غنهای مصروی و بعد تخمه، آجی، روغن مایه، روغن جامع زیاد نباید استفاده کنیم"
    },
    {
      "id": 53,
      "start": 9496.5,
      "end": 9498.5,
      "formatted_start": "02:38:16.500",
      "formatted_end": "02:38:18.500",
      "text": "و اینجا پریاد بودی یا نه؟"
    },
    {
      "id": 54,
      "start": 9498.5,
      "end": 9499.5,
      "formatted_start": "02:38:18.500",
      "formatted_end": "02:38:19.500",
      "text": "نه"
    },
    {
      "id": 55,
      "start": 9499.5,
      "end": 9500.5,
      "formatted_start": "02:38:19.500",
      "formatted_end": "02:38:20.500",
      "text": "تازه پارک نشده بودی؟"
    },
    {
      "id": 56,
      "start": 9500.5,
      "end": 9501.5,
      "formatted_start": "02:38:20.500",
      "formatted_end": "02:38:21.500",
      "text": "نه"
    },
    {
      "id": 57,
      "start": 9501.5,
      "end": 9502.5,
      "formatted_start": "02:38:21.500",
      "formatted_end": "02:38:22.500",
      "text": "تازه هم پریاد نشده نه؟"
    },
    {
      "id": 58,
      "start": 9502.5,
      "end": 9504.5,
      "formatted_start": "02:38:22.500",
      "formatted_end": "02:38:24.500",
      "text": "نه، بستر یعنی که نازی که درخوزه هر جور نشده"
    },
    {
      "id": 59,
      "start": 9504.5,
      "end": 9510.34,
      "formatted_start": "02:38:24.500",
      "formatted_end": "02:38:30.340",
      "text": "پس یک شهرزه داریم برای این برگاه دردی کنیم چون تو اداره بی کم خون میدهید تو سنا ندیدید"
    },
    {
      "id": 60,
      "start": 9510.34,
      "end": 9515.14,
      "formatted_start": "02:38:30.340",
      "formatted_end": "02:38:35.140",
      "text": "نه از اون اول محل مرم میان همسایی میگن خون دارید یا یه لکهای خون دارید"
    },
    {
      "id": 61,
      "start": 9515.14,
      "end": 9518.64,
      "formatted_start": "02:38:35.140",
      "formatted_end": "02:38:38.640",
      "text": "یه بابا پس یه سیتیسکن بود اگر همیشه خون ندیدید"
    },
    {
      "id": 62,
      "start": 9518.64,
      "end": 9523.64,
      "formatted_start": "02:38:38.640",
      "formatted_end": "02:38:43.640",
      "text": "نه هر سیره آزمایش مده همینوز حرف شما میگن که نزدیک آدتی بود یا بعد از آدتی بودید"
    },
    {
      "id": 63,
      "start": 9523.64,
      "end": 9525.12,
      "formatted_start": "02:38:43.640",
      "formatted_end": "02:38:45.120",
      "text": "ممکنه که اینسته"
    },
    {
      "id": 64,
      "start": 9525.12,
      "end": 9527.12,
      "formatted_start": "02:38:45.120",
      "formatted_end": "02:38:47.120",
      "text": "اینجا باید بیمارسان ازد منسوم انجام میده"
    },
    {
      "id": 65,
      "start": 9527.12,
      "end": 9529.12,
      "formatted_start": "02:38:47.120",
      "formatted_end": "02:38:49.120",
      "text": "چی نظر؟ سرچم نشان داره بسیار سنورم هر نگرم اینجا بود"
    },
    {
      "id": 66,
      "start": 9529.12,
      "end": 9531.12,
      "formatted_start": "02:38:49.120",
      "formatted_end": "02:38:51.120",
      "text": "باید ستیسکر شدی؟"
    },
    {
      "id": 67,
      "start": 9531.12,
      "end": 9533.12,
      "formatted_start": "02:38:51.120",
      "formatted_end": "02:38:53.120",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 9533.12,
      "end": 9535.12,
      "formatted_start": "02:38:53.120",
      "formatted_end": "02:38:55.120",
      "text": "این ستیسکر باید بیمارسان ازد منسوم انجام میده"
    },
    {
      "id": 69,
      "start": 9535.12,
      "end": 9537.12,
      "formatted_start": "02:38:55.120",
      "formatted_end": "02:38:57.120",
      "text": "خب؟"
    },
    {
      "id": 70,
      "start": 9537.12,
      "end": 9539.12,
      "formatted_start": "02:38:57.120",
      "formatted_end": "02:38:59.120",
      "text": "نه"
    },
    {
      "id": 71,
      "start": 9539.12,
      "end": 9541.12,
      "formatted_start": "02:38:59.120",
      "formatted_end": "02:39:01.120",
      "text": "اینجا باید بیمارسان ازد منسوم انجام میده"
    },
    {
      "id": 72,
      "start": 9541.12,
      "end": 9543.12,
      "formatted_start": "02:39:01.120",
      "formatted_end": "02:39:03.120",
      "text": "خب؟"
    },
    {
      "id": 73,
      "start": 9543.12,
      "end": 9545.12,
      "formatted_start": "02:39:03.120",
      "formatted_end": "02:39:05.120",
      "text": "نه"
    },
    {
      "id": 74,
      "start": 9545.12,
      "end": 9547.12,
      "formatted_start": "02:39:05.120",
      "formatted_end": "02:39:07.120",
      "text": "خب دکتور این بارشک و این مثلا سوزش پایین همه باید که اون روزم پرس همم دادی"
    },
    {
      "id": 75,
      "start": 9547.12,
      "end": 9554.12,
      "formatted_start": "02:39:07.120",
      "formatted_end": "02:39:14.120",
      "text": "این سوزش پایین هم با اینکه اون روز هم پرس هم هم دادی، از این که ازیت هم میکنه"
    },
    {
      "id": 76,
      "start": 9554.12,
      "end": 9556.12,
      "formatted_start": "02:39:14.120",
      "formatted_end": "02:39:16.120",
      "text": "بعد سینا تو اوتو بزن"
    },
    {
      "id": 77,
      "start": 9556.12,
      "end": 9557.12,
      "formatted_start": "02:39:16.120",
      "formatted_end": "02:39:17.120",
      "text": "بله؟"
    },
    {
      "id": 78,
      "start": 9557.12,
      "end": 9558.12,
      "formatted_start": "02:39:17.120",
      "formatted_end": "02:39:18.120",
      "text": "نبا سینا تو اوتو بزن"
    },
    {
      "id": 79,
      "start": 9558.12,
      "end": 9561.12,
      "formatted_start": "02:39:18.120",
      "formatted_end": "02:39:21.120",
      "text": "آها، بعد در این گرگره این کف با ما بنده جور"
    },
    {
      "id": 80,
      "start": 9561.12,
      "end": 9564.12,
      "formatted_start": "02:39:21.120",
      "formatted_end": "02:39:24.120",
      "text": "بابا میشه بعضی شبان بالا میشه هم هنو میگن"
    },
    {
      "id": 81,
      "start": 9564.12,
      "end": 9566.12,
      "formatted_start": "02:39:24.120",
      "formatted_end": "02:39:26.120",
      "text": "هیچی کمیست، دیدید؟"
    },
    {
      "id": 82,
      "start": 9566.12,
      "end": 9567.12,
      "formatted_start": "02:39:26.120",
      "formatted_end": "02:39:27.120",
      "text": "همه؟"
    },
    {
      "id": 83,
      "start": 9567.12,
      "end": 9569.12,
      "formatted_start": "02:39:27.120",
      "formatted_end": "02:39:29.120",
      "text": "هیچیت خوبه، الان چند ساله ای؟"
    },
    {
      "id": 84,
      "start": 9569.12,
      "end": 9570.12,
      "formatted_start": "02:39:29.120",
      "formatted_end": "02:39:30.120",
      "text": "۴۵ هم"
    },
    {
      "id": 85,
      "start": 9570.12,
      "end": 9571.12,
      "formatted_start": "02:39:30.120",
      "formatted_end": "02:39:31.120",
      "text": "عادت میشه موردت؟"
    },
    {
      "id": 86,
      "start": 9571.12,
      "end": 9572.12,
      "formatted_start": "02:39:31.120",
      "formatted_end": "02:39:32.120",
      "text": "آره"
    },
    {
      "id": 87,
      "start": 9572.12,
      "end": 9575.12,
      "formatted_start": "02:39:32.120",
      "formatted_end": "02:39:35.120",
      "text": "مادر چند ساله که یادت ازش باشده؟"
    },
    {
      "id": 88,
      "start": 9575.12,
      "end": 9579.12,
      "formatted_start": "02:39:35.120",
      "formatted_end": "02:39:39.120",
      "text": "مادر مرایش رو دراب بردم، تو سنه نه چند ساله که به دراب بردم"
    },
    {
      "id": 89,
      "start": 9579.12,
      "end": 9581.12,
      "formatted_start": "02:39:39.120",
      "formatted_end": "02:39:41.120",
      "text": "کمپول هم چون نیستی؟"
    },
    {
      "id": 90,
      "start": 9581.12,
      "end": 9583.12,
      "formatted_start": "02:39:41.120",
      "formatted_end": "02:39:43.120",
      "text": "نه، همه چی همه نرم"
    },
    {
      "id": 91,
      "start": 9583.12,
      "end": 9585.12,
      "formatted_start": "02:39:43.120",
