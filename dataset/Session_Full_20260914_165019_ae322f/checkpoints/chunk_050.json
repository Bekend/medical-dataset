      "text": "این ارتباط هایی که با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه ب"
    },
    {
      "id": 2,
      "start": 15060.0,
      "end": 15064.04,
      "formatted_start": "04:11:00.000",
      "formatted_end": "04:11:04.040",
      "text": "این قرص بلوکفنگ که نوشتم برای درد نیست دار"
    },
    {
      "id": 3,
      "start": 15064.04,
      "end": 15066.04,
      "formatted_start": "04:11:04.040",
      "formatted_end": "04:11:06.040",
      "text": "برای افتحاب سیل نظر"
    },
    {
      "id": 4,
      "start": 15066.04,
      "end": 15068.04,
      "formatted_start": "04:11:06.040",
      "formatted_end": "04:11:08.040",
      "text": "قرصات مدت رو عذیب می کنه"
    },
    {
      "id": 5,
      "start": 15068.04,
      "end": 15070.04,
      "formatted_start": "04:11:08.040",
      "formatted_end": "04:11:10.040",
      "text": "حتما همراه فاموتدین بخوریم"
    },
    {
      "id": 6,
      "start": 15070.04,
      "end": 15072.04,
      "formatted_start": "04:11:10.040",
      "formatted_end": "04:11:12.040",
      "text": "دارم"
    },
    {
      "id": 7,
      "start": 15072.04,
      "end": 15074.04,
      "formatted_start": "04:11:12.040",
      "formatted_end": "04:11:14.040",
      "text": "نه نه نه"
    },
    {
      "id": 8,
      "start": 15074.04,
      "end": 15076.04,
      "formatted_start": "04:11:14.040",
      "formatted_end": "04:11:16.040",
      "text": "من دارو تو کامل میدونیم"
    },
    {
      "id": 9,
      "start": 15076.04,
      "end": 15078.04,
      "formatted_start": "04:11:16.040",
      "formatted_end": "04:11:18.040",
      "text": "آره بگو هریکی نه بگو زمین اونجا"
    },
    {
      "id": 10,
      "start": 15078.04,
      "end": 15080.04,
      "formatted_start": "04:11:18.040",
      "formatted_end": "04:11:20.040",
      "text": "سومدرافی باجبه"
    },
    {
      "id": 11,
      "start": 15080.04,
      "end": 15082.04,
      "formatted_start": "04:11:20.040",
      "formatted_end": "04:11:22.040",
      "text": "حتما"
    },
    {
      "id": 12,
      "start": 15082.04,
      "end": 15085.04,
      "formatted_start": "04:11:22.040",
      "formatted_end": "04:11:25.040",
      "text": "ماما که نمیرم درم امیاد نمیرم"
    },
    {
      "id": 13,
      "start": 15085.04,
      "end": 15087.04,
      "formatted_start": "04:11:25.040",
      "formatted_end": "04:11:27.040",
      "text": "که رفته بودی آخنجا"
    },
    {
      "id": 14,
      "start": 15087.04,
      "end": 15089.04,
      "formatted_start": "04:11:27.040",
      "formatted_end": "04:11:29.040",
      "text": "دو سه سال پیش"
    },
    {
      "id": 15,
      "start": 15089.04,
      "end": 15091.04,
      "formatted_start": "04:11:29.040",
      "formatted_end": "04:11:31.040",
      "text": "برادر کشکم"
    },
    {
      "id": 16,
      "start": 15091.04,
      "end": 15093.04,
      "formatted_start": "04:11:31.040",
      "formatted_end": "04:11:33.040",
      "text": "ساما برو بگو اون ساما چی میگه"
    },
    {
      "id": 17,
      "start": 15093.04,
      "end": 15095.04,
      "formatted_start": "04:11:33.040",
      "formatted_end": "04:11:35.040",
      "text": "خانواده شما که کسی نیزی نداشته"
    },
    {
      "id": 18,
      "start": 15095.04,
      "end": 15097.04,
      "formatted_start": "04:11:35.040",
      "formatted_end": "04:11:37.040",
      "text": "نه"
    },
    {
      "id": 19,
      "start": 15097.04,
      "end": 15099.04,
      "formatted_start": "04:11:37.040",
      "formatted_end": "04:11:39.040",
      "text": "نه آن چیزو بد فکر نکنی"
    },
    {
      "id": 20,
      "start": 15101.04,
      "end": 15103.04,
      "formatted_start": "04:11:41.040",
      "formatted_end": "04:11:43.040",
      "text": "چون میگن سرطان درد نداره"
    },
    {
      "id": 21,
      "start": 15103.04,
      "end": 15105.04,
      "formatted_start": "04:11:43.040",
      "formatted_end": "04:11:45.040",
      "text": "درسته؟"
    },
    {
      "id": 22,
      "start": 15105.04,
      "end": 15107.04,
      "formatted_start": "04:11:45.040",
      "formatted_end": "04:11:47.040",
      "text": "آنونی برای هیچ چیزی نداره"
    },
    {
      "id": 23,
      "start": 15109.04,
      "end": 15111.04,
      "formatted_start": "04:11:49.040",
      "formatted_end": "04:11:51.040",
      "text": "آره معمولا سرطان درد نداره"
    },
    {
      "id": 24,
      "start": 15111.04,
      "end": 15113.04,
      "formatted_start": "04:11:51.040",
      "formatted_end": "04:11:53.040",
      "text": "مرد نداره"
    },
    {
      "id": 25,
      "start": 15113.04,
      "end": 15115.04,
      "formatted_start": "04:11:53.040",
      "formatted_end": "04:11:55.040",
      "text": "لینا آنونیست که"
    },
    {
      "id": 26,
      "start": 15115.04,
      "end": 15117.04,
      "formatted_start": "04:11:55.040",
      "formatted_end": "04:11:57.040",
      "text": "کتاب نمیخونه که سرطان"
    },
    {
      "id": 27,
      "start": 15117.04,
      "end": 15119.04,
      "formatted_start": "04:11:57.040",
      "formatted_end": "04:11:59.040",
      "text": "کجا بکنم؟"
    },
    {
      "id": 28,
      "start": 15119.04,
      "end": 15122.04,
      "formatted_start": "04:11:59.040",
      "formatted_end": "04:12:02.040",
      "text": "همه درمانگای اینجا خوب انجام میدهد خانومه"
    },
    {
      "id": 29,
      "start": 15122.04,
      "end": 15123.04,
      "formatted_start": "04:12:02.040",
      "formatted_end": "04:12:03.040",
      "text": "کجا؟"
    },
    {
      "id": 30,
      "start": 15123.04,
      "end": 15124.04,
      "formatted_start": "04:12:03.040",
      "formatted_end": "04:12:04.040",
      "text": "درمانگایی ها دیگه"
    },
    {
      "id": 31,
      "start": 15124.04,
      "end": 15125.04,
      "formatted_start": "04:12:04.040",
      "formatted_end": "04:12:05.040",
      "text": "الان برم؟"
    },
    {
      "id": 32,
      "start": 15125.04,
      "end": 15127.04,
      "formatted_start": "04:12:05.040",
      "formatted_end": "04:12:07.040",
      "text": "الان که میزن"
    },
    {
      "id": 33,
      "start": 15127.04,
      "end": 15128.04,
      "formatted_start": "04:12:07.040",
      "formatted_end": "04:12:08.040",
      "text": "ساعت چند است؟"
    },
    {
      "id": 34,
      "start": 15128.04,
      "end": 15131.04,
      "formatted_start": "04:12:08.040",
      "formatted_end": "04:12:11.040",
      "text": "فردا میزن، درد و یا درزه"
    },
    {
      "id": 35,
      "start": 15136.04,
      "end": 15139.04,
      "formatted_start": "04:12:16.040",
      "formatted_end": "04:12:19.040",
      "text": "همون تشخیص میدهد و بیرون میدهد یا فقط سنیم؟"
    },
    {
      "id": 36,
      "start": 15139.04,
      "end": 15141.04,
      "formatted_start": "04:12:19.040",
      "formatted_end": "04:12:21.040",
      "text": "همونو برای خانشفایی بفرست بهت میدهد"
    },
    {
      "id": 37,
      "start": 15141.04,
      "end": 15142.04,
      "formatted_start": "04:12:21.040",
      "formatted_end": "04:12:22.040",
      "text": "تسکیل داری؟"
    },
    {
      "id": 38,
      "start": 15142.04,
      "end": 15143.04,
      "formatted_start": "04:12:22.040",
      "formatted_end": "04:12:23.040",
      "text": "داروش رو نشروع کن دیگه"
    },
    {
      "id": 39,
      "start": 15143.04,
      "end": 15145.04,
      "formatted_start": "04:12:23.040",
      "formatted_end": "04:12:25.040",
      "text": "تسکیل داروش رو بخورم؟"
    },
    {
      "id": 40,
      "start": 15145.04,
      "end": 15147.04,
      "formatted_start": "04:12:25.040",
      "formatted_end": "04:12:27.040",
      "text": "دارا شروع کن از این وضع"
    },
    {
      "id": 41,
      "start": 15147.04,
      "end": 15150.04,
      "formatted_start": "04:12:27.040",
      "formatted_end": "04:12:30.040",
      "text": "دارا فشار منو که دادی همون رو دارم میخورم"
    },
    {
      "id": 42,
      "start": 15150.04,
      "end": 15151.04,
      "formatted_start": "04:12:30.040",
      "formatted_end": "04:12:31.040",
      "text": "خود شده ساله"
    },
    {
      "id": 43,
      "start": 15151.04,
      "end": 15152.04,
      "formatted_start": "04:12:31.040",
      "formatted_end": "04:12:32.040",
      "text": "آه شده ساله"
    },
    {
      "id": 44,
      "start": 15152.04,
      "end": 15153.04,
      "formatted_start": "04:12:32.040",
      "formatted_end": "04:12:33.040",
      "text": "نه نمیدونیم"
    },
    {
      "id": 45,
      "start": 15153.04,
      "end": 15154.04,
      "formatted_start": "04:12:33.040",
      "formatted_end": "04:12:34.040",
      "text": "خود شده ساله"
    },
    {
      "id": 46,
      "start": 15154.04,
      "end": 15155.04,
      "formatted_start": "04:12:34.040",
      "formatted_end": "04:12:35.040",
      "text": "تو جای نگرانی نیست؟"
    },
    {
      "id": 47,
      "start": 15155.04,
      "end": 15156.04,
      "formatted_start": "04:12:35.040",
      "formatted_end": "04:12:36.040",
      "text": "نه نگران بسته"
    },
    {
      "id": 48,
      "start": 15156.04,
      "end": 15157.04,
      "formatted_start": "04:12:36.040",
      "formatted_end": "04:12:37.040",
      "text": "خود شده ساله"
    },
    {
      "id": 49,
      "start": 15157.04,
      "end": 15158.04,
      "formatted_start": "04:12:37.040",
      "formatted_end": "04:12:38.040",
      "text": "خود شده ساله"
    },
    {
      "id": 50,
      "start": 15158.04,
      "end": 15159.04,
      "formatted_start": "04:12:38.040",
      "formatted_end": "04:12:39.040",
      "text": "خود شده ساله"
    },
    {
      "id": 51,
      "start": 15159.04,
      "end": 15160.04,
      "formatted_start": "04:12:39.040",
      "formatted_end": "04:12:40.040",
      "text": "خود شده ساله"
    },
    {
      "id": 52,
      "start": 15160.04,
      "end": 15161.04,
      "formatted_start": "04:12:40.040",
      "formatted_end": "04:12:41.040",
      "text": "خود شده ساله"
    },
    {
      "id": 53,
      "start": 15161.04,
      "end": 15162.04,
      "formatted_start": "04:12:41.040",
      "formatted_end": "04:12:42.040",
      "text": "خود شده ساله"
    },
    {
      "id": 54,
      "start": 15162.04,
      "end": 15163.04,
      "formatted_start": "04:12:42.040",
      "formatted_end": "04:12:43.040",
      "text": "خود شده ساله"
    },
    {
      "id": 55,
      "start": 15163.04,
      "end": 15164.04,
      "formatted_start": "04:12:43.040",
      "formatted_end": "04:12:44.040",
      "text": "خود شده ساله"
    },
    {
      "id": 56,
      "start": 15164.04,
      "end": 15165.04,
      "formatted_start": "04:12:44.040",
      "formatted_end": "04:12:45.040",
      "text": "خود شده ساله"
    },
    {
      "id": 57,
      "start": 15165.04,
      "end": 15166.04,
      "formatted_start": "04:12:45.040",
      "formatted_end": "04:12:46.040",
      "text": "خود شده ساله"
    },
    {
      "id": 58,
      "start": 15166.04,
      "end": 15167.04,
      "formatted_start": "04:12:46.040",
      "formatted_end": "04:12:47.040",
      "text": "خود شده ساله"
    },
    {
      "id": 59,
      "start": 15167.04,
      "end": 15197.04,
      "formatted_start": "04:12:47.040",
      "formatted_end": "04:13:17.040",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 60,
      "start": 15197.04,
      "end": 15217.04,
      "formatted_start": "04:13:17.040",
      "formatted_end": "04:13:37.040",
      "text": "اینجا با ارسل که خیلی مهم نیست در واقع درمانش پیشگیریه"
    },
    {
      "id": 61,
      "start": 15217.04,
      "end": 15225.04,
      "formatted_start": "04:13:37.040",
      "formatted_end": "04:13:45.040",
      "text": "اگه مثلا مداوم بود به دارو میداره ولی فقط با ارسل دارو خوردن و مداوم نداره"
    },
    {
      "id": 62,
      "start": 15225.04,
      "end": 15228.2,
      "formatted_start": "04:13:45.040",
      "formatted_end": "04:13:48.200",
      "text": "مطالب کاری که شما باید بکنید برزش های بیو فیدبک هست."
    },
    {
      "id": 63,
      "start": 15228.2,
      "end": 15229.84,
      "formatted_start": "04:13:48.200",
      "formatted_end": "04:13:49.840",
      "text": "حالا توی اینترنت بزنید."
    },
    {
      "id": 64,
      "start": 15229.84,
      "end": 15231.84,
      "formatted_start": "04:13:49.840",
      "formatted_end": "04:13:51.840",
      "text": "من اینجا باید بینیم سن."
    },
    {
      "id": 65,
      "start": 15231.84,
      "end": 15237.04,
      "formatted_start": "04:13:51.840",
      "formatted_end": "04:13:57.040",
      "text": "نرمش های بیو فیدبک."
    },
    {
      "id": 66,
      "start": 15237.04,
      "end": 15239.04,
      "formatted_start": "04:13:57.040",
      "formatted_end": "04:13:59.040",
      "text": "چیه بیو فیدبک؟"
    },
    {
      "id": 67,
      "start": 15239.04,
      "end": 15243.04,
      "formatted_start": "04:13:59.040",
      "formatted_end": "04:14:03.040",
      "text": "یکی اینکه وقتی داری اطراع می کنی، وسطش هید نگه داری."
    },
    {
      "id": 68,
      "start": 15243.04,
      "end": 15245.04,
      "formatted_start": "04:14:03.040",
      "formatted_end": "04:14:05.040",
      "text": "همه همه ست."
    },
    {
      "id": 69,
      "start": 15245.04,
      "end": 15248.04,
      "formatted_start": "04:14:05.040",
      "formatted_end": "04:14:08.040",
      "text": "آفر. که اون ازولات کف لگن را تو قبیل کن."
    },
    {
      "id": 70,
      "start": 15248.04,
      "end": 15252.04,
      "formatted_start": "04:14:08.040",
      "formatted_end": "04:14:12.040",
      "text": "که دیگه اونها نه هم برزش بکنند که دیگه نشدی ندهد."
    },
    {
      "id": 71,
      "start": 15252.04,
      "end": 15255.28,
      "formatted_start": "04:14:12.040",
      "formatted_end": "04:14:15.280",
      "text": "یکی همه اینکه توی خونه حرکت سندلی رو انجام میده"
    },
    {
      "id": 72,
      "start": 15255.28,
      "end": 15259.1,
      "formatted_start": "04:14:15.280",
      "formatted_end": "04:14:19.100",
      "text": "بهترین نرمش ها شاید دوتایی بیدارم بدونیم"
    },
    {
      "id": 73,
      "start": 15259.1,
      "end": 15265.58,
      "formatted_start": "04:14:19.100",
      "formatted_end": "04:14:25.580",
      "text": "سندلی یعنی اینکه توی خونه مثل حالتی که بخوایی بخوایی سندلی بشینی هی میشینی"
    },
    {
      "id": 74,
      "start": 15265.58,
      "end": 15270.02,
      "formatted_start": "04:14:25.580",
      "formatted_end": "04:14:30.020",
      "text": "هی میشینی کفتو صرف میبانی دیگه هی میشینی این اجام میدی"
    },
    {
      "id": 75,
      "start": 15270.02,
      "end": 15277.58,
      "formatted_start": "04:14:30.020",
      "formatted_end": "04:14:37.580",
      "text": "یکی دیگه اینکه رین توپای بزرگی از بچه ها داره توپای بادی رو اونا بشینی و کفتو منقبض کنی خب؟"
    },
    {
      "id": 76,
      "start": 15277.58,
      "end": 15282.58,
      "formatted_start": "04:14:37.580",
      "formatted_end": "04:14:42.580",
      "text": "این سه تا نرمه شکل. یعنی برای غم حضور همین کار رو فقط میتونی بکنی."
    },
    {
      "id": 77,
      "start": 15282.58,
      "end": 15289.58,
      "formatted_start": "04:14:42.580",
      "formatted_end": "04:14:49.580",
