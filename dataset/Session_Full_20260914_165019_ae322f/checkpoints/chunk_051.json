  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15302.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:02.000",
      "text": "از اینجا، چیزی بود؟"
    },
    {
      "id": 1,
      "start": 15302.0,
      "end": 15310.0,
      "formatted_start": "04:15:02.000",
      "formatted_end": "04:15:10.000",
      "text": "نه، ملایت دو بار، نوایت سه بار، فقط دو بار، دیرز و پیرز، مثلاً، همزمان سه، مثلاً، عطسه که کردن، نمون."
    },
    {
      "id": 2,
      "start": 15310.0,
      "end": 15315.0,
      "formatted_start": "04:15:10.000",
      "formatted_end": "04:15:15.000",
      "text": "مثلاً، چهار در تیر روز، من پنج شیش بالا نقاط حساسیت چی عطسه می کنم."
    },
    {
      "id": 3,
      "start": 15315.0,
      "end": 15319.0,
      "formatted_start": "04:15:15.000",
      "formatted_end": "04:15:19.000",
      "text": "ولی مثلاً، ها یک بار در روز تکرار شد، روزقابش هم یک بار تکرار شد."
    },
    {
      "id": 4,
      "start": 15319.0,
      "end": 15321.0,
      "formatted_start": "04:15:19.000",
      "formatted_end": "04:15:21.000",
      "text": "پجارت، اه، بود که نمی بسونده شد، یا که نه؟"
    },
    {
      "id": 5,
      "start": 15321.0,
      "end": 15324.24,
      "formatted_start": "04:15:21.000",
      "formatted_end": "04:15:24.240",
      "text": "نه نه، من رو خیلی برم یه آزمایش کلی بنویسیم"
    },
    {
      "id": 6,
      "start": 15324.24,
      "end": 15324.84,
      "formatted_start": "04:15:24.240",
      "formatted_end": "04:15:24.840",
      "text": "آشنا"
    },
    {
      "id": 7,
      "start": 15324.84,
      "end": 15329.64,
      "formatted_start": "04:15:24.840",
      "formatted_end": "04:15:29.640",
      "text": "من دیگه از موقعی که یه موقع سالش داره لخترم میشه، یه موازمایش اینو ندادم"
    },
    {
      "id": 8,
      "start": 15329.64,
      "end": 15332.44,
      "formatted_start": "04:15:29.640",
      "formatted_end": "04:15:32.440",
      "text": "لختر آقای شقیقی هست؟"
    },
    {
      "id": 9,
      "start": 15332.44,
      "end": 15333.04,
      "formatted_start": "04:15:32.440",
      "formatted_end": "04:15:33.040",
      "text": "جانبله"
    },
    {
      "id": 10,
      "start": 15333.04,
      "end": 15334.72,
      "formatted_start": "04:15:33.040",
      "formatted_end": "04:15:34.720",
      "text": "بابا خوبه؟"
    },
    {
      "id": 11,
      "start": 15334.72,
      "end": 15335.32,
      "formatted_start": "04:15:34.720",
      "formatted_end": "04:15:35.320",
      "text": "نه بابا"
    },
    {
      "id": 12,
      "start": 15335.32,
      "end": 15337.0,
      "formatted_start": "04:15:35.320",
      "formatted_end": "04:15:37.000",
      "text": "چرا؟"
    },
    {
      "id": 13,
      "start": 15337.92,
      "end": 15342.02,
      "formatted_start": "04:15:37.920",
      "formatted_end": "04:15:42.020",
      "text": "دیشتر بازمونو دستم خیلی درد میبنیم، دستش که بیه سنه هست"
    },
    {
      "id": 14,
      "start": 15342.02,
      "end": 15344.3,
      "formatted_start": "04:15:42.020",
      "formatted_end": "04:15:44.300",
      "text": "فیزیو تنها که نمیبنیم؟"
    },
    {
      "id": 15,
      "start": 15344.3,
      "end": 15346.34,
      "formatted_start": "04:15:44.300",
      "formatted_end": "04:15:46.340",
      "text": "دست کل آقایی تو کنه در جانبله"
    },
    {
      "id": 16,
      "start": 15346.34,
      "end": 15348.34,
      "formatted_start": "04:15:46.340",
      "formatted_end": "04:15:48.340",
      "text": "آره دیگه، این بهترین کاره"
    },
    {
      "id": 17,
      "start": 15348.34,
      "end": 15351.34,
      "formatted_start": "04:15:48.340",
      "formatted_end": "04:15:51.340",
      "text": "خودتون هی با دستاش بازی کنید، کار کنید"
    },
    {
      "id": 18,
      "start": 15351.34,
      "end": 15355.34,
      "formatted_start": "04:15:51.340",
      "formatted_end": "04:15:55.340",
      "text": "وسیله بهش بگیرید، بهبره بالا کنید، اونو بزنید کچید"
    },
    {
      "id": 19,
      "start": 15355.34,
      "end": 15359.34,
      "formatted_start": "04:15:55.340",
      "formatted_end": "04:15:59.340",
      "text": "مشتر خب باباتون خیلی همه دیگه، صاف راه میرد، میامد بدنم"
    },
    {
      "id": 20,
      "start": 15359.34,
      "end": 15362.34,
      "formatted_start": "04:15:59.340",
      "formatted_end": "04:16:02.340",
      "text": "بابا خیلی بابا، نمیبینیم از آقا کشید خب"
    },
    {
      "id": 21,
      "start": 15362.34,
      "end": 15364.34,
      "formatted_start": "04:16:02.340",
      "formatted_end": "04:16:04.340",
      "text": "بابا خیلی مزنونی بود"
    },
    {
      "id": 22,
      "start": 15368.34,
      "end": 15370.34,
      "formatted_start": "04:16:08.340",
      "formatted_end": "04:16:10.340",
      "text": "میزنه"
    },
    {
      "id": 23,
      "start": 15370.34,
      "end": 15375.34,
      "formatted_start": "04:16:10.340",
      "formatted_end": "04:16:15.340",
      "text": "اما بابا راه که میره؟"
    },
    {
      "id": 24,
      "start": 15375.34,
      "end": 15380.34,
      "formatted_start": "04:16:15.340",
      "formatted_end": "04:16:20.340",
      "text": "شکر میکنم بابا باکل برای دیشتر با باکل همانطور سخت هستم که دستان میرو خیلی درد میکنه"
    },
    {
      "id": 25,
      "start": 15380.34,
      "end": 15383.34,
      "formatted_start": "04:16:20.340",
      "formatted_end": "04:16:23.340",
      "text": "کلسیوم بهش میدین؟"
    },
    {
      "id": 26,
      "start": 15383.34,
      "end": 15390.34,
      "formatted_start": "04:16:23.340",
      "formatted_end": "04:16:30.340",
      "text": "کلسیوم تقریبا یکی خودتون هست چند وقت که میدین دیگه همون را یک تکرار به تمام هم بشه باز میدین"
    },
    {
      "id": 27,
      "start": 15390.34,
      "end": 15394.34,
      "formatted_start": "04:16:30.340",
      "formatted_end": "04:16:34.340",
      "text": "چون من این چیزها برای رویش افزاوردی که همش دارم بگیرم"
    },
    {
      "id": 28,
      "start": 15394.34,
      "end": 15399.34,
      "formatted_start": "04:16:34.340",
      "formatted_end": "04:16:39.340",
      "text": "پس نالفصایی و سکتشون ها مدام گره تو بشه"
    },
    {
      "id": 29,
      "start": 15399.34,
      "end": 15403.34,
      "formatted_start": "04:16:39.340",
      "formatted_end": "04:16:43.340",
      "text": "در یک داره هم بود خونه سامی مردش و سیاه بود خارج شده"
    },
    {
      "id": 30,
      "start": 15409.34,
      "end": 15411.34,
      "formatted_start": "04:16:49.340",
      "formatted_end": "04:16:51.340",
      "text": "اکمال خوب شده نشست؟"
    },
    {
      "id": 31,
      "start": 15411.34,
      "end": 15415.34,
      "formatted_start": "04:16:51.340",
      "formatted_end": "04:16:55.340",
      "text": "آره، تو جابان اگه بود می گفتم نه، ولی تو موز چرا؟"
    },
    {
      "id": 32,
      "start": 15415.34,
      "end": 15419.34,
      "formatted_start": "04:16:55.340",
      "formatted_end": "04:16:59.340",
      "text": "افراد اسمبالا، آره دیگه مثل یک درختی که"
    },
    {
      "id": 33,
      "start": 15419.34,
      "end": 15423.34,
      "formatted_start": "04:16:59.340",
      "formatted_end": "04:17:03.340",
      "text": "یک درخت نحال کوچی بود در نظر بگیر، یک درخت پیرا در نظر بگیر"
    },
    {
      "id": 34,
      "start": 15423.34,
      "end": 15428.34,
      "formatted_start": "04:17:03.340",
      "formatted_end": "04:17:08.340",
      "text": "نحال کچی ترگرزون میشه که داره یکشو بزنی خوب پرتونی خوش میشه"
    },
    {
      "id": 35,
      "start": 15428.34,
      "end": 15433.34,
      "formatted_start": "04:17:08.340",
      "formatted_end": "04:17:13.340",
      "text": "اما نحال بزرگ بگو بزنی درخت بزنی شده و چارتاشو بزنی"
    },
    {
      "id": 36,
      "start": 15433.34,
      "end": 15436.34,
      "formatted_start": "04:17:13.340",
      "formatted_end": "04:17:16.340",
      "text": "باز برمی کرده پیرا این طوری هست"
    },
    {
      "id": 37,
      "start": 15436.34,
      "end": 15440.34,
      "formatted_start": "04:17:16.340",
      "formatted_end": "04:17:20.340",
      "text": "یعنی یه سال زمان میبره چون سرعت ترمیم هست"
    },
    {
      "id": 38,
      "start": 15440.34,
      "end": 15442.34,
      "formatted_start": "04:17:20.340",
      "formatted_end": "04:17:22.340",
      "text": "هم یک میلیمتر در ماهه"
    },
    {
      "id": 39,
      "start": 15442.34,
      "end": 15443.34,
      "formatted_start": "04:17:22.340",
      "formatted_end": "04:17:23.340",
      "text": "توی میکشنی"
    },
    {
      "id": 40,
      "start": 15443.34,
      "end": 15448.34,
      "formatted_start": "04:17:23.340",
      "formatted_end": "04:17:28.340",
      "text": "آره زمان بره اگه ترمیم کنید شما شروع کنید ترمیم کردن خوب میشه"
    },
    {
      "id": 41,
      "start": 15448.34,
      "end": 15450.34,
      "formatted_start": "04:17:28.340",
      "formatted_end": "04:17:30.340",
      "text": "یعنی ورزش بگیرده است"
    },
    {
      "id": 42,
      "start": 15450.34,
      "end": 15452.34,
      "formatted_start": "04:17:30.340",
      "formatted_end": "04:17:32.340",
      "text": "بعد یک سال خوب میشه"
    },
    {
      "id": 43,
      "start": 15452.34,
      "end": 15455.34,
      "formatted_start": "04:17:32.340",
      "formatted_end": "04:17:35.340",
      "text": "اصلا فلج کامل میان خوب میشن"
    },
    {
      "id": 44,
      "start": 15459.34,
      "end": 15461.34,
      "formatted_start": "04:17:39.340",
      "formatted_end": "04:17:41.340",
      "text": "به مامانتون هم استرسید"
    },
    {
      "id": 45,
      "start": 15461.34,
      "end": 15463.34,
      "formatted_start": "04:17:41.340",
      "formatted_end": "04:17:43.340",
      "text": "شکر کنن همه تون استرسید"
    },
    {
      "id": 46,
      "start": 15463.34,
      "end": 15464.34,
      "formatted_start": "04:17:43.340",
      "formatted_end": "04:17:44.340",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 15465.34,
      "end": 15468.34,
      "formatted_start": "04:17:45.340",
      "formatted_end": "04:17:48.340",
      "text": "خدا نکنه همه گوشیمون زنگ بکنه"
    },
    {
      "id": 48,
      "start": 15468.34,
      "end": 15470.34,
      "formatted_start": "04:17:48.340",
      "formatted_end": "04:17:50.340",
      "text": "داداش هم باشه، مامان هم باشه"
    },
    {
      "id": 49,
      "start": 15470.34,
      "end": 15472.34,
      "formatted_start": "04:17:50.340",
      "formatted_end": "04:17:52.340",
      "text": "دیگه تمام استرس پنه مونه میگیره"
    },
    {
      "id": 50,
      "start": 15472.34,
      "end": 15474.34,
      "formatted_start": "04:17:52.340",
      "formatted_end": "04:17:54.340",
      "text": "یا میگیره مامان اتفاق رفتار یا بابا"
    },
    {
      "id": 51,
      "start": 15474.34,
      "end": 15477.34,
      "formatted_start": "04:17:54.340",
      "formatted_end": "04:17:57.340",
      "text": "هم من هم آبجی بزرگ هم که میاد اینجا دارن"
    },
    {
      "id": 52,
      "start": 15477.34,
      "end": 15478.34,
      "formatted_start": "04:17:57.340",
      "formatted_end": "04:17:58.340",
      "text": "خیلی استرسید"
    },
    {
      "id": 53,
      "start": 15478.34,
      "end": 15482.34,
      "formatted_start": "04:17:58.340",
      "formatted_end": "04:18:02.340",
      "text": "خودش خیلی باز فشار میشنش. همه باز اون بالای داقه ترست بگیر."
    },
    {
      "id": 54,
      "start": 15482.34,
      "end": 15484.34,
      "formatted_start": "04:18:02.340",
      "formatted_end": "04:18:04.340",
      "text": "همه باز این طوری باشه."
    },
    {
      "id": 55,
      "start": 15484.34,
      "end": 15487.34,
      "formatted_start": "04:18:04.340",
      "formatted_end": "04:18:07.340",
      "text": "خودمی ترسش بدر مادر دیگه."
    },
    {
      "id": 56,
      "start": 15487.34,
      "end": 15489.34,
      "formatted_start": "04:18:07.340",
      "formatted_end": "04:18:09.340",
      "text": "چی کار کنه؟"
    },
    {
      "id": 57,
      "start": 15489.34,
      "end": 15493.34,
      "formatted_start": "04:18:09.340",
      "formatted_end": "04:18:13.340",
      "text": "یکم زرمان قلب و فشکتی زرد بادر ترمون ماند."
    },
    {
      "id": 58,
      "start": 15493.34,
      "end": 15497.34,
      "formatted_start": "04:18:13.340",
      "formatted_end": "04:18:17.340",
      "text": "فکر کن از پهلاک اومدن باید آسانسور درش حراک بود."
    },
    {
      "id": 59,
      "start": 15497.34,
      "end": 15498.34,
      "formatted_start": "04:18:17.340",
      "formatted_end": "04:18:18.340",
      "text": "بخواهی آسانسور."
    },
    {
      "id": 60,
      "start": 15498.34,
      "end": 15504.34,
      "formatted_start": "04:18:18.340",
      "formatted_end": "04:18:24.340",
      "text": "خب دکتور من 15 هم آور سپرشانسی خوردم که همون بگیر نشدن."
    },
    {
      "id": 61,
      "start": 15504.34,
      "end": 15506.34,
      "formatted_start": "04:18:24.340",
      "formatted_end": "04:18:26.340",
      "text": "چه حرامش چیه بود؟"
    },
    {
      "id": 62,
      "start": 15506.34,
      "end": 15522.34,
      "formatted_start": "04:18:26.340",
      "formatted_end": "04:18:42.340",
      "text": "من هشته اون پریاد شدم، پونزه هم باقی بود، پونزه هم ارجانسی خوردم، اینوایه تا دو وقت بعد پریاد میشدم"
    },
    {
      "id": 63,
      "start": 15522.34,
      "end": 15531.34,
      "formatted_start": "04:18:42.340",
      "formatted_end": "04:18:51.340",
      "text": "هشته اون پریادت بوده؟ هشته ماه قبل مرداد، پونزه این مرداد بود من ارجانسی بودم"
    },
    {
      "id": 64,
      "start": 15531.34,
      "end": 15533.34,
      "formatted_start": "04:18:51.340",
      "formatted_end": "04:18:53.340",
      "text": "هموز که به پریودت نرسید"
    },
    {
      "id": 65,
      "start": 15533.34,
      "end": 15535.34,
      "formatted_start": "04:18:53.340",
      "formatted_end": "04:18:55.340",
      "text": "نه نرسید. هشتم تا نهم باید بگیرم"
    },
    {
      "id": 66,
      "start": 15535.34,
      "end": 15537.34,
      "formatted_start": "04:18:55.340",
      "formatted_end": "04:18:57.340",
      "text": "حالا من یک بیتا براتو می نمیسم"
    },
    {
      "id": 67,
      "start": 15537.34,
      "end": 15541.34,
      "formatted_start": "04:18:57.340",
      "formatted_end": "04:19:01.340",
      "text": "اگه دیدی به وقتت نرشدی برو تست دید"
    },
    {
      "id": 68,
      "start": 15541.34,
      "end": 15543.34,
      "formatted_start": "04:19:01.340",
      "formatted_end": "04:19:03.340",
      "text": "حالا برام توترم نوشتیم"
    },
    {
      "id": 69,
      "start": 15543.34,
      "end": 15545.34,
      "formatted_start": "04:19:03.340",
      "formatted_end": "04:19:05.340",
      "text": "آزمایش کنه نام نوشتیم"
    },
    {
      "id": 70,
      "start": 15545.34,
      "end": 15547.34,
      "formatted_start": "04:19:05.340",
      "formatted_end": "04:19:07.340",
      "text": "آره به تستت یک بیتا هم وضع فرمی کنیم"
    },
    {
      "id": 71,
      "start": 15547.34,
      "end": 15549.34,
      "formatted_start": "04:19:07.340",
      "formatted_end": "04:19:09.340",
      "text": "فقط برات آزمایش نوشتیم"
    },
    {
      "id": 72,
      "start": 15549.34,
      "end": 15551.34,
      "formatted_start": "04:19:09.340",
      "formatted_end": "04:19:11.340",
      "text": "آره نیازمش کنیم"
    },
    {
      "id": 73,
      "start": 15551.34,
      "end": 15553.34,
      "formatted_start": "04:19:11.340",
      "formatted_end": "04:19:13.340",
      "text": "به همون تستت باگره هم وضع فرمی کردم"
    },
    {
      "id": 74,
      "start": 15553.34,
      "end": 15558.34,
      "formatted_start": "04:19:13.340",
      "formatted_end": "04:19:18.340",
      "text": "برای اون ده همون برم؟ ده همون بیرم اعتمالا مشکل"
    },
    {
      "id": 75,
      "start": 15558.34,
      "end": 15560.34,
      "formatted_start": "04:19:18.340",
      "formatted_end": "04:19:20.340",
      "text": "خب تا یک ماه وقت داریم"
    },
    {
      "id": 76,
      "start": 15560.34,
      "end": 15562.34,
      "formatted_start": "04:19:20.340",
      "formatted_end": "04:19:22.340",
      "text": "آه تا یک ماه وقت برگردم بعد اینجورم"
    },
    {
      "id": 77,
      "start": 15562.34,
      "end": 15564.34,
      "formatted_start": "04:19:22.340",
      "formatted_end": "04:19:24.340",
      "text": "تاریخ آزمایه شد یک ماه وقت داریم"
    },
    {
      "id": 78,
      "start": 15564.34,
      "end": 15566.34,
      "formatted_start": "04:19:24.340",
      "formatted_end": "04:19:26.340",
      "text": "باشه بسیار بسیار بردم"
    },
    {
      "id": 79,
      "start": 15566.34,
      "end": 15568.34,
      "formatted_start": "04:19:26.340",
      "formatted_end": "04:19:28.340",
      "text": "پس دیگه هیچ دارو هیچ نیاز نیست؟"
    },
    {
      "id": 80,
      "start": 15568.34,
      "end": 15570.34,
      "formatted_start": "04:19:28.340",
      "formatted_end": "04:19:30.340",
      "text": "نه اصلا دارو این نیست"
    },
    {
      "id": 81,
      "start": 15570.34,
      "end": 15572.34,
      "formatted_start": "04:19:30.340",
      "formatted_end": "04:19:32.340",
      "text": "میدونید که من موانم مثلا قندم داره، هیتکارون اداره"
    },
    {
      "id": 82,
      "start": 15572.34,
      "end": 15574.34,
      "formatted_start": "04:19:32.340",
      "formatted_end": "04:19:34.340",
      "text": "ترس از اینم مثلا دیوز با آزمایم گفتم"
    },
    {
      "id": 83,
      "start": 15574.34,
      "end": 15576.34,
      "formatted_start": "04:19:34.340",
      "formatted_end": "04:19:36.340",
      "text": "و گفتم من نبات میگم چون خام جمع شدید"
    },
    {
      "id": 84,
      "start": 15576.34,
      "end": 15578.34,
      "formatted_start": "04:19:36.340",
      "formatted_end": "04:19:38.340",
      "text": "تو بیا برو ببین چی جوریه"
    },
    {
      "id": 85,
      "start": 15578.34,
      "end": 15580.34,
      "formatted_start": "04:19:38.340",
      "formatted_end": "04:19:40.340",
      "text": "بله من رو نیست کامل ازتون گرفتم"
    },
    {
      "id": 86,
      "start": 15580.34,
      "end": 15582.34,
      "formatted_start": "04:19:40.340",
      "formatted_end": "04:19:42.340",
      "text": "خب پد هم قند مخفیه چک میکنم"
    },
    {
      "id": 87,
      "start": 15582.34,
      "end": 15584.34,
      "formatted_start": "04:19:42.340",
      "formatted_end": "04:19:44.340",
      "text": "یا خود نکردم"
    },
    {
      "id": 88,
      "start": 15584.34,
      "end": 15586.34,
      "formatted_start": "04:19:44.340",
      "formatted_end": "04:19:46.340",
      "text": "آقای اون خاطر اونها دیگه ارستاری هست"
    },
    {
      "id": 89,
      "start": 15586.34,
      "end": 15588.34,
      "formatted_start": "04:19:46.340",
      "formatted_end": "04:19:48.340",
      "text": "از پدر و از مادر"
    },
    {
      "id": 90,
      "start": 15588.34,
      "end": 15590.34,
      "formatted_start": "04:19:48.340",
