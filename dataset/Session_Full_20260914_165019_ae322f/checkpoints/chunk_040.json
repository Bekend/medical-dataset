  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12006.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:06.000",
      "text": "اگر بخواد تبدیل می کنید، یا باید به دو قلم انسالینشون تبدیل کنید."
    },
    {
      "id": 1,
      "start": 12006.0,
      "end": 12014.0,
      "formatted_start": "03:20:06.000",
      "formatted_end": "03:20:14.000",
      "text": "قبلاً که مثلاً اون قبلیه رو می زد، صبح یادونه مثلاً یه چهار واحدی می زد، شب مثلاً یه بیس واحدی می زد."
    },
    {
      "id": 2,
      "start": 12014.0,
      "end": 12017.0,
      "formatted_start": "03:20:14.000",
      "formatted_end": "03:20:17.000",
      "text": "فرمو کردید، مثلاً نارنجی بود و سر بود، اون چیزی که یادم آمده."
    },
    {
      "id": 3,
      "start": 12017.0,
      "end": 12018.0,
      "formatted_start": "03:20:17.000",
      "formatted_end": "03:20:18.000",
      "text": "اونا چرا عوض کرده؟"
    },
    {
      "id": 4,
      "start": 12018.0,
      "end": 12019.0,
      "formatted_start": "03:20:18.000",
      "formatted_end": "03:20:19.000",
      "text": "نبود."
    },
    {
      "id": 5,
      "start": 12019.0,
      "end": 12021.0,
      "formatted_start": "03:20:19.000",
      "formatted_end": "03:20:21.000",
      "text": "الان هسته."
    },
    {
      "id": 6,
      "start": 12021.0,
      "end": 12023.0,
      "formatted_start": "03:20:21.000",
      "formatted_end": "03:20:23.000",
      "text": "باز برگردیم به قبل؟"
    },
    {
      "id": 7,
      "start": 12023.0,
      "end": 12026.0,
      "formatted_start": "03:20:23.000",
      "formatted_end": "03:20:26.000",
      "text": "آره، اون بهترین روش درمانه."
    },
    {
      "id": 8,
      "start": 12026.0,
      "end": 12040.0,
      "formatted_start": "03:20:26.000",
      "formatted_end": "03:20:40.000",
      "text": "یعنی از این وقت باید برنامه نیمی بیشتر برسید و این عددی که شما میدید میزدید، من یک عدد شپایی را شروع میدهم"
    },
    {
      "id": 9,
      "start": 12040.0,
      "end": 12045.0,
      "formatted_start": "03:20:40.000",
      "formatted_end": "03:20:45.000",
      "text": "بعد شما برنامه بعد از 3 روز قنداشون را میگیرید و از این وقت انسولین را تنظیم می کنید"
    },
    {
      "id": 10,
      "start": 12045.0,
      "end": 12049.0,
      "formatted_start": "03:20:45.000",
      "formatted_end": "03:20:49.000",
      "text": "این بهترین کاریه که باید برای شما انجام بدید"
    },
    {
      "id": 11,
      "start": 12049.0,
      "end": 12051.0,
      "formatted_start": "03:20:49.000",
      "formatted_end": "03:20:51.000",
      "text": "همین کاریه؟"
    },
    {
      "id": 12,
      "start": 12051.0,
      "end": 12053.0,
      "formatted_start": "03:20:51.000",
      "formatted_end": "03:20:53.000",
      "text": "آره، و بعد مهم داره فشار چی میخوره؟"
    },
    {
      "id": 13,
      "start": 12053.0,
      "end": 12058.0,
      "formatted_start": "03:20:53.000",
      "formatted_end": "03:20:58.000",
      "text": "بشار واردوزک یه همشیلی میخوره"
    },
    {
      "id": 14,
      "start": 12058.0,
      "end": 12062.0,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:02.000",
      "text": "واردوزک های صده شست ویسته پنج یه همشیلی"
    },
    {
      "id": 15,
      "start": 12062.0,
      "end": 12064.0,
      "formatted_start": "03:21:02.000",
      "formatted_end": "03:21:04.000",
      "text": "چون من خودم همونو میخورم"
    },
    {
      "id": 16,
      "start": 12064.0,
      "end": 12065.0,
      "formatted_start": "03:21:04.000",
      "formatted_end": "03:21:05.000",
      "text": "من نصفه"
    },
    {
      "id": 17,
      "start": 12065.0,
      "end": 12068.0,
      "formatted_start": "03:21:05.000",
      "formatted_end": "03:21:08.000",
      "text": "یا اینکه الان چیزی داره"
    },
    {
      "id": 18,
      "start": 12068.0,
      "end": 12070.0,
      "formatted_start": "03:21:08.000",
      "formatted_end": "03:21:10.000",
      "text": "راستی"
    },
    {
      "id": 19,
      "start": 12070.0,
      "end": 12072.0,
      "formatted_start": "03:21:10.000",
      "formatted_end": "03:21:12.000",
      "text": "چی که اسمش؟"
    },
    {
      "id": 20,
      "start": 12072.0,
      "end": 12074.0,
      "formatted_start": "03:21:12.000",
      "formatted_end": "03:21:14.000",
      "text": "چون دفعه پرترین داره"
    },
    {
      "id": 21,
      "start": 12076.0,
      "end": 12078.0,
      "formatted_start": "03:21:16.000",
      "formatted_end": "03:21:18.000",
      "text": "چی چی یه صد میخوره؟"
    },
    {
      "id": 22,
      "start": 12078.0,
      "end": 12081.0,
      "formatted_start": "03:21:18.000",
      "formatted_end": "03:21:21.000",
      "text": "آرتستان صد یه همشیلی"
    },
    {
      "id": 23,
      "start": 12081.0,
      "end": 12082.0,
      "formatted_start": "03:21:21.000",
      "formatted_end": "03:21:22.000",
      "text": "آرتستان"
    },
    {
      "id": 24,
      "start": 12082.0,
      "end": 12084.0,
      "formatted_start": "03:21:22.000",
      "formatted_end": "03:21:24.000",
      "text": "او تو همینطور باز وزارتانه دیگه"
    },
    {
      "id": 25,
      "start": 12084.0,
      "end": 12086.0,
      "formatted_start": "03:21:24.000",
      "formatted_end": "03:21:26.000",
      "text": "ترکیب وزارتانه باید آمده دیگه"
    },
    {
      "id": 26,
      "start": 12088.0,
      "end": 12091.0,
      "formatted_start": "03:21:28.000",
      "formatted_end": "03:21:31.000",
      "text": "اصمه چیز دوز؟ عویدی چیشی بود؟"
    },
    {
      "id": 27,
      "start": 12093.0,
      "end": 12095.0,
      "formatted_start": "03:21:33.000",
      "formatted_end": "03:21:35.000",
      "text": "وزارتانه"
    },
    {
      "id": 28,
      "start": 12097.0,
      "end": 12098.0,
      "formatted_start": "03:21:37.000",
      "formatted_end": "03:21:38.000",
      "text": "الفی دو"
    },
    {
      "id": 29,
      "start": 12098.0,
      "end": 12100.0,
      "formatted_start": "03:21:38.000",
      "formatted_end": "03:21:40.000",
      "text": "الفی دو سالی"
    },
    {
      "id": 30,
      "start": 12112.0,
      "end": 12142.0,
      "formatted_start": "03:21:52.000",
      "formatted_end": "03:22:22.000",
      "text": "مردم ها را با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه"
    },
    {
      "id": 31,
      "start": 12142.0,
      "end": 12149.44,
      "formatted_start": "03:22:22.000",
      "formatted_end": "03:22:29.440",
      "text": "با ترجیل سیر بکترین کاری که برای شما انجام بدید بی خطر ترین درمانی"
    },
    {
      "id": 32,
      "start": 12149.44,
      "end": 12158.0,
      "formatted_start": "03:22:29.440",
      "formatted_end": "03:22:38.000",
      "text": "چند تا می زد این شب ها؟"
    },
    {
      "id": 33,
      "start": 12158.64,
      "end": 12163.0,
      "formatted_start": "03:22:38.640",
      "formatted_end": "03:22:43.000",
      "text": "الان که صبح 22 تا می زد قبلن 20 تا شب می زد بکنن"
    },
    {
      "id": 34,
      "start": 12163.0,
      "end": 12164.84,
      "formatted_start": "03:22:43.000",
      "formatted_end": "03:22:44.840",
      "text": "الان فقط صبح 22 تا"
    },
    {
      "id": 35,
      "start": 12164.84,
      "end": 12165.26,
      "formatted_start": "03:22:44.840",
      "formatted_end": "03:22:45.260",
      "text": "بله"
    },
    {
      "id": 36,
      "start": 12165.26,
      "end": 12167.18,
      "formatted_start": "03:22:45.260",
      "formatted_end": "03:22:47.180",
      "text": "بله می شد"
    },
    {
      "id": 37,
      "start": 12167.18,
      "end": 12170.52,
      "formatted_start": "03:22:47.180",
      "formatted_end": "03:22:50.520",
      "text": "بس صبح 22 تا می زد ساعت ده هفته قرن نمی ده"
    },
    {
      "id": 38,
      "start": 12170.52,
      "end": 12171.54,
      "formatted_start": "03:22:50.520",
      "formatted_end": "03:22:51.540",
      "text": "ده صبح"
    },
    {
      "id": 39,
      "start": 12171.54,
      "end": 12173.54,
      "formatted_start": "03:22:51.540",
      "formatted_end": "03:22:53.540",
      "text": "چیزی اعتراضی نداشت"
    },
    {
      "id": 40,
      "start": 12176.54,
      "end": 12178.54,
      "formatted_start": "03:22:56.540",
      "formatted_end": "03:22:58.540",
      "text": "خوردشون رایت میکنن؟"
    },
    {
      "id": 41,
      "start": 12179.54,
      "end": 12181.54,
      "formatted_start": "03:22:59.540",
      "formatted_end": "03:23:01.540",
      "text": "کمی تا قسمتی"
    },
    {
      "id": 42,
      "start": 12182.54,
      "end": 12184.54,
      "formatted_start": "03:23:02.540",
      "formatted_end": "03:23:04.540",
      "text": "رایت نمیکنه خیلی؟"
    },
    {
      "id": 43,
      "start": 12187.54,
      "end": 12190.54,
      "formatted_start": "03:23:07.540",
      "formatted_end": "03:23:10.540",
      "text": "مثلا هنگیه روی خورد یه هر جهت باشه"
    },
    {
      "id": 44,
      "start": 12191.54,
      "end": 12193.54,
      "formatted_start": "03:23:11.540",
      "formatted_end": "03:23:13.540",
      "text": "چیزایی که دوست داره جلوش نیست"
    },
    {
      "id": 45,
      "start": 12193.54,
      "end": 12195.54,
      "formatted_start": "03:23:13.540",
      "formatted_end": "03:23:15.540",
      "text": "بهش هم بگی خیلی ناراض میشه"
    },
    {
      "id": 46,
      "start": 12196.54,
      "end": 12199.54,
      "formatted_start": "03:23:16.540",
      "formatted_end": "03:23:19.540",
      "text": "اینو آره مثلا من میگم آدموسه بزنیم هر چی میخواد"
    },
    {
      "id": 47,
      "start": 12199.54,
      "end": 12203.54,
      "formatted_start": "03:23:19.540",
      "formatted_end": "03:23:23.540",
      "text": "بخور یکم انسانشون بالا میرن چون انسانشون سیارت نیست که میتونی تنظیم کنه"
    },
    {
      "id": 48,
      "start": 12225.54,
      "end": 12227.54,
      "formatted_start": "03:23:45.540",
      "formatted_end": "03:23:47.540",
      "text": "قبول میکنن الان عوض کنیم"
    },
    {
      "id": 49,
      "start": 12227.54,
      "end": 12230.54,
      "formatted_start": "03:23:47.540",
      "formatted_end": "03:23:50.540",
      "text": "اگر این افراد باید قبول می کنند، چرا نکنند؟"
    },
    {
      "id": 50,
      "start": 12230.54,
      "end": 12233.54,
      "formatted_start": "03:23:50.540",
      "formatted_end": "03:23:53.540",
      "text": "مریض ها بعضی تحصیل را زیر باز کنند"
    },
    {
      "id": 51,
      "start": 12233.54,
      "end": 12240.54,
      "formatted_start": "03:23:53.540",
      "formatted_end": "03:24:00.540",
      "text": "نه، اون چیز نیست، اصلا از اون لحاظ بگیم، آقا این باید عوض بشه برای زندگی خوب هایی که قبول می کنند"
    },
    {
      "id": 52,
      "start": 12240.54,
      "end": 12243.54,
      "formatted_start": "03:24:00.540",
      "formatted_end": "03:24:03.540",
      "text": "چون مریض باید احساس آرامش بکنه"
    },
    {
      "id": 53,
      "start": 12243.54,
      "end": 12246.54,
      "formatted_start": "03:24:03.540",
      "formatted_end": "03:24:06.540",
      "text": "ولی مثلا می گوییم آقا بیا بیاییم آرتزوز فاتر عمل کنیم، می گویی نه"
    },
    {
      "id": 54,
      "start": 12246.54,
      "end": 12251.54,
      "formatted_start": "03:24:06.540",
      "formatted_end": "03:24:11.540",
      "text": "نه نه، هشتا صبح روی دمت کنید و اونوشو نصف میکنند"
    },
    {
      "id": 55,
      "start": 12251.54,
      "end": 12255.54,
      "formatted_start": "03:24:11.540",
      "formatted_end": "03:24:15.540",
      "text": "وقت برد میکنند و همین یخواست زنگاوشو ازش میدهند"
    },
    {
      "id": 56,
      "start": 12255.54,
      "end": 12259.54,
      "formatted_start": "03:24:15.540",
      "formatted_end": "03:24:19.540",
      "text": "خیلی تو روح رفته ندیدش میکنند؟"
    },
    {
      "id": 57,
      "start": 12259.54,
      "end": 12262.54,
      "formatted_start": "03:24:19.540",
      "formatted_end": "03:24:22.540",
      "text": "نه میتونند، چند تا زایمان باشند"
    },
    {
      "id": 58,
      "start": 12262.54,
      "end": 12264.54,
      "formatted_start": "03:24:22.540",
      "formatted_end": "03:24:24.540",
      "text": "هشتا؟"
    },
    {
      "id": 59,
      "start": 12264.54,
      "end": 12271.54,
      "formatted_start": "03:24:24.540",
      "formatted_end": "03:24:31.540",
      "text": "فرقی و سخان دارند، الان مریض امتحانی به ازم پیناش جوش میمیخوند"
    },
    {
      "id": 60,
      "start": 12276.54,
      "end": 12286.54,
      "formatted_start": "03:24:36.540",
      "formatted_end": "03:24:46.540",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}