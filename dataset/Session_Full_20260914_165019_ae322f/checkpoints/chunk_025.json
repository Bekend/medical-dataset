  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7506.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:06.000",
      "text": "اگر در این وقت بینید، برس شروع می کنید. اگر در این وقت بینید، برس شروع می کنید."
    },
    {
      "id": 1,
      "start": 7506.0,
      "end": 7508.0,
      "formatted_start": "02:05:06.000",
      "formatted_end": "02:05:08.000",
      "text": "اگر در این وقت بینید، برس شروع می کنید."
    },
    {
      "id": 2,
      "start": 7508.0,
      "end": 7510.0,
      "formatted_start": "02:05:08.000",
      "formatted_end": "02:05:10.000",
      "text": "چربیتون هم بالا است."
    },
    {
      "id": 3,
      "start": 7510.0,
      "end": 7512.0,
      "formatted_start": "02:05:10.000",
      "formatted_end": "02:05:12.000",
      "text": "چربیتون هم بالا است."
    },
    {
      "id": 4,
      "start": 7512.0,
      "end": 7514.0,
      "formatted_start": "02:05:12.000",
      "formatted_end": "02:05:14.000",
      "text": "چربیتون هم بالا است."
    },
    {
      "id": 5,
      "start": 7514.0,
      "end": 7516.0,
      "formatted_start": "02:05:14.000",
      "formatted_end": "02:05:16.000",
      "text": "چربیتون هم بالا است."
    },
    {
      "id": 6,
      "start": 7516.0,
      "end": 7518.0,
      "formatted_start": "02:05:16.000",
      "formatted_end": "02:05:18.000",
      "text": "لب مرز است."
    },
    {
      "id": 7,
      "start": 7518.0,
      "end": 7520.0,
      "formatted_start": "02:05:18.000",
      "formatted_end": "02:05:20.000",
      "text": "تیرویدتون خوب است."
    },
    {
      "id": 8,
      "start": 7520.0,
      "end": 7522.0,
      "formatted_start": "02:05:20.000",
      "formatted_end": "02:05:22.000",
      "text": "ویتامین دیتون یک ذره است."
    },
    {
      "id": 9,
      "start": 7522.0,
      "end": 7524.0,
      "formatted_start": "02:05:22.000",
      "formatted_end": "02:05:24.000",
      "text": "کمخونی ندارید."
    },
    {
      "id": 10,
      "start": 7524.0,
      "end": 7526.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:26.000",
      "text": "بقیه آزمایشاتون عالی است."
    },
    {
      "id": 11,
      "start": 7526.0,
      "end": 7527.0,
      "formatted_start": "02:05:26.000",
      "formatted_end": "02:05:27.000",
      "text": "به شندیزه؟"
    },
    {
      "id": 12,
      "start": 7527.0,
      "end": 7529.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:29.000",
      "text": "جوانی ها دوباره دفتم دیگه"
    },
    {
      "id": 13,
      "start": 7529.0,
      "end": 7531.0,
      "formatted_start": "02:05:29.000",
      "formatted_end": "02:05:31.000",
      "text": "الان هم شندیزه داریم"
    },
    {
      "id": 14,
      "start": 7531.0,
      "end": 7542.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:42.000",
      "text": "خب، آب زیاد بخورید، اطرافتون رو نگه ندارید، نمک به غذا تون اضافه نکنید، اسپناج، گوشت قرمز، اینا سنگورد تشدید میکنند"
    },
    {
      "id": 15,
      "start": 7544.0,
      "end": 7548.0,
      "formatted_start": "02:05:44.000",
      "formatted_end": "02:05:48.000",
      "text": "فعلا فقط یه ویتامین دی، رهد و مایو که فعلا هیچ داروی نیاز نداریم شد"
    },
    {
      "id": 16,
      "start": 7548.0,
      "end": 7551.0,
      "formatted_start": "02:05:48.000",
      "formatted_end": "02:05:51.000",
      "text": "بخوره یه ویتامین دی بهتون میدم اتمان"
    },
    {
      "id": 17,
