  "stt_segments": [
    {
      "id": 0,
      "start": 19800.0,
      "end": 19802.0,
      "formatted_start": "05:30:00.000",
      "formatted_end": "05:30:02.000",
      "text": "اینجور کنید."
    },
    {
      "id": 1,
      "start": 19830.0,
      "end": 19832.0,
      "formatted_start": "05:30:30.000",
      "formatted_end": "05:30:32.000",
      "text": "برای دوگاه شده نگیره"
    },
    {
      "id": 2,
      "start": 19832.0,
      "end": 19834.0,
      "formatted_start": "05:30:32.000",
      "formatted_end": "05:30:34.000",
      "text": "آره بسته"
    },
    {
      "id": 3,
      "start": 19834.0,
      "end": 19836.0,
      "formatted_start": "05:30:34.000",
      "formatted_end": "05:30:36.000",
      "text": "مرا برم بزنی؟"
    },
    {
      "id": 4,
      "start": 19836.0,
      "end": 19838.0,
      "formatted_start": "05:30:36.000",
      "formatted_end": "05:30:38.000",
      "text": "نه، نخواهیم تو براشی گیره دسته با چوا بشی"
    },
    {
      "id": 5,
      "start": 19838.0,
      "end": 19840.0,
      "formatted_start": "05:30:38.000",
      "formatted_end": "05:30:40.000",
      "text": "سمی خیلی زیادی هست"
    },
    {
      "id": 6,
      "start": 19842.0,
      "end": 19844.0,
      "formatted_start": "05:30:42.000",
      "formatted_end": "05:30:44.000",
      "text": "چربی های سخت"
    },
    {
      "id": 7,
      "start": 19844.0,
      "end": 19846.0,
      "formatted_start": "05:30:44.000",
      "formatted_end": "05:30:46.000",
      "text": "خیلی ناراض شدم برای تو"
    },
    {
      "id": 8,
      "start": 19848.0,
      "end": 19850.0,
      "formatted_start": "05:30:48.000",
      "formatted_end": "05:30:50.000",
      "text": "با خدا بوده از آنهای خواهیده هم"
    },
    {
      "id": 9,
      "start": 19850.0,
      "end": 19852.0,
      "formatted_start": "05:30:50.000",
      "formatted_end": "05:30:52.000",
      "text": "تومن نکنه"
    },
    {
      "id": 10,
      "start": 19852.0,
      "end": 19854.0,
      "formatted_start": "05:30:52.000",
      "formatted_end": "05:30:54.000",
      "text": "سلوک کنه"
    },
    {
      "id": 11,
      "start": 19854.0,
      "end": 19856.0,
      "formatted_start": "05:30:54.000",
      "formatted_end": "05:30:56.000",
      "text": "بسیار خوشی کنه"
    },
    {
      "id": 12,
      "start": 19856.0,
      "end": 19858.0,
      "formatted_start": "05:30:56.000",
      "formatted_end": "05:30:58.000",
      "text": "دروت برخواست"
    },
    {
      "id": 13,
      "start": 19858.0,
      "end": 19860.0,
      "formatted_start": "05:30:58.000",
      "formatted_end": "05:31:00.000",
      "text": "از رنگیر را برای جدن دیدیم"
    },
    {
      "id": 14,
      "start": 19860.0,
      "end": 19862.0,
      "formatted_start": "05:31:00.000",
      "formatted_end": "05:31:02.000",
      "text": "باشید"
    },
    {
      "id": 15,
      "start": 19862.0,
      "end": 19864.0,
      "formatted_start": "05:31:02.000",
      "formatted_end": "05:31:04.000",
      "text": "منتظرم"
    },
    {
      "id": 16,
      "start": 19864.0,
      "end": 19866.0,
      "formatted_start": "05:31:04.000",
      "formatted_end": "05:31:06.000",
      "text": "برگردارت برگردارت"
    },
    {
      "id": 17,
      "start": 19866.0,
      "end": 19868.0,
      "formatted_start": "05:31:06.000",
      "formatted_end": "05:31:08.000",
      "text": "چی شده؟"
    },
    {
      "id": 18,
      "start": 19868.0,
      "end": 19870.0,
      "formatted_start": "05:31:08.000",
      "formatted_end": "05:31:10.000",
      "text": "از دل آمده هست"
    },
    {
      "id": 19,
      "start": 19870.0,
      "end": 19872.0,
      "formatted_start": "05:31:10.000",
      "formatted_end": "05:31:12.000",
      "text": "صورتت چی شده؟"
    },
    {
      "id": 20,
      "start": 19872.0,
      "end": 19874.0,
      "formatted_start": "05:31:12.000",
      "formatted_end": "05:31:14.000",
      "text": "چطورت هست؟"
    },
    {
      "id": 21,
      "start": 19874.0,
      "end": 19876.0,
      "formatted_start": "05:31:14.000",
      "formatted_end": "05:31:16.000",
      "text": "اینا؟"
    },
    {
      "id": 22,
      "start": 19876.0,
      "end": 19878.0,
      "formatted_start": "05:31:16.000",
      "formatted_end": "05:31:18.000",
      "text": "سر من از هم دو تا روز یاد کردم"
    },
    {
      "id": 23,
      "start": 19878.0,
      "end": 19880.0,
      "formatted_start": "05:31:18.000",
      "formatted_end": "05:31:20.000",
      "text": "که انجام شده؟"
    },
    {
      "id": 24,
      "start": 19880.0,
      "end": 19882.0,
      "formatted_start": "05:31:20.000",
      "formatted_end": "05:31:22.000",
      "text": "خودتان سال داره"
    },
    {
      "id": 25,
      "start": 19882.0,
      "end": 19884.0,
      "formatted_start": "05:31:22.000",
      "formatted_end": "05:31:24.000",
      "text": "اینجا چند سال همینطوری صورتم زخم زنه"
    },
    {
      "id": 26,
      "start": 19884.0,
      "end": 19886.0,
      "formatted_start": "05:31:24.000",
      "formatted_end": "05:31:26.000",
      "text": "کم کم با اون زبایی میاد بالا"
    },
    {
      "id": 27,
      "start": 19886.0,
      "end": 19892.46,
      "formatted_start": "05:31:26.000",
      "formatted_end": "05:31:32.460",
      "text": "خودش با خوبش، الان اینجا بود، از اینجا آمد اینجا، الان مثلا اینجا باش سیاه شده خوب شده"
    },
    {
      "id": 28,
      "start": 19892.46,
      "end": 19894.34,
      "formatted_start": "05:31:32.460",
      "formatted_end": "05:31:34.340",
      "text": "تو سر منو منده"
    },
    {
      "id": 29,
      "start": 19894.34,
      "end": 19896.34,
      "formatted_start": "05:31:34.340",
      "formatted_end": "05:31:36.340",
      "text": "به تام صورت لک میشه نه؟"
    },
    {
      "id": 30,
      "start": 19896.34,
      "end": 19898.34,
      "formatted_start": "05:31:36.340",
      "formatted_end": "05:31:38.340",
      "text": "با خودش خوب میشه"
    },
    {
      "id": 31,
      "start": 19898.34,
      "end": 19900.34,
      "formatted_start": "05:31:38.340",
      "formatted_end": "05:31:40.340",
      "text": "با خودش خوب میشه"
    },
    {
      "id": 32,
      "start": 19900.34,
      "end": 19902.34,
      "formatted_start": "05:31:40.340",
      "formatted_end": "05:31:42.340",
      "text": "نه، اینجا هم خوب"
    },
    {
      "id": 33,
      "start": 19902.34,
      "end": 19904.34,
      "formatted_start": "05:31:42.340",
      "formatted_end": "05:31:44.340",
      "text": "اولا بود اینجا هم خوب شده"
    },
    {
      "id": 34,
      "start": 19904.34,
      "end": 19906.34,
      "formatted_start": "05:31:44.340",
      "formatted_end": "05:31:46.340",
      "text": "با صورت خوبش بود، لکش بود خوب شده"
    },
    {
      "id": 35,
      "start": 19906.34,
      "end": 19908.34,
      "formatted_start": "05:31:46.340",
      "formatted_end": "05:31:48.340",
      "text": "نه، لکش بود"
    },
    {
      "id": 36,
      "start": 19908.34,
      "end": 19910.34,
      "formatted_start": "05:31:48.340",
      "formatted_end": "05:31:50.340",
      "text": "قضیه هست میشه؟"
    },
    {
      "id": 37,
      "start": 19910.34,
      "end": 19940.34,
      "formatted_start": "05:31:50.340",
      "formatted_end": "05:32:20.340",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 38,
      "start": 19940.34,
      "end": 19942.34,
      "formatted_start": "05:32:20.340",
      "formatted_end": "05:32:22.340",
      "text": "این فقط کبد چرم دوره"
    },
    {
      "id": 39,
      "start": 19942.34,
      "end": 19946.34,
      "formatted_start": "05:32:22.340",
      "formatted_end": "05:32:26.340",
      "text": "کبد ترم هم درد کنید"
    },
    {
      "id": 40,
      "start": 19946.34,
      "end": 19950.34,
      "formatted_start": "05:32:26.340",
      "formatted_end": "05:32:30.340",
      "text": "اینو داده باید بخوانیم که بخونم"
    },
    {
      "id": 41,
      "start": 19950.34,
      "end": 19952.34,
      "formatted_start": "05:32:30.340",
      "formatted_end": "05:32:32.340",
      "text": "اینو برگل"
    },
    {
      "id": 42,
      "start": 19952.34,
      "end": 19954.34,
      "formatted_start": "05:32:32.340",
      "formatted_end": "05:32:34.340",
      "text": "ارخ داره سده چرم"
    },
    {
      "id": 43,
      "start": 19954.34,
      "end": 19958.34,
      "formatted_start": "05:32:34.340",
      "formatted_end": "05:32:38.340",
      "text": "ملوک سیکون"
    },
    {
      "id": 44,
      "start": 19958.34,
      "end": 19960.34,
      "formatted_start": "05:32:38.340",
      "formatted_end": "05:32:40.340",
      "text": "برادر مرزیه"
    },
    {
      "id": 45,
      "start": 19960.34,
      "end": 19962.34,
      "formatted_start": "05:32:40.340",
      "formatted_end": "05:32:42.340",
      "text": "برادر مرزیه"
    },
    {
      "id": 46,
      "start": 19962.34,
      "end": 19964.34,
      "formatted_start": "05:32:42.340",
      "formatted_end": "05:32:44.340",
      "text": "کبیر هم چرم میتونم"
    },
    {
      "id": 47,
      "start": 19964.34,
      "end": 19966.34,
      "formatted_start": "05:32:44.340",
      "formatted_end": "05:32:46.340",
      "text": "ترسه بخونم"
    },
    {
      "id": 48,
      "start": 19966.34,
      "end": 19968.34,
      "formatted_start": "05:32:46.340",
      "formatted_end": "05:32:48.340",
      "text": "آره بگیم گرس خیلی تاثیر نداره"
    },
    {
      "id": 49,
      "start": 19968.34,
      "end": 19971.34,
      "formatted_start": "05:32:48.340",
      "formatted_end": "05:32:51.340",
      "text": "این فرزش تخیل داشته به غذاییه"
    },
    {
      "id": 50,
      "start": 19971.34,
      "end": 19973.34,
      "formatted_start": "05:32:51.340",
      "formatted_end": "05:32:53.340",
      "text": "تو که مثلا جوانی"
    },
    {
      "id": 51,
      "start": 19973.34,
      "end": 19975.34,
      "formatted_start": "05:32:53.340",
      "formatted_end": "05:32:55.340",
      "text": "آه این چیه؟"
    },
    {
      "id": 52,
      "start": 19975.34,
      "end": 19977.34,
      "formatted_start": "05:32:55.340",
      "formatted_end": "05:32:57.340",
      "text": "چه افتضایی چرا؟"
    },
    {
      "id": 53,
      "start": 19977.34,
      "end": 19979.34,
      "formatted_start": "05:32:57.340",
      "formatted_end": "05:32:59.340",
      "text": "چه خبر اینقدر قند؟"
    },
    {
      "id": 54,
      "start": 19979.34,
      "end": 19981.34,
      "formatted_start": "05:32:59.340",
      "formatted_end": "05:33:01.340",
      "text": "چه کار میکنی؟"
    },
    {
      "id": 55,
      "start": 19983.34,
      "end": 19985.34,
      "formatted_start": "05:33:03.340",
      "formatted_end": "05:33:05.340",
      "text": "ارزا قند چی میخوانی؟"
    },
    {
      "id": 56,
      "start": 19985.34,
      "end": 19987.34,
      "formatted_start": "05:33:05.340",
      "formatted_end": "05:33:07.340",
      "text": "چی میخوانی؟"
    },
    {
      "id": 57,
      "start": 19989.34,
      "end": 19991.34,
      "formatted_start": "05:33:09.340",
      "formatted_end": "05:33:11.340",
      "text": "گلو فریو؟"
    },
    {
      "id": 58,
      "start": 19991.34,
      "end": 19992.34,
      "formatted_start": "05:33:11.340",
      "formatted_end": "05:33:12.340",
      "text": "آره همینه"
    },
    {
      "id": 59,
      "start": 19992.34,
      "end": 19994.34,
      "formatted_start": "05:33:12.340",
      "formatted_end": "05:33:14.340",
      "text": "قرص بزرگا؟"
    },
    {
      "id": 60,
      "start": 19994.34,
      "end": 19997.34,
      "formatted_start": "05:33:14.340",
      "formatted_end": "05:33:17.340",
      "text": "چه خبره دیگه این همه دارو بیان قردی؟"
    },
    {
      "id": 61,
      "start": 19997.34,
      "end": 19999.34,
      "formatted_start": "05:33:17.340",
      "formatted_end": "05:33:19.340",
      "text": "باید کار میکنیم"
    },
    {
      "id": 62,
      "start": 19999.34,
      "end": 20003.34,
      "formatted_start": "05:33:19.340",
      "formatted_end": "05:33:23.340",
      "text": "580، 600، 360"
    },
    {
      "id": 63,
      "start": 20003.34,
      "end": 20005.34,
      "formatted_start": "05:33:23.340",
      "formatted_end": "05:33:25.340",
      "text": "5 سالیم باید بزنیم"
    },
    {
      "id": 64,
      "start": 20005.34,
      "end": 20007.34,
      "formatted_start": "05:33:25.340",
      "formatted_end": "05:33:27.340",
      "text": "ایوانسی 11"
    },
    {
      "id": 65,
      "start": 20007.34,
      "end": 20011.34,
      "formatted_start": "05:33:27.340",
      "formatted_end": "05:33:31.340",
      "text": "افراد شدید تو بدنه"
    },
    {
      "id": 66,
      "start": 20011.34,
      "end": 20013.34,
      "formatted_start": "05:33:31.340",
      "formatted_end": "05:33:33.340",
      "text": "غم زیاد تو ادار"
    },
    {
      "id": 67,
      "start": 20013.34,
      "end": 20015.34,
      "formatted_start": "05:33:33.340",
      "formatted_end": "05:33:35.340",
      "text": "افراد اداری شدید"
    },
    {
      "id": 68,
      "start": 20015.34,
      "end": 20021.34,
      "formatted_start": "05:33:35.340",
      "formatted_end": "05:33:41.340",
      "text": "باید برگفتم که شما کمش خواهدون تو برگفتم"
    },
    {
      "id": 69,
      "start": 20021.34,
      "end": 20025.34,
      "formatted_start": "05:33:41.340",
      "formatted_end": "05:33:45.340",
      "text": "شما یه نگاه کنید من خیلی عجله دارم"
    },
    {
      "id": 70,
      "start": 20025.34,
      "end": 20027.34,
      "formatted_start": "05:33:45.340",
      "formatted_end": "05:33:47.340",
      "text": "درست داری؟"
    },
    {
      "id": 71,
      "start": 20027.34,
      "end": 20030.34,
      "formatted_start": "05:33:47.340",
      "formatted_end": "05:33:50.340",
      "text": "پس کفت که، حالا جلو خودش میگم که رعایت کنی"
    },
    {
      "id": 72,
      "start": 20030.34,
      "end": 20034.34,
      "formatted_start": "05:33:50.340",
      "formatted_end": "05:33:54.340",
      "text": "کفت بهش رعایت کنه که خدا نگرد به شخص نگرد"
    },
    {
      "id": 73,
      "start": 20034.34,
      "end": 20036.34,
      "formatted_start": "05:33:54.340",
      "formatted_end": "05:33:56.340",
      "text": "فاجه از غنده"
    },
    {
      "id": 74,
      "start": 20036.34,
      "end": 20039.34,
      "formatted_start": "05:33:56.340",
      "formatted_end": "05:33:59.340",
      "text": "بچه دارو تو ببینم چجوری میخوری؟"
    },
    {
      "id": 75,
      "start": 20039.34,
      "end": 20041.34,
      "formatted_start": "05:33:59.340",
      "formatted_end": "05:34:01.340",
      "text": "نه، آوردمش"
    },
    {
      "id": 76,
      "start": 20043.34,
      "end": 20044.34,
      "formatted_start": "05:34:03.340",
      "formatted_end": "05:34:04.340",
      "text": "تا هم گرده بریفت کنم"
    },
    {
      "id": 77,
      "start": 20044.34,
      "end": 20045.34,
      "formatted_start": "05:34:04.340",
      "formatted_end": "05:34:05.340",
      "text": "یکی صبح"
    },
    {
      "id": 78,
      "start": 20045.34,
      "end": 20046.34,
      "formatted_start": "05:34:05.340",
      "formatted_end": "05:34:06.340",
      "text": "خب؟"
    },
    {
      "id": 79,
      "start": 20046.34,
      "end": 20050.34,
      "formatted_start": "05:34:06.340",
      "formatted_end": "05:34:10.340",
      "text": "ازاره دیگه، یکی صبح مخورم دیگه تا یه و صبح دیگه"
    },
    {
      "id": 80,
      "start": 20050.34,
      "end": 20053.34,
      "formatted_start": "05:34:10.340",
      "formatted_end": "05:34:13.340",
      "text": "اما با یه دونه که اصلا جاور نمیدونه"
    },
    {
      "id": 81,
      "start": 20053.34,
      "end": 20055.34,
      "formatted_start": "05:34:13.340",
      "formatted_end": "05:34:15.340",
      "text": "از اینکه صبح بکنه که شنن داره"
    },
    {
      "id": 82,
      "start": 20055.34,
      "end": 20057.34,
      "formatted_start": "05:34:15.340",
      "formatted_end": "05:34:17.340",
      "text": "داره باید خراب کنه"
    },
    {
      "id": 83,
      "start": 20057.34,
      "end": 20059.34,
      "formatted_start": "05:34:17.340",
      "formatted_end": "05:34:19.340",
      "text": "از نصف هم مفترض خراب شد"
    },
    {
      "id": 84,
      "start": 20059.34,
      "end": 20061.34,
      "formatted_start": "05:34:19.340",
      "formatted_end": "05:34:21.340",
      "text": "معلوم است با اینکه صورتت سخت میشه با اینها"
    },
    {
      "id": 85,
      "start": 20061.34,
      "end": 20063.34,
      "formatted_start": "05:34:21.340",
      "formatted_end": "05:34:23.340",
      "text": "نه"
    },
    {
      "id": 86,
      "start": 20063.34,
      "end": 20065.34,
      "formatted_start": "05:34:23.340",
      "formatted_end": "05:34:25.340",
      "text": "من فکر کردم مریض قبلی هم بوده"
    },
    {
      "id": 87,
      "start": 20065.34,
      "end": 20067.34,
      "formatted_start": "05:34:25.340",
      "formatted_end": "05:34:27.340",
      "text": "قبلی مریض ما نموده؟"
    },
    {
      "id": 88,
      "start": 20067.34,
      "end": 20069.34,
      "formatted_start": "05:34:27.340",
      "formatted_end": "05:34:29.340",
      "text": "یه بار اول هم"
    },
    {
      "id": 89,
      "start": 20069.34,
      "end": 20071.34,
      "formatted_start": "05:34:29.340",
      "formatted_end": "05:34:31.340",
      "text": "نه مریض هم همیشه هم نموده"
    },
    {
      "id": 90,
      "start": 20071.34,
      "end": 20073.34,
      "formatted_start": "05:34:31.340",
      "formatted_end": "05:34:33.340",
      "text": "نه تازه موندیم"
    },
    {
      "id": 91,
      "start": 20073.34,
      "end": 20075.34,
      "formatted_start": "05:34:33.340",
      "formatted_end": "05:34:35.340",
      "text": "این اولین بار میشه مونده"
    },
    {
      "id": 92,
      "start": 20075.34,
      "end": 20077.34,
      "formatted_start": "05:34:35.340",
      "formatted_end": "05:34:37.340",
      "text": "من تحجب کردم اولین بار چجوری مریض ما های اینجوری هست"
    },
    {
      "id": 93,
      "start": 20077.34,
      "end": 20079.34,
      "formatted_start": "05:34:37.340",
      "formatted_end": "05:34:39.340",
      "text": "اینجوری هست"
    },
    {
      "id": 94,
      "start": 20079.34,
      "end": 20084.34,
      "formatted_start": "05:34:39.340",
      "formatted_end": "05:34:44.340",
      "text": "بازاره گفت خوب که شعرشو مثل این غندشو خواهیم آمدیم"
    },
    {
      "id": 95,
      "start": 20092.34,
      "end": 20095.34,
      "formatted_start": "05:34:52.340",
      "formatted_end": "05:34:55.340",
      "text": "من برای شعر، باید کلوزه دیگه شروع کنیم"
    },
    {
      "id": 96,
      "start": 20095.34,
      "end": 20097.34,
      "formatted_start": "05:34:55.340",
      "formatted_end": "05:34:57.340",
      "text": "هندرن خربازه میخوری؟"
    },
    {
      "id": 97,
      "start": 20098.34,
      "end": 20100.34,
      "formatted_start": "05:34:58.340",
      "formatted_end": "05:35:00.340",
      "text": "خوردی تا به صبح"
    }
  ],
  "status": "completed"
}