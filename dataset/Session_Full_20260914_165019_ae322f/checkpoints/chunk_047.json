      "formatted_start": "03:59:16.000",
      "formatted_end": "03:59:18.000",
      "text": "خب باید بیرون همه چیزی بیرون"
    },
    {
      "id": 88,
      "start": 14358.0,
      "end": 14360.0,
      "formatted_start": "03:59:18.000",
      "formatted_end": "03:59:20.000",
      "text": "در پونزه ها روزه خاندکتر غذا میخورد"
    },
    {
      "id": 89,
      "start": 14360.0,
      "end": 14362.0,
      "formatted_start": "03:59:20.000",
      "formatted_end": "03:59:22.000",
      "text": "میگفت که حالا بده"
    },
    {
      "id": 90,
      "start": 14362.0,
      "end": 14364.0,
      "formatted_start": "03:59:22.000",
      "formatted_end": "03:59:24.000",
      "text": "سرگیجه داشت"
    },
    {
      "id": 91,
      "start": 14364.0,
      "end": 14366.0,
      "formatted_start": "03:59:24.000",
      "formatted_end": "03:59:26.000",
      "text": "من خودمون پار سال پیس شما یادگرام همون همون هم پشتم"
    },
    {
      "id": 92,
      "start": 14366.0,
      "end": 14368.0,
      "formatted_start": "03:59:26.000",
      "formatted_end": "03:59:28.000",
      "text": "جشت زده بیرون هم دارو بهم داده"
    },
    {
      "id": 93,
      "start": 14368.0,
      "end": 14370.0,
      "formatted_start": "03:59:28.000",
      "formatted_end": "03:59:30.000",
      "text": "من هم چردم خیلی بارم"
    },
    {
      "id": 94,
      "start": 14370.0,
      "end": 14372.0,
      "formatted_start": "03:59:30.000",
      "formatted_end": "03:59:32.000",
      "text": "در این سیمان خودم بیرون شد"
    },
    {
      "id": 95,
      "start": 14372.0,
      "end": 14374.0,
      "formatted_start": "03:59:32.000",
      "formatted_end": "03:59:34.000",
      "text": "پاندوده اگه حامله باشه بچه"
    },
    {
      "id": 96,
      "start": 14374.0,
      "end": 14376.0,
      "formatted_start": "03:59:34.000",
      "formatted_end": "03:59:36.000",
      "text": "نیست هم کنم هم"
    },
    {
      "id": 97,
      "start": 14376.0,
      "end": 14378.0,
      "formatted_start": "03:59:36.000",
      "formatted_end": "03:59:38.000",
      "text": "الانت حامله"
    },
    {
      "id": 98,
      "start": 14378.0,
      "end": 14380.0,
      "formatted_start": "03:59:38.000",
      "formatted_end": "03:59:40.000",
      "text": "چه میتونم بگیرم"
    },
    {
      "id": 99,
      "start": 14380.0,
      "end": 14382.0,
      "formatted_start": "03:59:40.000",
      "formatted_end": "03:59:42.000",
      "text": "بچه خامل ای دیگه"
    },
    {
      "id": 100,
      "start": 14382.0,
      "end": 14384.0,
      "formatted_start": "03:59:42.000",
      "formatted_end": "03:59:44.000",
      "text": "خدا بشکر"
    },
    {
      "id": 101,
      "start": 14384.0,
      "end": 14386.0,
      "formatted_start": "03:59:44.000",
      "formatted_end": "03:59:46.000",
      "text": "بچه خدا"
    },
    {
      "id": 102,
      "start": 14386.0,
      "end": 14388.0,
      "formatted_start": "03:59:46.000",
      "formatted_end": "03:59:48.000",
      "text": "بچه خوشی داره؟"
    },
    {
      "id": 103,
      "start": 14388.0,
      "end": 14390.0,
      "formatted_start": "03:59:48.000",
      "formatted_end": "03:59:50.000",
      "text": "اون مرخ میشه تحت بسر"
    },
    {
      "id": 104,
      "start": 14390.0,
      "end": 14392.0,
      "formatted_start": "03:59:50.000",
      "formatted_end": "03:59:52.000",
      "text": "من این صبح شده بیسم رفتم"
    },
    {
      "id": 105,
      "start": 14392.0,
      "end": 14394.0,
      "formatted_start": "03:59:52.000",
      "formatted_end": "03:59:54.000",
      "text": "ببخشید، این حالت لکه"
    },
    {
      "id": 106,
      "start": 14394.0,
      "end": 14396.0,
      "formatted_start": "03:59:54.000",
      "formatted_end": "03:59:56.000",
      "text": "خیلی دیگه از بدنم"
    },
    {
      "id": 107,
      "start": 14396.0,
      "end": 14398.0,
      "formatted_start": "03:59:56.000",
      "formatted_end": "03:59:58.000",
      "text": "کاره شد"
    },
    {
      "id": 108,
      "start": 14398.0,
      "end": 14400.0,
      "formatted_start": "03:59:58.000",
      "formatted_end": "04:00:00.000",
      "text": "ببین بچه وقتی لاله بزیر میکنه"
    }
  ],
