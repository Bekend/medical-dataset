      "formatted_start": "03:55:12.000",
      "formatted_end": "03:55:15.000",
      "text": "این بوباد چربیه، چرا چربی داره؟"
    },
    {
      "id": 4,
      "start": 14115.0,
      "end": 14116.0,
      "formatted_start": "03:55:15.000",
      "formatted_end": "03:55:16.000",
      "text": "بوده چی؟"
    },
    {
      "id": 5,
      "start": 14116.0,
      "end": 14119.0,
      "formatted_start": "03:55:16.000",
      "formatted_end": "03:55:19.000",
      "text": "اول تصور بدی و آمانه باشه باز چربی نیم"
    },
    {
      "id": 6,
      "start": 14119.0,
      "end": 14121.0,
      "formatted_start": "03:55:19.000",
      "formatted_end": "03:55:21.000",
      "text": "خب خیلی بختر چرا بوده"
    },
    {
      "id": 7,
      "start": 14121.0,
      "end": 14124.0,
      "formatted_start": "03:55:21.000",
      "formatted_end": "03:55:24.000",
      "text": "خب من مراقب بودیم که اون رو بردیم"
    },
    {
      "id": 8,
      "start": 14124.0,
      "end": 14126.0,
      "formatted_start": "03:55:24.000",
      "formatted_end": "03:55:26.000",
      "text": "تصور چرا کنه؟ پیر آزمایشون بده آره؟"
    },
    {
      "id": 9,
      "start": 14126.0,
      "end": 14128.0,
      "formatted_start": "03:55:26.000",
      "formatted_end": "03:55:28.000",
      "text": "آره، میرم برده آنهایی"
    },
    {
      "id": 10,
      "start": 14128.0,
      "end": 14134.0,
      "formatted_start": "03:55:28.000",
      "formatted_end": "03:55:34.000",
      "text": "چون ایستروم هم زدی و چربیت اومد بادونست که من بیهاد باشیم و بعد من تست بدیم"
    },
    {
      "id": 11,
      "start": 14136.0,
      "end": 14138.0,
      "formatted_start": "03:55:36.000",
      "formatted_end": "03:55:38.000",
      "text": "با این دارو خواهش هست؟"
    },
    {
      "id": 12,
      "start": 14138.0,
      "end": 14140.0,
      "formatted_start": "03:55:38.000",
      "formatted_end": "03:55:40.000",
      "text": "جا؟ آره"
    },
    {
      "id": 13,
      "start": 14140.0,
      "end": 14142.0,
      "formatted_start": "03:55:40.000",
      "formatted_end": "03:55:42.000",
      "text": "چی فرصه یاد دهی؟"
    },
    {
      "id": 14,
      "start": 14142.0,
      "end": 14144.0,
      "formatted_start": "03:55:42.000",
      "formatted_end": "03:55:44.000",
      "text": "چی فرصه دی؟ با این از ماشه بودن؟"
    },
    {
      "id": 15,
      "start": 14144.0,
      "end": 14145.0,
      "formatted_start": "03:55:44.000",
      "formatted_end": "03:55:45.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 14145.0,
      "end": 14146.0,
      "formatted_start": "03:55:45.000",
      "formatted_end": "03:55:46.000",
      "text": "تر وقت رو پیروی شدی؟"
    },
    {
      "id": 17,
      "start": 14146.0,
      "end": 14147.0,
      "formatted_start": "03:55:46.000",
      "formatted_end": "03:55:47.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 14147.0,
      "end": 14150.0,
      "formatted_start": "03:55:47.000",
      "formatted_end": "03:55:50.000",
      "text": "چون بعد آقا ببینیم چه اینکه باز برگشتون رو بستانده برگشتون"
    },
    {
      "id": 19,
      "start": 14150.0,
      "end": 14152.0,
      "formatted_start": "03:55:50.000",
      "formatted_end": "03:55:52.000",
      "text": "آره با اینجا من تست داشتیم"
    },
    {
      "id": 20,
      "start": 14158.0,
      "end": 14168.0,
      "formatted_start": "03:55:58.000",
      "formatted_end": "03:56:08.000",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 14188.0,
      "end": 14190.0,
      "formatted_start": "03:56:28.000",
      "formatted_end": "03:56:30.000",
      "text": "آره دیگه"
    },
    {
      "id": 22,
      "start": 14190.0,
      "end": 14194.0,
      "formatted_start": "03:56:30.000",
      "formatted_end": "03:56:34.000",
      "text": "برای میگه این مستر روز دارم میگم سلام بزنم بیا آدم"
    },
    {
      "id": 23,
      "start": 14194.0,
      "end": 14197.0,
      "formatted_start": "03:56:34.000",
      "formatted_end": "03:56:37.000",
      "text": "خب این اله هم حامله که میتونه باشه"
    },
    {
      "id": 24,
      "start": 14197.0,
      "end": 14199.0,
      "formatted_start": "03:56:37.000",
      "formatted_end": "03:56:39.000",
      "text": "نه حالتش یه تست میدی میگه حامله نیستی"
    },
    {
      "id": 25,
      "start": 14199.0,
      "end": 14201.0,
      "formatted_start": "03:56:39.000",
      "formatted_end": "03:56:41.000",
      "text": "دیگه بیشتر از اینکه نیست که تو تنبه"
    },
    {
      "id": 26,
      "start": 14201.0,
      "end": 14204.0,
      "formatted_start": "03:56:41.000",
      "formatted_end": "03:56:44.000",
      "text": "دارو تو نگیری تا جواب تستت نگه"
    },
    {
      "id": 27,
      "start": 14204.0,
      "end": 14206.0,
      "formatted_start": "03:56:44.000",
      "formatted_end": "03:56:46.000",
      "text": "چون تست بار سایه"
    },
    {
      "id": 28,
      "start": 14206.0,
      "end": 14208.0,
      "formatted_start": "03:56:46.000",
      "formatted_end": "03:56:48.000",
      "text": "چیز چلگو تو بار داری ممنون"
    },
    {
      "id": 29,
      "start": 14208.0,
      "end": 14211.0,
      "formatted_start": "03:56:48.000",
      "formatted_end": "03:56:51.000",
      "text": "اگه نبود میتونه دارو رو بگیری؟"
    },
    {
      "id": 30,
      "start": 14211.0,
      "end": 14212.0,
      "formatted_start": "03:56:51.000",
      "formatted_end": "03:56:52.000",
      "text": "آره"
    },
    {
      "id": 31,
