      "formatted_start": "03:56:52.000",
      "formatted_end": "03:56:54.000",
      "text": "بیداری؟"
    },
    {
      "id": 32,
      "start": 14214.0,
      "end": 14242.0,
      "formatted_start": "03:56:54.000",
      "formatted_end": "03:57:22.000",
      "text": "موسیقی"
    },
    {
      "id": 33,
      "start": 14244.0,
