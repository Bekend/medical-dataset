  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5708.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:08.000",
      "text": "از تو پرمندش رفتم داروها شو در رو بردم. بله خدا رو استرسی میکنی دیگه."
    },
    {
      "id": 1,
      "start": 5708.0,
      "end": 5714.0,
      "formatted_start": "01:35:08.000",
      "formatted_end": "01:35:14.000",
      "text": "زیبمت داره ۵۵۰ گلوری پای ۱۰ داره."
    },
    {
      "id": 2,
      "start": 5714.0,
      "end": 5716.0,
      "formatted_start": "01:35:14.000",
      "formatted_end": "01:35:16.000",
      "text": "نوشتم برایش دیگه."
    },
    {
      "id": 3,
      "start": 5716.0,
      "end": 5718.0,
      "formatted_start": "01:35:16.000",
      "formatted_end": "01:35:18.000",
      "text": "برو بیست و پنج برسی. بیست و پنج چیه؟ من نمیدونم."
    },
    {
      "id": 4,
      "start": 5718.0,
      "end": 5727.0,
      "formatted_start": "01:35:18.000",
      "formatted_end": "01:35:27.000",
      "text": "همون ۱۰، بیست و پنج هم داره. خب برای چی بینم سمیتم؟ من تو پرمندش ۱۰ هستم. عوض نکرده بودیم که."
    },
    {
      "id": 5,
      "start": 5727.0,
      "end": 5729.0,
      "formatted_start": "01:35:27.000",
      "formatted_end": "01:35:29.000",
      "text": "برگردون اونجا هست؟"
    },
    {
      "id": 6,
      "start": 5729.0,
      "end": 5731.0,
      "formatted_start": "01:35:29.000",
      "formatted_end": "01:35:31.000",
      "text": "آنجا هست"
    },
    {
      "id": 7,
      "start": 5731.0,
      "end": 5733.0,
      "formatted_start": "01:35:31.000",
      "formatted_end": "01:35:33.000",
      "text": "ببنم چیزی برم"
    },
    {
      "id": 8,
      "start": 5733.0,
      "end": 5735.0,
      "formatted_start": "01:35:33.000",
      "formatted_end": "01:35:35.000",
      "text": "باید تا یه لحظه ببینم"
    },
    {
      "id": 9,
      "start": 5735.0,
      "end": 5737.0,
      "formatted_start": "01:35:35.000",
      "formatted_end": "01:35:37.000",
      "text": "بگیرم نه باید با اونجا گیر نده دارم"
    },
    {
      "id": 10,
      "start": 5737.0,
      "end": 5739.0,
      "formatted_start": "01:35:37.000",
      "formatted_end": "01:35:39.000",
      "text": "نه اون که بیرون دیگه"
    },
    {
      "id": 11,
      "start": 5739.0,
      "end": 5741.0,
      "formatted_start": "01:35:39.000",
      "formatted_end": "01:35:41.000",
      "text": "باید بشین"
    },
    {
      "id": 12,
      "start": 5741.0,
      "end": 5743.0,
      "formatted_start": "01:35:41.000",
      "formatted_end": "01:35:43.000",
      "text": "نه میگم باید بر نگردم"
    },
    {
      "id": 13,
      "start": 5743.0,
      "end": 5745.0,
      "formatted_start": "01:35:43.000",
      "formatted_end": "01:35:45.000",
      "text": "باید چی کنم"
    },
    {
      "id": 14,
      "start": 5745.0,
      "end": 5747.0,
      "formatted_start": "01:35:45.000",
      "formatted_end": "01:35:47.000",
      "text": "نه اون که بر نمیگردونه"
    },
    {
      "id": 15,
      "start": 5747.0,
      "end": 5749.0,
      "formatted_start": "01:35:47.000",
      "formatted_end": "01:35:49.000",
      "text": "اینکه شوهرت بیده 25 من که از اول پروندشتون میکنم"
    },
    {
      "id": 16,
      "start": 5749.0,
      "end": 5751.0,
      "formatted_start": "01:35:49.000",
      "formatted_end": "01:35:51.000",
      "text": "من 25 نگردم"
    },
    {
      "id": 17,
      "start": 5751.0,
      "end": 5753.0,
      "formatted_start": "01:35:51.000",
      "formatted_end": "01:35:53.000",
      "text": "25 هم منون توغانی نمی کنیم"
    },
    {
      "id": 18,
      "start": 5753.0,
      "end": 5757.0,
      "formatted_start": "01:35:53.000",
      "formatted_end": "01:35:57.000",
      "text": "من خیلی کم پیش میاد عوض کنم این رو ۲۵ بدن"
    },
    {
      "id": 19,
      "start": 5760.0,
      "end": 5763.0,
      "formatted_start": "01:36:00.000",
      "formatted_end": "01:36:03.000",
      "text": "تو خودشون اومده تو ماشین چون کیس نفراشونه همه دارن"
    },
    {
      "id": 20,
      "start": 5763.0,
      "end": 5767.0,
      "formatted_start": "01:36:03.000",
      "formatted_end": "01:36:07.000",
      "text": "میدونم اصلا نه خب لازم نیست بند خدا رو بیاریم"
    },
    {
      "id": 21,
      "start": 5767.0,
      "end": 5770.0,
      "formatted_start": "01:36:07.000",
      "formatted_end": "01:36:10.000",
      "text": "اصلا فرقانداش هست دیگه به اون چی کار دارید؟"
    },
    {
      "id": 22,
      "start": 5770.0,
      "end": 5774.0,
      "formatted_start": "01:36:10.000",
      "formatted_end": "01:36:14.000",
      "text": "چی مرد شده این رو خودشون؟ اگه وز باشه ترشون"
    },
    {
      "id": 23,
      "start": 5774.0,
      "end": 5776.0,
      "formatted_start": "01:36:14.000",
      "formatted_end": "01:36:16.000",
      "text": "من بیمونه باید"
    },
    {
      "id": 24,
      "start": 5776.0,
      "end": 5777.0,
      "formatted_start": "01:36:16.000",
      "formatted_end": "01:36:17.000",
      "text": "نباید کردم"
    },
    {
      "id": 25,
      "start": 5777.0,
      "end": 5779.0,
      "formatted_start": "01:36:17.000",
      "formatted_end": "01:36:19.000",
      "text": "نه میگه چی دارم میگم"
    },
    {
      "id": 26,
      "start": 5779.0,
      "end": 5809.0,
      "formatted_start": "01:36:19.000",
      "formatted_end": "01:36:49.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 27,
      "start": 5809.0,
      "end": 5811.0,
      "formatted_start": "01:36:49.000",
      "formatted_end": "01:36:51.000",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 28,
      "start": 5811.0,
      "end": 5813.0,
      "formatted_start": "01:36:51.000",
      "formatted_end": "01:36:53.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 29,
      "start": 5813.0,
      "end": 5815.0,
      "formatted_start": "01:36:53.000",
      "formatted_end": "01:36:55.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 30,
      "start": 5815.0,
      "end": 5817.0,
      "formatted_start": "01:36:55.000",
      "formatted_end": "01:36:57.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 31,
      "start": 5817.0,
      "end": 5819.0,
      "formatted_start": "01:36:57.000",
      "formatted_end": "01:36:59.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 32,
      "start": 5819.0,
      "end": 5821.0,
      "formatted_start": "01:36:59.000",
      "formatted_end": "01:37:01.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 33,
      "start": 5821.0,
      "end": 5823.0,
      "formatted_start": "01:37:01.000",
      "formatted_end": "01:37:03.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 34,
      "start": 5823.0,
      "end": 5825.0,
      "formatted_start": "01:37:03.000",
      "formatted_end": "01:37:05.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 35,
      "start": 5825.0,
      "end": 5827.0,
      "formatted_start": "01:37:05.000",
      "formatted_end": "01:37:07.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 36,
      "start": 5827.0,
      "end": 5829.0,
      "formatted_start": "01:37:07.000",
      "formatted_end": "01:37:09.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 37,
      "start": 5829.0,
      "end": 5831.0,
      "formatted_start": "01:37:09.000",
      "formatted_end": "01:37:11.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 38,
      "start": 5831.0,
      "end": 5833.0,
      "formatted_start": "01:37:11.000",
      "formatted_end": "01:37:13.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 39,
      "start": 5833.0,
      "end": 5835.0,
      "formatted_start": "01:37:13.000",
      "formatted_end": "01:37:15.000",
      "text": "بیاییم بیرون"
    },
    {
      "id": 40,
      "start": 5835.0,
      "end": 5837.0,
      "formatted_start": "01:37:15.000",
      "formatted_end": "01:37:17.000",
      "text": "آره اینا اینجاست"
    },
    {
      "id": 41,
      "start": 5837.0,
      "end": 5839.0,
      "formatted_start": "01:37:17.000",
      "formatted_end": "01:37:19.000",
      "text": "پرساتشو این هر داره"
    },
    {
      "id": 42,
      "start": 5839.0,
      "end": 5841.0,
      "formatted_start": "01:37:19.000",
      "formatted_end": "01:37:21.000",
      "text": "اونها رو کلاسی رفته عملت فکر کرده"
    },
    {
      "id": 43,
      "start": 5841.0,
      "end": 5843.0,
      "formatted_start": "01:37:21.000",
      "formatted_end": "01:37:23.000",
      "text": "دیگه نخواهد اون پرسات رو بخوره"
    },
    {
      "id": 44,
      "start": 5843.0,
      "end": 5845.0,
      "formatted_start": "01:37:23.000",
      "formatted_end": "01:37:25.000",
      "text": "اگه دکتر پرساتشو گفته بخوره"
    },
    {
      "id": 45,
      "start": 5845.0,
      "end": 5847.0,
      "formatted_start": "01:37:25.000",
      "formatted_end": "01:37:27.000",
      "text": "پرسات که نه"
    },
    {
      "id": 46,
      "start": 5847.0,
      "end": 5849.0,
      "formatted_start": "01:37:27.000",
      "formatted_end": "01:37:29.000",
      "text": "کیسه سفراش برنامه"
    },
    {
      "id": 47,
      "start": 5849.0,
      "end": 5851.0,
      "formatted_start": "01:37:29.000",
      "formatted_end": "01:37:31.000",
      "text": "پرساتشو برنامه رفته بگیر"
    },
    {
      "id": 48,
      "start": 5851.0,
      "end": 5853.0,
      "formatted_start": "01:37:31.000",
      "formatted_end": "01:37:33.000",
      "text": "کیسه سفراش نداره"
    },
    {
      "id": 49,
      "start": 5853.0,
      "end": 5855.0,
      "formatted_start": "01:37:33.000",
      "formatted_end": "01:37:35.000",
      "text": "نه پرندهش دهه عزیز"
    },
    {
      "id": 50,
      "start": 5855.0,
      "end": 5857.0,
      "formatted_start": "01:37:35.000",
      "formatted_end": "01:37:37.000",
      "text": "بیا بیا بیا"
    },
    {
      "id": 51,
      "start": 5857.0,
      "end": 5859.0,
      "formatted_start": "01:37:37.000",
      "formatted_end": "01:37:39.000",
      "text": "دست شما در نفید"
    },
    {
      "id": 52,
      "start": 5859.0,
      "end": 5861.0,
      "formatted_start": "01:37:39.000",
      "formatted_end": "01:37:41.000",
      "text": "دست شما در نفید"
    },
    {
      "id": 53,
      "start": 5861.0,
      "end": 5891.0,
      "formatted_start": "01:37:41.000",
      "formatted_end": "01:38:11.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 54,
      "start": 5891.0,
      "end": 5893.0,
      "formatted_start": "01:38:11.000",
      "formatted_end": "01:38:13.000",
      "text": "درد داری که؟"
    },
    {
      "id": 55,
      "start": 5893.0,
      "end": 5895.0,
      "formatted_start": "01:38:13.000",
      "formatted_end": "01:38:15.000",
      "text": "درد نداره، این گوش سرگیم"
    },
    {
      "id": 56,
      "start": 5895.0,
      "end": 5897.0,
      "formatted_start": "01:38:15.000",
      "formatted_end": "01:38:17.000",
      "text": "این گوش نفت می کنه"
    },
    {
      "id": 57,
      "start": 5897.0,
      "end": 5899.0,
      "formatted_start": "01:38:17.000",
      "formatted_end": "01:38:19.000",
      "text": "چرا؟"
    },
    {
      "id": 58,
      "start": 5899.0,
      "end": 5901.0,
      "formatted_start": "01:38:19.000",
      "formatted_end": "01:38:21.000",
      "text": "اینجا بزرگ میشه زیر شکرم"
    },
    {
      "id": 59,
      "start": 5901.0,
      "end": 5903.0,
      "formatted_start": "01:38:21.000",
      "formatted_end": "01:38:23.000",
      "text": "بازم می کنه شکرم"
    },
    {
      "id": 60,
      "start": 5903.0,
      "end": 5905.0,
      "formatted_start": "01:38:23.000",
      "formatted_end": "01:38:25.000",
      "text": "یکمی که از این قسمت راست به بالا"
    },
    {
      "id": 61,
      "start": 5905.0,
      "end": 5907.0,
      "formatted_start": "01:38:25.000",
      "formatted_end": "01:38:27.000",
      "text": "اینجا سرگ میشه و برم می کنه"
    },
    {
      "id": 62,
      "start": 5907.0,
      "end": 5909.0,
      "formatted_start": "01:38:27.000",
      "formatted_end": "01:38:29.000",
      "text": "شما تو خرابه تو خر برده"
    },
    {
      "id": 63,
      "start": 5909.0,
      "end": 5911.0,
      "formatted_start": "01:38:29.000",
      "formatted_end": "01:38:31.000",
      "text": "و کسی سنگی کسی سفرا نداشته؟"
    },
    {
      "id": 64,
      "start": 5911.0,
      "end": 5913.0,
      "formatted_start": "01:38:31.000",
      "formatted_end": "01:38:33.000",
      "text": "کمی چرم نداشتی؟"
    },
    {
      "id": 65,
      "start": 5913.0,
      "end": 5915.0,
      "formatted_start": "01:38:33.000",
      "formatted_end": "01:38:35.000",
      "text": "نه، نه"
    },
    {
      "id": 66,
      "start": 5915.0,
      "end": 5917.0,
      "formatted_start": "01:38:35.000",
      "formatted_end": "01:38:37.000",
      "text": "نه نشانشت"
    },
    {
      "id": 67,
      "start": 5917.0,
      "end": 5919.0,
      "formatted_start": "01:38:37.000",
      "formatted_end": "01:38:39.000",
      "text": "خالی اینکه میده تو برم کرده"
    },
    {
      "id": 68,
      "start": 5919.0,
      "end": 5921.0,
      "formatted_start": "01:38:39.000",
      "formatted_end": "01:38:41.000",
      "text": "خب بگید چرا برام کرده"
    },
    {
      "id": 69,
      "start": 5921.0,
      "end": 5925.0,
      "formatted_start": "01:38:41.000",
      "formatted_end": "01:38:45.000",
      "text": "یا خود مهده هست یا کست سفر و کبد بزرگ شده"
    },
    {
      "id": 70,
      "start": 5925.0,
      "end": 5927.0,
      "formatted_start": "01:38:45.000",
      "formatted_end": "01:38:47.000",
      "text": "اول ما شما داروی مهده میدیم"
    },
    {
      "id": 71,
      "start": 5927.0,
      "end": 5930.0,
      "formatted_start": "01:38:47.000",
      "formatted_end": "01:38:50.000",
      "text": "بعد من برای تو سنو هست کبد و کست سفرو مینویسم"
    },
    {
      "id": 72,
      "start": 5930.0,
      "end": 5932.0,
      "formatted_start": "01:38:50.000",
      "formatted_end": "01:38:52.000",
      "text": "داروها تا دیگه هفته بخوریم"
    },
    {
      "id": 73,
      "start": 5932.0,
      "end": 5934.0,
      "formatted_start": "01:38:52.000",
      "formatted_end": "01:38:54.000",
      "text": "اگه تو به بهتر شدن بودید که هیچی دیگه"
    },
    {
      "id": 74,
      "start": 5934.0,
      "end": 5936.0,
      "formatted_start": "01:38:54.000",
      "formatted_end": "01:38:56.000",
      "text": "خودتای بهتر شده کستی قد بگیر"
    },
    {
      "id": 75,
      "start": 5936.0,
      "end": 5938.0,
      "formatted_start": "01:38:56.000",
      "formatted_end": "01:38:58.000",
      "text": "اون دیگه لازم بگیر"
    },
    {
      "id": 76,
      "start": 5938.0,
      "end": 5939.0,
      "formatted_start": "01:38:58.000",
      "formatted_end": "01:38:59.000",
      "text": "ببخش مدکترم"
    },
    {
      "id": 77,
      "start": 5939.0,
      "end": 5940.0,
      "formatted_start": "01:38:59.000",
      "formatted_end": "01:39:00.000",
      "text": "مردم اصلا"
    },
    {
      "id": 78,
      "start": 5940.0,
      "end": 5943.0,
      "formatted_start": "01:39:00.000",
      "formatted_end": "01:39:03.000",
      "text": "یه خورده شاید دوست دارم چیزی بگیم"
    },
    {
      "id": 79,
      "start": 5943.0,
      "end": 5946.0,
      "formatted_start": "01:39:03.000",
      "formatted_end": "01:39:06.000",
      "text": "این فرده رو خردید که اون زیاد تشکر کنید"
    },
    {
      "id": 80,
      "start": 5946.0,
      "end": 5948.0,
      "formatted_start": "01:39:06.000",
      "formatted_end": "01:39:08.000",
      "text": "خردید بشن کمه هیچ کنید"
    },
    {
      "id": 81,
      "start": 5952.0,
      "end": 5954.0,
      "formatted_start": "01:39:12.000",
      "formatted_end": "01:39:14.000",
      "text": "خواست ناشتا رو صبح بخورید"
    },
    {
      "id": 82,
      "start": 5954.0,
      "end": 5956.0,
      "formatted_start": "01:39:14.000",
      "formatted_end": "01:39:16.000",
      "text": "قضا تو در عناتون بر نمیگرده"
    },
    {
      "id": 83,
      "start": 5956.0,
      "end": 5957.0,
      "formatted_start": "01:39:16.000",
      "formatted_end": "01:39:17.000",
      "text": "آف تو قضا"
    },
    {
      "id": 84,
      "start": 5958.0,
      "end": 5960.0,
      "formatted_start": "01:39:18.000",
      "formatted_end": "01:39:20.000",
      "text": "ملدتون اینجا سوزش نمیده؟"
    },
    {
      "id": 85,
      "start": 5961.0,
      "end": 5965.0,
      "formatted_start": "01:39:21.000",
      "formatted_end": "01:39:25.000",
      "text": "نه، بعضی میوا ها که سردن چیزی وقتی سوزش دارند"
    },
    {
      "id": 86,
      "start": 5965.0,
      "end": 5966.0,
      "formatted_start": "01:39:25.000",
      "formatted_end": "01:39:26.000",
      "text": "مثل این شریع میخونند"
    },
    {
      "id": 87,
      "start": 5966.0,
      "end": 5968.0,
      "formatted_start": "01:39:26.000",
      "formatted_end": "01:39:28.000",
      "text": "دیگه الان ضرورت قض گرد میدارند"
    },
    {
      "id": 88,
      "start": 5968.0,
      "end": 5969.0,
      "formatted_start": "01:39:28.000",
      "formatted_end": "01:39:29.000",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 5969.0,
      "end": 5971.0,
      "formatted_start": "01:39:29.000",
      "formatted_end": "01:39:31.000",
      "text": "میوا هایی که از یاد مثلا رایت میشونند"
    },
    {
      "id": 90,
      "start": 5971.0,
      "end": 5975.0,
      "formatted_start": "01:39:31.000",
      "formatted_end": "01:39:35.000",
      "text": "اینجا هندوانه خربوز را دو هفته پنج کرده میخورد"
    },
    {
      "id": 91,
      "start": 5975.0,
      "end": 5977.0,
      "formatted_start": "01:39:35.000",
      "formatted_end": "01:39:37.000",
      "text": "خصوصا هندوانه"
    },
    {
      "id": 92,
      "start": 5977.0,
      "end": 5979.0,
      "formatted_start": "01:39:37.000",
      "formatted_end": "01:39:39.000",
      "text": "و شما تا حالا قرص ناشته میخوردی؟"
    },
    {
      "id": 93,
      "start": 5979.0,
      "end": 5981.0,
      "formatted_start": "01:39:39.000",
      "formatted_end": "01:39:41.000",
