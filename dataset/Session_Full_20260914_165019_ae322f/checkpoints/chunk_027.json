  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8129.98,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:29.980",
      "text": "از اینجا باید برداریم، از اینجا باید برداریم، از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 8130.0,
      "end": 8160.0,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:16:00.000",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 2,
      "start": 8160.0,
      "end": 8163.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:03.000",
      "text": "امپولش هزار خیلی قدش بلند شده"
    },
    {
      "id": 3,
      "start": 8163.0,
      "end": 8167.0,
      "formatted_start": "02:16:03.000",
      "formatted_end": "02:16:07.000",
      "text": "یه دفعه ماشالله قدش بلند شده شوناهاش پر شده"
    },
    {
      "id": 4,
      "start": 8167.0,
      "end": 8170.0,
      "formatted_start": "02:16:07.000",
      "formatted_end": "02:16:10.000",
      "text": "الان در کدام ماما باید داریم هم چقدر بزنیم"
    },
    {
      "id": 5,
      "start": 8170.0,
      "end": 8172.0,
      "formatted_start": "02:16:10.000",
      "formatted_end": "02:16:12.000",
      "text": "بگو بتونی باید بستم"
    },
    {
      "id": 6,
      "start": 8172.0,
      "end": 8175.0,
      "formatted_start": "02:16:12.000",
      "formatted_end": "02:16:15.000",
      "text": "من دیگه خوب الان چند سنته؟"
    },
    {
      "id": 7,
      "start": 8175.0,
      "end": 8177.0,
      "formatted_start": "02:16:15.000",
      "formatted_end": "02:16:17.000",
      "text": "خوب از اینکه امکانش بلندش بشه"
    },
    {
      "id": 8,
      "start": 8177.0,
      "end": 8179.0,
      "formatted_start": "02:16:17.000",
      "formatted_end": "02:16:19.000",
      "text": "بلندترم میشه؟ آره الان از ماماش بلندتر شده"
    },
    {
      "id": 9,
      "start": 8179.0,
      "end": 8183.0,
      "formatted_start": "02:16:19.000",
      "formatted_end": "02:16:23.000",
      "text": "بعد چیز هم هست کم کم هم باید بلندتر میشه"
    },
    {
      "id": 10,
      "start": 8183.0,
      "end": 8185.0,
      "formatted_start": "02:16:23.000",
      "formatted_end": "02:16:25.000",
      "text": "این شما همینطور هم جا داره دیگه تا هیچ دقیقه نمیشه"
    },
    {
      "id": 11,
      "start": 8185.0,
      "end": 8187.0,
      "formatted_start": "02:16:25.000",
      "formatted_end": "02:16:27.000",
      "text": "این هم باشه کسرها تا 25 بلند میشه"
    },
    {
      "id": 12,
      "start": 8187.0,
      "end": 8191.0,
      "formatted_start": "02:16:27.000",
      "formatted_end": "02:16:31.000",
      "text": "مطمئن باشه یه 6-8 سانتر دیگه هم بلند شما شبه خوب میشه"
    },
    {
      "id": 13,
      "start": 8191.0,
      "end": 8193.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:33.000",
      "text": "بله خیلی من لاغمم"
    },
    {
      "id": 14,
      "start": 8193.0,
      "end": 8195.0,
      "formatted_start": "02:16:33.000",
      "formatted_end": "02:16:35.000",
      "text": "این هم خیلی لاغمم"
    },
    {
      "id": 15,
      "start": 8195.0,
      "end": 8197.0,
      "formatted_start": "02:16:35.000",
      "formatted_end": "02:16:37.000",
      "text": "این هیچی با بهشو میدی"
    },
    {
      "id": 16,
      "start": 8197.0,
      "end": 8199.0,
      "formatted_start": "02:16:37.000",
      "formatted_end": "02:16:39.000",
      "text": "آره بیشتر افغانه هست"
    },
    {
      "id": 17,
      "start": 8199.0,
      "end": 8201.0,
      "formatted_start": "02:16:39.000",
      "formatted_end": "02:16:41.000",
      "text": "اگه همه چی ناخده"
    },
    {
      "id": 18,
      "start": 8201.0,
      "end": 8203.0,
      "formatted_start": "02:16:41.000",
      "formatted_end": "02:16:43.000",
      "text": "از این چی ناخده باش باش باش"
    },
    {
      "id": 19,
      "start": 8203.0,
      "end": 8205.0,
      "formatted_start": "02:16:43.000",
      "formatted_end": "02:16:45.000",
      "text": "خب اون معد درد آبونت کرده بوداش"
    },
    {
      "id": 20,
      "start": 8205.0,
      "end": 8207.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:47.000",
      "text": "تو نوکشه خوب شد"
    },
    {
      "id": 21,
      "start": 8213.0,
      "end": 8215.0,
      "formatted_start": "02:16:53.000",
      "formatted_end": "02:16:55.000",
      "text": "این ها مریضی هست؟"
    },
    {
      "id": 22,
      "start": 8215.0,
      "end": 8217.0,
      "formatted_start": "02:16:55.000",
      "formatted_end": "02:16:57.000",
      "text": "آهانه"
    },
    {
      "id": 23,
      "start": 8217.0,
      "end": 8219.0,
      "formatted_start": "02:16:57.000",
      "formatted_end": "02:16:59.000",
      "text": "این ها تهباز دفراق شدیده"
    },
    {
      "id": 24,
      "start": 8219.0,
      "end": 8221.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:01.000",
      "text": "فقط که مست بشه"
    },
    {
      "id": 25,
      "start": 8221.0,
      "end": 8223.0,
      "formatted_start": "02:17:01.000",
      "formatted_end": "02:17:03.000",
      "text": "اگر خواستید باید"
    },
    {
      "id": 26,
      "start": 8223.0,
      "end": 8225.0,
      "formatted_start": "02:17:03.000",
      "formatted_end": "02:17:05.000",
      "text": "یک مرد آفز بگنه"
    },
    {
      "id": 27,
      "start": 8225.0,
      "end": 8227.0,
      "formatted_start": "02:17:05.000",
      "formatted_end": "02:17:07.000",
      "text": "این نمیخواد اصلا گوشت"
    },
    {
      "id": 28,
      "start": 8227.0,
      "end": 8229.0,
      "formatted_start": "02:17:07.000",
      "formatted_end": "02:17:09.000",
      "text": "خب همین کاران رو میکنه برای مستقبل"
    },
    {
      "id": 29,
      "start": 8229.0,
      "end": 8231.0,
      "formatted_start": "02:17:09.000",
      "formatted_end": "02:17:11.000",
      "text": "همه کبابی باشه"
    },
    {
      "id": 30,
      "start": 8231.0,
      "end": 8233.0,
      "formatted_start": "02:17:11.000",
      "formatted_end": "02:17:13.000",
      "text": "گوشت و فرد آفز هم نمیخواد"
    },
    {
      "id": 31,
      "start": 8233.0,
      "end": 8235.0,
      "formatted_start": "02:17:13.000",
      "formatted_end": "02:17:15.000",
      "text": "کبابی هم برای مده خیلی بده"
    },
    {
      "id": 32,
      "start": 8235.0,
      "end": 8237.0,
      "formatted_start": "02:17:15.000",
      "formatted_end": "02:17:17.000",
      "text": "این اصلا گوشت نمیخواد"
    },
    {
      "id": 33,
      "start": 8237.0,
      "end": 8239.0,
      "formatted_start": "02:17:17.000",
      "formatted_end": "02:17:19.000",
      "text": "مده دازیت میشه"
    },
    {
      "id": 34,
      "start": 8239.0,
      "end": 8241.0,
      "formatted_start": "02:17:19.000",
      "formatted_end": "02:17:21.000",
      "text": "اون برنج سپید با آفز بدمش"
    },
    {
      "id": 35,
      "start": 8241.0,
      "end": 8243.0,
      "formatted_start": "02:17:21.000",
      "formatted_end": "02:17:23.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 36,
      "start": 8243.0,
      "end": 8245.0,
      "formatted_start": "02:17:23.000",
      "formatted_end": "02:17:25.000",
      "text": "چرا؟"
    },
    {
      "id": 37,
      "start": 8245.0,
      "end": 8247.0,
      "formatted_start": "02:17:25.000",
      "formatted_end": "02:17:27.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 38,
      "start": 8247.0,
      "end": 8249.0,
      "formatted_start": "02:17:27.000",
      "formatted_end": "02:17:29.000",
      "text": "چرا؟"
    },
    {
      "id": 39,
      "start": 8249.0,
      "end": 8251.0,
      "formatted_start": "02:17:29.000",
      "formatted_end": "02:17:31.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 40,
      "start": 8251.0,
      "end": 8253.0,
      "formatted_start": "02:17:31.000",
      "formatted_end": "02:17:33.000",
      "text": "چرا؟"
    },
    {
      "id": 41,
      "start": 8253.0,
      "end": 8255.0,
      "formatted_start": "02:17:33.000",
      "formatted_end": "02:17:35.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 42,
      "start": 8255.0,
      "end": 8257.0,
      "formatted_start": "02:17:35.000",
      "formatted_end": "02:17:37.000",
      "text": "چرا؟"
    },
    {
      "id": 43,
      "start": 8257.0,
      "end": 8259.0,
      "formatted_start": "02:17:37.000",
      "formatted_end": "02:17:39.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 44,
      "start": 8259.0,
      "end": 8261.0,
      "formatted_start": "02:17:39.000",
      "formatted_end": "02:17:41.000",
      "text": "چرا؟"
    },
    {
      "id": 45,
      "start": 8261.0,
      "end": 8263.0,
      "formatted_start": "02:17:41.000",
      "formatted_end": "02:17:43.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 46,
      "start": 8263.0,
      "end": 8265.0,
      "formatted_start": "02:17:43.000",
      "formatted_end": "02:17:45.000",
      "text": "چرا؟"
    },
    {
      "id": 47,
      "start": 8265.0,
      "end": 8267.0,
      "formatted_start": "02:17:45.000",
      "formatted_end": "02:17:47.000",
      "text": "چرا؟"
    },
    {
      "id": 48,
      "start": 8267.0,
      "end": 8269.0,
      "formatted_start": "02:17:47.000",
      "formatted_end": "02:17:49.000",
      "text": "چرا؟"
    },
    {
      "id": 49,
      "start": 8269.0,
      "end": 8272.0,
      "formatted_start": "02:17:49.000",
      "formatted_end": "02:17:52.000",
      "text": "این دختر دوتا دیگه مادرن؟"
    },
    {
      "id": 50,
      "start": 8272.0,
      "end": 8274.0,
      "formatted_start": "02:17:52.000",
      "formatted_end": "02:17:54.000",
      "text": "آره دوتا دیگه"
    },
    {
      "id": 51,
      "start": 8274.0,
      "end": 8275.0,
      "formatted_start": "02:17:54.000",
      "formatted_end": "02:17:55.000",
      "text": "اونا خوبه یکداشون؟"
    },
    {
      "id": 52,
      "start": 8275.0,
      "end": 8277.0,
      "formatted_start": "02:17:55.000",
      "formatted_end": "02:17:57.000",
      "text": "اونا خوبه"
    },
    {
      "id": 53,
      "start": 8279.0,
      "end": 8281.0,
      "formatted_start": "02:17:59.000",
      "formatted_end": "02:18:01.000",
      "text": "اکنون همه و بعد ده همه"
    },
    {
      "id": 54,
      "start": 8281.0,
      "end": 8283.0,
      "formatted_start": "02:18:01.000",
      "formatted_end": "02:18:03.000",
      "text": "دیگه پشت همه؟"
    },
    {
      "id": 55,
      "start": 8283.0,
      "end": 8284.0,
      "formatted_start": "02:18:03.000",
      "formatted_end": "02:18:04.000",
      "text": "آره"
    },
    {
      "id": 56,
      "start": 8284.0,
      "end": 8285.0,
      "formatted_start": "02:18:04.000",
      "formatted_end": "02:18:05.000",
      "text": "ماشاله دیگه"
    },
    {
      "id": 57,
      "start": 8285.0,
      "end": 8287.0,
      "formatted_start": "02:18:05.000",
      "formatted_end": "02:18:07.000",
      "text": "من که بینم میگم این ها ده بودن؟"
    },
    {
      "id": 58,
      "start": 8287.0,
      "end": 8289.0,
      "formatted_start": "02:18:07.000",
      "formatted_end": "02:18:09.000",
      "text": "آره تا بچه آورده یعنی"
    },
    {
      "id": 59,
      "start": 8289.0,
      "end": 8291.0,
      "formatted_start": "02:18:09.000",
      "formatted_end": "02:18:11.000",
      "text": "بچه ها داشته بخورده"
    },
    {
      "id": 60,
      "start": 8294.0,
      "end": 8296.0,
      "formatted_start": "02:18:14.000",
      "formatted_end": "02:18:16.000",
      "text": "از خودت همه یکی نمونده؟"
    },
    {
      "id": 61,
      "start": 8296.0,
      "end": 8298.0,
      "formatted_start": "02:18:16.000",
      "formatted_end": "02:18:18.000",
      "text": "دیگه من خوش بستی خواهم مامی"
    },
    {
      "id": 62,
      "start": 8298.0,
      "end": 8300.0,
      "formatted_start": "02:18:18.000",
      "formatted_end": "02:18:20.000",
      "text": "من رو یه هم برده"
    },
    {
      "id": 63,
      "start": 8300.0,
      "end": 8302.0,
      "formatted_start": "02:18:20.000",
      "formatted_end": "02:18:22.000",
      "text": "الان خانم تو زنو خودم صدا مورد"
    },
    {
      "id": 64,
      "start": 8302.0,
      "end": 8304.0,
      "formatted_start": "02:18:22.000",
      "formatted_end": "02:18:24.000",
      "text": "خانم شیره مورم شد زنو صدا مورد"
    },
    {
      "id": 65,
      "start": 8304.0,
      "end": 8308.0,
      "formatted_start": "02:18:24.000",
      "formatted_end": "02:18:28.000",
      "text": "یه خاشو پوت سنجه درستو شیر بریز بخور"
    },
    {
      "id": 66,
      "start": 8308.0,
      "end": 8311.0,
      "formatted_start": "02:18:28.000",
      "formatted_end": "02:18:31.000",
      "text": "خورس آنها سنترون تو اینجا داری خوب"
    },
    {
      "id": 67,
      "start": 8311.0,
      "end": 8313.0,
      "formatted_start": "02:18:31.000",
      "formatted_end": "02:18:33.000",
      "text": "هر هشت ساعت بخوری باشه"
    },
    {
      "id": 68,
      "start": 8313.0,
      "end": 8314.0,
      "formatted_start": "02:18:33.000",
      "formatted_end": "02:18:34.000",
      "text": "اول بخور"
    },
    {
      "id": 69,
      "start": 8314.0,
      "end": 8316.0,
      "formatted_start": "02:18:34.000",
      "formatted_end": "02:18:36.000",
      "text": "نیم ساعت بعدش غذا بخور باشه"
    },
    {
      "id": 70,
      "start": 8316.0,
      "end": 8318.0,
      "formatted_start": "02:18:36.000",
      "formatted_end": "02:18:38.000",
      "text": "الان رفتی خونه بخور"
    },
    {
      "id": 71,
      "start": 8320.0,
      "end": 8322.0,
      "formatted_start": "02:18:40.000",
      "formatted_end": "02:18:42.000",
      "text": "صرفه داری؟"
    },
    {
      "id": 72,
      "start": 8322.0,
      "end": 8324.0,
      "formatted_start": "02:18:42.000",
      "formatted_end": "02:18:44.000",
      "text": "پس که؟"
    },
    {
      "id": 73,
      "start": 8324.0,
      "end": 8325.0,
      "formatted_start": "02:18:44.000",
      "formatted_end": "02:18:45.000",
      "text": "خودم داشته برده"
    },
    {
      "id": 74,
      "start": 8325.0,
      "end": 8326.0,
      "formatted_start": "02:18:45.000",
      "formatted_end": "02:18:46.000",
      "text": "قبلش هم داشتی؟"
    },
    {
      "id": 75,
      "start": 8326.0,
      "end": 8327.0,
      "formatted_start": "02:18:46.000",
      "formatted_end": "02:18:47.000",
      "text": "بله"
    },
    {
      "id": 76,
      "start": 8327.0,
      "end": 8329.0,
      "formatted_start": "02:18:47.000",
      "formatted_end": "02:18:49.000",
      "text": "دوستات نمی کشن؟"
    },
    {
      "id": 77,
      "start": 8329.0,
      "end": 8331.0,
      "formatted_start": "02:18:49.000",
      "formatted_end": "02:18:51.000",
      "text": "نه"
    },
    {
      "id": 78,
      "start": 8331.0,
      "end": 8333.0,
      "formatted_start": "02:18:51.000",
      "formatted_end": "02:18:53.000",
      "text": "نه؟ نه؟ نه؟"
    },
    {
      "id": 79,
      "start": 8333.0,
      "end": 8336.0,
      "formatted_start": "02:18:53.000",
      "formatted_end": "02:18:56.000",
      "text": "آره؟ دوستات می کشن؟"
    },
    {
      "id": 80,
      "start": 8336.0,
      "end": 8340.0,
      "formatted_start": "02:18:56.000",
      "formatted_end": "02:19:00.000",
      "text": "تو میری کنارشون میگن، برهم میگن، صدر میکنی"
    },
    {
      "id": 81,
      "start": 8340.0,
      "end": 8344.0,
      "formatted_start": "02:19:00.000",
      "formatted_end": "02:19:04.000",
      "text": "سیگاری نچین؟ خودت چی؟"
    },
    {
      "id": 82,
      "start": 8344.0,
      "end": 8348.0,
      "formatted_start": "02:19:04.000",
      "formatted_end": "02:19:08.000",
      "text": "اصلا نکشی، یا تو تاداشه تنهایزه؟"
    },
    {
      "id": 83,
      "start": 8348.0,
      "end": 8351.0,
      "formatted_start": "02:19:08.000",
      "formatted_end": "02:19:11.000",
      "text": "سیگاری نکشی، باید تو نقشی می کشن، تو گلیجایی دیگه"
    },
    {
      "id": 84,
      "start": 8351.0,
      "end": 8354.0,
      "formatted_start": "02:19:11.000",
      "formatted_end": "02:19:14.000",
      "text": "مریض میشی، خب موضوع خودت باش"
    },
    {
      "id": 85,
      "start": 8354.0,
      "end": 8357.0,
      "formatted_start": "02:19:14.000",
      "formatted_end": "02:19:17.000",
      "text": "موضوع برنامه از کافی درد سر داره دیگه"
    },
    {
      "id": 86,
      "start": 8357.0,
      "end": 8360.0,
      "formatted_start": "02:19:17.000",
      "formatted_end": "02:19:20.000",
      "text": "تو نمیباید درد سراتون رو زیاد کن"
    },
    {
      "id": 87,
      "start": 8360.0,
      "end": 8367.0,
      "formatted_start": "02:19:20.000",
      "formatted_end": "02:19:27.000",
      "text": "دوست داشتن با از آنها باشد. بچه ها در این وقت نیستند. ما از آنها باشیم."
    },
    {
      "id": 88,
      "start": 8367.0,
      "end": 8375.0,
      "formatted_start": "02:19:27.000",
      "formatted_end": "02:19:35.000",
      "text": "از آنها دوست داشتن باشد. یا اون وقت بختی بر بچه نیستند. سرنوشتش را عوض می کنند."
    },
    {
      "id": 89,
      "start": 8375.0,
      "end": 8384.0,
