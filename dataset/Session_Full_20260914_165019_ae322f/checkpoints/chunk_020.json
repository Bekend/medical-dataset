  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6009.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:09.000",
      "text": "بعد مکارنی، قاش، برم سبز، اینها اینجا یه صخ گردنی، یه چربوچیدی مثل جگر، یه چربوچیدی چند روز نخوند."
    },
    {
      "id": 1,
      "start": 6009.0,
      "end": 6011.0,
      "formatted_start": "01:40:09.000",
      "formatted_end": "01:40:11.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 2,
      "start": 6011.0,
      "end": 6012.0,
      "formatted_start": "01:40:11.000",
      "formatted_end": "01:40:12.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 3,
      "start": 6012.0,
      "end": 6013.0,
      "formatted_start": "01:40:12.000",
      "formatted_end": "01:40:13.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 4,
      "start": 6013.0,
      "end": 6014.0,
      "formatted_start": "01:40:13.000",
      "formatted_end": "01:40:14.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 5,
      "start": 6014.0,
      "end": 6015.0,
      "formatted_start": "01:40:14.000",
      "formatted_end": "01:40:15.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 6,
      "start": 6015.0,
      "end": 6016.0,
      "formatted_start": "01:40:15.000",
      "formatted_end": "01:40:16.000",
      "text": "بشکر پندره، نیمو پارایی."
    },
    {
      "id": 7,
      "start": 6016.0,
      "end": 6026.0,
      "formatted_start": "01:40:16.000",
      "formatted_end": "01:40:26.000",
      "text": "اگر دارید قرن دارید، این صبح خب یک کاشوک اسن داخل نصف فنجون آنبه بلند بریزید، ناشتا بخورید، خب این براتون خیلی خوبه"
    },
    {
      "id": 8,
      "start": 6026.0,
      "end": 6037.0,
      "formatted_start": "01:40:26.000",
      "formatted_end": "01:40:37.000",
      "text": "و قضاتون خیلی خوره شده اینهای مدت نزدیک هستند، تا مدتون آروم بشه، من بهتون دارون میدم، یک گرس ناشتا میخورید، یک قچه هم هست در در آنبه بشید"
    },
    {
      "id": 9,
      "start": 6037.0,
      "end": 6044.0,
      "formatted_start": "01:40:37.000",
      "formatted_end": "01:40:44.000",
      "text": "اینو بعد از غذا که احساس پولی زیاد دارید، بیس قدر از این میزید. تو هم میخورید بعد از غذا."
    },
    {
      "id": 10,
      "start": 6044.0,
      "end": 6051.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:40:51.000",
      "text": "انشاله بهتر بشید. اگر بهتر نشید، آید یه صنوع نوشتم، خودتون رو داشته باشید."
    },
    {
      "id": 11,
      "start": 6051.0,
      "end": 6058.0,
      "formatted_start": "01:40:51.000",
      "formatted_end": "01:40:58.000",
      "text": "از توی یه دوشتون داشته باشید. اگر خدا نکرده بهتر نشدید، با همین به یه صنوع گرفتی که از صفرون کهبه دنجا میدید."
    },
    {
      "id": 12,
      "start": 6058.0,
      "end": 6061.0,
      "formatted_start": "01:40:58.000",
      "formatted_end": "01:41:01.000",
      "text": "اما بعد از چند بشه؟ بعد از دو؟"
    },
    {
      "id": 13,
      "start": 6061.0,
      "end": 6063.0,
      "formatted_start": "01:41:01.000",
      "formatted_end": "01:41:03.000",
      "text": "یه هفته معیز بهتر بشه دیگه"
    },
    {
      "id": 14,
      "start": 6063.0,
      "end": 6065.0,
      "formatted_start": "01:41:03.000",
      "formatted_end": "01:41:05.000",
      "text": "یه هفته بهتر"
    },
    {
      "id": 15,
      "start": 6065.0,
      "end": 6067.0,
      "formatted_start": "01:41:05.000",
      "formatted_end": "01:41:07.000",
      "text": "میده زمان بیور"
    },
    {
      "id": 16,
      "start": 6067.0,
      "end": 6069.0,
      "formatted_start": "01:41:07.000",
      "formatted_end": "01:41:09.000",
      "text": "یه هفته اینجا اینجا اینجا اینجا"
    },
    {
      "id": 17,
      "start": 6069.0,
      "end": 6071.0,
      "formatted_start": "01:41:09.000",
      "formatted_end": "01:41:11.000",
      "text": "اینجا اینجا اینجا"
    },
    {
      "id": 18,
      "start": 6071.0,
      "end": 6073.0,
      "formatted_start": "01:41:11.000",
      "formatted_end": "01:41:13.000",
      "text": "اینجا اینجا"
    },
    {
      "id": 19,
      "start": 6073.0,
      "end": 6075.0,
      "formatted_start": "01:41:13.000",
      "formatted_end": "01:41:15.000",
      "text": "اینجا"
    },
    {
      "id": 20,
      "start": 6075.0,
      "end": 6079.0,
      "formatted_start": "01:41:15.000",
      "formatted_end": "01:41:19.000",
      "text": "اگه سه چهار روز خورس ناشته رو خوردی مادر دیدی بهتری"
    },
    {
      "id": 21,
      "start": 6079.0,
      "end": 6081.0,
      "formatted_start": "01:41:19.000",
      "formatted_end": "01:41:21.000",
      "text": "ولی کامل خود نشدی"
    },
    {
      "id": 22,
      "start": 6081.0,
      "end": 6083.0,
      "formatted_start": "01:41:21.000",
      "formatted_end": "01:41:23.000",
      "text": "ناشته رو تا هم قبل از صبحانه بخور"
    },
    {
      "id": 23,
      "start": 6083.0,
      "end": 6085.0,
      "formatted_start": "01:41:23.000",
      "formatted_end": "01:41:25.000",
      "text": "هم قبل از شام"
    },
    {
      "id": 24,
      "start": 6085.0,
      "end": 6087.0,
      "formatted_start": "01:41:25.000",
      "formatted_end": "01:41:27.000",
      "text": "فعلا فقط دوستی یه بار بخوری"
    },
    {
      "id": 25,
      "start": 6087.0,
      "end": 6089.0,
      "formatted_start": "01:41:27.000",
      "formatted_end": "01:41:29.000",
      "text": "یه بار بخوری"
    },
    {
      "id": 26,
      "start": 6089.0,
      "end": 6097.0,
      "formatted_start": "01:41:29.000",
      "formatted_end": "01:41:37.000",
      "text": "اگر بیشتر بخورید، اگر بیشتر میشید، اگر خدای نکرده بهتر نشود، میرسونی آب بتونن"
    },
    {
      "id": 27,
      "start": 6097.0,
      "end": 6099.0,
      "formatted_start": "01:41:37.000",
      "formatted_end": "01:41:39.000",
      "text": "فطرتون چقدر آب باشه؟"
    },
    {
      "id": 28,
      "start": 6099.0,
      "end": 6101.0,
      "formatted_start": "01:41:39.000",
      "formatted_end": "01:41:41.000",
      "text": "توی نصف فهنجونه"
    },
    {
      "id": 29,
      "start": 6101.0,
      "end": 6105.0,
      "formatted_start": "01:41:41.000",
      "formatted_end": "01:41:45.000",
      "text": "چون کلند یک سال بعد ماریات برده غذایشون بخورند، تا یک سال بعد غذا نباید ماریات بخورند"
    },
    {
      "id": 30,
      "start": 6105.0,
      "end": 6107.0,
      "formatted_start": "01:41:45.000",
      "formatted_end": "01:41:47.000",
      "text": "خیلی ممنونم، سلامت کرده"
    },
    {
      "id": 31,
      "start": 6107.0,
      "end": 6109.0,
      "formatted_start": "01:41:47.000",
      "formatted_end": "01:41:49.000",
      "text": "برده نماز شده"
    },
    {
      "id": 32,
      "start": 6109.0,
      "end": 6111.0,
      "formatted_start": "01:41:49.000",
      "formatted_end": "01:41:51.000",
      "text": "سلامت کرده"
    },
    {
      "id": 33,
      "start": 6111.0,
      "end": 6113.0,
      "formatted_start": "01:41:51.000",
      "formatted_end": "01:41:53.000",
      "text": "برده نماز شده"
    },
    {
      "id": 34,
      "start": 6113.0,
      "end": 6115.0,
      "formatted_start": "01:41:53.000",
      "formatted_end": "01:41:55.000",
      "text": "برده نماز شده"
    },
    {
      "id": 35,
      "start": 6115.0,
      "end": 6117.0,
      "formatted_start": "01:41:55.000",
      "formatted_end": "01:41:57.000",
      "text": "برده نماز شده"
    },
    {
      "id": 36,
      "start": 6117.0,
      "end": 6121.0,
      "formatted_start": "01:41:57.000",
      "formatted_end": "01:42:01.000",
      "text": "اما این تیروید رو دادم که مستری باید آمده بودی"
    },
    {
      "id": 37,
      "start": 6121.0,
      "end": 6123.0,
      "formatted_start": "01:42:01.000",
      "formatted_end": "01:42:03.000",
      "text": "این تیروید رو رفت شده بود"
    },
    {
      "id": 38,
      "start": 6123.0,
      "end": 6127.0,
      "formatted_start": "01:42:03.000",
      "formatted_end": "01:42:07.000",
      "text": "یک بار بعد از همه ماه توی این سن اول از این همه سال اومدیم پیش خودتون"
    },
    {
      "id": 39,
      "start": 6127.0,
      "end": 6129.0,
      "formatted_start": "01:42:07.000",
      "formatted_end": "01:42:09.000",
      "text": "اون تیروید نشون داد"
    },
    {
      "id": 40,
      "start": 6129.0,
      "end": 6131.0,
      "formatted_start": "01:42:09.000",
      "formatted_end": "01:42:11.000",
      "text": "تو چه کاب بردیش دیگه اوکی شد"
    },
    {
      "id": 41,
