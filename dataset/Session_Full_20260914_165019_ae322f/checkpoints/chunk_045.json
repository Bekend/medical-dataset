  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13505.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:05.000",
      "text": "بسیار بیادبی هم از باب بخشید کنجه هر موی نسل آمدید."
    },
    {
      "id": 1,
      "start": 13512.0,
      "end": 13523.0,
      "formatted_start": "03:45:12.000",
      "formatted_end": "03:45:23.000",
      "text": "بعدا بیام که مهمبر و نامرم بزنم که یک معرضی جوزگیر هم دارم."
    },
    {
      "id": 2,
      "start": 13523.0,
      "end": 13525.0,
      "formatted_start": "03:45:23.000",
      "formatted_end": "03:45:25.000",
      "text": "بفهمم"
    },
    {
      "id": 3,
      "start": 13525.0,
      "end": 13527.0,
      "formatted_start": "03:45:25.000",
      "formatted_end": "03:45:27.000",
      "text": "اونو بعدا دیام دیگه"
    },
    {
      "id": 4,
      "start": 13527.0,
      "end": 13529.0,
      "formatted_start": "03:45:27.000",
      "formatted_end": "03:45:29.000",
      "text": "چیز خدمتش منسته که"
    },
    {
      "id": 5,
      "start": 13533.0,
      "end": 13535.0,
      "formatted_start": "03:45:33.000",
      "formatted_end": "03:45:35.000",
      "text": "یه سری"
    },
    {
      "id": 6,
      "start": 13535.0,
      "end": 13537.0,
      "formatted_start": "03:45:35.000",
      "formatted_end": "03:45:37.000",
      "text": "خدمتش منسته مغد ما"
    },
    {
      "id": 7,
      "start": 13537.0,
      "end": 13539.0,
      "formatted_start": "03:45:37.000",
      "formatted_end": "03:45:39.000",
      "text": "یک خورده همچین مثل"
    },
    {
      "id": 8,
      "start": 13539.0,
      "end": 13541.0,
      "formatted_start": "03:45:39.000",
      "formatted_end": "03:45:41.000",
      "text": "خیلی من از من مثل نخودمانند"
    },
    {
      "id": 9,
      "start": 13543.0,
      "end": 13545.0,
      "formatted_start": "03:45:43.000",
      "formatted_end": "03:45:45.000",
      "text": "خب اون رفتار دیگه شیاختن بود"
    },
    {
      "id": 10,
      "start": 13545.0,
      "end": 13547.0,
      "formatted_start": "03:45:45.000",
      "formatted_end": "03:45:47.000",
      "text": "نه"
    },
    {
      "id": 11,
      "start": 13547.0,
      "end": 13549.0,
      "formatted_start": "03:45:47.000",
      "formatted_end": "03:45:49.000",
      "text": "چقدر سایزش که بیرونه بود؟"
    },
    {
      "id": 12,
      "start": 13549.0,
      "end": 13551.0,
      "formatted_start": "03:45:49.000",
      "formatted_end": "03:45:51.000",
      "text": "سایزش"
    },
    {
      "id": 13,
      "start": 13551.0,
      "end": 13553.0,
      "formatted_start": "03:45:51.000",
      "formatted_end": "03:45:53.000",
      "text": "اما این همون نمیتونه بیتو باید جیجی نمیتونه هست دیگه"
    },
    {
      "id": 14,
      "start": 13553.0,
      "end": 13555.0,
      "formatted_start": "03:45:53.000",
      "formatted_end": "03:45:55.000",
      "text": "یعنی مثلا بندازه یه نخود"
    },
    {
      "id": 15,
      "start": 13555.0,
      "end": 13556.0,
      "formatted_start": "03:45:55.000",
      "formatted_end": "03:45:56.000",
      "text": "آره آره آره"
    },
    {
      "id": 16,
      "start": 13556.0,
      "end": 13558.0,
      "formatted_start": "03:45:56.000",
      "formatted_end": "03:45:58.000",
      "text": "یه نخود رو عمل نمیکنن خب"
    },
    {
      "id": 17,
      "start": 13558.0,
      "end": 13562.0,
      "formatted_start": "03:45:58.000",
      "formatted_end": "03:46:02.000",
      "text": "اول که میریم همون تو لگن آبگرم بشینین در کنی بپس"
    },
    {
      "id": 18,
      "start": 13562.0,
      "end": 13564.0,
      "formatted_start": "03:46:02.000",
      "formatted_end": "03:46:04.000",
      "text": "یه جله باید تو میدون یخچالیه"
    },
    {
      "id": 19,
      "start": 13564.0,
      "end": 13565.0,
      "formatted_start": "03:46:04.000",
      "formatted_end": "03:46:05.000",
      "text": "آهان"
    },
    {
      "id": 20,
      "start": 13565.0,
      "end": 13567.0,
      "formatted_start": "03:46:05.000",
      "formatted_end": "03:46:07.000",
      "text": "اون جله یخچالی رو"
    },
    {
      "id": 21,
      "start": 13567.0,
      "end": 13569.0,
      "formatted_start": "03:46:07.000",
      "formatted_end": "03:46:09.000",
      "text": "هر اج سطح میزنی تو یخچالی هر اج سطح بزنی"
    },
    {
      "id": 22,
      "start": 13569.0,
      "end": 13571.0,
      "formatted_start": "03:46:09.000",
      "formatted_end": "03:46:11.000",
      "text": "یه فماد هم هست میدونی"
    },
    {
      "id": 23,
      "start": 13571.0,
      "end": 13573.0,
      "formatted_start": "03:46:11.000",
      "formatted_end": "03:46:13.000",
      "text": "یه ذره کوچکش میکنه"
    },
    {
      "id": 24,
      "start": 13573.0,
      "end": 13575.0,
      "formatted_start": "03:46:13.000",
      "formatted_end": "03:46:15.000",
      "text": "اوه نه می کنه، اما کجایی تن می کنه"
    },
    {
      "id": 25,
      "start": 13603.0,
      "end": 13609.0,
      "formatted_start": "03:46:43.000",
      "formatted_end": "03:46:49.000",
      "text": "اداله ۱۲، ارگان"
    },
    {
      "id": 26,
      "start": 13609.0,
      "end": 13615.0,
      "formatted_start": "03:46:49.000",
      "formatted_end": "03:46:55.000",
      "text": "این فقط فرصدی برمی کنند، کل انترنت روی ایجان فقط بیمارستان فرصدی کنند"
    },
    {
      "id": 27,
      "start": 13615.0,
      "end": 13619.0,
      "formatted_start": "03:46:55.000",
      "formatted_end": "03:46:59.000",
      "text": "چه بقیه؟ بقیه تودار خوبه"
    },
    {
      "id": 28,
      "start": 13619.0,
      "end": 13623.0,
      "formatted_start": "03:46:59.000",
      "formatted_end": "03:47:03.000",
      "text": "بقیه تودار خوب، بقیه تودار من بقیه از..."
    },
    {
      "id": 29,
      "start": 13623.0,
      "end": 13626.0,
      "formatted_start": "03:47:03.000",
      "formatted_end": "03:47:06.000",
      "text": "بقیه تودار مالتی نیست"
    },
    {
      "id": 30,
      "start": 13626.0,
      "end": 13628.0,
      "formatted_start": "03:47:06.000",
      "formatted_end": "03:47:08.000",
      "text": "این وقعیت ها خیلی خوب نیست"
    },
    {
      "id": 31,
      "start": 13628.0,
      "end": 13632.0,
      "formatted_start": "03:47:08.000",
      "formatted_end": "03:47:12.000",
      "text": "این این رونه فراجای"
    },
    {
      "id": 32,
      "start": 13632.0,
      "end": 13634.0,
      "formatted_start": "03:47:12.000",
      "formatted_end": "03:47:14.000",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 13634.0,
      "end": 13636.0,
      "formatted_start": "03:47:14.000",
      "formatted_end": "03:47:16.000",
      "text": "آره اصلا همونطوری همون فراجای"
    },
    {
      "id": 34,
      "start": 13636.0,
      "end": 13638.0,
      "formatted_start": "03:47:16.000",
      "formatted_end": "03:47:18.000",
      "text": "فراجای اص بکتر"
    },
    {
      "id": 35,
      "start": 13638.0,
      "end": 13640.0,
      "formatted_start": "03:47:18.000",
      "formatted_end": "03:47:20.000",
      "text": "این شروع خود رو جایی بدم اینو"
    },
    {
      "id": 36,
      "start": 13640.0,
      "end": 13646.0,
      "formatted_start": "03:47:20.000",
      "formatted_end": "03:47:26.000",
      "text": "اگه خونه تهران داری اونجا بریم"
    },
    {
      "id": 37,
      "start": 13646.0,
      "end": 13648.0,
      "formatted_start": "03:47:26.000",
      "formatted_end": "03:47:28.000",
      "text": "اینطوری همونطوری همونطوری بریم"
    },
    {
      "id": 38,
      "start": 13648.0,
      "end": 13650.0,
      "formatted_start": "03:47:28.000",
      "formatted_end": "03:47:30.000",
      "text": "فراجایی کلیه ببینیم اون خانه ببینم"
    },
    {
      "id": 39,
      "start": 13650.0,
      "end": 13652.0,
      "formatted_start": "03:47:30.000",
      "formatted_end": "03:47:32.000",
      "text": "خود رو سپرد"
    },
    {
      "id": 40,
      "start": 13652.0,
      "end": 13654.0,
      "formatted_start": "03:47:32.000",
      "formatted_end": "03:47:34.000",
      "text": "خواهی نمان"
    },
    {
      "id": 41,
      "start": 13654.0,
      "end": 13656.0,
      "formatted_start": "03:47:34.000",
      "formatted_end": "03:47:36.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 42,
      "start": 13656.0,
      "end": 13658.0,
      "formatted_start": "03:47:36.000",
      "formatted_end": "03:47:38.000",
      "text": "در این جرائه هایی هستند."
    },
    {
      "id": 43,
      "start": 13658.0,
      "end": 13660.0,
      "formatted_start": "03:47:38.000",
      "formatted_end": "03:47:40.000",
      "text": "در این جرائه هایی هستند."
    },
    {
      "id": 44,
      "start": 13660.0,
      "end": 13662.0,
      "formatted_start": "03:47:40.000",
      "formatted_end": "03:47:42.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 45,
      "start": 13662.0,
      "end": 13664.0,
      "formatted_start": "03:47:42.000",
      "formatted_end": "03:47:44.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 46,
      "start": 13664.0,
      "end": 13666.0,
      "formatted_start": "03:47:44.000",
      "formatted_end": "03:47:46.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 47,
      "start": 13666.0,
      "end": 13668.0,
      "formatted_start": "03:47:46.000",
      "formatted_end": "03:47:48.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 48,
      "start": 13668.0,
      "end": 13670.0,
      "formatted_start": "03:47:48.000",
      "formatted_end": "03:47:50.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 49,
      "start": 13670.0,
      "end": 13672.0,
      "formatted_start": "03:47:50.000",
      "formatted_end": "03:47:52.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 50,
      "start": 13672.0,
      "end": 13674.0,
      "formatted_start": "03:47:52.000",
      "formatted_end": "03:47:54.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 51,
      "start": 13674.0,
      "end": 13676.0,
      "formatted_start": "03:47:54.000",
      "formatted_end": "03:47:56.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 52,
      "start": 13676.0,
      "end": 13678.0,
      "formatted_start": "03:47:56.000",
      "formatted_end": "03:47:58.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 53,
      "start": 13678.0,
      "end": 13680.0,
      "formatted_start": "03:47:58.000",
      "formatted_end": "03:48:00.000",
      "text": "این جرائه هایی هستند."
    },
    {
      "id": 54,
      "start": 13680.0,
      "end": 13682.0,
      "formatted_start": "03:48:00.000",
      "formatted_end": "03:48:02.000",
      "text": "سلام"
    },
    {
      "id": 55,
      "start": 13682.0,
      "end": 13694.0,
      "formatted_start": "03:48:02.000",
      "formatted_end": "03:48:14.000",
      "text": "سلام"
    },
    {
      "id": 56,
      "start": 13694.0,
      "end": 13695.06,
      "formatted_start": "03:48:14.000",
      "formatted_end": "03:48:15.060",
      "text": "سلام"
    },
    {
      "id": 57,
      "start": 13695.06,
      "end": 13698.9,
      "formatted_start": "03:48:15.060",
      "formatted_end": "03:48:18.900",
      "text": "سلام"
    },
    {
      "id": 58,
      "start": 13710.0,
      "end": 13738.0,
      "formatted_start": "03:48:30.000",
      "formatted_end": "03:48:58.000",
      "text": "موسیقی"
    },
    {
      "id": 59,
      "start": 13738.0,
      "end": 13740.0,
      "formatted_start": "03:48:58.000",
      "formatted_end": "03:49:00.000",
      "text": "جا؟"
    },
    {
      "id": 60,
      "start": 13740.0,
      "end": 13742.0,
      "formatted_start": "03:49:00.000",
      "formatted_end": "03:49:02.000",
      "text": "بس مایشو برم"
    },
    {
      "id": 61,
      "start": 13742.0,
      "end": 13744.0,
      "formatted_start": "03:49:02.000",
      "formatted_end": "03:49:04.000",
      "text": "قندت بود؟ قرص میخوری؟"
    },
    {
      "id": 62,
      "start": 13744.0,
      "end": 13746.0,
      "formatted_start": "03:49:04.000",
      "formatted_end": "03:49:06.000",
      "text": "کهان نه"
    },
    {
      "id": 63,
      "start": 13746.0,
      "end": 13748.0,
      "formatted_start": "03:49:06.000",
      "formatted_end": "03:49:08.000",
      "text": "تا حالا قرص قرص نخورده؟ نه نه"
    },
    {
      "id": 64,
      "start": 13748.0,
      "end": 13750.0,
      "formatted_start": "03:49:08.000",
      "formatted_end": "03:49:10.000",
      "text": "بالا رفته؟ بالا رفته؟"
    },
    {
      "id": 65,
      "start": 13750.0,
      "end": 13752.0,
      "formatted_start": "03:49:10.000",
      "formatted_end": "03:49:12.000",
      "text": "ترکندی ها چونم"
    },
    {
      "id": 66,
      "start": 13752.0,
      "end": 13754.0,
      "formatted_start": "03:49:12.000",
      "formatted_end": "03:49:14.000",
      "text": "قندت خیلی بالا"
    },
    {
      "id": 67,
      "start": 13754.0,
      "end": 13756.0,
      "formatted_start": "03:49:14.000",
      "formatted_end": "03:49:16.000",
      "text": "قند بالا"
    },
    {
      "id": 68,
      "start": 13756.0,
      "end": 13758.0,
      "formatted_start": "03:49:16.000",
      "formatted_end": "03:49:18.000",
      "text": "از اون فاجه تر چربیه"
    },
    {
      "id": 69,
      "start": 13758.0,
      "end": 13760.0,
      "formatted_start": "03:49:18.000",
      "formatted_end": "03:49:20.000",
      "text": "خیلی بالا"
    },
    {
      "id": 70,
      "start": 13760.0,
      "end": 13762.0,
      "formatted_start": "03:49:20.000",
      "formatted_end": "03:49:22.000",
      "text": "چربی منو بالا یعنی"
    },
    {
      "id": 71,
      "start": 13762.0,
      "end": 13764.0,
      "formatted_start": "03:49:22.000",
      "formatted_end": "03:49:24.000",
      "text": "600 رو خورده یه"
    },
    {
      "id": 72,
      "start": 13764.0,
      "end": 13766.0,
      "formatted_start": "03:49:24.000",
      "formatted_end": "03:49:26.000",
      "text": "پولیت ورم کرده"
    },
    {
      "id": 73,
      "start": 13766.0,
      "end": 13768.0,
      "formatted_start": "03:49:26.000",
      "formatted_end": "03:49:28.000",
      "text": "از اینجا باید شکر کنید که خدا خوبه"
    },
    {
      "id": 74,
      "start": 13768.0,
      "end": 13770.0,
      "formatted_start": "03:49:28.000",
      "formatted_end": "03:49:30.000",
      "text": "خونه نداری"
    },
    {
      "id": 75,
      "start": 13770.0,
      "end": 13772.0,
      "formatted_start": "03:49:30.000",
      "formatted_end": "03:49:32.000",
      "text": "تیروید خوبه"
    },
    {
      "id": 76,
      "start": 13772.0,
      "end": 13774.0,
      "formatted_start": "03:49:32.000",
      "formatted_end": "03:49:34.000",
      "text": "خوص تیروید می کنید؟"
    },
    {
      "id": 77,
      "start": 13774.0,
      "end": 13776.0,
      "formatted_start": "03:49:34.000",
      "formatted_end": "03:49:36.000",
      "text": "نه"
    },
    {
      "id": 78,
      "start": 13776.0,
      "end": 13778.0,
      "formatted_start": "03:49:36.000",
      "formatted_end": "03:49:38.000",
      "text": "کلم که ها تراب تراب چل"
    },
    {
      "id": 79,
      "start": 13778.0,
      "end": 13780.0,
      "formatted_start": "03:49:38.000",
      "formatted_end": "03:49:40.000",
      "text": "سویا شمپن نخواهید"
    },
    {
      "id": 80,
      "start": 13780.0,
      "end": 13782.0,
      "formatted_start": "03:49:40.000",
      "formatted_end": "03:49:42.000",
      "text": "چون تیروید داره میلون کم کاری"
    },
    {
      "id": 81,
      "start": 13782.0,
      "end": 13784.0,
      "formatted_start": "03:49:42.000",
      "formatted_end": "03:49:44.000",
      "text": "چرا نداری؟"
    },
    {
      "id": 82,
      "start": 13784.0,
      "end": 13786.0,
      "formatted_start": "03:49:44.000",
      "formatted_end": "03:49:46.000",
      "text": "چرمی ها فیلو مالایی"
    },
    {
      "id": 83,
      "start": 13786.0,
      "end": 13788.0,
      "formatted_start": "03:49:46.000",
      "formatted_end": "03:49:48.000",
      "text": "خیلی بالا"
    },
    {
      "id": 84,
      "start": 13788.0,
      "end": 13790.0,
      "formatted_start": "03:49:48.000",
      "formatted_end": "03:49:50.000",
      "text": "بیدار میشی نسخا"
    },
    {
      "id": 85,
      "start": 13790.0,
      "end": 13792.0,
      "formatted_start": "03:49:50.000",
      "formatted_end": "03:49:52.000",
      "text": "جان آره بیدارم"
    },
    {
      "id": 86,
      "start": 13792.0,
      "end": 13794.0,
      "formatted_start": "03:49:52.000",
      "formatted_end": "03:49:54.000",
      "text": "چون اصلا باید چوی نباید بیدار باشی"
    },
    {
      "id": 87,
      "start": 13794.0,
      "end": 13801.68,
      "formatted_start": "03:49:54.000",
      "formatted_end": "03:50:01.680",
      "text": "بخورم. اما یک شام بدنم سنگینی میکنه. آه اما"
    }
  ],
  "status": "completed"
}