    {
      "start": 14086.366,
      "end": 14086.805,
      "formatted_start": "03:54:46.366",
      "formatted_end": "03:54:46.805",
      "speaker": "SPEAKER_02"
    },
    {
      "start": 14098.972,
      "end": 14099.967,
      "formatted_start": "03:54:58.972",
      "formatted_end": "03:54:59.967",
      "speaker": "SPEAKER_02"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13811.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:11.000",
      "text": "گرسه من دویان، کم کردم نم کردم، مال شرمین. یا بر آمده آزمایش دادم که کمی، دیگه شرمینم زیاد میکردم."
    },
    {
      "id": 1,
      "start": 13814.0,
      "end": 13820.0,
      "formatted_start": "03:50:14.000",
      "formatted_end": "03:50:20.000",
      "text": "نه باید بخوری عزیز، خیلی خطرناکه برم من. گرسه قند امروز یه دونه باید بخوری خب؟"
    },
    {
      "id": 2,
      "start": 13820.0,
      "end": 13822.0,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:22.000",
      "text": "گرسه ایرانی بهت میساخت."
    },
    {
      "id": 3,
      "start": 13822.0,
      "end": 13823.0,
      "formatted_start": "03:50:22.000",
      "formatted_end": "03:50:23.000",
      "text": "چا؟"
    },
    {
      "id": 4,
      "start": 13823.0,
      "end": 13825.0,
      "formatted_start": "03:50:23.000",
      "formatted_end": "03:50:25.000",
      "text": "گرسه قند ایرانی بهتو میساخت."
    },
    {
      "id": 5,
      "start": 13825.0,
      "end": 13827.0,
      "formatted_start": "03:50:25.000",
      "formatted_end": "03:50:27.000",
      "text": "نه منش نفرده، وصله."
    },
    {
      "id": 6,
      "start": 13827.0,
      "end": 13830.8,
      "formatted_start": "03:50:27.000",
      "formatted_end": "03:50:30.800",
      "text": "من یک بار ایرانی میرسم و اگه نصفت که باید خارجی میرسم"
    },
    {
      "id": 7,
      "start": 13830.8,
      "end": 13832.8,
      "formatted_start": "03:50:30.800",
      "formatted_end": "03:50:32.800",
      "text": "چون خارجی بیمه نمیخوره"
    },
    {
      "id": 8,
      "start": 13832.8,
      "end": 13837.8,
      "formatted_start": "03:50:32.800",
      "formatted_end": "03:50:37.800",
      "text": "ای باید از دست شما"
    },
    {
      "id": 9,
      "start": 13837.8,
      "end": 13842.8,
      "formatted_start": "03:50:37.800",
      "formatted_end": "03:50:42.800",
      "text": "الان حاجه کنه قرن چرچی میگیده و مال من رو بگید و میگید که حتی نرماله"
    },
    {
      "id": 10,
      "start": 13842.8,
      "end": 13845.8,
      "formatted_start": "03:50:42.800",
      "formatted_end": "03:50:45.800",
      "text": "آزمایش مردم شده"
    },
    {
      "id": 11,
      "start": 13845.8,
      "end": 13847.8,
      "formatted_start": "03:50:45.800",
      "formatted_end": "03:50:47.800",
      "text": "آره آزمایشم مردم شده"
    },
    {
      "id": 12,
      "start": 13847.8,
      "end": 13851.8,
      "formatted_start": "03:50:47.800",
      "formatted_end": "03:50:51.800",
      "text": "این رو زیاد بخرم"
    },
    {
      "id": 13,
      "start": 13851.8,
      "end": 13856.8,
      "formatted_start": "03:50:51.800",
      "formatted_end": "03:50:56.800",
      "text": "میشابه دلستر، نون، هندونه، خربازه، انگور، موز"
    },
    {
      "id": 14,
      "start": 13856.8,
      "end": 13858.8,
      "formatted_start": "03:50:56.800",
      "formatted_end": "03:50:58.800",
      "text": "اوه، پنج بابر بالا"
    },
    {
      "id": 15,
      "start": 13866.8,
      "end": 13869.8,
      "formatted_start": "03:51:06.800",
      "formatted_end": "03:51:09.800",
      "text": "پرست چند مینابراون بزیر"
    },
    {
      "id": 16,
      "start": 13869.8,
      "end": 13873.8,
      "formatted_start": "03:51:09.800",
      "formatted_end": "03:51:13.800",
      "text": "یه اینکه پرست خواست بگم کهی بخواد شبهای بلدون بگه خب؟"
    },
    {
      "id": 17,
      "start": 13873.8,
      "end": 13874.8,
      "formatted_start": "03:51:13.800",
      "formatted_end": "03:51:14.800",
      "text": "اوه، که میزین"
    },
    {
      "id": 18,
      "start": 13874.8,
      "end": 13875.8,
      "formatted_start": "03:51:14.800",
      "formatted_end": "03:51:15.800",
      "text": "داریدیم؟"
    },
    {
      "id": 19,
      "start": 13875.8,
      "end": 13877.8,
      "formatted_start": "03:51:15.800",
      "formatted_end": "03:51:17.800",
      "text": "از اینو، امنا مالا شاید بزیر"
    },
    {
      "id": 20,
      "start": 13877.8,
      "end": 13878.8,
      "formatted_start": "03:51:17.800",
      "formatted_end": "03:51:18.800",
      "text": "از این روز چقدر میخوری؟"
    },
    {
      "id": 21,
      "start": 13878.8,
      "end": 13880.8,
      "formatted_start": "03:51:18.800",
      "formatted_end": "03:51:20.800",
      "text": "امنا فقط شبیه کهی"
    },
    {
      "id": 22,
      "start": 13880.8,
      "end": 13883.46,
      "formatted_start": "03:51:20.800",
      "formatted_end": "03:51:23.460",
      "text": "نه نصف گو مادر زربان قلبتو خیلی انداخته"
    },
    {
      "id": 23,
      "start": 13883.46,
      "end": 13885.08,
      "formatted_start": "03:51:23.460",
      "formatted_end": "03:51:25.080",
      "text": "نه این نصف مکرم"
    },
    {
      "id": 24,
      "start": 13885.08,
      "end": 13886.38,
      "formatted_start": "03:51:25.080",
      "formatted_end": "03:51:26.380",
      "text": "شب نصف میخوری؟"
    },
    {
      "id": 25,
      "start": 13886.38,
      "end": 13886.68,
      "formatted_start": "03:51:26.380",
      "formatted_end": "03:51:26.680",
      "text": "آره"
    },
    {
      "id": 26,
      "start": 13886.68,
      "end": 13888.5,
      "formatted_start": "03:51:26.680",
      "formatted_end": "03:51:28.500",
      "text": "خب پس یک چارم باید بخوری"
    },
    {
      "id": 27,
      "start": 13888.5,
      "end": 13889.16,
      "formatted_start": "03:51:28.500",
      "formatted_end": "03:51:29.160",
      "text": "آره"
    },
    {
      "id": 28,
      "start": 13889.16,
      "end": 13891.58,
      "formatted_start": "03:51:29.160",
      "formatted_end": "03:51:31.580",
      "text": "خیلی انداخته زربان قلبتونو خانی"
    },
    {
      "id": 29,
      "start": 13891.58,
      "end": 13892.04,
      "formatted_start": "03:51:31.580",
      "formatted_end": "03:51:32.040",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 13892.04,
      "end": 13895.14,
      "formatted_start": "03:51:32.040",
      "formatted_end": "03:51:35.140",
      "text": "آورده خیلی پایین باز بیخالت از اونی که بوده کرده"
    },
    {
      "id": 31,
      "start": 13895.14,
      "end": 13898.32,
      "formatted_start": "03:51:35.140",
      "formatted_end": "03:51:38.320",
      "text": "په این نمیسازه منو نه؟"
    },
    {
      "id": 32,
      "start": 13898.32,
      "end": 13899.22,
      "formatted_start": "03:51:38.320",
      "formatted_end": "03:51:39.220",
      "text": "آره نمیسازه"
    },
    {
      "id": 33,
      "start": 13899.22,
      "end": 13899.94,
      "formatted_start": "03:51:39.220",
      "formatted_end": "03:51:39.940",
      "text": "پس نخورم"
    },
    {
      "id": 34,
      "start": 13899.94,
      "end": 13902.34,
      "formatted_start": "03:51:39.940",
      "formatted_end": "03:51:42.340",
      "text": "یک چارم بخوری نه نمیشه یه دفعه قد کنی"
    },
    {
      "id": 35,
      "start": 13902.34,
      "end": 13903.84,
      "formatted_start": "03:51:42.340",
      "formatted_end": "03:51:43.840",
      "text": "خب دوستای سری قد کنی"
    },
    {
      "id": 36,
      "start": 13903.84,
      "end": 13904.84,
      "formatted_start": "03:51:43.840",
      "formatted_end": "03:51:44.840",
      "text": "آه"
    },
    {
      "id": 37,
      "start": 13904.84,
      "end": 13907.08,
      "formatted_start": "03:51:44.840",
      "formatted_end": "03:51:47.080",
      "text": "دوست دای سریع خورسات رو خرید کنی"
    },
    {
      "id": 38,
      "start": 13908.08,
      "end": 13909.52,
      "formatted_start": "03:51:48.080",
      "formatted_end": "03:51:49.520",
      "text": "یه چهارم بکنم"
    },
    {
      "id": 39,
      "start": 13909.52,
      "end": 13910.52,
      "formatted_start": "03:51:49.520",
      "formatted_end": "03:51:50.520",
      "text": "آره"
    },
    {
      "id": 40,
      "start": 13911.32,
      "end": 13913.04,
      "formatted_start": "03:51:51.320",
      "formatted_end": "03:51:53.040",
      "text": "سه محتارو تو نمی‌باشیم"
    },
    {
      "id": 41,
      "start": 13913.04,
      "end": 13913.52,
      "formatted_start": "03:51:53.040",
      "formatted_end": "03:51:53.520",
      "text": "خوب؟"
    },
    {
      "id": 42,
      "start": 13913.52,
      "end": 13914.8,
      "formatted_start": "03:51:53.520",
      "formatted_end": "03:51:54.800",
      "text": "دست در کنه که نه"
    },
    {
      "id": 43,
      "start": 13914.8,
      "end": 13916.04,
      "formatted_start": "03:51:54.800",
      "formatted_end": "03:51:56.040",
      "text": "سلامتی شیف"
    },
    {
      "id": 44,
      "start": 13917.04,
      "end": 13918.08,
      "formatted_start": "03:51:57.040",
      "formatted_end": "03:51:58.080",
      "text": "خیلی رایت"
    },
    {
      "id": 45,
      "start": 13918.08,
      "end": 13918.84,
      "formatted_start": "03:51:58.080",
      "formatted_end": "03:51:58.840",
      "text": "خاندو تیم"
    },
    {
      "id": 46,
      "start": 13918.84,
      "end": 13920.08,
      "formatted_start": "03:51:58.840",
      "formatted_end": "03:52:00.080",
      "text": "حلیمه‌ی محلولی"
    },
    {
      "id": 47,
      "start": 13920.08,
      "end": 13921.12,
      "formatted_start": "03:52:00.080",
      "formatted_end": "03:52:01.120",
      "text": "خاندو تیم"
    },
    {
      "id": 48,
      "start": 13921.12,
      "end": 13921.92,
      "formatted_start": "03:52:01.120",
      "formatted_end": "03:52:01.920",
      "text": "خاندو تیم مریض"
    },
    {
      "id": 49,
      "start": 13921.92,
      "end": 13925.08,
      "formatted_start": "03:52:01.920",
      "formatted_end": "03:52:05.080",
      "text": "دیگرش می‌شه دارو کنی این دایشتا دیگری رو ببین"
    },
    {
      "id": 50,
      "start": 13925.08,
      "end": 13927.08,
      "formatted_start": "03:52:05.080",
      "formatted_end": "03:52:07.080",
      "text": "این آکر"
    },
    {
      "id": 51,
      "start": 13927.08,
      "end": 13927.68,
      "formatted_start": "03:52:07.080",
      "formatted_end": "03:52:07.680",
      "text": "خاندو تیم"
    },
    {
      "id": 52,
      "start": 13927.68,
      "end": 13928.6,
      "formatted_start": "03:52:07.680",
      "formatted_end": "03:52:08.600",
      "text": "هنوز مابیده"
    },
    {
      "id": 53,
      "start": 13928.6,
      "end": 13929.6,
      "formatted_start": "03:52:08.600",
      "formatted_end": "03:52:09.600",
      "text": "بازی؟"
    },
    {
      "id": 54,
      "start": 13929.6,
      "end": 13930.6,
      "formatted_start": "03:52:09.600",
      "formatted_end": "03:52:10.600",
      "text": "من نگه"
    },
    {
      "id": 55,
      "start": 13930.6,
      "end": 13931.6,
      "formatted_start": "03:52:10.600",
      "formatted_end": "03:52:11.600",
      "text": "سلام"
    },
    {
      "id": 56,
      "start": 13931.6,
      "end": 13932.6,
      "formatted_start": "03:52:11.600",
      "formatted_end": "03:52:12.600",
      "text": "سلام"
    },
    {
      "id": 57,
      "start": 13933.84,
      "end": 13953.84,
      "formatted_start": "03:52:13.840",
      "formatted_end": "03:52:33.840",
      "text": "موسیقی"
    },
    {
      "id": 58,
      "start": 13953.84,
      "end": 13959.84,
      "formatted_start": "03:52:33.840",
      "formatted_end": "03:52:39.840",
      "text": "بعد این بعد از خانه تیفانی سرگیجای مداوم از شمبه کلا من را سرگیجای کنم شاید بخاطر پشار کنیم"
    },
    {
      "id": 59,
      "start": 13959.84,
      "end": 13961.84,
      "formatted_start": "03:52:39.840",
      "formatted_end": "03:52:41.840",
      "text": "چربیت بودم"
    },
    {
      "id": 60,
      "start": 13961.84,
      "end": 13962.84,
      "formatted_start": "03:52:41.840",
      "formatted_end": "03:52:42.840",
      "text": "چربیت بوده؟"
    },
    {
      "id": 61,
      "start": 13962.84,
      "end": 13964.84,
      "formatted_start": "03:52:42.840",
      "formatted_end": "03:52:44.840",
      "text": "چربیت بالا از کرسترول دیویست و بیست"
    },
    {
      "id": 62,
      "start": 13964.84,
      "end": 13965.84,
      "formatted_start": "03:52:44.840",
      "formatted_end": "03:52:45.840",
      "text": "بعد شمبه شاید؟"
    },
    {
      "id": 63,
      "start": 13965.84,
      "end": 13966.84,
      "formatted_start": "03:52:45.840",
      "formatted_end": "03:52:46.840",
      "text": "صد افتاده"
    },
    {
      "id": 64,
      "start": 13966.84,
      "end": 13969.84,
      "formatted_start": "03:52:46.840",
      "formatted_end": "03:52:49.840",
      "text": "بعد از شمبه کسان سرگیجای نمی کنه"
    },
    {
      "id": 65,
      "start": 13969.84,
      "end": 13973.84,
      "formatted_start": "03:52:49.840",
      "formatted_end": "03:52:53.840",
      "text": "سرگیجای چربیت دونیا بزنی فایده نداره که"
    },
    {
      "id": 66,
      "start": 13973.84,
      "end": 13976.84,
      "formatted_start": "03:52:53.840",
      "formatted_end": "03:52:56.840",
      "text": "بدتر میشه اصلا سرگیجای تا افتاده نداره"
    },
    {
      "id": 67,
      "start": 13976.84,
      "end": 13980.84,
      "formatted_start": "03:52:56.840",
      "formatted_end": "03:53:00.840",
      "text": "ما فکر کردیم بخواد خستگیه کنیم و اینها عبور پشاره را رفتیم"
    },
    {
      "id": 68,
      "start": 13980.84,
      "end": 13981.84,
      "formatted_start": "03:53:00.840",
      "formatted_end": "03:53:01.840",
      "text": "چیزی زدیم؟"
    },
    {
      "id": 69,
      "start": 13981.84,
      "end": 13982.84,
      "formatted_start": "03:53:01.840",
      "formatted_end": "03:53:02.840",
      "text": "نه، نه، نه"
    },
    {
      "id": 70,
      "start": 13982.84,
      "end": 13984.84,
      "formatted_start": "03:53:02.840",
      "formatted_end": "03:53:04.840",
      "text": "ترشت زیاد میکنی؟"
    },
    {
      "id": 71,
      "start": 13984.84,
      "end": 13985.84,
      "formatted_start": "03:53:04.840",
      "formatted_end": "03:53:05.840",
      "text": "نه، اصلاً، نه"
    },
    {
      "id": 72,
      "start": 13985.84,
      "end": 13987.84,
      "formatted_start": "03:53:05.840",
      "formatted_end": "03:53:07.840",
      "text": "میدهش گرد میکنه، آره چند مردی میدهش؟"
    },
    {
      "id": 73,
      "start": 13987.84,
      "end": 13988.84,
      "formatted_start": "03:53:07.840",
      "formatted_end": "03:53:08.840",
      "text": "نه، از این روزه درخیبانه"
    },
    {
      "id": 74,
      "start": 13988.84,
      "end": 13989.84,
      "formatted_start": "03:53:08.840",
      "formatted_end": "03:53:09.840",
      "text": "ترخیب کام نوشته داره؟"
    },
    {
      "id": 75,
      "start": 13989.84,
      "end": 13991.84,
      "formatted_start": "03:53:09.840",
      "formatted_end": "03:53:11.840",
      "text": "بله، بله، بله، اولیه ترشت دیگه"
    },
    {
      "id": 76,
      "start": 13991.84,
      "end": 13996.84,
      "formatted_start": "03:53:11.840",
      "formatted_end": "03:53:16.840",
      "text": "او میشه ترشت سوزش نخوشه، ولی مدت التحاب داره"
    },
    {
      "id": 77,
      "start": 13996.84,
      "end": 13998.84,
      "formatted_start": "03:53:16.840",
      "formatted_end": "03:53:18.840",
      "text": "و اینجا هم بعض وقت هزیت می کنه"
    },
    {
      "id": 78,
      "start": 13998.84,
      "end": 13999.84,
      "formatted_start": "03:53:18.840",
      "formatted_end": "03:53:19.840",
      "text": "مدتی تکره"
    },
    {
      "id": 79,
      "start": 13999.84,
      "end": 14000.84,
      "formatted_start": "03:53:19.840",
      "formatted_end": "03:53:20.840",
      "text": "آره"
    },
    {
      "id": 80,
      "start": 14000.84,
      "end": 14002.84,
      "formatted_start": "03:53:20.840",
      "formatted_end": "03:53:22.840",
      "text": "پدامادرتون روی اجزای معهده قضبی نداشتن؟"
    },
    {
      "id": 81,
      "start": 14002.84,
      "end": 14003.84,
      "formatted_start": "03:53:22.840",
      "formatted_end": "03:53:23.840",
      "text": "نه"
    },
    {
      "id": 82,
      "start": 14003.84,
      "end": 14006.84,
      "formatted_start": "03:53:23.840",
      "formatted_end": "03:53:26.840",
      "text": "بله بابا هم امسا واسه آنجوره"
    },
    {
      "id": 83,
      "start": 14006.84,
      "end": 14008.84,
      "formatted_start": "03:53:26.840",
      "formatted_end": "03:53:28.840",
      "text": "افراش چه بود؟ طبیعی بود؟"
    },
    {
      "id": 84,
      "start": 14008.84,
      "end": 14009.84,
      "formatted_start": "03:53:28.840",
      "formatted_end": "03:53:29.840",
      "text": "آره طبیعی بود"
    },
    {
      "id": 85,
      "start": 14009.84,
      "end": 14010.84,
      "formatted_start": "03:53:29.840",
      "formatted_end": "03:53:30.840",
      "text": "خوب بود"
    },
    {
      "id": 86,
      "start": 14010.84,
      "end": 14012.84,
      "formatted_start": "03:53:30.840",
      "formatted_end": "03:53:32.840",
      "text": "این دردتون چقدر تونه می کشه؟"
    },
    {
      "id": 87,
      "start": 14012.84,
      "end": 14016.84,
      "formatted_start": "03:53:32.840",
      "formatted_end": "03:53:36.840",
      "text": "همین از شمبه که مثلا کاران تمام شد و بایستن واسه استراحت"
    },
    {
      "id": 88,
      "start": 14016.84,
      "end": 14018.84,
      "formatted_start": "03:53:36.840",
      "formatted_end": "03:53:38.840",
      "text": "اینجا مثلا بعض وقت هم می گرفت"
    },
    {
      "id": 89,
      "start": 14018.84,
      "end": 14019.84,
      "formatted_start": "03:53:38.840",
      "formatted_end": "03:53:39.840",
      "text": "چند تونه می کشه؟"
    },
    {
      "id": 90,
      "start": 14019.84,
      "end": 14021.84,
      "formatted_start": "03:53:39.840",
      "formatted_end": "03:53:41.840",
      "text": "دردش"
    },
    {
      "id": 91,
      "start": 14021.84,
      "end": 14023.84,
      "formatted_start": "03:53:41.840",
      "formatted_end": "03:53:43.840",
      "text": "گرفتی گیش میگفتی اولادی گریه داره"
    },
    {
      "id": 92,
      "start": 14023.84,
      "end": 14025.84,
      "formatted_start": "03:53:43.840",
      "formatted_end": "03:53:45.840",
      "text": "یک ساعت میگیره مثلا هر ساعت"
    },
    {
      "id": 93,
      "start": 14025.84,
      "end": 14027.84,
      "formatted_start": "03:53:45.840",
      "formatted_end": "03:53:47.840",
      "text": "یک ساعت رو ببینیم که چرا یک ساعت رو بخواب بگیریم"
    },
    {
      "id": 94,
      "start": 14027.84,
      "end": 14029.84,
      "formatted_start": "03:53:47.840",
      "formatted_end": "03:53:49.840",
      "text": "ساعت بگیرم"
    },
    {
      "id": 95,
      "start": 14029.84,
      "end": 14031.84,
      "formatted_start": "03:53:49.840",
      "formatted_end": "03:53:51.840",
      "text": "دارید سریج و خستیه بیدید"
    },
    {
      "id": 96,
      "start": 14031.84,
      "end": 14033.84,
      "formatted_start": "03:53:51.840",
      "formatted_end": "03:53:53.840",
      "text": "چردید دارید سنگینه خوابت بودید"
    },
    {
      "id": 97,
      "start": 14033.84,
      "end": 14035.84,
      "formatted_start": "03:53:53.840",
      "formatted_end": "03:53:55.840",
      "text": "کسه دیدوست دارید سنگینه"
    },
    {
      "id": 98,
      "start": 14035.84,
      "end": 14037.84,
      "formatted_start": "03:53:55.840",
      "formatted_end": "03:53:57.840",
      "text": "شما بیدارید در شما"
    },
    {
      "id": 99,
      "start": 14037.84,
      "end": 14039.84,
      "formatted_start": "03:53:57.840",
      "formatted_end": "03:53:59.840",
      "text": "و اون بیداری تا این درده مدتی"
    },
    {
      "id": 100,
      "start": 14039.84,
      "end": 14041.84,
      "formatted_start": "03:53:59.840",
      "formatted_end": "03:54:01.840",
      "text": "یک راله دوتا چیز باهم شده"
    },
    {
      "id": 101,
      "start": 14041.84,
      "end": 14043.84,
      "formatted_start": "03:54:01.840",
      "formatted_end": "03:54:03.840",
      "text": "چند تا چیز باهم شده"
    },
    {
      "id": 102,
      "start": 14043.84,
      "end": 14044.84,
      "formatted_start": "03:54:03.840",
      "formatted_end": "03:54:04.840",
      "text": "چند تا چیز باهم شده؟"
    },
    {
      "id": 103,
      "start": 14044.84,
      "end": 14045.84,
      "formatted_start": "03:54:04.840",
      "formatted_end": "03:54:05.840",
      "text": "پیدا هستم، پیدا برده هستم"
    },
    {
      "id": 104,
      "start": 14045.84,
      "end": 14046.84,
      "formatted_start": "03:54:05.840",
      "formatted_end": "03:54:06.840",
      "text": "کم خود هست؟"
    },
    {
      "id": 105,
      "start": 14046.84,
      "end": 14047.84,
      "formatted_start": "03:54:06.840",
      "formatted_end": "03:54:07.840",
      "text": "کم خود"
    },
    {
      "id": 106,
      "start": 14047.84,
      "end": 14048.84,
      "formatted_start": "03:54:07.840",
      "formatted_end": "03:54:08.840",
      "text": "کم خود؟"
    },
    {
      "id": 107,
      "start": 14048.84,
      "end": 14053.84,
      "formatted_start": "03:54:08.840",
      "formatted_end": "03:54:13.840",
      "text": "بخواهم دکتر بوده، من بعضی افتاده مثلا اگرم پریاد هستم، این سری پریاد منظمه"
    },
    {
      "id": 108,
      "start": 14053.84,
      "end": 14056.84,
      "formatted_start": "03:54:13.840",
      "formatted_end": "03:54:16.840",
      "text": "این سری حالت ریمان تو شکل هم یکتون مهمه میکنه"
    },
    {
      "id": 109,
      "start": 14056.84,
      "end": 14058.84,
      "formatted_start": "03:54:16.840",
      "formatted_end": "03:54:18.840",
      "text": "خب جایی نشی، حامله نمیست؟"
    },
    {
      "id": 110,
      "start": 14058.84,
      "end": 14060.84,
      "formatted_start": "03:54:18.840",
      "formatted_end": "03:54:20.840",
      "text": "نه نیستم، پریاد هم دیگه من"
    },
    {
      "id": 111,
      "start": 14060.84,
      "end": 14062.84,
      "formatted_start": "03:54:20.840",
      "formatted_end": "03:54:22.840",
      "text": "خب پریاد، پریادت مثل همیشه هست؟"
    },
    {
      "id": 112,
      "start": 14062.84,
      "end": 14063.84,
      "formatted_start": "03:54:22.840",
      "formatted_end": "03:54:23.840",
      "text": "آره"
    },
    {
      "id": 113,
      "start": 14063.84,
      "end": 14067.84,
      "formatted_start": "03:54:23.840",
      "formatted_end": "03:54:27.840",
      "text": "اگر پیروت را یک وقت فرد کنم، ممکن است که حامل شده باشه."
    },
    {
      "id": 114,
      "start": 14067.84,
      "end": 14069.84,
      "formatted_start": "03:54:27.840",
      "formatted_end": "03:54:29.840",
      "text": "و همین پرس هست."
    },
    {
      "id": 115,
      "start": 14069.84,
      "end": 14070.84,
      "formatted_start": "03:54:29.840",
      "formatted_end": "03:54:30.840",
      "text": "نمیتونم."
    },
    {
      "id": 116,
      "start": 14070.84,
      "end": 14073.84,
      "formatted_start": "03:54:30.840",
      "formatted_end": "03:54:33.840",
      "text": "پرس های آرنجی را شدیم و میگویم که فعالت نیست."
    },
    {
      "id": 117,
      "start": 14073.84,
      "end": 14075.84,
      "formatted_start": "03:54:33.840",
      "formatted_end": "03:54:35.840",
      "text": "نه، اونوقت زایمان بود. اون پرموی کردیم."
    },
    {
      "id": 118,
      "start": 14075.84,
      "end": 14077.84,
      "formatted_start": "03:54:35.840",
      "formatted_end": "03:54:37.840",
      "text": "که زایمان کردی؟"
    },
    {
      "id": 119,
      "start": 14077.84,
      "end": 14079.84,
      "formatted_start": "03:54:37.840",
      "formatted_end": "03:54:39.840",
      "text": "دو سال پیش."
    },
    {
      "id": 120,
      "start": 14079.84,
      "end": 14081.84,
      "formatted_start": "03:54:39.840",
      "formatted_end": "03:54:41.840",
      "text": "چلگیری داری؟"
    },
    {
      "id": 121,
      "start": 14081.84,
      "end": 14083.84,
      "formatted_start": "03:54:41.840",
      "formatted_end": "03:54:43.840",
      "text": "طبیعیه."
    },
    {
      "id": 122,
      "start": 14083.84,
      "end": 14085.84,
      "formatted_start": "03:54:43.840",
      "formatted_end": "03:54:45.840",
      "text": "پرس هایی که مصرف نگهده."
    },
    {
      "id": 123,
      "start": 14085.84,
      "end": 14086.84,
      "formatted_start": "03:54:45.840",
      "formatted_end": "03:54:46.840",
      "text": "و یاد سربختوری؟"
    },
    {
      "id": 124,
      "start": 14086.84,
      "end": 14087.84,
      "formatted_start": "03:54:46.840",
      "formatted_end": "03:54:47.840",
      "text": "سربختور. روزش همه چیز سربختوری."
    },
    {
      "id": 125,
      "start": 14087.84,
      "end": 14089.84,
      "formatted_start": "03:54:47.840",
      "formatted_end": "03:54:49.840",
      "text": "از این وقت باید برداریم."
    },
    {
      "id": 126,
      "start": 14089.84,
      "end": 14091.84,
      "formatted_start": "03:54:49.840",
      "formatted_end": "03:54:51.840",
      "text": "همین سری به نوار هم نمیخواد."
    },
    {
      "id": 127,
      "start": 14091.84,
      "end": 14093.84,
      "formatted_start": "03:54:51.840",
      "formatted_end": "03:54:53.840",
      "text": "دستجوی رفته هم جیزو کردیم."
    },
    {
      "id": 128,
      "start": 14093.84,
      "end": 14095.84,
      "formatted_start": "03:54:53.840",
      "formatted_end": "03:54:55.840",
      "text": "یک تست بازاری باید برداریم."
    },
    {
      "id": 129,
      "start": 14095.84,
      "end": 14097.84,
      "formatted_start": "03:54:55.840",
      "formatted_end": "03:54:57.840",
      "text": "تست بازاری؟"
    },
    {
      "id": 130,
      "start": 14097.84,
      "end": 14099.84,
      "formatted_start": "03:54:57.840",
      "formatted_end": "03:54:59.840",
      "text": "اطمان."
    }
  ],
  "status": "completed"
}