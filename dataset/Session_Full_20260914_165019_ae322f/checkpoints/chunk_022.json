  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6630.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6634.5,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:34.500",
      "text": "تخمه ها و پوشت قرمز روغن تو این مدت اصلا نباید بخوره"
    },
    {
      "id": 2,
      "start": 6634.5,
      "end": 6638.0,
      "formatted_start": "01:50:34.500",
      "formatted_end": "01:50:38.000",
      "text": "و معمولا مطمئن اصلی داروی گیاهی هست"
    },
    {
      "id": 3,
      "start": 6638.0,
      "end": 6641.5,
      "formatted_start": "01:50:38.000",
      "formatted_end": "01:50:41.500",
      "text": "مثلا یه جوشونده های خاصی برس میخورد و توش برنامه تیرده"
    },
    {
      "id": 4,
      "start": 6641.5,
      "end": 6643.5,
      "formatted_start": "01:50:41.500",
      "formatted_end": "01:50:43.500",
      "text": "این هم نیست؟"
    },
    {
      "id": 5,
      "start": 6645.5,
      "end": 6648.5,
      "formatted_start": "01:50:45.500",
      "formatted_end": "01:50:48.500",
      "text": "اگر که معلوم نشه اون وقت دیگه باید"
    },
    {
      "id": 6,
      "start": 6648.5,
      "end": 6653.0,
      "formatted_start": "01:50:48.500",
      "formatted_end": "01:50:53.000",
      "text": "هپاتیت ها این چیزها را چکنه و ببینی چه کار شده و ببین جوش شده"
    },
    {
      "id": 7,
      "start": 6653.0,
      "end": 6655.0,
      "formatted_start": "01:50:53.000",
      "formatted_end": "01:50:55.000",
      "text": "خب در روک ها نیست؟"
    },
    {
      "id": 8,
      "start": 6655.0,
      "end": 6657.0,
      "formatted_start": "01:50:55.000",
      "formatted_end": "01:50:57.000",
      "text": "نه انشاءالله"
    },
    {
      "id": 9,
      "start": 6657.0,
      "end": 6663.0,
      "formatted_start": "01:50:57.000",
      "formatted_end": "01:51:03.000",
      "text": "تا شب کنید، این دو هفته ببینید میاد پایین یا میره بالا"
    },
    {
      "id": 10,
      "start": 6663.0,
      "end": 6668.0,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:08.000",
      "text": "اگه دیدید این وقت بی حال تر شد خودتر بیاد، آزمایشش رو می نمیستم الان می دهم"
    },
    {
      "id": 11,
      "start": 6668.0,
      "end": 6673.0,
      "formatted_start": "01:51:08.000",
      "formatted_end": "01:51:13.000",
      "text": "خوص خوارمهری هم بزرگ می بدم بشه که منظماشو می آره پایین می کرده شد"
    },
    {
      "id": 12,
      "start": 6673.0,
      "end": 6678.0,
      "formatted_start": "01:51:13.000",
      "formatted_end": "01:51:18.000",
      "text": "زرچوبه زیاد استخده کنه، بعد خوص تیروی بشه"
    },
    {
      "id": 13,
      "start": 6678.0,
      "end": 6683.0,
      "formatted_start": "01:51:18.000",
      "formatted_end": "01:51:23.000",
      "text": "الان می دهیم بشنن بزنید بینیم خوص تیروی بشه چجوری می خورده داده"
