      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 19560.0,
      "end": 19590.0,
      "formatted_start": "05:26:00.000",
      "formatted_end": "05:26:30.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 3,
      "start": 19590.0,
      "end": 19592.0,
      "formatted_start": "05:26:30.000",
      "formatted_end": "05:26:32.000",
      "text": "این پاور نبود."
    },
    {
      "id": 4,
      "start": 19592.0,
      "end": 19594.0,
      "formatted_start": "05:26:32.000",
      "formatted_end": "05:26:34.000",
      "text": "آهان. ما بهتون زنگ نداریم. اینو خود دادیم."
    },
    {
      "id": 5,
      "start": 19594.0,
      "end": 19596.0,
      "formatted_start": "05:26:34.000",
      "formatted_end": "05:26:36.000",
      "text": "آره. آره. خواهی داریم."
    },
    {
      "id": 6,
      "start": 19596.0,
      "end": 19598.0,
      "formatted_start": "05:26:36.000",
      "formatted_end": "05:26:38.000",
      "text": "خواهی نداریم."
    },
    {
      "id": 7,
      "start": 19598.0,
      "end": 19600.0,
      "formatted_start": "05:26:38.000",
      "formatted_end": "05:26:40.000",
      "text": "خواهی داریم."
    },
    {
      "id": 8,
      "start": 19600.0,
      "end": 19602.0,
      "formatted_start": "05:26:40.000",
      "formatted_end": "05:26:42.000",
      "text": "این پاور نبود."
    },
    {
      "id": 9,
      "start": 19602.0,
      "end": 19604.0,
      "formatted_start": "05:26:42.000",
      "formatted_end": "05:26:44.000",
      "text": "خودتون بگم این پاور دیده."
    },
    {
      "id": 10,
      "start": 19604.0,
      "end": 19606.0,
      "formatted_start": "05:26:44.000",
      "formatted_end": "05:26:46.000",
      "text": "تک افتیم برا گمبه."
    },
    {
      "id": 11,
      "start": 19606.0,
      "end": 19608.0,
      "formatted_start": "05:26:46.000",
      "formatted_end": "05:26:48.000",
      "text": "آره."
    },
    {
      "id": 12,
      "start": 19608.0,
      "end": 19610.0,
      "formatted_start": "05:26:48.000",
      "formatted_end": "05:26:50.000",
      "text": "این پاور نبود."
    },
    {
      "id": 13,
      "start": 19610.0,
      "end": 19612.0,
      "formatted_start": "05:26:50.000",
      "formatted_end": "05:26:52.000",
      "text": "برای این پاور نبود."
    },
    {
