    },
    {
      "id": 71,
      "start": 16752.04,
      "end": 16754.04,
      "formatted_start": "04:39:12.040",
      "formatted_end": "04:39:14.040",
      "text": "باید برداریم"
    },
    {
      "id": 72,
      "start": 16754.04,
      "end": 16756.04,
      "formatted_start": "04:39:14.040",
      "formatted_end": "04:39:16.040",
      "text": "باید برداریم"
    },
    {
      "id": 73,
      "start": 16756.04,
      "end": 16758.04,
      "formatted_start": "04:39:16.040",
      "formatted_end": "04:39:18.040",
      "text": "اینجا درد میگیره"
    },
    {
      "id": 74,
      "start": 16760.04,
      "end": 16762.04,
      "formatted_start": "04:39:20.040",
      "formatted_end": "04:39:22.040",
      "text": "چند روز درد میگیره"
    },
    {
      "id": 75,
      "start": 16762.04,
      "end": 16764.04,
      "formatted_start": "04:39:22.040",
      "formatted_end": "04:39:24.040",
