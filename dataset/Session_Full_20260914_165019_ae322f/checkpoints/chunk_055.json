  "stt_segments": [
    {
      "id": 0,
      "start": 16500.0,
      "end": 16506.0,
      "formatted_start": "04:35:00.000",
      "formatted_end": "04:35:06.000",
      "text": "اینو بیارویجه بیار بیار تو رو خیلی شکل بگیر. اگه تمام شد بیارویجه بگیر."
    },
    {
      "id": 1,
      "start": 16530.0,
      "end": 16535.0,
      "formatted_start": "04:35:30.000",
      "formatted_end": "04:35:35.000",
      "text": "باید داراتو نوشتم. هر چی دار خونه داد بگیر. هر چی نداد نیم."
    },
    {
      "id": 2,
      "start": 16535.0,
      "end": 16537.0,
      "formatted_start": "04:35:35.000",
      "formatted_end": "04:35:37.000",
      "text": "باشه شانم."
    },
    {
      "id": 3,
      "start": 16552.0,
      "end": 16557.0,
      "formatted_start": "04:35:52.000",
      "formatted_end": "04:35:57.000",
      "text": "یاد داشتی. خودت نگاه نبود. آخری گرفتی."
    },
    {
      "id": 4,
      "start": 16557.0,
      "end": 16559.0,
      "formatted_start": "04:35:57.000",
      "formatted_end": "04:35:59.000",
      "text": "این جدیده این"
    },
    {
      "id": 5,
      "start": 16559.0,
      "end": 16561.0,
      "formatted_start": "04:35:59.000",
      "formatted_end": "04:36:01.000",
      "text": "نه خدا نه گرز داری"
    },
    {
      "id": 6,
      "start": 16561.0,
      "end": 16563.0,
      "formatted_start": "04:36:01.000",
      "formatted_end": "04:36:03.000",
      "text": "هه"
    },
    {
      "id": 7,
      "start": 16563.0,
      "end": 16565.0,
      "formatted_start": "04:36:03.000",
      "formatted_end": "04:36:05.000",
      "text": "یه دقیقه را ای کشار دیده"
    },
    {
      "id": 8,
      "start": 16565.0,
      "end": 16567.0,
      "formatted_start": "04:36:05.000",
      "formatted_end": "04:36:07.000",
      "text": "این"
    },
    {
      "id": 9,
      "start": 16567.0,
      "end": 16569.0,
      "formatted_start": "04:36:07.000",
      "formatted_end": "04:36:09.000",
      "text": "این"
    },
    {
      "id": 10,
      "start": 16569.0,
      "end": 16571.0,
      "formatted_start": "04:36:09.000",
      "formatted_end": "04:36:11.000",
      "text": "این"
    },
    {
      "id": 11,
      "start": 16571.0,
      "end": 16573.0,
      "formatted_start": "04:36:11.000",
      "formatted_end": "04:36:13.000",
      "text": "این"
    },
    {
      "id": 12,
      "start": 16573.0,
      "end": 16575.0,
      "formatted_start": "04:36:13.000",
      "formatted_end": "04:36:15.000",
      "text": "این"
    },
    {
      "id": 13,
      "start": 16575.0,
      "end": 16577.0,
      "formatted_start": "04:36:15.000",
      "formatted_end": "04:36:17.000",
      "text": "این"
    },
    {
      "id": 14,
      "start": 16577.0,
      "end": 16579.0,
      "formatted_start": "04:36:17.000",
      "formatted_end": "04:36:19.000",
      "text": "این"
    },
    {
      "id": 15,
      "start": 16579.0,
      "end": 16581.0,
      "formatted_start": "04:36:19.000",
      "formatted_end": "04:36:21.000",
      "text": "این"
    },
    {
      "id": 16,
      "start": 16581.0,
      "end": 16583.0,
      "formatted_start": "04:36:21.000",
      "formatted_end": "04:36:23.000",
      "text": "این"
    },
    {
      "id": 17,
      "start": 16583.0,
      "end": 16585.0,
      "formatted_start": "04:36:23.000",
      "formatted_end": "04:36:25.000",
      "text": "این"
    },
    {
      "id": 18,
      "start": 16585.0,
      "end": 16615.0,
      "formatted_start": "04:36:25.000",
      "formatted_end": "04:36:55.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 19,
      "start": 16615.0,
      "end": 16620.64,
      "formatted_start": "04:36:55.000",
      "formatted_end": "04:37:00.640",
      "text": "حالا تعمو دارم. من در سه روز امیز بالا آوردم. حالا تعمو بعدشم."
    },
    {
      "id": 20,
      "start": 16620.64,
      "end": 16624.22,
      "formatted_start": "04:37:00.640",
      "formatted_end": "04:37:04.220",
      "text": "من در خیلی بد دارم. مشکل رساله اون دارم."
    },
    {
      "id": 21,
      "start": 16624.22,
      "end": 16628.46,
      "formatted_start": "04:37:04.220",
      "formatted_end": "04:37:08.460",
      "text": "من پشت گردنم تیم بخشی دیگر صحبت می کنم."
    },
    {
      "id": 22,
      "start": 16628.46,
      "end": 16632.06,
      "formatted_start": "04:37:08.460",
      "formatted_end": "04:37:12.060",
      "text": "کلا صحبت می دانم کلا پشت گردنم تصرفم."
    },
    {
      "id": 23,
      "start": 16632.06,
      "end": 16633.06,
      "formatted_start": "04:37:12.060",
      "formatted_end": "04:37:13.060",
      "text": "تو اون چند روز؟"
    },
    {
      "id": 24,
      "start": 16633.06,
      "end": 16637.66,
      "formatted_start": "04:37:13.060",
      "formatted_end": "04:37:17.660",
      "text": "تیم دیگر شد سرگیجه دارم. نه قبل نرم می شود و در نرم دیگر بیشتر می شود."
    },
    {
      "id": 25,
      "start": 16637.66,
      "end": 16642.04,
      "formatted_start": "04:37:17.660",
      "formatted_end": "04:37:22.040",
      "text": "بعد پشت کمرم کلا بردم. همه جام درد می کنم."
    },
    {
      "id": 26,
      "start": 16642.04,
      "end": 16644.04,
      "formatted_start": "04:37:22.040",
      "formatted_end": "04:37:24.040",
      "text": "شکنه؟ سال که نشدی؟"
    },
    {
      "id": 27,
      "start": 16644.04,
      "end": 16645.04,
      "formatted_start": "04:37:24.040",
      "formatted_end": "04:37:25.040",
      "text": "نه همین"
    },
    {
      "id": 28,
      "start": 16645.04,
      "end": 16647.04,
      "formatted_start": "04:37:25.040",
      "formatted_end": "04:37:27.040",
      "text": "بعد من اسکل مره هم کردم"
    },
    {
      "id": 29,
      "start": 16647.04,
      "end": 16649.04,
      "formatted_start": "04:37:27.040",
      "formatted_end": "04:37:29.040",
      "text": "که کردی؟"
    },
    {
      "id": 30,
      "start": 16649.04,
      "end": 16651.04,
      "formatted_start": "04:37:29.040",
      "formatted_end": "04:37:31.040",
      "text": "حدود دو سال میشه"
    },
    {
      "id": 31,
      "start": 16651.04,
      "end": 16654.04,
      "formatted_start": "04:37:31.040",
      "formatted_end": "04:37:34.040",
      "text": "و ساهم میخوره؟"
    },
    {
      "id": 32,
      "start": 16654.04,
      "end": 16656.04,
      "formatted_start": "04:37:34.040",
      "formatted_end": "04:37:36.040",
      "text": "نه تازه شده"
    },
    {
      "id": 33,
      "start": 16656.04,
      "end": 16658.04,
      "formatted_start": "04:37:36.040",
      "formatted_end": "04:37:38.040",
      "text": "از من کم خوریم"
    },
    {
      "id": 34,
      "start": 16658.04,
      "end": 16660.04,
      "formatted_start": "04:37:38.040",
      "formatted_end": "04:37:40.040",
      "text": "کم خورم بکنم باید برگرد بگیرم"
    },
    {
      "id": 35,
      "start": 16660.04,
      "end": 16662.04,
      "formatted_start": "04:37:40.040",
      "formatted_end": "04:37:42.040",
      "text": "برگرد بگیریم"
    },
    {
      "id": 36,
      "start": 16666.04,
      "end": 16668.04,
      "formatted_start": "04:37:46.040",
      "formatted_end": "04:37:48.040",
      "text": "خیلی عرق نوریزم"
    },
    {
      "id": 37,
      "start": 16668.04,
      "end": 16671.04,
      "formatted_start": "04:37:48.040",
      "formatted_end": "04:37:51.040",
      "text": "بی های آن فردی هست"
    },
    {
      "id": 38,
      "start": 16671.04,
      "end": 16673.04,
      "formatted_start": "04:37:51.040",
      "formatted_end": "04:37:53.040",
      "text": "از این وقت خیلی شده ایم دارم"
    },
    {
      "id": 39,
      "start": 16673.04,
      "end": 16675.04,
      "formatted_start": "04:37:53.040",
      "formatted_end": "04:37:55.040",
      "text": "آزمایش نداری دختر؟"
    },
    {
      "id": 40,
      "start": 16675.04,
      "end": 16677.04,
      "formatted_start": "04:37:55.040",
      "formatted_end": "04:37:57.040",
      "text": "آزمایش چی میدی؟"
    },
    {
      "id": 41,
      "start": 16677.04,
      "end": 16679.04,
      "formatted_start": "04:37:57.040",
      "formatted_end": "04:37:59.040",
      "text": "خونه"
    },
    {
      "id": 42,
      "start": 16679.04,
      "end": 16681.04,
      "formatted_start": "04:37:59.040",
      "formatted_end": "04:38:01.040",
      "text": "آزمایش خونه برای چی میدی؟"
    },
    {
      "id": 43,
      "start": 16681.04,
      "end": 16683.04,
      "formatted_start": "04:38:01.040",
      "formatted_end": "04:38:03.040",
      "text": "آزمایش خونه برای چی میدی؟"
    },
    {
      "id": 44,
      "start": 16683.04,
      "end": 16685.04,
      "formatted_start": "04:38:03.040",
      "formatted_end": "04:38:05.040",
      "text": "بله این گوینه کم خونی"
    },
    {
      "id": 45,
      "start": 16685.04,
      "end": 16687.04,
      "formatted_start": "04:38:05.040",
      "formatted_end": "04:38:07.040",
      "text": "چقدر کم خونی؟"
    },
    {
      "id": 46,
      "start": 16687.04,
      "end": 16691.04,
      "formatted_start": "04:38:07.040",
      "formatted_end": "04:38:11.040",
      "text": "بعد در دستان هم بیهست میشه در صبح"
    },
    {
      "id": 47,
      "start": 16691.04,
      "end": 16693.04,
      "formatted_start": "04:38:11.040",
      "formatted_end": "04:38:13.040",
      "text": "بله این یه قطعا کم خونی بود"
    },
    {
      "id": 48,
      "start": 16693.04,
      "end": 16695.04,
      "formatted_start": "04:38:13.040",
      "formatted_end": "04:38:15.040",
      "text": "چون اسلیف کردی"
    },
    {
      "id": 49,
      "start": 16695.04,
      "end": 16697.04,
      "formatted_start": "04:38:15.040",
      "formatted_end": "04:38:17.040",
      "text": "بعد شما همیشه"
    },
    {
      "id": 50,
      "start": 16697.04,
      "end": 16699.04,
      "formatted_start": "04:38:17.040",
      "formatted_end": "04:38:19.040",
      "text": "کورس آهنگ و به دراز نبوخوید"
    },
    {
      "id": 51,
      "start": 16699.04,
      "end": 16703.04,
      "formatted_start": "04:38:19.040",
      "formatted_end": "04:38:23.040",
      "text": "بیهایی و بدمدرد هم بابای کمپونه هستند"
    },
    {
      "id": 52,
      "start": 16703.04,
      "end": 16707.04,
      "formatted_start": "04:38:23.040",
      "formatted_end": "04:38:27.040",
      "text": "بعد من ببخش شما متخصص زنان میدونم"
    },
    {
      "id": 53,
      "start": 16707.04,
      "end": 16709.04,
      "formatted_start": "04:38:27.040",
      "formatted_end": "04:38:29.040",
      "text": "در حال من"
    },
    {
      "id": 54,
      "start": 16709.04,
      "end": 16711.04,
      "formatted_start": "04:38:29.040",
      "formatted_end": "04:38:31.040",
      "text": "اما عشق زنان بهتون شده؟"
    },
    {
      "id": 55,
      "start": 16711.04,
      "end": 16717.04,
      "formatted_start": "04:38:31.040",
      "formatted_end": "04:38:37.040",
      "text": "عشق زنان من چند خیلی ببخش کرده شده شده شده شده"
    },
    {
      "id": 56,
      "start": 16717.04,
      "end": 16719.04,
      "formatted_start": "04:38:37.040",
      "formatted_end": "04:38:39.040",
      "text": "چون خوارش شده شده"
    },
    {
      "id": 57,
      "start": 16719.04,
      "end": 16721.04,
      "formatted_start": "04:38:39.040",
      "formatted_end": "04:38:41.040",
      "text": "بعد به ما هم یه اعتماد نفونت داریم"
    },
    {
      "id": 58,
      "start": 16721.04,
      "end": 16723.04,
      "formatted_start": "04:38:41.040",
      "formatted_end": "04:38:43.040",
      "text": "به خاطر این بدمدرد رو طب داریم"
    },
    {
      "id": 59,
      "start": 16723.04,
      "end": 16725.04,
      "formatted_start": "04:38:43.040",
      "formatted_end": "04:38:45.040",
      "text": "گفتی اینم به شما دیگه"
    },
    {
      "id": 60,
      "start": 16725.04,
      "end": 16727.04,
      "formatted_start": "04:38:45.040",
      "formatted_end": "04:38:47.040",
      "text": "موقع نزدیکی درد داری؟"
    },
    {
      "id": 61,
      "start": 16727.04,
      "end": 16729.04,
      "formatted_start": "04:38:47.040",
      "formatted_end": "04:38:49.040",
      "text": "باید برداریم"
    },
    {
      "id": 62,
      "start": 16734.04,
      "end": 16736.04,
      "formatted_start": "04:38:54.040",
      "formatted_end": "04:38:56.040",
      "text": "همینطور که برداریم"
    },
    {
      "id": 63,
      "start": 16736.04,
      "end": 16738.04,
      "formatted_start": "04:38:56.040",
      "formatted_end": "04:38:58.040",
      "text": "باید برداریم"
    },
    {
      "id": 64,
      "start": 16738.04,
      "end": 16740.04,
      "formatted_start": "04:38:58.040",
      "formatted_end": "04:39:00.040",
      "text": "باید برداریم"
    },
    {
      "id": 65,
      "start": 16740.04,
      "end": 16742.04,
      "formatted_start": "04:39:00.040",
      "formatted_end": "04:39:02.040",
      "text": "باید برداریم"
    },
    {
      "id": 66,
      "start": 16742.04,
      "end": 16744.04,
      "formatted_start": "04:39:02.040",
      "formatted_end": "04:39:04.040",
      "text": "باید برداریم"
    },
    {
      "id": 67,
      "start": 16744.04,
      "end": 16746.04,
      "formatted_start": "04:39:04.040",
      "formatted_end": "04:39:06.040",
      "text": "باید برداریم"
    },
    {
      "id": 68,
      "start": 16746.04,
      "end": 16748.04,
      "formatted_start": "04:39:06.040",
      "formatted_end": "04:39:08.040",
      "text": "باید برداریم"
    },
    {
      "id": 69,
      "start": 16748.04,
      "end": 16750.04,
      "formatted_start": "04:39:08.040",
      "formatted_end": "04:39:10.040",
      "text": "باید برداریم"
    },
    {
      "id": 70,
      "start": 16750.04,
      "end": 16752.04,
      "formatted_start": "04:39:10.040",
      "formatted_end": "04:39:12.040",
