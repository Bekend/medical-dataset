  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13202.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:02.000",
      "text": "اینو بردارید دیگه."
    },
    {
      "id": 1,
      "start": 13202.0,
      "end": 13204.0,
      "formatted_start": "03:40:02.000",
      "formatted_end": "03:40:04.000",
      "text": "کجا بردارید؟"
    },
    {
      "id": 2,
      "start": 13204.0,
      "end": 13206.0,
      "formatted_start": "03:40:04.000",
      "formatted_end": "03:40:06.000",
      "text": "تو رجعی."
    },
    {
      "id": 3,
      "start": 13206.0,
      "end": 13208.0,
      "formatted_start": "03:40:06.000",
      "formatted_end": "03:40:08.000",
      "text": "پس اینو نامدی."
    },
    {
      "id": 4,
      "start": 13208.0,
      "end": 13210.0,
      "formatted_start": "03:40:08.000",
      "formatted_end": "03:40:10.000",
      "text": "حاضریتش کنم کنه که هم خطرناکه."
    },
    {
      "id": 5,
      "start": 13210.0,
      "end": 13214.0,
      "formatted_start": "03:40:10.000",
      "formatted_end": "03:40:14.000",
      "text": "تو باید میشه برای سرتان سرار شد."
    },
    {
      "id": 6,
      "start": 13214.0,
      "end": 13216.0,
      "formatted_start": "03:40:14.000",
      "formatted_end": "03:40:16.000",
      "text": "آره."
    },
    {
      "id": 7,
      "start": 13216.0,
      "end": 13218.0,
      "formatted_start": "03:40:16.000",
      "formatted_end": "03:40:18.000",
      "text": "بیا میکنم."
    },
    {
      "id": 8,
      "start": 13218.0,
      "end": 13220.0,
      "formatted_start": "03:40:18.000",
      "formatted_end": "03:40:20.000",
      "text": "یکی."
    },
    {
      "id": 9,
      "start": 13220.0,
      "end": 13222.0,
      "formatted_start": "03:40:20.000",
      "formatted_end": "03:40:22.000",
      "text": "کالیاتون کسته."
    },
    {
      "id": 10,
      "start": 13222.0,
      "end": 13224.0,
      "formatted_start": "03:40:22.000",
      "formatted_end": "03:40:24.000",
      "text": "کستشم بزرگ."
    },
    {
      "id": 11,
      "start": 13224.0,
      "end": 13226.0,
      "formatted_start": "03:40:24.000",
      "formatted_end": "03:40:26.000",
      "text": "سرده پهلوها تو نباید بخوره."
    },
    {
      "id": 12,
      "start": 13226.0,
      "end": 13228.0,
      "formatted_start": "03:40:26.000",
      "formatted_end": "03:40:28.000",
      "text": "خب شما از جمعه تو اجارتون برای همین چیزی باشید."
    },
    {
      "id": 13,
      "start": 13228.0,
      "end": 13258.0,
      "formatted_start": "03:40:28.000",
      "formatted_end": "03:40:58.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 14,
      "start": 13258.0,
      "end": 13262.22,
      "formatted_start": "03:40:58.000",
      "formatted_end": "03:41:02.220",
      "text": "ما شما 5 سانتر تا به 8 سانتر به رسه جرایی نمی کنن"
    },
    {
      "id": 15,
      "start": 13262.22,
      "end": 13266.14,
      "formatted_start": "03:41:02.220",
      "formatted_end": "03:41:06.140",
      "text": "ولی شما برای موازه به کلیت و ماشه چی کار کنید"
    },
    {
      "id": 16,
      "start": 13266.14,
      "end": 13268.26,
      "formatted_start": "03:41:06.140",
      "formatted_end": "03:41:08.260",
      "text": "نمک تو غذا تو نمی زنید"
    },
    {
      "id": 17,
      "start": 13268.26,
      "end": 13270.38,
      "formatted_start": "03:41:08.260",
      "formatted_end": "03:41:10.380",
      "text": "گوشت قرمز قفتی یه بار بیشتر نمی کنید"
    },
    {
      "id": 18,
      "start": 13270.38,
      "end": 13271.76,
      "formatted_start": "03:41:10.380",
      "formatted_end": "03:41:11.760",
      "text": "اسپناج هم نمی کنید"
    },
    {
      "id": 19,
      "start": 13271.76,
      "end": 13272.76,
      "formatted_start": "03:41:11.760",
      "formatted_end": "03:41:12.760",
      "text": "اسپناج نخورید"
    },
    {
      "id": 20,
      "start": 13272.76,
      "end": 13274.74,
      "formatted_start": "03:41:12.760",
      "formatted_end": "03:41:14.740",
      "text": "خانمون نباید اسپناج بخورید"
    },
    {
      "id": 21,
      "start": 13274.74,
      "end": 13278.52,
      "formatted_start": "03:41:14.740",
      "formatted_end": "03:41:18.520",
      "text": "و پرزدادتون هم این هم مطور بشده"
    },
    {
      "id": 22,
      "start": 13278.52,
      "end": 13281.18,
      "formatted_start": "03:41:18.520",
      "formatted_end": "03:41:21.180",
      "text": "ادراتون راحت می آن؟"
    },
    {
      "id": 23,
      "start": 13281.18,
      "end": 13283.98,
      "formatted_start": "03:41:21.180",
      "formatted_end": "03:41:23.980",
      "text": "سنان وزی موها یک فرده که اینه را ازیاب"
    },
    {
      "id": 24,
      "start": 13283.98,
      "end": 13290.98,
      "formatted_start": "03:41:23.980",
      "formatted_end": "03:41:30.980",
      "text": "از این حال، بعضی موقع، خیلی تردید چیز میشه، خدمت مرسی که نازوک میاد"
    },
    {
      "id": 25,
      "start": 13290.98,
      "end": 13292.98,
      "formatted_start": "03:41:30.980",
      "formatted_end": "03:41:32.980",
      "text": "آمان دیگه، بزرگ شده فرسته"
    },
    {
      "id": 26,
      "start": 13297.98,
      "end": 13299.98,
      "formatted_start": "03:41:37.980",
      "formatted_end": "03:41:39.980",
      "text": "من نمی کنم پایینه دیدم"
    },
    {
      "id": 27,
      "start": 13299.98,
      "end": 13302.98,
      "formatted_start": "03:41:39.980",
      "formatted_end": "03:41:42.980",
      "text": "خوب بود، آزمانش این ماله هست؟"
    },
    {
      "id": 28,
      "start": 13302.98,
      "end": 13303.98,
      "formatted_start": "03:41:42.980",
      "formatted_end": "03:41:43.980",
      "text": "آره، این مال خودم"
    },
    {
      "id": 29,
      "start": 13303.98,
      "end": 13305.98,
      "formatted_start": "03:41:43.980",
      "formatted_end": "03:41:45.980",
      "text": "نه، این مال خانم هست"
    },
    {
      "id": 30,
      "start": 13305.98,
      "end": 13307.98,
      "formatted_start": "03:41:45.980",
      "formatted_end": "03:41:47.980",
      "text": "اشخه بایگیره، بگیره"
    },
    {
      "id": 31,
      "start": 13307.98,
      "end": 13309.98,
      "formatted_start": "03:41:47.980",
      "formatted_end": "03:41:49.980",
      "text": "نه، بایگیره"
    },
    {
      "id": 32,
      "start": 13309.98,
      "end": 13311.98,
      "formatted_start": "03:41:49.980",
      "formatted_end": "03:41:51.980",
      "text": "ترجمه"
    },
    {
      "id": 33,
      "start": 13313.98,
      "end": 13315.98,
      "formatted_start": "03:41:53.980",
      "formatted_end": "03:41:55.980",
      "text": "این ها بود"
    },
    {
      "id": 34,
      "start": 13315.98,
      "end": 13317.98,
      "formatted_start": "03:41:55.980",
      "formatted_end": "03:41:57.980",
      "text": "نمیدونم چیه که"
    },
    {
      "id": 35,
      "start": 13317.98,
      "end": 13319.98,
      "formatted_start": "03:41:57.980",
      "formatted_end": "03:41:59.980",
      "text": "همینجایی دیگه نمیدونم"
    },
    {
      "id": 36,
      "start": 13319.98,
      "end": 13321.98,
      "formatted_start": "03:41:59.980",
      "formatted_end": "03:42:01.980",
      "text": "همینجایی"
    },
    {
      "id": 37,
      "start": 13327.98,
      "end": 13329.98,
      "formatted_start": "03:42:07.980",
      "formatted_end": "03:42:09.980",
      "text": "خواندتون خوبه هست"
    },
    {
      "id": 38,
      "start": 13329.98,
      "end": 13331.98,
      "formatted_start": "03:42:09.980",
      "formatted_end": "03:42:11.980",
      "text": "خوبه"
    },
    {
      "id": 39,
      "start": 13331.98,
      "end": 13333.98,
      "formatted_start": "03:42:11.980",
      "formatted_end": "03:42:13.980",
      "text": "آه کراتینتون بالاست که هم کار کرده کلیه"
    },
    {
      "id": 40,
      "start": 13333.98,
      "end": 13335.98,
      "formatted_start": "03:42:13.980",
      "formatted_end": "03:42:15.980",
      "text": "کراتین چه کار میکنه خانم تو؟"
    },
    {
      "id": 41,
      "start": 13335.98,
      "end": 13337.98,
      "formatted_start": "03:42:15.980",
      "formatted_end": "03:42:17.980",
      "text": "کراتین"
    },
    {
      "id": 42,
      "start": 13337.98,
      "end": 13339.98,
      "formatted_start": "03:42:17.980",
      "formatted_end": "03:42:19.980",
      "text": "عمل کرده کلیه است"
    },
    {
      "id": 43,
      "start": 13339.98,
      "end": 13341.98,
      "formatted_start": "03:42:19.980",
      "formatted_end": "03:42:21.980",
      "text": "آه آه"
    },
    {
      "id": 44,
      "start": 13341.98,
      "end": 13347.98,
      "formatted_start": "03:42:21.980",
      "formatted_end": "03:42:27.980",
      "text": "اگر صد هایی هست، اگر صد هایی هست، اما شما هشتاد درصد کار میکنید"
    },
    {
      "id": 45,
      "start": 13347.98,
      "end": 13349.98,
      "formatted_start": "03:42:27.980",
      "formatted_end": "03:42:29.980",
      "text": "و هشتاد درصد افت کرده"
    },
    {
      "id": 46,
      "start": 13349.98,
      "end": 13351.98,
      "formatted_start": "03:42:29.980",
      "formatted_end": "03:42:31.980",
      "text": "پس مهمه"
    },
    {
      "id": 47,
      "start": 13351.98,
      "end": 13355.98,
      "formatted_start": "03:42:31.980",
      "formatted_end": "03:42:35.980",
      "text": "چون ساینتون هم خیلی نیست، شست ساینتون هم خیلی نیست"
    },
    {
      "id": 48,
      "start": 13355.98,
      "end": 13359.98,
      "formatted_start": "03:42:35.980",
      "formatted_end": "03:42:39.980",
      "text": "و اینها اصلاً نخوره"
    },
    {
      "id": 49,
      "start": 13359.98,
      "end": 13363.98,
      "formatted_start": "03:42:39.980",
      "formatted_end": "03:42:43.980",
      "text": "دیکروفناک، بروفن، نافروکس هست"
    },
    {
      "id": 50,
      "start": 13363.98,
      "end": 13366.98,
      "formatted_start": "03:42:43.980",
      "formatted_end": "03:42:46.980",
      "text": "اینها برای شما بعده مزدکن فقط میجونین"
    },
    {
      "id": 51,
      "start": 13366.98,
      "end": 13370.98,
      "formatted_start": "03:42:46.980",
      "formatted_end": "03:42:50.980",
      "text": "اسلامینافن، گاوپردین، این چیز ساده"
    },
    {
      "id": 52,
      "start": 13370.98,
      "end": 13372.98,
      "formatted_start": "03:42:50.980",
      "formatted_end": "03:42:52.980",
      "text": "خانم توی یک مورد در اسفاده کاره"
    },
    {
      "id": 53,
      "start": 13372.98,
      "end": 13374.98,
      "formatted_start": "03:42:52.980",
      "formatted_end": "03:42:54.980",
      "text": "اون رفته نداره"
    },
    {
      "id": 54,
      "start": 13374.98,
      "end": 13380.98,
      "formatted_start": "03:42:54.980",
      "formatted_end": "03:43:00.980",
      "text": "بعد دست رو منم که زمان گستران یک قطره داری خوب شده هم که لاند"
    },
    {
      "id": 55,
      "start": 13380.98,
      "end": 13382.98,
      "formatted_start": "03:43:00.980",
      "formatted_end": "03:43:02.980",
      "text": "ما هنوز ادامه بدیم یکی برای اون روی هم برداریم"
    },
    {
      "id": 56,
      "start": 13382.98,
      "end": 13384.98,
      "formatted_start": "03:43:02.980",
      "formatted_end": "03:43:04.980",
      "text": "داره نشن؟"
    },
    {
      "id": 57,
      "start": 13384.98,
      "end": 13386.98,
      "formatted_start": "03:43:04.980",
      "formatted_end": "03:43:06.980",
      "text": "داره قطره دارم"
    },
    {
      "id": 58,
      "start": 13386.98,
      "end": 13390.98,
      "formatted_start": "03:43:06.980",
      "formatted_end": "03:43:10.980",
      "text": "خب براتون برات چکار کنیم؟ یکی کپسی در پروستات برات بنویسیم"
    },
    {
      "id": 59,
      "start": 13392.98,
      "end": 13394.98,
      "formatted_start": "03:43:12.980",
      "formatted_end": "03:43:14.980",
      "text": "برنامه در تقریب چه دار رو ازتون بگیرم"
    },
    {
      "id": 60,
      "start": 13394.98,
      "end": 13424.98,
      "formatted_start": "03:43:14.980",
      "formatted_end": "03:43:44.980",
      "text": "باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برد"
    },
    {
      "id": 61,
      "start": 13454.98,
      "end": 13466.98,
      "formatted_start": "03:44:14.980",
      "formatted_end": "03:44:26.980",
      "text": "جرائه تیرایتی کنید که یکم جرائه سختیه. آیسیون باید بره. من ریز نمیدونم کنم. اما راه این میگن. چرایی باید کار بکنیم. باید رفتن باید بریم."
    },
    {
      "id": 62,
      "start": 13466.98,
      "end": 13473.98,
      "formatted_start": "03:44:26.980",
      "formatted_end": "03:44:33.980",
      "text": "الان که جمعونی سرخوادی باید انجام بدیم. برنامه. بعدا ممکنه موضوع بشه که باید هوایی رو تنگ کنم."
    },
    {
      "id": 63,
      "start": 13473.98,
      "end": 13478.98,
      "formatted_start": "03:44:33.980",
      "formatted_end": "03:44:38.980",
      "text": "الانش داریم یکتیم خودتون دیگه. استدادتون چند وقت رو گرفته؟"
    },
    {
      "id": 64,
      "start": 13478.98,
      "end": 13487.98,
      "formatted_start": "03:44:38.980",
      "formatted_end": "03:44:47.980",
      "text": "این سنا من بعضی موها خدمتش مرسی که میبینی که مثل آدم های نشن مونند"
    },
    {
      "id": 65,
      "start": 13487.98,
      "end": 13491.98,
      "formatted_start": "03:44:47.980",
      "formatted_end": "03:44:51.980",
      "text": "بکش اینه که تیروید داره رو تا نه صوتی تو پشت آرمیده"
    },
    {
      "id": 66,
      "start": 13491.98,
      "end": 13492.98,
      "formatted_start": "03:44:51.980",
      "formatted_end": "03:44:52.980",
      "text": "آه بله بله"
    },
    {
      "id": 67,
      "start": 13492.98,
      "end": 13494.98,
      "formatted_start": "03:44:52.980",
      "formatted_end": "03:44:54.980",
      "text": "این برای همینجا بشه"
    },
    {
      "id": 68,
      "start": 13494.98,
      "end": 13498.98,
      "formatted_start": "03:44:54.980",
      "formatted_end": "03:44:58.980",
      "text": "یه بابه که نه آرمی شد هم این بزرگ میشه هم سنا کنند"
    },
    {
      "id": 69,
      "start": 13498.98,
      "end": 13499.98,
      "formatted_start": "03:44:58.980",
      "formatted_end": "03:44:59.980",
      "text": "هم تیروید"
    }
  ],
  "status": "completed"
}