  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6911.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:11.000",
      "text": "یک و نیم، خیلی کمکاری شدید گرده. نمیتونم مرتب بگرده چجوری شده که این همه کمکاری شدید گرده."
    },
    {
      "id": 1,
      "start": 6911.0,
      "end": 6927.0,
      "formatted_start": "01:55:11.000",
      "formatted_end": "01:55:27.000",
      "text": "هر روز یک و نیم، از جمعه، حتماً، حتماً، ببین اینجا میدین سبتیروید باید پنج هفته دیگه آزمایش بده، آزمایش تیروید، آنزیم کبه دو هفته دیگه."
    },
    {
      "id": 2,
      "start": 6927.0,
      "end": 6933.0,
      "formatted_start": "01:55:27.000",
      "formatted_end": "01:55:33.000",
      "text": "5 هفته دیگه که تاریخش میتره من الان آنوار کبتشو برای دو هفته دیگه نوشتم باشه؟"
    },
    {
      "id": 3,
      "start": 6933.0,
      "end": 6934.0,
      "formatted_start": "01:55:33.000",
      "formatted_end": "01:55:34.000",
      "text": "باشه"
    },
    {
      "id": 4,
      "start": 6934.0,
      "end": 6936.0,
      "formatted_start": "01:55:34.000",
      "formatted_end": "01:55:36.000",
      "text": "یعنی تاریخ هم داره"
    },
    {
      "id": 5,
      "start": 6936.0,
      "end": 6937.0,
      "formatted_start": "01:55:36.000",
      "formatted_end": "01:55:37.000",
      "text": "یا"
    },
    {
      "id": 6,
      "start": 6937.0,
      "end": 6939.0,
      "formatted_start": "01:55:37.000",
      "formatted_end": "01:55:39.000",
      "text": "باید ببینیم چه کار میکنه"
    },
    {
      "id": 7,
      "start": 6943.0,
      "end": 6945.0,
      "formatted_start": "01:55:43.000",
      "formatted_end": "01:55:45.000",
      "text": "بدقفلت اضرار خیلی شدید داره"
    },
    {
      "id": 8,
      "start": 6948.0,
      "end": 6955.0,
      "formatted_start": "01:55:48.000",
      "formatted_end": "01:55:55.000",
      "text": "کبتش داره درست کار میکنه خود چون پلاکتش خوبه یعنی داره کارشو درست انجام میده فقط برم کرده"
    },
    {
      "id": 9,
      "start": 6955.0,
      "end": 6958.86,
      "formatted_start": "01:55:55.000",
      "formatted_end": "01:55:58.860",
      "text": "حالا اونم خوب میشه رفتی کنه، قشنگ همشه زاربشت روز میده"
    },
    {
      "id": 10,
      "start": 6958.86,
      "end": 6962.82,
      "formatted_start": "01:55:58.860",
      "formatted_end": "01:56:02.820",
      "text": "میگه اون گرس رو برام نوشتن، دیگه نمی نوشتم خب چون براش نوشتم"
    },
    {
      "id": 11,
      "start": 6962.82,
      "end": 6964.48,
      "formatted_start": "01:56:02.820",
      "formatted_end": "01:56:04.480",
      "text": "از همون گرس ایکونیم بخود"
    },
    {
      "id": 12,
      "start": 6964.48,
      "end": 6968.54,
      "formatted_start": "01:56:04.480",
      "formatted_end": "01:56:08.540",
      "text": "آره، گروه برام نوشتم دیگه، دوتا وزارشون برام دوی نوشتم"
    },
    {
      "id": 13,
      "start": 6968.54,
      "end": 6974.3,
      "formatted_start": "01:56:08.540",
      "formatted_end": "01:56:14.300",
      "text": "خوشکناش و حتما سر ساعت بعد غذا بخوره، او خونت خیلی شدید تره"
    },
    {
      "id": 14,
      "start": 6974.3,
      "end": 6977.3,
      "formatted_start": "01:56:14.300",
      "formatted_end": "01:56:17.300",
      "text": "کسی داره آفونده کپ بلی مادری بزنه؟"
    },
    {
      "id": 15,
      "start": 6977.3,
      "end": 6978.4,
      "formatted_start": "01:56:17.300",
      "formatted_end": "01:56:18.400",
      "text": "آره آقا بزنه"
    },
    {
      "id": 16,
      "start": 6978.4,
      "end": 6980.4,
      "formatted_start": "01:56:18.400",
      "formatted_end": "01:56:20.400",
      "text": "اصاسیت نداشته به چیزی؟"
    },
    {
      "id": 17,
      "start": 6980.4,
      "end": 6981.4,
      "formatted_start": "01:56:20.400",
      "formatted_end": "01:56:21.400",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 6981.4,
      "end": 6982.4,
      "formatted_start": "01:56:21.400",
      "formatted_end": "01:56:22.400",
      "text": "مگه چی هست؟"
    },
    {
      "id": 19,
      "start": 6982.4,
      "end": 6984.4,
      "formatted_start": "01:56:22.400",
      "formatted_end": "01:56:24.400",
      "text": "خوشگانه مثل بلیسی بره"
    },
    {
      "id": 20,
      "start": 6984.4,
      "end": 6987.4,
      "formatted_start": "01:56:24.400",
      "formatted_end": "01:56:27.400",
      "text": "روز داشتون کجا هست؟ بهتاش نداره؟"
    },
    {
      "id": 21,
      "start": 6987.4,
      "end": 6988.4,
      "formatted_start": "01:56:27.400",
      "formatted_end": "01:56:28.400",
      "text": "به سوزه رو بیشتر"
    },
    {
      "id": 22,
      "start": 6988.4,
      "end": 6992.4,
      "formatted_start": "01:56:28.400",
      "formatted_end": "01:56:32.400",
      "text": "سوزه رو که دونستی؟ یک دقیقه بیاری نوده بره، درمونگا بزنه"
    },
    {
      "id": 23,
      "start": 6992.4,
      "end": 6993.4,
      "formatted_start": "01:56:32.400",
      "formatted_end": "01:56:33.400",
      "text": "بسیاره"
    },
    {
      "id": 24,
      "start": 6993.4,
      "end": 6994.4,
      "formatted_start": "01:56:33.400",
      "formatted_end": "01:56:34.400",
      "text": "ریسک نکنه"
    },
    {
      "id": 25,
      "start": 6994.4,
      "end": 6996.4,
      "formatted_start": "01:56:34.400",
      "formatted_end": "01:56:36.400",
      "text": "باشه، یکیشو بزنه و بعدیشو باز خودشو بزنه"
    },
    {
      "id": 26,
      "start": 6996.4,
      "end": 6997.4,
      "formatted_start": "01:56:36.400",
      "formatted_end": "01:56:37.400",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 7000.4,
      "end": 7004.4,
      "formatted_start": "01:56:40.400",
      "formatted_end": "01:56:44.400",
      "text": "شد آزمایش مامان دو هفته دیگه، به صفحه داروی ارمانش"
    },
    {
      "id": 28,
      "start": 7004.4,
      "end": 7010.4,
      "formatted_start": "01:56:44.400",
      "formatted_end": "01:56:50.400",
      "text": "سری بعد اون رو بیانیم که باید ببینیم چقدر اومد پایین باشه"
    },
    {
      "id": 29,
      "start": 7010.4,
      "end": 7012.4,
      "formatted_start": "01:56:50.400",
      "formatted_end": "01:56:52.400",
      "text": "ناشه نامونه از شما دردن کنید"
    },
    {
      "id": 30,
      "start": 7030.4,
      "end": 7032.4,
      "formatted_start": "01:57:10.400",
      "formatted_end": "01:57:12.400",
      "text": "سلام عزیزم"
    },
    {
      "id": 31,
      "start": 7034.4,
      "end": 7062.4,
      "formatted_start": "01:57:14.400",
      "formatted_end": "01:57:42.400",
      "text": "موسیقی"
    },
    {
      "id": 32,
      "start": 7062.4,
      "end": 7064.4,
      "formatted_start": "01:57:42.400",
      "formatted_end": "01:57:44.400",
      "text": "نه نمیشه بود"
    },
    {
      "id": 33,
      "start": 7064.4,
      "end": 7066.4,
      "formatted_start": "01:57:44.400",
      "formatted_end": "01:57:46.400",
      "text": "از اینجا رفتون دی؟"
    },
    {
      "id": 34,
      "start": 7066.4,
      "end": 7068.4,
      "formatted_start": "01:57:46.400",
      "formatted_end": "01:57:48.400",
      "text": "کارش می کنه"
    },
    {
      "id": 35,
      "start": 7068.4,
      "end": 7070.4,
      "formatted_start": "01:57:48.400",
      "formatted_end": "01:57:50.400",
      "text": "پرمیر نمیشه بود"
    },
    {
      "id": 36,
      "start": 7070.4,
      "end": 7072.4,
      "formatted_start": "01:57:50.400",
      "formatted_end": "01:57:52.400",
      "text": "خیلی بزنگ شد"
    },
    {
      "id": 37,
      "start": 7072.4,
      "end": 7074.4,
      "formatted_start": "01:57:52.400",
      "formatted_end": "01:57:54.400",
      "text": "تو تلکی بشن"
    },
    {
      "id": 38,
      "start": 7074.4,
      "end": 7076.4,
      "formatted_start": "01:57:54.400",
      "formatted_end": "01:57:56.400",
      "text": "یک شلوک برم باید عوض کن"
    },
    {
      "id": 39,
      "start": 7076.4,
      "end": 7078.4,
      "formatted_start": "01:57:56.400",
      "formatted_end": "01:57:58.400",
      "text": "نمیشه بود"
    },
    {
      "id": 40,
      "start": 7078.4,
      "end": 7080.4,
      "formatted_start": "01:57:58.400",
      "formatted_end": "01:58:00.400",
      "text": "برگت بود عزیز جان؟"
    },
    {
      "id": 41,
      "start": 7080.4,
      "end": 7082.4,
      "formatted_start": "01:58:00.400",
      "formatted_end": "01:58:02.400",
      "text": "بیادی دارد"
    },
    {
      "id": 42,
      "start": 7082.4,
      "end": 7084.4,
      "formatted_start": "01:58:02.400",
      "formatted_end": "01:58:04.400",
      "text": "خیلی بزنگ شد"
    },
    {
      "id": 43,
      "start": 7084.4,
      "end": 7086.4,
      "formatted_start": "01:58:04.400",
      "formatted_end": "01:58:06.400",
      "text": "ساکه سر که نداشته؟"
    },
    {
      "id": 44,
      "start": 7086.4,
      "end": 7088.4,
      "formatted_start": "01:58:06.400",
      "formatted_end": "01:58:08.400",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 7088.4,
      "end": 7090.4,
      "formatted_start": "01:58:08.400",
      "formatted_end": "01:58:10.400",
      "text": "پردات درده میکنه"
    },
    {
      "id": 46,
      "start": 7090.4,
      "end": 7092.4,
      "formatted_start": "01:58:10.400",
      "formatted_end": "01:58:12.400",
      "text": "اینجا"
    },
    {
      "id": 47,
      "start": 7092.4,
      "end": 7094.4,
      "formatted_start": "01:58:12.400",
      "formatted_end": "01:58:14.400",
      "text": "از این سندگلافی باید بردن نکنه، سنگ داری"
    },
    {
      "id": 48,
      "start": 7094.4,
      "end": 7096.4,
      "formatted_start": "01:58:14.400",
      "formatted_end": "01:58:16.400",
      "text": "گرفتم خانم دختر دختر"
    },
    {
      "id": 49,
      "start": 7096.4,
      "end": 7098.4,
      "formatted_start": "01:58:16.400",
      "formatted_end": "01:58:18.400",
      "text": "رفتم تیران خیلی بهترم خلادی"
    },
    {
      "id": 50,
      "start": 7098.4,
      "end": 7100.4,
      "formatted_start": "01:58:18.400",
      "formatted_end": "01:58:20.400",
      "text": "همینجا جواب نیومدن"
    },
    {
      "id": 51,
      "start": 7100.4,
      "end": 7102.4,
      "formatted_start": "01:58:20.400",
      "formatted_end": "01:58:22.400",
      "text": "سندگلافی کردی؟"
    },
    {
      "id": 52,
      "start": 7102.4,
      "end": 7104.4,
      "formatted_start": "01:58:22.400",
      "formatted_end": "01:58:24.400",
      "text": "آره، همه کار کردم نیومد"
    },
    {
      "id": 53,
      "start": 7104.4,
      "end": 7106.4,
      "formatted_start": "01:58:24.400",
      "formatted_end": "01:58:26.400",
      "text": "خب، اون بی کار نه، برای چی نیموندی؟"
    },
    {
      "id": 54,
      "start": 7106.4,
      "end": 7108.4,
      "formatted_start": "01:58:26.400",
      "formatted_end": "01:58:28.400",
      "text": "نیومدن همین جوابش"
    },
    {
      "id": 55,
      "start": 7108.4,
      "end": 7110.4,
      "formatted_start": "01:58:28.400",
      "formatted_end": "01:58:30.400",
      "text": "جواب نمیخواد"
    },
    {
      "id": 56,
      "start": 7110.4,
      "end": 7112.4,
      "formatted_start": "01:58:30.400",
      "formatted_end": "01:58:32.400",
      "text": "تحضیلی نه"
    },
    {
      "id": 57,
      "start": 7112.4,
      "end": 7114.4,
      "formatted_start": "01:58:32.400",
      "formatted_end": "01:58:34.400",
      "text": "اما باید همینجا جوابشو میدن"
    },
    {
      "id": 58,
      "start": 7114.4,
      "end": 7116.4,
      "formatted_start": "01:58:34.400",
      "formatted_end": "01:58:36.400",
      "text": "ببین"
    },
    {
      "id": 59,
      "start": 7116.4,
      "end": 7118.4,
      "formatted_start": "01:58:36.400",
      "formatted_end": "01:58:38.400",
      "text": "ببین"
    },
    {
      "id": 60,
      "start": 7118.4,
      "end": 7120.4,
      "formatted_start": "01:58:38.400",
      "formatted_end": "01:58:40.400",
      "text": "با کجا بابش بیاد میتونست"
    },
    {
      "id": 61,
      "start": 7122.9,
      "end": 7124.9,
      "formatted_start": "01:58:42.900",
      "formatted_end": "01:58:44.900",
      "text": "این سال رو منویسم بزنی خود؟"
    },
    {
      "id": 62,
      "start": 7124.9,
      "end": 7125.4,
      "formatted_start": "01:58:44.900",
      "formatted_end": "01:58:45.400",
      "text": "باشه"
    },
    {
      "id": 63,
      "start": 7125.4,
      "end": 7125.9,
      "formatted_start": "01:58:45.400",
      "formatted_end": "01:58:45.900",
      "text": "باشه"
    },
    {
      "id": 64,
      "start": 7125.9,
      "end": 7126.4,
      "formatted_start": "01:58:45.900",
      "formatted_end": "01:58:46.400",
      "text": "شو برم"
    },
    {
      "id": 65,
      "start": 7126.4,
      "end": 7126.9,
      "formatted_start": "01:58:46.400",
      "formatted_end": "01:58:46.900",
      "text": "شو برم"
    },
    {
      "id": 66,
      "start": 7126.9,
      "end": 7128.4,
      "formatted_start": "01:58:46.900",
      "formatted_end": "01:58:48.400",
      "text": "با کجا بابش بیاد میتونست"
    },
    {
      "id": 67,
      "start": 7128.4,
      "end": 7128.9,
      "formatted_start": "01:58:48.400",
      "formatted_end": "01:58:48.900",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 7128.9,
      "end": 7129.4,
      "formatted_start": "01:58:48.900",
      "formatted_end": "01:58:49.400",
      "text": "خوب"
    },
    {
      "id": 69,
      "start": 7129.4,
      "end": 7132.4,
      "formatted_start": "01:58:49.400",
      "formatted_end": "01:58:52.400",
      "text": "بعد یه قرصی داری میخوری برا قلبت"
    },
    {
      "id": 70,
      "start": 7132.4,
      "end": 7132.9,
      "formatted_start": "01:58:52.400",
      "formatted_end": "01:58:52.900",
      "text": "آره"
    },
    {
      "id": 71,
      "start": 7132.9,
      "end": 7136.4,
      "formatted_start": "01:58:52.900",
      "formatted_end": "01:58:56.400",
      "text": "اونو زیاد داری میخوری باید بیاری کمش کنن"
    },
    {
      "id": 72,
      "start": 7136.4,
      "end": 7138.4,
      "formatted_start": "01:58:56.400",
      "formatted_end": "01:58:58.400",
      "text": "قلبتو داره ضعیف کرده یکم"
    },
    {
      "id": 73,
      "start": 7138.4,
      "end": 7138.9,
      "formatted_start": "01:58:58.400",
      "formatted_end": "01:58:58.900",
      "text": "آره نیست"
    },
    {
      "id": 74,
      "start": 7138.9,
      "end": 7139.9,
      "formatted_start": "01:58:58.900",
      "formatted_end": "01:58:59.900",
      "text": "آوردیش؟"
    },
    {
      "id": 75,
      "start": 7139.9,
      "end": 7142.4,
      "formatted_start": "01:58:59.900",
      "formatted_end": "01:59:02.400",
      "text": "نه نه یا فراموش کرده امروز من این رو داری"
    },
    {
      "id": 76,
      "start": 7142.4,
      "end": 7143.4,
      "formatted_start": "01:59:02.400",
      "formatted_end": "01:59:03.400",
      "text": "بیارم امروز"
    },
    {
      "id": 77,
      "start": 7143.4,
      "end": 7144.4,
      "formatted_start": "01:59:03.400",
      "formatted_end": "01:59:04.400",
      "text": "خوش میدونی؟"
    },
    {
      "id": 78,
      "start": 7148.4,
      "end": 7150.4,
      "formatted_start": "01:59:08.400",
      "formatted_end": "01:59:10.400",
      "text": "برای به بایدی"
    },
    {
      "id": 79,
      "start": 7152.4,
      "end": 7154.4,
      "formatted_start": "01:59:12.400",
      "formatted_end": "01:59:14.400",
      "text": "کارو چیه؟"
    },
    {
      "id": 80,
      "start": 7162.4,
      "end": 7164.4,
      "formatted_start": "01:59:22.400",
      "formatted_end": "01:59:24.400",
      "text": "اگه خوب نشدی"
    },
    {
      "id": 81,
      "start": 7164.4,
      "end": 7166.4,
      "formatted_start": "01:59:24.400",
      "formatted_end": "01:59:26.400",
      "text": "یازماشه ایت رو همه اصلا بره خود"
    },
    {
      "id": 82,
      "start": 7166.4,
      "end": 7168.4,
      "formatted_start": "01:59:26.400",
      "formatted_end": "01:59:28.400",
      "text": "بره"
    },
    {
      "id": 83,
      "start": 7168.4,
      "end": 7170.4,
      "formatted_start": "01:59:28.400",
      "formatted_end": "01:59:30.400",
      "text": "به احتمال همه سرها همتون بزنی"
    },
    {
      "id": 84,
      "start": 7170.4,
      "end": 7172.4,
      "formatted_start": "01:59:30.400",
      "formatted_end": "01:59:32.400",
      "text": "پشت که ما تون میخوریم خوب میشه"
    },
    {
      "id": 85,
      "start": 7172.4,
      "end": 7174.4,
      "formatted_start": "01:59:32.400",
      "formatted_end": "01:59:34.400",
      "text": "همیدواری هم برای"
    },
    {
      "id": 86,
      "start": 7174.4,
      "end": 7177.4,
      "formatted_start": "01:59:34.400",
      "formatted_end": "01:59:37.400",
      "text": "جیشت می آمده تعمال می کنی؟"
    },
    {
      "id": 87,
      "start": 7177.4,
      "end": 7178.4,
      "formatted_start": "01:59:37.400",
      "formatted_end": "01:59:38.400",
      "text": "نه"
    },
    {
      "id": 88,
      "start": 7178.4,
      "end": 7179.4,
      "formatted_start": "01:59:38.400",
      "formatted_end": "01:59:39.400",
      "text": "خیلی می سوزه"
    },
    {
      "id": 89,
      "start": 7179.4,
      "end": 7180.4,
      "formatted_start": "01:59:39.400",
      "formatted_end": "01:59:40.400",
      "text": "نه می سوزه خانم"
    },
    {
      "id": 90,
      "start": 7180.4,
      "end": 7181.4,
      "formatted_start": "01:59:40.400",
      "formatted_end": "01:59:41.400",
      "text": "فقط بومیده؟"
    },
    {
      "id": 91,
      "start": 7181.4,
      "end": 7182.4,
      "formatted_start": "01:59:41.400",
      "formatted_end": "01:59:42.400",
      "text": "فقط بومیده"
    },
    {
      "id": 92,
      "start": 7182.4,
      "end": 7185.4,
      "formatted_start": "01:59:42.400",
      "formatted_end": "01:59:45.400",
      "text": "تعمال نمی کنم که برم تا اون رو برستم بومیده"
    },
    {
      "id": 93,
      "start": 7185.4,
      "end": 7186.4,
      "formatted_start": "01:59:45.400",
      "formatted_end": "01:59:46.400",
      "text": "خارش هم داری؟"
    },
    {
      "id": 94,
      "start": 7186.4,
      "end": 7187.4,
      "formatted_start": "01:59:46.400",
      "formatted_end": "01:59:47.400",
      "text": "نه نه"
    },
    {
      "id": 95,
      "start": 7187.4,
      "end": 7188.4,
      "formatted_start": "01:59:47.400",
      "formatted_end": "01:59:48.400",
      "text": "هیچ خارش نداری"
    },
    {
      "id": 96,
      "start": 7188.4,
      "end": 7191.4,
      "formatted_start": "01:59:48.400",
      "formatted_end": "01:59:51.400",
      "text": "ترش و زنانی نداری بعد می آمده؟"
    },
    {
      "id": 97,
      "start": 7191.4,
      "end": 7192.4,
      "formatted_start": "01:59:51.400",
      "formatted_end": "01:59:52.400",
      "text": "نه"
    },
    {
      "id": 98,
      "start": 7192.4,
      "end": 7193.4,
      "formatted_start": "01:59:52.400",
      "formatted_end": "01:59:53.400",
      "text": "خیلی بله"
    },
    {
      "id": 99,
      "start": 7193.4,
      "end": 7194.4,
      "formatted_start": "01:59:53.400",
      "formatted_end": "01:59:54.400",
      "text": "فقط همینم"
    },
    {
      "id": 100,
      "start": 7196.4,
      "end": 7198.4,
      "formatted_start": "01:59:56.400",
      "formatted_end": "01:59:58.400",
      "text": "خانم می فراموشه"
    }
  ],
  "status": "completed"
}