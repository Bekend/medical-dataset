      "end": 19220.0,
      "formatted_start": "05:20:00.000",
      "formatted_end": "05:20:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 19220.0,
      "end": 19222.0,
      "formatted_start": "05:20:20.000",
      "formatted_end": "05:20:22.000",
      "text": "همچنین سپ میکردن"
    },
    {
      "id": 2,
      "start": 19222.0,
      "end": 19224.0,
      "formatted_start": "05:20:22.000",
      "formatted_end": "05:20:24.000",
      "text": "اون ریزی اون رو برده میتونم"
    },
    {
      "id": 3,
      "start": 19224.0,
      "end": 19226.0,
      "formatted_start": "05:20:24.000",
      "formatted_end": "05:20:26.000",
      "text": "برده میتونم"
    },
    {
      "id": 4,
      "start": 19226.0,
      "end": 19228.0,
      "formatted_start": "05:20:26.000",
      "formatted_end": "05:20:28.000",
      "text": "برده میتونم"
    },
    {
      "id": 5,
      "start": 19228.0,
      "end": 19230.0,
      "formatted_start": "05:20:28.000",
      "formatted_end": "05:20:30.000",
      "text": "برده میتونم"
    },
    {
      "id": 6,
      "start": 19230.0,
      "end": 19232.0,
      "formatted_start": "05:20:30.000",
      "formatted_end": "05:20:32.000",
      "text": "برده میتونم"
    },
    {
      "id": 7,
      "start": 19232.0,
      "end": 19234.0,
      "formatted_start": "05:20:32.000",
      "formatted_end": "05:20:34.000",
      "text": "برده میتونم"
    },
    {
      "id": 8,
      "start": 19234.0,
      "end": 19236.0,
      "formatted_start": "05:20:34.000",
      "formatted_end": "05:20:36.000",
      "text": "برده میتونم"
    },
    {
      "id": 9,
      "start": 19236.0,
      "end": 19238.0,
      "formatted_start": "05:20:36.000",
      "formatted_end": "05:20:38.000",
      "text": "برده میتونم"
    },
    {
      "id": 10,
      "start": 19238.0,
      "end": 19240.0,
      "formatted_start": "05:20:38.000",
      "formatted_end": "05:20:40.000",
      "text": "پرده هم که نمیرن"
    },
    {
      "id": 11,
      "start": 19240.0,
      "end": 19242.0,
      "formatted_start": "05:20:40.000",
      "formatted_end": "05:20:42.000",
      "text": "آه چه گرمه"
    },
    {
      "id": 12,
      "start": 19242.0,
      "end": 19244.0,
      "formatted_start": "05:20:42.000",
      "formatted_end": "05:20:44.000",
      "text": "پرده ایشن میموردن"
    },
    {
      "id": 13,
      "start": 19244.0,
      "end": 19246.0,
      "formatted_start": "05:20:44.000",
      "formatted_end": "05:20:46.000",
      "text": "پرده هم"
    },
    {
      "id": 14,
      "start": 19246.0,
      "end": 19248.0,
      "formatted_start": "05:20:46.000",
      "formatted_end": "05:20:48.000",
      "text": "چه سطح هم که چرا اینجا نیست"
    },
    {
      "id": 15,
      "start": 19248.0,
      "end": 19250.0,
      "formatted_start": "05:20:48.000",
      "formatted_end": "05:20:50.000",
      "text": "از اینجا باید برداریم و میریم به یک صد مردم"
    },
    {
      "id": 16,
      "start": 19250.0,
      "end": 19252.0,
      "formatted_start": "05:20:50.000",
      "formatted_end": "05:20:52.000",
      "text": "چی کونسکتون رو زده؟"
    },
    {
      "id": 17,
      "start": 19252.0,
      "end": 19254.0,
      "formatted_start": "05:20:52.000",
      "formatted_end": "05:20:54.000",
      "text": "همین چیز"
    },
    {
      "id": 18,
      "start": 19254.0,
      "end": 19256.0,
      "formatted_start": "05:20:54.000",
      "formatted_end": "05:20:56.000",
      "text": "برای همین کشیتون میوییم کنم یک لعابه"
    },
    {
      "id": 19,
      "start": 19256.0,
      "end": 19258.0,
      "formatted_start": "05:20:56.000",
      "formatted_end": "05:20:58.000",
      "text": "ماشکستانی من"
    },
    {
      "id": 20,
      "start": 19258.0,
      "end": 19260.0,
      "formatted_start": "05:20:58.000",
      "formatted_end": "05:21:00.000",
      "text": "اینکه اینکه اینکه"
    },
    {
      "id": 21,
      "start": 19260.0,
      "end": 19262.0,
      "formatted_start": "05:21:00.000",
      "formatted_end": "05:21:02.000",
      "text": "کارت رو نباشم شمارکار رو نیست که بودم زدیم"
    },
    {
      "id": 22,
      "start": 19262.0,
      "end": 19264.0,
      "formatted_start": "05:21:02.000",
      "formatted_end": "05:21:04.000",
      "text": "یه هموز زد در یه روی بلیشون دارم"
    },
    {
      "id": 23,
      "start": 19264.0,
      "end": 19266.0,
      "formatted_start": "05:21:04.000",
      "formatted_end": "05:21:06.000",
      "text": "و باید برم کنم"
    },
    {
      "id": 24,
      "start": 19266.0,
      "end": 19268.0,
      "formatted_start": "05:21:06.000",
      "formatted_end": "05:21:08.000",
      "text": "چکرم این رو برست برم"
    },
    {
      "id": 25,
      "start": 19268.0,
      "end": 19270.0,
      "formatted_start": "05:21:08.000",
      "formatted_end": "05:21:10.000",
