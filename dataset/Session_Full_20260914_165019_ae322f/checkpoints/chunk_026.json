  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7827.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:27.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 7827.0,
      "end": 7829.0,
      "formatted_start": "02:10:27.000",
      "formatted_end": "02:10:29.000",
      "text": "گرگان یک ماه رفتی پیش کی؟"
    },
    {
      "id": 2,
      "start": 7829.0,
      "end": 7831.0,
      "formatted_start": "02:10:29.000",
      "formatted_end": "02:10:31.000",
      "text": "من سو نیایه دو سو ماه بودم اش"
    },
    {
      "id": 3,
      "start": 7831.0,
      "end": 7832.0,
      "formatted_start": "02:10:31.000",
      "formatted_end": "02:10:32.000",
      "text": "چی میگه؟"
    },
    {
      "id": 4,
      "start": 7832.0,
      "end": 7835.0,
      "formatted_start": "02:10:32.000",
      "formatted_end": "02:10:35.000",
      "text": "نیچی نیام، اما با علیه دیگه بزرگ شد، بیری بیانش باش"
    },
    {
      "id": 5,
      "start": 7835.0,
      "end": 7837.0,
      "formatted_start": "02:10:35.000",
      "formatted_end": "02:10:37.000",
      "text": "خب بزرگ شد"
    },
    {
      "id": 6,
      "start": 7837.0,
      "end": 7841.0,
      "formatted_start": "02:10:37.000",
      "formatted_end": "02:10:41.000",
      "text": "من اینجا کار نمیکنم، من دیگه می آمدید شیست سال گرگان کار کردم خب"
    },
    {
      "id": 7,
      "start": 7841.0,
      "end": 7844.0,
      "formatted_start": "02:10:41.000",
      "formatted_end": "02:10:44.000",
      "text": "من دیگه هر جای شما آفریک میکنم، من شیست سال مشتت بودم شیست سال گرگان بودم"
    },
    {
      "id": 8,
      "start": 7844.0,
      "end": 7846.0,
      "formatted_start": "02:10:44.000",
      "formatted_end": "02:10:46.000",
      "text": "من تمام شهر را یه را کار کردم"
    },
    {
      "id": 9,
      "start": 7846.0,
      "end": 7849.0,
      "formatted_start": "02:10:46.000",
      "formatted_end": "02:10:49.000",
      "text": "میدونم هر شهر دید در چه زمین"
    },
    {
      "id": 10,
      "start": 7849.0,
      "end": 7853.0,
      "formatted_start": "02:10:49.000",
      "formatted_end": "02:10:53.000",
      "text": "اگر تو دیدی وقت میگم آبو رو گنبت این کاری تام نفتی برو صبح دارم"
    },
    {
      "id": 11,
      "start": 7853.0,
      "end": 7857.0,
      "formatted_start": "02:10:53.000",
      "formatted_end": "02:10:57.000",
      "text": "من که به تو میگم تبیاری چون میدونم که کار را نمیافته"
    },
    {
      "id": 12,
      "start": 7857.0,
      "end": 7859.0,
      "formatted_start": "02:10:57.000",
      "formatted_end": "02:10:59.000",
      "text": "میفهمیم؟ میدونم که همینجور دارم"
    },
    {
      "id": 13,
      "start": 7859.0,
      "end": 7861.0,
      "formatted_start": "02:10:59.000",
      "formatted_end": "02:11:01.000",
      "text": "بذار اصلا اونو که انا عائد نداریم"
    },
    {
      "id": 14,
      "start": 7861.0,
      "end": 7865.0,
      "formatted_start": "02:11:01.000",
      "formatted_end": "02:11:05.000",
      "text": "این هست لیگ برو تو برای همیشه پیادت راحت میشی"
    },
    {
      "id": 15,
      "start": 7865.0,
      "end": 7869.0,
      "formatted_start": "02:11:05.000",
      "formatted_end": "02:11:09.000",
      "text": "درسته تا الان همه اش با یک کابوس داری پیش میری"
    },
    {
      "id": 16,
      "start": 7869.0,
      "end": 7873.0,
      "formatted_start": "02:11:09.000",
      "formatted_end": "02:11:13.000",
      "text": "خود بچه هم حساس میشه"
    },
    {
      "id": 17,
      "start": 7879.0,
      "end": 7889.0,
      "formatted_start": "02:11:19.000",
      "formatted_end": "02:11:29.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 7889.0,
      "end": 7899.0,
      "formatted_start": "02:11:29.000",
      "formatted_end": "02:11:39.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 7899.0,
      "end": 7929.0,
      "formatted_start": "02:11:39.000",
      "formatted_end": "02:12:09.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 20,
      "start": 7929.0,
      "end": 7931.58,
      "formatted_start": "02:12:09.000",
      "formatted_end": "02:12:11.580",
      "text": "مثلا این چیز تبش نمیگیره بخوره و بیماره"
    },
    {
      "id": 21,
      "start": 7931.58,
      "end": 7932.28,
      "formatted_start": "02:12:11.580",
      "formatted_end": "02:12:12.280",
      "text": "چه حال بود؟"
    },
    {
      "id": 22,
      "start": 7932.28,
      "end": 7934.28,
      "formatted_start": "02:12:12.280",
      "formatted_end": "02:12:14.280",
      "text": "اوه پس صبح هم حالت رو عمل داشتی؟"
    },
    {
      "id": 23,
      "start": 7934.28,
      "end": 7936.28,
      "formatted_start": "02:12:14.280",
      "formatted_end": "02:12:16.280",
      "text": "صبح نه"
    },
    {
      "id": 24,
      "start": 7936.28,
      "end": 7937.78,
      "formatted_start": "02:12:16.280",
      "formatted_end": "02:12:17.780",
      "text": "قصان استفراق نشدی؟"
    },
    {
      "id": 25,
      "start": 7937.78,
      "end": 7938.28,
      "formatted_start": "02:12:17.780",
      "formatted_end": "02:12:18.280",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 7938.28,
      "end": 7938.78,
      "formatted_start": "02:12:18.280",
      "formatted_end": "02:12:18.780",
      "text": "اسخان نشدی؟"
    },
    {
      "id": 27,
      "start": 7938.78,
      "end": 7939.28,
      "formatted_start": "02:12:18.780",
      "formatted_end": "02:12:19.280",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 7939.28,
      "end": 7941.28,
      "formatted_start": "02:12:19.280",
      "formatted_end": "02:12:21.280",
      "text": "وقتی دستشوی شکر روز خوب کنم می کرد؟"
    },
    {
      "id": 29,
      "start": 7941.28,
      "end": 7943.28,
      "formatted_start": "02:12:21.280",
      "formatted_end": "02:12:23.280",
      "text": "دستشوی خودم نه نفرد"
    },
    {
      "id": 30,
      "start": 7943.28,
      "end": 7944.28,
      "formatted_start": "02:12:23.280",
      "formatted_end": "02:12:24.280",
      "text": "از دیروز نفردی؟"
    },
    {
      "id": 31,
      "start": 7944.28,
      "end": 7944.78,
      "formatted_start": "02:12:24.280",
      "formatted_end": "02:12:24.780",
      "text": "نه"
    },
    {
      "id": 32,
      "start": 7944.78,
      "end": 7946.78,
      "formatted_start": "02:12:24.780",
      "formatted_end": "02:12:26.780",
      "text": "الان چه حالان اینجورو عذیبت میکنه؟"
    },
    {
      "id": 33,
      "start": 7946.78,
      "end": 7950.28,
      "formatted_start": "02:12:26.780",
      "formatted_end": "02:12:30.280",
      "text": "سرم درد میکنه، میدم خیلی میسوزه"
    },
    {
      "id": 34,
      "start": 7950.28,
      "end": 7952.28,
      "formatted_start": "02:12:30.280",
      "formatted_end": "02:12:32.280",
      "text": "میسوزه خب؟"
    },
    {
      "id": 35,
      "start": 7952.28,
      "end": 7954.28,
      "formatted_start": "02:12:32.280",
      "formatted_end": "02:12:34.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 36,
      "start": 7954.28,
      "end": 7956.28,
      "formatted_start": "02:12:34.280",
      "formatted_end": "02:12:36.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 37,
      "start": 7956.28,
      "end": 7958.28,
      "formatted_start": "02:12:36.280",
      "formatted_end": "02:12:38.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 38,
      "start": 7958.28,
      "end": 7960.28,
      "formatted_start": "02:12:38.280",
      "formatted_end": "02:12:40.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 39,
      "start": 7960.28,
      "end": 7962.28,
      "formatted_start": "02:12:40.280",
      "formatted_end": "02:12:42.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 40,
      "start": 7962.28,
      "end": 7964.28,
      "formatted_start": "02:12:42.280",
      "formatted_end": "02:12:44.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 41,
      "start": 7964.28,
      "end": 7966.28,
      "formatted_start": "02:12:44.280",
      "formatted_end": "02:12:46.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 42,
      "start": 7966.28,
      "end": 7968.28,
      "formatted_start": "02:12:46.280",
      "formatted_end": "02:12:48.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 43,
      "start": 7968.28,
      "end": 7970.28,
      "formatted_start": "02:12:48.280",
      "formatted_end": "02:12:50.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 44,
      "start": 7970.28,
      "end": 7972.28,
      "formatted_start": "02:12:50.280",
      "formatted_end": "02:12:52.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 45,
      "start": 7972.28,
      "end": 7974.28,
      "formatted_start": "02:12:52.280",
      "formatted_end": "02:12:54.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 46,
      "start": 7974.28,
      "end": 7976.28,
      "formatted_start": "02:12:54.280",
      "formatted_end": "02:12:56.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 47,
      "start": 7976.28,
      "end": 7978.28,
      "formatted_start": "02:12:56.280",
      "formatted_end": "02:12:58.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 48,
      "start": 7978.28,
      "end": 7980.28,
      "formatted_start": "02:12:58.280",
      "formatted_end": "02:13:00.280",
      "text": "از اینجا برداریم"
    },
    {
      "id": 49,
      "start": 7980.28,
      "end": 7982.28,
      "formatted_start": "02:13:00.280",
      "formatted_end": "02:13:02.280",
      "text": "پچه ها یکی که میگیره همه مریض هستن"
    },
    {
      "id": 50,
      "start": 7982.28,
      "end": 7984.28,
      "formatted_start": "02:13:02.280",
      "formatted_end": "02:13:04.280",
      "text": "اینجا درد دارید؟"
    },
    {
      "id": 51,
      "start": 7984.28,
      "end": 7986.28,
      "formatted_start": "02:13:04.280",
      "formatted_end": "02:13:06.280",
      "text": "بله"
    },
    {
      "id": 52,
      "start": 7986.28,
      "end": 7988.28,
      "formatted_start": "02:13:06.280",
      "formatted_end": "02:13:08.280",
      "text": "اینجا چی؟"
    },
    {
      "id": 53,
      "start": 7988.28,
      "end": 7990.28,
      "formatted_start": "02:13:08.280",
      "formatted_end": "02:13:10.280",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 7990.28,
      "end": 7992.28,
      "formatted_start": "02:13:10.280",
      "formatted_end": "02:13:12.280",
      "text": "اینجا درد دارید؟"
    },
    {
      "id": 55,
      "start": 7992.28,
      "end": 7994.28,
      "formatted_start": "02:13:12.280",
      "formatted_end": "02:13:14.280",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 7994.28,
      "end": 7996.28,
      "formatted_start": "02:13:14.280",
      "formatted_end": "02:13:16.280",
      "text": "اینجا نه"
    },
    {
      "id": 57,
      "start": 7996.28,
      "end": 7998.28,
      "formatted_start": "02:13:16.280",
      "formatted_end": "02:13:18.280",
      "text": "اینجا نه"
    },
    {
      "id": 58,
      "start": 7998.28,
      "end": 8000.28,
      "formatted_start": "02:13:18.280",
      "formatted_end": "02:13:20.280",
      "text": "اینجا نه"
    },
    {
      "id": 59,
      "start": 8000.28,
      "end": 8002.28,
      "formatted_start": "02:13:20.280",
      "formatted_end": "02:13:22.280",
      "text": "اینجا نه"
    },
    {
      "id": 60,
      "start": 8002.28,
      "end": 8004.28,
      "formatted_start": "02:13:22.280",
      "formatted_end": "02:13:24.280",
      "text": "اینجا نه"
    },
    {
      "id": 61,
      "start": 8004.28,
      "end": 8006.28,
      "formatted_start": "02:13:24.280",
      "formatted_end": "02:13:26.280",
      "text": "اینجا نه"
    },
    {
      "id": 62,
      "start": 8006.28,
      "end": 8008.28,
      "formatted_start": "02:13:26.280",
      "formatted_end": "02:13:28.280",
      "text": "اینجا نه"
    },
    {
      "id": 63,
      "start": 8008.28,
      "end": 8010.28,
      "formatted_start": "02:13:28.280",
      "formatted_end": "02:13:30.280",
      "text": "از یه ماه بیشتر هم پرگیری بزنه"
    },
    {
      "id": 64,
      "start": 8010.28,
      "end": 8014.28,
      "formatted_start": "02:13:30.280",
      "formatted_end": "02:13:34.280",
      "text": "شعبت زین کوپیت خیلی داخلند"
    },
    {
      "id": 65,
      "start": 8014.28,
      "end": 8016.28,
      "formatted_start": "02:13:34.280",
      "formatted_end": "02:13:36.280",
      "text": "اونو باشه"
    },
    {
      "id": 66,
      "start": 8016.28,
      "end": 8018.28,
      "formatted_start": "02:13:36.280",
      "formatted_end": "02:13:38.280",
      "text": "میگم بگیر نمیگم"
    },
    {
      "id": 67,
      "start": 8018.28,
      "end": 8020.28,
      "formatted_start": "02:13:38.280",
      "formatted_end": "02:13:40.280",
      "text": "اینو هزار تا میکروب داره"
    },
    {
      "id": 68,
      "start": 8020.28,
      "end": 8022.28,
      "formatted_start": "02:13:40.280",
      "formatted_end": "02:13:42.280",
      "text": "من که تو تار میزنیم"
    },
    {
      "id": 69,
      "start": 8022.28,
      "end": 8024.28,
      "formatted_start": "02:13:42.280",
      "formatted_end": "02:13:44.280",
      "text": "پایه چی بگن میکنی؟"
    },
    {
      "id": 70,
      "start": 8024.28,
      "end": 8026.28,
      "formatted_start": "02:13:44.280",
      "formatted_end": "02:13:46.280",
      "text": "شبیه دختران باشی؟"
    },
    {
      "id": 71,
      "start": 8026.28,
      "end": 8028.28,
      "formatted_start": "02:13:46.280",
      "formatted_end": "02:13:48.280",
      "text": "دوست دایی دختر باشی؟"
    },
    {
      "id": 72,
      "start": 8028.28,
      "end": 8030.28,
      "formatted_start": "02:13:48.280",
      "formatted_end": "02:13:50.280",
      "text": "نه"
    },
    {
      "id": 73,
      "start": 8030.28,
      "end": 8032.28,
      "formatted_start": "02:13:50.280",
      "formatted_end": "02:13:52.280",
      "text": "دوست دایی دختر ها باشه با من؟"
    },
    {
      "id": 74,
      "start": 8032.28,
      "end": 8034.28,
      "formatted_start": "02:13:52.280",
      "formatted_end": "02:13:54.280",
      "text": "خب بچه را، اینو بنابرای کردی"
    },
    {
      "id": 75,
      "start": 8034.28,
      "end": 8036.28,
      "formatted_start": "02:13:54.280",
      "formatted_end": "02:13:56.280",
      "text": "همین هزار تا میکروب جمع میکنه"
    },
    {
      "id": 76,
      "start": 8036.28,
      "end": 8038.28,
      "formatted_start": "02:13:56.280",
      "formatted_end": "02:13:58.280",
      "text": "نیست"
    },
    {
      "id": 77,
      "start": 8038.28,
      "end": 8040.78,
      "formatted_start": "02:13:58.280",
      "formatted_end": "02:14:00.780",
      "text": "به تو خود بتمون از خریفه کن"
    },
    {
      "id": 78,
      "start": 8040.78,
      "end": 8042.78,
      "formatted_start": "02:14:00.780",
      "formatted_end": "02:14:02.780",
      "text": "شبیه دستای دختر هستن انا آدم"
    },
    {
      "id": 79,
      "start": 8042.78,
      "end": 8044.78,
      "formatted_start": "02:14:02.780",
      "formatted_end": "02:14:04.780",
      "text": "اگه عکس بدی فکر می کنی دست دختر"
    },
    {
      "id": 80,
      "start": 8044.78,
      "end": 8046.78,
      "formatted_start": "02:14:04.780",
      "formatted_end": "02:14:06.780",
      "text": "بده دیگه"
    },
    {
      "id": 81,
      "start": 8050.78,
      "end": 8052.78,
      "formatted_start": "02:14:10.780",
      "formatted_end": "02:14:12.780",
      "text": "پردش همین"
    },
    {
      "id": 82,
      "start": 8052.78,
      "end": 8054.28,
      "formatted_start": "02:14:12.780",
      "formatted_end": "02:14:14.280",
      "text": "روزم شده نه شده؟"
    },
    {
      "id": 83,
      "start": 8054.28,
      "end": 8056.28,
      "formatted_start": "02:14:14.280",
      "formatted_end": "02:14:16.280",
      "text": "بله چرا؟ ماشاله"
    },
    {
      "id": 84,
      "start": 8056.28,
      "end": 8058.28,
      "formatted_start": "02:14:16.280",
      "formatted_end": "02:14:18.280",
      "text": "که همون سوزن خودتان ده دیگه همون یه دانه داری"
    },
    {
      "id": 85,
      "start": 8058.28,
      "end": 8060.28,
      "formatted_start": "02:14:18.280",
      "formatted_end": "02:14:20.280",
      "text": "نه همون پردش هم کرده"
    },
    {
      "id": 86,
      "start": 8060.28,
      "end": 8062.28,
      "formatted_start": "02:14:20.280",
      "formatted_end": "02:14:22.280",
      "text": "ماشاله ببین"
    },
    {
      "id": 87,
      "start": 8062.28,
      "end": 8064.28,
      "formatted_start": "02:14:22.280",
      "formatted_end": "02:14:24.280",
      "text": "در رومت معلوم بود"
    },
    {
      "id": 88,
      "start": 8064.28,
      "end": 8067.28,
      "formatted_start": "02:14:24.280",
      "formatted_end": "02:14:27.280",
      "text": "او توجه شده من. قدرش خشنگ شد."
    },
    {
      "id": 89,
      "start": 8068.28,
      "end": 8071.28,
      "formatted_start": "02:14:28.280",
      "formatted_end": "02:14:31.280",
      "text": "قدرش بلند شده همشون ناشبهند شده."
    },
    {
      "id": 90,
      "start": 8071.28,
      "end": 8072.28,
      "formatted_start": "02:14:31.280",
      "formatted_end": "02:14:32.280",
      "text": "بله بله بله."
    },
    {
      "id": 91,
      "start": 8072.28,
      "end": 8076.28,
      "formatted_start": "02:14:32.280",
      "formatted_end": "02:14:36.280",
      "text": "او همچنین قدرش بلندش بردش میره."
    },
    {
      "id": 92,
      "start": 8076.28,
      "end": 8079.28,
      "formatted_start": "02:14:36.280",
      "formatted_end": "02:14:39.280",
      "text": "میچیم نون بخورم. دو هستم."
    },
    {
      "id": 93,
      "start": 8081.28,
      "end": 8084.28,
      "formatted_start": "02:14:41.280",
      "formatted_end": "02:14:44.280",
      "text": "نونو بخوره دیگه. نون و پنیر که میتونی بخوری نون."
    },
    {
      "id": 94,
      "start": 8084.28,
      "end": 8085.28,
      "formatted_start": "02:14:44.280",
      "formatted_end": "02:14:45.280",
      "text": "او اینا بخوره نون."
    },
    {
      "id": 95,
      "start": 8085.28,
      "end": 8089.28,
      "formatted_start": "02:14:45.280",
      "formatted_end": "02:14:49.280",
