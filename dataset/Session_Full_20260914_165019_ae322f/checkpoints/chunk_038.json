  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11430.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 11430.0,
      "end": 11432.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:10:32.000",
      "text": "بهتر میشه"
    },
    {
      "id": 2,
      "start": 11432.0,
      "end": 11434.0,
      "formatted_start": "03:10:32.000",
      "formatted_end": "03:10:34.000",
      "text": "ارتحاب کرده خود"
    },
    {
      "id": 3,
      "start": 11434.0,
      "end": 11436.0,
      "formatted_start": "03:10:34.000",
      "formatted_end": "03:10:36.000",
      "text": "این یه تاندون داره به اینجا بسیار بشه"
    },
    {
      "id": 4,
      "start": 11436.0,
      "end": 11438.0,
      "formatted_start": "03:10:36.000",
      "formatted_end": "03:10:38.000",
      "text": "این ارتحاب پیدا کرده"
    },
    {
      "id": 5,
      "start": 11438.0,
      "end": 11440.0,
      "formatted_start": "03:10:38.000",
      "formatted_end": "03:10:40.000",
      "text": "این کفره خیلی درد میکنه و همینه"
    },
    {
      "id": 6,
      "start": 11440.0,
      "end": 11442.0,
      "formatted_start": "03:10:40.000",
      "formatted_end": "03:10:42.000",
      "text": "باید چیکار کنی؟"
    },
    {
      "id": 7,
      "start": 11442.0,
      "end": 11444.0,
      "formatted_start": "03:10:42.000",
      "formatted_end": "03:10:44.000",
      "text": "باید حتما تو خونه دمپایی بباشی تبیه"
    },
    {
      "id": 8,
      "start": 11444.0,
      "end": 11446.0,
      "formatted_start": "03:10:44.000",
      "formatted_end": "03:10:46.000",
      "text": "دمپایی برد اکتا از تبیه"
    },
    {
      "id": 9,
      "start": 11446.0,
      "end": 11448.0,
      "formatted_start": "03:10:46.000",
      "formatted_end": "03:10:48.000",
      "text": "بیرونم کفشت حتما تبیه باشه"
    },
    {
      "id": 10,
      "start": 11448.0,
      "end": 11450.0,
      "formatted_start": "03:10:48.000",
      "formatted_end": "03:10:50.000",
      "text": "این خوبه"
    },
    {
      "id": 11,
      "start": 11450.0,
      "end": 11452.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:10:52.000",
      "text": "این کفشت بیرزنی تبیه"
    },
    {
      "id": 12,
      "start": 11452.0,
      "end": 11454.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:54.000",
      "text": "خوب"
    },
    {
      "id": 13,
      "start": 11454.0,
      "end": 11456.0,
      "formatted_start": "03:10:54.000",
      "formatted_end": "03:10:56.000",
      "text": "در حالت در کفشت سرقا"
    },
    {
      "id": 14,
      "start": 11456.0,
      "end": 11458.0,
      "formatted_start": "03:10:56.000",
      "formatted_end": "03:10:58.000",
      "text": "از اینجا باید فرنگی بشینیم"
    },
    {
      "id": 15,
      "start": 11458.0,
      "end": 11460.0,
      "formatted_start": "03:10:58.000",
      "formatted_end": "03:11:00.000",
      "text": "اصلا تو حالت ایرانی نباید بشینی"
    },
    {
      "id": 16,
      "start": 11460.0,
      "end": 11462.0,
      "formatted_start": "03:11:00.000",
      "formatted_end": "03:11:02.000",
      "text": "رو پاشنش خیلی فشار میاد"
    },
    {
      "id": 17,
      "start": 11462.0,
      "end": 11464.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:04.000",
      "text": "چارزانو اصلا نباید بزنیم"
    },
    {
      "id": 18,
      "start": 11464.0,
      "end": 11466.0,
      "formatted_start": "03:11:04.000",
      "formatted_end": "03:11:06.000",
      "text": "ترجیحا راحت رو سردنی"
    },
    {
      "id": 19,
      "start": 11466.0,
      "end": 11468.0,
      "formatted_start": "03:11:06.000",
      "formatted_end": "03:11:08.000",
      "text": "اگه میشینی جلو در چارپای باشه"
    },
    {
      "id": 20,
      "start": 11468.0,
      "end": 11470.0,
      "formatted_start": "03:11:08.000",
      "formatted_end": "03:11:10.000",
      "text": "پاد اینجوری بالتر باشه"
    },
    {
      "id": 21,
      "start": 11470.0,
      "end": 11472.0,
      "formatted_start": "03:11:10.000",
      "formatted_end": "03:11:12.000",
      "text": "پاد نباید کشیده بشه این تانونه"
    },
    {
      "id": 22,
      "start": 11472.0,
      "end": 11474.0,
      "formatted_start": "03:11:12.000",
      "formatted_end": "03:11:14.000",
      "text": "یا ذرفی میشوید"
    },
    {
      "id": 23,
      "start": 11474.0,
      "end": 11476.0,
      "formatted_start": "03:11:14.000",
      "formatted_end": "03:11:16.000",
      "text": "غذایی درست میکنید یه چارپای کتا"
    },
    {
      "id": 24,
      "start": 11476.0,
      "end": 11478.0,
      "formatted_start": "03:11:16.000",
      "formatted_end": "03:11:18.000",
      "text": "تو آشباس بزنید و پادونو بزنید"
    },
    {
      "id": 25,
      "start": 11478.0,
      "end": 11480.0,
      "formatted_start": "03:11:18.000",
      "formatted_end": "03:11:20.000",
      "text": "با هاتون هیچ جا به جا کنید"
    },
    {
      "id": 26,
      "start": 11480.0,
      "end": 11481.0,
      "formatted_start": "03:11:20.000",
      "formatted_end": "03:11:21.000",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 11481.0,
      "end": 11483.0,
      "formatted_start": "03:11:21.000",
      "formatted_end": "03:11:23.000",
      "text": "یعنی خداحاسم آره سه چهار روزه یه"
    },
    {
      "id": 28,
      "start": 11483.0,
      "end": 11484.0,
      "formatted_start": "03:11:23.000",
      "formatted_end": "03:11:24.000",
      "text": "اصلا مادر نیم"
    },
    {
      "id": 29,
      "start": 11484.0,
      "end": 11486.0,
      "formatted_start": "03:11:24.000",
      "formatted_end": "03:11:26.000",
      "text": "با هم نشرتن دیگه نپتونم بلنشم"
    },
    {
      "id": 30,
      "start": 11486.0,
      "end": 11488.0,
      "formatted_start": "03:11:26.000",
      "formatted_end": "03:11:28.000",
      "text": "خنداتون خیلی بالاست یا نه؟"
    },
    {
      "id": 31,
      "start": 11488.0,
      "end": 11489.0,
      "formatted_start": "03:11:28.000",
      "formatted_end": "03:11:29.000",
      "text": "جا؟"
    },
    {
      "id": 32,
      "start": 11489.0,
      "end": 11490.0,
      "formatted_start": "03:11:29.000",
      "formatted_end": "03:11:30.000",
      "text": "خنداتون چقدر؟"
    },
    {
      "id": 33,
      "start": 11490.0,
      "end": 11492.0,
      "formatted_start": "03:11:30.000",
      "formatted_end": "03:11:32.000",
      "text": "خنده هم خود رو داریم"
    },
    {
      "id": 34,
      "start": 11492.0,
      "end": 11493.0,
      "formatted_start": "03:11:32.000",
      "formatted_end": "03:11:33.000",
      "text": "من نمیدونم"
    },
    {
      "id": 35,
      "start": 11493.0,
      "end": 11494.0,
      "formatted_start": "03:11:33.000",
      "formatted_end": "03:11:34.000",
      "text": "الان خیلی وقت نمیدونم"
    },
    {
      "id": 36,
      "start": 11494.0,
      "end": 11495.0,
      "formatted_start": "03:11:34.000",
      "formatted_end": "03:11:35.000",
      "text": "اصلا از مایش نمیدونم"
    },
    {
      "id": 37,
      "start": 11495.0,
      "end": 11496.0,
      "formatted_start": "03:11:35.000",
      "formatted_end": "03:11:36.000",
      "text": "اون برس همه آورده نشان بدم"
    },
    {
      "id": 38,
      "start": 11496.0,
      "end": 11498.0,
      "formatted_start": "03:11:36.000",
      "formatted_end": "03:11:38.000",
      "text": "یعنی از این میخورم"
    },
    {
      "id": 39,
      "start": 11498.0,
      "end": 11499.0,
      "formatted_start": "03:11:38.000",
      "formatted_end": "03:11:39.000",
      "text": "اولی این دیگه کنارش بود"
    },
    {
      "id": 40,
      "start": 11499.0,
      "end": 11501.0,
      "formatted_start": "03:11:39.000",
      "formatted_end": "03:11:41.000",
      "text": "یک کنارش بود، من خودم قدرش کردم"
    },
    {
      "id": 41,
      "start": 11501.0,
      "end": 11503.0,
      "formatted_start": "03:11:41.000",
      "formatted_end": "03:11:43.000",
      "text": "دیدم خیلی زیفم کرده"
    },
    {
      "id": 42,
      "start": 11503.0,
      "end": 11505.0,
      "formatted_start": "03:11:43.000",
      "formatted_end": "03:11:45.000",
      "text": "اون دشتو از این نیست"
    },
    {
      "id": 43,
      "start": 11505.0,
      "end": 11507.0,
      "formatted_start": "03:11:45.000",
      "formatted_end": "03:11:47.000",
      "text": "خب باز قدرتون بادا نرم"
    },
    {
      "id": 44,
      "start": 11507.0,
      "end": 11509.0,
      "formatted_start": "03:11:47.000",
      "formatted_end": "03:11:49.000",
      "text": "یه آزمایش بمیسام بری هم تمن اجتماعی"
    },
    {
      "id": 45,
      "start": 11509.0,
      "end": 11511.0,
      "formatted_start": "03:11:49.000",
      "formatted_end": "03:11:51.000",
      "text": "انجام بدیم خب؟"
    },
    {
      "id": 46,
      "start": 11511.0,
      "end": 11513.0,
      "formatted_start": "03:11:51.000",
      "formatted_end": "03:11:53.000",
      "text": "برم فراموش هستم از هر کار میرم"
    },
    {
      "id": 47,
      "start": 11513.0,
      "end": 11515.0,
      "formatted_start": "03:11:53.000",
      "formatted_end": "03:11:55.000",
      "text": "بر وقتی ها"
    },
    {
      "id": 48,
      "start": 11515.0,
      "end": 11517.0,
      "formatted_start": "03:11:55.000",
      "formatted_end": "03:11:57.000",
      "text": "صبح 16 منت، بس از 16.15"
    },
    {
      "id": 49,
      "start": 11517.0,
      "end": 11519.0,
      "formatted_start": "03:11:57.000",
      "formatted_end": "03:11:59.000",
      "text": "خورو بیام"
    },
    {
      "id": 50,
      "start": 11519.0,
      "end": 11521.0,
      "formatted_start": "03:11:59.000",
      "formatted_end": "03:12:01.000",
      "text": "چیزی مراقب است این نه میده مون"
    },
    {
      "id": 51,
      "start": 11521.0,
      "end": 11523.0,
      "formatted_start": "03:12:01.000",
      "formatted_end": "03:12:03.000",
      "text": "کجا میدی؟ میده خوشکنی؟"
    },
    {
      "id": 52,
      "start": 11523.0,
      "end": 11525.0,
      "formatted_start": "03:12:03.000",
      "formatted_end": "03:12:05.000",
      "text": "آره آره"
    },
    {
      "id": 53,
      "start": 11525.0,
      "end": 11527.0,
      "formatted_start": "03:12:05.000",
      "formatted_end": "03:12:07.000",
      "text": "چیزی کاری میدیدن؟"
    },
    {
      "id": 54,
      "start": 11527.0,
      "end": 11533.0,
      "formatted_start": "03:12:07.000",
      "formatted_end": "03:12:13.000",
      "text": "حالا میوزم امیدوارم این نیره را پیشان دو تا مچیش آمده اینجا با هم هم کار میده"
    },
    {
      "id": 55,
      "start": 11533.0,
      "end": 11537.0,
      "formatted_start": "03:12:13.000",
      "formatted_end": "03:12:17.000",
      "text": "این تعدیل کرد منم به صواب آدم، اون تا نفر بودیم"
    },
    {
      "id": 56,
      "start": 11537.0,
      "end": 11539.0,
      "formatted_start": "03:12:17.000",
      "formatted_end": "03:12:19.000",
      "text": "مامان آبورپاس بود؟"
    },
    {
      "id": 57,
      "start": 11539.0,
      "end": 11541.0,
      "formatted_start": "03:12:19.000",
      "formatted_end": "03:12:21.000",
      "text": "آره، آره"
    },
    {
      "id": 58,
      "start": 11541.0,
      "end": 11547.0,
      "formatted_start": "03:12:21.000",
      "formatted_end": "03:12:27.000",
      "text": "بچهاش دیگه چیز کنه، یک هفته هر چیز نمیگه، نه کارم میمانه"
    },
    {
      "id": 59,
      "start": 11547.0,
      "end": 11549.0,
      "formatted_start": "03:12:27.000",
      "formatted_end": "03:12:29.000",
      "text": "دیگه این تو مجبور شد"
    },
    {
      "id": 60,
      "start": 11549.0,
      "end": 11579.0,
      "formatted_start": "03:12:29.000",
      "formatted_end": "03:12:59.000",
