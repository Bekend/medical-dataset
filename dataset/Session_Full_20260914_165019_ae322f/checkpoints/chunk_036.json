  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10816.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:16.000",
      "text": "از میزان دارو کنید، یک دارو بشه و بزرگ بگیرید."
    },
    {
      "id": 1,
      "start": 10816.0,
      "end": 10824.0,
      "formatted_start": "03:00:16.000",
      "formatted_end": "03:00:24.000",
      "text": "اگر که گلوتریان رو بکنید، فعلا روز یک مرزی شمایی کنید"
    },
    {
      "id": 2,
      "start": 10824.0,
      "end": 10826.0,
      "formatted_start": "03:00:24.000",
      "formatted_end": "03:00:26.000",
      "text": "کدوم عدازی هم بزن میخوانید؟"
    },
    {
      "id": 3,
      "start": 10826.0,
      "end": 10827.0,
      "formatted_start": "03:00:26.000",
      "formatted_end": "03:00:27.000",
      "text": "جان؟"
    },
    {
      "id": 4,
      "start": 10827.0,
      "end": 10830.0,
      "formatted_start": "03:00:27.000",
      "formatted_end": "03:00:30.000",
      "text": "کدوم عدازی هم بزن میخوانید؟ نهار و شام؟"
    },
    {
      "id": 5,
      "start": 10830.0,
      "end": 10832.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:32.000",
      "text": "نهار و شام هم که خیلی مختصره"
    },
    {
      "id": 6,
      "start": 10832.0,
      "end": 10833.0,
      "formatted_start": "03:00:32.000",
      "formatted_end": "03:00:33.000",
      "text": "سوهانه ها؟"
    },
    {
      "id": 7,
      "start": 10833.0,
      "end": 10835.0,
      "formatted_start": "03:00:33.000",
      "formatted_end": "03:00:35.000",
      "text": "سوهانه، نهارم زیاده"
    },
    {
      "id": 8,
      "start": 10835.0,
      "end": 10836.0,
      "formatted_start": "03:00:35.000",
      "formatted_end": "03:00:36.000",
      "text": "شام چی؟"
    },
    {
      "id": 9,
      "start": 10836.0,
      "end": 10841.0,
      "formatted_start": "03:00:36.000",
      "formatted_end": "03:00:41.000",
      "text": "به بریج معمولا میخورم، اونه شامو میچه بوده، یکم نونی میمند آقا"
    },
    {
      "id": 10,
      "start": 10841.0,
      "end": 10844.0,
      "formatted_start": "03:00:41.000",
      "formatted_end": "03:00:44.000",
      "text": "که نهار و شام نهار دیشون خیلی بوده"
    },
    {
      "id": 11,
      "start": 10844.0,
      "end": 10852.0,
      "formatted_start": "03:00:44.000",
      "formatted_end": "03:00:52.000",
      "text": "خب، شما زهرتون رو کامل بخورید روز یه دونه خود، یه گرسه جدید شروع میکنم، نصف صبح، نصف شب، ببینم چجوری پیش برده"
    },
    {
      "id": 12,
      "start": 10852.0,
      "end": 10856.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:00:56.000",
      "text": "الان یه هم کش میاد، یه اون تیدم ها اونجا پستن"
    },
    {
      "id": 13,
      "start": 10856.0,
      "end": 10865.0,
      "formatted_start": "03:00:56.000",
      "formatted_end": "03:01:05.000",
      "text": "خندرشه، هماره، تره چیزی که این آب آیزا نداره، خنصاره، چاپ میکنه، اون مزه هم زرگاه اون هست"
    },
    {
      "id": 14,
      "start": 10865.0,
      "end": 10872.44,
      "formatted_start": "03:01:05.000",
      "formatted_end": "03:01:12.440",
      "text": "اگر که ببینید بازم با یک گلزه برسم اینجوری"
    },
    {
      "id": 15,
      "start": 10872.44,
      "end": 10874.54,
      "formatted_start": "03:01:12.440",
      "formatted_end": "03:01:14.540",
      "text": "چون به این گلیگلاسی باید میتونیم بدیم"
    },
    {
      "id": 16,
      "start": 10874.54,
      "end": 10876.98,
      "formatted_start": "03:01:14.540",
      "formatted_end": "03:01:16.980",
      "text": "حالا شما هنوز جهانید خب"
    },
    {
      "id": 17,
      "start": 10876.98,
      "end": 10880.08,
      "formatted_start": "03:01:16.980",
      "formatted_end": "03:01:20.080",
      "text": "ولی وقتی افراد دارن پا بزن میخوانید بزنن"
    },
    {
      "id": 18,
      "start": 10880.08,
      "end": 10882.78,
      "formatted_start": "03:01:20.080",
      "formatted_end": "03:01:22.780",
      "text": "دیگه داروی کلم بهتون میدن"
    },
    {
      "id": 19,
      "start": 10882.78,
      "end": 10884.18,
      "formatted_start": "03:01:22.780",
      "formatted_end": "03:01:24.180",
      "text": "و خیلی نمیدیم چرا؟"
    },
    {
      "id": 20,
      "start": 10884.18,
      "end": 10886.78,
      "formatted_start": "03:01:24.180",
      "formatted_end": "03:01:26.780",
      "text": "چون این دارو ها میتونن حملات رو افتقان بدن"
    },
    {
      "id": 21,
      "start": 10886.78,
      "end": 10889.74,
      "formatted_start": "03:01:26.780",
      "formatted_end": "03:01:29.740",
      "text": "زمان که از شکستگی ها به ترسیم"
    },
    {
      "id": 22,
      "start": 10889.74,
      "end": 10891.52,
      "formatted_start": "03:01:29.740",
      "formatted_end": "03:01:31.520",
      "text": "یه با آدم ها داروی افتقان بدن"
    },
    {
      "id": 23,
      "start": 10891.52,
      "end": 10892.58,
      "formatted_start": "03:01:31.520",
      "formatted_end": "03:01:32.580",
      "text": "نمیدیم"
    },
    {
      "id": 24,
      "start": 10892.58,
      "end": 10895.58,
      "formatted_start": "03:01:32.580",
      "formatted_end": "03:01:35.580",
      "text": "چون در مرد سقوط خرم می‌گیرم"
    },
    {
      "id": 25,
      "start": 10895.58,
      "end": 10903.58,
      "formatted_start": "03:01:35.580",
      "formatted_end": "03:01:43.580",
      "text": "بعد بیشتر این دارو مارد داروهای مثلا در حیثی تا پنجار"
    },
    {
      "id": 26,
      "start": 10903.58,
      "end": 10907.58,
      "formatted_start": "03:01:43.580",
      "formatted_end": "03:01:47.580",
      "text": "گلی گلی که لازمون، من با دوست پایین براتون شروع می‌کنم"
    },
    {
      "id": 27,
      "start": 10907.58,
      "end": 10911.58,
      "formatted_start": "03:01:47.580",
      "formatted_end": "03:01:51.580",
      "text": "اگه ببینم با نصف جواب ندیم بعد بهتون می‌گم کامل بخوریم"
    },
    {
      "id": 28,
      "start": 10911.58,
      "end": 10914.58,
      "formatted_start": "03:01:51.580",
      "formatted_end": "03:01:54.580",
      "text": "من چون بیمه باز بعدا داستان می‌شه دارو کم می‌اده"
    },
    {
      "id": 29,
      "start": 10914.58,
      "end": 10917.58,
      "formatted_start": "03:01:54.580",
      "formatted_end": "03:01:57.580",
      "text": "این فعلا می‌نویسم صبح و شب یه عدد"
    },
    {
      "id": 30,
      "start": 10917.58,
      "end": 10919.58,
      "formatted_start": "03:01:57.580",
      "formatted_end": "03:01:59.580",
      "text": "اما شما با نصف باز شروع کنید"
    },
    {
      "id": 31,
      "start": 10919.58,
      "end": 10923.58,
      "formatted_start": "03:01:59.580",
      "formatted_end": "03:02:03.580",
      "text": "مگه اینکه ببینیم قلب بالازد، این دارو لاغر نمی کنم"
    },
    {
      "id": 32,
      "start": 10923.58,
      "end": 10930.58,
      "formatted_start": "03:02:03.580",
      "formatted_end": "03:02:10.580",
      "text": "بعد اون ظهرتون رو که تغییر می دهم، اون داروی لاغر کننده شو حس می کنم"
    },
    {
      "id": 33,
      "start": 10930.58,
      "end": 10935.58,
      "formatted_start": "03:02:10.580",
      "formatted_end": "03:02:15.580",
      "text": "می کنم در واقع سینوریپا هزار پنج"
    },
    {
      "id": 34,
      "start": 10937.58,
      "end": 10941.58,
      "formatted_start": "03:02:17.580",
      "formatted_end": "03:02:21.580",
      "text": "یعنی یه جز ایش که لاغر می کنن، حس می کنم ببینم به کجا میرسیم"
    },
    {
      "id": 35,
      "start": 10941.58,
      "end": 10946.58,
      "formatted_start": "03:02:21.580",
      "formatted_end": "03:02:26.580",
      "text": "یعنی اون گروه تو حس شد، آراش سینوریپا شده؟"
    },
    {
      "id": 36,
      "start": 10946.58,
      "end": 10949.58,
      "formatted_start": "03:02:26.580",
      "formatted_end": "03:02:29.580",
      "text": "این همه شو شبیه همه"
    },
    {
      "id": 37,
      "start": 10949.58,
      "end": 10951.58,
      "formatted_start": "03:02:29.580",
      "formatted_end": "03:02:31.580",
      "text": "اون شو سین و ریپا"
    },
    {
      "id": 38,
      "start": 10951.58,
      "end": 10955.58,
      "formatted_start": "03:02:31.580",
      "formatted_end": "03:02:35.580",
      "text": "اون دوازده و نیمه رو بر می دانم اون خیلی لاغر می کنه"
    },
    {
      "id": 39,
      "start": 10955.58,
      "end": 10958.58,
      "formatted_start": "03:02:35.580",
      "formatted_end": "03:02:38.580",
      "text": "اون رو بر می دانم این رو می زارم"
    },
    {
      "id": 40,
      "start": 10958.58,
      "end": 10961.58,
      "formatted_start": "03:02:38.580",
      "formatted_end": "03:02:41.580",
      "text": "این رو زورا یکی بپارن؟"
    },
    {
      "id": 41,
      "start": 10961.58,
      "end": 10962.58,
      "formatted_start": "03:02:41.580",
      "formatted_end": "03:02:42.580",
      "text": "زورا یکی"
    },
    {
      "id": 42,
      "start": 10962.58,
      "end": 10964.58,
      "formatted_start": "03:02:42.580",
      "formatted_end": "03:02:44.580",
      "text": "ولی اون یکی گلی چی بفردی؟"
    },
    {
      "id": 43,
      "start": 10964.58,
      "end": 10967.58,
      "formatted_start": "03:02:44.580",
      "formatted_end": "03:02:47.580",
      "text": "گلی کلاسید سید، فردن نصف صبح و شب"
    },
    {
      "id": 44,
      "start": 10967.58,
      "end": 10971.58,
      "formatted_start": "03:02:47.580",
      "formatted_end": "03:02:51.580",
      "text": "اگه قرن بالا زد، بیشتر یه دو صبح بپارن"
    },
    {
      "id": 45,
      "start": 10971.58,
      "end": 10972.58,
      "formatted_start": "03:02:51.580",
      "formatted_end": "03:02:52.580",
      "text": "یه صبح بپارن"
    },
    {
      "id": 46,
      "start": 10972.58,
      "end": 10977.58,
      "formatted_start": "03:02:52.580",
      "formatted_end": "03:02:57.580",
      "text": "دو ماه بنیم سم یا یه ماه بنیم سم و ببینیم چجوری"
    },
    {
      "id": 47,
      "start": 10977.58,
      "end": 10979.58,
      "formatted_start": "03:02:57.580",
      "formatted_end": "03:02:59.580",
      "text": "یه ماه بنیم سم"
    },
    {
      "id": 48,
      "start": 10979.58,
      "end": 10981.58,
      "formatted_start": "03:02:59.580",
      "formatted_end": "03:03:01.580",
      "text": "چون ببینیم چطوره"
    },
    {
      "id": 49,
      "start": 10981.58,
      "end": 10983.58,
      "formatted_start": "03:03:01.580",
      "formatted_end": "03:03:03.580",
      "text": "ببینیم چی میشه"
    },
    {
      "id": 50,
      "start": 10983.58,
      "end": 10986.58,
      "formatted_start": "03:03:03.580",
      "formatted_end": "03:03:06.580",
      "text": "بعد یه ناشتا دستگاه داریم دیگه"
    },
    {
      "id": 51,
      "start": 10986.58,
      "end": 10991.58,
      "formatted_start": "03:03:06.580",
      "formatted_end": "03:03:11.580",
      "text": "بعد نزدیک اومدن اتون یه دو روز بنیم سم ببینیم چطوره"
    },
    {
      "id": 52,
      "start": 10991.58,
      "end": 10996.58,
      "formatted_start": "03:03:11.580",
      "formatted_end": "03:03:16.580",
      "text": "خیلی نباید مشکل بخواییم فقط صبحون یکی صبح و یکی صبح یکی شفت میکنیم"
    },
    {
      "id": 53,
      "start": 10996.58,
      "end": 11001.58,
      "formatted_start": "03:03:16.580",
      "formatted_end": "03:03:21.580",
      "text": "بعد با دوزه پایین شروع کردم این تا هشتاد داره من با ستی شروع کردم"
    },
    {
      "id": 54,
      "start": 11001.58,
      "end": 11008.58,
      "formatted_start": "03:03:21.580",
      "formatted_end": "03:03:28.580",
      "text": "باید چون رایت میکنید انشاءالله، بعد من این یزیون رو به دوازه بده دارم باید باید کمی کم بهتر بشیم"
    },
    {
      "id": 55,
      "start": 11008.58,
      "end": 11009.58,
      "formatted_start": "03:03:28.580",
      "formatted_end": "03:03:29.580",
      "text": "چون؟"
    },
    {
      "id": 56,
      "start": 11009.58,
      "end": 11012.58,
      "formatted_start": "03:03:29.580",
      "formatted_end": "03:03:32.580",
      "text": "بعد چی هم برام بینسیم، تیرویدم می کنم"
    },
    {
      "id": 57,
      "start": 11012.58,
      "end": 11014.58,
      "formatted_start": "03:03:32.580",
      "formatted_end": "03:03:34.580",
      "text": "چی می کنی؟"
    },
    {
      "id": 58,
      "start": 11014.58,
      "end": 11016.58,
      "formatted_start": "03:03:34.580",
      "formatted_end": "03:03:36.580",
      "text": "نوتروسیم"
    },
    {
      "id": 59,
      "start": 11016.58,
      "end": 11017.58,
      "formatted_start": "03:03:36.580",
      "formatted_end": "03:03:37.580",
      "text": "باشه"
    },
    {
      "id": 60,
      "start": 11017.58,
      "end": 11021.58,
      "formatted_start": "03:03:37.580",
      "formatted_end": "03:03:41.580",
      "text": "اونو به زبطی چی هم می خوانم بگیرم، آتروستاتین هم می خوانم"
    },
    {
      "id": 61,
      "start": 11021.58,
      "end": 11023.58,
      "formatted_start": "03:03:41.580",
      "formatted_end": "03:03:43.580",
      "text": "برای چربی"
    },
    {
      "id": 62,
      "start": 11023.58,
      "end": 11025.58,
      "formatted_start": "03:03:43.580",
      "formatted_end": "03:03:45.580",
      "text": "چیزی هم؟"
    },
    {
      "id": 63,
      "start": 11025.58,
      "end": 11027.58,
      "formatted_start": "03:03:45.580",
      "formatted_end": "03:03:47.580",
      "text": "نبای چند می کنی؟"
    },
    {
      "id": 64,
      "start": 11027.58,
      "end": 11030.58,
      "formatted_start": "03:03:47.580",
      "formatted_end": "03:03:50.580",
      "text": "نوتروسیم، پشتش نگه نگه نگاه نکردم"
    },
    {
      "id": 65,
      "start": 11030.58,
      "end": 11032.58,
      "formatted_start": "03:03:50.580",
      "formatted_end": "03:03:52.580",
      "text": "نکردم، آره نکردم، خیلی نکردم"
    },
    {
      "id": 66,
      "start": 11032.58,
      "end": 11034.58,
      "formatted_start": "03:03:52.580",
      "formatted_end": "03:03:54.580",
      "text": "سخت بودم"
    },
    {
      "id": 67,
      "start": 11034.58,
      "end": 11036.58,
      "formatted_start": "03:03:54.580",
      "formatted_end": "03:03:56.580",
      "text": "کمی که سمح میگذاریم"
    },
    {
      "id": 68,
      "start": 11038.58,
      "end": 11041.58,
      "formatted_start": "03:03:58.580",
      "formatted_end": "03:04:01.580",
      "text": "بعد من یکم به دابات زود براتون یاد میبینم"
    },
    {
      "id": 69,
      "start": 11041.58,
      "end": 11044.58,
      "formatted_start": "03:04:01.580",
      "formatted_end": "03:04:04.580",
      "text": "سخت بودم، بسیار براتون نکردم"
    },
    {
      "id": 70,
      "start": 11048.58,
      "end": 11051.58,
      "formatted_start": "03:04:08.580",
      "formatted_end": "03:04:11.580",
      "text": "قندی ها هر تا وقتی که خیلی کم هم میشن"
    },
    {
      "id": 71,
      "start": 11051.58,
      "end": 11053.58,
      "formatted_start": "03:04:11.580",
      "formatted_end": "03:04:13.580",
      "text": "اینجور ندارم، متاسفه بخاطر فیبر"
    },
    {
      "id": 72,
      "start": 11053.58,
      "end": 11056.58,
      "formatted_start": "03:04:13.580",
      "formatted_end": "03:04:16.580",
      "text": "کم میشه، بعدم خیلی ضروری بودم"
    },
    {
      "id": 73,
      "start": 11056.58,
      "end": 11069.58,
      "formatted_start": "03:04:16.580",
      "formatted_end": "03:04:29.580",
      "text": "این ها خیلی ضعیب شده، شر شده، پستابون ها درم میدیره و زن میدید، خندری این ها میخوره"
    },
    {
      "id": 74,
      "start": 11069.58,
      "end": 11072.58,
      "formatted_start": "03:04:29.580",
      "formatted_end": "03:04:32.580",
      "text": "افتاده ای اتون باید..."
    },
    {
      "id": 75,
      "start": 11072.58,
      "end": 11074.58,
      "formatted_start": "03:04:32.580",
      "formatted_end": "03:04:34.580",
      "text": "از این..."
    },
    {
      "id": 76,
      "start": 11074.58,
      "end": 11076.58,
      "formatted_start": "03:04:34.580",
      "formatted_end": "03:04:36.580",
      "text": "اشکال چایی در اینکه داریم"
    },
    {
      "id": 77,
      "start": 11076.58,
      "end": 11078.58,
      "formatted_start": "03:04:36.580",
      "formatted_end": "03:04:38.580",
      "text": "چیزم شده، چی چی شده اینجا"
    },
    {
      "id": 78,
      "start": 11078.58,
      "end": 11080.58,
      "formatted_start": "03:04:38.580",
      "formatted_end": "03:04:40.580",
      "text": "خیلی ضعیف شدم"
    },
    {
      "id": 79,
      "start": 11083.58,
      "end": 11085.58,
      "formatted_start": "03:04:43.580",
      "formatted_end": "03:04:45.580",
      "text": "این صورت هم که دیگه..."
    },
    {
      "id": 80,
      "start": 11085.58,
      "end": 11087.58,
      "formatted_start": "03:04:45.580",
      "formatted_end": "03:04:47.580",
      "text": "میگیشن ایجاد"
    },
    {
      "id": 81,
      "start": 11087.58,
      "end": 11089.58,
      "formatted_start": "03:04:47.580",
      "formatted_end": "03:04:49.580",
      "text": "برای جرای کاری بوده"
    },
    {
      "id": 82,
      "start": 11089.58,
      "end": 11091.58,
      "formatted_start": "03:04:49.580",
      "formatted_end": "03:04:51.580",
      "text": "قبل هم اگه چند کلو بوده؟ خیلی چای بوده؟"
    },
    {
      "id": 83,
      "start": 11091.58,
      "end": 11096.58,
      "formatted_start": "03:04:51.580",
      "formatted_end": "03:04:56.580",
      "text": "قبل هم که خیلی چای بودم، در اصل همه خند، آره نببید"
    },
    {
      "id": 84,
      "start": 11096.58,
      "end": 11098.58,
      "formatted_start": "03:04:56.580",
      "formatted_end": "03:04:58.580",
      "text": "نببید، هم فرشت..."
    },
    {
      "id": 85,
      "start": 11098.58,
      "end": 11100.58,
      "formatted_start": "03:04:58.580",
      "formatted_end": "03:05:00.580",
      "text": "یک شده هم از شهست و هفته"
    }
  ],
  "status": "completed"
}