    },
    {
      "id": 8,
      "start": 11116.0,
      "end": 11118.0,
      "formatted_start": "03:05:16.000",
      "formatted_end": "03:05:18.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 9,
      "start": 11118.0,
      "end": 11120.0,
      "formatted_start": "03:05:18.000",
      "formatted_end": "03:05:20.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 10,
      "start": 11120.0,
      "end": 11122.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:22.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 11,
      "start": 11122.0,
      "end": 11134.76,
      "formatted_start": "03:05:22.000",
      "formatted_end": "03:05:34.760",
      "text": "از اینکه این زهر بیبیم زرمت بخش میدونش درشوش کنیم"
    },
    {
      "id": 12,
      "start": 11134.76,
      "end": 11138.34,
      "formatted_start": "03:05:34.760",
      "formatted_end": "03:05:38.340",
      "text": "من که مردم هم، من که گیریم درشوش بیزرمت بگم"
    },
    {
      "id": 13,
      "start": 11138.34,
      "end": 11140.48,
      "formatted_start": "03:05:38.340",
      "formatted_end": "03:05:40.480",
      "text": "درشوش هم کازه پرد شده"
    },
    {
      "id": 14,
      "start": 11140.48,
      "end": 11143.24,
      "formatted_start": "03:05:40.480",
      "formatted_end": "03:05:43.240",
      "text": "یه خورد آرام بخشیدیم برشوش برم"
    },
    {
      "id": 15,
      "start": 11143.24,
      "end": 11145.46,
      "formatted_start": "03:05:43.240",
      "formatted_end": "03:05:45.460",
      "text": "داداش زهر بیبیم؟"
    },
    {
      "id": 16,
      "start": 11145.46,
      "end": 11146.62,
      "formatted_start": "03:05:45.460",
      "formatted_end": "03:05:46.620",
      "text": "زهر بیبیم"
    },
    {
      "id": 17,
      "start": 11146.62,
