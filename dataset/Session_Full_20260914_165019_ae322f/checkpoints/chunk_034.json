      "text": "اینکه هم نیست این افزایش پیش همکنش نیست، منگی رنگاش باشه، نیاز مجبور بین شد دکتر تعلیم."
    },
    {
      "id": 1,
      "start": 10209.0,
      "end": 10215.0,
      "formatted_start": "02:50:09.000",
      "formatted_end": "02:50:15.000",
      "text": "بیس ساله نبودی؟ بیس ساله نبودی. نه، نه، میردم الان چند ساله بازد، پس پنج ساله."
    },
    {
      "id": 2,
      "start": 10215.0,
      "end": 10222.0,
      "formatted_start": "02:50:15.000",
      "formatted_end": "02:50:22.000",
      "text": "یادم نیسته، اونوقع که مینه ها هم فکر کردن. الان بگرد دکترون. الان بیرون تشکر بودن."
    },
    {
      "id": 3,
      "start": 10222.0,
      "end": 10229.0,
      "formatted_start": "02:50:22.000",
      "formatted_end": "02:50:29.000",
      "text": "بعد قرصشون رو باید عوض کنید. الان قرص پسر رو باید عوض میکنید."
    },
    {
      "id": 4,
      "start": 10229.0,
      "end": 10231.0,
      "formatted_start": "02:50:29.000",
      "formatted_end": "02:50:31.000",
      "text": "گسته پسار"
    },
    {
      "id": 5,
      "start": 10231.0,
      "end": 10233.0,
      "formatted_start": "02:50:31.000",
      "formatted_end": "02:50:33.000",
      "text": "این مهدو بازده"
    },
    {
      "id": 6,
      "start": 10233.0,
      "end": 10235.0,
      "formatted_start": "02:50:33.000",
      "formatted_end": "02:50:35.000",
      "text": "پسار"
    },
    {
      "id": 7,
      "start": 10235.0,
      "end": 10237.0,
      "formatted_start": "02:50:35.000",
      "formatted_end": "02:50:37.000",
      "text": "نه این فشار هست"
    },
    {
      "id": 8,
      "start": 10237.0,
      "end": 10239.0,
      "formatted_start": "02:50:37.000",
      "formatted_end": "02:50:39.000",
      "text": "باید عوض بگو"
    },
    {
      "id": 9,
      "start": 10239.0,
      "end": 10241.0,
      "formatted_start": "02:50:39.000",
      "formatted_end": "02:50:41.000",
      "text": "اینو باید عوض کنیم"
    },
    {
      "id": 10,
      "start": 10241.0,
      "end": 10243.0,
      "formatted_start": "02:50:41.000",
      "formatted_end": "02:50:43.000",
      "text": "این جوابت نمیدونی"
    },
    {
      "id": 11,
      "start": 10243.0,
      "end": 10245.0,
      "formatted_start": "02:50:43.000",
      "formatted_end": "02:50:45.000",
      "text": "پس پشارت دازن برای باده خیلی خیلی خیلی خیلی خیلی خیلی خیلی"
    },
    {
      "id": 12,
      "start": 10245.0,
      "end": 10247.0,
      "formatted_start": "02:50:45.000",
      "formatted_end": "02:50:47.000",
      "text": "اینو سر تن اجتماع میده"
    },
    {
      "id": 13,
      "start": 10247.0,
      "end": 10249.0,
      "formatted_start": "02:50:47.000",
      "formatted_end": "02:50:49.000",
      "text": "دوما دوما میده"
    },
    {
      "id": 14,
      "start": 10249.0,
      "end": 10251.0,
      "formatted_start": "02:50:49.000",
      "formatted_end": "02:50:51.000",
      "text": "ببین تن اجتماعی"
    },
    {
      "id": 15,
      "start": 10251.0,
      "end": 10253.0,
      "formatted_start": "02:50:51.000",
      "formatted_end": "02:50:53.000",
      "text": "خدا اونو اونقدر دارو ندارن"
    },
    {
      "id": 16,
      "start": 10253.0,
      "end": 10255.0,
      "formatted_start": "02:50:53.000",
      "formatted_end": "02:50:55.000",
      "text": "خب اونو دارو قوی خواهشه نمیتونن بدن"
    },
    {
      "id": 17,
      "start": 10255.0,
      "end": 10257.0,
      "formatted_start": "02:50:55.000",
      "formatted_end": "02:50:57.000",
      "text": "چون ندارن"
    },
    {
      "id": 18,
      "start": 10257.0,
      "end": 10262.0,
      "formatted_start": "02:50:57.000",
      "formatted_end": "02:51:02.000",
      "text": "یک ماه دو ماه خوردم دیدم خیلی پاهم از اینکه پلش بودن"
    },
    {
      "id": 19,
      "start": 10262.0,
      "end": 10266.0,
      "formatted_start": "02:51:02.000",
      "formatted_end": "02:51:06.000",
      "text": "ربطه اون گفته عوض کنم گفته غیر از این نداریم"
    },
    {
      "id": 20,
      "start": 10266.0,
      "end": 10268.0,
      "formatted_start": "02:51:06.000",
      "formatted_end": "02:51:08.000",
      "text": "نداریم، تمنی اجتماعی نداریم"
    },
    {
      "id": 21,
      "start": 10268.0,
      "end": 10271.0,
      "formatted_start": "02:51:08.000",
      "formatted_end": "02:51:11.000",
      "text": "یعنی پلش نداریم، بالا دختر خانم داخلی بود"
    },
    {
      "id": 22,
      "start": 10271.0,
      "end": 10274.0,
      "formatted_start": "02:51:11.000",
      "formatted_end": "02:51:14.000",
      "text": "اونم گفت که پریز کنیم، پرس نخواست"
    },
    {
      "id": 23,
      "start": 10274.0,
      "end": 10276.0,
      "formatted_start": "02:51:14.000",
      "formatted_end": "02:51:16.000",
      "text": "در قرنمه پریز می کنیم"
    },
    {
      "id": 24,
      "start": 10276.0,
      "end": 10277.0,
      "formatted_start": "02:51:16.000",
      "formatted_end": "02:51:17.000",
      "text": "پریز می کنیم؟"
    },
    {
      "id": 25,
      "start": 10277.0,
      "end": 10278.0,
      "formatted_start": "02:51:17.000",
      "formatted_end": "02:51:18.000",
      "text": "آره"
    },
    {
      "id": 26,
      "start": 10278.0,
      "end": 10282.0,
      "formatted_start": "02:51:18.000",
      "formatted_end": "02:51:22.000",
      "text": "شیرینی شکلات، نوشابه، دل سر، هلو نه، خربازه، هنگورنه، نه نه"
    },
    {
      "id": 27,
      "start": 10282.0,
      "end": 10284.0,
      "formatted_start": "02:51:22.000",
      "formatted_end": "02:51:24.000",
      "text": "نه نه مکار نیست"
    },
    {
      "id": 28,
      "start": 10284.0,
      "end": 10286.0,
      "formatted_start": "02:51:24.000",
      "formatted_end": "02:51:26.000",
      "text": "نخوریم"
    },
    {
      "id": 29,
      "start": 10286.0,
      "end": 10289.0,
      "formatted_start": "02:51:26.000",
      "formatted_end": "02:51:29.000",
      "text": "آمدیکران الان ما برای ادامه درمانش"
    },
    {
      "id": 30,
      "start": 10289.0,
      "end": 10291.0,
      "formatted_start": "02:51:29.000",
      "formatted_end": "02:51:31.000",
      "text": "دکتر آقال باید بریم"
    },
    {
      "id": 31,
      "start": 10291.0,
      "end": 10292.0,
      "formatted_start": "02:51:31.000",
      "formatted_end": "02:51:32.000",
      "text": "دکتر آقال باید بریم؟"
    },
    {
      "id": 32,
      "start": 10292.0,
      "end": 10294.0,
      "formatted_start": "02:51:32.000",
      "formatted_end": "02:51:34.000",
      "text": "آره مهمشون باید دو سا کار ببینیم"
    },
    {
      "id": 33,
      "start": 10294.0,
      "end": 10296.0,
      "formatted_start": "02:51:34.000",
      "formatted_end": "02:51:36.000",
      "text": "ایک باید اکور برد بشه و تست ورزش"
    },
    {
      "id": 34,
      "start": 10296.0,
      "end": 10299.0,
      "formatted_start": "02:51:36.000",
      "formatted_end": "02:51:39.000",
      "text": "شاید آنجوری مجرد از این وضعی نشته باشه"
    },
    {
      "id": 35,
      "start": 10299.0,
      "end": 10300.0,
      "formatted_start": "02:51:39.000",
      "formatted_end": "02:51:40.000",
      "text": "موضوع مهمه"
    },
    {
      "id": 36,
      "start": 10300.0,
      "end": 10302.0,
      "formatted_start": "02:51:40.000",
      "formatted_end": "02:51:42.000",
      "text": "دو باید چکا بکنیم"
    },
    {
      "id": 37,
      "start": 10302.0,
      "end": 10304.0,
      "formatted_start": "02:51:42.000",
      "formatted_end": "02:51:44.000",
      "text": "که ترمین آزمایش دادیم؟"
    },
    {
      "id": 38,
      "start": 10304.0,
      "end": 10305.0,
      "formatted_start": "02:51:44.000",
      "formatted_end": "02:51:45.000",
      "text": "آزمایش؟"
    },
    {
      "id": 39,
      "start": 10305.0,
      "end": 10307.0,
      "formatted_start": "02:51:45.000",
      "formatted_end": "02:51:47.000",
      "text": "برد و بش"
    },
    {
      "id": 40,
      "start": 10307.0,
      "end": 10308.0,
      "formatted_start": "02:51:47.000",
      "formatted_end": "02:51:48.000",
      "text": "برد و بش؟"
    },
    {
      "id": 41,
      "start": 10308.0,
      "end": 10310.0,
      "formatted_start": "02:51:48.000",
      "formatted_end": "02:51:50.000",
      "text": "45"
    },
    {
      "id": 42,
      "start": 10310.0,
      "end": 10311.0,
      "formatted_start": "02:51:50.000",
      "formatted_end": "02:51:51.000",
      "text": "آه 45"
    },
    {
      "id": 43,
      "start": 10311.0,
      "end": 10313.0,
      "formatted_start": "02:51:51.000",
      "formatted_end": "02:51:53.000",
      "text": "آزمانشتو داری ببینم"
    },
    {
      "id": 44,
      "start": 10313.0,
      "end": 10314.0,
      "formatted_start": "02:51:53.000",
      "formatted_end": "02:51:54.000",
      "text": "من آزمانشتو دارم"
    },
    {
      "id": 45,
      "start": 10314.0,
      "end": 10315.0,
      "formatted_start": "02:51:54.000",
      "formatted_end": "02:51:55.000",
      "text": "خلیت خوب بود؟"
    },
    {
      "id": 46,
      "start": 10315.0,
      "end": 10317.0,
      "formatted_start": "02:51:55.000",
      "formatted_end": "02:51:57.000",
      "text": "آره گفت آزمانشت خوبه"
    },
    {
      "id": 47,
      "start": 10317.0,
      "end": 10318.0,
      "formatted_start": "02:51:57.000",
      "formatted_end": "02:51:58.000",
      "text": "گفت خوبه"
    },
    {
      "id": 48,
      "start": 10318.0,
      "end": 10319.0,
      "formatted_start": "02:51:58.000",
      "formatted_end": "02:51:59.000",
      "text": "آره"
    },
    {
      "id": 49,
      "start": 10319.0,
      "end": 10320.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:00.000",
      "text": "من دارم"
    },
    {
      "id": 50,
      "start": 10320.0,
      "end": 10321.0,
      "formatted_start": "02:52:00.000",
      "formatted_end": "02:52:01.000",
      "text": "بعد شرکتم گفت یکم بالایی"
    },
    {
      "id": 51,
      "start": 10321.0,
      "end": 10322.0,
      "formatted_start": "02:52:01.000",
      "formatted_end": "02:52:02.000",
      "text": "ببینم آزمانشتو"
    },
    {
      "id": 52,
      "start": 10322.0,
      "end": 10324.0,
      "formatted_start": "02:52:02.000",
      "formatted_end": "02:52:04.000",
      "text": "نالا چگه همه ته یردم بده"
    },
    {
      "id": 53,
      "start": 10324.0,
      "end": 10328.0,
      "formatted_start": "02:52:04.000",
      "formatted_end": "02:52:08.000",
      "text": "همه چند برام پر این روزو چیز میکردم"
    },
    {
      "id": 54,
      "start": 10328.0,
      "end": 10330.0,
      "formatted_start": "02:52:08.000",
      "formatted_end": "02:52:10.000",
      "text": "حالا کردم انداخته بود"
    },
    {
      "id": 55,
      "start": 10330.0,
      "end": 10332.0,
      "formatted_start": "02:52:10.000",
      "formatted_end": "02:52:12.000",
      "text": "برای چه سنگی ماری بود؟"
    },
    {
      "id": 56,
      "start": 10332.0,
      "end": 10336.0,
      "formatted_start": "02:52:12.000",
      "formatted_end": "02:52:16.000",
      "text": "دو تا ستا بود خب بردم"
    },
    {
      "id": 57,
      "start": 10336.0,
      "end": 10343.0,
      "formatted_start": "02:52:16.000",
      "formatted_end": "02:52:23.000",
      "text": "تو گرداری که سپ کردن اونجا میگن بیره ماهانه مریم اونجا بیره آزیبانشه سپ کنیم"
    },
    {
      "id": 58,
      "start": 10343.0,
      "end": 10344.0,
      "formatted_start": "02:52:23.000",
      "formatted_end": "02:52:24.000",
      "text": "خب همون صورت دیگه"
    },
    {
      "id": 59,
      "start": 10344.0,
      "end": 10346.0,
      "formatted_start": "02:52:24.000",
      "formatted_end": "02:52:26.000",
      "text": "آرامگه سپ کردن"
    },
    {
      "id": 60,
      "start": 10346.0,
      "end": 10349.0,
      "formatted_start": "02:52:26.000",
      "formatted_end": "02:52:29.000",
      "text": "همیشه پشارت ها بگیره چنده؟"
    },
    {
      "id": 61,
      "start": 10349.0,
      "end": 10355.0,
      "formatted_start": "02:52:29.000",
      "formatted_end": "02:52:35.000",
      "text": "همیشه پایین بارا میشه، الان مثلا چند وقت داره همیشه پولزه شوزه بسو کرده"
    },
    {
      "id": 62,
      "start": 10355.0,
      "end": 10358.0,
      "formatted_start": "02:52:35.000",
      "formatted_end": "02:52:38.000",
      "text": "الان دو که خوشحال شب یکی مخورم صبح یکی"
    },
    {
      "id": 63,
      "start": 10358.0,
      "end": 10364.0,
      "formatted_start": "02:52:38.000",
      "formatted_end": "02:52:44.000",
      "text": "اون روزو نگاه کرده یه دو هفته زیر خواهی گفت که دوازده سیزده همیشه باشه خوبه"
    },
    {
      "id": 64,
      "start": 10364.0,
      "end": 10366.0,
      "formatted_start": "02:52:44.000",
      "formatted_end": "02:52:46.000",
      "text": "حالا یه دفعه رفته بالا"
    },
    {
      "id": 65,
      "start": 10366.0,
      "end": 10368.0,
      "formatted_start": "02:52:46.000",
      "formatted_end": "02:52:48.000",
      "text": "حالا این بارسو خود؟"
    },
    {
      "id": 66,
      "start": 10368.0,
      "end": 10372.0,
      "formatted_start": "02:52:48.000",
      "formatted_end": "02:52:52.000",
      "text": "اگر فشایتون اومد پایین روزی یه دو نمیخوری"
    },
    {
      "id": 67,
      "start": 10372.0,
      "end": 10374.0,
      "formatted_start": "02:52:52.000",
      "formatted_end": "02:52:54.000",
      "text": "وگرنه فعلا روزی دوتا میخوری"
    },
    {
      "id": 68,
      "start": 10374.0,
      "end": 10379.0,
      "formatted_start": "02:52:54.000",
      "formatted_end": "02:52:59.000",
      "text": "اگر یه وقت خواهد برامی چیزی کرد به ما خبر بده که داروتو عوض کنی"
    },
    {
      "id": 69,
      "start": 10379.0,
      "end": 10381.0,
      "formatted_start": "02:52:59.000",
      "formatted_end": "02:53:01.000",
      "text": "برای همون پیش میاد بگنن"
    },
    {
      "id": 70,
      "start": 10381.0,
      "end": 10383.0,
      "formatted_start": "02:53:01.000",
      "formatted_end": "02:53:03.000",
      "text": "برای ها این باب اینکه بهت میگن"
    },
    {
      "id": 71,
      "start": 10383.0,
      "end": 10385.0,
      "formatted_start": "02:53:03.000",
      "formatted_end": "02:53:05.000",
      "text": "یه درصد کمی بعضی رو با دارو اعزاز کنی"
    },
    {
      "id": 72,
      "start": 10385.0,
      "end": 10387.0,
      "formatted_start": "02:53:05.000",
      "formatted_end": "02:53:07.000",
      "text": "دارو رو که خوردم اگه برم کرد"
    },
    {
      "id": 73,
      "start": 10387.0,
      "end": 10389.0,
      "formatted_start": "02:53:07.000",
      "formatted_end": "02:53:09.000",
      "text": "آره اگه پاهاتون برم کرد"
    },
    {
      "id": 74,
      "start": 10395.0,
      "end": 10397.0,
      "formatted_start": "02:53:15.000",
      "formatted_end": "02:53:17.000",
      "text": "این بچه هم میدونی باید نوار قلب"
    },
    {
      "id": 75,
      "start": 10397.0,
      "end": 10399.0,
      "formatted_start": "02:53:17.000",
      "formatted_end": "02:53:19.000",
      "text": "بگیرن مامانتون"
    },
    {
      "id": 76,
      "start": 10399.0,
      "end": 10401.0,
      "formatted_start": "02:53:19.000",
      "formatted_end": "02:53:21.000",
      "text": "نوار قلبم گرفت"
    },
    {
      "id": 77,
      "start": 10401.0,
      "end": 10403.0,
      "formatted_start": "02:53:21.000",
      "formatted_end": "02:53:23.000",
      "text": "گرفت داری؟"
    },
    {
      "id": 78,
      "start": 10403.0,
      "end": 10405.0,
      "formatted_start": "02:53:23.000",
      "formatted_end": "02:53:25.000",
      "text": "نه باید دارم برای خدا که آزمایشم گرفتن"
    },
    {
      "id": 79,
      "start": 10405.0,
      "end": 10407.0,
      "formatted_start": "02:53:25.000",
      "formatted_end": "02:53:27.000",
      "text": "نوار قلبم گرفتن"
    },
    {
      "id": 80,
      "start": 10407.0,
      "end": 10408.0,
      "formatted_start": "02:53:27.000",
      "formatted_end": "02:53:28.000",
      "text": "محسن ازت بزرگه؟"
    },
    {
      "id": 81,
      "start": 10408.0,
      "end": 10409.0,
      "formatted_start": "02:53:28.000",
      "formatted_end": "02:53:29.000",
      "text": "نه، تمشت و گرم"
    },
    {
      "id": 82,
      "start": 10409.0,
      "end": 10411.0,
      "formatted_start": "02:53:29.000",
      "formatted_end": "02:53:31.000",
      "text": "خب، از خوب بود"
    },
    {
      "id": 83,
      "start": 10411.0,
      "end": 10413.0,
      "formatted_start": "02:53:31.000",
      "formatted_end": "02:53:33.000",
      "text": "اونجا گفت، آقای گفت همه چیز خوبه"
    },
    {
      "id": 84,
      "start": 10413.0,
      "end": 10415.0,
      "formatted_start": "02:53:33.000",
      "formatted_end": "02:53:35.000",
      "text": "از خواهیدون نداده"
    },
    {
      "id": 85,
      "start": 10415.0,
      "end": 10419.0,
      "formatted_start": "02:53:35.000",
      "formatted_end": "02:53:39.000",
      "text": "اگه نبود دور از جمعی بختش که دور قلبش"
    },
    {
      "id": 86,
      "start": 10419.0,
      "end": 10421.0,
      "formatted_start": "02:53:39.000",
      "formatted_end": "02:53:41.000",
      "text": "آره، نداده، ولی مبارغ هم گرفت داری"
    },
    {
      "id": 87,
      "start": 10421.0,
      "end": 10425.0,
      "formatted_start": "02:53:41.000",
      "formatted_end": "02:53:45.000",
      "text": "همونجا هم دکتر طوا طوایی بری، دکتر قلبش خوبه"
    },
    {
      "id": 88,
      "start": 10425.0,
      "end": 10427.0,
      "formatted_start": "02:53:45.000",
      "formatted_end": "02:53:47.000",
      "text": "همین تمن اجتماعی بان برده"
    },
    {
      "id": 89,
      "start": 10427.0,
      "end": 10431.0,
      "formatted_start": "02:53:47.000",
      "formatted_end": "02:53:51.000",
      "text": "دکتر طوا طوایی بری"
    },
    {
      "id": 90,
      "start": 10437.0,
      "end": 10443.0,
      "formatted_start": "02:53:57.000",
      "formatted_end": "02:54:03.000",
      "text": "اینجا که دیابت داشته پرهیز نیست؟"
    },
    {
      "id": 91,
      "start": 10443.0,
      "end": 10445.0,
      "formatted_start": "02:54:03.000",
      "formatted_end": "02:54:05.000",
      "text": "نه، نه، قلن زیاد دارن"
    },
    {
      "id": 92,
      "start": 10445.0,
      "end": 10447.0,
      "formatted_start": "02:54:05.000",
      "formatted_end": "02:54:07.000",
      "text": "اصلا دیابتی هست اینجا بیمار"
    },
    {
      "id": 93,
      "start": 10447.0,
      "end": 10451.0,
      "formatted_start": "02:54:07.000",
      "formatted_end": "02:54:11.000",
      "text": "بیاییم قلن باید بارا بشم"
    },
    {
      "id": 94,
      "start": 10451.0,
      "end": 10455.0,
      "formatted_start": "02:54:11.000",
      "formatted_end": "02:54:15.000",
      "text": "قلن سماهایتون هم ششه"
    },
    {
      "id": 95,
      "start": 10455.0,
      "end": 10461.0,
      "formatted_start": "02:54:15.000",
      "formatted_end": "02:54:21.000",
      "text": "بیاییم ما دوتا داریم قلن مخفی، از نظر علمی وقتی دوتا مصبته دیگه باید بردارم"
    },
    {
      "id": 96,
      "start": 10461.0,
      "end": 10463.0,
      "formatted_start": "02:54:21.000",
      "formatted_end": "02:54:23.000",
      "text": "یک سماهای آره بوده"
    },
    {
      "id": 97,
      "start": 10463.0,
      "end": 10465.0,
      "formatted_start": "02:54:23.000",
      "formatted_end": "02:54:25.000",
      "text": "باید تنها خون بگیرم"
    },
    {
      "id": 98,
      "start": 10465.0,
      "end": 10469.0,
      "formatted_start": "02:54:25.000",
      "formatted_end": "02:54:29.000",
      "text": "پودیا شونم قند افتون کنه دیگه"
    },
    {
      "id": 99,
      "start": 10469.0,
      "end": 10472.0,
      "formatted_start": "02:54:29.000",
      "formatted_end": "02:54:32.000",
      "text": "باید کنم اشمه خون"
    },
    {
      "id": 100,
      "start": 10472.0,
      "end": 10474.0,
      "formatted_start": "02:54:32.000",
      "formatted_end": "02:54:34.000",
      "text": "شما سابقه سنگ پودیا داریم؟"
    },
    {
      "id": 101,
      "start": 10474.0,
      "end": 10475.0,
      "formatted_start": "02:54:34.000",
      "formatted_end": "02:54:35.000",
      "text": "نه"
    },
    {
      "id": 102,
      "start": 10475.0,
      "end": 10479.0,
      "formatted_start": "02:54:35.000",
      "formatted_end": "02:54:39.000",
      "text": "سنگ پودیا نداشته ولی قند و چربیش هم بالاست"
    },
    {
      "id": 103,
      "start": 10479.0,
      "end": 10482.0,
      "formatted_start": "02:54:39.000",
      "formatted_end": "02:54:42.000",
      "text": "حالا آدمش دوباره شوند که ازش نکرده"
    },
    {
      "id": 104,
      "start": 10482.0,
      "end": 10483.0,
      "formatted_start": "02:54:42.000",
      "formatted_end": "02:54:43.000",
      "text": "اونم نیست"
    },
    {
      "id": 105,
      "start": 10483.0,
      "end": 10485.0,
      "formatted_start": "02:54:43.000",
      "formatted_end": "02:54:45.000",
      "text": "اینه دیگه هم لفت باید فشه شده"
    },
    {
      "id": 106,
      "start": 10485.0,
      "end": 10487.0,
      "formatted_start": "02:54:45.000",
      "formatted_end": "02:54:47.000",
      "text": "اونا بندش هم برده است"
    },
    {
      "id": 107,
      "start": 10487.0,
      "end": 10489.0,
      "formatted_start": "02:54:47.000",
      "formatted_end": "02:54:49.000",
      "text": "سیوزمی قندو بالا میبره دیگه"
    },
    {
      "id": 108,
      "start": 10489.0,
      "end": 10491.0,
      "formatted_start": "02:54:49.000",
      "formatted_end": "02:54:51.000",
      "text": "سیوزمی کم برده بود"
    },
    {
      "id": 109,
      "start": 10491.0,
      "end": 10493.0,
      "formatted_start": "02:54:51.000",
      "formatted_end": "02:54:53.000",
      "text": "آیا گوپتن چیز داره؟"
    },
    {
      "id": 110,
      "start": 10493.0,
      "end": 10497.0,
      "formatted_start": "02:54:53.000",
      "formatted_end": "02:54:57.000",
      "text": "نه سرعتمون کمت داره با موقع ندیشی زنیم"
    }
  ],
  "status": "completed"
}