  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5108.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:08.000",
      "text": "از اینجور، منیمیس بندیوشن هستم، اونی خانمم، برای من خودم مریض شدم، اونم مریض شد."
    },
    {
      "id": 1,
      "start": 5108.0,
      "end": 5112.0,
      "formatted_start": "01:25:08.000",
      "formatted_end": "01:25:12.000",
      "text": "میبه دیشگاه بود، کمه رو مرده با پا راه نمیتونه."
    },
    {
      "id": 2,
      "start": 5112.0,
      "end": 5117.0,
      "formatted_start": "01:25:12.000",
      "formatted_end": "01:25:17.000",
      "text": "خب، نابراکسن رو که دیروز گرفتی نمیده، خب، سلکسیت بونیمیسم بگیر باز."
    },
    {
      "id": 3,
      "start": 5117.0,
      "end": 5119.0,
      "formatted_start": "01:25:17.000",
      "formatted_end": "01:25:19.000",
      "text": "مسکن قوی تره."
    },
    {
      "id": 4,
      "start": 5119.0,
      "end": 5124.0,
      "formatted_start": "01:25:19.000",
      "formatted_end": "01:25:24.000",
      "text": "آره، مسکن هست دیگه همه شو."
    },
    {
      "id": 5,
      "start": 5124.0,
      "end": 5126.0,
      "formatted_start": "01:25:24.000",
      "formatted_end": "01:25:26.000",
      "text": "از اون جوشان ها بنمیسم."
    },
    {
      "id": 6,
      "start": 5126.0,
      "end": 5129.0,
      "formatted_start": "01:25:26.000",
      "formatted_end": "01:25:29.000",
      "text": "از این ها؟ آره، بنمیسم."
    },
    {
      "id": 7,
      "start": 5129.0,
      "end": 5131.0,
      "formatted_start": "01:25:29.000",
      "formatted_end": "01:25:31.000",
      "text": "این کمک به صدا تو نمی کنه"
    },
    {
      "id": 8,
      "start": 5147.0,
      "end": 5149.0,
      "formatted_start": "01:25:47.000",
      "formatted_end": "01:25:49.000",
      "text": "خدمت شما آجید"
    },
    {
      "id": 9,
      "start": 5149.0,
      "end": 5151.0,
      "formatted_start": "01:25:49.000",
      "formatted_end": "01:25:51.000",
      "text": "دست و درد نکنم"
    },
    {
      "id": 10,
      "start": 5151.0,
      "end": 5153.0,
      "formatted_start": "01:25:51.000",
      "formatted_end": "01:25:53.000",
      "text": "سلامت باشید"
    },
    {
      "id": 11,
      "start": 5153.0,
      "end": 5155.0,
      "formatted_start": "01:25:53.000",
      "formatted_end": "01:25:55.000",
      "text": "انشالله که خوب باشین"
    },
    {
      "id": 12,
      "start": 5155.0,
      "end": 5157.0,
      "formatted_start": "01:25:55.000",
      "formatted_end": "01:25:57.000",
      "text": "خدایی کنه نتیجه بگیرم"
    },
    {
      "id": 13,
      "start": 5157.0,
      "end": 5179.0,
      "formatted_start": "01:25:57.000",
      "formatted_end": "01:26:19.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 5179.0,
      "end": 5181.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:21.000",
      "text": "سرم"
    },
    {
      "id": 15,
      "start": 5181.0,
      "end": 5183.0,
      "formatted_start": "01:26:21.000",
      "formatted_end": "01:26:23.000",
      "text": "سرم از ماست"
    },
    {
      "id": 16,
      "start": 5183.0,
      "end": 5185.0,
      "formatted_start": "01:26:23.000",
      "formatted_end": "01:26:25.000",
      "text": "سرم"
    },
    {
      "id": 17,
      "start": 5185.0,
      "end": 5187.0,
      "formatted_start": "01:26:25.000",
      "formatted_end": "01:26:27.000",
      "text": "سرم"
    },
    {
      "id": 18,
      "start": 5187.0,
      "end": 5189.0,
      "formatted_start": "01:26:27.000",
      "formatted_end": "01:26:29.000",
      "text": "بشید"
    },
    {
      "id": 19,
      "start": 5189.0,
      "end": 5191.0,
      "formatted_start": "01:26:29.000",
      "formatted_end": "01:26:31.000",
      "text": "بشید"
    },
    {
      "id": 20,
      "start": 5191.0,
      "end": 5193.0,
      "formatted_start": "01:26:31.000",
      "formatted_end": "01:26:33.000",
      "text": "بشید"
    },
    {
      "id": 21,
      "start": 5193.0,
      "end": 5195.0,
      "formatted_start": "01:26:33.000",
      "formatted_end": "01:26:35.000",
      "text": "بشید"
    },
    {
      "id": 22,
      "start": 5195.0,
      "end": 5197.0,
      "formatted_start": "01:26:35.000",
      "formatted_end": "01:26:37.000",
      "text": "بشید"
    },
    {
      "id": 23,
      "start": 5197.0,
      "end": 5199.0,
      "formatted_start": "01:26:37.000",
      "formatted_end": "01:26:39.000",
      "text": "بشید"
    },
    {
      "id": 24,
      "start": 5199.0,
      "end": 5201.0,
      "formatted_start": "01:26:39.000",
      "formatted_end": "01:26:41.000",
      "text": "بشید"
    },
    {
      "id": 25,
      "start": 5201.0,
      "end": 5203.0,
      "formatted_start": "01:26:41.000",
      "formatted_end": "01:26:43.000",
      "text": "بشید"
    },
    {
      "id": 26,
      "start": 5203.0,
      "end": 5205.0,
      "formatted_start": "01:26:43.000",
      "formatted_end": "01:26:45.000",
      "text": "بشید"
    },
    {
      "id": 27,
      "start": 5205.0,
      "end": 5207.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:47.000",
      "text": "بشید"
    },
    {
      "id": 28,
      "start": 5207.0,
      "end": 5209.0,
      "formatted_start": "01:26:47.000",
      "formatted_end": "01:26:49.000",
      "text": "خوبه شب"
    },
    {
      "id": 29,
      "start": 5210.0,
      "end": 5212.0,
      "formatted_start": "01:26:50.000",
      "formatted_end": "01:26:52.000",
      "text": "جایی نه لفته باشه"
    },
    {
      "id": 30,
      "start": 5212.0,
      "end": 5213.0,
      "formatted_start": "01:26:52.000",
      "formatted_end": "01:26:53.000",
      "text": "نه همونطور"
    },
    {
      "id": 31,
      "start": 5213.0,
      "end": 5214.0,
      "formatted_start": "01:26:53.000",
      "formatted_end": "01:26:54.000",
      "text": "آبیه"
    },
    {
      "id": 32,
      "start": 5214.0,
      "end": 5215.0,
      "formatted_start": "01:26:54.000",
      "formatted_end": "01:26:55.000",
      "text": "این؟"
    },
    {
      "id": 33,
      "start": 5215.0,
      "end": 5216.0,
      "formatted_start": "01:26:55.000",
      "formatted_end": "01:26:56.000",
      "text": "آره همینونه"
    },
    {
      "id": 34,
      "start": 5234.0,
      "end": 5235.0,
      "formatted_start": "01:27:14.000",
      "formatted_end": "01:27:15.000",
      "text": "بابا چطوره؟"
    },
    {
      "id": 35,
      "start": 5235.0,
      "end": 5236.0,
      "formatted_start": "01:27:15.000",
      "formatted_end": "01:27:16.000",
      "text": "خوبه هستم"
    },
    {
      "id": 36,
      "start": 5236.0,
      "end": 5238.0,
      "formatted_start": "01:27:16.000",
      "formatted_end": "01:27:18.000",
      "text": "خدا باشه، باید تو خدا دیگه نزده اینجوری بشه"
    },
    {
      "id": 37,
      "start": 5238.0,
      "end": 5240.0,
      "formatted_start": "01:27:18.000",
      "formatted_end": "01:27:20.000",
      "text": "یا هر دفعه با اخفانت اینجوری بشه"
    },
    {
      "id": 38,
      "start": 5240.0,
      "end": 5242.0,
      "formatted_start": "01:27:20.000",
      "formatted_end": "01:27:22.000",
      "text": "بعد پیرها یه دفعه میره تو شد"
    },
    {
      "id": 39,
      "start": 5242.0,
      "end": 5244.0,
      "formatted_start": "01:27:22.000",
      "formatted_end": "01:27:24.000",
      "text": "میره تو کنو"
    },
    {
      "id": 40,
      "start": 5244.0,
      "end": 5246.0,
      "formatted_start": "01:27:24.000",
      "formatted_end": "01:27:26.000",
      "text": "پیر اینجوریه مثل بچه هست"
    },
    {
      "id": 41,
      "start": 5246.0,
      "end": 5248.0,
      "formatted_start": "01:27:26.000",
      "formatted_end": "01:27:28.000",
      "text": "مثل نوزار پیر"
    },
    {
      "id": 42,
      "start": 5248.0,
      "end": 5250.0,
      "formatted_start": "01:27:28.000",
      "formatted_end": "01:27:30.000",
      "text": "خاندو بیتر من این روسته برنامه کارو بریفتم"
    },
    {
      "id": 43,
      "start": 5250.0,
      "end": 5252.0,
      "formatted_start": "01:27:30.000",
      "formatted_end": "01:27:32.000",
      "text": "خاندو بیتر من این روسته برنامه کارو بریفتم"
    },
    {
      "id": 44,
      "start": 5252.0,
      "end": 5254.0,
      "formatted_start": "01:27:32.000",
      "formatted_end": "01:27:34.000",
      "text": "خاندو بیتر من این روسته برنامه کارو بریفتم"
    },
    {
      "id": 45,
      "start": 5254.0,
      "end": 5256.0,
      "formatted_start": "01:27:34.000",
      "formatted_end": "01:27:36.000",
      "text": "یک روزی به شهر"
    },
    {
      "id": 46,
      "start": 5256.0,
      "end": 5258.0,
      "formatted_start": "01:27:36.000",
      "formatted_end": "01:27:38.000",
      "text": "از این دو نیزه این هم دیور گل می دسته"
    },
    {
      "id": 47,
      "start": 5258.0,
      "end": 5260.0,
      "formatted_start": "01:27:38.000",
      "formatted_end": "01:27:40.000",
      "text": "آخریه"
    },
    {
      "id": 48,
      "start": 5260.0,
      "end": 5262.0,
      "formatted_start": "01:27:40.000",
      "formatted_end": "01:27:42.000",
      "text": "لزارتان ویست و پنج"
    },
    {
      "id": 49,
      "start": 5262.0,
      "end": 5264.0,
      "formatted_start": "01:27:42.000",
      "formatted_end": "01:27:44.000",
      "text": "دیور گل نداشته؟"
    },
    {
      "id": 50,
      "start": 5264.0,
      "end": 5266.0,
      "formatted_start": "01:27:44.000",
      "formatted_end": "01:27:46.000",
      "text": "این لزار ویست و پنجه واسه فشاره نه"
    },
    {
      "id": 51,
      "start": 5266.0,
      "end": 5268.0,
      "formatted_start": "01:27:46.000",
      "formatted_end": "01:27:48.000",
      "text": "دیور گل خیلی نداشته"
    },
    {
      "id": 52,
      "start": 5268.0,
      "end": 5270.0,
      "formatted_start": "01:27:48.000",
      "formatted_end": "01:27:50.000",
      "text": "خب بزار بگم"
    },
    {
      "id": 53,
      "start": 5270.0,
      "end": 5272.0,
      "formatted_start": "01:27:50.000",
      "formatted_end": "01:27:52.000",
      "text": "لزارتان داری خونه؟"
    },
    {
      "id": 54,
      "start": 5272.0,
      "end": 5274.0,
      "formatted_start": "01:27:52.000",
      "formatted_end": "01:27:54.000",
      "text": "کبد چرب نداری؟"
    },
    {
      "id": 55,
      "start": 5274.0,
      "end": 5276.0,
      "formatted_start": "01:27:54.000",
      "formatted_end": "01:27:56.000",
      "text": "خب بس بکرده یک کبد چرب"
    },
    {
      "id": 56,
      "start": 5276.0,
      "end": 5278.0,
      "formatted_start": "01:27:56.000",
      "formatted_end": "01:27:58.000",
      "text": "آتو واسه تیری ویست هم داره"
    },
    {
      "id": 57,
      "start": 5278.0,
      "end": 5280.0,
      "formatted_start": "01:27:58.000",
      "formatted_end": "01:28:00.000",
      "text": "کله الان دیور گل خونه داره؟"
    },
    {
      "id": 58,
      "start": 5280.0,
      "end": 5282.0,
      "formatted_start": "01:28:00.000",
      "formatted_end": "01:28:02.000",
      "text": "این ها رو گفت نمیکنم"
    },
    {
      "id": 59,
      "start": 5282.0,
      "end": 5285.0,
      "formatted_start": "01:28:02.000",
      "formatted_end": "01:28:05.000",
      "text": "چون گویید لیبرگورد رو بده"
    },
    {
      "id": 60,
      "start": 5285.0,
      "end": 5287.0,
      "formatted_start": "01:28:05.000",
      "formatted_end": "01:28:07.000",
      "text": "الان اگه سادن خونه لیبرگورد رو باید استفاده؟"
    },
    {
      "id": 61,
      "start": 5287.0,
      "end": 5288.0,
      "formatted_start": "01:28:07.000",
      "formatted_end": "01:28:08.000",
      "text": "خونه رو دارم"
    },
    {
      "id": 62,
      "start": 5288.0,
      "end": 5290.0,
      "formatted_start": "01:28:08.000",
      "formatted_end": "01:28:10.000",
      "text": "خب بزرگ پس بعد اصلاحش میکنی"
    },
    {
      "id": 63,
      "start": 5290.0,
      "end": 5291.0,
      "formatted_start": "01:28:10.000",
      "formatted_end": "01:28:11.000",
      "text": "لوزارتان رو بشه"
    },
    {
      "id": 64,
      "start": 5291.0,
      "end": 5293.0,
      "formatted_start": "01:28:11.000",
      "formatted_end": "01:28:13.000",
      "text": "لوزارتان رو داری خونه؟"
    },
    {
      "id": 65,
      "start": 5293.0,
      "end": 5294.0,
      "formatted_start": "01:28:13.000",
      "formatted_end": "01:28:14.000",
      "text": "لوزارتان رو بشه"
    },
    {
      "id": 66,
      "start": 5294.0,
      "end": 5297.0,
      "formatted_start": "01:28:14.000",
      "formatted_end": "01:28:17.000",
      "text": "خب اگه لوزارتان رو بشه، لیبرگورد رو برده"
    },
    {
      "id": 67,
      "start": 5297.0,
      "end": 5299.0,
      "formatted_start": "01:28:17.000",
      "formatted_end": "01:28:19.000",
      "text": "لیبرگورد رو دارم"
    },
    {
      "id": 68,
      "start": 5299.0,
      "end": 5300.0,
      "formatted_start": "01:28:19.000",
      "formatted_end": "01:28:20.000",
      "text": "چرا نگیره؟"
    },
    {
      "id": 69,
      "start": 5300.0,
      "end": 5302.0,
      "formatted_start": "01:28:20.000",
      "formatted_end": "01:28:22.000",
      "text": "پایین گرفته یه زنگ بزن بشه"
    },
    {
      "id": 70,
      "start": 5302.0,
      "end": 5304.0,
      "formatted_start": "01:28:22.000",
      "formatted_end": "01:28:24.000",
      "text": "بهشون دهی میدنم، پایین گرفتی؟"
    },
    {
      "id": 71,
      "start": 5304.0,
      "end": 5305.0,
      "formatted_start": "01:28:24.000",
      "formatted_end": "01:28:25.000",
      "text": "باشه"
    },
    {
      "id": 72,
      "start": 5305.0,
      "end": 5307.0,
      "formatted_start": "01:28:25.000",
      "formatted_end": "01:28:27.000",
      "text": "بگو بزنگ بزن و بشو بزن"
    },
    {
      "id": 73,
      "start": 5307.0,
      "end": 5309.0,
      "formatted_start": "01:28:27.000",
      "formatted_end": "01:28:29.000",
      "text": "نقد لازیه باید"
    },
    {
      "id": 74,
      "start": 5309.0,
      "end": 5311.0,
      "formatted_start": "01:28:29.000",
      "formatted_end": "01:28:31.000",
      "text": "بچه خیلی اصفه بود"
    },
    {
      "id": 75,
      "start": 5311.0,
      "end": 5315.0,
      "formatted_start": "01:28:31.000",
      "formatted_end": "01:28:35.000",
      "text": "کندم یه کنه نداریم همشه زیر بودم کنم"
    },
    {
      "id": 76,
      "start": 5315.0,
      "end": 5319.0,
      "formatted_start": "01:28:35.000",
      "formatted_end": "01:28:39.000",
      "text": "بخوای بخری دوانو بگیزم"
    },
    {
      "id": 77,
      "start": 5319.0,
      "end": 5323.0,
      "formatted_start": "01:28:39.000",
      "formatted_end": "01:28:43.000",
      "text": "این مریض در اینجا این مریض ده؟"
    },
    {
      "id": 78,
      "start": 5323.0,
      "end": 5325.0,
      "formatted_start": "01:28:43.000",
      "formatted_end": "01:28:45.000",
      "text": "نه نه نه"
    },
    {
      "id": 79,
      "start": 5325.0,
      "end": 5328.0,
      "formatted_start": "01:28:45.000",
      "formatted_end": "01:28:48.000",
      "text": "این مریض بشه چکاو کامل داشت و بعدها انفریناشو بر اولین بار ما سبت کنیم"
    },
    {
      "id": 80,
      "start": 5328.0,
      "end": 5331.0,
      "formatted_start": "01:28:48.000",
      "formatted_end": "01:28:51.000",
      "text": "بچه ای ایران نشان داشت برنامه"
    },
    {
      "id": 81,
      "start": 5331.0,
      "end": 5333.0,
      "formatted_start": "01:28:51.000",
      "formatted_end": "01:28:53.000",
      "text": "خوب"
    },
    {
      "id": 82,
      "start": 5333.0,
      "end": 5336.5,
      "formatted_start": "01:28:53.000",
      "formatted_end": "01:28:56.500",
      "text": "خب بزرگ بگیرم این نشاندار رو دو دستن خب"
    },
    {
      "id": 83,
      "start": 5336.5,
      "end": 5342.5,
      "formatted_start": "01:28:56.500",
      "formatted_end": "01:29:02.500",
      "text": "اگه نشاندار باشه که تا حالا کلا پرورده ارسالین نداشته باشه باید بازم بره اداره"
    },
    {
      "id": 84,
      "start": 5342.5,
      "end": 5343.34,
      "formatted_start": "01:29:02.500",
      "formatted_end": "01:29:03.340",
      "text": "باز باشم بزنم"
    },
    {
      "id": 85,
      "start": 5343.34,
      "end": 5345.2,
      "formatted_start": "01:29:03.340",
      "formatted_end": "01:29:05.200",
      "text": "آبه بزنم خورم این رو انجام کنم"
    },
    {
      "id": 86,
      "start": 5345.2,
      "end": 5345.9,
      "formatted_start": "01:29:05.200",
      "formatted_end": "01:29:05.900",
      "text": "ارسالین میشه"
    },
    {
      "id": 87,
      "start": 5345.9,
      "end": 5348.2,
      "formatted_start": "01:29:05.900",
      "formatted_end": "01:29:08.200",
      "text": "شاید تنها ترد نشست"
    },
    {
      "id": 88,
      "start": 5348.2,
      "end": 5350.78,
      "formatted_start": "01:29:08.200",
      "formatted_end": "01:29:10.780",
      "text": "خب کامبای چی شد از این؟"
    },
    {
      "id": 89,
      "start": 5350.78,
      "end": 5351.58,
      "formatted_start": "01:29:10.780",
      "formatted_end": "01:29:11.580",
      "text": "من این کامبای میگم"
    },
    {
      "id": 90,
      "start": 5351.58,
      "end": 5352.88,
      "formatted_start": "01:29:11.580",
      "formatted_end": "01:29:12.880",
      "text": "من این کامبای میشم"
    },
    {
      "id": 91,
      "start": 5352.88,
      "end": 5357.18,
      "formatted_start": "01:29:12.880",
      "formatted_end": "01:29:17.180",
      "text": "من بازا یه نشاندارتی دارم از جزه تصادف کردم"
    },
    {
      "id": 92,
      "start": 5357.18,
      "end": 5359.18,
      "formatted_start": "01:29:17.180",
      "formatted_end": "01:29:19.180",
      "text": "چی هست ازت دادی؟"
    },
    {
      "id": 93,
      "start": 5359.18,
      "end": 5361.18,
      "formatted_start": "01:29:19.180",
      "formatted_end": "01:29:21.180",
      "text": "من دست آمد شدم"
    },
    {
      "id": 94,
      "start": 5361.18,
      "end": 5363.18,
      "formatted_start": "01:29:21.180",
      "formatted_end": "01:29:23.180",
      "text": "از اون زمان؟"
    },
    {
      "id": 95,
      "start": 5363.18,
      "end": 5367.18,
      "formatted_start": "01:29:23.180",
      "formatted_end": "01:29:27.180",
      "text": "من همینجا فشارم برای و بعد بگیر کردم چربه اونو"
    },
    {
      "id": 96,
      "start": 5367.18,
      "end": 5369.18,
      "formatted_start": "01:29:27.180",
      "formatted_end": "01:29:29.180",
      "text": "بعد خوز پره فشار میخوری؟"
    },
    {
      "id": 97,
      "start": 5369.18,
      "end": 5371.18,
      "formatted_start": "01:29:29.180",
      "formatted_end": "01:29:31.180",
      "text": "آره"
    },
    {
      "id": 98,
      "start": 5371.18,
      "end": 5373.18,
      "formatted_start": "01:29:31.180",
      "formatted_end": "01:29:33.180",
      "text": "چی میخوری؟"
    },
    {
      "id": 99,
      "start": 5373.18,
      "end": 5375.18,
      "formatted_start": "01:29:33.180",
      "formatted_end": "01:29:35.180",
      "text": "دوزار بارم، بیسه پنج"
    },
    {
      "id": 100,
      "start": 5375.18,
      "end": 5377.18,
      "formatted_start": "01:29:35.180",
      "formatted_end": "01:29:37.180",
      "text": "پس آمدم اینجا فرش ما چیزش کردیم"
    },
    {
      "id": 101,
      "start": 5377.18,
      "end": 5379.18,
      "formatted_start": "01:29:37.180",
      "formatted_end": "01:29:39.180",
      "text": "گفتی قدیبترشو بخور"
    },
    {
      "id": 102,
      "start": 5379.18,
      "end": 5381.18,
      "formatted_start": "01:29:39.180",
      "formatted_end": "01:29:41.180",
      "text": "اونو میخوردم"
    },
    {
      "id": 103,
      "start": 5381.18,
      "end": 5383.18,
      "formatted_start": "01:29:41.180",
      "formatted_end": "01:29:43.180",
      "text": "بعد دیدم نه"
    },
    {
      "id": 104,
      "start": 5383.18,
      "end": 5385.18,
      "formatted_start": "01:29:43.180",
      "formatted_end": "01:29:45.180",
      "text": "در پیشن باید گرفتم آن دوزار بیسه پنج"
    },
    {
      "id": 105,
      "start": 5385.18,
      "end": 5387.18,
      "formatted_start": "01:29:45.180",
      "formatted_end": "01:29:47.180",
      "text": "اوه، خوره خوبه"
    },
    {
      "id": 106,
      "start": 5387.18,
      "end": 5389.18,
      "formatted_start": "01:29:47.180",
      "formatted_end": "01:29:49.180",
      "text": "خوبه لنکو بالاه باز"
    },
    {
      "id": 107,
      "start": 5389.18,
      "end": 5391.18,
      "formatted_start": "01:29:49.180",
      "formatted_end": "01:29:51.180",
      "text": "نه صبح نخوره باید"
    },
    {
      "id": 108,
      "start": 5391.18,
      "end": 5393.18,
      "formatted_start": "01:29:51.180",
      "formatted_end": "01:29:53.180",
      "text": "نه صبح نخوره باید"
    },
    {
      "id": 109,
      "start": 5393.18,
      "end": 5395.18,
      "formatted_start": "01:29:53.180",
      "formatted_end": "01:29:55.180",
      "text": "نه صبح نخوره باید"
    },
    {
      "id": 110,
      "start": 5395.18,
      "end": 5397.18,
      "formatted_start": "01:29:55.180",
      "formatted_end": "01:29:57.180",
      "text": "خواهدن باز باید چی کار کنی؟"
    },
    {
      "id": 111,
      "start": 5397.18,
      "end": 5399.18,
      "formatted_start": "01:29:57.180",
      "formatted_end": "01:29:59.180",
      "text": "قوی کنی؟ بگی سردن بیشون بگی؟"
    },
    {
      "id": 112,
      "start": 5399.18,
      "end": 5401.18,
      "formatted_start": "01:29:59.180",
      "formatted_end": "01:30:01.180",
      "text": "نه بگی یه ازمش کنی"
    }
  ],
  "status": "completed"
}