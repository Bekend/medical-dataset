  "stt_segments": [
    {
      "id": 0,
      "start": 14400.0,
      "end": 14411.0,
      "formatted_start": "04:00:00.000",
      "formatted_end": "04:00:11.000",
      "text": "طبیعی، شما یکی او دو روز لکبی میداشتید، مطمئن یک جنین باید به سرنشن میخورید، یعنی چهار هفته، یعنی موقعی که میچسبه به دیوار رهنگ، اون باید طبیعیه."
    },
    {
      "id": 1,
      "start": 14411.0,
      "end": 14416.68,
      "formatted_start": "04:00:11.000",
      "formatted_end": "04:00:16.680",
      "text": "حالا بعدش اگه ادامه بده کنیم میشه تعدید به صرف موقعی جا پشش موتو باشه موقعی پوچ باشه"
    },
    {
      "id": 2,
      "start": 14416.68,
      "end": 14417.84,
      "formatted_start": "04:00:16.680",
      "formatted_end": "04:00:17.840",
      "text": "هزار یک دستان"
    },
    {
      "id": 3,
      "start": 14417.84,
      "end": 14419.18,
      "formatted_start": "04:00:17.840",
      "formatted_end": "04:00:19.180",
      "text": "حالا بسا ببینیم چی میشه"
    },
    {
      "id": 4,
      "start": 14419.18,
      "end": 14420.88,
      "formatted_start": "04:00:19.180",
      "formatted_end": "04:00:20.880",
      "text": "حالا از این هم فکرمون جا نکنه"
    },
    {
      "id": 5,
      "start": 14420.88,
      "end": 14422.48,
      "formatted_start": "04:00:20.880",
      "formatted_end": "04:00:22.480",
      "text": "تا ببینیم چی خدا میخواد"
    },
    {
      "id": 6,
      "start": 14422.48,
      "end": 14425.52,
      "formatted_start": "04:00:22.480",
      "formatted_end": "04:00:25.520",
      "text": "بس ما اگه این چی نبود داراشه ساده کنیم"
    },
    {
      "id": 7,
      "start": 14425.52,
      "end": 14427.46,
      "formatted_start": "04:00:25.520",
      "formatted_end": "04:00:27.460",
      "text": "نبود چی کنیم برای از میباشیم"
    },
    {
      "id": 8,
      "start": 14427.46,
      "end": 14430.42,
      "formatted_start": "04:00:27.460",
      "formatted_end": "04:00:30.420",
      "text": "ببینیم چی نبود داراشه بکنیم تا موقعیم"
    },
    {
      "id": 9,
      "start": 14430.42,
      "end": 14431.02,
      "formatted_start": "04:00:30.420",
      "formatted_end": "04:00:31.020",
      "text": "اگه این چی"
    },
    {
      "id": 10,
      "start": 14431.02,
      "end": 14433.02,
      "formatted_start": "04:00:31.020",
      "formatted_end": "04:00:33.020",
      "text": "خورسه چربی رو نگیرد و بخیر رو بگیرید"
    },
    {
      "id": 11,
      "start": 14433.02,
      "end": 14437.02,
      "formatted_start": "04:00:33.020",
      "formatted_end": "04:00:37.020",
      "text": "بعد فقط اگه بود براش سرمو بگیرید"
    },
    {
      "id": 12,
      "start": 14437.02,
      "end": 14441.02,
      "formatted_start": "04:00:37.020",
      "formatted_end": "04:00:41.020",
      "text": "ببینیم که چون خونه افتاده تعدیب به صرف نماشه"
    },
    {
      "id": 13,
      "start": 14441.02,
      "end": 14444.02,
      "formatted_start": "04:00:41.020",
      "formatted_end": "04:00:44.020",
      "text": "مثلا ساکه حملگی نرمال باشه"
    },
    {
      "id": 14,
      "start": 14444.02,
      "end": 14448.02,
      "formatted_start": "04:00:44.020",
      "formatted_end": "04:00:48.020",
      "text": "ولی خونه زیر داشته باشی و اشیا پرشستان به دیگه صد مزدق باشه"
    },
    {
      "id": 15,
      "start": 14448.02,
      "end": 14451.02,
      "formatted_start": "04:00:48.020",
      "formatted_end": "04:00:51.020",
      "text": "بله؟ آمواله باشه من؟ نه"
    },
    {
      "id": 16,
      "start": 14451.02,
      "end": 14454.02,
      "formatted_start": "04:00:51.020",
      "formatted_end": "04:00:54.020",
      "text": "ببینیم که اون رو دیگه بر من نرم باید بگیریم"
    },
    {
      "id": 17,
      "start": 14454.02,
      "end": 14455.02,
      "formatted_start": "04:00:54.020",
      "formatted_end": "04:00:55.020",
      "text": "خیلی ممنون"
    },
    {
      "id": 18,
      "start": 14455.02,
      "end": 14456.02,
      "formatted_start": "04:00:55.020",
      "formatted_end": "04:00:56.020",
      "text": "سه ها نرم باشیم"
    },
    {
      "id": 19,
      "start": 14456.02,
      "end": 14457.02,
      "formatted_start": "04:00:56.020",
      "formatted_end": "04:00:57.020",
      "text": "همش خواهید"
    },
    {
      "id": 20,
      "start": 14457.02,
      "end": 14487.02,
      "formatted_start": "04:00:57.020",
      "formatted_end": "04:01:27.020",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 21,
      "start": 14487.02,
      "end": 14489.02,
      "formatted_start": "04:01:27.020",
      "formatted_end": "04:01:29.020",
      "text": "برای اینجا باید بردارید"
    },
    {
      "id": 22,
      "start": 14489.02,
      "end": 14491.02,
      "formatted_start": "04:01:29.020",
      "formatted_end": "04:01:31.020",
      "text": "سلام خوانده"
    },
    {
      "id": 23,
      "start": 14491.02,
      "end": 14493.02,
      "formatted_start": "04:01:31.020",
      "formatted_end": "04:01:33.020",
      "text": "سلام خوانده"
    },
    {
      "id": 24,
      "start": 14495.02,
      "end": 14497.02,
      "formatted_start": "04:01:35.020",
      "formatted_end": "04:01:37.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 25,
      "start": 14497.02,
      "end": 14499.02,
      "formatted_start": "04:01:37.020",
      "formatted_end": "04:01:39.020",
      "text": "سلام خوانده"
    },
    {
      "id": 26,
      "start": 14499.02,
      "end": 14501.02,
      "formatted_start": "04:01:39.020",
      "formatted_end": "04:01:41.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 27,
      "start": 14501.02,
      "end": 14503.02,
      "formatted_start": "04:01:41.020",
      "formatted_end": "04:01:43.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 28,
      "start": 14503.02,
      "end": 14505.02,
      "formatted_start": "04:01:43.020",
      "formatted_end": "04:01:45.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 29,
      "start": 14505.02,
      "end": 14507.02,
      "formatted_start": "04:01:45.020",
      "formatted_end": "04:01:47.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 30,
      "start": 14507.02,
      "end": 14509.02,
      "formatted_start": "04:01:47.020",
      "formatted_end": "04:01:49.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 31,
      "start": 14509.02,
      "end": 14511.02,
      "formatted_start": "04:01:49.020",
      "formatted_end": "04:01:51.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 32,
      "start": 14511.02,
      "end": 14513.02,
      "formatted_start": "04:01:51.020",
      "formatted_end": "04:01:53.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 33,
      "start": 14513.02,
      "end": 14515.02,
      "formatted_start": "04:01:53.020",
      "formatted_end": "04:01:55.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 34,
      "start": 14515.02,
      "end": 14517.02,
      "formatted_start": "04:01:55.020",
      "formatted_end": "04:01:57.020",
      "text": "خوبه هستی؟"
    },
    {
      "id": 35,
      "start": 14517.02,
      "end": 14523.02,
      "formatted_start": "04:01:57.020",
      "formatted_end": "04:02:03.020",
      "text": "از که گرفتم جوابان میخوایم که مشمار داریم"
    },
    {
      "id": 36,
      "start": 14523.02,
      "end": 14525.02,
      "formatted_start": "04:02:03.020",
      "formatted_end": "04:02:05.020",
      "text": "تو چه هایی داری؟"
    },
    {
      "id": 37,
      "start": 14525.02,
      "end": 14527.02,
      "formatted_start": "04:02:05.020",
      "formatted_end": "04:02:07.020",
      "text": "مادرم بود و مشه داره"
    },
    {
      "id": 38,
      "start": 14527.02,
      "end": 14529.02,
      "formatted_start": "04:02:07.020",
      "formatted_end": "04:02:09.020",
      "text": "اوه"
    },
    {
      "id": 39,
      "start": 14529.02,
      "end": 14531.02,
      "formatted_start": "04:02:09.020",
      "formatted_end": "04:02:11.020",
      "text": "مادرم داره"
    },
    {
      "id": 40,
      "start": 14531.02,
      "end": 14535.02,
      "formatted_start": "04:02:11.020",
      "formatted_end": "04:02:15.020",
      "text": "میشه قیمت کم میخوره؟"
    },
    {
      "id": 41,
      "start": 14535.02,
      "end": 14537.02,
      "formatted_start": "04:02:15.020",
      "formatted_end": "04:02:17.020",
      "text": "کم میخورم، آره"
    },
    {
      "id": 42,
      "start": 14537.02,
      "end": 14539.02,
      "formatted_start": "04:02:17.020",
      "formatted_end": "04:02:19.020",
      "text": "به درازه پایین آره"
    },
    {
      "id": 43,
      "start": 14539.02,
      "end": 14541.02,
      "formatted_start": "04:02:19.020",
      "formatted_end": "04:02:21.020",
      "text": "پایین آره؟"
    },
    {
      "id": 44,
      "start": 14541.02,
      "end": 14543.02,
      "formatted_start": "04:02:21.020",
      "formatted_end": "04:02:23.020",
      "text": "به درازه میزنیم، پس میزنیم بخورم"
    },
    {
      "id": 45,
      "start": 14543.02,
      "end": 14552.52,
      "formatted_start": "04:02:23.020",
      "formatted_end": "04:02:32.520",
      "text": "لدهای سلیلی، فلاکت نونه، قند خوره، قلیه کماننده"
    },
    {
      "id": 46,
      "start": 14552.52,
      "end": 14554.52,
      "formatted_start": "04:02:32.520",
      "formatted_end": "04:02:34.520",
      "text": "ادرارتون سخت میره؟"
    },
    {
      "id": 47,
      "start": 14554.52,
      "end": 14556.52,
      "formatted_start": "04:02:34.520",
      "formatted_end": "04:02:36.520",
      "text": "نمیشه ادرارتون کم شده؟"
    },
    {
      "id": 48,
      "start": 14556.52,
      "end": 14562.52,
      "formatted_start": "04:02:36.520",
      "formatted_end": "04:02:42.520",
      "text": "کم شده، صبح مثلا من ادرار میکنم، میشینم بعد یه ذره دیگه بیاد، فکر میکنم اخواد بیاد"
    },
    {
      "id": 49,
      "start": 14562.52,
      "end": 14564.52,
      "formatted_start": "04:02:42.520",
      "formatted_end": "04:02:44.520",
      "text": "یکجوری میره داره مثلا یکجوری"
    },
    {
      "id": 50,
      "start": 14564.52,
      "end": 14566.52,
      "formatted_start": "04:02:44.520",
      "formatted_end": "04:02:46.520",
      "text": "یکم فرستادتون موضوع شده؟"
    },
    {
      "id": 51,
      "start": 14566.52,
      "end": 14572.02,
      "formatted_start": "04:02:46.520",
      "formatted_end": "04:02:52.020",
      "text": "ای، و یک سال خانم من از یک کتب، سمیشه باشه بیاد"
    },
    {
      "id": 52,
      "start": 14572.02,
      "end": 14574.02,
      "formatted_start": "04:02:52.020",
      "formatted_end": "04:02:54.020",
      "text": "الان قابت نداره"
    },
    {
      "id": 53,
      "start": 14574.02,
      "end": 14576.02,
      "formatted_start": "04:02:54.020",
      "formatted_end": "04:02:56.020",
      "text": "به خاطر این میگی"
    },
    {
      "id": 54,
      "start": 14576.02,
      "end": 14578.02,
      "formatted_start": "04:02:56.020",
      "formatted_end": "04:02:58.020",
      "text": "یک ساله الان خانمو"
    },
    {
      "id": 55,
      "start": 14578.02,
      "end": 14580.02,
      "formatted_start": "04:02:58.020",
      "formatted_end": "04:03:00.020",
      "text": "دیر زمان در خدمتون دیگه"
    },
    {
      "id": 56,
      "start": 14580.02,
      "end": 14582.02,
      "formatted_start": "04:03:00.020",
      "formatted_end": "04:03:02.020",
      "text": "یک ساله شاید ما یه بار برونم به زده و چیز میکنیم"
    },
    {
      "id": 57,
      "start": 14582.02,
      "end": 14584.02,
      "formatted_start": "04:03:02.020",
      "formatted_end": "04:03:04.020",
      "text": "خانمو کی؟"
    },
    {
      "id": 58,
      "start": 14584.02,
      "end": 14586.02,
      "formatted_start": "04:03:04.020",
      "formatted_end": "04:03:06.020",
      "text": "خانم خودم"
    },
    {
      "id": 59,
      "start": 14586.02,
      "end": 14588.02,
      "formatted_start": "04:03:06.020",
      "formatted_end": "04:03:08.020",
      "text": "با هم فامیلشون چه بود؟"
    },
    {
      "id": 60,
      "start": 14588.02,
      "end": 14590.02,
      "formatted_start": "04:03:08.020",
      "formatted_end": "04:03:10.020",
      "text": "استفیقانیسی بود دیر خدمتون"
    },
    {
      "id": 61,
      "start": 14590.02,
      "end": 14592.02,
      "formatted_start": "04:03:10.020",
      "formatted_end": "04:03:12.020",
      "text": "چرا شکر یادتون هست؟"
    },
    {
      "id": 62,
      "start": 14592.02,
      "end": 14594.02,
      "formatted_start": "04:03:12.020",
      "formatted_end": "04:03:14.020",
      "text": "من چهره که امر میشنوزم"
    },
    {
      "id": 63,
      "start": 14594.02,
      "end": 14596.02,
      "formatted_start": "04:03:14.020",
      "formatted_end": "04:03:16.020",
      "text": "ولی فامیل ها یادم"
    },
    {
      "id": 64,
      "start": 14596.02,
      "end": 14598.02,
      "formatted_start": "04:03:16.020",
      "formatted_end": "04:03:18.020",
      "text": "هم کلاس هم شدن بوده"
    },
    {
      "id": 65,
      "start": 14598.02,
      "end": 14600.02,
      "formatted_start": "04:03:18.020",
      "formatted_end": "04:03:20.020",
      "text": "خب آزمای قبضتون"
    },
    {
      "id": 66,
      "start": 14600.02,
      "end": 14602.02,
      "formatted_start": "04:03:20.020",
      "formatted_end": "04:03:22.020",
      "text": "از همین وقت باید از کبد چربه برده"
    },
    {
      "id": 67,
      "start": 14602.02,
      "end": 14603.02,
      "formatted_start": "04:03:22.020",
      "formatted_end": "04:03:23.020",
      "text": "چربه؟"
    },
    {
      "id": 68,
      "start": 14603.02,
      "end": 14605.02,
      "formatted_start": "04:03:23.020",
      "formatted_end": "04:03:25.020",
      "text": "از سنویت من درم میتونم باشم"
    },
    {
      "id": 69,
      "start": 14605.02,
      "end": 14607.02,
      "formatted_start": "04:03:25.020",
      "formatted_end": "04:03:27.020",
      "text": "از همین وقت سنو برده چه هم کبده تا خورستاته"
    },
    {
      "id": 70,
      "start": 14607.02,
      "end": 14609.02,
      "formatted_start": "04:03:27.020",
      "formatted_end": "04:03:29.020",
      "text": "تا این تحقیق چه باشه"
    },
    {
      "id": 71,
      "start": 14609.02,
      "end": 14610.02,
      "formatted_start": "04:03:29.020",
      "formatted_end": "04:03:30.020",
      "text": "تا خورستاته تون میگیرم"
    },
    {
      "id": 72,
      "start": 14610.02,
      "end": 14612.02,
      "formatted_start": "04:03:30.020",
      "formatted_end": "04:03:32.020",
      "text": "تا تورستاته میبخواد همین چیزه همه همه همه"
    },
    {
      "id": 73,
      "start": 14612.02,
      "end": 14614.02,
      "formatted_start": "04:03:32.020",
      "formatted_end": "04:03:34.020",
      "text": "همه شی نیست دار؟"
    },
    {
      "id": 74,
      "start": 14614.02,
      "end": 14616.02,
      "formatted_start": "04:03:34.020",
      "formatted_end": "04:03:36.020",
      "text": "همه شی به خواهش نیست"
    },
    {
      "id": 75,
      "start": 14616.02,
      "end": 14618.02,
      "formatted_start": "04:03:36.020",
      "formatted_end": "04:03:38.020",
      "text": "چون من خودم رو بودم دیگه"
    },
    {
      "id": 76,
      "start": 14618.02,
      "end": 14620.02,
      "formatted_start": "04:03:38.020",
      "formatted_end": "04:03:40.020",
      "text": "پیشتر دستش من رو نزدیک میکنم برم"
    },
    {
      "id": 77,
      "start": 14620.02,
      "end": 14624.52,
      "formatted_start": "04:03:40.020",
      "formatted_end": "04:03:44.520",
      "text": "چون من سوال کردم بچه ای، اکسه من اونطوری میشن، دینا شده دارم"
    },
    {
      "id": 78,
      "start": 14624.52,
      "end": 14628.42,
      "formatted_start": "04:03:44.520",
      "formatted_end": "04:03:48.420",
      "text": "یوتامیزی تونم پایینه، کم خونم با کم هستی"
    },
    {
      "id": 79,
      "start": 14628.42,
      "end": 14631.42,
      "formatted_start": "04:03:48.420",
      "formatted_end": "04:03:51.420",
      "text": "ولی دور ازشون از نظر بد خریمی مشکلی نداری"
    },
    {
      "id": 80,
      "start": 14631.42,
      "end": 14633.42,
      "formatted_start": "04:03:51.420",
      "formatted_end": "04:03:53.420",
      "text": "بعد پرستادتون کامت خواهد کرده"
    },
    {
      "id": 81,
      "start": 14633.42,
      "end": 14637.42,
      "formatted_start": "04:03:53.420",
      "formatted_end": "04:03:57.420",
      "text": "خاندویتون منو دوتا زخمیتون، نیده و رودپولو تیز دارم"
    },
    {
      "id": 82,
      "start": 14637.42,
      "end": 14641.42,
      "formatted_start": "04:03:57.420",
      "formatted_end": "04:04:01.420",
      "text": "دوتا زخم دارم که آوردم خودتون، نه تون گفتی موردتا باید"
    },
    {
      "id": 83,
      "start": 14641.42,
      "end": 14671.42,
      "formatted_start": "04:04:01.420",
      "formatted_end": "04:04:31.420",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 84,
      "start": 14671.42,
      "end": 14675.26,
      "formatted_start": "04:04:31.420",
      "formatted_end": "04:04:35.260",
      "text": "در طور گوهرش چی بود؟ همون که من گفت باید انجام بده"
    },
    {
      "id": 85,
      "start": 14675.26,
      "end": 14677.26,
      "formatted_start": "04:04:35.260",
      "formatted_end": "04:04:37.260",
      "text": "گفته بود دوستان دوستان انجام بده"
    },
    {
      "id": 86,
      "start": 14677.26,
      "end": 14678.26,
      "formatted_start": "04:04:37.260",
      "formatted_end": "04:04:38.260",
      "text": "که این که بود دوتره؟"
    },
    {
      "id": 87,
      "start": 14678.26,
      "end": 14680.26,
      "formatted_start": "04:04:38.260",
      "formatted_end": "04:04:40.260",
      "text": "تهران بود که این آزگوی گرم"
    },
    {
      "id": 88,
      "start": 14680.26,
      "end": 14682.26,
      "formatted_start": "04:04:40.260",
      "formatted_end": "04:04:42.260",
      "text": "همینجا دوز خرابی اینو کارشون خوبه چند؟"
    },
    {
      "id": 89,
      "start": 14682.26,
      "end": 14684.26,
      "formatted_start": "04:04:42.260",
      "formatted_end": "04:04:44.260",
      "text": "نه کارشون که خوبه"
    },
    {
      "id": 90,
      "start": 14684.26,
      "end": 14688.26,
      "formatted_start": "04:04:44.260",
      "formatted_end": "04:04:48.260",
      "text": "نه همچنین چون اونجا ما بیمونم خودمون خدمت درمانی چیز داریم"
    },
    {
      "id": 91,
      "start": 14688.26,
      "end": 14690.26,
      "formatted_start": "04:04:48.260",
      "formatted_end": "04:04:50.260",
      "text": "رایگانم هستن اینجا مو که..."
    },
    {
      "id": 92,
      "start": 14690.26,
      "end": 14692.26,
      "formatted_start": "04:04:50.260",
      "formatted_end": "04:04:52.260",
      "text": "از این نظر باره"
    },
    {
      "id": 93,
      "start": 14692.26,
      "end": 14694.26,
