      "start": 3186.28,
      "end": 3188.28,
      "formatted_start": "00:53:06.280",
      "formatted_end": "00:53:08.280",
      "text": "و زیر شکمش هم درمی کنه؟"
    },
    {
      "id": 92,
      "start": 3188.28,
      "end": 3190.28,
      "formatted_start": "00:53:08.280",
      "formatted_end": "00:53:10.280",
      "text": "امش میکش شکم هم درمی کنه"
    },
    {
      "id": 93,
      "start": 3190.28,
      "end": 3192.28,
      "formatted_start": "00:53:10.280",
      "formatted_end": "00:53:12.280",
      "text": "کجای شکمش درمی کنه؟"
    },
    {
      "id": 94,
      "start": 3192.28,
      "end": 3194.28,
      "formatted_start": "00:53:12.280",
      "formatted_end": "00:53:14.280",
      "text": "اینجا میگی یعنی"
    },
    {
      "id": 95,
      "start": 3194.28,
      "end": 3196.28,
      "formatted_start": "00:53:14.280",
      "formatted_end": "00:53:16.280",
      "text": "نه دور ناک، زیر ناک"
    },
    {
      "id": 96,
      "start": 3196.28,
      "end": 3198.28,
      "formatted_start": "00:53:16.280",
      "formatted_end": "00:53:18.280",
      "text": "دیدر که نرده که اونجا داره"
    },
    {
      "id": 97,
      "start": 3198.28,
      "end": 3200.28,
      "formatted_start": "00:53:18.280",
      "formatted_end": "00:53:20.280",
      "text": "اون نبه اونجا درمی کنه"
    },
    {
      "id": 98,
      "start": 3200.28,
      "end": 3202.28,
      "formatted_start": "00:53:20.280",
      "formatted_end": "00:53:22.280",
      "text": "باید برداریم"
    },
    {
      "id": 99,
      "start": 3202.28,
      "end": 3204.28,
      "formatted_start": "00:53:22.280",
      "formatted_end": "00:53:24.280",
      "text": "آره؟"
    },
    {
      "id": 100,
      "start": 3204.28,
      "end": 3206.28,
      "formatted_start": "00:53:24.280",
      "formatted_end": "00:53:26.280",
      "text": "بیا شامل"
    },
    {
      "id": 101,
      "start": 3206.28,
      "end": 3208.28,
      "formatted_start": "00:53:26.280",
      "formatted_end": "00:53:28.280",
      "text": "بیا آفرین"
    },
    {
      "id": 102,
      "start": 3208.28,
      "end": 3210.28,
      "formatted_start": "00:53:28.280",
      "formatted_end": "00:53:30.280",
      "text": "بیا آفرین"
    },
    {
      "id": 103,
      "start": 3210.28,
      "end": 3212.28,
      "formatted_start": "00:53:30.280",
      "formatted_end": "00:53:32.280",
      "text": "بیا قرن دارم"
    },
    {
      "id": 104,
      "start": 3212.28,
      "end": 3214.28,
      "formatted_start": "00:53:32.280",
      "formatted_end": "00:53:34.280",
      "text": "بیا برای دختر خوشکرمی"
    },
    {
      "id": 105,
      "start": 3214.28,
      "end": 3216.28,
      "formatted_start": "00:53:34.280",
      "formatted_end": "00:53:36.280",
      "text": "آفرین"
    },
    {
      "id": 106,
      "start": 3216.28,
      "end": 3218.28,
      "formatted_start": "00:53:36.280",
      "formatted_end": "00:53:38.280",
      "text": "این ها چیه؟ تلایه؟"
    },
    {
      "id": 107,
      "start": 3218.28,
      "end": 3220.28,
      "formatted_start": "00:53:38.280",
      "formatted_end": "00:53:40.280",
      "text": "آره"
    },
    {
      "id": 108,
      "start": 3220.28,
      "end": 3222.28,
      "formatted_start": "00:53:40.280",
      "formatted_end": "00:53:42.280",
      "text": "باش باش"
    },
    {
      "id": 109,
      "start": 3222.28,
      "end": 3224.28,
      "formatted_start": "00:53:42.280",
      "formatted_end": "00:53:44.280",
      "text": "باش باش"
    },
    {
      "id": 110,
      "start": 3224.28,
      "end": 3226.28,
      "formatted_start": "00:53:44.280",
      "formatted_end": "00:53:46.280",
      "text": "بشه سه کلمتر"
    },
    {
      "id": 111,
      "start": 3226.28,
      "end": 3228.28,
      "formatted_start": "00:53:46.280",
      "formatted_end": "00:53:48.280",
      "text": "سوچن هم نمیدونی"
    },
    {
      "id": 112,
      "start": 3228.28,
      "end": 3234.04,
      "formatted_start": "00:53:48.280",
      "formatted_end": "00:53:54.040",
      "text": "ازش عکس رنگی گو گفته کلیهاش مشکل نداره فقط مسانهاشی که میتراب نگرمون داره"
    },
    {
      "id": 113,
      "start": 3234.04,
      "end": 3236.84,
      "formatted_start": "00:53:54.040",
      "formatted_end": "00:53:56.840",
      "text": "نفس کشی؟ نفس نفس کشی"
    },
    {
      "id": 114,
      "start": 3236.84,
      "end": 3237.84,
      "formatted_start": "00:53:56.840",
      "formatted_end": "00:53:57.840",
      "text": "نفس؟ نفس کشی"
    },
    {
      "id": 115,
      "start": 3237.84,
      "end": 3239.92,
      "formatted_start": "00:53:57.840",
      "formatted_end": "00:53:59.920",
      "text": "آفرادی، اینجا درک می کنی؟"
    },
    {
      "id": 116,
      "start": 3239.92,
      "end": 3241.72,
      "formatted_start": "00:53:59.920",
      "formatted_end": "00:54:01.720",
      "text": "آفرادی که..."
    },
    {
      "id": 117,
      "start": 3241.72,
      "end": 3242.22,
      "formatted_start": "00:54:01.720",
      "formatted_end": "00:54:02.220",
      "text": "اینجا؟"
    },
    {
      "id": 118,
      "start": 3242.22,
      "end": 3243.22,
      "formatted_start": "00:54:02.220",
      "formatted_end": "00:54:03.220",
      "text": "مارد در بین موشک داره"
    },
    {
      "id": 119,
      "start": 3243.22,
      "end": 3244.02,
      "formatted_start": "00:54:03.220",
      "formatted_end": "00:54:04.020",
      "text": "هران درک داره؟"
    },
    {
      "id": 120,
      "start": 3244.02,
      "end": 3245.14,
      "formatted_start": "00:54:04.020",
      "formatted_end": "00:54:05.140",
      "text": "نه، رنگ سریع چی نکرده"
    },
    {
      "id": 121,
      "start": 3245.14,
      "end": 3246.14,
      "formatted_start": "00:54:05.140",
      "formatted_end": "00:54:06.140",
      "text": "نه، آرو هران داره"
    },
    {
      "id": 122,
      "start": 3246.14,
      "end": 3258.14,
      "formatted_start": "00:54:06.140",
      "formatted_end": "00:54:18.140",
      "text": "اینجا درداره؟ اینجا چی؟ اینجا درد نمی کنه؟ اینجا درداره؟ اینجا چی؟ از من تستیدی؟ نه تستیدی."
    },
    {
      "id": 123,
      "start": 3258.14,
      "end": 3266.14,
      "formatted_start": "00:54:18.140",
      "formatted_end": "00:54:26.140",
      "text": "دفعه پشت کن. افراد. اینو انگیز. نه افراد. دفعه پشت کن. پشت کن."
    },
    {
      "id": 124,
      "start": 3266.14,
      "end": 3272.14,
      "formatted_start": "00:54:26.140",
      "formatted_end": "00:54:32.140",
      "text": "نه چونت. نه چونت. افراد. نمره خوب بود. نه نه. دشتید. پشت کن."
    },
    {
      "id": 125,
      "start": 3272.14,
      "end": 3278.14,
      "formatted_start": "00:54:32.140",
      "formatted_end": "00:54:38.140",
      "text": "خب، ببینی کنید که آزمایش باید میبینید، پند و خونه شروع با خونه ته ادرالی"
    },
    {
      "id": 126,
      "start": 3278.14,
      "end": 3279.14,
      "formatted_start": "00:54:38.140",
      "formatted_end": "00:54:39.140",
      "text": "سمیت چقدره؟"
    },
    {
      "id": 127,
      "start": 3279.14,
      "end": 3280.14,
      "formatted_start": "00:54:39.140",
      "formatted_end": "00:54:40.140",
      "text": "پنج سال شاید"
    },
    {
      "id": 128,
      "start": 3280.14,
      "end": 3281.14,
      "formatted_start": "00:54:40.140",
      "formatted_end": "00:54:41.140",
      "text": "پنج سال شاید"
    },
    {
      "id": 129,
      "start": 3281.14,
      "end": 3283.14,
      "formatted_start": "00:54:41.140",
      "formatted_end": "00:54:43.140",
      "text": "یک پنج سال بعد دیگه نباشه شب ادرالی کنید"
    },
    {
      "id": 130,
      "start": 3283.14,
      "end": 3285.14,
      "formatted_start": "00:54:43.140",
      "formatted_end": "00:54:45.140",
      "text": "هر دوتا شب ادرالی داره"
    },
    {
      "id": 131,
      "start": 3285.14,
      "end": 3287.14,
      "formatted_start": "00:54:45.140",
      "formatted_end": "00:54:47.140",
      "text": "اسمی چه؟ راه های؟"
    },
    {
      "id": 132,
      "start": 3287.14,
      "end": 3288.14,
      "formatted_start": "00:54:47.140",
      "formatted_end": "00:54:48.140",
      "text": "ناسرین است"
    },
    {
      "id": 133,
      "start": 3288.14,
      "end": 3289.14,
      "formatted_start": "00:54:48.140",
      "formatted_end": "00:54:49.140",
      "text": "ناسرین"
    },
    {
      "id": 134,
      "start": 3289.14,
      "end": 3290.14,
      "formatted_start": "00:54:49.140",
      "formatted_end": "00:54:50.140",
      "text": "ناسرین"
    },
    {
      "id": 135,
      "start": 3290.14,
      "end": 3291.14,
      "formatted_start": "00:54:50.140",
      "formatted_end": "00:54:51.140",
      "text": "ناسر خب"
    },
    {
      "id": 136,
      "start": 3291.14,
      "end": 3294.14,
      "formatted_start": "00:54:51.140",
      "formatted_end": "00:54:54.140",
      "text": "زیادان که بردن از باید اکسرنگی بیدید"
    },
    {
      "id": 137,
      "start": 3294.14,
      "end": 3295.14,
      "formatted_start": "00:54:54.140",
      "formatted_end": "00:54:55.140",
      "text": "با خاطر از اون میترسه چرا؟"
    },
    {
      "id": 138,
      "start": 3295.14,
      "end": 3297.14,
      "formatted_start": "00:54:55.140",
      "formatted_end": "00:54:57.140",
      "text": "شبت را ریشت"
    },
    {
      "id": 139,
      "start": 3297.14,
      "end": 3299.14,
      "formatted_start": "00:54:57.140",
      "formatted_end": "00:54:59.140",
      "text": "عکس رنگی بالا چی گرفت؟"
    }
  ],
  "status": "completed"
}