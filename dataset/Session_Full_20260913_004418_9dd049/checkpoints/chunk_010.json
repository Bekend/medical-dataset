      "end": 3002.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:02.000",
      "text": "در کار نداریم."
    },
    {
      "id": 1,
      "start": 3002.0,
      "end": 3006.0,
      "formatted_start": "00:50:02.000",
      "formatted_end": "00:50:06.000",
      "text": "در کار نداریم، دوری که چند بار میره، میره."
    },
    {
      "id": 2,
      "start": 3006.0,
      "end": 3010.0,
      "formatted_start": "00:50:06.000",
      "formatted_end": "00:50:10.000",
      "text": "خودم هم که تو من نیست درمه که که درمه که درمه که"
    },
    {
      "id": 3,
      "start": 3010.0,
      "end": 3011.0,
      "formatted_start": "00:50:10.000",
      "formatted_end": "00:50:11.000",
      "text": "دفت می کنی؟"
    },
