  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6626.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:26.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6643.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:43.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6660.0,
      "end": 6664.4,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:04.400",
      "text": "چون هر چقدر به پایان زندگی نزدیک تر میشیم"
    },
    {
      "id": 3,
      "start": 6664.4,
      "end": 6667.44,
      "formatted_start": "01:51:04.400",
      "formatted_end": "01:51:07.440",
      "text": "ذهن ما حضور بیشتر میدام میکنه"
    },
    {
      "id": 4,
      "start": 6667.44,
      "end": 6672.16,
      "formatted_start": "01:51:07.440",
      "formatted_end": "01:51:12.160",
      "text": "میفهمیم که جنگی در سطح مسئله کچیدی ازش نداره"
    },
    {
      "id": 5,
      "start": 6672.16,
      "end": 6676.0,
      "formatted_start": "01:51:12.160",
      "formatted_end": "01:51:16.000",
      "text": "میفهمیم که عشق و ارتباط با عزیزانمون"
    },
    {
      "id": 6,
      "start": 6676.68,
      "end": 6679.3,
      "formatted_start": "01:51:16.680",
      "formatted_end": "01:51:19.300",
      "text": "ترها چیزیه که در نهایت واقعی نمونه"
    },
    {
      "id": 7,
      "start": 6679.3,
      "end": 6680.72,
      "formatted_start": "01:51:19.300",
      "formatted_end": "01:51:20.720",
      "text": "این همونه"
    },
    {
      "id": 8,
      "start": 6680.72,
      "end": 6688.88,
      "formatted_start": "01:51:20.720",
      "formatted_end": "01:51:28.880",
      "text": "هر موقع دیگه توجهت مرد و آدامونش رو بیدزنش به نروزمینش سداره گیر میکن"
    },
    {
      "id": 9,
      "start": 6688.88,
      "end": 6690.88,
      "formatted_start": "01:51:28.880",
      "formatted_end": "01:51:30.880",
      "text": "چی شده چرا گریم خونیم بزرگیره"
    },
    {
      "id": 10,
      "start": 6690.88,
      "end": 6693.88,
      "formatted_start": "01:51:30.880",
      "formatted_end": "01:51:33.880",
      "text": "واسه همو عوض می کنم می گویم کنجش را دارن برنگران کنند"
    },
    {
      "id": 11,
      "start": 6693.88,
      "end": 6695.88,
      "formatted_start": "01:51:33.880",
      "formatted_end": "01:51:35.880",
      "text": "احساس بری دارم"
    },
    {
      "id": 12,
      "start": 6695.88,
      "end": 6696.88,
      "formatted_start": "01:51:35.880",
      "formatted_end": "01:51:36.880",
      "text": "نیست گناه و برنگران"
    },
    {
      "id": 13,
      "start": 6696.88,
      "end": 6698.88,
      "formatted_start": "01:51:36.880",
      "formatted_end": "01:51:38.880",
      "text": "ما یک مسافری هستیم داشته نامست"
    },
    {
      "id": 14,
      "start": 6698.88,
      "end": 6700.88,
      "formatted_start": "01:51:38.880",
      "formatted_end": "01:51:40.880",
      "text": "نمی داریم از کجا آمدیم"
    },
    {
      "id": 15,
      "start": 6700.88,
      "end": 6703.88,
      "formatted_start": "01:51:40.880",
      "formatted_end": "01:51:43.880",
      "text": "نمی دانیم با کجا می ردیم"
    },
    {
      "id": 16,
      "start": 6703.88,
      "end": 6706.88,
      "formatted_start": "01:51:43.880",
      "formatted_end": "01:51:46.880",
      "text": "فقط دیندادر هست که ببینیم"
    },
    {
      "id": 17,
      "start": 6706.88,
      "end": 6709.88,
      "formatted_start": "01:51:46.880",
      "formatted_end": "01:51:49.880",
      "text": "جنازه ها رو برای بستانی برنگ توی گردفت می کنند"
    },
    {
      "id": 18,
      "start": 6709.88,
      "end": 6711.88,
      "formatted_start": "01:51:49.880",
      "formatted_end": "01:51:51.880",
      "text": "اما بعد چندی شد؟"
    },
    {
      "id": 19,
      "start": 6711.88,
      "end": 6713.88,
      "formatted_start": "01:51:51.880",
      "formatted_end": "01:51:53.880",
      "text": "از اون طرف یقین داریم"
    },
    {
      "id": 20,
      "start": 6713.88,
      "end": 6719.88,
      "formatted_start": "01:51:53.880",
      "formatted_end": "01:51:59.880",
      "text": "این داره بیرون و احماد و خاندرات و برقات در صورت رخیب نیست"
    },
    {
      "id": 21,
      "start": 6719.88,
      "end": 6725.88,
      "formatted_start": "01:51:59.880",
      "formatted_end": "01:52:05.880",
      "text": "اگر میتونم از این قبر خبار نداریم، بیا میتونم قبر همین یشون میتر"
    },
    {
      "id": 22,
      "start": 6725.88,
      "end": 6730.88,
      "formatted_start": "01:52:05.880",
      "formatted_end": "01:52:10.880",
      "text": "یا نیمیتر و بودر و یشون میتر"
    },
    {
      "id": 23,
      "start": 6730.88,
      "end": 6732.88,
      "formatted_start": "01:52:10.880",
      "formatted_end": "01:52:12.880",
      "text": "بیا میتونم قبر همین"
    },
    {
      "id": 24,
      "start": 6732.88,
      "end": 6736.88,
      "formatted_start": "01:52:12.880",
      "formatted_end": "01:52:16.880",
      "text": "بگیم وقتی از این ورده بسیار سوال می کنم که"
    },
    {
      "id": 25,
      "start": 6736.88,
      "end": 6741.88,
      "formatted_start": "01:52:16.880",
      "formatted_end": "01:52:21.880",
      "text": "بعض زخ از کشور شد، یا اگر میتونم قبر"
    },
    {
      "id": 26,
      "start": 6741.88,
      "end": 6748.98,
      "formatted_start": "01:52:21.880",
      "formatted_end": "01:52:28.980",
      "text": "ساعت دوی زکر همه توم رو روی زرده 24 نگرم"
    },
    {
      "id": 27,
      "start": 6748.98,
      "end": 6751.94,
      "formatted_start": "01:52:28.980",
      "formatted_end": "01:52:31.940",
      "text": "از دقیقی ساعت ها یه ساعت رو انتخاب برو"
    },
    {
      "id": 28,
      "start": 6751.94,
      "end": 6758.62,
      "formatted_start": "01:52:31.940",
      "formatted_end": "01:52:38.620",
      "text": "مثلا ساعت هفت و با هر زردی من یه هروم هرده تزاقید و بوشه هشت نو ده"
    },
    {
      "id": 29,
      "start": 6758.62,
      "end": 6762.78,
      "formatted_start": "01:52:38.620",
      "formatted_end": "01:52:42.780",
      "text": "خیلی ها فکر می کنند که خواهر برداری که زیره یه سخت بردار شدن"
    },
    {
      "id": 30,
      "start": 6762.78,
      "end": 6765.1,
      "formatted_start": "01:52:42.780",
      "formatted_end": "01:52:45.100",
      "text": "یه کودکی مشکل که بردارن"
    },
    {
      "id": 31,
      "start": 6765.1,
      "end": 6767.36,
      "formatted_start": "01:52:45.100",
      "formatted_end": "01:52:47.360",
      "text": "هم مقامی از این که هیچ دیگر خواهر برداری"
    },
    {
      "id": 32,
      "start": 6767.36,
      "end": 6769.32,
      "formatted_start": "01:52:47.360",
      "formatted_end": "01:52:49.320",
      "text": "هم تا این کودکی توی خونم بردار شده باشن"
    },
    {
      "id": 33,
      "start": 6769.32,
      "end": 6771.32,
      "formatted_start": "01:52:49.320",
      "formatted_end": "01:52:51.320",
      "text": "خودکیشون شبیه همیه نیست"
    },
    {
      "id": 34,
      "start": 6771.32,
      "end": 6773.32,
      "formatted_start": "01:52:51.320",
      "formatted_end": "01:52:53.320",
      "text": "چرا؟"
    },
    {
      "id": 35,
      "start": 6773.32,
      "end": 6775.32,
      "formatted_start": "01:52:53.320",
      "formatted_end": "01:52:55.320",
      "text": "اولیش ترتیب تبدیل دارد"
    },
    {
      "id": 36,
      "start": 6775.32,
      "end": 6779.32,
      "formatted_start": "01:52:55.320",
      "formatted_end": "01:52:59.320",
      "text": "رابطه ی پدر مادر با بچه اول"
    },
    {
      "id": 37,
      "start": 6779.32,
      "end": 6781.32,
      "formatted_start": "01:52:59.320",
      "formatted_end": "01:53:01.320",
      "text": "اصلا شبیه رابطه شون با بچه دوم یا سگون نیست"
    },
    {
      "id": 38,
      "start": 6781.32,
      "end": 6783.32,
      "formatted_start": "01:53:01.320",
      "formatted_end": "01:53:03.320",
      "text": "وقتی بچه اول به دونمیان"
    },
    {
      "id": 39,
      "start": 6783.32,
      "end": 6785.32,
      "formatted_start": "01:53:03.320",
      "formatted_end": "01:53:05.320",
      "text": "پدر مادر برای اول امور دارند"
    },
    {
      "id": 40,
      "start": 6785.32,
      "end": 6787.32,
      "formatted_start": "01:53:05.320",
      "formatted_end": "01:53:07.320",
      "text": "پدر مادر میشن"
    },
    {
      "id": 41,
      "start": 6787.32,
      "end": 6789.32,
      "formatted_start": "01:53:07.320",
      "formatted_end": "01:53:09.320",
      "text": "ممکنه استرسشون بیشتر باشه، ترکبشون کمتر باشه"
    },
    {
      "id": 42,
      "start": 6789.32,
      "end": 6791.32,
      "formatted_start": "01:53:09.320",
      "formatted_end": "01:53:11.320",
      "text": "در این طریقه خاصی از اندیگه مشترکشون باشن"
    },
    {
      "id": 43,
      "start": 6791.32,
      "end": 6793.32,
      "formatted_start": "01:53:11.320",
      "formatted_end": "01:53:13.320",
      "text": "اما چند ساله بعد"
    },
    {
      "id": 44,
      "start": 6793.32,
      "end": 6797.32,
      "formatted_start": "01:53:13.320",
      "formatted_end": "01:53:17.320",
      "text": "و هر وقتی بچه دوم نقدرگان به دانمیان، خودمو حالتی تمرین کردن"
    },
    {
      "id": 45,
      "start": 6797.32,
      "end": 6801.32,
      "formatted_start": "01:53:17.320",
      "formatted_end": "01:53:21.320",
      "text": "کن که نظر موضوعیت مادی، متقابل تجربه و نظر حیجانی بخود تجربه شدن"
    },
    {
      "id": 46,
      "start": 6801.32,
      "end": 6804.32,
      "formatted_start": "01:53:21.320",
      "formatted_end": "01:53:24.320",
      "text": "یا تا رابطه شما با همدیگه تمرین کردن شدن"
    },
    {
      "id": 47,
      "start": 6804.32,
      "end": 6810.32,
      "formatted_start": "01:53:24.320",
      "formatted_end": "01:53:30.320",
      "text": "آماده ولی وعدی ثوابت اجراسیتیه، منظورم اینکه سیده در دختر یا پسر یا برنامه شهر و سر"
    },
    {
      "id": 48,
      "start": 6810.32,
      "end": 6815.32,
      "formatted_start": "01:53:30.320",
      "formatted_end": "01:53:35.320",
      "text": "مثل نقنا، خدابا، با دختر یا پسر، مطمئن رفتامشون متقابل باشه"
    },
    {
      "id": 49,
      "start": 6815.32,
      "end": 6821.32,
      "formatted_start": "01:53:35.320",
      "formatted_end": "01:53:41.320",
      "text": "به خاطر تنقیزی تیز بردیم از بابا هر تجربه ما این تظاهراتی که نسبت به هر جنس اطول داره"
    },
    {
      "id": 50,
      "start": 6821.32,
      "end": 6823.32,
      "formatted_start": "01:53:41.320",
      "formatted_end": "01:53:43.320",
      "text": "اما یه رای خیلی مهم اینجا داریم"
    },
    {
      "id": 51,
      "start": 6823.32,
      "end": 6827.32,
      "formatted_start": "01:53:43.320",
      "formatted_end": "01:53:47.320",
      "text": "بچه ها عشق پدر مادر را مستقیما تجربه نمی کنند"
    },
    {
      "id": 52,
      "start": 6827.32,
      "end": 6830.32,
      "formatted_start": "01:53:47.320",
      "formatted_end": "01:53:50.320",
      "text": "نرمه گذرو و رفتار پدر مادر تجربه کنند"
    },
    {
      "id": 53,
      "start": 6830.32,
      "end": 6834.32,
      "formatted_start": "01:53:50.320",
      "formatted_end": "01:53:54.320",
      "text": "یعنی اگه پدر مادر با هر شب پرزندشون یه هر گزه یه شکل رفتار کنند"
    },
    {
      "id": 54,
      "start": 6834.32,
      "end": 6837.32,
      "formatted_start": "01:53:54.320",
      "formatted_end": "01:53:57.320",
      "text": "مازم بچه ها تجربهشون از پدر مادرشون متفاوت کردند"
    },
    {
      "id": 55,
      "start": 6837.32,
      "end": 6845.32,
      "formatted_start": "01:53:57.320",
      "formatted_end": "01:54:05.320",
      "text": "در صدق منیه خود بچه ها هم یک سال دردار می‌گیرند. هر بچه با خورد و خوبی، شنگ‌زدیدی، حساسیت و متبابطی متبادل می‌شه."
    },
    {
      "id": 56,
      "start": 6845.32,
      "end": 6850.32,
      "formatted_start": "01:54:05.320",
      "formatted_end": "01:54:10.320",
      "text": "یک بچه هم که هستاستر باشه، یکی انتهاب‌تر باشه، یکی مستردتر باشه، یکی اجتماعی‌تر باشه."
    },
    {
      "id": 57,
      "start": 6850.32,
      "end": 6857.32,
      "formatted_start": "01:54:10.320",
      "formatted_end": "01:54:17.320",
      "text": "از این فرض، پدرمدر با همان کامل یک سال دردار می‌شه، همه بچه هم از دار باشه که متبابطی تفصیل می‌کنه."
    },
    {
      "id": 58,
      "start": 6857.32,
      "end": 6863.32,
      "formatted_start": "01:54:17.320",
      "formatted_end": "01:54:23.320",
      "text": "هر بچه بخش متبابزی از والده ایشون پماروک کنه و همین باعثشونی دلیل هم رابطه را به سه هم نداشتن"
    },
    {
      "id": 59,
      "start": 6863.32,
      "end": 6868.32,
      "formatted_start": "01:54:23.320",
      "formatted_end": "01:54:28.320",
      "text": "و به همین طریق هیچ بچه این دلیل ماده دلیل هم مشاهده خواهر بردرش نداره"
    },
    {
      "id": 60,
      "start": 6868.32,
      "end": 6873.32,
      "formatted_start": "01:54:28.320",
      "formatted_end": "01:54:33.320",
      "text": "چون والده این فرضا دهبای تجربه کردن و والده این بچه دوستا کن تجربه کردن"
    },
    {
      "id": 61,
      "start": 6873.32,
      "end": 6879.32,
      "formatted_start": "01:54:33.320",
      "formatted_end": "01:54:39.320",
      "text": "از نظر زنی بیدار تریبه وزن اقتصادی حتی کفیت رابطه زناشون یک سال نیستن"
    },
    {
      "id": 62,
      "start": 6879.32,
      "end": 6899.32,
      "formatted_start": "01:54:39.320",
      "formatted_end": "01:54:59.320",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}