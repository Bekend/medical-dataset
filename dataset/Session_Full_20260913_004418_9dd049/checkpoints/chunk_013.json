  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3926.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:26.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3926.0,
      "end": 3928.0,
      "formatted_start": "01:05:26.000",
      "formatted_end": "01:05:28.000",
      "text": "سلام درم آقایی شما"
    },
    {
      "id": 2,
      "start": 3928.0,
      "end": 3929.0,
      "formatted_start": "01:05:28.000",
      "formatted_end": "01:05:29.000",
      "text": "خوبه"
    },
    {
      "id": 3,
      "start": 3929.0,
      "end": 3931.0,
      "formatted_start": "01:05:29.000",
      "formatted_end": "01:05:31.000",
      "text": "افراد من این کار چیز دارم؟"
    },
    {
      "id": 4,
      "start": 3931.0,
      "end": 3932.0,
      "formatted_start": "01:05:31.000",
      "formatted_end": "01:05:32.000",
      "text": "کشور رو تخطیر داریم؟"
    },
    {
      "id": 5,
      "start": 3932.0,
      "end": 3933.0,
      "formatted_start": "01:05:32.000",
      "formatted_end": "01:05:33.000",
      "text": "سلام"
    },
    {
      "id": 6,
      "start": 3933.0,
      "end": 3935.0,
      "formatted_start": "01:05:33.000",
      "formatted_end": "01:05:35.000",
      "text": "بله، اون فرگیر رو مایپرد کنیم"
    },
    {
      "id": 7,
      "start": 3935.0,
      "end": 3936.0,
      "formatted_start": "01:05:35.000",
      "formatted_end": "01:05:36.000",
      "text": "خیلی بس شما"
    },
    {
      "id": 8,
      "start": 3936.0,
      "end": 3938.0,
      "formatted_start": "01:05:36.000",
      "formatted_end": "01:05:38.000",
      "text": "برزاده، آیجانجی، چند روزی شد؟"
    },
    {
      "id": 9,
      "start": 3938.0,
      "end": 3940.0,
      "formatted_start": "01:05:38.000",
      "formatted_end": "01:05:40.000",
      "text": "ارزا بزرگ شما که یه اولوز میشه"
    },
    {
      "id": 10,
      "start": 3940.0,
      "end": 3941.0,
      "formatted_start": "01:05:40.000",
      "formatted_end": "01:05:41.000",
      "text": "پدشتر میشه"
    },
    {
      "id": 11,
      "start": 3941.0,
      "end": 3942.0,
      "formatted_start": "01:05:41.000",
      "formatted_end": "01:05:42.000",
      "text": "چند روزی شد؟"
    },
    {
      "id": 12,
      "start": 3942.0,
      "end": 3945.0,
      "formatted_start": "01:05:42.000",
      "formatted_end": "01:05:45.000",
      "text": "درد شده، این برگردش چیز بردش من دارم میبینم"
    },
    {
      "id": 13,
      "start": 3945.0,
      "end": 3947.0,
      "formatted_start": "01:05:45.000",
      "formatted_end": "01:05:47.000",
      "text": "نارتی شی هستی؟"
    },
    {
      "id": 14,
      "start": 3947.0,
      "end": 3948.0,
      "formatted_start": "01:05:47.000",
      "formatted_end": "01:05:48.000",
      "text": "اونقدر شما ببینیم"
    },
    {
      "id": 15,
      "start": 3948.0,
      "end": 3950.8,
      "formatted_start": "01:05:48.000",
      "formatted_end": "01:05:50.800",
      "text": "نه باید کنترول آوردیم مشکل یک نداره اینا"
    },
    {
      "id": 16,
      "start": 3950.8,
      "end": 3952.6,
      "formatted_start": "01:05:50.800",
      "formatted_end": "01:05:52.600",
      "text": "نه باید چکاپ آوردیم"
    },
    {
      "id": 17,
      "start": 3952.6,
      "end": 3953.4,
      "formatted_start": "01:05:52.600",
      "formatted_end": "01:05:53.400",
      "text": "چکاپ زردی"
    },
    {
      "id": 18,
      "start": 3953.4,
      "end": 3953.9,
      "formatted_start": "01:05:53.400",
      "formatted_end": "01:05:53.900",
      "text": "آخیر"
    },
    {
      "id": 19,
      "start": 3953.9,
      "end": 3958.3,
      "formatted_start": "01:05:53.900",
      "formatted_end": "01:05:58.300",
      "text": "زردی و از اون دور شما که فیزیکی رای زده چی را بیند"
    },
    {
      "id": 20,
      "start": 3958.3,
      "end": 3958.8,
      "formatted_start": "01:05:58.300",
      "formatted_end": "01:05:58.800",
      "text": "اشکال نداره"
    },
    {
      "id": 21,
      "start": 3958.8,
      "end": 3960.6,
      "formatted_start": "01:05:58.800",
      "formatted_end": "01:06:00.600",
      "text": "از اون دور می کنیم زگرین کنم"
    },
    {
      "id": 22,
      "start": 3960.6,
      "end": 3962.6,
      "formatted_start": "01:06:00.600",
      "formatted_end": "01:06:02.600",
      "text": "یه ضربه اشکال نداره با شما"
    },
    {
      "id": 23,
      "start": 3962.6,
      "end": 3965.8,
      "formatted_start": "01:06:02.600",
      "formatted_end": "01:06:05.800",
      "text": "از اون دور زد و از اون دور پرایجوی که دور زد شد"
    },
    {
      "id": 24,
      "start": 3965.8,
      "end": 3967.2,
      "formatted_start": "01:06:05.800",
      "formatted_end": "01:06:07.200",
      "text": "بله صورتش این ها"
    },
    {
      "id": 25,
      "start": 3967.2,
      "end": 3968.6,
      "formatted_start": "01:06:07.200",
      "formatted_end": "01:06:08.600",
      "text": "پروخونی مادر نرزاد"
    },
    {
      "id": 26,
      "start": 3968.6,
      "end": 3970.0,
      "formatted_start": "01:06:08.600",
      "formatted_end": "01:06:10.000",
      "text": "آیا مصطفی"
    },
    {
      "id": 27,
      "start": 3970.0,
      "end": 3971.3,
      "formatted_start": "01:06:10.000",
      "formatted_end": "01:06:11.300",
      "text": "بچه شنگونه"
    },
    {
      "id": 28,
      "start": 3971.3,
      "end": 3973.3,
      "formatted_start": "01:06:11.300",
      "formatted_end": "01:06:13.300",
      "text": "این بچه سربون"
    },
    {
      "id": 29,
      "start": 3973.3,
      "end": 3975.3,
      "formatted_start": "01:06:13.300",
      "formatted_end": "01:06:15.300",
      "text": "بچه قبلی زردی داشته"
    },
    {
      "id": 30,
      "start": 3975.3,
      "end": 3977.3,
      "formatted_start": "01:06:15.300",
      "formatted_end": "01:06:17.300",
      "text": "آره خواستم همینجا پیش شما"
    },
    {
      "id": 31,
      "start": 3979.3,
      "end": 3981.3,
      "formatted_start": "01:06:19.300",
      "formatted_end": "01:06:21.300",
      "text": "این داره زرد میشه"
    },
    {
      "id": 32,
      "start": 3981.3,
      "end": 3983.3,
      "formatted_start": "01:06:21.300",
      "formatted_end": "01:06:23.300",
      "text": "از اینجا"
    },
    {
      "id": 33,
      "start": 3983.3,
      "end": 3985.3,
      "formatted_start": "01:06:23.300",
      "formatted_end": "01:06:25.300",
      "text": "درسته"
    },
    {
      "id": 34,
      "start": 3989.3,
      "end": 3993.3,
      "formatted_start": "01:06:29.300",
      "formatted_end": "01:06:33.300",
      "text": "بعد از موضوع شما که شیر مادر شا"
    },
    {
      "id": 35,
      "start": 3993.3,
      "end": 3995.3,
      "formatted_start": "01:06:33.300",
      "formatted_end": "01:06:35.300",
      "text": "سردی"
    },
    {
      "id": 36,
      "start": 3995.3,
      "end": 3997.3,
      "formatted_start": "01:06:35.300",
      "formatted_end": "01:06:37.300",
      "text": "آره سردی"
    },
    {
      "id": 37,
      "start": 3997.3,
      "end": 3999.3,
      "formatted_start": "01:06:37.300",
      "formatted_end": "01:06:39.300",
      "text": "او کسی اونه مادر کلوک داره"
    },
    {
      "id": 38,
      "start": 3999.3,
      "end": 4003.3,
      "formatted_start": "01:06:39.300",
      "formatted_end": "01:06:43.300",
      "text": "چون خوش که میشونیدیم مثل پستونک هم میخوره این فرق استان مادرشو خیلی"
    },
    {
      "id": 39,
      "start": 4003.3,
      "end": 4009.3,
      "formatted_start": "01:06:43.300",
      "formatted_end": "01:06:49.300",
      "text": "خب دو پستونک همون استان شیشه این میدونم مجراش چوزنیه"
    },
    {
      "id": 40,
      "start": 4009.3,
      "end": 4013.3,
      "formatted_start": "01:06:49.300",
      "formatted_end": "01:06:53.300",
      "text": "این رو روغن چپ کنید پیشتو بیدید اقعا بی کم باز بشه"
    },
    {
      "id": 41,
      "start": 4013.3,
      "end": 4016.3,
      "formatted_start": "01:06:53.300",
      "formatted_end": "01:06:56.300",
      "text": "و اگر نه موقع ادرار عذیب کشید"
    },
    {
      "id": 42,
      "start": 4016.3,
      "end": 4018.3,
      "formatted_start": "01:06:56.300",
      "formatted_end": "01:06:58.300",
      "text": "آره بیدیم دیگه تسبیده به همه"
    },
    {
      "id": 43,
      "start": 4018.3,
      "end": 4020.3,
      "formatted_start": "01:06:58.300",
      "formatted_end": "01:07:00.300",
      "text": "همه که گیری میکنه"
    },
    {
      "id": 44,
      "start": 4020.3,
      "end": 4023.3,
      "formatted_start": "01:07:00.300",
      "formatted_end": "01:07:03.300",
      "text": "چون باید این روغن چپ کنید یا زود ختمش کنید"
    },
    {
      "id": 45,
      "start": 4023.3,
      "end": 4024.3,
      "formatted_start": "01:07:03.300",
      "formatted_end": "01:07:04.300",
      "text": "نه باشه"
    },
    {
      "id": 46,
      "start": 4024.3,
      "end": 4033.3,
      "formatted_start": "01:07:04.300",
      "formatted_end": "01:07:13.300",
      "text": "اینجا باید روغن چرک کنید و باید بکشید عرب که باز میشارد"
    },
    {
      "id": 47,
      "start": 4033.3,
      "end": 4040.3,
      "formatted_start": "01:07:13.300",
      "formatted_end": "01:07:20.300",
      "text": "مادر روشی می کنه و داده شما خیلی دسترانسیه"
    },
    {
      "id": 48,
      "start": 4040.3,
      "end": 4044.3,
      "formatted_start": "01:07:20.300",
      "formatted_end": "01:07:24.300",
      "text": "اون ادراع نتونه کنه عدیدش"
    },
    {
      "id": 49,
      "start": 4044.3,
      "end": 4046.3,
      "formatted_start": "01:07:24.300",
      "formatted_end": "01:07:26.300",
      "text": "خیلی بیر بیر ادراع نداره"
    },
    {
      "id": 50,
      "start": 4046.3,
      "end": 4049.3,
      "formatted_start": "01:07:26.300",
      "formatted_end": "01:07:29.300",
      "text": "اما مشکل شیر مادرش رو سرکت"
    },
    {
      "id": 51,
      "start": 4049.3,
      "end": 4051.3,
      "formatted_start": "01:07:29.300",
      "formatted_end": "01:07:31.300",
      "text": "خواهند بخاطر لوکسیمیه"
    },
    {
      "id": 52,
      "start": 4051.3,
      "end": 4054.7,
      "formatted_start": "01:07:31.300",
      "formatted_end": "01:07:34.700",
      "text": "بچه این مشکل داشته اونها خوب شده از چند روز"
    },
    {
      "id": 53,
      "start": 4054.7,
      "end": 4058.18,
      "formatted_start": "01:07:34.700",
      "formatted_end": "01:07:38.180",
      "text": "اگر شیر خشک آنگلا رو با پسنونک عادت کرده"
    },
    {
      "id": 54,
      "start": 4058.18,
      "end": 4059.98,
      "formatted_start": "01:07:38.180",
      "formatted_end": "01:07:39.980",
      "text": "سردی پسنونک رو میگیر و میخوره"
    },
    {
      "id": 55,
      "start": 4059.98,
      "end": 4061.46,
      "formatted_start": "01:07:39.980",
      "formatted_end": "01:07:41.460",
      "text": "اون خوب راحت تره"
    },
    {
      "id": 56,
      "start": 4061.46,
      "end": 4064.02,
      "formatted_start": "01:07:41.460",
      "formatted_end": "01:07:44.020",
      "text": "اگر اون رو بدید شیر مادر خشک میشه"
    },
    {
      "id": 57,
      "start": 4064.02,
      "end": 4066.02,
      "formatted_start": "01:07:44.020",
      "formatted_end": "01:07:46.020",
      "text": "بعد بچه شیر خشکی میشه"
    },
    {
      "id": 58,
      "start": 4066.02,
      "end": 4068.02,
      "formatted_start": "01:07:46.020",
      "formatted_end": "01:07:48.020",
      "text": "بعد ببینید همه شیر خشک بکنید"
    },
    {
      "id": 59,
      "start": 4068.02,
      "end": 4071.54,
      "formatted_start": "01:07:48.020",
      "formatted_end": "01:07:51.540",
      "text": "سردی کنید شیر خشک رو با شیشه درست کنید"
    },
    {
      "id": 60,
      "start": 4071.54,
      "end": 4076.42,
      "formatted_start": "01:07:51.540",
      "formatted_end": "01:07:56.420",
      "text": "با قاشق یا قطعه چکان با یک چیزی دیگه ای بدید"
    },
    {
      "id": 61,
      "start": 4076.42,
      "end": 4082.42,
      "formatted_start": "01:07:56.420",
      "formatted_end": "01:08:02.420",
      "text": "خوب؟ جان اگر اون شیشه رو بگیره دائم دیگه سینه رو بیمی گیره"
    },
    {
      "id": 62,
      "start": 4082.42,
      "end": 4084.42,
      "formatted_start": "01:08:02.420",
      "formatted_end": "01:08:04.420",
      "text": "پس شیشه عادت نکنه به دهنش"
    },
    {
      "id": 63,
      "start": 4084.42,
      "end": 4086.42,
      "formatted_start": "01:08:04.420",
      "formatted_end": "01:08:06.420",
      "text": "تو باید زردی شوید؟"
    },
    {
      "id": 64,
      "start": 4086.42,
      "end": 4092.42,
      "formatted_start": "01:08:06.420",
      "formatted_end": "01:08:12.420",
      "text": "بله، بله، هران کاملا زرده، یه زردی متوسط داره، پیشتر هم میشه"
    },
    {
      "id": 65,
      "start": 4092.42,
      "end": 4094.42,
      "formatted_start": "01:08:12.420",
      "formatted_end": "01:08:14.420",
      "text": "چون یکی دو بزرگ ها شاید زرد نبوده"
    },
    {
      "id": 66,
      "start": 4094.42,
      "end": 4098.42,
      "formatted_start": "01:08:14.420",
      "formatted_end": "01:08:18.420",
      "text": "دیگه رو دستا ببرید براشه، این چهره هایی سر به مانشین بگیر"
    },
    {
      "id": 67,
      "start": 4098.42,
      "end": 4103.42,
      "formatted_start": "01:08:18.420",
      "formatted_end": "01:08:23.420",
      "text": "بعد یک پلس هایی ها میگیرسم صبح و شب یک چار رو تو آب حل کنید"
    },
    {
      "id": 68,
      "start": 4103.42,
      "end": 4106.42,
      "formatted_start": "01:08:23.420",
      "formatted_end": "01:08:26.420",
      "text": "به بچه بدین"
    },
    {
      "id": 69,
      "start": 4106.42,
      "end": 4109.42,
      "formatted_start": "01:08:26.420",
      "formatted_end": "01:08:29.420",
      "text": "از خامسمیه دستو بگیرون بگیرون؟ آره"
    },
    {
      "id": 70,
      "start": 4109.42,
      "end": 4112.42,
      "formatted_start": "01:08:29.420",
      "formatted_end": "01:08:32.420",
      "text": "خامسمیه ده اونجور است؟ بله بله"
    },
    {
      "id": 71,
      "start": 4112.42,
      "end": 4118.42,
      "formatted_start": "01:08:32.420",
      "formatted_end": "01:08:38.420",
      "text": "بعد دمای اتاق رو بیست هشت درجه نگرده آیا جانتیه"
    },
    {
      "id": 72,
      "start": 4118.42,
      "end": 4120.42,
      "formatted_start": "01:08:38.420",
      "formatted_end": "01:08:40.420",
      "text": "ببین هوای گرمه"
    },
    {
      "id": 73,
      "start": 4120.42,
      "end": 4125.42,
      "formatted_start": "01:08:40.420",
      "formatted_end": "01:08:45.420",
      "text": "من الان کله رو بگیرم؟ نگیرم برای بچه؟ نه کله روشن کنید"
    },
    {
      "id": 74,
      "start": 4125.42,
      "end": 4132.42,
      "formatted_start": "01:08:45.420",
      "formatted_end": "01:08:52.420",
      "text": "اگر کلیه ها رو نفردن کلیه ستره جه پنج کم روشنه تا زرن کلیه پنج رو روشنه کرده برقرار از این میشه"
    },
    {
      "id": 75,
      "start": 4132.42,
      "end": 4140.42,
      "formatted_start": "01:08:52.420",
      "formatted_end": "01:09:00.420",
      "text": "اینی که شما چون گرمه هم زیرون لامپا بهتره حتما تو ستره جه هیچی هم نمیشه بچه"
    },
    {
      "id": 76,
      "start": 4140.42,
      "end": 4142.42,
      "formatted_start": "01:09:00.420",
      "formatted_end": "01:09:02.420",
      "text": "بله نبازشون فیزیکشون نیست"
    },
    {
      "id": 77,
      "start": 4142.42,
      "end": 4145.42,
      "formatted_start": "01:09:02.420",
      "formatted_end": "01:09:05.420",
      "text": "آرزون توضیح میده لخت باید باشه یه پلاستیپه چشم"
    },
    {
      "id": 78,
      "start": 4145.42,
      "end": 4146.42,
      "formatted_start": "01:09:05.420",
      "formatted_end": "01:09:06.420",
      "text": "چند زاییتون نگه شده؟"
    },
    {
      "id": 79,
      "start": 4146.42,
      "end": 4148.42,
      "formatted_start": "01:09:06.420",
      "formatted_end": "01:09:08.420",
      "text": "یه پیرن یه دو شب آنوز پیرن"
    },
    {
      "id": 80,
      "start": 4148.42,
      "end": 4150.42,
      "formatted_start": "01:09:08.420",
      "formatted_end": "01:09:10.420",
      "text": "آره به ترتیب نقل میخوریم"
    },
    {
      "id": 81,
      "start": 4150.42,
      "end": 4152.42,
      "formatted_start": "01:09:10.420",
      "formatted_end": "01:09:12.420",
      "text": "میگه باشه باید پنج شب نگرده"
    },
    {
      "id": 82,
      "start": 4152.42,
      "end": 4154.42,
      "formatted_start": "01:09:12.420",
      "formatted_end": "01:09:14.420",
      "text": "پس شما همین چهره هک ساعت برد"
    },
    {
      "id": 83,
      "start": 4154.42,
      "end": 4156.42,
      "formatted_start": "01:09:14.420",
      "formatted_end": "01:09:16.420",
      "text": "پهرم بود"
    },
    {
      "id": 84,
      "start": 4156.42,
      "end": 4158.42,
      "formatted_start": "01:09:16.420",
      "formatted_end": "01:09:18.420",
      "text": "بذار این شبها با این خوب شد"
    },
    {
      "id": 85,
      "start": 4158.42,
      "end": 4160.42,
      "formatted_start": "01:09:18.420",
      "formatted_end": "01:09:20.420",
      "text": "اگر نشد باز دوباره ما میگیم بیشتر بزاریم"
    },
    {
      "id": 86,
      "start": 4160.42,
      "end": 4162.42,
      "formatted_start": "01:09:20.420",
      "formatted_end": "01:09:22.420",
      "text": "باز دوباره ما بیرم به شما"
    },
    {
      "id": 87,
      "start": 4162.42,
      "end": 4164.42,
      "formatted_start": "01:09:22.420",
      "formatted_end": "01:09:24.420",
      "text": "بعد سه شمبه"
    },
    {
      "id": 88,
      "start": 4164.42,
      "end": 4166.42,
      "formatted_start": "01:09:24.420",
      "formatted_end": "01:09:26.420",
      "text": "سه شمبه باز برم شما"
    },
    {
      "id": 89,
      "start": 4166.42,
      "end": 4168.42,
      "formatted_start": "01:09:26.420",
      "formatted_end": "01:09:28.420",
      "text": "خواهش میکنم خوردون شما"
    },
    {
      "id": 90,
      "start": 4168.42,
      "end": 4170.42,
      "formatted_start": "01:09:28.420",
      "formatted_end": "01:09:30.420",
      "text": "داروان که از پایین بگیرم"
    },
    {
      "id": 91,
      "start": 4170.42,
      "end": 4172.42,
      "formatted_start": "01:09:30.420",
      "formatted_end": "01:09:32.420",
      "text": "آره داروانم بگیر بیا"
    },
    {
      "id": 92,
      "start": 4172.42,
      "end": 4174.42,
      "formatted_start": "01:09:32.420",
      "formatted_end": "01:09:34.420",
      "text": "خواهش میکنم بگیرم"
    },
    {
      "id": 93,
      "start": 4174.42,
      "end": 4176.42,
      "formatted_start": "01:09:34.420",
      "formatted_end": "01:09:36.420",
      "text": "برگردید"
    },
    {
      "id": 94,
      "start": 4176.42,
      "end": 4178.42,
      "formatted_start": "01:09:36.420",
      "formatted_end": "01:09:38.420",
      "text": "برگردید"
    },
    {
      "id": 95,
      "start": 4178.42,
      "end": 4180.42,
      "formatted_start": "01:09:38.420",
      "formatted_end": "01:09:40.420",
      "text": "برگردید"
    }
  ],
  "status": "completed"
}