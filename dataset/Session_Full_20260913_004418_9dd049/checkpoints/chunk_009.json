      "start": 2903.0,
      "end": 2905.0,
      "formatted_start": "00:48:23.000",
      "formatted_end": "00:48:25.000",
      "text": "برزه بیشتر"
    },
    {
      "id": 61,
      "start": 2905.0,
      "end": 2907.0,
      "formatted_start": "00:48:25.000",
      "formatted_end": "00:48:27.000",
      "text": "یعنی الان درد داره؟"
    },
    {
      "id": 62,
      "start": 2907.0,
      "end": 2909.0,
      "formatted_start": "00:48:27.000",
      "formatted_end": "00:48:29.000",
      "text": "این در رو بیناس دارم"
    },
    {
      "id": 63,
      "start": 2909.0,
      "end": 2911.0,
      "formatted_start": "00:48:29.000",
      "formatted_end": "00:48:31.000",
      "text": "سرسدار زیاد مواند"
    },
    {
      "id": 64,
      "start": 2915.0,
      "end": 2917.0,
      "formatted_start": "00:48:35.000",
      "formatted_end": "00:48:37.000",
      "text": "یعنی اینجا درد داره؟"
    },
    {
      "id": 65,
      "start": 2917.0,
      "end": 2919.0,
      "formatted_start": "00:48:37.000",
      "formatted_end": "00:48:39.000",
      "text": "اینجا درد داره؟"
    },
    {
      "id": 66,
      "start": 2921.0,
      "end": 2923.0,
      "formatted_start": "00:48:41.000",
      "formatted_end": "00:48:43.000",
      "text": "اینجا درد داره؟"
    },
    {
      "id": 67,
      "start": 2923.0,
      "end": 2925.0,
      "formatted_start": "00:48:43.000",
      "formatted_end": "00:48:45.000",
      "text": "اینجا؟"
    },
    {
      "id": 68,
      "start": 2925.0,
      "end": 2927.0,
      "formatted_start": "00:48:45.000",
      "formatted_end": "00:48:47.000",
      "text": "اینجا کشتر درد می کنه یا اینجا؟"
    },
    {
      "id": 69,
      "start": 2927.0,
      "end": 2935.0,
      "formatted_start": "00:48:47.000",
      "formatted_end": "00:48:55.000",
      "text": "اینجا. چرا اونجا میشون؟ اینجا درد میکنه. آقا پیشتر. میسوزه یا درد داره؟"
    },
    {
      "id": 70,
      "start": 2935.0,
      "end": 2940.0,
      "formatted_start": "00:48:55.000",
      "formatted_end": "00:49:00.000",
      "text": "درد داره. درد داره. سوال آقا نارتی میده تو خانواده ایما دارین؟"
    },
    {
      "id": 71,
      "start": 2940.0,
      "end": 2945.0,
      "formatted_start": "00:49:00.000",
      "formatted_end": "00:49:05.000",
      "text": "نمی کنم داشته باشم. چون بیشتر از میده. چون پرپوری میکنم داشته باشم. نه پرپوری نه."
    },
    {
      "id": 72,
      "start": 2945.0,
      "end": 2949.0,
      "formatted_start": "00:49:05.000",
      "formatted_end": "00:49:09.000",
      "text": "نه خبینم دارم. نه داری نارتی میده با پرپوری فرق داره."
    },
    {
      "id": 73,
      "start": 2949.0,
      "end": 2954.0,
      "formatted_start": "00:49:09.000",
      "formatted_end": "00:49:14.000",
      "text": "مثلا نارتی میده درد دارن میسوزه میدهشون میبینید هست که خانوا بگه"
    },
    {
      "id": 74,
      "start": 2954.0,
      "end": 2958.0,
      "formatted_start": "00:49:14.000",
      "formatted_end": "00:49:18.000",
      "text": "هست فکر کنم پدرش هست داره این چیزو با میده ما سر و خرد داره"
    },
    {
      "id": 75,
      "start": 2958.0,
      "end": 2959.0,
      "formatted_start": "00:49:18.000",
      "formatted_end": "00:49:19.000",
      "text": "نبیدونم"
    },
    {
      "id": 76,
      "start": 2959.0,
      "end": 2960.0,
      "formatted_start": "00:49:19.000",
      "formatted_end": "00:49:20.000",
      "text": "سواگه داریم"
    },
    {
      "id": 77,
      "start": 2960.0,
      "end": 2965.0,
      "formatted_start": "00:49:20.000",
      "formatted_end": "00:49:25.000",
      "text": "این کسان بزرگه من به خاطر رو هم پرویده نه الان من میگم ببخشید"
    },
    {
      "id": 78,
      "start": 2965.0,
      "end": 2967.0,
      "formatted_start": "00:49:25.000",
      "formatted_end": "00:49:27.000",
      "text": "ببخشید خواهشی کن"
    },
    {
      "id": 79,
      "start": 2967.0,
      "end": 2970.0,
      "formatted_start": "00:49:27.000",
      "formatted_end": "00:49:30.000",
      "text": "میگه مثلا ماما میرن دست شوید باید که ببخشید من"
    },
    {
      "id": 80,
      "start": 2970.0,
      "end": 2972.0,
      "formatted_start": "00:49:30.000",
      "formatted_end": "00:49:32.000",
      "text": "این شاله من ازش نیکرسم"
    },
    {
      "id": 81,
      "start": 2972.0,
      "end": 2974.92,
      "formatted_start": "00:49:32.000",
      "formatted_end": "00:49:34.920",
      "text": "نکنه بودی سر داره که بگیر نشون"
    },
    {
      "id": 82,
      "start": 2974.92,
      "end": 2978.12,
      "formatted_start": "00:49:34.920",
      "formatted_end": "00:49:38.120",
      "text": "ولی وقتی می‌گیر دستشون می‌کنم بعد از این کار"
    },
    {
      "id": 83,
      "start": 2978.12,
      "end": 2981.48,
      "formatted_start": "00:49:38.120",
      "formatted_end": "00:49:41.480",
      "text": "کار نه باید میاد دید و سر می‌دشت می‌سوزه"
    },
    {
      "id": 84,
      "start": 2981.48,
      "end": 2982.96,
      "formatted_start": "00:49:41.480",
      "formatted_end": "00:49:42.960",
      "text": "می‌گرد می‌کنه"
    },
    {
      "id": 85,
      "start": 2982.96,
      "end": 2983.92,
      "formatted_start": "00:49:42.960",
      "formatted_end": "00:49:43.920",
      "text": "بعد از دستشون؟"
    },
    {
      "id": 86,
      "start": 2983.92,
      "end": 2985.76,
      "formatted_start": "00:49:43.920",
      "formatted_end": "00:49:45.760",
      "text": "پس حتی بالا آرانشون می‌گیر"
    },
    {
      "id": 87,
      "start": 2985.76,
      "end": 2986.52,
      "formatted_start": "00:49:45.760",
      "formatted_end": "00:49:46.520",
      "text": "پسرم می‌گیر"
    },
    {
      "id": 88,
      "start": 2986.52,
      "end": 2987.84,
      "formatted_start": "00:49:46.520",
      "formatted_end": "00:49:47.840",
      "text": "از چیز داریم؟"
    },
    {
      "id": 89,
      "start": 2987.84,
      "end": 2989.8,
      "formatted_start": "00:49:47.840",
      "formatted_end": "00:49:49.800",
      "text": "پسرم، آران برداریم"
    },
    {
      "id": 90,
      "start": 2989.8,
      "end": 2992.52,
      "formatted_start": "00:49:49.800",
      "formatted_end": "00:49:52.520",
      "text": "هم سرم خیلی باید ببخشید"
    },
    {
      "id": 91,
      "start": 2992.52,
      "end": 2995.52,
      "formatted_start": "00:49:52.520",
      "formatted_end": "00:49:55.520",
      "text": "صبح ناشتا، تا بیدار می‌شه باید به دستشونی"
    },
    {
      "id": 92,
      "start": 2995.52,
      "end": 2997.44,
      "formatted_start": "00:49:55.520",
      "formatted_end": "00:49:57.440",
      "text": "مشکلات با وارشی داریم"
    }
  ],
  "status": "completed"
}