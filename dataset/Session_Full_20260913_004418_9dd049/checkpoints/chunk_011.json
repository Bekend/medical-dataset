    },
    {
      "id": 26,
      "start": 3362.0,
      "end": 3364.0,
      "formatted_start": "00:56:02.000",
      "formatted_end": "00:56:04.000",
      "text": "باید اینجا مطروز"
    },
    {
      "id": 27,
      "start": 3364.0,
      "end": 3366.0,
      "formatted_start": "00:56:04.000",
      "formatted_end": "00:56:06.000",
      "text": "محمد صدرا"
    },
    {
      "id": 28,
      "start": 3366.0,
      "end": 3368.0,
      "formatted_start": "00:56:06.000",
      "formatted_end": "00:56:08.000",
      "text": "نه نه نه"
    },
    {
      "id": 29,
      "start": 3368.0,
      "end": 3371.84,
      "formatted_start": "00:56:08.000",
      "formatted_end": "00:56:11.840",
      "text": "از شب پس شبیه رو بادون ها خیلی"
    },
    {
      "id": 30,
      "start": 3371.84,
      "end": 3375.02,
      "formatted_start": "00:56:11.840",
      "formatted_end": "00:56:15.020",
      "text": "یا تو تکیه سدید میترسه اینقدر خب"
    },
    {
      "id": 31,
      "start": 3375.02,
      "end": 3378.5,
      "formatted_start": "00:56:15.020",
      "formatted_end": "00:56:18.500",
      "text": "یا دکتر زیاد رفته آمپول خورده میترسه"
    },
    {
      "id": 32,
      "start": 3378.5,
      "end": 3381.5,
      "formatted_start": "00:56:18.500",
      "formatted_end": "00:56:21.500",
      "text": "این که کچیک بوده خیلی دکتوری بود"
    },
    {
      "id": 33,
      "start": 3381.5,
      "end": 3383.28,
      "formatted_start": "00:56:21.500",
      "formatted_end": "00:56:23.280",
      "text": "خیلی دکتر رفته"
    },
    {
      "id": 34,
      "start": 3383.28,
      "end": 3384.44,
      "formatted_start": "00:56:23.280",
      "formatted_end": "00:56:24.440",
      "text": "آمپول ها زیاد خواهد"
    },
    {
      "id": 35,
      "start": 3384.44,
      "end": 3385.06,
      "formatted_start": "00:56:24.440",
      "formatted_end": "00:56:25.060",
      "text": "آمپول رفته"
    },
    {
      "id": 36,
      "start": 3385.06,
      "end": 3387.18,
      "formatted_start": "00:56:25.060",
      "formatted_end": "00:56:27.180",
      "text": "هران میترسه برای آمپول هاره؟"
    },
    {
      "id": 37,
      "start": 3387.18,
      "end": 3387.64,
      "formatted_start": "00:56:27.180",
      "formatted_end": "00:56:27.640",
      "text": "آمپول نیست"
    },
    {
      "id": 38,
      "start": 3387.64,
      "end": 3388.46,
      "formatted_start": "00:56:27.640",
      "formatted_end": "00:56:28.460",
      "text": "نه آمپول چی نه"
    },
    {
      "id": 39,
      "start": 3388.46,
      "end": 3389.28,
      "formatted_start": "00:56:28.460",
      "formatted_end": "00:56:29.280",
      "text": "چون چند نیست"
    },
    {
      "id": 40,
      "start": 3389.28,
      "end": 3390.26,
      "formatted_start": "00:56:29.280",
      "formatted_end": "00:56:30.260",
      "text": "نه نه"
    },
    {
      "id": 41,
      "start": 3390.26,
      "end": 3392.64,
      "formatted_start": "00:56:30.260",
      "formatted_end": "00:56:32.640",
      "text": "ماما سده ها میردیش همون؟"
    },
    {
      "id": 42,
      "start": 3392.64,
      "end": 3393.48,
      "formatted_start": "00:56:32.640",
      "formatted_end": "00:56:33.480",
      "text": "نه نه شبیه سده"
    },
    {
      "id": 43,
      "start": 3393.48,
      "end": 3395.48,
      "formatted_start": "00:56:33.480",
      "formatted_end": "00:56:35.480",
      "text": "بیا از این راه ها رو نگاه کن"
    },
    {
      "id": 44,
      "start": 3395.48,
      "end": 3397.48,
      "formatted_start": "00:56:35.480",
      "formatted_end": "00:56:37.480",
      "text": "مامت من نگاه کرده"
    },
    {
      "id": 45,
      "start": 3397.48,
      "end": 3399.48,
      "formatted_start": "00:56:37.480",
      "formatted_end": "00:56:39.480",
      "text": "پس من می آمد یه دقیقه گوشی بزنم"
    },
    {
      "id": 46,
      "start": 3399.48,
      "end": 3401.48,
      "formatted_start": "00:56:39.480",
      "formatted_end": "00:56:41.480",
      "text": "بینم چی بیدیم"
    },
    {
      "id": 47,
      "start": 3401.48,
      "end": 3403.48,
      "formatted_start": "00:56:41.480",
      "formatted_end": "00:56:43.480",
      "text": "باشه؟ خودش می شنم"
    },
    {
      "id": 48,
      "start": 3403.48,
      "end": 3405.48,
      "formatted_start": "00:56:43.480",
      "formatted_end": "00:56:45.480",
      "text": "بخش کن"
    },
    {
      "id": 49,
      "start": 3405.48,
      "end": 3407.48,
      "formatted_start": "00:56:45.480",
      "formatted_end": "00:56:47.480",
      "text": "بخش کن"
    },
    {
      "id": 50,
      "start": 3407.48,
      "end": 3409.48,
      "formatted_start": "00:56:47.480",
      "formatted_end": "00:56:49.480",
      "text": "خیلی خوب"
    },
    {
      "id": 51,
      "start": 3409.48,
      "end": 3411.48,
      "formatted_start": "00:56:49.480",
      "formatted_end": "00:56:51.480",
      "text": "خیلی خوب"
    },
    {
