      "start": 3346.0,
      "end": 3348.0,
      "formatted_start": "00:55:46.000",
      "formatted_end": "00:55:48.000",
      "text": "6 سالش تموم شده"
    },
    {
      "id": 19,
      "start": 3348.0,
      "end": 3350.0,
      "formatted_start": "00:55:48.000",
      "formatted_end": "00:55:50.000",
      "text": "این بزرگتر از اونه؟"
