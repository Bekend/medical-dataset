  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5430.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:30.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5434.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:34.000",
      "text": "کم کیلو وزنیشه؟"
    },
    {
      "id": 2,
      "start": 5434.0,
      "end": 5438.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:38.000",
      "text": "۱۰ کیلوه، یکم از ۳ کیلوه، من درست دیدم نشوندم، یکم از ۱۰ کیلوه باید کمه"
    },
    {
      "id": 3,
      "start": 5438.0,
      "end": 5440.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:40.000",
      "text": "سه میشه قدیم؟"
    },
    {
      "id": 4,
      "start": 5440.0,
      "end": 5442.0,
      "formatted_start": "01:30:40.000",
      "formatted_end": "01:30:42.000",
      "text": "از ۳ سال تا ۱۰ سال تا ۳ سال تا پرمیشه"
    },
    {
      "id": 5,
      "start": 5442.0,
      "end": 5444.0,
      "formatted_start": "01:30:42.000",
      "formatted_end": "01:30:44.000",
      "text": "تو ۴ میده یا ۲ پرمیشه؟"
    },
    {
      "id": 6,
      "start": 5444.0,
      "end": 5446.0,
      "formatted_start": "01:30:44.000",
      "formatted_end": "01:30:46.000",
      "text": "۲ شانان، حالا ۲ه دیگه"
    },
    {
      "id": 7,
      "start": 5446.0,
      "end": 5448.0,
      "formatted_start": "01:30:46.000",
      "formatted_end": "01:30:48.000",
      "text": "پا ۲ باشه ۱۰ کیلوه خوبه"
    },
    {
      "id": 8,
      "start": 5448.0,
      "end": 5452.0,
      "formatted_start": "01:30:48.000",
      "formatted_end": "01:30:52.000",
      "text": "۲ سال تا پرمیشه، اگه بیست و چهار"
    },
    {
      "id": 9,
      "start": 5452.0,
      "end": 5457.0,
      "formatted_start": "01:30:52.000",
      "formatted_end": "01:30:57.000",
      "text": "به ماه بگیر 24 پر میشه و ولده 25 میشه"
    },
    {
      "id": 10,
      "start": 5457.0,
      "end": 5460.0,
      "formatted_start": "01:30:57.000",
      "formatted_end": "01:31:00.000",
      "text": "پس اونجوره 36 پر میشه؟"
    },
    {
      "id": 11,
      "start": 5460.0,
      "end": 5461.0,
      "formatted_start": "01:31:00.000",
      "formatted_end": "01:31:01.000",
      "text": "نه"
    },
    {
      "id": 12,
      "start": 5461.0,
      "end": 5464.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:04.000",
      "text": "خب کمه، یکی دو کیلو کمه"
    },
    {
      "id": 13,
      "start": 5464.0,
      "end": 5468.0,
      "formatted_start": "01:31:04.000",
      "formatted_end": "01:31:08.000",
      "text": "خیلی عبنه ولی مثلا اینجا باید 13-14 درسته باشه"
    },
    {
      "id": 14,
      "start": 5473.0,
      "end": 5476.0,
      "formatted_start": "01:31:13.000",
      "formatted_end": "01:31:16.000",
      "text": "این داروها شو بیار من ببینم"
    },
    {
      "id": 15,
      "start": 5476.0,
      "end": 5481.0,
      "formatted_start": "01:31:16.000",
      "formatted_end": "01:31:21.000",
      "text": "خیلی بیقراره؟"
    },
    {
      "id": 16,
      "start": 5481.0,
      "end": 5485.0,
      "formatted_start": "01:31:21.000",
      "formatted_end": "01:31:25.000",
      "text": "امروز بیگرده بیگرده که چیزم ها نداره"
    },
    {
      "id": 17,
      "start": 5485.0,
      "end": 5488.0,
      "formatted_start": "01:31:25.000",
      "formatted_end": "01:31:28.000",
      "text": "نه بی حاله، هرنا چون تخت داره بیگرده"
    },
    {
      "id": 18,
      "start": 5488.0,
      "end": 5490.0,
      "formatted_start": "01:31:28.000",
      "formatted_end": "01:31:30.000",
      "text": "یه جان این برای راه شده بیاری من ببینم"
    },
    {
      "id": 19,
      "start": 5490.0,
      "end": 5492.0,
      "formatted_start": "01:31:30.000",
      "formatted_end": "01:31:32.000",
      "text": "از سه آب دیزش اینا که نداشت"
    },
    {
      "id": 20,
      "start": 5492.0,
      "end": 5493.0,
      "formatted_start": "01:31:32.000",
      "formatted_end": "01:31:33.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 5493.0,
      "end": 5496.0,
      "formatted_start": "01:31:33.000",
      "formatted_end": "01:31:36.000",
      "text": "اگه علایم یک جدیدی برومت مراجعه"
    },
    {
      "id": 22,
      "start": 5496.0,
      "end": 5500.0,
      "formatted_start": "01:31:36.000",
      "formatted_end": "01:31:40.000",
      "text": "یا اگه طب اش مثلا چه چه چه ساعت بعد کنترل نشد مراجعه"
    },
    {
      "id": 23,
      "start": 5500.0,
      "end": 5503.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:43.000",
      "text": "خواهش میتونم تا درست بشین"
    },
    {
      "id": 24,
      "start": 5506.0,
      "end": 5521.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:32:01.000",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 5536.0,
      "end": 5546.0,
      "formatted_start": "01:32:16.000",
      "formatted_end": "01:32:26.000",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 5566.0,
      "end": 5568.0,
      "formatted_start": "01:32:46.000",
      "formatted_end": "01:32:48.000",
      "text": "این هایی که باید برداشت باشد."
    },
    {
      "id": 27,
      "start": 5568.0,
      "end": 5570.0,
      "formatted_start": "01:32:48.000",
      "formatted_end": "01:32:50.000",
      "text": "این هایی که باید برداشت باشد."
    },
