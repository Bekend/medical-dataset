      "end": 5675.52,
      "formatted_start": "01:34:33.520",
      "formatted_end": "01:34:35.520",
      "text": "نبوزی، می این چیزها داری"
    },
    {
      "id": 47,
      "start": 5675.52,
      "end": 5679.2,
      "formatted_start": "01:34:35.520",
      "formatted_end": "01:34:39.200",
      "text": "برای خونه، برای کانه هاده، برای کچه ها، خیلی برای ما"
    },
    {
      "id": 48,
      "start": 5679.2,
      "end": 5682.72,
      "formatted_start": "01:34:39.200",
      "formatted_end": "01:34:42.720",
      "text": "مودتو بذاشتی آخر سر تا به نیه راحتت باشن"
    },
    {
      "id": 49,
      "start": 5682.72,
      "end": 5686.72,
      "formatted_start": "01:34:42.720",
      "formatted_end": "01:34:46.720",
      "text": "وقتی تصویری ادامه داری، وقتی دلت استراد میخواست"
    },
    {
      "id": 50,
      "start": 5686.72,
      "end": 5688.72,
      "formatted_start": "01:34:46.720",
      "formatted_end": "01:34:48.720",
      "text": "باز هم مسکومیت ها موجود داره"
    },
    {
      "id": 51,
      "start": 5688.72,
      "end": 5691.76,
      "formatted_start": "01:34:48.720",
      "formatted_end": "01:34:51.760",
      "text": "اما حالا من فرشه، یه چیز رو یادت"
    },
    {
      "id": 52,
      "start": 5691.76,
      "end": 5694.26,
      "formatted_start": "01:34:51.760",
      "formatted_end": "01:34:54.260",
      "text": "ازش رو از سبزار کردم"
    },
    {
      "id": 53,
      "start": 5694.26,
      "end": 5695.46,
      "formatted_start": "01:34:54.260",
      "formatted_end": "01:34:55.460",
      "text": "همیشه قریب بودن نیست"
    },
    {
      "id": 54,
      "start": 5695.46,
      "end": 5698.48,
      "formatted_start": "01:34:55.460",
      "formatted_end": "01:34:58.480",
