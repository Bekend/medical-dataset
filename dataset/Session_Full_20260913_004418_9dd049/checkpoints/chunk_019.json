  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5730.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:30.000",
      "text": "درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درسته از اینجا، درست"
    },
    {
      "id": 1,
      "start": 5730.0,
      "end": 5746.34,
      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:46.340",
      "text": "این روز روش نوشته این روز رو باب این کورتی مقصاد روز این روز روز ده باب این شیعه نصف شرح هیچ ساعت بره این هم برای سختگی پشتشه"
    },
    {
      "id": 2,
      "start": 5746.34,
      "end": 5749.34,
      "formatted_start": "01:35:46.340",
      "formatted_end": "01:35:49.340",
      "text": "اون پولش هم در این همین جا کنشی میزنه"
    },
    {
      "id": 3,
      "start": 5749.34,
      "end": 5751.34,
      "formatted_start": "01:35:49.340",
      "formatted_end": "01:35:51.340",
      "text": "بعد درسته داره"
    },
    {
      "id": 4,
      "start": 5751.34,
      "end": 5753.34,
      "formatted_start": "01:35:51.340",
      "formatted_end": "01:35:53.340",
      "text": "این پروفین با میده پر بده"
    },
    {
      "id": 5,
      "start": 5753.34,
      "end": 5755.34,
      "formatted_start": "01:35:53.340",
      "formatted_end": "01:35:55.340",
      "text": "بعد از غذا بده خال می نداشته"
    },
    {
      "id": 6,
      "start": 5755.34,
      "end": 5757.34,
      "formatted_start": "01:35:55.340",
      "formatted_end": "01:35:57.340",
      "text": "برای کفت بوده"
    },
    {
      "id": 7,
      "start": 5757.34,
      "end": 5760.34,
      "formatted_start": "01:35:57.340",
      "formatted_end": "01:36:00.340",
      "text": "یه هر وقت که کفت هست درست کنه؟"
    },
    {
      "id": 8,
      "start": 5760.34,
      "end": 5762.34,
      "formatted_start": "01:36:00.340",
      "formatted_end": "01:36:02.340",
      "text": "نه دیگه دیگه"
    },
    {
      "id": 9,
      "start": 5762.34,
      "end": 5765.34,
      "formatted_start": "01:36:02.340",
      "formatted_end": "01:36:05.340",
      "text": "این حواست باشه شما الان شروع کن"
    },
    {
      "id": 10,
      "start": 5765.34,
      "end": 5768.34,
      "formatted_start": "01:36:05.340",
      "formatted_end": "01:36:08.340",
      "text": "کنبای نیست مثلا دست و شب کفت می کنه تشنجوشی کنی"
    },
    {
      "id": 11,
      "start": 5768.34,
      "end": 5771.34,
      "formatted_start": "01:36:08.340",
      "formatted_end": "01:36:11.340",
      "text": "تو باید داده باشه هر مورد"
    },
    {
      "id": 12,
      "start": 5771.34,
      "end": 5773.34,
      "formatted_start": "01:36:11.340",
      "formatted_end": "01:36:13.340",
      "text": "کفت بده این بچه این بودیم بیمار"
    },
    {
      "id": 13,
      "start": 5773.34,
      "end": 5774.34,
      "formatted_start": "01:36:13.340",
      "formatted_end": "01:36:14.340",
      "text": "چند سیتی؟"
    },
    {
      "id": 14,
      "start": 5774.34,
      "end": 5775.84,
      "formatted_start": "01:36:14.340",
      "formatted_end": "01:36:15.840",
      "text": "چند سی سی چونیه باشه؟"
    },
    {
      "id": 15,
      "start": 5775.84,
      "end": 5776.64,
      "formatted_start": "01:36:15.840",
      "formatted_end": "01:36:16.640",
      "text": "دو و نیم سی سی"
    },
    {
      "id": 16,
      "start": 5776.64,
      "end": 5779.76,
      "formatted_start": "01:36:16.640",
      "formatted_end": "01:36:19.760",
      "text": "پس سه سی سی هم داری اشکال نداره"
    },
    {
      "id": 17,
      "start": 5779.76,
      "end": 5782.24,
      "formatted_start": "01:36:19.760",
      "formatted_end": "01:36:22.240",
      "text": "همه داروه شدن دو و نیم سی سی"
    },
    {
      "id": 18,
      "start": 5782.24,
      "end": 5783.86,
      "formatted_start": "01:36:22.240",
      "formatted_end": "01:36:23.860",
      "text": "برسته داروش"
    },
    {
      "id": 19,
      "start": 5783.86,
      "end": 5785.44,
      "formatted_start": "01:36:23.860",
      "formatted_end": "01:36:25.440",
      "text": "بدم فلش هم داریم"
    },
    {
      "id": 20,
      "start": 5785.44,
      "end": 5785.86,
      "formatted_start": "01:36:25.440",
      "formatted_end": "01:36:25.860",
      "text": "باشه"
    },
    {
      "id": 21,
      "start": 5785.86,
      "end": 5786.64,
      "formatted_start": "01:36:25.860",
      "formatted_end": "01:36:26.640",
      "text": "تا درست"
    },
    {
      "id": 22,
      "start": 5786.64,
      "end": 5794.14,
      "formatted_start": "01:36:26.640",
      "formatted_end": "01:36:34.140",
      "text": "یه نکته جالب"
    },
    {
      "id": 23,
      "start": 5794.14,
      "end": 5797.28,
      "formatted_start": "01:36:34.140",
      "formatted_end": "01:36:37.280",
      "text": "وقتی کنه یک نفر"
    },
    {
      "id": 24,
      "start": 5797.28,
      "end": 5800.14,
      "formatted_start": "01:36:37.280",
      "formatted_end": "01:36:40.140",
      "text": "در دل دیگر میداریم"
    },
    {
      "id": 25,
      "start": 5800.14,
      "end": 5801.84,
      "formatted_start": "01:36:40.140",
      "formatted_end": "01:36:41.840",
      "text": "انگار که"
    },
    {
      "id": 26,
      "start": 5801.84,
      "end": 5803.38,
      "formatted_start": "01:36:41.840",
      "formatted_end": "01:36:43.380",
      "text": "مستجلش کردی و"
    },
    {
      "id": 27,
      "start": 5803.38,
      "end": 5805.38,
      "formatted_start": "01:36:43.380",
      "formatted_end": "01:36:45.380",
      "text": "من جمعی موردیت خودم بشم"
    },
    {
      "id": 28,
      "start": 5805.38,
      "end": 5809.38,
      "formatted_start": "01:36:45.380",
      "formatted_end": "01:36:49.380",
      "text": "داری که یک چیز گاه رو می کنه"
    },
    {
      "id": 29,
      "start": 5809.38,
      "end": 5813.38,
      "formatted_start": "01:36:49.380",
      "formatted_end": "01:36:53.380",
      "text": "به چزون آدم ها"
    },
    {
      "id": 30,
      "start": 5813.38,
      "end": 5817.38,
      "formatted_start": "01:36:53.380",
      "formatted_end": "01:36:57.380",
      "text": "که رنج و درد و نراحتی و بیرون"
    },
    {
      "id": 31,
      "start": 5817.38,
      "end": 5821.38,
      "formatted_start": "01:36:57.380",
      "formatted_end": "01:37:01.380",
      "text": "عادت کردیم و یک پناهگاه برای ما شده"
    },
    {
      "id": 32,
      "start": 5821.38,
      "end": 5825.38,
      "formatted_start": "01:37:01.380",
      "formatted_end": "01:37:05.380",
      "text": "یک اطلاعی قدرت موردیت خودتون برداری میشه"
    },
    {
      "id": 33,
      "start": 5825.38,
      "end": 5827.38,
      "formatted_start": "01:37:05.380",
      "formatted_end": "01:37:07.380",
      "text": "به نام منگزا درداری شده"
    },
    {
      "id": 34,
      "start": 5827.38,
      "end": 5829.38,
      "formatted_start": "01:37:07.380",
      "formatted_end": "01:37:09.380",
      "text": "من دیگه تاقای نداشتم"
    },
    {
      "id": 35,
      "start": 5829.38,
      "end": 5835.38,
      "formatted_start": "01:37:09.380",
      "formatted_end": "01:37:15.380",
      "text": "من باید بگم ببینم این حالتهایی که در خیابانها و در تلویزیون برای اینکه بودن"
    },
    {
      "id": 36,
      "start": 5835.38,
      "end": 5845.38,
      "formatted_start": "01:37:15.380",
      "formatted_end": "01:37:25.380",
      "text": "من هفته اومد شهری برای ساله ۳۵۷ ایران رو با قصد به گردن برم"
    },
    {
      "id": 37,
      "start": 5845.38,
      "end": 5848.38,
      "formatted_start": "01:37:25.380",
      "formatted_end": "01:37:28.380",
      "text": "ولی تأثیر بود"
    },
    {
      "id": 38,
      "start": 5850.38,
      "end": 5857.38,
      "formatted_start": "01:37:30.380",
      "formatted_end": "01:37:37.380",
      "text": "نمیتونم برای تو توجیه بگم که حالت من در اون ساعت در اون حالت چی بود"
    },
    {
      "id": 39,
      "start": 5857.38,
      "end": 5862.38,
      "formatted_start": "01:37:37.380",
      "formatted_end": "01:37:42.380",
      "text": "در زمین پاست و در بازش رو هم پیش کردم که این را نمیبینم ولی نمیتونم"
    },
    {
      "id": 40,
      "start": 5862.38,
      "end": 5866.38,
      "formatted_start": "01:37:42.380",
      "formatted_end": "01:37:46.380",
      "text": "پیش کردم خودم از بیرون خواهد را بیرون تصور کردم"
    },
    {
      "id": 41,
      "start": 5866.38,
      "end": 5871.38,
      "formatted_start": "01:37:46.380",
      "formatted_end": "01:37:51.380",
      "text": "هنوز زنده هستم ولی کمی نیست که من را را گرم بگه"
    },
    {
      "id": 42,
      "start": 5871.38,
      "end": 5875.38,
      "formatted_start": "01:37:51.380",
      "formatted_end": "01:37:55.380",
      "text": "و از بیرون خواهد بگم این را ببینم"
    },
    {
      "id": 43,
      "start": 5875.38,
      "end": 5878.38,
      "formatted_start": "01:37:55.380",
      "formatted_end": "01:37:58.380",
      "text": "با آب و شعبت من خودم را بزرگ کردم"
    },
    {
      "id": 44,
      "start": 5878.38,
      "end": 5880.38,
      "formatted_start": "01:37:58.380",
      "formatted_end": "01:38:00.380",
      "text": "با میدون را بسیاریم"
    },
    {
      "id": 45,
      "start": 5880.38,
      "end": 5882.38,
      "formatted_start": "01:38:00.380",
      "formatted_end": "01:38:02.380",
      "text": "سفرم؟"
    },
    {
      "id": 46,
      "start": 5882.38,
      "end": 5908.38,
      "formatted_start": "01:38:02.380",
      "formatted_end": "01:38:28.380",
      "text": "موسیقی"
    },
    {
      "id": 47,
      "start": 5908.38,
      "end": 5914.38,
      "formatted_start": "01:38:28.380",
      "formatted_end": "01:38:34.380",
      "text": "فرزنده بزرگ سانداری چند تا موضوعی که فرزنده نیاز داره از زمانه بشنره"
    },
    {
      "id": 48,
      "start": 5914.38,
      "end": 5916.38,
      "formatted_start": "01:38:34.380",
      "formatted_end": "01:38:36.380",
      "text": "را شدیدنشون داره"
    },
    {
      "id": 49,
      "start": 5916.38,
      "end": 5917.38,
      "formatted_start": "01:38:36.380",
      "formatted_end": "01:38:37.380",
      "text": "دارایی دارید نیستی؟"
    },
    {
      "id": 50,
      "start": 5917.38,
      "end": 5918.38,
      "formatted_start": "01:38:37.380",
      "formatted_end": "01:38:38.380",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 5918.38,
      "end": 5923.38,
      "formatted_start": "01:38:38.380",
      "formatted_end": "01:38:43.380",
      "text": "خب بگیریم این اصطنابیتانش را بهش میدید"
    },
    {
      "id": 52,
      "start": 5923.38,
      "end": 5925.38,
      "formatted_start": "01:38:43.380",
      "formatted_end": "01:38:45.380",
      "text": "خب اگر فهم شد بازمون میدیدید"
    },
    {
      "id": 53,
      "start": 5925.38,
      "end": 5930.38,
      "formatted_start": "01:38:45.380",
      "formatted_end": "01:38:50.380",
      "text": "این قرصهاش را در قدس رو بشد"
    },
    {
      "id": 54,
      "start": 5930.38,
      "end": 5932.38,
      "formatted_start": "01:38:50.380",
      "formatted_end": "01:38:52.380",
      "text": "نیخل ۸۰۰"
    },
    {
      "id": 55,
      "start": 5932.38,
      "end": 5933.38,
      "formatted_start": "01:38:52.380",
      "formatted_end": "01:38:53.380",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 5933.38,
      "end": 5935.38,
      "formatted_start": "01:38:53.380",
      "formatted_end": "01:38:55.380",
      "text": "روزی ۳ بار"
    },
    {
      "id": 57,
      "start": 5935.38,
      "end": 5936.38,
      "formatted_start": "01:38:55.380",
      "formatted_end": "01:38:56.380",
      "text": "نصف قرص"
    },
    {
      "id": 58,
      "start": 5936.38,
      "end": 5946.38,
      "formatted_start": "01:38:56.380",
      "formatted_end": "01:39:06.380",
      "text": "این حالوپینی دور صبح یکی شبیه این پیچکه کامل این رو نصفه این رو روز دوبار این رو روز سه بار"
    },
    {
      "id": 59,
      "start": 5946.38,
      "end": 5953.38,
      "formatted_start": "01:39:06.380",
      "formatted_end": "01:39:13.380",
      "text": "این برسه ما میدید پل باشه؟ نیست داره باشه من نیست"
    },
    {
      "id": 60,
      "start": 5953.38,
      "end": 5960.38,
      "formatted_start": "01:39:13.380",
      "formatted_end": "01:39:20.380",
      "text": "باش من نیست بادر باشم آه دیگه این سال دوستم اون روپا بردار بودم سرگیچه داشت سرگیچه برطرف نداشت"
    },
    {
      "id": 61,
      "start": 5960.38,
      "end": 5962.38,
      "formatted_start": "01:39:20.380",
      "formatted_end": "01:39:22.380",
      "text": "نداشت بیتامین دیش"
    },
    {
      "id": 62,
      "start": 5962.38,
      "end": 5964.38,
      "formatted_start": "01:39:22.380",
      "formatted_end": "01:39:24.380",
      "text": "بر طرف نداشت؟ نیشه؟ بر طرف نشده؟"
    },
    {
      "id": 63,
      "start": 5964.38,
      "end": 5966.38,
      "formatted_start": "01:39:24.380",
      "formatted_end": "01:39:26.380",
      "text": "نه"
    },
    {
      "id": 64,
      "start": 5966.38,
      "end": 5968.38,
      "formatted_start": "01:39:26.380",
      "formatted_end": "01:39:28.380",
      "text": "بیتامین دیش فرق کم بود"
    },
    {
      "id": 65,
      "start": 5968.38,
      "end": 5970.38,
      "formatted_start": "01:39:28.380",
      "formatted_end": "01:39:30.380",
      "text": "بیتامین دیش؟ آره آره"
    },
    {
      "id": 66,
      "start": 5970.38,
      "end": 5972.38,
      "formatted_start": "01:39:30.380",
      "formatted_end": "01:39:32.380",
      "text": "دو سه نوبت بدین ببینید"
    },
    {
      "id": 67,
      "start": 5972.38,
      "end": 5974.38,
      "formatted_start": "01:39:32.380",
      "formatted_end": "01:39:34.380",
      "text": "میزانش بیاد بالا"
    },
    {
      "id": 68,
      "start": 5974.38,
      "end": 5976.38,
      "formatted_start": "01:39:34.380",
      "formatted_end": "01:39:36.380",
      "text": "چون بقیه آزمایشاتش خوبه"
    },
    {
      "id": 69,
      "start": 5976.38,
      "end": 5978.38,
      "formatted_start": "01:39:36.380",
      "formatted_end": "01:39:38.380",
      "text": "فرق بیتامین دیش خیلی باید باشه"
    },
    {
      "id": 70,
      "start": 5978.38,
      "end": 5980.38,
      "formatted_start": "01:39:38.380",
      "formatted_end": "01:39:40.380",
      "text": "شانزه بود"
    },
    {
      "id": 71,
      "start": 5980.38,
      "end": 5982.38,
      "formatted_start": "01:39:40.380",
      "formatted_end": "01:39:42.380",
      "text": "عجبه نمیدونید ببینید"
    },
    {
      "id": 72,
      "start": 5982.38,
      "end": 5984.38,
      "formatted_start": "01:39:42.380",
      "formatted_end": "01:39:44.380",
      "text": "یه شعبت سانستار هم اگه براش میگید خوبه"
    },
    {
      "id": 73,
      "start": 5984.38,
      "end": 5986.38,
      "formatted_start": "01:39:44.380",
      "formatted_end": "01:39:46.380",
      "text": "برای دخترم؟ آره آره"
    },
    {
      "id": 74,
      "start": 5986.38,
      "end": 5992.38,
      "formatted_start": "01:39:46.380",
      "formatted_end": "01:39:52.380",
      "text": "این تمام بیتامین های نداره، خنبرده درسته؟"
    },
    {
      "id": 75,
      "start": 5992.38,
      "end": 5994.38,
      "formatted_start": "01:39:52.380",
      "formatted_end": "01:39:54.380",
      "text": "نه، نه"
    },
    {
      "id": 76,
      "start": 5994.38,
      "end": 5996.38,
      "formatted_start": "01:39:54.380",
      "formatted_end": "01:39:56.380",
      "text": "روزی دوباره بیدید"
    },
    {
      "id": 77,
      "start": 5996.38,
      "end": 5998.38,
      "formatted_start": "01:39:56.380",
      "formatted_end": "01:39:58.380",
      "text": "باشه"
    },
    {
      "id": 78,
      "start": 5998.38,
      "end": 6000.38,
      "formatted_start": "01:39:58.380",
      "formatted_end": "01:40:00.380",
      "text": "برده"
    }
  ],
  "status": "completed"
}