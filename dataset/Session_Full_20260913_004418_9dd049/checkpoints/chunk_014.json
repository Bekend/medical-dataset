    },
    {
      "id": 2,
      "start": 4260.0,
      "end": 4280.0,
      "formatted_start": "01:11:00.000",
      "formatted_end": "01:11:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 4290.0,
      "end": 4316.0,
      "formatted_start": "01:11:30.000",
      "formatted_end": "01:11:56.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 4316.0,
      "end": 4318.0,
      "formatted_start": "01:11:56.000",
      "formatted_end": "01:11:58.000",
      "text": "بفهمید"
    },
    {
      "id": 5,
      "start": 4318.0,
      "end": 4320.0,
      "formatted_start": "01:11:58.000",
      "formatted_end": "01:12:00.000",
      "text": "سلام بابای جان"
    },
    {
      "id": 6,
      "start": 4320.0,
      "end": 4322.0,
      "formatted_start": "01:12:00.000",
      "formatted_end": "01:12:02.000",
      "text": "خوشید"
    },
    {
      "id": 7,
      "start": 4322.0,
      "end": 4324.0,
      "formatted_start": "01:12:02.000",
      "formatted_end": "01:12:04.000",
      "text": "خواهشی کنم درم بزن"
    },
    {
      "id": 8,
      "start": 4324.0,
      "end": 4326.0,
      "formatted_start": "01:12:04.000",
      "formatted_end": "01:12:06.000",
      "text": "بزن بزن"
    },
    {
      "id": 9,
      "start": 4326.0,
      "end": 4328.0,
      "formatted_start": "01:12:06.000",
      "formatted_end": "01:12:08.000",
      "text": "بفهمید"
    },
    {
      "id": 10,
      "start": 4328.0,
      "end": 4330.0,
      "formatted_start": "01:12:08.000",
      "formatted_end": "01:12:10.000",
      "text": "آقای فرامنزی چی شده؟"
    },
    {
      "id": 11,
      "start": 4330.0,
      "end": 4332.0,
      "formatted_start": "01:12:10.000",
      "formatted_end": "01:12:12.000",
      "text": "یک هفته پیش"
    },
    {
      "id": 12,
      "start": 4332.0,
      "end": 4334.0,
      "formatted_start": "01:12:12.000",
      "formatted_end": "01:12:14.000",
      "text": "سال و تفتر"
    },
    {
      "id": 13,
      "start": 4334.0,
      "end": 4336.0,
      "formatted_start": "01:12:14.000",
      "formatted_end": "01:12:16.000",
      "text": "سال خیلی شده"
    },
    {
      "id": 14,
      "start": 4336.0,
      "end": 4338.0,
      "formatted_start": "01:12:16.000",
      "formatted_end": "01:12:18.000",
      "text": "از این روزی پنج"
    },
    {
      "id": 15,
      "start": 4338.0,
      "end": 4340.0,
      "formatted_start": "01:12:18.000",
      "formatted_end": "01:12:20.000",
      "text": "از این روزی شش تفتر سال بشید"
    },
    {
      "id": 16,
      "start": 4340.0,
      "end": 4342.0,
      "formatted_start": "01:12:20.000",
      "formatted_end": "01:12:22.000",
      "text": "یه روز صبح بردیم پیش دکتر"
    },
    {
      "id": 17,
      "start": 4342.0,
      "end": 4344.0,
      "formatted_start": "01:12:22.000",
      "formatted_end": "01:12:24.000",
      "text": "گروه بردیم پیش دکتر نسلین پاتر"
    },
    {
      "id": 18,
      "start": 4344.0,
      "end": 4346.0,
      "formatted_start": "01:12:24.000",
      "formatted_end": "01:12:26.000",
      "text": "دکتر زن با چالو"
    },
    {
      "id": 19,
      "start": 4346.0,
      "end": 4348.0,
      "formatted_start": "01:12:26.000",
      "formatted_end": "01:12:28.000",
      "text": "روز صبح بعدش اینو توشریه داره"
    },
    {
      "id": 20,
      "start": 4348.0,
      "end": 4350.0,
      "formatted_start": "01:12:28.000",
      "formatted_end": "01:12:30.000",
      "text": "اصلا برای این شراب میسوزه"
    },
    {
      "id": 21,
      "start": 4350.0,
      "end": 4352.0,
      "formatted_start": "01:12:30.000",
      "formatted_end": "01:12:32.000",
      "text": "بله چون دوی دندو بسیار"
    },
    {
      "id": 22,
      "start": 4352.0,
      "end": 4354.0,
      "formatted_start": "01:12:32.000",
      "formatted_end": "01:12:34.000",
      "text": "نه اینکه تو توضیح بیدیم پاکستان بعد اینکه دیگه ببینیم"
    },
    {
      "id": 23,
      "start": 4354.0,
      "end": 4356.0,
      "formatted_start": "01:12:34.000",
      "formatted_end": "01:12:36.000",
      "text": "اصال بوده تب داشته"
    },
    {
      "id": 24,
      "start": 4356.0,
      "end": 4358.0,
      "formatted_start": "01:12:36.000",
      "formatted_end": "01:12:38.000",
      "text": "تب داشته رفتیم اصال اینو از دارو خونه"
    },
    {
      "id": 25,
      "start": 4358.0,
      "end": 4360.0,
      "formatted_start": "01:12:38.000",
      "formatted_end": "01:12:40.000",
      "text": "آوردم و یه سوی گرداب همینو داد"
    },
    {
      "id": 26,
      "start": 4360.0,
      "end": 4362.0,
      "formatted_start": "01:12:40.000",
      "formatted_end": "01:12:42.000",
      "text": "ببینیم باید آب باید بشم بداییم"
    },
    {
      "id": 27,
      "start": 4362.0,
      "end": 4364.0,
      "formatted_start": "01:12:42.000",
      "formatted_end": "01:12:44.000",
      "text": "ماس باید ببینیم ببینیم دادیم ببینیم افراقه نکرد"
    },
    {
      "id": 28,
      "start": 4374.0,
      "end": 4376.0,
      "formatted_start": "01:12:54.000",
      "formatted_end": "01:12:56.000",
      "text": "از اینجور دوباره اینو کنیم خود بهتر شده"
    },
    {
      "id": 29,
      "start": 4376.0,
      "end": 4377.0,
      "formatted_start": "01:12:56.000",
      "formatted_end": "01:12:57.000",
      "text": "اما اولین چیز شما دید"
    },
    {
      "id": 30,
      "start": 4377.0,
      "end": 4378.0,
      "formatted_start": "01:12:57.000",
      "formatted_end": "01:12:58.000",
      "text": "به ضایق داریم مرا خست کردیم"
    },
    {
      "id": 31,
      "start": 4378.0,
      "end": 4380.0,
      "formatted_start": "01:12:58.000",
      "formatted_end": "01:13:00.000",
      "text": "نه نه خودمی برای خست کردم"
    },
    {
      "id": 32,
      "start": 4380.0,
      "end": 4382.0,
      "formatted_start": "01:13:00.000",
      "formatted_end": "01:13:02.000",
      "text": "الان چیزی بود؟ از صحبت چیزی داری بود؟"
    },
    {
      "id": 33,
      "start": 4382.0,
      "end": 4384.0,
      "formatted_start": "01:13:02.000",
      "formatted_end": "01:13:04.000",
      "text": "الان دستهاش اینجور شده بود"
    },
    {
      "id": 34,
      "start": 4384.0,
      "end": 4386.0,
      "formatted_start": "01:13:04.000",
      "formatted_end": "01:13:06.000",
      "text": "دستهاش دونه دونه های ریز"
    },
    {
      "id": 35,
      "start": 4386.0,
      "end": 4387.0,
      "formatted_start": "01:13:06.000",
      "formatted_end": "01:13:07.000",
      "text": "که اون چی می کنی؟"
    },
    {
      "id": 36,
      "start": 4387.0,
      "end": 4388.0,
      "formatted_start": "01:13:07.000",
      "formatted_end": "01:13:08.000",
      "text": "ببین الان اصحالم هسته؟"
    },
    {
      "id": 37,
      "start": 4388.0,
      "end": 4389.0,
      "formatted_start": "01:13:08.000",
      "formatted_end": "01:13:09.000",
      "text": "الان نه"
    },
    {
      "id": 38,
      "start": 4389.0,
      "end": 4390.0,
      "formatted_start": "01:13:09.000",
      "formatted_end": "01:13:10.000",
      "text": "الان دیگه نه"
    },
    {
      "id": 39,
      "start": 4390.0,
      "end": 4392.0,
      "formatted_start": "01:13:10.000",
      "formatted_end": "01:13:12.000",
      "text": "ریماسان تالغانی بردیم برای اصحال بردیم؟"
    },
    {
      "id": 40,
      "start": 4392.0,
      "end": 4393.0,
      "formatted_start": "01:13:12.000",
      "formatted_end": "01:13:13.000",
      "text": "نه نه"
    },
    {
      "id": 41,
      "start": 4393.0,
      "end": 4395.0,
      "formatted_start": "01:13:13.000",
      "formatted_end": "01:13:15.000",
      "text": "برای طب اینجا اصال نبوده؟"
    },
    {
      "id": 42,
      "start": 4395.0,
      "end": 4397.0,
      "formatted_start": "01:13:15.000",
      "formatted_end": "01:13:17.000",
      "text": "نه، قبل شده بود"
    },
    {
      "id": 43,
      "start": 4397.0,
      "end": 4399.0,
      "formatted_start": "01:13:17.000",
      "formatted_end": "01:13:19.000",
      "text": "قبل شده بود"
    },
    {
      "id": 44,
      "start": 4399.0,
      "end": 4402.0,
      "formatted_start": "01:13:19.000",
      "formatted_end": "01:13:22.000",
      "text": "پس اینجا قیل از طب سرپه، آردیزه شده بود"
    },
    {
      "id": 45,
      "start": 4402.0,
      "end": 4406.0,
      "formatted_start": "01:13:22.000",
      "formatted_end": "01:13:26.000",
      "text": "نه، نه، باید از آدمش کنیم، از آدمش خود پرداشته بود"
    },
    {
      "id": 46,
      "start": 4406.0,
      "end": 4408.0,
      "formatted_start": "01:13:26.000",
      "formatted_end": "01:13:28.000",
      "text": "گفتم که اصلاد شدید داره"
    },
    {
      "id": 47,
      "start": 4408.0,
      "end": 4411.0,
      "formatted_start": "01:13:28.000",
      "formatted_end": "01:13:31.000",
      "text": "تا دیگه امروز با برازایت خودم بستایی گرمیم"
    },
    {
      "id": 48,
      "start": 4411.0,
      "end": 4412.0,
      "formatted_start": "01:13:31.000",
      "formatted_end": "01:13:32.000",
      "text": "بعد ملخص کردی؟"
    },
    {
      "id": 49,
      "start": 4412.0,
      "end": 4413.0,
      "formatted_start": "01:13:32.000",
      "formatted_end": "01:13:33.000",
      "text": "برخص کردی باید"
    },
    {
      "id": 50,
      "start": 4413.0,
      "end": 4414.0,
      "formatted_start": "01:13:33.000",
      "formatted_end": "01:13:34.000",
      "text": "برخص کردی"
    },
    {
      "id": 51,
      "start": 4414.0,
      "end": 4415.0,
      "formatted_start": "01:13:34.000",
      "formatted_end": "01:13:35.000",
      "text": "برخص کردی"
    },
    {
      "id": 52,
      "start": 4415.0,
      "end": 4417.0,
      "formatted_start": "01:13:35.000",
      "formatted_end": "01:13:37.000",
      "text": "باید بشین و من شروع بستریش کنم"
    },
    {
      "id": 53,
      "start": 4417.0,
      "end": 4419.5,
      "formatted_start": "01:13:37.000",
      "formatted_end": "01:13:39.500",
      "text": "خب اینجا همان که ملاحظ کردین؟"
    },
    {
      "id": 54,
      "start": 4419.5,
      "end": 4421.5,
      "formatted_start": "01:13:39.500",
      "formatted_end": "01:13:41.500",
      "text": "نه نه در آن بیاد بشین"
    },
    {
      "id": 55,
      "start": 4421.5,
      "end": 4422.5,
      "formatted_start": "01:13:41.500",
      "formatted_end": "01:13:42.500",
      "text": "بخوابونی؟"
    },
    {
      "id": 56,
      "start": 4422.5,
      "end": 4424.5,
      "formatted_start": "01:13:42.500",
      "formatted_end": "01:13:44.500",
      "text": "اوی آوری پشا باید بخوابونی؟"
    },
    {
      "id": 57,
      "start": 4424.5,
      "end": 4426.5,
      "formatted_start": "01:13:44.500",
      "formatted_end": "01:13:46.500",
      "text": "نه بخوابونی"
    },
    {
      "id": 58,
      "start": 4426.5,
      "end": 4428.5,
      "formatted_start": "01:13:46.500",
      "formatted_end": "01:13:48.500",
      "text": "خب بخوابونی وسط تخبیل زد"
    },
    {
      "id": 59,
      "start": 4428.5,
      "end": 4429.5,
      "formatted_start": "01:13:48.500",
      "formatted_end": "01:13:49.500",
      "text": "وسط تخبیل منی کنم"
    },
    {
      "id": 60,
      "start": 4429.5,
      "end": 4431.5,
      "formatted_start": "01:13:49.500",
      "formatted_end": "01:13:51.500",
      "text": "ازماشات هکسین ها نداری هستن؟"
    },
    {
      "id": 61,
      "start": 4431.5,
      "end": 4432.5,
      "formatted_start": "01:13:51.500",
      "formatted_end": "01:13:52.500",
      "text": "هکسین ها نمازمش نداری"
    },
    {
      "id": 62,
      "start": 4432.5,
      "end": 4434.5,
      "formatted_start": "01:13:52.500",
      "formatted_end": "01:13:54.500",
      "text": "خب یه سری توتو برگر من دادنم خب بیا"
    },
    {
      "id": 63,
      "start": 4434.5,
      "end": 4436.5,
      "formatted_start": "01:13:54.500",
      "formatted_end": "01:13:56.500",
      "text": "خب بیا شما این برگر بسیار"
    },
    {
      "id": 64,
      "start": 4436.5,
      "end": 4438.5,
      "formatted_start": "01:13:56.500",
      "formatted_end": "01:13:58.500",
      "text": "دستشو بارون"
    },
    {
      "id": 65,
      "start": 4438.5,
      "end": 4440.5,
      "formatted_start": "01:13:58.500",
      "formatted_end": "01:14:00.500",
      "text": "چند ماهشه؟"
    },
    {
      "id": 66,
      "start": 4440.5,
      "end": 4442.5,
      "formatted_start": "01:14:00.500",
      "formatted_end": "01:14:02.500",
      "text": "۳۳"
    },
    {
      "id": 67,
      "start": 4442.5,
      "end": 4444.5,
      "formatted_start": "01:14:02.500",
      "formatted_end": "01:14:04.500",
      "text": "پاکاهایشو نگرده من پشت"
    },
    {
      "id": 68,
      "start": 4444.5,
      "end": 4446.5,
      "formatted_start": "01:14:04.500",
      "formatted_end": "01:14:06.500",
      "text": "چند ماهشه؟"
    },
    {
      "id": 69,
      "start": 4446.5,
      "end": 4448.5,
      "formatted_start": "01:14:06.500",
      "formatted_end": "01:14:08.500",
      "text": "۳۳"
    },
    {
      "id": 70,
      "start": 4448.5,
      "end": 4450.5,
      "formatted_start": "01:14:08.500",
      "formatted_end": "01:14:10.500",
      "text": "پاکاهایشو نگرده من پشت"
    },
    {
      "id": 71,
      "start": 4450.5,
      "end": 4452.5,
      "formatted_start": "01:14:10.500",
      "formatted_end": "01:14:12.500",
      "text": "چند ماهشه؟"
    },
    {
      "id": 72,
      "start": 4452.5,
      "end": 4454.5,
      "formatted_start": "01:14:12.500",
      "formatted_end": "01:14:14.500",
      "text": "۳۳"
    },
    {
      "id": 73,
      "start": 4454.5,
      "end": 4456.5,
      "formatted_start": "01:14:14.500",
      "formatted_end": "01:14:16.500",
      "text": "پاکاهایشو نگرده من پشت"
    },
    {
      "id": 74,
      "start": 4456.5,
      "end": 4458.5,
      "formatted_start": "01:14:16.500",
      "formatted_end": "01:14:18.500",
      "text": "چند ماهشه؟"
    },
    {
      "id": 75,
      "start": 4458.5,
      "end": 4460.5,
      "formatted_start": "01:14:18.500",
      "formatted_end": "01:14:20.500",
      "text": "۳۳"
    },
    {
      "id": 76,
      "start": 4460.5,
      "end": 4462.5,
      "formatted_start": "01:14:20.500",
      "formatted_end": "01:14:22.500",
      "text": "چند ماهشه؟"
    },
    {
      "id": 77,
      "start": 4462.5,
      "end": 4464.5,
      "formatted_start": "01:14:22.500",
      "formatted_end": "01:14:24.500",
      "text": "۳۳"
    },
    {
      "id": 78,
      "start": 4464.5,
      "end": 4467.96,
      "formatted_start": "01:14:24.500",
      "formatted_end": "01:14:27.960",
      "text": "این رو گفتم او بشه با آقای دکتر باید کنه"
    },
    {
      "id": 79,
      "start": 4467.96,
      "end": 4468.46,
      "formatted_start": "01:14:27.960",
      "formatted_end": "01:14:28.460",
      "text": "باشه"
    },
    {
      "id": 80,
      "start": 4468.46,
      "end": 4468.96,
      "formatted_start": "01:14:28.460",
      "formatted_end": "01:14:28.960",
      "text": "خواهش کنید"
    },
    {
      "id": 81,
      "start": 4468.96,
      "end": 4472.5,
      "formatted_start": "01:14:28.960",
      "formatted_end": "01:14:32.500",
      "text": "او سه ای کلنش هم میتونه چند کاش بار یا خود چیز برونه"
    },
    {
      "id": 82,
      "start": 4472.5,
      "end": 4474.04,
      "formatted_start": "01:14:32.500",
      "formatted_end": "01:14:34.040",
      "text": "خب بسام"
    },
    {
      "id": 83,
      "start": 4474.04,
      "end": 4476.96,
      "formatted_start": "01:14:34.040",
      "formatted_end": "01:14:36.960",
      "text": "خب درست"
    },
    {
      "id": 84,
      "start": 4476.96,
      "end": 4478.34,
      "formatted_start": "01:14:36.960",
      "formatted_end": "01:14:38.340",
      "text": "بر آقای دکتر این"
    },
    {
      "id": 85,
      "start": 4478.34,
      "end": 4478.74,
      "formatted_start": "01:14:38.340",
      "formatted_end": "01:14:38.740",
      "text": "بر"
    },
    {
      "id": 86,
      "start": 4478.74,
      "end": 4483.68,
      "formatted_start": "01:14:38.740",
      "formatted_end": "01:14:43.680",
      "text": "اصحاب بوده اسیدی بوده سوزونده"
    },
    {
      "id": 87,
      "start": 4483.68,
      "end": 4485.64,
      "formatted_start": "01:14:43.680",
      "formatted_end": "01:14:45.640",
      "text": "خیلی کلنش هم شده خون شده"
    },
    {
      "id": 88,
      "start": 4485.64,
      "end": 4487.56,
      "formatted_start": "01:14:45.640",
      "formatted_end": "01:14:47.560",
      "text": "خب بسام یه هفتاد"
    },
    {
      "id": 89,
      "start": 4487.56,
      "end": 4488.94,
      "formatted_start": "01:14:47.560",
      "formatted_end": "01:14:48.940",
      "text": "پنجاه هشت شیش"
    },
    {
      "id": 90,
      "start": 4488.94,
      "end": 4490.28,
      "formatted_start": "01:14:48.940",
      "formatted_end": "01:14:50.280",
      "text": "خب"
    },
    {
      "id": 91,
      "start": 4490.28,
      "end": 4492.34,
      "formatted_start": "01:14:50.280",
      "formatted_end": "01:14:52.340",
      "text": "خب"
    },
    {
