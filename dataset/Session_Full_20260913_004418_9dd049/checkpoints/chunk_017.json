  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5114.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:14.000",
      "text": "این افرار قاقی مونده، این قاقی مونده افراری داره، ازمانشکو خوبه، چیزی نداره، ممکنه وضعی باز سیستیت یا افتحاب مسانه باشه که باعثی میشه."
    },
    {
      "id": 1,
      "start": 5114.0,
      "end": 5116.0,
      "formatted_start": "01:25:14.000",
      "formatted_end": "01:25:16.000",
      "text": "و بعد استراب اصبی نداره؟"
    },
    {
      "id": 2,
      "start": 5116.0,
      "end": 5121.0,
      "formatted_start": "01:25:16.000",
      "formatted_end": "01:25:21.000",
      "text": "چرا؟ هجوم زیاده، خیلی به خودش مثلاً هیجام میده، استرس داره."
    },
    {
      "id": 3,
      "start": 5121.0,
      "end": 5123.5,
      "formatted_start": "01:25:21.000",
      "formatted_end": "01:25:23.500",
      "text": "بله، بعضی بخواد این ها تیک های عصبی هستند"
    },
    {
      "id": 4,
      "start": 5123.5,
      "end": 5126.5,
      "formatted_start": "01:25:23.500",
      "formatted_end": "01:25:26.500",
      "text": "یعنی تند و تند میرن، بچه این ها"
    },
    {
      "id": 5,
      "start": 5126.5,
      "end": 5128.5,
      "formatted_start": "01:25:26.500",
      "formatted_end": "01:25:28.500",
      "text": "خیلی پایان اضرار دارن، ولی ندارن"
    },
    {
      "id": 6,
      "start": 5129.5,
      "end": 5130.5,
      "formatted_start": "01:25:29.500",
      "formatted_end": "01:25:30.500",
      "text": "بله؟"
    },
    {
      "id": 7,
      "start": 5131.0,
      "end": 5132.0,
      "formatted_start": "01:25:31.000",
      "formatted_end": "01:25:32.000",
      "text": "بفرمه؟"
    },
    {
      "id": 8,
      "start": 5132.5,
      "end": 5134.0,
      "formatted_start": "01:25:32.500",
      "formatted_end": "01:25:34.000",
      "text": "سلام، جانم"
    },
    {
      "id": 9,
      "start": 5136.5,
      "end": 5137.5,
      "formatted_start": "01:25:36.500",
      "formatted_end": "01:25:37.500",
      "text": "بله؟"
    },
    {
      "id": 10,
      "start": 5151.0,
      "end": 5163.24,
      "formatted_start": "01:25:51.000",
      "formatted_end": "01:26:03.240",
      "text": "ممکنه این خونه موقعی زایمان اینها خورده باشه نوزاد"
    },
    {
      "id": 11,
      "start": 5163.24,
      "end": 5164.4,
      "formatted_start": "01:26:03.240",
      "formatted_end": "01:26:04.400",
      "text": "خب"
    },
    {
      "id": 12,
      "start": 5164.4,
      "end": 5167.94,
      "formatted_start": "01:26:04.400",
      "formatted_end": "01:26:07.940",
      "text": "فیلن آره تا ببینید اگر مشکلی بود اطلاع بودید"
    },
    {
      "id": 13,
      "start": 5167.94,
      "end": 5172.12,
      "formatted_start": "01:26:07.940",
      "formatted_end": "01:26:12.120",
      "text": "چون برام بچه مثلا ممکنه بل کرده باشه خونه دفت خونه اینا"
    },
    {
      "id": 14,
      "start": 5172.12,
      "end": 5174.32,
      "formatted_start": "01:26:12.120",
      "formatted_end": "01:26:14.320",
      "text": "رنگ روش اینا که خوبه دیگه"
    },
    {
      "id": 15,
      "start": 5174.32,
      "end": 5176.34,
      "formatted_start": "01:26:14.320",
      "formatted_end": "01:26:16.340",
      "text": "خیلی"
    },
    {
      "id": 16,
      "start": 5176.34,
      "end": 5178.72,
      "formatted_start": "01:26:16.340",
      "formatted_end": "01:26:18.720",
      "text": "تمام"
    },
    {
      "id": 17,
      "start": 5178.72,
      "end": 5179.86,
      "formatted_start": "01:26:18.720",
      "formatted_end": "01:26:19.860",
      "text": "باشه"
    },
    {
      "id": 18,
      "start": 5179.86,
      "end": 5184.86,
      "formatted_start": "01:26:19.860",
      "formatted_end": "01:26:24.860",
      "text": "اشکال نداریم اینها. مرسی خداحافظ"
    },
    {
      "id": 19,
      "start": 5184.86,
      "end": 5190.86,
      "formatted_start": "01:26:24.860",
      "formatted_end": "01:26:30.860",
      "text": "خب از این روزه خدمتون اینها باید باید تیکه هستیم. بیمه هستیم یا آزاد؟"
    },
    {
      "id": 20,
      "start": 5190.86,
      "end": 5195.86,
      "formatted_start": "01:26:30.860",
      "formatted_end": "01:26:35.860",
      "text": "بیمه هستیم. بیمه تمشیم. برات جنگره ها نیستیم"
    },
    {
      "id": 21,
      "start": 5195.86,
      "end": 5198.86,
      "formatted_start": "01:26:35.860",
      "formatted_end": "01:26:38.860",
      "text": "چرا دیگه؟ در حال نگره ها نادم میشید دیگه"
    },
    {
      "id": 22,
      "start": 5198.86,
      "end": 5202.86,
      "formatted_start": "01:26:38.860",
      "formatted_end": "01:26:42.860",
      "text": "چون خود این استرافه اصلی بچه اصلی میده"
    },
    {
      "id": 23,
      "start": 5202.86,
      "end": 5205.86,
      "formatted_start": "01:26:42.860",
      "formatted_end": "01:26:45.860",
      "text": "این شیء روانشناست از اون فیزش کم ببرید. خب؟"
    },
    {
      "id": 24,
      "start": 5205.86,
      "end": 5206.86,
      "formatted_start": "01:26:45.860",
      "formatted_end": "01:26:46.860",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 5206.86,
      "end": 5210.86,
      "formatted_start": "01:26:46.860",
      "formatted_end": "01:26:50.860",
      "text": "اونو حتما بگیر باشید من دارو هم براش میدیم سه"
    },
    {
      "id": 26,
      "start": 5210.86,
      "end": 5214.86,
      "formatted_start": "01:26:50.860",
      "formatted_end": "01:26:54.860",
      "text": "بعد دارو هاشو بیار من ببینم"
    },
    {
      "id": 27,
      "start": 5214.86,
      "end": 5218.86,
      "formatted_start": "01:26:54.860",
      "formatted_end": "01:26:58.860",
      "text": "یه هفته دیگه بعد از مصرف دارو بیاریم بگیم"
    },
    {
      "id": 28,
      "start": 5223.86,
      "end": 5224.86,
      "formatted_start": "01:27:03.860",
      "formatted_end": "01:27:04.860",
      "text": "خامیبتون؟"
    },
    {
      "id": 29,
      "start": 5224.86,
      "end": 5226.86,
      "formatted_start": "01:27:04.860",
      "formatted_end": "01:27:06.860",
      "text": "خمه"
    },
    {
      "id": 30,
      "start": 5226.86,
      "end": 5230.86,
      "formatted_start": "01:27:06.860",
      "formatted_end": "01:27:10.860",
      "text": "یه شعرت هستم میتونم بگیم چه طب داشته نداشت"
    },
    {
      "id": 31,
      "start": 5230.86,
      "end": 5260.86,
      "formatted_start": "01:27:10.860",
      "formatted_end": "01:27:40.860",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 32,
      "start": 5260.86,
      "end": 5280.86,
      "formatted_start": "01:27:40.860",
      "formatted_end": "01:28:00.860",
      "text": "موسیقی"
    },
    {
      "id": 33,
      "start": 5280.86,
      "end": 5286.86,
      "formatted_start": "01:28:00.860",
      "formatted_end": "01:28:06.860",
      "text": "بخونه سرماحاش ممکنه بیایی سلامت بشین"
    },
    {
      "id": 34,
      "start": 5286.86,
      "end": 5289.86,
      "formatted_start": "01:28:06.860",
      "formatted_end": "01:28:09.860",
      "text": "برگره بشین"
    },
    {
      "id": 35,
      "start": 5289.86,
      "end": 5293.86,
      "formatted_start": "01:28:09.860",
      "formatted_end": "01:28:13.860",
      "text": "نشته خانم نجفی چی شده بابایی؟"
    },
    {
      "id": 36,
      "start": 5293.86,
      "end": 5298.86,
      "formatted_start": "01:28:13.860",
      "formatted_end": "01:28:18.860",
      "text": "این از تو بیقراری می کنه همه چیز تب داره"
    },
    {
      "id": 37,
      "start": 5298.86,
      "end": 5302.86,
      "formatted_start": "01:28:18.860",
      "formatted_end": "01:28:22.860",
      "text": "تب که بیقراره دیگه؟"
    },
    {
      "id": 38,
      "start": 5302.86,
      "end": 5305.86,
      "formatted_start": "01:28:22.860",
      "formatted_end": "01:28:25.860",
      "text": "تب و بیقراری است"
    },
    {
      "id": 39,
      "start": 5305.86,
      "end": 5308.86,
      "formatted_start": "01:28:25.860",
      "formatted_end": "01:28:28.860",
      "text": "بعد صرفه، آب دیزش، از خالق"
    },
    {
      "id": 40,
      "start": 5308.86,
      "end": 5310.86,
      "formatted_start": "01:28:28.860",
      "formatted_end": "01:28:30.860",
      "text": "بله دست بوشیت همه خیلی ازش چنی کنن"
    },
    {
      "id": 41,
      "start": 5310.86,
      "end": 5312.86,
      "formatted_start": "01:28:30.860",
      "formatted_end": "01:28:32.860",
      "text": "از که به وقت داره دست بوشیت کنن"
    },
    {
      "id": 42,
      "start": 5312.86,
      "end": 5314.86,
      "formatted_start": "01:28:32.860",
      "formatted_end": "01:28:34.860",
      "text": "از قبل نمی بودید؟ از که بودیم؟"
    },
    {
      "id": 43,
      "start": 5314.86,
      "end": 5316.86,
      "formatted_start": "01:28:34.860",
      "formatted_end": "01:28:36.860",
      "text": "دست بوشیت خیلی وقت دارید نتیجه"
    },
    {
      "id": 44,
      "start": 5316.86,
      "end": 5318.86,
      "formatted_start": "01:28:36.860",
      "formatted_end": "01:28:38.860",
      "text": "یک ماه از دو ماه؟ نه یک ماه شبش دارید"
    },
    {
      "id": 45,
      "start": 5318.86,
      "end": 5320.86,
      "formatted_start": "01:28:38.860",
      "formatted_end": "01:28:40.860",
      "text": "ولی اصحاب اینا که نبودید؟"
    },
    {
      "id": 46,
      "start": 5320.86,
      "end": 5322.86,
      "formatted_start": "01:28:40.860",
      "formatted_end": "01:28:42.860",
      "text": "نه اصحاب توی یه آشکنش باکرسته"
    },
    {
      "id": 47,
      "start": 5322.86,
      "end": 5324.86,
      "formatted_start": "01:28:42.860",
      "formatted_end": "01:28:44.860",
      "text": "دست هم نبوده در اینکه اصحاب هم نبوده"
    },
    {
      "id": 48,
      "start": 5324.86,
      "end": 5327.86,
      "formatted_start": "01:28:44.860",
      "formatted_end": "01:28:47.860",
      "text": "خیلی، از پیشنگون تب و بسیار بی غلابی شده"
    },
    {
      "id": 49,
      "start": 5327.86,
      "end": 5333.86,
      "formatted_start": "01:28:47.860",
      "formatted_end": "01:28:53.860",
      "text": "این جزوه کرده که همه دوان خواه خواه خواه میدونید نسید شدید نرده از اینکه آب همه ها میکنه با راه های اونو دیگه بود"
    },
    {
      "id": 50,
      "start": 5333.86,
      "end": 5334.86,
      "formatted_start": "01:28:53.860",
      "formatted_end": "01:28:54.860",
      "text": "خیلی بود"
    },
    {
      "id": 51,
      "start": 5335.86,
      "end": 5337.86,
      "formatted_start": "01:28:55.860",
      "formatted_end": "01:28:57.860",
      "text": "طب شدید بود یا خفیف؟"
    },
    {
      "id": 52,
      "start": 5337.86,
      "end": 5339.86,
      "formatted_start": "01:28:57.860",
      "formatted_end": "01:28:59.860",
      "text": "ازا اونو ساتر کرده"
    },
    {
      "id": 53,
      "start": 5339.86,
      "end": 5341.86,
      "formatted_start": "01:28:59.860",
      "formatted_end": "01:29:01.860",
      "text": "نه شدید بود یا خفیف مثلا"
    },
    {
      "id": 54,
      "start": 5341.86,
      "end": 5343.86,
      "formatted_start": "01:29:01.860",
      "formatted_end": "01:29:03.860",
      "text": "کم بود بود یا یا یا ستر بود یا یا ستر بود"
    },
    {
      "id": 55,
      "start": 5343.86,
      "end": 5345.86,
      "formatted_start": "01:29:03.860",
      "formatted_end": "01:29:05.860",
      "text": "اینجا طب هسته سن چاپشه سمیتون داده من یا یا ستر بود"
    },
    {
      "id": 56,
      "start": 5345.86,
      "end": 5346.86,
      "formatted_start": "01:29:05.860",
      "formatted_end": "01:29:06.860",
      "text": "یا ستر بود"
    },
    {
      "id": 57,
      "start": 5357.86,
      "end": 5359.86,
      "formatted_start": "01:29:17.860",
      "formatted_end": "01:29:19.860",
      "text": "خوب ندارسه"
    },
    {
      "id": 58,
      "start": 5359.86,
      "end": 5361.86,
      "formatted_start": "01:29:19.860",
      "formatted_end": "01:29:21.860",
      "text": "آفر"
    },
    {
      "id": 59,
      "start": 5361.86,
      "end": 5363.86,
      "formatted_start": "01:29:21.860",
      "formatted_end": "01:29:23.860",
      "text": "سه میشه قدر؟"
    },
    {
      "id": 60,
      "start": 5363.86,
      "end": 5365.86,
      "formatted_start": "01:29:23.860",
      "formatted_end": "01:29:25.860",
      "text": "آفر تساز خور میشه"
    },
    {
      "id": 61,
      "start": 5365.86,
      "end": 5369.86,
      "formatted_start": "01:29:25.860",
      "formatted_end": "01:29:29.860",
      "text": "آفر خیلی کسر بر و بیار"
    },
    {
      "id": 62,
      "start": 5369.86,
      "end": 5373.86,
      "formatted_start": "01:29:29.860",
      "formatted_end": "01:29:33.860",
      "text": "خوب من میدارم خور میشه"
    },
    {
      "id": 63,
      "start": 5373.86,
      "end": 5375.86,
      "formatted_start": "01:29:33.860",
      "formatted_end": "01:29:35.860",
      "text": "گله من پنه در میدارم"
    },
    {
      "id": 64,
      "start": 5375.86,
      "end": 5378.86,
      "formatted_start": "01:29:35.860",
      "formatted_end": "01:29:38.860",
      "text": "از راه نتاب داره بچه"
    },
    {
      "id": 65,
      "start": 5378.86,
      "end": 5381.86,
      "formatted_start": "01:29:38.860",
      "formatted_end": "01:29:41.860",
      "text": "یا بی غرار یا بی حسله"
    },
    {
      "id": 66,
      "start": 5381.86,
      "end": 5384.86,
      "formatted_start": "01:29:41.860",
      "formatted_end": "01:29:44.860",
      "text": "هر ماه هم ببینی؟"
    },
    {
      "id": 67,
      "start": 5387.86,
      "end": 5396.86,
      "formatted_start": "01:29:47.860",
      "formatted_end": "01:29:56.860",
      "text": "این افرانت ویروسی است و دارو برایش میمیسم"
    },
    {
      "id": 68,
      "start": 5396.86,
      "end": 5399.86,
      "formatted_start": "01:29:56.860",
      "formatted_end": "01:29:59.860",
      "text": "اگر خیلی بد دارو است یا طویز چیز است"
    }
  ],
  "status": "completed"
}