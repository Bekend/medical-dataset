  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8102.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:02.000",
      "text": "از این حالات، باید برداری که منو زباقی خوب نیستیم."
    },
    {
      "id": 1,
      "start": 8102.0,
      "end": 8106.0,
      "formatted_start": "02:15:02.000",
      "formatted_end": "02:15:06.000",
      "text": "بگید، کسی منو دوست نداره، اگه نامده نام شد، آخرون ترخون می بودن."
    },
    {
      "id": 2,
      "start": 8106.0,
      "end": 8113.0,
      "formatted_start": "02:15:06.000",
      "formatted_end": "02:15:13.000",
      "text": "و در نقیق، شما موندین، چون ترس من از وفتن، از ترس منونت بزرگ شده بود."
    },
    {
      "id": 3,
      "start": 8113.0,
      "end": 8120.0,
      "formatted_start": "02:15:13.000",
      "formatted_end": "02:15:20.000",
      "text": "اگه امروز همونتون باید موندن، سردنش میکنین، وقتی شستید به جای قضاوت مومه را بودین، خودتون مردن باشین."
    },
    {
      "id": 4,
      "start": 8120.0,
      "end": 8124.0,
      "formatted_start": "02:15:20.000",
      "formatted_end": "02:15:24.000",
      "text": "شما با اطلاعات و تبانه هایی که ما موقع داشتیم بهترین تصمیم می کنیم که بود و گرفتیم."
    },
    {
      "id": 5,
      "start": 8124.0,
      "end": 8126.0,
      "formatted_start": "02:15:24.000",
      "formatted_end": "02:15:26.000",
      "text": "ممنون."
    },
    {
      "id": 6,
      "start": 8126.0,
      "end": 8129.0,
      "formatted_start": "02:15:26.000",
      "formatted_end": "02:15:29.000",
      "text": "یکی از مسایلی که میتونه یک صور بارو توی صور نگرد برن،"
    },
    {
      "id": 7,
      "start": 8129.0,
      "end": 8134.0,
      "formatted_start": "02:15:29.000",
      "formatted_end": "02:15:34.000",
      "text": "وقتی با یک خوشیت زندگی میکنیم، چجوری کمترین حاصل باید ببینیم؟"
    },
    {
      "id": 8,
      "start": 8134.0,
      "end": 8137.0,
      "formatted_start": "02:15:34.000",
      "formatted_end": "02:15:37.000",
      "text": "اگر داریم با یک خوشیت زندگی میکنیم، بارها از خود رو سوال کردیم،"
    },
    {
      "id": 9,
      "start": 8137.0,
      "end": 8140.0,
      "formatted_start": "02:15:37.000",
      "formatted_end": "02:15:40.000",
      "text": "من چجوری باید نمیفتر و ممنون که آسیب نبیدم؟"
    },
    {
      "id": 10,
      "start": 8140.0,
      "end": 8146.0,
      "formatted_start": "02:15:40.000",
      "formatted_end": "02:15:46.000",
      "text": "مولایت اینه که حددش آنها باید نمی آمده تغییرگاه داره خودچکت باشه. حددتون باید موجود از خودتون باشه."
    },
    {
      "id": 11,
      "start": 8146.0,
      "end": 8152.0,
      "formatted_start": "02:15:46.000",
      "formatted_end": "02:15:52.000",
      "text": "تنها راه مقابله و موجود از خودتون در مراور خودچکت مرز بنده ای ما سیاسته نمی مقابل به مثل."
    },
    {
      "id": 12,
      "start": 8152.0,
      "end": 8156.0,
      "formatted_start": "02:15:52.000",
      "formatted_end": "02:15:56.000",
      "text": "مرز باشه اینه که اصلا به خودتون. یعنی اجازه ندید اینکه باید بازدرینش باشید."
    },
    {
      "id": 13,
      "start": 8156.0,
      "end": 8159.0,
      "formatted_start": "02:15:56.000",
      "formatted_end": "02:15:59.000",
      "text": "یکی از جمله های تنها ممنون خوشگذار و ساکت میدانه یه که"
    },
    {
      "id": 14,
      "start": 8159.0,
      "end": 8166.0,
      "formatted_start": "02:15:59.000",
      "formatted_end": "02:16:06.000",
      "text": "من دوستان رو باید بحث کنم به جایی که بیا بگیم تو نمیفهمی یا که بگیم تفسدن با تو فایده این نداره"
    },
    {
      "id": 15,
      "start": 8166.0,
      "end": 8170.0,
      "formatted_start": "02:16:06.000",
      "formatted_end": "02:16:10.000",
      "text": "این جمله ها فقط باید شدن از اون پیشتر حالا هانه"
    },
    {
      "id": 16,
      "start": 8170.0,
      "end": 8173.0,
      "formatted_start": "02:16:10.000",
      "formatted_end": "02:16:13.000",
      "text": "مرز بزنشتن همه موصولتنشون بزنه"
    },
    {
      "id": 17,
      "start": 8173.0,
      "end": 8176.0,
      "formatted_start": "02:16:13.000",
      "formatted_end": "02:16:16.000",
      "text": "مرز بنده با خوشیفتن، کتاب، شمپا، فرمانتن باشید"
    },
    {
      "id": 18,
      "start": 8176.0,
      "end": 8180.0,
      "formatted_start": "02:16:16.000",
      "formatted_end": "02:16:20.000",
      "text": "نه توضیح از آن بودید، نه زودون بفرد بودید، نه دعوت آنکردان جاوشید."
    },
    {
      "id": 19,
      "start": 8180.0,
      "end": 8185.0,
      "formatted_start": "02:16:20.000",
      "formatted_end": "02:16:25.000",
      "text": "لازم هم مثل احساسات و برنامه و تصمیم زندگیتون براش توضیح بدید."
    },
    {
      "id": 20,
      "start": 8185.0,
      "end": 8191.0,
      "formatted_start": "02:16:25.000",
      "formatted_end": "02:16:31.000",
      "text": "هر جان اطلاعات شخصی کمتری از شما داشته باشد، اموزه های گمداری در کنترول تحمیل و لسفه روی شما دارد."
    },
    {
      "id": 21,
      "start": 8191.0,
      "end": 8196.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:36.000",
      "text": "ماندی کننده دارد مثل نشانه از برخیز هر جه آرون تر باشید، قبلی تن میشید."
    },
    {
      "id": 22,
      "start": 8196.0,
      "end": 8199.0,
      "formatted_start": "02:16:36.000",
      "formatted_end": "02:16:39.000",
      "text": "خودشیفت ها از باقون شهرانی شما تنظیم کنند."
    },
    {
      "id": 23,
      "start": 8199.0,
      "end": 8202.0,
      "formatted_start": "02:16:39.000",
      "formatted_end": "02:16:42.000",
      "text": "وقتی آرون میبینند، قدرت خودش را از دست میدهند."
    },
    {
      "id": 24,
      "start": 8202.0,
      "end": 8206.0,
      "formatted_start": "02:16:42.000",
      "formatted_end": "02:16:46.000",
      "text": "اگه تو رابطه تون فرق ندارید، اولا بیرون شما به سلامت روی بچه تون باشد،"
    },
    {
      "id": 25,
      "start": 8206.0,
      "end": 8211.0,
      "formatted_start": "02:16:46.000",
      "formatted_end": "02:16:51.000",
      "text": "نه که خودشیفت را رازم بگیرد و بچه ها را به یک محرم ها نیاز دارند، نه مربانی."
    },
    {
      "id": 26,
      "start": 8211.0,
      "end": 8214.0,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:54.000",
      "text": "شناخته به دون آمر هیچ فایه ندارد."
    },
    {
      "id": 27,
      "start": 8214.0,
      "end": 8217.0,
      "formatted_start": "02:16:54.000",
      "formatted_end": "02:16:57.000",
      "text": "دلیل سن یک طرف مقابل خودشیفت هست."
    },
    {
      "id": 28,
      "start": 8217.0,
      "end": 8220.0,
      "formatted_start": "02:16:57.000",
      "formatted_end": "02:17:00.000",
      "text": "اگر رفتار شما متابرند دارید چرا عوض نکنید؟"
    },
    {
      "id": 29,
      "start": 8220.0,
      "end": 8225.0,
      "formatted_start": "02:17:00.000",
      "formatted_end": "02:17:05.000",
      "text": "تعمیر از رفتار شما شما میشه، نه از شخصیت خودشیفته"
    },
    {
      "id": 30,
      "start": 8225.0,
      "end": 8230.0,
      "formatted_start": "02:17:05.000",
      "formatted_end": "02:17:10.000",
      "text": "پس به جایی که خودشیفته رو عوض کنید، سریع بگید رفتار خودتون رو تعمیر بدید"
    },
    {
      "id": 31,
      "start": 8230.0,
      "end": 8234.0,
      "formatted_start": "02:17:10.000",
      "formatted_end": "02:17:14.000",
      "text": "یکی از مهمترین چیزهایی تو زندگی با فرد خودشیفته باید یاد بگیرید"
    },
    {
      "id": 32,
      "start": 8234.0,
      "end": 8237.0,
      "formatted_start": "02:17:14.000",
      "formatted_end": "02:17:17.000",
      "text": "صبات رابطه و مهارت رابطه است"
    },
    {
      "id": 33,
      "start": 8237.0,
      "end": 8240.0,
      "formatted_start": "02:17:17.000",
      "formatted_end": "02:17:20.000",
      "text": "از این خواهند ها نکردون خودشیفته ادعا بدید"
    },
    {
      "id": 34,
      "start": 8240.0,
      "end": 8246.5,
      "formatted_start": "02:17:20.000",
      "formatted_end": "02:17:26.500",
      "text": "اگه این ثبات رو تداشته باشین، فرشار از به استرس، حملات پانی، درد جسمی و رخوکردن خودتون میشین."
    },
    {
      "id": 35,
      "start": 8247.08,
      "end": 8253.62,
      "formatted_start": "02:17:27.080",
      "formatted_end": "02:17:33.620",
      "text": "اما وقتی ثبات رابطه با فرد خودچیفه رو بلد داشتین، از خودتون از ازره جسمی و روانی مراقبت میکنین."
    },
    {
      "id": 36,
      "start": 8254.5,
      "end": 8261.6,
      "formatted_start": "02:17:34.500",
      "formatted_end": "02:17:41.600",
      "text": "بیزنگی با فرد خودچیفه، دوشوار حملات عصبی، استرس، کمتاقتی و کم محسرگی میشین."
    },
    {
      "id": 37,
      "start": 8262.2,
      "end": 8267.24,
      "formatted_start": "02:17:42.200",
      "formatted_end": "02:17:47.240",
      "text": "اما با مهارت رابطه آمون، سبور و مصدس به خودتون هستین."
    },
    {
      "id": 38,
      "start": 8267.24,
      "end": 8275.24,
      "formatted_start": "02:17:47.240",
      "formatted_end": "02:17:55.240",
      "text": "اگر سواد رابطه با خودشیفتر رو نوشته باشید، به مرور بی هدف، بی گوزده و سرشار از حسرت و چراها میشید."
    },
    {
      "id": 39,
      "start": 8275.24,
      "end": 8288.24,
      "formatted_start": "02:17:55.240",
      "formatted_end": "02:18:08.240",
      "text": "اما وقتی این سواد رو به دست نیابده از ازم نفس خودتون رو حلزم کنید، هدف منظم نیمی کنید، برنامه روزی دارید و از دین خودتون رو با آموزش، رشد پردنید و خودسازی برمی کنید."
    },
    {
      "id": 40,
      "start": 8288.24,
      "end": 8295.52,
      "formatted_start": "02:18:08.240",
      "formatted_end": "02:18:15.520",
      "text": "برنامه تکنیک های ساده ای که برای کارش استراب داد و توی ویدیو های دیگه بازی و دستگاهی و عملی دوشاره کارش هم مرکز فراموشید"
    },
    {
      "id": 41,
      "start": 8295.52,
      "end": 8300.2,
      "formatted_start": "02:18:15.520",
      "formatted_end": "02:18:20.200",
      "text": "برنامه تکنیک های ساده ای که برای کارش استراب داد و توی ویدیو های دیگه بازم"
    },
    {
      "id": 42,
      "start": 8300.2,
      "end": 8312.4,
      "formatted_start": "02:18:20.200",
      "formatted_end": "02:18:32.400",
      "text": "ایران دوباره آرمش"
    },
    {
      "id": 43,
      "start": 8312.4,
      "end": 8315.38,
      "formatted_start": "02:18:32.400",
      "formatted_end": "02:18:35.380",
      "text": "دوباره کامل های برمه نشوه ها رو میدینم"
    },
    {
      "id": 44,
      "start": 8315.38,
      "end": 8323.38,
      "formatted_start": "02:18:35.380",
      "formatted_end": "02:18:43.380",
      "text": "در مدت که ویدیوهای موجود به روزه ها رو شروع کردم، سوال های زیاد..."
    },
    {
      "id": 45,
      "start": 8323.38,
      "end": 8325.38,
      "formatted_start": "02:18:43.380",
      "formatted_end": "02:18:45.380",
      "text": "..."
    },
    {
      "id": 46,
      "start": 8325.38,
      "end": 8327.38,
      "formatted_start": "02:18:45.380",
      "formatted_end": "02:18:47.380",
      "text": "..."
    },
    {
      "id": 47,
      "start": 8327.38,
      "end": 8329.38,
      "formatted_start": "02:18:47.380",
      "formatted_end": "02:18:49.380",
      "text": "..."
    },
    {
      "id": 48,
      "start": 8329.38,
      "end": 8331.38,
      "formatted_start": "02:18:49.380",
      "formatted_end": "02:18:51.380",
      "text": "..."
    },
    {
      "id": 49,
      "start": 8331.38,
      "end": 8333.38,
      "formatted_start": "02:18:51.380",
      "formatted_end": "02:18:53.380",
      "text": "..."
    },
    {
      "id": 50,
      "start": 8333.38,
      "end": 8335.38,
      "formatted_start": "02:18:53.380",
      "formatted_end": "02:18:55.380",
      "text": "..."
    },
    {
      "id": 51,
      "start": 8335.38,
      "end": 8337.38,
      "formatted_start": "02:18:55.380",
      "formatted_end": "02:18:57.380",
      "text": "..."
    },
    {
      "id": 52,
      "start": 8337.38,
      "end": 8339.38,
      "formatted_start": "02:18:57.380",
      "formatted_end": "02:18:59.380",
      "text": "..."
    },
    {
      "id": 53,
      "start": 8339.38,
      "end": 8341.38,
      "formatted_start": "02:18:59.380",
      "formatted_end": "02:19:01.380",
      "text": "..."
    },
    {
      "id": 54,
      "start": 8341.38,
      "end": 8343.38,
      "formatted_start": "02:19:01.380",
      "formatted_end": "02:19:03.380",
      "text": "..."
    },
    {
      "id": 55,
      "start": 8343.38,
      "end": 8346.76,
      "formatted_start": "02:19:03.380",
      "formatted_end": "02:19:06.760",
      "text": "این اشاره هایی که بخور نفت داره به وجود میاد"
    },
    {
      "id": 56,
      "start": 8346.76,
      "end": 8347.96,
      "formatted_start": "02:19:06.760",
      "formatted_end": "02:19:07.960",
      "text": "قابل تشکرشی نیست"
    },
    {
      "id": 57,
      "start": 8347.96,
      "end": 8351.52,
      "formatted_start": "02:19:07.960",
      "formatted_end": "02:19:11.520",
      "text": "با باره نفت نفت و پشتارت بیشتر پاهی شد"
    },
    {
      "id": 58,
      "start": 8351.52,
      "end": 8355.64,
      "formatted_start": "02:19:11.520",
      "formatted_end": "02:19:15.640",
      "text": "شهر این ازدیدیه طرف ایرانی داره شموت دازه تری رو دوباره مطرح کنند"
    },
    {
      "id": 59,
      "start": 8355.64,
      "end": 8358.74,
      "formatted_start": "02:19:15.640",
      "formatted_end": "02:19:18.740",
      "text": "جونه مثلا نمید شمول آنی امیت ملی برگانیهی داده"
    },
    {
      "id": 60,
      "start": 8358.74,
      "end": 8361.68,
      "formatted_start": "02:19:18.740",
      "formatted_end": "02:19:21.680",
      "text": "و یک سری شموتی رو برشنورده که بسیار شمید"
    },
    {
      "id": 61,
      "start": 8361.68,
      "end": 8365.28,
      "formatted_start": "02:19:21.680",
      "formatted_end": "02:19:25.280",
      "text": "تقویم نامه پاکستانه حتی بندهایی هم بیشتر داره"
    },
    {
      "id": 62,
      "start": 8365.28,
      "end": 8370.28,
      "formatted_start": "02:19:25.280",
      "formatted_end": "02:19:30.280",
      "text": "اگر ایران بخواست شموتش رو اضافه بکنه، آن آورپا حاضر اینه به خطر"
    },
    {
      "id": 63,
      "start": 8370.28,
      "end": 8371.28,
      "formatted_start": "02:19:30.280",
      "formatted_end": "02:19:31.280",
      "text": "نمیشه"
    },
    {
      "id": 64,
      "start": 8371.28,
      "end": 8375.28,
      "formatted_start": "02:19:31.280",
      "formatted_end": "02:19:35.280",
      "text": "آن شیف کورایی امیدواری در این مذاکره دست و پای خودش رو بسته"
    },
    {
      "id": 65,
      "start": 8375.28,
      "end": 8378.28,
      "formatted_start": "02:19:35.280",
      "formatted_end": "02:19:38.280",
      "text": "حکومت از همون اول، حکومت ایران رو میگم"
    },
    {
      "id": 66,
      "start": 8378.28,
      "end": 8380.28,
      "formatted_start": "02:19:38.280",
      "formatted_end": "02:19:40.280",
      "text": "بروژانی گفته بود، پس جنگ چی نیخوان؟"
    },
    {
      "id": 67,
      "start": 8380.28,
      "end": 8382.28,
      "formatted_start": "02:19:40.280",
      "formatted_end": "02:19:42.280",
      "text": "پیش هرتوانشون رو گفته بودن"
    },
    {
      "id": 68,
      "start": 8382.28,
      "end": 8387.28,
      "formatted_start": "02:19:42.280",
      "formatted_end": "02:19:47.280",
      "text": "گفته بودن که این حالت رو برای بازگشت و ثبات نمبرت جنگ چیست؟"
    },
    {
      "id": 69,
      "start": 8387.28,
      "end": 8394.9,
      "formatted_start": "02:19:47.280",
      "formatted_end": "02:19:54.900",
      "text": "ولی گرس متحده برعکس هم در حوضه امامی و هم در حوضه خصوصی مرتب موزنش رو عوض کرده"
    },
    {
      "id": 70,
      "start": 8394.9,
      "end": 8397.76,
      "formatted_start": "02:19:54.900",
      "formatted_end": "02:19:57.760",
      "text": "بسیار به شرفی رو زنبال چی هست"
    },
    {
      "id": 71,
      "start": 8397.76,
      "end": 8399.58,
      "formatted_start": "02:19:57.760",
      "formatted_end": "02:19:59.580",
      "text": "به همه این خیلی عجیب هست"
    }
  ],
  "status": "completed"
}