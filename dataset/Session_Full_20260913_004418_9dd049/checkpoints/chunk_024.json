  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7203.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:03.000",
      "text": "ازاده نست با خودشو، جاودا به خودش میبرید."
    },
    {
      "id": 1,
      "start": 7203.0,
      "end": 7207.0,
      "formatted_start": "02:00:03.000",
      "formatted_end": "02:00:07.000",
      "text": "توی شخصت خودشی به طمانای همدلی خیلی کمه."
    },
    {
      "id": 2,
      "start": 7207.0,
      "end": 7210.0,
      "formatted_start": "02:00:07.000",
      "formatted_end": "02:00:10.000",
      "text": "مثلا، باید دارید نیازها رو احساس به خودشون ببینید."
    },
    {
      "id": 3,
      "start": 7210.0,
      "end": 7216.0,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:16.000",
      "text": "اما شخصت نماشین، یه مقدار همدلی داره، متعلق مخابرش، و همین احساس ایمانچیت رو داره."
    },
    {
      "id": 4,
      "start": 7216.0,
      "end": 7219.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:19.000",
      "text": "تا مورد برقیل هست."
    },
    {
      "id": 5,
      "start": 7219.0,
      "end": 7226.6,
      "formatted_start": "02:00:19.000",
      "formatted_end": "02:00:26.600",
      "text": "توی شخصت خود چیزه برای احساس برطریق خودش برمیده را ممکنه کوچی کنه، تغییر کنه، میعرضش کنه"
    },
    {
      "id": 6,
      "start": 7226.6,
      "end": 7232.0,
      "formatted_start": "02:00:26.600",
      "formatted_end": "02:00:32.000",
      "text": "اما شخصت نمایشی هر در اینجا پایان برقیل از صدایشی که توجه را خود به سمت خودش برکرده"
    },
    {
      "id": 7,
      "start": 7232.0,
      "end": 7235.2,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:35.200",
      "text": "و بعد تبایی خودت را اخلاقشون را کنه، شخصت نمایشی به توجهیه"
    },
    {
      "id": 8,
      "start": 7235.2,
      "end": 7241.66,
      "formatted_start": "02:00:35.200",
      "formatted_end": "02:00:41.660",
      "text": "اگر شخصیت نمایشی احساس کنه، نادیده گرد بشه، ممکنه احساس خودشون، نمایشون، اقرار و از رفتارون برای تو دیده بشه."
    },
    {
      "id": 9,
      "start": 7241.66,
      "end": 7245.8,
      "formatted_start": "02:00:41.660",
      "formatted_end": "02:00:45.800",
      "text": "از هم ممکنه دوشگاه احساسی پوچی، محسوس دیگه، یا رفتار هیجانه بشه،"
    },
    {
      "id": 10,
      "start": 7245.8,
      "end": 7252.68,
      "formatted_start": "02:00:45.800",
      "formatted_end": "02:00:52.680",
      "text": "یا حتی وقتی ممکنه توشو باسید برده دید، خودخوشی، مثلا انجام دیگه دیگرانده ایش ترجمه کنه."
    },
    {
      "id": 11,
      "start": 7252.68,
      "end": 7256.52,
      "formatted_start": "02:00:52.680",
      "formatted_end": "02:00:56.520",
      "text": "اما شخصی خودشی به درقیب میدهد و چه خشمه میشه تغییر بکنه"
    },
    {
      "id": 12,
      "start": 7256.52,
      "end": 7258.12,
      "formatted_start": "02:00:56.520",
      "formatted_end": "02:00:58.120",
      "text": "طبقا مقابله بی عرضش"
    },
    {
      "id": 13,
      "start": 7263.12,
      "end": 7264.64,
      "formatted_start": "02:01:03.120",
      "formatted_end": "02:01:04.640",
      "text": "بخونید بخونید"
    },
    {
      "id": 14,
      "start": 7264.64,
      "end": 7265.84,
      "formatted_start": "02:01:04.640",
      "formatted_end": "02:01:05.840",
      "text": "خشمه بخونید"
    },
    {
      "id": 15,
      "start": 7265.84,
      "end": 7267.2,
      "formatted_start": "02:01:05.840",
      "formatted_end": "02:01:07.200",
      "text": "سلام خواهید شما خوبه"
    },
    {
      "id": 16,
      "start": 7267.2,
      "end": 7268.2,
      "formatted_start": "02:01:07.200",
      "formatted_end": "02:01:08.200",
      "text": "سلامت بشین"
    },
    {
      "id": 17,
      "start": 7268.2,
      "end": 7269.88,
      "formatted_start": "02:01:08.200",
      "formatted_end": "02:01:09.880",
      "text": "خواهید شما کنم بخونید"
    },
    {
      "id": 18,
      "start": 7269.88,
      "end": 7271.08,
      "formatted_start": "02:01:09.880",
      "formatted_end": "02:01:11.080",
      "text": "خوبی؟"
    },
    {
      "id": 19,
      "start": 7271.08,
      "end": 7274.2,
      "formatted_start": "02:01:11.080",
      "formatted_end": "02:01:14.200",
      "text": "خوبی اون قرگیتون رو بزنید بگیر"
    },
    {
      "id": 20,
      "start": 7274.2,
      "end": 7276.2,
      "formatted_start": "02:01:14.200",
      "formatted_end": "02:01:16.200",
      "text": "و از اینکه خواهید سمیت قبضشون رو ناشید"
    },
    {
      "id": 21,
      "start": 7276.2,
      "end": 7277.68,
      "formatted_start": "02:01:16.200",
      "formatted_end": "02:01:17.680",
      "text": "آمان صحیح دارم"
    },
    {
      "id": 22,
      "start": 7277.68,
      "end": 7278.52,
      "formatted_start": "02:01:17.680",
      "formatted_end": "02:01:18.520",
      "text": "بیا"
    },
    {
      "id": 23,
      "start": 7278.52,
      "end": 7279.44,
      "formatted_start": "02:01:18.520",
      "formatted_end": "02:01:19.440",
      "text": "برای؟"
    },
    {
      "id": 24,
      "start": 7279.44,
      "end": 7280.92,
      "formatted_start": "02:01:19.440",
      "formatted_end": "02:01:20.920",
      "text": "برای؟"
    },
    {
      "id": 25,
      "start": 7280.92,
      "end": 7282.56,
      "formatted_start": "02:01:20.920",
      "formatted_end": "02:01:22.560",
      "text": "برای؟"
    },
    {
      "id": 26,
      "start": 7282.56,
      "end": 7284.56,
      "formatted_start": "02:01:22.560",
      "formatted_end": "02:01:24.560",
      "text": "من خوشتش بگیریسم که ببینم که"
    },
    {
      "id": 27,
      "start": 7284.56,
      "end": 7286.56,
      "formatted_start": "02:01:24.560",
      "formatted_end": "02:01:26.560",
      "text": "نه نه میدونه"
    },
    {
      "id": 28,
      "start": 7286.56,
      "end": 7288.56,
      "formatted_start": "02:01:26.560",
      "formatted_end": "02:01:28.560",
      "text": "نه نه از تو نمیدونه"
    },
    {
      "id": 29,
      "start": 7288.56,
      "end": 7290.56,
      "formatted_start": "02:01:28.560",
      "formatted_end": "02:01:30.560",
      "text": "خب چی شده خانم خان احمدین؟"
    },
    {
      "id": 30,
      "start": 7290.56,
      "end": 7292.56,
      "formatted_start": "02:01:30.560",
      "formatted_end": "02:01:32.560",
      "text": "الان دو هفته صرفه دارم"
    },
    {
      "id": 31,
      "start": 7292.56,
      "end": 7294.56,
      "formatted_start": "02:01:32.560",
      "formatted_end": "02:01:34.560",
      "text": "صرفه داره دو هفته"
    },
    {
      "id": 32,
      "start": 7294.56,
      "end": 7296.56,
      "formatted_start": "02:01:34.560",
      "formatted_end": "02:01:36.560",
      "text": "هب اینا چی؟ نه اصلا"
    },
    {
      "id": 33,
      "start": 7296.56,
      "end": 7298.56,
      "formatted_start": "02:01:36.560",
      "formatted_end": "02:01:38.560",
      "text": "فقط صرفه؟ فقط صرفه"
    },
    {
      "id": 34,
      "start": 7298.56,
      "end": 7300.56,
      "formatted_start": "02:01:38.560",
      "formatted_end": "02:01:40.560",
      "text": "دارو چی دادی؟ دارو یه ماه فقط"
    },
    {
      "id": 35,
      "start": 7300.56,
      "end": 7302.56,
      "formatted_start": "02:01:40.560",
      "formatted_end": "02:01:42.560",
      "text": "دیفینی درامی داشتم"
    },
    {
      "id": 36,
      "start": 7302.56,
      "end": 7304.56,
      "formatted_start": "02:01:42.560",
      "formatted_end": "02:01:44.560",
      "text": "دیفینی درامی خب"
    },
    {
      "id": 37,
      "start": 7304.56,
      "end": 7306.56,
      "formatted_start": "02:01:44.560",
      "formatted_end": "02:01:46.560",
      "text": "دارو دیگه نداری؟ نه نه"
    },
    {
      "id": 38,
      "start": 7306.56,
      "end": 7308.56,
      "formatted_start": "02:01:46.560",
      "formatted_end": "02:01:48.560",
      "text": "قد طفل هم نداشته صرفه ها شباه پیشتره یا روز؟"
    },
    {
      "id": 39,
      "start": 7308.56,
      "end": 7311.56,
      "formatted_start": "02:01:48.560",
      "formatted_end": "02:01:51.560",
      "text": "شبا هم بود، روزا هم بود دیگه"
    },
    {
      "id": 40,
      "start": 7311.56,
      "end": 7314.56,
      "formatted_start": "02:01:51.560",
      "formatted_end": "02:01:54.560",
      "text": "سینش قسقس هم داره؟"
    },
    {
      "id": 41,
      "start": 7314.56,
      "end": 7315.56,
      "formatted_start": "02:01:54.560",
      "formatted_end": "02:01:55.560",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 7315.56,
      "end": 7316.56,
      "formatted_start": "02:01:55.560",
      "formatted_end": "02:01:56.560",
      "text": "نه؟"
    },
    {
      "id": 43,
      "start": 7316.56,
      "end": 7318.56,
      "formatted_start": "02:01:56.560",
      "formatted_end": "02:01:58.560",
      "text": "خشک باشه بیشتر"
    },
    {
      "id": 44,
      "start": 7318.56,
      "end": 7320.56,
      "formatted_start": "02:01:58.560",
      "formatted_end": "02:02:00.560",
      "text": "صرفاش خشکه، بیا دیجا منتظرم"
    },
    {
      "id": 45,
      "start": 7320.56,
      "end": 7322.56,
      "formatted_start": "02:02:00.560",
      "formatted_end": "02:02:02.560",
      "text": "چکا به هفت سرش بوده"
    },
    {
      "id": 46,
      "start": 7322.56,
      "end": 7323.56,
      "formatted_start": "02:02:02.560",
      "formatted_end": "02:02:03.560",
      "text": "بله؟"
    },
    {
      "id": 47,
      "start": 7323.56,
      "end": 7326.56,
      "formatted_start": "02:02:03.560",
      "formatted_end": "02:02:06.560",
      "text": "بیا دیجا میشم"
    },
    {
      "id": 48,
      "start": 7326.56,
      "end": 7329.56,
      "formatted_start": "02:02:06.560",
      "formatted_end": "02:02:09.560",
      "text": "بفنج، نفس بکش"
    },
    {
      "id": 49,
      "start": 7329.56,
      "end": 7332.56,
      "formatted_start": "02:02:09.560",
      "formatted_end": "02:02:12.560",
      "text": "نفس مکم بگو"
    },
    {
      "id": 50,
      "start": 7332.56,
      "end": 7335.56,
      "formatted_start": "02:02:12.560",
      "formatted_end": "02:02:15.560",
      "text": "نفس"
    },
    {
      "id": 51,
      "start": 7335.56,
      "end": 7337.56,
      "formatted_start": "02:02:15.560",
      "formatted_end": "02:02:17.560",
      "text": "نفس"
    },
    {
      "id": 52,
      "start": 7337.56,
      "end": 7339.56,
      "formatted_start": "02:02:17.560",
      "formatted_end": "02:02:19.560",
      "text": "نفس"
    },
    {
      "id": 53,
      "start": 7339.56,
      "end": 7341.56,
      "formatted_start": "02:02:19.560",
      "formatted_end": "02:02:21.560",
      "text": "تو باره نفس بکش بکن"
    },
    {
      "id": 54,
      "start": 7341.56,
      "end": 7343.56,
      "formatted_start": "02:02:21.560",
      "formatted_end": "02:02:23.560",
      "text": "نفس بکن"
    },
    {
      "id": 55,
      "start": 7343.56,
      "end": 7345.56,
      "formatted_start": "02:02:23.560",
      "formatted_end": "02:02:25.560",
      "text": "نفس"
    },
    {
      "id": 56,
      "start": 7345.56,
      "end": 7347.56,
      "formatted_start": "02:02:25.560",
      "formatted_end": "02:02:27.560",
      "text": "نفس"
    },
    {
      "id": 57,
      "start": 7347.56,
      "end": 7349.56,
      "formatted_start": "02:02:27.560",
      "formatted_end": "02:02:29.560",
      "text": "اینجا بکن"
    },
    {
      "id": 58,
      "start": 7349.56,
      "end": 7351.56,
      "formatted_start": "02:02:29.560",
      "formatted_end": "02:02:31.560",
      "text": "همین برو"
    },
    {
      "id": 59,
      "start": 7351.56,
      "end": 7353.56,
      "formatted_start": "02:02:31.560",
      "formatted_end": "02:02:33.560",
      "text": "نفس"
    },
    {
      "id": 60,
      "start": 7353.56,
      "end": 7355.56,
      "formatted_start": "02:02:33.560",
      "formatted_end": "02:02:35.560",
      "text": "خیلی بخش"
    },
    {
      "id": 61,
      "start": 7355.56,
      "end": 7357.56,
      "formatted_start": "02:02:35.560",
      "formatted_end": "02:02:37.560",
      "text": "دهند رو باز کنم"
    },
    {
      "id": 62,
      "start": 7357.56,
      "end": 7359.56,
      "formatted_start": "02:02:37.560",
      "formatted_end": "02:02:39.560",
      "text": "دهند رو باز کنم"
    },
    {
      "id": 63,
      "start": 7359.56,
      "end": 7361.56,
      "formatted_start": "02:02:39.560",
      "formatted_end": "02:02:41.560",
      "text": "خیلی باز کنم"
    },
    {
      "id": 64,
      "start": 7361.56,
      "end": 7363.56,
      "formatted_start": "02:02:41.560",
      "formatted_end": "02:02:43.560",
      "text": "خیلی باز کنم"
    },
    {
      "id": 65,
      "start": 7363.56,
      "end": 7365.56,
      "formatted_start": "02:02:43.560",
      "formatted_end": "02:02:45.560",
      "text": "خیلی باز کنم"
    },
    {
      "id": 66,
      "start": 7365.56,
      "end": 7375.56,
      "formatted_start": "02:02:45.560",
      "formatted_end": "02:02:55.560",
      "text": "اینجا باید سرخیت کنیم"
    },
    {
      "id": 67,
      "start": 7375.56,
      "end": 7382.56,
      "formatted_start": "02:02:55.560",
      "formatted_end": "02:03:02.560",
      "text": "درسته کلو باید وزنش بشیم"
    },
    {
      "id": 68,
      "start": 7382.56,
      "end": 7385.56,
      "formatted_start": "02:03:02.560",
      "formatted_end": "02:03:05.560",
      "text": "خوبه، حتی وزنش خوبه"
    },
    {
      "id": 69,
      "start": 7385.56,
      "end": 7389.56,
      "formatted_start": "02:03:05.560",
      "formatted_end": "02:03:09.560",
      "text": "ولی این صرفه ها خانم و دیگه یکمی چولانی شده"
    },
    {
      "id": 70,
      "start": 7389.56,
      "end": 7393.56,
      "formatted_start": "02:03:09.560",
      "formatted_end": "02:03:13.560",
      "text": "من دارو می نویسم اگه تا چند روزه بیدیم"
    },
    {
      "id": 71,
      "start": 7393.56,
      "end": 7395.56,
      "formatted_start": "02:03:13.560",
      "formatted_end": "02:03:15.560",
      "text": "بیتر شد کچی"
    },
    {
      "id": 72,
      "start": 7395.56,
      "end": 7397.56,
      "formatted_start": "02:03:15.560",
      "formatted_end": "02:03:17.560",
      "text": "اگر نشد باید یک عکس بیدیم"
    },
    {
      "id": 73,
      "start": 7397.56,
      "end": 7399.56,
      "formatted_start": "02:03:17.560",
      "formatted_end": "02:03:19.560",
      "text": "خوب"
    },
    {
      "id": 74,
      "start": 7403.56,
      "end": 7405.56,
      "formatted_start": "02:03:23.560",
      "formatted_end": "02:03:25.560",
      "text": "ممکنه روزه داشته باشه؟"
    },
    {
      "id": 75,
      "start": 7405.56,
      "end": 7407.56,
      "formatted_start": "02:03:25.560",
      "formatted_end": "02:03:27.560",
      "text": "مال روزهش باشه؟"
    },
    {
      "id": 76,
      "start": 7407.56,
      "end": 7409.56,
      "formatted_start": "02:03:27.560",
      "formatted_end": "02:03:29.560",
      "text": "نه نه"
    },
    {
      "id": 77,
      "start": 7409.56,
      "end": 7411.56,
      "formatted_start": "02:03:29.560",
      "formatted_end": "02:03:31.560",
      "text": "سینه شده"
    },
    {
      "id": 78,
      "start": 7411.56,
      "end": 7413.56,
      "formatted_start": "02:03:31.560",
      "formatted_end": "02:03:33.560",
      "text": "این دروهاش هم چیز کنیم"
    },
    {
      "id": 79,
      "start": 7413.56,
      "end": 7415.56,
      "formatted_start": "02:03:33.560",
      "formatted_end": "02:03:35.560",
      "text": "آبزهش نداشته"
    },
    {
      "id": 80,
      "start": 7415.56,
      "end": 7417.56,
      "formatted_start": "02:03:35.560",
      "formatted_end": "02:03:37.560",
      "text": "از اینها نداشته؟"
    },
    {
      "id": 81,
      "start": 7417.56,
      "end": 7419.56,
      "formatted_start": "02:03:37.560",
      "formatted_end": "02:03:39.560",
      "text": "دیگه تکرار نشد داره"
    },
    {
      "id": 82,
      "start": 7419.56,
      "end": 7421.56,
      "formatted_start": "02:03:39.560",
      "formatted_end": "02:03:41.560",
      "text": "بله"
    },
    {
      "id": 83,
      "start": 7421.56,
      "end": 7424.56,
      "formatted_start": "02:03:41.560",
      "formatted_end": "02:03:44.560",
      "text": "شب تو خوابان صرفه زیاد میزنه؟"
    },
    {
      "id": 84,
      "start": 7424.56,
      "end": 7426.56,
      "formatted_start": "02:03:44.560",
      "formatted_end": "02:03:46.560",
      "text": "بعضی شباه آره ولی بعضی شباه نه"
    },
    {
      "id": 85,
      "start": 7426.56,
      "end": 7429.56,
      "formatted_start": "02:03:46.560",
      "formatted_end": "02:03:49.560",
      "text": "بعضی شباه آره بعضی شباه نه"
    },
    {
      "id": 86,
      "start": 7432.56,
      "end": 7434.56,
      "formatted_start": "02:03:52.560",
      "formatted_end": "02:03:54.560",
      "text": "تنگ نفس هم بهش دست میده؟"
    },
    {
      "id": 87,
      "start": 7434.56,
      "end": 7435.56,
      "formatted_start": "02:03:54.560",
      "formatted_end": "02:03:55.560",
      "text": "نه"
    },
    {
      "id": 88,
      "start": 7435.56,
      "end": 7438.56,
      "formatted_start": "02:03:55.560",
      "formatted_end": "02:03:58.560",
      "text": "سابقه آسم و آلیجی تو خانواده داره؟"
    },
    {
      "id": 89,
      "start": 7442.56,
      "end": 7444.56,
      "formatted_start": "02:04:02.560",
      "formatted_end": "02:04:04.560",
      "text": "برس میگو درانده بیدیم"
    },
    {
      "id": 90,
      "start": 7444.56,
      "end": 7446.56,
      "formatted_start": "02:04:04.560",
      "formatted_end": "02:04:06.560",
      "text": "صرفه زیاد میزنه"
    },
    {
      "id": 91,
      "start": 7446.56,
      "end": 7448.56,
      "formatted_start": "02:04:06.560",
      "formatted_end": "02:04:08.560",
      "text": "خیلی ببینید این داروها رو ببینید صرف کنم"
    },
    {
      "id": 92,
      "start": 7448.56,
      "end": 7450.56,
      "formatted_start": "02:04:08.560",
      "formatted_end": "02:04:10.560",
      "text": "داروها شو بگیم بیاد من ببینم"
    },
    {
      "id": 93,
      "start": 7450.56,
      "end": 7460.56,
      "formatted_start": "02:04:10.560",
      "formatted_end": "02:04:20.560",
      "text": "ببینم؟ خدمت شما بیمه هستید دیگره؟ بیمه چیه؟ برای اشتغاش و اینا"
    },
    {
      "id": 94,
      "start": 7460.56,
      "end": 7466.56,
      "formatted_start": "02:04:20.560",
      "formatted_end": "02:04:26.560",
      "text": "اشتغاش میخونه حلوله نخوره و شبت راسیب بگیرید اگه خیلی بیشتر آزاده"
    },
    {
      "id": 95,
      "start": 7466.56,
      "end": 7468.56,
      "formatted_start": "02:04:26.560",
      "formatted_end": "02:04:28.560",
      "text": "با دستش بگیرید"
    },
    {
      "id": 96,
      "start": 7480.56,
      "end": 7485.56,
      "formatted_start": "02:04:40.560",
      "formatted_end": "02:04:45.560",
      "text": "آزاده؟"
    },
