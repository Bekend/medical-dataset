  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4512.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:12.000",
      "text": "از این تب تنانی یک هفته، ایسار خسخسخسی نزن میده کراکه. ایسارش خیلی بالا منی 65. چرا مارخص کردی؟ میذاشتیت بیوارسان ایمانو؟"
    },
    {
      "id": 1,
      "start": 4512.0,
      "end": 4520.0,
      "formatted_start": "01:15:12.000",
      "formatted_end": "01:15:20.000",
      "text": "خسته شده، نوزد چیز کردی برای؟ خانه به بادایی میشون میده. میدهی؟"
    },
    {
      "id": 2,
      "start": 4520.0,
      "end": 4522.0,
      "formatted_start": "01:15:20.000",
      "formatted_end": "01:15:22.000",
      "text": "خوشم خوشم بر سریع"
    },
    {
      "id": 3,
      "start": 4528.0,
      "end": 4530.0,
      "formatted_start": "01:15:28.000",
      "formatted_end": "01:15:30.000",
      "text": "خواستی بیرن مشتت بر برده بیرن"
    },
    {
      "id": 4,
      "start": 4530.0,
      "end": 4532.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:32.000",
      "text": "جانو درشت ما باید مدار کنید بگیرم نگرد کنیم"
    },
    {
      "id": 5,
      "start": 4532.0,
      "end": 4533.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:33.000",
      "text": "نخواست شما بیرن"
    },
    {
      "id": 6,
      "start": 4533.0,
      "end": 4534.0,
      "formatted_start": "01:15:33.000",
      "formatted_end": "01:15:34.000",
      "text": "کشکال ندار من بیرن"
    },
    {
      "id": 7,
      "start": 4534.0,
      "end": 4536.0,
      "formatted_start": "01:15:34.000",
      "formatted_end": "01:15:36.000",
      "text": "باید بیرن که برایش مشتت از یکی کنه"
    },
    {
      "id": 8,
      "start": 4536.0,
      "end": 4538.0,
      "formatted_start": "01:15:36.000",
      "formatted_end": "01:15:38.000",
      "text": "مشتت داری شی؟"
    },
    {
      "id": 9,
      "start": 4538.0,
      "end": 4540.0,
      "formatted_start": "01:15:38.000",
      "formatted_end": "01:15:40.000",
      "text": "نه از یکی کنم برم مشتت دادی رقص برن"
    },
    {
      "id": 10,
      "start": 4540.0,
      "end": 4542.0,
      "formatted_start": "01:15:40.000",
      "formatted_end": "01:15:42.000",
      "text": "که میخوام بیریم؟"
    },
    {
      "id": 11,
      "start": 4542.0,
      "end": 4544.0,
      "formatted_start": "01:15:42.000",
      "formatted_end": "01:15:44.000",
      "text": "همین فردا پس فردا"
    },
    {
      "id": 12,
      "start": 4544.0,
      "end": 4546.0,
      "formatted_start": "01:15:44.000",
      "formatted_end": "01:15:46.000",
      "text": "فردا یا پس فردا؟"
    },
    {
      "id": 13,
      "start": 4546.0,
      "end": 4548.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:48.000",
      "text": "ساعت چند؟"
    },
    {
      "id": 14,
      "start": 4548.0,
      "end": 4550.0,
      "formatted_start": "01:15:48.000",
      "formatted_end": "01:15:50.000",
      "text": "از این وضع را بیاری کنیم و اموال کنیم؟"
    },
    {
      "id": 15,
      "start": 4550.0,
      "end": 4554.0,
      "formatted_start": "01:15:50.000",
      "formatted_end": "01:15:54.000",
      "text": "ببینید اگر وضعیت اومی بچه خوبه برای آزمایشاش افرانت و بالانه بیاری"
    },
    {
      "id": 16,
      "start": 4554.0,
      "end": 4556.0,
      "formatted_start": "01:15:54.000",
      "formatted_end": "01:15:56.000",
      "text": "اوه اینجا برگرده نه"
    },
    {
      "id": 17,
      "start": 4556.0,
      "end": 4558.0,
      "formatted_start": "01:15:56.000",
      "formatted_end": "01:15:58.000",
      "text": "برگردید یه هفته تون میشه"
    },
    {
      "id": 18,
      "start": 4558.0,
      "end": 4560.0,
      "formatted_start": "01:15:58.000",
      "formatted_end": "01:16:00.000",
      "text": "این تا آخره"
    },
    {
      "id": 19,
      "start": 4560.0,
      "end": 4562.0,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:02.000",
      "text": "آره یه هفته تون میشه"
    },
    {
      "id": 20,
      "start": 4562.0,
      "end": 4564.0,
      "formatted_start": "01:16:02.000",
      "formatted_end": "01:16:04.000",
      "text": "من دارو آنکول اینا میلیسم"
    },
    {
      "id": 21,
      "start": 4564.0,
      "end": 4566.0,
      "formatted_start": "01:16:04.000",
      "formatted_end": "01:16:06.000",
      "text": "آنکولاش را درست بزن"
    },
    {
      "id": 22,
      "start": 4566.0,
      "end": 4568.0,
      "formatted_start": "01:16:06.000",
      "formatted_end": "01:16:08.000",
      "text": "بعد شروط خوش کننده اینا میلیسم"
    },
    {
      "id": 23,
      "start": 4568.0,
      "end": 4570.0,
      "formatted_start": "01:16:08.000",
      "formatted_end": "01:16:10.000",
      "text": "اینا ویروسه"
    },
    {
      "id": 24,
      "start": 4570.0,
      "end": 4572.0,
      "formatted_start": "01:16:10.000",
      "formatted_end": "01:16:12.000",
      "text": "ممکنه از این گوشات را در بدنش پر باشه"
    },
    {
      "id": 25,
      "start": 4578.0,
      "end": 4608.0,
      "formatted_start": "01:16:18.000",
      "formatted_end": "01:16:48.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 26,
      "start": 4608.0,
      "end": 4638.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:17:18.000",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 27,
      "start": 4638.0,
      "end": 4648.0,
      "formatted_start": "01:17:18.000",
      "formatted_end": "01:17:28.000",
      "text": "بگید آنکولا دو تعلام میزنند اینکه فردا صرف 111 اینکه هم فردا گروه صحبت 6 بگیر میزنند"
    },
    {
      "id": 28,
      "start": 4648.0,
      "end": 4654.0,
      "formatted_start": "01:17:28.000",
      "formatted_end": "01:17:34.000",
      "text": "اینه چیزی میبینید؟"
    },
    {
      "id": 29,
      "start": 4654.0,
      "end": 4662.0,
      "formatted_start": "01:17:34.000",
      "formatted_end": "01:17:42.000",
      "text": "این در راه شاید بیا بهم"
    },
    {
      "id": 30,
      "start": 4662.0,
      "end": 4664.0,
      "formatted_start": "01:17:42.000",
      "formatted_end": "01:17:44.000",
      "text": "اشتراهات جهان"
    },
    {
      "id": 31,
      "start": 4664.0,
      "end": 4666.0,
      "formatted_start": "01:17:44.000",
      "formatted_end": "01:17:46.000",
      "text": "اشتراهات اگر... الان که بچه خوبه"
    },
    {
      "id": 32,
      "start": 4666.0,
      "end": 4668.0,
      "formatted_start": "01:17:46.000",
      "formatted_end": "01:17:48.000",
      "text": "بچه خوبه"
    },
    {
      "id": 33,
      "start": 4668.0,
      "end": 4670.0,
      "formatted_start": "01:17:48.000",
      "formatted_end": "01:17:50.000",
      "text": "خیلی خواهیدیست"
    },
    {
      "id": 34,
      "start": 4670.0,
      "end": 4672.0,
      "formatted_start": "01:17:50.000",
      "formatted_end": "01:17:52.000",
      "text": "جثه پدر مادر هم ضعیفه"
    },
    {
      "id": 35,
      "start": 4672.0,
      "end": 4674.0,
      "formatted_start": "01:17:52.000",
      "formatted_end": "01:17:54.000",
      "text": "هشت رو چنده؟"
    },
    {
      "id": 36,
      "start": 4674.0,
      "end": 4676.0,
      "formatted_start": "01:17:54.000",
      "formatted_end": "01:17:56.000",
      "text": "هشت بیبستن"
    },
    {
      "id": 37,
      "start": 4676.0,
      "end": 4678.0,
      "formatted_start": "01:17:56.000",
      "formatted_end": "01:17:58.000",
      "text": "بعد یک آبادم بیدیم من برای فاش بگم"
    },
    {
      "id": 38,
      "start": 4678.0,
      "end": 4680.0,
      "formatted_start": "01:17:58.000",
      "formatted_end": "01:18:00.000",
      "text": "برای یک آبادم ببینیم"
    },
    {
      "id": 39,
      "start": 4680.0,
      "end": 4682.0,
      "formatted_start": "01:18:00.000",
      "formatted_end": "01:18:02.000",
      "text": "اون هم بیتامیل عاده"
    },
    {
      "id": 40,
      "start": 4682.0,
      "end": 4684.0,
      "formatted_start": "01:18:02.000",
      "formatted_end": "01:18:04.000",
      "text": "دیمارستان میگفتم"
    },
    {
      "id": 41,
      "start": 4684.0,
      "end": 4686.0,
      "formatted_start": "01:18:04.000",
      "formatted_end": "01:18:06.000",
      "text": "شرط خارجی ببینیم"
    },
    {
      "id": 42,
      "start": 4686.0,
      "end": 4688.0,
      "formatted_start": "01:18:06.000",
      "formatted_end": "01:18:08.000",
      "text": "خب اون عاده رو از بیدا شنا بگیرید"
    },
    {
      "id": 43,
      "start": 4688.0,
      "end": 4690.0,
      "formatted_start": "01:18:08.000",
      "formatted_end": "01:18:10.000",
      "text": "بیمه ساعتیش"
    },
    {
      "id": 44,
      "start": 4690.0,
      "end": 4691.0,
      "formatted_start": "01:18:10.000",
      "formatted_end": "01:18:11.000",
      "text": "کم کلو بوده؟"
    },
    {
      "id": 45,
      "start": 4691.0,
      "end": 4692.0,
      "formatted_start": "01:18:11.000",
      "formatted_end": "01:18:12.000",
      "text": "دو و هشتر"
    },
    {
      "id": 46,
      "start": 4692.0,
      "end": 4694.0,
      "formatted_start": "01:18:12.000",
      "formatted_end": "01:18:14.000",
      "text": "دو و هشتر تولدشم بوده"
    },
    {
      "id": 47,
      "start": 4694.0,
      "end": 4698.0,
      "formatted_start": "01:18:14.000",
      "formatted_end": "01:18:18.000",
      "text": "حالا هم نصف جسد مادر و وزن تولد خوبه"
    },
    {
      "id": 48,
      "start": 4698.0,
      "end": 4701.0,
      "formatted_start": "01:18:18.000",
      "formatted_end": "01:18:21.000",
      "text": "هم میشه دادنش از جنگ نیم کنه؟"
    },
    {
      "id": 49,
      "start": 4701.0,
      "end": 4704.0,
      "formatted_start": "01:18:21.000",
      "formatted_end": "01:18:24.000",
      "text": "نیم شده باشه حالا که نه"
    },
    {
      "id": 50,
      "start": 4704.0,
      "end": 4707.0,
      "formatted_start": "01:18:24.000",
      "formatted_end": "01:18:27.000",
      "text": "باید باید باید آن پولا چی باستی چون خوش کرده"
    },
    {
      "id": 51,
      "start": 4707.0,
      "end": 4709.0,
      "formatted_start": "01:18:27.000",
      "formatted_end": "01:18:29.000",
      "text": "برای هم افونه هستی؟"
    },
    {
      "id": 52,
      "start": 4709.0,
      "end": 4739.0,
      "formatted_start": "01:18:29.000",
      "formatted_end": "01:18:59.000",
      "text": "بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله ب"
    },
    {
      "id": 53,
      "start": 4739.0,
      "end": 4745.0,
      "formatted_start": "01:18:59.000",
      "formatted_end": "01:19:05.000",
      "text": "آقای دختر ما یا آن پروزو بزنید، آزینش نیست، میبینید یک یک یکی نیست"
    },
    {
      "id": 54,
      "start": 4745.0,
      "end": 4751.0,
      "formatted_start": "01:19:05.000",
      "formatted_end": "01:19:11.000",
      "text": "آقای ما این سالاتتو بگم نه، یک وقت بچه گریه کرد، یک زیاد شده"
    },
    {
      "id": 55,
      "start": 4751.0,
      "end": 4755.0,
      "formatted_start": "01:19:11.000",
      "formatted_end": "01:19:15.000",
      "text": "نه، ما حالا سی سال را دقیق میزنیم، مشکلی بوجود نیست"
    },
    {
      "id": 56,
      "start": 4755.0,
      "end": 4760.0,
      "formatted_start": "01:19:15.000",
      "formatted_end": "01:19:20.000",
      "text": "خب درد داره، آن پروز درد داره، آن پروز درد نداره، درد داره"
    },
    {
      "id": 57,
      "start": 4760.0,
      "end": 4763.0,
      "formatted_start": "01:19:20.000",
      "formatted_end": "01:19:23.000",
      "text": "ولی درد را شدید، بسیار دقیق گریه میکنید، میرید دیگه"
    },
    {
      "id": 58,
      "start": 4763.0,
      "end": 4765.32,
      "formatted_start": "01:19:23.000",
      "formatted_end": "01:19:25.320",
      "text": "اما نمیگه میبینیم که اینجا اینجا امران نمیگه میبینیم یکی وقتی مردتی"
    },
    {
      "id": 59,
      "start": 4765.32,
      "end": 4766.24,
      "formatted_start": "01:19:25.320",
      "formatted_end": "01:19:26.240",
      "text": "زمانت نمیشه"
    },
    {
      "id": 60,
      "start": 4766.24,
      "end": 4769.2,
      "formatted_start": "01:19:26.240",
      "formatted_end": "01:19:29.200",
      "text": "مثلا یک چیزی میگی که من اتباع هم نمیشه"
    },
    {
      "id": 61,
      "start": 4769.2,
      "end": 4771.08,
      "formatted_start": "01:19:29.200",
      "formatted_end": "01:19:31.080",
      "text": "آدم میگم آره نه"
    },
    {
      "id": 62,
      "start": 4771.08,
      "end": 4773.32,
      "formatted_start": "01:19:31.080",
      "formatted_end": "01:19:33.320",
      "text": "آره بگم شاید یک وقتی آمد کش اومد"
    },
    {
      "id": 63,
      "start": 4773.32,
      "end": 4774.06,
      "formatted_start": "01:19:33.320",
      "formatted_end": "01:19:34.060",
      "text": "نه بگم"
    },
    {
      "id": 64,
      "start": 4774.06,
      "end": 4777.2,
      "formatted_start": "01:19:34.060",
      "formatted_end": "01:19:37.200",
      "text": "ببین اینا شک نکنه فکر نکن"
    },
    {
      "id": 65,
      "start": 4777.2,
      "end": 4778.16,
      "formatted_start": "01:19:37.200",
      "formatted_end": "01:19:38.160",
      "text": "حضیت میشه"
    },
    {
      "id": 66,
      "start": 4778.16,
      "end": 4780.24,
      "formatted_start": "01:19:38.160",
      "formatted_end": "01:19:40.240",
      "text": "انشالله خوب میشه"
    },
    {
      "id": 67,
      "start": 4780.24,
      "end": 4782.24,
      "formatted_start": "01:19:40.240",
      "formatted_end": "01:19:42.240",
      "text": "این حالا میزنیم ایش خودم چیزی نشده"
    },
    {
      "id": 68,
      "start": 4793.0,
      "end": 4800.0,
      "formatted_start": "01:19:53.000",
      "formatted_end": "01:20:00.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}