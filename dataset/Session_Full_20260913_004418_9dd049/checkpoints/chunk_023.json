  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6930.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:30.000",
      "text": "از اینکه در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت،"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6935.68,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:35.680",
      "text": "خیلی ها فکر می کنند که خواهند بردارد که زیر یک سخت بزرگ شدن یک کودکی مشترک ببرند."
    },
    {
      "id": 2,
      "start": 6935.68,
      "end": 6938.18,
      "formatted_start": "01:55:35.680",
      "formatted_end": "01:55:38.180",
      "text": "اما خواهی از اینکه هیچ دو خواهند بردارید."
    },
    {
      "id": 3,
      "start": 6938.18,
      "end": 6941.56,
      "formatted_start": "01:55:38.180",
      "formatted_end": "01:55:41.560",
      "text": "هم تو اگه توی یک خانم بزرگ شده باشند، کودکی شد شد."
    },
    {
      "id": 4,
      "start": 6946.56,
      "end": 6952.44,
      "formatted_start": "01:55:46.560",
      "formatted_end": "01:55:52.440",
      "text": "بعد از ویدیوی خوامی که در خود قهر بازاشدم، خیلی کاملز گرفتم که خیلی ها قهر را با سکوت یکی اونطور استند."
    },
    {
      "id": 5,
      "start": 6952.44,
      "end": 6954.06,
      "formatted_start": "01:55:52.440",
      "formatted_end": "01:55:54.060",
      "text": "اما این دوتا یک چیز نیستند."
    },
    {
      "id": 6,
      "start": 6954.06,
      "end": 6957.9,
      "formatted_start": "01:55:54.060",
      "formatted_end": "01:55:57.900",
      "text": "مکرد که از بیرون شرکی هم باشند، توش قلقای همون ازادن باشه."
    },
    {
      "id": 7,
      "start": 6957.9,
      "end": 6961.26,
      "formatted_start": "01:55:57.900",
      "formatted_end": "01:56:01.260",
      "text": "اما اینکاری نیست. ما توی رماشاسی فقط به رفتار کار نمی کنیم."
    },
    {
      "id": 8,
      "start": 6961.26,
      "end": 6964.06,
      "formatted_start": "01:56:01.260",
      "formatted_end": "01:56:04.060",
      "text": "من که میخورستیم میگیم این رفتار چه کاری تقریب داره؟"
    },
    {
      "id": 9,
      "start": 6964.06,
      "end": 6967.86,
      "formatted_start": "01:56:04.060",
      "formatted_end": "01:56:07.860",
      "text": "اگه من سوگوت میگم تا تو رو مستقبل کنم، تو دوبارم بگیر."
    },
    {
      "id": 10,
      "start": 6967.86,
      "end": 6971.46,
      "formatted_start": "01:56:07.860",
      "formatted_end": "01:56:11.460",
      "text": "احساس گناه، قرمی کتاب، یا رفتار رو تغذیب کنیم میشه قراری."
    },
    {
      "id": 11,
      "start": 6971.46,
      "end": 6973.86,
      "formatted_start": "01:56:11.460",
      "formatted_end": "01:56:13.860",
      "text": "این چه سوگوت میشه یک ابزاری خودشون بود."
    },
    {
      "id": 12,
      "start": 6973.86,
      "end": 6981.86,
      "formatted_start": "01:56:13.860",
      "formatted_end": "01:56:21.860",
      "text": "اما اگه من بالا حرف زدن، توضیح دادن، احساساتان رو گفتم و هر بار با تغییر و تغمی و پرخوشگری یا بیتوجبی رو دارم،"
    },
    {
      "id": 13,
      "start": 6981.86,
      "end": 6987.86,
      "formatted_start": "01:56:21.860",
      "formatted_end": "01:56:27.860",
      "text": "مونتر تصمیم میدیم اون رو برده بحث نشن. نه بخواد اینکه تو رو تمنی بارم، بلکه میخوام از خودم محفظت کنم."
    },
    {
      "id": 14,
      "start": 6987.86,
      "end": 6991.86,
      "formatted_start": "01:56:27.860",
      "formatted_end": "01:56:31.860",
      "text": "چون میدونم که ادامه دادن یک گفته مفهوم داره به روان مناسب میزنه."
    },
    {
      "id": 15,
      "start": 6991.86,
      "end": 6996.86,
      "formatted_start": "01:56:31.860",
      "formatted_end": "01:56:36.860",
      "text": "پس توابط این دوتا توی سکوتشون نیست، توی حدث سکوته."
    },
    {
      "id": 16,
      "start": 6996.86,
      "end": 7002.86,
      "formatted_start": "01:56:36.860",
      "formatted_end": "01:56:42.860",
      "text": "قرار می‌گیر من می‌خوام تون رو نرم بدم، سکوت رفت‌هایی می‌گه من می‌خوام از خودم محفظت بگم."
    },
    {
      "id": 17,
      "start": 7002.86,
      "end": 7012.86,
      "formatted_start": "01:56:42.860",
      "formatted_end": "01:56:52.860",
      "text": "مثلا توی روابط با خود‌چیفته‌ها، خود‌چیفته از قهر استفاده می‌کنه تا طرف مقابل رو مسترده بکنه، باوست بکنه و بادار بتصمیم کنه."
    },
    {
      "id": 18,
      "start": 7012.86,
      "end": 7017.86,
      "formatted_start": "01:56:52.860",
      "formatted_end": "01:56:57.860",
      "text": "اما طرف مقابل چی می‌شه؟ من از مقابل‌ها تراشیدی نتیجه، سکوت انتخاب می‌کنه."
    },
    {
      "id": 19,
      "start": 7017.86,
      "end": 7022.86,
      "formatted_start": "01:56:57.860",
      "formatted_end": "01:57:02.860",
      "text": "نه بخواد اینکه اون رو کنترل کنه، بلکه بخواد اینکه هیچ راه ساله نیست برای محفظت از خودشی نیبینه."
    },
    {
      "id": 20,
      "start": 7022.86,
      "end": 7025.86,
      "formatted_start": "01:57:02.860",
      "formatted_end": "01:57:05.860",
      "text": "پس هر سکوتی قریب است."
    },
    {
      "id": 21,
      "start": 7025.86,
      "end": 7030.86,
      "formatted_start": "01:57:05.860",
      "formatted_end": "01:57:10.860",
      "text": "کامی وقت و سکوت آخری راه یک آدم برای حساب سلامت روانش خیلان کنه."
    },
    {
      "id": 22,
      "start": 7030.86,
      "end": 7037.86,
      "formatted_start": "01:57:10.860",
      "formatted_end": "01:57:17.860",
      "text": "قرار، سکوتی برای کنترله دیگه، سکوت دفاعی، سکوتی برای محفظت."
    },
    {
      "id": 23,
      "start": 7037.86,
      "end": 7044.28,
      "formatted_start": "01:57:17.860",
      "formatted_end": "01:57:24.280",
      "text": "امروز میخوام راجع به یه میجنی از خودشیف تا هم تزامن که شاید خیلی از آن فکر کنند که به خودشیف دیگر رنگش داشته"
    },
    {
      "id": 24,
      "start": 7044.28,
      "end": 7045.76,
      "formatted_start": "01:57:24.280",
      "formatted_end": "01:57:25.760",
      "text": "و اونم خیلی ساسته"
    },
    {
      "id": 25,
      "start": 7045.76,
      "end": 7052.26,
      "formatted_start": "01:57:25.760",
      "formatted_end": "01:57:32.260",
      "text": "وقتی از این خودشیف نیاد، معمولان مایر دارن این را درست که داباره نباید جورترسیده یه خودشو براتر از برگیر میدونه"
    },
    {
      "id": 26,
      "start": 7052.26,
      "end": 7057.14,
      "formatted_start": "01:57:32.260",
      "formatted_end": "01:57:37.140",
      "text": "کمتر ایت از این فکر میدونه که خیلی ساسته نمیتونه از این ایجیای خودشیف داروشن"
    },
    {
      "id": 27,
      "start": 7057.14,
      "end": 7063.14,
      "formatted_start": "01:57:37.140",
      "formatted_end": "01:57:43.140",
      "text": "بنابراین از راه خواستانان خودشیده، خیلی از آنهای خودشیده، وقتی توی خودشون وطن داشتن،"
    },
    {
      "id": 28,
      "start": 7063.14,
      "end": 7066.14,
      "formatted_start": "01:57:43.140",
      "formatted_end": "01:57:46.140",
      "text": "در حال خواست کارها و به حضرت توی خودشون هیچ مقداریت ندیدن."
    },
    {
      "id": 29,
      "start": 7066.14,
      "end": 7072.14,
      "formatted_start": "01:57:46.140",
      "formatted_end": "01:57:52.140",
      "text": "اما وقتی اومده بچه و همسر و از راه خانواده نرزه، یه لحظه همه چیز برای شون تبدیل حاضر نمیشه."
    },
    {
      "id": 30,
      "start": 7072.14,
      "end": 7081.14,
      "formatted_start": "01:57:52.140",
      "formatted_end": "01:58:01.140",
      "text": "این خصوصات هم باقی در مورد فروغ نیست. وقتشون، انرژیشون، حبتشون، توجهشون و حتی تحریف و تقصیلشون هم میتونه درستی سیده که باشه."
    },
    {
      "id": 31,
      "start": 7081.14,
      "end": 7085.14,
      "formatted_start": "01:58:01.140",
      "formatted_end": "01:58:05.140",
      "text": "اگه یک کاری برای منتجا بند، آن را اتضاع بوده که چند پرورد را فسد قیلند."
    },
    {
      "id": 32,
      "start": 7085.14,
      "end": 7091.14,
      "formatted_start": "01:58:05.140",
      "formatted_end": "01:58:11.140",
      "text": "اون که رکام و عددتان روز روز فرهی یا عدستی را میگه توی رفتارون برای که احساس باید نشانشون به دقیقه همون بود."
    },
    {
      "id": 33,
      "start": 7091.14,
      "end": 7098.14,
      "formatted_start": "01:58:11.140",
      "formatted_end": "01:58:18.140",
      "text": "این خصوصیت با تفکری منظر مدت و موادی هم درد کنند. اونجوران این استفاده است کنند که هنجا را نداشتند، دازند لیدر هستند."
    },
    {
      "id": 34,
      "start": 7098.14,
      "end": 7101.14,
      "formatted_start": "01:58:18.140",
      "formatted_end": "01:58:21.140",
      "text": "فرمایه شخصیت به خود شیفته با شخصیت به نمایشی چیست؟"
    },
    {
      "id": 35,
      "start": 7101.14,
      "end": 7104.14,
      "formatted_start": "01:58:21.140",
      "formatted_end": "01:58:24.140",
      "text": "خیلی در اختراف، مایو دختر و شخصیت به نمایشی اشتباه میگیرند."
    },
    {
      "id": 36,
      "start": 7104.14,
      "end": 7106.14,
      "formatted_start": "01:58:24.140",
      "formatted_end": "01:58:26.140",
      "text": "چون خیلی خیلی خیلی خوشیده هستند."
    },
    {
      "id": 37,
      "start": 7106.14,
      "end": 7113.14,
      "formatted_start": "01:58:26.140",
      "formatted_end": "01:58:33.140",
      "text": "شخص اند نوشی و شخص اند خودشی در خوشه به اختلاف شخصی افراد میرکنن شخص اند پریز و زده شیطانی."
    },
    {
      "id": 38,
      "start": 7113.14,
      "end": 7123.14,
      "formatted_start": "01:58:33.140",
      "formatted_end": "01:58:43.140",
      "text": "با دمویدیگر کارش را بسطر بگویشن، بلوگ های افرادشون خیلی هر یجانی و شبیه روایتشان پرتنش یک افراد را میزن، قیل قابل پیش فریده."
    },
    {
      "id": 39,
      "start": 7123.14,
      "end": 7131.14,
      "formatted_start": "01:58:43.140",
      "formatted_end": "01:58:51.140",
      "text": "اما اختیار شخصی که نماشی و خودشیفته، نیاز زیاد به توجه و تحییل عملی دارن، به همین خاطر خیلی هم اینکه رو باید گشت با رو میگرن."
    },
    {
      "id": 40,
      "start": 7131.14,
      "end": 7134.14,
      "formatted_start": "01:58:51.140",
      "formatted_end": "01:58:54.140",
      "text": "اما این تقویل های مهمی داره که معلوم هر جا میده."
    },
    {
      "id": 41,
      "start": 7134.14,
      "end": 7137.8,
      "formatted_start": "01:58:54.140",
      "formatted_end": "01:58:57.800",
      "text": "اولا، با مهم زرگتر بگویدشون انگزهی باشه رفتار شده."
    },
    {
      "id": 42,
      "start": 7137.8,
      "end": 7140.3,
      "formatted_start": "01:58:57.800",
      "formatted_end": "01:59:00.300",
      "text": "کسی که شخصی به نمایشی داره، با هم میخواد دیده بشه."
    },
    {
      "id": 43,
      "start": 7140.3,
      "end": 7143.84,
      "formatted_start": "01:59:00.300",
      "formatted_end": "01:59:03.840",
      "text": "برایش مهم نیست تحصیلش کنند، یا هم تا که یکی ازش اعتبار کنند،"
    },
    {
      "id": 44,
      "start": 7143.84,
      "end": 7145.84,
      "formatted_start": "01:59:03.840",
      "formatted_end": "01:59:05.840",
      "text": "فقط میخواد نادیده گرفته نشد."
    },
    {
      "id": 45,
      "start": 7145.84,
      "end": 7150.48,
      "formatted_start": "01:59:05.840",
      "formatted_end": "01:59:10.480",
      "text": "اما کسی که خود چیز دست، با هم دیده شده، برایش کنند کسی میخواد تحصیل میشه،"
    },
    {
      "id": 46,
      "start": 7150.48,
      "end": 7154.04,
      "formatted_start": "01:59:10.480",
      "formatted_end": "01:59:14.040",
      "text": "خواست به نظر مرسه احتمالاتی و احساساتی به طریقشه"
    },
    {
      "id": 47,
      "start": 7154.04,
      "end": 7156.64,
      "formatted_start": "01:59:14.040",
      "formatted_end": "01:59:16.640",
      "text": "انتقاما انتقامات رو براش به تحقیق کندم هست"
    },
    {
      "id": 48,
      "start": 7156.64,
      "end": 7160.8,
      "formatted_start": "01:59:16.640",
      "formatted_end": "01:59:20.800",
      "text": "یه دردیگه شخص به نمایش آنگرد که خودشو حاصل پردارید و نبگان بانش کنه"
    },
    {
      "id": 49,
      "start": 7160.8,
      "end": 7163.2,
      "formatted_start": "01:59:20.800",
      "formatted_end": "01:59:23.200",
      "text": "فقط با حال دیگه خودشو جلد نویجم کنه"
    },
    {
      "id": 50,
      "start": 7163.2,
      "end": 7165.6,
      "formatted_start": "01:59:23.200",
      "formatted_end": "01:59:25.600",
      "text": "اما شخص به خودشیده انتقاما تلاشون داره"
    },
    {
      "id": 51,
      "start": 7165.6,
      "end": 7168.6,
      "formatted_start": "01:59:25.600",
      "formatted_end": "01:59:28.600",
      "text": "به اثیر قدرتی من تو موفق و بره تر از خودشی شده"
    },
    {
      "id": 52,
      "start": 7168.6,
      "end": 7171.24,
      "formatted_start": "01:59:28.600",
      "formatted_end": "01:59:31.240",
      "text": "ترداده داموشه از آن بره تنگیر"
    },
    {
      "id": 53,
      "start": 7171.24,
      "end": 7174.74,
      "formatted_start": "01:59:31.240",
      "formatted_end": "01:59:34.740",
      "text": "از از بغل برشی بر سر بودن، این بسیاری گاه خودچیخت است"
    },
    {
      "id": 54,
      "start": 7174.74,
      "end": 7178.2,
      "formatted_start": "01:59:34.740",
      "formatted_end": "01:59:38.200",
      "text": "اما شخص به نمونش یک نحساس نداره، من به شما باید دیده بشم"
    },
    {
      "id": 55,
      "start": 7178.2,
      "end": 7181.74,
      "formatted_start": "01:59:38.200",
      "formatted_end": "01:59:41.740",
      "text": "اگه برم توی مهمونی، شخص به نمونش یک تلاش بودن"
    },
    {
      "id": 56,
      "start": 7181.74,
      "end": 7184.48,
      "formatted_start": "01:59:41.740",
      "formatted_end": "01:59:44.480",
      "text": "من به نگاه به سمتش آشنگ و سرده با سمت ماردو بشه"
    },
    {
      "id": 57,
      "start": 7184.48,
      "end": 7185.56,
      "formatted_start": "01:59:44.480",
      "formatted_end": "01:59:45.560",
      "text": "و افتاره با داره بشم"
    },
    {
      "id": 58,
      "start": 7185.56,
      "end": 7189.24,
      "formatted_start": "01:59:45.560",
      "formatted_end": "01:59:49.240",
      "text": "اما از اینجا تلاش بودن، من به شما باید دارم"
    },
    {
      "id": 59,
      "start": 7189.24,
      "end": 7192.4,
      "formatted_start": "01:59:49.240",
      "formatted_end": "01:59:52.400",
      "text": "اینه با پیش رو داره با برکه است"
    },
    {
      "id": 60,
      "start": 7192.4,
      "end": 7197.08,
      "formatted_start": "01:59:52.400",
      "formatted_end": "01:59:57.080",
      "text": "شخصیت نمونی شده این بابستگی حیجانی به راحتش داره"
    },
    {
      "id": 61,
      "start": 7197.08,
      "end": 7199.98,
      "formatted_start": "01:59:57.080",
      "formatted_end": "01:59:59.980",
      "text": "اما خودشکته اون راحتش رو به من افضاوی برای دستید"
    }
  ],
  "status": "completed"
}