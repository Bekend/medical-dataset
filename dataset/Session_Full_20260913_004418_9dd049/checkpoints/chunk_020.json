  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6011.48,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:11.480",
      "text": "این چند تا موضوعی که فرزنده نیاز داره از زمانت بشنره و شمیدرش میتونه خیلی زندگیش رو شمیدر کنه، پس از شمیدر آنها محبتش نکنه."
    },
    {
      "id": 1,
      "start": 6011.48,
      "end": 6016.22,
      "formatted_start": "01:40:11.480",
      "formatted_end": "01:40:16.220",
      "text": "یکی، من افتخار کنم پدر یا مادر تو هستی."
    },
    {
      "id": 2,
      "start": 6016.66,
      "end": 6026.74,
      "formatted_start": "01:40:16.660",
      "formatted_end": "01:40:26.740",
      "text": "دو، متاسفه موقع تماه تصمیماتی که باعث شد آسیب ببینید. اگه دوست داری در موردش صحبت کنید، من سخت ها با بشم."
    },
    {
      "id": 3,
      "start": 6026.74,
      "end": 6034.46,
      "formatted_start": "01:40:26.740",
      "formatted_end": "01:40:34.460",
      "text": "3. تو فرزند خوب برای ما بزرگ کردن تو سخت برده بزنه"
    },
    {
      "id": 4,
      "start": 6034.46,
      "end": 6036.14,
      "formatted_start": "01:40:34.460",
      "formatted_end": "01:40:36.140",
      "text": "بقیه عرضشش داشته"
    },
    {
      "id": 5,
      "start": 6036.14,
      "end": 6040.5,
      "formatted_start": "01:40:36.140",
      "formatted_end": "01:40:40.500",
      "text": "4. من بیقی و شمسه دارم"
    },
    {
      "id": 6,
      "start": 6040.5,
      "end": 6041.26,
      "formatted_start": "01:40:40.500",
      "formatted_end": "01:40:41.260",
      "text": "مهم"
    },
    {
      "id": 7,
      "start": 6041.26,
      "end": 6049.9,
      "formatted_start": "01:40:41.260",
      "formatted_end": "01:40:49.900",
      "text": "خب این روزی دو بار این سه بار شیاخا نصف میذارید"
    },
    {
      "id": 8,
      "start": 6049.9,
      "end": 6052.82,
      "formatted_start": "01:40:49.900",
      "formatted_end": "01:40:52.820",
      "text": "از تو میتونه شما که دوباره بردش 25 پر"
    },
    {
      "id": 9,
      "start": 6052.82,
      "end": 6054.52,
      "formatted_start": "01:40:52.820",
      "formatted_end": "01:40:54.520",
      "text": "هم شیاخا در همه سامنی کن بده"
    },
    {
      "id": 10,
      "start": 6054.52,
      "end": 6059.48,
      "formatted_start": "01:40:54.520",
      "formatted_end": "01:40:59.480",
      "text": "اول اصامه نفون بده هر 6 ساعت اگر همش کنترل شد شیاق ندارد"
    },
    {
      "id": 11,
      "start": 6059.48,
      "end": 6063.16,
      "formatted_start": "01:40:59.480",
      "formatted_end": "01:41:03.160",
      "text": "اگر اصامه نفون کنترل نشد هم اصامه نفون هم شیاق ندارد"
    },
    {
      "id": 12,
      "start": 6063.16,
      "end": 6066.76,
      "formatted_start": "01:41:03.160",
      "formatted_end": "01:41:06.760",
      "text": "اول چی گردم اصامه نفون سطح چهار دادم به چند رو کاری نیمان بودین شما"
    },
    {
      "id": 13,
      "start": 6066.76,
      "end": 6067.56,
      "formatted_start": "01:41:06.760",
      "formatted_end": "01:41:07.560",
      "text": "بله شیاق ندارد"
    },
    {
      "id": 14,
      "start": 6067.56,
      "end": 6069.24,
      "formatted_start": "01:41:07.560",
      "formatted_end": "01:41:09.240",
      "text": "اول شیاق بذارم هر یه نسکه"
    },
    {
      "id": 15,
      "start": 6069.24,
      "end": 6071.48,
      "formatted_start": "01:41:09.240",
      "formatted_end": "01:41:11.480",
      "text": "اصامه نفون هم نشد هم اصامه نفون هم شیاق ندارد"
    },
    {
      "id": 16,
      "start": 6071.48,
      "end": 6072.12,
      "formatted_start": "01:41:11.480",
      "formatted_end": "01:41:12.120",
      "text": "بله بله"
    },
    {
      "id": 17,
      "start": 6072.12,
      "end": 6079.12,
      "formatted_start": "01:41:12.120",
      "formatted_end": "01:41:19.120",
      "text": "اولیه که شما میدین اگر اسلام نفون جواب نداد غیر از اسلام نفون که میدین شیاب هست"
    },
    {
      "id": 18,
      "start": 6079.12,
      "end": 6081.12,
      "formatted_start": "01:41:19.120",
      "formatted_end": "01:41:21.120",
      "text": "هشت ساعت دیگه هست"
    },
    {
      "id": 19,
      "start": 6081.12,
      "end": 6083.12,
      "formatted_start": "01:41:21.120",
      "formatted_end": "01:41:23.120",
      "text": "هشت ساعت شیاب هست"
    },
    {
      "id": 20,
      "start": 6083.12,
      "end": 6085.12,
      "formatted_start": "01:41:23.120",
      "formatted_end": "01:41:25.120",
      "text": "اسلام نفون شیست ساعت دیگه"
    },
    {
      "id": 21,
      "start": 6085.12,
      "end": 6087.12,
      "formatted_start": "01:41:25.120",
      "formatted_end": "01:41:27.120",
      "text": "با عملی یعنی هم هشت ساعت بزنم بزنیم"
    },
    {
      "id": 22,
      "start": 6087.12,
      "end": 6089.12,
      "formatted_start": "01:41:27.120",
      "formatted_end": "01:41:29.120",
      "text": "ببین خوامداری من رو کچیز میدونم"
    },
    {
      "id": 23,
      "start": 6089.12,
      "end": 6091.12,
      "formatted_start": "01:41:29.120",
      "formatted_end": "01:41:31.120",
      "text": "ببین اسلام نفون شیست ساعت دیگه"
    },
    {
      "id": 24,
      "start": 6091.12,
      "end": 6093.12,
      "formatted_start": "01:41:31.120",
      "formatted_end": "01:41:33.120",
      "text": "اون شیاب هشت ساعت دیگه"
    },
    {
      "id": 25,
      "start": 6093.12,
      "end": 6095.12,
      "formatted_start": "01:41:33.120",
      "formatted_end": "01:41:35.120",
      "text": "فاصله دو ساعت فهم دارن"
    },
    {
      "id": 26,
      "start": 6095.12,
      "end": 6099.12,
      "formatted_start": "01:41:35.120",
      "formatted_end": "01:41:39.120",
      "text": "یعنی شما استرال میل فون تا دو سال دیگه تبشکن نشد شیاق"
    },
    {
      "id": 27,
      "start": 6099.12,
      "end": 6100.12,
      "formatted_start": "01:41:39.120",
      "formatted_end": "01:41:40.120",
      "text": "آهان، چون ست ست"
    },
    {
      "id": 28,
      "start": 6100.12,
      "end": 6104.12,
      "formatted_start": "01:41:40.120",
      "formatted_end": "01:41:44.120",
      "text": "اون استرال میل فون روزی چهار بار میدی، شیاق میشه روزی سه بار"
    },
    {
      "id": 29,
      "start": 6104.12,
      "end": 6109.12,
      "formatted_start": "01:41:44.120",
      "formatted_end": "01:41:49.120",
      "text": "مثلا شیست ست، روزی شیست، چهار ست، روزی چهار ست، سه هشت ست، روزی بیسته چهار ست"
    },
    {
      "id": 30,
      "start": 6109.12,
      "end": 6112.12,
      "formatted_start": "01:41:49.120",
      "formatted_end": "01:41:52.120",
      "text": "استرال میل فون باید پیشتر است شیاق"
    },
    {
      "id": 31,
      "start": 6112.12,
      "end": 6114.12,
      "formatted_start": "01:41:52.120",
      "formatted_end": "01:41:54.120",
      "text": "خدافت مدد"
    },
    {
      "id": 32,
      "start": 6114.12,
      "end": 6117.82,
      "formatted_start": "01:41:54.120",
      "formatted_end": "01:41:57.820",
      "text": "شمت و درمایه سبک زندگی که خودم میبسط بودی"
    },
    {
      "id": 33,
      "start": 6117.82,
      "end": 6119.78,
      "formatted_start": "01:41:57.820",
      "formatted_end": "01:41:59.780",
      "text": "در وقت ما نیاز داشتی"
    },
    {
      "id": 34,
      "start": 6119.78,
      "end": 6121.18,
      "formatted_start": "01:41:59.780",
      "formatted_end": "01:42:01.180",
      "text": "ما که نمیتونیم"
    },
    {
      "id": 35,
      "start": 6121.18,
      "end": 6123.08,
      "formatted_start": "01:42:01.180",
      "formatted_end": "01:42:03.080",
      "text": "نرسید روشنگی"
    },
    {
      "id": 36,
      "start": 6123.08,
      "end": 6125.94,
      "formatted_start": "01:42:03.080",
      "formatted_end": "01:42:05.940",
      "text": "از درمتی تومنی زندگی بودم"
    },
    {
      "id": 37,
      "start": 6125.94,
      "end": 6127.54,
      "formatted_start": "01:42:05.940",
      "formatted_end": "01:42:07.540",
      "text": "این دروه شکل داشت"
    },
    {
      "id": 38,
      "start": 6127.54,
      "end": 6129.0,
      "formatted_start": "01:42:07.540",
      "formatted_end": "01:42:09.000",
      "text": "چیشی"
    },
    {
      "id": 39,
      "start": 6129.0,
      "end": 6133.22,
      "formatted_start": "01:42:09.000",
      "formatted_end": "01:42:13.220",
      "text": "با من در مورد رویه ها و آردو ها نرمی بزن"
    },
    {
      "id": 40,
      "start": 6133.22,
      "end": 6135.88,
      "formatted_start": "01:42:13.220",
      "formatted_end": "01:42:15.880",
      "text": "درست دارم بدونم چی ها تو زندگی"
    },
    {
      "id": 41,
      "start": 6135.88,
      "end": 6137.66,
      "formatted_start": "01:42:15.880",
      "formatted_end": "01:42:17.660",
      "text": "برای تو خیلی محلی شد"
    },
    {
      "id": 42,
      "start": 6137.66,
      "end": 6138.8,
      "formatted_start": "01:42:17.660",
      "formatted_end": "01:42:18.800",
      "text": "نفت"
    },
    {
      "id": 43,
      "start": 6138.8,
      "end": 6141.38,
      "formatted_start": "01:42:18.800",
      "formatted_end": "01:42:21.380",
      "text": "من بهت اعتماد دارم"
    },
    {
      "id": 44,
      "start": 6141.38,
      "end": 6142.5,
      "formatted_start": "01:42:21.380",
      "formatted_end": "01:42:22.500",
      "text": "و میبینم که"
    },
    {
      "id": 45,
      "start": 6142.5,
      "end": 6167.5,
      "formatted_start": "01:42:22.500",
      "formatted_end": "01:42:47.500",
      "text": "موسیقی"
    },
    {
      "id": 46,
      "start": 6172.5,
      "end": 6175.94,
      "formatted_start": "01:42:52.500",
      "formatted_end": "01:42:55.940",
      "text": "این ها ممنون باسه تایه زنگون رو سر میگن داره"
    },
    {
      "id": 47,
      "start": 6175.94,
      "end": 6178.38,
      "formatted_start": "01:42:55.940",
      "formatted_end": "01:42:58.380",
      "text": "تایه چان با ریز تاراوان"
    },
    {
      "id": 48,
      "start": 6178.38,
      "end": 6181.74,
      "formatted_start": "01:42:58.380",
      "formatted_end": "01:43:01.740",
      "text": "دوره دام مرسی کمچه راجب ترفتار پهلقی میگن"
    },
    {
      "id": 49,
      "start": 6181.74,
      "end": 6185.1,
      "formatted_start": "01:43:01.740",
      "formatted_end": "01:43:05.100",
      "text": "اونه که پندگاری خدا بی سفادر وحل مطالعه نیستن"
    },
    {
      "id": 50,
      "start": 6185.1,
      "end": 6190.02,
      "formatted_start": "01:43:05.100",
      "formatted_end": "01:43:10.020",
      "text": "چرا؟ چون اگه حرف مطالعه بودن که دیگه ترفتار پهلقی باقی بودن"
    },
    {
      "id": 51,
      "start": 6190.02,
      "end": 6194.26,
      "formatted_start": "01:43:10.020",
      "formatted_end": "01:43:14.260",
      "text": "کاری با هیچ چیز اینگی بناتون که ای آیه هست هر چیز دیگه"
    },
    {
      "id": 52,
      "start": 6194.26,
      "end": 6196.62,
      "formatted_start": "01:43:14.260",
      "formatted_end": "01:43:16.620",
      "text": "من رفتم از چند چیمیتی برسیدم"
    },
    {
      "id": 53,
      "start": 6196.62,
      "end": 6200.06,
      "formatted_start": "01:43:16.620",
      "formatted_end": "01:43:20.060",
      "text": "برای برسی که ساخته از چند شیرگیتی پرسی برم"
    },
    {
      "id": 54,
      "start": 6200.06,
      "end": 6202.62,
      "formatted_start": "01:43:20.060",
      "formatted_end": "01:43:22.620",
      "text": "من یک جمعه میدارم و یک جمعه میزنم باید"
    },
    {
      "id": 55,
      "start": 6202.62,
      "end": 6204.62,
      "formatted_start": "01:43:22.620",
      "formatted_end": "01:43:24.620",
      "text": "شما بید برسید"
    },
    {
      "id": 56,
      "start": 6204.62,
      "end": 6206.62,
      "formatted_start": "01:43:24.620",
      "formatted_end": "01:43:26.620",
      "text": "به جمعه میرسید"
    },
    {
      "id": 57,
      "start": 6206.62,
      "end": 6208.62,
      "formatted_start": "01:43:26.620",
      "formatted_end": "01:43:28.620",
      "text": "البته شما برای جمعه نیستید"
    },
    {
      "id": 58,
      "start": 6208.62,
      "end": 6210.62,
      "formatted_start": "01:43:28.620",
      "formatted_end": "01:43:30.620",
      "text": "ولی خوب بالا وضعی دارید برنگ شده"
    },
    {
      "id": 59,
      "start": 6226.62,
      "end": 6254.62,
      "formatted_start": "01:43:46.620",
      "formatted_end": "01:44:14.620",
      "text": "موسیقی"
    },
    {
      "id": 60,
      "start": 6254.62,
      "end": 6264.62,
      "formatted_start": "01:44:14.620",
      "formatted_end": "01:44:24.620",
      "text": "موسیقی در موسیقی دیگر"
    },
    {
      "id": 61,
      "start": 6284.62,
      "end": 6299.98,
      "formatted_start": "01:44:44.620",
      "formatted_end": "01:44:59.980",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}