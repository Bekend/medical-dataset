    },
    {
      "id": 17,
      "start": 8478.0,
      "end": 8480.0,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:20.000",
      "text": "این کار رو باید برداریم"
    },
    {
      "id": 18,
      "start": 8480.0,
      "end": 8482.0,
      "formatted_start": "02:21:20.000",
      "formatted_end": "02:21:22.000",
      "text": "این کار رو باید برداریم"
    },
    {
      "id": 19,
      "start": 8482.0,
      "end": 8484.5,
      "formatted_start": "02:21:22.000",
      "formatted_end": "02:21:24.500",
      "text": "بلکه باید حوضش به چی باشه؟"
    },
    {
      "id": 20,
      "start": 8484.5,
      "end": 8487.06,
      "formatted_start": "02:21:24.500",
      "formatted_end": "02:21:27.060",
      "text": "باید حوضش به کنگ روسی و اوکرایی باشه"
    },
    {
      "id": 21,
      "start": 8487.06,
      "end": 8489.74,
      "formatted_start": "02:21:27.060",
      "formatted_end": "02:21:29.740",
      "text": "باید به خودش بگویی که چه حدستی تصمیمات کنن"
    },
    {
      "id": 22,
      "start": 8489.74,
      "end": 8491.6,
      "formatted_start": "02:21:29.740",
      "formatted_end": "02:21:31.600",
      "text": "چون بخواد این را به کار بگیرن"
    },
    {
      "id": 23,
      "start": 8491.6,
      "end": 8495.02,
      "formatted_start": "02:21:31.600",
      "formatted_end": "02:21:35.020",
      "text": "که موقع تبادلت با چین و روسیه"
    },
    {
      "id": 24,
      "start": 8495.02,
      "end": 8497.12,
      "formatted_start": "02:21:35.020",
      "formatted_end": "02:21:37.120",
      "text": "نمیدونه کنید کنید کنن"
    },
    {
      "id": 25,
      "start": 8497.12,
      "end": 8499.6,
      "formatted_start": "02:21:37.120",
      "formatted_end": "02:21:39.600",
      "text": "چون که شاید باید حدودتر از این را از دست هاست"
    },
    {
      "id": 26,
      "start": 8499.6,
      "end": 8502.92,
      "formatted_start": "02:21:39.600",
      "formatted_end": "02:21:42.920",
      "text": "این در شرایطی که بزارش هایی متشکرد شده"
    },
    {
      "id": 27,
      "start": 8502.92,
      "end": 8506.2,
      "formatted_start": "02:21:42.920",
      "formatted_end": "02:21:46.200",
      "text": "از اینکه آمریکا با مشکل تمنی تسلیماتش هم رو بروز"
    },
    {
      "id": 28,
      "start": 8506.2,
      "end": 8509.82,
      "formatted_start": "02:21:46.200",
      "formatted_end": "02:21:49.820",
      "text": "فکر کنید آیا کار اینجا بکشه که آمریکا ناچار بشه"
    },
    {
      "id": 29,
      "start": 8509.82,
      "end": 8512.92,
      "formatted_start": "02:21:49.820",
      "formatted_end": "02:21:52.920",
      "text": "دست بیتر حالات بسترده تر و از جمعه همه زمینی بتره؟"
    },
    {
      "id": 30,
      "start": 8512.92,
      "end": 8516.36,
      "formatted_start": "02:21:52.920",
      "formatted_end": "02:21:56.360",
      "text": "فکر کنم بهی جمعه چنین گذینه این که اولی از شهر آمریکا"
    },
    {
      "id": 31,
      "start": 8516.36,
      "end": 8520.28,
      "formatted_start": "02:21:56.360",
      "formatted_end": "02:22:00.280",
      "text": "گذینه محبوبیه ولی مردم آمریکا، حکومت ایران از همه افتدایی جنگ"
    },
    {
      "id": 32,
      "start": 8520.28,
      "end": 8524.2,
      "formatted_start": "02:22:00.280",
      "formatted_end": "02:22:04.200",
      "text": "این را نشون داده که جنگ علاقه برن وزه نظامی"
    },
    {
      "id": 33,
      "start": 8524.2,
      "end": 8533.7,
      "formatted_start": "02:22:04.200",
      "formatted_end": "02:22:13.700",
      "text": "این یک حوضه اطلاعاتی داره و ایران به خوبی واقعی است که مردم آمریکا نقش تنگ کننده در خصوص این جنگ دارن"
    },
    {
      "id": 34,
      "start": 8533.7,
      "end": 8535.96,
      "formatted_start": "02:22:13.700",
      "formatted_end": "02:22:15.960",
      "text": "چه حس افتاده این جنگ دارن تنگ کننده هست"
    },
    {
      "id": 35,
      "start": 8535.96,
      "end": 8541.12,
      "formatted_start": "02:22:15.960",
      "formatted_end": "02:22:21.120",
      "text": "کاری که حکومت ایران میتونه به خواهد کنه این است که این جنگ رو برای آمانها و خواهدت میانداره ادامه بده"
    },
    {
      "id": 36,
      "start": 8541.12,
      "end": 8545.26,
      "formatted_start": "02:22:21.120",
      "formatted_end": "02:22:25.260",
      "text": "و مرتب مذاکرات رو برای قراره بکنه که کشف ادامه کنه قضیه"
    },
    {
      "id": 37,
      "start": 8545.26,
      "end": 8548.72,
      "formatted_start": "02:22:25.260",
      "formatted_end": "02:22:28.720",
      "text": "چون اونا میدونند که مردم آمریکا از ادامه جنگ راضی نیستند"
    },
    {
      "id": 38,
      "start": 8548.72,
      "end": 8552.46,
      "formatted_start": "02:22:28.720",
      "formatted_end": "02:22:32.460",
      "text": "و اگر نیروهای آمریکایی با درمثل شهر نظر موضوع آمریکایی"
    },
    {
      "id": 39,
      "start": 8552.46,
      "end": 8555.22,
      "formatted_start": "02:22:32.460",
      "formatted_end": "02:22:35.220",
      "text": "تقاییباً کشته جنگ خود مقابلت مردم آمریکا"
    },
    {
      "id": 40,
      "start": 8555.22,
      "end": 8558.66,
      "formatted_start": "02:22:35.220",
      "formatted_end": "02:22:38.660",
      "text": "میدونه سیفرد خودشیده هرگز فرزند خودش رو دوست نداره"
    },
    {
      "id": 41,
      "start": 8558.66,
      "end": 8562.4,
      "formatted_start": "02:22:38.660",
      "formatted_end": "02:22:42.400",
      "text": "هنیشه فرزندش یکی وسیله است در بازی های روانیش"
    },
    {
      "id": 42,
      "start": 8562.4,
      "end": 8564.1,
      "formatted_start": "02:22:42.400",
      "formatted_end": "02:22:44.100",
      "text": "و هنیشه با..."
    },
    {
      "id": 43,
      "start": 8564.1,
      "end": 8567.16,
      "formatted_start": "02:22:44.100",
      "formatted_end": "02:22:47.160",
      "text": "متاسفاله بسیاری از اینم متوجه این نیست که"
    },
    {
      "id": 44,
      "start": 8567.16,
      "end": 8570.54,
      "formatted_start": "02:22:47.160",
      "formatted_end": "02:22:50.540",
      "text": "که تا چه اندازه همسرشون رو به سرحد جنون میرسونن"
    },
    {
      "id": 45,
      "start": 8570.54,
      "end": 8571.9,
      "formatted_start": "02:22:50.540",
      "formatted_end": "02:22:51.900",
      "text": "یه شده دلیلتون بگم"
    },
    {
      "id": 46,
      "start": 8571.9,
      "end": 8573.18,
      "formatted_start": "02:22:51.900",
      "formatted_end": "02:22:53.180",
      "text": "اون باشین ها رو میبینید"
    },
    {
      "id": 47,
      "start": 8573.18,
      "end": 8574.3,
      "formatted_start": "02:22:53.180",
      "formatted_end": "02:22:54.300",
      "text": "این رو ببینید دیگه هایی"
    },
    {
      "id": 48,
      "start": 8574.3,
      "end": 8582.16,
      "formatted_start": "02:22:54.300",
      "formatted_end": "02:23:02.160",
      "text": "این زن برمشه دازه ایستده"
    },
    {
      "id": 49,
      "start": 8582.16,
      "end": 8583.5,
      "formatted_start": "02:23:02.160",
      "formatted_end": "02:23:03.500",
      "text": "برمشه"
    },
    {
      "id": 50,
      "start": 8583.5,
      "end": 8588.04,
      "formatted_start": "02:23:03.500",
      "formatted_end": "02:23:08.040",
      "text": "برمشه باید بسیار کم رو برم"
    },
    {
      "id": 51,
      "start": 8588.04,
      "end": 8589.76,
      "formatted_start": "02:23:08.040",
      "formatted_end": "02:23:09.760",
      "text": "با وانزه درک دهید"
    },
    {
      "id": 52,
      "start": 8589.76,
      "end": 8590.6,
      "formatted_start": "02:23:09.760",
      "formatted_end": "02:23:10.600",
      "text": "برمشه"
    },
    {
      "id": 53,
      "start": 8590.6,
      "end": 8592.48,
      "formatted_start": "02:23:10.600",
      "formatted_end": "02:23:12.480",
      "text": "از همه خوردید"
    },
    {
      "id": 54,
      "start": 8592.48,
      "end": 8594.3,
      "formatted_start": "02:23:12.480",
      "formatted_end": "02:23:14.300",
      "text": "برمشه"
    },
    {
      "id": 55,
      "start": 8594.3,
      "end": 8606.3,
      "formatted_start": "02:23:14.300",
      "formatted_end": "02:23:26.300",
      "text": "موسیقی"
    },
    {
      "id": 56,
      "start": 8624.3,
      "end": 8626.3,
      "formatted_start": "02:23:44.300",
      "formatted_end": "02:23:46.300",
      "text": "برای روزهایی که نمیشه هم به کسی برامو برده"
    },
    {
      "id": 57,
      "start": 8654.3,
      "end": 8672.3,
      "formatted_start": "02:24:14.300",
      "formatted_end": "02:24:32.300",
      "text": "ارتشانی کمک را درمی دارند و از اون روز زمان درگیر از کلیفراد را محتاله برنامه ارتشاشون را ترکیه درم از لیوی یا رسه درگیر تا سیدان تا سوریه و اران و بعد که میگن دوروبرده وردار اسرائیل بیده کنند نیوهای ترکیه یا نیوهایی از طرف ترکیه حایت شد"
    },
    {
      "id": 58,
      "start": 8672.3,
      "end": 8686.3,
      "formatted_start": "02:24:32.300",
      "formatted_end": "02:24:46.300",
      "text": "و از اون پاکستان تا همین شهر احام گرامی شدن و از پاکستان با پالگان نگیه با هلو نگیه جهان و جنگ با هم رفتن از آنجای جهانی رو با جهان و پاکستان های آنجایی تا رسمی دیویان رو درد"
    },
    {
      "id": 59,
      "start": 8686.3,
      "end": 8694.3,
      "formatted_start": "02:24:46.300",
      "formatted_end": "02:24:54.300",
      "text": "و الان این مدد این تو تا گشتن که اسم رو روی افتشار سانسانی در این حالات رو بمکرد"
    },
    {
      "id": 60,
      "start": 8694.3,
      "end": 8699.3,
      "formatted_start": "02:24:54.300",
      "formatted_end": "02:24:59.300",
      "text": "داستانی افتیبالوگرد اگر این به هم دوباره محامل رشده تا همه هم رشده"
    },
    {
      "id": 61,
      "start": 8699.3,
      "end": 8701.3,
      "formatted_start": "02:24:59.300",
      "formatted_end": "02:25:01.300",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}