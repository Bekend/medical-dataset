  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8411.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:11.000",
      "text": "اینجوری هایی تایید جونه به توافق برسه. بنایی که مطالبات ایران با آت ایران داره بیشتر میشه ولی آمریکا اولا کمتر و کمترش میتونه اینجوری دیگه رو برورده بود."
    },
    {
      "id": 1,
      "start": 8411.0,
      "end": 8412.0,
      "formatted_start": "02:20:11.000",
      "formatted_end": "02:20:12.000",
      "text": "چندی آنکه هایی دیگه کنند؟"
    },
    {
      "id": 2,
      "start": 8412.0,
      "end": 8434.0,
      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:34.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 8434.0,
      "end": 8445.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:45.000",
      "text": "ببینید این شربت هاش خیلی از کتو تیفن روزی دو بار بقیه روزی سه بار کاشاهای غذا خوریدید"
    },
    {
      "id": 4,
      "start": 8445.0,
      "end": 8448.0,
      "formatted_start": "02:20:45.000",
      "formatted_end": "02:20:48.000",
      "text": "سرون و آمکول هم که خوردون خواستید بودید"
    },
    {
      "id": 5,
      "start": 8448.0,
      "end": 8456.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:56.000",
      "text": "کتو تیفن بقیه روزی سه باره"
    },
    {
      "id": 6,
      "start": 8456.0,
      "end": 8458.0,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:20:58.000",
      "text": "کتو تیفن روزی دو باره"
    },
    {
      "id": 7,
      "start": 8458.0,
      "end": 8460.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:00.000",
      "text": "این کار رو باید برداریم"
    },
    {
      "id": 8,
      "start": 8460.0,
      "end": 8462.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:02.000",
      "text": "این کار رو باید برداریم"
    },
    {
      "id": 9,
      "start": 8462.0,
      "end": 8464.0,
      "formatted_start": "02:21:02.000",
      "formatted_end": "02:21:04.000",
      "text": "این کار رو باید برداریم"
    },
