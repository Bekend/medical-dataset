  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8705.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:05.000",
      "text": "اینکه اینکه پاکستان برابر شد، پاکستان رو در آنگار نکش شد، اونکه همونطور که باید جنگش باشد."
    },
    {
      "id": 1,
      "start": 8705.0,
      "end": 8713.0,
      "formatted_start": "02:25:05.000",
      "formatted_end": "02:25:13.000",
      "text": "یا مثلا این پاکستان دوباره یک جنگی گیری با هند جنگه، ترکیه میاد با هند که اونها در ترکونی کار سرشاشه."
    },
    {
      "id": 2,
      "start": 8713.0,
      "end": 8721.0,
      "formatted_start": "02:25:13.000",
      "formatted_end": "02:25:21.000",
      "text": "حتی این رو بگیر. همون راستانی که در اون دورت درده اینکه پاکستان سعودی منتقل خاصشان رو باشنگ داشت."
    },
    {
      "id": 3,
      "start": 8721.0,
      "end": 8751.0,
      "formatted_start": "02:25:21.000",
      "formatted_end": "02:25:51.000",
      "text": "این رو همه خود از ایستانی ها و از شیران نکنه، همه خود از ایستانی ها، این رو می‌فرمایید به عرصت‌ها که می‌توانده بگو، منی‌تونیم سیاسا در عرصت‌ها بودم، در ایستانی‌ها در خودشان خواهد به شیرانی کشن رو کمک کنه، این جمله‌ای که به هر طور از ما هم بگو شکست‌ها، همه‌ها هم کار می‌کنه، مثلا چی فرداشت‌ها هستن که بوسیلو توجیه‌ها می‌کنه، عرصت‌ها می‌د"
    },
    {
      "id": 4,
      "start": 8751.0,
      "end": 8757.0,
      "formatted_start": "02:25:51.000",
      "formatted_end": "02:25:57.000",
      "text": "بخواهد یکی یا آشنا شما شکل بار بارون یه سریعت پون پا وستگی های جوه نفتاش تحلیل کرد"
    },
    {
      "id": 5,
      "start": 8757.0,
      "end": 8761.0,
      "formatted_start": "02:25:57.000",
      "formatted_end": "02:26:01.000",
      "text": "کف قایین یاد یه موردی می برم توش تونی کنند یه نفتش رو برسنردین شده دارم"
    },
    {
      "id": 6,
      "start": 8761.0,
      "end": 8763.0,
      "formatted_start": "02:26:01.000",
      "formatted_end": "02:26:03.000",
      "text": "آنها در استاد نظرمون تونی نفت"
    },
    {
      "id": 7,
      "start": 8763.0,
      "end": 8765.0,
      "formatted_start": "02:26:03.000",
      "formatted_end": "02:26:05.000",
      "text": "اما تونی نفت یا نفت میکرد خیلی پیشتر در استاد صحبتیه"
    },
    {
      "id": 8,
      "start": 8765.0,
      "end": 8767.0,
      "formatted_start": "02:26:05.000",
      "formatted_end": "02:26:07.000",
      "text": "زمان که بزرگ ما"
    },
    {
      "id": 9,
      "start": 8767.0,
      "end": 8769.0,
      "formatted_start": "02:26:07.000",
      "formatted_end": "02:26:09.000",
      "text": "کار ما یعنی بنده می بخشه خدا نیم"
    },
    {
      "id": 10,
      "start": 8769.0,
      "end": 8772.24,
      "formatted_start": "02:26:09.000",
      "formatted_end": "02:26:12.240",
      "text": "مارونی از قناه با مارون 18 جهه 65"
    },
    {
      "id": 11,
      "start": 8772.24,
      "end": 8775.12,
      "formatted_start": "02:26:12.240",
      "formatted_end": "02:26:15.120",
      "text": "یکی توی 18 سالگی خیلی آرومان داری"
    },
    {
      "id": 12,
      "start": 8775.12,
      "end": 8776.52,
      "formatted_start": "02:26:15.120",
      "formatted_end": "02:26:16.520",
      "text": "مردم در مورد چهاری"
    },
    {
      "id": 13,
      "start": 8776.52,
      "end": 8780.14,
      "formatted_start": "02:26:16.520",
      "formatted_end": "02:26:20.140",
      "text": "مردم در مورد چهاری دیگه آرومانیست"
    },
    {
      "id": 14,
      "start": 8780.14,
      "end": 8782.02,
      "formatted_start": "02:26:20.140",
      "formatted_end": "02:26:22.020",
      "text": "مردم در مورد چهاری"
    },
    {
      "id": 15,
      "start": 8782.02,
      "end": 8784.48,
      "formatted_start": "02:26:22.020",
      "formatted_end": "02:26:24.480",
      "text": "مردم در 65 سالگی فقیدی"
    },
    {
      "id": 16,
      "start": 8784.48,
      "end": 8787.18,
      "formatted_start": "02:26:24.480",
      "formatted_end": "02:26:27.180",
      "text": "مردم اصلایی چهاری تو فکر نکردی"
    },
    {
      "id": 17,
      "start": 8787.18,
      "end": 8788.92,
      "formatted_start": "02:26:27.180",
      "formatted_end": "02:26:28.920",
      "text": "خیلی سآل کردید"
    },
    {
      "id": 18,
      "start": 8788.92,
      "end": 8790.18,
      "formatted_start": "02:26:28.920",
      "formatted_end": "02:26:30.180",
      "text": "همین برسه دید"
    },
    {
      "id": 19,
      "start": 8790.18,
      "end": 8796.56,
      "formatted_start": "02:26:30.180",
      "formatted_end": "02:26:36.560",
      "text": "که با امسانهای خودشیفه چنانید"
    },
    {
      "id": 20,
      "start": 8796.56,
      "end": 8806.56,
      "formatted_start": "02:26:36.560",
      "formatted_end": "02:26:46.560",
      "text": "خودشیزها میتونن هم سر با باشه، با درمون باشه، با درمون باشه، با افراد خانمی باشه، هم با درمون باشه"
    },
    {
      "id": 21,
      "start": 8806.56,
      "end": 8816.56,
      "formatted_start": "02:26:46.560",
      "formatted_end": "02:26:56.560",
      "text": "بزرگترین راه مبارزه و مقابله با رسیانهای خودشیز هر چپر که به ما نزدیک باشن، حتی اگه مقابله با بیمان دارن"
    },
    {
      "id": 22,
      "start": 8816.56,
      "end": 8821.56,
      "formatted_start": "02:26:56.560",
      "formatted_end": "02:27:01.560",
      "text": "بی اعتراحی به پاس"
    },
    {
      "id": 23,
      "start": 8821.56,
      "end": 8824.56,
      "formatted_start": "02:27:01.560",
      "formatted_end": "02:27:04.560",
      "text": "کم توجهی به رفتارهایی و چیزها هست"
    },
    {
      "id": 24,
      "start": 8824.56,
      "end": 8826.56,
      "formatted_start": "02:27:04.560",
      "formatted_end": "02:27:06.560",
      "text": "و چیفت ها همیشه دوست دارن"
    },
    {
      "id": 25,
      "start": 8826.56,
      "end": 8828.56,
      "formatted_start": "02:27:06.560",
      "formatted_end": "02:27:08.560",
      "text": "کردیت بگیرن، اعتبار بگیرن"
    },
    {
      "id": 26,
      "start": 8828.56,
      "end": 8830.56,
      "formatted_start": "02:27:08.560",
      "formatted_end": "02:27:10.560",
      "text": "اگر کمکی میکنن از قلبشون نیست"
    },
    {
      "id": 27,
      "start": 8830.56,
      "end": 8833.56,
      "formatted_start": "02:27:10.560",
      "formatted_end": "02:27:13.560",
      "text": "اگر کمکی میکنن از رود بزرگشون نیست"
    },
    {
      "id": 28,
      "start": 8833.56,
      "end": 8835.56,
      "formatted_start": "02:27:13.560",
      "formatted_end": "02:27:15.560",
      "text": "برای اینکه نشون بدم که لک"
    },
    {
      "id": 29,
      "start": 8835.56,
      "end": 8837.56,
      "formatted_start": "02:27:15.560",
      "formatted_end": "02:27:17.560",
      "text": "من ببین، من جا هستم"
    },
    {
      "id": 30,
      "start": 8837.56,
      "end": 8838.56,
      "formatted_start": "02:27:17.560",
      "formatted_end": "02:27:18.560",
      "text": "به تو کمک میکنم"
    },
    {
      "id": 31,
      "start": 8838.56,
      "end": 8840.56,
      "formatted_start": "02:27:18.560",
      "formatted_end": "02:27:20.560",
      "text": "پس من اعتبارها رو بگم"
    },
    {
      "id": 32,
      "start": 8840.56,
      "end": 8841.56,
      "formatted_start": "02:27:20.560",
      "formatted_end": "02:27:21.560",
      "text": "به من اعتراح ها میذارم"
    },
    {
      "id": 33,
      "start": 8841.56,
      "end": 8843.56,
      "formatted_start": "02:27:21.560",
      "formatted_end": "02:27:23.560",
      "text": "شما هیچون دونید که"
    },
    {
      "id": 34,
      "start": 8843.56,
      "end": 8845.56,
      "formatted_start": "02:27:23.560",
      "formatted_end": "02:27:25.560",
      "text": "اون چیفت ها بذارین"
    },
    {
      "id": 35,
      "start": 8845.56,
      "end": 8849.56,
      "formatted_start": "02:27:25.560",
      "formatted_end": "02:27:29.560",
      "text": "یک اشونه از بزرگ انسانهای هاچیفت ها بهتون بگم"
    },
    {
      "id": 36,
      "start": 8849.56,
      "end": 8851.56,
      "formatted_start": "02:27:29.560",
      "formatted_end": "02:27:31.560",
      "text": "بسیار دنبال احترام هست"
    },
    {
      "id": 37,
      "start": 8851.56,
      "end": 8854.56,
      "formatted_start": "02:27:31.560",
      "formatted_end": "02:27:34.560",
      "text": "همه شو میخوان بهشون احترام بسیار در حتی سروره"
    },
    {
      "id": 38,
      "start": 8854.56,
      "end": 8857.56,
      "formatted_start": "02:27:34.560",
      "formatted_end": "02:27:37.560",
      "text": "یعنی اصلا مسئله این نیست که دنبالشون بابی های دین"
    },
    {
      "id": 39,
      "start": 8857.56,
      "end": 8861.56,
      "formatted_start": "02:27:37.560",
      "formatted_end": "02:27:41.560",
      "text": "یا براشون کاری هست احترام نیست احترام دیش هست"
    },
    {
      "id": 40,
      "start": 8861.56,
      "end": 8865.56,
      "formatted_start": "02:27:41.560",
      "formatted_end": "02:27:45.560",
      "text": "یعنی میخوان شما بنده یا پا باشین بنده یا پا باشین"
    },
    {
      "id": 41,
      "start": 8865.56,
      "end": 8867.56,
      "formatted_start": "02:27:45.560",
      "formatted_end": "02:27:47.560",
      "text": "به هاچیفت ها حدود رو درد میدین"
    },
    {
      "id": 42,
      "start": 8867.56,
      "end": 8869.56,
      "formatted_start": "02:27:47.560",
      "formatted_end": "02:27:49.560",
      "text": "با یک چیز"
    },
    {
      "id": 43,
      "start": 8869.56,
      "end": 8871.56,
      "formatted_start": "02:27:49.560",
      "formatted_end": "02:27:51.560",
      "text": "نه بابی های تنهایی"
    },
    {
      "id": 44,
      "start": 8871.56,
      "end": 8883.56,
      "formatted_start": "02:27:51.560",
      "formatted_end": "02:28:03.560",
      "text": "موسیقی"
    },
    {
      "id": 45,
      "start": 8901.56,
      "end": 8921.56,
      "formatted_start": "02:28:21.560",
      "formatted_end": "02:28:41.560",
      "text": "موسیقی"
    },
    {
      "id": 46,
      "start": 8921.56,
      "end": 8923.04,
      "formatted_start": "02:28:41.560",
      "formatted_end": "02:28:43.040",
      "text": "ست دیست"
    },
    {
      "id": 47,
      "start": 8923.04,
      "end": 8951.04,
      "formatted_start": "02:28:43.040",
      "formatted_end": "02:29:11.040",
      "text": "موسیقی"
    },
    {
      "id": 48,
      "start": 8951.04,
      "end": 8957.04,
      "formatted_start": "02:29:11.040",
      "formatted_end": "02:29:17.040",
      "text": "خاموشی برای گفت تا دو هفته دیگه خیلی کم میشه"
    },
    {
      "id": 49,
      "start": 8957.04,
      "end": 8962.04,
      "formatted_start": "02:29:17.040",
      "formatted_end": "02:29:22.040",
      "text": "دیگه شغیبر میشه، تو خبرها اومده بود"
    },
    {
      "id": 50,
      "start": 8981.04,
      "end": 9000.04,
      "formatted_start": "02:29:41.040",
      "formatted_end": "02:30:00.040",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}