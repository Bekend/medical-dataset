  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7805.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:05.000",
      "text": "و چون پذیرش این فیضان رو خود سخبه، سمتون به هر طرف آدم رو جمع دارنگرده."
    },
    {
      "id": 1,
      "start": 7805.0,
      "end": 7809.0,
      "formatted_start": "02:10:05.000",
      "formatted_end": "02:10:09.000",
      "text": "بعد یک یک رایش در این حالت، خب باید رو سمیتون کنید."
    },
    {
      "id": 2,
      "start": 7809.0,
      "end": 7813.0,
      "formatted_start": "02:10:09.000",
      "formatted_end": "02:10:13.000",
      "text": "اما چرا این حالات توی مشتر را از باقی توقع کنه؟"
    },
    {
      "id": 3,
      "start": 7813.0,
      "end": 7815.0,
      "formatted_start": "02:10:13.000",
      "formatted_end": "02:10:15.000",
      "text": "اولین که در نیمه حکم سوچی نداره."
    },
    {
      "id": 4,
      "start": 7815.0,
      "end": 7817.0,
      "formatted_start": "02:10:15.000",
      "formatted_end": "02:10:17.000",
      "text": "اما از اینجور ندارد."
    },
    {
      "id": 5,
      "start": 7817.0,
      "end": 7819.0,
      "formatted_start": "02:10:17.000",
      "formatted_end": "02:10:19.000",
      "text": "تا مورد فرماکستی دوستی امیره تره احساسات،"
    },
    {
      "id": 6,
      "start": 7819.0,
      "end": 7821.0,
      "formatted_start": "02:10:19.000",
      "formatted_end": "02:10:21.000",
      "text": "صمیمیت، پشت و روادتی جلسه رو تجربه کرده"
    },
    {
      "id": 7,
      "start": 7821.0,
      "end": 7823.0,
      "formatted_start": "02:10:21.000",
      "formatted_end": "02:10:23.000",
      "text": "این رقم تا دوستی ممنونی افزاق کنید."
    },
    {
      "id": 8,
      "start": 7823.0,
      "end": 7825.0,
      "formatted_start": "02:10:23.000",
      "formatted_end": "02:10:25.000",
      "text": "آفزه ی آف فرماک دویمای ریستر ندارد."
    },
    {
      "id": 9,
      "start": 7825.0,
      "end": 7827.0,
      "formatted_start": "02:10:25.000",
      "formatted_end": "02:10:27.000",
      "text": "احساسات با اعتراف و خون روش نمیشن."
    },
    {
      "id": 10,
      "start": 7827.0,
      "end": 7829.0,
      "formatted_start": "02:10:27.000",
      "formatted_end": "02:10:29.000",
      "text": "دوست مونند"
    },
    {
      "id": 11,
      "start": 7829.0,
      "end": 7831.0,
      "formatted_start": "02:10:29.000",
      "formatted_end": "02:10:31.000",
      "text": "دوست مونند"
    },
    {
      "id": 12,
      "start": 7831.0,
      "end": 7833.0,
      "formatted_start": "02:10:31.000",
      "formatted_end": "02:10:33.000",
      "text": "دوست مونند"
    },
    {
      "id": 13,
      "start": 7833.0,
      "end": 7835.0,
      "formatted_start": "02:10:33.000",
      "formatted_end": "02:10:35.000",
      "text": "دوست مونند"
    },
    {
      "id": 14,
      "start": 7835.0,
      "end": 7837.0,
      "formatted_start": "02:10:35.000",
      "formatted_end": "02:10:37.000",
      "text": "دوست مونند"
    },
    {
      "id": 15,
      "start": 7837.0,
      "end": 7839.0,
      "formatted_start": "02:10:37.000",
      "formatted_end": "02:10:39.000",
      "text": "دوست مونند"
    },
    {
      "id": 16,
      "start": 7839.0,
      "end": 7841.0,
      "formatted_start": "02:10:39.000",
      "formatted_end": "02:10:41.000",
      "text": "دوست مونند"
    },
    {
      "id": 17,
      "start": 7841.0,
      "end": 7843.0,
      "formatted_start": "02:10:41.000",
      "formatted_end": "02:10:43.000",
      "text": "دوست مونند"
    },
    {
      "id": 18,
      "start": 7843.0,
      "end": 7845.0,
      "formatted_start": "02:10:43.000",
      "formatted_end": "02:10:45.000",
      "text": "ایشان یه روز داره به روز بعد گرده"
    },
    {
      "id": 19,
      "start": 7845.0,
      "end": 7847.0,
      "formatted_start": "02:10:45.000",
      "formatted_end": "02:10:47.000",
      "text": "نقشه چین چه؟"
    },
    {
      "id": 20,
      "start": 7847.0,
      "end": 7850.0,
      "formatted_start": "02:10:47.000",
      "formatted_end": "02:10:50.000",
      "text": "یکی از راوند خارج شده، یکی دیگه هنوز محتر بره"
    },
    {
      "id": 21,
      "start": 7850.0,
      "end": 7853.0,
      "formatted_start": "02:10:50.000",
      "formatted_end": "02:10:53.000",
      "text": "و همه وقت این تقالیل، علاقه این میرد"
    },
    {
      "id": 22,
      "start": 7853.0,
      "end": 7859.0,
      "formatted_start": "02:10:53.000",
      "formatted_end": "02:10:59.000",
      "text": "و سرگامی، دوست موندن روول سویباله رو سبترس میکنه"
    },
    {
      "id": 23,
      "start": 7859.0,
      "end": 7862.0,
      "formatted_start": "02:10:59.000",
      "formatted_end": "02:11:02.000",
      "text": "چرا توی روزی باید فرد خودشی افتراض کنی؟"
    },
    {
      "id": 24,
      "start": 7862.0,
      "end": 7865.0,
      "formatted_start": "02:11:02.000",
      "formatted_end": "02:11:05.000",
      "text": "شاید بارهایی فقط خودتون پرسه باشید"
    },
    {
      "id": 25,
      "start": 7865.0,
      "end": 7868.0,
      "formatted_start": "02:11:05.000",
      "formatted_end": "02:11:08.000",
      "text": "چرا ندارستن؟ چرا این روزها کنی؟"
    },
    {
      "id": 26,
      "start": 7868.0,
      "end": 7873.0,
      "formatted_start": "02:11:08.000",
      "formatted_end": "02:11:13.000",
      "text": "چون اطرافیان از شما پرسه داشتن که چی جوری تونستی این هر افتاری تعمالو کنید."
    },
    {
      "id": 27,
      "start": 7874.0,
      "end": 7878.0,
      "formatted_start": "02:11:14.000",
      "formatted_end": "02:11:18.000",
      "text": "اما حقیقتی نکیل موندن توی رابطه با فردی خودشیفتنشون یه ضعفتون نیست."
    },
    {
      "id": 28,
      "start": 7879.0,
      "end": 7884.0,
      "formatted_start": "02:11:19.000",
      "formatted_end": "02:11:24.000",
      "text": "نه تیره مجموعیت کومیکا، ترس و بابرهایی که به برورتونید برن شما شکر کردن."
    },
    {
      "id": 29,
      "start": 7885.0,
      "end": 7887.0,
      "formatted_start": "02:11:25.000",
      "formatted_end": "02:11:27.000",
      "text": "شما موندین چون با بیدار بودین یه تغییر کنه."
    },
    {
      "id": 30,
      "start": 7887.0,
      "end": 7893.0,
      "formatted_start": "02:11:27.000",
      "formatted_end": "02:11:33.000",
      "text": "این تغییر بوده. چون بارها از آن شنگیدی که تکرار نمیشه قولونی عوض بشن همین آخری بار بود"
    },
    {
      "id": 31,
      "start": 7893.0,
      "end": 7897.0,
      "formatted_start": "02:11:33.000",
      "formatted_end": "02:11:37.000",
      "text": "و هر بار در تونی خواستین هم با حیرت داشته باشه."
    },
    {
      "id": 32,
      "start": 7897.0,
      "end": 7903.0,
      "formatted_start": "02:11:37.000",
      "formatted_end": "02:11:43.000",
      "text": "چما موندین چون فکر می کردین شاید حفظ خانواده عرضش این سپر رو داشته باشه؟"
    },
    {
      "id": 33,
      "start": 7903.0,
      "end": 7907.0,
      "formatted_start": "02:11:43.000",
      "formatted_end": "02:11:47.000",
      "text": "به خودتون گوین نباید بنیاد خانواده را سمبه کشن."
    },
    {
      "id": 34,
      "start": 7907.0,
      "end": 7911.0,
      "formatted_start": "02:11:47.000",
      "formatted_end": "02:11:51.000",
      "text": "چما موندین چون باورد داشتین اگه برین بچهاتون آسیب می بینن."
    },
    {
      "id": 35,
      "start": 7911.0,
      "end": 7941.0,
      "formatted_start": "02:11:51.000",
      "formatted_end": "02:12:21.000",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 36,
      "start": 7941.0,
      "end": 7951.0,
      "formatted_start": "02:12:21.000",
      "formatted_end": "02:12:31.000",
      "text": "موسیقی"
    },
