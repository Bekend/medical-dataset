  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7514.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:14.000",
      "text": "خمسمی چرا بیمه دارم تنمیشتمایی؟"
    },
    {
      "id": 1,
      "start": 7514.0,
      "end": 7520.0,
      "formatted_start": "02:05:14.000",
      "formatted_end": "02:05:20.000",
      "text": "نه، این هم اداره گاز هستن."
    },
    {
      "id": 2,
      "start": 7520.0,
      "end": 7524.0,
      "formatted_start": "02:05:20.000",
      "formatted_end": "02:05:24.000",
      "text": "آهان خودشون بیمه دارن؟"
    },
    {
      "id": 3,
      "start": 7524.0,
      "end": 7528.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:28.000",
      "text": "آره، پایات تو که تنمی که نیست داره."
    },
    {
      "id": 4,
      "start": 7528.0,
      "end": 7531.0,
      "formatted_start": "02:05:28.000",
      "formatted_end": "02:05:31.000",
      "text": "پا کود میدیشی بدی ببینید توی سیستم میاد"
    },
    {
      "id": 5,
      "start": 7531.0,
      "end": 7534.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:34.000",
      "text": "آره اگر نبود بیرون"
    },
    {
      "id": 6,
      "start": 7534.0,
      "end": 7535.0,
      "formatted_start": "02:05:34.000",
      "formatted_end": "02:05:35.000",
      "text": "باید تعمیش دید"
    },
    {
      "id": 7,
      "start": 7535.0,
      "end": 7536.0,
      "formatted_start": "02:05:35.000",
      "formatted_end": "02:05:36.000",
      "text": "باید دو سه سالی"
    },
    {
      "id": 8,
      "start": 7536.0,
      "end": 7539.0,
      "formatted_start": "02:05:36.000",
      "formatted_end": "02:05:39.000",
      "text": "کار بشکر نداره انا اونجا چیز میکنه موشیم دیگه ها میکنه"
    },
    {
      "id": 9,
      "start": 7549.0,
      "end": 7551.0,
      "formatted_start": "02:05:49.000",
      "formatted_end": "02:05:51.000",
      "text": "اون دکتر این پیش رفته"
    },
    {
      "id": 10,
      "start": 7551.0,
      "end": 7553.0,
      "formatted_start": "02:05:51.000",
      "formatted_end": "02:05:53.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 11,
      "start": 7558.0,
      "end": 7564.0,
      "formatted_start": "02:05:58.000",
      "formatted_end": "02:06:04.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 7588.0,
      "end": 7593.0,
      "formatted_start": "02:06:28.000",
      "formatted_end": "02:06:33.000",
      "text": "خوش افتباه هموند با اجازه ترس زنجیرهای نامده دور زنگهای اصطاداتش رو مانگشن"
    },
    {
      "id": 13,
      "start": 7593.0,
      "end": 7597.0,
      "formatted_start": "02:06:33.000",
      "formatted_end": "02:06:37.000",
      "text": "زنجیرهایی که بیداره میشن اما از هر قفل قدرتش بیشتره دیدن"
    },
    {
      "id": 14,
      "start": 7597.0,
      "end": 7599.0,
      "formatted_start": "02:06:37.000",
      "formatted_end": "02:06:39.000",
      "text": "این ترسان شکل مختلف دارن"
    },
    {
      "id": 15,
      "start": 7599.0,
      "end": 7602.0,
      "formatted_start": "02:06:39.000",
      "formatted_end": "02:06:42.000",
      "text": "ترس از خشم رو با پنشکاری انفجاریش"
    },
    {
      "id": 16,
      "start": 7602.0,
      "end": 7604.0,
      "formatted_start": "02:06:42.000",
      "formatted_end": "02:06:44.000",
      "text": "ترس از انتخاب جویی"
    },
    {
      "id": 17,
      "start": 7604.0,
      "end": 7606.0,
      "formatted_start": "02:06:44.000",
      "formatted_end": "02:06:46.000",
      "text": "ترس از اینه رو خودتون نکنه هی دنبالتون بیاد"
    },
    {
      "id": 18,
      "start": 7606.0,
      "end": 7608.0,
      "formatted_start": "02:06:46.000",
      "formatted_end": "02:06:48.000",
      "text": "ترس از تنبایی"
    },
    {
      "id": 19,
      "start": 7608.0,
      "end": 7610.0,
      "formatted_start": "02:06:48.000",
      "formatted_end": "02:06:50.000",
      "text": "ترس از بیپناه شدن"
    },
    {
      "id": 20,
      "start": 7610.0,
      "end": 7614.0,
      "formatted_start": "02:06:50.000",
      "formatted_end": "02:06:54.000",
      "text": "اگر این شکل مرد هست، ترسی کم کم در اون خودتون شکل گرفته"
    },
    {
      "id": 21,
      "start": 7614.0,
      "end": 7617.0,
      "formatted_start": "02:06:54.000",
      "formatted_end": "02:06:57.000",
      "text": "که اگه نتونم از کساش برمی آمد چی؟"
    },
    {
      "id": 22,
      "start": 7617.0,
      "end": 7620.0,
      "formatted_start": "02:06:57.000",
      "formatted_end": "02:07:00.000",
      "text": "اگه بدون اون دربانه های هم چی؟"
    },
    {
      "id": 23,
      "start": 7620.0,
      "end": 7623.0,
      "formatted_start": "02:07:00.000",
      "formatted_end": "02:07:03.000",
      "text": "اگه تصمیم هم اشتباه باشه چی؟"
    },
    {
      "id": 24,
      "start": 7623.0,
      "end": 7628.0,
      "formatted_start": "02:07:03.000",
      "formatted_end": "02:07:08.000",
      "text": "این همون شکل خودتون هست، شکلی که خودشیده سال ما رو تو زندتون برداشت داره"
    },
    {
      "id": 25,
      "start": 7628.0,
      "end": 7634.0,
      "formatted_start": "02:07:08.000",
      "formatted_end": "02:07:14.000",
      "text": "آیا این که میزنه که مثلاً محیل خانه از بیمه شده وال شهدت نفری باشه؟"
    },
    {
      "id": 26,
      "start": 7634.0,
      "end": 7636.0,
      "formatted_start": "02:07:14.000",
      "formatted_end": "02:07:16.000",
      "text": "خب پس این نیست؟"
    },
    {
      "id": 27,
      "start": 7636.0,
      "end": 7637.0,
      "formatted_start": "02:07:16.000",
      "formatted_end": "02:07:17.000",
      "text": "آه میگن"
    },
    {
      "id": 28,
      "start": 7637.0,
      "end": 7642.0,
      "formatted_start": "02:07:17.000",
      "formatted_end": "02:07:22.000",
      "text": "سیستم دیگه درسته؟ سیستم بالا نمی آد. یعنی تایید می کنه؟"
    },
    {
      "id": 29,
      "start": 7642.0,
      "end": 7649.0,
      "formatted_start": "02:07:22.000",
      "formatted_end": "02:07:29.000",
      "text": "کار می آد. آره دیگه بسته می شه کار. خب این چیز نیست دار. درسته تمینشتماعین وردی"
    },
    {
      "id": 30,
      "start": 7649.0,
      "end": 7655.0,
      "formatted_start": "02:07:29.000",
      "formatted_end": "02:07:35.000",
      "text": "خواهد آزاد می شن. آزاد می شن خواهد می سن می گه که اینا فاکتور بهشون بیدی کردی؟"
    },
    {
      "id": 31,
      "start": 7655.0,
      "end": 7660.0,
      "formatted_start": "02:07:35.000",
      "formatted_end": "02:07:40.000",
      "text": "اینو دیگه بکنم. الان بالا می آد. برای چون شرکت نه. اشکال نداره؟"
    },
    {
      "id": 32,
      "start": 7660.0,
      "end": 7662.0,
      "formatted_start": "02:07:40.000",
      "formatted_end": "02:07:42.000",
      "text": "حالا میتونیم برین داخلش؟"
    },
    {
      "id": 33,
      "start": 7662.0,
      "end": 7664.0,
      "formatted_start": "02:07:42.000",
      "formatted_end": "02:07:44.000",
      "text": "داخل برم"
    },
    {
      "id": 34,
      "start": 7664.0,
      "end": 7666.0,
      "formatted_start": "02:07:44.000",
      "formatted_end": "02:07:46.000",
      "text": "ببین دارو میتونیم برش دزنیم؟"
    },
    {
      "id": 35,
      "start": 7666.0,
      "end": 7668.0,
      "formatted_start": "02:07:46.000",
      "formatted_end": "02:07:48.000",
      "text": "پس بیمه دیگه"
    },
    {
      "id": 36,
      "start": 7668.0,
      "end": 7672.0,
      "formatted_start": "02:07:48.000",
      "formatted_end": "02:07:52.000",
      "text": "انا شما جایی دیگه میرینده؟ قبول میکنن آقای؟"
    },
    {
      "id": 37,
      "start": 7672.0,
      "end": 7674.0,
      "formatted_start": "02:07:52.000",
      "formatted_end": "02:07:54.000",
      "text": "آقای از موقعی رسکشتیم همونطور"
    },
    {
      "id": 38,
      "start": 7674.0,
      "end": 7676.0,
      "formatted_start": "02:07:54.000",
      "formatted_end": "02:07:56.000",
      "text": "جا؟"
    },
    {
      "id": 39,
      "start": 7676.0,
      "end": 7678.0,
      "formatted_start": "02:07:56.000",
      "formatted_end": "02:07:58.000",
      "text": "از موقعی که تغییر جسمی شدیم"
    },
    {
      "id": 40,
      "start": 7678.0,
      "end": 7680.0,
      "formatted_start": "02:07:58.000",
      "formatted_end": "02:08:00.000",
      "text": "از موقعی که تغییر جسمی شدیم"
    },
    {
      "id": 41,
      "start": 7680.0,
      "end": 7682.0,
      "formatted_start": "02:08:00.000",
      "formatted_end": "02:08:02.000",
      "text": "میاد؟"
    },
    {
      "id": 42,
      "start": 7682.0,
      "end": 7684.0,
      "formatted_start": "02:08:02.000",
      "formatted_end": "02:08:04.000",
      "text": "خب اشکال نفع کنم"
    },
    {
      "id": 43,
      "start": 7684.0,
      "end": 7686.0,
      "formatted_start": "02:08:04.000",
      "formatted_end": "02:08:06.000",
      "text": "از موقعی که تغییر جسمی شدیم"
    },
    {
      "id": 44,
      "start": 7686.0,
      "end": 7688.0,
      "formatted_start": "02:08:06.000",
      "formatted_end": "02:08:08.000",
      "text": "اشکال نفع کنم"
    },
    {
      "id": 45,
      "start": 7688.0,
      "end": 7692.0,
      "formatted_start": "02:08:08.000",
      "formatted_end": "02:08:12.000",
      "text": "در این وقت، دیوار دور زندگی شما ساخته میشن"
    },
    {
      "id": 46,
      "start": 7692.0,
      "end": 7696.0,
      "formatted_start": "02:08:12.000",
      "formatted_end": "02:08:16.000",
      "text": "و هر دور که را فکر میکنی، این پیام بهتون میدن"
    },
    {
      "id": 47,
      "start": 7696.0,
      "end": 7700.0,
      "formatted_start": "02:08:16.000",
      "formatted_end": "02:08:20.000",
      "text": "نه نه بود، قدرناکه، تو نمیتونی، از پسش بر نمی آیی"
    },
    {
      "id": 48,
      "start": 7700.0,
      "end": 7702.0,
      "formatted_start": "02:08:20.000",
      "formatted_end": "02:08:22.000",
      "text": "پشیمون میشی"
    },
    {
      "id": 49,
      "start": 7702.0,
      "end": 7706.0,
      "formatted_start": "02:08:22.000",
      "formatted_end": "02:08:26.000",
      "text": "و به همین دور یکی خیلی از قربانی هست"
    },
    {
      "id": 50,
      "start": 7706.0,
      "end": 7710.0,
      "formatted_start": "02:08:26.000",
      "formatted_end": "02:08:30.000",
      "text": "حتی وقتی میدونن این رابطه براشون بازم آن سیبزار هست، بازم نمیتونم ازش خواهش بشم"
    },
    {
      "id": 51,
      "start": 7710.0,
      "end": 7716.0,
      "formatted_start": "02:08:30.000",
      "formatted_end": "02:08:36.000",
      "text": "چون خودچیفته فقط آدادی شما رو نمیخوند اعتماد شما به غذابت خودتون رو از نگه بره."
    },
    {
      "id": 52,
      "start": 7716.0,
      "end": 7721.0,
      "formatted_start": "02:08:36.000",
      "formatted_end": "02:08:41.000",
      "text": "وقتی این اعتماد از نگه بره، حتی فکر کردن به رفتن هم میتونه ترس ماید در ازرگ است."
    },
    {
      "id": 53,
      "start": 7721.0,
      "end": 7726.0,
      "formatted_start": "02:08:41.000",
      "formatted_end": "02:08:46.000",
      "text": "اما یادتون باشه، ترس همیشه نشان به اشتباه بودن تصمیم نیست."
    },
    {
      "id": 54,
      "start": 7726.0,
      "end": 7734.0,
      "formatted_start": "02:08:46.000",
      "formatted_end": "02:08:54.000",
      "text": "کاری بخواب، صالح و مجرد از کاری روانی و اشتراکتی شدن ذهن شما باید سه نداره میشه."
    },
    {
      "id": 55,
      "start": 7734.0,
      "end": 7744.0,
      "formatted_start": "02:08:54.000",
      "formatted_end": "02:09:04.000",
      "text": "موسیقی"
    },
    {
      "id": 56,
      "start": 7794.0,
      "end": 7800.0,
      "formatted_start": "02:09:54.000",
      "formatted_end": "02:10:00.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}