      "end": 3735.0,
      "formatted_start": "01:02:13.000",
      "formatted_end": "01:02:15.000",
      "text": "بگیرم اینجا"
    },
    {
      "id": 7,
      "start": 3735.0,
      "end": 3737.0,
      "formatted_start": "01:02:15.000",
      "formatted_end": "01:02:17.000",
      "text": "سلامت بگیرم"
    },
    {
      "id": 8,
      "start": 3737.0,
      "end": 3739.0,
      "formatted_start": "01:02:17.000",
      "formatted_end": "01:02:19.000",
      "text": "خواهش بگیرم"
    },
    {
      "id": 9,
      "start": 3739.0,
      "end": 3743.0,
      "formatted_start": "01:02:19.000",
      "formatted_end": "01:02:23.000",
      "text": "از برسو بارو شما را جازم و باید چرا تا دردی مرسان فراغانی را برگیرم"
    },
    {
      "id": 10,
      "start": 3743.0,
      "end": 3745.0,
      "formatted_start": "01:02:23.000",
      "formatted_end": "01:02:25.000",
