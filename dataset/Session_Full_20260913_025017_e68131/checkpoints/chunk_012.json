    },
    {
      "id": 11,
      "start": 3696.0,
      "end": 3725.98,
      "formatted_start": "01:01:36.000",
      "formatted_end": "01:02:05.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 12,
      "start": 3726.0,
      "end": 3755.98,
      "formatted_start": "01:02:06.000",
      "formatted_end": "01:02:35.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 13,
      "start": 3756.0,
      "end": 3786.0,
      "formatted_start": "01:02:36.000",
      "formatted_end": "01:03:06.000",
      "text": "بخونید با اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 14,
      "start": 3786.0,
      "end": 3790.5,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:10.500",
      "text": "اصلا اون روز دور چشمش قراره از دیشب بیمارستان بردیم"
    },
    {
      "id": 15,
      "start": 3790.5,
      "end": 3792.5,
      "formatted_start": "01:03:10.500",
      "formatted_end": "01:03:12.500",
      "text": "قلیزی دور چشم"
    },
    {
      "id": 16,
      "start": 3792.5,
      "end": 3794.5,
      "formatted_start": "01:03:12.500",
      "formatted_end": "01:03:14.500",
      "text": "نفسش بالا اصلا نمی آمد"
    },
    {
      "id": 17,
      "start": 3794.5,
      "end": 3797.5,
      "formatted_start": "01:03:14.500",
      "formatted_end": "01:03:17.500",
      "text": "نه از لحن نه از دماغانو میتونست نفس بکشن"
    },
    {
      "id": 18,
      "start": 3797.5,
      "end": 3798.5,
      "formatted_start": "01:03:17.500",
      "formatted_end": "01:03:18.500",
      "text": "دیشب برده؟"
    },
    {
      "id": 19,
      "start": 3798.5,
      "end": 3801.5,
      "formatted_start": "01:03:18.500",
      "formatted_end": "01:03:21.500",
      "text": "دیشب بعد به هیچ عنوان نمیتونست شیر بکر و اینا"
    },
    {
      "id": 20,
      "start": 3801.5,
      "end": 3803.0,
      "formatted_start": "01:03:21.500",
      "formatted_end": "01:03:23.000",
      "text": "واکسن که ایزده بیدی؟"
    },
    {
      "id": 21,
      "start": 3803.0,
      "end": 3808.5,
      "formatted_start": "01:03:23.000",
      "formatted_end": "01:03:28.500",
      "text": "شمبه واکسن زدم انگار که خیلی مثلا ادرالش هم خونی شد بعد واکسن"
    },
    {
      "id": 22,
      "start": 3808.5,
      "end": 3810.5,
      "formatted_start": "01:03:28.500",
      "formatted_end": "01:03:30.500",
      "text": "چه علاوه میخواد در مرکزی؟"
    },
    {
      "id": 23,
      "start": 3810.5,
      "end": 3811.5,
      "formatted_start": "01:03:30.500",
      "formatted_end": "01:03:31.500",
      "text": "و دیگه"
    },
    {
      "id": 24,
      "start": 3811.5,
      "end": 3813.5,
      "formatted_start": "01:03:31.500",
      "formatted_end": "01:03:33.500",
      "text": "اوکسیجنش بسری نکردن؟"
    },
    {
      "id": 25,
      "start": 3813.5,
      "end": 3817.5,
      "formatted_start": "01:03:33.500",
      "formatted_end": "01:03:37.500",
      "text": "نه اوکسیجنش بسری نکردن هیچ جور نفرست نفست بکشه"
    },
    {
      "id": 26,
      "start": 3817.5,
      "end": 3820.5,
      "formatted_start": "01:03:37.500",
      "formatted_end": "01:03:40.500",
      "text": "اونجور باید بسری میشود به این شرایطی دیدی"
    },
    {
      "id": 27,
      "start": 3820.5,
      "end": 3822.5,
      "formatted_start": "01:03:40.500",
      "formatted_end": "01:03:42.500",
      "text": "از چهالش خیلی بد بوده"
    },
    {
      "id": 28,
      "start": 3822.5,
      "end": 3825.5,
      "formatted_start": "01:03:42.500",
      "formatted_end": "01:03:45.500",
      "text": "آره ببین از دیشب بیمار همینجوریه"
    },
    {
      "id": 29,
      "start": 3825.5,
      "end": 3828.5,
      "formatted_start": "01:03:45.500",
      "formatted_end": "01:03:48.500",
      "text": "انگاه که گلدر داشته باشه این حالتی"
    },
    {
      "id": 30,
      "start": 3828.5,
      "end": 3831.5,
      "formatted_start": "01:03:48.500",
      "formatted_end": "01:03:51.500",
      "text": "قبل واکسن بهش اساملیو فون هم دادی؟"
    },
    {
      "id": 31,
      "start": 3831.5,
      "end": 3832.5,
      "formatted_start": "01:03:51.500",
      "formatted_end": "01:03:52.500",
      "text": "نه"
    },
    {
      "id": 32,
      "start": 3832.5,
      "end": 3834.5,
      "formatted_start": "01:03:52.500",
      "formatted_end": "01:03:54.500",
      "text": "همیشه قبل و بعد واکسن اساملیو فون"
    },
    {
      "id": 33,
      "start": 3834.5,
      "end": 3836.5,
      "formatted_start": "01:03:54.500",
      "formatted_end": "01:03:56.500",
      "text": "یه روز قبلش بدی"
    },
    {
      "id": 34,
      "start": 3836.5,
      "end": 3837.5,
      "formatted_start": "01:03:56.500",
      "formatted_end": "01:03:57.500",
      "text": "نه"
    },
    {
      "id": 35,
      "start": 3837.5,
      "end": 3839.5,
      "formatted_start": "01:03:57.500",
      "formatted_end": "01:03:59.500",
      "text": "همیشه قبل و بعد واکسن است"
    },
    {
      "id": 36,
      "start": 3839.5,
      "end": 3842.5,
      "formatted_start": "01:03:59.500",
      "formatted_end": "01:04:02.500",
      "text": "یه روز قبلش بدید و یه روز بعدش"
    },
    {
      "id": 37,
      "start": 3842.5,
      "end": 3845.5,
      "formatted_start": "01:04:02.500",
      "formatted_end": "01:04:05.500",
      "text": "شاید قبل واکسن و شاید بعد واکسن"
    },
    {
      "id": 38,
      "start": 3845.5,
      "end": 3847.5,
      "formatted_start": "01:04:05.500",
      "formatted_end": "01:04:07.500",
      "text": "الان ادرارشم خونه؟"
    },
    {
      "id": 39,
      "start": 3847.5,
      "end": 3849.5,
      "formatted_start": "01:04:07.500",
      "formatted_end": "01:04:09.500",
      "text": "نه فقط دوباره"
    },
    {
      "id": 40,
      "start": 3849.5,
      "end": 3852.5,
      "formatted_start": "01:04:09.500",
      "formatted_end": "01:04:12.500",
      "text": "این خونه چی گویی بود؟ یه گفته؟"
    },
    {
      "id": 41,
      "start": 3852.5,
      "end": 3854.5,
      "formatted_start": "01:04:12.500",
      "formatted_end": "01:04:14.500",
      "text": "نه نه نه در رد یه سکه بود"
    },
    {
      "id": 42,
      "start": 3854.5,
      "end": 3856.5,
      "formatted_start": "01:04:14.500",
      "formatted_end": "01:04:16.500",
      "text": "یه سکه قرمز زنگ؟"
    },
    {
      "id": 43,
      "start": 3856.5,
      "end": 3858.5,
      "formatted_start": "01:04:16.500",
      "formatted_end": "01:04:18.500",
      "text": "باید کسی نیشتر ازش؟"
    },
    {
      "id": 44,
      "start": 3858.5,
      "end": 3860.5,
      "formatted_start": "01:04:18.500",
      "formatted_end": "01:04:20.500",
      "text": "برامون جنگی هم هفتاد روزش هست"
    },
    {
      "id": 45,
      "start": 3860.5,
      "end": 3863.5,
      "formatted_start": "01:04:20.500",
      "formatted_end": "01:04:23.500",
      "text": "هفتاد روز، الان هم دور چشمش قرمزه؟"
    },
    {
      "id": 46,
      "start": 3863.5,
      "end": 3867.5,
      "formatted_start": "01:04:23.500",
      "formatted_end": "01:04:27.500",
      "text": "چشمش این حالتیه. حالا که اینگاه افراد کرده باشه."
    },
    {
      "id": 47,
      "start": 3867.5,
      "end": 3869.5,
      "formatted_start": "01:04:27.500",
      "formatted_end": "01:04:29.500",
      "text": "دلیل ببینه. چشم میزنه."
    },
    {
      "id": 48,
      "start": 3869.5,
      "end": 3871.5,
      "formatted_start": "01:04:29.500",
      "formatted_end": "01:04:31.500",
      "text": "آره. حساسیت داشته باشه."
    },
    {
      "id": 49,
      "start": 3871.5,
      "end": 3873.5,
      "formatted_start": "01:04:31.500",
      "formatted_end": "01:04:33.500",
      "text": "چون این بردی نمیدونه."
    },
    {
      "id": 50,
      "start": 3873.5,
      "end": 3874.5,
      "formatted_start": "01:04:33.500",
      "formatted_end": "01:04:34.500",
      "text": "چه ها بیسرم؟"
    },
    {
      "id": 51,
      "start": 3874.5,
      "end": 3876.5,
      "formatted_start": "01:04:34.500",
      "formatted_end": "01:04:36.500",
      "text": "خیلی آرومه. چه آرومیه."
    },
    {
      "id": 52,
      "start": 3876.5,
      "end": 3877.5,
      "formatted_start": "01:04:36.500",
      "formatted_end": "01:04:37.500",
      "text": "بله. من آروم شدم."
    },
    {
      "id": 53,
      "start": 3877.5,
      "end": 3879.5,
      "formatted_start": "01:04:37.500",
      "formatted_end": "01:04:39.500",
      "text": "اون چه غابت زده ای؟ نه آروم شده."
    },
    {
      "id": 54,
      "start": 3879.5,
      "end": 3880.5,
      "formatted_start": "01:04:39.500",
      "formatted_end": "01:04:40.500",
      "text": "نه."
    },
    {
      "id": 55,
      "start": 3883.5,
      "end": 3885.5,
      "formatted_start": "01:04:43.500",
      "formatted_end": "01:04:45.500",
      "text": "چه بیسرم خوشنگه؟"
    },
    {
      "id": 56,
      "start": 3886.5,
      "end": 3887.5,
      "formatted_start": "01:04:46.500",
      "formatted_end": "01:04:47.500",
      "text": "خوبه ای؟"
    }
  ],
  "status": "completed"
}