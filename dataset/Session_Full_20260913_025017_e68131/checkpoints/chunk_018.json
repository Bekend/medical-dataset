  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5404.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:04.000",
      "text": "این رو سه تومن سراس کن، خیلی عرضینش ریاض میشه برای یک فرمانه."
    },
    {
      "id": 1,
      "start": 5404.0,
      "end": 5413.0,
      "formatted_start": "01:30:04.000",
      "formatted_end": "01:30:13.000",
      "text": "استاد، سه تومن خوبه، دیگه سه میلیونه، اما پانستر چیزی نیست استاد جان، من..."
    },
    {
      "id": 2,
      "start": 5413.0,
      "end": 5420.0,
      "formatted_start": "01:30:13.000",
      "formatted_end": "01:30:20.000",
      "text": "خب برای... نه، خب من، برای من سه تومن خیلی یک کارمنده بیگه، چیزی نیسته، خیلی."
    },
    {
      "id": 3,
      "start": 5420.0,
      "end": 5429.0,
      "formatted_start": "01:30:20.000",
      "formatted_end": "01:30:29.000",
      "text": "سه تومن، اگه میگیری من سفارش بدم، چون اینشم خیلی گرونه، اگه سه تومن میگیری من سفارش بدم."
    },
    {
      "id": 4,
      "start": 5429.0,
      "end": 5435.0,
      "formatted_start": "01:30:29.000",
      "formatted_end": "01:30:35.000",
      "text": "اما ستمان"
    },
    {
      "id": 5,
      "start": 5435.0,
      "end": 5441.0,
      "formatted_start": "01:30:35.000",
      "formatted_end": "01:30:41.000",
      "text": "خب شاید تعمیر کنم"
    },
    {
      "id": 6,
      "start": 5441.0,
      "end": 5447.0,
      "formatted_start": "01:30:41.000",
      "formatted_end": "01:30:47.000",
      "text": "خب برای ستمان بابا که نرده دیگه"
    },
    {
      "id": 7,
      "start": 5447.0,
      "end": 5453.0,
      "formatted_start": "01:30:47.000",
      "formatted_end": "01:30:53.000",
      "text": "دیگه خیلی چیز نکنشه"
    },
    {
      "id": 8,
      "start": 5453.0,
      "end": 5467.96,
      "formatted_start": "01:30:53.000",
      "formatted_end": "01:31:07.960",
      "text": "خب 3 و 200 خوبه"
    },
    {
      "id": 9,
      "start": 5467.96,
      "end": 5469.96,
      "formatted_start": "01:31:07.960",
      "formatted_end": "01:31:09.960",
      "text": "الان دیگه من با اون زمان کار ندارم"
    },
    {
      "id": 10,
      "start": 5469.96,
      "end": 5475.24,
      "formatted_start": "01:31:09.960",
      "formatted_end": "01:31:15.240",
      "text": "بله"
    },
    {
      "id": 11,
      "start": 5475.24,
      "end": 5479.62,
      "formatted_start": "01:31:15.240",
      "formatted_end": "01:31:19.620",
      "text": "دو در اینجا همه رو زنگ میزنند"
    },
    {
      "id": 12,
      "start": 5479.62,
      "end": 5482.26,
      "formatted_start": "01:31:19.620",
      "formatted_end": "01:31:22.260",
      "text": "باشه"
    },
    {
      "id": 13,
      "start": 5482.26,
      "end": 5486.5,
      "formatted_start": "01:31:22.260",
      "formatted_end": "01:31:26.500",
      "text": "پس سوالی داره، گفت دارم، گفت دارم فقط اون زمان شما میبینیم"
    },
    {
      "id": 14,
      "start": 5486.5,
      "end": 5488.5,
      "formatted_start": "01:31:26.500",
      "formatted_end": "01:31:28.500",
      "text": "باشه، باشه، خواهد هست"
    },
    {
      "id": 15,
      "start": 5488.5,
      "end": 5490.5,
      "formatted_start": "01:31:28.500",
      "formatted_end": "01:31:30.500",
      "text": "خواهد هست"
    },
    {
      "id": 16,
      "start": 5492.5,
      "end": 5494.5,
      "formatted_start": "01:31:32.500",
      "formatted_end": "01:31:34.500",
      "text": "بنده؟ این کم بنده؟"
    },
    {
      "id": 17,
      "start": 5494.5,
      "end": 5497.5,
      "formatted_start": "01:31:34.500",
      "formatted_end": "01:31:37.500",
      "text": "این چون پاسه بنده، پاسه ده"
    },
    {
      "id": 18,
      "start": 5502.5,
      "end": 5508.5,
      "formatted_start": "01:31:42.500",
      "formatted_end": "01:31:48.500",
      "text": "حالا، از پنج پنج این مستقبل رو میگیر 2017، این ماشین ها، این میخوره؟"
    },
    {
      "id": 19,
      "start": 5512.26,
      "end": 5522.26,
      "formatted_start": "01:31:52.260",
      "formatted_end": "01:32:02.260",
      "text": "خب پس به همه ماشین و مدل ها میپرده دیگه ای"
    },
    {
      "id": 20,
      "start": 5522.26,
      "end": 5527.26,
      "formatted_start": "01:32:02.260",
      "formatted_end": "01:32:07.260",
      "text": "خیلی خوب باشه گرفتم"
    },
    {
      "id": 21,
      "start": 5527.26,
      "end": 5541.26,
      "formatted_start": "01:32:07.260",
      "formatted_end": "01:32:21.260",
      "text": "خب باشه من الان میزنم شماره حسابتون رو فرضت بفرستم"
    },
    {
      "id": 22,
      "start": 5541.26,
      "end": 5546.26,
      "formatted_start": "01:32:21.260",
      "formatted_end": "01:32:26.260",
      "text": "کدامی که حزینهش کمتره واسه خیلیه"
    },
    {
      "id": 23,
      "start": 5546.26,
      "end": 5549.26,
      "formatted_start": "01:32:26.260",
      "formatted_end": "01:32:29.260",
      "text": "پاکون چهار برسیدیم"
    },
    {
      "id": 24,
      "start": 5549.26,
      "end": 5553.26,
      "formatted_start": "01:32:29.260",
      "formatted_end": "01:32:33.260",
