      "id": 61,
      "start": 5972.0,
      "end": 5978.0,
      "formatted_start": "01:39:32.000",
      "formatted_end": "01:39:38.000",
      "text": "دیگه دارو دیگه دو غلم کمتری چیزی که ما نوشتیم"
    },
