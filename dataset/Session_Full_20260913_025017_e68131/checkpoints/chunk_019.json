      "start": 5978.0,
      "end": 5981.0,
      "formatted_start": "01:39:38.000",
      "formatted_end": "01:39:41.000",
      "text": "یه اشتماکی باید یه چیزی بخورده دیگه"
    },
    {
      "id": 63,
      "start": 5981.0,
      "end": 5984.0,
      "formatted_start": "01:39:41.000",
      "formatted_end": "01:39:44.000",
      "text": "بخورد بشه اونقدر حزینه نداره"
    },
    {
      "id": 64,
      "start": 5984.0,
      "end": 5986.0,
      "formatted_start": "01:39:44.000",
      "formatted_end": "01:39:46.000",
      "text": "خواهش بگیر خداحافظ"
    },
    {
      "id": 65,
      "start": 5986.0,
      "end": 5987.0,
      "formatted_start": "01:39:46.000",
      "formatted_end": "01:39:47.000",
      "text": "خداحافظ"
    },
    {
      "id": 66,
      "start": 5987.0,
      "end": 5989.0,
      "formatted_start": "01:39:47.000",
      "formatted_end": "01:39:49.000",
      "text": "دو ناس با این رو خوب میشه"
    },
