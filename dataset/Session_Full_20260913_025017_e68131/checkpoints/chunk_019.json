      "id": 68,
      "start": 5992.0,
      "end": 5994.0,
      "formatted_start": "01:39:52.000",
      "formatted_end": "01:39:54.000",
      "text": "چی رو چی رو داری؟"
    },
    {
      "id": 69,
      "start": 5994.0,
      "end": 5996.0,
      "formatted_start": "01:39:54.000",
      "formatted_end": "01:39:56.000",
      "text": "چی رو داری کنی؟"
    },
    {
      "id": 70,
      "start": 5996.0,
      "end": 5998.0,
      "formatted_start": "01:39:56.000",
      "formatted_end": "01:39:58.000",
      "text": "چی رو دیشتی؟ چی رو دیشتی؟"
    },
    {
      "id": 71,
      "start": 5998.0,
      "end": 6000.0,
      "formatted_start": "01:39:58.000",
      "formatted_end": "01:40:00.000",
