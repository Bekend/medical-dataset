    },
    {
      "id": 2,
      "start": 1560.0,
      "end": 1570.0,
      "formatted_start": "00:26:00.000",
      "formatted_end": "00:26:10.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 1590.0,
      "end": 1618.0,
      "formatted_start": "00:26:30.000",
      "formatted_end": "00:26:58.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 1620.0,
      "end": 1623.4,
      "formatted_start": "00:27:00.000",
      "formatted_end": "00:27:03.400",
      "text": "من هم کشنگیری شده باشم که باید شدی"
    },
    {
      "id": 5,
      "start": 1623.4,
      "end": 1626.2,
      "formatted_start": "00:27:03.400",
      "formatted_end": "00:27:06.200",
      "text": "باید برید کسته که چیه برید"
    },
    {
      "id": 6,
      "start": 1626.2,
      "end": 1629.2,
      "formatted_start": "00:27:06.200",
      "formatted_end": "00:27:09.200",
      "text": "که چیزی هستیه نم شده دیگه"
    },
    {
      "id": 7,
      "start": 1629.2,
      "end": 1631.2,
      "formatted_start": "00:27:09.200",
      "formatted_end": "00:27:11.200",
      "text": "چرا خب؟"
    },
    {
      "id": 8,
      "start": 1631.2,
      "end": 1636.2,
      "formatted_start": "00:27:11.200",
      "formatted_end": "00:27:16.200",
      "text": "نه نه آخر برم"
    },
    {
      "id": 9,
      "start": 1636.2,
      "end": 1637.2,
      "formatted_start": "00:27:16.200",
      "formatted_end": "00:27:17.200",
      "text": "موسیقی من تو نه برم"
    },
    {
      "id": 10,
      "start": 1637.2,
      "end": 1638.2,
      "formatted_start": "00:27:17.200",
      "formatted_end": "00:27:18.200",
      "text": "نه"
    },
    {
      "id": 11,
      "start": 1638.2,
      "end": 1639.2,
      "formatted_start": "00:27:18.200",
      "formatted_end": "00:27:19.200",
      "text": "نه برم"
    },
    {
      "id": 12,
      "start": 1639.2,
      "end": 1643.2,
      "formatted_start": "00:27:19.200",
      "formatted_end": "00:27:23.200",
      "text": "نه بابا چه کاریه"
    },
    {
      "id": 13,
      "start": 1643.2,
      "end": 1645.2,
      "formatted_start": "00:27:23.200",
      "formatted_end": "00:27:25.200",
      "text": "نه نه بابا موسیقی خسته هست"
    },
    {
      "id": 14,
      "start": 1645.2,
      "end": 1647.2,
      "formatted_start": "00:27:25.200",
      "formatted_end": "00:27:27.200",
      "text": "برای من بیشتر شبهه بگم"
    },
    {
      "id": 15,
      "start": 1647.2,
      "end": 1677.2,
      "formatted_start": "00:27:27.200",
      "formatted_end": "00:27:57.200",
      "text": "اون شب هم پایین بید آیوان رو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم خستند و از این سرارو گفتید که این موسم"
    },
    {
      "id": 16,
      "start": 1677.2,
      "end": 1707.2,
      "formatted_start": "00:27:57.200",
      "formatted_end": "00:28:27.200",
      "text": "و این تیزی شد که گویم که خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خی"
    },
    {
      "id": 17,
      "start": 1707.2,
      "end": 1737.18,
      "formatted_start": "00:28:27.200",
      "formatted_end": "00:28:57.180",
      "text": "موسیقی در موسیقی دیگه"
    },
    {
      "id": 18,
      "start": 1737.2,
      "end": 1767.18,
      "formatted_start": "00:28:57.200",
      "formatted_end": "00:29:27.180",
