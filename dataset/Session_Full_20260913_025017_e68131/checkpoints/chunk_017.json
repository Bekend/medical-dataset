      "formatted_end": "01:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 5130.0,
      "end": 5159.98,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 5160.0,
      "end": 5175.0,
      "formatted_start": "01:26:00.000",
      "formatted_end": "01:26:15.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 5175.0,
      "end": 5177.0,
      "formatted_start": "01:26:15.000",
      "formatted_end": "01:26:17.000",
      "text": "حالا سلام آقای ساری"
    },
    {
      "id": 4,
      "start": 5177.0,
      "end": 5179.0,
      "formatted_start": "01:26:17.000",
      "formatted_end": "01:26:19.000",
      "text": "خوبین آقای ساری از خودم بگم"
    },
    {
      "id": 5,
      "start": 5179.0,
      "end": 5183.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:23.000",
      "text": "مترفن داخل اتاق فلوینس رنو داریم"
    },
    {
      "id": 6,
      "start": 5186.0,
      "end": 5188.0,
      "formatted_start": "01:26:26.000",
      "formatted_end": "01:26:28.000",
      "text": "مردم مرسی ممنون"
    },
    {
      "id": 7,
      "start": 5205.0,
      "end": 5234.98,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:27:14.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 8,
      "start": 5235.0,
      "end": 5264.98,
      "formatted_start": "01:27:15.000",
      "formatted_end": "01:27:44.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 9,
      "start": 5265.0,
      "end": 5295.0,
      "formatted_start": "01:27:45.000",
      "formatted_end": "01:28:15.000",
      "text": "از اینجا باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه برداری"
    },
    {
      "id": 10,
      "start": 5295.0,
      "end": 5302.72,
      "formatted_start": "01:28:15.000",
      "formatted_end": "01:28:22.720",
      "text": "خب باشه اگر شاد میزنم بتونه تدا بیدم"
    },
    {
      "id": 11,
      "start": 5302.72,
      "end": 5304.6,
      "formatted_start": "01:28:22.720",
      "formatted_end": "01:28:24.600",
      "text": "مرسی خدا فسیبا"
    },
    {
      "id": 12,
      "start": 5325.0,
      "end": 5343.0,
      "formatted_start": "01:28:45.000",
      "formatted_end": "01:29:03.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 5343.0,
      "end": 5345.0,
      "formatted_start": "01:29:03.000",
      "formatted_end": "01:29:05.000",
      "text": "حالا سلام است جایم خوبی؟"
    },
    {
      "id": 14,
      "start": 5345.0,
      "end": 5351.0,
      "formatted_start": "01:29:05.000",
      "formatted_end": "01:29:11.000",
      "text": "آقا این متوفن حدود 13 و 514 تومن اینها هست خب"
    },
    {
      "id": 15,
      "start": 5351.0,
      "end": 5356.0,
      "formatted_start": "01:29:11.000",
      "formatted_end": "01:29:16.000",
      "text": "اینجا حصاری هم نداره من باید از تهران سپالش بدم خب"
    },
    {
      "id": 16,
      "start": 5356.0,
      "end": 5361.0,
      "formatted_start": "01:29:16.000",
      "formatted_end": "01:29:21.000",
      "text": "ببین اگران ما این متوفن دیگرم صد درصد درسته؟"
    },
    {
      "id": 17,
      "start": 5365.0,
      "end": 5369.0,
      "formatted_start": "01:29:25.000",
      "formatted_end": "01:29:29.000",
      "text": "کاله، کاله جنس خوب داره بیده"
    },
    {
      "id": 18,
      "start": 5373.0,
      "end": 5380.36,
      "formatted_start": "01:29:33.000",
      "formatted_end": "01:29:40.360",
      "text": "سال ساختی چیه؟"
    },
    {
      "id": 19,
      "start": 5380.36,
      "end": 5384.06,
      "formatted_start": "01:29:40.360",
      "formatted_end": "01:29:44.060",
      "text": "چه سال؟"
    },
    {
      "id": 20,
      "start": 5384.06,
      "end": 5384.6,
      "formatted_start": "01:29:44.060",
      "formatted_end": "01:29:44.600",
      "text": "خوب"
    },
    {
      "id": 21,
      "start": 5384.6,
      "end": 5386.1,
      "formatted_start": "01:29:44.600",
      "formatted_end": "01:29:46.100",
      "text": "خوب"
    },
    {
      "id": 22,
      "start": 5386.1,
      "end": 5387.56,
      "formatted_start": "01:29:46.100",
      "formatted_end": "01:29:47.560",
      "text": "دوزه"
    },
    {
      "id": 23,
      "start": 5387.56,
      "end": 5391.72,
      "formatted_start": "01:29:47.560",
      "formatted_end": "01:29:51.720",
      "text": "خلید"
    },
    {
      "id": 24,
      "start": 5391.72,
      "end": 5394.4,
      "formatted_start": "01:29:51.720",
      "formatted_end": "01:29:54.400",
      "text": "بعد استا اجلت شما آخری"
    },
    {
      "id": 25,
      "start": 5394.4,
      "end": 5396.9,
      "formatted_start": "01:29:54.400",
      "formatted_end": "01:29:56.900",
      "text": "ببین شما سه تا مانگ گفتین"
    },
    {
      "id": 26,
      "start": 5396.9,
      "end": 5398.52,
      "formatted_start": "01:29:56.900",
      "formatted_end": "01:29:58.520",
      "text": "یه کم تر"
    },
    {
      "id": 27,
      "start": 5398.52,
      "end": 5399.52,
      "formatted_start": "01:29:58.520",
      "formatted_end": "01:29:59.520",
      "text": "نه نه"
    },
    {
      "id": 28,
      "start": 5399.52,
      "end": 5399.98,
      "formatted_start": "01:29:59.520",
      "formatted_end": "01:29:59.980",
      "text": "اینو بگیم"
    }
  ],
  "status": "completed"
}