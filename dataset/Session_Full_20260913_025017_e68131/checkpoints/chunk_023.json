      "formatted_end": "01:55:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6950.0,
      "end": 6952.0,
      "formatted_start": "01:55:50.000",
      "formatted_end": "01:55:52.000",
      "text": "من این چیز بود؟ سنتام شد؟"
    },
    {
      "id": 3,
      "start": 6952.0,
      "end": 6953.0,
      "formatted_start": "01:55:52.000",
      "formatted_end": "01:55:53.000",
      "text": "آره"
    },
    {
      "id": 4,
      "start": 6953.0,
      "end": 6955.0,
      "formatted_start": "01:55:53.000",
      "formatted_end": "01:55:55.000",
      "text": "خب بریم دیگر رسید"
    },
    {
      "id": 5,
      "start": 6955.0,
      "end": 6957.0,
      "formatted_start": "01:55:55.000",
      "formatted_end": "01:55:57.000",
      "text": "آره بریم دیگر رسید"
