      "id": 8,
      "start": 6962.0,
      "end": 6964.0,
      "formatted_start": "01:56:02.000",
      "formatted_end": "01:56:04.000",
      "text": "این این مریضت رو گرفته"
    },
    {
      "id": 9,
      "start": 6964.0,
      "end": 6966.0,
      "formatted_start": "01:56:04.000",
      "formatted_end": "01:56:06.000",
      "text": "خب این که این گرفته؟"
    },
    {
      "id": 10,
      "start": 6966.0,
      "end": 6968.0,
      "formatted_start": "01:56:06.000",
      "formatted_end": "01:56:08.000",
      "text": "باید اونوش بگذاریم"
    },
    {
      "id": 11,
      "start": 6968.0,
      "end": 6971.0,
      "formatted_start": "01:56:08.000",
      "formatted_end": "01:56:11.000",
      "text": "خب بریمارستان رو زنگتیم باستی نیم؟"
    },
