      "end": 6959.0,
      "formatted_start": "01:55:57.000",
      "formatted_end": "01:55:59.000",
      "text": "یه جرسی دیگر"
    },
    {
      "id": 7,
      "start": 6959.0,
      "end": 6962.0,
      "formatted_start": "01:55:59.000",
      "formatted_end": "01:56:02.000",
      "text": "این این دورم کدوم مریض؟"
    },
