  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2429.98,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 2430.0,
      "end": 2452.0,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:52.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 2460.0,
      "end": 2470.0,
      "formatted_start": "00:41:00.000",
      "formatted_end": "00:41:10.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 2490.0,
      "end": 2518.0,
      "formatted_start": "00:41:30.000",
      "formatted_end": "00:41:58.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 2520.0,
      "end": 2540.0,
      "formatted_start": "00:42:00.000",
      "formatted_end": "00:42:20.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 2550.0,
      "end": 2553.5,
      "formatted_start": "00:42:30.000",
      "formatted_end": "00:42:33.500",
      "text": "توی آتیش آهه همون مرگایی که خوردم دارم میسوزم"
    },
    {
      "id": 6,
      "start": 2553.5,
      "end": 2556.1,
      "formatted_start": "00:42:33.500",
      "formatted_end": "00:42:36.100",
      "text": "از ترس بیدار شدم و توبه کردم و حاجی شدم"
    },
    {
      "id": 7,
      "start": 2556.1,
      "end": 2558.7,
      "formatted_start": "00:42:36.100",
      "formatted_end": "00:42:38.700",
      "text": "این عوارو پوشیدم و عهد بستم"
    },
    {
      "id": 8,
      "start": 2558.7,
      "end": 2562.9,
      "formatted_start": "00:42:38.700",
      "formatted_end": "00:42:42.900",
      "text": "تا آخر عمرم گیاهار بشم و فقط عبادت کنم"
    },
    {
      "id": 9,
      "start": 2562.9,
      "end": 2565.78,
      "formatted_start": "00:42:42.900",
      "formatted_end": "00:42:45.780",
      "text": "میخواهم به زیارت خانه خدا برم"
    },
    {
      "id": 10,
      "start": 2565.78,
      "end": 2568.14,
      "formatted_start": "00:42:45.780",
      "formatted_end": "00:42:48.140",
      "text": "آفرین روبا"
    },
    {
      "id": 11,
      "start": 2568.14,
      "end": 2571.28,
      "formatted_start": "00:42:48.140",
      "formatted_end": "00:42:51.280",
      "text": "اما در این سفر من رو نیز با خودت ببر"
    },
    {
      "id": 12,
      "start": 2571.28,
      "end": 2574.0,
      "formatted_start": "00:42:51.280",
      "formatted_end": "00:42:54.000",
      "text": "پس زود باش بیا پایین تا برویم"
    },
    {
      "id": 13,
      "start": 2574.0,
      "end": 2596.0,
      "formatted_start": "00:42:54.000",
      "formatted_end": "00:43:16.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 2604.0,
      "end": 2605.0,
      "formatted_start": "00:43:24.000",
      "formatted_end": "00:43:25.000",
      "text": "خدا خواهد مانده؟"
    },
    {
      "id": 15,
      "start": 2605.0,
      "end": 2608.0,
      "formatted_start": "00:43:25.000",
      "formatted_end": "00:43:28.000",
      "text": "نه، بله، بله، شما با من و خود خواهد مانیم"
    },
    {
      "id": 16,
      "start": 2608.0,
      "end": 2609.0,
      "formatted_start": "00:43:28.000",
      "formatted_end": "00:43:29.000",
      "text": "بقیه بود"
    },
    {
      "id": 17,
      "start": 2609.0,
      "end": 2611.0,
      "formatted_start": "00:43:29.000",
      "formatted_end": "00:43:31.000",
      "text": "خود خوش نمونم بگیرم"
    },
    {
      "id": 18,
      "start": 2611.0,
      "end": 2613.0,
      "formatted_start": "00:43:31.000",
      "formatted_end": "00:43:33.000",
      "text": "چون بعد از اون خیلی ما"
    },
    {
      "id": 19,
      "start": 2613.0,
      "end": 2617.0,
      "formatted_start": "00:43:33.000",
      "formatted_end": "00:43:37.000",
      "text": "چرا مشکلات عجیب و ملیگ میشدیم بگیرم"
    },
    {
      "id": 20,
      "start": 2617.0,
      "end": 2620.0,
      "formatted_start": "00:43:37.000",
      "formatted_end": "00:43:40.000",
      "text": "من جاییم در واقع خود خواهد مانیم که"
    },
    {
      "id": 21,
      "start": 2620.0,
      "end": 2622.0,
      "formatted_start": "00:43:40.000",
      "formatted_end": "00:43:42.000",
      "text": "یادمه تصور کنم"
    },
    {
      "id": 22,
      "start": 2622.0,
      "end": 2625.0,
      "formatted_start": "00:43:42.000",
      "formatted_end": "00:43:45.000",
      "text": "تا زنده هم دوباره بیرون دوباره تصور کن"
    },
    {
      "id": 23,
      "start": 2625.0,
      "end": 2628.0,
      "formatted_start": "00:43:45.000",
      "formatted_end": "00:43:48.000",
      "text": "و ما برنامه سه تا جهت انتقال بودیم"
    },
    {
      "id": 24,
      "start": 2628.0,
      "end": 2630.0,
      "formatted_start": "00:43:48.000",
      "formatted_end": "00:43:50.000",
      "text": "یه بار در مورد زندگیشی"
    },
    {
      "id": 25,
      "start": 2630.0,
      "end": 2636.0,
      "formatted_start": "00:43:50.000",
      "formatted_end": "00:43:56.000",
      "text": "با ایتم کتایی رفتیم و گلویساو کردن و برخواه اومد بیرون و یه سال هم میمان ما بود"
    },
    {
      "id": 26,
      "start": 2636.0,
      "end": 2642.0,
      "formatted_start": "00:43:56.000",
      "formatted_end": "00:44:02.000",
      "text": "میمان برخواه لابوزی بود و اینو شما بعدا بهش سرزدید و این اعتبار محبولی ازش بود که رفتید"
    },
    {
      "id": 27,
      "start": 2642.0,
      "end": 2644.0,
      "formatted_start": "00:44:02.000",
      "formatted_end": "00:44:04.000",
      "text": "میگونه در اینجا با..."
    },
    {
      "id": 28,
      "start": 2649.0,
      "end": 2653.0,
      "formatted_start": "00:44:09.000",
      "formatted_end": "00:44:13.000",
      "text": "خانواده شما خانواده فبریکی نیستند"
    },
    {
      "id": 29,
      "start": 2653.0,
      "end": 2661.0,
      "formatted_start": "00:44:13.000",
      "formatted_end": "00:44:21.000",
      "text": "بسیار مقابله ایه، به مشمس بودم که با جمعی هستند، با مسئول نسل دارند، با مسئول آباده ایجاد"
    },
    {
      "id": 30,
      "start": 2661.0,
      "end": 2671.0,
      "formatted_start": "00:44:21.000",
      "formatted_end": "00:44:31.000",
      "text": "برای خیلی خوب رو خواستم داشت، یا با تنها رو بیشتر برمی که اعتیاب نداشت، چرا برای سه دو درمکی که بود از همین احساس این رو بردر کاشت"
    },
    {
      "id": 31,
      "start": 2671.0,
      "end": 2676.0,
      "formatted_start": "00:44:31.000",
      "formatted_end": "00:44:36.000",
      "text": "زمان که اتفاق باشد، با خودمش مراجع کردم"
    },
    {
      "id": 32,
      "start": 2676.0,
      "end": 2680.0,
      "formatted_start": "00:44:36.000",
      "formatted_end": "00:44:40.000",
      "text": "اونو با خودمون داست فرق از گردت کردم، رفت و زندگی"
    },
    {
      "id": 33,
      "start": 2680.0,
      "end": 2684.0,
      "formatted_start": "00:44:40.000",
      "formatted_end": "00:44:44.000",
      "text": "زن را با آدید نمارت صحبت کردم"
    },
    {
      "id": 34,
      "start": 2684.0,
      "end": 2690.0,
      "formatted_start": "00:44:44.000",
      "formatted_end": "00:44:50.000",
      "text": "و بسیار تصادف که بود که ماشینش باید بینده بود، ماه مادرم بود"
    },
    {
      "id": 35,
      "start": 2690.0,
      "end": 2695.0,
      "formatted_start": "00:44:50.000",
      "formatted_end": "00:44:55.000",
      "text": "این دو برابر، دو تصادف پشت سرمدید"
    },
    {
      "id": 36,
      "start": 2695.0,
      "end": 2700.0,
      "formatted_start": "00:44:55.000",
      "formatted_end": "00:45:00.000",
      "text": "یعنی از سحنی اول که خواهد میشه، در سحن این دو برابر ببینه"
    }
  ],
  "status": "completed"
}