  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3930.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:30.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 1,
      "start": 3930.0,
      "end": 3934.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:34.000",
      "text": "او نه اگه تفکیل کرده باشه یه لنده بسته بشه یا یه بیداری بشه"
    },
    {
      "id": 2,
      "start": 3934.0,
      "end": 3935.0,
      "formatted_start": "01:05:34.000",
      "formatted_end": "01:05:35.000",
      "text": "او خود در اینجور؟"
    },
    {
      "id": 3,
      "start": 3935.0,
      "end": 3940.0,
      "formatted_start": "01:05:35.000",
      "formatted_end": "01:05:40.000",
      "text": "نه، او خود در اینجور، یه لنده چشمش بسته بشه که کمی خود شده و صفیه باشه"
    },
    {
      "id": 4,
      "start": 3940.0,
      "end": 3943.0,
      "formatted_start": "01:05:40.000",
      "formatted_end": "01:05:43.000",
      "text": "خیلی خب اون واکسنش واکسنه، مادرش که؟"
    },
    {
      "id": 5,
      "start": 3943.0,
      "end": 3944.0,
      "formatted_start": "01:05:43.000",
      "formatted_end": "01:05:44.000",
      "text": "نمیدونی"
    },
    {
      "id": 6,
      "start": 3944.0,
      "end": 3947.0,
      "formatted_start": "01:05:44.000",
      "formatted_end": "01:05:47.000",
      "text": "واکسنش واکسنه ریاکسیون داری، ها"
    },
    {
      "id": 7,
      "start": 3947.0,
      "end": 3950.0,
      "formatted_start": "01:05:47.000",
      "formatted_end": "01:05:50.000",
      "text": "شما میگم همیشه قبل و بعد واکسن اصلا میتونی شروع کنید"
    },
    {
      "id": 8,
      "start": 3950.0,
      "end": 3961.7,
      "formatted_start": "01:05:50.000",
      "formatted_end": "01:06:01.700",
      "text": "اینجوری بیقراری و علایه میگه میگه نداره ولی سینش خوبه گلوش خوبه ارتعاب نداره ولی اگر ادرارش قرمز باشه باید آزمایش ادرار و سونیگرافی انجام بید"
    },
    {
      "id": 9,
      "start": 3961.7,
      "end": 3966.5,
      "formatted_start": "01:06:01.700",
      "formatted_end": "01:06:06.500",
      "text": "بله آقای دوستان چیزم هست دیشب کلی خفت بالا برد"
    },
    {
      "id": 10,
      "start": 3966.5,
      "end": 3968.5,
      "formatted_start": "01:06:06.500",
      "formatted_end": "01:06:08.500",
      "text": "خفت پفونی؟"
    },
    {
      "id": 11,
      "start": 3968.5,
      "end": 3970.5,
      "formatted_start": "01:06:08.500",
      "formatted_end": "01:06:10.500",
      "text": "سفید نه نه سفید نه"
    },
    {
      "id": 12,
      "start": 3970.5,
      "end": 3971.5,
      "formatted_start": "01:06:10.500",
      "formatted_end": "01:06:11.500",
      "text": "چند بار؟"
    },
    {
      "id": 13,
      "start": 3971.5,
      "end": 3973.5,
      "formatted_start": "01:06:11.500",
      "formatted_end": "01:06:13.500",
      "text": "دو بار ولی قشنگ خلتی بود"
    },
    {
      "id": 14,
      "start": 3973.5,
      "end": 3974.5,
      "formatted_start": "01:06:13.500",
      "formatted_end": "01:06:14.500",
      "text": "خلتی بود داره؟"
    },
    {
      "id": 15,
      "start": 3974.5,
      "end": 3975.5,
      "formatted_start": "01:06:14.500",
      "formatted_end": "01:06:15.500",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 3975.5,
      "end": 3976.5,
      "formatted_start": "01:06:15.500",
      "formatted_end": "01:06:16.500",
      "text": "دو دونه صرفه؟"
    },
    {
      "id": 17,
      "start": 3976.5,
      "end": 3977.5,
      "formatted_start": "01:06:16.500",
      "formatted_end": "01:06:17.500",
      "text": "دو دونه صرفه"
    },
    {
      "id": 18,
      "start": 3977.5,
      "end": 3978.5,
      "formatted_start": "01:06:17.500",
      "formatted_end": "01:06:18.500",
      "text": "خیلی"
    },
    {
      "id": 19,
      "start": 3980.0,
      "end": 3985.0,
      "formatted_start": "01:06:20.000",
      "formatted_end": "01:06:25.000",
      "text": "اون داره رو یه سطح کنن بیانی من توضیح بدم"
    },
    {
      "id": 20,
      "start": 3985.0,
      "end": 3987.0,
      "formatted_start": "01:06:25.000",
      "formatted_end": "01:06:27.000",
      "text": "آزیز جماعی سن الان داریمش میدونیم"
    },
    {
      "id": 21,
      "start": 3987.0,
      "end": 3989.0,
      "formatted_start": "01:06:27.000",
      "formatted_end": "01:06:29.000",
      "text": "آره افراد جماعی سن"
    },
    {
      "id": 22,
      "start": 3989.0,
      "end": 3994.0,
      "formatted_start": "01:06:29.000",
      "formatted_end": "01:06:34.000",
      "text": "که باز کردین جدید یا قبله؟"
    },
    {
      "id": 23,
      "start": 3994.0,
      "end": 3996.0,
      "formatted_start": "01:06:34.000",
      "formatted_end": "01:06:36.000",
      "text": "نه همین دیشب باز کردیم"
    },
    {
      "id": 24,
      "start": 3996.0,
      "end": 4000.0,
      "formatted_start": "01:06:36.000",
      "formatted_end": "01:06:40.000",
      "text": "دیشب باز کردیم خب دیگه اونجوری آزیز جماعی سن ادامه بده"
    },
    {
      "id": 25,
      "start": 4000.0,
      "end": 4002.0,
      "formatted_start": "01:06:40.000",
      "formatted_end": "01:06:42.000",
      "text": "اون تویتی شد خوبیه برای شما"
    },
    {
      "id": 26,
      "start": 4002.0,
      "end": 4006.0,
      "formatted_start": "01:06:42.000",
      "formatted_end": "01:06:46.000",
      "text": "اگه چشمش عذیب میکرد یه قطره چشمی بگیره"
    },
    {
      "id": 27,
      "start": 4006.0,
      "end": 4007.0,
      "formatted_start": "01:06:46.000",
      "formatted_end": "01:06:47.000",
      "text": "خیلی اونطوری نیسته"
    },
    {
      "id": 28,
      "start": 4007.0,
      "end": 4009.0,
      "formatted_start": "01:06:47.000",
      "formatted_end": "01:06:49.000",
      "text": "این رو هم روز اول اینجور شده"
    },
    {
      "id": 29,
      "start": 4009.0,
      "end": 4011.0,
      "formatted_start": "01:06:49.000",
      "formatted_end": "01:06:51.000",
      "text": "خواستم ببینم که این عرامش برای چیه که اینجور شده"
    },
    {
      "id": 30,
      "start": 4011.0,
      "end": 4013.0,
      "formatted_start": "01:06:51.000",
      "formatted_end": "01:06:53.000",
      "text": "این ها واکنش واکسنه"
    },
    {
      "id": 31,
      "start": 4013.0,
      "end": 4015.0,
      "formatted_start": "01:06:53.000",
      "formatted_end": "01:06:55.000",
      "text": "چون ویروس های ضعیف شده هستن واکنش داده"
    },
    {
      "id": 32,
      "start": 4015.0,
      "end": 4017.0,
      "formatted_start": "01:06:55.000",
      "formatted_end": "01:06:57.000",
      "text": "اینکه همون بیماری رو برمش داده"
    },
    {
      "id": 33,
      "start": 4017.0,
      "end": 4019.0,
      "formatted_start": "01:06:57.000",
      "formatted_end": "01:06:59.000",
      "text": "ولی خفیفترش"
    },
    {
      "id": 34,
      "start": 4019.0,
      "end": 4021.0,
      "formatted_start": "01:06:59.000",
      "formatted_end": "01:07:01.000",
      "text": "خوب"
    },
    {
      "id": 35,
      "start": 4021.0,
      "end": 4023.0,
      "formatted_start": "01:07:01.000",
      "formatted_end": "01:07:03.000",
      "text": "واکنش واکسن هست اینا"
    },
    {
      "id": 36,
      "start": 4023.0,
      "end": 4025.0,
      "formatted_start": "01:07:03.000",
      "formatted_end": "01:07:05.000",
      "text": "پس شما آزیتروماکسینه بدین"
    },
    {
      "id": 37,
      "start": 4025.0,
      "end": 4027.0,
      "formatted_start": "01:07:05.000",
      "formatted_end": "01:07:07.000",
      "text": "استامیلوپون داری؟ آره"
    },
    {
      "id": 38,
      "start": 4027.0,
      "end": 4029.0,
      "formatted_start": "01:07:07.000",
      "formatted_end": "01:07:09.000",
      "text": "استامیلوپونش داری؟"
    },
    {
      "id": 39,
      "start": 4029.0,
      "end": 4031.0,
      "formatted_start": "01:07:09.000",
      "formatted_end": "01:07:11.000",
      "text": "برده"
    },
    {
      "id": 40,
      "start": 4031.0,
      "end": 4033.0,
      "formatted_start": "01:07:11.000",
      "formatted_end": "01:07:13.000",
      "text": "بعد الان این هم با قوله جمع داره"
    },
    {
      "id": 41,
      "start": 4033.0,
      "end": 4039.0,
      "formatted_start": "01:07:13.000",
      "formatted_end": "01:07:19.000",
      "text": "دستاشو ست میده کاردید. اهورانینی دایمیتو کنید. آره این رو دادیم بشیم."
    },
    {
      "id": 42,
      "start": 4039.0,
      "end": 4044.0,
      "formatted_start": "01:07:19.000",
      "formatted_end": "01:07:24.000",
      "text": "خب این رو روز سه بار مردم بشیم بینیم. خب از تا منفرم. قطعه کلاریش این چی؟"
    },
    {
      "id": 43,
      "start": 4044.0,
      "end": 4050.0,
      "formatted_start": "01:07:24.000",
      "formatted_end": "01:07:30.000",
      "text": "نه اونو ندارم. قطعه کلاریش. چی هست آنیتون؟ قطعه مال آباد افرادتای کنفسی سرما خوردید اینا."
    },
    {
      "id": 44,
      "start": 4050.0,
      "end": 4053.0,
      "formatted_start": "01:07:30.000",
      "formatted_end": "01:07:33.000",
      "text": "برای خیلی توسط ها و همه چیز هستن"
    },
    {
      "id": 45,
      "start": 4053.0,
      "end": 4055.0,
      "formatted_start": "01:07:33.000",
      "formatted_end": "01:07:35.000",
      "text": "این قطعه از آزاده"
    },
    {
      "id": 46,
      "start": 4055.0,
      "end": 4057.0,
      "formatted_start": "01:07:35.000",
      "formatted_end": "01:07:37.000",
      "text": "خب بلیریم فقط نه آزاد میدونیم"
    },
    {
      "id": 47,
      "start": 4057.0,
      "end": 4059.0,
      "formatted_start": "01:07:37.000",
      "formatted_end": "01:07:39.000",
      "text": "اسمش چون بیرونیم"
    },
    {
      "id": 48,
      "start": 4061.0,
      "end": 4065.0,
      "formatted_start": "01:07:41.000",
      "formatted_end": "01:07:45.000",
      "text": "پس آنتیویتی که میدیم با این قطعه در آن دیگه راضی میدیم"
    },
    {
      "id": 49,
      "start": 4065.0,
      "end": 4068.0,
      "formatted_start": "01:07:45.000",
      "formatted_end": "01:07:48.000",
      "text": "نه نه باستیم شما یه معاینه کنیم نگران شده بیدیم"
    },
    {
      "id": 50,
      "start": 4068.0,
      "end": 4070.0,
      "formatted_start": "01:07:48.000",
      "formatted_end": "01:07:50.000",
      "text": "هر هشت ساعت ده قطعه"
    },
    {
      "id": 51,
      "start": 4070.0,
      "end": 4074.0,
      "formatted_start": "01:07:50.000",
      "formatted_end": "01:07:54.000",
      "text": "خانونه؟ شهبازی"
    },
    {
      "id": 52,
      "start": 4074.0,
      "end": 4077.0,
      "formatted_start": "01:07:54.000",
      "formatted_end": "01:07:57.000",
      "text": "یک علامه جدیدی بودی که اومد مراجعه"
    },
    {
      "id": 53,
      "start": 4077.0,
      "end": 4082.84,
      "formatted_start": "01:07:57.000",
      "formatted_end": "01:08:02.840",
      "text": "چون بارو دورش هم تیه بشه و چند را برخور و گره نامیشه و کم کم بینسن"
    },
    {
      "id": 54,
      "start": 4082.84,
      "end": 4086.0,
      "formatted_start": "01:08:02.840",
      "formatted_end": "01:08:06.000",
      "text": "این را براش بگیرین برای ما انتیب نمیدونید باشید"
    },
    {
      "id": 55,
      "start": 4086.0,
      "end": 4088.0,
      "formatted_start": "01:08:06.000",
      "formatted_end": "01:08:08.000",
      "text": "خوشی کنم"
    },
    {
      "id": 56,
      "start": 4093.0,
      "end": 4093.5,
      "formatted_start": "01:08:13.000",
      "formatted_end": "01:08:13.500",
      "text": "سلام"
    },
    {
      "id": 57,
      "start": 4093.5,
      "end": 4095.5,
      "formatted_start": "01:08:13.500",
      "formatted_end": "01:08:15.500",
      "text": "سلام بچه روی کنفرد بشین"
    },
    {
      "id": 58,
      "start": 4095.5,
      "end": 4097.0,
      "formatted_start": "01:08:15.500",
      "formatted_end": "01:08:17.000",
      "text": "سلام"
    },
    {
      "id": 59,
      "start": 4097.0,
      "end": 4100.5,
      "formatted_start": "01:08:17.000",
      "formatted_end": "01:08:20.500",
      "text": "سلام سلام شما خوبه مرسیمون برگیر رو بزن بدین"
    },
    {
      "id": 60,
      "start": 4100.5,
      "end": 4101.5,
      "formatted_start": "01:08:20.500",
      "formatted_end": "01:08:21.500",
      "text": "خوبه"
    },
    {
      "id": 61,
      "start": 4101.5,
      "end": 4103.5,
      "formatted_start": "01:08:21.500",
      "formatted_end": "01:08:23.500",
      "text": "چی شده خانم رای اینکول"
    },
    {
      "id": 62,
      "start": 4103.5,
      "end": 4105.0,
      "formatted_start": "01:08:23.500",
      "formatted_end": "01:08:25.000",
      "text": "خوبه"
    },
    {
      "id": 63,
      "start": 4105.0,
      "end": 4110.28,
      "formatted_start": "01:08:25.000",
      "formatted_end": "01:08:30.280",
      "text": "دیشه به دنیا هر یه روز رو به دکتر آدم دردی داره"
    },
    {
      "id": 64,
      "start": 4110.28,
      "end": 4112.64,
      "formatted_start": "01:08:30.280",
      "formatted_end": "01:08:32.640",
      "text": "هر چیز آوردید"
    },
    {
      "id": 65,
      "start": 4123.64,
      "end": 4124.84,
      "formatted_start": "01:08:43.640",
      "formatted_end": "01:08:44.840",
      "text": "که دنیا آورده؟"
    },
    {
      "id": 66,
      "start": 4124.84,
      "end": 4126.68,
      "formatted_start": "01:08:44.840",
      "formatted_end": "01:08:46.680",
      "text": "دیشه تا"
    },
    {
      "id": 67,
      "start": 4129.4,
      "end": 4130.6,
      "formatted_start": "01:08:49.400",
      "formatted_end": "01:08:50.600",
      "text": "زهر خوییست"
    },
    {
      "id": 68,
      "start": 4130.6,
      "end": 4132.4,
      "formatted_start": "01:08:50.600",
      "formatted_end": "01:08:52.400",
      "text": "متوجه شما گرم"
    },
    {
      "id": 69,
      "start": 4132.4,
      "end": 4134.4,
      "formatted_start": "01:08:52.400",
      "formatted_end": "01:08:54.400",
      "text": "خوبه، صفیده"
    },
    {
      "id": 70,
      "start": 4134.4,
      "end": 4137.4,
      "formatted_start": "01:08:54.400",
      "formatted_end": "01:08:57.400",
      "text": "مادرش چیست؟"
    },
    {
      "id": 71,
      "start": 4137.4,
      "end": 4140.4,
      "formatted_start": "01:08:57.400",
      "formatted_end": "01:09:00.400",
      "text": "خوه نیست؟ منفی نیست؟"
    },
    {
      "id": 72,
      "start": 4140.4,
      "end": 4143.4,
      "formatted_start": "01:09:00.400",
      "formatted_end": "01:09:03.400",
      "text": "بله؟"
    },
    {
      "id": 73,
      "start": 4143.4,
      "end": 4144.4,
      "formatted_start": "01:09:03.400",
      "formatted_end": "01:09:04.400",
      "text": "خوه منفیه"
    },
    {
      "id": 74,
      "start": 4144.4,
      "end": 4146.4,
      "formatted_start": "01:09:04.400",
      "formatted_end": "01:09:06.400",
      "text": "خوه منفیه؟ مخواه نیست؟"
    },
    {
      "id": 75,
      "start": 4146.4,
      "end": 4147.4,
      "formatted_start": "01:09:06.400",
      "formatted_end": "01:09:07.400",
      "text": "نه"
    },
    {
      "id": 76,
      "start": 4147.4,
      "end": 4148.4,
      "formatted_start": "01:09:07.400",
      "formatted_end": "01:09:08.400",
      "text": "تو تصمیم نیست؟"
    },
    {
      "id": 77,
      "start": 4148.4,
      "end": 4149.4,
      "formatted_start": "01:09:08.400",
      "formatted_end": "01:09:09.400",
      "text": "نه"
    },
    {
      "id": 78,
      "start": 4149.4,
      "end": 4151.4,
      "formatted_start": "01:09:09.400",
      "formatted_end": "01:09:11.400",
      "text": "مادرش باشه؟"
    },
    {
      "id": 79,
      "start": 4151.4,
      "end": 4153.4,
      "formatted_start": "01:09:11.400",
      "formatted_end": "01:09:13.400",
      "text": "نه مادرش نیست"
    },
    {
      "id": 80,
      "start": 4153.4,
      "end": 4155.4,
      "formatted_start": "01:09:13.400",
      "formatted_end": "01:09:15.400",
      "text": "مادر بچه نیست"
    },
    {
      "id": 81,
      "start": 4155.4,
      "end": 4157.4,
      "formatted_start": "01:09:15.400",
      "formatted_end": "01:09:17.400",
      "text": "این میتون؟"
    },
    {
      "id": 82,
      "start": 4157.4,
      "end": 4161.4,
      "formatted_start": "01:09:17.400",
      "formatted_end": "01:09:21.400",
      "text": "از پاس رو هم بگذرده داره خواهد از طریق بیمانه"
    },
    {
      "id": 83,
      "start": 4161.4,
      "end": 4162.4,
      "formatted_start": "01:09:21.400",
      "formatted_end": "01:09:22.400",
      "text": "آزمایش گرفتن؟"
    },
    {
      "id": 84,
      "start": 4162.4,
      "end": 4163.4,
      "formatted_start": "01:09:22.400",
      "formatted_end": "01:09:23.400",
      "text": "نه"
    },
    {
      "id": 85,
      "start": 4163.4,
      "end": 4165.4,
      "formatted_start": "01:09:23.400",
      "formatted_end": "01:09:25.400",
      "text": "کدام بیمارستان جانی آمد؟"
    },
    {
      "id": 86,
      "start": 4165.4,
      "end": 4167.4,
      "formatted_start": "01:09:25.400",
      "formatted_end": "01:09:27.400",
      "text": "شاهده هم"
    },
    {
      "id": 87,
      "start": 4167.4,
      "end": 4169.4,
      "formatted_start": "01:09:27.400",
      "formatted_end": "01:09:29.400",
      "text": "نه این ترست نیست"
    },
    {
      "id": 88,
      "start": 4169.4,
      "end": 4171.4,
      "formatted_start": "01:09:29.400",
      "formatted_end": "01:09:31.400",
      "text": "نه اون ترسته هم"
    },
    {
      "id": 89,
      "start": 4171.4,
      "end": 4173.4,
      "formatted_start": "01:09:31.400",
      "formatted_end": "01:09:33.400",
      "text": "حسن بگیر"
    },
    {
      "id": 90,
      "start": 4173.4,
      "end": 4175.4,
      "formatted_start": "01:09:33.400",
      "formatted_end": "01:09:35.400",
      "text": "حایت خامیتون رنگ کن؟"
    },
    {
      "id": 91,
      "start": 4175.4,
      "end": 4177.4,
      "formatted_start": "01:09:35.400",
      "formatted_end": "01:09:37.400",
      "text": "حالا اینو فردا قرب همین موقع بیاریم"
    },
    {
      "id": 92,
      "start": 4177.4,
      "end": 4179.4,
      "formatted_start": "01:09:37.400",
      "formatted_end": "01:09:39.400",
      "text": "من خود بینم"
    },
    {
      "id": 93,
      "start": 4179.4,
      "end": 4181.4,
      "formatted_start": "01:09:39.400",
      "formatted_end": "01:09:41.400",
      "text": "فیلن کار خواستی لازم نیست"
    },
    {
