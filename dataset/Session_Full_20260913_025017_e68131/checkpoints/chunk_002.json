  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 613.0,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:13.000",
      "text": "از اینکه چیزی که بودی باریه، برونم باشد، قبلشان کشوری رو دیرو نامده و گفت گه کشور رو بذارم، اینجا دوشت میده باشه، و گفت گوش درست بود، یه باریه رو که گفت که اونو خواهیه برسونی."
    },
    {
      "id": 1,
      "start": 613.0,
      "end": 621.0,
      "formatted_start": "00:10:13.000",
      "formatted_end": "00:10:21.000",
      "text": "گفتم این ترکتوری آخر یه سرکارش اندیان داره، واسه متصرفت باید میدونی، خانه، دیگه مردی، خواهیه باید خواهیه بیده باشه."
    },
    {
      "id": 2,
      "start": 621.0,
      "end": 626.0,
      "formatted_start": "00:10:21.000",
      "formatted_end": "00:10:26.000",
      "text": "ایه درخواه هر موزی چی ما خراب میشه. شیره گو رو اصلا بود درست کرده منواره."
    },
    {
      "id": 3,
      "start": 626.0,
      "end": 630.0,
      "formatted_start": "00:10:26.000",
      "formatted_end": "00:10:30.000",
      "text": "پکشوره رو در اینجا صلاح شده. پکشوره رو بودیم تا چرا که منواره جوش کرده."
    },
    {
      "id": 4,
      "start": 630.0,
      "end": 640.0,
      "formatted_start": "00:10:30.000",
      "formatted_end": "00:10:40.000",
      "text": "جایانم بگذارید. تکیبا تکیب زیر دشوی دو دشوی در سیمی هایی همه تکیب کنید."
    },
    {
      "id": 5,
      "start": 640.0,
      "end": 651.0,
      "formatted_start": "00:10:40.000",
      "formatted_end": "00:10:51.000",
      "text": "بازوگی به روی خواهده. آقایش هم کاملا افتاده که ساعت یاستر در دشوی افتاده. ساعت یاستر در دشوی رفته که دشوی تا ساعت یه نتر ساعت درست کنید."
    },
    {
      "id": 6,
      "start": 651.0,
      "end": 659.0,
      "formatted_start": "00:10:51.000",
      "formatted_end": "00:10:59.000",
      "text": "همینجوری در دشوی بخواهد در دشوی در دشوی تا بیرون ببرید و بردارید. هر اینجوری بچینید."
    },
    {
      "id": 7,
      "start": 659.0,
      "end": 689.0,
      "formatted_start": "00:10:59.000",
      "formatted_end": "00:11:29.000",
      "text": "اینجا باید بردارید که اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 8,
      "start": 689.0,
      "end": 694.0,
      "formatted_start": "00:11:29.000",
      "formatted_end": "00:11:34.000",
      "text": "من بگو که نفری شدم و من نفری دادم بزنم به قرآن مجیدیتان"
    },
    {
      "id": 9,
      "start": 694.0,
      "end": 700.0,
      "formatted_start": "00:11:34.000",
      "formatted_end": "00:11:40.000",
      "text": "و گفتید من فکر نکنم از من وقتی دختر با موجود داشته باشیم"
    },
    {
      "id": 10,
      "start": 700.0,
      "end": 704.0,
      "formatted_start": "00:11:40.000",
      "formatted_end": "00:11:44.000",
      "text": "از من که میگم با من در آنکه تا شاهده توی اینجا شده بزنم"
    },
    {
      "id": 11,
      "start": 704.0,
      "end": 707.0,
      "formatted_start": "00:11:44.000",
      "formatted_end": "00:11:47.000",
      "text": "خیلی چی میتونی؟"
    },
    {
      "id": 12,
      "start": 707.0,
      "end": 709.0,
      "formatted_start": "00:11:47.000",
      "formatted_end": "00:11:49.000",
      "text": "خواهی خواهی خواهی"
    },
    {
      "id": 13,
      "start": 709.0,
      "end": 711.0,
      "formatted_start": "00:11:49.000",
      "formatted_end": "00:11:51.000",
      "text": "یه های درد"
    },
    {
      "id": 14,
      "start": 711.0,
      "end": 715.0,
      "formatted_start": "00:11:51.000",
      "formatted_end": "00:11:55.000",
      "text": "اون راکت سر خواهدم بوده که دیده برارو بگو دیگه بودم اونه اولی رفتیه چی کنم کاملو بگو"
    },
    {
      "id": 15,
      "start": 715.0,
      "end": 735.0,
      "formatted_start": "00:11:55.000",
      "formatted_end": "00:12:15.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 745.0,
      "end": 769.0,
      "formatted_start": "00:12:25.000",
      "formatted_end": "00:12:49.000",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 769.0,
      "end": 799.0,
      "formatted_start": "00:12:49.000",
      "formatted_end": "00:13:19.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 18,
      "start": 799.0,
      "end": 829.0,
      "formatted_start": "00:13:19.000",
      "formatted_end": "00:13:49.000",
      "text": "از اینجا باید برداریم که اینکه باید برداریم که اینکه باید برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه برداریم که اینکه ب"
    },
    {
      "id": 19,
      "start": 829.0,
      "end": 837.0,
      "formatted_start": "00:13:49.000",
      "formatted_end": "00:13:57.000",
      "text": "بیاییم بودم، درست دورشم بیا بودن بزن، ولی بابایی هم نشست بیاییم درست خبرم بوده چه خبر چی شد، ما نخواهیم بودم"
    },
    {
      "id": 20,
      "start": 837.0,
      "end": 843.0,
      "formatted_start": "00:13:57.000",
      "formatted_end": "00:14:03.000",
      "text": "من دیگه بیدم، والا اون درده، من این سطح شد، بود گفت یه روح و پید زرد و زرد روح، بودم بوده"
    },
    {
      "id": 21,
      "start": 843.0,
      "end": 851.0,
      "formatted_start": "00:14:03.000",
      "formatted_end": "00:14:11.000",
      "text": "مرمان هفت بستر بودن، شاید هم گریه ممکنه داره، اون مسته بودن، بودم باید بودم بیایم، خدا کنم، پید آمده بودم"
    },
    {
      "id": 22,
      "start": 851.0,
      "end": 853.88,
      "formatted_start": "00:14:11.000",
      "formatted_end": "00:14:13.880",
      "text": "گوشم اینو برو یه درد و درد برو"
    },
    {
      "id": 23,
      "start": 853.88,
      "end": 861.88,
      "formatted_start": "00:14:13.880",
      "formatted_end": "00:14:21.880",
      "text": "گوش گفتن باید مردن نه، باید فرشت هم هم از خودشون کنید، باید نفتیم، باید ببینیم که اون کجایی برگرده بود."
    },
    {
      "id": 24,
      "start": 861.88,
      "end": 863.88,
      "formatted_start": "00:14:21.880",
      "formatted_end": "00:14:23.880",
      "text": "که اون کسته میشه دیگه با دلیل نمیده."
    },
    {
      "id": 25,
