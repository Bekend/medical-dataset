  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2702.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:02.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 2730.0,
      "end": 2733.0,
      "formatted_start": "00:45:30.000",
      "formatted_end": "00:45:33.000",
      "text": "اینجا میگنید که همزمان 3 تا 2 تا 4 تا"
    },
    {
      "id": 2,
      "start": 2733.0,
      "end": 2734.0,
      "formatted_start": "00:45:33.000",
      "formatted_end": "00:45:34.000",
      "text": "نه بارد نداریم"
    },
    {
      "id": 3,
      "start": 2760.0,
      "end": 2788.0,
      "formatted_start": "00:46:00.000",
      "formatted_end": "00:46:28.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 2790.0,
      "end": 2792.0,
      "formatted_start": "00:46:30.000",
      "formatted_end": "00:46:32.000",
      "text": "و بعدی من گفتم من این کار را بدونم"
    },
    {
      "id": 5,
      "start": 2794.0,
      "end": 2798.0,
      "formatted_start": "00:46:34.000",
      "formatted_end": "00:46:38.000",
      "text": "حالا مصابه ها که در این سه ساله نرد شده اون درد درنبورد"
    },
    {
      "id": 6,
      "start": 2799.0,
      "end": 2801.0,
      "formatted_start": "00:46:39.000",
      "formatted_end": "00:46:41.000",
      "text": "چون که سبستان درستند بیشتر و پینام"
    },
    {
      "id": 7,
      "start": 2801.0,
      "end": 2805.0,
      "formatted_start": "00:46:41.000",
      "formatted_end": "00:46:45.000",
      "text": "چون اون آقای اجازه و دیگران چنان سکر را بهشون عرض کردند"
    },
    {
      "id": 8,
      "start": 2805.0,
      "end": 2810.0,
      "formatted_start": "00:46:45.000",
      "formatted_end": "00:46:50.000",
      "text": "من اینجورم آقای اجازه هر کاری باشه مصابه اون را گیر آوردم"
    },
    {
      "id": 9,
      "start": 2811.0,
      "end": 2812.0,
      "formatted_start": "00:46:51.000",
      "formatted_end": "00:46:52.000",
      "text": "بله"
    },
    {
      "id": 10,
      "start": 2812.0,
      "end": 2816.0,
      "formatted_start": "00:46:52.000",
      "formatted_end": "00:46:56.000",
      "text": "اینکه شما خدمت دیگر آقایی را در اینجورم هم دیگر باشید"
    },
    {
      "id": 11,
      "start": 2816.0,
      "end": 2818.0,
      "formatted_start": "00:46:56.000",
      "formatted_end": "00:46:58.000",
      "text": "شما در مردم دیگر"
    },
    {
      "id": 12,
      "start": 2820.0,
      "end": 2823.0,
      "formatted_start": "00:47:00.000",
      "formatted_end": "00:47:03.000",
      "text": "این تیلش این بود که اگر بگفت بگفته میشود"
    },
    {
      "id": 13,
      "start": 2823.0,
      "end": 2824.0,
      "formatted_start": "00:47:03.000",
      "formatted_end": "00:47:04.000",
      "text": "بگفت نداشتید"
    },
    {
      "id": 14,
      "start": 2824.0,
      "end": 2825.0,
      "formatted_start": "00:47:04.000",
      "formatted_end": "00:47:05.000",
      "text": "رکم بود"
    },
    {
      "id": 15,
      "start": 2825.0,
      "end": 2826.0,
      "formatted_start": "00:47:05.000",
      "formatted_end": "00:47:06.000",
      "text": "رکم بود"
    },
    {
      "id": 16,
      "start": 2826.0,
      "end": 2827.0,
      "formatted_start": "00:47:06.000",
      "formatted_end": "00:47:07.000",
      "text": "یکی هم گرسته"
    },
    {
      "id": 17,
      "start": 2827.0,
      "end": 2831.0,
      "formatted_start": "00:47:07.000",
      "formatted_end": "00:47:11.000",
      "text": "مثل خود آقای خاندلیگی که همانطور که این بد بگشه"
    },
    {
      "id": 18,
      "start": 2831.0,
      "end": 2833.0,
      "formatted_start": "00:47:11.000",
      "formatted_end": "00:47:13.000",
      "text": "با آقای مهدک کرده من گفته شوید"
    },
    {
      "id": 19,
      "start": 2833.0,
      "end": 2835.0,
      "formatted_start": "00:47:13.000",
      "formatted_end": "00:47:15.000",
      "text": "خوادی شروع من با آقای مهدک کرده من از همین پاس"
    },
    {
      "id": 20,
      "start": 2835.0,
      "end": 2838.0,
      "formatted_start": "00:47:15.000",
      "formatted_end": "00:47:18.000",
      "text": "با آقای اسلام و دانشگاهی مانسون که از همین پاس برای آقای کاندلی"
    },
    {
      "id": 21,
      "start": 2838.0,
      "end": 2858.0,
      "formatted_start": "00:47:18.000",
      "formatted_end": "00:47:38.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 2858.0,
      "end": 2886.0,
      "formatted_start": "00:47:38.000",
      "formatted_end": "00:48:06.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 2888.0,
      "end": 2916.0,
      "formatted_start": "00:48:08.000",
      "formatted_end": "00:48:36.000",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 2916.0,
      "end": 2918.0,
      "formatted_start": "00:48:36.000",
      "formatted_end": "00:48:38.000",
      "text": "بیرون بیرون"
    },
    {
      "id": 25,
      "start": 2934.0,
      "end": 2936.0,
      "formatted_start": "00:48:54.000",
      "formatted_end": "00:48:56.000",
      "text": "مرحبا بیرون"
    },
    {
      "id": 26,
      "start": 2936.0,
      "end": 2938.0,
      "formatted_start": "00:48:56.000",
      "formatted_end": "00:48:58.000",
      "text": "مرحبا بیرون"
    },
    {
      "id": 27,
      "start": 2938.0,
      "end": 2940.0,
      "formatted_start": "00:48:58.000",
      "formatted_end": "00:49:00.000",
      "text": "مرحبا بیرون"
    },
    {
      "id": 28,
      "start": 2940.0,
      "end": 2942.0,
      "formatted_start": "00:49:00.000",
      "formatted_end": "00:49:02.000",
      "text": "شمید"
    },
    {
      "id": 29,
      "start": 2942.0,
      "end": 2944.0,
      "formatted_start": "00:49:02.000",
      "formatted_end": "00:49:04.000",
      "text": "چه رو برای تو بیرون کنی؟"
    },
    {
      "id": 30,
      "start": 2944.0,
      "end": 2948.0,
      "formatted_start": "00:49:04.000",
      "formatted_end": "00:49:08.000",
      "text": "دستون نرم نرم، هر خود همشه، خدا داریم"
    },
    {
      "id": 31,
      "start": 2951.0,
      "end": 2953.0,
      "formatted_start": "00:49:11.000",
      "formatted_end": "00:49:13.000",
      "text": "ما سنی پشت خطی هم دادیم"
    },
    {
      "id": 32,
      "start": 2955.0,
      "end": 2957.0,
      "formatted_start": "00:49:15.000",
      "formatted_end": "00:49:17.000",
      "text": "چه خربت اینو بیشتر"
    },
    {
      "id": 33,
      "start": 2974.0,
      "end": 2988.0,
      "formatted_start": "00:49:34.000",
      "formatted_end": "00:49:48.000",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 2988.0,
      "end": 2990.0,
      "formatted_start": "00:49:48.000",
      "formatted_end": "00:49:50.000",
      "text": "حالا سلام مستجان، خوبی؟"
    },
    {
      "id": 35,
      "start": 2990.0,
      "end": 2991.0,
      "formatted_start": "00:49:50.000",
      "formatted_end": "00:49:51.000",
      "text": "خوبی"
    },
    {
      "id": 36,
      "start": 2991.0,
      "end": 2994.0,
      "formatted_start": "00:49:51.000",
      "formatted_end": "00:49:54.000",
      "text": "خورون شما، ماشین دیدی فیلو این سه"
    },
    {
      "id": 37,
      "start": 2997.0,
      "end": 2998.0,
      "formatted_start": "00:49:57.000",
      "formatted_end": "00:49:58.000",
      "text": "خوب"
    }
  ],
