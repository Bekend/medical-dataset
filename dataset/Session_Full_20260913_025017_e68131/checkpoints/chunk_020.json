  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6002.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:02.000",
      "text": "در صد اپنه کنید، یه ستک بخشید."
    },
    {
      "id": 1,
      "start": 6002.0,
      "end": 6004.0,
      "formatted_start": "01:40:02.000",
      "formatted_end": "01:40:04.000",
      "text": "بند، دورش میگیم یا؟"
    },
    {
      "id": 2,
      "start": 6004.0,
      "end": 6006.0,
      "formatted_start": "01:40:04.000",
      "formatted_end": "01:40:06.000",
      "text": "باشیم."
    },
    {
      "id": 3,
      "start": 6006.0,
      "end": 6009.0,
      "formatted_start": "01:40:06.000",
      "formatted_end": "01:40:09.000",
      "text": "پیشم بگیره، اونو نیست. ده موتره، پیشم بچه ایشه."
    },
    {
      "id": 4,
      "start": 6009.0,
      "end": 6010.0,
      "formatted_start": "01:40:09.000",
      "formatted_end": "01:40:10.000",
      "text": "اونو ده این گریه نیست دیگه؟"
    },
    {
      "id": 5,
      "start": 6010.0,
      "end": 6012.0,
      "formatted_start": "01:40:10.000",
      "formatted_end": "01:40:12.000",
      "text": "بشه اون برد پیشم جدید."
    },
    {
      "id": 6,
      "start": 6012.0,
      "end": 6014.0,
      "formatted_start": "01:40:12.000",
      "formatted_end": "01:40:14.000",
      "text": "این بشه هرکی بوده اید؟"
    },
    {
      "id": 7,
      "start": 6014.0,
      "end": 6015.0,
      "formatted_start": "01:40:14.000",
      "formatted_end": "01:40:15.000",
      "text": "نه."
    },
    {
      "id": 8,
      "start": 6015.0,
      "end": 6016.0,
      "formatted_start": "01:40:15.000",
      "formatted_end": "01:40:16.000",
      "text": "کارت کتبه اید؟"
    },
    {
      "id": 9,
      "start": 6016.0,
      "end": 6017.0,
      "formatted_start": "01:40:16.000",
      "formatted_end": "01:40:17.000",
      "text": "نه."
    },
    {
      "id": 10,
      "start": 6017.0,
      "end": 6018.0,
      "formatted_start": "01:40:17.000",
      "formatted_end": "01:40:18.000",
      "text": "کارت هرکی بوده اید."
    },
    {
      "id": 11,
      "start": 6018.0,
      "end": 6019.0,
      "formatted_start": "01:40:18.000",
      "formatted_end": "01:40:19.000",
      "text": "بشه بوده اید."
    },
    {
      "id": 12,
      "start": 6019.0,
      "end": 6021.0,
      "formatted_start": "01:40:19.000",
      "formatted_end": "01:40:21.000",
      "text": "کارت هرکی بوده اید."
    },
    {
      "id": 13,
      "start": 6021.0,
      "end": 6022.0,
      "formatted_start": "01:40:21.000",
      "formatted_end": "01:40:22.000",
      "text": "بشه بوده اید."
    },
    {
      "id": 14,
      "start": 6022.0,
      "end": 6037.0,
      "formatted_start": "01:40:22.000",
      "formatted_end": "01:40:37.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 6037.0,
      "end": 6038.0,
      "formatted_start": "01:40:37.000",
      "formatted_end": "01:40:38.000",
      "text": "آقا دکتور"
    },
    {
      "id": 16,
      "start": 6038.0,
      "end": 6039.0,
      "formatted_start": "01:40:38.000",
      "formatted_end": "01:40:39.000",
      "text": "دیشن را دیستم؟"
    },
    {
      "id": 17,
      "start": 6039.0,
      "end": 6040.0,
      "formatted_start": "01:40:39.000",
      "formatted_end": "01:40:40.000",
      "text": "مردم"
    },
    {
      "id": 18,
      "start": 6040.0,
      "end": 6041.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:41.000",
      "text": "مردم کجایی؟"
    },
    {
      "id": 19,
      "start": 6041.0,
      "end": 6042.0,
      "formatted_start": "01:40:41.000",
      "formatted_end": "01:40:42.000",
      "text": "مردم"
    },
    {
      "id": 20,
      "start": 6042.0,
      "end": 6044.0,
      "formatted_start": "01:40:42.000",
      "formatted_end": "01:40:44.000",
      "text": "آ خیلی برم"
    },
    {
      "id": 21,
      "start": 6044.0,
      "end": 6047.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:40:47.000",
      "text": "این تنشون را بگو نمی کنیم فیضات"
    },
    {
      "id": 22,
      "start": 6047.0,
      "end": 6049.0,
      "formatted_start": "01:40:47.000",
      "formatted_end": "01:40:49.000",
      "text": "تپ نداشت"
    },
    {
      "id": 23,
      "start": 6049.0,
      "end": 6051.0,
      "formatted_start": "01:40:49.000",
      "formatted_end": "01:40:51.000",
      "text": "مابا ماهینه دستم بشه کمش بود"
    },
    {
      "id": 24,
      "start": 6051.0,
      "end": 6053.0,
      "formatted_start": "01:40:51.000",
      "formatted_end": "01:40:53.000",
      "text": "تپ نداشت"
    },
    {
      "id": 25,
      "start": 6055.0,
      "end": 6057.0,
      "formatted_start": "01:40:55.000",
      "formatted_end": "01:40:57.000",
      "text": "بیاد بابا جان"
    },
    {
      "id": 26,
      "start": 6057.0,
      "end": 6059.0,
      "formatted_start": "01:40:57.000",
      "formatted_end": "01:40:59.000",
      "text": "کار ماهینه دیگه"
    },
    {
      "id": 27,
      "start": 6059.0,
      "end": 6061.0,
      "formatted_start": "01:40:59.000",
      "formatted_end": "01:41:01.000",
      "text": "اون سر بشه های گرمه"
    },
    {
      "id": 28,
      "start": 6061.0,
      "end": 6063.0,
      "formatted_start": "01:41:01.000",
      "formatted_end": "01:41:03.000",
      "text": "بدنشون"
    },
    {
      "id": 29,
      "start": 6063.0,
      "end": 6065.0,
      "formatted_start": "01:41:03.000",
      "formatted_end": "01:41:05.000",
      "text": "نه خب"
    },
    {
      "id": 30,
      "start": 6065.0,
      "end": 6067.0,
      "formatted_start": "01:41:05.000",
      "formatted_end": "01:41:07.000",
      "text": "نیاز باشه میدونیسن"
    },
    {
      "id": 31,
      "start": 6067.0,
      "end": 6069.0,
      "formatted_start": "01:41:07.000",
      "formatted_end": "01:41:09.000",
      "text": "نه این تپ نداره"
    },
    {
      "id": 32,
      "start": 6069.0,
      "end": 6071.0,
      "formatted_start": "01:41:09.000",
      "formatted_end": "01:41:11.000",
      "text": "بدنش فنکی"
    },
    {
      "id": 33,
      "start": 6071.0,
      "end": 6073.0,
      "formatted_start": "01:41:11.000",
      "formatted_end": "01:41:13.000",
      "text": "تپ نداره"
    },
    {
      "id": 34,
      "start": 6073.0,
      "end": 6075.0,
      "formatted_start": "01:41:13.000",
      "formatted_end": "01:41:15.000",
      "text": "بی خود دارو اضافه نکنی"
    },
    {
      "id": 35,
      "start": 6077.0,
      "end": 6107.0,
      "formatted_start": "01:41:17.000",
      "formatted_end": "01:41:47.000",
