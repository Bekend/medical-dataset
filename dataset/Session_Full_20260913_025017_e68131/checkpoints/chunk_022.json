  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6615.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:15.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6660.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:51:00.000",
      "text": "باید بردارید که اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 2,
      "start": 6660.0,
      "end": 6690.0,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:30.000",
      "text": "اینجا باید بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید که بردارید ک"
    },
    {
      "id": 3,
      "start": 6690.0,
      "end": 6719.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:59.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 6720.0,
      "end": 6740.0,
      "formatted_start": "01:52:00.000",
      "formatted_end": "01:52:20.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 6740.0,
      "end": 6758.0,
      "formatted_start": "01:52:20.000",
      "formatted_end": "01:52:38.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 6758.0,
      "end": 6764.0,
      "formatted_start": "01:52:38.000",
      "formatted_end": "01:52:44.000",
      "text": "بله، شاپ، دیگم که این استایی چطور بود نسبت به تیروزی؟"
    },
    {
      "id": 7,
      "start": 6771.0,
      "end": 6773.0,
      "formatted_start": "01:52:51.000",
      "formatted_end": "01:52:53.000",
      "text": "تیروزی پیشتر میدونست؟"
    },
    {
      "id": 8,
      "start": 6788.0,
      "end": 6793.16,
      "formatted_start": "01:53:08.000",
      "formatted_end": "01:53:13.160",
      "text": "خب، هران به نظر تو این تشکیل کدامی که درست بود؟"
    },
    {
      "id": 9,
      "start": 6793.16,
      "end": 6796.16,
      "formatted_start": "01:53:13.160",
      "formatted_end": "01:53:16.160",
      "text": "این فنه هران دست می زد واقعا فنه؟"
    },
    {
      "id": 10,
      "start": 6796.16,
      "end": 6806.16,
      "formatted_start": "01:53:16.160",
      "formatted_end": "01:53:26.160",
      "text": "خوب"
    },
    {
      "id": 11,
      "start": 6806.16,
      "end": 6821.16,
      "formatted_start": "01:53:26.160",
      "formatted_end": "01:53:41.160",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 6821.16,
      "end": 6825.16,
      "formatted_start": "01:53:41.160",
      "formatted_end": "01:53:45.160",
      "text": "من فن دوازدگرد رو سپارش دادم اینا"
    },
    {
      "id": 13,
      "start": 6825.16,
      "end": 6829.16,
      "formatted_start": "01:53:45.160",
      "formatted_end": "01:53:49.160",
      "text": "از تهران"
    },
    {
      "id": 14,
      "start": 6829.16,
      "end": 6833.16,
      "formatted_start": "01:53:49.160",
      "formatted_end": "01:53:53.160",
      "text": "همون کاله، همون جنس کاله که سیزده و نیمتر زده بود"
    },
    {
      "id": 15,
      "start": 6833.16,
      "end": 6837.16,
      "formatted_start": "01:53:53.160",
      "formatted_end": "01:53:57.160",
      "text": "من دوازدگرد. ببین دست میزد که فن رو حرکت میکرد"
    },
    {
      "id": 16,
      "start": 6841.16,
      "end": 6845.16,
      "formatted_start": "01:54:01.160",
      "formatted_end": "01:54:05.160",
      "text": "فن رو"
    },
    {
      "id": 17,
      "start": 6845.16,
      "end": 6849.16,
      "formatted_start": "01:54:05.160",
      "formatted_end": "01:54:09.160",
      "text": "میشه"
    },
    {
      "id": 18,
      "start": 6849.16,
      "end": 6852.16,
      "formatted_start": "01:54:09.160",
      "formatted_end": "01:54:12.160",
      "text": "این فن هست در درشته بگیره بسیار"
    },
    {
      "id": 19,
      "start": 6852.16,
      "end": 6855.16,
      "formatted_start": "01:54:12.160",
      "formatted_end": "01:54:15.160",
      "text": "برای خود"
    },
    {
      "id": 20,
      "start": 6855.16,
      "end": 6858.16,
      "formatted_start": "01:54:15.160",
      "formatted_end": "01:54:18.160",
      "text": "خوب الان بذاریم"
    },
    {
      "id": 21,
      "start": 6858.16,
      "end": 6861.16,
      "formatted_start": "01:54:18.160",
      "formatted_end": "01:54:21.160",
      "text": "باشه خواه نداریم"
    },
    {
      "id": 22,
      "start": 6861.16,
      "end": 6864.16,
      "formatted_start": "01:54:21.160",
      "formatted_end": "01:54:24.160",
      "text": "نیسته خواه نداریم"
    },
    {
      "id": 23,
      "start": 6864.16,
      "end": 6866.16,
      "formatted_start": "01:54:24.160",
      "formatted_end": "01:54:26.160",
      "text": "دفعه نداریم"
    },
    {
      "id": 24,
      "start": 6866.16,
      "end": 6869.16,
      "formatted_start": "01:54:26.160",
      "formatted_end": "01:54:29.160",
      "text": "آماده تو شربت الارژی نیست داشتن؟"
    },
    {
      "id": 25,
      "start": 6869.16,
      "end": 6871.16,
      "formatted_start": "01:54:29.160",
      "formatted_end": "01:54:31.160",
      "text": "اشکال نداریم"
    },
    {
      "id": 26,
      "start": 6871.16,
      "end": 6872.16,
      "formatted_start": "01:54:31.160",
      "formatted_end": "01:54:32.160",
      "text": "افتاده گرفتی؟"
    },
    {
      "id": 27,
      "start": 6872.16,
      "end": 6874.16,
      "formatted_start": "01:54:32.160",
      "formatted_end": "01:54:34.160",
      "text": "اشکال نداریم خیلی هم خوبه"
    },
    {
      "id": 28,
      "start": 6874.16,
      "end": 6875.16,
      "formatted_start": "01:54:34.160",
      "formatted_end": "01:54:35.160",
      "text": "این شربت رو استفاده میشه"
    },
    {
      "id": 29,
      "start": 6875.16,
      "end": 6877.16,
      "formatted_start": "01:54:35.160",
      "formatted_end": "01:54:37.160",
      "text": "شربت یک قطره نیست"
    },
    {
      "id": 30,
      "start": 6877.16,
      "end": 6879.16,
      "formatted_start": "01:54:37.160",
      "formatted_end": "01:54:39.160",
      "text": "اشکال ندارده تو این سن هم قبل تبتید"
    },
    {
      "id": 31,
      "start": 6879.16,
      "end": 6881.16,
      "formatted_start": "01:54:39.160",
      "formatted_end": "01:54:41.160",
      "text": "نه نه"
    },
    {
      "id": 32,
      "start": 6881.16,
      "end": 6883.16,
      "formatted_start": "01:54:41.160",
      "formatted_end": "01:54:43.160",
      "text": "این هم به خاطر جیرها شیست؟"
    },
    {
      "id": 33,
      "start": 6883.16,
      "end": 6885.16,
      "formatted_start": "01:54:43.160",
      "formatted_end": "01:54:45.160",
      "text": "نه نه"
    },
    {
      "id": 34,
      "start": 6885.16,
      "end": 6887.16,
      "formatted_start": "01:54:45.160",
      "formatted_end": "01:54:47.160",
      "text": "نه اون جیر که دیگه سربخوردگی نمیشه"
    },
    {
      "id": 35,
      "start": 6887.16,
      "end": 6889.16,
      "formatted_start": "01:54:47.160",
      "formatted_end": "01:54:49.160",
      "text": "نه نه"
    },
    {
      "id": 36,
      "start": 6889.16,
      "end": 6891.16,
      "formatted_start": "01:54:49.160",
      "formatted_end": "01:54:51.160",
      "text": "نه نه"
    },
    {
      "id": 37,
      "start": 6891.16,
