      "end": 4589.98,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:29.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 3,
      "start": 4590.0,
      "end": 4602.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:42.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "الو"
    },
    {
      "id": 5,
      "start": 4604.0,
      "end": 4608.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:48.000",
      "text": "شاپ بگیر استارتشون داره بگیر مترفن هست"
    },
    {
      "id": 6,
      "start": 4608.0,
      "end": 4613.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:16:53.000",
      "text": "بگیر همینه همین میخواد همین مدلف"
    },
    {
      "id": 7,
      "start": 4613.0,
      "end": 4617.0,
      "formatted_start": "01:16:53.000",
      "formatted_end": "01:16:57.000",
      "text": "خب اینه 15 تومن"
    },
    {
      "id": 8,
      "start": 4617.0,
      "end": 4622.0,
      "formatted_start": "01:16:57.000",
      "formatted_end": "01:17:02.000",
      "text": "خب همه عدود داره"
    },
    {
      "id": 9,
      "start": 4622.0,
      "end": 4626.0,
      "formatted_start": "01:17:02.000",
      "formatted_end": "01:17:06.000",
      "text": "خب"
    },
    {
      "id": 10,
      "start": 4626.0,
      "end": 4628.0,
      "formatted_start": "01:17:06.000",
      "formatted_end": "01:17:08.000",
      "text": "ببینید که این مطرفان کار می کنه یا نه؟"
    },
    {
      "id": 11,
      "start": 4628.0,
      "end": 4630.0,
      "formatted_start": "01:17:08.000",
      "formatted_end": "01:17:10.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 12,
      "start": 4630.0,
      "end": 4632.0,
      "formatted_start": "01:17:10.000",
      "formatted_end": "01:17:12.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 13,
      "start": 4632.0,
      "end": 4634.0,
      "formatted_start": "01:17:12.000",
      "formatted_end": "01:17:14.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 14,
      "start": 4634.0,
      "end": 4636.0,
      "formatted_start": "01:17:14.000",
      "formatted_end": "01:17:16.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 15,
      "start": 4636.0,
      "end": 4638.0,
      "formatted_start": "01:17:16.000",
      "formatted_end": "01:17:18.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 16,
      "start": 4638.0,
      "end": 4640.0,
      "formatted_start": "01:17:18.000",
      "formatted_end": "01:17:20.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 17,
      "start": 4640.0,
      "end": 4642.0,
      "formatted_start": "01:17:20.000",
      "formatted_end": "01:17:22.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 18,
      "start": 4642.0,
      "end": 4644.0,
      "formatted_start": "01:17:22.000",
      "formatted_end": "01:17:24.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 19,
      "start": 4644.0,
      "end": 4646.0,
      "formatted_start": "01:17:24.000",
      "formatted_end": "01:17:26.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 20,
      "start": 4646.0,
      "end": 4648.0,
      "formatted_start": "01:17:26.000",
      "formatted_end": "01:17:28.000",
      "text": "این همینی کار می کنه یا نه؟"
    },
    {
      "id": 21,
      "start": 4648.0,
      "end": 4650.0,
      "formatted_start": "01:17:28.000",
      "formatted_end": "01:17:30.000",
      "text": "چیه؟ تقعیه"
    },
    {
      "id": 22,
      "start": 4650.0,
      "end": 4653.0,
      "formatted_start": "01:17:30.000",
      "formatted_end": "01:17:33.000",
      "text": "همه میگه کار می کنه این موتور فند یا نه؟"
    },
    {
      "id": 23,
      "start": 4653.0,
      "end": 4655.0,
      "formatted_start": "01:17:33.000",
      "formatted_end": "01:17:35.000",
      "text": "اینی"
    },
    {
      "id": 24,
      "start": 4655.0,
      "end": 4657.0,
      "formatted_start": "01:17:35.000",
      "formatted_end": "01:17:37.000",
      "text": "موتور فند هسته؟"
    },
    {
      "id": 25,
      "start": 4657.0,
      "end": 4661.0,
      "formatted_start": "01:17:37.000",
      "formatted_end": "01:17:41.000",
      "text": "خب ببین اگر مطمئنه خب ما بگیریم"
    },
    {
      "id": 26,
      "start": 4661.0,
      "end": 4664.0,
      "formatted_start": "01:17:41.000",
      "formatted_end": "01:17:44.000",
      "text": "چون باید نگه ۵۵۰ بگیریم بگیریم نه بگیر"
    },
    {
      "id": 27,
      "start": 4664.0,
      "end": 4670.0,
      "formatted_start": "01:17:44.000",
      "formatted_end": "01:17:50.000",
      "text": "نه نه من به خیله هم نزد کنم موتور کار می کنه؟"
    },
    {
      "id": 28,
      "start": 4670.0,
      "end": 4672.0,
      "formatted_start": "01:17:50.000",
      "formatted_end": "01:17:52.000",
      "text": "اینی مثلا فند"
    },
    {
      "id": 29,
      "start": 4672.0,
      "end": 4675.0,
      "formatted_start": "01:17:52.000",
      "formatted_end": "01:17:55.000",
      "text": "فند کار می کنه؟"
    },
    {
      "id": 30,
      "start": 4675.0,
      "end": 4679.0,
      "formatted_start": "01:17:55.000",
      "formatted_end": "01:17:59.000",
      "text": "یعنی مترفان مشکل داره؟"
    },
    {
      "id": 31,
      "start": 4679.0,
      "end": 4686.0,
      "formatted_start": "01:17:59.000",
      "formatted_end": "01:18:06.000",
      "text": "نه، با دست میشه اکنونید هاره"
    },
    {
      "id": 32,
      "start": 4686.0,
      "end": 4697.0,
      "formatted_start": "01:18:06.000",
      "formatted_end": "01:18:17.000",
      "text": "به زغاله، هره شاید ایران تا سیمی چیز کتابت داره، احتسان کنید درست بشید"
    },
    {
      "id": 33,
      "start": 4697.0,
      "end": 4713.86,
      "formatted_start": "01:18:17.000",
      "formatted_end": "01:18:33.860",
      "text": "خیلی خوب باشه"
    },
    {
      "id": 34,
      "start": 4713.86,
      "end": 4716.4,
      "formatted_start": "01:18:33.860",
      "formatted_end": "01:18:36.400",
      "text": "این بهتری امالون هستانی"
    },
    {
      "id": 35,
      "start": 4727.0,
      "end": 4732.52,
      "formatted_start": "01:18:47.000",
      "formatted_end": "01:18:52.520",
      "text": "خواهید بخواهید باشید"
    },
    {
      "id": 36,
      "start": 4732.52,
      "end": 4736.46,
      "formatted_start": "01:18:52.520",
      "formatted_end": "01:18:56.460",
      "text": "باشه باشید باشید باشید"
    },
    {
      "id": 37,
      "start": 4736.46,
      "end": 4737.06,
      "formatted_start": "01:18:56.460",
      "formatted_end": "01:18:57.060",
      "text": "خداحسن"
    },
    {
      "id": 38,
      "start": 4757.0,
      "end": 4787.0,
      "formatted_start": "01:19:17.000",
      "formatted_end": "01:19:47.000",
