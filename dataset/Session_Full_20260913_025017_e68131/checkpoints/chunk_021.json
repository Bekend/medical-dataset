  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6304.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:04.000",
      "text": "بخواهیم، سلامت شما."
    },
    {
      "id": 1,
      "start": 6304.0,
      "end": 6305.0,
      "formatted_start": "01:45:04.000",
      "formatted_end": "01:45:05.000",
      "text": "مرسی."
    },
    {
      "id": 2,
      "start": 6305.0,
      "end": 6307.0,
      "formatted_start": "01:45:05.000",
      "formatted_end": "01:45:07.000",
      "text": "اون مفرمان خود چی شده؟"
    },
    {
      "id": 3,
      "start": 6307.0,
      "end": 6311.0,
      "formatted_start": "01:45:07.000",
      "formatted_end": "01:45:11.000",
      "text": "آقایی خیلی خوبی بودم، اشتر روز طب داشت، بعد سرکرسی بدنش میوزه."
    },
    {
      "id": 4,
      "start": 6311.0,
      "end": 6312.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:12.000",
      "text": "بله بله."
    },
    {
      "id": 5,
      "start": 6312.0,
      "end": 6314.0,
      "formatted_start": "01:45:12.000",
      "formatted_end": "01:45:14.000",
      "text": "بعد از اون خوب شد، خیلی خوب شد."
    },
    {
      "id": 6,
      "start": 6314.0,
      "end": 6316.0,
      "formatted_start": "01:45:14.000",
      "formatted_end": "01:45:16.000",
      "text": "رونه ریخ بعدش؟"
    },
    {
      "id": 7,
      "start": 6316.0,
      "end": 6317.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:17.000",
      "text": "دیگه خوب شد."
    },
    {
      "id": 8,
      "start": 6317.0,
      "end": 6318.0,
      "formatted_start": "01:45:17.000",
      "formatted_end": "01:45:18.000",
      "text": "رونه ریخ؟"
    },
    {
      "id": 9,
      "start": 6318.0,
      "end": 6319.0,
      "formatted_start": "01:45:18.000",
      "formatted_end": "01:45:19.000",
      "text": "آره."
    },
    {
      "id": 10,
      "start": 6319.0,
      "end": 6321.0,
      "formatted_start": "01:45:19.000",
      "formatted_end": "01:45:21.000",
      "text": "آقا صرفه می کنه."
    },
    {
      "id": 11,
      "start": 6321.0,
      "end": 6322.0,
      "formatted_start": "01:45:21.000",
      "formatted_end": "01:45:22.000",
      "text": "صرفه؟"
    },
    {
      "id": 12,
      "start": 6322.0,
      "end": 6323.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:23.000",
      "text": "بعد صبح که از کار بیدار می شه."
    },
    {
      "id": 13,
      "start": 6323.0,
      "end": 6324.0,
      "formatted_start": "01:45:23.000",
      "formatted_end": "01:45:24.000",
      "text": "صرفه داره؟"
    },
    {
      "id": 14,
      "start": 6324.0,
      "end": 6325.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:25.000",
      "text": "آره."
    },
    {
      "id": 15,
      "start": 6325.0,
      "end": 6326.0,
      "formatted_start": "01:45:25.000",
      "formatted_end": "01:45:26.000",
      "text": "آب دیزهش؟"
    },
    {
      "id": 16,
      "start": 6326.0,
      "end": 6328.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:28.000",
      "text": "خسخس سینه؟"
    },
    {
      "id": 17,
      "start": 6328.0,
      "end": 6330.0,
      "formatted_start": "01:45:28.000",
      "formatted_end": "01:45:30.000",
      "text": "خسخس نه، در واقع صوفه چیزیه"
    },
    {
      "id": 18,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "خلتیه؟"
    },
    {
      "id": 19,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "خروسکیه؟"
    },
    {
      "id": 20,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "من چی خروسکی شدم؟"
    },
    {
      "id": 21,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "خروسکی خیلی کلوفه"
    },
    {
      "id": 22,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "خلتی از این صوفه خواسته"
    },
    {
      "id": 23,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "در حدی صوفه ما قرمز میشه"
    },
    {
      "id": 24,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "نه اون اشباه نداره"
    },
    {
      "id": 25,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "نیست اگه خروسکی میگو"
    },
    {
      "id": 26,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "باقی جی میشه"
    },
    {
      "id": 27,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "این صوفه های خلتی داره"
    },
    {
      "id": 28,
      "start": 6350.0,
      "end": 6352.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:52.000",
      "text": "آبیزش داره"
    },
    {
      "id": 29,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "شاید سینه شما یکم خسخس بوده"
    },
    {
      "id": 30,
      "start": 6354.0,
      "end": 6358.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:58.000",
      "text": "این طبای خفیف ایشاد بی حال شده ای آفرین"
    },
    {
      "id": 31,
      "start": 6358.0,
      "end": 6361.0,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:01.000",
      "text": "ببینیم تفضیلی باز"
    },
    {
      "id": 32,
      "start": 6365.0,
      "end": 6366.0,
      "formatted_start": "01:46:05.000",
      "formatted_end": "01:46:06.000",
      "text": "خوب"
    },
    {
      "id": 33,
      "start": 6366.0,
      "end": 6369.0,
      "formatted_start": "01:46:06.000",
      "formatted_end": "01:46:09.000",
      "text": "زده پیزه ری کنیم ببینیم"
    },
    {
      "id": 34,
      "start": 6369.0,
      "end": 6371.0,
      "formatted_start": "01:46:09.000",
      "formatted_end": "01:46:11.000",
      "text": "ببینیم"
    },
    {
      "id": 35,
      "start": 6371.0,
      "end": 6373.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:13.000",
      "text": "ببینیم ببینیم کجا موند"
    },
    {
      "id": 36,
      "start": 6373.0,
      "end": 6376.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:16.000",
      "text": "بخواب اونو بزنن؟"
    },
    {
      "id": 37,
      "start": 6376.0,
      "end": 6377.0,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:17.000",
      "text": "بیا بیا بزن"
    },
    {
      "id": 38,
      "start": 6377.0,
      "end": 6378.0,
      "formatted_start": "01:46:17.000",
      "formatted_end": "01:46:18.000",
      "text": "سرشون موازه باشه؟"
    },
    {
      "id": 39,
      "start": 6378.0,
      "end": 6380.0,
      "formatted_start": "01:46:18.000",
      "formatted_end": "01:46:20.000",
      "text": "سرشون موازه باشه"
    },
    {
      "id": 40,
      "start": 6380.0,
      "end": 6381.0,
      "formatted_start": "01:46:20.000",
      "formatted_end": "01:46:21.000",
      "text": "خیلی موازه شده"
    },
    {
      "id": 41,
      "start": 6381.0,
      "end": 6383.0,
      "formatted_start": "01:46:21.000",
      "formatted_end": "01:46:23.000",
      "text": "دستا شنگرده؟"
    },
    {
      "id": 42,
      "start": 6383.0,
      "end": 6385.0,
      "formatted_start": "01:46:23.000",
      "formatted_end": "01:46:25.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 43,
      "start": 6385.0,
      "end": 6387.0,
      "formatted_start": "01:46:25.000",
      "formatted_end": "01:46:27.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 44,
      "start": 6387.0,
      "end": 6389.0,
      "formatted_start": "01:46:27.000",
      "formatted_end": "01:46:29.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 45,
      "start": 6389.0,
      "end": 6391.0,
      "formatted_start": "01:46:29.000",
      "formatted_end": "01:46:31.000",
