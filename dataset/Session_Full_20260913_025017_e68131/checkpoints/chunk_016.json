  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4802.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:02.000",
      "text": "بله شما آخرین قیمتتون بر..."
    },
    {
      "id": 1,
      "start": 4814.0,
      "end": 4818.0,
      "formatted_start": "01:20:14.000",
      "formatted_end": "01:20:18.000",
      "text": "باشه من الان میگم سآل کنه پسرم ببینم همین کار."
    },
    {
      "id": 2,
      "start": 4820.0,
      "end": 4822.0,
      "formatted_start": "01:20:20.000",
      "formatted_end": "01:20:22.000",
      "text": "شما تا چقدر میتونین پایین بدید؟"
    },
    {
      "id": 3,
      "start": 4824.0,
      "end": 4826.0,
      "formatted_start": "01:20:24.000",
      "formatted_end": "01:20:26.000",
      "text": "الان من سآل کنه پسرم دقیق تر."
    },
    {
      "id": 4,
      "start": 4826.0,
      "end": 4828.0,
      "formatted_start": "01:20:26.000",
      "formatted_end": "01:20:28.000",
      "text": "باشه، خداحافظ."
    },
    {
      "id": 5,
      "start": 4830.0,
      "end": 4832.0,
      "formatted_start": "01:20:30.000",
      "formatted_end": "01:20:32.000",
      "text": "خانسنی بگیر"
    },
    {
      "id": 6,
      "start": 4832.0,
      "end": 4834.0,
      "formatted_start": "01:20:32.000",
      "formatted_end": "01:20:34.000",
      "text": "نه"
    },
    {
      "id": 7,
      "start": 4838.0,
      "end": 4840.0,
      "formatted_start": "01:20:38.000",
      "formatted_end": "01:20:40.000",
      "text": "خوش خوش"
    },
    {
      "id": 8,
      "start": 4840.0,
      "end": 4842.0,
      "formatted_start": "01:20:40.000",
      "formatted_end": "01:20:42.000",
      "text": "سلامه مولی"
    },
    {
      "id": 9,
      "start": 4842.0,
      "end": 4844.0,
      "formatted_start": "01:20:42.000",
      "formatted_end": "01:20:44.000",
      "text": "تشید خانم برقصد شان"
    },
    {
      "id": 10,
      "start": 4844.0,
      "end": 4846.0,
      "formatted_start": "01:20:44.000",
      "formatted_end": "01:20:46.000",
      "text": "زندگی سخته ده"
    },
    {
      "id": 11,
      "start": 4846.0,
      "end": 4848.0,
      "formatted_start": "01:20:46.000",
      "formatted_end": "01:20:48.000",
      "text": "چه شده؟"
    },
    {
      "id": 12,
      "start": 4848.0,
      "end": 4850.0,
      "formatted_start": "01:20:48.000",
      "formatted_end": "01:20:50.000",
      "text": "آیل افا یه هفته پید"
    },
    {
      "id": 13,
      "start": 4850.0,
      "end": 4852.0,
      "formatted_start": "01:20:50.000",
      "formatted_end": "01:20:52.000",
      "text": "من مرشد رو بروز گرفته"
    },
    {
      "id": 14,
      "start": 4852.0,
      "end": 4854.0,
      "formatted_start": "01:20:52.000",
      "formatted_end": "01:20:54.000",
      "text": "بعد دو تا پشتون بهش دادم"
    },
    {
      "id": 15,
      "start": 4854.0,
      "end": 4856.0,
      "formatted_start": "01:20:54.000",
      "formatted_end": "01:20:56.000",
      "text": "بعد خوب نشده"
    },
    {
      "id": 16,
      "start": 4856.0,
      "end": 4858.0,
      "formatted_start": "01:20:56.000",
      "formatted_end": "01:20:58.000",
      "text": "بعد خیلی سخته"
    },
    {
      "id": 17,
      "start": 4858.0,
      "end": 4859.0,
      "formatted_start": "01:20:58.000",
      "formatted_end": "01:20:59.000",
      "text": "باسن نشینه ها؟"
    },
    {
      "id": 18,
      "start": 4859.0,
      "end": 4860.0,
      "formatted_start": "01:20:59.000",
      "formatted_end": "01:21:00.000",
      "text": "نه، جلو ها"
    },
    {
      "id": 19,
      "start": 4860.0,
      "end": 4862.0,
      "formatted_start": "01:21:00.000",
      "formatted_end": "01:21:02.000",
      "text": "من باسن نخواهد، من جلو و عقب"
    },
    {
      "id": 20,
      "start": 4862.0,
      "end": 4864.0,
      "formatted_start": "01:21:02.000",
      "formatted_end": "01:21:04.000",
      "text": "از اصحال هم زیاد میرم"
    },
    {
      "id": 21,
      "start": 4864.0,
      "end": 4866.0,
      "formatted_start": "01:21:04.000",
      "formatted_end": "01:21:06.000",
      "text": "هرنگ اصحال هم هسته؟"
    },
    {
      "id": 22,
      "start": 4866.0,
      "end": 4868.0,
      "formatted_start": "01:21:06.000",
      "formatted_end": "01:21:08.000",
      "text": "آره، هرنگ چون میفرد اصحال میره"
    },
    {
      "id": 23,
      "start": 4868.0,
      "end": 4870.0,
      "formatted_start": "01:21:08.000",
      "formatted_end": "01:21:10.000",
      "text": "از صبح تا الان چند بار اصحال بوده؟"
    },
    {
      "id": 24,
      "start": 4870.0,
      "end": 4872.0,
      "formatted_start": "01:21:10.000",
      "formatted_end": "01:21:12.000",
      "text": "هر دفعه شیر میخوره"
    },
    {
      "id": 25,
      "start": 4872.0,
      "end": 4874.0,
      "formatted_start": "01:21:12.000",
      "formatted_end": "01:21:14.000",
      "text": "یعنی چند بار، پنج بار، ده بار؟"
    },
    {
      "id": 26,
      "start": 4874.0,
      "end": 4875.0,
      "formatted_start": "01:21:14.000",
      "formatted_end": "01:21:15.000",
      "text": "مثلاً حدود؟"
    },
    {
      "id": 27,
      "start": 4875.0,
      "end": 4876.0,
      "formatted_start": "01:21:15.000",
      "formatted_end": "01:21:16.000",
      "text": "آره دیگه همه بار"
    },
    {
      "id": 28,
      "start": 4876.0,
      "end": 4877.0,
      "formatted_start": "01:21:16.000",
      "formatted_end": "01:21:17.000",
      "text": "ده بار؟"
    },
    {
      "id": 29,
      "start": 4877.0,
      "end": 4878.0,
      "formatted_start": "01:21:17.000",
      "formatted_end": "01:21:18.000",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 4878.0,
      "end": 4881.0,
      "formatted_start": "01:21:18.000",
      "formatted_end": "01:21:21.000",
      "text": "زندگاه چون اصحال اصحالیه، میسوزونه"
    },
    {
      "id": 31,
      "start": 4881.0,
      "end": 4882.0,
      "formatted_start": "01:21:21.000",
      "formatted_end": "01:21:22.000",
      "text": "آره"
    },
    {
      "id": 32,
      "start": 4882.0,
      "end": 4884.82,
      "formatted_start": "01:21:22.000",
      "formatted_end": "01:21:24.820",
      "text": "دختر یکی دیگه من دو سال رو منو هم می‌بینی شده"
    },
    {
      "id": 33,
      "start": 4884.82,
      "end": 4885.82,
      "formatted_start": "01:21:24.820",
      "formatted_end": "01:21:25.820",
      "text": "بله"
    },
    {
      "id": 34,
      "start": 4885.82,
      "end": 4887.32,
      "formatted_start": "01:21:25.820",
      "formatted_end": "01:21:27.320",
      "text": "این شیر می‌خوره؟"
    },
    {
      "id": 35,
      "start": 4887.32,
      "end": 4888.12,
      "formatted_start": "01:21:27.320",
      "formatted_end": "01:21:28.120",
      "text": "آره شیر خوش"
    },
    {
      "id": 36,
      "start": 4888.12,
      "end": 4889.5,
      "formatted_start": "01:21:28.120",
      "formatted_end": "01:21:29.500",
      "text": "الان چند ساله؟"
    },
    {
      "id": 37,
      "start": 4889.5,
      "end": 4890.32,
      "formatted_start": "01:21:29.500",
      "formatted_end": "01:21:30.320",
      "text": "یه می‌رم"
    },
    {
      "id": 38,
      "start": 4890.32,
      "end": 4893.32,
      "formatted_start": "01:21:30.320",
      "formatted_end": "01:21:33.320",
      "text": "هیلی بکی می‌شده"
    },
    {
      "id": 39,
      "start": 4893.32,
      "end": 4894.32,
      "formatted_start": "01:21:33.320",
      "formatted_end": "01:21:34.320",
      "text": "آره"
    },
    {
      "id": 40,
      "start": 4896.82,
      "end": 4898.9,
      "formatted_start": "01:21:36.820",
      "formatted_end": "01:21:38.900",
      "text": "حتی قارچی هم شده، اینو بزنید"
    },
    {
      "id": 41,
      "start": 4898.9,
      "end": 4900.82,
      "formatted_start": "01:21:38.900",
      "formatted_end": "01:21:40.820",
      "text": "حتی قارچی هم شده"
    },
    {
      "id": 42,
      "start": 4900.82,
      "end": 4903.82,
      "formatted_start": "01:21:40.820",
      "formatted_end": "01:21:43.820",
      "text": "ماماد ماماد، مثلا اگه این رسید زدی ما خوب نداریم"
    },
    {
      "id": 43,
      "start": 4903.82,
      "end": 4904.82,
      "formatted_start": "01:21:43.820",
      "formatted_end": "01:21:44.820",
      "text": "ماماد چی زدی؟"
    },
    {
      "id": 44,
      "start": 4904.82,
      "end": 4905.82,
      "formatted_start": "01:21:44.820",
      "formatted_end": "01:21:45.820",
      "text": "آره"
    },
    {
      "id": 45,
      "start": 4905.82,
      "end": 4906.82,
      "formatted_start": "01:21:45.820",
      "formatted_end": "01:21:46.820",
      "text": "اینو بزنید"
    },
    {
      "id": 46,
      "start": 4906.82,
      "end": 4907.82,
      "formatted_start": "01:21:46.820",
      "formatted_end": "01:21:47.820",
      "text": "کاراندولا؟"
    },
    {
      "id": 47,
      "start": 4907.82,
      "end": 4908.82,
      "formatted_start": "01:21:47.820",
      "formatted_end": "01:21:48.820",
      "text": "کاراندولا؟"
    },
    {
      "id": 48,
      "start": 4908.82,
      "end": 4909.82,
      "formatted_start": "01:21:48.820",
      "formatted_end": "01:21:49.820",
      "text": "کاراندولا؟"
    },
    {
      "id": 49,
      "start": 4909.82,
      "end": 4913.98,
      "formatted_start": "01:21:49.820",
      "formatted_end": "01:21:53.980",
      "text": "خراندولا؟ نه این ها جواب نمیده"
    },
    {
      "id": 50,
      "start": 4913.98,
      "end": 4919.06,
      "formatted_start": "01:21:53.980",
      "formatted_end": "01:21:59.060",
      "text": "خب شما سابون پن اطفال بگیرید"
    },
    {
      "id": 51,
      "start": 4919.06,
      "end": 4921.34,
      "formatted_start": "01:21:59.060",
      "formatted_end": "01:22:01.340",
      "text": "این یکی"
    },
    {
      "id": 52,
      "start": 4921.34,
      "end": 4926.1,
      "formatted_start": "01:22:01.340",
      "formatted_end": "01:22:06.100",
      "text": "دوم یک کماد آلفا"
    },
    {
      "id": 53,
      "start": 4926.1,
      "end": 4929.1,
      "formatted_start": "01:22:06.100",
      "formatted_end": "01:22:09.100",
      "text": "آلفا"
    },
    {
      "id": 54,
      "start": 4929.1,
      "end": 4933.06,
      "formatted_start": "01:22:09.100",
      "formatted_end": "01:22:13.060",
      "text": "هر هشت ساعت یک کماد زبطه قارش برو"
    },
    {
      "id": 55,
      "start": 4933.06,
      "end": 4937.82,
      "formatted_start": "01:22:13.060",
      "formatted_end": "01:22:17.820",
      "text": "کلم مازور و بعد کرم محافظ داریم اونه؟ نه"
    },
    {
      "id": 56,
      "start": 4937.82,
      "end": 4943.82,
      "formatted_start": "01:22:17.820",
      "formatted_end": "01:22:23.820",
      "text": "یک کرم محافظ پای بچه هست، هر وقت پیپی میکنه بزنی کرم محافظی"
    },
    {
      "id": 57,
      "start": 4943.82,
      "end": 4947.82,
      "formatted_start": "01:22:23.820",
      "formatted_end": "01:22:27.820",
      "text": "بعد در مورد اصحالش هم باید درمان بشه"
    },
    {
      "id": 58,
      "start": 4947.82,
      "end": 4950.82,
      "formatted_start": "01:22:27.820",
      "formatted_end": "01:22:30.820",
      "text": "آره بیشتر بیاریم که سریع پشت اصلا خیلی داره ازیاد میشه"
    },
    {
      "id": 59,
      "start": 4950.82,
      "end": 4954.82,
      "formatted_start": "01:22:30.820",
      "formatted_end": "01:22:34.820",
      "text": "اصحالش، و از ما اگر طولانی باشه باشید خوشکه رژیمی بدیم اینا"
    },
    {
      "id": 60,
      "start": 4954.82,
      "end": 4958.82,
      "formatted_start": "01:22:34.820",
      "formatted_end": "01:22:38.820",
      "text": "چون بودی و اصحالا شرط میتونین از اون بهش میدین؟"
    },
    {
      "id": 61,
      "start": 4958.82,
      "end": 4961.82,
      "formatted_start": "01:22:38.820",
      "formatted_end": "01:22:41.820",
      "text": "نه، من یک خوشکن بهش دادم که اصحال نکشه"
    },
    {
      "id": 62,
      "start": 4961.82,
      "end": 4962.82,
      "formatted_start": "01:22:41.820",
      "formatted_end": "01:22:42.820",
      "text": "نکشه خوشکننده؟"
    },
    {
      "id": 63,
      "start": 4962.82,
      "end": 4964.82,
      "formatted_start": "01:22:42.820",
      "formatted_end": "01:22:44.820",
      "text": "سفالکسی نیست"
    },
    {
      "id": 64,
      "start": 4964.82,
      "end": 4966.82,
      "formatted_start": "01:22:44.820",
      "formatted_end": "01:22:46.820",
      "text": "سفالکسی اصلا خودش شروع می کنه"
    },
    {
      "id": 65,
      "start": 4966.82,
      "end": 4968.82,
      "formatted_start": "01:22:46.820",
      "formatted_end": "01:22:48.820",
      "text": "اصحال می دازه"
    },
    {
      "id": 66,
      "start": 4968.82,
      "end": 4970.82,
      "formatted_start": "01:22:48.820",
      "formatted_end": "01:22:50.820",
      "text": "تو افنات اضرار داشت"
    },
    {
      "id": 67,
      "start": 4970.82,
      "end": 4972.82,
      "formatted_start": "01:22:50.820",
      "formatted_end": "01:22:52.820",
      "text": "پیش دکتر طریقتی بلومه اونو بهش داده بود"
    },
    {
      "id": 68,
      "start": 4972.82,
      "end": 4974.82,
      "formatted_start": "01:22:52.820",
      "formatted_end": "01:22:54.820",
      "text": "سفالکسی اینجا شروع می کنه"
    },
    {
      "id": 69,
      "start": 4974.82,
      "end": 4976.82,
      "formatted_start": "01:22:54.820",
      "formatted_end": "01:22:56.820",
      "text": "اصحال می دازه اصلا"
    },
    {
      "id": 70,
      "start": 4976.82,
      "end": 4978.82,
      "formatted_start": "01:22:56.820",
      "formatted_end": "01:22:58.820",
      "text": "چون سنگ بود"
    },
    {
      "id": 71,
      "start": 4978.82,
      "end": 4980.82,
      "formatted_start": "01:22:58.820",
      "formatted_end": "01:23:00.820",
      "text": "دکتر که بردی می سنگ شیف داده"
    },
    {
      "id": 72,
      "start": 4980.82,
      "end": 4982.82,
      "formatted_start": "01:23:00.820",
      "formatted_end": "01:23:02.820",
      "text": "بعد آزمایشش افنات داشته بود؟"
    },
    {
      "id": 73,
      "start": 4982.82,
      "end": 4984.82,
      "formatted_start": "01:23:02.820",
      "formatted_end": "01:23:04.820",
      "text": "افنات اضرار داشت"
    },
    {
      "id": 74,
      "start": 4984.82,
      "end": 4986.82,
      "formatted_start": "01:23:04.820",
      "formatted_end": "01:23:06.820",
      "text": "دو روز بستری بود"
    },
    {
      "id": 75,
      "start": 4986.82,
      "end": 4988.82,
      "formatted_start": "01:23:06.820",
      "formatted_end": "01:23:08.820",
      "text": "بستری بود"
    },
    {
      "id": 76,
      "start": 4988.82,
      "end": 4990.82,
      "formatted_start": "01:23:08.820",
      "formatted_end": "01:23:10.820",
      "text": "افنات اضرار داشت"
    },
    {
      "id": 77,
      "start": 4990.82,
      "end": 4995.46,
      "formatted_start": "01:23:10.820",
      "formatted_end": "01:23:15.460",
      "text": "افرانت ادارهش آنتیمیتیک اصحال انداخته اصحالشم خیلی سرونده"
    },
    {
      "id": 78,
      "start": 4995.46,
      "end": 4997.46,
      "formatted_start": "01:23:15.460",
      "formatted_end": "01:23:17.460",
      "text": "شیر مادر میخویی یا شیر خشک؟"
    },
    {
      "id": 79,
      "start": 4997.46,
      "end": 4998.46,
      "formatted_start": "01:23:17.460",
      "formatted_end": "01:23:18.460",
      "text": "نه شیر خشک بکنم"
    },
    {
      "id": 80,
      "start": 4998.46,
      "end": 5001.46,
      "formatted_start": "01:23:18.460",
      "formatted_end": "01:23:21.460",
      "text": "شیر خشک اگر میخویی از این شیر خشک براش بگیرید"
    },
    {
      "id": 81,
      "start": 5001.46,
      "end": 5002.46,
      "formatted_start": "01:23:21.460",
      "formatted_end": "01:23:22.460",
      "text": "هایی"
    },
    {
      "id": 82,
      "start": 5002.46,
      "end": 5009.46,
      "formatted_start": "01:23:22.460",
      "formatted_end": "01:23:29.460",
      "text": "شیر خشک به ویلاک الف، الف بگیرید"
    },
    {
      "id": 83,
      "start": 5009.46,
      "end": 5010.46,
      "formatted_start": "01:23:29.460",
      "formatted_end": "01:23:30.460",
      "text": "منم ای آر میخورم"
    },
    {
      "id": 84,
      "start": 5010.46,
      "end": 5013.46,
      "formatted_start": "01:23:30.460",
      "formatted_end": "01:23:33.460",
      "text": "نه ای آر برای برگشت شیر ریفلاپسه"
    },
    {
      "id": 85,
      "start": 5013.46,
      "end": 5016.46,
      "formatted_start": "01:23:33.460",
      "formatted_end": "01:23:36.460",
      "text": "یا نان ای آر، نان الف"
    },
    {
      "id": 86,
      "start": 5016.46,
      "end": 5018.46,
      "formatted_start": "01:23:36.460",
      "formatted_end": "01:23:38.460",
      "text": "یا گیگوز الف"
    },
    {
      "id": 87,
      "start": 5018.46,
      "end": 5020.46,
      "formatted_start": "01:23:38.460",
      "formatted_end": "01:23:40.460",
      "text": "مارک الف باشه"
    },
    {
      "id": 88,
      "start": 5020.46,
      "end": 5024.46,
      "formatted_start": "01:23:40.460",
      "formatted_end": "01:23:44.460",
      "text": "از این شیر خوشکرم که از اشخاله"
    },
    {
      "id": 89,
      "start": 5024.46,
      "end": 5026.46,
      "formatted_start": "01:23:44.460",
      "formatted_end": "01:23:46.460",
      "text": "باید این زاروهاشه بگه"
    },
    {
      "id": 90,
      "start": 5026.46,
      "end": 5028.46,
      "formatted_start": "01:23:46.460",
      "formatted_end": "01:23:48.460",
      "text": "اون دوستانه من از پیش بیدم از اشخال نداره"
    },
    {
      "id": 91,
      "start": 5028.46,
      "end": 5030.46,
      "formatted_start": "01:23:48.460",
      "formatted_end": "01:23:50.460",
      "text": "اون همین یک کم سخته باید"
    },
    {
      "id": 92,
      "start": 5030.46,
      "end": 5032.46,
      "formatted_start": "01:23:50.460",
      "formatted_end": "01:23:52.460",
      "text": "اشخال نداره باید سختگیشون میتونیست"
    },
    {
      "id": 93,
      "start": 5032.46,
      "end": 5033.46,
      "formatted_start": "01:23:52.460",
      "formatted_end": "01:23:53.460",
      "text": "تمام"
    },
    {
      "id": 94,
      "start": 5033.46,
      "end": 5034.46,
      "formatted_start": "01:23:53.460",
      "formatted_end": "01:23:54.460",
      "text": "خدافض"
    },
    {
      "id": 95,
      "start": 5034.46,
      "end": 5036.46,
      "formatted_start": "01:23:54.460",
      "formatted_end": "01:23:56.460",
      "text": "رابطه چه بیرون من بگیم"
    },
    {
      "id": 96,
      "start": 5036.46,
      "end": 5038.46,
      "formatted_start": "01:23:56.460",
      "formatted_end": "01:23:58.460",
      "text": "باشه باید"
    },
    {
      "id": 97,
      "start": 5048.46,
      "end": 5078.44,
      "formatted_start": "01:24:08.460",
      "formatted_end": "01:24:38.440",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 98,
      "start": 5078.46,
      "end": 5099.46,
      "formatted_start": "01:24:38.460",
      "formatted_end": "01:24:59.460",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}