  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1805.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:05.000",
      "text": "این دکتر که به شما گفتم زن بزن، اینا حواستشون جمع نیست."
    },
    {
      "id": 1,
      "start": 1807.0,
      "end": 1809.0,
      "formatted_start": "00:30:07.000",
      "formatted_end": "00:30:09.000",
      "text": "چند بار بهشون تذکر داریم مثلا؟"
    },
    {
      "id": 2,
      "start": 1820.0,
      "end": 1823.0,
      "formatted_start": "00:30:20.000",
      "formatted_end": "00:30:23.000",
      "text": "علیه السلام دوست دوست جان، خوبی؟ بخیر."
    },
    {
      "id": 3,
      "start": 1823.0,
      "end": 1828.0,
      "formatted_start": "00:30:23.000",
      "formatted_end": "00:30:28.000",
      "text": "دکتور ما هفته یک عدس دسته مورد این نسلکی شد مهم خب"
    },
    {
      "id": 4,
      "start": 1828.0,
      "end": 1832.0,
      "formatted_start": "00:30:28.000",
      "formatted_end": "00:30:32.000",
      "text": "داروار اشتباه یا مثلا کم و زیاد میذاشتن اینا خب"
    },
    {
      "id": 5,
      "start": 1832.0,
      "end": 1835.0,
      "formatted_start": "00:30:32.000",
      "formatted_end": "00:30:35.000",
      "text": "من به خانم سمیگی گفتم یه حساب چیز بده"
    },
    {
      "id": 6,
      "start": 1835.0,
      "end": 1839.0,
      "formatted_start": "00:30:35.000",
      "formatted_end": "00:30:39.000",
      "text": "یه بچه ها رو بیایی بخونیم زنگ"
    },
    {
      "id": 7,
      "start": 1839.0,
      "end": 1843.0,
      "formatted_start": "00:30:39.000",
      "formatted_end": "00:30:43.000",
      "text": "آره بعد خانم سمیگی هم به بچه های دارو خانه گفتید"
    },
    {
      "id": 8,
      "start": 1843.0,
      "end": 1845.0,
      "formatted_start": "00:30:43.000",
      "formatted_end": "00:30:45.000",
      "text": "اینجوریه به حواس کنی جمعه تن"
    },
    {
      "id": 9,
      "start": 1845.0,
      "end": 1848.0,
      "formatted_start": "00:30:45.000",
      "formatted_end": "00:30:48.000",
      "text": "چون نوزادن بچه هم دیگه اینا"
    },
    {
      "id": 10,
      "start": 1848.0,
      "end": 1850.0,
      "formatted_start": "00:30:48.000",
      "formatted_end": "00:30:50.000",
      "text": "آفرین"
    },
    {
      "id": 11,
      "start": 1850.0,
      "end": 1858.0,
      "formatted_start": "00:30:50.000",
      "formatted_end": "00:30:58.000",
      "text": "مثلا مریض اومده ما مثلا کرتون مکسور رو بودشیم شهرت رو حساب کرده اینا ولی شهرت یادش را ازش بگذاره"
    },
    {
      "id": 12,
      "start": 1858.0,
      "end": 1867.0,
      "formatted_start": "00:30:58.000",
      "formatted_end": "00:31:07.000",
      "text": "خوب؟ آره بی بچه ها رو آفره بعد یکیشون هست خیلی خط خوب می نویسه"
    },
    {
      "id": 13,
      "start": 1867.0,
      "end": 1873.0,
      "formatted_start": "00:31:07.000",
      "formatted_end": "00:31:13.000",
      "text": "آره من می بینم خط خیلی خوبه یکیشون هست بنده خدا می نویسه ولی خیلی ویز می نویسه"
    },
    {
      "id": 14,
      "start": 1873.0,
      "end": 1876.0,
      "formatted_start": "00:31:13.000",
      "formatted_end": "00:31:16.000",
      "text": "مثلا هشتا اینقدر کچولو میمیسه"
    },
    {
      "id": 15,
      "start": 1876.0,
      "end": 1881.0,
      "formatted_start": "00:31:16.000",
      "formatted_end": "00:31:21.000",
      "text": "آره بگو یکم این هشت و شیش و عددها رو بزرگ میمیسه اینا"
    },
    {
      "id": 16,
      "start": 1881.0,
      "end": 1887.0,
      "formatted_start": "00:31:21.000",
      "formatted_end": "00:31:27.000",
      "text": "سپاس کنم ببخشین دوز جماعه در ضرورت بیتر شدن همکار ما و کار داروخانه"
    },
    {
      "id": 17,
      "start": 1887.0,
      "end": 1892.0,
      "formatted_start": "00:31:27.000",
      "formatted_end": "00:31:32.000",
      "text": "داروخانه ملیزا چیز نشن دیگه این داروخانه اینجوری هست"
    },
    {
      "id": 18,
      "start": 1892.0,
      "end": 1895.0,
      "formatted_start": "00:31:32.000",
      "formatted_end": "00:31:35.000",
      "text": "خواهش میخوام من در خدمت هستم الان میاد خدمت تو خواهش باش"
    },
    {
      "id": 19,
      "start": 1895.0,
      "end": 1897.0,
      "formatted_start": "00:31:35.000",
      "formatted_end": "00:31:37.000",
      "text": "خواهش باش"
    },
    {
      "id": 20,
      "start": 1897.0,
      "end": 1899.0,
      "formatted_start": "00:31:37.000",
      "formatted_end": "00:31:39.000",
