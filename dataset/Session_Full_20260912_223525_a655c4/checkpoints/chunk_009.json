  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2730.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 1,
      "start": 2730.0,
      "end": 2742.0,
      "formatted_start": "00:45:30.000",
      "formatted_end": "00:45:42.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 2760.0,
      "end": 2765.0,
      "formatted_start": "00:46:00.000",
      "formatted_end": "00:46:05.000",
      "text": "بله دوستان، روش تجربه بدترین روش باغداری"
    },
    {
      "id": 3,
      "start": 2765.0,
      "end": 2769.0,
      "formatted_start": "00:46:05.000",
      "formatted_end": "00:46:09.000",
      "text": "یعنی که من خودم هر کار رو تجربه بکنم بسیار اشتباهه"
    },
    {
      "id": 4,
      "start": 2769.0,
      "end": 2772.0,
      "formatted_start": "00:46:09.000",
      "formatted_end": "00:46:12.000",
      "text": "اون رو زرمایتون رو هدر میدید"
    },
    {
      "id": 5,
      "start": 2772.0,
      "end": 2776.0,
      "formatted_start": "00:46:12.000",
      "formatted_end": "00:46:16.000",
      "text": "و هزینه ی بسیار کمتر بیقی از تجربه دیگران استفاده بکنیم"
    },
    {
      "id": 6,
      "start": 2790.0,
      "end": 2792.0,
      "formatted_start": "00:46:30.000",
      "formatted_end": "00:46:32.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 2820.0,
      "end": 2840.0,
      "formatted_start": "00:47:00.000",
      "formatted_end": "00:47:20.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 2840.0,
      "end": 2845.58,
      "formatted_start": "00:47:20.000",
      "formatted_end": "00:47:25.580",
      "text": "یک، چیزی رو تعمل نداریم. اگر یک چیزی رو تغییر نمیره یه ایرانی هست."
    },
    {
      "id": 9,
      "start": 2846.0,
      "end": 2850.5,
      "formatted_start": "00:47:26.000",
      "formatted_end": "00:47:30.500",
      "text": "فکر نکنید که اگر یک چیزی رو نداریم خود بخوند و هیچ چیزی خود به خود درست نمیشه."
    },
    {
      "id": 10,
      "start": 2850.88,
      "end": 2852.82,
      "formatted_start": "00:47:30.880",
      "formatted_end": "00:47:32.820",
      "text": "هیچ چیزی خود به خود درست نمیشه."
    },
    {
      "id": 11,
      "start": 2854.42,
      "end": 2858.3,
      "formatted_start": "00:47:34.420",
      "formatted_end": "00:47:38.300",
      "text": "یعنی اگر فکر کنید که آقا من تغییر نمی کنم و خودش درست میشه،"
    },
    {
      "id": 12,
      "start": 2858.3,
      "end": 2861.02,
      "formatted_start": "00:47:38.300",
      "formatted_end": "00:47:41.020",
      "text": "هیچ چیزی خود به خود درست نمیشه."
    },
    {
      "id": 13,
      "start": 2861.52,
      "end": 2863.24,
      "formatted_start": "00:47:41.520",
      "formatted_end": "00:47:43.240",
      "text": "شما باید تغییر کنید و خود بخوند."
    },
    {
      "id": 14,
      "start": 2863.24,
      "end": 2868.74,
      "formatted_start": "00:47:43.240",
      "formatted_end": "00:47:48.740",
      "text": "یعنی یه تبهمی که من که گویم برام آقا خود به خود بداخل مسائل حل میشه"
    },
    {
      "id": 15,
      "start": 2868.74,
      "end": 2871.24,
      "formatted_start": "00:47:48.740",
      "formatted_end": "00:47:51.240",
      "text": "بینم هیچ وقت مسائل خود به خود حل نمیشه"
    },
    {
      "id": 16,
      "start": 2871.24,
      "end": 2873.24,
      "formatted_start": "00:47:51.240",
      "formatted_end": "00:47:53.240",
      "text": "تو تغییر میکنه، مسائل هم تغییر میکنه"
    },
    {
      "id": 17,
      "start": 2873.24,
      "end": 2877.24,
      "formatted_start": "00:47:53.240",
      "formatted_end": "00:47:57.240",
      "text": "چی میشه که آدم تغییر میکنه؟ بشین روی بابرانش کنه"
    },
    {
      "id": 18,
      "start": 2877.24,
      "end": 2880.24,
      "formatted_start": "00:47:57.240",
      "formatted_end": "00:48:00.240",
      "text": "خب من چرا باید شعرهایی که ناجایی رو تهمان کنم؟"
    },
    {
      "id": 19,
      "start": 2880.24,
      "end": 2884.24,
      "formatted_start": "00:48:00.240",
      "formatted_end": "00:48:04.240",
      "text": "چرا باید تهمان کنم؟ به خاطر حرف مردمه؟"
    },
    {
      "id": 20,
      "start": 2884.24,
      "end": 2888.24,
      "formatted_start": "00:48:04.240",
      "formatted_end": "00:48:08.240",
      "text": "چه حرزی ما تو زندگیمون تهمان کردیم به خاطر حرف مردم؟"
    },
    {
      "id": 21,
      "start": 2888.24,
      "end": 2895.24,
      "formatted_start": "00:48:08.240",
      "formatted_end": "00:48:15.240",
      "text": "محساباش تو بسط کامنت ها بنمیسید تجربیاتی مثل این تجربه ها در بیشتر بنمیسید که کجا تنمول کردید"
    },
    {
      "id": 22,
      "start": 2895.24,
      "end": 2904.24,
      "formatted_start": "00:48:15.240",
      "formatted_end": "00:48:24.240",
      "text": "و میتونستید تنمول نکنید و میتونستید راه رو پیدا کنید ولی تزمین رو خودید به خاطر اردو بردم به خاطر تهبی"
    },
    {
      "id": 23,
      "start": 2909.24,
      "end": 2915.24,
      "formatted_start": "00:48:29.240",
      "formatted_end": "00:48:35.240",
      "text": "بعدی ما به زن سلطه برمی گفتن سلیمته الان عوض شده اسمش بهش میگرد ببینیست"
    },
    {
      "id": 24,
      "start": 2915.24,
      "end": 2921.24,
      "formatted_start": "00:48:35.240",
      "formatted_end": "00:48:41.240",
      "text": "یاد رو میاد میگی من به دنبال حق زنم اول، به دنبال حق زن در من این، خیلی از من بگیریش"
    },
    {
      "id": 25,
      "start": 2921.24,
      "end": 2925.24,
      "formatted_start": "00:48:41.240",
      "formatted_end": "00:48:45.240",
      "text": "یاد میگه حقوق مصابی برگذاری، حقوق مصابی برگذاری سرداری بگیری"
    },
    {
      "id": 26,
      "start": 2925.24,
      "end": 2933.24,
      "formatted_start": "00:48:45.240",
      "formatted_end": "00:48:53.240",
      "text": "حقوق مصابی برای حسین ها با توه، ببین از فمیلیزم، خودن زنها فقط کندن از مردها رو فهمیدن"
    },
    {
      "id": 27,
      "start": 2933.24,
      "end": 2936.24,
      "formatted_start": "00:48:53.240",
      "formatted_end": "00:48:56.240",
      "text": "و با هیچ زن فمیلیزتی بارده رابطه نشد، چرا؟"
    },
    {
      "id": 28,
      "start": 2936.24,
      "end": 2943.24,
      "formatted_start": "00:48:56.240",
      "formatted_end": "00:49:03.240",
      "text": "چرا؟ چون اینا تو ذهنشون باید بیفرد از شما طلب کنند و شما تا اول بابد نمیدونند چرا بهشون بده کنید"
    },
    {
      "id": 29,
      "start": 2943.24,
      "end": 2949.24,
      "formatted_start": "00:49:03.240",
      "formatted_end": "00:49:09.240",
      "text": "یعنی شما باید مول بدید، عزیزی بکنید، عشق بدید، محبت بکنید، و بعد با یکی دیگر که باید نداده کنید، تأثیر تو بوده"
    },
    {
      "id": 30,
      "start": 2949.24,
      "end": 2954.24,
      "formatted_start": "00:49:09.240",
      "formatted_end": "00:49:14.240",
      "text": "که بردازه کافی مرد نبودید، که این حس رو بهش بدید که اون نره به تو حیالت نکنه"
    },
    {
      "id": 31,
      "start": 2954.24,
      "end": 2956.24,
      "formatted_start": "00:49:14.240",
      "formatted_end": "00:49:16.240",
      "text": "نکنه چون فیمینیست دیداری چی میگن"
    },
    {
      "id": 32,
      "start": 2956.24,
      "end": 2959.24,
      "formatted_start": "00:49:16.240",
      "formatted_end": "00:49:19.240",
      "text": "اسم این سریعت بازی هاتون رو نزارید فیمینیست"
    },
    {
      "id": 33,
      "start": 2959.24,
      "end": 2963.24,
      "formatted_start": "00:49:19.240",
      "formatted_end": "00:49:23.240",
      "text": "و مردها آگاه میشن شما میبینید دوبازتون"
    },
    {
      "id": 34,
      "start": 2963.24,
      "end": 2968.24,
      "formatted_start": "00:49:23.240",
      "formatted_end": "00:49:28.240",
      "text": "و ببین امران اگر بزارم یک مرد دی توی ایران واقعی بمانه"
    },
    {
      "id": 35,
      "start": 2968.24,
      "end": 2971.24,
      "formatted_start": "00:49:28.240",
      "formatted_end": "00:49:31.240",
      "text": "که ندانه مردها خیلی عرضش مندن"
    },
    {
      "id": 36,
      "start": 2971.24,
      "end": 2974.24,
      "formatted_start": "00:49:31.240",
      "formatted_end": "00:49:34.240",
      "text": "مردها همه چیزشون رو تو رابطه میذارن"
    },
    {
      "id": 37,
      "start": 2974.24,
      "end": 2976.24,
      "formatted_start": "00:49:34.240",
      "formatted_end": "00:49:36.240",
      "text": "مردها صد فرارکاری می کنن"
    },
    {
      "id": 38,
      "start": 2976.24,
      "end": 2978.24,
      "formatted_start": "00:49:36.240",
      "formatted_end": "00:49:38.240",
      "text": "همین الان اگر بازید مرد بخشید"
    },
    {
      "id": 39,
      "start": 2978.24,
      "end": 2980.24,
      "formatted_start": "00:49:38.240",
      "formatted_end": "00:49:40.240",
      "text": "حاضری کلیتو دیدید"
    },
    {
      "id": 40,
      "start": 2980.24,
      "end": 3000.0,
      "formatted_start": "00:49:40.240",
      "formatted_end": "00:50:00.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
