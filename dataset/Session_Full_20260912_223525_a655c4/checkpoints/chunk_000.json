  "stt_segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 20.0,
      "formatted_start": "00:00:00.000",
      "formatted_end": "00:00:20.000",
      "text": "برنامه بیمار، بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 20.0,
      "end": 22.0,
      "formatted_start": "00:00:20.000",
      "formatted_end": "00:00:22.000",
      "text": "خوش آمدید"
    },
    {
      "id": 2,
      "start": 22.0,
      "end": 24.0,
      "formatted_start": "00:00:22.000",
      "formatted_end": "00:00:24.000",
      "text": "خوب اون برگیر رو بیزنج بدیم"
    },
    {
      "id": 3,
      "start": 28.0,
      "end": 30.0,
      "formatted_start": "00:00:28.000",
      "formatted_end": "00:00:30.000",
      "text": "سلام"
    },
    {
      "id": 4,
      "start": 30.0,
      "end": 32.0,
      "formatted_start": "00:00:30.000",
      "formatted_end": "00:00:32.000",
      "text": "سلام شب"
    },
    {
      "id": 5,
      "start": 32.0,
      "end": 34.0,
      "formatted_start": "00:00:32.000",
      "formatted_end": "00:00:34.000",
      "text": "من یک کاری داشتم خودم پیدا کردم"
    },
    {
      "id": 6,
      "start": 34.0,
      "end": 36.0,
      "formatted_start": "00:00:34.000",
      "formatted_end": "00:00:36.000",
      "text": "الان دستگاه دونی کار میکنه؟"
    },
    {
      "id": 7,
      "start": 36.0,
      "end": 38.0,
      "formatted_start": "00:00:36.000",
      "formatted_end": "00:00:38.000",
      "text": "الان من روشنج کردم"
    },
    {
      "id": 8,
      "start": 40.0,
      "end": 42.0,
      "formatted_start": "00:00:40.000",
      "formatted_end": "00:00:42.000",
      "text": "خب نه روشنج خاموش بود روشنج کردم"
    },
    {
      "id": 9,
      "start": 42.0,
      "end": 44.0,
      "formatted_start": "00:00:42.000",
      "formatted_end": "00:00:44.000",
      "text": "خب خب خب"
    },
    {
      "id": 10,
      "start": 44.0,
      "end": 47.0,
      "formatted_start": "00:00:44.000",
      "formatted_end": "00:00:47.000",
      "text": "خب خان سعیدی چی شده؟"
    },
    {
      "id": 11,
      "start": 47.0,
      "end": 49.0,
      "formatted_start": "00:00:47.000",
      "formatted_end": "00:00:49.000",
      "text": "خود یه لحظه"
    },
    {
      "id": 12,
      "start": 49.0,
      "end": 50.0,
      "formatted_start": "00:00:49.000",
      "formatted_end": "00:00:50.000",
