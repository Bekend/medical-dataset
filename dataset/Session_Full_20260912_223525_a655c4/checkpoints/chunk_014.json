      "end": 4277.0,
      "formatted_start": "01:11:15.000",
      "formatted_end": "01:11:17.000",
      "text": "بفهمید در روی یه فیلم"
    },
    {
      "id": 14,
      "start": 4278.6,
      "end": 4280.6,
      "formatted_start": "01:11:18.600",
      "formatted_end": "01:11:20.600",
      "text": "خوب گوش بده"
    },
    {
      "id": 15,
      "start": 4280.6,
      "end": 4281.6,
      "formatted_start": "01:11:20.600",
      "formatted_end": "01:11:21.600",
      "text": "دقیقا"
    },
    {
      "id": 16,
      "start": 4281.6,
      "end": 4285.1,
      "formatted_start": "01:11:21.600",
      "formatted_end": "01:11:25.100",
      "text": "این فیلم رو که دکاف روز 15 قطعه توی افزار"
    },
    {
      "id": 17,
      "start": 4285.1,
      "end": 4287.1,
      "formatted_start": "01:11:25.100",
      "formatted_end": "01:11:27.100",
      "text": "اینو روزی..."
    },
    {
      "id": 18,
      "start": 4287.1,
      "end": 4289.1,
      "formatted_start": "01:11:27.100",
      "formatted_end": "01:11:29.100",
      "text": "بله روزی 15"
    },
    {
      "id": 19,
      "start": 4289.1,
      "end": 4291.1,
      "formatted_start": "01:11:29.100",
      "formatted_end": "01:11:31.100",
      "text": "اینو روزی 2 با 1.5 سی سی"
    },
    {
      "id": 20,
      "start": 4291.1,
      "end": 4293.1,
      "formatted_start": "01:11:31.100",
      "formatted_end": "01:11:33.100",
      "text": "1.5 قطعه چکم"
    },
    {
      "id": 21,
      "start": 4293.1,
      "end": 4295.1,
      "formatted_start": "01:11:33.100",
      "formatted_end": "01:11:35.100",
      "text": "دقیقا دیگه نوم و تیمیم"
    },
    {
      "id": 22,
      "start": 4295.1,
      "end": 4297.1,
      "formatted_start": "01:11:35.100",
      "formatted_end": "01:11:37.100",
      "text": "میشه روش نمیشه؟"
    },
    {
      "id": 23,
      "start": 4297.1,
      "end": 4299.1,
      "formatted_start": "01:11:37.100",
      "formatted_end": "01:11:39.100",
      "text": "روش نمیشه 2.5 سی سی"
    },
    {
      "id": 24,
      "start": 4299.1,
      "end": 4301.1,
      "formatted_start": "01:11:39.100",
      "formatted_end": "01:11:41.100",
      "text": "این ساشه ها رو باید تو آب خاطی کنی"
    },
    {
      "id": 25,
      "start": 4301.1,
      "end": 4304.1,
      "formatted_start": "01:11:41.100",
      "formatted_end": "01:11:44.100",
      "text": "صبح یه دونه از اینا رو تو آب"
    },
    {
      "id": 26,
      "start": 4304.1,
      "end": 4306.1,
      "formatted_start": "01:11:44.100",
      "formatted_end": "01:11:46.100",
      "text": "از می کنید توی مقدار آب"
    },
    {
      "id": 27,
      "start": 4306.1,
      "end": 4308.1,
      "formatted_start": "01:11:46.100",
      "formatted_end": "01:11:48.100",
      "text": "بیدی بچه بخوره"
    },
    {
      "id": 28,
      "start": 4308.1,
      "end": 4310.1,
      "formatted_start": "01:11:48.100",
      "formatted_end": "01:11:50.100",
      "text": "روزی این"
    },
    {
      "id": 29,
      "start": 4310.1,
      "end": 4312.1,
      "formatted_start": "01:11:50.100",
      "formatted_end": "01:11:52.100",
      "text": "صبح ناشته یه عدد روش نوشته"
