      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 2430.0,
      "end": 2440.0,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 2460.0,
      "end": 2467.62,
      "formatted_start": "00:41:00.000",
      "formatted_end": "00:41:07.620",
      "text": "بفهم"
    },
    {
      "id": 3,
      "start": 2467.62,
      "end": 2469.18,
      "formatted_start": "00:41:07.620",
      "formatted_end": "00:41:09.180",
      "text": "سلام بابا جان"
    },
    {
      "id": 4,
      "start": 2469.18,
      "end": 2470.84,
      "formatted_start": "00:41:09.180",
      "formatted_end": "00:41:10.840",
      "text": "خوشموندی"
    },
    {
      "id": 5,
      "start": 2470.84,
      "end": 2472.36,
      "formatted_start": "00:41:10.840",
      "formatted_end": "00:41:12.360",
      "text": "بچه دوست کنید"
    },
    {
      "id": 6,
      "start": 2472.36,
      "end": 2473.76,
      "formatted_start": "00:41:12.360",
      "formatted_end": "00:41:13.760",
      "text": "درخواهی یوگه شده باشید"
    },
    {
      "id": 7,
      "start": 2473.76,
      "end": 2474.88,
      "formatted_start": "00:41:13.760",
      "formatted_end": "00:41:14.880",
      "text": "اشاله های بچه ها"
    },
    {
      "id": 8,
      "start": 2474.88,
      "end": 2476.34,
      "formatted_start": "00:41:14.880",
      "formatted_end": "00:41:16.340",
      "text": "زیر دستگاه خوب خابیده"
    },
    {
      "id": 9,
      "start": 2476.34,
      "end": 2478.3,
      "formatted_start": "00:41:16.340",
      "formatted_end": "00:41:18.300",
      "text": "بچه خوب خابه"
    },
    {
      "id": 10,
      "start": 2478.3,
      "end": 2480.76,
      "formatted_start": "00:41:18.300",
      "formatted_end": "00:41:20.760",
      "text": "خوب خواهد روشو"
    },
    {
      "id": 11,
      "start": 2480.76,
      "end": 2482.5,
      "formatted_start": "00:41:20.760",
      "formatted_end": "00:41:22.500",
      "text": "چند شب بزشتیم؟"
    },
    {
      "id": 12,
      "start": 2482.5,
      "end": 2483.08,
      "formatted_start": "00:41:22.500",
      "formatted_end": "00:41:23.080",
      "text": "سه شب"
    },
    {
      "id": 13,
      "start": 2483.08,
      "end": 2484.96,
      "formatted_start": "00:41:23.080",
      "formatted_end": "00:41:24.960",
      "text": "دیگه باید تنبه شده باشید"
    },
    {
      "id": 14,
      "start": 2484.96,
      "end": 2485.6,
      "formatted_start": "00:41:24.960",
      "formatted_end": "00:41:25.600",
      "text": "اشاله"
    },
    {
      "id": 15,
      "start": 2485.6,
      "end": 2486.94,
      "formatted_start": "00:41:25.600",
      "formatted_end": "00:41:26.940",
      "text": "خواهد خانم"
    },
    {
      "id": 16,
      "start": 2486.94,
      "end": 2490.94,
      "formatted_start": "00:41:26.940",
      "formatted_end": "00:41:30.940",
      "text": "نه نه نافش خودش"
    },
    {
      "id": 17,
      "start": 2490.94,
      "end": 2492.94,
      "formatted_start": "00:41:30.940",
      "formatted_end": "00:41:32.940",
      "text": "نه نه نافش خود برای اصلا"
    },
    {
      "id": 18,
      "start": 2492.94,
      "end": 2495.94,
      "formatted_start": "00:41:32.940",
      "formatted_end": "00:41:35.940",
      "text": "یکم قرمزه یک پوماتیدی سببش"
    },
    {
      "id": 19,
      "start": 2495.94,
      "end": 2499.94,
      "formatted_start": "00:41:35.940",
      "formatted_end": "00:41:39.940",
      "text": "برای این سفید شده برنش کاملا"
    },
    {
      "id": 20,
      "start": 2499.94,
      "end": 2501.94,
      "formatted_start": "00:41:39.940",
      "formatted_end": "00:41:41.940",
      "text": "سوالی دوست دست سوال"
    },
    {
      "id": 21,
      "start": 2501.94,
      "end": 2502.94,
      "formatted_start": "00:41:41.940",
      "formatted_end": "00:41:42.940",
      "text": "ده دوست دست سوال"
    },
    {
      "id": 22,
      "start": 2502.94,
      "end": 2503.94,
      "formatted_start": "00:41:42.940",
      "formatted_end": "00:41:43.940",
      "text": "دشتر هر چند دست سوال"
    },
    {
      "id": 23,
      "start": 2503.94,
      "end": 2509.94,
      "formatted_start": "00:41:43.940",
      "formatted_end": "00:41:49.940",
      "text": "این پاش چیز نفر که بیداری نفر دکتر نوکرده"
    },
    {
      "id": 24,
      "start": 2509.94,
      "end": 2513.94,
      "formatted_start": "00:41:49.940",
      "formatted_end": "00:41:53.940",
      "text": "چیه؟ شرکتی برای مالش محاولی شد"
    },
    {
      "id": 25,
      "start": 2513.94,
      "end": 2517.7,
      "formatted_start": "00:41:53.940",
      "formatted_end": "00:41:57.700",
      "text": "بعد ما این پای چرخش در خارج یاد داخل داریم میگن ماساج بدیم"
    },
    {
      "id": 26,
      "start": 2517.7,
      "end": 2520.18,
      "formatted_start": "00:41:57.700",
      "formatted_end": "00:42:00.180",
      "text": "مثلا این پای میگن یه بار ما این پای میدیم"
    },
    {
      "id": 27,
      "start": 2520.18,
      "end": 2521.18,
      "formatted_start": "00:42:00.180",
      "formatted_end": "00:42:01.180",
      "text": "این پاش بوده"
    },
    {
      "id": 28,
      "start": 2521.18,
      "end": 2522.18,
      "formatted_start": "00:42:01.180",
      "formatted_end": "00:42:02.180",
      "text": "نه نه این پاش بوده"
    },
    {
      "id": 29,
      "start": 2522.18,
      "end": 2523.18,
      "formatted_start": "00:42:02.180",
      "formatted_end": "00:42:03.180",
      "text": "این بچه بوده"
    },
    {
      "id": 30,
      "start": 2523.18,
      "end": 2524.18,
      "formatted_start": "00:42:03.180",
      "formatted_end": "00:42:04.180",
      "text": "نه نه چیزی بیرون نمیدونی"
    },
    {
      "id": 31,
      "start": 2524.18,
      "end": 2525.18,
      "formatted_start": "00:42:04.180",
      "formatted_end": "00:42:05.180",
      "text": "نه نه این پاش بوده"
    },
    {
      "id": 32,
      "start": 2525.18,
      "end": 2526.18,
      "formatted_start": "00:42:05.180",
      "formatted_end": "00:42:06.180",
      "text": "نه این پاش بوده"
    },
    {
      "id": 33,
      "start": 2526.18,
      "end": 2528.18,
      "formatted_start": "00:42:06.180",
      "formatted_end": "00:42:08.180",
      "text": "ببین پای الان این پای که خوبه"
    },
    {
      "id": 34,
      "start": 2528.18,
      "end": 2530.18,
      "formatted_start": "00:42:08.180",
      "formatted_end": "00:42:10.180",
      "text": "اینو یه نقدر به زاویه این باید چرخش داریم"
    },
    {
      "id": 35,
      "start": 2530.18,
      "end": 2532.18,
      "formatted_start": "00:42:10.180",
      "formatted_end": "00:42:12.180",
      "text": "یه کم باید ماساج بدن"
    },
    {
      "id": 36,
      "start": 2532.18,
      "end": 2533.18,
      "formatted_start": "00:42:12.180",
      "formatted_end": "00:42:13.180",
      "text": "تا خوبشی"
    },
    {
      "id": 37,
      "start": 2533.18,
      "end": 2534.18,
      "formatted_start": "00:42:13.180",
      "formatted_end": "00:42:14.180",
      "text": "چیز خاصی نیست"
    },
    {
      "id": 38,
      "start": 2534.18,
      "end": 2540.18,
      "formatted_start": "00:42:14.180",
      "formatted_end": "00:42:20.180",
      "text": "این نیست، باید ماساج بدیم، ببینیم ماساج مخالفه، این هرون این یه مدار زاویه داره از اینجا"
    },
    {
      "id": 39,
      "start": 2540.18,
      "end": 2550.18,
      "formatted_start": "00:42:20.180",
      "formatted_end": "00:42:30.180",
      "text": "اینو بعد یک کم ماساج بدید، با به مرور خوب میشه، باز هم یه متخصص و ارتفاع هم ببینه، اشخالی نداره، برای چیز مهمی نباشه"
    },
    {
      "id": 40,
      "start": 2550.18,
      "end": 2561.18,
      "formatted_start": "00:42:30.180",
      "formatted_end": "00:42:41.180",
      "text": "این ششن، یکی نیستی خونی داره، یه لکه قیمه صورتی، بلوی، رنگ، آجوری، اینو املاد صرفات آمورفه"
    },
    {
      "id": 41,
      "start": 2561.18,
      "end": 2564.0,
      "formatted_start": "00:42:41.180",
      "formatted_end": "00:42:44.000",
      "text": "یکی دو لکه مثلا رای گرمین گل"
    },
    {
      "id": 42,
      "start": 2564.0,
      "end": 2565.76,
      "formatted_start": "00:42:44.000",
      "formatted_end": "00:42:45.760",
      "text": "سرخ و سرخ نیست"
    },
    {
      "id": 43,
      "start": 2565.76,
      "end": 2567.76,
      "formatted_start": "00:42:45.760",
      "formatted_end": "00:42:47.760",
      "text": "آجوری که شما بودید"
    },
    {
      "id": 44,
      "start": 2567.76,
      "end": 2569.76,
      "formatted_start": "00:42:47.760",
      "formatted_end": "00:42:49.760",
      "text": "نه مشکلی نداره دیگه"
    },
    {
      "id": 45,
      "start": 2569.76,
      "end": 2571.76,
      "formatted_start": "00:42:49.760",
      "formatted_end": "00:42:51.760",
      "text": "جا نه برگره چیزش بوده"
    },
    {
      "id": 46,
      "start": 2571.76,
      "end": 2573.76,
      "formatted_start": "00:42:51.760",
      "formatted_end": "00:42:53.760",
      "text": "برنامه آفشم گفته که کنی"
    },
    {
      "id": 47,
      "start": 2573.76,
      "end": 2575.76,
      "formatted_start": "00:42:53.760",
      "formatted_end": "00:42:55.760",
      "text": "یک اماده بله تتراسیکی"
    },
    {
      "id": 48,
      "start": 2575.76,
      "end": 2578.76,
      "formatted_start": "00:42:55.760",
      "formatted_end": "00:42:58.760",
      "text": "برنامه نفتگی ها فیلن نداره گرم"
    },
    {
      "id": 49,
      "start": 2578.76,
      "end": 2579.76,
      "formatted_start": "00:42:58.760",
      "formatted_end": "00:42:59.760",
      "text": "نه نیاز نداره"
    },
    {
      "id": 50,
      "start": 2579.76,
      "end": 2581.76,
      "formatted_start": "00:42:59.760",
      "formatted_end": "00:43:01.760",
      "text": "یکی باوان هایی که میگیره این هم که طبیعی هست"
    },
    {
      "id": 51,
      "start": 2581.76,
      "end": 2583.76,
      "formatted_start": "00:43:01.760",
      "formatted_end": "00:43:03.760",
      "text": "این فشار و این چیزها نه"
    },
    {
      "id": 52,
      "start": 2583.76,
      "end": 2588.26,
      "formatted_start": "00:43:03.760",
      "formatted_end": "00:43:08.260",
      "text": "بچه سر صدایی باید 3-4 ساعتی جیغی بزنه اگر ندارن"
    },
    {
      "id": 53,
      "start": 2588.26,
      "end": 2589.76,
      "formatted_start": "00:43:08.260",
      "formatted_end": "00:43:09.760",
      "text": "یکمانه بی غراری میبونه"
    },
    {
      "id": 54,
      "start": 2589.76,
      "end": 2593.76,
      "formatted_start": "00:43:09.760",
      "formatted_end": "00:43:13.760",
      "text": "نه اون آدم دیگه نکنه اصلا با کنششون نده غیرات نیست"
    },
    {
      "id": 55,
      "start": 2593.76,
      "end": 2597.26,
      "formatted_start": "00:43:13.760",
      "formatted_end": "00:43:17.260",
      "text": "چنده برم بد بخونست؟ مهم نیست؟"
    },
    {
      "id": 56,
      "start": 2597.26,
      "end": 2597.76,
      "formatted_start": "00:43:17.260",
      "formatted_end": "00:43:17.760",
      "text": "جان؟"
    },
    {
      "id": 57,
      "start": 2597.76,
      "end": 2600.26,
      "formatted_start": "00:43:17.760",
      "formatted_end": "00:43:20.260",
      "text": "آه پاش نه باید بچه ها سی که از بچه ها اینجوری مادرینه"
    },
    {
      "id": 58,
      "start": 2600.26,
      "end": 2604.26,
      "formatted_start": "00:43:20.260",
      "formatted_end": "00:43:24.260",
      "text": "باید یه ارتپیت ببینید چون بچه دیگه دقیقا چه بررسیب شده"
    },
    {
      "id": 59,
      "start": 2604.26,
      "end": 2606.26,
      "formatted_start": "00:43:24.260",
      "formatted_end": "00:43:26.260",
      "text": "چه خاص یادتو پیشنان میبینی؟"
    },
    {
      "id": 60,
      "start": 2606.26,
      "end": 2608.26,
      "formatted_start": "00:43:26.260",
      "formatted_end": "00:43:28.260",
      "text": "فقط ماساج یکم خواهش میشه"
    },
    {
      "id": 61,
      "start": 2608.26,
      "end": 2609.26,
      "formatted_start": "00:43:28.260",
      "formatted_end": "00:43:29.260",
      "text": "با مکان روتور خاصی میشن؟"
    },
    {
      "id": 62,
      "start": 2609.26,
      "end": 2612.26,
      "formatted_start": "00:43:29.260",
      "formatted_end": "00:43:32.260",
      "text": "نه یک ارتر ارتفعی نمیتونه چیز کنه"
    },
    {
      "id": 63,
      "start": 2612.26,
      "end": 2614.26,
      "formatted_start": "00:43:32.260",
      "formatted_end": "00:43:34.260",
      "text": "باید یک تیمی پیانو برلم کم کنه"
    },
    {
      "id": 64,
      "start": 2614.26,
      "end": 2615.26,
      "formatted_start": "00:43:34.260",
      "formatted_end": "00:43:35.260",
      "text": "که اش میگیره"
    },
    {
      "id": 65,
      "start": 2615.26,
      "end": 2616.26,
      "formatted_start": "00:43:35.260",
      "formatted_end": "00:43:36.260",
      "text": "یکو بخوادر بسترگ بودن"
    },
    {
      "id": 66,
      "start": 2616.26,
      "end": 2618.26,
      "formatted_start": "00:43:36.260",
      "formatted_end": "00:43:38.260",
      "text": "یک مرحله دیگه باید خواهد دیوید"
    },
    {
      "id": 67,
      "start": 2618.26,
      "end": 2620.26,
      "formatted_start": "00:43:38.260",
      "formatted_end": "00:43:40.260",
      "text": "بچه ها سه مرحله سراب"
    },
    {
      "id": 68,
      "start": 2620.26,
      "end": 2621.26,
      "formatted_start": "00:43:40.260",
      "formatted_end": "00:43:41.260",
      "text": "اشکال نده"
    },
    {
      "id": 69,
      "start": 2621.26,
      "end": 2622.26,
      "formatted_start": "00:43:41.260",
      "formatted_end": "00:43:42.260",
      "text": "ببرن؟"
    },
    {
      "id": 70,
      "start": 2622.26,
      "end": 2623.26,
      "formatted_start": "00:43:42.260",
      "formatted_end": "00:43:43.260",
      "text": "ببرن"
    },
    {
      "id": 71,
      "start": 2623.26,
      "end": 2624.26,
      "formatted_start": "00:43:43.260",
      "formatted_end": "00:43:44.260",
      "text": "این نوی چیکور چیز خاصی نیست؟"
    },
    {
      "id": 72,
      "start": 2624.26,
      "end": 2625.26,
      "formatted_start": "00:43:44.260",
      "formatted_end": "00:43:45.260",
      "text": "لکه یک هر از همه؟"
    },
    {
      "id": 73,
      "start": 2625.26,
      "end": 2626.26,
      "formatted_start": "00:43:45.260",
      "formatted_end": "00:43:46.260",
      "text": "نه نه"
    },
    {
      "id": 74,
      "start": 2626.26,
      "end": 2627.26,
      "formatted_start": "00:43:46.260",
      "formatted_end": "00:43:47.260",
      "text": "اونا خون نیست"
    },
    {
      "id": 75,
      "start": 2636.26,
      "end": 2640.26,
      "formatted_start": "00:43:56.260",
      "formatted_end": "00:44:00.260",
      "text": "نخش بهشم با مشکل نداره بین بیقراری ها شما مشکل نیست"
    },
    {
      "id": 76,
      "start": 2640.26,
      "end": 2642.26,
      "formatted_start": "00:44:00.260",
      "formatted_end": "00:44:02.260",
      "text": "نخش بهشم به هیچی نخش بگیر"
    },
    {
      "id": 77,
      "start": 2642.26,
      "end": 2644.26,
      "formatted_start": "00:44:02.260",
      "formatted_end": "00:44:04.260",
      "text": "نه بگیر میشه چیزی نه باید بگیر میشه"
    },
    {
      "id": 78,
      "start": 2644.26,
      "end": 2646.26,
      "formatted_start": "00:44:04.260",
      "formatted_end": "00:44:06.260",
      "text": "نه میبین اگر شدیده بگیر دارو بسان"
    },
    {
      "id": 79,
      "start": 2646.26,
      "end": 2648.26,
      "formatted_start": "00:44:06.260",
      "formatted_end": "00:44:08.260",
      "text": "اگر کم نمی کنه یکم"
    },
    {
      "id": 80,
      "start": 2648.26,
      "end": 2650.26,
      "formatted_start": "00:44:08.260",
      "formatted_end": "00:44:10.260",
      "text": "همون شیر کردن همون از یک سینا بگیر"
    },
    {
      "id": 81,
      "start": 2650.26,
      "end": 2652.26,
      "formatted_start": "00:44:10.260",
      "formatted_end": "00:44:12.260",
      "text": "خواهی کم نیم خواهد سینه رو بگیره"
    },
    {
      "id": 82,
      "start": 2652.26,
      "end": 2656.26,
      "formatted_start": "00:44:12.260",
      "formatted_end": "00:44:16.260",
      "text": "همون نکه سینه یا کلخت یا خورده"
    },
    {
      "id": 83,
      "start": 2656.26,
      "end": 2658.26,
      "formatted_start": "00:44:16.260",
      "formatted_end": "00:44:18.260",
      "text": "بچه دوست نداره بگیره بلد با اقرافی"
    },
    {
      "id": 84,
      "start": 2658.26,
      "end": 2688.26,
      "formatted_start": "00:44:18.260",
      "formatted_end": "00:44:48.260",
      "text": "اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه ا"
    },
    {
      "id": 85,
      "start": 2688.26,
      "end": 2700.0,
      "formatted_start": "00:44:48.260",
      "formatted_end": "00:45:00.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برد"
    }
