  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3929.98,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 3930.0,
      "end": 3959.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:59.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 3960.0,
      "end": 3962.0,
      "formatted_start": "01:06:00.000",
      "formatted_end": "01:06:02.000",
      "text": "خیلی"
    },
    {
      "id": 3,
      "start": 3990.0,
      "end": 4019.0,
      "formatted_start": "01:06:30.000",
      "formatted_end": "01:06:59.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 4019.0,
      "end": 4021.0,
      "formatted_start": "01:06:59.000",
      "formatted_end": "01:07:01.000",
      "text": "بفرمایی که داریشو گرفتیم خواهیم میدونی باز؟"
    },
    {
      "id": 5,
      "start": 4021.0,
      "end": 4023.0,
      "formatted_start": "01:07:01.000",
      "formatted_end": "01:07:03.000",
      "text": "بفرمایی فقط یه شربت داریم"
    },
    {
      "id": 6,
      "start": 4023.0,
      "end": 4024.0,
      "formatted_start": "01:07:03.000",
      "formatted_end": "01:07:04.000",
      "text": "بله"
    },
    {
      "id": 7,
      "start": 4024.0,
      "end": 4027.0,
      "formatted_start": "01:07:04.000",
      "formatted_end": "01:07:07.000",
      "text": "خب روزی سه بار، این داشت خوابش هم پیش داره"
    },
    {
      "id": 8,
      "start": 4027.0,
      "end": 4029.0,
      "formatted_start": "01:07:07.000",
      "formatted_end": "01:07:09.000",
      "text": "یک ونین سی سی تا دو سی سی"
    },
    {
      "id": 9,
      "start": 4029.0,
      "end": 4031.0,
      "formatted_start": "01:07:09.000",
      "formatted_end": "01:07:11.000",
      "text": "یک ونین سی سی تا دو سی سی"
    },
    {
      "id": 10,
      "start": 4031.0,
      "end": 4033.0,
      "formatted_start": "01:07:11.000",
      "formatted_end": "01:07:13.000",
      "text": "یعنی یک قطعه چه کام پر، بی کامی یه نصفه"
    },
    {
      "id": 11,
      "start": 4033.0,
      "end": 4035.0,
      "formatted_start": "01:07:13.000",
      "formatted_end": "01:07:15.000",
      "text": "خواهیش می کنم"
    },
    {
      "id": 12,
      "start": 4035.0,
      "end": 4041.0,
      "formatted_start": "01:07:15.000",
      "formatted_end": "01:07:21.000",
      "text": "خیلی ممنون، بعد آقا تو اون شربتی که موردی دادین آزیزو مارسی نیوینا رو بدم"
    },
    {
      "id": 13,
      "start": 4041.0,
      "end": 4043.0,
      "formatted_start": "01:07:21.000",
      "formatted_end": "01:07:23.000",
      "text": "خیلی ممنون"
    },
    {
      "id": 14,
      "start": 4043.0,
      "end": 4045.0,
      "formatted_start": "01:07:23.000",
      "formatted_end": "01:07:25.000",
      "text": "خواهیم باشیم"
    },
    {
      "id": 15,
      "start": 4045.0,
      "end": 4047.0,
      "formatted_start": "01:07:25.000",
      "formatted_end": "01:07:27.000",
      "text": "خواهیم باشیم"
    },
    {
      "id": 16,
      "start": 4047.0,
      "end": 4049.0,
      "formatted_start": "01:07:27.000",
      "formatted_end": "01:07:29.000",
      "text": "خواهیم باشیم"
    },
    {
      "id": 17,
      "start": 4049.0,
      "end": 4072.0,
      "formatted_start": "01:07:29.000",
      "formatted_end": "01:07:52.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 4072.0,
      "end": 4077.5,
      "formatted_start": "01:07:52.000",
      "formatted_end": "01:07:57.500",
      "text": "دکتر فاچنالی خوب ختمی می کنه و دکتر سکوتی"
    },
    {
      "id": 19,
      "start": 4077.5,
      "end": 4080.0,
      "formatted_start": "01:07:57.500",
      "formatted_end": "01:08:00.000",
      "text": "این دوتا معمولا کارشون خواهد می کنه"
    },
    {
      "id": 20,
      "start": 4080.0,
      "end": 4081.0,
      "formatted_start": "01:08:00.000",
      "formatted_end": "01:08:01.000",
      "text": "جفتشون خوبه؟"
    },
    {
      "id": 21,
      "start": 4081.0,
      "end": 4082.0,
      "formatted_start": "01:08:01.000",
      "formatted_end": "01:08:02.000",
      "text": "جفت"
    },
    {
      "id": 22,
      "start": 4082.0,
      "end": 4084.0,
      "formatted_start": "01:08:02.000",
      "formatted_end": "01:08:04.000",
      "text": "میگن حلقه و بخشی"
    },
    {
      "id": 23,
      "start": 4084.0,
      "end": 4086.0,
      "formatted_start": "01:08:04.000",
      "formatted_end": "01:08:06.000",
      "text": "حلقه بهتره بخشی نسان"
    },
    {
      "id": 24,
      "start": 4086.0,
      "end": 4088.0,
      "formatted_start": "01:08:06.000",
      "formatted_end": "01:08:08.000",
      "text": "بخشی خدیده میده اینکه از این کار نیست"
    },
    {
      "id": 25,
      "start": 4088.0,
      "end": 4090.0,
      "formatted_start": "01:08:08.000",
      "formatted_end": "01:08:10.000",
      "text": "حلقه صافتر و بهتره چیزی"
    },
    {
      "id": 26,
      "start": 4090.0,
      "end": 4091.0,
      "formatted_start": "01:08:10.000",
      "formatted_end": "01:08:11.000",
      "text": "دستشان درده"
    },
    {
      "id": 27,
      "start": 4091.0,
      "end": 4092.0,
      "formatted_start": "01:08:11.000",
      "formatted_end": "01:08:12.000",
      "text": "خواهشون خواهد می کنن خودت"
    },
    {
      "id": 28,
      "start": 4102.0,
      "end": 4112.0,
      "formatted_start": "01:08:22.000",
      "formatted_end": "01:08:32.000",
      "text": "موسیقی"
    },
    {
      "id": 29,
      "start": 4132.0,
      "end": 4162.0,
      "formatted_start": "01:08:52.000",
      "formatted_end": "01:09:22.000",
