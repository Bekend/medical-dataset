  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4504.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:04.000",
      "text": "خب چی شده؟"
    },
    {
      "id": 1,
      "start": 4504.0,
      "end": 4510.0,
      "formatted_start": "01:15:04.000",
      "formatted_end": "01:15:10.000",
      "text": "برگتون رو داده بود که..."
    },
    {
      "id": 2,
      "start": 4510.0,
      "end": 4513.0,
      "formatted_start": "01:15:10.000",
      "formatted_end": "01:15:13.000",
      "text": "احساس میکنه خانم ورانی زرد شده؟"
    },
    {
      "id": 3,
      "start": 4513.0,
      "end": 4514.0,
      "formatted_start": "01:15:13.000",
      "formatted_end": "01:15:14.000",
      "text": "آه"
    },
    {
      "id": 4,
      "start": 4514.0,
      "end": 4515.0,
      "formatted_start": "01:15:14.000",
      "formatted_end": "01:15:15.000",
      "text": "چند روزشه؟"
    },
    {
      "id": 5,
      "start": 4515.0,
      "end": 4517.0,
      "formatted_start": "01:15:15.000",
      "formatted_end": "01:15:17.000",
      "text": "سه"
    },
    {
      "id": 6,
      "start": 4517.0,
      "end": 4519.0,
      "formatted_start": "01:15:17.000",
      "formatted_end": "01:15:19.000",
      "text": "چند روز؟"
    },
    {
      "id": 7,
      "start": 4519.0,
      "end": 4522.0,
      "formatted_start": "01:15:19.000",
      "formatted_end": "01:15:22.000",
      "text": "از سه روز یا چه روز شده؟"
    },
    {
      "id": 8,
      "start": 4522.0,
      "end": 4523.0,
      "formatted_start": "01:15:22.000",
      "formatted_end": "01:15:23.000",
      "text": "دقیقا میدونی؟"
    },
    {
      "id": 9,
      "start": 4523.0,
      "end": 4524.0,
      "formatted_start": "01:15:23.000",
      "formatted_end": "01:15:24.000",
      "text": "چه روز شده؟"
    },
    {
      "id": 10,
      "start": 4524.0,
      "end": 4526.0,
      "formatted_start": "01:15:24.000",
      "formatted_end": "01:15:26.000",
      "text": "چهارشنبه بده"
    },
    {
      "id": 11,
      "start": 4526.0,
      "end": 4527.0,
      "formatted_start": "01:15:26.000",
      "formatted_end": "01:15:27.000",
      "text": "چهارشنبه؟"
    },
    {
      "id": 12,
      "start": 4527.0,
      "end": 4535.0,
      "formatted_start": "01:15:27.000",
      "formatted_end": "01:15:35.000",
      "text": "مدرش خانداشته دوران بارگری"
    },
    {
      "id": 13,
      "start": 4535.0,
      "end": 4539.0,
      "formatted_start": "01:15:35.000",
      "formatted_end": "01:15:39.000",
      "text": "این کشا اشکالی نداره"
    },
    {
      "id": 14,
      "start": 4539.0,
      "end": 4543.0,
      "formatted_start": "01:15:39.000",
      "formatted_end": "01:15:43.000",
      "text": "این فردنش هم از درسته"
    },
    {
      "id": 15,
      "start": 4543.0,
      "end": 4551.0,
      "formatted_start": "01:15:43.000",
      "formatted_end": "01:15:51.000",
      "text": "مدرش خونه"
    },
    {
      "id": 16,
      "start": 4551.0,
      "end": 4553.0,
      "formatted_start": "01:15:51.000",
      "formatted_end": "01:15:53.000",
      "text": "بخوایید در اینجا بزنید"
    },
    {
      "id": 17,
      "start": 4553.0,
      "end": 4555.0,
      "formatted_start": "01:15:53.000",
      "formatted_end": "01:15:55.000",
      "text": "بخوایید در اینجا بزنید"
    },
    {
      "id": 18,
      "start": 4555.0,
      "end": 4580.0,
      "formatted_start": "01:15:55.000",
      "formatted_end": "01:16:20.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 4580.0,
      "end": 4584.24,
      "formatted_start": "01:16:20.000",
      "formatted_end": "01:16:24.240",
      "text": "خب ببینید خانمی مهفقارانی کاملا زرده"
    },
    {
      "id": 20,
      "start": 4584.24,
      "end": 4588.24,
      "formatted_start": "01:16:24.240",
      "formatted_end": "01:16:28.240",
      "text": "زردهش هم دیسبتا زیاده شد شکمش هم زرده اینا خب"
    },
    {
      "id": 21,
      "start": 4588.24,
      "end": 4591.24,
      "formatted_start": "01:16:28.240",
      "formatted_end": "01:16:31.240",
      "text": "یا باید بستری کنید یا دستگاه ببرید خونه"
    },
    {
      "id": 22,
      "start": 4591.24,
      "end": 4592.24,
      "formatted_start": "01:16:31.240",
      "formatted_end": "01:16:32.240",
      "text": "دستگاه ببرید"
    },
    {
      "id": 23,
      "start": 4592.24,
      "end": 4595.24,
      "formatted_start": "01:16:32.240",
      "formatted_end": "01:16:35.240",
      "text": "آره یه سه شبانی روز بمونشیم بگید"
    },
    {
      "id": 24,
      "start": 4595.24,
      "end": 4599.24,
      "formatted_start": "01:16:35.240",
      "formatted_end": "01:16:39.240",
      "text": "یه مرسی همینیست هم از دارو خانه بگید صبح و شب یه چارانسو آپر کنید"
    },
    {
      "id": 25,
      "start": 4599.24,
      "end": 4601.24,
      "formatted_start": "01:16:39.240",
      "formatted_end": "01:16:41.240",
      "text": "یه سه شبانی روز هم دستگاه خونه بزنید"
    },
    {
      "id": 26,
      "start": 4601.24,
      "end": 4602.24,
      "formatted_start": "01:16:41.240",
      "formatted_end": "01:16:42.240",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 4610.0,
      "end": 4632.0,
      "formatted_start": "01:16:50.000",
      "formatted_end": "01:17:12.000",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 4632.0,
      "end": 4634.0,
      "formatted_start": "01:17:12.000",
      "formatted_end": "01:17:14.000",
      "text": "نه بقیه چیزش خوبه"
    },
    {
      "id": 29,
      "start": 4634.0,
      "end": 4636.0,
      "formatted_start": "01:17:14.000",
      "formatted_end": "01:17:16.000",
      "text": "خدا نیست"
    },
    {
      "id": 30,
      "start": 4636.0,
      "end": 4638.0,
      "formatted_start": "01:17:16.000",
      "formatted_end": "01:17:18.000",
      "text": "ما خوشیم و همون خوب بگیرم"
    },
    {
      "id": 31,
      "start": 4638.0,
      "end": 4640.0,
      "formatted_start": "01:17:18.000",
      "formatted_end": "01:17:20.000",
      "text": "مرسی"
    },
    {
      "id": 32,
      "start": 4662.0,
      "end": 4690.0,
      "formatted_start": "01:17:42.000",
      "formatted_end": "01:18:10.000",
      "text": "موسیقی"
    },
    {
      "id": 33,
      "start": 4692.0,
      "end": 4702.0,
      "formatted_start": "01:18:12.000",
      "formatted_end": "01:18:22.000",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 4722.0,
      "end": 4745.0,
      "formatted_start": "01:18:42.000",
      "formatted_end": "01:19:05.000",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 4745.0,
      "end": 4754.0,
      "formatted_start": "01:19:05.000",
      "formatted_end": "01:19:14.000",
      "text": "خبر خیلی، چند جالبی که مانداد امروز مدشه شده، این است که رئیس جدید مساد از مجلس کار مساد را برکنر کرده"
    },
    {
      "id": 36,
      "start": 4754.0,
      "end": 4758.0,
      "formatted_start": "01:19:14.000",
      "formatted_end": "01:19:18.000",
      "text": "یکیش رئیس رقم احتلافات مساد بوده و دیگری رئیس برشای ایران"
    },
    {
      "id": 37,
      "start": 4758.0,
      "end": 4765.0,
      "formatted_start": "01:19:18.000",
      "formatted_end": "01:19:25.000",
      "text": "رئیس برشای ایران تمام تلاشش و معمولی ازش این بوده است که چگونه تحریزی میشه و اقناعاتی انجام میشه"
    },
    {
      "id": 38,
      "start": 4765.0,
      "end": 4768.0,
      "formatted_start": "01:19:25.000",
      "formatted_end": "01:19:28.000",
      "text": "که به طلب حکومت گنونه این در ایران را برده"
    },
    {
      "id": 39,
      "start": 4768.0,
      "end": 4786.0,
      "formatted_start": "01:19:28.000",
      "formatted_end": "01:19:46.000",
      "text": "موسیقی"
    },
    {
      "id": 40,
      "start": 4786.0,
      "end": 4792.16,
