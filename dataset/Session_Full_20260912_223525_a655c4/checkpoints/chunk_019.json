  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5707.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:07.000",
      "text": "اینو ببینید، زرگه، اینو ببینید اون جنگش که بزرگ شده، سرش درشگاه بذارید."
    },
    {
      "id": 1,
      "start": 5707.0,
      "end": 5719.0,
      "formatted_start": "01:35:07.000",
      "formatted_end": "01:35:19.000",
      "text": "حتما، یه چند شبیه، شبانه روز بیدید، خانه سرمانی، به ماشین بگید، یه دستگاه خوب بذارید، زورت بیاد تاییده، بسیار مشکل میگرد."
    },
    {
      "id": 2,
      "start": 5719.0,
      "end": 5720.0,
      "formatted_start": "01:35:19.000",
      "formatted_end": "01:35:20.000",
      "text": "با شبانه روز؟"
    },
    {
      "id": 3,
      "start": 5720.0,
      "end": 5729.0,
      "formatted_start": "01:35:20.000",
      "formatted_end": "01:35:29.000",
      "text": "نه نه، شبانه روز، هر چه پیشتر بذارید، بهتره، ما مثلا، چند شب میگید، منظورم اینکه شبانه روز، مثلا منظورم."
    },
    {
      "id": 4,
      "start": 5729.0,
      "end": 5759.0,
      "formatted_start": "01:35:29.000",
      "formatted_end": "01:35:59.000",
      "text": "اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه ا"
    },
    {
      "id": 5,
      "start": 5789.0,
      "end": 5818.98,
      "formatted_start": "01:36:29.000",
      "formatted_end": "01:36:58.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 6,
      "start": 5819.0,
      "end": 5839.0,
      "formatted_start": "01:36:59.000",
      "formatted_end": "01:37:19.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 5849.0,
      "end": 5868.0,
      "formatted_start": "01:37:29.000",
      "formatted_end": "01:37:48.000",
      "text": "این که کرونا دا سال آخر است، اون چیز که بین برس مونده بود، خیلی دار میگن اگر آمریکا بخواد در یک جنگی بی بی سی اند بشه، یا برو بشه، اون یک کاری که کشوری که اون اقتصاد هم عبرتی بشه برای دیگر هم، یعنی اینو بی هزینه پیش نمیبرده"
    },
    {
      "id": 8,
      "start": 5868.0,
      "end": 5872.68,
      "formatted_start": "01:37:48.000",
      "formatted_end": "01:37:52.680",
      "text": "اینکه همون جنگ هایی جنگ آمریکا رفته ورد رو بمانه عبرت ازش یاد میشه"
    },
    {
      "id": 9,
      "start": 5872.68,
      "end": 5877.24,
      "formatted_start": "01:37:52.680",
      "formatted_end": "01:37:57.240",
      "text": "اون کشوری هایی که ازش به جا مونده اونم یه عبرتی شده در باره"
    },
    {
      "id": 10,
      "start": 5877.24,
      "end": 5878.24,
      "formatted_start": "01:37:57.240",
      "formatted_end": "01:37:58.240",
      "text": "نه نمیدونی"
    },
    {
      "id": 11,
      "start": 5878.24,
      "end": 5880.24,
      "formatted_start": "01:37:58.240",
      "formatted_end": "01:38:00.240",
      "text": "چون ما خود ما شکست ندهیم"
    },
    {
      "id": 12,
      "start": 5880.24,
      "end": 5883.52,
      "formatted_start": "01:38:00.240",
      "formatted_end": "01:38:03.520",
      "text": "نه نمیدونی، شکست نیست، اون دارا فیوز نداره"
    },
    {
      "id": 13,
      "start": 5883.52,
      "end": 5887.12,
      "formatted_start": "01:38:03.520",
      "formatted_end": "01:38:07.120",
      "text": "اون باید به این سطح برده که به اون محتاطی که داره نمیرسه"
    },
    {
      "id": 14,
      "start": 5887.12,
      "end": 5890.32,
      "formatted_start": "01:38:07.120",
      "formatted_end": "01:38:10.320",
      "text": "نفت ایران رو نتاقب نیست، نفت در هم نسیده"
    },
    {
      "id": 15,
      "start": 5890.32,
      "end": 5893.76,
      "formatted_start": "01:38:10.320",
      "formatted_end": "01:38:13.760",
      "text": "اقساط آن را برابر می کنید، قیمت نقص باید دو سال بعد را بزنید"
    },
    {
      "id": 16,
      "start": 5893.76,
      "end": 5897.38,
      "formatted_start": "01:38:13.760",
      "formatted_end": "01:38:17.380",
      "text": "چون ایران پناه زدن را دارد که این تفاوتی دارد"
    },
    {
      "id": 17,
      "start": 5897.38,
      "end": 5901.38,
      "formatted_start": "01:38:17.380",
      "formatted_end": "01:38:21.380",
      "text": "سیاست را قبل از ما بیدیم، یعنی سیاست های سنتی"
    },
    {
      "id": 18,
      "start": 5901.38,
      "end": 5904.88,
      "formatted_start": "01:38:21.380",
      "formatted_end": "01:38:24.880",
      "text": "دیگه کمتر از ما این چما نمیتونید، نرسیدید"
    },
    {
      "id": 19,
      "start": 5904.88,
      "end": 5906.88,
      "formatted_start": "01:38:24.880",
      "formatted_end": "01:38:26.880",
      "text": "من میگم رسیدید کمتر اینکه نرسیدید؟"
    },
    {
      "id": 20,
      "start": 5906.88,
      "end": 5910.72,
      "formatted_start": "01:38:26.880",
      "formatted_end": "01:38:30.720",
      "text": "نرسیدید، نرسیدید، همونطور که گفتیم که چما یک لیستی درگرم می کنید"
    },
    {
      "id": 21,
      "start": 5910.72,
      "end": 5912.72,
      "formatted_start": "01:38:30.720",
      "formatted_end": "01:38:32.720",
      "text": "یعنی همین تحلیل کنی کافیه؟"
    },
    {
      "id": 22,
      "start": 5912.72,
      "end": 5913.22,
      "formatted_start": "01:38:32.720",
      "formatted_end": "01:38:33.220",
      "text": "آره"
    },
    {
      "id": 23,
      "start": 5913.22,
      "end": 5915.22,
      "formatted_start": "01:38:33.220",
      "formatted_end": "01:38:35.220",
      "text": "و آخرن باید بگیر نشین به اسم این مقاماتی گیرده"
    },
    {
      "id": 24,
      "start": 5915.22,
      "end": 5916.22,
      "formatted_start": "01:38:35.220",
      "formatted_end": "01:38:36.220",
      "text": "میگه نشین دیگر"
    },
    {
      "id": 25,
      "start": 5916.22,
      "end": 5918.22,
      "formatted_start": "01:38:36.220",
      "formatted_end": "01:38:38.220",
      "text": "یک نشین به تجربه شما دیگه"
    },
    {
      "id": 26,
      "start": 5918.22,
      "end": 5920.22,
      "formatted_start": "01:38:38.220",
      "formatted_end": "01:38:40.220",
      "text": "صدراتی که همون صدرات بگیری"
    },
    {
      "id": 27,
      "start": 5920.22,
      "end": 5922.22,
      "formatted_start": "01:38:40.220",
      "formatted_end": "01:38:42.220",
      "text": "صدراتی که همون صدرات بگیری"
    },
    {
      "id": 28,
      "start": 5922.22,
      "end": 5923.22,
      "formatted_start": "01:38:42.220",
      "formatted_end": "01:38:43.220",
      "text": "اینها رو باور نکنید"
    },
    {
      "id": 29,
      "start": 5923.22,
      "end": 5924.22,
      "formatted_start": "01:38:43.220",
      "formatted_end": "01:38:44.220",
      "text": "اینها باید کافیه ندارستن"
    },
    {
      "id": 30,
      "start": 5924.22,
      "end": 5926.22,
      "formatted_start": "01:38:44.220",
      "formatted_end": "01:38:46.220",
      "text": "برای ما صدرات با هاچی زاده هم داشتیم"
    },
    {
      "id": 31,
      "start": 5926.22,
      "end": 5926.72,
      "formatted_start": "01:38:46.220",
      "formatted_end": "01:38:46.720",
      "text": "چکل داشتیم"
    },
    {
      "id": 32,
      "start": 5926.72,
      "end": 5927.22,
      "formatted_start": "01:38:46.720",
      "formatted_end": "01:38:47.220",
      "text": "داریم"
    },
    {
      "id": 33,
      "start": 5927.22,
      "end": 5928.72,
      "formatted_start": "01:38:47.220",
      "formatted_end": "01:38:48.720",
      "text": "انشابه شخصی هست"
    },
    {
      "id": 34,
      "start": 5928.72,
      "end": 5933.2,
      "formatted_start": "01:38:48.720",
      "formatted_end": "01:38:53.200",
      "text": "میشون میگفتند که اگر برد از جنگ دوازه های بزرگیزه"
    },
    {
      "id": 35,
      "start": 5933.2,
      "end": 5936.0,
      "formatted_start": "01:38:53.200",
      "formatted_end": "01:38:56.000",
      "text": "میگفتند که اگر ما حمله بخونیم"
    },
    {
      "id": 36,
      "start": 5936.0,
      "end": 5938.0,
      "formatted_start": "01:38:56.000",
      "formatted_end": "01:38:58.000",
      "text": "پنجا هزار میگو اینجا هستش"
    },
    {
      "id": 37,
      "start": 5938.0,
      "end": 5940.0,
      "formatted_start": "01:38:58.000",
      "formatted_end": "01:39:00.000",
      "text": "پندرده تا پایگا ها اینجا هستش"
    },
    {
      "id": 38,
      "start": 5940.0,
      "end": 5942.0,
      "formatted_start": "01:39:00.000",
      "formatted_end": "01:39:02.000",
      "text": "کسی که بیرون ساخته بادی شیشه اونی هست"
    },
    {
      "id": 39,
      "start": 5942.0,
      "end": 5944.0,
      "formatted_start": "01:39:02.000",
      "formatted_end": "01:39:04.000",
      "text": "چیهه؟ سند برده بخونیم"
    },
    {
      "id": 40,
      "start": 5944.0,
      "end": 5946.0,
      "formatted_start": "01:39:04.000",
      "formatted_end": "01:39:06.000",
      "text": "میشون میگفتند برد از جنگ دوازه های بزرگیزه"
    },
    {
      "id": 41,
      "start": 5946.0,
      "end": 5948.0,
      "formatted_start": "01:39:06.000",
      "formatted_end": "01:39:08.000",
      "text": "باید بکنیم"
    },
    {
      "id": 42,
      "start": 5948.0,
      "end": 5950.0,
      "formatted_start": "01:39:08.000",
      "formatted_end": "01:39:10.000",
      "text": "حمله کردن"
    },
    {
      "id": 43,
      "start": 5950.0,
      "end": 5952.0,
      "formatted_start": "01:39:10.000",
      "formatted_end": "01:39:12.000",
      "text": "چنانوشون رسیش را اتناه دیده نبیدن"
    },
    {
      "id": 44,
      "start": 5952.0,
      "end": 5972.0,
      "formatted_start": "01:39:12.000",
      "formatted_end": "01:39:32.000",
      "text": "موسیقی"
    },
    {
      "id": 45,
      "start": 5972.0,
      "end": 6000.0,
      "formatted_start": "01:39:32.000",
      "formatted_end": "01:40:00.000",
      "text": "موسیقی"
    }
  ],
