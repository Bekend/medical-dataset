  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5410.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:10.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5458.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:58.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 5458.0,
      "end": 5460.0,
      "formatted_start": "01:30:58.000",
      "formatted_end": "01:31:00.000",
      "text": "بخواهیم بخواهیم"
    },
    {
      "id": 3,
      "start": 5460.0,
      "end": 5462.0,
      "formatted_start": "01:31:00.000",
      "formatted_end": "01:31:02.000",
      "text": "خوشید خوشید خوشید"
    },
    {
      "id": 4,
      "start": 5462.0,
      "end": 5464.0,
      "formatted_start": "01:31:02.000",
      "formatted_end": "01:31:04.000",
      "text": "بخواهیم چی شده خانکوستانی؟"
    },
    {
      "id": 5,
      "start": 5464.0,
      "end": 5466.0,
      "formatted_start": "01:31:04.000",
      "formatted_end": "01:31:06.000",
      "text": "نه"
    },
    {
      "id": 6,
      "start": 5466.0,
      "end": 5468.0,
      "formatted_start": "01:31:06.000",
      "formatted_end": "01:31:08.000",
      "text": "چیز مصمم شده صبح"
    },
    {
      "id": 7,
      "start": 5468.0,
      "end": 5470.0,
      "formatted_start": "01:31:08.000",
      "formatted_end": "01:31:10.000",
      "text": "برسه فهوای کوستانی هاو شما خوبه"
    },
    {
      "id": 8,
      "start": 5470.0,
      "end": 5472.0,
      "formatted_start": "01:31:10.000",
      "formatted_end": "01:31:12.000",
      "text": "خوش آمدید"
    },
    {
      "id": 9,
      "start": 5472.0,
      "end": 5474.0,
      "formatted_start": "01:31:12.000",
      "formatted_end": "01:31:14.000",
      "text": "چه علایی میدارید؟"
    },
    {
      "id": 10,
      "start": 5474.0,
      "end": 5476.0,
      "formatted_start": "01:31:14.000",
      "formatted_end": "01:31:16.000",
      "text": "من هم شکرمشید"
    },
    {
      "id": 11,
      "start": 5476.0,
      "end": 5478.0,
      "formatted_start": "01:31:16.000",
      "formatted_end": "01:31:18.000",
      "text": "استفراق و اصحار"
    },
    {
      "id": 12,
      "start": 5478.0,
      "end": 5480.0,
      "formatted_start": "01:31:18.000",
      "formatted_end": "01:31:20.000",
      "text": "تب اینا چی؟"
    },
    {
      "id": 13,
      "start": 5480.0,
      "end": 5482.0,
      "formatted_start": "01:31:20.000",
      "formatted_end": "01:31:22.000",
      "text": "نه من هم صبح نشده که نتاب ندارم"
    },
    {
      "id": 14,
      "start": 5482.0,
      "end": 5484.0,
      "formatted_start": "01:31:22.000",
      "formatted_end": "01:31:24.000",
      "text": "چند بار اصحار بود از صبح؟"
    },
    {
      "id": 15,
      "start": 5484.0,
      "end": 5486.0,
      "formatted_start": "01:31:24.000",
      "formatted_end": "01:31:26.000",
      "text": "اصحار هم نام آمدیم یه نیم ساعت پیش"
    },
    {
      "id": 16,
      "start": 5486.0,
      "end": 5488.0,
      "formatted_start": "01:31:26.000",
      "formatted_end": "01:31:28.000",
      "text": "برای هر چی میدونی باید برم میاد"
    },
    {
      "id": 17,
      "start": 5488.0,
      "end": 5489.0,
      "formatted_start": "01:31:28.000",
      "formatted_end": "01:31:29.000",
      "text": "همون نه"
    },
    {
      "id": 18,
      "start": 5489.0,
      "end": 5491.0,
      "formatted_start": "01:31:29.000",
      "formatted_end": "01:31:31.000",
      "text": "دلت بخونه"
    },
    {
      "id": 19,
      "start": 5491.0,
      "end": 5493.0,
      "formatted_start": "01:31:31.000",
      "formatted_end": "01:31:33.000",
      "text": "دلت رو باشم"
    },
    {
      "id": 20,
      "start": 5497.0,
      "end": 5500.0,
      "formatted_start": "01:31:37.000",
      "formatted_end": "01:31:40.000",
      "text": "اونو همه چی رو هم میکنه"
    },
    {
      "id": 21,
      "start": 5500.0,
      "end": 5502.0,
      "formatted_start": "01:31:40.000",
      "formatted_end": "01:31:42.000",
      "text": "پاسی پاسی میکنه"
    },
    {
      "id": 22,
      "start": 5502.0,
      "end": 5503.0,
      "formatted_start": "01:31:42.000",
      "formatted_end": "01:31:43.000",
      "text": "آره آره"
    },
    {
      "id": 23,
      "start": 5504.0,
      "end": 5506.0,
      "formatted_start": "01:31:44.000",
      "formatted_end": "01:31:46.000",
      "text": "میگنم نخورده رو هر میشن"
    },
    {
      "id": 24,
      "start": 5506.0,
      "end": 5512.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:31:52.000",
      "text": "بچه ها اون رو سرودی میکنن رو پدر مادر"
    },
    {
      "id": 25,
      "start": 5512.0,
      "end": 5515.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:55.000",
      "text": "پدر مادر هم بند خدا ها"
    },
    {
      "id": 26,
      "start": 5515.0,
      "end": 5524.0,
      "formatted_start": "01:31:55.000",
      "formatted_end": "01:32:04.000",
      "text": "این بری بری کرده این"
    },
    {
      "id": 27,
      "start": 5524.0,
      "end": 5528.0,
      "formatted_start": "01:32:04.000",
      "formatted_end": "01:32:08.000",
      "text": "تو خونه از که دلیل داره دشتید"
    },
    {
      "id": 28,
      "start": 5528.0,
      "end": 5532.0,
      "formatted_start": "01:32:08.000",
      "formatted_end": "01:32:12.000",
      "text": "ببینید کانتروستانی مایات پیشتر بدید"
    },
    {
      "id": 29,
      "start": 5532.0,
      "end": 5534.0,
      "formatted_start": "01:32:12.000",
      "formatted_end": "01:32:14.000",
      "text": "آب، چایی، دو، موز"
    },
    {
      "id": 30,
      "start": 5534.0,
      "end": 5539.0,
      "formatted_start": "01:32:14.000",
      "formatted_end": "01:32:19.000",
      "text": "اما من آن پول زیر استفاده و این ها میبینم که کنترل بشه شروط شم بیدیم"
    },
    {
      "id": 31,
      "start": 5539.0,
      "end": 5544.0,
      "formatted_start": "01:32:19.000",
      "formatted_end": "01:32:24.000",
      "text": "بعد که بهتر شد مایات و موز و کتمازت و کشکینا"
    },
    {
      "id": 32,
      "start": 5544.0,
      "end": 5546.82,
      "formatted_start": "01:32:24.000",
      "formatted_end": "01:32:26.820",
      "text": "چون اعتمال داره اصحال شدید بشه"
    },
    {
      "id": 33,
      "start": 5546.82,
      "end": 5551.62,
      "formatted_start": "01:32:26.820",
      "formatted_end": "01:32:31.620",
      "text": "یعنی استغرافت پروکش میکنه اصحال شدیدتر میشه"
    },
    {
      "id": 34,
      "start": 5551.62,
      "end": 5554.44,
      "formatted_start": "01:32:31.620",
      "formatted_end": "01:32:34.440",
      "text": "این دروهاش هم بگیرین صفت کنن"
    },
    {
      "id": 35,
      "start": 5554.44,
      "end": 5568.58,
      "formatted_start": "01:32:34.440",
      "formatted_end": "01:32:48.580",
      "text": "در حد کفایت"
    },
    {
      "id": 36,
      "start": 5574.0,
      "end": 5577.0,
      "formatted_start": "01:32:54.000",
      "formatted_end": "01:32:57.000",
      "text": "مایات ولی پیشتر بشید"
    },
    {
      "id": 37,
      "start": 5577.0,
      "end": 5580.0,
      "formatted_start": "01:32:57.000",
      "formatted_end": "01:33:00.000",
      "text": "آب هستیم"
    },
    {
      "id": 38,
      "start": 5580.0,
      "end": 5583.0,
      "formatted_start": "01:33:00.000",
      "formatted_end": "01:33:03.000",
      "text": "یکی از نشانی شده"
    },
    {
      "id": 39,
      "start": 5583.0,
      "end": 5586.0,
      "formatted_start": "01:33:03.000",
      "formatted_end": "01:33:06.000",
      "text": "را شگرمان بگیرم"
    },
    {
      "id": 40,
      "start": 5586.0,
      "end": 5589.0,
      "formatted_start": "01:33:06.000",
      "formatted_end": "01:33:09.000",
      "text": "بازر بزنیم"
    },
    {
      "id": 41,
      "start": 5589.0,
      "end": 5592.0,
      "formatted_start": "01:33:09.000",
      "formatted_end": "01:33:12.000",
      "text": "بگیرمان شده"
    },
    {
      "id": 42,
      "start": 5592.0,
      "end": 5595.0,
      "formatted_start": "01:33:12.000",
      "formatted_end": "01:33:15.000",
      "text": "بخواهمی کنم"
    },
    {
      "id": 43,
      "start": 5595.0,
      "end": 5598.0,
      "formatted_start": "01:33:15.000",
      "formatted_end": "01:33:18.000",
      "text": "بخواهمی کنم"
    },
    {
      "id": 44,
      "start": 5598.0,
      "end": 5601.0,
      "formatted_start": "01:33:18.000",
      "formatted_end": "01:33:21.000",
      "text": "سلامت شما خوبه"
    },
    {
      "id": 45,
      "start": 5601.0,
      "end": 5607.0,
      "formatted_start": "01:33:21.000",
      "formatted_end": "01:33:27.000",
      "text": "از که این برگت برگت کنه بیزنگ شده این کار دیگه چی شده؟"
    },
    {
      "id": 46,
      "start": 5607.0,
      "end": 5610.0,
      "formatted_start": "01:33:27.000",
      "formatted_end": "01:33:30.000",
      "text": "از که ای زرد شده؟"
    },
    {
      "id": 47,
      "start": 5610.0,
      "end": 5615.0,
      "formatted_start": "01:33:30.000",
      "formatted_end": "01:33:35.000",
      "text": "بیمارستان بیزرد بود دیگه، این خود دوکرس هریلادی بود که خفیفه"
    },
    {
      "id": 48,
      "start": 5615.0,
      "end": 5618.0,
      "formatted_start": "01:33:35.000",
      "formatted_end": "01:33:38.000",
      "text": "کروخونی مادر و نوزاد؟"
    },
    {
      "id": 49,
      "start": 5618.0,
      "end": 5620.0,
      "formatted_start": "01:33:38.000",
      "formatted_end": "01:33:40.000",
      "text": "پدر؟"
    },
    {
      "id": 50,
      "start": 5620.0,
      "end": 5622.0,
      "formatted_start": "01:33:40.000",
      "formatted_end": "01:33:42.000",
      "text": "هر دو و این؟"
    },
    {
      "id": 51,
      "start": 5622.0,
      "end": 5625.0,
      "formatted_start": "01:33:42.000",
      "formatted_end": "01:33:45.000",
      "text": "باشین خوب خوبه"
    },
    {
      "id": 52,
      "start": 5625.0,
      "end": 5627.0,
      "formatted_start": "01:33:45.000",
      "formatted_end": "01:33:47.000",
      "text": "بچه هم که؟"
    },
    {
      "id": 53,
      "start": 5627.0,
      "end": 5630.0,
      "formatted_start": "01:33:47.000",
      "formatted_end": "01:33:50.000",
      "text": "کروخونی شد، گرفتم بیمارستان؟"
    },
    {
      "id": 54,
      "start": 5630.0,
      "end": 5633.0,
      "formatted_start": "01:33:50.000",
      "formatted_end": "01:33:53.000",
      "text": "بیمارستان برزه خودتون چیزش بودیم؟"
    },
    {
      "id": 55,
      "start": 5633.0,
      "end": 5635.0,
      "formatted_start": "01:33:53.000",
      "formatted_end": "01:33:55.000",
      "text": "بعد؟"
    },
    {
      "id": 56,
      "start": 5635.0,
      "end": 5637.0,
      "formatted_start": "01:33:55.000",
      "formatted_end": "01:33:57.000",
      "text": "بعدش بردنش بردنش بردنش منتظرم تربیل بود"
    },
    {
      "id": 57,
      "start": 5637.0,
      "end": 5638.0,
      "formatted_start": "01:33:57.000",
      "formatted_end": "01:33:58.000",
      "text": "تزام شده؟"
    },
    {
      "id": 58,
      "start": 5638.0,
      "end": 5639.0,
      "formatted_start": "01:33:58.000",
      "formatted_end": "01:33:59.000",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 5647.0,
      "end": 5650.0,
      "formatted_start": "01:34:07.000",
      "formatted_end": "01:34:10.000",
      "text": "بعد صورتش اینا زرد اینجا طولانی شده"
    },
    {
      "id": 60,
      "start": 5651.0,
      "end": 5655.0,
      "formatted_start": "01:34:11.000",
      "formatted_end": "01:34:15.000",
      "text": "خوب، چون زر روز اینجا باید خوب میشه"
    },
    {
      "id": 61,
      "start": 5655.0,
      "end": 5658.0,
      "formatted_start": "01:34:15.000",
      "formatted_end": "01:34:18.000",
      "text": "برای اینکه دامدار شده، باید هم هست"
    },
    {
      "id": 62,
      "start": 5658.0,
      "end": 5664.94,
      "formatted_start": "01:34:18.000",
      "formatted_end": "01:34:24.940",
      "text": "در اینجا باید باید تایین کترونه می بشه"
    },
    {
      "id": 63,
      "start": 5664.94,
      "end": 5667.06,
      "formatted_start": "01:34:24.940",
      "formatted_end": "01:34:27.060",
      "text": "می توانه عوارض ذهنی بذاره"
    },
    {
      "id": 64,
      "start": 5667.06,
      "end": 5684.24,
      "formatted_start": "01:34:27.060",
      "formatted_end": "01:34:44.240",
      "text": "در چوش هم تیران بشه"
    },
    {
      "id": 65,
      "start": 5684.24,
      "end": 5686.18,
      "formatted_start": "01:34:44.240",
      "formatted_end": "01:34:46.180",
      "text": "ارتباط به زرگی نداره"
    },
    {
      "id": 66,
      "start": 5686.18,
      "end": 5688.18,
      "formatted_start": "01:34:46.180",
      "formatted_end": "01:34:48.180",
      "text": "باید برداریم"
    }
  ],
  "status": "completed"
}