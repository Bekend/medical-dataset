  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 629.98,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 630.0,
      "end": 632.0,
      "formatted_start": "00:10:30.000",
      "formatted_end": "00:10:32.000",
      "text": "اینجا بگیرم"
    },
    {
      "id": 2,
      "start": 640.0,
      "end": 642.0,
      "formatted_start": "00:10:40.000",
      "formatted_end": "00:10:42.000",
      "text": "چند ماه شد؟"
    },
    {
      "id": 3,
      "start": 645.0,
      "end": 647.0,
      "formatted_start": "00:10:45.000",
      "formatted_end": "00:10:47.000",
      "text": "در اینجا یه سال دیگه"
    },
    {
      "id": 4,
      "start": 647.0,
      "end": 649.0,
      "formatted_start": "00:10:47.000",
      "formatted_end": "00:10:49.000",
      "text": "یه سال، از که طب کرده؟"
    },
    {
      "id": 5,
      "start": 649.0,
      "end": 651.0,
      "formatted_start": "00:10:49.000",
      "formatted_end": "00:10:51.000",
      "text": "از دیشب"
    },
    {
      "id": 6,
      "start": 651.0,
      "end": 652.0,
      "formatted_start": "00:10:51.000",
      "formatted_end": "00:10:52.000",
      "text": "این اعتمال داره؟"
    },
    {
      "id": 7,
      "start": 652.0,
      "end": 654.0,
      "formatted_start": "00:10:52.000",
      "formatted_end": "00:10:54.000",
      "text": "دیشب، شب طب داشت آقای دوست"
    },
    {
      "id": 8,
      "start": 654.0,
      "end": 658.0,
      "formatted_start": "00:10:54.000",
      "formatted_end": "00:10:58.000",
      "text": "بله، ببینیم خوشتاری اعتمال داره این طبش سه نزن تون رو کیشه"
    },
    {
      "id": 9,
      "start": 658.0,
      "end": 660.0,
      "formatted_start": "00:10:58.000",
      "formatted_end": "00:11:00.000",
      "text": "ای بالا بره ای بیر پایی"
    },
    {
      "id": 10,
      "start": 660.0,
      "end": 663.0,
      "formatted_start": "00:11:00.000",
      "formatted_end": "00:11:03.000",
      "text": "خوب این طب رو باید کنترلو کنی که تشنراش نکنه"
    },
    {
      "id": 11,
      "start": 663.0,
      "end": 666.0,
      "formatted_start": "00:11:03.000",
      "formatted_end": "00:11:06.000",
      "text": "خوب یه بیماری هست که به این شکل هست"
    },
    {
      "id": 12,
      "start": 666.0,
      "end": 668.0,
      "formatted_start": "00:11:06.000",
      "formatted_end": "00:11:08.000",
      "text": "من دارو براش می رویسم"
    },
    {
      "id": 13,
      "start": 668.0,
      "end": 671.0,
      "formatted_start": "00:11:08.000",
      "formatted_end": "00:11:11.000",
      "text": "از سامنه فون هر چهار ساعت به چهار ساعت دو بره بره وزن شده"
    },
    {
      "id": 14,
      "start": 671.0,
      "end": 673.0,
      "formatted_start": "00:11:11.000",
      "formatted_end": "00:11:13.000",
      "text": "وزنی چند کیلوه؟"
    },
    {
      "id": 15,
      "start": 674.0,
      "end": 676.0,
      "formatted_start": "00:11:14.000",
      "formatted_end": "00:11:16.000",
      "text": "هشت کیلوه، بشت کیلوه"
    },
    {
      "id": 16,
      "start": 676.0,
      "end": 677.0,
      "formatted_start": "00:11:16.000",
      "formatted_end": "00:11:17.000",
      "text": "شنزده قطعه"
    },
    {
      "id": 17,
      "start": 678.0,
      "end": 679.0,
      "formatted_start": "00:11:18.000",
      "formatted_end": "00:11:19.000",
      "text": "خوب؟"
    },
    {
      "id": 18,
      "start": 681.0,
      "end": 684.0,
      "formatted_start": "00:11:21.000",
      "formatted_end": "00:11:24.000",
      "text": "بعد آقایی دو دو اشتباه قبلش بی قراری داشت"
    },
    {
      "id": 19,
      "start": 684.0,
      "end": 685.0,
      "formatted_start": "00:11:24.000",
      "formatted_end": "00:11:25.000",
      "text": "خیلی بیده"
    },
    {
      "id": 20,
      "start": 685.0,
      "end": 686.0,
      "formatted_start": "00:11:25.000",
      "formatted_end": "00:11:26.000",
      "text": "اونو آرام بوده؟"
    },
    {
      "id": 21,
      "start": 688.0,
      "end": 690.0,
      "formatted_start": "00:11:28.000",
      "formatted_end": "00:11:30.000",
      "text": "مردی از اینجا باید بردارید"
    },
    {
      "id": 22,
      "start": 690.0,
      "end": 692.0,
      "formatted_start": "00:11:30.000",
      "formatted_end": "00:11:32.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 23,
