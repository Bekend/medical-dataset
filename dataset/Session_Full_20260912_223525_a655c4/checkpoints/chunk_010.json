  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3015.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:15.000",
      "text": "اگر از در ارزشمند نیشید، ارزش دریا فاید کردن. در این صورت، فیلیست در کامیونیتی ما جایی نداره متاسفانه این زیره من چقدر جلس رو بلزم کنیم، بیشترشون میده که چقدر ناغایی و سلیده."
    },
    {
      "id": 1,
      "start": 3015.0,
      "end": 3024.0,
      "formatted_start": "00:50:15.000",
      "formatted_end": "00:50:24.000",
      "text": "خلاصه اینکه بیان مثل دوتا آدم بالغ و آقا رابطه درست بزنید. نه شما از ما ارزشمندتری، نه ما لنگ شماییم."
    },
    {
      "id": 2,
      "start": 3024.0,
      "end": 3030.58,
      "formatted_start": "00:50:24.000",
      "formatted_end": "00:50:30.580",
      "text": "هر دو برای یک هدف مشترک وارد رابطه میشیم، هر نام سن و خودمون رو بیزاریم، هر دو هم عرضش میکنیم"
    },
    {
      "id": 3,
      "start": 3030.58,
      "end": 3034.18,
      "formatted_start": "00:50:30.580",
      "formatted_end": "00:50:34.180",
      "text": "نمیتونی عرضش بیدی به ورد زندگی، تو عرض رابطه شدید"
    },
    {
      "id": 4,
      "start": 3034.18,
      "end": 3039.52,
      "formatted_start": "00:50:34.180",
      "formatted_end": "00:50:39.520",
      "text": "با باهادش رو هم کردن، چون با شما رو عرضش میکنید، نمیبینید که آقایی شما ما رو عرضش کنند"
    },
    {
      "id": 5,
      "start": 3039.52,
      "end": 3042.36,
      "formatted_start": "00:50:39.520",
      "formatted_end": "00:50:42.360",
      "text": "عزیزم تو کامیونیتی ما از این خبر ها بسیار"
    },
    {
      "id": 6,
      "start": 3042.36,
      "end": 3045.88,
      "formatted_start": "00:50:42.360",
      "formatted_end": "00:50:45.880",
      "text": "بزرگشتون که بزرگشتون که شما میباید از مردها سوارید"
    },
    {
      "id": 7,
      "start": 3045.88,
      "end": 3048.36,
      "formatted_start": "00:50:45.880",
      "formatted_end": "00:50:48.360",
      "text": "داستان داره یک شباش عوض میشه چون"
    },
    {
      "id": 8,
      "start": 3048.36,
      "end": 3050.32,
      "formatted_start": "00:50:48.360",
      "formatted_end": "00:50:50.320",
      "text": "مردها دارن آگاه میشن"
    },
    {
      "id": 9,
      "start": 3050.32,
      "end": 3052.72,
      "formatted_start": "00:50:50.320",
      "formatted_end": "00:50:52.720",
      "text": "میدونی نه آگاه که میشه دوره کتایی داره"
    },
    {
      "id": 10,
      "start": 3052.72,
      "end": 3055.44,
      "formatted_start": "00:50:52.720",
      "formatted_end": "00:50:55.440",
      "text": "تو اون دوره این مورد خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی"
    },
    {
      "id": 11,
      "start": 3055.44,
      "end": 3059.36,
      "formatted_start": "00:50:55.440",
      "formatted_end": "00:50:59.360",
      "text": "بعد این بار به زن صبح"
    },
    {
      "id": 12,
      "start": 3069.52,
      "end": 3097.52,
      "formatted_start": "00:51:09.520",
      "formatted_end": "00:51:37.520",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 3099.52,
      "end": 3112.52,
      "formatted_start": "00:51:39.520",
      "formatted_end": "00:51:52.520",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 3112.52,
      "end": 3114.52,
      "formatted_start": "00:51:52.520",
      "formatted_end": "00:51:54.520",
      "text": "بخمیر سلام بگیرم"
    },
    {
      "id": 15,
      "start": 3114.52,
      "end": 3116.52,
      "formatted_start": "00:51:54.520",
      "formatted_end": "00:51:56.520",
      "text": "سلامت بشیم"
    },
    {
      "id": 16,
      "start": 3116.52,
      "end": 3118.52,
      "formatted_start": "00:51:56.520",
      "formatted_end": "00:51:58.520",
      "text": "خوشکرم"
    },
    {
      "id": 17,
      "start": 3118.52,
      "end": 3120.52,
      "formatted_start": "00:51:58.520",
      "formatted_end": "00:52:00.520",
      "text": "خدمت شما"
    },
    {
      "id": 18,
      "start": 3120.52,
      "end": 3122.52,
      "formatted_start": "00:52:00.520",
      "formatted_end": "00:52:02.520",
      "text": "در روزی برگرام"
    },
    {
      "id": 19,
      "start": 3122.52,
      "end": 3124.52,
      "formatted_start": "00:52:02.520",
      "formatted_end": "00:52:04.520",
      "text": "روز که رو خونم"
    },
    {
      "id": 20,
      "start": 3124.52,
      "end": 3126.52,
      "formatted_start": "00:52:04.520",
      "formatted_end": "00:52:06.520",
      "text": "ممنون میشم"
    },
    {
      "id": 21,
      "start": 3126.52,
      "end": 3128.52,
      "formatted_start": "00:52:06.520",
      "formatted_end": "00:52:08.520",
      "text": "قیمت چند دوریم؟"
    },
    {
      "id": 22,
      "start": 3128.52,
      "end": 3130.52,
      "formatted_start": "00:52:08.520",
      "formatted_end": "00:52:10.520",
      "text": "۱۲۰"
    },
    {
      "id": 23,
      "start": 3130.52,
      "end": 3132.52,
      "formatted_start": "00:52:10.520",
      "formatted_end": "00:52:12.520",
      "text": "برای دارو خواهیم"
    },
    {
      "id": 24,
      "start": 3132.52,
      "end": 3134.52,
      "formatted_start": "00:52:12.520",
      "formatted_end": "00:52:14.520",
      "text": "سلامت بشیم"
    },
    {
      "id": 25,
      "start": 3136.52,
      "end": 3138.52,
      "formatted_start": "00:52:16.520",
      "formatted_end": "00:52:18.520",
      "text": "خدمت شما"
    },
    {
      "id": 26,
      "start": 3138.52,
      "end": 3140.52,
      "formatted_start": "00:52:18.520",
      "formatted_end": "00:52:20.520",
      "text": "به همه"
    },
    {
      "id": 27,
      "start": 3140.52,
      "end": 3142.52,
      "formatted_start": "00:52:20.520",
      "formatted_end": "00:52:22.520",
      "text": "خواهش می کنم"
    },
    {
      "id": 28,
      "start": 3142.52,
      "end": 3144.52,
      "formatted_start": "00:52:22.520",
      "formatted_end": "00:52:24.520",
      "text": "بس"
    },
    {
      "id": 29,
      "start": 3148.52,
      "end": 3150.52,
      "formatted_start": "00:52:28.520",
      "formatted_end": "00:52:30.520",
      "text": "بخونیم سلامتان شما"
    },
    {
      "id": 30,
      "start": 3150.52,
      "end": 3152.52,
      "formatted_start": "00:52:30.520",
      "formatted_end": "00:52:32.520",
      "text": "خوبه سلامت بشیم"
    },
    {
      "id": 31,
      "start": 3152.52,
      "end": 3154.52,
      "formatted_start": "00:52:32.520",
      "formatted_end": "00:52:34.520",
      "text": "خواهش باشیم"
    },
    {
      "id": 32,
      "start": 3154.52,
      "end": 3156.52,
      "formatted_start": "00:52:34.520",
      "formatted_end": "00:52:36.520",
      "text": "آنهایی ندارید"
    },
    {
      "id": 33,
      "start": 3156.52,
      "end": 3158.52,
      "formatted_start": "00:52:36.520",
      "formatted_end": "00:52:38.520",
      "text": "که آورده بودیم؟"
    },
    {
      "id": 34,
      "start": 3158.52,
      "end": 3160.52,
      "formatted_start": "00:52:38.520",
      "formatted_end": "00:52:40.520",
      "text": "چشم"
    },
    {
      "id": 35,
      "start": 3160.52,
      "end": 3162.52,
      "formatted_start": "00:52:40.520",
      "formatted_end": "00:52:42.520",
      "text": "مشکلش چی بود؟"
    },
    {
      "id": 36,
      "start": 3162.52,
      "end": 3164.52,
      "formatted_start": "00:52:42.520",
      "formatted_end": "00:52:44.520",
      "text": "تب کرده"
    },
    {
      "id": 37,
      "start": 3164.52,
      "end": 3166.52,
      "formatted_start": "00:52:44.520",
      "formatted_end": "00:52:46.520",
      "text": "از اینجا چی شده؟"
    },
    {
      "id": 38,
      "start": 3166.52,
      "end": 3168.52,
      "formatted_start": "00:52:46.520",
      "formatted_end": "00:52:48.520",
      "text": "هران تب داره؟"
    },
    {
      "id": 39,
      "start": 3168.52,
      "end": 3173.52,
      "formatted_start": "00:52:48.520",
      "formatted_end": "00:52:53.520",
      "text": "نگاه کنیم بیرون توش رو تکلیف برمز شده"
    },
    {
      "id": 40,
      "start": 3173.52,
      "end": 3175.52,
      "formatted_start": "00:52:53.520",
      "formatted_end": "00:52:55.520",
      "text": "این دکتایی مکنه اینگه میگن دیگه؟"
    },
    {
      "id": 41,
      "start": 3175.52,
      "end": 3176.52,
      "formatted_start": "00:52:55.520",
      "formatted_end": "00:52:56.520",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 3176.52,
      "end": 3177.52,
      "formatted_start": "00:52:56.520",
      "formatted_end": "00:52:57.520",
      "text": "بعد چی؟"
    },
    {
      "id": 43,
      "start": 3177.52,
      "end": 3178.52,
      "formatted_start": "00:52:57.520",
      "formatted_end": "00:52:58.520",
      "text": "بعده؟ بیزن کنیم؟"
    },
    {
      "id": 44,
      "start": 3178.52,
      "end": 3182.52,
      "formatted_start": "00:52:58.520",
      "formatted_end": "00:53:02.520",
      "text": "نه کنیم، تکلیفش برمز شده، بردمش برمز شده، بردمش برمز شده"
    },
    {
      "id": 45,
      "start": 3182.52,
      "end": 3183.52,
      "formatted_start": "00:53:02.520",
      "formatted_end": "00:53:03.520",
      "text": "نه کنیم"
    },
    {
      "id": 46,
      "start": 3184.52,
      "end": 3185.52,
      "formatted_start": "00:53:04.520",
      "formatted_end": "00:53:05.520",
      "text": "کجا؟"
    },
    {
      "id": 47,
      "start": 3185.52,
      "end": 3190.52,
      "formatted_start": "00:53:05.520",
      "formatted_end": "00:53:10.520",
      "text": "نه کنیم اینجا هاش کلیف برمز شده، یک کم برمز شده"
    },
    {
      "id": 48,
      "start": 3192.52,
      "end": 3194.52,
      "formatted_start": "00:53:12.520",
      "formatted_end": "00:53:14.520",
      "text": "نگاه کنیم اینجا هاش از اینکه هم برمز شده"
    },
    {
      "id": 49,
      "start": 3194.52,
      "end": 3196.52,
      "formatted_start": "00:53:14.520",
      "formatted_end": "00:53:16.520",
      "text": "این تفراق این رو میگید"
    },
    {
      "id": 50,
      "start": 3196.52,
      "end": 3198.52,
      "formatted_start": "00:53:16.520",
      "formatted_end": "00:53:18.520",
      "text": "این رو میگید"
    },
    {
      "id": 51,
      "start": 3198.52,
      "end": 3200.52,
      "formatted_start": "00:53:18.520",
      "formatted_end": "00:53:20.520",
      "text": "نه بیرون خواهیم"
    },
    {
      "id": 52,
      "start": 3200.52,
      "end": 3202.52,
      "formatted_start": "00:53:20.520",
      "formatted_end": "00:53:22.520",
      "text": "این رو میگید"
    },
    {
      "id": 53,
      "start": 3202.52,
      "end": 3204.52,
      "formatted_start": "00:53:22.520",
      "formatted_end": "00:53:24.520",
      "text": "همیشه هست این ها متلینگ هست"
    },
    {
      "id": 54,
      "start": 3204.52,
      "end": 3206.52,
      "formatted_start": "00:53:24.520",
      "formatted_end": "00:53:26.520",
      "text": "که ایک میزنه ایک گریه میکنه"
    },
    {
      "id": 55,
      "start": 3206.52,
      "end": 3208.52,
      "formatted_start": "00:53:26.520",
      "formatted_end": "00:53:28.520",
      "text": "پشت سرش میشه"
    },
    {
      "id": 56,
      "start": 3208.52,
      "end": 3210.52,
      "formatted_start": "00:53:28.520",
      "formatted_end": "00:53:30.520",
      "text": "این ها متلینگ هست"
    },
    {
      "id": 57,
      "start": 3210.52,
      "end": 3212.52,
      "formatted_start": "00:53:30.520",
      "formatted_end": "00:53:32.520",
      "text": "حالا شما یه سی زایات پوستی رو بدنش احساس میکنید"
    },
    {
      "id": 58,
      "start": 3212.52,
      "end": 3214.52,
      "formatted_start": "00:53:32.520",
      "formatted_end": "00:53:34.520",
      "text": "در اون مده"
    },
    {
      "id": 59,
      "start": 3214.52,
      "end": 3216.52,
      "formatted_start": "00:53:34.520",
      "formatted_end": "00:53:36.520",
      "text": "طبش قد شده درسته؟"
    },
    {
      "id": 60,
      "start": 3216.52,
      "end": 3218.52,
      "formatted_start": "00:53:36.520",
      "formatted_end": "00:53:38.520",
      "text": "نگاه کنید بسطی پیشونی این رو کنم"
    },
    {
      "id": 61,
      "start": 3218.52,
      "end": 3220.52,
      "formatted_start": "00:53:38.520",
      "formatted_end": "00:53:40.520",
      "text": "و از دیروزه"
    },
    {
      "id": 62,
      "start": 3220.52,
      "end": 3222.52,
      "formatted_start": "00:53:40.520",
      "formatted_end": "00:53:42.520",
      "text": "کلن میکمی خودشه"
    },
    {
      "id": 63,
      "start": 3222.52,
      "end": 3224.52,
      "formatted_start": "00:53:42.520",
      "formatted_end": "00:53:44.520",
      "text": "دماغ و دهن همه رو میکنه"
    },
    {
      "id": 64,
      "start": 3224.52,
      "end": 3226.52,
      "formatted_start": "00:53:44.520",
      "formatted_end": "00:53:46.520",
      "text": "ولی تق نداره"
    },
    {
      "id": 65,
      "start": 3226.52,
      "end": 3228.52,
      "formatted_start": "00:53:46.520",
      "formatted_end": "00:53:48.520",
      "text": "تق خانه پت شده"
    },
    {
      "id": 66,
      "start": 3228.52,
      "end": 3230.52,
      "formatted_start": "00:53:48.520",
      "formatted_end": "00:53:50.520",
      "text": "اگر ندینم بگه تق نداره"
    },
    {
      "id": 67,
      "start": 3230.52,
      "end": 3232.52,
      "formatted_start": "00:53:50.520",
      "formatted_end": "00:53:52.520",
      "text": "خودش"
    },
    {
      "id": 68,
      "start": 3232.52,
      "end": 3234.52,
      "formatted_start": "00:53:52.520",
      "formatted_end": "00:53:54.520",
      "text": "یعنی شما الان متوعه شدین تق پت شده چاشمبه"
    },
    {
      "id": 69,
      "start": 3234.52,
      "end": 3236.52,
      "formatted_start": "00:53:54.520",
      "formatted_end": "00:53:56.520",
      "text": "ولی این دونا از کهی در اومده"
    },
    {
      "id": 70,
      "start": 3236.52,
      "end": 3238.52,
      "formatted_start": "00:53:56.520",
      "formatted_end": "00:53:58.520",
      "text": "از دیروز"
    },
    {
      "id": 71,
      "start": 3238.52,
      "end": 3240.52,
      "formatted_start": "00:53:58.520",
      "formatted_end": "00:54:00.520",
      "text": "چشم و دماغش خیلی بیماله"
    },
    {
      "id": 72,
      "start": 3240.52,
      "end": 3242.52,
      "formatted_start": "00:54:00.520",
      "formatted_end": "00:54:02.520",
      "text": "تویست اونو آرام تره"
    },
    {
      "id": 73,
      "start": 3242.52,
      "end": 3244.52,
      "formatted_start": "00:54:02.520",
      "formatted_end": "00:54:04.520",
      "text": "آفره"
    },
    {
      "id": 74,
      "start": 3244.52,
      "end": 3246.52,
      "formatted_start": "00:54:04.520",
      "formatted_end": "00:54:06.520",
      "text": "من فکر کردم داره دندون دردون میخورم"
    },
    {
      "id": 75,
      "start": 3246.52,
      "end": 3248.52,
      "formatted_start": "00:54:06.520",
      "formatted_end": "00:54:08.520",
      "text": "نه ارتباطه به دندون نده"
    },
    {
      "id": 76,
      "start": 3248.52,
      "end": 3250.52,
      "formatted_start": "00:54:08.520",
      "formatted_end": "00:54:10.520",
      "text": "نه یه بیماری دیگه"
    },
    {
      "id": 77,
      "start": 3250.52,
      "end": 3256.52,
      "formatted_start": "00:54:10.520",
      "formatted_end": "00:54:16.520",
      "text": "این بزرگ خدمتون که ارتباطی به اون طرف که اصلا خوب شده"
    },
    {
      "id": 78,
      "start": 3256.52,
      "end": 3258.52,
      "formatted_start": "00:54:16.520",
      "formatted_end": "00:54:18.520",
      "text": "این چیز بروسه دیگه کاملتون؟"
    },
    {
      "id": 79,
      "start": 3258.52,
      "end": 3259.52,
      "formatted_start": "00:54:18.520",
      "formatted_end": "00:54:19.520",
      "text": "دیبا"
    },
    {
      "id": 80,
      "start": 3259.52,
      "end": 3262.52,
      "formatted_start": "00:54:19.520",
      "formatted_end": "00:54:22.520",
      "text": "دیبا، یک شروط براش می نویسم"
    },
    {
      "id": 81,
      "start": 3262.52,
      "end": 3266.52,
      "formatted_start": "00:54:22.520",
      "formatted_end": "00:54:26.520",
      "text": "این شروط، اگر در طرف 24 ساعت تا 48 ساعت دیدی"
    },
    {
      "id": 82,
      "start": 3266.52,
      "end": 3274.52,
      "formatted_start": "00:54:26.520",
      "formatted_end": "00:54:34.520",
      "text": "اگر دیدید دونا ها از بین رفت، اگر تا 48 ساعت از بین نرفت مراجع داشته باشید"
    },
    {
      "id": 83,
      "start": 3274.52,
      "end": 3276.52,
      "formatted_start": "00:54:34.520",
      "formatted_end": "00:54:36.520",
      "text": "بردکان دیبا"
    },
    {
      "id": 84,
      "start": 3276.52,
      "end": 3280.52,
      "formatted_start": "00:54:36.520",
      "formatted_end": "00:54:40.520",
      "text": "میخدمت شما این داروشو بدین صحبت کنم"
    },
    {
      "id": 85,
      "start": 3280.52,
      "end": 3282.52,
      "formatted_start": "00:54:40.520",
      "formatted_end": "00:54:42.520",
      "text": "درست شما درموند"
    },
    {
      "id": 86,
      "start": 3282.52,
      "end": 3284.52,
      "formatted_start": "00:54:42.520",
      "formatted_end": "00:54:44.520",
      "text": "پایش می کنم"
    },
    {
      "id": 87,
      "start": 3284.52,
      "end": 3289.52,
      "formatted_start": "00:54:44.520",
      "formatted_end": "00:54:49.520",
      "text": "اونو یک قطعه پیدیلاک یا ساشه های اونپرازور می خواهیم براتون بینویسم"
    },
    {
      "id": 88,
      "start": 3289.52,
      "end": 3291.52,
      "formatted_start": "00:54:49.520",
      "formatted_end": "00:54:51.520",
      "text": "این آزاده ها"
    },
    {
      "id": 89,
      "start": 3291.52,
      "end": 3293.52,
      "formatted_start": "00:54:51.520",
      "formatted_end": "00:54:53.520",
      "text": "باید چیزمون اینجا می نویسم"
    },
    {
      "id": 90,
      "start": 3293.52,
      "end": 3295.52,
      "formatted_start": "00:54:53.520",
      "formatted_end": "00:54:55.520",
      "text": "پشتش بینویسید"
    },
    {
      "id": 91,
      "start": 3295.52,
      "end": 3299.52,
      "formatted_start": "00:54:55.520",
      "formatted_end": "00:54:59.520",
      "text": "نه نمیشه ساشه اونپرازور اینم بیادید"
    }
  ],
  "status": "completed"
}