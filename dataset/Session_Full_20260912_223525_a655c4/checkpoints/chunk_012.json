      "end": 3770.4,
      "formatted_start": "01:02:46.000",
      "formatted_end": "01:02:50.400",
      "text": "بله"
    },
    {
      "id": 7,
      "start": 3770.4,
      "end": 3773.78,
      "formatted_start": "01:02:50.400",
      "formatted_end": "01:02:53.780",
      "text": "ممنون با سکت جانم"
    },
    {
      "id": 8,
      "start": 3773.78,
      "end": 3777.56,
      "formatted_start": "01:02:53.780",
      "formatted_end": "01:02:57.560",
      "text": "خوبه"
    },
    {
      "id": 9,
      "start": 3787.64,
      "end": 3788.2,
      "formatted_start": "01:03:07.640",
      "formatted_end": "01:03:08.200",
      "text": "خوبه"
    },
    {
      "id": 10,
      "start": 3788.2,
      "end": 3789.36,
      "formatted_start": "01:03:08.200",
      "formatted_end": "01:03:09.360",
      "text": "خوبه زیر فوتو باشید"
    },
    {
      "id": 11,
      "start": 3789.36,
      "end": 3793.7,
      "formatted_start": "01:03:09.360",
      "formatted_end": "01:03:13.700",
      "text": "خوبه کسی میشن"
    },
    {
      "id": 12,
      "start": 3793.7,
      "end": 3795.1,
      "formatted_start": "01:03:13.700",
      "formatted_end": "01:03:15.100",
      "text": "بله"
    },
    {
      "id": 13,
      "start": 3795.1,
      "end": 3808.94,
      "formatted_start": "01:03:15.100",
      "formatted_end": "01:03:28.940",
      "text": "خب دیگه اصلا ما اوریکراتینی نخواستیم مشکل می کنیم چرا اوریکراتینی رفته"
    },
    {
      "id": 14,
      "start": 3808.94,
      "end": 3815.1,
      "formatted_start": "01:03:28.940",
      "formatted_end": "01:03:35.100",
      "text": "حالا ببینیم دقیقا دیگه تکرار نشیدی خواهیم"
    },
    {
      "id": 15,
      "start": 3815.1,
      "end": 3816.48,
      "formatted_start": "01:03:35.100",
      "formatted_end": "01:03:36.480",
      "text": "خواهیش؟"
    },
    {
      "id": 16,
      "start": 3816.48,
      "end": 3820.12,
      "formatted_start": "01:03:36.480",
      "formatted_end": "01:03:40.120",
      "text": "ببینید مگه شما تک نفری چند تا مریض دارید تو برشون"
    },
    {
      "id": 17,
      "start": 3820.12,
      "end": 3820.96,
      "formatted_start": "01:03:40.120",
      "formatted_end": "01:03:40.960",
      "text": "یکی دوتا"
    },
    {
      "id": 18,
      "start": 3820.96,
      "end": 3825.62,
      "formatted_start": "01:03:40.960",
      "formatted_end": "01:03:45.620",
      "text": "حالا ببینید که یک تک نفره یعنی مریض زیاد من نتونستم"
    },
    {
      "id": 19,
      "start": 3825.62,
      "end": 3831.06,
      "formatted_start": "01:03:45.620",
      "formatted_end": "01:03:51.060",
      "text": "ولی وقتی که اطفال خلوت ترین بخش ما هستی که دوتا دیگه اشتباه نباید بشه"
    },
    {
      "id": 20,
      "start": 3831.06,
      "end": 3833.44,
      "formatted_start": "01:03:51.060",
      "formatted_end": "01:03:53.440",
      "text": "بسیار ممنون خدافصی"
    },
    {
      "id": 21,
      "start": 3833.44,
      "end": 3835.28,
      "formatted_start": "01:03:53.440",
      "formatted_end": "01:03:55.280",
      "text": "بعده بعده"
    },
    {
      "id": 22,
      "start": 3835.28,
      "end": 3837.32,
      "formatted_start": "01:03:55.280",
      "formatted_end": "01:03:57.320",
      "text": "بعده خدافصی"
    },
