  "stt_segments": [
    {
      "id": 0,
      "start": 1200.0,
      "end": 1229.98,
      "formatted_start": "00:20:00.000",
      "formatted_end": "00:20:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 1230.0,
      "end": 1244.0,
      "formatted_start": "00:20:30.000",
      "formatted_end": "00:20:44.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 1260.0,
      "end": 1265.0,
      "formatted_start": "00:21:00.000",
      "formatted_end": "00:21:05.000",
      "text": "گوش بخونید یکی دوازدر ساعتی دوباره هم هشت ساعت دوباره"
    },
    {
      "id": 3,
      "start": 1265.0,
      "end": 1266.0,
      "formatted_start": "00:21:05.000",
      "formatted_end": "00:21:06.000",
      "text": "خدا خوشید"
    },
    {
      "id": 4,
      "start": 1266.0,
      "end": 1267.0,
      "formatted_start": "00:21:06.000",
      "formatted_end": "00:21:07.000",
      "text": "سلام"
    },
    {
      "id": 5,
      "start": 1267.0,
      "end": 1268.0,
      "formatted_start": "00:21:07.000",
      "formatted_end": "00:21:08.000",
      "text": "بفهمید جانستان"
    },
    {
      "id": 6,
      "start": 1268.0,
      "end": 1269.0,
      "formatted_start": "00:21:08.000",
      "formatted_end": "00:21:09.000",
      "text": "خوشید"
    },
    {
      "id": 7,
      "start": 1269.0,
      "end": 1270.0,
      "formatted_start": "00:21:09.000",
      "formatted_end": "00:21:10.000",
      "text": "بفهمید"
    },
    {
      "id": 8,
      "start": 1270.0,
      "end": 1273.0,
      "formatted_start": "00:21:10.000",
      "formatted_end": "00:21:13.000",
      "text": "بخشید بنابراین خانم بیری بعد بفهمید آنش"
    },
    {
      "id": 9,
      "start": 1273.0,
      "end": 1274.0,
      "formatted_start": "00:21:13.000",
      "formatted_end": "00:21:14.000",
      "text": "بسیار"
    },
    {
      "id": 10,
      "start": 1274.0,
      "end": 1275.0,
      "formatted_start": "00:21:14.000",
      "formatted_end": "00:21:15.000",
      "text": "برام"
    },
    {
      "id": 11,
      "start": 1275.0,
      "end": 1280.0,
      "formatted_start": "00:21:15.000",
      "formatted_end": "00:21:20.000",
      "text": "دوستان تقریبا چهار پنج اصلا بیدم تنها برنش در آقای تب دارم"
    },
    {
      "id": 12,
      "start": 1280.0,
      "end": 1282.0,
      "formatted_start": "00:21:20.000",
      "formatted_end": "00:21:22.000",
      "text": "تب کرده غیر از تب چی؟"
    },
    {
      "id": 13,
      "start": 1282.0,
      "end": 1285.0,
      "formatted_start": "00:21:22.000",
      "formatted_end": "00:21:25.000",
      "text": "بینیش که کمکیم شد"
    },
    {
      "id": 14,
      "start": 1285.0,
      "end": 1287.0,
      "formatted_start": "00:21:25.000",
      "formatted_end": "00:21:27.000",
      "text": "گرفتگی بینیر تب دیگه؟"
    },
    {
      "id": 15,
      "start": 1287.0,
      "end": 1288.0,
      "formatted_start": "00:21:27.000",
      "formatted_end": "00:21:28.000",
      "text": "دیگه؟"
    },
    {
      "id": 16,
      "start": 1288.0,
      "end": 1291.48,
      "formatted_start": "00:21:28.000",
      "formatted_end": "00:21:31.480",
      "text": "دیگه درون گرم تو صوفه داشتی؟ صوفه زیاد پرداشت"
    },
    {
      "id": 17,
      "start": 1291.48,
      "end": 1292.48,
      "formatted_start": "00:21:31.480",
      "formatted_end": "00:21:32.480",
      "text": "بعد شما چه باشه؟"
    },
    {
      "id": 18,
      "start": 1292.48,
      "end": 1295.48,
      "formatted_start": "00:21:32.480",
      "formatted_end": "00:21:35.480",
      "text": "باشه، کلو درتم داری همون جون؟"
    },
    {
      "id": 19,
      "start": 1295.48,
      "end": 1296.64,
      "formatted_start": "00:21:35.480",
      "formatted_end": "00:21:36.640",
      "text": "داری"
    },
    {
      "id": 20,
      "start": 1296.64,
      "end": 1298.24,
      "formatted_start": "00:21:36.640",
      "formatted_end": "00:21:38.240",
      "text": "داری یا نه؟"
    },
    {
      "id": 21,
      "start": 1298.24,
      "end": 1298.48,
      "formatted_start": "00:21:38.240",
      "formatted_end": "00:21:38.480",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 1298.48,
      "end": 1300.48,
      "formatted_start": "00:21:38.480",
      "formatted_end": "00:21:40.480",
      "text": "من نگاه کن من اسمی چی؟"
    },
    {
      "id": 23,
      "start": 1301.24,
      "end": 1302.0,
      "formatted_start": "00:21:41.240",
      "formatted_end": "00:21:42.000",
      "text": "من"
    },
    {
      "id": 24,
      "start": 1302.0,
      "end": 1302.48,
      "formatted_start": "00:21:42.000",
      "formatted_end": "00:21:42.480",
      "text": "من نگاه کن من"
    },
    {
      "id": 25,
      "start": 1302.48,
      "end": 1303.86,
      "formatted_start": "00:21:42.480",
      "formatted_end": "00:21:43.860",
      "text": "ببین چشما تو چشمایی بید"
    },
    {
      "id": 26,
      "start": 1303.86,
      "end": 1305.86,
      "formatted_start": "00:21:43.860",
      "formatted_end": "00:21:45.860",
      "text": "آفرین، خجالت نکشن"
    },
    {
      "id": 27,
      "start": 1305.86,
      "end": 1306.22,
      "formatted_start": "00:21:45.860",
      "formatted_end": "00:21:46.220",
      "text": "خوب"
    },
    {
      "id": 28,
      "start": 1306.22,
      "end": 1308.9,
      "formatted_start": "00:21:46.220",
      "formatted_end": "00:21:48.900",
      "text": "اسمی چی همون جون؟"
    },
    {
      "id": 29,
      "start": 1308.9,
      "end": 1309.48,
      "formatted_start": "00:21:48.900",
      "formatted_end": "00:21:49.480",
      "text": "چی؟"
    },
    {
      "id": 30,
      "start": 1309.48,
      "end": 1309.98,
      "formatted_start": "00:21:49.480",
      "formatted_end": "00:21:49.980",
      "text": "جانا"
    },
    {
      "id": 31,
      "start": 1309.98,
      "end": 1311.48,
      "formatted_start": "00:21:49.980",
      "formatted_end": "00:21:51.480",
      "text": "جانا؟"
    },
    {
      "id": 32,
      "start": 1311.48,
      "end": 1314.14,
      "formatted_start": "00:21:51.480",
      "formatted_end": "00:21:54.140",
      "text": "چه اسمه قشنگی، خیلی هم خوشکل و نازی"
    },
    {
      "id": 33,
      "start": 1314.14,
      "end": 1315.18,
      "formatted_start": "00:21:54.140",
      "formatted_end": "00:21:55.180",
      "text": "خب"
    },
    {
      "id": 34,
      "start": 1315.18,
      "end": 1317.18,
      "formatted_start": "00:21:55.180",
      "formatted_end": "00:21:57.180",
      "text": "کمی درک می کنم جون؟"
    },
    {
      "id": 35,
      "start": 1317.18,
      "end": 1318.18,
      "formatted_start": "00:21:57.180",
      "formatted_end": "00:21:58.180",
      "text": "نه"
    },
    {
      "id": 36,
      "start": 1318.18,
      "end": 1321.18,
      "formatted_start": "00:21:58.180",
      "formatted_end": "00:22:01.180",
      "text": "آفنگ سداش هم بشنگ خوب هم داره حرف می زنه"
    },
    {
      "id": 37,
      "start": 1321.18,
      "end": 1322.18,
      "formatted_start": "00:22:01.180",
      "formatted_end": "00:22:02.180",
      "text": "خوب"
    },
    {
      "id": 38,
      "start": 1322.18,
      "end": 1323.18,
      "formatted_start": "00:22:02.180",
      "formatted_end": "00:22:03.180",
      "text": "بعضی موقع"
    },
    {
      "id": 39,
      "start": 1323.18,
      "end": 1325.18,
      "formatted_start": "00:22:03.180",
      "formatted_end": "00:22:05.180",
      "text": "صرفه اینا می زنی؟"
    },
    {
      "id": 40,
      "start": 1325.18,
      "end": 1326.18,
      "formatted_start": "00:22:05.180",
      "formatted_end": "00:22:06.180",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 1326.18,
      "end": 1328.18,
      "formatted_start": "00:22:06.180",
      "formatted_end": "00:22:08.180",
      "text": "بعضی موقع یه صرفه هم می زن"
    },
    {
      "id": 42,
      "start": 1328.18,
      "end": 1330.18,
      "formatted_start": "00:22:08.180",
      "formatted_end": "00:22:10.180",
      "text": "حالا میره پیش من دونجا"
    },
    {
      "id": 43,
      "start": 1330.18,
      "end": 1332.18,
      "formatted_start": "00:22:10.180",
      "formatted_end": "00:22:12.180",
      "text": "اشترک دوست داره"
    },
    {
      "id": 44,
      "start": 1332.18,
      "end": 1334.18,
      "formatted_start": "00:22:12.180",
      "formatted_end": "00:22:14.180",
      "text": "خودشم خانونه دکتر می شید"
    },
    {
      "id": 45,
      "start": 1334.18,
      "end": 1335.18,
      "formatted_start": "00:22:14.180",
      "formatted_end": "00:22:15.180",
      "text": "دوست داری؟"
    },
    {
      "id": 46,
      "start": 1335.18,
      "end": 1336.18,
      "formatted_start": "00:22:15.180",
      "formatted_end": "00:22:16.180",
      "text": "نه بله نه نه"
    },
    {
      "id": 47,
      "start": 1336.18,
      "end": 1338.18,
      "formatted_start": "00:22:16.180",
      "formatted_end": "00:22:18.180",
      "text": "چی؟"
    },
    {
      "id": 48,
      "start": 1338.18,
      "end": 1339.18,
      "formatted_start": "00:22:18.180",
      "formatted_end": "00:22:19.180",
      "text": "چی؟"
    },
    {
      "id": 49,
      "start": 1339.18,
      "end": 1341.18,
      "formatted_start": "00:22:19.180",
      "formatted_end": "00:22:21.180",
      "text": "دکتر فیزیش ایگونا؟"
    },
    {
      "id": 50,
      "start": 1341.18,
      "end": 1343.18,
      "formatted_start": "00:22:21.180",
      "formatted_end": "00:22:23.180",
      "text": "نه دانه دیشتر"
    },
    {
      "id": 51,
      "start": 1343.18,
      "end": 1344.18,
      "formatted_start": "00:22:23.180",
      "formatted_end": "00:22:24.180",
      "text": "دانه؟"
    },
    {
      "id": 52,
      "start": 1344.18,
      "end": 1347.18,
      "formatted_start": "00:22:24.180",
      "formatted_end": "00:22:27.180",
      "text": "دانپیزش که ایواناتن خیلی خوبه"
    },
    {
      "id": 53,
      "start": 1347.18,
      "end": 1353.18,
      "formatted_start": "00:22:27.180",
      "formatted_end": "00:22:33.180",
      "text": "خوب؟ انشالله دوست ایوانات خوب بشن"
    },
    {
      "id": 54,
      "start": 1353.18,
      "end": 1356.18,
      "formatted_start": "00:22:33.180",
      "formatted_end": "00:22:36.180",
      "text": "آره؟ بندفرد دانپیزش بشین اونها رو خوب کنین"
    },
    {
      "id": 55,
      "start": 1356.18,
      "end": 1359.18,
      "formatted_start": "00:22:36.180",
      "formatted_end": "00:22:39.180",
      "text": "خیلی احساساتی و بادری هست"
    },
    {
      "id": 56,
      "start": 1359.18,
      "end": 1364.18,
      "formatted_start": "00:22:39.180",
      "formatted_end": "00:22:44.180",
      "text": "خوب نفس خیلی؟ خوب نفس"
    },
    {
      "id": 57,
      "start": 1364.18,
      "end": 1368.18,
      "formatted_start": "00:22:44.180",
      "formatted_end": "00:22:48.180",
      "text": "نفس؟ احسن نفس"
    },
    {
      "id": 58,
      "start": 1368.18,
      "end": 1370.18,
      "formatted_start": "00:22:48.180",
      "formatted_end": "00:22:50.180",
      "text": "نفس خیلی عالی"
    },
    {
      "id": 59,
      "start": 1370.18,
      "end": 1375.18,
      "formatted_start": "00:22:50.180",
      "formatted_end": "00:22:55.180",
      "text": "خانم دکتر باکزه اشتناتی آسکون"
    },
    {
      "id": 60,
      "start": 1375.18,
      "end": 1379.18,
      "formatted_start": "00:22:55.180",
      "formatted_end": "00:22:59.180",
      "text": "خیلی عادی"
    },
    {
      "id": 61,
      "start": 1379.18,
      "end": 1381.18,
      "formatted_start": "00:22:59.180",
      "formatted_end": "00:23:01.180",
      "text": "از اینکه اشتناتی سفیده"
    },
    {
      "id": 62,
      "start": 1381.18,
      "end": 1383.18,
      "formatted_start": "00:23:01.180",
      "formatted_end": "00:23:03.180",
      "text": "از اینکه اشتناتی نداره"
    },
    {
      "id": 63,
      "start": 1383.18,
      "end": 1385.18,
      "formatted_start": "00:23:03.180",
      "formatted_end": "00:23:05.180",
      "text": "دارو هم مردم خوب میخوره"
    },
    {
      "id": 64,
      "start": 1385.18,
      "end": 1388.18,
      "formatted_start": "00:23:05.180",
      "formatted_end": "00:23:08.180",
      "text": "چون بچه اینجوروی تو بایینه هم کاریش موره"
    },
    {
      "id": 65,
      "start": 1388.18,
      "end": 1390.18,
      "formatted_start": "00:23:08.180",
      "formatted_end": "00:23:10.180",
      "text": "از دارو خوب میخورم"
    },
    {
      "id": 66,
      "start": 1390.18,
      "end": 1392.18,
      "formatted_start": "00:23:10.180",
      "formatted_end": "00:23:12.180",
      "text": "شبیه ببین شمای دکتر"
    },
    {
      "id": 67,
      "start": 1392.18,
      "end": 1394.18,
      "formatted_start": "00:23:12.180",
      "formatted_end": "00:23:14.180",
      "text": "آفرین"
    },
    {
      "id": 68,
      "start": 1394.18,
      "end": 1396.18,
      "formatted_start": "00:23:14.180",
      "formatted_end": "00:23:16.180",
      "text": "من هم آنکل درش نیمیدی کم"
    },
    {
      "id": 69,
      "start": 1396.18,
      "end": 1398.18,
      "formatted_start": "00:23:16.180",
      "formatted_end": "00:23:18.180",
      "text": "ولی دارو هم تو خوبه"
    },
    {
      "id": 70,
      "start": 1398.18,
      "end": 1403.18,
      "formatted_start": "00:23:18.180",
      "formatted_end": "00:23:23.180",
      "text": "این شیاط سمیتی 325 زن هست"
    },
    {
      "id": 71,
      "start": 1403.18,
      "end": 1408.18,
      "formatted_start": "00:23:23.180",
      "formatted_end": "00:23:28.180",
      "text": "زیاد بوده 325 یک نصفی شما داشت"
    },
    {
      "id": 72,
      "start": 1408.18,
      "end": 1412.18,
      "formatted_start": "00:23:28.180",
      "formatted_end": "00:23:32.180",
      "text": "دکتر دکتور فناک"
    },
    {
      "id": 73,
      "start": 1412.18,
      "end": 1416.18,
      "formatted_start": "00:23:32.180",
      "formatted_end": "00:23:36.180",
      "text": "دکتور فناک انجام نصف تا کامل هم میشه بودش"
    },
    {
      "id": 74,
      "start": 1416.18,
      "end": 1421.18,
      "formatted_start": "00:23:36.180",
      "formatted_end": "00:23:41.180",
      "text": "خب این درخواه میری افراد ویروسیه خب"
    },
    {
      "id": 75,
      "start": 1421.18,
      "end": 1426.18,
      "formatted_start": "00:23:41.180",
      "formatted_end": "00:23:46.180",
      "text": "قصد تنواعی سات برگرد صد و تقریباً 20 خیلی همونیه"
    },
    {
      "id": 76,
      "start": 1426.18,
      "end": 1429.94,
      "formatted_start": "00:23:46.180",
      "formatted_end": "00:23:49.940",
      "text": "میره که الان تو باید باباش کلورا میره هست و میره بابا مرسی میده"
    },
    {
      "id": 77,
      "start": 1429.94,
      "end": 1433.42,
      "formatted_start": "00:23:49.940",
      "formatted_end": "00:23:53.420",
      "text": "بله خب دیگه این دیگه من نمیدونم چی کنم"
    },
    {
      "id": 78,
      "start": 1433.42,
      "end": 1434.58,
      "formatted_start": "00:23:53.420",
      "formatted_end": "00:23:54.580",
      "text": "من از اون رو نمیدونم"
    },
    {
      "id": 79,
      "start": 1434.58,
      "end": 1438.24,
      "formatted_start": "00:23:54.580",
      "formatted_end": "00:23:58.240",
      "text": "خب باباش کلورا میره باید یه هفته ایزوله بشه"
    },
    {
      "id": 80,
      "start": 1438.24,
      "end": 1438.84,
      "formatted_start": "00:23:58.240",
      "formatted_end": "00:23:58.840",
      "text": "که نمیشه"
    },
    {
      "id": 81,
      "start": 1438.84,
      "end": 1440.5,
      "formatted_start": "00:23:58.840",
      "formatted_end": "00:24:00.500",
      "text": "نمیشه درسته خب"
    },
    {
      "id": 82,
      "start": 1440.5,
      "end": 1448.22,
      "formatted_start": "00:24:00.500",
      "formatted_end": "00:24:08.220",
      "text": "خانم میری اگه علاقه میجدیدی ببینید که بیا"
    },
    {
      "id": 83,
      "start": 1448.22,
      "end": 1452.34,
      "formatted_start": "00:24:08.220",
      "formatted_end": "00:24:12.340",
      "text": "بیا مراجعه داشته باشید"
    },
    {
      "id": 84,
      "start": 1452.34,
      "end": 1452.9,
      "formatted_start": "00:24:12.340",
      "formatted_end": "00:24:12.900",
      "text": "خب"
    },
    {
      "id": 85,
      "start": 1452.9,
      "end": 1454.28,
      "formatted_start": "00:24:12.900",
      "formatted_end": "00:24:14.280",
      "text": "دارو نمیدونم"
    },
    {
      "id": 86,
      "start": 1454.28,
      "end": 1457.48,
      "formatted_start": "00:24:14.280",
      "formatted_end": "00:24:17.480",
      "text": "بله چرا دارو میدی؟ چی ها دیگروفن هست که نام داری؟"
    },
    {
      "id": 87,
      "start": 1457.48,
      "end": 1459.08,
      "formatted_start": "00:24:17.480",
      "formatted_end": "00:24:19.080",
      "text": "دیگروفن 50 دارم"
    },
    {
      "id": 88,
      "start": 1459.08,
      "end": 1460.08,
      "formatted_start": "00:24:19.080",
      "formatted_end": "00:24:20.080",
      "text": "خب خوبه"
    },
    {
      "id": 89,
      "start": 1460.08,
      "end": 1464.48,
      "formatted_start": "00:24:20.080",
      "formatted_end": "00:24:24.480",
      "text": "دو سه تا شربت براش نوشتن بیا و من بهتون توش کنم"
    },
    {
      "id": 90,
      "start": 1464.48,
      "end": 1466.28,
      "formatted_start": "00:24:24.480",
      "formatted_end": "00:24:26.280",
      "text": "اصلا اینها کشکنن توش هست؟"
    },
    {
      "id": 91,
      "start": 1466.28,
      "end": 1469.48,
      "formatted_start": "00:24:26.280",
      "formatted_end": "00:24:29.480",
      "text": "بله اویترو مایسین هست خوش کننده شی"
    },
    {
      "id": 92,
      "start": 1469.48,
      "end": 1473.48,
      "formatted_start": "00:24:29.480",
      "formatted_end": "00:24:33.480",
      "text": "گروفن هم برای طبش نوشتن با میده پر بشیم"
    },
    {
      "id": 93,
      "start": 1473.48,
      "end": 1474.48,
      "formatted_start": "00:24:33.480",
      "formatted_end": "00:24:34.480",
      "text": "چشم هست"
    },
    {
      "id": 94,
      "start": 1474.48,
      "end": 1477.08,
      "formatted_start": "00:24:34.480",
      "formatted_end": "00:24:37.080",
      "text": "خدمت شما بیا نام امالت دست راسته"
    },
    {
      "id": 95,
      "start": 1477.08,
      "end": 1479.28,
      "formatted_start": "00:24:37.080",
      "formatted_end": "00:24:39.280",
      "text": "نیازه اینست بیارم ببینی که اینها درست هستن"
    },
    {
      "id": 96,
      "start": 1479.28,
      "end": 1500.0,
      "formatted_start": "00:24:39.280",
      "formatted_end": "00:25:00.000",
      "text": "اوه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیلی خوبه، خیل"
    }
  ],
  "status": "completed"
}