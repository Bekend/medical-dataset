    },
    {
      "id": 5,
      "start": 6430.0,
      "end": 6450.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:30.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 6450.0,
      "end": 6470.0,
      "formatted_start": "01:47:30.000",
      "formatted_end": "01:47:50.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 6470.0,
      "end": 6472.0,
      "formatted_start": "01:47:50.000",
      "formatted_end": "01:47:52.000",
      "text": "مردم سلامت باشید"
    },
    {
      "id": 8,
      "start": 6474.0,
      "end": 6478.0,
      "formatted_start": "01:47:54.000",
      "formatted_end": "01:47:58.000",
      "text": "این روزی سه بار دفعه ممکن داره برای حال تغذیب"
    },
    {
      "id": 9,
      "start": 6478.0,
      "end": 6480.0,
      "formatted_start": "01:47:58.000",
      "formatted_end": "01:48:00.000",
      "text": "براموزم دارم"
    },
    {
      "id": 10,
      "start": 6500.0,
      "end": 6502.0,
      "formatted_start": "01:48:20.000",
      "formatted_end": "01:48:22.000",
      "text": "هشتاده یکساده گیر"
    },
    {
      "id": 11,
      "start": 6502.0,
      "end": 6504.0,
      "formatted_start": "01:48:22.000",
      "formatted_end": "01:48:24.000",
      "text": "ماشا باید بگیره تماشایی کنید"
    },
    {
      "id": 12,
      "start": 6504.0,
      "end": 6506.0,
      "formatted_start": "01:48:24.000",
      "formatted_end": "01:48:26.000",
      "text": "و میگیرم ازتون"
    },
    {
      "id": 13,
      "start": 6506.0,
      "end": 6508.0,
      "formatted_start": "01:48:26.000",
      "formatted_end": "01:48:28.000",
      "text": "ماشاده به شما هشتاده یکساده گیر"
    },
    {
      "id": 14,
      "start": 6508.0,
      "end": 6510.0,
      "formatted_start": "01:48:28.000",
      "formatted_end": "01:48:30.000",
      "text": "قلنور"
    },
    {
      "id": 15,
      "start": 6510.0,
      "end": 6512.0,
      "formatted_start": "01:48:30.000",
      "formatted_end": "01:48:32.000",
      "text": "کلمانشایی"
    },
    {
      "id": 16,
      "start": 6518.0,
      "end": 6520.0,
      "formatted_start": "01:48:38.000",
      "formatted_end": "01:48:40.000",
      "text": "بچه ها شاد به"
    },
    {
      "id": 17,
      "start": 6520.0,
      "end": 6522.0,
      "formatted_start": "01:48:40.000",
      "formatted_end": "01:48:42.000",
      "text": "موضوع خودشون"
    },
    {
      "id": 18,
      "start": 6522.0,
      "end": 6524.0,
      "formatted_start": "01:48:42.000",
      "formatted_end": "01:48:44.000",
      "text": "خوبه شدن"
    },
    {
      "id": 19,
      "start": 6524.0,
      "end": 6526.0,
      "formatted_start": "01:48:44.000",
      "formatted_end": "01:48:46.000",
      "text": "باید بودیم اینکه بود"
    },
    {
      "id": 20,
      "start": 6526.0,
      "end": 6528.0,
      "formatted_start": "01:48:46.000",
      "formatted_end": "01:48:48.000",
      "text": "راسته چه برای سه هزار درخونه"
    },
    {
      "id": 21,
      "start": 6528.0,
      "end": 6540.0,
      "formatted_start": "01:48:48.000",
      "formatted_end": "01:49:00.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 6558.0,
      "end": 6571.0,
      "formatted_start": "01:49:18.000",
      "formatted_end": "01:49:31.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 6588.0,
      "end": 6591.3,
      "formatted_start": "01:49:48.000",
      "formatted_end": "01:49:51.300",
      "text": "چون همیشه به چیزهایی فکر میکنی که نداری"
    },
    {
      "id": 24,
      "start": 6591.3,
      "end": 6595.3,
      "formatted_start": "01:49:51.300",
      "formatted_end": "01:49:55.300",
      "text": "پس چی کار کنم؟ قدر چیزهایی که داریم؟"
    }
  ],
  "status": "completed"
