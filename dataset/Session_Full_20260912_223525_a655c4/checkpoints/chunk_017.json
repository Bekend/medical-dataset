  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5125.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:25.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 5125.0,
      "end": 5128.06,
      "formatted_start": "01:25:25.000",
      "formatted_end": "01:25:28.060",
      "text": "من همیشه میگم، برو تو شمی روتونه برو"
    },
    {
      "id": 2,
      "start": 5128.06,
      "end": 5130.06,
      "formatted_start": "01:25:28.060",
      "formatted_end": "01:25:30.060",
      "text": "برو تونه چی که رو می کنن؟"
    },
    {
      "id": 3,
      "start": 5130.06,
      "end": 5133.06,
      "formatted_start": "01:25:30.060",
      "formatted_end": "01:25:33.060",
      "text": "روتونه توش سنگه"
    },
    {
      "id": 4,
      "start": 5133.06,
      "end": 5137.06,
      "formatted_start": "01:25:33.060",
      "formatted_end": "01:25:37.060",
      "text": "روتونه یه جایی از یه آی پرد میشه با این"
    },
    {
      "id": 5,
      "start": 5137.06,
      "end": 5139.06,
      "formatted_start": "01:25:37.060",
      "formatted_end": "01:25:39.060",
      "text": "اما همچنین روی دست"
    },
    {
      "id": 6,
      "start": 5139.06,
      "end": 5143.06,
      "formatted_start": "01:25:39.060",
      "formatted_end": "01:25:43.060",
      "text": "رسان رود که در نشی به در سر سنگ میزنند"
    },
    {
      "id": 7,
      "start": 5143.06,
      "end": 5145.06,
      "formatted_start": "01:25:43.060",
      "formatted_end": "01:25:45.060",
      "text": "روی در آبشی"
    },
    {
      "id": 8,
      "start": 5145.06,
      "end": 5147.06,
      "formatted_start": "01:25:45.060",
      "formatted_end": "01:25:47.060",
      "text": "چون اعتماد داره به مسیری"
    },
    {
      "id": 9,
      "start": 5147.06,
      "end": 5149.06,
      "formatted_start": "01:25:47.060",
      "formatted_end": "01:25:49.060",
      "text": "بشه چیزی که یه نمی کنن"
    },
    {
      "id": 10,
      "start": 5149.06,
      "end": 5153.06,
      "formatted_start": "01:25:49.060",
      "formatted_end": "01:25:53.060",
      "text": "و اونجا اون سنگ، اون ثبوته براش نیازه"
    },
    {
      "id": 11,
      "start": 5153.06,
      "end": 5158.06,
      "formatted_start": "01:25:53.060",
      "formatted_end": "01:25:58.060",
      "text": "اما مشکل هست، مادم اتاف رد میشه"
    },
    {
      "id": 12,
      "start": 5158.06,
      "end": 5162.06,
      "formatted_start": "01:25:58.060",
      "formatted_end": "01:26:02.060",
      "text": "چه بس او سنگی نماشه، با اون صدایی ازش در نمیاد"
    },
    {
      "id": 13,
      "start": 5162.06,
      "end": 5166.06,
      "formatted_start": "01:26:02.060",
      "formatted_end": "01:26:06.060",
      "text": "چه بس او سبوت نماشه، آبشاری به وجود نمیاد"
    },
    {
      "id": 14,
      "start": 5166.06,
      "end": 5173.06,
      "formatted_start": "01:26:06.060",
      "formatted_end": "01:26:13.060",
      "text": "اما چرا سنگ های مسیر ما و سبوت های مسیر ما به سبوتون رسیبان نمیشه؟"
    },
    {
      "id": 15,
      "start": 5173.06,
      "end": 5179.06,
      "formatted_start": "01:26:13.060",
      "formatted_end": "01:26:19.060",
      "text": "چون خوشش گیر می کنه، چون اعتماد نمی کنه، چون سفت می گیریم کدوم"
    },
    {
      "id": 16,
      "start": 5179.06,
      "end": 5185.06,
      "formatted_start": "01:26:19.060",
      "formatted_end": "01:26:25.060",
      "text": "شرزه می کنی اعتماد نداری، صرف می گویی دیگه سخت می گیرن جمع فرمان دارن، سنگیرن"
    },
    {
      "id": 17,
      "start": 5185.06,
      "end": 5193.06,
      "formatted_start": "01:26:25.060",
      "formatted_end": "01:26:33.060",
      "text": "پشت اون سنگیر بیداری، تا درس رو نگیری، پشتش بیداری، تا اعتماد نداری، پشتش بیداری"
    },
    {
      "id": 18,
      "start": 5197.06,
      "end": 5203.06,
      "formatted_start": "01:26:37.060",
      "formatted_end": "01:26:43.060",
      "text": "این تصور مثلا خاصله ایه، اون از دریا و نزدیک بود"
    },
    {
      "id": 19,
      "start": 5203.06,
      "end": 5209.06,
      "formatted_start": "01:26:43.060",
      "formatted_end": "01:26:49.060",
      "text": "یعنی سریع این روزمونه از تو به دریا بازه"
    },
    {
      "id": 20,
      "start": 5209.06,
      "end": 5215.06,
      "formatted_start": "01:26:49.060",
      "formatted_end": "01:26:55.060",
      "text": "این روزمونه معنون نداشته"
    },
    {
      "id": 21,
      "start": 5215.06,
      "end": 5219.06,
      "formatted_start": "01:26:55.060",
      "formatted_end": "01:26:59.060",
      "text": "این زیبایی به بشه بگیر"
    },
    {
      "id": 22,
      "start": 5219.06,
      "end": 5223.06,
      "formatted_start": "01:26:59.060",
      "formatted_end": "01:27:03.060",
      "text": "این یعنی اصلا جریان معنون نداشته، حرکت معنون نداشته"
    },
    {
      "id": 23,
      "start": 5223.06,
      "end": 5228.06,
      "formatted_start": "01:27:03.060",
      "formatted_end": "01:27:08.060",
      "text": "پس این سختی که، این زمانی که با یه هز سفری بشه"
    },
    {
      "id": 24,
      "start": 5228.06,
      "end": 5231.06,
      "formatted_start": "01:27:08.060",
      "formatted_end": "01:27:11.060",
      "text": "این خواست دیگه که بین دین و مقسمت هست"
    },
    {
      "id": 25,
      "start": 5231.06,
      "end": 5236.06,
      "formatted_start": "01:27:11.060",
      "formatted_end": "01:27:16.060",
      "text": "که برای آگزی داده شده داستان از دنیا تنها"
    },
    {
      "id": 26,
      "start": 5236.06,
      "end": 5240.06,
      "formatted_start": "01:27:16.060",
      "formatted_end": "01:27:20.060",
      "text": "اما تو وقتی نمیفهمی"
    },
    {
      "id": 27,
      "start": 5240.06,
      "end": 5245.06,
      "formatted_start": "01:27:20.060",
      "formatted_end": "01:27:25.060",
      "text": "همه چیز دین دنیا رو نظرم نداره"
    },
    {
      "id": 28,
      "start": 5245.06,
      "end": 5248.06,
      "formatted_start": "01:27:25.060",
      "formatted_end": "01:27:28.060",
      "text": "در طه ادالت و زیبایی خودش"
    },
    {
      "id": 29,
      "start": 5248.06,
      "end": 5251.06,
      "formatted_start": "01:27:28.060",
      "formatted_end": "01:27:31.060",
      "text": "و تمام درس هاش هم وجود داره"
    },
    {
      "id": 30,
      "start": 5251.06,
      "end": 5257.06,
      "formatted_start": "01:27:31.060",
      "formatted_end": "01:27:37.060",
      "text": "خدا از غرف چیزهایی تدرائی کرده که ما با دیدن رو ما یاد بگیم"
    },
    {
      "id": 31,
      "start": 5258.06,
      "end": 5264.06,
      "formatted_start": "01:27:38.060",
      "formatted_end": "01:27:44.060",
      "text": "تو رودخونه درسه، تو پرشید درسه، تو این کل درسه، اون که معنایی چیز درسه بود"
    },
    {
      "id": 32,
      "start": 5265.06,
      "end": 5271.06,
      "formatted_start": "01:27:45.060",
      "formatted_end": "01:27:51.060",
      "text": "خب جمعات فرشاد هست و مصدی و شور، ولی یکم چه بگیرند در آینه بود"
    },
    {
      "id": 33,
      "start": 5272.06,
      "end": 5275.06,
      "formatted_start": "01:27:52.060",
      "formatted_end": "01:27:55.060",
      "text": "من همیشه میگم خدا تو چه رودخونه بگیر؟"
    },
    {
      "id": 34,
      "start": 5275.06,
      "end": 5277.06,
      "formatted_start": "01:27:55.060",
      "formatted_end": "01:27:57.060",
      "text": "رودخونه چی کار میدونه؟"
    },
    {
      "id": 35,
      "start": 5277.06,
      "end": 5279.06,
      "formatted_start": "01:27:57.060",
      "formatted_end": "01:27:59.060",
      "text": "درسته این روزخونه توی سنگیره"
    },
    {
      "id": 36,
      "start": 5279.06,
      "end": 5281.06,
      "formatted_start": "01:27:59.060",
      "formatted_end": "01:28:01.060",
      "text": "درسته این روزخونه توی از"
    },
    {
      "id": 37,
      "start": 5281.06,
      "end": 5293.06,
      "formatted_start": "01:28:01.060",
      "formatted_end": "01:28:13.060",
      "text": "موسیقی"
    },
    {
      "id": 38,
      "start": 5311.06,
      "end": 5335.06,
      "formatted_start": "01:28:31.060",
      "formatted_end": "01:28:55.060",
      "text": "موسیقی"
    },
    {
      "id": 39,
      "start": 5341.06,
      "end": 5366.06,
      "formatted_start": "01:29:01.060",
      "formatted_end": "01:29:26.060",
      "text": "موسیقی"
    },
    {
      "id": 40,
      "start": 5366.06,
      "end": 5371.06,
      "formatted_start": "01:29:26.060",
      "formatted_end": "01:29:31.060",
      "text": "بله؟ سلام سلام، چه خبر؟"
    },
    {
      "id": 41,
      "start": 5371.06,
      "end": 5377.06,
      "formatted_start": "01:29:31.060",
      "formatted_end": "01:29:37.060",
      "text": "بیاد مدتب"
    },
    {
      "id": 42,
      "start": 5377.06,
      "end": 5385.06,
      "formatted_start": "01:29:37.060",
      "formatted_end": "01:29:45.060",
      "text": "حالا، حالا، حالا، بیاد منجا، چون ما اونجا یه دونه دستگاه ما از مدتب اونجا داریم"
    },
    {
      "id": 43,
      "start": 5385.06,
      "end": 5390.06,
      "formatted_start": "01:29:45.060",
      "formatted_end": "01:29:50.060",
      "text": "این دستگاه مدتب شما، بهتر بود حضینه شما مثلا به کارت خودم میگردیم"
    },
    {
      "id": 44,
      "start": 5390.06,
      "end": 5394.06,
      "formatted_start": "01:29:50.060",
      "formatted_end": "01:29:54.060",
      "text": "چون دستگاه مدتب خوب، حالا، حالا من نگفتم درستش"
    },
    {
      "id": 45,
      "start": 5394.06,
      "end": 5397.06,
      "formatted_start": "01:29:54.060",
      "formatted_end": "01:29:57.060",
      "text": "و یکم حالا مریض رو به کارت خودم بکشیم"
    },
    {
      "id": 46,
      "start": 5397.06,
      "end": 5399.06,
      "formatted_start": "01:29:57.060",
      "formatted_end": "01:29:59.060",
      "text": "باشه، مرسی، خدا به خدا"
    }
  ],
  "status": "completed"
}