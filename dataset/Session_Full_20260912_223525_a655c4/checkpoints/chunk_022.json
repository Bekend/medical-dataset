      "end": 6776.0,
      "formatted_start": "01:52:40.000",
      "formatted_end": "01:52:56.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 6776.0,
      "end": 6778.0,
      "formatted_start": "01:52:56.000",
      "formatted_end": "01:52:58.000",
      "text": "بخوند"
    },
    {
      "id": 8,
      "start": 6778.0,
      "end": 6780.0,
      "formatted_start": "01:52:58.000",
      "formatted_end": "01:53:00.000",
      "text": "سلام بابا جان"
    },
    {
      "id": 9,
      "start": 6780.0,
      "end": 6782.0,
      "formatted_start": "01:53:00.000",
      "formatted_end": "01:53:02.000",
      "text": "بخوند بخوند"
    },
    {
      "id": 10,
      "start": 6782.0,
      "end": 6784.0,
      "formatted_start": "01:53:02.000",
      "formatted_end": "01:53:04.000",
      "text": "چی هست؟"
    },
    {
      "id": 11,
      "start": 6784.0,
      "end": 6786.0,
      "formatted_start": "01:53:04.000",
      "formatted_end": "01:53:06.000",
      "text": "از مایش آوردیم"
    },
    {
      "id": 12,
      "start": 6786.0,
      "end": 6788.0,
      "formatted_start": "01:53:06.000",
      "formatted_end": "01:53:08.000",
      "text": "از اونو همینجا زیر شکیل"
    },
    {
      "id": 13,
      "start": 6788.0,
      "end": 6790.0,
      "formatted_start": "01:53:08.000",
      "formatted_end": "01:53:10.000",
      "text": "این دار برم داشت؟"
    },
    {
      "id": 14,
      "start": 6790.0,
      "end": 6792.0,
      "formatted_start": "01:53:10.000",
      "formatted_end": "01:53:12.000",
      "text": "برم"
    },
    {
      "id": 15,
      "start": 6803.0,
      "end": 6805.0,
      "formatted_start": "01:53:23.000",
      "formatted_end": "01:53:25.000",
      "text": "این چیز خاصی نداره"
    },
    {
      "id": 16,
      "start": 6805.0,
      "end": 6807.0,
      "formatted_start": "01:53:25.000",
      "formatted_end": "01:53:27.000",
      "text": "اون برمش هم طبیعه"
    },
    {
      "id": 17,
      "start": 6807.0,
      "end": 6809.0,
      "formatted_start": "01:53:27.000",
      "formatted_end": "01:53:29.000",
      "text": "نه مایه داره، نه غادر فصل داره"
    },
    {
      "id": 18,
      "start": 6809.0,
      "end": 6811.0,
      "formatted_start": "01:53:29.000",
      "formatted_end": "01:53:31.000",
      "text": "هیچ گزارش نکرده"
    },
    {
      "id": 19,
      "start": 6811.0,
      "end": 6813.0,
      "formatted_start": "01:53:31.000",
      "formatted_end": "01:53:33.000",
      "text": "خب؟"
    },
    {
      "id": 20,
      "start": 6813.0,
      "end": 6818.0,
      "formatted_start": "01:53:33.000",
      "formatted_end": "01:53:38.000",
      "text": "این مشکل چیزی هیچی نداره"
    },
    {
      "id": 21,
      "start": 6818.0,
      "end": 6823.0,
      "formatted_start": "01:53:38.000",
      "formatted_end": "01:53:43.000",
      "text": "نه نه چیزی نیست منم ریا کردم خیلی برم این نداره"
    },
    {
      "id": 22,
      "start": 6823.0,
      "end": 6827.0,
      "formatted_start": "01:53:43.000",
      "formatted_end": "01:53:47.000",
      "text": "آره آره اون یکی با آن یکی کچکی با همینه"
    },
    {
      "id": 23,
      "start": 6827.0,
      "end": 6830.0,
      "formatted_start": "01:53:47.000",
      "formatted_end": "01:53:50.000",
      "text": "آره یکی بالاتر یکی پایین تر با همینسته نگران نباش"
    },
    {
      "id": 24,
      "start": 6830.0,
      "end": 6833.0,
      "formatted_start": "01:53:50.000",
      "formatted_end": "01:53:53.000",
      "text": "آره طبیعه با همون دست باشه"
    },
    {
      "id": 25,
      "start": 6833.0,
      "end": 6835.0,
      "formatted_start": "01:53:53.000",
      "formatted_end": "01:53:55.000",
      "text": "خدمت شما خوشتون"
    },
    {
      "id": 26,
      "start": 6835.0,
      "end": 6837.0,
      "formatted_start": "01:53:55.000",
      "formatted_end": "01:53:57.000",
      "text": "سلامت شما"
    },
    {
      "id": 27,
      "start": 6837.0,
      "end": 6839.0,
      "formatted_start": "01:53:57.000",
      "formatted_end": "01:53:59.000",
      "text": "در باز باشه"
    },
    {
      "id": 28,
      "start": 6839.0,
      "end": 6859.0,
      "formatted_start": "01:53:59.000",
      "formatted_end": "01:54:19.000",
      "text": "موسیقی"
    },
    {
      "id": 29,
      "start": 6859.0,
      "end": 6864.0,
      "formatted_start": "01:54:19.000",
      "formatted_end": "01:54:24.000",
      "text": "خانم سمیت دیروز بارون و آزادشکت چجوری بود؟ کنبت خیلی وحشتناک بود"
    },
    {
      "id": 30,
      "start": 6864.0,
      "end": 6866.0,
      "formatted_start": "01:54:24.000",
      "formatted_end": "01:54:26.000",
      "text": "شدید بود"
    },
    {
      "id": 31,
      "start": 6866.0,
      "end": 6872.0,
      "formatted_start": "01:54:26.000",
      "formatted_end": "01:54:32.000",
      "text": "شدید بود؟ اصلا یه چه دقیقه بیمارستان آب گرفت، راه ها بسته شد"
    },
    {
      "id": 32,
      "start": 6872.0,
      "end": 6878.0,
      "formatted_start": "01:54:32.000",
      "formatted_end": "01:54:38.000",
      "text": "باد شدید بود"
    },
    {
      "id": 33,
      "start": 6878.0,
      "end": 6880.0,
      "formatted_start": "01:54:38.000",
      "formatted_end": "01:54:40.000",
      "text": "توفان بود اصلا"
    },
    {
      "id": 34,
      "start": 6880.0,
      "end": 6900.0,
      "formatted_start": "01:54:40.000",
      "formatted_end": "01:55:00.000",
      "text": "موسیقی"
    }
  ],
