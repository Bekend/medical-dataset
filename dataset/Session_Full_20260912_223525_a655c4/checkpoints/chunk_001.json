  "stt_segments": [
    {
      "id": 0,
      "start": 300.0,
      "end": 320.0,
      "formatted_start": "00:05:00.000",
      "formatted_end": "00:05:20.000",
      "text": "مدت ترانی هم زیر دستگاه بوده، زردیش بهتر شده ولی خوب نشد اونقدر از این ماه نشده."
    },
    {
      "id": 1,
      "start": 320.0,
      "end": 323.0,
      "formatted_start": "00:05:20.000",
      "formatted_end": "00:05:23.000",
      "text": "نظر ماهی نشده برو خونید چیه؟"
    },
    {
      "id": 2,
      "start": 323.0,
      "end": 325.0,
      "formatted_start": "00:05:23.000",
      "formatted_end": "00:05:25.000",
      "text": "خداموشه آهو مصبتیم"
    },
    {
      "id": 3,
      "start": 325.0,
      "end": 326.0,
      "formatted_start": "00:05:25.000",
      "formatted_end": "00:05:26.000",
      "text": "هر دو آهو مصبتیم؟"
    },
    {
      "id": 4,
      "start": 326.0,
      "end": 328.0,
      "formatted_start": "00:05:26.000",
      "formatted_end": "00:05:28.000",
      "text": "آهو مصبتیم نگران نباشید"
    },
    {
      "id": 5,
      "start": 328.0,
      "end": 330.0,
      "formatted_start": "00:05:28.000",
      "formatted_end": "00:05:30.000",
      "text": "آزمایشی کمتار انجام بده جاواشه بیار من بیرم"
    },
    {
      "id": 6,
      "start": 330.0,
      "end": 335.0,
      "formatted_start": "00:05:30.000",
      "formatted_end": "00:05:35.000",
      "text": "یه وقتی افغانتی مشکل آنزیمی که به اینها نداشته باشه"
    },
    {
      "id": 7,
      "start": 335.0,
      "end": 336.0,
      "formatted_start": "00:05:35.000",
      "formatted_end": "00:05:36.000",
      "text": "خوب؟"
    },
    {
      "id": 8,
      "start": 336.0,
      "end": 338.0,
      "formatted_start": "00:05:36.000",
      "formatted_end": "00:05:38.000",
      "text": "همینجا دارم"
    },
    {
      "id": 9,
      "start": 338.0,
      "end": 339.0,
      "formatted_start": "00:05:38.000",
      "formatted_end": "00:05:39.000",
      "text": "برفرد"
    },
    {
      "id": 10,
      "start": 339.0,
      "end": 341.0,
      "formatted_start": "00:05:39.000",
      "formatted_end": "00:05:41.000",
      "text": "درم بیزن هسته برنزین؟"
    },
    {
      "id": 11,
      "start": 350.0,
      "end": 371.0,
      "formatted_start": "00:05:50.000",
      "formatted_end": "00:06:11.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 371.0,
      "end": 373.0,
      "formatted_start": "00:06:11.000",
      "formatted_end": "00:06:13.000",
      "text": "این چیه؟ تمیز اجتماعیه؟"
    },
    {
      "id": 13,
      "start": 373.0,
      "end": 375.0,
      "formatted_start": "00:06:13.000",
      "formatted_end": "00:06:15.000",
      "text": "نه، سلامت بگیرم"
    },
    {
      "id": 14,
      "start": 375.0,
      "end": 389.86,
      "formatted_start": "00:06:15.000",
      "formatted_end": "00:06:29.860",
      "text": "خامسمی سویس اومد"
    },
    {
      "id": 15,
      "start": 389.86,
      "end": 392.38,
      "formatted_start": "00:06:29.860",
      "formatted_end": "00:06:32.380",
      "text": "هشتاده هشت"
    },
    {
      "id": 16,
      "start": 392.38,
      "end": 394.42,
      "formatted_start": "00:06:32.380",
      "formatted_end": "00:06:34.420",
      "text": "شسته شیش پنجه ها"
    },
    {
      "id": 17,
      "start": 405.0,
      "end": 415.0,
      "formatted_start": "00:06:45.000",
      "formatted_end": "00:06:55.000",
