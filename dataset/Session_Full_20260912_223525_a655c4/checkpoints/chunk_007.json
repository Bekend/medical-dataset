  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2106.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:06.000",
      "text": "خب، ارزم بزرگ خدمتون که از این دارو خانه این محسوس کدکانش رو بید."
    },
    {
      "id": 1,
      "start": 2106.0,
      "end": 2117.0,
      "formatted_start": "00:35:06.000",
      "formatted_end": "00:35:17.000",
      "text": "داروی نیاز نداره، شرایط رشدیش و تکابلیش سالمه بچه، الان مشکل نداره، فقط صورتشو حتما زده افتاح بزنیدیم."
    },
    {
      "id": 2,
      "start": 2117.0,
      "end": 2121.0,
      "formatted_start": "00:35:17.000",
      "formatted_end": "00:35:21.000",
      "text": "خوش تحساسی داره و این همه لکاها بوده که از سیاره باشه."
    },
    {
      "id": 3,
      "start": 2121.0,
      "end": 2123.0,
      "formatted_start": "00:35:21.000",
      "formatted_end": "00:35:23.000",
      "text": "باید شیر خشک بیدن، برای اون باید..."
    },
    {
      "id": 4,
      "start": 2123.0,
      "end": 2126.0,
      "formatted_start": "00:35:23.000",
      "formatted_end": "00:35:26.000",
      "text": "آه، شیر خشک، ببین مردم برای تون میدیسم."
    },
    {
      "id": 5,
      "start": 2126.0,
      "end": 2127.0,
      "formatted_start": "00:35:26.000",
      "formatted_end": "00:35:27.000",
      "text": "شیره دید؟"
    },
    {
      "id": 6,
      "start": 2127.0,
      "end": 2130.24,
      "formatted_start": "00:35:27.000",
      "formatted_end": "00:35:30.240",
      "text": "شیر و خشک اسماشون میبینیم سمیرادتون میره"
    },
    {
      "id": 7,
      "start": 2130.24,
      "end": 2133.16,
      "formatted_start": "00:35:30.240",
      "formatted_end": "00:35:33.160",
      "text": "تون هشت مایی بیر به بلاک دو"
    },
    {
      "id": 8,
      "start": 2133.16,
      "end": 2135.76,
      "formatted_start": "00:35:33.160",
      "formatted_end": "00:35:35.760",
      "text": "گیگوزه دو"
    },
    {
      "id": 9,
      "start": 2135.76,
      "end": 2139.72,
      "formatted_start": "00:35:35.760",
      "formatted_end": "00:35:39.720",
      "text": "خب نانم که پیدا نیمیشه"
    },
    {
      "id": 10,
      "start": 2139.72,
      "end": 2141.76,
      "formatted_start": "00:35:39.720",
      "formatted_end": "00:35:41.760",
      "text": "مختامیل"
    },
    {
      "id": 11,
      "start": 2141.76,
      "end": 2144.36,
      "formatted_start": "00:35:41.760",
      "formatted_end": "00:35:44.360",
      "text": "دو خب"
    },
    {
      "id": 12,
      "start": 2144.36,
      "end": 2146.84,
      "formatted_start": "00:35:44.360",
      "formatted_end": "00:35:46.840",
      "text": "آیا خواجه اینا"
    },
    {
      "id": 13,
      "start": 2146.84,
      "end": 2152.16,
      "formatted_start": "00:35:46.840",
      "formatted_end": "00:35:52.160",
      "text": "یک و دوشت اختلافش چند بیمی گرم آهنگی که بیم اضافه کردن"
    },
    {
      "id": 14,
      "start": 2152.16,
      "end": 2154.24,
      "formatted_start": "00:35:52.160",
      "formatted_end": "00:35:54.240",
      "text": "دو شش مایی به آهنگ"
    },
    {
      "id": 15,
      "start": 2154.24,
      "end": 2164.24,
      "formatted_start": "00:35:54.240",
      "formatted_end": "00:36:04.240",
      "text": "ببین اونجوری دید. یه مدر مدر سسول بازی را آوردن که کلاسش را یک بزرگ، دو بزرگ، زیر بزرگ"
    },
    {
      "id": 16,
      "start": 2164.24,
      "end": 2169.24,
      "formatted_start": "00:36:04.240",
      "formatted_end": "00:36:09.240",
      "text": "و بعد دیگر ما توی شیر خشک دو آهنگ داریم، مرتی بیتامین ما اینقدر درخواهیم"
    },
    {
      "id": 17,
      "start": 2169.24,
      "end": 2174.24,
      "formatted_start": "00:36:09.240",
      "formatted_end": "00:36:14.240",
      "text": "خیلی مفهوم نداره. طبعا یه شیر خشک را تمامی خوردن و همه روش می کردن"
    },
    {
      "id": 18,
      "start": 2174.24,
      "end": 2180.24,
      "formatted_start": "00:36:14.240",
      "formatted_end": "00:36:20.240",
      "text": "الان برای تجاری کار می کنیم. که مردم را توی بندار خودشون داشته باشن"
    },
    {
      "id": 19,
      "start": 2180.24,
      "end": 2184.48,
      "formatted_start": "00:36:20.240",
      "formatted_end": "00:36:24.480",
      "text": "باشم تو یک و دو روزش. مثل کنکوردی کتاب های صبز و زرد و..."
    },
    {
      "id": 20,
      "start": 2184.48,
      "end": 2187.0,
      "formatted_start": "00:36:24.480",
      "formatted_end": "00:36:27.000",
      "text": "پس اونجوریش من نانی قومت دیگه آوردم."
    },
    {
      "id": 21,
      "start": 2187.0,
      "end": 2190.12,
      "formatted_start": "00:36:27.000",
      "formatted_end": "00:36:30.120",
      "text": "آره نانی یک دوره. به نظر من آهن و ویتامینش هم که میدیدید."
    },
    {
      "id": 22,
      "start": 2190.12,
      "end": 2190.62,
      "formatted_start": "00:36:30.120",
      "formatted_end": "00:36:30.620",
      "text": "آره."
    },
    {
      "id": 23,
      "start": 2190.62,
      "end": 2191.12,
      "formatted_start": "00:36:30.620",
      "formatted_end": "00:36:31.120",
      "text": "تمام."
    },
    {
      "id": 24,
      "start": 2191.12,
      "end": 2191.62,
      "formatted_start": "00:36:31.120",
      "formatted_end": "00:36:31.620",
      "text": "چی بود؟"
    },
    {
      "id": 25,
      "start": 2191.62,
      "end": 2192.12,
      "formatted_start": "00:36:31.620",
      "formatted_end": "00:36:32.120",
      "text": "چی بود؟"
    },
    {
      "id": 26,
      "start": 2192.12,
      "end": 2192.62,
      "formatted_start": "00:36:32.120",
      "formatted_end": "00:36:32.620",
      "text": "چی بود؟"
    },
    {
      "id": 27,
