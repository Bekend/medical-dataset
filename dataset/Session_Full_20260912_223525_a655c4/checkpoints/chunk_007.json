      "end": 2197.62,
      "formatted_start": "00:36:37.120",
      "formatted_end": "00:36:37.620",
      "text": "چی بود؟"
    },
    {
      "id": 37,
      "start": 2197.62,
      "end": 2199.62,
      "formatted_start": "00:36:37.620",
      "formatted_end": "00:36:39.620",
      "text": "آهنگ ها خوبی هستند اونا با کیفی هستند"
    },
    {
      "id": 38,
      "start": 2199.62,
      "end": 2203.62,
      "formatted_start": "00:36:39.620",
      "formatted_end": "00:36:43.620",
      "text": "این شیخ و شاید دویی که هستون بازار هم من نوشتم اگه خواستید"
    },
    {
      "id": 39,
      "start": 2203.62,
      "end": 2205.62,
      "formatted_start": "00:36:43.620",
      "formatted_end": "00:36:45.620",
      "text": "دست شما دست شما"
    },
    {
      "id": 40,
      "start": 2227.62,
      "end": 2247.62,
      "formatted_start": "00:37:07.620",
      "formatted_end": "00:37:27.620",
      "text": "موسیقی"
    },
    {
      "id": 41,
      "start": 2247.62,
      "end": 2277.62,
      "formatted_start": "00:37:27.620",
      "formatted_end": "00:37:57.620",
      "text": "برنامه از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر ا"
    },
    {
      "id": 42,
      "start": 2277.62,
      "end": 2279.62,
      "formatted_start": "00:37:57.620",
      "formatted_end": "00:37:59.620",
      "text": "روزی دوار میدیم"
    },
    {
      "id": 43,
      "start": 2279.62,
      "end": 2281.62,
      "formatted_start": "00:37:59.620",
      "formatted_end": "00:38:01.620",
      "text": "این خوشماننده"
    },
    {
      "id": 44,
      "start": 2281.62,
      "end": 2283.62,
      "formatted_start": "00:38:01.620",
      "formatted_end": "00:38:03.620",
      "text": "یک ماه ش دیگه درسته؟"
    },
    {
      "id": 45,
      "start": 2283.62,
      "end": 2285.62,
      "formatted_start": "00:38:03.620",
      "formatted_end": "00:38:05.620",
      "text": "روزی یک و نیم سی سی"
    },
    {
      "id": 46,
      "start": 2285.62,
      "end": 2287.62,
      "formatted_start": "00:38:05.620",
      "formatted_end": "00:38:07.620",
      "text": "یعنی یک و نیم قطعه چکان"
    },
    {
      "id": 47,
      "start": 2287.62,
      "end": 2289.62,
      "formatted_start": "00:38:07.620",
      "formatted_end": "00:38:09.620",
      "text": "پرد"
    },
    {
      "id": 48,
      "start": 2289.62,
      "end": 2291.62,
      "formatted_start": "00:38:09.620",
      "formatted_end": "00:38:11.620",
      "text": "بعد یه دانو پرد یه نصفه"
    },
    {
      "id": 49,
      "start": 2291.62,
      "end": 2293.62,
      "formatted_start": "00:38:11.620",
      "formatted_end": "00:38:13.620",
      "text": "اینم هشت ساعت پشت قطعه"
    },
    {
      "id": 50,
      "start": 2293.62,
      "end": 2295.62,
      "formatted_start": "00:38:13.620",
      "formatted_end": "00:38:15.620",
