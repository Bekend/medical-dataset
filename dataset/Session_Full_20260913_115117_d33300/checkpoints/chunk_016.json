  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4820.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 4830.0,
      "end": 4838.36,
      "formatted_start": "01:20:30.000",
      "formatted_end": "01:20:38.360",
      "text": "اینجی و حدث دوم عدم گست شدید سلاح هسته است. اونو باید به زمان خود واشنگتون افرادی و خودی است."
    },
    {
      "id": 2,
      "start": 4838.86,
      "end": 4845.52,
      "formatted_start": "01:20:38.860",
      "formatted_end": "01:20:45.520",
      "text": "اولویت نخست امریکا در برابار ایران نه ترکیل رژیم و نه حتی مسئله هسته این باید که ثبوت قیمت اینجی است"
    },
    {
      "id": 3,
      "start": 4845.52,
      "end": 4849.54,
      "formatted_start": "01:20:45.520",
      "formatted_end": "01:20:49.540",
      "text": "و این کمال نقطه ای که ایران برگدرنده ی خودجردن هم قرار داده است."
    },
    {
      "id": 4,
      "start": 4850.06,
      "end": 4854.3,
      "formatted_start": "01:20:50.060",
      "formatted_end": "01:20:54.300",
      "text": "ملابونت ای هم تبانسته از اینه جنگل شریان اقتصاد جهانی گره بزند."
    },
    {
      "id": 5,
      "start": 4854.3,
      "end": 4860.74,
      "formatted_start": "01:20:54.300",
      "formatted_end": "01:21:00.740",
      "text": "چیزی که داشتن پیش از آغاز این ماجره جویی حتی تصورش را هم می بودند"
    },
    {
      "id": 6,
      "start": 4860.74,
      "end": 4878.28,
      "formatted_start": "01:21:00.740",
      "formatted_end": "01:21:18.280",
      "text": "رقمی هزیره های جنگ مزامی به شریال انرژی و افتصاد دیگره در این مدرنگی را ایمی خورد"
    },
    {
      "id": 7,
      "start": 4878.28,
      "end": 4883.24,
      "formatted_start": "01:21:18.280",
      "formatted_end": "01:21:23.240",
      "text": "نبات از تقابل مستقبل بارده محلیه کچی درگرد یعنی جنگ تا برگردی شد"
    },
    {
      "id": 8,
      "start": 4883.24,
      "end": 4887.62,
      "formatted_start": "01:21:23.240",
      "formatted_end": "01:21:27.620",
      "text": "خلید زهرا سایی دیگر یا دستی در سناریه امروز روزنامه ی فرق کنند"
    },
    {
      "id": 9,
      "start": 4887.62,
      "end": 4891.46,
      "formatted_start": "01:21:27.620",
      "formatted_end": "01:21:31.460",
      "text": "به تحقیل سناریه های تدبیلی رسمن آل اوکایی"
    },
    {
      "id": 10,
      "start": 4891.46,
      "end": 4895.46,
      "formatted_start": "01:21:31.460",
      "formatted_end": "01:21:35.460",
      "text": "پس از پستایشی شدن این عوض را دفته و نداشته"
    },
    {
      "id": 11,
      "start": 4895.46,
      "end": 4901.32,
      "formatted_start": "01:21:35.460",
      "formatted_end": "01:21:41.320",
      "text": "مورد شهست روزن از تفقیم نامی که آوریفا در روز دیسپان پس از امزا آنگار نقض کرد"
    },
    {
      "id": 12,
      "start": 4901.32,
      "end": 4903.42,
      "formatted_start": "01:21:41.320",
      "formatted_end": "01:21:43.420",
      "text": "روز یک شنده تمام شدن"
    },
    {
      "id": 13,
      "start": 4903.42,
      "end": 4906.36,
      "formatted_start": "01:21:43.420",
      "formatted_end": "01:21:46.360",
      "text": "این در طریق پنگی هرموز همچنان بزده است"
    },
    {
      "id": 14,
      "start": 4906.36,
      "end": 4913.2,
      "formatted_start": "01:21:46.360",
      "formatted_end": "01:21:53.200",
      "text": "قیمت جهانی نقل بی ثبت و متاثر از کوچکترین تحابلات منطقه شکرنده و همچنان سنویز"
    },
    {
      "id": 15,
      "start": 4913.2,
      "end": 4921.0,
      "formatted_start": "01:21:53.200",
      "formatted_end": "01:22:01.000",
      "text": "و آمیدهایی ها سردردم از وضعیت موجود موزگیری های غصانی یعنی امیدوان و امال محاصره در امیدوان اداره کنند."
    },
    {
      "id": 16,
      "start": 4921.48,
      "end": 4930.26,
      "formatted_start": "01:22:01.480",
      "formatted_end": "01:22:10.260",
      "text": "جنگ حالا بیش از گذشته به نقطه فرصدیش نزدیکی شرد و طرفه دردید در آزمون تاباونی با مداریت اقتصاد انشیق قرار داد."
    },
    {
      "id": 17,
      "start": 4930.26,
      "end": 4934.1,
      "formatted_start": "01:22:10.260",
      "formatted_end": "01:22:14.100",
      "text": "از این جهت است که به سنت وزیر خضاوری آموخا"
    },
    {
      "id": 18,
      "start": 4934.1,
      "end": 4936.78,
      "formatted_start": "01:22:14.100",
      "formatted_end": "01:22:16.780",
      "text": "همشانده سر در مسایج با نیز مرسده"
    },
    {
      "id": 19,
      "start": 4936.78,
      "end": 4939.64,
      "formatted_start": "01:22:16.780",
      "formatted_end": "01:22:19.640",
      "text": "نوع غصت به این رقماتی علاقه ایران اشجا کنیم"
    },
    {
      "id": 20,
      "start": 4939.64,
      "end": 4941.62,
      "formatted_start": "01:22:19.640",
      "formatted_end": "01:22:21.620",
      "text": "که تا کنون هرگز دیده نشده است"
    },
    {
      "id": 21,
      "start": 4941.62,
      "end": 4944.68,
      "formatted_start": "01:22:21.620",
      "formatted_end": "01:22:24.680",
      "text": "و وانس معابد رئیس جمهوره آموخا"
    },
    {
      "id": 22,
      "start": 4960.26,
      "end": 4982.26,
      "formatted_start": "01:22:40.260",
      "formatted_end": "01:23:02.260",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 4982.26,
      "end": 4984.26,
      "formatted_start": "01:23:02.260",
      "formatted_end": "01:23:04.260",
      "text": "خوبی؟"
    },
    {
      "id": 24,
      "start": 4984.26,
      "end": 4986.26,
      "formatted_start": "01:23:04.260",
      "formatted_end": "01:23:06.260",
      "text": "خوبی"
    },
    {
      "id": 25,
      "start": 4986.26,
      "end": 4990.26,
      "formatted_start": "01:23:06.260",
      "formatted_end": "01:23:10.260",
      "text": "شبایی بخوری نوشن کردن آمدیم اینجا"
    },
    {
      "id": 26,
      "start": 4990.26,
      "end": 4992.26,
      "formatted_start": "01:23:10.260",
      "formatted_end": "01:23:12.260",
      "text": "آمدی کردن"
    },
    {
      "id": 27,
      "start": 4992.26,
      "end": 4996.26,
      "formatted_start": "01:23:12.260",
      "formatted_end": "01:23:16.260",
      "text": "برگی سر"
    },
    {
      "id": 28,
      "start": 5012.26,
      "end": 5039.26,
      "formatted_start": "01:23:32.260",
      "formatted_end": "01:23:59.260",
      "text": "موسیقی"
    },
    {
      "id": 29,
      "start": 5039.26,
      "end": 5041.26,
      "formatted_start": "01:23:59.260",
      "formatted_end": "01:24:01.260",
      "text": "سلام"
    },
    {
      "id": 30,
      "start": 5069.26,
      "end": 5071.26,
      "formatted_start": "01:24:29.260",
      "formatted_end": "01:24:31.260",
      "text": "موسیقی"
    },
