  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13810.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:10.000",
      "text": "اینکه کورس میدو، میکروبه، با کسی رو بسیاری کردی، صورت کردی از رسته اینجایش."
    },
    {
      "id": 1,
      "start": 13810.0,
      "end": 13824.0,
      "formatted_start": "03:50:10.000",
      "formatted_end": "03:50:24.000",
      "text": "آنکول چیه امروز؟ آنکول مشکلی است، آنکول چیه؟ آنکول حساسیت است، اینکه باید حساسیت بگردی."
    },
    {
      "id": 2,
      "start": 13824.0,
      "end": 13826.0,
      "formatted_start": "03:50:24.000",
      "formatted_end": "03:50:26.000",
      "text": "این بازون رو نسر کنید"
    },
    {
      "id": 3,
      "start": 13826.0,
      "end": 13828.0,
      "formatted_start": "03:50:26.000",
      "formatted_end": "03:50:28.000",
      "text": "این بازون رو نسر کنید"
    },
    {
      "id": 4,
      "start": 13828.0,
      "end": 13830.0,
      "formatted_start": "03:50:28.000",
      "formatted_end": "03:50:30.000",
      "text": "این بازون رو نسر کنید"
    },
    {
      "id": 5,
      "start": 13830.0,
      "end": 13832.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:32.000",
      "text": "بخواهید"
    },
    {
      "id": 6,
      "start": 13832.0,
      "end": 13834.0,
      "formatted_start": "03:50:32.000",
      "formatted_end": "03:50:34.000",
      "text": "بخواهید"
    },
    {
      "id": 7,
      "start": 13834.0,
      "end": 13836.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:36.000",
      "text": "بخواهید"
    },
    {
      "id": 8,
      "start": 13836.0,
      "end": 13838.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:38.000",
      "text": "بخواهید"
    },
    {
      "id": 9,
      "start": 13838.0,
      "end": 13840.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:40.000",
      "text": "بخواهید"
    },
    {
      "id": 10,
      "start": 13840.0,
      "end": 13842.0,
      "formatted_start": "03:50:40.000",
      "formatted_end": "03:50:42.000",
      "text": "بخواهید"
    },
    {
      "id": 11,
      "start": 13842.0,
      "end": 13844.0,
      "formatted_start": "03:50:42.000",
      "formatted_end": "03:50:44.000",
      "text": "بخواهید"
    },
    {
      "id": 12,
      "start": 13844.0,
      "end": 13846.0,
      "formatted_start": "03:50:44.000",
      "formatted_end": "03:50:46.000",
      "text": "بخواهید"
    },
    {
      "id": 13,
      "start": 13846.0,
      "end": 13848.0,
      "formatted_start": "03:50:46.000",
      "formatted_end": "03:50:48.000",
      "text": "بخواهید"
    },
    {
      "id": 14,
      "start": 13848.0,
      "end": 13850.0,
      "formatted_start": "03:50:48.000",
      "formatted_end": "03:50:50.000",
      "text": "بخواهید"
    },
    {
      "id": 15,
      "start": 13850.0,
      "end": 13852.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:50:52.000",
      "text": "بخواهید"
    },
    {
      "id": 16,
      "start": 13852.0,
      "end": 13856.0,
      "formatted_start": "03:50:52.000",
      "formatted_end": "03:50:56.000",
      "text": "همسر همسلا باید بشوره"
    },
    {
      "id": 17,
      "start": 13856.0,
      "end": 13859.0,
      "formatted_start": "03:50:56.000",
      "formatted_end": "03:50:59.000",
      "text": "باید از این هیگی میگیرید تا بردارید"
    },
    {
      "id": 18,
      "start": 13859.0,
      "end": 13861.0,
      "formatted_start": "03:50:59.000",
      "formatted_end": "03:51:01.000",
      "text": "و میشه استفاده دارید"
    },
    {
      "id": 19,
      "start": 13861.0,
      "end": 13864.0,
      "formatted_start": "03:51:01.000",
      "formatted_end": "03:51:04.000",
      "text": "این دو دو کماده هر شب بزنید"
    },
    {
      "id": 20,
      "start": 13864.0,
      "end": 13867.0,
      "formatted_start": "03:51:04.000",
      "formatted_end": "03:51:07.000",
      "text": "داخل نهارم بزنید"
    },
    {
      "id": 21,
      "start": 13867.0,
      "end": 13870.0,
      "formatted_start": "03:51:07.000",
      "formatted_end": "03:51:10.000",
      "text": "صبح به صبح کلی چهر میدن پارش میشه"
    },
    {
      "id": 22,
      "start": 13870.0,
      "end": 13873.0,
      "formatted_start": "03:51:10.000",
      "formatted_end": "03:51:13.000",
      "text": "بعد شبیه هر شب پرشنگ کنید"
    },
    {
      "id": 23,
      "start": 13873.0,
      "end": 13875.0,
      "formatted_start": "03:51:13.000",
      "formatted_end": "03:51:15.000",
      "text": "نهارم بزنید"
    },
    {
      "id": 24,
      "start": 13875.0,
      "end": 13876.0,
      "formatted_start": "03:51:15.000",
      "formatted_end": "03:51:16.000",
      "text": "یک چیز دیگه باشه"
    },
    {
      "id": 25,
      "start": 13876.0,
      "end": 13877.0,
      "formatted_start": "03:51:16.000",
      "formatted_end": "03:51:17.000",
      "text": "باشه"
    },
    {
      "id": 26,
      "start": 13877.0,
      "end": 13878.0,
      "formatted_start": "03:51:17.000",
      "formatted_end": "03:51:18.000",
      "text": "باشه"
    },
    {
      "id": 27,
      "start": 13878.0,
      "end": 13880.0,
      "formatted_start": "03:51:18.000",
      "formatted_end": "03:51:20.000",
      "text": "باشه"
    },
    {
      "id": 28,
      "start": 13880.0,
      "end": 13885.0,
      "formatted_start": "03:51:20.000",
      "formatted_end": "03:51:25.000",
      "text": "باشه تیاتور باشه، هوا باشه"
    },
    {
      "id": 29,
      "start": 13885.0,
      "end": 13892.0,
      "formatted_start": "03:51:25.000",
      "formatted_end": "03:51:32.000",
      "text": "مردم این که آف دوسته از اینکه نتوشین، مردم توانه تنها این راحتی، این لباسی که خواهستان باشه"
    },
    {
      "id": 30,
      "start": 13892.0,
      "end": 13900.0,
      "formatted_start": "03:51:32.000",
      "formatted_end": "03:51:40.000",
      "text": "این هم پول ها هم که کفری برای درد استخباریتون این برای کنترال ادرالی، یه دونه صبح، یه دونه قدوم"
    },
    {
      "id": 31,
      "start": 13900.0,
      "end": 13901.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:41.000",
      "text": "نوشته؟"
    },
    {
      "id": 32,
      "start": 13901.0,
      "end": 13908.0,
      "formatted_start": "03:51:41.000",
      "formatted_end": "03:51:48.000",
      "text": "به تو یکیش نوشته باید، این هم برای تو شمونت ادرال، نوشته ساعتاشون، هشت ساعت"
    },
    {
      "id": 33,
      "start": 13908.0,
      "end": 13910.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:50.000",
      "text": "ساعتش رو نگاه می کنی؟"
    },
    {
      "id": 34,
      "start": 13910.0,
      "end": 13914.0,
      "formatted_start": "03:51:50.000",
      "formatted_end": "03:51:54.000",
      "text": "من اگه یکمثالاً نیم ساعتی تر شد، این رو مثلاً بسیار مهم میگی"
    },
    {
      "id": 35,
      "start": 13914.0,
      "end": 13916.0,
      "formatted_start": "03:51:54.000",
      "formatted_end": "03:51:56.000",
      "text": "نه نه نه"
    },
    {
      "id": 36,
      "start": 13916.0,
      "end": 13918.0,
      "formatted_start": "03:51:56.000",
      "formatted_end": "03:51:58.000",
      "text": "خوبیست"
    },
    {
      "id": 37,
      "start": 13918.0,
      "end": 13920.0,
      "formatted_start": "03:51:58.000",
      "formatted_end": "03:52:00.000",
      "text": "این شب یکی صبح بگیر نمیشه"
    },
    {
      "id": 38,
      "start": 13920.0,
      "end": 13922.0,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:02.000",
      "text": "صبح و شب"
    },
    {
      "id": 39,
      "start": 13922.0,
      "end": 13924.0,
      "formatted_start": "03:52:02.000",
      "formatted_end": "03:52:04.000",
      "text": "منم تاون کنم که یاد می کنم"
    },
    {
      "id": 40,
      "start": 13924.0,
      "end": 13926.0,
      "formatted_start": "03:52:04.000",
      "formatted_end": "03:52:06.000",
      "text": "بی ثوادی ساره ما همینجاست"
    },
    {
      "id": 41,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "بسیار خوب"
    },
    {
      "id": 42,
      "start": 13928.0,
      "end": 13930.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:10.000",
      "text": "بی ثواد ها بهتره دیگه"
    },
    {
      "id": 43,
      "start": 13930.0,
      "end": 13932.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:12.000",
      "text": "اینم بی ثوادی، روزی دو"
    },
    {
      "id": 44,
      "start": 13932.0,
      "end": 13934.0,
      "formatted_start": "03:52:12.000",
      "formatted_end": "03:52:14.000",
      "text": "اینم که یک"
    },
    {
      "id": 45,
      "start": 13934.0,
      "end": 13936.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:16.000",
      "text": "با همسه"
    },
    {
      "id": 46,
      "start": 13936.0,
      "end": 13938.0,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:18.000",
      "text": "برای این لسفه باون نشان باشن"
    },
    {
      "id": 47,
      "start": 13938.0,
      "end": 13940.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:20.000",
      "text": "چون من دیگر آدم نمی آد"
    },
    {
      "id": 48,
      "start": 13940.0,
      "end": 13942.0,
      "formatted_start": "03:52:20.000",
      "formatted_end": "03:52:22.000",
      "text": "از همین ها با خودم می آرم دیگه"
    },
    {
      "id": 49,
      "start": 13942.0,
      "end": 13944.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:24.000",
      "text": "عکسشم بگیرید"
    },
    {
      "id": 50,
      "start": 13944.0,
      "end": 13946.0,
      "formatted_start": "03:52:24.000",
      "formatted_end": "03:52:26.000",
      "text": "عکس که گرفتم"
    },
    {
      "id": 51,
      "start": 13946.0,
      "end": 13948.0,
      "formatted_start": "03:52:26.000",
      "formatted_end": "03:52:28.000",
      "text": "برو من"
    },
    {
      "id": 52,
      "start": 13948.0,
      "end": 13950.0,
      "formatted_start": "03:52:28.000",
      "formatted_end": "03:52:30.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 53,
      "start": 13950.0,
      "end": 13952.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:32.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 54,
      "start": 13952.0,
      "end": 13954.0,
      "formatted_start": "03:52:32.000",
      "formatted_end": "03:52:34.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 55,
      "start": 13954.0,
      "end": 13956.0,
      "formatted_start": "03:52:34.000",
      "formatted_end": "03:52:36.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 56,
      "start": 13956.0,
      "end": 13958.0,
      "formatted_start": "03:52:36.000",
      "formatted_end": "03:52:38.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 57,
      "start": 13958.0,
      "end": 13960.0,
      "formatted_start": "03:52:38.000",
      "formatted_end": "03:52:40.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 58,
      "start": 13960.0,
      "end": 13962.0,
      "formatted_start": "03:52:40.000",
      "formatted_end": "03:52:42.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 59,
      "start": 13962.0,
      "end": 13964.0,
      "formatted_start": "03:52:42.000",
      "formatted_end": "03:52:44.000",
      "text": "خدا خدا خدا"
    },
    {
      "id": 60,
      "start": 13964.0,
      "end": 13966.0,
      "formatted_start": "03:52:44.000",
      "formatted_end": "03:52:46.000",
      "text": "اینکه دیگه شده دیگه"
    },
    {
      "id": 61,
      "start": 13966.0,
      "end": 13968.0,
      "formatted_start": "03:52:46.000",
      "formatted_end": "03:52:48.000",
      "text": "فلکس رو دوست دارم"
    },
    {
      "id": 62,
      "start": 13968.0,
      "end": 13970.0,
      "formatted_start": "03:52:48.000",
      "formatted_end": "03:52:50.000",
      "text": "شوهرم در دوست دارم با فلکس"
    },
    {
      "id": 63,
      "start": 13970.0,
      "end": 13972.0,
      "formatted_start": "03:52:50.000",
      "formatted_end": "03:52:52.000",
      "text": "تو بازی میگفتی مادر شوهر شوهر کرده؟"
    },
    {
      "id": 64,
      "start": 13972.0,
      "end": 13973.0,
      "formatted_start": "03:52:52.000",
      "formatted_end": "03:52:53.000",
      "text": "آه نه"
    },
    {
      "id": 65,
      "start": 13973.0,
      "end": 13974.0,
      "formatted_start": "03:52:53.000",
      "formatted_end": "03:52:54.000",
      "text": "آه، تو از چیکار کرده؟"
    },
    {
      "id": 66,
      "start": 13974.0,
      "end": 13976.0,
      "formatted_start": "03:52:54.000",
      "formatted_end": "03:52:56.000",
      "text": "دیگه هیچی نیست، زد دوست دارم قابلشون"
    },
    {
      "id": 67,
      "start": 13976.0,
      "end": 13978.0,
      "formatted_start": "03:52:56.000",
      "formatted_end": "03:52:58.000",
      "text": "شوهر زد که شوهر اون زد؟"
    },
    {
      "id": 68,
      "start": 13978.0,
      "end": 13979.0,
      "formatted_start": "03:52:58.000",
      "formatted_end": "03:52:59.000",
      "text": "شوهر"
    },
    {
      "id": 69,
      "start": 13979.0,
      "end": 13980.0,
      "formatted_start": "03:52:59.000",
      "formatted_end": "03:53:00.000",
      "text": "شوهر خوده؟"
    },
    {
      "id": 70,
      "start": 13980.0,
      "end": 13981.0,
      "formatted_start": "03:53:00.000",
      "formatted_end": "03:53:01.000",
      "text": "آه نه"
    },
    {
      "id": 71,
      "start": 13981.0,
      "end": 13982.0,
      "formatted_start": "03:53:01.000",
      "formatted_end": "03:53:02.000",
      "text": "چی میزنه؟"
    },
    {
      "id": 72,
      "start": 13982.0,
      "end": 13984.0,
      "formatted_start": "03:53:02.000",
      "formatted_end": "03:53:04.000",
      "text": "بگو که تو چیکار با مادر من داری"
    },
    {
      "id": 73,
      "start": 13984.0,
      "end": 13986.0,
      "formatted_start": "03:53:04.000",
      "formatted_end": "03:53:06.000",
      "text": "بهش میگی چوپان دارو"
    },
    {
      "id": 74,
      "start": 13986.0,
      "end": 13988.0,
      "formatted_start": "03:53:06.000",
      "formatted_end": "03:53:08.000",
      "text": "گفتم اونجور پان دارم که که"
    },
    {
      "id": 75,
      "start": 13988.0,
      "end": 13990.0,
      "formatted_start": "03:53:08.000",
      "formatted_end": "03:53:10.000",
      "text": "ما رفته بودیم که کربلا"
    },
    {
      "id": 76,
      "start": 13990.0,
      "end": 13995.0,
      "formatted_start": "03:53:10.000",
      "formatted_end": "03:53:15.000",
      "text": "زنگ داده به من میگه کار مامان مانو شوهرش گرده داخل مشهر بر کرده"
    },
    {
      "id": 77,
      "start": 13995.0,
      "end": 13999.0,
      "formatted_start": "03:53:15.000",
      "formatted_end": "03:53:19.000",
      "text": "و من زنگ دادم به شوهرش گفتم خجات پیش مادرش رو هم دارم"
    },
    {
      "id": 78,
      "start": 13999.0,
      "end": 14000.0,
      "formatted_start": "03:53:19.000",
      "formatted_end": "03:53:20.000",
      "text": "تو شوهر داده بودی اونو؟"
    },
    {
      "id": 79,
      "start": 14000.0,
      "end": 14001.0,
      "formatted_start": "03:53:20.000",
      "formatted_end": "03:53:21.000",
      "text": "آره"
    },
    {
      "id": 80,
      "start": 14001.0,
      "end": 14004.0,
      "formatted_start": "03:53:21.000",
      "formatted_end": "03:53:24.000",
      "text": "بر برش که خدا مانو برش نکردم بازم خونه دوستش بذاشتم"
    },
    {
      "id": 81,
      "start": 14004.0,
      "end": 14006.0,
      "formatted_start": "03:53:24.000",
      "formatted_end": "03:53:26.000",
      "text": "بهش گفتم بیا برو خونه پسره"
    },
    {
      "id": 82,
      "start": 14006.0,
      "end": 14008.0,
      "formatted_start": "03:53:26.000",
      "formatted_end": "03:53:28.000",
      "text": "مانو پسرم خونه را نمیده"
    },
    {
      "id": 83,
      "start": 14008.0,
      "end": 14010.0,
      "formatted_start": "03:53:28.000",
      "formatted_end": "03:53:30.000",
      "text": "خونه هم خونه دوستش بذاشتم"
    },
    {
      "id": 84,
      "start": 14010.0,
      "end": 14013.28,
      "formatted_start": "03:53:30.000",
      "formatted_end": "03:53:33.280",
      "text": "گفتم من از معمولیت بیام و باید برم دنبالش"
    },
    {
      "id": 85,
      "start": 14013.28,
      "end": 14015.28,
      "formatted_start": "03:53:33.280",
      "formatted_end": "03:53:35.280",
      "text": "کارش چیه؟"
    },
    {
      "id": 86,
      "start": 14015.28,
      "end": 14017.28,
      "formatted_start": "03:53:35.280",
      "formatted_end": "03:53:37.280",
      "text": "شوهر سرهنگه"
    },
    {
      "id": 87,
      "start": 14017.28,
      "end": 14018.28,
      "formatted_start": "03:53:37.280",
      "formatted_end": "03:53:38.280",
      "text": "سرهنگه؟"
    },
    {
      "id": 88,
      "start": 14018.28,
      "end": 14019.28,
      "formatted_start": "03:53:38.280",
      "formatted_end": "03:53:39.280",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 14019.28,
      "end": 14023.28,
      "formatted_start": "03:53:39.280",
      "formatted_end": "03:53:43.280",
      "text": "باید... چون دارتیشون چیه انا؟"
    },
    {
      "id": 90,
      "start": 14023.28,
      "end": 14027.28,
      "formatted_start": "03:53:43.280",
      "formatted_end": "03:53:47.280",
      "text": "بی چی میگی من گلاشتی بوده خونه دوست هم گذاشته"
    },
    {
      "id": 91,
      "start": 14027.28,
      "end": 14030.28,
      "formatted_start": "03:53:47.280",
      "formatted_end": "03:53:50.280",
      "text": "تا دن 3-4-5 روزه نمیم من دنبالم"
    },
    {
      "id": 92,
      "start": 14030.28,
      "end": 14035.28,
      "formatted_start": "03:53:50.280",
      "formatted_end": "03:53:55.280",
      "text": "میگم خب معمولیت کارش بهتونم گفته که شاید 10 روز شاید 15 روز طول بگشه"
    },
    {
      "id": 93,
      "start": 14035.28,
      "end": 14039.28,
      "formatted_start": "03:53:55.280",
      "formatted_end": "03:53:59.280",
      "text": "مادر شوهرتی میخواد برای چی گرفته مثلا؟"
    },
    {
      "id": 94,
      "start": 14039.28,
      "end": 14043.28,
      "formatted_start": "03:53:59.280",
      "formatted_end": "03:54:03.280",
      "text": "خوشش آمده"
    },
    {
      "id": 95,
      "start": 14043.28,
      "end": 14047.28,
      "formatted_start": "03:54:03.280",
      "formatted_end": "03:54:07.280",
      "text": "چیز هر جوان برش میگه"
    },
    {
      "id": 96,
      "start": 14047.28,
      "end": 14051.28,
      "formatted_start": "03:54:07.280",
      "formatted_end": "03:54:11.280",
      "text": "وضعی مالیش خوبه"
    },
    {
      "id": 97,
      "start": 14051.28,
      "end": 14055.28,
      "formatted_start": "03:54:11.280",
      "formatted_end": "03:54:15.280",
      "text": "مالیش هم مالیش هم"
    },
    {
      "id": 98,
      "start": 14055.28,
      "end": 14059.28,
      "formatted_start": "03:54:15.280",
      "formatted_end": "03:54:19.280",
      "text": "که دختر این آبو جوشه"
    },
    {
      "id": 99,
      "start": 14059.28,
      "end": 14063.28,
      "formatted_start": "03:54:19.280",
      "formatted_end": "03:54:23.280",
      "text": "روز پنجشنبه"
    },
    {
      "id": 100,
      "start": 14063.28,
      "end": 14067.28,
      "formatted_start": "03:54:23.280",
      "formatted_end": "03:54:27.280",
      "text": "خیلی کمال آفاست هم"
    },
    {
      "id": 101,
      "start": 14067.28,
      "end": 14069.28,
      "formatted_start": "03:54:27.280",
      "formatted_end": "03:54:29.280",
      "text": "موسیقی"
    },
    {
      "id": 102,
      "start": 14097.28,
      "end": 14099.96,
      "formatted_start": "03:54:57.280",
      "formatted_end": "03:54:59.960",
      "text": "برای خوب بسیار در اینجوریت سپس"
    }
  ],
  "status": "completed"
}