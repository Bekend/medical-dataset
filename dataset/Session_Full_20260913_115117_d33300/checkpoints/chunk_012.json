  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3614.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:14.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3636.5,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:36.500",
      "text": "با نشانی ebu.inau.ac.ir برای انتخابش رو اقدام کنند"
    },
    {
      "id": 2,
      "start": 3636.5,
      "end": 3642.6,
      "formatted_start": "01:00:36.500",
      "formatted_end": "01:00:42.600",
      "text": "ورودی های 402 و موقع در موقع اول از ساعت 8 و 11 و 30"
    },
    {
      "id": 3,
      "start": 3642.6,
      "end": 3648.2,
      "formatted_start": "01:00:42.600",
      "formatted_end": "01:00:48.200",
      "text": "ورودی های 1403 در موقع دوم از ساعت 11 و 15 و 30"
    },
    {
      "id": 4,
      "start": 3648.2,
      "end": 3653.44,
      "formatted_start": "01:00:48.200",
      "formatted_end": "01:00:53.440",
      "text": "ورودی های 1604 در موقع ثبوت از ساعت 16 و 20"
    },
    {
      "id": 5,
      "start": 3653.44,
      "end": 3656.08,
      "formatted_start": "01:00:53.440",
      "formatted_end": "01:00:56.080",
      "text": "میتوانند ادام به انتخاب واحد برد"
    },
    {
      "id": 6,
      "start": 3656.08,
      "end": 3662.08,
      "formatted_start": "01:00:56.080",
      "formatted_end": "01:01:02.080",
      "text": "انتخابه بای دوستان تهران در چهار و دویست و هشتم، دویست و دوم، سی و یکم و یکم"
    },
    {
      "id": 7,
      "start": 3662.08,
      "end": 3666.08,
      "formatted_start": "01:01:02.080",
      "formatted_end": "01:01:06.080",
      "text": "سی و یکم مرداد و یکم شهروره انجام میشنند"
    },
    {
      "id": 8,
      "start": 3670.08,
      "end": 3674.08,
      "formatted_start": "01:01:10.080",
      "formatted_end": "01:01:14.080",
      "text": "معاون آموزش افتدایی وزارت آموزش و پرورش گفت"
    },
    {
      "id": 9,
      "start": 3674.08,
      "end": 3681.08,
      "formatted_start": "01:01:14.080",
      "formatted_end": "01:01:21.080",
      "text": "از یکمیلیمه سد و پنجی و چهار هزار هزار تلاسف ولی سفتنام بیش از نویدو یک درصد با سامانه بینه قطعی شده"
    },
    {
      "id": 10,
      "start": 3681.08,
      "end": 3688.58,
      "formatted_start": "01:01:21.080",
      "formatted_end": "01:01:28.580",
      "text": "به روح خانمه هرگیزه به این سال سختانه تا سختانه تا با سهولت بیشتر این بیسترد به قبل انجام شده"
    },
    {
      "id": 11,
      "start": 3694.58,
      "end": 3704.38,
      "formatted_start": "01:01:34.580",
      "formatted_end": "01:01:44.380",
      "text": "پای مردی و استادهی محکوم ایران به شب صد و شسته هفته اون پسیدی شب هم جا بانهای شهرهای ممتلافه گشور سنه بزیر مردم"
    },
    {
      "id": 12,
      "start": 3704.38,
      "end": 3712.54,
      "formatted_start": "01:01:44.380",
      "formatted_end": "01:01:52.540",
      "text": "اینجوری که در طول این مدت به جلوه از اینسته جامعه مدی و استادیدی مدت ایران دعوادار و پیشاهای دشمن را ترکیل شده"
    },
    {
      "id": 13,
      "start": 3712.54,
      "end": 3722.4,
      "formatted_start": "01:01:52.540",
      "formatted_end": "01:02:02.400",
      "text": "مردم که سهمی در امنیت ملی دار"
    },
    {
      "id": 14,
      "start": 3722.4,
      "end": 3725.38,
      "formatted_start": "01:02:02.400",
      "formatted_end": "01:02:05.380",
      "text": "همونطوری که الان نیروه نظامی ما توی تنگه همون هستند"
    },
    {
      "id": 15,
      "start": 3726.06,
      "end": 3729.6,
      "formatted_start": "01:02:06.060",
      "formatted_end": "01:02:09.600",
      "text": "مردم هم به پشتونه اونها الان توی تیابه همونده"
    },
    {
      "id": 16,
      "start": 3734.38,
      "end": 3737.68,
      "formatted_start": "01:02:14.380",
      "formatted_end": "01:02:17.680",
      "text": "اما این ایران در مواجهه با فشال دشمنان چیه؟"
    },
    {
      "id": 17,
      "start": 3737.68,
      "end": 3746.3,
      "formatted_start": "01:02:17.680",
      "formatted_end": "01:02:26.300",
      "text": "همین وحدت ملت عزیزمون و تایب بندی به اصول و عرضشای نظام مقدس کمور اسلامی داریم"
    },
    {
      "id": 18,
      "start": 3746.3,
      "end": 3752.26,
      "formatted_start": "01:02:26.300",
      "formatted_end": "01:02:32.260",
      "text": "مرداروزی بخواید به بچهتون توضیح بدید که چرا از بطن دفاع کردید؟ چی میگید؟"
    },
    {
      "id": 19,
      "start": 3752.26,
      "end": 3753.88,
      "formatted_start": "01:02:32.260",
      "formatted_end": "01:02:33.880",
      "text": "به خاطر خواهشه بطنم"
    },
    {
      "id": 20,
      "start": 3753.88,
      "end": 3756.78,
      "formatted_start": "01:02:33.880",
      "formatted_end": "01:02:36.780",
      "text": "نیمبر فرمود همون بطن منه ریمان"
    },
    {
      "id": 21,
      "start": 3756.78,
      "end": 3758.66,
      "formatted_start": "01:02:36.780",
      "formatted_end": "01:02:38.660",
      "text": "مقامت شنبه چیه؟"
    },
    {
      "id": 22,
      "start": 3758.66,
      "end": 3761.88,
      "formatted_start": "01:02:38.660",
      "formatted_end": "01:02:41.880",
      "text": "نیروه مسلم ها تو جبهه ها کارشون انجام میدن"
    },
    {
      "id": 23,
      "start": 3761.88,
      "end": 3764.6,
      "formatted_start": "01:02:41.880",
      "formatted_end": "01:02:44.600",
      "text": "ماتو فیاهون تحصیل کرده تو دانشگاه"
    },
    {
      "id": 24,
      "start": 3764.6,
      "end": 3767.68,
      "formatted_start": "01:02:44.600",
      "formatted_end": "01:02:47.680",
      "text": "یه نمونه از چی که از دانشگاه در مقابل ایرانی ها رو میتونیم بیدیم"
    },
    {
      "id": 25,
      "start": 3767.68,
      "end": 3773.94,
      "formatted_start": "01:02:47.680",
      "formatted_end": "01:02:53.940",
      "text": "این که سربازان امریکایی سیر فشار جنگ با ایران خودشون رو به دریا پرد کردن"
    },
    {
      "id": 26,
      "start": 3773.94,
      "end": 3777.46,
      "formatted_start": "01:02:53.940",
      "formatted_end": "01:02:57.460",
      "text": "اگر دشمنت ها به امروز نتونسته به این کشور نقود پیدا کنه"
    },
    {
      "id": 27,
      "start": 3777.46,
      "end": 3781.4,
      "formatted_start": "01:02:57.460",
      "formatted_end": "01:03:01.400",
      "text": "و معیود شده بر از همه وفاقی که داریم"
    },
    {
      "id": 28,
      "start": 3781.4,
      "end": 3790.16,
      "formatted_start": "01:03:01.400",
      "formatted_end": "01:03:10.160",
      "text": "نشناخت مردم ایران و مردم ایران"
    },
    {
      "id": 29,
      "start": 3790.16,
      "end": 3794.2,
      "formatted_start": "01:03:10.160",
      "formatted_end": "01:03:14.200",
      "text": "هر طرح رو فشار بیاد محکمتر میشه"
    },
    {
      "id": 30,
      "start": 3794.2,
      "end": 3797.26,
      "formatted_start": "01:03:14.200",
      "formatted_end": "01:03:17.260",
      "text": "دشمن روی فشار اقتصادی بیشتر نظام باز کرده"
    },
    {
      "id": 31,
      "start": 3797.26,
      "end": 3799.02,
      "formatted_start": "01:03:17.260",
      "formatted_end": "01:03:19.020",
      "text": "یا روی اختلاف بین مردم"
    },
    {
      "id": 32,
      "start": 3799.02,
      "end": 3800.06,
      "formatted_start": "01:03:19.020",
      "formatted_end": "01:03:20.060",
      "text": "روی اختلاف"
    },
    {
      "id": 33,
      "start": 3800.06,
      "end": 3801.72,
      "formatted_start": "01:03:20.060",
      "formatted_end": "01:03:21.720",
      "text": "روی پفرقه"
    },
    {
      "id": 34,
      "start": 3801.72,
      "end": 3807.36,
      "formatted_start": "01:03:21.720",
      "formatted_end": "01:03:27.360",
      "text": "ما اومدید اینجا که با رهبرمون سید موشمه حسینی خامنهی بیاد کنیم"
    },
    {
      "id": 35,
      "start": 3807.36,
      "end": 3810.72,
      "formatted_start": "01:03:27.360",
      "formatted_end": "01:03:30.720",
      "text": "مهمترین سرمایه ما در مباته با فشار دشمن"
    },
    {
      "id": 36,
      "start": 3810.72,
      "end": 3814.2,
      "formatted_start": "01:03:30.720",
      "formatted_end": "01:03:34.200",
      "text": "مهمترین سرمایه ما سرمایه انسانی هستش که"
    },
    {
      "id": 37,
      "start": 3814.2,
      "end": 3817.4,
      "formatted_start": "01:03:34.200",
      "formatted_end": "01:03:37.400",
      "text": "پشت به حکومت و ولایت پبیه من باشیم"
    },
    {
      "id": 38,
      "start": 3817.4,
      "end": 3825.02,
      "formatted_start": "01:03:37.400",
      "formatted_end": "01:03:45.020",
      "text": "و به همه ثابت کنیم که ما همیشه پای صحنه هستیم و در مقابل دشمنان هرگز پتاه نمی آییم"
    },
    {
      "id": 39,
      "start": 3825.02,
      "end": 3828.44,
      "formatted_start": "01:03:45.020",
      "formatted_end": "01:03:48.440",
      "text": "بابایی مطلعه بود و جوانان پای رانچره بود"
    },
    {
      "id": 40,
      "start": 3828.44,
      "end": 3836.32,
      "formatted_start": "01:03:48.440",
      "formatted_end": "01:03:56.320",
      "text": "کلتر شما تنگه هرموز چه منایی چه مفهوم دارید در حمیت مدی و مدت مایانی ها دارید"
    },
    {
      "id": 41,
      "start": 3836.32,
      "end": 3844.4,
      "formatted_start": "01:03:56.320",
      "formatted_end": "01:04:04.400",
      "text": "خدا را شد با تنگه هرموز بابایی احرام اصلی در اخیار ایران قرار داره"
    },
    {
      "id": 42,
      "start": 3844.4,
      "end": 3852.0,
      "formatted_start": "01:04:04.400",
      "formatted_end": "01:04:12.000",
      "text": "و ما هم در میدان هم در دیپلماسی میجونیم از این احرام خیلی خوب استقاده بکنیم"
    },
    {
      "id": 43,
      "start": 3852.0,
      "end": 3865.94,
      "formatted_start": "01:04:12.000",
      "formatted_end": "01:04:25.940",
