  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11702.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:02.000",
      "text": "سلام، سلام."
    },
    {
      "id": 1,
      "start": 11702.0,
      "end": 11704.0,
      "formatted_start": "03:15:02.000",
      "formatted_end": "03:15:04.000",
      "text": "بفرماییم."
    },
    {
      "id": 2,
      "start": 11704.0,
      "end": 11706.0,
      "formatted_start": "03:15:04.000",
      "formatted_end": "03:15:06.000",
      "text": "خیلی خوشنوشید."
    },
    {
      "id": 3,
      "start": 11706.0,
      "end": 11708.0,
      "formatted_start": "03:15:06.000",
      "formatted_end": "03:15:08.000",
      "text": "خیلی خوشنوشید."
    },
    {
      "id": 4,
      "start": 11708.0,
      "end": 11710.0,
      "formatted_start": "03:15:08.000",
      "formatted_end": "03:15:10.000",
      "text": "یا بدن."
    },
    {
      "id": 5,
      "start": 11712.0,
      "end": 11714.0,
      "formatted_start": "03:15:12.000",
      "formatted_end": "03:15:14.000",
      "text": "در خدمت شما است."
    },
    {
      "id": 6,
      "start": 11714.0,
      "end": 11716.0,
      "formatted_start": "03:15:14.000",
      "formatted_end": "03:15:16.000",
      "text": "عادت رو میگردم، افزادرم از روزه."
    },
    {
      "id": 7,
      "start": 11716.0,
      "end": 11718.0,
      "formatted_start": "03:15:16.000",
      "formatted_end": "03:15:18.000",
      "text": "نرم."
    },
    {
      "id": 8,
      "start": 11718.0,
      "end": 11720.0,
      "formatted_start": "03:15:18.000",
      "formatted_end": "03:15:20.000",
      "text": "الان سه شب اصلا نمیخواهم بودیم."
    },
    {
      "id": 9,
      "start": 11720.0,
      "end": 11722.0,
      "formatted_start": "03:15:20.000",
      "formatted_end": "03:15:22.000",
      "text": "دهانو باز کنید. ببینم."
    },
    {
      "id": 10,
      "start": 11722.0,
      "end": 11724.0,
      "formatted_start": "03:15:22.000",
      "formatted_end": "03:15:24.000",
      "text": "سر رو بالا بگیریم."
    },
    {
      "id": 11,
      "start": 11724.0,
      "end": 11726.0,
      "formatted_start": "03:15:24.000",
      "formatted_end": "03:15:26.000",
      "text": "خواله رو سه تا زیاده هست."
    },
    {
      "id": 12,
      "start": 11726.0,
      "end": 11728.0,
      "formatted_start": "03:15:26.000",
      "formatted_end": "03:15:28.000",
      "text": "تای گرهو تصمتی سر جهه."
    },
    {
      "id": 13,
      "start": 11728.0,
      "end": 11730.0,
      "formatted_start": "03:15:28.000",
      "formatted_end": "03:15:30.000",
      "text": "بسیار جلی خواهد می کنید."
    },
    {
      "id": 14,
      "start": 11730.0,
      "end": 11732.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:32.000",
      "text": "دسته بسرش کنید."
    },
    {
      "id": 15,
      "start": 11749.0,
      "end": 11753.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:53.000",
      "text": "از این مکتها آف سر جرم هایی که تو تنش هم دارم؟"
    },
    {
      "id": 16,
      "start": 11753.0,
      "end": 11755.0,
      "formatted_start": "03:15:53.000",
      "formatted_end": "03:15:55.000",
      "text": "آفت و جل نزده باشی"
    },
    {
      "id": 17,
      "start": 11755.0,
      "end": 11758.0,
      "formatted_start": "03:15:55.000",
      "formatted_end": "03:15:58.000",
      "text": "جلی که من میدم یا جلی که بچه های گرفتن"
    },
    {
      "id": 18,
      "start": 11758.0,
      "end": 11760.0,
      "formatted_start": "03:15:58.000",
      "formatted_end": "03:16:00.000",
      "text": "بچه های گرفتن"
    },
    {
      "id": 19,
      "start": 11760.0,
      "end": 11764.0,
      "formatted_start": "03:16:00.000",
      "formatted_end": "03:16:04.000",
      "text": "جلی آف فقط یک مشکوبه"
    },
    {
      "id": 20,
      "start": 11764.0,
      "end": 11767.0,
      "formatted_start": "03:16:04.000",
      "formatted_end": "03:16:07.000",
      "text": "که بخشیه سیزده"
    },
    {
      "id": 21,
      "start": 11767.0,
      "end": 11770.0,
      "formatted_start": "03:16:07.000",
      "formatted_end": "03:16:10.000",
      "text": "که پروسیپشان"
    },
    {
      "id": 22,
      "start": 11770.0,
      "end": 11772.0,
      "formatted_start": "03:16:10.000",
      "formatted_end": "03:16:12.000",
      "text": "پروسیپشان پردی امروز"
    },
    {
      "id": 23,
      "start": 11772.0,
      "end": 11773.0,
      "formatted_start": "03:16:12.000",
      "formatted_end": "03:16:13.000",
      "text": "کند رو پردی؟"
    },
    {
      "id": 24,
      "start": 11773.0,
      "end": 11774.0,
      "formatted_start": "03:16:13.000",
      "formatted_end": "03:16:14.000",
      "text": "سیزده سیزده"
    },
    {
      "id": 25,
      "start": 11774.0,
      "end": 11775.0,
      "formatted_start": "03:16:14.000",
      "formatted_end": "03:16:15.000",
      "text": "سیزده؟"
    },
    {
      "id": 26,
      "start": 11775.0,
      "end": 11779.0,
      "formatted_start": "03:16:15.000",
      "formatted_end": "03:16:19.000",
      "text": "جلی ایران وکس"
    },
    {
      "id": 27,
      "start": 11779.0,
      "end": 11787.0,
      "formatted_start": "03:16:19.000",
      "formatted_end": "03:16:27.000",
      "text": "مکیدنی آلتانی، شکالات، دوتا مکیدنی داریم بیزاریم به زبان میبنیم"
    },
    {
      "id": 28,
      "start": 11787.0,
      "end": 11795.0,
      "formatted_start": "03:16:27.000",
      "formatted_end": "03:16:35.000",
      "text": "خوشکننده بیخورد یک تارتونیک، یک پودر هم از دم می کنیم، قاشق قاشق می کنیم، یک نفر نمی کنیم، نرم می کنیم"
    },
    {
      "id": 29,
      "start": 11795.0,
      "end": 11803.0,
      "formatted_start": "03:16:35.000",
      "formatted_end": "03:16:43.000",
      "text": "مثل زخمی، آفتوژل هم برعکس بکتر می کنه"
    },
    {
      "id": 30,
      "start": 11803.0,
      "end": 11805.0,
      "formatted_start": "03:16:43.000",
      "formatted_end": "03:16:45.000",
      "text": "نشان قوصم نخواهد دکتران"
    },
    {
      "id": 31,
      "start": 11805.0,
      "end": 11807.0,
      "formatted_start": "03:16:45.000",
      "formatted_end": "03:16:47.000",
      "text": "بله"
    },
    {
      "id": 32,
      "start": 11819.0,
      "end": 11823.0,
      "formatted_start": "03:16:59.000",
      "formatted_end": "03:17:03.000",
      "text": "من همچنین گفتم برم دکتران اینجا که"
    },
    {
      "id": 33,
      "start": 11823.0,
      "end": 11824.0,
      "formatted_start": "03:17:03.000",
      "formatted_end": "03:17:04.000",
      "text": "صلاحات بشین"
    },
    {
      "id": 34,
      "start": 11824.0,
      "end": 11828.0,
      "formatted_start": "03:17:04.000",
      "formatted_end": "03:17:08.000",
      "text": "من خودم که لفتم اون موقعی گفتیم چرا لفت اینجا دیگه"
    },
    {
      "id": 35,
      "start": 11828.0,
      "end": 11830.0,
      "formatted_start": "03:17:08.000",
      "formatted_end": "03:17:10.000",
      "text": "خب نمیدونن آخون"
    },
    {
      "id": 36,
      "start": 11830.0,
      "end": 11832.0,
      "formatted_start": "03:17:10.000",
      "formatted_end": "03:17:12.000",
      "text": "درسته دارو حلکه بوده"
    },
    {
      "id": 37,
      "start": 11832.0,
      "end": 11833.0,
      "formatted_start": "03:17:12.000",
      "formatted_end": "03:17:13.000",
      "text": "بله"
    },
    {
      "id": 38,
      "start": 11833.0,
      "end": 11836.0,
      "formatted_start": "03:17:13.000",
      "formatted_end": "03:17:16.000",
      "text": "این دارو باید کمک کنید"
    },
    {
      "id": 39,
      "start": 11836.0,
      "end": 11839.0,
      "formatted_start": "03:17:16.000",
      "formatted_end": "03:17:19.000",
      "text": "کمک کنید دارو باید اینجا بیدیم"
    },
    {
      "id": 40,
      "start": 11839.0,
      "end": 11842.0,
      "formatted_start": "03:17:19.000",
      "formatted_end": "03:17:22.000",
      "text": "دو تا شربت هم دارید در گرونه گراندار"
    },
    {
      "id": 41,
      "start": 11842.0,
      "end": 11844.0,
      "formatted_start": "03:17:22.000",
      "formatted_end": "03:17:24.000",
      "text": "حالا مکه دنیا و اینا رو بیارین من یا؟"
    },
    {
      "id": 42,
      "start": 11844.0,
      "end": 11847.0,
      "formatted_start": "03:17:24.000",
      "formatted_end": "03:17:27.000",
      "text": "این شربت مال قغره اصلا و دکتر دادایی بوده"
    },
    {
      "id": 43,
      "start": 11847.0,
      "end": 11849.0,
      "formatted_start": "03:17:27.000",
      "formatted_end": "03:17:29.000",
      "text": "نه اون نه شربت دیگه"
    },
    {
      "id": 44,
      "start": 11849.0,
      "end": 11850.0,
      "formatted_start": "03:17:29.000",
      "formatted_end": "03:17:30.000",
      "text": "بله نه"
    },
    {
      "id": 45,
      "start": 11850.0,
      "end": 11851.0,
      "formatted_start": "03:17:30.000",
      "formatted_end": "03:17:31.000",
      "text": "از اون رو درسته بوده"
    },
    {
      "id": 46,
      "start": 11851.0,
      "end": 11852.0,
      "formatted_start": "03:17:31.000",
      "formatted_end": "03:17:32.000",
      "text": "حالا که کلم بذارید؟"
    },
    {
      "id": 47,
      "start": 11852.0,
      "end": 11855.0,
      "formatted_start": "03:17:32.000",
      "formatted_end": "03:17:35.000",
      "text": "حالا دکتر قطن فرید تهران"
    },
    {
      "id": 48,
      "start": 11855.0,
      "end": 11857.0,
      "formatted_start": "03:17:35.000",
      "formatted_end": "03:17:37.000",
      "text": "آزمایش نوشته داره"
    },
    {
      "id": 49,
      "start": 11857.0,
      "end": 11859.0,
      "formatted_start": "03:17:37.000",
      "formatted_end": "03:17:39.000",
      "text": "کود را درگیریش من را خواهد فراموش کردم"
    },
    {
      "id": 50,
      "start": 11859.0,
      "end": 11861.0,
      "formatted_start": "03:17:39.000",
      "formatted_end": "03:17:41.000",
      "text": "نه اونها اصلا نمیگیرند کودی ملی"
    },
    {
      "id": 51,
      "start": 11861.0,
      "end": 11863.0,
      "formatted_start": "03:17:41.000",
      "formatted_end": "03:17:43.000",
      "text": "ما میگیریم"
    },
    {
      "id": 52,
      "start": 11863.0,
      "end": 11865.0,
      "formatted_start": "03:17:43.000",
      "formatted_end": "03:17:45.000",
      "text": "اینم بگم درست کنیم"
    },
    {
      "id": 53,
      "start": 11865.0,
      "end": 11867.0,
      "formatted_start": "03:17:45.000",
      "formatted_end": "03:17:47.000",
      "text": "دست داریم کود را درگیریش"
    },
    {
      "id": 54,
      "start": 11867.0,
      "end": 11869.0,
      "formatted_start": "03:17:47.000",
      "formatted_end": "03:17:49.000",
      "text": "نه باید"
    },
    {
      "id": 55,
      "start": 11869.0,
      "end": 11871.0,
      "formatted_start": "03:17:49.000",
      "formatted_end": "03:17:51.000",
      "text": "وارد سیستم کنیم"
    },
    {
      "id": 56,
      "start": 11871.0,
      "end": 11873.0,
      "formatted_start": "03:17:51.000",
      "formatted_end": "03:17:53.000",
      "text": "کود را درگیریش کنیم"
    },
    {
      "id": 57,
      "start": 11873.0,
      "end": 11875.0,
      "formatted_start": "03:17:53.000",
      "formatted_end": "03:17:55.000",
      "text": "میمتون چیه؟"
    },
    {
      "id": 58,
      "start": 11875.0,
      "end": 11877.0,
      "formatted_start": "03:17:55.000",
      "formatted_end": "03:17:57.000",
      "text": "میمتون درگیریش کنم"
    },
    {
      "id": 59,
      "start": 11877.0,
      "end": 11879.0,
      "formatted_start": "03:17:57.000",
      "formatted_end": "03:17:59.000",
      "text": "کودی ملی تانو بگیر"
    },
    {
      "id": 60,
      "start": 11879.0,
      "end": 11881.0,
      "formatted_start": "03:17:59.000",
      "formatted_end": "03:18:01.000",
      "text": "های دوتران"
    },
    {
      "id": 61,
      "start": 11881.0,
      "end": 11887.5,
      "formatted_start": "03:18:01.000",
      "formatted_end": "03:18:07.500",
      "text": "نقطه خانه اون رو درده گرفته بنده خواهید"
    },
    {
      "id": 62,
      "start": 11887.5,
      "end": 11890.0,
      "formatted_start": "03:18:07.500",
      "formatted_end": "03:18:10.000",
      "text": "نه"
    },
    {
      "id": 63,
      "start": 11890.0,
      "end": 11892.7,
      "formatted_start": "03:18:10.000",
      "formatted_end": "03:18:12.700",
      "text": "الان میگم باید"
    },
    {
      "id": 64,
      "start": 11892.7,
      "end": 11894.94,
      "formatted_start": "03:18:12.700",
      "formatted_end": "03:18:14.940",
      "text": "دستگاه درده باشید"
    },
    {
      "id": 65,
      "start": 11894.94,
      "end": 11895.98,
      "formatted_start": "03:18:14.940",
      "formatted_end": "03:18:15.980",
      "text": "دستگاه درده باشید"
    },
    {
      "id": 66,
      "start": 11895.98,
      "end": 11897.22,
      "formatted_start": "03:18:15.980",
      "formatted_end": "03:18:17.220",
      "text": "شمایی دیگه همین کنید"
    },
    {
      "id": 67,
      "start": 11897.22,
      "end": 11899.82,
      "formatted_start": "03:18:17.220",
      "formatted_end": "03:18:19.820",
      "text": "های همین باشید"
    },
    {
      "id": 68,
      "start": 11899.82,
      "end": 11900.74,
      "formatted_start": "03:18:19.820",
      "formatted_end": "03:18:20.740",
      "text": "دستگاه درده باشید"
    },
    {
      "id": 69,
      "start": 11900.74,
      "end": 11901.92,
      "formatted_start": "03:18:20.740",
      "formatted_end": "03:18:21.920",
      "text": "خیلی من نهایی به تو است"
    },
    {
      "id": 70,
      "start": 11901.92,
      "end": 11905.34,
      "formatted_start": "03:18:21.920",
      "formatted_end": "03:18:25.340",
      "text": "خیلی مقعدن"
    },
    {
      "id": 71,
      "start": 11905.34,
      "end": 11907.52,
      "formatted_start": "03:18:25.340",
      "formatted_end": "03:18:27.520",
      "text": "خیلی مقعدن باشید"
    },
    {
      "id": 72,
      "start": 11907.52,
      "end": 11909.12,
      "formatted_start": "03:18:27.520",
      "formatted_end": "03:18:29.120",
      "text": "خیلی از نسخه خانه واسمی"
    },
    {
      "id": 73,
      "start": 11909.12,
      "end": 11913.12,
      "formatted_start": "03:18:29.120",
      "formatted_end": "03:18:33.120",
      "text": "آزمایشی که دستشون هستن کت نوشتن و براش کت ردگیری بگیرین"
    },
    {
      "id": 74,
      "start": 11913.12,
      "end": 11917.12,
      "formatted_start": "03:18:33.120",
      "formatted_end": "03:18:37.120",
      "text": "توی برگه دیگر"
    },
    {
      "id": 75,
      "start": 11917.12,
      "end": 11918.78,
      "formatted_start": "03:18:37.120",
      "formatted_end": "03:18:38.780",
      "text": "تو همون برگه هم میتونیم"
    },
    {
      "id": 76,
      "start": 11939.12,
      "end": 11959.12,
      "formatted_start": "03:18:59.120",
      "formatted_end": "03:19:19.120",
      "text": "موسیقی"
    },
    {
      "id": 77,
      "start": 11959.12,
      "end": 11989.1,
      "formatted_start": "03:19:19.120",
      "formatted_end": "03:19:49.100",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 78,
      "start": 11989.12,
      "end": 11999.12,
      "formatted_start": "03:19:49.120",
      "formatted_end": "03:19:59.120",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}