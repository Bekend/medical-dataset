  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12327.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:27.000",
      "text": "اول، یکدونه محلول نلا زدگاهی، نفر یکدونه شیشه رو کامل می بزنید از زیر چانه تا کف کار، همه جا مثل با اسمی رو خوشید، تمام بدن می زنید تو خونه دهما، دوازده ساعت روی بدن بمانید، لباس کسی بخوشید در توشش کار دارید، صبح بیرین همون و هر روز صبح هم بیرین همون شیشه."
    },
    {
      "id": 1,
      "start": 12327.0,
      "end": 12337.0,
      "formatted_start": "03:25:27.000",
      "formatted_end": "03:25:37.000",
      "text": "اول روز اول رفتیم، اول با سابون بوگردی میشوریم، مدت 5 دقیقه بمانی کفش، آرمی کشیم"
    },
    {
      "id": 2,
      "start": 12337.0,
      "end": 12347.0,
      "formatted_start": "03:25:37.000",
      "formatted_end": "03:25:47.000",
      "text": "بعد با شامپوی زده شفش سر و بدن رو میشوریم، پنج دقیقه سر می کنیم، میره زیر دوش، در می آید از همون"
    },
    {
      "id": 3,
      "start": 12347.0,
      "end": 12354.0,
      "formatted_start": "03:25:47.000",
      "formatted_end": "03:25:54.000",
      "text": "بوره قبلی نواید استفاده میشه، لباسهای قبلی نواید استفاده میشه، حتی یک دقیقه خوشیده باشه"
    },
    {
      "id": 4,
      "start": 12354.0,
      "end": 12359.28,
      "formatted_start": "03:25:54.000",
      "formatted_end": "03:25:59.280",
      "text": "هم بله با استفاده با پودر ماشین لباس شویه آن زیم دار شرسه شده باشه"
    },
    {
      "id": 5,
      "start": 12359.28,
      "end": 12363.06,
      "formatted_start": "03:25:59.280",
      "formatted_end": "03:26:03.060",
      "text": "هم لباس ها، هم ملافه"
    },
    {
      "id": 6,
      "start": 12363.06,
      "end": 12367.42,
      "formatted_start": "03:26:03.060",
      "formatted_end": "03:26:07.420",
      "text": "بعد یک درمونه میزنید تا فردا صبح دوباره میدید همون"
    },
    {
      "id": 7,
      "start": 12367.42,
      "end": 12372.06,
      "formatted_start": "03:26:07.420",
      "formatted_end": "03:26:12.060",
      "text": "باز اول سابون، بعد شامپون، پردون پشته"
    },
    {
      "id": 8,
      "start": 12372.06,
      "end": 12375.68,
      "formatted_start": "03:26:12.060",
      "formatted_end": "03:26:15.680",
      "text": "باز بله عوض بشه، لباس ها عوض بشن"
    },
    {
      "id": 9,
      "start": 12375.68,
      "end": 12380.1,
      "formatted_start": "03:26:15.680",
      "formatted_end": "03:26:20.100",
      "text": "باز پس فردا همه چطوری هر روز همون رفتن رو تکرار می کنید"
    },
    {
      "id": 10,
      "start": 12380.1,
      "end": 12382.64,
      "formatted_start": "03:26:20.100",
      "formatted_end": "03:26:22.640",
      "text": "تا شیش دفعه، شیش دفعه انجام کنید"
    },
    {
      "id": 11,
      "start": 12382.64,
      "end": 12412.64,
      "formatted_start": "03:26:22.640",
      "formatted_end": "03:26:52.640",
      "text": "برای اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 12,
      "start": 12412.64,
      "end": 12419.64,
      "formatted_start": "03:26:52.640",
      "formatted_end": "03:26:59.640",
      "text": "کسی گال نمیگن که برده گال و شکش ملادم های تمیزه"
    },
    {
      "id": 13,
      "start": 12419.64,
      "end": 12426.64,
      "formatted_start": "03:26:59.640",
      "formatted_end": "03:27:06.640",
      "text": "بر عکس تصور اون کسی که اصلا نمیگن که اما کسی که که دیگه هیچی روشنگ کنه"
    },
    {
      "id": 14,
      "start": 12426.64,
      "end": 12430.64,
      "formatted_start": "03:27:06.640",
      "formatted_end": "03:27:10.640",
      "text": "خب شما چون بار دارید نه دارید میخورید نه هیچی نیدونم"
    },
    {
      "id": 15,
      "start": 12430.64,
      "end": 12434.64,
      "formatted_start": "03:27:10.640",
      "formatted_end": "03:27:14.640",
      "text": "کمارده به اسم کالدولای سیزه"
    },
    {
      "id": 16,
      "start": 12434.64,
      "end": 12439.64,
      "formatted_start": "03:27:14.640",
      "formatted_end": "03:27:19.640",
      "text": "چون اینکه خیلی میخواده توی یک هفته اصلا درمون نمی کنه"
    },
    {
      "id": 17,
      "start": 12439.64,
      "end": 12469.64,
      "formatted_start": "03:27:19.640",
      "formatted_end": "03:27:49.640",
      "text": "خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودتون خودت"
    },
    {
      "id": 18,
      "start": 12469.64,
      "end": 12471.64,
      "formatted_start": "03:27:49.640",
      "formatted_end": "03:27:51.640",
      "text": "چند باشه؟"
    },
    {
      "id": 19,
      "start": 12471.64,
      "end": 12473.64,
      "formatted_start": "03:27:51.640",
      "formatted_end": "03:27:53.640",
      "text": "نه، بگرم نمیشه"
    },
    {
      "id": 20,
      "start": 12473.64,
      "end": 12475.64,
      "formatted_start": "03:27:53.640",
      "formatted_end": "03:27:55.640",
      "text": "این مسئله باشه"
    },
    {
      "id": 21,
      "start": 12475.64,
      "end": 12477.64,
      "formatted_start": "03:27:55.640",
      "formatted_end": "03:27:57.640",
      "text": "خب، بله"
    },
    {
      "id": 22,
      "start": 12477.64,
      "end": 12481.64,
      "formatted_start": "03:27:57.640",
      "formatted_end": "03:28:01.640",
      "text": "من این نسخه رو از شما شما رو بیده این تصویرشو براتون میخرستن"
    },
    {
      "id": 23,
      "start": 12481.64,
      "end": 12483.64,
      "formatted_start": "03:28:01.640",
      "formatted_end": "03:28:03.640",
      "text": "و اگه میخوایید گرگان بگیرید"
    },
    {
      "id": 24,
      "start": 12483.64,
      "end": 12485.64,
      "formatted_start": "03:28:03.640",
      "formatted_end": "03:28:05.640",
      "text": "اگه میخوایید اینجا بگیرید"
    },
    {
      "id": 25,
      "start": 12485.64,
      "end": 12487.64,
      "formatted_start": "03:28:05.640",
      "formatted_end": "03:28:07.640",
      "text": "یکی بیا دارن دارو"
    },
    {
      "id": 26,
      "start": 12487.64,
      "end": 12489.64,
      "formatted_start": "03:28:07.640",
      "formatted_end": "03:28:09.640",
      "text": "همینجا از ما بگیرید و نسخه رو بره دارو کنید"
    },
    {
      "id": 27,
      "start": 12489.64,
      "end": 12491.64,
      "formatted_start": "03:28:09.640",
      "formatted_end": "03:28:11.640",
      "text": "امسایی ما هستش"
    },
    {
      "id": 28,
      "start": 12491.64,
      "end": 12493.64,
      "formatted_start": "03:28:11.640",
      "formatted_end": "03:28:13.640",
      "text": "داره، میگیره براتون میخرست"
    },
    {
      "id": 29,
      "start": 12493.64,
      "end": 12503.64,
      "formatted_start": "03:28:13.640",
      "formatted_end": "03:28:23.640",
      "text": "آره سینا سینا همونجا داره داره چند درگوی سال هست"
    },
    {
      "id": 30,
      "start": 12503.64,
      "end": 12507.64,
      "formatted_start": "03:28:23.640",
      "formatted_end": "03:28:27.640",
      "text": "بسیار خوب خدا نگهدار دیگه با ماشه همه هنگ کاری دیگه برونشون"
    },
    {
      "id": 31,
      "start": 12507.64,
      "end": 12510.64,
      "formatted_start": "03:28:27.640",
      "formatted_end": "03:28:30.640",
      "text": "آره برونشون خدا نگهدار خدا نگهدار"
    },
    {
      "id": 32,
      "start": 12510.64,
      "end": 12512.64,
      "formatted_start": "03:28:30.640",
      "formatted_end": "03:28:32.640",
      "text": "چند"
    },
    {
      "id": 33,
      "start": 12512.64,
      "end": 12518.64,
      "formatted_start": "03:28:32.640",
      "formatted_end": "03:28:38.640",
      "text": "تانن هفته دیوار خوب بشه"
    },
    {
      "id": 34,
      "start": 12518.64,
      "end": 12521.64,
      "formatted_start": "03:28:38.640",
      "formatted_end": "03:28:41.640",
      "text": "یک هفته دو باید استفاده می کنیم"
    },
    {
      "id": 35,
      "start": 12521.64,
      "end": 12528.92,
      "formatted_start": "03:28:41.640",
      "formatted_end": "03:28:48.920",
      "text": "به شرطی که هر روز لباسا رو روز بکنید، هر روز گلر رو بشوید و پید رو ماشین لباس شوید، آن زین دار"
    },
    {
      "id": 36,
      "start": 12528.92,
      "end": 12531.88,
      "formatted_start": "03:28:48.920",
      "formatted_end": "03:28:51.880",
      "text": "خب، منافعه هم هفته یه بار روز بکنید، کافی"
    },
    {
      "id": 37,
      "start": 12534.92,
      "end": 12540.68,
      "formatted_start": "03:28:54.920",
      "formatted_end": "03:29:00.680",
      "text": "خانواده همسر، هیچ کس رفته آمد، ممنونه شما، برید نه اونا میاد، تا اینکه اونا درمان بشن"
    },
    {
      "id": 38,
      "start": 12540.68,
      "end": 12546.68,
      "formatted_start": "03:29:00.680",
      "formatted_end": "03:29:06.680",
      "text": "میدونم، خواهد درمان بشن، بردن، خب، باشید، من تلفون دیگه در جا برم، خدافض شد"
    },
    {
      "id": 39,
      "start": 12546.68,
      "end": 12548.68,
      "formatted_start": "03:29:06.680",
      "formatted_end": "03:29:08.680",
      "text": "جانم بفرمایی؟"
    },
    {
      "id": 40,
      "start": 12548.68,
      "end": 12550.68,
      "formatted_start": "03:29:08.680",
      "formatted_end": "03:29:10.680",
      "text": "زنم بفرمایی؟"
    },
    {
      "id": 41,
      "start": 12550.68,
      "end": 12552.68,
      "formatted_start": "03:29:10.680",
      "formatted_end": "03:29:12.680",
      "text": "خانم مقدر گوشی رو بردنید"
    },
    {
      "id": 42,
      "start": 12552.68,
      "end": 12554.68,
      "formatted_start": "03:29:12.680",
      "formatted_end": "03:29:14.680",
      "text": "خانم بارانیت بعدش رو بفرمایی؟"
    },
    {
      "id": 43,
      "start": 12554.68,
      "end": 12556.68,
      "formatted_start": "03:29:14.680",
      "formatted_end": "03:29:16.680",
      "text": "متشکرم بفرمایی؟"
    },
    {
      "id": 44,
      "start": 12556.68,
      "end": 12558.68,
      "formatted_start": "03:29:16.680",
      "formatted_end": "03:29:18.680",
      "text": "جان بفرمایی؟"
    },
    {
      "id": 45,
      "start": 12558.68,
      "end": 12560.68,
      "formatted_start": "03:29:18.680",
      "formatted_end": "03:29:20.680",
      "text": "کجا رو میخواستید بگیری شما؟"
    },
    {
