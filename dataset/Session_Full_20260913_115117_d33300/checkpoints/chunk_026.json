  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7830.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 7830.0,
      "end": 7833.44,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:33.440",
      "text": "این 3 تا 6 ماه دوره درمان داره"
    },
    {
      "id": 2,
      "start": 7833.44,
      "end": 7834.68,
      "formatted_start": "02:10:33.440",
      "formatted_end": "02:10:34.680",
      "text": "این درمان 4-5 ماهی؟"
    },
    {
      "id": 3,
      "start": 7834.68,
      "end": 7836.88,
      "formatted_start": "02:10:34.680",
      "formatted_end": "02:10:36.880",
      "text": "نه 4-5 ماه خود مریضیه"
    },
    {
      "id": 4,
      "start": 7836.88,
      "end": 7840.38,
      "formatted_start": "02:10:36.880",
      "formatted_end": "02:10:40.380",
      "text": "3 تا 6 ماه باید دوام اصرفت کنی"
    },
    {
      "id": 5,
      "start": 7840.38,
      "end": 7842.94,
      "formatted_start": "02:10:40.380",
      "formatted_end": "02:10:42.940",
      "text": "که دفعه آمدیم ره هم"
    },
    {
      "id": 6,
      "start": 7842.94,
      "end": 7845.2,
      "formatted_start": "02:10:42.940",
      "formatted_end": "02:10:45.200",
      "text": "حالا خواهید میگید یه ماه شاید دو ماه بیشتر آمدیم"
    },
    {
      "id": 7,
      "start": 7845.2,
      "end": 7847.4,
      "formatted_start": "02:10:45.200",
      "formatted_end": "02:10:47.400",
      "text": "ما معلوم بست تو زهنت داری درسته"
    },
    {
      "id": 8,
      "start": 7847.4,
      "end": 7850.3,
      "formatted_start": "02:10:47.400",
      "formatted_end": "02:10:50.300",
      "text": "فایده رفت در درمان الان شروع میکنم"
    },
    {
      "id": 9,
      "start": 7850.3,
      "end": 7853.9,
      "formatted_start": "02:10:50.300",
      "formatted_end": "02:10:53.900",
      "text": "برای هفته دیگه همین روز دوباره بشیم"
    },
    {
      "id": 10,
      "start": 7853.9,
      "end": 7856.3,
      "formatted_start": "02:10:53.900",
      "formatted_end": "02:10:56.300",
      "text": "چه خوب بشه چه بدتر بشه"
    },
    {
      "id": 11,
      "start": 7856.3,
      "end": 7860.3,
      "formatted_start": "02:10:56.300",
      "formatted_end": "02:11:00.300",
      "text": "اون خوب شدن علکیه اگه حالا خوب شده چه بهتر می آیید؟"
    },
    {
      "id": 12,
      "start": 7860.3,
      "end": 7861.3,
      "formatted_start": "02:11:00.300",
      "formatted_end": "02:11:01.300",
      "text": "درست داریم"
    },
    {
      "id": 13,
      "start": 7861.3,
      "end": 7864.3,
      "formatted_start": "02:11:01.300",
      "formatted_end": "02:11:04.300",
      "text": "اصلا ما نمیتونیم اون گوشت اضافی داریم"
    },
    {
      "id": 14,
      "start": 7864.3,
      "end": 7867.3,
      "formatted_start": "02:11:04.300",
      "formatted_end": "02:11:07.300",
      "text": "شما بیست دارشتر گوشت اضافی دارید اونجا"
    },
    {
      "id": 15,
      "start": 7867.3,
      "end": 7871.3,
      "formatted_start": "02:11:07.300",
      "formatted_end": "02:11:11.300",
      "text": "تو حلق خویت رو ببین، تا حلق ما ببین تو آینه"
    },
    {
      "id": 16,
      "start": 7871.3,
      "end": 7873.3,
      "formatted_start": "02:11:11.300",
      "formatted_end": "02:11:13.300",
      "text": "میگه آخون چرا قوه بندازی؟ میبین"
    },
    {
      "id": 17,
      "start": 7873.3,
      "end": 7875.3,
      "formatted_start": "02:11:13.300",
      "formatted_end": "02:11:15.300",
      "text": "من الان بهترشون میدم چی رو من میگم"
    },
    {
      "id": 18,
      "start": 7875.3,
      "end": 7878.3,
      "formatted_start": "02:11:15.300",
      "formatted_end": "02:11:18.300",
      "text": "تا در نیمیدونی من در مورد چیز رو برد می کنم"
    },
    {
      "id": 19,
      "start": 7878.3,
      "end": 7885.06,
      "formatted_start": "02:11:18.300",
      "formatted_end": "02:11:25.060",
      "text": "از این روزه که بندی میسوزه یعنی طلال همه نمیسوخته"
    },
    {
      "id": 20,
      "start": 7885.06,
      "end": 7887.06,
      "formatted_start": "02:11:25.060",
      "formatted_end": "02:11:27.060",
      "text": "نگهتون رو شده دید؟"
    },
    {
      "id": 21,
      "start": 7887.06,
      "end": 7888.46,
      "formatted_start": "02:11:27.060",
      "formatted_end": "02:11:28.460",
      "text": "با این یکی چرا؟"
    },
    {
      "id": 22,
      "start": 7888.46,
      "end": 7891.46,
      "formatted_start": "02:11:28.460",
      "formatted_end": "02:11:31.460",
      "text": "خوبه بنداز این رو توی قلبت ببینی هلا"
    },
    {
      "id": 23,
      "start": 7891.46,
      "end": 7893.46,
      "formatted_start": "02:11:31.460",
      "formatted_end": "02:11:33.460",
      "text": "دهن رو باز کن"
    },
    {
      "id": 24,
      "start": 7893.46,
      "end": 7896.3,
      "formatted_start": "02:11:33.460",
      "formatted_end": "02:11:36.300",
      "text": "ته هی ته سخت و اخبی"
    },
    {
      "id": 25,
      "start": 7896.3,
      "end": 7898.3,
      "formatted_start": "02:11:36.300",
      "formatted_end": "02:11:38.300",
      "text": "اون ته ته آبشار رو پشتی"
    },
    {
      "id": 26,
      "start": 7898.3,
      "end": 7900.3,
      "formatted_start": "02:11:38.300",
      "formatted_end": "02:11:40.300",
      "text": "تو آینه بنداز اون رو"
    },
    {
      "id": 27,
      "start": 7900.3,
      "end": 7902.3,
      "formatted_start": "02:11:40.300",
      "formatted_end": "02:11:42.300",
      "text": "تو آینه بنداز اون رو"
    },
    {
      "id": 28,
      "start": 7902.3,
      "end": 7904.3,
      "formatted_start": "02:11:42.300",
      "formatted_end": "02:11:44.300",
      "text": "حالا ببین؟ آه ببینی؟"
    },
    {
      "id": 29,
      "start": 7904.3,
      "end": 7907.3,
      "formatted_start": "02:11:44.300",
      "formatted_end": "02:11:47.300",
      "text": "ته هی ته چه خبره؟ پشتای اضافی رو دیدی؟"
    },
    {
      "id": 30,
      "start": 7907.3,
      "end": 7913.72,
      "formatted_start": "02:11:47.300",
      "formatted_end": "02:11:53.720",
      "text": "هر مورد 20 سال بیشتر از اون پشت یه دیواری هست رو این گشته اضافی گشته اضافی داریم"
    },
    {
      "id": 31,
      "start": 7913.72,
      "end": 7916.54,
      "formatted_start": "02:11:53.720",
      "formatted_end": "02:11:56.540",
      "text": "ما گشته اضافی صرفا روشونت نیست"
    },
    {
      "id": 32,
      "start": 7916.54,
      "end": 7923.16,
      "formatted_start": "02:11:56.540",
      "formatted_end": "02:12:03.160",
      "text": "این روشونت های تکراری کاشت سر همه قبلی به اضافه سیستم رمفاوی در این کارت رو اجابت کرد"
    },
    {
      "id": 33,
      "start": 7923.16,
      "end": 7926.0,
      "formatted_start": "02:12:03.160",
      "formatted_end": "02:12:06.000",
      "text": "3 تا 6 ماه در مارش نمیشه"
    },
    {
      "id": 34,
      "start": 7926.0,
      "end": 7931.64,
      "formatted_start": "02:12:06.000",
      "formatted_end": "02:12:11.640",
      "text": "اگر با شما توقع این رو نداشت که با یه هفته این گرده درگیز که یه چیز دیگه هست"
    },
    {
      "id": 35,
      "start": 7931.64,
      "end": 7934.88,
      "formatted_start": "02:12:11.640",
      "formatted_end": "02:12:14.880",
      "text": "خب، حالا درستش بکنیم، بعد احتیاج در اومدن داره"
    },
    {
      "id": 36,
      "start": 7934.88,
      "end": 7936.88,
      "formatted_start": "02:12:14.880",
      "formatted_end": "02:12:16.880",
      "text": "هیچ چیز دیگه گفته چجوری میشه؟"
    },
    {
      "id": 37,
      "start": 7936.88,
      "end": 7943.16,
      "formatted_start": "02:12:16.880",
      "formatted_end": "02:12:23.160",
      "text": "من الان دیشتر بگویم که به شدت میسوزه گل و مثلا توپا هم به زور گرد میشه"
    },
    {
      "id": 38,
      "start": 7943.16,
      "end": 7946.52,
      "formatted_start": "02:12:23.160",
      "formatted_end": "02:12:26.520",
      "text": "بعد خلط نمیدونی"
    },
    {
      "id": 39,
      "start": 7946.52,
      "end": 7950.46,
      "formatted_start": "02:12:26.520",
      "formatted_end": "02:12:30.460",
      "text": "خلطی من خارج نمیشه، یک سر هم خلط داره"
    },
    {
      "id": 40,
      "start": 7950.46,
      "end": 7952.98,
      "formatted_start": "02:12:30.460",
      "formatted_end": "02:12:32.980",
      "text": "خب ماما نگاه کن، ماما کجاست؟"
    },
    {
      "id": 41,
      "start": 7952.98,
      "end": 7954.98,
      "formatted_start": "02:12:32.980",
      "formatted_end": "02:12:34.980",
      "text": "خب، حالا آب درم گرد داره"
    },
    {
      "id": 42,
      "start": 7954.98,
      "end": 7956.4,
      "formatted_start": "02:12:34.980",
      "formatted_end": "02:12:36.400",
      "text": "دوباره"
    },
    {
      "id": 43,
      "start": 7956.4,
      "end": 7957.88,
      "formatted_start": "02:12:36.400",
      "formatted_end": "02:12:37.880",
      "text": "مثلا نمیره"
    },
    {
      "id": 44,
      "start": 7957.88,
      "end": 7959.88,
      "formatted_start": "02:12:37.880",
      "formatted_end": "02:12:39.880",
      "text": "دسته بسا"
    },
    {
      "id": 45,
      "start": 7959.88,
      "end": 7961.52,
      "formatted_start": "02:12:39.880",
      "formatted_end": "02:12:41.520",
      "text": "دسته بسا"
    },
    {
      "id": 46,
      "start": 7961.52,
      "end": 7965.52,
      "formatted_start": "02:12:41.520",
      "formatted_end": "02:12:45.520",
      "text": "اون دو ماه پیش اومده که کسی باید برداری نکنه"
    },
    {
      "id": 47,
      "start": 7965.52,
      "end": 7969.52,
      "formatted_start": "02:12:45.520",
      "formatted_end": "02:12:49.520",
      "text": "شما مثلا فکر کنید که توی مریضی باید برین دو گروه"
    },
    {
      "id": 48,
      "start": 7969.52,
      "end": 7971.52,
      "formatted_start": "02:12:49.520",
      "formatted_end": "02:12:51.520",
      "text": "نه این از سال من بود یه هفته دیگه نمی آیید"
    },
    {
      "id": 49,
      "start": 7971.52,
      "end": 7975.52,
      "formatted_start": "02:12:51.520",
      "formatted_end": "02:12:55.520",
      "text": "رسقات هم اصلا ندور برند و کنار نمی کنید"
    },
    {
      "id": 50,
      "start": 7975.52,
      "end": 7977.52,
      "formatted_start": "02:12:55.520",
      "formatted_end": "02:12:57.520",
      "text": "با خودت بیارو برخواست"
    },
    {
      "id": 51,
      "start": 7977.52,
      "end": 7979.52,
      "formatted_start": "02:12:57.520",
      "formatted_end": "02:12:59.520",
      "text": "چشت رسقات برند"
    },
    {
      "id": 52,
      "start": 7979.52,
      "end": 7983.52,
      "formatted_start": "02:12:59.520",
      "formatted_end": "02:13:03.520",
      "text": "تا این آرزه سیلوزی برند"
    },
    {
      "id": 53,
      "start": 7983.52,
      "end": 7987.52,
      "formatted_start": "02:13:03.520",
      "formatted_end": "02:13:07.520",
      "text": "کسی که این رسقات رو دیما بیترم پی این بیرون"
    },
    {
      "id": 54,
      "start": 7987.52,
      "end": 7993.52,
      "formatted_start": "02:13:07.520",
      "formatted_end": "02:13:13.520",
      "text": "بله یه قرسی توی اون قرس ها بود، خیلی وزن همون بالا"
    },
    {
      "id": 55,
      "start": 7993.52,
      "end": 7994.52,
      "formatted_start": "02:13:13.520",
      "formatted_end": "02:13:14.520",
      "text": "چی بوده؟"
    },
    {
      "id": 56,
      "start": 7994.52,
      "end": 7996.52,
      "formatted_start": "02:13:14.520",
      "formatted_end": "02:13:16.520",
      "text": "نیمونم چی بود، کوری"
    },
    {
      "id": 57,
      "start": 7996.52,
      "end": 7999.52,
      "formatted_start": "02:13:16.520",
      "formatted_end": "02:13:19.520",
      "text": "اتعالیه کردی فکر کردی وزن تا موردتون وزن همون، سوست بیرون"
    },
    {
      "id": 58,
      "start": 7999.52,
      "end": 8002.52,
      "formatted_start": "02:13:19.520",
      "formatted_end": "02:13:22.520",
      "text": "نه، از اون یه حقه خیلی اشتاق زیاد شده"
    },
    {
      "id": 59,
      "start": 8002.52,
      "end": 8005.52,
      "formatted_start": "02:13:22.520",
      "formatted_end": "02:13:25.520",
      "text": "اون باقو شده، رشد فحصیلی چیه؟"
    },
    {
      "id": 60,
      "start": 8005.52,
      "end": 8007.52,
      "formatted_start": "02:13:25.520",
      "formatted_end": "02:13:27.520",
      "text": "من تجربه بود"
    },
    {
      "id": 61,
      "start": 8007.52,
      "end": 8014.52,
      "formatted_start": "02:13:27.520",
      "formatted_end": "02:13:34.520",
      "text": "تصور خانومکترین چون یه فکر می بینید دارون، یه هفته دارون خوری و از اینکه دارون بوده"
    },
    {
      "id": 62,
      "start": 8014.52,
      "end": 8019.52,
      "formatted_start": "02:13:34.520",
      "formatted_end": "02:13:39.520",
      "text": "دارون خوری بوده، پس خدایی، یه دونه شکالت داری؟"
    },
    {
      "id": 63,
      "start": 8019.52,
      "end": 8021.52,
      "formatted_start": "02:13:39.520",
      "formatted_end": "02:13:41.520",
      "text": "شکالت هم دارون داری"
    },
    {
      "id": 64,
      "start": 8021.52,
      "end": 8023.52,
      "formatted_start": "02:13:41.520",
      "formatted_end": "02:13:43.520",
      "text": "آره، یه دونه کامتاکی می داری؟"
    },
    {
      "id": 65,
      "start": 8023.52,
      "end": 8025.52,
      "formatted_start": "02:13:43.520",
      "formatted_end": "02:13:45.520",
      "text": "شکالت کافر"
    },
    {
      "id": 66,
      "start": 8025.52,
      "end": 8027.52,
      "formatted_start": "02:13:45.520",
      "formatted_end": "02:13:47.520",
      "text": "آره، محصوصی گروه بوده"
    },
    {
      "id": 67,
      "start": 8027.52,
      "end": 8029.52,
      "formatted_start": "02:13:47.520",
      "formatted_end": "02:13:49.520",
      "text": "نه، دیدم دیگه، واسه پیسرم دارو دید"
    },
    {
      "id": 68,
      "start": 8029.52,
      "end": 8035.52,
      "formatted_start": "02:13:49.520",
      "formatted_end": "02:13:55.520",
      "text": "از این استاروان از اون پردیاد شدن مسته اول این رو مصاید شده"
    },
    {
      "id": 69,
      "start": 8035.52,
      "end": 8039.52,
      "formatted_start": "02:13:55.520",
      "formatted_end": "02:13:59.520",
      "text": "خب نمیشه یه چی باشه این وضعیتی که اون سر خیلی ازیاد داره"
    },
    {
      "id": 70,
      "start": 8039.52,
      "end": 8043.52,
      "formatted_start": "02:13:59.520",
      "formatted_end": "02:14:03.520",
      "text": "همین هست، من باید با دو تا ریسپوره بینیم"
    },
    {
      "id": 71,
      "start": 8043.52,
      "end": 8044.52,
      "formatted_start": "02:14:03.520",
      "formatted_end": "02:14:04.520",
      "text": "نه"
    },
    {
      "id": 72,
      "start": 8044.52,
      "end": 8050.52,
      "formatted_start": "02:14:04.520",
      "formatted_end": "02:14:10.520",
      "text": "بچه ها این هم، چی هست، بینیم، چی نمیاد، کسی بینیم، نمیاد"
    },
    {
      "id": 73,
      "start": 8050.52,
      "end": 8051.52,
      "formatted_start": "02:14:10.520",
      "formatted_end": "02:14:11.520",
      "text": "نیاد، خیلی چرد نیاد"
    },
    {
      "id": 74,
      "start": 8051.52,
      "end": 8054.52,
      "formatted_start": "02:14:11.520",
      "formatted_end": "02:14:14.520",
      "text": "گیره، گیره، باز بشه نشنگ میاد داره"
    },
    {
      "id": 75,
      "start": 8054.52,
      "end": 8055.52,
      "formatted_start": "02:14:14.520",
      "formatted_end": "02:14:15.520",
      "text": "نه"
    },
    {
      "id": 76,
      "start": 8055.52,
      "end": 8058.52,
      "formatted_start": "02:14:15.520",
      "formatted_end": "02:14:18.520",
      "text": "واقعی مریضی چی اسمش؟"
    },
    {
      "id": 77,
      "start": 8058.52,
      "end": 8060.52,
      "formatted_start": "02:14:18.520",
      "formatted_end": "02:14:20.520",
      "text": "اسمش پیندی"
    },
    {
      "id": 78,
      "start": 8060.52,
      "end": 8062.52,
      "formatted_start": "02:14:20.520",
      "formatted_end": "02:14:22.520",
      "text": "اسمش پیندی پشت میشه"
    },
    {
      "id": 79,
      "start": 8062.52,
      "end": 8064.52,
      "formatted_start": "02:14:22.520",
      "formatted_end": "02:14:24.520",
      "text": "نمیادون پیندی"
    },
    {
      "id": 80,
      "start": 8064.52,
      "end": 8066.52,
      "formatted_start": "02:14:24.520",
      "formatted_end": "02:14:26.520",
      "text": "جان؟"
    },
    {
      "id": 81,
      "start": 8066.52,
      "end": 8068.52,
      "formatted_start": "02:14:26.520",
      "formatted_end": "02:14:28.520",
      "text": "من میگم شاید او خوند کردیم"
    },
    {
      "id": 82,
      "start": 8068.52,
      "end": 8070.52,
      "formatted_start": "02:14:28.520",
      "formatted_end": "02:14:30.520",
      "text": "از سینوسیده"
    },
    {
      "id": 83,
      "start": 8070.52,
      "end": 8072.52,
      "formatted_start": "02:14:30.520",
      "formatted_end": "02:14:32.520",
      "text": "نوعی سینوسیده"
    },
    {
      "id": 84,
      "start": 8076.52,
      "end": 8078.52,
      "formatted_start": "02:14:36.520",
      "formatted_end": "02:14:38.520",
      "text": "صورت هم یه حالتی"
    },
    {
      "id": 85,
      "start": 8078.52,
      "end": 8080.52,
      "formatted_start": "02:14:38.520",
      "formatted_end": "02:14:40.520",
      "text": "با پشت چشم هم چرکه"
    },
    {
      "id": 86,
      "start": 8080.52,
      "end": 8082.52,
      "formatted_start": "02:14:40.520",
      "formatted_end": "02:14:42.520",
      "text": "از صورت هم چرکه"
    },
    {
      "id": 87,
      "start": 8082.52,
      "end": 8084.52,
      "formatted_start": "02:14:42.520",
      "formatted_end": "02:14:44.520",
      "text": "نگهار نمیشه"
    },
    {
      "id": 88,
      "start": 8084.52,
      "end": 8086.52,
      "formatted_start": "02:14:44.520",
      "formatted_end": "02:14:46.520",
      "text": "بسته می کنی یه چیزهای جزگی نه"
    },
    {
      "id": 89,
      "start": 8086.52,
      "end": 8088.52,
      "formatted_start": "02:14:46.520",
      "formatted_end": "02:14:48.520",
      "text": "هفته دیگه شنبه"
    },
    {
      "id": 90,
      "start": 8088.52,
      "end": 8090.52,
      "formatted_start": "02:14:48.520",
      "formatted_end": "02:14:50.520",
      "text": "هفته"
    },
    {
      "id": 91,
      "start": 8090.52,
      "end": 8092.52,
      "formatted_start": "02:14:50.520",
      "formatted_end": "02:14:52.520",
      "text": "باید جان دکتور بگیر"
    },
    {
      "id": 92,
      "start": 8092.52,
      "end": 8094.52,
      "formatted_start": "02:14:52.520",
      "formatted_end": "02:14:54.520",
      "text": "توچین نگذرد"
    },
    {
      "id": 93,
      "start": 8094.52,
      "end": 8096.52,
      "formatted_start": "02:14:54.520",
      "formatted_end": "02:14:56.520",
      "text": "نه نگذرد"
    },
    {
      "id": 94,
      "start": 8096.52,
      "end": 8098.52,
      "formatted_start": "02:14:56.520",
      "formatted_end": "02:14:58.520",
      "text": "جست نگذرد"
    },
    {
      "id": 95,
      "start": 8098.52,
      "end": 8100.52,
      "formatted_start": "02:14:58.520",
      "formatted_end": "02:15:00.520",
      "text": "جست رو نگذرد"
    }
  ],
  "status": "completed"
}