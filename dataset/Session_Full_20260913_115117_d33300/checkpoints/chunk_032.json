  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9614.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:14.000",
      "text": "تا یک هفته، این برداشت رو یک ماه تقریباً در مورد باید انجام بدید، اوایه سه چهار روز اول روز سه بار، سه چهار روز دوم، روزی دو بار، بعد روزی یک بارشو صبح از خواب بیدار شوید، تا یک ماه باید داشته شید."
    },
    {
      "id": 1,
      "start": 9614.0,
      "end": 9616.0,
      "formatted_start": "02:40:14.000",
      "formatted_end": "02:40:16.000",
      "text": "یعنی افترالا روزی سه بار، درسته؟"
    },
    {
      "id": 2,
      "start": 9616.0,
      "end": 9646.0,
      "formatted_start": "02:40:16.000",
      "formatted_end": "02:40:46.000",
      "text": "درست داریم برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را برای این کار را"
    },
    {
      "id": 3,
      "start": 9646.0,
      "end": 9650.96,
      "formatted_start": "02:40:46.000",
      "formatted_end": "02:40:50.960",
      "text": "خب اگر این رو نمیدونم از ضمن این کار برمیگردن بید"
    },
    {
      "id": 4,
      "start": 9650.96,
      "end": 9653.06,
      "formatted_start": "02:40:50.960",
      "formatted_end": "02:40:53.060",
      "text": "مرد بزندم خیلی که چیزی کن"
    },
    {
      "id": 5,
      "start": 9653.06,
      "end": 9655.06,
      "formatted_start": "02:40:53.060",
      "formatted_end": "02:40:55.060",
      "text": "این ها فقط شب"
    },
    {
      "id": 6,
      "start": 9655.06,
      "end": 9657.06,
      "formatted_start": "02:40:55.060",
      "formatted_end": "02:40:57.060",
      "text": "این نهار و شامه"
    },
    {
      "id": 7,
      "start": 9657.06,
      "end": 9661.56,
      "formatted_start": "02:40:57.060",
      "formatted_end": "02:41:01.560",
      "text": "خب ولی الان یه دن خورید دیگه امروز که حاضره میخوری شب"
    },
    {
      "id": 8,
      "start": 9661.56,
      "end": 9665.5,
      "formatted_start": "02:41:01.560",
      "formatted_end": "02:41:05.500",
      "text": "از فردا هم نصف زهر یک دار شب"
    },
    {
      "id": 9,
      "start": 9665.5,
      "end": 9671.38,
      "formatted_start": "02:41:05.500",
      "formatted_end": "02:41:11.380",
      "text": "این نصف زهر از فردا زهر یک دن خب شب یک درده"
    },
    {
      "id": 10,
      "start": 9671.38,
      "end": 9673.84,
      "formatted_start": "02:41:11.380",
      "formatted_end": "02:41:13.840",
      "text": "خب؟ درسته؟ خب"
    },
    {
      "id": 11,
      "start": 9673.84,
      "end": 9676.9,
      "formatted_start": "02:41:13.840",
      "formatted_end": "02:41:16.900",
      "text": "این زهر نداره و خوابم میاره این"
    },
    {
      "id": 12,
      "start": 9676.9,
      "end": 9677.5,
      "formatted_start": "02:41:16.900",
      "formatted_end": "02:41:17.500",
      "text": "شاید"
    },
    {
      "id": 13,
      "start": 9677.5,
      "end": 9678.1,
      "formatted_start": "02:41:17.500",
      "formatted_end": "02:41:18.100",
      "text": "شاید"
    },
    {
      "id": 14,
      "start": 9678.1,
      "end": 9682.0,
      "formatted_start": "02:41:18.100",
      "formatted_end": "02:41:22.000",
      "text": "بتای سیدینی که دکتر قبلی بهت داده بود"
    },
    {
      "id": 15,
      "start": 9682.0,
      "end": 9684.02,
      "formatted_start": "02:41:22.000",
      "formatted_end": "02:41:24.020",
      "text": "صورتی بود بتای سیدینی"
    },
    {
      "id": 16,
      "start": 9684.02,
      "end": 9684.6,
      "formatted_start": "02:41:24.020",
      "formatted_end": "02:41:24.600",
      "text": "برای برای"
    },
    {
      "id": 17,
      "start": 9684.6,
      "end": 9685.74,
      "formatted_start": "02:41:24.600",
      "formatted_end": "02:41:25.740",
      "text": "یه بخورم بذارم جزبینی"
    },
    {
      "id": 18,
      "start": 9685.74,
      "end": 9686.76,
      "formatted_start": "02:41:25.740",
      "formatted_end": "02:41:26.760",
      "text": "برای بخورم بذارم"
    },
    {
      "id": 19,
      "start": 9686.76,
      "end": 9688.36,
      "formatted_start": "02:41:26.760",
      "formatted_end": "02:41:28.360",
      "text": "اونو پرده بودی"
    },
    {
      "id": 20,
      "start": 9688.36,
      "end": 9689.0,
      "formatted_start": "02:41:28.360",
      "formatted_end": "02:41:29.000",
      "text": "الان پرده"
    },
    {
      "id": 21,
      "start": 9689.0,
      "end": 9689.5,
      "formatted_start": "02:41:29.000",
      "formatted_end": "02:41:29.500",
      "text": "نه نه"
    },
    {
      "id": 22,
      "start": 9689.5,
      "end": 9691.24,
      "formatted_start": "02:41:29.500",
      "formatted_end": "02:41:31.240",
      "text": "نه پرده"
    },
    {
      "id": 23,
      "start": 9691.24,
      "end": 9691.9,
      "formatted_start": "02:41:31.240",
      "formatted_end": "02:41:31.900",
      "text": "نه پرده"
    },
    {
      "id": 24,
      "start": 9691.9,
      "end": 9693.24,
      "formatted_start": "02:41:31.900",
      "formatted_end": "02:41:33.240",
      "text": "هفتش بسه دارم"
    },
    {
      "id": 25,
      "start": 9693.24,
      "end": 9694.04,
      "formatted_start": "02:41:33.240",
      "formatted_end": "02:41:34.040",
      "text": "داری"
    },
    {
      "id": 26,
      "start": 9694.04,
      "end": 9695.96,
      "formatted_start": "02:41:34.040",
      "formatted_end": "02:41:35.960",
      "text": "اینو بذار تو دوای من باشه"
    },
    {
      "id": 27,
      "start": 9695.96,
      "end": 9696.56,
      "formatted_start": "02:41:35.960",
      "formatted_end": "02:41:36.560",
      "text": "کلش"
    },
    {
      "id": 28,
      "start": 9696.56,
      "end": 9699.02,
      "formatted_start": "02:41:36.560",
      "formatted_end": "02:41:39.020",
      "text": "یه دونه برسو جوشنه که"
    },
    {
      "id": 29,
      "start": 9699.02,
      "end": 9699.94,
      "formatted_start": "02:41:39.020",
      "formatted_end": "02:41:39.940",
      "text": "الان لفت خواهیم"
    },
    {
      "id": 30,
      "start": 9699.94,
      "end": 9707.94,
      "formatted_start": "02:41:39.940",
      "formatted_end": "02:41:47.940",
      "text": "پس روی دیسته مرحله، هفته ی اول، صبح، زور، شب، نیه حرکتان انجام برن؟"
    },
    {
      "id": 31,
      "start": 9707.94,
      "end": 9716.94,
      "formatted_start": "02:41:47.940",
      "formatted_end": "02:41:56.940",
      "text": "نه، نیست، افراد نرم، از همون باز، سه بار، از قلمان خوب شده"
    },
    {
      "id": 32,
      "start": 9716.94,
      "end": 9727.94,
      "formatted_start": "02:41:56.940",
      "formatted_end": "02:42:07.940",
      "text": "پس گفتیم، برای مثلا زنگون چون حالت سنگاخ نیل برد، ترک بشیم، بهترونه هم، این نرم، فردا نرم"
    },
    {
      "id": 33,
      "start": 9727.94,
      "end": 9729.94,
      "formatted_start": "02:42:07.940",
      "formatted_end": "02:42:09.940",
      "text": "از پس فردا میتونی بیری"
    },
    {
      "id": 34,
      "start": 9729.94,
      "end": 9733.94,
      "formatted_start": "02:42:09.940",
      "formatted_end": "02:42:13.940",
      "text": "پس فردا یه سه روز از این ورزش ما گذشت و گم هم میجونی"
    },
    {
      "id": 35,
      "start": 9733.94,
      "end": 9734.94,
      "formatted_start": "02:42:13.940",
      "formatted_end": "02:42:14.940",
      "text": "هر وقت"
    },
    {
      "id": 36,
      "start": 9734.94,
      "end": 9735.94,
      "formatted_start": "02:42:14.940",
      "formatted_end": "02:42:15.940",
      "text": "بس درزا"
    },
    {
      "id": 37,
      "start": 9735.94,
      "end": 9736.94,
      "formatted_start": "02:42:15.940",
      "formatted_end": "02:42:16.940",
      "text": "بلد بلد"
    },
    {
      "id": 38,
      "start": 9736.94,
      "end": 9739.94,
      "formatted_start": "02:42:16.940",
      "formatted_end": "02:42:19.940",
      "text": "مشکلی بود بیا بیرون چشم"
    },
    {
      "id": 39,
      "start": 9739.94,
      "end": 9740.94,
      "formatted_start": "02:42:19.940",
      "formatted_end": "02:42:20.940",
      "text": "بلد بلد"
    },
    {
      "id": 40,
      "start": 9740.94,
      "end": 9742.94,
      "formatted_start": "02:42:20.940",
      "formatted_end": "02:42:22.940",
      "text": "من این ستاشکم پنیا باد بود"
    },
    {
      "id": 41,
      "start": 9742.94,
      "end": 9744.94,
      "formatted_start": "02:42:22.940",
      "formatted_end": "02:42:24.940",
      "text": "رفت و چرخ فلک سما شده بود"
    },
    {
      "id": 42,
      "start": 9744.94,
      "end": 9746.94,
      "formatted_start": "02:42:24.940",
      "formatted_end": "02:42:26.940",
      "text": "دوباره سرش ایجده بود"
    },
    {
      "id": 43,
      "start": 9746.94,
      "end": 9748.94,
      "formatted_start": "02:42:26.940",
      "formatted_end": "02:42:28.940",
      "text": "آمد دوباره جنگ داده بود پول هم نگهده"
    },
    {
      "id": 44,
      "start": 9748.94,
      "end": 9750.94,
      "formatted_start": "02:42:28.940",
      "formatted_end": "02:42:30.940",
      "text": "ولی کم میشه بره"
    },
    {
      "id": 45,
      "start": 9750.94,
      "end": 9752.94,
      "formatted_start": "02:42:30.940",
      "formatted_end": "02:42:32.940",
      "text": "اکثران جامعه نزدیک بیرون تمام شده بود"
    },
    {
      "id": 46,
      "start": 9752.94,
      "end": 9759.94,
      "formatted_start": "02:42:32.940",
      "formatted_end": "02:42:39.940",
      "text": "اون چهار تا خوراکی را گفتم نخورید. کشک و خامو لبنیان کن. آجید کن. روغن کن."
    },
    {
      "id": 47,
      "start": 9759.94,
      "end": 9764.94,
      "formatted_start": "02:42:39.940",
      "formatted_end": "02:42:44.940",
      "text": "خور بروید. ایشالله همیشه خوب باشید. شما خوب باشید. خدا باشید."
    },
    {
      "id": 48,
      "start": 9764.94,
      "end": 9767.94,
      "formatted_start": "02:42:44.940",
      "formatted_end": "02:42:47.940",
      "text": "خیلی خوال مادم درست کنید."
    },
    {
      "id": 49,
      "start": 9767.94,
      "end": 9769.94,
      "formatted_start": "02:42:47.940",
      "formatted_end": "02:42:49.940",
      "text": "بس چونم."
    },
    {
      "id": 50,
      "start": 9769.94,
      "end": 9771.94,
      "formatted_start": "02:42:49.940",
      "formatted_end": "02:42:51.940",
      "text": "بس سلامت. سلامت باشید."
    },
    {
      "id": 51,
      "start": 9771.94,
      "end": 9801.94,
      "formatted_start": "02:42:51.940",
      "formatted_end": "02:43:21.940",
      "text": "مرحبا با اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برا"
    },
    {
      "id": 52,
      "start": 9801.94,
      "end": 9803.94,
      "formatted_start": "02:43:21.940",
      "formatted_end": "02:43:23.940",
      "text": "از خونه"
    },
    {
      "id": 53,
      "start": 9803.94,
      "end": 9805.94,
      "formatted_start": "02:43:23.940",
      "formatted_end": "02:43:25.940",
      "text": "چون یه چیزی رو نیخونی در می آرده"
    },
    {
      "id": 54,
      "start": 9805.94,
      "end": 9807.94,
      "formatted_start": "02:43:25.940",
      "formatted_end": "02:43:27.940",
      "text": "نه، اونو که من خیلی برگاه لفت هستم"
    },
    {
      "id": 55,
      "start": 9807.94,
      "end": 9809.94,
      "formatted_start": "02:43:27.940",
      "formatted_end": "02:43:29.940",
      "text": "اونو نیخونی نیزه"
    },
    {
      "id": 56,
      "start": 9809.94,
      "end": 9811.94,
      "formatted_start": "02:43:29.940",
      "formatted_end": "02:43:31.940",
      "text": "اونو که نیزه"
    },
    {
      "id": 57,
      "start": 9811.94,
      "end": 9813.94,
      "formatted_start": "02:43:31.940",
      "formatted_end": "02:43:33.940",
      "text": "نه، اونو که نیزه"
    },
    {
      "id": 58,
      "start": 9813.94,
      "end": 9815.94,
      "formatted_start": "02:43:33.940",
      "formatted_end": "02:43:35.940",
      "text": "نه، اونو که نیزه"
    },
    {
      "id": 59,
      "start": 9815.94,
      "end": 9817.94,
      "formatted_start": "02:43:35.940",
      "formatted_end": "02:43:37.940",
      "text": "نه، اونو که نیزه"
    },
    {
      "id": 60,
      "start": 9817.94,
      "end": 9819.94,
      "formatted_start": "02:43:37.940",
      "formatted_end": "02:43:39.940",
      "text": "نه، اونو که نیزه"
    },
    {
      "id": 61,
      "start": 9819.94,
      "end": 9821.94,
      "formatted_start": "02:43:39.940",
      "formatted_end": "02:43:41.940",
      "text": "نه، اونو که نیزه"
    },
    {
      "id": 62,
      "start": 9821.94,
      "end": 9823.94,
      "formatted_start": "02:43:41.940",
      "formatted_end": "02:43:43.940",
      "text": "درسته، اونو پرد از ورود رو متوجه داری"
    },
    {
      "id": 63,
      "start": 9823.94,
      "end": 9825.94,
      "formatted_start": "02:43:43.940",
      "formatted_end": "02:43:45.940",
      "text": "تو 24 ساعت قبل از خون"
    },
    {
      "id": 64,
      "start": 9825.94,
      "end": 9827.94,
      "formatted_start": "02:43:45.940",
      "formatted_end": "02:43:47.940",
      "text": "یه چیزی کردی مثل"
    },
    {
      "id": 65,
      "start": 9827.94,
      "end": 9829.94,
      "formatted_start": "02:43:47.940",
      "formatted_end": "02:43:49.940",
      "text": "سالات هلویه بوده"
    },
    {
      "id": 66,
      "start": 9829.94,
      "end": 9831.94,
      "formatted_start": "02:43:49.940",
      "formatted_end": "02:43:51.940",
      "text": "هیچ خضایی نخورده بشه"
    },
    {
      "id": 67,
      "start": 9831.94,
      "end": 9833.94,
      "formatted_start": "02:43:51.940",
      "formatted_end": "02:43:53.940",
      "text": "نقل ها ماست محلی خورده"
    },
    {
      "id": 68,
      "start": 9833.94,
      "end": 9837.94,
      "formatted_start": "02:43:53.940",
      "formatted_end": "02:43:57.940",
      "text": "ماست محلی خود ماست محلی با سوس و ماهلز ده برابره چیزه"
    },
    {
      "id": 69,
      "start": 9837.94,
      "end": 9841.94,
      "formatted_start": "02:43:57.940",
      "formatted_end": "02:44:01.940",
      "text": "ماست محلی خوردی تونی میدونی اون گاهی که ماست رو داشت بروز کرده"
    },
    {
      "id": 70,
      "start": 9841.94,
      "end": 9843.94,
      "formatted_start": "02:44:01.940",
      "formatted_end": "02:44:03.940",
      "text": "چه علقی خورده بود نیست که باعث اساسی هست"
    },
    {
      "id": 71,
      "start": 9843.94,
      "end": 9845.94,
      "formatted_start": "02:44:03.940",
      "formatted_end": "02:44:05.940",
      "text": "ماست بیرونی بشنه بکنه"
    },
    {
      "id": 72,
      "start": 9845.94,
      "end": 9847.94,
      "formatted_start": "02:44:05.940",
      "formatted_end": "02:44:07.940",
      "text": "ماست های بیرونی هم همینجوره"
    },
    {
      "id": 73,
      "start": 9847.94,
      "end": 9849.94,
      "formatted_start": "02:44:07.940",
      "formatted_end": "02:44:09.940",
      "text": "ماست هایی که فقط میتونی بکنه"
    },
    {
      "id": 74,
      "start": 9849.94,
      "end": 9851.94,
      "formatted_start": "02:44:09.940",
      "formatted_end": "02:44:11.940",
      "text": "ماست خودش آلرژیزه هستش"
    },
    {
      "id": 75,
      "start": 9851.94,
      "end": 9859.94,
      "formatted_start": "02:44:11.940",
      "formatted_end": "02:44:19.940",
      "text": "از این ازا هستش. شیری هست به نام شیر سویا. اگه از ماست شیر سویا مصرف کنی میشی؟"
    },
    {
      "id": 76,
      "start": 9859.94,
      "end": 9868.94,
      "formatted_start": "02:44:19.940",
      "formatted_end": "02:44:28.940",
      "text": "اینجا نیست. توی احرام هست. اسمش یاده که خواهده شیریه. یه بار برم درشتم توی وقتی."
    },
    {
      "id": 77,
      "start": 9868.94,
      "end": 9873.94,
      "formatted_start": "02:44:28.940",
      "formatted_end": "02:44:33.940",
      "text": "نه، من اینجا نمیدونم. یه بار اون عشق آرهیجی رو برم در یه افتتاح."
    },
    {
      "id": 78,
      "start": 9873.94,
      "end": 9880.08,
      "formatted_start": "02:44:33.940",
      "formatted_end": "02:44:40.080",
      "text": "اینه، بعد کسی که این کار رو انجام دادن، خورد رو تنیز کنند، اسمش کلینیک..."
    },
    {
      "id": 79,
      "start": 9882.26,
      "end": 9885.04,
      "formatted_start": "02:44:42.260",
      "formatted_end": "02:44:45.040",
      "text": "...الرژی تهران."
    },
    {
      "id": 80,
      "start": 9885.46,
      "end": 9892.18,
      "formatted_start": "02:44:45.460",
      "formatted_end": "02:44:52.180",
      "text": "همینو سرچ کن، بعد صبح ساعت هفته اونده، شب ساعت شش میاد بیرون، خیلی تون می کشه."
    },
    {
      "id": 81,
      "start": 9892.18,
      "end": 9900.0,
      "formatted_start": "02:44:52.180",
      "formatted_end": "02:45:00.000",
      "text": "آزباشات مختلف انجام می دهند، معلوم می شه شما به کی هست داسید، واکسرشو برس می کنند، تو فلاکس می دهند به شما."
    }
  ],
  "status": "completed"
}