      "text": "نمیبینم."
    },
    {
      "id": 2,
      "start": 14106.0,
      "end": 14108.0,
      "formatted_start": "03:55:06.000",
      "formatted_end": "03:55:08.000",
      "text": "آرفا چقدر دارنو؟"
    },
    {
      "id": 3,
      "start": 14110.0,
      "end": 14116.0,
      "formatted_start": "03:55:10.000",
      "formatted_end": "03:55:16.000",
      "text": "ولی خب این چیزی که از ما سابرون بچه هم برفتن، شوستاشو بگذارم که."
    },
    {
      "id": 4,
      "start": 14118.0,
      "end": 14120.0,
      "formatted_start": "03:55:18.000",
      "formatted_end": "03:55:20.000",
      "text": "اونوز دو بار کما را فارم میدونن."
    },
    {
      "id": 5,
      "start": 14120.0,
      "end": 14122.0,
      "formatted_start": "03:55:20.000",
      "formatted_end": "03:55:22.000",
      "text": "نه نه."
    },
    {
      "id": 6,
      "start": 14122.0,
      "end": 14124.0,
      "formatted_start": "03:55:22.000",
      "formatted_end": "03:55:24.000",
      "text": "دیگه دیگه دارن از این کاملا."
    },
    {
      "id": 7,
      "start": 14124.0,
      "end": 14126.0,
      "formatted_start": "03:55:24.000",
      "formatted_end": "03:55:26.000",
      "text": "خب، مردم."
    },
    {
      "id": 8,
      "start": 14126.0,
      "end": 14134.0,
      "formatted_start": "03:55:26.000",
      "formatted_end": "03:55:34.000",
      "text": "حالیت قامل فرماده دیگه، اینها رو با هم مخلوط کنید."
    },
    {
      "id": 9,
      "start": 14134.0,
      "end": 14138.0,
      "formatted_start": "03:55:34.000",
      "formatted_end": "03:55:38.000",
      "text": "الفات رو جدا بزن بزن، اینها رو بگم بخلوط کنید."
    },
    {
      "id": 10,
      "start": 14138.0,
      "end": 14140.0,
      "formatted_start": "03:55:38.000",
      "formatted_end": "03:55:40.000",
      "text": "اینها خواهد جدا بزن."
    },
    {
      "id": 11,
      "start": 14140.0,
      "end": 14146.0,
      "formatted_start": "03:55:40.000",
      "formatted_end": "03:55:46.000",
      "text": "الفا رو با این فرماده ها، یه دونه فرماده ها درست کردنیه،"
    },
    {
      "id": 12,
      "start": 14146.0,
      "end": 14150.0,
      "formatted_start": "03:55:46.000",
      "formatted_end": "03:55:50.000",
      "text": "یه ذره از این بیزنیم، الفا رو بیزنیم، ببخش اول الفا رو بیزنیم،"
    },
    {
      "id": 13,
      "start": 14150.0,
      "end": 14153.0,
      "formatted_start": "03:55:50.000",
      "formatted_end": "03:55:53.000",
      "text": "اول هفته از آرفاره میزنیم و بعد یک در از این پومات روش میزنیم"
    },
    {
      "id": 14,
      "start": 14153.0,
      "end": 14156.0,
      "formatted_start": "03:55:53.000",
      "formatted_end": "03:55:56.000",
      "text": "هم رنگش رو درست کنیم زردش رو درست کنیم"
    },
    {
      "id": 15,
      "start": 14156.0,
      "end": 14159.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:55:59.000",
      "text": "یک هفته که زدی اونجا شمبه است"
    },
    {
      "id": 16,
      "start": 14159.0,
      "end": 14162.0,
      "formatted_start": "03:55:59.000",
      "formatted_end": "03:56:02.000",
      "text": "پاک هفته دیگه شمبه بیا"
    },
    {
      "id": 17,
      "start": 14162.0,
      "end": 14165.0,
      "formatted_start": "03:56:02.000",
      "formatted_end": "03:56:05.000",
      "text": "امروز یک عکس نیست درسته؟ درست؟"
    },
    {
      "id": 18,
      "start": 14165.0,
      "end": 14168.0,
      "formatted_start": "03:56:05.000",
      "formatted_end": "03:56:08.000",
      "text": "هفته دیگه بیا ببینیم که چه باشه"
    },
    {
      "id": 19,
      "start": 14168.0,
      "end": 14171.0,
      "formatted_start": "03:56:08.000",
      "formatted_end": "03:56:11.000",
      "text": "باش برای دکتر هم زمان دیگه میکنیم"
    },
    {
      "id": 20,
      "start": 14171.0,
      "end": 14174.0,
      "formatted_start": "03:56:11.000",
      "formatted_end": "03:56:14.000",
      "text": "بله تو کتاب شماره کردی؟ نه نه نه"
    },
    {
      "id": 21,
      "start": 14174.0,
      "end": 14176.0,
      "formatted_start": "03:56:14.000",
      "formatted_end": "03:56:16.000",
      "text": "من کامیان دوتونم"
    },
    {
      "id": 22,
      "start": 14176.0,
      "end": 14178.0,
      "formatted_start": "03:56:16.000",
      "formatted_end": "03:56:18.000",
      "text": "چرا نصیب داری بیرون دخترین؟"
    },
    {
      "id": 23,
      "start": 14178.0,
      "end": 14180.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:20.000",
      "text": "میگه اینجا من...الواقع پسید شما باید دیگه نیمون بگه"
    },
    {
      "id": 24,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "یکم بهتر شد دیگه نیمون"
    },
    {
      "id": 25,
      "start": 14182.0,
      "end": 14184.0,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:24.000",
      "text": "آره...دیگه با ازامه درخواست"
    },
    {
      "id": 26,
      "start": 14184.0,
      "end": 14186.0,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:26.000",
      "text": "بشه میگن میامیم من تو شربه بدم میرم"
    },
    {
      "id": 27,
      "start": 14186.0,
      "end": 14188.0,
      "formatted_start": "03:56:26.000",
      "formatted_end": "03:56:28.000",
      "text": "چه شربه؟"
    },
    {
      "id": 28,
      "start": 14188.0,
      "end": 14190.0,
      "formatted_start": "03:56:28.000",
      "formatted_end": "03:56:30.000",
      "text": "همین کماده شربه"
    },
    {
      "id": 29,
      "start": 14190.0,
      "end": 14192.0,
      "formatted_start": "03:56:30.000",
      "formatted_end": "03:56:32.000",
      "text": "آره فا بچه"
    },
    {
      "id": 30,
      "start": 14192.0,
      "end": 14194.0,
      "formatted_start": "03:56:32.000",
      "formatted_end": "03:56:34.000",
      "text": "من یکم بهتر شد خیلی برد شد"
    },
    {
      "id": 31,
      "start": 14194.0,
      "end": 14196.0,
      "formatted_start": "03:56:34.000",
      "formatted_end": "03:56:36.000",
      "text": "برده"
    },
    {
      "id": 32,
      "start": 14196.0,
      "end": 14198.0,
      "formatted_start": "03:56:36.000",
      "formatted_end": "03:56:38.000",
      "text": "بشه برده"
    },
    {
      "id": 33,
      "start": 14198.0,
      "end": 14200.0,
      "formatted_start": "03:56:38.000",
      "formatted_end": "03:56:40.000",
      "text": "بشه برده"
    },
    {
      "id": 34,
      "start": 14200.0,
      "end": 14202.0,
      "formatted_start": "03:56:40.000",
      "formatted_end": "03:56:42.000",
      "text": "بشه برده"
    },
    {
      "id": 35,
      "start": 14202.0,
      "end": 14205.0,
      "formatted_start": "03:56:42.000",
      "formatted_end": "03:56:45.000",
      "text": "مابا اینم گیر آرفا آرفا"
    },
    {
      "id": 36,
      "start": 14205.0,
      "end": 14208.0,
      "formatted_start": "03:56:45.000",
      "formatted_end": "03:56:48.000",
      "text": "آرام بکنیم که اون حوال آرفا بودن و اون نرمش میکنه"
    },
    {
      "id": 37,
      "start": 14208.0,
      "end": 14212.0,
      "formatted_start": "03:56:48.000",
      "formatted_end": "03:56:52.000",
      "text": "نرم می کنه و اون ردشو بخواییم صاف کنه و آرفا نیست"
    },
    {
      "id": 38,
      "start": 14212.0,
      "end": 14215.0,
      "formatted_start": "03:56:52.000",
      "formatted_end": "03:56:55.000",
      "text": "اون محلوله محمود"
    },
    {
      "id": 39,
      "start": 14215.0,
      "end": 14217.0,
      "formatted_start": "03:56:55.000",
      "formatted_end": "03:56:57.000",
      "text": "اسمت بخترم چی بود؟"
    },
    {
      "id": 40,
      "start": 14217.0,
      "end": 14218.0,
      "formatted_start": "03:56:57.000",
      "formatted_end": "03:56:58.000",
      "text": "کیانا"
    },
    {
      "id": 41,
      "start": 14218.0,
      "end": 14219.0,
      "formatted_start": "03:56:58.000",
      "formatted_end": "03:56:59.000",
      "text": "کیانا فامیده؟"
    },
    {
      "id": 42,
      "start": 14219.0,
      "end": 14220.0,
      "formatted_start": "03:56:59.000",
      "formatted_end": "03:57:00.000",
      "text": "راد گرچی"
    },
    {
      "id": 43,
      "start": 14220.0,
      "end": 14221.0,
      "formatted_start": "03:57:00.000",
      "formatted_end": "03:57:01.000",
      "text": "راده؟"
    },
    {
      "id": 44,
      "start": 14221.0,
      "end": 14222.0,
      "formatted_start": "03:57:01.000",
      "formatted_end": "03:57:02.000",
      "text": "گرچی"
    },
    {
      "id": 45,
      "start": 14222.0,
      "end": 14224.0,
      "formatted_start": "03:57:02.000",
      "formatted_end": "03:57:04.000",
      "text": "گرچی، خیلی خوب"
    },
    {
      "id": 46,
      "start": 14224.0,
      "end": 14226.0,
      "formatted_start": "03:57:04.000",
      "formatted_end": "03:57:06.000",
      "text": "کدی میدیتو بگو"
    },
    {
      "id": 47,
      "start": 14226.0,
      "end": 14228.0,
      "formatted_start": "03:57:06.000",
      "formatted_end": "03:57:08.000",
      "text": "رسمستان"
    },
    {
      "id": 48,
      "start": 14228.0,
      "end": 14231.0,
      "formatted_start": "03:57:08.000",
      "formatted_end": "03:57:11.000",
      "text": "حالا نسخانش یکی میدونستن برا؟"
    },
    {
      "id": 49,
      "start": 14231.0,
      "end": 14233.0,
      "formatted_start": "03:57:11.000",
      "formatted_end": "03:57:13.000",
      "text": "از کسی ها سپیدن به گیر برده؟"
    },
    {
      "id": 50,
      "start": 14233.0,
      "end": 14235.0,
      "formatted_start": "03:57:13.000",
      "formatted_end": "03:57:15.000",
      "text": "از باباش به پرسید بیرون داره"
    },
    {
      "id": 51,
      "start": 14235.0,
      "end": 14237.0,
      "formatted_start": "03:57:15.000",
      "formatted_end": "03:57:17.000",
      "text": "از پروزه بزنه"
    },
    {
      "id": 52,
      "start": 14237.0,
      "end": 14239.0,
      "formatted_start": "03:57:17.000",
      "formatted_end": "03:57:19.000",
      "text": "واسه کنه بزنه بزنه"
    },
    {
      "id": 53,
      "start": 14239.0,
      "end": 14241.0,
      "formatted_start": "03:57:19.000",
      "formatted_end": "03:57:21.000",
      "text": "که درست کنه بزنه"
    },
    {
      "id": 54,
      "start": 14241.0,
      "end": 14243.0,
      "formatted_start": "03:57:21.000",
      "formatted_end": "03:57:23.000",
      "text": "اون باز کنه چی کنه؟"
    },
    {
      "id": 55,
      "start": 14243.0,
      "end": 14245.0,
      "formatted_start": "03:57:23.000",
      "formatted_end": "03:57:25.000",
      "text": "اونو که می آورده"
    },
    {
      "id": 56,
      "start": 14245.0,
      "end": 14247.0,
      "formatted_start": "03:57:25.000",
      "formatted_end": "03:57:27.000",
      "text": "باشه"
    },
    {
      "id": 57,
      "start": 14249.0,
      "end": 14251.0,
      "formatted_start": "03:57:29.000",
      "formatted_end": "03:57:31.000",
      "text": "اینکه از که باز بزنه"
    },
    {
      "id": 58,
      "start": 14251.0,
      "end": 14253.0,
      "formatted_start": "03:57:31.000",
      "formatted_end": "03:57:33.000",
      "text": "که باز بزنه"
    },
    {
      "id": 59,
      "start": 14253.0,
      "end": 14255.0,
      "formatted_start": "03:57:33.000",
      "formatted_end": "03:57:35.000",
      "text": "باز بزنه بگیره"
    },
    {
      "id": 60,
      "start": 14255.0,
      "end": 14257.0,
      "formatted_start": "03:57:35.000",
      "formatted_end": "03:57:37.000",
      "text": "اونو از که باز بزنه بگیره"
    },
    {
      "id": 61,
      "start": 14257.0,
      "end": 14259.0,
      "formatted_start": "03:57:37.000",
      "formatted_end": "03:57:39.000",
      "text": "در اینکه باز ساعتی بعد که نگاه ببینم"
    },
    {
      "id": 62,
      "start": 14259.0,
      "end": 14264.0,
      "formatted_start": "03:57:39.000",
      "formatted_end": "03:57:44.000",
      "text": "نه، مهم نیست اصلا کودمیلی پوستیه، داره این چیز نداره"
    },
    {
      "id": 63,
      "start": 14264.0,
      "end": 14268.0,
      "formatted_start": "03:57:44.000",
      "formatted_end": "03:57:48.000",
      "text": "کودمیلی افتاده ما 4 سرمویتشه تمام"
    },
    {
      "id": 64,
      "start": 14275.0,
      "end": 14278.0,
      "formatted_start": "03:57:55.000",
      "formatted_end": "03:57:58.000",
      "text": "هلو خانمانم جا، مرحبا بسیاریم"
    },
    {
      "id": 65,
      "start": 14278.0,
      "end": 14280.0,
      "formatted_start": "03:57:58.000",
      "formatted_end": "03:58:00.000",
      "text": "هلو"
    },
    {
      "id": 66,
      "start": 14282.0,
      "end": 14284.0,
      "formatted_start": "03:58:02.000",
      "formatted_end": "03:58:04.000",
      "text": "اون دره صفته"
    },
    {
      "id": 67,
      "start": 14284.0,
      "end": 14285.0,
      "formatted_start": "03:58:04.000",
      "formatted_end": "03:58:05.000",
      "text": "کودمیلی چی؟"
    },
    {
      "id": 68,
      "start": 14285.0,
      "end": 14287.0,
      "formatted_start": "03:58:05.000",
      "formatted_end": "03:58:07.000",
      "text": "دوتا سه رو برم"
    },
    {
      "id": 69,
      "start": 14287.0,
      "end": 14289.0,
      "formatted_start": "03:58:07.000",
      "formatted_end": "03:58:09.000",
      "text": "که اون رو بردی؟"
    },
    {
      "id": 70,
      "start": 14291.0,
      "end": 14293.0,
      "formatted_start": "03:58:11.000",
      "formatted_end": "03:58:13.000",
      "text": "بابا"
    },
    {
      "id": 71,
      "start": 14295.0,
      "end": 14297.0,
      "formatted_start": "03:58:15.000",
      "formatted_end": "03:58:17.000",
      "text": "بابا"
    },
    {
      "id": 72,
      "start": 14297.0,
      "end": 14299.0,
      "formatted_start": "03:58:17.000",
      "formatted_end": "03:58:19.000",
      "text": "بابا بردی"
    },
    {
      "id": 73,
      "start": 14299.0,
      "end": 14301.0,
      "formatted_start": "03:58:19.000",
      "formatted_end": "03:58:21.000",
      "text": "میگم که همین"
    },
    {
      "id": 74,
      "start": 14301.0,
      "end": 14303.0,
      "formatted_start": "03:58:21.000",
      "formatted_end": "03:58:23.000",
      "text": "کدوم بردی؟"
    },
    {
      "id": 75,
      "start": 14303.0,
      "end": 14305.0,
      "formatted_start": "03:58:23.000",
      "formatted_end": "03:58:25.000",
      "text": "بابا سلام کنید؟"
    },
    {
      "id": 76,
      "start": 14305.0,
      "end": 14307.0,
      "formatted_start": "03:58:25.000",
      "formatted_end": "03:58:27.000",
      "text": "بابا"
    },
    {
      "id": 77,
      "start": 14309.0,
      "end": 14311.0,
      "formatted_start": "03:58:29.000",
      "formatted_end": "03:58:31.000",
      "text": "بردی من شنگید؟"
    },
    {
      "id": 78,
      "start": 14311.0,
      "end": 14313.0,
      "formatted_start": "03:58:31.000",
      "formatted_end": "03:58:33.000",
      "text": "بیو بابا نامشون"
    },
    {
      "id": 79,
      "start": 14313.0,
      "end": 14315.0,
      "formatted_start": "03:58:33.000",
      "formatted_end": "03:58:35.000",
      "text": "دوباره بگیر کدوم بردی"
    },
    {
      "id": 80,
      "start": 14315.0,
      "end": 14319.8,
      "formatted_start": "03:58:35.000",
      "formatted_end": "03:58:39.800",
      "text": "میشه سی ست تا من کودی میدینم، میشه چهار ست تا هم، برو نزدیک پنجره زنگ بزنیم"
    },
    {
      "id": 81,
      "start": 14319.8,
      "end": 14320.6,
      "formatted_start": "03:58:39.800",
      "formatted_end": "03:58:40.600",
      "text": "زنگ نیست"
    },
    {
      "id": 82,
      "start": 14320.6,
      "end": 14323.0,
      "formatted_start": "03:58:40.600",
      "formatted_end": "03:58:43.000",
      "text": "حالا دو تا مهمونه باید بمانه"
    },
    {
      "id": 83,
      "start": 14326.4,
      "end": 14327.2,
      "formatted_start": "03:58:46.400",
      "formatted_end": "03:58:47.200",
      "text": "هلو"
    },
    {
      "id": 84,
      "start": 14329.2,
      "end": 14330.0,
      "formatted_start": "03:58:49.200",
      "formatted_end": "03:58:50.000",
      "text": "هلو"
    },
    {
      "id": 85,
      "start": 14330.2,
      "end": 14331.6,
      "formatted_start": "03:58:50.200",
      "formatted_end": "03:58:51.600",
      "text": "برو پنجره کنه"
    },
    {
      "id": 86,
      "start": 14331.6,
      "end": 14333.0,
      "formatted_start": "03:58:51.600",
      "formatted_end": "03:58:53.000",
      "text": "اینجا متصمم کنم"
    },
    {
      "id": 87,
      "start": 14333.4,
      "end": 14334.2,
      "formatted_start": "03:58:53.400",
      "formatted_end": "03:58:54.200",
      "text": "هلو"
    },
    {
      "id": 88,
      "start": 14335.6,
      "end": 14340.6,
      "formatted_start": "03:58:55.600",
      "formatted_end": "03:59:00.600",
      "text": "میدیم کودی میدی، اکشنر من بگو، آبادمش دکتر، میگه من کومم دکتر"
    },
    {
      "id": 89,
      "start": 14341.6,
      "end": 14343.6,
      "formatted_start": "03:59:01.600",
      "formatted_end": "03:59:03.600",
      "text": "اگه نیست کودی میدی، خودشو بدی"
    },
    {
      "id": 90,
      "start": 14345.0,
      "end": 14347.0,
      "formatted_start": "03:59:05.000",
      "formatted_end": "03:59:07.000",
      "text": "خود بودی باشه نمی سنید"
    },
    {
      "id": 91,
      "start": 14347.0,
      "end": 14349.0,
      "formatted_start": "03:59:07.000",
      "formatted_end": "03:59:09.000",
      "text": "آره بگو شو"
    },
    {
      "id": 92,
      "start": 14349.0,
      "end": 14351.0,
      "formatted_start": "03:59:09.000",
      "formatted_end": "03:59:11.000",
      "text": "صرف ۶۷۷"
    },
    {
      "id": 93,
      "start": 14351.0,
      "end": 14353.0,
      "formatted_start": "03:59:11.000",
      "formatted_end": "03:59:13.000",
      "text": "صرف؟"
    },
    {
      "id": 94,
      "start": 14353.0,
      "end": 14357.0,
      "formatted_start": "03:59:13.000",
      "formatted_end": "03:59:17.000",
      "text": "۶۷۷، ۳۲۵، ۹۹، ۶۶"
    },
    {
      "id": 95,
      "start": 14357.0,
      "end": 14359.0,
      "formatted_start": "03:59:17.000",
      "formatted_end": "03:59:19.000",
      "text": "اسمش چیه آقا؟"
    },
    {
      "id": 96,
      "start": 14359.0,
      "end": 14361.0,
      "formatted_start": "03:59:19.000",
      "formatted_end": "03:59:21.000",
      "text": "علی رادبورجی"
    },
    {
      "id": 97,
      "start": 14361.0,
      "end": 14364.0,
      "formatted_start": "03:59:21.000",
      "formatted_end": "03:59:24.000",
      "text": "قبلا چی بوده فهمید شون؟"
    },
    {
      "id": 98,
      "start": 14364.0,
      "end": 14366.0,
      "formatted_start": "03:59:24.000",
      "formatted_end": "03:59:26.000",
      "text": "همون بوده دیگه"
    },
    {
      "id": 99,
      "start": 14366.0,
      "end": 14368.0,
      "formatted_start": "03:59:26.000",
      "formatted_end": "03:59:28.000",
      "text": "از برجون آمدن اینجا رو آمد کردن"
    },
    {
      "id": 100,
      "start": 14368.0,
      "end": 14370.0,
      "formatted_start": "03:59:28.000",
      "formatted_end": "03:59:30.000",
      "text": "رادبورجی، تو دو تا سه رو به می سنید"
    },
    {
      "id": 101,
      "start": 14370.0,
      "end": 14372.0,
      "formatted_start": "03:59:30.000",
      "formatted_end": "03:59:32.000",
      "text": "روی این لکه، یه باش باشینو"
    },
    {
      "id": 102,
      "start": 14372.0,
      "end": 14374.0,
      "formatted_start": "03:59:32.000",
      "formatted_end": "03:59:34.000",
      "text": "بهتر بکنه"
    },
    {
      "id": 103,
      "start": 14374.0,
      "end": 14376.58,
      "formatted_start": "03:59:34.000",
      "formatted_end": "03:59:36.580",
      "text": "این چیز میشه بگیرم واقعا کشم گیره کشم"
    },
    {
      "id": 104,
      "start": 14376.58,
      "end": 14378.0,
      "formatted_start": "03:59:36.580",
      "formatted_end": "03:59:38.000",
      "text": "واقعا کشم گیره دیگه"
    },
    {
      "id": 105,
      "start": 14378.0,
      "end": 14379.28,
      "formatted_start": "03:59:38.000",
      "formatted_end": "03:59:39.280",
      "text": "پس صاف بشه"
    },
    {
      "id": 106,
      "start": 14379.28,
      "end": 14380.84,
      "formatted_start": "03:59:39.280",
      "formatted_end": "03:59:40.840",
      "text": "یک ماه که زدی میاری"
    },
    {
      "id": 107,
      "start": 14380.84,
      "end": 14383.14,
      "formatted_start": "03:59:40.840",
      "formatted_end": "03:59:43.140",
      "text": "یه بار خیلی خیلی خیلی"
    },
    {
      "id": 108,
      "start": 14383.14,
      "end": 14385.1,
      "formatted_start": "03:59:43.140",
      "formatted_end": "03:59:45.100",
      "text": "سه شست و هفت"
    },
    {
      "id": 109,
      "start": 14385.1,
      "end": 14386.92,
      "formatted_start": "03:59:45.100",
      "formatted_end": "03:59:46.920",
      "text": "چیزه سه شست و هفت"
    },
    {
      "id": 110,
      "start": 14386.92,
      "end": 14387.96,
      "formatted_start": "03:59:46.920",
      "formatted_end": "03:59:47.960",
      "text": "سه ویست و پند"
    },
    {
      "id": 111,
      "start": 14387.96,
      "end": 14389.36,
      "formatted_start": "03:59:47.960",
      "formatted_end": "03:59:49.360",
      "text": "نوهدنو شست"
    },
    {
      "id": 112,
      "start": 14389.36,
      "end": 14391.38,
      "formatted_start": "03:59:49.360",
      "formatted_end": "03:59:51.380",
      "text": "نوهدنو شست"
    },
    {
      "id": 113,
      "start": 14391.38,
      "end": 14393.18,
      "formatted_start": "03:59:51.380",
      "formatted_end": "03:59:53.180",
      "text": "سه شست و هفت"
    },
    {
