  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3910.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:10.000",
      "text": "بر اساس امار عبدیه ی سازمان آلود نجات جنوب لبلان در حمله هوای رژیم اسرائیل به رستای انصار شش نفر به شهادت رسیدند."
    },
    {
      "id": 1,
      "start": 3910.0,
      "end": 3921.0,
      "formatted_start": "01:05:10.000",
      "formatted_end": "01:05:21.000",
      "text": "بانگده امود رژیم سنگرسلی در سه حمله هوایی رستای نواتیه، تورا و رستای انصار در شهرستان نردکیه را حدث کردند."
    },
    {
      "id": 2,
      "start": 3921.0,
      "end": 3931.0,
      "formatted_start": "01:05:21.000",
      "formatted_end": "01:05:31.000",
      "text": "همزمان منابع خبری از درگیری سنگیر یعنی رزمگیران از بوده ها و نیوهای احشای بشمی سنگیرسکی در منطقه راه کنید یا یک تاور در جبهه دوبلا میخوردند."
    },
    {
      "id": 3,
      "start": 3931.0,
      "end": 3938.0,
      "formatted_start": "01:05:31.000",
      "formatted_end": "01:05:38.000",
      "text": "بر اساس این روبرش ها، احشای بشمی سنگیرسکی را پشتی کنید هموی و با تشکیل سنگیر مطمئن،"
    },
    {
      "id": 4,
      "start": 3938.0,
      "end": 3946.0,
      "formatted_start": "01:05:38.000",
      "formatted_end": "01:05:46.000",
      "text": "حلاش کرده به سمت این منطقه ممنونه در داله نباتی پیش رنی کند اما با مقاومت شبیه بزرگ دارد و یدون هم نهاشه شده"
    },
    {
      "id": 5,
      "start": 3946.0,
      "end": 3955.0,
      "formatted_start": "01:05:46.000",
      "formatted_end": "01:05:55.000",
      "text": "مرابع میدانی تحکیم دارند و در گریبا دفعان نفر از سراغ ناشکارگر زخمی شدند و با گرده برای انتقاد آنها اعضام شدند"
    },
    {
      "id": 6,
      "start": 3955.0,
      "end": 3969.62,
      "formatted_start": "01:05:55.000",
      "formatted_end": "01:06:09.620",
      "text": "گزارش تقاطای مورد بخشیری نشان میدهد افتاده اروپا مذاکرات محرمانی را با پولیس و رژن سخنسکی برای اشتراک داشتن داده های شخصی حساس فلسطینی ها را اچهاند"
    },
    {
      "id": 7,
      "start": 3969.62,
      "end": 3983.24,
      "formatted_start": "01:06:09.620",
      "formatted_end": "01:06:23.240",
      "text": "بر اساس گزارش گروه برون و مندنی، این مذاکرات و توافق محرمانه علاقه بشترهای برونی مردود در اینکه قوامین بین اوندگر نقصی کنندن فلسطینی ها را در محرم خطره قرار میدهد"
    },
    {
      "id": 8,
      "start": 3983.24,
      "end": 3985.24,
      "formatted_start": "01:06:23.240",
      "formatted_end": "01:06:25.240",
      "text": "سیره پذیر است."
    },
    {
      "id": 9,
      "start": 3985.24,
      "end": 3991.24,
      "formatted_start": "01:06:25.240",
      "formatted_end": "01:06:31.240",
      "text": "پیشتویس این توافق که در اقتداع با آژانس دوریس اروپا موضوعی به یورپول مدترین شده بود،"
    },
    {
      "id": 10,
      "start": 3991.24,
      "end": 4000.24,
      "formatted_start": "01:06:31.240",
      "formatted_end": "01:06:40.240",
      "text": "امکانی کمانی را داده بیونیزی، اقتداد جمعیتی، داده مکانی، این دایی سیاسی و اقتداد شخصی را ترمیل کنند."
    },
    {
      "id": 11,
      "start": 4002.24,
      "end": 4012.24,
      "formatted_start": "01:06:42.240",
      "formatted_end": "01:06:52.240",
      "text": "در وقوع زلزله، قدرتمند ۷۷ آن رشدری در مزید که جزیره فلورس ایرانی موافقات به مرگی از مرگی دستی کم سی نفر کنند."
    },
    {
      "id": 12,
      "start": 4012.24,
      "end": 4019.74,
      "formatted_start": "01:06:52.240",
      "formatted_end": "01:06:59.740",
      "text": "زم درزه راحت به روز در اون کم و در منطقه سباره شمالی طلاعه استفاده"
    },
    {
      "id": 13,
      "start": 4019.74,
      "end": 4024.84,
      "formatted_start": "01:06:59.740",
      "formatted_end": "01:07:04.840",
      "text": "مرکز زلزله حدود 68.3 شمال قربه رای شهر در این درگونه شده"
    },
    {
      "id": 14,
      "start": 4024.84,
      "end": 4032.02,
      "formatted_start": "01:07:04.840",
      "formatted_end": "01:07:12.020",
      "text": "بعد از این لرزه چندیدی از لرزه قبرت مندر جمعه زم درزه های قبرت 6.1 سرد شد"
    },
    {
      "id": 15,
      "start": 4032.02,
      "end": 4036.16,
      "formatted_start": "01:07:12.020",
      "formatted_end": "01:07:16.160",
      "text": "و هزارا نفر در منطقه استانیدی به منطقه مرتبه تنهاده"
    },
    {
      "id": 16,
      "start": 4036.16,
      "end": 4041.16,
      "formatted_start": "01:07:16.160",
      "formatted_end": "01:07:21.160",
      "text": "مقام های اندونیزی در ساته اردگی مشتر سرامی صدید کردند"
    },
    {
      "id": 17,
      "start": 4041.16,
      "end": 4050.16,
      "formatted_start": "01:07:21.160",
      "formatted_end": "01:07:30.160",
      "text": "گزارش از ریزش و آسیب صاحبت مالها، خسارت کانه ها و مدتیز عمومی قطعی برد و اندلال در رفت و آمدی کنند."
    },
    {
      "id": 18,
      "start": 4050.16,
      "end": 4059.16,
      "formatted_start": "01:07:30.160",
      "formatted_end": "01:07:39.160",
      "text": "همه جایی که جزبجو و امداد در محاضره هاست به ادامه دارد و مواقعات مهندی مشترلند که احتمال برگوی هسته از آیه بیشتر وجود برد."
    },
    {
      "id": 19,
      "start": 4059.16,
      "end": 4065.18,
      "formatted_start": "01:07:39.160",
      "formatted_end": "01:07:45.180",
      "text": "و همه دان شهر تاریخ و تمدون"
    },
    {
      "id": 20,
      "start": 4065.18,
      "end": 4074.28,
      "formatted_start": "01:07:45.180",
      "formatted_end": "01:07:54.280",
      "text": "علاوه وقت جازبه های گرمشیری و مردمان مهمان نوازش به شیرین ها و صورتات بشترنش هم شنخدان شد"
    },
    {
      "id": 21,
      "start": 4074.28,
      "end": 4082.98,
      "formatted_start": "01:07:54.280",
      "formatted_end": "01:08:02.980",
      "text": "همه دان شهر بسیار تمدون خیلی بزرگی داره"
    },
    {
      "id": 22,
      "start": 4082.98,
      "end": 4088.62,
      "formatted_start": "01:08:02.980",
      "formatted_end": "01:08:08.620",
      "text": "و مردمان بسیار بافرهنگ به طول قدمت پنج هزار سالی که حکمت ها را داره"
    },
    {
      "id": 23,
      "start": 4088.62,
      "end": 4091.2,
      "formatted_start": "01:08:08.620",
      "formatted_end": "01:08:11.200",
      "text": "و مردمان مهمان نوازش"
    },
    {
      "id": 24,
      "start": 4091.2,
      "end": 4092.52,
      "formatted_start": "01:08:11.200",
      "formatted_end": "01:08:12.520",
      "text": "بعدی دلیل هایش"
    },
    {
      "id": 25,
      "start": 4092.52,
      "end": 4095.78,
      "formatted_start": "01:08:12.520",
      "formatted_end": "01:08:15.780",
      "text": "محمدان رو به مقبول بابا تایل میشنرسی"
    },
    {
      "id": 26,
      "start": 4095.78,
      "end": 4100.34,
      "formatted_start": "01:08:15.780",
      "formatted_end": "01:08:20.340",
      "text": "تاریخی اون کاری تاریخی ایگمتانه میشنرسی"
    },
    {
      "id": 27,
      "start": 4100.34,
      "end": 4102.6,
      "formatted_start": "01:08:20.340",
      "formatted_end": "01:08:22.600",
      "text": "دیگه انخوذت همونانی میشنرسی"
    },
    {
      "id": 28,
      "start": 4102.6,
      "end": 4106.98,
      "formatted_start": "01:08:22.600",
      "formatted_end": "01:08:26.980",
      "text": "اما این شهر شیرینی های خوشترمی خودش رو هم دارد"
    },
    {
      "id": 29,
      "start": 4106.98,
      "end": 4111.48,
      "formatted_start": "01:08:26.980",
      "formatted_end": "01:08:31.480",
      "text": "سقاسی هایی که کام گردش کرده را شیرین میکنند"
    },
    {
      "id": 30,
      "start": 4111.48,
      "end": 4113.46,
      "formatted_start": "01:08:31.480",
      "formatted_end": "01:08:33.460",
      "text": "سافره که تشکیل میگردن اینجا"
    },
    {
      "id": 31,
      "start": 4113.46,
      "end": 4118.14,
      "formatted_start": "01:08:33.460",
      "formatted_end": "01:08:38.140",
      "text": "بیشتر کماج، حلو زرده و انگوش بیچونی بره"
    },
    {
      "id": 32,
      "start": 4118.14,
      "end": 4128.96,
      "formatted_start": "01:08:38.140",
      "formatted_end": "01:08:48.960",
      "text": "این سوخاتی ها برای بسیاری از گردشکران مزه ماندگار از سفر را می سازن"
    },
    {
      "id": 33,
      "start": 4128.96,
      "end": 4141.38,
      "formatted_start": "01:08:48.960",
      "formatted_end": "01:09:01.380",
      "text": "همه نام خوشمزش مروفه مثل کماج و شیرمال و حلبازرده"
    },
    {
      "id": 34,
      "start": 4141.38,
      "end": 4146.78,
      "formatted_start": "01:09:01.380",
      "formatted_end": "01:09:06.780",
      "text": "هرچند هنوز هستن کسانی که این طعم شیرین را نچشیدن"
    },
    {
      "id": 35,
      "start": 4146.78,
      "end": 4150.54,
      "formatted_start": "01:09:06.780",
      "formatted_end": "01:09:10.540",
      "text": "دلیل دوست دارم انتهاهم کنم شیرینی صحبتی همه دانو"
    },
    {
      "id": 36,
      "start": 4150.54,
      "end": 4155.84,
      "formatted_start": "01:09:10.540",
      "formatted_end": "01:09:15.840",
      "text": "شنیدم که قیصه صحبتی ها داره مثل کمازی و پلوازر که هنوز نخواهیدم"
    },
    {
      "id": 37,
      "start": 4155.84,
      "end": 4159.38,
      "formatted_start": "01:09:15.840",
      "formatted_end": "01:09:19.380",
      "text": "دوست دارم استفاده کنم ببینم چیلستان را زشونیم"
    },
    {
      "id": 38,
      "start": 4160.1,
      "end": 4162.1,
      "formatted_start": "01:09:20.100",
      "formatted_end": "01:09:22.100",
      "text": "دوست دارم صحبتی همه دانو"
    },
    {
      "id": 39,
      "start": 4162.1,
      "end": 4166.06,
      "formatted_start": "01:09:22.100",
      "formatted_end": "01:09:26.060",
      "text": "برای همه دان این شیرینی ها فقط صحبت نیستن"
    },
    {
      "id": 40,
      "start": 4166.06,
      "end": 4172.22,
      "formatted_start": "01:09:26.060",
      "formatted_end": "01:09:32.220",
      "text": "روایت شیرین از فرهنگ و مهمانوازی مردمان این دیاره"
    },
    {
      "id": 41,
      "start": 4172.22,
      "end": 4176.54,
      "formatted_start": "01:09:32.220",
      "formatted_end": "01:09:36.540",
      "text": "نهایید روحانی خبرگزاری صدا و سیما هر ندار"
    },
    {
      "id": 42,
      "start": 4176.54,
      "end": 4180.58,
