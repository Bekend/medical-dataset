      "start": 7690.0,
      "end": 7692.0,
      "formatted_start": "02:08:10.000",
      "formatted_end": "02:08:12.000",
      "text": "ورق من"
    },
    {
      "id": 53,
      "start": 7692.0,
      "end": 7694.0,
      "formatted_start": "02:08:12.000",
      "formatted_end": "02:08:14.000",
      "text": "آزمایش شما درون نمیشه"
    },
    {
      "id": 54,
      "start": 7694.0,
      "end": 7696.0,
      "formatted_start": "02:08:14.000",
      "formatted_end": "02:08:16.000",
      "text": "به حاله میشه"
    },
    {
      "id": 55,
      "start": 7696.0,
      "end": 7698.0,
      "formatted_start": "02:08:16.000",
      "formatted_end": "02:08:18.000",
      "text": "به حاله نمیشه"
    },
    {
