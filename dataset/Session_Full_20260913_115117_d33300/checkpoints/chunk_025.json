  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7506.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:06.000",
      "text": "در اینجا بیست و یکم بوده، اما هیچکرم بیست و چارم نموده."
    },
    {
      "id": 1,
      "start": 7506.0,
      "end": 7512.0,
      "formatted_start": "02:05:06.000",
      "formatted_end": "02:05:12.000",
      "text": "بیست و یکم، اینجا بیست و چارم هنوز نشونده."
    },
    {
      "id": 2,
      "start": 7512.0,
      "end": 7516.0,
      "formatted_start": "02:05:12.000",
      "formatted_end": "02:05:16.000",
      "text": "بفرمایید روی تن."
    },
    {
      "id": 3,
      "start": 7516.0,
      "end": 7522.0,
      "formatted_start": "02:05:16.000",
      "formatted_end": "02:05:22.000",
      "text": "بیست و هتت، دو، سی اون، دو یه شیش، پنجه شیش، هر اینجا جایید."
    },
    {
      "id": 4,
      "start": 7522.0,
      "end": 7526.0,
      "formatted_start": "02:05:22.000",
      "formatted_end": "02:05:26.000",
      "text": "نهارس با دو پنج بزن."
    },
    {
      "id": 5,
      "start": 7526.0,
      "end": 7529.0,
      "formatted_start": "02:05:26.000",
      "formatted_end": "02:05:29.000",
      "text": "چیز داره زفت میکنه با اینجور"
    },
    {
      "id": 6,
      "start": 7529.0,
      "end": 7531.0,
      "formatted_start": "02:05:29.000",
      "formatted_end": "02:05:31.000",
      "text": "خب؟"
    },
    {
      "id": 7,
      "start": 7531.0,
      "end": 7534.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:34.000",
      "text": "خب رو سیر خواهید"
    },
    {
      "id": 8,
      "start": 7544.0,
      "end": 7548.0,
      "formatted_start": "02:05:44.000",
      "formatted_end": "02:05:48.000",
      "text": "کمی چند داره نیست داره؟ خالیه چرا؟"
    },
    {
      "id": 9,
      "start": 7549.0,
      "end": 7551.0,
      "formatted_start": "02:05:49.000",
      "formatted_end": "02:05:51.000",
      "text": "پنجم نکرده"
    },
    {
      "id": 10,
      "start": 7551.0,
      "end": 7555.0,
      "formatted_start": "02:05:51.000",
      "formatted_end": "02:05:55.000",
      "text": "وسط لکه میری چیز منقدر پنجم کنی؟"
    },
    {
      "id": 11,
      "start": 7556.0,
      "end": 7562.0,
      "formatted_start": "02:05:56.000",
      "formatted_end": "02:06:02.000",
      "text": "آزاد کنید، خواب باید آسماشو کنید، اما اینکه بار بریه خواهیج از سحن باشید"
    },
    {
      "id": 12,
      "start": 7562.0,
      "end": 7566.0,
      "formatted_start": "02:06:02.000",
      "formatted_end": "02:06:06.000",
      "text": "باید برداشتید، اینجوری میشه، بلند آسماشو برید و بعد بشید"
    },
    {
      "id": 13,
      "start": 7566.0,
      "end": 7570.0,
      "formatted_start": "02:06:06.000",
      "formatted_end": "02:06:10.000",
      "text": "توی کاشید به این نخواهیدی بشید"
    },
    {
      "id": 14,
      "start": 7570.0,
      "end": 7575.0,
      "formatted_start": "02:06:10.000",
      "formatted_end": "02:06:15.000",
      "text": "ترمیتی هم که بفترشی زیبایی کنید، این مدت همی خواهی شد"
    },
    {
      "id": 15,
      "start": 7575.0,
      "end": 7577.0,
      "formatted_start": "02:06:15.000",
      "formatted_end": "02:06:17.000",
      "text": "باید برداریم"
    },
    {
      "id": 16,
      "start": 7577.0,
      "end": 7579.0,
      "formatted_start": "02:06:17.000",
      "formatted_end": "02:06:19.000",
      "text": "باید برداریم"
    },
    {
      "id": 17,
      "start": 7579.0,
      "end": 7581.0,
      "formatted_start": "02:06:19.000",
      "formatted_end": "02:06:21.000",
      "text": "باید برداریم"
    },
    {
      "id": 18,
      "start": 7581.0,
      "end": 7583.0,
      "formatted_start": "02:06:21.000",
      "formatted_end": "02:06:23.000",
      "text": "باید برداریم"
    },
    {
      "id": 19,
      "start": 7583.0,
      "end": 7585.0,
      "formatted_start": "02:06:23.000",
      "formatted_end": "02:06:25.000",
      "text": "باید برداریم"
    },
    {
      "id": 20,
