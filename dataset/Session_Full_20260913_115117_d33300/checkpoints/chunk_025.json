      "end": 7597.0,
      "formatted_start": "02:06:35.000",
      "formatted_end": "02:06:37.000",
      "text": "باید برداریم"
    },
    {
      "id": 26,
      "start": 7597.0,
      "end": 7599.0,
      "formatted_start": "02:06:37.000",
      "formatted_end": "02:06:39.000",
      "text": "باید برداریم"
    },
    {
      "id": 27,
      "start": 7599.0,
      "end": 7601.0,
      "formatted_start": "02:06:39.000",
      "formatted_end": "02:06:41.000",
      "text": "باید برداریم"
    },
    {
      "id": 28,
      "start": 7601.0,
      "end": 7603.0,
      "formatted_start": "02:06:41.000",
      "formatted_end": "02:06:43.000",
      "text": "باید برداریم"
    },
    {
      "id": 29,
      "start": 7603.0,
      "end": 7605.0,
      "formatted_start": "02:06:43.000",
      "formatted_end": "02:06:45.000",
      "text": "شما از دارها چی موند آیا گردید؟"
    },
    {
      "id": 30,
      "start": 7605.0,
      "end": 7607.0,
      "formatted_start": "02:06:45.000",
      "formatted_end": "02:06:47.000",
      "text": "همه رو تقوی کردیم"
    },
    {
      "id": 31,
      "start": 7607.0,
      "end": 7615.0,
      "formatted_start": "02:06:47.000",
      "formatted_end": "02:06:55.000",
      "text": "مدتی هستش که نقلی‌ها محلول ارتارویتین بگم شما تعدادی شب کم بود"
    },
    {
      "id": 32,
      "start": 7615.0,
      "end": 7617.0,
      "formatted_start": "02:06:55.000",
      "formatted_end": "02:06:57.000",
      "text": "کپسول کانت"
    },
    {
      "id": 33,
      "start": 7617.0,
      "end": 7621.0,
      "formatted_start": "02:06:57.000",
      "formatted_end": "02:07:01.000",
      "text": "خب نیاز نیست آزمایش برینست که همش"
    },
    {
      "id": 34,
      "start": 7621.0,
      "end": 7623.0,
      "formatted_start": "02:07:01.000",
      "formatted_end": "02:07:03.000",
      "text": "چرا باید بگویم؟ سبکه"
    },
    {
      "id": 35,
      "start": 7623.0,
      "end": 7625.0,
      "formatted_start": "02:07:03.000",
      "formatted_end": "02:07:05.000",
      "text": "و نرمالش کم بود فرتایره"
    },
    {
      "id": 36,
      "start": 7625.0,
      "end": 7627.0,
      "formatted_start": "02:07:05.000",
      "formatted_end": "02:07:07.000",
      "text": "نین"
    },
    {
      "id": 37,
      "start": 7627.0,
      "end": 7631.0,
      "formatted_start": "02:07:07.000",
      "formatted_end": "02:07:11.000",
      "text": "سیتره محلول ارتارویتین"
    },
    {
      "id": 38,
      "start": 7631.0,
      "end": 7641.0,
      "formatted_start": "02:07:11.000",
      "formatted_end": "02:07:21.000",
      "text": "جوشانه ویتانیه 3 و 6 و 8 در واقع برای شما دارو نداشتند به این بار آزمایش بدین"
    },
    {
      "id": 39,
      "start": 7641.0,
      "end": 7647.0,
      "formatted_start": "02:07:21.000",
      "formatted_end": "02:07:27.000",
      "text": "ببینید تیترش چقدره، حدازش چقدره، برقرار اساس هم به شما ضغط دارونیدن"
    },
    {
      "id": 40,
      "start": 7647.0,
      "end": 7652.0,
      "formatted_start": "02:07:27.000",
      "formatted_end": "02:07:32.000",
      "text": "هر آزمایش همیدواز کنید؟ آزمایش همیدواز باید هیچ جلس براتش بدین"
    },
    {
      "id": 41,
      "start": 7652.0,
      "end": 7657.0,
      "formatted_start": "02:07:32.000",
      "formatted_end": "02:07:37.000",
      "text": "این از اینجوری که باید بردارید که اینکه خودی افتاده میشه"
    },
    {
      "id": 42,
      "start": 7657.0,
      "end": 7662.0,
      "formatted_start": "02:07:37.000",
      "formatted_end": "02:07:42.000",
      "text": "نه، ببینیم نمیدونیم که داخل ملونا وضعیت شده ملونا و سونومرافی معلوم میشه"
    },
    {
      "id": 43,
      "start": 7662.0,
      "end": 7666.0,
      "formatted_start": "02:07:42.000",
      "formatted_end": "02:07:46.000",
      "text": "آه، هلین یه آزمایش میدین ببینید بار بره داخل ملونا میشه؟"
    },
    {
      "id": 44,
      "start": 7666.0,
      "end": 7668.0,
      "formatted_start": "02:07:46.000",
      "formatted_end": "02:07:48.000",
      "text": "آه، ببینیم"
    },
    {
      "id": 45,
      "start": 7668.0,
      "end": 7670.0,
      "formatted_start": "02:07:48.000",
      "formatted_end": "02:07:50.000",
      "text": "اگه درو بیدن بیاد داخل ملونا"
    },
    {
      "id": 46,
      "start": 7670.0,
      "end": 7680.0,
      "formatted_start": "02:07:50.000",
      "formatted_end": "02:08:00.000",
      "text": "و بعد بیتار، مرشد، سپرم، گرام"
    },
    {
      "id": 47,
      "start": 7680.0,
      "end": 7682.0,
      "formatted_start": "02:08:00.000",
      "formatted_end": "02:08:02.000",
      "text": "درون میشه درون میشه"
    },
    {
      "id": 48,
      "start": 7682.0,
      "end": 7684.0,
      "formatted_start": "02:08:02.000",
      "formatted_end": "02:08:04.000",
      "text": "شما درون میشه"
    },
    {
      "id": 49,
      "start": 7684.0,
      "end": 7686.0,
      "formatted_start": "02:08:04.000",
      "formatted_end": "02:08:06.000",
      "text": "شما آزمایش میدین"
    },
    {
      "id": 50,
      "start": 7686.0,
      "end": 7688.0,
      "formatted_start": "02:08:06.000",
      "formatted_end": "02:08:08.000",
      "text": "اشون هم آزمایش اسپران میده"
    },
    {
      "id": 51,
      "start": 7688.0,
      "end": 7690.0,
      "formatted_start": "02:08:08.000",
      "formatted_end": "02:08:10.000",
      "text": "این خیلی خوشش داروی"
    },
