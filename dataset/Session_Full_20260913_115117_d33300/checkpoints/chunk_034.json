  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10230.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 10230.0,
      "end": 10232.0,
      "formatted_start": "02:50:30.000",
      "formatted_end": "02:50:32.000",
      "text": "این ببونه؟"
    },
    {
      "id": 2,
      "start": 10232.0,
      "end": 10234.0,
      "formatted_start": "02:50:32.000",
      "formatted_end": "02:50:34.000",
      "text": "دارم"
    },
    {
      "id": 3,
      "start": 10234.0,
      "end": 10236.0,
      "formatted_start": "02:50:34.000",
      "formatted_end": "02:50:36.000",
      "text": "شرمت یک تا دیگه"
    },
    {
      "id": 4,
      "start": 10236.0,
      "end": 10238.0,
      "formatted_start": "02:50:36.000",
      "formatted_end": "02:50:38.000",
      "text": "دو تا شرمت"
    },
    {
      "id": 5,
      "start": 10240.0,
      "end": 10242.0,
      "formatted_start": "02:50:40.000",
      "formatted_end": "02:50:42.000",
      "text": "آره خورده"
    },
    {
      "id": 6,
      "start": 10242.0,
      "end": 10244.0,
      "formatted_start": "02:50:42.000",
      "formatted_end": "02:50:44.000",
      "text": "متوجه نشدی"
    },
    {
      "id": 7,
      "start": 10244.0,
      "end": 10246.0,
      "formatted_start": "02:50:44.000",
      "formatted_end": "02:50:46.000",
      "text": "ازیزم"
    },
    {
      "id": 8,
      "start": 10246.0,
      "end": 10248.0,
      "formatted_start": "02:50:46.000",
      "formatted_end": "02:50:48.000",
      "text": "می کنید با دست کاری نه"
    },
    {
      "id": 9,
      "start": 10248.0,
      "end": 10250.0,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:50.000",
      "text": "یعنی با باشو"
    },
    {
      "id": 10,
      "start": 10250.0,
      "end": 10252.0,
      "formatted_start": "02:50:50.000",
      "formatted_end": "02:50:52.000",
      "text": "آره دستی داری"
    },
    {
      "id": 11,
      "start": 10252.0,
      "end": 10254.0,
      "formatted_start": "02:50:52.000",
      "formatted_end": "02:50:54.000",
      "text": "حالا دیگه"
    },
    {
      "id": 12,
      "start": 10254.0,
      "end": 10256.0,
      "formatted_start": "02:50:54.000",
      "formatted_end": "02:50:56.000",
      "text": "بیشتر بیشتر"
    },
    {
      "id": 13,
      "start": 10256.0,
      "end": 10258.0,
      "formatted_start": "02:50:56.000",
      "formatted_end": "02:50:58.000",
      "text": "بسیار"
    },
    {
      "id": 14,
      "start": 10258.0,
      "end": 10287.98,
      "formatted_start": "02:50:58.000",
      "formatted_end": "02:51:27.980",
      "text": "باید برگفتر شکر از اینجا برگفتر شکر از اینجا برگفتر شکر از اینجا"
    },
    {
      "id": 15,
      "start": 10288.0,
      "end": 10294.0,
      "formatted_start": "02:51:28.000",
      "formatted_end": "02:51:34.000",
      "text": "بفرمایی بفرمایی سلام سلام بفرمایی"
    },
    {
      "id": 16,
      "start": 10294.0,
      "end": 10300.0,
      "formatted_start": "02:51:34.000",
      "formatted_end": "02:51:40.000",
      "text": "خوش آمده خانم از دایی بفرمایی چی شد آشکانم؟"
    },
    {
      "id": 17,
      "start": 10300.0,
      "end": 10306.0,
      "formatted_start": "02:51:40.000",
      "formatted_end": "02:51:46.000",
      "text": "من اولا چهار دفعه نیستم فلد بایی باپوشتم"
    },
    {
      "id": 18,
      "start": 10306.0,
      "end": 10308.0,
      "formatted_start": "02:51:46.000",
      "formatted_end": "02:51:48.000",
      "text": "سر بود؟"
    },
    {
      "id": 19,
      "start": 10308.0,
      "end": 10312.0,
      "formatted_start": "02:51:48.000",
      "formatted_end": "02:51:52.000",
      "text": "نه اصلا تو کن باشت این فل بلوی"
    },
    {
      "id": 20,
      "start": 10312.0,
      "end": 10314.0,
      "formatted_start": "02:51:52.000",
      "formatted_end": "02:51:54.000",
      "text": "میتونست یه آقایی من برداد"
    },
    {
      "id": 21,
      "start": 10314.0,
      "end": 10316.0,
      "formatted_start": "02:51:54.000",
      "formatted_end": "02:51:56.000",
      "text": "که؟"
    },
    {
      "id": 22,
      "start": 10316.0,
      "end": 10318.0,
      "formatted_start": "02:51:56.000",
      "formatted_end": "02:51:58.000",
      "text": "او واقعا ده روز"
    },
    {
      "id": 23,
      "start": 10318.0,
      "end": 10322.0,
      "formatted_start": "02:51:58.000",
      "formatted_end": "02:52:02.000",
      "text": "ده روز الان آمدی؟ خیلی خوب"
    },
    {
      "id": 24,
      "start": 10322.0,
      "end": 10325.0,
      "formatted_start": "02:52:02.000",
      "formatted_end": "02:52:05.000",
      "text": "چه ناراتی ها ایجاز شد سرگیجه داری استفراق بکنی؟"
    },
    {
      "id": 25,
      "start": 10325.0,
      "end": 10331.0,
      "formatted_start": "02:52:05.000",
      "formatted_end": "02:52:11.000",
      "text": "نه از تو این ده روز استفراق بکنی؟ کمر درد داشته باشی؟"
    },
    {
      "id": 26,
      "start": 10331.0,
      "end": 10336.0,
      "formatted_start": "02:52:11.000",
      "formatted_end": "02:52:16.000",
      "text": "کمه ها رو خیلی درد میدونه. وقتی از رم این طرف استراب کنن"
    },
    {
      "id": 27,
      "start": 10336.0,
      "end": 10338.0,
      "formatted_start": "02:52:16.000",
      "formatted_end": "02:52:18.000",
      "text": "کبودی چیزی نشد خاله؟"
    },
    {
      "id": 28,
      "start": 10338.0,
      "end": 10339.0,
      "formatted_start": "02:52:18.000",
      "formatted_end": "02:52:19.000",
      "text": "نه اصلا نباشه"
    },
    {
      "id": 29,
      "start": 10339.0,
      "end": 10340.0,
      "formatted_start": "02:52:19.000",
      "formatted_end": "02:52:20.000",
      "text": "اون چی؟"
    },
    {
      "id": 30,
      "start": 10340.0,
      "end": 10344.0,
      "formatted_start": "02:52:20.000",
      "formatted_end": "02:52:24.000",
      "text": "آقا ما گفت کبودی چیزی نسته. من گفت اون چیز نسته تا"
    },
    {
      "id": 31,
      "start": 10344.0,
      "end": 10347.0,
      "formatted_start": "02:52:24.000",
      "formatted_end": "02:52:27.000",
      "text": "من گفت این نمیشه. درد دارم من تو. من درد دارم"
    },
    {
      "id": 32,
      "start": 10347.0,
      "end": 10354.0,
      "formatted_start": "02:52:27.000",
      "formatted_end": "02:52:34.000",
      "text": "بسیار درد داره ولی اتفاقی نه. خدا رم کرده دیگه لگن ها تنش کسته"
    },
    {
      "id": 33,
      "start": 10354.0,
      "end": 10360.0,
      "formatted_start": "02:52:34.000",
      "formatted_end": "02:52:40.000",
      "text": "سرن شما یه بار که میخورند زمین این لگندورشون از اینجا میشکنه"
    },
    {
      "id": 34,
      "start": 10360.0,
      "end": 10366.0,
      "formatted_start": "02:52:40.000",
      "formatted_end": "02:52:46.000",
      "text": "خدا نگردشت خدا نگردشت"
    },
    {
      "id": 35,
      "start": 10366.0,
      "end": 10370.0,
      "formatted_start": "02:52:46.000",
      "formatted_end": "02:52:50.000",
      "text": "نابز میشونی دیگه؟"
    },
    {
      "id": 36,
      "start": 10370.0,
      "end": 10374.0,
      "formatted_start": "02:52:50.000",
      "formatted_end": "02:52:54.000",
      "text": "آتروز درده"
    },
    {
      "id": 37,
      "start": 10374.0,
      "end": 10378.0,
      "formatted_start": "02:52:54.000",
      "formatted_end": "02:52:58.000",
      "text": "آتروز درده فیل زمینه"
    },
    {
      "id": 38,
      "start": 10378.0,
      "end": 10382.0,
      "formatted_start": "02:52:58.000",
      "formatted_end": "02:53:02.000",
      "text": "این روستان که خودش رنگ هایی که سر هم بزنی نرم"
    },
    {
      "id": 39,
      "start": 10382.0,
      "end": 10388.0,
      "formatted_start": "02:53:02.000",
      "formatted_end": "02:53:08.000",
      "text": "اصلا دیگه یعنی تو میبینی که چه کار خوبی کرده بودی و بعد این اون رو تیز اجازه داره"
    },
    {
      "id": 40,
      "start": 10388.0,
      "end": 10391.0,
      "formatted_start": "02:53:08.000",
      "formatted_end": "02:53:11.000",
      "text": "آره ما همون رو چرچرک علیم داشتیم"
    },
    {
      "id": 41,
      "start": 10391.0,
      "end": 10397.0,
      "formatted_start": "02:53:11.000",
      "formatted_end": "02:53:17.000",
      "text": "آره یه چیزی داشتی که واسط شده بکنه نکی تو"
    },
    {
      "id": 42,
      "start": 10397.0,
      "end": 10400.0,
      "formatted_start": "02:53:17.000",
      "formatted_end": "02:53:20.000",
      "text": "با آدم اصلا دیگه جوانش بیاده زبین"
    },
    {
      "id": 43,
      "start": 10400.0,
      "end": 10402.0,
      "formatted_start": "02:53:20.000",
      "formatted_end": "02:53:22.000",
      "text": "یه چیزش بشه"
    },
    {
      "id": 44,
      "start": 10402.0,
      "end": 10410.22,
      "formatted_start": "02:53:22.000",
      "formatted_end": "02:53:30.220",
      "text": "اینها رو خدا قدرتش رو به ما نشان میده"
    },
    {
      "id": 45,
      "start": 10410.22,
      "end": 10413.14,
      "formatted_start": "02:53:30.220",
      "formatted_end": "02:53:33.140",
      "text": "ما میبینیم باز فراموشه"
    },
    {
      "id": 46,
      "start": 10413.14,
      "end": 10417.32,
      "formatted_start": "02:53:33.140",
      "formatted_end": "02:53:37.320",
      "text": "باز نعمتش رو فراموشه"
    },
    {
      "id": 47,
      "start": 10417.32,
      "end": 10418.34,
      "formatted_start": "02:53:37.320",
      "formatted_end": "02:53:38.340",
      "text": "بیا کن چشم"
    },
    {
      "id": 48,
      "start": 10418.34,
      "end": 10421.58,
      "formatted_start": "02:53:38.340",
      "formatted_end": "02:53:41.580",
      "text": "که در حال این دردهای قدیمی هم بهتر میشه"
    },
    {
      "id": 49,
      "start": 10421.58,
      "end": 10423.4,
      "formatted_start": "02:53:41.580",
      "formatted_end": "02:53:43.400",
      "text": "این دردهای خدا نباشه"
    },
    {
      "id": 50,
      "start": 10423.4,
      "end": 10425.16,
      "formatted_start": "02:53:43.400",
      "formatted_end": "02:53:45.160",
      "text": "این دردهایی باقی نیست"
    },
    {
      "id": 51,
      "start": 10425.16,
      "end": 10425.82,
      "formatted_start": "02:53:45.160",
      "formatted_end": "02:53:45.820",
      "text": "نه"
    },
    {
      "id": 52,
      "start": 10425.82,
      "end": 10427.18,
      "formatted_start": "02:53:45.820",
      "formatted_end": "02:53:47.180",
      "text": "این دردهایی باقی نیست"
    },
    {
      "id": 53,
      "start": 10427.18,
      "end": 10430.18,
      "formatted_start": "02:53:47.180",
      "formatted_end": "02:53:50.180",
      "text": "این دردهایی باقی نیست"
    },
    {
      "id": 54,
      "start": 10430.18,
      "end": 10434.18,
      "formatted_start": "02:53:50.180",
      "formatted_end": "02:53:54.180",
      "text": "اگر نخستند این بچه ها نمیتونند برشوند."
    },
    {
      "id": 55,
      "start": 10434.18,
      "end": 10439.18,
      "formatted_start": "02:53:54.180",
      "formatted_end": "02:53:59.180",
      "text": "من بخشت برداخت دادم، این بچه ها آزمی شدند و بگوید همچنین استفاده اومد نگاه می کنند."
    },
    {
      "id": 56,
      "start": 10439.18,
      "end": 10441.18,
      "formatted_start": "02:53:59.180",
      "formatted_end": "02:54:01.180",
      "text": "نه، خدا نگهد."
    },
    {
      "id": 57,
      "start": 10441.18,
      "end": 10443.18,
      "formatted_start": "02:54:01.180",
      "formatted_end": "02:54:03.180",
      "text": "این دارو بکنه بودن از اصلاسیت دارد."
    },
    {
      "id": 58,
      "start": 10443.18,
      "end": 10446.18,
      "formatted_start": "02:54:03.180",
      "formatted_end": "02:54:06.180",
      "text": "نه، نه بکنم. دارو این ناپروکسه هی میخوایید."
    },
    {
      "id": 59,
      "start": 10446.18,
      "end": 10449.18,
      "formatted_start": "02:54:06.180",
      "formatted_end": "02:54:09.180",
      "text": "آره، آره، ناپروکسه ها اصلاسیت دارد."
    },
    {
      "id": 60,
      "start": 10449.18,
      "end": 10454.18,
      "formatted_start": "02:54:09.180",
      "formatted_end": "02:54:14.180",
      "text": "این کماده رحمی هم بزرگ دارد."
    },
    {
      "id": 61,
      "start": 10460.18,
      "end": 10489.18,
      "formatted_start": "02:54:20.180",
      "formatted_end": "02:54:49.180",
      "text": "این زمان با رو تا خوب باشه نه؟ از همین امروز کمتر و کمتر و کمتر میشه یک هفته در وقت بره"
    },
    {
      "id": 62,
      "start": 10489.18,
      "end": 10492.24,
      "formatted_start": "02:54:49.180",
      "formatted_end": "02:54:52.240",
      "text": "در حد کفتگیه این شما"
    },
    {
      "id": 63,
      "start": 10492.24,
      "end": 10495.18,
      "formatted_start": "02:54:52.240",
      "formatted_end": "02:54:55.180",
      "text": "باش می آمدی زودتر تا آنها برداریم"
    },
    {
      "id": 64,
      "start": 10495.18,
      "end": 10496.28,
      "formatted_start": "02:54:55.180",
      "formatted_end": "02:54:56.280",
      "text": "نیام نام آمین"
    },
    {
      "id": 65,
      "start": 10496.28,
      "end": 10499.6,
      "formatted_start": "02:54:56.280",
      "formatted_end": "02:54:59.600",
      "text": "رفتم این روزه هایی آن روزه سوی کنیم"
    }
  ],
  "status": "completed"
}