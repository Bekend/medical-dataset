      "formatted_start": "01:51:18.300",
      "formatted_end": "01:51:20.300",
      "text": "نه درست باشیم"
    },
    {
      "id": 28,
      "start": 6680.3,
      "end": 6682.3,
      "formatted_start": "01:51:20.300",
      "formatted_end": "01:51:22.300",
      "text": "دست میسنید تنها بگیریم"
    },
    {
      "id": 29,
      "start": 6682.3,
      "end": 6684.3,
      "formatted_start": "01:51:22.300",
      "formatted_end": "01:51:24.300",
      "text": "آره میگفت اونو منزی های کنالیه"
    },
    {
      "id": 30,
      "start": 6684.3,
      "end": 6686.3,
      "formatted_start": "01:51:24.300",
      "formatted_end": "01:51:26.300",
      "text": "اون مرسی"
    },
    {
      "id": 31,
      "start": 6686.3,
      "end": 6688.3,
      "formatted_start": "01:51:26.300",
      "formatted_end": "01:51:28.300",
      "text": "این همچنین زندگو شما همچنین بخشش"
    },
    {
      "id": 32,
      "start": 6688.3,
      "end": 6690.3,
      "formatted_start": "01:51:28.300",
      "formatted_end": "01:51:30.300",
      "text": "چیز شده اون تنها بنده بود"
    },
    {
      "id": 33,
      "start": 6690.3,
      "end": 6692.3,
      "formatted_start": "01:51:30.300",
      "formatted_end": "01:51:32.300",
      "text": "این از پامینه"
    },
    {
      "id": 34,
      "start": 6692.3,
      "end": 6694.3,
      "formatted_start": "01:51:32.300",
      "formatted_end": "01:51:34.300",
      "text": "اکس ایمرا اینو گفت"
    },
    {
      "id": 35,
      "start": 6694.3,
      "end": 6697.8,
      "formatted_start": "01:51:34.300",
      "formatted_end": "01:51:37.800",
      "text": "ببین من نزاش برم داروامه بگیرم"
    },
    {
      "id": 36,
      "start": 6697.8,
      "end": 6701.7,
      "formatted_start": "01:51:37.800",
      "formatted_end": "01:51:41.700",
      "text": "این هکس ایملا دارم همیشه از پا میبری"
    },
    {
      "id": 37,
      "start": 6701.7,
      "end": 6704.5,
      "formatted_start": "01:51:41.700",
      "formatted_end": "01:51:44.500",
      "text": "حالا دوست دارم این پرده خیلی باره"
    },
    {
      "id": 38,
      "start": 6704.5,
      "end": 6706.5,
      "formatted_start": "01:51:44.500",
      "formatted_end": "01:51:46.500",
      "text": "من مخورم من دارم اون گرده"
    },
    {
      "id": 39,
      "start": 6706.5,
      "end": 6709.0,
      "formatted_start": "01:51:46.500",
      "formatted_end": "01:51:49.000",
      "text": "خوبصورت من میخورم چربی هم مثل هاج خانم بالاست"
    },
    {
      "id": 40,
      "start": 6709.0,
      "end": 6711.0,
      "formatted_start": "01:51:49.000",
      "formatted_end": "01:51:51.000",
      "text": "من به فیبرات بدن"
    },
    {
      "id": 41,
      "start": 6711.0,
      "end": 6715.9,
      "formatted_start": "01:51:51.000",
      "formatted_end": "01:51:55.900",
      "text": "چربی ترگیری سیری در هر دو بالاست"
    },
    {
      "id": 42,
      "start": 6715.9,
      "end": 6717.3,
      "formatted_start": "01:51:55.900",
      "formatted_end": "01:51:57.300",
      "text": "فیلم"
    },
    {
      "id": 43,
      "start": 6717.3,
      "end": 6718.8,
      "formatted_start": "01:51:57.300",
      "formatted_end": "01:51:58.800",
      "text": "فیبرات"
    },
    {
      "id": 44,
      "start": 6718.8,
      "end": 6720.8,
      "formatted_start": "01:51:58.800",
      "formatted_end": "01:52:00.800",
      "text": "صد میلین"
    },
    {
      "id": 45,
      "start": 6720.8,
      "end": 6722.3,
      "formatted_start": "01:52:00.800",
      "formatted_end": "01:52:02.300",
      "text": "سی تا روزی دو تا"
    },
    {
      "id": 46,
      "start": 6722.3,
      "end": 6724.3,
      "formatted_start": "01:52:02.300",
      "formatted_end": "01:52:04.300",
      "text": "نیور هیل برای کبه"
    },
    {
      "id": 47,
      "start": 6724.3,
      "end": 6726.3,
      "formatted_start": "01:52:04.300",
      "formatted_end": "01:52:06.300",
      "text": "برای این مورده کاتون"
    },
    {
      "id": 48,
      "start": 6726.3,
      "end": 6728.3,
      "formatted_start": "01:52:06.300",
      "formatted_end": "01:52:08.300",
      "text": "فرسه نا"
    },
    {
      "id": 49,
      "start": 6728.3,
      "end": 6730.3,
      "formatted_start": "01:52:08.300",
      "formatted_end": "01:52:10.300",
      "text": "فرسه نیز پنجان"
    },
    {
      "id": 50,
      "start": 6730.3,
      "end": 6732.3,
      "formatted_start": "01:52:10.300",
      "formatted_end": "01:52:12.300",
      "text": "فرسه نیز پنجان"
    },
    {
      "id": 51,
      "start": 6732.3,
      "end": 6734.3,
      "formatted_start": "01:52:12.300",
      "formatted_end": "01:52:14.300",
      "text": "فرسه نیز پنجان"
    },
    {
      "id": 52,
      "start": 6734.3,
      "end": 6736.3,
      "formatted_start": "01:52:14.300",
      "formatted_end": "01:52:16.300",
      "text": "فرسه نیز پنجان"
    },
    {
      "id": 53,
      "start": 6736.3,
      "end": 6738.3,
      "formatted_start": "01:52:16.300",
      "formatted_end": "01:52:18.300",
      "text": "فرسه نیز پنجان"
    },
    {
      "id": 54,
      "start": 6738.3,
      "end": 6740.3,
      "formatted_start": "01:52:18.300",
      "formatted_end": "01:52:20.300",
      "text": "نیزی سه بار برده"
    },
    {
      "id": 55,
      "start": 6740.3,
      "end": 6742.3,
      "formatted_start": "01:52:20.300",
      "formatted_end": "01:52:22.300",
      "text": "نیزی نیزی نیزی"
    },
    {
      "id": 56,
      "start": 6742.3,
      "end": 6744.3,
      "formatted_start": "01:52:22.300",
      "formatted_end": "01:52:24.300",
      "text": "روغن که مالی نیست"
    },
    {
      "id": 57,
      "start": 6744.3,
      "end": 6746.3,
      "formatted_start": "01:52:24.300",
      "formatted_end": "01:52:26.300",
      "text": "سه شوار می کشه"
    },
    {
      "id": 58,
      "start": 6746.3,
      "end": 6748.3,
      "formatted_start": "01:52:26.300",
      "formatted_end": "01:52:28.300",
      "text": "روزی سه بار این کار رو انجام بده"
    },
    {
      "id": 59,
      "start": 6748.3,
      "end": 6750.3,
      "formatted_start": "01:52:28.300",
      "formatted_end": "01:52:30.300",
      "text": "زرف سه چهار روز می بیده"
    },
    {
      "id": 60,
      "start": 6750.3,
      "end": 6752.3,
      "formatted_start": "01:52:30.300",
      "formatted_end": "01:52:32.300",
      "text": "زیاد درد میکنه"
    },
    {
      "id": 61,
      "start": 6752.3,
      "end": 6754.3,
      "formatted_start": "01:52:32.300",
      "formatted_end": "01:52:34.300",
      "text": "سردیه"
    },
    {
      "id": 62,
      "start": 6754.3,
      "end": 6756.3,
      "formatted_start": "01:52:34.300",
      "formatted_end": "01:52:36.300",
      "text": "و اون نوکوش گوش ساله هم بخوایی درد میگیره"
    },
    {
      "id": 63,
      "start": 6756.3,
      "end": 6758.3,
      "formatted_start": "01:52:36.300",
      "formatted_end": "01:52:38.300",
      "text": "درسته"
    },
    {
      "id": 64,
      "start": 6758.3,
      "end": 6760.3,
      "formatted_start": "01:52:38.300",
      "formatted_end": "01:52:40.300",
      "text": "سردی نباید کنه"
    },
    {
      "id": 65,
      "start": 6760.3,
      "end": 6762.3,
      "formatted_start": "01:52:40.300",
      "formatted_end": "01:52:42.300",
      "text": "ولی"
    },
    {
      "id": 66,
      "start": 6762.3,
      "end": 6764.3,
      "formatted_start": "01:52:42.300",
      "formatted_end": "01:52:44.300",
      "text": "چون غند داره"
    },
    {
      "id": 67,
      "start": 6764.3,
      "end": 6766.3,
      "formatted_start": "01:52:44.300",
      "formatted_end": "01:52:46.300",
      "text": "غندش چی هست؟"
    },
    {
      "id": 68,
      "start": 6766.3,
      "end": 6768.3,
      "formatted_start": "01:52:46.300",
      "formatted_end": "01:52:48.300",
      "text": "غندش ۲۰۴"
    },
    {
      "id": 69,
      "start": 6768.3,
      "end": 6770.3,
      "formatted_start": "01:52:48.300",
      "formatted_end": "01:52:50.300",
      "text": "باید سرد باشه"
    },
    {
      "id": 70,
      "start": 6770.3,
      "end": 6772.3,
      "formatted_start": "01:52:50.300",
      "formatted_end": "01:52:52.300",
      "text": "دو برابر هم بالاتره"
    },
    {
      "id": 71,
      "start": 6772.3,
      "end": 6774.3,
      "formatted_start": "01:52:52.300",
      "formatted_end": "01:52:54.300",
      "text": "خیلی بالاتره"
    },
    {
      "id": 72,
      "start": 6774.3,
      "end": 6776.3,
      "formatted_start": "01:52:54.300",
      "formatted_end": "01:52:56.300",
      "text": "پرس قنگوز چندتر میکنه؟"
    },
    {
      "id": 73,
      "start": 6776.3,
      "end": 6778.3,
      "formatted_start": "01:52:56.300",
      "formatted_end": "01:52:58.300",
      "text": "من الان جایده این نگیرده هستم"
    },
    {
      "id": 74,
      "start": 6778.3,
      "end": 6781.18,
      "formatted_start": "01:52:58.300",
      "formatted_end": "01:53:01.180",
      "text": "زهر زهر برداری که اینو دادی میخوایی"
    },
    {
      "id": 75,
      "start": 6781.18,
      "end": 6785.34,
      "formatted_start": "01:53:01.180",
      "formatted_end": "01:53:05.340",
      "text": "یه خورس دیگه هم هست کرورنتا میدم روز یک درگاه بود کنید"
    },
    {
      "id": 76,
      "start": 6785.34,
      "end": 6787.02,
      "formatted_start": "01:53:05.340",
      "formatted_end": "01:53:07.020",
      "text": "میدونید متکرمی میخوایی"
    },
    {
      "id": 77,
      "start": 6787.02,
      "end": 6790.62,
      "formatted_start": "01:53:07.020",
      "formatted_end": "01:53:10.620",
      "text": "کرورنتا ده پنج اینم روز یک درگاه بخوند"
    },
    {
      "id": 78,
      "start": 6790.62,
      "end": 6795.34,
      "formatted_start": "01:53:10.620",
      "formatted_end": "01:53:15.340",
      "text": "ادرار یک متر زیاد میکنه و خلاص میشه هر چقدر نمیریزه بیرون"
    },
    {
      "id": 79,
      "start": 6795.34,
      "end": 6799.46,
      "formatted_start": "01:53:15.340",
      "formatted_end": "01:53:19.460",
      "text": "اوائلش ادرار زیاد میشه ممکنه یکم مذیب میشه یعنی چند دستشویی میخونه"
    },
    {
      "id": 80,
      "start": 6799.46,
      "end": 6802.58,
      "formatted_start": "01:53:19.460",
      "formatted_end": "01:53:22.580",
      "text": "زورا شب نخوره که درگاه بود"
    },
    {
      "id": 81,
      "start": 6802.58,
      "end": 6803.82,
      "formatted_start": "01:53:22.580",
      "formatted_end": "01:53:23.820",
      "text": "که شب نشوند"
    },
    {
      "id": 82,
      "start": 6803.82,
      "end": 6806.26,
      "formatted_start": "01:53:23.820",
      "formatted_end": "01:53:26.260",
      "text": "آره ببخشه، این هایی بخورن"
    },
    {
      "id": 83,
      "start": 6806.26,
      "end": 6809.58,
      "formatted_start": "01:53:26.260",
      "formatted_end": "01:53:29.580",
      "text": "آهنگ رفتی ندارد، آشکالون، بالا سرگیجه نیست"
    },
    {
      "id": 84,
      "start": 6810.46,
      "end": 6814.38,
      "formatted_start": "01:53:30.460",
      "formatted_end": "01:53:34.380",
      "text": "اصلا، خوبه، بیماره زیباییه مثلا"
    },
    {
      "id": 85,
      "start": 6815.02,
      "end": 6820.22,
      "formatted_start": "01:53:35.020",
      "formatted_end": "01:53:40.220",
      "text": "باید روی رویزشمون خوبه، برای خودشویی که خوبه، به سرگیجت رفتی ندارد"
    },
    {
      "id": 86,
      "start": 6820.46,
      "end": 6823.26,
      "formatted_start": "01:53:40.460",
      "formatted_end": "01:53:43.260",
      "text": "بیماره آن خریدی قیمتی ندارد، این گرانه"
    },
    {
      "id": 87,
      "start": 6823.26,
      "end": 6825.26,
      "formatted_start": "01:53:43.260",
      "formatted_end": "01:53:45.260",
      "text": "باید خورس زیبایی بهش میاد"
    },
    {
      "id": 88,
      "start": 6827.74,
      "end": 6829.58,
      "formatted_start": "01:53:47.740",
      "formatted_end": "01:53:49.580",
      "text": "ولی به سرگیجت رفتی ندارد"
    },
    {
      "id": 89,
      "start": 6829.58,
      "end": 6832.3,
      "formatted_start": "01:53:49.580",
      "formatted_end": "01:53:52.300",
      "text": "آره سرگیجه بعد از اینا شروع شدید"
    },
    {
      "id": 90,
      "start": 6832.3,
      "end": 6839.5,
      "formatted_start": "01:53:52.300",
      "formatted_end": "01:53:59.500",
      "text": "نه نه نه، اون چیزی خوردی مثلا حلیم مثلا، الان فصل حلیمه، همسران از حلیم سرگجه میگیرن"
    },
    {
      "id": 91,
      "start": 6839.5,
      "end": 6845.3,
      "formatted_start": "01:53:59.500",
      "formatted_end": "01:54:05.300",
      "text": "یا مثلا آجیل خوب میخورن، پسته میگرن، قشنگ میخورن، مردم سرگجه میخورن"
    },
    {
      "id": 92,
      "start": 6845.3,
      "end": 6848.3,
      "formatted_start": "01:54:05.300",
      "formatted_end": "01:54:08.300",
      "text": "حالا تو برای درمانت گفتن نیست"
    },
    {
      "id": 93,
      "start": 6848.3,
      "end": 6853.3,
      "formatted_start": "01:54:08.300",
      "formatted_end": "01:54:13.300",
      "text": "بله ایس ماه پنجی ما حاصل گوشفندی هستیم؟"
    },
    {
      "id": 94,
      "start": 6853.3,
      "end": 6859.3,
      "formatted_start": "01:54:13.300",
      "formatted_end": "01:54:19.300",
      "text": "اصلا گوشفندی تمام است، یعنی سرگجه دیگه نخواهی تشکره، اینا برای شما خطره، هر دو"
    },
    {
      "id": 95,
      "start": 6859.3,
      "end": 6862.3,
      "formatted_start": "01:54:19.300",
      "formatted_end": "01:54:22.300",
      "text": "اگه دیدیدسی 500، 400، خیلی بردارست"
    },
    {
      "id": 96,
      "start": 6862.3,
      "end": 6864.3,
      "formatted_start": "01:54:22.300",
      "formatted_end": "01:54:24.300",
      "text": "این هم دور از شد، دور از شد"
    },
    {
      "id": 97,
      "start": 6864.3,
      "end": 6866.3,
      "formatted_start": "01:54:24.300",
      "formatted_end": "01:54:26.300",
      "text": "دست شما درنگ نکنید"
    },
    {
      "id": 98,
      "start": 6866.3,
      "end": 6868.3,
      "formatted_start": "01:54:26.300",
      "formatted_end": "01:54:28.300",
      "text": "خیلی بردارست"
    },
    {
      "id": 99,
      "start": 6868.3,
      "end": 6870.3,
      "formatted_start": "01:54:28.300",
      "formatted_end": "01:54:30.300",
      "text": "خیلی بردارست"
    },
    {
      "id": 100,
      "start": 6870.3,
      "end": 6872.3,
      "formatted_start": "01:54:30.300",
      "formatted_end": "01:54:32.300",
      "text": "دست شما درنگ نکنید"
    },
    {
      "id": 101,
      "start": 6872.3,
      "end": 6874.3,
      "formatted_start": "01:54:32.300",
      "formatted_end": "01:54:34.300",
      "text": "به سلامت، به سلامت"
    },
    {
      "id": 102,
      "start": 6874.3,
      "end": 6876.3,
      "formatted_start": "01:54:34.300",
      "formatted_end": "01:54:36.300",
      "text": "دست شما درنگ نکنید"
    },
    {
      "id": 103,
      "start": 6876.3,
      "end": 6878.3,
      "formatted_start": "01:54:36.300",
      "formatted_end": "01:54:38.300",
      "text": "الان میاره، میاره"
    },
    {
      "id": 104,
      "start": 6878.3,
      "end": 6880.3,
      "formatted_start": "01:54:38.300",
      "formatted_end": "01:54:40.300",
      "text": "درنگ رو دوباره بیارید، دیگه آبون"
    },
    {
      "id": 105,
      "start": 6880.3,
      "end": 6883.3,
      "formatted_start": "01:54:40.300",
      "formatted_end": "01:54:43.300",
      "text": "اگه اینا مثلا خوب نشد، دوباره بیارید"
    },
    {
      "id": 106,
      "start": 6883.3,
      "end": 6885.3,
      "formatted_start": "01:54:43.300",
      "formatted_end": "01:54:45.300",
      "text": "اونو اتماعی بوشتر جا بکنید"
    },
    {
      "id": 107,
      "start": 6885.3,
      "end": 6887.3,
      "formatted_start": "01:54:45.300",
      "formatted_end": "01:54:47.300",
      "text": "دست شما درنگ نکنید"
