  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6618.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:18.000",
      "text": "اینجا رقب هسته، بعد کتایی می کنه، رقب می کنه، می سوده."
    },
    {
      "id": 1,
      "start": 6618.0,
      "end": 6648.0,
      "formatted_start": "01:50:18.000",
      "formatted_end": "01:50:48.000",
      "text": "باز کنند، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آره، آ"
    },
    {
      "id": 2,
      "start": 6648.0,
      "end": 6648.5,
      "formatted_start": "01:50:48.000",
      "formatted_end": "01:50:48.500",
      "text": "خب؟"
    },
    {
      "id": 3,
      "start": 6648.5,
      "end": 6649.0,
      "formatted_start": "01:50:48.500",
      "formatted_end": "01:50:49.000",
      "text": "نه"
    },
    {
      "id": 4,
      "start": 6649.0,
      "end": 6652.6,
      "formatted_start": "01:50:49.000",
      "formatted_end": "01:50:52.600",
      "text": "فیزیوترافیش هم با استفاده فیزیوترافی هم روغن هست"
    },
    {
      "id": 5,
      "start": 6652.6,
      "end": 6654.0,
      "formatted_start": "01:50:52.600",
      "formatted_end": "01:50:54.000",
      "text": "سشوار داری کنه"
    },
    {
      "id": 6,
      "start": 6654.0,
      "end": 6654.5,
      "formatted_start": "01:50:54.000",
      "formatted_end": "01:50:54.500",
      "text": "نه"
    },
    {
      "id": 7,
      "start": 6654.5,
      "end": 6656.0,
      "formatted_start": "01:50:54.500",
      "formatted_end": "01:50:56.000",
      "text": "و یه روغن میدن بمان"
    },
    {
      "id": 8,
      "start": 6656.0,
      "end": 6658.0,
      "formatted_start": "01:50:56.000",
      "formatted_end": "01:50:58.000",
      "text": "با سشوار اینو داخت بان"
    },
    {
      "id": 9,
      "start": 6658.0,
      "end": 6658.5,
      "formatted_start": "01:50:58.000",
      "formatted_end": "01:50:58.500",
      "text": "خب؟"
    },
    {
      "id": 10,
      "start": 6658.5,
      "end": 6659.0,
      "formatted_start": "01:50:58.500",
      "formatted_end": "01:50:59.000",
      "text": "نه"
    },
    {
      "id": 11,
      "start": 6659.0,
      "end": 6661.3,
      "formatted_start": "01:50:59.000",
      "formatted_end": "01:51:01.300",
      "text": "که این رده آزاد میشه تو رو بردین می کنه"
    },
    {
      "id": 12,
      "start": 6661.3,
      "end": 6663.0,
      "formatted_start": "01:51:01.300",
      "formatted_end": "01:51:03.000",
      "text": "این رده خوشش تو کمره"
    },
    {
      "id": 13,
      "start": 6663.0,
      "end": 6663.5,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:03.500",
      "text": "درسته"
    },
    {
      "id": 14,
      "start": 6663.5,
      "end": 6665.0,
      "formatted_start": "01:51:03.500",
      "formatted_end": "01:51:05.000",
      "text": "اول تو کمر"
    },
    {
      "id": 15,
      "start": 6665.0,
      "end": 6666.0,
      "formatted_start": "01:51:05.000",
      "formatted_end": "01:51:06.000",
      "text": "چون دیسکمر داره"
    },
    {
      "id": 16,
      "start": 6666.0,
      "end": 6666.5,
      "formatted_start": "01:51:06.000",
      "formatted_end": "01:51:06.500",
      "text": "آره"
    },
    {
      "id": 17,
      "start": 6666.5,
      "end": 6667.0,
      "formatted_start": "01:51:06.500",
      "formatted_end": "01:51:07.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 6667.0,
      "end": 6667.5,
      "formatted_start": "01:51:07.000",
      "formatted_end": "01:51:07.500",
