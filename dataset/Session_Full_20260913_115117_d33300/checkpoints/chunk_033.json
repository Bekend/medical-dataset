  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9904.32,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:04.320",
      "text": "شهست دفعه بخود تزریم کنید، برای همه ما هم خلاص میشید."
    },
    {
      "id": 1,
      "start": 9904.32,
      "end": 9905.52,
      "formatted_start": "02:45:04.320",
      "formatted_end": "02:45:05.520",
      "text": "شهست که دو بار؟"
    },
    {
      "id": 2,
      "start": 9905.52,
      "end": 9911.68,
      "formatted_start": "02:45:05.520",
      "formatted_end": "02:45:11.680",
      "text": "شهست که دو بار، دیگه روزی یک بار رو بخسم بزنید، با خود بخود، در موزشون درخواست، اینجوری بزنید."
    },
    {
      "id": 3,
      "start": 9911.68,
      "end": 9913.0,
      "formatted_start": "02:45:11.680",
      "formatted_end": "02:45:13.000",
      "text": "این عمل خواهید؟"
    },
    {
      "id": 4,
      "start": 9913.0,
      "end": 9920.68,
      "formatted_start": "02:45:13.000",
      "formatted_end": "02:45:20.680",
      "text": "آره، این عمل سوید، شهست روز میزنید، بعد دیگه بدن که نسبت مومنات در این وضعی، دیگه راحت میشه، دیگه از این بیماری خلاص میشید."
    },
    {
      "id": 5,
      "start": 9920.68,
      "end": 9924.68,
      "formatted_start": "02:45:20.680",
      "formatted_end": "02:45:24.680",
      "text": "بابا همون کار کنه، باید برداری می کنم، باید برداری می کنم"
    },
    {
      "id": 6,
      "start": 9924.68,
      "end": 9927.68,
      "formatted_start": "02:45:24.680",
      "formatted_end": "02:45:27.680",
      "text": "خب تصویر وقت بگیر از کدومی کارشی"
    },
    {
      "id": 7,
      "start": 9927.68,
      "end": 9929.68,
      "formatted_start": "02:45:27.680",
      "formatted_end": "02:45:29.680",
      "text": "ما فقط به خانه اضافه برم"
    },
    {
      "id": 8,
      "start": 9929.68,
      "end": 9933.68,
      "formatted_start": "02:45:29.680",
      "formatted_end": "02:45:33.680",
      "text": "توی خواهر می آره، یک دونه مرکز، اصلا چیز هستی، یک دونه از بحری"
    },
    {
      "id": 9,
      "start": 9933.68,
      "end": 9938.68,
      "formatted_start": "02:45:33.680",
      "formatted_end": "02:45:38.680",
      "text": "و آدرس بگیر، تلفن کنه، از همون وقت بگیر، بعد برو"
    },
    {
      "id": 10,
      "start": 9938.68,
      "end": 9940.68,
      "formatted_start": "02:45:38.680",
      "formatted_end": "02:45:40.680",
      "text": "صبح دیگه، صبح صبح بگیر"
    },
    {
      "id": 11,
      "start": 9940.68,
      "end": 9944.68,
      "formatted_start": "02:45:40.680",
      "formatted_end": "02:45:44.680",
      "text": "من دیگه اونکن نمی کنم، من خواهر بخواهر بخواهم، من خواهر بخواهم"
    },
    {
      "id": 12,
      "start": 9944.68,
      "end": 9946.68,
      "formatted_start": "02:45:44.680",
      "formatted_end": "02:45:46.680",
      "text": "بسلام"
    },
    {
      "id": 13,
      "start": 9955.68,
      "end": 9957.68,
      "formatted_start": "02:45:55.680",
      "formatted_end": "02:45:57.680",
      "text": "سلام"
    },
    {
      "id": 14,
      "start": 9957.68,
      "end": 9959.68,
      "formatted_start": "02:45:57.680",
      "formatted_end": "02:45:59.680",
      "text": "دعایه"
    },
    {
      "id": 15,
      "start": 9959.68,
      "end": 9961.68,
      "formatted_start": "02:45:59.680",
      "formatted_end": "02:46:01.680",
      "text": "سلام"
    },
    {
      "id": 16,
      "start": 9961.68,
      "end": 9964.68,
      "formatted_start": "02:46:01.680",
      "formatted_end": "02:46:04.680",
      "text": "خیلی خیلی خوش میداره"
    },
    {
      "id": 17,
      "start": 9964.68,
      "end": 9967.68,
      "formatted_start": "02:46:04.680",
      "formatted_end": "02:46:07.680",
      "text": "اگه این از ترمیلشو خیلی یعنی شده"
    },
    {
      "id": 18,
      "start": 9967.68,
      "end": 9970.68,
      "formatted_start": "02:46:07.680",
      "formatted_end": "02:46:10.680",
      "text": "به نظرت سه هم روختره باید چکنیم"
    },
    {
      "id": 19,
      "start": 9970.68,
      "end": 9972.68,
      "formatted_start": "02:46:10.680",
      "formatted_end": "02:46:12.680",
      "text": "خیلی خیلی زیاد میاد"
    },
    {
      "id": 20,
      "start": 9972.68,
      "end": 9976.36,
      "formatted_start": "02:46:12.680",
      "formatted_end": "02:46:16.360",
      "text": "نه بابا داره هر کس منو میبینه که چند جوش داریم"
    },
    {
      "id": 21,
      "start": 9976.36,
      "end": 9977.0,
      "formatted_start": "02:46:16.360",
      "formatted_end": "02:46:17.000",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 9977.0,
      "end": 9980.68,
      "formatted_start": "02:46:17.000",
      "formatted_end": "02:46:20.680",
      "text": "درست میشه کاری نمیدونی که"
    },
    {
      "id": 23,
      "start": 9980.68,
      "end": 9981.8,
      "formatted_start": "02:46:20.680",
      "formatted_end": "02:46:21.800",
      "text": "اگه میشه که چند جوش داریم"
    },
    {
      "id": 24,
      "start": 9981.8,
      "end": 9984.54,
      "formatted_start": "02:46:21.800",
      "formatted_end": "02:46:24.540",
      "text": "حتما باید کل خرچ کاریم با دفترچه نیست"
    },
    {
      "id": 25,
      "start": 9984.54,
      "end": 9985.04,
      "formatted_start": "02:46:24.540",
      "formatted_end": "02:46:25.040",
      "text": "بابا"
    },
    {
      "id": 26,
      "start": 9985.04,
      "end": 9985.88,
      "formatted_start": "02:46:25.040",
      "formatted_end": "02:46:25.880",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 9985.88,
      "end": 9988.04,
      "formatted_start": "02:46:25.880",
      "formatted_end": "02:46:28.040",
      "text": "پندکی جوش داریم"
    },
    {
      "id": 28,
      "start": 9988.04,
      "end": 9989.2,
      "formatted_start": "02:46:28.040",
      "formatted_end": "02:46:29.200",
      "text": "نه این کلمه نمیدونی"
    },
    {
      "id": 29,
      "start": 9989.2,
      "end": 9991.64,
      "formatted_start": "02:46:29.200",
      "formatted_end": "02:46:31.640",
      "text": "برکه ها برامی میدونی که چند جوش داریم"
    },
    {
      "id": 30,
      "start": 9991.64,
      "end": 9992.7,
      "formatted_start": "02:46:31.640",
      "formatted_end": "02:46:32.700",
      "text": "پندکی جوش داریم"
    },
    {
      "id": 31,
      "start": 9992.7,
      "end": 9993.74,
      "formatted_start": "02:46:32.700",
      "formatted_end": "02:46:33.740",
      "text": "باید لکه ها چیز"
    },
    {
      "id": 32,
      "start": 9993.74,
      "end": 9996.36,
      "formatted_start": "02:46:33.740",
      "formatted_end": "02:46:36.360",
      "text": "بره برکه ها برامی برامی"
    },
    {
      "id": 33,
      "start": 9996.36,
      "end": 9998.36,
      "formatted_start": "02:46:36.360",
      "formatted_end": "02:46:38.360",
      "text": "این مانده ها فرقی کنه"
    },
    {
      "id": 34,
      "start": 9998.36,
      "end": 10000.36,
      "formatted_start": "02:46:38.360",
      "formatted_end": "02:46:40.360",
      "text": "همه این رو باید دروابش کنیم"
    },
    {
      "id": 35,
      "start": 10000.36,
      "end": 10002.36,
      "formatted_start": "02:46:40.360",
      "formatted_end": "02:46:42.360",
      "text": "او مادر جوشن دیگه"
    },
    {
      "id": 36,
      "start": 10026.36,
      "end": 10028.36,
      "formatted_start": "02:47:06.360",
      "formatted_end": "02:47:08.360",
      "text": "درمیان مرسه"
    },
    {
      "id": 37,
      "start": 10028.36,
      "end": 10030.36,
      "formatted_start": "02:47:08.360",
      "formatted_end": "02:47:10.360",
      "text": "مرسه"
    },
    {
      "id": 38,
      "start": 10030.36,
      "end": 10032.36,
      "formatted_start": "02:47:10.360",
      "formatted_end": "02:47:12.360",
      "text": "مرسه"
    },
    {
      "id": 39,
      "start": 10032.36,
      "end": 10034.36,
      "formatted_start": "02:47:12.360",
      "formatted_end": "02:47:14.360",
      "text": "مرسه"
    },
    {
      "id": 40,
      "start": 10034.36,
      "end": 10036.36,
      "formatted_start": "02:47:14.360",
      "formatted_end": "02:47:16.360",
      "text": "مرسه"
    },
    {
      "id": 41,
      "start": 10036.36,
      "end": 10038.36,
      "formatted_start": "02:47:16.360",
      "formatted_end": "02:47:18.360",
      "text": "مرسه"
    },
    {
      "id": 42,
      "start": 10038.36,
      "end": 10040.36,
      "formatted_start": "02:47:18.360",
      "formatted_end": "02:47:20.360",
      "text": "مرسه"
    },
    {
      "id": 43,
      "start": 10040.36,
      "end": 10042.36,
      "formatted_start": "02:47:20.360",
      "formatted_end": "02:47:22.360",
      "text": "مرسه"
    },
    {
      "id": 44,
      "start": 10042.36,
      "end": 10044.36,
      "formatted_start": "02:47:22.360",
      "formatted_end": "02:47:24.360",
      "text": "دو تا مرسه اکش یه روز درمیانه"
    },
    {
      "id": 45,
      "start": 10044.36,
      "end": 10046.36,
      "formatted_start": "02:47:24.360",
      "formatted_end": "02:47:26.360",
      "text": "یکی شوزی دوباره"
    },
    {
      "id": 46,
      "start": 10046.36,
      "end": 10048.36,
      "formatted_start": "02:47:26.360",
      "formatted_end": "02:47:28.360",
      "text": "امروز یه عکس میکری"
    },
    {
      "id": 47,
      "start": 10048.36,
      "end": 10050.36,
      "formatted_start": "02:47:28.360",
      "formatted_end": "02:47:30.360",
      "text": "صورت میشوری بدون آرایش"
    },
    {
      "id": 48,
      "start": 10050.36,
      "end": 10052.36,
      "formatted_start": "02:47:30.360",
      "formatted_end": "02:47:32.360",
      "text": "یه دونه عکس میکری از صورت"
    },
    {
      "id": 49,
      "start": 10052.36,
      "end": 10054.36,
      "formatted_start": "02:47:32.360",
      "formatted_end": "02:47:34.360",
      "text": "مقدار جوش ها معلوم بشه"
    },
    {
      "id": 50,
      "start": 10054.36,
      "end": 10056.86,
      "formatted_start": "02:47:34.360",
      "formatted_end": "02:47:36.860",
      "text": "هفته دیگه شمبه دوباره می آییم"
    },
    {
      "id": 51,
      "start": 10056.86,
      "end": 10059.86,
      "formatted_start": "02:47:36.860",
      "formatted_end": "02:47:39.860",
      "text": "آره اینو آزادن"
    },
    {
      "id": 52,
      "start": 10059.86,
      "end": 10063.86,
      "formatted_start": "02:47:39.860",
      "formatted_end": "02:47:43.860",
      "text": "یه دونش بیمه است بقیه اش آزاد و پولی و گران"
    },
    {
      "id": 53,
      "start": 10063.86,
      "end": 10069.86,
      "formatted_start": "02:47:43.860",
      "formatted_end": "02:47:49.860",
      "text": "پستی رو بیمه صفح قبول نداره بیمه ملدی قبول"
    },
    {
      "id": 54,
      "start": 10069.86,
      "end": 10071.86,
      "formatted_start": "02:47:49.860",
      "formatted_end": "02:47:51.860",
      "text": "اونو هم کمشو قمدرونه"
    },
    {
      "id": 55,
      "start": 10071.86,
      "end": 10075.86,
      "formatted_start": "02:47:51.860",
      "formatted_end": "02:47:55.860",
      "text": "هفته دیگه شمبه باز هفته دیگه شمبه"
    },
    {
      "id": 56,
      "start": 10075.86,
      "end": 10078.86,
      "formatted_start": "02:47:55.860",
      "formatted_end": "02:47:58.860",
      "text": "شمبه میشه روز شما"
    },
    {
      "id": 57,
      "start": 10078.86,
      "end": 10083.86,
      "formatted_start": "02:47:58.860",
      "formatted_end": "02:48:03.860",
      "text": "می آییم هر هفته تا اینو مثل خونکابر سپید و صاف و تمیز"
    },
    {
      "id": 58,
      "start": 10083.86,
      "end": 10093.86,
      "formatted_start": "02:48:03.860",
      "formatted_end": "02:48:13.860",
      "text": "بیا داریم، الان داروهایت رو بیار ببینم، هفته دیگه بیاییم خود داروهایی مانده، اکس امروز و اکس امروز را داشته یه فایل باید تشکیل کنید"
    },
    {
      "id": 59,
      "start": 10093.86,
      "end": 10096.86,
      "formatted_start": "02:48:13.860",
      "formatted_end": "02:48:16.860",
      "text": "مرسی، درسته چند درم نکنم"
    },
    {
      "id": 60,
      "start": 10096.86,
      "end": 10097.86,
      "formatted_start": "02:48:16.860",
      "formatted_end": "02:48:17.860",
      "text": "خوبی باشیم"
    },
    {
      "id": 61,
      "start": 10097.86,
      "end": 10098.86,
      "formatted_start": "02:48:17.860",
      "formatted_end": "02:48:18.860",
      "text": "خداحافظ"
    },
    {
      "id": 62,
      "start": 10098.86,
      "end": 10113.86,
      "formatted_start": "02:48:18.860",
      "formatted_end": "02:48:33.860",
      "text": "موسیقی"
    },
    {
      "id": 63,
      "start": 10128.86,
      "end": 10130.86,
      "formatted_start": "02:48:48.860",
      "formatted_end": "02:48:50.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 64,
      "start": 10130.86,
      "end": 10132.86,
      "formatted_start": "02:48:50.860",
      "formatted_end": "02:48:52.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 65,
      "start": 10132.86,
      "end": 10134.86,
      "formatted_start": "02:48:52.860",
      "formatted_end": "02:48:54.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 66,
      "start": 10134.86,
      "end": 10136.86,
      "formatted_start": "02:48:54.860",
      "formatted_end": "02:48:56.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 67,
      "start": 10136.86,
      "end": 10138.86,
      "formatted_start": "02:48:56.860",
      "formatted_end": "02:48:58.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 68,
      "start": 10138.86,
      "end": 10140.86,
      "formatted_start": "02:48:58.860",
      "formatted_end": "02:49:00.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 69,
      "start": 10140.86,
      "end": 10142.86,
      "formatted_start": "02:49:00.860",
      "formatted_end": "02:49:02.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 70,
      "start": 10142.86,
      "end": 10144.86,
      "formatted_start": "02:49:02.860",
      "formatted_end": "02:49:04.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 71,
      "start": 10144.86,
      "end": 10146.86,
      "formatted_start": "02:49:04.860",
      "formatted_end": "02:49:06.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 72,
      "start": 10146.86,
      "end": 10148.86,
      "formatted_start": "02:49:06.860",
      "formatted_end": "02:49:08.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 73,
      "start": 10148.86,
      "end": 10150.86,
      "formatted_start": "02:49:08.860",
      "formatted_end": "02:49:10.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 74,
      "start": 10150.86,
      "end": 10152.86,
      "formatted_start": "02:49:10.860",
      "formatted_end": "02:49:12.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 75,
      "start": 10152.86,
      "end": 10154.86,
      "formatted_start": "02:49:12.860",
      "formatted_end": "02:49:14.860",
      "text": "بیماری چه؟ آلت ایه؟"
    },
    {
      "id": 76,
      "start": 10154.86,
      "end": 10160.7,
      "formatted_start": "02:49:14.860",
      "formatted_end": "02:49:20.700",
      "text": "این تاینش، این قسمت، این میزه هاش خود، این تنها چیز نیست؟"
    },
    {
      "id": 77,
      "start": 10160.7,
      "end": 10161.7,
      "formatted_start": "02:49:20.700",
      "formatted_end": "02:49:21.700",
      "text": "این ورم نداره یا نداره؟"
    },
    {
      "id": 78,
      "start": 10161.7,
      "end": 10164.9,
      "formatted_start": "02:49:21.700",
      "formatted_end": "02:49:24.900",
      "text": "نه، اون ورم نیست، تره، آره آلتش مفرده نیست"
    },
    {
      "id": 79,
      "start": 10164.9,
      "end": 10166.9,
      "formatted_start": "02:49:24.900",
      "formatted_end": "02:49:26.900",
      "text": "حالا مشکلی که نداری؟ بیوهاشی؟"
    },
    {
      "id": 80,
      "start": 10166.9,
      "end": 10170.74,
      "formatted_start": "02:49:26.900",
      "formatted_end": "02:49:30.740",
      "text": "شنا، نه، بیوه نه، مشکل پوستی، پرمون، بیویسی"
    },
    {
      "id": 81,
      "start": 10170.74,
      "end": 10175.74,
      "formatted_start": "02:49:30.740",
      "formatted_end": "02:49:35.740",
      "text": "نه، آقا من شما میلی آقا ما همسو بودم، گفتم پرمون شما مفردون هست"
    },
    {
      "id": 82,
      "start": 10175.74,
      "end": 10177.74,
      "formatted_start": "02:49:35.740",
      "formatted_end": "02:49:37.740",
      "text": "اشکال نداره، مفردون"
    },
    {
      "id": 83,
      "start": 10177.74,
      "end": 10179.74,
      "formatted_start": "02:49:37.740",
      "formatted_end": "02:49:39.740",
      "text": "چون بیوه تک میگم و آن داره"
    },
    {
      "id": 84,
      "start": 10179.74,
      "end": 10181.74,
      "formatted_start": "02:49:39.740",
      "formatted_end": "02:49:41.740",
      "text": "دیگه نگران دارش باز چند روش"
    },
    {
      "id": 85,
      "start": 10181.74,
      "end": 10183.74,
      "formatted_start": "02:49:41.740",
      "formatted_end": "02:49:43.740",
      "text": "باید رو بس نوریه کنیم رضا نوریه"
    },
    {
      "id": 86,
      "start": 10183.74,
      "end": 10185.74,
      "formatted_start": "02:49:43.740",
      "formatted_end": "02:49:45.740",
      "text": "والا گیر ندم"
    },
    {
      "id": 87,
      "start": 10185.74,
      "end": 10187.74,
      "formatted_start": "02:49:45.740",
      "formatted_end": "02:49:47.740",
      "text": "این اسمش رضای باباشه"
    },
    {
      "id": 88,
      "start": 10187.74,
      "end": 10189.74,
      "formatted_start": "02:49:47.740",
      "formatted_end": "02:49:49.740",
      "text": "آره آره"
    },
    {
