      "formatted_end": "00:10:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 650.0,
      "end": 654.0,
      "formatted_start": "00:10:50.000",
      "formatted_end": "00:10:54.000",
      "text": "مسترک مورد ندار داخل موقع ندار."
    },
    {
      "id": 3,
      "start": 654.0,
      "end": 656.0,
      "formatted_start": "00:10:54.000",
      "formatted_end": "00:10:56.000",
      "text": "با اینکه نتابع در منید."
    },
    {
      "id": 4,
      "start": 656.0,
      "end": 658.0,
      "formatted_start": "00:10:56.000",
      "formatted_end": "00:10:58.000",
      "text": "در صبت باید مورد که زن ندار."
    },
    {
      "id": 5,
      "start": 658.0,
      "end": 660.0,
      "formatted_start": "00:10:58.000",
      "formatted_end": "00:11:00.000",
      "text": "دیگه باید."
    },
    {
      "id": 6,
      "start": 680.0,
      "end": 686.0,
      "formatted_start": "00:11:20.000",
      "formatted_end": "00:11:26.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 710.0,
      "end": 720.0,
      "formatted_start": "00:11:50.000",
      "formatted_end": "00:12:00.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 740.0,
      "end": 769.98,
      "formatted_start": "00:12:20.000",
      "formatted_end": "00:12:49.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 9,
      "start": 770.0,
      "end": 774.62,
      "formatted_start": "00:12:50.000",
      "formatted_end": "00:12:54.620",
      "text": "من میرسه هر چی که جاد است"
    },
    {
      "id": 10,
      "start": 774.62,
      "end": 780.46,
      "formatted_start": "00:12:54.620",
      "formatted_end": "00:13:00.460",
      "text": "روزمی به سیره من میرسه"
    },
    {
      "id": 11,
      "start": 780.46,
      "end": 787.0,
      "formatted_start": "00:13:00.460",
      "formatted_end": "00:13:07.000",
      "text": "منی که توی همه کسان"
    },
    {
      "id": 12,
      "start": 787.76,
      "end": 791.88,
      "formatted_start": "00:13:07.760",
      "formatted_end": "00:13:11.880",
      "text": "بی تو میگیره نقصان"
    },
    {
      "id": 13,
      "start": 791.88,
      "end": 797.0,
      "formatted_start": "00:13:11.880",
      "formatted_end": "00:13:17.000",
      "text": "اگه تو رو داشته باشم"
    },
    {
      "id": 14,
      "start": 797.0,
      "end": 819.0,
      "formatted_start": "00:13:17.000",
      "formatted_end": "00:13:39.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 819.0,
      "end": 824.0,
      "formatted_start": "00:13:39.000",
      "formatted_end": "00:13:44.000",
      "text": "مشترک مورد نفر در حال مکانه ماست. لطفاً منتظر دوانید."
    },
    {
      "id": 16,
      "start": 824.0,
      "end": 827.0,
      "formatted_start": "00:13:44.000",
      "formatted_end": "00:13:47.000",
      "text": "اینجا باید بردارید. باید توقیم دارید."
    },
    {
      "id": 17,
      "start": 849.0,
      "end": 878.98,
      "formatted_start": "00:14:09.000",
      "formatted_end": "00:14:38.980",
      "text": "موسیقی در موسیقی درسته"
    },
