      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:30.000",
      "text": "از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا، از اینجا"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "از اینجا همه شما بودید؟"
    },
    {
      "id": 2,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "باید ببینم."
    },
    {
      "id": 3,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "با یکی میشم ببینم."
    },
    {
      "id": 4,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "این برای من بیشتر سرکش میکنم."
    },
    {
      "id": 5,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "بیشتر سرکش میکنم."
    },
    {
      "id": 6,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "برای قبلا دکتر هم همه شما بودید."
    },
    {
      "id": 7,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "برای قبلا دکتر همه شما بودید."
    },
    {
      "id": 8,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "برای قبلا دکتر همه شما بودید."
    },
    {
      "id": 9,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "بچه هم زیاده زود خورد میشه."
    },
    {
      "id": 10,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "بچه هم زیاده زود خورد میشه."
    },
    {
      "id": 11,
      "start": 6350.0,
      "end": 6352.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:52.000",
      "text": "بچه هم زیاده زود خورد میشه."
    },
    {
      "id": 12,
      "start": 6352.0,
      "end": 6358.68,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:58.680",
      "text": "شما بسیاری مرور در مستقیم بچه ها بسیاری هیچ تصویر نکرد"
    },
    {
      "id": 13,
      "start": 6358.68,
      "end": 6361.0,
      "formatted_start": "01:45:58.680",
      "formatted_end": "01:46:01.000",
      "text": "شما باید چند تا چیز نخورید"
    },
    {
      "id": 14,
      "start": 6361.0,
      "end": 6362.7,
      "formatted_start": "01:46:01.000",
      "formatted_end": "01:46:02.700",
      "text": "یکیش نبنیاته"
    },
    {
      "id": 15,
      "start": 6362.7,
      "end": 6365.28,
      "formatted_start": "01:46:02.700",
      "formatted_end": "01:46:05.280",
      "text": "هرچی از شیر و همونیات"
    },
    {
      "id": 16,
      "start": 6365.28,
      "end": 6367.28,
      "formatted_start": "01:46:05.280",
      "formatted_end": "01:46:07.280",
      "text": "یه مدتی باید نخورید"
    },
    {
      "id": 17,
      "start": 6367.28,
      "end": 6369.14,
      "formatted_start": "01:46:07.280",
      "formatted_end": "01:46:09.140",
      "text": "مثلا یه مد"
    },
    {
      "id": 18,
      "start": 6369.14,
      "end": 6373.62,
      "formatted_start": "01:46:09.140",
      "formatted_end": "01:46:13.620",
      "text": "اصلا بسیاری کره، پنیر، خامه، سرشی"
    },
    {
      "id": 19,
      "start": 6373.62,
      "end": 6374.6,
      "formatted_start": "01:46:13.620",
      "formatted_end": "01:46:14.600",
      "text": "همون شیر مایم هست"
    },
    {
      "id": 20,
      "start": 6374.6,
      "end": 6375.62,
      "formatted_start": "01:46:14.600",
      "formatted_end": "01:46:15.620",
      "text": "آره خورده"
    },
    {
      "id": 21,
      "start": 6375.62,
      "end": 6382.62,
      "formatted_start": "01:46:15.620",
      "formatted_end": "01:46:22.620",
      "text": "بعد دو خون غذاهایی که با دنبو و پی و روغن حیوانی باشه"
    },
    {
      "id": 22,
      "start": 6382.62,
      "end": 6392.62,
      "formatted_start": "01:46:22.620",
      "formatted_end": "01:46:32.620",
      "text": "مثل حلیم، کل پاچه، آب گوشت چرب، خورم سبزی چرب"
    },
    {
      "id": 23,
      "start": 6392.62,
      "end": 6397.62,
      "formatted_start": "01:46:32.620",
      "formatted_end": "01:46:37.620",
      "text": "شما چربی خونتون چارصده"
    },
    {
      "id": 24,
      "start": 6397.62,
      "end": 6401.62,
      "formatted_start": "01:46:37.620",
      "formatted_end": "01:46:41.620",
      "text": "بعدی از دویست میره، الان تو گوشت نفوز میکنه"
    },
    {
      "id": 25,
      "start": 6401.62,
      "end": 6409.12,
      "formatted_start": "01:46:41.620",
      "formatted_end": "01:46:49.120",
      "text": "این چربی رفته توی گوش، قبلاً از زمینه داشته، این چربی گوش رو میگیره"
    },
    {
      "id": 26,
      "start": 6409.12,
      "end": 6413.12,
      "formatted_start": "01:46:49.120",
      "formatted_end": "01:46:53.120",
      "text": "اصلاً داروی چربی به شما ندادن، آه؟"
    },
    {
      "id": 27,
      "start": 6413.12,
      "end": 6415.62,
      "formatted_start": "01:46:53.120",
      "formatted_end": "01:46:55.620",
      "text": "آلام رزا هم رفته نداده، این کمسونی"
    },
    {
      "id": 28,
      "start": 6415.62,
      "end": 6417.12,
      "formatted_start": "01:46:55.620",
      "formatted_end": "01:46:57.120",
      "text": "اونجا آزمایش ندادی؟"
    },
    {
      "id": 29,
      "start": 6417.12,
      "end": 6423.62,
      "formatted_start": "01:46:57.120",
      "formatted_end": "01:47:03.620",
      "text": "نه، اونجا آزمایش ندادیم، میگم اول اول مشکل هم آقای درداشت دلزده"
    },
    {
      "id": 30,
      "start": 6423.62,
      "end": 6424.62,
      "formatted_start": "01:47:03.620",
      "formatted_end": "01:47:04.620",
      "text": "دلزده"
    },
    {
      "id": 31,
      "start": 6424.62,
      "end": 6429.12,
      "formatted_start": "01:47:04.620",
      "formatted_end": "01:47:09.120",
      "text": "از اول دلزد چند روز، گفتم اطلاً قدم بالا پایینه"
    },
    {
      "id": 32,
      "start": 6429.12,
      "end": 6433.24,
      "formatted_start": "01:47:09.120",
      "formatted_end": "01:47:13.240",
      "text": "رفتم آزمایش دادم، میده دق شروع شد"
    },
    {
      "id": 33,
      "start": 6433.24,
      "end": 6438.24,
      "formatted_start": "01:47:13.240",
      "formatted_end": "01:47:18.240",
      "text": "بعد تا آخرش دیگه سرگیجه دیگه من گرفت دیگه حسابی دیگه"
    },
    {
      "id": 34,
      "start": 6438.24,
      "end": 6442.28,
      "formatted_start": "01:47:18.240",
      "formatted_end": "01:47:22.280",
      "text": "الان ریخته کشتگوشم و الان خواه رو بالش سر من بذارم"
    },
    {
      "id": 35,
      "start": 6442.28,
      "end": 6443.88,
      "formatted_start": "01:47:22.280",
      "formatted_end": "01:47:23.880",
      "text": "سرگوزه دنیا میچرخه"
    },
    {
      "id": 36,
      "start": 6443.88,
      "end": 6444.44,
      "formatted_start": "01:47:23.880",
      "formatted_end": "01:47:24.440",
      "text": "میچرخه"
    },
    {
      "id": 37,
      "start": 6444.44,
      "end": 6446.04,
      "formatted_start": "01:47:24.440",
      "formatted_end": "01:47:26.040",
      "text": "این چند روی دارو خوب میشه"
    },
    {
      "id": 38,
      "start": 6446.04,
      "end": 6450.08,
      "formatted_start": "01:47:26.040",
      "formatted_end": "01:47:30.080",
      "text": "اگه نشدی باید به سیلاقا هم مایه کشتو جا بگذارم"
    },
    {
      "id": 39,
      "start": 6450.08,
      "end": 6451.64,
      "formatted_start": "01:47:30.080",
      "formatted_end": "01:47:31.640",
      "text": "پنج ملیون قزینش میشه"
    },
    {
      "id": 40,
      "start": 6451.64,
      "end": 6452.8,
      "formatted_start": "01:47:31.640",
      "formatted_end": "01:47:32.800",
      "text": "الان اونجا نمیشه"
    },
    {
      "id": 41,
      "start": 6452.8,
      "end": 6456.16,
      "formatted_start": "01:47:32.800",
      "formatted_end": "01:47:36.160",
      "text": "چون قبلا هم اینطوری میشدم، میامدن پیشت"
    },
    {
      "id": 42,
      "start": 6459.12,
      "end": 6464.12,
      "formatted_start": "01:47:39.120",
      "formatted_end": "01:47:44.120",
      "text": "کشت شانات میریزه و بعد از دست دفتی در میاد"
    },
    {
      "id": 43,
      "start": 6464.12,
      "end": 6468.12,
      "formatted_start": "01:47:44.120",
      "formatted_end": "01:47:48.120",
      "text": "دقیقا، همون انشان داره فقط تردیز داره"
    },
    {
      "id": 44,
      "start": 6468.12,
      "end": 6471.12,
      "formatted_start": "01:47:48.120",
      "formatted_end": "01:47:51.120",
      "text": "یکی دولیاته، یکی چربی هست"
    },
    {
      "id": 45,
      "start": 6471.12,
      "end": 6477.12,
      "formatted_start": "01:47:51.120",
      "formatted_end": "01:47:57.120",
      "text": "حتی روغن آجیل هم، دیگه میرسم آجیل، تخمه، پسته، بادا هم نکنه"
    },
    {
      "id": 46,
      "start": 6477.12,
      "end": 6479.12,
      "formatted_start": "01:47:57.120",
      "formatted_end": "01:47:59.120",
      "text": "سه تا چیز باید پرخیص کنه"
    },
    {
      "id": 47,
      "start": 6479.12,
      "end": 6481.12,
      "formatted_start": "01:47:59.120",
      "formatted_end": "01:48:01.120",
      "text": "پس خیلی بیمارستان به این پسته میدونه"
    },
    {
      "id": 48,
      "start": 6481.12,
      "end": 6484.12,
      "formatted_start": "01:48:01.120",
      "formatted_end": "01:48:04.120",
      "text": "بدتر می کنه، هر چی پسته بخوری بیشتر میشه"
    },
    {
      "id": 49,
      "start": 6484.12,
      "end": 6486.12,
      "formatted_start": "01:48:04.120",
      "formatted_end": "01:48:06.120",
      "text": "بادا بخوری بیشتر میشه"
    },
    {
      "id": 50,
      "start": 6486.12,
      "end": 6489.56,
      "formatted_start": "01:48:06.120",
      "formatted_end": "01:48:09.560",
      "text": "تکن میکنن که اصلا کمخونی داره میگن پسته با قار"
    },
    {
      "id": 51,
      "start": 6489.56,
      "end": 6492.5,
      "formatted_start": "01:48:09.560",
      "formatted_end": "01:48:12.500",
      "text": "این مریضی با پسته افزایش بیدار میکنه"
    },
    {
      "id": 52,
      "start": 6492.5,
      "end": 6495.84,
      "formatted_start": "01:48:12.500",
      "formatted_end": "01:48:15.840",
      "text": "چربی ها، آهی، لبری ها"
    },
    {
      "id": 53,
      "start": 6495.84,
      "end": 6498.24,
      "formatted_start": "01:48:15.840",
      "formatted_end": "01:48:18.240",
      "text": "این سه تا رو حص میکنید"
    },
    {
      "id": 54,
      "start": 6498.24,
      "end": 6505.76,
      "formatted_start": "01:48:18.240",
      "formatted_end": "01:48:25.760",
      "text": "الان میان حالت ترم بیمارستان گذاشت"
    },
    {
      "id": 55,
      "start": 6505.76,
      "end": 6507.56,
      "formatted_start": "01:48:25.760",
      "formatted_end": "01:48:27.560",
      "text": "ولی این سرگیجه"
    },
    {
      "id": 56,
      "start": 6507.56,
      "end": 6509.9,
      "formatted_start": "01:48:27.560",
      "formatted_end": "01:48:29.900",
      "text": "الان میان که اصلا سرگیجه نداره"
    },
    {
      "id": 57,
      "start": 6509.9,
      "end": 6511.48,
      "formatted_start": "01:48:29.900",
      "formatted_end": "01:48:31.480",
      "text": "ولی پشتیشم"
    },
    {
      "id": 58,
      "start": 6511.48,
      "end": 6512.38,
      "formatted_start": "01:48:31.480",
      "formatted_end": "01:48:32.380",
      "text": "بیشتر"
    },
    {
      "id": 59,
      "start": 6512.38,
      "end": 6513.54,
      "formatted_start": "01:48:32.380",
      "formatted_end": "01:48:33.540",
      "text": "الان باره ها رو بگاه کنید"
    },
    {
      "id": 60,
      "start": 6513.54,
      "end": 6514.54,
      "formatted_start": "01:48:33.540",
      "formatted_end": "01:48:34.540",
      "text": "اوکیه سرگیجه باشه"
    },
    {
      "id": 61,
      "start": 6514.54,
      "end": 6516.84,
      "formatted_start": "01:48:34.540",
      "formatted_end": "01:48:36.840",
      "text": "الان هم یادن نشستیم برار سخت خورگاه کن"
    },
    {
      "id": 62,
      "start": 6516.84,
      "end": 6517.84,
      "formatted_start": "01:48:36.840",
      "formatted_end": "01:48:37.840",
      "text": "همه چی میره"
    },
    {
      "id": 63,
      "start": 6517.84,
      "end": 6518.84,
      "formatted_start": "01:48:37.840",
      "formatted_end": "01:48:38.840",
      "text": "مایه میشید میدهید"
    },
    {
      "id": 64,
      "start": 6518.84,
      "end": 6519.84,
      "formatted_start": "01:48:38.840",
      "formatted_end": "01:48:39.840",
      "text": "تکاملی خوده جوری"
    },
    {
      "id": 65,
      "start": 6519.84,
      "end": 6521.34,
      "formatted_start": "01:48:39.840",
      "formatted_end": "01:48:41.340",
      "text": "یکی چربی"
    },
    {
      "id": 66,
      "start": 6521.34,
      "end": 6523.14,
      "formatted_start": "01:48:41.340",
      "formatted_end": "01:48:43.140",
      "text": "دیوین سه تا چیز نباید بکنیم"
    },
    {
      "id": 67,
      "start": 6523.14,
      "end": 6524.14,
      "formatted_start": "01:48:43.140",
      "formatted_end": "01:48:44.140",
      "text": "آجیل"
    },
    {
      "id": 68,
      "start": 6524.14,
      "end": 6525.14,
      "formatted_start": "01:48:44.140",
      "formatted_end": "01:48:45.140",
      "text": "روغن"
    },
    {
      "id": 69,
      "start": 6525.14,
      "end": 6526.14,
      "formatted_start": "01:48:45.140",
      "formatted_end": "01:48:46.140",
      "text": "لمنیات"
    },
    {
      "id": 70,
      "start": 6526.14,
      "end": 6528.64,
      "formatted_start": "01:48:46.140",
      "formatted_end": "01:48:48.640",
      "text": "از هر وقت درم کشیم"
    },
    {
      "id": 71,
      "start": 6528.64,
      "end": 6531.14,
      "formatted_start": "01:48:48.640",
      "formatted_end": "01:48:51.140",
      "text": "این خوراکی مایه همینجایی"
    },
    {
      "id": 72,
      "start": 6531.14,
      "end": 6534.44,
      "formatted_start": "01:48:51.140",
      "formatted_end": "01:48:54.440",
      "text": "کش که خوردی سرگجه صد درست درست داشت"
    },
    {
      "id": 73,
      "start": 6534.44,
      "end": 6536.44,
      "formatted_start": "01:48:54.440",
      "formatted_end": "01:48:56.440",
      "text": "این سه تا رو پرهیز کنید"
    },
    {
      "id": 74,
      "start": 6536.44,
      "end": 6537.94,
      "formatted_start": "01:48:56.440",
      "formatted_end": "01:48:57.940",
      "text": "سه چار تا دارو رو بکنید"
    },
    {
      "id": 75,
      "start": 6537.94,
      "end": 6542.94,
      "formatted_start": "01:48:57.940",
      "formatted_end": "01:49:02.940",
      "text": "این قرص هم که حالا فیمارستان داده یا اولادزا داده اونو نه اینو براتا خوبه"
    },
    {
      "id": 76,
      "start": 6542.94,
      "end": 6543.94,
      "formatted_start": "01:49:02.940",
      "formatted_end": "01:49:03.940",
      "text": "رو ریمانی میداد اونو"
    },
    {
      "id": 77,
      "start": 6543.94,
      "end": 6549.94,
      "formatted_start": "01:49:03.940",
      "formatted_end": "01:49:09.940",
      "text": "همه خیلی دستش داره این همه صورتی کم روی اینو مرتب روی سه تا بخور دوتا نوشته سه تا"
    },
    {
      "id": 78,
      "start": 6549.94,
      "end": 6553.94,
      "formatted_start": "01:49:09.940",
      "formatted_end": "01:49:13.940",
      "text": "من این دو سه تا دارو نوشتم انشاله دو سه رو سه یعنی کم میشه کم میشه خوبشه"
    },
    {
      "id": 79,
      "start": 6553.94,
      "end": 6554.94,
      "formatted_start": "01:49:13.940",
      "formatted_end": "01:49:14.940",
      "text": "به شده فردیس"
    },
    {
      "id": 80,
      "start": 6554.94,
      "end": 6555.94,
      "formatted_start": "01:49:14.940",
      "formatted_end": "01:49:15.940",
      "text": "اما ریخته پشت گردنه"
    },
    {
      "id": 81,
      "start": 6555.94,
      "end": 6556.94,
      "formatted_start": "01:49:15.940",
      "formatted_end": "01:49:16.940",
      "text": "گردنه"
    },
    {
      "id": 82,
      "start": 6556.94,
      "end": 6557.94,
      "formatted_start": "01:49:16.940",
      "formatted_end": "01:49:17.940",
      "text": "آره اون رو فهمیدم"
    },
    {
      "id": 83,
      "start": 6557.94,
      "end": 6559.94,
      "formatted_start": "01:49:17.940",
      "formatted_end": "01:49:19.940",
      "text": "بعد پرهیزاتو دارم حاموزش میدم"
    },
    {
      "id": 84,
      "start": 6559.94,
      "end": 6561.94,
      "formatted_start": "01:49:19.940",
      "formatted_end": "01:49:21.940",
      "text": "دست دردنه"
    },
    {
      "id": 85,
      "start": 6561.94,
      "end": 6563.94,
      "formatted_start": "01:49:21.940",
      "formatted_end": "01:49:23.940",
      "text": "اینم از این"
    },
    {
      "id": 86,
      "start": 6563.94,
      "end": 6564.94,
      "formatted_start": "01:49:23.940",
      "formatted_end": "01:49:24.940",
      "text": "فشارو میشن میده؟"
    },
    {
      "id": 87,
      "start": 6564.94,
      "end": 6565.94,
      "formatted_start": "01:49:24.940",
      "formatted_end": "01:49:25.940",
      "text": "سیزده"
    },
    {
      "id": 88,
      "start": 6565.94,
      "end": 6567.94,
      "formatted_start": "01:49:25.940",
      "formatted_end": "01:49:27.940",
      "text": "بعد قرص چردی"
    },
    {
      "id": 89,
      "start": 6567.94,
      "end": 6568.94,
      "formatted_start": "01:49:27.940",
      "formatted_end": "01:49:28.940",
      "text": "ببخشید"
    },
    {
      "id": 90,
      "start": 6568.94,
      "end": 6570.94,
      "formatted_start": "01:49:28.940",
      "formatted_end": "01:49:30.940",
      "text": "کپسول ازیت هم میکنه"
    },
    {
      "id": 91,
      "start": 6570.94,
      "end": 6572.94,
      "formatted_start": "01:49:30.940",
      "formatted_end": "01:49:32.940",
      "text": "قرصش باید بمیرسید"
    },
    {
      "id": 92,
      "start": 6572.94,
      "end": 6574.94,
      "formatted_start": "01:49:32.940",
      "formatted_end": "01:49:34.940",
      "text": "میدیشو میشار بدم"
    },
    {
      "id": 93,
      "start": 6574.94,
      "end": 6576.94,
      "formatted_start": "01:49:34.940",
