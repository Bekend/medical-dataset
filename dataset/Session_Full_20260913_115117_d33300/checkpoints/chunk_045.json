  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13530.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 13530.0,
      "end": 13533.5,
      "formatted_start": "03:45:30.000",
      "formatted_end": "03:45:33.500",
      "text": "مشکلی داره من یک بار داره که نباید مصنف بشه"
    },
    {
      "id": 2,
      "start": 13533.5,
      "end": 13535.5,
      "formatted_start": "03:45:33.500",
      "formatted_end": "03:45:35.500",
      "text": "اصلا فرقی بودن"
    },
    {
      "id": 3,
      "start": 13535.5,
      "end": 13537.5,
      "formatted_start": "03:45:35.500",
      "formatted_end": "03:45:37.500",
      "text": "به شما گفتن دیگه اصلا جزو ممنوع هست"
    },
    {
      "id": 4,
      "start": 13537.5,
      "end": 13539.5,
      "formatted_start": "03:45:37.500",
      "formatted_end": "03:45:39.500",
      "text": "نه نگفتن اصلا ممنوع نشدن"
    },
    {
      "id": 5,
      "start": 13539.5,
      "end": 13541.5,
      "formatted_start": "03:45:39.500",
      "formatted_end": "03:45:41.500",
      "text": "اصلا جزو ممنوع هاتو براتاریه"
    },
    {
      "id": 6,
      "start": 13541.5,
      "end": 13543.5,
      "formatted_start": "03:45:41.500",
      "formatted_end": "03:45:43.500",
      "text": "قابلی بود"
    },
    {
      "id": 7,
      "start": 13543.5,
      "end": 13545.5,
      "formatted_start": "03:45:43.500",
      "formatted_end": "03:45:45.500",
      "text": "قابلی بود برای اونجا"
    },
    {
      "id": 8,
      "start": 13545.5,
      "end": 13547.5,
      "formatted_start": "03:45:45.500",
      "formatted_end": "03:45:47.500",
      "text": "خوب بشی اصلا فکر نشد"
    },
    {
      "id": 9,
      "start": 13547.5,
      "end": 13550.5,
      "formatted_start": "03:45:47.500",
      "formatted_end": "03:45:50.500",
      "text": "این بعد هم پنجامین کرونا یکی میگیرد"
    },
    {
      "id": 10,
      "start": 13550.5,
      "end": 13552.5,
      "formatted_start": "03:45:50.500",
      "formatted_end": "03:45:52.500",
      "text": "پنجامین پنج ساله"
    },
    {
      "id": 11,
      "start": 13552.5,
      "end": 13554.5,
      "formatted_start": "03:45:52.500",
      "formatted_end": "03:45:54.500",
      "text": "کلی گرفتید همه یه ساله"
    },
    {
      "id": 12,
      "start": 13554.5,
      "end": 13556.5,
      "formatted_start": "03:45:54.500",
      "formatted_end": "03:45:56.500",
      "text": "اصلا کرونا همه یه نگره"
    },
    {
      "id": 13,
      "start": 13556.5,
      "end": 13560.5,
      "formatted_start": "03:45:56.500",
      "formatted_end": "03:46:00.500",
      "text": "دیگه اشکورونا نمیگن همه جا ما میگیم"
    },
    {
      "id": 14,
      "start": 13560.5,
      "end": 13562.5,
      "formatted_start": "03:46:00.500",
      "formatted_end": "03:46:02.500",
      "text": "دکتور اما اول امو کرونا اولی هست و یکیشو بزرگ میگی"
    },
    {
      "id": 15,
      "start": 13562.5,
      "end": 13564.5,
      "formatted_start": "03:46:02.500",
      "formatted_end": "03:46:04.500",
      "text": "اولی میکشت شما رو نکشت"
    },
    {
      "id": 16,
      "start": 13564.5,
      "end": 13566.5,
      "formatted_start": "03:46:04.500",
      "formatted_end": "03:46:06.500",
      "text": "ولی اونگی نمیکشه"
    },
    {
      "id": 17,
      "start": 13566.5,
      "end": 13568.5,
      "formatted_start": "03:46:06.500",
      "formatted_end": "03:46:08.500",
      "text": "کشتن دیگه رهبه دیگه"
    },
    {
      "id": 18,
      "start": 13568.5,
      "end": 13570.5,
      "formatted_start": "03:46:08.500",
      "formatted_end": "03:46:10.500",
      "text": "چون این ضعیب شد"
    },
    {
      "id": 19,
      "start": 13570.5,
      "end": 13572.5,
      "formatted_start": "03:46:10.500",
      "formatted_end": "03:46:12.500",
      "text": "نه این طوله نرمای طولانی شبه خستش داره"
    },
    {
      "id": 20,
      "start": 13572.5,
      "end": 13574.5,
      "formatted_start": "03:46:12.500",
      "formatted_end": "03:46:14.500",
      "text": "یک هفته در اینجا"
    },
    {
      "id": 21,
      "start": 13574.5,
      "end": 13576.5,
      "formatted_start": "03:46:14.500",
      "formatted_end": "03:46:16.500",
      "text": "شده خوری خوبش"
    },
    {
      "id": 22,
      "start": 13576.5,
      "end": 13578.5,
      "formatted_start": "03:46:16.500",
      "formatted_end": "03:46:18.500",
      "text": "خیلی بسیار"
    },
    {
      "id": 23,
      "start": 13580.5,
      "end": 13582.5,
      "formatted_start": "03:46:20.500",
      "formatted_end": "03:46:22.500",
      "text": "دکتور این همه قرصه برای دیگه یوسته؟"
    },
    {
      "id": 24,
      "start": 13582.5,
      "end": 13587.5,
      "formatted_start": "03:46:22.500",
      "formatted_end": "03:46:27.500",
      "text": "شربت و قرص و اسپریه دماغ و اینجور چیز مثل این"
    },
    {
      "id": 25,
      "start": 13587.5,
      "end": 13595.5,
      "formatted_start": "03:46:27.500",
      "formatted_end": "03:46:35.500",
      "text": "درگشت کنده یه چند تا آموکسی سیری با سربوکولی هم تشکیل میشون؟"
    },
    {
      "id": 26,
      "start": 13595.5,
      "end": 13599.5,
      "formatted_start": "03:46:35.500",
      "formatted_end": "03:46:39.500",
      "text": "سربوکولی بهشون ممنون آموکسی سیری رو براش نوشتن بیشتر می نمیسن"
    },
    {
      "id": 27,
      "start": 13599.5,
      "end": 13601.5,
      "formatted_start": "03:46:39.500",
      "formatted_end": "03:46:41.500",
      "text": "شما هم شریک بشین"
    },
    {
      "id": 28,
      "start": 13601.5,
      "end": 13602.5,
      "formatted_start": "03:46:41.500",
      "formatted_end": "03:46:42.500",
      "text": "آره"
    },
    {
      "id": 29,
      "start": 13602.5,
      "end": 13604.5,
      "formatted_start": "03:46:42.500",
      "formatted_end": "03:46:44.500",
      "text": "بله بله چند هشون"
    },
    {
      "id": 30,
      "start": 13604.5,
      "end": 13606.5,
      "formatted_start": "03:46:44.500",
      "formatted_end": "03:46:46.500",
      "text": "سربوکولی هم اگه می نمیسین ممنون میشون"
    },
    {
      "id": 31,
      "start": 13606.5,
      "end": 13610.5,
      "formatted_start": "03:46:46.500",
      "formatted_end": "03:46:50.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 32,
      "start": 13610.5,
      "end": 13614.5,
      "formatted_start": "03:46:50.500",
      "formatted_end": "03:46:54.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 33,
      "start": 13614.5,
      "end": 13618.5,
      "formatted_start": "03:46:54.500",
      "formatted_end": "03:46:58.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 34,
      "start": 13618.5,
      "end": 13622.5,
      "formatted_start": "03:46:58.500",
      "formatted_end": "03:47:02.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 35,
      "start": 13622.5,
      "end": 13626.5,
      "formatted_start": "03:47:02.500",
      "formatted_end": "03:47:06.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 36,
      "start": 13626.5,
      "end": 13630.5,
      "formatted_start": "03:47:06.500",
      "formatted_end": "03:47:10.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 37,
      "start": 13630.5,
      "end": 13634.5,
      "formatted_start": "03:47:10.500",
      "formatted_end": "03:47:14.500",
      "text": "از این روست هم نوشته باشید و باز را درست کنید"
    },
    {
      "id": 38,
      "start": 13634.5,
      "end": 13646.5,
      "formatted_start": "03:47:14.500",
      "formatted_end": "03:47:26.500",
      "text": "چند تا ماده غذایی، یکی آش ماش، نمک نرسید، بزارید ماشا باره بشند، ماش که باره بشه داروی ازش نرمید"
    },
    {
      "id": 39,
      "start": 13646.5,
      "end": 13655.5,
      "formatted_start": "03:47:26.500",
      "formatted_end": "03:47:35.500",
      "text": "کلیه فلمایی قرمز، آقا فز کنید، دوشم دارچین بزرگ، بزارید بخورمشید، بخورم"
    },
    {
      "id": 40,
      "start": 13655.5,
      "end": 13657.5,
      "formatted_start": "03:47:35.500",
      "formatted_end": "03:47:37.500",
      "text": "شرغم"
    },
    {
      "id": 41,
      "start": 13657.5,
      "end": 13661.5,
      "formatted_start": "03:47:37.500",
      "formatted_end": "03:47:41.500",
      "text": "شرغم هم بپزید"
    },
    {
      "id": 42,
      "start": 13661.5,
      "end": 13665.5,
      "formatted_start": "03:47:41.500",
      "formatted_end": "03:47:45.500",
      "text": "شیر و ماست و لبنی ها هیچی نخوانید"
    },
    {
      "id": 43,
      "start": 13665.5,
      "end": 13667.5,
      "formatted_start": "03:47:45.500",
      "formatted_end": "03:47:47.500",
      "text": "آشونید"
    },
    {
      "id": 44,
      "start": 13667.5,
      "end": 13671.5,
      "formatted_start": "03:47:47.500",
      "formatted_end": "03:47:51.500",
      "text": "و این ها برای بالا فرقوبه"
    },
    {
      "id": 45,
      "start": 13671.5,
      "end": 13675.5,
      "formatted_start": "03:47:51.500",
      "formatted_end": "03:47:55.500",
      "text": "سبزی گشنی است"
    },
    {
      "id": 46,
      "start": 13675.5,
      "end": 13679.5,
      "formatted_start": "03:47:55.500",
      "formatted_end": "03:47:59.500",
      "text": "در آش ریختشنند"
    },
    {
      "id": 47,
      "start": 13679.5,
      "end": 13683.5,
      "formatted_start": "03:47:59.500",
      "formatted_end": "03:48:03.500",
      "text": "در آش بود سبزی گشنی سطحا برسید"
    },
    {
      "id": 48,
      "start": 13683.5,
      "end": 13689.5,
      "formatted_start": "03:48:03.500",
      "formatted_end": "03:48:09.500",
      "text": "اینجور مدت درمانتون خیلی کتاه میکنید درواران چون میکنید امروز حالتون بهتر میشه شاید"
    },
    {
      "id": 49,
      "start": 13691.5,
      "end": 13700.5,
      "formatted_start": "03:48:11.500",
      "formatted_end": "03:48:20.500",
      "text": "برونو شما بین سخت کنید بگیرید شما علاق کنید نکلید سنگل و روسان و دردار و این محل مصنفه"
    },
    {
      "id": 50,
      "start": 13705.5,
      "end": 13712.5,
      "formatted_start": "03:48:25.500",
      "formatted_end": "03:48:32.500",
      "text": "ببینید اون جلی که گرفتید بسیار اینکنان این جل با دست همینجوری ها ببینید آروم آروم برده دارید"
    },
    {
      "id": 51,
      "start": 13713.5,
      "end": 13715.5,
      "formatted_start": "03:48:33.500",
      "formatted_end": "03:48:35.500",
      "text": "بعد توی دهن میدیم بخورم"
    },
    {
      "id": 52,
      "start": 13715.5,
      "end": 13718.5,
      "formatted_start": "03:48:35.500",
      "formatted_end": "03:48:38.500",
      "text": "از این اونجل رو بزرگ کنار فقط اینجل رو بزرگ"
    },
    {
      "id": 53,
      "start": 13718.5,
      "end": 13721.5,
      "formatted_start": "03:48:38.500",
      "formatted_end": "03:48:41.500",
      "text": "هر یک ساعت دو ساعت یک زرگ بزرگ هم"
    },
    {
      "id": 54,
      "start": 13721.5,
      "end": 13723.5,
      "formatted_start": "03:48:41.500",
      "formatted_end": "03:48:43.500",
      "text": "بمکین تو دهنت رو نگهتد"
    },
    {
      "id": 55,
      "start": 13723.5,
      "end": 13726.5,
      "formatted_start": "03:48:43.500",
      "formatted_end": "03:48:46.500",
      "text": "نگهتد اینو غورتش بگیر توف نکنید غورت رو نکنید"
    },
    {
      "id": 56,
      "start": 13726.5,
      "end": 13730.5,
      "formatted_start": "03:48:46.500",
      "formatted_end": "03:48:50.500",
      "text": "این کدره یه بستش رو باز میتونید"
    },
    {
      "id": 57,
      "start": 13730.5,
      "end": 13732.5,
      "formatted_start": "03:48:50.500",
      "formatted_end": "03:48:52.500",
      "text": "مثل چایی دم بیکنید"
    },
    {
      "id": 58,
      "start": 13732.5,
      "end": 13736.5,
      "formatted_start": "03:48:52.500",
      "formatted_end": "03:48:56.500",
      "text": "بعد یک ساعت مثلا یه مقدار توزش دم کشید"
    },
    {
      "id": 59,
      "start": 13736.5,
      "end": 13737.5,
      "formatted_start": "03:48:56.500",
      "formatted_end": "03:48:57.500",
      "text": "جای گرد باشید"
    },
    {
      "id": 60,
      "start": 13737.5,
      "end": 13740.5,
      "formatted_start": "03:48:57.500",
      "formatted_end": "03:49:00.500",
      "text": "با قاشون آروم آروم اینو غورت میدید"
    },
    {
      "id": 61,
      "start": 13740.5,
      "end": 13742.5,
      "formatted_start": "03:49:00.500",
      "formatted_end": "03:49:02.500",
      "text": "زخمه رو بوشش میده به آب داره"
    },
    {
      "id": 62,
      "start": 13742.5,
      "end": 13744.5,
      "formatted_start": "03:49:02.500",
      "formatted_end": "03:49:04.500",
      "text": "درسته"
    },
    {
      "id": 63,
      "start": 13744.5,
      "end": 13746.5,
      "formatted_start": "03:49:04.500",
      "formatted_end": "03:49:06.500",
      "text": "اینم دوباره"
    },
    {
      "id": 64,
      "start": 13746.5,
      "end": 13748.5,
      "formatted_start": "03:49:06.500",
      "formatted_end": "03:49:08.500",
      "text": "بعد دوتا شربت داره"
    },
    {
      "id": 65,
      "start": 13748.5,
      "end": 13750.5,
      "formatted_start": "03:49:08.500",
      "formatted_end": "03:49:10.500",
      "text": "این شربت ها رو از هر کدوم یه قاشق"
    },
    {
      "id": 66,
      "start": 13750.5,
      "end": 13752.5,
      "formatted_start": "03:49:10.500",
      "formatted_end": "03:49:12.500",
      "text": "میزارید دهن نگه میدارید"
    },
    {
      "id": 67,
      "start": 13752.5,
      "end": 13754.5,
      "formatted_start": "03:49:12.500",
      "formatted_end": "03:49:14.500",
      "text": "خسته شدید؟"
    },
    {
      "id": 68,
      "start": 13754.5,
      "end": 13756.5,
      "formatted_start": "03:49:14.500",
      "formatted_end": "03:49:16.500",
      "text": "نه خسته شد اقامه هایی"
    },
    {
      "id": 69,
      "start": 13756.5,
      "end": 13758.5,
      "formatted_start": "03:49:16.500",
      "formatted_end": "03:49:18.500",
      "text": "اوی جاله هایی هایی خودش میره تو هم"
    },
    {
      "id": 70,
      "start": 13758.5,
      "end": 13760.5,
      "formatted_start": "03:49:18.500",
      "formatted_end": "03:49:20.500",
      "text": "تو دهن نگه میداری و بعد پرتش میدی"
    },
    {
      "id": 71,
      "start": 13760.5,
      "end": 13762.5,
      "formatted_start": "03:49:20.500",
      "formatted_end": "03:49:22.500",
      "text": "هیچی توف کرده نیده داری"
    },
    {
      "id": 72,
      "start": 13762.5,
      "end": 13764.5,
      "formatted_start": "03:49:22.500",
      "formatted_end": "03:49:24.500",
      "text": "بله چشم"
    },
    {
      "id": 73,
      "start": 13764.5,
      "end": 13766.5,
      "formatted_start": "03:49:24.500",
      "formatted_end": "03:49:26.500",
      "text": "دوتا برس مکیدنی همین"
    },
    {
      "id": 74,
      "start": 13766.5,
      "end": 13768.5,
      "formatted_start": "03:49:26.500",
      "formatted_end": "03:49:28.500",
      "text": "الان میزارید رو زبانه"
    },
    {
      "id": 75,
      "start": 13768.5,
      "end": 13770.5,
      "formatted_start": "03:49:28.500",
      "formatted_end": "03:49:30.500",
      "text": "تا خانه برسی نصبش خوب شده بگیر"
    },
    {
      "id": 76,
      "start": 13770.5,
      "end": 13774.5,
      "formatted_start": "03:49:30.500",
      "formatted_end": "03:49:34.500",
      "text": "آها بذارو زبان با این شکالات"
    },
    {
      "id": 77,
      "start": 13774.5,
      "end": 13779.5,
      "formatted_start": "03:49:34.500",
      "formatted_end": "03:49:39.500",
      "text": "دوتاشونو باهم دیگه بخورو بمک"
    },
    {
      "id": 78,
      "start": 13779.5,
      "end": 13783.5,
      "formatted_start": "03:49:39.500",
      "formatted_end": "03:49:43.500",
      "text": "بگن گوشتونو بزنی میاد"
    },
    {
      "id": 79,
      "start": 13783.5,
      "end": 13787.5,
      "formatted_start": "03:49:43.500",
      "formatted_end": "03:49:47.500",
      "text": "بله دوتاشونو باهم صبح و شب بمک"
    },
    {
      "id": 80,
      "start": 13787.5,
      "end": 13790.5,
      "formatted_start": "03:49:47.500",
      "formatted_end": "03:49:50.500",
      "text": "الان تا خانه بریم بگی نصبش خوب شده"
    },
    {
      "id": 81,
      "start": 13790.5,
      "end": 13793.5,
      "formatted_start": "03:49:50.500",
      "formatted_end": "03:49:53.500",
      "text": "دیگه از اون آفتوژلینان نزدیک"
    },
    {
      "id": 82,
      "start": 13793.5,
      "end": 13795.5,
      "formatted_start": "03:49:53.500",
      "formatted_end": "03:49:55.500",
      "text": "اون خودش سوزانه ورده بگیر"
    },
    {
      "id": 83,
      "start": 13795.5,
      "end": 13798.4,
      "formatted_start": "03:49:55.500",
      "formatted_end": "03:49:58.400",
      "text": "اون برای آفتار دیگه ایست، برای این دوست"
    },
    {
      "id": 84,
      "start": 13798.4,
      "end": 13799.98,
      "formatted_start": "03:49:58.400",
      "formatted_end": "03:49:59.980",
      "text": "تو تمام"
    }
  ],
  "status": "completed"
}