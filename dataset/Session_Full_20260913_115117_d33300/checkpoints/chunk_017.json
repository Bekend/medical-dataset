  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5129.98,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 5130.0,
      "end": 5138.0,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:38.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 5160.0,
      "end": 5162.0,
      "formatted_start": "01:26:00.000",
      "formatted_end": "01:26:02.000",
      "text": "میاره فقط تو شارج باید"
    },
    {
      "id": 3,
      "start": 5162.0,
      "end": 5164.0,
      "formatted_start": "01:26:02.000",
      "formatted_end": "01:26:04.000",
      "text": "نه نه تو برق شارج ندارین"
    },
    {
      "id": 4,
      "start": 5164.0,
      "end": 5166.0,
      "formatted_start": "01:26:04.000",
      "formatted_end": "01:26:06.000",
      "text": "پلیز برق"
    },
    {
      "id": 5,
      "start": 5166.0,
      "end": 5168.0,
      "formatted_start": "01:26:06.000",
      "formatted_end": "01:26:08.000",
      "text": "آهان خیلی تو"
    },
    {
      "id": 6,
      "start": 5168.0,
      "end": 5170.0,
      "formatted_start": "01:26:08.000",
      "formatted_end": "01:26:10.000",
      "text": "پلیز برق فقط باشه همین"
    },
    {
      "id": 7,
      "start": 5170.0,
      "end": 5172.0,
      "formatted_start": "01:26:10.000",
      "formatted_end": "01:26:12.000",
      "text": "مرسی ممنونم دکتر جان سفاس گذارم"
    },
    {
      "id": 8,
      "start": 5172.0,
      "end": 5174.0,
      "formatted_start": "01:26:12.000",
      "formatted_end": "01:26:14.000",
      "text": "شبران کنم خدافز"
    },
    {
      "id": 9,
      "start": 5184.0,
      "end": 5186.0,
      "formatted_start": "01:26:24.000",
      "formatted_end": "01:26:26.000",
      "text": "خدافز خدم خانسامین خوبی؟"
    },
    {
      "id": 10,
      "start": 5186.0,
      "end": 5188.0,
      "formatted_start": "01:26:26.000",
      "formatted_end": "01:26:28.000",
      "text": "خانسامین اینو ببری"
    },
    {
      "id": 11,
      "start": 5188.0,
      "end": 5191.0,
      "formatted_start": "01:26:28.000",
      "formatted_end": "01:26:31.000",
      "text": "این موبایل شهابه"
    },
    {
      "id": 12,
      "start": 5191.0,
      "end": 5193.0,
      "formatted_start": "01:26:31.000",
      "formatted_end": "01:26:33.000",
      "text": "فقط بگیم به برق بزنه"
    },
    {
      "id": 13,
      "start": 5193.0,
      "end": 5195.0,
      "formatted_start": "01:26:33.000",
      "formatted_end": "01:26:35.000",
      "text": "یه تو اتاق دکتر تو برق باشه"
    },
    {
      "id": 14,
      "start": 5195.0,
      "end": 5197.0,
      "formatted_start": "01:26:35.000",
      "formatted_end": "01:26:37.000",
      "text": "از این وقت بس چیز کنیم؟"
    },
    {
      "id": 15,
      "start": 5197.0,
      "end": 5199.0,
      "formatted_start": "01:26:37.000",
      "formatted_end": "01:26:39.000",
      "text": "ببین بدم"
    },
    {
      "id": 16,
      "start": 5201.0,
      "end": 5203.0,
      "formatted_start": "01:26:41.000",
      "formatted_end": "01:26:43.000",
      "text": "بفهم"
    },
    {
      "id": 17,
      "start": 5203.0,
      "end": 5205.0,
      "formatted_start": "01:26:43.000",
      "formatted_end": "01:26:45.000",
      "text": "بله"
    },
    {
      "id": 18,
      "start": 5205.0,
      "end": 5207.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:47.000",
      "text": "سلام بفهم سریع تر"
    },
    {
      "id": 19,
      "start": 5207.0,
      "end": 5209.0,
      "formatted_start": "01:26:47.000",
      "formatted_end": "01:26:49.000",
      "text": "بله"
    },
    {
      "id": 20,
      "start": 5209.0,
      "end": 5211.0,
      "formatted_start": "01:26:49.000",
      "formatted_end": "01:26:51.000",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 5211.0,
      "end": 5216.0,
      "formatted_start": "01:26:51.000",
      "formatted_end": "01:26:56.000",
      "text": "ببین اینو وقتی زنگ میزنیم بگیم تودی و معارفه"
    },
    {
      "id": 22,
      "start": 5216.0,
      "end": 5229.58,
      "formatted_start": "01:26:56.000",
      "formatted_end": "01:27:09.580",
      "text": "ببینید خانم اتابای شما وقتی دوت میکنین بگین 26 جلسه تودی دکتر پاشایی و معرفه دکتر مسود جهانی"
    },
    {
      "id": 23,
      "start": 5229.58,
      "end": 5232.6,
      "formatted_start": "01:27:09.580",
      "formatted_end": "01:27:12.600",
      "text": "اینو الان به کسایی دیگه هم زنگ ددید"
    },
    {
      "id": 24,
      "start": 5232.6,
      "end": 5238.16,
      "formatted_start": "01:27:12.600",
      "formatted_end": "01:27:18.160",
      "text": "خیلی خوب تودی و معرفه این کلمه را استفاده کنید"
    },
    {
      "id": 25,
      "start": 5238.16,
      "end": 5239.62,
      "formatted_start": "01:27:18.160",
      "formatted_end": "01:27:19.620",
      "text": "مرسی ممنون خدافزی"
    },
    {
      "id": 26,
      "start": 5239.62,
      "end": 5241.62,
      "formatted_start": "01:27:19.620",
      "formatted_end": "01:27:21.620",
      "text": "خب"
    },
    {
      "id": 27,
      "start": 5245.62,
      "end": 5247.62,
      "formatted_start": "01:27:25.620",
      "formatted_end": "01:27:27.620",
      "text": "۴۹۳"
    },
    {
      "id": 28,
      "start": 5247.62,
      "end": 5249.62,
      "formatted_start": "01:27:27.620",
      "formatted_end": "01:27:29.620",
      "text": "خب خانساییدی"
    },
    {
      "id": 29,
      "start": 5249.62,
      "end": 5251.62,
      "formatted_start": "01:27:29.620",
      "formatted_end": "01:27:31.620",
      "text": "اینو الان بگذاریم"
    },
    {
      "id": 30,
      "start": 5251.62,
      "end": 5253.62,
      "formatted_start": "01:27:31.620",
      "formatted_end": "01:27:33.620",
      "text": "باشه"
    },
    {
      "id": 31,
      "start": 5253.62,
      "end": 5255.62,
      "formatted_start": "01:27:33.620",
      "formatted_end": "01:27:35.620",
      "text": "اینکه دو تمرین"
    },
    {
      "id": 32,
      "start": 5269.62,
      "end": 5275.32,
      "formatted_start": "01:27:49.620",
      "formatted_end": "01:27:55.320",
      "text": "آنکوی اومد بیرون فقط یه نفرتون برین داخل باشه"
    },
    {
      "id": 33,
      "start": 5275.32,
      "end": 5293.08,
      "formatted_start": "01:27:55.320",
      "formatted_end": "01:28:13.080",
      "text": "آوردویی به نام کی بود؟"
    },
    {
      "id": 34,
      "start": 5293.08,
      "end": 5293.68,
      "formatted_start": "01:28:13.080",
      "formatted_end": "01:28:13.680",
      "text": "آزرم"
    },
    {
      "id": 35,
      "start": 5293.68,
      "end": 5295.68,
      "formatted_start": "01:28:13.680",
      "formatted_end": "01:28:15.680",
      "text": "بابا بیا بیا"
    },
    {
      "id": 36,
      "start": 5295.68,
      "end": 5297.68,
      "formatted_start": "01:28:15.680",
      "formatted_end": "01:28:17.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 37,
      "start": 5297.68,
      "end": 5299.68,
      "formatted_start": "01:28:17.680",
      "formatted_end": "01:28:19.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 38,
      "start": 5299.68,
      "end": 5301.68,
      "formatted_start": "01:28:19.680",
      "formatted_end": "01:28:21.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 39,
      "start": 5301.68,
      "end": 5303.68,
      "formatted_start": "01:28:21.680",
      "formatted_end": "01:28:23.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 40,
      "start": 5303.68,
      "end": 5305.68,
      "formatted_start": "01:28:23.680",
      "formatted_end": "01:28:25.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 41,
      "start": 5305.68,
      "end": 5307.68,
      "formatted_start": "01:28:25.680",
      "formatted_end": "01:28:27.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 42,
      "start": 5307.68,
      "end": 5309.68,
      "formatted_start": "01:28:27.680",
      "formatted_end": "01:28:29.680",
      "text": "این بیشتر از این مدیره باید بردارید."
    },
    {
      "id": 43,
      "start": 5309.68,
      "end": 5311.68,
      "formatted_start": "01:28:29.680",
      "formatted_end": "01:28:31.680",
      "text": "خودش کجاست؟"
    },
    {
      "id": 44,
      "start": 5311.68,
      "end": 5313.68,
      "formatted_start": "01:28:31.680",
      "formatted_end": "01:28:33.680",
      "text": "آره"
    },
    {
      "id": 45,
      "start": 5327.68,
      "end": 5329.68,
      "formatted_start": "01:28:47.680",
      "formatted_end": "01:28:49.680",
      "text": "سلام"
    },
    {
      "id": 46,
      "start": 5329.68,
      "end": 5331.68,
      "formatted_start": "01:28:49.680",
      "formatted_end": "01:28:51.680",
      "text": "بالا میریم؟"
    },
    {
      "id": 47,
      "start": 5331.68,
      "end": 5333.68,
      "formatted_start": "01:28:51.680",
      "formatted_end": "01:28:53.680",
      "text": "تمقی چند؟"
    },
    {
      "id": 48,
      "start": 5333.68,
      "end": 5335.68,
      "formatted_start": "01:28:53.680",
      "formatted_end": "01:28:55.680",
