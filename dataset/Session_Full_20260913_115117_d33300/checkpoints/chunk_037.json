  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11110.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:10.000",
      "text": "اینجا. اونی میدونم چیه. بازنجه مورواریه. اگه میخوای سونورو با چیز آبجیت بزنن، شبیه تو هست."
    },
    {
      "id": 1,
      "start": 11110.0,
      "end": 11120.0,
      "formatted_start": "03:05:10.000",
      "formatted_end": "03:05:20.000",
      "text": "حالا همینجا آمدید من آبجیت بازنم. نه، چی اکسش شبیه باشه، چون اونجا میزنن اکسش بود. بگم همه شخصان به نام آبجیت بزنن. خانم مقدم بیا."
    },
    {
      "id": 2,
      "start": 11120.0,
      "end": 11150.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:50.000",
      "text": "مدت زیر از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 3,
      "start": 11150.0,
      "end": 11155.0,
      "formatted_start": "03:05:50.000",
      "formatted_end": "03:05:55.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 11180.0,
      "end": 11183.0,
      "formatted_start": "03:06:20.000",
      "formatted_end": "03:06:23.000",
      "text": "ادرار اصلا کنترل ندارم"
    },
    {
      "id": 5,
      "start": 11183.0,
      "end": 11185.0,
      "formatted_start": "03:06:23.000",
      "formatted_end": "03:06:25.000",
      "text": "خیلی هم ادرار زیاده"
    },
    {
      "id": 6,
      "start": 11185.0,
      "end": 11187.0,
      "formatted_start": "03:06:25.000",
      "formatted_end": "03:06:27.000",
      "text": "همیشه کنترل ندادی؟"
    },
    {
      "id": 7,
      "start": 11187.0,
      "end": 11189.0,
      "formatted_start": "03:06:27.000",
      "formatted_end": "03:06:29.000",
      "text": "آره زیاد"
    },
    {
      "id": 8,
      "start": 11189.0,
      "end": 11191.0,
      "formatted_start": "03:06:29.000",
      "formatted_end": "03:06:31.000",
      "text": "سونوگرافی چیزی نرفتی برای ادرار؟"
    },
    {
      "id": 9,
      "start": 11191.0,
      "end": 11193.0,
      "formatted_start": "03:06:31.000",
      "formatted_end": "03:06:33.000",
      "text": "نه"
    },
    {
      "id": 10,
      "start": 11193.0,
      "end": 11195.0,
      "formatted_start": "03:06:33.000",
      "formatted_end": "03:06:35.000",
      "text": "که رفتی؟"
    },
    {
      "id": 11,
      "start": 11195.0,
      "end": 11197.0,
      "formatted_start": "03:06:35.000",
      "formatted_end": "03:06:37.000",
      "text": "ایه نه"
    },
    {
      "id": 12,
      "start": 11197.0,
      "end": 11199.0,
      "formatted_start": "03:06:37.000",
      "formatted_end": "03:06:39.000",
      "text": "اصلا دکتر نرفتی برای کنترل ادرارتون؟"
    },
    {
      "id": 13,
      "start": 11199.0,
      "end": 11200.0,
      "formatted_start": "03:06:39.000",
      "formatted_end": "03:06:40.000",
      "text": "نه"
    },
    {
      "id": 14,
      "start": 11200.0,
      "end": 11202.0,
      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:42.000",
      "text": "این با صرفی میاد با خریدی؟"
    },
    {
      "id": 15,
      "start": 11202.0,
      "end": 11205.0,
      "formatted_start": "03:06:42.000",
      "formatted_end": "03:06:45.000",
      "text": "با همه چی؟ با همه چی؟ من راه برم هم"
    },
    {
      "id": 16,
      "start": 11205.0,
      "end": 11207.0,
      "formatted_start": "03:06:45.000",
      "formatted_end": "03:06:47.000",
      "text": "میاد؟ آره"
    },
    {
      "id": 17,
      "start": 11207.0,
      "end": 11209.6,
      "formatted_start": "03:06:47.000",
      "formatted_end": "03:06:49.600",
      "text": "مثلا دستشوی میده درسته من هیچی نخوردم"
    },
    {
      "id": 18,
      "start": 11209.6,
      "end": 11211.68,
      "formatted_start": "03:06:49.600",
      "formatted_end": "03:06:51.680",
      "text": "الان دیروز تو را بودی من هیچی نخوردم"
    },
    {
      "id": 19,
      "start": 11211.68,
      "end": 11213.64,
      "formatted_start": "03:06:51.680",
      "formatted_end": "03:06:53.640",
      "text": "از ترس که من باید دستشوی میگیرم"
    },
    {
      "id": 20,
      "start": 11213.64,
      "end": 11217.64,
      "formatted_start": "03:06:53.640",
      "formatted_end": "03:06:57.640",
      "text": "حتی تو مسیر طولانی حتی یک ساعته تو ماشین بشینم"
    },
    {
      "id": 21,
      "start": 11217.64,
      "end": 11218.4,
      "formatted_start": "03:06:57.640",
      "formatted_end": "03:06:58.400",
      "text": "من دستشوی میگیرم"
    },
    {
      "id": 22,
      "start": 11218.4,
      "end": 11219.66,
      "formatted_start": "03:06:58.400",
      "formatted_end": "03:06:59.660",
      "text": "میریزه یاده"
    },
    {
      "id": 23,
      "start": 11219.66,
      "end": 11220.86,
      "formatted_start": "03:06:59.660",
      "formatted_end": "03:07:00.860",
      "text": "آره میریزه"
    },
    {
      "id": 24,
      "start": 11220.86,
      "end": 11222.58,
      "formatted_start": "03:07:00.860",
      "formatted_end": "03:07:02.580",
      "text": "یعنی من توی خونم"
    },
    {
      "id": 25,
      "start": 11222.58,
      "end": 11224.02,
      "formatted_start": "03:07:02.580",
      "formatted_end": "03:07:04.020",
      "text": "کنیداری"
    },
    {
      "id": 26,
      "start": 11224.02,
      "end": 11228.1,
      "formatted_start": "03:07:04.020",
      "formatted_end": "03:07:08.100",
      "text": "نه ولی یکی اون دو نباس بشین"
    },
    {
      "id": 27,
      "start": 11228.1,
      "end": 11229.54,
      "formatted_start": "03:07:08.100",
      "formatted_end": "03:07:09.540",
      "text": "بس کمی"
    },
    {
      "id": 28,
      "start": 11229.54,
      "end": 11230.16,
      "formatted_start": "03:07:09.540",
      "formatted_end": "03:07:10.160",
      "text": "بله"
    },
    {
      "id": 29,
      "start": 11230.16,
      "end": 11233.04,
      "formatted_start": "03:07:10.160",
      "formatted_end": "03:07:13.040",
      "text": "چند تا بچه داری شما؟"
    },
    {
      "id": 30,
      "start": 11233.04,
      "end": 11233.46,
      "formatted_start": "03:07:13.040",
      "formatted_end": "03:07:13.460",
      "text": "دوتا"
    },
    {
      "id": 31,
      "start": 11237.0,
      "end": 11249.0,
      "formatted_start": "03:07:17.000",
      "formatted_end": "03:07:29.000",
      "text": "مهمه جان؟ نه نداشت."
    },
    {
      "id": 32,
      "start": 11249.0,
      "end": 11251.0,
      "formatted_start": "03:07:29.000",
      "formatted_end": "03:07:31.000",
      "text": "خیلی مهمه بیار تا اینجا برون."
    },
    {
      "id": 33,
      "start": 11251.0,
      "end": 11253.0,
      "formatted_start": "03:07:31.000",
      "formatted_end": "03:07:33.000",
      "text": "تا بسمت شهر مراهی بیار."
    },
    {
      "id": 34,
      "start": 11253.0,
      "end": 11255.0,
      "formatted_start": "03:07:33.000",
      "formatted_end": "03:07:35.000",
      "text": "بسمت جنگ سوری برون."
    },
    {
      "id": 35,
      "start": 11255.0,
      "end": 11257.0,
      "formatted_start": "03:07:35.000",
      "formatted_end": "03:07:37.000",
      "text": "بسیار."
    },
    {
      "id": 36,
      "start": 11257.0,
      "end": 11259.0,
      "formatted_start": "03:07:37.000",
      "formatted_end": "03:07:39.000",
      "text": "بسیار."
    },
    {
      "id": 37,
      "start": 11259.0,
      "end": 11261.0,
      "formatted_start": "03:07:39.000",
      "formatted_end": "03:07:41.000",
      "text": "بگیرم به زمان بگو هم."
    },
    {
      "id": 38,
      "start": 11261.0,
      "end": 11263.0,
      "formatted_start": "03:07:41.000",
      "formatted_end": "03:07:43.000",
      "text": "بگیرم به زمان بگو هم."
    },
    {
      "id": 39,
      "start": 11263.0,
      "end": 11265.0,
      "formatted_start": "03:07:43.000",
      "formatted_end": "03:07:45.000",
      "text": "بگیرم به زمان بگو هم."
    },
    {
      "id": 40,
      "start": 11265.0,
      "end": 11269.0,
      "formatted_start": "03:07:45.000",
      "formatted_end": "03:07:49.000",
      "text": "این برات بکشید، زیاد بکشید، مشروع صافت شده"
    },
    {
      "id": 41,
      "start": 11269.0,
      "end": 11274.0,
      "formatted_start": "03:07:49.000",
      "formatted_end": "03:07:54.000",
      "text": "خب اینکه، ازش را، بسط را بکشید"
    },
    {
      "id": 42,
      "start": 11278.0,
      "end": 11281.0,
      "formatted_start": "03:07:58.000",
      "formatted_end": "03:08:01.000",
      "text": "گفتی درد نزدیکی بیشتر اینجا میافته"
    },
    {
      "id": 43,
      "start": 11281.0,
      "end": 11284.0,
      "formatted_start": "03:08:01.000",
      "formatted_end": "03:08:04.000",
      "text": "آره، الان دهرانت عادی همونجا درد"
    },
    {
      "id": 44,
      "start": 11284.0,
      "end": 11287.0,
      "formatted_start": "03:08:04.000",
      "formatted_end": "03:08:07.000",
      "text": "چیش شد؟ دیگه نمیشه"
    },
    {
      "id": 45,
      "start": 11287.0,
      "end": 11292.0,
      "formatted_start": "03:08:07.000",
      "formatted_end": "03:08:12.000",
      "text": "این همون آماده آیده از روابط، چه حد این را بس باز دارم؟"
    },
    {
      "id": 46,
      "start": 11292.0,
      "end": 11296.0,
      "formatted_start": "03:08:12.000",
      "formatted_end": "03:08:16.000",
      "text": "شوهرت وضعفت و رایت می کنه یا نه؟"
    },
    {
      "id": 47,
      "start": 11296.0,
      "end": 11299.0,
      "formatted_start": "03:08:16.000",
      "formatted_end": "03:08:19.000",
      "text": "از وقتی نزدیک آب دهان نمیزنه به خودش؟"
    },
    {
      "id": 48,
      "start": 11299.0,
      "end": 11302.0,
      "formatted_start": "03:08:19.000",
      "formatted_end": "03:08:22.000",
      "text": "چنین روی من رو رو می کنم"
    },
    {
      "id": 49,
      "start": 11302.0,
      "end": 11304.0,
      "formatted_start": "03:08:22.000",
      "formatted_end": "03:08:24.000",
      "text": "به خودش آب دهان بزنه نزدیکی کنه؟"
    },
    {
      "id": 50,
      "start": 11304.0,
      "end": 11306.0,
      "formatted_start": "03:08:24.000",
      "formatted_end": "03:08:26.000",
      "text": "نه، نزدیک کارا نمی کنه"
    },
    {
      "id": 51,
      "start": 11306.0,
      "end": 11307.0,
      "formatted_start": "03:08:26.000",
      "formatted_end": "03:08:27.000",
      "text": "شوستشون چی؟"
    },
    {
      "id": 52,
      "start": 11307.0,
      "end": 11311.0,
      "formatted_start": "03:08:27.000",
      "formatted_end": "03:08:31.000",
      "text": "خیلی عصور ده، همه هم که مارم تمنیره"
    },
    {
      "id": 53,
      "start": 11311.0,
      "end": 11312.0,
      "formatted_start": "03:08:31.000",
      "formatted_end": "03:08:32.000",
      "text": "نه، بخواد نزدیکی کنه"
    },
    {
      "id": 54,
      "start": 11312.0,
      "end": 11316.0,
      "formatted_start": "03:08:32.000",
      "formatted_end": "03:08:36.000",
      "text": "ولی من حس داردم که اون هم یه مقدار خارش داره"
    },
    {
      "id": 55,
      "start": 11316.0,
      "end": 11317.0,
      "formatted_start": "03:08:36.000",
      "formatted_end": "03:08:37.000",
      "text": "آه"
    },
    {
      "id": 56,
      "start": 11317.0,
      "end": 11321.0,
      "formatted_start": "03:08:37.000",
      "formatted_end": "03:08:41.000",
      "text": "ولی مثلا زیاد توجه نمی کنه، من متوجه شدم"
    },
    {
      "id": 57,
      "start": 11321.0,
      "end": 11329.88,
      "formatted_start": "03:08:41.000",
      "formatted_end": "03:08:49.880",
      "text": "این دفعه متوجه شدم چون از خودم خیلی شدید بود متوجه شدم اونم انجویه ولی مثلا نمیدونه که باید"
    },
    {
      "id": 58,
      "start": 11329.88,
      "end": 11330.9,
      "formatted_start": "03:08:49.880",
      "formatted_end": "03:08:50.900",
      "text": "باید کشترک هم دیگه"
    },
    {
      "id": 59,
      "start": 11330.9,
      "end": 11334.46,
      "formatted_start": "03:08:50.900",
      "formatted_end": "03:08:54.460",
      "text": "آره باید مثلا دکتر بریاد و آبو بخوره"
    },
    {
      "id": 60,
      "start": 11334.46,
      "end": 11343.02,
      "formatted_start": "03:08:54.460",
      "formatted_end": "03:09:03.020",
      "text": "بعد این که مثلا میگم یه افراد که مثلا افراد داشته باشه خونت بیاد تو میگیری این درسته؟"
    },
    {
      "id": 61,
      "start": 11343.02,
      "end": 11348.66,
      "formatted_start": "03:09:03.020",
      "formatted_end": "03:09:08.660",
      "text": "خارش هاره مثلا مثل گال و این ها باشه آره ولی مطمئن زنانه نه"
    },
    {
      "id": 62,
      "start": 11348.66,
      "end": 11349.58,
      "formatted_start": "03:09:08.660",
      "formatted_end": "03:09:09.580",
      "text": "زنانه باشه"
    },
    {
      "id": 63,
      "start": 11349.58,
      "end": 11350.4,
      "formatted_start": "03:09:09.580",
      "formatted_end": "03:09:10.400",
      "text": "نه"
    },
    {
      "id": 64,
      "start": 11350.4,
      "end": 11356.4,
      "formatted_start": "03:09:10.400",
      "formatted_end": "03:09:16.400",
      "text": "مثلا من خیلی رفته آمد بودی مدت بعد من خیلی شدید شد و بودم"
    },
    {
      "id": 65,
      "start": 11356.4,
      "end": 11361.4,
      "formatted_start": "03:09:16.400",
      "formatted_end": "03:09:21.400",
      "text": "یا گفتن آبو اگه با فشار مثلا خودتو بشوریم"
    },
    {
      "id": 66,
      "start": 11361.4,
      "end": 11366.4,
      "formatted_start": "03:09:21.400",
      "formatted_end": "03:09:26.400",
      "text": "یا آب خود مثلا آدم فرزا باشه یا هر یکی"
    },
    {
      "id": 67,
      "start": 11366.4,
      "end": 11368.4,
      "formatted_start": "03:09:26.400",
      "formatted_end": "03:09:28.400",
      "text": "آبش خیلی تیز تیز است ماندن"
    },
    {
      "id": 68,
      "start": 11368.4,
      "end": 11369.4,
      "formatted_start": "03:09:28.400",
      "formatted_end": "03:09:29.400",
      "text": "آروندگی داره"
    },
    {
      "id": 69,
      "start": 11369.4,
      "end": 11370.4,
      "formatted_start": "03:09:29.400",
      "formatted_end": "03:09:30.400",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 11370.4,
      "end": 11372.4,
      "formatted_start": "03:09:30.400",
      "formatted_end": "03:09:32.400",
      "text": "بعد می گفتن همون خودش باعث آروندگی شد"
    },
    {
      "id": 71,
      "start": 11372.4,
      "end": 11373.4,
      "formatted_start": "03:09:32.400",
      "formatted_end": "03:09:33.400",
      "text": "تا که اینجا هستی؟"
    },
    {
      "id": 72,
      "start": 11373.4,
      "end": 11374.4,
      "formatted_start": "03:09:33.400",
      "formatted_end": "03:09:34.400",
      "text": "فردا"
    },
    {
      "id": 73,
      "start": 11374.4,
      "end": 11375.4,
      "formatted_start": "03:09:34.400",
      "formatted_end": "03:09:35.400",
      "text": "فردا؟"
    },
    {
      "id": 74,
      "start": 11375.4,
      "end": 11376.4,
      "formatted_start": "03:09:35.400",
      "formatted_end": "03:09:36.400",
      "text": "مردم؟"
    },
    {
      "id": 75,
      "start": 11376.4,
      "end": 11380.4,
      "formatted_start": "03:09:36.400",
      "formatted_end": "03:09:40.400",
      "text": "آهالا فردا که خوب نمیشه ولی از فردا بهتر میشیم"
    },
    {
      "id": 76,
      "start": 11380.4,
      "end": 11383.4,
      "formatted_start": "03:09:40.400",
      "formatted_end": "03:09:43.400",
      "text": "یک هفته که دارون استفاده کردی خیلی خوب میشیم"
    },
    {
      "id": 77,
      "start": 11383.4,
      "end": 11389.4,
      "formatted_start": "03:09:43.400",
      "formatted_end": "03:09:49.400",
      "text": "خب، بعد این نسخه رو، عکسش رو شما به نیرداشته باش"
    },
    {
      "id": 78,
      "start": 11389.4,
      "end": 11393.4,
      "formatted_start": "03:09:49.400",
      "formatted_end": "03:09:53.400",
      "text": "یک هفته دیگه شما بیا از طرف یه شماره بینید"
    },
    {
      "id": 79,
      "start": 11393.4,
      "end": 11396.4,
      "formatted_start": "03:09:53.400",
      "formatted_end": "03:09:56.400",
      "text": "زنگ بزنید بهش، این نسخه رو من نشان بدم"
    },
    {
      "id": 80,
      "start": 11396.4,
      "end": 11399.4,
      "formatted_start": "03:09:56.400",
      "formatted_end": "03:09:59.400",
      "text": "ببینیم که چیا خوب شده، چیا خوب نشد"
    }
  ],
  "status": "completed"
}