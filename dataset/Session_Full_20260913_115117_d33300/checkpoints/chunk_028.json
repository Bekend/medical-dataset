    },
    {
      "id": 9,
      "start": 8418.0,
      "end": 8420.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:20.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 10,
      "start": 8420.0,
      "end": 8422.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:22.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 11,
      "start": 8422.0,
      "end": 8424.0,
      "formatted_start": "02:20:22.000",
      "formatted_end": "02:20:24.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 12,
      "start": 8424.0,
      "end": 8426.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:26.000",
      "text": "اینجا باید برداریم."
    },
    {
      "id": 13,
      "start": 8426.0,
      "end": 8455.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:55.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 8456.0,
      "end": 8458.0,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:20:58.000",
      "text": "اصابه شده"
    },
    {
      "id": 15,
      "start": 8458.0,
      "end": 8462.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:02.000",
      "text": "یک قرص هم داره که یک روز در می آمی کنی"
    },
    {
      "id": 16,
      "start": 8486.0,
      "end": 8489.0,
      "formatted_start": "02:21:26.000",
      "formatted_end": "02:21:29.000",
      "text": "اوشان سه دیهه"
    },
    {
      "id": 17,
      "start": 8492.0,
      "end": 8494.0,
      "formatted_start": "02:21:32.000",
      "formatted_end": "02:21:34.000",
      "text": "آلرهی بیزنیم"
    },
    {
      "id": 18,
      "start": 8495.0,
      "end": 8496.0,
      "formatted_start": "02:21:35.000",
      "formatted_end": "02:21:36.000",
      "text": "اوشان زنیم"
    },
    {
      "id": 19,
      "start": 8496.0,
      "end": 8498.0,
      "formatted_start": "02:21:36.000",
      "formatted_end": "02:21:38.000",
      "text": "دو بین نفر ارزونی"
    },
    {
      "id": 20,
      "start": 8498.0,
      "end": 8502.0,
      "formatted_start": "02:21:38.000",
      "formatted_end": "02:21:42.000",
      "text": "و شمینده غیر از این چی بیزنیم؟"
    },
    {
      "id": 21,
      "start": 8502.0,
      "end": 8504.0,
      "formatted_start": "02:21:42.000",
      "formatted_end": "02:21:44.000",
      "text": "سابونه مخصوصا بیزنیم"
    },
    {
      "id": 22,
      "start": 8504.0,
      "end": 8505.0,
      "formatted_start": "02:21:44.000",
      "formatted_end": "02:21:45.000",
      "text": "دو بین نفر ارزونی"
    },
    {
      "id": 23,
      "start": 8505.0,
      "end": 8507.0,
      "formatted_start": "02:21:45.000",
      "formatted_end": "02:21:47.000",
      "text": "اوشان سه دیهه"
    },
    {
      "id": 24,
      "start": 8507.0,
      "end": 8509.0,
      "formatted_start": "02:21:47.000",
      "formatted_end": "02:21:49.000",
      "text": "سه بین نفر ارزونی"
    },
    {
      "id": 25,
      "start": 8509.0,
      "end": 8512.0,
      "formatted_start": "02:21:49.000",
      "formatted_end": "02:21:52.000",
      "text": "برای اینکه نکته باش دارم با اون میتر نکته با آره ببین"
    },
    {
      "id": 26,
      "start": 8512.0,
      "end": 8514.0,
      "formatted_start": "02:21:52.000",
      "formatted_end": "02:21:54.000",
      "text": "برای اینکه نکته باش دارم ببین"
    },
    {
      "id": 27,
      "start": 8514.0,
      "end": 8516.0,
      "formatted_start": "02:21:54.000",
      "formatted_end": "02:21:56.000",
      "text": "پر این جشن کنیم نرم بودم"
    },
    {
      "id": 28,
      "start": 8516.0,
      "end": 8517.0,
      "formatted_start": "02:21:56.000",
      "formatted_end": "02:21:57.000",
      "text": "جشن؟"
    },
    {
      "id": 29,
      "start": 8517.0,
      "end": 8518.0,
      "formatted_start": "02:21:57.000",
      "formatted_end": "02:21:58.000",
      "text": "پر این جشن کنیم"
    },
    {
      "id": 30,
      "start": 8518.0,
      "end": 8527.0,
      "formatted_start": "02:21:58.000",
      "formatted_end": "02:22:07.000",
      "text": "یه دونه فقط برشن کنم، یه دوتا جلدی برشن و یه دونه زده لکم"
    },
    {
      "id": 31,
      "start": 8527.0,
      "end": 8529.0,
      "formatted_start": "02:22:07.000",
      "formatted_end": "02:22:09.000",
      "text": "قیمتش هم زیادی است"
    },
    {
      "id": 32,
      "start": 8533.0,
      "end": 8534.0,
      "formatted_start": "02:22:13.000",
      "formatted_end": "02:22:14.000",
      "text": "پارت داری؟"
    },
    {
      "id": 33,
      "start": 8534.0,
      "end": 8535.0,
      "formatted_start": "02:22:14.000",
      "formatted_end": "02:22:15.000",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 8535.0,
      "end": 8536.0,
      "formatted_start": "02:22:15.000",
      "formatted_end": "02:22:16.000",
      "text": "بدون بگیر شما"
    },
    {
      "id": 35,
      "start": 8544.0,
      "end": 8546.0,
      "formatted_start": "02:22:24.000",
      "formatted_end": "02:22:26.000",
      "text": "همچنین"
    },
    {
      "id": 36,
      "start": 8548.0,
      "end": 8549.0,
      "formatted_start": "02:22:28.000",
      "formatted_end": "02:22:29.000",
      "text": "کمزه اش؟"
    },
    {
      "id": 37,
      "start": 8549.0,
      "end": 8550.0,
      "formatted_start": "02:22:29.000",
      "formatted_end": "02:22:30.000",
      "text": "سی و هفت منجمه"
    },
    {
      "id": 38,
      "start": 8550.0,
      "end": 8551.0,
      "formatted_start": "02:22:30.000",
      "formatted_end": "02:22:31.000",
      "text": "پنجه ها؟"
    },
    {
      "id": 39,
      "start": 8551.0,
      "end": 8552.0,
      "formatted_start": "02:22:31.000",
      "formatted_end": "02:22:32.000",
      "text": "یک"
    },
    {
      "id": 40,
      "start": 8554.0,
      "end": 8556.0,
      "formatted_start": "02:22:34.000",
      "formatted_end": "02:22:36.000",
      "text": "شاحت شب همین بیزنه"
    },
    {
      "id": 41,
      "start": 8556.0,
      "end": 8558.0,
      "formatted_start": "02:22:36.000",
      "formatted_end": "02:22:38.000",
      "text": "دورهای قبلی به جلو خودش، آره"
    },
    {
      "id": 42,
      "start": 8558.0,
      "end": 8564.0,
      "formatted_start": "02:22:38.000",
      "formatted_end": "02:22:44.000",
      "text": "دو تا جلو، یه قطره جلو اضافه کردن به این درمان برای نکه ها"
    },
    {
      "id": 43,
      "start": 8564.0,
      "end": 8567.0,
      "formatted_start": "02:22:44.000",
      "formatted_end": "02:22:47.000",
      "text": "و جوش های جدید، اونم مخصوص درکه"
    },
    {
      "id": 44,
      "start": 8567.0,
      "end": 8571.0,
      "formatted_start": "02:22:47.000",
      "formatted_end": "02:22:51.000",
      "text": "شب، این شب، اونو هم روزی دو بارم با هم بازیم"
    },
    {
      "id": 45,
      "start": 8571.0,
      "end": 8573.0,
      "formatted_start": "02:22:51.000",
      "formatted_end": "02:22:53.000",
      "text": "اما"
    },
    {
      "id": 46,
      "start": 8573.0,
      "end": 8575.0,
      "formatted_start": "02:22:53.000",
      "formatted_end": "02:22:55.000",
      "text": "از همه اینکه"
    },
    {
      "id": 47,
      "start": 8575.0,
      "end": 8577.0,
