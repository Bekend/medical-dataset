  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4218.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:18.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 4230.0,
      "end": 4239.64,
      "formatted_start": "01:10:30.000",
      "formatted_end": "01:10:39.640",
      "text": "این نگاهی داشته باشیم به عربی و دوستان مخابر از اون هم نگاهی داشته باشیم به تحقیق ها و حواظه ای خدمتان سیاسی و رسیانه یک پشت برم و خواهدید که همه هم با هم باشیم"
    },
    {
      "id": 2,
      "start": 4239.64,
      "end": 4255.5,
      "formatted_start": "01:10:39.640",
      "formatted_end": "01:10:55.500",
      "text": "امان این روز رمز بشه ای از پیان سیاسی یک تقریب"
    },
    {
      "id": 3,
      "start": 4255.5,
      "end": 4257.4,
      "formatted_start": "01:10:55.500",
      "formatted_end": "01:10:57.400",
      "text": "اقتلاعات"
    },
    {
      "id": 4,
      "start": 4257.4,
      "end": 4259.58,
      "formatted_start": "01:10:57.400",
      "formatted_end": "01:10:59.580",
      "text": "بنزین گران می شود یا نمی شود"
    },
    {
      "id": 5,
      "start": 4259.58,
      "end": 4263.04,
      "formatted_start": "01:10:59.580",
      "formatted_end": "01:11:03.040",
      "text": "توقف گرانی نادهانی بنزین توسط سران خوده"
    },
    {
      "id": 6,
      "start": 4263.04,
      "end": 4264.88,
      "formatted_start": "01:11:03.040",
      "formatted_end": "01:11:04.880",
      "text": "اعتماد"
    },
    {
      "id": 7,
      "start": 4264.88,
      "end": 4267.16,
      "formatted_start": "01:11:04.880",
      "formatted_end": "01:11:07.160",
      "text": "شکار انتیونوخای امریکا"
    },
    {
      "id": 8,
      "start": 4267.16,
      "end": 4270.42,
      "formatted_start": "01:11:07.160",
      "formatted_end": "01:11:10.420",
      "text": "رساملی باشنگوندوست به نقل از نقامات امریکایی پاش کرده"
    },
    {
      "id": 9,
      "start": 4270.42,
      "end": 4272.7,
      "formatted_start": "01:11:10.420",
      "formatted_end": "01:11:12.700",
      "text": "افتش این کشور در جنگ ایران"
    },
    {
      "id": 10,
      "start": 4272.7,
      "end": 4275.6,
      "formatted_start": "01:11:12.700",
      "formatted_end": "01:11:15.600",
      "text": "45% فخورت مادری 25%"
    },
    {
      "id": 11,
      "start": 4275.6,
      "end": 4279.58,
      "formatted_start": "01:11:15.600",
      "formatted_end": "01:11:19.580",
      "text": "برگ ناربان فخورت های 50 ملیون دولاری شد"
    },
    {
      "id": 12,
      "start": 4279.58,
      "end": 4280.66,
      "formatted_start": "01:11:19.580",
      "formatted_end": "01:11:20.660",
      "text": "از دست داره"
    },
    {
      "id": 13,
      "start": 4285.5,
      "end": 4294.5,
      "formatted_start": "01:11:25.500",
      "formatted_end": "01:11:34.500",
      "text": "درست دارید ایران تغییر در دکتورین دفاعی ایران از بازدارندگی دفاعی تا بازدارندگی تقاجدی"
    },
    {
      "id": 14,
      "start": 4294.5,
      "end": 4299.5,
      "formatted_start": "01:11:34.500",
      "formatted_end": "01:11:39.500",
      "text": "پدام اصلی انتصاد اخیر شش فرمانده جدید و نسان"
    },
    {
      "id": 15,
      "start": 4299.5,
      "end": 4302.5,
      "formatted_start": "01:11:39.500",
      "formatted_end": "01:11:42.500",
      "text": "جامعه چند"
    },
    {
      "id": 16,
      "start": 4302.5,
      "end": 4312.5,
      "formatted_start": "01:11:42.500",
      "formatted_end": "01:11:52.500",
      "text": "گرفشش جوانان ایرانی در بردشت و دانش ایران این سال تا پنون دانش آموزان ایرانی 13 مدار صدران اولمپیوکل جهانی کسک کردن"
    },
    {
      "id": 17,
      "start": 4312.5,
      "end": 4317.5,
      "formatted_start": "01:11:52.500",
      "formatted_end": "01:11:57.500",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 4342.5,
      "end": 4372.5,
      "formatted_start": "01:12:22.500",
      "formatted_end": "01:12:52.500",
      "text": "از اینجا با ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی از ازدنی ازدنی از ازدنی ازدنی از ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازدنی ازد"
    },
    {
      "id": 19,
      "start": 4372.5,
      "end": 4380.5,
      "formatted_start": "01:12:52.500",
      "formatted_end": "01:13:00.500",
      "text": "امریکا برای بروج از باستان جنگ شارعی جز فضیلش برخوردنی ایوان و شرطان ایلیسی جهان ندارد."
    },
    {
      "id": 20,
      "start": 4380.5,
      "end": 4392.5,
      "formatted_start": "01:13:00.500",
      "formatted_end": "01:13:12.500",
      "text": "بزرگ شرط ادخان رزید شرط پسید سیاست بزاری که نادرست اقتصادی و شارع شدنار فرضی سطح را درسیب کنید."
    },
    {
      "id": 21,
      "start": 4392.5,
      "end": 4402.88,
      "formatted_start": "01:13:12.500",
      "formatted_end": "01:13:22.880",
      "text": "سوکنون، سی ست هزار نفرانی پس از خواهدت استان آباد به خانه خود گازدشتنده"
    },
    {
      "id": 22,
      "start": 4402.88,
      "end": 4407.36,
      "formatted_start": "01:13:22.880",
      "formatted_end": "01:13:27.360",
      "text": "از شیوانیان اتقار آباد در برابر ناچارها"
    },
    {
      "id": 23,
      "start": 4407.36,
      "end": 4412.68,
      "formatted_start": "01:13:27.360",
      "formatted_end": "01:13:32.680",
      "text": "بردیفگان، دولت عزیزم دلت کن"
    },
    {
      "id": 24,
      "start": 4412.68,
      "end": 4416.22,
      "formatted_start": "01:13:32.680",
      "formatted_end": "01:13:36.220",
      "text": "سماریه های پیش روی مدیریت دنزین چی میست"
    },
    {
      "id": 25,
      "start": 4416.22,
      "end": 4420.5,
      "formatted_start": "01:13:36.220",
      "formatted_end": "01:13:40.500",
      "text": "و دولت بگه چی زرافت ها اینجا در اجاره آید کنن؟"
    },
    {
      "id": 26,
      "start": 4422.5,
      "end": 4427.5,
      "formatted_start": "01:13:42.500",
      "formatted_end": "01:13:47.500",
      "text": "چیخان، جای خالی تدبیر در مدیریت مصرف صفت"
    },
    {
      "id": 27,
      "start": 4427.5,
      "end": 4432.5,
      "formatted_start": "01:13:47.500",
      "formatted_end": "01:13:52.500",
      "text": "اده ای با وجود ارائه راقابات غیر قیمتی مختلف برای کانش مصرف لزین"
    },
    {
      "id": 28,
      "start": 4432.5,
      "end": 4435.5,
      "formatted_start": "01:13:52.500",
      "formatted_end": "01:13:55.500",
      "text": "همچنان بر راقابات قیمتی اصطادارند"
    },
    {
      "id": 29,
      "start": 4443.5,
      "end": 4444.5,
      "formatted_start": "01:14:03.500",
      "formatted_end": "01:14:04.500",
      "text": "بله"
    },
    {
      "id": 30,
      "start": 4445.5,
      "end": 4446.5,
      "formatted_start": "01:14:05.500",
      "formatted_end": "01:14:06.500",
      "text": "الو؟"
    },
    {
      "id": 31,
      "start": 4446.5,
      "end": 4447.5,
      "formatted_start": "01:14:06.500",
      "formatted_end": "01:14:07.500",
      "text": "بله، سلام خوامسه"
    },
    {
      "id": 32,
      "start": 4447.5,
      "end": 4449.5,
      "formatted_start": "01:14:07.500",
      "formatted_end": "01:14:09.500",
      "text": "سلام علیکم، هستم از بی آوروز"
    },
    {
      "id": 33,
      "start": 4449.5,
      "end": 4451.5,
      "formatted_start": "01:14:09.500",
      "formatted_end": "01:14:11.500",
      "text": "برابر میگم که..."
    },
    {
      "id": 34,
      "start": 4451.5,
      "end": 4453.5,
      "formatted_start": "01:14:11.500",
      "formatted_end": "01:14:13.500",
      "text": "برچشم هستم"
    },
    {
      "id": 35,
      "start": 4453.5,
      "end": 4455.5,
      "formatted_start": "01:14:13.500",
      "formatted_end": "01:14:15.500",
      "text": "آه باش"
    },
    {
      "id": 36,
      "start": 4479.5,
      "end": 4483.9,
      "formatted_start": "01:14:39.500",
      "formatted_end": "01:14:43.900",
      "text": "برای روزامه همشهری مثل سگ می ترستد"
    },
    {
      "id": 37,
      "start": 4483.9,
      "end": 4493.56,
      "formatted_start": "01:14:43.900",
      "formatted_end": "01:14:53.560",
      "text": "ماجرات فران رئیس جمهور امریکا با قدرون حمل غذا همچنان یکی از اصلیترین سوژه های تنظ و تنظفر کاربران شرکه های اجتماعیست"
    },
    {
      "id": 38,
      "start": 4493.56,
      "end": 4497.56,
      "formatted_start": "01:14:53.560",
      "formatted_end": "01:14:57.560",
      "text": "و به رسوائی تازه برای ترانک تبیر شده است"
    }
  ],
  "status": "completed"
}