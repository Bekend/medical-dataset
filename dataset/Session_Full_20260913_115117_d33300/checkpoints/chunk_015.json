  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4510.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:10.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 4530.0,
      "end": 4533.28,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:33.280",
      "text": "به سمت همدرائی های جهین سرداده"
    },
    {
      "id": 2,
      "start": 4533.28,
      "end": 4535.16,
      "formatted_start": "01:15:33.280",
      "formatted_end": "01:15:35.160",
      "text": "در وقت شهر این یاد داشت این قرار"
    },
    {
      "id": 3,
      "start": 4535.16,
      "end": 4539.84,
      "formatted_start": "01:15:35.160",
      "formatted_end": "01:15:39.840",
      "text": "جهان بروت که نهای اخیر از زمین جنگ امریکا و اسرائیل یعنی ایران"
    },
    {
      "id": 4,
      "start": 4539.84,
      "end": 4543.7,
      "formatted_start": "01:15:39.840",
      "formatted_end": "01:15:43.700",
      "text": "حقیقی متقابل ایران به پاییگاه ها و مناطق ایرانی در منطقه"
    },
    {
      "id": 5,
      "start": 4543.7,
      "end": 4548.52,
      "formatted_start": "01:15:43.700",
      "formatted_end": "01:15:48.520",
      "text": "و تا کشت کارامکی که ایدارات مطلقه در مدار مطلقه دیدن"
    },
    {
      "id": 6,
      "start": 4548.52,
      "end": 4555.74,
      "formatted_start": "01:15:48.520",
      "formatted_end": "01:15:55.740",
      "text": "کشت همه کلیبی منطقه را به ایداراتی نسبت ایرانی و سمت ایرانی سرداده"
    },
    {
      "id": 7,
      "start": 4555.74,
      "end": 4563.38,
      "formatted_start": "01:15:55.740",
      "formatted_end": "01:16:03.380",
      "text": "در بلکه ارضیابی قانون ناظران این پیمان را ناشید از اعتقادی به چطر عملیتی به ایالات متحده می دانند"
    },
    {
      "id": 8,
      "start": 4563.38,
      "end": 4571.36,
      "formatted_start": "01:16:03.380",
      "formatted_end": "01:16:11.360",
      "text": "و از تدیدگران قانون ناظران را همسو با حالت ایالات متحده برابر تقسیم بار نفای منطقه یه قیامت می کنند"
    },
    {
      "id": 9,
      "start": 4571.36,
      "end": 4579.58,
      "formatted_start": "01:16:11.360",
      "formatted_end": "01:16:19.580",
      "text": "جایی که قدرت بلی مهدی و از اون یک بازدارندگی یا که باشی کن بست دارند از اون پاس حد به نظر کنند و رو به بیدار کنند"
    },
    {
      "id": 10,
      "start": 4579.58,
      "end": 4590.32,
      "formatted_start": "01:16:19.580",
      "formatted_end": "01:16:30.320",
      "text": "در رسوی تعدیل حساسیت رو به دیدم بودن هیچ کنم از این سه کشور اینکه اینا را ضد اسرائیلی، ضد ایرانی یا ضد امریکایی توصیف نکردن."
    },
    {
      "id": 11,
      "start": 4590.88,
      "end": 4602.7,
      "formatted_start": "01:16:30.880",
      "formatted_end": "01:16:42.700",
      "text": "مقامات عرشد ریاض، آنکارا و اسلامباد سراحتاً پر پشاری دارن که این ماهره صرفاً ماهیت دیگرائی داشته و بر ضد هیچ مگبر یا کشور استانستی تنظیم نشده است."
    },
    {
      "id": 12,
      "start": 4602.7,
      "end": 4615.7,
      "formatted_start": "01:16:42.700",
      "formatted_end": "01:16:55.700",
      "text": "در روز، دو روز پس از آنکه عربستان، سعودی، کوکیه و پاکستان این طرف برنامه را اجازه کردن، از طرف آن یمن اینام قبلت و دو فایلش کن به جازان شرکت آرامتگی عربستان سعودی قبلت کردن."
    },
    {
      "id": 13,
      "start": 4615.7,
      "end": 4625.7,
      "formatted_start": "01:16:55.700",
      "formatted_end": "01:17:05.700",
      "text": "اگر حمله دیده که از اعضاهای و به منظری حمله هست، یکی از این طرف بشود، از پاکستان و کوکیه دقیقا چه این قضایی می رفت؟"
    },
    {
      "id": 14,
      "start": 4625.7,
      "end": 4632.32,
      "formatted_start": "01:17:05.700",
      "formatted_end": "01:17:12.320",
      "text": "حمله جازان، تقریباً بلا فصلی به آزمون جدید برای تصمیمش عدال این طبق و قامه"
    },
    {
      "id": 15,
      "start": 4632.32,
      "end": 4638.62,
      "formatted_start": "01:17:12.320",
      "formatted_end": "01:17:18.620",
      "text": "و نماغان شدن میزانت و افرادار حسیبی ساز و قامه یا آن در راه خودت نخستد می شود."
    },
    {
      "id": 16,
      "start": 4639.28,
      "end": 4646.9,
      "formatted_start": "01:17:19.280",
      "formatted_end": "01:17:26.900",
      "text": "با درجه به تعداد جدید و ملاحظات خود، این مادره خواست راقبی به برسانیش نزده منکده ای برنداری آمیقا"
    },
    {
      "id": 17,
      "start": 4646.9,
      "end": 4659.06,
      "formatted_start": "01:17:26.900",
      "formatted_end": "01:17:39.060",
      "text": "و برخواسته از بگرانه امید نسبت نصب جدیدیست که جمهوری اسطانبولیان دست برده تنقیم، تنقیم و اجران آن در دنبالیان خمیج فارسیست"
    },
    {
      "id": 18,
      "start": 4659.06,
      "end": 4674.44,
      "formatted_start": "01:17:39.060",
      "formatted_end": "01:17:54.440",
      "text": "تنوش کشورتون منصفه برای ایجاد سابقانهای دفالی قومی پردهان یکی مثل"
    },
    {
      "id": 19,
      "start": 4674.44,
      "end": 4704.44,
      "formatted_start": "01:17:54.440",
      "formatted_end": "01:18:24.440",
      "text": "این افراد را در این وقت برداشت که از این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این وقت برداشت که این"
    },
    {
      "id": 20,
      "start": 4704.44,
      "end": 4709.32,
      "formatted_start": "01:18:24.440",
      "formatted_end": "01:18:29.320",
      "text": "قبض ۳۷ میلیار دلاری ماجراجوی نظامی علیه ایران"
    },
    {
      "id": 21,
      "start": 4709.32,
      "end": 4715.24,
      "formatted_start": "01:18:29.320",
      "formatted_end": "01:18:35.240",
      "text": "و در نهایت چرکش زمان مهم های امریکایی از حمله بستبات قیمت انرژی"
    },
    {
      "id": 22,
      "start": 4715.24,
      "end": 4720.84,
      "formatted_start": "01:18:35.240",
      "formatted_end": "01:18:40.840",
      "text": "و گفته گو تصمیر روشنی از یک تبدیل پارادایی نیه فوزون تفسیم کنند"
    },
    {
      "id": 23,
      "start": 4720.84,
      "end": 4725.1,
      "formatted_start": "01:18:40.840",
      "formatted_end": "01:18:45.100",
      "text": "راشنگتون پس از آزمودن گذاری نظامی و دیدن حزینه های آن"
    },
    {
      "id": 24,
      "start": 4725.1,
      "end": 4727.76,
      "formatted_start": "01:18:45.100",
      "formatted_end": "01:18:47.760",
      "text": "راهی جز بازگشت به نظر مذاکره نمی بودند"
    },
    {
      "id": 25,
      "start": 4727.76,
      "end": 4731.6,
      "formatted_start": "01:18:47.760",
      "formatted_end": "01:18:51.600",
      "text": "مذاکره ای که این بار نبر مدار خواسته های امریکا"
    },
    {
      "id": 26,
      "start": 4731.6,
      "end": 4735.14,
      "formatted_start": "01:18:51.600",
      "formatted_end": "01:18:55.140",
      "text": "که بر مدار واقعیتهای میدان شکل گرفت است"
    },
    {
      "id": 27,
      "start": 4735.14,
      "end": 4738.34,
      "formatted_start": "01:18:55.140",
      "formatted_end": "01:18:58.340",
      "text": "روزامه ی واشنگتون پوست به نقل از مقامات امریکایی"
    },
    {
      "id": 28,
      "start": 4738.34,
      "end": 4740.88,
      "formatted_start": "01:18:58.340",
      "formatted_end": "01:19:00.880",
      "text": "باشگرده تر کشنگشبرد در جنگ با ایران"
    },
    {
      "id": 29,
      "start": 4740.88,
      "end": 4744.28,
      "formatted_start": "01:19:00.880",
      "formatted_end": "01:19:04.280",
      "text": "45 بردون پهکان امکیونو ها از دست داده"
    },
    {
      "id": 30,
      "start": 4744.28,
      "end": 4749.06,
      "formatted_start": "01:19:04.280",
      "formatted_end": "01:19:09.060",
      "text": "عددی که بر اساس این گزارش معادل خدود 25%"
    },
    {
      "id": 31,
      "start": 4749.06,
      "end": 4752.3,
      "formatted_start": "01:19:09.060",
      "formatted_end": "01:19:12.300",
      "text": "کل ناکان پهکانی 50 ملیون دولاری است"
    },
    {
      "id": 32,
      "start": 4752.3,
      "end": 4756.98,
      "formatted_start": "01:19:12.300",
      "formatted_end": "01:19:16.980",
      "text": "در همین حال درگدار علیه ازمایی فرمانده نیروی درگه ی سکه"
    },
    {
      "id": 33,
      "start": 4756.98,
      "end": 4760.38,
      "formatted_start": "01:19:16.980",
      "formatted_end": "01:19:20.380",
      "text": "با صراحت کامل می گوید تنگه خرموز بسته است"
    },
    {
      "id": 34,
      "start": 4760.38,
      "end": 4763.58,
      "formatted_start": "01:19:20.380",
      "formatted_end": "01:19:23.580",
      "text": "پس تلات ما بر تحرکات کامل و خاطر است"
    },
    {
      "id": 35,
      "start": 4763.58,
      "end": 4769.16,
      "formatted_start": "01:19:23.580",
      "formatted_end": "01:19:29.160",
      "text": "و هیچ تحرکی در این تنگه از ششم رزوندگان می روید در یه سپاه دور نمی مانند"
    },
    {
      "id": 36,
      "start": 4769.16,
      "end": 4772.7,
      "formatted_start": "01:19:29.160",
      "formatted_end": "01:19:32.700",
      "text": "او تکلیف می کند واقعیت را باید در میدان دید"
    },
    {
      "id": 37,
      "start": 4772.7,
      "end": 4776.12,
      "formatted_start": "01:19:32.700",
      "formatted_end": "01:19:36.120",
      "text": "نه در اقتلاعی ها و ازمارات مهامت آمدی کنند"
    },
    {
      "id": 38,
      "start": 4776.12,
      "end": 4779.32,
      "formatted_start": "01:19:36.120",
      "formatted_end": "01:19:39.320",
      "text": "این جمعیه چلید فهم وضعیت کلونیست"
    },
    {
      "id": 39,
      "start": 4779.32,
      "end": 4783.36,
      "formatted_start": "01:19:39.320",
      "formatted_end": "01:19:43.360",
      "text": "مدار روایت از متاقب فرمادهی باشنگان به میدان منتقل شده"
    },
    {
      "id": 40,
      "start": 4786.98,
      "end": 4795.66,
      "formatted_start": "01:19:46.980",
      "formatted_end": "01:19:55.660",
      "text": "مرکز تحریم دارداری های کشتیدنی تیپلیر بزارش دارد که ترافیک دریایی در تنگه هرموز در اواخر هفته از میانگین ماهانه خود کم پر شده."
    },
    {
      "id": 41,
      "start": 4796.08,
      "end": 4799.98,
      "formatted_start": "01:19:56.080",
      "formatted_end": "01:19:59.980",
      "text": "پانش ترافیک در مهمترین شریعان انرژی جمعان منعی جزایی."
    }
  ],
  "status": "completed"
}