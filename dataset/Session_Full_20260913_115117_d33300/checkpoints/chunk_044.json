  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13229.98,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13259.98,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 13260.0,
      "end": 13276.0,
      "formatted_start": "03:41:00.000",
      "formatted_end": "03:41:16.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 13276.0,
      "end": 13278.0,
      "formatted_start": "03:41:16.000",
      "formatted_end": "03:41:18.000",
      "text": "سه متر آردو توست داری؟"
    },
    {
      "id": 4,
      "start": 13278.0,
      "end": 13280.0,
      "formatted_start": "03:41:18.000",
      "formatted_end": "03:41:20.000",
      "text": "درست داری؟"
    },
    {
      "id": 5,
      "start": 13280.0,
      "end": 13282.0,
      "formatted_start": "03:41:20.000",
      "formatted_end": "03:41:22.000",
      "text": "درست داری؟"
    },
    {
      "id": 6,
      "start": 13282.0,
      "end": 13284.0,
      "formatted_start": "03:41:22.000",
      "formatted_end": "03:41:24.000",
      "text": "درست نشون کنی؟"
    },
    {
      "id": 7,
      "start": 13284.0,
      "end": 13286.0,
      "formatted_start": "03:41:24.000",
      "formatted_end": "03:41:26.000",
      "text": "یه چیز ببین"
    },
    {
      "id": 8,
      "start": 13286.0,
      "end": 13288.0,
      "formatted_start": "03:41:26.000",
      "formatted_end": "03:41:28.000",
      "text": "اونه که"
    },
    {
      "id": 9,
      "start": 13288.0,
      "end": 13290.0,
      "formatted_start": "03:41:28.000",
      "formatted_end": "03:41:30.000",
      "text": "دوتا خوهر بودن ببینم که"
    },
    {
      "id": 10,
      "start": 13290.0,
      "end": 13292.0,
      "formatted_start": "03:41:30.000",
      "formatted_end": "03:41:32.000",
      "text": "با قول میکنه خوهرش"
    },
    {
      "id": 11,
      "start": 13292.0,
      "end": 13294.0,
      "formatted_start": "03:41:32.000",
      "formatted_end": "03:41:34.000",
      "text": "همه دیگه میخواد دوباره این مسقیت بیاد"
    },
    {
      "id": 12,
      "start": 13294.0,
      "end": 13296.0,
      "formatted_start": "03:41:34.000",
      "formatted_end": "03:41:36.000",
      "text": "یه مسقیت دیگه داشت"
    },
    {
      "id": 13,
      "start": 13296.0,
      "end": 13298.0,
      "formatted_start": "03:41:36.000",
      "formatted_end": "03:41:38.000",
      "text": "آبیدنشو گفتم یادشون که"
    },
    {
      "id": 14,
      "start": 13298.0,
      "end": 13300.0,
      "formatted_start": "03:41:38.000",
      "formatted_end": "03:41:40.000",
      "text": "تا قبل قصدی دیگه آبش"
    },
    {
      "id": 15,
      "start": 13300.0,
      "end": 13302.0,
      "formatted_start": "03:41:40.000",
      "formatted_end": "03:41:42.000",
      "text": "سلام"
    },
    {
      "id": 16,
      "start": 13302.0,
      "end": 13304.0,
      "formatted_start": "03:41:42.000",
      "formatted_end": "03:41:44.000",
      "text": "سلام بودی تو"
    },
    {
      "id": 17,
      "start": 13304.0,
      "end": 13334.0,
      "formatted_start": "03:41:44.000",
      "formatted_end": "03:42:14.000",
      "text": "درخیبت شما هستم دوست شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت شما درخیبت ش"
    },
    {
      "id": 18,
      "start": 13334.0,
      "end": 13336.0,
      "formatted_start": "03:42:14.000",
      "formatted_end": "03:42:16.000",
      "text": "بگیر این هم کروناتون چه شکلیه"
    },
    {
      "id": 19,
      "start": 13336.0,
      "end": 13338.0,
      "formatted_start": "03:42:16.000",
      "formatted_end": "03:42:18.000",
      "text": "بگیر عه"
    },
    {
      "id": 20,
      "start": 13338.0,
      "end": 13340.0,
      "formatted_start": "03:42:18.000",
      "formatted_end": "03:42:20.000",
      "text": "خیلی خوب"
    },
    {
      "id": 21,
      "start": 13340.0,
      "end": 13342.0,
      "formatted_start": "03:42:20.000",
      "formatted_end": "03:42:22.000",
      "text": "این روز رو بگیرم"
    },
    {
      "id": 22,
      "start": 13342.0,
      "end": 13344.0,
      "formatted_start": "03:42:22.000",
      "formatted_end": "03:42:24.000",
      "text": "چند روزه که اینجور کار رو رنگ گرفتی؟"
    },
    {
      "id": 23,
      "start": 13344.0,
      "end": 13346.0,
      "formatted_start": "03:42:24.000",
      "formatted_end": "03:42:26.000",
      "text": "روز سه روزو"
    },
    {
      "id": 24,
      "start": 13346.0,
      "end": 13348.0,
      "formatted_start": "03:42:26.000",
      "formatted_end": "03:42:28.000",
      "text": "شخصی سه روزو"
    },
    {
      "id": 25,
      "start": 13348.0,
      "end": 13350.0,
      "formatted_start": "03:42:28.000",
      "formatted_end": "03:42:30.000",
      "text": "یه هفته الان دارم"
    },
    {
      "id": 26,
      "start": 13350.0,
      "end": 13352.0,
      "formatted_start": "03:42:30.000",
      "formatted_end": "03:42:32.000",
      "text": "یه هفته"
    },
    {
      "id": 27,
      "start": 13352.0,
      "end": 13354.0,
      "formatted_start": "03:42:32.000",
      "formatted_end": "03:42:34.000",
      "text": "پویایی دارین یا ندارین؟"
    },
    {
      "id": 28,
      "start": 13354.0,
      "end": 13356.0,
      "formatted_start": "03:42:34.000",
      "formatted_end": "03:42:36.000",
      "text": "پویایی داریم"
    },
    {
      "id": 29,
      "start": 13356.0,
      "end": 13358.0,
      "formatted_start": "03:42:36.000",
      "formatted_end": "03:42:38.000",
      "text": "شنبهایی توی بمشده"
    },
    {
      "id": 30,
      "start": 13358.0,
      "end": 13360.0,
      "formatted_start": "03:42:38.000",
      "formatted_end": "03:42:40.000",
      "text": "بمشده"
    },
    {
      "id": 31,
      "start": 13360.0,
      "end": 13362.0,
      "formatted_start": "03:42:40.000",
      "formatted_end": "03:42:42.000",
      "text": "از این تیکه"
    },
    {
      "id": 32,
      "start": 13362.0,
      "end": 13366.0,
      "formatted_start": "03:42:42.000",
      "formatted_end": "03:42:46.000",
      "text": "این نقطه من به شما بگم که ماردارم از صندیگی را"
    },
    {
      "id": 33,
      "start": 13366.0,
      "end": 13370.0,
      "formatted_start": "03:42:46.000",
      "formatted_end": "03:42:50.000",
      "text": "بله بله ممنون که سبت چپ نگاه کنی یه سورتو بزنی"
    },
    {
      "id": 34,
      "start": 13370.0,
      "end": 13374.0,
      "formatted_start": "03:42:50.000",
      "formatted_end": "03:42:54.000",
      "text": "سبت نگاه نکنی که بره بره"
    },
    {
      "id": 35,
      "start": 13374.0,
      "end": 13376.0,
      "formatted_start": "03:42:54.000",
      "formatted_end": "03:42:56.000",
      "text": "چیز را درکش کنم؟ بود؟"
    },
    {
      "id": 36,
      "start": 13376.0,
      "end": 13380.0,
      "formatted_start": "03:42:56.000",
      "formatted_end": "03:43:00.000",
      "text": "خیلی خوب"
    },
    {
      "id": 37,
      "start": 13380.0,
      "end": 13382.0,
      "formatted_start": "03:43:00.000",
      "formatted_end": "03:43:02.000",
      "text": "ماه چندو من؟"
    },
    {
      "id": 38,
      "start": 13382.0,
      "end": 13384.0,
      "formatted_start": "03:43:02.000",
      "formatted_end": "03:43:04.000",
      "text": "سه، پر شده"
    },
    {
      "id": 39,
      "start": 13384.0,
      "end": 13386.0,
      "formatted_start": "03:43:04.000",
      "formatted_end": "03:43:06.000",
      "text": "انتی رو دادی؟"
    },
    {
      "id": 40,
      "start": 13386.0,
      "end": 13388.0,
      "formatted_start": "03:43:06.000",
      "formatted_end": "03:43:08.000",
      "text": "آرزم خواهد بره انتی"
    },
    {
      "id": 41,
      "start": 13388.0,
      "end": 13390.0,
      "formatted_start": "03:43:08.000",
      "formatted_end": "03:43:10.000",
      "text": "این باید حالش یکی اونو نکرد بیتر بشه؟"
    },
    {
      "id": 42,
      "start": 13390.0,
      "end": 13396.0,
      "formatted_start": "03:43:10.000",
      "formatted_end": "03:43:16.000",
      "text": "اینجور که با خود نداره، جرده کم بیداره واسه یک مقصد باشه"
    },
    {
      "id": 43,
      "start": 13396.0,
      "end": 13399.0,
