      "end": 8162.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:02.000",
      "text": "اگه میگه باز بخورم بخورم"
    },
    {
      "id": 3,
      "start": 8162.0,
      "end": 8170.0,
      "formatted_start": "02:16:02.000",
      "formatted_end": "02:16:10.000",
      "text": "نه باید مواد غندی یعنی مواد شیرینی نوشابه شیرینی چکالات هر چیزی که طعم شیرین داره"
    },
    {
      "id": 4,
      "start": 8170.0,
      "end": 8176.0,
      "formatted_start": "02:16:10.000",
      "formatted_end": "02:16:16.000",
      "text": "باعث اگه بخورن باز بیشتر تشنتر میشین باید راقبتر میشین"
    },
    {
      "id": 5,
      "start": 8176.0,
      "end": 8178.0,
      "formatted_start": "02:16:16.000",
      "formatted_end": "02:16:18.000",
      "text": "یه دقیقه بین راست کنار خواهی تو راحته"
    },
    {
      "id": 6,
      "start": 8178.0,
      "end": 8180.0,
      "formatted_start": "02:16:18.000",
      "formatted_end": "02:16:20.000",
      "text": "محمد فارسا دیگه مرد شده دیگه بزرگ شده"
    },
    {
      "id": 7,
      "start": 8180.0,
      "end": 8182.0,
      "formatted_start": "02:16:20.000",
      "formatted_end": "02:16:22.000",
      "text": "چند را میبسرم؟"
    },
    {
      "id": 8,
      "start": 8182.0,
      "end": 8184.0,
      "formatted_start": "02:16:22.000",
      "formatted_end": "02:16:24.000",
      "text": "من کلاس پنجم بدم"
    },
    {
      "id": 9,
      "start": 8184.0,
      "end": 8186.0,
      "formatted_start": "02:16:24.000",
      "formatted_end": "02:16:26.000",
      "text": "دیگه مردی دیگه؟"
    },
    {
      "id": 10,
      "start": 8186.0,
      "end": 8190.0,
      "formatted_start": "02:16:26.000",
      "formatted_end": "02:16:30.000",
      "text": "بزرگ میگرفتم که تو حالا نیست که از پنجون که چه حرف هست کشنگ کنیم"
    },
    {
      "id": 11,
      "start": 8190.0,
      "end": 8191.0,
      "formatted_start": "02:16:30.000",
      "formatted_end": "02:16:31.000",
      "text": "خیلی خوب"
    },
    {
      "id": 12,
      "start": 8191.0,
      "end": 8192.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:32.000",
      "text": "دیگه چی؟"
    },
    {
      "id": 13,
      "start": 8192.0,
      "end": 8195.0,
      "formatted_start": "02:16:32.000",
      "formatted_end": "02:16:35.000",
      "text": "الان تشنگیش چجوریه؟ سرگیجه چجوریه؟"
    },
    {
      "id": 14,
      "start": 8195.0,
      "end": 8198.0,
      "formatted_start": "02:16:35.000",
      "formatted_end": "02:16:38.000",
      "text": "غذا برنش چطوریه؟ توصیب بدیم؟"
    },
    {
      "id": 15,
      "start": 8198.0,
      "end": 8201.0,
      "formatted_start": "02:16:38.000",
      "formatted_end": "02:16:41.000",
      "text": "الان دردهای پاها شما برسه گفتیم بخورو که بریت همه"
    },
    {
      "id": 16,
      "start": 8201.0,
      "end": 8202.0,
      "formatted_start": "02:16:41.000",
      "formatted_end": "02:16:42.000",
      "text": "برس برس برس"
    },
    {
      "id": 17,
      "start": 8202.0,
      "end": 8204.0,
      "formatted_start": "02:16:42.000",
      "formatted_end": "02:16:44.000",
      "text": "و درانه چند وقت هم خواهد داره"
    },
    {
      "id": 18,
      "start": 8204.0,
      "end": 8205.0,
      "formatted_start": "02:16:44.000",
      "formatted_end": "02:16:45.000",
      "text": "و بعد گفتین شیم داره چیه؟"
    },
    {
      "id": 19,
      "start": 8205.0,
      "end": 8206.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:46.000",
      "text": "اطرافش"
    },
    {
      "id": 20,
      "start": 8206.0,
      "end": 8208.0,
      "formatted_start": "02:16:46.000",
      "formatted_end": "02:16:48.000",
      "text": "داروی که داره استفاده میکنه"
    },
    {
      "id": 21,
      "start": 8208.0,
      "end": 8210.0,
      "formatted_start": "02:16:48.000",
      "formatted_end": "02:16:50.000",
      "text": "درونو بشه نبفته درد میکنم"
    },
    {
      "id": 22,
      "start": 8210.0,
      "end": 8211.0,
      "formatted_start": "02:16:50.000",
      "formatted_end": "02:16:51.000",
      "text": "شکر خدا"
    },
    {
      "id": 23,
      "start": 8211.0,
      "end": 8212.0,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:52.000",
      "text": "اینوش که خوبه"
    },
    {
      "id": 24,
      "start": 8212.0,
      "end": 8214.0,
      "formatted_start": "02:16:52.000",
      "formatted_end": "02:16:54.000",
      "text": "بزن برای لباس تو ببینم ناخبه چجوریه"
    },
    {
      "id": 25,
      "start": 8214.0,
      "end": 8215.0,
      "formatted_start": "02:16:54.000",
      "formatted_end": "02:16:55.000",
      "text": "ببین بیاییم"
    },
    {
      "id": 26,
      "start": 8215.0,
      "end": 8216.0,
      "formatted_start": "02:16:55.000",
      "formatted_end": "02:16:56.000",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 8216.0,
      "end": 8217.0,
      "formatted_start": "02:16:56.000",
      "formatted_end": "02:16:57.000",
      "text": "بخواهم بیاییم"
    },
    {
      "id": 28,
      "start": 8217.0,
      "end": 8219.0,
      "formatted_start": "02:16:57.000",
      "formatted_end": "02:16:59.000",
      "text": "برای قطعشم درو دادم؟"
    },
    {
      "id": 29,
      "start": 8219.0,
      "end": 8220.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:00.000",
      "text": "درو"
    },
    {
      "id": 30,
      "start": 8220.0,
      "end": 8223.0,
      "formatted_start": "02:17:00.000",
      "formatted_end": "02:17:03.000",
      "text": "این درو هم بیدم یه ذرا قطعش کلندتر بشه"
    },
    {
      "id": 31,
      "start": 8223.0,
      "end": 8224.0,
      "formatted_start": "02:17:03.000",
      "formatted_end": "02:17:04.000",
      "text": "خوبه؟"
    },
    {
      "id": 32,
      "start": 8224.0,
      "end": 8225.0,
      "formatted_start": "02:17:04.000",
      "formatted_end": "02:17:05.000",
      "text": "خوبه بوده دیگه"
    },
    {
      "id": 33,
      "start": 8225.0,
      "end": 8227.0,
      "formatted_start": "02:17:05.000",
      "formatted_end": "02:17:07.000",
      "text": "از این هم پس کلندتر بشه"
    },
    {
      "id": 34,
      "start": 8227.0,
      "end": 8229.0,
      "formatted_start": "02:17:07.000",
      "formatted_end": "02:17:09.000",
      "text": "اندازه بابات بشه خوبه دیگه"
    },
    {
      "id": 35,
      "start": 8229.0,
      "end": 8230.0,
      "formatted_start": "02:17:09.000",
      "formatted_end": "02:17:10.000",
      "text": "حرام بیدم"
    },
    {
      "id": 36,
      "start": 8230.0,
      "end": 8232.82,
      "formatted_start": "02:17:10.000",
      "formatted_end": "02:17:12.820",
      "text": "یه دوای بیدید عقلت پلندتر بشه چطوره؟"
    },
    {
      "id": 37,
      "start": 8232.82,
      "end": 8234.02,
      "formatted_start": "02:17:12.820",
      "formatted_end": "02:17:14.020",
      "text": "ها؟"
    },
    {
      "id": 38,
      "start": 8234.02,
      "end": 8236.02,
      "formatted_start": "02:17:14.020",
      "formatted_end": "02:17:16.020",
      "text": "عقلت پلند بشه، پلندیگه"
    },
    {
      "id": 39,
      "start": 8236.02,
      "end": 8238.02,
      "formatted_start": "02:17:16.020",
      "formatted_end": "02:17:18.020",
      "text": "خوره رو نگاه خور"
    },
    {
      "id": 40,
      "start": 8239.72,
      "end": 8241.72,
      "formatted_start": "02:17:19.720",
      "formatted_end": "02:17:21.720",
      "text": "زبانتی درد بید"
    },
    {
      "id": 41,
      "start": 8245.72,
      "end": 8247.72,
      "formatted_start": "02:17:25.720",
      "formatted_end": "02:17:27.720",
      "text": "زیاد مخوره آقای دکتور"
    },
    {
      "id": 42,
      "start": 8247.72,
      "end": 8249.72,
      "formatted_start": "02:17:27.720",
      "formatted_end": "02:17:29.720",
      "text": "پرخوریش زیاده"
    },
    {
      "id": 43,
      "start": 8249.72,
      "end": 8253.1,
      "formatted_start": "02:17:29.720",
      "formatted_end": "02:17:33.100",
      "text": "پاید دوای بیدید عقلش، عقلش پلند بشه"
    },
    {
      "id": 44,
      "start": 8253.1,
      "end": 8256.96,
      "formatted_start": "02:17:33.100",
      "formatted_end": "02:17:36.960",
      "text": "دیگه هم نخوری که با دار بکنه"
    },
    {
      "id": 45,
      "start": 8256.96,
      "end": 8258.96,
      "formatted_start": "02:17:36.960",
      "formatted_end": "02:17:38.960",
      "text": "آره، اشتراک زیاده هست"
    },
    {
      "id": 46,
      "start": 8258.96,
      "end": 8261.96,
      "formatted_start": "02:17:38.960",
      "formatted_end": "02:17:41.960",
      "text": "از سیر غذاگرد دائم داره میخوره"
    },
    {
      "id": 47,
      "start": 8261.96,
      "end": 8264.96,
      "formatted_start": "02:17:41.960",
      "formatted_end": "02:17:44.960",
      "text": "همش در یه چهارگاه میکنه و اینه برداره"
    },
    {
      "id": 48,
      "start": 8264.96,
      "end": 8266.96,
      "formatted_start": "02:17:44.960",
      "formatted_end": "02:17:46.960",
      "text": "سر سوپر زیاد میکنه باشه"
    },
    {
      "id": 49,
      "start": 8266.96,
      "end": 8268.96,
      "formatted_start": "02:17:46.960",
      "formatted_end": "02:17:48.960",
      "text": "بشه ها سه چهار بار باید برداره میکنه"
    },
    {
      "id": 50,
      "start": 8268.96,
      "end": 8271.96,
      "formatted_start": "02:17:48.960",
      "formatted_end": "02:17:51.960",
      "text": "پردن های جویز خالی ندارن ها"
    },
    {
      "id": 51,
      "start": 8271.96,
      "end": 8275.96,
      "formatted_start": "02:17:51.960",
      "formatted_end": "02:17:55.960",
      "text": "پردن از آدم بزرگ هم بیشتر میکنه"
    },
    {
      "id": 52,
      "start": 8275.96,
      "end": 8277.96,
      "formatted_start": "02:17:55.960",
      "formatted_end": "02:17:57.960",
      "text": "بیشتر، باید دعوه نگیرم به"
    },
    {
      "id": 53,
      "start": 8277.96,
      "end": 8279.96,
      "formatted_start": "02:17:57.960",
      "formatted_end": "02:17:59.960",
      "text": "اینجا دیگه"
    },
    {
      "id": 54,
      "start": 8279.96,
      "end": 8282.96,
      "formatted_start": "02:17:59.960",
      "formatted_end": "02:18:02.960",
      "text": "خودم برام همین شعر رو مختص داشتیم"
    },
    {
      "id": 55,
      "start": 8282.96,
      "end": 8284.96,
      "formatted_start": "02:18:02.960",
      "formatted_end": "02:18:04.960",
      "text": "او دوباره تکرار رو بشن"
    },
    {
      "id": 56,
      "start": 8284.96,
      "end": 8288.96,
      "formatted_start": "02:18:04.960",
      "formatted_end": "02:18:08.960",
      "text": "آره، دوائی مختصری هم بلاده"
    },
    {
      "id": 57,
      "start": 8288.96,
      "end": 8289.96,
      "formatted_start": "02:18:08.960",
      "formatted_end": "02:18:09.960",
      "text": "باید بیتر شده یا نیست؟"
    },
    {
      "id": 58,
      "start": 8289.96,
      "end": 8298.96,
      "formatted_start": "02:18:09.960",
      "formatted_end": "02:18:18.960",
      "text": "خیلی خیلی خیلی بیتر شده، برای ذرای نفخ میدم، بیرخودی شب باد بل میده یا نه؟"
    },
    {
      "id": 59,
      "start": 8298.96,
      "end": 8299.96,
      "formatted_start": "02:18:18.960",
      "formatted_end": "02:18:19.960",
      "text": "تا چه نمیشه؟"
    },
    {
      "id": 60,
      "start": 8299.96,
      "end": 8302.96,
      "formatted_start": "02:18:19.960",
      "formatted_end": "02:18:22.960",
      "text": "نه، اونجوره نیست"
    },
    {
      "id": 61,
      "start": 8302.96,
      "end": 8306.96,
      "formatted_start": "02:18:22.960",
      "formatted_end": "02:18:26.960",
      "text": "بعد آبایت افتاد، دخترم خوب، بیشتر هدف باشه یکه"
    },
    {
      "id": 62,
      "start": 8306.96,
      "end": 8308.96,
      "formatted_start": "02:18:26.960",
      "formatted_end": "02:18:28.960",
      "text": "کم خونی ببینیم"
    },
    {
      "id": 63,
      "start": 8308.96,
      "end": 8313.96,
      "formatted_start": "02:18:28.960",
      "formatted_end": "02:18:33.960",
      "text": "بعد افتاد بران هم یه آثمایش کل برنیسین، انجام بدن و بعد دیگر هم رو روزید کنیم برای آن"
    },
    {
      "id": 64,
      "start": 8313.96,
      "end": 8315.96,
      "formatted_start": "02:18:33.960",
      "formatted_end": "02:18:35.960",
      "text": "چه بچه رو ببینیم؟"
    },
    {
      "id": 65,
      "start": 8320.96,
      "end": 8322.96,
      "formatted_start": "02:18:40.960",
      "formatted_end": "02:18:42.960",
      "text": "خیلی بله، زبان رو ببینیم"
    },
    {
      "id": 66,
      "start": 8322.96,
      "end": 8324.96,
      "formatted_start": "02:18:42.960",
      "formatted_end": "02:18:44.960",
      "text": "کدومندی بچه رو ببینی؟"
    },
    {
      "id": 67,
      "start": 8324.96,
      "end": 8326.96,
      "formatted_start": "02:18:44.960",
      "formatted_end": "02:18:46.960",
      "text": "خودم زهرا 624"
    },
    {
      "id": 68,
      "start": 8326.96,
      "end": 8328.96,
      "formatted_start": "02:18:46.960",
      "formatted_end": "02:18:48.960",
      "text": "624"
    },
    {
      "id": 69,
      "start": 8331.96,
      "end": 8333.96,
      "formatted_start": "02:18:51.960",
      "formatted_end": "02:18:53.960",
      "text": "صرف 415"
    },
    {
      "id": 70,
      "start": 8333.96,
      "end": 8335.96,
      "formatted_start": "02:18:53.960",
      "formatted_end": "02:18:55.960",
      "text": "758"
    },
    {
      "id": 71,
      "start": 8340.96,
      "end": 8342.96,
      "formatted_start": "02:19:00.960",
      "formatted_end": "02:19:02.960",
      "text": "خانم مقدم بیا"
    },
    {
      "id": 72,
      "start": 8342.96,
      "end": 8344.96,
      "formatted_start": "02:19:02.960",
      "formatted_end": "02:19:04.960",
      "text": "به حدسی اینکه"
    },
    {
      "id": 73,
      "start": 8344.96,
      "end": 8346.96,
      "formatted_start": "02:19:04.960",
      "formatted_end": "02:19:06.960",
      "text": "دستانش قرار رخ می کنه"
    },
    {
      "id": 74,
      "start": 8346.96,
      "end": 8348.96,
      "formatted_start": "02:19:06.960",
      "formatted_end": "02:19:08.960",
      "text": "خب میگه اینش از تیرویدش هم اندازه بکنه"
    },
    {
      "id": 75,
      "start": 8348.96,
      "end": 8350.96,
      "formatted_start": "02:19:08.960",
      "formatted_end": "02:19:10.960",
      "text": "هم بخواد هر مندیر هم که"
    },
    {
      "id": 76,
      "start": 8350.96,
      "end": 8352.96,
      "formatted_start": "02:19:10.960",
      "formatted_end": "02:19:12.960",
      "text": "تیروید هم از اینه برد اینه"
    },
    {
      "id": 77,
      "start": 8352.96,
      "end": 8354.96,
      "formatted_start": "02:19:12.960",
      "formatted_end": "02:19:14.960",
      "text": "یه به دیگه دریافت بکنه"
    },
    {
      "id": 78,
      "start": 8354.96,
      "end": 8356.96,
      "formatted_start": "02:19:14.960",
      "formatted_end": "02:19:16.960",
      "text": "ارتش هم بکنه بیرون چون تیروید بزنی"
    },
    {
      "id": 79,
      "start": 8356.96,
      "end": 8358.96,
      "formatted_start": "02:19:16.960",
      "formatted_end": "02:19:18.960",
      "text": "این هم که برای خودش دریافت شده"
    },
    {
      "id": 80,
      "start": 8358.96,
      "end": 8360.96,
      "formatted_start": "02:19:18.960",
      "formatted_end": "02:19:20.960",
      "text": "برشون همون این همون"
    },
    {
      "id": 81,
      "start": 8360.96,
      "end": 8362.96,
      "formatted_start": "02:19:20.960",
      "formatted_end": "02:19:22.960",
      "text": "میبشه هم به چیروید خواهند"
    },
    {
      "id": 82,
      "start": 8362.96,
      "end": 8364.96,
      "formatted_start": "02:19:22.960",
      "formatted_end": "02:19:24.960",
