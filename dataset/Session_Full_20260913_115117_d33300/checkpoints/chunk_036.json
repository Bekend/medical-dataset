  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10806.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:06.000",
      "text": "این همه جنگو کنشه، یک نسخه چیمان بشه، آن یاد ببین، هرش میده."
    },
    {
      "id": 1,
      "start": 10806.0,
      "end": 10814.0,
      "formatted_start": "03:00:06.000",
      "formatted_end": "03:00:14.000",
      "text": "مزم منم از این مدینه که مصنف شده آمدیم، خوب شده بود. بلی انو بازم هم مورد بود."
    },
    {
      "id": 2,
      "start": 10820.0,
      "end": 10825.0,
      "formatted_start": "03:00:20.000",
      "formatted_end": "03:00:25.000",
      "text": "پنج که گزارت کردیم، برام نزدیکی اون سریع کم کردم بس."
    },
    {
      "id": 3,
      "start": 10825.0,
      "end": 10827.0,
      "formatted_start": "03:00:25.000",
      "formatted_end": "03:00:27.000",
      "text": "بله بله، اون رو باید بگیم"
    },
    {
      "id": 4,
      "start": 10827.0,
      "end": 10830.0,
      "formatted_start": "03:00:27.000",
      "formatted_end": "03:00:30.000",
      "text": "الان که چرک گرمان گرفتی؟"
    },
    {
      "id": 5,
      "start": 10830.0,
      "end": 10831.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:31.000",
      "text": "بله"
    },
    {
      "id": 6,
      "start": 10831.0,
      "end": 10833.0,
      "formatted_start": "03:00:31.000",
      "formatted_end": "03:00:33.000",
      "text": "چرک گرمان گرفتی؟"
    },
    {
      "id": 7,
      "start": 10835.0,
      "end": 10837.0,
      "formatted_start": "03:00:35.000",
      "formatted_end": "03:00:37.000",
      "text": "صرفه چی؟"
    },
    {
      "id": 8,
      "start": 10837.0,
      "end": 10842.0,
      "formatted_start": "03:00:37.000",
      "formatted_end": "03:00:42.000",
      "text": "صرفه نه، زیر شکرمون کمه رو خیلی درمون چندشون"
    },
    {
      "id": 9,
      "start": 10846.0,
      "end": 10849.0,
      "formatted_start": "03:00:46.000",
      "formatted_end": "03:00:49.000",
      "text": "الان این دست اصلا از من نیست، پشت"
    },
    {
      "id": 10,
      "start": 10849.0,
      "end": 10852.0,
      "formatted_start": "03:00:49.000",
      "formatted_end": "03:00:52.000",
      "text": "از این یک گره گره که دم کردم"
    },
    {
      "id": 11,
      "start": 10852.0,
      "end": 10882.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:01:22.000",
      "text": "نشسته، ندرسته، خودت نشسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته، ندرسته،"
    },
    {
      "id": 12,
      "start": 10882.0,
      "end": 10888.0,
      "formatted_start": "03:01:22.000",
      "formatted_end": "03:01:28.000",
      "text": "از چند ماه مثلا بیست روزی بیان داریم تمام شد بیان یا نه"
    },
    {
      "id": 13,
      "start": 10888.0,
      "end": 10889.0,
      "formatted_start": "03:01:28.000",
      "formatted_end": "03:01:29.000",
      "text": "نه تمام نشد"
    },
    {
      "id": 14,
      "start": 10889.0,
      "end": 10892.0,
      "formatted_start": "03:01:29.000",
      "formatted_end": "03:01:32.000",
      "text": "الان چند وقت دارو می کنی برای تیرویت؟"
    },
    {
      "id": 15,
      "start": 10892.0,
      "end": 10896.0,
      "formatted_start": "03:01:32.000",
      "formatted_end": "03:01:36.000",
      "text": "الان دیگه پیشت که آمدن دوباره آمدن دیگه"
    },
    {
      "id": 16,
      "start": 10896.0,
      "end": 10898.0,
      "formatted_start": "03:01:36.000",
      "formatted_end": "03:01:38.000",
      "text": "الان لزیدی بیست روزه تمام کرده"
    },
    {
      "id": 17,
      "start": 10898.0,
      "end": 10900.0,
      "formatted_start": "03:01:38.000",
      "formatted_end": "03:01:40.000",
      "text": "الان بیست روزه دارو نداری؟"
    },
    {
      "id": 18,
      "start": 10900.0,
      "end": 10901.0,
      "formatted_start": "03:01:40.000",
      "formatted_end": "03:01:41.000",
      "text": "نه داریم ندارم"
    },
    {
      "id": 19,
      "start": 10901.0,
      "end": 10903.0,
      "formatted_start": "03:01:41.000",
      "formatted_end": "03:01:43.000",
      "text": "این تصفحه نبود تیرویت؟ اون دیگه بود؟"
    },
    {
      "id": 20,
      "start": 10903.0,
      "end": 10904.0,
      "formatted_start": "03:01:43.000",
      "formatted_end": "03:01:44.000",
      "text": "ها؟"
    },
    {
      "id": 21,
      "start": 10904.0,
      "end": 10907.0,
      "formatted_start": "03:01:44.000",
      "formatted_end": "03:01:47.000",
      "text": "توی اون نسخه قبلی بود تیرویت"
    },
    {
      "id": 22,
      "start": 10907.0,
      "end": 10910.0,
      "formatted_start": "03:01:47.000",
      "formatted_end": "03:01:50.000",
      "text": "پرس تیرویتش پشتش قرمز بود"
    },
    {
      "id": 23,
      "start": 10910.0,
      "end": 10912.0,
      "formatted_start": "03:01:50.000",
      "formatted_end": "03:01:52.000",
      "text": "ازماشه هم هست"
    },
    {
      "id": 24,
      "start": 10912.0,
      "end": 10915.0,
      "formatted_start": "03:01:52.000",
      "formatted_end": "03:01:55.000",
      "text": "پرسو تو نه بردی؟ پشتش قرمز بود؟"
    },
    {
      "id": 25,
      "start": 10915.0,
      "end": 10916.0,
      "formatted_start": "03:01:55.000",
      "formatted_end": "03:01:56.000",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 10916.0,
      "end": 10918.0,
      "formatted_start": "03:01:56.000",
      "formatted_end": "03:01:58.000",
      "text": "ببینم آنها برد"
    },
    {
      "id": 27,
      "start": 10918.0,
      "end": 10920.0,
      "formatted_start": "03:01:58.000",
      "formatted_end": "03:02:00.000",
      "text": "باید ببینم"
    },
    {
      "id": 28,
      "start": 10920.0,
      "end": 10922.0,
      "formatted_start": "03:02:00.000",
      "formatted_end": "03:02:02.000",
      "text": "صبح ناشتن رو بردی؟"
    },
    {
      "id": 29,
      "start": 10922.0,
      "end": 10924.0,
      "formatted_start": "03:02:02.000",
      "formatted_end": "03:02:04.000",
      "text": "صبح ناشتن برد"
    },
    {
      "id": 30,
      "start": 10924.0,
      "end": 10926.0,
      "formatted_start": "03:02:04.000",
      "formatted_end": "03:02:06.000",
      "text": "ببینم"
    },
    {
      "id": 31,
      "start": 10926.0,
      "end": 10928.0,
      "formatted_start": "03:02:06.000",
      "formatted_end": "03:02:08.000",
      "text": "ازماشه هست"
    },
    {
      "id": 32,
      "start": 10934.0,
      "end": 10938.0,
      "formatted_start": "03:02:14.000",
      "formatted_end": "03:02:18.000",
      "text": "به اعتماد داری که اگه مصنعه بودی که کمتونی هست"
    },
    {
      "id": 33,
      "start": 10938.0,
      "end": 10943.0,
      "formatted_start": "03:02:18.000",
      "formatted_end": "03:02:23.000",
      "text": "اما قبض هم پیس داره با مخمی چیز در طرفش داره"
    },
    {
      "id": 34,
      "start": 10943.0,
      "end": 10946.0,
      "formatted_start": "03:02:23.000",
      "formatted_end": "03:02:26.000",
      "text": "پیس؟ خطر نکرده"
    },
    {
      "id": 35,
      "start": 10946.0,
      "end": 10949.0,
      "formatted_start": "03:02:26.000",
      "formatted_end": "03:02:29.000",
      "text": "حالا آدماشی جدید کدومه تو اینا؟"
    },
    {
      "id": 36,
      "start": 10949.0,
      "end": 10951.0,
      "formatted_start": "03:02:29.000",
      "formatted_end": "03:02:31.000",
      "text": "همین آدماشی که نگاه کردی"
    },
    {
      "id": 37,
      "start": 10951.0,
      "end": 10953.0,
      "formatted_start": "03:02:31.000",
      "formatted_end": "03:02:33.000",
      "text": "یعنی کدومش جدیده؟"
    },
    {
      "id": 38,
      "start": 10953.0,
      "end": 10955.0,
      "formatted_start": "03:02:33.000",
      "formatted_end": "03:02:35.000",
      "text": "نه بیدارم من که باید بردارم"
    },
    {
      "id": 39,
      "start": 10955.0,
      "end": 10956.0,
      "formatted_start": "03:02:35.000",
      "formatted_end": "03:02:36.000",
      "text": "همین رو درداشتی تو اینا؟"
    },
    {
      "id": 40,
      "start": 10956.0,
      "end": 10957.0,
      "formatted_start": "03:02:36.000",
      "formatted_end": "03:02:37.000",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 10957.0,
      "end": 10961.0,
      "formatted_start": "03:02:37.000",
      "formatted_end": "03:02:41.000",
      "text": "همنا بود کل اینکه نگاه کردیم"
    },
    {
      "id": 42,
      "start": 10961.0,
      "end": 10964.0,
      "formatted_start": "03:02:41.000",
      "formatted_end": "03:02:44.000",
      "text": "نه آقای یوتیوب بهتر نگه زرگت می کنی"
    },
    {
      "id": 43,
      "start": 10964.0,
      "end": 10966.0,
      "formatted_start": "03:02:44.000",
      "formatted_end": "03:02:46.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 44,
      "start": 10966.0,
      "end": 10968.0,
      "formatted_start": "03:02:46.000",
      "formatted_end": "03:02:48.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 45,
      "start": 10968.0,
      "end": 10970.0,
      "formatted_start": "03:02:48.000",
      "formatted_end": "03:02:50.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 46,
      "start": 10970.0,
      "end": 10972.0,
      "formatted_start": "03:02:50.000",
      "formatted_end": "03:02:52.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 47,
      "start": 10972.0,
      "end": 10974.0,
      "formatted_start": "03:02:52.000",
      "formatted_end": "03:02:54.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 48,
      "start": 10974.0,
      "end": 10976.0,
      "formatted_start": "03:02:54.000",
      "formatted_end": "03:02:56.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 49,
      "start": 10976.0,
      "end": 10978.0,
      "formatted_start": "03:02:56.000",
      "formatted_end": "03:02:58.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 50,
      "start": 10978.0,
      "end": 10980.0,
      "formatted_start": "03:02:58.000",
      "formatted_end": "03:03:00.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 51,
      "start": 10980.0,
      "end": 10982.0,
      "formatted_start": "03:03:00.000",
      "formatted_end": "03:03:02.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 52,
      "start": 10982.0,
      "end": 10984.0,
      "formatted_start": "03:03:02.000",
      "formatted_end": "03:03:04.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 53,
      "start": 10984.0,
      "end": 10986.0,
      "formatted_start": "03:03:04.000",
      "formatted_end": "03:03:06.000",
      "text": "اینجا باید برداری کنید"
    },
    {
      "id": 54,
      "start": 10986.0,
      "end": 10989.0,
      "formatted_start": "03:03:06.000",
      "formatted_end": "03:03:09.000",
      "text": "خدا رو شد که شد و کم برم نمی کنه"
    },
    {
      "id": 55,
      "start": 10989.0,
      "end": 10991.0,
      "formatted_start": "03:03:09.000",
      "formatted_end": "03:03:11.000",
      "text": "بگذاریم شده ها کنه"
    },
    {
      "id": 56,
      "start": 10991.0,
      "end": 10993.0,
      "formatted_start": "03:03:11.000",
      "formatted_end": "03:03:13.000",
      "text": "اونجا بسیار خیلی نمیدونید"
    },
    {
      "id": 57,
      "start": 10993.0,
      "end": 11007.0,
      "formatted_start": "03:03:13.000",
      "formatted_end": "03:03:27.000",
      "text": "اینجوری برگیر میشه که مثلا هر موقعی آگردم، ما لازمان شدیم و درست داریم"
    },
    {
      "id": 58,
      "start": 11007.0,
      "end": 11011.0,
      "formatted_start": "03:03:27.000",
      "formatted_end": "03:03:31.000",
      "text": "نه، البایی که درونه بشه، نمیدونی که گردن بشه بنابراین"
    },
    {
      "id": 59,
      "start": 11011.0,
      "end": 11013.0,
      "formatted_start": "03:03:31.000",
      "formatted_end": "03:03:33.000",
      "text": "نه، میگم اینجوری هست"
    },
    {
      "id": 60,
      "start": 11013.0,
      "end": 11017.0,
      "formatted_start": "03:03:33.000",
      "formatted_end": "03:03:37.000",
      "text": "برگیر دادی تا انشالله برگیر یک پاییز آزمایش بشه"
    },
    {
      "id": 61,
      "start": 11017.0,
      "end": 11021.5,
      "formatted_start": "03:03:37.000",
      "formatted_end": "03:03:41.500",
      "text": "این نمیشه برای مثلا شکم و هرگرد."
    },
    {
      "id": 62,
      "start": 11021.5,
      "end": 11023.5,
      "formatted_start": "03:03:41.500",
      "formatted_end": "03:03:43.500",
      "text": "من این سوان دارم کنم."
    },
    {
      "id": 63,
      "start": 11023.5,
      "end": 11024.5,
      "formatted_start": "03:03:43.500",
      "formatted_end": "03:03:44.500",
      "text": "سونوگرافی؟"
    },
    {
      "id": 64,
      "start": 11024.5,
      "end": 11026.5,
      "formatted_start": "03:03:44.500",
      "formatted_end": "03:03:46.500",
      "text": "آره، نمیتونم بشینم."
    },
    {
      "id": 65,
      "start": 11026.5,
      "end": 11032.5,
      "formatted_start": "03:03:46.500",
      "formatted_end": "03:03:52.500",
      "text": "مثلا باشم، اگر دیگر نباشه یا بارش نباشه، اصلا نمیتونم بشینم."
    },
    {
      "id": 66,
      "start": 11034.5,
      "end": 11041.0,
      "formatted_start": "03:03:54.500",
      "formatted_end": "03:04:01.000",
      "text": "میدین کمه هم چه تصور، این لبن هم از بستی که در می کنه بعد می سیوزه."
    },
    {
      "id": 67,
      "start": 11041.0,
      "end": 11046.5,
      "formatted_start": "03:04:01.000",
      "formatted_end": "03:04:06.500",
      "text": "مثلی که مشتقه داره جیس باله باشه، اونطوری میشه، از در."
    },
    {
      "id": 68,
      "start": 11047.0,
      "end": 11069.0,
      "formatted_start": "03:04:07.000",
      "formatted_end": "03:04:29.000",
      "text": "موسیقی"
    },
    {
      "id": 69,
      "start": 11069.0,
      "end": 11071.0,
      "formatted_start": "03:04:29.000",
      "formatted_end": "03:04:31.000",
      "text": "همین برگرها کود میده بشون"
    },
    {
      "id": 70,
      "start": 11071.0,
      "end": 11073.0,
      "formatted_start": "03:04:31.000",
      "formatted_end": "03:04:33.000",
      "text": "اون کودی که میده میتونی ببینی"
    },
    {
      "id": 71,
      "start": 11073.0,
      "end": 11075.0,
      "formatted_start": "03:04:33.000",
      "formatted_end": "03:04:35.000",
      "text": "اون کودی که میده میتونی ببینی"
    },
    {
      "id": 72,
      "start": 11075.0,
      "end": 11077.0,
      "formatted_start": "03:04:35.000",
      "formatted_end": "03:04:37.000",
      "text": "جامش رو من ندارست دارم شما میریم"
    },
    {
      "id": 73,
      "start": 11077.0,
      "end": 11079.0,
      "formatted_start": "03:04:37.000",
      "formatted_end": "03:04:39.000",
      "text": "من کودشو میدن"
    },
    {
      "id": 74,
      "start": 11079.0,
      "end": 11081.0,
      "formatted_start": "03:04:39.000",
      "formatted_end": "03:04:41.000",
      "text": "الان میگه من مینویسم براتون کودشو"
    },
    {
      "id": 75,
      "start": 11081.0,
      "end": 11083.0,
      "formatted_start": "03:04:41.000",
      "formatted_end": "03:04:43.000",
      "text": "من بگم"
    },
    {
      "id": 76,
      "start": 11083.0,
      "end": 11085.0,
      "formatted_start": "03:04:43.000",
      "formatted_end": "03:04:45.000",
      "text": "بابیمه ازش اونی کنم"
    },
    {
      "id": 77,
      "start": 11085.0,
      "end": 11087.0,
      "formatted_start": "03:04:45.000",
      "formatted_end": "03:04:47.000",
      "text": "نه بیمه تنشانایی"
    },
    {
      "id": 78,
      "start": 11087.0,
      "end": 11089.0,
      "formatted_start": "03:04:47.000",
      "formatted_end": "03:04:49.000",
      "text": "نه بیمه تنشانایی داری خودتی؟"
    },
    {
      "id": 79,
      "start": 11089.0,
      "end": 11091.0,
      "formatted_start": "03:04:49.000",
      "formatted_end": "03:04:51.000",
      "text": "نه بیمه تنشانایی داری خودتی؟"
    },
    {
      "id": 80,
      "start": 11091.0,
      "end": 11093.0,
      "formatted_start": "03:04:51.000",
      "formatted_end": "03:04:53.000",
      "text": "نه با اون چی که با روستایی کشتم"
    },
    {
      "id": 81,
      "start": 11093.0,
      "end": 11097.5,
      "formatted_start": "03:04:53.000",
      "formatted_end": "03:04:57.500",
      "text": "چون میتونی؟ چیز سپاه بدی؟ سراغرافی سپاه بدی؟"
    },
    {
      "id": 82,
      "start": 11097.5,
      "end": 11098.5,
      "formatted_start": "03:04:57.500",
      "formatted_end": "03:04:58.500",
      "text": "نه همینجور هست"
    },
    {
      "id": 83,
      "start": 11098.5,
      "end": 11099.76,
      "formatted_start": "03:04:58.500",
      "formatted_end": "03:04:59.760",
      "text": "بسمشی آبای"
    }
  ],
  "status": "completed"
}