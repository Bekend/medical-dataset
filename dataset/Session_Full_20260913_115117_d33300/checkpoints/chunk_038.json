  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11416.56,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:16.560",
      "text": "از اینجا همینجا بگیرید و همونجا شما کود ملی اینو میگید، بارکود یکی کود راه گیرید و بگید دیگه نمیپرسند کارتشناسی اینو نمیخواهید خواهد دارو خواهید. شما دوباره دارو میگیرید."
    },
    {
      "id": 1,
      "start": 11416.56,
      "end": 11417.56,
      "formatted_start": "03:10:16.560",
      "formatted_end": "03:10:17.560",
      "text": "توجه شدید؟"
    },
    {
      "id": 2,
      "start": 11417.56,
      "end": 11418.56,
      "formatted_start": "03:10:17.560",
      "formatted_end": "03:10:18.560",
      "text": "یعنی تلقی را آرمشید؟"
    },
    {
      "id": 3,
      "start": 11418.56,
      "end": 11428.56,
      "formatted_start": "03:10:18.560",
      "formatted_end": "03:10:28.560",
      "text": "نه، من ببینم چه کار لازم اضافه بشه کم بشه، اونجا هفته بعد من ادامه درمانم تو بدون اینکه خودت بیای بیا تلفن ازت میبخشم."
    },
    {
      "id": 4,
      "start": 11428.56,
      "end": 11432.56,
      "formatted_start": "03:10:28.560",
      "formatted_end": "03:10:32.560",
      "text": "اصلا ممکنه که یه چند روزی کم بهتر بشه"
    },
    {
      "id": 5,
      "start": 11432.56,
      "end": 11434.56,
      "formatted_start": "03:10:32.560",
      "formatted_end": "03:10:34.560",
      "text": "من مثلا بگو دارم بشم"
    },
    {
      "id": 6,
      "start": 11434.56,
      "end": 11436.56,
      "formatted_start": "03:10:34.560",
      "formatted_end": "03:10:36.560",
      "text": "دوباره باز شروع میشه"
    },
    {
      "id": 7,
      "start": 11436.56,
      "end": 11438.56,
      "formatted_start": "03:10:36.560",
      "formatted_end": "03:10:38.560",
      "text": "آه ای همونی میخوایی بشه کم کاری باسم"
    },
    {
      "id": 8,
      "start": 11438.56,
      "end": 11442.56,
      "formatted_start": "03:10:38.560",
      "formatted_end": "03:10:42.560",
      "text": "چون همین یک هفته وقت تغییراتتو باید به من بگی"
    },
    {
      "id": 9,
      "start": 11442.56,
      "end": 11445.56,
      "formatted_start": "03:10:42.560",
      "formatted_end": "03:10:45.560",
      "text": "خب یه جل بهترشتی هم نمیشتم"
    },
    {
      "id": 10,
      "start": 11445.56,
      "end": 11447.56,
      "formatted_start": "03:10:45.560",
      "formatted_end": "03:10:47.560",
      "text": "هر شب خواهیتو با من بشو"
    },
    {
      "id": 11,
      "start": 11447.56,
      "end": 11449.56,
      "formatted_start": "03:10:47.560",
      "formatted_end": "03:10:49.560",
      "text": "خوش کن مثل نصف محسنن"
    },
    {
      "id": 12,
      "start": 11449.56,
      "end": 11450.56,
      "formatted_start": "03:10:49.560",
      "formatted_end": "03:10:50.560",
      "text": "برو بخون"
    },
    {
      "id": 13,
      "start": 11450.56,
      "end": 11452.56,
      "formatted_start": "03:10:50.560",
      "formatted_end": "03:10:52.560",
      "text": "شب یکی میخوایی نزدیکی کنی"
    },
    {
      "id": 14,
      "start": 11452.56,
      "end": 11455.56,
      "formatted_start": "03:10:52.560",
      "formatted_end": "03:10:55.560",
      "text": "آهاتو باید خودشو بشونه بعد نزدیک"
    },
    {
      "id": 15,
      "start": 11455.56,
      "end": 11461.56,
      "formatted_start": "03:10:55.560",
      "formatted_end": "03:11:01.560",
      "text": "شما هر شب میشون، آنها تو فقط موقع قبل از نزدیکی میشون"
    },
    {
      "id": 16,
      "start": 11461.56,
      "end": 11462.56,
      "formatted_start": "03:11:01.560",
      "formatted_end": "03:11:02.560",
      "text": "پا؟"
    },
    {
      "id": 17,
      "start": 11462.56,
      "end": 11464.56,
      "formatted_start": "03:11:02.560",
      "formatted_end": "03:11:04.560",
      "text": "پا در اونجا اینو به هر وسط بزنیم مشتره کنیم؟"
    },
    {
      "id": 18,
      "start": 11464.56,
      "end": 11466.56,
      "formatted_start": "03:11:04.560",
      "formatted_end": "03:11:06.560",
      "text": "نه، اونو برشونستو شویم، مثل شامپوه، درسته؟"
    },
    {
      "id": 19,
      "start": 11466.56,
      "end": 11467.56,
      "formatted_start": "03:11:06.560",
      "formatted_end": "03:11:07.560",
      "text": "مثل جده صورت؟"
    },
    {
      "id": 20,
      "start": 11467.56,
      "end": 11470.56,
      "formatted_start": "03:11:07.560",
      "formatted_end": "03:11:10.560",
      "text": "آه، دو تا فمانی داخلی هم بره که هر شب میزاریم"
    },
    {
      "id": 21,
      "start": 11470.56,
      "end": 11476.56,
      "formatted_start": "03:11:10.560",
      "formatted_end": "03:11:16.560",
      "text": "وقتی میزاریم، دوار بهترشتی بزار، میکروبارو میکشین، چرکارو میاد، یک خلط های گنده گنده باید میاد"
    },
    {
      "id": 22,
      "start": 11476.56,
      "end": 11486.56,
      "formatted_start": "03:11:16.560",
      "formatted_end": "03:11:26.560",
      "text": "از برگ برگ متعفه اینا خارج بشه از تو شکلم راحت میشه یه هم کنترولت خوب میشه همه چیز دردهای لذکی را از بیمونید انشاءالله"
    },
    {
      "id": 23,
      "start": 11486.56,
      "end": 11493.56,
      "formatted_start": "03:11:26.560",
      "formatted_end": "03:11:33.560",
      "text": "بله اینا دو سه مرحله داره شما از این نسخه هفته شما عکس بگیرد نگهد و از اونو برای آبجیب دارید"
    },
    {
      "id": 24,
      "start": 11493.56,
      "end": 11495.56,
      "formatted_start": "03:11:33.560",
      "formatted_end": "03:11:35.560",
      "text": "از همین کاموراست نگهد میتونم بگهد؟"
    },
    {
      "id": 25,
      "start": 11495.56,
      "end": 11499.56,
      "formatted_start": "03:11:35.560",
      "formatted_end": "03:11:39.560",
      "text": "اولا بگهد بگهد و این با تلفن بگهد من این جدیدشت بگیم"
    },
    {
      "id": 26,
      "start": 11499.56,
      "end": 11503.56,
      "formatted_start": "03:11:39.560",
      "formatted_end": "03:11:43.560",
      "text": "این کسانی میتونم با باید یه برنامه ووستر کنیم چیزا"
    },
    {
      "id": 27,
      "start": 11503.56,
      "end": 11505.56,
      "formatted_start": "03:11:43.560",
      "formatted_end": "03:11:45.560",
      "text": "اونو تا دوا میدم چشم"
    },
    {
      "id": 28,
      "start": 11505.56,
      "end": 11507.56,
      "formatted_start": "03:11:45.560",
      "formatted_end": "03:11:47.560",
      "text": "بعد دستاتا بگو"
    },
    {
      "id": 29,
      "start": 11507.56,
      "end": 11509.56,
      "formatted_start": "03:11:47.560",
      "formatted_end": "03:11:49.560",
      "text": "آره استخوان لطیقه"
    },
    {
      "id": 30,
      "start": 11509.56,
      "end": 11511.56,
      "formatted_start": "03:11:49.560",
      "formatted_end": "03:11:51.560",
      "text": "متولد چه سالی هستی؟"
    },
    {
      "id": 31,
      "start": 11511.56,
      "end": 11513.56,
      "formatted_start": "03:11:51.560",
      "formatted_end": "03:11:53.560",
      "text": "پنجه آن رو"
    },
    {
      "id": 32,
      "start": 11513.56,
      "end": 11515.56,
      "formatted_start": "03:11:53.560",
      "formatted_end": "03:11:55.560",
      "text": "چه رو چهار سالی تنگی؟"
    },
    {
      "id": 33,
      "start": 11515.56,
      "end": 11517.56,
      "formatted_start": "03:11:55.560",
      "formatted_end": "03:11:57.560",
      "text": "در بیشتر"
    },
    {
      "id": 34,
      "start": 11517.56,
      "end": 11519.56,
      "formatted_start": "03:11:57.560",
      "formatted_end": "03:11:59.560",
      "text": "در از شسته"
    },
    {
      "id": 35,
      "start": 11519.56,
      "end": 11521.56,
      "formatted_start": "03:11:59.560",
      "formatted_end": "03:12:01.560",
      "text": "چه رو سنه شده بود؟"
    },
    {
      "id": 36,
      "start": 11521.56,
      "end": 11523.56,
      "formatted_start": "03:12:01.560",
      "formatted_end": "03:12:03.560",
      "text": "شسته باشه"
    },
    {
      "id": 37,
      "start": 11523.56,
      "end": 11525.56,
      "formatted_start": "03:12:03.560",
      "formatted_end": "03:12:05.560",
      "text": "چهه رو پنجه سنه"
    },
    {
      "id": 38,
      "start": 11525.56,
      "end": 11527.56,
      "formatted_start": "03:12:05.560",
      "formatted_end": "03:12:07.560",
      "text": "چه رو چهار سنه پنجه یکی"
    },
    {
      "id": 39,
      "start": 11527.56,
      "end": 11535.72,
      "formatted_start": "03:12:07.560",
      "formatted_end": "03:12:15.720",
      "text": "چیه؟ یایسگی، دیگه هنوز یایسگی نشدی، ولی دردهای یایسگی رو از چهره سه، چهره دو، چهره سه شروع میشه"
    },
    {
      "id": 40,
      "start": 11535.72,
      "end": 11541.32,
      "formatted_start": "03:12:15.720",
      "formatted_end": "03:12:21.320",
      "text": "مدینه که شادن خونه پیر یاد رفتی به افراد کنه یا به یایسگی؟"
    },
    {
      "id": 41,
      "start": 11541.32,
      "end": 11542.44,
      "formatted_start": "03:12:21.320",
      "formatted_end": "03:12:22.440",
      "text": "آقای دکتر؟"
    },
    {
      "id": 42,
      "start": 11542.44,
      "end": 11543.96,
      "formatted_start": "03:12:22.440",
      "formatted_end": "03:12:23.960",
      "text": "منظورم خیلی کم شده"
    },
    {
      "id": 43,
      "start": 11543.96,
      "end": 11545.4,
      "formatted_start": "03:12:23.960",
      "formatted_end": "03:12:25.400",
      "text": "یایسگی؟"
    },
    {
      "id": 44,
      "start": 11545.4,
      "end": 11552.04,
      "formatted_start": "03:12:25.400",
      "formatted_end": "03:12:32.040",
      "text": "هفت سال پیش آمده، من آوردمش بشه تون، دستاش درد میکرده، دارو داده این خوب شده"
    },
    {
      "id": 45,
      "start": 11552.04,
      "end": 11560.04,
      "formatted_start": "03:12:32.040",
      "formatted_end": "03:12:40.040",
      "text": "پونزده سال پیشم آوردم همینجوری نمیدونم یادمون رفته که چیز برای این دستی شما چی میدادین"
    },
    {
      "id": 46,
      "start": 11560.04,
      "end": 11562.04,
      "formatted_start": "03:12:40.040",
      "formatted_end": "03:12:42.040",
      "text": "از من بیپرسید من یادم ندارم"
    },
    {
      "id": 47,
      "start": 11562.04,
      "end": 11567.04,
      "formatted_start": "03:12:42.040",
      "formatted_end": "03:12:47.040",
      "text": "یعنی مجرم شما که کلا شما گفتید برای یادی سیگیر نه"
    },
    {
      "id": 48,
      "start": 11567.04,
      "end": 11573.04,
      "formatted_start": "03:12:47.040",
      "formatted_end": "03:12:53.040",
      "text": "این چون زمان بارداری مامانم از آواز تغذیر تهمیم نبود"
    },
    {
      "id": 49,
      "start": 11573.04,
      "end": 11577.04,
      "formatted_start": "03:12:53.040",
      "formatted_end": "03:12:57.040",
      "text": "چون زمان جنگ بود جنگ ایران عرب ما تو رستا بودیم"
    },
    {
      "id": 50,
      "start": 11577.04,
      "end": 11580.88,
      "formatted_start": "03:12:57.040",
      "formatted_end": "03:13:00.880",
      "text": "منم سر خوهرم از آواز... یعنی فقط..."
    },
    {
      "id": 51,
      "start": 11580.88,
      "end": 11581.92,
      "formatted_start": "03:13:00.880",
      "formatted_end": "03:13:01.920",
      "text": "تعمید نشوند"
    },
    {
      "id": 52,
      "start": 11581.92,
      "end": 11584.36,
      "formatted_start": "03:13:01.920",
      "formatted_end": "03:13:04.360",
      "text": "نون و آلیون و ماست و این چیزا بود"
    },
    {
      "id": 53,
      "start": 11584.36,
      "end": 11589.2,
      "formatted_start": "03:13:04.360",
      "formatted_end": "03:13:09.200",
      "text": "از همون موقع این اصلا از آواز گلشتی هم تغییر داشت، فرق داشت"
    },
    {
      "id": 54,
      "start": 11589.2,
      "end": 11592.28,
      "formatted_start": "03:13:09.200",
      "formatted_end": "03:13:12.280",
      "text": "موقعیت به دلیل آمد یک کلای سر گرم"
    },
    {
      "id": 55,
      "start": 11592.28,
      "end": 11594.84,
      "formatted_start": "03:13:12.280",
      "formatted_end": "03:13:14.840",
      "text": "بعد این اضافه کمچار شد"
    },
    {
      "id": 56,
      "start": 11594.84,
      "end": 11600.8,
      "formatted_start": "03:13:14.840",
      "formatted_end": "03:13:20.800",
      "text": "من دارم میدونی که از آواز چیزی این بنی بدنی رو از همون اطباعی"
    },
    {
      "id": 57,
      "start": 11600.8,
      "end": 11602.8,
      "formatted_start": "03:13:20.800",
      "formatted_end": "03:13:22.800",
      "text": "ایشالله همه شده"
    },
    {
      "id": 58,
      "start": 11602.8,
      "end": 11604.8,
      "formatted_start": "03:13:22.800",
      "formatted_end": "03:13:24.800",
      "text": "از همه موقعیت کن کنترل اطرافیت بود"
    },
    {
      "id": 59,
      "start": 11604.8,
      "end": 11608.8,
      "formatted_start": "03:13:24.800",
      "formatted_end": "03:13:28.800",
      "text": "من به صدای مالی سرکت هم داشتم نه مهمه"
    },
    {
      "id": 60,
      "start": 11608.8,
      "end": 11612.8,
      "formatted_start": "03:13:28.800",
      "formatted_end": "03:13:32.800",
      "text": "یه سرکت داشتم که ما خودم بماجر سرکت کردیم"
    },
    {
      "id": 61,
      "start": 11612.8,
      "end": 11613.8,
      "formatted_start": "03:13:32.800",
      "formatted_end": "03:13:33.800",
      "text": "همدی؟"
    },
    {
      "id": 62,
      "start": 11613.8,
      "end": 11614.8,
      "formatted_start": "03:13:33.800",
      "formatted_end": "03:13:34.800",
      "text": "آره"
    },
    {
      "id": 63,
      "start": 11614.8,
      "end": 11615.8,
      "formatted_start": "03:13:34.800",
      "formatted_end": "03:13:35.800",
      "text": "چند تا بچه داشتید سرکت؟"
    },
    {
      "id": 64,
      "start": 11615.8,
      "end": 11616.8,
      "formatted_start": "03:13:35.800",
      "formatted_end": "03:13:36.800",
      "text": "دو تا داشتم بچه داشتم"
    },
    {
      "id": 65,
      "start": 11616.8,
      "end": 11617.8,
      "formatted_start": "03:13:36.800",
      "formatted_end": "03:13:37.800",
      "text": "نه یه دوره"
    },
    {
      "id": 66,
      "start": 11617.8,
      "end": 11618.8,
      "formatted_start": "03:13:37.800",
      "formatted_end": "03:13:38.800",
      "text": "آه ماها تا داشتیم"
    },
    {
      "id": 67,
      "start": 11618.8,
      "end": 11620.8,
      "formatted_start": "03:13:38.800",
      "formatted_end": "03:13:40.800",
      "text": "او مامی خیلی کچیک بود"
    },
    {
      "id": 68,
      "start": 11620.8,
      "end": 11623.8,
      "formatted_start": "03:13:40.800",
      "formatted_end": "03:13:43.800",
      "text": "بعد دکتر میگفت خیلی خطرناکه من میترسم"
    },
    {
      "id": 69,
      "start": 11623.8,
      "end": 11626.8,
      "formatted_start": "03:13:43.800",
      "formatted_end": "03:13:46.800",
      "text": "همینوز بخیه های سزاریانه خوب نشده"
    },
    {
      "id": 70,
      "start": 11626.8,
      "end": 11629.8,
      "formatted_start": "03:13:46.800",
      "formatted_end": "03:13:49.800",
      "text": "بعد دیگه ما سرکت کردیم جفتش"
    },
    {
      "id": 71,
      "start": 11629.8,
      "end": 11631.8,
      "formatted_start": "03:13:49.800",
      "formatted_end": "03:13:51.800",
      "text": "این هنوز بود جفتشو بعد سخت کرده"
    },
    {
      "id": 72,
      "start": 11631.8,
      "end": 11633.8,
      "formatted_start": "03:13:51.800",
      "formatted_end": "03:13:53.800",
      "text": "اونو تاش کردی؟ یا نه؟"
    },
    {
      "id": 73,
      "start": 11633.8,
      "end": 11635.8,
      "formatted_start": "03:13:53.800",
      "formatted_end": "03:13:55.800",
      "text": "نه نه بعد اینوقت خلاصه سر زنان"
    },
    {
      "id": 74,
      "start": 11635.8,
      "end": 11637.8,
      "formatted_start": "03:13:55.800",
      "formatted_end": "03:13:57.800",
      "text": "این سری دارو دار که جفتشو افتاد"
    },
    {
      "id": 75,
      "start": 11637.8,
      "end": 11639.8,
      "formatted_start": "03:13:57.800",
      "formatted_end": "03:13:59.800",
      "text": "این هنوز؟"
    },
    {
      "id": 76,
      "start": 11639.8,
      "end": 11641.8,
      "formatted_start": "03:13:59.800",
      "formatted_end": "03:14:01.800",
      "text": "اونو سرنوگرافی کردیم گفت جفت افتاد"
    },
    {
      "id": 77,
      "start": 11641.8,
      "end": 11643.8,
      "formatted_start": "03:14:01.800",
      "formatted_end": "03:14:03.800",
      "text": "آره این هنوز بعد یه دابر بود"
    },
    {
      "id": 78,
      "start": 11643.8,
      "end": 11645.8,
      "formatted_start": "03:14:03.800",
      "formatted_end": "03:14:05.800",
      "text": "چون ماما آشنامیده شیاف داده بوده"
    },
    {
      "id": 79,
      "start": 11645.8,
      "end": 11647.8,
      "formatted_start": "03:14:05.800",
      "formatted_end": "03:14:07.800",
      "text": "آره ازدباده کرده"
    },
    {
      "id": 80,
      "start": 11647.8,
      "end": 11649.8,
      "formatted_start": "03:14:07.800",
      "formatted_end": "03:14:09.800",
      "text": "اونجوریه شیف میگرد چون میگفت"
    },
    {
      "id": 81,
      "start": 11649.8,
      "end": 11651.8,
      "formatted_start": "03:14:09.800",
      "formatted_end": "03:14:11.800",
      "text": "خیلی و خیلی ها تازه هست"
    },
    {
      "id": 82,
      "start": 11651.8,
      "end": 11653.8,
      "formatted_start": "03:14:11.800",
      "formatted_end": "03:14:13.800",
      "text": "تازه سزا بین شروعی"
    },
    {
      "id": 83,
      "start": 11659.8,
      "end": 11661.8,
      "formatted_start": "03:14:19.800",
      "formatted_end": "03:14:21.800",
      "text": "بگید سفت کنید، بسم شما نمیشتم؟"
    },
    {
      "id": 84,
      "start": 11661.8,
      "end": 11662.8,
      "formatted_start": "03:14:21.800",
      "formatted_end": "03:14:22.800",
      "text": "آره"
    },
    {
      "id": 85,
      "start": 11662.8,
      "end": 11663.8,
      "formatted_start": "03:14:22.800",
      "formatted_end": "03:14:23.800",
      "text": "باشید"
    },
    {
      "id": 86,
      "start": 11663.8,
      "end": 11665.8,
      "formatted_start": "03:14:23.800",
      "formatted_end": "03:14:25.800",
      "text": "من که بخشم که بره، من بشه"
    },
    {
      "id": 87,
      "start": 11665.8,
      "end": 11667.8,
      "formatted_start": "03:14:25.800",
      "formatted_end": "03:14:27.800",
      "text": "آره، کشکار من، دیگه شما این رو ساختید"
    },
    {
      "id": 88,
      "start": 11667.8,
      "end": 11668.8,
      "formatted_start": "03:14:27.800",
      "formatted_end": "03:14:28.800",
      "text": "بله، چشم"
    },
    {
      "id": 89,
      "start": 11668.8,
      "end": 11669.8,
      "formatted_start": "03:14:28.800",
      "formatted_end": "03:14:29.800",
      "text": "مرسی ببینیم"
    },
    {
      "id": 90,
      "start": 11669.8,
      "end": 11671.8,
      "formatted_start": "03:14:29.800",
      "formatted_end": "03:14:31.800",
      "text": "پدر اینکه گنواز شما میاد و تلفن بکنید باشم"
    },
    {
      "id": 91,
      "start": 11671.8,
      "end": 11672.8,
      "formatted_start": "03:14:31.800",
      "formatted_end": "03:14:32.800",
      "text": "ندیده"
    },
    {
      "id": 92,
      "start": 11672.8,
      "end": 11673.8,
      "formatted_start": "03:14:32.800",
      "formatted_end": "03:14:33.800",
      "text": "ندیده که چی هست؟"
    },
    {
      "id": 93,
      "start": 11673.8,
      "end": 11674.8,
      "formatted_start": "03:14:33.800",
      "formatted_end": "03:14:34.800",
      "text": "ممنون آیدو"
    },
    {
      "id": 94,
      "start": 11674.8,
      "end": 11675.8,
      "formatted_start": "03:14:34.800",
      "formatted_end": "03:14:35.800",
      "text": "خوب"
    },
    {
      "id": 95,
      "start": 11675.8,
      "end": 11677.8,
      "formatted_start": "03:14:35.800",
      "formatted_end": "03:14:37.800",
      "text": "ممنون، شکر آیدو، دو زحمت شدید"
    },
    {
      "id": 96,
      "start": 11677.8,
      "end": 11678.8,
      "formatted_start": "03:14:37.800",
      "formatted_end": "03:14:38.800",
      "text": "بله، بشه"
    },
    {
      "id": 97,
      "start": 11680.8,
      "end": 11682.8,
      "formatted_start": "03:14:40.800",
