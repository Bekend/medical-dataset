  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6902.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:02.000",
      "text": "باید برگردیم."
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6934.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:34.000",
      "text": "این فنیل ۲۵ رنگی، خودش مثل بکلویه، گردان داری"
    },
    {
      "id": 2,
      "start": 6934.0,
      "end": 6938.0,
      "formatted_start": "01:55:34.000",
      "formatted_end": "01:55:38.000",
      "text": "براتیکا زور رنگ، نکن فنیل ۳۰ رنگ"
    },
    {
      "id": 3,
      "start": 6938.0,
      "end": 6942.0,
      "formatted_start": "01:55:38.000",
      "formatted_end": "01:55:42.000",
      "text": "فنیل دارو خود از شهر؟ براتیکا زور رنگ"
    },
    {
      "id": 4,
      "start": 6942.0,
      "end": 6946.0,
      "formatted_start": "01:55:42.000",
      "formatted_end": "01:55:46.000",
      "text": "بفرمایید"
    },
    {
      "id": 5,
      "start": 6946.0,
      "end": 6950.0,
      "formatted_start": "01:55:46.000",
      "formatted_end": "01:55:50.000",
      "text": "کمنه، چه ماره؟ چه ماره؟"
    },
    {
      "id": 6,
      "start": 6950.0,
      "end": 6954.0,
      "formatted_start": "01:55:50.000",
      "formatted_end": "01:55:54.000",
      "text": "از اینجای کمل خاله، این هم هست"
    },
    {
      "id": 7,
      "start": 6954.0,
      "end": 6958.0,
      "formatted_start": "01:55:54.000",
      "formatted_end": "01:55:58.000",
      "text": "تو باسن و پان میرسید دردش؟ نه"
    },
    {
      "id": 8,
      "start": 6958.0,
      "end": 6966.0,
      "formatted_start": "01:55:58.000",
      "formatted_end": "01:56:06.000",
      "text": "این چیزی بوده؟ بلند کرده"
    },
    {
      "id": 9,
      "start": 6966.0,
      "end": 6968.0,
      "formatted_start": "01:56:06.000",
      "formatted_end": "01:56:08.000",
      "text": "من بلند کردم"
    },
    {
      "id": 10,
      "start": 6968.0,
      "end": 6970.0,
      "formatted_start": "01:56:08.000",
      "formatted_end": "01:56:10.000",
      "text": "آه، موتورها ها بی چیزی بوده"
    },
    {
      "id": 11,
      "start": 6970.0,
      "end": 6972.0,
      "formatted_start": "01:56:10.000",
      "formatted_end": "01:56:12.000",
      "text": "منم این آب چیز بوده"
    },
    {
      "id": 12,
      "start": 6972.0,
      "end": 6976.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:16.000",
      "text": "دسته بزن کنه، درگان رو نسدم"
    },
    {
      "id": 13,
      "start": 6976.0,
      "end": 6978.0,
      "formatted_start": "01:56:16.000",
      "formatted_end": "01:56:18.000",
      "text": "من هم دسته بزنم"
    },
    {
      "id": 14,
      "start": 6978.0,
      "end": 6983.0,
      "formatted_start": "01:56:18.000",
      "formatted_end": "01:56:23.000",
      "text": "دیسک کمرش بیرون زده، این حالت بیرون زده بیه"
    },
    {
      "id": 15,
      "start": 6983.0,
      "end": 6985.0,
      "formatted_start": "01:56:23.000",
      "formatted_end": "01:56:25.000",
      "text": "دیسک کمره"
    },
    {
      "id": 16,
      "start": 6985.0,
      "end": 6986.0,
      "formatted_start": "01:56:25.000",
      "formatted_end": "01:56:26.000",
      "text": "دیسک کمر؟"
    },
    {
      "id": 17,
      "start": 6986.0,
      "end": 6992.0,
      "formatted_start": "01:56:26.000",
      "formatted_end": "01:56:32.000",
      "text": "آره، نباید سنگین بلند کنی، خواب کمرت شل میشه"
    },
    {
      "id": 18,
      "start": 6992.0,
      "end": 6994.0,
      "formatted_start": "01:56:32.000",
      "formatted_end": "01:56:34.000",
      "text": "چند وقت اینجوری شدی؟"
    },
    {
      "id": 19,
      "start": 6994.0,
      "end": 6996.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:36.000",
      "text": "روز ۱۵ روزه"
    },
    {
      "id": 20,
      "start": 6996.0,
      "end": 6998.0,
      "formatted_start": "01:56:36.000",
      "formatted_end": "01:56:38.000",
      "text": "۵ روزه، خیلی"
    },
    {
      "id": 21,
      "start": 6998.0,
      "end": 7000.0,
      "formatted_start": "01:56:38.000",
      "formatted_end": "01:56:40.000",
      "text": "پشارت خیلی بالاه"
    },
    {
      "id": 22,
      "start": 7000.0,
      "end": 7002.0,
      "formatted_start": "01:56:40.000",
      "formatted_end": "01:56:42.000",
      "text": "چند وقت؟"
    },
    {
      "id": 23,
      "start": 7002.0,
      "end": 7004.0,
      "formatted_start": "01:56:42.000",
      "formatted_end": "01:56:44.000",
      "text": "این بابا هر جده درده"
    },
    {
      "id": 24,
      "start": 7004.0,
      "end": 7009.0,
      "formatted_start": "01:56:44.000",
      "formatted_end": "01:56:49.000",
      "text": "پشارت ۱۶ه، ضربانت هم صده، خیلی بالاست"
    },
    {
      "id": 25,
      "start": 7009.0,
      "end": 7013.0,
      "formatted_start": "01:56:49.000",
      "formatted_end": "01:56:53.000",
      "text": "باعث که خورس فشار بدن، بذار قلبتو بش بدن؟"
    },
    {
      "id": 26,
      "start": 7013.0,
      "end": 7015.0,
      "formatted_start": "01:56:53.000",
      "formatted_end": "01:56:55.000",
      "text": "خیلی بالایی"
    },
    {
      "id": 27,
      "start": 7015.0,
      "end": 7017.0,
      "formatted_start": "01:56:55.000",
      "formatted_end": "01:56:57.000",
      "text": "خیلی بالایی"
    },
    {
      "id": 28,
      "start": 7017.0,
      "end": 7023.0,
      "formatted_start": "01:56:57.000",
      "formatted_end": "01:57:03.000",
      "text": "شما همیشه اینجوری میشه قلبت میزنه یا الان دکتر اومدی اینجوری میترسی؟"
    },
    {
      "id": 29,
      "start": 7023.0,
      "end": 7025.0,
      "formatted_start": "01:57:03.000",
      "formatted_end": "01:57:05.000",
      "text": "دکتر اومدی میترسی؟"
    },
    {
      "id": 30,
      "start": 7025.0,
      "end": 7027.0,
      "formatted_start": "01:57:05.000",
      "formatted_end": "01:57:07.000",
      "text": "دکتر که برم میترسه"
    },
    {
      "id": 31,
      "start": 7027.0,
      "end": 7029.0,
      "formatted_start": "01:57:07.000",
      "formatted_end": "01:57:09.000",
      "text": "آره دکتر که برم میترسه"
    },
    {
      "id": 32,
      "start": 7029.0,
      "end": 7031.0,
      "formatted_start": "01:57:09.000",
      "formatted_end": "01:57:11.000",
      "text": "چرا میترسی؟"
    },
    {
      "id": 33,
      "start": 7031.0,
      "end": 7033.0,
      "formatted_start": "01:57:11.000",
      "formatted_end": "01:57:13.000",
      "text": "خب خورس پشارم بیدم"
    },
    {
      "id": 34,
      "start": 7033.0,
      "end": 7035.0,
      "formatted_start": "01:57:13.000",
      "formatted_end": "01:57:15.000",
      "text": "خورس تفشق قلبم بیدم بیخواد"
    },
    {
      "id": 35,
      "start": 7039.0,
      "end": 7041.0,
      "formatted_start": "01:57:19.000",
      "formatted_end": "01:57:21.000",
      "text": "شاف بدم استفاده نمی کنی؟"
    },
    {
      "id": 36,
      "start": 7041.0,
      "end": 7043.0,
      "formatted_start": "01:57:21.000",
      "formatted_end": "01:57:23.000",
      "text": "نه"
    },
    {
      "id": 37,
      "start": 7043.0,
      "end": 7045.0,
      "formatted_start": "01:57:23.000",
      "formatted_end": "01:57:25.000",
      "text": "شیاف که برات شاف از پشت بذار"
    },
    {
      "id": 38,
      "start": 7045.0,
      "end": 7047.0,
      "formatted_start": "01:57:25.000",
      "formatted_end": "01:57:27.000",
      "text": "برای کمرتو صفت میکنه"
    },
    {
      "id": 39,
      "start": 7047.0,
      "end": 7049.0,
      "formatted_start": "01:57:27.000",
      "formatted_end": "01:57:29.000",
      "text": "خوبی باره"
    },
    {
      "id": 40,
      "start": 7049.0,
      "end": 7051.0,
      "formatted_start": "01:57:29.000",
      "formatted_end": "01:57:31.000",
      "text": "سودانه دارم از اون"
    },
    {
      "id": 41,
      "start": 7051.0,
      "end": 7053.0,
      "formatted_start": "01:57:31.000",
      "formatted_end": "01:57:33.000",
      "text": "سودانه دارم داره، شافم داره، آمپولم داره"
    },
    {
      "id": 42,
      "start": 7053.0,
      "end": 7055.0,
      "formatted_start": "01:57:33.000",
      "formatted_end": "01:57:35.000",
      "text": "من خودمونم از کمرت شفتم"
    },
    {
      "id": 43,
      "start": 7055.0,
      "end": 7057.0,
      "formatted_start": "01:57:35.000",
      "formatted_end": "01:57:37.000",
      "text": "آخ"
    },
    {
      "id": 44,
      "start": 7057.0,
      "end": 7059.0,
      "formatted_start": "01:57:37.000",
      "formatted_end": "01:57:39.000",
      "text": "خب مال پینه مرد این"
    },
    {
      "id": 45,
      "start": 7059.0,
      "end": 7061.0,
      "formatted_start": "01:57:39.000",
      "formatted_end": "01:57:41.000",
      "text": "جوال رزقت به تو"
    },
    {
      "id": 46,
      "start": 7061.0,
      "end": 7063.0,
      "formatted_start": "01:57:41.000",
      "formatted_end": "01:57:43.000",
      "text": "سنی نداره که"
    },
    {
      "id": 47,
      "start": 7063.0,
      "end": 7065.0,
      "formatted_start": "01:57:43.000",
      "formatted_end": "01:57:45.000",
      "text": "چند سال کچکیم؟"
    },
    {
      "id": 48,
      "start": 7065.0,
      "end": 7067.0,
      "formatted_start": "01:57:45.000",
      "formatted_end": "01:57:47.000",
      "text": "چند سال هست تو کچکتره؟"
    },
    {
      "id": 49,
      "start": 7067.0,
      "end": 7069.0,
      "formatted_start": "01:57:47.000",
      "formatted_end": "01:57:49.000",
      "text": "ای، من کچکم"
    },
    {
      "id": 50,
      "start": 7069.0,
      "end": 7071.0,
      "formatted_start": "01:57:49.000",
      "formatted_end": "01:57:51.000",
      "text": "من از اون دوالت"
    },
    {
      "id": 51,
      "start": 7071.0,
      "end": 7073.0,
      "formatted_start": "01:57:51.000",
      "formatted_end": "01:57:53.000",
      "text": "خدا حفظتونه انشالله"
    },
    {
      "id": 52,
      "start": 7073.0,
      "end": 7075.0,
      "formatted_start": "01:57:53.000",
      "formatted_end": "01:57:55.000",
      "text": "تو هم بیای کمک های فیلمردی هست"
    },
    {
      "id": 53,
      "start": 7075.0,
      "end": 7077.0,
      "formatted_start": "01:57:55.000",
      "formatted_end": "01:57:57.000",
      "text": "بیدیم ولی بگه"
    },
    {
      "id": 54,
      "start": 7077.0,
      "end": 7079.0,
      "formatted_start": "01:57:57.000",
      "formatted_end": "01:57:59.000",
      "text": "اون پول نشده"
    },
    {
      "id": 55,
      "start": 7079.0,
      "end": 7081.0,
      "formatted_start": "01:57:59.000",
      "formatted_end": "01:58:01.000",
      "text": "بله الان دوران ویپولی مردم"
    },
    {
      "id": 56,
      "start": 7081.0,
      "end": 7083.0,
      "formatted_start": "01:58:01.000",
      "formatted_end": "01:58:03.000",
      "text": "اون پولی هست"
    },
    {
      "id": 57,
      "start": 7083.0,
      "end": 7085.0,
      "formatted_start": "01:58:03.000",
      "formatted_end": "01:58:05.000",
      "text": "اون پولی هست"
    },
    {
      "id": 58,
      "start": 7085.0,
      "end": 7087.0,
      "formatted_start": "01:58:05.000",
      "formatted_end": "01:58:07.000",
      "text": "مبازمگاه خودم بلیت بوده"
    },
    {
      "id": 59,
      "start": 7087.0,
      "end": 7089.0,
      "formatted_start": "01:58:07.000",
      "formatted_end": "01:58:09.000",
      "text": "امامتون فیلمردی"
    },
    {
      "id": 60,
      "start": 7089.0,
      "end": 7091.0,
      "formatted_start": "01:58:09.000",
      "formatted_end": "01:58:11.000",
      "text": "بله بیا خالی این دوا رو گرفتی"
    },
    {
      "id": 61,
      "start": 7091.0,
      "end": 7093.0,
      "formatted_start": "01:58:11.000",
      "formatted_end": "01:58:13.000",
      "text": "بیار من توضیح بیدم"
    },
    {
      "id": 62,
      "start": 7093.0,
      "end": 7095.0,
      "formatted_start": "01:58:13.000",
      "formatted_end": "01:58:15.000",
      "text": "بیدم"
    },
    {
      "id": 63,
      "start": 7095.0,
      "end": 7097.0,
      "formatted_start": "01:58:15.000",
      "formatted_end": "01:58:17.000",
      "text": "داخل داره"
    },
    {
      "id": 64,
      "start": 7097.0,
      "end": 7099.0,
      "formatted_start": "01:58:17.000",
      "formatted_end": "01:58:19.000",
      "text": "بیرون گم نشد"
    },
    {
      "id": 65,
      "start": 7099.0,
      "end": 7101.0,
      "formatted_start": "01:58:19.000",
      "formatted_end": "01:58:21.000",
      "text": "بیا خب"
    },
    {
      "id": 66,
      "start": 7101.0,
      "end": 7103.0,
      "formatted_start": "01:58:21.000",
      "formatted_end": "01:58:23.000",
      "text": "مرسی"
    },
    {
      "id": 67,
      "start": 7103.0,
      "end": 7105.0,
      "formatted_start": "01:58:23.000",
      "formatted_end": "01:58:25.000",
      "text": "بله"
    },
    {
      "id": 68,
      "start": 7105.0,
      "end": 7107.0,
      "formatted_start": "01:58:25.000",
      "formatted_end": "01:58:27.000",
      "text": "ای یا دی"
    },
    {
      "id": 69,
      "start": 7107.0,
      "end": 7109.0,
      "formatted_start": "01:58:27.000",
      "formatted_end": "01:58:29.000",
      "text": "نه اون دی هزاره کم"
    },
    {
      "id": 70,
      "start": 7109.0,
      "end": 7111.0,
      "formatted_start": "01:58:29.000",
      "formatted_end": "01:58:31.000",
      "text": "ویتامین ده ازمایشه چارده بود"
    },
    {
      "id": 71,
      "start": 7111.0,
      "end": 7113.0,
      "formatted_start": "01:58:31.000",
      "formatted_end": "01:58:33.000",
      "text": "باید بزنید"
    },
    {
      "id": 72,
      "start": 7113.0,
      "end": 7115.0,
      "formatted_start": "01:58:33.000",
      "formatted_end": "01:58:35.000",
      "text": "خوب باید بزنید"
    },
    {
      "id": 73,
      "start": 7115.0,
      "end": 7117.0,
      "formatted_start": "01:58:35.000",
      "formatted_end": "01:58:37.000",
      "text": "نه هیچکاری جا دهی می کنید"
    },
    {
      "id": 74,
      "start": 7117.0,
      "end": 7119.0,
      "formatted_start": "01:58:37.000",
      "formatted_end": "01:58:39.000",
      "text": "یک دونه هست"
    },
    {
      "id": 75,
      "start": 7119.0,
      "end": 7121.0,
      "formatted_start": "01:58:39.000",
      "formatted_end": "01:58:41.000",
      "text": "داروی اصلی"
    },
    {
      "id": 76,
      "start": 7121.0,
      "end": 7123.0,
      "formatted_start": "01:58:41.000",
      "formatted_end": "01:58:43.000",
      "text": "تو اینه روز یک دونه"
    },
    {
      "id": 77,
      "start": 7123.0,
      "end": 7125.0,
      "formatted_start": "01:58:43.000",
      "formatted_end": "01:58:45.000",
      "text": "می کنید برای مقصدها و استخدام"
    },
    {
      "id": 78,
      "start": 7125.0,
      "end": 7127.0,
      "formatted_start": "01:58:45.000",
      "formatted_end": "01:58:47.000",
      "text": "اینم جوان کننده"
    },
    {
      "id": 79,
      "start": 7127.0,
      "end": 7129.0,
      "formatted_start": "01:58:47.000",
      "formatted_end": "01:58:49.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 80,
      "start": 7129.0,
      "end": 7131.0,
      "formatted_start": "01:58:49.000",
      "formatted_end": "01:58:51.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 81,
      "start": 7131.0,
      "end": 7133.0,
      "formatted_start": "01:58:51.000",
      "formatted_end": "01:58:53.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 82,
      "start": 7133.0,
      "end": 7135.0,
      "formatted_start": "01:58:53.000",
      "formatted_end": "01:58:55.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 83,
      "start": 7135.0,
      "end": 7137.0,
      "formatted_start": "01:58:55.000",
      "formatted_end": "01:58:57.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 84,
      "start": 7137.0,
      "end": 7139.0,
      "formatted_start": "01:58:57.000",
      "formatted_end": "01:58:59.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 85,
      "start": 7139.0,
      "end": 7141.0,
      "formatted_start": "01:58:59.000",
      "formatted_end": "01:59:01.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 86,
      "start": 7141.0,
      "end": 7143.0,
      "formatted_start": "01:59:01.000",
      "formatted_end": "01:59:03.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 87,
      "start": 7143.0,
      "end": 7145.0,
      "formatted_start": "01:59:03.000",
      "formatted_end": "01:59:05.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 88,
      "start": 7145.0,
      "end": 7147.0,
      "formatted_start": "01:59:05.000",
      "formatted_end": "01:59:07.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 89,
      "start": 7147.0,
      "end": 7149.0,
      "formatted_start": "01:59:07.000",
      "formatted_end": "01:59:09.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 90,
      "start": 7149.0,
      "end": 7151.0,
      "formatted_start": "01:59:09.000",
      "formatted_end": "01:59:11.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 91,
      "start": 7151.0,
      "end": 7153.0,
      "formatted_start": "01:59:11.000",
      "formatted_end": "01:59:13.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 92,
      "start": 7153.0,
      "end": 7155.0,
      "formatted_start": "01:59:13.000",
      "formatted_end": "01:59:15.000",
      "text": "مرسی مرسی"
    },
    {
      "id": 93,
      "start": 7155.0,
      "end": 7157.0,
      "formatted_start": "01:59:15.000",
      "formatted_end": "01:59:17.000",
      "text": "این پرنده داره"
    },
    {
      "id": 94,
      "start": 7157.0,
      "end": 7159.0,
      "formatted_start": "01:59:17.000",
      "formatted_end": "01:59:19.000",
      "text": "تاریخ ها شده بود"
    },
    {
      "id": 95,
      "start": 7159.0,
      "end": 7161.0,
      "formatted_start": "01:59:19.000",
      "formatted_end": "01:59:21.000",
      "text": "روز شروعش چندون بوده؟"
    },
    {
      "id": 96,
      "start": 7161.0,
      "end": 7163.0,
      "formatted_start": "01:59:21.000",
      "formatted_end": "01:59:23.000",
      "text": "اینو باید بدونید"
    },
    {
      "id": 97,
      "start": 7163.0,
      "end": 7165.0,
      "formatted_start": "01:59:23.000",
      "formatted_end": "01:59:25.000",
      "text": "برم نوشته بود برم بگیرم چی شده بود"
    },
    {
      "id": 98,
      "start": 7165.0,
      "end": 7167.0,
      "formatted_start": "01:59:25.000",
      "formatted_end": "01:59:27.000",
      "text": "بفرم خاله چی شده؟"
    },
    {
      "id": 99,
      "start": 7167.0,
      "end": 7169.0,
      "formatted_start": "01:59:27.000",
      "formatted_end": "01:59:29.000",
      "text": "منیتونی سرم رو خورده"
    },
    {
      "id": 100,
      "start": 7169.0,
      "end": 7171.0,
      "formatted_start": "01:59:29.000",
      "formatted_end": "01:59:31.000",
      "text": "منیتونی سینه ش زرفه دیگه برش نمی کنیم"
    },
    {
      "id": 101,
      "start": 7171.0,
      "end": 7173.0,
      "formatted_start": "01:59:31.000",
      "formatted_end": "01:59:33.000",
      "text": "چشم"
    },
    {
      "id": 102,
      "start": 7173.0,
      "end": 7175.0,
      "formatted_start": "01:59:33.000",
      "formatted_end": "01:59:35.000",
      "text": "دهانه باز کن خاله ببینم"
    },
    {
      "id": 103,
      "start": 7175.0,
      "end": 7177.0,
      "formatted_start": "01:59:35.000",
      "formatted_end": "01:59:37.000",
      "text": "سرم برم بگیر"
    },
    {
      "id": 104,
      "start": 7177.0,
      "end": 7179.0,
      "formatted_start": "01:59:37.000",
      "formatted_end": "01:59:39.000",
      "text": "همون فاید خودش باید بری"
    },
    {
      "id": 105,
      "start": 7179.0,
      "end": 7181.0,
      "formatted_start": "01:59:39.000",
      "formatted_end": "01:59:41.000",
      "text": "برسن"
    },
    {
      "id": 106,
      "start": 7181.0,
      "end": 7183.0,
      "formatted_start": "01:59:41.000",
      "formatted_end": "01:59:43.000",
      "text": "سینه جان به درخواهیم"
    },
    {
      "id": 107,
      "start": 7183.0,
      "end": 7185.0,
      "formatted_start": "01:59:43.000",
      "formatted_end": "01:59:45.000",
      "text": "یک صرفه بزن"
    },
    {
      "id": 108,
      "start": 7187.0,
      "end": 7189.0,
      "formatted_start": "01:59:47.000",
      "formatted_end": "01:59:49.000",
      "text": "درسته بزن"
    }
  ],
  "status": "completed"
}