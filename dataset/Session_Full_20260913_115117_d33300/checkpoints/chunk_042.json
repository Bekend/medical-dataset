  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12618.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:18.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12630.0,
      "end": 12634.0,
      "formatted_start": "03:30:30.000",
      "formatted_end": "03:30:34.000",
      "text": "بله، اینکه بیاد اینجا بگیره برای آن شیطان که اینجا بگیره"
    },
    {
      "id": 2,
      "start": 12634.0,
      "end": 12636.0,
      "formatted_start": "03:30:34.000",
      "formatted_end": "03:30:36.000",
      "text": "آه، این رو گفتم اینجا بگیره"
    },
    {
      "id": 3,
      "start": 12636.0,
      "end": 12639.0,
      "formatted_start": "03:30:36.000",
      "formatted_end": "03:30:39.000",
      "text": "داشته باش، گفت نکنه، امزا بکنم بگیرم"
    },
    {
      "id": 4,
      "start": 12639.0,
      "end": 12642.0,
      "formatted_start": "03:30:39.000",
      "formatted_end": "03:30:42.000",
      "text": "بله، خودکاره چرا این هست؟ خودکاره چرا برداشتی؟"
    },
    {
      "id": 5,
      "start": 12642.0,
      "end": 12644.0,
      "formatted_start": "03:30:42.000",
      "formatted_end": "03:30:44.000",
      "text": "نه، کنجا بیده، کنجا برداشت"
    },
    {
      "id": 6,
      "start": 12644.0,
      "end": 12646.0,
      "formatted_start": "03:30:44.000",
      "formatted_end": "03:30:46.000",
      "text": "چون خودکاره تمام شده دیگه"
    },
    {
      "id": 7,
      "start": 12646.0,
      "end": 12650.0,
      "formatted_start": "03:30:46.000",
      "formatted_end": "03:30:50.000",
      "text": "خانم موقع تن خودکاره جدید آوردم، خودکاره کنشی؟"
    },
    {
      "id": 8,
      "start": 12650.0,
      "end": 12652.0,
      "formatted_start": "03:30:50.000",
      "formatted_end": "03:30:52.000",
      "text": "نه، خودکاره"
    },
    {
      "id": 9,
      "start": 12652.0,
      "end": 12653.0,
      "formatted_start": "03:30:52.000",
      "formatted_end": "03:30:53.000",
      "text": "اینجا خودکاره تمام شده؟"
    },
    {
      "id": 10,
      "start": 12653.0,
      "end": 12656.5,
      "formatted_start": "03:30:53.000",
      "formatted_end": "03:30:56.500",
      "text": "نه این از پرلم یا منتی دست هم که دیگه هستیم"
    },
    {
      "id": 11,
      "start": 12656.5,
      "end": 12659.0,
      "formatted_start": "03:30:56.500",
      "formatted_end": "03:30:59.000",
      "text": "تنظیم سامونه تنظیم شده جدید برم"
    },
    {
      "id": 12,
      "start": 12659.0,
      "end": 12659.58,
      "formatted_start": "03:30:59.000",
      "formatted_end": "03:30:59.580",
      "text": "برم"
    },
    {
      "id": 13,
      "start": 12659.58,
      "end": 12660.02,
      "formatted_start": "03:30:59.580",
      "formatted_end": "03:31:00.020",
      "text": "از این"
    },
    {
      "id": 14,
      "start": 12660.02,
      "end": 12661.72,
      "formatted_start": "03:31:00.020",
      "formatted_end": "03:31:01.720",
      "text": "یه دو دو دو چند"
    },
    {
      "id": 15,
      "start": 12721.72,
      "end": 12751.7,
      "formatted_start": "03:32:01.720",
      "formatted_end": "03:32:31.700",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 16,
      "start": 12751.72,
      "end": 12781.7,
      "formatted_start": "03:32:31.720",
      "formatted_end": "03:33:01.700",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 17,
      "start": 12781.72,
      "end": 12811.7,
      "formatted_start": "03:33:01.720",
      "formatted_end": "03:33:31.700",
