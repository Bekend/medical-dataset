      "id": 44,
      "start": 9165.42,
      "end": 9167.42,
      "formatted_start": "02:32:45.420",
      "formatted_end": "02:32:47.420",
      "text": "باید برسید."
    },
    {
      "id": 45,
      "start": 9167.42,
      "end": 9169.42,
      "formatted_start": "02:32:47.420",
      "formatted_end": "02:32:49.420",
      "text": "باید برسید."
    },
    {
      "id": 46,
      "start": 9169.42,
      "end": 9171.42,
      "formatted_start": "02:32:49.420",
      "formatted_end": "02:32:51.420",
      "text": "باید برسید."
    },
    {
      "id": 47,
      "start": 9171.42,
      "end": 9178.42,
      "formatted_start": "02:32:51.420",
      "formatted_end": "02:32:58.420",
      "text": "این روزه رو میبینیم که اون پارا پارا پارا تنها نمیدونی که کافیه"
    },
    {
      "id": 48,
      "start": 9178.42,
      "end": 9179.42,
      "formatted_start": "02:32:58.420",
      "formatted_end": "02:32:59.420",
      "text": "کافیه"
    },
    {
      "id": 49,
      "start": 9179.42,
      "end": 9186.42,
      "formatted_start": "02:32:59.420",
      "formatted_end": "02:33:06.420",
      "text": "حالا برون چون تجایی که میتونیم بشیم باید براتون را هر کسی برس کنیم بشیم"
    },
    {
      "id": 50,
      "start": 9186.42,
      "end": 9190.42,
      "formatted_start": "02:33:06.420",
      "formatted_end": "02:33:10.420",
      "text": "براتون تونم خوش را گذار بشیم میکنم یک فیلم بشم"
    },
    {
      "id": 51,
      "start": 9190.42,
      "end": 9196.42,
      "formatted_start": "02:33:10.420",
      "formatted_end": "02:33:16.420",
      "text": "کسی تونم این فیلم ها میشه باز بشه به شما بگیرد"
    },
    {
      "id": 52,
      "start": 9196.42,
      "end": 9202.84,
      "formatted_start": "02:33:16.420",
      "formatted_end": "02:33:22.840",
      "text": "یک چیزی اینجا یاد میگیدی و این وردش رو هر روز باید سه بار انجام بدی"
    },
    {
      "id": 53,
      "start": 9202.84,
      "end": 9205.38,
      "formatted_start": "02:33:22.840",
      "formatted_end": "02:33:25.380",
      "text": "دو دقیقه صبح، دو دقیقه زمان، دو دقیقه آشنا"
    },
    {
      "id": 54,
      "start": 9205.38,
      "end": 9208.14,
      "formatted_start": "02:33:25.380",
      "formatted_end": "02:33:28.140",
      "text": "بعد از چهار، پنج روز، این روز باید صبح و شب"
    },
    {
      "id": 55,
      "start": 9208.14,
      "end": 9213.46,
      "formatted_start": "02:33:28.140",
      "formatted_end": "02:33:33.460",
      "text": "بعد از تقریبا دو هفته که انجام بدی، یه بار در روز بعد این وردش بگیر"
    },
    {
      "id": 56,
      "start": 9213.46,
      "end": 9219.42,
      "formatted_start": "02:33:33.460",
      "formatted_end": "02:33:39.420",
      "text": "و اینجا میبینیم سه بار، درست چی خواهد شد؟"
    },
    {
      "id": 57,
      "start": 9219.42,
      "end": 9220.3,
      "formatted_start": "02:33:39.420",
      "formatted_end": "02:33:40.300",
      "text": "دکمان"
    },
    {
      "id": 58,
      "start": 9220.3,
      "end": 9221.74,
      "formatted_start": "02:33:40.300",
      "formatted_end": "02:33:41.740",
      "text": "جلش نیست؟"
    },
    {
      "id": 59,
      "start": 9221.74,
      "end": 9222.7,
      "formatted_start": "02:33:41.740",
      "formatted_end": "02:33:42.700",
      "text": "دکمان"
    },
    {
      "id": 60,
      "start": 9222.7,
      "end": 9224.42,
      "formatted_start": "02:33:42.700",
      "formatted_end": "02:33:44.420",
      "text": "دکمان چیست؟ همه ایش نیست"
    },
    {
      "id": 61,
      "start": 9224.42,
      "end": 9254.42,
      "formatted_start": "02:33:44.420",
      "formatted_end": "02:34:14.420",
