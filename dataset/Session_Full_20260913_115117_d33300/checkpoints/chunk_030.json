  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9021.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:21.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 9021.0,
      "end": 9024.0,
      "formatted_start": "02:30:21.000",
      "formatted_end": "02:30:24.000",
      "text": "زنبودارو تو کدوم منطقه هنجم میزین؟"
    },
    {
      "id": 2,
      "start": 9024.0,
      "end": 9025.0,
      "formatted_start": "02:30:24.000",
      "formatted_end": "02:30:25.000",
      "text": "آمین"
    },
    {
      "id": 3,
      "start": 9025.0,
      "end": 9026.0,
      "formatted_start": "02:30:25.000",
      "formatted_end": "02:30:26.000",
      "text": "بالا ایرانی ها؟"
    },
    {
      "id": 4,
      "start": 9026.0,
      "end": 9027.0,
      "formatted_start": "02:30:26.000",
      "formatted_end": "02:30:27.000",
      "text": "بالا بله"
    },
    {
      "id": 5,
      "start": 9027.0,
      "end": 9028.0,
      "formatted_start": "02:30:27.000",
      "formatted_end": "02:30:28.000",
      "text": "به سمت شیشه ها؟"
    },
    {
      "id": 6,
      "start": 9028.0,
      "end": 9030.0,
      "formatted_start": "02:30:28.000",
      "formatted_end": "02:30:30.000",
      "text": "نه، مستانت های نیرورک"
    },
    {
      "id": 7,
      "start": 9030.0,
      "end": 9034.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:34.000",
      "text": "نه، نیرورک، خب بر نگردی در اول"
    },
    {
      "id": 8,
      "start": 9034.0,
      "end": 9036.0,
      "formatted_start": "02:30:34.000",
      "formatted_end": "02:30:36.000",
      "text": "از همینجا به شکم بخواد"
    },
    {
      "id": 9,
      "start": 9036.0,
      "end": 9038.0,
      "formatted_start": "02:30:36.000",
      "formatted_end": "02:30:38.000",
      "text": "باید تو بچه کن به شکم بخواد"
    },
    {
      "id": 10,
      "start": 9038.0,
      "end": 9041.0,
      "formatted_start": "02:30:38.000",
      "formatted_end": "02:30:41.000",
      "text": "بشه کن، سر بگی، بیر به زمان تو بگی"
    },
    {
      "id": 11,
      "start": 9041.0,
      "end": 9044.0,
      "formatted_start": "02:30:41.000",
      "formatted_end": "02:30:44.000",
      "text": "تا تو رست اونطور آویزان بگو"
    },
    {
      "id": 12,
      "start": 9044.0,
      "end": 9047.0,
      "formatted_start": "02:30:44.000",
      "formatted_end": "02:30:47.000",
      "text": "بیرون شو، آویزان بگو، بیرون شو"
    },
    {
      "id": 13,
      "start": 9047.0,
      "end": 9050.0,
      "formatted_start": "02:30:47.000",
      "formatted_end": "02:30:50.000",
      "text": "آفره، سرت به زمین آویزان بگو"
    },
    {
      "id": 14,
      "start": 9050.0,
      "end": 9052.0,
      "formatted_start": "02:30:50.000",
      "formatted_end": "02:30:52.000",
      "text": "آویزان بگو، بندز بگو"
    },
    {
      "id": 15,
      "start": 9052.0,
      "end": 9054.0,
      "formatted_start": "02:30:52.000",
      "formatted_end": "02:30:54.000",
      "text": "بندز بگو، شروع شو"
    },
    {
      "id": 16,
      "start": 9058.0,
      "end": 9062.5,
      "formatted_start": "02:30:58.000",
      "formatted_end": "02:31:02.500",
      "text": "شد به پایین شد به اینگاه که یک دو در جون مثلا"
    },
    {
      "id": 17,
      "start": 9062.5,
      "end": 9067.5,
      "formatted_start": "02:31:02.500",
      "formatted_end": "02:31:07.500",
      "text": "مرده رو بیندازن پشت عصب که جور آویزم بکنن همینجور"
    },
    {
      "id": 18,
      "start": 9072.5,
      "end": 9075.5,
      "formatted_start": "02:31:12.500",
      "formatted_end": "02:31:15.500",
      "text": "خب این انگاشت رو بذار بینجور"
    },
    {
      "id": 19,
      "start": 9075.5,
      "end": 9077.5,
      "formatted_start": "02:31:15.500",
      "formatted_end": "02:31:17.500",
      "text": "بذار بینجور"
    },
    {
      "id": 20,
      "start": 9077.5,
      "end": 9080.5,
      "formatted_start": "02:31:17.500",
      "formatted_end": "02:31:20.500",
      "text": "که زیاد فشار نده یک کم با همینجور"
    },
    {
      "id": 21,
      "start": 9088.0,
      "end": 9099.3,
      "formatted_start": "02:31:28.000",
      "formatted_end": "02:31:39.300",
      "text": "مردم بردن سطح پایین تری رد مون کرد"
    },
    {
      "id": 22,
      "start": 9099.3,
      "end": 9112.58,
      "formatted_start": "02:31:39.300",
      "formatted_end": "02:31:52.580",
      "text": "نفس امیر بیش نگهت"
    },
    {
      "id": 23,
      "start": 9112.58,
      "end": 9114.9,
      "formatted_start": "02:31:52.580",
      "formatted_end": "02:31:54.900",
      "text": "پرد"
    },
    {
      "id": 24,
      "start": 9114.9,
      "end": 9117.42,
      "formatted_start": "02:31:54.900",
      "formatted_end": "02:31:57.420",
      "text": "نگهت داره نگهت داره نگهت داره"
    },
    {
      "id": 25,
      "start": 9117.42,
      "end": 9119.42,
      "formatted_start": "02:31:57.420",
      "formatted_end": "02:31:59.420",
      "text": "دیگه دار دیگه دار"
    },
    {
      "id": 26,
      "start": 9119.42,
      "end": 9123.42,
      "formatted_start": "02:31:59.420",
      "formatted_end": "02:32:03.420",
      "text": "آرام را کنم"
    },
    {
      "id": 27,
      "start": 9123.42,
      "end": 9127.42,
      "formatted_start": "02:32:03.420",
      "formatted_end": "02:32:07.420",
      "text": "خواهش ندید"
    },
    {
      "id": 28,
      "start": 9127.42,
      "end": 9131.42,
      "formatted_start": "02:32:07.420",
      "formatted_end": "02:32:11.420",
      "text": "بشید پشت بفرد"
    },
    {
      "id": 29,
      "start": 9131.42,
      "end": 9133.42,
      "formatted_start": "02:32:11.420",
      "formatted_end": "02:32:13.420",
      "text": "بشید پشت بفرد"
    },
    {
      "id": 30,
      "start": 9133.42,
      "end": 9137.42,
      "formatted_start": "02:32:13.420",
