    },
    {
      "id": 62,
      "start": 9254.42,
      "end": 9256.42,
      "formatted_start": "02:34:14.420",
      "formatted_end": "02:34:16.420",
      "text": "اینجا باید بگیریم و اینجا باید بگیریم"
    },
    {
      "id": 63,
      "start": 9256.42,
      "end": 9258.42,
      "formatted_start": "02:34:16.420",
      "formatted_end": "02:34:18.420",
