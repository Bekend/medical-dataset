      "start": 3425.0,
      "end": 3429.0,
      "formatted_start": "00:57:05.000",
      "formatted_end": "00:57:09.000",
      "text": "ای بانو بنده ای بانو سفرده"
    },
    {
      "id": 7,
      "start": 3429.66,
      "end": 3434.38,
      "formatted_start": "00:57:09.660",
      "formatted_end": "00:57:14.380",
      "text": "سرار پایان بشه خیلی درده"
    },
    {
