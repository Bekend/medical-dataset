  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9314.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:14.000",
      "text": "برمیگرده به شکم میخواهه، به صورتش نمیشه، به زمین نگاه میکنه، تا لبی تخت چسی صورت به زمین نگاه میکنه، بعد پاش آویزا همونگاه میشینه."
    },
    {
      "id": 1,
      "start": 9314.0,
      "end": 9316.0,
      "formatted_start": "02:35:14.000",
      "formatted_end": "02:35:16.000",
      "text": "تو خود یک تخت داری؟"
    },
    {
      "id": 2,
      "start": 9316.0,
      "end": 9317.0,
      "formatted_start": "02:35:16.000",
      "formatted_end": "02:35:17.000",
      "text": "آرسون آرسون"
    },
    {
      "id": 3,
      "start": 9317.0,
      "end": 9324.0,
      "formatted_start": "02:35:17.000",
      "formatted_end": "02:35:24.000",
      "text": "در باشه هم میتونیم بشین، اولا ببین آویز میشه، پا بهتر میشه، اگر پاش آویزا کنه، آنها نشست."
    },
    {
      "id": 4,
      "start": 9324.0,
      "end": 9354.0,
      "formatted_start": "02:35:24.000",
      "formatted_end": "02:35:54.000",
      "text": "پا منتخب برگرده بود، پس یه بار به راست، چهار بار به شان میتونید، مایه اتقام میخورد، پا پشت سر پشت داده، رو بادش نزده شان سرشون رو باز داده پشت به راست به چپ زمینه میشسته، چهار دقیقه، هر کدوم سی ثانیه، میشه دو دقیقه، پا سه بار در روز این دو دقیقه باید تکرار رو کنید، پا این طبعه شده این بار منم با هم یکی گنجا میده تمرین میکنید، پا اسمش بود مان"
    },
    {
      "id": 5,
      "start": 9354.0,
      "end": 9362.0,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:36:02.000",
      "text": "این پرک پرک کتر برای علیت بذاره باشه"
    },
    {
      "id": 6,
      "start": 9362.0,
      "end": 9364.0,
      "formatted_start": "02:36:02.000",
      "formatted_end": "02:36:04.000",
      "text": "افریقی از هر جزئی افریقی بیار"
    },
    {
      "id": 7,
      "start": 9364.0,
      "end": 9366.0,
      "formatted_start": "02:36:04.000",
      "formatted_end": "02:36:06.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 8,
      "start": 9366.0,
      "end": 9368.0,
      "formatted_start": "02:36:06.000",
      "formatted_end": "02:36:08.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 9,
      "start": 9368.0,
      "end": 9370.0,
      "formatted_start": "02:36:08.000",
      "formatted_end": "02:36:10.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 10,
      "start": 9370.0,
      "end": 9372.0,
      "formatted_start": "02:36:10.000",
      "formatted_end": "02:36:12.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 11,
      "start": 9372.0,
      "end": 9374.0,
      "formatted_start": "02:36:12.000",
      "formatted_end": "02:36:14.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 12,
      "start": 9374.0,
      "end": 9376.0,
      "formatted_start": "02:36:14.000",
      "formatted_end": "02:36:16.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 13,
      "start": 9376.0,
      "end": 9378.0,
      "formatted_start": "02:36:16.000",
      "formatted_end": "02:36:18.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 14,
      "start": 9378.0,
      "end": 9380.0,
      "formatted_start": "02:36:18.000",
      "formatted_end": "02:36:20.000",
      "text": "افریقی در جزئی افریقی بیار"
    },
    {
      "id": 15,
      "start": 9380.0,
      "end": 9387.0,
      "formatted_start": "02:36:20.000",
      "formatted_end": "02:36:27.000",
      "text": "همین. آفتارون این یک. سی ثانیه شروع می کند. از اینجا تا اینجا برسی میشه سی ثانیه."
    },
    {
      "id": 16,
      "start": 9387.0,
      "end": 9397.0,
      "formatted_start": "02:36:27.000",
      "formatted_end": "02:36:37.000",
      "text": "یکی کمک میتونه یا با دست ساعت داشته باشید، موباره داشته باشید. سی ثانیه دیگر. یا تو دل تا شصبش باید میشه سی ثانیه."
    },
    {
      "id": 17,
      "start": 9397.0,
      "end": 9406.0,
      "formatted_start": "02:36:37.000",
      "formatted_end": "02:36:46.000",
      "text": "سی ثانیه سر. این ورزش رو اگه انجام بدید، دوباره این سرگیجه بر میگرد. اون گیجی سر بر میگرد."
    },
    {
      "id": 18,
      "start": 9406.0,
      "end": 9409.0,
      "formatted_start": "02:36:46.000",
      "formatted_end": "02:36:49.000",
      "text": "این مرزش برده یکی دیگه"
    },
    {
      "id": 19,
      "start": 9413.0,
      "end": 9421.0,
      "formatted_start": "02:36:53.000",
      "formatted_end": "02:37:01.000",
      "text": "خب، حالا این برد برمیگرده به سطح همون مقدار که برده راست بود، همون مقدارم به چهر میگویم"
    },
    {
      "id": 20,
      "start": 9421.0,
      "end": 9424.0,
      "formatted_start": "02:37:01.000",
      "formatted_end": "02:37:04.000",
      "text": "سی سالی هم باقی بیمون شد"
    },
    {
      "id": 21,
      "start": 9425.0,
      "end": 9434.0,
      "formatted_start": "02:37:05.000",
      "formatted_end": "02:37:14.000",
      "text": "بعد سی سالی بعدی لبه تخت برم میگرده روز زمین رو نگاه میکنه، شکر کنه کنه بیز هر چی باشه، فقط صورت میگه زمین نگاه میکنه"
    },
    {
      "id": 22,
      "start": 9436.0,
      "end": 9438.0,
      "formatted_start": "02:37:16.000",
      "formatted_end": "02:37:18.000",
      "text": "بله"
    },
    {
      "id": 23,
      "start": 9438.0,
      "end": 9440.0,
      "formatted_start": "02:37:18.000",
      "formatted_end": "02:37:20.000",
      "text": "بله"
    },
    {
      "id": 24,
      "start": 9440.0,
      "end": 9444.0,
      "formatted_start": "02:37:20.000",
      "formatted_end": "02:37:24.000",
      "text": "این شعر با مترونیلاسو با سیلکسید با هم"
    },
    {
      "id": 25,
      "start": 9444.0,
      "end": 9446.0,
      "formatted_start": "02:37:24.000",
      "formatted_end": "02:37:26.000",
      "text": "کلیبه با هم بزنه"
    },
    {
      "id": 26,
      "start": 9446.0,
      "end": 9450.0,
      "formatted_start": "02:37:26.000",
      "formatted_end": "02:37:30.000",
      "text": "اینو یک سال بعد یا قبل از اینها بزنه"
    },
    {
      "id": 27,
      "start": 9450.0,
      "end": 9452.0,
      "formatted_start": "02:37:30.000",
      "formatted_end": "02:37:32.000",
      "text": "بعد این کرمان"
    },
    {
      "id": 28,
      "start": 9452.0,
      "end": 9454.0,
      "formatted_start": "02:37:32.000",
      "formatted_end": "02:37:34.000",
      "text": "اونها کرمان خودشو این دستورو قبلی ده"
    },
    {
      "id": 29,
      "start": 9454.0,
      "end": 9456.0,
      "formatted_start": "02:37:34.000",
      "formatted_end": "02:37:36.000",
      "text": "اینو بگیر"
    },
    {
      "id": 30,
      "start": 9456.0,
      "end": 9458.0,
      "formatted_start": "02:37:36.000",
      "formatted_end": "02:37:38.000",
      "text": "اینو بگیر"
    },
    {
      "id": 31,
      "start": 9458.0,
      "end": 9460.0,
      "formatted_start": "02:37:38.000",
      "formatted_end": "02:37:40.000",
      "text": "حالا دستورو بگیر"
    },
    {
      "id": 32,
      "start": 9460.0,
      "end": 9462.0,
      "formatted_start": "02:37:40.000",
      "formatted_end": "02:37:42.000",
      "text": "بگیر به زمین نگاه کن"
    },
    {
      "id": 33,
      "start": 9462.0,
      "end": 9464.0,
      "formatted_start": "02:37:42.000",
      "formatted_end": "02:37:44.000",
      "text": "اونجا ترسو بشه"
    },
    {
      "id": 34,
      "start": 9464.0,
      "end": 9466.0,
      "formatted_start": "02:37:44.000",
      "formatted_end": "02:37:46.000",
      "text": "هیچ نیمی کنید، باید شده بشم"
    },
    {
      "id": 35,
      "start": 9466.0,
      "end": 9468.0,
      "formatted_start": "02:37:46.000",
      "formatted_end": "02:37:48.000",
      "text": "باید بزن بزن بزن بزن بزن بزن"
    },
    {
      "id": 36,
      "start": 9468.0,
      "end": 9471.0,
      "formatted_start": "02:37:48.000",
      "formatted_end": "02:37:51.000",
      "text": "آهان، کاملا سرعت زمینی بگیر"
    },
    {
      "id": 37,
      "start": 9471.0,
      "end": 9474.0,
      "formatted_start": "02:37:51.000",
      "formatted_end": "02:37:54.000",
      "text": "سی ثانی هم اینجاست، باید میشینید"
    },
    {
      "id": 38,
      "start": 9476.0,
      "end": 9479.0,
      "formatted_start": "02:37:56.000",
      "formatted_end": "02:37:59.000",
      "text": "تو رقم خواب خود، تموم خواب از خواب بیدار شدید"
    },
    {
      "id": 39,
      "start": 9479.0,
      "end": 9481.0,
      "formatted_start": "02:37:59.000",
      "formatted_end": "02:38:01.000",
      "text": "صبح باید این کار رو انجام بدید"
    },
    {
      "id": 40,
      "start": 9481.0,
      "end": 9484.0,
      "formatted_start": "02:38:01.000",
      "formatted_end": "02:38:04.000",
      "text": "بلند شدید بیدید، هر کار رو بی کنید، کارات رو بازی کنید"
    },
    {
      "id": 41,
      "start": 9484.0,
      "end": 9486.0,
      "formatted_start": "02:38:04.000",
      "formatted_end": "02:38:06.000",
      "text": "بعد زمان باز میخوایید نهار بخورید"
    },
    {
      "id": 42,
      "start": 9486.0,
      "end": 9490.0,
      "formatted_start": "02:38:06.000",
      "formatted_end": "02:38:10.000",
      "text": "با شکم خالی این حرکت انجام بدید، یا نهار بخورید."
    },
    {
      "id": 43,
      "start": 9490.0,
      "end": 9495.0,
      "formatted_start": "02:38:10.000",
      "formatted_end": "02:38:15.000",
      "text": "باز شب میخوایید، به خوابی هم میتونید، با شما میتونید."
    },
    {
      "id": 44,
      "start": 9495.0,
      "end": 9499.0,
      "formatted_start": "02:38:15.000",
      "formatted_end": "02:38:19.000",
      "text": "سی سالیه ها را آیت کن."
    },
    {
      "id": 45,
      "start": 9499.0,
      "end": 9502.0,
      "formatted_start": "02:38:19.000",
      "formatted_end": "02:38:22.000",
      "text": "سه تا سی سالیه اینجوری، سی سالیه هم نشست دارید."
    },
    {
      "id": 46,
      "start": 9502.0,
      "end": 9505.0,
      "formatted_start": "02:38:22.000",
      "formatted_end": "02:38:25.000",
      "text": "الان بگویید هم سی سالیه میشه."
    },
    {
      "id": 47,
      "start": 9505.0,
      "end": 9507.0,
      "formatted_start": "02:38:25.000",
      "formatted_end": "02:38:27.000",
      "text": "من دارم ساعت میگیرم برات خود."
    },
    {
      "id": 48,
      "start": 9507.0,
      "end": 9510.0,
      "formatted_start": "02:38:27.000",
      "formatted_end": "02:38:30.000",
      "text": "خودت میتونید تو دل تا شست بشید."
    },
    {
      "id": 49,
      "start": 9510.0,
      "end": 9515.0,
      "formatted_start": "02:38:30.000",
      "formatted_end": "02:38:35.000",
      "text": "تا سیده هم تا شست بشید."
    },
    {
      "id": 50,
      "start": 9515.0,
      "end": 9517.0,
      "formatted_start": "02:38:35.000",
      "formatted_end": "02:38:37.000",
      "text": "تا تاویزم کنو"
    },
    {
      "id": 51,
      "start": 9517.0,
      "end": 9519.0,
      "formatted_start": "02:38:37.000",
      "formatted_end": "02:38:39.000",
      "text": "بشین"
    },
    {
      "id": 52,
      "start": 9519.0,
      "end": 9521.0,
      "formatted_start": "02:38:39.000",
      "formatted_end": "02:38:41.000",
      "text": "برد بشین"
    },
    {
      "id": 53,
      "start": 9521.0,
      "end": 9523.0,
      "formatted_start": "02:38:41.000",
      "formatted_end": "02:38:43.000",
      "text": "تمام"
    },
    {
      "id": 54,
      "start": 9523.0,
      "end": 9525.0,
      "formatted_start": "02:38:43.000",
      "formatted_end": "02:38:45.000",
      "text": "سی ثانیه باید"
    },
    {
      "id": 55,
      "start": 9525.0,
      "end": 9527.0,
      "formatted_start": "02:38:45.000",
      "formatted_end": "02:38:47.000",
      "text": "تصدیق ببینید یه بار به راست بود"
    },
    {
      "id": 56,
      "start": 9527.0,
      "end": 9529.0,
      "formatted_start": "02:38:47.000",
      "formatted_end": "02:38:49.000",
      "text": "به راست بکشید"
    },
    {
      "id": 57,
      "start": 9529.0,
      "end": 9531.0,
      "formatted_start": "02:38:49.000",
      "formatted_end": "02:38:51.000",
      "text": "به چند به شکم"
    },
    {
      "id": 58,
      "start": 9531.0,
      "end": 9533.0,
      "formatted_start": "02:38:51.000",
      "formatted_end": "02:38:53.000",
      "text": "نشستید چند تا سی ثانیه"
    },
    {
      "id": 59,
      "start": 9533.0,
      "end": 9535.0,
      "formatted_start": "02:38:53.000",
      "formatted_end": "02:38:55.000",
      "text": "یادت میماره یادت را"
    },
    {
      "id": 60,
      "start": 9535.0,
      "end": 9537.0,
      "formatted_start": "02:38:55.000",
      "formatted_end": "02:38:57.000",
      "text": "میزنیم آن رو بگیم"
    },
    {
      "id": 61,
      "start": 9537.0,
      "end": 9539.0,
      "formatted_start": "02:38:57.000",
      "formatted_end": "02:38:59.000",
      "text": "این یه ورزش سلویج است"
    },
    {
      "id": 62,
      "start": 9539.0,
      "end": 9541.0,
      "formatted_start": "02:38:59.000",
      "formatted_end": "02:39:01.000",
      "text": "اگه این کار را انجام ندیم"
    },
    {
      "id": 63,
      "start": 9541.0,
      "end": 9543.0,
      "formatted_start": "02:39:01.000",
      "formatted_end": "02:39:03.000",
      "text": "مایه که جهان ناختیم برد میگن"
    },
    {
      "id": 64,
      "start": 9543.0,
      "end": 9546.0,
      "formatted_start": "02:39:03.000",
      "formatted_end": "02:39:06.000",
      "text": "این کار رو جمع بدیم، رفت نمیشه، برنامه."
    },
    {
      "id": 65,
      "start": 9546.0,
      "end": 9553.0,
      "formatted_start": "02:39:06.000",
      "formatted_end": "02:39:13.000",
      "text": "اگر بقیه خدایی نکرده دیدی، یه زرده بی جیسن، بی جیس دستن، یه باری کار، مثلاً نو باری، نو باری،"
    },
    {
      "id": 66,
      "start": 9553.0,
      "end": 9556.0,
      "formatted_start": "02:39:13.000",
      "formatted_end": "02:39:16.000",
      "text": "یه بار، نو باری کار انجام بدی، دیگه نمیاد."
    },
    {
      "id": 67,
      "start": 9556.0,
      "end": 9562.0,
      "formatted_start": "02:39:16.000",
      "formatted_end": "02:39:22.000",
      "text": "سی ثانی شد، بهتران بی کن، سرزد، آزاد، آزاد."
    },
    {
      "id": 68,
      "start": 9562.0,
      "end": 9564.0,
      "formatted_start": "02:39:22.000",
      "formatted_end": "02:39:24.000",
      "text": "میتونی؟"
    },
    {
      "id": 69,
      "start": 9564.0,
      "end": 9565.0,
      "formatted_start": "02:39:24.000",
      "formatted_end": "02:39:25.000",
      "text": "بفرما؟"
    },
    {
      "id": 70,
      "start": 9565.0,
      "end": 9567.0,
      "formatted_start": "02:39:25.000",
      "formatted_end": "02:39:27.000",
      "text": "مثلاً، خوش زنان، آنگران،"
    },
    {
      "id": 71,
      "start": 9567.0,
      "end": 9569.0,
      "formatted_start": "02:39:27.000",
      "formatted_end": "02:39:29.000",
      "text": "آخ، یادون آنگران، آزاد."
    },
    {
      "id": 72,
      "start": 9569.0,
      "end": 9574.0,
      "formatted_start": "02:39:29.000",
      "formatted_end": "02:39:34.000",
      "text": "تمام شد. سر تهاره چند براز توی سانه بار که بکنیم شده راستون؟"
    },
    {
      "id": 73,
      "start": 9577.0,
      "end": 9579.0,
      "formatted_start": "02:39:37.000",
      "formatted_end": "02:39:39.000",
      "text": "سنگیلی سرد؟"
    },
    {
      "id": 74,
      "start": 9579.0,
      "end": 9586.0,
      "formatted_start": "02:39:39.000",
      "formatted_end": "02:39:46.000",
      "text": "سنگیلی سرد یه مدار حسر دارو آمس، یه مدار حسر سرد پیچه هست، بعد یه بشمش دارو آمس رایت می کنیم."
    },
    {
      "id": 75,
      "start": 9586.0,
      "end": 9600.0,
      "formatted_start": "02:39:46.000",
      "formatted_end": "02:40:00.000",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    }
  ],
  "status": "completed"
}