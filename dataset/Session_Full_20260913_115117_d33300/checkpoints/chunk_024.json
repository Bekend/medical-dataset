  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7210.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:10.000",
      "text": "بشارش هم یکم بالاست."
    },
    {
      "id": 1,
      "start": 7210.0,
      "end": 7212.0,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:12.000",
      "text": "پشار کمشی داره، آنها باید بخوریم."
    },
    {
      "id": 2,
      "start": 7212.0,
      "end": 7216.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:16.000",
      "text": "مخزه، مخزه، یکمی بالا، نمک نباید بخوریم."
    },
    {
      "id": 3,
      "start": 7216.0,
      "end": 7219.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:19.000",
      "text": "بعد تبالرز که نمیکنی آچانا."
    },
    {
      "id": 4,
      "start": 7219.0,
      "end": 7221.0,
      "formatted_start": "02:00:19.000",
      "formatted_end": "02:00:21.000",
      "text": "تبالرز هم برگردیم، صبح صبح ماندن برگردیم."
    },
    {
      "id": 5,
      "start": 7221.0,
      "end": 7223.0,
      "formatted_start": "02:00:21.000",
      "formatted_end": "02:00:23.000",
      "text": "نه، نه، نه، کمش برگردیم."
    },
    {
      "id": 6,
      "start": 7223.0,
      "end": 7224.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:24.000",
      "text": "توفیشی کنیم."
    },
    {
      "id": 7,
      "start": 7224.0,
      "end": 7225.0,
      "formatted_start": "02:00:24.000",
      "formatted_end": "02:00:25.000",
      "text": "صبح صبح ماندن برگردیم."
    },
    {
      "id": 8,
      "start": 7225.0,
      "end": 7229.0,
      "formatted_start": "02:00:25.000",
      "formatted_end": "02:00:29.000",
      "text": "بله، آق زدنش مانده کلشش برگردیم."
    },
    {
      "id": 9,
      "start": 7229.0,
      "end": 7233.0,
      "formatted_start": "02:00:29.000",
      "formatted_end": "02:00:33.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 10,
      "start": 7233.0,
      "end": 7237.0,
      "formatted_start": "02:00:33.000",
      "formatted_end": "02:00:37.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 11,
      "start": 7237.0,
      "end": 7241.0,
      "formatted_start": "02:00:37.000",
      "formatted_end": "02:00:41.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 12,
      "start": 7241.0,
      "end": 7245.0,
      "formatted_start": "02:00:41.000",
      "formatted_end": "02:00:45.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 13,
      "start": 7245.0,
      "end": 7249.0,
      "formatted_start": "02:00:45.000",
      "formatted_end": "02:00:49.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 14,
      "start": 7249.0,
      "end": 7253.0,
      "formatted_start": "02:00:49.000",
      "formatted_end": "02:00:53.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 15,
      "start": 7253.0,
      "end": 7257.0,
      "formatted_start": "02:00:53.000",
      "formatted_end": "02:00:57.000",
      "text": "از این حالت باید بردارید."
    },
    {
      "id": 16,
      "start": 7257.0,
      "end": 7264.0,
      "formatted_start": "02:00:57.000",
      "formatted_end": "02:01:04.000",
      "text": "شرمت توفه جیرسر باید بخوریم"
    },
    {
      "id": 17,
      "start": 7264.0,
      "end": 7269.0,
      "formatted_start": "02:01:04.000",
      "formatted_end": "02:01:09.000",
      "text": "باید بخوریم، میشه این خفه می کنه، این مریضی شوخی داره"
    },
    {
      "id": 18,
      "start": 7269.0,
      "end": 7275.0,
      "formatted_start": "02:01:09.000",
      "formatted_end": "02:01:15.000",
      "text": "پنجام گیر یکمون همه تو تطریق ها بود، شما نبودیم بردیمش"
    },
    {
      "id": 19,
      "start": 7275.0,
      "end": 7278.0,
      "formatted_start": "02:01:15.000",
      "formatted_end": "02:01:18.000",
      "text": "همه سروم ها رو بزرگ بردیم، این خواه ازتره"
    },
    {
      "id": 20,
      "start": 7278.0,
      "end": 7281.0,
      "formatted_start": "02:01:18.000",
      "formatted_end": "02:01:21.000",
      "text": "سروم ها فشارش میبره بالا، منم سروم بردم، این فشار و خونیه"
    },
    {
      "id": 21,
      "start": 7281.0,
      "end": 7282.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:22.000",
      "text": "نمیتونم، نمیتونم"
    },
    {
      "id": 22,
      "start": 7282.0,
      "end": 7284.0,
      "formatted_start": "02:01:22.000",
      "formatted_end": "02:01:24.000",
      "text": "دیدم اینجور میگن، سیفی بردید دیگه"
    },
    {
      "id": 23,
      "start": 7284.0,
      "end": 7286.0,
      "formatted_start": "02:01:24.000",
      "formatted_end": "02:01:26.000",
      "text": "نه صدی نه"
    },
    {
      "id": 24,
      "start": 7286.0,
      "end": 7288.0,
      "formatted_start": "02:01:26.000",
      "formatted_end": "02:01:28.000",
      "text": "دادگار ایمان"
    },
    {
      "id": 25,
      "start": 7288.0,
      "end": 7290.0,
      "formatted_start": "02:01:28.000",
      "formatted_end": "02:01:30.000",
      "text": "ما این رو به آن فیلم بودش در تیم بودیم"
    },
    {
      "id": 26,
      "start": 7290.0,
      "end": 7292.0,
      "formatted_start": "02:01:30.000",
      "formatted_end": "02:01:32.000",
      "text": "آره بینن دیگه میگن سرام نیست"
    },
    {
      "id": 27,
      "start": 7292.0,
      "end": 7294.0,
      "formatted_start": "02:01:32.000",
      "formatted_end": "02:01:34.000",
      "text": "سرام مردم دوست دارن"
    },
    {
      "id": 28,
      "start": 7294.0,
      "end": 7296.0,
      "formatted_start": "02:01:34.000",
      "formatted_end": "02:01:36.000",
      "text": "ولی این سرامی نیست"
    },
    {
      "id": 29,
      "start": 7296.0,
      "end": 7298.0,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:38.000",
      "text": "این پشتراش بالاست"
    },
    {
      "id": 30,
      "start": 7298.0,
      "end": 7300.0,
      "formatted_start": "02:01:38.000",
      "formatted_end": "02:01:40.000",
      "text": "شروط نمیشن مثل زهر"
    },
    {
      "id": 31,
      "start": 7300.0,
      "end": 7302.0,
      "formatted_start": "02:01:40.000",
      "formatted_end": "02:01:42.000",
      "text": "شروط نمیشن مثل زهر"
    },
    {
      "id": 32,
      "start": 7302.0,
      "end": 7304.0,
      "formatted_start": "02:01:42.000",
      "formatted_end": "02:01:44.000",
      "text": "یک دیگه هست مثل اصل"
    },
    {
      "id": 33,
      "start": 7304.0,
      "end": 7306.0,
      "formatted_start": "02:01:44.000",
      "formatted_end": "02:01:46.000",
      "text": "دو جو شروط"
    },
    {
      "id": 34,
      "start": 7306.0,
      "end": 7308.0,
      "formatted_start": "02:01:46.000",
      "formatted_end": "02:01:48.000",
      "text": "این چیه این"
    },
    {
      "id": 35,
      "start": 7308.0,
      "end": 7310.0,
      "formatted_start": "02:01:48.000",
      "formatted_end": "02:01:50.000",
      "text": "اصلا کلن شروط مخالفه"
    },
    {
      "id": 36,
      "start": 7310.0,
      "end": 7312.0,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:52.000",
      "text": "میدونم چایی که میخوری که"
    },
    {
      "id": 37,
      "start": 7312.0,
      "end": 7319.0,
      "formatted_start": "02:01:52.000",
      "formatted_end": "02:01:59.000",
      "text": "دوتاش هم بریز. یکی که اصل یه گاشب بزرگ بریز. اونو که زهره گاشب کچیک بریز."
    },
    {
      "id": 38,
      "start": 7319.0,
      "end": 7321.0,
      "formatted_start": "02:01:59.000",
      "formatted_end": "02:02:01.000",
      "text": "چای شیری میشه دیگه."
    },
    {
      "id": 39,
      "start": 7321.0,
      "end": 7322.0,
      "formatted_start": "02:02:01.000",
      "formatted_end": "02:02:02.000",
      "text": "اون چیشتون بخونه؟"
    },
    {
      "id": 40,
      "start": 7322.0,
      "end": 7324.0,
      "formatted_start": "02:02:02.000",
      "formatted_end": "02:02:04.000",
      "text": "اون زهره با اون گل میشه."
    },
    {
      "id": 41,
      "start": 7324.0,
      "end": 7326.0,
      "formatted_start": "02:02:04.000",
      "formatted_end": "02:02:06.000",
      "text": "قصد برای اون زهره هست."
    },
    {
      "id": 42,
      "start": 7326.0,
      "end": 7327.0,
      "formatted_start": "02:02:06.000",
      "formatted_end": "02:02:07.000",
      "text": "این زهره."
    },
    {
      "id": 43,
      "start": 7327.0,
      "end": 7330.0,
      "formatted_start": "02:02:07.000",
      "formatted_end": "02:02:10.000",
      "text": "این که دو آن شده سریش نیزیدی کل رو هست؟"
    },
    {
      "id": 44,
      "start": 7330.0,
      "end": 7334.0,
      "formatted_start": "02:02:10.000",
      "formatted_end": "02:02:14.000",
      "text": "مثلا الان ببینم هفتاد درصد ریه پره."
    },
    {
      "id": 45,
      "start": 7334.0,
      "end": 7335.0,
      "formatted_start": "02:02:14.000",
      "formatted_end": "02:02:15.000",
      "text": "آهان؟"
    },
    {
      "id": 46,
      "start": 7335.0,
      "end": 7340.0,
      "formatted_start": "02:02:15.000",
      "formatted_end": "02:02:20.000",
      "text": "خیلی مهم داره. اسپریه خیلی بزرگ دادن برایش. اسپریه مهم دادن."
    },
    {
      "id": 47,
      "start": 7340.0,
      "end": 7343.0,
      "formatted_start": "02:02:20.000",
      "formatted_end": "02:02:23.000",
      "text": "آنپول مهم داره. بیزن انشالله. بشه."
    },
    {
      "id": 48,
      "start": 7343.0,
      "end": 7347.0,
      "formatted_start": "02:02:23.000",
      "formatted_end": "02:02:27.000",
      "text": "دوت آنپول داره که موزه که کردن. بشه."
    },
    {
      "id": 49,
      "start": 7347.0,
      "end": 7349.0,
      "formatted_start": "02:02:27.000",
      "formatted_end": "02:02:29.000",
      "text": "بسرگشت بشه."
    },
    {
      "id": 50,
      "start": 7349.0,
      "end": 7351.0,
      "formatted_start": "02:02:29.000",
      "formatted_end": "02:02:31.000",
      "text": "تقریبا چی میدونه؟"
    },
    {
      "id": 51,
      "start": 7351.0,
      "end": 7353.0,
      "formatted_start": "02:02:31.000",
      "formatted_end": "02:02:33.000",
      "text": "برای خواهشونی دوباره دوست داری؟"
    },
    {
      "id": 52,
      "start": 7353.0,
      "end": 7355.0,
      "formatted_start": "02:02:33.000",
      "formatted_end": "02:02:35.000",
