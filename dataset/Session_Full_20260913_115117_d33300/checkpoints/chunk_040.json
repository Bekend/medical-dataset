    },
    {
      "id": 22,
      "start": 12177.0,
      "end": 12179.0,
      "formatted_start": "03:22:57.000",
      "formatted_end": "03:22:59.000",
      "text": "بفردی"
    },
    {
      "id": 23,
      "start": 12179.0,
      "end": 12185.0,
      "formatted_start": "03:22:59.000",
      "formatted_end": "03:23:05.000",
      "text": "چند نفره چونیده؟ دو نفر؟"
    },
    {
      "id": 24,
      "start": 12185.0,
      "end": 12187.0,
      "formatted_start": "03:23:05.000",
      "formatted_end": "03:23:07.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 12187.0,
      "end": 12189.0,
      "formatted_start": "03:23:07.000",
      "formatted_end": "03:23:09.000",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 12189.0,
      "end": 12191.0,
      "formatted_start": "03:23:09.000",
      "formatted_end": "03:23:11.000",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 12191.0,
      "end": 12193.0,
      "formatted_start": "03:23:11.000",
      "formatted_end": "03:23:13.000",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 12193.0,
      "end": 12195.0,
      "formatted_start": "03:23:13.000",
      "formatted_end": "03:23:15.000",
      "text": "نه"
    },
    {
      "id": 29,
      "start": 12195.0,
      "end": 12197.0,
      "formatted_start": "03:23:15.000",
      "formatted_end": "03:23:17.000",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 12197.0,
      "end": 12199.0,
      "formatted_start": "03:23:17.000",
      "formatted_end": "03:23:19.000",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 12199.0,
      "end": 12201.0,
      "formatted_start": "03:23:19.000",
      "formatted_end": "03:23:21.000",
      "text": "نه باید که اون رسوم در مارنان برسونه"
    },
    {
      "id": 32,
      "start": 12201.0,
      "end": 12203.0,
      "formatted_start": "03:23:21.000",
      "formatted_end": "03:23:23.000",
      "text": "باید که سمیم"
    },
    {
      "id": 33,
      "start": 12203.0,
      "end": 12205.0,
      "formatted_start": "03:23:23.000",
      "formatted_end": "03:23:25.000",
      "text": "باید که سمیم"
    },
    {
      "id": 34,
      "start": 12205.0,
      "end": 12207.0,
      "formatted_start": "03:23:25.000",
      "formatted_end": "03:23:27.000",
      "text": "باید که سمیم"
    },
    {
      "id": 35,
      "start": 12207.0,
      "end": 12231.0,
      "formatted_start": "03:23:27.000",
      "formatted_end": "03:23:51.000",
      "text": "بیمه دارید؟ داروها بیمه نیستند. تصویرشو براتون بفرستیم. شما از گروه باید تشکیل بدید."
    },
    {
      "id": 36,
      "start": 12231.0,
      "end": 12239.0,
      "formatted_start": "03:23:51.000",
      "formatted_end": "03:23:59.000",
      "text": "کسی اینجا نیست بگیره و بهتون بپرسته چون این داروها رو من به سختی تریعه کردم داروها رو"
    },
    {
      "id": 37,
      "start": 12239.0,
      "end": 12245.0,
      "formatted_start": "03:23:59.000",
      "formatted_end": "03:24:05.000",
      "text": "و اینکه بیرون خودنار توی یه دارو خونه همش گیردید و سرگردان میشید و مشابه میدن"
    },
    {
      "id": 38,
      "start": 12245.0,
      "end": 12249.0,
      "formatted_start": "03:24:05.000",
      "formatted_end": "03:24:09.000",
      "text": "یه داروهایی هست که برای زن و باقی چقدری ندارید"
    },
    {
      "id": 39,
      "start": 12249.0,
      "end": 12257.0,
      "formatted_start": "03:24:09.000",
      "formatted_end": "03:24:17.000",
      "text": "دستیاتشون بگن محلولی امشب، محلل هفته، بعد هر دوتا و واقعا"
    },
    {
      "id": 40,
      "start": 12257.0,
      "end": 12261.0,
      "formatted_start": "03:24:17.000",
      "formatted_end": "03:24:21.000",
      "text": "چه خوب شده، چه جاهایی میخواره، جاهایی نمیخواره، برمیدونی"
    },
    {
      "id": 41,
      "start": 12261.0,
      "end": 12269.0,
      "formatted_start": "03:24:21.000",
      "formatted_end": "03:24:29.000",
      "text": "از زیر چانه تا کف پایین، محلوله، ملا، زهد، گارن، پاپ، چهارن"
    },
    {
      "id": 42,
      "start": 12269.0,
      "end": 12271.0,
      "formatted_start": "03:24:29.000",
      "formatted_end": "03:24:31.000",
      "text": "دو تا همشهر، دو تا همه ته برم"
    },
    {
      "id": 43,
      "start": 12271.0,
      "end": 12278.0,
      "formatted_start": "03:24:31.000",
      "formatted_end": "03:24:38.000",
      "text": "شب میکنی، دوازده ساعت بعد میریم همون سه هشتی، شب ساعت همین هشتی صبح میریم همون"
    },
    {
      "id": 44,
      "start": 12278.0,
      "end": 12284.0,
      "formatted_start": "03:24:38.000",
      "formatted_end": "03:24:44.000",
      "text": "رفتید همه، اول با سابون گوگردی، میشونید"
    },
    {
      "id": 45,
      "start": 12284.0,
      "end": 12291.0,
      "formatted_start": "03:24:44.000",
      "formatted_end": "03:24:51.000",
      "text": "5 دقیقه سر می کنیم و بعد با شانگوی زکت شپش"
    },
    {
      "id": 46,
      "start": 12295.0,
      "end": 12297.0,
      "formatted_start": "03:24:55.000",
      "formatted_end": "03:24:57.000",
      "text": "از اول می گم زبطانی"
    },
    {
      "id": 47,
      "start": 12298.0,
      "end": 12300.0,
      "formatted_start": "03:24:58.000",
      "formatted_end": "03:25:00.000",
      "text": "بعد به نام خدا"
    }
  ],
  "status": "completed"
}