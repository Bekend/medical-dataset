      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:03.000",
      "text": "پینک و شلنگ رو شستی، توی یه مشنگای دیگه میده شید؟"
    },
    {
      "id": 1,
      "start": 12003.0,
      "end": 12006.0,
      "formatted_start": "03:20:03.000",
      "formatted_end": "03:20:06.000",
      "text": "بله، توی مشنگای دیگه تنظیم بذاشتم."
    },
    {
      "id": 2,
      "start": 12006.0,
      "end": 12008.0,
      "formatted_start": "03:20:06.000",
      "formatted_end": "03:20:08.000",
      "text": "بله، در حال."
    },
    {
      "id": 3,
      "start": 12019.0,
      "end": 12021.0,
      "formatted_start": "03:20:19.000",
      "formatted_end": "03:20:21.000",
