    },
    {
      "id": 38,
      "start": 8960.6,
      "end": 8961.88,
      "formatted_start": "02:29:20.600",
      "formatted_end": "02:29:21.880",
      "text": "آره"
    },
    {
      "id": 39,
      "start": 8961.88,
      "end": 8963.88,
      "formatted_start": "02:29:21.880",
      "formatted_end": "02:29:23.880",
      "text": "درسته باشه"
    },
    {
      "id": 40,
      "start": 8963.88,
      "end": 8965.88,
      "formatted_start": "02:29:23.880",
      "formatted_end": "02:29:25.880",
      "text": "درسته شفته داری؟"
    },
    {
      "id": 41,
      "start": 8965.88,
      "end": 8967.88,
      "formatted_start": "02:29:25.880",
      "formatted_end": "02:29:27.880",
      "text": "باید بردارید که اینجا باید بردارید"
    },
    {
