  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8730.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:30.000",
      "text": "اگر بایدت کنم، بخوابید، شور شور میگوشید. آرام، بچن به سبت راست. بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچن، بچ"
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "می کنه این مایه میاد بالا"
    },
    {
      "id": 2,
      "start": 8732.0,
      "end": 8733.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:33.000",
      "text": "ها؟"
    },
    {
      "id": 3,
      "start": 8733.0,
      "end": 8736.0,
      "formatted_start": "02:25:33.000",
      "formatted_end": "02:25:36.000",
      "text": "توش قباب های از قباب های چرمی"
    },
    {
      "id": 4,
      "start": 8736.0,
      "end": 8739.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:39.000",
      "text": "می خواهد این قباب های چرمی را بگرزنن باید دستان"
    },
    {
      "id": 5,
      "start": 8739.0,
      "end": 8741.0,
      "formatted_start": "02:25:39.000",
      "formatted_end": "02:25:41.000",
      "text": "و بگفته توی این این افره"
    },
    {
      "id": 6,
      "start": 8741.0,
      "end": 8743.0,
      "formatted_start": "02:25:41.000",
      "formatted_end": "02:25:43.000",
      "text": "ها؟ انا انجام میشه"
    },
    {
      "id": 7,
      "start": 8743.0,
      "end": 8745.0,
      "formatted_start": "02:25:43.000",
      "formatted_end": "02:25:45.000",
      "text": "شما فقط باید پایگرم بالا نگاه کنید"
    },
    {
      "id": 8,
      "start": 8745.0,
      "end": 8747.0,
      "formatted_start": "02:25:45.000",
      "formatted_end": "02:25:47.000",
      "text": "و اون درست نمیشه"
    },
    {
      "id": 9,
      "start": 8747.0,
      "end": 8777.0,
      "formatted_start": "02:25:47.000",
      "formatted_end": "02:26:17.000",
      "text": "اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 10,
      "start": 8777.0,
      "end": 8805.0,
      "formatted_start": "02:26:17.000",
      "formatted_end": "02:26:45.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 8805.0,
      "end": 8809.0,
      "formatted_start": "02:26:45.000",
      "formatted_end": "02:26:49.000",
      "text": "از اینجا باز برونه و یک سر درد ناکی برونه"
    },
    {
      "id": 12,
      "start": 8809.0,
      "end": 8811.0,
      "formatted_start": "02:26:49.000",
      "formatted_end": "02:26:51.000",
      "text": "اینجا پشار برونه و درد بگیره"
    },
    {
      "id": 13,
      "start": 8811.0,
      "end": 8813.0,
      "formatted_start": "02:26:51.000",
      "formatted_end": "02:26:53.000",
      "text": "درد گرفت؟"
    },
    {
      "id": 14,
      "start": 8813.0,
      "end": 8815.0,
      "formatted_start": "02:26:53.000",
      "formatted_end": "02:26:55.000",
      "text": "دردش بستار بگیره؟"
    },
    {
      "id": 15,
      "start": 8815.0,
      "end": 8817.0,
      "formatted_start": "02:26:55.000",
      "formatted_end": "02:26:57.000",
      "text": "بستار"
    },
    {
      "id": 16,
      "start": 8817.0,
      "end": 8819.0,
      "formatted_start": "02:26:57.000",
      "formatted_end": "02:26:59.000",
      "text": "بستار کمتر برن؟"
    },
    {
      "id": 17,
      "start": 8819.0,
      "end": 8821.0,
      "formatted_start": "02:26:59.000",
      "formatted_end": "02:27:01.000",
      "text": "بستار"
    },
    {
      "id": 18,
      "start": 8825.0,
      "end": 8827.0,
      "formatted_start": "02:27:05.000",
      "formatted_end": "02:27:07.000",
      "text": "رفعه"
    },
    {
      "id": 19,
      "start": 8835.0,
      "end": 8840.12,
      "formatted_start": "02:27:15.000",
      "formatted_end": "02:27:20.120",
      "text": "از آن برده همش داخلی این خوب پرد بشه"
    },
    {
      "id": 20,
      "start": 8840.12,
      "end": 8843.92,
      "formatted_start": "02:27:20.120",
      "formatted_end": "02:27:23.920",
      "text": "پچر کنه تکوب بده کفشی پاک بشه بزن"
    },
    {
      "id": 21,
      "start": 8843.92,
      "end": 8846.18,
      "formatted_start": "02:27:23.920",
      "formatted_end": "02:27:26.180",
      "text": "پرده داره از آن بزن"
    },
    {
      "id": 22,
      "start": 8865.0,
      "end": 8880.0,
      "formatted_start": "02:27:45.000",
      "formatted_end": "02:28:00.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 8880.0,
      "end": 8883.0,
      "formatted_start": "02:28:00.000",
      "formatted_end": "02:28:03.000",
      "text": "آرام و گرد مثل قبلی نخوند"
    },
    {
      "id": 24,
      "start": 8884.0,
      "end": 8887.0,
      "formatted_start": "02:28:04.000",
      "formatted_end": "02:28:07.000",
      "text": "سواره همه اتاقا من همجور بیگه"
    },
    {
      "id": 25,
      "start": 8889.0,
      "end": 8890.0,
      "formatted_start": "02:28:09.000",
      "formatted_end": "02:28:10.000",
      "text": "یکم صبر بگو"
    },
    {
      "id": 26,
      "start": 8891.0,
      "end": 8895.0,
      "formatted_start": "02:28:11.000",
      "formatted_end": "02:28:15.000",
      "text": "کن دست بذار در شانه که باید بیداری بذار دیگه سرد"
    },
    {
      "id": 27,
      "start": 8897.0,
      "end": 8900.0,
      "formatted_start": "02:28:17.000",
      "formatted_end": "02:28:20.000",
      "text": "آرام و سردون آبه"
    },
    {
      "id": 28,
      "start": 8901.0,
      "end": 8905.0,
      "formatted_start": "02:28:21.000",
      "formatted_end": "02:28:25.000",
      "text": "نخوند دست بذار ماشون زیر کشید بذار رو بخواهم"
    },
    {
      "id": 29,
      "start": 8905.0,
      "end": 8908.0,
      "formatted_start": "02:28:25.000",
      "formatted_end": "02:28:28.000",
      "text": "صورت به زمین خط قرمزه میبینید رو زمین؟"
    },
    {
      "id": 30,
      "start": 8908.0,
      "end": 8908.5,
      "formatted_start": "02:28:28.000",
      "formatted_end": "02:28:28.500",
      "text": "نه نه"
    },
    {
      "id": 31,
      "start": 8908.5,
      "end": 8909.5,
      "formatted_start": "02:28:28.500",
      "formatted_end": "02:28:29.500",
      "text": "همونجوره"
    },
    {
      "id": 32,
      "start": 8910.16,
      "end": 8912.16,
      "formatted_start": "02:28:30.160",
      "formatted_end": "02:28:32.160",
      "text": "هیچ بارا نگاه نداره"
    },
    {
      "id": 33,
      "start": 8913.76,
      "end": 8915.76,
      "formatted_start": "02:28:33.760",
      "formatted_end": "02:28:35.760",
      "text": "بلوگو برده ایستش"
    },
    {
      "id": 34,
      "start": 8921.24,
      "end": 8923.24,
      "formatted_start": "02:28:41.240",
      "formatted_end": "02:28:43.240",
      "text": "دهان بزرگشه"
    },
    {
      "id": 35,
      "start": 8923.24,
      "end": 8937.24,
      "formatted_start": "02:28:43.240",
      "formatted_end": "02:28:57.240",
      "text": "موسیقی"
    },
    {
      "id": 36,
      "start": 8937.24,
      "end": 8939.24,
      "formatted_start": "02:28:57.240",
      "formatted_end": "02:28:59.240",
      "text": "درسته باشه"
    },
    {
      "id": 37,
      "start": 8958.6,
      "end": 8960.6,
      "formatted_start": "02:29:18.600",
      "formatted_end": "02:29:20.600",
