  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6005.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:05.000",
      "text": "اینو کمردرد، آره، چرچ، کجای پا درد می کنم؟"
    },
    {
      "id": 1,
      "start": 6005.0,
      "end": 6012.0,
      "formatted_start": "01:40:05.000",
      "formatted_end": "01:40:12.000",
      "text": "آقایی دکترین، دو ماه که پاشتی کاملافت می کنن، اتانو پا اون زمین بذاره."
    },
    {
      "id": 2,
      "start": 6012.0,
      "end": 6026.0,
      "formatted_start": "01:40:12.000",
      "formatted_end": "01:40:26.000",
      "text": "آره، چرچ، کمر رو لفت کنم، آره، فشارتون رو بگیرم آچکانم؟"
    },
    {
      "id": 3,
      "start": 6030.0,
      "end": 6034.0,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:34.000",
      "text": "چند وقت قادر و کمالدست شدیده؟"
    },
    {
      "id": 4,
      "start": 6034.0,
      "end": 6036.0,
      "formatted_start": "01:40:34.000",
      "formatted_end": "01:40:36.000",
      "text": "یک سال"
    },
    {
      "id": 5,
      "start": 6036.0,
      "end": 6039.0,
      "formatted_start": "01:40:36.000",
      "formatted_end": "01:40:39.000",
      "text": "یک سال؟ دکترهایی که میرید کجا هستن؟"
    },
    {
      "id": 6,
      "start": 6039.0,
      "end": 6040.0,
      "formatted_start": "01:40:39.000",
      "formatted_end": "01:40:40.000",
      "text": "شاروت"
    },
    {
      "id": 7,
      "start": 6040.0,
      "end": 6042.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:42.000",
      "text": "شاروت بشینه شما؟"
    },
    {
      "id": 8,
      "start": 6042.0,
      "end": 6044.0,
      "formatted_start": "01:40:42.000",
      "formatted_end": "01:40:44.000",
      "text": "نه، روسته نررا بشینم"
    },
    {
      "id": 9,
      "start": 6044.0,
      "end": 6047.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:40:47.000",
      "text": "نررا؟ نرو؟ سعیدی هستی بسیار؟"
    },
    {
      "id": 10,
      "start": 6047.0,
      "end": 6050.0,
      "formatted_start": "01:40:47.000",
      "formatted_end": "01:40:50.000",
      "text": "آره، شوهر سعیدی"
    },
    {
      "id": 11,
      "start": 6050.0,
      "end": 6051.0,
      "formatted_start": "01:40:50.000",
      "formatted_end": "01:40:51.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 6055.0,
      "end": 6058.0,
      "formatted_start": "01:40:55.000",
      "formatted_end": "01:40:58.000",
      "text": "شاروت نزدیکتره مگه؟"
    },
    {
      "id": 13,
      "start": 6058.0,
      "end": 6061.8,
      "formatted_start": "01:40:58.000",
      "formatted_end": "01:41:01.800",
      "text": "آره چون من خودم مستقیمتی هستم نانم"
    },
    {
      "id": 14,
      "start": 6061.8,
      "end": 6062.54,
      "formatted_start": "01:41:01.800",
      "formatted_end": "01:41:02.540",
      "text": "آها"
    },
    {
      "id": 15,
      "start": 6062.54,
      "end": 6066.28,
      "formatted_start": "01:41:02.540",
      "formatted_end": "01:41:06.280",
      "text": "خواهد من به این پاسی پاهم"
    },
    {
      "id": 16,
      "start": 6066.28,
      "end": 6068.1,
      "formatted_start": "01:41:06.280",
      "formatted_end": "01:41:08.100",
      "text": "اصلا جمعه ها که من کشتا"
    },
    {
      "id": 17,
      "start": 6068.1,
      "end": 6070.3,
      "formatted_start": "01:41:08.100",
      "formatted_end": "01:41:10.300",
      "text": "نگران نباش خانم"
    },
    {
      "id": 18,
      "start": 6070.3,
      "end": 6071.48,
      "formatted_start": "01:41:10.300",
      "formatted_end": "01:41:11.480",
      "text": "خدا کنی که خوبه"
    },
    {
      "id": 19,
      "start": 6071.48,
      "end": 6072.42,
      "formatted_start": "01:41:11.480",
      "formatted_end": "01:41:12.420",
      "text": "انشالله"
    },
    {
      "id": 20,
      "start": 6072.42,
      "end": 6073.04,
      "formatted_start": "01:41:12.420",
      "formatted_end": "01:41:13.040",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 6073.04,
      "end": 6075.66,
      "formatted_start": "01:41:13.040",
      "formatted_end": "01:41:15.660",
      "text": "اول توقیتون به خدا باشه"
    },
    {
      "id": 22,
      "start": 6075.66,
      "end": 6078.82,
      "formatted_start": "01:41:15.660",
      "formatted_end": "01:41:18.820",
      "text": "این ها یه سری بیماری های کوکی و استخانه"
    },
    {
      "id": 23,
      "start": 6078.82,
      "end": 6080.16,
      "formatted_start": "01:41:18.820",
      "formatted_end": "01:41:20.160",
      "text": "در خانوم ها"
    },
    {
      "id": 24,
      "start": 6080.16,
      "end": 6081.84,
      "formatted_start": "01:41:20.160",
      "formatted_end": "01:41:21.840",
      "text": "ایجاد میشه"
    },
    {
      "id": 25,
      "start": 6081.84,
      "end": 6084.66,
      "formatted_start": "01:41:21.840",
      "formatted_end": "01:41:24.660",
      "text": "بعد از یایسگی خیلی شدیدتر میشه"
    },
    {
      "id": 26,
      "start": 6084.66,
      "end": 6089.72,
      "formatted_start": "01:41:24.660",
      "formatted_end": "01:41:29.720",
      "text": "انشاءالله که همیشه خوب باشید"
    },
    {
      "id": 27,
      "start": 6089.72,
      "end": 6091.7,
      "formatted_start": "01:41:29.720",
      "formatted_end": "01:41:31.700",
      "text": "همیشه خوب باشید"
    },
    {
      "id": 28,
      "start": 6091.7,
      "end": 6092.52,
      "formatted_start": "01:41:31.700",
      "formatted_end": "01:41:32.520",
      "text": "بله آقایی دیگه"
    },
    {
      "id": 29,
      "start": 6092.52,
      "end": 6092.82,
      "formatted_start": "01:41:32.520",
      "formatted_end": "01:41:32.820",
      "text": "چون؟"
    },
    {
      "id": 30,
      "start": 6092.82,
      "end": 6094.78,
      "formatted_start": "01:41:32.820",
      "formatted_end": "01:41:34.780",
      "text": "خرمه خورده پس تنیداری بودید"
    },
    {
      "id": 31,
      "start": 6094.78,
      "end": 6097.1,
      "formatted_start": "01:41:34.780",
      "formatted_end": "01:41:37.100",
      "text": "بله چرا نیستم"
    },
    {
      "id": 32,
      "start": 6097.1,
      "end": 6098.36,
      "formatted_start": "01:41:37.100",
      "formatted_end": "01:41:38.360",
      "text": "گلوتو میبینم خالدی"
    },
    {
      "id": 33,
      "start": 6098.36,
      "end": 6101.66,
      "formatted_start": "01:41:38.360",
      "formatted_end": "01:41:41.660",
      "text": "آره یاره"
    },
    {
      "id": 34,
      "start": 6101.66,
      "end": 6102.34,
      "formatted_start": "01:41:41.660",
      "formatted_end": "01:41:42.340",
      "text": "صبح همیشه"
    },
    {
      "id": 35,
      "start": 6102.34,
      "end": 6103.86,
      "formatted_start": "01:41:42.340",
      "formatted_end": "01:41:43.860",
      "text": "آقایی بیریده من"
    },
    {
      "id": 36,
      "start": 6103.86,
      "end": 6105.06,
      "formatted_start": "01:41:43.860",
      "formatted_end": "01:41:45.060",
      "text": "خرمه دردید"
    },
    {
      "id": 37,
      "start": 6105.06,
      "end": 6106.42,
      "formatted_start": "01:41:45.060",
      "formatted_end": "01:41:46.420",
      "text": "چون؟"
    },
    {
      "id": 38,
      "start": 6106.42,
      "end": 6127.32,
      "formatted_start": "01:41:46.420",
      "formatted_end": "01:42:07.320",
      "text": "همه چی نوشتم هم برای درد پاد هم برای سرما خورده"
    },
    {
      "id": 39,
      "start": 6127.32,
      "end": 6128.96,
      "formatted_start": "01:42:07.320",
      "formatted_end": "01:42:08.960",
      "text": "خورده شو"
    },
    {
      "id": 40,
      "start": 6128.96,
      "end": 6130.66,
      "formatted_start": "01:42:08.960",
      "formatted_end": "01:42:10.660",
      "text": "خدافش"
    },
    {
      "id": 41,
      "start": 6130.66,
      "end": 6131.8,
      "formatted_start": "01:42:10.660",
      "formatted_end": "01:42:11.800",
      "text": "به سلامت"
    },
    {
      "id": 42,
      "start": 6131.8,
      "end": 6132.62,
      "formatted_start": "01:42:11.800",
      "formatted_end": "01:42:12.620",
      "text": "خیلی خوشمونه"
    },
    {
      "id": 43,
      "start": 6136.42,
      "end": 6140.42,
      "formatted_start": "01:42:16.420",
      "formatted_end": "01:42:20.420",
      "text": "بفرمید"
    },
    {
      "id": 44,
      "start": 6140.42,
      "end": 6144.42,
      "formatted_start": "01:42:20.420",
      "formatted_end": "01:42:24.420",
      "text": "بفرمید"
    },
    {
      "id": 45,
      "start": 6144.42,
      "end": 6148.42,
      "formatted_start": "01:42:24.420",
      "formatted_end": "01:42:28.420",
      "text": "بفرمید"
    },
    {
      "id": 46,
      "start": 6148.42,
      "end": 6152.42,
      "formatted_start": "01:42:28.420",
      "formatted_end": "01:42:32.420",
      "text": "بفرمید"
    },
    {
      "id": 47,
      "start": 6152.42,
      "end": 6156.42,
      "formatted_start": "01:42:32.420",
      "formatted_end": "01:42:36.420",
      "text": "بفرمید"
    },
    {
      "id": 48,
      "start": 6156.42,
      "end": 6160.42,
      "formatted_start": "01:42:36.420",
      "formatted_end": "01:42:40.420",
      "text": "بفرمید"
    },
    {
      "id": 49,
      "start": 6160.42,
      "end": 6164.42,
      "formatted_start": "01:42:40.420",
      "formatted_end": "01:42:44.420",
      "text": "بفرمید"
    },
    {
      "id": 50,
      "start": 6164.42,
      "end": 6172.42,
      "formatted_start": "01:42:44.420",
      "formatted_end": "01:42:52.420",
      "text": "باید بردن گوبرد و سریع کردن"
    },
    {
      "id": 51,
      "start": 6172.42,
      "end": 6179.42,
      "formatted_start": "01:42:52.420",
      "formatted_end": "01:42:59.420",
      "text": "چند روز امرائی سیتسکن هیچی ملو نشد"
    },
    {
      "id": 52,
      "start": 6179.42,
      "end": 6182.42,
      "formatted_start": "01:42:59.420",
      "formatted_end": "01:43:02.420",
      "text": "الان یکی رو بیرون برس داده میخوام جا بندازم مایشون"
    },
    {
      "id": 53,
      "start": 6182.42,
      "end": 6188.42,
      "formatted_start": "01:43:02.420",
      "formatted_end": "01:43:08.420",
      "text": "الان قبلا هم همینطور شده بودم دکتورم خودت هسته"
    },
    {
      "id": 54,
      "start": 6188.42,
      "end": 6192.24,
      "formatted_start": "01:43:08.420",
      "formatted_end": "01:43:12.240",
      "text": "میگو کن اینجا هم درد میکرد"
    },
    {
      "id": 55,
      "start": 6192.24,
      "end": 6196.52,
      "formatted_start": "01:43:12.240",
      "formatted_end": "01:43:16.520",
      "text": "میگفتی افونت مریضه پشت گردن شانه به دست"
    },
    {
      "id": 56,
      "start": 6196.52,
      "end": 6198.32,
      "formatted_start": "01:43:16.520",
      "formatted_end": "01:43:18.320",
      "text": "چند شنبه تو شدی خودی؟"
    },
    {
      "id": 57,
      "start": 6198.32,
      "end": 6200.68,
      "formatted_start": "01:43:18.320",
      "formatted_end": "01:43:20.680",
      "text": "چند شنبه بود"
    },
    {
      "id": 58,
      "start": 6200.68,
      "end": 6202.54,
      "formatted_start": "01:43:20.680",
      "formatted_end": "01:43:22.540",
      "text": "سه روز بیمارستان شدم"
    },
    {
      "id": 59,
      "start": 6202.54,
      "end": 6205.64,
      "formatted_start": "01:43:22.540",
      "formatted_end": "01:43:25.640",
      "text": "الان میگو کن از دیروزه"
    },
    {
      "id": 60,
      "start": 6205.64,
      "end": 6208.8,
      "formatted_start": "01:43:25.640",
      "formatted_end": "01:43:28.800",
      "text": "سرم که سنی نویخته به پشت گردنم"
    },
    {
      "id": 61,
      "start": 6208.8,
      "end": 6210.36,
      "formatted_start": "01:43:28.800",
      "formatted_end": "01:43:30.360",
      "text": "الان چرخش نداری؟"
    },
    {
      "id": 62,
      "start": 6210.36,
      "end": 6211.62,
      "formatted_start": "01:43:30.360",
      "formatted_end": "01:43:31.620",
      "text": "چرا؟"
    },
    {
      "id": 63,
      "start": 6211.62,
      "end": 6213.78,
      "formatted_start": "01:43:31.620",
      "formatted_end": "01:43:33.780",
      "text": "دراز که میکشم سرم مره"
    },
    {
      "id": 64,
      "start": 6213.78,
      "end": 6215.7,
      "formatted_start": "01:43:33.780",
      "formatted_end": "01:43:35.700",
      "text": "نگفتن مایه گوشته؟"
    },
    {
      "id": 65,
      "start": 6215.7,
      "end": 6216.42,
      "formatted_start": "01:43:35.700",
      "formatted_end": "01:43:36.420",
      "text": "چرا؟"
    },
    {
      "id": 66,
      "start": 6216.42,
      "end": 6218.74,
      "formatted_start": "01:43:36.420",
      "formatted_end": "01:43:38.740",
      "text": "گفتن یک امتحان کارم برم"
    },
    {
      "id": 67,
      "start": 6218.74,
      "end": 6221.74,
      "formatted_start": "01:43:38.740",
      "formatted_end": "01:43:41.740",
      "text": "بعد چند شنبه شروع شد؟ ریالت نیست؟"
    },
    {
      "id": 68,
      "start": 6221.74,
      "end": 6224.82,
      "formatted_start": "01:43:41.740",
      "formatted_end": "01:43:44.820",
      "text": "من سر بیر جام از چند شنبه شد"
    },
    {
      "id": 69,
      "start": 6224.82,
      "end": 6226.58,
      "formatted_start": "01:43:44.820",
      "formatted_end": "01:43:46.580",
      "text": "یک شنبه"
    },
    {
      "id": 70,
      "start": 6226.58,
      "end": 6228.58,
      "formatted_start": "01:43:46.580",
      "formatted_end": "01:43:48.580",
      "text": "شنبه اینه بیمارشان بود دیگه"
    },
    {
      "id": 71,
      "start": 6228.58,
      "end": 6229.66,
      "formatted_start": "01:43:48.580",
      "formatted_end": "01:43:49.660",
      "text": "شنبه اینه بود"
    },
    {
      "id": 72,
      "start": 6229.66,
      "end": 6234.22,
      "formatted_start": "01:43:49.660",
      "formatted_end": "01:43:54.220",
      "text": "شنبه رفتیم، اما ببخشید قبل از این تا که سرم بشه"
    },
    {
      "id": 73,
      "start": 6234.22,
      "end": 6238.66,
      "formatted_start": "01:43:54.220",
      "formatted_end": "01:43:58.660",
      "text": "نارتی میده اینا که داشتم رفتم آزمایش دادم بسه"
    },
    {
      "id": 74,
      "start": 6238.66,
      "end": 6240.18,
      "formatted_start": "01:43:58.660",
      "formatted_end": "01:44:00.180",
      "text": "بردم آبگیرم"
    },
    {
      "id": 75,
      "start": 6240.18,
      "end": 6246.1,
      "formatted_start": "01:44:00.180",
      "formatted_end": "01:44:06.100",
      "text": "بعد دیگه آزمایش ها من اینای که گرفتم اینجا"
    },
    {
      "id": 76,
      "start": 6246.1,
      "end": 6248.1,
      "formatted_start": "01:44:06.100",
      "formatted_end": "01:44:08.100",
      "text": "نگفتن چند ویدئوی کلان؟"
    },
    {
      "id": 77,
      "start": 6248.1,
      "end": 6252.5,
      "formatted_start": "01:44:08.100",
      "formatted_end": "01:44:12.500",
      "text": "بعد دیگه، اینهایی برا میدم دادن، دکتر باید را دادن"
    },
    {
      "id": 78,
      "start": 6252.5,
      "end": 6253.7,
      "formatted_start": "01:44:12.500",
      "formatted_end": "01:44:13.700",
      "text": "اصلا داشتی؟"
    },
    {
      "id": 79,
      "start": 6253.7,
      "end": 6258.3,
      "formatted_start": "01:44:13.700",
      "formatted_end": "01:44:18.300",
      "text": "شکم درد، دل پیچه، قبل از سرگیجم آقا"
    },
    {
      "id": 80,
      "start": 6258.3,
      "end": 6261.3,
      "formatted_start": "01:44:18.300",
      "formatted_end": "01:44:21.300",
      "text": "قبل از سرگیجه، شکم درد داشتم"
    },
    {
      "id": 81,
      "start": 6261.3,
      "end": 6262.5,
      "formatted_start": "01:44:21.300",
      "formatted_end": "01:44:22.500",
      "text": "اینهایی گنبت دادن؟"
    },
    {
      "id": 82,
      "start": 6262.5,
      "end": 6265.7,
      "formatted_start": "01:44:22.500",
      "formatted_end": "01:44:25.700",
      "text": "اینهایی گنبت، پیمامستان گنبت دادن"
    },
    {
      "id": 83,
      "start": 6265.7,
      "end": 6270.3,
      "formatted_start": "01:44:25.700",
      "formatted_end": "01:44:30.300",
      "text": "این آزمایش من نگاه کرد، دکتر یاد برمی داد، این دو تا گرسه"
    },
    {
      "id": 84,
      "start": 6270.3,
      "end": 6271.5,
      "formatted_start": "01:44:30.300",
      "formatted_end": "01:44:31.500",
      "text": "این دو تا گرسه، خب"
    },
    {
      "id": 85,
      "start": 6271.5,
      "end": 6273.5,
      "formatted_start": "01:44:31.500",
      "formatted_end": "01:44:33.500",
      "text": "و بعد دیگه این چیز"
    },
    {
      "id": 86,
      "start": 6273.5,
      "end": 6277.5,
      "formatted_start": "01:44:33.500",
      "formatted_end": "01:44:37.500",
      "text": "دیگه سر من رو بالشت میذارم"
    },
    {
      "id": 87,
      "start": 6277.5,
      "end": 6280.5,
      "formatted_start": "01:44:37.500",
      "formatted_end": "01:44:40.500",
      "text": "گیش منه میچرکه"
    },
    {
      "id": 88,
      "start": 6280.5,
      "end": 6283.5,
      "formatted_start": "01:44:40.500",
      "formatted_end": "01:44:43.500",
      "text": "الان پشت گردنم و پشت گوشم"
    },
    {
      "id": 89,
      "start": 6283.5,
      "end": 6285.5,
      "formatted_start": "01:44:43.500",
      "formatted_end": "01:44:45.500",
      "text": "یه سنگا میذارم"
    },
    {
      "id": 90,
      "start": 6285.5,
      "end": 6288.5,
      "formatted_start": "01:44:45.500",
      "formatted_end": "01:44:48.500",
      "text": "مایه گوشت دیده در سر خوردن چرمی اینجور میشه"
    },
    {
      "id": 91,
      "start": 6288.5,
      "end": 6290.5,
      "formatted_start": "01:44:48.500",
      "formatted_end": "01:44:50.500",
      "text": "تلگرسیدت خیلی بالا است"
    },
    {
      "id": 92,
      "start": 6290.5,
      "end": 6293.5,
      "formatted_start": "01:44:50.500",
      "formatted_end": "01:44:53.500",
      "text": "و داروی تلگرسیدت ندادن"
    },
    {
      "id": 93,
      "start": 6293.5,
      "end": 6295.5,
      "formatted_start": "01:44:53.500",
      "formatted_end": "01:44:55.500",
      "text": "فینافیدورت باید میدادن"
    },
    {
      "id": 94,
      "start": 6295.5,
      "end": 6297.5,
      "formatted_start": "01:44:55.500",
      "formatted_end": "01:44:57.500",
      "text": "خب اینم"
    },
    {
      "id": 95,
      "start": 6297.5,
      "end": 6299.5,
      "formatted_start": "01:44:57.500",
      "formatted_end": "01:44:59.500",
      "text": "اینه برای میده درد کرده بوده"
    }
  ],
  "status": "completed"
}