  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5430.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:30.000",
      "text": "با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با اینکه باید بردارید، با"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5432.0,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:32.000",
      "text": "خواهش شده گمباره"
    },
    {
      "id": 2,
      "start": 5432.0,
      "end": 5434.0,
      "formatted_start": "01:30:32.000",
      "formatted_end": "01:30:34.000",
      "text": "خیابوشارو درم نقط شده"
    },
    {
      "id": 3,
      "start": 5434.0,
      "end": 5436.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:36.000",
      "text": "پس باید برگشته باید مساده از فرق"
    },
    {
      "id": 4,
      "start": 5436.0,
      "end": 5438.0,
      "formatted_start": "01:30:36.000",
      "formatted_end": "01:30:38.000",
      "text": "من نمیدونم اینو چیکار میکنن"
    },
    {
      "id": 5,
      "start": 5438.0,
      "end": 5440.0,
      "formatted_start": "01:30:38.000",
      "formatted_end": "01:30:40.000",
      "text": "باید آرام"
    },
    {
      "id": 6,
      "start": 5440.0,
      "end": 5442.0,
      "formatted_start": "01:30:40.000",
      "formatted_end": "01:30:42.000",
      "text": "امروز عشقشو میکشه زوج"
    },
    {
      "id": 7,
      "start": 5442.0,
      "end": 5444.0,
      "formatted_start": "01:30:42.000",
      "formatted_end": "01:30:44.000",
      "text": "شما اینجا باید فرزنده؟"
    },
    {
      "id": 8,
      "start": 5444.0,
      "end": 5446.0,
      "formatted_start": "01:30:44.000",
      "formatted_end": "01:30:46.000",
      "text": "منم بیاد میشم با شما"
    },
    {
      "id": 9,
      "start": 5446.0,
      "end": 5448.0,
      "formatted_start": "01:30:46.000",
      "formatted_end": "01:30:48.000",
      "text": "نه من زیر زمینم"
    },
    {
      "id": 10,
      "start": 5448.0,
      "end": 5450.0,
      "formatted_start": "01:30:48.000",
      "formatted_end": "01:30:50.000",
      "text": "آرام"
    },
    {
      "id": 11,
      "start": 5450.0,
      "end": 5452.0,
      "formatted_start": "01:30:50.000",
      "formatted_end": "01:30:52.000",
      "text": "بخواهش شد"
    },
    {
      "id": 12,
      "start": 5452.0,
      "end": 5454.0,
      "formatted_start": "01:30:52.000",
      "formatted_end": "01:30:54.000",
      "text": "بخواهش شد"
    },
    {
      "id": 13,
      "start": 5454.0,
      "end": 5456.0,
      "formatted_start": "01:30:54.000",
      "formatted_end": "01:30:56.000",
      "text": "بخواهش شد"
    },
    {
      "id": 14,
      "start": 5456.0,
      "end": 5458.0,
      "formatted_start": "01:30:56.000",
      "formatted_end": "01:30:58.000",
      "text": "بخواهش شد"
    },
    {
      "id": 15,
      "start": 5458.0,
      "end": 5480.0,
      "formatted_start": "01:30:58.000",
      "formatted_end": "01:31:20.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 5480.0,
      "end": 5484.5,
      "formatted_start": "01:31:20.000",
      "formatted_end": "01:31:24.500",
      "text": "برق داریم پایین"
    },
    {
      "id": 17,
      "start": 5484.5,
      "end": 5486.84,
      "formatted_start": "01:31:24.500",
      "formatted_end": "01:31:26.840",
      "text": "بزارید اینو"
    },
    {
      "id": 18,
      "start": 5486.84,
      "end": 5489.82,
      "formatted_start": "01:31:26.840",
      "formatted_end": "01:31:29.820",
      "text": "اینجا بزارید همینجا باشه"
    },
    {
      "id": 19,
      "start": 5489.82,
      "end": 5490.78,
      "formatted_start": "01:31:29.820",
      "formatted_end": "01:31:30.780",
      "text": "اگه زفت بکنه"
    },
    {
      "id": 20,
      "start": 5490.78,
      "end": 5492.38,
      "formatted_start": "01:31:30.780",
      "formatted_end": "01:31:32.380",
      "text": "بزارید همینجا بزارید"
    },
    {
      "id": 21,
      "start": 5492.38,
      "end": 5493.86,
      "formatted_start": "01:31:32.380",
      "formatted_end": "01:31:33.860",
      "text": "بچه بچه بست نزده"
    },
    {
      "id": 22,
      "start": 5493.86,
      "end": 5497.22,
      "formatted_start": "01:31:33.860",
      "formatted_end": "01:31:37.220",
      "text": "صفته فقط زفت کنه"
    },
    {
      "id": 23,
      "start": 5497.22,
      "end": 5498.94,
      "formatted_start": "01:31:37.220",
      "formatted_end": "01:31:38.940",
      "text": "اینجا سویده"
    },
    {
      "id": 24,
      "start": 5498.94,
      "end": 5500.14,
      "formatted_start": "01:31:38.940",
      "formatted_end": "01:31:40.140",
      "text": "همین دیگه روشنگ ها"
    },
    {
      "id": 25,
      "start": 5500.14,
      "end": 5501.0,
      "formatted_start": "01:31:40.140",
      "formatted_end": "01:31:41.000",
      "text": "گردن نداره"
    },
    {
      "id": 26,
      "start": 5501.0,
      "end": 5502.8,
      "formatted_start": "01:31:41.000",
      "formatted_end": "01:31:42.800",
      "text": "باش باش"
    },
    {
      "id": 27,
      "start": 5502.8,
      "end": 5505.34,
      "formatted_start": "01:31:42.800",
      "formatted_end": "01:31:45.340",
      "text": "بزاریم در انتهای اینجا باشیم"
    },
    {
      "id": 28,
      "start": 5505.34,
      "end": 5505.78,
      "formatted_start": "01:31:45.340",
      "formatted_end": "01:31:45.780",
      "text": "برق"
    },
    {
      "id": 29,
      "start": 5505.78,
      "end": 5517.78,
      "formatted_start": "01:31:45.780",
      "formatted_end": "01:31:57.780",
      "text": "بعد از این اعتباری که از طولید دارای خوراکش داشت، اونهای اولی محصول تصویری خودش و بانان زیکورپا معرفی کرد"
    },
    {
      "id": 30,
      "start": 5517.78,
      "end": 5528.78,
      "formatted_start": "01:31:57.780",
      "formatted_end": "01:32:08.780",
      "text": "که در واقع یه دستور اوتو انژکتور هست، حاوی حالا از 2.5 میل تا 15 میل وسته به 12 محصول ملکول تیوزپاتا"
    },
    {
      "id": 31,
      "start": 5528.78,
      "end": 5537.02,
      "formatted_start": "01:32:08.780",
      "formatted_end": "01:32:17.020",
      "text": "اتفاقی که رقم میزنم به صورت کل این مولکول تأثیر اولش خوب کنشدن سرعت تقریه مده هست"
    },
    {
      "id": 32,
      "start": 5537.02,
      "end": 5541.96,
      "formatted_start": "01:32:17.020",
      "formatted_end": "01:32:21.960",
      "text": "زمین که به پانکراس از هر ازارم و تربید هر سولین رو بیشتر می کنن"
    },
    {
      "id": 33,
      "start": 5541.96,
      "end": 5543.02,
      "formatted_start": "01:32:21.960",
      "formatted_end": "01:32:23.020",
      "text": "جای پیرو"
    },
    {
      "id": 34,
      "start": 5543.02,
      "end": 5544.32,
      "formatted_start": "01:32:23.020",
      "formatted_end": "01:32:24.320",
      "text": "بله بله دقیقا"
    },
    {
      "id": 35,
      "start": 5544.32,
      "end": 5547.88,
      "formatted_start": "01:32:24.320",
      "formatted_end": "01:32:27.880",
      "text": "و حالا جذبی که هر و ادرات رو در روی بکنم تر می کنم"
    },
    {
      "id": 36,
      "start": 5547.88,
      "end": 5551.5,
      "formatted_start": "01:32:27.880",
      "formatted_end": "01:32:31.500",
      "text": "و یکی مطلع هم که خوب خیلی لازم مده تون بگم"
    },
    {
      "id": 37,
      "start": 5551.5,
      "end": 5554.12,
      "formatted_start": "01:32:31.500",
      "formatted_end": "01:32:34.120",
      "text": "اون وزده که بیمار از دست مده"
    },
    {
      "id": 38,
      "start": 5554.12,
      "end": 5565.12,
      "formatted_start": "01:32:34.120",
      "formatted_end": "01:32:45.120",
      "text": "اینکه کلیتون سارکوپینین اتفاق می افته و به هر حال متاسفانه حالا اون چیز که اتفاق افتاد دو ماهه، سه ماهه یا جهش دوز و بدون ورزش این کار رو میکنن"
    },
    {
      "id": 39,
      "start": 5565.12,
      "end": 5573.12,
      "formatted_start": "01:32:45.120",
      "formatted_end": "01:32:53.120",
      "text": "خب اگر سارکوپینین و جذب پروتینی و رژیم و ورزش رایت نشه خب ما افتاده رو هم بر کنارش خواهیم"
    },
    {
      "id": 40,
      "start": 5573.12,
      "end": 5579.12,
      "formatted_start": "01:32:53.120",
      "formatted_end": "01:32:59.120",
      "text": "از عوارض کلیت یه زفت باتر اینست که از اولاد استخبار رو کم میکنه"
    },
    {
      "id": 41,
      "start": 5579.12,
      "end": 5590.62,
      "formatted_start": "01:32:59.120",
      "formatted_end": "01:33:10.620",
      "text": "یک چارمه چیزی که حداست میدهد این مست، از اون این مست، یک دومش، یک درکل، یک هشتمه از آن چی که باقر میشه سارکوپینی به اخترزال است"
    },
    {
      "id": 42,
      "start": 5590.62,
      "end": 5595.36,
      "formatted_start": "01:33:10.620",
      "formatted_end": "01:33:15.360",
      "text": "خب باید پروتین اون یک تا یک و دوده هم گرم به ازای هر کلی دارد"
    },
    {
      "id": 43,
      "start": 5595.36,
      "end": 5602.12,
      "formatted_start": "01:33:15.360",
      "formatted_end": "01:33:22.120",
      "text": "بله، ولی این مریضه هایی که دارن مصرف می کنند، یا هلسین یا اسپارتیلون یا منجابو، منجابو خودش نیست و مردم"
    },
    {
      "id": 44,
      "start": 5602.12,
      "end": 5607.12,
      "formatted_start": "01:33:22.120",
      "formatted_end": "01:33:27.120",
      "text": "از این از هر مشابهات استفاده میشن تیز آباده و من بهشون فودرای فور پروتین میدن"
    },
    {
      "id": 45,
      "start": 5607.12,
      "end": 5616.12,
      "formatted_start": "01:33:27.120",
      "formatted_end": "01:33:36.120",
      "text": "مثلا های پروتین، فور پروتین، مکمل هایی که داره سپریمنت پروتین هستن، کلاجن اینو برامیدن"
    },
    {
      "id": 46,
      "start": 5616.12,
      "end": 5623.12,
      "formatted_start": "01:33:36.120",
      "formatted_end": "01:33:43.120",
      "text": "چون افته رو نداشته باشن، برامید به جی آی پی اندیوسر هستن"
    },
    {
      "id": 47,
      "start": 5623.12,
      "end": 5625.12,
      "formatted_start": "01:33:43.120",
      "formatted_end": "01:33:45.120",
      "text": "اینو حالا جز بی جه هستن"
    },
    {
      "id": 48,
      "start": 5625.12,
      "end": 5635.12,
      "formatted_start": "01:33:45.120",
      "formatted_end": "01:33:55.120",
      "text": "دارخانه باید موجود داره و به رنگ زیکورپا من منبوه میشم اگر تیزی رو سلاختیم مثل به هر دلیلی"
    },
    {
      "id": 49,
      "start": 5635.12,
      "end": 5644.12,
      "formatted_start": "01:33:55.120",
      "formatted_end": "01:34:04.120",
      "text": "حالا به خاطر اندخونش چون تا بیش از 2 درصد کاهش ایوانسی رو میتونم دهانبار داشته باشم"
    },
    {
      "id": 50,
      "start": 5644.12,
      "end": 5650.12,
      "formatted_start": "01:34:04.120",
      "formatted_end": "01:34:10.120",
      "text": "یا خلا برای کبید چهر بشون یا اوویس بودن بی ایمای بالای سی بودن"
    },
    {
      "id": 51,
      "start": 5650.12,
      "end": 5655.12,
      "formatted_start": "01:34:10.120",
      "formatted_end": "01:34:15.120",
      "text": "و همین از ازاش نمیتونین خبرند زیبا کارو تجمیز بپرمید"
    },
    {
      "id": 52,
      "start": 5655.12,
      "end": 5662.12,
      "formatted_start": "01:34:15.120",
      "formatted_end": "01:34:22.120",
      "text": "نمیتونم، من توصیه میکنم ولی اشتراک به حاله کنم، روز خیلی نمیشتم تایستشو"
    },
    {
      "id": 53,
      "start": 5662.12,
      "end": 5668.12,
      "formatted_start": "01:34:22.120",
      "formatted_end": "01:34:28.120",
      "text": "چون شخصیتی مقتاطی داره، از سعی دید کنم که"
    },
    {
      "id": 54,
      "start": 5668.12,
      "end": 5674.12,
      "formatted_start": "01:34:28.120",
      "formatted_end": "01:34:34.120",
      "text": "ببینید اینا خب اوار زنگلیشون استفراقه، حتی با دومیل کمتر"
    },
    {
      "id": 55,
      "start": 5674.12,
      "end": 5678.12,
      "formatted_start": "01:34:34.120",
      "formatted_end": "01:34:38.120",
      "text": "در بعض اینها افراد متفاوتن، یکی میزنه هیچیش نمیشه"
    },
    {
      "id": 56,
      "start": 5678.12,
      "end": 5682.12,
      "formatted_start": "01:34:38.120",
      "formatted_end": "01:34:42.120",
      "text": "میگه مردم، میده، درد کلا، من اصحال ببایی رو دیدم"
    },
    {
      "id": 57,
      "start": 5682.12,
      "end": 5688.12,
      "formatted_start": "01:34:42.120",
      "formatted_end": "01:34:48.120",
      "text": "اما با اقسامونو الان فصل اصحال است ممکنه اصحال واقعیم بگیره به این نسبت بده"
    },
    {
      "id": 58,
      "start": 5688.12,
      "end": 5693.12,
      "formatted_start": "01:34:48.120",
      "formatted_end": "01:34:53.120",
      "text": "بگیره خود اینو بگیره، اصحال ببایی بده، با اقسامونو اصحال ترشویی بده"
    },
    {
      "id": 59,
      "start": 5693.12,
      "end": 5700.12,
      "formatted_start": "01:34:53.120",
      "formatted_end": "01:35:00.120",
      "text": "برخور، وحشت خانمها، تلقین خانمها به دارون و شدین اواردش است"
    }
  ],
  "status": "completed"
}