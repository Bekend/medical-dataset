  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7825.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:25.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 7825.0,
      "end": 7827.0,
      "formatted_start": "02:10:25.000",
      "formatted_end": "02:10:27.000",
      "text": "سلام بخونم"
    },
    {
      "id": 2,
      "start": 7827.0,
      "end": 7829.0,
      "formatted_start": "02:10:27.000",
      "formatted_end": "02:10:29.000",
      "text": "چند روز بخونیم؟"
    },
    {
      "id": 3,
      "start": 7829.0,
      "end": 7831.0,
      "formatted_start": "02:10:29.000",
      "formatted_end": "02:10:31.000",
      "text": "جوان میخوام بیاون؟"
    },
    {
      "id": 4,
      "start": 7831.0,
      "end": 7833.0,
      "formatted_start": "02:10:31.000",
      "formatted_end": "02:10:33.000",
      "text": "نه نه کار در خدمت هم بخونیم"
    },
    {
      "id": 5,
      "start": 7833.0,
      "end": 7837.0,
      "formatted_start": "02:10:33.000",
      "formatted_end": "02:10:37.000",
      "text": "دختر ما دیدو پری روز آوردن پیشتون"
    },
    {
      "id": 6,
      "start": 7837.0,
      "end": 7839.0,
      "formatted_start": "02:10:37.000",
      "formatted_end": "02:10:39.000",
      "text": "پری روز که تکیه پری هست"
    },
    {
      "id": 7,
      "start": 7839.0,
      "end": 7841.0,
      "formatted_start": "02:10:39.000",
      "formatted_end": "02:10:41.000",
      "text": "پری روز آوردن پیشتون"
    },
    {
      "id": 8,
      "start": 7841.0,
      "end": 7843.0,
      "formatted_start": "02:10:41.000",
      "formatted_end": "02:10:43.000",
      "text": "به هر دیگر بی بلا آوردن"
    },
    {
      "id": 9,
      "start": 7843.0,
      "end": 7845.0,
      "formatted_start": "02:10:43.000",
      "formatted_end": "02:10:45.000",
      "text": "به هر استفراغی"
    },
    {
      "id": 10,
      "start": 7845.0,
      "end": 7849.0,
      "formatted_start": "02:10:45.000",
      "formatted_end": "02:10:49.000",
      "text": "برای دیگر از همون روز داروهایشان بهش میده ما"
    },
    {
      "id": 11,
      "start": 7849.0,
      "end": 7853.0,
      "formatted_start": "02:10:49.000",
      "formatted_end": "02:10:53.000",
      "text": "برای دیشب خیلی شریف دارو باید آورد"
    },
    {
      "id": 12,
      "start": 7853.0,
      "end": 7859.0,
      "formatted_start": "02:10:53.000",
      "formatted_end": "02:10:59.000",
      "text": "بود اینکه همون بالا آور دشت بده به خاطر من مثلا ندادم بهش"
    },
    {
      "id": 13,
      "start": 7859.0,
      "end": 7865.0,
      "formatted_start": "02:10:59.000",
      "formatted_end": "02:11:05.000",
      "text": "بعد که دیشتر بالا آور دوار داشتدم بلکه باز ببارو صبح هم بالا آور باید که داروشو بگیرم"
    },
    {
      "id": 14,
      "start": 7865.0,
      "end": 7868.0,
      "formatted_start": "02:11:05.000",
      "formatted_end": "02:11:08.000",
      "text": "بعد دیگه ولی خب اصحاب کنن نشده"
    },
    {
      "id": 15,
      "start": 7868.0,
      "end": 7869.0,
      "formatted_start": "02:11:08.000",
      "formatted_end": "02:11:09.000",
      "text": "خوبه"
    },
    {
      "id": 16,
      "start": 7869.0,
      "end": 7874.0,
      "formatted_start": "02:11:09.000",
      "formatted_end": "02:11:14.000",
      "text": "بعد افتاس می کنم که انگار داره فرما می کنه یا گرمش خلطیه"
    },
    {
      "id": 17,
      "start": 7874.0,
      "end": 7876.0,
      "formatted_start": "02:11:14.000",
      "formatted_end": "02:11:16.000",
      "text": "یک زرفه می زنه؟"
    },
    {
      "id": 18,
      "start": 7876.0,
      "end": 7880.0,
      "formatted_start": "02:11:16.000",
      "formatted_end": "02:11:20.000",
      "text": "یک چند تا عدسه زن یک چند تا که بیرون شد آدم آور شد"
    },
    {
      "id": 19,
      "start": 7880.0,
      "end": 7882.0,
      "formatted_start": "02:11:20.000",
      "formatted_end": "02:11:22.000",
      "text": "خب داروی چی دارن می دینی؟"
    },
    {
      "id": 20,
      "start": 7882.0,
      "end": 7884.0,
      "formatted_start": "02:11:22.000",
      "formatted_end": "02:11:24.000",
      "text": "یا روی یه دونه باستی حالت تراشت رو بگیریم"
    },
    {
      "id": 21,
      "start": 7884.0,
      "end": 7886.0,
      "formatted_start": "02:11:24.000",
      "formatted_end": "02:11:26.000",
      "text": "نه اسماشون هکس نگرفتیم با موبایل ای کنیم"
    },
    {
      "id": 22,
      "start": 7886.0,
      "end": 7888.0,
      "formatted_start": "02:11:26.000",
      "formatted_end": "02:11:28.000",
      "text": "متران بود"
    },
    {
      "id": 23,
      "start": 7888.0,
      "end": 7890.0,
      "formatted_start": "02:11:28.000",
      "formatted_end": "02:11:30.000",
      "text": "مترانیدازول"
    },
    {
      "id": 24,
      "start": 7890.0,
      "end": 7892.0,
      "formatted_start": "02:11:30.000",
      "formatted_end": "02:11:32.000",
      "text": "یه دونه مترانیدازول"
    },
    {
      "id": 25,
      "start": 7892.0,
      "end": 7894.0,
      "formatted_start": "02:11:32.000",
      "formatted_end": "02:11:34.000",
      "text": "یه دونه آندرامین"
    },
    {
      "id": 26,
      "start": 7894.0,
      "end": 7896.0,
      "formatted_start": "02:11:34.000",
      "formatted_end": "02:11:36.000",
      "text": "و یه دونه"
    },
    {
      "id": 27,
      "start": 7896.0,
      "end": 7898.0,
      "formatted_start": "02:11:36.000",
      "formatted_end": "02:11:38.000",
      "text": "آردیسیکلومین"
    },
    {
      "id": 28,
      "start": 7898.0,
      "end": 7900.0,
      "formatted_start": "02:11:38.000",
      "formatted_end": "02:11:40.000",
      "text": "بیقرار بوده"
    },
    {
      "id": 29,
      "start": 7900.0,
      "end": 7902.0,
      "formatted_start": "02:11:40.000",
      "formatted_end": "02:11:42.000",
      "text": "خیلی بیقراری میکرد"
    },
    {
      "id": 30,
      "start": 7902.0,
      "end": 7904.0,
      "formatted_start": "02:11:42.000",
      "formatted_end": "02:11:44.000",
      "text": "و تور کرد"
    },
    {
      "id": 31,
      "start": 7904.0,
      "end": 7906.0,
      "formatted_start": "02:11:44.000",
      "formatted_end": "02:11:46.000",
      "text": "من خودم بهش استمیدون"
    },
    {
      "id": 32,
      "start": 7906.0,
      "end": 7908.0,
      "formatted_start": "02:11:46.000",
      "formatted_end": "02:11:48.000",
      "text": "من ریست که میشن کلن بد اخلاق هست"
    },
    {
      "id": 33,
      "start": 7908.0,
      "end": 7910.0,
      "formatted_start": "02:11:48.000",
      "formatted_end": "02:11:50.000",
      "text": "فقط میگن مارو بغل کنید راه"
    },
    {
      "id": 34,
      "start": 7910.0,
      "end": 7912.0,
      "formatted_start": "02:11:50.000",
      "formatted_end": "02:11:52.000",
      "text": "خب الان تب اینا داره؟"
    },
    {
      "id": 35,
      "start": 7912.0,
      "end": 7914.0,
      "formatted_start": "02:11:52.000",
      "formatted_end": "02:11:54.000",
      "text": "الان صبح یکم بدنش داره"
    },
    {
      "id": 36,
      "start": 7914.0,
      "end": 7915.0,
      "formatted_start": "02:11:54.000",
      "formatted_end": "02:11:55.000",
      "text": "نه تب اونو می کنی؟"
    },
    {
      "id": 37,
      "start": 7915.0,
      "end": 7917.0,
      "formatted_start": "02:11:55.000",
      "formatted_end": "02:11:57.000",
      "text": "آره سی و شیش و نیم سی و هم"
    },
    {
      "id": 38,
      "start": 7917.0,
      "end": 7919.0,
      "formatted_start": "02:11:57.000",
      "formatted_end": "02:11:59.000",
      "text": "نه اون تب نیست"
    },
    {
      "id": 39,
      "start": 7919.0,
      "end": 7921.0,
      "formatted_start": "02:11:59.000",
      "formatted_end": "02:12:01.000",
      "text": "سی شیش و نیم سی هفت و نیم"
    },
    {
      "id": 40,
      "start": 7921.0,
      "end": 7923.0,
      "formatted_start": "02:12:01.000",
      "formatted_end": "02:12:03.000",
      "text": "بالای سی هفت و نیم؟"
    },
    {
      "id": 41,
      "start": 7923.0,
      "end": 7925.0,
      "formatted_start": "02:12:03.000",
      "formatted_end": "02:12:05.000",
      "text": "نه سی هشت و نیم بود"
    },
    {
      "id": 42,
      "start": 7925.0,
      "end": 7927.0,
      "formatted_start": "02:12:05.000",
      "formatted_end": "02:12:07.000",
      "text": "نه تب نیم سی هشت تب"
    },
    {
      "id": 43,
      "start": 7927.0,
      "end": 7929.0,
      "formatted_start": "02:12:07.000",
      "formatted_end": "02:12:09.000",
      "text": "نه سی هفت و نیم بود"
    },
    {
      "id": 44,
      "start": 7929.0,
      "end": 7931.0,
      "formatted_start": "02:12:09.000",
      "formatted_end": "02:12:11.000",
      "text": "سی هفت و نیم تب نیم"
    },
    {
      "id": 45,
      "start": 7931.0,
      "end": 7933.0,
      "formatted_start": "02:12:11.000",
      "formatted_end": "02:12:13.000",
      "text": "یه لحظه بزنه"
    },
    {
      "id": 46,
      "start": 7933.0,
      "end": 7935.0,
      "formatted_start": "02:12:13.000",
      "formatted_end": "02:12:15.000",
      "text": "یه کم لحظه فهمی؟"
    },
    {
      "id": 47,
      "start": 7935.0,
      "end": 7937.0,
      "formatted_start": "02:12:15.000",
      "formatted_end": "02:12:17.000",
      "text": "یه کم لحظه فهمی؟"
    },
    {
      "id": 48,
      "start": 7937.0,
      "end": 7939.0,
      "formatted_start": "02:12:17.000",
      "formatted_end": "02:12:19.000",
      "text": "این چشمت که چند من بری زنیم"
    },
    {
      "id": 49,
      "start": 7939.0,
      "end": 7941.0,
      "formatted_start": "02:12:19.000",
      "formatted_end": "02:12:21.000",
      "text": "از اینجا برم"
    },
    {
      "id": 50,
      "start": 7941.0,
      "end": 7943.0,
      "formatted_start": "02:12:21.000",
      "formatted_end": "02:12:23.000",
      "text": "بسرمیشیم"
    },
    {
      "id": 51,
      "start": 7943.0,
      "end": 7947.0,
      "formatted_start": "02:12:23.000",
      "formatted_end": "02:12:27.000",
      "text": "هرم احساس میکنید سرما خورده"
    },
    {
      "id": 52,
      "start": 7947.0,
      "end": 7949.0,
      "formatted_start": "02:12:27.000",
      "formatted_end": "02:12:29.000",
      "text": "عجزه میکنم هرم"
    },
    {
      "id": 53,
      "start": 7949.0,
      "end": 7951.0,
      "formatted_start": "02:12:29.000",
      "formatted_end": "02:12:31.000",
      "text": "بسرم بسرم"
    },
    {
      "id": 54,
      "start": 7951.0,
      "end": 7953.0,
      "formatted_start": "02:12:31.000",
      "formatted_end": "02:12:33.000",
      "text": "کاری نگرده"
    },
    {
      "id": 55,
      "start": 7957.0,
      "end": 7959.0,
      "formatted_start": "02:12:37.000",
      "formatted_end": "02:12:39.000",
      "text": "دستاشو میگردید"
    },
    {
      "id": 56,
      "start": 7959.0,
      "end": 7961.0,
      "formatted_start": "02:12:39.000",
      "formatted_end": "02:12:41.000",
      "text": "احساس میکنم مایی نکنم"
    },
    {
      "id": 57,
      "start": 7961.0,
      "end": 7963.0,
      "formatted_start": "02:12:41.000",
      "formatted_end": "02:12:43.000",
      "text": "شما اینجوری میگردید"
    },
    {
      "id": 58,
      "start": 7963.0,
      "end": 7965.0,
      "formatted_start": "02:12:43.000",
      "formatted_end": "02:12:45.000",
      "text": "ببین ببین"
    },
    {
      "id": 59,
      "start": 7965.0,
      "end": 7968.0,
      "formatted_start": "02:12:45.000",
      "formatted_end": "02:12:48.000",
      "text": "اینجور دست کنید و سرشون دید"
    },
    {
      "id": 60,
      "start": 7970.0,
      "end": 7972.0,
      "formatted_start": "02:12:50.000",
      "formatted_end": "02:12:52.000",
      "text": "اگر نگه نده اینجور بگیر"
    },
    {
      "id": 61,
      "start": 7972.0,
      "end": 7974.0,
      "formatted_start": "02:12:52.000",
      "formatted_end": "02:12:54.000",
      "text": "بگیر دید و من نگه شونم بگیر"
    },
    {
      "id": 62,
      "start": 7984.0,
      "end": 7987.0,
      "formatted_start": "02:13:04.000",
      "formatted_end": "02:13:07.000",
      "text": "ماما مامان چرا؟ خوبه نوشن کرده برای آن"
    },
    {
      "id": 63,
      "start": 7987.0,
      "end": 7989.0,
      "formatted_start": "02:13:07.000",
      "formatted_end": "02:13:09.000",
      "text": "خراب"
    },
    {
      "id": 64,
      "start": 7989.0,
      "end": 7991.0,
      "formatted_start": "02:13:09.000",
      "formatted_end": "02:13:11.000",
      "text": "خراب"
    },
    {
      "id": 65,
      "start": 7991.0,
      "end": 7993.0,
      "formatted_start": "02:13:11.000",
      "formatted_end": "02:13:13.000",
      "text": "جام"
    },
    {
      "id": 66,
      "start": 7993.0,
      "end": 7995.0,
      "formatted_start": "02:13:13.000",
      "formatted_end": "02:13:15.000",
      "text": "اما کداش راسته"
    },
    {
      "id": 67,
      "start": 7995.0,
      "end": 7997.0,
      "formatted_start": "02:13:15.000",
      "formatted_end": "02:13:17.000",
      "text": "باش باش بگیر"
    },
    {
      "id": 68,
      "start": 7997.0,
      "end": 7999.0,
      "formatted_start": "02:13:17.000",
      "formatted_end": "02:13:19.000",
      "text": "خب"
    },
    {
      "id": 69,
      "start": 7999.0,
      "end": 8001.0,
      "formatted_start": "02:13:19.000",
      "formatted_end": "02:13:21.000",
      "text": "خانمی که این را خواهید"
    },
    {
      "id": 70,
      "start": 8001.0,
      "end": 8003.0,
      "formatted_start": "02:13:21.000",
      "formatted_end": "02:13:23.000",
      "text": "میگه من جای این را فکر نمیبرون"
    },
    {
      "id": 71,
      "start": 8003.0,
      "end": 8005.0,
      "formatted_start": "02:13:23.000",
      "formatted_end": "02:13:25.000",
      "text": "باید همه را سیستن که افتاده"
    },
    {
      "id": 72,
      "start": 8005.0,
      "end": 8007.0,
      "formatted_start": "02:13:25.000",
      "formatted_end": "02:13:27.000",
      "text": "خواهیم حالت خواهید"
    },
    {
      "id": 73,
      "start": 8007.0,
      "end": 8009.0,
      "formatted_start": "02:13:27.000",
      "formatted_end": "02:13:29.000",
      "text": "خب چه روی دیگه"
    },
    {
      "id": 74,
      "start": 8009.0,
      "end": 8011.0,
      "formatted_start": "02:13:29.000",
      "formatted_end": "02:13:31.000",
      "text": "خب چه روی دیگه"
    },
    {
      "id": 75,
      "start": 8011.0,
      "end": 8013.0,
      "formatted_start": "02:13:31.000",
      "formatted_end": "02:13:33.000",
      "text": "زنگی شهرده"
    },
    {
      "id": 76,
      "start": 8013.0,
      "end": 8015.0,
      "formatted_start": "02:13:33.000",
      "formatted_end": "02:13:35.000",
      "text": "یک سال رو گشت ماشا"
    },
    {
      "id": 77,
      "start": 8015.0,
      "end": 8017.0,
      "formatted_start": "02:13:35.000",
      "formatted_end": "02:13:37.000",
      "text": "اتکار"
    },
    {
      "id": 78,
      "start": 8017.0,
      "end": 8019.0,
      "formatted_start": "02:13:37.000",
      "formatted_end": "02:13:39.000",
      "text": "اتکار"
    },
    {
      "id": 79,
      "start": 8019.0,
      "end": 8024.0,
      "formatted_start": "02:13:39.000",
      "formatted_end": "02:13:44.000",
      "text": "بعد اومیوکن خیلی چیزه خیلی شکمی صرف کار میکنه"
    },
    {
      "id": 80,
      "start": 8024.0,
      "end": 8027.0,
      "formatted_start": "02:13:44.000",
      "formatted_end": "02:13:47.000",
      "text": "از اینکه از روزی یک بار کار میکنه"
    },
    {
      "id": 81,
      "start": 8027.0,
      "end": 8028.0,
      "formatted_start": "02:13:47.000",
      "formatted_end": "02:13:48.000",
      "text": "با عذیب؟"
    },
    {
      "id": 82,
      "start": 8028.0,
      "end": 8029.0,
      "formatted_start": "02:13:48.000",
      "formatted_end": "02:13:49.000",
      "text": "آره ولی زور میزن"
    },
    {
      "id": 83,
      "start": 8029.0,
      "end": 8032.0,
      "formatted_start": "02:13:49.000",
      "formatted_end": "02:13:52.000",
      "text": "یه شروط انکیرم براش میمیسم"
    },
    {
      "id": 84,
      "start": 8032.0,
      "end": 8034.0,
      "formatted_start": "02:13:52.000",
      "formatted_end": "02:13:54.000",
      "text": "دکتر اتکار دیگه دیگه براش"
    },
    {
      "id": 85,
      "start": 8034.0,
      "end": 8035.0,
      "formatted_start": "02:13:54.000",
      "formatted_end": "02:13:55.000",
      "text": "دور درمش"
    },
    {
      "id": 86,
      "start": 8035.0,
      "end": 8037.0,
      "formatted_start": "02:13:55.000",
      "formatted_end": "02:13:57.000",
      "text": "مولت اینا ندی؟"
    },
    {
      "id": 87,
      "start": 8037.0,
      "end": 8039.0,
      "formatted_start": "02:13:57.000",
      "formatted_end": "02:13:59.000",
      "text": "کاکاو و مولت انار ندی؟"
    },
    {
      "id": 88,
      "start": 8039.0,
      "end": 8041.0,
      "formatted_start": "02:13:59.000",
      "formatted_end": "02:14:01.000",
      "text": "اصلا غذا نمیخوره"
    },
    {
      "id": 89,
      "start": 8041.0,
      "end": 8043.0,
      "formatted_start": "02:14:01.000",
      "formatted_end": "02:14:03.000",
      "text": "بلکه چیه؟"
    },
    {
      "id": 90,
      "start": 8043.0,
      "end": 8044.0,
      "formatted_start": "02:14:03.000",
      "formatted_end": "02:14:04.000",
      "text": "بله؟"
    },
    {
      "id": 91,
      "start": 8044.0,
      "end": 8048.0,
      "formatted_start": "02:14:04.000",
      "formatted_end": "02:14:08.000",
      "text": "اگر یک خیلی بد دارویه، اینکه باید دیگه تدلیگه بدید"
    },
    {
      "id": 92,
      "start": 8048.0,
      "end": 8050.0,
      "formatted_start": "02:14:08.000",
      "formatted_end": "02:14:10.000",
      "text": "آره، خیلی بد"
    },
    {
      "id": 93,
      "start": 8050.0,
      "end": 8052.0,
      "formatted_start": "02:14:10.000",
      "formatted_end": "02:14:12.000",
      "text": "بد دارویه، بد دارویه"
    },
    {
      "id": 94,
      "start": 8052.0,
      "end": 8054.0,
      "formatted_start": "02:14:12.000",
      "formatted_end": "02:14:14.000",
      "text": "در این روز صبح هم استفراح کرده؟"
    },
    {
      "id": 95,
      "start": 8054.0,
      "end": 8057.0,
      "formatted_start": "02:14:14.000",
      "formatted_end": "02:14:17.000",
      "text": "آره، دستا شیخه، بقیه بدنش داغه"
    },
    {
      "id": 96,
      "start": 8057.0,
      "end": 8059.0,
      "formatted_start": "02:14:17.000",
      "formatted_end": "02:14:19.000",
      "text": "یا مثلا آقا شیخه"
    },
    {
      "id": 97,
      "start": 8059.0,
      "end": 8061.0,
      "formatted_start": "02:14:19.000",
      "formatted_end": "02:14:21.000",
      "text": "همینو نمیگم دستا شیخه"
    },
    {
      "id": 98,
      "start": 8061.0,
      "end": 8063.0,
      "formatted_start": "02:14:21.000",
      "formatted_end": "02:14:23.000",
      "text": "شروط مترونی دازور ندیم"
    },
    {
      "id": 99,
      "start": 8063.0,
      "end": 8065.0,
      "formatted_start": "02:14:23.000",
      "formatted_end": "02:14:25.000",
      "text": "به جاش هیلیترو مایسین"
    },
    {
      "id": 100,
      "start": 8065.0,
      "end": 8068.0,
      "formatted_start": "02:14:25.000",
      "formatted_end": "02:14:28.000",
      "text": "این شروطه خوشمانده تر هم نمیخوره"
    },
    {
      "id": 101,
      "start": 8068.0,
      "end": 8071.0,
      "formatted_start": "02:14:28.000",
      "formatted_end": "02:14:31.000",
      "text": "نه اون نیمی کنه خوشماننده تر هم نیمی کنه"
    },
    {
      "id": 102,
      "start": 8071.0,
      "end": 8073.0,
      "formatted_start": "02:14:31.000",
      "formatted_end": "02:14:33.000",
      "text": "حالا وقتی نخونه هیچی نیمی کنه"
    },
    {
      "id": 103,
      "start": 8073.0,
      "end": 8074.0,
      "formatted_start": "02:14:33.000",
      "formatted_end": "02:14:34.000",
      "text": "آره"
    },
    {
      "id": 104,
      "start": 8074.0,
      "end": 8076.0,
      "formatted_start": "02:14:34.000",
      "formatted_end": "02:14:36.000",
      "text": "اونجوریش که قبلیتر و بهتر بخوره نه"
    },
    {
      "id": 105,
      "start": 8076.0,
      "end": 8078.0,
      "formatted_start": "02:14:36.000",
      "formatted_end": "02:14:38.000",
      "text": "نه میگو خوشمزده تر"
    },
    {
      "id": 106,
      "start": 8078.0,
      "end": 8080.0,
      "formatted_start": "02:14:38.000",
      "formatted_end": "02:14:40.000",
      "text": "نه خوشمزده تر نیست"
    },
    {
      "id": 107,
      "start": 8080.0,
      "end": 8085.0,
      "formatted_start": "02:14:40.000",
      "formatted_end": "02:14:45.000",
      "text": "این همه مزارشو هیچگویه بچه سخته کنن بچه هم بد دارون کنه"
    },
    {
      "id": 108,
      "start": 8085.0,
      "end": 8089.0,
      "formatted_start": "02:14:45.000",
      "formatted_end": "02:14:49.000",
      "text": "بعد یه سال دیگه هم داشتن از این دعواشو من باز میکنم که یک چال برون"
    },
    {
      "id": 109,
      "start": 8089.0,
      "end": 8090.0,
      "formatted_start": "02:14:49.000",
      "formatted_end": "02:14:50.000",
      "text": "دو هفته"
    },
    {
      "id": 110,
      "start": 8090.0,
      "end": 8092.0,
      "formatted_start": "02:14:50.000",
      "formatted_end": "02:14:52.000",
      "text": "یک شان هم نمیخواییم"
    },
    {
      "id": 111,
      "start": 8092.0,
      "end": 8094.0,
      "formatted_start": "02:14:52.000",
      "formatted_end": "02:14:54.000",
      "text": "یک شان بیرونم روشیم"
    },
    {
      "id": 112,
      "start": 8094.0,
      "end": 8096.0,
      "formatted_start": "02:14:54.000",
      "formatted_end": "02:14:56.000",
      "text": "من درست دارم دو هفته مجاز روزیم"
    },
    {
      "id": 113,
      "start": 8096.0,
      "end": 8098.0,
      "formatted_start": "02:14:56.000",
      "formatted_end": "02:14:58.000",
      "text": "برد یه چیزی دیگه هم نمیخواستم"
    },
    {
      "id": 114,
      "start": 8098.0,
      "end": 8100.0,
      "formatted_start": "02:14:58.000",
      "formatted_end": "02:15:00.000",
      "text": "نمیشه برای ویدیو"
    }
  ],
  "status": "completed"
}