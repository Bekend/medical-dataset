  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13215.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:15.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13231.0,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:31.000",
      "text": "خیلی برد"
    },
    {
      "id": 2,
      "start": 13231.0,
      "end": 13232.0,
      "formatted_start": "03:40:31.000",
      "formatted_end": "03:40:32.000",
      "text": "صرفای شدید"
    },
    {
      "id": 3,
      "start": 13232.0,
      "end": 13233.0,
      "formatted_start": "03:40:32.000",
      "formatted_end": "03:40:33.000",
      "text": "برد"
    },
    {
      "id": 4,
      "start": 13233.0,
      "end": 13234.0,
      "formatted_start": "03:40:33.000",
      "formatted_end": "03:40:34.000",
      "text": "حدسه"
    },
    {
      "id": 5,
      "start": 13234.0,
      "end": 13235.0,
      "formatted_start": "03:40:34.000",
      "formatted_end": "03:40:35.000",
      "text": "برد"
    },
    {
      "id": 6,
      "start": 13235.0,
      "end": 13236.0,
      "formatted_start": "03:40:35.000",
      "formatted_end": "03:40:36.000",
      "text": "ازش بینشم"
    },
    {
      "id": 7,
      "start": 13236.0,
      "end": 13237.0,
      "formatted_start": "03:40:36.000",
      "formatted_end": "03:40:37.000",
      "text": "یه روز بیدارم همه دارم"
    },
    {
      "id": 8,
      "start": 13237.0,
      "end": 13239.0,
      "formatted_start": "03:40:37.000",
      "formatted_end": "03:40:39.000",
      "text": "وقتی حدسه میکنم مثلا آب بینشم"
    },
    {
      "id": 9,
      "start": 13239.0,
      "end": 13240.0,
      "formatted_start": "03:40:39.000",
      "formatted_end": "03:40:40.000",
      "text": "طب اینا چی؟"
    },
    {
      "id": 10,
      "start": 13240.0,
      "end": 13242.0,
      "formatted_start": "03:40:40.000",
      "formatted_end": "03:40:42.000",
      "text": "طب اینا زیاد نکردم"
    },
    {
      "id": 11,
      "start": 13242.0,
      "end": 13243.0,
      "formatted_start": "03:40:42.000",
      "formatted_end": "03:40:43.000",
      "text": "و خسخس سینه؟"
    },
    {
      "id": 12,
      "start": 13243.0,
      "end": 13244.0,
      "formatted_start": "03:40:43.000",
      "formatted_end": "03:40:44.000",
      "text": "دارم"
    },
    {
      "id": 13,
      "start": 13244.0,
      "end": 13245.0,
      "formatted_start": "03:40:44.000",
      "formatted_end": "03:40:45.000",
      "text": "چند ماهشه؟"
    },
    {
      "id": 14,
      "start": 13245.0,
      "end": 13246.0,
      "formatted_start": "03:40:45.000",
      "formatted_end": "03:40:46.000",
      "text": "اونا بود"
    },
    {
      "id": 15,
      "start": 13246.0,
      "end": 13248.0,
      "formatted_start": "03:40:46.000",
      "formatted_end": "03:40:48.000",
      "text": "امیدواروز بید دو ماه شده"
    },
    {
      "id": 16,
      "start": 13248.0,
      "end": 13251.0,
      "formatted_start": "03:40:48.000",
      "formatted_end": "03:40:51.000",
      "text": "واکسنو کسانی من بردشم و برشم"
    },
    {
      "id": 17,
      "start": 13251.0,
      "end": 13253.0,
      "formatted_start": "03:40:51.000",
      "formatted_end": "03:40:53.000",
      "text": "واکسنو کهی دردی؟"
    },
    {
      "id": 18,
      "start": 13253.0,
      "end": 13255.0,
      "formatted_start": "03:40:53.000",
      "formatted_end": "03:40:55.000",
      "text": "در روز سه روز بیشم"
    },
    {
      "id": 19,
      "start": 13255.0,
      "end": 13261.0,
      "formatted_start": "03:40:55.000",
      "formatted_end": "03:41:01.000",
      "text": "خوب شما بالا بسته؟ بسترش نهیمه"
    },
    {
      "id": 20,
      "start": 13261.0,
      "end": 13269.0,
      "formatted_start": "03:41:01.000",
      "formatted_end": "03:41:09.000",
      "text": "شکمشم برخوره"
    },
    {
      "id": 21,
      "start": 13285.0,
      "end": 13295.68,
      "formatted_start": "03:41:25.000",
      "formatted_end": "03:41:35.680",
      "text": "سراش هم گرفته"
    },
    {
      "id": 22,
      "start": 13295.68,
      "end": 13298.76,
      "formatted_start": "03:41:35.680",
      "formatted_end": "03:41:38.760",
      "text": "سیمی فردو برنده"
    },
    {
      "id": 23,
      "start": 13298.76,
      "end": 13301.22,
      "formatted_start": "03:41:38.760",
      "formatted_end": "03:41:41.220",
      "text": "سیمی فردو برنده"
    },
    {
      "id": 24,
      "start": 13301.22,
      "end": 13304.74,
      "formatted_start": "03:41:41.220",
      "formatted_end": "03:41:44.740",
      "text": "سیمی فردو باشه تبای شدید میده"
    },
    {
      "id": 25,
      "start": 13304.74,
      "end": 13305.46,
      "formatted_start": "03:41:44.740",
      "formatted_end": "03:41:45.460",
      "text": "خب"
    },
    {
      "id": 26,
      "start": 13305.46,
      "end": 13308.62,
      "formatted_start": "03:41:45.460",
      "formatted_end": "03:41:48.620",
      "text": "بیمه هستید"
    },
    {
      "id": 27,
      "start": 13308.62,
      "end": 13311.38,
      "formatted_start": "03:41:48.620",
      "formatted_end": "03:41:51.380",
      "text": "برخواب تر ترانسات"
    },
    {
      "id": 28,
      "start": 13311.38,
      "end": 13312.08,
      "formatted_start": "03:41:51.380",
      "formatted_end": "03:41:52.080",
      "text": "یک میره"
    },
    {
      "id": 29,
      "start": 13312.08,
      "end": 13315.58,
      "formatted_start": "03:41:52.080",
      "formatted_end": "03:41:55.580",
      "text": "خواهی چکنی؟ رو هستی؟ وقت بیاد؟"
    },
    {
      "id": 30,
      "start": 13315.58,
      "end": 13319.32,
      "formatted_start": "03:41:55.580",
      "formatted_end": "03:41:59.320",
      "text": "اتو آقا میاد شد برای ما بیاد"
    },
    {
      "id": 31,
      "start": 13319.32,
      "end": 13325.32,
      "formatted_start": "03:41:59.320",
      "formatted_end": "03:42:05.320",
      "text": "خب، پس من فیلم بیمه می نویستم اون خوشکنندهش روزی یک کنین سی سی"
    },
    {
      "id": 32,
      "start": 13325.32,
      "end": 13327.32,
      "formatted_start": "03:42:05.320",
      "formatted_end": "03:42:07.320",
      "text": "حالا"
    },
    {
      "id": 33,
      "start": 13327.32,
      "end": 13329.32,
      "formatted_start": "03:42:07.320",
      "formatted_end": "03:42:09.320",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 13329.32,
      "end": 13330.32,
      "formatted_start": "03:42:09.320",
      "formatted_end": "03:42:10.320",
      "text": "فامیلتون؟"
    },
    {
      "id": 35,
      "start": 13330.32,
      "end": 13331.32,
      "formatted_start": "03:42:10.320",
      "formatted_end": "03:42:11.320",
      "text": "از دیگر آبشونه"
    },
    {
      "id": 36,
      "start": 13331.32,
      "end": 13333.32,
      "formatted_start": "03:42:11.320",
      "formatted_end": "03:42:13.320",
      "text": "از دیگر؟"
    },
    {
      "id": 37,
      "start": 13333.32,
      "end": 13335.32,
      "formatted_start": "03:42:13.320",
      "formatted_end": "03:42:15.320",
      "text": "نیست به بس خوره نیست"
    },
    {
      "id": 38,
      "start": 13335.32,
      "end": 13337.32,
      "formatted_start": "03:42:15.320",
      "formatted_end": "03:42:17.320",
      "text": "نه نه نه نه شیطان"
    },
    {
      "id": 39,
      "start": 13337.32,
      "end": 13339.32,
      "formatted_start": "03:42:17.320",
      "formatted_end": "03:42:19.320",
      "text": "اون خشکننده شو"
    },
    {
      "id": 40,
      "start": 13339.32,
      "end": 13341.32,
      "formatted_start": "03:42:19.320",
      "formatted_end": "03:42:21.320",
      "text": "آب می ریزی"
    },
    {
      "id": 41,
      "start": 13341.32,
      "end": 13343.32,
      "formatted_start": "03:42:21.320",
      "formatted_end": "03:42:23.320",
      "text": "آزیترو مایسین کچی"
    },
    {
      "id": 42,
      "start": 13343.32,
      "end": 13347.32,
      "formatted_start": "03:42:23.320",
      "formatted_end": "03:42:27.320",
      "text": "آب می ریزی روزی یکونیم سی سی بهش می بینی"
    },
    {
      "id": 43,
      "start": 13347.32,
      "end": 13351.32,
      "formatted_start": "03:42:27.320",
      "formatted_end": "03:42:31.320",
      "text": "هر روز یکونیم سی ساوی"
    },
    {
      "id": 44,
      "start": 13351.32,
      "end": 13353.32,
      "formatted_start": "03:42:31.320",
      "formatted_end": "03:42:33.320",
      "text": "که ایجادی؟"
    },
    {
      "id": 45,
      "start": 13353.32,
      "end": 13355.32,
      "formatted_start": "03:42:33.320",
      "formatted_end": "03:42:35.320",
      "text": "این رو هم سمیدی؟"
    },
    {
      "id": 46,
      "start": 13355.32,
      "end": 13357.32,
      "formatted_start": "03:42:35.320",
      "formatted_end": "03:42:37.320",
      "text": "شروط شیز داده بوده"
    },
    {
      "id": 47,
      "start": 13357.32,
      "end": 13359.32,
      "formatted_start": "03:42:37.320",
      "formatted_end": "03:42:39.320",
      "text": "مطلع پلاروژین هست یه دفعه"
    },
    {
      "id": 48,
      "start": 13359.32,
      "end": 13361.32,
      "formatted_start": "03:42:39.320",
      "formatted_end": "03:42:41.320",
      "text": "خب داری؟"
    },
    {
      "id": 49,
      "start": 13361.32,
      "end": 13363.32,
      "formatted_start": "03:42:41.320",
      "formatted_end": "03:42:43.320",
      "text": "از همون دو روزو می دهم"
    },
    {
      "id": 50,
      "start": 13363.32,
      "end": 13365.32,
      "formatted_start": "03:42:43.320",
      "formatted_end": "03:42:45.320",
      "text": "وقتی می دهم می گم صرف آشکم ترونی شد"
    },
    {
      "id": 51,
      "start": 13365.32,
      "end": 13368.32,
      "formatted_start": "03:42:45.320",
      "formatted_end": "03:42:48.320",
      "text": "خب پلارچین هنو دوباره نوشتم اگه داری خط بزنید"
    },
    {
      "id": 52,
      "start": 13368.32,
      "end": 13369.32,
      "formatted_start": "03:42:48.320",
      "formatted_end": "03:42:49.320",
      "text": "من دارم من از این داریم"
    },
    {
      "id": 53,
      "start": 13369.32,
      "end": 13369.82,
      "formatted_start": "03:42:49.320",
      "formatted_end": "03:42:49.820",
      "text": "داری؟"
    },
    {
      "id": 54,
      "start": 13369.82,
      "end": 13370.32,
      "formatted_start": "03:42:49.820",
      "formatted_end": "03:42:50.320",
      "text": "این داریم"
    },
    {
      "id": 55,
      "start": 13370.32,
      "end": 13371.32,
      "formatted_start": "03:42:50.320",
      "formatted_end": "03:42:51.320",
      "text": "دیگه جا بذاشته بود"
    },
    {
      "id": 56,
      "start": 13371.32,
      "end": 13372.32,
      "formatted_start": "03:42:51.320",
      "formatted_end": "03:42:52.320",
      "text": "باشی"
    },
    {
      "id": 57,
      "start": 13375.32,
      "end": 13378.32,
      "formatted_start": "03:42:55.320",
      "formatted_end": "03:42:58.320",
      "text": "همونو با خوش کن یه جا بدن"
    },
    {
      "id": 58,
      "start": 13378.32,
      "end": 13382.32,
      "formatted_start": "03:42:58.320",
      "formatted_end": "03:43:02.320",
      "text": "اونو با خوش کننده یه شروط هم برای سرتشگاه یک نیزینه نوشتم"
    },
    {
      "id": 59,
      "start": 13382.32,
      "end": 13387.32,
      "formatted_start": "03:43:02.320",
      "formatted_end": "03:43:07.320",
      "text": "به جا این دارو بشنا یه یارو برد میسرین یک یکو من"
    },
    {
      "id": 60,
      "start": 13387.32,
      "end": 13390.32,
      "formatted_start": "03:43:07.320",
      "formatted_end": "03:43:10.320",
      "text": "بس واسه نفتشم یک چیز دارم"
    },
    {
      "id": 61,
      "start": 13390.32,
      "end": 13391.32,
      "formatted_start": "03:43:10.320",
      "formatted_end": "03:43:11.320",
      "text": "اهورانینی بده"
    },
    {
      "id": 62,
      "start": 13391.32,
      "end": 13393.32,
      "formatted_start": "03:43:11.320",
      "formatted_end": "03:43:13.320",
      "text": "اهورانینی تصمیم نداشته باشی"
    },
    {
      "id": 63,
      "start": 13393.32,
      "end": 13395.32,
      "formatted_start": "03:43:13.320",
      "formatted_end": "03:43:15.320",
      "text": "این شروط دیگه"
    },
    {
      "id": 64,
      "start": 13395.32,
      "end": 13397.32,
      "formatted_start": "03:43:15.320",
      "formatted_end": "03:43:17.320",
      "text": "خوبه؟"
    },
    {
      "id": 65,
      "start": 13397.32,
      "end": 13399.32,
      "formatted_start": "03:43:17.320",
      "formatted_end": "03:43:19.320",
      "text": "اگر میدیم خوبه همونو بده"
    },
    {
      "id": 66,
      "start": 13399.32,
      "end": 13401.32,
      "formatted_start": "03:43:19.320",
      "formatted_end": "03:43:21.320",
      "text": "اوه اگه که دست شوی میکنه آقای دختر"
    },
    {
      "id": 67,
      "start": 13401.32,
      "end": 13403.32,
      "formatted_start": "03:43:21.320",
      "formatted_end": "03:43:23.320",
      "text": "خوبه از اون روزه بگیر"
    },
    {
      "id": 68,
      "start": 13403.32,
      "end": 13405.32,
      "formatted_start": "03:43:23.320",
      "formatted_end": "03:43:25.320",
      "text": "یه شروط داروی گیایی فلوس هست"
    },
    {
      "id": 69,
      "start": 13405.32,
      "end": 13407.32,
      "formatted_start": "03:43:25.320",
      "formatted_end": "03:43:27.320",
      "text": "از عطاری بگیر"
    },
    {
      "id": 70,
      "start": 13407.32,
      "end": 13409.32,
      "formatted_start": "03:43:27.320",
      "formatted_end": "03:43:29.320",
      "text": "چوبمانند قهویه"
    },
    {
      "id": 71,
      "start": 13409.32,
      "end": 13411.32,
      "formatted_start": "03:43:29.320",
      "formatted_end": "03:43:31.320",
      "text": "یه تکشه تو آبله کن به بچه میدی"
    },
    {
      "id": 72,
      "start": 13411.32,
      "end": 13413.32,
      "formatted_start": "03:43:31.320",
      "formatted_end": "03:43:33.320",
      "text": "چندون دوتا بچه همون"
    },
    {
      "id": 73,
      "start": 13413.32,
      "end": 13415.32,
      "formatted_start": "03:43:33.320",
      "formatted_end": "03:43:35.320",
      "text": "تا یک سالگی یه بوسط داشت"
    },
    {
      "id": 74,
      "start": 13415.32,
      "end": 13417.32,
      "formatted_start": "03:43:35.320",
      "formatted_end": "03:43:37.320",
      "text": "آره بهش فلوس بده"
    },
    {
      "id": 75,
      "start": 13417.32,
      "end": 13419.32,
      "formatted_start": "03:43:37.320",
      "formatted_end": "03:43:39.320",
      "text": "بنا دادی"
    },
    {
      "id": 76,
      "start": 13419.32,
      "end": 13421.32,
      "formatted_start": "03:43:39.320",
      "formatted_end": "03:43:41.320",
      "text": "سیاهنگ هم بکنن"
    },
    {
      "id": 77,
      "start": 13421.32,
      "end": 13425.32,
      "formatted_start": "03:43:41.320",
      "formatted_end": "03:43:45.320",
      "text": "از این شروط های روغن کرچک هم هست در خانه داره"
    },
    {
      "id": 78,
      "start": 13425.32,
      "end": 13429.32,
      "formatted_start": "03:43:45.320",
      "formatted_end": "03:43:49.320",
      "text": "توش آب قاطی کن روزی دو بار میتونی بدی"
    },
    {
      "id": 79,
      "start": 13429.32,
      "end": 13431.32,
      "formatted_start": "03:43:49.320",
      "formatted_end": "03:43:51.320",
      "text": "بخوایی اسمش رو بیدی؟"
    },
    {
      "id": 80,
      "start": 13431.32,
      "end": 13434.32,
      "formatted_start": "03:43:51.320",
      "formatted_end": "03:43:54.320",
      "text": "بگم نه بسیار دلپیچی گرینیم فقط بخوای در شبونه باز بیدیم"
    },
    {
      "id": 81,
      "start": 13434.32,
      "end": 13437.32,
      "formatted_start": "03:43:54.320",
      "formatted_end": "03:43:57.320",
      "text": "اون بچه ها فلوس میدادی آروم بود؟"
    },
    {
      "id": 82,
      "start": 13437.32,
      "end": 13439.32,
      "formatted_start": "03:43:57.320",
      "formatted_end": "03:43:59.320",
      "text": "اصلا ندادم"
    },
    {
      "id": 83,
      "start": 13439.32,
      "end": 13441.32,
      "formatted_start": "03:43:59.320",
      "formatted_end": "03:44:01.320",
      "text": "ندادی خب فلوس بده؟"
    },
    {
      "id": 84,
      "start": 13441.32,
      "end": 13445.32,
      "formatted_start": "03:44:01.320",
      "formatted_end": "03:44:05.320",
      "text": "ولی بسیار همون که هر نداری دادم تا اون موقعی که راه افتاد"
    },
    {
      "id": 85,
      "start": 13445.32,
      "end": 13446.32,
      "formatted_start": "03:44:05.320",
      "formatted_end": "03:44:06.320",
      "text": "بهتر شد"
    },
    {
      "id": 86,
      "start": 13446.32,
      "end": 13448.32,
      "formatted_start": "03:44:06.320",
      "formatted_end": "03:44:08.320",
      "text": "الان این ببین روغن کرچکه"
    },
    {
      "id": 87,
      "start": 13448.32,
      "end": 13452.32,
      "formatted_start": "03:44:08.320",
      "formatted_end": "03:44:12.320",
      "text": "باید توش آب قاطی کنید رقیق بشه خانم غزی"
    },
    {
      "id": 88,
      "start": 13452.32,
      "end": 13456.32,
      "formatted_start": "03:44:12.320",
      "formatted_end": "03:44:16.320",
      "text": "روز این دو بار دو بار یه پاشوخون مربع کنید"
    },
    {
      "id": 89,
      "start": 13456.32,
      "end": 13458.32,
      "formatted_start": "03:44:16.320",
      "formatted_end": "03:44:18.320",
      "text": "این آزاده این"
    },
    {
      "id": 90,
      "start": 13458.32,
      "end": 13461.32,
      "formatted_start": "03:44:18.320",
      "formatted_end": "03:44:21.320",
      "text": "آزادتاری بگیره؟ نه اینو درخانه هم داره"
    },
    {
      "id": 91,
      "start": 13461.32,
      "end": 13463.32,
      "formatted_start": "03:44:21.320",
      "formatted_end": "03:44:23.320",
      "text": "از طریق فروز میگیره"
    },
    {
      "id": 92,
      "start": 13463.32,
      "end": 13466.32,
      "formatted_start": "03:44:23.320",
      "formatted_end": "03:44:26.320",
      "text": "من هر روز بهش گرمیکه رو اون شربت فروز میدهم"
    },
    {
      "id": 93,
      "start": 13466.32,
      "end": 13469.32,
      "formatted_start": "03:44:26.320",
      "formatted_end": "03:44:29.320",
      "text": "اشکال نداره خوبه نه نه اشکال نداره"
    },
    {
      "id": 94,
      "start": 13469.32,
      "end": 13470.32,
      "formatted_start": "03:44:29.320",
      "formatted_end": "03:44:30.320",
      "text": "خوبه"
    },
    {
      "id": 95,
      "start": 13470.32,
      "end": 13472.32,
      "formatted_start": "03:44:30.320",
      "formatted_end": "03:44:32.320",
      "text": "دارو برش بردم؟"
    },
    {
      "id": 96,
      "start": 13472.32,
      "end": 13475.32,
      "formatted_start": "03:44:32.320",
      "formatted_end": "03:44:35.320",
      "text": "اینو بابر یه از پیر برم بگیرم"
    },
    {
      "id": 97,
      "start": 13475.32,
      "end": 13476.32,
      "formatted_start": "03:44:35.320",
      "formatted_end": "03:44:36.320",
      "text": "برم بگیرم"
    },
    {
      "id": 98,
      "start": 13476.32,
      "end": 13479.32,
      "formatted_start": "03:44:36.320",
      "formatted_end": "03:44:39.320",
      "text": "جان؟ آره بخشت یک میاد در اینجا"
    },
    {
      "id": 99,
      "start": 13479.32,
      "end": 13481.32,
      "formatted_start": "03:44:39.320",
      "formatted_end": "03:44:41.320",
      "text": "ده دقیقه یه روپ دیگه، یه روپ دیگه میاد"
    },
    {
      "id": 100,
      "start": 13482.32,
      "end": 13484.32,
      "formatted_start": "03:44:42.320",
      "formatted_end": "03:44:44.320",
      "text": "سپن"
    },
    {
      "id": 101,
      "start": 13485.32,
      "end": 13486.32,
      "formatted_start": "03:44:45.320",
      "formatted_end": "03:44:46.320",
      "text": "خب ببین"
    },
    {
      "id": 102,
      "start": 13486.32,
      "end": 13487.32,
      "formatted_start": "03:44:46.320",
      "formatted_end": "03:44:47.320",
      "text": "چه؟"
    },
    {
      "id": 103,
      "start": 13487.32,
      "end": 13489.32,
      "formatted_start": "03:44:47.320",
      "formatted_end": "03:44:49.320",
      "text": "اینو توش آب باکی می کنی برای کار کردنش"
    },
    {
      "id": 104,
      "start": 13489.32,
      "end": 13491.32,
      "formatted_start": "03:44:49.320",
      "formatted_end": "03:44:51.320",
      "text": "مرگست بیار"
    },
    {
      "id": 105,
      "start": 13491.32,
      "end": 13493.32,
      "formatted_start": "03:44:51.320",
      "formatted_end": "03:44:53.320",
      "text": "الان خودش بیار نمی باش"
    },
    {
      "id": 106,
      "start": 13497.32,
      "end": 13499.32,
      "formatted_start": "03:44:57.320",
      "formatted_end": "03:44:59.320",
      "text": "بیار سیاده کلچهش"
    },
    {
      "id": 107,
      "start": 13499.32,
      "end": 13500.32,
      "formatted_start": "03:44:59.320",
      "formatted_end": "03:45:00.320",
      "text": "بشون"
    }
  ],
  "status": "completed"
}