    },
    {
      "id": 20,
      "start": 8512.0,
      "end": 8514.0,
      "formatted_start": "02:21:52.000",
      "formatted_end": "02:21:54.000",
      "text": "سلام"
    },
    {
      "id": 21,
      "start": 8514.0,
      "end": 8515.0,
      "formatted_start": "02:21:54.000",
      "formatted_end": "02:21:55.000",
      "text": "سلام"
    },
    {
      "id": 22,
      "start": 8515.0,
      "end": 8522.0,
      "formatted_start": "02:21:55.000",
      "formatted_end": "02:22:02.000",
      "text": "بیشتر بیدن خوب بیشتر"
    },
    {
      "id": 23,
      "start": 8522.0,
      "end": 8550.0,
      "formatted_start": "02:22:02.000",
      "formatted_end": "02:22:30.000",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 8552.0,
      "end": 8572.0,
      "formatted_start": "02:22:32.000",
      "formatted_end": "02:22:52.000",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 8582.0,
      "end": 8609.0,
      "formatted_start": "02:23:02.000",
      "formatted_end": "02:23:29.000",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 8609.0,
      "end": 8611.0,
      "formatted_start": "02:23:29.000",
      "formatted_end": "02:23:31.000",
      "text": "بفرماییم سلام بابا جان"
    },
    {
      "id": 27,
      "start": 8611.0,
      "end": 8613.0,
      "formatted_start": "02:23:31.000",
      "formatted_end": "02:23:33.000",
      "text": "سلامت باشید"
    },
    {
      "id": 28,
      "start": 8613.0,
      "end": 8615.0,
      "formatted_start": "02:23:33.000",
      "formatted_end": "02:23:35.000",
      "text": "بفرماییم شروع گونه شما"
    },
    {
      "id": 29,
      "start": 8615.0,
      "end": 8617.0,
      "formatted_start": "02:23:35.000",
      "formatted_end": "02:23:37.000",
      "text": "برگره بزنید"
    },
    {
      "id": 30,
      "start": 8617.0,
      "end": 8619.0,
      "formatted_start": "02:23:37.000",
      "formatted_end": "02:23:39.000",
      "text": "کاغذتو من چیم داد؟"
    },
    {
      "id": 31,
      "start": 8619.0,
      "end": 8621.0,
      "formatted_start": "02:23:39.000",
      "formatted_end": "02:23:41.000",
      "text": "خامسمین کاغذ ندادید؟"
    },
    {
      "id": 32,
      "start": 8621.0,
      "end": 8623.0,
      "formatted_start": "02:23:41.000",
      "formatted_end": "02:23:43.000",
      "text": "اینها رو کاغذشونو"
    },
    {
      "id": 33,
      "start": 8623.0,
      "end": 8625.0,
      "formatted_start": "02:23:43.000",
      "formatted_end": "02:23:45.000",
      "text": "خرید خامسمین"
    },
    {
      "id": 34,
      "start": 8625.0,
      "end": 8627.0,
      "formatted_start": "02:23:45.000",
      "formatted_end": "02:23:47.000",
      "text": "خب"
    },
    {
      "id": 35,
      "start": 8627.0,
      "end": 8629.0,
      "formatted_start": "02:23:47.000",
      "formatted_end": "02:23:49.000",
      "text": "چی شده بابا جان؟"
    },
    {
      "id": 36,
      "start": 8629.0,
      "end": 8631.0,
      "formatted_start": "02:23:49.000",
      "formatted_end": "02:23:51.000",
      "text": "سرما"
    },
    {
      "id": 37,
      "start": 8631.0,
      "end": 8633.0,
      "formatted_start": "02:23:51.000",
      "formatted_end": "02:23:53.000",
      "text": "سرما خورده"
    },
    {
      "id": 38,
      "start": 8633.0,
      "end": 8635.0,
      "formatted_start": "02:23:53.000",
      "formatted_end": "02:23:55.000",
      "text": "اینو داخل داره بخوره"
    },
    {
      "id": 39,
      "start": 8635.0,
      "end": 8637.0,
      "formatted_start": "02:23:55.000",
      "formatted_end": "02:23:57.000",
      "text": "ازم گرفتهش"
    },
    {
      "id": 40,
      "start": 8637.0,
      "end": 8639.0,
      "formatted_start": "02:23:57.000",
      "formatted_end": "02:23:59.000",
      "text": "چند روی خانم سرانی داره؟"
    },
    {
      "id": 41,
      "start": 8639.0,
      "end": 8641.0,
      "formatted_start": "02:23:59.000",
      "formatted_end": "02:24:01.000",
      "text": "آفیزش بینی داره"
    },
    {
      "id": 42,
      "start": 8641.0,
      "end": 8645.0,
      "formatted_start": "02:24:01.000",
      "formatted_end": "02:24:05.000",
      "text": "آفیزش، صرفه، تر، خسکس سینه؟"
    },
    {
      "id": 43,
      "start": 8645.0,
      "end": 8646.0,
      "formatted_start": "02:24:05.000",
      "formatted_end": "02:24:06.000",
      "text": "نه"
    },
    {
      "id": 44,
      "start": 8646.0,
      "end": 8648.0,
      "formatted_start": "02:24:06.000",
      "formatted_end": "02:24:08.000",
      "text": "صرفه ها خشکه خلطی؟"
    },
    {
      "id": 45,
      "start": 8648.0,
      "end": 8650.0,
      "formatted_start": "02:24:08.000",
      "formatted_end": "02:24:10.000",
      "text": "نه خشکه"
    },
    {
      "id": 46,
      "start": 8650.0,
      "end": 8652.0,
      "formatted_start": "02:24:10.000",
      "formatted_end": "02:24:12.000",
      "text": "خشکه هم یک تک تک"
    },
    {
      "id": 47,
      "start": 8652.0,
      "end": 8654.0,
      "formatted_start": "02:24:12.000",
      "formatted_end": "02:24:14.000",
      "text": "از دیرو دیره داشت"
    },
    {
      "id": 48,
      "start": 8654.0,
      "end": 8656.0,
      "formatted_start": "02:24:14.000",
      "formatted_end": "02:24:16.000",
      "text": "بله"
    },
    {
      "id": 49,
      "start": 8656.0,
      "end": 8659.0,
      "formatted_start": "02:24:16.000",
      "formatted_end": "02:24:19.000",
      "text": "اونو نمیدونه راحتت رای بز بکنه"
    },
    {
      "id": 50,
      "start": 8659.0,
      "end": 8663.0,
      "formatted_start": "02:24:19.000",
      "formatted_end": "02:24:23.000",
      "text": "بلزرچی میدونه اینکه بتر بشه"
    },
    {
      "id": 51,
      "start": 8667.0,
      "end": 8670.96,
      "formatted_start": "02:24:27.000",
      "formatted_end": "02:24:30.960",
      "text": "از همون گذرتش"
    },
    {
      "id": 52,
      "start": 8670.96,
      "end": 8686.06,
      "formatted_start": "02:24:30.960",
      "formatted_end": "02:24:46.060",
      "text": "یه صدای اضافهی تو قلب شنیده میشه"
    },
    {
      "id": 53,
      "start": 8686.06,
      "end": 8689.54,
      "formatted_start": "02:24:46.060",
      "formatted_end": "02:24:49.540",
      "text": "اینو بهتر بیمارستان تالغانی"
    },
    {
      "id": 54,
      "start": 8689.54,
      "end": 8690.58,
      "formatted_start": "02:24:49.540",
      "formatted_end": "02:24:50.580",
      "text": "کلینک تالغانی"
    },
    {
      "id": 55,
      "start": 8690.58,
      "end": 8692.02,
      "formatted_start": "02:24:50.580",
      "formatted_end": "02:24:52.020",
      "text": "آی دکتر بههودی"
    },
    {
      "id": 56,
      "start": 8692.02,
      "end": 8693.24,
      "formatted_start": "02:24:52.020",
      "formatted_end": "02:24:53.240",
      "text": "اونجا میاد"
    },
    {
      "id": 57,
      "start": 8693.24,
      "end": 8695.44,
      "formatted_start": "02:24:53.240",
      "formatted_end": "02:24:55.440",
      "text": "یه صدای قلب این بچه رو گوش کنه"
    },
    {
      "id": 58,
      "start": 8695.44,
      "end": 8697.44,
      "formatted_start": "02:24:55.440",
      "formatted_end": "02:24:57.440",
      "text": "چشم با ما هستیم؟"
    },
    {
      "id": 59,
      "start": 8697.44,
      "end": 8699.44,
      "formatted_start": "02:24:57.440",
      "formatted_end": "02:24:59.440",
      "text": "نمیدونم، اینجا ترمان با هستیم"
    }
  ],
