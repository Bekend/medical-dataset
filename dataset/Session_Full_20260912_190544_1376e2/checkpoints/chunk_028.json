  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8426.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:26.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 8426.0,
      "end": 8432.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:32.000",
      "text": "این شعبت انجیر برای که ما کردیم روزی دو بار اینها روزی سه بار همکنه داره بدین بدین"
    },
    {
      "id": 2,
      "start": 8432.0,
      "end": 8436.0,
      "formatted_start": "02:20:32.000",
      "formatted_end": "02:20:36.000",
      "text": "و از کنج آدوهای دیگر شد و تا روز تا روز روز رو بدن"
    },
    {
      "id": 3,
      "start": 8436.0,
      "end": 8438.0,
      "formatted_start": "02:20:36.000",
      "formatted_end": "02:20:38.000",
      "text": "متر ایندازه رو ختمی بده"
    },
    {
      "id": 4,
      "start": 8438.0,
      "end": 8439.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:39.000",
      "text": "آره"
    },
    {
      "id": 5,
      "start": 8439.0,
      "end": 8443.0,
      "formatted_start": "02:20:39.000",
      "formatted_end": "02:20:43.000",
      "text": "اگر دردار بی خداری داره دیسکرامینو بدین"
    },
    {
      "id": 6,
      "start": 8443.0,
      "end": 8447.0,
      "formatted_start": "02:20:43.000",
      "formatted_end": "02:20:47.000",
      "text": "بعد اصلا میفرد بدم"
    },
    {
      "id": 7,
      "start": 8447.0,
      "end": 8448.0,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:48.000",
      "text": "چون اینه رو بگیره"
    },
    {
      "id": 8,
      "start": 8448.0,
      "end": 8450.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:50.000",
      "text": "اینه سخته نوشته بشه"
    },
    {
      "id": 9,
      "start": 8450.0,
      "end": 8452.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:52.000",
      "text": "نه روزی یه بار نوشته نه"
    },
    {
      "id": 10,
      "start": 8452.0,
      "end": 8453.0,
      "formatted_start": "02:20:52.000",
      "formatted_end": "02:20:53.000",
      "text": "هر هیچ سه ها نوشته بشه"
    },
    {
      "id": 11,
      "start": 8453.0,
      "end": 8455.0,
      "formatted_start": "02:20:53.000",
      "formatted_end": "02:20:55.000",
      "text": "های سه هم شدید استفاده کنید"
    },
    {
      "id": 12,
      "start": 8455.0,
      "end": 8457.0,
      "formatted_start": "02:20:55.000",
      "formatted_end": "02:20:57.000",
      "text": "این هم نوشته با آقای هستند"
    },
    {
      "id": 13,
      "start": 8457.0,
      "end": 8459.0,
      "formatted_start": "02:20:57.000",
      "formatted_end": "02:20:59.000",
      "text": "همه نوشته باره"
    },
    {
      "id": 14,
      "start": 8459.0,
      "end": 8461.0,
      "formatted_start": "02:20:59.000",
      "formatted_end": "02:21:01.000",
      "text": "این چهار دردگیر و آقا دردگیر باره"
    },
    {
      "id": 15,
      "start": 8461.0,
      "end": 8463.0,
      "formatted_start": "02:21:01.000",
      "formatted_end": "02:21:03.000",
      "text": "باش دست رو دردگیر"
    },
    {
      "id": 16,
      "start": 8463.0,
      "end": 8465.0,
      "formatted_start": "02:21:03.000",
      "formatted_end": "02:21:05.000",
      "text": "باش دست رو دردگیر"
    },
    {
      "id": 17,
      "start": 8483.0,
      "end": 8503.0,
      "formatted_start": "02:21:23.000",
      "formatted_end": "02:21:43.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 8503.0,
      "end": 8506.0,
      "formatted_start": "02:21:43.000",
      "formatted_end": "02:21:46.000",
      "text": "بیشتر بیدن خوب بیشتر"
    },
    {
      "id": 19,
      "start": 8506.0,
      "end": 8512.0,
      "formatted_start": "02:21:46.000",
      "formatted_end": "02:21:52.000",
