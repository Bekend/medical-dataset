  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10504.5,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:04.500",
      "text": "دگزار نزنیم، جذب و کلسیو رو روح ما مختلف میپنسیم."
    },
    {
      "id": 1,
      "start": 10504.5,
      "end": 10507.0,
      "formatted_start": "02:55:04.500",
      "formatted_end": "02:55:07.000",
      "text": "هموز از سر مربوط نداریم توی استیمان."
    },
    {
      "id": 2,
      "start": 10507.0,
      "end": 10511.5,
      "formatted_start": "02:55:07.000",
      "formatted_end": "02:55:11.500",
      "text": "سرده باید شده و بیدون، واکسناشو باید قوی کشید."
    },
    {
      "id": 3,
      "start": 10511.5,
      "end": 10517.5,
      "formatted_start": "02:55:11.500",
      "formatted_end": "02:55:17.500",
      "text": "هفتگوی شیستد، همون در مقایی، دشیر مشتید."
    },
    {
      "id": 4,
      "start": 10517.5,
      "end": 10520.0,
      "formatted_start": "02:55:17.500",
      "formatted_end": "02:55:20.000",
      "text": "بازش خوبه، دیگرم خواهد باشیم."
    },
    {
      "id": 5,
      "start": 10520.0,
      "end": 10550.0,
      "formatted_start": "02:55:20.000",
      "formatted_end": "02:55:50.000",
      "text": "خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خدا خ"
    },
    {
      "id": 6,
      "start": 10550.0,
      "end": 10580.0,
      "formatted_start": "02:55:50.000",
      "formatted_end": "02:56:20.000",
      "text": "مدتی با اینکه این کار را با اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه ا"
    },
    {
      "id": 7,
      "start": 10580.0,
      "end": 10600.0,
      "formatted_start": "02:56:20.000",
      "formatted_end": "02:56:40.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 10610.0,
      "end": 10620.0,
      "formatted_start": "02:56:50.000",
      "formatted_end": "02:57:00.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 10640.0,
      "end": 10664.0,
      "formatted_start": "02:57:20.000",
      "formatted_end": "02:57:44.000",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 10664.0,
      "end": 10667.5,
      "formatted_start": "02:57:44.000",
      "formatted_end": "02:57:47.500",
      "text": "در این نماوره ای، خریدشون همه وقت مکنه"
    },
    {
      "id": 11,
      "start": 10667.5,
      "end": 10669.5,
      "formatted_start": "02:57:47.500",
      "formatted_end": "02:57:49.500",
      "text": "شواردچان، بویافیری"
    },
    {
      "id": 12,
      "start": 10669.5,
      "end": 10672.0,
      "formatted_start": "02:57:49.500",
      "formatted_end": "02:57:52.000",
      "text": "که نموز همه جا هر دوی بویاست که ناک زده"
    },
    {
      "id": 13,
      "start": 10672.0,
      "end": 10674.0,
      "formatted_start": "02:57:52.000",
      "formatted_end": "02:57:54.000",
      "text": "همه شون موتور دادن، ماشینی که"
    },
    {
      "id": 14,
      "start": 10674.0,
      "end": 10676.0,
      "formatted_start": "02:57:54.000",
      "formatted_end": "02:57:56.000",
      "text": "کراپچن بود، امکانات خیلی زیاد داد"
    },
    {
      "id": 15,
      "start": 10676.0,
      "end": 10680.0,
      "formatted_start": "02:57:56.000",
      "formatted_end": "02:58:00.000",
      "text": "ولی با گرزشت زمان، نتونستن با همه کودشون بسیار دارن"
    },
    {
      "id": 16,
      "start": 10680.0,
      "end": 10683.0,
      "formatted_start": "02:58:00.000",
      "formatted_end": "02:58:03.000",
      "text": "صدا میدهید ناکی بخشنده که آفدید شده"
    },
    {
      "id": 17,
      "start": 10683.0,
      "end": 10685.0,
      "formatted_start": "02:58:03.000",
      "formatted_end": "02:58:05.000",
      "text": "دورده بیرونه"
    },
    {
      "id": 18,
      "start": 10685.0,
      "end": 10691.0,
      "formatted_start": "02:58:05.000",
      "formatted_end": "02:58:11.000",
      "text": "این نویسنده ها رو هر جا دیدی کتاباشون هم"
    },
    {
      "id": 19,
      "start": 10691.0,
      "end": 10719.0,
      "formatted_start": "02:58:11.000",
      "formatted_end": "02:58:39.000",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 10721.0,
      "end": 10729.0,
      "formatted_start": "02:58:41.000",
      "formatted_end": "02:58:49.000",
      "text": "اگر در وقتی که تا اتفاق میکنید، دور بگیرید، همین اران شروع بکنید، همین صورت بکنید، بشونند و شرافت منداشید"
    },
    {
      "id": 21,
      "start": 10751.0,
      "end": 10757.0,
      "formatted_start": "02:59:11.000",
      "formatted_end": "02:59:17.000",
      "text": "سرطان زمانکوبترین و خودموشترین سرنایی منطقه آزاز مکنون شده"
    },
    {
      "id": 22,
      "start": 10757.0,
      "end": 10760.0,
      "formatted_start": "02:59:17.000",
      "formatted_end": "02:59:20.000",
      "text": "سرطان سیست ویست ویست و پنج یکمانیتری پر برشارج"
    },
    {
      "id": 23,
      "start": 10760.0,
      "end": 10762.0,
      "formatted_start": "02:59:20.000",
      "formatted_end": "02:59:22.000",
      "text": "چیز تمرین یکی شاپان"
    },
    {
      "id": 24,
      "start": 10762.0,
      "end": 10764.0,
      "formatted_start": "02:59:22.000",
      "formatted_end": "02:59:24.000",
      "text": "سیست ویست و شیش و کیلترین پایزه"
    },
    {
      "id": 25,
      "start": 10764.0,
      "end": 10766.0,
      "formatted_start": "02:59:24.000",
      "formatted_end": "02:59:26.000",
      "text": "سیست و شیش یکمانیتری اینکه میده"
    },
    {
      "id": 26,
      "start": 10766.0,
      "end": 10767.0,
      "formatted_start": "02:59:26.000",
      "formatted_end": "02:59:27.000",
      "text": "کورن"
    },
    {
      "id": 27,
      "start": 10767.0,
      "end": 10770.0,
      "formatted_start": "02:59:27.000",
      "formatted_end": "02:59:30.000",
      "text": "برای دریافت قیمت تا پیه"
    },
    {
      "id": 28,
      "start": 10770.0,
      "end": 10792.0,
      "formatted_start": "02:59:30.000",
      "formatted_end": "02:59:52.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}