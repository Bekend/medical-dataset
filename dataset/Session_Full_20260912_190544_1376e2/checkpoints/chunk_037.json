  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11102.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:02.000",
      "text": "مردیده باید بردارید؟"
    },
    {
      "id": 1,
      "start": 11102.0,
      "end": 11104.0,
      "formatted_start": "03:05:02.000",
      "formatted_end": "03:05:04.000",
      "text": "آره."
    },
    {
      "id": 2,
      "start": 11104.0,
      "end": 11106.0,
      "formatted_start": "03:05:04.000",
      "formatted_end": "03:05:06.000",
      "text": "چی بردارید؟"
    },
    {
      "id": 3,
      "start": 11106.0,
      "end": 11108.0,
      "formatted_start": "03:05:06.000",
      "formatted_end": "03:05:08.000",
      "text": "مرد در اینجا که بود."
    },
    {
      "id": 4,
      "start": 11108.0,
      "end": 11110.0,
      "formatted_start": "03:05:08.000",
      "formatted_end": "03:05:10.000",
      "text": "این هایی که بود که با شما بردارد."
    },
    {
      "id": 5,
      "start": 11110.0,
      "end": 11140.0,
      "formatted_start": "03:05:10.000",
      "formatted_end": "03:05:40.000",
      "text": "اگر باید برداریم، توی اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینج"
    },
    {
      "id": 6,
      "start": 11140.0,
      "end": 11142.0,
      "formatted_start": "03:05:40.000",
      "formatted_end": "03:05:42.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 11170.0,
      "end": 11199.0,
      "formatted_start": "03:06:10.000",
      "formatted_end": "03:06:39.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 11200.0,
      "end": 11208.0,
      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:48.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 11230.0,
      "end": 11236.0,
      "formatted_start": "03:07:10.000",
      "formatted_end": "03:07:16.000",
      "text": "مهمترین آمل در این دوره مدیریت آبیاری درخت انداره"
    },
    {
      "id": 10,
      "start": 11236.0,
      "end": 11241.0,
      "formatted_start": "03:07:16.000",
      "formatted_end": "03:07:21.000",
      "text": "که نامونظم بودن آبیاری باعث درک کردن نیوه انال میشه"
    },
    {
      "id": 11,
      "start": 11241.0,
      "end": 11247.0,
      "formatted_start": "03:07:21.000",
      "formatted_end": "03:07:27.000",
      "text": "در این دوره از بوره، آمونیوم، سلطان، تنویم پروژن بالا استفاده نکارید"
    },
    {
      "id": 12,
      "start": 11247.0,
      "end": 11251.0,
      "formatted_start": "03:07:27.000",
      "formatted_end": "03:07:31.000",
      "text": "به جاش از بورهایی استفاده بکنید که مصنف دفتاس رو بالا میبرد"
    },
    {
      "id": 13,
      "start": 11251.0,
      "end": 11256.0,
      "formatted_start": "03:07:31.000",
      "formatted_end": "03:07:36.000",
      "text": "و برای جلو گیری از پردکردکی نیوه از کنسیو استفاده بود"
    },
    {
      "id": 14,
      "start": 11256.0,
      "end": 11261.4,
      "formatted_start": "03:07:36.000",
      "formatted_end": "03:07:41.400",
      "text": "حالا اگر میخوایید بدونی کدوم کتبه های درخ در نام معسیره عدد اینو اون برام کنید"
    },
    {
      "id": 15,
      "start": 11261.4,
      "end": 11263.12,
      "formatted_start": "03:07:41.400",
      "formatted_end": "03:07:43.120",
      "text": "این دوشبه بستن صندوقه"
    },
    {
      "id": 16,
      "start": 11263.12,
      "end": 11264.7,
      "formatted_start": "03:07:43.120",
      "formatted_end": "03:07:44.700",
      "text": "پس این یکی چیه؟"
    },
    {
      "id": 17,
      "start": 11264.7,
      "end": 11268.34,
      "formatted_start": "03:07:44.700",
      "formatted_end": "03:07:48.340",
      "text": "این دوشبه از اینجای وسیله یا بگیتون از داخل صندوق بردارین"
    },
    {
      "id": 18,
      "start": 11268.34,
      "end": 11270.22,
      "formatted_start": "03:07:48.340",
      "formatted_end": "03:07:50.220",
      "text": "این دوشبه از من پشار بگید"
    },
    {
      "id": 19,
      "start": 11270.22,
      "end": 11274.82,
      "formatted_start": "03:07:50.220",
      "formatted_end": "03:07:54.820",
      "text": "تا با دور شدن از در خود رو رو صندوق به صورت خود کار بسته بودید"
    },
    {
      "id": 20,
      "start": 11274.82,
      "end": 11279.16,
      "formatted_start": "03:07:54.820",
      "formatted_end": "03:07:59.160",
      "text": "باید حال که من این رو زندگی نیم کنم"
    },
    {
      "id": 21,
      "start": 11279.16,
      "end": 11281.6,
      "formatted_start": "03:07:59.160",
      "formatted_end": "03:08:01.600",
      "text": "بلی کاملا واقع فرق چه اتفاقاتی داره"
    },
    {
      "id": 22,
      "start": 11281.6,
      "end": 11282.6,
      "formatted_start": "03:08:01.600",
      "formatted_end": "03:08:02.600",
      "text": "یعنی فاجعه"
    },
    {
      "id": 23,
      "start": 11282.6,
      "end": 11284.98,
      "formatted_start": "03:08:02.600",
      "formatted_end": "03:08:04.980",
      "text": "واقع دوست منم دیگه از رسیوران ما بیرون میرم"
    },
    {
      "id": 24,
      "start": 11284.98,
      "end": 11287.5,
      "formatted_start": "03:08:04.980",
      "formatted_end": "03:08:07.500",
      "text": "رزقه غذامون رو دنبالم میدونم که بگیرم"
    },
    {
      "id": 25,
      "start": 11287.5,
      "end": 11288.54,
      "formatted_start": "03:08:07.500",
      "formatted_end": "03:08:08.540",
      "text": "واقعا این دونه نیست"
    },
    {
      "id": 26,
      "start": 11288.54,
      "end": 11290.84,
      "formatted_start": "03:08:08.540",
      "formatted_end": "03:08:10.840",
      "text": "دوست شما بود که من"
    },
    {
      "id": 27,
      "start": 11290.84,
      "end": 11293.54,
      "formatted_start": "03:08:10.840",
      "formatted_end": "03:08:13.540",
      "text": "تنبال غذامون رو از رسیوران میدن"
    },
    {
      "id": 28,
      "start": 11293.54,
      "end": 11295.16,
      "formatted_start": "03:08:13.540",
      "formatted_end": "03:08:15.160",
      "text": "میرم بیرون دنبالم میدونم"
    },
    {
      "id": 29,
      "start": 11295.16,
      "end": 11296.74,
      "formatted_start": "03:08:15.160",
      "formatted_end": "03:08:16.740",
      "text": "من ندیدم"
    },
    {
      "id": 30,
      "start": 11296.74,
      "end": 11299.34,
      "formatted_start": "03:08:16.740",
      "formatted_end": "03:08:19.340",
      "text": "من این همچیزی رو ندیدم"
    },
    {
      "id": 31,
      "start": 11299.34,
      "end": 11301.08,
      "formatted_start": "03:08:19.340",
      "formatted_end": "03:08:21.080",
      "text": "تنبالم رو دیدم"
    },
    {
      "id": 32,
      "start": 11301.08,
      "end": 11302.14,
      "formatted_start": "03:08:21.080",
      "formatted_end": "03:08:22.140",
      "text": "دنبالم بود"
    },
    {
      "id": 33,
      "start": 11302.14,
      "end": 11304.14,
      "formatted_start": "03:08:22.140",
      "formatted_end": "03:08:24.140",
      "text": "این بیشتر باید بردارید."
    },
    {
      "id": 34,
      "start": 11304.14,
      "end": 11306.14,
      "formatted_start": "03:08:24.140",
      "formatted_end": "03:08:26.140",
      "text": "این بیشتر باید بردارید."
    },
    {
      "id": 35,
      "start": 11306.14,
      "end": 11308.14,
      "formatted_start": "03:08:26.140",
      "formatted_end": "03:08:28.140",
