    },
    {
      "id": 45,
      "start": 11354.14,
      "end": 11360.14,
      "formatted_start": "03:09:14.140",
      "formatted_end": "03:09:20.140",
      "text": "موسیقی"
    },
    {
      "id": 46,
      "start": 11384.14,
      "end": 11386.14,
      "formatted_start": "03:09:44.140",
      "formatted_end": "03:09:46.140",
      "text": "مفروشم دیگه نبودم"
    },
    {
      "id": 47,
      "start": 11386.14,
      "end": 11388.14,
      "formatted_start": "03:09:46.140",
      "formatted_end": "03:09:48.140",
      "text": "چونگی"
    },
    {
      "id": 48,
      "start": 11388.14,
      "end": 11392.14,
      "formatted_start": "03:09:48.140",
      "formatted_end": "03:09:52.140",
      "text": "قول میگی اگه همین انت زهنتو کنیدم"
    },
    {
      "id": 49,
      "start": 11392.14,
      "end": 11394.14,
      "formatted_start": "03:09:52.140",
      "formatted_end": "03:09:54.140",
      "text": "همه حالت کنیدم"
    },
    {
      "id": 50,
      "start": 11394.14,
      "end": 11397.14,
