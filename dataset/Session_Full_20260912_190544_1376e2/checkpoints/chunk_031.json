  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9330.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:30.000",
      "text": "اگر بردن خواهد دارید، با اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از ا"
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9337.62,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:37.620",
      "text": "بنابراین اگر احسان رو آمی تشکیل کنم، برای احسان رو نه بسیار کنم شده است"
    },
    {
      "id": 2,
      "start": 9360.0,
      "end": 9363.0,
      "formatted_start": "02:36:00.000",
      "formatted_end": "02:36:03.000",
      "text": "ریمون را به ترکاپوله برده"
    },
    {
      "id": 3,
      "start": 9365.0,
      "end": 9367.0,
      "formatted_start": "02:36:05.000",
      "formatted_end": "02:36:07.000",
      "text": "سخت و بدر روزی پایی"
    },
    {
      "id": 4,
      "start": 9367.0,
      "end": 9369.0,
      "formatted_start": "02:36:07.000",
      "formatted_end": "02:36:09.000",
      "text": "اما اینجا باید برده باشیم که"
    },
    {
      "id": 5,
      "start": 9369.0,
      "end": 9371.0,
      "formatted_start": "02:36:09.000",
      "formatted_end": "02:36:11.000",
      "text": "ما یه جمعیت ها مورد داریم ترکاپوله"
    },
    {
      "id": 6,
      "start": 9371.0,
      "end": 9373.0,
      "formatted_start": "02:36:11.000",
      "formatted_end": "02:36:13.000",
      "text": "نشانستن توی این قسمت"
    },
    {
      "id": 7,
      "start": 9373.0,
      "end": 9375.0,
      "formatted_start": "02:36:13.000",
      "formatted_end": "02:36:15.000",
      "text": "بگم بیا"
    },
    {
      "id": 8,
      "start": 9377.0,
      "end": 9379.0,
      "formatted_start": "02:36:17.000",
      "formatted_end": "02:36:19.000",
      "text": "توی این قسمت یک کلی چامل بگیم"
    },
    {
      "id": 9,
      "start": 9379.0,
      "end": 9381.0,
      "formatted_start": "02:36:19.000",
      "formatted_end": "02:36:21.000",
      "text": "درسته؟"
    },
    {
      "id": 10,
      "start": 9382.0,
      "end": 9384.0,
      "formatted_start": "02:36:22.000",
      "formatted_end": "02:36:24.000",
      "text": "چون ریمونتا چونه بیرون اینجا"
    },
    {
      "id": 11,
      "start": 9384.0,
      "end": 9386.0,
      "formatted_start": "02:36:24.000",
      "formatted_end": "02:36:26.000",
      "text": "کلیمت تنشارون باشه"
    },
    {
      "id": 12,
      "start": 9386.0,
      "end": 9388.0,
      "formatted_start": "02:36:26.000",
      "formatted_end": "02:36:28.000",
      "text": "مشکلی که ما به یک از"
    },
    {
      "id": 13,
      "start": 9388.0,
      "end": 9393.68,
      "formatted_start": "02:36:28.000",
      "formatted_end": "02:36:33.680",
      "text": "اوویزان سوال داشت این بود که چرا وقتی نزدیک تو ماشین میشه درم خودشون باز نمیشن"
    },
    {
      "id": 14,
      "start": 9393.68,
      "end": 9397.88,
      "formatted_start": "02:36:33.680",
      "formatted_end": "02:36:37.880",
      "text": "رسائل دو تنظیمات تعمل داشته نفی پوستای مردی ارمان کنید"
    },
    {
      "id": 15,
      "start": 9397.88,
      "end": 9400.04,
      "formatted_start": "02:36:37.880",
      "formatted_end": "02:36:40.040",
      "text": "به خاطر اینکه ریموت شارژ دادش"
    },
    {
      "id": 16,
      "start": 9400.04,
      "end": 9404.22,
      "formatted_start": "02:36:40.040",
      "formatted_end": "02:36:44.220",
      "text": "من مفترم همه بره بار یک ریموت یک ریموت یک درکش تست بکنه"
    },
    {
      "id": 17,
      "start": 9404.22,
      "end": 9408.34,
      "formatted_start": "02:36:44.220",
      "formatted_end": "02:36:48.340",
      "text": "و اینکه بعد متوجه شده که یعنی بهش کفتم این شارژ داده"
    },
    {
      "id": 18,
      "start": 9408.34,
      "end": 9409.84,
      "formatted_start": "02:36:48.340",
      "formatted_end": "02:36:49.840",
      "text": "با اون یکی تست کنه چی رو شباید"
    },
    {
      "id": 19,
      "start": 9409.84,
      "end": 9413.5,
      "formatted_start": "02:36:49.840",
      "formatted_end": "02:36:53.500",
      "text": "برکم، شما باید ریمونت چونو بزنید اونجا"
    },
    {
      "id": 20,
      "start": 9413.5,
      "end": 9415.46,
      "formatted_start": "02:36:53.500",
      "formatted_end": "02:36:55.460",
      "text": "که با سیه ریمونت شارد"
    },
    {
      "id": 21,
      "start": 9415.46,
      "end": 9417.0,
      "formatted_start": "02:36:55.460",
      "formatted_end": "02:36:57.000",
      "text": "تمام"
    },
    {
      "id": 22,
      "start": 9417.0,
      "end": 9425.14,
      "formatted_start": "02:36:57.000",
      "formatted_end": "02:37:05.140",
      "text": "ای"
    },
    {
      "id": 23,
      "start": 9425.14,
      "end": 9429.72,
      "formatted_start": "02:37:05.140",
      "formatted_end": "02:37:09.720",
      "text": "این چیه؟"
    },
    {
      "id": 24,
      "start": 9429.72,
      "end": 9431.26,
      "formatted_start": "02:37:09.720",
      "formatted_end": "02:37:11.260",
      "text": "آب در سفر"
    },
    {
      "id": 25,
      "start": 9431.26,
      "end": 9435.08,
      "formatted_start": "02:37:11.260",
      "formatted_end": "02:37:15.080",
      "text": "درخواست داری که سرهای رسیدنو چک میخنن"
    },
    {
      "id": 26,
      "start": 9435.08,
      "end": 9436.72,
      "formatted_start": "02:37:15.080",
      "formatted_end": "02:37:16.720",
      "text": "بخشی نداره"
    },
    {
      "id": 27,
      "start": 9436.72,
      "end": 9439.04,
      "formatted_start": "02:37:16.720",
      "formatted_end": "02:37:19.040",
      "text": "من خواهم جاتیشو برکنم"
    },
    {
      "id": 28,
      "start": 9439.04,
      "end": 9441.7,
      "formatted_start": "02:37:19.040",
      "formatted_end": "02:37:21.700",
      "text": "یه سانا بگذارم؟ یه چی ها؟"
    },
    {
      "id": 29,
      "start": 9441.7,
      "end": 9446.92,
      "formatted_start": "02:37:21.700",
      "formatted_end": "02:37:26.920",
      "text": "ببینید سانا جی رو به سردارو بگو تن کی آمده کت شهردارو بیرون بیرون بزید"
    },
    {
      "id": 30,
      "start": 9446.92,
      "end": 9450.18,
      "formatted_start": "02:37:26.920",
      "formatted_end": "02:37:30.180",
      "text": "من خود شهردارو ببینم کنم توی جی خود شهردارو"
    },
    {
      "id": 31,
      "start": 9450.18,
      "end": 9452.04,
      "formatted_start": "02:37:30.180",
      "formatted_end": "02:37:32.040",
      "text": "ببینید بخشید نداریم"
    },
    {
      "id": 32,
      "start": 9452.04,
      "end": 9460.3,
      "formatted_start": "02:37:32.040",
      "formatted_end": "02:37:40.300",
      "text": "خب سآل کرده ببینید که کلیده، فیزیکی رو کانو کجاست؟"
    },
    {
      "id": 33,
      "start": 9460.3,
      "end": 9463.04,
      "formatted_start": "02:37:40.300",
      "formatted_end": "02:37:43.040",
      "text": "چون یه ریموت داریم؟ که پشت این ریموت؟"
    },
    {
      "id": 34,
      "start": 9463.82,
      "end": 9466.96,
      "formatted_start": "02:37:43.820",
      "formatted_end": "02:37:46.960",
      "text": "یه درده، این درده رو با ما چاقو باز کنید"
    },
    {
      "id": 35,
      "start": 9466.96,
      "end": 9468.96,
      "formatted_start": "02:37:46.960",
      "formatted_end": "02:37:48.960",
      "text": "نمیشه باید خوب بازش کرده استفاده بود"
    },
    {
      "id": 36,
      "start": 9468.96,
      "end": 9472.96,
      "formatted_start": "02:37:48.960",
      "formatted_end": "02:37:52.960",
      "text": "از دنبه خدمتون که بخز در پشتش رو باز میکنید"
    },
    {
      "id": 37,
      "start": 9472.96,
      "end": 9476.96,
      "formatted_start": "02:37:52.960",
      "formatted_end": "02:37:56.960",
      "text": "ریموت کیل فیزیکی شما اینجاست"
    },
    {
      "id": 38,
      "start": 9476.96,
      "end": 9479.96,
      "formatted_start": "02:37:56.960",
      "formatted_end": "02:37:59.960",
      "text": "پشت ریموتتون یا اون که جایی بازششه"
    },
    {
      "id": 39,
      "start": 9479.96,
      "end": 9481.96,
      "formatted_start": "02:37:59.960",
      "formatted_end": "02:38:01.960",
      "text": "باید تمام"
    },
    {
      "id": 40,
      "start": 9481.96,
      "end": 9485.96,
      "formatted_start": "02:38:01.960",
      "formatted_end": "02:38:05.960",
      "text": "خب سؤال کرده بودید که"
    },
    {
      "id": 41,
      "start": 9485.96,
      "end": 9489.96,
      "formatted_start": "02:38:05.960",
      "formatted_end": "02:38:09.960",
      "text": "کیلید فیزیکی رو کارمان کجاست؟"
    },
    {
      "id": 42,
      "start": 9489.96,
      "end": 9494.96,
      "formatted_start": "02:38:09.960",
      "formatted_end": "02:38:14.960",
      "text": "شما یه ریموت دارید که پشت این ریموت یه درد داره"
    },
    {
      "id": 43,
      "start": 9494.96,
      "end": 9496.96,
      "formatted_start": "02:38:14.960",
      "formatted_end": "02:38:16.960",
      "text": "این دردار رو باید با چاقو باز کنید"
    },
    {
      "id": 44,
      "start": 9496.96,
      "end": 9498.96,
      "formatted_start": "02:38:16.960",
      "formatted_end": "02:38:18.960",
      "text": "نمیشه با نه خوب بازش کرده حسس بود"
    },
    {
      "id": 45,
      "start": 9498.96,
      "end": 9500.96,
      "formatted_start": "02:38:18.960",
      "formatted_end": "02:38:20.960",
      "text": "عرض همه خدمتون که"
    },
    {
      "id": 46,
      "start": 9500.96,
      "end": 9502.96,
      "formatted_start": "02:38:20.960",
      "formatted_end": "02:38:22.960",
      "text": "بعد درد پشتش رو باز میکنید"
    },
    {
      "id": 47,
      "start": 9502.96,
      "end": 9504.96,
      "formatted_start": "02:38:22.960",
      "formatted_end": "02:38:24.960",
      "text": "ریموت کلید فیزیکی شما"
    },
    {
      "id": 48,
      "start": 9504.96,
      "end": 9506.96,
      "formatted_start": "02:38:24.960",
      "formatted_end": "02:38:26.960",
      "text": "اینجاست"
    },
    {
      "id": 49,
      "start": 9506.96,
      "end": 9508.96,
      "formatted_start": "02:38:26.960",
      "formatted_end": "02:38:28.960",
      "text": "پشت ریموتتون یعنی"
    },
    {
      "id": 50,
      "start": 9508.96,
      "end": 9510.96,
      "formatted_start": "02:38:28.960",
      "formatted_end": "02:38:30.960",
      "text": "کجایی بازشه و تمام"
    },
    {
      "id": 51,
      "start": 9512.96,
      "end": 9514.96,
      "formatted_start": "02:38:32.960",
      "formatted_end": "02:38:34.960",
      "text": "خب سؤال کرده بودیم که"
    },
    {
      "id": 52,
      "start": 9514.96,
      "end": 9516.96,
      "formatted_start": "02:38:34.960",
      "formatted_end": "02:38:36.960",
      "text": "کلید فیزیکی"
    },
    {
      "id": 53,
      "start": 9516.96,
      "end": 9518.96,
      "formatted_start": "02:38:36.960",
      "formatted_end": "02:38:38.960",
      "text": "لوکانو"
    },
    {
      "id": 54,
      "start": 9518.96,
      "end": 9520.96,
      "formatted_start": "02:38:38.960",
      "formatted_end": "02:38:40.960",
      "text": "کجاست؟ شما یه ریموت داریم"
    },
    {
      "id": 55,
      "start": 9520.96,
      "end": 9522.96,
      "formatted_start": "02:38:40.960",
      "formatted_end": "02:38:42.960",
      "text": "که پشت این ریموت"
    },
    {
      "id": 56,
      "start": 9522.96,
      "end": 9550.96,
      "formatted_start": "02:38:42.960",
      "formatted_end": "02:39:10.960",
      "text": "موسیقی"
    },
    {
      "id": 57,
      "start": 9552.96,
      "end": 9564.96,
      "formatted_start": "02:39:12.960",
      "formatted_end": "02:39:24.960",
      "text": "موسیقی"
    },
    {
      "id": 58,
      "start": 9582.96,
      "end": 9599.96,
      "formatted_start": "02:39:42.960",
      "formatted_end": "02:39:59.960",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}