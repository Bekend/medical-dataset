      "formatted_start": "01:57:25.000",
      "formatted_end": "01:57:27.000",
      "text": "بخونید"
    },
    {
      "id": 6,
      "start": 7049.0,
      "end": 7052.0,
      "formatted_start": "01:57:29.000",
      "formatted_end": "01:57:32.000",
      "text": "این شربت هاش روزی 3 بار"
    },
    {
      "id": 7,
      "start": 7052.0,
      "end": 7054.0,
      "formatted_start": "01:57:32.000",
      "formatted_end": "01:57:34.000",
      "text": "قطعه هم هر 8 ساعت 16 قطعه"
    },
    {
      "id": 8,
      "start": 7054.0,
      "end": 7056.0,
      "formatted_start": "01:57:34.000",
      "formatted_end": "01:57:36.000",
      "text": "سلام برویم"
    },
    {
      "id": 9,
      "start": 7056.0,
      "end": 7058.0,
      "formatted_start": "01:57:36.000",
      "formatted_end": "01:57:38.000",
      "text": "قطعه هاش هر 8 ساعت 16 قطعه"
    },
    {
      "id": 10,
      "start": 7058.0,
      "end": 7060.0,
      "formatted_start": "01:57:38.000",
      "formatted_end": "01:57:40.000",
      "text": "بخونید"
    },
    {
      "id": 11,
      "start": 7060.0,
      "end": 7062.0,
      "formatted_start": "01:57:40.000",
      "formatted_end": "01:57:42.000",
      "text": "با جلو تخت بزارید"
    },
    {
      "id": 12,
      "start": 7062.0,
      "end": 7064.0,
      "formatted_start": "01:57:42.000",
      "formatted_end": "01:57:44.000",
      "text": "برکتون و معیقتونید"
    },
    {
      "id": 13,
      "start": 7064.0,
      "end": 7066.0,
      "formatted_start": "01:57:44.000",
      "formatted_end": "01:57:46.000",
      "text": "سلام برویم"
    },
    {
      "id": 14,
      "start": 7066.0,
      "end": 7068.0,
      "formatted_start": "01:57:46.000",
      "formatted_end": "01:57:48.000",
      "text": "چند روزی شد؟"
    },
    {
      "id": 15,
      "start": 7068.0,
      "end": 7069.0,
      "formatted_start": "01:57:48.000",
      "formatted_end": "01:57:49.000",
      "text": "دو روز"
    },
    {
      "id": 16,
      "start": 7069.0,
      "end": 7070.0,
      "formatted_start": "01:57:49.000",
      "formatted_end": "01:57:50.000",
      "text": "یه روز"
    },
    {
      "id": 17,
      "start": 7070.0,
      "end": 7072.0,
      "formatted_start": "01:57:50.000",
      "formatted_end": "01:57:52.000",
      "text": "دوازده هم ساعت صبح خونه"
    },
    {
      "id": 18,
      "start": 7072.0,
      "end": 7102.0,
      "formatted_start": "01:57:52.000",
      "formatted_end": "01:58:22.000",
      "text": "اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینج"
    },
    {
      "id": 19,
      "start": 7102.0,
      "end": 7105.0,
      "formatted_start": "01:58:22.000",
      "formatted_end": "01:58:25.000",
      "text": "اولین روز بعد از تعدیلی که اینو داشته برموند"
    },
    {
      "id": 20,
      "start": 7105.0,
      "end": 7107.0,
      "formatted_start": "01:58:25.000",
      "formatted_end": "01:58:27.000",
      "text": "این روز را سسس مناجر برموند"
    },
    {
      "id": 21,
      "start": 7107.0,
      "end": 7109.0,
      "formatted_start": "01:58:27.000",
      "formatted_end": "01:58:29.000",
      "text": "۵۸ دقیقه"
    },
    {
      "id": 22,
      "start": 7109.0,
      "end": 7111.0,
      "formatted_start": "01:58:29.000",
      "formatted_end": "01:58:31.000",
      "text": "بروخونی مادر نوزاد"
    },
    {
      "id": 23,
      "start": 7111.0,
      "end": 7114.0,
      "formatted_start": "01:58:31.000",
      "formatted_end": "01:58:34.000",
      "text": "مادر آی منفی نوزاد آی منفی"
    },
    {
      "id": 24,
      "start": 7114.0,
      "end": 7117.0,
      "formatted_start": "01:58:34.000",
      "formatted_end": "01:58:37.000",
      "text": "نه پدر چیه؟ آی مصفر"
    },
    {
      "id": 25,
      "start": 7117.0,
      "end": 7121.0,
      "formatted_start": "01:58:37.000",
      "formatted_end": "01:58:41.000",
      "text": "مادر آی منفی پدر آی مصفر بچه آی منفی"
    },
    {
      "id": 26,
      "start": 7121.0,
      "end": 7126.0,
      "formatted_start": "01:58:41.000",
      "formatted_end": "01:58:46.000",
      "text": "آی منفی اینا انظر ایرهاش چون بچه منفیه"
    },
    {
      "id": 27,
      "start": 7126.0,
      "end": 7128.0,
      "formatted_start": "01:58:46.000",
      "formatted_end": "01:58:48.000",
      "text": "مادر هم منفیه خوبه"
    },
    {
      "id": 28,
      "start": 7128.0,
      "end": 7129.0,
      "formatted_start": "01:58:48.000",
      "formatted_end": "01:58:49.000",
      "text": "بله؟"
    },
    {
      "id": 29,
      "start": 7129.0,
      "end": 7136.0,
      "formatted_start": "01:58:49.000",
      "formatted_end": "01:58:56.000",
      "text": "این ها با هم ناسازی بارند این هم آیه باز ناسازی بارند"
    },
    {
      "id": 30,
      "start": 7136.0,
      "end": 7142.0,
      "formatted_start": "01:58:56.000",
      "formatted_end": "01:59:02.000",
      "text": "این ها منفی مصبت ها جور در میاد دوتا منفی هستند ولی او با آ جور در میاد"
    },
    {
      "id": 31,
      "start": 7142.0,
      "end": 7149.0,
      "formatted_start": "01:59:02.000",
      "formatted_end": "01:59:09.000",
      "text": "در نتیجه این ها دوشتر زردیر بالا پیشتونده میشنند و حتما باید زیر دستگاه یا بستدی بشند"
    },
    {
      "id": 32,
      "start": 7149.0,
      "end": 7154.0,
      "formatted_start": "01:59:09.000",
      "formatted_end": "01:59:14.000",
      "text": "الان با پنجو خوردی هم باید بستدی میشد کردن ولی دکتر یک تخبیف داده"
    },
    {
      "id": 33,
      "start": 7154.0,
      "end": 7160.0,
      "formatted_start": "01:59:14.000",
      "formatted_end": "01:59:20.000",
      "text": "این ترتیلی بود که اعتمالاً همون بود. دیگه چیز نبوده رفت کرده ندید."
    },
    {
      "id": 34,
      "start": 7160.0,
      "end": 7168.0,
      "formatted_start": "01:59:20.000",
      "formatted_end": "01:59:28.000",
      "text": "خب دوست داره دیگه هم که ما تفاوت نیست کردیم اشبارت کردیم. اون هم اون اعتماد نزدیک باید بستری بشه یا یک دستگاه باشه."
    },
    {
      "id": 35,
      "start": 7168.0,
      "end": 7171.0,
      "formatted_start": "01:59:28.000",
      "formatted_end": "01:59:31.000",
      "text": "اما بینوز هم ترتیلی بودن اونجا."
    },
    {
      "id": 36,
      "start": 7171.0,
      "end": 7178.0,
      "formatted_start": "01:59:31.000",
      "formatted_end": "01:59:38.000",
      "text": "ببینید از بینوز مثلاً سه بم چهارم که شروع میشه کم کم زیاد میشن."
    },
    {
      "id": 37,
      "start": 7178.0,
      "end": 7181.0,
      "formatted_start": "01:59:38.000",
      "formatted_end": "01:59:41.000",
      "text": "یعنی رفته رفته پیشتر میشه"
    },
    {
      "id": 38,
      "start": 7181.0,
      "end": 7185.0,
      "formatted_start": "01:59:41.000",
      "formatted_end": "01:59:45.000",
      "text": "مخصوان دو هفته اول خیلی بالا رونده"
    },
    {
      "id": 39,
      "start": 7185.0,
      "end": 7187.0,
      "formatted_start": "01:59:45.000",
      "formatted_end": "01:59:47.000",
      "text": "بعد از دو هفته میاد پایین"
    },
    {
      "id": 40,
      "start": 7187.0,
      "end": 7189.0,
      "formatted_start": "01:59:47.000",
      "formatted_end": "01:59:49.000",
      "text": "در یه ماه و بعد یه ماه یکم زرد میشن"
    },
    {
      "id": 41,
      "start": 7189.0,
      "end": 7191.0,
      "formatted_start": "01:59:49.000",
      "formatted_end": "01:59:51.000",
      "text": "اون مهم نیست"
    },
    {
      "id": 42,
      "start": 7191.0,
      "end": 7193.0,
      "formatted_start": "01:59:51.000",
      "formatted_end": "01:59:53.000",
      "text": "ولی اون دو هفته اول خیلی مهم"
    },
    {
      "id": 43,
      "start": 7193.0,
      "end": 7196.0,
      "formatted_start": "01:59:53.000",
      "formatted_end": "01:59:56.000",
      "text": "چون زردی های زیاد میتونه عوارز زگنی بذاره"
    },
    {
      "id": 44,
      "start": 7196.0,
      "end": 7198.0,
      "formatted_start": "01:59:56.000",
      "formatted_end": "01:59:58.000",
      "text": "یعنی از آیکی و اینا"
    },
    {
      "id": 45,
      "start": 7198.0,
      "end": 7200.0,
      "formatted_start": "01:59:58.000",
      "formatted_end": "02:00:00.000",
      "text": "باید توتر بیاد پایین"
    }
  ],
  "status": "completed"
}