  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "آره اون مثلا ازخال نیست."
    },
    {
      "id": 1,
      "start": 6605.76,
      "end": 6606.76,
      "formatted_start": "01:50:05.760",
      "formatted_end": "01:50:06.760",
      "text": "آره اون."
    },
    {
      "id": 2,
      "start": 6608.5,
      "end": 6609.5,
      "formatted_start": "01:50:08.500",
      "formatted_end": "01:50:09.500",
      "text": "توشای ریز."
    },
    {
      "id": 3,
      "start": 6610.5,
      "end": 6611.5,
      "formatted_start": "01:50:10.500",
      "formatted_end": "01:50:11.500",
      "text": "اون عرق توش ما."
    },
    {
      "id": 4,
      "start": 6613.0,
      "end": 6615.0,
      "formatted_start": "01:50:13.000",
      "formatted_end": "01:50:15.000",
      "text": "کالندولا یا این اند زنیل."
    },
    {
      "id": 5,
      "start": 6616.0,
      "end": 6617.0,
      "formatted_start": "01:50:16.000",
      "formatted_end": "01:50:17.000",
      "text": "دارین؟ آره."
    },
    {
      "id": 6,
      "start": 6617.0,
      "end": 6631.0,
      "formatted_start": "01:50:17.000",
      "formatted_end": "01:50:31.000",
      "text": "بیقرابی های شدید که نداره خانم خنبرد بود؟"
    },
    {
      "id": 7,
      "start": 6631.0,
      "end": 6633.0,
      "formatted_start": "01:50:31.000",
      "formatted_end": "01:50:33.000",
      "text": "به اون صورت نه ولی خب"
    },
    {
      "id": 8,
      "start": 6633.0,
      "end": 6636.0,
      "formatted_start": "01:50:33.000",
      "formatted_end": "01:50:36.000",
      "text": "قطعه هم دادی بودند دار میتونی کنون پیدی بست"
    },
    {
      "id": 9,
      "start": 6636.0,
      "end": 6639.0,
      "formatted_start": "01:50:36.000",
      "formatted_end": "01:50:39.000",
      "text": "به قیر از اهورانی داری؟"
    },
    {
      "id": 10,
      "start": 6639.0,
      "end": 6641.0,
      "formatted_start": "01:50:39.000",
      "formatted_end": "01:50:41.000",
      "text": "بیرون پیدی ها داده بودی"
    },
    {
      "id": 11,
      "start": 6641.0,
      "end": 6642.0,
      "formatted_start": "01:50:41.000",
      "formatted_end": "01:50:42.000",
      "text": "خب همون هم بهش بدی داری"
    },
    {
      "id": 12,
      "start": 6642.0,
      "end": 6643.0,
      "formatted_start": "01:50:42.000",
      "formatted_end": "01:50:43.000",
      "text": "آه اون هم به دار بست؟"
    },
    {
      "id": 13,
      "start": 6643.0,
      "end": 6645.0,
      "formatted_start": "01:50:43.000",
      "formatted_end": "01:50:45.000",
      "text": "دارو حالا بیادی من بدینم"
    },
    {
      "id": 14,
      "start": 6650.0,
      "end": 6653.0,
      "formatted_start": "01:50:50.000",
      "formatted_end": "01:50:53.000",
      "text": "خواهش میخواهم؟ در خیلی من چند سایه خورمون شما"
    },
    {
      "id": 15,
      "start": 6653.0,
      "end": 6655.0,
      "formatted_start": "01:50:53.000",
      "formatted_end": "01:50:55.000",
      "text": "خدا دیگر دارم"
    },
    {
      "id": 16,
      "start": 6655.0,
      "end": 6658.0,
      "formatted_start": "01:50:55.000",
      "formatted_end": "01:50:58.000",
      "text": "آیا این آبوزشی به این عطسه دادی؟"
    },
    {
      "id": 17,
      "start": 6658.0,
      "end": 6661.0,
      "formatted_start": "01:50:58.000",
      "formatted_end": "01:51:01.000",
      "text": "چند تا عطسه آبوزشش باید نداریم"
    },
    {
      "id": 18,
      "start": 6661.0,
      "end": 6663.0,
      "formatted_start": "01:51:01.000",
      "formatted_end": "01:51:03.000",
      "text": "خدا من دارم تو بینیس رو پاکم بکنم"
    },
    {
      "id": 19,
      "start": 6663.0,
      "end": 6666.0,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:06.000",
      "text": "پاکم میمکنی، یک قطعه دینی براش بینیسن"
    },
    {
      "id": 20,
      "start": 6668.0,
      "end": 6670.0,
      "formatted_start": "01:51:08.000",
      "formatted_end": "01:51:10.000",
      "text": "نه نه شربت هست؟"
    },
    {
      "id": 21,
      "start": 6670.0,
      "end": 6699.98,
      "formatted_start": "01:51:10.000",
      "formatted_end": "01:51:39.980",
      "text": "شبتی که شما بردارید، شبتی که شما بردارید، شبتی که شما بردارید"
    },
    {
      "id": 22,
      "start": 6700.0,
      "end": 6720.0,
      "formatted_start": "01:51:40.000",
      "formatted_end": "01:52:00.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 6720.0,
      "end": 6740.0,
      "formatted_start": "01:52:00.000",
      "formatted_end": "01:52:20.000",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 6740.0,
      "end": 6750.0,
      "formatted_start": "01:52:20.000",
      "formatted_end": "01:52:30.000",
      "text": "موسیقی"
    },
    {
