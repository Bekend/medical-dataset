  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10830.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:30.000",
      "text": "برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنا"
    },
    {
      "id": 1,
      "start": 10830.0,
      "end": 10832.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:32.000",
      "text": "دفعه گازش اینا خوبه؟"
    },
    {
      "id": 2,
      "start": 10832.0,
      "end": 10834.6,
      "formatted_start": "03:00:32.000",
      "formatted_end": "03:00:34.600",
      "text": "آره آره یک طور مثلا شکرمش گاز ده دارم"
    },
    {
      "id": 3,
      "start": 10834.6,
      "end": 10836.1,
      "formatted_start": "03:00:34.600",
      "formatted_end": "03:00:36.100",
      "text": "شیر کورنش اینا خوبه؟"
    },
    {
      "id": 4,
      "start": 10836.1,
      "end": 10837.4,
      "formatted_start": "03:00:36.100",
      "formatted_end": "03:00:37.400",
      "text": "آره شیر میخورم"
    },
    {
      "id": 5,
      "start": 10837.4,
      "end": 10839.6,
      "formatted_start": "03:00:37.400",
      "formatted_end": "03:00:39.600",
      "text": "شاید بالا های سکیل میکرد"
    },
    {
      "id": 6,
      "start": 10840.6,
      "end": 10841.6,
      "formatted_start": "03:00:40.600",
      "formatted_end": "03:00:41.600",
      "text": "خوب"
    },
    {
      "id": 7,
      "start": 10842.6,
      "end": 10844.3,
      "formatted_start": "03:00:42.600",
      "formatted_end": "03:00:44.300",
      "text": "این بار مثلا روز میدن آره"
    },
    {
      "id": 8,
      "start": 10844.3,
      "end": 10845.0,
      "formatted_start": "03:00:44.300",
      "formatted_end": "03:00:45.000",
      "text": "راحت نیست"
    },
    {
      "id": 9,
      "start": 10845.0,
      "end": 10846.0,
      "formatted_start": "03:00:45.000",
      "formatted_end": "03:00:46.000",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 10846.8,
      "end": 10847.8,
      "formatted_start": "03:00:46.800",
      "formatted_end": "03:00:47.800",
      "text": "سلام"
    },
    {
      "id": 11,
      "start": 10848.4,
      "end": 10849.4,
      "formatted_start": "03:00:48.400",
      "formatted_end": "03:00:49.400",
      "text": "سیرگون"
    },
    {
      "id": 12,
      "start": 10850.0,
      "end": 10851.6,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:00:51.600",
      "text": "شیر مادر میخوری؟ شیر خوش؟"
    },
    {
      "id": 13,
      "start": 10851.6,
      "end": 10852.6,
      "formatted_start": "03:00:51.600",
      "formatted_end": "03:00:52.600",
      "text": "شیر مادر"
    },
    {
      "id": 14,
      "start": 10854.4,
      "end": 10855.4,
      "formatted_start": "03:00:54.400",
      "formatted_end": "03:00:55.400",
      "text": "شیر مادر"
    },
    {
      "id": 15,
      "start": 10856.1,
      "end": 10856.6,
      "formatted_start": "03:00:56.100",
      "formatted_end": "03:00:56.600",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 10856.6,
      "end": 10859.1,
      "formatted_start": "03:00:56.600",
      "formatted_end": "03:00:59.100",
      "text": "ولی خب روداش تنبر شده"
    },
    {
      "id": 17,
      "start": 10859.1,
      "end": 10862.34,
      "formatted_start": "03:00:59.100",
      "formatted_end": "03:01:02.340",
      "text": "دفعه سخت شده و بیقراری میده"
    },
    {
      "id": 18,
      "start": 10862.34,
      "end": 10864.34,
      "formatted_start": "03:01:02.340",
      "formatted_end": "03:01:04.340",
      "text": "نباید این حالت باشه"
    },
    {
      "id": 19,
      "start": 10864.34,
      "end": 10866.34,
      "formatted_start": "03:01:04.340",
      "formatted_end": "03:01:06.340",
      "text": "یعنی عذیب می کنه و زخم می دازه"
    },
    {
      "id": 20,
      "start": 10866.34,
      "end": 10868.34,
      "formatted_start": "03:01:06.340",
      "formatted_end": "03:01:08.340",
      "text": "بابا سیر میشه اینها"
    },
    {
      "id": 21,
      "start": 10868.34,
      "end": 10870.34,
      "formatted_start": "03:01:08.340",
      "formatted_end": "03:01:10.340",
      "text": "و از جدر رو بگیر"
    },
    {
      "id": 22,
      "start": 10870.34,
      "end": 10872.34,
      "formatted_start": "03:01:10.340",
      "formatted_end": "03:01:12.340",
      "text": "گفتی چند را شد؟"
    },
    {
      "id": 23,
      "start": 10872.34,
      "end": 10874.34,
      "formatted_start": "03:01:12.340",
      "formatted_end": "03:01:14.340",
      "text": "هفت ماه"
    },
    {
      "id": 24,
      "start": 10874.34,
      "end": 10876.34,
      "formatted_start": "03:01:14.340",
      "formatted_end": "03:01:16.340",
      "text": "خطرناک نیست نه؟"
    },
    {
      "id": 25,
      "start": 10876.34,
      "end": 10878.34,
      "formatted_start": "03:01:16.340",
      "formatted_end": "03:01:18.340",
      "text": "خطرناک نیست ولی عذیب کننده"
    },
    {
      "id": 26,
      "start": 10878.34,
      "end": 10880.34,
      "formatted_start": "03:01:18.340",
      "formatted_end": "03:01:20.340",
      "text": "مثلا دوخان عذیب کننده"
    },
    {
      "id": 27,
      "start": 10880.34,
      "end": 10882.34,
      "formatted_start": "03:01:20.340",
      "formatted_end": "03:01:22.340",
      "text": "اول نه بود نوربراس کنندش"
    },
    {
      "id": 28,
      "start": 10882.34,
      "end": 10884.34,
      "formatted_start": "03:01:22.340",
      "formatted_end": "03:01:24.340",
      "text": "بله خوب"
    },
    {
      "id": 29,
      "start": 10884.34,
      "end": 10886.34,
      "formatted_start": "03:01:24.340",
      "formatted_end": "03:01:26.340",
      "text": "و این ترمان"
    },
    {
      "id": 30,
      "start": 10886.34,
      "end": 10888.34,
      "formatted_start": "03:01:26.340",
      "formatted_end": "03:01:28.340",
      "text": "سه سالش که بود دیگه دو سال رو بودیم"
    },
    {
      "id": 31,
      "start": 10888.34,
      "end": 10892.34,
      "formatted_start": "03:01:28.340",
      "formatted_end": "03:01:32.340",
      "text": "اینجوری شد. مثلا همجوری رو سرد داشتی نه؟"
    },
    {
      "id": 32,
      "start": 10892.34,
      "end": 10893.34,
      "formatted_start": "03:01:32.340",
      "formatted_end": "03:01:33.340",
      "text": "خوب."
    },
    {
      "id": 33,
      "start": 10893.34,
      "end": 10895.34,
      "formatted_start": "03:01:33.340",
      "formatted_end": "03:01:35.340",
      "text": "مثلا طب داشت، استفراد داشت، این هست."
    },
    {
      "id": 34,
      "start": 10895.34,
      "end": 10900.34,
      "formatted_start": "03:01:35.340",
      "formatted_end": "03:01:40.340",
      "text": "سه سال و نیمی، طب و استفراد. خب اولاین نورو بلاستون برای چیزی هست که عصبی است."
    },
    {
      "id": 35,
      "start": 10900.34,
      "end": 10901.34,
      "formatted_start": "03:01:40.340",
      "formatted_end": "03:01:41.340",
      "text": "آره آره."
    },
    {
      "id": 36,
      "start": 10901.34,
      "end": 10903.34,
      "formatted_start": "03:01:41.340",
      "formatted_end": "03:01:43.340",
      "text": "داستانش فقط روی..."
    },
    {
      "id": 37,
      "start": 10903.34,
      "end": 10905.34,
      "formatted_start": "03:01:43.340",
      "formatted_end": "03:01:45.340",
      "text": "مثلا فوت شد یا ایراتوبسترده."
    },
    {
      "id": 38,
      "start": 10905.34,
      "end": 10906.34,
      "formatted_start": "03:01:45.340",
      "formatted_end": "03:01:46.340",
      "text": "دیگه دسمتی نمیده."
    },
    {
      "id": 39,
      "start": 10906.34,
      "end": 10910.34,
      "formatted_start": "03:01:46.340",
      "formatted_end": "03:01:50.340",
      "text": "و دکتورش که مثلا من پیش رو آمکولوژیش بهش گفتم،"
    },
    {
      "id": 40,
      "start": 10910.34,
      "end": 10913.34,
      "formatted_start": "03:01:50.340",
      "formatted_end": "03:01:53.340",
      "text": "و مثلا ما حالا بار دارم و برای بچه هم مشکلی بشیم"
    },
    {
      "id": 41,
      "start": 10913.34,
      "end": 10915.34,
      "formatted_start": "03:01:53.340",
      "formatted_end": "03:01:55.340",
      "text": "گفت اصلا بیماری جنیزیکی نیست مار داره"
    },
    {
      "id": 42,
      "start": 10915.34,
      "end": 10916.34,
      "formatted_start": "03:01:55.340",
      "formatted_end": "03:01:56.340",
      "text": "اصلا"
    },
    {
      "id": 43,
      "start": 10916.34,
      "end": 10918.34,
      "formatted_start": "03:01:56.340",
      "formatted_end": "03:01:58.340",
      "text": "مار گفت اصلا رفت این هر داره ببینی"
    },
    {
      "id": 44,
      "start": 10918.34,
      "end": 10919.34,
      "formatted_start": "03:01:58.340",
      "formatted_end": "03:01:59.340",
      "text": "نگرام نباشی"
    },
    {
      "id": 45,
      "start": 10919.34,
      "end": 10921.34,
      "formatted_start": "03:01:59.340",
      "formatted_end": "03:02:01.340",
      "text": "برای بفتن بیارم بازو گفت"
    },
    {
      "id": 46,
      "start": 10921.34,
      "end": 10923.34,
      "formatted_start": "03:02:01.340",
      "formatted_end": "03:02:03.340",
      "text": "خب یه شیافه بیزاکودیله"
    },
    {
      "id": 47,
      "start": 10923.34,
      "end": 10927.34,
      "formatted_start": "03:02:03.340",
      "formatted_end": "03:02:07.340",
      "text": "اگر روزی شکمش کار نکرد روزی یه دونه براش بذارید"
    },
    {
      "id": 48,
      "start": 10927.34,
      "end": 10928.34,
      "formatted_start": "03:02:07.340",
      "formatted_end": "03:02:08.340",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 10928.34,
      "end": 10930.34,
      "formatted_start": "03:02:08.340",
      "formatted_end": "03:02:10.340",
      "text": "بیزاکودیل کدکان"
    },
    {
      "id": 50,
      "start": 10931.34,
      "end": 10935.34,
      "formatted_start": "03:02:11.340",
      "formatted_end": "03:02:15.340",
      "text": "یه شرعت انجیل روزی دو بار سه بار بذارید خب"
    },
    {
      "id": 51,
      "start": 10935.34,
      "end": 10937.34,
      "formatted_start": "03:02:15.340",
      "formatted_end": "03:02:17.340",
      "text": "شروط انجیر تا بیزا بخوره"
    },
    {
      "id": 52,
      "start": 10937.34,
      "end": 10939.34,
      "formatted_start": "03:02:17.340",
      "formatted_end": "03:02:19.340",
      "text": "شروط انجیر تا بیزا بخوره"
    },
    {
      "id": 53,
      "start": 10939.34,
      "end": 10941.34,
      "formatted_start": "03:02:19.340",
      "formatted_end": "03:02:21.340",
      "text": "شروط انجیر تا بیزا بخوره"
    },
    {
      "id": 54,
      "start": 10941.34,
      "end": 10943.34,
      "formatted_start": "03:02:21.340",
      "formatted_end": "03:02:23.340",
      "text": "شیافه که روزی یه بار"
    },
    {
      "id": 55,
      "start": 10943.34,
      "end": 10945.34,
      "formatted_start": "03:02:23.340",
      "formatted_end": "03:02:25.340",
      "text": "شروط روزی دو بار سه بار"
    },
    {
      "id": 56,
      "start": 10945.34,
      "end": 10947.34,
      "formatted_start": "03:02:25.340",
      "formatted_end": "03:02:27.340",
      "text": "شیاف روزی یه بار"
    },
    {
      "id": 57,
      "start": 10947.34,
      "end": 10949.34,
      "formatted_start": "03:02:27.340",
      "formatted_end": "03:02:29.340",
      "text": "یه داروی گریه هم از پنه هم فلوس"
    },
    {
      "id": 58,
      "start": 10949.34,
      "end": 10951.34,
      "formatted_start": "03:02:29.340",
      "formatted_end": "03:02:31.340",
      "text": "اگر با اینا بیتر شد"
    },
    {
      "id": 59,
      "start": 10951.34,
      "end": 10953.34,
      "formatted_start": "03:02:31.340",
      "formatted_end": "03:02:33.340",
      "text": "کسان فلوس نگه"
    },
    {
      "id": 60,
      "start": 10953.34,
      "end": 10955.34,
      "formatted_start": "03:02:33.340",
      "formatted_end": "03:02:35.340",
      "text": "بعد شروط انجیر دوسته هفته بگیر"
    },
    {
      "id": 61,
      "start": 10955.34,
      "end": 10957.34,
      "formatted_start": "03:02:35.340",
      "formatted_end": "03:02:37.340",
      "text": "بگیر دو روزه هاشت"
    },
    {
      "id": 62,
      "start": 10957.34,
      "end": 10959.34,
      "formatted_start": "03:02:37.340",
      "formatted_end": "03:02:39.340",
      "text": "پس اینجا عادتون رو میشه تا دوسته هفته انجیر بگیر"
    },
    {
      "id": 63,
      "start": 10959.34,
      "end": 10965.34,
      "formatted_start": "03:02:39.340",
      "formatted_end": "03:02:45.340",
      "text": "اینجا تا دو الى سه هفته بدهید"
    },
    {
      "id": 64,
      "start": 10965.34,
      "end": 10967.34,
      "formatted_start": "03:02:45.340",
      "formatted_end": "03:02:47.340",
      "text": "خوبی"
    },
    {
      "id": 65,
      "start": 10967.34,
      "end": 10969.34,
      "formatted_start": "03:02:47.340",
      "formatted_end": "03:02:49.340",
      "text": "چی خدمت شما؟"
    },
    {
      "id": 66,
      "start": 10969.34,
      "end": 10971.34,
      "formatted_start": "03:02:49.340",
      "formatted_end": "03:02:51.340",
      "text": "خیلی ممنون مقدس بگم"
    },
    {
      "id": 67,
      "start": 10971.34,
      "end": 10973.34,
      "formatted_start": "03:02:51.340",
      "formatted_end": "03:02:53.340",
      "text": "شیاف بگم اگر یک روز کار نکردید"
    },
    {
      "id": 68,
      "start": 10973.34,
      "end": 10975.34,
      "formatted_start": "03:02:53.340",
      "formatted_end": "03:02:55.340",
      "text": "چار ساست کار نکرد شیاف بگم"
    },
    {
      "id": 69,
      "start": 10975.34,
      "end": 10977.34,
      "formatted_start": "03:02:55.340",
      "formatted_end": "03:02:57.340",
      "text": "الان شیاف بگم"
    },
    {
      "id": 70,
      "start": 10977.34,
      "end": 10979.34,
      "formatted_start": "03:02:57.340",
      "formatted_end": "03:02:59.340",
      "text": "الان بگم"
    },
    {
      "id": 71,
      "start": 10979.34,
      "end": 10981.34,
      "formatted_start": "03:02:59.340",
      "formatted_end": "03:03:01.340",
      "text": "اگر شربت دیدیم را افتادید"
    },
    {
      "id": 72,
      "start": 10981.34,
      "end": 10983.34,
      "formatted_start": "03:03:01.340",
      "formatted_end": "03:03:03.340",
      "text": "دیگه شیاف نیم"
    },
    {
      "id": 73,
      "start": 10983.34,
      "end": 10985.34,
      "formatted_start": "03:03:03.340",
      "formatted_end": "03:03:05.340",
      "text": "خیلی ممنون مقدس بگم"
    },
    {
      "id": 74,
      "start": 10985.34,
      "end": 10987.34,
      "formatted_start": "03:03:05.340",
      "formatted_end": "03:03:07.340",
      "text": "خدا خوشید"
    },
    {
      "id": 75,
      "start": 10989.34,
      "end": 10995.34,
      "formatted_start": "03:03:09.340",
      "formatted_end": "03:03:15.340",
      "text": "سلام آقای راییمی، سلام خوبی جانم، خوب بانم جانم"
    },
    {
      "id": 76,
      "start": 10995.34,
      "end": 10997.34,
      "formatted_start": "03:03:15.340",
      "formatted_end": "03:03:17.340",
      "text": "خوشموند"
    },
    {
      "id": 77,
      "start": 10997.34,
      "end": 11001.34,
      "formatted_start": "03:03:17.340",
      "formatted_end": "03:03:21.340",
      "text": "چه مرد اسمان؟ در یک طول تیاریه رو باشید؟"
    },
    {
      "id": 78,
      "start": 11001.34,
      "end": 11003.34,
      "formatted_start": "03:03:21.340",
      "formatted_end": "03:03:23.340",
      "text": "بله"
    },
    {
      "id": 79,
      "start": 11003.34,
      "end": 11007.34,
      "formatted_start": "03:03:23.340",
      "formatted_end": "03:03:27.340",
      "text": "درسته؟"
    },
    {
      "id": 80,
      "start": 11007.34,
      "end": 11009.34,
      "formatted_start": "03:03:27.340",
      "formatted_end": "03:03:29.340",
      "text": "بله"
    },
    {
      "id": 81,
      "start": 11009.34,
      "end": 11013.34,
      "formatted_start": "03:03:29.340",
      "formatted_end": "03:03:33.340",
      "text": "خوب"
    },
    {
      "id": 82,
      "start": 11013.34,
      "end": 11043.34,
      "formatted_start": "03:03:33.340",
      "formatted_end": "03:04:03.340",
      "text": "اگر از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از این"
    },
    {
      "id": 83,
      "start": 11043.34,
      "end": 11045.34,
      "formatted_start": "03:04:03.340",
      "formatted_end": "03:04:05.340",
      "text": "اگر همکارای ناایگر باشن بیتره"
    },
    {
      "id": 84,
      "start": 11050.34,
      "end": 11053.34,
      "formatted_start": "03:04:10.340",
      "formatted_end": "03:04:13.340",
      "text": "بله باشه مرسی ممنون خداست"
    },
    {
      "id": 85,
      "start": 11073.34,
      "end": 11099.34,
      "formatted_start": "03:04:33.340",
      "formatted_end": "03:04:59.340",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}