  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8710.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:10.000",
      "text": "این صدای اضافه شنیده میشه تو قلبش. توصیح میکنم در مانگای طالعانی آیتو که ببینیش."
    },
    {
      "id": 1,
      "start": 8710.0,
      "end": 8713.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:13.000",
      "text": "بزرگ میشه اسمش؟"
    },
    {
      "id": 2,
      "start": 8713.0,
      "end": 8715.0,
      "formatted_start": "02:25:13.000",
      "formatted_end": "02:25:15.000",
      "text": "اسمش میدونستم، آره."
    },
    {
      "id": 3,
      "start": 8715.0,
      "end": 8720.0,
      "formatted_start": "02:25:15.000",
      "formatted_end": "02:25:20.000",
      "text": "بوشیر کنن، زود خسته نمیشه بوشیر میخوره یا راحت میخوره."
    },
    {
      "id": 4,
      "start": 8720.0,
      "end": 8722.0,
      "formatted_start": "02:25:20.000",
      "formatted_end": "02:25:22.000",
      "text": "بشیر کنش میخوره؟"
    },
    {
      "id": 5,
      "start": 8722.0,
      "end": 8724.0,
      "formatted_start": "02:25:22.000",
      "formatted_end": "02:25:24.000",
      "text": "نه، مثلاً..."
    },
    {
      "id": 6,
      "start": 8724.0,
      "end": 8728.0,
      "formatted_start": "02:25:24.000",
      "formatted_end": "02:25:28.000",
      "text": "مثلاً میمکه، یکم مثلاً مکس میکنه، باست میمکه."
    },
    {
      "id": 7,
      "start": 8728.0,
      "end": 8730.56,
      "formatted_start": "02:25:28.000",
      "formatted_end": "02:25:30.560",
      "text": "چقدر مثلا مکس می کنی؟ چقدر بی مکس می کنی؟"
    },
    {
      "id": 8,
      "start": 8730.56,
      "end": 8731.76,
      "formatted_start": "02:25:30.560",
      "formatted_end": "02:25:31.760",
      "text": "مکسی نمی کنی"
    },
    {
      "id": 9,
      "start": 8731.76,
      "end": 8734.06,
      "formatted_start": "02:25:31.760",
      "formatted_end": "02:25:34.060",
      "text": "5 دقیقه می خوره مکس می کنی یا نیم ساعت؟"
    },
    {
      "id": 10,
      "start": 8734.06,
      "end": 8736.4,
      "formatted_start": "02:25:34.060",
      "formatted_end": "02:25:36.400",
      "text": "نه 15 دقیقه نیم ساعت بیمی کنی"
    },
    {
      "id": 11,
      "start": 8736.4,
      "end": 8738.4,
      "formatted_start": "02:25:36.400",
      "formatted_end": "02:25:38.400",
      "text": "نه بیشتر بخورم بخورم"
    },
    {
      "id": 12,
      "start": 8738.4,
      "end": 8739.3,
      "formatted_start": "02:25:38.400",
      "formatted_end": "02:25:39.300",
      "text": "زمان میگید؟"
    },
    {
      "id": 13,
      "start": 8739.3,
      "end": 8744.06,
      "formatted_start": "02:25:39.300",
      "formatted_end": "02:25:44.060",
      "text": "آره 10 دقیقه یا 20 دقیقه می کنه بی مکس می کنه باز مکس می کنه باز"
    },
    {
      "id": 14,
      "start": 8744.06,
      "end": 8745.06,
      "formatted_start": "02:25:44.060",
      "formatted_end": "02:25:45.060",
      "text": "هر اقم می کنه با شیر؟"
    },
    {
      "id": 15,
      "start": 8745.06,
      "end": 8746.56,
      "formatted_start": "02:25:45.060",
      "formatted_end": "02:25:46.560",
      "text": "نه نه هر اقم نه"
    },
    {
      "id": 16,
      "start": 8746.56,
      "end": 8748.06,
      "formatted_start": "02:25:46.560",
      "formatted_end": "02:25:48.060",
      "text": "سن بچه شکر از دران؟"
    },
    {
      "id": 17,
      "start": 8748.06,
      "end": 8749.06,
      "formatted_start": "02:25:48.060",
      "formatted_end": "02:25:49.060",
      "text": "50 روزشه"
    },
    {
      "id": 18,
      "start": 8749.06,
      "end": 8750.4,
      "formatted_start": "02:25:49.060",
      "formatted_end": "02:25:50.400",
      "text": "50 روزشه"
    },
    {
      "id": 19,
      "start": 8750.4,
      "end": 8754.16,
      "formatted_start": "02:25:50.400",
      "formatted_end": "02:25:54.160",
      "text": "الان هم سرما خورده من داروی نوبرش آورم"
    },
    {
      "id": 20,
      "start": 8754.16,
      "end": 8756.4,
      "formatted_start": "02:25:54.160",
      "formatted_end": "02:25:56.400",
      "text": "بینیش هم گرفتگی داره؟ آره"
    },
    {
      "id": 21,
      "start": 8756.4,
      "end": 8758.96,
      "formatted_start": "02:25:56.400",
      "formatted_end": "02:25:58.960",
      "text": "داروی چیزی خونه داریم؟"
    },
    {
      "id": 22,
      "start": 8758.96,
      "end": 8762.16,
      "formatted_start": "02:25:58.960",
      "formatted_end": "02:26:02.160",
      "text": "فقط استامینوفون بهش دارم تبور بینی"
    },
    {
      "id": 23,
      "start": 8762.16,
      "end": 8765.16,
      "formatted_start": "02:26:02.160",
      "formatted_end": "02:26:05.160",
      "text": "دار این استامینوفون؟ آره دیشب هم داشت"
    },
    {
      "id": 24,
      "start": 8765.16,
      "end": 8767.16,
      "formatted_start": "02:26:05.160",
      "formatted_end": "02:26:07.160",
      "text": "اگر داری ننویسم بینی؟ نه نه"
    },
    {
      "id": 25,
      "start": 8767.16,
      "end": 8771.96,
      "formatted_start": "02:26:07.160",
      "formatted_end": "02:26:11.960",
      "text": "الان امروز هستش یا فردوس خود برم؟ اونو باید سآل کنیم"
    },
    {
      "id": 26,
      "start": 8771.96,
      "end": 8774.96,
      "formatted_start": "02:26:11.960",
      "formatted_end": "02:26:14.960",
      "text": "کچن بگو بیا؟ آره آره اونو بیا"
    },
    {
      "id": 27,
      "start": 8774.96,
      "end": 8778.96,
      "formatted_start": "02:26:14.960",
      "formatted_end": "02:26:18.960",
      "text": "بینیش هم میگیره نفس کشیدن سخت میشه؟ آره"
    },
    {
      "id": 28,
      "start": 8778.96,
      "end": 8781.88,
      "formatted_start": "02:26:18.960",
      "formatted_end": "02:26:21.880",
      "text": "این داروها رو بیار من ببینم"
    },
    {
      "id": 29,
      "start": 8781.88,
      "end": 8782.34,
      "formatted_start": "02:26:21.880",
      "formatted_end": "02:26:22.340",
      "text": "باش"
    },
    {
      "id": 30,
      "start": 8782.34,
      "end": 8785.34,
      "formatted_start": "02:26:22.340",
      "formatted_end": "02:26:25.340",
      "text": "میزنم نسل دکتر هم نیست"
    },
    {
      "id": 31,
      "start": 8785.34,
      "end": 8786.92,
      "formatted_start": "02:26:25.340",
      "formatted_end": "02:26:26.920",
      "text": "خوشت نسل نیست"
    },
    {
      "id": 32,
      "start": 8786.92,
      "end": 8791.06,
      "formatted_start": "02:26:26.920",
      "formatted_end": "02:26:31.060",
      "text": "پس سوال کنم که"
    },
    {
      "id": 33,
      "start": 8791.06,
      "end": 8793.14,
      "formatted_start": "02:26:31.060",
      "formatted_end": "02:26:33.140",
      "text": "دکتر بهودی"
    },
    {
      "id": 34,
      "start": 8793.14,
      "end": 8796.96,
      "formatted_start": "02:26:33.140",
      "formatted_end": "02:26:36.960",
      "text": "بهودی"
    },
    {
      "id": 35,
      "start": 8796.96,
      "end": 8799.32,
      "formatted_start": "02:26:36.960",
      "formatted_end": "02:26:39.320",
      "text": "خوبتخصص"
    },
    {
      "id": 36,
      "start": 8799.32,
      "end": 8801.94,
      "formatted_start": "02:26:39.320",
      "formatted_end": "02:26:41.940",
      "text": "قلب"
    },
    {
      "id": 37,
      "start": 8801.94,
      "end": 8804.94,
      "formatted_start": "02:26:41.940",
      "formatted_end": "02:26:44.940",
      "text": "بیمارستان طالقانی"
    },
    {
      "id": 38,
      "start": 8804.94,
      "end": 8807.4,
      "formatted_start": "02:26:44.940",
      "formatted_end": "02:26:47.400",
      "text": "صداش خیلی یکتنه"
    },
    {
      "id": 39,
      "start": 8807.4,
      "end": 8837.4,
      "formatted_start": "02:26:47.400",
      "formatted_end": "02:27:17.400",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 40,
      "start": 8837.4,
      "end": 8855.4,
      "formatted_start": "02:27:17.400",
      "formatted_end": "02:27:35.400",
      "text": "موسیقی"
    },
    {
      "id": 41,
      "start": 8855.4,
      "end": 8875.4,
      "formatted_start": "02:27:35.400",
      "formatted_end": "02:27:55.400",
      "text": "موسیقی"
    },
    {
      "id": 42,
      "start": 8885.4,
      "end": 8889.0,
      "formatted_start": "02:28:05.400",
      "formatted_end": "02:28:09.000",
      "text": "در یک سالانت قراری بکنید چند کراچی مصرف بود"
    },
    {
      "id": 43,
      "start": 8889.0,
      "end": 8890.6,
      "formatted_start": "02:28:09.000",
      "formatted_end": "02:28:10.600",
      "text": "این از این همه از این کرایی هست"
    },
    {
      "id": 44,
      "start": 8890.6,
      "end": 8894.4,
      "formatted_start": "02:28:10.600",
      "formatted_end": "02:28:14.400",
      "text": "و از این که تراثات خیلی از موردهای این کراچی بشت باشه"
    },
    {
      "id": 45,
      "start": 8894.4,
      "end": 8897.4,
      "formatted_start": "02:28:14.400",
      "formatted_end": "02:28:17.400",
      "text": "این کراچی این همه دیگر دوره"
    },
    {
      "id": 46,
      "start": 8897.4,
      "end": 8899.4,
      "formatted_start": "02:28:17.400",
      "formatted_end": "02:28:19.400",
      "text": "که سرچار هست"
    },
    {
      "id": 47,
      "start": 8899.4,
      "end": 8901.4,
      "formatted_start": "02:28:19.400",
      "formatted_end": "02:28:21.400",
      "text": "اما چه دیگر کراچی هست؟"
    },
    {
      "id": 48,
      "start": 8901.4,
      "end": 8902.4,
      "formatted_start": "02:28:21.400",
      "formatted_end": "02:28:22.400",
      "text": "بخونید؟"
    },
    {
      "id": 49,
      "start": 8902.4,
      "end": 8904.4,
      "formatted_start": "02:28:22.400",
      "formatted_end": "02:28:24.400",
      "text": "بخونم"
    },
    {
      "id": 50,
      "start": 8904.4,
      "end": 8905.4,
      "formatted_start": "02:28:24.400",
      "formatted_end": "02:28:25.400",
      "text": "بخونم"
    },
    {
      "id": 51,
      "start": 8905.4,
      "end": 8908.4,
      "formatted_start": "02:28:25.400",
      "formatted_end": "02:28:28.400",
      "text": "خب این سرومش که خب کامل میزنن"
    },
    {
      "id": 52,
      "start": 8908.4,
      "end": 8911.4,
      "formatted_start": "02:28:28.400",
      "formatted_end": "02:28:31.400",
      "text": "آمپولهاش دو تا الان اینکه قروب سر 6-7 بیانیم بزنن"
    },
    {
      "id": 53,
      "start": 8911.4,
      "end": 8913.4,
      "formatted_start": "02:28:31.400",
      "formatted_end": "02:28:33.400",
      "text": "پرساش رو روزی 3 بار"
    },
    {
      "id": 54,
      "start": 8913.4,
      "end": 8915.4,
      "formatted_start": "02:28:33.400",
      "formatted_end": "02:28:35.400",
      "text": "شربت رو روزی 3 بار"
    },
    {
      "id": 55,
      "start": 8915.4,
      "end": 8917.4,
      "formatted_start": "02:28:35.400",
      "formatted_end": "02:28:37.400",
      "text": "بگیرد این فرمت شما"
    },
    {
      "id": 56,
      "start": 8917.4,
      "end": 8921.4,
      "formatted_start": "02:28:37.400",
      "formatted_end": "02:28:41.400",
      "text": "یک ته پینی سیرین تو سروب نریدم بدن بخواهید"
    },
    {
      "id": 57,
      "start": 8941.4,
      "end": 8963.4,
      "formatted_start": "02:29:01.400",
      "formatted_end": "02:29:23.400",
      "text": "موسیقی"
    },
    {
      "id": 58,
      "start": 8963.4,
      "end": 8973.4,
      "formatted_start": "02:29:23.400",
      "formatted_end": "02:29:33.400",
      "text": "موسیقی"
    },
    {
      "id": 59,
      "start": 8993.4,
      "end": 8995.4,
      "formatted_start": "02:29:53.400",
      "formatted_end": "02:29:55.400",
