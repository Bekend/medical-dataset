  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6302.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:02.000",
      "text": "چرا یه هوا اینجور شده؟"
    },
    {
      "id": 1,
      "start": 6302.0,
      "end": 6306.0,
      "formatted_start": "01:45:02.000",
      "formatted_end": "01:45:06.000",
      "text": "افونته، ویروسه، یا از کسی گرفته یا از هوا اینا."
    },
    {
      "id": 2,
      "start": 6306.0,
      "end": 6308.0,
      "formatted_start": "01:45:06.000",
      "formatted_end": "01:45:08.000",
      "text": "همه روشنه، منوش سردی هم بشن."
    },
    {
      "id": 3,
      "start": 6308.0,
      "end": 6311.0,
      "formatted_start": "01:45:08.000",
      "formatted_end": "01:45:11.000",
      "text": "آره، گرم سرد بشین، این خدمت شما."
    },
    {
      "id": 4,
      "start": 6311.0,
      "end": 6316.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:16.000",
      "text": "همسایین بیشنن، داروها شو بگیریم بیاییم."
    },
    {
      "id": 5,
      "start": 6316.0,
      "end": 6318.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:18.000",
      "text": "اون پول بزرگشت، بهتر نداریم شبهه شده."
    },
    {
      "id": 6,
      "start": 6318.0,
      "end": 6320.0,
      "formatted_start": "01:45:18.000",
      "formatted_end": "01:45:20.000",
      "text": "این شالله، بره نه، اون پول هم نشون."
    },
    {
      "id": 7,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "سلام"
    },
    {
      "id": 8,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "سلام"
    },
    {
      "id": 9,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "سلام"
    },
    {
      "id": 10,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "سلام"
    },
    {
      "id": 11,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "سلام"
    },
    {
      "id": 12,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "سلام"
    },
    {
      "id": 13,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "سلام"
    },
    {
      "id": 14,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "سلام"
    },
    {
      "id": 15,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "سلام"
    },
    {
      "id": 16,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "سلام"
    },
    {
      "id": 17,
      "start": 6350.0,
      "end": 6352.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:52.000",
      "text": "سلام"
    },
    {
      "id": 18,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "سلام"
    },
    {
      "id": 19,
      "start": 6354.0,
      "end": 6356.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:56.000",
      "text": "سلام"
    },
    {
      "id": 20,
      "start": 6356.0,
      "end": 6358.0,
      "formatted_start": "01:45:56.000",
      "formatted_end": "01:45:58.000",
      "text": "سلام"
    },
    {
      "id": 21,
      "start": 6358.0,
      "end": 6360.0,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:00.000",
      "text": "اینجا باز می کنه؟"
    },
    {
      "id": 22,
      "start": 6360.0,
      "end": 6362.0,
      "formatted_start": "01:46:00.000",
      "formatted_end": "01:46:02.000",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 6362.0,
      "end": 6364.0,
      "formatted_start": "01:46:02.000",
      "formatted_end": "01:46:04.000",
      "text": "کد؟"
    },
    {
      "id": 24,
      "start": 6364.0,
      "end": 6366.0,
      "formatted_start": "01:46:04.000",
      "formatted_end": "01:46:06.000",
      "text": "باید بگیرم"
    },
    {
      "id": 25,
      "start": 6366.0,
      "end": 6368.0,
      "formatted_start": "01:46:06.000",
      "formatted_end": "01:46:08.000",
      "text": "باید بگیرم"
    },
    {
      "id": 26,
      "start": 6368.0,
      "end": 6370.0,
      "formatted_start": "01:46:08.000",
      "formatted_end": "01:46:10.000",
      "text": "باید بگیرم"
    },
    {
      "id": 27,
      "start": 6370.0,
      "end": 6372.0,
      "formatted_start": "01:46:10.000",
      "formatted_end": "01:46:12.000",
      "text": "باید بگیرم"
    },
    {
      "id": 28,
      "start": 6372.0,
      "end": 6374.0,
      "formatted_start": "01:46:12.000",
      "formatted_end": "01:46:14.000",
      "text": "باید بگیرم"
    },
    {
      "id": 29,
      "start": 6374.0,
      "end": 6376.0,
      "formatted_start": "01:46:14.000",
      "formatted_end": "01:46:16.000",
      "text": "باید بگیرم"
    },
    {
      "id": 30,
      "start": 6376.0,
      "end": 6378.0,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:18.000",
      "text": "باید بگیرم"
    },
    {
      "id": 31,
      "start": 6378.0,
      "end": 6380.0,
      "formatted_start": "01:46:18.000",
      "formatted_end": "01:46:20.000",
      "text": "باید بگیرم"
    },
    {
      "id": 32,
      "start": 6380.0,
      "end": 6382.0,
      "formatted_start": "01:46:20.000",
      "formatted_end": "01:46:22.000",
      "text": "باید بگیرم"
    },
    {
      "id": 33,
      "start": 6382.0,
      "end": 6384.0,
      "formatted_start": "01:46:22.000",
      "formatted_end": "01:46:24.000",
      "text": "باید بگیرم"
    },
    {
      "id": 34,
      "start": 6384.0,
      "end": 6386.0,
      "formatted_start": "01:46:24.000",
      "formatted_end": "01:46:26.000",
      "text": "باید بگیرم"
    },
    {
      "id": 35,
      "start": 6386.0,
      "end": 6388.0,
      "formatted_start": "01:46:26.000",
      "formatted_end": "01:46:28.000",
      "text": "ببینید نجام"
    },
    {
      "id": 36,
      "start": 6388.0,
      "end": 6392.0,
      "formatted_start": "01:46:28.000",
      "formatted_end": "01:46:32.000",
      "text": "حالا من بگم می کنم یک درگیب بعدش کمتر شده بکنم"
    },
    {
      "id": 37,
      "start": 6392.0,
      "end": 6394.0,
      "formatted_start": "01:46:32.000",
      "formatted_end": "01:46:34.000",
      "text": "این یکی خیلی باید داشت"
    },
    {
      "id": 38,
      "start": 6394.0,
      "end": 6396.0,
      "formatted_start": "01:46:34.000",
      "formatted_end": "01:46:36.000",
      "text": "بنابراین یک درگیب کمتر شده"
    },
    {
      "id": 39,
      "start": 6396.0,
      "end": 6400.0,
      "formatted_start": "01:46:36.000",
      "formatted_end": "01:46:40.000",
      "text": "خب، اینو نوشتم یک کنوش انجام بده"
    },
    {
      "id": 40,
      "start": 6400.0,
      "end": 6402.0,
      "formatted_start": "01:46:40.000",
      "formatted_end": "01:46:42.000",
      "text": "جوابش بیاد من ده"
    },
    {
      "id": 41,
      "start": 6402.0,
      "end": 6404.0,
      "formatted_start": "01:46:42.000",
      "formatted_end": "01:46:44.000",
      "text": "همینجا انجام بده؟"
    },
    {
      "id": 42,
      "start": 6404.0,
      "end": 6406.0,
      "formatted_start": "01:46:44.000",
      "formatted_end": "01:46:46.000",
      "text": "بله بله، همین قومت داره، جهازشترم همینجا"
    },
    {
      "id": 43,
      "start": 6406.0,
      "end": 6408.0,
      "formatted_start": "01:46:46.000",
      "formatted_end": "01:46:48.000",
      "text": "به منشین میگو"
    },
    {
      "id": 44,
      "start": 6408.0,
      "end": 6409.0,
      "formatted_start": "01:46:48.000",
      "formatted_end": "01:46:49.000",
      "text": "جا؟"
    },
    {
      "id": 45,
      "start": 6409.0,
      "end": 6410.0,
      "formatted_start": "01:46:49.000",
      "formatted_end": "01:46:50.000",
      "text": "حالا من انجام بده"
    },
    {
      "id": 46,
      "start": 6410.0,
      "end": 6412.0,
      "formatted_start": "01:46:50.000",
      "formatted_end": "01:46:52.000",
      "text": "انجام بده؟ آره، جوابش بیاد من ده"
    },
    {
      "id": 47,
      "start": 6412.0,
      "end": 6414.0,
      "formatted_start": "01:46:52.000",
      "formatted_end": "01:46:54.000",
      "text": "آه، خوش ممنون"
    },
    {
      "id": 48,
      "start": 6444.0,
      "end": 6469.0,
      "formatted_start": "01:47:24.000",
      "formatted_end": "01:47:49.000",
      "text": "موسیقی"
    },
    {
      "id": 49,
      "start": 6469.0,
      "end": 6473.8,
      "formatted_start": "01:47:49.000",
      "formatted_end": "01:47:53.800",
      "text": "خانسنگیم باید داروخان یه جایی نزدن که تو مثلا"
    },
    {
      "id": 50,
      "start": 6473.8,
      "end": 6478.0,
      "formatted_start": "01:47:53.800",
      "formatted_end": "01:47:58.000",
      "text": "آره سلام خواد شما خوبه؟ سلامت بشین"
    },
    {
      "id": 51,
      "start": 6478.0,
      "end": 6481.0,
      "formatted_start": "01:47:58.000",
      "formatted_end": "01:48:01.000",
      "text": "بفهمین سلام خواد شما خوبه؟ خانخان برخورد"
    },
    {
      "id": 52,
      "start": 6481.0,
      "end": 6482.0,
      "formatted_start": "01:48:01.000",
      "formatted_end": "01:48:02.000",
      "text": "سلامت باشین"
    },
    {
      "id": 53,
      "start": 6482.0,
      "end": 6484.0,
      "formatted_start": "01:48:02.000",
      "formatted_end": "01:48:04.000",
      "text": "خانسنگیم هم دیروز صرفه میخونه"
    },
    {
      "id": 54,
      "start": 6484.0,
      "end": 6485.0,
      "formatted_start": "01:48:04.000",
      "formatted_end": "01:48:05.000",
      "text": "صرفه؟"
    },
    {
      "id": 55,
      "start": 6485.0,
      "end": 6487.0,
      "formatted_start": "01:48:05.000",
      "formatted_end": "01:48:07.000",
      "text": "اشتراک میگه مکان بدنش گه هم"
    },
    {
      "id": 56,
      "start": 6487.0,
      "end": 6488.0,
      "formatted_start": "01:48:07.000",
      "formatted_end": "01:48:08.000",
      "text": "یه طب خفیف"
    },
    {
      "id": 57,
      "start": 6488.0,
      "end": 6490.0,
      "formatted_start": "01:48:08.000",
      "formatted_end": "01:48:10.000",
      "text": "بفهم خوش"
    },
    {
      "id": 58,
      "start": 6490.0,
      "end": 6491.0,
      "formatted_start": "01:48:10.000",
      "formatted_end": "01:48:11.000",
      "text": "آویزه شده؟"
    },
    {
      "id": 59,
      "start": 6491.0,
      "end": 6493.0,
      "formatted_start": "01:48:11.000",
      "formatted_end": "01:48:13.000",
      "text": "یه نوعی آویزه شده اینی هم داره"
    },
    {
      "id": 60,
      "start": 6493.0,
      "end": 6494.0,
      "formatted_start": "01:48:13.000",
      "formatted_end": "01:48:14.000",
      "text": "خسر هم که"
    },
    {
      "id": 61,
      "start": 6494.0,
      "end": 6495.0,
      "formatted_start": "01:48:14.000",
      "formatted_end": "01:48:15.000",
      "text": "خسر خسر سینه؟"
    },
    {
      "id": 62,
      "start": 6495.0,
      "end": 6497.0,
      "formatted_start": "01:48:15.000",
      "formatted_end": "01:48:17.000",
      "text": "من کسی سه احساسم"
    },
    {
      "id": 63,
      "start": 6497.0,
      "end": 6499.0,
      "formatted_start": "01:48:17.000",
      "formatted_end": "01:48:19.000",
      "text": "صرف های شدید یا خریدی کنید؟"
    },
    {
      "id": 64,
      "start": 6499.0,
      "end": 6506.0,
      "formatted_start": "01:48:19.000",
      "formatted_end": "01:48:26.000",
      "text": "دیگه یه هر چند دیگه یه صورتی کنید دو صورت پشت سره هم بیدونید"
    },
    {
      "id": 65,
      "start": 6511.0,
      "end": 6513.0,
      "formatted_start": "01:48:31.000",
      "formatted_end": "01:48:33.000",
      "text": "چند وقتی شدید؟"
    },
    {
      "id": 66,
      "start": 6513.0,
      "end": 6515.0,
      "formatted_start": "01:48:33.000",
      "formatted_end": "01:48:35.000",
      "text": "بردن 15 درست شد"
    },
    {
      "id": 67,
      "start": 6515.0,
      "end": 6517.0,
      "formatted_start": "01:48:35.000",
      "formatted_end": "01:48:37.000",
      "text": "یه مدار زرده صورتش"
    },
    {
      "id": 68,
      "start": 6517.0,
      "end": 6519.0,
      "formatted_start": "01:48:37.000",
      "formatted_end": "01:48:39.000",
      "text": "دستور بردیم جا بردم بخشیم خوب است"
    },
    {
      "id": 69,
      "start": 6519.0,
      "end": 6521.0,
      "formatted_start": "01:48:39.000",
      "formatted_end": "01:48:41.000",
      "text": "بردنش اگر ضعف نباشه بود؟"
    },
    {
      "id": 70,
      "start": 6521.0,
      "end": 6525.0,
      "formatted_start": "01:48:41.000",
      "formatted_end": "01:48:45.000",
      "text": "از اینش باید کم همه اثاری زیاد نیست"
    },
    {
      "id": 71,
      "start": 6525.0,
      "end": 6527.0,
      "formatted_start": "01:48:45.000",
      "formatted_end": "01:48:47.000",
      "text": "اون بعد به مرور از بین میده"
    },
    {
      "id": 72,
      "start": 6527.0,
      "end": 6529.0,
      "formatted_start": "01:48:47.000",
      "formatted_end": "01:48:49.000",
      "text": "گروه خونیتون چیه؟"
    },
    {
      "id": 73,
      "start": 6529.0,
      "end": 6531.0,
      "formatted_start": "01:48:49.000",
      "formatted_end": "01:48:51.000",
      "text": "او؟"
    },
    {
      "id": 74,
      "start": 6531.0,
      "end": 6533.0,
      "formatted_start": "01:48:51.000",
      "formatted_end": "01:48:53.000",
      "text": "او باشه همینیه"
    },
    {
      "id": 75,
      "start": 6533.0,
      "end": 6535.0,
      "formatted_start": "01:48:53.000",
      "formatted_end": "01:48:55.000",
      "text": "او معلوم تا پیمه ملچه بود"
    },
    {
      "id": 76,
      "start": 6535.0,
      "end": 6537.0,
      "formatted_start": "01:48:55.000",
      "formatted_end": "01:48:57.000",
      "text": "برسونه خون؟"
    },
    {
      "id": 77,
      "start": 6537.0,
      "end": 6539.0,
      "formatted_start": "01:48:57.000",
      "formatted_end": "01:48:59.000",
      "text": "نه نه یاد نیست"
    },
    {
      "id": 78,
      "start": 6539.0,
      "end": 6541.0,
      "formatted_start": "01:48:59.000",
      "formatted_end": "01:49:01.000",
      "text": "دستان یکم پیچتر بود"
    },
    {
      "id": 79,
      "start": 6541.0,
      "end": 6543.0,
      "formatted_start": "01:49:01.000",
      "formatted_end": "01:49:03.000",
      "text": "از اینها خوب میشن باید بباره خون مادر"
    },
    {
      "id": 80,
      "start": 6543.0,
      "end": 6545.0,
      "formatted_start": "01:49:03.000",
      "formatted_end": "01:49:05.000",
      "text": "که تو بدنشو تیزه میشه"
    },
    {
      "id": 81,
      "start": 6545.0,
      "end": 6547.0,
      "formatted_start": "01:49:05.000",
      "formatted_end": "01:49:07.000",
      "text": "زردشو میکنه"
    },
    {
      "id": 82,
      "start": 6551.0,
      "end": 6558.0,
      "formatted_start": "01:49:11.000",
      "formatted_end": "01:49:18.000",
      "text": "خوب برش داریم بزنیم بسیار راضیه"
    },
    {
      "id": 83,
      "start": 6558.0,
      "end": 6564.0,
      "formatted_start": "01:49:18.000",
      "formatted_end": "01:49:24.000",
      "text": "اما تو درست خیلی دیگه باشید این شرطانه نفتی ناداره"
    },
    {
      "id": 84,
      "start": 6564.0,
      "end": 6570.0,
      "formatted_start": "01:49:24.000",
      "formatted_end": "01:49:30.000",
      "text": "اما باید مثلا میدونیم خوب جوابیدی یه هفته در نفت"
    },
    {
      "id": 85,
      "start": 6570.0,
      "end": 6574.0,
      "formatted_start": "01:49:30.000",
      "formatted_end": "01:49:34.000",
      "text": "میدونیم بقامت میده هفته دیدی کنم شبهه تبیه میدونیم"
    },
    {
      "id": 86,
      "start": 6574.0,
      "end": 6576.0,
      "formatted_start": "01:49:34.000",
      "formatted_end": "01:49:36.000",
      "text": "خودتو هم رژیم غذایتون را رایت کنید"
    },
    {
      "id": 87,
      "start": 6576.0,
      "end": 6579.0,
      "formatted_start": "01:49:36.000",
      "formatted_end": "01:49:39.000",
      "text": "این از این تاجر که بتونن رای همون مالیتره که نفتارن"
    },
    {
      "id": 88,
      "start": 6579.0,
      "end": 6580.0,
      "formatted_start": "01:49:39.000",
      "formatted_end": "01:49:40.000",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 6581.0,
      "end": 6583.0,
      "formatted_start": "01:49:41.000",
      "formatted_end": "01:49:43.000",
      "text": "از این میلیسیر که را بفرام"
    },
    {
      "id": 90,
      "start": 6583.0,
      "end": 6585.0,
      "formatted_start": "01:49:43.000",
      "formatted_end": "01:49:45.000",
      "text": "یه میلیسیر بلای یک ماه"
    },
    {
      "id": 91,
      "start": 6585.0,
      "end": 6586.0,
      "formatted_start": "01:49:45.000",
      "formatted_end": "01:49:46.000",
      "text": "زیر یک ماه نیمیده"
    },
    {
      "id": 92,
      "start": 6586.0,
      "end": 6587.0,
      "formatted_start": "01:49:46.000",
      "formatted_end": "01:49:47.000",
      "text": "آره زیر یک ماه"
    },
    {
      "id": 93,
      "start": 6587.0,
      "end": 6588.0,
      "formatted_start": "01:49:47.000",
      "formatted_end": "01:49:48.000",
      "text": "بله؟"
    },
    {
      "id": 94,
      "start": 6588.0,
      "end": 6590.0,
      "formatted_start": "01:49:48.000",
      "formatted_end": "01:49:50.000",
      "text": "مشتوستان بخوره ماماش کشنه"
    },
    {
      "id": 95,
      "start": 6590.0,
      "end": 6591.0,
      "formatted_start": "01:49:50.000",
      "formatted_end": "01:49:51.000",
      "text": "نه نه"
    },
    {
      "id": 96,
      "start": 6591.0,
      "end": 6592.0,
      "formatted_start": "01:49:51.000",
      "formatted_end": "01:49:52.000",
      "text": "نه آنها اشکاله"
    },
    {
      "id": 97,
      "start": 6592.0,
      "end": 6594.0,
      "formatted_start": "01:49:52.000",
      "formatted_end": "01:49:54.000",
      "text": "از شکن بچن خیلی"
    },
    {
      "id": 98,
      "start": 6594.0,
      "end": 6595.0,
      "formatted_start": "01:49:54.000",
      "formatted_end": "01:49:55.000",
      "text": "از اون کار بوده"
    },
    {
      "id": 99,
      "start": 6595.0,
      "end": 6596.0,
      "formatted_start": "01:49:55.000",
      "formatted_end": "01:49:56.000",
      "text": "اون مثل اصحال آبکیه"
    },
    {
      "id": 100,
      "start": 6596.0,
      "end": 6597.0,
      "formatted_start": "01:49:56.000",
      "formatted_end": "01:49:57.000",
      "text": "بله"
    },
    {
      "id": 101,
      "start": 6597.0,
      "end": 6599.0,
      "formatted_start": "01:49:57.000",
      "formatted_end": "01:49:59.000",
      "text": "مثل اون زیر ۷-۸ بارون طبیعه"
    },
    {
      "id": 102,
      "start": 6599.0,
      "end": 6600.0,
      "formatted_start": "01:49:59.000",
      "formatted_end": "01:50:00.000",
