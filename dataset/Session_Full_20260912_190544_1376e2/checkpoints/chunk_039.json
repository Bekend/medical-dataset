  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11704.5,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:04.500",
      "text": "بله، پنجونین بیاین، خواهش می کنم، خدافید، نیستی؟ خدافید."
    },
    {
      "id": 1,
      "start": 11710.3,
      "end": 11712.3,
      "formatted_start": "03:15:10.300",
      "formatted_end": "03:15:12.300",
      "text": "بدترین کسی هست یادم؟"
    },
    {
      "id": 2,
      "start": 11712.8,
      "end": 11720.5,
      "formatted_start": "03:15:12.800",
      "formatted_end": "03:15:20.500",
      "text": "یه هفت گناه کبیره مشکل داریم، گناهان کبیره هفتگام ها که خیلی مشابه هستن."
    },
    {
      "id": 3,
      "start": 11720.5,
      "end": 11727.84,
      "formatted_start": "03:15:20.500",
      "formatted_end": "03:15:27.840",
      "text": "هر کنون از اون گناه ها مقابل یک صفت خوب برامیده"
    },
    {
      "id": 4,
      "start": 11727.84,
      "end": 11734.92,
      "formatted_start": "03:15:27.840",
      "formatted_end": "03:15:34.920",
      "text": "مثلا غرور مقابل توازنرهای خش و بهرم و کاهلی و مثلا کشاوی درمان"
    },
    {
      "id": 5,
      "start": 11734.92,
      "end": 11738.22,
      "formatted_start": "03:15:34.920",
      "formatted_end": "03:15:38.220",
      "text": "هر کنون از اون گناه ها مقابل یک صفت خوب برامیده"
    },
    {
      "id": 6,
      "start": 11738.22,
      "end": 11746.7,
      "formatted_start": "03:15:38.220",
      "formatted_end": "03:15:46.700",
      "text": "تنها صفت بدی و نونای کبیره که در مقابلش تمام صفتهای خوب قرار میده"
    },
    {
      "id": 7,
      "start": 11746.7,
      "end": 11749.54,
      "formatted_start": "03:15:46.700",
      "formatted_end": "03:15:49.540",
      "text": "و زندگیت داره با هر اختصار"
    },
    {
      "id": 8,
      "start": 11749.54,
      "end": 11757.18,
      "formatted_start": "03:15:49.540",
      "formatted_end": "03:15:57.180",
      "text": "هر انسانی که به این دو گناه آمده"
    },
    {
      "id": 9,
      "start": 11757.18,
      "end": 11762.0,
      "formatted_start": "03:15:57.180",
      "formatted_end": "03:16:02.000",
      "text": "نگه این که با من از اسمت و خصوصی و خوردار بوده باشه"
    },
    {
      "id": 10,
      "start": 11762.0,
      "end": 11764.7,
      "formatted_start": "03:16:02.000",
      "formatted_end": "03:16:04.700",
      "text": "که حسن در اینجوری شده باشه"
    },
    {
      "id": 11,
      "start": 11764.7,
      "end": 11769.86,
      "formatted_start": "03:16:04.700",
      "formatted_end": "03:16:09.860",
      "text": "اما اصلاً در هزاران قصیت و در وجود امسان داره"
    },
    {
      "id": 12,
      "start": 11769.86,
      "end": 11775.5,
      "formatted_start": "03:16:09.860",
      "formatted_end": "03:16:15.500",
      "text": "تابعری تو در مقابل اون سکت که تو رو انسان میکنه"
    },
    {
      "id": 13,
      "start": 11775.5,
      "end": 11777.88,
      "formatted_start": "03:16:15.500",
      "formatted_end": "03:16:17.880",
      "text": "جنگ با اونه که تو رو انسان میکنه"
    },
    {
      "id": 14,
      "start": 11777.88,
      "end": 11782.88,
      "formatted_start": "03:16:17.880",
      "formatted_end": "03:16:22.880",
      "text": "حسارت خود اون آدم رو که از مقایزه شدید به نظر میتونه دیار"
    },
    {
      "id": 15,
      "start": 11782.88,
      "end": 11784.88,
      "formatted_start": "03:16:22.880",
      "formatted_end": "03:16:24.880",
      "text": "از نفس تربیتی میتونه دیار"
    },
    {
      "id": 16,
      "start": 11784.88,
      "end": 11788.88,
      "formatted_start": "03:16:24.880",
      "formatted_end": "03:16:28.880",
      "text": "از اذرت نفس پایین میتونه دیار"
    },
    {
      "id": 17,
      "start": 11788.88,
      "end": 11792.88,
      "formatted_start": "03:16:28.880",
      "formatted_end": "03:16:32.880",
      "text": "میتونه اون آدم رو به خطر بگذار"
    },
    {
      "id": 18,
      "start": 11792.88,
      "end": 11794.88,
      "formatted_start": "03:16:32.880",
      "formatted_end": "03:16:34.880",
      "text": "خانه آدم رو به خطر بگذار"
    },
    {
      "id": 19,
      "start": 11794.88,
      "end": 11796.88,
      "formatted_start": "03:16:34.880",
      "formatted_end": "03:16:36.880",
      "text": "جامعه ها بودن به خطر بگذار"
    },
    {
      "id": 20,
      "start": 11796.88,
      "end": 11802.88,
      "formatted_start": "03:16:36.880",
      "formatted_end": "03:16:42.880",
      "text": "فقط برای اینکه صلاح نمیدونه کسی از این مقابلتی برکرداشت"
    },
    {
      "id": 21,
      "start": 11802.88,
      "end": 11812.88,
      "formatted_start": "03:16:42.880",
      "formatted_end": "03:16:52.880",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 11832.88,
      "end": 11834.88,
      "formatted_start": "03:17:12.880",
      "formatted_end": "03:17:14.880",
      "text": "از اینجور ها هیچ خبری نیست."
    },
    {
      "id": 23,
      "start": 11834.88,
      "end": 11836.88,
      "formatted_start": "03:17:14.880",
      "formatted_end": "03:17:16.880",
      "text": "خیلی دنبال را جدی نکنید."
    },
    {
      "id": 24,
      "start": 11836.88,
      "end": 11838.88,
      "formatted_start": "03:17:16.880",
      "formatted_end": "03:17:18.880",
      "text": "بچه ها دنیا خیلی جدی نیست."
    },
    {
      "id": 25,
      "start": 11838.88,
      "end": 11840.88,
      "formatted_start": "03:17:18.880",
      "formatted_end": "03:17:20.880",
      "text": "زندگی خیلی جدی نیست."
    },
    {
      "id": 26,
      "start": 11840.88,
      "end": 11842.88,
      "formatted_start": "03:17:20.880",
      "formatted_end": "03:17:22.880",
      "text": "اینجور ها هیچ خبری نیست."
    },
    {
      "id": 27,
      "start": 11842.88,
      "end": 11844.88,
      "formatted_start": "03:17:22.880",
      "formatted_end": "03:17:24.880",
      "text": "خیلی عجله نکنید"
    },
    {
      "id": 28,
      "start": 11844.88,
      "end": 11846.88,
      "formatted_start": "03:17:24.880",
      "formatted_end": "03:17:26.880",
      "text": "خودتون به اینجور ها برسونید."
    },
    {
      "id": 29,
      "start": 11846.88,
      "end": 11848.88,
      "formatted_start": "03:17:26.880",
      "formatted_end": "03:17:28.880",
      "text": "این خیلی عجله کنید"
    },
    {
      "id": 30,
      "start": 11848.88,
      "end": 11850.88,
      "formatted_start": "03:17:28.880",
      "formatted_end": "03:17:30.880",
      "text": "زودتر میگوید که اینجور خبری نیست."
    },
    {
      "id": 31,
      "start": 11850.88,
      "end": 11852.88,
      "formatted_start": "03:17:30.880",
      "formatted_end": "03:17:32.880",
      "text": "در آن و در حال زندگی کنید."
    },
    {
      "id": 32,
      "start": 11852.88,
      "end": 11854.88,
      "formatted_start": "03:17:32.880",
      "formatted_end": "03:17:34.880",
      "text": "سریع برای زندگی لذت رو برد."
    },
    {
      "id": 33,
      "start": 11854.88,
      "end": 11856.88,
      "formatted_start": "03:17:34.880",
      "formatted_end": "03:17:36.880",
      "text": "اگه دست میخونید"
    },
    {
      "id": 34,
      "start": 11856.88,
      "end": 11861.88,
      "formatted_start": "03:17:36.880",
      "formatted_end": "03:17:41.880",
      "text": "در آن و در حال زندگی، سیکنو از زندگی لذت بگویید"
    },
    {
      "id": 35,
      "start": 11861.88,
      "end": 11864.88,
      "formatted_start": "03:17:41.880",
      "formatted_end": "03:17:44.880",
      "text": "اگه درست میخونی، سیکنو از درست کنن لذت بگویید"
    },
    {
      "id": 36,
      "start": 11864.88,
      "end": 11867.88,
      "formatted_start": "03:17:44.880",
      "formatted_end": "03:17:47.880",
      "text": "اگه کار میکنی، سیکنو از کار کردن لذت بگویید"
    },
    {
      "id": 37,
      "start": 11867.88,
      "end": 11875.88,
      "formatted_start": "03:17:47.880",
      "formatted_end": "03:17:55.880",
      "text": "اگه کاری رو ارگاه میدی، سیکنو از روزتون بهترین نخلی کنید"
    },
    {
      "id": 38,
      "start": 11878.88,
      "end": 11883.88,
      "formatted_start": "03:17:58.880",
      "formatted_end": "03:18:03.880",
      "text": "آینده دست من و تو نیست، برسته تلاشی مهمه"
    },
    {
      "id": 39,
      "start": 11883.88,
      "end": 11898.88,
      "formatted_start": "03:18:03.880",
      "formatted_end": "03:18:18.880",
      "text": "خیلی چیز هام آمده دارید. آخر خط که میرسید میبینید که خوش همون روزایی که داشتم که سرس میکشنن برم آگردن خیلی درموار و جده هستید."
    },
    {
      "id": 40,
      "start": 11898.88,
      "end": 11904.88,
      "formatted_start": "03:18:18.880",
      "formatted_end": "03:18:24.880",
      "text": "موسیقی"
    },
    {
      "id": 41,
      "start": 11928.88,
      "end": 11946.88,
      "formatted_start": "03:18:48.880",
      "formatted_end": "03:19:06.880",
      "text": "موسیقی"
    },
    {
      "id": 42,
      "start": 11958.88,
      "end": 11978.88,
      "formatted_start": "03:19:18.880",
      "formatted_end": "03:19:38.880",
      "text": "موسیقی"
    },
    {
      "id": 43,
      "start": 11988.88,
      "end": 12000.0,
      "formatted_start": "03:19:48.880",
      "formatted_end": "03:20:00.000",
      "text": "موسیقی"
    }
  ],
