  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12307.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:07.000",
      "text": "برد بسای شیوه خوشکم و کمانکی گیرش کنید."
    },
    {
      "id": 1,
      "start": 12307.0,
      "end": 12323.0,
      "formatted_start": "03:25:07.000",
      "formatted_end": "03:25:23.000",
      "text": "شیوه خوشکم رو صفت می کنید، اگه تا جایی که امکان داره شیوه خوشک ندارید."
    },
    {
      "id": 2,
      "start": 12323.0,
      "end": 12325.0,
      "formatted_start": "03:25:23.000",
      "formatted_end": "03:25:25.000",
      "text": "اسمی چیه؟"
    },
    {
      "id": 3,
      "start": 12325.0,
      "end": 12327.0,
      "formatted_start": "03:25:25.000",
      "formatted_end": "03:25:27.000",
      "text": "آیدا"
    },
    {
      "id": 4,
      "start": 12327.0,
      "end": 12329.0,
      "formatted_start": "03:25:27.000",
      "formatted_end": "03:25:29.000",
      "text": "آیدا"
    },
    {
      "id": 5,
      "start": 12329.0,
      "end": 12331.0,
      "formatted_start": "03:25:29.000",
      "formatted_end": "03:25:31.000",
      "text": "من میدونم"
    },
    {
      "id": 6,
      "start": 12331.0,
      "end": 12333.0,
      "formatted_start": "03:25:31.000",
      "formatted_end": "03:25:33.000",
      "text": "جان جان چی؟"
    },
    {
      "id": 7,
      "start": 12333.0,
      "end": 12335.0,
      "formatted_start": "03:25:33.000",
      "formatted_end": "03:25:35.000",
      "text": "بابا"
    },
    {
      "id": 8,
      "start": 12335.0,
      "end": 12337.0,
      "formatted_start": "03:25:35.000",
      "formatted_end": "03:25:37.000",
      "text": "چی؟ بابا"
    },
    {
      "id": 9,
      "start": 12337.0,
      "end": 12339.0,
      "formatted_start": "03:25:37.000",
      "formatted_end": "03:25:39.000",
      "text": "من شیخوش بیش میدارم"
    },
    {
      "id": 10,
      "start": 12339.0,
      "end": 12341.0,
      "formatted_start": "03:25:39.000",
      "formatted_end": "03:25:41.000",
      "text": "خیلی بچه بردن اینجور شد"
    },
    {
      "id": 11,
      "start": 12341.0,
      "end": 12343.0,
      "formatted_start": "03:25:41.000",
      "formatted_end": "03:25:43.000",
      "text": "چون کمکی بهش میدارم"
    },
    {
      "id": 12,
      "start": 12343.0,
      "end": 12345.0,
      "formatted_start": "03:25:43.000",
      "formatted_end": "03:25:45.000",
      "text": "بچه امتنان بسیار"
    },
    {
      "id": 13,
      "start": 12345.0,
      "end": 12347.0,
      "formatted_start": "03:25:45.000",
      "formatted_end": "03:25:47.000",
      "text": "دوزه هاش تنبر شده"
    },
    {
      "id": 14,
      "start": 12347.0,
      "end": 12349.0,
      "formatted_start": "03:25:47.000",
      "formatted_end": "03:25:49.000",
      "text": "بردن شکن بستر شده"
    },
    {
      "id": 15,
      "start": 12349.0,
      "end": 12351.0,
      "formatted_start": "03:25:49.000",
      "formatted_end": "03:25:51.000",
      "text": "کدید پنج ماه شده"
    },
    {
      "id": 16,
      "start": 12351.0,
      "end": 12353.0,
      "formatted_start": "03:25:51.000",
      "formatted_end": "03:25:53.000",
      "text": "دو ماه شیر"
    },
    {
      "id": 17,
      "start": 12353.0,
      "end": 12357.0,
      "formatted_start": "03:25:53.000",
      "formatted_end": "03:25:57.000",
      "text": "شربت و شیاه اونها میرونیستن بگیر بیا"
    },
    {
      "id": 18,
      "start": 12357.0,
      "end": 12360.0,
      "formatted_start": "03:25:57.000",
      "formatted_end": "03:26:00.000",
      "text": "تا جایی که ممکنه شیر مادر رو پیشتر بگه"
    },
    {
      "id": 19,
      "start": 12360.0,
      "end": 12362.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:02.000",
      "text": "آب شیر مادر شرم میکنه"
    },
    {
      "id": 20,
      "start": 12362.0,
      "end": 12365.0,
      "formatted_start": "03:26:02.000",
      "formatted_end": "03:26:05.000",
      "text": "هر نوع شیر خوش صفت میکنه خانم گریج"
    },
    {
      "id": 21,
      "start": 12365.0,
      "end": 12368.0,
      "formatted_start": "03:26:05.000",
      "formatted_end": "03:26:08.000",
      "text": "شیر خوش خوش نده"
    },
    {
      "id": 22,
      "start": 12368.0,
      "end": 12371.0,
      "formatted_start": "03:26:08.000",
      "formatted_end": "03:26:11.000",
      "text": "اگه شیر خود کافی شیر خوش نده"
    },
    {
      "id": 23,
      "start": 12371.0,
      "end": 12374.0,
      "formatted_start": "03:26:11.000",
      "formatted_end": "03:26:14.000",
      "text": "بچه برست نمیمونه چون شیرم کمه"
    },
    {
      "id": 24,
      "start": 12374.0,
      "end": 12376.0,
      "formatted_start": "03:26:14.000",
      "formatted_end": "03:26:16.000",
      "text": "کمه؟ خیلی"
    },
    {
      "id": 25,
      "start": 12376.0,
      "end": 12378.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:18.000",
      "text": "این دارو رو بیاد من ببینم"
    },
    {
      "id": 26,
      "start": 12378.0,
      "end": 12381.0,
      "formatted_start": "03:26:18.000",
      "formatted_end": "03:26:21.000",
      "text": "یه داروی گریه ای هم از پشت نسخه بینیمیسم"
    },
    {
      "id": 27,
      "start": 12381.0,
      "end": 12387.0,
      "formatted_start": "03:26:21.000",
      "formatted_end": "03:26:27.000",
      "text": "اگر با این ها خوب شد که ایچی همین را ادامه میدید وگرنه اون دروی گیا گیرم دگریش"
    },
    {
      "id": 28,
      "start": 12387.0,
      "end": 12389.0,
      "formatted_start": "03:26:27.000",
      "formatted_end": "03:26:29.000",
      "text": "بعد این گیرمی چی را براش بگیرم؟"
    },
    {
      "id": 29,
      "start": 12389.0,
      "end": 12390.0,
      "formatted_start": "03:26:29.000",
      "formatted_end": "03:26:30.000",
      "text": "آیده ها"
    },
    {
      "id": 30,
      "start": 12390.0,
      "end": 12393.0,
      "formatted_start": "03:26:30.000",
      "formatted_end": "03:26:33.000",
      "text": "نه ببینید اگر بی خرالی داره براش بگیرم"
    },
    {
      "id": 31,
      "start": 12393.0,
      "end": 12395.0,
      "formatted_start": "03:26:33.000",
      "formatted_end": "03:26:35.000",
      "text": "داره چون همیشه استفاده میکنیم"
    },
    {
      "id": 32,
      "start": 12395.0,
      "end": 12399.0,
      "formatted_start": "03:26:35.000",
      "formatted_end": "03:26:39.000",
      "text": "ببینید کلوس براش بگیر از تاریها داره مثل قهقی چوبانه"
    },
    {
      "id": 33,
      "start": 12399.0,
      "end": 12403.0,
      "formatted_start": "03:26:39.000",
      "formatted_end": "03:26:43.000",
      "text": "این دروی هم اصلا ورن گرفتیم"
    },
    {
      "id": 34,
      "start": 12403.0,
      "end": 12406.0,
      "formatted_start": "03:26:43.000",
      "formatted_end": "03:26:46.000",
      "text": "این ها مثل نفخش بوده و اونا قبلت"
    },
    {
      "id": 35,
      "start": 12406.0,
      "end": 12409.0,
      "formatted_start": "03:26:46.000",
      "formatted_end": "03:26:49.000",
      "text": "اون رو برای نفخشم بینویسم؟"
    },
    {
      "id": 36,
      "start": 12409.0,
      "end": 12410.0,
      "formatted_start": "03:26:49.000",
      "formatted_end": "03:26:50.000",
      "text": "بله، نفخم دارم"
    },
    {
      "id": 37,
      "start": 12410.0,
      "end": 12413.0,
      "formatted_start": "03:26:50.000",
      "formatted_end": "03:26:53.000",
      "text": "این شربت عبورانینی براش بگیر"
    },
    {
      "id": 38,
      "start": 12413.0,
      "end": 12417.0,
      "formatted_start": "03:26:53.000",
      "formatted_end": "03:26:57.000",
      "text": "هر هشت ساعت یک عطره دائمی کنه"
    },
    {
      "id": 39,
      "start": 12417.0,
      "end": 12419.0,
      "formatted_start": "03:26:57.000",
      "formatted_end": "03:26:59.000",
      "text": "بیقراری شدید داره یا کمه؟"
    },
    {
      "id": 40,
      "start": 12419.0,
      "end": 12421.0,
      "formatted_start": "03:26:59.000",
      "formatted_end": "03:27:01.000",
      "text": "دیشه هم خیلی شده"
    },
    {
      "id": 41,
      "start": 12421.0,
      "end": 12422.0,
      "formatted_start": "03:27:01.000",
      "formatted_end": "03:27:02.000",
      "text": "فقط دیشه هم خیلی شده؟"
    },
    {
      "id": 42,
      "start": 12422.0,
      "end": 12424.0,
      "formatted_start": "03:27:02.000",
      "formatted_end": "03:27:04.000",
      "text": "خب، دیشه هم کمش کار نکرد"
    },
    {
      "id": 43,
      "start": 12424.0,
      "end": 12426.0,
      "formatted_start": "03:27:04.000",
      "formatted_end": "03:27:06.000",
      "text": "خود این هبوبات نخود"
    },
    {
      "id": 44,
      "start": 12426.0,
      "end": 12428.0,
      "formatted_start": "03:27:06.000",
      "formatted_end": "03:27:08.000",
      "text": "نخود نو بیا ماشاله از درخواه هبوبات"
    },
    {
      "id": 45,
      "start": 12428.0,
      "end": 12431.0,
      "formatted_start": "03:27:08.000",
      "formatted_end": "03:27:11.000",
      "text": "لبنیات گاوی، ماز، شیر، پنیر، کشت"
    },
    {
      "id": 46,
      "start": 12431.0,
      "end": 12433.76,
      "formatted_start": "03:27:11.000",
      "formatted_end": "03:27:13.760",
      "text": "اینجا اونها رو بگیر بیار بگیرم بیارم"
    },
    {
      "id": 47,
      "start": 12433.76,
      "end": 12435.34,
      "formatted_start": "03:27:13.760",
      "formatted_end": "03:27:15.340",
      "text": "آره این داروها اینجا نمیدونی"
    },
    {
      "id": 48,
      "start": 12435.34,
      "end": 12438.56,
      "formatted_start": "03:27:15.340",
      "formatted_end": "03:27:18.560",
      "text": "آره داروها رو بگیر"
    },
    {
      "id": 49,
      "start": 12438.56,
      "end": 12440.66,
      "formatted_start": "03:27:18.560",
      "formatted_end": "03:27:20.660",
      "text": "آره داروها رو از دارو خانه بگیر بیار من"
    },
    {
      "id": 50,
      "start": 12440.66,
      "end": 12441.46,
      "formatted_start": "03:27:20.660",
      "formatted_end": "03:27:21.460",
      "text": "چنانم آره بیار"
    },
    {
      "id": 51,
      "start": 12441.46,
      "end": 12463.46,
      "formatted_start": "03:27:21.460",
      "formatted_end": "03:27:43.460",
      "text": "موسیقی"
    },
    {
      "id": 52,
      "start": 12471.46,
      "end": 12501.46,
      "formatted_start": "03:27:51.460",
      "formatted_end": "03:28:21.460",
      "text": "مرسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که برسی که ب"
    },
    {
      "id": 53,
      "start": 12501.46,
      "end": 12531.46,
      "formatted_start": "03:28:21.460",
      "formatted_end": "03:28:51.460",
      "text": "در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت"
    },
    {
      "id": 54,
      "start": 12531.46,
      "end": 12537.46,
      "formatted_start": "03:28:51.460",
      "formatted_end": "03:28:57.460",
      "text": "تا کار ما در این جهان بگرده و به من اون کار خوب رو برداریم"
    },
    {
      "id": 55,
      "start": 12537.46,
      "end": 12544.46,
      "formatted_start": "03:28:57.460",
      "formatted_end": "03:29:04.460",
      "text": "یه نفر باید بگو به من بگو من اون رو بگو کردم؟ ممکنه محتمل"
    },
    {
      "id": 56,
      "start": 12544.46,
      "end": 12547.46,
      "formatted_start": "03:29:04.460",
      "formatted_end": "03:29:07.460",
      "text": "ممکنه شما جواب خوبی تو ببین"
    },
    {
      "id": 57,
      "start": 12547.46,
      "end": 12551.46,
      "formatted_start": "03:29:07.460",
      "formatted_end": "03:29:11.460",
      "text": "ولی اینم صورت داره اینم مهم است"
    },
    {
      "id": 58,
      "start": 12551.46,
      "end": 12554.46,
      "formatted_start": "03:29:11.460",
      "formatted_end": "03:29:14.460",
      "text": "گوه است رو کار خوب رو انجام دیدم"
    },
    {
      "id": 59,
      "start": 12554.46,
      "end": 12557.46,
      "formatted_start": "03:29:14.460",
      "formatted_end": "03:29:17.460",
      "text": "چون کار خوبیه"
    },
    {
      "id": 60,
      "start": 12557.46,
      "end": 12560.96,
      "formatted_start": "03:29:17.460",
      "formatted_end": "03:29:20.960",
      "text": "اخلاقی کار خوب بودن"
    },
    {
      "id": 61,
      "start": 12560.96,
      "end": 12563.52,
      "formatted_start": "03:29:20.960",
      "formatted_end": "03:29:23.520",
      "text": "حتی اگه ایچی کسی نکنن"
    },
    {
      "id": 62,
      "start": 12563.52,
      "end": 12566.32,
      "formatted_start": "03:29:23.520",
      "formatted_end": "03:29:26.320",
      "text": "و ایچ پاداشی موجود نداشت موجود نیست"
    },
    {
      "id": 63,
      "start": 12566.32,
      "end": 12569.7,
      "formatted_start": "03:29:26.320",
      "formatted_end": "03:29:29.700",
      "text": "کار بدن بدن حتی اگه همه انجامش بودن"
    },
    {
      "id": 64,
      "start": 12569.7,
      "end": 12572.54,
      "formatted_start": "03:29:29.700",
      "formatted_end": "03:29:32.540",
      "text": "وقتی نداشته باشه"
    },
    {
      "id": 65,
      "start": 12587.46,
      "end": 12599.46,
      "formatted_start": "03:29:47.460",
      "formatted_end": "03:29:59.460",
      "text": "موسیقی"
    }
  ],
