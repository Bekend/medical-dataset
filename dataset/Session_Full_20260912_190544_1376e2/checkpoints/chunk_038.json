  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11413.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:13.000",
      "text": "حالا اون عدد رو به اضافه ۱۰ اشکام، به اضافه ۱۳ اشکام، حالا می کنی همون عددی که انتخابی داردی کنی."
    },
    {
      "id": 1,
      "start": 11413.0,
      "end": 11419.0,
      "formatted_start": "03:10:13.000",
      "formatted_end": "03:10:19.000",
      "text": "جواب میشه ۲۳، اگه خوشتون مدت فارغ."
    },
    {
      "id": 2,
      "start": 11419.0,
      "end": 11425.0,
      "formatted_start": "03:10:19.000",
      "formatted_end": "03:10:25.000",
      "text": "قول میدی اگه همین یکمان ذهنی تو نه، باید برداری کنی."
    },
    {
      "id": 3,
      "start": 11425.0,
      "end": 11447.0,
      "formatted_start": "03:10:25.000",
      "formatted_end": "03:10:47.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 11455.0,
      "end": 11466.0,
      "formatted_start": "03:10:55.000",
      "formatted_end": "03:11:06.000",
      "text": "از طریق یک دلچه کوچک اونجا است که از طریق این واده پودر به داخل دلیلان های اداری هست"
    },
    {
      "id": 5,
      "start": 11466.0,
      "end": 11469.0,
      "formatted_start": "03:11:06.000",
      "formatted_end": "03:11:09.000",
      "text": "پیشتر این کنک رو برمونوشید از این خوانکی که داشتید"
    },
    {
      "id": 6,
      "start": 11469.0,
      "end": 11473.0,
      "formatted_start": "03:11:09.000",
      "formatted_end": "03:11:13.000",
      "text": "تو یک طریق این خوانکتر رو برمونه و همون دقا برمونه"
    },
    {
      "id": 7,
      "start": 11473.0,
      "end": 11478.0,
      "formatted_start": "03:11:13.000",
      "formatted_end": "03:11:18.000",
      "text": "اگر نه اینجا برمونیشید درجه رو مشخص کردید که از اینجا برمونه"
    },
    {
      "id": 8,
      "start": 11478.0,
      "end": 11508.0,
      "formatted_start": "03:11:18.000",
      "formatted_end": "03:11:48.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 9,
      "start": 11508.0,
      "end": 11510.3,
      "formatted_start": "03:11:48.000",
      "formatted_end": "03:11:50.300",
      "text": "مادری که مرد بوده مرد"
    },
    {
      "id": 10,
      "start": 11510.3,
      "end": 11513.58,
      "formatted_start": "03:11:50.300",
      "formatted_end": "03:11:53.580",
      "text": "حتی با موجود نبودن مردش"
    },
    {
      "id": 11,
      "start": 11513.58,
      "end": 11516.4,
      "formatted_start": "03:11:53.580",
      "formatted_end": "03:11:56.400",
      "text": "یا حتی اگه مردی بود که مناسب نبود"
    },
    {
      "id": 12,
      "start": 11516.4,
      "end": 11518.36,
      "formatted_start": "03:11:56.400",
      "formatted_end": "03:11:58.360",
      "text": "ولی خودشی با مرد نیست"
    },
    {
      "id": 13,
      "start": 11518.36,
      "end": 11520.78,
      "formatted_start": "03:11:58.360",
      "formatted_end": "03:12:00.780",
      "text": "و تونست بچهش رو درست ترقیت کنه"
    },
    {
      "id": 14,
      "start": 11520.78,
      "end": 11523.42,
      "formatted_start": "03:12:00.780",
      "formatted_end": "03:12:03.420",
      "text": "که الان بچه به معفقیت برسه"
    },
    {
      "id": 15,
      "start": 11523.42,
      "end": 11526.6,
      "formatted_start": "03:12:03.420",
      "formatted_end": "03:12:06.600",
      "text": "کسی اینجا مانیست؟ بیا بیا بیا"
    },
    {
      "id": 16,
      "start": 11526.6,
      "end": 11529.02,
      "formatted_start": "03:12:06.600",
      "formatted_end": "03:12:09.020",
      "text": "پرشترم برد"
    },
    {
      "id": 17,
      "start": 11529.02,
      "end": 11533.32,
      "formatted_start": "03:12:09.020",
      "formatted_end": "03:12:13.320",
      "text": "بای درخت عجیر نگاه کن"
    },
    {
      "id": 18,
      "start": 11533.32,
      "end": 11534.84,
      "formatted_start": "03:12:13.320",
      "formatted_end": "03:12:14.840",
      "text": "تو درد کو"
    },
    {
      "id": 19,
      "start": 11534.84,
      "end": 11537.86,
      "formatted_start": "03:12:14.840",
      "formatted_end": "03:12:17.860",
      "text": "بچه ها دارن عجیر میکنن"
    },
    {
      "id": 20,
      "start": 11537.86,
      "end": 11541.86,
      "formatted_start": "03:12:17.860",
      "formatted_end": "03:12:21.860",
      "text": "باید برگیز بیاد ببین که همه بیاد بیاد سفردنشون رو بیدید"
    },
    {
      "id": 21,
      "start": 11541.86,
      "end": 11571.86,
      "formatted_start": "03:12:21.860",
      "formatted_end": "03:12:51.860",
      "text": "وااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااااا"
    },
    {
      "id": 22,
      "start": 11571.86,
      "end": 11577.86,
      "formatted_start": "03:12:51.860",
      "formatted_end": "03:12:57.860",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 11601.86,
      "end": 11631.86,
      "formatted_start": "03:13:21.860",
      "formatted_end": "03:13:51.860",
      "text": "چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگه چطوری دیگ"
    },
    {
      "id": 24,
      "start": 11631.86,
      "end": 11634.38,
      "formatted_start": "03:13:51.860",
      "formatted_end": "03:13:54.380",
      "text": "من الان شما نمیدونید الان مرد بریم"
    },
    {
      "id": 25,
      "start": 11634.38,
      "end": 11637.62,
      "formatted_start": "03:13:54.380",
      "formatted_end": "03:13:57.620",
      "text": "این درست سریع داره اشکال نداره الان تا یک هستیم"
    },
    {
      "id": 26,
      "start": 11638.36,
      "end": 11638.96,
      "formatted_start": "03:13:58.360",
      "formatted_end": "03:13:58.960",
      "text": "یک هستیم؟"
    },
    {
      "id": 27,
      "start": 11638.96,
      "end": 11641.76,
      "formatted_start": "03:13:58.960",
      "formatted_end": "03:14:01.760",
      "text": "آره تا یک هستیم یک به بعد دیگه نیستیم"
    },
    {
      "id": 28,
      "start": 11641.76,
      "end": 11643.26,
      "formatted_start": "03:14:01.760",
      "formatted_end": "03:14:03.260",
      "text": "قبل یک بیاییم نتر"
    },
    {
      "id": 29,
      "start": 11643.62,
      "end": 11646.62,
      "formatted_start": "03:14:03.620",
      "formatted_end": "03:14:06.620",
      "text": "زور بگیم مرسی خدا به شما خدا بگیم"
    },
    {
      "id": 30,
      "start": 11661.86,
      "end": 11666.4,
      "formatted_start": "03:14:21.860",
      "formatted_end": "03:14:26.400",
      "text": "محلوی باقی کن بیشون، این رفترس و زمان دوستت که بهش احتیاج داره"
    },
    {
      "id": 31,
      "start": 11666.4,
      "end": 11669.84,
      "formatted_start": "03:14:26.400",
      "formatted_end": "03:14:29.840",
      "text": "آمدی آمدان چجوری موده پاکی میده خودت کن بی کنی"
    },
    {
      "id": 32,
      "start": 11669.84,
      "end": 11672.16,
      "formatted_start": "03:14:29.840",
      "formatted_end": "03:14:32.160",
      "text": "یه ریمونتر خواب نیه، خط نیاد و بی مایی"
    },
    {
      "id": 33,
      "start": 11672.16,
      "end": 11675.76,
      "formatted_start": "03:14:32.160",
      "formatted_end": "03:14:35.760",
      "text": "اینو بیا افتحالیه، دلیتا چرا بایدش خاموش بشه"
    },
    {
      "id": 34,
      "start": 11675.76,
      "end": 11676.48,
      "formatted_start": "03:14:35.760",
      "formatted_end": "03:14:36.480",
      "text": "اینجا باید"
    },
    {
      "id": 35,
      "start": 11691.86,
      "end": 11695.44,
      "formatted_start": "03:14:51.860",
      "formatted_end": "03:14:55.440",
      "text": "بله"
    },
    {
      "id": 36,
      "start": 11695.44,
      "end": 11697.16,
      "formatted_start": "03:14:55.440",
      "formatted_end": "03:14:57.160",
      "text": "بفهمید سکته"
    },
    {
      "id": 37,
      "start": 11697.16,
      "end": 11698.0,
      "formatted_start": "03:14:57.160",
      "formatted_end": "03:14:58.000",
      "text": "بله خوش"
    }
  ],
  "status": "completed"
}