      "text": "ولی آدم غیرمنطلی، سر می کنی شرایط رو بخورش برم."
    },
    {
      "id": 1,
      "start": 10205.0,
      "end": 10209.0,
      "formatted_start": "02:50:05.000",
      "formatted_end": "02:50:09.000",
      "text": "مشاهد باقی کلمت کردم، این ویدیو ها هرچیه."
    },
    {
      "id": 2,
      "start": 10210.0,
      "end": 10211.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:11.000",
      "text": "سلام آدم."
    },
    {
      "id": 3,
      "start": 10211.0,
      "end": 10214.0,
      "formatted_start": "02:50:11.000",
      "formatted_end": "02:50:14.000",
      "text": "سلام بیانم، حال شما خوبه؟ سلامت کرسی؟"
    },
    {
      "id": 4,
      "start": 10214.0,
      "end": 10215.0,
      "formatted_start": "02:50:14.000",
      "formatted_end": "02:50:15.000",
      "text": "آریانا جون آبوروی."
    },
    {
      "id": 5,
      "start": 10215.0,
      "end": 10216.0,
      "formatted_start": "02:50:15.000",
      "formatted_end": "02:50:16.000",
      "text": "خواهش می کنم برم."
    },
    {
      "id": 6,
      "start": 10216.0,
      "end": 10217.0,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:17.000",
      "text": "سلام."
    },
    {
      "id": 7,
      "start": 10217.0,
      "end": 10219.0,
      "formatted_start": "02:50:17.000",
      "formatted_end": "02:50:19.000",
      "text": "سلام. خوبی این؟ خوبون شما؟"
    },
    {
      "id": 8,
      "start": 10219.0,
      "end": 10220.0,
      "formatted_start": "02:50:19.000",
      "formatted_end": "02:50:20.000",
      "text": "سلام بیانم."
    },
    {
      "id": 9,
      "start": 10220.0,
      "end": 10225.0,
      "formatted_start": "02:50:20.000",
      "formatted_end": "02:50:25.000",
      "text": "چرا رو تخت بذارین خانم رسگار آدنا درسته؟"
    },
    {
      "id": 10,
      "start": 10225.0,
      "end": 10226.0,
      "formatted_start": "02:50:25.000",
      "formatted_end": "02:50:26.000",
      "text": "آریانا."
    },
    {
      "id": 11,
      "start": 10226.0,
      "end": 10228.0,
      "formatted_start": "02:50:26.000",
      "formatted_end": "02:50:28.000",
      "text": "آریانا. چی شده آریانا رو؟"
    },
    {
      "id": 12,
      "start": 10228.0,
      "end": 10235.5,
      "formatted_start": "02:50:28.000",
      "formatted_end": "02:50:35.500",
      "text": "اوالا یکم خوبه، غذا خوردنشو اینا خوبه، فقط یه مقدار گوشه سمت چپشو می کشه"
    },
    {
      "id": 13,
      "start": 10235.5,
      "end": 10239.0,
      "formatted_start": "02:50:35.500",
      "formatted_end": "02:50:39.000",
      "text": "گوشه چپشو، بعد دردم داره؟"
    },
    {
      "id": 14,
      "start": 10239.0,
      "end": 10243.5,
      "formatted_start": "02:50:39.000",
      "formatted_end": "02:50:43.500",
      "text": "نه، یه مقدار من چیز دیدم"
    },
    {
      "id": 15,
      "start": 10243.5,
      "end": 10244.5,
      "formatted_start": "02:50:43.500",
      "formatted_end": "02:50:44.500",
      "text": "چی رو؟"
    },
    {
      "id": 16,
      "start": 10244.5,
      "end": 10246.0,
      "formatted_start": "02:50:44.500",
      "formatted_end": "02:50:46.000",
      "text": "ترشوهات"
    },
    {
      "id": 17,
      "start": 10246.0,
      "end": 10249.5,
      "formatted_start": "02:50:46.000",
      "formatted_end": "02:50:49.500",
      "text": "قهوهی زردرنگ، نیمه صف"
    },
    {
      "id": 18,
      "start": 10249.5,
      "end": 10252.5,
      "formatted_start": "02:50:49.500",
      "formatted_end": "02:50:52.500",
      "text": "آره، نیمه صفت زردرنگه"
    },
    {
      "id": 19,
      "start": 10252.5,
      "end": 10255.5,
      "formatted_start": "02:50:52.500",
      "formatted_end": "02:50:55.500",
      "text": "اینا جرمه بوشن اون که اگه افونت باشه"
    },
    {
      "id": 20,
      "start": 10255.5,
      "end": 10260.5,
      "formatted_start": "02:50:55.500",
      "formatted_end": "02:51:00.500",
      "text": "مثل زرده تقومورد مابکی میاد بیری تو افونته"
    },
    {
      "id": 21,
      "start": 10260.5,
      "end": 10267.5,
      "formatted_start": "02:51:00.500",
      "formatted_end": "02:51:07.500",
      "text": "ولی این که زردرنگ نیمه صفته میاد بیرون اونا جرمایی بوشن شما ای دست میزنید اینا"
    },
    {
      "id": 22,
      "start": 10267.5,
      "end": 10270.5,
      "formatted_start": "02:51:07.500",
      "formatted_end": "02:51:10.500",
      "text": "ما مانان خیلی خیلی بچه بوششو میشید"
    },
    {
      "id": 23,
      "start": 10270.5,
      "end": 10271.5,
      "formatted_start": "02:51:10.500",
      "formatted_end": "02:51:11.500",
      "text": "بچه بیرونششو میشید؟"
    },
    {
      "id": 24,
      "start": 10271.5,
      "end": 10272.5,
      "formatted_start": "02:51:11.500",
      "formatted_end": "02:51:12.500",
      "text": "بله بله بله"
    },
    {
      "id": 25,
      "start": 10272.5,
      "end": 10273.5,
      "formatted_start": "02:51:12.500",
      "formatted_end": "02:51:13.500",
      "text": "الان الان الان"
    },
    {
      "id": 26,
      "start": 10273.5,
      "end": 10274.5,
      "formatted_start": "02:51:13.500",
      "formatted_end": "02:51:14.500",
      "text": "بله بله"
    },
    {
      "id": 27,
      "start": 10274.5,
      "end": 10276.5,
      "formatted_start": "02:51:14.500",
      "formatted_end": "02:51:16.500",
      "text": "سلام سلام"
    },
    {
      "id": 28,
      "start": 10276.5,
      "end": 10278.5,
      "formatted_start": "02:51:16.500",
      "formatted_end": "02:51:18.500",
      "text": "بخشیدی کنی کمیابی"
    },
    {
      "id": 29,
      "start": 10278.5,
      "end": 10280.5,
      "formatted_start": "02:51:18.500",
      "formatted_end": "02:51:20.500",
      "text": "بیری کمیابی"
    },
    {
      "id": 30,
      "start": 10282.5,
      "end": 10286.5,
      "formatted_start": "02:51:22.500",
      "formatted_end": "02:51:26.500",
      "text": "افترین شما این برای گواستی ممنون شد"
    },
    {
      "id": 31,
      "start": 10286.5,
      "end": 10288.5,
      "formatted_start": "02:51:26.500",
      "formatted_end": "02:51:28.500",
      "text": "ممنون"
    },
    {
      "id": 32,
      "start": 10288.5,
      "end": 10290.5,
      "formatted_start": "02:51:28.500",
      "formatted_end": "02:51:30.500",
      "text": "دستاشو نگهرده بید من"
    },
    {
      "id": 33,
      "start": 10290.5,
      "end": 10292.5,
      "formatted_start": "02:51:30.500",
      "formatted_end": "02:51:32.500",
      "text": "گوشاشو دستشم نگهرده بید"
    },
    {
      "id": 34,
      "start": 10292.5,
      "end": 10294.5,
      "formatted_start": "02:51:32.500",
      "formatted_end": "02:51:34.500",
      "text": "دختر بخشم"
    },
    {
      "id": 35,
      "start": 10294.5,
      "end": 10298.5,
      "formatted_start": "02:51:34.500",
      "formatted_end": "02:51:38.500",
      "text": "جان جان مامان"
    },
    {
      "id": 36,
      "start": 10298.5,
      "end": 10300.5,
      "formatted_start": "02:51:38.500",
      "formatted_end": "02:51:40.500",
      "text": "دختر من"
    },
    {
      "id": 37,
      "start": 10300.5,
      "end": 10304.5,
      "formatted_start": "02:51:40.500",
      "formatted_end": "02:51:44.500",
      "text": "خوشکی من مامان این چیزی نیست دخترم"
    },
    {
      "id": 38,
      "start": 10304.5,
      "end": 10306.5,
      "formatted_start": "02:51:44.500",
      "formatted_end": "02:51:46.500",
      "text": "خوشکی من مامان"
    },
    {
      "id": 39,
      "start": 10306.5,
      "end": 10308.5,
      "formatted_start": "02:51:46.500",
      "formatted_end": "02:51:48.500",
      "text": "بکن نخونم عجل نخونم"
    },
    {
      "id": 40,
      "start": 10308.5,
      "end": 10310.5,
      "formatted_start": "02:51:48.500",
      "formatted_end": "02:51:50.500",
      "text": "مامان"
    },
    {
      "id": 41,
      "start": 10310.5,
      "end": 10312.5,
      "formatted_start": "02:51:50.500",
      "formatted_end": "02:51:52.500",
      "text": "ماما ماما"
    },
    {
      "id": 42,
      "start": 10312.5,
      "end": 10314.5,
      "formatted_start": "02:51:52.500",
      "formatted_end": "02:51:54.500",
      "text": "ماما"
    },
    {
      "id": 43,
      "start": 10314.5,
      "end": 10316.5,
      "formatted_start": "02:51:54.500",
      "formatted_end": "02:51:56.500",
      "text": "اوه خیلی"
    },
    {
      "id": 44,
      "start": 10316.5,
      "end": 10318.5,
      "formatted_start": "02:51:56.500",
      "formatted_end": "02:51:58.500",
      "text": "خوب"
    },
    {
      "id": 45,
      "start": 10318.5,
      "end": 10320.5,
      "formatted_start": "02:51:58.500",
      "formatted_end": "02:52:00.500",
      "text": "دیگه گلون شو دیگه آشکار"
    },
    {
      "id": 46,
      "start": 10320.5,
      "end": 10322.5,
      "formatted_start": "02:52:00.500",
      "formatted_end": "02:52:02.500",
      "text": "دیگه بینید"
    },
    {
      "id": 47,
      "start": 10322.5,
      "end": 10324.5,
      "formatted_start": "02:52:02.500",
      "formatted_end": "02:52:04.500",
      "text": "این الان دو ششه"
    },
    {
      "id": 48,
      "start": 10324.5,
      "end": 10326.5,
      "formatted_start": "02:52:04.500",
      "formatted_end": "02:52:06.500",
      "text": "میاد داره اکزما داره"
    },
    {
      "id": 49,
      "start": 10326.5,
      "end": 10328.5,
      "formatted_start": "02:52:06.500",
      "formatted_end": "02:52:08.500",
      "text": "این دا خشکه زده"
    },
    {
      "id": 50,
      "start": 10328.5,
      "end": 10330.5,
      "formatted_start": "02:52:08.500",
      "formatted_end": "02:52:10.500",
      "text": "بعد این جرمان که میاد"
    },
    {
      "id": 51,
      "start": 10330.5,
      "end": 10332.5,
      "formatted_start": "02:52:10.500",
      "formatted_end": "02:52:12.500",
      "text": "پشتر ازش داره"
    },
    {
      "id": 52,
      "start": 10332.5,
      "end": 10334.5,
      "formatted_start": "02:52:12.500",
      "formatted_end": "02:52:14.500",
      "text": "بعد این بازوهایی میدونید"
    },
    {
      "id": 53,
      "start": 10334.5,
      "end": 10336.5,
      "formatted_start": "02:52:14.500",
      "formatted_end": "02:52:16.500",
      "text": "ممکنه اکزما باشه"
    },
    {
      "id": 54,
      "start": 10336.5,
      "end": 10338.5,
      "formatted_start": "02:52:16.500",
      "formatted_end": "02:52:18.500",
      "text": "ممکنه هم عادتیه"
    },
    {
      "id": 55,
      "start": 10338.5,
      "end": 10340.5,
      "formatted_start": "02:52:18.500",
      "formatted_end": "02:52:20.500",
      "text": "او فرنسی خوشوند"
    },
    {
      "id": 56,
      "start": 10340.5,
      "end": 10342.5,
      "formatted_start": "02:52:20.500",
      "formatted_end": "02:52:22.500",
      "text": "ولی افونت نیست"
    },
    {
      "id": 57,
      "start": 10342.5,
      "end": 10344.5,
      "formatted_start": "02:52:22.500",
      "formatted_end": "02:52:24.500",
      "text": "بعد مقدر یک قطره میویسم"
    },
    {
      "id": 58,
      "start": 10344.5,
      "end": 10346.5,
      "formatted_start": "02:52:24.500",
      "formatted_end": "02:52:26.500",
      "text": "تو گوشش سه قطره روز سه بار بیدید"
    },
    {
      "id": 59,
      "start": 10346.5,
      "end": 10348.5,
      "formatted_start": "02:52:26.500",
      "formatted_end": "02:52:28.500",
      "text": "اگر حالت اکزما"
    },
    {
      "id": 60,
      "start": 10348.5,
      "end": 10350.5,
      "formatted_start": "02:52:28.500",
      "formatted_end": "02:52:30.500",
      "text": "و حالت التوابای بارچی باشه"
    },
    {
      "id": 61,
      "start": 10350.5,
      "end": 10352.5,
      "formatted_start": "02:52:30.500",
      "formatted_end": "02:52:32.500",
      "text": "این از بین میبرد"
    },
    {
      "id": 62,
      "start": 10352.5,
      "end": 10354.5,
      "formatted_start": "02:52:32.500",
      "formatted_end": "02:52:34.500",
      "text": "اگر نباشه دیگه همون عادتیه"
    },
    {
      "id": 63,
      "start": 10354.5,
      "end": 10356.5,
      "formatted_start": "02:52:34.500",
      "formatted_end": "02:52:36.500",
      "text": "از خیلی وقت"
    },
    {
      "id": 64,
      "start": 10356.5,
      "end": 10358.5,
      "formatted_start": "02:52:36.500",
      "formatted_end": "02:52:38.500",
      "text": "اینو داره ها"
    },
    {
      "id": 65,
      "start": 10358.5,
      "end": 10360.5,
      "formatted_start": "02:52:38.500",
      "formatted_end": "02:52:40.500",
      "text": "ممکنه بگم بعض مورد همون"
    },
    {
      "id": 66,
      "start": 10360.5,
      "end": 10362.5,
      "formatted_start": "02:52:40.500",
      "formatted_end": "02:52:42.500",
      "text": "عادتی باشه ولی"
    },
    {
      "id": 67,
      "start": 10362.5,
      "end": 10364.5,
      "formatted_start": "02:52:42.500",
      "formatted_end": "02:52:44.500",
      "text": "قطره لازمه"
    },
    {
      "id": 68,
      "start": 10364.5,
      "end": 10366.5,
      "formatted_start": "02:52:44.500",
      "formatted_end": "02:52:46.500",
      "text": "مامان"
    },
    {
      "id": 69,
      "start": 10366.5,
      "end": 10368.5,
      "formatted_start": "02:52:46.500",
      "formatted_end": "02:52:48.500",
      "text": "مو باشه چیزی نکنه؟"
    },
    {
      "id": 70,
      "start": 10368.5,
      "end": 10370.5,
      "formatted_start": "02:52:48.500",
      "formatted_end": "02:52:50.500",
      "text": "چیزی نکنه؟"
    },
    {
      "id": 71,
      "start": 10370.5,
      "end": 10372.5,
      "formatted_start": "02:52:50.500",
      "formatted_end": "02:52:52.500",
      "text": "مو باشه"
    },
    {
      "id": 72,
      "start": 10372.5,
      "end": 10374.5,
      "formatted_start": "02:52:52.500",
      "formatted_end": "02:52:54.500",
      "text": "مو باشه"
    },
    {
      "id": 73,
      "start": 10374.5,
      "end": 10376.5,
      "formatted_start": "02:52:54.500",
      "formatted_end": "02:52:56.500",
      "text": "مو باشه"
    },
    {
      "id": 74,
      "start": 10376.5,
      "end": 10378.5,
      "formatted_start": "02:52:56.500",
      "formatted_end": "02:52:58.500",
      "text": "خب"
    },
    {
      "id": 75,
      "start": 10378.5,
      "end": 10380.5,
      "formatted_start": "02:52:58.500",
      "formatted_end": "02:53:00.500",
      "text": "اون رساله"
    },
    {
      "id": 76,
      "start": 10380.5,
      "end": 10382.5,
      "formatted_start": "02:53:00.500",
      "formatted_end": "02:53:02.500",
      "text": "آنتیویتی کنار نیاز نداره"
    },
    {
      "id": 77,
      "start": 10382.5,
      "end": 10384.5,
      "formatted_start": "02:53:02.500",
      "formatted_end": "02:53:04.500",
      "text": "خواهد یک قطعه از خود اون قطعه آنتیویتی بخواهید"
    },
    {
      "id": 78,
      "start": 10384.5,
      "end": 10386.5,
      "formatted_start": "02:53:04.500",
      "formatted_end": "02:53:06.500",
      "text": "چیزها رو توش داره"
    },
    {
      "id": 79,
      "start": 10386.5,
      "end": 10388.5,
      "formatted_start": "02:53:06.500",
      "formatted_end": "02:53:08.500",
      "text": "نه مشکل نه"
    },
    {
      "id": 80,
      "start": 10388.5,
      "end": 10390.5,
      "formatted_start": "02:53:08.500",
      "formatted_end": "02:53:10.500",
      "text": "نگراد نباشه"
    },
    {
      "id": 81,
      "start": 10390.5,
      "end": 10392.5,
      "formatted_start": "02:53:10.500",
      "formatted_end": "02:53:12.500",
      "text": "خواهش میکنن در خدمت نزدن"
    },
    {
      "id": 82,
      "start": 10392.5,
      "end": 10394.5,
      "formatted_start": "02:53:12.500",
      "formatted_end": "02:53:14.500",
      "text": "آقاییتون یک سوال راشتم"
    },
    {
      "id": 83,
      "start": 10394.5,
      "end": 10397.56,
      "formatted_start": "02:53:14.500",
      "formatted_end": "02:53:17.560",
      "text": "یکی اردویلش دخون داره اومده"
    },
    {
      "id": 84,
      "start": 10397.56,
      "end": 10399.56,
      "formatted_start": "02:53:17.560",
      "formatted_end": "02:53:19.560",
      "text": "اما سه ماه خورده این شد"
    },
    {
      "id": 85,
      "start": 10399.56,
      "end": 10403.24,
      "formatted_start": "02:53:19.560",
      "formatted_end": "02:53:23.240",
      "text": "بعد میگن که از چهار ماهیگی به بعد میشه"
    },
    {
      "id": 86,
      "start": 10403.24,
      "end": 10405.24,
      "formatted_start": "02:53:23.240",
      "formatted_end": "02:53:25.240",
      "text": "برغزوی کمکی شده"
    },
    {
      "id": 87,
      "start": 10405.24,
      "end": 10407.24,
      "formatted_start": "02:53:25.240",
      "formatted_end": "02:53:27.240",
      "text": "شیش ماهیگی"
    },
    {
      "id": 88,
      "start": 10407.24,
      "end": 10409.24,
      "formatted_start": "02:53:27.240",
      "formatted_end": "02:53:29.240",
      "text": "این چهار ماهیگی میگن اصلا غابل تریدیست"
    },
    {
      "id": 89,
      "start": 10409.24,
      "end": 10411.24,
      "formatted_start": "02:53:29.240",
      "formatted_end": "02:53:31.240",
      "text": "هم شیش ماهیگی درسته؟"
    },
    {
      "id": 90,
      "start": 10411.24,
      "end": 10414.08,
      "formatted_start": "02:53:31.240",
      "formatted_end": "02:53:34.080",
      "text": "بچه های نارست از چهار ماهیگی باید بچه های رسیده"
    },
    {
      "id": 91,
      "start": 10414.08,
      "end": 10416.08,
      "formatted_start": "02:53:34.080",
      "formatted_end": "02:53:36.080",
      "text": "شیش ماهیگی"
    },
    {
      "id": 92,
      "start": 10416.08,
      "end": 10419.46,
      "formatted_start": "02:53:36.080",
      "formatted_end": "02:53:39.460",
      "text": "بعد یه سری چیز ها اون شده معمول واکسنه بچه میگن"
    },
    {
      "id": 93,
      "start": 10419.46,
      "end": 10421.94,
      "formatted_start": "02:53:39.460",
      "formatted_end": "02:53:41.940",
      "text": "میگن مثلا واکسن نزنین"
    },
    {
      "id": 94,
      "start": 10421.94,
      "end": 10423.44,
      "formatted_start": "02:53:41.940",
      "formatted_end": "02:53:43.440",
      "text": "نه این ها کیلیه؟"
    },
    {
      "id": 95,
      "start": 10423.44,
      "end": 10424.94,
      "formatted_start": "02:53:43.440",
      "formatted_end": "02:53:44.940",
      "text": "کدام فلکی کلیبه"
    },
    {
      "id": 96,
      "start": 10424.94,
      "end": 10426.44,
      "formatted_start": "02:53:44.940",
      "formatted_end": "02:53:46.440",
      "text": "داخل فضای مجازی خیلیه"
    },
    {
      "id": 97,
      "start": 10426.44,
      "end": 10428.44,
      "formatted_start": "02:53:46.440",
      "formatted_end": "02:53:48.440",
      "text": "اونها خیلیه اون فضای مجازی کیه؟"
    },
    {
      "id": 98,
      "start": 10428.44,
      "end": 10432.44,
      "formatted_start": "02:53:48.440",
      "formatted_end": "02:53:52.440",
      "text": "این بچه همیشه اینکیلیب درست میکنه وکسن نزنی"
    },
    {
      "id": 99,
      "start": 10432.44,
      "end": 10433.44,
      "formatted_start": "02:53:52.440",
      "formatted_end": "02:53:53.440",
      "text": "باعثه"
    },
    {
      "id": 100,
      "start": 10433.44,
      "end": 10435.44,
      "formatted_start": "02:53:53.440",
      "formatted_end": "02:53:55.440",
      "text": "کل دنیا داره وکسن میزاره"
    },
    {
      "id": 101,
      "start": 10435.44,
      "end": 10438.44,
      "formatted_start": "02:53:55.440",
      "formatted_end": "02:53:58.440",
      "text": "شبکه های فزشگی طبیعی داره سعیبیه"
    },
    {
      "id": 102,
      "start": 10438.44,
      "end": 10442.94,
      "formatted_start": "02:53:58.440",
      "formatted_end": "02:54:02.940",
      "text": "با همین زدنه وکسنها جرای مرکبیه اطفال گرفته شد"
    },
    {
      "id": 103,
      "start": 10442.94,
      "end": 10446.44,
      "formatted_start": "02:54:02.940",
      "formatted_end": "02:54:06.440",
      "text": "قبل هم مادر هفته بچه می آوردن ست صد و ست و می مون"
    },
    {
      "id": 104,
      "start": 10446.44,
      "end": 10450.12,
      "formatted_start": "02:54:06.440",
      "formatted_end": "02:54:10.120",
      "text": "چون واکسن آبلیس یا سورفه اینا رو نیم زدم"
    },
    {
      "id": 105,
      "start": 10450.12,
      "end": 10453.96,
      "formatted_start": "02:54:10.120",
      "formatted_end": "02:54:13.960",
      "text": "الان با این واکسنها جلوه مرگ بچه های گرفته شده"
    },
    {
      "id": 106,
      "start": 10453.96,
      "end": 10454.86,
      "formatted_start": "02:54:13.960",
      "formatted_end": "02:54:14.860",
      "text": "درسته؟"
    },
    {
      "id": 107,
      "start": 10454.86,
      "end": 10457.26,
      "formatted_start": "02:54:14.860",
      "formatted_end": "02:54:17.260",
      "text": "حالا یک کلپکو میگه واکسن نزن؟"
    },
    {
      "id": 108,
      "start": 10457.26,
      "end": 10459.26,
      "formatted_start": "02:54:17.260",
      "formatted_end": "02:54:19.260",
      "text": "نه"
    },
    {
      "id": 109,
      "start": 10459.26,
      "end": 10463.8,
      "formatted_start": "02:54:19.260",
      "formatted_end": "02:54:23.800",
      "text": "اینکه سؤال دیگه هم داشتم"
    },
    {
      "id": 110,
      "start": 10463.8,
      "end": 10467.44,
      "formatted_start": "02:54:23.800",
      "formatted_end": "02:54:27.440",
      "text": "تو فضای مجازی 90 درصد به بالا دروحه"
    },
    {
      "id": 111,
      "start": 10467.44,
      "end": 10470.5,
      "formatted_start": "02:54:27.440",
      "formatted_end": "02:54:30.500",
      "text": "یعنی اصلا هم شدن کارشناس"
    },
    {
      "id": 112,
      "start": 10470.5,
      "end": 10472.5,
      "formatted_start": "02:54:30.500",
      "formatted_end": "02:54:32.500",
      "text": "یه جورم صحبت کنن از ما فیتر"
    },
    {
      "id": 113,
      "start": 10472.5,
      "end": 10475.22,
      "formatted_start": "02:54:32.500",
      "formatted_end": "02:54:35.220",
      "text": "آهنگ هم میزنن صدا شدن میکروفون میزنن"
    },
    {
      "id": 114,
      "start": 10475.22,
      "end": 10482.22,
      "formatted_start": "02:54:35.220",
      "formatted_end": "02:54:42.220",
      "text": "۹۹ درصد دروح آدم های نخاله و کلا شیخنن تو این استگرام اکثرشون ها"
    },
    {
      "id": 115,
      "start": 10482.22,
      "end": 10486.22,
      "formatted_start": "02:54:42.220",
      "formatted_end": "02:54:46.220",
      "text": "نمیگم همشون اکثرشون خودتون یه راقون جواب ببازن؟"
    },
    {
      "id": 116,
      "start": 10486.22,
      "end": 10491.22,
      "formatted_start": "02:54:46.220",
      "formatted_end": "02:54:51.220",
      "text": "خب؟ اینه اغمتون ها همه ماها دست این فضای مجازی ندارن"
    },
    {
      "id": 117,
      "start": 10491.22,
      "end": 10492.22,
      "formatted_start": "02:54:51.220",
      "formatted_end": "02:54:52.220",
      "text": "خب؟"
    },
    {
      "id": 118,
      "start": 10492.22,
      "end": 10493.22,
      "formatted_start": "02:54:52.220",
      "formatted_end": "02:54:53.220",
      "text": "اینو خواستیم بگیرم"
    },
    {
      "id": 119,
      "start": 10493.22,
      "end": 10494.22,
      "formatted_start": "02:54:53.220",
      "formatted_end": "02:54:54.220",
      "text": "آره آره آره"
    },
    {
      "id": 120,
      "start": 10494.22,
      "end": 10496.22,
      "formatted_start": "02:54:54.220",
      "formatted_end": "02:54:56.220",
      "text": "جلیلن، نمیگم"
    },
    {
      "id": 121,
      "start": 10496.22,
      "end": 10500.22,
      "formatted_start": "02:54:56.220",
      "formatted_end": "02:55:00.220",
      "text": "الان یه حرفی تو فضای مجازی انداختن همه تو سر مردم"
    }
  ],
  "status": "completed"
}