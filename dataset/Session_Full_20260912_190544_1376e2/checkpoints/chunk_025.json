  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7502.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:02.000",
      "text": "شکر میکنم، را خدمت مرسی کنید."
    },
    {
      "id": 1,
      "start": 7502.0,
      "end": 7504.0,
      "formatted_start": "02:05:02.000",
      "formatted_end": "02:05:04.000",
      "text": "خشک کنم، خدا نگهده."
    },
    {
      "id": 2,
      "start": 7504.0,
      "end": 7506.0,
      "formatted_start": "02:05:04.000",
      "formatted_end": "02:05:06.000",
      "text": "ممنونم، خسته را بید."
    },
    {
      "id": 3,
      "start": 7506.0,
      "end": 7508.0,
      "formatted_start": "02:05:06.000",
      "formatted_end": "02:05:08.000",
      "text": "خامسمی، سه شب دستگاه به آقای برزاکشن بشو."
    },
    {
      "id": 4,
      "start": 7508.0,
      "end": 7510.0,
      "formatted_start": "02:05:08.000",
      "formatted_end": "02:05:10.000",
      "text": "مجرم کردم."
    },
    {
      "id": 5,
      "start": 7510.0,
      "end": 7512.0,
      "formatted_start": "02:05:10.000",
      "formatted_end": "02:05:12.000",
      "text": "خوشید."
    },
    {
      "id": 6,
      "start": 7516.0,
      "end": 7518.0,
      "formatted_start": "02:05:16.000",
      "formatted_end": "02:05:18.000",
      "text": "بفهم."
    },
    {
      "id": 7,
      "start": 7518.0,
      "end": 7520.0,
      "formatted_start": "02:05:18.000",
      "formatted_end": "02:05:20.000",
      "text": "سلامتا شما، خوبه؟"
    },
    {
      "id": 8,
      "start": 7520.0,
      "end": 7522.0,
      "formatted_start": "02:05:20.000",
      "formatted_end": "02:05:22.000",
      "text": "ببستی درم بزرگ داری؟"
    },
    {
      "id": 9,
      "start": 7522.0,
      "end": 7524.0,
      "formatted_start": "02:05:22.000",
      "formatted_end": "02:05:24.000",
      "text": "بزرگ داری؟"
    },
    {
      "id": 10,
      "start": 7524.0,
      "end": 7526.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:26.000",
      "text": "خوبه، ببستی درم بزرگ داری؟"
    },
    {
      "id": 11,
      "start": 7526.0,
      "end": 7528.0,
      "formatted_start": "02:05:26.000",
      "formatted_end": "02:05:28.000",
      "text": "خامسمی؟"
    },
    {
      "id": 12,
      "start": 7528.0,
      "end": 7530.0,
      "formatted_start": "02:05:28.000",
      "formatted_end": "02:05:30.000",
      "text": "و بده از این پایین"
    },
    {
      "id": 13,
      "start": 7530.0,
      "end": 7532.0,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:32.000",
      "text": "صرفه های خیلی برگزاره"
    },
    {
      "id": 14,
      "start": 7532.0,
      "end": 7534.0,
      "formatted_start": "02:05:32.000",
      "formatted_end": "02:05:34.000",
      "text": "صرفه های شدید دیگه؟"
    },
    {
      "id": 15,
      "start": 7534.0,
      "end": 7536.0,
      "formatted_start": "02:05:34.000",
      "formatted_end": "02:05:36.000",
      "text": "کم"
    },
    {
      "id": 16,
      "start": 7536.0,
      "end": 7538.0,
      "formatted_start": "02:05:36.000",
      "formatted_end": "02:05:38.000",
      "text": "آبریزش؟"
    },
    {
      "id": 17,
      "start": 7538.0,
      "end": 7540.0,
      "formatted_start": "02:05:38.000",
      "formatted_end": "02:05:40.000",
      "text": "خیلی کم داره"
    },
    {
      "id": 18,
      "start": 7540.0,
      "end": 7542.0,
      "formatted_start": "02:05:40.000",
      "formatted_end": "02:05:42.000",
      "text": "خسخ سینه؟"
    },
    {
      "id": 19,
      "start": 7542.0,
      "end": 7544.0,
      "formatted_start": "02:05:42.000",
      "formatted_end": "02:05:44.000",
      "text": "چند مایشه؟"
    },
    {
      "id": 20,
      "start": 7544.0,
      "end": 7546.0,
      "formatted_start": "02:05:44.000",
      "formatted_end": "02:05:46.000",
      "text": "شش مایشه"
    },
    {
      "id": 21,
      "start": 7546.0,
      "end": 7548.0,
      "formatted_start": "02:05:46.000",
      "formatted_end": "02:05:48.000",
      "text": "دارو چیزی هم دادی؟"
    },
    {
      "id": 22,
      "start": 7548.0,
      "end": 7550.0,
      "formatted_start": "02:05:48.000",
      "formatted_end": "02:05:50.000",
      "text": "استامینوفان"
    },
    {
      "id": 23,
      "start": 7550.0,
      "end": 7552.0,
      "formatted_start": "02:05:50.000",
      "formatted_end": "02:05:52.000",
      "text": "دارو خوردنش چجوریه؟"
    },
    {
      "id": 24,
      "start": 7552.0,
      "end": 7554.0,
      "formatted_start": "02:05:52.000",
      "formatted_end": "02:05:54.000",
      "text": "شرح خوردن"
    },
    {
      "id": 25,
      "start": 7554.0,
      "end": 7556.0,
      "formatted_start": "02:05:54.000",
      "formatted_end": "02:05:56.000",
      "text": "بزن باید تشکر بزنید"
    },
    {
      "id": 26,
      "start": 7558.0,
      "end": 7563.0,
      "formatted_start": "02:05:58.000",
      "formatted_end": "02:06:03.000",
      "text": "خوب شما این برگاه استی؟ این طرف"
    },
    {
      "id": 27,
      "start": 7563.0,
      "end": 7570.0,
      "formatted_start": "02:06:03.000",
      "formatted_end": "02:06:10.000",
      "text": "سلام آقای سمیت کس میشه؟"
    },
    {
      "id": 28,
      "start": 7570.0,
      "end": 7572.0,
      "formatted_start": "02:06:10.000",
      "formatted_end": "02:06:12.000",
      "text": "مرسی"
    },
    {
      "id": 29,
      "start": 7572.0,
      "end": 7574.0,
      "formatted_start": "02:06:12.000",
      "formatted_end": "02:06:14.000",
      "text": "مرسی آقای سمیت کل"
    },
    {
      "id": 30,
      "start": 7588.0,
      "end": 7590.0,
      "formatted_start": "02:06:28.000",
      "formatted_end": "02:06:30.000",
      "text": "درشون قبر گردیم"
    },
    {
      "id": 31,
      "start": 7595.0,
      "end": 7597.0,
      "formatted_start": "02:06:35.000",
      "formatted_end": "02:06:37.000",
      "text": "باید باشیم اوه محضور"
    },
    {
      "id": 32,
      "start": 7597.0,
      "end": 7613.0,
      "formatted_start": "02:06:37.000",
      "formatted_end": "02:06:53.000",
      "text": "این شامپوهای زد بخارش ایروکس میگیدید کودکان"
    },
    {
      "id": 33,
      "start": 7613.0,
      "end": 7619.0,
      "formatted_start": "02:06:53.000",
      "formatted_end": "02:06:59.000",
      "text": "این شامپوهای زد بخارش سر افغان گیرند و از این همه اگزما دارند"
    },
    {
      "id": 34,
      "start": 7619.0,
      "end": 7625.0,
      "formatted_start": "02:06:59.000",
      "formatted_end": "02:07:05.000",
      "text": "شانپوز یک عقصه زده شونه زده خوارشه سر کدکانه"
    },
    {
      "id": 35,
      "start": 7625.0,
      "end": 7629.0,
      "formatted_start": "02:07:05.000",
      "formatted_end": "02:07:09.000",
      "text": "خب هانسمی این"
    },
    {
      "id": 36,
      "start": 7629.0,
      "end": 7631.0,
      "formatted_start": "02:07:09.000",
      "formatted_end": "02:07:11.000",
      "text": "بله"
    },
    {
      "id": 37,
      "start": 7631.0,
      "end": 7633.0,
      "formatted_start": "02:07:11.000",
      "formatted_end": "02:07:13.000",
      "text": "پیسیه بکن"
    },
    {
      "id": 38,
      "start": 7633.0,
      "end": 7635.0,
      "formatted_start": "02:07:13.000",
      "formatted_end": "02:07:15.000",
      "text": "من دارو بلاشونی نیستم"
    },
    {
      "id": 39,
      "start": 7635.0,
      "end": 7639.0,
      "formatted_start": "02:07:15.000",
      "formatted_end": "02:07:19.000",
      "text": "شعبتاش رو زده بار باشه با مربع خوری"
    },
    {
      "id": 40,
      "start": 7639.0,
      "end": 7641.0,
      "formatted_start": "02:07:19.000",
      "formatted_end": "02:07:21.000",
      "text": "اگه خیلی همچیزه یک دوت آنکول بینیسن"
    },
    {
      "id": 41,
      "start": 7641.0,
      "end": 7643.0,
      "formatted_start": "02:07:21.000",
      "formatted_end": "02:07:23.000",
      "text": "نه آنکول نه"
    },
    {
      "id": 42,
      "start": 7643.0,
      "end": 7645.0,
      "formatted_start": "02:07:23.000",
      "formatted_end": "02:07:25.000",
      "text": "شعبتاش بزرگ هم واسه بزرگ آنکول زودتر بکن شد"
    },
    {
      "id": 43,
      "start": 7645.0,
      "end": 7647.0,
      "formatted_start": "02:07:25.000",
      "formatted_end": "02:07:27.000",
