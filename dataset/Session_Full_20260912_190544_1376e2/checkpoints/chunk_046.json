  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13829.98,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 13830.0,
      "end": 13832.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:32.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 13860.0,
      "end": 13889.98,
      "formatted_start": "03:51:00.000",
      "formatted_end": "03:51:29.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 3,
      "start": 13890.0,
      "end": 13892.0,
      "formatted_start": "03:51:30.000",
      "formatted_end": "03:51:32.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 13920.0,
      "end": 13940.0,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:20.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 13940.0,
      "end": 13969.98,
      "formatted_start": "03:52:20.000",
      "formatted_end": "03:52:49.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 6,
      "start": 13970.0,
      "end": 13990.0,
      "formatted_start": "03:52:50.000",
      "formatted_end": "03:53:10.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 14000.0,
      "end": 14004.0,
      "formatted_start": "03:53:20.000",
      "formatted_end": "03:53:24.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 14030.0,
      "end": 14033.0,
      "formatted_start": "03:53:50.000",
      "formatted_end": "03:53:53.000",
      "text": "زمانی که چرا ثابت شد یعنی کتبه"
    },
    {
      "id": 9,
      "start": 14033.0,
      "end": 14036.0,
      "formatted_start": "03:53:53.000",
      "formatted_end": "03:53:56.000",
      "text": "و همینجور توی دو ماهی وردی رو به تقریب انجام داره"
    },
    {
      "id": 10,
      "start": 14040.0,
      "end": 14042.0,
      "formatted_start": "03:54:00.000",
      "formatted_end": "03:54:02.000",
      "text": "این از یک متکوکیه که ما انجام داریم"
    },
    {
      "id": 11,
      "start": 14043.0,
      "end": 14048.0,
      "formatted_start": "03:54:03.000",
      "formatted_end": "03:54:08.000",
      "text": "مولانا یه نصیحت داره، میگه سه تا چیز رو نظر مردم بفهمن"
    },
    {
      "id": 12,
      "start": 14048.0,
      "end": 14051.0,
      "formatted_start": "03:54:08.000",
      "formatted_end": "03:54:11.000",
      "text": "عجیب اینه که کل نصیحتشون در یه رجال داره"
    },
    {
      "id": 13,
      "start": 14051.0,
      "end": 14054.0,
      "formatted_start": "03:54:11.000",
      "formatted_end": "03:54:14.000",
      "text": "و عجیب تر میگه برای توصیف رو موضوع داشت"
    },
    {
      "id": 14,
      "start": 14054.0,
      "end": 14057.0,
      "formatted_start": "03:54:14.000",
      "formatted_end": "03:54:17.000",
      "text": "و سه تا کلمه همه مانو باید استفاده شد"
    },
    {
      "id": 15,
      "start": 14057.0,
      "end": 14065.06,
      "formatted_start": "03:54:17.000",
      "formatted_end": "03:54:25.060",
      "text": "میگه در بیان این سه کم جمع لبط از زهاب و از زهب و از مذهب"
    },
    {
      "id": 16,
      "start": 14065.06,
      "end": 14068.44,
      "formatted_start": "03:54:25.060",
      "formatted_end": "03:54:28.440",
      "text": "میگه در همه مورد سه تا چیز ما مردم صحبت ندید"
    },
    {
      "id": 17,
      "start": 14068.44,
      "end": 14071.4,
      "formatted_start": "03:54:28.440",
      "formatted_end": "03:54:31.400",
      "text": "نزار مردم از کار توی سه تا چیز سرده دیگرم"
    },
    {
      "id": 18,
      "start": 14071.4,
      "end": 14073.4,
      "formatted_start": "03:54:31.400",
      "formatted_end": "03:54:33.400",
      "text": "زهاب و زهب و مذهب"
    },
    {
      "id": 19,
      "start": 14073.4,
      "end": 14075.0,
      "formatted_start": "03:54:33.400",
      "formatted_end": "03:54:35.000",
      "text": "اما این سه تا چی؟"
    },
    {
      "id": 20,
      "start": 14075.7,
      "end": 14078.58,
      "formatted_start": "03:54:35.700",
      "formatted_end": "03:54:38.580",
      "text": "میدی میگن وسیله عیاب و زهاب برا همه"
    },
    {
      "id": 21,
      "start": 14078.58,
      "end": 14081.0,
      "formatted_start": "03:54:38.580",
      "formatted_end": "03:54:41.000",
      "text": "عیاب به نومدن زهاب به نفت"
    },
    {
      "id": 22,
      "start": 14081.0,
      "end": 14084.38,
      "formatted_start": "03:54:41.000",
      "formatted_end": "03:54:44.380",
      "text": "از زهاب یعنی مسیلی که تو زندگی میخوای بری"
    },
    {
      "id": 23,
      "start": 14084.38,
      "end": 14086.76,
      "formatted_start": "03:54:44.380",
      "formatted_end": "03:54:46.760",
      "text": "یعنی هدفی که تو سرد"
    },
    {
      "id": 24,
      "start": 14086.76,
      "end": 14089.52,
      "formatted_start": "03:54:46.760",
      "formatted_end": "03:54:49.520",
      "text": "زهب یعنی تلا یا سروت"
    },
    {
      "id": 25,
      "start": 14089.52,
      "end": 14092.82,
      "formatted_start": "03:54:49.520",
      "formatted_end": "03:54:52.820",
      "text": "چرا همیشه زهب یعنی رفتنه؟"
    },
    {
      "id": 26,
      "start": 14092.82,
      "end": 14094.58,
      "formatted_start": "03:54:52.820",
      "formatted_end": "03:54:54.580",
      "text": "چون سروت رفتنیه"
    },
    {
      "id": 27,
      "start": 14094.58,
      "end": 14095.46,
      "formatted_start": "03:54:54.580",
      "formatted_end": "03:54:55.460",
      "text": "نمیدونی"
    },
    {
      "id": 28,
      "start": 14095.46,
      "end": 14097.88,
      "formatted_start": "03:54:55.460",
      "formatted_end": "03:54:57.880",
      "text": "مذهب هم یعنی اعتقادات"
    },
    {
      "id": 29,
      "start": 14097.88,
      "end": 14099.94,
      "formatted_start": "03:54:57.880",
      "formatted_end": "03:54:59.940",
      "text": "رایی که اعتقاد دارید درسته"
    }
  ],
  "status": "completed"
}