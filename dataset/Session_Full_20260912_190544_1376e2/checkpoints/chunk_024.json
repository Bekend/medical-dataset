  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7206.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:06.000",
      "text": "بله، الان هم شما خوشموقه آوردید. بله، یعنی به قدر بودید."
    },
    {
      "id": 1,
      "start": 7208.0,
      "end": 7214.0,
      "formatted_start": "02:00:08.000",
      "formatted_end": "02:00:14.000",
      "text": "آقای بزرگشان، جان، هر از همین بزرگ وضع وضعیت تو امیمیش خوبه بچه، همین امیمیش مشاهده بود."
    },
    {
      "id": 2,
      "start": 7214.0,
      "end": 7229.0,
      "formatted_start": "02:00:14.000",
      "formatted_end": "02:00:29.000",
      "text": "سالمه، خوب، ولی دردیشو دستگاه بردید. آقای بازدره هم بیمار. آقای بازدره همه آلوگیتو نام باره، تا شمبه دستگاه بردید، بله، بله، یه خونسی هم میریسم."
    },
    {
      "id": 3,
      "start": 7229.0,
      "end": 7236.4,
      "formatted_start": "02:00:29.000",
      "formatted_end": "02:00:36.400",
      "text": "اینکه زیر دستگاه باید ناستاد بی غرام بود صبح و شب یک چار رو تو آب حل کنیم به بچه بدین"
    },
    {
      "id": 4,
      "start": 7236.4,
      "end": 7241.2,
      "formatted_start": "02:00:36.400",
      "formatted_end": "02:00:41.200",
      "text": "دمای اتاق رو بیسته هشت درجه نگه دارید چون گرم هوا"
    },
    {
      "id": 5,
      "start": 7241.2,
      "end": 7243.4,
      "formatted_start": "02:00:41.200",
      "formatted_end": "02:00:43.400",
      "text": "الان نیمیدونی چی کار کنید"
    },
    {
      "id": 6,
      "start": 7243.4,
      "end": 7244.4,
      "formatted_start": "02:00:43.400",
      "formatted_end": "02:00:44.400",
      "text": "نه نیمیدونی"
    },
    {
      "id": 7,
      "start": 7244.4,
      "end": 7248.9,
      "formatted_start": "02:00:44.400",
      "formatted_end": "02:00:48.900",
      "text": "در نتیجه بسیار رو بیسته هشت، بیسته هفت، بیسته نو، اینا باشه"
    },
    {
      "id": 8,
      "start": 7248.9,
      "end": 7249.9,
      "formatted_start": "02:00:48.900",
      "formatted_end": "02:00:49.900",
      "text": "بیسته هفت و بیسته نو"
    },
    {
      "id": 9,
      "start": 7249.9,
      "end": 7251.4,
      "formatted_start": "02:00:49.900",
      "formatted_end": "02:00:51.400",
      "text": "آره بیسته هشت بکرین"
    },
    {
      "id": 10,
      "start": 7251.4,
      "end": 7255.06,
      "formatted_start": "02:00:51.400",
      "formatted_end": "02:00:55.060",
      "text": "شما این دماغ باشه، لخت هم باشه، زیر دستگاه هم باشه، یکی هم نمیشه"
    },
    {
      "id": 11,
      "start": 7255.06,
      "end": 7258.64,
      "formatted_start": "02:00:55.060",
      "formatted_end": "02:00:58.640",
      "text": "چون اگه گرد باشه بی غراب میشه، سرد هم باشه، ولی بچه خوب نیست"
    },
    {
      "id": 12,
      "start": 7258.64,
      "end": 7260.16,
      "formatted_start": "02:00:58.640",
      "formatted_end": "02:01:00.160",
      "text": "خب، منه؟"
    },
    {
      "id": 13,
      "start": 7260.16,
      "end": 7263.48,
      "formatted_start": "02:01:00.160",
      "formatted_end": "02:01:03.480",
      "text": "این قرصت دارو خواهد میگید دستگاه هم بمونشید، میگید تا شمبه بگید"
    },
    {
      "id": 14,
      "start": 7263.48,
      "end": 7268.2,
      "formatted_start": "02:01:03.480",
      "formatted_end": "02:01:08.200",
      "text": "به طور، این مرتبهش گفتید، سیاه میروند"
    },
    {
      "id": 15,
      "start": 7268.2,
      "end": 7269.52,
      "formatted_start": "02:01:08.200",
      "formatted_end": "02:01:09.520",
      "text": "نه، خونش کاره، مثل قیبه"
    },
    {
      "id": 16,
      "start": 7269.52,
      "end": 7270.2,
      "formatted_start": "02:01:09.520",
      "formatted_end": "02:01:10.200",
      "text": "آفتاره"
    },
    {
      "id": 17,
      "start": 7270.2,
      "end": 7271.16,
      "formatted_start": "02:01:10.200",
      "formatted_end": "02:01:11.160",
      "text": "صفت بودنش رو میشه؟"
    },
    {
      "id": 18,
      "start": 7271.16,
      "end": 7274.32,
      "formatted_start": "02:01:11.160",
      "formatted_end": "02:01:14.320",
      "text": "نه مثل کسبنده ای، باید از این جوانس قیله"
    },
    {
      "id": 19,
      "start": 7274.32,
      "end": 7277.26,
      "formatted_start": "02:01:14.320",
      "formatted_end": "02:01:17.260",
      "text": "این بد نظیر مدترسه آب میشه، زرد میشه"
    },
    {
      "id": 20,
      "start": 7277.26,
      "end": 7280.32,
      "formatted_start": "02:01:17.260",
      "formatted_end": "02:01:20.320",
      "text": "نه اینو طبیعا داریم، مثلا چهار پنج روزی این حالت هستیم"
    },
    {
      "id": 21,
      "start": 7280.32,
      "end": 7280.92,
      "formatted_start": "02:01:20.320",
      "formatted_end": "02:01:20.920",
      "text": "درست"
    },
    {
      "id": 22,
      "start": 7280.92,
      "end": 7281.92,
      "formatted_start": "02:01:20.920",
      "formatted_end": "02:01:21.920",
      "text": "دیگران نباشید"
    },
    {
      "id": 23,
      "start": 7281.92,
      "end": 7284.4,
      "formatted_start": "02:01:21.920",
      "formatted_end": "02:01:24.400",
      "text": "نه چکره، پس اینو الان دست کنه تا شمبه"
    },
    {
      "id": 24,
      "start": 7284.4,
      "end": 7285.66,
      "formatted_start": "02:01:24.400",
      "formatted_end": "02:01:25.660",
      "text": "بله بله تا شمبه"
    },
    {
      "id": 25,
      "start": 7285.66,
      "end": 7287.06,
      "formatted_start": "02:01:25.660",
      "formatted_end": "02:01:27.060",
      "text": "میانتی با آزمایش چیز نداری؟"
    },
    {
      "id": 26,
      "start": 7287.06,
      "end": 7288.66,
      "formatted_start": "02:01:27.060",
      "formatted_end": "02:01:28.660",
      "text": "نه نمیخواد"
    },
    {
      "id": 27,
      "start": 7288.66,
      "end": 7289.86,
      "formatted_start": "02:01:28.660",
      "formatted_end": "02:01:29.860",
      "text": "قدرش هم اوکی بوده؟"
    },
    {
      "id": 28,
      "start": 7289.86,
      "end": 7291.82,
      "formatted_start": "02:01:29.860",
      "formatted_end": "02:01:31.820",
      "text": "۵۵ لبه مرسی بود من دیدم"
    },
    {
      "id": 29,
      "start": 7291.82,
      "end": 7292.16,
      "formatted_start": "02:01:31.820",
      "formatted_end": "02:01:32.160",
      "text": "آه"
    },
    {
      "id": 30,
      "start": 7292.16,
      "end": 7293.58,
      "formatted_start": "02:01:32.160",
      "formatted_end": "02:01:33.580",
      "text": "۵۵ بود خوبش"
    },
    {
      "id": 31,
      "start": 7293.58,
      "end": 7295.58,
      "formatted_start": "02:01:33.580",
      "formatted_end": "02:01:35.580",
      "text": "الان شیر خوب میخوره"
    },
    {
      "id": 32,
      "start": 7295.58,
      "end": 7298.0,
      "formatted_start": "02:01:35.580",
      "formatted_end": "02:01:38.000",
      "text": "مادرش دیابت که نداشته دوران باران"
    },
    {
      "id": 33,
      "start": 7298.0,
      "end": 7299.36,
      "formatted_start": "02:01:38.000",
      "formatted_end": "02:01:39.360",
      "text": "دوران بارداری داشتن"
    },
    {
      "id": 34,
      "start": 7299.36,
      "end": 7301.36,
      "formatted_start": "02:01:39.360",
      "formatted_end": "02:01:41.360",
      "text": "بعدش دیگه توی بیمارستان چک کردن"
    },
    {
      "id": 35,
      "start": 7301.36,
      "end": 7302.04,
      "formatted_start": "02:01:41.360",
      "formatted_end": "02:01:42.040",
      "text": "هم گفتم سکر"
    },
    {
      "id": 36,
      "start": 7302.04,
      "end": 7304.16,
      "formatted_start": "02:01:42.040",
      "formatted_end": "02:01:44.160",
      "text": "نگه داشتن یه روز بخاطر امی که چک بشن"
    },
    {
      "id": 37,
      "start": 7304.16,
      "end": 7304.96,
      "formatted_start": "02:01:44.160",
      "formatted_end": "02:01:44.960",
      "text": "خب پردردن"
    },
    {
      "id": 38,
      "start": 7304.96,
      "end": 7306.08,
      "formatted_start": "02:01:44.960",
      "formatted_end": "02:01:46.080",
      "text": "قند پایین نداشتن"
    },
    {
      "id": 39,
      "start": 7306.08,
      "end": 7307.4,
      "formatted_start": "02:01:46.080",
      "formatted_end": "02:01:47.400",
      "text": "اگر قند پایین میفتاد"
    },
    {
      "id": 40,
      "start": 7307.4,
      "end": 7308.92,
      "formatted_start": "02:01:47.400",
      "formatted_end": "02:01:48.920",
      "text": "پشن نوشن گرد بچه"
    },
    {
      "id": 41,
      "start": 7308.92,
      "end": 7310.82,
      "formatted_start": "02:01:48.920",
      "formatted_end": "02:01:50.820",
      "text": "شیر اینا پیشتر دیدید"
    },
    {
      "id": 42,
      "start": 7310.82,
      "end": 7313.16,
      "formatted_start": "02:01:50.820",
      "formatted_end": "02:01:53.160",
      "text": "اگه شده یکم آب قندی چیزی آراد"
    },
    {
      "id": 43,
      "start": 7313.16,
      "end": 7316.36,
      "formatted_start": "02:01:53.160",
      "formatted_end": "02:01:56.360",
      "text": "معمولا تو چه لحظه های اول مرزا افتخان میده"
    },
    {
      "id": 44,
      "start": 7316.38,
      "end": 7317.66,
      "formatted_start": "02:01:56.380",
      "formatted_end": "02:01:57.660",
      "text": "بعد از چه لحظه های این مرحله..."
    },
    {
      "id": 45,
      "start": 7317.68,
      "end": 7319.16,
      "formatted_start": "02:01:57.680",
      "formatted_end": "02:01:59.160",
      "text": "از توش هاستن نگهش داشتن"
    },
    {
      "id": 46,
      "start": 7319.18,
      "end": 7321.4,
      "formatted_start": "02:01:59.180",
      "formatted_end": "02:02:01.400",
      "text": "خب اونو نگه داشتن، آزمایش هم اتمادن بازید"
    },
    {
      "id": 47,
      "start": 7321.42,
      "end": 7322.78,
      "formatted_start": "02:02:01.420",
      "formatted_end": "02:02:02.780",
      "text": "بله آزمایش گرفتن"
    },
    {
      "id": 48,
      "start": 7322.8,
      "end": 7324.34,
      "formatted_start": "02:02:02.800",
      "formatted_end": "02:02:04.340",
      "text": "نه، اون از اون پریده"
    },
    {
      "id": 49,
      "start": 7324.36,
      "end": 7325.32,
      "formatted_start": "02:02:04.360",
      "formatted_end": "02:02:05.320",
      "text": "پریده، آره؟"
    },
    {
      "id": 50,
      "start": 7325.34,
      "end": 7326.14,
      "formatted_start": "02:02:05.340",
      "formatted_end": "02:02:06.140",
      "text": "سلامانتی"
    },
    {
      "id": 51,
      "start": 7326.16,
      "end": 7329.08,
      "formatted_start": "02:02:06.160",
      "formatted_end": "02:02:09.080",
      "text": "آره، لعنت کنه بوم زادمی"
    },
    {
      "id": 52,
      "start": 7329.1,
      "end": 7330.1,
      "formatted_start": "02:02:09.100",
      "formatted_end": "02:02:10.100",
      "text": "آره"
    },
    {
      "id": 53,
      "start": 7330.12,
      "end": 7332.26,
      "formatted_start": "02:02:10.120",
      "formatted_end": "02:02:12.260",
      "text": "دستگاه هم چون میخواد بر روشن کنن"
    },
    {
      "id": 54,
      "start": 7332.28,
      "end": 7334.76,
      "formatted_start": "02:02:12.280",
      "formatted_end": "02:02:14.760",
      "text": "نه، البته بالا تست کردیم اینو"
    },
    {
      "id": 55,
      "start": 7334.76,
      "end": 7336.76,
      "formatted_start": "02:02:14.760",
      "formatted_end": "02:02:16.760",
      "text": "بخواهم سمیت چیز کنه تمام کنید"
    },
    {
      "id": 56,
      "start": 7336.76,
      "end": 7338.76,
      "formatted_start": "02:02:16.760",
      "formatted_end": "02:02:18.760",
      "text": "خوب بخواهی رو گفتنی"
    },
    {
      "id": 57,
      "start": 7338.76,
      "end": 7340.76,
      "formatted_start": "02:02:18.760",
      "formatted_end": "02:02:20.760",
      "text": "دستگاه"
    },
    {
      "id": 58,
      "start": 7340.76,
      "end": 7342.76,
      "formatted_start": "02:02:20.760",
      "formatted_end": "02:02:22.760",
      "text": "یه دستگاه خوب ببرید"
    },
    {
      "id": 59,
      "start": 7342.76,
      "end": 7344.76,
      "formatted_start": "02:02:22.760",
      "formatted_end": "02:02:24.760",
      "text": "خوب هم استفاده کن خوب"
    },
    {
      "id": 60,
      "start": 7344.76,
      "end": 7346.76,
      "formatted_start": "02:02:24.760",
      "formatted_end": "02:02:26.760",
      "text": "تو خونه شاید"
    },
    {
      "id": 61,
      "start": 7346.76,
      "end": 7348.76,
      "formatted_start": "02:02:26.760",
      "formatted_end": "02:02:28.760",
      "text": "یه سری دکترهای خونگیه هستن"
    },
    {
      "id": 62,
      "start": 7348.76,
      "end": 7350.76,
      "formatted_start": "02:02:28.760",
      "formatted_end": "02:02:30.760",
      "text": "خیلی هستن"
    },
    {
      "id": 63,
      "start": 7350.76,
      "end": 7352.76,
      "formatted_start": "02:02:30.760",
      "formatted_end": "02:02:32.760",
      "text": "زنهای خیلی متخصص"
    },
    {
      "id": 64,
      "start": 7352.76,
      "end": 7354.76,
      "formatted_start": "02:02:32.760",
      "formatted_end": "02:02:34.760",
      "text": "هرکی میاد یه حرفی میزنه"
    },
    {
      "id": 65,
      "start": 7354.76,
      "end": 7356.76,
      "formatted_start": "02:02:34.760",
      "formatted_end": "02:02:36.760",
      "text": "پیشتون میکنه"
    },
    {
      "id": 66,
      "start": 7356.76,
      "end": 7358.76,
      "formatted_start": "02:02:36.760",
      "formatted_end": "02:02:38.760",
      "text": "یکی میگه مادرش کره نخوره"
    },
    {
      "id": 67,
      "start": 7358.76,
      "end": 7360.76,
      "formatted_start": "02:02:38.760",
      "formatted_end": "02:02:40.760",
      "text": "نمیدونم روغن زرد نخوره"
    },
    {
      "id": 68,
      "start": 7360.76,
      "end": 7362.76,
      "formatted_start": "02:02:40.760",
      "formatted_end": "02:02:42.760",
      "text": "زفران نخوره"
    },
    {
      "id": 69,
      "start": 7362.76,
      "end": 7364.76,
      "formatted_start": "02:02:42.760",
      "formatted_end": "02:02:44.760",
      "text": "این ها هیچ تاثیری نداره"
    },
    {
      "id": 70,
      "start": 7364.76,
      "end": 7366.76,
      "formatted_start": "02:02:44.760",
      "formatted_end": "02:02:46.760",
      "text": "یعنی غذای مادر راحت باشه"
    },
    {
      "id": 71,
      "start": 7366.76,
      "end": 7368.76,
      "formatted_start": "02:02:46.760",
      "formatted_end": "02:02:48.760",
      "text": "غذا هیچ تاثیری نداره"
    },
    {
      "id": 72,
      "start": 7368.76,
      "end": 7370.76,
      "formatted_start": "02:02:48.760",
      "formatted_end": "02:02:50.760",
      "text": "نیمیدونه میگن یه لامپه مطبعی باشم"
    },
    {
      "id": 73,
      "start": 7370.76,
      "end": 7372.76,
      "formatted_start": "02:02:50.760",
      "formatted_end": "02:02:52.760",
      "text": "هیچ تاثیری نداره این لامپایی نخواسته"
    },
    {
      "id": 74,
      "start": 7372.76,
      "end": 7374.76,
      "formatted_start": "02:02:52.760",
      "formatted_end": "02:02:54.760",
      "text": "و اصلا هر فرقی که خانه میزنه"
    },
    {
      "id": 75,
      "start": 7374.76,
      "end": 7376.76,
      "formatted_start": "02:02:54.760",
      "formatted_end": "02:02:56.760",
      "text": "این رو توجه نداره"
    },
    {
      "id": 76,
      "start": 7376.76,
      "end": 7378.76,
      "formatted_start": "02:02:56.760",
      "formatted_end": "02:02:58.760",
      "text": "حالا این با فرمان هنو جدا نگهده"
    },
    {
      "id": 77,
      "start": 7378.76,
      "end": 7380.76,
      "formatted_start": "02:02:58.760",
      "formatted_end": "02:03:00.760",
      "text": "تمام"
    },
    {
      "id": 78,
      "start": 7380.76,
      "end": 7382.76,
      "formatted_start": "02:03:00.760",
      "formatted_end": "02:03:02.760",
      "text": "ما شمبه اشنا دوباره"
    },
    {
      "id": 79,
      "start": 7382.76,
      "end": 7384.76,
      "formatted_start": "02:03:02.760",
      "formatted_end": "02:03:04.760",
      "text": "خوب اشنا سیفیدش کنیم"
    },
    {
      "id": 80,
      "start": 7384.76,
      "end": 7386.76,
      "formatted_start": "02:03:04.760",
      "formatted_end": "02:03:06.760",
      "text": "با امیدوارم"
    },
    {
      "id": 81,
      "start": 7386.76,
      "end": 7388.76,
      "formatted_start": "02:03:06.760",
      "formatted_end": "02:03:08.760",
      "text": "درست کنیم"
    },
    {
      "id": 82,
      "start": 7388.76,
      "end": 7392.76,
      "formatted_start": "02:03:08.760",
      "formatted_end": "02:03:12.760",
      "text": "باید بیاریم شیرده ای بیاریمش بیرون دوباره بزنیم"
    },
    {
      "id": 83,
      "start": 7392.76,
      "end": 7394.76,
      "formatted_start": "02:03:12.760",
      "formatted_end": "02:03:14.760",
      "text": "ببینیم اگه سفید هم بود بزنیم"
    },
    {
      "id": 84,
      "start": 7394.76,
      "end": 7397.76,
      "formatted_start": "02:03:14.760",
      "formatted_end": "02:03:17.760",
      "text": "این اصلا کلا زیاد میخوره"
    },
    {
      "id": 85,
      "start": 7397.76,
      "end": 7400.76,
      "formatted_start": "02:03:17.760",
      "formatted_end": "02:03:20.760",
      "text": "اشکال نداریم این سه تا کار داره"
    },
    {
      "id": 86,
      "start": 7400.76,
      "end": 7402.76,
      "formatted_start": "02:03:20.760",
      "formatted_end": "02:03:22.760",
      "text": "خوابیدن زیاد همش خوابه"
    },
    {
      "id": 87,
      "start": 7402.76,
      "end": 7405.76,
      "formatted_start": "02:03:22.760",
      "formatted_end": "02:03:25.760",
      "text": "خوردن و پیپی کردن"
    },
    {
      "id": 88,
      "start": 7405.76,
      "end": 7410.76,
      "formatted_start": "02:03:25.760",
      "formatted_end": "02:03:30.760",
      "text": "منظورم از زیاد میخوره یعنی اصلا شاید دو ساعت فقط بشست به من"
    },
    {
      "id": 89,
      "start": 7410.76,
      "end": 7412.76,
      "formatted_start": "02:03:30.760",
      "formatted_end": "02:03:32.760",
      "text": "نه اون نیم ساعت که میخوره"
    },
    {
      "id": 90,
      "start": 7412.76,
      "end": 7414.76,
      "formatted_start": "02:03:32.760",
      "formatted_end": "02:03:34.760",
      "text": "از این نیم ساعت"
    },
    {
      "id": 91,
      "start": 7414.76,
      "end": 7417.76,
      "formatted_start": "02:03:34.760",
      "formatted_end": "02:03:37.760",
      "text": "دیگه فایده این از روانی داره مک میزنه"
    },
    {
      "id": 92,
      "start": 7417.76,
      "end": 7419.76,
      "formatted_start": "02:03:37.760",
      "formatted_end": "02:03:39.760",
      "text": "ولی اگه مثلا نیم ساعت خورد"
    },
    {
      "id": 93,
      "start": 7419.76,
      "end": 7422.76,
      "formatted_start": "02:03:39.760",
      "formatted_end": "02:03:42.760",
      "text": "گرفتین دیدین خیلی گریه میکنه شاید شیرت کمه"
    },
    {
      "id": 94,
      "start": 7422.76,
      "end": 7423.76,
      "formatted_start": "02:03:42.760",
      "formatted_end": "02:03:43.760",
      "text": "قندین پایینه"
    },
    {
      "id": 95,
      "start": 7423.76,
      "end": 7426.76,
      "formatted_start": "02:03:43.760",
      "formatted_end": "02:03:46.760",
      "text": "یه مقدار شیرخش درست کنین با شیشه"
    },
    {
      "id": 96,
      "start": 7426.76,
      "end": 7428.76,
      "formatted_start": "02:03:46.760",
      "formatted_end": "02:03:48.760",
      "text": "با شیشه تو دهره بچه نزده"
    },
    {
      "id": 97,
      "start": 7428.76,
      "end": 7430.76,
      "formatted_start": "02:03:48.760",
      "formatted_end": "02:03:50.760",
      "text": "چون بردادر بشه سینه رو نمیگرد"
    },
    {
      "id": 98,
      "start": 7430.76,
      "end": 7433.76,
      "formatted_start": "02:03:50.760",
      "formatted_end": "02:03:53.760",
      "text": "با قاشوق با شیشه که درست کردین بهش بده"
    },
    {
      "id": 99,
      "start": 7433.76,
      "end": 7436.76,
      "formatted_start": "02:03:53.760",
      "formatted_end": "02:03:56.760",
      "text": "اگه نیم ساعت دادی دیدین بازم سینه میخواد گریه میکنه"
    },
    {
      "id": 100,
      "start": 7436.76,
      "end": 7443.26,
      "formatted_start": "02:03:56.760",
      "formatted_end": "02:04:03.260",
      "text": "شما شیخش و کمکی رو بهش میدید اگه مثلا خورد و بعد دینا آروم شد خوابی نیمی برده"
    },
    {
      "id": 101,
      "start": 7443.26,
      "end": 7445.26,
      "formatted_start": "02:04:03.260",
      "formatted_end": "02:04:05.260",
      "text": "این کفاخ نکرده اینا"
    },
    {
      "id": 102,
      "start": 7445.26,
      "end": 7449.76,
      "formatted_start": "02:04:05.260",
      "formatted_end": "02:04:09.760",
      "text": "یه موقع است که سیره ولی میخواد مک بزرگه اون با شیخش کمی نیمی کنه"
    },
    {
      "id": 103,
      "start": 7449.76,
      "end": 7454.76,
      "formatted_start": "02:04:09.760",
      "formatted_end": "02:04:14.760",
      "text": "اها بله این درد هم احتمال بوده برای باکسنش اینا باشه چون بیترار بود باکسنگی داره"
    },
    {
      "id": 104,
      "start": 7454.76,
      "end": 7457.76,
      "formatted_start": "02:04:14.760",
      "formatted_end": "02:04:17.760",
      "text": "نه معمولا درد نداره باکسن زخم میشه اینجا اوفونه"
    },
    {
      "id": 105,
      "start": 7457.76,
      "end": 7460.76,
      "formatted_start": "02:04:17.760",
      "formatted_end": "02:04:20.760",
      "text": "اینجوری از اینجوری خیلی بیقراره میکنه"
    },
    {
      "id": 106,
      "start": 7460.76,
      "end": 7465.76,
      "formatted_start": "02:04:20.760",
      "formatted_end": "02:04:25.760",
      "text": "پایشو میکشید اینا حالت رو پر باقیه"
    },
    {
      "id": 107,
      "start": 7465.76,
      "end": 7469.76,
      "formatted_start": "02:04:25.760",
      "formatted_end": "02:04:29.760",
      "text": "پای رو تو زمان رحم جمع بوده"
    },
    {
      "id": 108,
      "start": 7469.76,
      "end": 7472.76,
      "formatted_start": "02:04:29.760",
      "formatted_end": "02:04:32.760",
      "text": "پای رو یکم میکشید که لاستیکش بوده جیب میزن"
    },
    {
      "id": 109,
      "start": 7472.76,
      "end": 7474.76,
      "formatted_start": "02:04:32.760",
      "formatted_end": "02:04:34.760",
      "text": "باید یه چیزی هم که هست"
    },
    {
      "id": 110,
      "start": 7474.76,
      "end": 7477.76,
      "formatted_start": "02:04:34.760",
      "formatted_end": "02:04:37.760",
      "text": "گنداخ نمیکنیمش بلی موقع خواب میبندیمش دستو پشن"
    },
    {
      "id": 111,
      "start": 7477.76,
      "end": 7480.76,
      "formatted_start": "02:04:37.760",
      "formatted_end": "02:04:40.760",
      "text": "اشکال نداره بعضی فشار میبندن آروم میشه"
    },
    {
      "id": 112,
      "start": 7480.76,
      "end": 7482.76,
      "formatted_start": "02:04:40.760",
      "formatted_end": "02:04:42.760",
      "text": "اونا دو دفعه این کار رو بگیرم"
    },
    {
      "id": 113,
      "start": 7482.76,
      "end": 7483.76,
      "formatted_start": "02:04:42.760",
      "formatted_end": "02:04:43.760",
      "text": "اشکال نداره"
    },
    {
      "id": 114,
      "start": 7483.76,
      "end": 7487.26,
      "formatted_start": "02:04:43.760",
      "formatted_end": "02:04:47.260",
