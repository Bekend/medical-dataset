    {
      "id": 11,
      "start": 6202.0,
      "end": 6204.0,
      "formatted_start": "01:43:22.000",
      "formatted_end": "01:43:24.000",
      "text": "بفرما"
    },
    {
      "id": 12,
      "start": 6204.0,
      "end": 6206.0,
      "formatted_start": "01:43:24.000",
      "formatted_end": "01:43:26.000",
      "text": "سلام خوبستی"
    },
    {
      "id": 13,
      "start": 6206.0,
      "end": 6208.0,
      "formatted_start": "01:43:26.000",
      "formatted_end": "01:43:28.000",
      "text": "چی شده با جو؟"
    },
    {
      "id": 14,
      "start": 6208.0,
      "end": 6210.0,
      "formatted_start": "01:43:28.000",
      "formatted_end": "01:43:30.000",
      "text": "این از دیروز همه چیز سرفه میکنه"
    },
    {
      "id": 15,
      "start": 6210.0,
      "end": 6212.0,
      "formatted_start": "01:43:30.000",
      "formatted_end": "01:43:32.000",
      "text": "برگتونو بزن کنی؟"
    },
    {
      "id": 16,
      "start": 6212.0,
      "end": 6214.0,
      "formatted_start": "01:43:32.000",
      "formatted_end": "01:43:34.000",
      "text": "از دیروز سرفه میزنه"
    },
    {
      "id": 17,
      "start": 6214.0,
      "end": 6216.0,
      "formatted_start": "01:43:34.000",
      "formatted_end": "01:43:36.000",
      "text": "بی حال"
    },
    {
      "id": 18,
      "start": 6216.0,
      "end": 6218.0,
      "formatted_start": "01:43:36.000",
      "formatted_end": "01:43:38.000",
      "text": "سرفه که نخواهی"
    },
    {
      "id": 19,
      "start": 6218.0,
      "end": 6220.0,
      "formatted_start": "01:43:38.000",
      "formatted_end": "01:43:40.000",
      "text": "سمبوکن نمایی"
    },
    {
      "id": 20,
      "start": 6220.0,
      "end": 6222.0,
      "formatted_start": "01:43:40.000",
      "formatted_end": "01:43:42.000",
      "text": "سرفه داره دیگه"
    },
    {
      "id": 21,
      "start": 6222.0,
      "end": 6224.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:44.000",
      "text": "برگتونو بزن کنی؟"
    },
    {
      "id": 22,
