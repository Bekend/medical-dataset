      "id": 51,
      "start": 6284.0,
      "end": 6286.0,
      "formatted_start": "01:44:44.000",
      "formatted_end": "01:44:46.000",
      "text": "کجا میشینی؟"
    },
    {
      "id": 52,
      "start": 6286.0,
      "end": 6288.0,
      "formatted_start": "01:44:46.000",
      "formatted_end": "01:44:48.000",
      "text": "شهرت شده امورتی باشه"
    },
    {
      "id": 53,
      "start": 6288.0,
      "end": 6290.0,
      "formatted_start": "01:44:48.000",
      "formatted_end": "01:44:50.000",
      "text": "شهرت میدیش"
    },
    {
      "id": 54,
      "start": 6290.0,
      "end": 6292.0,
      "formatted_start": "01:44:50.000",
      "formatted_end": "01:44:52.000",
      "text": "اگر دمکنه امورتی باشه باشه بچه بیاره"
