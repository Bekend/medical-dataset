  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8102.72,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:02.720",
      "text": "این بروفن ببین کماشو بیتره یا استاملیفون؟"
    },
    {
      "id": 1,
      "start": 8102.72,
      "end": 8109.72,
      "formatted_start": "02:15:02.720",
      "formatted_end": "02:15:09.720",
      "text": "ببین استاملیفونو چهار ساعت بدید، اگه طبع کنترل نکرد بروفن بدید، بروفن با میده پر بدید، خالی نباشه."
    },
    {
      "id": 2,
      "start": 8109.72,
      "end": 8112.72,
      "formatted_start": "02:15:09.720",
      "formatted_end": "02:15:12.720",
      "text": "بعد اگه مثلا بخوایید یه روز بزرگشت بدید؟"
    },
    {
      "id": 3,
      "start": 8112.72,
      "end": 8114.72,
      "formatted_start": "02:15:12.720",
      "formatted_end": "02:15:14.720",
      "text": "اشکال نداره، همین که استاملیفون."
    },
    {
      "id": 4,
      "start": 8114.72,
      "end": 8115.72,
      "formatted_start": "02:15:14.720",
      "formatted_end": "02:15:15.720",
      "text": "باش. دستتون نرده؟"
    },
    {
      "id": 5,
      "start": 8115.72,
      "end": 8117.72,
      "formatted_start": "02:15:15.720",
      "formatted_end": "02:15:17.720",
      "text": "بخوایش میخوانم خواهد بدم."
    },
    {
      "id": 6,
      "start": 8121.72,
      "end": 8125.72,
      "formatted_start": "02:15:21.720",
      "formatted_end": "02:15:25.720",
      "text": "بنابراین این شروطهاش روزیسته با دیگرستشم هشت ساعت درخواسته."
    },
    {
      "id": 7,
      "start": 8125.72,
      "end": 8127.72,
      "formatted_start": "02:15:25.720",
      "formatted_end": "02:15:27.720",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 8,
      "start": 8127.72,
      "end": 8129.72,
      "formatted_start": "02:15:27.720",
      "formatted_end": "02:15:29.720",
      "text": "باید برداریم"
    },
    {
      "id": 9,
      "start": 8129.72,
      "end": 8131.72,
      "formatted_start": "02:15:29.720",
