  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12027.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:27.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 12030.0,
      "end": 12040.0,
      "formatted_start": "03:20:30.000",
      "formatted_end": "03:20:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 12060.0,
      "end": 12065.68,
      "formatted_start": "03:21:00.000",
      "formatted_end": "03:21:05.680",
      "text": "گفته ما جوری ترمیت شده اینکه خود ما بچه اینه رسولوش میدونیم"
    },
    {
      "id": 3,
      "start": 12065.68,
      "end": 12071.52,
      "formatted_start": "03:21:05.680",
      "formatted_end": "03:21:11.520",
      "text": "نداریم که نداریم که دنبالتی استانگام باشیم"
    },
    {
      "id": 4,
      "start": 12071.52,
      "end": 12077.22,
      "formatted_start": "03:21:11.520",
      "formatted_end": "03:21:17.220",
      "text": "اما بعضی ها هموز نوره بکش به پدرشون کارک نشده"
    },
    {
      "id": 5,
      "start": 12077.22,
      "end": 12080.68,
      "formatted_start": "03:21:17.220",
      "formatted_end": "03:21:20.680",
      "text": "که تمامه شرعه افزا فردن چرخیدم"
    },
    {
      "id": 6,
      "start": 12080.68,
      "end": 12083.64,
      "formatted_start": "03:21:20.680",
      "formatted_end": "03:21:23.640",
      "text": "سرگرد جنگ بردم، بلاهیتی رفتم"
    },
    {
      "id": 7,
      "start": 12083.64,
      "end": 12086.42,
      "formatted_start": "03:21:23.640",
      "formatted_end": "03:21:26.420",
      "text": "تابرو گرفتم، تلایی رفتم و شوهرش"
    },
    {
      "id": 8,
      "start": 12086.42,
      "end": 12106.42,
      "formatted_start": "03:21:26.420",
      "formatted_end": "03:21:46.420",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 12116.42,
      "end": 12136.42,
      "formatted_start": "03:21:56.420",
      "formatted_end": "03:22:16.420",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 12136.42,
      "end": 12156.42,
      "formatted_start": "03:22:16.420",
      "formatted_end": "03:22:36.420",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 12156.42,
      "end": 12168.42,
      "formatted_start": "03:22:36.420",
      "formatted_end": "03:22:48.420",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 12186.42,
      "end": 12188.42,
      "formatted_start": "03:23:06.420",
      "formatted_end": "03:23:08.420",
      "text": "یا آین سازی"
    },
    {
      "id": 13,
      "start": 12188.42,
      "end": 12193.42,
      "formatted_start": "03:23:08.420",
      "formatted_end": "03:23:13.420",
      "text": "وقتی دو نفر از نظر ذکری و اکسیسی با هم همراه کنم"
    },
    {
      "id": 14,
      "start": 12193.42,
      "end": 12197.42,
      "formatted_start": "03:23:13.420",
      "formatted_end": "03:23:17.420",
      "text": "و هم باید بدون اینکه خودتان متوجه باشه"
    },
    {
      "id": 15,
      "start": 12197.42,
      "end": 12201.42,
      "formatted_start": "03:23:17.420",
      "formatted_end": "03:23:21.420",
      "text": "بخشی از زبان بدن طرف محاور رو تملیز کنید"
    },
    {
      "id": 16,
      "start": 12201.42,
      "end": 12208.42,
      "formatted_start": "03:23:21.420",
      "formatted_end": "03:23:28.420",
      "text": "به همین نظر که مذاکره کننده های هردوی باید آنگامانه از این تکیه استفاده می کنند"
    },
    {
      "id": 17,
      "start": 12208.42,
      "end": 12215.42,
      "formatted_start": "03:23:28.420",
      "formatted_end": "03:23:35.420",
      "text": "چون آین سازی میتونه حس اعتماد، همراهی و اعتماد رو اصنایش برده"
    },
    {
      "id": 18,
      "start": 12215.42,
      "end": 12225.42,
      "formatted_start": "03:23:35.420",
      "formatted_end": "03:23:45.420",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 12245.42,
      "end": 12265.42,
      "formatted_start": "03:24:05.420",
      "formatted_end": "03:24:25.420",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 12265.42,
      "end": 12267.42,
      "formatted_start": "03:24:25.420",
      "formatted_end": "03:24:27.420",
      "text": "بخونیم سلام آباجان"
    },
    {
      "id": 21,
      "start": 12267.42,
      "end": 12269.42,
      "formatted_start": "03:24:27.420",
      "formatted_end": "03:24:29.420",
      "text": "سلامت بشیم"
    },
    {
      "id": 22,
      "start": 12269.42,
      "end": 12271.42,
      "formatted_start": "03:24:29.420",
      "formatted_end": "03:24:31.420",
      "text": "کچوری رو تخ بذارم برگیره بله"
    },
    {
      "id": 23,
      "start": 12271.42,
      "end": 12273.42,
      "formatted_start": "03:24:31.420",
      "formatted_end": "03:24:33.420",
      "text": "که حضرت مونشین داده"
    },
    {
      "id": 24,
      "start": 12273.42,
      "end": 12275.42,
      "formatted_start": "03:24:33.420",
      "formatted_end": "03:24:35.420",
      "text": "خوب نیستی"
    },
    {
      "id": 25,
      "start": 12275.42,
      "end": 12277.42,
      "formatted_start": "03:24:35.420",
      "formatted_end": "03:24:37.420",
      "text": "چی شده آی مونگیش؟"
    },
    {
      "id": 26,
      "start": 12277.42,
      "end": 12279.42,
      "formatted_start": "03:24:37.420",
      "formatted_end": "03:24:39.420",
      "text": "بچه سه چار روز دلش"
    },
    {
      "id": 27,
      "start": 12279.42,
      "end": 12281.42,
      "formatted_start": "03:24:39.420",
      "formatted_end": "03:24:41.420",
      "text": "دیگراری داره"
    },
    {
      "id": 28,
      "start": 12281.42,
      "end": 12283.42,
      "formatted_start": "03:24:41.420",
      "formatted_end": "03:24:43.420",
      "text": "میدهش کار نمی کنه"
    },
    {
      "id": 29,
      "start": 12283.42,
      "end": 12285.42,
      "formatted_start": "03:24:43.420",
      "formatted_end": "03:24:45.420",
      "text": "میدهش هم کار است"
    },
    {
      "id": 30,
      "start": 12285.42,
      "end": 12287.42,
      "formatted_start": "03:24:45.420",
      "formatted_end": "03:24:47.420",
      "text": "سه چار روز کار نکردشه کمه؟"
    },
    {
      "id": 31,
      "start": 12287.42,
      "end": 12289.42,
      "formatted_start": "03:24:47.420",
      "formatted_end": "03:24:49.420",
      "text": "سه چار روز بیشته"
    },
    {
      "id": 32,
      "start": 12289.42,
      "end": 12291.42,
      "formatted_start": "03:24:49.420",
      "formatted_end": "03:24:51.420",
      "text": "شده شده شده شده؟ دو ماه شده"
    },
    {
      "id": 33,
      "start": 12291.42,
      "end": 12293.42,
      "formatted_start": "03:24:51.420",
      "formatted_end": "03:24:53.420",
      "text": "دو ماه شده"
    },
    {
      "id": 34,
      "start": 12293.42,
      "end": 12300.0,
