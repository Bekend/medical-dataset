  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14102.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:02.000",
      "text": "در زندگی، داری میگیر."
    },
    {
      "id": 1,
      "start": 14102.0,
      "end": 14106.0,
      "formatted_start": "03:55:02.000",
      "formatted_end": "03:55:06.000",
      "text": "حالا چرا نباید در مورد ایستا تا با کسی صحبت کنی؟"
    },
    {
      "id": 2,
      "start": 14106.0,
      "end": 14114.0,
      "formatted_start": "03:55:06.000",
      "formatted_end": "03:55:14.000",
      "text": "در مورد اهداف، اصادیت موفقیت میگن، گفتن هدفی که در سرته موجب خود ارزای رو روان میشه."
    },
    {
      "id": 3,
      "start": 14114.0,
      "end": 14120.0,
      "formatted_start": "03:55:14.000",
      "formatted_end": "03:55:20.000",
      "text": "یعنی چیه؟ تو دوستت میگه از شمت بخوام برم کلاس بوسیقی، یا هر تا شده این هفته بخوام دو جیر کم کنم."
    },
    {
      "id": 4,
      "start": 14120.0,
      "end": 14126.0,
      "formatted_start": "03:55:20.000",
      "formatted_end": "03:55:26.000",
      "text": "همین که حرفشونو میزنی، مقصد از گفتنش ارزا میشه."
    },
    {
      "id": 5,
      "start": 14126.0,
      "end": 14132.2,
      "formatted_start": "03:55:26.000",
      "formatted_end": "03:55:32.200",
      "text": "این احساس رضایت به نگیری و به تمر کردن و انجام کردنش نمیدونه"
    },
    {
      "id": 6,
      "start": 14132.2,
      "end": 14139.36,
      "formatted_start": "03:55:32.200",
      "formatted_end": "03:55:39.360",
      "text": "اما اگه نگی تا موقعی که به محل عمل در نگی بدن بخز ارزا نمیشه"
    },
    {
      "id": 7,
      "start": 14139.36,
      "end": 14144.0,
      "formatted_start": "03:55:39.360",
      "formatted_end": "03:55:44.000",
      "text": "به همین دلیلی که تو روایات میگن متلق شدن مردم"
    },
    {
      "id": 8,
      "start": 14144.0,
      "end": 14148.58,
      "formatted_start": "03:55:44.000",
      "formatted_end": "03:55:48.580",
      "text": "از انجام کاری که هنوز به پایان نرسیده است"
    },
    {
      "id": 9,
      "start": 14148.58,
      "end": 14153.24,
      "formatted_start": "03:55:48.580",
      "formatted_end": "03:55:53.240",
      "text": "موجه میشه وقتی آن کار هر کسی به پایان نرسید"
    },
    {
      "id": 10,
      "start": 14153.24,
      "end": 14157.0,
      "formatted_start": "03:55:53.240",
      "formatted_end": "03:55:57.000",
      "text": "همیشه یک کار رو تمام کن و بعد بذار مردم بفهمند"
    },
    {
      "id": 11,
      "start": 14157.0,
      "end": 14161.28,
      "formatted_start": "03:55:57.000",
      "formatted_end": "03:56:01.280",
      "text": "اگه مردم قبلش بفهمند شاید یا تمام نشه"
    },
    {
      "id": 12,
      "start": 14161.28,
      "end": 14164.62,
      "formatted_start": "03:56:01.280",
      "formatted_end": "03:56:04.620",
      "text": "یا خودت دیگه نخواهید تمام شد"
    },
    {
      "id": 13,
      "start": 14164.62,
      "end": 14168.04,
      "formatted_start": "03:56:04.620",
      "formatted_end": "03:56:08.040",
      "text": "در مورد میزان دارایی چی؟"
    },
    {
      "id": 14,
      "start": 14168.04,
      "end": 14168.76,
      "formatted_start": "03:56:08.040",
      "formatted_end": "03:56:08.760",
      "text": "رای بازه"
    },
    {
      "id": 15,
      "start": 14168.76,
      "end": 14172.0,
      "formatted_start": "03:56:08.760",
      "formatted_end": "03:56:12.000",
      "text": "چرا نباید در مورد میزان دارایی صحبت کنی؟"
    },
    {
      "id": 16,
      "start": 14172.0,
      "end": 14174.76,
      "formatted_start": "03:56:12.000",
      "formatted_end": "03:56:14.760",
      "text": "اگه بفهمند داری مورد حساب قرار میگی"
    },
    {
      "id": 17,
      "start": 14174.76,
      "end": 14177.92,
      "formatted_start": "03:56:14.760",
      "formatted_end": "03:56:17.920",
      "text": "اگه بفهمند نداری تحقیم شد"
    },
    {
      "id": 18,
      "start": 14177.92,
      "end": 14180.04,
      "formatted_start": "03:56:17.920",
      "formatted_end": "03:56:20.040",
      "text": "اما در مورد اعتقاد"
    },
    {
      "id": 19,
      "start": 14180.04,
      "end": 14182.72,
      "formatted_start": "03:56:20.040",
      "formatted_end": "03:56:22.720",
      "text": "من کاری به کشورهای دیگه ندارم"
    },
    {
      "id": 20,
      "start": 14182.72,
      "end": 14190.12,
      "formatted_start": "03:56:22.720",
      "formatted_end": "03:56:30.120",
      "text": "در کشور ما خیلی کم هست کسایی که میتونن بپذیرن که دیگری ممکنه شبیه به ما فکر نکنه"
    },
    {
      "id": 21,
      "start": 14190.12,
      "end": 14194.22,
      "formatted_start": "03:56:30.120",
      "formatted_end": "03:56:34.220",
      "text": "هر کسی فکر میکنه راه درست خودش پیدا کرده"
    },
    {
      "id": 22,
      "start": 14194.22,
      "end": 14197.16,
      "formatted_start": "03:56:34.220",
      "formatted_end": "03:56:37.160",
      "text": "و وقتی کسی رو ببینه که شبیه اون فکر نمی کنه"
    },
    {
      "id": 23,
      "start": 14197.16,
      "end": 14201.72,
      "formatted_start": "03:56:37.160",
      "formatted_end": "03:56:41.720",
      "text": "یا مسخنش میکنه یا میخواد متقاعدش کنه که در اشتباه فکر میکنه"
    },
    {
      "id": 24,
      "start": 14203.24,
      "end": 14207.72,
      "formatted_start": "03:56:43.240",
      "formatted_end": "03:56:47.720",
      "text": "یعنی یا یه احساس تکنیف میکنه و میخواد قضور ارشاد داره"
    },
    {
      "id": 25,
      "start": 14207.72,
      "end": 14216.08,
      "formatted_start": "03:56:47.720",
      "formatted_end": "03:56:56.080",
      "text": "یا یه عده مثلا روشنفه میخوان اون یه ذره اعتقادی که برای خودت نگفتاشگیرم با مسخره کردن نزد بکیم"
    },
    {
      "id": 26,
      "start": 14216.08,
      "end": 14220.3,
      "formatted_start": "03:56:56.080",
      "formatted_end": "03:57:00.300",
      "text": "همکس تو زندگی بلاخره به یه سری چیزا محتقده"
    },
    {
      "id": 27,
      "start": 14220.3,
      "end": 14222.72,
      "formatted_start": "03:57:00.300",
      "formatted_end": "03:57:02.720",
      "text": "تو فکر کنی چاقو واقعیه"
    },
    {
      "id": 28,
      "start": 14222.72,
      "end": 14224.96,
      "formatted_start": "03:57:02.720",
      "formatted_end": "03:57:04.960",
      "text": "گرفتی دستت"
    },
    {
      "id": 29,
      "start": 14224.96,
      "end": 14227.24,
      "formatted_start": "03:57:04.960",
      "formatted_end": "03:57:07.240",
      "text": "خدا یا کمک هم"
    },
    {
      "id": 30,
      "start": 14227.24,
      "end": 14229.52,
      "formatted_start": "03:57:07.240",
      "formatted_end": "03:57:09.520",
      "text": "خدا چه کار کنه هر درگان"
    },
    {
      "id": 31,
      "start": 14229.52,
      "end": 14231.9,
      "formatted_start": "03:57:09.520",
      "formatted_end": "03:57:11.900",
      "text": "بکشه بیرون یا بیشتر فشارده داری"
    },
    {
      "id": 32,
      "start": 14231.9,
      "end": 14234.0,
      "formatted_start": "03:57:11.900",
      "formatted_end": "03:57:14.000",
      "text": "بلکنی"
    },
    {
      "id": 33,
      "start": 14234.0,
      "end": 14235.56,
      "formatted_start": "03:57:14.000",
      "formatted_end": "03:57:15.560",
      "text": "بلکن"
    },
    {
      "id": 34,
      "start": 14235.56,
      "end": 14237.84,
      "formatted_start": "03:57:15.560",
      "formatted_end": "03:57:17.840",
      "text": "با زمانی که اینو بدن نکنید"
    },
    {
      "id": 35,
      "start": 14237.84,
      "end": 14240.4,
      "formatted_start": "03:57:17.840",
      "formatted_end": "03:57:20.400",
      "text": "روز یه جمعه خیلی قشنگی خونم نگشته بود"
    },
    {
      "id": 36,
      "start": 14240.4,
      "end": 14243.56,
      "formatted_start": "03:57:20.400",
      "formatted_end": "03:57:23.560",
      "text": "و ناگهان نوبته تا میدونید"
    },
    {
      "id": 37,
      "start": 14244.28,
      "end": 14249.0,
      "formatted_start": "03:57:24.280",
      "formatted_end": "03:57:29.000",
      "text": "برای کوپی کرده یه ریوز"
    },
    {
      "id": 38,
      "start": 14249.0,
      "end": 14256.9,
      "formatted_start": "03:57:29.000",
      "formatted_end": "03:57:36.900",
      "text": "آدم ها رو اینجوری بشناسید"
    },
    {
      "id": 39,
      "start": 14256.9,
      "end": 14258.28,
      "formatted_start": "03:57:36.900",
      "formatted_end": "03:57:38.280",
      "text": "با همه بیدیدیم این ویدیو رو"
    },
    {
      "id": 40,
      "start": 14258.28,
      "end": 14260.34,
      "formatted_start": "03:57:38.280",
      "formatted_end": "03:57:40.340",
      "text": "آدم ها رو به جای اینکه"
    },
    {
      "id": 41,
      "start": 14260.34,
      "end": 14262.86,
      "formatted_start": "03:57:40.340",
      "formatted_end": "03:57:42.860",
      "text": "از هر ماش رو بشناسید"
    },
    {
      "id": 42,
      "start": 14262.86,
      "end": 14266.96,
      "formatted_start": "03:57:42.860",
      "formatted_end": "03:57:46.960",
      "text": "از این هشت موقعیتی که من میگم اشناستیم"
    },
    {
      "id": 43,
      "start": 14266.96,
      "end": 14270.8,
      "formatted_start": "03:57:46.960",
      "formatted_end": "03:57:50.800",
      "text": "زن رو زن باقی رو که موقع میشه شناخت"
    },
    {
      "id": 44,
      "start": 14270.8,
      "end": 14274.48,
      "formatted_start": "03:57:50.800",
      "formatted_end": "03:57:54.480",
      "text": "موقعی که شوهرش بیپول باشه"
    },
    {
      "id": 45,
      "start": 14274.48,
      "end": 14277.86,
      "formatted_start": "03:57:54.480",
      "formatted_end": "03:57:57.860",
      "text": "مرد باقی رو که موقع میشه شناخت"
    },
    {
      "id": 46,
      "start": 14278.82,
      "end": 14283.92,
      "formatted_start": "03:57:58.820",
      "formatted_end": "03:58:03.920",
      "text": "موقعی که زنش مریض باشه بیمار باشه"
    },
    {
      "id": 47,
      "start": 14283.92,
      "end": 14286.96,
      "formatted_start": "03:58:03.920",
      "formatted_end": "03:58:06.960",
      "text": "برادر خوهر رو که موقع میشه شناخت"
    },
    {
      "id": 48,
      "start": 14286.96,
      "end": 14289.44,
      "formatted_start": "03:58:06.960",
      "formatted_end": "03:58:09.440",
      "text": "موقعی تقسیم ارسومی هست"
    },
    {
      "id": 49,
      "start": 14289.44,
      "end": 14290.44,
      "formatted_start": "03:58:09.440",
      "formatted_end": "03:58:10.440",
      "text": "اجرا"
    },
    {
      "id": 50,
      "start": 14290.44,
      "end": 14293.24,
      "formatted_start": "03:58:10.440",
      "formatted_end": "03:58:13.240",
      "text": "آدم ها چه موقع عوض میشن"
    },
    {
      "id": 51,
      "start": 14293.24,
      "end": 14294.22,
      "formatted_start": "03:58:13.240",
      "formatted_end": "03:58:14.220",
      "text": "جنوب پرمیان"
    },
    {
      "id": 52,
      "start": 14294.22,
      "end": 14295.82,
      "formatted_start": "03:58:14.220",
      "formatted_end": "03:58:15.820",
      "text": "آدم ها عوض نمیشن"
    },
    {
      "id": 53,
      "start": 14295.82,
      "end": 14298.56,
      "formatted_start": "03:58:15.820",
      "formatted_end": "03:58:18.560",
      "text": "به مرور مشخص میشن فقط"
    },
    {
      "id": 54,
      "start": 14298.56,
      "end": 14300.12,
      "formatted_start": "03:58:18.560",
      "formatted_end": "03:58:20.120",
      "text": "یعنی موده"
    },
    {
      "id": 55,
      "start": 14300.12,
      "end": 14300.78,
      "formatted_start": "03:58:20.120",
      "formatted_end": "03:58:20.780",
      "text": "عوض نمیشن"
    },
    {
      "id": 56,
      "start": 14300.78,
      "end": 14303.82,
      "formatted_start": "03:58:20.780",
      "formatted_end": "03:58:23.820",
      "text": "مشخص شده"
    },
    {
      "id": 57,
      "start": 14303.82,
      "end": 14306.64,
      "formatted_start": "03:58:23.820",
      "formatted_end": "03:58:26.640",
      "text": "آدم ها چه موقع نادیر از میگیرن"
    },
    {
      "id": 58,
      "start": 14306.64,
      "end": 14310.36,
      "formatted_start": "03:58:26.640",
      "formatted_end": "03:58:30.360",
      "text": "موقعی که میبینن همیشه براشون وقت داری"
    },
    {
      "id": 59,
      "start": 14310.36,
      "end": 14313.34,
      "formatted_start": "03:58:30.360",
      "formatted_end": "03:58:33.340",
      "text": "وقتی که ببینن همیشه براشون وقت داری"
    },
    {
      "id": 60,
      "start": 14313.34,
      "end": 14315.02,
      "formatted_start": "03:58:33.340",
      "formatted_end": "03:58:35.020",
      "text": "نادیر از میگیرن"
    },
    {
      "id": 61,
      "start": 14315.02,
      "end": 14318.22,
      "formatted_start": "03:58:35.020",
      "formatted_end": "03:58:38.220",
      "text": "آدمی رو که دوست داریم چه کار بکنیم"
    },
    {
      "id": 62,
      "start": 14318.22,
      "end": 14338.22,
      "formatted_start": "03:58:38.220",
      "formatted_end": "03:58:58.220",
      "text": "موسیقی"
    },
    {
      "id": 63,
      "start": 14338.22,
      "end": 14340.22,
      "formatted_start": "03:58:58.220",
      "formatted_end": "03:59:00.220",
      "text": "این رازی رو به این رو بگم"
    },
    {
      "id": 64,
      "start": 14340.22,
      "end": 14348.22,
      "formatted_start": "03:59:00.220",
      "formatted_end": "03:59:08.220",
      "text": "یه نکته دیگه در مورد ای سی این هستش که وقتی میخوایید ماشین رو خاموش کنید یا کلر رو ببندید"
    },
    {
      "id": 65,
      "start": 14348.22,
      "end": 14354.22,
      "formatted_start": "03:59:08.220",
      "formatted_end": "03:59:14.220",
      "text": "یعنی کلر آف رو نزنید اول این دقیقه رو بزنید ای سی خاموش بشه بعدی شد"
    },
    {
      "id": 66,
      "start": 14354.22,
      "end": 14359.22,
      "formatted_start": "03:59:14.220",
      "formatted_end": "03:59:19.220",
      "text": "وزیری آف رو بزنید تا کلر کاملا غیره کار بشه"
    },
    {
      "id": 67,
      "start": 14359.22,
      "end": 14364.22,
      "formatted_start": "03:59:19.220",
      "formatted_end": "03:59:24.220",
      "text": "یه نکته بیشتری درون بیشتری که تا حالا به خودت گفتی چیه خاندارشی؟"
    },
    {
      "id": 68,
      "start": 14364.22,
      "end": 14366.88,
      "formatted_start": "03:59:24.220",
      "formatted_end": "03:59:26.880",
      "text": "آدم ها خوب هستند اگر تو خوب نگاه کنید."
    },
    {
      "id": 69,
      "start": 14366.88,
      "end": 14368.88,
      "formatted_start": "03:59:26.880",
      "formatted_end": "03:59:28.880",
      "text": "به نظرم این تو هستند."
    },
    {
      "id": 70,
      "start": 14368.88,
      "end": 14374.1,
      "formatted_start": "03:59:28.880",
      "formatted_end": "03:59:34.100",
      "text": "این تصور من بود و به خاطر این تصور از خودم انتظاراتی داشتند."
    },
    {
      "id": 71,
      "start": 14374.1,
      "end": 14378.22,
      "formatted_start": "03:59:34.100",
      "formatted_end": "03:59:38.220",
      "text": "بسیار چهره خورده یک دفعه مافیه میگه که"
    },
    {
      "id": 72,
      "start": 14378.22,
      "end": 14383.46,
      "formatted_start": "03:59:38.220",
      "formatted_end": "03:59:43.460",
      "text": "بعضی سلام دهم و سلامشون موی او داید."
    },
    {
      "id": 73,
      "start": 14383.46,
      "end": 14386.88,
      "formatted_start": "03:59:43.460",
      "formatted_end": "03:59:46.880",
      "text": "بعضی سلام دهم و سلامشون موی او داید."
    },
    {
      "id": 74,
      "start": 14386.88,
      "end": 14390.06,
      "formatted_start": "03:59:46.880",
      "formatted_end": "03:59:50.060",
      "text": "این نکته کسی دریابت که به ایران محشومی باشد."
    },
    {
      "id": 75,
      "start": 14390.06,
      "end": 14397.26,
      "formatted_start": "03:59:50.060",
      "formatted_end": "03:59:57.260",
      "text": "نفس هم اگر درده بندگی کند از او بی امتحان و فضیل که حق را چونی کند که آخر پشیمانی نباشد"
    },
    {
      "id": 76,
      "start": 14397.26,
      "end": 14399.98,
      "formatted_start": "03:59:57.260",
      "formatted_end": "03:59:59.980",
      "text": "پس نشانی پیدا کن که تشخیص بدید"
    }
  ],
  "status": "completed"
}