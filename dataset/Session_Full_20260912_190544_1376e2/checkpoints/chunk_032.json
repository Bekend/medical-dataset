  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9604.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:04.000",
      "text": "با این مهموسین، بقدر همه اول مدرت های گولپارو در میاری."
    },
    {
      "id": 1,
      "start": 9604.0,
      "end": 9610.0,
      "formatted_start": "02:40:04.000",
      "formatted_end": "02:40:10.000",
      "text": "آره نبر نابرابره، اما دست بردار با ماهه، ماه مهموسینو داریم."
    },
    {
      "id": 2,
      "start": 9610.0,
      "end": 9618.0,
      "formatted_start": "02:40:10.000",
      "formatted_end": "02:40:18.000",
      "text": "مردی که پالش رو به نام همسرش میزنه، به صورت اتوماتی، دلیل چه بارش رو از دست دونیده."
    },
    {
      "id": 3,
      "start": 9618.0,
      "end": 9621.0,
      "formatted_start": "02:40:18.000",
      "formatted_end": "02:40:21.000",
      "text": "سریعی به خود سیلیک بکنه،"
    },
    {
      "id": 4,
      "start": 9621.0,
      "end": 9624.0,
      "formatted_start": "02:40:21.000",
      "formatted_end": "02:40:24.000",
      "text": "این یک پرسیدن سیستم اتوهای چیه؟"
    },
    {
      "id": 5,
      "start": 9624.0,
      "end": 9627.0,
      "formatted_start": "02:40:24.000",
      "formatted_end": "02:40:27.000",
      "text": "آقایی، با جمعه رو ببینید اینجا، اینو پشت ها بردید، فعال میشه،"
    },
    {
      "id": 6,
      "start": 9627.0,
      "end": 9634.0,
      "formatted_start": "02:40:27.000",
      "formatted_end": "02:40:34.000",
      "text": "پشت صفحه کیلویتر که اومد، بعد حالا شما میدین پشت چراب قربز یا تو ترافیک"
    },
    {
      "id": 7,
      "start": 9634.0,
      "end": 9643.0,
      "formatted_start": "02:40:34.000",
      "formatted_end": "02:40:43.000",
      "text": "ما تونو روی ترموز که بزارید، یعنی استقامت جروب کنید، ببینید، پشت صفحه کیلویتر که چراب سبزرگ فعال میشه"
    },
    {
      "id": 8,
      "start": 9643.0,
      "end": 9647.0,
      "formatted_start": "02:40:43.000",
      "formatted_end": "02:40:47.000",
      "text": "ما تونو حالا از روی ترموز برده که پاشین دیگه تکن نمی کنه"
    },
    {
      "id": 9,
      "start": 9647.0,
      "end": 9652.0,
      "formatted_start": "02:40:47.000",
      "formatted_end": "02:40:52.000",
      "text": "این مموغه که تو ترافیک است، یا پشت چراب قربز، دیگه به دست دندن کاری نداره"
    },
    {
      "id": 10,
      "start": 9652.0,
      "end": 9662.0,
      "formatted_start": "02:40:52.000",
      "formatted_end": "02:41:02.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 9682.0,
      "end": 9690.0,
      "formatted_start": "02:41:22.000",
      "formatted_end": "02:41:30.000",
      "text": "فرمانده که به مرتزگان را متشکرده. شاکرها تمام تاستانان را پرش کردن و هیچ کس بازه تلو سوال را به باقش ندارد."
    },
    {
      "id": 12,
      "start": 9691.0,
      "end": 9695.0,
      "formatted_start": "02:41:31.000",
      "formatted_end": "02:41:35.000",
      "text": "چه کسی گربید را در دست دارد، نه اینکه چه کسی بند را انداخت."
    },
    {
      "id": 13,
      "start": 9696.0,
      "end": 9699.0,
      "formatted_start": "02:41:36.000",
      "formatted_end": "02:41:39.000",
      "text": "چیز نزدیک دارد از اینکه آن کامیون کنار بزند آنجا؟"
    },
    {
      "id": 14,
      "start": 9699.0,
      "end": 9703.68,
      "formatted_start": "02:41:39.000",
      "formatted_end": "02:41:43.680",
      "text": "اون آن کامیون متعلق به دسته از اهلاف است که فقط پانزده دلیل روی زمین میماند"
    },
    {
      "id": 15,
      "start": 9703.68,
      "end": 9706.4,
      "formatted_start": "02:41:43.680",
      "formatted_end": "02:41:46.400",
      "text": "و خودش انتخاب می کنند که کدوم آن در این راشد"
    },
    {
      "id": 16,
      "start": 9706.4,
      "end": 9712.52,
      "formatted_start": "02:41:46.400",
      "formatted_end": "02:41:52.520",
      "text": "بیش از چهار هزار مولد از آنها در همین بازه زمانی در ایران شنسکر شده"
    },
    {
      "id": 17,
      "start": 9712.52,
      "end": 9716.52,
      "formatted_start": "02:41:52.520",
      "formatted_end": "02:41:56.520",
      "text": "و تونچ پلاتفورمی به اندازه که همان که این دوربیل را حملی کرد"
    },
    {
      "id": 18,
      "start": 9716.52,
      "end": 9718.58,
      "formatted_start": "02:41:56.520",
      "formatted_end": "02:41:58.580",
      "text": "مسکون شنسایی آنها نمی کنند"
    },
    {
      "id": 19,
      "start": 9718.58,
      "end": 9720.88,
      "formatted_start": "02:41:58.580",
      "formatted_end": "02:42:00.880",
      "text": "این بخش سخته اینجا نموند"
    },
    {
      "id": 20,
      "start": 9720.88,
      "end": 9723.16,
      "formatted_start": "02:42:00.880",
      "formatted_end": "02:42:03.160",
      "text": "ورد قاب تصویری که بردران میرسند"
    },
    {
      "id": 21,
      "start": 9723.16,
      "end": 9726.54,
      "formatted_start": "02:42:03.160",
      "formatted_end": "02:42:06.540",
      "text": "نیروهای هوایی ده هواست که در این زمین شکست بودند"
    },
    {
      "id": 22,
      "start": 9726.54,
      "end": 9730.64,
      "formatted_start": "02:42:06.540",
      "formatted_end": "02:42:10.640",
      "text": "هواپیمایی که این قاب را سفزی کنند یک انکیون موهری پرست"
    },
    {
      "id": 23,
      "start": 9730.64,
      "end": 9734.1,
      "formatted_start": "02:42:10.640",
      "formatted_end": "02:42:14.100",
      "text": "با سرحت مرود دیویست نا فراغ دارند"
    },
    {
      "id": 24,
      "start": 9734.1,
      "end": 9739.44,
      "formatted_start": "02:42:14.100",
      "formatted_end": "02:42:19.440",
      "text": "این هواپیما همه تا نیز و ندید به سی فرمدازان آدرین اولیابی ناوود شدند"
    },
    {
      "id": 25,
      "start": 9739.44,
      "end": 9744.08,
      "formatted_start": "02:42:19.440",
      "formatted_end": "02:42:24.080",
      "text": "رفیس ستاد نیروی هوایی آن را با عرضشترین بازی کنه جنگ ماند"
    },
    {
      "id": 26,
      "start": 9744.08,
      "end": 9748.82,
      "formatted_start": "02:42:24.080",
      "formatted_end": "02:42:28.820",
      "text": "جنگ مدرن مشکلاتی دارد که تجهیزات بهتر نمیتوانند آن براحت ماند"
    },
    {
      "id": 27,
      "start": 9753.16,
      "end": 9781.16,
      "formatted_start": "02:42:33.160",
      "formatted_end": "02:43:01.160",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 9781.16,
      "end": 9785.32,
      "formatted_start": "02:43:01.160",
      "formatted_end": "02:43:05.320",
      "text": "آقا، گارانتی ماشینت باطل میشه، شریکت هم از خوداشه"
    },
    {
      "id": 29,
      "start": 9785.32,
      "end": 9787.92,
      "formatted_start": "02:43:05.320",
      "formatted_end": "02:43:07.920",
      "text": "از این چند تا نکتهی که میگن رو رویب بگیریم"
    },
    {
      "id": 30,
      "start": 9787.92,
      "end": 9789.92,
      "formatted_start": "02:43:07.920",
      "formatted_end": "02:43:09.920",
      "text": "این تره همه چه شمیده"
    },
    {
      "id": 31,
      "start": 9789.92,
      "end": 9791.92,
      "formatted_start": "02:43:09.920",
      "formatted_end": "02:43:11.920",
      "text": "کشت چون ترهی وجود داره؟"
    },
    {
      "id": 32,
      "start": 9791.92,
      "end": 9796.92,
      "formatted_start": "02:43:11.920",
      "formatted_end": "02:43:16.920",
      "text": "هیچ، روای و رای پیشگیری از بزرگ شدن بازگار میدونه"
    },
    {
      "id": 33,
      "start": 9796.92,
      "end": 9800.92,
      "formatted_start": "02:43:16.920",
      "formatted_end": "02:43:20.920",
      "text": "99 درصد آدم ها بعد از دیدن این آزمایه شد"
    },
    {
      "id": 34,
      "start": 9800.92,
      "end": 9803.92,
      "formatted_start": "02:43:20.920",
      "formatted_end": "02:43:23.920",
      "text": "تقییم ستم میشه، نرم اگه تو یک آدم دیدی"
    },
    {
      "id": 35,
      "start": 9803.92,
      "end": 9806.92,
      "formatted_start": "02:43:23.920",
      "formatted_end": "02:43:26.920",
      "text": "باوردوشه یکیمیدیار و بیس نگیر کمان"
    },
    {
      "id": 36,
      "start": 9806.92,
      "end": 9809.92,
      "formatted_start": "02:43:26.920",
      "formatted_end": "02:43:29.920",
      "text": "یکیمی باچه یکیمی باگرد برای همه"
    },
    {
      "id": 37,
      "start": 9809.92,
      "end": 9811.92,
      "formatted_start": "02:43:29.920",
      "formatted_end": "02:43:31.920",
      "text": "تراثی باچه موکرینی دارد"
    },
    {
      "id": 38,
      "start": 9811.92,
      "end": 9814.92,
      "formatted_start": "02:43:31.920",
      "formatted_end": "02:43:34.920",
      "text": "در اینجا میشان باچه سیرکیت معمولی"
    },
    {
      "id": 39,
      "start": 9814.92,
      "end": 9816.92,
      "formatted_start": "02:43:34.920",
      "formatted_end": "02:43:36.920",
      "text": "باید ترامی مالی باید برای گیره کنید"
    },
    {
      "id": 40,
      "start": 9816.92,
      "end": 9819.92,
      "formatted_start": "02:43:36.920",
      "formatted_end": "02:43:39.920",
      "text": "مثل این ماشین باید دفت هوایی جیتو کنه"
    },
    {
      "id": 41,
      "start": 9819.92,
      "end": 9821.92,
      "formatted_start": "02:43:39.920",
      "formatted_end": "02:43:41.920",
      "text": "این تنهایی من رفتی که نامونده"
    },
    {
      "id": 42,
      "start": 9821.92,
      "end": 9823.92,
      "formatted_start": "02:43:41.920",
      "formatted_end": "02:43:43.920",
      "text": "اینو چون دسته نشانو کنه"
    },
    {
      "id": 43,
      "start": 9823.92,
      "end": 9825.92,
      "formatted_start": "02:43:43.920",
      "formatted_end": "02:43:45.920",
      "text": "اومدیم و بازی ارمین بوده"
    },
    {
      "id": 44,
      "start": 9825.92,
      "end": 9827.92,
      "formatted_start": "02:43:45.920",
      "formatted_end": "02:43:47.920",
      "text": "ماشینی کیلز از زرطه تمام شد"
    },
    {
      "id": 45,
      "start": 9827.92,
      "end": 9829.92,
      "formatted_start": "02:43:47.920",
      "formatted_end": "02:43:49.920",
      "text": "میتونی از ماشین استفاده کنی؟"
    },
    {
      "id": 46,
      "start": 9829.92,
      "end": 9831.92,
      "formatted_start": "02:43:49.920",
      "formatted_end": "02:43:51.920",
      "text": "من رو یه ویدیو رو ببینم"
    },
    {
      "id": 47,
      "start": 9831.92,
      "end": 9833.92,
      "formatted_start": "02:43:51.920",
      "formatted_end": "02:43:53.920",
      "text": "مشکلی که از اون اول پیش میاد"
    },
    {
      "id": 48,
      "start": 9833.92,
      "end": 9835.92,
      "formatted_start": "02:43:53.920",
      "formatted_end": "02:43:55.920",
      "text": "چما اصلا نمیتونی در راه رو باز کنید که وارد ماشین گشتید"
    },
    {
      "id": 49,
      "start": 9835.92,
      "end": 9837.92,
      "formatted_start": "02:43:55.920",
      "formatted_end": "02:43:57.920",
      "text": "پس باید به کلید فریزی نسلسی پیدا کنید"
    },
    {
      "id": 50,
      "start": 9837.92,
      "end": 9839.92,
      "formatted_start": "02:43:57.920",
      "formatted_end": "02:43:59.920",
      "text": "یا با باز کردن پشترین رو"
    },
    {
      "id": 51,
      "start": 9839.92,
      "end": 9841.92,
      "formatted_start": "02:43:59.920",
      "formatted_end": "02:44:01.920",
      "text": "یا با فشار دادن"
    },
    {
      "id": 52,
      "start": 9841.92,
      "end": 9843.92,
      "formatted_start": "02:44:01.920",
      "formatted_end": "02:44:03.920",
      "text": "این دکمه بی ورزی از این موقع"
    },
    {
      "id": 53,
      "start": 9843.92,
      "end": 9845.92,
      "formatted_start": "02:44:03.920",
      "formatted_end": "02:44:05.920",
      "text": "که کلید فریزی رو درکتی رو تنبه بگیره"
    },
    {
      "id": 54,
      "start": 9845.92,
      "end": 9851.92,
      "formatted_start": "02:44:05.920",
      "formatted_end": "02:44:11.920",
      "text": "اگر اینجای گفت ماشین مشخص است که من همه دامتی می کنید در ماشین باز کنید و بارد بشید"
    },
    {
      "id": 55,
      "start": 9851.92,
      "end": 9859.92,
      "formatted_start": "02:44:11.920",
      "formatted_end": "02:44:19.920",
      "text": "اما اگر گفت در پشتون بشده بود از همین کلیده که استفاده کنید اوان احرام بارد به این گزرنه کنید"
    },
    {
      "id": 56,
      "start": 9859.92,
      "end": 9863.92,
      "formatted_start": "02:44:19.920",
      "formatted_end": "02:44:23.920",
      "text": "در پشتون بردارید و از این طریق در ماشینتون باید باز کنید"
    },
    {
      "id": 57,
      "start": 9863.92,
      "end": 9871.92,
      "formatted_start": "02:44:23.920",
      "formatted_end": "02:44:31.920",
      "text": "ولی یک حالت سه گمی هم هست مثل Z8 که نه گفت مشخص است نه در پشتی داره که داخلیم بازش کنید"
    },
    {
      "id": 58,
      "start": 9871.92,
      "end": 9876.24,
      "formatted_start": "02:44:31.920",
      "formatted_end": "02:44:36.240",
      "text": "تیم کور را دستگیرم که بدین، البته بخودشونشون میده"
    },
    {
      "id": 59,
      "start": 9876.24,
      "end": 9880.48,
      "formatted_start": "02:44:36.240",
      "formatted_end": "02:44:40.480",
      "text": "گیر پیزیکی رو باردش میکنید و در رو باز میکنید"
    },
    {
      "id": 60,
      "start": 9880.48,
      "end": 9885.48,
      "formatted_start": "02:44:40.480",
      "formatted_end": "02:44:45.480",
      "text": "و این مکیه داره، در اینکه باز بشه سویلوزگیر در میتواند"
    },
    {
      "id": 61,
      "start": 9887.48,
      "end": 9892.48,
      "formatted_start": "02:44:47.480",
      "formatted_end": "02:44:52.480",
      "text": "قبل از اینکه آرگیر راستان بشه، سریع سواره ماشین بشید"
    },
    {
      "id": 62,
      "start": 9892.48,
      "end": 9896.48,
      "formatted_start": "02:44:52.480",
      "formatted_end": "02:44:56.480",
      "text": "طبیعتاً با خاطر اینکه ریموت توی بازجی نداره، ماشین تشکیزش نمیده"
    },
    {
      "id": 63,
      "start": 9896.48,
      "end": 9900.48,
      "formatted_start": "02:44:56.480",
      "formatted_end": "02:45:00.480",
      "text": "هرچی حلاش کنید در استارت، ریموت رو تشکیزش میکنید"
    }
  ],
  "status": "completed"
}