    },
    {
      "id": 33,
      "start": 10167.12,
      "end": 10192.12,
      "formatted_start": "02:49:27.120",
      "formatted_end": "02:49:52.120",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 10192.12,
      "end": 10199.46,
      "formatted_start": "02:49:52.120",
      "formatted_end": "02:49:59.460",
      "text": "جورج برنامه سوی جمله داره خیلی جمعی جالبیه میگه آدم منطقی خودش رو با شرطش وقف بوده"
    }
