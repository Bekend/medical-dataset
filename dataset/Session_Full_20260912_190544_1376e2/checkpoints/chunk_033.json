  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9930.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:30.000",
      "text": "این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست، این موطوع در اینجا نیست"
    },
    {
      "id": 1,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "فارموف رو بگیر و خیلی راقید ماشین رو"
    },
    {
      "id": 2,
      "start": 9933.0,
      "end": 9934.0,
      "formatted_start": "02:45:33.000",
      "formatted_end": "02:45:34.000",
      "text": "ستارت کنید"
    },
    {
      "id": 3,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "هم ماشین روشن بیشه"
    },
    {
      "id": 4,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "و هم ماشینی که به صدا دادن آمده بود"
    },
    {
      "id": 5,
      "start": 9938.0,
      "end": 9939.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:39.000",
      "text": "باید ماشینی"
    },
    {
      "id": 6,
      "start": 9939.0,
      "end": 9940.0,
      "formatted_start": "02:45:39.000",
      "formatted_end": "02:45:40.000",
      "text": "به همین وقت"
    },
    {
      "id": 7,
      "start": 9940.0,
      "end": 9943.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:43.000",
      "text": "ویدیو رو سیف کنید که قراره تو موقعیتش به درده تو برده"
    },
    {
      "id": 8,
      "start": 9943.0,
      "end": 9945.0,
      "formatted_start": "02:45:43.000",
      "formatted_end": "02:45:45.000",
      "text": "ماشینی"
    },
    {
      "id": 9,
      "start": 9945.0,
      "end": 9948.0,
      "formatted_start": "02:45:45.000",
      "formatted_end": "02:45:48.000",
      "text": "همین دیروز 6 میلیار فورده این ماشین رو دادم آنجا"
    },
    {
      "id": 10,
      "start": 9948.0,
      "end": 9949.0,
      "formatted_start": "02:45:48.000",
      "formatted_end": "02:45:49.000",
      "text": "پس یک خط روش بیافته"
    },
    {
      "id": 11,
      "start": 9949.0,
      "end": 9951.0,
      "formatted_start": "02:45:49.000",
      "formatted_end": "02:45:51.000",
      "text": "این حرف مالک این تویتا کوروناهی"
    },
    {
      "id": 12,
      "start": 9951.0,
      "end": 9954.0,
      "formatted_start": "02:45:51.000",
      "formatted_end": "02:45:54.000",
      "text": "بلا فاصله بعد خرده ماشین اومد پیش ما و گفت"
    },
    {
      "id": 13,
      "start": 9954.0,
      "end": 9956.0,
      "formatted_start": "02:45:54.000",
      "formatted_end": "02:45:56.000",
      "text": "چونی ماشین رو ازت زرگردیم؟"
    },
    {
      "id": 14,
      "start": 9956.0,
      "end": 9958.0,
      "formatted_start": "02:45:56.000",
      "formatted_end": "02:45:58.000",
      "text": "اوکی یاد دادیم اون ماشین رو پذیرش کردیم"
    },
    {
      "id": 15,
      "start": 9958.0,
      "end": 9960.0,
      "formatted_start": "02:45:58.000",
      "formatted_end": "02:46:00.000",
      "text": "بردیم اجتماعات شدتشوی مجموعه"
    },
    {
      "id": 16,
      "start": 9960.0,
      "end": 9962.0,
      "formatted_start": "02:46:00.000",
      "formatted_end": "02:46:02.000",
      "text": "و با یک هفت بطری هسافی سطح بدنه آمده همجب خدا ماشین"
    },
    {
      "id": 17,
      "start": 9962.0,
      "end": 9964.0,
      "formatted_start": "02:46:02.000",
      "formatted_end": "02:46:04.000",
      "text": "از کافوت ماشین شروع کردیم"
    },
    {
      "id": 18,
      "start": 9964.0,
      "end": 9967.0,
      "formatted_start": "02:46:04.000",
      "formatted_end": "02:46:07.000",
      "text": "ستیکیر جلوی ماشین کابل بی پی اف شفاف نزدیک"
    },
    {
      "id": 19,
      "start": 9967.0,
      "end": 9970.0,
      "formatted_start": "02:46:07.000",
      "formatted_end": "02:46:10.000",
      "text": "که هم خیالشون تا سالها از تنکردگی جاده راحت باشه"
    },
    {
      "id": 20,
      "start": 9970.0,
      "end": 9974.88,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:14.880",
      "text": "هم اگر خدایی نکرده تصدیف کردن، کابر پی پی اف جدای آسیب رنگ بدن رو بکی"
    },
    {
      "id": 21,
      "start": 9974.88,
      "end": 9978.12,
      "formatted_start": "02:46:14.880",
      "formatted_end": "02:46:18.120",
      "text": "بعد از اون، مابقی بدن سه مرحل اقیای رنگ شد"
    },
    {
      "id": 22,
      "start": 9978.12,
      "end": 9981.84,
      "formatted_start": "02:46:18.120",
      "formatted_end": "02:46:21.840",
      "text": "موایه سرامیک ها هرمانی بر راقیت ماشین تا پنگ تا تصمیم شد"
    },
    {
      "id": 23,
      "start": 9981.84,
      "end": 9982.98,
      "formatted_start": "02:46:21.840",
      "formatted_end": "02:46:22.980",
      "text": "رفتیم طراب داخل"
    },
    {
      "id": 24,
      "start": 9982.98,
      "end": 9988.14,
      "formatted_start": "02:46:22.980",
      "formatted_end": "02:46:28.140",
      "text": "برای مانیتور، سفه کیروهرد و تمام اگزای داخلی ماشین کابر پی پی اف نصفی"
    },
    {
      "id": 25,
      "start": 9988.14,
      "end": 9991.12,
      "formatted_start": "02:46:28.140",
      "formatted_end": "02:46:31.120",
      "text": "را این ماشین تا آخر عمرش رنگی خط و خشونه بید"
    },
    {
      "id": 26,
      "start": 9991.12,
      "end": 9998.36,
      "formatted_start": "02:46:31.120",
      "formatted_end": "02:46:38.360",
      "text": "در نهای علایه تمام قسمت های چرمی ماشین دوسیون چرم جا کردیش و این شما اینم خروجی مجموعه خواهرباد"
    },
    {
      "id": 27,
      "start": 10021.12,
      "end": 10043.12,
      "formatted_start": "02:47:01.120",
      "formatted_end": "02:47:23.120",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 10043.12,
      "end": 10067.12,
      "formatted_start": "02:47:23.120",
      "formatted_end": "02:47:47.120",
      "text": "موسیقی"
    },
    {
      "id": 29,
      "start": 10067.12,
      "end": 10087.12,
      "formatted_start": "02:47:47.120",
      "formatted_end": "02:48:07.120",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 10087.12,
      "end": 10107.12,
      "formatted_start": "02:48:07.120",
      "formatted_end": "02:48:27.120",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 10107.12,
      "end": 10137.1,
      "formatted_start": "02:48:27.120",
      "formatted_end": "02:48:57.100",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 32,
      "start": 10137.12,
      "end": 10142.12,
      "formatted_start": "02:48:57.120",
      "formatted_end": "02:49:02.120",
