  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12612.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:12.000",
      "text": "خب باشه، خیلی همسنده باشه، مرسی، باشه، باشه، نظرم از بیمارستان قرار کسی بره؟"
    },
    {
      "id": 1,
      "start": 12612.0,
      "end": 12629.0,
      "formatted_start": "03:30:12.000",
      "formatted_end": "03:30:29.000",
      "text": "برد. خب به آقای علاقه هم اطلاع بدید، مدیر داخلی، مدیر داخلی، داوید، مرسی، ممنون، خدا بساند."
    },
    {
      "id": 2,
      "start": 12660.0,
      "end": 12673.0,
      "formatted_start": "03:31:00.000",
      "formatted_end": "03:31:13.000",
      "text": "خمسه همین انجام دادین؟"
    },
    {
      "id": 3,
      "start": 12673.0,
      "end": 12677.0,
      "formatted_start": "03:31:13.000",
      "formatted_end": "03:31:17.000",
      "text": "چیزی هم نوشته بیادین؟"
    },
    {
      "id": 4,
      "start": 12677.0,
      "end": 12679.0,
      "formatted_start": "03:31:17.000",
      "formatted_end": "03:31:19.000",
      "text": "سنگیزه یه؟"
    },
    {
      "id": 5,
      "start": 12679.0,
      "end": 12681.0,
      "formatted_start": "03:31:19.000",
      "formatted_end": "03:31:21.000",
      "text": "سنگیزه"
    },
    {
      "id": 6,
      "start": 12681.0,
      "end": 12683.0,
      "formatted_start": "03:31:21.000",
      "formatted_end": "03:31:23.000",
      "text": "بله"
    },
    {
      "id": 7,
      "start": 12683.0,
      "end": 12685.0,
      "formatted_start": "03:31:23.000",
      "formatted_end": "03:31:25.000",
      "text": "سنگیزه"
    },
    {
      "id": 8,
      "start": 12685.0,
      "end": 12687.0,
      "formatted_start": "03:31:25.000",
      "formatted_end": "03:31:27.000",
      "text": "بله بله"
    },
    {
      "id": 9,
      "start": 12690.0,
      "end": 12697.64,
      "formatted_start": "03:31:30.000",
      "formatted_end": "03:31:37.640",
      "text": "داره کلیه راستیه که دو زقامت پرانشین ۱۵ سنگ ۷ میلیمید"
    },
    {
      "id": 10,
      "start": 12703.0,
      "end": 12709.68,
      "formatted_start": "03:31:43.000",
      "formatted_end": "03:31:49.680",
      "text": "همون ضربه ای که من دیوز زدم حدس هم رو همین سنگ بود دیوز هم سنگی نور"
    },
    {
      "id": 11,
      "start": 12711.1,
      "end": 12712.56,
      "formatted_start": "03:31:51.100",
      "formatted_end": "03:31:52.560",
      "text": "اون خون هم همون سنگه"
    },
    {
      "id": 12,
      "start": 12713.94,
      "end": 12715.44,
      "formatted_start": "03:31:53.940",
      "formatted_end": "03:31:55.440",
      "text": "خون، خونه هم سنگه"
    },
    {
      "id": 13,
      "start": 12715.44,
      "end": 12719.44,
      "formatted_start": "03:31:55.440",
      "formatted_end": "03:31:59.440",
      "text": "اینو با یک متخصیل کلیه خانسمید"
    },
    {
      "id": 14,
      "start": 12719.44,
      "end": 12723.44,
      "formatted_start": "03:31:59.440",
      "formatted_end": "03:32:03.440",
      "text": "ببینید اینا چی کار می کنید"
    },
    {
      "id": 15,
      "start": 12723.44,
      "end": 12727.44,
      "formatted_start": "03:32:03.440",
      "formatted_end": "03:32:07.440",
      "text": "7 میلیمتر این مقدار متوسط"
    },
    {
      "id": 16,
      "start": 12727.44,
      "end": 12729.44,
      "formatted_start": "03:32:07.440",
      "formatted_end": "03:32:09.440",
      "text": "یه سان، میل سان"
    },
    {
      "id": 17,
      "start": 12729.44,
      "end": 12733.44,
      "formatted_start": "03:32:09.440",
      "formatted_end": "03:32:13.440",
      "text": "میل سان بزرگتر از میل سان هست"
    },
    {
      "id": 18,
      "start": 12733.44,
      "end": 12735.44,
      "formatted_start": "03:32:13.440",
      "formatted_end": "03:32:15.440",
      "text": "حالا درده شدید بود"
    },
    {
      "id": 19,
      "start": 12735.44,
      "end": 12739.44,
      "formatted_start": "03:32:15.440",
      "formatted_end": "03:32:19.440",
      "text": "حالا درده خیلی مکنه بوده"
    },
    {
      "id": 20,
      "start": 12739.44,
      "end": 12743.44,
      "formatted_start": "03:32:19.440",
      "formatted_end": "03:32:23.440",
      "text": "بعضی ما بودون خده، باید با مانگوله"
    },
    {
      "id": 21,
      "start": 12743.44,
      "end": 12745.44,
      "formatted_start": "03:32:23.440",
      "formatted_end": "03:32:25.440",
      "text": "یکی کارخان صابر می‌کنی شید یاده؟"
    },
    {
      "id": 22,
      "start": 12745.44,
      "end": 12746.44,
      "formatted_start": "03:32:25.440",
      "formatted_end": "03:32:26.440",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 12746.44,
      "end": 12747.44,
      "formatted_start": "03:32:26.440",
      "formatted_end": "03:32:27.440",
      "text": "اومد صابر کنه"
    },
    {
      "id": 24,
      "start": 12747.44,
      "end": 12748.44,
      "formatted_start": "03:32:27.440",
      "formatted_end": "03:32:28.440",
      "text": "آره"
    },
    {
      "id": 25,
      "start": 12748.44,
      "end": 12751.44,
      "formatted_start": "03:32:28.440",
      "formatted_end": "03:32:31.440",
      "text": "آره یه مریض هفته‌تون من اومد صابر کنی شید"
    },
    {
      "id": 26,
      "start": 12751.44,
      "end": 12752.44,
      "formatted_start": "03:32:31.440",
      "formatted_end": "03:32:32.440",
      "text": "شیده"
    },
    {
      "id": 27,
      "start": 12752.44,
      "end": 12754.44,
      "formatted_start": "03:32:32.440",
      "formatted_end": "03:32:34.440",
      "text": "چه؟ با تحلیل"
    },
    {
      "id": 28,
      "start": 12768.44,
      "end": 12769.44,
      "formatted_start": "03:32:48.440",
      "formatted_end": "03:32:49.440",
      "text": "بله؟"
    },
    {
      "id": 29,
      "start": 12769.44,
      "end": 12771.44,
      "formatted_start": "03:32:49.440",
      "formatted_end": "03:32:51.440",
      "text": "که که خوشتایه"
    },
    {
      "id": 30,
      "start": 12771.44,
      "end": 12772.44,
      "formatted_start": "03:32:51.440",
      "formatted_end": "03:32:52.440",
      "text": "چرا؟"
    },
    {
      "id": 31,
      "start": 12772.44,
      "end": 12780.44,
      "formatted_start": "03:32:52.440",
      "formatted_end": "03:33:00.440",
      "text": "7 میلیمکت ممکنه بیفته، فقط بازم یک چیز کنه"
    },
    {
      "id": 32,
      "start": 12780.44,
      "end": 12800.44,
      "formatted_start": "03:33:00.440",
      "formatted_end": "03:33:20.440",
      "text": "موسیقی"
    },
    {
      "id": 33,
      "start": 12810.44,
      "end": 12828.44,
      "formatted_start": "03:33:30.440",
      "formatted_end": "03:33:48.440",
      "text": "موسیقی"
    },
    {
      "id": 34,
      "start": 12828.44,
      "end": 12830.44,
      "formatted_start": "03:33:48.440",
      "formatted_end": "03:33:50.440",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 35,
      "start": 12830.44,
      "end": 12832.44,
      "formatted_start": "03:33:50.440",
      "formatted_end": "03:33:52.440",
      "text": "باید بردارید."
    },
    {
      "id": 36,
      "start": 12832.44,
      "end": 12834.44,
      "formatted_start": "03:33:52.440",
      "formatted_end": "03:33:54.440",
      "text": "باید بردارید."
    },
    {
      "id": 37,
      "start": 12834.44,
      "end": 12836.44,
      "formatted_start": "03:33:54.440",
      "formatted_end": "03:33:56.440",
      "text": "باید بردارید."
    },
    {
      "id": 38,
      "start": 12836.44,
      "end": 12838.44,
      "formatted_start": "03:33:56.440",
      "formatted_end": "03:33:58.440",
      "text": "باید بردارید."
    },
    {
      "id": 39,
      "start": 12838.44,
      "end": 12840.44,
      "formatted_start": "03:33:58.440",
      "formatted_end": "03:34:00.440",
      "text": "باید بردارید."
    },
    {
      "id": 40,
      "start": 12840.44,
      "end": 12842.44,
      "formatted_start": "03:34:00.440",
      "formatted_end": "03:34:02.440",
      "text": "باید بردارید."
    },
    {
      "id": 41,
