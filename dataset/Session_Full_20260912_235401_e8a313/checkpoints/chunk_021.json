  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6329.98,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6359.98,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:59.980",
      "text": "باید بردارید که اینجا باید بردارید"
    },
    {
      "id": 2,
      "start": 6360.0,
      "end": 6362.0,
      "formatted_start": "01:46:00.000",
      "formatted_end": "01:46:02.000",
      "text": "اینجا باید برگتون رو بیزند بده"
    },
    {
      "id": 3,
      "start": 6362.0,
      "end": 6364.0,
      "formatted_start": "01:46:02.000",
      "formatted_end": "01:46:04.000",
      "text": "کنید بچه شما از اصال شدید"
    },
    {
      "id": 4,
      "start": 6364.0,
      "end": 6366.0,
      "formatted_start": "01:46:04.000",
      "formatted_end": "01:46:06.000",
      "text": "اصال شدید"
    },
    {
      "id": 5,
      "start": 6366.0,
      "end": 6368.0,
      "formatted_start": "01:46:06.000",
      "formatted_end": "01:46:08.000",
      "text": "اصال شدید"
    },
    {
      "id": 6,
      "start": 6368.0,
      "end": 6370.0,
      "formatted_start": "01:46:08.000",
      "formatted_end": "01:46:10.000",
      "text": "خورسه دیگه نقصیلات نصف شده"
    },
    {
      "id": 7,
      "start": 6370.0,
      "end": 6372.0,
      "formatted_start": "01:46:10.000",
      "formatted_end": "01:46:12.000",
      "text": "یک بار در روز"
    },
    {
      "id": 8,
      "start": 6372.0,
      "end": 6374.0,
      "formatted_start": "01:46:12.000",
      "formatted_end": "01:46:14.000",
      "text": "دو بار در روز"
    },
    {
      "id": 9,
      "start": 6374.0,
      "end": 6376.0,
      "formatted_start": "01:46:14.000",
      "formatted_end": "01:46:16.000",
      "text": "نصف شده"
    },
    {
      "id": 10,
      "start": 6376.0,
      "end": 6378.0,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:18.000",
      "text": "تا یک دن کامل هم میتونه بیده"
    },
    {
      "id": 11,
      "start": 6378.0,
      "end": 6380.0,
      "formatted_start": "01:46:18.000",
      "formatted_end": "01:46:20.000",
      "text": "روزی سه بار"
    },
    {
      "id": 12,
      "start": 6380.0,
      "end": 6382.0,
      "formatted_start": "01:46:20.000",
      "formatted_end": "01:46:22.000",
      "text": "هر هشت ساعت"
    },
    {
      "id": 13,
      "start": 6382.0,
      "end": 6384.0,
      "formatted_start": "01:46:22.000",
      "formatted_end": "01:46:24.000",
      "text": "بفرم خوشمان"
    },
    {
      "id": 14,
      "start": 6384.0,
      "end": 6386.0,
      "formatted_start": "01:46:24.000",
      "formatted_end": "01:46:26.000",
      "text": "سلامت باشید"
    },
    {
      "id": 15,
      "start": 6386.0,
      "end": 6388.0,
      "formatted_start": "01:46:26.000",
      "formatted_end": "01:46:28.000",
      "text": "بفرم"
    },
    {
      "id": 16,
      "start": 6388.0,
      "end": 6390.0,
      "formatted_start": "01:46:28.000",
      "formatted_end": "01:46:30.000",
      "text": "که از اینجوریتونو بیزنند بدید خانمه؟"
    },
    {
      "id": 17,
      "start": 6390.0,
      "end": 6391.0,
      "formatted_start": "01:46:30.000",
      "formatted_end": "01:46:31.000",
      "text": "بله که بیزنم"
    },
    {
      "id": 18,
      "start": 6391.0,
      "end": 6393.0,
      "formatted_start": "01:46:31.000",
      "formatted_end": "01:46:33.000",
      "text": "باقی از اینکه منشین داده"
    },
    {
      "id": 19,
      "start": 6393.0,
      "end": 6395.0,
