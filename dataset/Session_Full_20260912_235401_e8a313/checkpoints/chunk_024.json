  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7205.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:05.000",
      "text": "باشه، بذاری من با قاسمی صحبت کنم، خوب؟ باشه، مرسی، ممنون."
    },
    {
      "id": 1,
      "start": 7205.0,
      "end": 7209.0,
      "formatted_start": "02:00:05.000",
      "formatted_end": "02:00:09.000",
      "text": "حالا، حالا، حالا، قبل از خریصت دادیم، مرسی، ممنون، خداحافظ."
    },
    {
      "id": 2,
      "start": 7209.0,
      "end": 7211.0,
      "formatted_start": "02:00:09.000",
      "formatted_end": "02:00:11.000",
      "text": "بخشید"
    },
    {
      "id": 3,
      "start": 7239.0,
      "end": 7239.82,
      "formatted_start": "02:00:39.000",
      "formatted_end": "02:00:39.820",
      "text": "آره آره"
    },
    {
      "id": 4,
      "start": 7239.82,
      "end": 7240.68,
      "formatted_start": "02:00:39.820",
      "formatted_end": "02:00:40.680",
      "text": "بزید کلیب"
    },
    {
      "id": 5,
      "start": 7240.68,
      "end": 7241.28,
      "formatted_start": "02:00:40.680",
      "formatted_end": "02:00:41.280",
      "text": "نه بزید"
    },
    {
      "id": 6,
      "start": 7242.7,
      "end": 7244.14,
      "formatted_start": "02:00:42.700",
      "formatted_end": "02:00:44.140",
      "text": "93، 65"
    },
    {
      "id": 7,
      "start": 7244.74,
      "end": 7246.74,
      "formatted_start": "02:00:44.740",
      "formatted_end": "02:00:46.740",
      "text": "چون کلیبیسکوری نداری این زمان"
    },
    {
      "id": 8,
      "start": 7247.88,
      "end": 7250.28,
      "formatted_start": "02:00:47.880",
      "formatted_end": "02:00:50.280",
      "text": "این کلیبیسکوری کچی بود، نتونه اومدید"
    },
    {
      "id": 9,
      "start": 7251.48,
      "end": 7251.98,
      "formatted_start": "02:00:51.480",
      "formatted_end": "02:00:51.980",
      "text": "آه؟"
    },
    {
      "id": 10,
      "start": 7254.4,
      "end": 7257.68,
      "formatted_start": "02:00:54.400",
      "formatted_end": "02:00:57.680",
      "text": "آره، با اون بزرگ می بشید، کلیبیسکوری کچی که کچی گاره"
    },
    {
      "id": 11,
      "start": 7258.22,
      "end": 7260.52,
      "formatted_start": "02:00:58.220",
      "formatted_end": "02:01:00.520",
      "text": "اون مثل شمشیره، بیا من ببینم"
    },
    {
      "id": 12,
      "start": 7261.32,
      "end": 7263.0,
      "formatted_start": "02:01:01.320",
      "formatted_end": "02:01:03.000",
      "text": "اون خیلی بزرگه، تیره میشه"
    },
    {
      "id": 13,
      "start": 7269.0,
      "end": 7271.0,
      "formatted_start": "02:01:09.000",
      "formatted_end": "02:01:11.000",
      "text": "بخونیم سلام"
    },
    {
      "id": 14,
      "start": 7271.0,
      "end": 7273.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:13.000",
      "text": "بخونیم سلام"
    },
    {
      "id": 15,
      "start": 7273.0,
      "end": 7275.0,
      "formatted_start": "02:01:13.000",
      "formatted_end": "02:01:15.000",
      "text": "بخونیم سلام"
    },
    {
      "id": 16,
      "start": 7275.0,
      "end": 7277.0,
      "formatted_start": "02:01:15.000",
      "formatted_end": "02:01:17.000",
      "text": "اما آمده زدیم؟"
    },
    {
      "id": 17,
      "start": 7277.0,
      "end": 7279.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:19.000",
      "text": "آمده زدیم این تصمیم نمیشه"
    },
    {
      "id": 18,
      "start": 7279.0,
      "end": 7281.0,
      "formatted_start": "02:01:19.000",
      "formatted_end": "02:01:21.000",
      "text": "ببینیم"
    },
    {
      "id": 19,
      "start": 7281.0,
      "end": 7283.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:23.000",
      "text": "ببینیم"
    },
    {
      "id": 20,
      "start": 7283.0,
      "end": 7285.0,
      "formatted_start": "02:01:23.000",
      "formatted_end": "02:01:25.000",
      "text": "آقایی تیغ بیستولی کچیت بیاد"
    },
    {
      "id": 21,
      "start": 7285.0,
      "end": 7287.0,
      "formatted_start": "02:01:25.000",
      "formatted_end": "02:01:27.000",
      "text": "در اون تیغی کچیته"
    },
    {
      "id": 22,
      "start": 7287.0,
      "end": 7289.0,
      "formatted_start": "02:01:27.000",
      "formatted_end": "02:01:29.000",
      "text": "اون تیغ بیستولی کنیم تیغی بزرگ بود"
    },
    {
      "id": 23,
      "start": 7289.0,
      "end": 7291.0,
      "formatted_start": "02:01:29.000",
      "formatted_end": "02:01:31.000",
      "text": "ما یک بخشی از دو سه بوم"
    },
    {
      "id": 24,
      "start": 7291.0,
      "end": 7293.0,
      "formatted_start": "02:01:31.000",
      "formatted_end": "02:01:33.000",
      "text": "اینو برداشتیم"
    },
    {
      "id": 25,
      "start": 7293.0,
      "end": 7295.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:35.000",
      "text": "تیغا وقتی بزرگ هم"
    },
    {
      "id": 26,
      "start": 7295.0,
      "end": 7297.0,
      "formatted_start": "02:01:35.000",
      "formatted_end": "02:01:37.000",
      "text": "این اندازه بود"
    },
    {
      "id": 27,
      "start": 7297.0,
      "end": 7302.0,
      "formatted_start": "02:01:37.000",
      "formatted_end": "02:01:42.000",
      "text": "این وقتی ریز باشی نمیتونید. تیغ باید کچیک باشید و برد از پایین."
    },
    {
      "id": 28,
      "start": 7302.0,
      "end": 7306.0,
      "formatted_start": "02:01:42.000",
      "formatted_end": "02:01:46.000",
      "text": "چون شما یه زمانت باشید. یه تیغ بسیاری کچیک بیارید و..."
    },
    {
      "id": 29,
      "start": 7306.0,
      "end": 7307.0,
      "formatted_start": "02:01:46.000",
      "formatted_end": "02:01:47.000",
      "text": "با چی بیارید؟"
    },
    {
      "id": 30,
      "start": 7307.0,
      "end": 7310.0,
      "formatted_start": "02:01:47.000",
      "formatted_end": "02:01:50.000",
      "text": "من بهتون میرنم. با تیغ بسیاری."
    },
    {
      "id": 31,
      "start": 7310.0,
      "end": 7311.0,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:51.000",
      "text": "این فواد دارید تدراسیک نیست؟"
    },
    {
      "id": 32,
      "start": 7311.0,
      "end": 7312.0,
      "formatted_start": "02:01:51.000",
      "formatted_end": "02:01:52.000",
      "text": "بله."
    },
    {
      "id": 33,
      "start": 7312.0,
      "end": 7315.0,
      "formatted_start": "02:01:52.000",
      "formatted_end": "02:01:55.000",
      "text": "این فواد باید میارید. یا باید جدید بخرید یا باید..."
    },
    {
      "id": 34,
      "start": 7315.0,
      "end": 7317.0,
      "formatted_start": "02:01:55.000",
      "formatted_end": "02:01:57.000",
      "text": "چون این فواد هم باید روش بزن."
    },
    {
      "id": 35,
      "start": 7317.0,
      "end": 7319.0,
      "formatted_start": "02:01:57.000",
      "formatted_end": "02:01:59.000",
      "text": "شما نه نه. یه نمیگه."
    },
    {
      "id": 36,
      "start": 7319.0,
      "end": 7323.96,
      "formatted_start": "02:01:59.000",
      "formatted_end": "02:02:03.960",
      "text": "این تیگ کوچک میخواد که من از پایین اینو بگو"
    },
    {
      "id": 37,
      "start": 7323.96,
      "end": 7326.76,
      "formatted_start": "02:02:03.960",
      "formatted_end": "02:02:06.760",
      "text": "چون فقط تیگ بستوری کوچک بیاد"
    },
    {
      "id": 38,
      "start": 7326.76,
      "end": 7329.56,
      "formatted_start": "02:02:06.760",
      "formatted_end": "02:02:09.560",
      "text": "باید بزرگ باشیم من همین رو خواست بیارم"
    },
    {
      "id": 39,
      "start": 7329.56,
      "end": 7333.76,
      "formatted_start": "02:02:09.560",
      "formatted_end": "02:02:13.760",
      "text": "تیگ بستوریتون بزرگ بود"
    },
    {
      "id": 40,
      "start": 7333.76,
      "end": 7337.56,
      "formatted_start": "02:02:13.760",
      "formatted_end": "02:02:17.560",
      "text": "ما که برای صدید دو سه مومه گرفتیم اون پایینیشو"
    },
    {
      "id": 41,
      "start": 7337.56,
      "end": 7340.0,
      "formatted_start": "02:02:17.560",
      "formatted_end": "02:02:20.000",
      "text": "تیگ بستوری کوچک"
    },
    {
      "id": 42,
      "start": 7340.0,
      "end": 7343.0,
      "formatted_start": "02:02:20.000",
      "formatted_end": "02:02:23.000",
      "text": "بعد"
    },
    {
      "id": 43,
      "start": 7343.0,
      "end": 7349.0,
      "formatted_start": "02:02:23.000",
      "formatted_end": "02:02:29.000",
      "text": "تیگ بستوری کوچک یک گازه سریز"
    },
    {
      "id": 44,
      "start": 7349.0,
      "end": 7353.56,
      "formatted_start": "02:02:29.000",
      "formatted_end": "02:02:33.560",
      "text": "و یه پوماد تترا سکلی"
    },
    {
      "id": 45,
      "start": 7353.56,
      "end": 7357.06,
      "formatted_start": "02:02:33.560",
      "formatted_end": "02:02:37.060",
      "text": "حتما کوچک باشه آیا"
    },
    {
      "id": 46,
      "start": 7357.06,
      "end": 7358.44,
      "formatted_start": "02:02:37.060",
      "formatted_end": "02:02:38.440",
      "text": "نخواه اون رو نمیخواد؟"
    },
    {
      "id": 47,
      "start": 7358.44,
      "end": 7359.56,
      "formatted_start": "02:02:38.440",
      "formatted_end": "02:02:39.560",
      "text": "نه نخواه باقیه نمیخواد"
    },
    {
      "id": 48,
      "start": 7359.56,
      "end": 7361.0,
      "formatted_start": "02:02:39.560",
      "formatted_end": "02:02:41.000",
      "text": "اون دیگه اونجا نمیشه باقیه"
    },
    {
      "id": 49,
      "start": 7361.0,
      "end": 7361.6,
      "formatted_start": "02:02:41.000",
      "formatted_end": "02:02:41.600",
      "text": "اونجا باقیه باقیه"
    },
    {
      "id": 50,
      "start": 7361.6,
      "end": 7363.06,
      "formatted_start": "02:02:41.600",
      "formatted_end": "02:02:43.060",
      "text": "فقط با برید شاید یکم خود بیاد"
    },
    {
      "id": 51,
      "start": 7363.06,
      "end": 7364.0,
      "formatted_start": "02:02:43.060",
      "formatted_end": "02:02:44.000",
      "text": "پوماد بزنگ"
    },
    {
      "id": 52,
      "start": 7364.0,
      "end": 7365.4,
      "formatted_start": "02:02:44.000",
      "formatted_end": "02:02:45.400",
      "text": "کمپلیسیر پشار بیدید"
    },
    {
      "id": 53,
      "start": 7365.4,
      "end": 7366.1,
      "formatted_start": "02:02:45.400",
      "formatted_end": "02:02:46.100",
      "text": "بسته"
    },
    {
      "id": 54,
      "start": 7366.1,
      "end": 7367.6,
      "formatted_start": "02:02:46.100",
      "formatted_end": "02:02:47.600",
      "text": "شاید اینو بیشتر ازن کشی کنم"
    },
    {
      "id": 55,
      "start": 7367.6,
      "end": 7368.74,
      "formatted_start": "02:02:47.600",
      "formatted_end": "02:02:48.740",
      "text": "ازشون گیوی مونی مونی"
    },
    {
      "id": 56,
      "start": 7368.74,
      "end": 7369.4,
      "formatted_start": "02:02:48.740",
      "formatted_end": "02:02:49.400",
      "text": "آره"
    },
    {
      "id": 57,
      "start": 7369.4,
      "end": 7370.1,
      "formatted_start": "02:02:49.400",
      "formatted_end": "02:02:50.100",
      "text": "بخواهم بزارون"
    },
    {
      "id": 58,
      "start": 7370.1,
      "end": 7372.1,
      "formatted_start": "02:02:50.100",
      "formatted_end": "02:02:52.100",
      "text": "بس میشه میخواهم بکشیم"
    },
    {
      "id": 59,
      "start": 7372.1,
      "end": 7374.1,
      "formatted_start": "02:02:52.100",
      "formatted_end": "02:02:54.100",
      "text": "بله خیلی جدید"
    },
    {
      "id": 60,
      "start": 7374.1,
      "end": 7378.1,
      "formatted_start": "02:02:54.100",
      "formatted_end": "02:02:58.100",
      "text": "به پاهم پنجشنبه یه دنار اومد خیلی بزرگ بود"
    },
    {
      "id": 61,
      "start": 7378.1,
      "end": 7379.1,
      "formatted_start": "02:02:58.100",
      "formatted_end": "02:02:59.100",
      "text": "اصلا خیلی راحت"
    },
    {
      "id": 62,
      "start": 7379.1,
      "end": 7382.1,
      "formatted_start": "02:02:59.100",
      "formatted_end": "02:03:02.100",
      "text": "سپیخ هم بزرگ بوده باید اون بروش بود"
    },
    {
      "id": 63,
      "start": 7382.1,
      "end": 7385.1,
      "formatted_start": "02:03:02.100",
      "formatted_end": "02:03:05.100",
      "text": "مثل یک چیز پرنگی بود"
    },
    {
      "id": 64,
      "start": 7385.1,
      "end": 7386.1,
      "formatted_start": "02:03:05.100",
      "formatted_end": "02:03:06.100",
      "text": "درسته"
    },
    {
      "id": 65,
      "start": 7386.1,
      "end": 7389.1,
      "formatted_start": "02:03:06.100",
      "formatted_end": "02:03:09.100",
      "text": "این چهار کیلو و پانصر"
    },
    {
      "id": 66,
      "start": 7389.1,
      "end": 7391.1,
      "formatted_start": "02:03:09.100",
      "formatted_end": "02:03:11.100",
      "text": "نمیدونه"
    },
    {
      "id": 67,
      "start": 7391.1,
      "end": 7394.1,
      "formatted_start": "02:03:11.100",
      "formatted_end": "02:03:14.100",
      "text": "پنجشنبه همه نداره یکمه داره"
    },
    {
      "id": 68,
      "start": 7394.1,
      "end": 7396.1,
      "formatted_start": "02:03:14.100",
      "formatted_end": "02:03:16.100",
      "text": "اون مقداری که مونده اعتماد همون مقدار"
    },
    {
      "id": 69,
      "start": 7396.1,
      "end": 7398.1,
      "formatted_start": "02:03:16.100",
      "formatted_end": "02:03:18.100",
      "text": "درسته شما دایجی میخواهم نمیزه داریم"
    },
    {
      "id": 70,
      "start": 7398.1,
      "end": 7400.1,
      "formatted_start": "02:03:18.100",
      "formatted_end": "02:03:20.100",
      "text": "کامسمی چست داریم دیگه"
    },
    {
      "id": 71,
      "start": 7400.1,
      "end": 7402.1,
      "formatted_start": "02:03:20.100",
      "formatted_end": "02:03:22.100",
      "text": "یه سارم اگه چست نداریم"
    },
    {
      "id": 72,
      "start": 7402.1,
      "end": 7404.1,
      "formatted_start": "02:03:22.100",
      "formatted_end": "02:03:24.100",
      "text": "آره بسته"
    },
    {
      "id": 73,
      "start": 7404.1,
      "end": 7406.1,
      "formatted_start": "02:03:24.100",
      "formatted_end": "02:03:26.100",
      "text": "آره بسته"
    },
    {
      "id": 74,
      "start": 7406.1,
      "end": 7408.1,
      "formatted_start": "02:03:26.100",
      "formatted_end": "02:03:28.100",
      "text": "آره بسته"
    },
    {
      "id": 75,
      "start": 7408.1,
      "end": 7410.1,
      "formatted_start": "02:03:28.100",
      "formatted_end": "02:03:30.100",
      "text": "آره بسته"
    },
    {
      "id": 76,
      "start": 7410.1,
      "end": 7412.1,
      "formatted_start": "02:03:30.100",
      "formatted_end": "02:03:32.100",
      "text": "آره بسته"
    },
    {
      "id": 77,
      "start": 7412.1,
      "end": 7414.1,
      "formatted_start": "02:03:32.100",
      "formatted_end": "02:03:34.100",
      "text": "آره بسته"
    },
    {
      "id": 78,
      "start": 7414.1,
      "end": 7416.1,
      "formatted_start": "02:03:34.100",
      "formatted_end": "02:03:36.100",
      "text": "آره بسته"
    },
    {
      "id": 79,
      "start": 7416.1,
      "end": 7418.1,
      "formatted_start": "02:03:36.100",
      "formatted_end": "02:03:38.100",
      "text": "بسته"
    },
    {
      "id": 80,
      "start": 7418.1,
      "end": 7420.1,
      "formatted_start": "02:03:38.100",
      "formatted_end": "02:03:40.100",
      "text": "بسته"
    },
    {
      "id": 81,
      "start": 7420.1,
      "end": 7422.1,
      "formatted_start": "02:03:40.100",
      "formatted_end": "02:03:42.100",
      "text": "بسته"
    },
    {
      "id": 82,
      "start": 7422.1,
      "end": 7424.1,
      "formatted_start": "02:03:42.100",
      "formatted_end": "02:03:44.100",
      "text": "بسته"
    },
    {
      "id": 83,
      "start": 7424.1,
      "end": 7426.1,
      "formatted_start": "02:03:44.100",
      "formatted_end": "02:03:46.100",
      "text": "بسته"
    },
    {
      "id": 84,
      "start": 7426.1,
      "end": 7428.1,
      "formatted_start": "02:03:46.100",
      "formatted_end": "02:03:48.100",
      "text": "چون همه از هم زردی مقدار داره"
    },
    {
      "id": 85,
      "start": 7428.1,
      "end": 7430.1,
      "formatted_start": "02:03:48.100",
      "formatted_end": "02:03:50.100",
      "text": "بچه حتما جیششو میگه"
    },
    {
      "id": 86,
      "start": 7430.1,
      "end": 7432.1,
      "formatted_start": "02:03:50.100",
      "formatted_end": "02:03:52.100",
      "text": "این هم زرده"
    },
    {
      "id": 87,
      "start": 7432.1,
      "end": 7434.1,
      "formatted_start": "02:03:52.100",
      "formatted_end": "02:03:54.100",
      "text": "خوب"
    },
    {
      "id": 88,
      "start": 7434.1,
      "end": 7436.1,
      "formatted_start": "02:03:54.100",
      "formatted_end": "02:03:56.100",
      "text": "این رو دستگاه بگذار"
    },
    {
      "id": 89,
      "start": 7436.1,
      "end": 7440.1,
      "formatted_start": "02:03:56.100",
      "formatted_end": "02:04:00.100",
      "text": "آزمایش ادرالش رو میگی"
    },
    {
      "id": 90,
      "start": 7440.1,
      "end": 7442.1,
      "formatted_start": "02:04:00.100",
      "formatted_end": "02:04:02.100",
      "text": "گروه خونی چی بود؟"
    },
    {
      "id": 91,
      "start": 7442.1,
      "end": 7444.1,
      "formatted_start": "02:04:02.100",
      "formatted_end": "02:04:04.100",
      "text": "او این"
    },
    {
      "id": 92,
      "start": 7444.1,
      "end": 7446.1,
      "formatted_start": "02:04:04.100",
      "formatted_end": "02:04:06.100",
      "text": "تا چه دوز"
    },
    {
      "id": 93,
      "start": 7446.1,
      "end": 7448.1,
      "formatted_start": "02:04:06.100",
      "formatted_end": "02:04:08.100",
      "text": "ببین"
    },
    {
      "id": 94,
      "start": 7448.1,
      "end": 7450.1,
      "formatted_start": "02:04:08.100",
      "formatted_end": "02:04:10.100",
      "text": "او ها بالا میشن"
    },
    {
      "id": 95,
      "start": 7450.1,
      "end": 7452.1,
      "formatted_start": "02:04:10.100",
      "formatted_end": "02:04:12.100",
      "text": "خوب"
    },
    {
      "id": 96,
      "start": 7452.1,
      "end": 7454.1,
      "formatted_start": "02:04:12.100",
      "formatted_end": "02:04:14.100",
      "text": "این گروه خونی بله"
    },
    {
      "id": 97,
      "start": 7454.1,
      "end": 7456.1,
      "formatted_start": "02:04:14.100",
      "formatted_end": "02:04:16.100",
      "text": "آزمایش اجراری حتما دیدید؟"
    },
    {
      "id": 98,
      "start": 7456.1,
      "end": 7458.1,
      "formatted_start": "02:04:16.100",
      "formatted_end": "02:04:18.100",
      "text": "تیز کلوری گرفتیم؟"
    },
    {
      "id": 99,
      "start": 7458.1,
      "end": 7460.1,
      "formatted_start": "02:04:18.100",
      "formatted_end": "02:04:20.100",
      "text": "آره روستا برمیدیم"
    },
    {
      "id": 100,
      "start": 7460.1,
      "end": 7462.1,
      "formatted_start": "02:04:20.100",
      "formatted_end": "02:04:22.100",
      "text": "مشکلی که نداری؟"
    },
    {
      "id": 101,
      "start": 7462.1,
      "end": 7464.1,
      "formatted_start": "02:04:22.100",
      "formatted_end": "02:04:24.100",
      "text": "آزمایش اجراری کسی اجراری بزنید که بتونید دیدید؟"
    },
    {
      "id": 102,
      "start": 7464.1,
      "end": 7466.1,
      "formatted_start": "02:04:24.100",
      "formatted_end": "02:04:26.100",
      "text": "دیستر دارم اونجا گذاشتم نشد"
    },
    {
      "id": 103,
      "start": 7466.1,
      "end": 7468.1,
      "formatted_start": "02:04:26.100",
      "formatted_end": "02:04:28.100",
      "text": "را فراموش کشمشیم"
    },
    {
