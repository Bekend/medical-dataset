      "start": 7485.1,
      "end": 7487.1,
      "formatted_start": "02:04:45.100",
      "formatted_end": "02:04:47.100",
      "text": "بردم زرد بگیرد"
    },
    {
      "id": 112,
      "start": 7487.1,
      "end": 7489.1,
      "formatted_start": "02:04:47.100",
      "formatted_end": "02:04:49.100",
      "text": "یک دو شب دیگه دستگاه دارد یک کنم"
