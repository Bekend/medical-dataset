      "end": 12360.0,
      "formatted_start": "03:25:58.000",
      "formatted_end": "03:26:00.000",
      "text": "این درمون؟"
    },
    {
      "id": 22,
      "start": 12360.0,
      "end": 12362.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:02.000",
      "text": "از درمون"
    },
    {
      "id": 23,
      "start": 12362.0,
      "end": 12364.0,
      "formatted_start": "03:26:02.000",
      "formatted_end": "03:26:04.000",
      "text": "و تو صورتش هم خیلی دوسته"
    },
    {
      "id": 24,
      "start": 12364.0,
      "end": 12366.0,
      "formatted_start": "03:26:04.000",
      "formatted_end": "03:26:06.000",
      "text": "خونت اگزمای شیرخواران"
    },
    {
      "id": 25,
      "start": 12366.0,
      "end": 12367.0,
      "formatted_start": "03:26:06.000",
      "formatted_end": "03:26:07.000",
      "text": "هم بوسیدن نیست"
    },
    {
      "id": 26,
      "start": 12367.0,
      "end": 12368.0,
      "formatted_start": "03:26:07.000",
      "formatted_end": "03:26:08.000",
      "text": "زبر و خشکه"
    },
    {
      "id": 27,
      "start": 12368.0,
      "end": 12369.0,
      "formatted_start": "03:26:08.000",
      "formatted_end": "03:26:09.000",
      "text": "بعضی موقعات زیاد میشه"
    },
    {
      "id": 28,
      "start": 12369.0,
      "end": 12370.0,
      "formatted_start": "03:26:09.000",
      "formatted_end": "03:26:10.000",
      "text": "بعضی موقعات کم نیست"
    },
    {
      "id": 29,
      "start": 12370.0,
      "end": 12371.0,
      "formatted_start": "03:26:10.000",
      "formatted_end": "03:26:11.000",
      "text": "پدر اشکل"
    },
    {
      "id": 30,
      "start": 12371.0,
      "end": 12372.0,
      "formatted_start": "03:26:11.000",
      "formatted_end": "03:26:12.000",
      "text": "پدر اشکل"
    },
    {
      "id": 31,
      "start": 12372.0,
      "end": 12373.0,
      "formatted_start": "03:26:12.000",
      "formatted_end": "03:26:13.000",
      "text": "این کار زارتان دوسته"
    },
    {
      "id": 32,
      "start": 12373.0,
      "end": 12374.0,
      "formatted_start": "03:26:13.000",
      "formatted_end": "03:26:14.000",
      "text": "نه اشکل نداره"
    },
    {
      "id": 33,
      "start": 12374.0,
      "end": 12375.0,
      "formatted_start": "03:26:14.000",
      "formatted_end": "03:26:15.000",
      "text": "از سیویلا باشه"
    },
    {
      "id": 34,
      "start": 12375.0,
      "end": 12376.0,
      "formatted_start": "03:26:15.000",
      "formatted_end": "03:26:16.000",
      "text": "نه نه"
    },
    {
      "id": 35,
      "start": 12376.0,
      "end": 12378.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:18.000",
      "text": "این هم فکر کنن بوسیده ای"
    },
    {
      "id": 36,
      "start": 12378.0,
      "end": 12382.5,
      "formatted_start": "03:26:18.000",
      "formatted_end": "03:26:22.500",
      "text": "نه ارتباطی نداره این همه ایزام های شیرخوارانه"
    },
    {
      "id": 37,
      "start": 12382.5,
      "end": 12385.5,
      "formatted_start": "03:26:22.500",
      "formatted_end": "03:26:25.500",
      "text": "غذا های گرمی تصدیب داره خورما هایی"
    },
    {
      "id": 38,
      "start": 12385.5,
      "end": 12388.5,
      "formatted_start": "03:26:25.500",
      "formatted_end": "03:26:28.500",
      "text": "از این وقت به دانیا آمد این دوش هایی بسیار داره"
    },
    {
      "id": 39,
      "start": 12388.5,
      "end": 12390.5,
      "formatted_start": "03:26:28.500",
      "formatted_end": "03:26:30.500",
      "text": "این هایی دکتر که بسیار داره"
    },
    {
      "id": 40,
      "start": 12390.5,
      "end": 12393.5,
      "formatted_start": "03:26:30.500",
      "formatted_end": "03:26:33.500",
      "text": "ما از سیسمبرگیم"
    },
    {
      "id": 41,
      "start": 12393.5,
      "end": 12395.5,
      "formatted_start": "03:26:33.500",
      "formatted_end": "03:26:35.500",
      "text": "و مسافریم"
    },
    {
      "id": 42,
      "start": 12395.5,
      "end": 12398.5,
      "formatted_start": "03:26:35.500",
      "formatted_end": "03:26:38.500",
      "text": "بعد شما این قابلیت رو داریم که"
    },
    {
      "id": 43,
      "start": 12398.5,
      "end": 12401.5,
      "formatted_start": "03:26:38.500",
      "formatted_end": "03:26:41.500",
      "text": "مثلا ویزیت بکنین تلفونی با اتون"
    },
    {
      "id": 44,
      "start": 12401.5,
      "end": 12404.5,
      "formatted_start": "03:26:41.500",
      "formatted_end": "03:26:44.500",
      "text": "آنلاین بعضی برنیزه همه هایی از اسفه ها میده جایی دیگه"
    },
    {
      "id": 45,
      "start": 12404.5,
      "end": 12406.5,
      "formatted_start": "03:26:44.500",
      "formatted_end": "03:26:46.500",
      "text": "اگر این کار چون پزش رو برده باشید"
    },
    {
      "id": 46,
      "start": 12406.5,
      "end": 12410.0,
      "formatted_start": "03:26:46.500",
      "formatted_end": "03:26:50.000",
      "text": "اونا چیزی با منشین همه های میپنه تو زمان همین ساعت هایی که ما هستیم"
    },
    {
      "id": 47,
      "start": 12410.0,
      "end": 12415.24,
      "formatted_start": "03:26:50.000",
      "formatted_end": "03:26:55.240",
      "text": "باشه من در زمان بی فرادی همینو با 15 قطعه رو"
    },
    {
      "id": 48,
      "start": 12415.24,
      "end": 12417.12,
      "formatted_start": "03:26:55.240",
      "formatted_end": "03:26:57.120",
      "text": "کلیف رو بدین دیگه نمی نمیسن"
    },
    {
      "id": 49,
      "start": 12417.12,
      "end": 12417.5,
      "formatted_start": "03:26:57.120",
      "formatted_end": "03:26:57.500",
      "text": "خب"
    },
    {
      "id": 50,
      "start": 12417.5,
      "end": 12419.48,
      "formatted_start": "03:26:57.500",
      "formatted_end": "03:26:59.480",
      "text": "فلایل چین"
    },
    {
      "id": 51,
      "start": 12419.48,
      "end": 12421.4,
      "formatted_start": "03:26:59.480",
      "formatted_end": "03:27:01.400",
      "text": "کیت"
    },
    {
      "id": 52,
      "start": 12421.4,
      "end": 12423.18,
      "formatted_start": "03:27:01.400",
      "formatted_end": "03:27:03.180",
      "text": "هر هستر"
    },
    {
      "id": 53,
      "start": 12423.18,
      "end": 12424.74,
      "formatted_start": "03:27:03.180",
      "formatted_end": "03:27:04.740",
      "text": "سورفه بفتیم"
    },
    {
      "id": 54,
      "start": 12424.74,
      "end": 12425.9,
      "formatted_start": "03:27:04.740",
      "formatted_end": "03:27:05.900",
      "text": "اصلا روز 3-4 تا"
    },
    {
      "id": 55,
      "start": 12425.9,
      "end": 12429.3,
      "formatted_start": "03:27:05.900",
      "formatted_end": "03:27:09.300",
      "text": "از دیشب دو سه تا سورفه موچین کامش بیریم"
    },
    {
      "id": 56,
      "start": 12429.3,
      "end": 12430.46,
      "formatted_start": "03:27:09.300",
      "formatted_end": "03:27:10.460",
      "text": "اونها رو دیگه سخت نگیریم"
    },
    {
      "id": 57,
      "start": 12430.46,
      "end": 12432.0,
      "formatted_start": "03:27:10.460",
      "formatted_end": "03:27:12.000",
      "text": "اون همه که بینیش گرفتی دارن"
    },
    {
      "id": 58,
      "start": 12432.0,
      "end": 12432.78,
      "formatted_start": "03:27:12.000",
      "formatted_end": "03:27:12.780",
      "text": "قطعه نیست"
    },
    {
      "id": 59,
      "start": 12432.78,
      "end": 12434.22,
      "formatted_start": "03:27:12.780",
      "formatted_end": "03:27:14.220",
      "text": "قبل این که"
    },
    {
      "id": 60,
      "start": 12434.22,
      "end": 12436.64,
      "formatted_start": "03:27:14.220",
      "formatted_end": "03:27:16.640",
      "text": "یه نفر هم سرما خورده"
    },
    {
      "id": 61,
      "start": 12436.64,
      "end": 12437.76,
      "formatted_start": "03:27:16.640",
      "formatted_end": "03:27:17.760",
      "text": "بچه هم ضعیفه"
    },
    {
      "id": 62,
      "start": 12437.76,
      "end": 12439.76,
      "formatted_start": "03:27:17.760",
      "formatted_end": "03:27:19.760",
      "text": "کارو اقلانی انجام دادید"
    },
    {
      "id": 63,
      "start": 12439.76,
      "end": 12441.76,
      "formatted_start": "03:27:19.760",
      "formatted_end": "03:27:21.760",
      "text": "یه پماد هم برای صورتش"
    },
    {
      "id": 64,
      "start": 12441.76,
      "end": 12443.76,
      "formatted_start": "03:27:21.760",
      "formatted_end": "03:27:23.760",
      "text": "میمیسم یه نقب کننده"
    },
    {
      "id": 65,
      "start": 12443.76,
      "end": 12445.76,
      "formatted_start": "03:27:23.760",
      "formatted_end": "03:27:25.760",
      "text": "اگه دانی هر روز بزنید"
    },
    {
      "id": 66,
      "start": 12445.76,
      "end": 12447.76,
      "formatted_start": "03:27:25.760",
      "formatted_end": "03:27:27.760",
      "text": "داریم دیجیم"
    },
    {
      "id": 67,
      "start": 12447.76,
      "end": 12449.76,
      "formatted_start": "03:27:27.760",
      "formatted_end": "03:27:29.760",
      "text": "این داروها رو هم بیاد کلیف هم دیدید"
    },
    {
      "id": 68,
      "start": 12449.76,
      "end": 12451.76,
      "formatted_start": "03:27:29.760",
      "formatted_end": "03:27:31.760",
      "text": "دیگه من ننوشتم"
    },
    {
      "id": 69,
      "start": 12451.76,
      "end": 12453.76,
      "formatted_start": "03:27:31.760",
      "formatted_end": "03:27:33.760",
      "text": "رژیم میتونم اینجا دوستم"
    },
    {
      "id": 70,
      "start": 12453.76,
      "end": 12455.76,
      "formatted_start": "03:27:33.760",
      "formatted_end": "03:27:35.760",
      "text": "اون شماره"
    },
    {
      "id": 71,
      "start": 12455.76,
      "end": 12457.76,
      "formatted_start": "03:27:35.760",
      "formatted_end": "03:27:37.760",
      "text": "تماس هم ها اینجا هسته دیگه هم"
    },
    {
      "id": 72,
      "start": 12457.76,
      "end": 12459.76,
      "formatted_start": "03:27:37.760",
      "formatted_end": "03:27:39.760",
      "text": "کلیفتون ها بزنید"
    },
    {
      "id": 73,
      "start": 12459.76,
      "end": 12461.76,
      "formatted_start": "03:27:39.760",
      "formatted_end": "03:27:41.760",
      "text": "مرشدونی بیاده اتومنی"
    },
    {
      "id": 74,
      "start": 12461.76,
      "end": 12463.76,
      "formatted_start": "03:27:41.760",
      "formatted_end": "03:27:43.760",
      "text": "قابل نداره این رو"
    },
    {
      "id": 75,
      "start": 12463.76,
      "end": 12465.76,
      "formatted_start": "03:27:43.760",
      "formatted_end": "03:27:45.760",
      "text": "این درده که شما را بگیرین"
    },
    {
      "id": 76,
      "start": 12465.76,
      "end": 12468.76,
      "formatted_start": "03:27:45.760",
      "formatted_end": "03:27:48.760",
      "text": "کارخان اینجا کارخان زحمت بگیره نه"
    },
    {
      "id": 77,
      "start": 12468.76,
      "end": 12469.76,
      "formatted_start": "03:27:48.760",
      "formatted_end": "03:27:49.760",
      "text": "من چقدر درده بگیرم؟"
    },
    {
      "id": 78,
      "start": 12469.76,
      "end": 12472.76,
      "formatted_start": "03:27:49.760",
      "formatted_end": "03:27:52.760",
      "text": "کارخان نداره، آزاد 700 هست"
    },
    {
      "id": 79,
      "start": 12472.76,
      "end": 12475.76,
      "formatted_start": "03:27:52.760",
      "formatted_end": "03:27:55.760",
      "text": "کارخان بگیرم، از دستگاه را بگیرم"
    },
    {
      "id": 80,
      "start": 12475.76,
      "end": 12477.76,
      "formatted_start": "03:27:55.760",
      "formatted_end": "03:27:57.760",
      "text": "همین شماره تماس داره"
    },
    {
      "id": 81,
      "start": 12477.76,
      "end": 12478.76,
      "formatted_start": "03:27:57.760",
      "formatted_end": "03:27:58.760",
      "text": "همین شماره"
    },
    {
      "id": 82,
      "start": 12478.76,
      "end": 12479.76,
      "formatted_start": "03:27:58.760",
      "formatted_end": "03:27:59.760",
      "text": "همین دو سا شماره تماس داره"
    },
    {
      "id": 83,
      "start": 12479.76,
      "end": 12480.76,
      "formatted_start": "03:27:59.760",
      "formatted_end": "03:28:00.760",
      "text": "خیلی ماشکل هستم"
    },
    {
      "id": 84,
      "start": 12480.76,
      "end": 12481.76,
      "formatted_start": "03:28:00.760",
      "formatted_end": "03:28:01.760",
      "text": "خواهش می کنم زنده باشید"
    },
    {
      "id": 85,
      "start": 12481.76,
      "end": 12482.76,
      "formatted_start": "03:28:01.760",
      "formatted_end": "03:28:02.760",
      "text": "خواهش می کنم نفر باشید"
    },
    {
      "id": 86,
      "start": 12482.76,
      "end": 12483.76,
      "formatted_start": "03:28:02.760",
      "formatted_end": "03:28:03.760",
      "text": "خواهش می کنم ندارم"
    },
    {
      "id": 87,
      "start": 12483.76,
      "end": 12485.76,
      "formatted_start": "03:28:03.760",
      "formatted_end": "03:28:05.760",
      "text": "سابطه را بکش بکنم"
    },
    {
      "id": 88,
      "start": 12485.76,
      "end": 12486.76,
      "formatted_start": "03:28:05.760",
      "formatted_end": "03:28:06.760",
      "text": "کدو بکنی؟"
    },
    {
      "id": 89,
      "start": 12486.76,
      "end": 12490.66,
      "formatted_start": "03:28:06.760",
      "formatted_end": "03:28:10.660",
      "text": "بکنم اون ثابت نه این سیاره ثابته برد"
    },
    {
      "id": 90,
      "start": 12490.66,
      "end": 12491.76,
      "formatted_start": "03:28:10.660",
      "formatted_end": "03:28:11.760",
      "text": "بکنم هر سایه"
    },
    {
      "id": 91,
      "start": 12491.76,
      "end": 12492.76,
      "formatted_start": "03:28:11.760",
      "formatted_end": "03:28:12.760",
      "text": "خیلی خوب شکر کردم مرسی"
    },
    {
      "id": 92,
      "start": 12492.76,
      "end": 12493.76,
      "formatted_start": "03:28:12.760",
      "formatted_end": "03:28:13.760",
      "text": "خب درستشون"
    },
    {
      "id": 93,
      "start": 12493.76,
      "end": 12494.76,
      "formatted_start": "03:28:13.760",
      "formatted_end": "03:28:14.760",
      "text": "خب درستشون"
    },
    {
      "id": 94,
      "start": 12494.76,
      "end": 12496.76,
      "formatted_start": "03:28:14.760",
      "formatted_end": "03:28:16.760",
      "text": "داروها رو بیادیم من ببینم"
    },
    {
      "id": 95,
      "start": 12496.76,
      "end": 12497.76,
      "formatted_start": "03:28:16.760",
      "formatted_end": "03:28:17.760",
      "text": "چند؟"
    },
    {
      "id": 96,
      "start": 12505.76,
      "end": 12506.76,
      "formatted_start": "03:28:25.760",
      "formatted_end": "03:28:26.760",
      "text": "دارو رو روز کردیم"
    },
    {
      "id": 97,
      "start": 12506.76,
      "end": 12508.76,
      "formatted_start": "03:28:26.760",
      "formatted_end": "03:28:28.760",
      "text": "خب برد خوشم دارو رو بیادیم من ببینم دیدی؟"
    },
    {
      "id": 98,
      "start": 12508.76,
      "end": 12509.76,
      "formatted_start": "03:28:28.760",
      "formatted_end": "03:28:29.760",
      "text": "برد"
    },
    {
      "id": 99,
      "start": 12509.76,
      "end": 12511.76,
      "formatted_start": "03:28:29.760",
      "formatted_end": "03:28:31.760",
      "text": "هر چرا کار نداری فقط یه نفر بیاد توضیح بدم"
    },
    {
      "id": 100,
      "start": 12511.76,
      "end": 12512.76,
      "formatted_start": "03:28:31.760",
      "formatted_end": "03:28:32.760",
      "text": "چند؟"
    },
    {
      "id": 101,
      "start": 12512.76,
      "end": 12513.76,
      "formatted_start": "03:28:32.760",
      "formatted_end": "03:28:33.760",
      "text": "خب درستشون"
    },
    {
      "id": 102,
      "start": 12513.76,
      "end": 12514.76,
      "formatted_start": "03:28:33.760",
      "formatted_end": "03:28:34.760",
      "text": "خب درستشون"
    },
    {
      "id": 103,
      "start": 12514.76,
      "end": 12516.76,
      "formatted_start": "03:28:34.760",
      "formatted_end": "03:28:36.760",
      "text": "برگرده"
    },
    {
      "id": 104,
      "start": 12544.76,
      "end": 12554.76,
      "formatted_start": "03:29:04.760",
      "formatted_end": "03:29:14.760",
      "text": "موسیقی"
    },
    {
