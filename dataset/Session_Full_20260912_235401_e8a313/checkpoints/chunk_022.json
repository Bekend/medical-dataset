  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6603.24,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:03.240",
      "text": "خب، برگتونه، ببینی چی شده امیرالدی رو؟"
    },
    {
      "id": 1,
      "start": 6603.24,
      "end": 6608.64,
      "formatted_start": "01:50:03.240",
      "formatted_end": "01:50:08.640",
      "text": "کازه طور از دیگه شب، آگهون میتونه، هشتش بند اومده بود، اصلا از خونه بود، من خواب بودم خواب."
    },
    {
      "id": 2,
      "start": 6608.64,
      "end": 6609.64,
      "formatted_start": "01:50:08.640",
      "formatted_end": "01:50:09.640",
      "text": "هنگیون هم فرد؟"
    },
    {
      "id": 3,
      "start": 6609.64,
      "end": 6612.68,
      "formatted_start": "01:50:09.640",
      "formatted_end": "01:50:12.680",
      "text": "نه، از خواب بیدا شده، این مثل چیز میشه، اونطوری شده."
    },
    {
      "id": 4,
      "start": 6612.68,
      "end": 6613.84,
      "formatted_start": "01:50:12.680",
      "formatted_end": "01:50:13.840",
      "text": "شفتی که بیشتر سازه؟"
    },
    {
      "id": 5,
      "start": 6613.84,
      "end": 6618.44,
      "formatted_start": "01:50:13.840",
      "formatted_end": "01:50:18.440",
      "text": "آردن، نه بدانم این چیه، بعضی شبها میشه، من نفهمیدم."
    },
    {
      "id": 6,
      "start": 6618.44,
      "end": 6621.0,
      "formatted_start": "01:50:18.440",
      "formatted_end": "01:50:21.000",
      "text": "الان از صبح میگه گلون، من نه بدانم بود."
    },
    {
      "id": 7,
      "start": 6621.0,
      "end": 6623.0,
      "formatted_start": "01:50:21.000",
      "formatted_end": "01:50:23.000",
      "text": "گلو درد می کنی؟ گلو می روی درد می کنی"
    },
    {
      "id": 8,
      "start": 6623.0,
      "end": 6624.0,
      "formatted_start": "01:50:23.000",
      "formatted_end": "01:50:24.000",
      "text": "صرفه؟"
    },
    {
      "id": 9,
      "start": 6624.0,
      "end": 6625.0,
      "formatted_start": "01:50:24.000",
      "formatted_end": "01:50:25.000",
      "text": "فیلا که نکنم"
    },
    {
      "id": 10,
      "start": 6625.0,
      "end": 6627.0,
      "formatted_start": "01:50:25.000",
      "formatted_end": "01:50:27.000",
      "text": "آب نیزه شخصه؟ نه نه نه"
    },
    {
      "id": 11,
      "start": 6627.0,
      "end": 6629.0,
      "formatted_start": "01:50:27.000",
      "formatted_end": "01:50:29.000",
      "text": "فقط گلو درد؟ گلو درد"
    },
    {
      "id": 12,
      "start": 6629.0,
      "end": 6631.0,
      "formatted_start": "01:50:29.000",
      "formatted_end": "01:50:31.000",
      "text": "بین جامعه کنی؟ ببین کنی"
    },
    {
      "id": 13,
      "start": 6631.0,
      "end": 6633.0,
      "formatted_start": "01:50:31.000",
      "formatted_end": "01:50:33.000",
      "text": "دردتو باز کن"
    },
    {
      "id": 14,
      "start": 6633.0,
      "end": 6635.0,
      "formatted_start": "01:50:33.000",
      "formatted_end": "01:50:35.000",
      "text": "روی؟ آه"
    },
    {
      "id": 15,
      "start": 6635.0,
      "end": 6637.0,
      "formatted_start": "01:50:35.000",
      "formatted_end": "01:50:37.000",
      "text": "فیلن چطوره؟ از راوی هست؟"
    },
    {
      "id": 16,
      "start": 6637.0,
      "end": 6639.0,
      "formatted_start": "01:50:37.000",
      "formatted_end": "01:50:39.000",
      "text": "خواهده؟ آه"
    },
    {
      "id": 17,
      "start": 6639.0,
      "end": 6641.0,
      "formatted_start": "01:50:39.000",
      "formatted_end": "01:50:41.000",
      "text": "از ما کمی می فاره آقای؟"
    },
    {
      "id": 18,
      "start": 6641.0,
      "end": 6643.0,
      "formatted_start": "01:50:41.000",
      "formatted_end": "01:50:43.000",
      "text": "دیروز باقی نرم نرم بودم اوها دکتر"
    },
    {
      "id": 19,
      "start": 6643.0,
      "end": 6645.0,
      "formatted_start": "01:50:43.000",
      "formatted_end": "01:50:45.000",
      "text": "باشی"
    },
    {
      "id": 20,
      "start": 6645.0,
      "end": 6647.0,
      "formatted_start": "01:50:45.000",
      "formatted_end": "01:50:47.000",
      "text": "اکی دیستر دیگه می فاره"
    },
    {
      "id": 21,
      "start": 6647.0,
      "end": 6649.0,
      "formatted_start": "01:50:47.000",
      "formatted_end": "01:50:49.000",
      "text": "او بر میریم؟ نه"
    },
    {
      "id": 22,
      "start": 6649.0,
      "end": 6652.0,
      "formatted_start": "01:50:49.000",
      "formatted_end": "01:50:52.000",
      "text": "کار آیا اوهای دکتر دادگاه اینو برده"
    },
    {
      "id": 23,
      "start": 6655.0,
      "end": 6657.0,
      "formatted_start": "01:50:55.000",
      "formatted_end": "01:50:57.000",
      "text": "اینو بری؟"
    },
    {
      "id": 24,
      "start": 6657.0,
      "end": 6661.0,
      "formatted_start": "01:50:57.000",
      "formatted_end": "01:51:01.000",
      "text": "تو بخشت اوهای دکتر که شکرمش کار کنست و خوب و شد"
    },
    {
      "id": 25,
      "start": 6661.0,
      "end": 6663.0,
      "formatted_start": "01:51:01.000",
      "formatted_end": "01:51:03.000",
      "text": "پشارشم منو تو بگم"
    },
    {
      "id": 26,
      "start": 6663.0,
      "end": 6665.0,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:05.000",
      "text": "مله"
    },
    {
      "id": 27,
      "start": 6665.0,
      "end": 6667.0,
      "formatted_start": "01:51:05.000",
      "formatted_end": "01:51:07.000",
      "text": "منگوشتو تکره نونگده"
    },
    {
      "id": 28,
      "start": 6667.0,
      "end": 6669.0,
      "formatted_start": "01:51:07.000",
      "formatted_end": "01:51:09.000",
      "text": "خب"
    },
    {
      "id": 29,
      "start": 6671.0,
      "end": 6673.0,
      "formatted_start": "01:51:11.000",
      "formatted_end": "01:51:13.000",
      "text": "این برده شبه همشه"
    },
    {
      "id": 30,
      "start": 6673.0,
      "end": 6676.3,
      "formatted_start": "01:51:13.000",
      "formatted_end": "01:51:16.300",
      "text": "اینجا من نمیدونم گفت که گلون پشکی کرده درد کرده"
    },
    {
      "id": 31,
      "start": 6676.3,
      "end": 6678.3,
      "formatted_start": "01:51:16.300",
      "formatted_end": "01:51:18.300",
      "text": "آره این گلون خواهد کرده ایست که شده"
    },
    {
      "id": 32,
      "start": 6678.3,
      "end": 6679.1,
      "formatted_start": "01:51:18.300",
      "formatted_end": "01:51:19.100",
      "text": "خواهد؟"
    },
    {
      "id": 33,
      "start": 6679.1,
      "end": 6683.06,
      "formatted_start": "01:51:19.100",
      "formatted_end": "01:51:23.060",
      "text": "خواهد به خاطر این درد رشاد خواهد خفیده بهش رسته ده"
    },
    {
      "id": 34,
      "start": 6683.06,
      "end": 6684.06,
      "formatted_start": "01:51:23.060",
      "formatted_end": "01:51:24.060",
      "text": "آه اگر"
    },
    {
      "id": 35,
      "start": 6684.06,
      "end": 6686.06,
      "formatted_start": "01:51:24.060",
      "formatted_end": "01:51:26.060",
      "text": "خواهد که اینجا رو برده می کنیم"
    },
    {
      "id": 36,
      "start": 6688.4,
      "end": 6690.4,
      "formatted_start": "01:51:28.400",
      "formatted_end": "01:51:30.400",
      "text": "میگم چاله هاییم"
    },
    {
      "id": 37,
      "start": 6691.6,
      "end": 6699.6,
      "formatted_start": "01:51:31.600",
      "formatted_end": "01:51:39.600",
      "text": "از کچی که دیگه آقا دوتا پیش شما هستن"
    },
    {
      "id": 38,
      "start": 6699.6,
      "end": 6701.6,
      "formatted_start": "01:51:39.600",
      "formatted_end": "01:51:41.600",
      "text": "آه دیگه خواهش می کنم"
    },
    {
      "id": 39,
      "start": 6701.6,
      "end": 6704.1,
      "formatted_start": "01:51:41.600",
      "formatted_end": "01:51:44.100",
      "text": "اینجا دیگه خودتون دادن این کلیو میبرن"
    },
    {
      "id": 40,
      "start": 6704.7,
      "end": 6706.7,
      "formatted_start": "01:51:44.700",
      "formatted_end": "01:51:46.700",
      "text": "خواهاتاً مامم فوت کرد دیگه"
    },
    {
      "id": 41,
      "start": 6706.7,
      "end": 6707.6,
      "formatted_start": "01:51:46.700",
      "formatted_end": "01:51:47.600",
      "text": "بادر احمد"
    },
    {
      "id": 42,
      "start": 6707.6,
      "end": 6708.66,
      "formatted_start": "01:51:47.600",
      "formatted_end": "01:51:48.660",
      "text": "بادر بیامون"
    },
    {
      "id": 43,
      "start": 6708.66,
      "end": 6709.6,
      "formatted_start": "01:51:48.660",
      "formatted_end": "01:51:49.600",
      "text": "یازده"
    },
    {
      "id": 44,
      "start": 6709.6,
      "end": 6710.72,
      "formatted_start": "01:51:49.600",
      "formatted_end": "01:51:50.720",
      "text": "پشارش خوبه"
    },
    {
      "id": 45,
      "start": 6710.72,
      "end": 6711.22,
      "formatted_start": "01:51:50.720",
      "formatted_end": "01:51:51.220",
      "text": "آره"
    },
    {
      "id": 46,
      "start": 6711.22,
      "end": 6712.66,
      "formatted_start": "01:51:51.220",
      "formatted_end": "01:51:52.660",
      "text": "اینه یا میگوید"
    },
    {
      "id": 47,
      "start": 6712.66,
      "end": 6714.2,
      "formatted_start": "01:51:52.660",
      "formatted_end": "01:51:54.200",
      "text": "آدنیزاد هیچی نیست"
    },
    {
      "id": 48,
      "start": 6714.2,
      "end": 6717.46,
      "formatted_start": "01:51:54.200",
      "formatted_end": "01:51:57.460",
      "text": "واقعا آدنیزاد هیچ چیزی کنی؟"
    },
    {
      "id": 49,
      "start": 6717.46,
      "end": 6719.5,
      "formatted_start": "01:51:57.460",
      "formatted_end": "01:51:59.500",
      "text": "اوازش به امیرالی"
    },
    {
      "id": 50,
      "start": 6719.5,
      "end": 6721.24,
      "formatted_start": "01:51:59.500",
      "formatted_end": "01:52:01.240",
      "text": "اواز خیلی به سوزش بود"
    },
    {
      "id": 51,
      "start": 6721.24,
      "end": 6722.1,
      "formatted_start": "01:52:01.240",
      "formatted_end": "01:52:02.100",
      "text": "آره"
    },
    {
      "id": 52,
      "start": 6722.1,
      "end": 6724.1,
      "formatted_start": "01:52:02.100",
      "formatted_end": "01:52:04.100",
      "text": "و همه چیزی که امیرالی بود"
    },
    {
      "id": 53,
      "start": 6724.1,
      "end": 6724.9,
      "formatted_start": "01:52:04.100",
      "formatted_end": "01:52:04.900",
      "text": "خب"
    },
    {
      "id": 54,
      "start": 6724.9,
      "end": 6726.9,
      "formatted_start": "01:52:04.900",
      "formatted_end": "01:52:06.900",
      "text": "به امیرالی هم فکر ماموزاکش بود"
    },
    {
      "id": 55,
      "start": 6726.9,
      "end": 6729.9,
      "formatted_start": "01:52:06.900",
      "formatted_end": "01:52:09.900",
      "text": "دیگه از که خودشو پشت هست دیگه"
    },
    {
      "id": 56,
      "start": 6729.9,
      "end": 6736.9,
      "formatted_start": "01:52:09.900",
      "formatted_end": "01:52:16.900",
      "text": "اما دکتر من شربت سلمان خود ریزان آوردم برد خشکن و آمپول داره یا نجانی؟"
    },
    {
      "id": 57,
      "start": 6736.9,
      "end": 6738.9,
      "formatted_start": "01:52:16.900",
      "formatted_end": "01:52:18.900",
      "text": "آره این دو تا آمپول داره"
    },
    {
      "id": 58,
      "start": 6738.9,
      "end": 6739.9,
      "formatted_start": "01:52:18.900",
      "formatted_end": "01:52:19.900",
      "text": "شربت چی؟"
    },
    {
      "id": 59,
      "start": 6739.9,
      "end": 6742.9,
      "formatted_start": "01:52:19.900",
      "formatted_end": "01:52:22.900",
      "text": "شربت یه دونه توی جنگیت ببینم"
    },
    {
      "id": 60,
      "start": 6742.9,
      "end": 6743.9,
      "formatted_start": "01:52:22.900",
      "formatted_end": "01:52:23.900",
      "text": "این شربت چی؟"
    },
    {
      "id": 61,
      "start": 6743.9,
      "end": 6744.9,
      "formatted_start": "01:52:23.900",
      "formatted_end": "01:52:24.900",
      "text": "خواهمی نوشت بزن؟"
    },
    {
      "id": 62,
      "start": 6744.9,
      "end": 6745.9,
      "formatted_start": "01:52:24.900",
      "formatted_end": "01:52:25.900",
      "text": "نداره"
    },
    {
      "id": 63,
      "start": 6745.9,
      "end": 6746.9,
      "formatted_start": "01:52:25.900",
      "formatted_end": "01:52:26.900",
      "text": "نداره؟"
    },
    {
      "id": 64,
      "start": 6746.9,
      "end": 6748.9,
      "formatted_start": "01:52:26.900",
      "formatted_end": "01:52:28.900",
      "text": "این کلاب دیگه چی داره؟"
    },
    {
      "id": 65,
      "start": 6748.9,
      "end": 6750.9,
      "formatted_start": "01:52:28.900",
      "formatted_end": "01:52:30.900",
      "text": "من اینو نمیدونم این عذیبتشو کنه"
    },
    {
      "id": 66,
      "start": 6750.9,
      "end": 6752.9,
      "formatted_start": "01:52:30.900",
      "formatted_end": "01:52:32.900",
      "text": "اون سکولا بود و اولا منوشت دیگه باز کردم"
    },
    {
      "id": 67,
      "start": 6752.9,
      "end": 6753.4,
      "formatted_start": "01:52:32.900",
      "formatted_end": "01:52:33.400",
      "text": "داری؟"
    },
    {
      "id": 68,
      "start": 6753.4,
      "end": 6753.9,
      "formatted_start": "01:52:33.400",
      "formatted_end": "01:52:33.900",
      "text": "گلوش"
    },
    {
      "id": 69,
      "start": 6753.9,
      "end": 6755.4,
      "formatted_start": "01:52:33.900",
      "formatted_end": "01:52:35.400",
      "text": "خود داری؟"
    },
    {
      "id": 70,
      "start": 6755.4,
      "end": 6756.9,
      "formatted_start": "01:52:35.400",
      "formatted_end": "01:52:36.900",
      "text": "نه نه خانه نداره"
    },
    {
      "id": 71,
      "start": 6756.9,
      "end": 6757.9,
      "formatted_start": "01:52:36.900",
      "formatted_end": "01:52:37.900",
      "text": "خب میخوایی بعد میبینی"
    },
    {
      "id": 72,
      "start": 6757.9,
      "end": 6759.9,
      "formatted_start": "01:52:37.900",
      "formatted_end": "01:52:39.900",
      "text": "اگه از جمعه نشون من نمیدونم"
    },
    {
      "id": 73,
      "start": 6759.9,
      "end": 6760.9,
      "formatted_start": "01:52:39.900",
      "formatted_end": "01:52:40.900",
      "text": "هر حال خودو میخوای خودتا میدونم"
    },
    {
      "id": 74,
      "start": 6760.9,
      "end": 6761.9,
      "formatted_start": "01:52:40.900",
      "formatted_end": "01:52:41.900",
      "text": "یا ایرترومایسین"
    },
    {
      "id": 75,
      "start": 6761.9,
      "end": 6762.9,
      "formatted_start": "01:52:41.900",
      "formatted_end": "01:52:42.900",
      "text": "اون دوست شهر بعد خوبه"
    },
    {
      "id": 76,
      "start": 6762.9,
      "end": 6764.9,
      "formatted_start": "01:52:42.900",
      "formatted_end": "01:52:44.900",
      "text": "حالا چون پرسیدین نوشن"
    },
    {
      "id": 77,
      "start": 6764.9,
      "end": 6766.9,
      "formatted_start": "01:52:44.900",
      "formatted_end": "01:52:46.900",
      "text": "دیگه ایرترومایسین نمیخوام بینویسم"
    },
    {
      "id": 78,
      "start": 6766.9,
      "end": 6768.9,
      "formatted_start": "01:52:46.900",
      "formatted_end": "01:52:48.900",
      "text": "یه خوشماننده هم خوبیم"
    },
    {
      "id": 79,
      "start": 6768.9,
      "end": 6769.9,
      "formatted_start": "01:52:48.900",
      "formatted_end": "01:52:49.900",
      "text": "پرسیدین نه"
    },
    {
      "id": 80,
      "start": 6769.9,
      "end": 6770.9,
      "formatted_start": "01:52:49.900",
      "formatted_end": "01:52:50.900",
      "text": "اصلاسیت داره"
    },
    {
      "id": 81,
      "start": 6770.9,
      "end": 6771.9,
      "formatted_start": "01:52:50.900",
      "formatted_end": "01:52:51.900",
      "text": "اصلاسیت داره؟"
    },
    {
      "id": 82,
      "start": 6771.9,
      "end": 6772.9,
      "formatted_start": "01:52:51.900",
      "formatted_end": "01:52:52.900",
      "text": "اوه آره"
    },
    {
      "id": 83,
      "start": 6772.9,
      "end": 6802.9,
      "formatted_start": "01:52:52.900",
      "formatted_end": "01:53:22.900",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 84,
      "start": 6802.9,
      "end": 6807.54,
      "formatted_start": "01:53:22.900",
      "formatted_end": "01:53:27.540",
      "text": "اینکه بخاطر آیلوپستول میلید خودش بدن که مشکل داره"
    },
    {
      "id": 85,
      "start": 6807.54,
      "end": 6810.52,
      "formatted_start": "01:53:27.540",
      "formatted_end": "01:53:30.520",
      "text": "واسه مطرح تو قیمت دارو ها بالایی"
    },
    {
      "id": 86,
      "start": 6810.52,
      "end": 6812.52,
      "formatted_start": "01:53:30.520",
      "formatted_end": "01:53:32.520",
      "text": "دیگزانی تازون"
    },
    {
      "id": 87,
      "start": 6817.0,
      "end": 6818.9,
      "formatted_start": "01:53:37.000",
      "formatted_end": "01:53:38.900",
      "text": "گوریزان باشه او در صورت"
    },
    {
      "id": 88,
      "start": 6818.9,
      "end": 6820.9,
      "formatted_start": "01:53:38.900",
      "formatted_end": "01:53:40.900",
      "text": "دیگزان باشه"
    },
    {
      "id": 89,
      "start": 6820.9,
      "end": 6822.9,
      "formatted_start": "01:53:40.900",
      "formatted_end": "01:53:42.900",
      "text": "یک گرم"
    },
    {
      "id": 90,
      "start": 6824.9,
      "end": 6826.9,
      "formatted_start": "01:53:44.900",
      "formatted_end": "01:53:46.900",
      "text": "نه اون سرمکوریزان"
    },
    {
      "id": 91,
      "start": 6826.9,
      "end": 6828.9,
      "formatted_start": "01:53:46.900",
      "formatted_end": "01:53:48.900",
      "text": "نه گوریزان که رجنکی دیدم جنسش بهتر است"
    },
    {
      "id": 92,
      "start": 6828.9,
      "end": 6830.9,
      "formatted_start": "01:53:48.900",
      "formatted_end": "01:53:50.900",
      "text": "باشه"
    },
    {
      "id": 93,
      "start": 6830.9,
      "end": 6832.9,
      "formatted_start": "01:53:50.900",
      "formatted_end": "01:53:52.900",
      "text": "باید شما کنیم خودتون"
    },
    {
      "id": 94,
      "start": 6832.9,
      "end": 6834.9,
      "formatted_start": "01:53:52.900",
      "formatted_end": "01:53:54.900",
      "text": "درم خواهید بودیم اینی برده و اونی بودیم"
    },
    {
      "id": 95,
      "start": 6834.9,
      "end": 6837.9,
      "formatted_start": "01:53:54.900",
      "formatted_end": "01:53:57.900",
      "text": "بس این از بعد شبان تنگین نفس داره"
    },
    {
      "id": 96,
      "start": 6837.9,
      "end": 6839.9,
      "formatted_start": "01:53:57.900",
      "formatted_end": "01:53:59.900",
      "text": "بله این تا حالا یا اصابشه"
    },
    {
      "id": 97,
      "start": 6839.9,
      "end": 6841.9,
      "formatted_start": "01:53:59.900",
      "formatted_end": "01:54:01.900",
      "text": "گلوشه یا اصابشه"
    },
    {
      "id": 98,
      "start": 6841.9,
      "end": 6842.9,
      "formatted_start": "01:54:01.900",
      "formatted_end": "01:54:02.900",
      "text": "اصابشه؟"
    },
    {
      "id": 99,
      "start": 6842.9,
      "end": 6843.9,
      "formatted_start": "01:54:02.900",
      "formatted_end": "01:54:03.900",
      "text": "اصابم میدونه"
    },
    {
      "id": 100,
      "start": 6843.9,
      "end": 6845.9,
      "formatted_start": "01:54:03.900",
      "formatted_end": "01:54:05.900",
      "text": "خودم خدا نکرده خواهد میشه؟"
    },
    {
      "id": 101,
      "start": 6845.9,
      "end": 6846.9,
      "formatted_start": "01:54:05.900",
      "formatted_end": "01:54:06.900",
      "text": "نه نه خواهد میشه"
    },
    {
      "id": 102,
      "start": 6846.9,
      "end": 6849.9,
      "formatted_start": "01:54:06.900",
      "formatted_end": "01:54:09.900",
      "text": "اوه جایی که رابوه نشنده که درده که من بیوش کنم"
    },
    {
      "id": 103,
      "start": 6849.9,
      "end": 6850.9,
      "formatted_start": "01:54:09.900",
      "formatted_end": "01:54:10.900",
      "text": "دکتره باشین"
    },
    {
      "id": 104,
      "start": 6850.9,
      "end": 6855.14,
      "formatted_start": "01:54:10.900",
      "formatted_end": "01:54:15.140",
      "text": "این وقت به قدم میره، خب اگه اینجا هم درد بیدم من میبینم از چیه"
    },
    {
      "id": 105,
      "start": 6855.14,
      "end": 6857.14,
      "formatted_start": "01:54:15.140",
      "formatted_end": "01:54:17.140",
      "text": "اون باید سرو کنید اگه شدید"
    },
    {
      "id": 106,
      "start": 6857.14,
      "end": 6857.64,
      "formatted_start": "01:54:17.140",
      "formatted_end": "01:54:17.640",
      "text": "اون از چیه؟"
    },
    {
      "id": 107,
      "start": 6857.64,
      "end": 6858.9,
      "formatted_start": "01:54:17.640",
      "formatted_end": "01:54:18.900",
      "text": "نه، انام نمیتونم بیدم"
    },
    {
      "id": 108,
      "start": 6858.9,
      "end": 6859.64,
      "formatted_start": "01:54:18.900",
      "formatted_end": "01:54:19.640",
      "text": "شکم اینجا؟"
    },
    {
      "id": 109,
      "start": 6859.64,
      "end": 6862.9,
      "formatted_start": "01:54:19.640",
      "formatted_end": "01:54:22.900",
      "text": "آره، شکم که هست، ولی شاید مثلا از اولاد"
    },
    {
      "id": 110,
      "start": 6862.9,
      "end": 6865.9,
      "formatted_start": "01:54:22.900",
      "formatted_end": "01:54:25.900",
      "text": "سرو قبلا بردم روزه تنبالت میتونم، ولی از اولاد"
    },
    {
      "id": 111,
      "start": 6865.9,
      "end": 6868.9,
      "formatted_start": "01:54:25.900",
      "formatted_end": "01:54:28.900",
      "text": "خب، به اتماد لنه مثلا از اولاد خسته میشه، درد نار میشه"
    },
    {
      "id": 112,
      "start": 6868.9,
      "end": 6869.4,
      "formatted_start": "01:54:28.900",
      "formatted_end": "01:54:29.400",
      "text": "آه، خب"
    },
    {
      "id": 113,
      "start": 6869.4,
      "end": 6872.64,
      "formatted_start": "01:54:29.400",
      "formatted_end": "01:54:32.640",
      "text": "یا مدفوع تو روزه هست پشار میاد نرده"
    },
    {
      "id": 114,
      "start": 6872.64,
      "end": 6874.64,
      "formatted_start": "01:54:32.640",
      "formatted_end": "01:54:34.640",
      "text": "این طوری ها رو هم برم"
    },
    {
      "id": 115,
      "start": 6877.82,
      "end": 6879.82,
      "formatted_start": "01:54:37.820",
      "formatted_end": "01:54:39.820",
      "text": "در هم میزن بروندید"
    },
    {
      "id": 116,
      "start": 6899.4,
      "end": 6901.4,
      "formatted_start": "01:54:59.400",
      "formatted_end": "01:55:01.400",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}