      "formatted_end": "02:25:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "ببین دستاشو نگیرم"
    },
    {
      "id": 2,
      "start": 8732.0,
      "end": 8734.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:34.000",
      "text": "نه نه اشکالم"
    },
    {
      "id": 3,
      "start": 8734.0,
      "end": 8736.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:36.000",
      "text": "چونه؟"
    },
    {
      "id": 4,
      "start": 8736.0,
      "end": 8738.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:38.000",
      "text": "جیگرم"
    },
    {
      "id": 5,
      "start": 8738.0,
      "end": 8740.0,
      "formatted_start": "02:25:38.000",
      "formatted_end": "02:25:40.000",
