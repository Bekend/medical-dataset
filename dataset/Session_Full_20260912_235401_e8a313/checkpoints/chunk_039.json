    },
    {
      "id": 20,
      "start": 11763.34,
      "end": 11764.34,
      "formatted_start": "03:16:03.340",
      "formatted_end": "03:16:04.340",
      "text": "باشه باشه"
    },
    {
      "id": 21,
      "start": 11764.34,
      "end": 11765.34,
      "formatted_start": "03:16:04.340",
      "formatted_end": "03:16:05.340",
      "text": "باشه باشه"
    },
    {
      "id": 22,
      "start": 11765.34,
      "end": 11766.34,
      "formatted_start": "03:16:05.340",
      "formatted_end": "03:16:06.340",
      "text": "باشه باشه"
    },
    {
      "id": 23,
      "start": 11766.34,
      "end": 11767.34,
      "formatted_start": "03:16:06.340",
      "formatted_end": "03:16:07.340",
      "text": "باشه باشه"
    },
    {
      "id": 24,
      "start": 11767.34,
      "end": 11768.34,
      "formatted_start": "03:16:07.340",
      "formatted_end": "03:16:08.340",
      "text": "باشه باشه"
    },
    {
      "id": 25,
      "start": 11768.34,
      "end": 11769.34,
      "formatted_start": "03:16:08.340",
      "formatted_end": "03:16:09.340",
      "text": "باشه باشه"
    },
    {
      "id": 26,
      "start": 11769.34,
      "end": 11770.34,
      "formatted_start": "03:16:09.340",
      "formatted_end": "03:16:10.340",
      "text": "باشه باشه"
    },
    {
      "id": 27,
      "start": 11770.34,
      "end": 11771.34,
      "formatted_start": "03:16:10.340",
      "formatted_end": "03:16:11.340",
      "text": "باشه باشه"
    },
    {
      "id": 28,
      "start": 11771.34,
      "end": 11772.34,
      "formatted_start": "03:16:11.340",
      "formatted_end": "03:16:12.340",
      "text": "باشه باشه"
    },
    {
      "id": 29,
      "start": 11772.34,
      "end": 11773.34,
      "formatted_start": "03:16:12.340",
      "formatted_end": "03:16:13.340",
      "text": "باشه باشه"
    },
    {
      "id": 30,
      "start": 11773.34,
      "end": 11774.34,
      "formatted_start": "03:16:13.340",
      "formatted_end": "03:16:14.340",
      "text": "باشه باشه"
    },
    {
      "id": 31,
      "start": 11774.34,
      "end": 11776.34,
      "formatted_start": "03:16:14.340",
      "formatted_end": "03:16:16.340",
      "text": "بسیار... بله چشم"
    },
    {
      "id": 32,
      "start": 11776.34,
      "end": 11778.34,
      "formatted_start": "03:16:16.340",
      "formatted_end": "03:16:18.340",
      "text": "ازم"
    },
    {
      "id": 33,
      "start": 11778.34,
      "end": 11780.34,
      "formatted_start": "03:16:18.340",
      "formatted_end": "03:16:20.340",
      "text": "دیگه چند دسته؟"
    },
    {
      "id": 34,
      "start": 11782.34,
      "end": 11784.34,
      "formatted_start": "03:16:22.340",
      "formatted_end": "03:16:24.340",
      "text": "درسته"
    },
    {
      "id": 35,
      "start": 11786.34,
      "end": 11788.34,
      "formatted_start": "03:16:26.340",
      "formatted_end": "03:16:28.340",
      "text": "گل گریپ"
    },
    {
      "id": 36,
      "start": 11796.34,
      "end": 11798.34,
      "formatted_start": "03:16:36.340",
      "formatted_end": "03:16:38.340",
      "text": "تجربه ازش داشتی نه هیدور؟"
    },
    {
      "id": 37,
      "start": 11798.34,
      "end": 11800.34,
      "formatted_start": "03:16:38.340",
      "formatted_end": "03:16:40.340",
      "text": "چند؟ تجربه ازش داشتی؟"
    },
    {
      "id": 38,
      "start": 11800.34,
      "end": 11802.34,
      "formatted_start": "03:16:40.340",
      "formatted_end": "03:16:42.340",
      "text": "بد نیست اصلا خیلی عالی"
    },
    {
      "id": 39,
      "start": 11802.34,
      "end": 11804.34,
      "formatted_start": "03:16:42.340",
      "formatted_end": "03:16:44.340",
      "text": "یا کدی بد هم نیست خب؟"
    },
    {
      "id": 40,
      "start": 11804.34,
      "end": 11804.84,
      "formatted_start": "03:16:44.340",
      "formatted_end": "03:16:44.840",
      "text": "بله"
    },
    {
      "id": 41,
      "start": 11804.84,
      "end": 11807.34,
      "formatted_start": "03:16:44.840",
      "formatted_end": "03:16:47.340",
      "text": "یه چیزی هست که میشه روش"
    },
    {
      "id": 42,
      "start": 11807.34,
      "end": 11809.34,
      "formatted_start": "03:16:47.340",
      "formatted_end": "03:16:49.340",
      "text": "بعضی موقع به مریض توصیه کرد"
    },
    {
      "id": 43,
      "start": 11809.34,
      "end": 11810.34,
      "formatted_start": "03:16:49.340",
      "formatted_end": "03:16:50.340",
      "text": "نظرم برشید"
    },
    {
      "id": 44,
      "start": 11810.34,
      "end": 11811.34,
      "formatted_start": "03:16:50.340",
      "formatted_end": "03:16:51.340",
      "text": "نه خواهش نمیدونم"
    },
    {
      "id": 45,
      "start": 11811.34,
      "end": 11812.34,
      "formatted_start": "03:16:51.340",
      "formatted_end": "03:16:52.340",
      "text": "بله ممکنه"
    },
    {
      "id": 46,
      "start": 11812.34,
      "end": 11814.34,
      "formatted_start": "03:16:52.340",
      "formatted_end": "03:16:54.340",
      "text": "مثلا 50-50 به نظر من جوابیم"
    },
    {
      "id": 47,
      "start": 11814.34,
      "end": 11815.34,
      "formatted_start": "03:16:54.340",
      "formatted_end": "03:16:55.340",
      "text": "درسته"
    },
    {
      "id": 48,
      "start": 11815.34,
      "end": 11816.34,
      "formatted_start": "03:16:55.340",
      "formatted_end": "03:16:56.340",
      "text": "دوتا رو دادی"
    },
    {
      "id": 49,
      "start": 11816.34,
      "end": 11818.34,
      "formatted_start": "03:16:56.340",
      "formatted_end": "03:16:58.340",
      "text": "جواب نده میبنیم اینو به درک شده"
    },
    {
      "id": 50,
      "start": 11818.34,
      "end": 11819.34,
      "formatted_start": "03:16:58.340",
      "formatted_end": "03:16:59.340",
      "text": "بله"
    },
    {
      "id": 51,
      "start": 11819.34,
      "end": 11820.34,
      "formatted_start": "03:16:59.340",
      "formatted_end": "03:17:00.340",
      "text": "خیلی ممنون سوامو تکرد"
    },
    {
      "id": 52,
      "start": 11820.34,
      "end": 11822.34,
      "formatted_start": "03:17:00.340",
      "formatted_end": "03:17:02.340",
      "text": "از سری دارام همینجوری هست"
    },
    {
      "id": 53,
      "start": 11822.34,
      "end": 11824.34,
      "formatted_start": "03:17:02.340",
      "formatted_end": "03:17:04.340",
      "text": "اگه مریض میافته برشید یه بیده شده"
    },
    {
      "id": 54,
      "start": 11824.34,
      "end": 11826.92,
      "formatted_start": "03:17:04.340",
      "formatted_end": "03:17:06.920",
      "text": "خیلی ممنون شما با ترک داریم برای خودم یک خود"
    },
    {
      "id": 55,
      "start": 11826.92,
      "end": 11829.58,
      "formatted_start": "03:17:06.920",
      "formatted_end": "03:17:09.580",
      "text": "خوب چی شده؟ کچولو رو ببخشیم"
    },
    {
      "id": 56,
      "start": 11829.58,
      "end": 11830.22,
      "formatted_start": "03:17:09.580",
      "formatted_end": "03:17:10.220",
      "text": "خیلی ممنون"
    },
    {
      "id": 57,
      "start": 11830.22,
      "end": 11831.22,
      "formatted_start": "03:17:10.220",
      "formatted_end": "03:17:11.220",
      "text": "مرسی ممنون"
    },
    {
      "id": 58,
      "start": 11831.22,
      "end": 11832.22,
      "formatted_start": "03:17:11.220",
      "formatted_end": "03:17:12.220",
      "text": "آیا خب مونشیم نیست؟"
    },
    {
      "id": 59,
      "start": 11832.22,
      "end": 11838.34,
      "formatted_start": "03:17:12.220",
      "formatted_end": "03:17:18.340",
      "text": "نه مونشیم رفته پایین تو در مانگای یادگار این روشان جان بدیم بعد شما بزنیم"
    },
    {
      "id": 60,
      "start": 11838.34,
      "end": 11840.34,
      "formatted_start": "03:17:18.340",
      "formatted_end": "03:17:20.340",
      "text": "حالا عجله نیستیم خب"
    },
    {
      "id": 61,
      "start": 11840.34,
      "end": 11842.34,
      "formatted_start": "03:17:20.340",
      "formatted_end": "03:17:22.340",
      "text": "فامیل شریفتان؟"
    },
    {
      "id": 62,
      "start": 11842.34,
      "end": 11843.34,
      "formatted_start": "03:17:22.340",
      "formatted_end": "03:17:23.340",
      "text": "آیا متحریم"
    },
    {
      "id": 63,
      "start": 11843.34,
      "end": 11844.34,
      "formatted_start": "03:17:23.340",
      "formatted_end": "03:17:24.340",
      "text": "آیا متحریم"
    },
    {
      "id": 64,
      "start": 11844.34,
      "end": 11845.34,
      "formatted_start": "03:17:24.340",
      "formatted_end": "03:17:25.340",
      "text": "سنش شده؟"
    },
    {
      "id": 65,
      "start": 11845.34,
      "end": 11846.34,
      "formatted_start": "03:17:25.340",
      "formatted_end": "03:17:26.340",
      "text": "یک ماه شده"
    },
    {
      "id": 66,
      "start": 11846.34,
      "end": 11848.34,
      "formatted_start": "03:17:26.340",
      "formatted_end": "03:17:28.340",
      "text": "یک بیمه که نیست هنوز"
    },
    {
      "id": 67,
      "start": 11848.34,
      "end": 11851.34,
      "formatted_start": "03:17:28.340",
      "formatted_end": "03:17:31.340",
      "text": "نه اداره بیمه اینا رفتیم کارهایی کنیم"
    },
    {
      "id": 68,
      "start": 11851.34,
      "end": 11853.34,
      "formatted_start": "03:17:31.340",
      "formatted_end": "03:17:33.340",
      "text": "آره اداره بیمه موسلله رفتیم"
    },
    {
      "id": 69,
      "start": 11853.34,
      "end": 11855.34,
      "formatted_start": "03:17:33.340",
      "formatted_end": "03:17:35.340",
      "text": "چی میگن؟"
    },
    {
      "id": 70,
      "start": 11855.34,
      "end": 11859.34,
      "formatted_start": "03:17:35.340",
      "formatted_end": "03:17:39.340",
      "text": "کافینت رفتیم چون کافینت ها باید صبر می کنن"
    },
    {
      "id": 71,
      "start": 11859.34,
      "end": 11861.34,
      "formatted_start": "03:17:39.340",
      "formatted_end": "03:17:41.340",
      "text": "همه یه هیچی رو"
    },
    {
      "id": 72,
      "start": 11861.34,
      "end": 11864.34,
      "formatted_start": "03:17:41.340",
      "formatted_end": "03:17:44.340",
      "text": "آره نوزاده ها رو کافینت باید صبر کنن"
    },
    {
      "id": 73,
      "start": 11864.34,
      "end": 11865.34,
      "formatted_start": "03:17:44.340",
      "formatted_end": "03:17:45.340",
      "text": "واسه اینجام نشد آقایی؟"
    },
    {
      "id": 74,
      "start": 11865.34,
      "end": 11866.34,
      "formatted_start": "03:17:45.340",
      "formatted_end": "03:17:46.340",
      "text": "آره اینش مادر"
    },
    {
      "id": 75,
      "start": 11866.34,
      "end": 11868.34,
      "formatted_start": "03:17:46.340",
      "formatted_end": "03:17:48.340",
      "text": "یک مایشه آقایی"
    },
    {
      "id": 76,
      "start": 11868.34,
      "end": 11870.34,
      "formatted_start": "03:17:48.340",
      "formatted_end": "03:17:50.340",
      "text": "آقای متحری"
    },
    {
      "id": 77,
      "start": 11870.34,
      "end": 11872.34,
      "formatted_start": "03:17:50.340",
      "formatted_end": "03:17:52.340",
      "text": "متحری چی شد آقای متحری؟ پدرش که؟"
    },
    {
      "id": 78,
      "start": 11872.34,
      "end": 11873.34,
      "formatted_start": "03:17:52.340",
      "formatted_end": "03:17:53.340",
      "text": "پدرش مادر"
    },
    {
      "id": 79,
      "start": 11873.34,
      "end": 11874.34,
      "formatted_start": "03:17:53.340",
      "formatted_end": "03:17:54.340",
      "text": "خب مادرش"
    },
    {
      "id": 80,
      "start": 11874.34,
      "end": 11877.34,
      "formatted_start": "03:17:54.340",
      "formatted_end": "03:17:57.340",
      "text": "ببخش دارواش میشه رو دستش دخترم رو بگیره"
    },
    {
      "id": 81,
      "start": 11877.34,
      "end": 11879.34,
      "formatted_start": "03:17:57.340",
      "formatted_end": "03:17:59.340",
      "text": "نه دارواش"
    },
    {
      "id": 82,
      "start": 11879.34,
      "end": 11886.34,
      "formatted_start": "03:17:59.340",
      "formatted_end": "03:18:06.340",
      "text": "حالا من ببینم چجوری هست اگر شد آره میشه با کودی ملی اون بچه زیده 13-14 سال باشه کشید"
    },
    {
      "id": 83,
      "start": 11886.34,
      "end": 11888.34,
      "formatted_start": "03:18:06.340",
      "formatted_end": "03:18:08.340",
      "text": "چه شده خوانگو کردی؟"
    },
    {
      "id": 84,
      "start": 11888.34,
      "end": 11891.34,
      "formatted_start": "03:18:08.340",
      "formatted_end": "03:18:11.340",
      "text": "دربارش نمی کرد بودن که سرما خورده بودن"
    },
    {
      "id": 85,
      "start": 11891.34,
      "end": 11893.34,
      "formatted_start": "03:18:11.340",
      "formatted_end": "03:18:13.340",
      "text": "بعد از دیروزیه صرفه میکنه"
    },
    {
      "id": 86,
      "start": 11893.34,
      "end": 11895.34,
      "formatted_start": "03:18:13.340",
      "formatted_end": "03:18:15.340",
      "text": "صرفه خیلی خیلی خیلی خیلی"
    },
    {
      "id": 87,
      "start": 11895.34,
      "end": 11897.34,
      "formatted_start": "03:18:15.340",
      "formatted_end": "03:18:17.340",
      "text": "صرفه خفیفی گفتم قبل اینکه"
    },
    {
      "id": 88,
      "start": 11897.34,
      "end": 11898.34,
      "formatted_start": "03:18:17.340",
      "formatted_end": "03:18:18.340",
      "text": "آقاییزه؟"
    },
    {
      "id": 89,
      "start": 11898.34,
      "end": 11899.34,
      "formatted_start": "03:18:18.340",
      "formatted_end": "03:18:19.340",
      "text": "نه"
    },
    {
      "id": 90,
      "start": 11899.34,
      "end": 11900.34,
      "formatted_start": "03:18:19.340",
      "formatted_end": "03:18:20.340",
      "text": "الان میگیره اینو نه"
    },
    {
      "id": 91,
      "start": 11900.34,
      "end": 11902.34,
      "formatted_start": "03:18:20.340",
      "formatted_end": "03:18:22.340",
      "text": "خودتون هم که حادثه گرفتگی بشه"
    },
    {
      "id": 92,
      "start": 11902.34,
      "end": 11904.34,
      "formatted_start": "03:18:22.340",
      "formatted_end": "03:18:24.340",
      "text": "گرفتگی بینی"
    },
    {
      "id": 93,
      "start": 11904.34,
      "end": 11906.34,
      "formatted_start": "03:18:24.340",
      "formatted_end": "03:18:26.340",
      "text": "و اینکه مسئله بعدی اینه که"
    },
    {
      "id": 94,
      "start": 11906.34,
      "end": 11908.34,
      "formatted_start": "03:18:26.340",
      "formatted_end": "03:18:28.340",
      "text": "چند روز اینجا دلدن"
    },
    {
      "id": 95,
      "start": 11908.34,
      "end": 11910.34,
      "formatted_start": "03:18:28.340",
      "formatted_end": "03:18:30.340",
      "text": "بلنج بهش بوده"
    },
    {
      "id": 96,
      "start": 11910.34,
      "end": 11912.34,
      "formatted_start": "03:18:30.340",
      "formatted_end": "03:18:32.340",
      "text": "زور میزنی اون پیچه"
    },
    {
      "id": 97,
      "start": 11912.34,
      "end": 11914.34,
      "formatted_start": "03:18:32.340",
      "formatted_end": "03:18:34.340",
      "text": "بقل آرومه"
    },
    {
      "id": 98,
      "start": 11914.34,
      "end": 11916.34,
      "formatted_start": "03:18:34.340",
      "formatted_end": "03:18:36.340",
      "text": "تو ماشین ساکت میزنی"
    },
    {
      "id": 99,
      "start": 11916.34,
      "end": 11918.34,
      "formatted_start": "03:18:36.340",
      "formatted_end": "03:18:38.340",
      "text": "زمینی با زمین بخمه چند روز"
    },
    {
      "id": 100,
      "start": 11918.34,
      "end": 11920.34,
      "formatted_start": "03:18:38.340",
      "formatted_end": "03:18:40.340",
      "text": "بخمه چند روز بشین بیواز"
    },
    {
      "id": 101,
      "start": 11920.34,
      "end": 11922.34,
      "formatted_start": "03:18:40.340",
      "formatted_end": "03:18:42.340",
      "text": "جادم"
    },
    {
      "id": 102,
      "start": 11922.34,
      "end": 11924.34,
      "formatted_start": "03:18:42.340",
      "formatted_end": "03:18:44.340",
      "text": "سلام سلام"
    },
    {
      "id": 103,
      "start": 11924.34,
      "end": 11926.34,
      "formatted_start": "03:18:44.340",
      "formatted_end": "03:18:46.340",
      "text": "محتویت میشه"
    },
    {
      "id": 104,
      "start": 11926.34,
      "end": 11928.34,
      "formatted_start": "03:18:46.340",
      "formatted_end": "03:18:48.340",
      "text": "نه نه"
    },
    {
      "id": 105,
      "start": 11928.34,
      "end": 11930.34,
      "formatted_start": "03:18:48.340",
      "formatted_end": "03:18:50.340",
      "text": "اینو درست روید"
    },
    {
      "id": 106,
      "start": 11932.34,
      "end": 11934.34,
      "formatted_start": "03:18:52.340",
      "formatted_end": "03:18:54.340",
      "text": "نه نه، یه قبض استفراق خیلی چیز نیست"
    },
    {
      "id": 107,
      "start": 11934.34,
      "end": 11936.34,
      "formatted_start": "03:18:54.340",
      "formatted_end": "03:18:56.340",
      "text": "دو قبض میان پیو بشه"
    },
    {
      "id": 108,
      "start": 11936.34,
      "end": 11938.34,
      "formatted_start": "03:18:56.340",
      "formatted_end": "03:18:58.340",
      "text": "از گروه براش"
    },
    {
      "id": 109,
      "start": 11938.34,
      "end": 11940.34,
      "formatted_start": "03:18:58.340",
      "formatted_end": "03:19:00.340",
      "text": "مثلا با یه قدر یه دو سی سی"
    },
    {
      "id": 110,
      "start": 11940.34,
      "end": 11942.34,
      "formatted_start": "03:19:00.340",
      "formatted_end": "03:19:02.340",
      "text": "نه هر سه ساعت شروع بشه"
    },
    {
      "id": 111,
      "start": 11942.34,
      "end": 11944.34,
      "formatted_start": "03:19:02.340",
      "formatted_end": "03:19:04.340",
      "text": "باید میشه چطوری بشه"
    },
    {
      "id": 112,
      "start": 11944.34,
      "end": 11946.34,
      "formatted_start": "03:19:04.340",
      "formatted_end": "03:19:06.340",
      "text": "سه ساعت، آره تا خود"
    },
    {
      "id": 113,
      "start": 11946.34,
      "end": 11948.34,
      "formatted_start": "03:19:06.340",
      "formatted_end": "03:19:08.340",
      "text": "دیگه یه مقداری ریفلاکس داده"
    },
    {
      "id": 114,
      "start": 11948.34,
      "end": 11950.34,
      "formatted_start": "03:19:08.340",
      "formatted_end": "03:19:10.340",
      "text": "شیر با جت برگردونده"
    },
    {
      "id": 115,
      "start": 11950.34,
      "end": 11952.34,
      "formatted_start": "03:19:10.340",
      "formatted_end": "03:19:12.340",
      "text": "خب، فعلا"
    },
    {
      "id": 116,
      "start": 11954.34,
      "end": 11956.34,
      "formatted_start": "03:19:14.340",
      "formatted_end": "03:19:16.340",
      "text": "خب، حالا تعمل نکرده"
    },
    {
      "id": 117,
      "start": 11956.34,
      "end": 11960.34,
      "formatted_start": "03:19:16.340",
      "formatted_end": "03:19:20.340",
      "text": "یک چار می دیگر هم خند پرازور هر دوازده ساعت براش میزدید"
    },
    {
      "id": 118,
      "start": 11960.34,
      "end": 11963.34,
      "formatted_start": "03:19:20.340",
      "formatted_end": "03:19:23.340",
      "text": "مرسی خداحافظ شما خداحافظ"
    },
    {
      "id": 119,
      "start": 11963.34,
      "end": 11964.34,
      "formatted_start": "03:19:23.340",
      "formatted_end": "03:19:24.340",
      "text": "براشیم"
    },
    {
      "id": 120,
      "start": 11964.34,
      "end": 11968.34,
      "formatted_start": "03:19:24.340",
      "formatted_end": "03:19:28.340",
      "text": "پس حالا تو قلعه اینجا داره دلش پیش میده دستارو صرف میکنه"
    },
    {
      "id": 121,
      "start": 11968.34,
      "end": 11973.34,
      "formatted_start": "03:19:28.340",
      "formatted_end": "03:19:33.340",
      "text": "پاهارو اینجوری حرکت میده تو بغل آرومه برعکس می کنید آرومتره"
    },
    {
      "id": 122,
      "start": 11973.34,
      "end": 11975.34,
      "formatted_start": "03:19:33.340",
      "formatted_end": "03:19:35.340",
      "text": "دلش میخوانی مزه شیر بخوره؟"
    },
    {
      "id": 123,
      "start": 11975.34,
      "end": 11977.34,
      "formatted_start": "03:19:35.340",
      "formatted_end": "03:19:37.340",
      "text": "نه نمیخوانی بخوره"
    },
    {
      "id": 124,
      "start": 11977.34,
      "end": 12000.0,
      "formatted_start": "03:19:37.340",
      "formatted_end": "03:20:00.000",
