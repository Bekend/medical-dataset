  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11710.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:10.000",
      "text": "این کاری که مردم رو راحت کرد، واقعا راحت کرد."
    },
    {
      "id": 1,
      "start": 11710.0,
      "end": 11720.0,
      "formatted_start": "03:15:10.000",
      "formatted_end": "03:15:20.000",
      "text": "مثل توی ماراتونی که چوب میدن، وقتی یکی بدی میده و وقتی یکی بدی، تو هم میتونه فردا پسر تو بیدن. دختر تو بیدین چون بود؟"
    },
    {
      "id": 2,
      "start": 11720.0,
      "end": 11722.0,
      "formatted_start": "03:15:20.000",
      "formatted_end": "03:15:22.000",
      "text": "این چلغی رو شروع کرد که چلغی رو..."
    },
    {
      "id": 3,
      "start": 11722.0,
      "end": 11728.4,
      "formatted_start": "03:15:22.000",
      "formatted_end": "03:15:28.400",
      "text": "آفرین، آفرین، این کارخانه هست که اگر عرضه داشته باشه خانواده، همین تو کله رو باشه"
    },
    {
      "id": 4,
      "start": 11728.4,
      "end": 11734.0,
      "formatted_start": "03:15:28.400",
      "formatted_end": "03:15:34.000",
      "text": "ببین داروزنه بسیار مونگایی همشون باشه، هم تنشن نفته"
    },
    {
      "id": 5,
      "start": 11734.0,
      "end": 11740.0,
      "formatted_start": "03:15:34.000",
      "formatted_end": "03:15:40.000",
      "text": "هم این مونگایی، همون مجبورن مون بگیره، هم بیان داروز بگیره، اون را تنم نرده، هر رو"
    },
    {
      "id": 6,
      "start": 11740.0,
      "end": 11745.0,
      "formatted_start": "03:15:40.000",
      "formatted_end": "03:15:45.000",
      "text": "آقا خورما خورده، خورده از این مرتب ندیر"
    },
    {
      "id": 7,
      "start": 11745.0,
      "end": 11751.34,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:51.340",
      "text": "باشه من ششتان تمام می کنم سنده باشین"
    },
    {
      "id": 8,
      "start": 11751.34,
      "end": 11752.34,
      "formatted_start": "03:15:51.340",
      "formatted_end": "03:15:52.340",
      "text": "باشه باشه"
    },
    {
      "id": 9,
      "start": 11752.34,
      "end": 11753.34,
      "formatted_start": "03:15:52.340",
      "formatted_end": "03:15:53.340",
      "text": "باشه باشه"
    },
    {
      "id": 10,
      "start": 11753.34,
      "end": 11754.34,
      "formatted_start": "03:15:53.340",
