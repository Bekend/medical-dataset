  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13830.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:30.000",
      "text": "مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی بیمار، مدت زمانی"
    },
    {
      "id": 1,
      "start": 13830.0,
      "end": 13848.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:48.000",
      "text": "رومان به همراه این یکی از رومانهای دیگره، هرمان هسه، که رومان سفردان بازی موهبه های شیشه ای، این دو تا رومان بشور تلیف رومانهایی هم که از هرمان هسه واقع بوده"
    },
    {
      "id": 2,
      "start": 13848.0,
      "end": 13861.5,
      "formatted_start": "03:50:48.000",
      "formatted_end": "03:51:01.500",
      "text": "و از این لحاظ به لحاظ تفسیری که از این رومان شده هم مفسران و شارعان کمابیش با هم اختلاف دارند"
    },
    {
      "id": 3,
      "start": 13861.5,
      "end": 13874.76,
      "formatted_start": "03:51:01.500",
      "formatted_end": "03:51:14.760",
      "text": "و این اختلاف ها بتونم بگم در مواقع هیچ کدام از دیگر رومان های ایرمان هسه حتی در مواقع رومان بازی مونداشی شدید تا این حد پیش نگهاند"
    },
    {
      "id": 4,
      "start": 13874.76,
      "end": 13880.76,
      "formatted_start": "03:51:14.760",
      "formatted_end": "03:51:20.760",
      "text": "خب من طبقا در این موقع بودم"
    },
    {
      "id": 5,
      "start": 13880.76,
      "end": 13885.76,
      "formatted_start": "03:51:20.760",
      "formatted_end": "03:51:25.760",
      "text": "خب توی تنخواه در علام دیدن هم این شربت هاش هم روز دیسته باید"
    },
    {
      "id": 6,
      "start": 13885.76,
      "end": 13888.76,
      "formatted_start": "03:51:25.760",
      "formatted_end": "03:51:28.760",
      "text": "روز دیسته باید بنده بنده خواهیش می کنید"
    },
    {
      "id": 7,
      "start": 13888.76,
      "end": 13892.76,
      "formatted_start": "03:51:28.760",
      "formatted_end": "03:51:32.760",
      "text": "خب بسیار دیگه"
    },
    {
      "id": 8,
      "start": 13892.76,
      "end": 13896.76,
      "formatted_start": "03:51:32.760",
      "formatted_end": "03:51:36.760",
      "text": "چیزی که خودم نیرمونی آبازی کنند"
    },
    {
      "id": 9,
      "start": 13896.76,
      "end": 13900.76,
      "formatted_start": "03:51:36.760",
      "formatted_end": "03:51:40.760",
      "text": "و همینطور که اونکه شما"
    },
    {
      "id": 10,
      "start": 13900.76,
      "end": 13907.76,
      "formatted_start": "03:51:40.760",
      "formatted_end": "03:51:47.760",
      "text": "در موضوعی که نهرمونی دارم آن رو بشنشون به تفسیران دیگری هم رو میدهیم"
    },
    {
      "id": 11,
      "start": 13907.76,
      "end": 13911.76,
      "formatted_start": "03:51:47.760",
      "formatted_end": "03:51:51.760",
      "text": "قربت آنچه که من خدمتون رو محضر کنم"
    },
    {
      "id": 12,
      "start": 13911.76,
      "end": 13918.76,
      "formatted_start": "03:51:51.760",
      "formatted_end": "03:51:58.760",
      "text": "همچنین که بخواهم حاصل است این بات شخص آدم است"
    },
    {
      "id": 13,
      "start": 13918.76,
      "end": 13926.76,
      "formatted_start": "03:51:58.760",
      "formatted_end": "03:52:06.760",
      "text": "و نه چیزی که شادهان و مفصلانی دیگری نرفتند"
    },
    {
      "id": 14,
      "start": 13926.76,
      "end": 13946.76,
      "formatted_start": "03:52:06.760",
      "formatted_end": "03:52:26.760",
      "text": "حالا اگر شما به اختلافی ببینید، با این تشویقی ببینید، اونجوری خوده و خودتونم بتونید دامنی کنید که کدام تفسیر تفسیر درسته و اومد امتباه دیشتری داره"
    },
    {
      "id": 15,
      "start": 13946.76,
      "end": 13963.76,
      "formatted_start": "03:52:26.760",
      "formatted_end": "03:52:43.760",
      "text": "خب در این رومان ما با شخصیتی مماجهی انامه هاری هلر که البته خودش را گرگ بیاغان نام دادید، لعب دادید"
    },
    {
      "id": 16,
      "start": 13963.76,
      "end": 13979.3,
      "formatted_start": "03:52:43.760",
      "formatted_end": "03:52:59.300",
      "text": "گرگ بیاغان به جهت اینکه اولا تنهاست و احساس همومیزی و مردم همومیزی با انسانها نداره"
    },
    {
      "id": 17,
      "start": 13979.3,
      "end": 13983.9,
      "formatted_start": "03:52:59.300",
      "formatted_end": "03:53:03.900",
      "text": "احساس مورد به دنیای انسانهایی که تعداد نداره"
    },
    {
      "id": 18,
      "start": 13983.9,
      "end": 13989.96,
      "formatted_start": "03:53:03.900",
      "formatted_end": "03:53:09.960",
      "text": "این اولا و ثانیا گرگ هم هست"
    },
    {
      "id": 19,
      "start": 13989.96,
      "end": 13995.56,
      "formatted_start": "03:53:09.960",
      "formatted_end": "03:53:15.560",
      "text": "یعنی علاوه بر این که انسان در خودش یک نوع بود که هم"
    },
    {
      "id": 20,
      "start": 13995.56,
      "end": 13997.9,
      "formatted_start": "03:53:15.560",
      "formatted_end": "03:53:17.900",
      "text": "یک نوع بود بودن"
    },
    {
      "id": 21,
      "start": 13997.9,
      "end": 14001.22,
      "formatted_start": "03:53:17.900",
      "formatted_end": "03:53:21.220",
      "text": "یک نوع بود که هم میده"
    },
    {
      "id": 22,
      "start": 14001.22,
      "end": 14010.28,
      "formatted_start": "03:53:21.220",
      "formatted_end": "03:53:30.280",
      "text": "داستان اینه که این انسان"
    },
    {
      "id": 23,
      "start": 14010.28,
      "end": 14012.02,
      "formatted_start": "03:53:30.280",
      "formatted_end": "03:53:32.020",
      "text": "یعنی حدر"
    },
    {
      "id": 24,
      "start": 14012.02,
      "end": 14013.24,
      "formatted_start": "03:53:32.020",
      "formatted_end": "03:53:33.240",
      "text": "حدر"
    },
    {
      "id": 25,
      "start": 14013.24,
      "end": 14017.62,
      "formatted_start": "03:53:33.240",
      "formatted_end": "03:53:37.620",
      "text": "این انسان با این میکی که یعنی این میکی که"
    },
    {
      "id": 26,
      "start": 14017.62,
      "end": 14022.26,
      "formatted_start": "03:53:37.620",
      "formatted_end": "03:53:42.260",
      "text": "در عید انسان بودند، در خودکومیکی هم تشخیص دادند"
    },
    {
      "id": 27,
      "start": 14022.98,
      "end": 14028.58,
      "formatted_start": "03:53:42.980",
      "formatted_end": "03:53:48.580",
      "text": "و این نیزی که تنهاست و دور از اجتماعی و همزیستی"
    },
    {
      "id": 28,
      "start": 14029.14,
      "end": 14033.14,
      "formatted_start": "03:53:49.140",
      "formatted_end": "03:53:53.140",
      "text": "و هموفقی نداره با انسانهای دیگه"
    },
    {
      "id": 29,
      "start": 14034.34,
      "end": 14036.9,
      "formatted_start": "03:53:54.340",
      "formatted_end": "03:53:56.900",
      "text": "چگونه ضدیدی بوده ازش میاد"
    },
    {
      "id": 30,
      "start": 14037.3,
      "end": 14040.02,
      "formatted_start": "03:53:57.300",
      "formatted_end": "03:54:00.020",
      "text": "و به نظر آن هم پیمی بره که"
    },
    {
      "id": 31,
      "start": 14041.82,
      "end": 14044.42,
      "formatted_start": "03:54:01.820",
      "formatted_end": "03:54:04.420",
      "text": "در خودمو عیدی هست"
    },
    {
      "id": 32,
      "start": 14044.78,
      "end": 14047.46,
      "formatted_start": "03:54:04.780",
      "formatted_end": "03:54:07.460",
      "text": "در خودمو مشکلی هست"
    },
    {
      "id": 33,
      "start": 14047.62,
      "end": 14054.08,
      "formatted_start": "03:54:07.620",
      "formatted_end": "03:54:14.080",
      "text": "خب داستان را چون فرض برای نیسته را خونده امان تکترال نمی کنم"
    },
    {
      "id": 34,
      "start": 14054.08,
      "end": 14062.92,
      "formatted_start": "03:54:14.080",
      "formatted_end": "03:54:22.920",
      "text": "اما چهار متقصیبندی که در این داستان در باره امسان به کار رفته رو"
    },
    {
      "id": 35,
      "start": 14062.92,
      "end": 14067.1,
      "formatted_start": "03:54:22.920",
      "formatted_end": "03:54:27.100",
      "text": "از نظر هرمانه سه رو اینو خدمتون نهون کنم"
    },
    {
      "id": 36,
      "start": 14067.1,
      "end": 14076.04,
      "formatted_start": "03:54:27.100",
      "formatted_end": "03:54:36.040",
      "text": "و بعد می کنم که وجه خطای قهرمون داستان در کجاست"
    },
    {
      "id": 37,
      "start": 14076.04,
      "end": 14087.42,
      "formatted_start": "03:54:36.040",
      "formatted_end": "03:54:47.420",
