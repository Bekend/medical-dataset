  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9930.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:30.000",
      "text": "با اینکه باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 1,
      "start": 9930.0,
      "end": 9956.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:56.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 9956.0,
      "end": 9961.0,
      "formatted_start": "02:45:56.000",
      "formatted_end": "02:46:01.000",
      "text": "خانسمیر بهش بگیم پلرژینکیت دیگه نزنن 420 تومن پلرژینکیته"
    },
    {
      "id": 3,
      "start": 9961.0,
      "end": 9965.0,
      "formatted_start": "02:46:01.000",
      "formatted_end": "02:46:05.000",
      "text": "باب خیلی گرونه آزاد میخوره او شعرت پلرژینکیته"
    },
    {
      "id": 4,
      "start": 9965.0,
      "end": 9968.0,
      "formatted_start": "02:46:05.000",
      "formatted_end": "02:46:08.000",
      "text": "آنو 420 تومن اینه"
    },
    {
      "id": 5,
      "start": 9968.0,
      "end": 9970.0,
      "formatted_start": "02:46:08.000",
      "formatted_end": "02:46:10.000",
      "text": "برای تو میگه برایش خوبیسته"
    },
    {
      "id": 6,
      "start": 9970.0,
      "end": 9975.0,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:15.000",
      "text": "این خوبه دارو خوبیه ولی گرونه اگه پول برای تو مهمیست اینه نگه داره"
    },
    {
      "id": 7,
      "start": 9975.0,
      "end": 9978.0,
      "formatted_start": "02:46:15.000",
      "formatted_end": "02:46:18.000",
      "text": "نه نگه داره باشه برایش دیگه از از کرایه دیگه برایم مونده"
    },
    {
      "id": 8,
      "start": 9978.0,
      "end": 9979.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:19.000",
      "text": "باشه باشه باشه"
    },
    {
      "id": 9,
      "start": 9979.0,
      "end": 9981.0,
      "formatted_start": "02:46:19.000",
      "formatted_end": "02:46:21.000",
      "text": "دستی باره جرد نخونه خداحافظ"
    },
    {
      "id": 10,
      "start": 10011.0,
      "end": 10031.0,
      "formatted_start": "02:46:51.000",
      "formatted_end": "02:47:11.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 10031.0,
      "end": 10033.0,
      "formatted_start": "02:47:11.000",
      "formatted_end": "02:47:13.000",
      "text": "آقای قاسمی آقای این کاموزه هم شدن؟"
    },
    {
      "id": 12,
      "start": 10033.0,
      "end": 10039.0,
      "formatted_start": "02:47:13.000",
      "formatted_end": "02:47:19.000",
      "text": "ببین آقای تا دیگه خوب همون چیز گوشیده جواب نداد یا جلسته یک چیز بوده این آخواد؟"
    },
    {
      "id": 13,
      "start": 10039.0,
      "end": 10048.0,
      "formatted_start": "02:47:19.000",
      "formatted_end": "02:47:28.000",
      "text": "خب، حالا من از جای دیگه از گیلان سآل کردم و فرماندار اینها و سانداردار اونجا عاشقان و فامینام"
    },
    {
      "id": 14,
      "start": 10048.0,
      "end": 10057.0,
      "formatted_start": "02:47:28.000",
      "formatted_end": "02:47:37.000",
      "text": "اینا یه شماله دادن من با یه آقایی رو صحبت کردم این گفت نه بازرست باطله چون نسبت داره با اون چیز"
    },
    {
      "id": 15,
      "start": 10057.0,
      "end": 10085.0,
      "formatted_start": "02:47:37.000",
      "formatted_end": "02:48:05.000",
      "text": "گفت که قیمات 147 شرکت ها، خب، اینجا قید کرده که بازرس نباید، نه؟ گفته اعضای حیط مدیره، یعنی اعضای حیط مدیره سر جاش میمونه، بازرس مشغول به اینه که جزب فامیل نباشه، یعنی اعضای بازرس شرکت گذاشته براش، بله؟ اعضای حیط مدیره و مجلس..."
    },
    {
      "id": 16,
      "start": 10085.0,
      "end": 10094.0,
      "formatted_start": "02:48:05.000",
      "formatted_end": "02:48:14.000",
      "text": "نه نه افتال شرکت نیمیشه افتال مجمل افتال مجمل عقوبت خودش هست ولی تفهون"
    },
    {
      "id": 17,
      "start": 10094.0,
      "end": 10102.0,
      "formatted_start": "02:48:14.000",
      "formatted_end": "02:48:22.000",
      "text": "بعد من اینو حتی من توی حوش مصنوعی هم سآل کردم برای جد جی پی تی هم اینو برای قوانینو دارم"
    },
    {
      "id": 18,
      "start": 10102.0,
      "end": 10106.0,
      "formatted_start": "02:48:22.000",
      "formatted_end": "02:48:26.000",
      "text": "حالا اینشون همین حرفش دارن نه ازم برای اون اکساشو میفرستم اینو"
    },
    {
      "id": 19,
      "start": 10106.0,
      "end": 10122.0,
      "formatted_start": "02:48:26.000",
      "formatted_end": "02:48:42.000",
      "text": "حتی حتی حوش مصنوعی شده بود که طبق قانون فلان میتونن اگر این مجمع به صفت شرکتها نرسیده هست"
    },
    {
      "id": 20,
      "start": 10122.0,
      "end": 10130.0,
      "formatted_start": "02:48:42.000",
      "formatted_end": "02:48:50.000",
      "text": "خب نرسیده میتونن اعضای حیط مدیره یا مجمع دو مرتبه بازرس انتخاب کنند"
    },
    {
      "id": 21,
      "start": 10130.0,
      "end": 10135.0,
      "formatted_start": "02:48:50.000",
      "formatted_end": "02:48:55.000",
      "text": "حتی مجمع خب"
    },
    {
      "id": 22,
      "start": 10135.0,
      "end": 10141.0,
      "formatted_start": "02:48:55.000",
      "formatted_end": "02:49:01.000",
      "text": "آیا یک باسمین الان ما ببینیم اصل اینی که بازرس ما چون نسبت داره هسته درسته؟"
    },
    {
      "id": 23,
      "start": 10141.0,
      "end": 10145.0,
      "formatted_start": "02:49:01.000",
      "formatted_end": "02:49:05.000",
      "text": "باید یک مجمع پوهلاده تشکیل بدیم یک بازرس انتخاب میدیم"
    },
    {
      "id": 24,
      "start": 10145.0,
      "end": 10148.0,
      "formatted_start": "02:49:05.000",
      "formatted_end": "02:49:08.000",
      "text": "خب دو تا باید خب"
    },
    {
      "id": 25,
      "start": 10148.0,
      "end": 10155.0,
      "formatted_start": "02:49:08.000",
      "formatted_end": "02:49:15.000",
      "text": "حالا ما میتونیم الان این اعضار رو که یک مدیر رو سبت کنیم بازرس رو دوباره سبت کنیم"
    },
    {
      "id": 26,
      "start": 10155.0,
      "end": 10185.0,
      "formatted_start": "02:49:15.000",
      "formatted_end": "02:49:45.000",
      "text": "اگر این که دیگه تنشتر نازی، تا این کجایی که با ما در اینجا را درسته ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با اینکه ماشنه کنید، با ا"
    },
    {
      "id": 27,
      "start": 10185.0,
      "end": 10200.0,
      "formatted_start": "02:49:45.000",
      "formatted_end": "02:50:00.000",
      "text": "از این وقت، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد،"
    }
