  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7830.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:30.000",
      "text": "اگر شک کنی تصویق نداری، اگر اینجوری که شما چیز می کنی نا امیدانه، نه بگید شما اگر نا امیدانه اعتقاد نداشته باشی دارو اثر می نکنه، اگر حرف ما رو قبول نداشته باشی گوش ندید، بازم خزینه که می کنی دوزار فایده، ما بیس پنج سا سی سا می دهیم، سا سی می نارویدیم، دزار تا بچه دیدیم، شاید های دزار تا میشتر می دهیم، خب منظورم که الان دیده گرفتم با"
    },
    {
      "id": 1,
      "start": 7830.0,
      "end": 7832.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:32.000",
      "text": "دندونش باشه یک جیب میزنه"
    },
    {
      "id": 2,
      "start": 7832.0,
      "end": 7835.0,
      "formatted_start": "02:10:32.000",
      "formatted_end": "02:10:35.000",
      "text": "این وقتی که تو دلت درد کنه"
    },
    {
      "id": 3,
      "start": 7835.0,
      "end": 7837.0,
      "formatted_start": "02:10:35.000",
      "formatted_end": "02:10:37.000",
      "text": "فقط تو این حالت آروم میشه"
    },
    {
      "id": 4,
      "start": 7837.0,
      "end": 7840.0,
      "formatted_start": "02:10:37.000",
      "formatted_end": "02:10:40.000",
      "text": "اصلا دکتر این قینا و مرکب این هست مشخص هست"
    },
    {
      "id": 5,
      "start": 7840.0,
      "end": 7842.0,
      "formatted_start": "02:10:40.000",
      "formatted_end": "02:10:42.000",
      "text": "گاز که دفت می کنه آروم میشه"
    },
    {
      "id": 6,
      "start": 7842.0,
      "end": 7844.0,
      "formatted_start": "02:10:42.000",
      "formatted_end": "02:10:44.000",
      "text": "شکمش کار می کنه؟"
    },
    {
      "id": 7,
      "start": 7844.0,
      "end": 7846.0,
      "formatted_start": "02:10:44.000",
      "formatted_end": "02:10:46.000",
      "text": "شکمش هر چند وقت کار می کنه؟"
    },
    {
      "id": 8,
      "start": 7846.0,
      "end": 7848.0,
      "formatted_start": "02:10:46.000",
      "formatted_end": "02:10:48.000",
      "text": "مرده یا"
    },
    {
      "id": 9,
      "start": 7848.0,
      "end": 7850.0,
      "formatted_start": "02:10:48.000",
      "formatted_end": "02:10:50.000",
      "text": "خوبه افتاقی"
    },
    {
      "id": 10,
      "start": 7850.0,
      "end": 7852.0,
      "formatted_start": "02:10:50.000",
      "formatted_end": "02:10:52.000",
      "text": "خوب"
    },
    {
      "id": 11,
      "start": 7852.0,
      "end": 7855.0,
      "formatted_start": "02:10:52.000",
      "formatted_end": "02:10:55.000",
      "text": "این داروهاش آیستادرویو آزاده"
    },
    {
      "id": 12,
      "start": 7855.0,
      "end": 7857.0,
      "formatted_start": "02:10:55.000",
      "formatted_end": "02:10:57.000",
      "text": "داروی میدین این حاله خب؟"
    },
    {
      "id": 13,
      "start": 7857.0,
      "end": 7864.0,
      "formatted_start": "02:10:57.000",
      "formatted_end": "02:11:04.000",
      "text": "دارال رو بیاری ولی خواهشا دارال سر ساعت بدین رژیم رایت کنین که بچه خودتون ازیاد نشه"
    },
    {
      "id": 14,
      "start": 7864.0,
      "end": 7868.0,
      "formatted_start": "02:11:04.000",
      "formatted_end": "02:11:08.000",
      "text": "خودتون این جرک بیزنه دیگه اصلا روح روانتون به هم میریده"
    },
    {
      "id": 15,
      "start": 7868.0,
      "end": 7870.0,
      "formatted_start": "02:11:08.000",
      "formatted_end": "02:11:10.000",
      "text": "خب اصلا از کار میمونین"
    },
    {
      "id": 16,
      "start": 7870.0,
      "end": 7874.0,
      "formatted_start": "02:11:10.000",
      "formatted_end": "02:11:14.000",
      "text": "من فقط الان یک کرم این برداشتون مردم"
    },
    {
      "id": 17,
      "start": 7874.0,
      "end": 7876.0,
      "formatted_start": "02:11:14.000",
      "formatted_end": "02:11:16.000",
      "text": "ببین اصلا از غذا بیست"
    },
    {
      "id": 18,
      "start": 7876.0,
      "end": 7878.0,
      "formatted_start": "02:11:16.000",
      "formatted_end": "02:11:18.000",
      "text": "من اصلا مردم با میمه چون"
    },
    {
      "id": 19,
      "start": 7878.0,
      "end": 7880.0,
      "formatted_start": "02:11:18.000",
      "formatted_end": "02:11:20.000",
      "text": "ببین این رو وظیفه منو توضیح بدم"
    },
    {
      "id": 20,
      "start": 7880.0,
      "end": 7883.0,
      "formatted_start": "02:11:20.000",
      "formatted_end": "02:11:23.000",
      "text": "حالا یه موقع اصلا مادر مستربه شیر جوش میخویه"
    },
    {
      "id": 21,
      "start": 7883.0,
      "end": 7886.76,
      "formatted_start": "02:11:23.000",
      "formatted_end": "02:11:26.760",
      "text": "دیگه اون قصد اصلا صادقه نارتی میده تو خانواده زیاده"
    },
    {
      "id": 22,
      "start": 7886.76,
      "end": 7891.0,
      "formatted_start": "02:11:26.760",
      "formatted_end": "02:11:31.000",
      "text": "مثلا این طرف پدری و مادری آدم هایی هستن که نارتی میده دارن"
    },
    {
      "id": 23,
      "start": 7891.0,
      "end": 7895.5,
      "formatted_start": "02:11:31.000",
      "formatted_end": "02:11:35.500",
      "text": "خانواده هایی که نارتی میده درشون زیاده بچه هاشون این گولنجو دارن"
    },
    {
      "id": 24,
      "start": 7895.5,
      "end": 7897.0,
      "formatted_start": "02:11:35.500",
      "formatted_end": "02:11:37.000",
      "text": "جنتی"
    },
    {
      "id": 25,
      "start": 7897.0,
      "end": 7899.0,
      "formatted_start": "02:11:37.000",
      "formatted_end": "02:11:39.000",
      "text": "خب مثلا این آنها اموی دارید"
    },
    {
      "id": 26,
      "start": 7899.0,
      "end": 7901.0,
      "formatted_start": "02:11:39.000",
      "formatted_end": "02:11:41.000",
      "text": "خودم اصلا شوهرتی"
    },
    {
      "id": 27,
      "start": 7901.0,
      "end": 7903.0,
      "formatted_start": "02:11:41.000",
      "formatted_end": "02:11:43.000",
      "text": "شیر ماسینا خیلی کم"
    },
    {
      "id": 28,
      "start": 7903.0,
      "end": 7905.0,
      "formatted_start": "02:11:43.000",
      "formatted_end": "02:11:45.000",
      "text": "تشخیص درسته یعنی گولنجه"
    },
    {
      "id": 29,
      "start": 7905.0,
      "end": 7908.0,
      "formatted_start": "02:11:45.000",
      "formatted_end": "02:11:48.000",
      "text": "وگرنه اگه این نباشه من باید یه سری آزمایش بگیسم"
    },
    {
      "id": 30,
      "start": 7908.0,
      "end": 7920.0,
      "formatted_start": "02:11:48.000",
      "formatted_end": "02:12:00.000",
      "text": "اینجا باید خطنه خود را باید اصلاح کنید"
    },
    {
      "id": 31,
      "start": 7920.0,
      "end": 7922.0,
      "formatted_start": "02:12:00.000",
      "formatted_end": "02:12:02.000",
      "text": "اگر خطنه کنید، باید بچه ناقص میشه"
    },
    {
      "id": 32,
      "start": 7922.0,
      "end": 7924.0,
      "formatted_start": "02:12:02.000",
      "formatted_end": "02:12:04.000",
      "text": "از پوست خطنه"
    },
    {
      "id": 33,
      "start": 7924.0,
      "end": 7926.0,
      "formatted_start": "02:12:04.000",
      "formatted_end": "02:12:06.000",
      "text": "ببینید کورش شفیفور ببرید"
    },
    {
      "id": 34,
      "start": 7926.0,
      "end": 7928.0,
      "formatted_start": "02:12:06.000",
      "formatted_end": "02:12:08.000",
      "text": "این مقصد خطنه"
    },
    {
      "id": 35,
      "start": 7928.0,
      "end": 7930.0,
      "formatted_start": "02:12:08.000",
      "formatted_end": "02:12:10.000",
      "text": "حتما ببرید اون اصلاح کنید"
    },
    {
      "id": 36,
      "start": 7930.0,
      "end": 7932.0,
      "formatted_start": "02:12:10.000",
      "formatted_end": "02:12:12.000",
      "text": "موقع اصلاح کردن اون"
    },
    {
      "id": 37,
      "start": 7932.0,
      "end": 7934.0,
      "formatted_start": "02:12:12.000",
      "formatted_end": "02:12:14.000",
      "text": "خطنه هم میشه"
    },
    {
      "id": 38,
      "start": 7934.0,
      "end": 7936.0,
      "formatted_start": "02:12:14.000",
      "formatted_end": "02:12:16.000",
      "text": "خودشون ببینید با خود نه"
    },
    {
      "id": 39,
      "start": 7936.0,
      "end": 7966.0,
      "formatted_start": "02:12:16.000",
      "formatted_end": "02:12:46.000",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 40,
      "start": 7966.0,
      "end": 7968.0,
      "formatted_start": "02:12:46.000",
      "formatted_end": "02:12:48.000",
      "text": "وقتی بیمه زده بیمه"
    },
    {
      "id": 41,
      "start": 7968.0,
      "end": 7970.0,
      "formatted_start": "02:12:48.000",
      "formatted_end": "02:12:50.000",
      "text": "ببین آره"
    },
    {
      "id": 42,
      "start": 7970.0,
      "end": 7972.0,
      "formatted_start": "02:12:50.000",
      "formatted_end": "02:12:52.000",
      "text": "یا سربارش"
    },
    {
      "id": 43,
      "start": 7972.0,
      "end": 7974.0,
      "formatted_start": "02:12:52.000",
      "formatted_end": "02:12:54.000",
      "text": "مثلا اینجا این دارو دگزاش صفره"
    },
    {
      "id": 44,
      "start": 7974.0,
      "end": 7976.0,
      "formatted_start": "02:12:54.000",
      "formatted_end": "02:12:56.000",
      "text": "اصلا پول نگرفته"
    },
    {
      "id": 45,
      "start": 7976.0,
      "end": 7978.0,
      "formatted_start": "02:12:56.000",
      "formatted_end": "02:12:58.000",
      "text": "سفتیزوکسیم پول نگرفته"
    },
    {
      "id": 46,
      "start": 7978.0,
      "end": 7980.0,
      "formatted_start": "02:12:58.000",
      "formatted_end": "02:13:00.000",
      "text": "صفر زده بیمه"
    },
    {
      "id": 47,
      "start": 7980.0,
      "end": 7982.0,
      "formatted_start": "02:13:00.000",
      "formatted_end": "02:13:02.000",
      "text": "برات حالا از خود این رو خواهیم"
    },
    {
      "id": 48,
      "start": 7982.0,
      "end": 7984.0,
      "formatted_start": "02:13:02.000",
      "formatted_end": "02:13:04.000",
      "text": "643 تومن"
    },
    {
      "id": 49,
      "start": 7984.0,
      "end": 7986.0,
      "formatted_start": "02:13:04.000",
      "formatted_end": "02:13:06.000",
      "text": "خوب"
    },
    {
      "id": 50,
      "start": 7986.0,
      "end": 7988.0,
      "formatted_start": "02:13:06.000",
      "formatted_end": "02:13:08.000",
      "text": "دیگه اینجا آق مقدر"
    },
    {
      "id": 51,
      "start": 7988.0,
      "end": 7990.0,
      "formatted_start": "02:13:08.000",
      "formatted_end": "02:13:10.000",
      "text": "150 تومن"
    },
    {
      "id": 52,
      "start": 7990.0,
      "end": 7992.0,
      "formatted_start": "02:13:10.000",
      "formatted_end": "02:13:12.000",
      "text": "سرنگه"
    },
    {
      "id": 53,
      "start": 7992.0,
      "end": 7994.0,
      "formatted_start": "02:13:12.000",
      "formatted_end": "02:13:14.000",
      "text": "200 تومن سرنگه"
    },
    {
      "id": 54,
      "start": 7994.0,
      "end": 7999.0,
      "formatted_start": "02:13:14.000",
      "formatted_end": "02:13:19.000",
      "text": "منم ماندم خیلی بالا از ساپ کرده های دوست دارم"
    },
    {
      "id": 55,
      "start": 7999.0,
      "end": 8004.0,
      "formatted_start": "02:13:19.000",
      "formatted_end": "02:13:24.000",
      "text": "نه این سرنگ دوستی سیر و پل علکولی 22 تومن"
    },
    {
      "id": 56,
      "start": 8004.0,
      "end": 8007.0,
      "formatted_start": "02:13:24.000",
      "formatted_end": "02:13:27.000",
      "text": "بعد اینجا"
    },
    {
      "id": 57,
      "start": 8007.0,
      "end": 8011.0,
      "formatted_start": "02:13:27.000",
      "formatted_end": "02:13:31.000",
      "text": "یا تو رو بیرون شده یا من خدا مانم"
    },
    {
      "id": 58,
      "start": 8011.0,
      "end": 8014.0,
      "formatted_start": "02:13:31.000",
      "formatted_end": "02:13:34.000",
      "text": "دیگه این 400 تومن این شروط شده"
    },
    {
      "id": 59,
      "start": 8014.0,
      "end": 8018.0,
      "formatted_start": "02:13:34.000",
      "formatted_end": "02:13:38.000",
      "text": "از اونو من گفتم به دکتور گفتم که به این تو سرما خوردی میگیر"
    },
    {
      "id": 60,
      "start": 8018.0,
      "end": 8020.0,
      "formatted_start": "02:13:38.000",
      "formatted_end": "02:13:40.000",
      "text": "بگو عوض کنه سرما خوردی دیگه"
    },
    {
      "id": 61,
      "start": 8020.0,
      "end": 8021.0,
      "formatted_start": "02:13:40.000",
      "formatted_end": "02:13:41.000",
      "text": "دوریزان آره"
    },
    {
      "id": 62,
      "start": 8021.0,
      "end": 8022.0,
      "formatted_start": "02:13:41.000",
      "formatted_end": "02:13:42.000",
      "text": "آره اگه میخوای قیمت نیست"
    },
    {
      "id": 63,
      "start": 8022.0,
      "end": 8024.0,
      "formatted_start": "02:13:42.000",
      "formatted_end": "02:13:44.000",
      "text": "باید ناران میشیم"
    },
    {
      "id": 64,
      "start": 8024.0,
      "end": 8027.0,
      "formatted_start": "02:13:44.000",
      "formatted_end": "02:13:47.000",
      "text": "نه ناران نه بگو دکتر کفت کریزان بگی"
    },
    {
      "id": 65,
      "start": 8027.0,
      "end": 8031.0,
      "formatted_start": "02:13:47.000",
      "formatted_end": "02:13:51.000",
      "text": "باید دکتر کفت سرما خوردگی معمولی بیده"
    },
    {
      "id": 66,
      "start": 8031.0,
      "end": 8033.0,
      "formatted_start": "02:13:51.000",
      "formatted_end": "02:13:53.000",
      "text": "برای تا باشه"
    },
    {
      "id": 67,
      "start": 8033.0,
      "end": 8035.0,
      "formatted_start": "02:13:53.000",
      "formatted_end": "02:13:55.000",
      "text": "این شعبت از من داشته"
    },
    {
      "id": 68,
      "start": 8035.0,
      "end": 8037.0,
      "formatted_start": "02:13:55.000",
      "formatted_end": "02:13:57.000",
      "text": "این شعبت شعبت از درد کنه"
    },
    {
      "id": 69,
      "start": 8037.0,
      "end": 8039.0,
      "formatted_start": "02:13:57.000",
      "formatted_end": "02:13:59.000",
      "text": "بسیار"
    },
    {
      "id": 70,
      "start": 8039.0,
      "end": 8041.0,
      "formatted_start": "02:13:59.000",
      "formatted_end": "02:14:01.000",
      "text": "باشه، پس آقا دکتر این"
    },
    {
      "id": 71,
      "start": 8041.0,
      "end": 8043.0,
      "formatted_start": "02:14:01.000",
      "formatted_end": "02:14:03.000",
      "text": "اگه بعضی وقت از اولاش اونجا شد که"
    },
    {
      "id": 72,
      "start": 8043.0,
      "end": 8045.0,
      "formatted_start": "02:14:03.000",
      "formatted_end": "02:14:05.000",
      "text": "الان میگه درکه"
    },
    {
      "id": 73,
      "start": 8045.0,
      "end": 8047.0,
      "formatted_start": "02:14:05.000",
      "formatted_end": "02:14:07.000",
      "text": "باید برم شانو بگیرم یا نه"
    },
    {
      "id": 74,
      "start": 8047.0,
      "end": 8049.0,
      "formatted_start": "02:14:07.000",
      "formatted_end": "02:14:09.000",
      "text": "ببین اینا بعضی موقع ها دیگه حساس نشید"
    },
    {
      "id": 75,
      "start": 8049.0,
      "end": 8051.0,
      "formatted_start": "02:14:09.000",
      "formatted_end": "02:14:11.000",
      "text": "این تنبالی روده هم داره"
    },
    {
      "id": 76,
      "start": 8051.0,
      "end": 8053.0,
      "formatted_start": "02:14:11.000",
      "formatted_end": "02:14:13.000",
      "text": "حالا یه سنوکنی بهتره"
    },
    {
      "id": 77,
      "start": 8053.0,
      "end": 8055.0,
      "formatted_start": "02:14:13.000",
      "formatted_end": "02:14:15.000",
      "text": "یه از شکمه یا"
    },
    {
      "id": 78,
      "start": 8055.0,
      "end": 8057.0,
      "formatted_start": "02:14:15.000",
      "formatted_end": "02:14:17.000",
      "text": "بله یه سنوکنی اون موقع راحتت میشون بود"
    },
    {
      "id": 79,
      "start": 8057.0,
      "end": 8059.0,
      "formatted_start": "02:14:17.000",
      "formatted_end": "02:14:19.000",
      "text": "خاطر که پولش..."
    },
    {
      "id": 80,
      "start": 8059.0,
      "end": 8062.0,
      "formatted_start": "02:14:19.000",
      "formatted_end": "02:14:22.000",
      "text": "حالا فیرنس همون خیلی ارجانسی نیست"
    },
    {
      "id": 81,
      "start": 8062.0,
      "end": 8063.0,
      "formatted_start": "02:14:22.000",
      "formatted_end": "02:14:23.000",
      "text": "آره آره"
    },
    {
      "id": 82,
      "start": 8063.0,
      "end": 8064.0,
      "formatted_start": "02:14:23.000",
      "formatted_end": "02:14:24.000",
      "text": "ارجانسی نیست"
    },
    {
      "id": 83,
      "start": 8064.0,
      "end": 8066.0,
      "formatted_start": "02:14:24.000",
      "formatted_end": "02:14:26.000",
      "text": "بس اون چیز هم از عصابه نیست"
    },
    {
      "id": 84,
      "start": 8066.0,
      "end": 8069.0,
      "formatted_start": "02:14:26.000",
      "formatted_end": "02:14:29.000",
      "text": "تنگین... یا از گلوش بودش"
    },
    {
      "id": 85,
      "start": 8069.0,
      "end": 8070.0,
      "formatted_start": "02:14:29.000",
      "formatted_end": "02:14:30.000",
      "text": "از گلوشه"
    },
    {
      "id": 86,
      "start": 8070.0,
      "end": 8071.0,
      "formatted_start": "02:14:30.000",
      "formatted_end": "02:14:31.000",
      "text": "بیشبت"
    },
    {
      "id": 87,
      "start": 8071.0,
      "end": 8072.0,
      "formatted_start": "02:14:31.000",
      "formatted_end": "02:14:32.000",
      "text": "آره از گلوشه"
    },
    {
      "id": 88,
      "start": 8072.0,
      "end": 8073.0,
      "formatted_start": "02:14:32.000",
      "formatted_end": "02:14:33.000",
      "text": "من..."
    },
    {
      "id": 89,
      "start": 8073.0,
      "end": 8074.0,
      "formatted_start": "02:14:33.000",
      "formatted_end": "02:14:34.000",
      "text": "خدافت شما وزده باشید"
    },
    {
      "id": 90,
