  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12913.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:13.000",
      "text": "بروفین، آره، متعه شده. خوب. مایات، فرزش، خوب. باشه شما. ممنون. خوربان هست، خدافز خدافز."
    },
    {
      "id": 1,
      "start": 12913.0,
      "end": 12921.0,
      "formatted_start": "03:35:13.000",
      "formatted_end": "03:35:21.000",
      "text": "خانسمین این طرف شفتی پور کلیه میگی که شیاف دیکروفنات یا اندومتاسین صدقی کرد اینا"
    },
    {
      "id": 2,
      "start": 12921.0,
      "end": 12931.0,
      "formatted_start": "03:35:21.000",
      "formatted_end": "03:35:31.000",
      "text": "خب روزی دو سه تا وز داره برس مسکن هم هر کدام که بهش میسازه بروفینی میبینن هم خالد ناپروستان اینا"
    },
    {
      "id": 3,
      "start": 12931.0,
      "end": 12941.0,
      "formatted_start": "03:35:31.000",
      "formatted_end": "03:35:41.000",
      "text": "آق زیاد بخوره ورزش فالیت تا ده روز اگر تا ده روز افتاد و برطرف شد که چگه تا ده روز نیفتاد بپیشنه"
    },
    {
      "id": 4,
      "start": 12971.0,
      "end": 12995.0,
      "formatted_start": "03:36:11.000",
      "formatted_end": "03:36:35.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 12995.0,
      "end": 12997.0,
      "formatted_start": "03:36:35.000",
      "formatted_end": "03:36:37.000",
      "text": "سلام"
    },
    {
      "id": 6,
      "start": 12997.0,
      "end": 12999.0,
      "formatted_start": "03:36:37.000",
      "formatted_end": "03:36:39.000",
      "text": "مرسی"
    },
    {
      "id": 7,
      "start": 12999.0,
      "end": 13001.0,
      "formatted_start": "03:36:39.000",
      "formatted_end": "03:36:41.000",
      "text": "سلام خاله شما"
    },
    {
      "id": 8,
      "start": 13001.0,
      "end": 13003.0,
      "formatted_start": "03:36:41.000",
      "formatted_end": "03:36:43.000",
      "text": "خوبه اون برگره بزنیم"
    },
    {
      "id": 9,
      "start": 13003.0,
      "end": 13005.0,
      "formatted_start": "03:36:43.000",
      "formatted_end": "03:36:45.000",
      "text": "خانم یوسف زایی چی شده؟"
    },
    {
      "id": 10,
      "start": 13005.0,
      "end": 13007.0,
      "formatted_start": "03:36:45.000",
      "formatted_end": "03:36:47.000",
      "text": "از دیشب یه باردم میاره"
    },
    {
      "id": 11,
      "start": 13007.0,
      "end": 13009.0,
      "formatted_start": "03:36:47.000",
      "formatted_end": "03:36:49.000",
      "text": "استفراف؟ اصال هم شده؟"
    },
    {
      "id": 12,
      "start": 13009.0,
      "end": 13011.0,
      "formatted_start": "03:36:49.000",
      "formatted_end": "03:36:51.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 13011.0,
      "end": 13013.0,
      "formatted_start": "03:36:51.000",
      "formatted_end": "03:36:53.000",
      "text": "فکر کنم انگل با پیزا خور"
    },
    {
      "id": 14,
      "start": 13013.0,
      "end": 13015.0,
      "formatted_start": "03:36:53.000",
      "formatted_end": "03:36:55.000",
      "text": "بهش گفتم نخور"
    },
    {
      "id": 15,
      "start": 13015.0,
      "end": 13017.0,
      "formatted_start": "03:36:55.000",
      "formatted_end": "03:36:57.000",
      "text": "پنه اون دوتا رو برم خورده"
    },
    {
      "id": 16,
      "start": 13017.0,
      "end": 13019.0,
      "formatted_start": "03:36:57.000",
      "formatted_end": "03:36:59.000",
      "text": "و دیگه همش برم بگیر"
    },
    {
      "id": 17,
      "start": 13019.0,
      "end": 13021.0,
      "formatted_start": "03:36:59.000",
      "formatted_end": "03:37:01.000",
      "text": "و صبح کم هم طب داشت"
    },
    {
      "id": 18,
      "start": 13021.0,
      "end": 13023.0,
      "formatted_start": "03:37:01.000",
      "formatted_end": "03:37:03.000",
      "text": "طب خفیر؟ خوبه"
    },
    {
      "id": 19,
      "start": 13023.0,
      "end": 13025.0,
      "formatted_start": "03:37:03.000",
      "formatted_end": "03:37:05.000",
      "text": "چند بار استفراح؟ دو سه بار"
    },
    {
      "id": 20,
      "start": 13025.0,
      "end": 13027.0,
      "formatted_start": "03:37:05.000",
      "formatted_end": "03:37:07.000",
      "text": "قسمت چیه؟"
    },
    {
      "id": 21,
      "start": 13027.0,
      "end": 13029.0,
      "formatted_start": "03:37:07.000",
      "formatted_end": "03:37:09.000",
      "text": "دلبین"
    },
    {
      "id": 22,
      "start": 13029.0,
      "end": 13031.0,
      "formatted_start": "03:37:09.000",
      "formatted_end": "03:37:11.000",
      "text": "چی؟ دلبین؟"
    },
    {
      "id": 23,
      "start": 13031.0,
      "end": 13033.0,
      "formatted_start": "03:37:11.000",
      "formatted_end": "03:37:13.000",
      "text": "دلبین"
    },
    {
      "id": 24,
      "start": 13033.0,
      "end": 13035.0,
      "formatted_start": "03:37:13.000",
      "formatted_end": "03:37:15.000",
      "text": "ششم های قشنگی داریم"
    },
    {
      "id": 25,
      "start": 13035.0,
      "end": 13037.0,
      "formatted_start": "03:37:15.000",
      "formatted_end": "03:37:17.000",
      "text": "یک شموم بیریم"
    },
    {
      "id": 26,
      "start": 13037.0,
      "end": 13039.0,
      "formatted_start": "03:37:17.000",
      "formatted_end": "03:37:19.000",
      "text": "برزش هم خیلی کهی"
    },
    {
      "id": 27,
      "start": 13039.0,
      "end": 13041.0,
      "formatted_start": "03:37:19.000",
      "formatted_end": "03:37:21.000",
      "text": "کم سالشه؟"
    },
    {
      "id": 28,
      "start": 13041.0,
      "end": 13043.0,
      "formatted_start": "03:37:21.000",
      "formatted_end": "03:37:23.000",
      "text": "کم ساله ده؟"
    },
    {
      "id": 29,
      "start": 13043.0,
      "end": 13045.0,
      "formatted_start": "03:37:23.000",
      "formatted_end": "03:37:25.000",
      "text": "سه سال"
    },
    {
      "id": 30,
      "start": 13045.0,
      "end": 13047.0,
      "formatted_start": "03:37:25.000",
      "formatted_end": "03:37:27.000",
      "text": "بیا بیا بیا"
    },
    {
      "id": 31,
      "start": 13047.0,
      "end": 13049.0,
      "formatted_start": "03:37:27.000",
      "formatted_end": "03:37:29.000",
      "text": "سه سال"
    },
    {
      "id": 32,
      "start": 13049.0,
      "end": 13051.0,
      "formatted_start": "03:37:29.000",
      "formatted_end": "03:37:31.000",
      "text": "همه چیزی برد"
    },
    {
      "id": 33,
      "start": 13051.0,
      "end": 13054.0,
      "formatted_start": "03:37:31.000",
      "formatted_end": "03:37:34.000",
      "text": "هم اجتماعی هستی و هم زبونت خوبه"
    },
    {
      "id": 34,
      "start": 13054.0,
      "end": 13056.0,
      "formatted_start": "03:37:34.000",
      "formatted_end": "03:37:36.000",
      "text": "همچی هم نمیخوره"
    },
    {
      "id": 35,
      "start": 13056.0,
      "end": 13058.0,
      "formatted_start": "03:37:36.000",
      "formatted_end": "03:37:38.000",
      "text": "هرام بخوره هم برده"
    },
    {
      "id": 36,
      "start": 13058.0,
      "end": 13059.0,
      "formatted_start": "03:37:38.000",
      "formatted_end": "03:37:39.000",
      "text": "بازم رو"
    },
    {
      "id": 37,
      "start": 13059.0,
      "end": 13060.0,
      "formatted_start": "03:37:39.000",
      "formatted_end": "03:37:40.000",
      "text": "نکنم"
    },
    {
      "id": 38,
      "start": 13060.0,
      "end": 13061.0,
      "formatted_start": "03:37:40.000",
      "formatted_end": "03:37:41.000",
      "text": "نه"
    },
    {
      "id": 39,
      "start": 13061.0,
      "end": 13063.0,
      "formatted_start": "03:37:41.000",
      "formatted_end": "03:37:43.000",
      "text": "حلوه بوله اینا نمیخوره؟"
    },
    {
      "id": 40,
      "start": 13063.0,
      "end": 13064.0,
      "formatted_start": "03:37:43.000",
      "formatted_end": "03:37:44.000",
      "text": "نمیخوره"
    },
    {
      "id": 41,
      "start": 13064.0,
      "end": 13065.0,
      "formatted_start": "03:37:44.000",
      "formatted_end": "03:37:45.000",
      "text": "باقی انا سیرش میکنه"
    },
    {
      "id": 42,
      "start": 13065.0,
      "end": 13067.0,
      "formatted_start": "03:37:45.000",
      "formatted_end": "03:37:47.000",
      "text": "کنفرکی توز بخوره؟"
    },
    {
      "id": 43,
      "start": 13067.0,
      "end": 13069.0,
      "formatted_start": "03:37:47.000",
      "formatted_end": "03:37:49.000",
      "text": "کنفرکی نه بستنی بستنی"
    },
    {
      "id": 44,
      "start": 13069.0,
      "end": 13070.0,
      "formatted_start": "03:37:49.000",
      "formatted_end": "03:37:50.000",
      "text": "بستنی اینا کالومیستی هست دیگه"
    },
    {
      "id": 45,
      "start": 13070.0,
      "end": 13071.0,
      "formatted_start": "03:37:50.000",
      "formatted_end": "03:37:51.000",
      "text": "کنفرک بشنی"
    },
    {
      "id": 46,
      "start": 13071.0,
      "end": 13072.0,
      "formatted_start": "03:37:51.000",
      "formatted_end": "03:37:52.000",
      "text": "آفرین بختر فهمیده هست"
    },
    {
      "id": 47,
      "start": 13072.0,
      "end": 13073.0,
      "formatted_start": "03:37:52.000",
      "formatted_end": "03:37:53.000",
      "text": "بازمو میخوری خوب"
    },
    {
      "id": 48,
      "start": 13073.0,
      "end": 13075.0,
      "formatted_start": "03:37:53.000",
      "formatted_end": "03:37:55.000",
      "text": "بستنی هم کم بخور خوب"
    },
    {
      "id": 49,
      "start": 13075.0,
      "end": 13077.0,
      "formatted_start": "03:37:55.000",
      "formatted_end": "03:37:57.000",
      "text": "بابا؟ گوش میدی؟"
    },
    {
      "id": 50,
      "start": 13077.0,
      "end": 13080.0,
      "formatted_start": "03:37:57.000",
      "formatted_end": "03:38:00.000",
      "text": "آره؟ دهند رو باز کن آنو ببینه"
    },
    {
      "id": 51,
      "start": 13080.0,
      "end": 13083.0,
      "formatted_start": "03:38:00.000",
      "formatted_end": "03:38:03.000",
      "text": "باز خب چراپاو بیداده میده دورش نیده"
    },
    {
      "id": 52,
      "start": 13083.0,
      "end": 13085.46,
      "formatted_start": "03:38:03.000",
      "formatted_end": "03:38:05.460",
      "text": "بله بله، کامپلون میدونه بابا"
    },
    {
      "id": 53,
      "start": 13085.46,
      "end": 13086.66,
      "formatted_start": "03:38:05.460",
      "formatted_end": "03:38:06.660",
      "text": "دیگه آفرین"
    },
    {
      "id": 54,
      "start": 13086.66,
      "end": 13087.46,
      "formatted_start": "03:38:06.660",
      "formatted_end": "03:38:07.460",
      "text": "اون میخواد نیست"
    },
    {
      "id": 55,
      "start": 13087.46,
      "end": 13089.0,
      "formatted_start": "03:38:07.460",
      "formatted_end": "03:38:09.000",
      "text": "ما این درمه ها قارون"
    },
    {
      "id": 56,
      "start": 13089.0,
      "end": 13091.0,
      "formatted_start": "03:38:09.000",
      "formatted_end": "03:38:11.000",
      "text": "نیمیتر داریم، آفرین"
    },
    {
      "id": 57,
      "start": 13091.0,
      "end": 13094.0,
      "formatted_start": "03:38:11.000",
      "formatted_end": "03:38:14.000",
      "text": "آفرین، آفرین، خب که این دوست داره اصطلاح میدونه"
    },
    {
      "id": 58,
      "start": 13094.0,
      "end": 13096.76,
      "formatted_start": "03:38:14.000",
      "formatted_end": "03:38:16.760",
      "text": "من مجبورم اینکه دوتا برای ادعالت استفلاح"
    },
    {
      "id": 59,
      "start": 13096.76,
      "end": 13099.26,
      "formatted_start": "03:38:16.760",
      "formatted_end": "03:38:19.260",
      "text": "که اون دارو هم بر بیارید دونه ها"
    },
    {
      "id": 60,
      "start": 13099.26,
      "end": 13107.26,
      "formatted_start": "03:38:19.260",
      "formatted_end": "03:38:27.260",
      "text": "این مصمومیت یک از آهی خانم یوسفی اعتمال داره بعد از استفلاح اصحاب میشه"
    },
    {
      "id": 61,
      "start": 13107.26,
      "end": 13110.26,
      "formatted_start": "03:38:27.260",
      "formatted_end": "03:38:30.260",
      "text": "اگر خیلی اصحاب شدید بیاد من"
    },
    {
      "id": 62,
      "start": 13110.26,
      "end": 13120.26,
      "formatted_start": "03:38:30.260",
      "formatted_end": "03:38:40.260",
      "text": "بادرین که هیچی نمیخورد"
    },
    {
      "id": 63,
      "start": 13120.26,
      "end": 13124.26,
      "formatted_start": "03:38:40.260",
      "formatted_end": "03:38:44.260",
      "text": "اون هیچی نمیخورد؟ قرار شد که شما حلو بوله رو هزت کنی؟"
    },
    {
      "id": 64,
      "start": 13124.26,
      "end": 13126.26,
      "formatted_start": "03:38:44.260",
      "formatted_end": "03:38:46.260",
      "text": "کلا هر کاری هم کنیم وازم نمیخورد"
    },
    {
      "id": 65,
      "start": 13126.26,
      "end": 13130.26,
      "formatted_start": "03:38:46.260",
      "formatted_end": "03:38:50.260",
      "text": "و یک شربت راسیب میدویسم اگر خواستیم براشم"
    },
    {
      "id": 66,
      "start": 13130.26,
      "end": 13134.26,
      "formatted_start": "03:38:50.260",
      "formatted_end": "03:38:54.260",
      "text": "اولا شربت زیاد به ارتباطش میدونیم بازم تأثیر زیمیم"
    },
    {
      "id": 67,
      "start": 13134.26,
      "end": 13136.26,
      "formatted_start": "03:38:54.260",
      "formatted_end": "03:38:56.260",
      "text": "ببینیم الان سه سالشه"
    },
    {
      "id": 68,
      "start": 13136.26,
      "end": 13141.26,
      "formatted_start": "03:38:56.260",
      "formatted_end": "03:39:01.260",
      "text": "بهترین شربت این اشتعاور الان موجود در جاروخانه ها راسیبه"
    },
    {
      "id": 69,
      "start": 13141.26,
      "end": 13146.26,
      "formatted_start": "03:39:01.260",
      "formatted_end": "03:39:06.260",
      "text": "و دکتور تغذیه برده این میگه که جلوش بذاریم خودش بگفت"
    },
    {
      "id": 70,
      "start": 13146.26,
      "end": 13148.26,
      "formatted_start": "03:39:06.260",
      "formatted_end": "03:39:08.260",
      "text": "خودش که تا سه سالی بگفت"
    },
    {
      "id": 71,
      "start": 13148.26,
      "end": 13150.26,
      "formatted_start": "03:39:08.260",
      "formatted_end": "03:39:10.260",
      "text": "جانم"
    },
    {
      "id": 72,
      "start": 13150.26,
      "end": 13152.26,
      "formatted_start": "03:39:10.260",
      "formatted_end": "03:39:12.260",
      "text": "چی هم میدون؟"
    },
    {
      "id": 73,
      "start": 13152.26,
      "end": 13154.26,
      "formatted_start": "03:39:12.260",
      "formatted_end": "03:39:14.260",
      "text": "راپور بذاریم بابا"
    },
    {
      "id": 74,
      "start": 13154.26,
      "end": 13156.26,
      "formatted_start": "03:39:14.260",
      "formatted_end": "03:39:16.260",
      "text": "آره، آره، خیلی کلی"
    },
    {
      "id": 75,
      "start": 13156.26,
      "end": 13158.26,
      "formatted_start": "03:39:16.260",
      "formatted_end": "03:39:18.260",
      "text": "آفرین، آفرین"
    },
    {
      "id": 76,
      "start": 13158.26,
      "end": 13160.26,
      "formatted_start": "03:39:18.260",
      "formatted_end": "03:39:20.260",
      "text": "یوسف زیری ما دیدیم که"
    },
    {
      "id": 77,
      "start": 13160.26,
      "end": 13162.26,
      "formatted_start": "03:39:20.260",
      "formatted_end": "03:39:22.260",
      "text": "تو جا هست"
    },
    {
      "id": 78,
      "start": 13162.26,
      "end": 13164.26,
      "formatted_start": "03:39:22.260",
      "formatted_end": "03:39:24.260",
      "text": "و از آنکول هم نمیترسه"
    },
    {
      "id": 79,
      "start": 13164.26,
      "end": 13166.26,
      "formatted_start": "03:39:24.260",
      "formatted_end": "03:39:26.260",
      "text": "اونو نمیترسه نباشه"
    },
    {
      "id": 80,
      "start": 13166.26,
      "end": 13168.26,
      "formatted_start": "03:39:26.260",
      "formatted_end": "03:39:28.260",
      "text": "خب، الان سه سال شه سنش"
    },
    {
      "id": 81,
      "start": 13168.26,
      "end": 13170.26,
      "formatted_start": "03:39:28.260",
      "formatted_end": "03:39:30.260",
      "text": "اقلی دهید؟"
    },
    {
      "id": 82,
      "start": 13170.26,
      "end": 13172.26,
      "formatted_start": "03:39:30.260",
      "formatted_end": "03:39:32.260",
      "text": "تقریبا بودیم اونو بیش سه سال"
    },
    {
      "id": 83,
      "start": 13172.26,
      "end": 13174.26,
      "formatted_start": "03:39:32.260",
      "formatted_end": "03:39:34.260",
      "text": "دو سال و خوب"
    },
    {
      "id": 84,
      "start": 13174.26,
      "end": 13176.26,
      "formatted_start": "03:39:34.260",
      "formatted_end": "03:39:36.260",
      "text": "دیدیم الان باید سیزده کیلو وزیرا"
    },
    {
      "id": 85,
      "start": 13176.26,
      "end": 13178.26,
      "formatted_start": "03:39:36.260",
      "formatted_end": "03:39:38.260",
      "text": "باشه"
    },
    {
      "id": 86,
      "start": 13178.26,
      "end": 13180.26,
      "formatted_start": "03:39:38.260",
      "formatted_end": "03:39:40.260",
      "text": "و جنیتیک هم هست داره"
    },
    {
      "id": 87,
      "start": 13180.26,
      "end": 13182.26,
      "formatted_start": "03:39:40.260",
      "formatted_end": "03:39:42.260",
      "text": "جزء مادر و پدر هم جاری"
    },
    {
      "id": 88,
      "start": 13182.26,
      "end": 13184.26,
      "formatted_start": "03:39:42.260",
      "formatted_end": "03:39:44.260",
      "text": "ماما نمیترسی"
    },
    {
      "id": 89,
      "start": 13184.26,
      "end": 13187.26,
      "formatted_start": "03:39:44.260",
      "formatted_end": "03:39:47.260",
      "text": "آفرین، ماما نمیترسی، آقا من ماما شخصی"
    },
    {
      "id": 90,
      "start": 13187.26,
      "end": 13190.26,
      "formatted_start": "03:39:47.260",
      "formatted_end": "03:39:50.260",
      "text": "در این یه مقدار به راست نقش داریم"
    },
    {
      "id": 91,
      "start": 13190.26,
      "end": 13193.26,
      "formatted_start": "03:39:50.260",
      "formatted_end": "03:39:53.260",
      "text": "یعنی فکر مادر، پدر با این قضیه تصویر بود"
    },
    {
      "id": 92,
      "start": 13193.26,
      "end": 13198.26,
      "formatted_start": "03:39:53.260",
      "formatted_end": "03:39:58.260",
      "text": "بعضی با جلیش های رشدی توی 11، 13 بلوز دارند بسران"
    },
    {
      "id": 93,
      "start": 13198.26,
      "end": 13200.26,
      "formatted_start": "03:39:58.260",
      "formatted_end": "03:40:00.260",
      "text": "یا پسران"
    }
  ],
  "status": "completed"
}