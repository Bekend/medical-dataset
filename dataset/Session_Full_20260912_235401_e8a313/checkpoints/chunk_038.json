  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11405.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:05.000",
      "text": "در این کنار، مثلا، همه ای کنه حقیقت، مثلا روگروش داریم اونو بزاریم، اجازه همجوری کنیم بهتونیم."
    },
    {
      "id": 1,
      "start": 11405.0,
      "end": 11413.0,
      "formatted_start": "03:10:05.000",
      "formatted_end": "03:10:13.000",
      "text": "ما این میکی دارم، روگرو شهرداری، روگرو شرکت فاونی، کنار آقای تقریزاده کاشی، کاشی کورشی هم."
    },
    {
      "id": 2,
      "start": 11413.0,
      "end": 11420.0,
      "formatted_start": "03:10:13.000",
      "formatted_end": "03:10:20.000",
      "text": "یه دوری 600 متر از اون زنه پشتش هم اینو داریم، من خودم نظرم این بود، مثلا اینو من شروع کنم، کم کم بزاریم."
    },
    {
      "id": 3,
      "start": 11420.0,
      "end": 11421.0,
      "formatted_start": "03:10:20.000",
      "formatted_end": "03:10:21.000",
      "text": "اون منطقه درکانه ها داره؟"
    },
    {
      "id": 4,
      "start": 11421.0,
      "end": 11423.0,
      "formatted_start": "03:10:21.000",
      "formatted_end": "03:10:23.000",
      "text": "در اینجا باید بزنید."
    },
    {
      "id": 5,
      "start": 11423.0,
      "end": 11425.0,
      "formatted_start": "03:10:23.000",
      "formatted_end": "03:10:25.000",
      "text": "منطقه پزشکی و جلوتراش هست."
    },
    {
      "id": 6,
      "start": 11425.0,
      "end": 11427.0,
      "formatted_start": "03:10:25.000",
      "formatted_end": "03:10:27.000",
      "text": "جهانی این ها و براتراش."
    },
    {
      "id": 7,
      "start": 11427.0,
      "end": 11429.0,
      "formatted_start": "03:10:27.000",
      "formatted_end": "03:10:29.000",
      "text": "اون روبروش نیست."
    },
    {
      "id": 8,
      "start": 11429.0,
      "end": 11431.0,
      "formatted_start": "03:10:29.000",
      "formatted_end": "03:10:31.000",
      "text": "یا بغیر دستاشون پایین ترش نیست."
    },
    {
      "id": 9,
      "start": 11431.0,
      "end": 11433.0,
      "formatted_start": "03:10:31.000",
      "formatted_end": "03:10:33.000",
      "text": "این ورسط بسیکی هست و این برسط پایین ترش هست."
    },
    {
      "id": 10,
      "start": 11433.0,
      "end": 11435.0,
      "formatted_start": "03:10:33.000",
      "formatted_end": "03:10:35.000",
      "text": "دانش هم دارو خانه."
    },
    {
      "id": 11,
      "start": 11435.0,
      "end": 11437.0,
      "formatted_start": "03:10:35.000",
      "formatted_end": "03:10:37.000",
      "text": "مثلا شروع کنم دو سه سال در اینو"
    },
    {
      "id": 12,
      "start": 11437.0,
      "end": 11439.0,
      "formatted_start": "03:10:37.000",
      "formatted_end": "03:10:39.000",
      "text": "یه ساختمان پزشکانه"
    },
    {
      "id": 13,
      "start": 11439.0,
      "end": 11441.0,
      "formatted_start": "03:10:39.000",
      "formatted_end": "03:10:41.000",
      "text": "چیز درست کنیم."
    },
    {
      "id": 14,
      "start": 11441.0,
      "end": 11443.0,
      "formatted_start": "03:10:41.000",
      "formatted_end": "03:10:43.000",
      "text": "پایینش هم دارو خانه."
    },
    {
      "id": 15,
      "start": 11443.0,
      "end": 11448.0,
      "formatted_start": "03:10:43.000",
      "formatted_end": "03:10:48.000",
      "text": "که دیگه علاقه به چیز نداره مثلا بیاد تو داروخانه با کار داروخانه اینها"
    },
    {
      "id": 16,
      "start": 11448.0,
      "end": 11450.0,
      "formatted_start": "03:10:48.000",
      "formatted_end": "03:10:50.000",
      "text": "اندرشوی هم مثلا شما بیا اینکه یاد"
    },
    {
      "id": 17,
      "start": 11450.0,
      "end": 11452.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:10:52.000",
      "text": "علاقه با تحلیل وقتی یه چیز داره"
    },
    {
      "id": 18,
      "start": 11452.0,
      "end": 11454.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:54.000",
      "text": "مثلا هرکه هر یک کلاشون باددنن"
    },
    {
      "id": 19,
      "start": 11454.0,
      "end": 11455.0,
      "formatted_start": "03:10:54.000",
      "formatted_end": "03:10:55.000",
      "text": "اول همین"
    },
    {
      "id": 20,
      "start": 11455.0,
      "end": 11457.0,
      "formatted_start": "03:10:55.000",
      "formatted_end": "03:10:57.000",
      "text": "شما هم فکر کنم همین بودی"
    },
    {
      "id": 21,
      "start": 11457.0,
      "end": 11460.0,
      "formatted_start": "03:10:57.000",
      "formatted_end": "03:11:00.000",
      "text": "آره من هم به بابا میتونم درخواهیم"
    },
    {
      "id": 22,
      "start": 11460.0,
      "end": 11462.0,
      "formatted_start": "03:11:00.000",
      "formatted_end": "03:11:02.000",
      "text": "کار ما شدیدید از کار ما شدید"
    },
    {
      "id": 23,
      "start": 11462.0,
      "end": 11464.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:04.000",
      "text": "آره اینجوری اینجوری اینجوری اینجوری اینجوری"
    },
    {
      "id": 24,
      "start": 11464.0,
      "end": 11467.0,
      "formatted_start": "03:11:04.000",
      "formatted_end": "03:11:07.000",
      "text": "بارد شد این ۲۰۰ یک ماه، ۲۰ یک ماه، ۶۰ یک ماه"
    },
    {
      "id": 25,
      "start": 11467.0,
      "end": 11470.0,
      "formatted_start": "03:11:07.000",
      "formatted_end": "03:11:10.000",
      "text": "ببخشید، سلام، این چند رازی به فهمش نیچه شد"
    },
    {
      "id": 26,
      "start": 11470.0,
      "end": 11474.0,
      "formatted_start": "03:11:10.000",
      "formatted_end": "03:11:14.000",
      "text": "دیگه میتونی خارج بشید از این فرق"
    },
    {
      "id": 27,
      "start": 11474.0,
      "end": 11478.0,
      "formatted_start": "03:11:14.000",
      "formatted_end": "03:11:18.000",
      "text": "ببین، الان جایی که نتامانجست باید نشد"
    },
    {
      "id": 28,
      "start": 11478.0,
      "end": 11483.0,
      "formatted_start": "03:11:18.000",
      "formatted_end": "03:11:23.000",
      "text": "با این شرایط معبول تره اینا خب"
    },
    {
      "id": 29,
      "start": 11483.0,
      "end": 11486.0,
      "formatted_start": "03:11:23.000",
      "formatted_end": "03:11:26.000",
      "text": "پسشون این چاره ای هم نیست که براشون که براشون"
    },
    {
      "id": 30,
      "start": 11486.0,
      "end": 11488.0,
      "formatted_start": "03:11:26.000",
      "formatted_end": "03:11:28.000",
      "text": "ببخشید، من یک رازی بیم، از اینکه من دو دقیقه"
    },
    {
      "id": 31,
      "start": 11488.0,
      "end": 11493.0,
      "formatted_start": "03:11:28.000",
      "formatted_end": "03:11:33.000",
      "text": "حلو، سلام. یه پنج دقیقه دیگه تماس بگیره یه بروجانسی نیست."
    },
    {
      "id": 32,
      "start": 11493.0,
      "end": 11495.0,
      "formatted_start": "03:11:33.000",
      "formatted_end": "03:11:35.000",
      "text": "مرسی خوب باش. جمعی."
    },
    {
      "id": 33,
      "start": 11495.0,
      "end": 11501.0,
      "formatted_start": "03:11:35.000",
      "formatted_end": "03:11:41.000",
      "text": "من با توجه به فضای هنوان جامعه و نیازی که هنوان فقط دارو کنه میتونن کار درست انجام داد"
    },
    {
      "id": 34,
      "start": 11501.0,
      "end": 11504.0,
      "formatted_start": "03:11:41.000",
      "formatted_end": "03:11:44.000",
      "text": "تا ساختمون و تشکال نکشه نمیتونن برداری کنه."
    },
    {
      "id": 35,
      "start": 11504.0,
      "end": 11505.0,
      "formatted_start": "03:11:44.000",
      "formatted_end": "03:11:45.000",
      "text": "آره، باید بالاش باشید."
    },
    {
      "id": 36,
      "start": 11505.0,
      "end": 11513.0,
      "formatted_start": "03:11:45.000",
      "formatted_end": "03:11:53.000",
      "text": "اگر فضا دارید از همین علاقه از دارو کنه یک فضایی برای درمونه در نظر میگیم"
    },
    {
      "id": 37,
      "start": 11513.0,
      "end": 11521.0,
      "formatted_start": "03:11:53.000",
      "formatted_end": "03:12:01.000",
      "text": "ما فضا داریم، ما مثلا ببینید ما حدود 500 من زمینه، یعنی درسته دهنه اولش حدود 10 من دمیره"
    },
    {
      "id": 38,
      "start": 11521.0,
      "end": 11526.0,
      "formatted_start": "03:12:01.000",
      "formatted_end": "03:12:06.000",
      "text": "اقب زمین ها پشت هستند، خون های پشت ما گرفتیم، ال میشه بزرگ میشه"
    },
    {
      "id": 39,
      "start": 11526.0,
      "end": 11531.0,
      "formatted_start": "03:12:06.000",
      "formatted_end": "03:12:11.000",
      "text": "ما پایین مثلا هم میتونیم درمانگاه یکیلیمیکی سبیه پشت ببینیم"
    },
    {
      "id": 40,
      "start": 11531.0,
      "end": 11534.0,
      "formatted_start": "03:12:11.000",
      "formatted_end": "03:12:14.000",
      "text": "بعد اجاره اینا رو بدی نفروشید"
    },
    {
      "id": 41,
      "start": 11534.0,
      "end": 11538.0,
      "formatted_start": "03:12:14.000",
      "formatted_end": "03:12:18.000",
      "text": "اجاره ایدو خودت متخصص بیاری مثلا مستجدت بشه"
    },
    {
      "id": 42,
      "start": 11538.0,
      "end": 11542.0,
      "formatted_start": "03:12:18.000",
      "formatted_end": "03:12:22.000",
      "text": "بعد بیاد دارو خانه اگر شما از حالا مستجد انتخاب می کردی"
    },
    {
      "id": 43,
      "start": 11542.0,
      "end": 11545.0,
      "formatted_start": "03:12:22.000",
      "formatted_end": "03:12:25.000",
      "text": "مثلا این داشتید بتونستید انتخاب کنید"
    },
    {
      "id": 44,
      "start": 11545.0,
      "end": 11547.0,
      "formatted_start": "03:12:25.000",
      "formatted_end": "03:12:27.000",
      "text": "کیا رسخه زیاد دارن من رسخه"
    },
    {
      "id": 45,
      "start": 11547.0,
      "end": 11550.0,
      "formatted_start": "03:12:27.000",
      "formatted_end": "03:12:30.000",
      "text": "مثلا اجاره نیمیدن اجاره نیمیخواد نیمباها اجاره بده"
    },
    {
      "id": 46,
      "start": 11550.0,
      "end": 11552.0,
      "formatted_start": "03:12:30.000",
      "formatted_end": "03:12:32.000",
      "text": "رسخه دفترسی باید بیاد"
    },
    {
      "id": 47,
      "start": 11552.0,
      "end": 11555.0,
      "formatted_start": "03:12:32.000",
      "formatted_end": "03:12:35.000",
      "text": "خب این فکر تو زنم از بده"
    },
    {
      "id": 48,
      "start": 11555.0,
      "end": 11560.0,
      "formatted_start": "03:12:35.000",
      "formatted_end": "03:12:40.000",
      "text": "خانم هم میگه که اگر مثلا حسام روز نداشته بود امتیاز بگیره"
    },
    {
      "id": 49,
      "start": 11560.0,
      "end": 11563.0,
      "formatted_start": "03:12:40.000",
      "formatted_end": "03:12:43.000",
      "text": "ما خودشون مصروف فنی باشه من میرم"
    },
    {
      "id": 50,
      "start": 11563.0,
      "end": 11567.0,
      "formatted_start": "03:12:43.000",
      "formatted_end": "03:12:47.000",
      "text": "اصلا محسس میشه امتیاز بگیره و مصروف فنی همون عیسی بره"
    },
    {
      "id": 51,
      "start": 11567.0,
      "end": 11569.0,
      "formatted_start": "03:12:47.000",
      "formatted_end": "03:12:49.000",
      "text": "شده که مصروف فنی میدیم اونجا کار کنیم"
    },
    {
      "id": 52,
      "start": 11569.0,
      "end": 11570.0,
      "formatted_start": "03:12:49.000",
      "formatted_end": "03:12:50.000",
      "text": "دو دام هست"
    },
    {
      "id": 53,
      "start": 11570.0,
      "end": 11572.0,
      "formatted_start": "03:12:50.000",
      "formatted_end": "03:12:52.000",
      "text": "در جای مشکلی هر کاری که میخواد بشه"
    },
    {
      "id": 54,
      "start": 11572.0,
      "end": 11575.0,
      "formatted_start": "03:12:52.000",
      "formatted_end": "03:12:55.000",
      "text": "هر کاری که میخواد بشه ما این پولی هم حالا به سات بشم بیدیم بخواد داریم"
    },
    {
      "id": 55,
      "start": 11575.0,
      "end": 11576.0,
      "formatted_start": "03:12:55.000",
      "formatted_end": "03:12:56.000",
      "text": "داریم بخواد بشم"
    },
    {
      "id": 56,
      "start": 11576.0,
      "end": 11578.68,
      "formatted_start": "03:12:56.000",
      "formatted_end": "03:12:58.680",
      "text": "این مثلا نمیخواد بیاد تو دارو خانه مثلا"
    },
    {
      "id": 57,
      "start": 11578.68,
      "end": 11581.32,
      "formatted_start": "03:12:58.680",
      "formatted_end": "03:13:01.320",
      "text": "اینکه اینکه بیاد معاذه دارو کنشی و فراموش"
    },
    {
      "id": 58,
      "start": 11581.32,
      "end": 11583.06,
      "formatted_start": "03:13:01.320",
      "formatted_end": "03:13:03.060",
      "text": "نمیدونه با اینم خودش کلاس هست"
    },
    {
      "id": 59,
      "start": 11583.06,
      "end": 11584.06,
      "formatted_start": "03:13:03.060",
      "formatted_end": "03:13:04.060",
      "text": "اینم تو سینه هست"
    },
    {
      "id": 60,
      "start": 11584.06,
      "end": 11585.06,
      "formatted_start": "03:13:04.060",
      "formatted_end": "03:13:05.060",
      "text": "از این بره باز بر میگردن"
    },
    {
      "id": 61,
      "start": 11585.06,
      "end": 11587.06,
      "formatted_start": "03:13:05.060",
      "formatted_end": "03:13:07.060",
      "text": "میدونم اینم باز سرشون بزن"
    },
    {
      "id": 62,
      "start": 11587.06,
      "end": 11588.06,
      "formatted_start": "03:13:07.060",
      "formatted_end": "03:13:08.060",
      "text": "این هم مهمه"
    },
    {
      "id": 63,
      "start": 11588.06,
      "end": 11593.06,
      "formatted_start": "03:13:08.060",
      "formatted_end": "03:13:13.060",
      "text": "پرستیج و شخصیت اجتماعی که دارو ساز دارو کنه دار داره"
    },
    {
      "id": 64,
      "start": 11593.06,
      "end": 11595.06,
      "formatted_start": "03:13:13.060",
      "formatted_end": "03:13:15.060",
      "text": "دارو سازی توی شرکت دارویی نداره"
    },
    {
      "id": 65,
      "start": 11595.06,
      "end": 11597.06,
      "formatted_start": "03:13:15.060",
      "formatted_end": "03:13:17.060",
      "text": "دارو سازی توی خانه کنه دارویی نداره"
    },
    {
      "id": 66,
      "start": 11597.06,
      "end": 11606.06,
      "formatted_start": "03:13:17.060",
      "formatted_end": "03:13:26.060",
      "text": "این هیچ دارسازی تو هم بشتی تو استاد دانشگاه هم باشی واز اون شخصیت اجتماعی اون اعتباری که دارساز دارو کنه دار داری نداره"
    },
    {
      "id": 67,
      "start": 11606.06,
      "end": 11612.06,
      "formatted_start": "03:13:26.060",
      "formatted_end": "03:13:32.060",
      "text": "دارخانی دکتر سینا رو میشنسی؟ دکترشکیه دکتر سینا مثلا؟"
    },
    {
      "id": 68,
      "start": 11612.06,
      "end": 11619.06,
      "formatted_start": "03:13:32.060",
      "formatted_end": "03:13:39.060",
      "text": "اعتبارم اون اسمه خیلی خیلی تو حالا صد برو من اگر مثلا بهترین دانشمند تو شکل حیاتم میشدم"
    },
    {
      "id": 69,
      "start": 11619.06,
      "end": 11624.06,
      "formatted_start": "03:13:39.060",
      "formatted_end": "03:13:44.060",
      "text": "گمنام؟ گمنام اینکه درست هم اگر که اشکیمون کار داشته باشه حالا ادامه بیدیم"
    },
    {
      "id": 70,
      "start": 11624.06,
      "end": 11628.22,
      "formatted_start": "03:13:44.060",
      "formatted_end": "03:13:48.220",
      "text": "وگرنه اگر نه اعتباریه نه رسمیه نه هیچ چیزی بگیره"
    },
    {
      "id": 71,
      "start": 11628.22,
      "end": 11632.3,
      "formatted_start": "03:13:48.220",
      "formatted_end": "03:13:52.300",
      "text": "نه، بابا تو اجتماع نرکنن"
    },
    {
      "id": 72,
      "start": 11632.3,
      "end": 11635.3,
      "formatted_start": "03:13:52.300",
      "formatted_end": "03:13:55.300",
      "text": "تو اجتماع بیان میخوامن اسم آدم مهمه که بشن"
    },
    {
      "id": 73,
      "start": 11635.3,
      "end": 11639.3,
      "formatted_start": "03:13:55.300",
      "formatted_end": "03:13:59.300",
      "text": "کشتن این درد بگن آقای دکتر رضایی هست"
    },
    {
      "id": 74,
      "start": 11639.3,
      "end": 11641.3,
      "formatted_start": "03:13:59.300",
      "formatted_end": "03:14:01.300",
      "text": "بگم زود به تصویب بخورد"
    },
    {
      "id": 75,
      "start": 11641.3,
      "end": 11642.3,
      "formatted_start": "03:14:01.300",
      "formatted_end": "03:14:02.300",
      "text": "ما تقریب شدن؟"
    },
    {
      "id": 76,
      "start": 11642.3,
      "end": 11647.3,
      "formatted_start": "03:14:02.300",
      "formatted_end": "03:14:07.300",
      "text": "مهمان دکتر بیدن بعضی جماعت درار رو برد باز میدن"
    },
    {
      "id": 77,
      "start": 11647.3,
      "end": 11648.3,
      "formatted_start": "03:14:07.300",
      "formatted_end": "03:14:08.300",
      "text": "این ها فکر میدونن"
    },
    {
      "id": 78,
      "start": 11648.3,
      "end": 11652.3,
      "formatted_start": "03:14:08.300",
      "formatted_end": "03:14:12.300",
      "text": "باید بیان توی جامعه که توی اداره در یک ارگانی برن مثل ترکیز کاری"
    },
    {
      "id": 79,
      "start": 11652.3,
      "end": 11654.3,
      "formatted_start": "03:14:12.300",
      "formatted_end": "03:14:14.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 80,
      "start": 11654.3,
      "end": 11656.3,
      "formatted_start": "03:14:14.300",
      "formatted_end": "03:14:16.300",
      "text": "باید بیان بیان بیان بیان"
    },
    {
      "id": 81,
      "start": 11656.3,
      "end": 11658.3,
      "formatted_start": "03:14:16.300",
      "formatted_end": "03:14:18.300",
      "text": "باید بیان بیان بیان"
    },
    {
      "id": 82,
      "start": 11658.3,
      "end": 11660.3,
      "formatted_start": "03:14:18.300",
      "formatted_end": "03:14:20.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 83,
      "start": 11660.3,
      "end": 11662.3,
      "formatted_start": "03:14:20.300",
      "formatted_end": "03:14:22.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 84,
      "start": 11662.3,
      "end": 11664.3,
      "formatted_start": "03:14:22.300",
      "formatted_end": "03:14:24.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 85,
      "start": 11664.3,
      "end": 11666.3,
      "formatted_start": "03:14:24.300",
      "formatted_end": "03:14:26.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 86,
      "start": 11666.3,
      "end": 11668.3,
      "formatted_start": "03:14:26.300",
      "formatted_end": "03:14:28.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 87,
      "start": 11668.3,
      "end": 11670.3,
      "formatted_start": "03:14:28.300",
      "formatted_end": "03:14:30.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 88,
      "start": 11670.3,
      "end": 11672.3,
      "formatted_start": "03:14:30.300",
      "formatted_end": "03:14:32.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 89,
      "start": 11672.3,
      "end": 11674.3,
      "formatted_start": "03:14:32.300",
      "formatted_end": "03:14:34.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 90,
      "start": 11674.3,
      "end": 11676.3,
      "formatted_start": "03:14:34.300",
      "formatted_end": "03:14:36.300",
      "text": "بسر جنسانی بخوره"
    },
    {
      "id": 91,
      "start": 11676.3,
      "end": 11680.3,
      "formatted_start": "03:14:36.300",
      "formatted_end": "03:14:40.300",
      "text": "اگر حرفشو گوش بدن، بگن آقا ما رو پدر ما بد وقت ده"
    },
    {
      "id": 92,
      "start": 11680.3,
      "end": 11682.3,
      "formatted_start": "03:14:40.300",
      "formatted_end": "03:14:42.300",
      "text": "برو ما زندگاه رو سزید"
    },
    {
      "id": 93,
      "start": 11682.3,
      "end": 11686.3,
      "formatted_start": "03:14:42.300",
      "formatted_end": "03:14:46.300",
      "text": "اگر نگی، بگو پدر ما رو ما رو نسید نکرد"
    },
    {
      "id": 94,
      "start": 11686.3,
      "end": 11689.3,
      "formatted_start": "03:14:46.300",
      "formatted_end": "03:14:49.300",
      "text": "نه روفت، راهی تو رو زرگه خواهی"
    },
    {
      "id": 95,
      "start": 11689.3,
      "end": 11692.3,
      "formatted_start": "03:14:49.300",
      "formatted_end": "03:14:52.300",
      "text": "خداحاشه کانال راهی شروع"
    },
    {
      "id": 96,
      "start": 11692.3,
      "end": 11696.3,
      "formatted_start": "03:14:52.300",
      "formatted_end": "03:14:56.300",
      "text": "بله شروع کرده، ولی اگر از ذره و سرمایه داری کنی"
    },
    {
      "id": 97,
      "start": 11696.3,
      "end": 11699.3,
      "formatted_start": "03:14:56.300",
      "formatted_end": "03:14:59.300",
      "text": "تو سانسوند وزشگاه میبنی، درمونگاه یا..."
    }
  ],
  "status": "completed"
}