  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14130.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:30.000",
      "text": "این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این تقسیم بندی های این"
    },
    {
      "id": 1,
      "start": 14130.0,
      "end": 14140.3,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:40.300",
      "text": "هرمان حسن هم در آثار مختلفش تقسیم بندی یا تقسیم بندی های متعددی"
    },
    {
      "id": 2,
      "start": 14140.3,
      "end": 14145.76,
      "formatted_start": "03:55:40.300",
      "formatted_end": "03:55:45.760",
      "text": "شده باید در یک اصرش یک تقسیم بندی از انسان هست"
    },
    {
      "id": 3,
      "start": 14145.76,
      "end": 14150.54,
      "formatted_start": "03:55:45.760",
      "formatted_end": "03:55:50.540",
      "text": "در یک اصر باید چه تقسیم بندی از انسان هست"
    },
    {
      "id": 4,
      "start": 14150.54,
      "end": 14155.48,
      "formatted_start": "03:55:50.540",
      "formatted_end": "03:55:55.480",
      "text": "در این کتاب به نظر من چهار تقسیم بندی شده"
    },
    {
      "id": 5,
      "start": 14155.48,
      "end": 14161.68,
      "formatted_start": "03:55:55.480",
      "formatted_end": "03:56:01.680",
      "text": "انسانها می کنه که من چهاتون تقسیمتی رو یکی خدمتون رو عرض میکنم"
    },
    {
      "id": 6,
      "start": 14161.68,
      "end": 14163.3,
      "formatted_start": "03:56:01.680",
      "formatted_end": "03:56:03.300",
      "text": "تقسیمتی اول"
    },
    {
      "id": 7,
      "start": 14163.3,
      "end": 14173.76,
      "formatted_start": "03:56:03.300",
      "formatted_end": "03:56:13.760",
      "text": "انسانهایی می شه تقسیم کرد به انسانهایی که فقط در زندگی آملند"
    },
    {
      "id": 8,
      "start": 14173.76,
      "end": 14184.18,
      "formatted_start": "03:56:13.760",
      "formatted_end": "03:56:24.180",
      "text": "و انسانهایی که در زندگی هم آملند و هم نازرند"
    },
    {
      "id": 9,
      "start": 14185.48,
      "end": 14188.96,
      "formatted_start": "03:56:25.480",
      "formatted_end": "03:56:28.960",
      "text": "دو قسم دیگه خب تصور نداره"
    },
    {
      "id": 10,
      "start": 14188.96,
      "end": 14195.02,
      "formatted_start": "03:56:28.960",
      "formatted_end": "03:56:35.020",
      "text": "یعنی این که انسان هایی که در زندگی فقط نازر باشند"
    },
    {
      "id": 11,
      "start": 14195.02,
      "end": 14201.08,
      "formatted_start": "03:56:35.020",
      "formatted_end": "03:56:41.080",
      "text": "و هیچ آمدیتی و فاقیتی نداشته باشند"
    },
    {
      "id": 12,
      "start": 14201.08,
      "end": 14205.46,
      "formatted_start": "03:56:41.080",
      "formatted_end": "03:56:45.460",
      "text": "این مورد نداره"
    },
    {
      "id": 13,
      "start": 14205.46,
      "end": 14210.48,
      "formatted_start": "03:56:45.460",
      "formatted_end": "03:56:50.480",
      "text": "و به تنها مولا و به همین علم قسم چهارم مورد نداره"
    },
    {
      "id": 14,
      "start": 14210.48,
      "end": 14218.64,
      "formatted_start": "03:56:50.480",
      "formatted_end": "03:56:58.640",
      "text": "انسان هایی که ندر زندگی آملیت داشته باشند و نه نازلیت داشته باشند"
    },
    {
      "id": 15,
      "start": 14218.64,
      "end": 14220.86,
      "formatted_start": "03:56:58.640",
      "formatted_end": "03:57:00.860",
      "text": "این هایی برقرار نمیدنند"
    },
    {
      "id": 16,
      "start": 14220.86,
      "end": 14227.4,
      "formatted_start": "03:57:00.860",
      "formatted_end": "03:57:07.400",
      "text": "بنابراین میشه باید به چهاره باید انسان ها در زندگی دو دست تقسیم میشند"
    },
    {
      "id": 17,
      "start": 14227.4,
      "end": 14235.96,
      "formatted_start": "03:57:07.400",
      "formatted_end": "03:57:15.960",
      "text": "انسان هایی که آمدند و انسان هایی که علاقه باید که آمدند نازلند"
    },
    {
      "id": 18,
      "start": 14235.96,
      "end": 14252.96,
      "formatted_start": "03:57:15.960",
      "formatted_end": "03:57:32.960",
      "text": "خب آن بودم که خیلی بازده ایم و در زندگیمون مدام در حال فعالیتی در حال فیده دیم در حال عملیم"
    },
    {
      "id": 19,
      "start": 14252.96,
      "end": 14263.06,
      "formatted_start": "03:57:32.960",
      "formatted_end": "03:57:43.060",
      "text": "و داقه من داریم در صدیگی بود آنند و آنند لحظه به لحظه و ثانیه به ثانیه"
    },
    {
      "id": 20,
      "start": 14263.06,
      "end": 14267.36,
      "formatted_start": "03:57:43.060",
      "formatted_end": "03:57:47.360",
      "text": "خب فعلهایی داریم متکرمشی مهم نیست که"
    },
    {
      "id": 21,
      "start": 14282.96,
      "end": 14292.96,
      "formatted_start": "03:58:02.960",
      "formatted_end": "03:58:12.960",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 14312.96,
      "end": 14324.96,
      "formatted_start": "03:58:32.960",
      "formatted_end": "03:58:44.960",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 14342.96,
      "end": 14362.96,
      "formatted_start": "03:59:02.960",
      "formatted_end": "03:59:22.960",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 14362.96,
      "end": 14392.94,
      "formatted_start": "03:59:22.960",
      "formatted_end": "03:59:52.940",
      "text": "موسیقی در موسیقی درسته"
    }
  ],
