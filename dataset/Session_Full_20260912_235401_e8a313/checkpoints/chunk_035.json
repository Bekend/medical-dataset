  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10522.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:22.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 10530.0,
      "end": 10550.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 10560.0,
      "end": 10565.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:05.000",
      "text": "سلام آیه جمال آبادی"
    },
    {
      "id": 3,
      "start": 10565.0,
      "end": 10567.0,
      "formatted_start": "02:56:05.000",
      "formatted_end": "02:56:07.000",
      "text": "تو بیای خستن ماشین ده"
    },
    {
      "id": 4,
      "start": 10567.0,
      "end": 10569.0,
      "formatted_start": "02:56:07.000",
      "formatted_end": "02:56:09.000",
      "text": "حسینی بای هستم دکتر ممسایق"
    },
    {
      "id": 5,
      "start": 10569.0,
      "end": 10573.0,
      "formatted_start": "02:56:09.000",
      "formatted_end": "02:56:13.000",
      "text": "از اون موضوع این ماشین رنوی مایی پرتابا باد نداره"
    },
    {
      "id": 6,
      "start": 10573.0,
      "end": 10576.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:16.000",
      "text": "یا قطع و بست میشه اینها خوب"
    },
    {
      "id": 7,
      "start": 10576.0,
      "end": 10580.0,
      "formatted_start": "02:56:16.000",
      "formatted_end": "02:56:20.000",
      "text": "گفتم بعد از اون تشریف داریم بیاریم خدمت"
    },
    {
      "id": 8,
      "start": 10580.0,
      "end": 10582.0,
      "formatted_start": "02:56:20.000",
      "formatted_end": "02:56:22.000",
      "text": "چهار و نیمه بعد من میگم فسرم یادی"
    },
    {
      "id": 9,
      "start": 10582.0,
      "end": 10585.0,
      "formatted_start": "02:56:22.000",
      "formatted_end": "02:56:25.000",
      "text": "این آیه جمال آبادی حالا"
    },
    {
      "id": 10,
      "start": 10585.0,
      "end": 10588.0,
      "formatted_start": "02:56:25.000",
      "formatted_end": "02:56:28.000",
      "text": "جامعه این پیشتر از چی میتونه باشی این حالت"
    },
    {
      "id": 11,
      "start": 10588.0,
      "end": 10592.0,
      "formatted_start": "02:56:28.000",
      "formatted_end": "02:56:32.000",
      "text": "فیلتر چی؟ فیلتر هوا"
    },
    {
      "id": 12,
      "start": 10592.0,
      "end": 10594.0,
      "formatted_start": "02:56:32.000",
      "formatted_end": "02:56:34.000",
      "text": "چون اصلا فیلتر هوا رو برداشتیم"
    },
    {
      "id": 13,
      "start": 10594.0,
      "end": 10596.0,
      "formatted_start": "02:56:34.000",
      "formatted_end": "02:56:36.000",
      "text": "حالا خودتون بازیه نگاه کن"
    },
    {
      "id": 14,
      "start": 10596.0,
      "end": 10599.0,
      "formatted_start": "02:56:36.000",
      "formatted_end": "02:56:39.000",
      "text": "باشه حالا میاره پسرم در دمشق"
    },
    {
      "id": 15,
      "start": 10599.0,
      "end": 10602.0,
      "formatted_start": "02:56:39.000",
      "formatted_end": "02:56:42.000",
      "text": "پس تا چند هستیم؟ چهار و نمی تا؟"
    },
    {
      "id": 16,
      "start": 10602.0,
      "end": 10604.0,
      "formatted_start": "02:56:42.000",
      "formatted_end": "02:56:44.000",
      "text": "باشه میاره خیلی مردم"
    },
    {
      "id": 17,
      "start": 10604.0,
      "end": 10606.0,
      "formatted_start": "02:56:44.000",
      "formatted_end": "02:56:46.000",
      "text": "مرسی ممنون خدا باشه"
    },
    {
      "id": 18,
      "start": 10618.0,
      "end": 10646.0,
      "formatted_start": "02:56:58.000",
      "formatted_end": "02:57:26.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 10646.0,
      "end": 10674.0,
      "formatted_start": "02:57:26.000",
      "formatted_end": "02:57:54.000",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 10676.0,
      "end": 10705.98,
      "formatted_start": "02:57:56.000",
      "formatted_end": "02:58:25.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 21,
      "start": 10706.0,
      "end": 10726.0,
      "formatted_start": "02:58:26.000",
      "formatted_end": "02:58:46.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 10726.0,
      "end": 10728.52,
      "formatted_start": "02:58:46.000",
      "formatted_end": "02:58:48.520",
      "text": "بخمید سلام ساشون رو"
    },
    {
      "id": 23,
      "start": 10728.52,
      "end": 10729.84,
      "formatted_start": "02:58:48.520",
      "formatted_end": "02:58:49.840",
      "text": "شرکت ها هستیم؟"
    },
    {
      "id": 24,
      "start": 10729.84,
      "end": 10730.44,
      "formatted_start": "02:58:49.840",
      "formatted_end": "02:58:50.440",
      "text": "بله"
    },
    {
      "id": 25,
      "start": 10730.44,
      "end": 10731.94,
      "formatted_start": "02:58:50.440",
      "formatted_end": "02:58:51.940",
      "text": "بله تشکیل بخشیم خدا"
    },
    {
      "id": 26,
      "start": 10731.94,
      "end": 10732.68,
      "formatted_start": "02:58:51.940",
      "formatted_end": "02:58:52.680",
      "text": "بفهمید"
    },
    {
      "id": 27,
      "start": 10732.68,
      "end": 10733.18,
      "formatted_start": "02:58:52.680",
      "formatted_end": "02:58:53.180",
      "text": "مرسی"
    },
    {
      "id": 28,
      "start": 10733.18,
      "end": 10734.06,
      "formatted_start": "02:58:53.180",
      "formatted_end": "02:58:54.060",
      "text": "که هست؟"
    },
    {
      "id": 29,
      "start": 10734.06,
      "end": 10735.22,
      "formatted_start": "02:58:54.060",
      "formatted_end": "02:58:55.220",
      "text": "تشکیل بله"
    },
    {
      "id": 30,
      "start": 10735.22,
      "end": 10736.42,
      "formatted_start": "02:58:55.220",
      "formatted_end": "02:58:56.420",
      "text": "نسخه کنم؟"
    },
    {
      "id": 31,
      "start": 10736.42,
      "end": 10736.92,
      "formatted_start": "02:58:56.420",
      "formatted_end": "02:58:56.920",
      "text": "بله"
    },
    {
      "id": 32,
      "start": 10738.12,
      "end": 10739.18,
      "formatted_start": "02:58:58.120",
      "formatted_end": "02:58:59.180",
      "text": "قطعه"
    },
    {
      "id": 33,
      "start": 10739.92,
      "end": 10741.56,
      "formatted_start": "02:58:59.920",
      "formatted_end": "02:59:01.560",
      "text": "به این خلوه چی آدم نرشدی؟"
    },
    {
      "id": 34,
      "start": 10741.56,
      "end": 10743.92,
      "formatted_start": "02:59:01.560",
      "formatted_end": "02:59:03.920",
      "text": "نه نه مای موشیم هم رفت پایین"
    },
    {
      "id": 35,
      "start": 10743.92,
      "end": 10746.14,
      "formatted_start": "02:59:03.920",
      "formatted_end": "02:59:06.140",
      "text": "ازا مجیزم هم دیگه جور شد"
    },
    {
      "id": 36,
      "start": 10746.52,
      "end": 10749.06,
      "formatted_start": "02:59:06.520",
      "formatted_end": "02:59:09.060",
      "text": "آره معمول هستید همه میرن"
    },
    {
      "id": 37,
      "start": 10749.06,
      "end": 10749.76,
      "formatted_start": "02:59:09.060",
      "formatted_end": "02:59:09.760",
      "text": "بله"
    },
    {
      "id": 38,
      "start": 10749.76,
      "end": 10750.86,
      "formatted_start": "02:59:09.760",
      "formatted_end": "02:59:10.860",
      "text": "تاریخ هم بسازید"
    },
    {
      "id": 39,
      "start": 10750.86,
      "end": 10751.36,
      "formatted_start": "02:59:10.860",
      "formatted_end": "02:59:11.360",
      "text": "چند"
    },
    {
      "id": 40,
      "start": 10751.84,
      "end": 10752.46,
      "formatted_start": "02:59:11.840",
      "formatted_end": "02:59:12.460",
      "text": "بیشتر ایه"
    },
    {
      "id": 41,
      "start": 10752.46,
      "end": 10753.04,
      "formatted_start": "02:59:12.460",
      "formatted_end": "02:59:13.040",
      "text": "مرسی"
    },
    {
      "id": 42,
      "start": 10753.7,
      "end": 10754.3,
      "formatted_start": "02:59:13.700",
      "formatted_end": "02:59:14.300",
      "text": "خیلی مرسی"
    },
    {
      "id": 43,
      "start": 10754.3,
      "end": 10756.3,
      "formatted_start": "02:59:14.300",
      "formatted_end": "02:59:16.300",
      "text": "مرسی ممنون"
    },
    {
      "id": 44,
      "start": 10756.3,
      "end": 10758.3,
      "formatted_start": "02:59:16.300",
      "formatted_end": "02:59:18.300",
      "text": "این ها چند ها قیمتشون؟"
    },
    {
      "id": 45,
      "start": 10758.3,
      "end": 10760.3,
      "formatted_start": "02:59:18.300",
      "formatted_end": "02:59:20.300",
      "text": "قیمتش فرور 290 داره"
    },
    {
      "id": 46,
      "start": 10760.3,
      "end": 10762.3,
      "formatted_start": "02:59:20.300",
      "formatted_end": "02:59:22.300",
      "text": "بله مرسی"
    },
    {
      "id": 47,
      "start": 10762.3,
      "end": 10764.3,
      "formatted_start": "02:59:22.300",
      "formatted_end": "02:59:24.300",
      "text": "خداحافظ"
    },
    {
      "id": 48,
      "start": 10784.3,
      "end": 10799.3,
      "formatted_start": "02:59:44.300",
      "formatted_end": "02:59:59.300",
      "text": "موسیقی"
    }
  ],
