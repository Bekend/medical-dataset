  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8124.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:24.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 8124.0,
      "end": 8126.72,
      "formatted_start": "02:15:24.000",
      "formatted_end": "02:15:26.720",
      "text": "حالا با سلام سلام خوبی خسته نباشید"
    },
    {
      "id": 2,
      "start": 8126.72,
      "end": 8127.92,
      "formatted_start": "02:15:26.720",
      "formatted_end": "02:15:27.920",
      "text": "از خواهی می کنم"
    },
    {
      "id": 3,
      "start": 8127.92,
      "end": 8131.28,
      "formatted_start": "02:15:27.920",
      "formatted_end": "02:15:31.280",
      "text": "خیلی رو به صحبتی که آقای راینی و اینا با شما داشتن اینا"
    },
    {
      "id": 4,
      "start": 8131.28,
      "end": 8133.68,
      "formatted_start": "02:15:31.280",
      "formatted_end": "02:15:33.680",
      "text": "من خوب تب خود منم صحبت کنم"
    },
    {
      "id": 5,
      "start": 8133.68,
      "end": 8141.36,
      "formatted_start": "02:15:33.680",
      "formatted_end": "02:15:41.360",
      "text": "خوب اینو"
    },
    {
      "id": 6,
      "start": 8141.36,
      "end": 8146.88,
      "formatted_start": "02:15:41.360",
      "formatted_end": "02:15:46.880",
      "text": "یعنی اینشی"
    },
    {
      "id": 7,
      "start": 8146.88,
      "end": 8148.88,
      "formatted_start": "02:15:46.880",
      "formatted_end": "02:15:48.880",
      "text": "آه"
    },
    {
      "id": 8,
      "start": 8161.88,
      "end": 8163.88,
      "formatted_start": "02:16:01.880",
      "formatted_end": "02:16:03.880",
      "text": "جلسه مجموع برگذار بشه؟"
    },
    {
      "id": 9,
      "start": 8165.88,
      "end": 8169.88,
      "formatted_start": "02:16:05.880",
      "formatted_end": "02:16:09.880",
      "text": "خب اون برای چی؟ من نمیدونم این رنبال چی هست"
    },
    {
      "id": 10,
      "start": 8169.88,
      "end": 8177.58,
      "formatted_start": "02:16:09.880",
      "formatted_end": "02:16:17.580",
      "text": "خب ایشون ببین"
    },
    {
      "id": 11,
      "start": 8177.58,
      "end": 8183.54,
      "formatted_start": "02:16:17.580",
      "formatted_end": "02:16:23.540",
      "text": "خب آره دیگه نفر دوم سر رو میذاریم"
    },
    {
      "id": 12,
      "start": 8189.54,
      "end": 8191.4,
      "formatted_start": "02:16:29.540",
      "formatted_end": "02:16:31.400",
      "text": "ما اون بازدشت شده"
    },
    {
      "id": 13,
      "start": 8191.4,
      "end": 8194.36,
      "formatted_start": "02:16:31.400",
      "formatted_end": "02:16:34.360",
      "text": "ببین ما نمیتونیم به هرکی به هرکی زنگ بزنه"
    },
    {
      "id": 14,
      "start": 8194.36,
      "end": 8197.78,
      "formatted_start": "02:16:34.360",
      "formatted_end": "02:16:37.780",
      "text": "خب ما تالا که با شما مشارت میکردیم"
    },
    {
      "id": 15,
      "start": 8197.78,
      "end": 8199.78,
      "formatted_start": "02:16:37.780",
      "formatted_end": "02:16:39.780",
      "text": "خب، الان یه مرتبه"
    },
    {
      "id": 16,
      "start": 8207.78,
      "end": 8209.78,
      "formatted_start": "02:16:47.780",
      "formatted_end": "02:16:49.780",
      "text": "خب"
    },
    {
      "id": 17,
      "start": 8210.78,
      "end": 8213.78,
      "formatted_start": "02:16:50.780",
      "formatted_end": "02:16:53.780",
      "text": "خب، شما شمالشو میتونید برمونیدید؟"
    },
    {
      "id": 18,
      "start": 8214.78,
      "end": 8218.78,
      "formatted_start": "02:16:54.780",
      "formatted_end": "02:16:58.780",
      "text": "خب، خب، ببینید الان ما بخوایم اینجوری عمل کنیم"
    },
    {
      "id": 19,
      "start": 8218.78,
      "end": 8221.78,
      "formatted_start": "02:16:58.780",
      "formatted_end": "02:17:01.780",
      "text": "چه مشکلی موجود میاد که ما"
    },
    {
      "id": 20,
      "start": 8221.78,
      "end": 8231.78,
      "formatted_start": "02:17:01.780",
      "formatted_end": "02:17:11.780",
      "text": "خب ما ببینیم ما مساوبر رو الان ما بگیم آقا بازرس آقای دکتر جهانی درسته؟"
    },
    {
      "id": 21,
      "start": 8231.78,
      "end": 8240.28,
      "formatted_start": "02:17:11.780",
      "formatted_end": "02:17:20.280",
      "text": "خیلی خوب بعد ایشون میاد استفاده میده خب الان بدلش که دکتر سالدیر میاد جایگزین میشه"
    },
    {
      "id": 22,
      "start": 8240.28,
      "end": 8244.78,
      "formatted_start": "02:17:20.280",
      "formatted_end": "02:17:24.780",
      "text": "خب اینجا چه مشکله؟"
    },
    {
      "id": 23,
      "start": 8244.78,
      "end": 8248.66,
      "formatted_start": "02:17:24.780",
      "formatted_end": "02:17:28.660",
      "text": "درسته"
    },
    {
      "id": 24,
      "start": 8248.66,
      "end": 8255.94,
      "formatted_start": "02:17:28.660",
      "formatted_end": "02:17:35.940",
      "text": "خب این دوتا یکیشون استفاده ده"
    },
    {
      "id": 25,
      "start": 8255.94,
      "end": 8257.34,
      "formatted_start": "02:17:35.940",
      "formatted_end": "02:17:37.340",
      "text": "بعد چی کار باید کنیم"
    },
    {
      "id": 26,
      "start": 8257.34,
      "end": 8259.12,
      "formatted_start": "02:17:37.340",
      "formatted_end": "02:17:39.120",
      "text": "اصلا فرض کن استفاده ده"
    },
    {
      "id": 27,
      "start": 8259.12,
      "end": 8261.02,
      "formatted_start": "02:17:39.120",
      "formatted_end": "02:17:41.020",
      "text": "ببین اصلا یه واضرسی"
    },
    {
      "id": 28,
      "start": 8261.02,
      "end": 8263.96,
      "formatted_start": "02:17:41.020",
      "formatted_end": "02:17:43.960",
      "text": "یه واضرسی یک بار استفاده ده"
    },
    {
      "id": 29,
      "start": 8263.96,
      "end": 8266.34,
      "formatted_start": "02:17:43.960",
      "formatted_end": "02:17:46.340",
      "text": "خب استفاده ده دیگه"
    },
    {
      "id": 30,
      "start": 8266.34,
      "end": 8268.76,
      "formatted_start": "02:17:46.340",
      "formatted_end": "02:17:48.760",
      "text": "خب"
    },
    {
      "id": 31,
      "start": 8268.76,
      "end": 8272.36,
      "formatted_start": "02:17:48.760",
      "formatted_end": "02:17:52.360",
      "text": "ببین اگر واضرس استفاده ده"
    },
    {
      "id": 32,
      "start": 8272.36,
      "end": 8273.44,
      "formatted_start": "02:17:52.360",
      "formatted_end": "02:17:53.440",
      "text": "در حالت عادی"
    },
    {
      "id": 33,
      "start": 8273.44,
      "end": 8276.66,
      "formatted_start": "02:17:53.440",
      "formatted_end": "02:17:56.660",
      "text": "آیا علال بدر میشه جایی بزین"
    },
    {
      "id": 34,
      "start": 8276.66,
      "end": 8281.9,
      "formatted_start": "02:17:56.660",
      "formatted_end": "02:18:01.900",
      "text": "خب"
    },
    {
      "id": 35,
      "start": 8281.9,
      "end": 8284.9,
      "formatted_start": "02:18:01.900",
      "formatted_end": "02:18:04.900",
      "text": "بعده"
    },
    {
      "id": 36,
      "start": 8284.9,
      "end": 8295.86,
      "formatted_start": "02:18:04.900",
      "formatted_end": "02:18:15.860",
      "text": "با تجین افتادمی گسمت شد"
    },
    {
      "id": 37,
      "start": 8295.86,
      "end": 8303.86,
      "formatted_start": "02:18:15.860",
      "formatted_end": "02:18:23.860",
      "text": "موسیقی"
    },
    {
      "id": 38,
      "start": 8303.86,
      "end": 8312.86,
      "formatted_start": "02:18:23.860",
      "formatted_end": "02:18:32.860",
      "text": "خب ما الان همین فرمت که توی حیات مجمع اتفاق بودنده رو ما می نویسیم جهانی و با سالی درسته؟"
    },
    {
      "id": 39,
      "start": 8312.86,
      "end": 8316.86,
      "formatted_start": "02:18:32.860",
      "formatted_end": "02:18:36.860",
      "text": "موسیقی"
    },
    {
      "id": 40,
      "start": 8316.86,
      "end": 8323.86,
      "formatted_start": "02:18:36.860",
      "formatted_end": "02:18:43.860",
      "text": "خب پس ما چیکار؟ ما یعنی برای بازرست باید دوباره جلسه مجمع تشکیل بدیم"
    },
    {
      "id": 41,
      "start": 8323.86,
      "end": 8339.86,
      "formatted_start": "02:18:43.860",
      "formatted_end": "02:18:59.860",
      "text": "نه، قلش که نمیشه اقتال کرده، این دیگه اون نشوده داره اقتال میکنه"
    },
    {
      "id": 42,
      "start": 8339.86,
      "end": 8341.86,
      "formatted_start": "02:18:59.860",
      "formatted_end": "02:19:01.860",
      "text": "برم"
    },
    {
      "id": 43,
      "start": 8341.86,
      "end": 8343.86,
      "formatted_start": "02:19:01.860",
      "formatted_end": "02:19:03.860",
      "text": "برم"
    },
    {
      "id": 44,
      "start": 8343.86,
      "end": 8345.86,
      "formatted_start": "02:19:03.860",
      "formatted_end": "02:19:05.860",
      "text": "برم"
    },
    {
      "id": 45,
      "start": 8345.86,
      "end": 8347.86,
      "formatted_start": "02:19:05.860",
      "formatted_end": "02:19:07.860",
      "text": "نه حتیشون امنینه"
    },
    {
      "id": 46,
      "start": 8347.86,
      "end": 8349.86,
      "formatted_start": "02:19:07.860",
      "formatted_end": "02:19:09.860",
      "text": "نه روش نمیشه"
    },
    {
      "id": 47,
      "start": 8349.86,
