    {
      "id": 9,
      "start": 11065.0,
      "end": 11073.0,
      "formatted_start": "03:04:25.000",
      "formatted_end": "03:04:33.000",
      "text": "بله بفهمید؟ سبب بفهمید خواهش می کنید"
    },
    {
      "id": 10,
      "start": 11073.0,
      "end": 11082.0,
      "formatted_start": "03:04:33.000",
      "formatted_end": "03:04:42.000",
      "text": "به نامه؟ خانم یوسف صاحب تا ساعت یک پیشتر بیستیم بعد از دورم پنج تا هفت"
    },
    {
      "id": 11,
      "start": 11082.0,
      "end": 11089.0,
      "formatted_start": "03:04:42.000",
      "formatted_end": "03:04:49.000",
      "text": "الان هستیم ولی قبل یک باید اینجا خودتونو برسیم"
    },
    {
      "id": 12,
      "start": 11089.0,
      "end": 11093.0,
      "formatted_start": "03:04:49.000",
      "formatted_end": "03:04:53.000",
      "text": "نه نه بیاریم پس سریع تر بیاریم"
    },
    {
      "id": 13,
      "start": 11093.0,
      "end": 11095.0,
      "formatted_start": "03:04:53.000",
      "formatted_end": "03:04:55.000",
      "text": "از یک رد نشد خدافز"
    },
    {
      "id": 14,
      "start": 11095.0,
      "end": 11100.0,
      "formatted_start": "03:04:55.000",
      "formatted_end": "03:05:00.000",
      "text": "سلامتو ساده"
    }
