  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11102.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:02.000",
      "text": "خوبستی؟ خوبست نیست؟ خوبست نیست؟ خوبست نیست؟"
    },
    {
      "id": 1,
      "start": 11102.0,
      "end": 11104.0,
      "formatted_start": "03:05:02.000",
      "formatted_end": "03:05:04.000",
      "text": "خوبست نیست؟ خوبست نیست؟ خوبست نیست؟"
    },
    {
      "id": 2,
      "start": 11104.0,
      "end": 11108.0,
      "formatted_start": "03:05:04.000",
      "formatted_end": "03:05:08.000",
      "text": "خامسامیر رفته، سونگرافی، مریضا رو این وقتی جمع کرده."
    },
    {
      "id": 3,
      "start": 11108.0,
      "end": 11110.0,
      "formatted_start": "03:05:08.000",
      "formatted_end": "03:05:10.000",
      "text": "چه خواست؟ خوشحال مددشت ماشایی گرفت."
    },
    {
      "id": 4,
      "start": 11110.0,
      "end": 11112.0,
      "formatted_start": "03:05:10.000",
      "formatted_end": "03:05:12.000",
      "text": "خوشحال ماشایی خوبه؟ خوشحال ماشایی خوبه؟ خوشحال ماشایی خوبه؟"
    },
    {
      "id": 5,
      "start": 11112.0,
      "end": 11115.5,
      "formatted_start": "03:05:12.000",
      "formatted_end": "03:05:15.500",
      "text": "اینجور شاید خانم سمیت هم از که باید فلاچیم و دکتور روز خیلی گیران شده"
    },
    {
      "id": 6,
      "start": 11115.5,
      "end": 11116.0,
      "formatted_start": "03:05:15.500",
      "formatted_end": "03:05:16.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 11116.0,
      "end": 11120.0,
      "formatted_start": "03:05:16.000",
      "formatted_end": "03:05:20.000",
      "text": "قبل این صحبت باشید اینکه سوال تکرار می کنیم"
    },
    {
      "id": 8,
      "start": 11120.0,
      "end": 11125.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:25.000",
      "text": "من خیلی همون رو دوباره بگم که خانم سمیت را اید که نصف آره سرما خوردگی کدکان"
    },
    {
      "id": 9,
      "start": 11125.0,
      "end": 11127.0,
      "formatted_start": "03:05:25.000",
      "formatted_end": "03:05:27.000",
      "text": "به نیمی سه دو عدد صبت کنه"
    },
    {
      "id": 10,
      "start": 11127.0,
      "end": 11127.5,
      "formatted_start": "03:05:27.000",
      "formatted_end": "03:05:27.500",
      "text": "آره"
    },
    {
      "id": 11,
      "start": 11127.5,
      "end": 11129.0,
      "formatted_start": "03:05:27.500",
      "formatted_end": "03:05:29.000",
      "text": "فلاچیم را سهشت می خواستی صدا خورده ای"
    },
    {
      "id": 12,
      "start": 11129.0,
      "end": 11130.0,
      "formatted_start": "03:05:29.000",
      "formatted_end": "03:05:30.000",
      "text": "آه خیلی آنی بود"
    },
    {
      "id": 13,
      "start": 11130.0,
      "end": 11132.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:32.000",
      "text": "بهترین بهترین کار همینه"
    },
    {
      "id": 14,
      "start": 11132.0,
      "end": 11136.16,
      "formatted_start": "03:05:32.000",
      "formatted_end": "03:05:36.160",
      "text": "اون رو شما خانم سمیت چون اینجوری که قاعد هست میگی پیزانشون آزاد میشه"
    },
    {
      "id": 15,
      "start": 11136.16,
      "end": 11139.62,
      "formatted_start": "03:05:36.160",
      "formatted_end": "03:05:39.620",
      "text": "نه نه باید یه دونه سرما خوردگی میزنیم"
    },
    {
      "id": 16,
      "start": 11139.62,
      "end": 11141.24,
      "formatted_start": "03:05:39.620",
      "formatted_end": "03:05:41.240",
      "text": "یه دونه سرما خوردگی میزنیم"
    },
    {
      "id": 17,
      "start": 11141.24,
      "end": 11142.1,
      "formatted_start": "03:05:41.240",
      "formatted_end": "03:05:42.100",
      "text": "اشکال نداره؟"
    },
    {
      "id": 18,
      "start": 11142.1,
      "end": 11146.0,
      "formatted_start": "03:05:42.100",
      "formatted_end": "03:05:46.000",
      "text": "این رو که در سختر ناهیدی ما همه چیزی میخواییم تیچی کنم"
    },
    {
      "id": 19,
      "start": 11146.0,
      "end": 11147.32,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:47.320",
      "text": "کل هم میگنن همه چیز ندارن"
    },
    {
      "id": 20,
      "start": 11147.32,
      "end": 11151.18,
      "formatted_start": "03:05:47.320",
      "formatted_end": "03:05:51.180",
      "text": "آفرین داروار در اینجوری همه رو از چیز برگردیم"
    },
    {
      "id": 21,
      "start": 11151.18,
      "end": 11151.56,
      "formatted_start": "03:05:51.180",
      "formatted_end": "03:05:51.560",
      "text": "همین"
    },
    {
      "id": 22,
      "start": 11151.56,
      "end": 11151.92,
      "formatted_start": "03:05:51.560",
      "formatted_end": "03:05:51.920",
      "text": "همین"
    },
    {
      "id": 23,
      "start": 11151.92,
      "end": 11152.0,
      "formatted_start": "03:05:51.920",
      "formatted_end": "03:05:52.000",
      "text": "همین"
    },
    {
      "id": 24,
      "start": 11152.0,
      "end": 11152.06,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:05:52.060",
      "text": "همین"
    },
    {
      "id": 25,
      "start": 11152.06,
      "end": 11152.1,
      "formatted_start": "03:05:52.060",
      "formatted_end": "03:05:52.100",
      "text": "همین"
    },
    {
      "id": 26,
      "start": 11152.1,
      "end": 11161.1,
      "formatted_start": "03:05:52.100",
      "formatted_end": "03:06:01.100",
      "text": "اما کارکیلی که شما صد می کنید در اصل همه درگونه ها آزاد می زنند ولی شما چون استامیلافرون صد می کنید بارکیل ۹۰۰۰ تومنی رو ما ۲۰ تومن حساب می کنیم"
    },
    {
      "id": 27,
      "start": 11161.1,
      "end": 11166.1,
      "formatted_start": "03:06:01.100",
      "formatted_end": "03:06:06.100",
      "text": "از استامیلافرون هم کمتر حساب می کنیم چون قیمت استامیلافرون کامل ازش حضر می کنیم"
    },
    {
      "id": 28,
      "start": 11166.1,
      "end": 11171.1,
      "formatted_start": "03:06:06.100",
      "formatted_end": "03:06:11.100",
      "text": "این کار را مجبورم انجام بدیم یعنی بگیرن و خوب بذارین واسه توی نصف آزار بگیرن"
    },
    {
      "id": 29,
      "start": 11171.1,
      "end": 11175.1,
      "formatted_start": "03:06:11.100",
      "formatted_end": "03:06:15.100",
      "text": "مثلا مریض میگه آقا پلارجین خوبه"
    },
    {
      "id": 30,
      "start": 11175.1,
      "end": 11177.1,
      "formatted_start": "03:06:15.100",
      "formatted_end": "03:06:17.100",
      "text": "باید جیب رو مریض خواهده"
    },
    {
      "id": 31,
      "start": 11177.1,
      "end": 11179.1,
      "formatted_start": "03:06:17.100",
      "formatted_end": "03:06:19.100",
      "text": "چون چهار ساعت دورتون هم نیمتی"
    },
    {
      "id": 32,
      "start": 11179.1,
      "end": 11181.1,
      "formatted_start": "03:06:19.100",
      "formatted_end": "03:06:21.100",
      "text": "مریض نداره تا بروستاش برد"
    },
    {
      "id": 33,
      "start": 11181.1,
      "end": 11184.1,
      "formatted_start": "03:06:21.100",
      "formatted_end": "03:06:24.100",
      "text": "من برای همین گفتم آقا من ندارم"
    },
    {
      "id": 34,
      "start": 11184.1,
      "end": 11186.1,
      "formatted_start": "03:06:24.100",
      "formatted_end": "03:06:26.100",
      "text": "بفتم شیست ست تومن، هشت ست تومن"
    },
    {
      "id": 35,
      "start": 11186.1,
      "end": 11188.1,
      "formatted_start": "03:06:26.100",
      "formatted_end": "03:06:28.100",
      "text": "دیدم که چهار ست و ده تومن پلارجین بود"
    },
    {
      "id": 36,
      "start": 11188.1,
      "end": 11190.1,
      "formatted_start": "03:06:28.100",
      "formatted_end": "03:06:30.100",
      "text": "سنگین از شیست ست تومن اینه"
    },
    {
      "id": 37,
      "start": 11190.1,
      "end": 11192.1,
      "formatted_start": "03:06:30.100",
      "formatted_end": "03:06:32.100",
      "text": "ببنیم برویدونه ساده شدی"
    },
    {
      "id": 38,
      "start": 11192.1,
      "end": 11194.1,
      "formatted_start": "03:06:32.100",
      "formatted_end": "03:06:34.100",
      "text": "خونه درست گفت"
    },
    {
      "id": 39,
      "start": 11194.1,
      "end": 11196.1,
      "formatted_start": "03:06:34.100",
      "formatted_end": "03:06:36.100",
      "text": "ولی همین اگه مثلا دو شهرات اصلا"
    },
    {
      "id": 40,
      "start": 11196.1,
      "end": 11198.1,
      "formatted_start": "03:06:36.100",
      "formatted_end": "03:06:38.100",
      "text": "از شهر را سرما خوردیدی ست کانه"
    },
    {
      "id": 41,
      "start": 11198.1,
      "end": 11199.1,
      "formatted_start": "03:06:38.100",
      "formatted_end": "03:06:39.100",
      "text": "مورد ندارید"
    },
    {
      "id": 42,
      "start": 11199.1,
      "end": 11200.1,
      "formatted_start": "03:06:39.100",
      "formatted_end": "03:06:40.100",
      "text": "یکی از هزار تانه ازش کم میشه"
    },
    {
      "id": 43,
      "start": 11200.1,
      "end": 11201.1,
      "formatted_start": "03:06:40.100",
      "formatted_end": "03:06:41.100",
      "text": "ششکر ندارید"
    },
    {
      "id": 44,
      "start": 11201.1,
      "end": 11202.1,
      "formatted_start": "03:06:41.100",
      "formatted_end": "03:06:42.100",
      "text": "اصلا ما دو تانه میبینیم"
    },
    {
      "id": 45,
      "start": 11202.1,
      "end": 11203.1,
      "formatted_start": "03:06:42.100",
      "formatted_end": "03:06:43.100",
      "text": "هیچ موردی نداریم"
    },
    {
      "id": 46,
      "start": 11203.1,
      "end": 11204.1,
      "formatted_start": "03:06:43.100",
      "formatted_end": "03:06:44.100",
      "text": "ما شهر را دیگه ها میگویم"
    },
    {
      "id": 47,
      "start": 11204.1,
      "end": 11206.1,
      "formatted_start": "03:06:44.100",
      "formatted_end": "03:06:46.100",
      "text": "دو تانه یک تانه بلارجین مبلغش را میادیم پایین"
    },
    {
      "id": 48,
      "start": 11206.1,
      "end": 11209.1,
      "formatted_start": "03:06:46.100",
      "formatted_end": "03:06:49.100",
      "text": "تنها رای که میشه برند بازی بیمارکی جواب هم بگیر"
    },
    {
      "id": 49,
      "start": 11209.1,
      "end": 11210.1,
      "formatted_start": "03:06:49.100",
      "formatted_end": "03:06:50.100",
      "text": "هزینه هم مده"
    },
    {
      "id": 50,
      "start": 11210.1,
      "end": 11211.1,
      "formatted_start": "03:06:50.100",
      "formatted_end": "03:06:51.100",
      "text": "چیه میدونی؟"
    },
    {
      "id": 51,
      "start": 11211.1,
      "end": 11212.1,
      "formatted_start": "03:06:51.100",
      "formatted_end": "03:06:52.100",
      "text": "اون طرف"
    },
    {
      "id": 52,
      "start": 11212.1,
      "end": 11217.34,
      "formatted_start": "03:06:52.100",
      "formatted_end": "03:06:57.340",
      "text": "چون استفاده می کنید، پاراکیتی آزاد هست، استامینوفن هم چون بسیاری نازده بود"
    },
    {
      "id": 53,
      "start": 11217.34,
      "end": 11220.7,
      "formatted_start": "03:06:57.340",
      "formatted_end": "03:07:00.700",
      "text": "بنابراین ما یک قام بیمی هستیم و حساب می کنیم 20 رو خوردیم"
    },
    {
      "id": 54,
      "start": 11220.7,
      "end": 11225.3,
      "formatted_start": "03:07:00.700",
      "formatted_end": "03:07:05.300",
      "text": "اینه همه ما صرف ما خوردیدید، یک دونه می زنیم و حتی درم 400 رو باید اینجا می دهیم"
    },
    {
      "id": 55,
      "start": 11225.3,
      "end": 11228.1,
      "formatted_start": "03:07:05.300",
      "formatted_end": "03:07:08.100",
      "text": "اون رو درست می کنیم ما، این سراخوردی باید صرف نکردیم"
    },
    {
      "id": 56,
      "start": 11228.1,
      "end": 11230.34,
      "formatted_start": "03:07:08.100",
      "formatted_end": "03:07:10.340",
      "text": "بله، این رو ما توی سیستم در چیز کردیم"
    },
    {
      "id": 57,
      "start": 11230.34,
      "end": 11232.84,
      "formatted_start": "03:07:10.340",
      "formatted_end": "03:07:12.840",
      "text": "حالا خیلی هم آگه من چشم ها میگن دوتا بزنیم"
    },
    {
      "id": 58,
      "start": 11232.84,
      "end": 11237.58,
      "formatted_start": "03:07:12.840",
      "formatted_end": "03:07:17.580",
      "text": "دوتا میگن دوتا چون ادده سنگیمترش خیلی پایین ترگی اختباسی داریست"
    },
    {
      "id": 59,
      "start": 11237.58,
      "end": 11240.34,
      "formatted_start": "03:07:17.580",
      "formatted_end": "03:07:20.340",
      "text": "دکتر ببین حدد از خواهیم کنم خودتون بینه"
    },
    {
      "id": 60,
      "start": 11240.34,
      "end": 11241.98,
      "formatted_start": "03:07:20.340",
      "formatted_end": "03:07:21.980",
      "text": "وضع اقتصاد مدرن خوب نیست"
    },
    {
      "id": 61,
      "start": 11241.98,
      "end": 11247.04,
      "formatted_start": "03:07:21.980",
      "formatted_end": "03:07:27.040",
      "text": "الان خالی بودن مدتبه ها به خاطر همین بیرون درمانبا و بیداری"
    },
    {
      "id": 62,
      "start": 11247.04,
      "end": 11251.08,
      "formatted_start": "03:07:27.040",
      "formatted_end": "03:07:31.080",
      "text": "وقتی مدتبه من کم باشه دروخانه کم ازماشگاه کم اطار کنیم"
    },
    {
      "id": 63,
      "start": 11251.08,
      "end": 11255.38,
      "formatted_start": "03:07:31.080",
      "formatted_end": "03:07:35.380",
      "text": "ما باید برخواب یک برنامه بیدیم که اعتقاد بخاطر همین نایده ما داریم"
    },
    {
      "id": 64,
      "start": 11255.38,
      "end": 11257.84,
      "formatted_start": "03:07:35.380",
      "formatted_end": "03:07:37.840",
      "text": "این هم میرزید تو جیو بیمک و میخواد یک سال دیگه فول بده"
    },
    {
      "id": 65,
      "start": 11257.84,
      "end": 11259.64,
      "formatted_start": "03:07:37.840",
      "formatted_end": "03:07:39.640",
      "text": "ولی ما میگیم مریض رو نگه هده داریم"
    },
    {
      "id": 66,
      "start": 11259.64,
      "end": 11261.44,
      "formatted_start": "03:07:39.640",
      "formatted_end": "03:07:41.440",
      "text": "مریض بتونه هده هده داروش تحیه کنه"
    },
    {
      "id": 67,
      "start": 11261.44,
      "end": 11264.9,
      "formatted_start": "03:07:41.440",
      "formatted_end": "03:07:44.900",
      "text": "مریض بتونه بخش خصوصی زنده بیمونه"
    },
    {
      "id": 68,
      "start": 11264.9,
      "end": 11266.2,
      "formatted_start": "03:07:44.900",
      "formatted_end": "03:07:46.200",
      "text": "بگنه بخش خصوصی"
    },
    {
      "id": 69,
      "start": 11266.2,
      "end": 11269.88,
      "formatted_start": "03:07:46.200",
      "formatted_end": "03:07:49.880",
      "text": "قدر از 3-4 سال آینده فاتش خونده"
    },
    {
      "id": 70,
      "start": 11269.88,
      "end": 11272.88,
      "formatted_start": "03:07:49.880",
      "formatted_end": "03:07:52.880",
      "text": "مایی بعضی که این رو گرفتم باید میدونم با آخر امسال برسه"
    },
    {
      "id": 71,
      "start": 11272.88,
      "end": 11273.88,
      "formatted_start": "03:07:52.880",
      "formatted_end": "03:07:53.880",
      "text": "اما کلا همه کنیم"
    },
    {
      "id": 72,
      "start": 11273.88,
      "end": 11277.88,
      "formatted_start": "03:07:53.880",
      "formatted_end": "03:07:57.880",
      "text": "نه، همینطور که میتونم بیانم. مرمون واقعا یکی همون نیست."
    },
    {
      "id": 73,
      "start": 11277.88,
      "end": 11281.88,
      "formatted_start": "03:07:57.880",
      "formatted_end": "03:08:01.880",
      "text": "دکتور سعید از گرگان میاد، دو ساعت مریض میبینه میده."
    },
    {
      "id": 74,
      "start": 11281.88,
      "end": 11285.88,
      "formatted_start": "03:08:01.880",
      "formatted_end": "03:08:05.880",
      "text": "دیگه مرد زیرنده دکتوری رفیان هم مثل قدیم نیست."
    },
    {
      "id": 75,
      "start": 11285.88,
      "end": 11291.88,
      "formatted_start": "03:08:05.880",
      "formatted_end": "03:08:11.880",
      "text": "برای دکتور رقم، اصلا کلی کارهای دیگه انجام میده که مریض جمع کنه و برون بازم مثل قدیم."
    },
    {
      "id": 76,
      "start": 11291.88,
      "end": 11294.88,
      "formatted_start": "03:08:11.880",
      "formatted_end": "03:08:14.880",
      "text": "هفته و دفته در فرنشت هم مریض داشت. الان به سی تا به سی تا به سی تا به سی تا به سی تا."
    },
    {
      "id": 77,
      "start": 11294.88,
      "end": 11301.88,
      "formatted_start": "03:08:14.880",
      "formatted_end": "03:08:21.880",
      "text": "ما دیروز 23 تا داشتیم، 15 تا صبح داشتیم، 8 تا بعد از زور داشتیم، شنبه 23 تا"
    },
    {
      "id": 78,
      "start": 11301.88,
      "end": 11331.88,
      "formatted_start": "03:08:21.880",
      "formatted_end": "03:08:51.880",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 79,
      "start": 11331.88,
      "end": 11335.12,
      "formatted_start": "03:08:51.880",
      "formatted_end": "03:08:55.120",
      "text": "دارو خانه بزنه یا باید بره روسته آینا؟"
    },
    {
      "id": 80,
      "start": 11335.12,
      "end": 11339.76,
      "formatted_start": "03:08:55.120",
      "formatted_end": "03:08:59.760",
      "text": "دو راه داره، الان آینامی جدید کم سخت گرفتن این قضایش رو"
    },
    {
      "id": 81,
      "start": 11339.76,
      "end": 11344.28,
      "formatted_start": "03:08:59.760",
      "formatted_end": "03:09:04.280",
      "text": "امتیاز پایی بزنشن، اما سرشون باید امتیاز پایی بگیرن و فیلن و اینها"
    },
    {
      "id": 82,
      "start": 11344.28,
      "end": 11348.92,
      "formatted_start": "03:09:04.280",
      "formatted_end": "03:09:08.920",
      "text": "ولی امتیاز پایی بره واسه کسی که میخواد بره درخواست دارو کنه"
    },
    {
      "id": 83,
      "start": 11348.92,
      "end": 11351.52,
      "formatted_start": "03:09:08.920",
      "formatted_end": "03:09:11.520",
      "text": "شما میتونید برید پروانه دارو کنن رو بخورید"
    },
    {
      "id": 84,
      "start": 11351.52,
      "end": 11353.52,
      "formatted_start": "03:09:11.520",
      "formatted_end": "03:09:13.520",
      "text": "آه پروانه، چقدر از پروانه؟"
    },
    {
      "id": 85,
      "start": 11353.52,
      "end": 11354.52,
      "formatted_start": "03:09:13.520",
      "formatted_end": "03:09:14.520",
      "text": "دیگه..."
    },
    {
      "id": 86,
      "start": 11354.52,
      "end": 11357.04,
      "formatted_start": "03:09:14.520",
      "formatted_end": "03:09:17.040",
      "text": "بست خدا هیچ قیمتی نداره"
    },
    {
      "id": 87,
      "start": 11357.04,
      "end": 11357.84,
      "formatted_start": "03:09:17.040",
      "formatted_end": "03:09:17.840",
      "text": "همکی ایشه"
    },
    {
      "id": 88,
      "start": 11357.84,
      "end": 11358.34,
      "formatted_start": "03:09:17.840",
      "formatted_end": "03:09:18.340",
      "text": "هرکی"
    },
    {
      "id": 89,
      "start": 11358.34,
      "end": 11360.38,
      "formatted_start": "03:09:18.340",
      "formatted_end": "03:09:20.380",
      "text": "مثلا در طور مثال بگم"
    },
    {
      "id": 90,
      "start": 11360.38,
      "end": 11362.4,
      "formatted_start": "03:09:20.380",
      "formatted_end": "03:09:22.400",
      "text": "داروپن محرم خانی"
    },
    {
      "id": 91,
      "start": 11362.4,
      "end": 11363.46,
      "formatted_start": "03:09:22.400",
      "formatted_end": "03:09:23.460",
      "text": "یه قیمتی"
    },
    {
      "id": 92,
      "start": 11363.46,
      "end": 11365.34,
      "formatted_start": "03:09:23.460",
      "formatted_end": "03:09:25.340",
      "text": "بسیار یه قیمتی"
    },
    {
      "id": 93,
      "start": 11365.34,
      "end": 11365.64,
      "formatted_start": "03:09:25.340",
      "formatted_end": "03:09:25.640",
      "text": "چرا؟"
    },
    {
      "id": 94,
      "start": 11365.64,
      "end": 11366.92,
      "formatted_start": "03:09:25.640",
      "formatted_end": "03:09:26.920",
      "text": "از موقعیتش"
    },
    {
      "id": 95,
      "start": 11366.92,
      "end": 11368.8,
      "formatted_start": "03:09:26.920",
      "formatted_end": "03:09:28.800",
      "text": "اگر محرم خانی رو بخده"
    },
    {
      "id": 96,
      "start": 11368.8,
      "end": 11370.06,
      "formatted_start": "03:09:28.800",
      "formatted_end": "03:09:30.060",
      "text": "میتونی جاش عوض کنی"
    },
    {
      "id": 97,
      "start": 11370.06,
      "end": 11371.04,
      "formatted_start": "03:09:30.060",
      "formatted_end": "03:09:31.040",
      "text": "میتونی جاش عوض کنی"
    },
    {
      "id": 98,
      "start": 11371.04,
      "end": 11371.56,
      "formatted_start": "03:09:31.040",
      "formatted_end": "03:09:31.560",
      "text": "میتونی جاش عوض کنی"
    },
    {
      "id": 99,
      "start": 11371.56,
      "end": 11373.62,
      "formatted_start": "03:09:31.560",
      "formatted_end": "03:09:33.620",
      "text": "یه داروپن زیف"
    },
    {
      "id": 100,
      "start": 11373.62,
      "end": 11374.96,
      "formatted_start": "03:09:33.620",
      "formatted_end": "03:09:34.960",
      "text": "بخده پردانشو"
    },
    {
      "id": 101,
      "start": 11374.96,
      "end": 11377.0,
      "formatted_start": "03:09:34.960",
      "formatted_end": "03:09:37.000",
      "text": "بعد باید یه جایی درخواست"
    },
    {
      "id": 102,
      "start": 11377.0,
      "end": 11377.9,
      "formatted_start": "03:09:37.000",
      "formatted_end": "03:09:37.900",
      "text": "هرگینا هم نمیتونه"
    },
    {
      "id": 103,
      "start": 11377.9,
      "end": 11380.56,
      "formatted_start": "03:09:37.900",
      "formatted_end": "03:09:40.560",
      "text": "شما می‌گو می‌گیرد ملکو معرفی می‌کنید به دانشگاه"
    },
    {
      "id": 104,
      "start": 11380.56,
      "end": 11382.56,
