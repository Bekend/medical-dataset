  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7507.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:07.000",
      "text": "اون قطعه همون طرح میشه، شیر پشت، اون همون قطعه، گرفتن با دستگاه همونه."
    },
    {
      "id": 1,
      "start": 7507.0,
      "end": 7510.0,
      "formatted_start": "02:05:07.000",
      "formatted_end": "02:05:10.000",
      "text": "خب دیگه بسره چیز رسید؟"
    },
    {
      "id": 2,
      "start": 7510.0,
      "end": 7514.0,
      "formatted_start": "02:05:10.000",
      "formatted_end": "02:05:14.000",
      "text": "دیگه دستگاه بگیرید، آزمایش ادرار بیرون، ما ببینیم چی هسته."
    },
    {
      "id": 3,
      "start": 7514.0,
      "end": 7524.0,
      "formatted_start": "02:05:14.000",
      "formatted_end": "02:05:24.000",
      "text": "باید بگیرید خیلی باید بیمارسان برم ببینیم آزمایش ادرار میدهید"
    },
    {
      "id": 4,
      "start": 7524.0,
      "end": 7530.0,
      "formatted_start": "02:05:24.000",
      "formatted_end": "02:05:30.000",
      "text": "بخونید"
    },
    {
      "id": 5,
      "start": 7530.0,
      "end": 7558.0,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:58.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 7560.0,
      "end": 7562.0,
      "formatted_start": "02:06:00.000",
      "formatted_end": "02:06:02.000",
      "text": "های سازه پولی چیز رو درده"
    },
    {
      "id": 7,
      "start": 7562.0,
      "end": 7564.0,
      "formatted_start": "02:06:02.000",
      "formatted_end": "02:06:04.000",
      "text": "اینجور کرده"
    },
    {
      "id": 8,
      "start": 7564.0,
      "end": 7566.0,
      "formatted_start": "02:06:04.000",
      "formatted_end": "02:06:06.000",
      "text": "چنین اینجور کرده"
    },
    {
      "id": 9,
      "start": 7566.0,
      "end": 7568.0,
      "formatted_start": "02:06:06.000",
      "formatted_end": "02:06:08.000",
      "text": "چنین اینجور کرده"
    },
    {
      "id": 10,
      "start": 7568.0,
      "end": 7570.0,
      "formatted_start": "02:06:08.000",
      "formatted_end": "02:06:10.000",
      "text": "برش کرده و مکه رو"
    },
    {
      "id": 11,
      "start": 7570.0,
      "end": 7572.0,
      "formatted_start": "02:06:10.000",
      "formatted_end": "02:06:12.000",
      "text": "بندر پس تیزی نیست که کم"
    },
    {
      "id": 12,
      "start": 7576.0,
      "end": 7578.0,
      "formatted_start": "02:06:16.000",
      "formatted_end": "02:06:18.000",
      "text": "آرومی"
    },
    {
      "id": 13,
      "start": 7584.0,
      "end": 7586.0,
      "formatted_start": "02:06:24.000",
      "formatted_end": "02:06:26.000",
      "text": "بی خردش گروه بشه"
    },
    {
      "id": 14,
      "start": 7586.0,
      "end": 7588.0,
      "formatted_start": "02:06:26.000",
      "formatted_end": "02:06:28.000",
      "text": "پیشتر بیشتر"
    },
    {
      "id": 15,
      "start": 7588.0,
      "end": 7590.0,
      "formatted_start": "02:06:28.000",
      "formatted_end": "02:06:30.000",
      "text": "باید برداریم"
    },
    {
      "id": 16,
      "start": 7590.0,
      "end": 7592.0,
      "formatted_start": "02:06:30.000",
      "formatted_end": "02:06:32.000",
      "text": "باید برداریم"
    },
    {
      "id": 17,
      "start": 7592.0,
      "end": 7594.0,
      "formatted_start": "02:06:32.000",
      "formatted_end": "02:06:34.000",
      "text": "باید برداریم"
    },
    {
      "id": 18,
      "start": 7594.0,
      "end": 7596.0,
      "formatted_start": "02:06:34.000",
      "formatted_end": "02:06:36.000",
      "text": "باید برداریم"
    },
    {
      "id": 19,
      "start": 7596.0,
      "end": 7598.0,
      "formatted_start": "02:06:36.000",
      "formatted_end": "02:06:38.000",
      "text": "باید برداریم"
    },
    {
      "id": 20,
      "start": 7598.0,
      "end": 7600.0,
      "formatted_start": "02:06:38.000",
      "formatted_end": "02:06:40.000",
      "text": "باید برداریم"
    },
    {
      "id": 21,
      "start": 7600.0,
      "end": 7602.0,
      "formatted_start": "02:06:40.000",
      "formatted_end": "02:06:42.000",
      "text": "باید برداریم"
    },
    {
      "id": 22,
      "start": 7602.0,
      "end": 7604.0,
      "formatted_start": "02:06:42.000",
      "formatted_end": "02:06:44.000",
      "text": "باید برداریم"
    },
    {
      "id": 23,
      "start": 7604.0,
      "end": 7606.0,
      "formatted_start": "02:06:44.000",
      "formatted_end": "02:06:46.000",
      "text": "باید برداریم"
    },
    {
      "id": 24,
      "start": 7606.0,
      "end": 7608.0,
      "formatted_start": "02:06:46.000",
      "formatted_end": "02:06:48.000",
      "text": "باید برداریم"
    },
    {
      "id": 25,
      "start": 7608.0,
      "end": 7610.0,
      "formatted_start": "02:06:48.000",
      "formatted_end": "02:06:50.000",
      "text": "باید برداریم"
    },
    {
      "id": 26,
      "start": 7610.0,
      "end": 7612.0,
      "formatted_start": "02:06:50.000",
      "formatted_end": "02:06:52.000",
      "text": "باید برداریم"
    },
    {
      "id": 27,
      "start": 7612.0,
      "end": 7614.0,
      "formatted_start": "02:06:52.000",
      "formatted_end": "02:06:54.000",
      "text": "باید برداریم"
    },
    {
      "id": 28,
      "start": 7614.0,
      "end": 7616.0,
      "formatted_start": "02:06:54.000",
      "formatted_end": "02:06:56.000",
      "text": "باید برداریم"
    },
    {
      "id": 29,
      "start": 7616.0,
      "end": 7618.0,
      "formatted_start": "02:06:56.000",
      "formatted_end": "02:06:58.000",
      "text": "اینجا برای صدای شما گرفت"
    },
    {
      "id": 30,
      "start": 7618.0,
      "end": 7620.0,
      "formatted_start": "02:06:58.000",
      "formatted_end": "02:07:00.000",
      "text": "اینجا برای صدای شما گرفت"
    },
    {
      "id": 31,
      "start": 7620.0,
      "end": 7622.0,
      "formatted_start": "02:07:00.000",
      "formatted_end": "02:07:02.000",
      "text": "برای صدای شما گرفت"
    },
    {
      "id": 32,
      "start": 7622.0,
      "end": 7624.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:04.000",
      "text": "شروع می کنیم"
    },
    {
      "id": 33,
      "start": 7624.0,
      "end": 7626.0,
      "formatted_start": "02:07:04.000",
      "formatted_end": "02:07:06.000",
      "text": "نه یه قدر سپسید"
    },
    {
      "id": 34,
      "start": 7626.0,
      "end": 7628.0,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:08.000",
      "text": "شیر مادر می کنه"
    },
    {
      "id": 35,
      "start": 7628.0,
      "end": 7630.0,
      "formatted_start": "02:07:08.000",
      "formatted_end": "02:07:10.000",
      "text": "بقیه شیر می کنه و آیترینی می کنه"
    },
    {
      "id": 36,
      "start": 7630.0,
      "end": 7632.0,
      "formatted_start": "02:07:10.000",
      "formatted_end": "02:07:12.000",
      "text": "این رو همه جایید"
    },
    {
      "id": 37,
      "start": 7632.0,
      "end": 7634.0,
      "formatted_start": "02:07:12.000",
      "formatted_end": "02:07:14.000",
      "text": "این پاها رو می توی طرف تکن می کنید"
    },
    {
      "id": 38,
      "start": 7634.0,
      "end": 7636.0,
      "formatted_start": "02:07:14.000",
      "formatted_end": "02:07:16.000",
      "text": "دستان رو هم تکنید"
    },
    {
      "id": 39,
      "start": 7638.0,
      "end": 7640.0,
      "formatted_start": "02:07:18.000",
      "formatted_end": "02:07:20.000",
      "text": "این نفس داره کلیتی داره"
    },
    {
      "id": 40,
      "start": 7640.0,
      "end": 7642.0,
      "formatted_start": "02:07:20.000",
      "formatted_end": "02:07:22.000",
      "text": "داره چیزی هم روش دادیم"
    },
    {
      "id": 41,
      "start": 7642.0,
      "end": 7644.0,
      "formatted_start": "02:07:22.000",
      "formatted_end": "02:07:24.000",
      "text": "این افغان سرار"
    },
    {
      "id": 42,
      "start": 7644.0,
      "end": 7647.5,
      "formatted_start": "02:07:24.000",
      "formatted_end": "02:07:27.500",
      "text": "او باید شبه رو بهش میرن و اون برنامه میشه"
    },
    {
      "id": 43,
      "start": 7647.5,
      "end": 7650.0,
      "formatted_start": "02:07:27.500",
      "formatted_end": "02:07:30.000",
      "text": "و اون رو بیده و از درم نمی کنه"
    },
    {
      "id": 44,
      "start": 7654.0,
      "end": 7655.5,
      "formatted_start": "02:07:34.000",
      "formatted_end": "02:07:35.500",
      "text": "بیستش میشه؟"
    },
    {
      "id": 45,
      "start": 7655.5,
      "end": 7656.5,
      "formatted_start": "02:07:35.500",
      "formatted_end": "02:07:36.500",
      "text": "نه"
    },
    {
      "id": 46,
      "start": 7658.5,
      "end": 7661.0,
      "formatted_start": "02:07:38.500",
      "formatted_end": "02:07:41.000",
      "text": "در همون حالتی که من گستن بیمت داریم"
    },
    {
      "id": 47,
      "start": 7661.5,
      "end": 7663.5,
      "formatted_start": "02:07:41.500",
      "formatted_end": "02:07:43.500",
      "text": "باید بگیریم"
    },
    {
      "id": 48,
      "start": 7665.0,
      "end": 7666.5,
      "formatted_start": "02:07:45.000",
      "formatted_end": "02:07:46.500",
      "text": "خانم صادق لوب"
    },
    {
      "id": 49,
      "start": 7666.5,
      "end": 7668.0,
      "formatted_start": "02:07:46.500",
      "formatted_end": "02:07:48.000",
      "text": "به همین حالت باید بگیرید"
    },
    {
      "id": 50,
      "start": 7668.0,
      "end": 7671.5,
      "formatted_start": "02:07:48.000",
      "formatted_end": "02:07:51.500",
      "text": "این یکی خودتون از ازره عساوی آرام باشید"
    },
    {
      "id": 51,
      "start": 7671.5,
      "end": 7673.0,
      "formatted_start": "02:07:51.500",
      "formatted_end": "02:07:53.000",
      "text": "استراف نداشته باشید"
    },
    {
      "id": 52,
      "start": 7673.0,
      "end": 7675.0,
      "formatted_start": "02:07:53.000",
      "formatted_end": "02:07:55.000",
      "text": "غذای نصباخ نخورید"
    },
    {
      "id": 53,
      "start": 7675.0,
      "end": 7677.0,
      "formatted_start": "02:07:55.000",
      "formatted_end": "02:07:57.000",
      "text": "مثل بوبوبا"
    },
    {
      "id": 54,
      "start": 7677.0,
      "end": 7679.0,
      "formatted_start": "02:07:57.000",
      "formatted_end": "02:07:59.000",
      "text": "حتی آبیده"
    },
    {
      "id": 55,
      "start": 7679.0,
      "end": 7681.0,
      "formatted_start": "02:07:59.000",
      "formatted_end": "02:08:01.000",
      "text": "لبنیات گابی"
    },
    {
      "id": 56,
      "start": 7681.0,
      "end": 7683.0,
      "formatted_start": "02:08:01.000",
      "formatted_end": "02:08:03.000",
      "text": "بیش و شیر، ماز، پنید، کش"
    },
    {
      "id": 57,
      "start": 7683.0,
      "end": 7685.0,
      "formatted_start": "02:08:03.000",
      "formatted_end": "02:08:05.000",
      "text": "گوشفند اشکال نده"
    },
    {
      "id": 58,
      "start": 7685.0,
      "end": 7687.0,
      "formatted_start": "02:08:05.000",
      "formatted_end": "02:08:07.000",
      "text": "بادمجان و خیار"
    },
    {
      "id": 59,
      "start": 7687.0,
      "end": 7689.0,
      "formatted_start": "02:08:07.000",
      "formatted_end": "02:08:09.000",
      "text": "نه رو اصلا استفاده نیمیده"
    },
    {
      "id": 60,
      "start": 7689.0,
      "end": 7691.0,
      "formatted_start": "02:08:09.000",
      "formatted_end": "02:08:11.000",
      "text": "نه میخورم این آده"
    },
    {
      "id": 61,
      "start": 7691.0,
      "end": 7693.0,
      "formatted_start": "02:08:11.000",
      "formatted_end": "02:08:13.000",
      "text": "که نه رو مزداد"
    },
    {
      "id": 62,
      "start": 7693.0,
      "end": 7695.0,
      "formatted_start": "02:08:13.000",
      "formatted_end": "02:08:15.000",
      "text": "که میخورم"
    },
    {
      "id": 63,
      "start": 7695.0,
      "end": 7697.0,
      "formatted_start": "02:08:15.000",
      "formatted_end": "02:08:17.000",
      "text": "میخوره که لبنیات دیگه"
    },
    {
      "id": 64,
      "start": 7697.0,
      "end": 7699.0,
      "formatted_start": "02:08:17.000",
      "formatted_end": "02:08:19.000",
      "text": "نه بشکر کنیم زیاد چیزا میخورید"
    },
    {
      "id": 65,
      "start": 7699.0,
      "end": 7701.0,
      "formatted_start": "02:08:19.000",
      "formatted_end": "02:08:21.000",
      "text": "مثلا برمه سرتی"
    },
    {
      "id": 66,
      "start": 7701.0,
      "end": 7705.0,
      "formatted_start": "02:08:21.000",
      "formatted_end": "02:08:25.000",
      "text": "یا آشه رشته اینها آبش رو میخوند"
    },
    {
      "id": 67,
      "start": 7705.0,
      "end": 7706.0,
      "formatted_start": "02:08:25.000",
      "formatted_end": "02:08:26.000",
      "text": "نه نه"
    },
    {
      "id": 68,
      "start": 7706.0,
      "end": 7708.0,
      "formatted_start": "02:08:26.000",
      "formatted_end": "02:08:28.000",
      "text": "اولا کنار گذاشت باید برنج خالی میخوند"
    },
    {
      "id": 69,
      "start": 7708.0,
      "end": 7710.0,
      "formatted_start": "02:08:28.000",
      "formatted_end": "02:08:30.000",
      "text": "یک گوشت مثلا پخته خالی میخوند"
    },
    {
      "id": 70,
      "start": 7710.0,
      "end": 7714.0,
      "formatted_start": "02:08:30.000",
      "formatted_end": "02:08:34.000",
      "text": "خوب رایت میکنه اما من اعتماد دادم از همون کره رو"
    },
    {
      "id": 71,
      "start": 7714.0,
      "end": 7715.0,
      "formatted_start": "02:08:34.000",
      "formatted_end": "02:08:35.000",
      "text": "آره کره ها سنگینه"
    },
    {
      "id": 72,
      "start": 7715.0,
      "end": 7716.0,
      "formatted_start": "02:08:35.000",
      "formatted_end": "02:08:36.000",
      "text": "کره رو هستیم"
    },
    {
      "id": 73,
      "start": 7716.0,
      "end": 7718.0,
      "formatted_start": "02:08:36.000",
      "formatted_end": "02:08:38.000",
      "text": "نه نه اون رو نخورم"
    },
    {
      "id": 74,
      "start": 7718.0,
      "end": 7720.0,
      "formatted_start": "02:08:38.000",
      "formatted_end": "02:08:40.000",
      "text": "آره من دیگرون هم بخوریم تفصیل میذارم"
    },
    {
      "id": 75,
      "start": 7720.0,
      "end": 7722.0,
      "formatted_start": "02:08:40.000",
      "formatted_end": "02:08:42.000",
      "text": "چهره های ساعت هستیم"
    },
    {
      "id": 76,
      "start": 7722.0,
      "end": 7724.0,
      "formatted_start": "02:08:42.000",
      "formatted_end": "02:08:44.000",
      "text": "شما لبنی هایی هست کن"
    },
    {
      "id": 77,
      "start": 7724.0,
      "end": 7726.0,
      "formatted_start": "02:08:44.000",
      "formatted_end": "02:08:46.000",
      "text": "هم هست کن"
    },
    {
      "id": 78,
      "start": 7726.0,
      "end": 7728.0,
      "formatted_start": "02:08:46.000",
      "formatted_end": "02:08:48.000",
      "text": "بوبوبات هم هست کن"
    },
    {
      "id": 79,
      "start": 7728.0,
      "end": 7730.0,
      "formatted_start": "02:08:48.000",
      "formatted_end": "02:08:50.000",
      "text": "نه نخوریم"
    },
    {
      "id": 80,
      "start": 7730.0,
      "end": 7732.0,
      "formatted_start": "02:08:50.000",
      "formatted_end": "02:08:52.000",
      "text": "ازت بوبوبات دیگه"
    },
    {
      "id": 81,
      "start": 7732.0,
      "end": 7734.0,
      "formatted_start": "02:08:52.000",
      "formatted_end": "02:08:54.000",
      "text": "بوبوبات مخون"
    },
    {
      "id": 82,
      "start": 7734.0,
      "end": 7736.0,
      "formatted_start": "02:08:54.000",
      "formatted_end": "02:08:56.000",
      "text": "رویا مار"
    },
    {
      "id": 83,
      "start": 7736.0,
      "end": 7738.0,
      "formatted_start": "02:08:56.000",
      "formatted_end": "02:08:58.000",
      "text": "ازت لپه"
    },
    {
      "id": 84,
      "start": 7738.0,
      "end": 7740.0,
      "formatted_start": "02:08:58.000",
      "formatted_end": "02:09:00.000",
      "text": "اینها همه"
    },
    {
      "id": 85,
      "start": 7740.0,
      "end": 7742.0,
      "formatted_start": "02:09:00.000",
      "formatted_end": "02:09:02.000",
      "text": "حتی آبشون میگن خیس کن و بخورش کار نداره"
    },
    {
      "id": 86,
      "start": 7742.0,
      "end": 7744.0,
      "formatted_start": "02:09:02.000",
      "formatted_end": "02:09:04.000",
      "text": "خیس هم کنی درست"
    },
    {
      "id": 87,
      "start": 7744.0,
      "end": 7751.5,
      "formatted_start": "02:09:04.000",
      "formatted_end": "02:09:11.500",
      "text": "از یکی میزنید. هیچ تصویب نداره. شاید چند ماه. بعض از بچه ها سه ماه بعض از بچه ها شیش ماه."
    },
    {
      "id": 88,
      "start": 7751.5,
      "end": 7760.0,
      "formatted_start": "02:09:11.500",
      "formatted_end": "02:09:20.000",
      "text": "یکی نگفتن. نه. یکی که نگفتن. نفت گوش کن خواهیم. دو چیزی گفتن نخور. لبنی ها و حبوبات."
    },
    {
      "id": 89,
      "start": 7760.0,
      "end": 7768.0,
      "formatted_start": "02:09:20.000",
      "formatted_end": "02:09:28.000",
      "text": "توی لبنی ها تا گوش نخور گوسترندی بخور. سببترین. یه میبینم حبوبات. شما حبوبات رو باید اینجور نخورید شرح خواهی میدونید."
    },
    {
      "id": 90,
      "start": 7768.0,
      "end": 7772.0,
      "formatted_start": "02:09:28.000",
      "formatted_end": "02:09:32.000",
      "text": "گوشت هست، میوه هست، خضایی این هست، خضایی دیگه هم هست"
    },
    {
      "id": 91,
      "start": 7772.0,
      "end": 7777.0,
      "formatted_start": "02:09:32.000",
      "formatted_end": "02:09:37.000",
      "text": "شما خدا انتخاب کن، از دست بخور، خود بخور، یه بیا بخور، بیا بچه منفجر میشه"
    },
    {
      "id": 92,
      "start": 7777.0,
      "end": 7780.0,
      "formatted_start": "02:09:37.000",
      "formatted_end": "02:09:40.000",
      "text": "یا کره بخور، شیر، کمیر، گاوی بخور، هزیر"
    },
    {
      "id": 93,
      "start": 7780.0,
      "end": 7781.0,
      "formatted_start": "02:09:40.000",
      "formatted_end": "02:09:41.000",
      "text": "کشمش نمیشه؟"
    },
    {
      "id": 94,
      "start": 7781.0,
      "end": 7783.0,
      "formatted_start": "02:09:41.000",
      "formatted_end": "02:09:43.000",
      "text": "کشمش نمیشه، دیگه کشمش نمیشه"
    },
    {
      "id": 95,
      "start": 7783.0,
      "end": 7784.0,
      "formatted_start": "02:09:43.000",
      "formatted_end": "02:09:44.000",
      "text": "پقمانه ها؟"
    },
    {
      "id": 96,
      "start": 7784.0,
      "end": 7786.0,
      "formatted_start": "02:09:44.000",
      "formatted_end": "02:09:46.000",
      "text": "نه دیگه، پقمانه ها میتونی بخور"
    },
    {
      "id": 97,
      "start": 7786.0,
      "end": 7792.0,
      "formatted_start": "02:09:46.000",
      "formatted_end": "02:09:52.000",
      "text": "فقط دو تا مهم داره، دو تا اگر با خود جایت نکنین، خب"
    },
    {
      "id": 98,
      "start": 7792.0,
