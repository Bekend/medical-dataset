  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6929.98,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6940.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6960.0,
      "end": 6965.0,
      "formatted_start": "01:56:00.000",
      "formatted_end": "01:56:05.000",
      "text": "الان سلام آیل ایمی جان خوبین؟"
    },
    {
      "id": 3,
      "start": 6965.0,
      "end": 6969.0,
      "formatted_start": "01:56:05.000",
      "formatted_end": "01:56:09.000",
      "text": "باستان میگفت من موبایل تو ماشین بود میکانیکی رفته بودم"
    },
    {
      "id": 4,
      "start": 6969.0,
      "end": 6972.0,
      "formatted_start": "01:56:09.000",
      "formatted_end": "01:56:12.000",
      "text": "چه خبر؟"
    },
    {
      "id": 5,
      "start": 6972.0,
      "end": 6977.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:17.000",
      "text": "با درمورد امو مجمع"
    },
    {
      "id": 6,
      "start": 6977.0,
      "end": 6981.0,
      "formatted_start": "01:56:17.000",
      "formatted_end": "01:56:21.000",
      "text": "از چند نظر؟"
    },
    {
      "id": 7,
      "start": 6981.0,
      "end": 6985.0,
      "formatted_start": "01:56:21.000",
      "formatted_end": "01:56:25.000",
      "text": "چطور؟"
    },
    {
      "id": 8,
      "start": 6985.0,
      "end": 7014.98,
      "formatted_start": "01:56:25.000",
      "formatted_end": "01:56:54.980",
      "text": "باید برداری کنید."
    },
    {
      "id": 9,
      "start": 7015.0,
      "end": 7017.0,
      "formatted_start": "01:56:55.000",
      "formatted_end": "01:56:57.000",
      "text": "او بردارید."
    },
    {
      "id": 10,
      "start": 7017.0,
      "end": 7019.0,
      "formatted_start": "01:56:57.000",
      "formatted_end": "01:56:59.000",
      "text": "او بردارید."
    },
    {
      "id": 11,
      "start": 7019.0,
      "end": 7021.0,
      "formatted_start": "01:56:59.000",
      "formatted_end": "01:57:01.000",
      "text": "او بردارید."
    },
    {
      "id": 12,
      "start": 7021.0,
      "end": 7023.0,
      "formatted_start": "01:57:01.000",
      "formatted_end": "01:57:03.000",
      "text": "او بردارید."
    },
    {
      "id": 13,
      "start": 7023.0,
      "end": 7025.0,
      "formatted_start": "01:57:03.000",
      "formatted_end": "01:57:05.000",
      "text": "او بردارید."
    },
    {
      "id": 14,
      "start": 7025.0,
      "end": 7027.0,
      "formatted_start": "01:57:05.000",
      "formatted_end": "01:57:07.000",
      "text": "او بردارید."
    },
    {
      "id": 15,
      "start": 7027.0,
      "end": 7029.0,
      "formatted_start": "01:57:07.000",
      "formatted_end": "01:57:09.000",
      "text": "او بردارید."
    },
    {
      "id": 16,
      "start": 7029.0,
      "end": 7031.0,
      "formatted_start": "01:57:09.000",
      "formatted_end": "01:57:11.000",
      "text": "او بردارید."
    },
    {
      "id": 17,
      "start": 7031.0,
      "end": 7033.0,
      "formatted_start": "01:57:11.000",
      "formatted_end": "01:57:13.000",
      "text": "او بردارید."
    },
    {
      "id": 18,
      "start": 7033.0,
      "end": 7035.0,
      "formatted_start": "01:57:13.000",
      "formatted_end": "01:57:15.000",
      "text": "او بردارید."
    },
    {
      "id": 19,
      "start": 7035.0,
      "end": 7037.0,
      "formatted_start": "01:57:15.000",
      "formatted_end": "01:57:17.000",
      "text": "او بردارید."
    },
    {
      "id": 20,
      "start": 7037.0,
      "end": 7039.0,
      "formatted_start": "01:57:17.000",
      "formatted_end": "01:57:19.000",
      "text": "او بردارید."
    },
    {
      "id": 21,
      "start": 7039.0,
      "end": 7041.0,
      "formatted_start": "01:57:19.000",
      "formatted_end": "01:57:21.000",
      "text": "او بردارید."
    },
    {
      "id": 22,
      "start": 7041.0,
      "end": 7043.0,
      "formatted_start": "01:57:21.000",
      "formatted_end": "01:57:23.000",
      "text": "او بردارید."
    },
    {
      "id": 23,
      "start": 7043.0,
      "end": 7061.0,
      "formatted_start": "01:57:23.000",
      "formatted_end": "01:57:41.000",
      "text": "ببینید گفتن که فردن باید همین فرمت بره جلو درسته؟"
    },
    {
      "id": 24,
      "start": 7061.0,
      "end": 7066.0,
      "formatted_start": "01:57:41.000",
      "formatted_end": "01:57:46.000",
      "text": "یعنی بازرس مسعود جانی و بعدش همین که دومیش هم سالی"
    },
    {
      "id": 25,
      "start": 7066.0,
      "end": 7071.0,
      "formatted_start": "01:57:46.000",
      "formatted_end": "01:57:51.000",
      "text": "بعد که توی روزنامه چی شد؟ مسعود جانی استفاده میگه درسته؟"
    },
    {
      "id": 26,
      "start": 7071.0,
      "end": 7075.0,
      "formatted_start": "01:57:51.000",
      "formatted_end": "01:57:55.000",
      "text": "درسته؟ خب بعد بازدهس که میشه؟ سالی دیگه"
    },
    {
      "id": 27,
      "start": 7083.0,
      "end": 7084.0,
      "formatted_start": "01:58:03.000",
      "formatted_end": "01:58:04.000",
      "text": "اون کابونی که؟"
    },
    {
      "id": 28,
      "start": 7085.0,
      "end": 7088.0,
      "formatted_start": "01:58:05.000",
      "formatted_end": "01:58:08.000",
      "text": "تولد مدد میاد دیگه، خیلی چیز نیست"
    },
    {
      "id": 29,
      "start": 7101.0,
      "end": 7114.0,
      "formatted_start": "01:58:21.000",
      "formatted_end": "01:58:34.000",
      "text": "نه فقط بازرسته خب بازرست دیگه نیسته دیگه الان دیگه"
    },
    {
      "id": 30,
      "start": 7114.0,
      "end": 7121.0,
      "formatted_start": "01:58:34.000",
      "formatted_end": "01:58:41.000",
      "text": "خب اونجوری باشه شما مسجد جانی رو از بازرستی در بیادیم"
    },
    {
      "id": 31,
      "start": 7121.74,
      "end": 7125.0,
      "formatted_start": "01:58:41.740",
      "formatted_end": "01:58:45.000",
      "text": "خب دکتر سالی و اون دومیش کنداری رو بزنیم"
    },
    {
      "id": 32,
      "start": 7125.0,
      "end": 7155.0,
      "formatted_start": "01:58:45.000",
      "formatted_end": "01:59:15.000",
      "text": "بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگیرم بگی"
    },
    {
      "id": 33,
      "start": 7155.0,
      "end": 7157.0,
      "formatted_start": "01:59:15.000",
      "formatted_end": "01:59:17.000",
      "text": "بلافاصله استفاده داره"
    },
    {
      "id": 34,
      "start": 7157.0,
      "end": 7159.0,
      "formatted_start": "01:59:17.000",
      "formatted_end": "01:59:19.000",
      "text": "خوب؟"
    },
    {
      "id": 35,
      "start": 7159.0,
      "end": 7161.0,
      "formatted_start": "01:59:19.000",
      "formatted_end": "01:59:21.000",
      "text": "شما دیگه چیز همینو"
    },
    {
      "id": 36,
      "start": 7161.0,
      "end": 7163.0,
      "formatted_start": "01:59:21.000",
      "formatted_end": "01:59:23.000",
      "text": "اگر قاسمی هم همینو نگه"
    },
    {
      "id": 37,
      "start": 7163.0,
      "end": 7165.0,
      "formatted_start": "01:59:23.000",
      "formatted_end": "01:59:25.000",
      "text": "دیگه اینا دنبال سراخ و موش رو"
    },
    {
      "id": 38,
      "start": 7165.0,
      "end": 7167.0,
      "formatted_start": "01:59:25.000",
      "formatted_end": "01:59:27.000",
      "text": "یه کارهایی میگنند نمیدونند"
    },
    {
      "id": 39,
      "start": 7167.0,
      "end": 7169.0,
      "formatted_start": "01:59:27.000",
      "formatted_end": "01:59:29.000",
      "text": "چیزه یعنی"
    },
    {
      "id": 40,
      "start": 7169.0,
      "end": 7171.0,
      "formatted_start": "01:59:29.000",
      "formatted_end": "01:59:31.000",
      "text": "ما دوباره اینقدر"
    },
    {
      "id": 41,
      "start": 7171.0,
      "end": 7173.0,
      "formatted_start": "01:59:31.000",
      "formatted_end": "01:59:33.000",
      "text": "لغمه رو میپیچونیم"
    },
    {
      "id": 42,
      "start": 7173.0,
      "end": 7175.0,
      "formatted_start": "01:59:33.000",
      "formatted_end": "01:59:35.000",
      "text": "از اون براتو درمو میذاریم"
    },
    {
      "id": 43,
      "start": 7175.0,
      "end": 7177.0,
      "formatted_start": "01:59:35.000",
      "formatted_end": "01:59:37.000",
      "text": "نه"
    },
    {
      "id": 44,
      "start": 7177.0,
      "end": 7179.0,
      "formatted_start": "01:59:37.000",
      "formatted_end": "01:59:39.000",
      "text": "ببینید من به آقای قاسمی هم"
    },
    {
      "id": 45,
      "start": 7179.0,
      "end": 7181.0,
      "formatted_start": "01:59:39.000",
      "formatted_end": "01:59:41.000",
      "text": "صحبت میپنم اگر این راه"
    },
    {
      "id": 46,
      "start": 7181.0,
      "end": 7183.0,
      "formatted_start": "01:59:41.000",
      "formatted_end": "01:59:43.000",
      "text": "ممکنه باشه ما"
    },
    {
      "id": 47,
      "start": 7183.0,
      "end": 7186.66,
      "formatted_start": "01:59:43.000",
      "formatted_end": "01:59:46.660",
      "text": "زابولی و زابولی و یکی دیگر رو حقیقی بیاریم که اون داستان"
    },
    {
      "id": 48,
      "start": 7186.66,
      "end": 7190.24,
      "formatted_start": "01:59:46.660",
      "formatted_end": "01:59:50.240",
      "text": "شلوخ کلوخ میشه حقیقی یه نظری روایتی داره خب"
    },
    {
      "id": 49,
      "start": 7190.24,
      "end": 7194.24,
      "formatted_start": "01:59:50.240",
      "formatted_end": "01:59:54.240",
      "text": "روایت اصلی همینی که آها بازرس ما استفاده داره"
    },
    {
      "id": 50,
      "start": 7194.24,
      "end": 7195.2,
      "formatted_start": "01:59:54.240",
      "formatted_end": "01:59:55.200",
      "text": "درسته؟"
    },
    {
      "id": 51,
      "start": 7195.2,
      "end": 7196.84,
      "formatted_start": "01:59:55.200",
      "formatted_end": "01:59:56.840",
      "text": "حضر بدلش میاد بالا"
    },
    {
      "id": 52,
      "start": 7196.84,
      "end": 7197.8,
      "formatted_start": "01:59:56.840",
      "formatted_end": "01:59:57.800",
      "text": "هم شده رفت"
    },
    {
      "id": 53,
      "start": 7197.8,
      "end": 7199.16,
      "formatted_start": "01:59:57.800",
      "formatted_end": "01:59:59.160",
      "text": "مثلا چیزی نظری که"
    },
    {
      "id": 54,
      "start": 7199.16,
      "end": 7199.96,
      "formatted_start": "01:59:59.160",
      "formatted_end": "01:59:59.960",
      "text": "مثلا"
    }
  ],
  "status": "completed"
}