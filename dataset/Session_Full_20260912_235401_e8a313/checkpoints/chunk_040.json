  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12029.98,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:29.980",
      "text": "بیمار، در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 12030.0,
      "end": 12035.0,
      "formatted_start": "03:20:30.000",
      "formatted_end": "03:20:35.000",
      "text": "پیچش میده. برعکس این کنید گاز پخش میشه یا ماشین تکن میده گازها رو پخش میده."
    },
    {
      "id": 2,
      "start": 12035.0,
      "end": 12040.0,
      "formatted_start": "03:20:35.000",
      "formatted_end": "03:20:40.000",
      "text": "ثابت که میشه یه جا روز زمین گازها تجمع میکنند و روده پیچش میده."
    },
    {
      "id": 3,
      "start": 12053.0,
      "end": 12058.0,
      "formatted_start": "03:20:53.000",
      "formatted_end": "03:20:58.000",
      "text": "بعد اینکه برگاهی وقتا که آروقشو نمیزنه این حالت پنیری برامی داره."
    },
    {
      "id": 4,
      "start": 12058.0,
      "end": 12060.0,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:00.000",
      "text": "ریفلاکس داره"
    },
    {
      "id": 5,
      "start": 12060.0,
      "end": 12064.0,
      "formatted_start": "03:21:00.000",
      "formatted_end": "03:21:04.000",
      "text": "شیر که یکم میمونه میونده مثل که پنیر میشه"
    },
    {
      "id": 6,
      "start": 12064.0,
      "end": 12068.0,
      "formatted_start": "03:21:04.000",
      "formatted_end": "03:21:08.000",
      "text": "از جسیدان های دوز پیشنهای شما برای ختمش کهید"
    },
    {
      "id": 7,
      "start": 12068.0,
      "end": 12070.0,
      "formatted_start": "03:21:08.000",
      "formatted_end": "03:21:10.000",
      "text": "یک ماه برده"
    },
    {
      "id": 8,
      "start": 12070.0,
      "end": 12074.0,
      "formatted_start": "03:21:10.000",
      "formatted_end": "03:21:14.000",
      "text": "یکم جون بگیره قبل شیش ماهیگی"
    },
    {
      "id": 9,
      "start": 12074.0,
      "end": 12076.0,
      "formatted_start": "03:21:14.000",
      "formatted_end": "03:21:16.000",
      "text": "در این دو ماهیگی تا شیش ماهیگی"
    },
    {
      "id": 10,
      "start": 12076.0,
      "end": 12079.0,
      "formatted_start": "03:21:16.000",
      "formatted_end": "03:21:19.000",
      "text": "چون بچه را که بیفته دیگه سخت میشه"
    },
    {
      "id": 11,
      "start": 12079.0,
      "end": 12083.0,
      "formatted_start": "03:21:19.000",
      "formatted_end": "03:21:23.000",
      "text": "بزرگتر همش از این روانی اصابه پرکر میشه برایش"
    },
    {
      "id": 12,
      "start": 12083.0,
      "end": 12085.0,
      "formatted_start": "03:21:23.000",
      "formatted_end": "03:21:25.000",
      "text": "امی سندگر های کینی میفهمه"
    },
    {
      "id": 13,
      "start": 12085.0,
      "end": 12087.0,
      "formatted_start": "03:21:25.000",
      "formatted_end": "03:21:27.000",
      "text": "بس چهار پنج موردی ختمش میکنه"
    },
    {
      "id": 14,
      "start": 12087.0,
      "end": 12089.0,
      "formatted_start": "03:21:27.000",
      "formatted_end": "03:21:29.000",
      "text": "همین چند روزا اگه ختم کنم مشکل داده؟"
    },
    {
      "id": 15,
      "start": 12089.0,
      "end": 12091.0,
      "formatted_start": "03:21:29.000",
      "formatted_end": "03:21:31.000",
      "text": "نه، نه مشکل داده"
    },
    {
      "id": 16,
      "start": 12091.0,
      "end": 12093.0,
      "formatted_start": "03:21:31.000",
      "formatted_end": "03:21:33.000",
      "text": "یه ماش پل شده"
    },
    {
      "id": 17,
      "start": 12093.0,
      "end": 12095.0,
      "formatted_start": "03:21:33.000",
      "formatted_end": "03:21:35.000",
      "text": "یه مانه از یک ماش"
    },
    {
      "id": 18,
      "start": 12095.0,
      "end": 12097.0,
      "formatted_start": "03:21:35.000",
      "formatted_end": "03:21:37.000",
      "text": "اولی فرصت ختم کنی"
    },
    {
      "id": 19,
      "start": 12097.0,
      "end": 12099.0,
      "formatted_start": "03:21:37.000",
      "formatted_end": "03:21:39.000",
      "text": "ختمهای زودرست بیتر از ختمهای"
    },
    {
      "id": 20,
      "start": 12099.0,
      "end": 12101.0,
      "formatted_start": "03:21:39.000",
      "formatted_end": "03:21:41.000",
      "text": "بعد حلوضه یا نه جرایی"
    },
    {
      "id": 21,
      "start": 12101.0,
      "end": 12103.0,
      "formatted_start": "03:21:41.000",
      "formatted_end": "03:21:43.000",
      "text": "حلقه"
    },
    {
      "id": 22,
      "start": 12103.0,
      "end": 12105.0,
      "formatted_start": "03:21:43.000",
      "formatted_end": "03:21:45.000",
      "text": "بریدن و دختن کجاکوله میشه"
    },
    {
      "id": 23,
      "start": 12105.0,
      "end": 12107.0,
      "formatted_start": "03:21:45.000",
      "formatted_end": "03:21:47.000",
      "text": "خون ریزی داره در دست"
    },
    {
      "id": 24,
      "start": 12107.0,
      "end": 12109.0,
      "formatted_start": "03:21:47.000",
      "formatted_end": "03:21:49.000",
      "text": "کسی این کاری نیم"
    },
    {
      "id": 25,
      "start": 12109.0,
      "end": 12111.0,
      "formatted_start": "03:21:49.000",
      "formatted_end": "03:21:51.000",
      "text": "حلقه مثلا خوبه"
    },
    {
      "id": 26,
      "start": 12111.0,
      "end": 12113.0,
      "formatted_start": "03:21:51.000",
      "formatted_end": "03:21:53.000",
      "text": "حلقه بعد هر جایی نه برید"
    },
    {
      "id": 27,
      "start": 12113.0,
      "end": 12117.4,
      "formatted_start": "03:21:53.000",
      "formatted_end": "03:21:57.400",
      "text": "یک آدم هایی که کارشون ختمه هست اینجا بود"
    },
    {
      "id": 28,
      "start": 12117.4,
      "end": 12123.8,
      "formatted_start": "03:21:57.400",
      "formatted_end": "03:22:03.800",
      "text": "مثلا این هایی که پیشتر ختمی کنند آقای دکتر پاچنالی گوبت ختمی زیاد می کند"
    },
    {
      "id": 29,
      "start": 12123.8,
      "end": 12125.2,
      "formatted_start": "03:22:03.800",
      "formatted_end": "03:22:05.200",
      "text": "اسماحان عربشی هم خوبه"
    },
    {
      "id": 30,
      "start": 12125.2,
      "end": 12126.2,
      "formatted_start": "03:22:05.200",
      "formatted_end": "03:22:06.200",
      "text": "دکتر سکوتی"
    },
    {
      "id": 31,
      "start": 12126.2,
      "end": 12127.6,
      "formatted_start": "03:22:06.200",
      "formatted_end": "03:22:07.600",
      "text": "اسماحان عربشی"
    },
    {
      "id": 32,
      "start": 12127.6,
      "end": 12129.0,
      "formatted_start": "03:22:07.600",
      "formatted_end": "03:22:09.000",
      "text": "نشتیده"
    },
    {
      "id": 33,
      "start": 12129.0,
      "end": 12132.12,
      "formatted_start": "03:22:09.000",
      "formatted_end": "03:22:12.120",
      "text": "اونها کلن کارشونتونه بابشتید و آقایی بوشه"
    },
    {
      "id": 34,
      "start": 12132.12,
      "end": 12134.0,
      "formatted_start": "03:22:12.120",
      "formatted_end": "03:22:14.000",
      "text": "کجا هست این مورد؟"
    },
    {
      "id": 35,
      "start": 12134.0,
      "end": 12138.0,
      "formatted_start": "03:22:14.000",
      "formatted_end": "03:22:18.000",
      "text": "دکتر پالیده اونجاست که داشته تزریقاتی شدید"
    },
    {
      "id": 36,
      "start": 12138.68,
      "end": 12139.5,
      "formatted_start": "03:22:18.680",
      "formatted_end": "03:22:19.500",
      "text": "نه"
    },
    {
      "id": 37,
      "start": 12139.5,
      "end": 12142.0,
      "formatted_start": "03:22:19.500",
      "formatted_end": "03:22:22.000",
      "text": "می دونم این که از پالیده"
    },
    {
      "id": 38,
      "start": 12143.0,
      "end": 12149.0,
      "formatted_start": "03:22:23.000",
      "formatted_end": "03:22:29.000",
      "text": "چیز تو را با دیگه ریزری و فلان رو میسوزن و چیز میکنه"
    },
    {
      "id": 39,
      "start": 12149.0,
      "end": 12154.0,
      "formatted_start": "03:22:29.000",
      "formatted_end": "03:22:34.000",
      "text": "اینک میزن اینا، صورتی گردی داره، درسته؟ آره، میشنسنش"
    },
    {
      "id": 40,
      "start": 12154.0,
      "end": 12158.0,
      "formatted_start": "03:22:34.000",
      "formatted_end": "03:22:38.000",
      "text": "اینجا به ما گفت، شما خطناتی جمع کن، من میام خطنه میکنم"
    },
    {
      "id": 41,
      "start": 12158.0,
      "end": 12165.0,
      "formatted_start": "03:22:38.000",
      "formatted_end": "03:22:45.000",
      "text": "مثلا اسم برند 352.35، بعد من 60 درصد به تو بیدن، 40 درصد به من"
    },
    {
      "id": 42,
      "start": 12165.0,
      "end": 12171.0,
      "formatted_start": "03:22:45.000",
      "formatted_end": "03:22:51.000",
      "text": "خودتونو انجام میدین پس؟ ما قبلا سال ۸۰ انجام میدیم، بعد یه برندی بیدن، اصافت خونه"
    },
    {
      "id": 43,
      "start": 12171.0,
      "end": 12175.0,
      "formatted_start": "03:22:51.000",
      "formatted_end": "03:22:55.000",
      "text": "اون میبود خطناتو شما مثلا یه هفته ی دو روز جمع وری کن"
    },
    {
      "id": 44,
      "start": 12175.0,
      "end": 12178.0,
      "formatted_start": "03:22:55.000",
      "formatted_end": "03:22:58.000",
      "text": "بعد من می آم با کمک همدیگه"
    },
    {
      "id": 45,
      "start": 12178.0,
      "end": 12180.0,
      "formatted_start": "03:22:58.000",
      "formatted_end": "03:23:00.000",
      "text": "یعنی دراصل اون فرمان دستشه"
    },
    {
      "id": 46,
      "start": 12180.0,
      "end": 12182.0,
      "formatted_start": "03:23:00.000",
      "formatted_end": "03:23:02.000",
      "text": "بعد من هم کم کم یاد میگیرم اون کار رو انجام میدهم"
    },
    {
      "id": 47,
      "start": 12182.0,
      "end": 12184.0,
      "formatted_start": "03:23:02.000",
      "formatted_end": "03:23:04.000",
      "text": "بعد خودتم چجوری کنم؟"
    },
    {
      "id": 48,
      "start": 12184.0,
      "end": 12185.0,
      "formatted_start": "03:23:04.000",
      "formatted_end": "03:23:05.000",
      "text": "آره اینجوری ما چیز می کنیم؟"
    },
    {
      "id": 49,
      "start": 12185.0,
      "end": 12186.0,
      "formatted_start": "03:23:05.000",
      "formatted_end": "03:23:06.000",
      "text": "بگویم لیزره دیدم؟"
    },
    {
      "id": 50,
      "start": 12186.0,
      "end": 12187.0,
      "formatted_start": "03:23:06.000",
      "formatted_end": "03:23:07.000",
      "text": "آره"
    },
    {
      "id": 51,
      "start": 12187.0,
      "end": 12188.0,
      "formatted_start": "03:23:07.000",
      "formatted_end": "03:23:08.000",
      "text": "داخت می کنی؟"
    },
    {
      "id": 52,
      "start": 12188.0,
      "end": 12189.0,
      "formatted_start": "03:23:08.000",
      "formatted_end": "03:23:09.000",
      "text": "یه پیچی داره؟"
    },
    {
      "id": 53,
      "start": 12189.0,
      "end": 12190.0,
      "formatted_start": "03:23:09.000",
      "formatted_end": "03:23:10.000",
      "text": "بیسترزون و از این داستانها؟"
    },
    {
      "id": 54,
      "start": 12190.0,
      "end": 12191.0,
      "formatted_start": "03:23:10.000",
      "formatted_end": "03:23:11.000",
      "text": "گفتم نه"
    },
    {
      "id": 55,
      "start": 12191.0,
      "end": 12192.0,
      "formatted_start": "03:23:11.000",
      "formatted_end": "03:23:12.000",
      "text": "میدونم کیه"
    },
    {
      "id": 56,
      "start": 12192.0,
      "end": 12200.0,
      "formatted_start": "03:23:12.000",
      "formatted_end": "03:23:20.000",
      "text": "اما به نظر من مثلا همین دختر پاچه ناری خوبه تو متخصص اطفال اینجا"
    },
    {
      "id": 57,
      "start": 12200.0,
      "end": 12204.0,
      "formatted_start": "03:23:20.000",
      "formatted_end": "03:23:24.000",
      "text": "اینجا های دختر سوپوتی هم از آن قدیل ختم می کرده"
    },
    {
      "id": 58,
      "start": 12204.0,
      "end": 12211.0,
      "formatted_start": "03:23:24.000",
      "formatted_end": "03:23:31.000",
      "text": "خب ببینین خانم و تحلیل شما رژم خضاییتون رو باید رایت کنید"
    },
    {
      "id": 59,
      "start": 12211.0,
      "end": 12215.0,
      "formatted_start": "03:23:31.000",
      "formatted_end": "03:23:35.000",
      "text": "اوه؟ اینا که میگم نباید بخوریم در مورد نه خود پیچه"
    },
    {
      "id": 60,
      "start": 12215.0,
      "end": 12222.5,
      "formatted_start": "03:23:35.000",
      "formatted_end": "03:23:42.500",
      "text": "هبوبات و لبنیات قابی خوصفندی اشکال نداره"
    },
    {
      "id": 61,
      "start": 12222.5,
      "end": 12224.5,
      "formatted_start": "03:23:42.500",
      "formatted_end": "03:23:44.500",
      "text": "بادمجان باد داره با خیال"
    },
    {
      "id": 62,
      "start": 12224.5,
      "end": 12228.0,
      "formatted_start": "03:23:44.500",
      "formatted_end": "03:23:48.000",
      "text": "این سه چهار علامه هبوبات و لبنیات"
    },
    {
      "id": 63,
      "start": 12228.0,
      "end": 12233.0,
      "formatted_start": "03:23:48.000",
      "formatted_end": "03:23:53.000",
      "text": "هبوبات حتی بگن خیستش کن و بعد بخور اشکال نداره نتصل میداره"
    },
    {
      "id": 64,
      "start": 12233.0,
      "end": 12239.0,
      "formatted_start": "03:23:53.000",
      "formatted_end": "03:23:59.000",
      "text": "یا آبشه نخور مثلا آشلشته یا آبشه بخورید و یک مده ببینیشون تصل میداره"
    },
    {
      "id": 65,
      "start": 12239.0,
      "end": 12244.6,
      "formatted_start": "03:23:59.000",
      "formatted_end": "03:24:04.600",
      "text": "خای متحری این داروهاش اقریبا 90 درصد آزاده ایشکنون دیمی نیست"
    },
    {
      "id": 66,
      "start": 12244.6,
      "end": 12245.2,
      "formatted_start": "03:24:04.600",
      "formatted_end": "03:24:05.200",
      "text": "درست"
    },
    {
      "id": 67,
      "start": 12245.2,
      "end": 12246.2,
      "formatted_start": "03:24:05.200",
      "formatted_end": "03:24:06.200",
      "text": "تقریبا سامانه"
    },
    {
      "id": 68,
      "start": 12246.2,
      "end": 12247.2,
      "formatted_start": "03:24:06.200",
      "formatted_end": "03:24:07.200",
      "text": "تقریبا داره ایشکنون"
    },
    {
      "id": 69,
      "start": 12247.2,
      "end": 12247.7,
      "formatted_start": "03:24:07.200",
      "formatted_end": "03:24:07.700",
      "text": "آره"
    },
    {
      "id": 70,
      "start": 12248.2,
      "end": 12249.7,
      "formatted_start": "03:24:08.200",
      "formatted_end": "03:24:09.700",
      "text": "چه داروی بهش دادین؟"
    },
    {
      "id": 71,
      "start": 12249.7,
      "end": 12252.0,
      "formatted_start": "03:24:09.700",
      "formatted_end": "03:24:12.000",
      "text": "قطعه کولیف دادن بهش"
    },
    {
      "id": 72,
      "start": 12252.0,
      "end": 12256.6,
      "formatted_start": "03:24:12.000",
      "formatted_end": "03:24:16.600",
      "text": "و اینجا قطعه دیکه این بود که اونو بردر پیش اینها بوده این مرز باشه"
    },
    {
      "id": 73,
      "start": 12256.6,
      "end": 12258.0,
      "formatted_start": "03:24:16.600",
      "formatted_end": "03:24:18.000",
      "text": "کولیف دادی؟"
    },
    {
      "id": 74,
      "start": 12258.0,
      "end": 12259.8,
      "formatted_start": "03:24:18.000",
      "formatted_end": "03:24:19.800",
      "text": "آه کولیف بهش میسازه؟"
    },
    {
      "id": 75,
      "start": 12260.2,
      "end": 12262.0,
      "formatted_start": "03:24:20.200",
      "formatted_end": "03:24:22.000",
      "text": "دیگه آهو میگیره وقتی میسازه"
    },
    {
      "id": 76,
      "start": 12262.0,
      "end": 12268.0,
      "formatted_start": "03:24:22.000",
      "formatted_end": "03:24:28.000",
      "text": "و اینکه پیش دکتوریه بردم چون یه بار در تایش روز خیلی نتشوی کرد"
    },
    {
      "id": 77,
      "start": 12268.0,
      "end": 12273.0,
      "formatted_start": "03:24:28.000",
      "formatted_end": "03:24:33.000",
      "text": "و پیش دکتوریه بردم قطرش رو عوض کرد بهش قطر آهنم داد"
    },
    {
      "id": 78,
      "start": 12273.0,
      "end": 12274.0,
      "formatted_start": "03:24:33.000",
      "formatted_end": "03:24:34.000",
      "text": "قطر آهنم؟"
    },
    {
      "id": 79,
      "start": 12274.0,
      "end": 12275.0,
      "formatted_start": "03:24:34.000",
      "formatted_end": "03:24:35.000",
      "text": "آهنم؟"
    },
    {
      "id": 80,
      "start": 12275.0,
      "end": 12277.0,
      "formatted_start": "03:24:35.000",
      "formatted_end": "03:24:37.000",
      "text": "اینکه اون قطر اوممی بود اعتمالا"
    },
    {
      "id": 81,
      "start": 12277.0,
      "end": 12280.0,
      "formatted_start": "03:24:37.000",
      "formatted_end": "03:24:40.000",
      "text": "نه، نه، آهنم بعد از چشمانه"
    },
    {
      "id": 82,
      "start": 12280.0,
      "end": 12282.0,
      "formatted_start": "03:24:40.000",
      "formatted_end": "03:24:42.000",
      "text": "فلیپ بولیس دکترم باشه"
    },
    {
      "id": 83,
      "start": 12282.0,
      "end": 12284.0,
      "formatted_start": "03:24:42.000",
      "formatted_end": "03:24:44.000",
      "text": "نه، نه، اون از هم اون روز اون روز ندیگه باشه"
    },
    {
      "id": 84,
      "start": 12284.0,
      "end": 12286.0,
      "formatted_start": "03:24:44.000",
      "formatted_end": "03:24:46.000",
      "text": "پرد بیتامین آده بشه"
    },
    {
      "id": 85,
      "start": 12286.0,
      "end": 12287.0,
      "formatted_start": "03:24:46.000",
      "formatted_end": "03:24:47.000",
      "text": "آده بشه، بله"
    },
    {
      "id": 86,
      "start": 12287.0,
      "end": 12291.0,
      "formatted_start": "03:24:47.000",
      "formatted_end": "03:24:51.000",
      "text": "خب، شما کلیت اگر نیست از این کترش، هر هشت ساعت هشت کتر رو بده"
    },
    {
      "id": 87,
      "start": 12291.0,
      "end": 12293.0,
      "formatted_start": "03:24:51.000",
      "formatted_end": "03:24:53.000",
      "text": "هشت ساعت هشت کتر"
    },
    {
      "id": 88,
      "start": 12293.0,
      "end": 12295.0,
      "formatted_start": "03:24:53.000",
      "formatted_end": "03:24:55.000",
      "text": "شعبت اهورانینی"
    },
    {
      "id": 89,
      "start": 12297.0,
      "end": 12299.0,
      "formatted_start": "03:24:57.000",
      "formatted_end": "03:24:59.000",
      "text": "هر هشت ساعت مارپا خوری"
    },
    {
      "id": 90,
      "start": 12299.0,
      "end": 12301.0,
      "formatted_start": "03:24:59.000",
      "formatted_end": "03:25:01.000",
      "text": "صدای مزکوت شده"
    }
  ],
  "status": "completed"
}