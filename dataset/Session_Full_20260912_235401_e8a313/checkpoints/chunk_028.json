  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8428.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:28.000",
      "text": "اینجوری باشه، ما فقط نایت اینکه میتونیم بازرسال دوبنده به چیز کنیم."
    },
    {
      "id": 1,
      "start": 8428.0,
      "end": 8436.88,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:36.880",
      "text": "اون دیگر بازدشت ها رو نه نه این رای زنی می کنن رای می گیرن خودشون"
    },
    {
      "id": 2,
      "start": 8436.88,
      "end": 8441.38,
      "formatted_start": "02:20:36.880",
      "formatted_end": "02:20:41.380",
      "text": "این ها رای نه ما اصلا با کنم"
    },
    {
      "id": 3,
      "start": 8441.38,
      "end": 8447.0,
      "formatted_start": "02:20:41.380",
      "formatted_end": "02:20:47.000",
      "text": "آره ما بسیار چیز داریم این ها بگو رو خواهیم اگر بخواهید هرکی پاشت کفش ما بونه"
    },
    {
      "id": 4,
      "start": 8447.0,
      "end": 8451.46,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:51.460",
      "text": "هر بازدشتی هرکی می تونه بره لاوی کنه نظر می گیره"
    },
    {
      "id": 5,
      "start": 8451.46,
      "end": 8453.0,
      "formatted_start": "02:20:51.460",
      "formatted_end": "02:20:53.000",
      "text": "درسته؟"
    },
    {
      "id": 6,
      "start": 8458.0,
      "end": 8460.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:00.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 8470.0,
      "end": 8473.0,
      "formatted_start": "02:21:10.000",
      "formatted_end": "02:21:13.000",
      "text": "خب من از یه نفر دیگه هم سآل میکنم بیدیم از هم موضوع چیه"
    },
    {
      "id": 8,
      "start": 8473.0,
      "end": 8476.0,
      "formatted_start": "02:21:13.000",
      "formatted_end": "02:21:16.000",
      "text": "از کی من شما پیشنات بیدیم سآل کنم؟"
    },
    {
      "id": 9,
      "start": 8485.0,
      "end": 8487.0,
      "formatted_start": "02:21:25.000",
      "formatted_end": "02:21:27.000",
      "text": "اتحادیه"
    },
    {
      "id": 10,
      "start": 8488.0,
      "end": 8490.0,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:30.000",
      "text": "اسمش اکتادیه"
    },
    {
      "id": 11,
      "start": 8490.0,
      "end": 8492.0,
      "formatted_start": "02:21:30.000",
      "formatted_end": "02:21:32.000",
      "text": "شماره شی دارین"
    },
    {
      "id": 12,
      "start": 8492.0,
      "end": 8494.0,
      "formatted_start": "02:21:32.000",
      "formatted_end": "02:21:34.000",
      "text": "شماره شی دارین"
    },
    {
      "id": 13,
      "start": 8494.0,
      "end": 8496.0,
      "formatted_start": "02:21:34.000",
      "formatted_end": "02:21:36.000",
      "text": "بفرستیم من ببینم این مشکل چه"
    },
    {
      "id": 14,
      "start": 8496.0,
      "end": 8498.0,
      "formatted_start": "02:21:36.000",
      "formatted_end": "02:21:38.000",
      "text": "آره مرسی ممنون"
    },
    {
      "id": 15,
      "start": 8498.0,
      "end": 8500.0,
      "formatted_start": "02:21:38.000",
      "formatted_end": "02:21:40.000",
      "text": "باشه سفاس گذار خدافزید"
    },
    {
      "id": 16,
      "start": 8518.0,
      "end": 8528.0,
      "formatted_start": "02:21:58.000",
      "formatted_end": "02:22:08.000",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 8548.0,
      "end": 8577.98,
      "formatted_start": "02:22:28.000",
      "formatted_end": "02:22:57.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 18,
      "start": 8578.0,
      "end": 8592.0,
      "formatted_start": "02:22:58.000",
      "formatted_end": "02:23:12.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 8592.0,
      "end": 8598.0,
      "formatted_start": "02:23:12.000",
      "formatted_end": "02:23:18.000",
      "text": "تیرش کچیکه از کجای گرفته؟"
    },
    {
      "id": 20,
      "start": 8598.0,
      "end": 8600.0,
      "formatted_start": "02:23:18.000",
      "formatted_end": "02:23:20.000",
      "text": "در اینجا دیگه کنیم کچیکتره"
    },
    {
      "id": 21,
      "start": 8600.0,
      "end": 8605.0,
      "formatted_start": "02:23:20.000",
      "formatted_end": "02:23:25.000",
      "text": "یه دسته تا در اینجا دوسته من سایه گرافیه"
    },
    {
      "id": 22,
      "start": 8605.0,
      "end": 8607.0,
      "formatted_start": "02:23:25.000",
      "formatted_end": "02:23:27.000",
      "text": "یه دقیقه سایه گرافیه"
    },
    {
      "id": 23,
      "start": 8607.0,
      "end": 8609.0,
      "formatted_start": "02:23:27.000",
      "formatted_end": "02:23:29.000",
      "text": "از اینجا سایه گرافیه"
    },
    {
      "id": 24,
      "start": 8609.0,
      "end": 8611.0,
      "formatted_start": "02:23:29.000",
      "formatted_end": "02:23:31.000",
      "text": "این تنگون پیزشگی شد"
    },
    {
      "id": 25,
      "start": 8611.0,
      "end": 8616.0,
      "formatted_start": "02:23:31.000",
      "formatted_end": "02:23:36.000",
      "text": "خب بعد این نامه ها رو گیره که مال اسامو"
    },
    {
      "id": 26,
      "start": 8616.0,
      "end": 8618.0,
      "formatted_start": "02:23:36.000",
      "formatted_end": "02:23:38.000",
      "text": "برداخت"
    },
    {
      "id": 27,
      "start": 8618.0,
      "end": 8620.0,
      "formatted_start": "02:23:38.000",
      "formatted_end": "02:23:40.000",
      "text": "باشه باشه خواهد خواهد"
    },
    {
      "id": 28,
      "start": 8620.0,
      "end": 8622.0,
      "formatted_start": "02:23:40.000",
      "formatted_end": "02:23:42.000",
      "text": "خب چند تا منیزید؟"
    },
    {
      "id": 29,
      "start": 8622.0,
      "end": 8624.0,
      "formatted_start": "02:23:42.000",
      "formatted_end": "02:23:44.000",
      "text": "پشتی، باید هست کسی"
    },
    {
      "id": 30,
      "start": 8650.0,
      "end": 8656.0,
      "formatted_start": "02:24:10.000",
      "formatted_end": "02:24:16.000",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 8680.0,
      "end": 8682.0,
      "formatted_start": "02:24:40.000",
      "formatted_end": "02:24:42.000",
      "text": "اینجوری باید بردارید"
    },
    {
