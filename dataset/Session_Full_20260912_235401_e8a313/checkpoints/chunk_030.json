  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9025.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:25.000",
      "text": "این همه کچلی های سکهی بهش میاد. در صورت سکه سکه میریزه. استرس هم تصیب داره. من پوماد اینا براشو می نویستم اگر طولانی مدت باید مثلا 5-6 هفته بزنید، 2-3 ماهی بزنید تا کم کم از این موادر بزنید. اگر باید پوماد بیتر شد کچه اگر نشد باید کانفول زیر پوستی تزیزه کشه تا این مودر بیادیم."
    },
    {
      "id": 1,
      "start": 9025.0,
      "end": 9031.58,
      "formatted_start": "02:30:25.000",
      "formatted_end": "02:30:31.580",
      "text": "چون تا یکی دو ماه پیش نبودن وقتی کارا تنقیبا امتحانای ما شروع شده تو کنم به خاطر اونه"
    },
    {
      "id": 2,
      "start": 9031.58,
      "end": 9032.28,
      "formatted_start": "02:30:31.580",
      "formatted_end": "02:30:32.280",
      "text": "بله"
    },
    {
      "id": 3,
      "start": 9032.28,
      "end": 9032.82,
      "formatted_start": "02:30:32.280",
      "formatted_end": "02:30:32.820",
      "text": "دسترس شویم"
    },
    {
      "id": 4,
      "start": 9032.82,
      "end": 9036.96,
      "formatted_start": "02:30:32.820",
      "formatted_end": "02:30:36.960",
      "text": "یه قرص زده استراب و زده چیزم برایت میویسم"
    },
    {
      "id": 5,
      "start": 9036.96,
      "end": 9037.76,
      "formatted_start": "02:30:36.960",
      "formatted_end": "02:30:37.760",
      "text": "بس چون برده"
    },
    {
      "id": 6,
      "start": 9037.76,
      "end": 9045.04,
      "formatted_start": "02:30:37.760",
      "formatted_end": "02:30:45.040",
      "text": "خودت هم سرکن آرامش داشته باشی تبایی"
    },
    {
      "id": 7,
      "start": 9045.04,
      "end": 9046.32,
      "formatted_start": "02:30:45.040",
      "formatted_end": "02:30:46.320",
      "text": "نمیشه مای دکتر باشم"
    },
    {
      "id": 8,
      "start": 9046.32,
      "end": 9047.92,
      "formatted_start": "02:30:46.320",
      "formatted_end": "02:30:47.920",
      "text": "چرا؟"
    },
    {
      "id": 9,
      "start": 9047.92,
      "end": 9052.04,
      "formatted_start": "02:30:47.920",
      "formatted_end": "02:30:52.040",
      "text": "دسترس تنقیبا تو خانواده ما اینجوری سیم شده بود"
    },
    {
      "id": 10,
      "start": 9052.04,
      "end": 9054.86,
      "formatted_start": "02:30:52.040",
      "formatted_end": "02:30:54.860",
      "text": "سالانت خیلی مادر و زوج هم هست"
    },
    {
      "id": 11,
      "start": 9054.86,
      "end": 9057.9,
      "formatted_start": "02:30:54.860",
      "formatted_end": "02:30:57.900",
      "text": "مثلا باز مادر و پدر هم نیست باز من هستم"
    },
    {
      "id": 12,
      "start": 9057.9,
      "end": 9059.96,
      "formatted_start": "02:30:57.900",
      "formatted_end": "02:30:59.960",
      "text": "یه جوری اینگار استی باز مثلا"
    },
    {
      "id": 13,
      "start": 9059.96,
      "end": 9061.94,
      "formatted_start": "02:30:59.960",
      "formatted_end": "02:31:01.940",
      "text": "عموم نیست عمام خیلی استرسی"
    },
    {
      "id": 14,
      "start": 9061.94,
      "end": 9064.88,
      "formatted_start": "02:31:01.940",
      "formatted_end": "02:31:04.880",
      "text": "من برای مثلا آمدن بیرون هم یه جوری استرس بودیم"
    },
    {
      "id": 15,
      "start": 9064.88,
      "end": 9069.12,
      "formatted_start": "02:31:04.880",
      "formatted_end": "02:31:09.120",
      "text": "این رو برای آسنترا 50 نوشتم با استراب و زیاده چیز"
    },
    {
      "id": 16,
      "start": 9069.12,
      "end": 9074.3,
      "formatted_start": "02:31:09.120",
      "formatted_end": "02:31:14.300",
      "text": "دیگر هم روزی یک کیلو فارغ اگر دیدید خیلی جواب نیم دید روزی دوز اطلاعی بعد دوسته هفته اینا"
    },
    {
      "id": 17,
      "start": 9074.3,
      "end": 9076.3,
      "formatted_start": "02:31:14.300",
      "formatted_end": "02:31:16.300",
      "text": "برسای اصلاح آره"
    },
    {
      "id": 18,
      "start": 9076.3,
      "end": 9078.98,
      "formatted_start": "02:31:16.300",
      "formatted_end": "02:31:18.980",
      "text": "جوابشون شروع میشه های سمیت"
    },
    {
      "id": 19,
      "start": 9078.98,
      "end": 9080.98,
      "formatted_start": "02:31:18.980",
      "formatted_end": "02:31:20.980",
      "text": "این کماد هم بگیر"
    },
    {
      "id": 20,
      "start": 9080.98,
      "end": 9084.16,
      "formatted_start": "02:31:20.980",
      "formatted_end": "02:31:24.160",
      "text": "اگر دوسته هفته زدید با این کماد خوب شد مواد"
    },
    {
      "id": 21,
      "start": 9084.16,
      "end": 9087.66,
      "formatted_start": "02:31:24.160",
      "formatted_end": "02:31:27.660",
      "text": "ادامه بده و اگر نه پیش یک مخصص پوست برو که"
    },
    {
      "id": 22,
      "start": 9087.66,
      "end": 9090.58,
      "formatted_start": "02:31:27.660",
      "formatted_end": "02:31:30.580",
      "text": "آمبول زیر پوستی بهت بزنه"
    },
    {
      "id": 23,
      "start": 9090.58,
      "end": 9092.58,
      "formatted_start": "02:31:30.580",
      "formatted_end": "02:31:32.580",
      "text": "این دارو بکنم بیاد من ببینم"
    },
    {
      "id": 24,
      "start": 9092.58,
      "end": 9094.58,
      "formatted_start": "02:31:32.580",
      "formatted_end": "02:31:34.580",
      "text": "دست رو بگم"
    },
    {
      "id": 25,
      "start": 9107.58,
      "end": 9111.58,
      "formatted_start": "02:31:47.580",
      "formatted_end": "02:31:51.580",
      "text": "بخوند سلام سلامت بشید خواهش می کنم سلام"
    },
    {
      "id": 26,
      "start": 9111.58,
      "end": 9113.58,
      "formatted_start": "02:31:51.580",
      "formatted_end": "02:31:53.580",
      "text": "خوب از دیگه اونجا بگیریم"
    },
    {
      "id": 27,
      "start": 9116.58,
      "end": 9119.58,
      "formatted_start": "02:31:56.580",
      "formatted_end": "02:31:59.580",
      "text": "چی شده آی آزرچه؟ آره؟"
    },
    {
      "id": 28,
      "start": 9119.58,
      "end": 9121.58,
      "formatted_start": "02:31:59.580",
      "formatted_end": "02:32:01.580",
      "text": "برنامه شما"
    },
    {
      "id": 29,
      "start": 9121.58,
      "end": 9123.58,
      "formatted_start": "02:32:01.580",
      "formatted_end": "02:32:03.580",
      "text": "کمی؟"
    },
    {
      "id": 30,
      "start": 9123.58,
      "end": 9125.58,
      "formatted_start": "02:32:03.580",
      "formatted_end": "02:32:05.580",
      "text": "چند وقت؟"
    },
    {
      "id": 31,
      "start": 9125.58,
      "end": 9127.58,
      "formatted_start": "02:32:05.580",
      "formatted_end": "02:32:07.580",
      "text": "هر دو روز"
    },
    {
      "id": 32,
      "start": 9127.58,
      "end": 9129.58,
      "formatted_start": "02:32:07.580",
      "formatted_end": "02:32:09.580",
      "text": "هر دو روز"
    },
    {
      "id": 33,
      "start": 9129.58,
      "end": 9131.58,
      "formatted_start": "02:32:09.580",
      "formatted_end": "02:32:11.580",
      "text": "هر شش روز هم بوده"
    },
    {
      "id": 34,
      "start": 9131.58,
      "end": 9133.58,
      "formatted_start": "02:32:11.580",
      "formatted_end": "02:32:13.580",
      "text": "کمان چجوری کار میکرد؟"
    },
    {
      "id": 35,
      "start": 9133.58,
      "end": 9135.58,
      "formatted_start": "02:32:13.580",
      "formatted_end": "02:32:15.580",
      "text": "روزی دو سه بار"
    },
    {
      "id": 36,
      "start": 9135.58,
      "end": 9137.58,
      "formatted_start": "02:32:15.580",
      "formatted_end": "02:32:17.580",
      "text": "خودش عذیب میکنه"
    },
    {
      "id": 37,
      "start": 9137.58,
      "end": 9139.58,
      "formatted_start": "02:32:17.580",
      "formatted_end": "02:32:19.580",
      "text": "شیر خوش کم دید؟"
    },
    {
      "id": 38,
      "start": 9139.58,
      "end": 9141.58,
      "formatted_start": "02:32:19.580",
      "formatted_end": "02:32:21.580",
      "text": "چند روزی داده"
    },
    {
      "id": 39,
      "start": 9141.58,
      "end": 9143.58,
      "formatted_start": "02:32:21.580",
      "formatted_end": "02:32:23.580",
      "text": "دیگه نداده"
    },
    {
      "id": 40,
      "start": 9143.58,
      "end": 9145.58,
      "formatted_start": "02:32:23.580",
      "formatted_end": "02:32:25.580",
      "text": "شیر خوش سفت میکنه"
    },
    {
      "id": 41,
      "start": 9145.58,
      "end": 9147.58,
      "formatted_start": "02:32:25.580",
      "formatted_end": "02:32:27.580",
      "text": "الان خیلی وقت نمیدونه"
    },
    {
      "id": 42,
      "start": 9147.58,
      "end": 9149.58,
      "formatted_start": "02:32:27.580",
      "formatted_end": "02:32:29.580",
      "text": "همچنین چیزی هم دادی؟"
    },
    {
      "id": 43,
      "start": 9149.58,
      "end": 9151.58,
      "formatted_start": "02:32:29.580",
      "formatted_end": "02:32:31.580",
      "text": "همچنین چیزی هم دادی؟"
    },
    {
      "id": 44,
      "start": 9151.58,
      "end": 9153.58,
      "formatted_start": "02:32:31.580",
      "formatted_end": "02:32:33.580",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 9153.58,
      "end": 9155.58,
      "formatted_start": "02:32:33.580",
      "formatted_end": "02:32:35.580",
      "text": "شیاف از لاروپانه"
    },
    {
      "id": 46,
      "start": 9155.58,
      "end": 9157.58,
      "formatted_start": "02:32:35.580",
      "formatted_end": "02:32:37.580",
      "text": "شیاف چی؟"
    },
    {
      "id": 47,
      "start": 9157.58,
      "end": 9159.58,
      "formatted_start": "02:32:37.580",
      "formatted_end": "02:32:39.580",
      "text": "شیاف بسیار شکوشی هسته"
    },
    {
      "id": 48,
      "start": 9159.58,
      "end": 9161.58,
      "formatted_start": "02:32:39.580",
      "formatted_end": "02:32:41.580",
      "text": "نه بردم شیاف"
    },
    {
      "id": 49,
      "start": 9161.58,
      "end": 9163.58,
      "formatted_start": "02:32:41.580",
      "formatted_end": "02:32:43.580",
      "text": "لاروپانه"
    },
    {
      "id": 50,
      "start": 9163.58,
      "end": 9165.58,
      "formatted_start": "02:32:43.580",
      "formatted_end": "02:32:45.580",
      "text": "گلیسترین؟"
    },
    {
      "id": 51,
      "start": 9165.58,
      "end": 9167.58,
      "formatted_start": "02:32:45.580",
      "formatted_end": "02:32:47.580",
      "text": "آره"
    },
    {
      "id": 52,
      "start": 9167.58,
      "end": 9169.58,
      "formatted_start": "02:32:47.580",
      "formatted_end": "02:32:49.580",
      "text": "دیگه بدی که"
    },
    {
      "id": 53,
      "start": 9169.58,
      "end": 9171.58,
      "formatted_start": "02:32:49.580",
      "formatted_end": "02:32:51.580",
      "text": "کارمی کنه"
    },
    {
      "id": 54,
      "start": 9171.58,
      "end": 9173.58,
      "formatted_start": "02:32:51.580",
      "formatted_end": "02:32:53.580",
      "text": "گریه شکوشیه"
    },
    {
      "id": 55,
      "start": 9173.58,
      "end": 9185.58,
      "formatted_start": "02:32:53.580",
      "formatted_end": "02:33:05.580",
      "text": "موسیقی"
    },
    {
      "id": 56,
      "start": 9185.58,
      "end": 9187.58,
      "formatted_start": "02:33:05.580",
      "formatted_end": "02:33:07.580",
      "text": "این طرف؟ آه آه"
    },
    {
      "id": 57,
      "start": 9192.38,
      "end": 9193.68,
      "formatted_start": "02:33:12.380",
      "formatted_end": "02:33:13.680",
      "text": "آی آی آی"
    },
    {
      "id": 58,
      "start": 9193.68,
      "end": 9194.58,
      "formatted_start": "02:33:13.680",
      "formatted_end": "02:33:14.580",
      "text": "خرد خرد"
    },
    {
      "id": 59,
      "start": 9194.58,
      "end": 9195.58,
      "formatted_start": "02:33:14.580",
      "formatted_end": "02:33:15.580",
      "text": "باید باید"
    },
    {
      "id": 60,
      "start": 9195.58,
      "end": 9196.58,
      "formatted_start": "02:33:15.580",
      "formatted_end": "02:33:16.580",
      "text": "خب پنج"
    },
    {
      "id": 61,
      "start": 9196.58,
      "end": 9197.58,
      "formatted_start": "02:33:16.580",
      "formatted_end": "02:33:17.580",
      "text": "باید باید"
    },
    {
      "id": 62,
      "start": 9199.58,
      "end": 9200.58,
      "formatted_start": "02:33:19.580",
      "formatted_end": "02:33:20.580",
      "text": "برم"
    },
    {
      "id": 63,
      "start": 9200.58,
      "end": 9201.58,
      "formatted_start": "02:33:20.580",
      "formatted_end": "02:33:21.580",
      "text": "خب"
    },
    {
      "id": 64,
      "start": 9204.58,
      "end": 9205.58,
      "formatted_start": "02:33:24.580",
      "formatted_end": "02:33:25.580",
      "text": "برم"
    },
    {
      "id": 65,
      "start": 9205.58,
      "end": 9207.58,
      "formatted_start": "02:33:25.580",
      "formatted_end": "02:33:27.580",
      "text": "باید برم آشتی آی آزدشت"
    },
    {
      "id": 66,
      "start": 9207.58,
      "end": 9208.58,
      "formatted_start": "02:33:27.580",
      "formatted_end": "02:33:28.580",
      "text": "پنج باش"
    },
    {
      "id": 67,
      "start": 9208.58,
      "end": 9209.58,
      "formatted_start": "02:33:28.580",
      "formatted_end": "02:33:29.580",
      "text": "آزدشت پنج"
    },
    {
      "id": 68,
      "start": 9209.58,
      "end": 9213.58,
      "formatted_start": "02:33:29.580",
      "formatted_end": "02:33:33.580",
      "text": "ببینین اینو یه شربت و یه شیاف میلویسم"
    },
    {
      "id": 69,
      "start": 9213.58,
      "end": 9215.58,
      "formatted_start": "02:33:33.580",
      "formatted_end": "02:33:35.580",
      "text": "داروی گیاهی هم می نویستن"
    },
    {
      "id": 70,
      "start": 9215.58,
      "end": 9217.58,
      "formatted_start": "02:33:35.580",
      "formatted_end": "02:33:37.580",
      "text": "خب من بهتون میگم"
    },
    {
      "id": 71,
      "start": 9217.58,
      "end": 9219.58,
      "formatted_start": "02:33:37.580",
      "formatted_end": "02:33:39.580",
      "text": "چی فراموش باید کردیم"
    },
    {
      "id": 72,
      "start": 9227.58,
      "end": 9229.58,
      "formatted_start": "02:33:47.580",
      "formatted_end": "02:33:49.580",
      "text": "داروی گیاهی هم این دارو به کرمانترزی می دهم"
    },
    {
      "id": 73,
      "start": 9229.58,
      "end": 9231.58,
      "formatted_start": "02:33:49.580",
      "formatted_end": "02:33:51.580",
      "text": "داروی گیاهی هم"
    },
    {
      "id": 74,
      "start": 9231.58,
      "end": 9233.58,
      "formatted_start": "02:33:51.580",
      "formatted_end": "02:33:53.580",
      "text": "ازش هست"
    },
    {
      "id": 75,
      "start": 9233.58,
      "end": 9235.58,
      "formatted_start": "02:33:53.580",
      "formatted_end": "02:33:55.580",
      "text": "پلوس"
    },
    {
      "id": 76,
      "start": 9235.58,
      "end": 9237.58,
      "formatted_start": "02:33:55.580",
      "formatted_end": "02:33:57.580",
      "text": "اگر با اینا خوب شد"
    },
    {
      "id": 77,
      "start": 9237.58,
      "end": 9239.58,
      "formatted_start": "02:33:57.580",
      "formatted_end": "02:33:59.580",
      "text": "هیچگه نشد"
    },
    {
      "id": 78,
      "start": 9239.58,
      "end": 9241.58,
      "formatted_start": "02:33:59.580",
      "formatted_end": "02:34:01.580",
      "text": "مثل چوبمانند قهرمون و آب"
    },
    {
      "id": 79,
      "start": 9241.58,
      "end": 9246.58,
      "formatted_start": "02:34:01.580",
      "formatted_end": "02:34:06.580",
      "text": "دیمون حل کنید که آبیگرد صبح دو قاشب شب بردید"
    },
    {
      "id": 80,
      "start": 9246.58,
      "end": 9247.58,
      "formatted_start": "02:34:06.580",
      "formatted_end": "02:34:07.580",
      "text": "میخدمت شما"
    },
    {
      "id": 81,
      "start": 9247.58,
      "end": 9248.58,
      "formatted_start": "02:34:07.580",
      "formatted_end": "02:34:08.580",
      "text": "امیدوارم"
    },
    {
      "id": 82,
      "start": 9248.58,
      "end": 9249.58,
      "formatted_start": "02:34:08.580",
      "formatted_end": "02:34:09.580",
      "text": "خوش سپس"
    },
    {
      "id": 83,
      "start": 9249.58,
      "end": 9250.58,
      "formatted_start": "02:34:09.580",
      "formatted_end": "02:34:10.580",
      "text": "خیلی ممنون"
    },
    {
      "id": 84,
      "start": 9250.58,
      "end": 9251.58,
      "formatted_start": "02:34:10.580",
      "formatted_end": "02:34:11.580",
      "text": "مستیم خدا"
    },
    {
      "id": 85,
      "start": 9251.58,
      "end": 9252.58,
      "formatted_start": "02:34:11.580",
      "formatted_end": "02:34:12.580",
      "text": "درم بیدنم"
    },
    {
      "id": 86,
      "start": 9252.58,
      "end": 9253.58,
      "formatted_start": "02:34:12.580",
      "formatted_end": "02:34:13.580",
      "text": "چشم"
    },
    {
      "id": 87,
      "start": 9253.58,
      "end": 9254.58,
      "formatted_start": "02:34:13.580",
      "formatted_end": "02:34:14.580",
      "text": "امیدوارم"
    },
    {
      "id": 88,
      "start": 9271.58,
      "end": 9299.58,
      "formatted_start": "02:34:31.580",
      "formatted_end": "02:34:59.580",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}