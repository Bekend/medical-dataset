  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10227.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:27.000",
      "text": "در اینجا میام درست فهمیدم. ما دو مرتبه مقصد اینجوری میکنیم که ما در مجمل اعضای حیگت مدیره منتخب انتخاب شدن، خب بعد در جلسه حیگت مدیره هم مثلا رئیس و نایب رئیس سمت ها مشخص، مدیر آمد هم بینویسم، خب، خب، خب، جز مثلا مدیر آمد رئیس حیگت مدیر و غیر ذالک تقییم شده،"
    },
    {
      "id": 1,
      "start": 10227.0,
      "end": 10232.0,
      "formatted_start": "02:50:27.000",
      "formatted_end": "02:50:32.000",
      "text": "ولی چون بازرس ما با ماده 147 همخوانی ندارد"
    },
    {
      "id": 2,
      "start": 10232.0,
      "end": 10235.0,
      "formatted_start": "02:50:32.000",
      "formatted_end": "02:50:35.000",
      "text": "مجددا ما"
    },
    {
      "id": 3,
      "start": 10248.0,
      "end": 10249.0,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:49.000",
      "text": "خب خب خب"
    },
    {
      "id": 4,
      "start": 10249.0,
      "end": 10253.0,
      "formatted_start": "02:50:49.000",
      "formatted_end": "02:50:53.000",
      "text": "آره منم که یه مشورت کردم با اون گیلا"
    },
    {
      "id": 5,
      "start": 10253.0,
      "end": 10259.88,
      "formatted_start": "02:50:53.000",
      "formatted_end": "02:50:59.880",
      "text": "آقا اینا یه نفر حرف تو دهنش میذاره"
    },
    {
      "id": 6,
      "start": 10259.88,
      "end": 10262.64,
      "formatted_start": "02:50:59.880",
      "formatted_end": "02:51:02.640",
      "text": "بعض موقع میخواد اون جلسه افتار میشه خودش بیاد"
    },
    {
      "id": 7,
      "start": 10262.64,
      "end": 10263.5,
      "formatted_start": "02:51:02.640",
      "formatted_end": "02:51:03.500",
      "text": "خب"
    },
    {
      "id": 8,
      "start": 10263.5,
      "end": 10265.96,
      "formatted_start": "02:51:03.500",
      "formatted_end": "02:51:05.960",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 10265.96,
      "end": 10268.76,
      "formatted_start": "02:51:05.960",
      "formatted_end": "02:51:08.760",
      "text": "اصلا طبق اون چیز میگه آقا بازرست"
    },
    {
      "id": 10,
      "start": 10268.76,
      "end": 10269.9,
      "formatted_start": "02:51:08.760",
      "formatted_end": "02:51:09.900",
      "text": "فول کردیم"
    },
    {
      "id": 11,
      "start": 10269.9,
      "end": 10271.8,
      "formatted_start": "02:51:09.900",
      "formatted_end": "02:51:11.800",
      "text": "کل جلسه رو فول نکردیم"
    },
    {
      "id": 12,
      "start": 10271.8,
      "end": 10274.4,
      "formatted_start": "02:51:11.800",
      "formatted_end": "02:51:14.400",
      "text": "بازرستتون خط بزن یه بازرست دیگه بزن"
    },
    {
      "id": 13,
      "start": 10274.4,
      "end": 10279.66,
      "formatted_start": "02:51:14.400",
      "formatted_end": "02:51:19.660",
      "text": "باشه"
    },
    {
      "id": 14,
      "start": 10279.66,
      "end": 10280.8,
      "formatted_start": "02:51:19.660",
      "formatted_end": "02:51:20.800",
      "text": "ممنون باشکی"
    },
    {
      "id": 15,
      "start": 10280.8,
      "end": 10282.16,
      "formatted_start": "02:51:20.800",
      "formatted_end": "02:51:22.160",
      "text": "خداحافظ"
    },
    {
      "id": 16,
      "start": 10283.0,
      "end": 10305.0,
      "formatted_start": "02:51:23.000",
      "formatted_end": "02:51:45.000",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 10305.0,
      "end": 10332.08,
      "formatted_start": "02:51:45.000",
      "formatted_end": "02:52:12.080",
      "text": "حالا سلام، راسته با آی رایمی؟ آی رایمی من اونو پیگیری کردم، خب، با آقای اول قاسمی هم صحبت کردم، ایشون گفت که فقط بازرستتونو شما باید هست کنید چون نسبت چیزی داره، خب، یکی و دیکن اعضای حیط مدیره سر جاش قرار میگیره، شما باید یه جلسه مجمع بذارید و یه بازرست جدید اتخاب کنید، خب، من به این اکتفا نکردم"
    },
    {
      "id": 18,
      "start": 10332.08,
      "end": 10340.08,
      "formatted_start": "02:52:12.080",
      "formatted_end": "02:52:20.080",
      "text": "چون بخواهم کسایی هستن که دورورد که میخوان این کلک سیستمه مثلا این مجمع به هم بگیرد یه جدید با همه چیز به وجود بیاد"
    },
    {
      "id": 19,
      "start": 10340.08,
      "end": 10351.08,
      "formatted_start": "02:52:20.080",
      "formatted_end": "02:52:31.080",
      "text": "بعد اینکه موقعا باشه از تهران رایزنی کردن در مورد شرکت ها اینها آقای خیلی قدیلی بود اینها ما باشیم صحبت کردن"
    },
    {
      "id": 20,
      "start": 10351.08,
      "end": 10361.08,
      "formatted_start": "02:52:31.080",
      "formatted_end": "02:52:41.080",
      "text": "ایشون بود طبق قانون 147 شرکت ها خب شما تو بازرس اشتباه کردید خب"
    },
    {
      "id": 21,
      "start": 10361.08,
      "end": 10366.08,
      "formatted_start": "02:52:41.080",
      "formatted_end": "02:52:46.080",
      "text": "بازرس نباید با اعضای حیط مدیره نسبت خونی نداشته باشه"
    },
    {
      "id": 22,
      "start": 10366.08,
      "end": 10373.08,
      "formatted_start": "02:52:46.080",
      "formatted_end": "02:52:53.080",
      "text": "در نتیجه بازرس اینکه انخواب کردیم باطله ولی اون اعضای حیط مدیره درسته"
    },
    {
      "id": 23,
      "start": 10373.08,
      "end": 10379.08,
      "formatted_start": "02:52:53.080",
      "formatted_end": "02:52:59.080",
      "text": "این نسبت خونی فقط به بازرس بر میگرده به اعضای حیط مدیره بر نمیگرده"
    },
    {
      "id": 24,
      "start": 10379.08,
      "end": 10385.08,
      "formatted_start": "02:52:59.080",
      "formatted_end": "02:53:05.080",
      "text": "یعنی شرکت مال بازرسه که بازرس با اونا ارتباط نداشته نه این با بازرس ها خب"
    },
    {
      "id": 25,
      "start": 10385.08,
      "end": 10392.38,
      "formatted_start": "02:53:05.080",
      "formatted_end": "02:53:12.380",
      "text": "در نتیجه شما اون بسا مجمع اعضای حیات مدیر سلی جاشه"
    },
    {
      "id": 26,
      "start": 10392.38,
      "end": 10396.12,
      "formatted_start": "02:53:12.380",
      "formatted_end": "02:53:16.120",
      "text": "بقیه حیات مدیره هم که اومده مدیر آمل اتخاب کرده"
    },
    {
      "id": 27,
      "start": 10396.12,
      "end": 10400.24,
      "formatted_start": "02:53:16.120",
      "formatted_end": "02:53:20.240",
      "text": "اونا مثلا مشکل نداره چون پرسات درسته حیات مدیره و"
    },
    {
      "id": 28,
      "start": 10400.24,
      "end": 10404.94,
      "formatted_start": "02:53:20.240",
      "formatted_end": "02:53:24.940",
      "text": "ولی شما بازرستونو باید یه جلسه فوقلاده بذارید"
    },
    {
      "id": 29,
      "start": 10404.94,
      "end": 10406.28,
      "formatted_start": "02:53:24.940",
      "formatted_end": "02:53:26.280",
      "text": "برای اتخاب بازرست"
    },
    {
      "id": 30,
      "start": 10406.28,
      "end": 10406.78,
      "formatted_start": "02:53:26.280",
      "formatted_end": "02:53:26.780",
      "text": "خوب"
    },
    {
      "id": 31,
      "start": 10406.78,
      "end": 10411.08,
      "formatted_start": "02:53:26.780",
      "formatted_end": "02:53:31.080",
      "text": "گفت صورت جلسه مثلا بینویسید که مجمع یوری شده و"
    },
    {
      "id": 32,
      "start": 10411.08,
      "end": 10413.56,
      "formatted_start": "02:53:31.080",
      "formatted_end": "02:53:33.560",
      "text": "اعضای حیات مدیره مشخص شده"
    },
    {
      "id": 33,
      "start": 10413.56,
      "end": 10416.78,
      "formatted_start": "02:53:33.560",
      "formatted_end": "02:53:36.780",
      "text": "مثلا رئیس حیگت مدیر نایق رئیس و مدیر آمیل کیاب"
    },
    {
      "id": 34,
      "start": 10416.78,
      "end": 10421.06,
      "formatted_start": "02:53:36.780",
      "formatted_end": "02:53:41.060",
      "text": "در جلسه بعدی که توسط حیگت مدیره انجام شده"
    },
    {
      "id": 35,
      "start": 10421.06,
      "end": 10423.4,
      "formatted_start": "02:53:41.060",
      "formatted_end": "02:53:43.400",
      "text": "این افراد چیزا مشخص شدن"
    },
    {
      "id": 36,
      "start": 10423.4,
      "end": 10428.36,
      "formatted_start": "02:53:43.400",
      "formatted_end": "02:53:48.360",
      "text": "ولی طبق قانون 147 شرکت ها"
    },
    {
      "id": 37,
      "start": 10428.36,
      "end": 10431.32,
      "formatted_start": "02:53:48.360",
      "formatted_end": "02:53:51.320",
      "text": "بازرس بسایی مشکل بوده"
    },
    {
      "id": 38,
      "start": 10431.32,
      "end": 10434.5,
      "formatted_start": "02:53:51.320",
      "formatted_end": "02:53:54.500",
      "text": "یعنی نسبت چیزی داشته با اعضای حیگت مدیره"
    },
    {
      "id": 39,
      "start": 10434.5,
      "end": 10436.7,
      "formatted_start": "02:53:54.500",
      "formatted_end": "02:53:56.700",
      "text": "ما در اولین فرصت"
    },
    {
      "id": 40,
      "start": 10436.7,
      "end": 10439.24,
      "formatted_start": "02:53:56.700",
      "formatted_end": "02:53:59.240",
      "text": "خب در ته مثلا تا 15 روز آینده"
    },
    {
      "id": 41,
      "start": 10439.24,
      "end": 10442.08,
      "formatted_start": "02:53:59.240",
      "formatted_end": "02:54:02.080",
      "text": "دو مرتبه جلسه فوقلاده برگزار می کنیم"
    },
    {
      "id": 42,
      "start": 10442.08,
      "end": 10444.08,
      "formatted_start": "02:54:02.080",
      "formatted_end": "02:54:04.080",
      "text": "و بازرس جدید رو اعلام می کنیم"
    },
    {
      "id": 43,
      "start": 10444.08,
      "end": 10446.08,
      "formatted_start": "02:54:04.080",
      "formatted_end": "02:54:06.080",
      "text": "این رو می توانید صفتش کنید"
    },
    {
      "id": 44,
      "start": 10448.08,
      "end": 10450.08,
      "formatted_start": "02:54:08.080",
      "formatted_end": "02:54:10.080",
      "text": "حالا"
    },
    {
      "id": 45,
      "start": 10450.08,
      "end": 10452.08,
      "formatted_start": "02:54:10.080",
      "formatted_end": "02:54:12.080",
      "text": "دقیقا شما یک زمان باشین"
    },
    {
      "id": 46,
      "start": 10452.08,
      "end": 10454.08,
      "formatted_start": "02:54:12.080",
      "formatted_end": "02:54:14.080",
      "text": "طبق همین درستش کنید"
    },
    {
      "id": 47,
      "start": 10454.08,
      "end": 10456.08,
      "formatted_start": "02:54:14.080",
      "formatted_end": "02:54:16.080",
      "text": "آخرش اضافه کنید"
    },
    {
      "id": 48,
      "start": 10456.08,
      "end": 10458.08,
      "formatted_start": "02:54:16.080",
      "formatted_end": "02:54:18.080",
      "text": "که بازرس ما چون طبق قانون"
    },
    {
      "id": 49,
      "start": 10458.08,
      "end": 10460.08,
      "formatted_start": "02:54:18.080",
      "formatted_end": "02:54:20.080",
      "text": "147 مشکل پیدا کرده"
    },
    {
      "id": 50,
      "start": 10460.08,
      "end": 10462.08,
      "formatted_start": "02:54:20.080",
      "formatted_end": "02:54:22.080",
      "text": "ما ظرف در"
    },
    {
      "id": 51,
      "start": 10462.08,
      "end": 10464.08,
      "formatted_start": "02:54:22.080",
      "formatted_end": "02:54:24.080",
      "text": "دوازده الى پونزده نوزه آینده"
    },
    {
      "id": 52,
      "start": 10464.08,
      "end": 10466.08,
      "formatted_start": "02:54:24.080",
      "formatted_end": "02:54:26.080",
      "text": "ما مجمع عمومی بردازار می کنیم"
    },
    {
      "id": 53,
      "start": 10466.08,
      "end": 10468.08,
      "formatted_start": "02:54:26.080",
      "formatted_end": "02:54:28.080",
      "text": "مجمع پوقراته که بازرس جدید رو"
    },
    {
      "id": 54,
      "start": 10468.08,
      "end": 10470.08,
      "formatted_start": "02:54:28.080",
      "formatted_end": "02:54:30.080",
      "text": "باید اعلام کنیم برای صفت شکل"
    },
    {
      "id": 55,
      "start": 10470.08,
      "end": 10500.0,
      "formatted_start": "02:54:30.080",
      "formatted_end": "02:55:00.000",
      "text": "بیایید بگیم با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با اینکه با این"
    }
  ],
