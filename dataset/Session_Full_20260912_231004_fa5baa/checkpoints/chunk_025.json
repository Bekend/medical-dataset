  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7508.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:08.000",
      "text": "گران اینجوری کبین میکنند، چرا شما فلان جزیره را انتخاب کردید برای اون مدیره کنید؟"
    },
    {
      "id": 1,
      "start": 7508.0,
      "end": 7517.0,
      "formatted_start": "02:05:08.000",
      "formatted_end": "02:05:17.000",
      "text": "چون خب همه همین جزیره را انتخاب می کنند، چرا شما میرید هوایی؟ چون همه هوایی میرند."
    },
    {
      "id": 2,
      "start": 7519.0,
      "end": 7523.0,
      "formatted_start": "02:05:19.000",
      "formatted_end": "02:05:23.000",
      "text": "چرا شما کیش میرید؟ چون همه کیش میرند."
    },
    {
      "id": 3,
      "start": 7523.0,
      "end": 7527.0,
      "formatted_start": "02:05:23.000",
      "formatted_end": "02:05:27.000",
      "text": "نمی کنیم چون همه کشون داره"
    },
    {
      "id": 4,
      "start": 7527.0,
      "end": 7542.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:42.000",
      "text": "هیچ کس نمیگه که من تحقیق کردم دیدم به لحاظ جسمانی یا به لحاظ ذهنی یا به لحاظ روانی آب و هوای فلان جزیره از سر مصبتر میرنه"
    },
    {
      "id": 5,
      "start": 7542.0,
      "end": 7545.0,
      "formatted_start": "02:05:42.000",
      "formatted_end": "02:05:45.000",
      "text": "که کسی نمی گفته فقط گفتم نمی گفت"
    },
    {
      "id": 6,
      "start": 7545.0,
      "end": 7547.0,
      "formatted_start": "02:05:45.000",
      "formatted_end": "02:05:47.000",
      "text": "نمی‌بینید چون"
    },
    {
      "id": 7,
      "start": 7547.0,
      "end": 7550.0,
      "formatted_start": "02:05:47.000",
      "formatted_end": "02:05:50.000",
      "text": "چرا این قضا را ترجیم می‌دی و اون قضا چون؟"
    },
    {
      "id": 8,
      "start": 7550.0,
      "end": 7555.0,
      "formatted_start": "02:05:50.000",
      "formatted_end": "02:05:55.000",
      "text": "معمولاً این قضا را اگر کشی دیگر را بزنند ترجیم می‌دن به بقیه قضاها"
    },
    {
      "id": 9,
      "start": 7555.0,
      "end": 7560.0,
      "formatted_start": "02:05:55.000",
      "formatted_end": "02:06:00.000",
      "text": "هیچ‌کار تحقیل نکردن که مواد مقصی و مقصی و مشهری این قضا"
    },
    {
      "id": 10,
      "start": 7560.0,
      "end": 7562.0,
      "formatted_start": "02:06:00.000",
      "formatted_end": "02:06:02.000",
      "text": "بیشتر از بقیه قضاهاست"
    },
    {
      "id": 11,
      "start": 7562.0,
      "end": 7566.0,
      "formatted_start": "02:06:02.000",
      "formatted_end": "02:06:06.000",
      "text": "یعنی این قضا مقصی‌تر، مقصی‌تر و مشهری‌تر"
    },
    {
      "id": 12,
      "start": 7566.0,
      "end": 7569.0,
      "formatted_start": "02:06:06.000",
      "formatted_end": "02:06:09.000",
      "text": "تحقیل می‌دونن نکردن"
    },
    {
      "id": 13,
      "start": 7569.0,
      "end": 7573.0,
      "formatted_start": "02:06:09.000",
      "formatted_end": "02:06:13.000",
      "text": "و به حمل تک چرا این رنگ لباس رو انتخاب کردی؟"
    },
    {
      "id": 14,
      "start": 7575.0,
      "end": 7580.86,
      "formatted_start": "02:06:15.000",
      "formatted_end": "02:06:20.860",
      "text": "به خاطر اینکه برای نگاه هایی که معطوبش میشه صادم تره"
    },
    {
      "id": 15,
      "start": 7580.86,
      "end": 7584.6,
      "formatted_start": "02:06:20.860",
      "formatted_end": "02:06:24.600",
      "text": "نور بهتری و صادم تری با صابونی بودن"
    },
    {
      "id": 16,
      "start": 7584.6,
      "end": 7590.24,
      "formatted_start": "02:06:24.600",
      "formatted_end": "02:06:30.240",
      "text": "میگم چون این لباس در تابستان بدن رو خونکتر نگهندرد به جهد قریکش"
    },
    {
      "id": 17,
      "start": 7590.24,
      "end": 7593.88,
      "formatted_start": "02:06:30.240",
      "formatted_end": "02:06:33.880",
      "text": "یا در زبستان جد بدن رو گردتر نگهندرد"
    },
    {
      "id": 18,
      "start": 7593.88,
      "end": 7595.68,
      "formatted_start": "02:06:33.880",
      "formatted_end": "02:06:35.680",
      "text": "این رو تحریم نکردم"
    },
    {
      "id": 19,
      "start": 7595.68,
      "end": 7599.94,
      "formatted_start": "02:06:35.680",
      "formatted_end": "02:06:39.940",
      "text": "میگم چون گیگرانم این لباس رو ترجیم دهم"
    },
    {
      "id": 20,
      "start": 7599.94,
      "end": 7601.94,
      "formatted_start": "02:06:39.940",
      "formatted_end": "02:06:41.940",
      "text": "این رنگ رو ترجیم دهم"
    },
    {
      "id": 21,
      "start": 7601.94,
      "end": 7606.84,
      "formatted_start": "02:06:41.940",
      "formatted_end": "02:06:46.840",
      "text": "و به همین ترتیب در قابل هر خورد و کنان زندگی اینجوری هست"
    },
    {
      "id": 22,
      "start": 7606.84,
      "end": 7611.62,
      "formatted_start": "02:06:46.840",
      "formatted_end": "02:06:51.620",
      "text": "و بنابراین اصلا نازر زندگی نیستم"
    },
    {
      "id": 23,
      "start": 7611.62,
      "end": 7612.74,
      "formatted_start": "02:06:51.620",
      "formatted_end": "02:06:52.740",
      "text": "نگاه نمی کنم"
    },
    {
      "id": 24,
      "start": 7612.74,
      "end": 7614.68,
      "formatted_start": "02:06:52.740",
      "formatted_end": "02:06:54.680",
      "text": "اصلا خودم نمی توستم"
    },
    {
      "id": 25,
      "start": 7614.68,
      "end": 7617.14,
      "formatted_start": "02:06:54.680",
      "formatted_end": "02:06:57.140",
      "text": "که چرا این کار رو کردی"
    },
    {
      "id": 26,
      "start": 7617.14,
      "end": 7618.36,
      "formatted_start": "02:06:57.140",
      "formatted_end": "02:06:58.360",
      "text": "یا اون کار رو"
    },
    {
      "id": 27,
      "start": 7618.36,
      "end": 7625.38,
      "formatted_start": "02:06:58.360",
      "formatted_end": "02:07:05.380",
      "text": "حالا تنفلش و بیزاریش از مردمان"
    },
    {
      "id": 28,
      "start": 7625.38,
      "end": 7627.3,
      "formatted_start": "02:07:05.380",
      "formatted_end": "02:07:07.300",
      "text": "این به اینه"
    },
    {
      "id": 29,
      "start": 7627.3,
      "end": 7628.94,
      "formatted_start": "02:07:07.300",
      "formatted_end": "02:07:08.940",
      "text": "البته خطایی داره"
    },
    {
      "id": 30,
      "start": 7628.94,
      "end": 7631.28,
      "formatted_start": "02:07:08.940",
      "formatted_end": "02:07:11.280",
      "text": "که حالا به اون خطاش کار ندارم"
    },
    {
      "id": 31,
      "start": 7631.28,
      "end": 7633.42,
      "formatted_start": "02:07:11.280",
      "formatted_end": "02:07:13.420",
      "text": "ولی به هر حال این رو میبینه"
    },
    {
      "id": 32,
      "start": 7633.42,
      "end": 7635.96,
      "formatted_start": "02:07:13.420",
      "formatted_end": "02:07:15.960",
      "text": "میبینه چه این رو فقط مثل رمه ها"
    },
    {
      "id": 33,
      "start": 7635.96,
      "end": 7638.58,
      "formatted_start": "02:07:15.960",
      "formatted_end": "02:07:18.580",
      "text": "دارن به دنبال یک دیگر بیدمن"
    },
    {
      "id": 34,
      "start": 7638.58,
      "end": 7641.96,
      "formatted_start": "02:07:18.580",
      "formatted_end": "02:07:21.960",
      "text": "هر کدامشون به جهتی به این راه میده"
    },
    {
      "id": 35,
      "start": 7641.96,
      "end": 7643.38,
      "formatted_start": "02:07:21.960",
      "formatted_end": "02:07:23.380",
      "text": "که دیگر هم به این جهت میدن"
    },
    {
      "id": 36,
      "start": 7643.38,
      "end": 7645.78,
      "formatted_start": "02:07:23.380",
      "formatted_end": "02:07:25.780",
      "text": "اون دیگری هم به این جهت به این راه میده"
    },
    {
      "id": 37,
      "start": 7645.78,
      "end": 7647.6,
      "formatted_start": "02:07:25.780",
      "formatted_end": "02:07:27.600",
      "text": "که دیگر هم به این جهت میدن"
    },
    {
      "id": 38,
      "start": 7647.6,
      "end": 7650.86,
      "formatted_start": "02:07:27.600",
      "formatted_end": "02:07:30.860",
      "text": "و خلاصه همه ما نمیفردیم از که تبعیت میکنیم"
    },
    {
      "id": 39,
      "start": 7650.86,
      "end": 7652.28,
      "formatted_start": "02:07:30.860",
      "formatted_end": "02:07:32.280",
      "text": "از که تقنیم میکنیم"
    },
    {
      "id": 40,
      "start": 7652.28,
      "end": 7654.2,
      "formatted_start": "02:07:32.280",
      "formatted_end": "02:07:34.200",
      "text": "روسته"
    },
    {
      "id": 41,
      "start": 7654.2,
      "end": 7657.64,
      "formatted_start": "02:07:34.200",
      "formatted_end": "02:07:37.640",
      "text": "حلر در واقع مسئلهش بر سر اینه"
    },
    {
      "id": 42,
      "start": 7657.64,
      "end": 7666.36,
      "formatted_start": "02:07:37.640",
      "formatted_end": "02:07:46.360",
      "text": "تو این قسمت اول تقسیم بندی که خودش رو هم نازر میدونه و هم آمل میدونه ولی دیگران رو فقط آمل میدونه"
    },
    {
      "id": 43,
      "start": 7666.36,
      "end": 7677.92,
      "formatted_start": "02:07:46.360",
      "formatted_end": "02:07:57.920",
      "text": "خب محض دیگران آمل باشن خب تب منی که نازرم کم کم کم کم ازشون فاصله میگیدم و این تنهایی هم به میجار کنیم"
    },
    {
      "id": 44,
      "start": 7677.92,
      "end": 7685.66,
      "formatted_start": "02:07:57.920",
      "formatted_end": "02:08:05.660",
      "text": "منی که تنها چون با تو که میشینم بعد از یک جلسه میبینم تو هم از هم برگید دلم از تو هم بیزنه"
    },
    {
      "id": 45,
      "start": 7685.66,
      "end": 7697.96,
      "formatted_start": "02:08:05.660",
      "formatted_end": "02:08:17.960",
      "text": "و بعد در جلسه بعدم با کسی دیگه میشینم و کم کم اینجا میبینم من باید دوری کنم از این جماعت رمییی که روز شده و این گله یک سانه ها"
    },
    {
      "id": 46,
      "start": 7697.96,
      "end": 7703.66,
      "formatted_start": "02:08:17.960",
      "formatted_end": "02:08:23.660",
      "text": "من موقع به طبعا نیست که پیون گله زندگی رو کنم میخوام یه جوردی که زندگی کنم"
    },
    {
      "id": 47,
      "start": 7704.68,
      "end": 7714.12,
      "formatted_start": "02:08:24.680",
      "formatted_end": "02:08:34.120",
      "text": "خب این مطلب خیلی مطلب جدیدیه یعنی میخوام میگم دوستان فکر نکنم این ادای روشن فکر بازی دارو بودن"
    },
    {
      "id": 48,
      "start": 7714.12,
      "end": 7721.84,
      "formatted_start": "02:08:34.120",
      "formatted_end": "02:08:41.840",
      "text": "وقعا اینکه دیده که ما اکثر زندگیمون رو داریم به طبعیت از دیگران انجام میدیم"
    },
    {
      "id": 49,
      "start": 7721.84,
      "end": 7726.4,
      "formatted_start": "02:08:41.840",
      "formatted_end": "02:08:46.400",
      "text": "و هیچ فکر نکردیم که اولا دیگران چی هست"
    },
    {
      "id": 50,
      "start": 7726.4,
      "end": 7730.12,
      "formatted_start": "02:08:46.400",
      "formatted_end": "02:08:50.120",
      "text": "و این نامونه کنیم ببینیم کسی نمیدیم"
    },
    {
      "id": 51,
      "start": 7730.86,
      "end": 7732.3,
      "formatted_start": "02:08:50.860",
      "formatted_end": "02:08:52.300",
      "text": "و دیگران صرف هست"
    },
    {
      "id": 52,
      "start": 7732.3,
      "end": 7737.12,
      "formatted_start": "02:08:52.300",
      "formatted_end": "02:08:57.120",
      "text": "یکی دیگران فرض میکنه و دیگران یک کسانی باشن که"
    },
    {
      "id": 53,
      "start": 7737.88,
      "end": 7742.08,
      "formatted_start": "02:08:57.880",
      "formatted_end": "02:09:02.080",
      "text": "بشه بر هم انگوشت اشاره به طرفشون گرفت"
    },
    {
      "id": 54,
      "start": 7742.08,
      "end": 7746.2,
      "formatted_start": "02:09:02.080",
      "formatted_end": "02:09:06.200",
      "text": "و گفت این که ازش تولیت رو کردم اونو که ازش تولیت نگردم"
    },
    {
      "id": 55,
      "start": 7746.2,
      "end": 7750.08,
      "formatted_start": "02:09:06.200",
      "formatted_end": "02:09:10.080",
      "text": "مخصوصا اونو که ازم باید تولیت کنی ازم دیگر یا دیگر"
    },
    {
      "id": 56,
      "start": 7750.08,
      "end": 7752.48,
      "formatted_start": "02:09:10.080",
      "formatted_end": "02:09:12.480",
      "text": "چرا؟"
    },
    {
      "id": 57,
      "start": 7752.48,
      "end": 7754.06,
      "formatted_start": "02:09:12.480",
      "formatted_end": "02:09:14.060",
      "text": "اما من حاله"
    },
    {
      "id": 58,
      "start": 7754.06,
      "end": 7758.8,
      "formatted_start": "02:09:14.060",
      "formatted_end": "02:09:18.800",
      "text": "که ناظرم به ذکر خودم رو بی جور عمل نمی کنم"
    },
    {
      "id": 59,
      "start": 7758.8,
      "end": 7762.6,
      "formatted_start": "02:09:18.800",
      "formatted_end": "02:09:22.600",
      "text": "و بنابراین جدا می شم از دیگر و تنها می شم از دیگر"
    },
    {
      "id": 60,
      "start": 7762.6,
      "end": 7765.52,
      "formatted_start": "02:09:22.600",
      "formatted_end": "02:09:25.520",
      "text": "اما تو مطلب دوم"
    },
    {
      "id": 61,
      "start": 7765.52,
      "end": 7768.14,
      "formatted_start": "02:09:25.520",
      "formatted_end": "02:09:28.140",
      "text": "تو مطلب دوم"
    },
    {
      "id": 62,
      "start": 7768.14,
      "end": 7771.5,
      "formatted_start": "02:09:28.140",
      "formatted_end": "02:09:31.500",
      "text": "بدیه کار من اینه که من حالی حاله"
    },
    {
      "id": 63,
      "start": 7771.5,
      "end": 7775.02,
      "formatted_start": "02:09:31.500",
      "formatted_end": "02:09:35.020",
      "text": "نمیتونم از معنوی یک چشم بگوشم"
    },
    {
      "id": 64,
      "start": 7775.02,
      "end": 7780.1,
      "formatted_start": "02:09:35.020",
      "formatted_end": "02:09:40.100",
      "text": "نمیتونم از شهرون بگوشم"
    },
    {
      "id": 65,
      "start": 7780.1,
      "end": 7784.94,
      "formatted_start": "02:09:40.100",
      "formatted_end": "02:09:44.940",
      "text": "درست خیلی سعی میکنم معنوی زندگی کنم"
    },
    {
      "id": 66,
      "start": 7784.94,
      "end": 7789.22,
      "formatted_start": "02:09:44.940",
      "formatted_end": "02:09:49.220",
      "text": "ولی فقط در رفتارم میجونم"
    },
    {
      "id": 67,
      "start": 7789.22,
      "end": 7791.72,
      "formatted_start": "02:09:49.220",
      "formatted_end": "02:09:51.720",
      "text": "در ذهنم میجونم نیستم"
    },
    {
      "id": 68,
      "start": 7791.72,
      "end": 7793.98,
      "formatted_start": "02:09:51.720",
      "formatted_end": "02:09:53.980",
      "text": "در زمیرم میجونم نیستم"
    },
    {
      "id": 69,
      "start": 7793.98,
      "end": 7796.64,
      "formatted_start": "02:09:53.980",
      "formatted_end": "02:09:56.640",
      "text": "بله در رفتارم من هر یاله"
    },
    {
      "id": 70,
      "start": 7796.64,
      "end": 7799.4,
      "formatted_start": "02:09:56.640",
      "formatted_end": "02:09:59.400",
      "text": "در رفتارم میجونم که سعی میکنم"
    }
  ],
  "status": "completed"
}