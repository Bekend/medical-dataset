  "stt_segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 20.0,
      "formatted_start": "00:00:00.000",
      "formatted_end": "00:00:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 30.0,
      "end": 36.0,
      "formatted_start": "00:00:30.000",
      "formatted_end": "00:00:36.000",
      "text": "و از اینجا پیش می کنید و یک آجر بود که آن را در اینجا بردارید."
    },
    {
      "id": 2,
      "start": 36.0,
      "end": 39.0,
      "formatted_start": "00:00:36.000",
      "formatted_end": "00:00:39.000",
      "text": "شما در یک جا من اینجا بودم."
    },
    {
      "id": 3,
      "start": 39.0,
      "end": 43.0,
      "formatted_start": "00:00:39.000",
      "formatted_end": "00:00:43.000",
      "text": "اینجا مردم شانه که با تور دارید، از اینجا با در اینجا برداریم."
    },
    {
      "id": 4,
      "start": 43.0,
      "end": 46.0,
      "formatted_start": "00:00:43.000",
      "formatted_end": "00:00:46.000",
      "text": "من در اینجا تراغم ساختم، اینجا برای مردم برداریم."
    },
    {
      "id": 5,
      "start": 46.0,
      "end": 52.0,
      "formatted_start": "00:00:46.000",
      "formatted_end": "00:00:52.000",
      "text": "ولی استفاده نیستن، از این مورد را پیش می کنید، جا را برسید، با اینکه این مورد را برسید،"
    },
    {
      "id": 6,
      "start": 52.0,
      "end": 60.0,
      "formatted_start": "00:00:52.000",
      "formatted_end": "00:01:00.000",
      "text": "30 میلو پر، 50 میلو برسید، و از این تایی آن را پیش می کنید،"
    },
    {
      "id": 7,
      "start": 60.0,
      "end": 63.0,
      "formatted_start": "00:01:00.000",
      "formatted_end": "00:01:03.000",
      "text": "پیش می کنید، برسید، پیش می کنید، و از این تایی آن را برسید، برسید،"
    },
    {
      "id": 8,
      "start": 63.0,
      "end": 66.0,
      "formatted_start": "00:01:03.000",
      "formatted_end": "00:01:06.000",
      "text": "و از این تایی آن را برسید، برسید، و از این تایی آن را برسید، برسید،"
    },
    {
      "id": 9,
      "start": 66.0,
      "end": 70.0,
      "formatted_start": "00:01:06.000",
      "formatted_end": "00:01:10.000",
      "text": "اینجوری همه چیزی همه چیزی که باید بگیرند که همین رو بگیرند"
    },
    {
      "id": 10,
      "start": 70.0,
      "end": 72.0,
      "formatted_start": "00:01:10.000",
      "formatted_end": "00:01:12.000",
      "text": "همین رو همچنین نخواهید کنید"
    },
    {
      "id": 11,
      "start": 72.0,
      "end": 76.0,
      "formatted_start": "00:01:12.000",
      "formatted_end": "00:01:16.000",
      "text": "این پشت مال باشه که در این مال بیرون برگرده است"
    },
    {
      "id": 12,
      "start": 76.0,
      "end": 104.0,
      "formatted_start": "00:01:16.000",
      "formatted_end": "00:01:44.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 106.0,
      "end": 126.0,
      "formatted_start": "00:01:46.000",
      "formatted_end": "00:02:06.000",
      "text": "موسیقی"
    },
    {
