  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6330.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:30.000",
      "text": "از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از اینجا باید برداری کنید، از ا"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6338.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:38.000",
      "text": "یک سی بود از آدم ها از دیگر هم میتونن زندگی کنن و هم میتونن بگیرن"
    },
    {
      "id": 2,
      "start": 6338.0,
      "end": 6344.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:44.000",
      "text": "اون چیزی که صورات از ما میخواست اون چیزی که بودا از ما میخواست"
    },
    {
      "id": 3,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "اون چیزی که غیب آقی ها میخواستن از ما"
    },
    {
      "id": 4,
      "start": 6346.0,
      "end": 6353.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:53.000",
      "text": "گفتن یه جوری باشی که زندگی رو عاشقش باشی ولی مرد رو هم دوست بدی"
    },
    {
      "id": 5,
      "start": 6353.0,
      "end": 6363.0,
      "formatted_start": "01:45:53.000",
      "formatted_end": "01:46:03.000",
      "text": "جوری زندگی کنی که هم من وقتی به زندگی تو نگاه می کنم ببینم آشق زندگی و هم ببینم من رو هم دوستم"
    },
    {
      "id": 6,
      "start": 6363.0,
      "end": 6374.0,
      "formatted_start": "01:46:03.000",
      "formatted_end": "01:46:14.000",
      "text": "و این از طرز زندگی کردن آدمیان پیداست که فلانکه هست که البته کم این افراد میبینی فلانکه هست آشق زندگیه"
    },
    {
      "id": 7,
      "start": 6374.0,
      "end": 6378.0,
      "formatted_start": "01:46:14.000",
      "formatted_end": "01:46:18.000",
      "text": "ولی من رو هم دوستم"
    },
    {
      "id": 8,
      "start": 6378.0,
      "end": 6387.0,
      "formatted_start": "01:46:18.000",
      "formatted_end": "01:46:27.000",
      "text": "مردم دوست داریم. البته در اینجا توجه میکنید که تکیه بیشتر عشق و دوستی ها."
    },
    {
      "id": 9,
      "start": 6387.0,
      "end": 6393.0,
      "formatted_start": "01:46:27.000",
      "formatted_end": "01:46:33.000",
      "text": "بازم ببینید کفه چی؟ سنگی تره؟ کفه زندگی سنگی تره؟ بگیم آشق زندگیه."
    },
    {
      "id": 10,
      "start": 6393.0,
      "end": 6399.0,
      "formatted_start": "01:46:33.000",
      "formatted_end": "01:46:39.000",
      "text": "ولی مردم دوست داریم. نفرت نداره از دوست. از مرد. شیعه از مرد نداره."
    },
    {
      "id": 11,
      "start": 6399.0,
      "end": 6405.0,
      "formatted_start": "01:46:39.000",
      "formatted_end": "01:46:45.000",
      "text": "بیزار نیست از مرد. خشبود از مرد. این ها دسته سه موقع هستند."
    },
    {
      "id": 12,
      "start": 6405.0,
      "end": 6413.0,
      "formatted_start": "01:46:45.000",
      "formatted_end": "01:46:53.000",
      "text": "و این ها کسان هستند که میتونند هزار سال در آلم زندگی کنند و خنده همونه یادند"
    },
    {
      "id": 13,
      "start": 6413.0,
      "end": 6424.0,
      "formatted_start": "01:46:53.000",
      "formatted_end": "01:47:04.000",
      "text": "از اون طرف هم میتونند هر وقت مرگشون رسید چه در بیست سالگی بلسته چه در هزار سالگی میتونند از مرگم استقبال مونند و درخواه نموشده"
    },
    {
      "id": 14,
      "start": 6424.0,
      "end": 6434.0,
      "formatted_start": "01:47:04.000",
      "formatted_end": "01:47:14.000",
      "text": "این دسته استفاده مقابلت تعدادشون به آزمایی مورد خیلی در دیگران بکنند ولی هستند آدم ها اینجوری کنند"
    },
    {
      "id": 15,
      "start": 6434.0,
      "end": 6442.3,
      "formatted_start": "01:47:14.000",
      "formatted_end": "01:47:22.300",
      "text": "که دست چهار متصبر نیست که بگیرون نمیتونن زندگی کنن و نمیتونن بمیرن"
    },
    {
      "id": 16,
      "start": 6442.3,
      "end": 6450.46,
      "formatted_start": "01:47:22.300",
      "formatted_end": "01:47:30.460",
      "text": "پس ما از لحاظ این تقسیم چهارمان به سه دست تقسیم میشیم"
    },
    {
      "id": 17,
      "start": 6450.46,
      "end": 6456.46,
      "formatted_start": "01:47:30.460",
      "formatted_end": "01:47:36.460",
      "text": "کسانی که نمیتونن زندگی کنن ببخشیم میتونن زندگی کنن ولی نمیتونن بمیرن"
    },
    {
      "id": 18,
      "start": 6456.46,
      "end": 6464.12,
      "formatted_start": "01:47:36.460",
      "formatted_end": "01:47:44.120",
      "text": "کسانی که اینا نه میتونن ببینن اما نمیتونن زندگی کنن"
    },
    {
      "id": 19,
      "start": 6464.12,
      "end": 6468.0,
      "formatted_start": "01:47:44.120",
      "formatted_end": "01:47:48.000",
      "text": "اینا اینایی هم که به قوت دلشون رو خودخوشی کنن"
    },
    {
      "id": 20,
      "start": 6468.0,
      "end": 6472.12,
      "formatted_start": "01:47:48.000",
      "formatted_end": "01:47:52.120",
      "text": "حالا چه به فعال خودخوشی کنن یا به خاطر ممانعی نمیدونن"
    },
    {
      "id": 21,
      "start": 6472.12,
      "end": 6479.44,
      "formatted_start": "01:47:52.120",
      "formatted_end": "01:47:59.440",
      "text": "باید در سلسه مرکز هایی هستن که هم میتونن زندگی کنن و هم میتونن ببینن"
    },
    {
      "id": 22,
      "start": 6479.44,
      "end": 6482.64,
      "formatted_start": "01:47:59.440",
      "formatted_end": "01:48:02.640",
      "text": "هر دو براشون مطلوبه"
    },
    {
      "id": 23,
      "start": 6482.64,
      "end": 6487.64,
      "formatted_start": "01:48:02.640",
      "formatted_end": "01:48:07.640",
      "text": "ممکنه زندگی براشون مطلوب تر از مرگم باشه"
    },
    {
      "id": 24,
      "start": 6487.64,
      "end": 6490.64,
      "formatted_start": "01:48:07.640",
      "formatted_end": "01:48:10.640",
      "text": "اما مرگم براشون مطلوبه"
    },
    {
      "id": 25,
      "start": 6490.64,
      "end": 6492.64,
      "formatted_start": "01:48:10.640",
      "formatted_end": "01:48:12.640",
      "text": "نامطلوب نیست"
    },
    {
      "id": 26,
      "start": 6492.64,
      "end": 6494.64,
      "formatted_start": "01:48:12.640",
      "formatted_end": "01:48:14.640",
      "text": "قدرت هر دو رو دارن"
    },
    {
      "id": 27,
      "start": 6494.64,
      "end": 6498.64,
      "formatted_start": "01:48:14.640",
      "formatted_end": "01:48:18.640",
      "text": "بنابراین از هر دو در واقع خوشی میبینن"
    },
    {
      "id": 28,
      "start": 6498.64,
      "end": 6501.64,
      "formatted_start": "01:48:18.640",
      "formatted_end": "01:48:21.640",
      "text": "از هر دو با ناخوشی مماجه نمیشه"
    },
    {
      "id": 29,
      "start": 6501.64,
      "end": 6504.64,
      "formatted_start": "01:48:21.640",
      "formatted_end": "01:48:24.640",
      "text": "این رو خدمت برنام دسته یه"
    },
    {
      "id": 30,
      "start": 6504.64,
      "end": 6506.64,
      "formatted_start": "01:48:24.640",
      "formatted_end": "01:48:26.640",
      "text": "سه مومن"
    },
    {
      "id": 31,
      "start": 6506.64,
      "end": 6508.64,
      "formatted_start": "01:48:26.640",
      "formatted_end": "01:48:28.640",
      "text": "دسته یه چهارم هم گفتیم نداریم"
    },
    {
      "id": 32,
      "start": 6508.64,
      "end": 6510.64,
      "formatted_start": "01:48:28.640",
      "formatted_end": "01:48:30.640",
      "text": "خب"
    },
    {
      "id": 33,
      "start": 6510.64,
      "end": 6514.02,
      "formatted_start": "01:48:30.640",
      "formatted_end": "01:48:34.020",
      "text": "حالا این تقسیم من دیچه ها رو که هم بگیم"
    },
    {
      "id": 34,
      "start": 6514.02,
      "end": 6521.22,
      "formatted_start": "01:48:34.020",
      "formatted_end": "01:48:41.220",
      "text": "اگر شما بخواید در این زندگی"
    },
    {
      "id": 35,
      "start": 6521.22,
      "end": 6526.08,
      "formatted_start": "01:48:41.220",
      "formatted_end": "01:48:46.080",
      "text": "در این زندگی که الان داریم"
    },
    {
      "id": 36,
      "start": 6526.08,
      "end": 6531.92,
      "formatted_start": "01:48:46.080",
      "formatted_end": "01:48:51.920",
      "text": "اگر بخواید در این زندگی بگیم"
    },
    {
      "id": 37,
      "start": 6531.92,
      "end": 6533.78,
      "formatted_start": "01:48:51.920",
      "formatted_end": "01:48:53.780",
      "text": "بدتر زندگی رو که"
    },
    {
      "id": 38,
      "start": 6533.78,
      "end": 6543.5,
      "formatted_start": "01:48:53.780",
      "formatted_end": "01:49:03.500",
      "text": "ناخوشاینتر زندگی رو کهی کنی؟"
    },
    {
      "id": 39,
      "start": 6543.5,
      "end": 6545.72,
      "formatted_start": "01:49:03.500",
      "formatted_end": "01:49:05.720",
      "text": "و جوابشی"
    },
    {
      "id": 40,
      "start": 6545.72,
      "end": 6549.86,
      "formatted_start": "01:49:05.720",
      "formatted_end": "01:49:09.860",
      "text": "کسی ناخوشاینتر زندگی رو می کنه"
    },
    {
      "id": 41,
      "start": 6549.86,
      "end": 6552.82,
      "formatted_start": "01:49:09.860",
      "formatted_end": "01:49:12.820",
      "text": "که به لحاظ تقسیم بندی اول"
    },
    {
      "id": 42,
      "start": 6552.82,
      "end": 6556.72,
      "formatted_start": "01:49:12.820",
      "formatted_end": "01:49:16.720",
      "text": "یعنی به لحاظ این که آهی نازل زندگیه"
    },
    {
      "id": 43,
      "start": 6556.72,
      "end": 6559.12,
      "formatted_start": "01:49:16.720",
      "formatted_end": "01:49:19.120",
      "text": "و آمل زندگی"
    },
    {
      "id": 44,
      "start": 6559.12,
      "end": 6563.18,
      "formatted_start": "01:49:19.120",
      "formatted_end": "01:49:23.180",
      "text": "یا فقط آمل زندگیه"
    },
    {
      "id": 45,
      "start": 6563.18,
      "end": 6569.58,
      "formatted_start": "01:49:23.180",
      "formatted_end": "01:49:29.580",
      "text": "اونی که در زندگی فقط آمن نیست"
    },
    {
      "id": 46,
      "start": 6569.58,
      "end": 6574.64,
      "formatted_start": "01:49:29.580",
      "formatted_end": "01:49:34.640",
      "text": "علاوه بر آمن بودن نازر هم هست"
    },
    {
      "id": 47,
      "start": 6574.64,
      "end": 6580.38,
      "formatted_start": "01:49:34.640",
      "formatted_end": "01:49:40.380",
      "text": "در تقسیم بندی دو گروه"
    },
    {
      "id": 48,
      "start": 6580.38,
      "end": 6584.88,
      "formatted_start": "01:49:40.380",
      "formatted_end": "01:49:44.880",
      "text": "که اهل شهرانیت و اهل معنویت"
    },
    {
      "id": 49,
      "start": 6584.88,
      "end": 6586.96,
      "formatted_start": "01:49:44.880",
      "formatted_end": "01:49:46.960",
      "text": "و اهل مغنویت و اهل مغنویت"
    },
    {
      "id": 50,
      "start": 6586.96,
      "end": 6593.0,
      "formatted_start": "01:49:46.960",
      "formatted_end": "01:49:53.000",
      "text": "این آدم نه معنویت"
    },
    {
      "id": 51,
      "start": 6593.0,
      "end": 6600.0,
      "formatted_start": "01:49:53.000",
      "formatted_end": "01:50:00.000",
      "text": "هم شهابان باشه و هم معنی باشه بلدر رو دوست داریم"
    }
  ],
  "status": "completed"
}