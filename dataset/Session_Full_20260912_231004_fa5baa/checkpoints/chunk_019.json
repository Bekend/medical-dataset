  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5702.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:02.000",
      "text": "چه باید کرد و چه نباید کرد."
    },
    {
      "id": 1,
      "start": 5704.0,
      "end": 5715.0,
      "formatted_start": "01:35:04.000",
      "formatted_end": "01:35:15.000",
      "text": "خب، به حال، پس کسانی هستن که زندگی رو معنادار میابند و کسانی هستن که زندگی رو بیمعناد میابند با روایتهای مختلف بیمعنادی."
    },
    {
      "id": 2,
      "start": 5719.0,
      "end": 5723.0,
      "formatted_start": "01:35:19.000",
      "formatted_end": "01:35:23.000",
      "text": "خب، به این لحاظم، انسانها به دو دسته قابل تقسیمن."
    },
    {
      "id": 3,
      "start": 5723.0,
      "end": 5728.0,
      "formatted_start": "01:35:23.000",
      "formatted_end": "01:35:28.000",
      "text": "کسانی که زندگی رو معنادار میابند و کسانی که زندگی رو بیمعناد میابند."
    },
    {
      "id": 4,
      "start": 5728.0,
      "end": 5733.0,
      "formatted_start": "01:35:28.000",
      "formatted_end": "01:35:33.000",
      "text": "دقیقا دوست دارید که در اینجا موردم از معنا ارزش بود"
    },
    {
      "id": 5,
      "start": 5733.0,
      "end": 5737.0,
      "formatted_start": "01:35:33.000",
      "formatted_end": "01:35:37.000",
      "text": "چون گاهی وقتی بحث معنای زندگی میشه هدف زندگی موردی"
    },
    {
      "id": 6,
      "start": 5737.0,
      "end": 5740.0,
      "formatted_start": "01:35:37.000",
      "formatted_end": "01:35:40.000",
      "text": "اون اینجا هدف زندگی معنی بحث من بود"
    },
    {
      "id": 7,
      "start": 5740.0,
      "end": 5745.0,
      "formatted_start": "01:35:40.000",
      "formatted_end": "01:35:45.000",
      "text": "گاهی وقتی من موردم از معنای زندگی کارچرد زندگی"
    },
    {
      "id": 8,
      "start": 5745.0,
      "end": 5747.0,
      "formatted_start": "01:35:45.000",
      "formatted_end": "01:35:47.000",
      "text": "اونم معنی بحث من نیست در اینجا"
    },
    {
      "id": 9,
      "start": 5747.0,
      "end": 5752.0,
      "formatted_start": "01:35:47.000",
      "formatted_end": "01:35:52.000",
      "text": "من موردم از معنای زندگی در اینجا ارزش زندگی"
    },
    {
      "id": 10,
      "start": 5752.0,
      "end": 5759.46,
      "formatted_start": "01:35:52.000",
      "formatted_end": "01:35:59.460",
      "text": "یعنی زیستن آیا ارزشمنده؟ می‌ارزه ما زندگی بکنیم یا نمی‌ارزه ما زندگی بکنیم؟"
    },
    {
      "id": 11,
      "start": 5759.46,
      "end": 5764.12,
      "formatted_start": "01:35:59.460",
      "formatted_end": "01:36:04.120",
      "text": "خب اگر همه‌چی دستوش تصادم باشه زندگی چه ارزشی باید باشه؟"
    },
    {
      "id": 12,
      "start": 5764.12,
      "end": 5769.9,
      "formatted_start": "01:36:04.120",
      "formatted_end": "01:36:09.900",
      "text": "و اگر ارزش‌ها هیچ اعتباری نداشتی باشن غیر از قراردادهای ما"
    },
    {
      "id": 13,
      "start": 5769.9,
      "end": 5773.98,
      "formatted_start": "01:36:09.900",
      "formatted_end": "01:36:13.980",
      "text": "خب این زندگی که ما بر اساس این قراردادها می‌کنیم چه ارزشی داره؟"
    },
    {
      "id": 14,
      "start": 5773.98,
      "end": 5778.98,
      "formatted_start": "01:36:13.980",
      "formatted_end": "01:36:18.980",
      "text": "چون قرارات دارا اگه عوض هم بکنیم زندگی هیچ قرار نکردیم که همه نکردیم"
    },
    {
      "id": 15,
      "start": 5778.98,
      "end": 5785.98,
      "formatted_start": "01:36:18.980",
      "formatted_end": "01:36:25.980",
      "text": "خب این هم در واقع تقسیم مالیه سه ملتی است از انسانها"
    },
    {
      "id": 16,
      "start": 5785.98,
      "end": 5790.98,
      "formatted_start": "01:36:25.980",
      "formatted_end": "01:36:30.980",
      "text": "یک تقسیم مالیه چهارمه از انسانها میشه داشت"
    },
    {
      "id": 17,
      "start": 5790.98,
      "end": 5793.98,
      "formatted_start": "01:36:30.980",
      "formatted_end": "01:36:33.980",
      "text": "در اون تقسیم مالیه این است"
    },
    {
      "id": 18,
      "start": 5793.98,
      "end": 5796.98,
      "formatted_start": "01:36:33.980",
      "formatted_end": "01:36:36.980",
      "text": "ما بعضی مولیم"
    },
    {
      "id": 19,
      "start": 5796.98,
      "end": 5799.98,
      "formatted_start": "01:36:36.980",
      "formatted_end": "01:36:39.980",
      "text": "می توانیم زندگی کنیم"
    },
    {
      "id": 20,
      "start": 5799.98,
      "end": 5805.98,
      "formatted_start": "01:36:39.980",
      "formatted_end": "01:36:45.980",
      "text": "اما نمی توانیم بمیریم به این معناکه"
    },
    {
      "id": 21,
      "start": 5805.98,
      "end": 5812.98,
      "formatted_start": "01:36:45.980",
      "formatted_end": "01:36:52.980",
      "text": "ما از زندگی خوشمون می آمیم"
    },
    {
      "id": 22,
      "start": 5812.98,
      "end": 5815.98,
      "formatted_start": "01:36:52.980",
      "formatted_end": "01:36:55.980",
      "text": "از زندگی خوشمون می آمیم"
    },
    {
      "id": 23,
      "start": 5815.98,
      "end": 5819.98,
      "formatted_start": "01:36:55.980",
      "formatted_end": "01:36:59.980",
      "text": "اما به شدت وحشت داریم از موردن"
    },
    {
      "id": 24,
      "start": 5819.98,
      "end": 5823.98,
      "formatted_start": "01:36:59.980",
      "formatted_end": "01:37:03.980",
      "text": "و به نامورده نمیتونیم بمیریم"
    },
    {
      "id": 25,
      "start": 5823.98,
      "end": 5828.98,
      "formatted_start": "01:37:03.980",
      "formatted_end": "01:37:08.980",
      "text": "دیگه به جبر فیزیولوژی و بیولوژی نمیمونیم"
    },
    {
      "id": 26,
      "start": 5828.98,
      "end": 5833.98,
      "formatted_start": "01:37:08.980",
      "formatted_end": "01:37:13.980",
      "text": "فقط ما تقوی مواجه با مرد رو نداریم"
    },
    {
      "id": 27,
      "start": 5833.98,
      "end": 5836.98,
      "formatted_start": "01:37:13.980",
      "formatted_end": "01:37:16.980",
      "text": "خیلی وحشتناکه برای ما مرد"
    },
    {
      "id": 28,
      "start": 5836.98,
      "end": 5840.98,
      "formatted_start": "01:37:16.980",
      "formatted_end": "01:37:20.980",
      "text": "حراسنگیزه برای ما و میترسیم از مرد"
    },
    {
      "id": 29,
      "start": 5840.98,
      "end": 5844.98,
      "formatted_start": "01:37:20.980",
      "formatted_end": "01:37:24.980",
      "text": "یک سال اینجا بیاریم"
    },
    {
      "id": 30,
      "start": 5844.98,
      "end": 5848.98,
      "formatted_start": "01:37:24.980",
      "formatted_end": "01:37:28.980",
      "text": "یک سالی هستن که برعکس این"
    },
    {
      "id": 31,
      "start": 5848.98,
      "end": 5852.98,
      "formatted_start": "01:37:28.980",
      "formatted_end": "01:37:32.980",
      "text": "نمیتونن زندگی کنن ولی میتونن بگوییم"
    },
    {
      "id": 32,
      "start": 5852.98,
      "end": 5855.98,
      "formatted_start": "01:37:32.980",
      "formatted_end": "01:37:35.980",
      "text": "اینا کسانی هستن که دست با ما رو کشی میزن"
    },
    {
      "id": 33,
      "start": 5855.98,
      "end": 5857.98,
      "formatted_start": "01:37:35.980",
      "formatted_end": "01:37:37.980",
      "text": "دیگه نمیتونه زمین کنه"
    },
    {
      "id": 34,
      "start": 5857.98,
      "end": 5859.98,
      "formatted_start": "01:37:37.980",
      "formatted_end": "01:37:39.980",
      "text": "بله میتونه"
    },
    {
      "id": 35,
      "start": 5859.98,
      "end": 5861.98,
      "formatted_start": "01:37:39.980",
      "formatted_end": "01:37:41.980",
      "text": "بچور میتونه بمیره"
    },
    {
      "id": 36,
      "start": 5861.98,
      "end": 5863.98,
      "formatted_start": "01:37:41.980",
      "formatted_end": "01:37:43.980",
      "text": "حالا البته"
    },
    {
      "id": 37,
      "start": 5863.98,
      "end": 5865.98,
      "formatted_start": "01:37:43.980",
      "formatted_end": "01:37:45.980",
      "text": "یک یک های دیگه"
    },
    {
      "id": 38,
      "start": 5885.98,
      "end": 5908.98,
      "formatted_start": "01:38:05.980",
      "formatted_end": "01:38:28.980",
      "text": "موسیقی"
    },
    {
      "id": 39,
      "start": 5908.98,
      "end": 5925.98,
      "formatted_start": "01:38:28.980",
      "formatted_end": "01:38:45.980",
      "text": "من گفتم که این دست هایی که ممکنه نمیتونن زندگی کنند ولی میتونند ببینند یعنی از مرک هیچ حراسی ندارند، هیچ ترسی ندارند، ممکنه به جهات دیگه ای دست به خودخوشی نزند."
    },
    {
      "id": 40,
      "start": 5925.98,
      "end": 5927.8,
      "formatted_start": "01:38:45.980",
      "formatted_end": "01:38:47.800",
      "text": "اما خب اون جهات دیگه ای داره"
    },
    {
      "id": 41,
      "start": 5927.8,
      "end": 5931.36,
      "formatted_start": "01:38:47.800",
      "formatted_end": "01:38:51.360",
      "text": "خودشون از مرگ ترسی ندارن"
    },
    {
      "id": 42,
      "start": 5931.36,
      "end": 5933.98,
      "formatted_start": "01:38:51.360",
      "formatted_end": "01:38:53.980",
      "text": "از مرگو حراسی ندارن"
    },
    {
      "id": 43,
      "start": 5934.82,
      "end": 5938.22,
      "formatted_start": "01:38:54.820",
      "formatted_end": "01:38:58.220",
      "text": "زندگی که باشون قیل قابل تحمله"
    },
    {
      "id": 44,
      "start": 5938.22,
      "end": 5939.96,
      "formatted_start": "01:38:58.220",
      "formatted_end": "01:38:59.960",
      "text": "زندگی رو نمیخوام"
    },
    {
      "id": 45,
      "start": 5939.96,
      "end": 5941.28,
      "formatted_start": "01:38:59.960",
      "formatted_end": "01:39:01.280",
      "text": "اما مرگو میخوام"
    },
    {
      "id": 46,
      "start": 5941.28,
      "end": 5944.48,
      "formatted_start": "01:39:01.280",
      "formatted_end": "01:39:04.480",
      "text": "اما خب لزومن به خودکش دسته میزنن"
    },
    {
      "id": 47,
      "start": 5944.48,
      "end": 5946.82,
      "formatted_start": "01:39:04.480",
      "formatted_end": "01:39:06.820",
      "text": "چون ممکنه موانه دیگه ای داشته باشن"
    },
    {
      "id": 48,
      "start": 5946.82,
      "end": 5950.46,
      "formatted_start": "01:39:06.820",
      "formatted_end": "01:39:10.460",
      "text": "موانهشون این نیست که از مرگو میترسن"
    },
    {
      "id": 49,
      "start": 5950.46,
      "end": 5951.98,
      "formatted_start": "01:39:10.460",
      "formatted_end": "01:39:11.980",
      "text": "موانه دیگه ای دارن"
    },
    {
      "id": 50,
      "start": 5952.62,
      "end": 5955.08,
      "formatted_start": "01:39:12.620",
      "formatted_end": "01:39:15.080",
      "text": "ممکنه موانه ایدیولوژیک داشته باشن"
    },
    {
      "id": 51,
      "start": 5955.08,
      "end": 5960.38,
      "formatted_start": "01:39:15.080",
      "formatted_end": "01:39:20.380",
      "text": "یعنی آن ایدئولوژی هستن که اون ایدئولوژی می که خودکشی نباید کرد"
    },
    {
      "id": 52,
      "start": 5960.38,
      "end": 5963.18,
      "formatted_start": "01:39:20.380",
      "formatted_end": "01:39:23.180",
      "text": "و پیرونی که خودکشی نکنند"
    },
    {
      "id": 53,
      "start": 5963.18,
      "end": 5966.08,
      "formatted_start": "01:39:23.180",
      "formatted_end": "01:39:26.080",
      "text": "ملکنه آمل دعومی در کار باشید"
    },
    {
      "id": 54,
      "start": 5966.82,
      "end": 5971.48,
      "formatted_start": "01:39:26.820",
      "formatted_end": "01:39:31.480",
      "text": "لبی کنید آمل دعومی با من که"
    },
    {
      "id": 55,
      "start": 5971.48,
      "end": 5972.88,
      "formatted_start": "01:39:31.480",
      "formatted_end": "01:39:32.880",
      "text": "عزیزانی دارند"
    },
    {
      "id": 56,
      "start": 5972.88,
      "end": 5976.44,
      "formatted_start": "01:39:32.880",
      "formatted_end": "01:39:36.440",
      "text": "که می دونند اگر خودکشی کنند"
    },
    {
      "id": 57,
      "start": 5976.44,
      "end": 5977.72,
      "formatted_start": "01:39:36.440",
      "formatted_end": "01:39:37.720",
      "text": "اون عزیزان"
    },
    {
      "id": 58,
      "start": 5977.72,
      "end": 5980.42,
      "formatted_start": "01:39:37.720",
      "formatted_end": "01:39:40.420",
      "text": "خودمون عزیزان"
    },
    {
      "id": 59,
      "start": 5980.42,
      "end": 5982.04,
      "formatted_start": "01:39:40.420",
      "formatted_end": "01:39:42.040",
      "text": "اینا"
    },
    {
      "id": 60,
      "start": 5985.08,
      "end": 5991.46,
      "formatted_start": "01:39:45.080",
      "formatted_end": "01:39:51.460",
      "text": "قریب دردونه ازش میشه زندگیشون وقتی که شخص خودشونی کشوری من حساب میکنن"
    },
    {
      "id": 61,
      "start": 5991.46,
      "end": 5999.98,
      "formatted_start": "01:39:51.460",
      "formatted_end": "01:39:59.980",
      "text": "که اگر خودمون میکنم از ریزانی هستم که هم یا بیشتر زندگی که اینها منو شد دردونه که غیر مامل تر"
    }
  ],
  "status": "completed"
}