      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 1,
      "start": 6030.0,
      "end": 6032.0,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:32.000",
      "text": "سلامت باشید"
    },
    {
      "id": 2,
      "start": 6032.0,
      "end": 6034.0,
      "formatted_start": "01:40:32.000",
      "formatted_end": "01:40:34.000",
      "text": "سلامت باشید"
    },
    {
      "id": 3,
      "start": 6034.0,
      "end": 6036.0,
      "formatted_start": "01:40:34.000",
      "formatted_end": "01:40:36.000",
      "text": "یه لحظه سلامت"
    },
    {
      "id": 4,
      "start": 6036.0,
      "end": 6038.0,
      "formatted_start": "01:40:36.000",
      "formatted_end": "01:40:38.000",
      "text": "چی هست رو باید جایی؟"
    },
    {
      "id": 5,
      "start": 6038.0,
      "end": 6040.0,
      "formatted_start": "01:40:38.000",
      "formatted_end": "01:40:40.000",
      "text": "آره تو موها بوی سراخونم"
    },
    {
      "id": 6,
      "start": 6040.0,
      "end": 6042.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:42.000",
      "text": "خوب"
    },
    {
      "id": 7,
      "start": 6042.0,
      "end": 6044.0,
      "formatted_start": "01:40:42.000",
      "formatted_end": "01:40:44.000",
      "text": "سبا میارو عذیب نمیشه"
    },
    {
      "id": 8,
      "start": 6044.0,
      "end": 6046.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:40:46.000",
      "text": "ببینم"
    },
    {
      "id": 9,
      "start": 6046.0,
      "end": 6048.0,
      "formatted_start": "01:40:46.000",
      "formatted_end": "01:40:48.000",
      "text": "این گذروفش میشه"
    },
    {
      "id": 10,
      "start": 6048.0,
      "end": 6050.0,
      "formatted_start": "01:40:48.000",
      "formatted_end": "01:40:50.000",
      "text": "رو ببینید"
    },
    {
      "id": 11,
      "start": 6050.0,
      "end": 6052.0,
      "formatted_start": "01:40:50.000",
      "formatted_end": "01:40:52.000",
      "text": "گذروف یه مدار"
    },
    {
      "id": 12,
      "start": 6052.0,
      "end": 6054.0,
      "formatted_start": "01:40:52.000",
      "formatted_end": "01:40:54.000",
      "text": "نسبت به پایی خوب چیستره"
    },
    {
      "id": 13,
      "start": 6054.0,
      "end": 6056.0,
      "formatted_start": "01:40:54.000",
      "formatted_end": "01:40:56.000",
      "text": "بگو گذروفه"
    },
    {
      "id": 14,
      "start": 6056.0,
      "end": 6058.0,
      "formatted_start": "01:40:56.000",
      "formatted_end": "01:40:58.000",
      "text": "بوی داله نیست"
    },
    {
      "id": 15,
      "start": 6058.0,
      "end": 6060.0,
      "formatted_start": "01:40:58.000",
      "formatted_end": "01:41:00.000",
      "text": "منبوردن نمیشه اینجا"
    },
    {
      "id": 16,
      "start": 6060.0,
      "end": 6062.0,
      "formatted_start": "01:41:00.000",
      "formatted_end": "01:41:02.000",
      "text": "ببینید سردسته"
    },
    {
      "id": 17,
      "start": 6062.0,
      "end": 6064.0,
      "formatted_start": "01:41:02.000",
      "formatted_end": "01:41:04.000",
      "text": "حرفایی که میزنی اصلا نمیشه زبانت کرده"
    },
    {
      "id": 18,
      "start": 6064.0,
      "end": 6067.0,
      "formatted_start": "01:41:04.000",
      "formatted_end": "01:41:07.000",
      "text": "مثلا نمیشه من بگم شاهد کشه شاید نشه"
    },
    {
      "id": 19,
      "start": 6067.0,
      "end": 6069.0,
      "formatted_start": "01:41:07.000",
      "formatted_end": "01:41:09.000",
      "text": "الان اون پایین هم اون پسورت موند کنه"
    },
    {
      "id": 20,
      "start": 6069.0,
      "end": 6071.0,
      "formatted_start": "01:41:09.000",
      "formatted_end": "01:41:11.000",
      "text": "بله بگم هر جایی"
    },
    {
      "id": 21,
      "start": 6071.0,
      "end": 6074.0,
      "formatted_start": "01:41:11.000",
      "formatted_end": "01:41:14.000",
      "text": "ببینید پزشکی دو دو تا چار تا نیست"
    },
    {
      "id": 22,
      "start": 6074.0,
      "end": 6077.0,
      "formatted_start": "01:41:14.000",
      "formatted_end": "01:41:17.000",
      "text": "آدم نمیدونی چه اتفاقی میفته"
    },
    {
      "id": 23,
      "start": 6077.0,
      "end": 6079.0,
      "formatted_start": "01:41:17.000",
      "formatted_end": "01:41:19.000",
      "text": "یه آمپول تقویتی میزنه"
    },
    {
      "id": 24,
      "start": 6079.0,
      "end": 6080.0,
      "formatted_start": "01:41:19.000",
      "formatted_end": "01:41:20.000",
      "text": "طرف میمیره"
    },
    {
      "id": 25,
      "start": 6080.0,
      "end": 6081.0,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:21.000",
      "text": "منبور مثال میزنه"
    },
    {
      "id": 26,
      "start": 6081.0,
      "end": 6083.0,
      "formatted_start": "01:41:21.000",
      "formatted_end": "01:41:23.000",
      "text": "یه که عمل جرای قلب رو باز میکنه"
    },
    {
      "id": 27,
      "start": 6088.0,
      "end": 6094.0,
      "formatted_start": "01:41:28.000",
      "formatted_end": "01:41:34.000",
      "text": "افتنام یک دو نفر افتنام فرمیده"
    },
    {
      "id": 28,
      "start": 6094.0,
      "end": 6100.0,
      "formatted_start": "01:41:34.000",
      "formatted_end": "01:41:40.000",
      "text": "اگر بگم افتنام نیست فرمیده باید برده باشم"
    },
    {
      "id": 29,
      "start": 6100.0,
      "end": 6106.0,
      "formatted_start": "01:41:40.000",
      "formatted_end": "01:41:46.000",
      "text": "افتنام نیست فرمیده باید برده باشم"
    },
    {
      "id": 30,
      "start": 6106.0,
      "end": 6112.0,
      "formatted_start": "01:41:46.000",
      "formatted_end": "01:41:52.000",
      "text": "افتنام نیست فرمیده باید برده باشم"
    },
    {
      "id": 31,
      "start": 6112.0,
      "end": 6119.0,
      "formatted_start": "01:41:52.000",
      "formatted_end": "01:41:59.000",
      "text": "مثلا رایت نمی کند گوشواره رو مثلا ما میگیم دو هفته بردار دو ماه دیگه بر میداره"
    },
    {
      "id": 32,
      "start": 6119.0,
      "end": 6120.0,
      "formatted_start": "01:41:59.000",
      "formatted_end": "01:42:00.000",
      "text": "بعد گفتونه میگه"
    },
    {
      "id": 33,
      "start": 6120.0,
      "end": 6124.0,
      "formatted_start": "01:42:00.000",
      "formatted_end": "01:42:04.000",
      "text": "نه موضوع میگه دیگه مشکلی برای گوشت ساختن نداره که"
    },
    {
      "id": 34,
      "start": 6124.0,
      "end": 6125.0,
      "formatted_start": "01:42:04.000",
      "formatted_end": "01:42:05.000",
      "text": "یه چی؟"
    },
    {
      "id": 35,
      "start": 6125.0,
      "end": 6128.0,
      "formatted_start": "01:42:05.000",
      "formatted_end": "01:42:08.000",
      "text": "جورو بازروفه موضوع مشکلی برای سراختن شما نداره؟"
    },
    {
      "id": 36,
      "start": 6128.0,
      "end": 6130.0,
      "formatted_start": "01:42:08.000",
      "formatted_end": "01:42:10.000",
      "text": "ما سراخت میکنیم"
    },
    {
      "id": 37,
      "start": 6130.0,
      "end": 6133.0,
      "formatted_start": "01:42:10.000",
      "formatted_end": "01:42:13.000",
      "text": "مریض یه مقدار درک سیادتر از پایین هست"
    },
    {
      "id": 38,
      "start": 6133.0,
      "end": 6134.0,
      "formatted_start": "01:42:13.000",
      "formatted_end": "01:42:14.000",
      "text": "بس بی ای سی هم بیزنیم؟"
    },
    {
      "id": 39,
      "start": 6134.0,
      "end": 6136.0,
      "formatted_start": "01:42:14.000",
      "formatted_end": "01:42:16.000",
      "text": "بی ای سی هم بیزنیم خود"
    },
    {
      "id": 40,
      "start": 6136.0,
      "end": 6140.0,
      "formatted_start": "01:42:16.000",
      "formatted_end": "01:42:20.000",
      "text": "و دیگه مثلا این که میگه اون پایین راحت تره"
    },
    {
      "id": 41,
      "start": 6140.0,
      "end": 6142.0,
      "formatted_start": "01:42:20.000",
      "formatted_end": "01:42:22.000",
      "text": "هر چی بیاد بالا سخت تره"
    },
    {
      "id": 42,
      "start": 6142.0,
      "end": 6143.0,
      "formatted_start": "01:42:22.000",
      "formatted_end": "01:42:23.000",
      "text": "سخت تره نه"
    },
    {
      "id": 43,
      "start": 6143.0,
      "end": 6145.0,
      "formatted_start": "01:42:23.000",
      "formatted_end": "01:42:25.000",
      "text": "آره ولی اونجوری نیست که نشه"
    },
    {
      "id": 44,
      "start": 6150.0,
      "end": 6153.0,
      "formatted_start": "01:42:30.000",
      "formatted_end": "01:42:33.000",
      "text": "هر جایی پیدا کنن یه سراخی"
    },
    {
      "id": 45,
      "start": 6153.0,
      "end": 6156.0,
      "formatted_start": "01:42:33.000",
      "formatted_end": "01:42:36.000",
      "text": "الان دیگه همه جا سراخ سراخ میشه دیگه"
    },
    {
      "id": 46,
      "start": 6156.0,
      "end": 6159.0,
      "formatted_start": "01:42:36.000",
      "formatted_end": "01:42:39.000",
      "text": "بابا شو گفت از جلد میشین نرون منو من دوست دارم"
    },
    {
      "id": 47,
      "start": 6159.0,
      "end": 6163.0,
      "formatted_start": "01:42:39.000",
      "formatted_end": "01:42:43.000",
      "text": "حالا دیگه چه وقتی که بچه حکوم کنه از سلطان"
    },
    {
      "id": 48,
      "start": 6163.0,
      "end": 6165.0,
      "formatted_start": "01:42:43.000",
      "formatted_end": "01:42:45.000",
      "text": "بالاتر حکوم میشه"
    },
    {
      "id": 49,
      "start": 6165.0,
      "end": 6167.0,
      "formatted_start": "01:42:45.000",
      "formatted_end": "01:42:47.000",
      "text": "نه اصلا بچه ها این دور زمانه"
    },
    {
      "id": 50,
      "start": 6167.0,
      "end": 6169.0,
      "formatted_start": "01:42:47.000",
      "formatted_end": "01:42:49.000",
      "text": "بچه ها برام منو بترسم منو منو نمیترسم"
    },
    {
      "id": 51,
      "start": 6169.0,
      "end": 6174.0,
      "formatted_start": "01:42:49.000",
      "formatted_end": "01:42:54.000",
      "text": "آمیدی من و دختر سنده بچه های قدیم گفتن دخترها موشن"
    },
    {
      "id": 52,
      "start": 6174.0,
      "end": 6176.0,
      "formatted_start": "01:42:54.000",
      "formatted_end": "01:42:56.000",
      "text": "مثل خدیر"
    },
    {
      "id": 53,
      "start": 6176.0,
      "end": 6178.0,
      "formatted_start": "01:42:56.000",
      "formatted_end": "01:42:58.000",
      "text": "هرم دخترها شیر هستند"
    },
    {
      "id": 54,
      "start": 6178.0,
      "end": 6179.0,
      "formatted_start": "01:42:58.000",
      "formatted_end": "01:42:59.000",
      "text": "نه"
    },
    {
      "id": 55,
      "start": 6179.0,
      "end": 6181.0,
      "formatted_start": "01:42:59.000",
      "formatted_end": "01:43:01.000",
      "text": "دستش هم شیر هستند"
    },
    {
      "id": 56,
      "start": 6181.0,
      "end": 6182.0,
      "formatted_start": "01:43:01.000",
      "formatted_end": "01:43:02.000",
      "text": "دخترها اون میشه"
    },
    {
      "id": 57,
      "start": 6182.0,
      "end": 6184.0,
      "formatted_start": "01:43:02.000",
      "formatted_end": "01:43:04.000",
      "text": "چرا بگم از این ها؟"
    },
    {
      "id": 58,
      "start": 6186.0,
      "end": 6187.0,
      "formatted_start": "01:43:06.000",
      "formatted_end": "01:43:07.000",
      "text": "یه وای درده هستند"
    },
    {
      "id": 59,
      "start": 6187.0,
      "end": 6188.0,
      "formatted_start": "01:43:07.000",
      "formatted_end": "01:43:08.000",
      "text": "از این از این قایم بیشتر"
    },
    {
      "id": 60,
      "start": 6188.0,
      "end": 6190.0,
      "formatted_start": "01:43:08.000",
      "formatted_end": "01:43:10.000",
      "text": "ولی اون درد نداره"
    },
    {
      "id": 61,
      "start": 6190.0,
      "end": 6194.0,
      "formatted_start": "01:43:10.000",
      "formatted_end": "01:43:14.000",
      "text": "دردش همیجا مثلا یه لذت درد میکنه"
    },
    {
      "id": 62,
      "start": 6194.0,
      "end": 6195.0,
      "formatted_start": "01:43:14.000",
      "formatted_end": "01:43:15.000",
      "text": "میگوزی تمام"
    },
    {
      "id": 63,
      "start": 6195.0,
      "end": 6198.0,
      "formatted_start": "01:43:15.000",
      "formatted_end": "01:43:18.000",
      "text": "یه هر چیزی برای هم"
    },
    {
      "id": 64,
      "start": 6198.0,
      "end": 6200.0,
      "formatted_start": "01:43:18.000",
      "formatted_end": "01:43:20.000",
      "text": "حتی اون افرادی هم خودتون سراخت کرده"
    },
    {
      "id": 65,
      "start": 6200.0,
      "end": 6201.0,
      "formatted_start": "01:43:20.000",
      "formatted_end": "01:43:21.000",
      "text": "آره آفرادی"
    },
    {
      "id": 66,
      "start": 6201.0,
      "end": 6202.0,
      "formatted_start": "01:43:21.000",
      "formatted_end": "01:43:22.000",
      "text": "چرا بگم؟"
    },
    {
      "id": 67,
      "start": 6202.0,
      "end": 6204.0,
      "formatted_start": "01:43:22.000",
      "formatted_end": "01:43:24.000",
      "text": "حالا تصمیم گیریتونو کنید دیگه"
    },
    {
      "id": 68,
      "start": 6204.0,
      "end": 6207.0,
      "formatted_start": "01:43:24.000",
      "formatted_end": "01:43:27.000",
      "text": "اصلا این ها دیویس فقط گوشواله شه"
    },
    {
      "id": 69,
      "start": 6207.0,
      "end": 6210.0,
      "formatted_start": "01:43:27.000",
      "formatted_end": "01:43:30.000",
      "text": "از خودش گوشواله داره او فونند میکنن"
    },
    {
      "id": 70,
      "start": 6210.0,
      "end": 6213.0,
      "formatted_start": "01:43:30.000",
      "formatted_end": "01:43:33.000",
      "text": "خواره من این دو هفته با این گوشواله هایی که ما میزنیم"
    },
    {
      "id": 71,
      "start": 6213.0,
      "end": 6215.0,
      "formatted_start": "01:43:33.000",
      "formatted_end": "01:43:35.000",
      "text": "از همونهای مال خود چه؟"
    },
    {
      "id": 72,
      "start": 6215.0,
      "end": 6218.0,
      "formatted_start": "01:43:35.000",
      "formatted_end": "01:43:38.000",
      "text": "گوشواله؟ ما با اون گوشواله ها سراخت میکنیم"
    },
    {
      "id": 73,
      "start": 6218.0,
      "end": 6221.0,
      "formatted_start": "01:43:38.000",
      "formatted_end": "01:43:41.000",
      "text": "شما از همون مادر گوشواله دارید"
    },
    {
      "id": 74,
      "start": 6221.0,
      "end": 6222.0,
      "formatted_start": "01:43:41.000",
      "formatted_end": "01:43:42.000",
      "text": "آره"
    },
    {
      "id": 75,
      "start": 6222.0,
      "end": 6223.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:43.000",
      "text": "ببینم"
    },
    {
      "id": 76,
      "start": 6223.0,
      "end": 6226.0,
      "formatted_start": "01:43:43.000",
      "formatted_end": "01:43:46.000",
      "text": "مال خودش یه هفته گوشش بود بگو هر گوشمون در اون مادر خودشتن"
    },
    {
      "id": 77,
      "start": 6226.0,
      "end": 6232.0,
      "formatted_start": "01:43:46.000",
      "formatted_end": "01:43:52.000",
      "text": "نه نه اون او افونیه اون که قبلم بوده اینم استیلیده بسته بندیه"
    },
    {
      "id": 78,
      "start": 6232.0,
      "end": 6234.0,
      "formatted_start": "01:43:52.000",
      "formatted_end": "01:43:54.000",
