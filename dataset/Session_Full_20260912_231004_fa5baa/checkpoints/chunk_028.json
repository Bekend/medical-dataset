  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8406.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:06.000",
      "text": "اگر اینم زیاد داریم و رو میچزمونی و شکنجو میکنیم، خودم راحت میده."
    },
    {
      "id": 1,
      "start": 8406.0,
      "end": 8414.0,
      "formatted_start": "02:20:06.000",
      "formatted_end": "02:20:14.000",
      "text": "اما خود راحت کردن که خودشم میتونه این شکل کنه و چون نمیکنه، میتونه که محکوم به شکنج دائمی."
    },
    {
      "id": 2,
      "start": 8414.0,
      "end": 8421.0,
      "formatted_start": "02:20:14.000",
      "formatted_end": "02:20:21.000",
      "text": "آدمی میتونه زیر بدتری شکنج ها پهمول بکنه که شجاعت مردن داشته باشه."
    },
    {
      "id": 3,
      "start": 8421.0,
      "end": 8427.0,
      "formatted_start": "02:20:21.000",
      "formatted_end": "02:20:27.000",
      "text": "بگه اگر زیادم زیر فشارم بذاشتن، دست همون کنم تو پیز وقت ها کنم میباشه."
    },
    {
      "id": 4,
      "start": 8427.0,
      "end": 8433.0,
      "formatted_start": "02:20:27.000",
      "formatted_end": "02:20:33.000",
      "text": "اما بعدا به حال اون کسی که دائم شکنجش میکنند جرعت هم نداره درسته"
    },
    {
      "id": 5,
      "start": 8433.0,
      "end": 8448.0,
      "formatted_start": "02:20:33.000",
      "formatted_end": "02:20:48.000",
      "text": "اینه که برگ بی آبان بدترین زندگی ممکن را داره به خاطر که در یک چهار تقسیم بندی تو هر تقسیم بندی که اون قسمت بدش قرار میکرد"
    },
    {
      "id": 6,
      "start": 8448.0,
      "end": 8450.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:50.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 8478.0,
      "end": 8500.0,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:40.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 8500.0,
      "end": 8502.0,
      "formatted_start": "02:21:40.000",
      "formatted_end": "02:21:42.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 8530.0,
      "end": 8559.98,
      "formatted_start": "02:22:10.000",
      "formatted_end": "02:22:39.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
