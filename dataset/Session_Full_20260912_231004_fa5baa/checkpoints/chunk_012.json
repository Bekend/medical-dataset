  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3628.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:28.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3634.0,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:34.000",
      "text": "از زن باشن ولی اهل معنا باشن مورد نداریم"
    },
    {
      "id": 2,
      "start": 3634.0,
      "end": 3638.0,
      "formatted_start": "01:00:34.000",
      "formatted_end": "01:00:38.000",
      "text": "خب در این تقسیم بردی نبیدید ما سه قسمت بکردیم"
    },
    {
      "id": 3,
      "start": 3638.0,
      "end": 3641.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:41.000",
      "text": "در تقسیم بردی اول دو قسمت بکردیم"
    },
    {
      "id": 4,
      "start": 3641.0,
      "end": 3644.0,
      "formatted_start": "01:00:41.000",
      "formatted_end": "01:00:44.000",
      "text": "در این تقسیم بردی دو هم ما سه قسمت بکردیم"
    },
    {
      "id": 5,
      "start": 3644.0,
      "end": 3648.0,
      "formatted_start": "01:00:44.000",
      "formatted_end": "01:00:48.000",
      "text": "آدم هایی که این تنها بردی کنیم"
    },
    {
      "id": 6,
      "start": 3650.0,
      "end": 3652.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:52.000",
      "text": "یک تقسیم بردی سه با هم"
    },
    {
      "id": 7,
      "start": 3652.0,
      "end": 3657.0,
      "formatted_start": "01:00:52.000",
      "formatted_end": "01:00:57.000",
      "text": "با اون تقسیم بردی سه زنی که نه اهل یعنی قائم کنه"
    },
    {
      "id": 8,
      "start": 3657.0,
      "end": 3665.28,
      "formatted_start": "01:00:57.000",
      "formatted_end": "01:01:05.280",
      "text": "و باز هم تمنی کنیم تا وقتی از دنبال بیاد من را اخص هستم"
    },
    {
      "id": 9,
      "start": 3665.28,
      "end": 3670.98,
      "formatted_start": "01:01:05.280",
      "formatted_end": "01:01:10.980",
      "text": "یعنی من را میده من را به روحانی که اینها دیگه نه اخلاقی هستن"
    },
    {
      "id": 10,
      "start": 3670.98,
      "end": 3674.98,
      "formatted_start": "01:01:10.980",
      "formatted_end": "01:01:14.980",
      "text": "نه افز کنن که اجتماعی هستن نه رفت و شمافتی هستن"
    },
    {
      "id": 11,
      "start": 3674.98,
      "end": 3676.38,
      "formatted_start": "01:01:14.980",
      "formatted_end": "01:01:16.380",
      "text": "روحانی هستن"
    },
    {
      "id": 12,
      "start": 3676.38,
      "end": 3681.0,
      "formatted_start": "01:01:16.380",
      "formatted_end": "01:01:21.000",
      "text": "خب همه بین آنهای دسته چه بار و باره بستن"
    },
    {
      "id": 13,
      "start": 3681.62,
      "end": 3685.32,
      "formatted_start": "01:01:21.620",
      "formatted_end": "01:01:25.320",
      "text": "ولی خب این خواهد را با من چه باره با من دسته چه باره با من باید"
    },
    {
      "id": 14,
      "start": 3685.32,
      "end": 3699.32,
      "formatted_start": "01:01:25.320",
      "formatted_end": "01:01:39.320",
      "text": "از تصویر نوم هم اتفاقی دارد که این اهر اتفاقا نهر شهرمانیت نیستن، نهر معنویتن و سلوک که اونو بگذارید چند آقای اتفاق کنن با هم فرد دارند."
    },
    {
      "id": 15,
      "start": 3699.32,
      "end": 3709.32,
      "formatted_start": "01:01:39.320",
      "formatted_end": "01:01:49.320",
      "text": "این ها جز به ضروریات زدیدی نمی پردازند. این هم به جرمی که اگه ضروریات زدیدیشون برای آوردنشی از هم نام تو ندارند،"
    },
    {
      "id": 16,
      "start": 3709.32,
      "end": 3717.6,
      "formatted_start": "01:01:49.320",
      "formatted_end": "01:01:57.600",
      "text": "تا این مورد رو تن پید معنیگرد بشوند و توی موردشون از نقاض معنیگرد چیزون چاپون کشند"
    },
    {
      "id": 17,
      "start": 3717.6,
      "end": 3719.74,
      "formatted_start": "01:01:57.600",
      "formatted_end": "01:01:59.740",
      "text": "دید و سه بیدید"
    },
    {
      "id": 18,
      "start": 3719.74,
      "end": 3726.96,
      "formatted_start": "01:01:59.740",
      "formatted_end": "01:02:06.960",
      "text": "یه دست سه بومی هستند که اینها هر شهرانیت رو می کنند همه بندید"
    },
    {
      "id": 19,
      "start": 3726.96,
      "end": 3731.64,
      "formatted_start": "01:02:06.960",
      "formatted_end": "01:02:11.640",
      "text": "یعنی نمیتونند از این چشم رو بوشند"
    },
    {
      "id": 20,
      "start": 3731.64,
      "end": 3733.68,
      "formatted_start": "01:02:11.640",
      "formatted_end": "01:02:13.680",
      "text": "نمیتونند از اون چشم رو بوشند"
    },
    {
      "id": 21,
      "start": 3733.68,
      "end": 3735.46,
      "formatted_start": "01:02:13.680",
      "formatted_end": "01:02:15.460",
      "text": "بلند بودون"
    },
    {
      "id": 22,
      "start": 3735.46,
      "end": 3742.78,
      "formatted_start": "01:02:15.460",
      "formatted_end": "01:02:22.780",
      "text": "خب این دیگه دست سه مونیم که اینگاه دل بدونی من دو دلت"
    },
    {
      "id": 23,
      "start": 3742.78,
      "end": 3752.26,
      "formatted_start": "01:02:22.780",
      "formatted_end": "01:02:32.260",
      "text": "هم وقتی که اخلاقیات رو از اصطلاح من میگه دلشون پراز مونده برای اخلاقی من"
    },
    {
      "id": 24,
      "start": 3752.26,
      "end": 3758.1,
      "formatted_start": "01:02:32.260",
      "formatted_end": "01:02:38.100",
      "text": "هم وقتی که از لذات صحبت میشه خود دلشون البته بوجه میکنه"
    },
    {
      "id": 25,
      "start": 3758.1,
      "end": 3765.34,
      "formatted_start": "01:02:38.100",
      "formatted_end": "01:02:45.340",
      "text": "برای این که کاشه شما من این لذت رو هم بچشم به این کامل دلت هم برسم و به همی درستم"
    },
    {
      "id": 26,
      "start": 3765.34,
      "end": 3771.62,
      "formatted_start": "01:02:45.340",
      "formatted_end": "01:02:51.620",
      "text": "این هم دستی بندی سه بار در تقسیم بندی دستی چهار موردن"
    },
    {
      "id": 27,
      "start": 3771.62,
      "end": 3778.18,
      "formatted_start": "01:02:51.620",
      "formatted_end": "01:02:58.180",
      "text": "یعنی کسانی که نه اهلی دست زده باشه و ده اهلی معنا باشن موردن"
    },
    {
      "id": 28,
      "start": 3778.18,
      "end": 3780.9,
      "formatted_start": "01:02:58.180",
      "formatted_end": "01:03:00.900",
      "text": "خب در این تقسیم بندی هم ببینیم"
    },
    {
      "id": 29,
      "start": 3780.9,
      "end": 3785.6,
      "formatted_start": "01:03:00.900",
      "formatted_end": "01:03:05.600",
      "text": "ما سه قسمت بده کردیم در تقسیم بندی اول دو قسمت بده کردیم"
    },
    {
      "id": 30,
      "start": 3785.6,
      "end": 3789.02,
      "formatted_start": "01:03:05.600",
      "formatted_end": "01:03:09.020",
      "text": "در این تقسیم بندی دو با سه قسمت بده کردیم"
    },
    {
      "id": 31,
      "start": 3789.02,
      "end": 3791.48,
      "formatted_start": "01:03:09.020",
      "formatted_end": "01:03:11.480",
      "text": "آدم هایی که اینجا برگردید"
    },
    {
      "id": 32,
      "start": 3791.48,
      "end": 3797.56,
      "formatted_start": "01:03:11.480",
      "formatted_end": "01:03:17.560",
      "text": "یک تقصیل ورنگ سه اومد موجود داره"
    },
    {
      "id": 33,
      "start": 3797.56,
      "end": 3799.7,
      "formatted_start": "01:03:17.560",
      "formatted_end": "01:03:19.700",
      "text": "ورنگ سه اومدید"
    },
    {
      "id": 34,
      "start": 3799.7,
      "end": 3804.02,
      "formatted_start": "01:03:19.700",
      "formatted_end": "01:03:24.020",
      "text": "آدمی هایی که زندگی و معنادار می آورد"
    },
    {
      "id": 35,
      "start": 3804.02,
      "end": 3809.02,
      "formatted_start": "01:03:24.020",
      "formatted_end": "01:03:29.020",
      "text": "و آدمی هایی که زندگی و معنادار نمی آورد"
    },
    {
      "id": 36,
      "start": 3809.02,
      "end": 3813.42,
      "formatted_start": "01:03:29.020",
      "formatted_end": "01:03:33.420",
      "text": "یعنی آدمی هایی که به نظرشون می آورد"
    },
    {
      "id": 37,
      "start": 3813.42,
      "end": 3816.88,
      "formatted_start": "01:03:33.420",
      "formatted_end": "01:03:36.880",
      "text": "که زندگی درشین معنادار است"
