  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7806.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:06.000",
      "text": "زندگی اینجور باشه که مشروبات عربی کنی رو درش محتور نشن."
    },
    {
      "id": 1,
      "start": 7806.0,
      "end": 7812.0,
      "formatted_start": "02:10:06.000",
      "formatted_end": "02:10:12.000",
      "text": "در شدنشینی های حرمگردانه شرکت ندارم. درست ندارم."
    },
    {
      "id": 2,
      "start": 7812.0,
      "end": 7822.0,
      "formatted_start": "02:10:12.000",
      "formatted_end": "02:10:22.000",
      "text": "هیچوقت دوست ندارم که روابط یره و آزاد جنسی روشن با هر زنی که پیش اومد. بله اینا درسته."
    },
    {
      "id": 3,
      "start": 7822.0,
      "end": 7830.0,
      "formatted_start": "02:10:22.000",
      "formatted_end": "02:10:30.000",
      "text": "در قضا خوردن من دقیقا درست کنم اما این فقط تو رفتاره در درست کنم"
    },
    {
      "id": 4,
      "start": 7830.0,
      "end": 7838.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:38.000",
      "text": "دلم هوای اونها رو می کنه اینه که در رویاه ها اون رویاه ها رو می بینم"
    },
    {
      "id": 5,
      "start": 7838.0,
      "end": 7844.0,
      "formatted_start": "02:10:38.000",
      "formatted_end": "02:10:44.000",
      "text": "در خیال پردازی ها اون خیال پردازی ها رو دارم"
    },
    {
      "id": 6,
      "start": 7844.0,
      "end": 7852.0,
      "formatted_start": "02:10:44.000",
      "formatted_end": "02:10:52.000",
      "text": "در نمو دیدم اما دست کشیدم از اونا دست کشیدم اما در نمو دیدم"
    },
    {
      "id": 7,
      "start": 7852.0,
      "end": 7861.0,
      "formatted_start": "02:10:52.000",
      "formatted_end": "02:11:01.000",
      "text": "چرا چون ببینید هر جا میرید توی داستان ببینید که هری حاله در رفتارش استوار ترید"
    },
    {
      "id": 8,
      "start": 7861.0,
      "end": 7872.0,
      "formatted_start": "02:11:01.000",
      "formatted_end": "02:11:12.000",
      "text": "اما اصلا در ذهنش استوار نیست در روانش استوار نیست در روانش این چیزها موج میزنند"
    },
    {
      "id": 9,
      "start": 7872.0,
      "end": 7875.0,
      "formatted_start": "02:11:12.000",
      "formatted_end": "02:11:15.000",
      "text": "حلوز قلقه داره به این چیزها"
    },
    {
      "id": 10,
      "start": 7875.0,
      "end": 7879.0,
      "formatted_start": "02:11:15.000",
      "formatted_end": "02:11:19.000",
      "text": "خب برنامه که میبینید که دیگه تقریبا از عواست که تا خوبت"
    },
    {
      "id": 11,
      "start": 7879.0,
      "end": 7883.0,
      "formatted_start": "02:11:19.000",
      "formatted_end": "02:11:23.000",
      "text": "میبینید وقتی منقلیت پیش میاد تنویز کنه به این چیزها"
    },
    {
      "id": 12,
      "start": 7883.0,
      "end": 7885.0,
      "formatted_start": "02:11:23.000",
      "formatted_end": "02:11:25.000",
      "text": "معلوم میشه که دل نبایده بوده"
    },
    {
      "id": 13,
      "start": 7885.0,
      "end": 7887.0,
      "formatted_start": "02:11:25.000",
      "formatted_end": "02:11:27.000",
      "text": "اما دست کشیدن"
    },
    {
      "id": 14,
      "start": 7887.0,
      "end": 7891.0,
      "formatted_start": "02:11:27.000",
      "formatted_end": "02:11:31.000",
      "text": "خب دست کشیدن منهای دل بولیدن این نافعه نیست"
    },
    {
      "id": 15,
      "start": 7891.0,
      "end": 7893.0,
      "formatted_start": "02:11:31.000",
      "formatted_end": "02:11:33.000",
      "text": "یه روز خودشو بروزم"
    },
    {
      "id": 16,
      "start": 7893.0,
      "end": 7896.0,
      "formatted_start": "02:11:33.000",
      "formatted_end": "02:11:36.000",
      "text": "که در رفتار احتیاط میکنم"
    },
    {
      "id": 17,
      "start": 7896.0,
      "end": 7898.0,
      "formatted_start": "02:11:36.000",
      "formatted_end": "02:11:38.000",
      "text": "در رفتار خوشتن دارم"
    },
    {
      "id": 18,
      "start": 7898.0,
      "end": 7901.34,
      "formatted_start": "02:11:38.000",
      "formatted_end": "02:11:41.340",
      "text": "در رفتار مهمیز رفتار خودم در دستمه"
    },
    {
      "id": 19,
      "start": 7901.34,
      "end": 7904.58,
      "formatted_start": "02:11:41.340",
      "formatted_end": "02:11:44.580",
      "text": "اما باورهان چیز دیگه یه"
    },
    {
      "id": 20,
      "start": 7904.58,
      "end": 7907.96,
      "formatted_start": "02:11:44.580",
      "formatted_end": "02:11:47.960",
      "text": "احساسات و عواطفان چیز دیگه یه"
    },
    {
      "id": 21,
      "start": 7907.96,
      "end": 7909.98,
      "formatted_start": "02:11:47.960",
      "formatted_end": "02:11:49.980",
      "text": "خواستهان چیز دیگه یه"
    },
    {
      "id": 22,
      "start": 7909.98,
      "end": 7912.56,
      "formatted_start": "02:11:49.980",
      "formatted_end": "02:11:52.560",
      "text": "اونی که در درمونم هست چیز دیگه"
    },
    {
      "id": 23,
      "start": 7912.56,
      "end": 7917.88,
      "formatted_start": "02:11:52.560",
      "formatted_end": "02:11:57.880",
      "text": "خب اگر من یک دره بودم"
    },
    {
      "id": 24,
      "start": 7917.88,
      "end": 7919.98,
      "formatted_start": "02:11:57.880",
      "formatted_end": "02:11:59.980",
      "text": "خب بهتر زندگی میگرشیم"
    },
    {
      "id": 25,
      "start": 7919.98,
      "end": 7923.1,
      "formatted_start": "02:11:59.980",
      "formatted_end": "02:12:03.100",
      "text": "اگر من فقط به نموال لذت بودم"
    },
    {
      "id": 26,
      "start": 7923.1,
      "end": 7924.58,
      "formatted_start": "02:12:03.100",
      "formatted_end": "02:12:04.580",
      "text": "خب بهتر بودم"
    },
    {
      "id": 27,
      "start": 7924.58,
      "end": 7926.78,
      "formatted_start": "02:12:04.580",
      "formatted_end": "02:12:06.780",
      "text": "اگر من مثل قدیسان"
    },
    {
      "id": 28,
      "start": 7926.78,
      "end": 7954.52,
      "formatted_start": "02:12:06.780",
      "formatted_end": "02:12:34.520",
      "text": "مثل فرزانگان، مثل عارفان بودم که فقط به نقال معنویت بودم، خب نمزده دیگه بهدر میچرم، توی یه عرباب داشتم، یه خدا داشتم، یه سربرداشتم، الان من دو تا عرباب برم، شهوت و معنویت، دستدت و معنو، هر دو عربابان منم، و یه عرباب هم عموماً مرکامشون با هم متفاوتند."
    },
    {
      "id": 29,
      "start": 7954.52,
      "end": 7961.52,
      "formatted_start": "02:12:34.520",
      "formatted_end": "02:12:41.520",
      "text": "یکی شونکه بکنی کنو، یکی شونکه نکنی کنو، یکی شونکه اکسو بکن، یکی شونکه ایگره بکن"
    },
    {
      "id": 30,
      "start": 7961.52,
      "end": 7967.52,
      "formatted_start": "02:12:41.520",
      "formatted_end": "02:12:47.520",
      "text": "خود این دوتا عربه ها با هم دربار دارن، من نام کرده دوتا عربه ها با هم بزنم، ندارد می کنیم؟"
    },
    {
      "id": 31,
      "start": 7967.52,
      "end": 7976.52,
      "formatted_start": "02:12:47.520",
      "formatted_end": "02:12:56.520",
      "text": "در مورد دوتا سرورم، که این دوتا سرور هر باید که این یکی می کنه، اون دیگری نمز می کنه، و هر باید که این می کنه، اون دیگری فصلش می کنه"
    },
    {
      "id": 32,
      "start": 7976.52,
      "end": 7983.52,
      "formatted_start": "02:12:56.520",
      "formatted_end": "02:13:03.520",
      "text": "وقتی هر رو کنی می کنه دیگری لعظه کنه، هر رو کنه می کنه، دیگری فصلش می کنه، من باید چیکار کنم؟"
    },
    {
      "id": 33,
      "start": 7983.52,
      "end": 8001.52,
      "formatted_start": "02:13:03.520",
      "formatted_end": "02:13:21.520",
      "text": "این وسط موندم، اگر یک ارباب داشتم، اگر اون ارباب لذت بود، خوب، عالی بود، اگر اون ارباب معنا بود، اونم خوب، عالی بود، ولی هر دو بودم، و اینه که حالا خوش نیست"
    },
    {
      "id": 34,
      "start": 8001.52,
      "end": 8005.52,
      "formatted_start": "02:13:21.520",
      "formatted_end": "02:13:25.520",
      "text": "دارم لذت میبرم، یادم میاد که با این لذت"
    },
    {
      "id": 35,
      "start": 8005.52,
      "end": 8008.52,
      "formatted_start": "02:13:25.520",
      "formatted_end": "02:13:28.520",
      "text": "چند تا از اصول معنوی خودم رو زیر قاعده میبرم"
    },
    {
      "id": 36,
      "start": 8008.52,
      "end": 8011.52,
      "formatted_start": "02:13:28.520",
      "formatted_end": "02:13:31.520",
      "text": "به کامل طرف میشه این لذت"
    },
    {
      "id": 37,
      "start": 8011.52,
      "end": 8013.52,
      "formatted_start": "02:13:31.520",
      "formatted_end": "02:13:33.520",
      "text": "درسته بید؟"
    },
    {
      "id": 38,
      "start": 8013.52,
      "end": 8018.52,
      "formatted_start": "02:13:33.520",
      "formatted_end": "02:13:38.520",
      "text": "میرم به طرف معنویت، میرم یک کار معنوی بکنم"
    },
    {
      "id": 39,
      "start": 8018.52,
      "end": 8021.52,
      "formatted_start": "02:13:38.520",
      "formatted_end": "02:13:41.520",
      "text": "ببینم که با خودم در نظر دارم"
    },
    {
      "id": 40,
      "start": 8021.52,
      "end": 8026.52,
      "formatted_start": "02:13:41.520",
      "formatted_end": "02:13:46.520",
      "text": "پی پی پی با این کار معنوی تو چه لذاتی رو از دست دادی؟"
    },
    {
      "id": 41,
      "start": 8026.52,
      "end": 8029.52,
      "formatted_start": "02:13:46.520",
      "formatted_end": "02:13:49.520",
      "text": "ببین دوست داره تو که دفتره معنویت ندارن"
    },
    {
      "id": 42,
      "start": 8029.52,
      "end": 8045.52,
      "formatted_start": "02:13:49.520",
      "formatted_end": "02:14:05.520",
      "text": "ندارن، الان دارن چه گوته میخورن، در لحظه چقدر شادن، همینطوری هیچی، دل به دنی من، دنم دو تیکه شده، یه تیکه شده یا میخواد یه تیکه شده بخواد، خوبت بخوند،"
    },
    {
      "id": 43,
      "start": 8045.52,
      "end": 8058.4,
      "formatted_start": "02:14:05.520",
      "formatted_end": "02:14:18.400",
      "text": "مهم تو تصویر اسکل بودم که خب معلومه اگر من زندگی رو معنادار می کنستم خب خوب بود زندگی خوب بود"
    },
    {
      "id": 44,
      "start": 8058.4,
      "end": 8064.2,
      "formatted_start": "02:14:18.400",
      "formatted_end": "02:14:24.200",
      "text": "من گفتم زندگی به زیستنش می عرضه اما من زندگی رو بی معنا می آبن من حاله"
    },
    {
      "id": 45,
      "start": 8064.2,
      "end": 8067.28,
      "formatted_start": "02:14:24.200",
      "formatted_end": "02:14:27.280",
      "text": "من زندگی رو بی معنا می آبن"
    },
    {
      "id": 46,
      "start": 8067.28,
      "end": 8076.22,
      "formatted_start": "02:14:27.280",
      "formatted_end": "02:14:36.220",
      "text": "یا مخصوص چی فعالیتی بعد از اینکه آدم ارز کنم که بای مرد همه چیز مسابق میشه به تبدیلشون"
    },
    {
      "id": 47,
      "start": 8076.22,
      "end": 8085.34,
      "formatted_start": "02:14:36.220",
      "formatted_end": "02:14:45.340",
      "text": "تمام کسانی که فعالیتهای ارز کنم که نیک کردن"
    },
    {
      "id": 48,
      "start": 8085.34,
      "end": 8092.1,
      "formatted_start": "02:14:45.340",
      "formatted_end": "02:14:52.100",
      "text": "همون جایی بیرن که همه کسانی که فعالیتهای بد کردن"
    },
    {
      "id": 49,
      "start": 8092.1,
      "end": 8095.1,
      "formatted_start": "02:14:52.100",
      "formatted_end": "02:14:55.100",
      "text": "همشون تو مقای که عدم فرامون میرن"
    },
    {
      "id": 50,
      "start": 8095.1,
      "end": 8096.72,
      "formatted_start": "02:14:55.100",
      "formatted_end": "02:14:56.720",
      "text": "افترین کنید"
    },
    {
      "id": 51,
      "start": 8096.72,
      "end": 8099.22,
      "formatted_start": "02:14:56.720",
      "formatted_end": "02:14:59.220",
      "text": "تو بهترین انسان روزگار باشید"
    },
    {
      "id": 52,
      "start": 8099.22,
      "end": 8100.26,
      "formatted_start": "02:14:59.220",
      "formatted_end": "02:15:00.260",
      "text": "یا بهترین انسان روزگار باشید"
    }
  ],
  "status": "completed"
}