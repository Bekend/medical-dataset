  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 606.0,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:06.000",
      "text": "اینجوری که اینجوری بود، چیزی با سلمتون در مطب پزشکی شده بود."
    },
    {
      "id": 1,
      "start": 606.0,
      "end": 610.0,
      "formatted_start": "00:10:06.000",
      "formatted_end": "00:10:10.000",
      "text": "با این یکی از آنگیران بوده، مطب پزشکی بود، شما سلمتون دارید."
    },
    {
      "id": 2,
      "start": 610.0,
      "end": 615.0,
      "formatted_start": "00:10:10.000",
      "formatted_end": "00:10:15.000",
      "text": "تو برگیرونه، اون درگیر چه برگیر سیره بشه، در مطب پزشکی بود."
    },
    {
      "id": 3,
      "start": 615.0,
      "end": 617.0,
      "formatted_start": "00:10:15.000",
      "formatted_end": "00:10:17.000",
      "text": "این چیز بودن که شیرون روز کنید."
    },
    {
      "id": 4,
      "start": 617.0,
      "end": 619.0,
      "formatted_start": "00:10:17.000",
      "formatted_end": "00:10:19.000",
      "text": "شیرون هم نباید کنید."
    },
    {
      "id": 5,
      "start": 619.0,
      "end": 621.0,
      "formatted_start": "00:10:19.000",
      "formatted_end": "00:10:21.000",
      "text": "که شیرون روز آمد کنید و این روز کنید"
    },
    {
      "id": 6,
      "start": 621.0,
      "end": 623.0,
      "formatted_start": "00:10:21.000",
      "formatted_end": "00:10:23.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 7,
      "start": 623.0,
      "end": 625.0,
      "formatted_start": "00:10:23.000",
      "formatted_end": "00:10:25.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 8,
      "start": 625.0,
      "end": 627.0,
      "formatted_start": "00:10:25.000",
      "formatted_end": "00:10:27.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 9,
      "start": 627.0,
      "end": 629.0,
      "formatted_start": "00:10:27.000",
      "formatted_end": "00:10:29.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 10,
      "start": 629.0,
      "end": 631.0,
      "formatted_start": "00:10:29.000",
      "formatted_end": "00:10:31.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 11,
      "start": 631.0,
      "end": 633.0,
      "formatted_start": "00:10:31.000",
      "formatted_end": "00:10:33.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 12,
      "start": 633.0,
      "end": 635.0,
      "formatted_start": "00:10:33.000",
      "formatted_end": "00:10:35.000",
      "text": "و این روز کنید و این روز کنید"
    },
    {
      "id": 13,
      "start": 645.0,
      "end": 675.0,
      "formatted_start": "00:10:45.000",
      "formatted_end": "00:11:15.000",
      "text": "اینکه این کار را برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای"
    },
    {
      "id": 14,
      "start": 675.0,
      "end": 705.0,
      "formatted_start": "00:11:15.000",
      "formatted_end": "00:11:45.000",
      "text": "اینجا باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 15,
      "start": 705.0,
      "end": 709.0,
      "formatted_start": "00:11:45.000",
      "formatted_end": "00:11:49.000",
      "text": "این چشم را نداریم. چی کنیم؟"
    },
    {
      "id": 16,
      "start": 709.0,
      "end": 712.0,
      "formatted_start": "00:11:49.000",
      "formatted_end": "00:11:52.000",
      "text": "نه، اونو بسریم. نه، این توبه تطور بود."
    },
    {
      "id": 17,
      "start": 712.0,
      "end": 714.0,
      "formatted_start": "00:11:52.000",
      "formatted_end": "00:11:54.000",
      "text": "من این توبه تطور ندارم."
    },
    {
      "id": 18,
      "start": 714.0,
      "end": 716.0,
      "formatted_start": "00:11:54.000",
      "formatted_end": "00:11:56.000",
      "text": "اما این توبه را بسیار گرمون می کنید."
    },
    {
      "id": 19,
      "start": 716.0,
      "end": 717.0,
      "formatted_start": "00:11:56.000",
      "formatted_end": "00:11:57.000",
      "text": "درست کنید."
    },
    {
      "id": 20,
      "start": 717.0,
      "end": 719.0,
      "formatted_start": "00:11:57.000",
      "formatted_end": "00:11:59.000",
      "text": "واسط درگردی بگویید توبه را بگویید."
    },
    {
      "id": 21,
      "start": 719.0,
      "end": 721.0,
      "formatted_start": "00:11:59.000",
      "formatted_end": "00:12:01.000",
      "text": "من که هم توبه هستیم؟"
    },
    {
      "id": 22,
      "start": 721.0,
      "end": 723.0,
      "formatted_start": "00:12:01.000",
      "formatted_end": "00:12:03.000",
      "text": "دیگه من دارم خوش آداشت گردم."
    },
    {
      "id": 23,
      "start": 723.0,
      "end": 724.0,
      "formatted_start": "00:12:03.000",
      "formatted_end": "00:12:04.000",
      "text": "توبه دارم."
    },
    {
      "id": 24,
      "start": 724.0,
      "end": 726.0,
      "formatted_start": "00:12:04.000",
      "formatted_end": "00:12:06.000",
      "text": "هر دومون خواهد بگویید."
    },
    {
      "id": 25,
      "start": 726.0,
      "end": 727.0,
      "formatted_start": "00:12:06.000",
      "formatted_end": "00:12:07.000",
      "text": "بزرگی."
    },
    {
      "id": 26,
      "start": 727.0,
      "end": 729.0,
      "formatted_start": "00:12:07.000",
      "formatted_end": "00:12:09.000",
      "text": "گفتم بگویید در یک جدید درگ."
    },
    {
      "id": 27,
      "start": 729.0,
      "end": 759.0,
      "formatted_start": "00:12:09.000",
      "formatted_end": "00:12:39.000",
