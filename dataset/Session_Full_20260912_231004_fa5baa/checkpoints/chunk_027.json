  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8110.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:10.000",
      "text": "این رسانه موزگاه کشی، در هر دوها در یک جمعیری."
    },
    {
      "id": 1,
      "start": 8110.0,
      "end": 8130.0,
      "formatted_start": "02:15:10.000",
      "formatted_end": "02:15:30.000",
      "text": "اشرار زمان جنایتکاران، کسانی که فقط ظلم و ستم و تعدی و تجاوز کردن، اینا میرن تو موقع عدم و نیکان و اخیار زمان اولایی که فقط"
    },
    {
      "id": 2,
      "start": 8130.0,
      "end": 8131.78,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:15:31.780",
      "text": "به فکر خدمت به دیگران بودن"
    },
    {
      "id": 3,
      "start": 8131.78,
      "end": 8134.48,
      "formatted_start": "02:15:31.780",
      "formatted_end": "02:15:34.480",
      "text": "فقط به فکر افتقای معنی خودشونون"
    },
    {
      "id": 4,
      "start": 8134.48,
      "end": 8136.28,
      "formatted_start": "02:15:34.480",
      "formatted_end": "02:15:36.280",
      "text": "این هم تا همون موقع که عدم بیدن"
    },
    {
      "id": 5,
      "start": 8136.28,
      "end": 8142.08,
      "formatted_start": "02:15:36.280",
      "formatted_end": "02:15:42.080",
      "text": "چه فرق میکنه از این مزندگی"
    },
    {
      "id": 6,
      "start": 8142.08,
      "end": 8143.84,
      "formatted_start": "02:15:42.080",
      "formatted_end": "02:15:43.840",
      "text": "با اون مزندگی چه فرق میکنه"
    },
    {
      "id": 7,
      "start": 8143.84,
      "end": 8145.44,
      "formatted_start": "02:15:43.840",
      "formatted_end": "02:15:45.440",
      "text": "این چه زندگی این برق هست"
    },
    {
      "id": 8,
      "start": 8145.44,
      "end": 8146.96,
      "formatted_start": "02:15:45.440",
      "formatted_end": "02:15:46.960",
      "text": "و چه زندگی اون برق هست"
    },
    {
      "id": 9,
      "start": 8146.96,
      "end": 8149.58,
      "formatted_start": "02:15:46.960",
      "formatted_end": "02:15:49.580",
      "text": "به زبان ساده انگار"
    },
    {
      "id": 10,
      "start": 8149.58,
      "end": 8152.72,
      "formatted_start": "02:15:49.580",
      "formatted_end": "02:15:52.720",
      "text": "خیلی جمع بی اعتناس"
    },
    {
      "id": 11,
      "start": 8152.72,
      "end": 8154.14,
      "formatted_start": "02:15:52.720",
      "formatted_end": "02:15:54.140",
      "text": "به نحوه زندگی ما"
    },
    {
      "id": 12,
      "start": 8154.14,
      "end": 8157.7,
      "formatted_start": "02:15:54.140",
      "formatted_end": "02:15:57.700",
      "text": "انگار خیلی بی تفاوت"
    },
    {
      "id": 13,
      "start": 8157.7,
      "end": 8159.4,
      "formatted_start": "02:15:57.700",
      "formatted_end": "02:15:59.400",
      "text": "رسپت به نحوه زندگی ما"
    },
    {
      "id": 14,
      "start": 8159.4,
      "end": 8166.72,
      "formatted_start": "02:15:59.400",
      "formatted_end": "02:16:06.720",
      "text": "چون توی که نیکترینی با منی که بدترینی هر دوی منو دازه توی صندوق عدم به تعبیر خیلی"
    },
    {
      "id": 15,
      "start": 8166.72,
      "end": 8173.4,
      "formatted_start": "02:16:06.720",
      "formatted_end": "02:16:13.400",
      "text": "هر دوی در صندوق عدم کنه صندوق عدم تو را مندازه تو اون صندوق من را تو همون صندوق میدازه"
    },
    {
      "id": 16,
      "start": 8177.4,
      "end": 8181.06,
      "formatted_start": "02:16:17.400",
      "formatted_end": "02:16:21.060",
      "text": "دلار بکنی؟ اقلاد قسمت نسبت ما بیتفا موده"
    },
    {
      "id": 17,
      "start": 8181.06,
      "end": 8186.56,
      "formatted_start": "02:16:21.060",
      "formatted_end": "02:16:26.560",
      "text": "شما معلمی را در امداد میگیرید که شاگرد اول کلاس را کتک میزنه"
    },
    {
      "id": 18,
      "start": 8186.56,
      "end": 8189.22,
      "formatted_start": "02:16:26.560",
      "formatted_end": "02:16:29.220",
      "text": "شاگرد آخر کلاس را کتک میزنه"
    },
    {
      "id": 19,
      "start": 8189.22,
      "end": 8195.46,
      "formatted_start": "02:16:29.220",
      "formatted_end": "02:16:35.460",
      "text": "یا برقص شاگرد اول کلاس رو تشکیل میکنه شاگرد آخر کلاس رو تشکیل میکنه"
    },
    {
      "id": 20,
      "start": 8195.46,
      "end": 8198.68,
      "formatted_start": "02:16:35.460",
      "formatted_end": "02:16:38.680",
      "text": "خواهشمان انگیزه پیدا بکنید که برید درس بخونید"
    },
    {
      "id": 21,
      "start": 8198.68,
      "end": 8205.76,
      "formatted_start": "02:16:38.680",
      "formatted_end": "02:16:45.760",
      "text": "و تکلیفت جام بدید و شبها بیدار برچون برای مطاره این کتاب و اون کتاب و این جزه و اون جزه"
    },
    {
      "id": 22,
      "start": 8205.76,
      "end": 8212.96,
      "formatted_start": "02:16:45.760",
      "formatted_end": "02:16:52.960",
      "text": "اگر نظرتون به این باشی که معلم چه با کنشینش کنید"
    },
    {
      "id": 23,
      "start": 8212.96,
      "end": 8217.92,
      "formatted_start": "02:16:52.960",
      "formatted_end": "02:16:57.920",
      "text": "خب انگیزه پیدا نمی کنید چون میگید من فرقشه یا در اول آخر کلا من که باشم"
    },
    {
      "id": 24,
      "start": 8217.92,
      "end": 8221.6,
      "formatted_start": "02:16:57.920",
      "formatted_end": "02:17:01.600",
      "text": "بعض هم با شاگرده آخر کلاسیش فرق نمی کنه"
    },
    {
      "id": 25,
      "start": 8221.6,
      "end": 8224.1,
      "formatted_start": "02:17:01.600",
      "formatted_end": "02:17:04.100",
      "text": "یا به هر دوم جایزه می دنن به یک سان"
    },
    {
      "id": 26,
      "start": 8224.1,
      "end": 8226.78,
      "formatted_start": "02:17:04.100",
      "formatted_end": "02:17:06.780",
      "text": "یا به هر دوم کتک می زنن به یک سان"
    },
    {
      "id": 27,
      "start": 8226.78,
      "end": 8229.08,
      "formatted_start": "02:17:06.780",
      "formatted_end": "02:17:09.080",
      "text": "و من چه انگیزهی پیدا می کنم که"
    },
    {
      "id": 28,
      "start": 8229.08,
      "end": 8231.3,
      "formatted_start": "02:17:09.080",
      "formatted_end": "02:17:11.300",
      "text": "از کنم درسته هایی کنم به باله"
    },
    {
      "id": 29,
      "start": 8231.3,
      "end": 8232.74,
      "formatted_start": "02:17:11.300",
      "formatted_end": "02:17:12.740",
      "text": "یعنی تدقیم خودم"
    },
    {
      "id": 30,
      "start": 8232.74,
      "end": 8237.54,
      "formatted_start": "02:17:12.740",
      "formatted_end": "02:17:17.540",
      "text": "حسی همچین معلمی جدید کنه برنامه"
    },
    {
      "id": 31,
      "start": 8237.54,
      "end": 8240.56,
      "formatted_start": "02:17:17.540",
      "formatted_end": "02:17:20.560",
      "text": "چون در صندوق عدم رو که باید کرد"
    },
    {
      "id": 32,
      "start": 8240.56,
      "end": 8242.12,
      "formatted_start": "02:17:20.560",
      "formatted_end": "02:17:22.120",
      "text": "ما می آفیم توی صندوق"
    },
    {
      "id": 33,
      "start": 8242.12,
      "end": 8244.0,
      "formatted_start": "02:17:22.120",
      "formatted_end": "02:17:24.000",
      "text": "که خب بلیم"
    },
    {
      "id": 34,
      "start": 8244.0,
      "end": 8245.92,
      "formatted_start": "02:17:24.000",
      "formatted_end": "02:17:25.920",
      "text": "تو هم که خوبی می آفیم که آنو خواهیم"
    },
    {
      "id": 35,
      "start": 8245.92,
      "end": 8249.92,
      "formatted_start": "02:17:25.920",
      "formatted_end": "02:17:29.920",
      "text": "ما این کار رو در اینگیزه بدون کار چی فهم کنیم؟"
    },
    {
      "id": 36,
      "start": 8249.92,
      "end": 8255.92,
      "formatted_start": "02:17:29.920",
      "formatted_end": "02:17:35.920",
      "text": "مخصوصا وقتی به این توجه بکنیم که زندگی کردن سختی هایی داره در زندگی"
    },
    {
      "id": 37,
      "start": 8255.92,
      "end": 8258.92,
      "formatted_start": "02:17:35.920",
      "formatted_end": "02:17:38.920",
      "text": "زندگی کردن سختی ها رو نداره درسته"
    },
    {
      "id": 38,
      "start": 8258.92,
      "end": 8262.92,
      "formatted_start": "02:17:38.920",
      "formatted_end": "02:17:42.920",
      "text": "بعد زندگی کردن هم یه هزینه هایی داره"
    },
    {
      "id": 39,
      "start": 8262.92,
      "end": 8268.92,
      "formatted_start": "02:17:42.920",
      "formatted_end": "02:17:48.920",
      "text": "اما هرگز هزینه هاش بندازه هزینه هاییه آن زندگی کردن نیست"
    },
    {
      "id": 40,
      "start": 8268.92,
      "end": 8270.92,
      "formatted_start": "02:17:48.920",
      "formatted_end": "02:17:50.920",
      "text": "درسته؟"
    },
    {
      "id": 41,
      "start": 8270.92,
      "end": 8275.92,
      "formatted_start": "02:17:50.920",
      "formatted_end": "02:17:55.920",
      "text": "بعد زندگی کردن آدم را از ثروت محروم بمیکنه"
    },
    {
      "id": 42,
      "start": 8275.92,
      "end": 8278.92,
      "formatted_start": "02:17:55.920",
      "formatted_end": "02:17:58.920",
      "text": "از قدرت محروم بمیکنه"
    },
    {
      "id": 43,
      "start": 8278.92,
      "end": 8281.92,
      "formatted_start": "02:17:58.920",
      "formatted_end": "02:18:01.920",
      "text": "اما وقتی آدم میخواد دیگر زندگی کنه"
    },
    {
      "id": 44,
      "start": 8281.92,
      "end": 8284.92,
      "formatted_start": "02:18:01.920",
      "formatted_end": "02:18:04.920",
      "text": "به ثروتش هم لرمی کنه، به قدرتش هم لرمی کنه"
    },
    {
      "id": 45,
      "start": 8284.92,
      "end": 8288.92,
      "formatted_start": "02:18:04.920",
      "formatted_end": "02:18:08.920",
      "text": "به شبرتش هم لرمی کنه، هزار، مونت، منره"
    },
    {
      "id": 46,
      "start": 8288.92,
      "end": 8291.92,
      "formatted_start": "02:18:08.920",
      "formatted_end": "02:18:11.920",
      "text": "چقدر خوبه جگرد کنه آدمی که"
    },
    {
      "id": 47,
      "start": 8291.92,
      "end": 8294.92,
      "formatted_start": "02:18:11.920",
      "formatted_end": "02:18:14.920",
      "text": "فکر همه شهروندار جامعهش هست"
    },
    {
      "id": 48,
      "start": 8294.92,
      "end": 8296.92,
      "formatted_start": "02:18:14.920",
      "formatted_end": "02:18:16.920",
      "text": "یه چیز که فقط ذکر خودشی"
    },
    {
      "id": 49,
      "start": 8296.92,
      "end": 8299.92,
      "formatted_start": "02:18:16.920",
      "formatted_end": "02:18:19.920",
      "text": "اونکه اونکه به فکر همه شهروندان جامعه از"
    },
    {
      "id": 50,
      "start": 8300.92,
      "end": 8302.92,
      "formatted_start": "02:18:20.920",
      "formatted_end": "02:18:22.920",
      "text": "هوا به خوش ازگیرش کنیده داره"
    },
    {
      "id": 51,
      "start": 8302.92,
      "end": 8305.92,
      "formatted_start": "02:18:22.920",
      "formatted_end": "02:18:25.920",
      "text": "یه روح بده نمیتونه گووارای وجود رو خودش نکرده"
    },
    {
      "id": 52,
      "start": 8305.92,
      "end": 8308.92,
      "formatted_start": "02:18:25.920",
      "formatted_end": "02:18:28.920",
      "text": "همه چیزی به محتویش گیر می کنه"
    },
    {
      "id": 53,
      "start": 8308.92,
      "end": 8312.92,
      "formatted_start": "02:18:28.920",
      "formatted_end": "02:18:32.920",
      "text": "در حال اینکه خوصه همه شهروندان جامعه خود شاد کنه"
    },
    {
      "id": 54,
      "start": 8312.92,
      "end": 8314.92,
      "formatted_start": "02:18:32.920",
      "formatted_end": "02:18:34.920",
      "text": "یا خوصه پشتیت نمی کنه"
    },
    {
      "id": 55,
      "start": 8314.92,
      "end": 8317.92,
      "formatted_start": "02:18:34.920",
      "formatted_end": "02:18:37.920",
      "text": "خواهی آدمی رو فقط به توی تیز و پوتشی رو خود کنه"
    },
    {
      "id": 56,
      "start": 8317.92,
      "end": 8320.92,
      "formatted_start": "02:18:37.920",
      "formatted_end": "02:18:40.920",
      "text": "و از اینکه سندگی ها با هم خود رو خواهد کنه"
    },
    {
      "id": 57,
      "start": 8320.92,
      "end": 8322.92,
      "formatted_start": "02:18:40.920",
      "formatted_end": "02:18:42.920",
      "text": "و مقصد وقتی میمونید"
    },
    {
      "id": 58,
      "start": 8324.92,
      "end": 8326.92,
      "formatted_start": "02:18:44.920",
      "formatted_end": "02:18:46.920",
      "text": "و شما که نیه چی از نیکان بودین"
    },
    {
      "id": 59,
      "start": 8326.92,
      "end": 8328.92,
      "formatted_start": "02:18:46.920",
      "formatted_end": "02:18:48.920",
      "text": "همون جایی میدین"
    },
    {
      "id": 60,
      "start": 8328.92,
      "end": 8330.92,
      "formatted_start": "02:18:48.920",
      "formatted_end": "02:18:50.920",
      "text": "ولی که بدی از بدان بودون همینجا میدونید"
    },
    {
      "id": 61,
      "start": 8332.92,
      "end": 8334.92,
      "formatted_start": "02:18:52.920",
      "formatted_end": "02:18:54.920",
      "text": "خب این زندگی ترش در چیف کامال هم"
    },
    {
      "id": 62,
      "start": 8334.92,
      "end": 8336.92,
      "formatted_start": "02:18:54.920",
      "formatted_end": "02:18:56.920",
      "text": "هریاله میجوید"
    },
    {
      "id": 63,
      "start": 8338.92,
      "end": 8340.92,
      "formatted_start": "02:18:58.920",
      "formatted_end": "02:19:00.920",
      "text": "زندگی رو بیمانه آوردید"
    },
    {
      "id": 64,
      "start": 8340.92,
      "end": 8342.92,
      "formatted_start": "02:19:00.920",
      "formatted_end": "02:19:02.920",
      "text": "نمی کنید"
    },
    {
      "id": 65,
      "start": 8344.92,
      "end": 8346.92,
      "formatted_start": "02:19:04.920",
      "formatted_end": "02:19:06.920",
      "text": "اما در ماب تقسیم چهارمان"
    },
    {
      "id": 66,
      "start": 8346.92,
      "end": 8348.92,
      "formatted_start": "02:19:06.920",
      "formatted_end": "02:19:08.920",
      "text": "ورد هریاله بندید"
    },
    {
      "id": 67,
      "start": 8348.92,
      "end": 8353.22,
      "formatted_start": "02:19:08.920",
      "formatted_end": "02:19:13.220",
      "text": "ببینید از هیز زندگی دیدید که چی قصد نمیشه داریم؟ تلخه"
    },
    {
      "id": 68,
      "start": 8353.22,
      "end": 8357.22,
      "formatted_start": "02:19:13.220",
      "formatted_end": "02:19:17.220",
      "text": "اما خب با این همه تلخه نداشت کار میکنه، تهمال میکنه"
    },
    {
      "id": 69,
      "start": 8357.22,
      "end": 8362.12,
      "formatted_start": "02:19:17.220",
      "formatted_end": "02:19:22.120",
      "text": "اما مرد با نمیتونه تهمال کنه، اگه مرد با نمیتونه تهمال بکنه خود بشه میکرد"
    },
    {
      "id": 70,
      "start": 8362.12,
      "end": 8368.12,
      "formatted_start": "02:19:22.120",
      "formatted_end": "02:19:28.120",
      "text": "ببینید که دائم میگه چی میگه، تیغه، رشتراشی رو بذاشم کنار دستم"
    },
    {
      "id": 71,
      "start": 8368.12,
      "end": 8373.12,
      "formatted_start": "02:19:28.120",
      "formatted_end": "02:19:33.120",
      "text": "اما براد نمیبونه دست داریم تیغه رشتراشیش"
    },
    {
      "id": 72,
      "start": 8373.12,
      "end": 8378.12,
      "formatted_start": "02:19:33.120",
      "formatted_end": "02:19:38.120",
      "text": "بذاشه در دستش برای روز مبادا"
    },
    {
      "id": 73,
      "start": 8378.92,
      "end": 8383.16,
      "formatted_start": "02:19:38.920",
      "formatted_end": "02:19:43.160",
      "text": "خرید به خودشون. چرا گذاشت که در دستش خودتون کتاب خونده ای؟"
    },
    {
      "id": 74,
      "start": 8383.16,
      "end": 8391.68,
      "formatted_start": "02:19:43.160",
      "formatted_end": "02:19:51.680",
      "text": "برای گذاشت در دستش که به هستی، به نمهک، به خدا، به هرک، به مخاطب خودشون."
    },
    {
      "id": 75,
      "start": 8391.68,
      "end": 8397.48,
      "formatted_start": "02:19:51.680",
      "formatted_end": "02:19:57.480",
      "text": "بگه اگه زیادم زیر فشارم رو گذاشتی، خودم را از شرط را عرض می کنم."
    },
    {
      "id": 76,
      "start": 8397.48,
      "end": 8399.92,
      "formatted_start": "02:19:57.480",
      "formatted_end": "02:19:59.920",
      "text": "فکر نکنی قدرت مطلب بر مهدتون."
    }
  ],
  "status": "completed"
}