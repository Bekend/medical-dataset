  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4529.98,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 4530.0,
      "end": 4532.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:32.000",
      "text": "حالا؟"
    },
    {
      "id": 2,
      "start": 4536.0,
      "end": 4538.0,
      "formatted_start": "01:15:36.000",
      "formatted_end": "01:15:38.000",
      "text": "حالا؟ خوب"
    },
    {
      "id": 3,
      "start": 4540.0,
      "end": 4545.0,
      "formatted_start": "01:15:40.000",
      "formatted_end": "01:15:45.000",
      "text": "ببینید اینو به این صورت این اسپیرل رو دو سه تا تو دماغش میزنید"
    },
    {
      "id": 4,
      "start": 4546.0,
      "end": 4550.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:50.000",
      "text": "خب بعد یه ده دقیقه بعد با این دماغی بینیش رو تمیز کنید"
    },
    {
      "id": 5,
      "start": 4551.0,
      "end": 4554.0,
      "formatted_start": "01:15:51.000",
      "formatted_end": "01:15:54.000",
      "text": "الان من یه بار سری میزنم که ده دقیقه دیگه وقت میشه"
    },
    {
      "id": 6,
      "start": 4555.0,
      "end": 4557.0,
      "formatted_start": "01:15:55.000",
      "formatted_end": "01:15:57.000",
      "text": "ببینید اینو به این صورت"
    },
    {
      "id": 7,
      "start": 4560.0,
      "end": 4566.0,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:06.000",
      "text": "نیوه تا آخر یه جدار رو بزنید کافیه"
    },
    {
      "id": 8,
      "start": 4566.0,
      "end": 4573.0,
      "formatted_start": "01:16:06.000",
      "formatted_end": "01:16:13.000",
      "text": "خواهده؟ سلام چاست؟ نوزاد اومد؟ وضعیتش چطوره؟"
    },
    {
      "id": 9,
      "start": 4573.0,
      "end": 4581.0,
      "formatted_start": "01:16:13.000",
      "formatted_end": "01:16:21.000",
      "text": "خوبه؟ یکم نالش؟"
    },
    {
      "id": 10,
      "start": 4581.0,
      "end": 4584.0,
      "formatted_start": "01:16:21.000",
      "formatted_end": "01:16:24.000",
      "text": "وزن شدود 3 پیروز"
    },
    {
      "id": 11,
      "start": 4584.0,
      "end": 4586.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:26.000",
      "text": "خواهید پستری بشید"
    },
    {
      "id": 12,
      "start": 4586.0,
      "end": 4588.0,
      "formatted_start": "01:16:26.000",
      "formatted_end": "01:16:28.000",
      "text": "این پیو بشید یک شسیومیده هم بدید"
    },
    {
      "id": 13,
      "start": 4588.0,
      "end": 4590.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:30.000",
      "text": "ترشات کپالوت داشتید"
    },
    {
      "id": 14,
      "start": 4590.0,
      "end": 4592.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:32.000",
      "text": "ساکشن کنید شو بدید"
    },
    {
      "id": 15,
      "start": 4592.0,
      "end": 4595.0,
      "formatted_start": "01:16:32.000",
      "formatted_end": "01:16:35.000",
      "text": "بعد سروم هم 240 تا"
    },
    {
      "id": 16,
      "start": 4595.0,
      "end": 4598.0,
      "formatted_start": "01:16:35.000",
      "formatted_end": "01:16:38.000",
      "text": "بعد آزمایشات روتین هم"
    },
    {
      "id": 17,
      "start": 4598.0,
      "end": 4602.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:42.000",
      "text": "آمینفرین هم یه 5 تا بزنید"
    },
    {
      "id": 18,
      "start": 4602.0,
      "end": 4608.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:48.000",
      "text": "بعد عکس سینه و اکسیجن هم براش بزنید"
    },
    {
      "id": 19,
      "start": 4608.0,
      "end": 4612.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:16:52.000",
      "text": "اون پیسیدین هم 158 ساعت"
    },
    {
      "id": 20,
      "start": 4612.0,
      "end": 4620.0,
      "formatted_start": "01:16:52.000",
      "formatted_end": "01:17:00.000",
      "text": "جنتامایسین 7 میلی گرم 12 ساعت"
    },
    {
      "id": 21,
      "start": 4620.0,
      "end": 4623.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:03.000",
      "text": "حکسشو گرفتیم تو واتساب برام بکنید"
    },
    {
      "id": 22,
      "start": 4623.0,
      "end": 4627.0,
      "formatted_start": "01:17:03.000",
      "formatted_end": "01:17:07.000",
      "text": "مرسی منو"
    },
    {
      "id": 23,
      "start": 4627.0,
      "end": 4629.0,
      "formatted_start": "01:17:07.000",
      "formatted_end": "01:17:09.000",
      "text": "خب ببین"
    },
    {
      "id": 24,
      "start": 4629.0,
      "end": 4631.0,
      "formatted_start": "01:17:09.000",
      "formatted_end": "01:17:11.000",
      "text": "بعد اینو پشار میدین"
    },
    {
      "id": 25,
      "start": 4631.0,
      "end": 4633.0,
      "formatted_start": "01:17:11.000",
      "formatted_end": "01:17:13.000",
      "text": "هواش خالی باشه نیست ترده باشه"
    },
    {
      "id": 26,
      "start": 4633.0,
      "end": 4637.0,
      "formatted_start": "01:17:13.000",
      "formatted_end": "01:17:17.000",
      "text": "نه ترس ببر بذار فیلم ها به"
    },
    {
      "id": 27,
      "start": 4637.0,
      "end": 4644.24,
      "formatted_start": "01:17:17.000",
      "formatted_end": "01:17:24.240",
      "text": "این خالی میشه اگر تو بینی شیف گره از اون میگره نفس نمیتونه بکشه"
    },
    {
      "id": 28,
      "start": 4644.24,
      "end": 4648.24,
      "formatted_start": "01:17:24.240",
      "formatted_end": "01:17:28.240",
      "text": "خب؟ ببین اون رو باید بیاری بیرون"
    },
    {
      "id": 29,
      "start": 4648.24,
      "end": 4653.0,
      "formatted_start": "01:17:28.240",
      "formatted_end": "01:17:33.000",
      "text": "این دماغ و مکشی کچیکه الان همین دو سه بار میشه این تاریکت یه بار کمه"
    },
    {
      "id": 30,
      "start": 4653.0,
      "end": 4656.5,
      "formatted_start": "01:17:33.000",
      "formatted_end": "01:17:36.500",
      "text": "باز الان میریم کنم بچه رو از دردن بزرگ یه بار دیگه هم بزنم که"
    },
    {
      "id": 31,
      "start": 4656.5,
      "end": 4658.5,
      "formatted_start": "01:17:36.500",
      "formatted_end": "01:17:38.500",
      "text": "شما شاید بهترسید خیلی"
    },
    {
      "id": 32,
      "start": 4658.5,
      "end": 4663.0,
      "formatted_start": "01:17:38.500",
      "formatted_end": "01:17:43.000",
      "text": "ببین این هوا رو خالی می کنی"
    },
    {
      "id": 33,
      "start": 4663.0,
      "end": 4665.5,
      "formatted_start": "01:17:43.000",
      "formatted_end": "01:17:45.500",
      "text": "مثلا این بینیش پیش برد"
    },
    {
      "id": 34,
      "start": 4665.5,
      "end": 4667.5,
      "formatted_start": "01:17:45.500",
      "formatted_end": "01:17:47.500",
      "text": "یک جیب میزن از دنش نفس بکنی"
    },
    {
      "id": 35,
      "start": 4667.5,
      "end": 4669.5,
      "formatted_start": "01:17:47.500",
      "formatted_end": "01:17:49.500",
      "text": "یک بکشی رو بزن"
    },
    {
      "id": 36,
      "start": 4669.5,
      "end": 4671.5,
      "formatted_start": "01:17:49.500",
      "formatted_end": "01:17:51.500",
      "text": "یک تاپیزی بایدی بایدی کنی"
    },
    {
      "id": 37,
      "start": 4671.5,
      "end": 4673.5,
      "formatted_start": "01:17:51.500",
      "formatted_end": "01:17:53.500",
      "text": "آره"
    },
    {
      "id": 38,
      "start": 4675.5,
      "end": 4677.5,
      "formatted_start": "01:17:55.500",
      "formatted_end": "01:17:57.500",
      "text": "این نفس"
    },
    {
      "id": 39,
      "start": 4677.5,
      "end": 4679.5,
      "formatted_start": "01:17:57.500",
      "formatted_end": "01:17:59.500",
      "text": "اینو میبینی؟ اینو نفس بچه رو میبنده"
    },
    {
      "id": 40,
      "start": 4679.5,
      "end": 4681.5,
      "formatted_start": "01:17:59.500",
      "formatted_end": "01:18:01.500",
      "text": "خب؟"
    },
    {
      "id": 41,
      "start": 4681.5,
      "end": 4683.5,
      "formatted_start": "01:18:01.500",
      "formatted_end": "01:18:03.500",
      "text": "یه میدن باید بیرم باشی"
    },
    {
      "id": 42,
      "start": 4683.5,
      "end": 4685.5,
      "formatted_start": "01:18:03.500",
      "formatted_end": "01:18:05.500",
      "text": "اگه خیلی هم دلتی برای خودم انجام برده"
    },
    {
      "id": 43,
      "start": 4685.5,
      "end": 4687.5,
      "formatted_start": "01:18:05.500",
      "formatted_end": "01:18:07.500",
      "text": "آره"
    },
    {
      "id": 44,
      "start": 4687.5,
      "end": 4689.5,
      "formatted_start": "01:18:07.500",
      "formatted_end": "01:18:09.500",
      "text": "یک آدم بیرمی مثل من"
    },
    {
      "id": 45,
      "start": 4689.5,
      "end": 4691.5,
      "formatted_start": "01:18:09.500",
      "formatted_end": "01:18:11.500",
      "text": "پیدا کنی"
    },
    {
      "id": 46,
      "start": 4691.5,
      "end": 4693.5,
      "formatted_start": "01:18:11.500",
      "formatted_end": "01:18:13.500",
      "text": "چون بعدن نفس بچه رو راحت بشه"
    },
    {
      "id": 47,
      "start": 4693.5,
      "end": 4695.5,
      "formatted_start": "01:18:13.500",
      "formatted_end": "01:18:15.500",
      "text": "این کارت بیامرزه منو آزاد کردیم"
    },
    {
      "id": 48,
      "start": 4695.5,
      "end": 4697.5,
      "formatted_start": "01:18:15.500",
      "formatted_end": "01:18:17.500",
      "text": "آره"
    },
    {
      "id": 49,
      "start": 4697.5,
      "end": 4702.5,
      "formatted_start": "01:18:17.500",
      "formatted_end": "01:18:22.500",
      "text": "اگه مادرش باشه به تحصیل گره دماغش پیس پیس کنه این کاری نداره"
    },
    {
      "id": 50,
      "start": 4702.5,
      "end": 4704.5,
      "formatted_start": "01:18:22.500",
      "formatted_end": "01:18:24.500",
      "text": "میبینید تره نداره"
    },
    {
      "id": 51,
      "start": 4704.5,
      "end": 4706.5,
      "formatted_start": "01:18:24.500",
      "formatted_end": "01:18:26.500",
      "text": "نه هیچ اتفاق نیم"
    },
    {
      "id": 52,
      "start": 4706.5,
      "end": 4708.5,
      "formatted_start": "01:18:26.500",
      "formatted_end": "01:18:28.500",
      "text": "این دوزون مرعبزوش داره"
    },
    {
      "id": 53,
      "start": 4708.5,
      "end": 4709.5,
      "formatted_start": "01:18:28.500",
      "formatted_end": "01:18:29.500",
      "text": "آه"
    },
    {
      "id": 54,
      "start": 4709.5,
      "end": 4710.5,
      "formatted_start": "01:18:29.500",
      "formatted_end": "01:18:30.500",
      "text": "پاشنازه"
    },
    {
      "id": 55,
      "start": 4710.5,
      "end": 4711.5,
      "formatted_start": "01:18:30.500",
      "formatted_end": "01:18:31.500",
      "text": "اونم همینجوریه"
    },
    {
      "id": 56,
      "start": 4711.5,
      "end": 4712.5,
      "formatted_start": "01:18:31.500",
      "formatted_end": "01:18:32.500",
      "text": "بیره من؟"
    },
    {
      "id": 57,
      "start": 4712.5,
      "end": 4714.5,
      "formatted_start": "01:18:32.500",
      "formatted_end": "01:18:34.500",
      "text": "آه آه"
    },
    {
      "id": 58,
      "start": 4714.5,
      "end": 4715.5,
      "formatted_start": "01:18:34.500",
      "formatted_end": "01:18:35.500",
      "text": "نه نه"
    },
    {
      "id": 59,
      "start": 4715.5,
      "end": 4717.5,
      "formatted_start": "01:18:35.500",
      "formatted_end": "01:18:37.500",
      "text": "مادر دل نداره"
    },
    {
      "id": 60,
      "start": 4717.5,
      "end": 4718.5,
      "formatted_start": "01:18:37.500",
      "formatted_end": "01:18:38.500",
      "text": "نمیبینید مادر"
    },
    {
      "id": 61,
      "start": 4718.5,
      "end": 4719.5,
      "formatted_start": "01:18:38.500",
      "formatted_end": "01:18:39.500",
      "text": "تمام"
    },
    {
      "id": 62,
      "start": 4719.5,
      "end": 4720.5,
      "formatted_start": "01:18:39.500",
      "formatted_end": "01:18:40.500",
      "text": "دست در آقایی داره"
    },
    {
      "id": 63,
      "start": 4720.5,
      "end": 4722.5,
      "formatted_start": "01:18:40.500",
      "formatted_end": "01:18:42.500",
      "text": "خوبه شما هم خود هستید"
    },
    {
      "id": 64,
      "start": 4723.5,
      "end": 4725.5,
      "formatted_start": "01:18:43.500",
      "formatted_end": "01:18:45.500",
      "text": "الان نفذ کشیدنش باز شد"
    },
    {
      "id": 65,
      "start": 4725.5,
      "end": 4727.5,
      "formatted_start": "01:18:45.500",
      "formatted_end": "01:18:47.500",
      "text": "خون میاد"
    },
    {
      "id": 66,
      "start": 4727.5,
      "end": 4729.5,
      "formatted_start": "01:18:47.500",
      "formatted_end": "01:18:49.500",
      "text": "یکم اگر خون بیاد دیگران نباشد"
    },
    {
      "id": 67,
      "start": 4729.5,
      "end": 4731.5,
      "formatted_start": "01:18:49.500",
      "formatted_end": "01:18:51.500",
      "text": "چیست؟"
    },
    {
      "id": 68,
      "start": 4731.5,
      "end": 4733.5,
      "formatted_start": "01:18:51.500",
      "formatted_end": "01:18:53.500",
      "text": "نه"
    },
    {
      "id": 69,
      "start": 4733.5,
      "end": 4735.5,
      "formatted_start": "01:18:53.500",
      "formatted_end": "01:18:55.500",
      "text": "خدا فراموش"
    },
    {
      "id": 70,
      "start": 4735.5,
      "end": 4739.5,
      "formatted_start": "01:18:55.500",
      "formatted_end": "01:18:59.500",
      "text": "یک دونه موکم خوب بزنید"
    },
    {
      "id": 71,
      "start": 4739.5,
      "end": 4741.5,
      "formatted_start": "01:18:59.500",
      "formatted_end": "01:19:01.500",
      "text": "تو بینید"
    },
    {
      "id": 72,
      "start": 4741.5,
      "end": 4743.5,
      "formatted_start": "01:19:01.500",
      "formatted_end": "01:19:03.500",
      "text": "یک ده دقیقه یک رو بزنید"
    },
    {
      "id": 73,
      "start": 4743.5,
      "end": 4745.5,
      "formatted_start": "01:19:03.500",
      "formatted_end": "01:19:05.500",
      "text": "اثراتشو خونه بعد بکشید"
    },
    {
      "id": 74,
      "start": 4745.5,
      "end": 4747.5,
      "formatted_start": "01:19:05.500",
      "formatted_end": "01:19:07.500",
      "text": "من از رنگ زدم"
    },
    {
      "id": 75,
      "start": 4753.5,
      "end": 4755.5,
      "formatted_start": "01:19:13.500",
      "formatted_end": "01:19:15.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 76,
      "start": 4755.5,
      "end": 4757.5,
      "formatted_start": "01:19:15.500",
      "formatted_end": "01:19:17.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 77,
      "start": 4757.5,
      "end": 4759.5,
      "formatted_start": "01:19:17.500",
      "formatted_end": "01:19:19.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 78,
      "start": 4759.5,
      "end": 4761.5,
      "formatted_start": "01:19:19.500",
      "formatted_end": "01:19:21.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 79,
      "start": 4761.5,
      "end": 4763.5,
      "formatted_start": "01:19:21.500",
      "formatted_end": "01:19:23.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 80,
      "start": 4763.5,
      "end": 4765.5,
      "formatted_start": "01:19:23.500",
      "formatted_end": "01:19:25.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 81,
      "start": 4765.5,
      "end": 4767.5,
      "formatted_start": "01:19:25.500",
      "formatted_end": "01:19:27.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 82,
      "start": 4767.5,
      "end": 4769.5,
      "formatted_start": "01:19:27.500",
      "formatted_end": "01:19:29.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 83,
      "start": 4769.5,
      "end": 4771.5,
      "formatted_start": "01:19:29.500",
      "formatted_end": "01:19:31.500",
      "text": "برنامه از بیشتر باید برداریم"
    },
    {
      "id": 84,
      "start": 4771.5,
      "end": 4774.8,
      "formatted_start": "01:19:31.500",
      "formatted_end": "01:19:34.800",
      "text": "شب که میخواد بخوابه دیگه از زیاده گره"
    },
    {
      "id": 85,
      "start": 4774.8,
      "end": 4775.8,
      "formatted_start": "01:19:34.800",
      "formatted_end": "01:19:35.800",
      "text": "تب اینا چی؟"
    },
    {
      "id": 86,
      "start": 4775.8,
      "end": 4778.14,
      "formatted_start": "01:19:35.800",
      "formatted_end": "01:19:38.140",
      "text": "خود بدنش گرمه ولی تب نداره خدا شما"
    },
    {
      "id": 87,
      "start": 4778.14,
      "end": 4779.04,
      "formatted_start": "01:19:38.140",
      "formatted_end": "01:19:39.040",
      "text": "کس کسی سینه؟"
    },
    {
      "id": 88,
      "start": 4779.04,
      "end": 4779.76,
      "formatted_start": "01:19:39.040",
      "formatted_end": "01:19:39.760",
      "text": "نه نه"
    },
    {
      "id": 89,
      "start": 4779.76,
      "end": 4781.06,
      "formatted_start": "01:19:39.760",
      "formatted_end": "01:19:41.060",
