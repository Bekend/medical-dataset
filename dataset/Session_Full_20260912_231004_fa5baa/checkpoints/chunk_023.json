      "text": "بعدم، هی میتونیم، این برای اینشو کاسیبه ما خوب بشه، مردم تراپوروشی ها، تراپوروشی ها، بازار میچرخه، آره، خب؟"
    },
    {
      "id": 2,
      "start": 6926.0,
      "end": 6928.0,
      "formatted_start": "01:55:26.000",
      "formatted_end": "01:55:28.000",
      "text": "بیا این دیگه زنم"
    },
    {
      "id": 3,
      "start": 6928.0,
      "end": 6930.0,
      "formatted_start": "01:55:28.000",
      "formatted_end": "01:55:30.000",
      "text": "این کار در مسئولانم خالی میشن"
    },
    {
      "id": 4,
      "start": 6930.0,
      "end": 6933.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:33.000",
      "text": "مسئولان این چی؟ در مسئولان این کیه؟"
    },
    {
      "id": 5,
      "start": 6933.0,
      "end": 6935.0,
      "formatted_start": "01:55:33.000",
      "formatted_end": "01:55:35.000",
      "text": "من زخترم مسئول هست"
    },
    {
      "id": 6,
      "start": 6935.0,
      "end": 6936.0,
      "formatted_start": "01:55:35.000",
      "formatted_end": "01:55:36.000",
      "text": "اصلا پول نمیشه"
    },
    {
      "id": 7,
      "start": 6936.0,
      "end": 6937.0,
      "formatted_start": "01:55:36.000",
      "formatted_end": "01:55:37.000",
      "text": "اینجا خوبه؟"
    },
    {
      "id": 8,
      "start": 6937.0,
      "end": 6939.0,
      "formatted_start": "01:55:37.000",
      "formatted_end": "01:55:39.000",
      "text": "بیا بلاتر"
    },
    {
      "id": 9,
      "start": 6939.0,
      "end": 6940.0,
      "formatted_start": "01:55:39.000",
      "formatted_end": "01:55:40.000",
      "text": "بیا بلاتر"
    },
    {
      "id": 10,
      "start": 6940.0,
      "end": 6942.0,
      "formatted_start": "01:55:40.000",
      "formatted_end": "01:55:42.000",
      "text": "اینجا خوبه؟"
    },
    {
      "id": 11,
      "start": 6942.0,
      "end": 6944.0,
      "formatted_start": "01:55:42.000",
      "formatted_end": "01:55:44.000",
      "text": "بیا اون پایینو بره"
    },
    {
      "id": 12,
      "start": 6944.0,
      "end": 6946.0,
      "formatted_start": "01:55:44.000",
      "formatted_end": "01:55:46.000",
      "text": "پایین"
    },
    {
      "id": 13,
      "start": 6946.0,
      "end": 6949.0,
      "formatted_start": "01:55:46.000",
      "formatted_end": "01:55:49.000",
      "text": "اینجا خوبه؟ یکم پایی تر"
    },
    {
      "id": 14,
      "start": 6949.0,
      "end": 6951.0,
      "formatted_start": "01:55:49.000",
      "formatted_end": "01:55:51.000",
      "text": "خوبه؟"
    },
    {
      "id": 15,
      "start": 6951.0,
      "end": 6952.0,
      "formatted_start": "01:55:51.000",
      "formatted_end": "01:55:52.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 6952.0,
      "end": 6953.0,
      "formatted_start": "01:55:52.000",
      "formatted_end": "01:55:53.000",
      "text": "آره"
    },
    {
      "id": 17,
      "start": 6953.0,
      "end": 6955.0,
      "formatted_start": "01:55:53.000",
      "formatted_end": "01:55:55.000",
      "text": "کاشناس هم نظر بدی؟"
    },
    {
      "id": 18,
      "start": 6955.0,
      "end": 6957.0,
      "formatted_start": "01:55:55.000",
      "formatted_end": "01:55:57.000",
      "text": "نه، من نظر بدی"
    },
    {
      "id": 19,
      "start": 6957.0,
      "end": 6959.0,
      "formatted_start": "01:55:57.000",
      "formatted_end": "01:55:59.000",
      "text": "کاشناس پنج نظر بده؟"
    },
    {
      "id": 20,
      "start": 6959.0,
      "end": 6961.0,
      "formatted_start": "01:55:59.000",
      "formatted_end": "01:56:01.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 6961.0,
      "end": 6963.0,
      "formatted_start": "01:56:01.000",
      "formatted_end": "01:56:03.000",
      "text": "خوبه؟"
    },
    {
      "id": 22,
      "start": 6963.0,
      "end": 6965.0,
      "formatted_start": "01:56:03.000",
      "formatted_end": "01:56:05.000",
      "text": "دست نزده"
    },
    {
      "id": 23,
      "start": 6965.0,
      "end": 6967.0,
      "formatted_start": "01:56:05.000",
      "formatted_end": "01:56:07.000",
      "text": "دست نزده"
    },
    {
      "id": 24,
      "start": 6967.0,
      "end": 6969.0,
      "formatted_start": "01:56:07.000",
      "formatted_end": "01:56:09.000",
      "text": "خوبه؟"
    },
    {
      "id": 25,
      "start": 6969.0,
      "end": 6971.0,
      "formatted_start": "01:56:09.000",
      "formatted_end": "01:56:11.000",
      "text": "آن بارش هم باید نیست"
    },
    {
      "id": 26,
      "start": 6971.0,
      "end": 6973.0,
      "formatted_start": "01:56:11.000",
      "formatted_end": "01:56:13.000",
      "text": "اینها یک کامپیتر بیست"
    },
    {
      "id": 27,
      "start": 6973.0,
      "end": 6975.0,
      "formatted_start": "01:56:13.000",
      "formatted_end": "01:56:15.000",
      "text": "یکم بار باید نیست"
    },
    {
      "id": 28,
      "start": 6975.0,
      "end": 6977.0,
      "formatted_start": "01:56:15.000",
      "formatted_end": "01:56:17.000",
      "text": "خوابه ده پنج نفر تمام"
    },
    {
      "id": 29,
      "start": 6977.0,
      "end": 6979.0,
      "formatted_start": "01:56:17.000",
      "formatted_end": "01:56:19.000",
      "text": "خوب"
    },
    {
      "id": 30,
      "start": 6979.0,
      "end": 6981.0,
      "formatted_start": "01:56:19.000",
      "formatted_end": "01:56:21.000",
      "text": "درد داره"
    },
    {
      "id": 31,
      "start": 6981.0,
      "end": 6986.0,
      "formatted_start": "01:56:21.000",
      "formatted_end": "01:56:26.000",
      "text": "برای تو باید با یک بسم الله الرحمن الرحیم گفتن"
    },
    {
      "id": 32,
      "start": 6986.0,
      "end": 6989.0,
      "formatted_start": "01:56:26.000",
      "formatted_end": "01:56:29.000",
      "text": "خوب و"
    },
    {
      "id": 33,
      "start": 6989.0,
      "end": 6996.0,
      "formatted_start": "01:56:29.000",
      "formatted_end": "01:56:36.000",
      "text": "تو دیگه جزش نده"
    },
    {
      "id": 34,
      "start": 6996.0,
      "end": 6998.0,
      "formatted_start": "01:56:36.000",
      "formatted_end": "01:56:38.000",
      "text": "تمام شد"
    },
    {
      "id": 35,
      "start": 6998.0,
      "end": 7001.0,
      "formatted_start": "01:56:38.000",
      "formatted_end": "01:56:41.000",
      "text": "خوب بیا با کن"
    },
    {
      "id": 36,
      "start": 7001.0,
      "end": 7006.0,
      "formatted_start": "01:56:41.000",
      "formatted_end": "01:56:46.000",
      "text": "خوبه؟"
    },
    {
      "id": 37,
      "start": 7006.0,
      "end": 7007.0,
      "formatted_start": "01:56:46.000",
      "formatted_end": "01:56:47.000",
      "text": "آهانه یعنی جاش خوبه"
    },
    {
      "id": 38,
      "start": 7007.0,
      "end": 7009.0,
      "formatted_start": "01:56:47.000",
      "formatted_end": "01:56:49.000",
      "text": "جاش خوبه تمام"
    },
    {
      "id": 39,
      "start": 7009.0,
      "end": 7012.0,
      "formatted_start": "01:56:49.000",
      "formatted_end": "01:56:52.000",
      "text": "درد داشت؟ آفرین"
    },
    {
      "id": 40,
      "start": 7012.0,
      "end": 7014.0,
      "formatted_start": "01:56:52.000",
      "formatted_end": "01:56:54.000",
      "text": "دست سیه"
    },
    {
      "id": 41,
      "start": 7014.0,
      "end": 7018.0,
      "formatted_start": "01:56:54.000",
      "formatted_end": "01:56:58.000",
      "text": "من پایینم همین داشتم"
    },
    {
      "id": 42,
      "start": 7018.0,
      "end": 7019.0,
      "formatted_start": "01:56:58.000",
      "formatted_end": "01:56:59.000",
      "text": "پایینی که؟"
    },
    {
      "id": 43,
      "start": 7019.0,
      "end": 7021.0,
      "formatted_start": "01:56:59.000",
      "formatted_end": "01:57:01.000",
      "text": "پایین دو با این ها"
    },
    {
      "id": 44,
      "start": 7021.0,
      "end": 7022.0,
      "formatted_start": "01:57:01.000",
      "formatted_end": "01:57:02.000",
      "text": "کشوره خوب؟"
    },
    {
      "id": 45,
      "start": 7022.0,
      "end": 7023.0,
      "formatted_start": "01:57:02.000",
      "formatted_end": "01:57:03.000",
      "text": "مثل این"
    },
    {
      "id": 46,
      "start": 7023.0,
      "end": 7024.0,
      "formatted_start": "01:57:03.000",
      "formatted_end": "01:57:04.000",
      "text": "مثل این درد نداشت؟"
    },
    {
      "id": 47,
      "start": 7024.0,
      "end": 7025.0,
      "formatted_start": "01:57:04.000",
      "formatted_end": "01:57:05.000",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 7025.0,
      "end": 7027.0,
      "formatted_start": "01:57:05.000",
      "formatted_end": "01:57:07.000",
      "text": "آفرین تو دختر شجاعی هست"
    },
    {
      "id": 49,
      "start": 7027.0,
      "end": 7030.0,
      "formatted_start": "01:57:07.000",
      "formatted_end": "01:57:10.000",
      "text": "من هم این حرف ها رو زدم که نترسی"
    },
    {
      "id": 50,
      "start": 7030.0,
      "end": 7033.0,
      "formatted_start": "01:57:10.000",
      "formatted_end": "01:57:13.000",
      "text": "نمی زدم آدم شاید میترسی"
    },
    {
      "id": 51,
      "start": 7035.0,
      "end": 7037.0,
      "formatted_start": "01:57:15.000",
      "formatted_end": "01:57:17.000",
      "text": "ترسوندم ات که؟"
    },
    {
      "id": 52,
      "start": 7037.0,
      "end": 7041.0,
      "formatted_start": "01:57:17.000",
      "formatted_end": "01:57:21.000",
      "text": "خوش اینوری کنید"
    },
    {
      "id": 53,
      "start": 7041.0,
      "end": 7043.0,
      "formatted_start": "01:57:21.000",
      "formatted_end": "01:57:23.000",
      "text": "خوش اینوری"
    },
    {
      "id": 54,
      "start": 7043.0,
      "end": 7045.0,
      "formatted_start": "01:57:23.000",
      "formatted_end": "01:57:25.000",
      "text": "پشنگ برگردیم"
    },
    {
      "id": 55,
      "start": 7045.0,
      "end": 7049.0,
      "formatted_start": "01:57:25.000",
      "formatted_end": "01:57:29.000",
      "text": "از این نقطه را بزرگ بگیریم"
    },
    {
      "id": 56,
      "start": 7049.0,
      "end": 7053.0,
      "formatted_start": "01:57:29.000",
      "formatted_end": "01:57:33.000",
      "text": "تمیز را خوشید"
    },
    {
      "id": 57,
      "start": 7053.0,
      "end": 7055.0,
      "formatted_start": "01:57:33.000",
      "formatted_end": "01:57:35.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 58,
      "start": 7055.0,
      "end": 7059.0,
      "formatted_start": "01:57:35.000",
      "formatted_end": "01:57:39.000",
      "text": "این یکی یک نقطه بالاتر است"
    },
    {
      "id": 59,
      "start": 7059.0,
      "end": 7061.0,
      "formatted_start": "01:57:39.000",
      "formatted_end": "01:57:41.000",
      "text": "دیکار کن من دیکار کن"
    },
    {
      "id": 60,
      "start": 7061.0,
      "end": 7063.0,
      "formatted_start": "01:57:41.000",
      "formatted_end": "01:57:43.000",
      "text": "این گوش تا این گوش فاصله سیاد است"
    },
    {
      "id": 61,
      "start": 7063.0,
      "end": 7065.0,
      "formatted_start": "01:57:43.000",
      "formatted_end": "01:57:45.000",
      "text": "این گوش تا این گوش"
    },
    {
      "id": 62,
      "start": 7065.0,
      "end": 7067.0,
      "formatted_start": "01:57:45.000",
      "formatted_end": "01:57:47.000",
      "text": "یکم بالاتر شد نترس کن"
    },
    {
      "id": 63,
      "start": 7069.0,
      "end": 7070.0,
      "formatted_start": "01:57:49.000",
      "formatted_end": "01:57:50.000",
      "text": "خوبه؟"
    },
    {
      "id": 64,
      "start": 7070.0,
      "end": 7072.0,
      "formatted_start": "01:57:50.000",
      "formatted_end": "01:57:52.000",
      "text": "پایین رو بزار پایین"
    },
    {
      "id": 65,
      "start": 7072.0,
      "end": 7074.0,
      "formatted_start": "01:57:52.000",
      "formatted_end": "01:57:54.000",
      "text": "پایین رو بزار پایین فکر نکن"
    },
    {
      "id": 66,
      "start": 7086.0,
      "end": 7088.0,
      "formatted_start": "01:58:06.000",
      "formatted_end": "01:58:08.000",
      "text": "بگی یکم درد کنش نیسته؟"
    },
    {
      "id": 67,
      "start": 7088.0,
      "end": 7089.0,
      "formatted_start": "01:58:08.000",
      "formatted_end": "01:58:09.000",
      "text": "آه؟"
    },
    {
      "id": 68,
      "start": 7089.0,
      "end": 7091.0,
      "formatted_start": "01:58:09.000",
      "formatted_end": "01:58:11.000",
      "text": "مثل همون بود؟"
    },
    {
      "id": 69,
      "start": 7091.0,
      "end": 7093.0,
      "formatted_start": "01:58:11.000",
      "formatted_end": "01:58:13.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 70,
      "start": 7093.0,
      "end": 7095.0,
      "formatted_start": "01:58:13.000",
      "formatted_end": "01:58:15.000",
      "text": "یکم بالا پایینشو فکر نکنو"
    },
    {
      "id": 71,
      "start": 7095.0,
      "end": 7096.0,
      "formatted_start": "01:58:15.000",
      "formatted_end": "01:58:16.000",
      "text": "آه؟"
    },
    {
      "id": 72,
      "start": 7096.0,
      "end": 7098.0,
      "formatted_start": "01:58:16.000",
      "formatted_end": "01:58:18.000",
      "text": "ولی خوبه"
    },
    {
      "id": 73,
      "start": 7098.0,
      "end": 7100.0,
      "formatted_start": "01:58:18.000",
      "formatted_end": "01:58:20.000",
      "text": "آه؟"
    },
    {
      "id": 74,
      "start": 7100.0,
      "end": 7102.0,
      "formatted_start": "01:58:20.000",
      "formatted_end": "01:58:22.000",
      "text": "نه آره چون به این دوتا سی کم بیشتر فاصله"
    },
    {
      "id": 75,
      "start": 7102.0,
      "end": 7104.0,
      "formatted_start": "01:58:22.000",
      "formatted_end": "01:58:24.000",
      "text": "بله این فاصله اون بیر برقرار نیم"
    },
    {
      "id": 76,
      "start": 7104.0,
      "end": 7106.0,
      "formatted_start": "01:58:24.000",
      "formatted_end": "01:58:26.000",
      "text": "این گوش چون فاصله اون داده من باید"
    },
    {
      "id": 77,
      "start": 7106.0,
      "end": 7108.0,
      "formatted_start": "01:58:26.000",
      "formatted_end": "01:58:28.000",
      "text": "با این دوتا آخری"
    },
    {
      "id": 78,
      "start": 7108.0,
      "end": 7109.0,
      "formatted_start": "01:58:28.000",
      "formatted_end": "01:58:29.000",
      "text": "تراث کردم خب؟"
    },
    {
      "id": 79,
      "start": 7109.0,
      "end": 7110.0,
      "formatted_start": "01:58:29.000",
      "formatted_end": "01:58:30.000",
      "text": "بس چون نمی کنیم"
    },
    {
      "id": 80,
      "start": 7110.0,
      "end": 7111.0,
      "formatted_start": "01:58:30.000",
      "formatted_end": "01:58:31.000",
      "text": "تمام یه پنگ قدم ببینیسم"
    },
    {
      "id": 81,
      "start": 7111.0,
      "end": 7112.0,
      "formatted_start": "01:58:31.000",
      "formatted_end": "01:58:32.000",
      "text": "باشه"
    },
    {
      "id": 82,
      "start": 7112.0,
      "end": 7113.0,
      "formatted_start": "01:58:32.000",
      "formatted_end": "01:58:33.000",
      "text": "زیاد نمی کنم"
    },
    {
      "id": 83,
      "start": 7113.0,
      "end": 7114.0,
      "formatted_start": "01:58:33.000",
      "formatted_end": "01:58:34.000",
      "text": "آره"
    },
    {
      "id": 84,
      "start": 7114.0,
      "end": 7115.0,
      "formatted_start": "01:58:34.000",
      "formatted_end": "01:58:35.000",
      "text": "هرچی تنظیم مشانه داری؟"
    },
    {
      "id": 85,
      "start": 7115.0,
      "end": 7117.0,
      "formatted_start": "01:58:35.000",
      "formatted_end": "01:58:37.000",
      "text": "نه خوبه خانوشه اینا به این گوشا"
    },
    {
      "id": 86,
      "start": 7117.0,
      "end": 7120.2,
      "formatted_start": "01:58:37.000",
      "formatted_end": "01:58:40.200",
      "text": "اون ایوری یکم بشکرستم، حالا پایین گوشتراخ کردیم"
    },
    {
      "id": 87,
      "start": 7120.2,
      "end": 7120.7,
      "formatted_start": "01:58:40.200",
      "formatted_end": "01:58:40.700",
      "text": "آره"
    },
    {
      "id": 88,
      "start": 7120.7,
      "end": 7123.2,
      "formatted_start": "01:58:40.700",
      "formatted_end": "01:58:43.200",
      "text": "ولی همراه خوبه، از این زیاد اصلا"
    },
    {
      "id": 89,
      "start": 7123.2,
      "end": 7128.7,
      "formatted_start": "01:58:43.200",
      "formatted_end": "01:58:48.700",
      "text": "بعدن دو روز دیگه اینا رو نگاه نمی کنیم کدامی که چیزه و یک کمون بالاتره بخواکر همه اینا رفته بالا"
    },
    {
      "id": 90,
      "start": 7128.7,
      "end": 7129.2,
      "formatted_start": "01:58:48.700",
      "formatted_end": "01:58:49.200",
      "text": "آره"
    },
    {
      "id": 91,
      "start": 7129.2,
      "end": 7130.6,
      "formatted_start": "01:58:49.200",
      "formatted_end": "01:58:50.600",
      "text": "ردیف اولی بر آمده شده؟"
    },
    {
      "id": 92,
      "start": 7130.6,
      "end": 7131.1,
      "formatted_start": "01:58:50.600",
      "formatted_end": "01:58:51.100",
      "text": "آره"
    },
    {
      "id": 93,
      "start": 7131.1,
      "end": 7132.6,
      "formatted_start": "01:58:51.100",
      "formatted_end": "01:58:52.600",
      "text": "اون ردیف اولی بال آمده"
    },
    {
      "id": 94,
      "start": 7133.1,
      "end": 7136.3,
      "formatted_start": "01:58:53.100",
      "formatted_end": "01:58:56.300",
      "text": "این ها در اصل اونکه گوشواره بندازی کمالی"
    },
    {
      "id": 95,
      "start": 7136.6,
      "end": 7137.1,
      "formatted_start": "01:58:56.600",
      "formatted_end": "01:58:57.100",
      "text": "بله"
    },
    {
      "id": 96,
      "start": 7137.1,
      "end": 7137.4,
      "formatted_start": "01:58:57.100",
      "formatted_end": "01:58:57.400",
      "text": "خب بیا"
    },
    {
      "id": 97,
      "start": 7137.4,
      "end": 7142.4,
      "formatted_start": "01:58:57.400",
      "formatted_end": "01:59:02.400",
      "text": "دو هفته دیگه در بیام این فماد هم یه پنج روزی بزن"
    },
    {
      "id": 98,
      "start": 7142.4,
      "end": 7145.4,
      "formatted_start": "01:59:02.400",
      "formatted_end": "01:59:05.400",
      "text": "هموم تا فردا نره"
    },
    {
      "id": 99,
      "start": 7145.4,
      "end": 7149.4,
      "formatted_start": "01:59:05.400",
      "formatted_end": "01:59:09.400",
      "text": "بله آب و نمک شده اونو نه نه"
    },
    {
      "id": 100,
      "start": 7149.4,
      "end": 7150.4,
      "formatted_start": "01:59:09.400",
      "formatted_end": "01:59:10.400",
      "text": "چرا؟"
    },
    {
      "id": 101,
      "start": 7150.4,
      "end": 7152.4,
      "formatted_start": "01:59:10.400",
      "formatted_end": "01:59:12.400",
      "text": "نه نه این حالت چیه؟"
    },
    {
      "id": 102,
      "start": 7152.4,
      "end": 7154.4,
      "formatted_start": "01:59:12.400",
      "formatted_end": "01:59:14.400",
      "text": "همین فماد بزن آب و نمک نزن و فونت میکنن"
    },
    {
      "id": 103,
      "start": 7154.4,
      "end": 7155.4,
      "formatted_start": "01:59:14.400",
      "formatted_end": "01:59:15.400",
      "text": "نه خب باشه"
    },
    {
      "id": 104,
      "start": 7155.4,
      "end": 7156.4,
      "formatted_start": "01:59:15.400",
      "formatted_end": "01:59:16.400",
      "text": "هیچ چی نزن خب؟"
    },
    {
      "id": 105,
      "start": 7156.4,
      "end": 7158.4,
      "formatted_start": "01:59:16.400",
      "formatted_end": "01:59:18.400",
      "text": "ببین گوشگاه رو سه تا کار میکنه"
    },
    {
      "id": 106,
      "start": 7158.4,
      "end": 7161.4,
      "formatted_start": "01:59:18.400",
      "formatted_end": "01:59:21.400",
      "text": "تا فردا هموم نبر این خودشو بگیره"
    },
    {
      "id": 107,
      "start": 7161.4,
      "end": 7164.4,
      "formatted_start": "01:59:21.400",
      "formatted_end": "01:59:24.400",
      "text": "فماد تا چهار پنج روز میزنی"
    },
    {
      "id": 108,
      "start": 7164.4,
      "end": 7167.06,
      "formatted_start": "01:59:24.400",
      "formatted_end": "01:59:27.060",
      "text": "دو هفته دیگه کشوره رو در می آرید"
    },
    {
      "id": 109,
      "start": 7167.06,
      "end": 7168.94,
      "formatted_start": "01:59:27.060",
      "formatted_end": "01:59:28.940",
      "text": "کشوره نخشیزی می زنید"
    },
    {
      "id": 110,
      "start": 7168.94,
      "end": 7169.76,
      "formatted_start": "01:59:28.940",
      "formatted_end": "01:59:29.760",
      "text": "بیدیم به سلامت"
    },
    {
      "id": 111,
      "start": 7169.76,
      "end": 7171.58,
      "formatted_start": "01:59:29.760",
      "formatted_end": "01:59:31.580",
      "text": "خیلی ممنون"
    }
  ],
  "status": "completed"
}