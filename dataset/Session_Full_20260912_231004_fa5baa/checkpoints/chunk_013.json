      "id": 77,
      "start": 4136.0,
      "end": 4137.0,
      "formatted_start": "01:08:56.000",
      "formatted_end": "01:08:57.000",
      "text": "تمام"
    },
    {
      "id": 78,
      "start": 4137.0,
      "end": 4138.0,
      "formatted_start": "01:08:57.000",
      "formatted_end": "01:08:58.000",
      "text": "که وقتی صورت ميخواده تو صورت میکنه؟"
    },
    {
      "id": 79,
      "start": 4138.0,
      "end": 4139.0,
      "formatted_start": "01:08:58.000",
      "formatted_end": "01:08:59.000",
      "text": "اسمی چیه؟"
    },
    {
      "id": 80,
      "start": 4139.0,
      "end": 4140.0,
      "formatted_start": "01:08:59.000",
      "formatted_end": "01:09:00.000",
      "text": "مهدیس"
    },
    {
      "id": 81,
      "start": 4140.0,
      "end": 4142.0,
      "formatted_start": "01:09:00.000",
      "formatted_end": "01:09:02.000",
      "text": "مهدیس الان خوب بود"
    },
    {
      "id": 82,
      "start": 4142.0,
      "end": 4144.0,
      "formatted_start": "01:09:02.000",
      "formatted_end": "01:09:04.000",
      "text": "خلاد چندومی؟"
    },
    {
      "id": 83,
      "start": 4144.0,
      "end": 4146.0,
      "formatted_start": "01:09:04.000",
      "formatted_end": "01:09:06.000",
      "text": "اون خمک کار رو بیدیم"
    },
    {
      "id": 84,
      "start": 4146.0,
      "end": 4148.0,
      "formatted_start": "01:09:06.000",
      "formatted_end": "01:09:08.000",
      "text": "و چند تا خوهر بردیدید اونجور؟"
    },
    {
      "id": 85,
      "start": 4148.0,
      "end": 4150.0,
      "formatted_start": "01:09:08.000",
      "formatted_end": "01:09:10.000",
      "text": "یه خوهر"
    },
    {
      "id": 86,
      "start": 4150.0,
      "end": 4152.0,
      "formatted_start": "01:09:10.000",
      "formatted_end": "01:09:12.000",
      "text": "چند تا بردر نداری؟"
    },
    {
      "id": 87,
      "start": 4152.0,
      "end": 4154.0,
      "formatted_start": "01:09:12.000",
      "formatted_end": "01:09:14.000",
      "text": "بردر هستم"
    },
    {
      "id": 88,
      "start": 4154.0,
      "end": 4156.0,
      "formatted_start": "01:09:14.000",
      "formatted_end": "01:09:16.000",
      "text": "دوست داشتی بردر داشته باشی؟"
    },
    {
      "id": 89,
      "start": 4156.0,
      "end": 4158.0,
      "formatted_start": "01:09:16.000",
      "formatted_end": "01:09:18.000",
      "text": "حالا یا نه؟ بگو"
    },
    {
      "id": 90,
      "start": 4158.0,
      "end": 4160.0,
      "formatted_start": "01:09:18.000",
      "formatted_end": "01:09:20.000",
      "text": "خیلی دارد نکش نه؟"
    },
    {
      "id": 91,
      "start": 4160.0,
      "end": 4162.0,
      "formatted_start": "01:09:20.000",
      "formatted_end": "01:09:22.000",
      "text": "خب بیتر کسی قولو رو سرد نکش"
    },
    {
      "id": 92,
      "start": 4162.0,
      "end": 4164.0,
      "formatted_start": "01:09:22.000",
      "formatted_end": "01:09:24.000",
      "text": "بینجو"
    },
    {
      "id": 93,
      "start": 4164.0,
      "end": 4166.0,
      "formatted_start": "01:09:24.000",
      "formatted_end": "01:09:26.000",
      "text": "خب شما این چیزی نماشو گیره"
    },
    {
      "id": 94,
      "start": 4166.0,
      "end": 4168.0,
      "formatted_start": "01:09:26.000",
      "formatted_end": "01:09:28.000",
      "text": "یه افرادیه"
    },
    {
      "id": 95,
      "start": 4168.0,
      "end": 4170.0,
      "formatted_start": "01:09:28.000",
      "formatted_end": "01:09:30.000",
      "text": "یکم تو دماغی هفت میدن"
