  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3008.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:08.000",
      "text": "می توانید که دنبال دست دارد که به تغییر شعرها میگرد باشند، به دنبال معنی، به دنبال معنی بیادند."
    },
    {
      "id": 1,
      "start": 3008.0,
      "end": 3019.0,
      "formatted_start": "00:50:08.000",
      "formatted_end": "00:50:19.000",
      "text": "حالا معنی را یا تو آرمان های اخلاقی می بینند، یا تو آرمان های اجتماعی می بینند، یا تو آرمان های لماچه راختی می بینند،"
    },
    {
      "id": 2,
      "start": 3019.0,
      "end": 3024.0,
      "formatted_start": "00:50:19.000",
      "formatted_end": "00:50:24.000",
      "text": "یا تو دو تا هر دیگه دست آرمان ها می بینند، یا تو هر سه تایی دست آرمان ها می بینند،"
    },
    {
      "id": 3,
      "start": 3024.0,
      "end": 3053.5,
      "formatted_start": "00:50:24.000",
      "formatted_end": "00:50:53.500",
      "text": "و به نظر بعدی، هر کنیدن ی آدم های قسم چهارونم ببینند که به اون راه آدم هایی که قائد فراد بوده، مهندی، تاجمونی، دموخانی، که در اعتصال خدا، در تقلیل روی به خدا، در پیوستن به نیروانه، در رویدن از شرطه سمسره، در فلانه، در موارد دامون، یا آدم هایی که مهندی به مهند اخصند"
    },
    {
      "id": 4,
      "start": 3053.5,
      "end": 3065.66,
      "formatted_start": "00:50:53.500",
      "formatted_end": "00:51:05.660",
      "text": "یعنی معنی به معنی روحانی، تکناتی که نه اخلاقی هستن، نه از قسمتی اجتماعی هستن، نه روحانی هستن، روحانی هستن، نه می کنید"
    },
    {
      "id": 5,
      "start": 3065.66,
      "end": 3073.74,
      "formatted_start": "00:51:05.660",
      "formatted_end": "00:51:13.740",
      "text": "خب همه به این آلمان های دسته چهارم قائد نیستن، ولی خب کسانی هم اصلا چهارم، به دسته چهارم قائد هستن"
    },
    {
      "id": 6,
      "start": 3073.74,
      "end": 3086.74,
      "formatted_start": "00:51:13.740",
      "formatted_end": "00:51:26.740",
      "text": "خب از دسته یه هم از انسان ها که سامی میشن که نه به اتفاقا اهل شهر و نیردستن، اهل معنویتن و سلیم کلادی که از این چند تا آرمان رو انتخاب کنن هم با هم فرق کنن."
    },
    {
      "id": 7,
      "start": 3086.74,
      "end": 3100.74,
      "formatted_start": "00:51:26.740",
      "formatted_end": "00:51:40.740",
      "text": "این ها، زبونیات زدگی نقی پردازن. این هم به جهازی بود که اگه زبونیات زدگیشون برابر نشه اصلا عمق ندارن، تا این عمق و ترپین معنویتنشون کنن"
    },
    {
      "id": 8,
      "start": 3100.74,
      "end": 3105.74,
      "formatted_start": "00:51:40.740",
      "formatted_end": "00:51:45.740",
      "text": "و توی مقلشون از لحاظ معلقی چیه و چابوک بشن"
    },
    {
      "id": 9,
      "start": 3105.74,
      "end": 3114.74,
      "formatted_start": "00:51:45.740",
      "formatted_end": "00:51:54.740",
      "text": "یک دسته سمومی هستن که اینا هر شهربانیت رو می کنن همه"
    },
    {
      "id": 10,
      "start": 3114.74,
      "end": 3119.74,
      "formatted_start": "00:51:54.740",
      "formatted_end": "00:51:59.740",
      "text": "یعنی نمیتونن از این چشم رو پوشن"
    },
    {
      "id": 11,
      "start": 3119.74,
      "end": 3122.74,
      "formatted_start": "00:51:59.740",
      "formatted_end": "00:52:02.740",
      "text": "نمیتونن از این چشم رو پوشن"
    },
    {
      "id": 12,
      "start": 3122.74,
      "end": 3128.74,
      "formatted_start": "00:52:02.740",
      "formatted_end": "00:52:08.740",
      "text": "خب این یک دسته سمومی هست که ادار دلیل بدونی من"
    },
    {
      "id": 13,
      "start": 3128.74,
      "end": 3140.46,
      "formatted_start": "00:52:08.740",
      "formatted_end": "00:52:20.460",
      "text": "مدیره هم وقتی که اهمیتیاتون از صحنگی دلشون پرواز میدونه برای اخلاقی بودن"
    },
    {
      "id": 14,
      "start": 3140.46,
      "end": 3146.96,
      "formatted_start": "00:52:20.460",
      "formatted_end": "00:52:26.960",
      "text": "هم وقتی که از دست دارتون برداشت که خوددلشون البته باوش میکرده برای که"
    },
    {
      "id": 15,
      "start": 3146.96,
      "end": 3153.12,
      "formatted_start": "00:52:26.960",
      "formatted_end": "00:52:33.120",
      "text": "کاشه کن من این دست دارم به چشم به این کامل درم هم برسم و به همین"
    },
    {
      "id": 16,
      "start": 3153.12,
      "end": 3160.0,
      "formatted_start": "00:52:33.120",
      "formatted_end": "00:52:40.000",
      "text": "این هم راسته یه سه بار در یک تقسیم در دست چهار رو مانگوید"
    },
    {
      "id": 17,
      "start": 3160.0,
      "end": 3162.12,
      "formatted_start": "00:52:40.000",
      "formatted_end": "00:52:42.120",
      "text": "یعنی که سانتی نه"
    },
    {
      "id": 18,
      "start": 3162.12,
      "end": 3164.12,
      "formatted_start": "00:52:42.120",
      "formatted_end": "00:52:44.120",
      "text": "بله بخونم"
    },
    {
      "id": 19,
      "start": 3164.12,
      "end": 3169.6,
      "formatted_start": "00:52:44.120",
      "formatted_end": "00:52:49.600",
      "text": "خب ببینید این فرصه اچ بعد از خضا"
    },
    {
      "id": 20,
      "start": 3169.6,
      "end": 3172.36,
      "formatted_start": "00:52:49.600",
      "formatted_end": "00:52:52.360",
      "text": "یه زنی ببینید چهار وز شم روزی سه بار"
    },
    {
      "id": 21,
      "start": 3172.36,
      "end": 3177.4,
      "formatted_start": "00:52:52.360",
      "formatted_end": "00:52:57.400",
      "text": "دوتا هم پول هم داره و خودیدن نصف تا دو سه بار بیزن کامل ندنم بهش"
    },
    {
      "id": 22,
      "start": 3177.4,
      "end": 3179.36,
      "formatted_start": "00:52:57.400",
      "formatted_end": "00:52:59.360",
      "text": "از غرض کدور دو سه بار بیزن"
    },
    {
      "id": 23,
      "start": 3179.36,
      "end": 3183.08,
      "formatted_start": "00:52:59.360",
      "formatted_end": "00:53:03.080",
      "text": "خواهیم به خانسن بیدید خانسن رو دیده دو سه بار بیزن دور جوانه"
    },
    {
      "id": 24,
      "start": 3183.08,
      "end": 3189.48,
      "formatted_start": "00:53:03.080",
      "formatted_end": "00:53:09.480",
      "text": "این برسون مشکل اینجا نیست چون برزون فاتوری خوبی ندارد"
    },
    {
      "id": 25,
      "start": 3189.48,
      "end": 3194.2,
      "formatted_start": "00:53:09.480",
      "formatted_end": "00:53:14.200",
      "text": "چون مادر هم استفاده می کند که بیماری پوستی است"
    },
    {
      "id": 26,
      "start": 3194.2,
      "end": 3197.08,
      "formatted_start": "00:53:14.200",
      "formatted_end": "00:53:17.080",
      "text": "زیاد استفاده کنند و برهم می دازد و پوک می کند"
    },
    {
      "id": 27,
      "start": 3197.08,
      "end": 3199.08,
      "formatted_start": "00:53:17.080",
      "formatted_end": "00:53:19.080",
      "text": "اون کشنگوییت جوانده"
    },
    {
      "id": 28,
      "start": 3199.08,
      "end": 3201.08,
      "formatted_start": "00:53:19.080",
      "formatted_end": "00:53:21.080",
      "text": "و کمفیگوست هست"
    },
    {
      "id": 29,
      "start": 3201.08,
      "end": 3206.6,
      "formatted_start": "00:53:21.080",
      "formatted_end": "00:53:26.600",
      "text": "نه اینها ما مثلا ده داری که می شویم برای سه روز می دهیم"
    },
    {
      "id": 30,
      "start": 3206.6,
      "end": 3211.08,
      "formatted_start": "00:53:26.600",
      "formatted_end": "00:53:31.080",
      "text": "پوک مادر تو شاید سه ماه شیش ماه یه سال هم استفاده کردی"
    },
    {
      "id": 31,
      "start": 3211.08,
      "end": 3215.48,
      "formatted_start": "00:53:31.080",
      "formatted_end": "00:53:35.480",
      "text": "هفت سال، بعد اون اغارت داره طولانی مدت"
    },
    {
      "id": 32,
      "start": 3215.48,
      "end": 3219.48,
      "formatted_start": "00:53:35.480",
      "formatted_end": "00:53:39.480",
      "text": "برم میدازه کلیه و همه آره این"
    },
    {
      "id": 33,
      "start": 3219.48,
      "end": 3222.48,
      "formatted_start": "00:53:39.480",
      "formatted_end": "00:53:42.480",
      "text": "دارو مثل نمکه"
    },
    {
      "id": 34,
      "start": 3222.48,
      "end": 3227.48,
      "formatted_start": "00:53:42.480",
      "formatted_end": "00:53:47.480",
      "text": "نمک اندازش خوبه، زیاد که بزنی شروع میشه یک کم هم بگیر بیمتر"
    },
    {
      "id": 35,
      "start": 3227.48,
      "end": 3230.48,
      "formatted_start": "00:53:47.480",
      "formatted_end": "00:53:50.480",
      "text": "اصلا بی نمک و بی دارو اون باید به اندازه"
    },
    {
      "id": 36,
      "start": 3230.48,
      "end": 3232.48,
      "formatted_start": "00:53:50.480",
      "formatted_end": "00:53:52.480",
      "text": "این مقداری که ما داریم خیلی مختصره"
    },
    {
      "id": 37,
      "start": 3232.48,
      "end": 3235.48,
      "formatted_start": "00:53:52.480",
      "formatted_end": "00:53:55.480",
      "text": "حالا شما به جایی روزی سه بارم روزی دو بار بگیر"
    },
    {
      "id": 38,
      "start": 3235.48,
      "end": 3237.48,
      "formatted_start": "00:53:55.480",
      "formatted_end": "00:53:57.480",
      "text": "یک سه روز بده کم شده"
    },
    {
      "id": 39,
      "start": 3237.48,
      "end": 3239.48,
      "formatted_start": "00:53:57.480",
      "formatted_end": "00:53:59.480",
      "text": "سه روز بده دو بار؟"
    },
    {
      "id": 40,
      "start": 3239.48,
      "end": 3243.48,
      "formatted_start": "00:53:59.480",
      "formatted_end": "00:54:03.480",
      "text": "این هایی که تو رو بیان میزنی"
    },
    {
      "id": 41,
      "start": 3243.48,
      "end": 3245.48,
      "formatted_start": "00:54:03.480",
      "formatted_end": "00:54:05.480",
