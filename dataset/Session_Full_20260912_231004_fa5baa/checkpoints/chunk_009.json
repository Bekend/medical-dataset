  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2706.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:06.000",
      "text": "این نسخه که لازم هم براش میزن. آیه ناروی درسته؟"
    },
    {
      "id": 1,
      "start": 2706.0,
      "end": 2712.0,
      "formatted_start": "00:45:06.000",
      "formatted_end": "00:45:12.000",
      "text": "بله بله. خودت گذاشیر مادر هم میخوره؟ نه."
    },
    {
      "id": 2,
      "start": 2712.0,
      "end": 2716.0,
      "formatted_start": "00:45:12.000",
      "formatted_end": "00:45:16.000",
      "text": "نه، نه، نه."
    },
    {
      "id": 3,
      "start": 2716.0,
      "end": 2722.0,
      "formatted_start": "00:45:16.000",
      "formatted_end": "00:45:22.000",
      "text": "اینجا خب استانو اصلا شیرخواست هم نمیدن. خیلی ازگیرد این گوشت."
    },
    {
      "id": 4,
      "start": 2722.0,
      "end": 2728.0,
      "formatted_start": "00:45:22.000",
      "formatted_end": "00:45:28.000",
      "text": "آیه ناروی این داروها رو بیار. اون پومادی که بهتون دادم،"
    },
    {
      "id": 5,
      "start": 2728.0,
      "end": 2731.0,
      "formatted_start": "00:45:28.000",
      "formatted_end": "00:45:31.000",
      "text": "روز روزی هر روزی سه بار رو نافش بدن"
    },
    {
      "id": 6,
      "start": 2731.0,
      "end": 2733.0,
      "formatted_start": "00:45:31.000",
      "formatted_end": "00:45:33.000",
      "text": "سه بار همراه بار"
    },
    {
      "id": 7,
      "start": 2733.0,
      "end": 2736.0,
      "formatted_start": "00:45:33.000",
      "formatted_end": "00:45:36.000",
      "text": "بسه باید بیرون کمانداجه"
    },
    {
      "id": 8,
      "start": 2736.0,
      "end": 2738.0,
      "formatted_start": "00:45:36.000",
      "formatted_end": "00:45:38.000",
      "text": "درمیارو بیارو پشت ماند"
    },
    {
      "id": 9,
      "start": 2738.0,
      "end": 2740.0,
      "formatted_start": "00:45:38.000",
      "formatted_end": "00:45:40.000",
      "text": "بله بیا باشه"
    },
    {
      "id": 10,
      "start": 2740.0,
      "end": 2742.0,
      "formatted_start": "00:45:40.000",
      "formatted_end": "00:45:42.000",
      "text": "این صدمت شما"
    },
    {
      "id": 11,
      "start": 2742.0,
      "end": 2744.0,
      "formatted_start": "00:45:42.000",
      "formatted_end": "00:45:44.000",
      "text": "بیارو بگو"
    },
    {
      "id": 12,
      "start": 2744.0,
      "end": 2746.0,
      "formatted_start": "00:45:44.000",
      "formatted_end": "00:45:46.000",
      "text": "بیا بیار من ببینم"
    },
    {
      "id": 13,
      "start": 2746.0,
      "end": 2748.0,
      "formatted_start": "00:45:46.000",
      "formatted_end": "00:45:48.000",
      "text": "خداحافظ"
    },
    {
      "id": 14,
      "start": 2748.0,
      "end": 2758.0,
      "formatted_start": "00:45:48.000",
      "formatted_end": "00:45:58.000",
      "text": "برده فرمید؟"
    },
    {
      "id": 15,
      "start": 2758.0,
      "end": 2760.0,
      "formatted_start": "00:45:58.000",
      "formatted_end": "00:46:00.000",
      "text": "سلام، مرسی، جانم؟"
    },
    {
      "id": 16,
      "start": 2760.0,
      "end": 2763.0,
      "formatted_start": "00:46:00.000",
      "formatted_end": "00:46:03.000",
      "text": "خواهش می کنم، جانم، برده"
    },
    {
      "id": 17,
      "start": 2763.0,
      "end": 2779.0,
      "formatted_start": "00:46:03.000",
      "formatted_end": "00:46:19.000",
      "text": "بزن شمکلو همه دوره؟"
    },
    {
      "id": 18,
      "start": 2779.0,
      "end": 2782.0,
      "formatted_start": "00:46:19.000",
      "formatted_end": "00:46:22.000",
      "text": "پره پره"
    },
    {
      "id": 19,
      "start": 2782.0,
      "end": 2784.0,
      "formatted_start": "00:46:22.000",
      "formatted_end": "00:46:24.000",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 2784.0,
      "end": 2787.0,
      "formatted_start": "00:46:24.000",
      "formatted_end": "00:46:27.000",
      "text": "خب نه، قرارم که امپیو باشه"
    },
    {
      "id": 21,
      "start": 2787.0,
      "end": 2789.0,
      "formatted_start": "00:46:27.000",
      "formatted_end": "00:46:29.000",
      "text": "استفراق داره ناره"
    },
    {
      "id": 22,
      "start": 2789.0,
      "end": 2791.0,
      "formatted_start": "00:46:29.000",
      "formatted_end": "00:46:31.000",
      "text": "خب درسته"
    },
    {
      "id": 23,
      "start": 2791.0,
      "end": 2793.0,
      "formatted_start": "00:46:31.000",
      "formatted_end": "00:46:33.000",
      "text": "تا کپلی شدید اینا که میدونید"
    },
    {
      "id": 24,
      "start": 2793.0,
      "end": 2796.0,
      "formatted_start": "00:46:33.000",
      "formatted_end": "00:46:36.000",
      "text": "خب این اردر یاد داشت کنیم بستری بشید"
    },
    {
      "id": 25,
      "start": 2796.0,
      "end": 2799.0,
      "formatted_start": "00:46:36.000",
      "formatted_end": "00:46:39.000",
      "text": "اصلا ببینیم بخش اطفال بگیم به من زنگ زنم ها اردر رو میدن"
    },
    {
      "id": 26,
      "start": 2799.0,
      "end": 2803.0,
      "formatted_start": "00:46:39.000",
      "formatted_end": "00:46:43.000",
      "text": "مرسیم، ممنون خدا را بزنیم"
    },
    {
      "id": 27,
      "start": 2810.0,
      "end": 2817.0,
      "formatted_start": "00:46:50.000",
      "formatted_end": "00:46:57.000",
      "text": "یا که تنظیم کنید و آز هم تنظیم کنید و آز هم تنظیم کنید"
    },
    {
      "id": 28,
      "start": 2817.0,
      "end": 2825.0,
      "formatted_start": "00:46:57.000",
      "formatted_end": "00:47:05.000",
      "text": "تا وقتی از دنیا میریم ایمی رسانهایی با صداقت تمام از دنیا رفته باشید"
    },
    {
      "id": 29,
      "start": 2825.0,
      "end": 2829.0,
      "formatted_start": "00:47:05.000",
      "formatted_end": "00:47:09.000",
      "text": "با تراثم تمام از دنیا رفته باشید"
    },
    {
      "id": 30,
      "start": 2829.0,
      "end": 2836.0,
      "formatted_start": "00:47:09.000",
      "formatted_end": "00:47:16.000",
      "text": "رسانهای عادل و ملصف و برابری تنبه رفته باشید"
    },
    {
      "id": 31,
      "start": 2836.0,
      "end": 2842.0,
      "formatted_start": "00:47:16.000",
      "formatted_end": "00:47:22.000",
      "text": "آدمهای بوشه و اهل شبهت و برادری از دنیا رفته باشید"
    },
    {
      "id": 32,
      "start": 2842.0,
      "end": 2844.0,
      "formatted_start": "00:47:22.000",
      "formatted_end": "00:47:24.000",
      "text": "آدمهای افزایی رفته باشید، فیلن"
    },
    {
      "id": 33,
      "start": 2844.0,
      "end": 2848.0,
      "formatted_start": "00:47:24.000",
      "formatted_end": "00:47:28.000",
      "text": "اشری و زن به خیلی خودشون بودند"
    },
    {
      "id": 34,
      "start": 2848.0,
      "end": 2851.0,
      "formatted_start": "00:47:28.000",
      "formatted_end": "00:47:31.000",
      "text": "باید اون رفته باشه که جز به عقلیتن"
    },
    {
      "id": 35,
      "start": 2851.0,
      "end": 2854.0,
      "formatted_start": "00:47:31.000",
      "formatted_end": "00:47:34.000",
      "text": "تنه بیدار بودند"
    },
    {
      "id": 36,
      "start": 2854.0,
      "end": 2857.0,
      "formatted_start": "00:47:34.000",
      "formatted_end": "00:47:37.000",
      "text": "از اون رفته باشه که به عقل دارند"
    },
    {
      "id": 37,
      "start": 2857.0,
      "end": 2859.0,
      "formatted_start": "00:47:37.000",
      "formatted_end": "00:47:39.000",
      "text": "بیدار باید بردن"
    },
    {
      "id": 38,
      "start": 2859.0,
      "end": 2860.0,
      "formatted_start": "00:47:39.000",
      "formatted_end": "00:47:40.000",
      "text": "هم؟"
    },
    {
      "id": 39,
      "start": 2860.0,
      "end": 2862.0,
      "formatted_start": "00:47:40.000",
      "formatted_end": "00:47:42.000",
      "text": "یک دوری آتنش دارند"
    },
    {
      "id": 40,
      "start": 2865.0,
      "end": 2868.0,
      "formatted_start": "00:47:45.000",
      "formatted_end": "00:47:48.000",
      "text": "میده هم خون داره توی درد"
    },
    {
      "id": 41,
      "start": 2868.0,
      "end": 2870.0,
      "formatted_start": "00:47:48.000",
      "formatted_end": "00:47:50.000",
      "text": "صحبت سنگی نداری خانواده؟"
    },
    {
      "id": 42,
      "start": 2870.0,
      "end": 2872.0,
      "formatted_start": "00:47:50.000",
      "formatted_end": "00:47:52.000",
      "text": "نه، نه، برای خواه رو بگو"
    },
    {
      "id": 43,
      "start": 2872.0,
      "end": 2874.0,
      "formatted_start": "00:47:52.000",
      "formatted_end": "00:47:54.000",
      "text": "این وساطه شنیده داشتم"
    },
    {
      "id": 44,
      "start": 2874.0,
      "end": 2876.0,
      "formatted_start": "00:47:54.000",
      "formatted_end": "00:47:56.000",
      "text": "یه سونه باشه"
    },
    {
      "id": 45,
      "start": 2876.0,
      "end": 2878.0,
      "formatted_start": "00:47:56.000",
      "formatted_end": "00:47:58.000",
      "text": "اونجون خون داره"
    },
    {
      "id": 46,
      "start": 2878.0,
      "end": 2880.0,
      "formatted_start": "00:47:58.000",
      "formatted_end": "00:48:00.000",
      "text": "کشتشم گرفتم"
    },
    {
      "id": 47,
      "start": 2880.0,
      "end": 2882.0,
      "formatted_start": "00:48:00.000",
      "formatted_end": "00:48:02.000",
      "text": "افونت نداره"
    },
    {
      "id": 48,
      "start": 2882.0,
      "end": 2884.0,
      "formatted_start": "00:48:02.000",
      "formatted_end": "00:48:04.000",
      "text": "نه افونت نداره"
    },
    {
      "id": 49,
      "start": 2884.0,
      "end": 2886.0,
      "formatted_start": "00:48:04.000",
      "formatted_end": "00:48:06.000",
      "text": "من ریزو بیریدم نیمتونم داشتم"
    },
    {
      "id": 50,
      "start": 2886.0,
      "end": 2888.0,
      "formatted_start": "00:48:06.000",
      "formatted_end": "00:48:08.000",
      "text": "درد از اینجا میگیره"
    },
    {
      "id": 51,
      "start": 2888.0,
      "end": 2890.0,
      "formatted_start": "00:48:08.000",
      "formatted_end": "00:48:10.000",
      "text": "و اینجا میریزه به جلو"
    },
    {
      "id": 52,
      "start": 2890.0,
      "end": 2892.0,
      "formatted_start": "00:48:10.000",
      "formatted_end": "00:48:12.000",
      "text": "هفته پیش میرفته"
    },
    {
      "id": 53,
      "start": 2892.0,
      "end": 2894.0,
      "formatted_start": "00:48:12.000",
      "formatted_end": "00:48:14.000",
      "text": "اونو با خودم ریز شد"
    },
    {
      "id": 54,
      "start": 2894.0,
      "end": 2896.0,
      "formatted_start": "00:48:14.000",
      "formatted_end": "00:48:16.000",
      "text": "نفشت من خونه"
    },
    {
      "id": 55,
      "start": 2896.0,
      "end": 2898.0,
      "formatted_start": "00:48:16.000",
      "formatted_end": "00:48:18.000",
      "text": "افتاده نیست"
    },
    {
      "id": 56,
      "start": 2898.0,
      "end": 2900.0,
      "formatted_start": "00:48:18.000",
      "formatted_end": "00:48:20.000",
      "text": "اون از درد گرفته بود"
    },
    {
      "id": 57,
      "start": 2900.0,
      "end": 2903.64,
      "formatted_start": "00:48:20.000",
      "formatted_end": "00:48:23.640",
      "text": "بعدش دیگه همینجا بیاد این برنامه افتاد و کلیه مرحب کنم"
    },
    {
      "id": 58,
      "start": 2903.64,
      "end": 2905.24,
      "formatted_start": "00:48:23.640",
      "formatted_end": "00:48:25.240",
      "text": "این برنامه شدید بود و"
    },
    {
      "id": 59,
      "start": 2905.24,
      "end": 2907.24,
      "formatted_start": "00:48:25.240",
      "formatted_end": "00:48:27.240",
      "text": "حالا اینو باید حالا یک سونو کنید"
    },
    {
      "id": 60,
      "start": 2907.24,
      "end": 2908.24,
      "formatted_start": "00:48:27.240",
      "formatted_end": "00:48:28.240",
      "text": "باید برنامه کنیم"
    },
    {
      "id": 61,
      "start": 2908.24,
      "end": 2908.74,
      "formatted_start": "00:48:28.240",
      "formatted_end": "00:48:28.740",
      "text": "بله"
    },
    {
      "id": 62,
      "start": 2908.74,
      "end": 2915.24,
      "formatted_start": "00:48:28.740",
      "formatted_end": "00:48:35.240",
      "text": "یکی هستایی بود که معنیت رو در آرمانها رو بگیرد"
    },
    {
      "id": 63,
      "start": 2915.24,
      "end": 2918.24,
      "formatted_start": "00:48:35.240",
      "formatted_end": "00:48:38.240",
      "text": "بگرد ما زندگی معنیت رو زندگی کنیم"
    },
    {
      "id": 64,
      "start": 2918.24,
      "end": 2923.24,
      "formatted_start": "00:48:38.240",
      "formatted_end": "00:48:43.240",
      "text": "که در خدمت امنیت برای مصنوع شد"
    },
    {
      "id": 65,
      "start": 2923.24,
      "end": 2927.24,
      "formatted_start": "00:48:43.240",
      "formatted_end": "00:48:47.240",
      "text": "در خدمت عدادت و محسابیت برنامه شد"
    },
    {
      "id": 66,
      "start": 2927.24,
      "end": 2927.74,
      "formatted_start": "00:48:47.240",
      "formatted_end": "00:48:47.740",
      "text": "بله"
    },
    {
      "id": 67,
      "start": 2927.74,
      "end": 2930.98,
      "formatted_start": "00:48:47.740",
      "formatted_end": "00:48:50.980",
      "text": "یعنی ما خبر کنیم کلیه مجموعی رو بگیرم؟"
    },
    {
      "id": 68,
      "start": 2930.98,
      "end": 2932.06,
      "formatted_start": "00:48:50.980",
      "formatted_end": "00:48:52.060",
      "text": "آره، آره، کلیه مجموعی"
    },
    {
      "id": 69,
      "start": 2957.74,
      "end": 2965.74,
      "formatted_start": "00:49:17.740",
      "formatted_end": "00:49:25.740",
      "text": "یه دست سه ماه و پنه معنیتی هم را از نمدرده در آرمانهای روح و شماختی ببینند"
    },
    {
      "id": 70,
      "start": 2965.74,
      "end": 2982.74,
      "formatted_start": "00:49:25.740",
      "formatted_end": "00:49:42.740",
      "text": "بگن ما به دنبال آدام بشیم، به دنبال شادیم، به دنبال عاشقی با خودیم، به دنبال تعالی با نویدیم، به دنبال یک آدچیدی موجودیم، به دنبال این چیز هستم"
    },
    {
      "id": 71,
      "start": 2982.74,
      "end": 2989.2,
      "formatted_start": "00:49:42.740",
      "formatted_end": "00:49:49.200",
      "text": "این ها معنویت هستند و آموان های معنوی به حساب می آمدند"
    },
    {
      "id": 72,
      "start": 2989.2,
      "end": 2994.98,
      "formatted_start": "00:49:49.200",
      "formatted_end": "00:49:54.980",
      "text": "برای رستق این ها شخص باید از خیلی درستات را برسند"
    },
    {
      "id": 73,
      "start": 2994.98,
      "end": 2999.98,
      "formatted_start": "00:49:54.980",
      "formatted_end": "00:49:59.980",
      "text": "این اخر پس کسانی هم پیدا می شوند در زندگی که دست دوم است"
    }
  ],
  "status": "completed"
}