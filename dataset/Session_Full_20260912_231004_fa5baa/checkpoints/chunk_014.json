  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4214.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:14.000",
      "text": "لوزه سه با اونها نمیشه. لوزه رو باید عکس بگیرید. من یک عکس میموزدم. این عکس رو بیگیرید. بعد من بر اساس اون عکس میگم که این چی جوریه."
    },
    {
      "id": 1,
      "start": 4214.0,
      "end": 4219.0,
      "formatted_start": "01:10:14.000",
      "formatted_end": "01:10:19.000",
      "text": "برای شفان مخصوص کسی خیلی خیلی نمیکنه"
    },
    {
      "id": 2,
      "start": 4219.0,
      "end": 4221.0,
      "formatted_start": "01:10:19.000",
      "formatted_end": "01:10:21.000",
      "text": "بعضی موال زیاد میشه"
    },
    {
      "id": 3,
      "start": 4221.0,
      "end": 4223.0,
      "formatted_start": "01:10:21.000",
      "formatted_end": "01:10:23.000",
      "text": "خب اونو نمیکنه"
    },
    {
      "id": 4,
      "start": 4223.0,
      "end": 4225.0,
      "formatted_start": "01:10:23.000",
      "formatted_end": "01:10:25.000",
      "text": "کامکولسنی هران که بخ رفته"
    },
    {
      "id": 5,
      "start": 4225.0,
      "end": 4227.0,
      "formatted_start": "01:10:25.000",
      "formatted_end": "01:10:27.000",
      "text": "اینو بیدیم به کامکولسنی"
    },
    {
      "id": 6,
      "start": 4227.0,
      "end": 4229.0,
      "formatted_start": "01:10:27.000",
      "formatted_end": "01:10:29.000",
      "text": "یک کود مدتونو میبینید فردو صبح"
    },
    {
      "id": 7,
      "start": 4229.0,
      "end": 4231.0,
      "formatted_start": "01:10:29.000",
      "formatted_end": "01:10:31.000",
      "text": "چون تا هران 6 تا 8 فرواد میسن"
    },
    {
      "id": 8,
      "start": 4231.0,
      "end": 4233.0,
      "formatted_start": "01:10:31.000",
      "formatted_end": "01:10:33.000",
      "text": "اوه قبل 8 میبینید"
    },
    {
      "id": 9,
      "start": 4233.0,
      "end": 4235.0,
      "formatted_start": "01:10:33.000",
      "formatted_end": "01:10:35.000",
      "text": "دیگه نمیشه صبح تماس بگیرید"
    },
    {
      "id": 10,
      "start": 4235.0,
      "end": 4237.0,
      "formatted_start": "01:10:35.000",
      "formatted_end": "01:10:37.000",
      "text": "اینو وارد سیستم کنه هم برد میدهد"
    },
    {
      "id": 11,
      "start": 4237.0,
      "end": 4239.0,
      "formatted_start": "01:10:37.000",
      "formatted_end": "01:10:39.000",
      "text": "عکسی میگید"
    },
    {
      "id": 12,
      "start": 4239.0,
      "end": 4241.0,
      "formatted_start": "01:10:39.000",
      "formatted_end": "01:10:41.000",
      "text": "بیمارسان را آزاشتر نمیتونید"
    },
    {
      "id": 13,
      "start": 4244.0,
      "end": 4246.0,
      "formatted_start": "01:10:44.000",
      "formatted_end": "01:10:46.000",
      "text": "همسنین یک عکس لعوضه یا خوب؟"
    },
    {
      "id": 14,
      "start": 4246.0,
      "end": 4250.0,
      "formatted_start": "01:10:46.000",
      "formatted_end": "01:10:50.000",
      "text": "من گوهر در این نرکیشت و توچه بگو مردم مثل این الان بچه ها برده بوده رفت"
    },
    {
      "id": 15,
      "start": 4250.0,
      "end": 4253.0,
      "formatted_start": "01:10:50.000",
      "formatted_end": "01:10:53.000",
      "text": "این برده بود فهمیم از این لعوضه داره برای بزرگتاشون خوب بشه"
    },
    {
      "id": 16,
      "start": 4253.0,
      "end": 4254.0,
      "formatted_start": "01:10:53.000",
      "formatted_end": "01:10:54.000",
      "text": "همه هر نزدیک"
    },
    {
      "id": 17,
      "start": 4254.0,
      "end": 4255.0,
      "formatted_start": "01:10:54.000",
      "formatted_end": "01:10:55.000",
      "text": "ببین باید عکس بود"
    },
    {
      "id": 18,
      "start": 4255.0,
      "end": 4256.0,
      "formatted_start": "01:10:55.000",
      "formatted_end": "01:10:56.000",
      "text": "آره"
    },
    {
      "id": 19,
      "start": 4256.0,
      "end": 4257.0,
      "formatted_start": "01:10:56.000",
      "formatted_end": "01:10:57.000",
      "text": "ببین وقتی بچه دی"
    },
    {
      "id": 20,
      "start": 4257.0,
      "end": 4258.0,
      "formatted_start": "01:10:57.000",
      "formatted_end": "01:10:58.000",
      "text": "من گفتم بیارمش باید برده بشم"
    },
    {
      "id": 21,
      "start": 4258.0,
      "end": 4259.0,
      "formatted_start": "01:10:58.000",
      "formatted_end": "01:10:59.000",
      "text": "همه سنین"
    },
    {
      "id": 22,
      "start": 4261.0,
      "end": 4264.0,
      "formatted_start": "01:11:01.000",
      "formatted_end": "01:11:04.000",
      "text": "این الان بزرگ شده الان چند سال میشه؟"
    },
    {
      "id": 23,
      "start": 4264.0,
      "end": 4265.0,
      "formatted_start": "01:11:04.000",
      "formatted_end": "01:11:05.000",
      "text": "الان یک سال"
    },
    {
      "id": 24,
      "start": 4265.0,
      "end": 4269.8,
      "formatted_start": "01:11:05.000",
      "formatted_end": "01:11:09.800",
      "text": "دیگه تا هفت ساله ای قبل مدرسه اگر دیدی دماغی حرف بزنه"
    },
    {
      "id": 25,
      "start": 4269.8,
      "end": 4273.6,
      "formatted_start": "01:11:09.800",
      "formatted_end": "01:11:13.600",
      "text": "تو مدرسه میلی که وقتی صحبت میکنه بچه ها مسئله می کنن"
    },
    {
      "id": 26,
      "start": 4273.6,
      "end": 4276.2,
      "formatted_start": "01:11:13.600",
      "formatted_end": "01:11:16.200",
      "text": "یه مقدار بردی زیاد نردن"
    },
    {
      "id": 27,
      "start": 4276.2,
      "end": 4279.2,
      "formatted_start": "01:11:16.200",
      "formatted_end": "01:11:19.200",
      "text": "و از موقع که سر با باید شدید تر میکنه"
    },
    {
      "id": 28,
      "start": 4279.2,
      "end": 4283.2,
      "formatted_start": "01:11:19.200",
      "formatted_end": "01:11:23.200",
      "text": "اگر مادر جیبه خور خور میکنه با دهن و باز نفرس میشه"
    },
    {
      "id": 29,
      "start": 4283.2,
      "end": 4288.2,
      "formatted_start": "01:11:23.200",
      "formatted_end": "01:11:28.200",
      "text": "این اگر اینجوری باشه راه تنخصیش هم سخت میگه با دهن نفرس"
    },
    {
      "id": 30,
      "start": 4288.2,
      "end": 4289.6,
      "formatted_start": "01:11:28.200",
      "formatted_end": "01:11:29.600",
      "text": "حالا اکس من ببینم؟"
    },
    {
      "id": 31,
      "start": 4289.6,
      "end": 4290.4,
      "formatted_start": "01:11:29.600",
      "formatted_end": "01:11:30.400",
      "text": "شما جد برن"
    },
    {
      "id": 32,
      "start": 4290.4,
      "end": 4292.4,
      "formatted_start": "01:11:30.400",
      "formatted_end": "01:11:32.400",
      "text": "بسیار داریم"
    },
    {
      "id": 33,
      "start": 4292.4,
      "end": 4294.4,
      "formatted_start": "01:11:32.400",
      "formatted_end": "01:11:34.400",
      "text": "بسیار داریم"
    },
    {
      "id": 34,
      "start": 4320.4,
      "end": 4345.4,
      "formatted_start": "01:12:00.400",
      "formatted_end": "01:12:25.400",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 4345.4,
      "end": 4347.4,
      "formatted_start": "01:12:25.400",
      "formatted_end": "01:12:27.400",
      "text": "بخونم"
    },
    {
      "id": 36,
      "start": 4347.4,
      "end": 4349.4,
      "formatted_start": "01:12:27.400",
      "formatted_end": "01:12:29.400",
      "text": "سلام"
    },
    {
      "id": 37,
      "start": 4349.4,
      "end": 4351.4,
      "formatted_start": "01:12:29.400",
      "formatted_end": "01:12:31.400",
      "text": "خوشحال شما خوبه؟"
    },
    {
      "id": 38,
      "start": 4351.4,
      "end": 4353.4,
      "formatted_start": "01:12:31.400",
      "formatted_end": "01:12:33.400",
      "text": "کچوره رو تنفر بزنیم"
    },
    {
      "id": 39,
      "start": 4353.4,
      "end": 4355.4,
      "formatted_start": "01:12:33.400",
      "formatted_end": "01:12:35.400",
      "text": "دستگاه برده بودید"
    },
    {
      "id": 40,
      "start": 4355.4,
      "end": 4357.4,
      "formatted_start": "01:12:35.400",
      "formatted_end": "01:12:37.400",
      "text": "خوب خابیده زیر دستگاه"
    },
    {
      "id": 41,
      "start": 4357.4,
      "end": 4359.4,
      "formatted_start": "01:12:37.400",
      "formatted_end": "01:12:39.400",
      "text": "آزین"
    },
    {
      "id": 42,
      "start": 4359.4,
      "end": 4361.4,
      "formatted_start": "01:12:39.400",
      "formatted_end": "01:12:41.400",
      "text": "ایشانها که سفیدش کرد"
    },
    {
      "id": 43,
      "start": 4375.4,
      "end": 4377.4,
      "formatted_start": "01:12:55.400",
      "formatted_end": "01:12:57.400",
      "text": "نه خوبه"
    },
    {
      "id": 44,
      "start": 4377.4,
      "end": 4379.4,
      "formatted_start": "01:12:57.400",
      "formatted_end": "01:12:59.400",
      "text": "مردمون خوب بودش"
    },
    {
      "id": 45,
      "start": 4379.4,
      "end": 4381.4,
      "formatted_start": "01:12:59.400",
      "formatted_end": "01:13:01.400",
      "text": "توشب یا سشب؟ دوشب بود"
    },
    {
      "id": 46,
      "start": 4381.4,
      "end": 4383.4,
      "formatted_start": "01:13:01.400",
      "formatted_end": "01:13:03.400",
      "text": "توشب با اینکه کمترین زمان هم بزرگ داشتید"
    },
    {
      "id": 47,
      "start": 4383.4,
      "end": 4385.4,
      "formatted_start": "01:13:03.400",
      "formatted_end": "01:13:05.400",
      "text": "ولی خوبه"
    },
    {
      "id": 48,
      "start": 4387.4,
      "end": 4389.4,
      "formatted_start": "01:13:07.400",
      "formatted_end": "01:13:09.400",
      "text": "چشماش یکم ضرپاشه مهم نیست؟"
    },
    {
      "id": 49,
      "start": 4389.4,
      "end": 4391.4,
      "formatted_start": "01:13:09.400",
      "formatted_end": "01:13:11.400",
      "text": "یا صورت؟"
    },
    {
      "id": 50,
      "start": 4391.4,
      "end": 4393.4,
      "formatted_start": "01:13:11.400",
      "formatted_end": "01:13:13.400",
      "text": "بدن مهمه نافشم خوب داده"
    },
    {
      "id": 51,
      "start": 4393.4,
      "end": 4395.4,
      "formatted_start": "01:13:13.400",
      "formatted_end": "01:13:15.400",
      "text": "سشب افتاده"
    },
    {
      "id": 52,
      "start": 4395.4,
      "end": 4397.4,
      "formatted_start": "01:13:15.400",
      "formatted_end": "01:13:17.400",
      "text": "بسیار عادی"
    },
    {
      "id": 53,
      "start": 4397.4,
      "end": 4399.4,
      "formatted_start": "01:13:17.400",
      "formatted_end": "01:13:19.400",
      "text": "خیلی هم خوبه"
    },
    {
      "id": 54,
      "start": 4399.4,
      "end": 4401.4,
      "formatted_start": "01:13:19.400",
      "formatted_end": "01:13:21.400",
      "text": "دستگاه افتاده"
    },
    {
      "id": 55,
      "start": 4401.4,
      "end": 4403.4,
      "formatted_start": "01:13:21.400",
      "formatted_end": "01:13:23.400",
      "text": "این دستگاه ها خواهست میشه ناف زود بود"
    },
    {
      "id": 56,
      "start": 4403.4,
      "end": 4433.4,
      "formatted_start": "01:13:23.400",
      "formatted_end": "01:13:53.400",
      "text": "خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده اینکه خوب شده این"
    },
    {
      "id": 57,
      "start": 4433.4,
      "end": 4436.06,
      "formatted_start": "01:13:53.400",
      "formatted_end": "01:13:56.060",
      "text": "برقی چیزهای خوبه اوی دوره ای وضعیتی"
    },
    {
      "id": 58,
      "start": 4436.06,
      "end": 4438.36,
      "formatted_start": "01:13:56.060",
      "formatted_end": "01:13:58.360",
      "text": "یه شب 24 ساعت دیگه هم بزرگ که مطمئن باشید"
    },
    {
      "id": 59,
      "start": 4438.36,
      "end": 4438.86,
      "formatted_start": "01:13:58.360",
      "formatted_end": "01:13:58.860",
      "text": "بسیار"
    },
    {
      "id": 60,
      "start": 4438.86,
      "end": 4439.82,
      "formatted_start": "01:13:58.860",
      "formatted_end": "01:13:59.820",
      "text": "چون کم بیدیم"
    },
    {
      "id": 61,
      "start": 4439.82,
      "end": 4440.32,
      "formatted_start": "01:13:59.820",
      "formatted_end": "01:14:00.320",
      "text": "بسیار"
    },
    {
      "id": 62,
      "start": 4440.32,
      "end": 4443.24,
      "formatted_start": "01:14:00.320",
      "formatted_end": "01:14:03.240",
      "text": "اون دستگاه میخواد برداشت بود بیم چطورتون هم دیدیم"
    },
    {
      "id": 63,
      "start": 4443.24,
      "end": 4446.0,
      "formatted_start": "01:14:03.240",
      "formatted_end": "01:14:06.000",
      "text": "حالا دیگه نمیخواد بیدید دیگه"
    },
    {
      "id": 64,
      "start": 4446.0,
      "end": 4450.12,
      "formatted_start": "01:14:06.000",
      "formatted_end": "01:14:10.120",
      "text": "شما یه 24 ساعت دیگه میگرد در دیگه حضینه نداره بیایید بی شما"
    },
    {
      "id": 65,
      "start": 4450.12,
      "end": 4452.12,
      "formatted_start": "01:14:10.120",
      "formatted_end": "01:14:12.120",
      "text": "خوب دیگه خودم رو عذیب نکن"
    },
    {
      "id": 66,
      "start": 4452.12,
      "end": 4452.62,
      "formatted_start": "01:14:12.120",
      "formatted_end": "01:14:12.620",
      "text": "بسیار"
    },
    {
      "id": 67,
      "start": 4452.62,
      "end": 4453.12,
      "formatted_start": "01:14:12.620",
      "formatted_end": "01:14:13.120",
      "text": "برداشت بود"
    },
    {
      "id": 68,
      "start": 4453.12,
      "end": 4453.62,
      "formatted_start": "01:14:13.120",
      "formatted_end": "01:14:13.620",
      "text": "خمان"
    },
    {
      "id": 69,
      "start": 4453.62,
      "end": 4455.62,
      "formatted_start": "01:14:13.620",
      "formatted_end": "01:14:15.620",
      "text": "خیلی خوب"
    },
    {
      "id": 70,
      "start": 4460.62,
      "end": 4462.62,
      "formatted_start": "01:14:20.620",
      "formatted_end": "01:14:22.620",
      "text": "خیلی خوب"
    },
    {
      "id": 71,
      "start": 4466.62,
      "end": 4468.62,
      "formatted_start": "01:14:26.620",
      "formatted_end": "01:14:28.620",
      "text": "بگیرم اینجا"
    },
    {
      "id": 72,
      "start": 4468.62,
      "end": 4470.62,
      "formatted_start": "01:14:28.620",
      "formatted_end": "01:14:30.620",
      "text": "بگیرم"
    },
    {
      "id": 73,
      "start": 4470.62,
      "end": 4472.62,
      "formatted_start": "01:14:30.620",
      "formatted_end": "01:14:32.620",
      "text": "بگیرم بچه رو بیارم"
    },
    {
      "id": 74,
      "start": 4472.62,
      "end": 4474.62,
      "formatted_start": "01:14:32.620",
      "formatted_end": "01:14:34.620",
      "text": "آیایی"
    },
    {
      "id": 75,
      "start": 4483.62,
      "end": 4491.62,
      "formatted_start": "01:14:43.620",
      "formatted_end": "01:14:51.620",
      "text": "حالا اینجا آیا خانم انداریم؟ ببین این مثل ویکس ماننده"
    },
    {
      "id": 76,
      "start": 4491.62,
      "end": 4499.62,
      "formatted_start": "01:14:51.620",
      "formatted_end": "01:14:59.620",
      "text": "اون چیز دوسته با همین اطراف دینیش و گردنشی باید برد سرما خوردیریم"
    }
  ],
  "status": "completed"
}