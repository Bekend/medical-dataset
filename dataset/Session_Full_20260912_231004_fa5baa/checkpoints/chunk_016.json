      "formatted_start": "01:24:50.028",
      "formatted_end": "01:24:53.707",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 5091.547,
      "end": 5092.677,
      "formatted_start": "01:24:51.547",
      "formatted_end": "01:24:52.677",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 5094.23,
      "end": 5099.967,
      "formatted_start": "01:24:54.230",
      "formatted_end": "01:24:59.967",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 5098.988,
      "end": 5099.967,
      "formatted_start": "01:24:58.988",
      "formatted_end": "01:24:59.967",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4829.98,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 4830.0,
      "end": 4832.0,
      "formatted_start": "01:20:30.000",
      "formatted_end": "01:20:32.000",
      "text": "بلوچی هردیش میدهی؟"
    },
    {
      "id": 2,
      "start": 4832.0,
      "end": 4833.0,
      "formatted_start": "01:20:32.000",
      "formatted_end": "01:20:33.000",
      "text": "نه"
    },
    {
      "id": 3,
      "start": 4833.0,
      "end": 4834.0,
      "formatted_start": "01:20:33.000",
      "formatted_end": "01:20:34.000",
      "text": "بلوچی هردیش میدهی؟"
    },
    {
      "id": 4,
      "start": 4834.0,
      "end": 4835.0,
      "formatted_start": "01:20:34.000",
      "formatted_end": "01:20:35.000",
      "text": "نه"
    },
    {
      "id": 5,
      "start": 4835.0,
      "end": 4837.0,
      "formatted_start": "01:20:35.000",
      "formatted_end": "01:20:37.000",
      "text": "تو خونه اینکه بلوچی هم برای فارسی هم یاد میدهی"
    },
    {
      "id": 6,
      "start": 4837.0,
      "end": 4838.0,
      "formatted_start": "01:20:37.000",
      "formatted_end": "01:20:38.000",
      "text": "خب خوبه"
    },
    {
      "id": 7,
      "start": 4838.0,
      "end": 4839.0,
      "formatted_start": "01:20:38.000",
      "formatted_end": "01:20:39.000",
      "text": "دو تا زبان خوبه"
    },
    {
      "id": 8,
      "start": 4839.0,
      "end": 4840.0,
      "formatted_start": "01:20:39.000",
      "formatted_end": "01:20:40.000",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 4840.0,
      "end": 4841.0,
      "formatted_start": "01:20:40.000",
      "formatted_end": "01:20:41.000",
      "text": "الان آقایی کل هم فارسی هرد میزنی"
    },
    {
      "id": 10,
      "start": 4841.0,
      "end": 4843.0,
      "formatted_start": "01:20:41.000",
      "formatted_end": "01:20:43.000",
      "text": "بله بلوچی هم داخل خونه هرد میزن"
    },
    {
      "id": 11,
      "start": 4843.0,
      "end": 4844.0,
      "formatted_start": "01:20:43.000",
      "formatted_end": "01:20:44.000",
      "text": "تو توجه میشه"
    },
    {
      "id": 12,
      "start": 4844.0,
      "end": 4845.0,
      "formatted_start": "01:20:44.000",
      "formatted_end": "01:20:45.000",
      "text": "خب بسان بگو هرد بزنی"
    },
    {
      "id": 13,
      "start": 4845.0,
      "end": 4847.0,
      "formatted_start": "01:20:45.000",
      "formatted_end": "01:20:47.000",
      "text": "باش فارسی هرد نزده"
    },
    {
      "id": 14,
      "start": 4847.0,
      "end": 4849.0,
      "formatted_start": "01:20:47.000",
      "formatted_end": "01:20:49.000",
      "text": "نه ببین آدت کردی فارسی هرد میزنی"
    },
    {
      "id": 15,
      "start": 4849.0,
      "end": 4850.0,
      "formatted_start": "01:20:49.000",
      "formatted_end": "01:20:50.000",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 4850.0,
      "end": 4853.0,
      "formatted_start": "01:20:50.000",
      "formatted_end": "01:20:53.000",
      "text": "عادت ترقیق بده. گوش میده برای چی میگن؟"
    },
    {
      "id": 17,
      "start": 4853.0,
      "end": 4858.0,
      "formatted_start": "01:20:53.000",
      "formatted_end": "01:20:58.000",
      "text": "به دو دلیل. بچه ای که دو تا زبان رو یاد میگیره مغزش باهوشتره"
    },
    {
      "id": 18,
      "start": 4858.0,
      "end": 4864.0,
      "formatted_start": "01:20:58.000",
      "formatted_end": "01:21:04.000",
      "text": "یعنی بتونه هم بلوچی حرف بزنه. این بچه از نظر ذهنی قدیتر میشه"
    },
    {
      "id": 19,
      "start": 4864.0,
      "end": 4871.0,
      "formatted_start": "01:21:04.000",
      "formatted_end": "01:21:11.000",
      "text": "دو تا زبان. دوم، این وقتی که بلوچی یاد میگیره یک قدرت یک توانایی سیاد میشه"
    },
    {
      "id": 20,
      "start": 4871.0,
      "end": 4875.0,
      "formatted_start": "01:21:11.000",
      "formatted_end": "01:21:15.000",
      "text": "الان من بلوچی یاد میگیرم با مریضان همه بلوچی حرف میزنم"
    },
    {
      "id": 21,
      "start": 4875.0,
      "end": 4877.0,
      "formatted_start": "01:21:15.000",
      "formatted_end": "01:21:17.000",
      "text": "این همه به من خوششون میاد بلوچه ها"
    },
    {
      "id": 22,
      "start": 4877.0,
      "end": 4879.0,
      "formatted_start": "01:21:17.000",
      "formatted_end": "01:21:19.000",
      "text": "این هم فردا یک جایی میره"
    },
    {
      "id": 23,
      "start": 4879.0,
      "end": 4881.0,
      "formatted_start": "01:21:19.000",
      "formatted_end": "01:21:21.000",
      "text": "چهار تا بلوچ باشن صحبت کنه"
    },
    {
      "id": 24,
      "start": 4881.0,
      "end": 4883.0,
      "formatted_start": "01:21:21.000",
      "formatted_end": "01:21:23.000",
      "text": "ارتباط برقرار میکنه"
    },
    {
      "id": 25,
      "start": 4883.0,
      "end": 4885.0,
      "formatted_start": "01:21:23.000",
      "formatted_end": "01:21:25.000",
      "text": "خب سمیت"
    },
    {
      "id": 26,
      "start": 4885.0,
      "end": 4887.0,
      "formatted_start": "01:21:25.000",
      "formatted_end": "01:21:27.000",
      "text": "اینه که اصلا چیز نکنه"
    },
    {
      "id": 27,
      "start": 4887.0,
      "end": 4889.0,
      "formatted_start": "01:21:27.000",
      "formatted_end": "01:21:29.000",
      "text": "بلوچه اینقدر زبان قشنگه"
    },
    {
      "id": 28,
      "start": 4889.0,
      "end": 4891.0,
      "formatted_start": "01:21:29.000",
      "formatted_end": "01:21:31.000",
      "text": "من خودم یک کم بلدم"
    },
    {
      "id": 29,
      "start": 4891.0,
      "end": 4893.0,
      "formatted_start": "01:21:31.000",
      "formatted_end": "01:21:33.000",
      "text": "ولی یک کم بلدم"
    },
    {
      "id": 30,
      "start": 4893.0,
      "end": 4895.0,
      "formatted_start": "01:21:33.000",
      "formatted_end": "01:21:35.000",
      "text": "ولی مالد مثلا بلوچه حرف میزنه"
    },
    {
      "id": 31,
      "start": 4895.0,
      "end": 4897.0,
      "formatted_start": "01:21:35.000",
      "formatted_end": "01:21:37.000",
      "text": "فارسی هم متوجه میشه ولی آقایی بیشتر مثلا فارسی هم"
    },
    {
      "id": 32,
      "start": 4897.0,
      "end": 4899.0,
      "formatted_start": "01:21:37.000",
      "formatted_end": "01:21:39.000",
      "text": "خب تمام ببینید الان برارا"
    },
    {
      "id": 33,
      "start": 4899.0,
      "end": 4901.0,
      "formatted_start": "01:21:39.000",
      "formatted_end": "01:21:41.000",
      "text": "تو سیستم نمیشه رفت"
    },
    {
      "id": 34,
      "start": 4901.0,
      "end": 4903.0,
      "formatted_start": "01:21:41.000",
      "formatted_end": "01:21:43.000",
      "text": "تا هشتم قدر"
    },
    {
      "id": 35,
      "start": 4903.0,
      "end": 4905.0,
      "formatted_start": "01:21:43.000",
      "formatted_end": "01:21:45.000",
      "text": "ما هم هفتونی میمیم"
    },
    {
      "id": 36,
      "start": 4905.0,
      "end": 4907.0,
      "formatted_start": "01:21:45.000",
      "formatted_end": "01:21:47.000",
      "text": "خب یا باید دارو رو آزاد"
    },
    {
      "id": 37,
      "start": 4907.0,
      "end": 4909.0,
      "formatted_start": "01:21:47.000",
      "formatted_end": "01:21:49.000",
      "text": "خامسمی میشه این رو بزنن فردا بیان با بیمه"
    },
    {
      "id": 38,
      "start": 4909.0,
      "end": 4911.0,
      "formatted_start": "01:21:49.000",
      "formatted_end": "01:21:51.000",
      "text": "حساب کنه دارو خانه"
    },
    {
      "id": 39,
      "start": 4911.0,
      "end": 4913.0,
      "formatted_start": "01:21:51.000",
      "formatted_end": "01:21:53.000",
      "text": "بیمه هم کده درو بش چیز کنی"
    },
    {
      "id": 40,
      "start": 4913.0,
      "end": 4915.0,
      "formatted_start": "01:21:53.000",
      "formatted_end": "01:21:55.000",
      "text": "اون درواشو"
    },
    {
      "id": 41,
      "start": 4915.0,
      "end": 4917.0,
      "formatted_start": "01:21:55.000",
      "formatted_end": "01:21:57.000",
      "text": "خامسمی گفتن بزن"
    },
    {
      "id": 42,
      "start": 4917.0,
      "end": 4919.0,
      "formatted_start": "01:21:57.000",
      "formatted_end": "01:21:59.000",
      "text": "چیز کنه از دارو خانه شما"
    },
    {
      "id": 43,
      "start": 4919.0,
      "end": 4921.0,
      "formatted_start": "01:21:59.000",
      "formatted_end": "01:22:01.000",
      "text": "میگیرید فردا"
    },
    {
      "id": 44,
      "start": 4921.0,
      "end": 4923.0,
      "formatted_start": "01:22:01.000",
      "formatted_end": "01:22:03.000",
      "text": "میاد تو سیستم بزنن"
    },
    {
      "id": 45,
      "start": 4923.0,
      "end": 4925.0,
      "formatted_start": "01:22:03.000",
      "formatted_end": "01:22:05.000",
      "text": "هزینه تونو با بیمه حساب کنه باشتون"
    },
    {
      "id": 46,
      "start": 4925.0,
      "end": 4929.0,
      "formatted_start": "01:22:05.000",
      "formatted_end": "01:22:09.000",
      "text": "پس با دارو خانه خمسمی چجوری باید همه هنگ کنید؟"
    },
    {
      "id": 47,
      "start": 4929.0,
      "end": 4932.0,
      "formatted_start": "01:22:09.000",
      "formatted_end": "01:22:12.000",
      "text": "با دارو خانه باید همه هنگ کنید؟"
    },
    {
      "id": 48,
      "start": 4932.0,
      "end": 4935.0,
      "formatted_start": "01:22:12.000",
      "formatted_end": "01:22:15.000",
      "text": "آقا دارو رو بگیره و پردارو بگیره"
    },
    {
      "id": 49,
      "start": 4935.0,
      "end": 4938.0,
      "formatted_start": "01:22:15.000",
      "formatted_end": "01:22:18.000",
      "text": "نه نه دارو رو بگیره"
    },
    {
      "id": 50,
      "start": 4938.0,
      "end": 4942.0,
      "formatted_start": "01:22:18.000",
      "formatted_end": "01:22:22.000",
      "text": "اگر حالش چیز نیست فردا بگیره"
    },
    {
      "id": 51,
      "start": 4942.0,
      "end": 4944.0,
      "formatted_start": "01:22:22.000",
      "formatted_end": "01:22:24.000",
      "text": "باشه فردا بیم دارو آشو بگیره"
    },
    {
      "id": 52,
      "start": 4944.0,
      "end": 4946.0,
      "formatted_start": "01:22:24.000",
      "formatted_end": "01:22:26.000",
      "text": "آنکولشو داری بزنی؟"
    },
    {
      "id": 53,
      "start": 4946.0,
      "end": 4947.0,
      "formatted_start": "01:22:26.000",
      "formatted_end": "01:22:27.000",
      "text": "آنکولشو بزنی؟"
    },
    {
      "id": 54,
      "start": 4947.0,
      "end": 4950.0,
      "formatted_start": "01:22:27.000",
      "formatted_end": "01:22:30.000",
      "text": "آنکولشو بزنی فردا بیا دارو آر بگیره آنکول رو خمسمی"
    },
    {
      "id": 55,
      "start": 4950.0,
      "end": 4951.0,
      "formatted_start": "01:22:30.000",
      "formatted_end": "01:22:31.000",
      "text": "باشه باشه"
    },
    {
      "id": 56,
      "start": 4951.0,
      "end": 4955.0,
      "formatted_start": "01:22:31.000",
      "formatted_end": "01:22:35.000",
      "text": "فیلن یه میدار اسامی و فون و چیزهای دیگه بده"
    },
    {
      "id": 57,
      "start": 4955.0,
      "end": 4958.0,
      "formatted_start": "01:22:35.000",
      "formatted_end": "01:22:38.000",
      "text": "از این سیستمش درده یا"
    },
    {
      "id": 58,
      "start": 4958.0,
      "end": 4959.0,
      "formatted_start": "01:22:38.000",
      "formatted_end": "01:22:39.000",
      "text": "خانداری"
    },
    {
      "id": 59,
      "start": 4959.0,
      "end": 4960.0,
      "formatted_start": "01:22:39.000",
      "formatted_end": "01:22:40.000",
      "text": "یا سرمو برده برده برده"
    },
    {
      "id": 60,
      "start": 4960.0,
      "end": 4962.0,
      "formatted_start": "01:22:40.000",
      "formatted_end": "01:22:42.000",
      "text": "آره آره افونت کرده"
    },
    {
      "id": 61,
      "start": 4962.0,
      "end": 4964.0,
      "formatted_start": "01:22:42.000",
      "formatted_end": "01:22:44.000",
      "text": "بیریش خیلی میگیره؟"
    },
    {
      "id": 62,
      "start": 4964.0,
      "end": 4966.0,
      "formatted_start": "01:22:44.000",
      "formatted_end": "01:22:46.000",
      "text": "آره یه قطعه دارش باشه"
    },
    {
      "id": 63,
      "start": 4966.0,
      "end": 4968.0,
      "formatted_start": "01:22:46.000",
      "formatted_end": "01:22:48.000",
      "text": "شبه خیلی نرد میشه"
    },
    {
      "id": 64,
      "start": 4968.0,
      "end": 4970.0,
      "formatted_start": "01:22:48.000",
      "formatted_end": "01:22:50.000",
      "text": "نفسش میگیره آره"
    },
    {
      "id": 65,
      "start": 4971.0,
      "end": 4972.0,
      "formatted_start": "01:22:51.000",
      "formatted_end": "01:22:52.000",
      "text": "برده"
    },
    {
      "id": 66,
      "start": 4972.0,
      "end": 4975.0,
      "formatted_start": "01:22:52.000",
      "formatted_end": "01:22:55.000",
      "text": "بعد او دکتور من اینو بردم و اکسرشو زدم خب؟"
    },
    {
      "id": 67,
      "start": 4975.0,
      "end": 4977.0,
      "formatted_start": "01:22:55.000",
      "formatted_end": "01:22:57.000",
      "text": "در اون زرار این پای بچه بات کرده"
    },
    {
      "id": 68,
      "start": 4977.0,
      "end": 4980.5,
      "formatted_start": "01:22:57.000",
      "formatted_end": "01:23:00.500",
      "text": "بردم مرکز بداشت میگیرد اون رو سبیه زبن افعانت کرده"
    },
    {
      "id": 69,
      "start": 4980.5,
      "end": 4982.76,
      "formatted_start": "01:23:00.500",
      "formatted_end": "01:23:02.760",
      "text": "بعد داخل این سه روز بشه تکیز کرده"
    },
    {
      "id": 70,
      "start": 4982.76,
      "end": 4984.5,
      "formatted_start": "01:23:02.760",
      "formatted_end": "01:23:04.500",
      "text": "بیس پنجه و ایبو پروفون هم بشه"
    },
    {
      "id": 71,
      "start": 4984.5,
      "end": 4985.76,
      "formatted_start": "01:23:04.500",
      "formatted_end": "01:23:05.760",
      "text": "باقی دیدم اینجا من ببینم"
    },
    {
      "id": 72,
      "start": 4985.76,
      "end": 4989.26,
      "formatted_start": "01:23:05.760",
      "formatted_end": "01:23:09.260",
      "text": "الان این پاش شما بیزنبه در واقع کنید باد کرده"
    },
    {
      "id": 73,
      "start": 4989.26,
      "end": 4989.76,
      "formatted_start": "01:23:09.260",
      "formatted_end": "01:23:09.760",
      "text": "اینجا دست بگیرده"
    },
    {
      "id": 74,
      "start": 4989.76,
      "end": 4991.62,
      "formatted_start": "01:23:09.760",
      "formatted_end": "01:23:11.620",
      "text": "نه نه این افعانت نیست دار"
    },
    {
      "id": 75,
      "start": 4991.62,
      "end": 4994.1,
      "formatted_start": "01:23:11.620",
      "formatted_end": "01:23:14.100",
      "text": "این حالت لوکه شده ببالا"
    },
    {
      "id": 76,
      "start": 4994.1,
      "end": 4995.46,
      "formatted_start": "01:23:14.100",
      "formatted_end": "01:23:15.460",
      "text": "یعنی اینقدر"
    },
    {
      "id": 77,
      "start": 4995.46,
      "end": 4997.34,
      "formatted_start": "01:23:15.460",
      "formatted_end": "01:23:17.340",
      "text": "حالت کچک شده نگران ناشد"
    },
    {
      "id": 78,
      "start": 4997.34,
      "end": 4998.14,
      "formatted_start": "01:23:17.340",
      "formatted_end": "01:23:18.140",
      "text": "افعانت باشه"
    },
    {
      "id": 79,
      "start": 4998.14,
      "end": 5000.14,
      "formatted_start": "01:23:18.140",
      "formatted_end": "01:23:20.140",
      "text": "از اینجا دست کذاشت"
    },
    {
      "id": 80,
      "start": 5000.14,
      "end": 5002.14,
      "formatted_start": "01:23:20.140",
      "formatted_end": "01:23:22.140",
      "text": "دیدم، دیدم، دیدم"
    },
    {
      "id": 81,
      "start": 5002.14,
      "end": 5004.14,
      "formatted_start": "01:23:22.140",
      "formatted_end": "01:23:24.140",
      "text": "آره، آره، دیدم"
    },
    {
      "id": 82,
      "start": 5004.14,
      "end": 5006.14,
      "formatted_start": "01:23:24.140",
      "formatted_end": "01:23:26.140",
      "text": "از اینجا دست کذاشت"
    },
    {
      "id": 83,
      "start": 5006.14,
      "end": 5008.14,
      "formatted_start": "01:23:26.140",
      "formatted_end": "01:23:28.140",
      "text": "از اینجا دست کذاشت"
    },
    {
      "id": 84,
      "start": 5008.14,
      "end": 5010.14,
      "formatted_start": "01:23:28.140",
      "formatted_end": "01:23:30.140",
      "text": "داخل این سه روز من مردم"
    },
    {
      "id": 85,
      "start": 5010.14,
      "end": 5012.14,
      "formatted_start": "01:23:30.140",
      "formatted_end": "01:23:32.140",
      "text": "مرکبه داشت، گفتیم افونت کرده ببر"
    },
    {
      "id": 86,
      "start": 5012.14,
      "end": 5014.14,
      "formatted_start": "01:23:32.140",
      "formatted_end": "01:23:34.140",
      "text": "سونگرافی بدیدیم"
    },
    {
      "id": 87,
      "start": 5014.14,
      "end": 5016.14,
      "formatted_start": "01:23:34.140",
      "formatted_end": "01:23:36.140",
      "text": "چون لکش کرده؟"
    },
    {
      "id": 88,
      "start": 5016.14,
      "end": 5018.14,
      "formatted_start": "01:23:36.140",
      "formatted_end": "01:23:38.140",
      "text": "این واکنش واکسن بوده"
    },
    {
      "id": 89,
      "start": 5018.14,
      "end": 5020.14,
      "formatted_start": "01:23:38.140",
      "formatted_end": "01:23:40.140",
      "text": "راکسیون داده واکسن"
    },
    {
      "id": 90,
      "start": 5020.14,
      "end": 5022.14,
      "formatted_start": "01:23:40.140",
      "formatted_end": "01:23:42.140",
      "text": "حالت صفی و برم بزرگ"
    },
    {
      "id": 91,
      "start": 5022.14,
      "end": 5024.14,
      "formatted_start": "01:23:42.140",
      "formatted_end": "01:23:44.140",
      "text": "آره میگه مثلا سطحی زده تو گوشتی نزده واکسن"
    },
    {
      "id": 92,
      "start": 5024.14,
      "end": 5026.14,
      "formatted_start": "01:23:44.140",
      "formatted_end": "01:23:46.140",
      "text": "نه"
    },
    {
      "id": 93,
      "start": 5026.14,
      "end": 5029.38,
      "formatted_start": "01:23:46.140",
      "formatted_end": "01:23:49.380",
      "text": "انا سفیسکین 250 رو با ایبو پرفون سرز رو دارم بهش میدم"
    },
    {
      "id": 94,
      "start": 5029.38,
      "end": 5030.68,
      "formatted_start": "01:23:49.380",
      "formatted_end": "01:23:50.680",
      "text": "حالا بهش بده"
    },
    {
      "id": 95,
      "start": 5030.68,
      "end": 5032.68,
      "formatted_start": "01:23:50.680",
      "formatted_end": "01:23:52.680",
      "text": "انا سفیسکین رو بهش بده مشکل نداری؟"
    },
    {
      "id": 96,
      "start": 5032.68,
      "end": 5035.08,
      "formatted_start": "01:23:52.680",
      "formatted_end": "01:23:55.080",
      "text": "نه اشکال ها چون اگه من بگم نده"
    },
    {
      "id": 97,
      "start": 5035.08,
      "end": 5037.08,
      "formatted_start": "01:23:55.080",
      "formatted_end": "01:23:57.080",
      "text": "این نصر فالیسکین 250 رو بود"
    },
    {
      "id": 98,
      "start": 5037.08,
      "end": 5039.08,
      "formatted_start": "01:23:57.080",
      "formatted_end": "01:23:59.080",
      "text": "گفتارو باش که گفتونیت کرده"
    },
    {
      "id": 99,
      "start": 5039.08,
      "end": 5041.08,
      "formatted_start": "01:23:59.080",
      "formatted_end": "01:24:01.080",
      "text": "باش کن خانداروی این گفتونی نیست"
    },
    {
      "id": 100,
      "start": 5041.08,
      "end": 5043.08,
      "formatted_start": "01:24:01.080",
      "formatted_end": "01:24:03.080",
      "text": "گفتونیت کنه تب میکنه"
    },
    {
      "id": 101,
      "start": 5043.08,
      "end": 5046.28,
      "formatted_start": "01:24:03.080",
      "formatted_end": "01:24:06.280",
      "text": "قربز میشه برم میکنه مثل آفسه میشه ازن دست"
    },
    {
      "id": 102,
      "start": 5046.28,
      "end": 5047.78,
      "formatted_start": "01:24:06.280",
      "formatted_end": "01:24:07.780",
      "text": "متجدیج دوری"
    },
    {
      "id": 103,
      "start": 5047.78,
      "end": 5050.94,
      "formatted_start": "01:24:07.780",
      "formatted_end": "01:24:10.940",
      "text": "این واقعیش واقعی است. اون داره اشتباه میده."
    },
    {
      "id": 104,
      "start": 5050.94,
      "end": 5053.48,
      "formatted_start": "01:24:10.940",
      "formatted_end": "01:24:13.480",
      "text": "الان سفالکسینی 25 جا بشناده بشندم."
    },
    {
      "id": 105,
      "start": 5053.48,
      "end": 5054.62,
      "formatted_start": "01:24:13.480",
      "formatted_end": "01:24:14.620",
      "text": "یه روز دیگه بده."
    },
    {
      "id": 106,
      "start": 5054.62,
      "end": 5055.62,
      "formatted_start": "01:24:14.620",
      "formatted_end": "01:24:15.620",
      "text": "تا فردا بشندم."
    },
    {
      "id": 107,
      "start": 5055.62,
      "end": 5057.42,
      "formatted_start": "01:24:15.620",
      "formatted_end": "01:24:17.420",
      "text": "یه دوره کامل بشد و یه قطعه شد."
    },
    {
      "id": 108,
      "start": 5057.42,
      "end": 5059.42,
      "formatted_start": "01:24:17.420",
      "formatted_end": "01:24:19.420",
      "text": "باشه چون گفتم بیتون بیدون باید باید بشن."
    },
    {
      "id": 109,
      "start": 5059.42,
      "end": 5064.42,
      "formatted_start": "01:24:19.420",
      "formatted_end": "01:24:24.420",
      "text": "الان ما امپولی زکسیمی ما 10 برابر سفالکسین قوی داره."
    },
    {
      "id": 110,
      "start": 5064.42,
      "end": 5065.92,
      "formatted_start": "01:24:24.420",
      "formatted_end": "01:24:25.920",
      "text": "چی؟ سفالکسین خود؟"
    },
    {
      "id": 111,
      "start": 5065.92,
      "end": 5067.92,
      "formatted_start": "01:24:25.920",
      "formatted_end": "01:24:27.920",
      "text": "میدونم سفالکسین."
    },
    {
      "id": 112,
      "start": 5067.92,
      "end": 5070.88,
      "formatted_start": "01:24:27.920",
      "formatted_end": "01:24:30.880",
      "text": "سفالکسین اون سفالکسیمی ما قوی است."
    },
    {
      "id": 113,
      "start": 5070.88,
      "end": 5072.88,
      "formatted_start": "01:24:30.880",
      "formatted_end": "01:24:32.880",
      "text": "خود گریتروم های سینما روند توشه شده"
    },
    {
      "id": 114,
      "start": 5072.88,
      "end": 5075.88,
      "formatted_start": "01:24:32.880",
      "formatted_end": "01:24:35.880",
      "text": "آره بعد گفتم بیتون بیدم که باز با دانو شما غاطی نشد"
    },
    {
      "id": 115,
      "start": 5075.88,
      "end": 5076.88,
      "formatted_start": "01:24:35.880",
      "formatted_end": "01:24:36.880",
      "text": "تلافت نمیدونی"
    },
    {
      "id": 116,
      "start": 5076.88,
      "end": 5077.88,
      "formatted_start": "01:24:36.880",
      "formatted_end": "01:24:37.880",
      "text": "نه مورد نمیدونی"
    },
    {
      "id": 117,
      "start": 5077.88,
      "end": 5078.88,
      "formatted_start": "01:24:37.880",
      "formatted_end": "01:24:38.880",
      "text": "باشه دستگوله درمون"
    },
    {
      "id": 118,
      "start": 5078.88,
      "end": 5079.88,
      "formatted_start": "01:24:38.880",
      "formatted_end": "01:24:39.880",
      "text": "درمون داروهای صیت نرم شده"
    },
    {
      "id": 119,
      "start": 5079.88,
      "end": 5080.88,
      "formatted_start": "01:24:39.880",
      "formatted_end": "01:24:40.880",
      "text": "باشه"
    },
    {
      "id": 120,
      "start": 5080.88,
      "end": 5081.88,
      "formatted_start": "01:24:40.880",
      "formatted_end": "01:24:41.880",
      "text": "خدافید"
    },
    {
      "id": 121,
      "start": 5081.88,
      "end": 5082.88,
      "formatted_start": "01:24:41.880",
      "formatted_end": "01:24:42.880",
      "text": "خدافید"
    },
    {
      "id": 122,
      "start": 5082.88,
      "end": 5083.88,
      "formatted_start": "01:24:42.880",
      "formatted_end": "01:24:43.880",
