  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5116.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:16.000",
      "text": "افریه، می صرفیم، خب اینا در موامل برای بیمار، از این دکترین، هرزش خوارنن و زندگی رو معنادار نیابند."
    },
    {
      "id": 1,
      "start": 5116.0,
      "end": 5119.0,
      "formatted_start": "01:25:16.000",
      "formatted_end": "01:25:19.000",
      "text": "این یک مثل"
    },
    {
      "id": 2,
      "start": 5119.0,
      "end": 5122.5,
      "formatted_start": "01:25:19.000",
      "formatted_end": "01:25:22.500",
      "text": "یه دست که ساره هستم که نظر میکنم"
    },
    {
      "id": 3,
      "start": 5122.5,
      "end": 5124.2,
      "formatted_start": "01:25:22.500",
      "formatted_end": "01:25:24.200",
      "text": "معنادار نمی آمد"
    },
    {
      "id": 4,
      "start": 5124.2,
      "end": 5127.98,
      "formatted_start": "01:25:24.200",
      "formatted_end": "01:25:27.980",
      "text": "به هر صورتی معنادار نمی آمد"
    },
    {
      "id": 5,
      "start": 5127.98,
      "end": 5131.0,
      "formatted_start": "01:25:27.980",
      "formatted_end": "01:25:31.000",
      "text": "این که میگم به هر صورتی به این جهد کنیم"
    },
    {
      "id": 6,
      "start": 5131.0,
      "end": 5134.1,
      "formatted_start": "01:25:31.000",
      "formatted_end": "01:25:34.100",
      "text": "گاهی معنادار ما نمی آمد"
    },
    {
      "id": 7,
      "start": 5134.1,
      "end": 5139.9,
      "formatted_start": "01:25:34.100",
      "formatted_end": "01:25:39.900",
      "text": "چون به نظرم میگم در زمینی همه ارزش ها جهدی هسته"
    },
    {
      "id": 8,
      "start": 5139.9,
      "end": 5143.32,
      "formatted_start": "01:25:39.900",
      "formatted_end": "01:25:43.320",
      "text": "به دست خود ما درست شدن"
    },
    {
      "id": 9,
      "start": 5143.32,
      "end": 5148.96,
      "formatted_start": "01:25:43.320",
      "formatted_end": "01:25:48.960",
      "text": "و هر روزی که دسته باید باید گوز شدن و اعتبار بگیردن"
    },
    {
      "id": 10,
      "start": 5148.96,
      "end": 5154.36,
      "formatted_start": "01:25:48.960",
      "formatted_end": "01:25:54.360",
      "text": "میخوایید که دسته باید بیرون میشن و اعتبارشون را دست میده"
    },
    {
      "id": 11,
      "start": 5154.36,
      "end": 5162.42,
      "formatted_start": "01:25:54.360",
      "formatted_end": "01:26:02.420",
      "text": "اگر به این باید بشید و من همین یک بار ازش ترک میگم"
    },
    {
      "id": 12,
      "start": 5162.42,
      "end": 5164.56,
      "formatted_start": "01:26:02.420",
      "formatted_end": "01:26:04.560",
      "text": "ازش دیگر ترک میگم"
    },
    {
      "id": 13,
      "start": 5164.56,
      "end": 5170.78,
      "formatted_start": "01:26:04.560",
      "formatted_end": "01:26:10.780",
      "text": "یعنی هیچی گاری در ارزش ها"
    },
    {
      "id": 14,
      "start": 5170.78,
      "end": 5175.78,
      "formatted_start": "01:26:10.780",
      "formatted_end": "01:26:15.780",
      "text": "ارزش ها هیچند، ما درستش رو می‌کنیم، ارزشی میکنند"
    },
    {
      "id": 15,
      "start": 5175.78,
      "end": 5180.78,
      "formatted_start": "01:26:15.780",
      "formatted_end": "01:26:20.780",
      "text": "ارزش ها همه هیچند، دابه تبیری می‌کنند، دابه توچند"
    },
    {
      "id": 16,
      "start": 5180.78,
      "end": 5184.78,
      "formatted_start": "01:26:20.780",
      "formatted_end": "01:26:24.780",
      "text": "و یک معنیشی که قرار داد که"
    },
    {
      "id": 17,
      "start": 5184.78,
      "end": 5188.78,
      "formatted_start": "01:26:24.780",
      "formatted_end": "01:26:28.780",
      "text": "شیطان ما قرار دادیم که پشت چراقه بگیریم"
    },
    {
      "id": 18,
      "start": 5188.78,
      "end": 5194.78,
      "formatted_start": "01:26:28.780",
      "formatted_end": "01:26:34.780",
      "text": "و پشت چراقه سر نمی‌سید به حرکت کنید"
    },
    {
      "id": 19,
      "start": 5194.78,
      "end": 5198.78,
      "formatted_start": "01:26:34.780",
      "formatted_end": "01:26:38.780",
      "text": "و پشت چراقه زر آماده بر حرکت کنید"
    },
    {
      "id": 20,
      "start": 5198.78,
      "end": 5228.78,
      "formatted_start": "01:26:38.780",
      "formatted_end": "01:27:08.780",
      "text": "اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید که این کشتر را بردارید، اگر باید بردارید"
    },
    {
      "id": 21,
      "start": 5228.78,
      "end": 5239.08,
      "formatted_start": "01:27:08.780",
      "formatted_end": "01:27:19.080",
      "text": "قرار داد کردید که راسته و قرار داد کردید که این شبه نیست"
    },
    {
      "id": 22,
      "start": 5239.08,
      "end": 5245.12,
      "formatted_start": "01:27:19.080",
      "formatted_end": "01:27:25.120",
      "text": "یعنی قبه نروب گفتن و قصد راست گفتن هست"
    },
    {
      "id": 23,
      "start": 5245.12,
      "end": 5256.16,
      "formatted_start": "01:27:25.120",
      "formatted_end": "01:27:36.160",
      "text": "اینا اینه که پشت چراب درونست باید استاد و پشت چراب سبز نبانیستاد"
    },
    {
      "id": 24,
      "start": 5256.16,
      "end": 5258.16,
      "formatted_start": "01:27:36.160",
      "formatted_end": "01:27:38.160",
      "text": "این شارژر نیست"
    },
    {
      "id": 25,
      "start": 5258.16,
      "end": 5260.16,
      "formatted_start": "01:27:38.160",
      "formatted_end": "01:27:40.160",
