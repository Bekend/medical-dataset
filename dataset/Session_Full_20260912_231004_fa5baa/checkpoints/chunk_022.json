  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6613.2,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:13.200",
      "text": "نفردن را در تقسیم بندی، تو تقسیم بندی اول از اونهای باشید که فقط آمل نماشید، بلکه علاقه بر آمل بودن نازل زندگی هم باشید."
    },
    {
      "id": 1,
      "start": 6613.2,
      "end": 6622.2,
      "formatted_start": "01:50:13.200",
      "formatted_end": "01:50:22.200",
      "text": "و تو تقسیم بندی دوم هم هم اهل معنگیت باشید، هم اهل شقبانیت."
    },
    {
      "id": 2,
      "start": 6630.0,
      "end": 6659.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:59.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 6660.0,
      "end": 6688.0,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:28.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 6688.0,
      "end": 6706.0,
      "formatted_start": "01:51:28.000",
      "formatted_end": "01:51:46.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 6706.0,
      "end": 6708.0,
      "formatted_start": "01:51:46.000",
      "formatted_end": "01:51:48.000",
      "text": "درخواستان"
    },
    {
      "id": 6,
      "start": 6726.72,
      "end": 6729.68,
      "formatted_start": "01:52:06.720",
      "formatted_end": "01:52:09.680",
      "text": "بنابراین با سختی یک جور زندگی کنید"
    },
    {
      "id": 7,
      "start": 6729.68,
      "end": 6732.68,
      "formatted_start": "01:52:09.680",
      "formatted_end": "01:52:12.680",
      "text": "ولی به هیچ قیمت نخواهید مرگا به پذیری"
    },
    {
      "id": 8,
      "start": 6732.68,
      "end": 6736.68,
      "formatted_start": "01:52:12.680",
      "formatted_end": "01:52:16.680",
      "text": "ممنون شما ناشادتری زندگی رو خواهید داشت"
    },
    {
      "id": 9,
      "start": 6736.68,
      "end": 6741.68,
      "formatted_start": "01:52:16.680",
      "formatted_end": "01:52:21.680",
      "text": "بدتری زندگی رو خواهید داشت"
    },
    {
      "id": 10,
      "start": 6741.68,
      "end": 6745.68,
      "formatted_start": "01:52:21.680",
      "formatted_end": "01:52:25.680",
      "text": "نخوشایدتری زندگی رو خواهید داشت"
    },
    {
      "id": 11,
      "start": 6745.68,
      "end": 6754.68,
      "formatted_start": "01:52:25.680",
      "formatted_end": "01:52:34.680",
      "text": "پس کسانی که زندگیشون از این آدمی که گفتم بهتره و خوشایدتره"
    },
    {
      "id": 12,
      "start": 6754.68,
      "end": 6758.68,
      "formatted_start": "01:52:34.680",
      "formatted_end": "01:52:38.680",
      "text": "یا تو تقصیبندی اول توی قسم دیگه جا میگیرن"
    },
    {
      "id": 13,
      "start": 6758.68,
      "end": 6761.68,
      "formatted_start": "01:52:38.680",
      "formatted_end": "01:52:41.680",
      "text": "یا تو تقصیبندی دومان توی قسم دیگه اینجا میگیرن"
    },
    {
      "id": 14,
      "start": 6761.68,
      "end": 6765.68,
      "formatted_start": "01:52:41.680",
      "formatted_end": "01:52:45.680",
      "text": "یا تو تقسیم بندی اسکبون توی یا در دست دیگه جا میگیرن"
    },
    {
      "id": 15,
      "start": 6765.68,
      "end": 6769.68,
      "formatted_start": "01:52:45.680",
      "formatted_end": "01:52:49.680",
      "text": "یا تو تقسیم بندی چهارم توی یا دست دیگه جا میگیرن"
    },
    {
      "id": 16,
      "start": 6769.68,
      "end": 6773.68,
      "formatted_start": "01:52:49.680",
      "formatted_end": "01:52:53.680",
      "text": "خواستن این بیاد اون چیزی تا بیار"
    },
    {
      "id": 17,
      "start": 6773.68,
      "end": 6777.68,
      "formatted_start": "01:52:53.680",
      "formatted_end": "01:52:57.680",
      "text": "اون برگا بیار"
    },
    {
      "id": 18,
      "start": 6777.68,
      "end": 6781.68,
      "formatted_start": "01:52:57.680",
      "formatted_end": "01:53:01.680",
      "text": "یا پریجکتر هم آوردیم"
    },
    {
      "id": 19,
      "start": 6781.68,
      "end": 6785.68,
      "formatted_start": "01:53:01.680",
      "formatted_end": "01:53:05.680",
      "text": "یا پریجکتر هم آوردیم"
    },
    {
      "id": 20,
      "start": 6785.68,
      "end": 6789.68,
      "formatted_start": "01:53:05.680",
      "formatted_end": "01:53:09.680",
      "text": "یا پریجکتر هم آوردیم"
    },
    {
      "id": 21,
      "start": 6789.68,
      "end": 6791.68,
      "formatted_start": "01:53:09.680",
      "formatted_end": "01:53:11.680",
      "text": "آره"
    },
    {
      "id": 22,
      "start": 6791.68,
      "end": 6793.68,
      "formatted_start": "01:53:11.680",
      "formatted_end": "01:53:13.680",
      "text": "خب"
    },
    {
      "id": 23,
      "start": 6793.68,
      "end": 6795.68,
      "formatted_start": "01:53:13.680",
      "formatted_end": "01:53:15.680",
      "text": "میشه نمون جون؟"
    },
    {
      "id": 24,
      "start": 6795.68,
      "end": 6797.68,
      "formatted_start": "01:53:15.680",
      "formatted_end": "01:53:17.680",
      "text": "چقدر میترسی؟"
    },
    {
      "id": 25,
      "start": 6797.68,
      "end": 6799.68,
      "formatted_start": "01:53:17.680",
      "formatted_end": "01:53:19.680",
      "text": "میشی"
    },
    {
      "id": 26,
      "start": 6799.68,
      "end": 6801.68,
      "formatted_start": "01:53:19.680",
      "formatted_end": "01:53:21.680",
      "text": "با لبخندی که زدی یعنی نصف میترسی"
    },
    {
      "id": 27,
      "start": 6801.68,
      "end": 6803.68,
      "formatted_start": "01:53:21.680",
      "formatted_end": "01:53:23.680",
      "text": "با سوزنه؟"
    },
    {
      "id": 28,
      "start": 6803.68,
      "end": 6805.68,
      "formatted_start": "01:53:23.680",
      "formatted_end": "01:53:25.680",
      "text": "نه دست نیست"
    },
    {
      "id": 29,
      "start": 6805.68,
      "end": 6807.68,
      "formatted_start": "01:53:25.680",
      "formatted_end": "01:53:27.680",
      "text": "اصلا فکر نکن"
    },
    {
      "id": 30,
      "start": 6807.68,
      "end": 6809.68,
      "formatted_start": "01:53:27.680",
      "formatted_end": "01:53:29.680",
      "text": "تو خواهد بگیر فکر کن که گوشت سراخت میشه"
    },
    {
      "id": 31,
      "start": 6809.68,
      "end": 6811.68,
      "formatted_start": "01:53:29.680",
      "formatted_end": "01:53:31.680",
      "text": "که چونه چندش فکر نکن"
    },
    {
      "id": 32,
      "start": 6811.68,
      "end": 6813.68,
      "formatted_start": "01:53:31.680",
      "formatted_end": "01:53:33.680",
      "text": "چون اگر فکر کنی عصابت خورد میشه"
    },
    {
      "id": 33,
      "start": 6813.68,
      "end": 6815.68,
      "formatted_start": "01:53:33.680",
      "formatted_end": "01:53:35.680",
      "text": "خب"
    },
    {
      "id": 34,
      "start": 6815.68,
      "end": 6817.68,
      "formatted_start": "01:53:35.680",
      "formatted_end": "01:53:37.680",
      "text": "تمام"
    },
    {
      "id": 35,
      "start": 6817.68,
      "end": 6821.3,
      "formatted_start": "01:53:37.680",
      "formatted_end": "01:53:41.300",
      "text": "کسی که خابوز خواهد"
    },
    {
      "id": 36,
      "start": 6821.3,
      "end": 6823.0,
      "formatted_start": "01:53:41.300",
      "formatted_end": "01:53:43.000",
      "text": "جور من دست نشین"
    },
    {
      "id": 37,
      "start": 6823.0,
      "end": 6825.4,
      "formatted_start": "01:53:43.000",
      "formatted_end": "01:53:45.400",
      "text": "الان اینجا جور هندوستانه"
    },
    {
      "id": 38,
      "start": 6825.4,
      "end": 6828.4,
      "formatted_start": "01:53:45.400",
      "formatted_end": "01:53:48.400",
      "text": "بعد رفتی پیش دوستات پوزدادی"
    },
    {
      "id": 39,
      "start": 6828.4,
      "end": 6830.6,
      "formatted_start": "01:53:48.400",
      "formatted_end": "01:53:50.600",
      "text": "که من سه تا سراخ دارم"
    },
    {
      "id": 40,
      "start": 6830.6,
      "end": 6833.36,
      "formatted_start": "01:53:50.600",
      "formatted_end": "01:53:53.360",
      "text": "و سه تا گوشواره ایداختم"
    },
    {
      "id": 41,
      "start": 6833.36,
      "end": 6835.3,
      "formatted_start": "01:53:53.360",
      "formatted_end": "01:53:55.300",
      "text": "چی؟ اون رو فکر کنی"
    },
    {
      "id": 42,
      "start": 6835.3,
      "end": 6836.5,
      "formatted_start": "01:53:55.300",
      "formatted_end": "01:53:56.500",
      "text": "همه چی فراموش میشون"
    },
    {
      "id": 43,
      "start": 6836.5,
      "end": 6837.36,
      "formatted_start": "01:53:56.500",
      "formatted_end": "01:53:57.360",
      "text": "آفرین"
    },
    {
      "id": 44,
      "start": 6837.36,
      "end": 6840.0,
      "formatted_start": "01:53:57.360",
      "formatted_end": "01:54:00.000",
      "text": "بشین الان"
    },
    {
      "id": 45,
      "start": 6840.0,
      "end": 6841.36,
      "formatted_start": "01:54:00.000",
      "formatted_end": "01:54:01.360",
      "text": "صندقی شمار یک"
    },
    {
      "id": 46,
      "start": 6841.36,
      "end": 6844.44,
      "formatted_start": "01:54:01.360",
      "formatted_end": "01:54:04.440",
      "text": "دیگه آقای دوتو سراخ کرده همه چی رو همه چی رو"
    },
    {
      "id": 47,
      "start": 6844.44,
      "end": 6847.94,
      "formatted_start": "01:54:04.440",
      "formatted_end": "01:54:07.940",
      "text": "و الان 25 سال به گوشای بچه ها رو سلاخ می کنیم"
    },
    {
      "id": 48,
      "start": 6847.94,
      "end": 6849.78,
      "formatted_start": "01:54:07.940",
      "formatted_end": "01:54:09.780",
      "text": "خب از آدم آورده هست"
    },
    {
      "id": 49,
      "start": 6849.78,
      "end": 6852.2,
      "formatted_start": "01:54:09.780",
      "formatted_end": "01:54:12.200",
      "text": "هرکی اینو میبینیم رسیدشون من سلاخ کردیم"
    },
    {
      "id": 50,
      "start": 6852.2,
      "end": 6855.2,
      "formatted_start": "01:54:12.200",
      "formatted_end": "01:54:15.200",
      "text": "خب این سواقع قدیم قدیم دارم"
    },
    {
      "id": 51,
      "start": 6855.2,
      "end": 6856.44,
      "formatted_start": "01:54:15.200",
      "formatted_end": "01:54:16.440",
      "text": "چی؟"
    },
    {
      "id": 52,
      "start": 6856.44,
      "end": 6858.44,
      "formatted_start": "01:54:16.440",
      "formatted_end": "01:54:18.440",
      "text": "اونها سواقع چند سال تشابه"
    },
    {
      "id": 53,
      "start": 6858.44,
      "end": 6862.44,
      "formatted_start": "01:54:18.440",
      "formatted_end": "01:54:22.440",
      "text": "الان 25 سال سیم ساله که گوشا رو سلاخ می کنیم"
    },
    {
      "id": 54,
      "start": 6862.44,
      "end": 6866.44,
      "formatted_start": "01:54:22.440",
      "formatted_end": "01:54:26.440",
      "text": "بچه هایی که می ترسن خراب میشه"
    },
    {
      "id": 55,
      "start": 6866.44,
      "end": 6868.44,
      "formatted_start": "01:54:26.440",
      "formatted_end": "01:54:28.440",
      "text": "بچه هایی که می ترسن خیلی خوب میشه"
    },
    {
      "id": 56,
      "start": 6868.44,
      "end": 6871.44,
      "formatted_start": "01:54:28.440",
      "formatted_end": "01:54:31.440",
      "text": "خب از این ردیسه بچه هایی هست دیگه"
    },
    {
      "id": 57,
      "start": 6871.44,
      "end": 6874.64,
      "formatted_start": "01:54:31.440",
      "formatted_end": "01:54:34.640",
      "text": "خیلی خوب میشه بیا پنکم برد بزرم"
    },
    {
      "id": 58,
      "start": 6874.64,
      "end": 6876.64,
      "formatted_start": "01:54:34.640",
      "formatted_end": "01:54:36.640",
      "text": "برد بزرم"
    },
    {
      "id": 59,
      "start": 6876.64,
      "end": 6878.64,
      "formatted_start": "01:54:36.640",
      "formatted_end": "01:54:38.640",
      "text": "خنک بشین"
    },
    {
      "id": 60,
      "start": 6878.64,
      "end": 6880.64,
      "formatted_start": "01:54:38.640",
      "formatted_end": "01:54:40.640",
      "text": "اندازه هاش هم بهش نشون میدارم"
    },
    {
      "id": 61,
      "start": 6880.64,
      "end": 6882.64,
      "formatted_start": "01:54:40.640",
      "formatted_end": "01:54:42.640",
      "text": "اندازه هاش هم بهش نشون میدارم"
    },
    {
      "id": 62,
      "start": 6882.64,
      "end": 6884.64,
      "formatted_start": "01:54:42.640",
      "formatted_end": "01:54:44.640",
      "text": "برد برد برش"
    },
    {
      "id": 63,
      "start": 6892.64,
      "end": 6894.64,
      "formatted_start": "01:54:52.640",
      "formatted_end": "01:54:54.640",
      "text": "یه سی هم زدی"
    },
    {
      "id": 64,
      "start": 6894.64,
      "end": 6898.64,
      "formatted_start": "01:54:54.640",
      "formatted_end": "01:54:58.640",
      "text": "بودم مامون من دوتا ماباوه همون یه دونه روش بلا کنم باسته"
    },
    {
      "id": 65,
      "start": 6898.64,
      "end": 6900.64,
      "formatted_start": "01:54:58.640",
      "formatted_end": "01:55:00.640",
      "text": "چقدر میخوایش بلا کنی؟"
    }
  ],
  "status": "completed"
}