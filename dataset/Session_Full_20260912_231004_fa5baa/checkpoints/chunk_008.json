  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2430.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:30.000",
      "text": "این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهیر داره، این هم کهی"
    },
    {
      "id": 1,
      "start": 2430.0,
      "end": 2431.0,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:31.000",
      "text": "بیوار بزنه"
    },
    {
      "id": 2,
      "start": 2431.0,
      "end": 2432.0,
      "formatted_start": "00:40:31.000",
      "formatted_end": "00:40:32.000",
      "text": "خشنگ بیسته؟"
    },
    {
      "id": 3,
      "start": 2432.0,
      "end": 2434.0,
      "formatted_start": "00:40:32.000",
      "formatted_end": "00:40:34.000",
      "text": "به من بگیر کنسل باشه"
    },
    {
      "id": 4,
      "start": 2434.0,
      "end": 2437.0,
      "formatted_start": "00:40:34.000",
      "formatted_end": "00:40:37.000",
      "text": "خب این مریض دارو من رو هفتصد چهار کنی بزید داری؟"
    },
    {
      "id": 5,
      "start": 2437.0,
      "end": 2439.0,
      "formatted_start": "00:40:37.000",
      "formatted_end": "00:40:39.000",
      "text": "۵۵۰ دار"
    },
    {
      "id": 6,
      "start": 2439.0,
      "end": 2441.0,
      "formatted_start": "00:40:39.000",
      "formatted_end": "00:40:41.000",
      "text": "چه فایده ای داری من میخوام به حرفتو گوش بدن؟"
    },
    {
      "id": 7,
      "start": 2441.0,
      "end": 2442.0,
      "formatted_start": "00:40:41.000",
      "formatted_end": "00:40:42.000",
      "text": "سروم بدیم دیگه"
    },
    {
      "id": 8,
      "start": 2442.0,
      "end": 2445.0,
      "formatted_start": "00:40:42.000",
      "formatted_end": "00:40:45.000",
      "text": "سروم ندیم سروم، آب نمکی بدن"
    },
    {
      "id": 9,
      "start": 2445.0,
      "end": 2448.0,
      "formatted_start": "00:40:45.000",
      "formatted_end": "00:40:48.000",
      "text": "بیش اومده، میخواییم بستریش کنی؟"
    },
    {
      "id": 10,
      "start": 2448.0,
      "end": 2450.0,
      "formatted_start": "00:40:48.000",
      "formatted_end": "00:40:50.000",
      "text": "نه بستریش نمیخواییم"
    },
    {
      "id": 11,
      "start": 2450.0,
      "end": 2452.0,
      "formatted_start": "00:40:50.000",
      "formatted_end": "00:40:52.000",
      "text": "بیا چنان، آقایی گلچین"
    },
    {
      "id": 12,
      "start": 2452.0,
      "end": 2455.0,
      "formatted_start": "00:40:52.000",
      "formatted_end": "00:40:55.000",
      "text": "برای سلامتی خودت ما داریم میگیم"
    },
    {
      "id": 13,
      "start": 2455.0,
      "end": 2456.0,
      "formatted_start": "00:40:55.000",
      "formatted_end": "00:40:56.000",
      "text": "باید خوبه شده"
    },
    {
      "id": 14,
      "start": 2456.0,
      "end": 2459.0,
      "formatted_start": "00:40:56.000",
      "formatted_end": "00:40:59.000",
      "text": "ببینیم الان من میتونم حرفتو بشنم ولی اشتباه کردم"
    },
    {
      "id": 15,
      "start": 2459.0,
      "end": 2460.0,
      "formatted_start": "00:40:59.000",
      "formatted_end": "00:41:00.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 2460.0,
      "end": 2461.0,
      "formatted_start": "00:41:00.000",
      "formatted_end": "00:41:01.000",
      "text": "بعد اشتباه"
    },
    {
      "id": 17,
      "start": 2462.0,
      "end": 2465.0,
      "formatted_start": "00:41:02.000",
      "formatted_end": "00:41:05.000",
      "text": "بعد آراتو ریتالین و ریسپریدون هم استفاده می کنیم"
    },
    {
      "id": 18,
      "start": 2465.0,
      "end": 2467.0,
      "formatted_start": "00:41:05.000",
      "formatted_end": "00:41:07.000",
      "text": "آها ریتالین و ریسپریدون"
    },
    {
      "id": 19,
      "start": 2467.0,
      "end": 2468.0,
      "formatted_start": "00:41:07.000",
      "formatted_end": "00:41:08.000",
      "text": "نه اشکال نداره"
    },
    {
      "id": 20,
      "start": 2468.0,
      "end": 2471.0,
      "formatted_start": "00:41:08.000",
      "formatted_end": "00:41:11.000",
      "text": "مهم اونها رو قبلا استفاده می کردیم بخواهیم بخشیم"
    },
    {
      "id": 21,
      "start": 2471.0,
      "end": 2472.0,
      "formatted_start": "00:41:11.000",
      "formatted_end": "00:41:12.000",
      "text": "آره"
    },
    {
      "id": 22,
      "start": 2472.0,
      "end": 2474.0,
      "formatted_start": "00:41:12.000",
      "formatted_end": "00:41:14.000",
      "text": "خب من تضافتونی"
    },
    {
      "id": 23,
      "start": 2474.0,
      "end": 2476.0,
      "formatted_start": "00:41:14.000",
      "formatted_end": "00:41:16.000",
      "text": "نه من داریم میگم مثلا"
    },
    {
      "id": 24,
      "start": 2476.0,
      "end": 2477.0,
      "formatted_start": "00:41:16.000",
      "formatted_end": "00:41:17.000",
      "text": "آراتو همین که در جایی باشیم"
    },
    {
      "id": 25,
      "start": 2477.0,
      "end": 2479.0,
      "formatted_start": "00:41:17.000",
      "formatted_end": "00:41:19.000",
      "text": "آره اشکال نداره"
    },
    {
      "id": 26,
      "start": 2479.0,
      "end": 2480.0,
      "formatted_start": "00:41:19.000",
      "formatted_end": "00:41:20.000",
      "text": "آره من داریم"
    },
    {
      "id": 27,
      "start": 2480.0,
      "end": 2484.0,
      "formatted_start": "00:41:20.000",
      "formatted_end": "00:41:24.000",
      "text": "و دادارات آهان و سینک و این رو هم بهش میدن همه؟ مشکل نداره؟"
    },
    {
      "id": 28,
      "start": 2484.0,
      "end": 2495.0,
      "formatted_start": "00:41:24.000",
      "formatted_end": "00:41:35.000",
      "text": "نه، این رو با همون آلرژی داده، با همون ماده ایسانس کلین داره، حساسیت داده، خب، این رو ببخور بکنن این سریع هم خوب میشه، با همین یک تا دو تددیگ بزن"
    },
    {
      "id": 29,
      "start": 2495.0,
      "end": 2500.0,
      "formatted_start": "00:41:35.000",
      "formatted_end": "00:41:40.000",
      "text": "ولی اون شروط و قرصی که می نویسهم رو یه سه چهار روزی بدید"
    },
    {
      "id": 30,
      "start": 2500.0,
      "end": 2506.0,
      "formatted_start": "00:41:40.000",
      "formatted_end": "00:41:46.000",
      "text": "مثلا خوب شد، الان مثلا ما تزدیقش زدیم تا خونه نرفته، می نویسهم پاش خوب شده، خوشحالشه"
    },
    {
      "id": 31,
      "start": 2506.0,
      "end": 2514.0,
      "formatted_start": "00:41:46.000",
      "formatted_end": "00:41:54.000",
      "text": "ولی اگه قد درول و خوراکی رو ندید، باید یک دو روز دیگه برمی گرده، باید یه دکتر رو یه داستان دیگه"
    },
    {
      "id": 32,
      "start": 2514.0,
      "end": 2517.0,
      "formatted_start": "00:41:54.000",
      "formatted_end": "00:41:57.000",
      "text": "اونو ادامه بیدید تا یه سه روز چیز بشه"
    },
    {
      "id": 33,
      "start": 2517.0,
      "end": 2521.0,
      "formatted_start": "00:41:57.000",
      "formatted_end": "00:42:01.000",
      "text": "آفرین آقای گوچین، اسمش چی بود امیجون؟"
    },
    {
      "id": 34,
      "start": 2521.0,
      "end": 2523.0,
      "formatted_start": "00:42:01.000",
      "formatted_end": "00:42:03.000",
      "text": "محمد آب"
    },
    {
      "id": 35,
      "start": 2523.0,
      "end": 2525.0,
      "formatted_start": "00:42:03.000",
      "formatted_end": "00:42:05.000",
      "text": "محمد آب، آفرین"
    },
    {
      "id": 36,
      "start": 2525.0,
      "end": 2527.0,
      "formatted_start": "00:42:05.000",
      "formatted_end": "00:42:07.000",
      "text": "چیشی همانطور شده بودن؟"
    },
    {
      "id": 37,
      "start": 2527.0,
      "end": 2529.0,
      "formatted_start": "00:42:07.000",
      "formatted_end": "00:42:09.000",
      "text": "نه، این ها همی جا میزنه و بعد دو مرتبه چیز میشن"
    },
    {
      "id": 38,
      "start": 2529.0,
      "end": 2531.0,
      "formatted_start": "00:42:09.000",
      "formatted_end": "00:42:11.000",
      "text": "میشن این طاول که"
    },
    {
      "id": 39,
      "start": 2531.0,
      "end": 2533.0,
      "formatted_start": "00:42:11.000",
      "formatted_end": "00:42:13.000",
      "text": "آیا گوشین، این ها یه متع حمله ایه"
    },
    {
      "id": 40,
      "start": 2533.0,
      "end": 2535.0,
      "formatted_start": "00:42:13.000",
      "formatted_end": "00:42:15.000",
      "text": "آره، یه رقص همه ایه"
    },
    {
      "id": 41,
      "start": 2535.0,
      "end": 2537.0,
      "formatted_start": "00:42:15.000",
      "formatted_end": "00:42:17.000",
      "text": "یک جا گون میشه و بعد یه متع هوا سرکت باز بکنه"
    },
    {
      "id": 42,
      "start": 2537.0,
      "end": 2539.0,
      "formatted_start": "00:42:17.000",
      "formatted_end": "00:42:19.000",
      "text": "و این ها گون میشه و بعد گرم میشه"
    },
    {
      "id": 43,
      "start": 2539.0,
      "end": 2541.0,
      "formatted_start": "00:42:19.000",
      "formatted_end": "00:42:21.000",
      "text": "گفتیم آب بزن خیست کرده"
    },
    {
      "id": 44,
      "start": 2541.0,
      "end": 2543.0,
      "formatted_start": "00:42:21.000",
      "formatted_end": "00:42:23.000",
      "text": "این بشکار نداره، این پروسه هاشو بعد از غذا بدیم"
    },
    {
      "id": 45,
      "start": 2543.0,
      "end": 2545.0,
      "formatted_start": "00:42:23.000",
      "formatted_end": "00:42:25.000",
      "text": "شربت هم داره دارو زیاد نرمیشتن"
    },
    {
      "id": 46,
      "start": 2545.0,
      "end": 2547.0,
      "formatted_start": "00:42:25.000",
      "formatted_end": "00:42:27.000",
      "text": "دست شما دارد"
    },
    {
      "id": 47,
      "start": 2547.0,
      "end": 2549.0,
      "formatted_start": "00:42:27.000",
      "formatted_end": "00:42:29.000",
      "text": "بعد آیوتو ایدیانال دارو خورکی خواباور که است؟"
    },
    {
      "id": 48,
      "start": 2549.0,
      "end": 2553.0,
      "formatted_start": "00:42:29.000",
      "formatted_end": "00:42:33.000",
      "text": "چرا؟ یکشون یه مقدار هیدروپسیزین یه مقدار خواباوره"
    },
    {
      "id": 49,
      "start": 2553.0,
      "end": 2555.0,
      "formatted_start": "00:42:33.000",
      "formatted_end": "00:42:35.000",
      "text": "ولی زیاد نه"
    },
    {
      "id": 50,
      "start": 2555.0,
      "end": 2557.0,
      "formatted_start": "00:42:35.000",
      "formatted_end": "00:42:37.000",
      "text": "خودون بعد شب بخوره یا؟"
    },
    {
      "id": 51,
      "start": 2557.0,
      "end": 2559.0,
      "formatted_start": "00:42:37.000",
      "formatted_end": "00:42:39.000",
      "text": "نه روزی دو سو بار بخوره"
    },
    {
      "id": 52,
      "start": 2559.0,
      "end": 2561.0,
      "formatted_start": "00:42:39.000",
      "formatted_end": "00:42:41.000",
      "text": "چونه تأثیر خواباوره نیست"
    },
    {
      "id": 53,
      "start": 2561.0,
      "end": 2563.0,
      "formatted_start": "00:42:41.000",
      "formatted_end": "00:42:43.000",
      "text": "بسیار ریسپیلیتونش خواباوره دیگه"
    },
    {
      "id": 54,
      "start": 2563.0,
      "end": 2565.0,
      "formatted_start": "00:42:43.000",
      "formatted_end": "00:42:45.000",
      "text": "آره این هم وجود نیست که خیلی گیش کنه"
    },
    {
      "id": 55,
      "start": 2565.0,
      "end": 2567.0,
      "formatted_start": "00:42:45.000",
      "formatted_end": "00:42:47.000",
      "text": "دیامونه"
    },
    {
      "id": 56,
      "start": 2567.0,
      "end": 2569.0,
      "formatted_start": "00:42:47.000",
      "formatted_end": "00:42:49.000",
      "text": "بس شما شاملشون خیلی ممنون"
    },
    {
      "id": 57,
      "start": 2569.0,
      "end": 2571.0,
      "formatted_start": "00:42:49.000",
      "formatted_end": "00:42:51.000",
      "text": "خودسکرسی"
    },
    {
      "id": 58,
      "start": 2571.0,
      "end": 2573.0,
      "formatted_start": "00:42:51.000",
      "formatted_end": "00:42:53.000",
      "text": "بخشید آمادی"
    },
    {
      "id": 59,
      "start": 2573.0,
      "end": 2575.0,
      "formatted_start": "00:42:53.000",
      "formatted_end": "00:42:55.000",
      "text": "اول تون رفتون باشه"
    },
    {
      "id": 60,
      "start": 2575.0,
      "end": 2577.0,
      "formatted_start": "00:42:55.000",
      "formatted_end": "00:42:57.000",
      "text": "کتاش بیاد اگر نه با اون فرمان رو میرفتن"
    },
    {
      "id": 61,
      "start": 2577.0,
      "end": 2579.0,
      "formatted_start": "00:42:57.000",
      "formatted_end": "00:42:59.000",
      "text": "نمیشه"
    },
    {
      "id": 62,
      "start": 2579.0,
      "end": 2581.0,
      "formatted_start": "00:42:59.000",
      "formatted_end": "00:43:01.000",
      "text": "باید می کنیم"
    },
    {
      "id": 63,
      "start": 2583.0,
      "end": 2585.0,
      "formatted_start": "00:43:03.000",
      "formatted_end": "00:43:05.000",
      "text": "آ خانسانی کولورفیرنامی"
    },
    {
      "id": 64,
      "start": 2585.0,
      "end": 2587.0,
      "formatted_start": "00:43:05.000",
      "formatted_end": "00:43:07.000",
      "text": "بتامتازان"
    },
    {
      "id": 65,
      "start": 2587.0,
      "end": 2589.0,
      "formatted_start": "00:43:07.000",
      "formatted_end": "00:43:09.000",
      "text": "یادش کن کولورفیرنامی"
    },
    {
      "id": 66,
      "start": 2589.0,
      "end": 2591.0,
      "formatted_start": "00:43:09.000",
      "formatted_end": "00:43:11.000",
      "text": "آمپول"
    },
    {
      "id": 67,
      "start": 2591.0,
      "end": 2593.0,
      "formatted_start": "00:43:11.000",
      "formatted_end": "00:43:13.000",
      "text": "بتامتازان"
    },
    {
      "id": 68,
      "start": 2593.0,
      "end": 2601.0,
      "formatted_start": "00:43:13.000",
      "formatted_end": "00:43:21.000",
      "text": "پلس پلسیونون شربت هیدروکسیزین"
    },
    {
      "id": 69,
      "start": 2601.0,
      "end": 2603.0,
      "formatted_start": "00:43:21.000",
      "formatted_end": "00:43:23.000",
      "text": "آیا چونه؟ بفرماییم"
    },
    {
      "id": 70,
      "start": 2603.0,
      "end": 2604.0,
      "formatted_start": "00:43:23.000",
      "formatted_end": "00:43:24.000",
      "text": "سلام"
    },
    {
      "id": 71,
      "start": 2604.0,
      "end": 2606.0,
      "formatted_start": "00:43:24.000",
      "formatted_end": "00:43:26.000",
      "text": "سلام، اینجا بزنش داری؟ خواهش می کنم"
    },
    {
      "id": 72,
      "start": 2606.0,
      "end": 2609.0,
      "formatted_start": "00:43:26.000",
      "formatted_end": "00:43:29.000",
      "text": "برگتونم بزن بگیر"
    },
    {
      "id": 73,
      "start": 2609.0,
      "end": 2612.0,
      "formatted_start": "00:43:29.000",
      "formatted_end": "00:43:32.000",
      "text": "اوکی مده ریبا کن چیز داری؟"
    },
    {
      "id": 74,
      "start": 2612.0,
      "end": 2614.0,
      "formatted_start": "00:43:32.000",
      "formatted_end": "00:43:34.000",
      "text": "با، بنده باشم پشکن باز کن"
    },
    {
      "id": 75,
      "start": 2614.0,
      "end": 2615.0,
      "formatted_start": "00:43:34.000",
      "formatted_end": "00:43:35.000",
      "text": "پشکن"
    },
    {
      "id": 76,
      "start": 2615.0,
      "end": 2617.0,
      "formatted_start": "00:43:35.000",
      "formatted_end": "00:43:37.000",
      "text": "پشکن"
    },
    {
      "id": 77,
      "start": 2617.0,
      "end": 2619.0,
      "formatted_start": "00:43:37.000",
      "formatted_end": "00:43:39.000",
      "text": "مشکلی که نداشت"
    },
    {
      "id": 78,
      "start": 2619.0,
      "end": 2622.0,
      "formatted_start": "00:43:39.000",
      "formatted_end": "00:43:42.000",
      "text": "این روشنه از قبلی بوده"
    },
    {
      "id": 79,
      "start": 2622.0,
      "end": 2625.0,
      "formatted_start": "00:43:42.000",
      "formatted_end": "00:43:45.000",
      "text": "نه خود پیچه اینا"
    },
    {
      "id": 80,
      "start": 2625.0,
      "end": 2628.0,
      "formatted_start": "00:43:45.000",
      "formatted_end": "00:43:48.000",
      "text": "پس داروی چیزی میدین؟ چرا؟"
    },
    {
      "id": 81,
      "start": 2628.0,
      "end": 2631.0,
      "formatted_start": "00:43:48.000",
      "formatted_end": "00:43:51.000",
      "text": "خوابات نیست"
    },
    {
      "id": 82,
      "start": 2631.0,
      "end": 2634.0,
      "formatted_start": "00:43:51.000",
      "formatted_end": "00:43:54.000",
      "text": "باش میدین شروط عورانینی اینا بهش میدین؟"
    },
    {
      "id": 83,
      "start": 2634.0,
      "end": 2637.0,
      "formatted_start": "00:43:54.000",
      "formatted_end": "00:43:57.000",
      "text": "یا مثلا تایمیتیکون اینا؟"
    },
    {
      "id": 84,
      "start": 2637.0,
      "end": 2640.0,
      "formatted_start": "00:43:57.000",
      "formatted_end": "00:44:00.000",
      "text": "دوست ها که"
    },
    {
      "id": 85,
      "start": 2640.0,
      "end": 2643.0,
      "formatted_start": "00:44:00.000",
      "formatted_end": "00:44:03.000",
      "text": "درخواهان چیزی داری؟"
    },
    {
      "id": 86,
      "start": 2643.0,
      "end": 2646.0,
      "formatted_start": "00:44:03.000",
      "formatted_end": "00:44:06.000",
      "text": "شاید دار چی هست؟"
    },
    {
      "id": 87,
      "start": 2646.0,
      "end": 2676.0,
      "formatted_start": "00:44:06.000",
      "formatted_end": "00:44:36.000",
      "text": "این بیشتر از اینجا برای اینکه از اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا ب"
    },
    {
      "id": 88,
      "start": 2676.0,
      "end": 2678.0,
      "formatted_start": "00:44:36.000",
      "formatted_end": "00:44:38.000",
      "text": "نه نه نه"
    },
    {
      "id": 89,
      "start": 2678.0,
      "end": 2680.0,
      "formatted_start": "00:44:38.000",
      "formatted_end": "00:44:40.000",
      "text": "یک رای دیگه"
    },
    {
      "id": 90,
      "start": 2680.0,
      "end": 2682.0,
      "formatted_start": "00:44:40.000",
      "formatted_end": "00:44:42.000",
      "text": "دیگه نیست"
    },
    {
      "id": 91,
      "start": 2682.0,
      "end": 2684.0,
      "formatted_start": "00:44:42.000",
      "formatted_end": "00:44:44.000",
      "text": "نخش هم پرده دارم"
    },
    {
      "id": 92,
      "start": 2684.0,
      "end": 2686.0,
      "formatted_start": "00:44:44.000",
      "formatted_end": "00:44:46.000",
      "text": "نخش بخیر"
    },
    {
      "id": 93,
      "start": 2686.0,
      "end": 2688.0,
