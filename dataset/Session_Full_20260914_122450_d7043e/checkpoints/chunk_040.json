  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12003.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:03.000",
      "text": "بعد پیارید فراد باز با همه این نووتاتون بباره بیان."
    },
    {
      "id": 1,
      "start": 12003.0,
      "end": 12005.0,
      "formatted_start": "03:20:03.000",
      "formatted_end": "03:20:05.000",
      "text": "باشی باشی"
    },
    {
      "id": 2,
      "start": 12005.0,
      "end": 12006.0,
      "formatted_start": "03:20:05.000",
      "formatted_end": "03:20:06.000",
      "text": "ببخشید"
    },
    {
      "id": 3,
      "start": 12006.0,
      "end": 12008.0,
      "formatted_start": "03:20:06.000",
      "formatted_end": "03:20:08.000",
      "text": "الان دارو آروریز بگیری؟"
    },
    {
      "id": 4,
      "start": 12008.0,
      "end": 12011.0,
      "formatted_start": "03:20:08.000",
      "formatted_end": "03:20:11.000",
      "text": "آره اون که من دیوز برات با سونو گرافی نداشتم"
    },
    {
      "id": 5,
      "start": 12011.0,
      "end": 12012.0,
      "formatted_start": "03:20:11.000",
      "formatted_end": "03:20:12.000",
      "text": "جانر"
    },
    {
      "id": 6,
      "start": 12012.0,
      "end": 12013.0,
      "formatted_start": "03:20:12.000",
      "formatted_end": "03:20:13.000",
      "text": "خب اونگاه چه اینجا؟"
    },
    {
      "id": 7,
      "start": 12013.0,
      "end": 12016.0,
      "formatted_start": "03:20:13.000",
      "formatted_end": "03:20:16.000",
      "text": "بچه ها بهشو نگفتن باید با سونو گرافی بیان"
    },
    {
      "id": 8,
      "start": 12016.0,
      "end": 12020.0,
      "formatted_start": "03:20:16.000",
      "formatted_end": "03:20:20.000",
      "text": "اول هر دو نفر با سونو بیان همین آمده شد"
    },
    {
      "id": 9,
      "start": 12020.0,
      "end": 12021.0,
      "formatted_start": "03:20:20.000",
      "formatted_end": "03:20:21.000",
      "text": "برداباره"
    },
    {
      "id": 10,
      "start": 12021.0,
      "end": 12022.0,
      "formatted_start": "03:20:21.000",
      "formatted_end": "03:20:22.000",
      "text": "باید چه شد؟"
    },
    {
      "id": 11,
      "start": 12022.0,
      "end": 12024.0,
      "formatted_start": "03:20:22.000",
      "formatted_end": "03:20:24.000",
      "text": "اون دیگه اومدم یک خدست هست یکم زودتر داشته شد"
    },
    {
      "id": 12,
      "start": 12024.0,
      "end": 12025.0,
      "formatted_start": "03:20:24.000",
      "formatted_end": "03:20:25.000",
      "text": "الان که اومدم سریع برسته؟"
    },
    {
      "id": 13,
      "start": 12025.0,
      "end": 12026.0,
      "formatted_start": "03:20:25.000",
      "formatted_end": "03:20:26.000",
      "text": "آره خب آره"
    },
    {
      "id": 14,
      "start": 12026.0,
      "end": 12028.0,
      "formatted_start": "03:20:26.000",
      "formatted_end": "03:20:28.000",
      "text": "بخورد"
    },
    {
      "id": 15,
      "start": 12028.0,
      "end": 12030.0,
      "formatted_start": "03:20:28.000",
      "formatted_end": "03:20:30.000",
      "text": "خانم دوکر خسته نماشه"
    },
    {
      "id": 16,
      "start": 12030.0,
      "end": 12032.0,
      "formatted_start": "03:20:30.000",
      "formatted_end": "03:20:32.000",
