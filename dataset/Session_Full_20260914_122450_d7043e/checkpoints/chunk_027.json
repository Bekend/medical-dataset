    {
      "start": 8397.284,
      "end": 8399.967,
      "formatted_start": "02:19:57.284",
      "formatted_end": "02:19:59.967",
      "speaker": "SPEAKER_02"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8102.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:02.000",
      "text": "سالم باشیم کارم."
    },
    {
      "id": 1,
      "start": 8102.0,
      "end": 8108.0,
      "formatted_start": "02:15:02.000",
      "formatted_end": "02:15:08.000",
      "text": "خواندکتر، الان یعنی ما، نظر من خودم، شوهرم چی داخل مدن کار می کنه؟ بوجی سی میلیون؟"
    },
    {
      "id": 2,
      "start": 8108.0,
      "end": 8116.0,
      "formatted_start": "02:15:08.000",
      "formatted_end": "02:15:16.000",
      "text": "مثلا من، یه بار ده همه آنفول رو زنم، یه بار سی یک هم، چیش میمانه آیه سی میلیون؟"
    },
    {
      "id": 3,
      "start": 8116.0,
      "end": 8126.0,
      "formatted_start": "02:15:16.000",
      "formatted_end": "02:15:26.000",
      "text": "یا کار، من یه چیز به تو بگم، تو باز برو خدا تو شکن، ما الان سه تا از خدم های بیمارستان عزت و منصومه، خدمه که باید همه جیش رو همه چی رو جمع کنه،"
    },
    {
      "id": 4,
      "start": 8126.0,
      "end": 8131.3,
      "formatted_start": "02:15:26.000",
      "formatted_end": "02:15:31.300",
      "text": "ستا بی سرپرستن و ستا شون سرطان سیره دارن شیمی درمانی میکنن"
    },
    {
      "id": 5,
      "start": 8131.3,
      "end": 8133.5,
      "formatted_start": "02:15:31.300",
      "formatted_end": "02:15:33.500",
      "text": "یعنی شیمی درمانی میکنن خواهد دارن"
    },
    {
      "id": 6,
      "start": 8133.5,
      "end": 8136.2,
      "formatted_start": "02:15:33.500",
      "formatted_end": "02:15:36.200",
      "text": "خواهد دارن کارم رو انجام بدن"
    },
    {
      "id": 7,
      "start": 8136.2,
      "end": 8140.0,
      "formatted_start": "02:15:36.200",
      "formatted_end": "02:15:40.000",
      "text": "آره، من نیستم، میگم تو بیمارستان دارن میام کار میکنن"
    },
    {
      "id": 8,
      "start": 8140.0,
      "end": 8143.0,
      "formatted_start": "02:15:40.000",
      "formatted_end": "02:15:43.000",
      "text": "شوهر ندم و بچه ها رو اونجا هم میکنن"
    },
    {
      "id": 9,
      "start": 8143.0,
      "end": 8147.0,
      "formatted_start": "02:15:43.000",
      "formatted_end": "02:15:47.000",
      "text": "خود بینید که بعد شیمی درمانی فرداش حالت طب و خدا"
    },
    {
      "id": 10,
      "start": 8147.0,
      "end": 8149.0,
      "formatted_start": "02:15:47.000",
      "formatted_end": "02:15:49.000",
      "text": "امنوترافی باز اینقدر حالش برده شده"
    },
    {
      "id": 11,
      "start": 8149.0,
      "end": 8151.82,
      "formatted_start": "02:15:49.000",
      "formatted_end": "02:15:51.820",
      "text": "نه، اما امیروترافیه هم مثلاً حالاً خوبه"
    },
    {
      "id": 12,
      "start": 8151.82,
      "end": 8154.76,
      "formatted_start": "02:15:51.820",
      "formatted_end": "02:15:54.760",
      "text": "از این دفعه دیگه کم استرس رو جوش داشتم"
    },
    {
      "id": 13,
      "start": 8154.76,
      "end": 8155.76,
      "formatted_start": "02:15:54.760",
      "formatted_end": "02:15:55.760",
      "text": "یکم این حال شده"
    },
    {
      "id": 14,
      "start": 8155.76,
      "end": 8159.48,
      "formatted_start": "02:15:55.760",
      "formatted_end": "02:15:59.480",
      "text": "بگمش اینی درمونه، خیلی بردی کل استفراق خورد"
    },
    {
      "id": 15,
      "start": 8159.48,
      "end": 8160.04,
      "formatted_start": "02:15:59.480",
      "formatted_end": "02:16:00.040",
      "text": "خیلی"
    },
    {
      "id": 16,
      "start": 8160.04,
      "end": 8162.94,
      "formatted_start": "02:16:00.040",
      "formatted_end": "02:16:02.940",
      "text": "خب، همونو در همین همین مورسان کار میکنن"
    },
    {
      "id": 17,
      "start": 8162.94,
      "end": 8166.36,
      "formatted_start": "02:16:02.940",
      "formatted_end": "02:16:06.360",
      "text": "اوه، یعنی بلتر از بلت بسیار هست"
    },
    {
      "id": 18,
      "start": 8166.36,
      "end": 8168.94,
      "formatted_start": "02:16:06.360",
      "formatted_end": "02:16:08.940",
      "text": "آره، اشاله خود رو به سلامتی بگیم"
    },
    {
      "id": 19,
      "start": 8168.94,
      "end": 8170.44,
      "formatted_start": "02:16:08.940",
      "formatted_end": "02:16:10.440",
      "text": "یکم مورد دیگه هم بیاد باشه"
    },
    {
      "id": 20,
      "start": 8170.44,
      "end": 8172.44,
      "formatted_start": "02:16:10.440",
      "formatted_end": "02:16:12.440",
      "text": "باید باید باید بیاد بیاد"
    },
    {
      "id": 21,
      "start": 8179.0,
      "end": 8181.0,
      "formatted_start": "02:16:19.000",
      "formatted_end": "02:16:21.000",
      "text": "موسکن نوشتن برای شما"
    },
    {
      "id": 22,
      "start": 8181.0,
      "end": 8183.0,
      "formatted_start": "02:16:21.000",
      "formatted_end": "02:16:23.000",
      "text": "خدا باشه"
    },
    {
      "id": 23,
      "start": 8183.0,
      "end": 8185.0,
      "formatted_start": "02:16:23.000",
      "formatted_end": "02:16:25.000",
      "text": "دسته"
    },
    {
      "id": 24,
      "start": 8185.0,
      "end": 8187.0,
      "formatted_start": "02:16:25.000",
      "formatted_end": "02:16:27.000",
      "text": "برو منو تا سپس"
    },
    {
      "id": 25,
      "start": 8187.0,
      "end": 8189.0,
      "formatted_start": "02:16:27.000",
      "formatted_end": "02:16:29.000",
      "text": "داره همشو بگیر چکا باشه"
    },
    {
      "id": 26,
      "start": 8189.0,
      "end": 8191.0,
      "formatted_start": "02:16:29.000",
      "formatted_end": "02:16:31.000",
      "text": "خدا خدا"
    },
    {
      "id": 27,
      "start": 8191.0,
      "end": 8193.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:33.000",
      "text": "از این طبعا خوبه مثل ما هم خوشمونیم"
    },
    {
      "id": 28,
      "start": 8193.0,
      "end": 8195.0,
      "formatted_start": "02:16:33.000",
      "formatted_end": "02:16:35.000",
      "text": "خدا هم بنده خدا"
    },
    {
      "id": 29,
      "start": 8195.0,
      "end": 8197.0,
      "formatted_start": "02:16:35.000",
      "formatted_end": "02:16:37.000",
      "text": "الان یک سال و نیمه من درگیرم از دکتر نیامده"
    },
    {
      "id": 30,
      "start": 8197.0,
      "end": 8199.0,
      "formatted_start": "02:16:37.000",
      "formatted_end": "02:16:39.000",
      "text": "سلام از ما سادت خوبه"
    },
    {
      "id": 31,
      "start": 8199.0,
      "end": 8201.0,
      "formatted_start": "02:16:39.000",
      "formatted_end": "02:16:41.000",
      "text": "همشو پیش من بوده"
    },
    {
      "id": 32,
      "start": 8201.0,
      "end": 8203.0,
      "formatted_start": "02:16:41.000",
      "formatted_end": "02:16:43.000",
      "text": "خدا آمده شد"
    },
    {
      "id": 33,
      "start": 8203.0,
      "end": 8205.0,
      "formatted_start": "02:16:43.000",
      "formatted_end": "02:16:45.000",
      "text": "خدای شکر"
    },
    {
      "id": 34,
      "start": 8205.0,
      "end": 8207.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:47.000",
      "text": "چشده خالصو سرگیر بادونیم"
    },
    {
      "id": 35,
      "start": 8207.0,
      "end": 8209.0,
      "formatted_start": "02:16:47.000",
      "formatted_end": "02:16:49.000",
      "text": "من خدا نمی کنم"
    },
    {
      "id": 36,
      "start": 8209.0,
      "end": 8211.0,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:51.000",
      "text": "چند سالتونه؟"
    },
    {
      "id": 37,
      "start": 8211.0,
      "end": 8213.0,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:53.000",
      "text": "هم دکتور"
    },
    {
      "id": 38,
      "start": 8213.0,
      "end": 8215.0,
      "formatted_start": "02:16:53.000",
      "formatted_end": "02:16:55.000",
      "text": "چند سالتونه؟"
    },
    {
      "id": 39,
      "start": 8215.0,
      "end": 8217.0,
      "formatted_start": "02:16:55.000",
      "formatted_end": "02:16:57.000",
      "text": "چند سالتونه؟"
    },
    {
      "id": 40,
      "start": 8217.0,
      "end": 8219.0,
      "formatted_start": "02:16:57.000",
      "formatted_end": "02:16:59.000",
      "text": "چند سالتونه؟"
    },
    {
      "id": 41,
      "start": 8219.0,
      "end": 8249.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:29.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 42,
      "start": 8249.0,
      "end": 8251.0,
      "formatted_start": "02:17:29.000",
      "formatted_end": "02:17:31.000",
      "text": "چند شده هم درداد"
    },
    {
      "id": 43,
      "start": 8251.0,
      "end": 8253.0,
      "formatted_start": "02:17:31.000",
      "formatted_end": "02:17:33.000",
      "text": "کار کردی؟ چی کار کردی؟"
    },
    {
      "id": 44,
      "start": 8253.0,
      "end": 8255.0,
      "formatted_start": "02:17:33.000",
      "formatted_end": "02:17:35.000",
      "text": "کار کنم"
    },
    {
      "id": 45,
      "start": 8255.0,
      "end": 8259.0,
      "formatted_start": "02:17:35.000",
      "formatted_end": "02:17:39.000",
      "text": "مثلا روب بخواهید کار سنگی بگیر دستتون"
    },
    {
      "id": 46,
      "start": 8259.0,
      "end": 8261.0,
      "formatted_start": "02:17:39.000",
      "formatted_end": "02:17:41.000",
      "text": "نه نه"
    },
    {
      "id": 47,
      "start": 8261.0,
      "end": 8263.0,
      "formatted_start": "02:17:41.000",
      "formatted_end": "02:17:43.000",
      "text": "روب پرسه و این کارها رو نمی کنند"
    },
    {
      "id": 48,
      "start": 8263.0,
      "end": 8265.0,
      "formatted_start": "02:17:43.000",
      "formatted_end": "02:17:45.000",
      "text": "جا رو تمیز کردن"
    },
    {
      "id": 49,
      "start": 8265.0,
      "end": 8267.0,
      "formatted_start": "02:17:45.000",
      "formatted_end": "02:17:47.000",
      "text": "اینجور دستی یک بانه"
    },
    {
      "id": 50,
      "start": 8267.0,
      "end": 8269.0,
      "formatted_start": "02:17:47.000",
      "formatted_end": "02:17:49.000",
      "text": "خب"
    },
    {
      "id": 51,
      "start": 8269.0,
      "end": 8271.0,
      "formatted_start": "02:17:49.000",
      "formatted_end": "02:17:51.000",
      "text": "این دستی هر سه جوش هست"
    },
    {
      "id": 52,
      "start": 8271.0,
      "end": 8273.0,
      "formatted_start": "02:17:51.000",
      "formatted_end": "02:17:53.000",
      "text": "اون نه نه"
    },
    {
      "id": 53,
      "start": 8273.0,
      "end": 8277.0,
      "formatted_start": "02:17:53.000",
      "formatted_end": "02:17:57.000",
      "text": "شک بشه سرم رو براش میبینم"
    },
    {
      "id": 54,
      "start": 8277.0,
      "end": 8279.0,
      "formatted_start": "02:17:57.000",
      "formatted_end": "02:17:59.000",
      "text": "خیلی مردم ای قدم"
    },
    {
      "id": 55,
      "start": 8279.0,
      "end": 8282.0,
      "formatted_start": "02:17:59.000",
      "formatted_end": "02:18:02.000",
      "text": "مثلا من ببینم که همش صدا میکنه"
    },
    {
      "id": 56,
      "start": 8282.0,
      "end": 8283.0,
      "formatted_start": "02:18:02.000",
      "formatted_end": "02:18:03.000",
      "text": "خیلی"
    },
    {
      "id": 57,
      "start": 8283.0,
      "end": 8284.0,
      "formatted_start": "02:18:03.000",
      "formatted_end": "02:18:04.000",
      "text": "شبا"
    },
    {
      "id": 58,
      "start": 8284.0,
      "end": 8285.0,
      "formatted_start": "02:18:04.000",
      "formatted_end": "02:18:05.000",
      "text": "همش"
    },
    {
      "id": 59,
      "start": 8285.0,
      "end": 8286.0,
      "formatted_start": "02:18:05.000",
      "formatted_end": "02:18:06.000",
      "text": "بس الان"
    },
    {
      "id": 60,
      "start": 8286.0,
      "end": 8289.0,
      "formatted_start": "02:18:06.000",
      "formatted_end": "02:18:09.000",
      "text": "جدیدانی ها که برای درختا ماشینه"
    },
    {
      "id": 61,
      "start": 8289.0,
      "end": 8290.0,
      "formatted_start": "02:18:09.000",
      "formatted_end": "02:18:10.000",
      "text": "همکن صدا میکنه"
    },
    {
      "id": 62,
      "start": 8290.0,
      "end": 8291.0,
      "formatted_start": "02:18:10.000",
      "formatted_end": "02:18:11.000",
      "text": "چند وقتا اینجور؟"
    },
    {
      "id": 63,
      "start": 8291.0,
      "end": 8294.0,
      "formatted_start": "02:18:11.000",
      "formatted_end": "02:18:14.000",
      "text": "خانم دکتر از موقعی که خوهرم خود کرده"
    },
    {
      "id": 64,
      "start": 8294.0,
      "end": 8296.0,
      "formatted_start": "02:18:14.000",
      "formatted_end": "02:18:16.000",
      "text": "اینگاه که 14 سال پیش"
    },
    {
      "id": 65,
      "start": 8296.0,
      "end": 8299.0,
      "formatted_start": "02:18:16.000",
      "formatted_end": "02:18:19.000",
      "text": "این بهش مثلا شب باید شد"
    },
    {
      "id": 66,
      "start": 8299.0,
      "end": 8302.0,
      "formatted_start": "02:18:19.000",
      "formatted_end": "02:18:22.000",
      "text": "بعد بردی من پیش دکتر رو گوش"
    },
    {
      "id": 67,
      "start": 8302.0,
      "end": 8304.0,
      "formatted_start": "02:18:22.000",
      "formatted_end": "02:18:24.000",
      "text": "گفت این مال عصابشه"
    },
    {
      "id": 68,
      "start": 8304.0,
      "end": 8306.0,
      "formatted_start": "02:18:24.000",
      "formatted_end": "02:18:26.000",
      "text": "هر موقع عصابش به هم گریزه"
    },
    {
      "id": 69,
      "start": 8306.0,
      "end": 8308.0,
      "formatted_start": "02:18:26.000",
      "formatted_end": "02:18:28.000",
      "text": "اینجورو میشه"
    },
    {
      "id": 70,
      "start": 8308.0,
      "end": 8310.0,
      "formatted_start": "02:18:28.000",
      "formatted_end": "02:18:30.000",
      "text": "باستاد براشه"
    },
    {
      "id": 71,
      "start": 8310.0,
      "end": 8312.0,
      "formatted_start": "02:18:30.000",
      "formatted_end": "02:18:32.000",
      "text": "من گفتم سمت یک چیزی هم لازم"
    },
    {
      "id": 72,
      "start": 8312.0,
      "end": 8314.0,
      "formatted_start": "02:18:32.000",
      "formatted_end": "02:18:34.000",
      "text": "گفتیم نه لازم نیست"
    },
    {
      "id": 73,
      "start": 8314.0,
      "end": 8316.0,
      "formatted_start": "02:18:34.000",
      "formatted_end": "02:18:36.000",
      "text": "صدا هم مثلا بعضی اوقات که چینجه"
    },
    {
      "id": 74,
      "start": 8316.0,
      "end": 8318.0,
      "formatted_start": "02:18:36.000",
      "formatted_end": "02:18:38.000",
      "text": "صدا هم نشنگاه"
    },
    {
      "id": 75,
      "start": 8318.0,
      "end": 8320.0,
      "formatted_start": "02:18:38.000",
      "formatted_end": "02:18:40.000",
      "text": "یک تاره دیگه اون افتاق شنوانه"
    },
    {
      "id": 76,
      "start": 8320.0,
      "end": 8322.0,
      "formatted_start": "02:18:40.000",
      "formatted_end": "02:18:42.000",
      "text": "اون مثل سکته گوشی"
    },
    {
      "id": 77,
      "start": 8322.0,
      "end": 8324.0,
      "formatted_start": "02:18:42.000",
      "formatted_end": "02:18:44.000",
      "text": "آنی"
    },
    {
      "id": 78,
      "start": 8328.0,
      "end": 8330.0,
      "formatted_start": "02:18:48.000",
      "formatted_end": "02:18:50.000",
      "text": "خیلی مادرم سختی کشیده دیگه"
    },
    {
      "id": 79,
      "start": 8330.0,
      "end": 8332.0,
      "formatted_start": "02:18:50.000",
      "formatted_end": "02:18:52.000",
      "text": "خوهرم"
    },
    {
      "id": 80,
      "start": 8332.0,
      "end": 8334.0,
      "formatted_start": "02:18:52.000",
      "formatted_end": "02:18:54.000",
      "text": "زرتان میله گرفت خود کرد"
    },
    {
      "id": 81,
      "start": 8334.0,
      "end": 8336.0,
      "formatted_start": "02:18:54.000",
      "formatted_end": "02:18:56.000",
      "text": "داداشم تو مردم ماند"
    },
    {
      "id": 82,
      "start": 8336.0,
      "end": 8339.0,
      "formatted_start": "02:18:56.000",
      "formatted_end": "02:18:59.000",
      "text": "الان هم ما هم که اینجورو"
    },
    {
      "id": 83,
      "start": 8339.0,
      "end": 8342.0,
      "formatted_start": "02:18:59.000",
      "formatted_end": "02:19:02.000",
      "text": "پدرم چند سالو پیش تصادف کرد فرد کرد"
    },
    {
      "id": 84,
      "start": 8342.0,
      "end": 8344.0,
      "formatted_start": "02:19:02.000",
      "formatted_end": "02:19:04.000",
      "text": "ای بابا"
    },
    {
      "id": 85,
      "start": 8344.0,
      "end": 8346.0,
      "formatted_start": "02:19:04.000",
      "formatted_end": "02:19:06.000",
      "text": "دیگه ببینی دو دست هستم"
    },
    {
      "id": 86,
      "start": 8346.0,
      "end": 8348.0,
      "formatted_start": "02:19:06.000",
      "formatted_end": "02:19:08.000",
      "text": "دو دست آدم دارم"
    },
    {
      "id": 87,
      "start": 8348.0,
      "end": 8351.0,
      "formatted_start": "02:19:08.000",
      "formatted_end": "02:19:11.000",
      "text": "یه سری میان همه چی به مورد"
    },
    {
      "id": 88,
      "start": 8351.0,
      "end": 8353.0,
      "formatted_start": "02:19:11.000",
      "formatted_end": "02:19:13.000",
      "text": "البته هیچ که خوشبخ نیست"
    },
    {
      "id": 89,
      "start": 8353.0,
      "end": 8356.0,
      "formatted_start": "02:19:13.000",
      "formatted_end": "02:19:16.000",
      "text": "اینجا این آدم هایی که میشینن هیچ که خوشبخ نیست"
    },
    {
      "id": 90,
      "start": 8356.0,
      "end": 8362.0,
      "formatted_start": "02:19:16.000",
      "formatted_end": "02:19:22.000",
      "text": "اونا با چیزهای علکیت قمگینه با یه سری آدم هست که واقعا دنیا دراشون نمیسازن"
    },
    {
      "id": 91,
      "start": 8362.0,
      "end": 8366.64,
      "formatted_start": "02:19:22.000",
      "formatted_end": "02:19:26.640",
      "text": "مادر جا دیگه گناهی نداره که پس هشتو مردم برننده دختر رو سرطان دارن"
    },
    {
      "id": 92,
      "start": 8366.64,
      "end": 8368.64,
      "formatted_start": "02:19:26.640",
      "formatted_end": "02:19:28.640",
      "text": "گناه هایی دوی نداشتن"
    },
    {
      "id": 93,
      "start": 8368.64,
      "end": 8371.24,
      "formatted_start": "02:19:28.640",
      "formatted_end": "02:19:31.240",
      "text": "پدرتون اتماعا از شما از یه سمسه"
    },
    {
      "id": 94,
      "start": 8371.24,
      "end": 8373.76,
      "formatted_start": "02:19:31.240",
      "formatted_end": "02:19:33.760",
      "text": "برس سرطان دارین دیگه جنتیکتون"
    },
    {
      "id": 95,
      "start": 8373.76,
      "end": 8376.56,
      "formatted_start": "02:19:33.760",
      "formatted_end": "02:19:36.560",
      "text": "الان مثلا مده و سینه ربطی نداشتن"
    },
    {
      "id": 96,
      "start": 8376.56,
      "end": 8379.16,
      "formatted_start": "02:19:36.560",
      "formatted_end": "02:19:39.160",
      "text": "نه خب نه نگاه جن سرطان داریم"
    },
    {
      "id": 97,
      "start": 8379.16,
      "end": 8382.36,
      "formatted_start": "02:19:39.160",
      "formatted_end": "02:19:42.360",
      "text": "بچه هاتون باید حتما دور از جنشون باشن"
    },
    {
      "id": 98,
      "start": 8382.36,
      "end": 8384.36,
      "formatted_start": "02:19:42.360",
      "formatted_end": "02:19:44.360",
      "text": "حتما باید درد نظر باشن"
    },
    {
      "id": 99,
      "start": 8384.36,
      "end": 8388.24,
      "formatted_start": "02:19:44.360",
      "formatted_end": "02:19:48.240",
      "text": "الان پدرسی ۱۲ ساله بختر رو زوردن"
    },
    {
      "id": 100,
      "start": 8388.24,
      "end": 8390.24,
      "formatted_start": "02:19:48.240",
      "formatted_end": "02:19:50.240",
      "text": "15 رسید دیگه پشت باشید"
    },
    {
      "id": 101,
      "start": 8394.74,
      "end": 8396.74,
      "formatted_start": "02:19:54.740",
      "formatted_end": "02:19:56.740",
      "text": "خانمی شما غن دارید؟"
    },
    {
      "id": 102,
      "start": 8396.74,
      "end": 8397.74,
      "formatted_start": "02:19:56.740",
      "formatted_end": "02:19:57.740",
      "text": "نه"
    },
    {
      "id": 103,
      "start": 8397.74,
      "end": 8399.74,
      "formatted_start": "02:19:57.740",
      "formatted_end": "02:19:59.740",
      "text": "به شما غن تا حالا که نداشتید؟"
    },
    {
      "id": 104,
      "start": 8399.74,
      "end": 8400.24,
      "formatted_start": "02:19:59.740",
      "formatted_end": "02:20:00.240",
      "text": "نه"
    }
  ],
  "status": "completed"
}