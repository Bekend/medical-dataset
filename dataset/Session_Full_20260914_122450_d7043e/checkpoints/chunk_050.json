    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 15000.0,
      "end": 15030.0,
      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 15030.0,
      "end": 15060.0,
      "formatted_start": "04:10:30.000",
      "formatted_end": "04:11:00.000",
      "text": "اینجا برای چیزی که برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا"
    },
    {
      "id": 2,
      "start": 15060.0,
      "end": 15063.0,
      "formatted_start": "04:11:00.000",
      "formatted_end": "04:11:03.000",
      "text": "اون کسر زمین کار کنه را لغه شده"
    },
    {
      "id": 3,
      "start": 15063.0,
      "end": 15066.0,
      "formatted_start": "04:11:03.000",
      "formatted_end": "04:11:06.000",
      "text": "اون کار کنه راگاش ضعیف شده پره میشه"
    },
    {
      "id": 4,
      "start": 15066.0,
      "end": 15068.0,
      "formatted_start": "04:11:06.000",
      "formatted_end": "04:11:08.000",
      "text": "اون خطر نداره"
    },
    {
      "id": 5,
      "start": 15068.0,
      "end": 15071.0,
      "formatted_start": "04:11:08.000",
      "formatted_end": "04:11:11.000",
      "text": "حاجه این چند کلمه بهت میگم خب؟"
    },
    {
      "id": 6,
      "start": 15071.0,
      "end": 15073.0,
      "formatted_start": "04:11:11.000",
      "formatted_end": "04:11:13.000",
      "text": "میز"
    },
    {
      "id": 7,
      "start": 15073.0,
      "end": 15075.0,
      "formatted_start": "04:11:13.000",
      "formatted_end": "04:11:15.000",
      "text": "میز"
    },
    {
      "id": 8,
      "start": 15075.0,
      "end": 15077.0,
      "formatted_start": "04:11:15.000",
      "formatted_end": "04:11:17.000",
      "text": "کتاب"
    },
    {
      "id": 9,
      "start": 15077.0,
      "end": 15079.0,
      "formatted_start": "04:11:17.000",
      "formatted_end": "04:11:19.000",
      "text": "ساعت"
    },
    {
      "id": 10,
      "start": 15079.0,
      "end": 15081.0,
      "formatted_start": "04:11:19.000",
      "formatted_end": "04:11:21.000",
      "text": "چی بود؟"
    },
    {
      "id": 11,
      "start": 15081.0,
      "end": 15083.0,
      "formatted_start": "04:11:21.000",
      "formatted_end": "04:11:23.000",
      "text": "میز کتاب"
    },
    {
      "id": 12,
      "start": 15083.0,
      "end": 15085.0,
      "formatted_start": "04:11:23.000",
      "formatted_end": "04:11:25.000",
      "text": "ساعت"
    },
    {
      "id": 13,
      "start": 15085.0,
      "end": 15087.0,
      "formatted_start": "04:11:25.000",
      "formatted_end": "04:11:27.000",
      "text": "خب این ستار یادت باشه"
    },
    {
      "id": 14,
      "start": 15087.0,
      "end": 15089.0,
      "formatted_start": "04:11:27.000",
      "formatted_end": "04:11:29.000",
      "text": "میز کتاب ساعت باشه؟"
    },
    {
      "id": 15,
      "start": 15089.0,
      "end": 15091.0,
      "formatted_start": "04:11:29.000",
      "formatted_end": "04:11:31.000",
      "text": "نیست که تا ساعت"
    },
    {
      "id": 16,
      "start": 15091.0,
      "end": 15093.0,
      "formatted_start": "04:11:31.000",
      "formatted_end": "04:11:33.000",
      "text": "خیلی خوب"
    },
    {
      "id": 17,
      "start": 15093.0,
      "end": 15095.0,
      "formatted_start": "04:11:33.000",
      "formatted_end": "04:11:35.000",
      "text": "بعد شب خوب میخوابین؟"
    },
    {
      "id": 18,
      "start": 15095.0,
      "end": 15097.0,
      "formatted_start": "04:11:35.000",
      "formatted_end": "04:11:37.000",
      "text": "راحت"
    },
    {
      "id": 19,
      "start": 15097.0,
      "end": 15099.0,
      "formatted_start": "04:11:37.000",
      "formatted_end": "04:11:39.000",
      "text": "خواب برد نمیبینی؟"
    },
    {
      "id": 20,
      "start": 15099.0,
      "end": 15101.0,
      "formatted_start": "04:11:39.000",
      "formatted_end": "04:11:41.000",
      "text": "نه خواب برد نمیبینم"
    },
    {
      "id": 21,
      "start": 15101.0,
      "end": 15103.0,
      "formatted_start": "04:11:41.000",
      "formatted_end": "04:11:43.000",
      "text": "راحت خواب"
    },
    {
      "id": 22,
      "start": 15103.0,
      "end": 15105.0,
      "formatted_start": "04:11:43.000",
      "formatted_end": "04:11:45.000",
      "text": "ضعف و به حاله نداره؟"
    },
    {
      "id": 23,
      "start": 15105.0,
      "end": 15107.0,
      "formatted_start": "04:11:45.000",
      "formatted_end": "04:11:47.000",
      "text": "نه"
    },
    {
      "id": 24,
      "start": 15107.0,
      "end": 15109.0,
      "formatted_start": "04:11:47.000",
      "formatted_end": "04:11:49.000",
      "text": "پشتاتون به غذا خوبه؟"
    },
    {
      "id": 25,
      "start": 15109.0,
      "end": 15111.0,
      "formatted_start": "04:11:49.000",
      "formatted_end": "04:11:51.000",
      "text": "خوبه"
    },
    {
      "id": 26,
      "start": 15111.0,
      "end": 15113.0,
      "formatted_start": "04:11:51.000",
      "formatted_end": "04:11:53.000",
      "text": "خودتون اینجا مشکلی پس نداره؟"
    },
    {
      "id": 27,
      "start": 15113.0,
      "end": 15115.0,
      "formatted_start": "04:11:53.000",
      "formatted_end": "04:11:55.000",
      "text": "نه همه چه خوبه"
    },
    {
      "id": 28,
      "start": 15115.0,
      "end": 15117.0,
      "formatted_start": "04:11:55.000",
      "formatted_end": "04:11:57.000",
      "text": "نه دلائی"
    },
    {
      "id": 29,
      "start": 15117.0,
      "end": 15122.0,
      "formatted_start": "04:11:57.000",
      "formatted_end": "04:12:02.000",
      "text": "از اینجا شما گرفتی، گم مکنه، چقدر بگرد ای تا پیدا بردگی یا پولاش رو گم مکنه"
    },
    {
      "id": 30,
      "start": 15122.0,
      "end": 15128.0,
      "formatted_start": "04:12:02.000",
      "formatted_end": "04:12:08.000",
      "text": "یا مثلا، برای پنجا، مثلا ده میدون، ست میدون میگه ده میدون"
    },
    {
      "id": 31,
      "start": 15128.0,
      "end": 15130.0,
      "formatted_start": "04:12:08.000",
      "formatted_end": "04:12:10.000",
      "text": "شده خونه رو اشتباه برد؟"
    },
    {
      "id": 32,
      "start": 15130.0,
      "end": 15132.0,
      "formatted_start": "04:12:10.000",
      "formatted_end": "04:12:12.000",
      "text": "نه نه، اشتباه نوشت نه"
    },
    {
      "id": 33,
      "start": 15132.0,
      "end": 15137.0,
      "formatted_start": "04:12:12.000",
      "formatted_end": "04:12:17.000",
      "text": "فقط عجله داری تو رفتن رو روی رای دگی میگه من زودتر برم دیگه"
    },
    {
      "id": 34,
      "start": 15137.0,
      "end": 15138.0,
      "formatted_start": "04:12:17.000",
      "formatted_end": "04:12:18.000",
      "text": "عجله داری"
    },
    {
      "id": 35,
      "start": 15138.0,
      "end": 15140.0,
      "formatted_start": "04:12:18.000",
      "formatted_end": "04:12:20.000",
      "text": "خب از قدیمون بوده یا الان شده؟"
    },
    {
      "id": 36,
      "start": 15140.0,
      "end": 15147.0,
      "formatted_start": "04:12:20.000",
      "formatted_end": "04:12:27.000",
      "text": "الان چند مدت اینجوری شده. یه سال دو، اینو ها. الان که نوشم تو از اون موقعی نوش مورد، علیزا قدقافی نوشه دیگه."
    },
    {
      "id": 37,
      "start": 15147.0,
      "end": 15148.0,
      "formatted_start": "04:12:27.000",
      "formatted_end": "04:12:28.000",
      "text": "تو کجا کشته شد؟"
    },
    {
      "id": 38,
      "start": 15148.0,
      "end": 15152.0,
      "formatted_start": "04:12:28.000",
      "formatted_end": "04:12:32.000",
      "text": "اونجا کشته شد چی؟ علیزا. علیزا قدقافی."
    },
    {
      "id": 39,
      "start": 15152.0,
      "end": 15153.0,
      "formatted_start": "04:12:32.000",
      "formatted_end": "04:12:33.000",
      "text": "توی چه کشته شد؟"
    },
    {
      "id": 40,
      "start": 15153.0,
      "end": 15161.0,
      "formatted_start": "04:12:33.000",
      "formatted_end": "04:12:41.000",
      "text": "هم تو هم تضابرات. از اون موقع یکم بچه ها رو که گرفتن و تیر زدن و زنان کردن، این هواست شده."
    },
    {
      "id": 41,
      "start": 15161.0,
      "end": 15162.0,
      "formatted_start": "04:12:41.000",
      "formatted_end": "04:12:42.000",
      "text": "بهش فشار آمده."
    },
    {
      "id": 42,
      "start": 15162.0,
      "end": 15164.76,
      "formatted_start": "04:12:42.000",
      "formatted_end": "04:12:44.760",
      "text": "اینان دیگه یه اتفاقی باعثش شده"
    },
    {
      "id": 43,
      "start": 15164.76,
      "end": 15166.56,
      "formatted_start": "04:12:44.760",
      "formatted_end": "04:12:46.560",
      "text": "آره، خشار بیشتر بهش آمده"
    },
    {
      "id": 44,
      "start": 15166.56,
      "end": 15173.0,
      "formatted_start": "04:12:46.560",
      "formatted_end": "04:12:53.000",
      "text": "اطفان دیروز اگه مریض دیگه آمد بچه منو پشت آمده"
    },
    {
      "id": 45,
      "start": 15173.0,
      "end": 15175.38,
      "formatted_start": "04:12:53.000",
      "formatted_end": "04:12:55.380",
      "text": "که فرقا فیلنه"
    },
    {
      "id": 46,
      "start": 15175.38,
      "end": 15178.1,
      "formatted_start": "04:12:55.380",
      "formatted_end": "04:12:58.100",
      "text": "مادرش محمودیه، باباشو نمیدونه"
    },
    {
      "id": 47,
      "start": 15178.1,
      "end": 15182.0,
      "formatted_start": "04:12:58.100",
      "formatted_end": "04:13:02.000",
      "text": "اونمانو مادرش بستایی شده از خسته"
    },
    {
      "id": 48,
      "start": 15182.0,
      "end": 15184.12,
      "formatted_start": "04:13:02.000",
      "formatted_end": "04:13:04.120",
      "text": "اما جوان ما رو پشت نمیدونه"
    },
    {
      "id": 49,
      "start": 15184.12,
      "end": 15187.0,
      "formatted_start": "04:13:04.120",
      "formatted_end": "04:13:07.000",
      "text": "دختر منو هم میشه"
    },
    {
      "id": 50,
      "start": 15187.0,
      "end": 15191.68,
      "formatted_start": "04:13:07.000",
      "formatted_end": "04:13:11.680",
      "text": "تیر زدن و دومان منو تیر زدن و دومان عدیزا رفتن"
    },
    {
      "id": 51,
      "start": 15191.68,
      "end": 15194.26,
      "formatted_start": "04:13:11.680",
      "formatted_end": "04:13:14.260",
      "text": "گردن دو ما زندان کردن خیلی سختی کشید"
    },
    {
      "id": 52,
      "start": 15194.26,
      "end": 15195.5,
      "formatted_start": "04:13:14.260",
      "formatted_end": "04:13:15.500",
      "text": "به داماده اش؟"
    },
    {
      "id": 53,
      "start": 15195.5,
      "end": 15197.48,
      "formatted_start": "04:13:15.500",
      "formatted_end": "04:13:17.480",
      "text": "نه نگاه نبه منه کشتن"
    },
    {
      "id": 54,
      "start": 15197.48,
      "end": 15199.84,
      "formatted_start": "04:13:17.480",
      "formatted_end": "04:13:19.840",
      "text": "اممش که دختر من باشه"
    },
    {
      "id": 55,
      "start": 15199.84,
      "end": 15200.78,
      "formatted_start": "04:13:19.840",
      "formatted_end": "04:13:20.780",
      "text": "و دامد منه"
    },
    {
      "id": 56,
      "start": 15200.78,
      "end": 15201.98,
      "formatted_start": "04:13:20.780",
      "formatted_end": "04:13:21.980",
      "text": "اموشه"
    },
    {
      "id": 57,
      "start": 15201.98,
      "end": 15204.16,
      "formatted_start": "04:13:21.980",
      "formatted_end": "04:13:24.160",
      "text": "سر آقای قلقافی گردن"
    },
    {
      "id": 58,
      "start": 15204.16,
      "end": 15205.24,
      "formatted_start": "04:13:24.160",
      "formatted_end": "04:13:25.240",
      "text": "زندان کردن"
    },
    {
      "id": 59,
      "start": 15205.24,
      "end": 15206.8,
      "formatted_start": "04:13:25.240",
      "formatted_end": "04:13:26.800",
      "text": "تک زدن دامد منه"
    },
    {
      "id": 60,
      "start": 15206.8,
      "end": 15207.98,
      "formatted_start": "04:13:26.800",
      "formatted_end": "04:13:27.980",
      "text": "سر منه"
    },
    {
      "id": 61,
      "start": 15207.98,
      "end": 15209.0,
      "formatted_start": "04:13:27.980",
      "formatted_end": "04:13:29.000",
      "text": "چی بلا سر منه"
    },
    {
      "id": 62,
      "start": 15209.0,
      "end": 15210.5,
      "formatted_start": "04:13:29.000",
      "formatted_end": "04:13:30.500",
      "text": "باید اگه اون بچه بوده"
    },
    {
      "id": 63,
      "start": 15210.5,
      "end": 15212.98,
      "formatted_start": "04:13:30.500",
      "formatted_end": "04:13:32.980",
      "text": "نه با خاطر اینکه رفتن چه آمدین تضابرات کن"
    },
    {
      "id": 64,
      "start": 15212.98,
      "end": 15215.12,
      "formatted_start": "04:13:32.980",
      "formatted_end": "04:13:35.120",
      "text": "همانه دو بچه ده تضابرات نیمدن که"
    },
    {
      "id": 65,
      "start": 15215.12,
      "end": 15217.08,
      "formatted_start": "04:13:35.120",
      "formatted_end": "04:13:37.080",
      "text": "آمده بودن بیرون زدنش"
    },
    {
      "id": 66,
      "start": 15221.68,
      "end": 15223.68,
      "formatted_start": "04:13:41.680",
      "formatted_end": "04:13:43.680",
      "text": "خب هاژی"
    },
    {
      "id": 67,
      "start": 15223.68,
      "end": 15225.68,
      "formatted_start": "04:13:43.680",
      "formatted_end": "04:13:45.680",
      "text": "چی بود کلمه ها؟"
    },
    {
      "id": 68,
      "start": 15225.68,
      "end": 15227.68,
      "formatted_start": "04:13:45.680",
      "formatted_end": "04:13:47.680",
      "text": "کلمه ها؟"
    },
    {
      "id": 69,
      "start": 15227.68,
      "end": 15229.68,
      "formatted_start": "04:13:47.680",
      "formatted_end": "04:13:49.680",
      "text": "حالا بگو"
    },
    {
      "id": 70,
      "start": 15229.68,
      "end": 15231.68,
      "formatted_start": "04:13:49.680",
      "formatted_end": "04:13:51.680",
