  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6002.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:02.000",
      "text": "این رسول رو میگو قبل از غذا بخورن."
    },
    {
      "id": 1,
      "start": 6002.0,
      "end": 6004.0,
      "formatted_start": "01:40:02.000",
      "formatted_end": "01:40:04.000",
      "text": "درسته؟"
    },
    {
      "id": 2,
      "start": 6004.0,
      "end": 6006.0,
      "formatted_start": "01:40:04.000",
      "formatted_end": "01:40:06.000",
      "text": "هر داشته همون رو برد."
    },
    {
      "id": 3,
      "start": 6006.0,
      "end": 6008.0,
      "formatted_start": "01:40:06.000",
      "formatted_end": "01:40:08.000",
      "text": "دو ماه میبشتم برای تو."
    },
    {
      "id": 4,
      "start": 6008.0,
      "end": 6013.0,
      "formatted_start": "01:40:08.000",
      "formatted_end": "01:40:13.000",
      "text": "اون میرفت دادم نوشته بود و گفت که یه تومنیکو خوردی هم دارو میشه."
    },
    {
      "id": 5,
      "start": 6013.0,
      "end": 6015.0,
      "formatted_start": "01:40:13.000",
      "formatted_end": "01:40:15.000",
      "text": "برای باید متخصص باید برد نوشته بود."
    },
    {
      "id": 6,
      "start": 6015.0,
      "end": 6017.0,
      "formatted_start": "01:40:15.000",
      "formatted_end": "01:40:17.000",
      "text": "نه، از من نمیدونم."
    },
    {
      "id": 7,
      "start": 6017.0,
      "end": 6019.0,
      "formatted_start": "01:40:17.000",
      "formatted_end": "01:40:19.000",
      "text": "سه ماه رو میدم."
    },
    {
      "id": 8,
      "start": 6019.0,
      "end": 6021.0,
      "formatted_start": "01:40:19.000",
      "formatted_end": "01:40:21.000",
      "text": "سه ماه رو میدم."
    },
    {
      "id": 9,
      "start": 6021.0,
      "end": 6023.0,
      "formatted_start": "01:40:21.000",
      "formatted_end": "01:40:23.000",
      "text": "سه ماه رو میدم."
    },
    {
      "id": 10,
      "start": 6023.0,
      "end": 6025.0,
      "formatted_start": "01:40:23.000",
      "formatted_end": "01:40:25.000",
      "text": "پس من دوز رو کردم سه ماه."
    },
    {
      "id": 11,
      "start": 6025.0,
      "end": 6029.0,
      "formatted_start": "01:40:25.000",
      "formatted_end": "01:40:29.000",
      "text": "۸۰ تا از اون نوشته و ۹۰ تا از این داروخونه میبه درست داره"
    },
    {
      "id": 12,
      "start": 6029.0,
      "end": 6031.0,
      "formatted_start": "01:40:29.000",
      "formatted_end": "01:40:31.000",
      "text": "سه ماه نوشته"
    },
    {
      "id": 13,
      "start": 6031.0,
      "end": 6032.0,
      "formatted_start": "01:40:31.000",
      "formatted_end": "01:40:32.000",
      "text": "اها نرگیر"
    },
    {
      "id": 14,
      "start": 6032.0,
      "end": 6037.0,
      "formatted_start": "01:40:32.000",
      "formatted_end": "01:40:37.000",
      "text": "گفت ۱۴۰ تا دیدر تعبول بیمت چه در حال حسابت آزاد ناسه بخواهد شد"
    },
    {
      "id": 15,
      "start": 6037.0,
      "end": 6040.0,
      "formatted_start": "01:40:37.000",
      "formatted_end": "01:40:40.000",
      "text": "یعنی قراری محدودیت بیرون نخواهد خواهد شد"
    },
    {
      "id": 16,
      "start": 6040.0,
      "end": 6042.0,
      "formatted_start": "01:40:40.000",
      "formatted_end": "01:40:42.000",
      "text": "نمیاز آزاد کنه"
    },
    {
      "id": 17,
      "start": 6042.0,
      "end": 6044.0,
      "formatted_start": "01:40:42.000",
      "formatted_end": "01:40:44.000",
      "text": "اما ۱۴۰ بیمت خواهد شد"
    },
    {
      "id": 18,
      "start": 6044.0,
      "end": 6064.0,
      "formatted_start": "01:40:44.000",
      "formatted_end": "01:41:04.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 6074.0,
      "end": 6104.0,
      "formatted_start": "01:41:14.000",
      "formatted_end": "01:41:44.000",
      "text": "این برنامه باید برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که برداری که بر"
    },
    {
      "id": 20,
      "start": 6104.0,
      "end": 6110.0,
      "formatted_start": "01:41:44.000",
      "formatted_end": "01:41:50.000",
      "text": "باید برنامه نشاندار کنم اگر نشاندار نشاندار کنم"
    },
    {
      "id": 21,
      "start": 6110.0,
      "end": 6116.0,
      "formatted_start": "01:41:50.000",
      "formatted_end": "01:41:56.000",
      "text": "از هم میتونم که آزمایشش آزاد شده ولی من سبت کردم"
    },
    {
      "id": 22,
      "start": 6116.0,
      "end": 6120.0,
      "formatted_start": "01:41:56.000",
      "formatted_end": "01:42:00.000",
      "text": "خوب بسیار من یه نظر مانده شدم"
    },
    {
      "id": 23,
      "start": 6120.0,
      "end": 6125.0,
      "formatted_start": "01:42:00.000",
      "formatted_end": "01:42:05.000",
      "text": "شما فقط توده میدید و خانباتی سبتش کنه"
    },
    {
      "id": 24,
      "start": 6125.0,
      "end": 6128.0,
      "formatted_start": "01:42:05.000",
      "formatted_end": "01:42:08.000",
      "text": "آره آره"
    },
    {
      "id": 25,
      "start": 6128.0,
      "end": 6158.0,
      "formatted_start": "01:42:08.000",
      "formatted_end": "01:42:38.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 26,
      "start": 6158.0,
      "end": 6160.0,
      "formatted_start": "01:42:38.000",
      "formatted_end": "01:42:40.000",
      "text": "باید بیار برم"
    },
    {
      "id": 27,
      "start": 6160.0,
      "end": 6162.0,
      "formatted_start": "01:42:40.000",
      "formatted_end": "01:42:42.000",
      "text": "بنده خود آورده نشسته"
    },
    {
      "id": 28,
      "start": 6162.0,
      "end": 6164.0,
      "formatted_start": "01:42:42.000",
      "formatted_end": "01:42:44.000",
      "text": "هر که نداده کار است بیار بکنی"
    },
    {
      "id": 29,
      "start": 6168.0,
      "end": 6170.0,
      "formatted_start": "01:42:48.000",
      "formatted_end": "01:42:50.000",
      "text": "چند ساله دو تا ترسولی میرم"
    },
    {
      "id": 30,
      "start": 6170.0,
      "end": 6172.0,
      "formatted_start": "01:42:50.000",
      "formatted_end": "01:42:52.000",
      "text": "گنبر"
    },
    {
      "id": 31,
      "start": 6172.0,
      "end": 6174.0,
      "formatted_start": "01:42:52.000",
      "formatted_end": "01:42:54.000",
      "text": "دیابت دارم"
    },
    {
      "id": 32,
      "start": 6174.0,
      "end": 6176.0,
      "formatted_start": "01:42:54.000",
      "formatted_end": "01:42:56.000",
      "text": "کبهه چهار دارم"
    },
    {
      "id": 33,
      "start": 6176.0,
      "end": 6178.0,
      "formatted_start": "01:42:56.000",
      "formatted_end": "01:42:58.000",
      "text": "چند ساله غم داری؟"
    },
    {
      "id": 34,
      "start": 6178.0,
      "end": 6180.0,
      "formatted_start": "01:42:58.000",
      "formatted_end": "01:43:00.000",
      "text": "چند ساله غم داری؟"
    },
    {
      "id": 35,
      "start": 6180.0,
      "end": 6182.0,
      "formatted_start": "01:43:00.000",
      "formatted_end": "01:43:02.000",
      "text": "چون چهار پنج ساله این ترسولی میرم"
    },
    {
      "id": 36,
      "start": 6182.0,
      "end": 6184.0,
      "formatted_start": "01:43:02.000",
      "formatted_end": "01:43:04.000",
      "text": "خب باید الان عوض کردم"
    },
    {
      "id": 37,
      "start": 6184.0,
      "end": 6186.0,
      "formatted_start": "01:43:04.000",
      "formatted_end": "01:43:06.000",
      "text": "چون ازای نه غم نمپاری میاد"
    },
    {
      "id": 38,
      "start": 6186.0,
      "end": 6188.0,
      "formatted_start": "01:43:06.000",
      "formatted_end": "01:43:08.000",
      "text": "چند رو میره همجوری هست"
    },
    {
      "id": 39,
      "start": 6188.0,
      "end": 6190.0,
      "formatted_start": "01:43:08.000",
      "formatted_end": "01:43:10.000",
      "text": "و دوز دارو رو عوض میکنه برای ما"
    },
    {
      "id": 40,
      "start": 6190.0,
      "end": 6192.0,
      "formatted_start": "01:43:10.000",
      "formatted_end": "01:43:12.000",
      "text": "دو ساعتی بعد غذا دیده سو چهار در؟"
    },
    {
      "id": 41,
      "start": 6192.0,
      "end": 6194.0,
      "formatted_start": "01:43:12.000",
      "formatted_end": "01:43:14.000",
      "text": "دارو هم که میفترم هم قابل هستم"
    },
    {
      "id": 42,
      "start": 6194.0,
      "end": 6196.0,
      "formatted_start": "01:43:14.000",
      "formatted_end": "01:43:16.000",
      "text": "سماهر چنده؟"
    },
    {
      "id": 43,
      "start": 6196.0,
      "end": 6198.0,
      "formatted_start": "01:43:16.000",
      "formatted_end": "01:43:18.000",
      "text": "کمی سماهر نگهردی؟"
    },
    {
      "id": 44,
      "start": 6198.0,
      "end": 6200.0,
      "formatted_start": "01:43:18.000",
      "formatted_end": "01:43:20.000",
      "text": "چه راسته؟"
    },
    {
      "id": 45,
      "start": 6200.0,
      "end": 6202.0,
      "formatted_start": "01:43:20.000",
      "formatted_end": "01:43:22.000",
      "text": "پیونسی؟"
    },
    {
      "id": 46,
      "start": 6202.0,
      "end": 6204.0,
      "formatted_start": "01:43:22.000",
      "formatted_end": "01:43:24.000",
      "text": "کدر؟"
    },
    {
      "id": 47,
      "start": 6204.0,
      "end": 6206.0,
      "formatted_start": "01:43:24.000",
      "formatted_end": "01:43:26.000",
      "text": "پیونسی"
    },
    {
      "id": 48,
      "start": 6206.0,
      "end": 6208.0,
      "formatted_start": "01:43:26.000",
      "formatted_end": "01:43:28.000",
      "text": "این را توی این قبلی رو باید پیدا کنم"
    },
    {
      "id": 49,
      "start": 6208.0,
      "end": 6210.0,
      "formatted_start": "01:43:28.000",
      "formatted_end": "01:43:30.000",
      "text": "این را توی این قبلی رو باید پیدا کنم"
    },
    {
      "id": 50,
      "start": 6210.0,
      "end": 6212.0,
      "formatted_start": "01:43:30.000",
      "formatted_end": "01:43:32.000",
      "text": "این را توی این قبلی رو باید پیدا کنم"
    },
    {
      "id": 51,
      "start": 6212.0,
      "end": 6214.0,
      "formatted_start": "01:43:32.000",
      "formatted_end": "01:43:34.000",
      "text": "این بوده برج پنجه"
    },
    {
      "id": 52,
      "start": 6214.0,
      "end": 6216.0,
      "formatted_start": "01:43:34.000",
      "formatted_end": "01:43:36.000",
      "text": "نه پشت همانه برج یه مایان"
    },
    {
      "id": 53,
      "start": 6216.0,
      "end": 6218.0,
      "formatted_start": "01:43:36.000",
      "formatted_end": "01:43:38.000",
      "text": "برج سه"
    },
    {
      "id": 54,
      "start": 6218.0,
      "end": 6220.0,
      "formatted_start": "01:43:38.000",
      "formatted_end": "01:43:40.000",
      "text": "خیلی فراموش"
    },
    {
      "id": 55,
      "start": 6220.0,
      "end": 6222.0,
      "formatted_start": "01:43:40.000",
      "formatted_end": "01:43:42.000",
      "text": "اینجا دویست و دو بوده ناشتار"
    },
    {
      "id": 56,
      "start": 6222.0,
      "end": 6224.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:44.000",
      "text": "سماحت شیش و هشت بوده"
    },
    {
      "id": 57,
      "start": 6224.0,
      "end": 6226.0,
      "formatted_start": "01:43:44.000",
      "formatted_end": "01:43:46.000",
      "text": "سماحت پایین بد نیست"
    },
    {
      "id": 58,
      "start": 6226.0,
      "end": 6228.0,
      "formatted_start": "01:43:46.000",
      "formatted_end": "01:43:48.000",
      "text": "شما یه همونه تو افتادن داری"
    },
    {
      "id": 59,
      "start": 6228.0,
      "end": 6230.0,
      "formatted_start": "01:43:48.000",
      "formatted_end": "01:43:50.000",
      "text": "یه وقت دایی از روز"
    },
    {
      "id": 60,
      "start": 6230.0,
      "end": 6232.0,
      "formatted_start": "01:43:50.000",
      "formatted_end": "01:43:52.000",
      "text": "یه تایی از روز قدرت میافته"
    },
    {
      "id": 61,
      "start": 6232.0,
      "end": 6234.0,
      "formatted_start": "01:43:52.000",
      "formatted_end": "01:43:54.000",
      "text": "درسته؟ کراتینه چرا برای رفته؟"
    },
    {
      "id": 62,
      "start": 6234.0,
      "end": 6236.0,
      "formatted_start": "01:43:54.000",
      "formatted_end": "01:43:56.000",
      "text": "این بالا بود"
    },
    {
      "id": 63,
      "start": 6236.0,
      "end": 6238.0,
      "formatted_start": "01:43:56.000",
      "formatted_end": "01:43:58.000",
      "text": "اینو میدونی چه اینو شخصی دادم"
    },
    {
      "id": 64,
      "start": 6238.0,
      "end": 6240.0,
      "formatted_start": "01:43:58.000",
      "formatted_end": "01:44:00.000",
      "text": "اینو بیمارستان تنمیشت"
    },
    {
      "id": 65,
      "start": 6240.0,
      "end": 6242.0,
      "formatted_start": "01:44:00.000",
      "formatted_end": "01:44:02.000",
      "text": "بله، کراتینت خیلی مهم هست"
    },
    {
      "id": 66,
      "start": 6242.0,
      "end": 6244.0,
      "formatted_start": "01:44:02.000",
      "formatted_end": "01:44:04.000",
      "text": "بله، بازهای نه، کراتین هم"
    },
    {
      "id": 67,
      "start": 6244.0,
      "end": 6246.0,
      "formatted_start": "01:44:04.000",
      "formatted_end": "01:44:06.000",
      "text": "آه"
    },
    {
      "id": 68,
      "start": 6246.0,
      "end": 6248.0,
      "formatted_start": "01:44:06.000",
      "formatted_end": "01:44:08.000",
      "text": "عملکرد پولی هست، یا هشت در صد، خیلی عملکرد هست"
    },
    {
      "id": 69,
      "start": 6248.0,
      "end": 6250.0,
      "formatted_start": "01:44:08.000",
      "formatted_end": "01:44:10.000",
      "text": "از تو بازو مجبور به این بزن، آله داره"
    },
    {
      "id": 70,
      "start": 6250.0,
      "end": 6252.0,
      "formatted_start": "01:44:10.000",
      "formatted_end": "01:44:12.000",
      "text": "آه، خیلی مهم هست"
    },
    {
      "id": 71,
      "start": 6252.0,
      "end": 6254.0,
      "formatted_start": "01:44:12.000",
      "formatted_end": "01:44:14.000",
      "text": "اون دوارستانی، بابت همین اجتماعی داده"
    },
    {
      "id": 72,
      "start": 6254.0,
      "end": 6256.0,
      "formatted_start": "01:44:14.000",
      "formatted_end": "01:44:16.000",
      "text": "اون دوارستانی خب، رو توی یکم خط باده"
    },
    {
      "id": 73,
      "start": 6256.0,
      "end": 6258.0,
      "formatted_start": "01:44:16.000",
      "formatted_end": "01:44:18.000",
      "text": "بله، باید میگو شمسی دیگر هم"
    },
    {
      "id": 74,
      "start": 6258.0,
      "end": 6260.0,
      "formatted_start": "01:44:18.000",
      "formatted_end": "01:44:20.000",
      "text": "بله، میگو شمسی دیگر هم"
    },
    {
      "id": 75,
      "start": 6260.0,
      "end": 6262.0,
      "formatted_start": "01:44:20.000",
      "formatted_end": "01:44:22.000",
      "text": "بله، باید میگو شمسی دیگر هم"
    },
    {
      "id": 76,
      "start": 6262.0,
      "end": 6264.0,
      "formatted_start": "01:44:22.000",
      "formatted_end": "01:44:24.000",
      "text": "باید باید داریم؟"
    },
    {
      "id": 77,
      "start": 6264.0,
      "end": 6266.0,
      "formatted_start": "01:44:24.000",
      "formatted_end": "01:44:26.000",
      "text": "بله مصبتیم. بچه هم آنکول کنیم."
    },
    {
      "id": 78,
      "start": 6266.0,
      "end": 6268.0,
      "formatted_start": "01:44:26.000",
      "formatted_end": "01:44:28.000",
      "text": "آره بچه هم آنکول کنیم."
    },
    {
      "id": 79,
      "start": 6268.0,
      "end": 6270.0,
      "formatted_start": "01:44:28.000",
      "formatted_end": "01:44:30.000",
      "text": "اون هم آنکول کنیم."
    },
    {
      "id": 80,
      "start": 6270.0,
      "end": 6275.0,
      "formatted_start": "01:44:30.000",
      "formatted_end": "01:44:35.000",
      "text": "آره. اون موقعی که تا دزدواج کردم اونو ازش کنم."
    },
    {
      "id": 81,
      "start": 6275.0,
      "end": 6279.0,
      "formatted_start": "01:44:35.000",
      "formatted_end": "01:44:39.000",
      "text": "بعد هم آقا واسه شد. همه کاری داریم."
    },
    {
      "id": 82,
      "start": 6279.0,
      "end": 6281.0,
      "formatted_start": "01:44:39.000",
      "formatted_end": "01:44:41.000",
      "text": "بله مصبتیم."
    },
    {
      "id": 83,
      "start": 6281.0,
      "end": 6283.0,
      "formatted_start": "01:44:41.000",
      "formatted_end": "01:44:43.000",
      "text": "خوبی هست."
    },
    {
      "id": 84,
      "start": 6283.0,
      "end": 6285.0,
      "formatted_start": "01:44:43.000",
      "formatted_end": "01:44:45.000",
      "text": "گوشت بزرگ کنیم."
    },
    {
      "id": 85,
