      "text": "یک دیروز من خانواده ترسیدامون فرق خدا فقط فرق."
    },
    {
      "id": 2,
      "start": 12915.0,
      "end": 12945.0,
      "formatted_start": "03:35:15.000",
      "formatted_end": "03:35:45.000",
      "text": "از اینجا باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه برداری"
    },
    {
      "id": 3,
      "start": 12945.0,
      "end": 12947.0,
      "formatted_start": "03:35:45.000",
      "formatted_end": "03:35:47.000",
      "text": "این بر ازماشگاهه؟"
    },
    {
      "id": 4,
      "start": 12947.0,
      "end": 12949.0,
      "formatted_start": "03:35:47.000",
      "formatted_end": "03:35:49.000",
      "text": "نه، ازماش نمیخوادیم"
    },
    {
      "id": 5,
      "start": 12949.0,
      "end": 12951.0,
      "formatted_start": "03:35:49.000",
      "formatted_end": "03:35:51.000",
      "text": "تو با همین با فرمی که براش دارن"
    },
    {
      "id": 6,
      "start": 12951.0,
      "end": 12953.0,
      "formatted_start": "03:35:51.000",
      "formatted_end": "03:35:53.000",
      "text": "آیراجیت مرا بگیره؟"
    },
    {
      "id": 7,
      "start": 12953.0,
      "end": 12955.0,
      "formatted_start": "03:35:53.000",
      "formatted_end": "03:35:55.000",
      "text": "نه، داره بیمه سن و من"
    },
    {
      "id": 8,
      "start": 12955.0,
      "end": 12957.0,
      "formatted_start": "03:35:55.000",
      "formatted_end": "03:35:57.000",
      "text": "با فرمو بیار که من کود را کنیم"
    },
    {
      "id": 9,
      "start": 12957.0,
      "end": 12959.0,
      "formatted_start": "03:35:57.000",
      "formatted_end": "03:35:59.000",
      "text": "این باشه، اینجا باید توش پر باشیم"
    },
    {
      "id": 10,
      "start": 12959.0,
      "end": 12961.0,
      "formatted_start": "03:35:59.000",
      "formatted_end": "03:36:01.000",
      "text": "حالا من میدونم"
    },
    {
      "id": 11,
      "start": 12961.0,
      "end": 12963.0,
      "formatted_start": "03:36:01.000",
      "formatted_end": "03:36:03.000",
      "text": "من اینو بگیرم"
    },
    {
      "id": 12,
      "start": 12963.0,
      "end": 12965.0,
      "formatted_start": "03:36:03.000",
      "formatted_end": "03:36:05.000",
      "text": "ده تا یه باشه اینو خودت بر بزنی"
    },
    {
      "id": 13,
      "start": 12965.0,
      "end": 12967.0,
      "formatted_start": "03:36:05.000",
      "formatted_end": "03:36:07.000",
      "text": "نه، نه بزنیم"
    },
    {
      "id": 14,
      "start": 12967.0,
      "end": 12969.0,
      "formatted_start": "03:36:07.000",
      "formatted_end": "03:36:09.000",
      "text": "درگاه چه خود ما داریم؟"
    },
    {
      "id": 15,
      "start": 12969.0,
      "end": 12971.0,
      "formatted_start": "03:36:09.000",
      "formatted_end": "03:36:11.000",
      "text": "از اینجوری باید برداریم"
    },
    {
      "id": 16,
      "start": 12971.0,
      "end": 12973.0,
      "formatted_start": "03:36:11.000",
      "formatted_end": "03:36:13.000",
      "text": "نه از اینجوری باید دنیا داشته باشیم"
    },
    {
      "id": 17,
      "start": 12973.0,
      "end": 12975.0,
      "formatted_start": "03:36:13.000",
      "formatted_end": "03:36:15.000",
      "text": "یا خود چقدر این مدی خود رو برداریم"
    },
    {
      "id": 18,
      "start": 12975.0,
      "end": 12977.0,
      "formatted_start": "03:36:15.000",
      "formatted_end": "03:36:17.000",
      "text": "بعد یک پیر هست"
    },
    {
      "id": 19,
      "start": 12977.0,
      "end": 12979.0,
      "formatted_start": "03:36:17.000",
      "formatted_end": "03:36:19.000",
      "text": "سلام دستون در"
    },
    {
      "id": 20,
      "start": 12979.0,
      "end": 12981.0,
      "formatted_start": "03:36:19.000",
      "formatted_end": "03:36:21.000",
      "text": "سلام های خوشتان"
    },
    {
      "id": 21,
      "start": 12981.0,
      "end": 12983.0,
      "formatted_start": "03:36:21.000",
      "formatted_end": "03:36:23.000",
      "text": "در تو وزرچان"
    },
    {
      "id": 22,
      "start": 12983.0,
      "end": 12985.0,
      "formatted_start": "03:36:23.000",
      "formatted_end": "03:36:25.000",
      "text": "باکیمو دوپر با ساهر رومتی"
    },
    {
      "id": 23,
      "start": 12985.0,
      "end": 12987.0,
      "formatted_start": "03:36:25.000",
      "formatted_end": "03:36:27.000",
      "text": "در درمان"
    },
    {
      "id": 24,
      "start": 12987.0,
      "end": 12989.0,
      "formatted_start": "03:36:27.000",
      "formatted_end": "03:36:29.000",
      "text": "و دارو"
    },
    {
      "id": 25,
      "start": 12989.0,
      "end": 12991.0,
      "formatted_start": "03:36:29.000",
      "formatted_end": "03:36:31.000",
      "text": "جدیدن پاهم"
    },
    {
      "id": 26,
      "start": 12991.0,
      "end": 12993.0,
      "formatted_start": "03:36:31.000",
      "formatted_end": "03:36:33.000",
      "text": "کبود میشه"
    },
    {
      "id": 27,
      "start": 12993.0,
      "end": 12995.0,
      "formatted_start": "03:36:33.000",
      "formatted_end": "03:36:35.000",
      "text": "دستان یا پاهم کبود میشه"
    },
    {
      "id": 28,
      "start": 12995.0,
      "end": 12997.0,
      "formatted_start": "03:36:35.000",
      "formatted_end": "03:36:37.000",
      "text": "بیشتر تو پاهم هست"
    },
    {
      "id": 29,
      "start": 12997.0,
      "end": 13001.0,
      "formatted_start": "03:36:37.000",
      "formatted_end": "03:36:41.000",
      "text": "چه سنی بودن؟"
    },
    {
      "id": 30,
      "start": 13001.0,
      "end": 13008.0,
      "formatted_start": "03:36:41.000",
      "formatted_end": "03:36:48.000",
      "text": "یکی سه ماهه، فقط قبل سه ماهه رسیده سخت شده"
    },
    {
      "id": 31,
      "start": 13008.0,
      "end": 13011.0,
      "formatted_start": "03:36:48.000",
      "formatted_end": "03:36:51.000",
      "text": "داری رومانتیس؟ چی داری میخوری؟"
    },
    {
      "id": 32,
      "start": 13011.0,
      "end": 13012.0,
      "formatted_start": "03:36:51.000",
      "formatted_end": "03:36:52.000",
      "text": "نه"
    },
    {
      "id": 33,
      "start": 13016.0,
      "end": 13018.0,
      "formatted_start": "03:36:56.000",
      "formatted_end": "03:36:58.000",
      "text": "بچه داری؟"
    },
    {
      "id": 34,
      "start": 13018.0,
      "end": 13019.0,
      "formatted_start": "03:36:58.000",
      "formatted_end": "03:36:59.000",
      "text": "آره دوتو بیری"
    },
    {
      "id": 35,
      "start": 13019.0,
      "end": 13022.0,
      "formatted_start": "03:36:59.000",
      "formatted_end": "03:37:02.000",
      "text": "داری؟ آره؟ خواهشم که آمده بشه"
    },
    {
      "id": 36,
      "start": 13022.0,
      "end": 13023.0,
      "formatted_start": "03:37:02.000",
      "formatted_end": "03:37:03.000",
      "text": "نمیخوایم آمده بشم؟"
    },
    {
      "id": 37,
      "start": 13023.0,
      "end": 13024.0,
      "formatted_start": "03:37:03.000",
      "formatted_end": "03:37:04.000",
      "text": "نمیخوایشم"
    },
    {
      "id": 38,
      "start": 13024.0,
      "end": 13026.0,
      "formatted_start": "03:37:04.000",
      "formatted_end": "03:37:06.000",
      "text": "خدا من کنم"
    },
    {
      "id": 39,
      "start": 13026.0,
      "end": 13028.0,
      "formatted_start": "03:37:06.000",
      "formatted_end": "03:37:08.000",
      "text": "خدا من کنم این چند رو ببین"
    },
    {
      "id": 40,
      "start": 13028.0,
      "end": 13030.0,
      "formatted_start": "03:37:08.000",
      "formatted_end": "03:37:10.000",
      "text": "خدا من کنم بلی"
    },
    {
      "id": 41,
      "start": 13030.0,
      "end": 13032.0,
      "formatted_start": "03:37:10.000",
      "formatted_end": "03:37:12.000",
      "text": "دیگه خامل هم نشید چون"
    },
    {
      "id": 42,
      "start": 13032.0,
      "end": 13034.0,
      "formatted_start": "03:37:12.000",
      "formatted_end": "03:37:14.000",
      "text": "ریماریتی آت میکنه"
    },
    {
      "id": 43,
      "start": 13034.0,
      "end": 13036.0,
      "formatted_start": "03:37:14.000",
      "formatted_end": "03:37:16.000",
      "text": "نه نمیشم"
    },
    {
      "id": 44,
      "start": 13036.0,
      "end": 13038.0,
      "formatted_start": "03:37:16.000",
      "formatted_end": "03:37:18.000",
      "text": "یه دختر یه بسر دارم که چیکنه"
    },
    {
      "id": 45,
      "start": 13038.0,
      "end": 13042.0,
      "formatted_start": "03:37:18.000",
      "formatted_end": "03:37:22.000",
      "text": "اونها باید برکوز هم داشته داشتن"
    },
    {
      "id": 46,
      "start": 13042.0,
      "end": 13044.0,
      "formatted_start": "03:37:22.000",
      "formatted_end": "03:37:24.000",
      "text": "آره برکوز هم دارم"
    },
    {
      "id": 47,
      "start": 13044.0,
      "end": 13046.0,
      "formatted_start": "03:37:24.000",
      "formatted_end": "03:37:26.000",
      "text": "برکوز هم باز داره دونه ما سویزی هر را"
    },
    {
      "id": 48,
      "start": 13046.0,
      "end": 13048.0,
      "formatted_start": "03:37:26.000",
      "formatted_end": "03:37:28.000",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 13048.0,
      "end": 13052.0,
      "formatted_start": "03:37:28.000",
      "formatted_end": "03:37:32.000",
      "text": "به تو ازشو شکر کردی چون برکوزتا باید برکوز داره"
    },
    {
      "id": 50,
      "start": 13052.0,
      "end": 13054.0,
      "formatted_start": "03:37:32.000",
      "formatted_end": "03:37:34.000",
      "text": "خانم درسته باید نظر اتارت باشه"
    },
    {
      "id": 51,
      "start": 13054.0,
      "end": 13056.0,
      "formatted_start": "03:37:34.000",
      "formatted_end": "03:37:36.000",
      "text": "دفعه پرداریم"
    },
    {
      "id": 52,
      "start": 13056.0,
      "end": 13069.0,
      "formatted_start": "03:37:36.000",
      "formatted_end": "03:37:49.000",
      "text": "خانم درکا ستیغی گفتن که دو تا از چیزای روماتیسمت مصبت شده که یکیش بخواهم روماتیسمت بود یکیش هم مفاصل بود"
    },
    {
      "id": 53,
      "start": 13069.0,
      "end": 13071.0,
      "formatted_start": "03:37:49.000",
      "formatted_end": "03:37:51.000",
      "text": "روماتیسمت بود این اقصد"
    },
    {
      "id": 54,
      "start": 13071.0,
      "end": 13073.0,
      "formatted_start": "03:37:51.000",
      "formatted_end": "03:37:53.000",
      "text": "بهش میگم روماتیسمت"
    },
    {
      "id": 55,
      "start": 13073.0,
      "end": 13075.0,
      "formatted_start": "03:37:53.000",
      "formatted_end": "03:37:55.000",
      "text": "روماتیسمت بزار به روماتیسمت بشه روماتیسمت"
    },
    {
      "id": 56,
      "start": 13075.0,
      "end": 13078.0,
      "formatted_start": "03:37:55.000",
      "formatted_end": "03:37:58.000",
      "text": "دو تا روماتیسمت هم سرمان داره"
    },
    {
      "id": 57,
      "start": 13078.0,
      "end": 13084.0,
      "formatted_start": "03:37:58.000",
      "formatted_end": "03:38:04.000",
      "text": "این کبودیوی کپان برای ما چیزی؟"
    },
    {
      "id": 58,
      "start": 13084.0,
      "end": 13088.0,
      "formatted_start": "03:38:04.000",
      "formatted_end": "03:38:08.000",
      "text": "الان وقت آره، خیلی اقتضا"
    },
    {
      "id": 59,
      "start": 13088.0,
      "end": 13093.0,
      "formatted_start": "03:38:08.000",
      "formatted_end": "03:38:13.000",
      "text": "دارم به سنگان آنزیبوس که بود بیت سنگان ها باشید"
    },
    {
      "id": 60,
      "start": 13093.0,
      "end": 13098.0,
      "formatted_start": "03:38:13.000",
      "formatted_end": "03:38:18.000",
      "text": "تو سنگان هر چیزهای آقای فضا افشان گفتن"
    },
    {
      "id": 61,
      "start": 13098.0,
      "end": 13101.0,
      "formatted_start": "03:38:18.000",
      "formatted_end": "03:38:21.000",
      "text": "سنگان دور ازشون سکته که نداشته نه؟"
    },
    {
      "id": 62,
      "start": 13101.0,
      "end": 13102.0,
      "formatted_start": "03:38:21.000",
      "formatted_end": "03:38:22.000",
      "text": "نه"
    },
    {
      "id": 63,
      "start": 13102.0,
      "end": 13107.0,
      "formatted_start": "03:38:22.000",
      "formatted_end": "03:38:27.000",
      "text": "ولی حرف تی نوار قلب هم مشکل باشه"
    },
    {
      "id": 64,
      "start": 13107.0,
      "end": 13112.0,
      "formatted_start": "03:38:27.000",
      "formatted_end": "03:38:32.000",
      "text": "تو چند تا نوار مشکل داری؟"
    },
    {
      "id": 65,
      "start": 13112.0,
      "end": 13115.0,
      "formatted_start": "03:38:32.000",
      "formatted_end": "03:38:35.000",
      "text": "چند تا دادم همه همون بود"
    },
    {
      "id": 66,
      "start": 13115.0,
      "end": 13119.0,
      "formatted_start": "03:38:35.000",
      "formatted_end": "03:38:39.000",
      "text": "نه تو همون نواره باید ببینیم کجا هاش مختلف"
    },
    {
      "id": 67,
      "start": 13119.0,
      "end": 13123.0,
      "formatted_start": "03:38:39.000",
      "formatted_end": "03:38:43.000",
      "text": "خاندوتو فقط به کلسیوم داده"
    },
    {
      "id": 68,
      "start": 13123.0,
      "end": 13125.0,
      "formatted_start": "03:38:43.000",
      "formatted_end": "03:38:45.000",
      "text": "ایپلیت نیزولون داده"
    },
    {
      "id": 69,
      "start": 13125.0,
      "end": 13129.0,
      "formatted_start": "03:38:45.000",
      "formatted_end": "03:38:49.000",
      "text": "برای هر دوتا یعنی به دوتا بسیار نمی کنی"
    },
    {
      "id": 70,
      "start": 13129.0,
      "end": 13132.0,
      "formatted_start": "03:38:49.000",
      "formatted_end": "03:38:52.000",
      "text": "بیدکتر کلوکی همون کلوک داره"
    },
    {
      "id": 71,
      "start": 13132.0,
      "end": 13134.0,
      "formatted_start": "03:38:52.000",
      "formatted_end": "03:38:54.000",
      "text": "قضیه چقدر میکنی؟"
    },
    {
      "id": 72,
      "start": 13134.0,
      "end": 13136.0,
      "formatted_start": "03:38:54.000",
      "formatted_end": "03:38:56.000",
      "text": "روز هر دفعه بسیار سیده"
    },
    {
      "id": 73,
      "start": 13136.0,
      "end": 13137.0,
      "formatted_start": "03:38:56.000",
      "formatted_end": "03:38:57.000",
      "text": "قضیه؟"
    },
    {
      "id": 74,
      "start": 13137.6,
      "end": 13140.5,
      "formatted_start": "03:38:57.600",
      "formatted_end": "03:39:00.500",
      "text": "نمیدونم چون کنشتا ستا جامعه ستا"
    },
    {
      "id": 75,
      "start": 13141.76,
      "end": 13144.24,
      "formatted_start": "03:39:01.760",
      "formatted_end": "03:39:04.240",
      "text": "این از روز دقیقه"
    },
    {
      "id": 76,
      "start": 13144.24,
      "end": 13146.24,
      "formatted_start": "03:39:04.240",
      "formatted_end": "03:39:06.240",
      "text": "چند وقت بیماری؟ چرا شده؟"
    },
    {
      "id": 77,
      "start": 13146.24,
      "end": 13148.4,
      "formatted_start": "03:39:06.240",
      "formatted_end": "03:39:08.400",
      "text": "من تقریبا دو ماه دارم دارست"
    },
    {
      "id": 78,
      "start": 13148.4,
      "end": 13150.76,
      "formatted_start": "03:39:08.400",
      "formatted_end": "03:39:10.760",
      "text": "آمده تازه بیماری چرا شده؟"
    },
    {
      "id": 79,
      "start": 13151.8,
      "end": 13154.4,
      "formatted_start": "03:39:11.800",
      "formatted_end": "03:39:14.400",
      "text": "بعد یه اضرار خیلی مهمه"
    },
    {
      "id": 80,
      "start": 13154.4,
      "end": 13157.4,
      "formatted_start": "03:39:14.400",
      "formatted_end": "03:39:17.400",
      "text": "تو برای خاندکتر این آزمایش همین ها رو بردی"
    },
    {
      "id": 81,
      "start": 13157.4,
      "end": 13158.2,
      "formatted_start": "03:39:17.400",
      "formatted_end": "03:39:18.200",
      "text": "آره"
    },
    {
      "id": 82,
      "start": 13158.2,
      "end": 13160.6,
      "formatted_start": "03:39:18.200",
      "formatted_end": "03:39:20.600",
      "text": "یه آزمایش اضرار حتما باید داشته باشه"
    },
    {
      "id": 83,
      "start": 13160.6,
      "end": 13164.0,
      "formatted_start": "03:39:20.600",
      "formatted_end": "03:39:24.000",
      "text": "ببینیم روحوست روی اضرار ترتیب نزداشته باشه"
    },
    {
      "id": 84,
      "start": 13164.0,
      "end": 13166.0,
      "formatted_start": "03:39:24.000",
      "formatted_end": "03:39:26.000",
      "text": "نمیشه آزما شه ادرال نداری خیلی نمیشه"
    },
    {
      "id": 85,
      "start": 13166.0,
      "end": 13170.0,
      "formatted_start": "03:39:26.000",
      "formatted_end": "03:39:30.000",
      "text": "من الان اینو نوشته بود ادرالشون که ندارم اترامه"
    },
    {
      "id": 86,
      "start": 13170.0,
      "end": 13176.0,
      "formatted_start": "03:39:30.000",
      "formatted_end": "03:39:36.000",
      "text": "ادرالت خیلی مهمه باب چون کچایی درست درگیر میکنه و من منو ندارم"
    },
    {
      "id": 87,
      "start": 13176.0,
      "end": 13178.0,
      "formatted_start": "03:39:36.000",
      "formatted_end": "03:39:38.000",
      "text": "اینو میشه کدوم ادرال نداری"
    },
    {
      "id": 88,
      "start": 13181.0,
      "end": 13188.0,
      "formatted_start": "03:39:41.000",
      "formatted_end": "03:39:48.000",
      "text": "بعد من آقای روکتر بفرستن که از این باید برم همون گرگان یا بیام اینجا"
    },
    {
      "id": 89,
      "start": 13188.0,
      "end": 13189.0,
      "formatted_start": "03:39:48.000",
      "formatted_end": "03:39:49.000",
      "text": "چطور دوست داری؟"
    },
    {
      "id": 90,
      "start": 13189.0,
      "end": 13195.0,
      "formatted_start": "03:39:49.000",
      "formatted_end": "03:39:55.000",
      "text": "اگر راحت زدن، راحت اینجا گردن و همه اینجا گرد گردن"
    },
    {
      "id": 91,
      "start": 13195.0,
      "end": 13197.0,
      "formatted_start": "03:39:55.000",
      "formatted_end": "03:39:57.000",
      "text": "راحت نیست، سخت است و بیایید"
    },
    {
      "id": 92,
      "start": 13197.0,
      "end": 13200.0,
      "formatted_start": "03:39:57.000",
      "formatted_end": "03:40:00.000",
      "text": "من جایید که کفتم"
    }
  ],
  "status": "completed"
}