  "stt_segments": [
    {
      "id": 0,
      "start": 18600.0,
      "end": 18603.0,
      "formatted_start": "05:10:00.000",
      "formatted_end": "05:10:03.000",
      "text": "خاطر شریط،"
    },
    {
      "id": 1,
      "start": 18630.0,
      "end": 18635.0,
      "formatted_start": "05:10:30.000",
      "formatted_end": "05:10:35.000",
      "text": "بچه ها، منم بگو تو تا یکم رو نمیدیم"
    },
    {
      "id": 2,
      "start": 18635.0,
      "end": 18638.0,
      "formatted_start": "05:10:35.000",
      "formatted_end": "05:10:38.000",
      "text": "سلام، بسا نمیشیم"
    },
    {
      "id": 3,
      "start": 18638.0,
      "end": 18643.0,
      "formatted_start": "05:10:38.000",
      "formatted_end": "05:10:43.000",
      "text": "خویر بخش، بگم که این آساس الادیش، آساس بیزه خود"
    },
    {
      "id": 4,
      "start": 18643.0,
      "end": 18648.0,
      "formatted_start": "05:10:43.000",
      "formatted_end": "05:10:48.000",
      "text": "بزنم ند آقای شکلون میرد، عرضش کن من براش آساکس میزنم"
    },
    {
      "id": 5,
      "start": 18648.0,
      "end": 18651.0,
      "formatted_start": "05:10:48.000",
      "formatted_end": "05:10:51.000",
      "text": "باشه منش سوی خود بزنم"
    },
    {
      "id": 6,
      "start": 18651.0,
      "end": 18681.0,
      "formatted_start": "05:10:51.000",
      "formatted_end": "05:11:21.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که ا"
    },
    {
      "id": 7,
      "start": 18681.0,
      "end": 18683.0,
      "formatted_start": "05:11:21.000",
      "formatted_end": "05:11:23.000",
      "text": "بخواهی که مرز بیاد داخل"
    },
    {
      "id": 8,
      "start": 18683.0,
      "end": 18685.0,
      "formatted_start": "05:11:23.000",
      "formatted_end": "05:11:25.000",
      "text": "بفهمه"
    },
    {
      "id": 9,
      "start": 18685.0,
      "end": 18687.0,
      "formatted_start": "05:11:25.000",
      "formatted_end": "05:11:27.000",
      "text": "ببین با امو رو روش کرده"
    },
    {
      "id": 10,
      "start": 18687.0,
      "end": 18689.0,
      "formatted_start": "05:11:27.000",
      "formatted_end": "05:11:29.000",
      "text": "سلام فالویتون خوبید؟"
    },
    {
      "id": 11,
      "start": 18689.0,
      "end": 18691.0,
      "formatted_start": "05:11:29.000",
      "formatted_end": "05:11:31.000",
      "text": "سلامت بشین"
    },
    {
      "id": 12,
      "start": 18691.0,
      "end": 18693.0,
      "formatted_start": "05:11:31.000",
      "formatted_end": "05:11:33.000",
      "text": "شوهرم که پاش شالپا بود"
    },
    {
      "id": 13,
      "start": 18693.0,
      "end": 18695.0,
      "formatted_start": "05:11:33.000",
      "formatted_end": "05:11:35.000",
      "text": "ماه قبلم آمده بودیم"
    },
    {
      "id": 14,
      "start": 18695.0,
      "end": 18697.0,
      "formatted_start": "05:11:35.000",
      "formatted_end": "05:11:37.000",
      "text": "که تکرار شد"
    },
    {
      "id": 15,
      "start": 18697.0,
      "end": 18699.0,
      "formatted_start": "05:11:37.000",
      "formatted_end": "05:11:39.000",
      "text": "دو راز ماه شالپا رو تکرار کردیم"
    },
    {
      "id": 16,
      "start": 18699.0,
      "end": 18701.0,
      "formatted_start": "05:11:39.000",
      "formatted_end": "05:11:41.000",
      "text": "بعد"
    },
    {
      "id": 17,
      "start": 18701.0,
      "end": 18703.0,
      "formatted_start": "05:11:41.000",
      "formatted_end": "05:11:43.000",
      "text": "خواست فکر کنم"
    },
    {
      "id": 18,
      "start": 18703.0,
      "end": 18705.0,
      "formatted_start": "05:11:43.000",
      "formatted_end": "05:11:45.000",
      "text": "پاش اوپنات کردیم"
    },
    {
      "id": 19,
      "start": 18705.0,
      "end": 18707.0,
      "formatted_start": "05:11:45.000",
      "formatted_end": "05:11:47.000",
      "text": "از اینجا باید باید یک آزمایش بده"
    },
    {
      "id": 20,
      "start": 18707.0,
      "end": 18709.0,
      "formatted_start": "05:11:47.000",
      "formatted_end": "05:11:49.000",
      "text": "اگر اون فونت داشت باید باید آزمایش ویدیو بیده بیده"
    },
    {
      "id": 21,
      "start": 18709.0,
      "end": 18711.0,
      "formatted_start": "05:11:49.000",
      "formatted_end": "05:11:51.000",
      "text": "باید بیده چی؟ این اصلا انداری باید بشه"
    },
    {
      "id": 22,
      "start": 18711.0,
      "end": 18713.0,
      "formatted_start": "05:11:51.000",
      "formatted_end": "05:11:53.000",
      "text": "اگر استخوان درگه بشه باید قطع بشه"
    },
    {
      "id": 23,
      "start": 18713.0,
      "end": 18715.0,
      "formatted_start": "05:11:53.000",
      "formatted_end": "05:11:55.000",
      "text": "ببینم یک دفعه بستریش کنم"
    },
    {
      "id": 24,
      "start": 18715.0,
      "end": 18717.0,
      "formatted_start": "05:11:55.000",
      "formatted_end": "05:11:57.000",
      "text": "اونجا هم کار میکنن کنن"
    },
    {
      "id": 25,
      "start": 18717.0,
      "end": 18719.0,
      "formatted_start": "05:11:57.000",
      "formatted_end": "05:11:59.000",
      "text": "خداونده که خسته شدن از خرش کردن"
    },
    {
      "id": 26,
      "start": 18719.0,
      "end": 18721.0,
      "formatted_start": "05:11:59.000",
      "formatted_end": "05:12:01.000",
      "text": "آره، میدونی چی؟"
    },
    {
      "id": 27,
      "start": 18721.0,
      "end": 18723.0,
      "formatted_start": "05:12:01.000",
      "formatted_end": "05:12:03.000",
      "text": "ماشین این موبینا ها هی علاقه چست بگیره"
    },
    {
      "id": 28,
      "start": 18723.0,
      "end": 18730.0,
      "formatted_start": "05:12:03.000",
      "formatted_end": "05:12:10.000",
      "text": "بگم یک دفعه بستریش کنم، اونجا هم کار میکنن کنم، خداونده که خسته شدن از خرچ کردن"
    },
    {
      "id": 29,
      "start": 18730.0,
      "end": 18739.0,
      "formatted_start": "05:12:10.000",
      "formatted_end": "05:12:19.000",
      "text": "آره، میدونید چه یه ماشین، یه نوبینا ها، حدا که چست بگیردن، اما برزا رو بردن، میدونم متاسفم"
    },
    {
      "id": 30,
      "start": 18739.0,
      "end": 18741.0,
      "formatted_start": "05:12:19.000",
      "formatted_end": "05:12:21.000",
      "text": "چند انقدری رازماش دادی؟"
    },
    {
      "id": 31,
      "start": 18741.0,
      "end": 18746.0,
      "formatted_start": "05:12:21.000",
      "formatted_end": "05:12:26.000",
      "text": "سه هفته شد، چهار هفته شد، ربطیم بستریش کردیم بعد از اون که از پیش شما رفتیم"
    },
    {
      "id": 32,
      "start": 18746.0,
      "end": 18747.0,
      "formatted_start": "05:12:26.000",
      "formatted_end": "05:12:27.000",
      "text": "که بستریش کرد، پجار؟"
    },
    {
      "id": 33,
      "start": 18747.0,
      "end": 18751.0,
      "formatted_start": "05:12:27.000",
      "formatted_end": "05:12:31.000",
      "text": "اونجا دکتر تباستولی اوجانسی بودم و خواهد همونم بیا"
    },
    {
      "id": 34,
      "start": 18751.0,
      "end": 18754.0,
      "formatted_start": "05:12:31.000",
      "formatted_end": "05:12:34.000",
      "text": "اونجا دکتر تباستولی شیفت بود و اون بستریش کرد"
    },
    {
      "id": 35,
      "start": 18754.0,
      "end": 18756.0,
      "formatted_start": "05:12:34.000",
      "formatted_end": "05:12:36.000",
      "text": "چند هفته بستری بود؟"
    },
    {
      "id": 36,
      "start": 18756.0,
      "end": 18757.0,
      "formatted_start": "05:12:36.000",
      "formatted_end": "05:12:37.000",
      "text": "سه شب"
    },
    {
      "id": 37,
      "start": 18757.0,
      "end": 18760.0,
      "formatted_start": "05:12:37.000",
      "formatted_end": "05:12:40.000",
      "text": "ملزتو باید دو هفته بستری باشی"
    },
    {
      "id": 38,
      "start": 18760.0,
      "end": 18763.0,
      "formatted_start": "05:12:40.000",
      "formatted_end": "05:12:43.000",
      "text": "خب"
    },
    {
      "id": 39,
      "start": 18763.0,
      "end": 18768.0,
      "formatted_start": "05:12:43.000",
      "formatted_end": "05:12:48.000",
      "text": "در امروی بشه اگه ترمیل رای استخانش دقیقه باشه باش خواهد بشی"
    },
    {
      "id": 40,
      "start": 18768.0,
      "end": 18774.0,
      "formatted_start": "05:12:48.000",
      "formatted_end": "05:12:54.000",
      "text": "دیگه اگه از یه جا تمام بشه"
    },
    {
      "id": 41,
      "start": 18774.0,
      "end": 18780.0,
      "formatted_start": "05:12:54.000",
      "formatted_end": "05:13:00.000",
      "text": "اینجا بسیار خوب بشه. قطع بشه به خدا راحت تری. میتونی؟ قطع بشه نگه راحت تری."
    },
    {
      "id": 42,
      "start": 18780.0,
      "end": 18782.0,
      "formatted_start": "05:13:00.000",
      "formatted_end": "05:13:02.000",
      "text": "این منتون چیه؟"
    },
    {
      "id": 43,
      "start": 18782.0,
      "end": 18784.0,
      "formatted_start": "05:13:02.000",
      "formatted_end": "05:13:04.000",
      "text": "ترمیشت ماری."
    },
    {
      "id": 44,
      "start": 18784.0,
      "end": 18789.0,
      "formatted_start": "05:13:04.000",
      "formatted_end": "05:13:09.000",
      "text": "ببین من بستریت میکنم. یه روز درمیان اونو بیشتر نمیتونم اینجا بیان وزیدت بکنم."
    },
    {
      "id": 45,
      "start": 18789.0,
      "end": 18792.0,
      "formatted_start": "05:13:09.000",
      "formatted_end": "05:13:12.000",
      "text": "اینجا که نه. نمیدونم ترمیشت ماری."
    },
    {
      "id": 46,
      "start": 18792.0,
      "end": 18794.0,
      "formatted_start": "05:13:12.000",
      "formatted_end": "05:13:14.000",
      "text": "ترمیان ده هفته مریض داریم."
    },
    {
      "id": 47,
      "start": 18794.0,
      "end": 18796.0,
      "formatted_start": "05:13:14.000",
      "formatted_end": "05:13:16.000",
      "text": "اینجا بیان وزیدت بکنم. اینجا که نه. نمیدونم ترمیشت ماری."
    },
    {
      "id": 48,
      "start": 18796.0,
      "end": 18800.0,
      "formatted_start": "05:13:16.000",
      "formatted_end": "05:13:20.000",
      "text": "من اینجا بسترش کنیم و اینجا میرونم اینجا چکنم؟"
    },
    {
      "id": 49,
      "start": 18800.0,
      "end": 18802.0,
      "formatted_start": "05:13:20.000",
      "formatted_end": "05:13:22.000",
      "text": "خود بیمارستان را بگیرم کنم"
    },
    {
      "id": 50,
      "start": 18802.0,
      "end": 18804.0,
      "formatted_start": "05:13:22.000",
      "formatted_end": "05:13:24.000",
      "text": "خوب باشیم"
    },
    {
      "id": 51,
      "start": 18804.0,
      "end": 18808.0,
      "formatted_start": "05:13:24.000",
      "formatted_end": "05:13:28.000",
      "text": "چون حقیقتش من اینجا اینجا مریض نمی آمید ببینم"
    },
    {
      "id": 52,
      "start": 18808.0,
      "end": 18812.0,
      "formatted_start": "05:13:28.000",
      "formatted_end": "05:13:32.000",
      "text": "چون از این واقعیتش من در حالت این نوع هست و من باعثی ندارم"
    },
    {
      "id": 53,
      "start": 18812.0,
      "end": 18813.0,
      "formatted_start": "05:13:32.000",
      "formatted_end": "05:13:33.000",
      "text": "خب؟"
    },
    {
      "id": 54,
      "start": 18813.0,
      "end": 18814.0,
      "formatted_start": "05:13:33.000",
      "formatted_end": "05:13:34.000",
      "text": "چه چه؟"
    },
    {
      "id": 55,
      "start": 18814.0,
      "end": 18816.0,
      "formatted_start": "05:13:34.000",
      "formatted_end": "05:13:36.000",
      "text": "این واسه همین اصلا من کلن خصوصی بسترم"
    },
    {
      "id": 56,
      "start": 18816.0,
      "end": 18819.0,
      "formatted_start": "05:13:36.000",
      "formatted_end": "05:13:39.000",
      "text": "خب خصوصی بخواد دو هفته بایشه مثلا بسکیت"
    },
    {
      "id": 57,
      "start": 18819.0,
      "end": 18822.0,
      "formatted_start": "05:13:39.000",
      "formatted_end": "05:13:42.000",
      "text": "دو هفته شب دوازده هم میریم بسترش ببینم"
    },
    {
      "id": 58,
      "start": 18826.0,
      "end": 18842.0,
      "formatted_start": "05:13:46.000",
      "formatted_end": "05:14:02.000",
      "text": "درمانش دو هفته است. بهترین حالت میشه. کتابی هست دو هفته الان بیست و یک روز."
    },
    {
      "id": 59,
      "start": 18842.0,
      "end": 18850.0,
      "formatted_start": "05:14:02.000",
      "formatted_end": "05:14:10.000",
      "text": "و من چون میدونم دفع قبلش آنتیبیتیکی قوی دادم. جواب نداد. دیگه میشه قادره."
    },
    {
      "id": 60,
      "start": 18850.0,
      "end": 18852.0,
      "formatted_start": "05:14:10.000",
      "formatted_end": "05:14:12.000",
      "text": "اگه مثلا قطبش اینا همینجا قطب می کنه"
    },
    {
      "id": 61,
      "start": 18853.0,
      "end": 18856.0,
      "formatted_start": "05:14:13.000",
      "formatted_end": "05:14:16.000",
      "text": "دیگه دکتر ارتبط داره دیگه ببینم چی می کنه"
    },
    {
      "id": 62,
      "start": 18857.0,
      "end": 18861.0,
      "formatted_start": "05:14:17.000",
      "formatted_end": "05:14:21.000",
      "text": "می دونی قطع اندام یه چوری این می دازه با اون اون می دازه با این"
    },
    {
      "id": 63,
      "start": 18862.0,
      "end": 18865.0,
      "formatted_start": "05:14:22.000",
      "formatted_end": "05:14:25.000",
      "text": "اصلا چون کار سخته و درامت نداره"
    },
    {
      "id": 64,
      "start": 18866.0,
      "end": 18869.0,
      "formatted_start": "05:14:26.000",
      "formatted_end": "05:14:29.000",
      "text": "و مثلا دکتر ورونزیش وقتمش نمی گیره که بخواد انجام بگیره"
    },
    {
      "id": 65,
      "start": 18870.0,
      "end": 18871.0,
      "formatted_start": "05:14:30.000",
      "formatted_end": "05:14:31.000",
      "text": "اگه همین کار"
    },
    {
      "id": 66,
      "start": 18873.0,
      "end": 18876.0,
      "formatted_start": "05:14:33.000",
      "formatted_end": "05:14:36.000",
      "text": "دیگه تفلک خودشم خستی شده بگیره"
    },
    {
      "id": 67,
      "start": 18876.0,
      "end": 18877.0,
      "formatted_start": "05:14:36.000",
      "formatted_end": "05:14:37.000",
      "text": "خیلی سخته"
    },
    {
      "id": 68,
      "start": 18880.0,
      "end": 18886.26,
      "formatted_start": "05:14:40.000",
      "formatted_end": "05:14:46.260",
      "text": "من خطا این که میگه تزرگی دارو دیشت من بهش دادم مادر تزرگیه"
    },
    {
      "id": 69,
      "start": 18886.26,
      "end": 18889.4,
      "formatted_start": "05:14:46.260",
      "formatted_end": "05:14:49.400",
      "text": "وقتی رو این مریض میاد ایسار سر"
    },
    {
      "id": 70,
      "start": 18889.4,
      "end": 18892.42,
      "formatted_start": "05:14:49.400",
      "formatted_end": "05:14:52.420",
      "text": "یعنی که دیگه هیچ کار دیگه برای مریض نمیشه کن"
    },
    {
      "id": 71,
      "start": 18892.42,
      "end": 18894.98,
      "formatted_start": "05:14:52.420",
      "formatted_end": "05:14:54.980",
      "text": "من الانم برای اوتوپت مشابه رو میذارم"
    },
    {
      "id": 72,
      "start": 18894.98,
      "end": 18898.44,
      "formatted_start": "05:14:54.980",
      "formatted_end": "05:14:58.440",
      "text": "میگم اما این علا رقم این که دارو داره اینجوری گرفته"
    },
    {
      "id": 73,
      "start": 18898.44,
      "end": 18899.88,
      "formatted_start": "05:14:58.440",
      "formatted_end": "05:14:59.880",
      "text": "ایسار پایین نیامده"
    }
  ],
  "status": "completed"
}