  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15330.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:30.000",
      "text": "اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینجا، اینج"
    },
    {
      "id": 1,
      "start": 15330.0,
      "end": 15335.0,
      "formatted_start": "04:15:30.000",
      "formatted_end": "04:15:35.000",
      "text": "این کارش اینه که موردگاه مغز رو باز میکنه"
    },
    {
      "id": 2,
      "start": 15335.0,
      "end": 15339.0,
      "formatted_start": "04:15:35.000",
      "formatted_end": "04:15:39.000",
      "text": "خارجیه یه داروی خارجیه موردگاه مغز رو باز میکنه"
    },
    {
      "id": 3,
      "start": 15339.0,
      "end": 15341.0,
      "formatted_start": "04:15:39.000",
      "formatted_end": "04:15:41.000",
      "text": "و بر میگردن"
    },
    {
      "id": 4,
      "start": 15341.0,
      "end": 15344.0,
      "formatted_start": "04:15:41.000",
      "formatted_end": "04:15:44.000",
      "text": "این دیخواب تو زمین اون دفعه رو یه بار آوردنم پیشت"
    },
    {
      "id": 5,
      "start": 15344.0,
      "end": 15346.0,
      "formatted_start": "04:15:44.000",
      "formatted_end": "04:15:46.000",
      "text": "گفتم از توی ویر آفتار داشت چیشم بزرگ"
    },
    {
      "id": 6,
      "start": 15346.0,
      "end": 15348.0,
      "formatted_start": "04:15:46.000",
      "formatted_end": "04:15:48.000",
      "text": "یه بار دیدم گوشم جرم شد خدایا"
    },
    {
      "id": 7,
      "start": 15348.0,
      "end": 15350.0,
      "formatted_start": "04:15:48.000",
      "formatted_end": "04:15:50.000",
      "text": "تلون رفتیش دیدم از گوشم خون آمد"
    },
    {
      "id": 8,
      "start": 15350.0,
      "end": 15352.0,
      "formatted_start": "04:15:50.000",
      "formatted_end": "04:15:52.000",
      "text": "تشهار زده باید بلا"
    },
    {
      "id": 9,
      "start": 15352.0,
      "end": 15354.0,
      "formatted_start": "04:15:52.000",
      "formatted_end": "04:15:54.000",
      "text": "ولی از گوش زده بود بیرون"
    },
    {
      "id": 10,
      "start": 15354.0,
      "end": 15356.0,
      "formatted_start": "04:15:54.000",
      "formatted_end": "04:15:56.000",
      "text": "این رو که سرش رابط میکرد دیگه"
    },
    {
      "id": 11,
      "start": 15356.0,
      "end": 15358.0,
      "formatted_start": "04:15:56.000",
      "formatted_end": "04:15:58.000",
      "text": "خب، دو ماه داری داره آجی"
    },
    {
      "id": 12,
      "start": 15358.0,
      "end": 15360.0,
      "formatted_start": "04:15:58.000",
      "formatted_end": "04:16:00.000",
      "text": "مرتبش بدی"
    },
    {
      "id": 13,
      "start": 15360.0,
      "end": 15362.0,
      "formatted_start": "04:16:00.000",
      "formatted_end": "04:16:02.000",
      "text": "باش"
    },
    {
      "id": 14,
      "start": 15362.0,
      "end": 15364.0,
      "formatted_start": "04:16:02.000",
      "formatted_end": "04:16:04.000",
      "text": "سر زمین بره دو روز مامانه"
    },
    {
      "id": 15,
      "start": 15364.0,
      "end": 15366.0,
      "formatted_start": "04:16:04.000",
      "formatted_end": "04:16:06.000",
      "text": "الان تو ما یک دفتر زیاده مریم"
    },
    {
      "id": 16,
      "start": 15366.0,
      "end": 15368.0,
      "formatted_start": "04:16:06.000",
      "formatted_end": "04:16:08.000",
      "text": "مریم پیشش موجود هستیم"
    },
    {
      "id": 17,
      "start": 15368.0,
      "end": 15370.0,
      "formatted_start": "04:16:08.000",
      "formatted_end": "04:16:10.000",
      "text": "خب دو بره جمع کنیم"
    },
    {
      "id": 18,
      "start": 15370.0,
      "end": 15372.0,
      "formatted_start": "04:16:10.000",
      "formatted_end": "04:16:12.000",
      "text": "تو دو برش زرف بوتی بذار"
    },
    {
      "id": 19,
      "start": 15372.0,
      "end": 15374.0,
      "formatted_start": "04:16:12.000",
      "formatted_end": "04:16:14.000",
      "text": "این بوتی برسای صاف برسای شب میکشی"
    },
    {
      "id": 20,
      "start": 15374.0,
      "end": 15376.0,
      "formatted_start": "04:16:14.000",
      "formatted_end": "04:16:16.000",
      "text": "خب نه بر تناب بذاره شیر"
    },
    {
      "id": 21,
      "start": 15376.0,
      "end": 15378.0,
      "formatted_start": "04:16:16.000",
      "formatted_end": "04:16:18.000",
      "text": "بره خوردن ایلا یادش میکنی"
    },
    {
      "id": 22,
      "start": 15378.0,
      "end": 15380.0,
      "formatted_start": "04:16:18.000",
      "formatted_end": "04:16:20.000",
      "text": "بره شب زنگ بزنی"
    },
    {
      "id": 23,
      "start": 15380.0,
      "end": 15382.0,
      "formatted_start": "04:16:20.000",
      "formatted_end": "04:16:22.000",
      "text": "اینجا باید بخواهیم با تفضیل خوصات را بخواهیم"
    },
    {
      "id": 24,
      "start": 15382.0,
      "end": 15384.0,
      "formatted_start": "04:16:22.000",
      "formatted_end": "04:16:24.000",
      "text": "آره، من گرمشون"
    },
    {
      "id": 25,
      "start": 15384.0,
      "end": 15386.0,
      "formatted_start": "04:16:24.000",
      "formatted_end": "04:16:26.000",
      "text": "در اینجا درد می دهیم، در اینجا باید بخواهیم"
    },
    {
      "id": 26,
      "start": 15386.0,
      "end": 15388.0,
      "formatted_start": "04:16:26.000",
      "formatted_end": "04:16:28.000",
      "text": "در اینجا باید بخواهیم"
    },
    {
      "id": 27,
      "start": 15388.0,
      "end": 15390.0,
      "formatted_start": "04:16:28.000",
      "formatted_end": "04:16:30.000",
      "text": "درست من درد می کنم"
    },
    {
      "id": 28,
      "start": 15390.0,
      "end": 15392.0,
      "formatted_start": "04:16:30.000",
      "formatted_end": "04:16:32.000",
      "text": "حاجیت نباید تنها بذاری"
    },
    {
      "id": 29,
      "start": 15392.0,
      "end": 15394.0,
      "formatted_start": "04:16:32.000",
      "formatted_end": "04:16:34.000",
      "text": "نه، تنها بذاری"
    },
    {
      "id": 30,
      "start": 15394.0,
      "end": 15396.0,
      "formatted_start": "04:16:34.000",
      "formatted_end": "04:16:36.000",
      "text": "سلامت بذاریم"
    },
    {
      "id": 31,
      "start": 15396.0,
      "end": 15398.0,
      "formatted_start": "04:16:36.000",
      "formatted_end": "04:16:38.000",
      "text": "داروی را شده که بالا که ندارم"
    },
    {
      "id": 32,
      "start": 15398.0,
      "end": 15400.0,
      "formatted_start": "04:16:38.000",
      "formatted_end": "04:16:40.000",
      "text": "چرا؟"
    },
    {
      "id": 33,
      "start": 15400.0,
      "end": 15402.0,
      "formatted_start": "04:16:40.000",
      "formatted_end": "04:16:42.000",
      "text": "آسانسور داره"
    },
    {
      "id": 34,
      "start": 15402.0,
      "end": 15404.0,
      "formatted_start": "04:16:42.000",
      "formatted_end": "04:16:44.000",
      "text": "چرا باید درد می کنی؟"
    },
    {
      "id": 35,
      "start": 15404.0,
      "end": 15406.0,
      "formatted_start": "04:16:44.000",
      "formatted_end": "04:16:46.000",
      "text": "باید بگیرم بیا"
    },
    {
      "id": 36,
      "start": 15434.0,
      "end": 15464.0,
      "formatted_start": "04:17:14.000",
      "formatted_end": "04:17:44.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 37,
      "start": 15464.0,
      "end": 15470.0,
      "formatted_start": "04:17:44.000",
      "formatted_end": "04:17:50.000",
      "text": "در پنجام فیلی قرص و مدنی زیبایی برمی دارم که بخورم"
    },
    {
      "id": 38,
      "start": 15470.0,
      "end": 15473.0,
      "formatted_start": "04:17:50.000",
      "formatted_end": "04:17:53.000",
      "text": "بعد بخورم این مداروک رو شما میبخونیم"
    },
    {
      "id": 39,
      "start": 15473.0,
      "end": 15476.0,
      "formatted_start": "04:17:53.000",
      "formatted_end": "04:17:56.000",
      "text": "بعد میبخونم که زرد میخونم"
    },
    {
      "id": 40,
      "start": 15476.0,
      "end": 15478.0,
      "formatted_start": "04:17:56.000",
      "formatted_end": "04:17:58.000",
      "text": "این رو شما میبخونیم"
    },
    {
      "id": 41,
      "start": 15478.0,
      "end": 15481.0,
      "formatted_start": "04:17:58.000",
      "formatted_end": "04:18:01.000",
      "text": "آخرین سو منو"
    },
    {
      "id": 42,
      "start": 15481.0,
      "end": 15511.0,
      "formatted_start": "04:18:01.000",
      "formatted_end": "04:18:31.000",
      "text": "مردم از خانه از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا برداشت که از اینجا ب"
    },
    {
      "id": 43,
      "start": 15511.0,
      "end": 15513.44,
      "formatted_start": "04:18:31.000",
      "formatted_end": "04:18:33.440",
      "text": "عباد رحمت شده ته هستند"
    },
    {
      "id": 44,
      "start": 15513.44,
      "end": 15515.24,
      "formatted_start": "04:18:33.440",
      "formatted_end": "04:18:35.240",
      "text": "چند سال دارید؟"
    },
    {
      "id": 45,
      "start": 15515.24,
      "end": 15517.24,
      "formatted_start": "04:18:35.240",
      "formatted_end": "04:18:37.240",
      "text": "چهلا پنج، چهار تا بار داری داشتیم"
    },
    {
      "id": 46,
      "start": 15517.24,
      "end": 15519.24,
      "formatted_start": "04:18:37.240",
      "formatted_end": "04:18:39.240",
      "text": "مادر که یاسته شده؟"
    },
    {
      "id": 47,
      "start": 15519.24,
      "end": 15522.24,
      "formatted_start": "04:18:39.240",
      "formatted_end": "04:18:42.240",
      "text": "مامانم همه مدود دارید، زیر ۵۰ بود"
    },
    {
      "id": 48,
      "start": 15522.24,
      "end": 15523.24,
      "formatted_start": "04:18:42.240",
      "formatted_end": "04:18:43.240",
      "text": "خوهر نداری؟"
    },
    {
      "id": 49,
      "start": 15523.24,
      "end": 15525.24,
      "formatted_start": "04:18:43.240",
      "formatted_end": "04:18:45.240",
      "text": "بزرگترم"
    },
    {
      "id": 50,
      "start": 15525.24,
      "end": 15530.24,
      "formatted_start": "04:18:45.240",
      "formatted_end": "04:18:50.240",
      "text": "ببین اکی بدونیم همین مدود میگید، شب کنید کچیک"
    },
    {
      "id": 51,
      "start": 15530.24,
      "end": 15532.24,
      "formatted_start": "04:18:50.240",
      "formatted_end": "04:18:52.240",
      "text": "چون یاسته باشید تمام میشه دیگه"
    },
    {
      "id": 52,
      "start": 15532.24,
      "end": 15534.24,
      "formatted_start": "04:18:52.240",
      "formatted_end": "04:18:54.240",
      "text": "ببینم کچیک میشه"
    },
    {
      "id": 53,
      "start": 15534.24,
      "end": 15538.24,
      "formatted_start": "04:18:54.240",
      "formatted_end": "04:18:58.240",
      "text": "بعد خوندی هر دو عادت چقدر چند وقت نبابه داشتی استفاده میکنید؟"
    },
    {
      "id": 54,
      "start": 15538.24,
      "end": 15544.24,
      "formatted_start": "04:18:58.240",
      "formatted_end": "04:19:04.240",
      "text": "زیاد بود این دفعه قبلی که ترنسید رو با میوکنمی که خوردم یک سبم شد من با من"
    },
    {
      "id": 55,
      "start": 15544.24,
      "end": 15550.24,
      "formatted_start": "04:19:04.240",
      "formatted_end": "04:19:10.240",
      "text": "یعنی شد مثلا اون دوست درانزه سیزت تا دونی کلی نرد که خونی شد"
    },
    {
      "id": 56,
      "start": 15550.24,
      "end": 15553.24,
      "formatted_start": "04:19:10.240",
      "formatted_end": "04:19:13.240",
      "text": "شما فشار خون، چربی خون؟"
    },
    {
      "id": 57,
      "start": 15553.24,
      "end": 15555.24,
      "formatted_start": "04:19:13.240",
      "formatted_end": "04:19:15.240",
      "text": "نه شده ندارم"
    },
    {
      "id": 58,
      "start": 15555.24,
      "end": 15559.24,
      "formatted_start": "04:19:15.240",
      "formatted_end": "04:19:19.240",
      "text": "خانمادتونش که صابست یک دقیقا مغزه نداره با دم و درتون؟"
    },
    {
      "id": 59,
      "start": 15559.24,
      "end": 15560.24,
      "formatted_start": "04:19:19.240",
      "formatted_end": "04:19:20.240",
      "text": "نه"
    },
    {
      "id": 60,
      "start": 15560.24,
      "end": 15565.24,
      "formatted_start": "04:19:20.240",
      "formatted_end": "04:19:25.240",
      "text": "چون میدون ترنسید رو با افتنام بکن و پرس جرگی رو هم میخوردی نه؟"
    },
    {
      "id": 61,
      "start": 15565.24,
      "end": 15570.2,
      "formatted_start": "04:19:25.240",
      "formatted_end": "04:19:30.200",
      "text": "نه، ارسال جانوگی تازه، الان یه دوره شما داره تموم میشه که چار پنج بدونو بکرن"
    },
    {
      "id": 62,
      "start": 15570.2,
      "end": 15576.0,
      "formatted_start": "04:19:30.200",
      "formatted_end": "04:19:36.000",
      "text": "و دیگه بگیر کن که پریود چیه، بعد ماه بعد یه وسط دیگه داده بکرن که بعد برن سونو بدن، ببینم"
    },
    {
      "id": 63,
      "start": 15576.0,
      "end": 15581.44,
      "formatted_start": "04:19:36.000",
      "formatted_end": "04:19:41.440",
      "text": "همزمان با مفنامی که با ترنسید نه، بعد یه وقت فردی رو بخوری خور"
    },
    {
      "id": 64,
      "start": 15581.44,
      "end": 15582.08,
      "formatted_start": "04:19:41.440",
      "formatted_end": "04:19:42.080",
      "text": "آهان"
    },
    {
      "id": 65,
      "start": 15582.08,
      "end": 15585.76,
      "formatted_start": "04:19:42.080",
      "formatted_end": "04:19:45.760",
      "text": "دوره چون شاید بند روز که سکته مکزی داره، خطرناکه"
    },
    {
      "id": 66,
      "start": 15585.76,
      "end": 15589.26,
      "formatted_start": "04:19:45.760",
      "formatted_end": "04:19:49.260",
      "text": "نه، اون مفنامی گوترینسی دو تا سربان چارون پیرونی میخورم"
    },
    {
      "id": 67,
      "start": 15589.26,
      "end": 15593.0,
      "formatted_start": "04:19:49.260",
      "formatted_end": "04:19:53.000",
      "text": "اون قرص هرمونی که تازه دهمی داده از اون پنجون شده می کنم"
    },
    {
      "id": 68,
      "start": 15593.0,
      "end": 15594.52,
      "formatted_start": "04:19:53.000",
      "formatted_end": "04:19:54.520",
      "text": "دوز قدیزه در این داره"
    },
    {
      "id": 69,
      "start": 15594.52,
      "end": 15597.82,
      "formatted_start": "04:19:54.520",
      "formatted_end": "04:19:57.820",
      "text": "بعد دوز شفیه گفت که باید ده همین داریم"
    },
    {
      "id": 70,
      "start": 15597.82,
      "end": 15599.54,
      "formatted_start": "04:19:57.820",
      "formatted_end": "04:19:59.540",
      "text": "شفیه دوز رو کبرده می کنیم"
    }
  ],
  "status": "completed"
}