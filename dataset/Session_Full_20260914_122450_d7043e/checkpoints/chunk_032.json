      "end": 9634.0,
      "formatted_start": "02:40:30.000",
      "formatted_end": "02:40:34.000",
      "text": "این رقم بیرون از کلیه های تیمانستان"
    },
    {
      "id": 2,
      "start": 9634.0,
      "end": 9636.0,
      "formatted_start": "02:40:34.000",
      "formatted_end": "02:40:36.000",
      "text": "سونوگرافی منو باشم"
    },
    {
      "id": 3,
      "start": 9636.0,
      "end": 9638.0,
      "formatted_start": "02:40:36.000",
      "formatted_end": "02:40:38.000",
      "text": "سنوگرافی باشم"
    },
    {
      "id": 4,
      "start": 9638.0,
      "end": 9640.0,
      "formatted_start": "02:40:38.000",
      "formatted_end": "02:40:40.000",
      "text": "باشم"
    },
    {
      "id": 5,
      "start": 9640.0,
      "end": 9642.0,
      "formatted_start": "02:40:40.000",
      "formatted_end": "02:40:42.000",
      "text": "باشم"
    },
    {
      "id": 6,
      "start": 9642.0,
      "end": 9644.0,
      "formatted_start": "02:40:42.000",
      "formatted_end": "02:40:44.000",
      "text": "سونو تونو نوشتم"
    },
    {
      "id": 7,
      "start": 9644.0,
      "end": 9646.0,
      "formatted_start": "02:40:44.000",
      "formatted_end": "02:40:46.000",
      "text": "آزمایشتو اگه برده اید رفتی سه کن"
    },
    {
      "id": 8,
      "start": 9646.0,
      "end": 9648.0,
      "formatted_start": "02:40:46.000",
      "formatted_end": "02:40:48.000",
      "text": "چون انگار سهمیتون تموم میشه"
    },
    {
      "id": 9,
      "start": 9648.0,
      "end": 9650.0,
      "formatted_start": "02:40:48.000",
      "formatted_end": "02:40:50.000",
      "text": "اوله مردی"
    },
    {
      "id": 10,
      "start": 9650.0,
      "end": 9652.0,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:52.000",
      "text": "سونوگرافیتون الان میزنم"
    },
    {
      "id": 11,
      "start": 9652.0,
      "end": 9654.0,
      "formatted_start": "02:40:52.000",
      "formatted_end": "02:40:54.000",
      "text": "میگه تعیید کرد"
    },
    {
      "id": 12,
      "start": 9654.0,
      "end": 9656.0,
      "formatted_start": "02:40:54.000",
      "formatted_end": "02:40:56.000",
      "text": "یعنی سهمیت شاید تموم باشه"
    },
    {
      "id": 13,
      "start": 9656.0,
      "end": 9658.0,
      "formatted_start": "02:40:56.000",
      "formatted_end": "02:40:58.000",
      "text": "خدا مرسی"
