    },
    {
      "id": 13,
      "start": 9926.0,
      "end": 9928.0,
      "formatted_start": "02:45:26.000",
      "formatted_end": "02:45:28.000",
      "text": "نمونه اینجا."
    },
    {
      "id": 14,
      "start": 9928.0,
      "end": 9930.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:30.000",
      "text": "باید نمی کنه"
    },
    {
      "id": 15,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "بگیر نمیشه گشنم خواهی خواهی"
    },
    {
      "id": 16,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "هده ایستر"
    },
    {
      "id": 17,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "یه روز که میخواهی بینیریم"
    },
    {
      "id": 18,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "انا باید باید چون مرگ هستم"
    },
    {
      "id": 19,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "خدا برکرم"
    },
    {
      "id": 20,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "اما خواهی باید باید کار به دیمارستان و مریضی و این برنامه نکنیم"
    },
    {
      "id": 21,
      "start": 9942.0,
      "end": 9946.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:46.000",
      "text": "خب شبا که موقع خواهی خواهی خواهی خیار اینجور چیزها بخواهی خواهی خواهی"
    },
    {
      "id": 22,
      "start": 9946.0,
      "end": 9950.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:50.000",
      "text": "خب باید این چیزها خودتون سرگم"
    },
    {
      "id": 23,
      "start": 9950.0,
      "end": 9958.16,
      "formatted_start": "02:45:50.000",
      "formatted_end": "02:45:58.160",
      "text": "از اینها چند تا دارم فراموشتون"
    },
    {
      "id": 24,
      "start": 9958.16,
      "end": 9959.88,
      "formatted_start": "02:45:58.160",
      "formatted_end": "02:45:59.880",
      "text": "پنج تا از اینها دارم"
    },
    {
      "id": 25,
      "start": 9959.88,
      "end": 9960.48,
      "formatted_start": "02:45:59.880",
      "formatted_end": "02:46:00.480",
      "text": "پنج ششتا"
    },
    {
      "id": 26,
      "start": 9960.48,
      "end": 9963.18,
      "formatted_start": "02:46:00.480",
      "formatted_end": "02:46:03.180",
      "text": "الان اگه تعیید نکنم میفهمیم"
    },
    {
      "id": 27,
      "start": 9963.18,
      "end": 9964.5,
      "formatted_start": "02:46:03.180",
      "formatted_end": "02:46:04.500",
      "text": "چند؟"
    },
    {
      "id": 28,
      "start": 9964.5,
      "end": 9966.4,
      "formatted_start": "02:46:04.500",
      "formatted_end": "02:46:06.400",
      "text": "یه وقتی تعیید نکنم میفهمیم"
    },
    {
      "id": 29,
      "start": 9966.4,
      "end": 9970.52,
      "formatted_start": "02:46:06.400",
      "formatted_end": "02:46:10.520",
      "text": "الان قرص فشارتونو نیبردین دارید؟"
    },
    {
      "id": 30,
      "start": 9970.52,
      "end": 9971.54,
      "formatted_start": "02:46:10.520",
      "formatted_end": "02:46:11.540",
      "text": "فشار نیبردم"
    },
    {
      "id": 31,
      "start": 9971.54,
      "end": 9973.64,
      "formatted_start": "02:46:11.540",
      "formatted_end": "02:46:13.640",
      "text": "آسپرین بچه و فشار رو نیبردین"
    },
    {
      "id": 32,
      "start": 9973.64,
      "end": 9974.74,
      "formatted_start": "02:46:13.640",
      "formatted_end": "02:46:14.740",
      "text": "آسپرین بچه دارم"
    },
    {
      "id": 33,
      "start": 9974.74,
      "end": 9976.38,
      "formatted_start": "02:46:14.740",
      "formatted_end": "02:46:16.380",
      "text": "فشار هشت رو نیبردین"
    },
    {
      "id": 34,
      "start": 9976.38,
      "end": 9977.42,
      "formatted_start": "02:46:16.380",
      "formatted_end": "02:46:17.420",
      "text": "من تمام کردم"
    },
    {
      "id": 35,
      "start": 9977.42,
      "end": 9983.42,
      "formatted_start": "02:46:17.420",
      "formatted_end": "02:46:23.420",
      "text": "این بار پشار نیست"
    },
    {
      "id": 36,
      "start": 9983.42,
      "end": 9987.42,
      "formatted_start": "02:46:23.420",
      "formatted_end": "02:46:27.420",
      "text": "این چربیه نه برگین میدونم چون من پرونده تون دارم"
    },
    {
      "id": 37,
      "start": 9987.42,
      "end": 9989.42,
      "formatted_start": "02:46:27.420",
      "formatted_end": "02:46:29.420",
      "text": "آره درسته دارم"
    },
    {
      "id": 38,
      "start": 9989.42,
      "end": 9993.42,
      "formatted_start": "02:46:29.420",
      "formatted_end": "02:46:33.420",
      "text": "بار پشار هم گفتیم این بار هشتاده"
    },
    {
      "id": 39,
      "start": 9993.42,
      "end": 9995.42,
      "formatted_start": "02:46:33.420",
      "formatted_end": "02:46:35.420",
      "text": "واسه قندتونم که"
    },
    {
      "id": 40,
      "start": 9995.42,
      "end": 9998.42,
      "formatted_start": "02:46:35.420",
      "formatted_end": "02:46:38.420",
      "text": "قند خواه از این گفتیم مثل"
    },
    {
      "id": 41,
      "start": 9998.42,
      "end": 10000.42,
      "formatted_start": "02:46:38.420",
      "formatted_end": "02:46:40.420",
      "text": "تا الان یکی مو خودم قبلنا نه"
    },
    {
      "id": 42,
      "start": 10000.42,
      "end": 10003.42,
      "formatted_start": "02:46:40.420",
      "formatted_end": "02:46:43.420",
      "text": "که آمدن بود که صبح نصب بشه مو خود"
    },
    {
      "id": 43,
      "start": 10003.42,
      "end": 10005.42,
      "formatted_start": "02:46:43.420",
      "formatted_end": "02:46:45.420",
      "text": "غروب نصب بشه مو خود"
    },
    {
      "id": 44,
      "start": 10005.42,
      "end": 10010.42,
      "formatted_start": "02:46:45.420",
      "formatted_end": "02:46:50.420",
      "text": "اگر دیدید ناشتاتون خیلی بالا رفت شب کامل بخورید برس آهر هم دارید؟"
    },
    {
      "id": 45,
      "start": 10010.42,
      "end": 10011.42,
      "formatted_start": "02:46:50.420",
      "formatted_end": "02:46:51.420",
      "text": "نه"
    },
    {
      "id": 46,
      "start": 10011.42,
      "end": 10014.42,
      "formatted_start": "02:46:51.420",
      "formatted_end": "02:46:54.420",
      "text": "کنسری براتون نمیشه بودم خوشجی برنمسم یا ایرانه؟"
    },
    {
      "id": 47,
      "start": 10014.42,
      "end": 10017.42,
      "formatted_start": "02:46:54.420",
      "formatted_end": "02:46:57.420",
      "text": "همین اردانش رو برنمسم خیلی گرانم"
    },
    {
      "id": 48,
      "start": 10017.42,
      "end": 10018.42,
      "formatted_start": "02:46:57.420",
      "formatted_end": "02:46:58.420",
      "text": "باش"
    },
    {
      "id": 49,
      "start": 10018.42,
      "end": 10019.42,
      "formatted_start": "02:46:58.420",
      "formatted_end": "02:46:59.420",
      "text": "توانم نمیشه بیرم"
    },
    {
      "id": 50,
      "start": 10019.42,
      "end": 10021.42,
      "formatted_start": "02:46:59.420",
      "formatted_end": "02:47:01.420",
      "text": "اینو اگر میگید صبح گروه یکی بخورم"
    },
    {
      "id": 51,
      "start": 10021.42,
      "end": 10025.42,
      "formatted_start": "02:47:01.420",
      "formatted_end": "02:47:05.420",
      "text": "نه صبح کم ها بودید نصف شب گروه و یکی بخورید"
    },
    {
      "id": 52,
      "start": 10025.42,
      "end": 10028.42,
      "formatted_start": "02:47:05.420",
      "formatted_end": "02:47:08.420",
      "text": "چون اگر صد و چل بوده بالا بوده"
    },
    {
      "id": 53,
      "start": 10028.42,
      "end": 10029.42,
      "formatted_start": "02:47:08.420",
      "formatted_end": "02:47:09.420",
      "text": "خب؟"
    },
    {
      "id": 54,
      "start": 10029.42,
      "end": 10030.32,
      "formatted_start": "02:47:09.420",
      "formatted_end": "02:47:10.320",
      "text": "خودتی دارم"
    },
    {
      "id": 55,
      "start": 10030.32,
      "end": 10030.96,
      "formatted_start": "02:47:10.320",
      "formatted_end": "02:47:10.960",
      "text": "خیلی"
    },
    {
      "id": 56,
      "start": 10030.96,
      "end": 10032.68,
      "formatted_start": "02:47:10.960",
      "formatted_end": "02:47:12.680",
      "text": "حالا من میگم"
    },
    {
      "id": 57,
      "start": 10032.68,
      "end": 10033.96,
      "formatted_start": "02:47:12.680",
      "formatted_end": "02:47:13.960",
      "text": "سالینم چی میگه؟"
    },
    {
      "id": 58,
      "start": 10033.96,
      "end": 10034.38,
      "formatted_start": "02:47:13.960",
      "formatted_end": "02:47:14.380",
      "text": "نه جا"
    },
    {
      "id": 59,
      "start": 10034.38,
      "end": 10036.54,
      "formatted_start": "02:47:14.380",
      "formatted_end": "02:47:16.540",
      "text": "سلام جا"
    },
    {
      "id": 60,
      "start": 10036.54,
      "end": 10040.04,
      "formatted_start": "02:47:16.540",
      "formatted_end": "02:47:20.040",
      "text": "سلام"
    },
    {
      "id": 61,
      "start": 10040.04,
      "end": 10041.66,
      "formatted_start": "02:47:20.040",
      "formatted_end": "02:47:21.660",
      "text": "بفرمایی"
    },
    {
      "id": 62,
      "start": 10041.66,
      "end": 10045.18,
      "formatted_start": "02:47:21.660",
      "formatted_end": "02:47:25.180",
      "text": "بفرمایی شما"
    },
    {
      "id": 63,
      "start": 10045.18,
      "end": 10046.22,
      "formatted_start": "02:47:25.180",
      "formatted_end": "02:47:26.220",
      "text": "بفرمایی"
    },
    {
      "id": 64,
      "start": 10046.22,
      "end": 10047.3,
      "formatted_start": "02:47:26.220",
      "formatted_end": "02:47:27.300",
      "text": "مها"
    },
    {
      "id": 65,
      "start": 10047.3,
      "end": 10048.4,
      "formatted_start": "02:47:27.300",
      "formatted_end": "02:47:28.400",
      "text": "بله"
    },
    {
      "id": 66,
      "start": 10048.4,
      "end": 10049.42,
      "formatted_start": "02:47:28.400",
      "formatted_end": "02:47:29.420",
      "text": "مرسی مرمو جا"
    },
    {
      "id": 67,
      "start": 10050.5,
      "end": 10056.36,
      "formatted_start": "02:47:30.500",
      "formatted_end": "02:47:36.360",
      "text": "خب"
    },
    {
      "id": 68,
      "start": 10056.36,
      "end": 10057.44,
      "formatted_start": "02:47:36.360",
      "formatted_end": "02:47:37.440",
      "text": "زحمت میکشین"
    },
    {
      "id": 69,
      "start": 10057.44,
      "end": 10058.66,
      "formatted_start": "02:47:37.440",
      "formatted_end": "02:47:38.660",
      "text": "دستتون برنکنم"
    },
    {
      "id": 70,
      "start": 10058.66,
      "end": 10060.66,
      "formatted_start": "02:47:38.660",
      "formatted_end": "02:47:40.660",
      "text": "باشه چشم"
    },
    {
      "id": 71,
      "start": 10060.66,
      "end": 10064.66,
      "formatted_start": "02:47:40.660",
      "formatted_end": "02:47:44.660",
      "text": "من اینکه احوان هست چشم میگم منتظر باشم"
    },
    {
      "id": 72,
      "start": 10064.66,
      "end": 10066.66,
      "formatted_start": "02:47:44.660",
      "formatted_end": "02:47:46.660",
      "text": "آمده باشم چشم"
    },
    {
      "id": 73,
      "start": 10066.66,
      "end": 10068.66,
      "formatted_start": "02:47:46.660",
      "formatted_end": "02:47:48.660",
      "text": "مرسی مرسی ممنون خدا هست"
    },
    {
      "id": 74,
      "start": 10068.66,
      "end": 10070.66,
      "formatted_start": "02:47:48.660",
      "formatted_end": "02:47:50.660",
      "text": "خدا هست"
    },
    {
      "id": 75,
      "start": 10070.66,
      "end": 10074.66,
      "formatted_start": "02:47:50.660",
      "formatted_end": "02:47:54.660",
      "text": "ببخش اینجا روش ما بینسته که مثل این مال قرنگی"
    },
    {
      "id": 76,
      "start": 10074.66,
      "end": 10076.66,
      "formatted_start": "02:47:54.660",
      "formatted_end": "02:47:56.660",
      "text": "الان بگیر بیار مامان جان"
    },
    {
      "id": 77,
      "start": 10076.66,
      "end": 10078.66,
      "formatted_start": "02:47:56.660",
      "formatted_end": "02:47:58.660",
      "text": "خواهیم شفایی همه رو درست میکنه"
    },
    {
      "id": 78,
      "start": 10078.66,
      "end": 10080.66,
      "formatted_start": "02:47:58.660",
      "formatted_end": "02:48:00.660",
      "text": "باشه"
    },
    {
      "id": 79,
      "start": 10080.66,
      "end": 10084.66,
      "formatted_start": "02:48:00.660",
      "formatted_end": "02:48:04.660",
      "text": "من پشارت هم زدم هیچ کدوم نگفت دارید همه رو تایید کرد"
    },
    {
      "id": 80,
      "start": 10084.66,
      "end": 10086.66,
      "formatted_start": "02:48:04.660",
      "formatted_end": "02:48:06.660",
      "text": "دارو را همه رو تایید کرد"
    },
    {
      "id": 81,
      "start": 10086.66,
      "end": 10116.66,
      "formatted_start": "02:48:06.660",
      "formatted_end": "02:48:36.660",
      "text": "این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که باید بگیرند، این استره هایی که با"
    },
    {
      "id": 82,
      "start": 10116.66,
      "end": 10146.66,
      "formatted_start": "02:48:36.660",
      "formatted_end": "02:49:06.660",
      "text": "از اینجا باید برداشتیم که از اینجا باید برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینجا برداشتیم که از اینج"
    },
    {
      "id": 83,
      "start": 10146.66,
      "end": 10151.14,
      "formatted_start": "02:49:06.660",
      "formatted_end": "02:49:11.140",
      "text": "اینکه قضا رو جزب نمی کنه، چلوی و لا، بعد دفت می کنه از بدنش"
    },
    {
      "id": 84,
      "start": 10151.14,
      "end": 10158.14,
      "formatted_start": "02:49:11.140",
      "formatted_end": "02:49:18.140",
      "text": "آره، گفت مثلا دفت نمی کنه، می گفت سالم بده، از خودشم می گفت نمی ده، از من می کنه"
    },
    {
      "id": 85,
      "start": 10158.14,
      "end": 10164.06,
      "formatted_start": "02:49:18.140",
      "formatted_end": "02:49:24.060",
      "text": "اما التعاب رود بیماری نداره، فقط اختلال و گزب داره، معمولا مدرزازی"
    },
    {
      "id": 86,
      "start": 10164.06,
      "end": 10168.18,
      "formatted_start": "02:49:24.060",
      "formatted_end": "02:49:28.180",
      "text": "بعد مثلا مدفوعش هم خیلی از گردشون کرد"
    },
    {
      "id": 87,
      "start": 10168.18,
      "end": 10169.1,
      "formatted_start": "02:49:28.180",
      "formatted_end": "02:49:29.100",
      "text": "چی می شه؟"
    },
    {
      "id": 88,
      "start": 10169.1,
      "end": 10171.74,
      "formatted_start": "02:49:29.100",
      "formatted_end": "02:49:31.740",
      "text": "می گفت مثلا سیف کار می کنه"
    },
    {
      "id": 89,
      "start": 10171.74,
      "end": 10173.26,
      "formatted_start": "02:49:31.740",
      "formatted_end": "02:49:33.260",
      "text": "خب الان بهتر نشده"
    },
    {
      "id": 90,
      "start": 10173.26,
      "end": 10174.18,
      "formatted_start": "02:49:33.260",
      "formatted_end": "02:49:34.180",
      "text": "دارو ندادی"
    },
    {
      "id": 91,
      "start": 10174.18,
      "end": 10175.58,
      "formatted_start": "02:49:34.180",
      "formatted_end": "02:49:35.580",
      "text": "آه، دارو ندادم"
    },
    {
      "id": 92,
      "start": 10175.58,
      "end": 10176.58,
      "formatted_start": "02:49:35.580",
      "formatted_end": "02:49:36.580",
      "text": "نه دیگه"
    },
    {
      "id": 93,
      "start": 10176.58,
      "end": 10179.58,
      "formatted_start": "02:49:36.580",
      "formatted_end": "02:49:39.580",
      "text": "به من گفته که سرط منش دارن هدود ها"
    },
    {
      "id": 94,
      "start": 10179.58,
      "end": 10181.58,
      "formatted_start": "02:49:39.580",
      "formatted_end": "02:49:41.580",
      "text": "آره دیگه شما فقط"
    },
    {
      "id": 95,
      "start": 10181.58,
      "end": 10183.58,
      "formatted_start": "02:49:41.580",
      "formatted_end": "02:49:43.580",
      "text": "شما الان چهارتا برگر رو نگاه کردین"
    },
    {
      "id": 96,
      "start": 10183.58,
      "end": 10185.58,
      "formatted_start": "02:49:43.580",
      "formatted_end": "02:49:45.580",
      "text": "چهارتا برگر"
    },
    {
      "id": 97,
      "start": 10185.58,
      "end": 10187.58,
      "formatted_start": "02:49:45.580",
      "formatted_end": "02:49:47.580",
      "text": "بعد یکی از اینا خرمز هم بود"
    },
    {
      "id": 98,
      "start": 10189.58,
      "end": 10190.58,
      "formatted_start": "02:49:49.580",
      "formatted_end": "02:49:50.580",
      "text": "چهارتا برگر"
    },
    {
      "id": 99,
      "start": 10190.58,
      "end": 10191.58,
      "formatted_start": "02:49:50.580",
      "formatted_end": "02:49:51.580",
      "text": "مطلع شاش"
    },
    {
      "id": 100,
      "start": 10198.58,
      "end": 10200.58,
      "formatted_start": "02:49:58.580",
      "formatted_end": "02:50:00.580",
      "text": "فقط فکر کنم با سرط منش"
    }
