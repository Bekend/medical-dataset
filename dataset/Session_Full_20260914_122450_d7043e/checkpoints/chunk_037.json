  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11103.24,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:03.240",
      "text": "اون تعداد آرسی اصلا مهم نیست، نیست اصلا."
    },
    {
      "id": 1,
      "start": 11103.24,
      "end": 11112.6,
      "formatted_start": "03:05:03.240",
      "formatted_end": "03:05:12.600",
      "text": "کارسیومش خوبه، فوسفا خوبه، نمکای خونش همه خوبه، روماتیسم نداره، آزمایش ادرالش هم ادرالش رو خونده داشته، ادرالش میسوده دخترم؟"
    },
    {
      "id": 2,
      "start": 11112.6,
      "end": 11113.1,
      "formatted_start": "03:05:12.600",
      "formatted_end": "03:05:13.100",
      "text": "نه."
    },
    {
      "id": 3,
      "start": 11113.1,
      "end": 11117.6,
      "formatted_start": "03:05:13.100",
      "formatted_end": "03:05:17.600",
      "text": "زیرا آزمایش قبلیش به ازا بود پروتین درد میکنه، ها؟"
    },
    {
      "id": 4,
      "start": 11117.6,
      "end": 11119.6,
      "formatted_start": "03:05:17.600",
      "formatted_end": "03:05:19.600",
      "text": "نه، آرسی کلیه و یوچیزه بود."
    },
    {
      "id": 5,
      "start": 11119.6,
      "end": 11121.1,
      "formatted_start": "03:05:19.600",
      "formatted_end": "03:05:21.100",
      "text": "آره بهش داده بود؟"
    },
    {
      "id": 6,
      "start": 11121.1,
      "end": 11123.1,
      "formatted_start": "03:05:21.100",
      "formatted_end": "03:05:23.100",
      "text": "نه اون اکزه هاش خطوه"
    },
    {
      "id": 7,
      "start": 11123.1,
      "end": 11125.1,
      "formatted_start": "03:05:23.100",
      "formatted_end": "03:05:25.100",
      "text": "سه اینجا آزماش کرد"
    },
    {
      "id": 8,
      "start": 11125.1,
      "end": 11127.1,
      "formatted_start": "03:05:25.100",
      "formatted_end": "03:05:27.100",
      "text": "خوشان سپید همه رو میزنه در پروتین"
    },
    {
      "id": 9,
      "start": 11127.1,
      "end": 11129.1,
      "formatted_start": "03:05:27.100",
      "formatted_end": "03:05:29.100",
      "text": "باید خواندکتر ببنیم شاید"
    },
    {
      "id": 10,
      "start": 11129.1,
      "end": 11131.1,
      "formatted_start": "03:05:29.100",
      "formatted_end": "03:05:31.100",
      "text": "این یه هر چند ماه خوندماه رو هم می کنه"
    },
    {
      "id": 11,
      "start": 11131.1,
      "end": 11133.1,
      "formatted_start": "03:05:31.100",
      "formatted_end": "03:05:33.100",
      "text": "چون خواد بگیری شما که من بیشتر بخوادی نرم برم"
    },
    {
      "id": 12,
      "start": 11133.1,
      "end": 11135.1,
      "formatted_start": "03:05:33.100",
      "formatted_end": "03:05:35.100",
      "text": "خوندماه که می کنه بخوادی خشک مخوادشه"
    },
    {
      "id": 13,
      "start": 11135.1,
      "end": 11137.1,
      "formatted_start": "03:05:35.100",
      "formatted_end": "03:05:37.100",
      "text": "بعد عمل هم خوب قطعا باز دستگاری میشه"
    },
    {
      "id": 14,
      "start": 11137.1,
      "end": 11139.1,
      "formatted_start": "03:05:37.100",
      "formatted_end": "03:05:39.100",
      "text": "خشکش بیشتر میشه"
    },
    {
      "id": 15,
      "start": 11139.1,
      "end": 11141.1,
      "formatted_start": "03:05:39.100",
      "formatted_end": "03:05:41.100",
      "text": "آخ اونجا همتون باز هم خوندماه برم"
    },
    {
      "id": 16,
      "start": 11141.1,
      "end": 11171.1,
      "formatted_start": "03:05:41.100",
      "formatted_end": "03:06:11.100",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 17,
      "start": 11171.1,
      "end": 11172.1,
      "formatted_start": "03:06:11.100",
      "formatted_end": "03:06:12.100",
      "text": "از اینجا چی کارش کنی؟"
    },
    {
      "id": 18,
      "start": 11172.1,
      "end": 11177.1,
      "formatted_start": "03:06:12.100",
      "formatted_end": "03:06:17.100",
      "text": "هرموناش خوبه، تختانش خوبه، اونا رو باید نگاه کنیم"
    },
    {
      "id": 19,
      "start": 11177.1,
      "end": 11180.1,
      "formatted_start": "03:06:17.100",
      "formatted_end": "03:06:20.100",
      "text": "چون بدنی آزمایشی داخلیش خوبه"
    },
    {
      "id": 20,
      "start": 11180.1,
      "end": 11182.1,
      "formatted_start": "03:06:20.100",
      "formatted_end": "03:06:22.100",
      "text": "چون این لاغره"
    },
    {
      "id": 21,
      "start": 11182.1,
      "end": 11187.1,
      "formatted_start": "03:06:22.100",
      "formatted_end": "03:06:27.100",
      "text": "اون که لاغره که سواجنشه، بگی آزمایشش مشکل نداره"
    },
    {
      "id": 22,
      "start": 11187.1,
      "end": 11192.1,
      "formatted_start": "03:06:27.100",
      "formatted_end": "03:06:32.100",
      "text": "خود تیروید و اینجور چیزهایی که باعث لاغری میشه، تیرویدشو چکنه کرده؟"
    },
    {
      "id": 23,
      "start": 11192.1,
      "end": 11197.1,
      "formatted_start": "03:06:32.100",
      "formatted_end": "03:06:37.100",
      "text": "نه، تیروید و آزمایش شهربالی با دو گمه آرام نداره"
    },
    {
      "id": 24,
      "start": 11197.1,
      "end": 11199.1,
      "formatted_start": "03:06:37.100",
      "formatted_end": "03:06:39.100",
      "text": "میگم، یه دلیل داشته بس"
    },
    {
      "id": 25,
      "start": 11199.1,
      "end": 11201.64,
      "formatted_start": "03:06:39.100",
      "formatted_end": "03:06:41.640",
      "text": "این آزمایش واسه پیرونتیر هست؟ متاور هست؟"
    },
    {
      "id": 26,
      "start": 11201.64,
      "end": 11205.68,
      "formatted_start": "03:06:41.640",
      "formatted_end": "03:06:45.680",
      "text": "آره، اونجوری نه، خیلی خطا ندارم، ولی چیزهای کوچکی اشتباه دارن"
    },
    {
      "id": 27,
      "start": 11205.68,
      "end": 11208.34,
      "formatted_start": "03:06:45.680",
      "formatted_end": "03:06:48.340",
      "text": "خب و تیرویدت خوب بوده که دکتر چگن میگم چون حسن چه؟"
    },
    {
      "id": 28,
      "start": 11208.34,
      "end": 11210.48,
      "formatted_start": "03:06:48.340",
      "formatted_end": "03:06:50.480",
      "text": "سری قبلی نمیشتم، این سری دیگه نمیشتم"
    },
    {
      "id": 29,
      "start": 11210.48,
      "end": 11215.22,
      "formatted_start": "03:06:50.480",
      "formatted_end": "03:06:55.220",
      "text": "آره، تیروید که رفته نداره، دیگه این چند تا چیز لاغره میدهد، یکی تیرویده"
    },
    {
      "id": 30,
      "start": 11215.22,
      "end": 11218.22,
      "formatted_start": "03:06:55.220",
      "formatted_end": "03:06:58.220",
      "text": "یکی که که کنی که کنی که نداره تیاره داشتن خوب بوده"
    },
    {
      "id": 31,
      "start": 11218.22,
      "end": 11221.22,
      "formatted_start": "03:06:58.220",
      "formatted_end": "03:07:01.220",
      "text": "دیگه یکی سو جن و استرس و"
    },
    {
      "id": 32,
      "start": 11221.22,
      "end": 11223.22,
      "formatted_start": "03:07:01.220",
      "formatted_end": "03:07:03.220",
      "text": "استرس که زیاد داره"
    },
    {
      "id": 33,
      "start": 11223.22,
      "end": 11224.22,
      "formatted_start": "03:07:03.220",
      "formatted_end": "03:07:04.220",
      "text": "شما خواهد خواهد؟"
    },
    {
      "id": 34,
      "start": 11224.22,
      "end": 11226.22,
      "formatted_start": "03:07:04.220",
      "formatted_end": "03:07:06.220",
      "text": "نه تا دیروقت میداره"
    },
    {
      "id": 35,
      "start": 11226.22,
      "end": 11230.22,
      "formatted_start": "03:07:06.220",
      "formatted_end": "03:07:10.220",
      "text": "و دارو یک چیز خورد که چی دارید دکتر بود؟"
    },
    {
      "id": 36,
      "start": 11230.22,
      "end": 11231.22,
      "formatted_start": "03:07:10.220",
      "formatted_end": "03:07:11.220",
      "text": "دارو ولاش؟"
    },
    {
      "id": 37,
      "start": 11231.22,
      "end": 11233.22,
      "formatted_start": "03:07:11.220",
      "formatted_end": "03:07:13.220",
      "text": "به نام نورو رو چی از اون دارا"
    },
    {
      "id": 38,
      "start": 11233.22,
      "end": 11235.22,
      "formatted_start": "03:07:13.220",
      "formatted_end": "03:07:15.220",
      "text": "از همین چیزها داده بود"
    },
    {
      "id": 39,
      "start": 11235.22,
      "end": 11238.22,
      "formatted_start": "03:07:15.220",
      "formatted_end": "03:07:18.220",
      "text": "و یک دونه از این زردوی اطاری است"
    },
    {
      "id": 40,
      "start": 11238.22,
      "end": 11240.22,
      "formatted_start": "03:07:18.220",
      "formatted_end": "03:07:20.220",
      "text": "دارا افزاوردیگی از اون دارا"
    },
    {
      "id": 41,
      "start": 11240.22,
      "end": 11242.22,
      "formatted_start": "03:07:20.220",
      "formatted_end": "03:07:22.220",
      "text": "زردوی"
    },
    {
      "id": 42,
      "start": 11242.22,
      "end": 11243.22,
      "formatted_start": "03:07:22.220",
      "formatted_end": "03:07:23.220",
      "text": "چیلی"
    },
    {
      "id": 43,
      "start": 11243.22,
      "end": 11246.22,
      "formatted_start": "03:07:23.220",
      "formatted_end": "03:07:26.220",
      "text": "نمانده؟ نمانده؟ خوب؟ خوب؟"
    },
    {
      "id": 44,
      "start": 11246.22,
      "end": 11248.22,
      "formatted_start": "03:07:26.220",
      "formatted_end": "03:07:28.220",
      "text": "خوب؟"
    },
    {
      "id": 45,
      "start": 11248.22,
      "end": 11251.22,
      "formatted_start": "03:07:28.220",
      "formatted_end": "03:07:31.220",
      "text": "نمیشه خوب بمون برگردش"
    },
    {
      "id": 46,
      "start": 11251.22,
      "end": 11253.22,
      "formatted_start": "03:07:31.220",
      "formatted_end": "03:07:33.220",
      "text": "بچه پنج دامپو گریجان کنید"
    },
    {
      "id": 47,
      "start": 11253.22,
      "end": 11258.22,
      "formatted_start": "03:07:33.220",
      "formatted_end": "03:07:38.220",
      "text": "بکنید خیلی عصبی خواب دو دو هم استرسش باده هم خواب"
    },
    {
      "id": 48,
      "start": 11258.22,
      "end": 11259.22,
      "formatted_start": "03:07:38.220",
      "formatted_end": "03:07:39.220",
      "text": "عصبی"
    },
    {
      "id": 49,
      "start": 11259.22,
      "end": 11261.22,
      "formatted_start": "03:07:39.220",
      "formatted_end": "03:07:41.220",
      "text": "برگردش خیلی بیاده"
    },
    {
      "id": 50,
      "start": 11261.22,
      "end": 11263.22,
      "formatted_start": "03:07:41.220",
      "formatted_end": "03:07:43.220",
      "text": "پرپراناتو داری میخوایی؟"
    },
    {
      "id": 51,
      "start": 11263.22,
      "end": 11265.22,
      "formatted_start": "03:07:43.220",
      "formatted_end": "03:07:45.220",
      "text": "نه دیگه هم یه ها خوردن"
    },
    {
      "id": 52,
      "start": 11265.22,
      "end": 11267.22,
      "formatted_start": "03:07:45.220",
      "formatted_end": "03:07:47.220",
      "text": "پدیگه نرفتن اونو نروند"
    },
    {
      "id": 53,
      "start": 11267.22,
      "end": 11269.22,
      "formatted_start": "03:07:47.220",
      "formatted_end": "03:07:49.220",
      "text": "پرپراناتو نباید قرد کنید خیلی برگردت باشید"
    },
    {
      "id": 54,
      "start": 11269.22,
      "end": 11271.22,
      "formatted_start": "03:07:49.220",
      "formatted_end": "03:07:51.220",
      "text": "ده یا بیس بکن"
    },
    {
      "id": 55,
      "start": 11271.22,
      "end": 11277.22,
      "formatted_start": "03:07:51.220",
      "formatted_end": "03:07:57.220",
      "text": "نه یه ده کافیه چون اونقدر تون تون تون تون میزن و سخت و ساز بردنش بالا میره دیگه"
    },
    {
      "id": 56,
      "start": 11277.22,
      "end": 11279.22,
      "formatted_start": "03:07:57.220",
      "formatted_end": "03:07:59.220",
      "text": "اونو باید مدام استفاده کنن؟"
    },
    {
      "id": 57,
      "start": 11279.22,
      "end": 11281.22,
      "formatted_start": "03:07:59.220",
      "formatted_end": "03:08:01.220",
      "text": "تا دو سال بخوره و بعد کم کم"
    },
    {
      "id": 58,
      "start": 11281.22,
      "end": 11285.22,
      "formatted_start": "03:08:01.220",
      "formatted_end": "03:08:05.220",
      "text": "یه تا یکم برن درگیر بشه شابل بشه ازدواج کنه"
    },
    {
      "id": 59,
      "start": 11285.22,
      "end": 11291.22,
      "formatted_start": "03:08:05.220",
      "formatted_end": "03:08:11.220",
      "text": "یه جای گیر بشه دیگه تا روزی که گیر نشده این همین داستانه ها داری باز"
    },
    {
      "id": 60,
      "start": 11291.22,
      "end": 11295.22,
      "formatted_start": "03:08:11.220",
      "formatted_end": "03:08:15.220",
      "text": "فلفل قهوه نخور"
    },
    {
      "id": 61,
      "start": 11295.22,
      "end": 11299.22,
      "formatted_start": "03:08:15.220",
      "formatted_end": "03:08:19.220",
      "text": "فلفل قهوه نشابه دلسته"
    },
    {
      "id": 62,
      "start": 11299.22,
      "end": 11300.22,
      "formatted_start": "03:08:19.220",
      "formatted_end": "03:08:20.220",
      "text": "میشه نه؟"
    },
    {
      "id": 63,
      "start": 11300.6,
      "end": 11304.56,
      "formatted_start": "03:08:20.600",
      "formatted_end": "03:08:24.560",
      "text": "نه نخور بعد یه هرموناش رو چک کن با یه سونیگرافی تا خودان بگیری"
    },
    {
      "id": 64,
      "start": 11304.56,
      "end": 11308.16,
      "formatted_start": "03:08:24.560",
      "formatted_end": "03:08:28.160",
      "text": "چند تا لدن یه تا خودانش کم کار یه هرموناش نمیسون"
    },
    {
      "id": 65,
      "start": 11308.16,
      "end": 11309.56,
      "formatted_start": "03:08:28.160",
      "formatted_end": "03:08:29.560",
      "text": "نه کمش برایش بینیسون"
    },
    {
      "id": 66,
      "start": 11310.1,
      "end": 11312.02,
      "formatted_start": "03:08:30.100",
      "formatted_end": "03:08:32.020",
      "text": "یه جل هم مینیم کسان کلینگ دار"
    },
    {
      "id": 67,
      "start": 11312.02,
      "end": 11314.58,
      "formatted_start": "03:08:32.020",
      "formatted_end": "03:08:34.580",
      "text": "اولش که جوشاتو میاده رو برمز میکنن"
    },
    {
      "id": 68,
      "start": 11314.58,
      "end": 11315.86,
      "formatted_start": "03:08:34.580",
      "formatted_end": "03:08:35.860",
      "text": "بعد خوب میشه"
    },
    {
      "id": 69,
      "start": 11315.86,
      "end": 11318.82,
      "formatted_start": "03:08:35.860",
      "formatted_end": "03:08:38.820",
      "text": "اینو مردتا باید بزنید یه اصفت کنید جوش بزنید"
    },
    {
      "id": 70,
      "start": 11318.82,
      "end": 11321.82,
      "formatted_start": "03:08:38.820",
      "formatted_end": "03:08:41.820",
      "text": "بله اون خاندکتونی چی کنه؟ بینیش عمل کنه یا نه؟"
    },
    {
      "id": 71,
      "start": 11321.82,
      "end": 11323.82,
      "formatted_start": "03:08:41.820",
      "formatted_end": "03:08:43.820",
      "text": "این دیگه انتخاب شخصیه"
    },
    {
      "id": 72,
      "start": 11323.82,
      "end": 11325.82,
      "formatted_start": "03:08:43.820",
      "formatted_end": "03:08:45.820",
      "text": "خوندماق چند مار در رفته میشه؟"
    },
    {
      "id": 73,
      "start": 11325.82,
      "end": 11327.82,
      "formatted_start": "03:08:45.820",
      "formatted_end": "03:08:47.820",
      "text": "در رفته نیست هر چند مار"
    },
    {
      "id": 74,
      "start": 11327.82,
      "end": 11328.82,
      "formatted_start": "03:08:47.820",
      "formatted_end": "03:08:48.820",
      "text": "هر چند دومار؟"
    },
    {
      "id": 75,
      "start": 11328.82,
      "end": 11329.82,
      "formatted_start": "03:08:48.820",
      "formatted_end": "03:08:49.820",
      "text": "اونقدر نیست"
    },
    {
      "id": 76,
      "start": 11329.82,
      "end": 11332.82,
      "formatted_start": "03:08:49.820",
      "formatted_end": "03:08:52.820",
      "text": "من شخصا اصلا اصلا اصلا همه جرایه نمیترزم"
    },
    {
      "id": 77,
      "start": 11332.82,
      "end": 11334.82,
      "formatted_start": "03:08:52.820",
      "formatted_end": "03:08:54.820",
      "text": "یعنی عوارض داره دیگه"
    },
    {
      "id": 78,
      "start": 11334.82,
      "end": 11337.82,
      "formatted_start": "03:08:54.820",
      "formatted_end": "03:08:57.820",
      "text": "همین هیچ جرایه بینی بیارزه هیچی ها"
    },
    {
      "id": 79,
      "start": 11337.82,
      "end": 11339.82,
      "formatted_start": "03:08:57.820",
      "formatted_end": "03:08:59.820",
      "text": "حس بویاییت نست میشه"
    },
    {
      "id": 80,
      "start": 11339.82,
      "end": 11341.82,
      "formatted_start": "03:08:59.820",
      "formatted_end": "03:09:01.820",
      "text": "یا دماغت میاد نمیفهم"
    },
    {
      "id": 81,
      "start": 11341.82,
      "end": 11343.82,
      "formatted_start": "03:09:01.820",
      "formatted_end": "03:09:03.820",
      "text": "دیگه آرزهایی داره دیگه فس فس میداریم"
    },
    {
      "id": 82,
      "start": 11343.82,
      "end": 11345.82,
      "formatted_start": "03:09:03.820",
      "formatted_end": "03:09:05.820",
      "text": "آره"
    },
    {
      "id": 83,
      "start": 11345.82,
      "end": 11347.82,
      "formatted_start": "03:09:05.820",
      "formatted_end": "03:09:07.820",
      "text": "اگر بیشتر نشد و بعد هم خون دماغش اینا"
    },
    {
      "id": 84,
      "start": 11349.82,
      "end": 11351.82,
      "formatted_start": "03:09:09.820",
      "formatted_end": "03:09:11.820",
      "text": "با خود دکتر بگه نیست"
    },
    {
      "id": 85,
      "start": 11351.82,
      "end": 11353.82,
      "formatted_start": "03:09:11.820",
      "formatted_end": "03:09:13.820",
      "text": "دکتر هم"
    },
    {
      "id": 86,
      "start": 11353.82,
      "end": 11355.82,
      "formatted_start": "03:09:13.820",
      "formatted_end": "03:09:15.820",
      "text": "تصمیم نمیکنه"
    },
    {
      "id": 87,
      "start": 11355.82,
      "end": 11357.82,
      "formatted_start": "03:09:15.820",
      "formatted_end": "03:09:17.820",
      "text": "و بعد هم به شما میگه تصمیم با خودتونه"
    },
    {
      "id": 88,
      "start": 11357.82,
      "end": 11359.82,
      "formatted_start": "03:09:17.820",
      "formatted_end": "03:09:19.820",
      "text": "آره"
    },
    {
      "id": 89,
      "start": 11359.82,
      "end": 11361.82,
      "formatted_start": "03:09:19.820",
      "formatted_end": "03:09:21.820",
      "text": "تصمیم با شماست دیگه شما میخوایید بیدید"
    },
    {
      "id": 90,
      "start": 11361.82,
      "end": 11363.82,
      "formatted_start": "03:09:21.820",
      "formatted_end": "03:09:23.820",
      "text": "اول زیبایی راه اینجا بگیریم"
    },
    {
      "id": 91,
      "start": 11363.82,
      "end": 11365.82,
      "formatted_start": "03:09:23.820",
      "formatted_end": "03:09:25.820",
      "text": "او جانست که نیست که دماغش نه دماغ بشر نکشه"
    },
    {
      "id": 92,
      "start": 11365.82,
      "end": 11367.82,
      "formatted_start": "03:09:25.820",
      "formatted_end": "03:09:27.820",
      "text": "نه"
    },
    {
      "id": 93,
      "start": 11367.82,
      "end": 11369.82,
      "formatted_start": "03:09:27.820",
      "formatted_end": "03:09:29.820",
      "text": "داره"
    },
    {
      "id": 94,
      "start": 11369.82,
      "end": 11371.82,
      "formatted_start": "03:09:29.820",
      "formatted_end": "03:09:31.820",
      "text": "اینجوری باید افتاده کنید"
    },
    {
      "id": 95,
      "start": 11371.82,
      "end": 11373.82,
      "formatted_start": "03:09:31.820",
      "formatted_end": "03:09:33.820",
      "text": "گمبه نیست؟"
    },
    {
      "id": 96,
      "start": 11373.82,
      "end": 11375.82,
      "formatted_start": "03:09:33.820",
      "formatted_end": "03:09:35.820",
      "text": "نیست"
    },
    {
      "id": 97,
      "start": 11375.82,
      "end": 11377.82,
      "formatted_start": "03:09:35.820",
      "formatted_end": "03:09:37.820",
      "text": "دوتایش خوبه هست؟"
    },
    {
      "id": 98,
      "start": 11377.82,
      "end": 11379.82,
      "formatted_start": "03:09:37.820",
      "formatted_end": "03:09:39.820",
      "text": "نه، من اینجوری نمیشنستم"
    },
    {
      "id": 99,
      "start": 11379.82,
      "end": 11381.82,
      "formatted_start": "03:09:39.820",
      "formatted_end": "03:09:41.820",
      "text": "گمبه از اینجوری نمیشنستم"
    },
    {
      "id": 100,
      "start": 11381.82,
      "end": 11383.82,
      "formatted_start": "03:09:41.820",
      "formatted_end": "03:09:43.820",
      "text": "آمده"
    },
    {
      "id": 101,
      "start": 11387.82,
      "end": 11389.82,
      "formatted_start": "03:09:47.820",
      "formatted_end": "03:09:49.820",
      "text": "اینجوری باید آزاد بگیرم"
    },
    {
      "id": 102,
      "start": 11389.82,
      "end": 11391.82,
      "formatted_start": "03:09:49.820",
      "formatted_end": "03:09:51.820",
      "text": "آده سیستم نیست"
    },
    {
      "id": 103,
      "start": 11391.82,
      "end": 11393.82,
      "formatted_start": "03:09:51.820",
      "formatted_end": "03:09:53.820",
      "text": "باید آزاد بگیرم"
    },
    {
      "id": 104,
      "start": 11393.82,
      "end": 11395.82,
      "formatted_start": "03:09:53.820",
      "formatted_end": "03:09:55.820",
      "text": "آمده"
    },
    {
      "id": 105,
      "start": 11395.82,
      "end": 11397.82,
      "formatted_start": "03:09:55.820",
      "formatted_end": "03:09:57.820",
      "text": "باید"
    }
  ],
  "status": "completed"
}