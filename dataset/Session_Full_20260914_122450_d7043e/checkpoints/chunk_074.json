    },
    {
      "id": 22,
      "start": 22295.0,
      "end": 22297.0,
      "formatted_start": "06:11:35.000",
      "formatted_end": "06:11:37.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 23,
      "start": 22297.0,
      "end": 22299.0,
      "formatted_start": "06:11:37.000",
      "formatted_end": "06:11:39.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 24,
      "start": 22299.0,
      "end": 22301.0,
      "formatted_start": "06:11:39.000",
      "formatted_end": "06:11:41.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 25,
      "start": 22301.0,
      "end": 22303.0,
      "formatted_start": "06:11:41.000",
      "formatted_end": "06:11:43.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 26,
      "start": 22303.0,
      "end": 22305.0,
      "formatted_start": "06:11:43.000",
      "formatted_end": "06:11:45.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 27,
      "start": 22305.0,
      "end": 22307.0,
      "formatted_start": "06:11:45.000",
      "formatted_end": "06:11:47.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 28,
      "start": 22307.0,
      "end": 22309.0,
      "formatted_start": "06:11:47.000",
      "formatted_end": "06:11:49.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 29,
      "start": 22309.0,
      "end": 22311.0,
      "formatted_start": "06:11:49.000",
      "formatted_end": "06:11:51.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
      "id": 30,
      "start": 22311.0,
      "end": 22314.0,
      "formatted_start": "06:11:51.000",
      "formatted_end": "06:11:54.000",
      "text": "اینجون تو دیگه چیزی خونگزی چیزی اصلا"
    },
    {
      "id": 31,
      "start": 22314.0,
      "end": 22317.0,
      "formatted_start": "06:11:54.000",
      "formatted_end": "06:11:57.000",
      "text": "سیگ، اینا توش دیده نمیشه"
    },
    {
      "id": 32,
      "start": 22317.0,
      "end": 22320.0,
      "formatted_start": "06:11:57.000",
      "formatted_end": "06:12:00.000",
      "text": "به سر سردردی"
    },
    {
      "id": 33,
      "start": 22320.0,
      "end": 22322.0,
      "formatted_start": "06:12:00.000",
      "formatted_end": "06:12:02.000",
      "text": "عصبی بشم، نارهد بشم"
    },
    {
      "id": 34,
      "start": 22322.0,
      "end": 22325.0,
      "formatted_start": "06:12:02.000",
      "formatted_end": "06:12:05.000",
      "text": "هر روز که پشت من براز داره با موزه شده بود"
    },
    {
      "id": 35,
      "start": 22325.0,
      "end": 22329.0,
      "formatted_start": "06:12:05.000",
      "formatted_end": "06:12:09.000",
      "text": "مامان از زمین خورده، لگنش چکسته، بک بخش شده"
    },
    {
      "id": 36,
      "start": 22329.0,
      "end": 22335.0,
      "formatted_start": "06:12:09.000",
      "formatted_end": "06:12:15.000",
      "text": "ایه، بدتر این اتفاق نومانو بیافت و بریادرم بشه"
    },
    {
      "id": 37,
      "start": 22335.0,
      "end": 22340.0,
      "formatted_start": "06:12:15.000",
      "formatted_end": "06:12:20.000",
      "text": "یعنی خدا مکنه پیر زمین بخوره، زمین بخوره لگن میشه"
    },
    {
      "id": 38,
      "start": 22340.0,
      "end": 22342.0,
      "formatted_start": "06:12:20.000",
      "formatted_end": "06:12:22.000",
      "text": "شکست کنه شما"
    },
    {
      "id": 39,
      "start": 22342.0,
      "end": 22346.0,
      "formatted_start": "06:12:22.000",
      "formatted_end": "06:12:26.000",
      "text": "تو روز جنگش برای معمولم بعد اون رو آنگی نمی کنم"
    },
    {
      "id": 40,
      "start": 22346.0,
      "end": 22349.0,
      "formatted_start": "06:12:26.000",
      "formatted_end": "06:12:29.000",
      "text": "دارو را سونا داری؟"
    },
    {
      "id": 41,
      "start": 22349.0,
      "end": 22351.0,
      "formatted_start": "06:12:29.000",
      "formatted_end": "06:12:31.000",
      "text": "جن را دارم"
    },
    {
      "id": 42,
      "start": 22364.0,
      "end": 22366.0,
      "formatted_start": "06:12:44.000",
      "formatted_end": "06:12:46.000",
      "text": "سردم جن"
    },
    {
      "id": 43,
      "start": 22366.0,
      "end": 22368.0,
      "formatted_start": "06:12:46.000",
      "formatted_end": "06:12:48.000",
      "text": "درستش آبوده"
    },
    {
      "id": 44,
      "start": 22370.0,
      "end": 22373.1,
      "formatted_start": "06:12:50.000",
      "formatted_end": "06:12:53.100",
      "text": "محمودی وزود"
    },
    {
      "id": 45,
      "start": 22373.1,
      "end": 22377.8,
      "formatted_start": "06:12:53.100",
      "formatted_end": "06:12:57.800",
      "text": "بعد قضا شروع شده"
    },
    {
      "id": 46,
      "start": 22377.8,
      "end": 22380.36,
      "formatted_start": "06:12:57.800",
      "formatted_end": "06:13:00.360",
      "text": "چی خورد نها"
    },
    {
      "id": 47,
      "start": 22380.36,
      "end": 22381.38,
      "formatted_start": "06:13:00.360",
      "formatted_end": "06:13:01.380",
      "text": "میدونیم"
    },
    {
      "id": 48,
      "start": 22381.38,
      "end": 22384.1,
      "formatted_start": "06:13:01.380",
      "formatted_end": "06:13:04.100",
      "text": "چون من گفته بودم مایات بخورم"
    },
    {
      "id": 49,
      "start": 22384.1,
      "end": 22388.44,
      "formatted_start": "06:13:04.100",
      "formatted_end": "06:13:08.440",
      "text": "آره پنتو شروع کن"
    },
    {
      "id": 50,
      "start": 22388.44,
      "end": 22390.08,
      "formatted_start": "06:13:08.440",
      "formatted_end": "06:13:10.080",
      "text": "بعد"
    },
    {
      "id": 51,
      "start": 22390.08,
      "end": 22391.86,
      "formatted_start": "06:13:10.080",
      "formatted_end": "06:13:11.860",
      "text": "یه پنتو به شستت بزن"
    },
    {
      "id": 52,
      "start": 22391.86,
      "end": 22394.4,
      "formatted_start": "06:13:11.860",
      "formatted_end": "06:13:14.400",
      "text": "اگه یه مشابه گوارش بزار"
    },
    {
      "id": 53,
      "start": 22394.4,
      "end": 22396.16,
      "formatted_start": "06:13:14.400",
      "formatted_end": "06:13:16.160",
      "text": "از اونه آندون"
    },
    {
      "id": 54,
      "start": 22396.16,
      "end": 22397.34,
      "formatted_start": "06:13:16.160",
      "formatted_end": "06:13:17.340",
      "text": "خب دوتا قراری"
    },
    {
      "id": 55,
      "start": 22397.34,
      "end": 22427.34,
      "formatted_start": "06:13:17.340",
      "formatted_end": "06:13:47.340",
      "text": "از اینجا باید بردارید که این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته خوب بوده این هفته"
    },
    {
      "id": 56,
      "start": 22427.34,
      "end": 22431.34,
      "formatted_start": "06:13:47.340",
      "formatted_end": "06:13:51.340",
      "text": "اینجا بیدار کنی، یک مثل اینجا"
    },
    {
      "id": 57,
      "start": 22431.34,
      "end": 22436.34,
      "formatted_start": "06:13:51.340",
      "formatted_end": "06:13:56.340",
      "text": "خب این کلیه هم، براتون پیزو تراپی ننوشتم؟"
    },
    {
      "id": 58,
      "start": 22436.34,
      "end": 22437.34,
      "formatted_start": "06:13:56.340",
      "formatted_end": "06:13:57.340",
      "text": "نه"
    },
    {
      "id": 59,
      "start": 22437.34,
      "end": 22443.34,
      "formatted_start": "06:13:57.340",
      "formatted_end": "06:14:03.340",
      "text": "بازو یخ زده است و دیالتی است، هرچی هم جوش بزنی، بیشتر میشه"
    },
    {
      "id": 60,
      "start": 22443.34,
      "end": 22445.34,
      "formatted_start": "06:14:03.340",
      "formatted_end": "06:14:05.340",
      "text": "من بیشتر میشم"
    },
    {
      "id": 61,
      "start": 22445.34,
      "end": 22447.34,
      "formatted_start": "06:14:05.340",
      "formatted_end": "06:14:07.340",
      "text": "نه جوش بزنی دیگه"
    },
    {
      "id": 62,
      "start": 22447.34,
      "end": 22455.34,
      "formatted_start": "06:14:07.340",
      "formatted_end": "06:14:15.340",
      "text": "مادر جوشی دیگه، نه بزرگ میاد، نه خوهر میاد، من بدبخت کنار"
    },
    {
      "id": 63,
      "start": 22455.34,
      "end": 22458.78,
      "formatted_start": "06:14:15.340",
      "formatted_end": "06:14:18.780",
      "text": "جوشی دیگه جوش نیست چون عصبی دیگه عصبی نیست"
    },
    {
      "id": 64,
      "start": 22458.78,
      "end": 22460.22,
      "formatted_start": "06:14:18.780",
      "formatted_end": "06:14:20.220",
      "text": "اما بچه های دیگه نمی آمد"
    },
    {
      "id": 65,
      "start": 22460.22,
      "end": 22461.22,
      "formatted_start": "06:14:20.220",
      "formatted_end": "06:14:21.220",
      "text": "نمی آمد"
    },
    {
      "id": 66,
      "start": 22461.22,
      "end": 22464.22,
      "formatted_start": "06:14:21.220",
      "formatted_end": "06:14:24.220",
      "text": "من دیگه بیلیا قدرم برم زنم"
    },
    {
      "id": 67,
      "start": 22468.22,
      "end": 22471.22,
      "formatted_start": "06:14:28.220",
      "formatted_end": "06:14:31.220",
      "text": "شما خودتون مریض هستن، این سنونتون هم کم هست که"
    },
    {
      "id": 68,
      "start": 22473.22,
      "end": 22476.22,
      "formatted_start": "06:14:33.220",
      "formatted_end": "06:14:36.220",
      "text": "تو تا امپول نمیخواد زیبا زیاد زدی نه؟"
    },
    {
      "id": 69,
      "start": 22477.22,
      "end": 22478.22,
      "formatted_start": "06:14:37.220",
      "formatted_end": "06:14:38.220",
      "text": "امپول هم زدم"
    },
    {
      "id": 70,
      "start": 22479.22,
      "end": 22485.22,
      "formatted_start": "06:14:39.220",
      "formatted_end": "06:14:45.220",
      "text": "امپول دیگه خیلی فائده نداره، خب من برای دستتون فقط یک زکر ضعیف نمیشم"
    },
    {
      "id": 71,
      "start": 22485.22,
      "end": 22487.22,
      "formatted_start": "06:14:45.220",
      "formatted_end": "06:14:47.220",
      "text": "بخواد اینکه قلبتون رو نمیتونه"
    },
    {
      "id": 72,
      "start": 22487.22,
      "end": 22489.22,
      "formatted_start": "06:14:47.220",
      "formatted_end": "06:14:49.220",
      "text": "فقط یک فیزیوتراپی میده است"
    },
    {
      "id": 73,
      "start": 22489.22,
      "end": 22491.22,
      "formatted_start": "06:14:49.220",
      "formatted_end": "06:14:51.220",
      "text": "هم براتون"
    },
    {
      "id": 74,
      "start": 22491.22,
      "end": 22493.22,
      "formatted_start": "06:14:51.220",
      "formatted_end": "06:14:53.220",
      "text": "الان که نمیتونه کنم"
    },
    {
      "id": 75,
      "start": 22493.22,
      "end": 22495.22,
      "formatted_start": "06:14:53.220",
      "formatted_end": "06:14:55.220",
      "text": "نمیتونه"
    },
    {
      "id": 76,
      "start": 22495.22,
      "end": 22497.22,
      "formatted_start": "06:14:55.220",
      "formatted_end": "06:14:57.220",
      "text": "مادرم بود تو من برم"
    },
    {
      "id": 77,
      "start": 22497.22,
      "end": 22499.22,
      "formatted_start": "06:14:57.220",
      "formatted_end": "06:14:59.220",
      "text": "الان دخترم رو داشته باشیم"
    },
    {
      "id": 78,
      "start": 22499.22,
      "end": 22501.22,
      "formatted_start": "06:14:59.220",
      "formatted_end": "06:15:01.220",
      "text": "امیدوارم"
    }
  ],
  "status": "completed"
}