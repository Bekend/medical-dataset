  "stt_segments": [
    {
      "id": 0,
      "start": 22200.0,
      "end": 22230.0,
      "formatted_start": "06:10:00.000",
      "formatted_end": "06:10:30.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید برداری"
    },
    {
      "id": 1,
      "start": 22230.0,
      "end": 22255.0,
      "formatted_start": "06:10:30.000",
      "formatted_end": "06:10:55.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 22255.0,
      "end": 22257.0,
      "formatted_start": "06:10:55.000",
      "formatted_end": "06:10:57.000",
      "text": "چا ترکشی چا در؟"
    },
    {
      "id": 3,
      "start": 22257.0,
      "end": 22259.0,
      "formatted_start": "06:10:57.000",
      "formatted_end": "06:10:59.000",
      "text": "تو تیفنگره باشت"
    },
    {
      "id": 4,
      "start": 22259.0,
      "end": 22261.0,
      "formatted_start": "06:10:59.000",
      "formatted_end": "06:11:01.000",
      "text": "آه؟"
    },
    {
      "id": 5,
      "start": 22261.0,
      "end": 22263.0,
      "formatted_start": "06:11:01.000",
      "formatted_end": "06:11:03.000",
      "text": "چی؟"
    },
    {
      "id": 6,
      "start": 22263.0,
      "end": 22265.0,
      "formatted_start": "06:11:03.000",
      "formatted_end": "06:11:05.000",
      "text": "نه یعنی بیسته ایقین ها شد؟"
    },
    {
      "id": 7,
      "start": 22265.0,
      "end": 22267.0,
      "formatted_start": "06:11:05.000",
      "formatted_end": "06:11:07.000",
      "text": "تو بسیار؟ آه؟ همین شد؟"
    },
    {
      "id": 8,
      "start": 22267.0,
      "end": 22269.0,
      "formatted_start": "06:11:07.000",
      "formatted_end": "06:11:09.000",
      "text": "باید توخ داشتی؟"
    },
    {
      "id": 9,
      "start": 22269.0,
      "end": 22271.0,
      "formatted_start": "06:11:09.000",
      "formatted_end": "06:11:11.000",
      "text": "آه، نه"
    },
    {
      "id": 10,
      "start": 22271.0,
      "end": 22273.0,
      "formatted_start": "06:11:11.000",
      "formatted_end": "06:11:13.000",
      "text": "تو باید داشتی؟ سخت"
    },
    {
      "id": 11,
      "start": 22273.0,
      "end": 22275.0,
      "formatted_start": "06:11:13.000",
      "formatted_end": "06:11:15.000",
      "text": "من گفتم من میترسن، من چند برم داخل شدم"
    },
    {
      "id": 12,
      "start": 22275.0,
      "end": 22277.0,
      "formatted_start": "06:11:15.000",
      "formatted_end": "06:11:17.000",
      "text": "پنج شش بار"
    },
    {
      "id": 13,
      "start": 22277.0,
      "end": 22279.0,
      "formatted_start": "06:11:17.000",
      "formatted_end": "06:11:19.000",
      "text": "زمانی که دیست کمر باشدم"
    },
    {
      "id": 14,
      "start": 22279.0,
      "end": 22281.0,
      "formatted_start": "06:11:19.000",
      "formatted_end": "06:11:21.000",
      "text": "کمرم عمل کردم"
    },
    {
      "id": 15,
      "start": 22281.0,
      "end": 22283.0,
      "formatted_start": "06:11:21.000",
      "formatted_end": "06:11:23.000",
      "text": "منو میترسن"
    },
    {
      "id": 16,
      "start": 22283.0,
      "end": 22285.0,
      "formatted_start": "06:11:23.000",
      "formatted_end": "06:11:25.000",
      "text": "خب، اینکه صابر بشد"
    },
    {
      "id": 17,
      "start": 22285.0,
      "end": 22287.0,
      "formatted_start": "06:11:25.000",
      "formatted_end": "06:11:27.000",
      "text": "خفا میشن داخل این موزه"
    },
    {
