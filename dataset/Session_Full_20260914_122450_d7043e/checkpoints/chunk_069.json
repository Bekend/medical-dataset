      "end": 20759.98,
      "formatted_start": "05:45:30.000",
      "formatted_end": "05:45:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 2,
      "start": 20760.0,
      "end": 20789.98,
      "formatted_start": "05:46:00.000",
      "formatted_end": "05:46:29.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 3,
      "start": 20790.0,
      "end": 20796.0,
      "formatted_start": "05:46:30.000",
      "formatted_end": "05:46:36.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 20850.0,
      "end": 20852.0,
      "formatted_start": "05:47:30.000",
      "formatted_end": "05:47:32.000",
      "text": "مردی از اینجا باید بردارید."
    },
    {
      "id": 5,
      "start": 20852.0,
      "end": 20854.0,
      "formatted_start": "05:47:32.000",
      "formatted_end": "05:47:34.000",
      "text": "کراتین مامان هم بردارید."
    },
    {
      "id": 6,
      "start": 20854.0,
      "end": 20856.0,
      "formatted_start": "05:47:34.000",
      "formatted_end": "05:47:36.000",
      "text": "چربش هم بردارید."
    },
    {
      "id": 7,
      "start": 20856.0,
      "end": 20858.0,
      "formatted_start": "05:47:36.000",
      "formatted_end": "05:47:38.000",
      "text": "افتخام هم بردارید."
    },
    {
      "id": 8,
      "start": 20858.0,
      "end": 20860.0,
      "formatted_start": "05:47:38.000",
      "formatted_end": "05:47:40.000",
      "text": "بهتر نشدن؟"
    },
    {
      "id": 9,
      "start": 20860.0,
      "end": 20862.0,
      "formatted_start": "05:47:40.000",
      "formatted_end": "05:47:42.000",
      "text": "خالتهایی که بهتر شدن"
    },
    {
      "id": 10,
      "start": 20862.0,
      "end": 20864.0,
      "formatted_start": "05:47:42.000",
      "formatted_end": "05:47:44.000",
      "text": "قضا و آبجایی دارند."
    },
    {
      "id": 11,
      "start": 20864.0,
      "end": 20866.0,
      "formatted_start": "05:47:44.000",
      "formatted_end": "05:47:46.000",
      "text": "ما باید برداریم."
    },
    {
      "id": 12,
      "start": 20866.0,
      "end": 20868.0,
      "formatted_start": "05:47:46.000",
      "formatted_end": "05:47:48.000",
      "text": "اینکه ما باید برداریم."
    },
    {
      "id": 13,
      "start": 20868.0,
      "end": 20870.0,
      "formatted_start": "05:47:48.000",
      "formatted_end": "05:47:50.000",
      "text": "اینکه ما باید برداریم."
    },
    {
      "id": 14,
      "start": 20870.0,
      "end": 20872.0,
      "formatted_start": "05:47:50.000",
      "formatted_end": "05:47:52.000",
      "text": "اینکه ما باید برداریم."
    },
    {
      "id": 15,
      "start": 20872.0,
      "end": 20874.0,
      "formatted_start": "05:47:52.000",
      "formatted_end": "05:47:54.000",
      "text": "اینکه ما باید برداریم."
    },
    {
      "id": 16,
      "start": 20874.0,
      "end": 20876.0,
      "formatted_start": "05:47:54.000",
      "formatted_end": "05:47:56.000",
      "text": "اینکه ما باید برداریم."
    },
    {
      "id": 17,
      "start": 20876.0,
      "end": 20878.0,
      "formatted_start": "05:47:56.000",
      "formatted_end": "05:47:58.000",
      "text": "این افراد که آمد بود می داد"
    },
    {
      "id": 18,
      "start": 20878.0,
      "end": 20880.0,
      "formatted_start": "05:47:58.000",
      "formatted_end": "05:48:00.000",
      "text": "بعد تا دا آمده بود چیه ای دهی"
    },
    {
      "id": 19,
      "start": 20880.0,
      "end": 20882.0,
      "formatted_start": "05:48:00.000",
      "formatted_end": "05:48:02.000",
      "text": "ولی خب خیلی زیاد تنش داره"
    },
    {
      "id": 20,
      "start": 20882.0,
      "end": 20884.0,
      "formatted_start": "05:48:02.000",
      "formatted_end": "05:48:04.000",
      "text": "اصلا ماشه این برمی کنه"
    },
    {
      "id": 21,
      "start": 20884.0,
      "end": 20886.0,
      "formatted_start": "05:48:04.000",
      "formatted_end": "05:48:06.000",
      "text": "بعد صدا می زنه"
    },
    {
      "id": 22,
      "start": 20886.0,
      "end": 20888.0,
      "formatted_start": "05:48:06.000",
      "formatted_end": "05:48:08.000",
      "text": "اینو درد داره چیه؟"
    },
    {
      "id": 23,
      "start": 20888.0,
      "end": 20890.0,
      "formatted_start": "05:48:08.000",
      "formatted_end": "05:48:10.000",
      "text": "پورش بالا هست کلیهش کم بار می کنه"
    },
    {
      "id": 24,
      "start": 20890.0,
      "end": 20892.0,
      "formatted_start": "05:48:10.000",
      "formatted_end": "05:48:12.000",
      "text": "دوچار در موقع مریض دیالیز"
    },
    {
      "id": 25,
      "start": 20892.0,
      "end": 20894.0,
      "formatted_start": "05:48:12.000",
      "formatted_end": "05:48:14.000",
      "text": "اونها که نیمون شده دیان دهند"
    },
    {
      "id": 26,
      "start": 20894.0,
      "end": 20896.0,
      "formatted_start": "05:48:14.000",
      "formatted_end": "05:48:16.000",
      "text": "پورش کم هم نرک داره"
    },
    {
      "id": 27,
      "start": 20896.0,
      "end": 20898.0,
      "formatted_start": "05:48:16.000",
      "formatted_end": "05:48:18.000",
      "text": "آره دیگه چه کار می کنه"
    },
    {
      "id": 28,
      "start": 20898.0,
      "end": 20900.0,
      "formatted_start": "05:48:18.000",
      "formatted_end": "05:48:20.000",
      "text": "دروار که داده دید"
    },
    {
      "id": 29,
      "start": 20900.0,
      "end": 20903.0,
      "formatted_start": "05:48:20.000",
      "formatted_end": "05:48:23.000",
      "text": "اینو همه دوز هواست داری داده"
    },
    {
      "id": 30,
      "start": 20907.0,
      "end": 20910.0,
      "formatted_start": "05:48:27.000",
      "formatted_end": "05:48:30.000",
      "text": "اونها تا دوز رو بسیار شد"
    },
    {
      "id": 31,
      "start": 20914.0,
      "end": 20916.0,
      "formatted_start": "05:48:34.000",
      "formatted_end": "05:48:36.000",
      "text": "همه چی کار داری؟"
    },
    {
      "id": 32,
      "start": 20916.0,
      "end": 20918.0,
      "formatted_start": "05:48:36.000",
      "formatted_end": "05:48:38.000",
      "text": "هواست داره بسیار شد"
    },
    {
      "id": 33,
      "start": 20918.0,
      "end": 20919.0,
      "formatted_start": "05:48:38.000",
      "formatted_end": "05:48:39.000",
      "text": "پسیدانه داشت و صدا بسیار شد"
    },
    {
      "id": 34,
      "start": 20919.0,
      "end": 20920.0,
      "formatted_start": "05:48:39.000",
      "formatted_end": "05:48:40.000",
      "text": "آره آره"
    },
    {
      "id": 35,
      "start": 20920.0,
      "end": 20921.0,
      "formatted_start": "05:48:40.000",
      "formatted_end": "05:48:41.000",
      "text": "باشه"
    },
    {
      "id": 36,
      "start": 20921.0,
      "end": 20924.0,
      "formatted_start": "05:48:41.000",
      "formatted_end": "05:48:44.000",
      "text": "بعد الان دو روزه پشارش 18"
    },
    {
      "id": 37,
      "start": 20924.0,
      "end": 20927.0,
      "formatted_start": "05:48:44.000",
      "formatted_end": "05:48:47.000",
      "text": "ایروز 18 بس صبح گرفتم"
    },
    {
      "id": 38,
      "start": 20927.0,
      "end": 20929.0,
      "formatted_start": "05:48:47.000",
      "formatted_end": "05:48:49.000",
      "text": "اون روز 16"
    },
    {
      "id": 39,
      "start": 20929.0,
      "end": 20931.0,
      "formatted_start": "05:48:49.000",
      "formatted_end": "05:48:51.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 40,
      "start": 20931.0,
      "end": 20933.0,
      "formatted_start": "05:48:51.000",
      "formatted_end": "05:48:53.000",
      "text": "این درخواهد شدید"
    },
    {
      "id": 41,
      "start": 20944.0,
      "end": 20947.0,
      "formatted_start": "05:49:04.000",
      "formatted_end": "05:49:07.000",
      "text": "درخواهد دکتور عبیسته ای رو شما میبینید؟"
    },
    {
      "id": 42,
      "start": 20947.0,
      "end": 20950.0,
      "formatted_start": "05:49:07.000",
      "formatted_end": "05:49:10.000",
      "text": "یا باید به خودشون نشون بدم؟"
    },
    {
      "id": 43,
      "start": 20950.0,
      "end": 20952.0,
      "formatted_start": "05:49:10.000",
      "formatted_end": "05:49:12.000",
      "text": "نه، نمی نمی سامشکردیم"
    },
    {
      "id": 44,
      "start": 20952.0,
      "end": 20954.0,
      "formatted_start": "05:49:12.000",
      "formatted_end": "05:49:14.000",
      "text": "خیلی خوب"
    },
    {
      "id": 45,
      "start": 20955.0,
      "end": 20958.0,
      "formatted_start": "05:49:15.000",
      "formatted_end": "05:49:18.000",
      "text": "مامانو میتونین از دورانیان پول بزنید؟"
    },
    {
      "id": 46,
      "start": 20958.0,
      "end": 20960.0,
      "formatted_start": "05:49:18.000",
      "formatted_end": "05:49:20.000",
      "text": "آره"
    },
    {
      "id": 47,
      "start": 20960.0,
      "end": 20964.5,
      "formatted_start": "05:49:20.000",
      "formatted_end": "05:49:24.500",
      "text": "از اونی درستم چون میدونی برای مامان تو سروم خوب نیست که"
    },
    {
      "id": 48,
      "start": 20964.5,
      "end": 20966.5,
      "formatted_start": "05:49:24.500",
      "formatted_end": "05:49:26.500",
      "text": "سروم اصلا نباید بهشون"
    },
    {
      "id": 49,
      "start": 20966.5,
      "end": 20969.0,
      "formatted_start": "05:49:26.500",
      "formatted_end": "05:49:29.000",
      "text": "از اینکه مثلا خود پلش تشکست بده"
    },
    {
      "id": 50,
      "start": 20969.0,
      "end": 20973.5,
      "formatted_start": "05:49:29.000",
      "formatted_end": "05:49:33.500",
      "text": "بس سروم هم باید اگه بزنن سرسیسی تو اینکه دو ساعت"
    },
    {
      "id": 51,
      "start": 20973.5,
      "end": 20975.5,
      "formatted_start": "05:49:33.500",
      "formatted_end": "05:49:35.500",
      "text": "چون میره داخل ریهش"
    },
    {
      "id": 52,
      "start": 20975.5,
      "end": 20979.0,
      "formatted_start": "05:49:35.500",
      "formatted_end": "05:49:39.000",
      "text": "باید خوش کن، باید قرصه رو براشون بکنید"
    },
    {
      "id": 53,
      "start": 20979.0,
      "end": 20984.0,
      "formatted_start": "05:49:39.000",
      "formatted_end": "05:49:44.000",
      "text": "باید این قرصه رو آره، توی آب حل میکنیم، باید بهش میگیم"
    },
    {
      "id": 54,
      "start": 20984.0,
      "end": 20985.0,
      "formatted_start": "05:49:44.000",
      "formatted_end": "05:49:45.000",
      "text": "خیلی خوب"
    },
    {
      "id": 55,
      "start": 20985.0,
      "end": 20987.72,
      "formatted_start": "05:49:45.000",
      "formatted_end": "05:49:47.720",
      "text": "تمام قرص ها حل میشه بهش"
    },
    {
      "id": 56,
      "start": 20987.72,
      "end": 20999.84,
      "formatted_start": "05:49:47.720",
      "formatted_end": "05:49:59.840",
      "text": "این همه قرص ما یعنی از صبح شروع میکنه تا اون شب ادامه بود"
    }
  ],
  "status": "completed"
}