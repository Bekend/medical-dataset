  "stt_segments": [
    {
      "id": 0,
      "start": 24000.0,
      "end": 24008.0,
      "formatted_start": "06:40:00.000",
      "formatted_end": "06:40:08.000",
      "text": "تو برو، مرز بان من دیگه هر کار باشه. یا با شفایی میام کار میکنم فلان تا با زینبابت بیام."
    },
    {
      "id": 1,
      "start": 24008.0,
      "end": 24010.0,
      "formatted_start": "06:40:08.000",
      "formatted_end": "06:40:10.000",
      "text": "برو من ماشین نمیام دنبالت."
    },
    {
      "id": 2,
      "start": 24010.0,
      "end": 24012.0,
      "formatted_start": "06:40:10.000",
      "formatted_end": "06:40:12.000",
      "text": "باش خدا."
    },
    {
      "id": 3,
      "start": 24012.0,
      "end": 24017.0,
      "formatted_start": "06:40:12.000",
      "formatted_end": "06:40:17.000",
      "text": "میدونی چه کار کنی؟ تا شما با اسلاب بریمونو بزیدگی من با ماشین میام دنبالتان خوبه؟"
    },
    {
      "id": 4,
      "start": 24017.0,
      "end": 24019.0,
      "formatted_start": "06:40:17.000",
      "formatted_end": "06:40:19.000",
      "text": "نه بابا از یه هر میشه بد کنم."
    },
    {
      "id": 5,
      "start": 24019.0,
      "end": 24021.0,
      "formatted_start": "06:40:19.000",
      "formatted_end": "06:40:21.000",
      "text": "خب نه میگیرم با مرز بان دیگه."
    },
    {
      "id": 6,
      "start": 24021.0,
      "end": 24024.0,
      "formatted_start": "06:40:21.000",
      "formatted_end": "06:40:24.000",
      "text": "از اون فشار های چیزی نیه بذاشتی؟"
    },
    {
      "id": 7,
      "start": 24024.0,
      "end": 24026.0,
      "formatted_start": "06:40:24.000",
      "formatted_end": "06:40:26.000",
      "text": "برای اون یه روی نیمس بشم."
    },
    {
      "id": 8,
      "start": 24026.0,
      "end": 24030.0,
      "formatted_start": "06:40:26.000",
      "formatted_end": "06:40:30.000",
      "text": "الان دکتر مقدسی نیم خواهد اشیفشو بیاره مردم"
    },
    {
      "id": 9,
      "start": 24030.0,
      "end": 24032.0,
      "formatted_start": "06:40:30.000",
      "formatted_end": "06:40:32.000",
      "text": "انشالله"
    },
    {
      "id": 10,
      "start": 24032.0,
      "end": 24033.0,
      "formatted_start": "06:40:32.000",
      "formatted_end": "06:40:33.000",
      "text": "خب الان؟"
    },
    {
      "id": 11,
      "start": 24033.0,
      "end": 24036.0,
      "formatted_start": "06:40:33.000",
      "formatted_end": "06:40:36.000",
      "text": "دیگه شماره هلگه میخواد چی کنه خودم حالا درخواهد میزنم"
    },
    {
      "id": 12,
      "start": 24036.0,
      "end": 24037.0,
      "formatted_start": "06:40:36.000",
      "formatted_end": "06:40:37.000",
      "text": "یکی چیز بگن؟"
    },
    {
      "id": 13,
      "start": 24037.0,
      "end": 24038.0,
      "formatted_start": "06:40:37.000",
      "formatted_end": "06:40:38.000",
      "text": "آه"
    },
    {
      "id": 14,
      "start": 24038.0,
      "end": 24040.0,
      "formatted_start": "06:40:38.000",
      "formatted_end": "06:40:40.000",
      "text": "یعنی این از تمام جزئیات زندگی شما خبر داره"
    },
    {
      "id": 15,
      "start": 24040.0,
      "end": 24070.0,
      "formatted_start": "06:40:40.000",
      "formatted_end": "06:41:10.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 16,
      "start": 24070.0,
      "end": 24071.0,
      "formatted_start": "06:41:10.000",
      "formatted_end": "06:41:11.000",
      "text": "اوه، ماشین ها خوبه؟"
    },
    {
      "id": 17,
      "start": 24071.0,
      "end": 24072.0,
      "formatted_start": "06:41:11.000",
      "formatted_end": "06:41:12.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 24072.0,
      "end": 24075.0,
      "formatted_start": "06:41:12.000",
      "formatted_end": "06:41:15.000",
      "text": "مالا نه، من خوشم بگیرم، من لباس آباز کنم"
    },
    {
      "id": 19,
      "start": 24075.0,
      "end": 24078.0,
      "formatted_start": "06:41:15.000",
      "formatted_end": "06:41:18.000",
      "text": "لباس آباز کن، مایت ها کن، تیپتانو خوش"
    },
    {
      "id": 20,
      "start": 24078.0,
      "end": 24082.0,
      "formatted_start": "06:41:18.000",
      "formatted_end": "06:41:22.000",
      "text": "پیرمارت ها فرخ خواهد شفایی میگه که"
    },
    {
      "id": 21,
      "start": 24082.0,
      "end": 24084.0,
      "formatted_start": "06:41:22.000",
      "formatted_end": "06:41:24.000",
      "text": "صورمه برای چشم خوبه"
    },
    {
      "id": 22,
      "start": 24084.0,
      "end": 24087.0,
      "formatted_start": "06:41:24.000",
      "formatted_end": "06:41:27.000",
      "text": "صورمه برای چشم خوبه"
    },
    {
      "id": 23,
      "start": 24087.0,
      "end": 24089.0,
      "formatted_start": "06:41:27.000",
      "formatted_end": "06:41:29.000",
      "text": "صورمه برای چشم خواهی"
    },
    {
      "id": 24,
      "start": 24089.0,
      "end": 24092.0,
      "formatted_start": "06:41:29.000",
      "formatted_end": "06:41:32.000",
      "text": "آه، چشم خوبه، آه، صورمه برای چشم خوبه"
    },
    {
      "id": 25,
      "start": 24092.0,
      "end": 24094.0,
      "formatted_start": "06:41:32.000",
      "formatted_end": "06:41:34.000",
      "text": "آه، خیلی خوبه"
    },
    {
      "id": 26,
      "start": 24100.0,
      "end": 24102.0,
      "formatted_start": "06:41:40.000",
      "formatted_end": "06:41:42.000",
      "text": "این که دیگه نداشت"
    },
    {
      "id": 27,
      "start": 24130.0,
      "end": 24140.0,
      "formatted_start": "06:42:10.000",
      "formatted_end": "06:42:20.000",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 24160.0,
      "end": 24162.0,
      "formatted_start": "06:42:40.000",
      "formatted_end": "06:42:42.000",
      "text": "موسیقی"
    },
    {
