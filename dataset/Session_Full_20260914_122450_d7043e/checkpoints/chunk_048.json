      "formatted_start": "04:00:18.000",
      "formatted_end": "04:00:20.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 10,
      "start": 14420.0,
      "end": 14422.0,
      "formatted_start": "04:00:20.000",
      "formatted_end": "04:00:22.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 11,
      "start": 14422.0,
      "end": 14451.98,
      "formatted_start": "04:00:22.000",
      "formatted_end": "04:00:51.980",
      "text": "از اینجا باید بردارید که اینجا باید بردارید"
    },
    {
      "id": 12,
      "start": 14452.0,
      "end": 14454.0,
      "formatted_start": "04:00:52.000",
      "formatted_end": "04:00:54.000",
      "text": "اینجا چی شد؟"
    },
    {
      "id": 13,
      "start": 14454.0,
      "end": 14462.0,
      "formatted_start": "04:00:54.000",
      "formatted_end": "04:01:02.000",
      "text": "اگر باید برم اگر دو بره تکرار بشه باید یه آن رو کورو همشون ترسن و بدخیمی چیز باشه"
    },
    {
      "id": 14,
      "start": 14462.0,
      "end": 14464.0,
      "formatted_start": "04:01:02.000",
      "formatted_end": "04:01:04.000",
      "text": "انصداد کازک بود ولی خوب اینکه"
    },
    {
      "id": 15,
      "start": 14464.0,
      "end": 14466.0,
      "formatted_start": "04:01:04.000",
      "formatted_end": "04:01:06.000",
      "text": "رنگ زرگ بود"
    },
    {
      "id": 16,
      "start": 14466.0,
      "end": 14468.0,
      "formatted_start": "04:01:06.000",
      "formatted_end": "04:01:08.000",
      "text": "آن خطر نداره"
    },
    {
      "id": 17,
      "start": 14468.0,
      "end": 14470.0,
      "formatted_start": "04:01:08.000",
      "formatted_end": "04:01:10.000",
      "text": "بجز گلوتلی ها چی میخواد؟"
    },
    {
      "id": 18,
      "start": 14470.0,
      "end": 14472.0,
      "formatted_start": "04:01:10.000",
      "formatted_end": "04:01:12.000",
      "text": "همچنین"
    },
    {
      "id": 19,
      "start": 14472.0,
      "end": 14474.0,
      "formatted_start": "04:01:12.000",
      "formatted_end": "04:01:14.000",
      "text": "یه چی دیگه نمیدونش؟ گفت گرم نه"
    },
    {
      "id": 20,
      "start": 14474.0,
      "end": 14476.0,
      "formatted_start": "04:01:14.000",
      "formatted_end": "04:01:16.000",
      "text": "هم دیوزیده سید"
    },
    {
      "id": 21,
      "start": 14476.0,
      "end": 14478.0,
      "formatted_start": "04:01:16.000",
      "formatted_end": "04:01:18.000",
      "text": "دیوزیده سید"
    },
    {
      "id": 22,
      "start": 14478.0,
      "end": 14502.0,
      "formatted_start": "04:01:18.000",
      "formatted_end": "04:01:42.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 14502.0,
      "end": 14504.0,
      "formatted_start": "04:01:42.000",
      "formatted_end": "04:01:44.000",
      "text": "این ها ببین"
    },
    {
      "id": 24,
      "start": 14506.0,
      "end": 14508.0,
      "formatted_start": "04:01:46.000",
      "formatted_end": "04:01:48.000",
      "text": "این ها چی کار کرده؟"
    },
    {
      "id": 25,
      "start": 14510.0,
      "end": 14512.0,
      "formatted_start": "04:01:50.000",
      "formatted_end": "04:01:52.000",
      "text": "این خیلی مهمه"
    },
    {
      "id": 26,
      "start": 14512.0,
      "end": 14514.0,
      "formatted_start": "04:01:52.000",
      "formatted_end": "04:01:54.000",
      "text": "گذر سفراد"
    },
    {
      "id": 27,
      "start": 14516.0,
      "end": 14518.0,
      "formatted_start": "04:01:56.000",
      "formatted_end": "04:01:58.000",
      "text": "این کسی سفراد"
    },
    {
      "id": 28,
      "start": 14518.0,
      "end": 14520.0,
      "formatted_start": "04:01:58.000",
      "formatted_end": "04:02:00.000",
      "text": "گردنش سنگ داره"
    },
    {
      "id": 29,
      "start": 14520.0,
      "end": 14522.0,
      "formatted_start": "04:02:00.000",
      "formatted_end": "04:02:02.000",
      "text": "اون خیلی مهمه"
    },
    {
      "id": 30,
      "start": 14522.0,
      "end": 14524.0,
      "formatted_start": "04:02:02.000",
      "formatted_end": "04:02:04.000",
      "text": "اونو باید به گذر سفرادو برداریم"
    },
    {
      "id": 31,
      "start": 14524.0,
      "end": 14526.0,
      "formatted_start": "04:02:04.000",
      "formatted_end": "04:02:06.000",
      "text": "چون کچیه"
    },
    {
      "id": 32,
      "start": 14526.0,
      "end": 14528.0,
      "formatted_start": "04:02:06.000",
      "formatted_end": "04:02:08.000",
      "text": "و تو گردنش"
    },
    {
      "id": 33,
      "start": 14528.0,
      "end": 14530.0,
      "formatted_start": "04:02:08.000",
      "formatted_end": "04:02:10.000",
      "text": "ببین علیه میگفت مثلا"
    },
    {
      "id": 34,
      "start": 14530.0,
      "end": 14533.28,
      "formatted_start": "04:02:10.000",
      "formatted_end": "04:02:13.280",
      "text": "دو سانتر خیلی بهتره بود از اینکه شیش میلیمتره"
    },
    {
      "id": 35,
      "start": 14533.28,
      "end": 14536.76,
      "formatted_start": "04:02:13.280",
      "formatted_end": "04:02:16.760",
      "text": "بگی تو کیسته بود مشکل نامدارد تو تو گردنه"
    },
    {
      "id": 36,
      "start": 14536.76,
      "end": 14538.56,
      "formatted_start": "04:02:16.760",
      "formatted_end": "04:02:18.560",
      "text": "خیلی تعبادم میریجون"
    },
    {
      "id": 37,
      "start": 14538.56,
      "end": 14540.76,
      "formatted_start": "04:02:18.560",
      "formatted_end": "04:02:20.760",
      "text": "چه برامان خوانی دست نبود دارم"
    },
    {
      "id": 38,
      "start": 14540.76,
      "end": 14544.44,
      "formatted_start": "04:02:20.760",
      "formatted_end": "04:02:24.440",
      "text": "ممکنه اتقا خب بده به جای یه عمل دوتا بخواهی"
    },
    {
      "id": 39,
      "start": 14544.44,
      "end": 14546.4,
      "formatted_start": "04:02:24.440",
      "formatted_end": "04:02:26.400",
      "text": "الان هم اعتمادان دو تا دو همه نیست"
    },
    {
      "id": 40,
      "start": 14546.4,
      "end": 14550.12,
      "formatted_start": "04:02:26.400",
      "formatted_end": "04:02:30.120",
      "text": "خب از اینکه ببینیم که همه نیست"
    },
    {
      "id": 41,
      "start": 14550.12,
      "end": 14553.64,
      "formatted_start": "04:02:30.120",
      "formatted_end": "04:02:33.640",
      "text": "هلی بود بهمانه شدن و از اینکه داریم ما چیز درخواهیم"
    },
    {
      "id": 42,
      "start": 14553.64,
      "end": 14557.64,
      "formatted_start": "04:02:33.640",
      "formatted_end": "04:02:37.640",
      "text": "و یکی دو سال بعد من اون رو برد شدم"
    },
    {
      "id": 43,
      "start": 14557.64,
      "end": 14566.64,
      "formatted_start": "04:02:37.640",
      "formatted_end": "04:02:46.640",
      "text": "هر چیز سرد، خیلی پند، بیشتر سرد، ترشی، فلفل، گشت قرمز، سرخ گردن، چرب و چیلی"
    },
    {
      "id": 44,
      "start": 14566.64,
      "end": 14569.64,
      "formatted_start": "04:02:46.640",
      "formatted_end": "04:02:49.640",
      "text": "یه آزمایش ها خوب بوده و اگه اینجا اتحاد نداشته"
    },
    {
      "id": 45,
      "start": 14573.64,
      "end": 14575.64,
      "formatted_start": "04:02:53.640",
      "formatted_end": "04:02:55.640",
      "text": "نه محبت دارون نمی بینم چطور میشه"
    },
    {
      "id": 46,
      "start": 14575.64,
      "end": 14580.64,
      "formatted_start": "04:02:55.640",
      "formatted_end": "04:03:00.640",
      "text": "اگه الان میدید این تعبات و شکم، مده درد شدید شد سریع بیایی خب"
    },
    {
      "id": 47,
      "start": 14580.64,
      "end": 14587.4,
      "formatted_start": "04:03:00.640",
      "formatted_end": "04:03:07.400",
      "text": "خب بعد این تهران باید یه اوزپایر رو دیگه تا صبح تاولر داشتم و اینها"
    },
    {
      "id": 48,
      "start": 14587.4,
      "end": 14588.4,
      "formatted_start": "04:03:07.400",
      "formatted_end": "04:03:08.400",
      "text": "داشته؟"
    },
    {
      "id": 49,
      "start": 14588.4,
      "end": 14590.4,
      "formatted_start": "04:03:08.400",
      "formatted_end": "04:03:10.400",
      "text": "بله آره تاولر داشتم"
    },
    {
      "id": 50,
      "start": 14590.4,
      "end": 14592.2,
      "formatted_start": "04:03:10.400",
      "formatted_end": "04:03:12.200",
      "text": "بعد دیگه هم یادگارم هم رفتم"
    },
    {
      "id": 51,
      "start": 14592.2,
      "end": 14595.2,
      "formatted_start": "04:03:12.200",
      "formatted_end": "04:03:15.200",
      "text": "اینجا گفتم چه شروع پسید بودم چه خطبتی"
    },
    {
      "id": 52,
      "start": 14595.2,
      "end": 14597.4,
      "formatted_start": "04:03:15.200",
      "formatted_end": "04:03:17.400",
      "text": "رفتم یه دارو فقط نوشتم"
    },
    {
      "id": 53,
      "start": 14597.4,
      "end": 14600.88,
      "formatted_start": "04:03:17.400",
      "formatted_end": "04:03:20.880",
      "text": "رم دادم و اون تا بخشم و یه سرو اونو اونو اینکه پایی کردم"
    },
    {
      "id": 54,
      "start": 14600.88,
      "end": 14603.48,
      "formatted_start": "04:03:20.880",
      "formatted_end": "04:03:23.480",
      "text": "اون دارو هم پردیدی برم از این"
    },
    {
      "id": 55,
      "start": 14603.48,
      "end": 14607.0,
      "formatted_start": "04:03:23.480",
      "formatted_end": "04:03:27.000",
      "text": "بعد دیگه گفتم چه بخواهم برامش متخصص های اونکه میشون بدم"
    },
    {
      "id": 56,
      "start": 14607.0,
      "end": 14608.0,
      "formatted_start": "04:03:27.000",
      "formatted_end": "04:03:28.000",
      "text": "نه"
    },
    {
      "id": 57,
      "start": 14608.0,
      "end": 14610.0,
      "formatted_start": "04:03:28.000",
      "formatted_end": "04:03:30.000",
      "text": "کمی نیم خواد کنم"
    },
    {
      "id": 58,
      "start": 14610.0,
      "end": 14612.0,
      "formatted_start": "04:03:30.000",
      "formatted_end": "04:03:32.000",
      "text": "اینو نخورم؟"
    },
    {
      "id": 59,
      "start": 14614.0,
      "end": 14618.0,
      "formatted_start": "04:03:34.000",
      "formatted_end": "04:03:38.000",
      "text": "اون دوتون از چهارمه آنی به بخور درخواد شیر دیدن"
    },
    {
      "id": 60,
      "start": 14618.0,
      "end": 14619.0,
      "formatted_start": "04:03:38.000",
      "formatted_end": "04:03:39.000",
      "text": "مو هم خیلی میرزنده"
    },
    {
      "id": 61,
      "start": 14619.0,
      "end": 14621.0,
      "formatted_start": "04:03:39.000",
      "formatted_end": "04:03:41.000",
      "text": "چند وقت شیر میخواد؟"
    },
    {
      "id": 62,
      "start": 14621.0,
      "end": 14622.0,
      "formatted_start": "04:03:41.000",
      "formatted_end": "04:03:42.000",
      "text": "نه"
    },
    {
      "id": 63,
      "start": 14623.0,
      "end": 14626.0,
      "formatted_start": "04:03:43.000",
      "formatted_end": "04:03:46.000",
      "text": "تازه زن ما کردیم از دست تو"
    },
    {
      "id": 64,
      "start": 14627.0,
      "end": 14629.0,
      "formatted_start": "04:03:47.000",
      "formatted_end": "04:03:49.000",
      "text": "نه تا مانند تو بارداری تا میگرفتی"
    },
    {
      "id": 65,
      "start": 14629.0,
      "end": 14630.0,
      "formatted_start": "04:03:49.000",
      "formatted_end": "04:03:50.000",
      "text": "نه"
    },
    {
      "id": 66,
      "start": 14630.0,
      "end": 14631.0,
      "formatted_start": "04:03:50.000",
      "formatted_end": "04:03:51.000",
      "text": "نه خواستش میگفتیم"
    },
    {
      "id": 67,
      "start": 14631.0,
      "end": 14638.0,
      "formatted_start": "04:03:51.000",
      "formatted_end": "04:03:58.000",
      "text": "برس مترو باید بخوری خوب اول شیر بده بعد برس تو بخور"
    },
    {
      "id": 68,
      "start": 14638.0,
      "end": 14646.0,
      "formatted_start": "04:03:58.000",
      "formatted_end": "04:04:06.000",
      "text": "برس دوستی داریم خب اونو خود کن و سنگتو آف کن"
    },
    {
      "id": 69,
      "start": 14651.0,
      "end": 14652.0,
      "formatted_start": "04:04:11.000",
      "formatted_end": "04:04:12.000",
      "text": "بچهت بگیر"
    },
    {
      "id": 70,
      "start": 14652.0,
      "end": 14655.0,
      "formatted_start": "04:04:12.000",
      "formatted_end": "04:04:15.000",
      "text": "تا زبان که هم تبیر نمی بودم جمعی بزنم"
    },
    {
      "id": 71,
      "start": 14655.0,
      "end": 14657.0,
      "formatted_start": "04:04:15.000",
      "formatted_end": "04:04:17.000",
      "text": "حالا یه آبی بیا خورو جلب بیکن"
    },
    {
      "id": 72,
      "start": 14657.0,
      "end": 14659.0,
      "formatted_start": "04:04:17.000",
      "formatted_end": "04:04:19.000",
      "text": "این کاری"
    },
    {
      "id": 73,
      "start": 14659.0,
      "end": 14663.0,
      "formatted_start": "04:04:19.000",
      "formatted_end": "04:04:23.000",
      "text": "خدایی سر برای این بیشتر خود این گرسه هایی کم نفت بهتر میگذار"
    },
    {
      "id": 74,
      "start": 14663.0,
      "end": 14665.0,
      "formatted_start": "04:04:23.000",
      "formatted_end": "04:04:25.000",
      "text": "ناشته های میدن باید بخورید"
    },
    {
      "id": 75,
      "start": 14665.0,
      "end": 14667.0,
      "formatted_start": "04:04:25.000",
      "formatted_end": "04:04:27.000",
      "text": "به خاطر که حضمت رو تصحیف کنه"
    },
    {
      "id": 76,
      "start": 14667.0,
      "end": 14670.0,
      "formatted_start": "04:04:27.000",
      "formatted_end": "04:04:30.000",
      "text": "بعد تخمه ها مکارانی"
    },
    {
      "id": 77,
      "start": 14670.0,
      "end": 14673.0,
      "formatted_start": "04:04:30.000",
      "formatted_end": "04:04:33.000",
      "text": "چرب و چیلی به هیچ عنوان نخورید"
    },
    {
      "id": 78,
      "start": 14673.0,
      "end": 14676.0,
      "formatted_start": "04:04:33.000",
      "formatted_end": "04:04:36.000",
      "text": "من سنو تو تو برج پنج رفته"
    },
    {
      "id": 79,
      "start": 14676.0,
      "end": 14678.0,
      "formatted_start": "04:04:36.000",
      "formatted_end": "04:04:38.000",
      "text": "یه سنو میگمستم منو برای تو کسی صفرا"
    },
    {
      "id": 80,
      "start": 14678.0,
      "end": 14680.0,
      "formatted_start": "04:04:38.000",
      "formatted_end": "04:04:40.000",
      "text": "فقط کبره کسی صفرا"
    },
    {
      "id": 81,
      "start": 14680.0,
      "end": 14681.0,
      "formatted_start": "04:04:40.000",
      "formatted_end": "04:04:41.000",
      "text": "اینو"
    },
    {
      "id": 82,
      "start": 14681.0,
      "end": 14683.0,
      "formatted_start": "04:04:41.000",
      "formatted_end": "04:04:43.000",
      "text": "ای داده یه هفته هم نمیشه"
    },
    {
      "id": 83,
      "start": 14683.0,
      "end": 14685.0,
      "formatted_start": "04:04:43.000",
      "formatted_end": "04:04:45.000",
      "text": "آره برمیگم"
    },
    {
      "id": 84,
      "start": 14685.0,
      "end": 14688.84,
      "formatted_start": "04:04:45.000",
      "formatted_end": "04:04:48.840",
      "text": "آخر برژ مثلا 28 تومین رو بری انجام بدی"
    },
    {
      "id": 85,
      "start": 14688.84,
      "end": 14689.24,
      "formatted_start": "04:04:48.840",
      "formatted_end": "04:04:49.240",
      "text": "همیشه"
    },
    {
      "id": 86,
      "start": 14689.24,
      "end": 14691.12,
      "formatted_start": "04:04:49.240",
      "formatted_end": "04:04:51.120",
      "text": "ببینم چی میشه"
    },
    {
      "id": 87,
      "start": 14691.12,
      "end": 14693.38,
      "formatted_start": "04:04:51.120",
      "formatted_end": "04:04:53.380",
      "text": "اگر خوب بود که شکر"
    },
    {
      "id": 88,
      "start": 14693.38,
      "end": 14695.92,
      "formatted_start": "04:04:53.380",
      "formatted_end": "04:04:55.920",
      "text": "بس سموت هم دکتر هستانی برون"
    },
    {
      "id": 89,
      "start": 14695.92,
      "end": 14697.82,
      "formatted_start": "04:04:55.920",
      "formatted_end": "04:04:57.820",
      "text": "باشه؟"
    },
    {
      "id": 90,
      "start": 14697.82,
      "end": 14699.98,
      "formatted_start": "04:04:57.820",
      "formatted_end": "04:04:59.980",
      "text": "اگر همین جوری باشه باید امرائی بشه"
    }
  ],
  "status": "completed"
}