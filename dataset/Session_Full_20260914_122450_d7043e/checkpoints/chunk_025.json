      "end": 7799.343,
      "formatted_start": "02:09:58.685",
      "formatted_end": "02:09:59.343",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7508.24,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:08.240",
      "text": "بله اختار نداد. برای من اختار نداد. چون وقتی موقعش نشد گوی وقتی اینجا که من سر بگم اختار میده. فعلا اختار نداد."
    },
    {
      "id": 1,
      "start": 7508.24,
      "end": 7508.96,
      "formatted_start": "02:05:08.240",
      "formatted_end": "02:05:08.960",
      "text": "ندارد."
    },
    {
      "id": 2,
      "start": 7508.96,
      "end": 7510.96,
      "formatted_start": "02:05:08.960",
      "formatted_end": "02:05:10.960",
      "text": "نه، فعلا همه رو تعیید کرد."
    },
    {
      "id": 3,
      "start": 7510.96,
      "end": 7512.96,
      "formatted_start": "02:05:10.960",
      "formatted_end": "02:05:12.960",
      "text": "نه، همه رو نشد."
    },
    {
      "id": 4,
      "start": 7512.96,
      "end": 7517.84,
      "formatted_start": "02:05:12.960",
      "formatted_end": "02:05:17.840",
      "text": "اینه همه رو تعیید کرد. چیز دیگه لازم نرشد بابا جون؟"
    },
    {
      "id": 5,
      "start": 7517.84,
      "end": 7521.76,
      "formatted_start": "02:05:17.840",
      "formatted_end": "02:05:21.760",
      "text": "خب برای شعبت سینه دارد رو بگیرسی."
    },
    {
      "id": 6,
      "start": 7521.76,
      "end": 7524.76,
      "formatted_start": "02:05:21.760",
      "formatted_end": "02:05:24.760",
      "text": "همینه که روشکس سینه دارد، بلند آبی؟"
    },
    {
      "id": 7,
      "start": 7524.76,
      "end": 7526.76,
      "formatted_start": "02:05:24.760",
      "formatted_end": "02:05:26.760",
      "text": "از اینجا باید باید بسیار سرپرم بزنیم؟"
    },
    {
      "id": 8,
      "start": 7526.76,
      "end": 7528.76,
      "formatted_start": "02:05:26.760",
      "formatted_end": "02:05:28.760",
      "text": "آه، خب نه سرپرم بزنیم"
    },
    {
      "id": 9,
      "start": 7528.76,
      "end": 7530.76,
      "formatted_start": "02:05:28.760",
      "formatted_end": "02:05:30.760",
      "text": "آه نه بسیار همون زده سرپرم"
    },
    {
      "id": 10,
      "start": 7530.76,
      "end": 7532.76,
      "formatted_start": "02:05:30.760",
      "formatted_end": "02:05:32.760",
      "text": "باشه"
    },
    {
      "id": 11,
      "start": 7532.76,
      "end": 7534.76,
      "formatted_start": "02:05:32.760",
      "formatted_end": "02:05:34.760",
      "text": "دست در نگیرم، باید بیاییم اینجا لفترم"
    },
    {
      "id": 12,
      "start": 7534.76,
      "end": 7536.76,
      "formatted_start": "02:05:34.760",
      "formatted_end": "02:05:36.760",
      "text": "باید بگوید از خود کارم باید مسته و"
    },
    {
      "id": 13,
      "start": 7536.76,
      "end": 7538.76,
      "formatted_start": "02:05:36.760",
      "formatted_end": "02:05:38.760",
      "text": "باید بیاییم بخور درمو سر بیرم"
    },
    {
      "id": 14,
      "start": 7538.76,
      "end": 7540.76,
      "formatted_start": "02:05:38.760",
      "formatted_end": "02:05:40.760",
      "text": "باشه چشم، مرشد"
    },
    {
      "id": 15,
      "start": 7540.76,
      "end": 7542.76,
      "formatted_start": "02:05:40.760",
      "formatted_end": "02:05:42.760",
      "text": "دست در نگیرم"
    },
    {
      "id": 16,
      "start": 7544.76,
      "end": 7546.76,
      "formatted_start": "02:05:44.760",
      "formatted_end": "02:05:46.760",
      "text": "تقریبا شما"
    },
    {
      "id": 17,
      "start": 7546.76,
      "end": 7548.76,
      "formatted_start": "02:05:46.760",
      "formatted_end": "02:05:48.760",
      "text": "سلامت باشیم"
    },
    {
      "id": 18,
      "start": 7548.76,
      "end": 7550.76,
      "formatted_start": "02:05:48.760",
      "formatted_end": "02:05:50.760",
      "text": "تا تمام بابا"
    },
    {
      "id": 19,
      "start": 7550.76,
      "end": 7552.76,
      "formatted_start": "02:05:50.760",
      "formatted_end": "02:05:52.760",
      "text": "دست در دست"
    },
    {
      "id": 20,
      "start": 7552.76,
      "end": 7554.76,
      "formatted_start": "02:05:52.760",
      "formatted_end": "02:05:54.760",
      "text": "خداحافظ"
    },
    {
      "id": 21,
      "start": 7582.76,
      "end": 7612.76,
      "formatted_start": "02:06:22.760",
      "formatted_end": "02:06:52.760",
      "text": "خودتون را برای از این که در این وقت برای از این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای ا"
    },
    {
      "id": 22,
      "start": 7612.76,
      "end": 7642.76,
      "formatted_start": "02:06:52.760",
      "formatted_end": "02:07:22.760",
      "text": "در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا د"
    },
    {
      "id": 23,
      "start": 7642.76,
      "end": 7654.76,
      "formatted_start": "02:07:22.760",
      "formatted_end": "02:07:34.760",
      "text": "اگر دردتون داده زیاد میشه می آید چون ممکنه که اینا افونت کنه کیستا و به خاطر افونتش کجا راسی بزنن تا هشت سال شب می کنن"
    },
    {
      "id": 24,
      "start": 7654.76,
      "end": 7658.76,
      "formatted_start": "02:07:34.760",
      "formatted_end": "02:07:38.760",
      "text": "مگه اینکه دردش بی طاقت چه مجبور به عمل بشین؟"
    },
    {
      "id": 25,
      "start": 7658.76,
      "end": 7662.76,
      "formatted_start": "02:07:38.760",
      "formatted_end": "02:07:42.760",
      "text": "این مال باشه ده سال پیش همینطور همینطور"
    },
    {
      "id": 26,
      "start": 7662.76,
      "end": 7664.76,
      "formatted_start": "02:07:42.760",
      "formatted_end": "02:07:44.760",
      "text": "آره هست"
    },
    {
      "id": 27,
      "start": 7664.76,
      "end": 7666.76,
      "formatted_start": "02:07:44.760",
      "formatted_end": "02:07:46.760",
      "text": "حالا خدا شما زیاد هشت خوبه"
    },
    {
      "id": 28,
      "start": 7666.76,
      "end": 7670.76,
      "formatted_start": "02:07:46.760",
      "formatted_end": "02:07:50.760",
      "text": "درمان خواست نداره"
    },
    {
      "id": 29,
      "start": 7670.76,
      "end": 7673.76,
      "formatted_start": "02:07:50.760",
      "formatted_end": "02:07:53.760",
      "text": "نداره و بعد زیادم سخت نیست و کلان از این افراد"
    },
    {
      "id": 30,
      "start": 7673.76,
      "end": 7674.76,
      "formatted_start": "02:07:53.760",
      "formatted_end": "02:07:54.760",
      "text": "هیچ خطر نداره"
    },
    {
      "id": 31,
      "start": 7674.76,
      "end": 7676.76,
      "formatted_start": "02:07:54.760",
      "formatted_end": "02:07:56.760",
      "text": "ولی همین مودک بوده بعضی ما و از دوست ما"
    },
    {
      "id": 32,
      "start": 7676.76,
      "end": 7678.76,
      "formatted_start": "02:07:56.760",
      "formatted_end": "02:07:58.760",
      "text": "یه بار بسایی درددی که میگه"
    },
    {
      "id": 33,
      "start": 7678.76,
      "end": 7681.76,
      "formatted_start": "02:07:58.760",
      "formatted_end": "02:08:01.760",
      "text": "کافی یکم فوتوکار سنگیر میکنه فشار بگیرین"
    },
    {
      "id": 34,
      "start": 7681.76,
      "end": 7682.76,
      "formatted_start": "02:08:01.760",
      "formatted_end": "02:08:02.760",
      "text": "اون درد بگیرین"
    },
    {
      "id": 35,
      "start": 7682.76,
      "end": 7683.76,
      "formatted_start": "02:08:02.760",
      "formatted_end": "02:08:03.760",
      "text": "آهان"
    },
    {
      "id": 36,
      "start": 7684.76,
      "end": 7685.76,
      "formatted_start": "02:08:04.760",
      "formatted_end": "02:08:05.760",
      "text": "پرساتتونم خوبه"
    },
    {
      "id": 37,
      "start": 7685.76,
      "end": 7688.76,
      "formatted_start": "02:08:05.760",
      "formatted_end": "02:08:08.760",
      "text": "ادارتون راحت میاد؟ ادارتون خاصتش ایچی نداره؟"
    },
    {
      "id": 38,
      "start": 7688.76,
      "end": 7689.76,
      "formatted_start": "02:08:08.760",
      "formatted_end": "02:08:09.760",
      "text": "نه نه"
    },
    {
      "id": 39,
      "start": 7689.76,
      "end": 7690.76,
      "formatted_start": "02:08:09.760",
      "formatted_end": "02:08:10.760",
      "text": "بعد"
    },
    {
      "id": 40,
      "start": 7691.76,
      "end": 7692.76,
      "formatted_start": "02:08:11.760",
      "formatted_end": "02:08:12.760",
      "text": "پس ادارتون همه چی خوبه؟"
    },
    {
      "id": 41,
      "start": 7692.76,
      "end": 7693.76,
      "formatted_start": "02:08:12.760",
      "formatted_end": "02:08:13.760",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 7693.76,
      "end": 7694.76,
      "formatted_start": "02:08:13.760",
      "formatted_end": "02:08:14.760",
      "text": "هیچ"
    },
    {
      "id": 43,
      "start": 7694.76,
      "end": 7696.76,
      "formatted_start": "02:08:14.760",
      "formatted_end": "02:08:16.760",
      "text": "اینکه من قلیل روی ندارم"
    },
    {
      "id": 44,
      "start": 7696.76,
      "end": 7697.76,
      "formatted_start": "02:08:16.760",
      "formatted_end": "02:08:17.760",
      "text": "اونجوری"
    },
    {
      "id": 45,
      "start": 7697.76,
      "end": 7699.76,
      "formatted_start": "02:08:17.760",
      "formatted_end": "02:08:19.760",
      "text": "از این مشکل با اون مشکل برم"
    },
    {
      "id": 46,
      "start": 7699.76,
      "end": 7700.76,
      "formatted_start": "02:08:19.760",
      "formatted_end": "02:08:20.760",
      "text": "همه پیاده دیگیش"
    },
    {
      "id": 47,
      "start": 7700.76,
      "end": 7702.76,
      "formatted_start": "02:08:20.760",
      "formatted_end": "02:08:22.760",
      "text": "حتما توضیح این سر برم"
    },
    {
      "id": 48,
      "start": 7702.76,
      "end": 7704.76,
      "formatted_start": "02:08:22.760",
      "formatted_end": "02:08:24.760",
      "text": "سری قبلی آمدم تو من پیاده که رو آمدم"
    },
    {
      "id": 49,
      "start": 7704.76,
      "end": 7706.76,
      "formatted_start": "02:08:24.760",
      "formatted_end": "02:08:26.760",
      "text": "این ماشا درد نمی کنه"
    },
    {
      "id": 50,
      "start": 7706.76,
      "end": 7708.76,
      "formatted_start": "02:08:26.760",
      "formatted_end": "02:08:28.760",
      "text": "خسته میشه"
    },
    {
      "id": 51,
      "start": 7708.76,
      "end": 7710.76,
      "formatted_start": "02:08:28.760",
      "formatted_end": "02:08:30.760",
      "text": "من از این برم"
    },
    {
      "id": 52,
      "start": 7710.76,
      "end": 7712.76,
      "formatted_start": "02:08:30.760",
      "formatted_end": "02:08:32.760",
      "text": "آره خسته میشه"
    },
    {
      "id": 53,
      "start": 7712.76,
      "end": 7714.76,
      "formatted_start": "02:08:32.760",
      "formatted_end": "02:08:34.760",
      "text": "مثلا راه که دارم برم اینو خسته شده"
    },
    {
      "id": 54,
      "start": 7714.76,
      "end": 7716.76,
      "formatted_start": "02:08:34.760",
      "formatted_end": "02:08:36.760",
      "text": "خوب سر باقی رو چکم"
    },
    {
      "id": 55,
      "start": 7716.76,
      "end": 7718.76,
      "formatted_start": "02:08:36.760",
      "formatted_end": "02:08:38.760",
      "text": "من سر باقی برم"
    },
    {
      "id": 56,
      "start": 7718.76,
      "end": 7720.76,
      "formatted_start": "02:08:38.760",
      "formatted_end": "02:08:40.760",
      "text": "اینجوری دارم"
    },
    {
      "id": 57,
      "start": 7720.76,
      "end": 7722.76,
      "formatted_start": "02:08:40.760",
      "formatted_end": "02:08:42.760",
      "text": "اونجوری نه مثلا"
    },
    {
      "id": 58,
      "start": 7722.76,
      "end": 7729.64,
      "formatted_start": "02:08:42.760",
      "formatted_end": "02:08:49.640",
      "text": "من سر باقم ها برم با شاسه او اتومات دارم با این برم سرزنجی شیمون که خدرنام که من ازت مشکلات دارم"
    },
    {
      "id": 59,
      "start": 7729.64,
      "end": 7732.76,
      "formatted_start": "02:08:49.640",
      "formatted_end": "02:08:52.760",
      "text": "بعد با این برای پیاده همه دویستی متر برم سردم"
    },
    {
      "id": 60,
      "start": 7732.76,
      "end": 7734.76,
      "formatted_start": "02:08:52.760",
      "formatted_end": "02:08:54.760",
      "text": "همینه چون پیاده جنبیه"
    },
    {
      "id": 61,
      "start": 7734.76,
      "end": 7737.76,
      "formatted_start": "02:08:54.760",
      "formatted_end": "02:08:57.760",
      "text": "الان من میدونم که الان سریف هرگی هم همیشه تقییمی اینا برم نوشتیم"
    },
    {
      "id": 62,
      "start": 7737.76,
      "end": 7739.76,
      "formatted_start": "02:08:57.760",
      "formatted_end": "02:08:59.760",
      "text": "ناس برم دردن"
    },
    {
      "id": 63,
      "start": 7739.76,
      "end": 7742.76,
      "formatted_start": "02:08:59.760",
      "formatted_end": "02:09:02.760",
      "text": "الان بخواد یه دوری که مای سر آر بشیم در اون راه بشیم"
    },
    {
      "id": 64,
      "start": 7742.76,
      "end": 7746.42,
      "formatted_start": "02:09:02.760",
      "formatted_end": "02:09:06.420",
      "text": "که ویتامین هست به خاطر برای کلیتون خود"
    },
    {
      "id": 65,
      "start": 7746.42,
      "end": 7748.42,
      "formatted_start": "02:09:06.420",
      "formatted_end": "02:09:08.420",
      "text": "اونجور آسیب کلیتون میگیره"
    },
    {
      "id": 66,
      "start": 7748.42,
      "end": 7752.46,
      "formatted_start": "02:09:08.420",
      "formatted_end": "02:09:12.460",
      "text": "چون کلیتون همه از آسیبه"
    },
    {
      "id": 67,
      "start": 7752.46,
      "end": 7755.46,
      "formatted_start": "02:09:12.460",
      "formatted_end": "02:09:15.460",
      "text": "نه نه اینو تمرین کنید"
    },
    {
      "id": 68,
      "start": 7755.46,
      "end": 7759.46,
      "formatted_start": "02:09:15.460",
      "formatted_end": "02:09:19.460",
      "text": "چون میشن بیمار نیمیخورد و از این وقت نوسر رو همگیزونه بکنن"
    },
    {
      "id": 69,
      "start": 7759.46,
      "end": 7763.46,
      "formatted_start": "02:09:19.460",
      "formatted_end": "02:09:23.460",
      "text": "من کاملاتوری همپوزورس رو میشنیم چند سال دارم استفاده میکنم"
    },
    {
      "id": 70,
      "start": 7763.46,
      "end": 7765.46,
      "formatted_start": "02:09:23.460",
      "formatted_end": "02:09:25.460",
      "text": "نه دارین الان"
    },
    {
      "id": 71,
      "start": 7765.46,
      "end": 7768.46,
      "formatted_start": "02:09:25.460",
      "formatted_end": "02:09:28.460",
      "text": "نه دیگه بکنیم در کنون راستان میشنم"
    },
    {
      "id": 72,
      "start": 7768.46,
      "end": 7798.46,
