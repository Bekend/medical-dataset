      "formatted_start": "05:26:04.000",
      "formatted_end": "05:26:06.000",
      "text": "منم بود دیگه آزاد رفتم خریدم"
    },
    {
      "id": 5,
      "start": 19566.0,
      "end": 19568.0,
      "formatted_start": "05:26:06.000",
      "formatted_end": "05:26:08.000",
      "text": "آره، آزاد خریدم"
    },
    {
      "id": 6,
      "start": 19568.0,
      "end": 19570.0,
      "formatted_start": "05:26:08.000",
      "formatted_end": "05:26:10.000",
      "text": "هم اون سه برگوی که برام نمیشتی"
    },
    {
      "id": 7,
      "start": 19570.0,
      "end": 19572.0,
      "formatted_start": "05:26:10.000",
      "formatted_end": "05:26:12.000",
      "text": "بعد"
    },
    {
      "id": 8,
      "start": 19572.0,
      "end": 19574.0,
      "formatted_start": "05:26:12.000",
      "formatted_end": "05:26:14.000",
      "text": "محتمالاً دکرار کشه"
    },
    {
      "id": 9,
      "start": 19574.0,
      "end": 19576.0,
      "formatted_start": "05:26:14.000",
      "formatted_end": "05:26:16.000",
      "text": "که برام هم تعیید کنه، هم دارو برام بگویم"
    },
    {
      "id": 10,
      "start": 19576.0,
      "end": 19578.0,
      "formatted_start": "05:26:16.000",
      "formatted_end": "05:26:18.000",
      "text": "بگویم دیگه"
    },
    {
      "id": 11,
      "start": 19578.0,
      "end": 19580.0,
      "formatted_start": "05:26:18.000",
      "formatted_end": "05:26:20.000",
      "text": "مردم از همه، الان داریم اون آزما شکل"
    },
    {
      "id": 12,
      "start": 19580.0,
      "end": 19582.0,
      "formatted_start": "05:26:20.000",
      "formatted_end": "05:26:22.000",
      "text": "نه؟ جهان"
    },
    {
      "id": 13,
      "start": 19582.0,
      "end": 19584.0,
      "formatted_start": "05:26:22.000",
      "formatted_end": "05:26:24.000",
      "text": "آزما شکل رو تنها بردم، لازم بود؟"
    },
    {
      "id": 14,
      "start": 19584.0,
      "end": 19586.0,
      "formatted_start": "05:26:24.000",
      "formatted_end": "05:26:26.000",
      "text": "نه، آره، آره، آره"
    },
    {
      "id": 15,
      "start": 19586.0,
      "end": 19589.0,
      "formatted_start": "05:26:26.000",
      "formatted_end": "05:26:29.000",
      "text": "با اون برگرد و باز ما تو پرونت رو بزاریم"
    },
    {
      "id": 16,
      "start": 19589.0,
      "end": 19590.0,
      "formatted_start": "05:26:29.000",
      "formatted_end": "05:26:30.000",
      "text": "آره عزیز در"
    },
    {
      "id": 17,
      "start": 19590.0,
      "end": 19592.0,
      "formatted_start": "05:26:30.000",
      "formatted_end": "05:26:32.000",
      "text": "بس همون من ناشته و دو ساعت ها رو"
    },
    {
      "id": 18,
      "start": 19592.0,
      "end": 19594.0,
      "formatted_start": "05:26:32.000",
      "formatted_end": "05:26:34.000",
      "text": "باز دوباره همجورو بگیرم"
    },
    {
      "id": 19,
      "start": 19594.0,
      "end": 19595.0,
      "formatted_start": "05:26:34.000",
      "formatted_end": "05:26:35.000",
      "text": "آره"
    },
    {
      "id": 20,
      "start": 19595.0,
      "end": 19597.0,
      "formatted_start": "05:26:35.000",
      "formatted_end": "05:26:37.000",
      "text": "باید تکرار بشه"
    },
    {
      "id": 21,
      "start": 19597.0,
      "end": 19599.0,
      "formatted_start": "05:26:37.000",
      "formatted_end": "05:26:39.000",
      "text": "دیما میده، دیمایی دیگه یک بار میخوام"
    },
    {
      "id": 22,
      "start": 19599.0,
      "end": 19600.0,
      "formatted_start": "05:26:39.000",
      "formatted_end": "05:26:40.000",
      "text": "خب"
    },
    {
      "id": 23,
      "start": 19600.0,
      "end": 19601.0,
      "formatted_start": "05:26:40.000",
      "formatted_end": "05:26:41.000",
      "text": "اینا دوبار میخوام"
    },
    {
      "id": 24,
      "start": 19601.0,
      "end": 19604.0,
      "formatted_start": "05:26:41.000",
      "formatted_end": "05:26:44.000",
      "text": "خب عزیز این برای چیزشی"
    },
    {
      "id": 25,
      "start": 19604.0,
      "end": 19605.0,
      "formatted_start": "05:26:44.000",
      "formatted_end": "05:26:45.000",
      "text": "دفع پروتینم لازم نیست؟"
    },
    {
      "id": 26,
      "start": 19605.0,
      "end": 19607.0,
      "formatted_start": "05:26:45.000",
      "formatted_end": "05:26:47.000",
      "text": "همون با دوباره بگیرم یا نه بزار باشه"
    },
    {
      "id": 27,
      "start": 19607.0,
      "end": 19609.0,
      "formatted_start": "05:26:47.000",
      "formatted_end": "05:26:49.000",
      "text": "سه ماه زمان بره تا خوب شید"
    },
    {
      "id": 28,
      "start": 19609.0,
      "end": 19613.0,
      "formatted_start": "05:26:49.000",
      "formatted_end": "05:26:53.000",
      "text": "از زود تر سه ماه آزمایش دادم برسته بسپارت میکنم"
    },
    {
      "id": 29,
      "start": 19613.0,
      "end": 19617.0,
      "formatted_start": "05:26:53.000",
      "formatted_end": "05:26:57.000",
      "text": "بخاطر اینکه من مجاور لوکومیا هر ماه برم آزمایش برم"
    },
    {
      "id": 30,
      "start": 19617.0,
      "end": 19619.0,
      "formatted_start": "05:26:57.000",
      "formatted_end": "05:26:59.000",
      "text": "نه نه نویستش"
    },
    {
      "id": 31,
      "start": 19619.0,
      "end": 19622.0,
      "formatted_start": "05:26:59.000",
      "formatted_end": "05:27:02.000",
      "text": "من که چیزی دیگه که ندارد خانم درگاه دارم"
    },
    {
      "id": 32,
      "start": 19622.0,
      "end": 19624.0,
      "formatted_start": "05:27:02.000",
      "formatted_end": "05:27:04.000",
      "text": "همین دوتا دارو رو دادم"
    },
    {
      "id": 33,
      "start": 19624.0,
      "end": 19626.0,
      "formatted_start": "05:27:04.000",
      "formatted_end": "05:27:06.000",
      "text": "هر وقت میرفتم همین دوتا دارم"
    },
    {
      "id": 34,
      "start": 19626.0,
      "end": 19630.0,
      "formatted_start": "05:27:06.000",
      "formatted_end": "05:27:10.000",
      "text": "هر شب الان از روز که پیشی کنم آدم هر شب میخورم از این"
    },
    {
      "id": 35,
      "start": 19630.0,
      "end": 19634.0,
      "formatted_start": "05:27:10.000",
      "formatted_end": "05:27:14.000",
      "text": "فردا که بیانیم برام بینویسی که تمام شده"
    },
    {
      "id": 36,
      "start": 19634.0,
      "end": 19637.0,
      "formatted_start": "05:27:14.000",
      "formatted_end": "05:27:17.000",
      "text": "دیگه میان دارو دیگه نداره"
    },
    {
      "id": 37,
      "start": 19639.0,
      "end": 19645.0,
      "formatted_start": "05:27:19.000",
      "formatted_end": "05:27:25.000",
      "text": "یک دارو جدید اومده، خب بزرگم بگیر یک میکرو آلبومین رو فریم نمیشه قدر بیمنیست در اون دارو"
    },
    {
      "id": 38,
      "start": 19645.0,
      "end": 19651.0,
      "formatted_start": "05:27:25.000",
      "formatted_end": "05:27:31.000",
      "text": "یک دارو جدید اومده، سیرتاش حدود یکم خورده میشه، برای رفت بروتنی"
    },
    {
      "id": 39,
      "start": 19651.0,
      "end": 19656.0,
      "formatted_start": "05:27:31.000",
      "formatted_end": "05:27:36.000",
      "text": "تازه باید دارید آنش، مثلا یک شرکت عویدی داره میزنش تازه"
    },
    {
      "id": 40,
      "start": 19656.0,
      "end": 19663.0,
      "formatted_start": "05:27:36.000",
      "formatted_end": "05:27:43.000",
      "text": "باید بیمن نشد و تاییدی افتیه داره، برای اینه اون خیلی عادی داره رفت بروتنی جاوی"
    },
    {
      "id": 41,
      "start": 19663.0,
      "end": 19665.0,
      "formatted_start": "05:27:43.000",
      "formatted_end": "05:27:45.000",
      "text": "پس از این داره نمیخواد نفرد"
    },
    {
      "id": 42,
      "start": 19665.0,
      "end": 19667.0,
      "formatted_start": "05:27:45.000",
      "formatted_end": "05:27:47.000",
      "text": "پس اینها رو من استفاده میکنم"
    },
    {
      "id": 43,
      "start": 19667.0,
      "end": 19669.0,
      "formatted_start": "05:27:47.000",
      "formatted_end": "05:27:49.000",
      "text": "آزمایش میدم"
    },
    {
      "id": 44,
      "start": 19669.0,
      "end": 19671.0,
      "formatted_start": "05:27:49.000",
      "formatted_end": "05:27:51.000",
      "text": "اگه پایین نیومد باید برم"
    },
    {
      "id": 45,
      "start": 19671.0,
      "end": 19673.0,
      "formatted_start": "05:27:51.000",
      "formatted_end": "05:27:53.000",
      "text": "بس الان آزما شدیم"
    },
    {
      "id": 46,
      "start": 19673.0,
      "end": 19675.0,
      "formatted_start": "05:27:53.000",
      "formatted_end": "05:27:55.000",
      "text": "این رو مفتاده خانم دکتر"
    },
    {
      "id": 47,
      "start": 19675.0,
      "end": 19677.0,
      "formatted_start": "05:27:55.000",
      "formatted_end": "05:27:57.000",
      "text": "این غارسه که اول دکتر مجلو بذاره"
    },
    {
      "id": 48,
      "start": 19677.0,
      "end": 19679.0,
      "formatted_start": "05:27:57.000",
      "formatted_end": "05:27:59.000",
      "text": "اصلا ما همین جنوب بندیم"
    },
    {
      "id": 49,
      "start": 19679.0,
      "end": 19681.0,
      "formatted_start": "05:27:59.000",
      "formatted_end": "05:28:01.000",
      "text": "از روز سه هزار"
    },
    {
      "id": 50,
      "start": 19681.0,
      "end": 19683.0,
      "formatted_start": "05:28:01.000",
      "formatted_end": "05:28:03.000",
      "text": "سه هزار هفتصد بوده"
    },
    {
      "id": 51,
      "start": 19683.0,
      "end": 19685.0,
      "formatted_start": "05:28:03.000",
      "formatted_end": "05:28:05.000",
      "text": "اومده روز"
    },
    {
      "id": 52,
      "start": 19685.0,
      "end": 19687.0,
      "formatted_start": "05:28:05.000",
      "formatted_end": "05:28:07.000",
      "text": "دویست اومده با این غارس برام"
    },
    {
      "id": 53,
      "start": 19687.0,
      "end": 19689.0,
      "formatted_start": "05:28:07.000",
      "formatted_end": "05:28:09.000",
      "text": "ولی ایها نمیدونم باز این دار چرا"
    },
    {
      "id": 54,
      "start": 19689.0,
      "end": 19692.0,
      "formatted_start": "05:28:09.000",
      "formatted_end": "05:28:12.000",
      "text": "هزار چرا اینجوری شد هزار و رفت بالا اینو نمیدونم دیگه"
    },
    {
      "id": 55,
      "start": 19692.0,
      "end": 19698.0,
      "formatted_start": "05:28:12.000",
      "formatted_end": "05:28:18.000",
      "text": "این مقداری خانم بکنیم در اینجوری کلیه ها و اینجوری از همین میده و روده این وراغ"
    },
    {
      "id": 56,
      "start": 19698.0,
      "end": 19701.0,
      "formatted_start": "05:28:18.000",
      "formatted_end": "05:28:21.000",
      "text": "این مقداری باید عرضیت می کنیم نمیدونیم که چی اینو بکنیم"
    },
    {
      "id": 57,
      "start": 19701.0,
      "end": 19702.0,
      "formatted_start": "05:28:21.000",
      "formatted_end": "05:28:22.000",
      "text": "چی میشه؟"
    },
    {
      "id": 58,
      "start": 19702.0,
      "end": 19706.0,
      "formatted_start": "05:28:22.000",
      "formatted_end": "05:28:26.000",
      "text": "عرضیت هم می کنیم، اینو بکنیم، این روده یک کلیه اینو بکنیم"
    },
    {
      "id": 59,
      "start": 19706.0,
      "end": 19707.0,
      "formatted_start": "05:28:26.000",
      "formatted_end": "05:28:27.000",
      "text": "این کلیه خالی هست؟"
    },
    {
      "id": 60,
      "start": 19707.0,
      "end": 19708.0,
      "formatted_start": "05:28:27.000",
      "formatted_end": "05:28:28.000",
      "text": "اینو بکنیم"
    },
    {
      "id": 61,
      "start": 19708.0,
      "end": 19710.0,
      "formatted_start": "05:28:28.000",
      "formatted_end": "05:28:30.000",
      "text": "به پردنو درد میگن؟"
    },
    {
      "id": 62,
      "start": 19710.0,
      "end": 19712.5,
      "formatted_start": "05:28:30.000",
      "formatted_end": "05:28:32.500",
      "text": "آره یه مقداری دیگر مانده"
    },
    {
      "id": 63,
      "start": 19712.5,
      "end": 19714.5,
      "formatted_start": "05:28:32.500",
      "formatted_end": "05:28:34.500",
      "text": "مخموخ درد داره"
    },
    {
      "id": 64,
      "start": 19716.5,
      "end": 19718.5,
      "formatted_start": "05:28:36.500",
      "formatted_end": "05:28:38.500",
      "text": "اینجا میتونستم درد داریم؟"
    },
    {
      "id": 65,
      "start": 19718.5,
      "end": 19719.0,
      "formatted_start": "05:28:38.500",
      "formatted_end": "05:28:39.000",
      "text": "نه"
    },
    {
      "id": 66,
      "start": 19719.0,
      "end": 19721.5,
      "formatted_start": "05:28:39.000",
      "formatted_end": "05:28:41.500",
      "text": "سابقه سنگ کلیه کست کلیه نداشتی؟"
    },
    {
      "id": 67,
      "start": 19721.5,
      "end": 19724.5,
      "formatted_start": "05:28:41.500",
      "formatted_end": "05:28:44.500",
      "text": "سنگ داشتم دفعه کنم آدم پیشه دوتا قبر به من داریم"
    },
    {
      "id": 68,
      "start": 19724.5,
      "end": 19727.5,
      "formatted_start": "05:28:44.500",
      "formatted_end": "05:28:47.500",
      "text": "خب از اینجا آدم دوباره بازو سنگی ساخته"
    },
    {
      "id": 69,
      "start": 19727.5,
      "end": 19729.5,
      "formatted_start": "05:28:47.500",
      "formatted_end": "05:28:49.500",
      "text": "نه دیگه دار تازه گرفته هم"
    },
    {
      "id": 70,
      "start": 19729.5,
      "end": 19731.5,
      "formatted_start": "05:28:49.500",
      "formatted_end": "05:28:51.500",
      "text": "خب اون همینوز که ده باره میره"
    },
    {
      "id": 71,
      "start": 19731.5,
      "end": 19733.5,
      "formatted_start": "05:28:51.500",
      "formatted_end": "05:28:53.500",
      "text": "نه همین آزما شویده چیز جاوب نداده"
    },
    {
      "id": 72,
      "start": 19733.5,
      "end": 19734.5,
      "formatted_start": "05:28:53.500",
      "formatted_end": "05:28:54.500",
      "text": "دیگه آزما شویده کشید نباده"
    },
    {
      "id": 73,
      "start": 19740.0,
      "end": 19745.0,
      "formatted_start": "05:29:00.000",
      "formatted_end": "05:29:05.000",
      "text": "این بغلا باید ادرارم رو هم نکنم"
    },
    {
      "id": 74,
      "start": 19745.0,
      "end": 19749.0,
      "formatted_start": "05:29:05.000",
      "formatted_end": "05:29:09.000",
      "text": "بازم زود به زود اینو نگه ندارم"
    },
    {
      "id": 75,
      "start": 19749.0,
      "end": 19753.0,
      "formatted_start": "05:29:09.000",
      "formatted_end": "05:29:13.000",
      "text": "بو هم میده"
    },
    {
      "id": 76,
      "start": 19753.0,
      "end": 19757.0,
      "formatted_start": "05:29:13.000",
      "formatted_end": "05:29:17.000",
      "text": "این بغلا یه مقدار شاید"
    },
    {
      "id": 77,
      "start": 19757.0,
      "end": 19761.0,
      "formatted_start": "05:29:17.000",
      "formatted_end": "05:29:21.000",
      "text": "یه مقداری دارم خانم باشم"
    },
    {
      "id": 78,
      "start": 19761.0,
      "end": 19765.0,
      "formatted_start": "05:29:21.000",
      "formatted_end": "05:29:25.000",
      "text": "از پرساتونو الان نگیریم تا"
    },
    {
      "id": 79,
      "start": 19765.0,
      "end": 19768.0,
      "formatted_start": "05:29:25.000",
      "formatted_end": "05:29:28.000",
      "text": "پرس تیرایدتونو"
    },
    {
      "id": 80,
      "start": 19768.0,
      "end": 19771.5,
      "formatted_start": "05:29:28.000",
      "formatted_end": "05:29:31.500",
      "text": "مرتب مصرف کردن. دیگه آزمایشو که بیارن برام دارو بنویسیم."
    },
    {
      "id": 81,
      "start": 19771.5,
      "end": 19773.5,
      "formatted_start": "05:29:31.500",
      "formatted_end": "05:29:33.500",
      "text": "حالا این دارون فیلن نمیشه چیز."
    },
    {
      "id": 82,
      "start": 19773.5,
      "end": 19775.5,
      "formatted_start": "05:29:33.500",
      "formatted_end": "05:29:35.500",
