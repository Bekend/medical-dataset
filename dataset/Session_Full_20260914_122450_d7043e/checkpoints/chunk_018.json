  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5402.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:02.000",
      "text": "یا پرکار یا جنگ کار میشه."
    },
    {
      "id": 1,
      "start": 5402.0,
      "end": 5405.0,
      "formatted_start": "01:30:02.000",
      "formatted_end": "01:30:05.000",
      "text": "بعد خواب و زندگی به هم بخورید."
    },
    {
      "id": 2,
      "start": 5405.0,
      "end": 5414.0,
      "formatted_start": "01:30:05.000",
      "formatted_end": "01:30:14.000",
      "text": "کلم، کاهو، ترو، تروکچه، سویا، شرغم، لبو نموید بخورید."
    },
    {
      "id": 3,
      "start": 5414.0,
      "end": 5415.0,
      "formatted_start": "01:30:14.000",
      "formatted_end": "01:30:15.000",
      "text": "خوب؟"
    },
    {
      "id": 4,
      "start": 5415.0,
      "end": 5416.0,
      "formatted_start": "01:30:15.000",
      "formatted_end": "01:30:16.000",
      "text": "چه؟ جمعه بخورید."
    },
    {
      "id": 5,
      "start": 5416.0,
      "end": 5419.0,
      "formatted_start": "01:30:16.000",
      "formatted_end": "01:30:19.000",
      "text": "یه دو سایتون باز که من تیرویتتون نمیدونم."
    },
    {
      "id": 6,
      "start": 5419.0,
      "end": 5424.0,
      "formatted_start": "01:30:19.000",
      "formatted_end": "01:30:24.000",
      "text": "خوب، سایزش به خوبه، به لحظه که خود یک چیز نرده شده شده."
    },
    {
      "id": 7,
      "start": 5424.0,
      "end": 5426.0,
      "formatted_start": "01:30:24.000",
      "formatted_end": "01:30:26.000",
      "text": "سایتون خواب کنید، لطفاً برخشین."
    },
    {
      "id": 8,
      "start": 5426.0,
      "end": 5429.0,
      "formatted_start": "01:30:26.000",
      "formatted_end": "01:30:29.000",
      "text": "آدمتون رو خود برده ندارید."
    },
    {
      "id": 9,
      "start": 5429.0,
      "end": 5437.0,
      "formatted_start": "01:30:29.000",
      "formatted_end": "01:30:37.000",
      "text": "سرزش هم خوبه. یعنی یک تروجین یکم سفتی که به خاطر قدر جنیتیکی هایی که دارید اصلا مشکل ندارید."
    },
    {
      "id": 10,
      "start": 5437.0,
      "end": 5446.0,
      "formatted_start": "01:30:37.000",
      "formatted_end": "01:30:46.000",
      "text": "شما به صورت روتین هر شش ماه تیرویدتون رو چک کنید. حتما به پی این وقت بگیرید چون به قول خودتون یه دفعه از دست میره."
    },
    {
      "id": 11,
      "start": 5446.0,
      "end": 5452.0,
      "formatted_start": "01:30:46.000",
      "formatted_end": "01:30:52.000",
      "text": "بعد میتونیم سر کنیم. یعنی مثلا بعض وقتا شاید دکتر دارو هم نمیداد خوب میشدی."
    },
    {
      "id": 12,
      "start": 5452.0,
      "end": 5457.0,
      "formatted_start": "01:30:52.000",
      "formatted_end": "01:30:57.000",
      "text": "خب چون سابقه اینجوری داشتین آقای دکتور بهتون دانو دادن"
    },
    {
      "id": 13,
      "start": 5457.0,
      "end": 5461.0,
      "formatted_start": "01:30:57.000",
      "formatted_end": "01:31:01.000",
      "text": "فعلا هیچ درمانه داروی نمیخواد دوریت همین"
    },
    {
      "id": 14,
      "start": 5461.0,
      "end": 5468.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:08.000",
      "text": "دست شما در مدت در اینجور مدت دست میکن همون همصمان که میگن فارس سال ها"
    },
    {
      "id": 15,
      "start": 5468.0,
      "end": 5474.0,
      "formatted_start": "01:31:08.000",
      "formatted_end": "01:31:14.000",
      "text": "بعد من فرستادم گفت که کیز اصطفاد اعتمالا مثلا یه چیزی داره که اینجور اینجوره"
    },
    {
      "id": 16,
      "start": 5474.0,
      "end": 5504.0,
      "formatted_start": "01:31:14.000",
      "formatted_end": "01:31:44.000",
      "text": "از اینجا برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر برخیر بر"
    },
    {
      "id": 17,
      "start": 5504.0,
      "end": 5506.0,
      "formatted_start": "01:31:44.000",
      "formatted_end": "01:31:46.000",
      "text": "این هم خوبه"
    },
    {
      "id": 18,
      "start": 5506.0,
      "end": 5508.0,
      "formatted_start": "01:31:46.000",
      "formatted_end": "01:31:48.000",
      "text": "اگر برام خوبه که برام همینجا"
    },
    {
      "id": 19,
      "start": 5508.0,
      "end": 5510.0,
      "formatted_start": "01:31:48.000",
      "formatted_end": "01:31:50.000",
      "text": "اگر خوبه که شما بگیر"
    },
    {
      "id": 20,
      "start": 5510.0,
      "end": 5512.0,
      "formatted_start": "01:31:50.000",
      "formatted_end": "01:31:52.000",
      "text": "برام خوبه"
    },
    {
      "id": 21,
      "start": 5512.0,
      "end": 5514.0,
      "formatted_start": "01:31:52.000",
      "formatted_end": "01:31:54.000",
      "text": "الان تازه جدیده"
    },
    {
      "id": 22,
      "start": 5514.0,
      "end": 5516.0,
      "formatted_start": "01:31:54.000",
      "formatted_end": "01:31:56.000",
      "text": "من که رفتم"
    },
    {
      "id": 23,
      "start": 5516.0,
      "end": 5518.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:31:58.000",
      "text": "از قهوه تا تیزم اکت گرفتم"
    },
    {
      "id": 24,
      "start": 5518.0,
      "end": 5520.0,
      "formatted_start": "01:31:58.000",
      "formatted_end": "01:32:00.000",
      "text": "خب میدونیم برای همه قهوه و ریه و همه چی"
    },
    {
      "id": 25,
      "start": 5520.0,
      "end": 5522.0,
      "formatted_start": "01:32:00.000",
      "formatted_end": "01:32:02.000",
      "text": "آدماش و نمیدونم"
    },
    {
      "id": 26,
      "start": 5522.0,
      "end": 5524.0,
      "formatted_start": "01:32:02.000",
      "formatted_end": "01:32:04.000",
      "text": "اصلا آدماشش چی بود"
    },
    {
      "id": 27,
      "start": 5524.0,
      "end": 5526.0,
      "formatted_start": "01:32:04.000",
      "formatted_end": "01:32:06.000",
      "text": "بفرامون"
    },
    {
      "id": 28,
      "start": 5526.0,
      "end": 5528.0,
      "formatted_start": "01:32:06.000",
      "formatted_end": "01:32:08.000",
      "text": "همه چی نمیدونم"
    },
    {
      "id": 29,
      "start": 5528.0,
      "end": 5530.0,
      "formatted_start": "01:32:08.000",
      "formatted_end": "01:32:10.000",
      "text": "الان من خودم از شعبه تبعید قهوه بزنم"
    },
    {
      "id": 30,
      "start": 5530.0,
      "end": 5532.0,
      "formatted_start": "01:32:10.000",
      "formatted_end": "01:32:12.000",
      "text": "در صورت گذرم رفتم"
    },
    {
      "id": 31,
      "start": 5532.0,
      "end": 5535.46,
      "formatted_start": "01:32:12.000",
      "formatted_end": "01:32:15.460",
      "text": "هم نوار قلب گفت هم اکو کرد دکتر قلب"
    },
    {
      "id": 32,
      "start": 5535.46,
      "end": 5536.8,
      "formatted_start": "01:32:15.460",
      "formatted_end": "01:32:16.800",
      "text": "و گفت هیچی هم نیده"
    },
    {
      "id": 33,
      "start": 5536.8,
      "end": 5539.7,
      "formatted_start": "01:32:16.800",
      "formatted_end": "01:32:19.700",
      "text": "الان خودم از شب مخوابم مقدار کم"
    },
    {
      "id": 34,
      "start": 5539.7,
      "end": 5541.9,
      "formatted_start": "01:32:19.700",
      "formatted_end": "01:32:21.900",
      "text": "یکم سوزش مده بیده"
    },
    {
      "id": 35,
      "start": 5541.9,
      "end": 5542.64,
      "formatted_start": "01:32:21.900",
      "formatted_end": "01:32:22.640",
      "text": "یکم"
    },
    {
      "id": 36,
      "start": 5542.64,
      "end": 5544.0,
      "formatted_start": "01:32:22.640",
      "formatted_end": "01:32:24.000",
      "text": "و بعد خورس مده میخوری؟"
    },
    {
      "id": 37,
      "start": 5544.0,
      "end": 5545.3,
      "formatted_start": "01:32:24.000",
      "formatted_end": "01:32:25.300",
      "text": "جنب دارم دیگه"
    },
    {
      "id": 38,
      "start": 5545.3,
      "end": 5546.9,
      "formatted_start": "01:32:25.300",
      "formatted_end": "01:32:26.900",
      "text": "شبها یه فاموتیدین بخوری؟"
    },
    {
      "id": 39,
      "start": 5546.9,
      "end": 5547.84,
      "formatted_start": "01:32:26.900",
      "formatted_end": "01:32:27.840",
      "text": "فاموتیدین بخوریم"
    },
    {
      "id": 40,
      "start": 5547.84,
      "end": 5548.34,
      "formatted_start": "01:32:27.840",
      "formatted_end": "01:32:28.340",
      "text": "آره"
    },
    {
      "id": 41,
      "start": 5548.34,
      "end": 5551.54,
      "formatted_start": "01:32:28.340",
      "formatted_end": "01:32:31.540",
      "text": "و بعد اون اسپروب به بعد تبشه قلب میگیری؟"
    },
    {
      "id": 42,
      "start": 5551.54,
      "end": 5553.76,
      "formatted_start": "01:32:31.540",
      "formatted_end": "01:32:33.760",
      "text": "آره هم وقتی مخوابم خیلی اضافه شده"
    },
    {
      "id": 43,
      "start": 5553.76,
      "end": 5555.82,
      "formatted_start": "01:32:33.760",
      "formatted_end": "01:32:35.820",
      "text": "یه خورس نصف بهتران بخوری"
    },
    {
      "id": 44,
      "start": 5555.82,
      "end": 5560.58,
      "formatted_start": "01:32:35.820",
      "formatted_end": "01:32:40.580",
      "text": "چون که الان اماره هشتاد و پنجتاست، یکم ضربانتون باداتر هستید"
    },
    {
      "id": 45,
      "start": 5560.58,
      "end": 5561.58,
      "formatted_start": "01:32:40.580",
      "formatted_end": "01:32:41.580",
      "text": "خب؟"
    },
    {
      "id": 46,
      "start": 5561.58,
      "end": 5562.58,
      "formatted_start": "01:32:41.580",
      "formatted_end": "01:32:42.580",
      "text": "جنبه را"
    },
    {
      "id": 47,
      "start": 5562.58,
      "end": 5564.58,
      "formatted_start": "01:32:42.580",
      "formatted_end": "01:32:44.580",
      "text": "برام برس دارو دادم"
    },
    {
      "id": 48,
      "start": 5564.58,
      "end": 5567.58,
      "formatted_start": "01:32:44.580",
      "formatted_end": "01:32:47.580",
      "text": "این همین، این دارو اینه، به همین داده بود"
    },
    {
      "id": 49,
      "start": 5567.58,
      "end": 5568.58,
      "formatted_start": "01:32:47.580",
      "formatted_end": "01:32:48.580",
      "text": "همین خوبه؟"
    },
    {
      "id": 50,
      "start": 5568.58,
      "end": 5569.58,
      "formatted_start": "01:32:48.580",
      "formatted_end": "01:32:49.580",
      "text": "همین خوبه"
    },
    {
      "id": 51,
      "start": 5569.58,
      "end": 5570.58,
      "formatted_start": "01:32:49.580",
      "formatted_end": "01:32:50.580",
      "text": "همین اصرا؟"
    },
    {
      "id": 52,
      "start": 5570.58,
      "end": 5571.58,
      "formatted_start": "01:32:50.580",
      "formatted_end": "01:32:51.580",
      "text": "نه، کامل"
    },
    {
      "id": 53,
      "start": 5571.58,
      "end": 5572.58,
      "formatted_start": "01:32:51.580",
      "formatted_end": "01:32:52.580",
      "text": "واقعا شب یکیه"
    },
    {
      "id": 54,
      "start": 5572.58,
      "end": 5574.58,
      "formatted_start": "01:32:52.580",
      "formatted_end": "01:32:54.580",
      "text": "آره، اصرا بخوید، شفت نخواید"
    },
    {
      "id": 55,
      "start": 5574.58,
      "end": 5576.58,
      "formatted_start": "01:32:54.580",
      "formatted_end": "01:32:56.580",
      "text": "آره، شفت خوابه بگوید"
    },
    {
      "id": 56,
      "start": 5576.58,
      "end": 5579.58,
      "formatted_start": "01:32:56.580",
      "formatted_end": "01:32:59.580",
      "text": "اصرا بخوید یه دونه، همون داروی خوبه"
    },
    {
      "id": 57,
      "start": 5579.58,
      "end": 5582.58,
      "formatted_start": "01:32:59.580",
      "formatted_end": "01:33:02.580",
      "text": "یه قرص مده، با اون اصرا"
    },
    {
      "id": 58,
      "start": 5585.82,
      "end": 5615.82,
      "formatted_start": "01:33:05.820",
      "formatted_end": "01:33:35.820",
      "text": "باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برد"
    },
    {
      "id": 59,
      "start": 5615.82,
      "end": 5628.82,
      "formatted_start": "01:33:35.820",
      "formatted_end": "01:33:48.820",
      "text": "موسیقی"
    },
    {
      "id": 60,
      "start": 5645.82,
      "end": 5648.82,
      "formatted_start": "01:34:05.820",
      "formatted_end": "01:34:08.820",
      "text": "اگه دیدی اومده با من خواهید یک تلفنی بگو خب؟"
    },
    {
      "id": 61,
      "start": 5648.82,
      "end": 5650.82,
      "formatted_start": "01:34:08.820",
      "formatted_end": "01:34:10.820",
      "text": "نه دیدی خودش بود"
    },
    {
      "id": 62,
      "start": 5650.82,
      "end": 5653.82,
      "formatted_start": "01:34:10.820",
      "formatted_end": "01:34:13.820",
      "text": "این دو پیتا از خود برای منشته بود"
    },
    {
      "id": 63,
      "start": 5653.82,
      "end": 5656.82,
      "formatted_start": "01:34:13.820",
      "formatted_end": "01:34:16.820",
      "text": "اون دفعه کفت که ویتامین دی برای من نمیشه"
    },
    {
      "id": 64,
      "start": 5656.82,
      "end": 5658.82,
      "formatted_start": "01:34:16.820",
      "formatted_end": "01:34:18.820",
      "text": "از این حاله این رو بسرهم میگنه"
    },
    {
      "id": 65,
      "start": 5658.82,
      "end": 5660.82,
      "formatted_start": "01:34:18.820",
      "formatted_end": "01:34:20.820",
      "text": "از مشکلی باید خودشی بشه"
    },
    {
      "id": 66,
      "start": 5664.82,
      "end": 5666.82,
      "formatted_start": "01:34:24.820",
      "formatted_end": "01:34:26.820",
      "text": "او دی نمیشه ولی کامل بوده"
    },
    {
      "id": 67,
      "start": 5666.82,
      "end": 5668.82,
      "formatted_start": "01:34:26.820",
      "formatted_end": "01:34:28.820",
      "text": "برداره یک دی رو نمیشه"
    },
    {
      "id": 68,
      "start": 5668.82,
      "end": 5670.82,
      "formatted_start": "01:34:28.820",
      "formatted_end": "01:34:30.820",
      "text": "بله من سرم سرم میشم"
    },
    {
      "id": 69,
      "start": 5670.82,
      "end": 5672.82,
      "formatted_start": "01:34:30.820",
      "formatted_end": "01:34:32.820",
      "text": "توی خونه اخلاق خواست"
    },
    {
      "id": 70,
      "start": 5672.82,
      "end": 5674.82,
      "formatted_start": "01:34:32.820",
      "formatted_end": "01:34:34.820",
      "text": "آره واقعا"
    },
    {
      "id": 71,
      "start": 5674.82,
      "end": 5676.82,
      "formatted_start": "01:34:34.820",
      "formatted_end": "01:34:36.820",
      "text": "خیلی دقیقه آخه"
    },
    {
      "id": 72,
      "start": 5676.82,
      "end": 5678.82,
      "formatted_start": "01:34:36.820",
      "formatted_end": "01:34:38.820",
      "text": "خیلی دقیقه نیست بلد بلد همه چی مناسب و دقیق باشه"
    },
    {
      "id": 73,
      "start": 5688.82,
      "end": 5690.82,
      "formatted_start": "01:34:48.820",
      "formatted_end": "01:34:50.820",
      "text": "خانمتون مادر من یادتیم؟"
    },
    {
      "id": 74,
      "start": 5690.82,
      "end": 5692.82,
      "formatted_start": "01:34:50.820",
      "formatted_end": "01:34:52.820",
      "text": "من یا شهر مورادی؟"
    },
    {
      "id": 75,
      "start": 5692.82,
      "end": 5694.82,
      "formatted_start": "01:34:52.820",
      "formatted_end": "01:34:54.820",
      "text": "شهر مورادی"
    },
    {
      "id": 76,
      "start": 5694.82,
      "end": 5696.82,
      "formatted_start": "01:34:54.820",
      "formatted_end": "01:34:56.820",
      "text": "چار پنجت خانم دارم"
    },
    {
      "id": 77,
      "start": 5696.82,
      "end": 5698.82,
      "formatted_start": "01:34:56.820",
      "formatted_end": "01:34:58.820",
      "text": "ولی مطمئنم که"
    },
    {
      "id": 78,
      "start": 5698.82,
      "end": 5700.82,
      "formatted_start": "01:34:58.820",
      "formatted_end": "01:35:00.820",
      "text": "یعنی اسم بگو"
    }
  ],
  "status": "completed"
}