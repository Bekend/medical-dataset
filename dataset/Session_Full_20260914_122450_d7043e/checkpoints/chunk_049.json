  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14707.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:07.000",
      "text": "اگر در این وسط درد شدید شد، سریع می آید."
    },
    {
      "id": 1,
      "start": 14707.0,
      "end": 14709.0,
      "formatted_start": "04:05:07.000",
      "formatted_end": "04:05:09.000",
      "text": "یا مدد؟"
    },
    {
      "id": 2,
      "start": 14709.0,
      "end": 14714.0,
      "formatted_start": "04:05:09.000",
      "formatted_end": "04:05:14.000",
      "text": "یا می روی بیمارستان متحرین می گوید، من سنگیز و سفراتشت هستم."
    },
    {
      "id": 3,
      "start": 14714.0,
      "end": 14717.0,
      "formatted_start": "04:05:14.000",
      "formatted_end": "04:05:17.000",
      "text": "آهان، جایگی شخصی که نواز دارم؟"
    },
    {
      "id": 4,
      "start": 14717.0,
      "end": 14720.0,
      "formatted_start": "04:05:17.000",
      "formatted_end": "04:05:20.000",
      "text": "این چیز کار شخصی نیست."
    },
    {
      "id": 5,
      "start": 14720.0,
      "end": 14727.0,
      "formatted_start": "04:05:20.000",
      "formatted_end": "04:05:27.000",
      "text": "آره چان امروی برشانس می خواهد. ندارن شخصی می افتی توی سیده مرگی."
    },
    {
      "id": 6,
      "start": 14727.0,
      "end": 14757.0,
      "formatted_start": "04:05:27.000",
      "formatted_end": "04:05:57.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 7,
      "start": 14757.0,
      "end": 14761.0,
      "formatted_start": "04:05:57.000",
      "formatted_end": "04:06:01.000",
      "text": "اینجا باعث شده که اینجا باعث شده که تو..."
    },
    {
      "id": 8,
      "start": 14761.0,
      "end": 14766.0,
      "formatted_start": "04:06:01.000",
      "formatted_end": "04:06:06.000",
      "text": "اصلا زیر یک سانتری ارزش رو فکر کردم هدوه"
    },
    {
      "id": 9,
      "start": 14766.0,
      "end": 14767.0,
      "formatted_start": "04:06:06.000",
      "formatted_end": "04:06:07.000",
      "text": "نه، این روش نمی کند"
    },
    {
      "id": 10,
      "start": 14767.0,
      "end": 14771.0,
      "formatted_start": "04:06:07.000",
      "formatted_end": "04:06:11.000",
      "text": "ولی تو ازمایش رو دو بار پرکاری زده"
    },
    {
      "id": 11,
      "start": 14771.0,
      "end": 14774.0,
      "formatted_start": "04:06:11.000",
      "formatted_end": "04:06:14.000",
      "text": "اصلا به گلو مباره یک فشاری همشون می آزد"
    },
    {
      "id": 12,
      "start": 14774.0,
      "end": 14777.0,
      "formatted_start": "04:06:14.000",
      "formatted_end": "04:06:17.000",
      "text": "آره، دو جا باید پرکاری زده"
    },
    {
      "id": 13,
      "start": 14777.0,
      "end": 14781.0,
      "formatted_start": "04:06:17.000",
      "formatted_end": "04:06:21.000",
      "text": "باید ببین کدومه که جدید تره"
    },
    {
      "id": 14,
      "start": 14781.0,
      "end": 14783.0,
      "formatted_start": "04:06:21.000",
      "formatted_end": "04:06:23.000",
      "text": "چپرلی زده؟"
    },
    {
      "id": 15,
      "start": 14783.0,
      "end": 14813.0,
      "formatted_start": "04:06:23.000",
      "formatted_end": "04:06:53.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 16,
      "start": 14813.0,
      "end": 14816.66,
      "formatted_start": "04:06:53.000",
      "formatted_end": "04:06:56.660",
      "text": "من مثلا خوب برم بودم گفتم برای خودم رو چک کنم"
    },
    {
      "id": 17,
      "start": 14816.66,
      "end": 14820.24,
      "formatted_start": "04:06:56.660",
      "formatted_end": "04:07:00.240",
      "text": "رفتم یه آزمایش یه سونگرافی شکم رو گردم"
    },
    {
      "id": 18,
      "start": 14820.24,
      "end": 14822.24,
      "formatted_start": "04:07:00.240",
      "formatted_end": "04:07:02.240",
      "text": "بله وقت شدن وقتم"
    },
    {
      "id": 19,
      "start": 14822.24,
      "end": 14824.24,
      "formatted_start": "04:07:02.240",
      "formatted_end": "04:07:04.240",
      "text": "اصلا واقعا بله وقت شدن"
    },
    {
      "id": 20,
      "start": 14824.24,
      "end": 14825.24,
      "formatted_start": "04:07:04.240",
      "formatted_end": "04:07:05.240",
      "text": "اصلا حالا میخواد چه"
    },
    {
      "id": 21,
      "start": 14825.24,
      "end": 14827.24,
      "formatted_start": "04:07:05.240",
      "formatted_end": "04:07:07.240",
      "text": "اصلا خیلی حالا خیلی حالا"
    },
    {
      "id": 22,
      "start": 14827.24,
      "end": 14830.24,
      "formatted_start": "04:07:07.240",
      "formatted_end": "04:07:10.240",
      "text": "اصلا اصلا من قلبم داره تون تون میزنه کنم"
    },
    {
      "id": 23,
      "start": 14830.24,
      "end": 14832.24,
      "formatted_start": "04:07:10.240",
      "formatted_end": "04:07:12.240",
      "text": "نه ببینیت"
    },
    {
      "id": 24,
      "start": 14832.24,
      "end": 14834.24,
      "formatted_start": "04:07:12.240",
      "formatted_end": "04:07:14.240",
      "text": "شاید اگه نمیرفتی"
    },
    {
      "id": 25,
      "start": 14834.24,
      "end": 14837.24,
      "formatted_start": "04:07:14.240",
      "formatted_end": "04:07:17.240",
      "text": "یه دفعه خدای نگه یه دفعه که صفراتو میترکید"
    },
    {
      "id": 26,
      "start": 14837.24,
      "end": 14840.24,
      "formatted_start": "04:07:17.240",
      "formatted_end": "04:07:20.240",
      "text": "اینجوری فکر کن خیلی بودن با من"
    },
    {
      "id": 27,
      "start": 14840.24,
      "end": 14848.24,
      "formatted_start": "04:07:20.240",
      "formatted_end": "04:07:28.240",
      "text": "برای پی تیو برایت منیسم اگه جایی از بدنت کفوت شد اگه ضرف و بی حالی داشتید سریع مراجعه میکنید"
    },
    {
      "id": 28,
      "start": 14848.24,
      "end": 14854.24,
      "formatted_start": "04:07:28.240",
      "formatted_end": "04:07:34.240",
      "text": "هر علامت غیر طبیعی داشت"
    },
    {
      "id": 29,
      "start": 14854.24,
      "end": 14860.24,
      "formatted_start": "04:07:34.240",
      "formatted_end": "04:07:40.240",
      "text": "من معمولا بیماری ها و بیمارو میخورم به جمعه به تعدیل ها"
    },
    {
      "id": 30,
      "start": 14860.24,
      "end": 14868.24,
      "formatted_start": "04:07:40.240",
      "formatted_end": "04:07:48.240",
      "text": "برای تا یه ساعت بعد ناشته باشید دو ماه بعد باید تیرویلت هم چک کنید باشه"
    },
    {
      "id": 31,
      "start": 14868.24,
      "end": 14872.24,
      "formatted_start": "04:07:48.240",
      "formatted_end": "04:07:52.240",
      "text": "دو ساعت ناشته باشی؟"
    },
    {
      "id": 32,
      "start": 14872.24,
      "end": 14876.24,
      "formatted_start": "04:07:52.240",
      "formatted_end": "04:07:56.240",
      "text": "یک ساعت، یعنی از قبض دارش رو پرستو بخوری تا یک ساعت حداقل ناشته باشی"
    },
    {
      "id": 33,
      "start": 14876.24,
      "end": 14878.24,
      "formatted_start": "04:07:56.240",
      "formatted_end": "04:07:58.240",
      "text": "بعد غذا تو خوری"
    },
    {
      "id": 34,
      "start": 14878.24,
      "end": 14886.24,
      "formatted_start": "04:07:58.240",
      "formatted_end": "04:08:06.240",
      "text": "کلم، کاهو، تروب، تروبچه، سویا، شرقم، لبوم، همون"
    },
    {
      "id": 35,
      "start": 14886.24,
      "end": 14889.24,
      "formatted_start": "04:08:06.240",
      "formatted_end": "04:08:09.240",
      "text": "این از این و ماتیرویده"
    },
    {
      "id": 36,
      "start": 14889.24,
      "end": 14901.24,
      "formatted_start": "04:08:09.240",
      "formatted_end": "04:08:21.240",
      "text": "برکه سفرات مکارانی، تخمه مرق، صرف گردنی، جگر، کل پاچه ممنون"
    },
    {
      "id": 37,
      "start": 14901.24,
      "end": 14905.24,
      "formatted_start": "04:08:21.240",
      "formatted_end": "04:08:25.240",
      "text": "ترشک ترشی، لوشک ممنون"
    },
    {
      "id": 38,
      "start": 14905.24,
      "end": 14913.24,
      "formatted_start": "04:08:25.240",
      "formatted_end": "04:08:33.240",
      "text": "داروات رو بگیر یه سنه آخر ماهی، آزمایش دو ماه دیگه"
    },
    {
      "id": 39,
      "start": 14913.24,
      "end": 14916.24,
      "formatted_start": "04:08:33.240",
      "formatted_end": "04:08:36.240",
      "text": "برای گلون کارش نمیشه کرد نه؟"
    },
    {
      "id": 40,
      "start": 14916.24,
      "end": 14918.24,
      "formatted_start": "04:08:36.240",
      "formatted_end": "04:08:38.240",
      "text": "آمین باشت که میگه"
    },
    {
      "id": 41,
      "start": 14918.24,
      "end": 14921.24,
      "formatted_start": "04:08:38.240",
      "formatted_end": "04:08:41.240",
      "text": "باید باز شروع کرد"
    },
    {
      "id": 42,
      "start": 14921.24,
      "end": 14922.24,
      "formatted_start": "04:08:41.240",
      "formatted_end": "04:08:42.240",
      "text": "برور نه؟"
    },
    {
      "id": 43,
      "start": 14922.24,
      "end": 14924.24,
      "formatted_start": "04:08:42.240",
      "formatted_end": "04:08:44.240",
      "text": "حتما برکرد"
    },
    {
      "id": 44,
      "start": 14924.24,
      "end": 14944.24,
      "formatted_start": "04:08:44.240",
      "formatted_end": "04:09:04.240",
      "text": "موسیقی"
    },
    {
      "id": 45,
      "start": 14954.24,
      "end": 14984.24,
      "formatted_start": "04:09:14.240",
      "formatted_end": "04:09:44.240",
      "text": "برای از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این"
    },
    {
      "id": 46,
      "start": 14984.24,
      "end": 15000.0,
      "formatted_start": "04:09:44.240",
      "formatted_end": "04:10:00.000",
