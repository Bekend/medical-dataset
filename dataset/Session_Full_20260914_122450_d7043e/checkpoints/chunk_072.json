      "end": 21640.0,
      "formatted_start": "06:00:38.000",
      "formatted_end": "06:00:40.000",
      "text": "چی شده چرا؟"
    },
    {
      "id": 3,
      "start": 21640.0,
      "end": 21642.0,
      "formatted_start": "06:00:40.000",
      "formatted_end": "06:00:42.000",
