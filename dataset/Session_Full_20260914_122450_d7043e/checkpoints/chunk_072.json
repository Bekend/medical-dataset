    },
    {
      "id": 75,
      "start": 21808.1,
      "end": 21809.84,
      "formatted_start": "06:03:28.100",
      "formatted_end": "06:03:29.840",
      "text": "اه تا روزه لگه نمی کنید؟"
    },
    {
      "id": 76,
      "start": 21809.84,
      "end": 21812.16,
      "formatted_start": "06:03:29.840",
      "formatted_end": "06:03:32.160",
      "text": "اه زیادتر می کنید اینجا نمی کنید"
    },
    {
      "id": 77,
      "start": 21812.16,
      "end": 21814.92,
      "formatted_start": "06:03:32.160",
      "formatted_end": "06:03:34.920",
      "text": "خب سیانس جدید بره مامان اضافه میکنم"
    },
    {
      "id": 78,
      "start": 21814.92,
      "end": 21819.46,
      "formatted_start": "06:03:34.920",
      "formatted_end": "06:03:39.460",
      "text": "خب دیگه در سال یه دیدی خارشش افتاد پوزش زخمی چیزی شد برمون بگو"
    },
    {
      "id": 79,
      "start": 21819.46,
      "end": 21822.64,
      "formatted_start": "06:03:39.460",
      "formatted_end": "06:03:42.640",
      "text": "وگرنه که اون موقع پیدا نمی شد سریقا"
    },
    {
      "id": 80,
      "start": 21822.64,
      "end": 21827.64,
      "formatted_start": "06:03:42.640",
      "formatted_end": "06:03:47.640",
      "text": "الان تو کشور از قبلن پیدادم شد خالش آب برای 600 تومن بود"
    },
    {
      "id": 81,
      "start": 21827.64,
      "end": 21829.64,
      "formatted_start": "06:03:47.640",
      "formatted_end": "06:03:49.640",
      "text": "الان دیگه دولتی میپیشن"
    },
    {
      "id": 82,
      "start": 21829.64,
      "end": 21830.64,
      "formatted_start": "06:03:49.640",
      "formatted_end": "06:03:50.640",
      "text": "میمیسن برای ما"
    },
    {
      "id": 83,
      "start": 21830.64,
      "end": 21832.64,
      "formatted_start": "06:03:50.640",
      "formatted_end": "06:03:52.640",
      "text": "سخارش بیفته از اونه؟"
    },
    {
      "id": 84,
      "start": 21832.64,
      "end": 21837.64,
      "formatted_start": "06:03:52.640",
      "formatted_end": "06:03:57.640",
      "text": "نه، اگه آره اگه افتاد، تنش زرد شد، چشمش زرد شد، چیز چیزی"
    },
    {
      "id": 85,
      "start": 21837.64,
      "end": 21839.64,
      "formatted_start": "06:03:57.640",
      "formatted_end": "06:03:59.640",
      "text": "حالا من قیلتیات میگم اونها"
    },
    {
      "id": 86,
      "start": 21839.64,
      "end": 21843.64,
      "formatted_start": "06:03:59.640",
      "formatted_end": "06:04:03.640",
      "text": "هر وقت قیلت طبیعی داشت به ما زنگ داشت همینجوری بگم"
    },
    {
      "id": 87,
      "start": 21843.64,
      "end": 21846.64,
      "formatted_start": "06:04:03.640",
      "formatted_end": "06:04:06.640",
      "text": "یه بار سرمشون میکنم برای مامون"
    },
    {
      "id": 88,
      "start": 21846.64,
      "end": 21850.64,
      "formatted_start": "06:04:06.640",
      "formatted_end": "06:04:10.640",
      "text": "که یکم درداشونو آروم میکنه، التعابه رو کم میکنه"
    },
    {
      "id": 89,
      "start": 21850.64,
      "end": 21854.64,
      "formatted_start": "06:04:10.640",
      "formatted_end": "06:04:14.640",
      "text": "بعد از ناشبت همانو میدهیم"
    },
    {
      "id": 90,
      "start": 21854.64,
      "end": 21858.64,
      "formatted_start": "06:04:14.640",
      "formatted_end": "06:04:18.640",
      "text": "باشه، آنکولم برای فیلن درد است"
    },
    {
      "id": 91,
      "start": 21858.64,
      "end": 21862.64,
      "formatted_start": "06:04:18.640",
      "formatted_end": "06:04:22.640",
      "text": "باشه، آنکولتون کجا است؟"
    },
    {
      "id": 92,
      "start": 21862.64,
      "end": 21866.64,
      "formatted_start": "06:04:22.640",
      "formatted_end": "06:04:26.640",
      "text": "فارسیان رستا میشنه"
    },
    {
      "id": 93,
      "start": 21866.64,
      "end": 21870.64,
      "formatted_start": "06:04:26.640",
      "formatted_end": "06:04:30.640",
      "text": "فارسیان راسته که دیگه میشنه، نمیسه"
    },
    {
      "id": 94,
      "start": 21870.64,
      "end": 21874.64,
      "formatted_start": "06:04:30.640",
      "formatted_end": "06:04:34.640",
      "text": "آمدید اینجا فارسیان"
    },
    {
      "id": 95,
      "start": 21874.64,
      "end": 21876.64,
      "formatted_start": "06:04:34.640",
      "formatted_end": "06:04:36.640",
      "text": "اینکه از اسم فارسی هست"
    },
    {
      "id": 96,
      "start": 21876.64,
      "end": 21878.64,
      "formatted_start": "06:04:36.640",
      "formatted_end": "06:04:38.640",
      "text": "اونجا اون طرف برکشت"
    },
    {
      "id": 97,
      "start": 21878.64,
      "end": 21880.64,
      "formatted_start": "06:04:38.640",
      "formatted_end": "06:04:40.640",
      "text": "اونجا اون طرف برکشت"
    },
    {
      "id": 98,
      "start": 21880.64,
      "end": 21882.64,
      "formatted_start": "06:04:40.640",
      "formatted_end": "06:04:42.640",
      "text": "نودی موره هم نودگن"
    },
    {
      "id": 99,
      "start": 21882.64,
      "end": 21884.64,
      "formatted_start": "06:04:42.640",
      "formatted_end": "06:04:44.640",
      "text": "نودی خوشلاف موره نه اونجا"
    },
    {
      "id": 100,
      "start": 21884.64,
      "end": 21886.64,
      "formatted_start": "06:04:44.640",
      "formatted_end": "06:04:46.640",
      "text": "نودی خوشلاف موره نه اونجا"
    },
    {
      "id": 101,
      "start": 21886.64,
      "end": 21888.64,
      "formatted_start": "06:04:46.640",
      "formatted_end": "06:04:48.640",
      "text": "اون نزدیکه"
    },
    {
      "id": 102,
      "start": 21888.64,
      "end": 21890.64,
      "formatted_start": "06:04:48.640",
      "formatted_end": "06:04:50.640",
      "text": "اون فارسی هست"
    },
    {
      "id": 103,
      "start": 21890.64,
      "end": 21892.64,
      "formatted_start": "06:04:50.640",
      "formatted_end": "06:04:52.640",
      "text": "اون هم دوره دیگه"
    },
    {
      "id": 104,
      "start": 21892.64,
      "end": 21894.64,
      "formatted_start": "06:04:52.640",
      "formatted_end": "06:04:54.640",
      "text": "اون هم دوره دیگه"
    },
    {
      "id": 105,
      "start": 21894.64,
      "end": 21896.64,
      "formatted_start": "06:04:54.640",
      "formatted_end": "06:04:56.640",
      "text": "نه دور نیشکه"
    },
    {
      "id": 106,
      "start": 21896.64,
      "end": 21898.64,
      "formatted_start": "06:04:56.640",
      "formatted_end": "06:04:58.640",
      "text": "پس یه توران فارسی"
    },
    {
      "id": 107,
      "start": 21898.64,
      "end": 21900.64,
      "formatted_start": "06:04:58.640",
      "formatted_end": "06:05:00.640",
      "text": "یه توران فارسی بکنیم در شهر"
    }
  ],
  "status": "completed"
}