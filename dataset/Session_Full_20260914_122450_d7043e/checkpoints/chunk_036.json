    },
    {
      "id": 11,
      "start": 10833.32,
      "end": 10835.64,
      "formatted_start": "03:00:33.320",
      "formatted_end": "03:00:35.640",
      "text": "این نخون منم برعکسی رفته تو کشت"
    },
    {
      "id": 12,
      "start": 10835.64,
      "end": 10837.64,
      "formatted_start": "03:00:35.640",
      "formatted_end": "03:00:37.640",
      "text": "اصلا عرضیتن میکنی چند بار چند بار"
    },
    {
      "id": 13,
      "start": 10837.64,
      "end": 10840.56,
      "formatted_start": "03:00:37.640",
      "formatted_end": "03:00:40.560",
      "text": "منم چجوری اینهای خوش کنم بخوریم اگه موضوعی به اداره بگم"
    },
    {
      "id": 14,
      "start": 10840.56,
      "end": 10841.56,
      "formatted_start": "03:00:40.560",
      "formatted_end": "03:00:41.560",
