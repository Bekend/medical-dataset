  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10806.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:06.000",
      "text": "کهر خاموه، چرگو چیلی هستن، نبنیت هم سایی کن، فقط اگر یه زده پریت بخورید، دیگه برداشت."
    },
    {
      "id": 1,
      "start": 10806.0,
      "end": 10812.0,
      "formatted_start": "03:00:06.000",
      "formatted_end": "03:00:12.000",
      "text": "پریت هم که یه خورده روزانه که ترش هست، اونو میخورم، و یه چیزی دیگه اصلا نمیتونم بخورم."
    },
    {
      "id": 2,
      "start": 10812.0,
      "end": 10817.0,
      "formatted_start": "03:00:12.000",
      "formatted_end": "03:00:17.000",
      "text": "اصلا هر خاموه و کهر رو که اصلا تو خورم، خودم نمیگیرم، دوست ندارم."
    },
    {
      "id": 3,
      "start": 10820.0,
      "end": 10822.0,
      "formatted_start": "03:00:20.000",
      "formatted_end": "03:00:22.000",
      "text": "ندارد خیلی ازش."
    },
    {
      "id": 4,
      "start": 10822.0,
      "end": 10823.0,
      "formatted_start": "03:00:22.000",
      "formatted_end": "03:00:23.000",
      "text": "چرا؟"
    },
    {
      "id": 5,
      "start": 10823.0,
      "end": 10824.0,
      "formatted_start": "03:00:23.000",
      "formatted_end": "03:00:24.000",
      "text": "از این پایین که میتونیم."
    },
    {
      "id": 6,
      "start": 10824.0,
      "end": 10826.0,
      "formatted_start": "03:00:24.000",
      "formatted_end": "03:00:26.000",
      "text": "راز و باسه دیگه شانویتون"
    },
    {
      "id": 7,
      "start": 10826.0,
      "end": 10827.44,
      "formatted_start": "03:00:26.000",
      "formatted_end": "03:00:27.440",
      "text": "چند روزمون"
    },
    {
      "id": 8,
      "start": 10827.44,
      "end": 10829.44,
      "formatted_start": "03:00:27.440",
      "formatted_end": "03:00:29.440",
      "text": "نمیدونم چون از اون ندارم"
    },
    {
      "id": 9,
      "start": 10829.44,
      "end": 10830.32,
      "formatted_start": "03:00:29.440",
      "formatted_end": "03:00:30.320",
      "text": "چند روزمون"
    },
    {
      "id": 10,
      "start": 10830.32,
      "end": 10831.32,
      "formatted_start": "03:00:30.320",
      "formatted_end": "03:00:31.320",
