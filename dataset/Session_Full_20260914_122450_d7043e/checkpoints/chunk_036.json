      "start": 10866.0,
      "end": 10868.0,
      "formatted_start": "03:01:06.000",
      "formatted_end": "03:01:08.000",
      "text": "نه سه باب دست گله درمون باشه"
    },
    {
      "id": 25,
      "start": 10868.0,
      "end": 10870.0,
      "formatted_start": "03:01:08.000",
      "formatted_end": "03:01:10.000",
      "text": "خواهد باشه"
    },
    {
      "id": 26,
      "start": 10880.0,
      "end": 10890.0,
      "formatted_start": "03:01:20.000",
      "formatted_end": "03:01:30.000",
      "text": "موسیقی"
    },
    {
      "id": 27,
      "start": 10910.0,
      "end": 10912.0,
      "formatted_start": "03:01:50.000",
      "formatted_end": "03:01:52.000",
