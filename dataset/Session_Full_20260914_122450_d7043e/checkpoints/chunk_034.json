  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10208.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:08.000",
      "text": "بازم برد میشه، این زنگ میزنه، اون زنگ میزنه."
    },
    {
      "id": 1,
      "start": 10208.0,
      "end": 10216.0,
      "formatted_start": "02:50:08.000",
      "formatted_end": "02:50:16.000",
      "text": "آزمایش کبدش خوبه، بازمان چون بگن بردونی باز از تو میپرسه."
    },
    {
      "id": 2,
      "start": 10216.0,
      "end": 10224.0,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:24.000",
      "text": "آزمایش ادرارش خوبه، آزمای کبدش خوبه، زردی نداره، قندش خوبه، کلیش خوبه، چربی نداره."
    },
    {
      "id": 3,
      "start": 10224.0,
      "end": 10232.0,
      "formatted_start": "02:50:24.000",
      "formatted_end": "02:50:32.000",
      "text": "اونا ما همیشون داره که کمخونه مینوره، مادر زود بر بلده ازش کچکه، بلی مشکل برش اجاد نمیکنه"
    },
    {
      "id": 4,
      "start": 10239.0,
      "end": 10241.0,
      "formatted_start": "02:50:39.000",
      "formatted_end": "02:50:41.000",
      "text": "باید چیز کنیم برش؟"
    },
    {
      "id": 5,
      "start": 10241.0,
      "end": 10245.0,
      "formatted_start": "02:50:41.000",
      "formatted_end": "02:50:45.000",
      "text": "باید هنو روز گرس مده برش"
    },
    {
      "id": 6,
      "start": 10245.0,
      "end": 10247.0,
      "formatted_start": "02:50:45.000",
      "formatted_end": "02:50:47.000",
      "text": "آقا میرم پرونداش نیم"
    },
    {
      "id": 7,
      "start": 10247.0,
      "end": 10252.0,
      "formatted_start": "02:50:47.000",
      "formatted_end": "02:50:52.000",
      "text": "بعد این کمخونه رو خودم من که اومدم به ممکنون زدی، صافیش"
    },
    {
      "id": 8,
      "start": 10252.0,
      "end": 10258.0,
      "formatted_start": "02:50:52.000",
      "formatted_end": "02:50:58.000",
      "text": "نه این آن پول نمیخواد. این دیگه جنیتیکش هست. گلوله قرمزش قدر و تاره."
    },
    {
      "id": 9,
      "start": 10258.0,
      "end": 10262.0,
      "formatted_start": "02:50:58.000",
      "formatted_end": "02:51:02.000",
      "text": "برای من خودم خدا خورم. خب زنان فرق دارن."
    },
    {
      "id": 10,
      "start": 10262.0,
      "end": 10266.0,
      "formatted_start": "02:51:02.000",
      "formatted_end": "02:51:06.000",
      "text": "از آرین خورم بیان پیشت که کارم نیست. زنان خورده میشن."
    },
    {
      "id": 11,
      "start": 10266.0,
      "end": 10274.0,
      "formatted_start": "02:51:06.000",
      "formatted_end": "02:51:14.000",
      "text": "سرمیجان چیزها دارن. زن و مرد فرق دارن. چرا که دختره؟ خب من هم اونوقت بهش دارو دادم دارو هم گرفته. خب؟"
    },
    {
      "id": 12,
      "start": 10274.0,
      "end": 10278.0,
      "formatted_start": "02:51:14.000",
      "formatted_end": "02:51:18.000",
      "text": "برس مهده بهش دادم دقیقا همین دایجستی رو بهش دادم که میدونستم"
    },
    {
      "id": 13,
      "start": 10278.0,
      "end": 10280.0,
      "formatted_start": "02:51:18.000",
      "formatted_end": "02:51:20.000",
      "text": "خونه رو کذاش برم"
    },
    {
      "id": 14,
      "start": 10280.0,
      "end": 10281.0,
      "formatted_start": "02:51:20.000",
      "formatted_end": "02:51:21.000",
      "text": "برامش کرد ببرم"
    },
    {
      "id": 15,
      "start": 10281.0,
      "end": 10283.0,
      "formatted_start": "02:51:21.000",
      "formatted_end": "02:51:23.000",
      "text": "من همون قسمت بهش خورس رو دادم"
    },
    {
      "id": 16,
      "start": 10283.0,
      "end": 10289.0,
      "formatted_start": "02:51:23.000",
      "formatted_end": "02:51:29.000",
      "text": "منتها اگه این دایجستی روش اثر نکنه باید خارجش رو بکنه خارجش خودتی یه کنیم"
    },
    {
      "id": 17,
      "start": 10289.0,
      "end": 10291.0,
      "formatted_start": "02:51:29.000",
      "formatted_end": "02:51:31.000",
      "text": "چجوری مالی؟"
    },
    {
      "id": 18,
      "start": 10291.0,
      "end": 10294.0,
      "formatted_start": "02:51:31.000",
      "formatted_end": "02:51:34.000",
      "text": "میتونه بگیره موجود در ایگل رو برم"
    },
    {
      "id": 19,
      "start": 10294.0,
      "end": 10296.0,
      "formatted_start": "02:51:34.000",
      "formatted_end": "02:51:36.000",
      "text": "پس بذار داروهاشو خوب بش بگیره"
    },
    {
      "id": 20,
      "start": 10296.0,
      "end": 10299.0,
      "formatted_start": "02:51:36.000",
      "formatted_end": "02:51:39.000",
      "text": "باید کجا میکنم براش بفرستم"
    },
    {
      "id": 21,
      "start": 10299.0,
      "end": 10301.0,
      "formatted_start": "02:51:39.000",
      "formatted_end": "02:51:41.000",
      "text": "چون بچه هست دیگه"
    },
    {
      "id": 22,
      "start": 10301.0,
      "end": 10303.0,
      "formatted_start": "02:51:41.000",
      "formatted_end": "02:51:43.000",
      "text": "آره"
    },
    {
      "id": 23,
      "start": 10303.0,
      "end": 10305.0,
      "formatted_start": "02:51:43.000",
      "formatted_end": "02:51:45.000",
      "text": "بذار همون داره خود بخوره"
    },
    {
      "id": 24,
      "start": 10305.0,
      "end": 10307.0,
      "formatted_start": "02:51:45.000",
      "formatted_end": "02:51:47.000",
      "text": "چون این"
    },
    {
      "id": 25,
      "start": 10307.0,
      "end": 10309.0,
      "formatted_start": "02:51:47.000",
      "formatted_end": "02:51:49.000",
      "text": "گراکم سیستمش"
    },
    {
      "id": 26,
      "start": 10309.0,
      "end": 10311.0,
      "formatted_start": "02:51:49.000",
      "formatted_end": "02:51:51.000",
      "text": "گواهشش کار نمیکنه"
    },
    {
      "id": 27,
      "start": 10311.0,
      "end": 10313.0,
      "formatted_start": "02:51:51.000",
      "formatted_end": "02:51:53.000",
      "text": "اتوشه کمبود و ویتامین میشه"
    },
    {
      "id": 28,
      "start": 10313.0,
      "end": 10315.0,
      "formatted_start": "02:51:53.000",
      "formatted_end": "02:51:55.000",
      "text": "و این نیوز"
    },
    {
      "id": 29,
      "start": 10315.0,
      "end": 10317.0,
      "formatted_start": "02:51:55.000",
      "formatted_end": "02:51:57.000",
      "text": "اندوسکوفی و این چیزها"
    },
    {
      "id": 30,
      "start": 10317.0,
      "end": 10319.0,
      "formatted_start": "02:51:57.000",
      "formatted_end": "02:51:59.000",
      "text": "فعلا نداره"
    },
    {
      "id": 31,
      "start": 10319.0,
      "end": 10321.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:01.000",
      "text": "نداره نداره"
    },
    {
      "id": 32,
      "start": 10321.0,
      "end": 10323.0,
      "formatted_start": "02:52:01.000",
      "formatted_end": "02:52:03.000",
      "text": "چون از آزمایش هست گرونه انجام دادی"
    },
    {
      "id": 33,
      "start": 10323.0,
      "end": 10325.0,
      "formatted_start": "02:52:03.000",
      "formatted_end": "02:52:05.000",
      "text": "گفتی هیچ آسیبی نداره"
    },
    {
      "id": 34,
      "start": 10325.0,
      "end": 10327.0,
      "formatted_start": "02:52:05.000",
      "formatted_end": "02:52:07.000",
      "text": "برای مدهشو ادامه بده"
    },
    {
      "id": 35,
      "start": 10327.0,
      "end": 10329.0,
      "formatted_start": "02:52:07.000",
      "formatted_end": "02:52:09.000",
      "text": "من دوراش دوباره براش می نیستم"
    },
    {
      "id": 36,
      "start": 10329.0,
      "end": 10335.0,
      "formatted_start": "02:52:09.000",
      "formatted_end": "02:52:15.000",
      "text": "بهش بگو ناشتاییشو با اون قرصی که بوتی خریدگیرونه"
    },
    {
      "id": 37,
      "start": 10335.0,
      "end": 10337.0,
      "formatted_start": "02:52:15.000",
      "formatted_end": "02:52:17.000",
      "text": "هیچ وقت تموم نکنه"
    },
    {
      "id": 38,
      "start": 10337.0,
      "end": 10340.0,
      "formatted_start": "02:52:17.000",
      "formatted_end": "02:52:20.000",
      "text": "از اون می برد؟"
    },
    {
      "id": 39,
      "start": 10340.0,
      "end": 10342.0,
      "formatted_start": "02:52:20.000",
      "formatted_end": "02:52:22.000",
      "text": "برد برای شکمش خب"
    },
    {
      "id": 40,
      "start": 10342.0,
      "end": 10343.0,
      "formatted_start": "02:52:22.000",
      "formatted_end": "02:52:23.000",
      "text": "برای شکمش؟"
    },
    {
      "id": 41,
      "start": 10343.0,
      "end": 10345.0,
      "formatted_start": "02:52:23.000",
      "formatted_end": "02:52:25.000",
      "text": "یه پود می نیستم"
    },
    {
      "id": 42,
      "start": 10345.0,
      "end": 10349.0,
      "formatted_start": "02:52:25.000",
      "formatted_end": "02:52:29.000",
      "text": "چجوری شرایط کارش سبت و شب می روی گیرون"
    },
    {
      "id": 43,
      "start": 10349.0,
      "end": 10350.0,
      "formatted_start": "02:52:29.000",
      "formatted_end": "02:52:30.000",
      "text": "آره دیگه"
    },
    {
      "id": 44,
      "start": 10350.0,
      "end": 10352.0,
      "formatted_start": "02:52:30.000",
      "formatted_end": "02:52:32.000",
      "text": "دستشوی داره اونجایی بگیرون"
    },
    {
      "id": 45,
      "start": 10352.0,
      "end": 10354.0,
      "formatted_start": "02:52:32.000",
      "formatted_end": "02:52:34.000",
      "text": "آره بره خیلی کارم می کنش دارم"
    },
    {
      "id": 46,
      "start": 10354.0,
      "end": 10356.0,
      "formatted_start": "02:52:34.000",
      "formatted_end": "02:52:36.000",
      "text": "این پود رو به جای آق باید بخوره خب"
    },
    {
      "id": 47,
      "start": 10356.0,
      "end": 10358.0,
      "formatted_start": "02:52:36.000",
      "formatted_end": "02:52:38.000",
      "text": "یعنی این کار رو در آب باتی کنه"
    },
    {
      "id": 48,
      "start": 10358.0,
      "end": 10361.0,
      "formatted_start": "02:52:38.000",
      "formatted_end": "02:52:41.000",
      "text": "آره هر بستش رو توی بطی آب مدنی باتی کنه"
    },
    {
      "id": 49,
      "start": 10361.0,
      "end": 10364.0,
      "formatted_start": "02:52:41.000",
      "formatted_end": "02:52:44.000",
      "text": "به جای آب این پودر رو استفاده کنه"
    },
    {
      "id": 50,
      "start": 10364.0,
      "end": 10366.0,
      "formatted_start": "02:52:44.000",
      "formatted_end": "02:52:46.000",
      "text": "مدبوش رو و قبامش رو نرم میکنه"
    },
    {
      "id": 51,
      "start": 10366.0,
      "end": 10368.0,
      "formatted_start": "02:52:46.000",
      "formatted_end": "02:52:48.000",
      "text": "که راحت بینه"
    },
    {
      "id": 52,
      "start": 10368.0,
      "end": 10371.0,
      "formatted_start": "02:52:48.000",
      "formatted_end": "02:52:51.000",
      "text": "اونا داروش یکم داروی گرونی داروی بوده"
    },
    {
      "id": 53,
      "start": 10371.0,
      "end": 10374.0,
      "formatted_start": "02:52:51.000",
      "formatted_end": "02:52:54.000",
      "text": "اکثرشون خارجیه دوی راه نزدیک"
    },
    {
      "id": 54,
      "start": 10374.0,
      "end": 10378.0,
      "formatted_start": "02:52:54.000",
      "formatted_end": "02:52:58.000",
      "text": "فقط هنگی مشکلش که مده شرس نکنه"
    },
    {
      "id": 55,
      "start": 10378.0,
      "end": 10380.0,
      "formatted_start": "02:52:58.000",
      "formatted_end": "02:53:00.000",
      "text": "و شکرش درگیشه"
    },
    {
      "id": 56,
      "start": 10380.0,
      "end": 10382.0,
      "formatted_start": "02:53:00.000",
      "formatted_end": "02:53:02.000",
      "text": "این یه اقتلال آزمی مادر زاده"
    },
    {
      "id": 57,
      "start": 10382.0,
      "end": 10385.0,
      "formatted_start": "02:53:02.000",
      "formatted_end": "02:53:05.000",
      "text": "چل برد بکن چربی ها رو همه رو دفت می کنه"
    },
    {
      "id": 58,
      "start": 10385.0,
      "end": 10386.0,
      "formatted_start": "02:53:05.000",
      "formatted_end": "02:53:06.000",
      "text": "جزبیه"
    },
    {
      "id": 59,
      "start": 10386.0,
      "end": 10390.0,
      "formatted_start": "02:53:06.000",
      "formatted_end": "02:53:10.000",
      "text": "چون بچه بود روزش از پشت پیدر اومد"
    },
    {
      "id": 60,
      "start": 10390.0,
      "end": 10392.0,
      "formatted_start": "02:53:10.000",
      "formatted_end": "02:53:12.000",
      "text": "با بیسین داشت"
    },
    {
      "id": 61,
      "start": 10392.0,
      "end": 10397.0,
      "formatted_start": "02:53:12.000",
      "formatted_end": "02:53:17.000",
      "text": "بعد دختر عملش نکرد گفت بزرگش عملش نیست در امن رای بود"
    },
    {
      "id": 62,
      "start": 10397.0,
      "end": 10399.0,
      "formatted_start": "02:53:17.000",
      "formatted_end": "02:53:19.000",
      "text": "بر بابام نبود اینجا رفیق تهران"
    },
    {
      "id": 63,
      "start": 10399.0,
      "end": 10403.0,
      "formatted_start": "02:53:19.000",
      "formatted_end": "02:53:23.000",
      "text": "وقتی اومد یه شعیر بیرون بود ما بچه بودیم دیگه"
    },
    {
      "id": 64,
      "start": 10403.0,
      "end": 10407.0,
      "formatted_start": "02:53:23.000",
      "formatted_end": "02:53:27.000",
      "text": "بر با ماما اون انداخت کرد و از دوره زد داخل"
    },
    {
      "id": 65,
      "start": 10407.0,
      "end": 10410.0,
      "formatted_start": "02:53:27.000",
      "formatted_end": "02:53:30.000",
      "text": "گفت میکروب میدیره چرا بچه رو میگردش"
    },
    {
      "id": 66,
      "start": 10410.0,
      "end": 10414.0,
      "formatted_start": "02:53:30.000",
      "formatted_end": "02:53:34.000",
      "text": "باید برداشته خود، باید باده این دختر دختر جان رو باد"
    },
    {
      "id": 67,
      "start": 10414.0,
      "end": 10418.0,
      "formatted_start": "02:53:34.000",
      "formatted_end": "02:53:38.000",
      "text": "از سالش بود، او هفت، پشت سالشه بدن"
    },
    {
      "id": 68,
      "start": 10418.0,
      "end": 10422.0,
      "formatted_start": "02:53:38.000",
      "formatted_end": "02:53:42.000",
      "text": "ولی او هم میگن، میاد بیرون، میگن نه باید بیرون بیرون"
    },
    {
      "id": 69,
      "start": 10422.0,
      "end": 10441.0,
      "formatted_start": "02:53:42.000",
      "formatted_end": "02:54:01.000",
      "text": "این فرق می کنه. این ها با گوارشش سیستم نرمالی نداره. به صورت مادرزاد اختلاف گوارشی جهازی داره. حالا بعضی ها با استرس اینطوری می شن."
    },
    {
      "id": 70,
      "start": 10441.0,
      "end": 10445.0,
      "formatted_start": "02:54:01.000",
      "formatted_end": "02:54:05.000",
      "text": "استرس داره چون داداشن کس هدف کرد نیست همونجا بهش استرس داره."
    },
    {
      "id": 71,
      "start": 10445.0,
      "end": 10449.0,
      "formatted_start": "02:54:05.000",
      "formatted_end": "02:54:09.000",
      "text": "آره، بعد بعضی ها با استرس بدتر میشن"
    },
    {
      "id": 72,
      "start": 10449.0,
      "end": 10454.0,
      "formatted_start": "02:54:09.000",
      "formatted_end": "02:54:14.000",
      "text": "ببین داروشو بخورن، ممکنه کامل خوب نمیشه، بهتر میشه"
    },
    {
      "id": 73,
      "start": 10454.0,
      "end": 10457.0,
      "formatted_start": "02:54:14.000",
      "formatted_end": "02:54:17.000",
      "text": "چیز باید بگم خوب میشه نداری واقعیتش"
    },
    {
      "id": 74,
      "start": 10457.0,
      "end": 10459.0,
      "formatted_start": "02:54:17.000",
      "formatted_end": "02:54:19.000",
      "text": "چون اون مشکل داره جخمش ماخده"
    },
    {
      "id": 75,
      "start": 10459.0,
      "end": 10461.0,
      "formatted_start": "02:54:19.000",
      "formatted_end": "02:54:21.000",
      "text": "اگه خود خواد بیاد عمل امانجام بده نیست؟"
    },
    {
      "id": 76,
      "start": 10461.0,
      "end": 10464.0,
      "formatted_start": "02:54:21.000",
      "formatted_end": "02:54:24.000",
      "text": "عمل هیچ ربطی نداره، نه عمل ها هیچی نداره"
    },
    {
      "id": 77,
      "start": 10464.0,
      "end": 10468.0,
      "formatted_start": "02:54:24.000",
      "formatted_end": "02:54:28.000",
      "text": "همین دارو رو باید استفاده کنه، کشدار مریض بره جدا"
    },
    {
      "id": 78,
      "start": 10468.0,
      "end": 10472.0,
      "formatted_start": "02:54:28.000",
      "formatted_end": "02:54:32.000",
      "text": "ببین شما، چیز خطرناکی نیست بلی"
    },
    {
      "id": 79,
      "start": 10472.0,
      "end": 10474.0,
      "formatted_start": "02:54:32.000",
      "formatted_end": "02:54:34.000",
      "text": "که اتفاق دوره جون براش بیروند"
    },
    {
      "id": 80,
      "start": 10474.0,
      "end": 10476.0,
      "formatted_start": "02:54:34.000",
      "formatted_end": "02:54:36.000",
      "text": "اینو فرق همین کده براش برفرسته"
    },
    {
      "id": 81,
      "start": 10476.0,
      "end": 10477.0,
      "formatted_start": "02:54:36.000",
      "formatted_end": "02:54:37.000",
      "text": "آره"
    },
    {
      "id": 82,
      "start": 10477.0,
      "end": 10478.0,
      "formatted_start": "02:54:37.000",
      "formatted_end": "02:54:38.000",
      "text": "باشه من"
    },
    {
      "id": 83,
      "start": 10478.0,
      "end": 10480.0,
      "formatted_start": "02:54:38.000",
      "formatted_end": "02:54:40.000",
      "text": "با من تزده سمیت"
    },
    {
      "id": 84,
      "start": 10480.0,
      "end": 10482.0,
      "formatted_start": "02:54:40.000",
      "formatted_end": "02:54:42.000",
      "text": "اینو فرسیده بیشتر نداشت"
    },
    {
      "id": 85,
      "start": 10482.0,
      "end": 10484.0,
      "formatted_start": "02:54:42.000",
      "formatted_end": "02:54:44.000",
      "text": "آره"
    },
    {
      "id": 86,
      "start": 10484.0,
      "end": 10486.0,
      "formatted_start": "02:54:44.000",
      "formatted_end": "02:54:46.000",
      "text": "سلام"
    },
    {
      "id": 87,
      "start": 10486.0,
      "end": 10488.0,
      "formatted_start": "02:54:46.000",
      "formatted_end": "02:54:48.000",
      "text": "سلام"
    },
    {
      "id": 88,
      "start": 10488.0,
      "end": 10490.0,
      "formatted_start": "02:54:48.000",
      "formatted_end": "02:54:50.000",
      "text": "خیلی خوشحال داریم"
    },
    {
      "id": 89,
      "start": 10496.0,
      "end": 10498.0,
