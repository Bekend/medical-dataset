      "formatted_start": "05:20:00.000",
      "formatted_end": "05:20:02.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 1,
      "start": 19202.0,
      "end": 19204.0,
      "formatted_start": "05:20:02.000",
      "formatted_end": "05:20:04.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 2,
      "start": 19204.0,
      "end": 19206.0,
      "formatted_start": "05:20:04.000",
      "formatted_end": "05:20:06.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 3,
      "start": 19206.0,
      "end": 19208.0,
      "formatted_start": "05:20:06.000",
      "formatted_end": "05:20:08.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 4,
      "start": 19208.0,
      "end": 19210.0,
      "formatted_start": "05:20:08.000",
      "formatted_end": "05:20:10.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 5,
      "start": 19210.0,
      "end": 19212.0,
      "formatted_start": "05:20:10.000",
      "formatted_end": "05:20:12.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 6,
      "start": 19212.0,
      "end": 19214.0,
      "formatted_start": "05:20:12.000",
      "formatted_end": "05:20:14.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 7,
      "start": 19214.0,
      "end": 19216.0,
      "formatted_start": "05:20:14.000",
      "formatted_end": "05:20:16.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 8,
      "start": 19216.0,
      "end": 19218.0,
      "formatted_start": "05:20:16.000",
      "formatted_end": "05:20:18.000",
      "text": "از اینجا باید بسیار مردم بگیم."
    },
    {
      "id": 9,
      "start": 19218.0,
      "end": 19222.0,
      "formatted_start": "05:20:18.000",
      "formatted_end": "05:20:22.000",
      "text": "او باید سختی خود رو نداشت"
    },
    {
      "id": 10,
      "start": 19222.0,
      "end": 19230.0,
      "formatted_start": "05:20:22.000",
      "formatted_end": "05:20:30.000",
      "text": "اگر بخواهم اینجا بستری کنم دو هفته با بینه یا این همین اجتماعی"
    },
    {
      "id": 11,
      "start": 19230.0,
      "end": 19234.0,
      "formatted_start": "05:20:30.000",
      "formatted_end": "05:20:34.000",
      "text": "اینجا نمیشه، از اینش اونقدر نمیشه"
    },
    {
      "id": 12,
      "start": 19234.0,
      "end": 19242.0,
      "formatted_start": "05:20:34.000",
      "formatted_end": "05:20:42.000",
      "text": "اگر این ارتوپیت بخواد، اونقدر نمیشه"
    },
    {
      "id": 13,
      "start": 19242.0,
      "end": 19246.0,
      "formatted_start": "05:20:42.000",
      "formatted_end": "05:20:46.000",
      "text": "ولی اون هم بخواد چون دولتی کم میبینه"
    },
    {
      "id": 14,
      "start": 19246.0,
      "end": 19254.0,
      "formatted_start": "05:20:46.000",
      "formatted_end": "05:20:54.000",
      "text": "می کنم این طفله اگر از یک جا دیگه تکلیفش معلوم بشه، نهایت قط بشه یک مصنوعی می زار با هم و می گرده دیگه"
    },
    {
      "id": 15,
      "start": 19254.0,
      "end": 19256.0,
      "formatted_start": "05:20:54.000",
      "formatted_end": "05:20:56.000",
      "text": "انساله می استفاده میکنه؟"
    },
    {
      "id": 16,
      "start": 19256.0,
      "end": 19258.0,
      "formatted_start": "05:20:56.000",
      "formatted_end": "05:20:58.000",
      "text": "بله، لانتوس می زن و عفیتا"
    },
    {
      "id": 17,
      "start": 19258.0,
      "end": 19260.0,
      "formatted_start": "05:20:58.000",
      "formatted_end": "05:21:00.000",
      "text": "لانتوس شو چرح می زنن؟"
    },
    {
      "id": 18,
      "start": 19260.0,
      "end": 19266.0,
      "formatted_start": "05:21:00.000",
      "formatted_end": "05:21:06.000",
      "text": "نوراپیر، نمی بینم دقیقا، لانتوس ریش هوا می زنه، نوراپیر دقیقا، چیزیش صبح بکنم"
    },
    {
      "id": 19,
      "start": 19266.0,
      "end": 19268.0,
      "formatted_start": "05:21:06.000",
      "formatted_end": "05:21:08.000",
      "text": "نمی دونی چرح می زنن؟"
    },
    {
      "id": 20,
      "start": 19268.0,
      "end": 19270.0,
      "formatted_start": "05:21:08.000",
      "formatted_end": "05:21:10.000",
      "text": "ماهی هشتا سر میشه"
    },
    {
      "id": 21,
      "start": 19270.0,
      "end": 19274.0,
      "formatted_start": "05:21:10.000",
      "formatted_end": "05:21:14.000",
      "text": "میزنم بچه ها خودشون بزنم. سنگ میزنم برم."
    },
    {
      "id": 22,
      "start": 19274.0,
      "end": 19277.0,
      "formatted_start": "05:21:14.000",
      "formatted_end": "05:21:17.000",
      "text": "خودش میلونه. خودش جانبی نمیلونه."
    },
    {
      "id": 23,
      "start": 19277.0,
      "end": 19279.0,
      "formatted_start": "05:21:17.000",
      "formatted_end": "05:21:19.000",
      "text": "خودش خود میزنم بچه ها خود سنگ میزنم."
    },
    {
      "id": 24,
      "start": 19279.0,
      "end": 19280.0,
      "formatted_start": "05:21:19.000",
      "formatted_end": "05:21:20.000",
      "text": "بله."
    },
    {
      "id": 25,
      "start": 19280.0,
      "end": 19284.0,
      "formatted_start": "05:21:20.000",
      "formatted_end": "05:21:24.000",
      "text": "و داروش که ماید از بیرون بگیرم و خواهم دکتر برام بگیرم."
    },
    {
      "id": 26,
      "start": 19284.0,
      "end": 19286.0,
      "formatted_start": "05:21:24.000",
      "formatted_end": "05:21:26.000",
      "text": "همین چیز دیگه اون رو نزدیک بگیرم."
    },
    {
      "id": 27,
      "start": 19286.0,
      "end": 19290.0,
      "formatted_start": "05:21:26.000",
      "formatted_end": "05:21:30.000",
      "text": "نه. برای کمخونیش اینا برای مرخص شدن ایش اینا لازم نیست."
    },
    {
      "id": 28,
      "start": 19290.0,
      "end": 19292.0,
      "formatted_start": "05:21:30.000",
      "formatted_end": "05:21:32.000",
      "text": "چرا؟ اونو بچه ها میلونه."
    },
    {
      "id": 29,
      "start": 19292.0,
      "end": 19294.0,
      "formatted_start": "05:21:32.000",
      "formatted_end": "05:21:34.000",
      "text": "من اونها همه رو میریم سه مونو بگو"
    },
    {
      "id": 30,
      "start": 19294.0,
      "end": 19296.0,
      "formatted_start": "05:21:34.000",
      "formatted_end": "05:21:36.000",
      "text": "الان فکرمون سه همه رو باشه"
    },
    {
      "id": 31,
      "start": 19296.0,
      "end": 19300.0,
      "formatted_start": "05:21:36.000",
      "formatted_end": "05:21:40.000",
      "text": "یعنی منجورم اینکه اونجا بیره اگه نیاز باشه خودشان میزن"
    },
    {
      "id": 32,
      "start": 19300.0,
      "end": 19304.0,
      "formatted_start": "05:21:40.000",
      "formatted_end": "05:21:44.000",
      "text": "آره این بیمارسان همه چی خودش انجام میده"
    },
    {
      "id": 33,
      "start": 19308.0,
      "end": 19310.0,
      "formatted_start": "05:21:48.000",
      "formatted_end": "05:21:50.000",
      "text": "شکرمش کار میکنه"
    },
    {
      "id": 34,
      "start": 19310.0,
      "end": 19313.0,
      "formatted_start": "05:21:50.000",
      "formatted_end": "05:21:53.000",
      "text": "بله همه چیزش خوبه اصلا اون ورسای آهنگی"
    },
    {
      "id": 35,
      "start": 19313.0,
      "end": 19315.0,
      "formatted_start": "05:21:53.000",
      "formatted_end": "05:21:55.000",
      "text": "الان کمپونیش چطوره خاندوزو؟"
    },
    {
      "id": 36,
      "start": 19315.0,
      "end": 19319.0,
      "formatted_start": "05:21:55.000",
      "formatted_end": "05:21:59.000",
      "text": "منوز هم کمپونه خیلی سامان میخواد خوب بشه"
    },
    {
      "id": 37,
      "start": 19322.0,
      "end": 19332.0,
      "formatted_start": "05:22:02.000",
      "formatted_end": "05:22:12.000",
      "text": "اگر بخوایید این پاچه مثلا فرض میسا، اگر بخوایید بیپیا بشید، درباره بشید، این پاچه کارشون کنید. تا بانه آمید."
    },
    {
      "id": 38,
      "start": 19332.0,
      "end": 19337.0,
      "formatted_start": "05:22:12.000",
      "formatted_end": "05:22:17.000",
      "text": "از وقتان اون خودت توپون میکشد."
    },
    {
      "id": 39,
      "start": 19352.0,
      "end": 19354.0,
      "formatted_start": "05:22:32.000",
      "formatted_end": "05:22:34.000",
      "text": "از اینجا باید باید بردارید."
    },
    {
      "id": 40,
      "start": 19354.0,
      "end": 19356.0,
      "formatted_start": "05:22:34.000",
      "formatted_end": "05:22:36.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 41,
      "start": 19356.0,
      "end": 19358.0,
      "formatted_start": "05:22:36.000",
      "formatted_end": "05:22:38.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 42,
      "start": 19358.0,
      "end": 19360.0,
      "formatted_start": "05:22:38.000",
      "formatted_end": "05:22:40.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 43,
      "start": 19360.0,
      "end": 19362.0,
      "formatted_start": "05:22:40.000",
      "formatted_end": "05:22:42.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 44,
      "start": 19362.0,
      "end": 19364.0,
      "formatted_start": "05:22:42.000",
      "formatted_end": "05:22:44.000",
      "text": "اینجا باید بردارید."
    },
    {
