  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10502.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:02.000",
      "text": "اینجور دردی داری؟"
    },
    {
      "id": 1,
      "start": 10502.0,
      "end": 10504.0,
      "formatted_start": "02:55:02.000",
      "formatted_end": "02:55:04.000",
      "text": "آره، مثلا پرس پانگلوتی بیمار، پندرونه، میوه."
    },
    {
      "id": 2,
      "start": 10504.0,
      "end": 10506.0,
      "formatted_start": "02:55:04.000",
      "formatted_end": "02:55:06.000",
      "text": "چون تو نتروزون میخوری؟ نه؟"
    },
    {
      "id": 3,
      "start": 10506.0,
      "end": 10508.0,
      "formatted_start": "02:55:06.000",
      "formatted_end": "02:55:08.000",
      "text": "نتروزون؟"
    },
    {
      "id": 4,
      "start": 10508.0,
      "end": 10510.0,
      "formatted_start": "02:55:08.000",
      "formatted_end": "02:55:10.000",
      "text": "تونی میخوری؟"
    },
    {
      "id": 5,
      "start": 10510.0,
      "end": 10512.0,
      "formatted_start": "02:55:10.000",
      "formatted_end": "02:55:12.000",
      "text": "نه."
    },
    {
      "id": 6,
      "start": 10512.0,
      "end": 10514.0,
      "formatted_start": "02:55:12.000",
      "formatted_end": "02:55:14.000",
      "text": "داناظور خودایی؟"
    },
    {
      "id": 7,
      "start": 10514.0,
      "end": 10516.0,
      "formatted_start": "02:55:14.000",
      "formatted_end": "02:55:16.000",
      "text": "داناظور خموم شد دیگه، آره دیگه نخوردم آنو خوردم."
    },
    {
      "id": 8,
      "start": 10516.0,
      "end": 10518.0,
      "formatted_start": "02:55:16.000",
      "formatted_end": "02:55:18.000",
      "text": "ولی خب الان تازه اینجورو شدم، داناظور میکردم اینجورو نبودم."
    },
    {
      "id": 9,
      "start": 10518.0,
      "end": 10520.0,
      "formatted_start": "02:55:18.000",
      "formatted_end": "02:55:20.000",
      "text": "پندرونه، میوه؟"
    },
    {
      "id": 10,
      "start": 10520.0,
      "end": 10522.0,
      "formatted_start": "02:55:20.000",
      "formatted_end": "02:55:22.000",
      "text": "نه، نه، اصلا."
    },
    {
      "id": 11,
      "start": 10522.0,
      "end": 10524.0,
      "formatted_start": "02:55:22.000",
      "formatted_end": "02:55:24.000",
      "text": "کمرده با پادر با شبهه برداری،"
    },
    {
      "id": 12,
      "start": 10524.0,
      "end": 10554.0,
      "formatted_start": "02:55:24.000",
      "formatted_end": "02:55:54.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که ا"
    },
    {
      "id": 13,
      "start": 10554.0,
      "end": 10562.0,
      "formatted_start": "02:55:54.000",
      "formatted_end": "02:56:02.000",
      "text": "چند روزی استرس شدید برد شد و بعد خواب مثلا صبح که با نمیشم با حال طبعی شدید تیر تو سر میشوند"
    },
    {
      "id": 14,
      "start": 10562.0,
      "end": 10568.0,
      "formatted_start": "02:56:02.000",
      "formatted_end": "02:56:08.000",
      "text": "نه پایین روز یه دفعه با درد شدید بیدار شدن اینجا میرم داشت میسوح"
    },
    {
      "id": 15,
      "start": 10568.0,
      "end": 10574.0,
      "formatted_start": "02:56:08.000",
      "formatted_end": "02:56:14.000",
      "text": "یه چیز خوردی دیگه یه که یکی از دروات داره عذیبتت میکنه تقریتی هر چی میخوری فرن هم قطع کنم"
    },
    {
      "id": 16,
      "start": 10574.0,
      "end": 10576.0,
      "formatted_start": "02:56:14.000",
      "formatted_end": "02:56:16.000",
      "text": "تقریتی من رو خیلی برخیر قطع دارم"
    },
    {
      "id": 17,
      "start": 10576.0,
      "end": 10578.0,
      "formatted_start": "02:56:16.000",
      "formatted_end": "02:56:18.000",
      "text": "قاهنت هم فرن هم قطع کنم"
    },
    {
      "id": 18,
      "start": 10578.0,
      "end": 10579.0,
      "formatted_start": "02:56:18.000",
      "formatted_end": "02:56:19.000",
      "text": "آره نمیدونی؟"
    },
    {
      "id": 19,
      "start": 10579.0,
      "end": 10580.0,
      "formatted_start": "02:56:19.000",
      "formatted_end": "02:56:20.000",
      "text": "آهر جا خالی میخوایی مده؟"
    },
    {
      "id": 20,
      "start": 10580.0,
      "end": 10583.0,
      "formatted_start": "02:56:20.000",
      "formatted_end": "02:56:23.000",
      "text": "نه با خوبست میخوایم تیدی مقابل بودی"
    },
    {
      "id": 21,
      "start": 10583.0,
      "end": 10589.0,
      "formatted_start": "02:56:23.000",
      "formatted_end": "02:56:29.000",
      "text": "چون خانومی من عملا ما از خانوم ها زیاد کنیم، خوزنگوش هم هست هستم، سرعتتی کملا گفتاد نبود؟"
    },
    {
      "id": 22,
      "start": 10589.0,
      "end": 10598.0,
      "formatted_start": "02:56:29.000",
      "formatted_end": "02:56:38.000",
      "text": "من خوارزدم که خوزتد، جدا یه چیز رفتم، روز تشریف از آفتاب بود، دیگه از سرعتم سخت، حالا شعبه بهتر شد"
    },
    {
      "id": 23,
      "start": 10598.0,
      "end": 10599.0,
      "formatted_start": "02:56:38.000",
      "formatted_end": "02:56:39.000",
      "text": "چند روز شده میکردی؟"
    },
    {
      "id": 24,
      "start": 10599.0,
      "end": 10600.0,
      "formatted_start": "02:56:39.000",
      "formatted_end": "02:56:40.000",
      "text": "حالا بیس روزه"
    },
    {
      "id": 25,
      "start": 10600.0,
      "end": 10601.0,
      "formatted_start": "02:56:40.000",
      "formatted_end": "02:56:41.000",
      "text": "خوب خوارزدم؟"
    },
    {
      "id": 26,
      "start": 10601.0,
      "end": 10631.0,
      "formatted_start": "02:56:41.000",
      "formatted_end": "02:57:11.000",
      "text": "خودتون بردارید که اینکه اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند، اینجوری هستند،"
    },
    {
      "id": 27,
      "start": 10631.0,
      "end": 10637.0,
      "formatted_start": "02:57:11.000",
      "formatted_end": "02:57:17.000",
      "text": "همه دومتری هم نمیتونن کام بکنن و نوموفیگراماتاز میتونه یکم لک بردن خود بیماری"
    },
    {
      "id": 28,
      "start": 10637.0,
      "end": 10640.0,
      "formatted_start": "02:57:17.000",
      "formatted_end": "02:57:20.000",
      "text": "و چون متشیر هم هستا گرده هست"
    },
    {
      "id": 29,
      "start": 10640.0,
      "end": 10643.0,
      "formatted_start": "02:57:20.000",
      "formatted_end": "02:57:23.000",
      "text": "اینه که قبل هم بوده هم بوده اونو چند سال تو بردم همه دومتری هم هست"
    },
    {
      "id": 30,
      "start": 10643.0,
      "end": 10646.0,
      "formatted_start": "02:57:23.000",
      "formatted_end": "02:57:26.000",
      "text": "هرچنده که رفتم با فکر نمیشتیم، مشهده من رفتم با فکر نمیشتیم"
    },
    {
      "id": 31,
      "start": 10646.0,
      "end": 10649.0,
      "formatted_start": "02:57:26.000",
      "formatted_end": "02:57:29.000",
      "text": "بگم توی نوموفیگراماتاز هست"
    },
    {
      "id": 32,
      "start": 10649.0,
      "end": 10650.0,
      "formatted_start": "02:57:29.000",
      "formatted_end": "02:57:30.000",
      "text": "با فکر نمیشتیم"
    },
    {
      "id": 33,
      "start": 10650.0,
      "end": 10654.3,
      "formatted_start": "02:57:30.000",
      "formatted_end": "02:57:34.300",
      "text": "بخاطر این اختلال جنتیک در کنارش دو چاره آنامترینز شده"
    },
    {
      "id": 34,
      "start": 10654.3,
      "end": 10655.14,
      "formatted_start": "02:57:34.300",
      "formatted_end": "02:57:35.140",
      "text": "احتمالا"
    },
    {
      "id": 35,
      "start": 10655.14,
      "end": 10657.14,
      "formatted_start": "02:57:35.140",
      "formatted_end": "02:57:37.140",
      "text": "این برکار رو اونه جنتیکی داره"
    },
    {
      "id": 36,
      "start": 10657.14,
      "end": 10659.98,
      "formatted_start": "02:57:37.140",
      "formatted_end": "02:57:39.980",
      "text": "چون تا به چانش آرائش رشته ندید"
    },
    {
      "id": 37,
      "start": 10659.98,
      "end": 10661.98,
      "formatted_start": "02:57:39.980",
      "formatted_end": "02:57:41.980",
      "text": "دوری چیزی ندید کنی؟"
    },
    {
      "id": 38,
      "start": 10661.98,
      "end": 10665.98,
      "formatted_start": "02:57:41.980",
      "formatted_end": "02:57:45.980",
      "text": "برای این برکار هم که با خودی خواهد استفاده کنم"
    },
    {
      "id": 39,
      "start": 10665.98,
      "end": 10668.98,
      "formatted_start": "02:57:45.980",
      "formatted_end": "02:57:48.980",
      "text": "دوری کمراهی میشه که مراحتت میخواهد برکاری کنی"
    },
    {
      "id": 40,
      "start": 10668.98,
      "end": 10670.98,
      "formatted_start": "02:57:48.980",
      "formatted_end": "02:57:50.980",
      "text": "حتی خواهد کمراهی بشه"
    },
    {
      "id": 41,
      "start": 10670.98,
      "end": 10672.98,
      "formatted_start": "02:57:50.980",
      "formatted_end": "02:57:52.980",
      "text": "باید نائبرده میتونید پاییز بیایی بکنید"
    },
    {
      "id": 42,
      "start": 10672.98,
      "end": 10673.98,
      "formatted_start": "02:57:52.980",
      "formatted_end": "02:57:53.980",
      "text": "آه"
    },
    {
      "id": 43,
      "start": 10673.98,
      "end": 10676.98,
      "formatted_start": "02:57:53.980",
      "formatted_end": "02:57:56.980",
      "text": "از صورت دو بیار تو پاییز دکتور رو برکاری کنه"
    },
    {
      "id": 44,
      "start": 10676.98,
      "end": 10679.98,
      "formatted_start": "02:57:56.980",
      "formatted_end": "02:57:59.980",
      "text": "آقا دو خیلی روزه با سپین من هم کمام شده ای که سمات نیست"
    },
    {
      "id": 45,
      "start": 10679.98,
      "end": 10682.98,
      "formatted_start": "02:57:59.980",
      "formatted_end": "02:58:02.980",
      "text": "خواهد این رو بازا بخور پرس میده میخور دیگه"
    },
    {
      "id": 46,
      "start": 10682.98,
      "end": 10685.98,
      "formatted_start": "02:58:02.980",
      "formatted_end": "02:58:05.980",
      "text": "من پرازا بخوردم من چند روز پومدیده میخوردم"
    },
    {
      "id": 47,
      "start": 10685.98,
      "end": 10689.98,
      "formatted_start": "02:58:05.980",
      "formatted_end": "02:58:09.980",
      "text": "اصلا هیچ تاثیر ندارم بگم با حال تعبال شدیدم"
    },
    {
      "id": 48,
      "start": 10689.98,
      "end": 10691.98,
      "formatted_start": "02:58:09.980",
      "formatted_end": "02:58:11.980",
      "text": "پنده رو تو صبح و شب بخورم"
    },
    {
      "id": 49,
      "start": 10691.98,
      "end": 10692.98,
      "formatted_start": "02:58:11.980",
      "formatted_end": "02:58:12.980",
      "text": "آره صبح و شب بخورم"
    },
    {
      "id": 50,
      "start": 10692.98,
      "end": 10694.98,
      "formatted_start": "02:58:12.980",
      "formatted_end": "02:58:14.980",
      "text": "پپتی لاکیو میبسن"
    },
    {
      "id": 51,
      "start": 10695.98,
      "end": 10698.98,
      "formatted_start": "02:58:15.980",
      "formatted_end": "02:58:18.980",
      "text": "خل باید بخور باید غذا"
    },
    {
      "id": 52,
      "start": 10698.98,
      "end": 10703.98,
      "formatted_start": "02:58:18.980",
      "formatted_end": "02:58:23.980",
      "text": "صبح که بیدم شیخ رو آشق اصلا تو دن سفنجون آبو بردم بخور"
    },
    {
      "id": 53,
      "start": 10703.98,
      "end": 10707.98,
      "formatted_start": "02:58:23.980",
      "formatted_end": "02:58:27.980",
      "text": "بعد قصد هم یه ذره برنج باشه یه ذره گوشت آباز"
    },
    {
      "id": 54,
      "start": 10707.98,
      "end": 10709.98,
      "formatted_start": "02:58:27.980",
      "formatted_end": "02:58:29.980",
      "text": "برنج؟"
    },
    {
      "id": 55,
      "start": 10709.98,
      "end": 10711.98,
      "formatted_start": "02:58:29.980",
      "formatted_end": "02:58:31.980",
      "text": "برنج اصلا نخورید"
    },
    {
      "id": 56,
      "start": 10711.98,
      "end": 10713.98,
      "formatted_start": "02:58:31.980",
      "formatted_end": "02:58:33.980",
      "text": "شام هم مثلا یه تقمان آباز"
    },
    {
      "id": 57,
      "start": 10713.98,
      "end": 10715.98,
      "formatted_start": "02:58:33.980",
      "formatted_end": "02:58:35.980",
      "text": "حالا اون حد و اون هم سنگینه"
    },
    {
      "id": 58,
      "start": 10715.98,
      "end": 10717.98,
      "formatted_start": "02:58:35.980",
      "formatted_end": "02:58:37.980",
      "text": "یه تکه سینه مرگ آباز بانه"
    },
    {
      "id": 59,
      "start": 10717.98,
      "end": 10718.98,
      "formatted_start": "02:58:37.980",
      "formatted_end": "02:58:38.980",
      "text": "ماستی چیزی نخورید؟"
    },
    {
      "id": 60,
      "start": 10718.98,
      "end": 10719.98,
      "formatted_start": "02:58:38.980",
      "formatted_end": "02:58:39.980",
      "text": "نه ماست هایی نخورم"
    },
    {
      "id": 61,
      "start": 10719.98,
      "end": 10721.98,
      "formatted_start": "02:58:39.980",
      "formatted_end": "02:58:41.980",
      "text": "لبن یاد اصلا فیلن نخورید"
    },
    {
      "id": 62,
      "start": 10721.98,
      "end": 10725.98,
      "formatted_start": "02:58:41.980",
      "formatted_end": "02:58:45.980",
      "text": "اصلا یه ذره نون و مالکای مثلا به کره خامه نباشه"
    },
    {
      "id": 63,
      "start": 10725.98,
      "end": 10729.98,
      "formatted_start": "02:58:45.980",
      "formatted_end": "02:58:49.980",
      "text": "من این رو که اصلا بسا خانه و کرد کنم نزدم"
    },
    {
      "id": 64,
      "start": 10729.98,
      "end": 10733.98,
      "formatted_start": "02:58:49.980",
      "formatted_end": "02:58:53.980",
      "text": "مکارانی، سو، آش، مادر جمعه"
    },
    {
      "id": 65,
      "start": 10733.98,
      "end": 10739.98,
      "formatted_start": "02:58:53.980",
      "formatted_end": "02:58:59.980",
      "text": "من اگه خانه روز جمعه بیشتر چی شد رفتم خانه آبچین جاتون خالی از این دیگه تو سرخون گرفت و مرگو بذاشت"
    },
    {
      "id": 66,
      "start": 10739.98,
      "end": 10742.98,
      "formatted_start": "02:58:59.980",
      "formatted_end": "02:59:02.980",
      "text": "همونو خوردم، یک همون میدم همونو"
    },
    {
      "id": 67,
      "start": 10742.98,
      "end": 10745.98,
      "formatted_start": "02:59:02.980",
      "formatted_end": "02:59:05.980",
      "text": "غذای کباب به شده دیر هزمی"
    },
    {
      "id": 68,
      "start": 10745.98,
      "end": 10748.98,
      "formatted_start": "02:59:05.980",
      "formatted_end": "02:59:08.980",
      "text": "اوه من آن پایین بزن کم آرام شید"
    },
    {
      "id": 69,
      "start": 10748.98,
      "end": 10750.98,
      "formatted_start": "02:59:08.980",
      "formatted_end": "02:59:10.980",
      "text": "دردت نیست سره"
    },
    {
      "id": 70,
      "start": 10750.98,
      "end": 10751.98,
      "formatted_start": "02:59:10.980",
      "formatted_end": "02:59:11.980",
      "text": "آره"
    },
    {
      "id": 71,
      "start": 10751.98,
      "end": 10754.98,
      "formatted_start": "02:59:11.980",
      "formatted_end": "02:59:14.980",
      "text": "گشه ها صبح و آخر شب درم برد"
    },
    {
      "id": 72,
      "start": 10755.98,
      "end": 10758.98,
      "formatted_start": "02:59:15.980",
      "formatted_end": "02:59:18.980",
      "text": "اون شهر صحبه، اصلا شب"
    },
    {
      "id": 73,
      "start": 10760.98,
      "end": 10762.98,
      "formatted_start": "02:59:20.980",
      "formatted_end": "02:59:22.980",
      "text": "وقتی آخر شب"
    },
    {
      "id": 74,
      "start": 10763.98,
      "end": 10769.98,
      "formatted_start": "02:59:23.980",
      "formatted_end": "02:59:29.980",
      "text": "از این دیشه ها میبخواد شبانه بلند شد و اینجا برم، اینقدر که دردم شدید بود باز بود"
    },
    {
      "id": 75,
      "start": 10769.98,
      "end": 10772.98,
      "formatted_start": "02:59:29.980",
      "formatted_end": "02:59:32.980",
      "text": "پس بیس بخواد نوزم شبت رو تبا خواهیم"
    },
    {
      "id": 76,
      "start": 10772.98,
      "end": 10782.38,
      "formatted_start": "02:59:32.980",
      "formatted_end": "02:59:42.380",
      "text": "اولش اینکه یه طرف بردی صورت همه قشنگ کشم و دندونم و سرم و دندشت دید"
    },
    {
      "id": 77,
      "start": 10782.38,
      "end": 10787.58,
      "formatted_start": "02:59:42.380",
      "formatted_end": "02:59:47.580",
      "text": "یه نوافه هم خوردم و یه خوب شدم"
    },
    {
      "id": 78,
      "start": 10787.58,
      "end": 10790.64,
      "formatted_start": "02:59:47.580",
      "formatted_end": "02:59:50.640",
      "text": "سمان میبره میده که یه چیزی زخم کردن"
    },
    {
      "id": 79,
      "start": 10790.64,
      "end": 10792.12,
      "formatted_start": "02:59:50.640",
      "formatted_end": "02:59:52.120",
      "text": "فلکس داره میکنه"
    },
    {
      "id": 80,
      "start": 10792.12,
      "end": 10795.64,
      "formatted_start": "02:59:52.120",
      "formatted_end": "02:59:55.640",
      "text": "برشی بوده شدید رو مزیدی کردن"
    },
    {
      "id": 81,
      "start": 10795.64,
      "end": 10797.98,
      "formatted_start": "02:59:55.640",
      "formatted_end": "02:59:57.980",
      "text": "فعلا قضات همه آب هست"
    },
    {
      "id": 82,
      "start": 10797.98,
      "end": 10799.4,
      "formatted_start": "02:59:57.980",
      "formatted_end": "02:59:59.400",
      "text": "آبکی اصلا"
    }
  ],
  "status": "completed"
}