  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13210.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:10.000",
      "text": "ببینید که اینجا باشه و خودتون خیلی راحت بردارید."
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13232.0,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:32.000",
      "text": "نمیشه. روماتیز چی؟"
    },
    {
      "id": 2,
      "start": 13232.0,
      "end": 13233.0,
      "formatted_start": "03:40:32.000",
      "formatted_end": "03:40:33.000",
      "text": "نه."
    },
    {
      "id": 3,
      "start": 13233.0,
      "end": 13234.0,
      "formatted_start": "03:40:33.000",
      "formatted_end": "03:40:34.000",
      "text": "بعدو نمیشه؟"
    },
    {
      "id": 4,
      "start": 13234.0,
      "end": 13236.0,
      "formatted_start": "03:40:34.000",
      "formatted_end": "03:40:36.000",
      "text": "خیلی داروش گرد شد."
    },
    {
      "id": 5,
      "start": 13236.0,
      "end": 13239.0,
      "formatted_start": "03:40:36.000",
      "formatted_end": "03:40:39.000",
      "text": "باید چرا؟"
    },
    {
      "id": 6,
      "start": 13239.0,
      "end": 13242.0,
      "formatted_start": "03:40:39.000",
      "formatted_end": "03:40:42.000",
      "text": "من این داروها رو هفته پرده ایشون."
    },
    {
      "id": 7,
      "start": 13242.0,
      "end": 13244.0,
      "formatted_start": "03:40:42.000",
      "formatted_end": "03:40:44.000",
      "text": "سرقیتی از گرام بود."
    },
    {
      "id": 8,
      "start": 13244.0,
      "end": 13245.0,
      "formatted_start": "03:40:44.000",
      "formatted_end": "03:40:45.000",
      "text": "شروعی بود."
    },
    {
      "id": 9,
      "start": 13245.0,
      "end": 13246.0,
      "formatted_start": "03:40:45.000",
      "formatted_end": "03:40:46.000",
      "text": "الان براتو میدونستم."
    },
    {
      "id": 10,
      "start": 13246.0,
      "end": 13247.0,
      "formatted_start": "03:40:46.000",
      "formatted_end": "03:40:47.000",
      "text": "تموم شد داروها؟"
    },
    {
      "id": 11,
      "start": 13247.0,
      "end": 13248.0,
      "formatted_start": "03:40:47.000",
      "formatted_end": "03:40:48.000",
      "text": "نه."
    },
    {
      "id": 12,
      "start": 13248.0,
      "end": 13249.0,
      "formatted_start": "03:40:48.000",
      "formatted_end": "03:40:49.000",
      "text": "همین."
    },
    {
      "id": 13,
      "start": 13249.0,
      "end": 13250.0,
      "formatted_start": "03:40:49.000",
      "formatted_end": "03:40:50.000",
      "text": "الان من براتو میدونستم."
    },
    {
      "id": 14,
      "start": 13250.0,
      "end": 13251.0,
      "formatted_start": "03:40:50.000",
      "formatted_end": "03:40:51.000",
      "text": "دور."
    },
    {
      "id": 15,
      "start": 13251.0,
      "end": 13252.0,
      "formatted_start": "03:40:51.000",
      "formatted_end": "03:40:52.000",
      "text": "بشکنم اومد بیرون."
    },
    {
      "id": 16,
      "start": 13252.0,
      "end": 13254.0,
      "formatted_start": "03:40:52.000",
      "formatted_end": "03:40:54.000",
      "text": "ایدروکسی کورورکی یه موقع نبود."
    },
    {
      "id": 17,
      "start": 13254.0,
      "end": 13256.0,
      "formatted_start": "03:40:54.000",
      "formatted_end": "03:40:56.000",
      "text": "بازا بازا درش 600 تومه میدادن."
    },
    {
      "id": 18,
      "start": 13256.0,
      "end": 13262.0,
      "formatted_start": "03:40:56.000",
      "formatted_end": "03:41:02.000",
      "text": "اینجا باید ترقیت اینها را استفاده کنید"
    },
    {
      "id": 19,
      "start": 13262.0,
      "end": 13266.0,
      "formatted_start": "03:41:02.000",
      "formatted_end": "03:41:06.000",
      "text": "که از اینجا باید مزه نشانی کنید"
    },
    {
      "id": 20,
      "start": 13266.0,
      "end": 13270.0,
      "formatted_start": "03:41:06.000",
      "formatted_end": "03:41:10.000",
      "text": "از اینجا باید مزه نشانی کنید"
    },
    {
      "id": 21,
      "start": 13270.0,
      "end": 13274.0,
      "formatted_start": "03:41:10.000",
      "formatted_end": "03:41:14.000",
      "text": "از اینجا باید مزه نشانی کنید"
    },
    {
      "id": 22,
      "start": 13274.0,
      "end": 13278.0,
      "formatted_start": "03:41:14.000",
      "formatted_end": "03:41:18.000",
      "text": "از اینجا باید مزه نشانی کنید"
    },
    {
      "id": 23,
      "start": 13278.0,
      "end": 13282.0,
      "formatted_start": "03:41:18.000",
      "formatted_end": "03:41:22.000",
      "text": "از اینجا باید مزه نشانی کنید"
    },
    {
      "id": 24,
      "start": 13282.0,
      "end": 13290.0,
      "formatted_start": "03:41:22.000",
      "formatted_end": "03:41:30.000",
      "text": "خانم دکتور خیلی اصلا ستون فقراتمون با زانوهام و انگشتام خیلی درم میکنن"
    },
    {
      "id": 25,
      "start": 13290.0,
      "end": 13292.0,
      "formatted_start": "03:41:30.000",
      "formatted_end": "03:41:32.000",
      "text": "الان همه که درگاه میخوری؟"
    },
    {
      "id": 26,
      "start": 13292.0,
      "end": 13293.0,
      "formatted_start": "03:41:32.000",
      "formatted_end": "03:41:33.000",
      "text": "آره"
    },
    {
      "id": 27,
      "start": 13293.0,
      "end": 13301.0,
      "formatted_start": "03:41:33.000",
      "formatted_end": "03:41:41.000",
      "text": "استرس اصلا نباید داشته باشه، سرما دشمنه ده، آب دشمنه ده، خیلی با آب و شست داشته باشه این کارو نباید بگوییم"
    },
    {
      "id": 28,
      "start": 13301.0,
      "end": 13306.0,
      "formatted_start": "03:41:41.000",
      "formatted_end": "03:41:46.000",
      "text": "صرف میشون اصلا بد از گشت داشته باشه، کل رو اینا نوزید روشن باشه، اینا دشمنه دارن"
    },
    {
      "id": 29,
      "start": 13306.0,
      "end": 13310.0,
      "formatted_start": "03:41:46.000",
      "formatted_end": "03:41:50.000",
      "text": "بد کل رو اصلا خاموش میکنم، نفسم میمونه"
    },
    {
      "id": 30,
      "start": 13310.0,
      "end": 13316.0,
      "formatted_start": "03:41:50.000",
      "formatted_end": "03:41:56.000",
      "text": "دیگه کم کم خودتو عادت بگه یعنی تو اون اتاقی که کلیه را نخواه پرد تو اتاقه دیگه"
    },
    {
      "id": 31,
      "start": 13316.0,
      "end": 13318.0,
      "formatted_start": "03:41:56.000",
      "formatted_end": "03:41:58.000",
      "text": "چون دشمنه توه"
    },
    {
      "id": 32,
      "start": 13318.0,
      "end": 13321.0,
      "formatted_start": "03:41:58.000",
      "formatted_end": "03:42:01.000",
      "text": "داری امتیکسه تا با دوز بالا میخوری"
    },
    {
      "id": 33,
      "start": 13321.0,
      "end": 13326.0,
      "formatted_start": "03:42:01.000",
      "formatted_end": "03:42:06.000",
      "text": "یعنی دوانیم شیش عدد داراتو با دوز خوبی داری"
    },
    {
      "id": 34,
      "start": 13326.0,
      "end": 13328.0,
      "formatted_start": "03:42:06.000",
      "formatted_end": "03:42:08.000",
      "text": "یعنی میخوری کم نیز"
    },
    {
      "id": 35,
      "start": 13328.0,
      "end": 13332.0,
      "formatted_start": "03:42:08.000",
      "formatted_end": "03:42:12.000",
      "text": "از اسطفه بعد از اینکه جواب نگیری"
    },
    {
      "id": 36,
      "start": 13332.0,
      "end": 13334.0,
      "formatted_start": "03:42:12.000",
      "formatted_end": "03:42:14.000",
      "text": "نسان باید بگیری داروی تزرگی"
    },
    {
      "id": 37,
      "start": 13334.0,
      "end": 13336.0,
      "formatted_start": "03:42:14.000",
      "formatted_end": "03:42:16.000",
      "text": "ایلادی هم نداره"
    },
    {
      "id": 38,
      "start": 13336.0,
      "end": 13338.0,
      "formatted_start": "03:42:16.000",
      "formatted_end": "03:42:18.000",
      "text": "هر سه چیزی با داروی میداری"
    },
    {
      "id": 39,
      "start": 13338.0,
      "end": 13340.0,
      "formatted_start": "03:42:18.000",
      "formatted_end": "03:42:20.000",
      "text": "همه ترجیلی رو بگو با دمتان میتونی داره"
    },
    {
      "id": 40,
      "start": 13340.0,
      "end": 13342.0,
      "formatted_start": "03:42:20.000",
      "formatted_end": "03:42:22.000",
      "text": "درست داره"
    },
    {
      "id": 41,
      "start": 13342.0,
      "end": 13344.0,
      "formatted_start": "03:42:22.000",
      "formatted_end": "03:42:24.000",
      "text": "من اون دنبالاتو باید بکنم"
    },
    {
      "id": 42,
      "start": 13344.0,
      "end": 13346.0,
      "formatted_start": "03:42:24.000",
      "formatted_end": "03:42:26.000",
      "text": "دوست دارم برو بگو که این چی بکنه"
    },
    {
      "id": 43,
      "start": 13346.0,
      "end": 13348.0,
      "formatted_start": "03:42:26.000",
      "formatted_end": "03:42:28.000",
      "text": "خانم دکتر"
    },
    {
      "id": 44,
      "start": 13348.0,
      "end": 13350.0,
      "formatted_start": "03:42:28.000",
      "formatted_end": "03:42:30.000",
      "text": "یه چیزی بگیره"
    },
    {
      "id": 45,
      "start": 13350.0,
      "end": 13352.0,
      "formatted_start": "03:42:30.000",
      "formatted_end": "03:42:32.000",
      "text": "حتما وزنم خیلی اومد پایین"
    },
    {
      "id": 46,
      "start": 13352.0,
      "end": 13354.0,
      "formatted_start": "03:42:32.000",
      "formatted_end": "03:42:34.000",
      "text": "خیلی پایش وز داشتم"
    },
    {
      "id": 47,
      "start": 13354.0,
      "end": 13356.0,
      "formatted_start": "03:42:34.000",
      "formatted_end": "03:42:36.000",
      "text": "اصلا نمیتونم"
    },
    {
      "id": 48,
      "start": 13356.0,
      "end": 13358.0,
      "formatted_start": "03:42:36.000",
      "formatted_end": "03:42:38.000",
      "text": "هیچ غذایی بخورم"
    },
    {
      "id": 49,
      "start": 13358.0,
      "end": 13360.0,
      "formatted_start": "03:42:38.000",
      "formatted_end": "03:42:40.000",
      "text": "هر غذایی همیخورم"
    },
    {
      "id": 50,
      "start": 13360.0,
      "end": 13362.0,
      "formatted_start": "03:42:40.000",
      "formatted_end": "03:42:42.000",
      "text": "دلدرد میشم"
    },
    {
      "id": 51,
      "start": 13362.0,
      "end": 13364.0,
      "formatted_start": "03:42:42.000",
      "formatted_end": "03:42:44.000",
      "text": "اصلا اشتها هم سر"
    },
    {
      "id": 52,
      "start": 13364.0,
      "end": 13366.0,
      "formatted_start": "03:42:44.000",
      "formatted_end": "03:42:46.000",
      "text": "اصلا گاشتای مهده نخوردی نه"
    },
    {
      "id": 53,
      "start": 13366.0,
      "end": 13368.0,
      "formatted_start": "03:42:46.000",
      "formatted_end": "03:42:48.000",
      "text": "نه اشتهامم اصلا کده..."
    },
    {
      "id": 54,
      "start": 13368.0,
      "end": 13370.0,
      "formatted_start": "03:42:48.000",
      "formatted_end": "03:42:50.000",
      "text": "تو باید حتما با این دارو برس ناشته مده میخوردی"
    },
    {
      "id": 55,
      "start": 13370.0,
      "end": 13372.0,
      "formatted_start": "03:42:50.000",
      "formatted_end": "03:42:52.000",
      "text": "مده دلتا بده کرده"
    },
    {
      "id": 56,
      "start": 13374.0,
      "end": 13376.0,
      "formatted_start": "03:42:54.000",
      "formatted_end": "03:42:56.000",
      "text": "و هم اشتنات از مده"
    },
    {
      "id": 57,
      "start": 13378.0,
      "end": 13380.0,
      "formatted_start": "03:42:58.000",
      "formatted_end": "03:43:00.000",
      "text": "این دارو نمیشه همش خوب میشه"
    },
    {
      "id": 58,
      "start": 13380.0,
      "end": 13382.0,
      "formatted_start": "03:43:00.000",
      "formatted_end": "03:43:02.000",
      "text": "اولش که مثلا"
    },
    {
      "id": 59,
      "start": 13382.0,
      "end": 13384.0,
      "formatted_start": "03:43:02.000",
      "formatted_end": "03:43:04.000",
      "text": "هنوز نمیدونست این باب این ماجی رو دارم"
    },
    {
      "id": 60,
      "start": 13384.0,
      "end": 13386.0,
      "formatted_start": "03:43:04.000",
      "formatted_end": "03:43:06.000",
      "text": "فکر میکردم حاملم"
    },
    {
      "id": 61,
      "start": 13386.0,
      "end": 13388.0,
      "formatted_start": "03:43:06.000",
      "formatted_end": "03:43:08.000",
      "text": "دوباره چون حالت"
    },
    {
      "id": 62,
      "start": 13388.0,
      "end": 13390.0,
      "formatted_start": "03:43:08.000",
      "formatted_end": "03:43:10.000",
      "text": "اصلا کده اصلا غذا شروع شد"
    },
    {
      "id": 63,
      "start": 13390.0,
      "end": 13392.0,
      "formatted_start": "03:43:10.000",
      "formatted_end": "03:43:12.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 64,
      "start": 13392.0,
      "end": 13394.0,
      "formatted_start": "03:43:12.000",
      "formatted_end": "03:43:14.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 65,
      "start": 13394.0,
      "end": 13396.0,
      "formatted_start": "03:43:14.000",
      "formatted_end": "03:43:16.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 66,
      "start": 13396.0,
      "end": 13398.0,
      "formatted_start": "03:43:16.000",
      "formatted_end": "03:43:18.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 67,
      "start": 13398.0,
      "end": 13400.0,
      "formatted_start": "03:43:18.000",
      "formatted_end": "03:43:20.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 68,
      "start": 13400.0,
      "end": 13402.0,
      "formatted_start": "03:43:20.000",
      "formatted_end": "03:43:22.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 69,
      "start": 13402.0,
      "end": 13404.0,
      "formatted_start": "03:43:22.000",
      "formatted_end": "03:43:24.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 70,
      "start": 13404.0,
      "end": 13406.0,
      "formatted_start": "03:43:24.000",
      "formatted_end": "03:43:26.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 71,
      "start": 13406.0,
      "end": 13408.0,
      "formatted_start": "03:43:26.000",
      "formatted_end": "03:43:28.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 72,
      "start": 13408.0,
      "end": 13410.0,
      "formatted_start": "03:43:28.000",
      "formatted_end": "03:43:30.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 73,
      "start": 13410.0,
      "end": 13412.0,
      "formatted_start": "03:43:30.000",
      "formatted_end": "03:43:32.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 74,
      "start": 13412.0,
      "end": 13414.0,
      "formatted_start": "03:43:32.000",
      "formatted_end": "03:43:34.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 75,
      "start": 13414.0,
      "end": 13416.0,
      "formatted_start": "03:43:34.000",
      "formatted_end": "03:43:36.000",
      "text": "از اینجا باید بخورید"
    },
    {
      "id": 76,
      "start": 13416.0,
      "end": 13421.0,
      "formatted_start": "03:43:36.000",
      "formatted_end": "03:43:41.000",
      "text": "اینجا جنتیک مصدقه باشه"
    },
    {
      "id": 77,
      "start": 13421.0,
      "end": 13424.0,
      "formatted_start": "03:43:41.000",
      "formatted_end": "03:43:44.000",
      "text": "از تو خودت که این نمیدونی دختر باشه"
    },
    {
      "id": 78,
      "start": 13424.0,
      "end": 13430.0,
      "formatted_start": "03:43:44.000",
      "formatted_end": "03:43:50.000",
      "text": "اما اگر تو آروم باشی، استرس نداشته باشی بیماری تو من نیست"
    },
    {
      "id": 79,
      "start": 13430.0,
      "end": 13433.0,
      "formatted_start": "03:43:50.000",
      "formatted_end": "03:43:53.000",
      "text": "به هیچ عنوان حامله نمیشه"
    },
    {
      "id": 80,
      "start": 13433.0,
      "end": 13441.0,
      "formatted_start": "03:43:53.000",
      "formatted_end": "03:44:01.000",
      "text": "نه، تنها هم که حامله نمیتونم، استرس در واقع ناخدایت با یک دلشوره بدی میگیرن"
    },
    {
      "id": 81,
      "start": 13441.0,
      "end": 13442.0,
      "formatted_start": "03:44:01.000",
      "formatted_end": "03:44:02.000",
      "text": "که یه همیشه؟"
    },
    {
      "id": 82,
      "start": 13442.0,
      "end": 13444.0,
      "formatted_start": "03:44:02.000",
      "formatted_end": "03:44:04.000",
      "text": "همیشه"
    },
    {
      "id": 83,
      "start": 13444.0,
      "end": 13445.0,
      "formatted_start": "03:44:04.000",
      "formatted_end": "03:44:05.000",
      "text": "شب خوبی خواهی؟"
    },
    {
      "id": 84,
      "start": 13445.0,
      "end": 13446.0,
      "formatted_start": "03:44:05.000",
      "formatted_end": "03:44:06.000",
      "text": "نه"
    },
    {
      "id": 85,
      "start": 13447.3,
      "end": 13450.0,
      "formatted_start": "03:44:07.300",
      "formatted_end": "03:44:10.000",
      "text": "پس شبه دستام نیخواره"
    },
    {
      "id": 86,
      "start": 13450.0,
      "end": 13453.0,
      "formatted_start": "03:44:10.000",
      "formatted_end": "03:44:13.000",
      "text": "جوری که اصلا دوستانم بگیرن همه گشتامو"
    },
    {
      "id": 87,
      "start": 13453.0,
      "end": 13455.0,
      "formatted_start": "03:44:13.000",
      "formatted_end": "03:44:15.000",
      "text": "تو حساسیت و الارژی زیاده ازم"
    },
    {
      "id": 88,
      "start": 13455.0,
      "end": 13457.0,
      "formatted_start": "03:44:15.000",
      "formatted_end": "03:44:17.000",
      "text": "ما دارو به دارو هم حساسیت بدیم"
    },
    {
      "id": 89,
      "start": 13459.0,
      "end": 13461.0,
      "formatted_start": "03:44:19.000",
      "formatted_end": "03:44:21.000",
      "text": "نه، بعضی موقع هم شد"
    },
    {
      "id": 90,
      "start": 13461.0,
      "end": 13463.0,
      "formatted_start": "03:44:21.000",
      "formatted_end": "03:44:23.000",
      "text": "خب ببین چی میخوری؟"
    },
    {
      "id": 91,
      "start": 13463.0,
      "end": 13465.0,
      "formatted_start": "03:44:23.000",
