  "stt_segments": [
    {
      "id": 0,
      "start": 15600.0,
      "end": 15630.0,
      "formatted_start": "04:20:00.000",
      "formatted_end": "04:20:30.000",
      "text": "اما از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این حالت، از این ح"
    },
    {
      "id": 1,
      "start": 15630.0,
      "end": 15632.0,
      "formatted_start": "04:20:30.000",
      "formatted_end": "04:20:32.000",
      "text": "از اینکه تو چک کردی ببینی نزدیکی هست"
    },
    {
      "id": 2,
      "start": 15632.0,
      "end": 15634.0,
      "formatted_start": "04:20:32.000",
      "formatted_end": "04:20:34.000",
      "text": "من آخری آزمایشو دادم اینه"
    },
    {
      "id": 3,
      "start": 15634.0,
      "end": 15636.0,
      "formatted_start": "04:20:34.000",
      "formatted_end": "04:20:36.000",
      "text": "گفتم الان باز یه دوره بمیتونیم"
    },
    {
      "id": 4,
      "start": 15636.0,
      "end": 15638.0,
      "formatted_start": "04:20:36.000",
      "formatted_end": "04:20:38.000",
      "text": "نه بسندولات هم پایینه چرا"
    },
    {
      "id": 5,
      "start": 15638.0,
      "end": 15640.0,
      "formatted_start": "04:20:38.000",
      "formatted_end": "04:20:40.000",
      "text": "ببینید زینکم اینها آمده بالا"
    },
    {
      "id": 6,
      "start": 15640.0,
      "end": 15642.0,
      "formatted_start": "04:20:40.000",
      "formatted_end": "04:20:42.000",
      "text": "زینک اصلا عرضشو چک کردن"
    },
    {
      "id": 7,
      "start": 15642.0,
      "end": 15644.0,
      "formatted_start": "04:20:42.000",
      "formatted_end": "04:20:44.000",
      "text": "یا بیتامین ریم"
    },
    {
      "id": 8,
      "start": 15644.0,
      "end": 15646.0,
      "formatted_start": "04:20:44.000",
      "formatted_end": "04:20:46.000",
      "text": "یا گل بل سفیر هم باز"
    },
    {
      "id": 9,
      "start": 15646.0,
      "end": 15648.0,
      "formatted_start": "04:20:46.000",
      "formatted_end": "04:20:48.000",
      "text": "بعد افزه الهت خیلی مهم رو گره"
    },
    {
      "id": 10,
      "start": 15648.0,
      "end": 15650.0,
      "formatted_start": "04:20:48.000",
      "formatted_end": "04:20:50.000",
      "text": "آیا نزدیک به یا استقیقی هستی اصلا یا نه"
    },
    {
      "id": 11,
      "start": 15650.0,
      "end": 15652.0,
      "formatted_start": "04:20:50.000",
      "formatted_end": "04:20:52.000",
      "text": "نه آزمایشو هرمونی منظورتونه ندادم تا آیا"
    },
    {
      "id": 12,
      "start": 15652.0,
      "end": 15656.0,
      "formatted_start": "04:20:52.000",
      "formatted_end": "04:20:56.000",
      "text": "نه، آزمایش هرمونی منظورتونه ندادم تا آیا"
    },
    {
      "id": 13,
      "start": 15656.0,
      "end": 15662.0,
      "formatted_start": "04:20:56.000",
      "formatted_end": "04:21:02.000",
      "text": "اگه نزدیک به یه هستگی نباشی، وقتی زیاد امر شدید باشه، مشکلی به خودتون برداریم"
    },
    {
      "id": 14,
      "start": 15662.0,
      "end": 15666.0,
      "formatted_start": "04:21:02.000",
      "formatted_end": "04:21:06.000",
      "text": "من شدید گلم می آمیدی، چند سال شدید ها؟"
    },
    {
      "id": 15,
      "start": 15666.0,
      "end": 15669.0,
      "formatted_start": "04:21:06.000",
      "formatted_end": "04:21:09.000",
      "text": "تازه که شدید نشده اینجا"
    },
    {
      "id": 16,
      "start": 15669.0,
      "end": 15672.0,
      "formatted_start": "04:21:09.000",
      "formatted_end": "04:21:12.000",
      "text": "این هم که مورد فاپسپیرو قبلمه، فاپسپیرو جدیده"
    },
    {
      "id": 17,
      "start": 15672.0,
      "end": 15676.0,
      "formatted_start": "04:21:12.000",
      "formatted_end": "04:21:16.000",
      "text": "و این نمونه هم که از من گرفت دکتر آزادگاه جمهورگان"
    },
    {
      "id": 18,
      "start": 15676.0,
      "end": 15681.0,
      "formatted_start": "04:21:16.000",
      "formatted_end": "04:21:21.000",
      "text": "ولی لختی خون بوده نتونه پای پیر برام گرفت تو مذهبش"
    },
    {
      "id": 19,
      "start": 15681.0,
      "end": 15685.0,
      "formatted_start": "04:21:21.000",
      "formatted_end": "04:21:25.000",
      "text": "چرا برای تشخیصی بوده پای پیر برام داره"
    },
    {
      "id": 20,
      "start": 15685.0,
      "end": 15690.0,
      "formatted_start": "04:21:25.000",
      "formatted_end": "04:21:30.000",
      "text": "چرا رو خوردی هم گرفت ولی نتونسته نمونه کاملا دیوار رحمت بگرفت"
    },
    {
      "id": 21,
      "start": 15690.0,
      "end": 15693.0,
      "formatted_start": "04:21:30.000",
      "formatted_end": "04:21:33.000",
      "text": "اونجوری که خودم اتوجه شدم لختی خونه"
    },
    {
      "id": 22,
      "start": 15693.0,
      "end": 15694.0,
      "formatted_start": "04:21:33.000",
      "formatted_end": "04:21:34.000",
      "text": "حسده؟"
    },
    {
      "id": 23,
      "start": 15694.0,
      "end": 15695.0,
      "formatted_start": "04:21:34.000",
      "formatted_end": "04:21:35.000",
      "text": "نه"
    },
    {
      "id": 24,
      "start": 15695.0,
      "end": 15700.0,
      "formatted_start": "04:21:35.000",
      "formatted_end": "04:21:40.000",
      "text": "برم برم بشنشون برم بگم چی بگم من برم بگم درستن گرفتی نمونه رو"
    },
    {
      "id": 25,
      "start": 15700.0,
      "end": 15707.0,
      "formatted_start": "04:21:40.000",
      "formatted_end": "04:21:47.000",
      "text": "من اگر میدونستم یک تورتویست بگیره، خب میرفتم برداشت خشکسه میکردم"
    },
    {
      "id": 26,
      "start": 15707.0,
      "end": 15715.0,
      "formatted_start": "04:21:47.000",
      "formatted_end": "04:21:55.000",
      "text": "حالا که این همه راه برسید، یک روز اول من میگفتم برو پیش دردتور تاونده گرگان، اگر قرار بود تا گرگان بگیریم"
    },
    {
      "id": 27,
      "start": 15715.0,
      "end": 15719.0,
      "formatted_start": "04:21:55.000",
      "formatted_end": "04:21:59.000",
      "text": "دوتاونده چون جمعی نه، این همه از دست دردتور تاونده"
    },
    {
      "id": 28,
      "start": 15719.0,
      "end": 15722.0,
      "formatted_start": "04:21:59.000",
      "formatted_end": "04:22:02.000",
      "text": "دوتاونده که آقا هست یا خانمه؟"
    },
    {
      "id": 29,
      "start": 15722.0,
      "end": 15723.0,
      "formatted_start": "04:22:02.000",
      "formatted_end": "04:22:03.000",
      "text": "خانمه؟"
    },
    {
      "id": 30,
      "start": 15723.0,
      "end": 15728.0,
      "formatted_start": "04:22:03.000",
      "formatted_end": "04:22:08.000",
      "text": "افثانه تاونده، خانمه شست سا پرده، یه سال هست، بس دردن اینها بود"
    },
    {
      "id": 31,
      "start": 15730.0,
      "end": 15732.44,
      "formatted_start": "04:22:10.000",
      "formatted_end": "04:22:12.440",
      "text": "این دو تا خوهرکه که به قدر بیمار دارن"
    },
    {
      "id": 32,
      "start": 15732.44,
      "end": 15734.9,
      "formatted_start": "04:22:12.440",
      "formatted_end": "04:22:14.900",
      "text": "یعنی گفتن دیگه مثل اینا تو گرگان نیست"
    },
    {
      "id": 33,
      "start": 15734.9,
      "end": 15739.9,
      "formatted_start": "04:22:14.900",
      "formatted_end": "04:22:19.900",
      "text": "من نمیگم کارشون کنید خب در جراحی خب مثل آشپزیه"
    },
    {
      "id": 34,
      "start": 15739.9,
      "end": 15740.9,
      "formatted_start": "04:22:19.900",
      "formatted_end": "04:22:20.900",
      "text": "تجربه خوب دیگه"
    },
    {
      "id": 35,
      "start": 15740.9,
      "end": 15741.9,
      "formatted_start": "04:22:20.900",
      "formatted_end": "04:22:21.900",
      "text": "بله"
    },
    {
      "id": 36,
      "start": 15741.9,
      "end": 15747.9,
      "formatted_start": "04:22:21.900",
      "formatted_end": "04:22:27.900",
      "text": "میتونست به من بگی من نمونه میگیرم ولی شاید نشه نمونه مثلا کاملی برداشته باشیم که میتونم تستش انجام بدم"
    },
    {
      "id": 37,
      "start": 15750.9,
      "end": 15753.9,
      "formatted_start": "04:22:30.900",
      "formatted_end": "04:22:33.900",
      "text": "و من بیادم آزمایش هر چی نیازه برام بنیستیم"
    },
    {
      "id": 38,
      "start": 15754.9,
      "end": 15756.9,
      "formatted_start": "04:22:34.900",
      "formatted_end": "04:22:36.900",
      "text": "حالا ویتامین پی من تیو"
    },
    {
      "id": 39,
      "start": 15756.9,
      "end": 15757.9,
      "formatted_start": "04:22:36.900",
      "formatted_end": "04:22:37.900",
      "text": "هر موانات هم چک میکنن"
    },
    {
      "id": 40,
      "start": 15757.9,
      "end": 15758.9,
      "formatted_start": "04:22:37.900",
      "formatted_end": "04:22:38.900",
      "text": "آره"
    },
    {
      "id": 41,
      "start": 15758.9,
      "end": 15762.9,
      "formatted_start": "04:22:38.900",
      "formatted_end": "04:22:42.900",
      "text": "و راست که هرمون چون من الان دارم فرس و هرمونی میخورم من نمیتونم دارم"
    },
    {
      "id": 42,
      "start": 15762.9,
      "end": 15764.9,
      "formatted_start": "04:22:42.900",
      "formatted_end": "04:22:44.900",
      "text": "میشه؟ ربطی نداریم."
    },
    {
      "id": 43,
      "start": 15764.9,
      "end": 15768.9,
      "formatted_start": "04:22:44.900",
      "formatted_end": "04:22:48.900",
      "text": "اون پول رو با قرص گفتم هرمونیه؟"
    },
    {
      "id": 44,
      "start": 15770.9,
      "end": 15778.9,
      "formatted_start": "04:22:50.900",
      "formatted_end": "04:22:58.900",
      "text": "اونو کاظب نهایتش اینه که بالا میبره دیگه بلی اگه تو پایین باشی یعنی که توی یاسگی نمیری."
    },
    {
      "id": 45,
      "start": 15778.9,
      "end": 15784.9,
      "formatted_start": "04:22:58.900",
      "formatted_end": "04:23:04.900",
      "text": "بعد من چیز خاص فرلاکتین و اینها که در عبداله مختلف میکنن نمیدونستم دیگه."
    },
    {
      "id": 46,
      "start": 15784.9,
      "end": 15786.9,
      "formatted_start": "04:23:04.900",
      "formatted_end": "04:23:06.900",
      "text": "یه فصه اش من درد باشم."
    },
    {
      "id": 47,
      "start": 15786.9,
      "end": 15788.9,
      "formatted_start": "04:23:06.900",
      "formatted_end": "04:23:08.900",
      "text": "تیروید اونو برام میدونست؟"
    },
    {
      "id": 48,
      "start": 15788.9,
      "end": 15789.9,
      "formatted_start": "04:23:08.900",
      "formatted_end": "04:23:09.900",
      "text": "آرام."
    },
    {
      "id": 49,
      "start": 15789.9,
      "end": 15792.82,
      "formatted_start": "04:23:09.900",
      "formatted_end": "04:23:12.820",
      "text": "من آزمایشم رو دیدیم این فلتینم بود دهه"
    },
    {
      "id": 50,
      "start": 15792.82,
      "end": 15793.86,
      "formatted_start": "04:23:12.820",
      "formatted_end": "04:23:13.860",
      "text": "نه من نوشتم"
    },
    {
      "id": 51,
      "start": 15793.86,
      "end": 15795.9,
      "formatted_start": "04:23:13.860",
      "formatted_end": "04:23:15.900",
      "text": "فلتین دوباره نوشتیم؟"
    },
    {
      "id": 52,
      "start": 15795.9,
      "end": 15796.04,
      "formatted_start": "04:23:15.900",
      "formatted_end": "04:23:16.040",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 15796.04,
      "end": 15800.78,
      "formatted_start": "04:23:16.040",
      "formatted_end": "04:23:20.780",
      "text": "چون خود کم خونی فلتین پایین خونستی تو زیاد میکنم"
    },
    {
      "id": 54,
      "start": 15800.78,
      "end": 15804.72,
      "formatted_start": "04:23:20.780",
      "formatted_end": "04:23:24.720",
      "text": "من گرسان هنم روز دوتا نخواه بهشو میخورم"
    },
    {
      "id": 55,
      "start": 15804.72,
      "end": 15809.36,
      "formatted_start": "04:23:24.720",
      "formatted_end": "04:23:29.360",
      "text": "این چی؟ این فروفورت دادن ها روز دوتا میخوری؟"
    },
    {
      "id": 56,
      "start": 15809.36,
      "end": 15812.14,
      "formatted_start": "04:23:29.360",
      "formatted_end": "04:23:32.140",
      "text": "فروفورت دفع قبلی خوردم"
    },
    {
      "id": 57,
      "start": 15812.14,
      "end": 15814.9,
      "formatted_start": "04:23:32.140",
      "formatted_end": "04:23:34.900",
      "text": "این دفع چی گرفت؟"
    },
    {
      "id": 58,
      "start": 15814.9,
      "end": 15817.9,
      "formatted_start": "04:23:34.900",
      "formatted_end": "04:23:37.900",
      "text": "این دوتا به هم داد که فولیکسید هم توش داره"
    },
    {
      "id": 59,
      "start": 15818.68,
      "end": 15819.7,
      "formatted_start": "04:23:38.680",
      "formatted_end": "04:23:39.700",
      "text": "فرکریه"
    },
    {
      "id": 60,
      "start": 15819.7,
      "end": 15821.7,
      "formatted_start": "04:23:39.700",
      "formatted_end": "04:23:41.700",
      "text": "بوتیه"
    },
    {
      "id": 61,
      "start": 15821.7,
      "end": 15824.7,
      "formatted_start": "04:23:41.700",
      "formatted_end": "04:23:44.700",
      "text": "ببین اوزهاهن با دوزه سر مید روزه یه دونه باید بخوریم"
    },
    {
      "id": 62,
      "start": 15824.7,
      "end": 15826.7,
      "formatted_start": "04:23:44.700",
      "formatted_end": "04:23:46.700",
      "text": "مازادش از بدان دفت میشه"
    },
    {
      "id": 63,
      "start": 15826.7,
      "end": 15829.7,
      "formatted_start": "04:23:46.700",
      "formatted_end": "04:23:49.700",
      "text": "بیا دفتی دیگه ببینم شی با جهب بازماشه"
    },
    {
      "id": 64,
      "start": 15829.7,
      "end": 15830.7,
      "formatted_start": "04:23:49.700",
      "formatted_end": "04:23:50.700",
      "text": "الان اوزهاهن نمیشتی؟"
    },
    {
      "id": 65,
      "start": 15830.7,
      "end": 15832.7,
      "formatted_start": "04:23:50.700",
      "formatted_end": "04:23:52.700",
      "text": "نه، مگنیو میداری"
    },
    {
      "id": 66,
      "start": 15832.7,
      "end": 15833.7,
      "formatted_start": "04:23:52.700",
      "formatted_end": "04:23:53.700",
      "text": "تاون کردی؟"
    },
    {
      "id": 67,
      "start": 15833.7,
      "end": 15834.7,
      "formatted_start": "04:23:53.700",
      "formatted_end": "04:23:54.700",
      "text": "الان چار پشت دونه دارم"
    },
    {
      "id": 68,
      "start": 15834.7,
      "end": 15838.7,
      "formatted_start": "04:23:54.700",
      "formatted_end": "04:23:58.700",
      "text": "خب پس هیچی، همینی که من مینوستم روزه یه دونه"
    },
    {
      "id": 69,
      "start": 15838.7,
      "end": 15840.7,
      "formatted_start": "04:23:58.700",
      "formatted_end": "04:24:00.700",
      "text": "آهان که فریتین هم ببره بالا"
    },
    {
      "id": 70,
      "start": 15840.7,
      "end": 15842.7,
      "formatted_start": "04:24:00.700",
      "formatted_end": "04:24:02.700",
      "text": "بعد مگنیوان هم برای من میموستم"
    },
    {
      "id": 71,
      "start": 15842.7,
      "end": 15848.7,
      "formatted_start": "04:24:02.700",
      "formatted_end": "04:24:08.700",
      "text": "من هم میمیسهم به تو مدنیوان و با کشیوم سپراکل"
    },
    {
      "id": 72,
      "start": 15848.7,
      "end": 15851.7,
      "formatted_start": "04:24:08.700",
      "formatted_end": "04:24:11.700",
      "text": "اگه این دوتا رو برام برم برسیم"
    },
    {
      "id": 73,
      "start": 15851.7,
      "end": 15853.7,
      "formatted_start": "04:24:11.700",
      "formatted_end": "04:24:13.700",
      "text": "بسیار نمیشه"
    },
    {
      "id": 74,
      "start": 15853.7,
      "end": 15855.7,
      "formatted_start": "04:24:13.700",
      "formatted_end": "04:24:15.700",
      "text": "نه دیگه از این برای باز چیز میخوارم نیست"
    },
    {
      "id": 75,
      "start": 15855.7,
      "end": 15858.7,
      "formatted_start": "04:24:15.700",
      "formatted_end": "04:24:18.700",
      "text": "اگه دارم لکسافور میخوارم کشیوم لکسافور"
    },
    {
      "id": 76,
      "start": 15858.7,
      "end": 15861.7,
      "formatted_start": "04:24:18.700",
      "formatted_end": "04:24:21.700",
      "text": "و دوست دای رویان داده بود خیلی خوبه"
    },
    {
      "id": 77,
      "start": 15861.7,
      "end": 15864.7,
      "formatted_start": "04:24:21.700",
      "formatted_end": "04:24:24.700",
      "text": "بعد اگه پرو بیوتی باید فلان رو برام برام برسیم"
    },
    {
      "id": 78,
      "start": 15866.7,
      "end": 15868.7,
      "formatted_start": "04:24:26.700",
      "formatted_end": "04:24:28.700",
      "text": "سپراکل"
    },
    {
      "id": 79,
      "start": 15868.7,
      "end": 15872.36,
      "formatted_start": "04:24:28.700",
      "formatted_end": "04:24:32.360",
      "text": "نه بیمت میده"
    },
    {
      "id": 80,
      "start": 15872.36,
      "end": 15877.2,
      "formatted_start": "04:24:32.360",
      "formatted_end": "04:24:37.200",
      "text": "اولین باری که الان دارم چیز میکنم ببینم که مثلا چیز میشه"
    },
    {
      "id": 81,
      "start": 15877.2,
      "end": 15877.82,
      "formatted_start": "04:24:37.200",
      "formatted_end": "04:24:37.820",
      "text": "بیمه میبنیم"
    },
    {
      "id": 82,
      "start": 15877.82,
      "end": 15880.94,
      "formatted_start": "04:24:37.820",
      "formatted_end": "04:24:40.940",
      "text": "اولین باری که الان دارم چیز میکنم ببینم که مثلا چیز میشه"
    },
    {
      "id": 83,
      "start": 15880.94,
      "end": 15886.12,
      "formatted_start": "04:24:40.940",
      "formatted_end": "04:24:46.120",
      "text": "اولین باری که الان دارم چیز میکنم ببینم که مثلا چیز میکنم"
    },
    {
      "id": 84,
      "start": 15886.12,
      "end": 15898.68,
      "formatted_start": "04:24:46.120",
      "formatted_end": "04:24:58.680",
      "text": "اولین باری که الان دارم چیز میکنم ببینم که مثلا چیز میکنم"
    },
    {
      "id": 85,
      "start": 15898.68,
      "end": 15899.96,
      "formatted_start": "04:24:58.680",
      "formatted_end": "04:24:59.960",
      "text": "فیشور در یوم..."
    }
  ],
  "status": "completed"
}