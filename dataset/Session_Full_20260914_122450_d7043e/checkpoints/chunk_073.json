  "stt_segments": [
    {
      "id": 0,
      "start": 21900.0,
      "end": 21930.0,
      "formatted_start": "06:05:00.000",
      "formatted_end": "06:05:30.000",
      "text": "از اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا ا"
    },
    {
      "id": 1,
      "start": 21930.0,
      "end": 21934.96,
      "formatted_start": "06:05:30.000",
      "formatted_end": "06:05:34.960",
      "text": "من یک باز دیگه نمیشتم اداره اشونو چی می کنه زیاد می کنه اون فشاش رو میاره پایین"
    },
    {
      "id": 2,
      "start": 21934.96,
      "end": 21939.32,
      "formatted_start": "06:05:34.960",
      "formatted_end": "06:05:39.320",
      "text": "بلی اونو حتما با یه نصف گوچه بخوری بدن بی حال نشد باشه"
    },
    {
      "id": 3,
      "start": 21939.32,
      "end": 21940.48,
      "formatted_start": "06:05:39.320",
      "formatted_end": "06:05:40.480",
      "text": "باشه دست دارم"
    },
    {
      "id": 4,
      "start": 21940.48,
      "end": 21942.44,
      "formatted_start": "06:05:40.480",
      "formatted_end": "06:05:42.440",
      "text": "از این چقدر می خوری مادر جاست؟"
    },
    {
      "id": 5,
      "start": 21942.44,
      "end": 21944.46,
      "formatted_start": "06:05:42.440",
      "formatted_end": "06:05:44.460",
      "text": "صبح یکی می خورم نشد"
    },
    {
      "id": 6,
      "start": 21944.46,
      "end": 21945.66,
      "formatted_start": "06:05:44.460",
      "formatted_end": "06:05:45.660",
      "text": "اینو صبح و شب؟"
    },
    {
      "id": 7,
      "start": 21945.66,
      "end": 21946.02,
      "formatted_start": "06:05:45.660",
      "formatted_end": "06:05:46.020",
      "text": "هنه"
    },
    {
      "id": 8,
      "start": 21946.02,
      "end": 21948.42,
      "formatted_start": "06:05:46.020",
      "formatted_end": "06:05:48.420",
      "text": "جواب نمی دهید صبح و شب بخور خب؟"
    },
    {
      "id": 9,
      "start": 21948.42,
      "end": 21949.28,
      "formatted_start": "06:05:48.420",
      "formatted_end": "06:05:49.280",
      "text": "باشه دست دارم"
    },
    {
      "id": 10,
      "start": 21949.28,
      "end": 21953.26,
      "formatted_start": "06:05:49.280",
      "formatted_end": "06:05:53.260",
      "text": "روماتیسمتون فعاله فقط این که باید حتما کلسیوم بخوریم"
    },
    {
      "id": 11,
      "start": 21953.26,
      "end": 21953.82,
      "formatted_start": "06:05:53.260",
      "formatted_end": "06:05:53.820",
      "text": "باشه"
    },
    {
      "id": 12,
      "start": 21960.0,
      "end": 21962.0,
      "formatted_start": "06:06:00.000",
      "formatted_end": "06:06:02.000",
      "text": "درست دارم"
    },
    {
      "id": 13,
      "start": 21964.0,
      "end": 21968.0,
      "formatted_start": "06:06:04.000",
      "formatted_end": "06:06:08.000",
      "text": "اگر کارسیون خورده دیدی سف شد شکمت برس گرد چی ها؟"
    },
    {
      "id": 14,
      "start": 21968.0,
      "end": 21969.0,
      "formatted_start": "06:06:08.000",
