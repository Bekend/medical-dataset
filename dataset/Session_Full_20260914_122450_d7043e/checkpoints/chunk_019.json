  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5730.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:30.000",
      "text": "از اینجا بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار بیمار ب"
    },
    {
      "id": 1,
      "start": 5730.0,
      "end": 5732.0,
      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:32.000",
      "text": "با شیم درمانی کرده؟"
    },
    {
      "id": 2,
      "start": 5732.0,
      "end": 5734.0,
      "formatted_start": "01:35:32.000",
      "formatted_end": "01:35:34.000",
      "text": "با شیم درمانی کرده"
    },
    {
      "id": 3,
      "start": 5734.0,
      "end": 5736.0,
      "formatted_start": "01:35:34.000",
      "formatted_end": "01:35:36.000",
      "text": "قلبش خیلی هستم به 30 درصد"
    },
    {
      "id": 4,
      "start": 5736.0,
      "end": 5738.0,
      "formatted_start": "01:35:36.000",
      "formatted_end": "01:35:38.000",
      "text": "آره یادم اصلا پاشم باید میکرد دیگه"
    },
    {
      "id": 5,
      "start": 5738.0,
      "end": 5740.0,
      "formatted_start": "01:35:38.000",
      "formatted_end": "01:35:40.000",
      "text": "پاش برم داشت"
    },
    {
      "id": 6,
      "start": 5740.0,
      "end": 5742.0,
      "formatted_start": "01:35:40.000",
      "formatted_end": "01:35:42.000",
      "text": "باید کم برم داشته برای"
    },
    {
      "id": 7,
      "start": 5742.0,
      "end": 5744.0,
      "formatted_start": "01:35:42.000",
      "formatted_end": "01:35:44.000",
      "text": "درکن بودن چون آنجویا میخواست باید باید قلبی سریعیت نمیتونیم"
    },
    {
      "id": 8,
      "start": 5744.0,
      "end": 5746.0,
      "formatted_start": "01:35:44.000",
      "formatted_end": "01:35:46.000",
      "text": "باید گروش نمیتونیم"
    },
    {
      "id": 9,
      "start": 5746.0,
      "end": 5748.0,
      "formatted_start": "01:35:46.000",
      "formatted_end": "01:35:48.000",
      "text": "جراحی هیچ کار برش نتونستن"
    },
    {
      "id": 10,
      "start": 5748.0,
      "end": 5750.0,
      "formatted_start": "01:35:48.000",
      "formatted_end": "01:35:50.000",
      "text": "خب عملا هم نمیتونستن کار بکنن"
    },
    {
      "id": 11,
      "start": 5750.0,
      "end": 5752.0,
      "formatted_start": "01:35:50.000",
      "formatted_end": "01:35:52.000",
      "text": "یعنی"
    },
    {
      "id": 12,
      "start": 5752.0,
      "end": 5759.0,
      "formatted_start": "01:35:52.000",
      "formatted_end": "01:35:59.000",
      "text": "اصلا هفته از دواله هستند همچنین مریض را درمانی بکنند، همچنین کاری نمیشه برای مریض"
    },
    {
      "id": 13,
      "start": 5759.0,
      "end": 5765.0,
      "formatted_start": "01:35:59.000",
      "formatted_end": "01:36:05.000",
      "text": "ما صرف بیوارسان باید کردیم، دو روز به آیس اوی برده ایم، دو روز هم به بخشتا بکنیم"
    },
    {
      "id": 14,
      "start": 5765.0,
      "end": 5767.0,
      "formatted_start": "01:36:05.000",
      "formatted_end": "01:36:07.000",
      "text": "اوشه شد که هرد"
    },
    {
      "id": 15,
      "start": 5767.0,
      "end": 5772.0,
      "formatted_start": "01:36:07.000",
      "formatted_end": "01:36:12.000",
      "text": "آره، بعد که مرخش کرد، مرخش کرد، صبحون آجو میزنید، این همش برده، برده باشیم، بیوارسان بیوارسان بیوارسان بیوارسان"
    },
    {
      "id": 16,
      "start": 5772.0,
      "end": 5774.0,
      "formatted_start": "01:36:12.000",
      "formatted_end": "01:36:14.000",
      "text": "درداشت خودش رو زنده ندارید"
    },
    {
      "id": 17,
      "start": 5774.0,
      "end": 5776.0,
      "formatted_start": "01:36:14.000",
      "formatted_end": "01:36:16.000",
      "text": "این خورسه رو بشنگیرن"
    },
    {
      "id": 18,
      "start": 5776.0,
      "end": 5778.0,
      "formatted_start": "01:36:16.000",
      "formatted_end": "01:36:18.000",
      "text": "برس بشنگیرن"
    },
    {
      "id": 19,
      "start": 5778.0,
      "end": 5780.0,
      "formatted_start": "01:36:18.000",
      "formatted_end": "01:36:20.000",
      "text": "برس بشنگیرن"
    },
    {
      "id": 20,
      "start": 5780.0,
      "end": 5782.0,
      "formatted_start": "01:36:20.000",
      "formatted_end": "01:36:22.000",
      "text": "این اصلا خوش نداشتی"
    },
    {
      "id": 21,
      "start": 5782.0,
      "end": 5784.0,
      "formatted_start": "01:36:22.000",
      "formatted_end": "01:36:24.000",
      "text": "یعنی مشکار ندارید"
    },
    {
      "id": 22,
      "start": 5784.0,
      "end": 5786.0,
      "formatted_start": "01:36:24.000",
      "formatted_end": "01:36:26.000",
      "text": "دو سر از اینجورو بزرگیر"
    },
    {
      "id": 23,
      "start": 5786.0,
      "end": 5788.0,
      "formatted_start": "01:36:26.000",
      "formatted_end": "01:36:28.000",
      "text": "خدا به همه بزرگیر کنید"
    },
    {
      "id": 24,
      "start": 5788.0,
      "end": 5790.0,
      "formatted_start": "01:36:28.000",
      "formatted_end": "01:36:30.000",
      "text": "خیلی زن خوبی بزرگیر"
    },
    {
      "id": 25,
      "start": 5790.0,
      "end": 5792.0,
      "formatted_start": "01:36:30.000",
      "formatted_end": "01:36:32.000",
      "text": "خیلی مردم خوش رو بزرگیر"
    },
    {
      "id": 26,
      "start": 5792.0,
      "end": 5794.0,
      "formatted_start": "01:36:32.000",
      "formatted_end": "01:36:34.000",
      "text": "اینقدر خوب هستن"
    },
    {
      "id": 27,
      "start": 5794.0,
      "end": 5798.0,
      "formatted_start": "01:36:34.000",
      "formatted_end": "01:36:38.000",
      "text": "دوستان نفر اینجوری رو اومدن"
    },
    {
      "id": 28,
      "start": 5798.0,
      "end": 5803.0,
      "formatted_start": "01:36:38.000",
      "formatted_end": "01:36:43.000",
      "text": "بعضی وقت همسرم به من میگه که ببین خانم من اگه همه دنیا رو بدن هیچ وقت ندارم را شده با خیلی"
    },
    {
      "id": 29,
      "start": 5803.0,
      "end": 5807.0,
      "formatted_start": "01:36:43.000",
      "formatted_end": "01:36:47.000",
      "text": "چون بعضی وقت ها قربه ها که میدن حالم برده حرف نمیذارم تو خونه"
    },
    {
      "id": 30,
      "start": 5807.0,
      "end": 5809.0,
      "formatted_start": "01:36:47.000",
      "formatted_end": "01:36:49.000",
      "text": "میگه بازی یه مریضت مورده ایم"
    },
    {
      "id": 31,
      "start": 5809.0,
      "end": 5811.0,
      "formatted_start": "01:36:49.000",
      "formatted_end": "01:36:51.000",
      "text": "میفهمید مثلا من اینجور حالم خوب نیست"
    },
    {
      "id": 32,
      "start": 5811.0,
      "end": 5813.0,
      "formatted_start": "01:36:51.000",
      "formatted_end": "01:36:53.000",
      "text": "بازی میگه بگو این چه رشته ترم"
    },
    {
      "id": 33,
      "start": 5813.0,
      "end": 5817.0,
      "formatted_start": "01:36:53.000",
      "formatted_end": "01:36:57.000",
      "text": "یک مرزی یک مرزی میبینه که سرطان میگه باست تا درست دخونه حالت بده"
    },
    {
      "id": 34,
      "start": 5817.0,
      "end": 5819.0,
      "formatted_start": "01:36:57.000",
      "formatted_end": "01:36:59.000",
      "text": "چون خواهدن نیست"
    },
    {
      "id": 35,
      "start": 5819.0,
      "end": 5821.0,
      "formatted_start": "01:36:59.000",
      "formatted_end": "01:37:01.000",
      "text": "من خب بازی نه به من میبختن"
    },
    {
      "id": 36,
      "start": 5821.0,
      "end": 5823.0,
      "formatted_start": "01:37:01.000",
      "formatted_end": "01:37:03.000",
      "text": "به این نه گفتم تو خدا یه دفعه نیم به من بگیر"
    },
    {
      "id": 37,
      "start": 5823.0,
      "end": 5825.0,
      "formatted_start": "01:37:03.000",
      "formatted_end": "01:37:05.000",
      "text": "یه موچه یه دفعه میبینه"
    },
    {
      "id": 38,
      "start": 5825.0,
      "end": 5827.0,
      "formatted_start": "01:37:05.000",
      "formatted_end": "01:37:07.000",
      "text": "میگم فهمیدی فهمید مورد بده نه بخواهد"
    },
    {
      "id": 39,
      "start": 5827.0,
      "end": 5829.0,
      "formatted_start": "01:37:07.000",
      "formatted_end": "01:37:09.000",
      "text": "من مثلا میدونی من منار بسترین کنم"
    },
    {
      "id": 40,
      "start": 5829.0,
      "end": 5831.0,
      "formatted_start": "01:37:09.000",
      "formatted_end": "01:37:11.000",
      "text": "خیلی با آشون حرکت میزنم"
    },
    {
      "id": 41,
      "start": 5831.0,
      "end": 5833.0,
      "formatted_start": "01:37:11.000",
      "formatted_end": "01:37:13.000",
      "text": "شاید شما یه دقیقه مثلا نوبرت بگم"
    },
    {
      "id": 42,
      "start": 5833.0,
      "end": 5840.0,
      "formatted_start": "01:37:13.000",
      "formatted_end": "01:37:20.000",
      "text": "من با آشون یه حالت ارتباطات رو ببرم که خیلی خالم برد میشه وقتی اتفاق بر من اعضا میافته"
    },
    {
      "id": 43,
      "start": 5840.0,
      "end": 5845.0,
      "formatted_start": "01:37:20.000",
      "formatted_end": "01:37:25.000",
      "text": "من یه طوله کچیکم در مسائل داشت جرای کرد دکتور شفید بود"
    },
    {
      "id": 44,
      "start": 5845.0,
      "end": 5848.0,
      "formatted_start": "01:37:25.000",
      "formatted_end": "01:37:28.000",
      "text": "یه بار که محاستان بست داری بود که با سال رو بساوی بکنم"
    },
    {
      "id": 45,
      "start": 5848.0,
      "end": 5851.0,
      "formatted_start": "01:37:28.000",
      "formatted_end": "01:37:31.000",
      "text": "دکتور ریلی نبای کرد گفت بیا مطبع"
    },
    {
      "id": 46,
      "start": 5851.0,
      "end": 5854.0,
      "formatted_start": "01:37:31.000",
      "formatted_end": "01:37:34.000",
      "text": "اصلا نمیدونیم هر کارش کنیم گفت من نمیدونم"
    },
    {
      "id": 47,
      "start": 5854.0,
      "end": 5857.0,
      "formatted_start": "01:37:34.000",
      "formatted_end": "01:37:37.000",
      "text": "اصلا سخت هم میرم گفت من مثلا پیش دکتورون مرد نمی کنم"
    },
    {
      "id": 48,
      "start": 5857.0,
      "end": 5887.0,
      "formatted_start": "01:37:37.000",
      "formatted_end": "01:38:07.000",
      "text": "اما اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا اینجا ا"
    },
    {
      "id": 49,
      "start": 5887.0,
      "end": 5891.0,
      "formatted_start": "01:38:07.000",
      "formatted_end": "01:38:11.000",
      "text": "خودشون کنید، خودشون کنید، نکنون سرطانه، نه بابا"
    },
    {
      "id": 50,
      "start": 5891.0,
      "end": 5893.0,
      "formatted_start": "01:38:11.000",
      "formatted_end": "01:38:13.000",
      "text": "از این آزمایشو شده"
    },
    {
      "id": 51,
      "start": 5893.0,
      "end": 5895.0,
      "formatted_start": "01:38:13.000",
      "formatted_end": "01:38:15.000",
      "text": "اکترین کار برای آدم سمباده اینه"
    },
    {
      "id": 52,
      "start": 5895.0,
      "end": 5899.0,
      "formatted_start": "01:38:15.000",
      "formatted_end": "01:38:19.000",
      "text": "یعنی هیچی بهش نگفتید، خوشکار بود تا روز آخر مرگش"
    },
    {
      "id": 53,
      "start": 5899.0,
      "end": 5902.0,
      "formatted_start": "01:38:19.000",
      "formatted_end": "01:38:22.000",
      "text": "اگه می فهمید چون بردنش سرطان خودش"
    },
    {
      "id": 54,
      "start": 5902.0,
      "end": 5905.0,
      "formatted_start": "01:38:22.000",
      "formatted_end": "01:38:25.000",
      "text": "او زندگی هم خیلی داشت، اصلا دوست نداشت به نیمانه"
    },
    {
      "id": 55,
      "start": 5905.0,
      "end": 5910.0,
      "formatted_start": "01:38:25.000",
      "formatted_end": "01:38:30.000",
      "text": "این تیکهش بده، من خودم مامانم خیلی دوست داشت"
    },
    {
      "id": 56,
      "start": 5910.0,
      "end": 5914.0,
      "formatted_start": "01:38:30.000",
      "formatted_end": "01:38:34.000",
      "text": "مامان من که جوان بود، واقعا سخته"
    },
    {
      "id": 57,
      "start": 5914.0,
      "end": 5917.66,
      "formatted_start": "01:38:34.000",
      "formatted_end": "01:38:37.660",
      "text": "این تیکه شما اصلا آدمشون اینها دوست داشتن زندگی کنن"
    },
    {
      "id": 58,
      "start": 5917.66,
      "end": 5920.46,
      "formatted_start": "01:38:37.660",
      "formatted_end": "01:38:40.460",
      "text": "همیشه حسرت برامون هست"
    },
    {
      "id": 59,
      "start": 5920.46,
      "end": 5922.28,
      "formatted_start": "01:38:40.460",
      "formatted_end": "01:38:42.280",
      "text": "آره اشاره کنید جایشون خوب باشه"
    },
    {
      "id": 60,
      "start": 5922.28,
      "end": 5924.28,
      "formatted_start": "01:38:42.280",
      "formatted_end": "01:38:44.280",
      "text": "امت مادرم بیازه هم بود"
    },
    {
      "id": 61,
      "start": 5924.28,
      "end": 5926.54,
      "formatted_start": "01:38:44.280",
      "formatted_end": "01:38:46.540",
      "text": "به شدت زن معتقدی بود"
    },
    {
      "id": 62,
      "start": 5926.54,
      "end": 5928.98,
      "formatted_start": "01:38:46.540",
      "formatted_end": "01:38:48.980",
      "text": "اصلا یک دوری قیبر"
    },
    {
      "id": 63,
      "start": 5928.98,
      "end": 5932.2,
      "formatted_start": "01:38:48.980",
      "formatted_end": "01:38:52.200",
      "text": "نمازوزی که رفت به این ماشه من رو نکنش"
    },
    {
      "id": 64,
      "start": 5932.2,
      "end": 5935.38,
      "formatted_start": "01:38:52.200",
      "formatted_end": "01:38:55.380",
      "text": "که بچه هم بدونم من نماز و قضا ندارم من این چی"
    },
    {
      "id": 65,
      "start": 5935.38,
      "end": 5937.04,
      "formatted_start": "01:38:55.380",
      "formatted_end": "01:38:57.040",
      "text": "تمام مدت"
    },
    {
      "id": 66,
      "start": 5937.04,
      "end": 5939.26,
      "formatted_start": "01:38:57.040",
      "formatted_end": "01:38:59.260",
      "text": "امت سر میگه ما هر وقت میرفتیم تو خونه"
    },
    {
      "id": 67,
      "start": 5939.26,
      "end": 5940.14,
      "formatted_start": "01:38:59.260",
      "formatted_end": "01:39:00.140",
      "text": "مادرم داشت خوران"
    },
    {
      "id": 68,
      "start": 5940.14,
      "end": 5942.14,
      "formatted_start": "01:39:00.140",
      "formatted_end": "01:39:02.140",
      "text": "مادر همجور زندگی نکرد"
    },
    {
      "id": 69,
      "start": 5942.14,
      "end": 5944.14,
      "formatted_start": "01:39:02.140",
      "formatted_end": "01:39:04.140",
      "text": "مادر گرگان همجور زندگی نکرد"
    },
    {
      "id": 70,
      "start": 5944.14,
      "end": 5946.14,
      "formatted_start": "01:39:04.140",
      "formatted_end": "01:39:06.140",
      "text": "اونجور من اومدم اینجا"
    },
    {
      "id": 71,
      "start": 5946.14,
      "end": 5948.14,
      "formatted_start": "01:39:06.140",
      "formatted_end": "01:39:08.140",
      "text": "چون بچه ها منو از ایلان رفتن"
    },
    {
      "id": 72,
      "start": 5948.14,
      "end": 5950.14,
      "formatted_start": "01:39:08.140",
      "formatted_end": "01:39:10.140",
      "text": "من تنها بودم"
    },
    {
      "id": 73,
      "start": 5950.14,
      "end": 5952.14,
      "formatted_start": "01:39:10.140",
      "formatted_end": "01:39:12.140",
      "text": "یعنی توی گرگان زندگی بکنم که مثلا"
    },
    {
      "id": 74,
      "start": 5952.14,
      "end": 5954.14,
      "formatted_start": "01:39:12.140",
      "formatted_end": "01:39:14.140",
      "text": "نه دیگه من باشیم"
    },
    {
      "id": 75,
      "start": 5954.14,
      "end": 5956.14,
      "formatted_start": "01:39:14.140",
      "formatted_end": "01:39:16.140",
      "text": "به خاطر من اومدم اینجا"
    },
    {
      "id": 76,
      "start": 5956.14,
      "end": 5958.14,
      "formatted_start": "01:39:16.140",
      "formatted_end": "01:39:18.140",
      "text": "خیلی خیلی مادر که دیگه"
    },
    {
      "id": 77,
      "start": 5958.14,
      "end": 5960.14,
      "formatted_start": "01:39:18.140",
      "formatted_end": "01:39:20.140",
      "text": "نه باشیم"
    },
    {
      "id": 78,
      "start": 5960.14,
      "end": 5962.14,
      "formatted_start": "01:39:20.140",
      "formatted_end": "01:39:22.140",
      "text": "خب اینو که زدیم"
    },
    {
      "id": 79,
      "start": 5962.14,
      "end": 5964.14,
      "formatted_start": "01:39:22.140",
      "formatted_end": "01:39:24.140",
      "text": "خب اینو که زدیم"
    },
    {
      "id": 80,
      "start": 5964.14,
      "end": 5966.14,
      "formatted_start": "01:39:24.140",
      "formatted_end": "01:39:26.140",
      "text": "این پرس هم هایی هم به قاسیت هم استفاده میکنه"
    },
    {
      "id": 81,
      "start": 5966.14,
      "end": 5968.14,
      "formatted_start": "01:39:26.140",
      "formatted_end": "01:39:28.140",
      "text": "خودمون برم نکنم اون ترجمه شو"
    },
    {
      "id": 82,
      "start": 5971.14,
      "end": 5972.14,
      "formatted_start": "01:39:31.140",
      "formatted_end": "01:39:32.140",
      "text": "چیه؟ نامه هم چیه؟"
    },
    {
      "id": 83,
      "start": 5974.14,
      "end": 5976.14,
      "formatted_start": "01:39:34.140",
      "formatted_end": "01:39:36.140",
      "text": "من که اصلا نشتت و گیریه نکنم برام درم دهدم"
    },
    {
      "id": 84,
      "start": 5976.14,
      "end": 5977.14,
      "formatted_start": "01:39:36.140",
      "formatted_end": "01:39:37.140",
      "text": "چند وقت شد؟"
    },
    {
      "id": 85,
      "start": 5978.14,
      "end": 5980.14,
      "formatted_start": "01:39:38.140",
      "formatted_end": "01:39:40.140",
      "text": "چهار دقیقه اول بیرون بود دیگه"
    },
    {
      "id": 86,
      "start": 5983.14,
      "end": 5986.14,
      "formatted_start": "01:39:43.140",
      "formatted_end": "01:39:46.140",
      "text": "درم که عادت نمی بانه، هر چی می جور و بیشتر درم برم"
    },
    {
      "id": 87,
      "start": 5986.14,
      "end": 5987.14,
      "formatted_start": "01:39:46.140",
      "formatted_end": "01:39:47.140",
      "text": "نه نه، من باید برم برم"
    },
    {
      "id": 88,
      "start": 5987.14,
      "end": 5989.14,
      "formatted_start": "01:39:47.140",
      "formatted_end": "01:39:49.140",
      "text": "تنها جایی که هر وقت دارید مواددیم"
    },
    {
      "id": 89,
      "start": 5989.14,
      "end": 5990.14,
      "formatted_start": "01:39:49.140",
      "formatted_end": "01:39:50.140",
      "text": "آفتا"
    },
    {
      "id": 90,
      "start": 5990.14,
      "end": 5991.14,
      "formatted_start": "01:39:50.140",
      "formatted_end": "01:39:51.140",
      "text": "از این چند تا می کنی؟"
    },
    {
      "id": 91,
      "start": 5992.14,
      "end": 5993.14,
      "formatted_start": "01:39:52.140",
      "formatted_end": "01:39:53.140",
      "text": "دو تا، ده سا باشم"
    },
    {
      "id": 92,
      "start": 5993.14,
