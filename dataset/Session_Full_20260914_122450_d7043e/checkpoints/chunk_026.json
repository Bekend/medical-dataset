  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7804.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:04.000",
      "text": "نه، نه باید مسکم بخوریم."
    },
    {
      "id": 1,
      "start": 7804.0,
      "end": 7810.0,
      "formatted_start": "02:10:04.000",
      "formatted_end": "02:10:10.000",
      "text": "مسکم برایتون همه. من بهتون برج پنج انتشار تمام کردیم."
    },
    {
      "id": 2,
      "start": 7810.0,
      "end": 7812.0,
      "formatted_start": "02:10:10.000",
      "formatted_end": "02:10:12.000",
      "text": "من یزشون برای پاهاتون بهتون دادم."
    },
    {
      "id": 3,
      "start": 7812.0,
      "end": 7816.0,
      "formatted_start": "02:10:12.000",
      "formatted_end": "02:10:16.000",
      "text": "آره، آره اونو تمام شدن. کل امروز همه روشیم. همه استفاده کم تمام شدیم."
    },
    {
      "id": 4,
      "start": 7816.0,
      "end": 7820.0,
      "formatted_start": "02:10:16.000",
      "formatted_end": "02:10:20.000",
      "text": "همونو برد بنویسم. اصل این درداتون مال بی تحرکتونو ها."
    },
    {
      "id": 5,
      "start": 7820.0,
      "end": 7821.0,
      "formatted_start": "02:10:20.000",
      "formatted_end": "02:10:21.000",
      "text": "آره."
    },
    {
      "id": 6,
      "start": 7821.0,
      "end": 7823.0,
      "formatted_start": "02:10:21.000",
      "formatted_end": "02:10:23.000",
      "text": "آره، ازولادتون زعیبه."
    },
    {
      "id": 7,
      "start": 7823.0,
      "end": 7824.0,
      "formatted_start": "02:10:23.000",
      "formatted_end": "02:10:24.000",
      "text": "آره."
    },
    {
      "id": 8,
      "start": 7824.0,
      "end": 7827.46,
      "formatted_start": "02:10:24.000",
      "formatted_end": "02:10:27.460",
      "text": "اینکه قانون بذارین یه راه سام"
    },
    {
      "id": 9,
      "start": 7827.46,
      "end": 7829.46,
      "formatted_start": "02:10:27.460",
      "formatted_end": "02:10:29.460",
      "text": "مراحت هم همینچی پیدا رو بی کنیم"
    },
    {
      "id": 10,
      "start": 7829.46,
      "end": 7833.46,
      "formatted_start": "02:10:29.460",
      "formatted_end": "02:10:33.460",
      "text": "باشه من اینجا سر زمینی پیدا برم"
    },
    {
      "id": 11,
      "start": 7833.46,
      "end": 7835.46,
      "formatted_start": "02:10:33.460",
      "formatted_end": "02:10:35.460",
      "text": "سر باب دارم"
    },
    {
      "id": 12,
      "start": 7835.46,
      "end": 7837.46,
      "formatted_start": "02:10:35.460",
      "formatted_end": "02:10:37.460",
      "text": "برم برس میرم با ماشین"
    },
    {
      "id": 13,
      "start": 7837.46,
      "end": 7839.46,
      "formatted_start": "02:10:37.460",
      "formatted_end": "02:10:39.460",
      "text": "ولی با ماشین نداریم نه"
    },
    {
      "id": 14,
      "start": 7839.46,
      "end": 7841.46,
      "formatted_start": "02:10:39.460",
      "formatted_end": "02:10:41.460",
      "text": "همین 200-300 میدونیم که شهر نیست"
    },
    {
      "id": 15,
      "start": 7841.46,
      "end": 7843.46,
      "formatted_start": "02:10:41.460",
      "formatted_end": "02:10:43.460",
      "text": "چیزی نیست که چرا؟"
    },
    {
      "id": 16,
      "start": 7843.46,
      "end": 7845.46,
      "formatted_start": "02:10:43.460",
      "formatted_end": "02:10:45.460",
      "text": "نه"
    },
    {
      "id": 17,
      "start": 7845.46,
      "end": 7847.46,
      "formatted_start": "02:10:45.460",
      "formatted_end": "02:10:47.460",
      "text": "آسفارت"
    },
    {
      "id": 18,
      "start": 7847.46,
      "end": 7849.46,
      "formatted_start": "02:10:47.460",
      "formatted_end": "02:10:49.460",
      "text": "آسفارت همه هست یه فیسمت باگی"
    },
    {
      "id": 19,
      "start": 7849.46,
      "end": 7851.46,
      "formatted_start": "02:10:49.460",
      "formatted_end": "02:10:51.460",
      "text": "طبعا شما"
    },
    {
      "id": 20,
      "start": 7851.46,
      "end": 7853.46,
      "formatted_start": "02:10:51.460",
      "formatted_end": "02:10:53.460",
      "text": "مرسی بله"
    },
    {
      "id": 21,
      "start": 7853.46,
      "end": 7883.46,
      "formatted_start": "02:10:53.460",
      "formatted_end": "02:11:23.460",
      "text": "بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، ب"
    },
    {
      "id": 22,
      "start": 7883.46,
      "end": 7885.46,
      "formatted_start": "02:11:23.460",
      "formatted_end": "02:11:25.460",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 7913.46,
      "end": 7918.46,
      "formatted_start": "02:11:53.460",
      "formatted_end": "02:11:58.460",
      "text": "از این آقایی هفتهگی بودن"
    },
    {
      "id": 24,
      "start": 7918.46,
      "end": 7921.46,
      "formatted_start": "02:11:58.460",
      "formatted_end": "02:12:01.460",
      "text": "کمکونی برو کمکونی"
    },
    {
      "id": 25,
      "start": 7921.46,
      "end": 7925.46,
      "formatted_start": "02:12:01.460",
      "formatted_end": "02:12:05.460",
      "text": "اونو خوب بده شده خونت اصلا نکرده"
    },
    {
      "id": 26,
      "start": 7925.46,
      "end": 7927.46,
      "formatted_start": "02:12:05.460",
      "formatted_end": "02:12:07.460",
      "text": "ویتامین"
    },
    {
      "id": 27,
      "start": 7927.46,
      "end": 7930.46,
      "formatted_start": "02:12:07.460",
      "formatted_end": "02:12:10.460",
      "text": "و قصه آن هم براش بینمسن"
    },
    {
      "id": 28,
      "start": 7930.46,
      "end": 7934.46,
      "formatted_start": "02:12:10.460",
      "formatted_end": "02:12:14.460",
      "text": "دستگاه هم از اون هار مدارو بلند شده"
    },
    {
      "id": 29,
      "start": 7934.46,
      "end": 7938.46,
      "formatted_start": "02:12:14.460",
      "formatted_end": "02:12:18.460",
      "text": "قصه آن هم بلند شده شب درمیان مومون بخوره"
    },
    {
      "id": 30,
      "start": 7938.46,
      "end": 7940.46,
      "formatted_start": "02:12:18.460",
      "formatted_end": "02:12:20.460",
      "text": "ویتامین دیگه هم که نوشته خواه بود"
    },
    {
      "id": 31,
      "start": 7940.46,
      "end": 7942.46,
      "formatted_start": "02:12:20.460",
      "formatted_end": "02:12:22.460",
      "text": "چه قصه آن هم نوشته"
    },
    {
      "id": 32,
      "start": 7942.46,
      "end": 7946.46,
      "formatted_start": "02:12:22.460",
      "formatted_end": "02:12:26.460",
      "text": "آه، دست و قند داری بذاری یه منی از دیگه اون باز بگیرن و نیستم جوشان"
    },
    {
      "id": 33,
      "start": 7946.46,
      "end": 7948.46,
      "formatted_start": "02:12:26.460",
      "formatted_end": "02:12:28.460",
      "text": "خیلی خوب به توی کنم"
    },
    {
      "id": 34,
      "start": 7948.46,
      "end": 7949.46,
      "formatted_start": "02:12:28.460",
      "formatted_end": "02:12:29.460",
      "text": "نه، آره اینجا"
    },
    {
      "id": 35,
      "start": 7949.46,
      "end": 7952.46,
      "formatted_start": "02:12:29.460",
      "formatted_end": "02:12:32.460",
      "text": "پردوز رو مقاسن شما میتونی بدویسیم؟"
    },
    {
      "id": 36,
      "start": 7952.46,
      "end": 7956.46,
      "formatted_start": "02:12:32.460",
      "formatted_end": "02:12:36.460",
      "text": "آره اینها که درشان اینها همه آزاده مونتون میدونی که الان جوشانی نه هیز ها"
    },
    {
      "id": 37,
      "start": 7956.46,
      "end": 7958.46,
      "formatted_start": "02:12:36.460",
      "formatted_end": "02:12:38.460",
      "text": "هستی جویی بود شما الان بگویسیم براش"
    },
    {
      "id": 38,
      "start": 7958.46,
      "end": 7959.46,
      "formatted_start": "02:12:38.460",
      "formatted_end": "02:12:39.460",
      "text": "هیچ فرق نه"
    },
    {
      "id": 39,
      "start": 7959.46,
      "end": 7961.46,
      "formatted_start": "02:12:39.460",
      "formatted_end": "02:12:41.460",
      "text": "الان اینها رو آزاد میپایی گیره"
    },
    {
      "id": 40,
      "start": 7961.46,
      "end": 7968.66,
      "formatted_start": "02:12:41.460",
      "formatted_end": "02:12:48.660",
      "text": "همه نه، نگاه کن قرصای بیماری هاش بیمست، بلی جوشان و آمو تقویتی، هر چی که تقویتی آزاده"
    },
    {
      "id": 41,
      "start": 7968.66,
      "end": 7972.86,
      "formatted_start": "02:12:48.660",
      "formatted_end": "02:12:52.860",
      "text": "خب زیاد آزاده نه، زیاد آزاده نه، نرویسیم بیرون"
    },
    {
      "id": 42,
      "start": 7972.86,
      "end": 7975.86,
      "formatted_start": "02:12:52.860",
      "formatted_end": "02:12:55.860",
      "text": "آهان باشه، تقویتی، چون خود میگی که گفت"
    },
    {
      "id": 43,
      "start": 7975.86,
      "end": 7980.86,
      "formatted_start": "02:12:55.860",
      "formatted_end": "02:13:00.860",
      "text": "من فکر کردم، از این هم جز به چی هاشون برانید، جشن و تخصوص داریم"
    },
    {
      "id": 44,
      "start": 7980.86,
      "end": 7986.86,
      "formatted_start": "02:13:00.860",
      "formatted_end": "02:13:06.860",
      "text": "آهان، اون درواهاشونه، اگه ما ننیستیم که کلان آزاده، تقویتی"
    },
    {
      "id": 45,
      "start": 7986.86,
      "end": 7989.86,
      "formatted_start": "02:13:06.860",
      "formatted_end": "02:13:09.860",
      "text": "پرسخان اگر اون تر نه؟"
    },
    {
      "id": 46,
      "start": 7989.86,
      "end": 7990.86,
      "formatted_start": "02:13:09.860",
      "formatted_end": "02:13:10.860",
      "text": "نمیشه"
    },
    {
      "id": 47,
      "start": 7990.86,
      "end": 7992.86,
      "formatted_start": "02:13:10.860",
      "formatted_end": "02:13:12.860",
      "text": "پرسخان که خیلی بیادون آورده"
    },
    {
      "id": 48,
      "start": 7992.86,
      "end": 7997.86,
      "formatted_start": "02:13:12.860",
      "formatted_end": "02:13:17.860",
      "text": "پرسخانتون اگر ما نمیرسیم هر گوشتی یک و نیمه میلیون هست"
    },
    {
      "id": 49,
      "start": 7997.86,
      "end": 8000.86,
      "formatted_start": "02:13:17.860",
      "formatted_end": "02:13:20.860",
      "text": "خونده بودین دوشان زیاد در نخون شد"
    },
    {
      "id": 50,
      "start": 8000.86,
      "end": 8002.86,
      "formatted_start": "02:13:20.860",
      "formatted_end": "02:13:22.860",
      "text": "او نکتران و تولش با خونده باشون"
    },
    {
      "id": 51,
      "start": 8002.86,
      "end": 8003.86,
      "formatted_start": "02:13:22.860",
      "formatted_end": "02:13:23.860",
      "text": "باشه"
    },
    {
      "id": 52,
      "start": 8003.86,
      "end": 8005.86,
      "formatted_start": "02:13:23.860",
      "formatted_end": "02:13:25.860",
      "text": "در نخون شد، اوووو"
    },
    {
      "id": 53,
      "start": 8005.86,
      "end": 8008.86,
      "formatted_start": "02:13:25.860",
      "formatted_end": "02:13:28.860",
      "text": "اصلا نمیتونم بروشت در آزماکستان"
    },
    {
      "id": 54,
      "start": 8008.86,
      "end": 8012.86,
      "formatted_start": "02:13:28.860",
      "formatted_end": "02:13:32.860",
      "text": "اما فردا به چند تا بیمه این میلیسن"
    },
    {
      "id": 55,
      "start": 8012.86,
      "end": 8014.86,
      "formatted_start": "02:13:32.860",
      "formatted_end": "02:13:34.860",
      "text": "چون ازای یک جوری شده"
    },
    {
      "id": 56,
      "start": 8014.86,
      "end": 8018.92,
      "formatted_start": "02:13:34.860",
      "formatted_end": "02:13:38.920",
      "text": "هر مساکن گذیر و تردار داره همه آزاد شده با"
    },
    {
      "id": 57,
      "start": 8018.92,
      "end": 8022.18,
      "formatted_start": "02:13:38.920",
      "formatted_end": "02:13:42.180",
      "text": "این فقط اصلایی افرادی ماست و پنجم پیروز"
    },
    {
      "id": 58,
      "start": 8022.18,
      "end": 8025.64,
      "formatted_start": "02:13:42.180",
      "formatted_end": "02:13:45.640",
      "text": "خانم دکتر اصلا مشکل نمیخوام برای شما صحبت کنم"
    },
    {
      "id": 59,
      "start": 8025.64,
      "end": 8031.1,
      "formatted_start": "02:13:45.640",
      "formatted_end": "02:13:51.100",
      "text": "میگیدید من هر 21 روز دارم خودم 6 ملیون و 500 وقت داریم خودم"
    },
    {
      "id": 60,
      "start": 8031.1,
      "end": 8033.56,
      "formatted_start": "02:13:51.100",
      "formatted_end": "02:13:53.560",
      "text": "2 ملیون و 500 نزننشان"
    },
    {
      "id": 61,
      "start": 8033.56,
      "end": 8035.56,
      "formatted_start": "02:13:53.560",
      "formatted_end": "02:13:55.560",
      "text": "من دارم الان امرو تراپی میکنم"
    },
    {
      "id": 62,
      "start": 8035.56,
      "end": 8037.56,
      "formatted_start": "02:13:55.560",
      "formatted_end": "02:13:57.560",
      "text": "من کمسر سینه"
    },
    {
      "id": 63,
      "start": 8037.56,
      "end": 8040.78,
      "formatted_start": "02:13:57.560",
      "formatted_end": "02:14:00.780",
      "text": "و اینها دیگه برای ما پول نیسته"
    },
    {
      "id": 64,
      "start": 8040.78,
      "end": 8042.36,
      "formatted_start": "02:14:00.780",
      "formatted_end": "02:14:02.360",
      "text": "خدا از بس پول دادی"
    },
    {
      "id": 65,
      "start": 8042.36,
      "end": 8051.36,
      "formatted_start": "02:14:02.360",
      "formatted_end": "02:14:11.360",
      "text": "هر 21 روز فکرشو کن. بعد گرگان هم ماشین نداره با کرای ماشین بود. در 12 منیو در مید هر 21 روز برام."
    },
    {
      "id": 66,
      "start": 8051.36,
      "end": 8053.36,
      "formatted_start": "02:14:11.360",
      "formatted_end": "02:14:13.360",
      "text": "از شما نداره دستی کنید."
    },
    {
      "id": 67,
      "start": 8053.36,
      "end": 8055.36,
      "formatted_start": "02:14:13.360",
      "formatted_end": "02:14:15.360",
      "text": "بله شما سشکال ندارید."
    },
    {
      "id": 68,
      "start": 8055.36,
      "end": 8057.36,
      "formatted_start": "02:14:15.360",
      "formatted_end": "02:14:17.360",
      "text": "آره اینو ها که دیگه به خودشون."
    },
    {
      "id": 69,
      "start": 8057.36,
      "end": 8058.36,
      "formatted_start": "02:14:17.360",
      "formatted_end": "02:14:18.360",
      "text": "خدا."
    },
    {
      "id": 70,
      "start": 8058.36,
      "end": 8063.36,
      "formatted_start": "02:14:18.360",
      "formatted_end": "02:14:23.360",
      "text": "آره متاسفانه خدا اتفاقا من چند روز پاکی صحبت کردم."
    },
    {
      "id": 71,
      "start": 8063.36,
      "end": 8068.36,
      "formatted_start": "02:14:23.360",
      "formatted_end": "02:14:28.360",
      "text": "یک خانمی که خونه ماست و این گفتم باید خود رو دعا کن که سلامتی باشه."
    },
    {
      "id": 72,
      "start": 8068.36,
      "end": 8069.36,
      "formatted_start": "02:14:28.360",
      "formatted_end": "02:14:29.360",
      "text": "آره بیشتر خدا."
    },
    {
      "id": 73,
      "start": 8069.36,
      "end": 8074.82,
      "formatted_start": "02:14:29.360",
      "formatted_end": "02:14:34.820",
      "text": "ببینید، این یک دوره شده که همین من خود، الان امروز یه اتفاق برام بیاد و نتونم کار کنم"
    },
    {
      "id": 74,
      "start": 8074.82,
      "end": 8076.32,
      "formatted_start": "02:14:34.820",
      "formatted_end": "02:14:36.320",
      "text": "سلیگی بلنگ میشه"
    },
    {
      "id": 75,
      "start": 8076.32,
      "end": 8078.32,
      "formatted_start": "02:14:36.320",
      "formatted_end": "02:14:38.320",
      "text": "خدا، الان خیلی سخت شده"
    },
    {
      "id": 76,
      "start": 8078.32,
      "end": 8081.32,
      "formatted_start": "02:14:38.320",
      "formatted_end": "02:14:41.320",
      "text": "باید همه با هم بود و هم خود"
    },
    {
      "id": 77,
      "start": 8081.32,
      "end": 8085.82,
      "formatted_start": "02:14:41.320",
      "formatted_end": "02:14:45.820",
      "text": "چون بچه من که تو در طوری مثلا برای من همین رو نمیتونی بخری خود"
    },
    {
      "id": 78,
      "start": 8085.82,
      "end": 8088.82,
      "formatted_start": "02:14:45.820",
      "formatted_end": "02:14:48.820",
      "text": "اون از توی یه انتظار دستای من اینو دارن"
    },
    {
      "id": 79,
      "start": 8088.82,
      "end": 8090.82,
      "formatted_start": "02:14:48.820",
      "formatted_end": "02:14:50.820",
      "text": "یعنی اون از من یه انتظار بیشتر داره"
    },
    {
      "id": 80,
      "start": 8090.82,
      "end": 8092.82,
      "formatted_start": "02:14:50.820",
      "formatted_end": "02:14:52.820",
      "text": "ما همش داریم میدونیم"
    },
    {
      "id": 81,
      "start": 8092.82,
      "end": 8097.62,
      "formatted_start": "02:14:52.820",
      "formatted_end": "02:14:57.620",
      "text": "ما که اونجا بچه پول داری نبودیم که ازمون بشیم بخوریم نون"
    },
    {
      "id": 82,
      "start": 8097.62,
      "end": 8098.38,
      "formatted_start": "02:14:57.620",
      "formatted_end": "02:14:58.380",
      "text": "اونها شوق"
    },
    {
      "id": 83,
      "start": 8098.38,
      "end": 8099.98,
      "formatted_start": "02:14:58.380",
      "formatted_end": "02:14:59.980",
      "text": "بله من همیشه دیگه شوق"
    }
  ],
  "status": "completed"
}