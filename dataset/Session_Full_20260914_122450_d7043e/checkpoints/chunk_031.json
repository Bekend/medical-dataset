  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9302.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:02.000",
      "text": "باید بردارید که اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 9360.0,
      "end": 9370.0,
      "formatted_start": "02:36:00.000",
      "formatted_end": "02:36:10.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 9390.0,
      "end": 9419.98,
      "formatted_start": "02:36:30.000",
      "formatted_end": "02:36:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 4,
      "start": 9420.0,
      "end": 9450.0,
      "formatted_start": "02:37:00.000",
      "formatted_end": "02:37:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 5,
      "start": 9450.0,
      "end": 9452.0,
      "formatted_start": "02:37:30.000",
      "formatted_end": "02:37:32.000",
      "text": "از اینجا باید باید باستم"
    },
    {
      "id": 6,
      "start": 9452.0,
      "end": 9454.0,
      "formatted_start": "02:37:32.000",
      "formatted_end": "02:37:34.000",
      "text": "حال ندارم"
    },
    {
      "id": 7,
      "start": 9454.0,
      "end": 9456.0,
      "formatted_start": "02:37:34.000",
      "formatted_end": "02:37:36.000",
      "text": "چند وقتا اینجوری؟"
    },
    {
      "id": 8,
      "start": 9456.0,
      "end": 9458.0,
      "formatted_start": "02:37:36.000",
      "formatted_end": "02:37:38.000",
      "text": "چند وقتا اینجور شده"
    },
    {
      "id": 9,
      "start": 9458.0,
      "end": 9460.0,
      "formatted_start": "02:37:38.000",
      "formatted_end": "02:37:40.000",
      "text": "یه دفعه اینجور شده؟"
    },
    {
      "id": 10,
      "start": 9460.0,
      "end": 9462.0,
      "formatted_start": "02:37:40.000",
      "formatted_end": "02:37:42.000",
      "text": "قبلا از اینجور نبودی؟"
    },
    {
      "id": 11,
      "start": 9462.0,
      "end": 9464.0,
      "formatted_start": "02:37:42.000",
      "formatted_end": "02:37:44.000",
      "text": "میشودم خوب میشودم باز الان باشم شده"
    },
    {
      "id": 12,
      "start": 9464.0,
      "end": 9466.0,
      "formatted_start": "02:37:44.000",
      "formatted_end": "02:37:46.000",
      "text": "صحبه روماتیزم طبعا چیزی دیگه نداشتی؟"
    },
    {
      "id": 13,
      "start": 9466.0,
      "end": 9468.0,
      "formatted_start": "02:37:46.000",
      "formatted_end": "02:37:48.000",
      "text": "نه"
    },
    {
      "id": 14,
      "start": 9468.0,
      "end": 9470.0,
      "formatted_start": "02:37:48.000",
      "formatted_end": "02:37:50.000",
      "text": "اوستا اینو هایی که یادم یاد"
    },
    {
      "id": 15,
      "start": 9470.0,
      "end": 9472.0,
      "formatted_start": "02:37:50.000",
      "formatted_end": "02:37:52.000",
      "text": "اینجور گفتم نوشته چربیه تیره"
    },
    {
      "id": 16,
      "start": 9472.0,
      "end": 9474.0,
      "formatted_start": "02:37:52.000",
      "formatted_end": "02:37:54.000",
      "text": "آره تیره"
    },
    {
      "id": 17,
      "start": 9474.0,
      "end": 9476.0,
      "formatted_start": "02:37:54.000",
      "formatted_end": "02:37:56.000",
      "text": "چیزی دیگه میدارم اینجور دیگه نه"
    },
    {
      "id": 18,
      "start": 9476.0,
      "end": 9478.58,
      "formatted_start": "02:37:56.000",
      "formatted_end": "02:37:58.580",
      "text": "نمیزونم الان که هر دوتا رو گفتی نوشتی"
    },
    {
      "id": 19,
      "start": 9478.58,
      "end": 9481.02,
      "formatted_start": "02:37:58.580",
      "formatted_end": "02:38:01.020",
      "text": "هر چی میخوایی باید بیاری"
    },
    {
      "id": 20,
      "start": 9481.02,
      "end": 9482.5,
      "formatted_start": "02:38:01.020",
      "formatted_end": "02:38:02.500",
      "text": "باید بیارم"
    },
    {
      "id": 21,
      "start": 9482.5,
      "end": 9484.52,
      "formatted_start": "02:38:02.500",
      "formatted_end": "02:38:04.520",
      "text": "هر چی میخوایی باید بخوایی بیاری"
    },
    {
      "id": 22,
      "start": 9484.52,
      "end": 9487.6,
      "formatted_start": "02:38:04.520",
      "formatted_end": "02:38:07.600",
      "text": "خورس کدو برای کلیه مود"
    },
    {
      "id": 23,
      "start": 9487.6,
      "end": 9489.06,
      "formatted_start": "02:38:07.600",
      "formatted_end": "02:38:09.060",
      "text": "خورس نمیخوایی"
    },
    {
      "id": 24,
      "start": 9489.06,
      "end": 9491.6,
      "formatted_start": "02:38:09.060",
      "formatted_end": "02:38:11.600",
      "text": "سنگ کلیه داشتی"
    },
    {
      "id": 25,
      "start": 9491.6,
      "end": 9495.18,
      "formatted_start": "02:38:11.600",
      "formatted_end": "02:38:15.180",
      "text": "برای خورس کلیه"
    },
    {
      "id": 26,
      "start": 9495.18,
      "end": 9495.88,
      "formatted_start": "02:38:15.180",
      "formatted_end": "02:38:15.880",
      "text": "خورس کلیه هم نمیخوری"
    },
    {
      "id": 27,
      "start": 9495.88,
      "end": 9497.1,
      "formatted_start": "02:38:15.880",
      "formatted_end": "02:38:17.100",
      "text": "نمیخوری"
    },
    {
      "id": 28,
      "start": 9497.1,
      "end": 9499.1,
      "formatted_start": "02:38:17.100",
      "formatted_end": "02:38:19.100",
      "text": "این بیشتر باید بردارید"
    },
    {
      "id": 29,
      "start": 9499.1,
      "end": 9501.1,
      "formatted_start": "02:38:19.100",
      "formatted_end": "02:38:21.100",
      "text": "این بیشتر باید بردارید"
    },
    {
      "id": 30,
      "start": 9521.1,
      "end": 9523.1,
      "formatted_start": "02:38:41.100",
      "formatted_end": "02:38:43.100",
      "text": "بچه باید پرسیون بگذارید"
    },
    {
      "id": 31,
      "start": 9523.1,
      "end": 9525.1,
      "formatted_start": "02:38:43.100",
      "formatted_end": "02:38:45.100",
      "text": "بچه باید پرسیون بگذارید"
    },
    {
      "id": 32,
      "start": 9525.1,
      "end": 9527.1,
      "formatted_start": "02:38:45.100",
      "formatted_end": "02:38:47.100",
      "text": "اینو بخوری یکم جنبه داری"
    },
    {
      "id": 33,
      "start": 9527.1,
      "end": 9530.1,
      "formatted_start": "02:38:47.100",
      "formatted_end": "02:38:50.100",
      "text": "کلسیومشو خارجی برنیسا بیایید ایرانی برنیسا"
    },
    {
      "id": 34,
      "start": 9530.1,
      "end": 9532.1,
      "formatted_start": "02:38:50.100",
      "formatted_end": "02:38:52.100",
      "text": "ایران داشته بوده بیتر بیتر بیتر بیتر"
    },
    {
      "id": 35,
      "start": 9532.1,
      "end": 9534.1,
      "formatted_start": "02:38:52.100",
      "formatted_end": "02:38:54.100",
      "text": "خارجیش بیتره بیمه نمیخوره"
    },
    {
      "id": 36,
      "start": 9534.1,
      "end": 9536.1,
      "formatted_start": "02:38:54.100",
      "formatted_end": "02:38:56.100",
      "text": "ایرانیش بیمه هم خوره خب"
    },
    {
      "id": 37,
      "start": 9536.1,
      "end": 9541.1,
      "formatted_start": "02:38:56.100",
      "formatted_end": "02:39:01.100",
      "text": "ممکنه یکم بعض وقتا مریضا بگم مده اونو عذیب میکنه"
    },
    {
      "id": 38,
      "start": 9541.1,
      "end": 9543.1,
      "formatted_start": "02:39:01.100",
      "formatted_end": "02:39:03.100",
      "text": "بسیار"
    },
    {
      "id": 39,
      "start": 9543.1,
      "end": 9546.1,
      "formatted_start": "02:39:03.100",
      "formatted_end": "02:39:06.100",
      "text": "حالا من یکم تقویتی باید دست و پاس برنم بسن"
    },
    {
      "id": 40,
      "start": 9546.1,
      "end": 9552.1,
      "formatted_start": "02:39:06.100",
      "formatted_end": "02:39:12.100",
