  "stt_segments": [
    {
      "id": 0,
      "start": 22500.0,
      "end": 22502.0,
      "formatted_start": "06:15:00.000",
      "formatted_end": "06:15:02.000",
      "text": "بیشکردی همه همیرون کسی."
    },
    {
      "id": 1,
      "start": 22504.0,
      "end": 22506.0,
      "formatted_start": "06:15:04.000",
      "formatted_end": "06:15:06.000",
      "text": "چند روزه ای ارتباط سنیدی؟"
    },
    {
      "id": 2,
      "start": 22506.0,
      "end": 22508.0,
      "formatted_start": "06:15:06.000",
      "formatted_end": "06:15:08.000",
      "text": "همین روزه ای ارتباط سنیدی."
    },
    {
      "id": 3,
      "start": 22508.0,
      "end": 22510.0,
      "formatted_start": "06:15:08.000",
      "formatted_end": "06:15:10.000",
      "text": "همون روزه ده روزه ای ارتباط سنیدی."
    },
    {
      "id": 4,
      "start": 22510.0,
      "end": 22512.0,
      "formatted_start": "06:15:10.000",
      "formatted_end": "06:15:12.000",
      "text": "همون روزه ای ارتباط سنیدی؟"
    },
    {
      "id": 5,
      "start": 22512.0,
      "end": 22514.0,
      "formatted_start": "06:15:12.000",
      "formatted_end": "06:15:14.000",
      "text": "نه، همون روزه ای ارتباط سنیدی."
    },
    {
      "id": 6,
      "start": 22514.0,
      "end": 22516.0,
      "formatted_start": "06:15:14.000",
      "formatted_end": "06:15:16.000",
      "text": "همون روزه ای ارتباط سنیدی؟"
    },
    {
      "id": 7,
      "start": 22516.0,
      "end": 22518.0,
      "formatted_start": "06:15:16.000",
      "formatted_end": "06:15:18.000",
      "text": "نه، همون روزه ای ارتباط سنیدی."
    },
    {
      "id": 8,
      "start": 22518.0,
      "end": 22520.0,
      "formatted_start": "06:15:18.000",
      "formatted_end": "06:15:20.000",
      "text": "همون روزه ای ارتباط سنیدی؟"
    },
    {
      "id": 9,
      "start": 22520.0,
      "end": 22522.0,
      "formatted_start": "06:15:20.000",
      "formatted_end": "06:15:22.000",
      "text": "نه، همون روزه ای ارتباط سنیدی."
    },
    {
      "id": 10,
      "start": 22530.0,
      "end": 22532.0,
      "formatted_start": "06:15:30.000",
      "formatted_end": "06:15:32.000",
      "text": "این برسه شما نیست"
    },
    {
      "id": 11,
      "start": 22532.0,
      "end": 22534.0,
      "formatted_start": "06:15:32.000",
      "formatted_end": "06:15:34.000",
      "text": "جان نردی بود"
    },
    {
      "id": 12,
      "start": 22538.0,
      "end": 22540.0,
      "formatted_start": "06:15:38.000",
      "formatted_end": "06:15:40.000",
      "text": "او خب اون چیز باست مادر شده"
    },
    {
      "id": 13,
      "start": 22540.0,
      "end": 22542.0,
      "formatted_start": "06:15:40.000",
      "formatted_end": "06:15:42.000",
      "text": "اون درخوا همین می کن کرده"
    },
    {
      "id": 14,
      "start": 22542.0,
      "end": 22544.0,
      "formatted_start": "06:15:42.000",
      "formatted_end": "06:15:44.000",
      "text": "تنها تنهایی که بیرون داره"
    },
    {
      "id": 15,
      "start": 22544.0,
      "end": 22546.0,
      "formatted_start": "06:15:44.000",
      "formatted_end": "06:15:46.000",
      "text": "بر مامانش آورده"
    },
    {
      "id": 16,
      "start": 22546.0,
      "end": 22548.0,
      "formatted_start": "06:15:46.000",
      "formatted_end": "06:15:48.000",
      "text": "سکت کرده"
    },
    {
      "id": 17,
      "start": 22548.0,
      "end": 22550.0,
      "formatted_start": "06:15:48.000",
      "formatted_end": "06:15:50.000",
      "text": "نه نه"
    },
    {
      "id": 18,
      "start": 22550.0,
      "end": 22552.0,
      "formatted_start": "06:15:50.000",
      "formatted_end": "06:15:52.000",
      "text": "اونه که مامانش سکت کرده"
    },
    {
      "id": 19,
      "start": 22552.0,
      "end": 22554.0,
      "formatted_start": "06:15:52.000",
      "formatted_end": "06:15:54.000",
      "text": "برون رسیده"
    },
    {
      "id": 20,
      "start": 22554.0,
      "end": 22556.0,
      "formatted_start": "06:15:54.000",
      "formatted_end": "06:15:56.000",
      "text": "بر صنمت باشه"
    },
    {
      "id": 21,
      "start": 22556.0,
      "end": 22558.0,
      "formatted_start": "06:15:56.000",
      "formatted_end": "06:15:58.000",
      "text": "خداحس"
    },
    {
      "id": 22,
      "start": 22558.0,
      "end": 22560.0,
      "formatted_start": "06:15:58.000",
      "formatted_end": "06:16:00.000",
      "text": "بابا همون بیزی با هم رفتیم؟"
    },
    {
      "id": 23,
      "start": 22560.0,
      "end": 22562.0,
      "formatted_start": "06:16:00.000",
      "formatted_end": "06:16:02.000",
      "text": "بیزی همون شبه رفتیم"
    },
    {
      "id": 24,
      "start": 22562.0,
      "end": 22565.0,
      "formatted_start": "06:16:02.000",
      "formatted_end": "06:16:05.000",
      "text": "اون که براش گفتند که بندر به داراشون خوب نبود که"
    },
    {
      "id": 25,
      "start": 22565.0,
      "end": 22566.0,
      "formatted_start": "06:16:05.000",
      "formatted_end": "06:16:06.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 26,
      "start": 22566.0,
      "end": 22567.0,
      "formatted_start": "06:16:06.000",
      "formatted_end": "06:16:07.000",
      "text": "برام نمیفرده"
    },
    {
      "id": 27,
      "start": 22567.0,
      "end": 22568.0,
      "formatted_start": "06:16:07.000",
      "formatted_end": "06:16:08.000",
      "text": "برام شبه رفتیم"
    },
    {
      "id": 28,
      "start": 22568.0,
      "end": 22570.0,
      "formatted_start": "06:16:08.000",
      "formatted_end": "06:16:10.000",
      "text": "داراشون خوب نبوده"
    },
    {
      "id": 29,
      "start": 22570.0,
      "end": 22571.0,
      "formatted_start": "06:16:10.000",
      "formatted_end": "06:16:11.000",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 22572.0,
      "end": 22577.0,
      "formatted_start": "06:16:12.000",
      "formatted_end": "06:16:17.000",
      "text": "کنانگومی و زنم شبه هم پنج مکشی میتونه تحلیل و تحلیل بگیره"
    },
    {
      "id": 31,
      "start": 22578.0,
      "end": 22581.0,
      "formatted_start": "06:16:18.000",
      "formatted_end": "06:16:21.000",
      "text": "دکتر قرار به دامان میگه، پنج"
    },
    {
      "id": 32,
      "start": 22582.0,
      "end": 22583.0,
      "formatted_start": "06:16:22.000",
      "formatted_end": "06:16:23.000",
      "text": "و دکتر بگیره"
    },
    {
      "id": 33,
      "start": 22584.0,
      "end": 22585.0,
      "formatted_start": "06:16:24.000",
      "formatted_end": "06:16:25.000",
      "text": "چقدر؟"
    },
    {
      "id": 34,
      "start": 22585.0,
      "end": 22586.0,
      "formatted_start": "06:16:25.000",
      "formatted_end": "06:16:26.000",
      "text": "آنها فنج"
    },
    {
      "id": 35,
      "start": 22586.0,
      "end": 22587.0,
      "formatted_start": "06:16:26.000",
      "formatted_end": "06:16:27.000",
      "text": "چهار"
    },
    {
      "id": 36,
      "start": 22587.0,
      "end": 22595.0,
      "formatted_start": "06:16:27.000",
      "formatted_end": "06:16:35.000",
      "text": "اول باریزی کنه بعد رو کهید دیگه نامونید"
    },
    {
      "id": 37,
      "start": 22595.0,
      "end": 22599.0,
      "formatted_start": "06:16:35.000",
      "formatted_end": "06:16:39.000",
      "text": "خب اول باریزی کنه بعد نامونید"
    },
    {
      "id": 38,
      "start": 22599.0,
      "end": 22603.0,
      "formatted_start": "06:16:39.000",
      "formatted_end": "06:16:43.000",
      "text": "خب گرده چیه بست که نماز دارید"
    },
    {
      "id": 39,
      "start": 22603.0,
      "end": 22609.0,
      "formatted_start": "06:16:43.000",
      "formatted_end": "06:16:49.000",
      "text": "آبیشی جا مهارت دکتر مان آزمایشی هستی که من یه آزمایش ها بودم فرمادی کلیه ها دیگه نامونید"
    },
    {
      "id": 40,
      "start": 22609.0,
      "end": 22615.0,
      "formatted_start": "06:16:49.000",
      "formatted_end": "06:16:55.000",
      "text": "یکیشون کمکاره نمک نخوره چی نخوره تا بعد دست ما بیاد"
    },
    {
      "id": 41,
      "start": 22615.0,
      "end": 22619.0,
      "formatted_start": "06:16:55.000",
      "formatted_end": "06:16:59.000",
      "text": "چرا زرمان قلبتو پایینه؟ قصد قلب چی میخوری؟"
    },
    {
      "id": 42,
      "start": 22619.0,
      "end": 22625.0,
      "formatted_start": "06:16:59.000",
      "formatted_end": "06:17:05.000",
      "text": "قصد قلب؟ اطرافا بعد از خدمتشونو دعا داشته بشه آیر ارمانی خیلی نوشته"
    },
    {
      "id": 43,
      "start": 22625.0,
      "end": 22627.0,
      "formatted_start": "06:17:05.000",
      "formatted_end": "06:17:07.000",
      "text": "بیادم بسیار چی هست؟"
    },
    {
      "id": 44,
      "start": 22627.0,
      "end": 22629.0,
      "formatted_start": "06:17:07.000",
      "formatted_end": "06:17:09.000",
      "text": "بیاد اینکه یه دارو تونو باید کم کنم زیاده"
    },
    {
      "id": 45,
      "start": 22629.0,
      "end": 22631.0,
      "formatted_start": "06:17:09.000",
      "formatted_end": "06:17:11.000",
      "text": "میگم زیاده نوشته یکی رو نوشته"
    },
    {
      "id": 46,
      "start": 22631.0,
      "end": 22634.0,
      "formatted_start": "06:17:11.000",
      "formatted_end": "06:17:14.000",
      "text": "یکی هست که بدنتون داره بیقوفه میکنه خوش؟"
    },
    {
      "id": 47,
      "start": 22634.0,
      "end": 22635.0,
      "formatted_start": "06:17:14.000",
      "formatted_end": "06:17:15.000",
      "text": "بشه باید نوشته شو"
    },
    {
      "id": 48,
      "start": 22635.0,
      "end": 22639.0,
      "formatted_start": "06:17:15.000",
      "formatted_end": "06:17:19.000",
      "text": "زرمان قلبتونو انداخته پایین این قلبت نمی کشه بره"
    },
    {
      "id": 49,
      "start": 22639.0,
      "end": 22642.0,
      "formatted_start": "06:17:19.000",
      "formatted_end": "06:17:22.000",
      "text": "یکیشو بعد چشمتون برنامه کمی نداره"
    },
    {
      "id": 50,
      "start": 22642.0,
      "end": 22645.0,
      "formatted_start": "06:17:22.000",
      "formatted_end": "06:17:25.000",
      "text": "وقت کندم من مثل که هپاتیت مشاهده شده دارم"
    },
    {
      "id": 51,
      "start": 22645.0,
      "end": 22647.0,
      "formatted_start": "06:17:25.000",
      "formatted_end": "06:17:27.000",
      "text": "آزمایش های گربان"
    },
    {
      "id": 52,
      "start": 22647.0,
      "end": 22649.0,
      "formatted_start": "06:17:27.000",
      "formatted_end": "06:17:29.000",
      "text": "این هم پرموده بوده"
    },
    {
      "id": 53,
      "start": 22649.0,
      "end": 22651.0,
      "formatted_start": "06:17:29.000",
      "formatted_end": "06:17:31.000",
      "text": "شما هم آزمایش دادین هپاتیت؟"
    },
    {
      "id": 54,
      "start": 22651.0,
      "end": 22652.0,
      "formatted_start": "06:17:31.000",
      "formatted_end": "06:17:32.000",
      "text": "نه دیگه"
    },
    {
      "id": 55,
      "start": 22652.0,
      "end": 22654.0,
      "formatted_start": "06:17:32.000",
      "formatted_end": "06:17:34.000",
      "text": "از بردن هم برای شما هم بدید"
    },
    {
      "id": 56,
      "start": 22654.0,
      "end": 22658.0,
      "formatted_start": "06:17:34.000",
      "formatted_end": "06:17:38.000",
      "text": "برای همین خدمت رسیدن برای هم باید کلی ها باید بردیم"
    },
    {
      "id": 57,
      "start": 22658.0,
      "end": 22663.0,
      "formatted_start": "06:17:38.000",
      "formatted_end": "06:17:43.000",
      "text": "بعد بابا برش مزد خب برسم همخوابی دارین؟"
    },
    {
      "id": 58,
      "start": 22663.0,
      "end": 22665.0,
      "formatted_start": "06:17:43.000",
      "formatted_end": "06:17:45.000",
      "text": "نه شبنه"
    },
    {
      "id": 59,
      "start": 22665.0,
      "end": 22673.16,
      "formatted_start": "06:17:45.000",
      "formatted_end": "06:17:53.160",
      "text": "نه خواهش بدهم چون خوشخواهان اپاتیت داره اگه بدونم هم بستر میشه بعد یه آنتی بادی چک کنم که بدونم اکسندو زنم"
    },
    {
      "id": 60,
      "start": 22673.16,
      "end": 22673.44,
      "formatted_start": "06:17:53.160",
      "formatted_end": "06:17:53.440",
      "text": "نه نه"
    },
    {
      "id": 61,
      "start": 22673.44,
      "end": 22674.1,
      "formatted_start": "06:17:53.440",
      "formatted_end": "06:17:54.100",
      "text": "اگه نکیش"
    },
    {
      "id": 62,
      "start": 22674.1,
      "end": 22675.34,
      "formatted_start": "06:17:54.100",
      "formatted_end": "06:17:55.340",
      "text": "خیلی باشم"
    },
    {
      "id": 63,
      "start": 22675.34,
      "end": 22677.06,
      "formatted_start": "06:17:55.340",
      "formatted_end": "06:17:57.060",
      "text": "شما قرن که نداشته نه"
    },
    {
      "id": 64,
      "start": 22677.06,
      "end": 22677.84,
      "formatted_start": "06:17:57.060",
      "formatted_end": "06:17:57.840",
      "text": "قرن دارم"
    },
    {
      "id": 65,
      "start": 22677.84,
      "end": 22679.2,
      "formatted_start": "06:17:57.840",
      "formatted_end": "06:17:59.200",
      "text": "پرستون و پینام"
    },
    {
      "id": 66,
      "start": 22679.2,
      "end": 22681.5,
      "formatted_start": "06:17:59.200",
      "formatted_end": "06:18:01.500",
      "text": "نه انسونی میزنیم خیلی خیلی خوب"
    },
    {
      "id": 67,
      "start": 22681.5,
      "end": 22683.74,
      "formatted_start": "06:18:01.500",
      "formatted_end": "06:18:03.740",
      "text": "من که آزمایش شما رو کامل نوشتم"
    },
    {
      "id": 68,
      "start": 22683.74,
      "end": 22686.2,
      "formatted_start": "06:18:03.740",
      "formatted_end": "06:18:06.200",
      "text": "اپاتیت شما رو چک کردم"
    },
    {
      "id": 69,
      "start": 22686.2,
      "end": 22689.88,
      "formatted_start": "06:18:06.200",
      "formatted_end": "06:18:09.880",
      "text": "بچه هم آزمایش دادم"
    },
    {
      "id": 70,
      "start": 22689.88,
      "end": 22693.0,
      "formatted_start": "06:18:09.880",
      "formatted_end": "06:18:13.000",
      "text": "بچه های خونه هم بعد آزمایش ندید"
    },
    {
      "id": 71,
      "start": 22695.0,
      "end": 22702.0,
      "formatted_start": "06:18:15.000",
      "formatted_end": "06:18:22.000",
      "text": "اونا چون نیستن ایجاد، لاننده این از آن بیرونن آمدن میپرسن خدمت شما"
    },
    {
      "id": 72,
      "start": 22715.0,
      "end": 22723.0,
      "formatted_start": "06:18:35.000",
      "formatted_end": "06:18:43.000",
      "text": "کشنده یا چی؟ بابتی؟ نه، بستگی داره بدن تو چه وضعی باشه، خاموش باشه یا فقه"
    },
    {
      "id": 73,
      "start": 22723.0,
      "end": 22739.0,
      "formatted_start": "06:18:43.000",
      "formatted_end": "06:18:59.000",
      "text": "اگر خاموش باشید، ولی شما ناخونگیر و شونه و مسئله که با خون تماس داره اینا جدا باشه از ظرف هم از بیبان هم غذا نباید بخورید. در این حال. ولی مثلا تو روایت معمولی منتقل نمیشه."
    },
    {
      "id": 74,
      "start": 22739.0,
      "end": 22744.0,
      "formatted_start": "06:18:59.000",
      "formatted_end": "06:19:04.000",
      "text": "خیلی ما از آنها میترسیم بهش بگیم مثلا تا باشو بطور بر شباطی میشویم"
    },
    {
      "id": 75,
      "start": 22744.0,
      "end": 22750.0,
      "formatted_start": "06:19:04.000",
      "formatted_end": "06:19:10.000",
      "text": "نه همون که تو از باشو هم نخوری وگرنه قاتی شد مهم از شسته بشه کلا از برم بگم"
    },
    {
      "id": 76,
      "start": 22750.0,
      "end": 22757.0,
      "formatted_start": "06:19:10.000",
      "formatted_end": "06:19:17.000",
      "text": "چون این از اون بچه کهش ناقص بود من اینو مثلا به دابتنب انتخاب کردم"
    },
    {
      "id": 77,
      "start": 22757.0,
      "end": 22760.0,
      "formatted_start": "06:19:17.000",
      "formatted_end": "06:19:20.000",
      "text": "که خوشبختش کنم ولی امامت بدبخت شد"
    },
    {
      "id": 78,
      "start": 22760.0,
      "end": 22768.0,
      "formatted_start": "06:19:20.000",
      "formatted_end": "06:19:28.000",
      "text": "بچه مریض شد و کنه شنزده سال با همون پای لنگش بچه رو بگه داشت"
    },
    {
      "id": 79,
      "start": 22768.0,
      "end": 22774.0,
      "formatted_start": "06:19:28.000",
      "formatted_end": "06:19:34.000",
      "text": "من هر کاری کردم زیارتگاه این و آن برگار یک بار نگفت نه"
    },
    {
      "id": 80,
      "start": 22774.0,
      "end": 22778.0,
      "formatted_start": "06:19:34.000",
      "formatted_end": "06:19:38.000",
      "text": "من با راهنمایون دو نفر بچه رو ختم کردم"
    },
    {
      "id": 81,
      "start": 22778.0,
      "end": 22782.0,
      "formatted_start": "06:19:38.000",
      "formatted_end": "06:19:42.000",
      "text": "داشتاد که بچه رو خودم دوست داشتن ولی دیگران دوست میخریدم"
    },
    {
      "id": 82,
      "start": 22782.0,
      "end": 22783.0,
      "formatted_start": "06:19:42.000",
      "formatted_end": "06:19:43.000",
      "text": "او خدا خیلی خوب"
    },
    {
      "id": 83,
      "start": 22783.0,
      "end": 22786.0,
      "formatted_start": "06:19:43.000",
      "formatted_end": "06:19:46.000",
      "text": "اینم شاکار بود ترزیم بگیرم"
    },
    {
      "id": 84,
      "start": 22786.0,
      "end": 22793.0,
      "formatted_start": "06:19:46.000",
      "formatted_end": "06:19:53.000",
      "text": "میترسیم بهش میگم اصلا میترسیم بهش میگم که تو حفاظت داری نزدیک ما نه یا کچی"
    },
    {
      "id": 85,
      "start": 22793.0,
      "end": 22795.0,
      "formatted_start": "06:19:53.000",
      "formatted_end": "06:19:55.000",
      "text": "نه نه اصلا انتخاب نداریم"
    },
    {
      "id": 86,
      "start": 22795.0,
      "end": 22799.0,
      "formatted_start": "06:19:55.000",
      "formatted_end": "06:19:59.000",
      "text": "کامل فروسی اینا هیچ مشکلی نداریم"
    }
  ],
  "status": "completed"
}