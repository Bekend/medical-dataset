  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13503.24,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:03.240",
      "text": "یک وقت اشتباه من خودی باشه، خیلی دارو خطرناکیه."
    },
    {
      "id": 1,
      "start": 13503.24,
      "end": 13504.24,
      "formatted_start": "03:45:03.240",
      "formatted_end": "03:45:04.240",
      "text": "کدومه؟"
    },
    {
      "id": 2,
      "start": 13504.24,
      "end": 13505.24,
      "formatted_start": "03:45:04.240",
      "formatted_end": "03:45:05.240",
      "text": "اشتباه خوردنش."
    },
    {
      "id": 3,
      "start": 13505.24,
      "end": 13507.24,
      "formatted_start": "03:45:05.240",
      "formatted_end": "03:45:07.240",
      "text": "داروها تو گرفتی؟"
    },
    {
      "id": 4,
      "start": 13507.24,
      "end": 13508.24,
      "formatted_start": "03:45:07.240",
      "formatted_end": "03:45:08.240",
      "text": "گرفتم باش."
    },
    {
      "id": 5,
      "start": 13508.24,
      "end": 13515.24,
      "formatted_start": "03:45:08.240",
      "formatted_end": "03:45:15.240",
      "text": "بخوامش نفرهایی بگو درست جمعی شد، دارو منو خودش تنظیم میکنه. داروتو من تنظیم میکنم. باشه؟"
    },
    {
      "id": 6,
      "start": 13515.24,
      "end": 13516.24,
      "formatted_start": "03:45:15.240",
      "formatted_end": "03:45:16.240",
      "text": "باش."
    },
    {
      "id": 7,
      "start": 13518.24,
      "end": 13523.24,
      "formatted_start": "03:45:18.240",
      "formatted_end": "03:45:23.240",
      "text": "من میخواهم یه نسخه تو بلیم بسام ببین چقدر میشه. برای دارو خونه بگیر ببین چقدر میشه."
    },
    {
      "id": 8,
      "start": 13523.24,
      "end": 13525.84,
      "formatted_start": "03:45:23.240",
      "formatted_end": "03:45:25.840",
      "text": "اونها همه چون خارجی یه سایت ترگیرد اینجا"
    },
    {
      "id": 9,
      "start": 13525.84,
      "end": 13529.8,
      "formatted_start": "03:45:25.840",
      "formatted_end": "03:45:29.800",
      "text": "چون اصلا بیمه هم هم تبون نکرد"
    },
    {
      "id": 10,
      "start": 13529.8,
      "end": 13531.48,
      "formatted_start": "03:45:29.800",
      "formatted_end": "03:45:31.480",
      "text": "چون خارجی هست"
    },
    {
      "id": 11,
      "start": 13531.48,
      "end": 13533.56,
      "formatted_start": "03:45:31.480",
      "formatted_end": "03:45:33.560",
      "text": "الان برو داروات بگیر بگیر چون"
    },
    {
      "id": 12,
      "start": 13533.56,
      "end": 13536.68,
      "formatted_start": "03:45:33.560",
      "formatted_end": "03:45:36.680",
      "text": "کل داروهای بیماریت همه اینقدر"
    },
    {
      "id": 13,
      "start": 13536.68,
      "end": 13538.94,
      "formatted_start": "03:45:36.680",
      "formatted_end": "03:45:38.940",
      "text": "بر همه رو گرفتم بیارم"
    },
    {
      "id": 14,
      "start": 13538.94,
      "end": 13540.84,
      "formatted_start": "03:45:38.940",
      "formatted_end": "03:45:40.840",
      "text": "و یه آزمایش هم بدم"
    },
    {
      "id": 15,
      "start": 13540.84,
      "end": 13541.94,
      "formatted_start": "03:45:40.840",
      "formatted_end": "03:45:41.940",
      "text": "و داروارم بگیرم"
    },
    {
      "id": 16,
      "start": 13541.94,
      "end": 13544.2,
      "formatted_start": "03:45:41.940",
      "formatted_end": "03:45:44.200",
      "text": "نه دارواتو که الان بگیر برنا ببینیم"
    },
    {
      "id": 17,
      "start": 13544.2,
      "end": 13547.06,
      "formatted_start": "03:45:44.200",
      "formatted_end": "03:45:47.060",
      "text": "دارواتو بگیر برنا ببینیم"
    },
    {
      "id": 18,
      "start": 13547.06,
      "end": 13549.14,
      "formatted_start": "03:45:47.060",
      "formatted_end": "03:45:49.140",
      "text": "اینو بخواهم گلشین بگوییم کود بزنم"
    },
    {
      "id": 19,
      "start": 13549.14,
      "end": 13551.6,
      "formatted_start": "03:45:49.140",
      "formatted_end": "03:45:51.600",
      "text": "این کودشو به حد بده شما پروردت باشه"
    },
    {
      "id": 20,
      "start": 13551.6,
      "end": 13555.38,
      "formatted_start": "03:45:51.600",
      "formatted_end": "03:45:55.380",
      "text": "بعد آزمایشاتم با همین کود میری انجام میدی"
    },
    {
      "id": 21,
      "start": 13555.38,
      "end": 13563.14,
      "formatted_start": "03:45:55.380",
      "formatted_end": "03:46:03.140",
      "text": "داره رو بیاری من خودم ببینم"
    },
    {
      "id": 22,
      "start": 13563.14,
      "end": 13567.2,
      "formatted_start": "03:46:03.140",
      "formatted_end": "03:46:07.200",
      "text": "مرسی ازتیم"
    },
    {
      "id": 23,
      "start": 13567.2,
      "end": 13567.98,
      "formatted_start": "03:46:07.200",
      "formatted_end": "03:46:07.980",
      "text": "برمانه مرسی"
    },
    {
      "id": 24,
      "start": 13567.98,
      "end": 13570.48,
      "formatted_start": "03:46:07.980",
      "formatted_end": "03:46:10.480",
      "text": "برمانه دارهات چیه؟ نگرانم"
    },
    {
      "id": 25,
      "start": 13570.48,
      "end": 13571.8,
      "formatted_start": "03:46:10.480",
      "formatted_end": "03:46:11.800",
      "text": "مرسی"
    },
    {
      "id": 26,
      "start": 13571.8,
      "end": 13573.14,
      "formatted_start": "03:46:11.800",
      "formatted_end": "03:46:13.140",
      "text": "برمانه"
    },
    {
      "id": 27,
      "start": 13573.14,
      "end": 13575.14,
      "formatted_start": "03:46:13.140",
      "formatted_end": "03:46:15.140",
      "text": "برمانه"
    },
    {
      "id": 28,
      "start": 13575.14,
      "end": 13577.14,
      "formatted_start": "03:46:15.140",
      "formatted_end": "03:46:17.140",
      "text": "برمانه"
    },
    {
      "id": 29,
      "start": 13577.14,
      "end": 13577.64,
      "formatted_start": "03:46:17.140",
      "formatted_end": "03:46:17.640",
      "text": "برمانه"
    },
    {
      "id": 30,
      "start": 13577.64,
      "end": 13579.64,
      "formatted_start": "03:46:17.640",
      "formatted_end": "03:46:19.640",
      "text": "این فرمان دیواره"
    },
    {
      "id": 31,
      "start": 13579.64,
      "end": 13581.64,
      "formatted_start": "03:46:19.640",
      "formatted_end": "03:46:21.640",
      "text": "داروشو بیا بیا من بگم"
    },
    {
      "id": 32,
      "start": 13581.64,
      "end": 13583.64,
      "formatted_start": "03:46:21.640",
      "formatted_end": "03:46:23.640",
      "text": "من دختر جوی"
    },
    {
      "id": 33,
      "start": 13583.64,
      "end": 13585.64,
      "formatted_start": "03:46:23.640",
      "formatted_end": "03:46:25.640",
