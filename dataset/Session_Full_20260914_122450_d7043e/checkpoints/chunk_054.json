  "stt_segments": [
    {
      "id": 0,
      "start": 16200.0,
      "end": 16215.0,
      "formatted_start": "04:30:00.000",
      "formatted_end": "04:30:15.000",
      "text": "در اینجا، دوازده کشوک، ده تا دوازده کشوک، زیر نمیشید، ماش پرده از لبیه چش بلبلی، چش بلبلی خوش قند رو میاره پایین، آفز میکنید، دوازده کشوک، که از اینه شیش خشوک از اون میرسید، میشه یک خوشخواب بار."
    },
    {
      "id": 1,
      "start": 16215.0,
      "end": 16219.0,
      "formatted_start": "04:30:15.000",
      "formatted_end": "04:30:19.000",
      "text": "مثلا با سبز شنبلیه در یک همین جایی درست میکنید که باز قندش رو میاره پایین."
    },
    {
      "id": 2,
      "start": 16219.0,
      "end": 16225.0,
      "formatted_start": "04:30:19.000",
      "formatted_end": "04:30:25.000",
      "text": "و قبل قضا قبل اینکه صبح را پند کنید چه صبحانه نهارشان قانونتون باشه"
    },
    {
      "id": 3,
      "start": 16225.0,
      "end": 16231.0,
      "formatted_start": "04:30:25.000",
      "formatted_end": "04:30:31.000",
      "text": "آیا صبحانه شان باشه یکم خیار گوجه یعنی خیار گوجه در روز یک چیزی که زیاد بگرد"
    },
    {
      "id": 4,
      "start": 16231.0,
      "end": 16238.0,
      "formatted_start": "04:30:31.000",
      "formatted_end": "04:30:38.000",
      "text": "بعد خیار گوجه کلم که آهوی نهار ازمی کنید یا کدوم آفز بادم چون آفز قهرچه آفز"
    },
    {
      "id": 5,
      "start": 16238.0,
      "end": 16243.0,
      "formatted_start": "04:30:38.000",
      "formatted_end": "04:30:43.000",
      "text": "نخوت فرنگی خدا با همین صرف جاد اول نوم سر صفره نمیارید"
    },
    {
      "id": 6,
      "start": 16243.0,
      "end": 16251.0,
      "formatted_start": "04:30:43.000",
      "formatted_end": "04:30:51.000",
      "text": "این بشکاب رو میاری خالی خالی یک کم میخوره اون بلر میکشه پایین اون شدت برس نگه رو بعد شروع میان"
    },
    {
      "id": 7,
      "start": 16251.0,
      "end": 16257.0,
      "formatted_start": "04:30:51.000",
      "formatted_end": "04:30:57.000",
      "text": "چون دیاویت نون دوست داره برنج دوست داره بر نقمه ها تو کوچینی بگیر"
    },
    {
      "id": 8,
      "start": 16257.0,
      "end": 16261.0,
      "formatted_start": "04:30:57.000",
      "formatted_end": "04:31:01.000",
      "text": "نقمه ها کوچین کوچین بگیر اول که اونها رو خوردی بعد ازاتون رو شروع کن"
    },
    {
      "id": 9,
      "start": 16261.0,
      "end": 16267.0,
      "formatted_start": "04:31:01.000",
      "formatted_end": "04:31:07.000",
      "text": "مثلا ماست درگ میاری ماست کلت رو درست کنی که بعدشو باش بیاره پایین"
    },
    {
      "id": 10,
      "start": 16267.0,
      "end": 16271.0,
      "formatted_start": "04:31:07.000",
      "formatted_end": "04:31:11.000",
      "text": "مثلا بامیه برشون ها پس باید باشکندشون میادر کنید"
    },
    {
      "id": 11,
      "start": 16271.0,
      "end": 16277.0,
      "formatted_start": "04:31:11.000",
      "formatted_end": "04:31:17.000",
      "text": "داروشون چون داروی کمی نیست بس سنشون سن نیست که یه دفعه بخواییم دوزرزین ببریم باداتر"
    },
    {
      "id": 12,
      "start": 16277.0,
      "end": 16282.0,
      "formatted_start": "04:31:17.000",
      "formatted_end": "04:31:22.000",
      "text": "دیگه گل گلازی شسته باداترش هشتاده این بامیه نه دیگه خودش هزاره"
    },
    {
      "id": 13,
      "start": 16282.0,
      "end": 16289.0,
      "formatted_start": "04:31:22.000",
      "formatted_end": "04:31:29.000",
      "text": "گلورنتا تا هشت بخواییم بیست و پنج پنج شده اینو باید بذاریم بعده بیست سال دیگه نه الان که باید سنتون خب"
    },
    {
      "id": 14,
      "start": 16289.0,
      "end": 16291.0,
      "formatted_start": "04:31:29.000",
      "formatted_end": "04:31:31.000",
      "text": "خب؟ از شما دیگه باید رژیمو جمعیم"
    },
    {
      "id": 15,
      "start": 16291.0,
      "end": 16295.0,
      "formatted_start": "04:31:31.000",
      "formatted_end": "04:31:35.000",
      "text": "شعورتون همین برای قندتون هم حتما برای خود"
    },
    {
      "id": 16,
      "start": 16295.0,
      "end": 16299.0,
      "formatted_start": "04:31:35.000",
      "formatted_end": "04:31:39.000",
      "text": "حالا الان تابستان به خاطر میوه ها کلا قند همه بالا رفته"
    },
    {
      "id": 17,
      "start": 16299.0,
      "end": 16302.0,
      "formatted_start": "04:31:39.000",
      "formatted_end": "04:31:42.000",
      "text": "یعنی معال کسی هندونه خربوز انگور نخورو"
    },
    {
      "id": 18,
      "start": 16302.0,
      "end": 16306.0,
      "formatted_start": "04:31:42.000",
      "formatted_end": "04:31:46.000",
      "text": "همه میان یه هندونه خوردن یه خربوزه بردن"
    },
    {
      "id": 19,
      "start": 16306.0,
      "end": 16310.0,
      "formatted_start": "04:31:46.000",
      "formatted_end": "04:31:50.000",
      "text": "اصلا بخواد شما یه میوه یکی ایتون یکی خواهد هست که من بخورم"
    },
    {
      "id": 20,
      "start": 16310.0,
      "end": 16314.0,
      "formatted_start": "04:31:50.000",
      "formatted_end": "04:31:54.000",
      "text": "این 3-4 دایی که نباید بخورین همه یکیشو بردن میخورن یعنی"
    },
    {
      "id": 21,
      "start": 16314.0,
      "end": 16319.0,
      "formatted_start": "04:31:54.000",
      "formatted_end": "04:31:59.000",
      "text": "اول اینکه خود شما خرازه هنگور هندونه"
    },
    {
      "id": 22,
      "start": 16319.0,
      "end": 16322.0,
      "formatted_start": "04:31:59.000",
      "formatted_end": "04:32:02.000",
      "text": "اول اول اول شما پیاده رویتونو زیاد کنید"
    },
    {
      "id": 23,
      "start": 16322.0,
      "end": 16324.0,
      "formatted_start": "04:32:02.000",
      "formatted_end": "04:32:04.000",
      "text": "پیاده رویت زیاد می کنم من"
    },
    {
      "id": 24,
      "start": 16324.0,
      "end": 16325.0,
      "formatted_start": "04:32:04.000",
      "formatted_end": "04:32:05.000",
      "text": "پیاده رویت زیاد می کنم"
    },
    {
      "id": 25,
      "start": 16325.0,
      "end": 16328.0,
      "formatted_start": "04:32:05.000",
      "formatted_end": "04:32:08.000",
      "text": "کارتون نه ها پیاده رویت به دست داره"
    },
    {
      "id": 26,
      "start": 16328.0,
      "end": 16333.0,
      "formatted_start": "04:32:08.000",
      "formatted_end": "04:32:13.000",
      "text": "پیاده رویت باید اینجوری باشه که صدای زربان قلبتو بشنرید"
    },
    {
      "id": 27,
      "start": 16333.0,
      "end": 16335.0,
      "formatted_start": "04:32:13.000",
      "formatted_end": "04:32:15.000",
      "text": "عرق کردن مهم نیست"
    },
    {
      "id": 28,
      "start": 16335.0,
      "end": 16338.0,
      "formatted_start": "04:32:15.000",
      "formatted_end": "04:32:18.000",
      "text": "صدای زربانتو باید بشنرید"
    },
    {
      "id": 29,
      "start": 16338.0,
      "end": 16340.0,
      "formatted_start": "04:32:18.000",
      "formatted_end": "04:32:20.000",
      "text": "اون موقع متابولیسمتون بالا میلند"
    },
    {
      "id": 30,
      "start": 16340.0,
      "end": 16342.0,
      "formatted_start": "04:32:20.000",
      "formatted_end": "04:32:22.000",
      "text": "سی دقیقه پشت از سرها هم"
    },
    {
      "id": 31,
      "start": 16342.0,
      "end": 16344.0,
      "formatted_start": "04:32:22.000",
      "formatted_end": "04:32:24.000",
      "text": "چند؟"
    },
    {
      "id": 32,
      "start": 16344.0,
      "end": 16346.0,
      "formatted_start": "04:32:24.000",
      "formatted_end": "04:32:26.000",
      "text": "از اینکه خودتی برده بین مریض"
    },
    {
      "id": 33,
      "start": 16346.0,
      "end": 16348.0,
      "formatted_start": "04:32:26.000",
      "formatted_end": "04:32:28.000",
      "text": "پورپیتیورو سید"
    },
    {
      "id": 34,
      "start": 16348.0,
      "end": 16350.0,
      "formatted_start": "04:32:28.000",
      "formatted_end": "04:32:30.000",
      "text": "آره چون شیر دهه ناشتا یه دونه بخوره"
    },
    {
      "id": 35,
      "start": 16350.0,
      "end": 16352.0,
      "formatted_start": "04:32:30.000",
      "formatted_end": "04:32:32.000",
      "text": "ناشتا یه دونه بخوره؟"
    },
    {
      "id": 36,
      "start": 16352.0,
      "end": 16354.0,
      "formatted_start": "04:32:32.000",
      "formatted_end": "04:32:34.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 16354.0,
      "end": 16356.0,
      "formatted_start": "04:32:34.000",
      "formatted_end": "04:32:36.000",
      "text": "اون چیز رو کسی سر باشند که روز شب یکی بخوره"
    },
    {
      "id": 38,
      "start": 16356.0,
      "end": 16358.0,
      "formatted_start": "04:32:36.000",
      "formatted_end": "04:32:38.000",
      "text": "آره اون دروماتیسمه نیمد"
    },
    {
      "id": 39,
      "start": 16358.0,
      "end": 16360.0,
      "formatted_start": "04:32:38.000",
      "formatted_end": "04:32:40.000",
      "text": "نه نه ایمد"
    },
    {
      "id": 40,
      "start": 16360.0,
      "end": 16362.0,
      "formatted_start": "04:32:40.000",
      "formatted_end": "04:32:42.000",
      "text": "اون حواست باشه بیاد که امتیکسشو باید مشخص رو نباشد"
    },
    {
      "id": 41,
      "start": 16362.0,
      "end": 16367.34,
      "formatted_start": "04:32:42.000",
      "formatted_end": "04:32:47.340",
      "text": "اینجا باید مشخص اونها با پنج شب جمعه با اون داروش خیلی خطران رو که اشتباه نشده"
    },
    {
      "id": 42,
      "start": 16367.34,
      "end": 16376.34,
      "formatted_start": "04:32:47.340",
      "formatted_end": "04:32:56.340",
      "text": "اینو پنج، نوهت رو بیرون میده"
    },
    {
      "id": 43,
      "start": 16376.34,
      "end": 16378.76,
      "formatted_start": "04:32:56.340",
      "formatted_end": "04:32:58.760",
      "text": "سر بیست رو بگیرن سمیه نوهت رو"
    },
    {
      "id": 44,
      "start": 16378.76,
      "end": 16380.7,
      "formatted_start": "04:32:58.760",
      "formatted_end": "04:33:00.700",
      "text": "پنج رو یه گوتی شو، پنج سر بیست رو بیست"
    },
    {
      "id": 45,
      "start": 16380.7,
      "end": 16384.5,
      "formatted_start": "04:33:00.700",
      "formatted_end": "04:33:04.500",
      "text": "هر گوتی شو سیت رو بیرون"
    },
    {
      "id": 46,
      "start": 16384.5,
      "end": 16387.24,
      "formatted_start": "04:33:04.500",
      "formatted_end": "04:33:07.240",
      "text": "نوهت رو میشه چلا پنج روز"
    },
    {
      "id": 47,
      "start": 16387.24,
      "end": 16389.36,
      "formatted_start": "04:33:07.240",
      "formatted_end": "04:33:09.360",
      "text": "در موابع سده گوتی میشه درسته؟"
    },
    {
      "id": 48,
      "start": 16389.36,
      "end": 16390.38,
      "formatted_start": "04:33:09.360",
      "formatted_end": "04:33:10.380",
      "text": "آره سده گوتی میشه"
    },
    {
      "id": 49,
      "start": 16390.38,
      "end": 16392.38,
      "formatted_start": "04:33:10.380",
      "formatted_end": "04:33:12.380",
      "text": "آره، حالا سه با تونه داشتون"
    },
    {
      "id": 50,
      "start": 16399.38,
      "end": 16404.38,
      "formatted_start": "04:33:19.380",
      "formatted_end": "04:33:24.380",
      "text": "حالا اینجور که معیزه ها میگن باید فانون های جدیدی که درست کردن که نمیعرضن مثلا"
    },
    {
      "id": 51,
      "start": 16404.38,
      "end": 16406.38,
      "formatted_start": "04:33:24.380",
      "formatted_end": "04:33:26.380",
      "text": "دویست تومن بیمه میده، دویست تومن هم نده"
    },
    {
      "id": 52,
      "start": 16406.38,
      "end": 16409.38,
      "formatted_start": "04:33:26.380",
      "formatted_end": "04:33:29.380",
      "text": "معیزه که این همه پول قرص بدونم"
    },
    {
      "id": 53,
      "start": 16409.38,
      "end": 16412.38,
      "formatted_start": "04:33:29.380",
      "formatted_end": "04:33:32.380",
      "text": "خواهد چند مالیون داریو خرد؟"
    },
    {
      "id": 54,
      "start": 16412.38,
      "end": 16414.38,
      "formatted_start": "04:33:32.380",
      "formatted_end": "04:33:34.380",
      "text": "اصلا داریو دیگه ها محشک هاش"
    },
    {
      "id": 55,
      "start": 16414.38,
      "end": 16419.38,
      "formatted_start": "04:33:34.380",
      "formatted_end": "04:33:39.380",
      "text": "اصلا قبلش مثلا هم نمیدونم بود، چهار ست تومن بیشتر معیز نمیدونم"
    },
    {
      "id": 56,
      "start": 16419.38,
      "end": 16424.38,
      "formatted_start": "04:33:39.380",
      "formatted_end": "04:33:44.380",
      "text": "ارز تجهی از اون داروها ورداشن خیلی گرم شده داروها"
    },
    {
      "id": 57,
      "start": 16424.38,
      "end": 16428.38,
      "formatted_start": "04:33:44.380",
      "formatted_end": "04:33:48.380",
      "text": "الان که میخوان بگن ارز تجهی این فرق داروها هستون هست"
    },
    {
      "id": 58,
      "start": 16428.38,
      "end": 16435.38,
      "formatted_start": "04:33:48.380",
      "formatted_end": "04:33:55.380",
      "text": "حالا شما خوبین مرز پیونت هر قرصشون چهار ست هزار تومن یک دونه شده"
    },
    {
      "id": 59,
      "start": 16435.38,
      "end": 16436.38,
      "formatted_start": "04:33:55.380",
      "formatted_end": "04:33:56.380",
      "text": "ما یه هفت میدیم"
    },
    {
      "id": 60,
      "start": 16436.38,
      "end": 16439.38,
      "formatted_start": "04:33:56.380",
      "formatted_end": "04:33:59.380",
      "text": "اما دکتر آفرد تو نمیشه که به کسی کارو نمیتونست"
    },
    {
      "id": 61,
      "start": 16439.38,
      "end": 16442.38,
      "formatted_start": "04:33:59.380",
      "formatted_end": "04:34:02.380",
      "text": "قطعی میشه اونو بگم او خود دنیا همینه"
    },
    {
      "id": 62,
      "start": 16442.38,
      "end": 16444.38,
      "formatted_start": "04:34:02.380",
      "formatted_end": "04:34:04.380",
      "text": "یعنی این دارو در دنیا خیلی گرمه"
    },
    {
      "id": 63,
      "start": 16444.38,
      "end": 16454.38,
      "formatted_start": "04:34:04.380",
      "formatted_end": "04:34:14.380",
      "text": "ما توی ایران خیلی داریم دارو و ارزون میخریم اما بقیه دنیا بقیه چیزای رفایی رو دارن یعنی درامد رو خوب دارن خوب دارو خیلی گرونه"
    },
    {
      "id": 64,
      "start": 16454.38,
      "end": 16462.38,
      "formatted_start": "04:34:14.380",
      "formatted_end": "04:34:22.380",
      "text": "یه سرمخورده که شما همین الان به ادامه کافیت با همین پول رو اینجا میشه چهر میلیون یعنی همونجا یه عدد خیلی برای این"
    },
    {
      "id": 65,
      "start": 16462.38,
      "end": 16464.38,
      "formatted_start": "04:34:22.380",
      "formatted_end": "04:34:24.380",
      "text": "از اینکه از این صفحه ارمانستان رفته بودم"
    },
    {
      "id": 66,
      "start": 16464.38,
      "end": 16468.38,
      "formatted_start": "04:34:24.380",
      "formatted_end": "04:34:28.380",
      "text": "اصلا بابا که همه مطابق دکتر دار و خونه"
    },
    {
      "id": 67,
      "start": 16468.38,
      "end": 16470.38,
      "formatted_start": "04:34:28.380",
      "formatted_end": "04:34:30.380",
      "text": "اصلا کنه خلوت خلوت بوده"
    },
    {
      "id": 68,
      "start": 16470.38,
      "end": 16471.38,
      "formatted_start": "04:34:30.380",
      "formatted_end": "04:34:31.380",
      "text": "چون یه رونه"
    },
    {
      "id": 69,
      "start": 16471.38,
      "end": 16473.38,
      "formatted_start": "04:34:31.380",
      "formatted_end": "04:34:33.380",
      "text": "برای اصلا مریض نبود کنیم مطابق در این وضوع دار و خونه"
    },
    {
      "id": 70,
      "start": 16473.38,
      "end": 16475.38,
      "formatted_start": "04:34:33.380",
      "formatted_end": "04:34:35.380",
      "text": "ارمانستان که باز خیلی عقب مونده از"
    },
    {
      "id": 71,
      "start": 16475.38,
      "end": 16477.38,
      "formatted_start": "04:34:35.380",
      "formatted_end": "04:34:37.380",
      "text": "یعنی یک چیزی هم فرقیختر از ما"
    },
    {
      "id": 72,
      "start": 16477.38,
      "end": 16479.38,
      "formatted_start": "04:34:37.380",
      "formatted_end": "04:34:39.380",
      "text": "نه نصف روز آب و بردن"
    },
    {
      "id": 73,
      "start": 16479.38,
      "end": 16480.38,
      "formatted_start": "04:34:39.380",
      "formatted_end": "04:34:40.380",
      "text": "اونا که خیلی"
    },
    {
      "id": 74,
      "start": 16480.38,
      "end": 16482.38,
      "formatted_start": "04:34:40.380",
      "formatted_end": "04:34:42.380",
      "text": "به نظر علمی این هم خیلی داقونه"
    },
    {
      "id": 75,
      "start": 16482.38,
      "end": 16484.38,
      "formatted_start": "04:34:42.380",
      "formatted_end": "04:34:44.380",
      "text": "اونها که کشوری اقل موندندر کشوری دیگه میکنند"
    },
    {
      "id": 76,
      "start": 16484.38,
      "end": 16487.38,
      "formatted_start": "04:34:44.380",
      "formatted_end": "04:34:47.380",
      "text": "این کنار به غذایشون خیلی خوب بارادید ها"
    },
    {
      "id": 77,
      "start": 16487.38,
      "end": 16488.38,
      "formatted_start": "04:34:47.380",
      "formatted_end": "04:34:48.380",
      "text": "هرانستان"
    },
    {
      "id": 78,
      "start": 16489.38,
      "end": 16490.38,
      "formatted_start": "04:34:49.380",
      "formatted_end": "04:34:50.380",
      "text": "غذایشون؟"
    },
    {
      "id": 79,
      "start": 16490.38,
      "end": 16491.38,
      "formatted_start": "04:34:50.380",
      "formatted_end": "04:34:51.380",
      "text": "بله غذایشون خیلی خیلی خیلی خیلی خوب بارادید"
    },
    {
      "id": 80,
      "start": 16491.38,
      "end": 16494.38,
      "formatted_start": "04:34:51.380",
      "formatted_end": "04:34:54.380",
      "text": "ولی خب بس میوای اینا خیلی گرمه"
    },
    {
      "id": 81,
      "start": 16494.38,
      "end": 16496.38,
      "formatted_start": "04:34:54.380",
      "formatted_end": "04:34:56.380",
      "text": "مثلا شان هندوینو باید بخواهید اونجا"
    },
    {
      "id": 82,
      "start": 16496.38,
      "end": 16498.38,
      "formatted_start": "04:34:56.380",
      "formatted_end": "04:34:58.380",
      "text": "باید هندوینو بخواهشی بخواهید"
    },
    {
      "id": 83,
      "start": 16498.38,
      "end": 16500.38,
      "formatted_start": "04:34:58.380",
      "formatted_end": "04:35:00.380",
      "text": "میوای دیگه رو همون دونه ای باید بخواهید"
    }
  ],
  "status": "completed"
}