    {
      "id": 26,
      "start": 6680.0,
      "end": 6682.0,
      "formatted_start": "01:51:20.000",
      "formatted_end": "01:51:22.000",
      "text": "اینو خوب داریم"
    },
    {
      "id": 27,
      "start": 6682.0,
      "end": 6684.0,
      "formatted_start": "01:51:22.000",
      "formatted_end": "01:51:24.000",
      "text": "اینو خوب داریم"
    },
    {
      "id": 28,
      "start": 6684.0,
      "end": 6686.0,
      "formatted_start": "01:51:24.000",
      "formatted_end": "01:51:26.000",
      "text": "این رو درخ بکنه میدن"
    },
    {
      "id": 29,
      "start": 6686.0,
      "end": 6688.0,
      "formatted_start": "01:51:26.000",
      "formatted_end": "01:51:28.000",
      "text": "این رو چند ساله دارن؟"
    },
    {
      "id": 30,
      "start": 6688.0,
      "end": 6690.0,
      "formatted_start": "01:51:28.000",
      "formatted_end": "01:51:30.000",
      "text": "یه دونه صبح میدونش"
    },
    {
      "id": 31,
      "start": 6690.0,
      "end": 6692.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:32.000",
      "text": "اصلا کراتینتون چون بالا است"
    },
    {
      "id": 32,
      "start": 6692.0,
      "end": 6694.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:34.000",
      "text": "اینو چه عوض؟"
    },
    {
      "id": 33,
      "start": 6694.0,
      "end": 6696.0,
      "formatted_start": "01:51:34.000",
      "formatted_end": "01:51:36.000",
      "text": "یه دونه صبح یه دونه شب میخورد"
    },
    {
      "id": 34,
      "start": 6696.0,
      "end": 6698.0,
      "formatted_start": "01:51:36.000",
      "formatted_end": "01:51:38.000",
      "text": "میدن درخ میکنه"
    },
    {
      "id": 35,
      "start": 6698.0,
      "end": 6702.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:42.000",
      "text": "خوب یه گروه که خواهش 500 برای شب میزن"
    },
    {
      "id": 36,
      "start": 6702.0,
      "end": 6704.0,
      "formatted_start": "01:51:42.000",
      "formatted_end": "01:51:44.000",
      "text": "رو دیگه برن تایی خواه"
    },
    {
      "id": 37,
      "start": 6704.0,
      "end": 6706.0,
      "formatted_start": "01:51:44.000",
      "formatted_end": "01:51:46.000",
      "text": "بعد از اون میگید که"
    },
    {
      "id": 38,
      "start": 6706.0,
      "end": 6708.0,
      "formatted_start": "01:51:46.000",
      "formatted_end": "01:51:48.000",
      "text": "از اون کاری کنم"
    },
    {
      "id": 39,
      "start": 6708.0,
      "end": 6710.0,
      "formatted_start": "01:51:48.000",
      "formatted_end": "01:51:50.000",
      "text": "این قناه رو باید بازهای جدید"
    },
    {
      "id": 40,
      "start": 6710.0,
      "end": 6712.0,
      "formatted_start": "01:51:50.000",
      "formatted_end": "01:51:52.000",
      "text": "چون ممکنه افتخام پیدا کنی"
    },
    {
      "id": 41,
      "start": 6712.0,
      "end": 6714.0,
      "formatted_start": "01:51:52.000",
      "formatted_end": "01:51:54.000",
      "text": "میگیم که همین چیز"
    },
    {
      "id": 42,
      "start": 6714.0,
      "end": 6716.0,
      "formatted_start": "01:51:54.000",
      "formatted_end": "01:51:56.000",
      "text": "الان به این برنامه میدیم"
    },
    {
      "id": 43,
      "start": 6716.0,
      "end": 6718.0,
      "formatted_start": "01:51:56.000",
      "formatted_end": "01:51:58.000",
      "text": "همشنبایی به این یک برنامه میده"
    },
    {
      "id": 44,
      "start": 6720.0,
      "end": 6722.0,
      "formatted_start": "01:52:00.000",
      "formatted_end": "01:52:02.000",
      "text": "اعتماد داره کلن هم متخورمه"
    },
    {
      "id": 45,
      "start": 6722.0,
      "end": 6724.0,
      "formatted_start": "01:52:02.000",
      "formatted_end": "01:52:04.000",
      "text": "وقت تداث زیاد نیست"
    },
    {
      "id": 46,
      "start": 6724.0,
      "end": 6726.0,
      "formatted_start": "01:52:04.000",
      "formatted_end": "01:52:06.000",
      "text": "همشنبایی اصلا گلوکن پاشا قط بشه"
    },
    {
      "id": 47,
      "start": 6726.0,
      "end": 6728.0,
      "formatted_start": "01:52:06.000",
      "formatted_end": "01:52:08.000",
      "text": "فقط با این یک دونه پاس باشید"
    },
    {
      "id": 48,
      "start": 6728.0,
      "end": 6730.0,
      "formatted_start": "01:52:08.000",
      "formatted_end": "01:52:10.000",
      "text": "چون باید یک پاس داریم گلورن تا"
    },
    {
      "id": 49,
      "start": 6730.0,
      "end": 6732.0,
      "formatted_start": "01:52:10.000",
      "formatted_end": "01:52:12.000",
      "text": "خب اینو هر طور شده باید بدیم"
    },
    {
      "id": 50,
      "start": 6732.0,
      "end": 6734.0,
      "formatted_start": "01:52:12.000",
      "formatted_end": "01:52:14.000",
      "text": "چرا؟ چون میخوای پیراتینت برگرده"
    },
    {
      "id": 51,
      "start": 6734.0,
      "end": 6736.0,
      "formatted_start": "01:52:14.000",
      "formatted_end": "01:52:16.000",
      "text": "بعد خودش هم"
    },
    {
      "id": 52,
      "start": 6736.0,
      "end": 6738.0,
      "formatted_start": "01:52:16.000",
      "formatted_end": "01:52:18.000",
      "text": "جز درمانای کبد چرب هم هست"
    },
    {
      "id": 53,
      "start": 6738.0,
      "end": 6740.0,
      "formatted_start": "01:52:18.000",
      "formatted_end": "01:52:20.000",
      "text": "خوشی شده"
    },
    {
      "id": 54,
      "start": 6768.0,
      "end": 6772.3,
      "formatted_start": "01:52:48.000",
      "formatted_end": "01:52:52.300",
      "text": "این دروت انشالله همکلیت و انشالله خوب کنه همکبداتو"
    },
    {
      "id": 55,
      "start": 6778.48,
      "end": 6783.56,
      "formatted_start": "01:52:58.480",
      "formatted_end": "01:53:03.560",
      "text": "یه سری انسولین هم داریم قیمتهای باز بذار همکاراتو یکی یکی انجام بریم"
    },
    {
      "id": 56,
      "start": 6783.56,
      "end": 6788.56,
      "formatted_start": "01:53:03.560",
      "formatted_end": "01:53:08.560",
      "text": "اگه بدونم کبد چربت خوب نمیشه اونا انسولین یکی خیلی اونجوری اخت غنم ده"
    },
    {
      "id": 57,
      "start": 6788.56,
      "end": 6791.9,
      "formatted_start": "01:53:08.560",
      "formatted_end": "01:53:11.900",
      "text": "برای درمان کسایی که غن و کبد مختل دارن"
    },
    {
      "id": 58,
      "start": 6791.9,
      "end": 6794.94,
      "formatted_start": "01:53:11.900",
      "formatted_end": "01:53:14.940",
      "text": "و از اون یه دفعه اون کبد چربو بهخود میده"
    },
    {
      "id": 59,
      "start": 6794.94,
      "end": 6799.44,
      "formatted_start": "01:53:14.940",
      "formatted_end": "01:53:19.440",
      "text": "یک چیزی که برای اون کبد و چربشون مشته از آدم های دیگه مهمه یه حباتی میداریم"
    },
    {
      "id": 60,
      "start": 6799.44,
      "end": 6803.94,
      "formatted_start": "01:53:19.440",
      "formatted_end": "01:53:23.940",
      "text": "برای این اصلا نباید کبد آسیب بیرونی ببینه خب؟"
    },
    {
      "id": 61,
      "start": 6803.94,
      "end": 6806.26,
      "formatted_start": "01:53:23.940",
      "formatted_end": "01:53:26.260",
      "text": "من نگردی نداری چیزی"
    },
    {
      "id": 62,
      "start": 6806.26,
      "end": 6808.98,
      "formatted_start": "01:53:26.260",
      "formatted_end": "01:53:28.980",
      "text": "میخوای خوب بشی استرس نداشتی بشی"
    },
    {
      "id": 63,
      "start": 6808.98,
      "end": 6814.68,
      "formatted_start": "01:53:28.980",
      "formatted_end": "01:53:34.680",
      "text": "شیمی، شکولات، نشابه، دلستر، همدونه، خربازه، انگور، موز، نهار نخوری"
    },
    {
      "id": 64,
      "start": 6814.68,
      "end": 6817.62,
      "formatted_start": "01:53:34.680",
      "formatted_end": "01:53:37.620",
      "text": "مکارنی نخوری، چایی با دوست دونه کشمش"
    },
    {
      "id": 65,
      "start": 6817.62,
      "end": 6822.62,
      "formatted_start": "01:53:37.620",
      "formatted_end": "01:53:42.620",
      "text": "یا مثلا یک نصف خورما یا یک اناب تود خشک اینها باشه خب"
    },
    {
      "id": 66,
      "start": 6822.62,
      "end": 6827.62,
      "formatted_start": "01:53:42.620",
      "formatted_end": "01:53:47.620",
      "text": "اوائل هر دوره ممکنه یکم ناواز"
    },
    {
      "id": 67,
      "start": 6827.62,
      "end": 6831.62,
      "formatted_start": "01:53:47.620",
      "formatted_end": "01:53:51.620",
      "text": "مثلا روی بدن ناسازگار باشه یکم تنها مرکزه چهار روز"
    },
    {
      "id": 68,
      "start": 6831.62,
      "end": 6834.62,
      "formatted_start": "01:53:51.620",
      "formatted_end": "01:53:54.620",
      "text": "اگه ببینیم دیگه سازگار نبود قط می کنیم"
    },
    {
      "id": 69,
      "start": 6834.62,
      "end": 6840.62,
      "formatted_start": "01:53:54.620",
      "formatted_end": "01:54:00.620",
      "text": "روز این اول چون دورت شروع میشه ممکنه که خوبصند خورس بعد نهارت قریب باشه"
    },
    {
      "id": 70,
      "start": 6840.62,
      "end": 6844.62,
      "formatted_start": "01:54:00.620",
      "formatted_end": "01:54:04.620",
      "text": "تو چیبت همشه یکم خورما شیرمی شکولت یکم داشته باشه"
    },
    {
      "id": 71,
      "start": 6844.62,
      "end": 6850.62,
      "formatted_start": "01:54:04.620",
      "formatted_end": "01:54:10.620",
      "text": "چون اون قرص رو برای هر طور شده شده نصف ادامه بدیم تعمل کنیم بخاطر کلیت انشالله خوب بشه"
    },
    {
      "id": 72,
      "start": 6850.62,
      "end": 6852.62,
      "formatted_start": "01:54:10.620",
      "formatted_end": "01:54:12.620",
      "text": "تصمیم شما دردن کنیم"
    },
    {
      "id": 73,
      "start": 6852.62,
      "end": 6855.62,
      "formatted_start": "01:54:12.620",
      "formatted_end": "01:54:15.620",
      "text": "بعد قرص های چربیتو اینا رو داشتی تو خونه ادام؟"
    },
    {
      "id": 74,
      "start": 6855.62,
      "end": 6858.62,
      "formatted_start": "01:54:15.620",
      "formatted_end": "01:54:18.620",
      "text": "قرص چربی دارم، آتراستاتین دارم، اون رو ادامه بدیم"
    },
    {
      "id": 75,
      "start": 6858.62,
      "end": 6860.62,
      "formatted_start": "01:54:18.620",
      "formatted_end": "01:54:20.620",
      "text": "آره آره، اون رو به همون رو داریم"
    },
    {
      "id": 76,
      "start": 6860.62,
      "end": 6861.62,
      "formatted_start": "01:54:20.620",
      "formatted_end": "01:54:21.620",
      "text": "اون کپسون زرده یک کپه دارم؟"
    },
    {
      "id": 77,
      "start": 6861.62,
      "end": 6864.62,
      "formatted_start": "01:54:21.620",
      "formatted_end": "01:54:24.620",
      "text": "اون رو ادامه بدیم، آره اون رو داریم خوبی، برای دامه بدیم"
    },
    {
      "id": 78,
      "start": 6864.62,
      "end": 6867.62,
      "formatted_start": "01:54:24.620",
      "formatted_end": "01:54:27.620",
      "text": "چی موسم دیگه موسم؟ دادور که میرن؟"
    },
    {
      "id": 79,
      "start": 6867.62,
      "end": 6870.62,
      "formatted_start": "01:54:27.620",
      "formatted_end": "01:54:30.620",
      "text": "الان من یه ماه بهتون دادور دادم خب"
    },
    {
      "id": 80,
      "start": 6870.62,
      "end": 6874.62,
      "formatted_start": "01:54:30.620",
      "formatted_end": "01:54:34.620",
      "text": "به زمان همین الان آزمایشتن برم بگیسم با همین کودت خب"
    },
    {
      "id": 81,
      "start": 6874.62,
      "end": 6880.62,
      "formatted_start": "01:54:34.620",
      "formatted_end": "01:54:40.620",
      "text": "25 روزه دیگه یه آزمایش بند ناشبه و دو ساعته و کراتین میمیسن بیره خب"
    },
    {
      "id": 82,
      "start": 6880.62,
      "end": 6887.62,
      "formatted_start": "01:54:40.620",
      "formatted_end": "01:54:47.620",
      "text": "با همین آزمایش برم بگیم با جوابش بیاین باشه؟"
    },
    {
      "id": 83,
      "start": 6887.62,
      "end": 6888.62,
      "formatted_start": "01:54:47.620",
      "formatted_end": "01:54:48.620",
      "text": "با همین کود برم؟"
    },
    {
      "id": 84,
      "start": 6888.62,
      "end": 6889.62,
      "formatted_start": "01:54:48.620",
      "formatted_end": "01:54:49.620",
      "text": "آره"
    },
    {
      "id": 85,
      "start": 6889.62,
      "end": 6892.62,
      "formatted_start": "01:54:49.620",
      "formatted_end": "01:54:52.620",
      "text": "کودشو تو بشین نگهر تا 25 روزه دیگه با هم بگو"
    },
    {
      "id": 86,
      "start": 6892.62,
      "end": 6893.62,
      "formatted_start": "01:54:52.620",
      "formatted_end": "01:54:53.620",
      "text": "باشه"
    },
    {
      "id": 87,
      "start": 6893.62,
      "end": 6896.12,
      "formatted_start": "01:54:53.620",
      "formatted_end": "01:54:56.120",
      "text": "این طرق ها پایین بدنم این ساختی"
    },
    {
      "id": 88,
      "start": 6896.12,
      "end": 6898.88,
      "formatted_start": "01:54:56.120",
      "formatted_end": "01:54:58.880",
      "text": "چند مولد هم بیشتر نرمیشم"
    },
    {
      "id": 89,
      "start": 6898.88,
      "end": 6899.98,
      "formatted_start": "01:54:58.880",
      "formatted_end": "01:54:59.980",
      "text": "خیلی گرون نیست"
    }
  ],
  "status": "completed"
}