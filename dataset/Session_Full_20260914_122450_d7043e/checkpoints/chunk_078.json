    {
      "id": 5,
      "start": 23466.0,
      "end": 23468.0,
      "formatted_start": "06:31:06.000",
      "formatted_end": "06:31:08.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 6,
      "start": 23468.0,
      "end": 23470.0,
      "formatted_start": "06:31:08.000",
      "formatted_end": "06:31:10.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 7,
      "start": 23470.0,
      "end": 23472.0,
      "formatted_start": "06:31:10.000",
      "formatted_end": "06:31:12.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 8,
      "start": 23472.0,
      "end": 23474.0,
      "formatted_start": "06:31:12.000",
      "formatted_end": "06:31:14.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 9,
      "start": 23474.0,
      "end": 23476.0,
      "formatted_start": "06:31:14.000",
      "formatted_end": "06:31:16.000",
      "text": "اگر باید بردارید، باید بردارید."
    },
    {
      "id": 10,
      "start": 23476.0,
      "end": 23479.0,
      "formatted_start": "06:31:16.000",
      "formatted_end": "06:31:19.000",
      "text": "میگن ما تموم شدیم اگر میخواییم آره ما تموم شدیم"
    },
    {
      "id": 11,
      "start": 23479.0,
      "end": 23482.0,
      "formatted_start": "06:31:19.000",
      "formatted_end": "06:31:22.000",
      "text": "میگن ما تموم شدیم بلند"
    },
    {
      "id": 12,
      "start": 23482.0,
      "end": 23485.0,
      "formatted_start": "06:31:22.000",
      "formatted_end": "06:31:25.000",
      "text": "آره صدا باید میراد"
    },
    {
      "id": 13,
      "start": 23485.0,
      "end": 23500.0,
      "formatted_start": "06:31:25.000",
      "formatted_end": "06:31:40.000",
      "text": "میگن ما مریضمون تموم شد"
    },
    {
      "id": 14,
      "start": 23500.0,
      "end": 23505.0,
      "formatted_start": "06:31:40.000",
      "formatted_end": "06:31:45.000",
      "text": "باشه تمام خدافره"
    },
    {
      "id": 15,
      "start": 23505.0,
      "end": 23529.0,
      "formatted_start": "06:31:45.000",
      "formatted_end": "06:32:09.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 23529.0,
      "end": 23531.6,
      "formatted_start": "06:32:09.000",
      "formatted_end": "06:32:11.600",
      "text": "بیا ببینم ببخشید میشه بیایی ببینم"
    },
    {
      "id": 17,
      "start": 23531.6,
      "end": 23533.0,
      "formatted_start": "06:32:11.600",
      "formatted_end": "06:32:13.000",
      "text": "چله خانده تو ببینم"
    },
    {
      "id": 18,
      "start": 23533.0,
      "end": 23534.0,
      "formatted_start": "06:32:13.000",
      "formatted_end": "06:32:14.000",
      "text": "چله"
    },
    {
      "id": 19,
      "start": 23535.0,
      "end": 23536.0,
      "formatted_start": "06:32:15.000",
      "formatted_end": "06:32:16.000",
      "text": "بیانم"
    },
    {
      "id": 20,
      "start": 23537.0,
      "end": 23539.0,
      "formatted_start": "06:32:17.000",
      "formatted_end": "06:32:19.000",
      "text": "نه خوشم ببینم بزرگه"
    },
    {
      "id": 21,
