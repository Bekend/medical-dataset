  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9005.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:05.000",
      "text": "از اینجور رخدم رو توبت و گفت که تیروید بدون علامتی همه چیزی به من گفت."
    },
    {
      "id": 1,
      "start": 9005.0,
      "end": 9009.0,
      "formatted_start": "02:30:05.000",
      "formatted_end": "02:30:09.000",
      "text": "تو بعد هر سر محلمت بدی چون دارو، آزمایش بدی چون ممکنه؟"
    },
    {
      "id": 2,
      "start": 9009.0,
      "end": 9012.0,
      "formatted_start": "02:30:09.000",
      "formatted_end": "02:30:12.000",
      "text": "آزمایش هم میدم، نشونم بیدم که این مشکلی هست."
    },
    {
      "id": 3,
      "start": 9012.0,
      "end": 9015.0,
      "formatted_start": "02:30:12.000",
      "formatted_end": "02:30:15.000",
      "text": "چون ممکنه؟ آخر مرکز چه کار دادی دختران؟"
    },
    {
      "id": 4,
      "start": 9015.0,
      "end": 9019.0,
      "formatted_start": "02:30:15.000",
      "formatted_end": "02:30:19.000",
      "text": "آخر مرکز دوسته ماه پیش بود فکر کنم."
    },
    {
      "id": 5,
      "start": 9019.0,
      "end": 9022.0,
      "formatted_start": "02:30:19.000",
      "formatted_end": "02:30:22.000",
      "text": "بعد دیگه ها روشون ریزش هم و آینا داشتن همیشه کن کن داشتن."
    },
    {
      "id": 6,
      "start": 9022.0,
      "end": 9024.0,
      "formatted_start": "02:30:22.000",
      "formatted_end": "02:30:24.000",
      "text": "آهر رو می آوردید که؟"
    },
    {
      "id": 7,
      "start": 9024.0,
      "end": 9026.0,
      "formatted_start": "02:30:24.000",
      "formatted_end": "02:30:26.000",
      "text": "آهر رو می آوردید"
    },
    {
      "id": 8,
      "start": 9026.0,
      "end": 9028.0,
      "formatted_start": "02:30:26.000",
      "formatted_end": "02:30:28.000",
      "text": "آهر رو می آوردید"
    },
    {
      "id": 9,
      "start": 9028.0,
      "end": 9030.0,
      "formatted_start": "02:30:28.000",
      "formatted_end": "02:30:30.000",
      "text": "دیگه همسوام خواب بودم"
    },
    {
      "id": 10,
      "start": 9030.0,
      "end": 9032.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:32.000",
      "text": "انا هم توی مواقع سایتی که حرفتون سریع آمدم"
    },
    {
      "id": 11,
      "start": 9032.0,
      "end": 9034.0,
      "formatted_start": "02:30:32.000",
      "formatted_end": "02:30:34.000",
      "text": "و"
    },
    {
      "id": 12,
      "start": 9034.0,
      "end": 9036.0,
      "formatted_start": "02:30:34.000",
      "formatted_end": "02:30:36.000",
      "text": "میانم"
    },
    {
      "id": 13,
      "start": 9036.0,
      "end": 9038.0,
      "formatted_start": "02:30:36.000",
      "formatted_end": "02:30:38.000",
      "text": "بودم"
    },
    {
      "id": 14,
      "start": 9042.0,
      "end": 9044.0,
      "formatted_start": "02:30:42.000",
      "formatted_end": "02:30:44.000",
      "text": "نه از کمکونی هم همچنین"
    },
    {
      "id": 15,
      "start": 9044.0,
      "end": 9046.0,
      "formatted_start": "02:30:44.000",
      "formatted_end": "02:30:46.000",
      "text": "مقداری داشتم"
    },
    {
      "id": 16,
      "start": 9046.0,
      "end": 9048.0,
      "formatted_start": "02:30:46.000",
      "formatted_end": "02:30:48.000",
      "text": "آهر رو مصرف می کنم"
    },
    {
      "id": 17,
      "start": 9048.0,
      "end": 9050.0,
      "formatted_start": "02:30:48.000",
      "formatted_end": "02:30:50.000",
      "text": "و کاترونی داشتون دیگه هم"
    },
    {
      "id": 18,
      "start": 9050.0,
      "end": 9062.0,
      "formatted_start": "02:30:50.000",
      "formatted_end": "02:31:02.000",
      "text": "از نظر بقیه نسلمن کامل با اونی که نسلمن متخصص میخواد بردار خواهد"
    },
    {
      "id": 19,
      "start": 9062.0,
      "end": 9091.98,
      "formatted_start": "02:31:02.000",
      "formatted_end": "02:31:31.980",
      "text": "از اینجا باید بردارید که اینجا باید بردارید."
    },
    {
      "id": 20,
      "start": 9092.0,
      "end": 9094.0,
      "formatted_start": "02:31:32.000",
      "formatted_end": "02:31:34.000",
      "text": "اینجا؟"
    },
    {
      "id": 21,
      "start": 9094.0,
      "end": 9096.0,
