  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6311.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:11.000",
      "text": "نخور، ماه یک بار خور، روغن تو غذات اصلا نخور، تقنوه هم نخور خور، این هم برای کبد اجورده."
    },
    {
      "id": 1,
      "start": 6311.0,
      "end": 6316.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:16.000",
      "text": "اصلا مخور نداری، کبد چرب شده، یعنی هر زمان ممکنه هپاتیت فقر آداشه."
    },
    {
      "id": 2,
      "start": 6316.0,
      "end": 6322.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:22.000",
      "text": "خب، کبد چرب دورداری که اصلا نباید داشته باشی، احتمال داره ناشه از هپاتیت ای باشه."
    },
    {
      "id": 3,
      "start": 6322.0,
      "end": 6352.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:52.000",
      "text": "بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، ب"
    },
    {
      "id": 4,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "خصوصی این رو به شرط مالی شما داریم"
    },
    {
      "id": 5,
      "start": 6354.0,
      "end": 6357.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:57.000",
      "text": "فعلا آنزیما چون بالا نیست"
    },
    {
      "id": 6,
      "start": 6357.0,
      "end": 6359.0,
      "formatted_start": "01:45:57.000",
      "formatted_end": "01:45:59.000",
      "text": "برشانستیست بینکار رو بکنیم"
    },
    {
      "id": 7,
      "start": 6359.0,
      "end": 6362.0,
      "formatted_start": "01:45:59.000",
      "formatted_end": "01:46:02.000",
      "text": "دور اجان اعتمادش بری که من برای شما وستادیم"
    },
    {
      "id": 8,
      "start": 6362.0,
      "end": 6365.0,
      "formatted_start": "01:46:02.000",
      "formatted_end": "01:46:05.000",
      "text": "برای آزمایش سرطانه کبد رو بدی خب"
    },
    {
      "id": 9,
      "start": 6365.0,
      "end": 6366.0,
      "formatted_start": "01:46:05.000",
      "formatted_end": "01:46:06.000",
      "text": "اونو میرم آنو میدم"
    },
    {
      "id": 10,
      "start": 6366.0,
      "end": 6368.0,
      "formatted_start": "01:46:06.000",
      "formatted_end": "01:46:08.000",
      "text": "آلپا فیتو پورتین خب"
    },
    {
      "id": 11,
      "start": 6368.0,
      "end": 6371.0,
      "formatted_start": "01:46:08.000",
      "formatted_end": "01:46:11.000",
      "text": "اینو وستادی یه بار حتما انجام بدی"
    },
    {
      "id": 12,
      "start": 6371.0,
      "end": 6372.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:12.000",
      "text": "خب؟"
    },
    {
      "id": 13,
      "start": 6372.0,
      "end": 6373.0,
      "formatted_start": "01:46:12.000",
      "formatted_end": "01:46:13.000",
      "text": "حتما"
    },
    {
      "id": 14,
      "start": 6373.0,
      "end": 6375.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:15.000",
      "text": "اون شرطتو داشته هم بگیرم برام بینیم"
    },
    {
      "id": 15,
      "start": 6375.0,
      "end": 6376.0,
      "formatted_start": "01:46:15.000",
      "formatted_end": "01:46:16.000",
      "text": "برام ببینیم"
    },
    {
      "id": 16,
      "start": 6376.0,
      "end": 6378.72,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:18.720",
      "text": "و سنوی کبدت هم هر 6 ماه هست"
    },
    {
      "id": 17,
      "start": 6378.72,
      "end": 6379.62,
      "formatted_start": "01:46:18.720",
      "formatted_end": "01:46:19.620",
      "text": "حتما"
    },
    {
      "id": 18,
      "start": 6379.62,
      "end": 6383.06,
      "formatted_start": "01:46:19.620",
      "formatted_end": "01:46:23.060",
      "text": "دیگه این هایی برات میرسند این هم همه عمرت باید بدونیم"
    },
    {
      "id": 19,
      "start": 6383.06,
      "end": 6384.26,
      "formatted_start": "01:46:23.060",
      "formatted_end": "01:46:24.260",
      "text": "سالانه"
    },
    {
      "id": 20,
      "start": 6384.26,
      "end": 6386.42,
      "formatted_start": "01:46:24.260",
      "formatted_end": "01:46:26.420",
      "text": "سنوی کبدت به زفه همزینی کبدت"
    },
    {
      "id": 21,
      "start": 6386.42,
      "end": 6388.76,
      "formatted_start": "01:46:26.420",
      "formatted_end": "01:46:28.760",
      "text": "این ها رو باید هر 6 ماه ها انجام بدید"
    },
    {
      "id": 22,
      "start": 6388.76,
      "end": 6391.1,
      "formatted_start": "01:46:28.760",
      "formatted_end": "01:46:31.100",
      "text": "این سالانه ایه ایمان"
    },
    {
      "id": 23,
      "start": 6391.1,
      "end": 6396.68,
      "formatted_start": "01:46:31.100",
      "formatted_end": "01:46:36.680",
      "text": "اینجزه کارات هایی که ما هرپاتیتت بذاشیم رابطه هم با شوهرت حتما بکن دون باشه"
    },
    {
      "id": 24,
      "start": 6396.68,
      "end": 6401.68,
      "formatted_start": "01:46:36.680",
      "formatted_end": "01:46:41.680",
      "text": "شوهر دام هر پند سال آنتیبودیشو باید چک کنه که اگه پایین بیاد دوباره برای واکسن بزنه"
    },
    {
      "id": 25,
      "start": 6401.68,
      "end": 6402.68,
      "formatted_start": "01:46:41.680",
      "formatted_end": "01:46:42.680",
      "text": "آن شوهر دام چک کنه؟"
    },
    {
      "id": 26,
      "start": 6402.68,
      "end": 6403.68,
      "formatted_start": "01:46:42.680",
      "formatted_end": "01:46:43.680",
      "text": "آزمورش خونه"
    },
    {
      "id": 27,
      "start": 6403.68,
      "end": 6405.68,
      "formatted_start": "01:46:43.680",
      "formatted_end": "01:46:45.680",
      "text": "آنتیبودی ها باید؟"
    },
    {
      "id": 28,
      "start": 6405.68,
      "end": 6406.68,
      "formatted_start": "01:46:45.680",
      "formatted_end": "01:46:46.680",
      "text": "آره شوهر دام بچه ها"
    },
    {
      "id": 29,
      "start": 6406.68,
      "end": 6410.68,
      "formatted_start": "01:46:46.680",
      "formatted_end": "01:46:50.680",
      "text": "بچه ها که چون دنیا آمده هستن تو بیمارستان آن بولشو بزنه"
    },
    {
      "id": 30,
      "start": 6410.68,
      "end": 6412.68,
      "formatted_start": "01:46:50.680",
      "formatted_end": "01:46:52.680",
      "text": "از این بچه ها اونو بلش کن"
    },
    {
      "id": 31,
      "start": 6412.68,
      "end": 6413.68,
      "formatted_start": "01:46:52.680",
      "formatted_end": "01:46:53.680",
      "text": "میاد سنتش پایین"
    },
    {
      "id": 32,
      "start": 6413.68,
      "end": 6415.68,
      "formatted_start": "01:46:53.680",
      "formatted_end": "01:46:55.680",
      "text": "بچه ها شما زیاد تماس نداری دیگه"
    },
    {
      "id": 33,
      "start": 6415.68,
      "end": 6419.68,
      "formatted_start": "01:46:55.680",
      "formatted_end": "01:46:59.680",
      "text": "بزرگ هایی که خیلی اعتمادش کردن و شما از هر پم دیگه نمی کنید"
    },
    {
      "id": 34,
      "start": 6419.68,
      "end": 6423.68,
      "formatted_start": "01:46:59.680",
      "formatted_end": "01:47:03.680",
      "text": "مطالب چون شوهرت هم بستر میشه ممکنه اون تماس داشته باشه"
    },
    {
      "id": 35,
      "start": 6423.68,
      "end": 6427.68,
      "formatted_start": "01:47:03.680",
      "formatted_end": "01:47:07.680",
      "text": "اونو باید حتما آنتی بازی رو شد چک کنه هر من سال"
    },
    {
      "id": 36,
      "start": 6427.68,
      "end": 6431.68,
      "formatted_start": "01:47:07.680",
      "formatted_end": "01:47:11.680",
      "text": "اونو میلی بسیار که من بگم بیا آزمایش بده که اینو هم حتما چک کنه"
    },
    {
      "id": 37,
      "start": 6431.68,
      "end": 6433.68,
      "formatted_start": "01:47:11.680",
      "formatted_end": "01:47:13.680",
      "text": "آنتی بازی بوده؟"
    },
    {
      "id": 38,
      "start": 6433.68,
      "end": 6435.68,
      "formatted_start": "01:47:13.680",
      "formatted_end": "01:47:15.680",
      "text": "که مهمی رو آزمایش بوده بیا بگم بیا بشه"
    },
    {
      "id": 39,
      "start": 6435.68,
      "end": 6437.68,
      "formatted_start": "01:47:15.680",
      "formatted_end": "01:47:17.680",
      "text": "بیش بیش آنتی باید برون"
    },
    {
      "id": 40,
      "start": 6437.68,
      "end": 6439.68,
      "formatted_start": "01:47:17.680",
      "formatted_end": "01:47:19.680",
      "text": "این مال همزاری"
    },
    {
      "id": 41,
      "start": 6439.68,
      "end": 6443.68,
      "formatted_start": "01:47:19.680",
      "formatted_end": "01:47:23.680",
      "text": "این شفایی برای کاغذ موضوع همه هست"
    },
    {
      "id": 42,
      "start": 6443.68,
      "end": 6447.68,
      "formatted_start": "01:47:23.680",
      "formatted_end": "01:47:27.680",
      "text": "اینجا یک عربت کلونگ نباشه"
    },
    {
      "id": 43,
      "start": 6447.68,
      "end": 6451.68,
      "formatted_start": "01:47:27.680",
      "formatted_end": "01:47:31.680",
      "text": "که از اینجا موضوع هست"
    },
    {
      "id": 44,
      "start": 6451.68,
      "end": 6455.68,
      "formatted_start": "01:47:31.680",
      "formatted_end": "01:47:35.680",
      "text": "اینجا همینجا میگیرن"
    },
    {
      "id": 45,
      "start": 6455.68,
      "end": 6459.68,
      "formatted_start": "01:47:35.680",
      "formatted_end": "01:47:39.680",
      "text": "اینجا مریضون هست"
    },
    {
      "id": 46,
      "start": 6459.68,
      "end": 6463.68,
      "formatted_start": "01:47:39.680",
      "formatted_end": "01:47:43.680",
      "text": "از پردیده با آزم شدنید که"
    },
    {
      "id": 47,
      "start": 6463.68,
      "end": 6467.68,
      "formatted_start": "01:47:43.680",
      "formatted_end": "01:47:47.680",
      "text": "از اینجا HPD آنجا میبینیم فرار یا خاموشه"
    },
    {
      "id": 48,
      "start": 6467.68,
      "end": 6473.68,
      "formatted_start": "01:47:47.680",
      "formatted_end": "01:47:53.680",
      "text": "اگر به نوعی که فعال یا خاموشی همش بیانتیشید، باقی شرطشو داشتید که وقتی تون حضینه کنید"
    },
    {
      "id": 49,
      "start": 6473.68,
      "end": 6475.68,
      "formatted_start": "01:47:53.680",
      "formatted_end": "01:47:55.680",
      "text": "الان چقدر در حال مخانه داری؟"
    },
    {
      "id": 50,
      "start": 6475.68,
      "end": 6479.68,
      "formatted_start": "01:47:55.680",
      "formatted_end": "01:47:59.680",
      "text": "الان نیستم، بلکه یک بزکی همش نباید حتما انجام بدیم"
    },
    {
      "id": 51,
      "start": 6479.68,
      "end": 6484.68,
      "formatted_start": "01:47:59.680",
      "formatted_end": "01:48:04.680",
      "text": "متاب به ناسای بزکی هم داره، متاب به دورت قراری هم داقود 6-7 ملی مرد"
    },
    {
      "id": 52,
      "start": 6484.68,
      "end": 6488.68,
      "formatted_start": "01:48:04.680",
      "formatted_end": "01:48:08.680",
      "text": "اونو بارا یه بار باید انجام بدید، همین قیمت حدودش"
    },
    {
      "id": 53,
      "start": 6488.68,
      "end": 6491.2,
      "formatted_start": "01:48:08.680",
      "formatted_end": "01:48:11.200",
      "text": "یعنی بسکی هم همیشه ششتوانی ندازه"
    },
    {
      "id": 54,
      "start": 6491.2,
      "end": 6493.82,
      "formatted_start": "01:48:11.200",
      "formatted_end": "01:48:13.820",
      "text": "یه بار تو امروز این رو یعنی یه بار باید انجام بدی"
    },
    {
      "id": 55,
      "start": 6493.82,
      "end": 6495.82,
      "formatted_start": "01:48:13.820",
      "formatted_end": "01:48:15.820",
      "text": "اگه خدای نکرد منشکل داشت سال داره"
    },
    {
      "id": 56,
      "start": 6495.82,
      "end": 6498.56,
      "formatted_start": "01:48:15.820",
      "formatted_end": "01:48:18.560",
      "text": "اگه نشکل نکردی باز همه پنج سال چکنی کنی"
    },
    {
      "id": 57,
      "start": 6498.56,
      "end": 6501.68,
      "formatted_start": "01:48:18.560",
      "formatted_end": "01:48:21.680",
      "text": "چون این به معنی یه اسکن سنوعی"
    },
    {
      "id": 58,
      "start": 6501.68,
      "end": 6504.92,
      "formatted_start": "01:48:21.680",
      "formatted_end": "01:48:24.920",
      "text": "سنوعی همراه اسکن آره که به ما میگه که"
    },
    {
      "id": 59,
      "start": 6504.92,
      "end": 6508.86,
      "formatted_start": "01:48:24.920",
      "formatted_end": "01:48:28.860",
      "text": "این وافت کفه چند درصدش آزد دیده یا ندیده"
    },
    {
      "id": 60,
      "start": 6508.86,
      "end": 6511.46,
      "formatted_start": "01:48:28.860",
      "formatted_end": "01:48:31.460",
      "text": "خب اینو بسکی تایبی خواهیم تو انجام بردم"
    },
    {
      "id": 61,
      "start": 6511.46,
      "end": 6513.46,
      "formatted_start": "01:48:31.460",
      "formatted_end": "01:48:33.460",
      "text": "این کار رو باید همیشه این کار رو انجام میده"
    },
    {
      "id": 62,
      "start": 6513.46,
      "end": 6515.46,
      "formatted_start": "01:48:33.460",
      "formatted_end": "01:48:35.460",
      "text": "این رو برای توی یادتون هستین"
    },
    {
      "id": 63,
      "start": 6515.46,
      "end": 6517.46,
      "formatted_start": "01:48:35.460",
      "formatted_end": "01:48:37.460",
      "text": "این رو بیندیس برام"
    },
    {
      "id": 64,
      "start": 6517.46,
      "end": 6519.46,
      "formatted_start": "01:48:37.460",
      "formatted_end": "01:48:39.460",
      "text": "همین بیمارستان برسی کنید"
    },
    {
      "id": 65,
      "start": 6519.46,
      "end": 6521.46,
      "formatted_start": "01:48:39.460",
      "formatted_end": "01:48:41.460",
      "text": "برای آدرس و تلفن هم بده"
    },
    {
      "id": 66,
      "start": 6521.46,
      "end": 6523.46,
      "formatted_start": "01:48:41.460",
      "formatted_end": "01:48:43.460",
      "text": "صدا باشون این انجام بده"
    },
    {
      "id": 67,
      "start": 6523.46,
      "end": 6525.46,
      "formatted_start": "01:48:43.460",
      "formatted_end": "01:48:45.460",
      "text": "این برای توی یادتون هستین"
    },
    {
      "id": 68,
      "start": 6525.46,
      "end": 6527.46,
      "formatted_start": "01:48:45.460",
      "formatted_end": "01:48:47.460",
      "text": "این رو بیندیس برام"
    },
    {
      "id": 69,
      "start": 6527.46,
      "end": 6529.46,
      "formatted_start": "01:48:47.460",
      "formatted_end": "01:48:49.460",
      "text": "همین بیمارستان برسی کنید"
    },
    {
      "id": 70,
      "start": 6529.46,
      "end": 6531.46,
      "formatted_start": "01:48:49.460",
      "formatted_end": "01:48:51.460",
      "text": "برای توی یادتون هستین"
    },
    {
      "id": 71,
      "start": 6531.46,
      "end": 6533.46,
      "formatted_start": "01:48:51.460",
      "formatted_end": "01:48:53.460",
      "text": "این رو بیندیس برام"
    },
    {
      "id": 72,
      "start": 6533.46,
      "end": 6535.46,
      "formatted_start": "01:48:53.460",
      "formatted_end": "01:48:55.460",
      "text": "همین بیمارستان برام"
    },
    {
      "id": 73,
      "start": 6535.46,
      "end": 6537.46,
      "formatted_start": "01:48:55.460",
      "formatted_end": "01:48:57.460",
      "text": "همین بیمارستان برام"
    },
    {
      "id": 74,
      "start": 6537.46,
      "end": 6541.46,
      "formatted_start": "01:48:57.460",
      "formatted_end": "01:49:01.460",
      "text": "این فراد نوبت رو خودت...بعد که کنیم هم حضوره بدی نوبت بگیره خب؟"
    },
    {
      "id": 75,
      "start": 6542.46,
      "end": 6545.46,
      "formatted_start": "01:49:02.460",
      "formatted_end": "01:49:05.460",
      "text": "اونه مثلا گنبت ها نیمانستان برسی میدن کنشویم"
    },
    {
      "id": 76,
      "start": 6545.46,
      "end": 6547.46,
      "formatted_start": "01:49:05.460",
      "formatted_end": "01:49:07.460",
      "text": "مثلا گنبت ها میخوشم"
    },
    {
      "id": 77,
      "start": 6553.46,
      "end": 6555.46,
      "formatted_start": "01:49:13.460",
      "formatted_end": "01:49:15.460",
      "text": "بعد اینجوری ناشته باید برم؟"
    },
    {
      "id": 78,
      "start": 6555.46,
      "end": 6557.46,
      "formatted_start": "01:49:15.460",
      "formatted_end": "01:49:17.460",
      "text": "آره 6 ساعت بعد ناشته باشی"
    },
    {
      "id": 79,
      "start": 6557.46,
      "end": 6559.46,
      "formatted_start": "01:49:17.460",
      "formatted_end": "01:49:19.460",
      "text": "صبح باید بری"
    },
    {
      "id": 80,
      "start": 6560.46,
      "end": 6562.46,
      "formatted_start": "01:49:20.460",
      "formatted_end": "01:49:22.460",
      "text": "اسکن که همه دنجا میدن"
    },
    {
      "id": 81,
      "start": 6567.46,
      "end": 6581.46,
      "formatted_start": "01:49:27.460",
      "formatted_end": "01:49:41.460",
      "text": "اینکه از کارهایی که برای یک چند یکی برد، کمی چند یکی برد، سه ماه دو تنها یکی سه ماه دو تنها برد"
    },
    {
      "id": 82,
      "start": 6581.46,
      "end": 6591.46,
      "formatted_start": "01:49:41.460",
      "formatted_end": "01:49:51.460",
      "text": "و اینکه یکی از کارهایی که، آیا یه چونی نبیادم به تو هر بار بیاییم، یا یا یه ترقی برد"
    },
    {
      "id": 83,
      "start": 6591.46,
      "end": 6599.46,
      "formatted_start": "01:49:51.460",
      "formatted_end": "01:49:59.460",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}