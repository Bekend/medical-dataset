  "stt_segments": [
    {
      "id": 0,
      "start": 18900.0,
      "end": 18903.5,
      "formatted_start": "05:15:00.000",
      "formatted_end": "05:15:03.500",
      "text": "اعتماد درگیر رستخان دارم، اون دور باید جا امروی بیرون."
    },
    {
      "id": 1,
      "start": 18903.5,
      "end": 18906.0,
      "formatted_start": "05:15:03.500",
      "formatted_end": "05:15:06.000",
      "text": "اعتماد کاندید قطعه."
    },
    {
      "id": 2,
      "start": 18906.0,
      "end": 18912.0,
      "formatted_start": "05:15:06.000",
      "formatted_end": "05:15:12.000",
      "text": "باید خانواده واقعاً داغون میشن، یعنی واقعاً خانواده برشکست میشن با حد نایی زخم."
    },
    {
      "id": 3,
      "start": 18912.0,
      "end": 18921.0,
      "formatted_start": "05:15:12.000",
      "formatted_end": "05:15:21.000",
      "text": "دیگه سه سال خانواده دکتر بیرون میشسته بودم، یه خانواده قرباطی بود، یعنی خیلی ببخشیده، خیلی ببخشیده، پاس دنهم باز شد."
    },
    {
      "id": 4,
      "start": 18921.0,
      "end": 18925.42,
      "formatted_start": "05:15:21.000",
      "formatted_end": "05:15:25.420",
      "text": "میگن نه رفتن یعنی نه به فکر مردم یه حال"
    },
    {
      "id": 5,
      "start": 18925.42,
      "end": 18928.06,
      "formatted_start": "05:15:25.420",
      "formatted_end": "05:15:28.060",
      "text": "یه فکر با حال مردم میکنن"
    },
    {
      "id": 6,
      "start": 18928.06,
      "end": 18929.72,
      "formatted_start": "05:15:28.060",
      "formatted_end": "05:15:29.720",
      "text": "به خدا دیگه خسته شده"
    },
    {
      "id": 7,
      "start": 18929.72,
      "end": 18931.22,
      "formatted_start": "05:15:29.720",
      "formatted_end": "05:15:31.220",
      "text": "باورین کنن"
    },
    {
      "id": 8,
      "start": 18931.22,
      "end": 18932.98,
      "formatted_start": "05:15:31.220",
      "formatted_end": "05:15:32.980",
      "text": "با خیلی خودش دانده دست کنن"
    },
    {
      "id": 9,
      "start": 18932.98,
      "end": 18934.34,
      "formatted_start": "05:15:32.980",
      "formatted_end": "05:15:34.340",
      "text": "آره میگن نه میگن"
    },
    {
      "id": 10,
      "start": 18934.34,
      "end": 18936.24,
      "formatted_start": "05:15:34.340",
      "formatted_end": "05:15:36.240",
      "text": "یعنی که منظورم اینه"
    },
    {
      "id": 11,
      "start": 18936.24,
      "end": 18938.04,
      "formatted_start": "05:15:36.240",
      "formatted_end": "05:15:38.040",
      "text": "کلیبوندهایی که بالا هست"
    },
    {
      "id": 12,
      "start": 18938.04,
      "end": 18939.0,
      "formatted_start": "05:15:38.040",
      "formatted_end": "05:15:39.000",
      "text": "همه قلب دیگه"
    },
    {
      "id": 13,
      "start": 18939.0,
      "end": 18941.2,
      "formatted_start": "05:15:39.000",
      "formatted_end": "05:15:41.200",
      "text": "مردمش گلیمون کردی"
    },
    {
      "id": 14,
      "start": 18941.2,
      "end": 18944.08,
      "formatted_start": "05:15:41.200",
      "formatted_end": "05:15:44.080",
      "text": "ایشانو یه روز آزادی برا ما باشه"
    },
    {
      "id": 15,
      "start": 18944.08,
      "end": 18945.04,
      "formatted_start": "05:15:44.080",
      "formatted_end": "05:15:45.040",
      "text": "برا ما که بسش"
    },
    {
      "id": 16,
      "start": 18945.04,
      "end": 18945.96,
      "formatted_start": "05:15:45.040",
      "formatted_end": "05:15:45.960",
      "text": "از ما که بسش"
    },
    {
      "id": 17,
      "start": 18945.96,
      "end": 18947.96,
      "formatted_start": "05:15:45.960",
      "formatted_end": "05:15:47.960",
      "text": "نه با ما که دیگه اونها همه کمان"
    },
    {
      "id": 18,
      "start": 18947.96,
      "end": 18950.46,
      "formatted_start": "05:15:47.960",
      "formatted_end": "05:15:50.460",
      "text": "یک فکری با حال این جوانایی ما کنند"
    },
    {
      "id": 19,
      "start": 18950.46,
      "end": 18952.96,
      "formatted_start": "05:15:50.460",
      "formatted_end": "05:15:52.960",
      "text": "تا به خاندکتر و به خدا نه"
    },
    {
      "id": 20,
      "start": 18952.96,
      "end": 18954.96,
      "formatted_start": "05:15:52.960",
      "formatted_end": "05:15:54.960",
      "text": "چی بگم کارگری کردم"
    },
    {
      "id": 21,
      "start": 18954.96,
      "end": 18956.96,
      "formatted_start": "05:15:54.960",
      "formatted_end": "05:15:56.960",
      "text": "حالا تو مثل خوهرمی"
    },
    {
      "id": 22,
      "start": 18956.96,
      "end": 18961.96,
      "formatted_start": "05:15:56.960",
      "formatted_end": "05:16:01.960",
      "text": "یعنی پسرم، یعنی عشق اینه که داره یه جا وره در آمدزایی"
    },
    {
      "id": 23,
      "start": 18961.96,
      "end": 18964.96,
      "formatted_start": "05:16:01.960",
      "formatted_end": "05:16:04.960",
      "text": "یک ساله تمام چشماشی بذاشته برای کمکور"
    },
    {
      "id": 24,
      "start": 18964.96,
      "end": 18967.96,
      "formatted_start": "05:16:04.960",
      "formatted_end": "05:16:07.960",
      "text": "آمده اینکه اونو بیداد سخت بودند، سخت بود"
    },
    {
      "id": 25,
      "start": 18967.96,
      "end": 18969.96,
      "formatted_start": "05:16:07.960",
      "formatted_end": "05:16:09.960",
      "text": "ماون هرکی سهمی داره میره"
    },
    {
      "id": 26,
      "start": 18969.96,
      "end": 18971.96,
      "formatted_start": "05:16:09.960",
      "formatted_end": "05:16:11.960",
      "text": "تکلیف ما از اونها جدایی"
    },
    {
      "id": 27,
      "start": 18971.96,
      "end": 18973.96,
      "formatted_start": "05:16:11.960",
      "formatted_end": "05:16:13.960",
      "text": "خب چرا باید میدونیشی؟"
    },
    {
      "id": 28,
      "start": 18973.96,
      "end": 18975.96,
      "formatted_start": "05:16:13.960",
      "formatted_end": "05:16:15.960",
      "text": "اینکه سهمه جهانی باشن، سهمه برنامه"
    },
    {
      "id": 29,
      "start": 18975.96,
      "end": 18977.96,
      "formatted_start": "05:16:15.960",
      "formatted_end": "05:16:17.960",
      "text": "اینقدر به خدا دیدم به خانه اینکه من چندی سوزه"
    },
    {
      "id": 30,
      "start": 18977.96,
      "end": 18979.96,
      "formatted_start": "05:16:17.960",
      "formatted_end": "05:16:19.960",
      "text": "از شما اینجا مابودی شدید"
    },
    {
      "id": 31,
      "start": 18979.96,
      "end": 18981.96,
      "formatted_start": "05:16:19.960",
      "formatted_end": "05:16:21.960",
      "text": "ما تمام جبانی مون بوداشیم"
    },
    {
      "id": 32,
      "start": 18981.96,
      "end": 18983.96,
      "formatted_start": "05:16:21.960",
      "formatted_end": "05:16:23.960",
      "text": "من تو تخصص به سهمه درس بودم"
    },
    {
      "id": 33,
      "start": 18983.96,
      "end": 18985.96,
      "formatted_start": "05:16:23.960",
      "formatted_end": "05:16:25.960",
      "text": "در افتران شما به یک تو تمام دازه خودمش"
    },
    {
      "id": 34,
      "start": 18985.96,
      "end": 18987.96,
      "formatted_start": "05:16:25.960",
      "formatted_end": "05:16:27.960",
      "text": "دکتوره سهمه بطن"
    },
    {
      "id": 35,
      "start": 18987.96,
      "end": 18989.96,
      "formatted_start": "05:16:27.960",
      "formatted_end": "05:16:29.960",
      "text": "آره"
    },
    {
      "id": 36,
      "start": 18989.96,
      "end": 18991.96,
      "formatted_start": "05:16:29.960",
      "formatted_end": "05:16:31.960",
      "text": "ببین من همه جبانی مون درس بودم"
    },
    {
      "id": 37,
      "start": 18991.96,
      "end": 18993.96,
      "formatted_start": "05:16:31.960",
      "formatted_end": "05:16:33.960",
      "text": "ما زخمت گشتیم به هیچ چی نرسیدی"
    },
    {
      "id": 38,
      "start": 18993.96,
      "end": 18995.96,
      "formatted_start": "05:16:33.960",
      "formatted_end": "05:16:35.960",
      "text": "برام"
    },
    {
      "id": 39,
      "start": 18995.96,
      "end": 18997.96,
      "formatted_start": "05:16:35.960",
      "formatted_end": "05:16:37.960",
      "text": "خیلی سخته"
    },
    {
      "id": 40,
      "start": 18997.96,
      "end": 19010.06,
      "formatted_start": "05:16:37.960",
      "formatted_end": "05:16:50.060",
      "text": "خیلی سخته مورد. سدات خوهر من پرستاره خب به خاطر این کمبود دارو میگی خدا شاید آبچه یه بچه سخته بود پول اوجانسی که قرار بود از اینجا ببر آمرانسشه"
    },
    {
      "id": 41,
      "start": 19010.06,
      "end": 19016.52,
      "formatted_start": "05:16:50.060",
      "formatted_end": "05:16:56.520",
      "text": "یک ماه قوقم دادن پول این آمرانسه دادن و متاسفانه میگی جمعانم تو را خود کردیم"
    },
    {
      "id": 42,
      "start": 19016.52,
      "end": 19021.74,
      "formatted_start": "05:16:56.520",
      "formatted_end": "05:17:01.740",
      "text": "بعد به خاطر بعضی چیزا خوهرم تفلیل انداختن زندانش و روها سرش آوردن"
    },
    {
      "id": 43,
      "start": 19021.74,
      "end": 19024.48,
      "formatted_start": "05:17:01.740",
      "formatted_end": "05:17:04.480",
      "text": "خیلی شکرم"
    },
    {
      "id": 44,
      "start": 19024.48,
      "end": 19026.94,
      "formatted_start": "05:17:04.480",
      "formatted_end": "05:17:06.940",
      "text": "سدات در آورده دیگه تاکتر خانه"
    },
    {
      "id": 45,
      "start": 19026.94,
      "end": 19028.94,
      "formatted_start": "05:17:06.940",
      "formatted_end": "05:17:08.940",
      "text": "این شخص رو یه موزه کشید"
    },
    {
      "id": 46,
      "start": 19028.94,
      "end": 19034.04,
      "formatted_start": "05:17:08.940",
      "formatted_end": "05:17:14.040",
      "text": "این لحظه یک روزی خدا یه فکری با حال مدت می کنه"
    },
    {
      "id": 47,
      "start": 19034.04,
      "end": 19044.72,
      "formatted_start": "05:17:14.040",
      "formatted_end": "05:17:24.720",
      "text": "آهه من نیمی گفت"
    },
    {
      "id": 48,
      "start": 19044.72,
      "end": 19050.24,
      "formatted_start": "05:17:24.720",
      "formatted_end": "05:17:30.240",
      "text": "من آهه پدرم و درده می خواست"
    },
    {
      "id": 49,
      "start": 19050.24,
      "end": 19051.82,
      "formatted_start": "05:17:30.240",
      "formatted_end": "05:17:31.820",
      "text": "یک جمانی نمونده"
    },
    {
      "id": 50,
      "start": 19051.82,
      "end": 19055.54,
      "formatted_start": "05:17:31.820",
      "formatted_end": "05:17:35.540",
      "text": "واقعا همجور نسل شما بود"
    },
    {
      "id": 51,
      "start": 19055.54,
      "end": 19063.54,
      "formatted_start": "05:17:35.540",
      "formatted_end": "05:17:43.540",
      "text": "من خب منی که الان دارم داد میزنم من لاغیقه مثلا سر برنگ کشتنم یا خیلی ببخشی کنبا کشتنم"
    },
    {
      "id": 52,
      "start": 19063.54,
      "end": 19065.54,
      "formatted_start": "05:17:43.540",
      "formatted_end": "05:17:45.540",
      "text": "من روزم نمیگذره"
    },
    {
      "id": 53,
      "start": 19065.54,
      "end": 19067.54,
      "formatted_start": "05:17:45.540",
      "formatted_end": "05:17:47.540",
      "text": "من روزم نمیگذره"
    },
    {
      "id": 54,
      "start": 19067.54,
      "end": 19070.54,
      "formatted_start": "05:17:47.540",
      "formatted_end": "05:17:50.540",
      "text": "خب اونه ای برد کشتن همه ارگام بزن"
    },
    {
      "id": 55,
      "start": 19070.54,
      "end": 19073.54,
      "formatted_start": "05:17:50.540",
      "formatted_end": "05:17:53.540",
      "text": "خدا چون بچه ها چون بگردید نیستن"
    },
    {
      "id": 56,
      "start": 19073.54,
      "end": 19075.54,
      "formatted_start": "05:17:53.540",
      "formatted_end": "05:17:55.540",
      "text": "من برده هم دارم آرگه"
    },
    {
      "id": 57,
      "start": 19075.54,
      "end": 19079.54,
      "formatted_start": "05:17:55.540",
      "formatted_end": "05:17:59.540",
      "text": "اون وقت که وزیر قنبلی دختر دستایشون اونجا همه چشم بردن"
    },
    {
      "id": 58,
      "start": 19079.54,
      "end": 19084.54,
      "formatted_start": "05:17:59.540",
      "formatted_end": "05:18:04.540",
      "text": "چطور دید مره اینجا نختی اینجا فرامون اونجا سوابه"
    },
    {
      "id": 59,
      "start": 19084.54,
      "end": 19091.54,
      "formatted_start": "05:18:04.540",
      "formatted_end": "05:18:11.540",
      "text": "آهل منم داره میرم از اینجا دیروز اتفاقا پریروز دیروز پریروزا و مساویش آمد قبول شده"
    },
    {
      "id": 60,
      "start": 19091.54,
      "end": 19095.54,
      "formatted_start": "05:18:11.540",
      "formatted_end": "05:18:15.540",
      "text": "ما شما یک زمان اون کشور امتحان داده اینا"
    },
    {
      "id": 61,
      "start": 19095.54,
      "end": 19099.54,
      "formatted_start": "05:18:15.540",
      "formatted_end": "05:18:19.540",
      "text": "میگن من روابه غیرتت خواهد برو بابا اینجا یک چی نداره برو"
    },
    {
      "id": 62,
      "start": 19099.54,
      "end": 19105.54,
      "formatted_start": "05:18:19.540",
      "formatted_end": "05:18:25.540",
      "text": "همون مورد همه دختر خواهد درم سیرسی بردار و اونجا تحسیز نبی شده"
    },
    {
      "id": 63,
      "start": 19105.54,
      "end": 19108.04,
      "formatted_start": "05:18:25.540",
      "formatted_end": "05:18:28.040",
      "text": "خالقه پردیب شده ایران مدکشو نبیده"
    },
    {
      "id": 64,
      "start": 19108.04,
      "end": 19110.04,
      "formatted_start": "05:18:28.040",
      "formatted_end": "05:18:30.040",
      "text": "بله گیر کرده"
    },
    {
      "id": 65,
      "start": 19110.04,
      "end": 19112.08,
      "formatted_start": "05:18:30.040",
      "formatted_end": "05:18:32.080",
      "text": "ایران مدکشو بسیار شده نبیده"
    },
    {
      "id": 66,
      "start": 19112.08,
      "end": 19116.06,
      "formatted_start": "05:18:32.080",
      "formatted_end": "05:18:36.060",
      "text": "اینو مرخور برقی شدن"
    },
    {
      "id": 67,
      "start": 19116.06,
      "end": 19119.62,
      "formatted_start": "05:18:36.060",
      "formatted_end": "05:18:39.620",
      "text": "خیلی شرفت"
    },
    {
      "id": 68,
      "start": 19119.62,
      "end": 19121.56,
      "formatted_start": "05:18:39.620",
      "formatted_end": "05:18:41.560",
      "text": "به لحظه میرن"
    },
    {
      "id": 69,
      "start": 19121.56,
      "end": 19123.34,
      "formatted_start": "05:18:41.560",
      "formatted_end": "05:18:43.340",
      "text": "آقایی که اینو برخورد"
    },
    {
      "id": 70,
      "start": 19123.34,
      "end": 19124.34,
      "formatted_start": "05:18:43.340",
      "formatted_end": "05:18:44.340",
      "text": "به لحظه آره"
    },
    {
      "id": 71,
      "start": 19124.34,
      "end": 19131.0,
      "formatted_start": "05:18:44.340",
      "formatted_end": "05:18:51.000",
      "text": "نکه شاهر بخب من 33 سال کار کرده"
    },
    {
      "id": 72,
      "start": 19131.0,
      "end": 19133.38,
      "formatted_start": "05:18:51.000",
      "formatted_end": "05:18:53.380",
      "text": "22 سال بین ورشت شده"
    },
    {
      "id": 73,
      "start": 19133.38,
      "end": 19135.26,
      "formatted_start": "05:18:53.380",
      "formatted_end": "05:18:55.260",
      "text": "اینه کجای رونیو باید بیم"
    },
    {
      "id": 74,
      "start": 19135.26,
      "end": 19137.26,
      "formatted_start": "05:18:55.260",
      "formatted_end": "05:18:57.260",
      "text": "اینقدر که دوزدی شده"
    },
    {
      "id": 75,
      "start": 19137.26,
      "end": 19140.26,
      "formatted_start": "05:18:57.260",
      "formatted_end": "05:19:00.260",
      "text": "این بدبخ به خاطر اینکه از کار درش نگردن"
    },
    {
      "id": 76,
      "start": 19140.26,
      "end": 19143.26,
      "formatted_start": "05:19:00.260",
      "formatted_end": "05:19:03.260",
      "text": "صدا شده رو نبورده با 33 سال خدمت"
    },
    {
      "id": 77,
      "start": 19143.26,
      "end": 19145.26,
      "formatted_start": "05:19:03.260",
      "formatted_end": "05:19:05.260",
      "text": "اون از دو ماشین زباله"
    },
    {
      "id": 78,
      "start": 19145.26,
      "end": 19149.26,
      "formatted_start": "05:19:05.260",
      "formatted_end": "05:19:09.260",
      "text": "بعد 27 سال میگن با همین وضع باید بیاد سر کار"
    },
    {
      "id": 79,
      "start": 19149.26,
      "end": 19151.26,
      "formatted_start": "05:19:09.260",
      "formatted_end": "05:19:11.260",
      "text": "هیچ راهی نداره"
    },
    {
      "id": 80,
      "start": 19151.26,
      "end": 19153.26,
      "formatted_start": "05:19:11.260",
      "formatted_end": "05:19:13.260",
      "text": "این چجوری بگیر سر کار"
    },
    {
      "id": 81,
      "start": 19157.26,
      "end": 19159.26,
      "formatted_start": "05:19:17.260",
      "formatted_end": "05:19:19.260",
      "text": "خواهی کنون باشم؟"
    },
    {
      "id": 82,
      "start": 19159.26,
      "end": 19160.26,
      "formatted_start": "05:19:19.260",
      "formatted_end": "05:19:20.260",
      "text": "باست"
    },
    {
      "id": 83,
      "start": 19160.26,
      "end": 19162.26,
      "formatted_start": "05:19:20.260",
      "formatted_end": "05:19:22.260",
      "text": "اینجا مبتشی؟"
    },
    {
      "id": 84,
      "start": 19162.26,
      "end": 19168.26,
      "formatted_start": "05:19:22.260",
      "formatted_end": "05:19:28.260",
      "text": "اینجور خدا خانده دوست داره اینجور آمد اینجور افتوکتی داره اگه هر چی هست یه دفعه کارشی شد"
    },
    {
      "id": 85,
      "start": 19168.26,
      "end": 19175.26,
      "formatted_start": "05:19:28.260",
      "formatted_end": "05:19:35.260",
      "text": "من اگه خودمم نیالیزه تو حقیقتش من کارمو کنم جانونو همه دست داروها با خودم خود"
    },
    {
      "id": 86,
      "start": 19175.26,
      "end": 19182.26,
      "formatted_start": "05:19:35.260",
      "formatted_end": "05:19:42.260",
      "text": "و داروشم مشخصه فقط به خاطر اینجور بیمارستانی و دارو بیمارستانی بگیرم دور و بیرون خیلی"
    },
    {
      "id": 87,
      "start": 19182.26,
      "end": 19186.26,
      "formatted_start": "05:19:42.260",
      "formatted_end": "05:19:46.260",
      "text": "اولینکه بیدارم شد بازار آزاد و آچاق خیلی گرونه"
    },
    {
      "id": 88,
      "start": 19186.26,
      "end": 19188.26,
      "formatted_start": "05:19:46.260",
      "formatted_end": "05:19:48.260",
      "text": "برای اینکه بخواهیم بسیار ملیون میشه"
    },
    {
      "id": 89,
      "start": 19188.26,
      "end": 19190.26,
      "formatted_start": "05:19:48.260",
      "formatted_end": "05:19:50.260",
      "text": "برای این"
    },
    {
      "id": 90,
      "start": 19190.26,
      "end": 19192.26,
      "formatted_start": "05:19:50.260",
      "formatted_end": "05:19:52.260",
      "text": "خودم دارم"
    },
    {
      "id": 91,
      "start": 19192.26,
      "end": 19194.26,
      "formatted_start": "05:19:52.260",
      "formatted_end": "05:19:54.260",
      "text": "کارها کاره مریض که با خودم"
    },
    {
      "id": 92,
      "start": 19194.26,
      "end": 19196.26,
      "formatted_start": "05:19:54.260",
      "formatted_end": "05:19:56.260",
      "text": "من اینوقت مریضم وله میکنم"
    },
    {
      "id": 93,
      "start": 19196.26,
      "end": 19198.26,
      "formatted_start": "05:19:56.260",
      "formatted_end": "05:19:58.260",
      "text": "اتفاقاً"
    },
    {
      "id": 94,
      "start": 19198.26,
      "end": 19200.26,
      "formatted_start": "05:19:58.260",
      "formatted_end": "05:20:00.260",
      "text": "تنها چیزی که از من ممکنه بشنه"
    }
  ],
  "status": "completed"
}