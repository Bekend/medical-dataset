    },
    {
      "id": 14,
      "start": 14156.0,
      "end": 14158.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:55:58.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 15,
      "start": 14160.0,
      "end": 14162.92,
      "formatted_start": "03:56:00.000",
      "formatted_end": "03:56:02.920",
      "text": "توی حیاتم منم با یه دونه رو روزاشن"
    },
    {
      "id": 16,
      "start": 14162.92,
      "end": 14168.12,
      "formatted_start": "03:56:02.920",
      "formatted_end": "03:56:08.120",
      "text": "نرسید"
    },
    {
      "id": 17,
      "start": 14168.12,
      "end": 14169.7,
      "formatted_start": "03:56:08.120",
      "formatted_end": "03:56:09.700",
      "text": "بعد از اون نسخه هم برم برده"
    },
    {
      "id": 18,
      "start": 14169.7,
      "end": 14170.46,
      "formatted_start": "03:56:09.700",
      "formatted_end": "03:56:10.460",
      "text": "برم اینجا"
    },
    {
      "id": 19,
      "start": 14170.46,
      "end": 14171.5,
      "formatted_start": "03:56:10.460",
      "formatted_end": "03:56:11.500",
      "text": "برده"
    },
    {
      "id": 20,
      "start": 14171.5,
      "end": 14174.2,
      "formatted_start": "03:56:11.500",
      "formatted_end": "03:56:14.200",
      "text": "بعد دوتا هم خود میرسم"
    },
    {
      "id": 21,
      "start": 14174.2,
      "end": 14175.24,
      "formatted_start": "03:56:14.200",
      "formatted_end": "03:56:15.240",
      "text": "دوتا امروز میرسم"
    },
    {
      "id": 22,
      "start": 14175.24,
      "end": 14176.68,
      "formatted_start": "03:56:15.240",
      "formatted_end": "03:56:16.680",
      "text": "یکی پس پرده خب"
    },
    {
      "id": 23,
      "start": 14176.68,
      "end": 14179.22,
      "formatted_start": "03:56:16.680",
      "formatted_end": "03:56:19.220",
      "text": "بعد یه پرس براتون میرسم"
    },
    {
      "id": 24,
      "start": 14179.22,
      "end": 14182.44,
      "formatted_start": "03:56:19.220",
      "formatted_end": "03:56:22.440",
      "text": "مادر خب این نمیخوام همیشه بخورید خب"
    },
    {
      "id": 25,
      "start": 14182.44,
      "end": 14184.5,
      "formatted_start": "03:56:22.440",
      "formatted_end": "03:56:24.500",
      "text": "فقط در زمانه که"
    },
    {
      "id": 26,
      "start": 14184.5,
      "end": 14187.36,
      "formatted_start": "03:56:24.500",
      "formatted_end": "03:56:27.360",
      "text": "الان مامان پنج روز این موصوبه شون میدید"
    },
    {
      "id": 27,
      "start": 14187.36,
      "end": 14188.62,
      "formatted_start": "03:56:27.360",
      "formatted_end": "03:56:28.620",
      "text": "که بخورن سو بشن"
    },
    {
      "id": 28,
      "start": 14188.62,
      "end": 14193.12,
      "formatted_start": "03:56:28.620",
      "formatted_end": "03:56:33.120",
      "text": "بعد از اون دیگه فعلا نمیخورم تا اگه یک وقت مشکلش بشن"
    },
    {
      "id": 29,
      "start": 14193.12,
      "end": 14200.12,
      "formatted_start": "03:56:33.120",
      "formatted_end": "03:56:40.120",
      "text": "به خاطر این توش مسکره بعد این برای اینه که فعلا باید ارتحال مفصلشون خوب بشه خب؟"
    },
    {
      "id": 30,
      "start": 14200.12,
      "end": 14206.12,
      "formatted_start": "03:56:40.120",
      "formatted_end": "03:56:46.120",
      "text": "بعد یه قذروبساز برای مامان مینم بیستم قذروبسازشون رو یه روز درمیان بخورن"
    },
    {
      "id": 31,
      "start": 14206.12,
      "end": 14210.12,
      "formatted_start": "03:56:46.120",
      "formatted_end": "03:56:50.120",
      "text": "چون غندون میبره بالا یه روز درمیان کافی های غندشون اومد بالا نیست"
    },
    {
      "id": 32,
      "start": 14210.12,
      "end": 14212.12,
      "formatted_start": "03:56:50.120",
      "formatted_end": "03:56:52.120",
      "text": "متاولی بازم احتیاط میکنم"
    },
    {
      "id": 33,
      "start": 14218.62,
      "end": 14222.62,
      "formatted_start": "03:56:58.620",
      "formatted_end": "03:57:02.620",
      "text": "ماما گفت که هر چی هم هست و خودها دارن"
    },
    {
      "id": 34,
      "start": 14222.62,
      "end": 14226.62,
      "formatted_start": "03:57:02.620",
      "formatted_end": "03:57:06.620",
      "text": "داریم ماما من این یادتو کار بیم برداشت"
    },
    {
      "id": 35,
      "start": 14226.62,
      "end": 14230.62,
      "formatted_start": "03:57:06.620",
      "formatted_end": "03:57:10.620",
      "text": "این یادتو کار بیم برداشت"
    },
    {
      "id": 36,
      "start": 14230.62,
      "end": 14234.62,
      "formatted_start": "03:57:10.620",
      "formatted_end": "03:57:14.620",
      "text": "تندوها این بیم تکمیلی که ما بودیم"
    },
    {
      "id": 37,
      "start": 14234.62,
      "end": 14238.62,
      "formatted_start": "03:57:14.620",
      "formatted_end": "03:57:18.620",
      "text": "وقتش که تمام میشه؟"
    },
    {
      "id": 38,
      "start": 14238.62,
      "end": 14242.62,
      "formatted_start": "03:57:18.620",
      "formatted_end": "03:57:22.620",
      "text": "وقتش که تمام میشه چیز یعنی چه مدت اعتماده بود"
    },
    {
      "id": 39,
      "start": 14242.62,
      "end": 14246.62,
      "formatted_start": "03:57:22.620",
      "formatted_end": "03:57:26.620",
      "text": "باست باید همچنان چند وقت تبدیل کنیم"
    },
    {
      "id": 40,
      "start": 14246.62,
      "end": 14249.62,
      "formatted_start": "03:57:26.620",
      "formatted_end": "03:57:29.620",
      "text": "از این تقمیت ها کلی هم نمی کنه"
    },
    {
      "id": 41,
      "start": 14249.62,
      "end": 14252.62,
      "formatted_start": "03:57:29.620",
      "formatted_end": "03:57:32.620",
      "text": "نظر کلی این بیمه ما تمنیشنوایی می آورد؟"
    },
    {
      "id": 42,
      "start": 14252.62,
      "end": 14253.62,
      "formatted_start": "03:57:32.620",
      "formatted_end": "03:57:33.620",
      "text": "بیمون چی؟"
    },
    {
      "id": 43,
      "start": 14253.62,
      "end": 14255.62,
      "formatted_start": "03:57:33.620",
      "formatted_end": "03:57:35.620",
      "text": "تمنیشنوای بیمارستان رو میری فرد"
    },
    {
      "id": 44,
      "start": 14255.62,
      "end": 14257.62,
      "formatted_start": "03:57:35.620",
      "formatted_end": "03:57:37.620",
      "text": "این با قاطر همه خورس هایی رفت چربه ایران می دهد"
    },
    {
      "id": 45,
      "start": 14257.62,
      "end": 14259.62,
      "formatted_start": "03:57:37.620",
      "formatted_end": "03:57:39.620",
      "text": "موزکن هم که میگیم، نداریم"
    },
    {
      "id": 46,
      "start": 14259.62,
      "end": 14261.62,
      "formatted_start": "03:57:39.620",
      "formatted_end": "03:57:41.620",
      "text": "خب بیمه نیست از این"
    },
    {
      "id": 47,
      "start": 14261.62,
      "end": 14263.62,
      "formatted_start": "03:57:41.620",
      "formatted_end": "03:57:43.620",
      "text": "این تقمیت ها بیمه نیست"
    },
    {
      "id": 48,
      "start": 14263.62,
      "end": 14265.62,
      "formatted_start": "03:57:43.620",
      "formatted_end": "03:57:45.620",
      "text": "به اول و بعد داروه ایرانی که"
    },
    {
      "id": 49,
      "start": 14265.62,
      "end": 14267.62,
      "formatted_start": "03:57:45.620",
      "formatted_end": "03:57:47.620",
      "text": "مثلا قیمت چطور داره، سان ریسی"
    },
    {
      "id": 50,
      "start": 14267.62,
      "end": 14275.12,
      "formatted_start": "03:57:47.620",
      "formatted_end": "03:57:55.120",
      "text": "از اینکه از ازای ایلیمی کلمیت خیلی عزیز شد از دنیا ولی اونو در مریضه خواست کلمیت کلمیت میدهند"
    },
    {
      "id": 51,
      "start": 14275.12,
      "end": 14280.12,
      "formatted_start": "03:57:55.120",
      "formatted_end": "03:58:00.120",
      "text": "مجبور هستند دکتراشون اونو هم میدونند هست شد و بعد چند بشون میگن این ها مونده همین برنامه"
    },
    {
      "id": 52,
      "start": 14280.12,
      "end": 14282.12,
      "formatted_start": "03:58:00.120",
      "formatted_end": "03:58:02.120",
      "text": "فقط هم اونو رو موجود دارند؟"
    },
    {
      "id": 53,
      "start": 14282.12,
      "end": 14287.62,
      "formatted_start": "03:58:02.120",
      "formatted_end": "03:58:07.620",
      "text": "این بچه ها همه منو که نردتند اینشو نرم میدن و مادرانو از اونو کم میکنند"
    },
    {
      "id": 54,
      "start": 14287.62,
      "end": 14291.62,
      "formatted_start": "03:58:07.620",
      "formatted_end": "03:58:11.620",
      "text": "فقط این برسای قلد چربی اونو دارم میدهند"
    },
    {
      "id": 55,
      "start": 14291.62,
      "end": 14295.62,
      "formatted_start": "03:58:11.620",
      "formatted_end": "03:58:15.620",
      "text": "اینه هر ماه یک بار برمون همون را بهتون میدن"
    },
    {
      "id": 56,
      "start": 14295.62,
      "end": 14297.62,
      "formatted_start": "03:58:15.620",
      "formatted_end": "03:58:17.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 57,
      "start": 14297.62,
      "end": 14299.62,
      "formatted_start": "03:58:17.620",
      "formatted_end": "03:58:19.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 58,
      "start": 14299.62,
      "end": 14301.62,
      "formatted_start": "03:58:19.620",
      "formatted_end": "03:58:21.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 59,
      "start": 14301.62,
      "end": 14303.62,
      "formatted_start": "03:58:21.620",
      "formatted_end": "03:58:23.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 60,
      "start": 14303.62,
      "end": 14305.62,
      "formatted_start": "03:58:23.620",
      "formatted_end": "03:58:25.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 61,
      "start": 14305.62,
      "end": 14307.62,
      "formatted_start": "03:58:25.620",
      "formatted_end": "03:58:27.620",
      "text": "دست شما در این وقت همونه هیلوتی ترمیل میشه"
    },
    {
      "id": 62,
      "start": 14307.62,
      "end": 14328.62,
      "formatted_start": "03:58:27.620",
      "formatted_end": "03:58:48.620",
      "text": "این هم جدید هست این مال از آن چار ساله"
    },
    {
      "id": 63,
      "start": 14328.62,
      "end": 14334.62,
      "formatted_start": "03:58:48.620",
      "formatted_end": "03:58:54.620",
      "text": "خدا نظر چی بوده؟ که میخواد برمیشه شده؟"
    },
    {
      "id": 64,
      "start": 14334.62,
      "end": 14336.62,
      "formatted_start": "03:58:54.620",
      "formatted_end": "03:58:56.620",
      "text": "این همه چیزی همه چیزی در این وقت بردارید."
    },
    {
      "id": 65,
      "start": 14336.62,
      "end": 14338.62,
      "formatted_start": "03:58:56.620",
      "formatted_end": "03:58:58.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 66,
      "start": 14338.62,
      "end": 14340.62,
      "formatted_start": "03:58:58.620",
      "formatted_end": "03:59:00.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 67,
      "start": 14340.62,
      "end": 14342.62,
      "formatted_start": "03:59:00.620",
      "formatted_end": "03:59:02.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 68,
      "start": 14342.62,
      "end": 14344.62,
      "formatted_start": "03:59:02.620",
      "formatted_end": "03:59:04.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 69,
      "start": 14344.62,
      "end": 14346.62,
      "formatted_start": "03:59:04.620",
      "formatted_end": "03:59:06.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 70,
      "start": 14346.62,
      "end": 14348.62,
      "formatted_start": "03:59:06.620",
      "formatted_end": "03:59:08.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 71,
      "start": 14348.62,
      "end": 14350.62,
      "formatted_start": "03:59:08.620",
      "formatted_end": "03:59:10.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 72,
      "start": 14350.62,
      "end": 14352.62,
      "formatted_start": "03:59:10.620",
      "formatted_end": "03:59:12.620",
      "text": "این همه چیزی در این وقت بردارید."
    },
    {
      "id": 73,
      "start": 14352.62,
      "end": 14356.62,
      "formatted_start": "03:59:12.620",
      "formatted_end": "03:59:16.620",
      "text": "آره دیدیم، پاون پلاستیک گرم باید قبلنه و بعدی همه جلوی دارم"
    },
    {
      "id": 74,
      "start": 14356.62,
      "end": 14358.62,
      "formatted_start": "03:59:16.620",
      "formatted_end": "03:59:18.620",
      "text": "پاون پلاستیک گرم باید قبلنه و بعدی همه جلوی دارم"
    },
    {
      "id": 75,
      "start": 14358.62,
      "end": 14360.62,
      "formatted_start": "03:59:18.620",
      "formatted_end": "03:59:20.620",
      "text": "همینو باید این هفته و هفته قبلنه"
    },
    {
      "id": 76,
      "start": 14360.62,
      "end": 14362.62,
      "formatted_start": "03:59:20.620",
      "formatted_end": "03:59:22.620",
      "text": "این هفته ندارم"
    },
    {
      "id": 77,
      "start": 14362.62,
      "end": 14365.62,
      "formatted_start": "03:59:22.620",
      "formatted_end": "03:59:25.620",
      "text": "این اکسشو پسردشو"
    },
    {
      "id": 78,
      "start": 14370.62,
      "end": 14373.62,
      "formatted_start": "03:59:30.620",
      "formatted_end": "03:59:33.620",
      "text": "خود نداره یه دو ساعته حالا که جروح برداری بگیری"
    },
    {
      "id": 79,
      "start": 14373.62,
