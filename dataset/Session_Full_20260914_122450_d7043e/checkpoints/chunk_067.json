  "stt_segments": [
    {
      "id": 0,
      "start": 20100.0,
      "end": 20120.0,
      "formatted_start": "05:35:00.000",
      "formatted_end": "05:35:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 20120.0,
      "end": 20124.0,
      "formatted_start": "05:35:20.000",
      "formatted_end": "05:35:24.000",
      "text": "تایره جان، خانبا چی؟"
    },
    {
      "id": 2,
      "start": 20124.0,
      "end": 20148.8,
      "formatted_start": "05:35:24.000",
      "formatted_end": "05:35:48.800",
      "text": "ملاشایی بی زحمت"
    },
    {
      "id": 3,
      "start": 20154.0,
      "end": 20162.44,
      "formatted_start": "05:35:54.000",
      "formatted_end": "05:36:02.440",
      "text": "آره بعد فقط ببین دیلیپشو دیسی کن بعد از هر واید پکسلش چل میلی گرم لازیکس بهش بزنی"
    },
    {
      "id": 4,
      "start": 20162.44,
      "end": 20164.3,
      "formatted_start": "05:36:02.440",
      "formatted_end": "05:36:04.300",
      "text": "مرسی"
    },
    {
      "id": 5,
      "start": 20164.3,
      "end": 20168.1,
      "formatted_start": "05:36:04.300",
      "formatted_end": "05:36:08.100",
      "text": "بعد چک کلسیوم پوتاسیوم بعد از اتمام پکسل"
    },
    {
      "id": 6,
      "start": 20168.1,
      "end": 20170.56,
      "formatted_start": "05:36:08.100",
      "formatted_end": "05:36:10.560",
      "text": "آره بعد هر دو"
    },
    {
      "id": 7,
      "start": 20170.56,
      "end": 20172.98,
      "formatted_start": "05:36:10.560",
      "formatted_end": "05:36:12.980",
      "text": "چا"
    },
    {
      "id": 8,
      "start": 20172.98,
      "end": 20177.98,
      "formatted_start": "05:36:12.980",
      "formatted_end": "05:36:17.980",
      "text": "کلسیوم و پوتاسیوم بعد از اتمام پکسل"
    },
    {
      "id": 9,
      "start": 20177.98,
      "end": 20182.4,
      "formatted_start": "05:36:17.980",
      "formatted_end": "05:36:22.400",
      "text": "آره بشه بگو میخواییم بهت خون بزنیم اینکه هم خوشحال بشه"
    },
    {
      "id": 10,
      "start": 20182.4,
      "end": 20184.4,
      "formatted_start": "05:36:22.400",
      "formatted_end": "05:36:24.400",
      "text": "خب مرسی"
    },
    {
      "id": 11,
      "start": 20184.4,
      "end": 20186.4,
      "formatted_start": "05:36:24.400",
      "formatted_end": "05:36:26.400",
      "text": "خدا بازی"
    },
    {
      "id": 12,
      "start": 20186.4,
      "end": 20189.4,
      "formatted_start": "05:36:26.400",
      "formatted_end": "05:36:29.400",
      "text": "تایه نگاه کن من که اینو ما شیشه میخریم دیگه"
    },
    {
      "id": 13,
      "start": 20189.4,
      "end": 20192.4,
      "formatted_start": "05:36:29.400",
      "formatted_end": "05:36:32.400",
      "text": "حالا نگاه کنم خیلی وقت پیش این شیشه هم کردم"
    },
    {
      "id": 14,
      "start": 20192.4,
      "end": 20193.4,
      "formatted_start": "05:36:32.400",
      "formatted_end": "05:36:33.400",
      "text": "چه هست؟"
    },
    {
      "id": 15,
      "start": 20193.4,
      "end": 20195.4,
      "formatted_start": "05:36:33.400",
      "formatted_end": "05:36:35.400",
      "text": "آره اون روز منتور کمه"
    },
    {
      "id": 16,
      "start": 20195.4,
      "end": 20198.4,
      "formatted_start": "05:36:35.400",
      "formatted_end": "05:36:38.400",
      "text": "بعد من ندیدم این توی پلاستیک داد"
    },
    {
      "id": 17,
      "start": 20198.4,
      "end": 20200.4,
      "formatted_start": "05:36:38.400",
      "formatted_end": "05:36:40.400",
      "text": "مثلا 650 زمان خیلی کم بود"
    },
    {
      "id": 18,
      "start": 20200.4,
      "end": 20202.4,
      "formatted_start": "05:36:40.400",
      "formatted_end": "05:36:42.400",
      "text": "آره دیگه همین شده دیگه بکن که نه شده"
    },
    {
      "id": 19,
      "start": 20202.4,
      "end": 20204.4,
      "formatted_start": "05:36:42.400",
      "formatted_end": "05:36:44.400",
      "text": "بعد به من گفتهش که"
    },
    {
      "id": 20,
      "start": 20204.4,
      "end": 20205.4,
      "formatted_start": "05:36:44.400",
      "formatted_end": "05:36:45.400",
      "text": "گفتم اینا تمیزه"
    },
    {
      "id": 21,
      "start": 20205.4,
      "end": 20208.4,
      "formatted_start": "05:36:45.400",
      "formatted_end": "05:36:48.400",
      "text": "گفتم خب ازا ما این جبهه درکیلو رو باز میکنیم"
    },
    {
      "id": 22,
      "start": 20208.4,
      "end": 20210.4,
      "formatted_start": "05:36:48.400",
      "formatted_end": "05:36:50.400",
      "text": "این همینه"
    },
    {
      "id": 23,
      "start": 20210.4,
      "end": 20214.4,
      "formatted_start": "05:36:50.400",
      "formatted_end": "05:36:54.400",
      "text": "و بعد گفت این خیلی به صرفه تر در میاد برای تون تا اون که بخوایید"
    },
    {
      "id": 24,
      "start": 20214.4,
      "end": 20217.4,
      "formatted_start": "05:36:54.400",
      "formatted_end": "05:36:57.400",
      "text": "بعد این قهوه اکوادوره یعنی قهوه اصل"
    },
    {
      "id": 25,
      "start": 20217.4,
      "end": 20219.4,
      "formatted_start": "05:36:57.400",
      "formatted_end": "05:36:59.400",
      "text": "مثلا با تی بکنن"
    },
    {
      "id": 26,
      "start": 20219.4,
      "end": 20222.4,
      "formatted_start": "05:36:59.400",
      "formatted_end": "05:37:02.400",
      "text": "و دیدی ازا قهوه عربی ترشه داره"
    },
    {
      "id": 27,
      "start": 20222.4,
      "end": 20225.4,
      "formatted_start": "05:37:02.400",
      "formatted_end": "05:37:05.400",
      "text": "من ترش اصلا دوست ندارم"
    },
    {
      "id": 28,
      "start": 20225.4,
      "end": 20227.4,
      "formatted_start": "05:37:05.400",
      "formatted_end": "05:37:07.400",
      "text": "این تلخه"
    },
    {
      "id": 29,
      "start": 20227.4,
      "end": 20229.4,
      "formatted_start": "05:37:07.400",
      "formatted_end": "05:37:09.400",
      "text": "آره خیلی قهوه اچش خوب بود"
    },
    {
      "id": 30,
      "start": 20229.4,
      "end": 20231.4,
      "formatted_start": "05:37:09.400",
      "formatted_end": "05:37:11.400",
      "text": "بله اچش خوب بود نه؟"
    },
    {
      "id": 31,
      "start": 20231.4,
      "end": 20233.4,
      "formatted_start": "05:37:11.400",
      "formatted_end": "05:37:13.400",
      "text": "نه شما می کنید"
    },
    {
      "id": 32,
      "start": 20233.4,
      "end": 20235.4,
      "formatted_start": "05:37:13.400",
      "formatted_end": "05:37:15.400",
      "text": "از هم بی قهوه نیم"
    },
    {
      "id": 33,
      "start": 20235.4,
      "end": 20237.4,
      "formatted_start": "05:37:15.400",
      "formatted_end": "05:37:17.400",
      "text": "اینجوری"
    },
    {
      "id": 34,
      "start": 20245.4,
      "end": 20247.4,
      "formatted_start": "05:37:25.400",
      "formatted_end": "05:37:27.400",
      "text": "اینجوری"
    },
    {
      "id": 35,
      "start": 20247.4,
      "end": 20249.4,
      "formatted_start": "05:37:27.400",
      "formatted_end": "05:37:29.400",
      "text": "افتاده از همون افتاده"
    },
    {
      "id": 36,
      "start": 20249.4,
      "end": 20251.4,
      "formatted_start": "05:37:29.400",
      "formatted_end": "05:37:31.400",
      "text": "سپس برگردیم"
    },
    {
      "id": 37,
      "start": 20251.4,
      "end": 20253.4,
      "formatted_start": "05:37:31.400",
      "formatted_end": "05:37:33.400",
      "text": "چکم برد"
    },
    {
      "id": 38,
      "start": 20253.4,
      "end": 20255.4,
      "formatted_start": "05:37:33.400",
      "formatted_end": "05:37:35.400",
      "text": "چون آرشوی دارو بیان دهیم"
    },
    {
      "id": 39,
      "start": 20255.4,
      "end": 20257.4,
      "formatted_start": "05:37:35.400",
      "formatted_end": "05:37:37.400",
      "text": "دهیم"
    },
    {
      "id": 40,
      "start": 20265.4,
      "end": 20285.4,
      "formatted_start": "05:37:45.400",
      "formatted_end": "05:38:05.400",
      "text": "موسیقی"
    },
    {
