      "formatted_start": "01:16:40.300",
      "formatted_end": "01:16:43.700",
      "text": "خوشان من دو ماهی کار بستریم شدم"
    },
    {
      "id": 20,
      "start": 4603.7,
      "end": 4605.7,
      "formatted_start": "01:16:43.700",
      "formatted_end": "01:16:45.700",
      "text": "بگو چی چی مادرت خوبه؟"
    },
    {
      "id": 21,
      "start": 4605.7,
      "end": 4607.7,
      "formatted_start": "01:16:45.700",
      "formatted_end": "01:16:47.700",
      "text": "مادرم همینجوری هست"
    },
    {
      "id": 22,
      "start": 4607.7,
      "end": 4609.7,
      "formatted_start": "01:16:47.700",
      "formatted_end": "01:16:49.700",
      "text": "اون که میگویدونم"
    },
    {
      "id": 23,
      "start": 4609.7,
      "end": 4613.7,
      "formatted_start": "01:16:49.700",
      "formatted_end": "01:16:53.700",
      "text": "من اتراریه گفت که بیختیارش دادشان دوباره برد سیدناشو برد هچ دوباره گفت و نوشته بود"
    },
    {
      "id": 24,
      "start": 4613.7,
      "end": 4618.7,
      "formatted_start": "01:16:53.700",
      "formatted_end": "01:16:58.700",
      "text": "انجام داد گفت که از مغزشه بیختیاره اترار بیختاری مطمئن"
    },
    {
      "id": 25,
      "start": 4618.7,
      "end": 4619.7,
      "formatted_start": "01:16:58.700",
      "formatted_end": "01:16:59.700",
      "text": "از مغزشه"
    },
    {
      "id": 26,
      "start": 4619.7,
      "end": 4620.7,
      "formatted_start": "01:16:59.700",
      "formatted_end": "01:17:00.700",
      "text": "من که گفتم بهتون"
    },
    {
      "id": 27,
      "start": 4620.7,
      "end": 4623.7,
      "formatted_start": "01:17:00.700",
      "formatted_end": "01:17:03.700",
      "text": "خب عمل می کنم ولی عملم کنم فایده نداره"
    },
    {
      "id": 28,
      "start": 4623.7,
      "end": 4624.7,
      "formatted_start": "01:17:03.700",
      "formatted_end": "01:17:04.700",
      "text": "مثل همین"
    },
    {
      "id": 29,
      "start": 4624.7,
      "end": 4628.7,
      "formatted_start": "01:17:04.700",
      "formatted_end": "01:17:08.700",
      "text": "من که به شما گفتم والی مغزشه اینه که اون قسمت حسشو از دست داده"
    },
    {
      "id": 30,
      "start": 4628.7,
      "end": 4629.7,
      "formatted_start": "01:17:08.700",
      "formatted_end": "01:17:09.700",
      "text": "آره"
    },
    {
      "id": 31,
      "start": 4629.7,
      "end": 4631.7,
      "formatted_start": "01:17:09.700",
      "formatted_end": "01:17:11.700",
      "text": "آبچه که چی کرد می گفت نه این فیلم بازم کنه"
    },
    {
      "id": 32,
      "start": 4631.7,
      "end": 4634.7,
      "formatted_start": "01:17:11.700",
      "formatted_end": "01:17:14.700",
      "text": "گفتم این دختر خوب خوب دیگه نمیتونه که خودشو فیلم بازم کنه"
    },
    {
      "id": 33,
      "start": 4634.7,
      "end": 4637.7,
      "formatted_start": "01:17:14.700",
      "formatted_end": "01:17:17.700",
      "text": "یه بار ریلی کنی تفلک خوشش یه سر برده"
    },
    {
      "id": 34,
      "start": 4637.7,
      "end": 4641.7,
      "formatted_start": "01:17:17.700",
      "formatted_end": "01:17:21.700",
      "text": "الان منظور اون وچه هست منظورش اونجوریه"
    },
    {
      "id": 35,
      "start": 4641.7,
      "end": 4644.94,
      "formatted_start": "01:17:21.700",
      "formatted_end": "01:17:24.940",
      "text": "دیروز الان من همونش بکرده در دست من"
    },
    {
      "id": 36,
      "start": 4644.94,
      "end": 4647.28,
      "formatted_start": "01:17:24.940",
      "formatted_end": "01:17:27.280",
      "text": "آف باید چه سه بار چهار باید مدتون چند"
    },
    {
      "id": 37,
      "start": 4647.28,
      "end": 4650.72,
      "formatted_start": "01:17:27.280",
      "formatted_end": "01:17:30.720",
      "text": "اون تفلک اصلا ببین اون دریچه داره دوتا خوب"
    },
    {
      "id": 38,
      "start": 4650.72,
      "end": 4653.28,
      "formatted_start": "01:17:30.720",
      "formatted_end": "01:17:33.280",
      "text": "اون اقبازشو از دست داده"
    },
    {
      "id": 39,
      "start": 4653.28,
      "end": 4655.08,
      "formatted_start": "01:17:33.280",
      "formatted_end": "01:17:35.080",
      "text": "انگاه که شیر آف شده"
    },
    {
      "id": 40,
      "start": 4655.08,
      "end": 4657.02,
      "formatted_start": "01:17:35.080",
      "formatted_end": "01:17:37.020",
      "text": "این سرنوله بازه"
    },
    {
      "id": 41,
      "start": 4657.02,
      "end": 4659.92,
      "formatted_start": "01:17:37.020",
      "formatted_end": "01:17:39.920",
      "text": "باشه شیر بازه باشه آف چکیل کنه"
    },
    {
      "id": 42,
      "start": 4659.92,
      "end": 4661.14,
      "formatted_start": "01:17:39.920",
      "formatted_end": "01:17:41.140",
      "text": "این که نمیشه که مرمتون ببنده"
    },
    {
      "id": 43,
      "start": 4661.14,
      "end": 4663.42,
      "formatted_start": "01:17:41.140",
      "formatted_end": "01:17:43.420",
      "text": "این همجوری میاد این تفلک این نیست که"
    },
    {
      "id": 44,
      "start": 4663.42,
      "end": 4665.52,
      "formatted_start": "01:17:43.420",
      "formatted_end": "01:17:45.520",
      "text": "اگه آدم دلشم سخاد که نمیشه"
    },
    {
      "id": 45,
      "start": 4665.52,
      "end": 4667.52,
      "formatted_start": "01:17:45.520",
      "formatted_end": "01:17:47.520",
      "text": "دیگه هم کار کنی هم این کار نمی کنی"
    },
    {
      "id": 46,
      "start": 4667.52,
      "end": 4669.52,
      "formatted_start": "01:17:47.520",
      "formatted_end": "01:17:49.520",
      "text": "آره نمیدونی"
    },
    {
      "id": 47,
      "start": 4669.52,
      "end": 4671.52,
      "formatted_start": "01:17:49.520",
      "formatted_end": "01:17:51.520",
      "text": "چون من کسیفیه دیگه"
    },
    {
      "id": 48,
      "start": 4671.52,
      "end": 4673.52,
      "formatted_start": "01:17:51.520",
      "formatted_end": "01:17:53.520",
      "text": "وقتی خانه دکتر من دو یک ماه دو ماه بشتر بشت"
    },
    {
      "id": 49,
      "start": 4673.52,
      "end": 4675.52,
      "formatted_start": "01:17:53.520",
      "formatted_end": "01:17:55.520",
      "text": "بگیر وستر شدم"
    },
    {
      "id": 50,
      "start": 4675.52,
      "end": 4677.52,
      "formatted_start": "01:17:55.520",
      "formatted_end": "01:17:57.520",
      "text": "چی؟"
    },
    {
      "id": 51,
      "start": 4677.52,
      "end": 4679.52,
      "formatted_start": "01:17:57.520",
      "formatted_end": "01:17:59.520",
      "text": "برگ بخوابی"
    },
    {
      "id": 52,
      "start": 4679.52,
      "end": 4681.52,
      "formatted_start": "01:17:59.520",
      "formatted_end": "01:18:01.520",
      "text": "سیزده برگ چار"
    },
    {
      "id": 53,
      "start": 4681.52,
      "end": 4683.52,
      "formatted_start": "01:18:01.520",
      "formatted_end": "01:18:03.520",
      "text": "سیزده اون برگ چار بردم وسترشدم"
    },
    {
      "id": 54,
      "start": 4683.52,
      "end": 4685.52,
      "formatted_start": "01:18:03.520",
      "formatted_end": "01:18:05.520",
      "text": "یه عهده وسترشدم"
    },
    {
      "id": 55,
      "start": 4685.52,
      "end": 4687.52,
      "formatted_start": "01:18:05.520",
      "formatted_end": "01:18:07.520",
      "text": "سر زمین شالی"
    },
    {
      "id": 56,
      "start": 4687.52,
      "end": 4689.52,
      "formatted_start": "01:18:07.520",
      "formatted_end": "01:18:09.520",
      "text": "سر شالی من یه چیز نیست"
    },
    {
      "id": 57,
      "start": 4689.52,
      "end": 4691.52,
      "formatted_start": "01:18:09.520",
      "formatted_end": "01:18:11.520",
      "text": "باعثی تف شد"
    },
    {
      "id": 58,
      "start": 4691.52,
      "end": 4693.52,
      "formatted_start": "01:18:11.520",
      "formatted_end": "01:18:13.520",
      "text": "تف شد سر زمین تملرز کردم"
    },
    {
      "id": 59,
      "start": 4693.52,
      "end": 4697.52,
      "formatted_start": "01:18:13.520",
      "formatted_end": "01:18:17.520",
      "text": "بعد اومدم رفتم دکتور از بسیار شده خدای خدایی"
    },
    {
      "id": 60,
      "start": 4697.52,
      "end": 4699.52,
      "formatted_start": "01:18:17.520",
      "formatted_end": "01:18:19.520",
      "text": "حالا ما این پراموش هم می کنیم از زن شوید"
    },
    {
      "id": 61,
      "start": 4699.52,
      "end": 4700.52,
      "formatted_start": "01:18:19.520",
      "formatted_end": "01:18:20.520",
      "text": "داخلی؟"
    },
    {
      "id": 62,
      "start": 4700.52,
      "end": 4701.52,
      "formatted_start": "01:18:20.520",
      "formatted_end": "01:18:21.520",
      "text": "داخلی کمیشت ما این را"
    },
    {
      "id": 63,
      "start": 4701.52,
      "end": 4702.52,
      "formatted_start": "01:18:21.520",
      "formatted_end": "01:18:22.520",
      "text": "خودت حسینی؟"
    },
    {
      "id": 64,
      "start": 4702.52,
      "end": 4703.52,
      "formatted_start": "01:18:22.520",
      "formatted_end": "01:18:23.520",
      "text": "نه"
    },
    {
      "id": 65,
      "start": 4703.52,
      "end": 4704.52,
      "formatted_start": "01:18:23.520",
      "formatted_end": "01:18:24.520",
      "text": "محسوس؟"
    },
    {
      "id": 66,
      "start": 4704.52,
      "end": 4705.52,
      "formatted_start": "01:18:24.520",
      "formatted_end": "01:18:25.520",
      "text": "محسوس"
    },
    {
      "id": 67,
      "start": 4705.52,
      "end": 4706.52,
      "formatted_start": "01:18:25.520",
      "formatted_end": "01:18:26.520",
      "text": "بله محسوس"
    },
    {
      "id": 68,
      "start": 4706.52,
      "end": 4707.52,
      "formatted_start": "01:18:26.520",
      "formatted_end": "01:18:27.520",
      "text": "آه بله"
    },
    {
      "id": 69,
      "start": 4707.52,
      "end": 4710.52,
      "formatted_start": "01:18:27.520",
      "formatted_end": "01:18:30.520",
      "text": "اون برنامه بستری کرد چهار پنج روز بیمارستان هم میاست"
    },
    {
      "id": 70,
      "start": 4710.52,
      "end": 4711.52,
      "formatted_start": "01:18:30.520",
      "formatted_end": "01:18:31.520",
      "text": "ناسوم ها بستری کرد"
    },
    {
      "id": 71,
      "start": 4711.52,
      "end": 4714.52,
      "formatted_start": "01:18:31.520",
      "formatted_end": "01:18:34.520",
      "text": "بعد کبیر چیزت خوب شد افنادت خوب شد"
    },
    {
      "id": 72,
      "start": 4714.52,
      "end": 4719.52,
      "formatted_start": "01:18:34.520",
      "formatted_end": "01:18:39.520",
      "text": "بله این نامصب همین صرف همین مون که تو الان مونده"
    },
    {
      "id": 73,
      "start": 4719.52,
      "end": 4726.52,
      "formatted_start": "01:18:39.520",
      "formatted_end": "01:18:46.520",
      "text": "بعدشم پرس سینم انگار که یه روغن چربیه مثلا پی آقای میگیم ما"
    },
    {
      "id": 74,
      "start": 4726.52,
      "end": 4729.52,
      "formatted_start": "01:18:46.520",
      "formatted_end": "01:18:49.520",
      "text": "مثلا پی آقای انگار چسپیده به سینم"
    },
    {
      "id": 75,
      "start": 4729.52,
      "end": 4733.52,
      "formatted_start": "01:18:49.520",
      "formatted_end": "01:18:53.520",
      "text": "این مذرک میخوام شب صرفه میزنم خرد میارم"
    },
    {
      "id": 76,
      "start": 4733.52,
      "end": 4735.52,
      "formatted_start": "01:18:53.520",
      "formatted_end": "01:18:55.520",
      "text": "صرفه میزنم خرد میارم"
    },
    {
      "id": 77,
      "start": 4735.52,
      "end": 4739.52,
      "formatted_start": "01:18:55.520",
      "formatted_end": "01:18:59.520",
      "text": "مذرک میخوام روزا یه خرد گونده میاد"
    },
    {
      "id": 78,
      "start": 4739.52,
      "end": 4741.52,
      "formatted_start": "01:18:59.520",
      "formatted_end": "01:19:01.520",
      "text": "خودت سبز میدی؟"
    },
    {
      "id": 79,
      "start": 4741.52,
      "end": 4743.52,
      "formatted_start": "01:19:01.520",
      "formatted_end": "01:19:03.520",
      "text": "آره دیگه سبز سبز میدی"
    },
    {
      "id": 80,
      "start": 4743.52,
      "end": 4746.52,
      "formatted_start": "01:19:03.520",
      "formatted_end": "01:19:06.520",
      "text": "بسیار تسکم کردن اینکه بیمار استفاده اتون"
    },
    {
      "id": 81,
      "start": 4746.52,
      "end": 4751.52,
      "formatted_start": "01:19:06.520",
      "formatted_end": "01:19:11.520",
      "text": "اونوقت که من ریان مشکل نداشت که اونوقت تختاشتن خوب کردن دیگه"
    },
    {
      "id": 82,
      "start": 4751.52,
      "end": 4754.52,
      "formatted_start": "01:19:11.520",
      "formatted_end": "01:19:14.520",
      "text": "نونایی نفتی نمیپرده؟"
    },
    {
      "id": 83,
      "start": 4754.52,
      "end": 4756.52,
      "formatted_start": "01:19:14.520",
      "formatted_end": "01:19:16.520",
      "text": "نه"
    },
    {
      "id": 84,
      "start": 4756.52,
      "end": 4758.52,
      "formatted_start": "01:19:16.520",
      "formatted_end": "01:19:18.520",
      "text": "فقط سرزم شالی میره"
    },
    {
      "id": 85,
      "start": 4758.52,
      "end": 4760.52,
      "formatted_start": "01:19:18.520",
      "formatted_end": "01:19:20.520",
      "text": "نه الان میمونه که همون روز افراد اونجور"
    },
    {
      "id": 86,
      "start": 4760.52,
      "end": 4763.52,
      "formatted_start": "01:19:20.520",
      "formatted_end": "01:19:23.520",
      "text": "اصلا من دو تنباکون نرفته هیچوقت؟"
    },
    {
      "id": 87,
      "start": 4763.52,
      "end": 4765.52,
      "formatted_start": "01:19:23.520",
      "formatted_end": "01:19:25.520",
      "text": "نه"
    },
    {
      "id": 88,
      "start": 4765.52,
      "end": 4771.52,
      "formatted_start": "01:19:25.520",
      "formatted_end": "01:19:31.520",
      "text": "اصلا یکی سیگار بکشه با این اینسته باید تو خونم و تو خانم و تو فدری مادری"
    },
    {
      "id": 89,
      "start": 4771.52,
      "end": 4774.52,
      "formatted_start": "01:19:31.520",
      "formatted_end": "01:19:34.520",
      "text": "کشکیه موتاد و مثلا سیگاری موتاری شوهرم"
    },
    {
      "id": 90,
      "start": 4774.52,
      "end": 4777.02,
      "formatted_start": "01:19:34.520",
      "formatted_end": "01:19:37.020",
      "text": "شوهرم اصلا یه بارم حال دود نیست"
    },
    {
      "id": 91,
      "start": 4777.02,
      "end": 4779.1,
      "formatted_start": "01:19:37.020",
      "formatted_end": "01:19:39.100",
      "text": "که بگی دودش من ازیاد کرده"
    },
    {
      "id": 92,
      "start": 4779.1,
      "end": 4782.06,
      "formatted_start": "01:19:39.100",
      "formatted_end": "01:19:42.060",
      "text": "اسم من همه خانم از محاکوب من دیگه دود نکردم"
    },
    {
      "id": 93,
      "start": 4782.06,
      "end": 4784.94,
      "formatted_start": "01:19:42.060",
      "formatted_end": "01:19:44.940",
      "text": "خشکش میکنه"
    },
    {
      "id": 94,
      "start": 4784.94,
      "end": 4786.8,
      "formatted_start": "01:19:44.940",
      "formatted_end": "01:19:46.800",
      "text": "حالی خوبم دیگه شر"
    },
    {
      "id": 95,
      "start": 4786.8,
      "end": 4791.12,
      "formatted_start": "01:19:46.800",
      "formatted_end": "01:19:51.120",
      "text": "ببخشید من سزادتون دیگه نمیشم"
    },
    {
      "id": 96,
      "start": 4791.12,
      "end": 4791.68,
      "formatted_start": "01:19:51.120",
      "formatted_end": "01:19:51.680",
      "text": "نفذ"
    },
    {
      "id": 97,
      "start": 4791.68,
      "end": 4794.64,
      "formatted_start": "01:19:51.680",
      "formatted_end": "01:19:54.640",
      "text": "آروم آروم"
    },
    {
      "id": 98,
      "start": 4794.64,
      "end": 4797.4,
      "formatted_start": "01:19:54.640",
      "formatted_end": "01:19:57.400",
      "text": "نفذ"
    }
  ],
  "status": "completed"
}