  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11730.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:30.000",
      "text": "از اینجا، با اینکه از اینجا باید بردارید، با اینکه از اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردارید، با اینکه از اینکه بردار"
    },
    {
      "id": 1,
      "start": 11730.0,
      "end": 11738.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:38.000",
      "text": "از این سه بوتی از قرصت نیله دو بوتی هر چی که حد اکثر شده میده برای تونو نوشتم"
    },
    {
      "id": 2,
      "start": 11738.0,
      "end": 11740.0,
      "formatted_start": "03:15:38.000",
      "formatted_end": "03:15:40.000",
      "text": "حد اکثر که بتونو نوشتم"
    },
    {
      "id": 3,
      "start": 11740.0,
      "end": 11742.0,
      "formatted_start": "03:15:40.000",
      "formatted_end": "03:15:42.000",
      "text": "از معاشه اول نوشتم"
    },
    {
      "id": 4,
      "start": 11742.0,
      "end": 11745.0,
      "formatted_start": "03:15:42.000",
      "formatted_end": "03:15:45.000",
      "text": "نوشتم دیگه فردا صبح این انجام باشیم"
    },
    {
      "id": 5,
      "start": 11745.0,
      "end": 11747.0,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:47.000",
      "text": "همینجا ریانه ها"
    },
    {
      "id": 6,
      "start": 11747.0,
      "end": 11749.0,
      "formatted_start": "03:15:47.000",
      "formatted_end": "03:15:49.000",
      "text": "هر جا دوست داریم فردا نمی کنیم"
    },
    {
      "id": 7,
      "start": 11749.0,
      "end": 11751.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:51.000",
      "text": "از معاشه کل ماشه نه"
    },
    {
      "id": 8,
      "start": 11751.0,
      "end": 11752.0,
      "formatted_start": "03:15:51.000",
      "formatted_end": "03:15:52.000",
      "text": "کل کل باشیم"
    },
    {
      "id": 9,
      "start": 11752.0,
      "end": 11753.0,
      "formatted_start": "03:15:52.000",
      "formatted_end": "03:15:53.000",
      "text": "بسیار مردم"
    },
    {
      "id": 10,
      "start": 11753.0,
      "end": 11754.0,
      "formatted_start": "03:15:53.000",
      "formatted_end": "03:15:54.000",
      "text": "بسیار مردم"
    },
    {
      "id": 11,
      "start": 11754.0,
      "end": 11756.0,
      "formatted_start": "03:15:54.000",
      "formatted_end": "03:15:56.000",
      "text": "خوبه همه تون سلامت باشیم"
    },
    {
      "id": 12,
      "start": 11756.0,
      "end": 11757.0,
      "formatted_start": "03:15:56.000",
      "formatted_end": "03:15:57.000",
      "text": "بسیار مردم"
    },
    {
      "id": 13,
      "start": 11757.0,
      "end": 11758.0,
      "formatted_start": "03:15:57.000",
      "formatted_end": "03:15:58.000",
      "text": "سلامت باشیم"
    },
    {
      "id": 14,
      "start": 11758.0,
      "end": 11760.0,
      "formatted_start": "03:15:58.000",
      "formatted_end": "03:16:00.000",
      "text": "مردم در اینجا باید بردارید"
    },
    {
      "id": 15,
      "start": 11760.0,
      "end": 11762.0,
      "formatted_start": "03:16:00.000",
      "formatted_end": "03:16:02.000",
      "text": "و از اینجا باید بردارید"
    },
    {
