  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12302.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:02.000",
      "text": "از این روزه چند تا میخوری؟"
    },
    {
      "id": 1,
      "start": 12302.0,
      "end": 12306.0,
      "formatted_start": "03:25:02.000",
      "formatted_end": "03:25:06.000",
      "text": "از این شبیه که برای همین تو رو روکتن بشیم."
    },
    {
      "id": 2,
      "start": 12306.0,
      "end": 12308.0,
      "formatted_start": "03:25:06.000",
      "formatted_end": "03:25:08.000",
      "text": "من از تشناس جلو گیره می کنم."
    },
    {
      "id": 3,
      "start": 12308.0,
      "end": 12314.0,
      "formatted_start": "03:25:08.000",
      "formatted_end": "03:25:14.000",
      "text": "الان اینو من دویست تا نوشتم، سه ماه، خب دستم واضح، بلی این سه و بیست تا دو ماه شد، اینم که نوت تا بیمه طریق می کنه، یه جور مزخه روی."
    },
    {
      "id": 4,
      "start": 12314.0,
      "end": 12317.0,
      "formatted_start": "03:25:14.000",
      "formatted_end": "03:25:17.000",
      "text": "من از تشنوش جلو گیره بکنم"
    },
    {
      "id": 5,
      "start": 12317.0,
      "end": 12322.0,
      "formatted_start": "03:25:17.000",
      "formatted_end": "03:25:22.000",
      "text": "الان اینو من دویست تا نوشتم سه ماه خب دستم واضعه"
    },
    {
      "id": 6,
      "start": 12322.0,
      "end": 12325.0,
      "formatted_start": "03:25:22.000",
      "formatted_end": "03:25:25.000",
      "text": "ولی اینو سه و بیست تا دو ماه شد"
    },
    {
      "id": 7,
      "start": 12325.0,
      "end": 12330.0,
      "formatted_start": "03:25:25.000",
      "formatted_end": "03:25:30.000",
      "text": "اینم که نوت تا بیمه طریق می کنه یه جور مسخره ای"
    },
    {
      "id": 8,
      "start": 12330.0,
      "end": 12333.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:33.000",
      "text": "حالا اینو اگه کمپرم بنیسته مشکل نداره"
    },
    {
      "id": 9,
      "start": 12333.0,
      "end": 12336.0,
      "formatted_start": "03:25:33.000",
      "formatted_end": "03:25:36.000",
      "text": "چون قرار دکتورم ببینه دوباره اینو برام تجویز کنه"
    },
    {
      "id": 10,
      "start": 12336.0,
      "end": 12338.0,
      "formatted_start": "03:25:36.000",
      "formatted_end": "03:25:38.000",
      "text": "شاید اما اصلا نیاز نماشه تجویز کنه"
    },
    {
      "id": 11,
      "start": 12338.0,
      "end": 12341.0,
      "formatted_start": "03:25:38.000",
      "formatted_end": "03:25:41.000",
      "text": "اون الان مهم نیسته ولی این دوره های خودمو"
    },
    {
      "id": 12,
      "start": 12341.0,
      "end": 12347.0,
      "formatted_start": "03:25:41.000",
      "formatted_end": "03:25:47.000",
      "text": "اگر می توانید باید بخورید توی لیست باشد."
    },
    {
      "id": 13,
      "start": 12347.0,
      "end": 12352.0,
      "formatted_start": "03:25:47.000",
      "formatted_end": "03:25:52.000",
      "text": "اگر دکتر او تجمیز کرد، تو از اون زمانه باید باید بخوریم."
    },
    {
      "id": 14,
      "start": 12352.0,
      "end": 12357.0,
      "formatted_start": "03:25:52.000",
      "formatted_end": "03:25:57.000",
      "text": "آره، اگر از من زنگ بزنید، همون مصخص را تنبیل کنید."
    },
    {
      "id": 15,
      "start": 12357.0,
      "end": 12361.0,
      "formatted_start": "03:25:57.000",
      "formatted_end": "03:26:01.000",
      "text": "اگر باید ندارید، باید باید این کار را از همه اینجا بگیریم."
    },
    {
      "id": 16,
      "start": 12361.0,
      "end": 12365.0,
      "formatted_start": "03:26:01.000",
      "formatted_end": "03:26:05.000",
      "text": "اگر باید این کار را از همه اینجا بگیریم، باید باید این کار را از همه اینجا بگیریم."
    },
    {
      "id": 17,
      "start": 12365.0,
      "end": 12369.0,
      "formatted_start": "03:26:05.000",
      "formatted_end": "03:26:09.000",
      "text": "اگر باید این کار را از همه اینجا بگیریم، باید باید این کار را از همه اینجا بگیریم."
    },
    {
      "id": 18,
      "start": 12369.0,
      "end": 12373.0,
      "formatted_start": "03:26:09.000",
      "formatted_end": "03:26:13.000",
      "text": "اگر باید این کار را از همه اینجا بگیریم، باید باید این کار را از همه اینجا بگیریم."
    },
    {
      "id": 19,
      "start": 12373.0,
      "end": 12378.86,
      "formatted_start": "03:26:13.000",
      "formatted_end": "03:26:18.860",
      "text": "اینکه اینکه مریضا و مریضا رو سر میدونم یا ما اینو همه رو نداریم"
    },
    {
      "id": 20,
      "start": 12378.86,
      "end": 12380.06,
      "formatted_start": "03:26:18.860",
      "formatted_end": "03:26:20.060",
      "text": "سبیم از همین برگزی"
    },
    {
      "id": 21,
      "start": 12380.06,
      "end": 12383.3,
      "formatted_start": "03:26:20.060",
      "formatted_end": "03:26:23.300",
      "text": "خب بعد برگشت نداشتن از کجا بگیرن؟"
    },
    {
      "id": 22,
      "start": 12383.3,
      "end": 12383.72,
      "formatted_start": "03:26:23.300",
      "formatted_end": "03:26:23.720",
      "text": "نمیخواد"
    },
    {
      "id": 23,
      "start": 12383.72,
      "end": 12385.0,
      "formatted_start": "03:26:23.720",
      "formatted_end": "03:26:25.000",
      "text": "نمیخواد"
    },
    {
      "id": 24,
      "start": 12385.0,
      "end": 12391.0,
      "formatted_start": "03:26:25.000",
      "formatted_end": "03:26:31.000",
      "text": "رامیان شما تعداد بوششش نیستیدی نه؟"
    },
    {
      "id": 25,
      "start": 12391.74,
      "end": 12392.52,
      "formatted_start": "03:26:31.740",
      "formatted_end": "03:26:32.520",
      "text": "نمیشه"
    },
    {
      "id": 26,
      "start": 12392.52,
      "end": 12396.92,
      "formatted_start": "03:26:32.520",
      "formatted_end": "03:26:36.920",
      "text": "خب ببین تعداد بوششش جز رامیان نمیشه"
    },
    {
      "id": 27,
      "start": 12396.92,
      "end": 12399.6,
      "formatted_start": "03:26:36.920",
      "formatted_end": "03:26:39.600",
      "text": "چرا فکر کنم درش رامیانه ببینم؟"
    },
    {
      "id": 28,
      "start": 12399.6,
      "end": 12403.6,
      "formatted_start": "03:26:39.600",
      "formatted_end": "03:26:43.600",
      "text": "همچنان مریض از اونها که آزمایش میگیره کل کامل میگیره"
    },
    {
      "id": 29,
      "start": 12403.6,
      "end": 12405.74,
      "formatted_start": "03:26:43.600",
      "formatted_end": "03:26:45.740",
      "text": "از خودشون به خسته رو اینجا انجام بدم"
    },
    {
      "id": 30,
      "start": 12405.74,
      "end": 12407.42,
      "formatted_start": "03:26:45.740",
      "formatted_end": "03:26:47.420",
      "text": "یا برام فراموی انجام بیدن"
    },
    {
      "id": 31,
      "start": 12407.42,
      "end": 12410.32,
      "formatted_start": "03:26:47.420",
      "formatted_end": "03:26:50.320",
      "text": "شما یه سری قب گرفتن"
    },
    {
      "id": 32,
      "start": 12410.32,
      "end": 12412.64,
      "formatted_start": "03:26:50.320",
      "formatted_end": "03:26:52.640",
      "text": "گفتن که آزمایش رو اینجا دستباش بده"
    },
    {
      "id": 33,
      "start": 12412.64,
      "end": 12414.06,
      "formatted_start": "03:26:52.640",
      "formatted_end": "03:26:54.060",
      "text": "ادنیم و خورای رو میده و اینا"
    },
    {
      "id": 34,
      "start": 12414.06,
      "end": 12416.86,
      "formatted_start": "03:26:54.060",
      "formatted_end": "03:26:56.860",
      "text": "بعد من افتن آزاد انگه بر گرفتن"
    },
    {
      "id": 35,
      "start": 12416.86,
      "end": 12419.14,
      "formatted_start": "03:26:56.860",
      "formatted_end": "03:26:59.140",
      "text": "اونو نیمون دونن چقدر نزینه شد"
    },
    {
      "id": 36,
      "start": 12419.14,
      "end": 12420.78,
      "formatted_start": "03:26:59.140",
      "formatted_end": "03:27:00.780",
      "text": "سر میگه میشه اصلا نازم نیست"
    },
    {
      "id": 37,
      "start": 12420.78,
      "end": 12421.82,
      "formatted_start": "03:27:00.780",
      "formatted_end": "03:27:01.820",
      "text": "اصلا نازم نیست"
    },
    {
      "id": 38,
      "start": 12421.82,
      "end": 12426.82,
      "formatted_start": "03:27:01.820",
      "formatted_end": "03:27:06.820",
      "text": "برای سرسه هم اونو نمیتونم برای مایی فردان قدر داروی من این میشه دیگه اونو نرسیم"
    },
    {
      "id": 39,
      "start": 12426.82,
      "end": 12428.82,
      "formatted_start": "03:27:06.820",
      "formatted_end": "03:27:08.820",
      "text": "نمیخواد الکین هم باید برزو استرسی کنیم"
    },
    {
      "id": 40,
      "start": 12428.82,
      "end": 12430.82,
      "formatted_start": "03:27:08.820",
      "formatted_end": "03:27:10.820",
      "text": "یه وقت لازم باشه من بهتونم"
    },
    {
      "id": 41,
      "start": 12430.82,
      "end": 12434.82,
      "formatted_start": "03:27:10.820",
      "formatted_end": "03:27:14.820",
      "text": "اما همین طوبو رو من عمل کردم دروار چهار ساقون ساقون تا اونقدر حزینه باشه"
    },
    {
      "id": 42,
      "start": 12434.82,
      "end": 12439.82,
      "formatted_start": "03:27:14.820",
      "formatted_end": "03:27:19.820",
      "text": "برای آدمی فارگر برای آدمی سنگی نیست"
    },
    {
      "id": 43,
      "start": 12439.82,
      "end": 12442.82,
      "formatted_start": "03:27:19.820",
      "formatted_end": "03:27:22.820",
      "text": "آن جوهی خیلی سنگی نیست"
    },
    {
      "id": 44,
      "start": 12442.82,
      "end": 12444.82,
      "formatted_start": "03:27:22.820",
      "formatted_end": "03:27:24.820",
      "text": "فراموش بگو"
    },
    {
      "id": 45,
      "start": 12444.82,
      "end": 12447.82,
      "formatted_start": "03:27:24.820",
      "formatted_end": "03:27:27.820",
      "text": "پام شخوایی جان"
    },
    {
      "id": 46,
      "start": 12451.82,
      "end": 12481.82,
      "formatted_start": "03:27:31.820",
      "formatted_end": "03:28:01.820",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 47,
      "start": 12481.82,
      "end": 12484.82,
      "formatted_start": "03:28:01.820",
      "formatted_end": "03:28:04.820",
      "text": "با تیف ها بسیار ماده بودش روش میاد"
    },
    {
      "id": 48,
      "start": 12484.82,
      "end": 12485.82,
      "formatted_start": "03:28:04.820",
      "formatted_end": "03:28:05.820",
      "text": "چشم"
    },
    {
      "id": 49,
      "start": 12485.82,
      "end": 12487.82,
      "formatted_start": "03:28:05.820",
      "formatted_end": "03:28:07.820",
      "text": "باید برداریم"
    },
    {
      "id": 50,
      "start": 12487.82,
      "end": 12489.82,
      "formatted_start": "03:28:07.820",
      "formatted_end": "03:28:09.820",
      "text": "بسیار ماده بود"
    },
    {
      "id": 51,
      "start": 12489.82,
      "end": 12491.82,
      "formatted_start": "03:28:09.820",
      "formatted_end": "03:28:11.820",
      "text": "بسیار ماده بود"
    },
    {
      "id": 52,
      "start": 12491.82,
      "end": 12494.82,
      "formatted_start": "03:28:11.820",
      "formatted_end": "03:28:14.820",
      "text": "آنها میخواستم اونجا مازی کنم"
    },
    {
      "id": 53,
      "start": 12494.82,
      "end": 12496.82,
      "formatted_start": "03:28:14.820",
      "formatted_end": "03:28:16.820",
      "text": "بلکه باید بردارشون میگی تو را از هر دیگر کنم"
    },
    {
      "id": 54,
      "start": 12496.82,
      "end": 12497.82,
      "formatted_start": "03:28:16.820",
      "formatted_end": "03:28:17.820",
      "text": "بسیار بردار"
    },
    {
      "id": 55,
      "start": 12497.82,
      "end": 12499.82,
      "formatted_start": "03:28:17.820",
      "formatted_end": "03:28:19.820",
      "text": "باید بردارشون همونجایی بردارم"
    },
    {
      "id": 56,
      "start": 12499.82,
      "end": 12501.82,
      "formatted_start": "03:28:19.820",
      "formatted_end": "03:28:21.820",
      "text": "باید بردارشون دو دو سه دانه برسیم"
    },
    {
      "id": 57,
      "start": 12501.82,
      "end": 12503.82,
      "formatted_start": "03:28:21.820",
      "formatted_end": "03:28:23.820",
      "text": "بسیار ماده بردارشون شبه کنید"
    },
    {
      "id": 58,
      "start": 12503.82,
      "end": 12505.82,
      "formatted_start": "03:28:23.820",
      "formatted_end": "03:28:25.820",
      "text": "بسیار ماده بردارشون شبه کنید"
    },
    {
      "id": 59,
      "start": 12505.82,
      "end": 12507.82,
      "formatted_start": "03:28:25.820",
      "formatted_end": "03:28:27.820",
      "text": "از اینکه درست داریم برامون داده بودم"
    },
    {
      "id": 60,
      "start": 12507.82,
      "end": 12510.82,
      "formatted_start": "03:28:27.820",
      "formatted_end": "03:28:30.820",
      "text": "کنید که آزمایشتون هم نرمیده"
    },
    {
      "id": 61,
      "start": 12510.82,
      "end": 12514.82,
      "formatted_start": "03:28:30.820",
      "formatted_end": "03:28:34.820",
      "text": "رفته بودم مسافرت دیگه همونجا"
    },
    {
      "id": 62,
      "start": 12514.82,
      "end": 12518.82,
      "formatted_start": "03:28:34.820",
      "formatted_end": "03:28:38.820",
      "text": "مثلا قرص آهنگ نوشتن آیرون مکس رو شروع کردم"
    },
    {
      "id": 63,
      "start": 12518.82,
      "end": 12520.82,
      "formatted_start": "03:28:38.820",
      "formatted_end": "03:28:40.820",
      "text": "حالا یک ماه همین فراموش"
    },
    {
      "id": 64,
      "start": 12520.82,
      "end": 12521.82,
      "formatted_start": "03:28:40.820",
      "formatted_end": "03:28:41.820",
      "text": "آن پول باید بزنید"
    },
    {
      "id": 65,
      "start": 12521.82,
      "end": 12523.82,
      "formatted_start": "03:28:41.820",
      "formatted_end": "03:28:43.820",
      "text": "خب الان فقط شهرم همینه گفت"
    },
    {
      "id": 66,
      "start": 12523.82,
      "end": 12525.82,
      "formatted_start": "03:28:43.820",
      "formatted_end": "03:28:45.820",
      "text": "من یه روز از خواب بیدار شدم"
    },
    {
      "id": 67,
      "start": 12525.82,
      "end": 12527.82,
      "formatted_start": "03:28:45.820",
      "formatted_end": "03:28:47.820",
      "text": "یعنی هر صبح بیدار شدم"
    },
    {
      "id": 68,
      "start": 12527.82,
      "end": 12528.82,
      "formatted_start": "03:28:47.820",
      "formatted_end": "03:28:48.820",
      "text": "دوباره"
    },
    {
      "id": 69,
      "start": 12528.82,
      "end": 12532.82,
      "formatted_start": "03:28:48.820",
      "formatted_end": "03:28:52.820",
      "text": "البته این آزمایش برای بینیم رفتم به ده رسیده بود"
    },
    {
      "id": 70,
      "start": 12532.82,
      "end": 12534.82,
      "formatted_start": "03:28:52.820",
      "formatted_end": "03:28:54.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 71,
      "start": 12534.82,
      "end": 12536.82,
      "formatted_start": "03:28:54.820",
      "formatted_end": "03:28:56.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 72,
      "start": 12536.82,
      "end": 12538.82,
      "formatted_start": "03:28:56.820",
      "formatted_end": "03:28:58.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 73,
      "start": 12538.82,
      "end": 12540.82,
      "formatted_start": "03:28:58.820",
      "formatted_end": "03:29:00.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 74,
      "start": 12540.82,
      "end": 12542.82,
      "formatted_start": "03:29:00.820",
      "formatted_end": "03:29:02.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 75,
      "start": 12542.82,
      "end": 12544.82,
      "formatted_start": "03:29:02.820",
      "formatted_end": "03:29:04.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 76,
      "start": 12544.82,
      "end": 12546.82,
      "formatted_start": "03:29:04.820",
      "formatted_end": "03:29:06.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 77,
      "start": 12546.82,
      "end": 12548.82,
      "formatted_start": "03:29:06.820",
      "formatted_end": "03:29:08.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 78,
      "start": 12548.82,
      "end": 12550.82,
      "formatted_start": "03:29:08.820",
      "formatted_end": "03:29:10.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 79,
      "start": 12550.82,
      "end": 12552.82,
      "formatted_start": "03:29:10.820",
      "formatted_end": "03:29:12.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 80,
      "start": 12552.82,
      "end": 12554.82,
      "formatted_start": "03:29:12.820",
      "formatted_end": "03:29:14.820",
      "text": "از این مردم ازش نمیدونی؟"
    },
    {
      "id": 81,
      "start": 12554.82,
      "end": 12556.82,
      "formatted_start": "03:29:14.820",
      "formatted_end": "03:29:16.820",
      "text": "چند تا میخورید ار روز؟"
    },
    {
      "id": 82,
      "start": 12556.82,
      "end": 12560.82,
      "formatted_start": "03:29:16.820",
      "formatted_end": "03:29:20.820",
      "text": "ساهم هر هشت ساعت به من گفتید حتی اگه شد دوتا هم بخود دوتا هم خوردم"
    },
    {
      "id": 83,
      "start": 12560.82,
      "end": 12562.82,
      "formatted_start": "03:29:20.820",
      "formatted_end": "03:29:22.820",
      "text": "میون نداشته؟"
    },
    {
      "id": 84,
      "start": 12562.82,
      "end": 12563.82,
      "formatted_start": "03:29:22.820",
      "formatted_end": "03:29:23.820",
      "text": "جا"
    },
    {
      "id": 85,
      "start": 12563.82,
      "end": 12564.82,
      "formatted_start": "03:29:23.820",
      "formatted_end": "03:29:24.820",
      "text": "میون؟"
    },
    {
      "id": 86,
      "start": 12564.82,
      "end": 12565.82,
      "formatted_start": "03:29:24.820",
      "formatted_end": "03:29:25.820",
      "text": "قرصه چیه؟"
    },
    {
      "id": 87,
      "start": 12565.82,
      "end": 12566.82,
      "formatted_start": "03:29:25.820",
      "formatted_end": "03:29:26.820",
      "text": "نه نمیدونم"
    },
    {
      "id": 88,
      "start": 12566.82,
      "end": 12568.82,
      "formatted_start": "03:29:26.820",
      "formatted_end": "03:29:28.820",
      "text": "رهم توده فیلو میشه دیگه داشت؟"
    },
    {
      "id": 89,
      "start": 12568.82,
      "end": 12572.82,
      "formatted_start": "03:29:28.820",
      "formatted_end": "03:29:32.820",
      "text": "نه چیز بود فقط زخمتش خیلی زیاد شده برای از کورتاج های اینو"
    },
    {
      "id": 90,
      "start": 12572.82,
      "end": 12573.82,
      "formatted_start": "03:29:32.820",
      "formatted_end": "03:29:33.820",
      "text": "برای کورتاج؟"
    },
    {
      "id": 91,
      "start": 12573.82,
      "end": 12574.82,
      "formatted_start": "03:29:33.820",
      "formatted_end": "03:29:34.820",
      "text": "آره"
    },
    {
      "id": 92,
      "start": 12574.82,
      "end": 12575.82,
      "formatted_start": "03:29:34.820",
      "formatted_end": "03:29:35.820",
      "text": "برای کورتاج که برای نازد بشه؟"
    },
    {
      "id": 93,
      "start": 12575.82,
      "end": 12582.66,
      "formatted_start": "03:29:35.820",
      "formatted_end": "03:29:42.660",
      "text": "نمیدونم دقیقا یک ماه بعد از اینکه کورتاش کردم من خون رزی هایی داشتم که به حد مرد میرسیدم دیگه"
    },
    {
      "id": 94,
      "start": 12582.66,
      "end": 12583.94,
      "formatted_start": "03:29:42.660",
      "formatted_end": "03:29:43.940",
      "text": "الدی مو چونی بخوری؟"
    },
    {
      "id": 95,
      "start": 12583.94,
      "end": 12585.46,
      "formatted_start": "03:29:43.940",
      "formatted_end": "03:29:45.460",
      "text": "اصلا نمیتونم بخورم"
    },
    {
      "id": 96,
      "start": 12585.46,
      "end": 12590.9,
      "formatted_start": "03:29:45.460",
      "formatted_end": "03:29:50.900",
      "text": "یعنی سر این زایمان هم هم که چهار ماه خون رزی کردم چون الدی نمیخوردم نمیتونستم کنتر بشم"
    },
    {
      "id": 97,
      "start": 12590.9,
      "end": 12592.86,
      "formatted_start": "03:29:50.900",
      "formatted_end": "03:29:52.860",
      "text": "خارجه هم برد نمیسازه؟"
    },
    {
      "id": 98,
      "start": 12592.86,
      "end": 12597.94,
      "formatted_start": "03:29:52.860",
      "formatted_end": "03:29:57.940",
      "text": "اصلا نمیدونم کلن یه جوری میشم امسا مردها یه گوشی خونه میافتم"
    },
    {
      "id": 99,
      "start": 12597.94,
      "end": 12599.34,
      "formatted_start": "03:29:57.940",
      "formatted_end": "03:29:59.340",
      "text": "شبا خورده"
    }
  ],
  "status": "completed"
}