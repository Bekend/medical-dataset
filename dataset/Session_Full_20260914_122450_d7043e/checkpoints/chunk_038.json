  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11428.62,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:28.620",
      "text": "پیش نموهایی که هفت خشکه، حساسیت دماغ خود، دخون دماغ میرونه، بعد یه آنتیب ترین میکنه، نمیخواستم شب رو بخور، اشتهاد رو زیاد میکنه، بعد باز در یک گوگه زدن، پرس اصابه، این یکم آروم میکنه، از عوارضش ما استفاده میکنیم، افضایش اشتهاد میده، یکم هم آروم ترتون میکنه، داروی قوی بابزدگیه، خدا نیست که شب یه تونه بخور، یک ساعت بعد خواب."
    },
    {
      "id": 1,
      "start": 11428.62,
      "end": 11435.62,
      "formatted_start": "03:10:28.620",
      "formatted_end": "03:10:35.620",
      "text": "اگر این دربا پرفرانالت ادامه میده بر من، این دیگه از تنخواهاناتی رو نمیسلم"
    },
    {
      "id": 2,
      "start": 11435.62,
      "end": 11442.62,
      "formatted_start": "03:10:35.620",
      "formatted_end": "03:10:42.620",
      "text": "اینه پیدا چطور رو میده؟ خوب؟"
    },
    {
      "id": 3,
      "start": 11442.62,
      "end": 11444.62,
      "formatted_start": "03:10:42.620",
      "formatted_end": "03:10:44.620",
      "text": "نه، زندگی هست"
    },
    {
      "id": 4,
      "start": 11444.62,
      "end": 11450.62,
      "formatted_start": "03:10:44.620",
      "formatted_end": "03:10:50.620",
      "text": "همچنین هم چی کنی؟"
    },
    {
      "id": 5,
      "start": 11450.62,
      "end": 11456.62,
      "formatted_start": "03:10:50.620",
      "formatted_end": "03:10:56.620",
      "text": "اگر همه چی خوب بود، دیگه همه بستاریزش برمیده دلیش کنی"
    },
    {
      "id": 6,
      "start": 11456.62,
      "end": 11458.62,
      "formatted_start": "03:10:56.620",
      "formatted_end": "03:10:58.620",
      "text": "از اینجا باید برداری کنیم"
    },
    {
      "id": 7,
      "start": 11458.62,
      "end": 11460.62,
      "formatted_start": "03:10:58.620",
      "formatted_end": "03:11:00.620",
      "text": "این خودش داد مثلا ناراحته"
    },
    {
      "id": 8,
      "start": 11460.62,
      "end": 11462.62,
      "formatted_start": "03:11:00.620",
      "formatted_end": "03:11:02.620",
      "text": "میتونی من لاغرم فلانم"
    },
    {
      "id": 9,
      "start": 11462.62,
      "end": 11464.62,
      "formatted_start": "03:11:02.620",
      "formatted_end": "03:11:04.620",
      "text": "به وقتش چارمش"
    },
    {
      "id": 10,
      "start": 11464.62,
      "end": 11466.62,
      "formatted_start": "03:11:04.620",
      "formatted_end": "03:11:06.620",
      "text": "باید برداریم"
    },
    {
      "id": 11,
      "start": 11466.62,
      "end": 11468.62,
      "formatted_start": "03:11:06.620",
      "formatted_end": "03:11:08.620",
      "text": "الان همون میدونیم لاغرش"
    },
    {
      "id": 12,
      "start": 11468.62,
      "end": 11470.62,
      "formatted_start": "03:11:08.620",
      "formatted_end": "03:11:10.620",
      "text": "بهش میگن هم"
    },
    {
      "id": 13,
      "start": 11470.62,
      "end": 11472.62,
      "formatted_start": "03:11:10.620",
      "formatted_end": "03:11:12.620",
      "text": "اشتعاش چطوره؟"
    },
    {
      "id": 14,
      "start": 11472.62,
      "end": 11474.62,
      "formatted_start": "03:11:12.620",
      "formatted_end": "03:11:14.620",
      "text": "اشتعاش کم اشتعاهه"
    },
    {
      "id": 15,
      "start": 11474.62,
      "end": 11476.62,
      "formatted_start": "03:11:14.620",
      "formatted_end": "03:11:16.620",
      "text": "مثلا اشتعاه ندارم"
    },
    {
      "id": 16,
      "start": 11476.62,
      "end": 11478.62,
      "formatted_start": "03:11:16.620",
      "formatted_end": "03:11:18.620",
      "text": "زین کم صبح بخوره"
    },
    {
      "id": 17,
      "start": 11478.62,
      "end": 11480.62,
      "formatted_start": "03:11:18.620",
      "formatted_end": "03:11:20.620",
      "text": "اتفاق دوتو بهت داده"
    },
    {
      "id": 18,
      "start": 11480.62,
      "end": 11482.62,
      "formatted_start": "03:11:20.620",
      "formatted_end": "03:11:22.620",
      "text": "اصلا قهوه ایه"
    },
    {
      "id": 19,
      "start": 11482.62,
      "end": 11484.62,
      "formatted_start": "03:11:22.620",
      "formatted_end": "03:11:24.620",
      "text": "او یه موقع داره یه موقع بزرگ بزن"
    },
    {
      "id": 20,
      "start": 11484.62,
      "end": 11490.62,
      "formatted_start": "03:11:24.620",
      "formatted_end": "03:11:30.620",
      "text": "این هم برد نوشتم. صبح به صبح این موهد هم جلوی دیدششون میگه."
    },
    {
      "id": 21,
      "start": 11490.62,
      "end": 11493.62,
      "formatted_start": "03:11:30.620",
      "formatted_end": "03:11:33.620",
      "text": "همین دیدششون. با ترین گیر همش داده."
    },
    {
      "id": 22,
      "start": 11493.62,
      "end": 11497.62,
      "formatted_start": "03:11:33.620",
      "formatted_end": "03:11:37.620",
      "text": "این هم سی تا نوشتم جا. آزاده دیده خیلی برم."
    },
    {
      "id": 23,
      "start": 11506.62,
      "end": 11508.62,
      "formatted_start": "03:11:46.620",
      "formatted_end": "03:11:48.620",
      "text": "خانم تو برای خدا آزاده ایش چیز آمده؟"
    },
    {
      "id": 24,
      "start": 11508.62,
      "end": 11510.62,
      "formatted_start": "03:11:48.620",
      "formatted_end": "03:11:50.620",
      "text": "آره بله خانم بگوشید سبیمه دهی داری."
    },
    {
      "id": 25,
      "start": 11510.62,
      "end": 11512.62,
      "formatted_start": "03:11:50.620",
      "formatted_end": "03:11:52.620",
      "text": "آره بله بگوشید شب میکنه برای خانم."
    },
    {
      "id": 26,
      "start": 11512.62,
      "end": 11542.62,
      "formatted_start": "03:11:52.620",
      "formatted_end": "03:12:22.620",
      "text": "برای اینکه از اینکه باید برداریم باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای اینکه باید برداریم برای"
    },
    {
      "id": 27,
      "start": 11542.62,
      "end": 11547.62,
      "formatted_start": "03:12:22.620",
      "formatted_end": "03:12:27.620",
      "text": "از اینجورت میبودید که یک دیگه بعد خودشون بیاد"
    },
    {
      "id": 28,
      "start": 11547.62,
      "end": 11549.62,
      "formatted_start": "03:12:27.620",
      "formatted_end": "03:12:29.620",
      "text": "از اینجورت هم پرس کرده بود. اینجورت هم بود."
    },
    {
      "id": 29,
      "start": 11549.62,
      "end": 11551.62,
      "formatted_start": "03:12:29.620",
      "formatted_end": "03:12:31.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 30,
      "start": 11551.62,
      "end": 11553.62,
      "formatted_start": "03:12:31.620",
      "formatted_end": "03:12:33.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 31,
      "start": 11553.62,
      "end": 11555.62,
      "formatted_start": "03:12:33.620",
      "formatted_end": "03:12:35.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 32,
      "start": 11555.62,
      "end": 11557.62,
      "formatted_start": "03:12:35.620",
      "formatted_end": "03:12:37.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 33,
      "start": 11557.62,
      "end": 11559.62,
      "formatted_start": "03:12:37.620",
      "formatted_end": "03:12:39.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 34,
      "start": 11559.62,
      "end": 11561.62,
      "formatted_start": "03:12:39.620",
      "formatted_end": "03:12:41.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 35,
      "start": 11561.62,
      "end": 11563.62,
      "formatted_start": "03:12:41.620",
      "formatted_end": "03:12:43.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 36,
      "start": 11563.62,
      "end": 11565.62,
      "formatted_start": "03:12:43.620",
      "formatted_end": "03:12:45.620",
      "text": "اینجورت هم بود. اینجورت هم بود."
    },
    {
      "id": 37,
      "start": 11565.62,
      "end": 11566.62,
      "formatted_start": "03:12:45.620",
      "formatted_end": "03:12:46.620",
      "text": "خوب شد؟"
    },
    {
      "id": 38,
      "start": 11566.62,
      "end": 11569.62,
      "formatted_start": "03:12:46.620",
      "formatted_end": "03:12:49.620",
      "text": "خوبه، کار هست داره، این شالی ها دور داشته باشه"
    },
    {
      "id": 39,
      "start": 11571.62,
      "end": 11572.62,
      "formatted_start": "03:12:51.620",
      "formatted_end": "03:12:52.620",
      "text": "چیان چی خواهد؟"
    },
    {
      "id": 40,
      "start": 11572.62,
      "end": 11576.62,
      "formatted_start": "03:12:52.620",
      "formatted_end": "03:12:56.620",
      "text": "سلامتی، من امروز ایچین نرخودم، بودم بازمانش بودم، اولاد دیگه"
    },
    {
      "id": 41,
      "start": 11576.62,
      "end": 11579.62,
      "formatted_start": "03:12:56.620",
      "formatted_end": "03:12:59.620",
      "text": "خب چه بخواهیم؟ ایچین نرخودی باید بازمانش باید برده؟"
    },
    {
      "id": 42,
      "start": 11579.62,
      "end": 11582.62,
      "formatted_start": "03:12:59.620",
      "formatted_end": "03:13:02.620",
      "text": "خبتن خب، این زیاد نشتن نشتن"
    },
    {
      "id": 43,
      "start": 11582.62,
      "end": 11583.62,
      "formatted_start": "03:13:02.620",
      "formatted_end": "03:13:03.620",
      "text": "تازه اومده ای؟"
    },
    {
      "id": 44,
      "start": 11583.62,
      "end": 11584.62,
      "formatted_start": "03:13:03.620",
      "formatted_end": "03:13:04.620",
      "text": "آره تازه اومده"
    },
    {
      "id": 45,
      "start": 11585.62,
      "end": 11588.62,
      "formatted_start": "03:13:05.620",
      "formatted_end": "03:13:08.620",
      "text": "چون برقا رفته و فکر کردم اینجا برقا مرد"
    },
    {
      "id": 46,
      "start": 11588.62,
      "end": 11590.62,
      "formatted_start": "03:13:08.620",
      "formatted_end": "03:13:10.620",
      "text": "از اینجا باید باید برداریم."
    },
    {
      "id": 47,
      "start": 11590.62,
      "end": 11592.62,
      "formatted_start": "03:13:10.620",
      "formatted_end": "03:13:12.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 48,
      "start": 11592.62,
      "end": 11594.62,
      "formatted_start": "03:13:12.620",
      "formatted_end": "03:13:14.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 49,
      "start": 11594.62,
      "end": 11596.62,
      "formatted_start": "03:13:14.620",
      "formatted_end": "03:13:16.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 50,
      "start": 11596.62,
      "end": 11598.62,
      "formatted_start": "03:13:16.620",
      "formatted_end": "03:13:18.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 51,
      "start": 11598.62,
      "end": 11600.62,
      "formatted_start": "03:13:18.620",
      "formatted_end": "03:13:20.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 52,
      "start": 11600.62,
      "end": 11602.62,
      "formatted_start": "03:13:20.620",
      "formatted_end": "03:13:22.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 53,
      "start": 11602.62,
      "end": 11604.62,
      "formatted_start": "03:13:22.620",
      "formatted_end": "03:13:24.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 54,
      "start": 11604.62,
      "end": 11606.62,
      "formatted_start": "03:13:24.620",
      "formatted_end": "03:13:26.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 55,
      "start": 11606.62,
      "end": 11608.62,
      "formatted_start": "03:13:26.620",
      "formatted_end": "03:13:28.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 56,
      "start": 11608.62,
      "end": 11610.62,
      "formatted_start": "03:13:28.620",
      "formatted_end": "03:13:30.620",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 57,
      "start": 11610.62,
      "end": 11612.62,
      "formatted_start": "03:13:30.620",
      "formatted_end": "03:13:32.620",
      "text": "نه، نه بسیاری، نه بسیاری"
    },
    {
      "id": 58,
      "start": 11612.62,
      "end": 11614.62,
      "formatted_start": "03:13:32.620",
      "formatted_end": "03:13:34.620",
      "text": "این چه کاریه؟"
    },
    {
      "id": 59,
      "start": 11614.62,
      "end": 11617.62,
      "formatted_start": "03:13:34.620",
      "formatted_end": "03:13:37.620",
      "text": "اهمیدم دو وقت سرمایه کنیم که بیمه نداره، تمام شده"
    },
    {
      "id": 60,
      "start": 11617.62,
      "end": 11621.62,
      "formatted_start": "03:13:37.620",
      "formatted_end": "03:13:41.620",
      "text": "مثلا بگری، مثلا بگری، پول باید بپرده"
    },
    {
      "id": 61,
      "start": 11621.62,
      "end": 11623.62,
      "formatted_start": "03:13:41.620",
      "formatted_end": "03:13:43.620",
      "text": "آها، بیمت مشکل خورده بود"
    },
    {
      "id": 62,
      "start": 11623.62,
      "end": 11624.62,
      "formatted_start": "03:13:43.620",
      "formatted_end": "03:13:44.620",
      "text": "آره، بیمه ما"
    },
    {
      "id": 63,
      "start": 11624.62,
      "end": 11625.62,
      "formatted_start": "03:13:44.620",
      "formatted_end": "03:13:45.620",
      "text": "درست شد بیمتون؟"
    },
    {
      "id": 64,
      "start": 11625.62,
      "end": 11627.62,
      "formatted_start": "03:13:45.620",
      "formatted_end": "03:13:47.620",
      "text": "تازه درست شده ایم"
    },
    {
      "id": 65,
      "start": 11627.62,
      "end": 11630.62,
      "formatted_start": "03:13:47.620",
      "formatted_end": "03:13:50.620",
      "text": "بیمتون خراب شده بود، برای چین جیو شده بود؟"
    },
    {
      "id": 66,
      "start": 11630.62,
      "end": 11632.62,
      "formatted_start": "03:13:50.620",
      "formatted_end": "03:13:52.620",
      "text": "نمیدونم"
    },
    {
      "id": 67,
      "start": 11632.62,
      "end": 11634.62,
      "formatted_start": "03:13:52.620",
      "formatted_end": "03:13:54.620",
      "text": "آقای رفتی درست کرده؟"
    },
    {
      "id": 68,
      "start": 11634.62,
      "end": 11636.62,
      "formatted_start": "03:13:54.620",
      "formatted_end": "03:13:56.620",
      "text": "اینجا از پایشتر داره اونجا"
    },
    {
      "id": 69,
      "start": 11636.62,
      "end": 11638.62,
      "formatted_start": "03:13:56.620",
      "formatted_end": "03:13:58.620",
      "text": "شهر رو داره؟"
    },
    {
      "id": 70,
      "start": 11638.62,
      "end": 11640.62,
      "formatted_start": "03:13:58.620",
      "formatted_end": "03:14:00.620",
      "text": "نه اونجا"
    },
    {
      "id": 71,
      "start": 11640.62,
      "end": 11642.62,
      "formatted_start": "03:14:00.620",
      "formatted_end": "03:14:02.620",
      "text": "کوچه راپا"
    },
    {
      "id": 72,
      "start": 11642.62,
      "end": 11644.62,
      "formatted_start": "03:14:02.620",
      "formatted_end": "03:14:04.620",
      "text": "اونجا از اون دختر چه کرده"
    },
    {
      "id": 73,
      "start": 11644.62,
      "end": 11646.62,
      "formatted_start": "03:14:04.620",
      "formatted_end": "03:14:06.620",
      "text": "خواهد بزنه یه پولی ببرم برون بدم"
    },
    {
      "id": 74,
      "start": 11646.62,
      "end": 11648.62,
      "formatted_start": "03:14:06.620",
      "formatted_end": "03:14:08.620",
      "text": "پول نداشتون مورد"
    },
    {
      "id": 75,
      "start": 11648.62,
      "end": 11650.62,
      "formatted_start": "03:14:08.620",
      "formatted_end": "03:14:10.620",
      "text": "ببینیم بیتو باشم"
    },
    {
      "id": 76,
      "start": 11650.62,
      "end": 11652.62,
      "formatted_start": "03:14:10.620",
      "formatted_end": "03:14:12.620",
      "text": "از برونو که نفتر"
    },
    {
      "id": 77,
      "start": 11652.62,
      "end": 11654.62,
      "formatted_start": "03:14:12.620",
      "formatted_end": "03:14:14.620",
      "text": "هر روز پردن برزم ببرم"
    },
    {
      "id": 78,
      "start": 11654.62,
      "end": 11656.62,
      "formatted_start": "03:14:14.620",
      "formatted_end": "03:14:16.620",
      "text": "از هر روز چند تا میخوادید؟"
    },
    {
      "id": 79,
      "start": 11656.62,
      "end": 11658.62,
      "formatted_start": "03:14:16.620",
      "formatted_end": "03:14:18.620",
      "text": "خواهد کنم هر روز هم میدن"
    },
    {
      "id": 80,
      "start": 11658.62,
      "end": 11660.62,
      "formatted_start": "03:14:18.620",
      "formatted_end": "03:14:20.620",
      "text": "دو هر دو هر در"
    },
    {
      "id": 81,
      "start": 11660.62,
      "end": 11662.62,
      "formatted_start": "03:14:20.620",
      "formatted_end": "03:14:22.620",
      "text": "مرد دوست"
    },
    {
      "id": 82,
      "start": 11662.62,
      "end": 11666.62,
      "formatted_start": "03:14:22.620",
      "formatted_end": "03:14:26.620",
      "text": "من این روز نمیشم دوتا که ترم نگهدی خب؟"
    },
    {
      "id": 83,
      "start": 11666.62,
      "end": 11668.62,
      "formatted_start": "03:14:26.620",
      "formatted_end": "03:14:28.620",
      "text": "از درم نگهدی"
    },
    {
      "id": 84,
      "start": 11668.62,
      "end": 11671.62,
      "formatted_start": "03:14:28.620",
      "formatted_end": "03:14:31.620",
      "text": "اسفره یا بیزاورت نمیشی؟"
    },
    {
      "id": 85,
      "start": 11671.62,
      "end": 11675.62,
      "formatted_start": "03:14:31.620",
      "formatted_end": "03:14:35.620",
      "text": "از اون ناشتا"
    },
    {
      "id": 86,
      "start": 11681.62,
      "end": 11685.62,
      "formatted_start": "03:14:41.620",
      "formatted_end": "03:14:45.620",
      "text": "خدای که امالایی که من همه چیز رو من خودش خورده"
