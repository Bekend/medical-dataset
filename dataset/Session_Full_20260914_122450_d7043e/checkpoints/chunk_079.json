  "stt_segments": [
    {
      "id": 0,
      "start": 23700.0,
      "end": 23703.24,
      "formatted_start": "06:35:00.000",
      "formatted_end": "06:35:03.240",
      "text": "خب دیگه انا شمار کار رو بر پرسنم، بده باریس کنه دیگه."
    },
    {
      "id": 1,
      "start": 23706.04,
      "end": 23708.56,
      "formatted_start": "06:35:06.040",
      "formatted_end": "06:35:08.560",
      "text": "خب شمار داده شده بگی بر داده شده میده پرسنم."
    },
    {
      "id": 2,
      "start": 23708.56,
      "end": 23710.0,
      "formatted_start": "06:35:08.560",
      "formatted_end": "06:35:10.000",
      "text": "بگی شمار موبایلشو."
    },
    {
      "id": 3,
      "start": 23710.6,
      "end": 23712.6,
      "formatted_start": "06:35:10.600",
      "formatted_end": "06:35:12.600",
      "text": "بفرم، بفرم."
    },
    {
      "id": 4,
      "start": 23713.8,
      "end": 23714.6,
      "formatted_start": "06:35:13.800",
      "formatted_end": "06:35:14.600",
      "text": "خب."
    },
    {
      "id": 5,
      "start": 23716.6,
      "end": 23717.4,
      "formatted_start": "06:35:16.600",
      "formatted_end": "06:35:17.400",
      "text": "خب."
    },
    {
      "id": 6,
      "start": 23719.4,
      "end": 23720.8,
      "formatted_start": "06:35:19.400",
      "formatted_end": "06:35:20.800",
      "text": "چهن و یک، خب."
    },
    {
      "id": 7,
      "start": 23723.0,
      "end": 23725.4,
      "formatted_start": "06:35:23.000",
      "formatted_end": "06:35:25.400",
      "text": "هفتصد و هشتاد و نه، حالا؟"
    },
    {
      "id": 8,
      "start": 23726.6,
      "end": 23727.4,
      "formatted_start": "06:35:26.600",
      "formatted_end": "06:35:27.400",
      "text": "خوش."
    },
    {
      "id": 9,
      "start": 23728.2,
      "end": 23729.6,
      "formatted_start": "06:35:28.200",
      "formatted_end": "06:35:29.600",
      "text": "خوشه میپرسم الان برش."
    },
    {
      "id": 10,
      "start": 23729.6,
      "end": 23731.6,
      "formatted_start": "06:35:29.600",
      "formatted_end": "06:35:31.600",
      "text": "یکمانی میخونم این درسته"
    },
    {
      "id": 11,
      "start": 23731.6,
      "end": 23733.6,
      "formatted_start": "06:35:31.600",
      "formatted_end": "06:35:33.600",
      "text": "ست نوست و یازده"
    },
    {
      "id": 12,
      "start": 23733.6,
      "end": 23735.6,
      "formatted_start": "06:35:33.600",
      "formatted_end": "06:35:35.600",
      "text": "سی و هفت چهل و یک"
    },
    {
      "id": 13,
      "start": 23735.6,
      "end": 23737.6,
      "formatted_start": "06:35:35.600",
      "formatted_end": "06:35:37.600",
      "text": "هفت صد و هشتد و نوست"
    },
    {
      "id": 14,
      "start": 23737.6,
      "end": 23739.6,
      "formatted_start": "06:35:37.600",
      "formatted_end": "06:35:39.600",
      "text": "باش هنو میکرسم بچه هاش"
    },
    {
      "id": 15,
      "start": 23739.6,
      "end": 23741.6,
      "formatted_start": "06:35:39.600",
      "formatted_end": "06:35:41.600",
      "text": "میشه؟"
    },
    {
      "id": 16,
      "start": 23741.6,
      "end": 23743.6,
      "formatted_start": "06:35:41.600",
      "formatted_end": "06:35:43.600",
      "text": "برو ببینیم برای سم"
    },
    {
      "id": 17,
      "start": 23743.6,
      "end": 23745.6,
      "formatted_start": "06:35:43.600",
      "formatted_end": "06:35:45.600",
      "text": "سمو اینجا خیلی خیلی خورد نداره"
    },
    {
      "id": 18,
      "start": 23745.6,
      "end": 23747.6,
      "formatted_start": "06:35:45.600",
      "formatted_end": "06:35:47.600",
      "text": "برایشو خودو میدن اونجور"
    },
    {
      "id": 19,
      "start": 23747.6,
      "end": 23749.6,
      "formatted_start": "06:35:47.600",
      "formatted_end": "06:35:49.600",
      "text": "خدا میکردم"
    },
    {
      "id": 20,
      "start": 23749.6,
      "end": 23751.6,
      "formatted_start": "06:35:49.600",
      "formatted_end": "06:35:51.600",
      "text": "خدا"
    },
    {
      "id": 21,
      "start": 23751.6,
      "end": 23753.6,
      "formatted_start": "06:35:51.600",
      "formatted_end": "06:35:53.600",
      "text": "چون خوردو با نداره نداره"
    },
    {
      "id": 22,
      "start": 23753.6,
      "end": 23755.6,
      "formatted_start": "06:35:53.600",
      "formatted_end": "06:35:55.600",
      "text": "دختر گناه همینو"
    },
    {
      "id": 23,
      "start": 23755.6,
      "end": 23757.6,
      "formatted_start": "06:35:55.600",
      "formatted_end": "06:35:57.600",
      "text": "دختر اینکو کم"
    },
    {
      "id": 24,
      "start": 23757.6,
      "end": 23759.6,
      "formatted_start": "06:35:57.600",
      "formatted_end": "06:35:59.600",
      "text": "اینکه کود کمی"
    },
    {
      "id": 25,
      "start": 23761.6,
      "end": 23763.6,
      "formatted_start": "06:36:01.600",
      "formatted_end": "06:36:03.600",
      "text": "دختر اون پرتوش سبیده"
    },
    {
      "id": 26,
      "start": 23763.6,
      "end": 23765.6,
      "formatted_start": "06:36:03.600",
      "formatted_end": "06:36:05.600",
      "text": "تو این سری قبل بسته"
    },
    {
      "id": 27,
      "start": 23765.6,
      "end": 23767.6,
      "formatted_start": "06:36:05.600",
      "formatted_end": "06:36:07.600",
      "text": "اونو سری قبل بسته"
    },
    {
      "id": 28,
      "start": 23767.6,
      "end": 23769.6,
      "formatted_start": "06:36:07.600",
      "formatted_end": "06:36:09.600",
      "text": "کود شما کافتون دیده"
    },
    {
      "id": 29,
      "start": 23771.6,
      "end": 23773.6,
      "formatted_start": "06:36:11.600",
      "formatted_end": "06:36:13.600",
      "text": "کپی نداری؟"
    },
    {
      "id": 30,
      "start": 23773.6,
      "end": 23775.6,
      "formatted_start": "06:36:13.600",
      "formatted_end": "06:36:15.600",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 23775.6,
      "end": 23777.6,
      "formatted_start": "06:36:15.600",
      "formatted_end": "06:36:17.600",
      "text": "مسکن هم برداری"
    },
    {
      "id": 32,
      "start": 23777.6,
      "end": 23779.6,
      "formatted_start": "06:36:17.600",
      "formatted_end": "06:36:19.600",
      "text": "مورو تبایز دارم"
    },
    {
      "id": 33,
      "start": 23779.6,
      "end": 23781.6,
      "formatted_start": "06:36:19.600",
      "formatted_end": "06:36:21.600",
      "text": "مورو برداری؟"
    },
    {
      "id": 34,
      "start": 23781.6,
      "end": 23783.6,
      "formatted_start": "06:36:21.600",
      "formatted_end": "06:36:23.600",
      "text": "کفترش شما اینکه بانک نبود"
    },
    {
      "id": 35,
      "start": 23783.6,
      "end": 23785.6,
      "formatted_start": "06:36:23.600",
      "formatted_end": "06:36:25.600",
      "text": "بانکی"
    },
    {
      "id": 36,
      "start": 23785.6,
      "end": 23815.6,
      "formatted_start": "06:36:25.600",
      "formatted_end": "06:36:55.600",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 37,
      "start": 23815.6,
      "end": 23820.6,
      "formatted_start": "06:36:55.600",
      "formatted_end": "06:37:00.600",
      "text": "باید بکنید که دکتر اعتمادت ده دقیقه دیگه اعتماد هم خونتون هست"
    },
    {
      "id": 38,
      "start": 23820.6,
      "end": 23821.6,
      "formatted_start": "06:37:00.600",
      "formatted_end": "06:37:01.600",
      "text": "دیگه ای قرار خودتون هم باشید"
    },
    {
      "id": 39,
      "start": 23821.6,
      "end": 23824.6,
      "formatted_start": "06:37:01.600",
      "formatted_end": "06:37:04.600",
      "text": "من حدود خونتون رو یادم نمیاد کجا هست"
    },
    {
      "id": 40,
      "start": 23824.6,
      "end": 23827.6,
      "formatted_start": "06:37:04.600",
      "formatted_end": "06:37:07.600",
      "text": "آخه هم دکتر خودشون یادشون"
    },
    {
      "id": 41,
      "start": 23827.6,
      "end": 23829.6,
      "formatted_start": "06:37:07.600",
      "formatted_end": "06:37:09.600",
      "text": "خودشون یادشون"
    },
    {
      "id": 42,
      "start": 23829.6,
      "end": 23831.6,
      "formatted_start": "06:37:09.600",
      "formatted_end": "06:37:11.600",
      "text": "بله بله ما میرسیم خدا"
    },
    {
      "id": 43,
      "start": 23831.6,
      "end": 23833.6,
      "formatted_start": "06:37:11.600",
      "formatted_end": "06:37:13.600",
      "text": "باشه مرسی خواهش میکنم باباست"
    },
    {
      "id": 44,
      "start": 23833.6,
      "end": 23835.6,
      "formatted_start": "06:37:13.600",
      "formatted_end": "06:37:15.600",
      "text": "مدردان"
    },
    {
      "id": 45,
      "start": 23837.6,
      "end": 23839.6,
      "formatted_start": "06:37:17.600",
      "formatted_end": "06:37:19.600",
      "text": "الان شما روش از شهرم بگیرم"
    },
    {
      "id": 46,
      "start": 23839.6,
      "end": 23841.6,
      "formatted_start": "06:37:19.600",
      "formatted_end": "06:37:21.600",
      "text": "الان شما اونجا این باز نمی کنه؟"
    },
    {
      "id": 47,
      "start": 23841.6,
      "end": 23843.6,
      "formatted_start": "06:37:21.600",
      "formatted_end": "06:37:23.600",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 23845.6,
      "end": 23850.6,
      "formatted_start": "06:37:25.600",
      "formatted_end": "06:37:30.600",
      "text": "خب الان من باشی به شهره میگم الان به استنگتن باشم باشم براتو میفروم"
    },
    {
      "id": 49,
      "start": 23850.6,
      "end": 23856.6,
      "formatted_start": "06:37:30.600",
      "formatted_end": "06:37:36.600",
      "text": "نه نه گفتم چقدر میشه؟"
    },
    {
      "id": 50,
      "start": 23856.6,
      "end": 23861.6,
      "formatted_start": "06:37:36.600",
      "formatted_end": "06:37:41.600",
      "text": "باشم باشم"
    },
    {
      "id": 51,
      "start": 23861.6,
      "end": 23866.6,
      "formatted_start": "06:37:41.600",
      "formatted_end": "06:37:46.600",
      "text": "اما قرار بیان خواب دیگه"
    },
    {
      "id": 52,
      "start": 23866.6,
      "end": 23871.6,
      "formatted_start": "06:37:46.600",
      "formatted_end": "06:37:51.600",
      "text": "بله کی الان چی کار کنی؟"
    },
    {
      "id": 53,
      "start": 23871.6,
      "end": 23884.1,
      "formatted_start": "06:37:51.600",
      "formatted_end": "06:38:04.100",
      "text": "خیلی خوب الان آره خودمون می آیم الان زنگ می زنم آهان بیاد باش باش باش تشمت بیاد"
    },
    {
      "id": 54,
      "start": 23884.1,
      "end": 23886.6,
      "formatted_start": "06:38:04.100",
      "formatted_end": "06:38:06.600",
      "text": "که می گه؟"
    },
    {
      "id": 55,
      "start": 23886.6,
      "end": 23891.28,
      "formatted_start": "06:38:06.600",
      "formatted_end": "06:38:11.280",
      "text": "کشف یه رفته خابیده آخه تو بابر زن جا نداری خوشوش بدی"
    },
    {
      "id": 56,
      "start": 23891.28,
      "end": 23893.86,
      "formatted_start": "06:38:11.280",
      "formatted_end": "06:38:13.860",
      "text": "علی خابیده کدوم علی؟ علی مزبا؟"
    },
    {
      "id": 57,
      "start": 23893.86,
      "end": 23898.68,
      "formatted_start": "06:38:13.860",
      "formatted_end": "06:38:18.680",
      "text": "نه علی ما پیش گفتم ساعت چار زنگ پرم دارم بیداری الان خوابه"
    },
    {
      "id": 58,
      "start": 23898.68,
      "end": 23900.68,
      "formatted_start": "06:38:18.680",
      "formatted_end": "06:38:20.680",
      "text": "و بعد گفتم مرد رو ساعت چهار میاد"
    },
    {
      "id": 59,
      "start": 23900.68,
      "end": 23902.68,
      "formatted_start": "06:38:20.680",
      "formatted_end": "06:38:22.680",
      "text": "ای الان میگه که شما نگهبانو بداد"
    },
    {
      "id": 60,
      "start": 23902.68,
      "end": 23904.68,
      "formatted_start": "06:38:22.680",
      "formatted_end": "06:38:24.680",
      "text": "ولی که دیدی همشه گوشهاش کلده"
    },
    {
      "id": 61,
      "start": 23908.68,
      "end": 23910.68,
      "formatted_start": "06:38:28.680",
      "formatted_end": "06:38:30.680",
      "text": "الان بگم ما موقع چکار کنیم؟"
    },
    {
      "id": 62,
      "start": 23910.68,
      "end": 23912.68,
      "formatted_start": "06:38:30.680",
      "formatted_end": "06:38:32.680",
      "text": "پزیده های کنده کاری رو ورد بدی"
    },
    {
      "id": 63,
      "start": 23912.68,
      "end": 23914.68,
      "formatted_start": "06:38:32.680",
      "formatted_end": "06:38:34.680",
      "text": "لوله میگن پنجری برن"
    },
    {
      "id": 64,
      "start": 23914.68,
      "end": 23916.68,
      "formatted_start": "06:38:34.680",
      "formatted_end": "06:38:36.680",
      "text": "مغازهای آقای قجری بخری بیاری"
    },
    {
      "id": 65,
      "start": 23916.68,
      "end": 23918.68,
      "formatted_start": "06:38:36.680",
      "formatted_end": "06:38:38.680",
      "text": "برای آبه دیگه؟"
    },
    {
      "id": 66,
      "start": 23918.68,
      "end": 23920.68,
      "formatted_start": "06:38:38.680",
      "formatted_end": "06:38:40.680",
      "text": "تایل پول سن"
    },
    {
      "id": 67,
      "start": 23922.68,
      "end": 23924.68,
      "formatted_start": "06:38:42.680",
      "formatted_end": "06:38:44.680",
      "text": "ما باید بریم باعث نه"
    },
    {
      "id": 68,
      "start": 23924.68,
      "end": 23926.68,
      "formatted_start": "06:38:44.680",
      "formatted_end": "06:38:46.680",
      "text": "الان باید به سر ساختم"
    },
    {
      "id": 69,
      "start": 23926.68,
      "end": 23929.68,
      "formatted_start": "06:38:46.680",
      "formatted_end": "06:38:49.680",
      "text": "من بیست دقیقه دیدم تن رو رو ماشینه بگیرم و کتبش برو بارم"
    },
    {
      "id": 70,
      "start": 23929.68,
      "end": 23931.68,
      "formatted_start": "06:38:49.680",
      "formatted_end": "06:38:51.680",
      "text": "بازا بریم پایین، الو"
    },
    {
      "id": 71,
      "start": 23931.68,
      "end": 23932.68,
      "formatted_start": "06:38:51.680",
      "formatted_end": "06:38:52.680",
      "text": "سلام خوبی؟"
    },
    {
      "id": 72,
      "start": 23932.68,
      "end": 23935.68,
      "formatted_start": "06:38:52.680",
      "formatted_end": "06:38:55.680",
      "text": "میگم که این مرد اون شماره که برای فرستادم زنگ زده"
    },
    {
      "id": 73,
      "start": 23935.68,
      "end": 23937.68,
      "formatted_start": "06:38:55.680",
      "formatted_end": "06:38:57.680",
      "text": "میگه که شماره نگهبان رو برام بپرسی"
    },
    {
      "id": 74,
      "start": 23937.68,
      "end": 23939.68,
      "formatted_start": "06:38:57.680",
      "formatted_end": "06:38:59.680",
      "text": "من سر روی مارک جاده مرز بانم"
    },
    {
      "id": 75,
      "start": 23939.68,
      "end": 23942.68,
      "formatted_start": "06:38:59.680",
      "formatted_end": "06:39:02.680",
      "text": "بهش زنگ بزن شماره علیه بده"
    },
    {
      "id": 76,
      "start": 23942.68,
      "end": 23944.68,
      "formatted_start": "06:39:02.680",
      "formatted_end": "06:39:04.680",
      "text": "بعد میگه که حزینه کردن با شماست"
    },
    {
      "id": 77,
      "start": 23944.68,
      "end": 23948.68,
      "formatted_start": "06:39:04.680",
      "formatted_end": "06:39:08.680",
      "text": "بعد لوله اینو هم پنج دری باید بری از آقای قجری بخری بیاری"
    },
    {
      "id": 78,
      "start": 23948.68,
      "end": 23952.68,
      "formatted_start": "06:39:08.680",
      "formatted_end": "06:39:12.680",
      "text": "گفت بگو آقا بیا تا اون موقع"
    },
    {
      "id": 79,
      "start": 23952.68,
      "end": 23956.68,
      "formatted_start": "06:39:12.680",
      "formatted_end": "06:39:16.680",
      "text": "من دارم بیرون بگیم بیا"
    },
    {
      "id": 80,
      "start": 23956.68,
      "end": 23962.68,
      "formatted_start": "06:39:16.680",
      "formatted_end": "06:39:22.680",
      "text": "نه میگه نه بود. الان بهش لنگ بزن شما رو علی هم بهش بده شما رو باید فرست دادم"
    },
    {
      "id": 81,
      "start": 23962.68,
      "end": 23968.68,
      "formatted_start": "06:39:22.680",
      "formatted_end": "06:39:28.680",
      "text": "الان نه میگی باید بکنم ببینم باید بهتون میگم چقدر لوله باید بگیریم"
    },
    {
      "id": 82,
      "start": 23968.68,
      "end": 23976.68,
      "formatted_start": "06:39:28.680",
      "formatted_end": "06:39:36.680",
      "text": "الان بهش لنگ به علی هم زنگ بزن بگو درباره باشیم آماده باشیم یعنی بیدار باشه"
    },
    {
      "id": 83,
      "start": 23976.68,
      "end": 23977.68,
      "formatted_start": "06:39:36.680",
      "formatted_end": "06:39:37.680",
      "text": "از شما..."
    },
    {
      "id": 84,
      "start": 23977.68,
      "end": 23978.68,
      "formatted_start": "06:39:37.680",
      "formatted_end": "06:39:38.680",
      "text": "از شما..."
    },
    {
      "id": 85,
      "start": 23978.68,
      "end": 23981.68,
      "formatted_start": "06:39:38.680",
      "formatted_end": "06:39:41.680",
      "text": "الان با سجاده مردم شما رو دیگه افرانو بدیم به من"
    },
    {
      "id": 86,
      "start": 23984.68,
      "end": 23986.68,
      "formatted_start": "06:39:44.680",
      "formatted_end": "06:39:46.680",
      "text": "خب بعد خودت بهش زنگ بزن"
    },
    {
      "id": 87,
