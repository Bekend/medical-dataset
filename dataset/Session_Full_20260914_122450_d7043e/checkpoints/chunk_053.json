      "start": 16191.614,
      "end": 16192.238,
      "formatted_start": "04:29:51.614",
      "formatted_end": "04:29:52.238",
      "speaker": "SPEAKER_02"
    },
    {
      "start": 16192.998,
      "end": 16195.327,
      "formatted_start": "04:29:52.998",
      "formatted_end": "04:29:55.327",
      "speaker": "SPEAKER_02"
    },
    {
      "start": 16196.66,
      "end": 16198.583,
      "formatted_start": "04:29:56.660",
      "formatted_end": "04:29:58.583",
      "speaker": "SPEAKER_02"
    },
    {
      "start": 16199.191,
      "end": 16199.967,
      "formatted_start": "04:29:59.191",
      "formatted_end": "04:29:59.967",
      "speaker": "SPEAKER_02"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 15900.0,
      "end": 15903.0,
      "formatted_start": "04:25:00.000",
      "formatted_end": "04:25:03.000",
      "text": "از این درخشون هم هست که از هر دارو هرمانی خورده."
    },
    {
      "id": 1,
      "start": 15903.0,
      "end": 15905.0,
      "formatted_start": "04:25:03.000",
      "formatted_end": "04:25:05.000",
      "text": "کبد هم یک هست، اون رو هم میدادم."
    },
    {
      "id": 2,
      "start": 15905.0,
      "end": 15907.0,
      "formatted_start": "04:25:05.000",
      "formatted_end": "04:25:07.000",
      "text": "چند وقتا کشونه؟"
    },
    {
      "id": 3,
      "start": 15907.0,
      "end": 15909.0,
      "formatted_start": "04:25:07.000",
      "formatted_end": "04:25:09.000",
      "text": "مدیران یکی دو ماشه."
    },
    {
      "id": 4,
      "start": 15909.0,
      "end": 15911.0,
      "formatted_start": "04:25:09.000",
      "formatted_end": "04:25:11.000",
      "text": "پس خوب تازه بود. دیگه صفرات هم بس نگاه میده."
    },
    {
      "id": 5,
      "start": 15911.0,
      "end": 15913.0,
      "formatted_start": "04:25:11.000",
      "formatted_end": "04:25:13.000",
      "text": "صفرات هم آره بود یه پولیپ و یه سنگ داره."
    },
    {
      "id": 6,
      "start": 15913.0,
      "end": 15914.0,
      "formatted_start": "04:25:13.000",
      "formatted_end": "04:25:14.000",
      "text": "داره؟"
    },
    {
      "id": 7,
      "start": 15914.0,
      "end": 15916.0,
      "formatted_start": "04:25:14.000",
      "formatted_end": "04:25:16.000",
      "text": "سنگ چی؟ آره."
    },
    {
      "id": 8,
      "start": 15916.0,
      "end": 15920.0,
      "formatted_start": "04:25:16.000",
      "formatted_end": "04:25:20.000",
      "text": "خب اونکه همونو میگویی، دردت اصلا من شخص هست دیگه بس باید باید جرائش کنید."
    },
    {
      "id": 9,
      "start": 15920.0,
      "end": 15925.0,
      "formatted_start": "04:25:20.000",
      "formatted_end": "04:25:25.000",
      "text": "خب اونکه همون دردت اصلا منشخص هست دیگه بس باید جرائش کنید"
    },
    {
      "id": 10,
      "start": 15929.0,
      "end": 15932.0,
      "formatted_start": "04:25:29.000",
      "formatted_end": "04:25:32.000",
      "text": "خود برند بایو فلورا نیست در سیستم"
    },
    {
      "id": 11,
      "start": 15932.0,
      "end": 15934.0,
      "formatted_start": "04:25:32.000",
      "formatted_end": "04:25:34.000",
      "text": "این نیست که هیچی"
    },
    {
      "id": 12,
      "start": 15934.0,
      "end": 15936.0,
      "formatted_start": "04:25:34.000",
      "formatted_end": "04:25:36.000",
      "text": "بایو کروم و اینجا چیز هست"
    },
    {
      "id": 13,
      "start": 15936.0,
      "end": 15940.0,
      "formatted_start": "04:25:36.000",
      "formatted_end": "04:25:40.000",
      "text": "بعد بایو فلورا میخواستی مگنیبان نه؟"
    },
    {
      "id": 14,
      "start": 15940.0,
      "end": 15942.0,
      "formatted_start": "04:25:40.000",
      "formatted_end": "04:25:42.000",
      "text": "مگنیبان"
    },
    {
      "id": 15,
      "start": 15942.0,
      "end": 15945.0,
      "formatted_start": "04:25:42.000",
      "formatted_end": "04:25:45.000",
      "text": "آره این مگنیبان خواستم این چیز رو"
    },
    {
      "id": 16,
      "start": 15945.0,
      "end": 15947.0,
      "formatted_start": "04:25:45.000",
      "formatted_end": "04:25:47.000",
      "text": "من یزجون میخواست"
    },
    {
      "id": 17,
      "start": 15947.0,
      "end": 15950.0,
      "formatted_start": "04:25:47.000",
      "formatted_end": "04:25:50.000",
      "text": "من از یک یک سرنویان بیشتر نخواهیم"
    },
    {
      "id": 18,
      "start": 15950.0,
      "end": 15952.0,
      "formatted_start": "04:25:50.000",
      "formatted_end": "04:25:52.000",
      "text": "یا قلبات بیشتر نخواهیم"
    },
    {
      "id": 19,
      "start": 15952.0,
      "end": 15956.0,
      "formatted_start": "04:25:52.000",
      "formatted_end": "04:25:56.000",
      "text": "و سپروکل من یک فروپار داده بودم"
    },
    {
      "id": 20,
      "start": 15960.0,
      "end": 15962.0,
      "formatted_start": "04:26:00.000",
      "formatted_end": "04:26:02.000",
      "text": "لاکسافول هم میخواهی؟"
    },
    {
      "id": 21,
      "start": 15962.0,
      "end": 15965.0,
      "formatted_start": "04:26:02.000",
      "formatted_end": "04:26:05.000",
      "text": "لاکسافول ندارم"
    },
    {
      "id": 22,
      "start": 15965.0,
      "end": 15967.0,
      "formatted_start": "04:26:05.000",
      "formatted_end": "04:26:07.000",
      "text": "لاکسافول نمیخواهیم"
    },
    {
      "id": 23,
      "start": 15967.0,
      "end": 15970.0,
      "formatted_start": "04:26:07.000",
      "formatted_end": "04:26:10.000",
      "text": "چی هست دارن؟ سموم همشون داری؟"
    },
    {
      "id": 24,
      "start": 15970.0,
      "end": 15972.0,
      "formatted_start": "04:26:10.000",
      "formatted_end": "04:26:12.000",
      "text": "سموم؟ این ها تازه هست؟"
    },
    {
      "id": 25,
      "start": 15972.0,
      "end": 15974.0,
      "formatted_start": "04:26:12.000",
      "formatted_end": "04:26:14.000",
      "text": "نه این ها شهر شب سه سه هست"
    },
    {
      "id": 26,
      "start": 15974.0,
      "end": 15975.0,
      "formatted_start": "04:26:14.000",
      "formatted_end": "04:26:15.000",
      "text": "من چون تازه دارم"
    },
    {
      "id": 27,
      "start": 15975.0,
      "end": 15978.0,
      "formatted_start": "04:26:15.000",
      "formatted_end": "04:26:18.000",
      "text": "اینجا همینجا متاسه داریم که برگرد کلیت نمیشه"
    },
    {
      "id": 28,
      "start": 15978.0,
      "end": 15980.0,
      "formatted_start": "04:26:18.000",
      "formatted_end": "04:26:20.000",
      "text": "اینجا همه که سفرات کلیت داشته"
    },
    {
      "id": 29,
      "start": 15980.0,
      "end": 15984.0,
      "formatted_start": "04:26:20.000",
      "formatted_end": "04:26:24.000",
      "text": "کلیت چی نگفت؟ اون بر حد داده خیلی کلیت نمیدونه"
    },
    {
      "id": 30,
      "start": 15984.0,
      "end": 15987.0,
      "formatted_start": "04:26:24.000",
      "formatted_end": "04:26:27.000",
      "text": "کلیت بر هر شش ماه سناب بده"
    },
    {
      "id": 31,
      "start": 15987.0,
      "end": 15990.0,
      "formatted_start": "04:26:27.000",
      "formatted_end": "04:26:30.000",
      "text": "به صنگ کارسته که سفراتو باید برداریم"
    },
    {
      "id": 32,
      "start": 15990.0,
      "end": 15993.0,
      "formatted_start": "04:26:30.000",
      "formatted_end": "04:26:33.000",
      "text": "اینجا پنج میلیمتر بوده"
    },
    {
      "id": 33,
      "start": 15993.0,
      "end": 15995.0,
      "formatted_start": "04:26:33.000",
      "formatted_end": "04:26:35.000",
      "text": "ولی درد میده توی گذار سفرات"
    },
    {
      "id": 34,
      "start": 15995.0,
      "end": 15997.0,
      "formatted_start": "04:26:35.000",
      "formatted_end": "04:26:37.000",
      "text": "میگم درد فشار میده، درد تو بیره"
    },
    {
      "id": 35,
      "start": 15997.0,
      "end": 15999.0,
      "formatted_start": "04:26:37.000",
      "formatted_end": "04:26:39.000",
      "text": "درد میده، افتاق ایجاد میکنه"
    },
    {
      "id": 36,
      "start": 15999.0,
      "end": 16004.0,
      "formatted_start": "04:26:39.000",
      "formatted_end": "04:26:44.000",
      "text": "تخمه مو، مکارنی، صوف گردن، جگر، کلپاچه اینو مبتد خودی"
    },
    {
      "id": 37,
      "start": 16004.0,
      "end": 16008.0,
      "formatted_start": "04:26:44.000",
      "formatted_end": "04:26:48.000",
      "text": "پس شد مکلیمان سپاکر و ارسا هندرسه"
    },
    {
      "id": 38,
      "start": 16008.0,
      "end": 16010.0,
      "formatted_start": "04:26:48.000",
      "formatted_end": "04:26:50.000",
      "text": "با همین کدو تو بگیر خود"
    },
    {
      "id": 39,
      "start": 16010.0,
      "end": 16014.0,
      "formatted_start": "04:26:50.000",
      "formatted_end": "04:26:54.000",
      "text": "با همین کدو هم داروته، هم آزمایشه"
    },
    {
      "id": 40,
      "start": 16014.0,
      "end": 16017.0,
      "formatted_start": "04:26:54.000",
      "formatted_end": "04:26:57.000",
      "text": "و ریز صفرات هم که باید..."
    },
    {
      "id": 41,
      "start": 16017.0,
      "end": 16019.0,
      "formatted_start": "04:26:57.000",
      "formatted_end": "04:26:59.000",
      "text": "اینه، اینجایی"
    },
    {
      "id": 42,
      "start": 16019.0,
      "end": 16021.0,
      "formatted_start": "04:26:59.000",
      "formatted_end": "04:27:01.000",
      "text": "تمام شده"
    },
    {
      "id": 43,
      "start": 16021.0,
      "end": 16022.0,
      "formatted_start": "04:27:01.000",
      "formatted_end": "04:27:02.000",
      "text": "نترسیم تاریخ بذاریم"
    },
    {
      "id": 44,
      "start": 16022.0,
      "end": 16024.0,
      "formatted_start": "04:27:02.000",
      "formatted_end": "04:27:04.000",
      "text": "اگه اونجا باز گفته سه ملیمتر"
    },
    {
      "id": 45,
      "start": 16024.0,
      "end": 16026.0,
      "formatted_start": "04:27:04.000",
      "formatted_end": "04:27:06.000",
      "text": "اونجا شکی داریم"
    },
    {
      "id": 46,
      "start": 16026.0,
      "end": 16030.0,
      "formatted_start": "04:27:06.000",
      "formatted_end": "04:27:10.000",
      "text": "اینجا راهم از دوزده سال در بزنه"
    },
    {
      "id": 47,
      "start": 16030.0,
      "end": 16032.0,
      "formatted_start": "04:27:10.000",
      "formatted_end": "04:27:12.000",
      "text": "اگر این باشه نیست درسته چند؟"
    },
    {
      "id": 48,
      "start": 16032.0,
      "end": 16034.0,
      "formatted_start": "04:27:12.000",
      "formatted_end": "04:27:14.000",
      "text": "من نمیدونم، هر دفعه هیچیز میزنند"
    },
    {
      "id": 49,
      "start": 16034.0,
      "end": 16036.0,
      "formatted_start": "04:27:14.000",
      "formatted_end": "04:27:16.000",
      "text": "اوه، تو باید یه آدم بگیر"
    },
    {
      "id": 50,
      "start": 16036.0,
      "end": 16039.0,
      "formatted_start": "04:27:16.000",
      "formatted_end": "04:27:19.000",
      "text": "اوه، دکتور حساب سلام، یادم بزنه"
    },
    {
      "id": 51,
      "start": 16039.0,
      "end": 16044.0,
      "formatted_start": "04:27:19.000",
      "formatted_end": "04:27:24.000",
      "text": "دوزده سال باشه، هر روی تموم"
    },
    {
      "id": 52,
      "start": 16044.0,
      "end": 16046.0,
      "formatted_start": "04:27:24.000",
      "formatted_end": "04:27:26.000",
      "text": "درسته، مرسی"
    },
    {
      "id": 53,
      "start": 16046.0,
      "end": 16048.0,
      "formatted_start": "04:27:26.000",
      "formatted_end": "04:27:28.000",
      "text": "مرسی، مرسی"
    },
    {
      "id": 54,
      "start": 16048.0,
      "end": 16050.0,
      "formatted_start": "04:27:28.000",
      "formatted_end": "04:27:30.000",
      "text": "مرسی"
    },
    {
      "id": 55,
      "start": 16050.0,
      "end": 16052.0,
      "formatted_start": "04:27:30.000",
      "formatted_end": "04:27:32.000",
      "text": "مرسی"
    },
    {
      "id": 56,
      "start": 16052.0,
      "end": 16082.0,
      "formatted_start": "04:27:32.000",
      "formatted_end": "04:28:02.000",
      "text": "از اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور بردارید که اینجور ب"
    },
    {
      "id": 57,
      "start": 16082.0,
      "end": 16084.0,
      "formatted_start": "04:28:02.000",
      "formatted_end": "04:28:04.000",
      "text": "از این غذا یک سیشه بود"
    },
    {
      "id": 58,
      "start": 16084.0,
      "end": 16086.0,
      "formatted_start": "04:28:04.000",
      "formatted_end": "04:28:06.000",
      "text": "مهم داریم، نون زیاد میخوانی"
    },
    {
      "id": 59,
      "start": 16086.0,
      "end": 16088.0,
      "formatted_start": "04:28:06.000",
      "formatted_end": "04:28:08.000",
      "text": "نون زیاد"
    },
    {
      "id": 60,
      "start": 16088.0,
      "end": 16090.0,
      "formatted_start": "04:28:08.000",
      "formatted_end": "04:28:10.000",
      "text": "نون زیاد میخوانی"
    },
    {
      "id": 61,
      "start": 16090.0,
      "end": 16092.0,
      "formatted_start": "04:28:10.000",
      "formatted_end": "04:28:12.000",
      "text": "خرسه اون فرقا نیست"
    },
    {
      "id": 62,
      "start": 16092.0,
      "end": 16094.0,
      "formatted_start": "04:28:12.000",
      "formatted_end": "04:28:14.000",
      "text": "اصلا به خرسه تو کاری نداریم"
    },
    {
      "id": 63,
      "start": 16094.0,
      "end": 16096.0,
      "formatted_start": "04:28:14.000",
      "formatted_end": "04:28:16.000",
      "text": "نون داری زیاد میخوانی"
    },
    {
      "id": 64,
      "start": 16096.0,
      "end": 16098.0,
      "formatted_start": "04:28:16.000",
      "formatted_end": "04:28:18.000",
      "text": "نون نخواهم"
    },
    {
      "id": 65,
      "start": 16098.0,
      "end": 16100.0,
      "formatted_start": "04:28:18.000",
      "formatted_end": "04:28:20.000",
      "text": "نون تو کم"
    },
    {
      "id": 66,
      "start": 16100.0,
      "end": 16102.0,
      "formatted_start": "04:28:20.000",
      "formatted_end": "04:28:22.000",
      "text": "چون اصلا وقتی که دو ساعت بعد غذا تا 50 تا بالا"
    },
    {
      "id": 67,
      "start": 16102.0,
      "end": 16104.0,
      "formatted_start": "04:28:22.000",
      "formatted_end": "04:28:24.000",
      "text": "صبح تا اینقدر 50 تا بالا"
    },
    {
      "id": 68,
      "start": 16104.0,
      "end": 16106.0,
      "formatted_start": "04:28:24.000",
      "formatted_end": "04:28:26.000",
      "text": "سری نون داره زیاد مرز کنه"
    },
    {
      "id": 69,
      "start": 16106.0,
      "end": 16108.0,
      "formatted_start": "04:28:26.000",
      "formatted_end": "04:28:28.000",
      "text": "یا نون یا برنج"
    },
    {
      "id": 70,
      "start": 16108.0,
      "end": 16110.0,
      "formatted_start": "04:28:28.000",
      "formatted_end": "04:28:30.000",
      "text": "چون صوبان هم بالاست نون داره زیاد میخوانی"
    },
    {
      "id": 71,
      "start": 16110.0,
      "end": 16112.0,
      "formatted_start": "04:28:30.000",
      "formatted_end": "04:28:32.000",
      "text": "میخوایی صبح نه؟"
    },
    {
      "id": 72,
      "start": 16112.0,
      "end": 16114.0,
      "formatted_start": "04:28:32.000",
      "formatted_end": "04:28:34.000",
      "text": "یک تیکه نون نوزده بود"
    },
    {
      "id": 73,
      "start": 16114.0,
      "end": 16116.0,
      "formatted_start": "04:28:34.000",
      "formatted_end": "04:28:36.000",
      "text": "از یک نون کامل تاپتون چقدر شما میخوایی؟"
    },
    {
      "id": 74,
      "start": 16116.0,
      "end": 16120.0,
      "formatted_start": "04:28:36.000",
      "formatted_end": "04:28:40.000",
      "text": "از یک تاپتون مثلا یک چارم شما میخوایی؟"
    },
    {
      "id": 75,
      "start": 16120.0,
      "end": 16122.0,
      "formatted_start": "04:28:40.000",
      "formatted_end": "04:28:42.000",
      "text": "یک چارم"
    },
    {
      "id": 76,
      "start": 16122.0,
      "end": 16124.0,
      "formatted_start": "04:28:42.000",
      "formatted_end": "04:28:44.000",
      "text": "زیاده؟ نه کم نه"
    },
    {
      "id": 77,
      "start": 16124.0,
      "end": 16126.0,
      "formatted_start": "04:28:44.000",
      "formatted_end": "04:28:46.000",
      "text": "باقیل یک چارم بخوایی؟"
    },
    {
      "id": 78,
      "start": 16126.0,
      "end": 16128.0,
      "formatted_start": "04:28:46.000",
      "formatted_end": "04:28:48.000",
      "text": "یک نون تاپتون که اینقدر است باقیی؟"
    },
    {
      "id": 79,
      "start": 16128.0,
      "end": 16130.0,
      "formatted_start": "04:28:48.000",
      "formatted_end": "04:28:50.000",
      "text": "یک تیکه اینقدر شما شما شما بخوایی؟"
    },
    {
      "id": 80,
      "start": 16130.0,
      "end": 16132.0,
      "formatted_start": "04:28:50.000",
      "formatted_end": "04:28:52.000",
      "text": "یک سبا میشون"
    },
    {
      "id": 81,
      "start": 16132.0,
      "end": 16134.0,
      "formatted_start": "04:28:52.000",
      "formatted_end": "04:28:54.000",
      "text": "چون یک چارم بخوایی بیغنده ده اینیست؟"
    },
    {
      "id": 82,
      "start": 16134.0,
      "end": 16136.0,
      "formatted_start": "04:28:54.000",
      "formatted_end": "04:28:56.000",
      "text": "نه یک سبا هست"
    },
    {
      "id": 83,
      "start": 16136.0,
      "end": 16138.0,
      "formatted_start": "04:28:56.000",
      "formatted_end": "04:28:58.000",
      "text": "چون یک چارم اگه بخوایی خیلی نیست"
    },
    {
      "id": 84,
      "start": 16138.0,
      "end": 16142.0,
      "formatted_start": "04:28:58.000",
      "formatted_end": "04:29:02.000",
      "text": "و چون شکم داری هنوز ازاله ها از گویه"
    },
    {
      "id": 85,
      "start": 16142.0,
      "end": 16144.0,
      "formatted_start": "04:29:02.000",
      "formatted_end": "04:29:04.000",
      "text": "اگه میخورید منو برینجو برینجو"
    },
    {
      "id": 86,
      "start": 16144.0,
      "end": 16146.0,
      "formatted_start": "04:29:04.000",
      "formatted_end": "04:29:06.000",
      "text": "چند ماه شوار زرمیخورید؟"
    },
    {
      "id": 87,
      "start": 16146.0,
      "end": 16148.0,
      "formatted_start": "04:29:06.000",
      "formatted_end": "04:29:08.000",
      "text": "برینجو نه برای زرم یه باشه خواب میخورد"
    },
    {
      "id": 88,
      "start": 16148.0,
      "end": 16150.0,
      "formatted_start": "04:29:08.000",
      "formatted_end": "04:29:10.000",
      "text": "یک شرپ هزار هزار دست هم نمیخورد"
    },
    {
      "id": 89,
      "start": 16150.0,
      "end": 16151.0,
      "formatted_start": "04:29:10.000",
      "formatted_end": "04:29:11.000",
      "text": "شام نمیخورد؟"
    },
    {
      "id": 90,
      "start": 16151.0,
      "end": 16152.0,
      "formatted_start": "04:29:11.000",
      "formatted_end": "04:29:12.000",
      "text": "هزار شام"
    },
    {
      "id": 91,
      "start": 16152.0,
      "end": 16153.0,
      "formatted_start": "04:29:12.000",
      "formatted_end": "04:29:13.000",
      "text": "بابشت بخورد"
    },
    {
      "id": 92,
      "start": 16153.0,
      "end": 16155.0,
      "formatted_start": "04:29:13.000",
      "formatted_end": "04:29:15.000",
      "text": "دیابوتی اصلا به جای سه ورده باید شیش ورده بخورد"
    },
    {
      "id": 93,
      "start": 16155.0,
      "end": 16158.24,
      "formatted_start": "04:29:15.000",
      "formatted_end": "04:29:18.240",
      "text": "این کاری که می کنی از حالاتو تا از دست می کنی"
    },
    {
      "id": 94,
      "start": 16158.24,
      "end": 16161.54,
      "formatted_start": "04:29:18.240",
      "formatted_end": "04:29:21.540",
      "text": "شب شب باید دو خویی کف دست اینه"
    },
    {
      "id": 95,
      "start": 16161.54,
      "end": 16163.1,
      "formatted_start": "04:29:21.540",
      "formatted_end": "04:29:23.100",
      "text": "کف دست اینه تازه"
    },
    {
      "id": 96,
      "start": 16163.1,
      "end": 16165.94,
      "formatted_start": "04:29:23.100",
      "formatted_end": "04:29:25.940",
      "text": "باید آقای مومی با هم باشه"
    },
    {
      "id": 97,
      "start": 16165.94,
      "end": 16167.16,
      "formatted_start": "04:29:25.940",
      "formatted_end": "04:29:27.160",
      "text": "شب مثلا چی بپرد؟"
    },
    {
      "id": 98,
      "start": 16167.16,
      "end": 16168.2,
      "formatted_start": "04:29:27.160",
      "formatted_end": "04:29:28.200",
      "text": "پلیر خیال برد"
    },
    {
      "id": 99,
      "start": 16168.2,
      "end": 16169.38,
      "formatted_start": "04:29:28.200",
      "formatted_end": "04:29:29.380",
      "text": "همینون با شیر"
    },
    {
      "id": 100,
      "start": 16169.38,
      "end": 16170.6,
      "formatted_start": "04:29:29.380",
      "formatted_end": "04:29:30.600",
      "text": "باید زرم آسان"
    },
    {
      "id": 101,
      "start": 16170.6,
      "end": 16172.4,
      "formatted_start": "04:29:30.600",
      "formatted_end": "04:29:32.400",
      "text": "زور برنجو در جایی"
    },
    {
      "id": 102,
      "start": 16172.4,
      "end": 16175.62,
      "formatted_start": "04:29:32.400",
      "formatted_end": "04:29:35.620",
      "text": "ببین شما در جایی که قندتون میره بالا"
    },
    {
      "id": 103,
      "start": 16175.62,
      "end": 16176.78,
      "formatted_start": "04:29:35.620",
      "formatted_end": "04:29:36.780",
      "text": "خب مثلا یکی میاد"
    },
    {
      "id": 104,
      "start": 16176.78,
      "end": 16177.94,
      "formatted_start": "04:29:36.780",
      "formatted_end": "04:29:37.940",
      "text": "الان راننده ها دو"
    },
    {
      "id": 105,
      "start": 16177.94,
      "end": 16180.78,
      "formatted_start": "04:29:37.940",
      "formatted_end": "04:29:40.780",
      "text": "ببین میگن آقا ما یه برده میخوریم"
    },
    {
      "id": 106,
      "start": 16180.78,
      "end": 16200.0,
      "formatted_start": "04:29:40.780",
      "formatted_end": "04:30:00.000",
      "text": "همونو می کنیم. اون قلد در جای خود می زنه ۵۶۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰"
    }
  ],
  "status": "completed"
}