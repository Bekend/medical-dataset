  "stt_segments": [
    {
      "id": 0,
      "start": 600.0,
      "end": 630.0,
      "formatted_start": "00:10:00.000",
      "formatted_end": "00:10:30.000",
      "text": "اینجا باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرده بوده که باید برگرد"
    },
    {
      "id": 1,
      "start": 630.0,
      "end": 650.0,
      "formatted_start": "00:10:30.000",
      "formatted_end": "00:10:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 650.0,
      "end": 652.0,
      "formatted_start": "00:10:50.000",
      "formatted_end": "00:10:52.000",
      "text": "با پلو اومدی؟"
    },
    {
      "id": 3,
      "start": 652.0,
      "end": 653.0,
      "formatted_start": "00:10:52.000",
      "formatted_end": "00:10:53.000",
      "text": "آره"
    },
    {
      "id": 4,
      "start": 653.0,
      "end": 654.0,
      "formatted_start": "00:10:53.000",
      "formatted_end": "00:10:54.000",
      "text": "چرا؟"
    },
    {
      "id": 5,
      "start": 654.0,
      "end": 655.0,
      "formatted_start": "00:10:54.000",
      "formatted_end": "00:10:55.000",
      "text": "نمیدونم"
    },
    {
      "id": 6,
      "start": 655.0,
      "end": 657.0,
      "formatted_start": "00:10:55.000",
      "formatted_end": "00:10:57.000",
      "text": "اینجا راستیل آسانسوره میده"
    },
    {
      "id": 7,
      "start": 657.0,
      "end": 659.0,
      "formatted_start": "00:10:57.000",
      "formatted_end": "00:10:59.000",
      "text": "بخواد نه؟"
    },
    {
      "id": 8,
      "start": 659.0,
      "end": 660.0,
      "formatted_start": "00:10:59.000",
      "formatted_end": "00:11:00.000",
      "text": "بنابراین"
    },
    {
      "id": 9,
      "start": 660.0,
      "end": 661.0,
      "formatted_start": "00:11:00.000",
      "formatted_end": "00:11:01.000",
      "text": "سوال آسانسوره نمیشه"
    },
    {
      "id": 10,
      "start": 661.0,
      "end": 663.0,
      "formatted_start": "00:11:01.000",
      "formatted_end": "00:11:03.000",
      "text": "نه بو نمیدونه، خیلی کشیده بوده"
    },
    {
      "id": 11,
      "start": 663.0,
      "end": 664.0,
      "formatted_start": "00:11:03.000",
      "formatted_end": "00:11:04.000",
      "text": "نه"
    },
    {
      "id": 12,
      "start": 664.0,
      "end": 667.0,
      "formatted_start": "00:11:04.000",
      "formatted_end": "00:11:07.000",
      "text": "نمیدونم اون چند مورد سوال شده بو میده دیگه"
    },
    {
      "id": 13,
      "start": 667.0,
      "end": 669.0,
      "formatted_start": "00:11:07.000",
      "formatted_end": "00:11:09.000",
      "text": "نمیدونم"
    },
    {
      "id": 14,
      "start": 669.0,
      "end": 671.0,
      "formatted_start": "00:11:09.000",
      "formatted_end": "00:11:11.000",
      "text": "تجربه گفتی، سوال نداری"
    },
    {
      "id": 15,
      "start": 671.0,
      "end": 674.0,
      "formatted_start": "00:11:11.000",
      "formatted_end": "00:11:14.000",
      "text": "بله، تجربه کسی بوده؟"
    },
    {
      "id": 16,
      "start": 674.0,
      "end": 676.0,
      "formatted_start": "00:11:14.000",
      "formatted_end": "00:11:16.000",
      "text": "آقا بعضی همون ندارده بله"
    },
    {
      "id": 17,
      "start": 676.0,
      "end": 677.0,
      "formatted_start": "00:11:16.000",
      "formatted_end": "00:11:17.000",
      "text": "بله، نه"
    },
    {
      "id": 18,
      "start": 677.0,
      "end": 678.0,
      "formatted_start": "00:11:17.000",
      "formatted_end": "00:11:18.000",
      "text": "اصلا نه"
    },
    {
      "id": 19,
      "start": 678.0,
      "end": 680.0,
      "formatted_start": "00:11:18.000",
      "formatted_end": "00:11:20.000",
      "text": "نه با همون بیگانن"
    },
    {
      "id": 20,
      "start": 680.0,
      "end": 682.0,
      "formatted_start": "00:11:20.000",
      "formatted_end": "00:11:22.000",
      "text": "بیگانن نه نه"
    },
    {
      "id": 21,
      "start": 682.0,
      "end": 684.0,
      "formatted_start": "00:11:22.000",
      "formatted_end": "00:11:24.000",
      "text": "آه منیدون همون چی که بردی ازا میمیرن"
    },
    {
      "id": 22,
      "start": 684.0,
      "end": 686.0,
      "formatted_start": "00:11:24.000",
      "formatted_end": "00:11:26.000",
      "text": "با همون پول نمیخواد که"
    },
    {
      "id": 23,
      "start": 690.0,
      "end": 692.0,
      "formatted_start": "00:11:30.000",
      "formatted_end": "00:11:32.000",
      "text": "خوب تمام؟"
    },
    {
      "id": 24,
      "start": 692.0,
      "end": 694.0,
      "formatted_start": "00:11:32.000",
      "formatted_end": "00:11:34.000",
      "text": "نه نمیخواد اینو بزنم"
    },
    {
      "id": 25,
      "start": 694.0,
      "end": 696.0,
      "formatted_start": "00:11:34.000",
      "formatted_end": "00:11:36.000",
      "text": "آره نه نمو... اوکیه"
    },
    {
      "id": 26,
      "start": 696.0,
      "end": 698.0,
      "formatted_start": "00:11:36.000",
      "formatted_end": "00:11:38.000",
      "text": "خوب بردی"
    },
    {
      "id": 27,
      "start": 704.0,
      "end": 706.0,
