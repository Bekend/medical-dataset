      "id": 81,
      "start": 20058.0,
      "end": 20061.82,
      "formatted_start": "05:34:18.000",
      "formatted_end": "05:34:21.820",
      "text": "میدونی که چهار ساعت هر فرواده تونو کشه آماده کنم دکتر خب؟"
    },
    {
      "id": 82,
      "start": 20061.82,
      "end": 20063.82,
      "formatted_start": "05:34:21.820",
      "formatted_end": "05:34:23.820",
      "text": "یه آماده سازی میخواد"
    },
