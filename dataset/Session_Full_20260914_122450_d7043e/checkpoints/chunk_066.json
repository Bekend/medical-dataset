  "stt_segments": [
    {
      "id": 0,
      "start": 19800.0,
      "end": 19811.0,
      "formatted_start": "05:30:00.000",
      "formatted_end": "05:30:11.000",
      "text": "آره، این نموزت داره. بعدی بابا سیلی چیز اونو دارم. اونا که جدای دیگه باقی از اینو. یا پارسیل چیزو میمسرف میکنن."
    },
    {
      "id": 1,
      "start": 19816.0,
      "end": 19824.0,
      "formatted_start": "05:30:16.000",
      "formatted_end": "05:30:24.000",
      "text": "برگاه سازگی های... سیلاکس. سیلاکس، فراموش کرده. هن سیلاکس روز یه دونه مسرف نکنه."
    },
    {
      "id": 2,
      "start": 19824.0,
      "end": 19828.0,
      "formatted_start": "05:30:24.000",
      "formatted_end": "05:30:28.000",
      "text": "اینجوری کنم دکتر گذاری یه لحظه مصرف نکردم که کن نمیخونم"
    },
    {
      "id": 3,
      "start": 19828.0,
      "end": 19834.0,
      "formatted_start": "05:30:28.000",
      "formatted_end": "05:30:34.000",
      "text": "مالی ها سیاد بره آب و گرم بره نشتا یه دیوان آب و برنم شب مورد بره یه دیوان آب و برنم"
    },
    {
      "id": 4,
      "start": 19834.0,
      "end": 19835.0,
      "formatted_start": "05:30:34.000",
      "formatted_end": "05:30:35.000",
      "text": "تاثیر داره؟"
    },
    {
      "id": 5,
      "start": 19835.0,
      "end": 19837.0,
      "formatted_start": "05:30:35.000",
      "formatted_end": "05:30:37.000",
      "text": "آره تاثیر داره، مالو خیست کنید"
    },
    {
      "id": 6,
      "start": 19837.0,
      "end": 19839.0,
      "formatted_start": "05:30:37.000",
      "formatted_end": "05:30:39.000",
      "text": "پول محمدی که چشمی برخوردید"
    },
    {
      "id": 7,
      "start": 19839.0,
      "end": 19841.0,
      "formatted_start": "05:30:39.000",
      "formatted_end": "05:30:41.000",
      "text": "محمد تاثیر داره"
    },
    {
      "id": 8,
      "start": 19841.0,
      "end": 19843.0,
      "formatted_start": "05:30:41.000",
      "formatted_end": "05:30:43.000",
      "text": "بعد خاکی شیر یا؟"
    },
    {
      "id": 9,
      "start": 19843.0,
      "end": 19846.0,
      "formatted_start": "05:30:43.000",
      "formatted_end": "05:30:46.000",
      "text": "خاکی شیر اگه سرد باشه باست صفت افتریک میکنه"
    },
    {
      "id": 10,
      "start": 19846.0,
      "end": 19848.0,
      "formatted_start": "05:30:46.000",
      "formatted_end": "05:30:48.000",
      "text": "برای کلی هم نگیره"
    },
    {
      "id": 11,
      "start": 19848.0,
      "end": 19850.0,
      "formatted_start": "05:30:48.000",
      "formatted_end": "05:30:50.000",
      "text": "نه، یک اطراف نگیرم بخاطر از سوزه شده"
    },
    {
      "id": 12,
      "start": 19850.0,
      "end": 19852.0,
      "formatted_start": "05:30:50.000",
      "formatted_end": "05:30:52.000",
      "text": "ولی دفعه پرتره نمیخواد"
    },
    {
      "id": 13,
      "start": 19852.0,
      "end": 19854.0,
      "formatted_start": "05:30:52.000",
      "formatted_end": "05:30:54.000",
      "text": "نه، شاید"
    },
    {
      "id": 14,
      "start": 19854.0,
      "end": 19856.0,
      "formatted_start": "05:30:54.000",
      "formatted_end": "05:30:56.000",
      "text": "بگیرم و بردیم برای دارو بگیرم"
    },
    {
      "id": 15,
      "start": 19856.0,
      "end": 19858.0,
      "formatted_start": "05:30:56.000",
      "formatted_end": "05:30:58.000",
      "text": "انشالله بخاطر"
    },
    {
      "id": 16,
      "start": 19858.0,
      "end": 19860.0,
      "formatted_start": "05:30:58.000",
      "formatted_end": "05:31:00.000",
      "text": "ممنون"
    },
    {
      "id": 17,
      "start": 19860.0,
      "end": 19862.0,
      "formatted_start": "05:31:00.000",
      "formatted_end": "05:31:02.000",
      "text": "ممنون"
    },
    {
      "id": 18,
      "start": 19862.0,
      "end": 19864.0,
      "formatted_start": "05:31:02.000",
      "formatted_end": "05:31:04.000",
      "text": "سلامت باشد"
    },
    {
      "id": 19,
      "start": 19864.0,
      "end": 19866.0,
      "formatted_start": "05:31:04.000",
      "formatted_end": "05:31:06.000",
      "text": "سلامت باشد"
    },
    {
      "id": 20,
      "start": 19866.0,
      "end": 19868.0,
      "formatted_start": "05:31:06.000",
      "formatted_end": "05:31:08.000",
      "text": "ممنون"
    },
    {
      "id": 21,
      "start": 19868.0,
      "end": 19870.0,
      "formatted_start": "05:31:08.000",
      "formatted_end": "05:31:10.000",
      "text": "ممنون"
    },
    {
      "id": 22,
      "start": 19870.0,
      "end": 19872.0,
      "formatted_start": "05:31:10.000",
      "formatted_end": "05:31:12.000",
      "text": "ممنون"
    },
    {
      "id": 23,
      "start": 19872.0,
      "end": 19874.0,
      "formatted_start": "05:31:12.000",
      "formatted_end": "05:31:14.000",
      "text": "ممنون"
    },
    {
      "id": 24,
      "start": 19874.0,
      "end": 19876.0,
      "formatted_start": "05:31:14.000",
      "formatted_end": "05:31:16.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 25,
      "start": 19876.0,
      "end": 19878.0,
      "formatted_start": "05:31:16.000",
      "formatted_end": "05:31:18.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 26,
      "start": 19878.0,
      "end": 19880.0,
      "formatted_start": "05:31:18.000",
