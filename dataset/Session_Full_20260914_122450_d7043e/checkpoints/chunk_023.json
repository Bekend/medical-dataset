      "formatted_end": "01:57:10.200",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 7050.2,
      "end": 7055.2,
      "formatted_start": "01:57:30.200",
      "formatted_end": "01:57:35.200",
      "text": "خامشفایی؟"
    },
    {
      "id": 9,
      "start": 7055.2,
      "end": 7059.2,
      "formatted_start": "01:57:35.200",
      "formatted_end": "01:57:39.200",
      "text": "خامشفایی؟"
    },
    {
      "id": 10,
      "start": 7059.2,
      "end": 7065.2,
      "formatted_start": "01:57:39.200",
      "formatted_end": "01:57:45.200",
      "text": "ببینین آبها برده که نمیخواد"
    },
    {
      "id": 11,
      "start": 7065.2,
      "end": 7068.2,
      "formatted_start": "01:57:45.200",
      "formatted_end": "01:57:48.200",
      "text": "این که آزاده، میکردیتیه"
    },
    {
      "id": 12,
      "start": 7068.2,
      "end": 7071.2,
      "formatted_start": "01:57:48.200",
      "formatted_end": "01:57:51.200",
      "text": "یه لورنتا که اصلا با این تعیید نمیشه چون توشه"
    },
    {
      "id": 13,
      "start": 7071.2,
      "end": 7074.2,
      "formatted_start": "01:57:51.200",
      "formatted_end": "01:57:54.200",
      "text": "اینو دیگه نباید بخور و خیلی بخور که اینش هست"
    },
    {
      "id": 14,
      "start": 7074.2,
      "end": 7077.2,
      "formatted_start": "01:57:54.200",
      "formatted_end": "01:57:57.200",
      "text": "دفت پنج این تو همه بازه"
    },
    {
      "id": 15,
      "start": 7077.2,
      "end": 7081.2,
      "formatted_start": "01:57:57.200",
      "formatted_end": "01:58:01.200",
      "text": "همونجوری که اینو میخورده بخورد اینو نباید با اینجوری تداخل داره"
    },
    {
      "id": 16,
      "start": 7081.2,
      "end": 7082.2,
      "formatted_start": "01:58:01.200",
      "formatted_end": "01:58:02.200",
      "text": "تداخل داره"
    },
    {
      "id": 17,
      "start": 7082.2,
      "end": 7083.2,
      "formatted_start": "01:58:02.200",
      "formatted_end": "01:58:03.200",
      "text": "اینو ساسیستن تشکیل شده"
    },
    {
      "id": 18,
      "start": 7083.2,
      "end": 7087.2,
      "formatted_start": "01:58:03.200",
      "formatted_end": "01:58:07.200",
      "text": "پیزو پروردشم پرید کردم انا به دارواشو بگیرم"
    },
    {
      "id": 19,
      "start": 7087.2,
      "end": 7088.2,
      "formatted_start": "01:58:07.200",
      "formatted_end": "01:58:08.200",
      "text": "کدوش میدونی؟"
    },
    {
      "id": 20,
      "start": 7088.2,
      "end": 7091.2,
      "formatted_start": "01:58:08.200",
      "formatted_end": "01:58:11.200",
      "text": "نشاندار کردم بره الان بگیرم ببینیم چیشه"
    },
    {
      "id": 21,
      "start": 7095.2,
      "end": 7099.2,
      "formatted_start": "01:58:15.200",
      "formatted_end": "01:58:19.200",
      "text": "بهش بگو بگو اون غص اصلا نباید خورده بشه با من اشتباه میده"
    },
    {
      "id": 22,
      "start": 7100.2,
      "end": 7102.2,
      "formatted_start": "01:58:20.200",
      "formatted_end": "01:58:22.200",
      "text": "بیاین که آزمایششم بگیرش"
    },
    {
      "id": 23,
      "start": 7102.2,
      "end": 7103.2,
      "formatted_start": "01:58:22.200",
      "formatted_end": "01:58:23.200",
      "text": "بره بره"
    },
    {
      "id": 24,
      "start": 7103.2,
      "end": 7106.7,
      "formatted_start": "01:58:23.200",
      "formatted_end": "01:58:26.700",
      "text": "سری دسته بطیه هشم می‌کنن همجوری می‌آرن ماسمالی باید"
    },
    {
      "id": 25,
      "start": 7106.7,
      "end": 7108.44,
      "formatted_start": "01:58:26.700",
      "formatted_end": "01:58:28.440",
      "text": "بشونم این نبات دیگه خانم تبینیم"
    },
    {
      "id": 26,
      "start": 7108.44,
      "end": 7112.2,
      "formatted_start": "01:58:28.440",
      "formatted_end": "01:58:32.200",
      "text": "نه باید نوبت خشک بشنن مثل بقیه با نفذ اونجوری"
    },
    {
      "id": 27,
      "start": 7112.2,
      "end": 7115.7,
      "formatted_start": "01:58:32.200",
      "formatted_end": "01:58:35.700",
      "text": "هم از دست من یه چیز در می‌روند چون کلیه هشم در پورتین داره"
    },
    {
      "id": 28,
      "start": 7115.7,
      "end": 7118.2,
      "formatted_start": "01:58:35.700",
      "formatted_end": "01:58:38.200",
      "text": "بعد مردم مریض یه چیز می‌شه بگن"
    },
    {
      "id": 29,
      "start": 7118.2,
      "end": 7120.2,
      "formatted_start": "01:58:38.200",
      "formatted_end": "01:58:40.200",
      "text": "مطلب کلان می‌روند اینجوری بشه"
    },
    {
      "id": 30,
      "start": 7120.2,
      "end": 7125.2,
      "formatted_start": "01:58:40.200",
      "formatted_end": "01:58:45.200",
      "text": "یک مردم می‌گن اینجا می‌شینن همه برده شما می‌ذارن مگه"
    },
    {
      "id": 31,
      "start": 7125.2,
      "end": 7155.2,
      "formatted_start": "01:58:45.200",
      "formatted_end": "01:59:15.200",
      "text": "برگرده با اینجا باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده باید برگرده ب"
    },
    {
      "id": 32,
      "start": 7155.2,
      "end": 7160.78,
      "formatted_start": "01:59:15.200",
      "formatted_end": "01:59:20.780",
      "text": "از پایین میگیره از این مصیر سیاتیکه"
    },
    {
      "id": 33,
      "start": 7160.78,
      "end": 7163.76,
      "formatted_start": "01:59:20.780",
      "formatted_end": "01:59:23.760",
      "text": "کمره اون دردی کنه"
    },
    {
      "id": 34,
      "start": 7163.76,
      "end": 7169.0,
      "formatted_start": "01:59:23.760",
      "formatted_end": "01:59:29.000",
      "text": "اما در واقع مالتیست که کمره که حالا میزنه به پای تو"
    },
    {
      "id": 35,
      "start": 7169.0,
      "end": 7171.3,
      "formatted_start": "01:59:29.000",
      "formatted_end": "01:59:31.300",
      "text": "سرفا زیاد وایستی؟"
    },
    {
      "id": 36,
      "start": 7171.3,
      "end": 7175.16,
      "formatted_start": "01:59:31.300",
      "formatted_end": "01:59:35.160",
      "text": "نیستن به سرفا و نیستن اونورم بیماریم و زیاد اوورم"
    },
    {
      "id": 37,
      "start": 7175.16,
      "end": 7177.84,
      "formatted_start": "01:59:35.160",
      "formatted_end": "01:59:37.840",
      "text": "خب زیاد نباید بیمار اونورم ببینید اوورم"
    },
    {
      "id": 38,
      "start": 7177.84,
      "end": 7180.24,
      "formatted_start": "01:59:37.840",
      "formatted_end": "01:59:40.240",
      "text": "پیاده روی جهنده مامنه"
    },
    {
      "id": 39,
      "start": 7180.24,
      "end": 7182.88,
      "formatted_start": "01:59:40.240",
      "formatted_end": "01:59:42.880",
      "text": "پیاده روی باید خسته نشد"
    },
    {
      "id": 40,
      "start": 7182.88,
      "end": 7191.88,
      "formatted_start": "01:59:42.880",
      "formatted_end": "01:59:51.880",
      "text": "از پیاده روی خوبه که سرپا طولانی بایستادن مثل رفش و سنی و کار خونه"
    },
    {
      "id": 41,
      "start": 7191.88,
      "end": 7196.88,
      "formatted_start": "01:59:51.880",
      "formatted_end": "01:59:56.880",
      "text": "جارو مارو نزنید و اصلا توالتتونو حتما فرنگی باشه"
    },
    {
      "id": 42,
      "start": 7196.88,
      "end": 7199.88,
      "formatted_start": "01:59:56.880",
      "formatted_end": "01:59:59.880",
      "text": "جارو این کار رو اصلا نباشه"
    }
  ],
  "status": "completed"
}