    {
      "id": 77,
      "start": 14020.0,
      "end": 14022.0,
      "formatted_start": "03:53:40.000",
      "formatted_end": "03:53:42.000",
      "text": "این رو باید برداریم"
    },
    {
      "id": 78,
      "start": 14024.0,
      "end": 14026.0,
      "formatted_start": "03:53:44.000",
      "formatted_end": "03:53:46.000",
      "text": "بارز میشه"
    },
    {
      "id": 79,
      "start": 14026.0,
      "end": 14028.0,
      "formatted_start": "03:53:46.000",
      "formatted_end": "03:53:48.000",
      "text": "نه نمیگم باید داشته شده"
    },
    {
      "id": 80,
      "start": 14028.0,
      "end": 14030.0,
      "formatted_start": "03:53:48.000",
      "formatted_end": "03:53:50.000",
      "text": "بارز میشه"
    },
    {
      "id": 81,
      "start": 14030.0,
      "end": 14032.0,
      "formatted_start": "03:53:50.000",
      "formatted_end": "03:53:52.000",
      "text": "نه اون فرق داره"
    },
    {
      "id": 82,
      "start": 14032.0,
      "end": 14034.0,
      "formatted_start": "03:53:52.000",
      "formatted_end": "03:53:54.000",
      "text": "اینجا معمولا اینجا قطعه چربیه"
    },
    {
      "id": 83,
      "start": 14034.0,
      "end": 14036.0,
      "formatted_start": "03:53:54.000",
      "formatted_end": "03:53:56.000",
      "text": "ببین"
    },
    {
      "id": 84,
      "start": 14040.0,
      "end": 14042.0,
      "formatted_start": "03:54:00.000",
      "formatted_end": "03:54:02.000",
      "text": "اینجا چربیه اینجا درست میشه"
    },
    {
      "id": 85,
      "start": 14042.0,
      "end": 14044.0,
      "formatted_start": "03:54:02.000",
      "formatted_end": "03:54:04.000",
      "text": "خطایی نداره ببین"
    },
    {
      "id": 86,
      "start": 14044.0,
      "end": 14046.0,
      "formatted_start": "03:54:04.000",
      "formatted_end": "03:54:06.000",
      "text": "چه هم نداره ببین"
    },
    {
      "id": 87,
      "start": 14046.0,
      "end": 14048.0,
      "formatted_start": "03:54:06.000",
      "formatted_end": "03:54:08.000",
      "text": "ممکنه بعض وقتا بره رو از سر درد بگه"
    },
    {
      "id": 88,
      "start": 14048.0,
      "end": 14050.0,
      "formatted_start": "03:54:08.000",
      "formatted_end": "03:54:10.000",
      "text": "ولی خیلی نمیکنه"
    },
    {
      "id": 89,
      "start": 14050.0,
      "end": 14052.0,
      "formatted_start": "03:54:10.000",
      "formatted_end": "03:54:12.000",
      "text": "اینجاست"
    },
    {
      "id": 90,
      "start": 14052.0,
      "end": 14054.0,
      "formatted_start": "03:54:12.000",
      "formatted_end": "03:54:14.000",
      "text": "از اینجوری کتابتون رو برم برم"
    },
    {
      "id": 91,
      "start": 14054.0,
      "end": 14057.0,
      "formatted_start": "03:54:14.000",
      "formatted_end": "03:54:17.000",
      "text": "برای خودم مثل مایه اون مثل اوتنون شده بود"
    },
    {
      "id": 92,
      "start": 14057.0,
      "end": 14059.0,
      "formatted_start": "03:54:17.000",
      "formatted_end": "03:54:19.000",
      "text": "دو بار عمل کردم درشون برم"
    },
    {
      "id": 93,
      "start": 14059.0,
      "end": 14061.0,
      "formatted_start": "03:54:19.000",
      "formatted_end": "03:54:21.000",
      "text": "نه اون فرق برم نداره"
    },
    {
      "id": 94,
      "start": 14061.0,
      "end": 14063.0,
      "formatted_start": "03:54:21.000",
      "formatted_end": "03:54:23.000",
      "text": "برای خطابتون"
    },
    {
      "id": 95,
      "start": 14063.0,
      "end": 14065.0,
      "formatted_start": "03:54:23.000",
      "formatted_end": "03:54:25.000",
      "text": "خب بس این دو بروی رو عمل میدی؟"
    },
    {
      "id": 96,
      "start": 14065.0,
      "end": 14067.0,
      "formatted_start": "03:54:25.000",
      "formatted_end": "03:54:27.000",
      "text": "اون بروی موماتیس نیست"
    },
    {
      "id": 97,
      "start": 14067.0,
      "end": 14068.0,
      "formatted_start": "03:54:27.000",
      "formatted_end": "03:54:28.000",
      "text": "آره"
    },
    {
      "id": 98,
      "start": 14068.0,
      "end": 14069.0,
      "formatted_start": "03:54:28.000",
      "formatted_end": "03:54:29.000",
      "text": "جا؟"
    },
    {
      "id": 99,
      "start": 14069.0,
      "end": 14071.0,
      "formatted_start": "03:54:29.000",
      "formatted_end": "03:54:31.000",
      "text": "جا من تست بی نمیسم نه بروی موماتیس نیست"
    },
    {
      "id": 100,
      "start": 14071.0,
      "end": 14073.0,
      "formatted_start": "03:54:31.000",
      "formatted_end": "03:54:33.000",
      "text": "آزمایش نه هرچی هست برای همون بروی"
    },
    {
      "id": 101,
      "start": 14073.0,
      "end": 14075.0,
      "formatted_start": "03:54:33.000",
      "formatted_end": "03:54:35.000",
      "text": "نه من موشن بپره شد"
    },
    {
      "id": 102,
      "start": 14075.0,
      "end": 14081.14,
      "formatted_start": "03:54:35.000",
      "formatted_end": "03:54:41.140",
      "text": "خانم دکتر رو همه حد یک کم در ساکت بشی میتونن من بگم چی بگوره"
    },
    {
      "id": 103,
      "start": 14081.14,
      "end": 14084.58,
      "formatted_start": "03:54:41.140",
      "formatted_end": "03:54:44.580",
      "text": "اما شما برو خانم دکتر ببینی چی میگه"
    },
    {
      "id": 104,
      "start": 14084.58,
      "end": 14088.76,
      "formatted_start": "03:54:44.580",
      "formatted_end": "03:54:48.760",
      "text": "ولی خیالت من آزمایش موان کامل میبینستم"
    },
    {
      "id": 105,
      "start": 14088.76,
      "end": 14092.48,
      "formatted_start": "03:54:48.760",
      "formatted_end": "03:54:52.480",
      "text": "من از آقا پا منی باید خیلی دردیسیم"
    },
    {
      "id": 106,
      "start": 14092.48,
      "end": 14100.0,
      "formatted_start": "03:54:52.480",
      "formatted_end": "03:55:00.000",
