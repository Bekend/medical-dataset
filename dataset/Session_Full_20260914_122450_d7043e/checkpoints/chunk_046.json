    },
    {
      "id": 48,
      "start": 13962.0,
      "end": 13964.0,
      "formatted_start": "03:52:42.000",
      "formatted_end": "03:52:44.000",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 13964.0,
      "end": 13966.0,
      "formatted_start": "03:52:44.000",
      "formatted_end": "03:52:46.000",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 13966.0,
      "end": 13968.0,
      "formatted_start": "03:52:46.000",
      "formatted_end": "03:52:48.000",
      "text": "خب این چند وقت ها میخوایی؟"
    },
