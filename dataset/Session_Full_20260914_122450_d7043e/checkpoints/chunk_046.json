      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:30.000",
      "text": "از اینجا، با اینکه از اینجا، با اینکه از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، ب"
    },
    {
      "id": 1,
      "start": 13830.0,
      "end": 13832.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:32.000",
      "text": "سرتون سمت در باشه لطفا خب"
    },
    {
      "id": 2,
      "start": 13832.0,
      "end": 13835.0,
      "formatted_start": "03:50:32.000",
      "formatted_end": "03:50:35.000",
      "text": "بعد خب دکتور کار خواستی هم انجام نمیده"
    },
    {
      "id": 3,
      "start": 13835.0,
      "end": 13836.0,
      "formatted_start": "03:50:35.000",
      "formatted_end": "03:50:36.000",
      "text": "همه کاراشو خود من انجام میده"
    },
    {
      "id": 4,
      "start": 13836.0,
      "end": 13838.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:38.000",
      "text": "کاری وقتا نشستن، کاری وقتا"
    },
    {
      "id": 5,
      "start": 13838.0,
      "end": 13840.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:40.000",
      "text": "از بعد از شوپا شدنه"
    },
    {
      "id": 6,
      "start": 13840.0,
      "end": 13842.0,
      "formatted_start": "03:50:40.000",
      "formatted_end": "03:50:42.000",
      "text": "کاری وقتا خود خشکیه"
    },
    {
      "id": 7,
      "start": 13842.0,
      "end": 13844.0,
      "formatted_start": "03:50:42.000",
      "formatted_end": "03:50:44.000",
      "text": "مفاسده اینا هست"
    },
    {
      "id": 8,
      "start": 13844.0,
      "end": 13846.0,
      "formatted_start": "03:50:44.000",
      "formatted_end": "03:50:46.000",
      "text": "یعنی مثلا فکر کنی خب اینکه کار نمی کنه"
    },
    {
      "id": 9,
      "start": 13846.0,
      "end": 13848.0,
      "formatted_start": "03:50:46.000",
      "formatted_end": "03:50:48.000",
      "text": "چرا دیست که شد که"
    },
    {
      "id": 10,
      "start": 13848.0,
      "end": 13850.0,
      "formatted_start": "03:50:48.000",
      "formatted_end": "03:50:50.000",
      "text": "یکتر ایلنت داری خود لاغری"
    },
    {
      "id": 11,
      "start": 13850.0,
      "end": 13852.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:50:52.000",
      "text": "من هر روز میگم"
    },
    {
      "id": 12,
      "start": 13852.0,
      "end": 13854.0,
      "formatted_start": "03:50:52.000",
      "formatted_end": "03:50:54.000",
      "text": "بلیغ لاغره فرمشه بخواهدم"
    },
    {
      "id": 13,
      "start": 13854.0,
      "end": 13884.0,
      "formatted_start": "03:50:54.000",
      "formatted_end": "03:51:24.000",
      "text": "از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری که از اینجوری"
    },
    {
      "id": 14,
      "start": 13884.0,
      "end": 13886.0,
      "formatted_start": "03:51:24.000",
      "formatted_end": "03:51:26.000",
      "text": "این روزه قندشون چیه؟"
    },
    {
      "id": 15,
      "start": 13886.0,
      "end": 13888.0,
      "formatted_start": "03:51:26.000",
      "formatted_end": "03:51:28.000",
      "text": "دارم تو کیف"
    },
    {
      "id": 16,
      "start": 13888.0,
      "end": 13892.0,
      "formatted_start": "03:51:28.000",
      "formatted_end": "03:51:32.000",
      "text": "روماتیز لاغر نمی کنه کسی"
    },
    {
      "id": 17,
      "start": 13892.0,
      "end": 13894.0,
      "formatted_start": "03:51:32.000",
      "formatted_end": "03:51:34.000",
      "text": "درد داره برم می کنه"
    },
    {
      "id": 18,
      "start": 13894.0,
      "end": 13898.0,
      "formatted_start": "03:51:34.000",
      "formatted_end": "03:51:38.000",
      "text": "من دوست سال داشتم سروری و از اون درمونی"
    },
    {
      "id": 19,
      "start": 13898.0,
      "end": 13900.0,
      "formatted_start": "03:51:38.000",
      "formatted_end": "03:51:40.000",
      "text": "من این درمون شد"
    },
    {
      "id": 20,
      "start": 13900.0,
      "end": 13902.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:42.000",
      "text": "خواهیم درمون شد"
    },
    {
      "id": 21,
      "start": 13902.0,
      "end": 13904.0,
      "formatted_start": "03:51:42.000",
      "formatted_end": "03:51:44.000",
      "text": "نه وقتی برامشم سر بکنیم درد بکنیم"
    },
    {
      "id": 22,
      "start": 13904.0,
      "end": 13906.0,
      "formatted_start": "03:51:44.000",
      "formatted_end": "03:51:46.000",
      "text": "این روزه که با می داند درد بکنیم"
    },
    {
      "id": 23,
      "start": 13906.0,
      "end": 13908.0,
      "formatted_start": "03:51:46.000",
      "formatted_end": "03:51:48.000",
      "text": "نه اون شبه همون دوخ نبا ماماسا"
    },
    {
      "id": 24,
      "start": 13908.0,
      "end": 13910.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:50.000",
      "text": "خیلی درد می شدم"
    },
    {
      "id": 25,
      "start": 13910.0,
      "end": 13912.0,
      "formatted_start": "03:51:50.000",
      "formatted_end": "03:51:52.000",
      "text": "اما ظلم"
    },
    {
      "id": 26,
      "start": 13912.0,
      "end": 13914.0,
      "formatted_start": "03:51:52.000",
      "formatted_end": "03:51:54.000",
      "text": "اوه، کجا درد داریم؟"
    },
    {
      "id": 27,
      "start": 13914.0,
      "end": 13915.0,
      "formatted_start": "03:51:54.000",
      "formatted_end": "03:51:55.000",
      "text": "کجا درد داری؟"
    },
    {
      "id": 28,
      "start": 13915.0,
      "end": 13921.0,
      "formatted_start": "03:51:55.000",
      "formatted_end": "03:52:01.000",
      "text": "زنون هم اینجا، از اینجا خانمتو گرم، اینجا میگه آن بروش بروشه"
    },
    {
      "id": 29,
      "start": 13921.0,
      "end": 13924.0,
      "formatted_start": "03:52:01.000",
      "formatted_end": "03:52:04.000",
      "text": "و از اینجا سرشن میگرده تو ساقه خانخون"
    },
    {
      "id": 30,
      "start": 13924.0,
      "end": 13926.0,
      "formatted_start": "03:52:04.000",
      "formatted_end": "03:52:06.000",
      "text": "شلزن شلزن ببخشید"
    },
    {
      "id": 31,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "اینجا همون درد رو داری؟"
    },
    {
      "id": 32,
      "start": 13928.0,
      "end": 13929.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:09.000",
      "text": "آره آره درد"
    },
    {
      "id": 33,
      "start": 13929.0,
      "end": 13934.0,
      "formatted_start": "03:52:09.000",
      "formatted_end": "03:52:14.000",
      "text": "همه از سر روحانتون، این تو استخونه، این درد گیره هم، ساق ساق"
    },
    {
      "id": 34,
      "start": 13934.0,
      "end": 13936.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:16.000",
      "text": "درد نداری"
    },
    {
      "id": 35,
      "start": 13936.0,
      "end": 13938.0,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:18.000",
      "text": "حالا؟"
    },
    {
      "id": 36,
      "start": 13938.0,
      "end": 13940.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:20.000",
      "text": "درد داره زنون درد برونه"
    },
    {
      "id": 37,
      "start": 13940.0,
      "end": 13942.0,
      "formatted_start": "03:52:20.000",
      "formatted_end": "03:52:22.000",
      "text": "دردی که میگیری اینه؟"
    },
    {
      "id": 38,
      "start": 13942.0,
      "end": 13944.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:24.000",
      "text": "آره زنون"
    },
    {
      "id": 39,
      "start": 13944.0,
      "end": 13946.0,
      "formatted_start": "03:52:24.000",
      "formatted_end": "03:52:26.000",
      "text": "اون کمر که دردی میگیری؟"
    },
    {
      "id": 40,
      "start": 13946.0,
      "end": 13948.0,
      "formatted_start": "03:52:26.000",
      "formatted_end": "03:52:28.000",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 13948.0,
      "end": 13950.0,
      "formatted_start": "03:52:28.000",
      "formatted_end": "03:52:30.000",
      "text": "اینجا هست"
    },
    {
      "id": 42,
      "start": 13950.0,
      "end": 13952.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:32.000",
      "text": "توی خفره سر و سخون میترخه"
    },
    {
      "id": 43,
      "start": 13952.0,
      "end": 13954.0,
      "formatted_start": "03:52:32.000",
      "formatted_end": "03:52:34.000",
      "text": "اونجا آتو بازی شده"
    },
    {
      "id": 44,
      "start": 13954.0,
      "end": 13956.0,
      "formatted_start": "03:52:34.000",
      "formatted_end": "03:52:36.000",
