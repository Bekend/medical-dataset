      "text": "از اینجا باید بردارو میدهیم، اگر بر سه چهار روز دیگه رو بهتر شدن برید، کامل خوب شدید شب نشدید سی تیزکن هم الان منویزن برید، همون بیمار سا نزد مزدونه ها رو همونجا انجام بدید."
    },
    {
      "id": 1,
      "start": 4822.0,
      "end": 4828.12,
      "formatted_start": "01:20:22.000",
      "formatted_end": "01:20:28.120",
      "text": "چون که ببینیم ریاکتون یکم صدا میداده جا داره که این همه دود هم هیچ وقت تماس نداشتی"
    },
    {
      "id": 2,
      "start": 4828.12,
      "end": 4829.64,
      "formatted_start": "01:20:28.120",
      "formatted_end": "01:20:29.640",
      "text": "کورومان را گرفته بودی؟"
    },
    {
      "id": 3,
      "start": 4829.64,
      "end": 4831.16,
      "formatted_start": "01:20:29.640",
      "formatted_end": "01:20:31.160",
      "text": "قبلن خفیف گرفته بودم"
    },
    {
      "id": 4,
      "start": 4831.16,
      "end": 4835.94,
      "formatted_start": "01:20:31.160",
      "formatted_end": "01:20:35.940",
      "text": "مثلا همه خسپس از اون موقعی میبود"
    },
    {
      "id": 5,
      "start": 4835.94,
      "end": 4837.86,
      "formatted_start": "01:20:35.940",
      "formatted_end": "01:20:37.860",
      "text": "تنگ نفس آباده بودم"
    },
    {
      "id": 6,
      "start": 4837.86,
      "end": 4839.42,
      "formatted_start": "01:20:37.860",
      "formatted_end": "01:20:39.420",
      "text": "یه آسم خفیف داری"
    },
    {
      "id": 7,
      "start": 4839.42,
      "end": 4841.56,
      "formatted_start": "01:20:39.420",
      "formatted_end": "01:20:41.560",
      "text": "البته ببینیم برای چی؟"
    },
    {
      "id": 8,
      "start": 4841.56,
      "end": 4841.9,
      "formatted_start": "01:20:41.560",
      "formatted_end": "01:20:41.900",
      "text": "الو"
    },
    {
      "id": 9,
      "start": 4841.9,
      "end": 4844.0,
      "formatted_start": "01:20:41.900",
      "formatted_end": "01:20:44.000",
      "text": "نبویدیوالو مانده داریم"
    },
    {
      "id": 10,
      "start": 4844.74,
      "end": 4845.1,
      "formatted_start": "01:20:44.740",
      "formatted_end": "01:20:45.100",
      "text": "چون؟"
    },
    {
      "id": 11,
      "start": 4845.1,
      "end": 4845.62,
      "formatted_start": "01:20:45.100",
      "formatted_end": "01:20:45.620",
      "text": "تیروی"
    },
    {
      "id": 12,
      "start": 4845.62,
      "end": 4847.78,
      "formatted_start": "01:20:45.620",
      "formatted_end": "01:20:47.780",
      "text": "چون آزما شده"
    },
    {
      "id": 13,
      "start": 4847.78,
      "end": 4849.28,
      "formatted_start": "01:20:47.780",
      "formatted_end": "01:20:49.280",
      "text": "از اون ششمانه شده"
    },
    {
      "id": 14,
      "start": 4849.28,
      "end": 4851.04,
      "formatted_start": "01:20:49.280",
      "formatted_end": "01:20:51.040",
      "text": "منم خوب شده"
    },
    {
      "id": 15,
      "start": 4851.04,
      "end": 4856.04,
      "formatted_start": "01:20:51.040",
      "formatted_end": "01:20:56.040",
      "text": "پشت مامانو تو حتما همیشه بازید چرب کنید که دیگه نسوزم اونجوری نشه خب"
    },
    {
      "id": 16,
      "start": 4856.04,
      "end": 4857.04,
      "formatted_start": "01:20:56.040",
      "formatted_end": "01:20:57.040",
      "text": "بله بله بله بله"
    },
    {
      "id": 17,
      "start": 4857.04,
      "end": 4866.04,
      "formatted_start": "01:20:57.040",
      "formatted_end": "01:21:06.040",
      "text": "دیگه اون اتفاق مثل اووار دیگه ازید نشه دیگه چاره اینیست باید پشتش همیشه چرب باشه که نسوزم اونجوری شیافون همش باید بهش بدید"
    },
    {
      "id": 18,
      "start": 4866.04,
      "end": 4867.04,
      "formatted_start": "01:21:06.040",
      "formatted_end": "01:21:07.040",
      "text": "که پشتش درخواهش نشه"
    },
    {
      "id": 19,
      "start": 4867.04,
      "end": 4871.04,
      "formatted_start": "01:21:07.040",
      "formatted_end": "01:21:11.040",
      "text": "آره دکترانی خوب اماران کنید و اون احتیاری مدفع داره"
    },
    {
      "id": 20,
      "start": 4871.04,
      "end": 4872.04,
      "formatted_start": "01:21:11.040",
      "formatted_end": "01:21:12.040",
      "text": "آره"
    },
    {
      "id": 21,
      "start": 4872.04,
      "end": 4874.04,
      "formatted_start": "01:21:12.040",
      "formatted_end": "01:21:14.040",
      "text": "برای ما چیزی نداره"
    },
    {
      "id": 22,
      "start": 4874.04,
      "end": 4877.04,
      "formatted_start": "01:21:14.040",
      "formatted_end": "01:21:17.040",
      "text": "نه اصلا از اول مشکلش همین بود"
    },
    {
      "id": 23,
      "start": 4877.04,
      "end": 4878.04,
      "formatted_start": "01:21:17.040",
      "formatted_end": "01:21:18.040",
      "text": "از اون اول"
    },
    {
      "id": 24,
      "start": 4878.04,
      "end": 4881.04,
      "formatted_start": "01:21:18.040",
      "formatted_end": "01:21:21.040",
      "text": "ماما همین بوده اصلا بند خدا از خانه بوده"
    },
    {
      "id": 25,
      "start": 4886.04,
      "end": 4889.04,
      "formatted_start": "01:21:26.040",
      "formatted_end": "01:21:29.040",
      "text": "افونده تو خونش هم از بس که سر رفته بود"
    },
    {
      "id": 26,
      "start": 4889.04,
      "end": 4890.04,
      "formatted_start": "01:21:29.040",
      "formatted_end": "01:21:30.040",
      "text": "پشتش زخم شده بود"
    },
    {
      "id": 27,
      "start": 4890.04,
      "end": 4892.04,
      "formatted_start": "01:21:30.040",
      "formatted_end": "01:21:32.040",
      "text": "الان از که زخماش خوب شد و شیاپار میزده"
    },
    {
      "id": 28,
      "start": 4892.04,
      "end": 4894.04,
      "formatted_start": "01:21:32.040",
      "formatted_end": "01:21:34.040",
      "text": "الان حالش خوبه بی قرار نیست"
    },
    {
      "id": 29,
      "start": 4894.04,
      "end": 4895.04,
      "formatted_start": "01:21:34.040",
      "formatted_end": "01:21:35.040",
      "text": "از اینکه نمی کنه"
    },
    {
      "id": 30,
      "start": 4895.04,
      "end": 4896.04,
      "formatted_start": "01:21:35.040",
      "formatted_end": "01:21:36.040",
      "text": "کم داره کم"
    },
    {
      "id": 31,
      "start": 4896.04,
      "end": 4898.04,
      "formatted_start": "01:21:36.040",
      "formatted_end": "01:21:38.040",
      "text": "دیسر این روز عصابش دادم"
    },
    {
      "id": 32,
      "start": 4898.04,
      "end": 4901.04,
      "formatted_start": "01:21:38.040",
      "formatted_end": "01:21:41.040",
      "text": "استناه هیچی وقت داراشو قد نکنیم"
    },
    {
      "id": 33,
      "start": 4901.04,
      "end": 4903.04,
      "formatted_start": "01:21:41.040",
      "formatted_end": "01:21:43.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 34,
      "start": 4903.04,
      "end": 4905.04,
      "formatted_start": "01:21:43.040",
      "formatted_end": "01:21:45.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 35,
      "start": 4905.04,
      "end": 4907.04,
      "formatted_start": "01:21:45.040",
      "formatted_end": "01:21:47.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 36,
      "start": 4907.04,
      "end": 4909.04,
      "formatted_start": "01:21:47.040",
      "formatted_end": "01:21:49.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 37,
      "start": 4909.04,
      "end": 4911.04,
      "formatted_start": "01:21:49.040",
      "formatted_end": "01:21:51.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 38,
      "start": 4911.04,
      "end": 4913.04,
      "formatted_start": "01:21:51.040",
      "formatted_end": "01:21:53.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 39,
      "start": 4913.04,
      "end": 4915.04,
      "formatted_start": "01:21:53.040",
      "formatted_end": "01:21:55.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 40,
      "start": 4915.04,
      "end": 4917.04,
      "formatted_start": "01:21:55.040",
      "formatted_end": "01:21:57.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 41,
      "start": 4917.04,
      "end": 4919.04,
      "formatted_start": "01:21:57.040",
      "formatted_end": "01:21:59.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 42,
      "start": 4919.04,
      "end": 4921.04,
      "formatted_start": "01:21:59.040",
      "formatted_end": "01:22:01.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 43,
      "start": 4921.04,
      "end": 4923.04,
      "formatted_start": "01:22:01.040",
      "formatted_end": "01:22:03.040",
      "text": "از دروه هایی نوشته باشید"
    },
    {
      "id": 44,
      "start": 4923.04,
      "end": 4929.92,
      "formatted_start": "01:22:03.040",
      "formatted_end": "01:22:09.920",
      "text": "خانم مقصود دارو دارو بود نه هرکو وضعیت میکنه"
    },
    {
      "id": 45,
      "start": 4929.92,
      "end": 4931.04,
      "formatted_start": "01:22:09.920",
      "formatted_end": "01:22:11.040",
      "text": "کی؟ برماتره؟"
    },
    {
      "id": 46,
      "start": 4931.04,
      "end": 4931.86,
      "formatted_start": "01:22:11.040",
      "formatted_end": "01:22:11.860",
      "text": "نه برم خوده"
    },
    {
      "id": 47,
      "start": 4931.86,
      "end": 4933.88,
      "formatted_start": "01:22:11.860",
      "formatted_end": "01:22:13.880",
      "text": "شروط بوده چی بود؟"
    },
    {
      "id": 48,
      "start": 4933.88,
      "end": 4935.96,
      "formatted_start": "01:22:13.880",
      "formatted_end": "01:22:15.960",
      "text": "نه شروط ریه بوده چی نیمی کرده"
    },
    {
      "id": 49,
      "start": 4935.96,
      "end": 4938.76,
      "formatted_start": "01:22:15.960",
      "formatted_end": "01:22:18.760",
      "text": "همونو یه داری خونه دیگه"
    },
    {
      "id": 50,
      "start": 4938.76,
      "end": 4940.24,
      "formatted_start": "01:22:18.760",
      "formatted_end": "01:22:20.240",
      "text": "نه بودی"
    },
    {
      "id": 51,
      "start": 4940.24,
      "end": 4942.42,
      "formatted_start": "01:22:20.240",
      "formatted_end": "01:22:22.420",
      "text": "نه نه"
    },
    {
      "id": 52,
      "start": 4942.42,
      "end": 4945.16,
      "formatted_start": "01:22:22.420",
      "formatted_end": "01:22:25.160",
      "text": "این راستانه همه چیز داره"
    },
    {
      "id": 53,
      "start": 4945.16,
      "end": 4946.32,
      "formatted_start": "01:22:25.160",
      "formatted_end": "01:22:26.320",
      "text": "بله"
    },
    {
      "id": 54,
      "start": 4946.32,
      "end": 4949.04,
      "formatted_start": "01:22:26.320",
      "formatted_end": "01:22:29.040",
      "text": "خردتون سبزه؟"
    },
    {
      "id": 55,
      "start": 4949.78,
      "end": 4951.62,
      "formatted_start": "01:22:29.780",
      "formatted_end": "01:22:31.620",
      "text": "خردت؟ چرکیه دیگه"
    },
    {
      "id": 56,
      "start": 4951.62,
      "end": 4953.62,
      "formatted_start": "01:22:31.620",
      "formatted_end": "01:22:33.620",
      "text": "رنگ سبز و زرف داره"
    },
    {
      "id": 57,
      "start": 4953.62,
      "end": 4955.62,
      "formatted_start": "01:22:33.620",
      "formatted_end": "01:22:35.620",
      "text": "آره، بعضی که خشکه میزنه صبح"
    },
    {
      "id": 58,
      "start": 4955.62,
      "end": 4957.62,
      "formatted_start": "01:22:35.620",
      "formatted_end": "01:22:37.620",
      "text": "وقتی که مذرک میخواند"
    },
    {
      "id": 59,
      "start": 4957.62,
      "end": 4959.62,
      "formatted_start": "01:22:37.620",
      "formatted_end": "01:22:39.620",
      "text": "دیگه باید مجبورم بگم"
    },
    {
      "id": 60,
      "start": 4959.62,
      "end": 4961.62,
      "formatted_start": "01:22:39.620",
      "formatted_end": "01:22:41.620",
      "text": "اینجور که میکنه میکنه، میاد یه گنده"
    },
    {
      "id": 61,
      "start": 4961.62,
      "end": 4963.62,
      "formatted_start": "01:22:41.620",
      "formatted_end": "01:22:43.620",
      "text": "انگار اندازه آدم است بیاد"
    },
    {
      "id": 62,
      "start": 4963.62,
      "end": 4965.62,
      "formatted_start": "01:22:43.620",
      "formatted_end": "01:22:45.620",
      "text": "شب که تا صبح خلط ریز و درشت"
    },
    {
      "id": 63,
      "start": 4965.62,
      "end": 4967.62,
      "formatted_start": "01:22:45.620",
      "formatted_end": "01:22:47.620",
      "text": "و همجور میاد"
    },
    {
      "id": 64,
      "start": 4967.62,
      "end": 4969.62,
      "formatted_start": "01:22:47.620",
      "formatted_end": "01:22:49.620",
      "text": "قد که نداره نه"
    },
    {
      "id": 65,
      "start": 4969.62,
      "end": 4971.62,
      "formatted_start": "01:22:49.620",
      "formatted_end": "01:22:51.620",
      "text": "دارم آه، حالا قد رو خواستم بگم"
    },
    {
      "id": 66,
      "start": 4971.62,
      "end": 4973.62,
      "formatted_start": "01:22:51.620",
      "formatted_end": "01:22:53.620",
      "text": "چنگه چونه مهمونه والا نمیدونه"
    },
    {
      "id": 67,
      "start": 4973.62,
      "end": 4975.62,
      "formatted_start": "01:22:53.620",
      "formatted_end": "01:22:55.620",
      "text": "مانه درم"
    },
    {
      "id": 68,
      "start": 4975.62,
      "end": 4977.62,
      "formatted_start": "01:22:55.620",
      "formatted_end": "01:22:57.620",
      "text": "بلد"
    },
    {
      "id": 69,
      "start": 4977.62,
      "end": 4979.62,
      "formatted_start": "01:22:57.620",
      "formatted_end": "01:22:59.620",
      "text": "اسم داروار"
    },
    {
      "id": 70,
      "start": 4979.62,
      "end": 4981.62,
      "formatted_start": "01:22:59.620",
      "formatted_end": "01:23:01.620",
      "text": "این را نمیدونیم"
    },
    {
      "id": 71,
      "start": 4981.62,
      "end": 4983.62,
      "formatted_start": "01:23:01.620",
      "formatted_end": "01:23:03.620",
      "text": "چی را بگویید؟"
    },
    {
      "id": 72,
      "start": 4983.62,
      "end": 4985.62,
      "formatted_start": "01:23:03.620",
      "formatted_end": "01:23:05.620",
      "text": "این را نمیخواییم"
    },
    {
      "id": 73,
      "start": 4985.62,
      "end": 4987.62,
      "formatted_start": "01:23:05.620",
      "formatted_end": "01:23:07.620",
      "text": "چون این را بگویید؟"
    },
    {
      "id": 74,
      "start": 4987.62,
      "end": 4989.62,
      "formatted_start": "01:23:07.620",
      "formatted_end": "01:23:09.620",
      "text": "این را بخورده ندارد"
    },
    {
      "id": 75,
      "start": 4989.62,
      "end": 4991.62,
      "formatted_start": "01:23:09.620",
      "formatted_end": "01:23:11.620",
      "text": "شبا یک کاشوک منفق خوری بخورید"
    },
    {
      "id": 76,
      "start": 4991.62,
      "end": 4993.62,
      "formatted_start": "01:23:11.620",
      "formatted_end": "01:23:13.620",
      "text": "چون این کم درزه شد"
    },
    {
      "id": 77,
      "start": 4993.62,
      "end": 4995.62,
      "formatted_start": "01:23:13.620",
      "formatted_end": "01:23:15.620",
      "text": "دست میده"
    },
    {
      "id": 78,
      "start": 4995.62,
      "end": 4997.62,
      "formatted_start": "01:23:15.620",
      "formatted_end": "01:23:17.620",
      "text": "شبا یک کاشوک منفق خوری بخورید"
    },
    {
      "id": 79,
      "start": 4997.62,
      "end": 4999.62,
      "formatted_start": "01:23:17.620",
      "formatted_end": "01:23:19.620",
      "text": "من خودشم گفت خانم دکتر خانم"
    },
    {
      "id": 80,
      "start": 4999.62,
      "end": 5001.62,
      "formatted_start": "01:23:19.620",
      "formatted_end": "01:23:21.620",
      "text": "شبا یک کاشوک منفق خوری بخورید"
    },
    {
      "id": 81,
      "start": 5001.62,
      "end": 5003.62,
      "formatted_start": "01:23:21.620",
      "formatted_end": "01:23:23.620",
      "text": "شبا یک کاشوک منفق خوری بخورید"
    },
    {
      "id": 82,
      "start": 5003.62,
      "end": 5005.62,
      "formatted_start": "01:23:23.620",
      "formatted_end": "01:23:25.620",
      "text": "حالا باز یک تا دفتر خوردم"
    },
    {
      "id": 83,
      "start": 5005.62,
      "end": 5007.62,
      "formatted_start": "01:23:25.620",
      "formatted_end": "01:23:27.620",
      "text": "برده بخوردم دوباره قط کردم دوباره بخورم"
    },
    {
      "id": 84,
      "start": 5007.62,
      "end": 5009.62,
      "formatted_start": "01:23:27.620",
      "formatted_end": "01:23:29.620",
      "text": "گفت نداره الان بگو تونم دارو بیدم"
    },
    {
      "id": 85,
      "start": 5009.62,
      "end": 5011.62,
      "formatted_start": "01:23:29.620",
      "formatted_end": "01:23:31.620",
      "text": "ببینی دیگه شما یه آس ندارد خب؟"
    },
    {
      "id": 86,
      "start": 5011.62,
      "end": 5013.62,
      "formatted_start": "01:23:31.620",
      "formatted_end": "01:23:33.620",
      "text": "نه"
    },
    {
      "id": 87,
      "start": 5013.62,
      "end": 5015.62,
      "formatted_start": "01:23:33.620",
      "formatted_end": "01:23:35.620",
      "text": "خوب نمیشه که"
    },
    {
      "id": 88,
      "start": 5015.62,
      "end": 5017.62,
      "formatted_start": "01:23:35.620",
      "formatted_end": "01:23:37.620",
      "text": "الان میخواد برد به ایران"
    },
    {
      "id": 89,
      "start": 5017.62,
      "end": 5019.62,
      "formatted_start": "01:23:37.620",
      "formatted_end": "01:23:39.620",
      "text": "خواب پرده پس پرده"
    },
    {
      "id": 90,
      "start": 5019.62,
      "end": 5021.62,
      "formatted_start": "01:23:39.620",
      "formatted_end": "01:23:41.620",
      "text": "اینو برده برده استرس"
    },
    {
      "id": 91,
      "start": 5021.62,
      "end": 5023.62,
      "formatted_start": "01:23:41.620",
      "formatted_end": "01:23:43.620",
      "text": "مادر ارسا برده"
    },
    {
      "id": 92,
      "start": 5023.62,
      "end": 5025.62,
      "formatted_start": "01:23:43.620",
      "formatted_end": "01:23:45.620",
      "text": "خود ارس همین میتونی"
    },
    {
      "id": 93,
      "start": 5025.62,
      "end": 5027.62,
      "formatted_start": "01:23:45.620",
      "formatted_end": "01:23:47.620",
      "text": "یک کدوم چی برده برده بسیار"
    },
    {
      "id": 94,
      "start": 5027.62,
      "end": 5029.62,
      "formatted_start": "01:23:47.620",
      "formatted_end": "01:23:49.620",
      "text": "که اینو برده برده بشه کنه"
    },
    {
      "id": 95,
      "start": 5029.62,
      "end": 5031.62,
      "formatted_start": "01:23:49.620",
      "formatted_end": "01:23:51.620",
      "text": "اینو گفت دکتورم"
    },
    {
      "id": 96,
      "start": 5031.62,
      "end": 5036.42,
      "formatted_start": "01:23:51.620",
      "formatted_end": "01:23:56.420",
      "text": "درکتورم میگه هیچ عنوانی مشابهنش نباشه یا شرکت دیگه نباشه"
    },
    {
      "id": 97,
      "start": 5036.42,
      "end": 5038.86,
      "formatted_start": "01:23:56.420",
      "formatted_end": "01:23:58.860",
      "text": "خب مدار خونه بگو من همه شرکت رو میرون"
    },
    {
      "id": 98,
      "start": 5038.86,
      "end": 5039.32,
      "formatted_start": "01:23:58.860",
      "formatted_end": "01:23:59.320",
      "text": "خب"
    },
    {
      "id": 99,
      "start": 5039.32,
      "end": 5042.1,
      "formatted_start": "01:23:59.320",
      "formatted_end": "01:24:02.100",
      "text": "از هر کدوم ده دونه برنیم سم"
    },
    {
      "id": 100,
      "start": 5042.1,
      "end": 5044.54,
      "formatted_start": "01:24:02.100",
      "formatted_end": "01:24:04.540",
      "text": "آره چون برم تیره ها رو بیرنم مصابهت"
    },
    {
      "id": 101,
      "start": 5044.54,
      "end": 5045.66,
      "formatted_start": "01:24:04.540",
      "formatted_end": "01:24:05.660",
      "text": "خودم میرم پیشش"
    },
    {
      "id": 102,
      "start": 5045.66,
      "end": 5046.7,
      "formatted_start": "01:24:05.660",
      "formatted_end": "01:24:06.700",
      "text": "من اینه خود نمی کنم"
    },
    {
      "id": 103,
      "start": 5046.7,
      "end": 5048.12,
      "formatted_start": "01:24:06.700",
      "formatted_end": "01:24:08.120",
      "text": "دو ساله میرم پیشش"
    },
    {
      "id": 104,
      "start": 5048.12,
      "end": 5049.0,
      "formatted_start": "01:24:08.120",
      "formatted_end": "01:24:09.000",
      "text": "باشه بیرون"
    },
    {
      "id": 105,
      "start": 5049.0,
      "end": 5055.26,
      "formatted_start": "01:24:09.000",
      "formatted_end": "01:24:15.260",
      "text": "این جوشان براتون میرن سم خب"
    },
    {
      "id": 106,
      "start": 5055.26,
      "end": 5059.42,
      "formatted_start": "01:24:15.260",
      "formatted_end": "01:24:19.420",
      "text": "این کارش اینه که خیلی تو شرکنه که بیار بیرون خب"
    },
    {
      "id": 107,
      "start": 5059.42,
      "end": 5061.42,
      "formatted_start": "01:24:19.420",
      "formatted_end": "01:24:21.420",
      "text": "او نیست"
    },
    {
      "id": 108,
      "start": 5061.42,
      "end": 5063.42,
      "formatted_start": "01:24:21.420",
      "formatted_end": "01:24:23.420",
      "text": "مثل مادرم که منظورم مذرعت باشم"
    },
    {
      "id": 109,
      "start": 5063.42,
      "end": 5065.42,
      "formatted_start": "01:24:23.420",
      "formatted_end": "01:24:25.420",
      "text": "همچنین من از اینکه من فرشتیم"
    },
    {
      "id": 110,
      "start": 5065.42,
      "end": 5067.42,
      "formatted_start": "01:24:25.420",
      "formatted_end": "01:24:27.420",
      "text": "یک سرس برامونم فرشتیم"
    },
    {
      "id": 111,
      "start": 5067.42,
      "end": 5069.42,
      "formatted_start": "01:24:27.420",
      "formatted_end": "01:24:29.420",
      "text": "الان که دیشب که صرفه"
    },
    {
      "id": 112,
      "start": 5069.42,
      "end": 5071.42,
      "formatted_start": "01:24:29.420",
      "formatted_end": "01:24:31.420",
      "text": "صرفه صوب هم خوردم"
    },
    {
      "id": 113,
      "start": 5071.42,
      "end": 5073.42,
      "formatted_start": "01:24:31.420",
      "formatted_end": "01:24:33.420",
      "text": "کم روغن"
    },
    {
      "id": 114,
      "start": 5073.42,
      "end": 5075.42,
      "formatted_start": "01:24:33.420",
      "formatted_end": "01:24:35.420",
      "text": "ترشت زیاد نمی کنی؟"
    },
    {
      "id": 115,
      "start": 5075.42,
      "end": 5077.42,
      "formatted_start": "01:24:35.420",
      "formatted_end": "01:24:37.420",
      "text": "اصلا ترشتی نمی ریزم"
    },
    {
      "id": 116,
      "start": 5077.42,
      "end": 5079.42,
      "formatted_start": "01:24:37.420",
      "formatted_end": "01:24:39.420",
      "text": "نه خودتون میرهتون ترشت زیاد نمی ریزم"
    },
    {
      "id": 117,
      "start": 5079.42,
      "end": 5081.42,
      "formatted_start": "01:24:39.420",
      "formatted_end": "01:24:41.420",
      "text": "نه از اینکه من میره مشکل ندارم"
    },
    {
      "id": 118,
      "start": 5081.42,
      "end": 5083.42,
      "formatted_start": "01:24:41.420",
      "formatted_end": "01:24:43.420",
      "text": "تو عادت همه جایی باید سرخا باستم"
    },
    {
      "id": 119,
      "start": 5083.42,
      "end": 5085.42,
      "formatted_start": "01:24:43.420",
      "formatted_end": "01:24:45.420",
      "text": "اینجا میگی به چی نگه؟"
    },
    {
      "id": 120,
      "start": 5087.42,
      "end": 5093.42,
      "formatted_start": "01:24:47.420",
      "formatted_end": "01:24:53.420",
      "text": "این اسپیلو دارین یک چالیه خود خارجه اینو باید پیدا کنید از حلال احمدی جایی"
    },
    {
      "id": 121,
      "start": 5093.42,
      "end": 5096.42,
      "formatted_start": "01:24:53.420",
      "formatted_end": "01:24:56.420",
      "text": "بعد از اینکه میزنید نرمتون رو بشورید"
    },
    {
      "id": 122,
      "start": 5096.42,
      "end": 5099.42,
      "formatted_start": "01:24:56.420",
      "formatted_end": "01:24:59.420",
      "text": "چون براتون واجب است جز داروها تونه بیدید"
    }
  ],
  "status": "completed"
}