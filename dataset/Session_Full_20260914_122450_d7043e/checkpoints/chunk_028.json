  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8405.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:05.000",
      "text": "پشاک بیشتر پایینه تا که بالا."
    },
    {
      "id": 1,
      "start": 8405.0,
      "end": 8413.0,
      "formatted_start": "02:20:05.000",
      "formatted_end": "02:20:13.000",
      "text": "قرص فشار داره، قرص فشار بالا داره، یه باری مثلا خونتی بینی کرده بود، از اونجا بهش داده بودن."
    },
    {
      "id": 2,
      "start": 8413.0,
      "end": 8417.0,
      "formatted_start": "02:20:13.000",
      "formatted_end": "02:20:17.000",
      "text": "پس جوش میزنه، گاهی فشارش میزنه بالا."
    },
    {
      "id": 3,
      "start": 8421.0,
      "end": 8427.0,
      "formatted_start": "02:20:21.000",
      "formatted_end": "02:20:27.000",
      "text": "خانده جو نرده نرات صالح داریم، الان آن پول واکسن آن فرانزا اومده که برش سر کنه."
    },
    {
      "id": 4,
      "start": 8427.0,
      "end": 8457.0,
      "formatted_start": "02:20:27.000",
      "formatted_end": "02:20:57.000",
      "text": "برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای"
    },
