  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5102.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:02.000",
      "text": "چرا نداریم؟"
    },
    {
      "id": 1,
      "start": 5102.0,
      "end": 5104.0,
      "formatted_start": "01:25:02.000",
      "formatted_end": "01:25:04.000",
      "text": "آره، من رو گندم و مینو رو می‌کنم."
    },
    {
      "id": 2,
      "start": 5104.0,
      "end": 5106.0,
      "formatted_start": "01:25:04.000",
      "formatted_end": "01:25:06.000",
      "text": "چرا می‌شون بدم؟"
    },
    {
      "id": 3,
      "start": 5106.0,
      "end": 5108.0,
      "formatted_start": "01:25:06.000",
      "formatted_end": "01:25:08.000",
      "text": "برونم آره."
    },
    {
      "id": 4,
      "start": 5108.0,
      "end": 5110.0,
      "formatted_start": "01:25:08.000",
      "formatted_end": "01:25:10.000",
      "text": "خاطر گندم ببینی که یه برقه نداری که تو چی کن؟"
    },
    {
      "id": 5,
      "start": 5110.0,
      "end": 5114.0,
      "formatted_start": "01:25:10.000",
      "formatted_end": "01:25:14.000",
      "text": "چون در دین مادرمان من هم که ثبات ندارم، دستگاه غنم ندارم، اصلاً بودم."
    },
    {
      "id": 6,
      "start": 5114.0,
      "end": 5120.0,
      "formatted_start": "01:25:14.000",
      "formatted_end": "01:25:20.000",
      "text": "چون این گانی ها داره، یعنی مرض سرخواه رو خوب و خوش، مامانتون ما شاده هیچ مشکلی نداره."
    },
    {
      "id": 7,
      "start": 5120.0,
      "end": 5124.3,
      "formatted_start": "01:25:20.000",
      "formatted_end": "01:25:24.300",
      "text": "این از از مخصلای پای سالم"
    },
    {
      "id": 8,
      "start": 5124.3,
      "end": 5125.84,
      "formatted_start": "01:25:24.300",
      "formatted_end": "01:25:25.840",
      "text": "هیچ مشکل ندارم"
    },
    {
      "id": 9,
      "start": 5125.84,
      "end": 5129.24,
      "formatted_start": "01:25:25.840",
      "formatted_end": "01:25:29.240",
      "text": "خانم ندیده بود و پاسله نداشته باشه"
    },
    {
      "id": 10,
      "start": 5129.24,
      "end": 5133.46,
      "formatted_start": "01:25:29.240",
      "formatted_end": "01:25:33.460",
      "text": "کمر سالم، گردان سالم، پاها سالم"
    },
    {
      "id": 11,
      "start": 5133.46,
      "end": 5137.8,
      "formatted_start": "01:25:33.460",
      "formatted_end": "01:25:37.800",
      "text": "با این سن باید یک علامت از پاهاش داشته باشه"
    },
    {
      "id": 12,
      "start": 5137.8,
      "end": 5140.88,
      "formatted_start": "01:25:37.800",
      "formatted_end": "01:25:40.880",
      "text": "درست دارید همیشه ادرالات و صندش رو نگاه کنید"
    },
    {
      "id": 13,
      "start": 5140.88,
      "end": 5144.0,
      "formatted_start": "01:25:40.880",
      "formatted_end": "01:25:44.000",
      "text": "اگه دیدید توش تیکه داره یا کلره"
    },
    {
      "id": 14,
      "start": 5144.0,
      "end": 5146.0,
      "formatted_start": "01:25:44.000",
      "formatted_end": "01:25:46.000",
      "text": "یعنی که دیگه داره عفونت میکنه"
    },
    {
      "id": 15,
      "start": 5146.0,
      "end": 5147.76,
      "formatted_start": "01:25:46.000",
      "formatted_end": "01:25:47.760",
      "text": "همیشه حاضرتون باشه"
    },
    {
      "id": 16,
      "start": 5147.76,
      "end": 5150.58,
      "formatted_start": "01:25:47.760",
      "formatted_end": "01:25:50.580",
      "text": "آدم هم برای مامان نوشتم خوش کنشو البته"
    },
    {
      "id": 17,
      "start": 5150.58,
      "end": 5152.3,
      "formatted_start": "01:25:50.580",
      "formatted_end": "01:25:52.300",
      "text": "همه ای دارواشو کامل بگیریم"
    },
    {
      "id": 18,
      "start": 5152.3,
      "end": 5153.3,
      "formatted_start": "01:25:52.300",
      "formatted_end": "01:25:53.300",
      "text": "آره خوش کنم دارتوش"
    },
    {
      "id": 19,
      "start": 5153.3,
      "end": 5156.8,
      "formatted_start": "01:25:53.300",
      "formatted_end": "01:25:56.800",
      "text": "همون نسخه رو همه عمرشو کامل بگیریم خب"
    },
    {
      "id": 20,
      "start": 5156.8,
      "end": 5157.3,
      "formatted_start": "01:25:56.800",
      "formatted_end": "01:25:57.300",
      "text": "خب"
    },
    {
      "id": 21,
      "start": 5157.3,
      "end": 5159.0,
      "formatted_start": "01:25:57.300",
      "formatted_end": "01:25:59.000",
      "text": "همونو همشو بگیریم اینو دارین؟"
    },
    {
      "id": 22,
      "start": 5159.0,
      "end": 5160.22,
      "formatted_start": "01:25:59.000",
      "formatted_end": "01:26:00.220",
      "text": "الان که دارم"
    },
    {
      "id": 23,
      "start": 5160.22,
      "end": 5161.42,
      "formatted_start": "01:26:00.220",
      "formatted_end": "01:26:01.420",
      "text": "روزی چند تا میخوری؟"
    },
    {
      "id": 24,
      "start": 5161.42,
      "end": 5164.22,
      "formatted_start": "01:26:01.420",
      "formatted_end": "01:26:04.220",
      "text": "من روزی گفته دوتا ست را دوتا میخورم"
    },
    {
      "id": 25,
      "start": 5164.22,
      "end": 5166.3,
      "formatted_start": "01:26:04.220",
      "formatted_end": "01:26:06.300",
      "text": "یه دفعه حالا مثلا زیاد سرد میکنم"
    },
    {
      "id": 26,
      "start": 5166.3,
      "end": 5168.76,
      "formatted_start": "01:26:06.300",
      "formatted_end": "01:26:08.760",
      "text": "من یه دانو میخورم خصوصی قدم رو تموم کنم"
    },
    {
      "id": 27,
      "start": 5168.76,
      "end": 5169.26,
      "formatted_start": "01:26:08.760",
      "formatted_end": "01:26:09.260",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 5169.26,
      "end": 5172.92,
      "formatted_start": "01:26:09.260",
      "formatted_end": "01:26:12.920",
      "text": "این یک دوست دیگه داده"
    },
    {
      "id": 29,
      "start": 5172.92,
      "end": 5174.14,
      "formatted_start": "01:26:12.920",
      "formatted_end": "01:26:14.140",
      "text": "این داروار یک دوست دیگه"
    },
    {
      "id": 30,
      "start": 5174.14,
      "end": 5175.14,
      "formatted_start": "01:26:14.140",
      "formatted_end": "01:26:15.140",
      "text": "آره ممکنه ها قرار نداره"
    },
    {
      "id": 31,
      "start": 5175.14,
      "end": 5178.1,
      "formatted_start": "01:26:15.140",
      "formatted_end": "01:26:18.100",
      "text": "یه ذره این چند روز ممکنه داروار"
    },
    {
      "id": 32,
      "start": 5178.1,
      "end": 5180.84,
      "formatted_start": "01:26:18.100",
      "formatted_end": "01:26:20.840",
      "text": "خیلی کم قرارتون رو باید برنگران نشید"
    },
    {
      "id": 33,
      "start": 5180.84,
      "end": 5182.42,
      "formatted_start": "01:26:20.840",
      "formatted_end": "01:26:22.420",
      "text": "باست کورس که تمام بشه"
    },
    {
      "id": 34,
      "start": 5182.42,
      "end": 5183.2,
      "formatted_start": "01:26:22.420",
      "formatted_end": "01:26:23.200",
      "text": "خوب میشه"
    },
    {
      "id": 35,
      "start": 5183.2,
      "end": 5183.72,
      "formatted_start": "01:26:23.200",
      "formatted_end": "01:26:23.720",
      "text": "آره"
    },
    {
      "id": 36,
      "start": 5183.72,
      "end": 5189.18,
      "formatted_start": "01:26:23.720",
      "formatted_end": "01:26:29.180",
      "text": "الان نمیدونم در این چند رو"
    },
    {
      "id": 37,
      "start": 5189.18,
      "end": 5190.84,
      "formatted_start": "01:26:29.180",
      "formatted_end": "01:26:30.840",
      "text": "برای تا دیگه پنجان دیگه"
    },
    {
      "id": 38,
      "start": 5190.84,
      "end": 5192.32,
      "formatted_start": "01:26:30.840",
      "formatted_end": "01:26:32.320",
      "text": "یه سری خوشکن برای تو نوشتم"
    },
    {
      "id": 39,
      "start": 5192.32,
      "end": 5193.16,
      "formatted_start": "01:26:32.320",
      "formatted_end": "01:26:33.160",
      "text": "خب"
    },
    {
      "id": 40,
      "start": 5193.16,
      "end": 5196.88,
      "formatted_start": "01:26:33.160",
      "formatted_end": "01:26:36.880",
      "text": "کپلی راحتر یا تو سرم"
    },
    {
      "id": 41,
      "start": 5196.88,
      "end": 5198.62,
      "formatted_start": "01:26:36.880",
      "formatted_end": "01:26:38.620",
      "text": "چی خوشکن؟"
    },
    {
      "id": 42,
      "start": 5198.62,
      "end": 5201.38,
      "formatted_start": "01:26:38.620",
      "formatted_end": "01:26:41.380",
      "text": "آره، هر جا راهای تری برات بزنه"
    },
    {
      "id": 43,
      "start": 5201.38,
      "end": 5203.38,
      "formatted_start": "01:26:41.380",
      "formatted_end": "01:26:43.380",
      "text": "تو سو هم بزنم یا تو یکا بزنم"
    },
    {
      "id": 44,
      "start": 5203.38,
      "end": 5205.38,
      "formatted_start": "01:26:43.380",
      "formatted_end": "01:26:45.380",
      "text": "خودمش سو تتثیر میکنه، همونو بزنم"
    },
    {
      "id": 45,
      "start": 5205.38,
      "end": 5207.38,
      "formatted_start": "01:26:45.380",
      "formatted_end": "01:26:47.380",
      "text": "بیش فرق نمیکنه، هر دو اثر میکنه"
    },
    {
      "id": 46,
      "start": 5207.38,
      "end": 5209.38,
      "formatted_start": "01:26:47.380",
      "formatted_end": "01:26:49.380",
      "text": "همون کفری بزارش کار نداره"
    },
    {
      "id": 47,
      "start": 5209.38,
      "end": 5211.38,
      "formatted_start": "01:26:49.380",
      "formatted_end": "01:26:51.380",
      "text": "من چون غذا مزه مرخورم، چون زب نمیارم"
    },
    {
      "id": 48,
      "start": 5211.38,
      "end": 5217.38,
      "formatted_start": "01:26:51.380",
      "formatted_end": "01:26:57.380",
      "text": "خوشکنان تونو حتما باید شبا بخوری چون یکم خود خوشکنان زب میاندازه بدنو"
    },
    {
      "id": 49,
      "start": 5217.38,
      "end": 5219.38,
      "formatted_start": "01:26:57.380",
      "formatted_end": "01:26:59.380",
      "text": "میدونید که خوشکنان..."
    },
    {
      "id": 50,
      "start": 5219.38,
      "end": 5222.38,
      "formatted_start": "01:26:59.380",
      "formatted_end": "01:27:02.380",
      "text": "برخون این گازه خودو خوش کن"
    },
    {
      "id": 51,
      "start": 5222.38,
      "end": 5225.1,
      "formatted_start": "01:27:02.380",
      "formatted_end": "01:27:05.100",
      "text": "انشاله بهتر شد"
    },
    {
      "id": 52,
      "start": 5225.1,
      "end": 5227.28,
      "formatted_start": "01:27:05.100",
      "formatted_end": "01:27:07.280",
      "text": "سی تی رو نوشتم با همین کود"
    },
    {
      "id": 53,
      "start": 5227.28,
      "end": 5229.26,
      "formatted_start": "01:27:07.280",
      "formatted_end": "01:27:09.260",
      "text": "اگر خود رو اینکرده خوب نشدید"
    },
    {
      "id": 54,
      "start": 5229.26,
      "end": 5230.44,
      "formatted_start": "01:27:09.260",
      "formatted_end": "01:27:10.440",
      "text": "یه ماه وقت داره"
    },
    {
      "id": 55,
      "start": 5230.44,
      "end": 5232.08,
      "formatted_start": "01:27:10.440",
      "formatted_end": "01:27:12.080",
      "text": "به این انجام بدید خب؟"
    },
    {
      "id": 56,
      "start": 5232.08,
      "end": 5234.74,
      "formatted_start": "01:27:12.080",
      "formatted_end": "01:27:14.740",
      "text": "سی تی منظور که"
    },
    {
      "id": 57,
      "start": 5234.74,
      "end": 5235.9,
      "formatted_start": "01:27:14.740",
      "formatted_end": "01:27:15.900",
      "text": "اکس ریاست"
    },
    {
      "id": 58,
      "start": 5235.9,
      "end": 5238.32,
      "formatted_start": "01:27:15.900",
      "formatted_end": "01:27:18.320",
      "text": "این دختر همینو خودشون دارن"
    },
    {
      "id": 59,
      "start": 5238.32,
      "end": 5241.46,
      "formatted_start": "01:27:18.320",
      "formatted_end": "01:27:21.460",
      "text": "ساختمان چی هست مولواریده چی"
    },
    {
      "id": 60,
      "start": 5241.46,
      "end": 5242.7,
      "formatted_start": "01:27:21.460",
      "formatted_end": "01:27:22.700",
      "text": "نه نه اون اکسه"
    },
    {
      "id": 61,
      "start": 5242.7,
      "end": 5244.4,
      "formatted_start": "01:27:22.700",
      "formatted_end": "01:27:24.400",
      "text": "این سی تی است گنه دستگاه است"
    },
    {
      "id": 62,
      "start": 5244.4,
      "end": 5245.76,
      "formatted_start": "01:27:24.400",
      "formatted_end": "01:27:25.760",
      "text": "فقط بیمارستان داره"
    },
    {
      "id": 63,
      "start": 5245.76,
      "end": 5246.78,
      "formatted_start": "01:27:25.760",
      "formatted_end": "01:27:26.780",
      "text": "بیمارستان کجا گفتی؟"
    },
    {
      "id": 64,
      "start": 5246.78,
      "end": 5247.98,
      "formatted_start": "01:27:26.780",
      "formatted_end": "01:27:27.980",
      "text": "هزارت منسومه داره"
    },
    {
      "id": 65,
      "start": 5247.98,
      "end": 5249.98,
      "formatted_start": "01:27:27.980",
      "formatted_end": "01:27:29.980",
      "text": "هنوز بیرون تکشید می آرام"
    },
    {
      "id": 66,
      "start": 5249.98,
      "end": 5250.98,
      "formatted_start": "01:27:29.980",
      "formatted_end": "01:27:30.980",
      "text": "آره خب"
    },
    {
      "id": 67,
      "start": 5250.98,
      "end": 5252.98,
      "formatted_start": "01:27:30.980",
      "formatted_end": "01:27:32.980",
      "text": "برنامه باید برداریم"
    },
    {
      "id": 68,
      "start": 5252.98,
      "end": 5254.98,
      "formatted_start": "01:27:32.980",
      "formatted_end": "01:27:34.980",
      "text": "پرسو غنده ها میگی از چجوری که خورم همیشه؟"
    },
    {
      "id": 69,
      "start": 5254.98,
      "end": 5256.98,
      "formatted_start": "01:27:34.980",
      "formatted_end": "01:27:36.980",
      "text": "به همون روالی که میخوردین بخورید"
    },
    {
      "id": 70,
      "start": 5256.98,
      "end": 5258.98,
      "formatted_start": "01:27:36.980",
      "formatted_end": "01:27:38.980",
      "text": "برنامه باید برداریم"
    },
    {
      "id": 71,
      "start": 5258.98,
      "end": 5260.98,
      "formatted_start": "01:27:38.980",
      "formatted_end": "01:27:40.980",
      "text": "دو تومه یکی میخورم"
    },
    {
      "id": 72,
      "start": 5260.98,
      "end": 5262.98,
      "formatted_start": "01:27:40.980",
      "formatted_end": "01:27:42.980",
      "text": "الان ناشتاتون چند غندتون؟"
    },
    {
      "id": 73,
      "start": 5262.98,
      "end": 5292.98,
      "formatted_start": "01:27:42.980",
      "formatted_end": "01:28:12.980",
      "text": "از اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا"
    },
    {
      "id": 74,
      "start": 5292.98,
      "end": 5294.98,
      "formatted_start": "01:28:12.980",
      "formatted_end": "01:28:14.980",
      "text": "ممنون خانم"
    },
    {
      "id": 75,
      "start": 5294.98,
      "end": 5296.98,
      "formatted_start": "01:28:14.980",
      "formatted_end": "01:28:16.980",
      "text": "ممنون خانم"
    },
    {
      "id": 76,
      "start": 5296.98,
      "end": 5298.98,
      "formatted_start": "01:28:16.980",
      "formatted_end": "01:28:18.980",
      "text": "ممنون خانم"
    },
    {
      "id": 77,
      "start": 5298.98,
      "end": 5300.98,
      "formatted_start": "01:28:18.980",
      "formatted_end": "01:28:20.980",
      "text": "سلام خب"
    },
    {
      "id": 78,
      "start": 5300.98,
      "end": 5302.98,
      "formatted_start": "01:28:20.980",
      "formatted_end": "01:28:22.980",
      "text": "سلام"
    },
    {
      "id": 79,
      "start": 5302.98,
      "end": 5304.98,
      "formatted_start": "01:28:22.980",
      "formatted_end": "01:28:24.980",
      "text": "از اینکه من کچی بود"
    },
    {
      "id": 80,
      "start": 5304.98,
      "end": 5306.98,
      "formatted_start": "01:28:24.980",
      "formatted_end": "01:28:26.980",
      "text": "تنسان مریضی ها میبینم"
    },
    {
      "id": 81,
      "start": 5306.98,
      "end": 5308.98,
      "formatted_start": "01:28:26.980",
      "formatted_end": "01:28:28.980",
      "text": "چون اون پیش دو سور دیگه بودم"
    },
    {
      "id": 82,
      "start": 5308.98,
      "end": 5310.98,
      "formatted_start": "01:28:28.980",
      "formatted_end": "01:28:30.980",
      "text": "من مثلا اونجوردن شاید"
    },
    {
      "id": 83,
      "start": 5310.98,
      "end": 5312.98,
      "formatted_start": "01:28:30.980",
      "formatted_end": "01:28:32.980",
      "text": "دو سه سال پیش کردیدم"
    },
    {
      "id": 84,
      "start": 5312.98,
      "end": 5314.98,
      "formatted_start": "01:28:32.980",
      "formatted_end": "01:28:34.980",
      "text": "چیز شده بود"
    },
    {
      "id": 85,
      "start": 5314.98,
      "end": 5316.98,
      "formatted_start": "01:28:34.980",
      "formatted_end": "01:28:36.980",
      "text": "پرکار بود"
    },
    {
      "id": 86,
      "start": 5316.98,
      "end": 5318.98,
      "formatted_start": "01:28:36.980",
      "formatted_end": "01:28:38.980",
      "text": "و تحت نظر دو سور بردخشان گرگان بودم"
    },
    {
      "id": 87,
      "start": 5318.98,
      "end": 5320.98,
      "formatted_start": "01:28:38.980",
      "formatted_end": "01:28:40.980",
      "text": "و بعد دیگه خب هر سال دیگه خوب شدم"
    },
    {
      "id": 88,
      "start": 5320.98,
      "end": 5326.34,
      "formatted_start": "01:28:40.980",
      "formatted_end": "01:28:46.340",
      "text": "و اینکه خورسات رویه نخور و اینکه یه بار دوباره من رفتم آزمایش بودم خوب بیاد"
    },
    {
      "id": 89,
      "start": 5326.34,
      "end": 5330.66,
      "formatted_start": "01:28:46.340",
      "formatted_end": "01:28:50.660",
      "text": "تا خورداد و پارساد که حالا بردید یعنی تف بامدی نهایت داب"
    },
    {
      "id": 90,
      "start": 5330.66,
      "end": 5333.62,
      "formatted_start": "01:28:50.660",
      "formatted_end": "01:28:53.620",
      "text": "چشم و بوتش همه چیز بگن دارد حالا بردید"
    },
    {
      "id": 91,
      "start": 5333.62,
      "end": 5337.54,
      "formatted_start": "01:28:53.620",
      "formatted_end": "01:28:57.540",
      "text": "و این افراد به این گوشی از یه جای افرانتی رفتم بشه دکتر نوزدکی"
    },
    {
      "id": 92,
      "start": 5337.54,
      "end": 5343.06,
      "formatted_start": "01:28:57.540",
      "formatted_end": "01:29:03.060",
      "text": "اونم برام آزمایش نوشت بعد اینکه به این آزمایش دکتر نوزدکی بود"
    },
    {
      "id": 93,
      "start": 5343.06,
      "end": 5350.06,
      "formatted_start": "01:29:03.060",
      "formatted_end": "01:29:10.060",
      "text": "بعد که بهم گفت فقط یه تیروی دید مثلا چیز شده؟ تیروی دید یه مقدار کم کار شده"
    },
    {
      "id": 94,
      "start": 5350.06,
      "end": 5358.06,
      "formatted_start": "01:29:10.060",
      "formatted_end": "01:29:18.060",
      "text": "خفیف، یکی گفت خفیف و اینا منم دیگه آمدم فردو رو سهیدید یه همینجا آمدم که بر چیزه"
    },
    {
      "id": 95,
      "start": 5358.06,
      "end": 5364.06,
      "formatted_start": "01:29:18.060",
      "formatted_end": "01:29:24.060",
      "text": "بعد این هم خب به من یه پنجد رو گفت نصف بخور و نصف بخور و اینا من خب دیگه حالتا یه دوسته ما خودم و نخورم"
    },
    {
      "id": 96,
      "start": 5364.06,
      "end": 5369.06,
      "formatted_start": "01:29:24.060",
      "formatted_end": "01:29:29.060",
      "text": "یکی بهم گفت نخور یکی میگه بخور گفت نه من دیگه میخوام دسته هم شما قرار بزنم"
    },
    {
      "id": 97,
      "start": 5373.06,
      "end": 5374.42,
      "formatted_start": "01:29:33.060",
      "formatted_end": "01:29:34.420",
      "text": "مرکز رفتیم"
    },
    {
      "id": 98,
      "start": 5374.42,
      "end": 5376.56,
      "formatted_start": "01:29:34.420",
      "formatted_end": "01:29:36.560",
      "text": "هیچ چی نخورم"
    },
    {
      "id": 99,
      "start": 5376.56,
      "end": 5378.2,
      "formatted_start": "01:29:36.560",
      "formatted_end": "01:29:38.200",
      "text": "من از خورداد و پارتاد"
    },
    {
      "id": 100,
      "start": 5378.2,
      "end": 5379.14,
      "formatted_start": "01:29:38.200",
      "formatted_end": "01:29:39.140",
      "text": "دو ماه خورم"
    },
    {
      "id": 101,
      "start": 5379.14,
      "end": 5380.66,
      "formatted_start": "01:29:39.140",
      "formatted_end": "01:29:40.660",
      "text": "از این دیگه خورم نخورم"
    },
    {
      "id": 102,
      "start": 5380.66,
      "end": 5383.06,
      "formatted_start": "01:29:40.660",
      "formatted_end": "01:29:43.060",
      "text": "هیچ نخورم"
    },
    {
      "id": 103,
      "start": 5383.06,
      "end": 5385.82,
      "formatted_start": "01:29:43.060",
      "formatted_end": "01:29:45.820",
      "text": "فیلن نمیخواد"
    },
    {
      "id": 104,
      "start": 5385.82,
      "end": 5387.4,
      "formatted_start": "01:29:45.820",
      "formatted_end": "01:29:47.400",
      "text": "شما هر شش ماه آزمایش بودید"
    },
    {
      "id": 105,
      "start": 5387.4,
      "end": 5389.72,
      "formatted_start": "01:29:47.400",
      "formatted_end": "01:29:49.720",
      "text": "این همه جدیدن دادم"
    },
    {
      "id": 106,
      "start": 5389.72,
      "end": 5391.12,
      "formatted_start": "01:29:49.720",
      "formatted_end": "01:29:51.120",
      "text": "این هم ترقیه دید"
    },
    {
      "id": 107,
      "start": 5391.12,
      "end": 5396.0,
      "formatted_start": "01:29:51.120",
      "formatted_end": "01:29:56.000",
      "text": "شما اختقال جنتیکی تیروید داری خود"
    },
    {
      "id": 108,
      "start": 5396.0,
      "end": 5396.66,
      "formatted_start": "01:29:56.000",
      "formatted_end": "01:29:56.660",
      "text": "بله بله"
    },
    {
      "id": 109,
      "start": 5396.66,
      "end": 5398.88,
      "formatted_start": "01:29:56.660",
      "formatted_end": "01:29:58.880",
      "text": "حالا استرس بهت وارد بشه"
    },
    {
      "id": 110,
      "start": 5398.88,
      "end": 5399.94,
      "formatted_start": "01:29:58.880",
      "formatted_end": "01:29:59.940",
      "text": "تیروید دوباره"
    }
  ],
  "status": "completed"
}