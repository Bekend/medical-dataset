  "stt_segments": [
    {
      "id": 0,
      "start": 16500.0,
      "end": 16502.0,
      "formatted_start": "04:35:00.000",
      "formatted_end": "04:35:02.000",
      "text": "کلی هستم نمیتونه بخوایید؟"
    },
    {
      "id": 1,
      "start": 16530.0,
      "end": 16532.0,
      "formatted_start": "04:35:30.000",
      "formatted_end": "04:35:32.000",
      "text": "نگی من یک جنگ رو برم"
    },
    {
      "id": 2,
      "start": 16532.0,
      "end": 16536.0,
      "formatted_start": "04:35:32.000",
      "formatted_end": "04:35:36.000",
      "text": "بچه برای خواسته ای داره که بچه رو بردارش بره بردارش کنید"
    },
    {
      "id": 3,
      "start": 16536.0,
      "end": 16537.0,
      "formatted_start": "04:35:36.000",
      "formatted_end": "04:35:37.000",
      "text": "نمیشه بگیره"
    },
    {
      "id": 4,
      "start": 16537.0,
      "end": 16540.0,
      "formatted_start": "04:35:37.000",
      "formatted_end": "04:35:40.000",
      "text": "چون قضا پدر مادر تعمال ندارن با بچه رو دارن"
    },
    {
      "id": 5,
      "start": 16540.0,
      "end": 16542.0,
      "formatted_start": "04:35:40.000",
      "formatted_end": "04:35:42.000",
      "text": "همچنان در چیز بایستان هستن"
    },
    {
      "id": 6,
      "start": 16543.0,
      "end": 16545.0,
      "formatted_start": "04:35:43.000",
      "formatted_end": "04:35:45.000",
      "text": "خداحالتونو خیلی خیلی خداحالتونو خیلی خیلی خیلی"
    },
    {
      "id": 7,
      "start": 16549.0,
      "end": 16553.0,
      "formatted_start": "04:35:49.000",
      "formatted_end": "04:35:53.000",
      "text": "هنوز که یه موج گرونی میگه در پیشه که برج همترشت"
    },
    {
      "id": 8,
      "start": 16553.0,
      "end": 16555.0,
      "formatted_start": "04:35:53.000",
      "formatted_end": "04:35:55.000",
      "text": "کسی رو رحشت نکنه که میگرون میشه"
    },
    {
      "id": 9,
      "start": 16555.0,
      "end": 16557.0,
      "formatted_start": "04:35:55.000",
      "formatted_end": "04:35:57.000",
      "text": "دقیقه"
    },
    {
      "id": 10,
      "start": 16557.0,
      "end": 16559.0,
      "formatted_start": "04:35:57.000",
      "formatted_end": "04:35:59.000",
      "text": "این کسی سفراتون سنگ داره؟"
    },
    {
      "id": 11,
      "start": 16559.0,
      "end": 16561.0,
      "formatted_start": "04:35:59.000",
      "formatted_end": "04:36:01.000",
      "text": "بچه اینو می کنه"
    },
    {
      "id": 12,
      "start": 16561.0,
      "end": 16563.0,
      "formatted_start": "04:36:01.000",
      "formatted_end": "04:36:03.000",
      "text": "نه سنگ رو از اون پرهان ریز داشته"
    },
    {
      "id": 13,
      "start": 16563.0,
      "end": 16565.0,
      "formatted_start": "04:36:03.000",
      "formatted_end": "04:36:05.000",
      "text": "کسی سفراتون؟"
    },
    {
      "id": 14,
      "start": 16565.0,
      "end": 16567.0,
      "formatted_start": "04:36:05.000",
      "formatted_end": "04:36:07.000",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 16567.0,
      "end": 16569.0,
      "formatted_start": "04:36:07.000",
      "formatted_end": "04:36:09.000",
      "text": "چرا به عمل نکردی؟"
    },
    {
      "id": 16,
      "start": 16569.0,
      "end": 16571.0,
      "formatted_start": "04:36:09.000",
      "formatted_end": "04:36:11.000",
      "text": "که کدوم رو باید داریم"
    },
    {
      "id": 17,
      "start": 16571.0,
      "end": 16573.0,
      "formatted_start": "04:36:11.000",
      "formatted_end": "04:36:13.000",
      "text": "که کدوم؟"
    },
    {
      "id": 18,
      "start": 16573.0,
      "end": 16575.0,
      "formatted_start": "04:36:13.000",
      "formatted_end": "04:36:15.000",
      "text": "که کدوم گفت"
    },
    {
      "id": 19,
      "start": 16575.0,
      "end": 16577.0,
      "formatted_start": "04:36:15.000",
      "formatted_end": "04:36:17.000",
      "text": "یادگاری؟"
    },
    {
      "id": 20,
      "start": 16577.0,
      "end": 16579.0,
      "formatted_start": "04:36:17.000",
      "formatted_end": "04:36:19.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 16579.0,
      "end": 16581.0,
      "formatted_start": "04:36:19.000",
      "formatted_end": "04:36:21.000",
      "text": "دکتور کامل"
    },
    {
      "id": 22,
      "start": 16581.0,
      "end": 16583.0,
      "formatted_start": "04:36:21.000",
      "formatted_end": "04:36:23.000",
      "text": "یادگاری؟"
    },
    {
      "id": 23,
      "start": 16583.0,
      "end": 16585.0,
      "formatted_start": "04:36:23.000",
      "formatted_end": "04:36:25.000",
      "text": "نه"
    },
    {
      "id": 24,
      "start": 16585.0,
      "end": 16615.0,
      "formatted_start": "04:36:25.000",
      "formatted_end": "04:36:55.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 25,
      "start": 16615.0,
      "end": 16618.0,
      "formatted_start": "04:36:55.000",
      "formatted_end": "04:36:58.000",
      "text": "از اینکه باید برداریم که اینکه سیستم رو بگیرم"
    },
    {
      "id": 26,
      "start": 16618.0,
      "end": 16620.0,
      "formatted_start": "04:36:58.000",
      "formatted_end": "04:37:00.000",
      "text": "آره کذاشتیم"
    },
    {
      "id": 27,
      "start": 16620.0,
      "end": 16621.0,
      "formatted_start": "04:37:00.000",
      "formatted_end": "04:37:01.000",
      "text": "کدومی که اون رو برداریم؟"
    },
    {
      "id": 28,
      "start": 16621.0,
      "end": 16622.0,
      "formatted_start": "04:37:01.000",
      "formatted_end": "04:37:02.000",
      "text": "323"
    },
    {
      "id": 29,
      "start": 16628.0,
      "end": 16630.0,
      "formatted_start": "04:37:08.000",
      "formatted_end": "04:37:10.000",
      "text": "این برای نزدیکیتونه خب؟"
    },
    {
      "id": 30,
      "start": 16630.0,
      "end": 16633.0,
      "formatted_start": "04:37:10.000",
      "formatted_end": "04:37:13.000",
      "text": "ولی این یه روز درمی همیشه نخواه چون مشکل برمیان داره"
