      "end": 21035.0,
      "formatted_start": "05:50:32.000",
      "formatted_end": "05:50:35.000",
      "text": "نه دیگه ما صبح از خواب کنم میشیم ناشتا بهش میگیم"
    },
    {
      "id": 3,
      "start": 21035.0,
      "end": 21037.0,
      "formatted_start": "05:50:35.000",
      "formatted_end": "05:50:37.000",
      "text": "حالا نیم ساعت یا یک ساعت؟"
    },
    {
      "id": 4,
      "start": 21037.0,
      "end": 21038.0,
      "formatted_start": "05:50:37.000",
      "formatted_end": "05:50:38.000",
      "text": "یک ساعت"
    },
    {
      "id": 5,
      "start": 21038.0,
      "end": 21040.0,
      "formatted_start": "05:50:38.000",
      "formatted_end": "05:50:40.000",
      "text": "آه اونو صبر نمی کنیم"
    },
    {
      "id": 6,
      "start": 21040.0,
      "end": 21042.0,
      "formatted_start": "05:50:40.000",
      "formatted_end": "05:50:42.000",
      "text": "یک ساعت ناشتا کنیم"
    },
    {
      "id": 7,
      "start": 21042.0,
      "end": 21050.0,
      "formatted_start": "05:50:42.000",
      "formatted_end": "05:50:50.000",
      "text": "خیلی کم پیش میاد اینجوری نیم ساعت بعد غذا بدیم و اکثر هم میخوابه دو ساعت سه ساعت هم شاید بگذره"
    },
    {
      "id": 8,
      "start": 21050.0,
      "end": 21053.0,
      "formatted_start": "05:50:50.000",
      "formatted_end": "05:50:53.000",
      "text": "خب یه ساعت ناشتا تا الان روزی یه دونه میدادی دو ساعت"
    },
    {
      "id": 9,
      "start": 21053.0,
      "end": 21056.0,
      "formatted_start": "05:50:53.000",
      "formatted_end": "05:50:56.000",
      "text": "خب روزانه یک عدد جمعه دوتون"
    },
    {
      "id": 10,
      "start": 21056.0,
      "end": 21060.0,
      "formatted_start": "05:50:56.000",
      "formatted_end": "05:51:00.000",
      "text": "بعد مایل خب این موضوع دیگه خیلی ناشته رایت بگیریم رایت کنیم"
    },
    {
      "id": 11,
      "start": 21060.0,
      "end": 21062.0,
      "formatted_start": "05:51:00.000",
      "formatted_end": "05:51:02.000",
      "text": "این واسه همه که اضافه بگیریم درست میشه"
    },
    {
      "id": 12,
      "start": 21062.0,
      "end": 21063.0,
      "formatted_start": "05:51:02.000",
      "formatted_end": "05:51:03.000",
      "text": "خب این چی؟"
    },
    {
      "id": 13,
      "start": 21063.0,
      "end": 21064.0,
      "formatted_start": "05:51:03.000",
      "formatted_end": "05:51:04.000",
      "text": "این رو خودتون داریم"
    },
    {
      "id": 14,
      "start": 21064.0,
      "end": 21066.0,
      "formatted_start": "05:51:04.000",
      "formatted_end": "05:51:06.000",
      "text": "خب این که مال مغزه"
    },
    {
      "id": 15,
      "start": 21066.0,
      "end": 21067.0,
      "formatted_start": "05:51:06.000",
      "formatted_end": "05:51:07.000",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 21067.0,
      "end": 21069.0,
      "formatted_start": "05:51:07.000",
      "formatted_end": "05:51:09.000",
      "text": "این رو دیگه باید حتما دلوانه از این پرنامه رو خورده بگم"
    },
    {
      "id": 17,
      "start": 21069.0,
      "end": 21070.0,
      "formatted_start": "05:51:09.000",
      "formatted_end": "05:51:10.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 21070.0,
      "end": 21071.0,
      "formatted_start": "05:51:10.000",
      "formatted_end": "05:51:11.000",
      "text": "این رو نزدیک شاگره"
    },
    {
      "id": 19,
      "start": 21071.0,
      "end": 21072.0,
      "formatted_start": "05:51:11.000",
      "formatted_end": "05:51:12.000",
      "text": "این رو روزانه بود"
    },
    {
      "id": 20,
      "start": 21072.0,
      "end": 21073.0,
      "formatted_start": "05:51:12.000",
      "formatted_end": "05:51:13.000",
      "text": "خارش نمیخواره؟"
    },
    {
      "id": 21,
      "start": 21073.0,
      "end": 21075.0,
      "formatted_start": "05:51:13.000",
      "formatted_end": "05:51:15.000",
      "text": "آلوپرینول نداره"
    },
    {
      "id": 22,
      "start": 21075.0,
      "end": 21078.0,
      "formatted_start": "05:51:15.000",
      "formatted_end": "05:51:18.000",
      "text": "بوره بالا رفته تنش خارش میکنه"
    },
    {
      "id": 23,
      "start": 21078.0,
      "end": 21080.0,
      "formatted_start": "05:51:18.000",
      "formatted_end": "05:51:20.000",
      "text": "نه نه هیچ خارش نداره"
    },
    {
      "id": 24,
      "start": 21080.0,
      "end": 21082.0,
      "formatted_start": "05:51:20.000",
      "formatted_end": "05:51:22.000",
      "text": "اکسلول عمل نشان میده"
    },
    {
      "id": 25,
      "start": 21082.0,
      "end": 21084.0,
      "formatted_start": "05:51:22.000",
      "formatted_end": "05:51:24.000",
      "text": "شاید هم خارش میده سر صدا میکنه"
    },
    {
      "id": 26,
      "start": 21084.0,
      "end": 21086.0,
      "formatted_start": "05:51:24.000",
      "formatted_end": "05:51:26.000",
      "text": "نمیتونه بهت خارش میده"
    },
    {
      "id": 27,
      "start": 21086.0,
      "end": 21088.0,
      "formatted_start": "05:51:26.000",
      "formatted_end": "05:51:28.000",
      "text": "سیپروفلوکساسین"
    },
    {
      "id": 28,
      "start": 21088.0,
      "end": 21090.0,
      "formatted_start": "05:51:28.000",
      "formatted_end": "05:51:30.000",
      "text": "نوشتم برو"
    },
    {
      "id": 29,
      "start": 21091.0,
      "end": 21093.0,
      "formatted_start": "05:51:31.000",
      "formatted_end": "05:51:33.000",
      "text": "تا"
    },
    {
      "id": 30,
      "start": 21095.0,
      "end": 21098.0,
      "formatted_start": "05:51:35.000",
      "formatted_end": "05:51:38.000",
      "text": "چارده عدد هر دوازده ساعت"
    },
    {
      "id": 31,
      "start": 21099.0,
      "end": 21101.0,
      "formatted_start": "05:51:39.000",
      "formatted_end": "05:51:41.000",
      "text": "سپس"
    },
    {
      "id": 32,
      "start": 21101.0,
      "end": 21103.0,
      "formatted_start": "05:51:41.000",
      "formatted_end": "05:51:43.000",
      "text": "مامان تو شکر کنی؟"
    },
    {
      "id": 33,
      "start": 21103.0,
      "end": 21105.0,
      "formatted_start": "05:51:43.000",
      "formatted_end": "05:51:45.000",
      "text": "هر روز یک یکی دونه ورد بخورم"
    },
    {
      "id": 34,
      "start": 21105.0,
      "end": 21107.0,
      "formatted_start": "05:51:45.000",
      "formatted_end": "05:51:47.000",
      "text": "همیشه"
    },
    {
      "id": 35,
      "start": 21107.0,
      "end": 21109.0,
      "formatted_start": "05:51:47.000",
      "formatted_end": "05:51:49.000",
      "text": "چون دیگه افغانتش بر نگرده است"
    },
    {
      "id": 36,
      "start": 21109.0,
      "end": 21113.0,
      "formatted_start": "05:51:49.000",
      "formatted_end": "05:51:53.000",
      "text": "سیتروش هم دقیقا در خونه دویست و پنج آب داره"
    },
    {
      "id": 37,
      "start": 21113.0,
      "end": 21115.0,
      "formatted_start": "05:51:53.000",
      "formatted_end": "05:51:55.000",
      "text": "خب باشید"
    },
    {
      "id": 38,
      "start": 21115.0,
      "end": 21117.0,
      "formatted_start": "05:51:55.000",
      "formatted_end": "05:51:57.000",
      "text": "یه روزی دونه شده شد"
    },
    {
      "id": 39,
      "start": 21117.0,
      "end": 21119.0,
      "formatted_start": "05:51:57.000",
      "formatted_end": "05:51:59.000",
      "text": "بعد این رو خودتون دودونی کرده بود"
    },
    {
      "id": 40,
      "start": 21119.0,
      "end": 21121.0,
      "formatted_start": "05:51:59.000",
      "formatted_end": "05:52:01.000",
      "text": "از سال"
    },
    {
      "id": 41,
      "start": 21121.0,
      "end": 21123.0,
      "formatted_start": "05:52:01.000",
      "formatted_end": "05:52:03.000",
      "text": "با اون برای گلش بود"
    },
    {
      "id": 42,
      "start": 21123.0,
      "end": 21125.0,
      "formatted_start": "05:52:03.000",
      "formatted_end": "05:52:05.000",
      "text": "برای گلش بود"
    },
    {
      "id": 43,
      "start": 21125.0,
      "end": 21127.0,
      "formatted_start": "05:52:05.000",
      "formatted_end": "05:52:07.000",
      "text": "روزی یک دونه بود نه؟"
    },
    {
      "id": 44,
      "start": 21127.0,
      "end": 21129.0,
      "formatted_start": "05:52:07.000",
      "formatted_end": "05:52:09.000",
      "text": "نه نه"
    },
    {
      "id": 45,
      "start": 21129.0,
      "end": 21131.0,
      "formatted_start": "05:52:09.000",
      "formatted_end": "05:52:11.000",
      "text": "این روز یک دو نه است"
    },
    {
      "id": 46,
      "start": 21131.0,
      "end": 21133.0,
      "formatted_start": "05:52:11.000",
      "formatted_end": "05:52:13.000",
      "text": "از روز سر دادیم؟"
    },
    {
      "id": 47,
      "start": 21133.0,
      "end": 21135.0,
      "formatted_start": "05:52:13.000",
      "formatted_end": "05:52:15.000",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 21135.0,
      "end": 21137.0,
      "formatted_start": "05:52:15.000",
      "formatted_end": "05:52:17.000",
      "text": "این روز کارش نمیشه"
    },
    {
      "id": 49,
      "start": 21137.0,
      "end": 21139.0,
      "formatted_start": "05:52:17.000",
      "formatted_end": "05:52:19.000",
      "text": "من سرمونت دارشو نمارد بردم"
    },
    {
      "id": 50,
      "start": 21139.0,
      "end": 21141.0,
      "formatted_start": "05:52:19.000",
      "formatted_end": "05:52:21.000",
      "text": "کجا؟"
    },
    {
      "id": 51,
      "start": 21141.0,
      "end": 21143.0,
      "formatted_start": "05:52:21.000",
      "formatted_end": "05:52:23.000",
      "text": "چی؟"
    },
    {
      "id": 52,
      "start": 21143.0,
      "end": 21145.0,
      "formatted_start": "05:52:23.000",
      "formatted_end": "05:52:25.000",
      "text": "کجا نمیشه"
    },
    {
      "id": 53,
      "start": 21145.0,
      "end": 21147.0,
      "formatted_start": "05:52:25.000",
      "formatted_end": "05:52:27.000",
      "text": "نظرم که من بردم من دارم رو بردم"
    },
    {
      "id": 54,
      "start": 21147.0,
      "end": 21149.0,
      "formatted_start": "05:52:27.000",
      "formatted_end": "05:52:29.000",
      "text": "یا"
    },
    {
      "id": 55,
      "start": 21153.0,
      "end": 21155.0,
      "formatted_start": "05:52:33.000",
      "formatted_end": "05:52:35.000",
      "text": "این روز را راحتمون که دست باشه"
    },
    {
      "id": 56,
      "start": 21155.0,
      "end": 21157.0,
      "formatted_start": "05:52:35.000",
      "formatted_end": "05:52:37.000",
      "text": "با این باید دائم باشه؟"
    },
    {
      "id": 57,
      "start": 21157.0,
      "end": 21161.5,
      "formatted_start": "05:52:37.000",
      "formatted_end": "05:52:41.500",
      "text": "این بجه اون سکته که کرده خونست این مطلقشون رو بشتن کنه"
    },
    {
      "id": 58,
      "start": 21161.5,
      "end": 21164.0,
      "formatted_start": "05:52:41.500",
      "formatted_end": "05:52:44.000",
      "text": "باید آسپرین هایی نوزداخت کردم؟"
    },
    {
      "id": 59,
      "start": 21164.0,
      "end": 21168.0,
      "formatted_start": "05:52:44.000",
      "formatted_end": "05:52:48.000",
      "text": "این رو میگم اجالی کردم رستم نه بردم"
    },
    {
      "id": 60,
      "start": 21168.0,
      "end": 21170.0,
      "formatted_start": "05:52:48.000",
      "formatted_end": "05:52:50.000",
      "text": "میخوای آره برمیسش کنه نداره"
    },
    {
      "id": 61,
      "start": 21170.0,
      "end": 21172.0,
      "formatted_start": "05:52:50.000",
      "formatted_end": "05:52:52.000",
      "text": "آسپرین دوباره برمیساره"
    },
    {
      "id": 62,
      "start": 21172.0,
      "end": 21175.0,
      "formatted_start": "05:52:52.000",
      "formatted_end": "05:52:55.000",
      "text": "چون باید یه بستاره یه درمی اومد؟"
    },
    {
      "id": 63,
      "start": 21175.0,
      "end": 21176.0,
      "formatted_start": "05:52:55.000",
      "formatted_end": "05:52:56.000",
      "text": "آره"
    },
    {
      "id": 64,
      "start": 21176.0,
      "end": 21180.0,
      "formatted_start": "05:52:56.000",
      "formatted_end": "05:53:00.000",
      "text": "چون هیچ مشکلی نداره فقط قدش خیلی میفته"
    },
    {
      "id": 65,
      "start": 21180.0,
      "end": 21182.0,
      "formatted_start": "05:53:00.000",
      "formatted_end": "05:53:02.000",
      "text": "قدش خیلی کلستن"
    },
    {
      "id": 66,
      "start": 21182.0,
      "end": 21184.0,
      "formatted_start": "05:53:02.000",
      "formatted_end": "05:53:04.000",
      "text": "مواد تشریفش بدی"
    },
    {
      "id": 67,
      "start": 21184.0,
      "end": 21187.76,
      "formatted_start": "05:53:04.000",
      "formatted_end": "05:53:07.760",
      "text": "آرام کمام اینها رو همه رو پویستر با آبنویه میدیم"
    },
    {
      "id": 68,
      "start": 21187.76,
      "end": 21189.76,
      "formatted_start": "05:53:07.760",
      "formatted_end": "05:53:09.760",
      "text": "پویستر با آبنویه همیدیم"
    },
    {
      "id": 69,
      "start": 21189.76,
      "end": 21195.46,
      "formatted_start": "05:53:09.760",
      "formatted_end": "05:53:15.460",
      "text": "خب من داروشونو برای ماشخص کنم"
    },
    {
      "id": 70,
      "start": 21195.46,
      "end": 21198.0,
      "formatted_start": "05:53:15.460",
      "formatted_end": "05:53:18.000",
      "text": "تا همیشه شما باید شیرهشون بگیم"
    },
    {
      "id": 71,
      "start": 21198.0,
      "end": 21228.0,
      "formatted_start": "05:53:18.000",
      "formatted_end": "05:53:48.000",
      "text": "این هایی که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید ک"
    },
    {
      "id": 72,
      "start": 21228.0,
      "end": 21231.0,
      "formatted_start": "05:53:48.000",
      "formatted_end": "05:53:51.000",
      "text": "این که با که کمه همشو چیزی؟"
    },
    {
      "id": 73,
      "start": 21232.0,
      "end": 21237.0,
      "formatted_start": "05:53:52.000",
      "formatted_end": "05:53:57.000",
      "text": "نه، اینو ماما میماشته برد از این برد بخورن"
    },
    {
      "id": 74,
      "start": 21238.0,
      "end": 21241.0,
      "formatted_start": "05:53:58.000",
      "formatted_end": "05:54:01.000",
      "text": "اونو که میخواد حتمی باشه به نیز برد؟"
    },
    {
      "id": 75,
      "start": 21241.0,
      "end": 21243.0,
      "formatted_start": "05:54:01.000",
      "formatted_end": "05:54:03.000",
      "text": "نه، اونو همه رو چدام میکنم"
    },
    {
      "id": 76,
      "start": 21244.0,
      "end": 21246.0,
      "formatted_start": "05:54:04.000",
      "formatted_end": "05:54:06.000",
      "text": "این روز خواهش رو هم چدام میکنم"
    },
    {
      "id": 77,
      "start": 21248.0,
      "end": 21249.0,
      "formatted_start": "05:54:08.000",
      "formatted_end": "05:54:09.000",
      "text": "خب، باست فشارشم"
    },
    {
      "id": 78,
      "start": 21249.0,
      "end": 21250.0,
      "formatted_start": "05:54:09.000",
      "formatted_end": "05:54:10.000",
      "text": "فشار اینه؟"
    },
    {
      "id": 79,
      "start": 21250.0,
      "end": 21251.0,
      "formatted_start": "05:54:10.000",
      "formatted_end": "05:54:11.000",
      "text": "یکی میده در دست؟"
    },
    {
      "id": 80,
      "start": 21251.0,
      "end": 21253.0,
      "formatted_start": "05:54:11.000",
      "formatted_end": "05:54:13.000",
      "text": "آره، یکی میده نه"
    },
    {
      "id": 81,
      "start": 21253.0,
      "end": 21256.0,
      "formatted_start": "05:54:13.000",
      "formatted_end": "05:54:16.000",
      "text": "خب از اینو به بعد یکی صبحی شفتشش برنم"
    },
    {
      "id": 82,
      "start": 21256.0,
      "end": 21258.52,
      "formatted_start": "05:54:16.000",
      "formatted_end": "05:54:18.520",
      "text": "همه خوبه همه چیزی خواهید براش برسید"
    },
    {
      "id": 83,
      "start": 21258.52,
      "end": 21259.8,
      "formatted_start": "05:54:18.520",
      "formatted_end": "05:54:19.800",
      "text": "هیجده میشه؟"
    },
    {
      "id": 84,
      "start": 21259.8,
      "end": 21261.0,
      "formatted_start": "05:54:19.800",
      "formatted_end": "05:54:21.000",
      "text": "جاد؟"
    },
    {
      "id": 85,
      "start": 21261.0,
      "end": 21262.0,
      "formatted_start": "05:54:21.000",
      "formatted_end": "05:54:22.000",
      "text": "هیجده بود"
    },
    {
      "id": 86,
      "start": 21262.0,
      "end": 21265.24,
      "formatted_start": "05:54:22.000",
      "formatted_end": "05:54:25.240",
      "text": "نه این روز هیجده بود فقط با ارموز شمزه بود"
    },
    {
      "id": 87,
      "start": 21265.24,
      "end": 21267.36,
      "formatted_start": "05:54:25.240",
      "formatted_end": "05:54:27.360",
      "text": "پس فیلن همین رو در صبح شده بود"
    },
    {
      "id": 88,
      "start": 21267.36,
      "end": 21270.72,
      "formatted_start": "05:54:27.360",
      "formatted_end": "05:54:30.720",
      "text": "حالا اگر یک نون شیر بهش دادیم من میگم شما ندارید"
    },
    {
      "id": 89,
      "start": 21270.72,
      "end": 21273.4,
      "formatted_start": "05:54:30.720",
      "formatted_end": "05:54:33.400",
      "text": "اصلا من بذاره غذا هر چی میخواد بخواد"
    },
    {
      "id": 90,
      "start": 21273.4,
      "end": 21275.68,
      "formatted_start": "05:54:33.400",
      "formatted_end": "05:54:35.680",
      "text": "من اول یه قرص دیگه میذارم خب؟"
    },
    {
      "id": 91,
      "start": 21275.68,
      "end": 21280.68,
      "formatted_start": "05:54:35.680",
      "formatted_end": "05:54:40.680",
      "text": "این روز یه تونه همونو بده اگه دیدی جواب نداد بر روز دوتاش کردی"
    },
    {
      "id": 92,
      "start": 21280.68,
      "end": 21283.68,
      "formatted_start": "05:54:40.680",
      "formatted_end": "05:54:43.680",
      "text": "همونو که الان با دیگه نیست؟"
    },
    {
      "id": 93,
      "start": 21283.68,
      "end": 21285.68,
      "formatted_start": "05:54:43.680",
      "formatted_end": "05:54:45.680",
      "text": "این توشه که همه همون هست"
    },
    {
      "id": 94,
      "start": 21285.68,
      "end": 21286.68,
      "formatted_start": "05:54:45.680",
      "formatted_end": "05:54:46.680",
      "text": "خب"
    },
    {
      "id": 95,
      "start": 21286.68,
      "end": 21287.68,
      "formatted_start": "05:54:46.680",
      "formatted_end": "05:54:47.680",
      "text": "ترکیبیه"
    },
    {
      "id": 96,
      "start": 21287.68,
      "end": 21290.68,
      "formatted_start": "05:54:47.680",
      "formatted_end": "05:54:50.680",
      "text": "آمال دی پین بود"
    },
    {
      "id": 97,
      "start": 21290.68,
      "end": 21292.68,
      "formatted_start": "05:54:50.680",
      "formatted_end": "05:54:52.680",
      "text": "آمال دی پین"
    },
    {
      "id": 98,
      "start": 21292.68,
      "end": 21294.68,
      "formatted_start": "05:54:52.680",
      "formatted_end": "05:54:54.680",
      "text": "همینه آمال دی پین"
    },
    {
      "id": 99,
      "start": 21294.68,
      "end": 21295.68,
      "formatted_start": "05:54:54.680",
      "formatted_end": "05:54:55.680",
      "text": "آمال دی پین"
    },
    {
      "id": 100,
      "start": 21295.68,
      "end": 21297.68,
      "formatted_start": "05:54:55.680",
      "formatted_end": "05:54:57.680",
      "text": "بازا میمیس میشه ترکیب دوتاش"
    },
    {
      "id": 101,
      "start": 21297.68,
      "end": 21298.68,
      "formatted_start": "05:54:57.680",
      "formatted_end": "05:54:58.680",
      "text": "خیلی"
    },
    {
      "id": 102,
      "start": 21298.68,
      "end": 21299.68,
      "formatted_start": "05:54:58.680",
      "formatted_end": "05:54:59.680",
      "text": "دارای مامانو"
    }
  ],
