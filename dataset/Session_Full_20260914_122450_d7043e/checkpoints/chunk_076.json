  "stt_segments": [
    {
      "id": 0,
      "start": 22800.0,
      "end": 22815.68,
      "formatted_start": "06:20:00.000",
      "formatted_end": "06:20:15.680",
      "text": "نه، دارم بهتون میگم روزه نکه هیچ مشکلی نداره، فقط ظرفتون، موضوع چی هم که خصوصی پرسیدم، بقیه هم که دیگه ناخونگی، مثلا شونه، تیق بدن، این چیزهایی که با خون تماس دارن."
    },
    {
      "id": 1,
      "start": 22815.68,
      "end": 22825.68,
      "formatted_start": "06:20:15.680",
      "formatted_end": "06:20:25.680",
      "text": "اینجا خیلی تکیب کنم بچه ها بریون هم رو بیم دهد. یکی جروح سامون بگیره تازیب شد."
    },
    {
      "id": 2,
      "start": 22825.68,
      "end": 22827.68,
      "formatted_start": "06:20:25.680",
      "formatted_end": "06:20:27.680",
      "text": "نه دیگه شما از این بد مال خودتون رو نشوند."
    },
    {
      "id": 3,
      "start": 22827.68,
      "end": 22835.68,
      "formatted_start": "06:20:27.680",
      "formatted_end": "06:20:35.680",
      "text": "نه من خیلی به اصلا این حساسم. میگم بهشم. من چون بعضی ما بیرون پارسی ها هم. اینها اینجا بچه ها بیا تازیب شد."
    },
    {
      "id": 4,
      "start": 22835.68,
      "end": 22839.68,
      "formatted_start": "06:20:35.680",
      "formatted_end": "06:20:39.680",
      "text": "شما انسانه خودتون رو اصلا توی مثلا مشامل جدا بذارید."
    },
    {
      "id": 5,
      "start": 22839.68,
      "end": 22841.68,
      "formatted_start": "06:20:39.680",
      "formatted_end": "06:20:41.680",
      "text": "او در یخشه های او را باز کنید."
    },
    {
      "id": 6,
      "start": 22841.68,
      "end": 22842.68,
      "formatted_start": "06:20:41.680",
      "formatted_end": "06:20:42.680",
      "text": "آره دیگه."
    },
    {
      "id": 7,
      "start": 22842.68,
      "end": 22845.68,
      "formatted_start": "06:20:42.680",
      "formatted_end": "06:20:45.680",
      "text": "خب ما شما توی مشمه های تیره بزنید که تنبری کنند و باز کنید."
    },
    {
      "id": 8,
      "start": 22845.68,
      "end": 22847.68,
      "formatted_start": "06:20:45.680",
      "formatted_end": "06:20:47.680",
      "text": "ما همون کاری را کنیم."
    },
    {
      "id": 9,
      "start": 22847.68,
      "end": 22851.68,
      "formatted_start": "06:20:47.680",
      "formatted_end": "06:20:51.680",
      "text": "آره که دیده نشید بچه همون که جدا شان دیده میشه را برد میدونند مال خانم باشه."
    },
    {
      "id": 10,
      "start": 22851.68,
      "end": 22853.68,
      "formatted_start": "06:20:51.680",
      "formatted_end": "06:20:53.680",
      "text": "مال شما جدا باشه."
    },
    {
      "id": 11,
      "start": 22853.68,
      "end": 22855.68,
      "formatted_start": "06:20:53.680",
      "formatted_end": "06:20:55.680",
      "text": "چه باشه؟"
    },
    {
      "id": 12,
      "start": 22860.68,
      "end": 22862.68,
      "formatted_start": "06:21:00.680",
      "formatted_end": "06:21:02.680",
      "text": "خون زده بود تا حالا؟"
    },
    {
      "id": 13,
      "start": 22862.68,
      "end": 22863.68,
      "formatted_start": "06:21:02.680",
      "formatted_end": "06:21:03.680",
      "text": "خونم؟"
    },
    {
      "id": 14,
      "start": 22863.68,
      "end": 22864.68,
      "formatted_start": "06:21:03.680",
      "formatted_end": "06:21:04.680",
      "text": "آره."
    },
    {
      "id": 15,
      "start": 22865.68,
      "end": 22868.68,
      "formatted_start": "06:21:05.680",
      "formatted_end": "06:21:08.680",
      "text": "اونی که خیلی سرار نبوده بخاطر..."
    },
    {
      "id": 16,
      "start": 22868.68,
      "end": 22872.68,
      "formatted_start": "06:21:08.680",
      "formatted_end": "06:21:12.680",
      "text": "این همون جا آلوده شده دیگه"
    },
    {
      "id": 17,
      "start": 22872.68,
      "end": 22874.68,
      "formatted_start": "06:21:12.680",
      "formatted_end": "06:21:14.680",
      "text": "من خودم خون دادم اونجا"
    },
    {
      "id": 18,
      "start": 22874.68,
      "end": 22876.68,
      "formatted_start": "06:21:14.680",
      "formatted_end": "06:21:16.680",
      "text": "نه این همون جا خون دادم"
    },
    {
      "id": 19,
      "start": 22876.68,
      "end": 22878.68,
      "formatted_start": "06:21:16.680",
      "formatted_end": "06:21:18.680",
      "text": "خون شما که نبوده"
    },
    {
      "id": 20,
      "start": 22878.68,
      "end": 22880.68,
      "formatted_start": "06:21:18.680",
      "formatted_end": "06:21:20.680",
      "text": "چون خون شما یه ماه طور میگه شبازه بیچیم"
    },
    {
      "id": 21,
      "start": 22880.68,
      "end": 22882.68,
      "formatted_start": "06:21:20.680",
      "formatted_end": "06:21:22.680",
      "text": "نه دیگه من کارتوی به منجا تبیز کردم"
    },
    {
      "id": 22,
      "start": 22882.68,
      "end": 22884.68,
      "formatted_start": "06:21:22.680",
      "formatted_end": "06:21:24.680",
      "text": "یه خون رو بشتر بردم"
    },
    {
      "id": 23,
      "start": 22884.68,
      "end": 22888.68,
      "formatted_start": "06:21:24.680",
      "formatted_end": "06:21:28.680",
      "text": "نه همون جا ها آلوده شده"
    },
    {
      "id": 24,
      "start": 22888.68,
      "end": 22890.68,
      "formatted_start": "06:21:28.680",
      "formatted_end": "06:21:30.680",
      "text": "همون مال خون دادم"
    },
    {
      "id": 25,
      "start": 22890.68,
      "end": 22892.68,
      "formatted_start": "06:21:30.680",
      "formatted_end": "06:21:32.680",
      "text": "درسته"
    },
    {
      "id": 26,
      "start": 22892.68,
      "end": 22894.68,
      "formatted_start": "06:21:32.680",
      "formatted_end": "06:21:34.680",
      "text": "همون هم که شما میگید مال قدیم بوده"
    },
    {
      "id": 27,
      "start": 22894.68,
      "end": 22896.68,
      "formatted_start": "06:21:34.680",
      "formatted_end": "06:21:36.680",
      "text": "همون خون های سی سال پیش آلوده بود"
    },
    {
      "id": 28,
      "start": 22896.68,
      "end": 22899.68,
      "formatted_start": "06:21:36.680",
      "formatted_end": "06:21:39.680",
      "text": "موسیقی که از آلمانان کردن، آلوده بود."
    },
    {
      "id": 29,
      "start": 22902.68,
      "end": 22911.68,
      "formatted_start": "06:21:42.680",
      "formatted_end": "06:21:51.680",
      "text": "آره، این مال اون زمانه. چون بگید این همه سال قفته، این همون خونه هست."
    },
    {
      "id": 30,
      "start": 22912.68,
      "end": 22915.68,
      "formatted_start": "06:21:52.680",
      "formatted_end": "06:21:55.680",
      "text": "نه، باید جان خونه مستقیم خودم نبود. من..."
    },
    {
      "id": 31,
      "start": 22915.68,
      "end": 22917.68,
      "formatted_start": "06:21:55.680",
      "formatted_end": "06:21:57.680",
      "text": "نه، خون تون میکشه."
    },
    {
      "id": 32,
      "start": 22917.68,
      "end": 22921.68,
      "formatted_start": "06:21:57.680",
      "formatted_end": "06:22:01.680",
      "text": "چهار، پنج بار خون داده بودم، چهارته بار به مانجان تحلیص کرده بودم."
    },
    {
      "id": 33,
      "start": 22921.68,
      "end": 22924.22,
      "formatted_start": "06:22:01.680",
      "formatted_end": "06:22:04.220",
      "text": "آماده سازی خون خیلی طور می کشه"
    },
    {
      "id": 34,
      "start": 22924.22,
      "end": 22928.44,
      "formatted_start": "06:22:04.220",
      "formatted_end": "06:22:08.440",
      "text": "و این خونه یک سال، سی سال پیش تقریبا خیلی آهلوده شده"
    },
    {
      "id": 35,
      "start": 22928.44,
      "end": 22930.44,
      "formatted_start": "06:22:08.440",
      "formatted_end": "06:22:10.440",
      "text": "دست داری؟"
    },
    {
      "id": 36,
      "start": 22930.44,
      "end": 22932.44,
      "formatted_start": "06:22:10.440",
      "formatted_end": "06:22:12.440",
      "text": "سلامت باشید"
    },
