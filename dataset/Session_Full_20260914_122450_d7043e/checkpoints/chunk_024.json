  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7210.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:10.000",
      "text": "جارو نمیشه، نکنی بچه ها بکنن. جارو نزنی اصلا. کمهر دیگه وقتی در ازشون چنگ میگیرن، سی دقیقی میدازن."
    },
    {
      "id": 1,
      "start": 7210.0,
      "end": 7213.0,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:13.000",
      "text": "کمهرم زیاد درد میکنند، آنها حالت ویدئو هستند که کمهرم زیاد درد میکنند."
    },
    {
      "id": 2,
      "start": 7213.0,
      "end": 7220.0,
      "formatted_start": "02:00:13.000",
      "formatted_end": "02:00:20.000",
      "text": "آره دیگه اون رو بازده. کاره دیگه حالا یه دقیقه مثلا زرف بینی شدی، چار پایی کچک جلو بازون باشه،"
    },
    {
      "id": 3,
      "start": 7220.0,
      "end": 7223.0,
      "formatted_start": "02:00:20.000",
      "formatted_end": "02:00:23.000",
      "text": "هیپات رو روی این بزار و باز خود رو عوض کن و روی این بزار"
    },
    {
      "id": 4,
      "start": 7223.0,
      "end": 7226.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:26.000",
      "text": "این کمل آسانده میشه خب دیست باز میشه"
    },
    {
      "id": 5,
      "start": 7226.0,
      "end": 7228.0,
      "formatted_start": "02:00:26.000",
      "formatted_end": "02:00:28.000",
      "text": "ولی مثلا این موقع زرش دست همشه این کار کرده"
    },
    {
      "id": 6,
      "start": 7228.0,
      "end": 7232.0,
      "formatted_start": "02:00:28.000",
      "formatted_end": "02:00:32.000",
      "text": "باید جارو دیگه نه خمه خب چه حال آجارو برقی چه دستی؟"
    },
    {
      "id": 7,
      "start": 7232.0,
      "end": 7236.0,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:36.000",
      "text": "جارو نه باید بزنی هر کار میخوای بکن جارو تو باید بچه ها بیان شده بکن"
    },
    {
      "id": 8,
      "start": 7236.0,
      "end": 7238.0,
      "formatted_start": "02:00:36.000",
      "formatted_end": "02:00:38.000",
      "text": "خالچی کمکت میکنه"
    },
    {
      "id": 9,
      "start": 7238.0,
      "end": 7242.0,
      "formatted_start": "02:00:38.000",
      "formatted_end": "02:00:42.000",
      "text": "نه، من باید بردار کنم، خوب همین طعمی چه بندار کنم"
    },
    {
      "id": 10,
      "start": 7242.0,
      "end": 7245.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:45.000",
      "text": "حالا، به خود خودتون نه اندازه این هاش خانه"
    },
    {
      "id": 11,
      "start": 7245.0,
      "end": 7247.0,
      "formatted_start": "02:00:45.000",
      "formatted_end": "02:00:47.000",
      "text": "دست برنگره"
    },
    {
      "id": 12,
      "start": 7247.0,
      "end": 7252.0,
      "formatted_start": "02:00:47.000",
      "formatted_end": "02:00:52.000",
      "text": "این اینجا تو شبای کمه رو ماده خوارش رو نمدارم تورجن کنم"
    },
    {
      "id": 13,
      "start": 7252.0,
      "end": 7253.0,
      "formatted_start": "02:00:52.000",
      "formatted_end": "02:00:53.000",
      "text": "خوشتو خوارش میده؟"
    },
    {
      "id": 14,
      "start": 7253.0,
      "end": 7256.0,
      "formatted_start": "02:00:53.000",
      "formatted_end": "02:00:56.000",
      "text": "نه خوارش میده، خودتون میده"
    },
    {
      "id": 15,
      "start": 7256.0,
      "end": 7258.0,
      "formatted_start": "02:00:56.000",
      "formatted_end": "02:00:58.000",
      "text": "بینا باز با من اینجا نمیدونه"
    },
    {
      "id": 16,
      "start": 7258.0,
      "end": 7259.0,
      "formatted_start": "02:00:58.000",
      "formatted_end": "02:00:59.000",
      "text": "چیزا خواه؟"
    },
    {
      "id": 17,
      "start": 7259.0,
      "end": 7261.0,
      "formatted_start": "02:00:59.000",
      "formatted_end": "02:01:01.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 18,
      "start": 7261.0,
      "end": 7263.0,
      "formatted_start": "02:01:01.000",
      "formatted_end": "02:01:03.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 19,
      "start": 7263.0,
      "end": 7265.0,
      "formatted_start": "02:01:03.000",
      "formatted_end": "02:01:05.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 20,
      "start": 7265.0,
      "end": 7267.0,
      "formatted_start": "02:01:05.000",
      "formatted_end": "02:01:07.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 21,
      "start": 7267.0,
      "end": 7269.0,
      "formatted_start": "02:01:07.000",
      "formatted_end": "02:01:09.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 22,
      "start": 7269.0,
      "end": 7271.0,
      "formatted_start": "02:01:09.000",
      "formatted_end": "02:01:11.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 23,
      "start": 7271.0,
      "end": 7273.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:13.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 24,
      "start": 7273.0,
      "end": 7275.0,
      "formatted_start": "02:01:13.000",
      "formatted_end": "02:01:15.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 25,
      "start": 7275.0,
      "end": 7277.0,
      "formatted_start": "02:01:15.000",
      "formatted_end": "02:01:17.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 26,
      "start": 7277.0,
      "end": 7279.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:19.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 27,
      "start": 7279.0,
      "end": 7281.0,
      "formatted_start": "02:01:19.000",
      "formatted_end": "02:01:21.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 28,
      "start": 7281.0,
      "end": 7292.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:32.000",
      "text": "از این برسن که مقل نو ساکن ماند، از این داری بدی میلی میسن."
    },
    {
      "id": 29,
      "start": 7292.0,
      "end": 7295.0,
      "formatted_start": "02:01:32.000",
      "formatted_end": "02:01:35.000",
      "text": "از چی بس پون بیا برن، من این تیر ماشین جا بیم."
    },
    {
      "id": 30,
      "start": 7295.0,
      "end": 7296.0,
      "formatted_start": "02:01:35.000",
      "formatted_end": "02:01:36.000",
      "text": "من ماشین میشیم؟"
    },
    {
      "id": 31,
      "start": 7296.0,
      "end": 7302.0,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:42.000",
      "text": "تیر ماشین میشیم، از اون درسته پودر کش میکنم، درخواهی دو کل."
    },
    {
      "id": 32,
      "start": 7302.0,
      "end": 7308.0,
      "formatted_start": "02:01:42.000",
      "formatted_end": "02:01:48.000",
      "text": "این همه چیز همه مثلا. کلسی ها میخورید؟"
    },
    {
      "id": 33,
      "start": 7308.0,
      "end": 7310.0,
      "formatted_start": "02:01:48.000",
      "formatted_end": "02:01:50.000",
      "text": "نه از این ها نمیخورم."
    },
    {
      "id": 34,
      "start": 7310.0,
      "end": 7312.0,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:52.000",
      "text": "کلسی ها به چی نمیخورید؟"
    },
    {
      "id": 35,
      "start": 7312.0,
      "end": 7313.0,
      "formatted_start": "02:01:52.000",
      "formatted_end": "02:01:53.000",
      "text": "کلسی ها."
    },
    {
      "id": 36,
      "start": 7313.0,
      "end": 7315.0,
      "formatted_start": "02:01:53.000",
      "formatted_end": "02:01:55.000",
      "text": "کسی که پاش آمد کرده باید کلسی ها بخورند."
    },
    {
      "id": 37,
      "start": 7315.0,
      "end": 7317.0,
      "formatted_start": "02:01:55.000",
      "formatted_end": "02:01:57.000",
      "text": "باید اینجا بخورند. بسیار نخورند."
    },
    {
      "id": 38,
      "start": 7317.0,
      "end": 7321.0,
      "formatted_start": "02:01:57.000",
      "formatted_end": "02:02:01.000",
      "text": "چون شاید شکرمش را صرف میکنند و میدار حضیت میکنند، نمیخورند."
    },
    {
      "id": 39,
      "start": 7321.0,
      "end": 7326.0,
      "formatted_start": "02:02:01.000",
      "formatted_end": "02:02:06.000",
      "text": "ولی باید بخورید چون شما خصوصا عمل شده خب، پوک میشه."
    },
    {
      "id": 40,
      "start": 7326.0,
      "end": 7334.0,
      "formatted_start": "02:02:06.000",
      "formatted_end": "02:02:14.000",
      "text": "شده که روز درمیان مثلا کنارش بعد غذا، بعد کنارش یه خیار، یه دیوان آب گرمی چیزی، حتما بخورید"
    },
    {
      "id": 41,
      "start": 7334.0,
      "end": 7338.0,
      "formatted_start": "02:02:14.000",
      "formatted_end": "02:02:18.000",
      "text": "چون که بدنتون آسیب میبینه عزیز"
    },
    {
      "id": 42,
      "start": 7341.0,
      "end": 7345.0,
      "formatted_start": "02:02:21.000",
      "formatted_end": "02:02:25.000",
      "text": "صبح که میتونه میشه یه کاشاک پوته سنجر توی دیوان شیر بریز بخور"
    },
    {
      "id": 43,
      "start": 7345.0,
      "end": 7347.0,
      "formatted_start": "02:02:25.000",
      "formatted_end": "02:02:27.000",
      "text": "کم استخواناتو صرف میکنه"
    },
    {
      "id": 44,
      "start": 7347.0,
      "end": 7348.0,
      "formatted_start": "02:02:27.000",
      "formatted_end": "02:02:28.000",
      "text": "پوته چی؟"
    },
    {
      "id": 45,
      "start": 7348.0,
      "end": 7350.0,
      "formatted_start": "02:02:28.000",
      "formatted_end": "02:02:30.000",
      "text": "سنجر، پوته سنجر"
    },
    {
      "id": 46,
      "start": 7350.0,
      "end": 7352.0,
      "formatted_start": "02:02:30.000",
      "formatted_end": "02:02:32.000",
      "text": "استخوانه دیگه قبل"
    },
    {
      "id": 47,
      "start": 7356.0,
      "end": 7386.0,
      "formatted_start": "02:02:36.000",
      "formatted_end": "02:03:06.000",
      "text": "از اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که ب"
    },
    {
      "id": 48,
      "start": 7386.0,
      "end": 7388.0,
      "formatted_start": "02:03:06.000",
      "formatted_end": "02:03:08.000",
      "text": "بیاسر"
    },
    {
      "id": 49,
      "start": 7388.0,
      "end": 7390.0,
      "formatted_start": "02:03:08.000",
      "formatted_end": "02:03:10.000",
      "text": "مخوریش من مخوریم"
    },
    {
      "id": 50,
      "start": 7390.0,
      "end": 7392.0,
      "formatted_start": "02:03:10.000",
      "formatted_end": "02:03:12.000",
      "text": "اصلا بازاتو بر بینوار درست کنیم"
    },
    {
      "id": 51,
      "start": 7392.0,
      "end": 7394.0,
      "formatted_start": "02:03:12.000",
      "formatted_end": "02:03:14.000",
      "text": "بینوار درست میکنیم نه"
    },
    {
      "id": 52,
      "start": 7394.0,
      "end": 7396.0,
      "formatted_start": "02:03:14.000",
      "formatted_end": "02:03:16.000",
      "text": "نه درست نه"
    },
    {
      "id": 53,
      "start": 7396.0,
      "end": 7398.0,
      "formatted_start": "02:03:16.000",
      "formatted_end": "02:03:18.000",
      "text": "چی چی شده؟"
    },
    {
      "id": 54,
      "start": 7398.0,
      "end": 7400.0,
      "formatted_start": "02:03:18.000",
      "formatted_end": "02:03:20.000",
      "text": "ما خودمون گن دارم"
    },
    {
      "id": 55,
      "start": 7400.0,
      "end": 7402.0,
      "formatted_start": "02:03:20.000",
      "formatted_end": "02:03:22.000",
      "text": "دارواتم تمام شده"
    },
    {
      "id": 56,
      "start": 7402.0,
      "end": 7404.0,
      "formatted_start": "02:03:22.000",
      "formatted_end": "02:03:24.000",
      "text": "دارواتم دارین؟"
    },
    {
      "id": 57,
      "start": 7406.0,
      "end": 7408.0,
      "formatted_start": "02:03:26.000",
      "formatted_end": "02:03:28.000",
      "text": "اینو مانو خود میبشتیم و اینو"
    },
    {
      "id": 58,
      "start": 7408.0,
      "end": 7410.0,
      "formatted_start": "02:03:28.000",
      "formatted_end": "02:03:30.000",
      "text": "ازت چکم خیلی خوب بودن"
    },
    {
      "id": 59,
      "start": 7410.0,
      "end": 7412.0,
      "formatted_start": "02:03:30.000",
      "formatted_end": "02:03:32.000",
      "text": "اینو کمون گن دن"
    },
    {
      "id": 60,
      "start": 7412.0,
      "end": 7414.0,
      "formatted_start": "02:03:32.000",
      "formatted_end": "02:03:34.000",
      "text": "ده تو"
    },
    {
      "id": 61,
      "start": 7414.0,
      "end": 7418.0,
      "formatted_start": "02:03:34.000",
      "formatted_end": "02:03:38.000",
      "text": "اگر موقع شانه های باشه نمیدونیم اون رو خود کنیم"
    },
    {
      "id": 62,
      "start": 7418.0,
      "end": 7421.0,
      "formatted_start": "02:03:38.000",
      "formatted_end": "02:03:41.000",
      "text": "از این روزی دوتا میخوریم"
    },
    {
      "id": 63,
      "start": 7421.0,
      "end": 7425.0,
      "formatted_start": "02:03:41.000",
      "formatted_end": "02:03:45.000",
      "text": "دوتا میخورم و یکی میخورم و اون طریقه در این معلوم نیست"
    },
    {
      "id": 64,
      "start": 7425.0,
      "end": 7427.0,
      "formatted_start": "02:03:45.000",
      "formatted_end": "02:03:47.000",
      "text": "این نخربازه که نمیخوریم"
    },
    {
      "id": 65,
      "start": 7427.0,
      "end": 7429.0,
      "formatted_start": "02:03:47.000",
      "formatted_end": "02:03:49.000",
      "text": "نخربازه نمیخوریم"
    },
    {
      "id": 66,
      "start": 7429.0,
      "end": 7431.0,
      "formatted_start": "02:03:49.000",
      "formatted_end": "02:03:51.000",
      "text": "نخربازه نیمشابه هست"
    },
    {
      "id": 67,
      "start": 7433.0,
      "end": 7435.0,
      "formatted_start": "02:03:53.000",
      "formatted_end": "02:03:55.000",
      "text": "تلخه"
    },
    {
      "id": 68,
      "start": 7435.0,
      "end": 7436.0,
      "formatted_start": "02:03:55.000",
      "formatted_end": "02:03:56.000",
      "text": "تلخه؟"
    },
    {
      "id": 69,
      "start": 7436.0,
      "end": 7437.0,
      "formatted_start": "02:03:56.000",
      "formatted_end": "02:03:57.000",
      "text": "چی تلخه؟"
    },
    {
      "id": 70,
      "start": 7437.0,
      "end": 7438.0,
      "formatted_start": "02:03:57.000",
      "formatted_end": "02:03:58.000",
      "text": "نشابه ها"
    },
    {
      "id": 71,
      "start": 7438.0,
      "end": 7443.0,
      "formatted_start": "02:03:58.000",
      "formatted_end": "02:04:03.000",
      "text": "نشابه نه نشابه کرده من بسا چیزا بدین قلب مخوریم"
    },
    {
      "id": 72,
      "start": 7443.0,
      "end": 7445.0,
      "formatted_start": "02:04:03.000",
      "formatted_end": "02:04:05.000",
      "text": "ما بخواب چی بخونیم دیگه؟"
    },
    {
      "id": 73,
      "start": 7445.0,
      "end": 7447.0,
      "formatted_start": "02:04:05.000",
      "formatted_end": "02:04:07.000",
      "text": "چی بخواب که بخواب نمی باید بخونیم دیگه؟"
    },
    {
      "id": 74,
      "start": 7447.0,
      "end": 7450.0,
      "formatted_start": "02:04:07.000",
      "formatted_end": "02:04:10.000",
      "text": "کم، کم بخونم، زیاد هم نمی بخونم"
    },
    {
      "id": 75,
      "start": 7450.0,
      "end": 7453.0,
      "formatted_start": "02:04:10.000",
      "formatted_end": "02:04:13.000",
      "text": "که از دستان در یک نوشه برای تموم کنم"
    },
    {
      "id": 76,
      "start": 7453.0,
      "end": 7455.0,
      "formatted_start": "02:04:13.000",
      "formatted_end": "02:04:15.000",
      "text": "توی در برنامه"
    },
    {
      "id": 77,
      "start": 7455.0,
      "end": 7457.0,
      "formatted_start": "02:04:15.000",
      "formatted_end": "02:04:17.000",
      "text": "اگه در پونزر روزی که تموم کنیم خیلی نیست"
    },
    {
      "id": 78,
      "start": 7457.0,
      "end": 7462.0,
      "formatted_start": "02:04:17.000",
      "formatted_end": "02:04:22.000",
      "text": "نه، باید بخونم روزی که مخونم نبود"
    },
    {
      "id": 79,
      "start": 7462.0,
      "end": 7464.0,
      "formatted_start": "02:04:22.000",
      "formatted_end": "02:04:24.000",
      "text": "چون این باید همینو بخونم"
    },
    {
      "id": 80,
      "start": 7464.0,
      "end": 7465.0,
      "formatted_start": "02:04:24.000",
      "formatted_end": "02:04:25.000",
      "text": "پس خواهی که نداری؟"
    },
    {
      "id": 81,
      "start": 7465.0,
      "end": 7467.0,
      "formatted_start": "02:04:25.000",
      "formatted_end": "02:04:27.000",
      "text": "نه شو، همون دوران گشتی"
    },
    {
      "id": 82,
      "start": 7467.0,
      "end": 7475.0,
      "formatted_start": "02:04:27.000",
      "formatted_end": "02:04:35.000",
      "text": "از اینکه احران دلالا بازم بگم امون رو برنیم بسه امین شکم ها خیلی خوب برده بسه امون رو یه در موقع بودم ببرم خانه دو که رو برم برم ببرم"
    },
    {
      "id": 83,
      "start": 7475.0,
      "end": 7477.0,
      "formatted_start": "02:04:35.000",
      "formatted_end": "02:04:37.000",
      "text": "اگه الان نخوری دوباره اصال میافتی؟"
