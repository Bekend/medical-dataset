  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4207.5,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:07.500",
      "text": "درمیان ها کست های داخلیت کست های دو نوع هستند، خشکیم و بدخیمی. بدخیم نیست، این خشکیمه الان هم کوچکتر شده."
    },
    {
      "id": 1,
      "start": 4207.5,
      "end": 4215.0,
      "formatted_start": "01:10:07.500",
      "formatted_end": "01:10:15.000",
      "text": "بچه از نظر مغزیش خوبه، مثلا بشکارش اونها. در چه کست ها خشکیمی؟ کست ها خشکیم به مرور اعتماد هم خوب میشه."
    },
    {
      "id": 2,
      "start": 4215.0,
      "end": 4225.0,
      "formatted_start": "01:10:15.000",
      "formatted_end": "01:10:25.000",
      "text": "اون قسمت قلبش که پی دیر، وی اس دیه، اعتماد هم وی اس دیه، صوراخ بین دوتا بد، گفتن دوتا افره قلب، یه صوراخ ریز داره."
    },
    {
      "id": 3,
      "start": 4225.0,
      "end": 4229.0,
      "formatted_start": "01:10:25.000",
      "formatted_end": "01:10:29.000",
      "text": "این به مرور بسته میشه دارو هم نیست"
    },
    {
      "id": 4,
      "start": 4229.0,
      "end": 4233.0,
      "formatted_start": "01:10:29.000",
      "formatted_end": "01:10:33.000",
      "text": "این یکی اون کیست هم اگه خشکین باشه به مرور کچک میشه"
    },
    {
      "id": 5,
      "start": 4233.0,
      "end": 4235.0,
      "formatted_start": "01:10:33.000",
      "formatted_end": "01:10:35.000",
      "text": "کلیه چی گفتن ورم داره"
    },
    {
      "id": 6,
      "start": 4235.0,
      "end": 4240.0,
      "formatted_start": "01:10:35.000",
      "formatted_end": "01:10:40.000",
      "text": "تو سونیگرافی شکم بار داره گفتن سونیگرافیش ورم داره"
    },
    {
      "id": 7,
      "start": 4240.0,
      "end": 4244.0,
      "formatted_start": "01:10:40.000",
      "formatted_end": "01:10:44.000",
      "text": "دو هفته در بعد از زایمان سونوی دیگه کلیه بچه بشه"
    },
    {
      "id": 8,
      "start": 4244.0,
      "end": 4246.0,
      "formatted_start": "01:10:44.000",
      "formatted_end": "01:10:46.000",
      "text": "و سونو شده"
    },
    {
      "id": 9,
      "start": 4246.0,
      "end": 4250.0,
      "formatted_start": "01:10:46.000",
      "formatted_end": "01:10:50.000",
      "text": "سونو شده بود هنوز ورمشو داشت باز گفتن اولی بود"
    },
    {
      "id": 10,
      "start": 4250.0,
      "end": 4253.0,
      "formatted_start": "01:10:50.000",
      "formatted_end": "01:10:53.000",
      "text": "حالا این ها به مورد ادرار که کنه"
    },
    {
      "id": 11,
      "start": 4253.0,
      "end": 4256.0,
      "formatted_start": "01:10:53.000",
      "formatted_end": "01:10:56.000",
      "text": "ادرار که کنه، جریان ادرار زیاد بشه"
    },
    {
      "id": 12,
      "start": 4256.0,
      "end": 4259.0,
      "formatted_start": "01:10:56.000",
      "formatted_end": "01:10:59.000",
      "text": "اکثرا میگه ولن کلگه میخوام"
    },
    {
      "id": 13,
      "start": 4259.0,
      "end": 4263.0,
      "formatted_start": "01:10:59.000",
      "formatted_end": "01:11:03.000",
      "text": "همسه اونقدر چیز منظره بدی من توی این بچه نمیدونم"
    },
    {
      "id": 14,
      "start": 4263.0,
      "end": 4269.0,
      "formatted_start": "01:11:03.000",
      "formatted_end": "01:11:09.000",
      "text": "درسته چند پا علامت داره، هر کدام یه داستانی میتونی براش درست کنی که اصلا خوابت نبره شب"
    },
    {
      "id": 15,
      "start": 4269.0,
      "end": 4273.0,
      "formatted_start": "01:11:09.000",
      "formatted_end": "01:11:13.000",
      "text": "ولی به نظر نمیاد با تجربه ما سی سال داریم"
    },
    {
      "id": 16,
      "start": 4273.0,
      "end": 4275.0,
      "formatted_start": "01:11:13.000",
      "formatted_end": "01:11:15.000",
      "text": "چیزی باشه، دیگر هم نبره"
    },
    {
      "id": 17,
      "start": 4275.0,
      "end": 4280.0,
      "formatted_start": "01:11:15.000",
      "formatted_end": "01:11:20.000",
      "text": "من معواست باشه، زردیشم مایم نبود، بیاینا دست کنید"
    },
    {
      "id": 18,
      "start": 4305.0,
      "end": 4307.0,
      "formatted_start": "01:11:45.000",
      "formatted_end": "01:11:47.000",
      "text": "بله، بفنیم"
    },
    {
      "id": 19,
      "start": 4307.0,
      "end": 4308.0,
      "formatted_start": "01:11:47.000",
      "formatted_end": "01:11:48.000",
      "text": "سلام علیکم"
    },
    {
      "id": 20,
      "start": 4308.0,
      "end": 4310.0,
      "formatted_start": "01:11:48.000",
      "formatted_end": "01:11:50.000",
      "text": "سلام عباره خوش اومدین"
    },
    {
      "id": 21,
      "start": 4310.0,
      "end": 4311.0,
      "formatted_start": "01:11:50.000",
      "formatted_end": "01:11:51.000",
      "text": "خیلی خوش اومدین"
    },
    {
      "id": 22,
      "start": 4311.0,
      "end": 4313.0,
      "formatted_start": "01:11:51.000",
      "formatted_end": "01:11:53.000",
      "text": "سلام خوش اومدین خوبه"
    },
    {
      "id": 23,
      "start": 4313.0,
      "end": 4315.0,
      "formatted_start": "01:11:53.000",
      "formatted_end": "01:11:55.000",
      "text": "خوش رو رو تخت بزدارید"
    },
    {
      "id": 24,
      "start": 4315.0,
      "end": 4318.0,
      "formatted_start": "01:11:55.000",
      "formatted_end": "01:11:58.000",
      "text": "ما این شبه اومدیم، دست رو بردیم"
    },
    {
      "id": 25,
      "start": 4318.0,
      "end": 4320.0,
      "formatted_start": "01:11:58.000",
      "formatted_end": "01:12:00.000",
      "text": "دست رو بردیم"
    },
    {
      "id": 26,
      "start": 4320.0,
      "end": 4322.0,
      "formatted_start": "01:12:00.000",
      "formatted_end": "01:12:02.000",
      "text": "دست رو بردیم"
    },
    {
      "id": 27,
      "start": 4322.0,
      "end": 4324.0,
      "formatted_start": "01:12:02.000",
      "formatted_end": "01:12:04.000",
      "text": "خوب خابیده، آیا جانتی؟"
    },
    {
      "id": 28,
      "start": 4324.0,
      "end": 4326.0,
      "formatted_start": "01:12:04.000",
      "formatted_end": "01:12:06.000",
      "text": "کنشب برداشتیم؟"
    },
    {
      "id": 29,
      "start": 4326.0,
      "end": 4328.0,
      "formatted_start": "01:12:06.000",
      "formatted_end": "01:12:08.000",
      "text": "دو شب هستم برداشتیم"
    },
    {
      "id": 30,
      "start": 4328.0,
      "end": 4330.0,
      "formatted_start": "01:12:08.000",
      "formatted_end": "01:12:10.000",
      "text": "یک شبه و دو شبه امروز دو شب هستم"
    },
    {
      "id": 31,
      "start": 4330.0,
      "end": 4331.0,
      "formatted_start": "01:12:10.000",
      "formatted_end": "01:12:11.000",
      "text": "بله"
    },
    {
      "id": 32,
      "start": 4331.0,
      "end": 4333.0,
      "formatted_start": "01:12:11.000",
      "formatted_end": "01:12:13.000",
      "text": "خب دو شب حتی اقلت این زمانه"
    },
    {
      "id": 33,
      "start": 4333.0,
      "end": 4338.0,
      "formatted_start": "01:12:13.000",
      "formatted_end": "01:12:18.000",
      "text": "این شبه که هر درک سر استفاده رو کرده باشید"
    },
    {
      "id": 34,
      "start": 4340.0,
      "end": 4343.0,
      "formatted_start": "01:12:20.000",
      "formatted_end": "01:12:23.000",
      "text": "بدنش که خیلی خوبه کاملا سفیده"
    },
    {
      "id": 35,
      "start": 4344.0,
      "end": 4346.0,
      "formatted_start": "01:12:24.000",
      "formatted_end": "01:12:26.000",
      "text": "سوالاترهاش هم سفیده"
    },
    {
      "id": 36,
      "start": 4347.0,
      "end": 4350.0,
      "formatted_start": "01:12:27.000",
      "formatted_end": "01:12:30.000",
      "text": "این صورت دور چشم شاید یک کم ترک باشه"
    },
    {
      "id": 37,
      "start": 4351.0,
      "end": 4353.0,
      "formatted_start": "01:12:31.000",
      "formatted_end": "01:12:33.000",
      "text": "اینو پارچه میداده از اینجا خوب میشه اینو بازم"
    },
    {
      "id": 38,
      "start": 4354.0,
      "end": 4357.0,
      "formatted_start": "01:12:34.000",
      "formatted_end": "01:12:37.000",
      "text": "پایین زرگی خوب میشه اینجا چشم هست"
    },
    {
      "id": 39,
      "start": 4358.0,
      "end": 4361.0,
      "formatted_start": "01:12:38.000",
      "formatted_end": "01:12:41.000",
      "text": "هران شاید ۹۰۰۵ از اینجا زرگی خوب شده"
    },
    {
      "id": 40,
      "start": 4361.0,
      "end": 4365.0,
      "formatted_start": "01:12:41.000",
      "formatted_end": "01:12:45.000",
      "text": "خودتون هم شده ایش رو دیدنی، همین هم احساس می کنید بچه سفیده"
    },
    {
      "id": 41,
      "start": 4365.0,
      "end": 4368.0,
      "formatted_start": "01:12:45.000",
      "formatted_end": "01:12:48.000",
      "text": "آقایی درسته هم روشن شده"
    },
    {
      "id": 42,
      "start": 4368.0,
      "end": 4371.0,
      "formatted_start": "01:12:48.000",
      "formatted_end": "01:12:51.000",
      "text": "آره، بره، پوستش روشنتر شده"
    },
    {
      "id": 43,
      "start": 4373.0,
      "end": 4379.0,
      "formatted_start": "01:12:53.000",
      "formatted_end": "01:12:59.000",
      "text": "نه اینجا که سفیده سفیده، میگم اینجا از زردی آخرینجا تو خوب میشین، بالاترینی باشی"
    },
    {
      "id": 44,
      "start": 4379.0,
      "end": 4380.0,
      "formatted_start": "01:12:59.000",
      "formatted_end": "01:13:00.000",
      "text": "همان خوبست"
    },
    {
      "id": 45,
      "start": 4380.0,
      "end": 4381.0,
      "formatted_start": "01:13:00.000",
      "formatted_end": "01:13:01.000",
      "text": "شما؟"
    },
    {
      "id": 46,
      "start": 4381.0,
      "end": 4383.0,
      "formatted_start": "01:13:01.000",
      "formatted_end": "01:13:03.000",
      "text": "بره، بسیار عالی، خیلی هم خوبه"
    },
    {
      "id": 47,
      "start": 4383.0,
      "end": 4384.0,
      "formatted_start": "01:13:03.000",
      "formatted_end": "01:13:04.000",
      "text": "شکرم"
    },
    {
      "id": 48,
      "start": 4384.0,
      "end": 4387.0,
      "formatted_start": "01:13:04.000",
      "formatted_end": "01:13:07.000",
      "text": "دستانم تغییر شدید، پرس هم داده بودم"
    },
    {
      "id": 49,
      "start": 4387.0,
      "end": 4390.0,
      "formatted_start": "01:13:07.000",
      "formatted_end": "01:13:10.000",
      "text": "برسه که بگیرین. یک چارون دوازه سا."
    },
    {
      "id": 50,
      "start": 4390.0,
      "end": 4391.0,
      "formatted_start": "01:13:10.000",
      "formatted_end": "01:13:11.000",
      "text": "پتش کنید."
    },
    {
      "id": 51,
      "start": 4391.0,
      "end": 4393.0,
      "formatted_start": "01:13:11.000",
      "formatted_end": "01:13:13.000",
      "text": "افتمادات پر یه دورون دارید؟"
    },
    {
      "id": 52,
      "start": 4393.0,
      "end": 4395.0,
      "formatted_start": "01:13:13.000",
      "formatted_end": "01:13:15.000",
      "text": "ده درصد اونو بارید."
    },
    {
      "id": 53,
      "start": 4395.0,
      "end": 4397.0,
      "formatted_start": "01:13:15.000",
      "formatted_end": "01:13:17.000",
      "text": "چی این گیره افتمادات بارید بهش؟"
    },
    {
      "id": 54,
      "start": 4397.0,
      "end": 4399.0,
      "formatted_start": "01:13:17.000",
      "formatted_end": "01:13:19.000",
      "text": "اگه اصاس کرد."
    },
    {
      "id": 55,
      "start": 4399.0,
      "end": 4400.0,
      "formatted_start": "01:13:19.000",
      "formatted_end": "01:13:20.000",
      "text": "اگه اصاس کنید."
    },
    {
      "id": 56,
      "start": 4400.0,
      "end": 4401.0,
      "formatted_start": "01:13:20.000",
      "formatted_end": "01:13:21.000",
      "text": "بر میگیر."
    },
    {
      "id": 57,
      "start": 4401.0,
      "end": 4402.0,
      "formatted_start": "01:13:21.000",
      "formatted_end": "01:13:22.000",
      "text": "این شیر مادرش رو رو بیارید."
    },
    {
      "id": 58,
      "start": 4402.0,
      "end": 4404.0,
      "formatted_start": "01:13:22.000",
      "formatted_end": "01:13:24.000",
      "text": "یک ساعت زیاد کنیم، یک چار و چولیم گفتیم."
    },
    {
      "id": 59,
      "start": 4404.0,
      "end": 4405.0,
      "formatted_start": "01:13:24.000",
      "formatted_end": "01:13:25.000",
      "text": "آره."
    },
    {
      "id": 60,
      "start": 4405.0,
      "end": 4407.0,
      "formatted_start": "01:13:25.000",
      "formatted_end": "01:13:27.000",
      "text": "مادرش تو بیارید. مزدتون سال می کنید."
    },
    {
      "id": 61,
      "start": 4407.0,
      "end": 4412.28,
      "formatted_start": "01:13:27.000",
      "formatted_end": "01:13:32.280",
      "text": "من بهتری میگم 20 درصد 10 درصد بر میگرده دیگر ولی توی سوال می کنی می باشن"
    },
    {
      "id": 62,
      "start": 4412.28,
      "end": 4413.48,
      "formatted_start": "01:13:32.280",
      "formatted_end": "01:13:33.480",
      "text": "باید بر میگرده؟"
    },
    {
      "id": 63,
      "start": 4413.48,
      "end": 4414.28,
      "formatted_start": "01:13:33.480",
      "formatted_end": "01:13:34.280",
      "text": "اصطمال هستیم؟"
    },
    {
      "id": 64,
      "start": 4414.28,
      "end": 4416.28,
      "formatted_start": "01:13:34.280",
      "formatted_end": "01:13:36.280",
      "text": "بله این 10 درصد موارده"
    },
    {
      "id": 65,
      "start": 4416.28,
      "end": 4419.88,
      "formatted_start": "01:13:36.280",
      "formatted_end": "01:13:39.880",
      "text": "حالا این 10 درصد 90 درصد بر نمیگرده"
    },
    {
      "id": 66,
      "start": 4419.88,
      "end": 4423.88,
      "formatted_start": "01:13:39.880",
      "formatted_end": "01:13:43.880",
      "text": "موارده دیگر استثنائیه بچه این برگشت"
    },
    {
      "id": 67,
      "start": 4423.88,
      "end": 4425.72,
      "formatted_start": "01:13:43.880",
      "formatted_end": "01:13:45.720",
      "text": "من ببینم اگر برگشت نگران نباشی"
    },
    {
      "id": 68,
      "start": 4425.72,
      "end": 4427.56,
      "formatted_start": "01:13:45.720",
      "formatted_end": "01:13:47.560",
      "text": "نه بچه اون رو دوزیاش کرده نکرده؟"
    },
    {
      "id": 69,
      "start": 4427.56,
      "end": 4428.04,
      "formatted_start": "01:13:47.560",
      "formatted_end": "01:13:48.040",
      "text": "جا؟"
    },
    {
      "id": 70,
      "start": 4428.04,
      "end": 4428.76,
      "formatted_start": "01:13:48.040",
      "formatted_end": "01:13:48.760",
      "text": "یه رازش کنه"
    },
    {
      "id": 71,
      "start": 4428.76,
      "end": 4431.58,
      "formatted_start": "01:13:48.760",
      "formatted_end": "01:13:51.580",
      "text": "نه برای که تا دو هفته اول وزن بچه میاد پایین"
    },
    {
      "id": 72,
      "start": 4431.58,
      "end": 4434.18,
      "formatted_start": "01:13:51.580",
      "formatted_end": "01:13:54.180",
      "text": "یعنی 20 درصد افته"
    },
    {
      "id": 73,
      "start": 4434.18,
      "end": 4437.0,
      "formatted_start": "01:13:54.180",
      "formatted_end": "01:13:57.000",
      "text": "اون پف بچه میخوابه 20 درصد میاد پایین"
    },
    {
      "id": 74,
      "start": 4437.0,
      "end": 4439.0,
      "formatted_start": "01:13:57.000",
      "formatted_end": "01:13:59.000",
      "text": "الان وزنی میکنه که نارهد میشن"
    },
    {
      "id": 75,
      "start": 4439.0,
      "end": 4441.0,
      "formatted_start": "01:13:59.000",
      "formatted_end": "01:14:01.000",
      "text": "باید سوال کن که که رو کرده"
    },
    {
      "id": 76,
      "start": 4441.0,
      "end": 4443.52,
      "formatted_start": "01:14:01.000",
      "formatted_end": "01:14:03.520",
      "text": "خب پدرشون اون ترازوی ها اشتباه بوده"
    },
    {
      "id": 77,
      "start": 4443.52,
      "end": 4445.52,
      "formatted_start": "01:14:03.520",
      "formatted_end": "01:14:05.520",
      "text": "هره هره"
    },
    {
      "id": 78,
      "start": 4445.52,
      "end": 4449.32,
      "formatted_start": "01:14:05.520",
      "formatted_end": "01:14:09.320",
      "text": "مثلا زایشگاه اون پاشای سبز و گنده میدازن روی"
    },
    {
      "id": 79,
      "start": 4449.32,
      "end": 4451.32,
      "formatted_start": "01:14:09.320",
      "formatted_end": "01:14:11.320",
      "text": "چیز"
    },
    {
      "id": 80,
      "start": 4451.32,
      "end": 4453.32,
      "formatted_start": "01:14:11.320",
      "formatted_end": "01:14:13.320",
      "text": "روی ترازوی"
    },
    {
      "id": 81,
      "start": 4453.32,
      "end": 4455.96,
      "formatted_start": "01:14:13.320",
      "formatted_end": "01:14:15.960",
      "text": "مثلا میگن 3 کیلو یا 2 کیلو 800"
    },
    {
      "id": 82,
      "start": 4455.96,
      "end": 4457.96,
      "formatted_start": "01:14:15.960",
      "formatted_end": "01:14:17.960",
      "text": "بالا باسا"
    },
    {
      "id": 83,
      "start": 4457.96,
      "end": 4459.96,
      "formatted_start": "01:14:17.960",
      "formatted_end": "01:14:19.960",
      "text": "اصلا دو های ستر یا ستر"
    },
    {
      "id": 84,
      "start": 4459.96,
      "end": 4461.96,
      "formatted_start": "01:14:19.960",
      "formatted_end": "01:14:21.960",
      "text": "بعد میاد اینجا لباسش کم هست"
    },
    {
      "id": 85,
      "start": 4461.96,
      "end": 4463.96,
      "formatted_start": "01:14:21.960",
      "formatted_end": "01:14:23.960",
      "text": "ما میزنیم ورمش هم اومده پایین"
    },
    {
      "id": 86,
      "start": 4463.96,
      "end": 4465.96,
      "formatted_start": "01:14:23.960",
      "formatted_end": "01:14:25.960",
      "text": "میگیم دو و شهستتر"
    },
    {
      "id": 87,
      "start": 4465.96,
      "end": 4467.96,
      "formatted_start": "01:14:25.960",
      "formatted_end": "01:14:27.960",
      "text": "مادرش هم خواهش نیمی برده"
    },
    {
      "id": 88,
      "start": 4467.96,
      "end": 4469.96,
      "formatted_start": "01:14:27.960",
      "formatted_end": "01:14:29.960",
      "text": "بعد همه میگیم یک ماه ورزیزش"
    },
    {
      "id": 89,
      "start": 4469.96,
      "end": 4471.96,
      "formatted_start": "01:14:29.960",
      "formatted_end": "01:14:31.960",
      "text": "نه باید باید برده بیجای سر گرم ساره"
    },
    {
      "id": 90,
      "start": 4471.96,
      "end": 4473.96,
      "formatted_start": "01:14:31.960",
      "formatted_end": "01:14:33.960",
      "text": "حسن این سر گرم ساره"
    },
    {
      "id": 91,
      "start": 4473.96,
      "end": 4475.96,
      "formatted_start": "01:14:33.960",
      "formatted_end": "01:14:35.960",
      "text": "این بروز هست"
    },
    {
      "id": 92,
      "start": 4475.96,
      "end": 4477.96,
      "formatted_start": "01:14:35.960",
      "formatted_end": "01:14:37.960",
      "text": "ببینید خوانی جاکه بچه"
    },
    {
      "id": 93,
      "start": 4477.96,
      "end": 4479.96,
      "formatted_start": "01:14:37.960",
      "formatted_end": "01:14:39.960",
      "text": "آدمی زاد تنها حیوانیه"
    },
    {
      "id": 94,
      "start": 4479.96,
      "end": 4481.96,
      "formatted_start": "01:14:39.960",
      "formatted_end": "01:14:41.960",
      "text": "به بچه این"
    },
    {
      "id": 95,
      "start": 4481.96,
      "end": 4483.96,
      "formatted_start": "01:14:41.960",
      "formatted_end": "01:14:43.960",
      "text": "بچهش 20 سال روش میکنه"
    },
    {
      "id": 96,
      "start": 4483.96,
      "end": 4487.02,
      "formatted_start": "01:14:43.960",
      "formatted_end": "01:14:47.020",
      "text": "از این سپنگ دیگه بود، گاه و این هم نکنون پنج شش ماه دیگه دارد"
    },
    {
      "id": 97,
      "start": 4487.02,
      "end": 4491.02,
      "formatted_start": "01:14:47.020",
      "formatted_end": "01:14:51.020",
      "text": "اصلا یکی دو از مادک جدا میشن، اصلا رشد کاملشون"
    },
    {
      "id": 98,
      "start": 4491.02,
      "end": 4493.02,
      "formatted_start": "01:14:51.020",
      "formatted_end": "01:14:53.020",
      "text": "دیوانه ها شش ماه یک سال هستن"
    },
    {
      "id": 99,
      "start": 4493.02,
      "end": 4495.02,
      "formatted_start": "01:14:53.020",
      "formatted_end": "01:14:55.020",
      "text": "آره، شش ماه یک سال، دو سال"
    },
    {
      "id": 100,
      "start": 4495.02,
      "end": 4499.02,
      "formatted_start": "01:14:55.020",
      "formatted_end": "01:14:59.020",
      "text": "ولی امسان ما آدم ها تا بیس سال رشد میکنیم"
    },
    {
      "id": 101,
      "start": 4499.02,
      "end": 4500.02,
      "formatted_start": "01:14:59.020",
      "formatted_end": "01:15:00.020",
      "text": "درسته؟"
    }
  ],
  "status": "completed"
}