  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3602.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:02.000",
      "text": "سر سر درده."
    },
    {
      "id": 1,
      "start": 3602.0,
      "end": 3604.0,
      "formatted_start": "01:00:02.000",
      "formatted_end": "01:00:04.000",
      "text": "خودتان تو خونه بگید که سرم درد میگید."
    },
    {
      "id": 2,
      "start": 3604.0,
      "end": 3606.0,
      "formatted_start": "01:00:04.000",
      "formatted_end": "01:00:06.000",
      "text": "آره، آره."
    },
    {
      "id": 3,
      "start": 3606.0,
      "end": 3608.0,
      "formatted_start": "01:00:06.000",
      "formatted_end": "01:00:08.000",
      "text": "دایم میگید؟"
    },
    {
      "id": 4,
      "start": 3608.0,
      "end": 3610.0,
      "formatted_start": "01:00:08.000",
      "formatted_end": "01:00:10.000",
      "text": "دایم نه، چی بشه."
    },
    {
      "id": 5,
      "start": 3610.0,
      "end": 3612.0,
      "formatted_start": "01:00:10.000",
      "formatted_end": "01:00:12.000",
      "text": "بگید من یک عکس میتونم اول از خفه تیرسینش بگیرید، خب،"
    },
    {
      "id": 6,
      "start": 3612.0,
      "end": 3614.0,
      "formatted_start": "01:00:12.000",
      "formatted_end": "01:00:14.000",
      "text": "پرایپا دارید."
    },
    {
      "id": 7,
      "start": 3614.0,
      "end": 3616.0,
      "formatted_start": "01:00:14.000",
      "formatted_end": "01:00:16.000",
      "text": "من جماعتاً آزازشهرم بگیریم."
    },
    {
      "id": 8,
      "start": 3620.0,
      "end": 3622.0,
      "formatted_start": "01:00:20.000",
      "formatted_end": "01:00:22.000",
      "text": "بنابراین بینه اینکه اشتباهی داره،"
    },
    {
      "id": 9,
      "start": 3622.0,
      "end": 3624.0,
      "formatted_start": "01:00:22.000",
      "formatted_end": "01:00:24.000",
      "text": "این مرگی ها سر شده بینه."
    },
    {
      "id": 10,
      "start": 3624.0,
      "end": 3626.0,
      "formatted_start": "01:00:24.000",
      "formatted_end": "01:00:26.000",
      "text": "خب، آره بگیرید."
    },
    {
      "id": 11,
      "start": 3626.0,
      "end": 3628.0,
      "formatted_start": "01:00:26.000",
      "formatted_end": "01:00:28.000",
      "text": "این همین بیماری جسمی نداره"
    },
    {
      "id": 12,
      "start": 3628.0,
      "end": 3630.0,
      "formatted_start": "01:00:28.000",
      "formatted_end": "01:00:30.000",
      "text": "نه تو حالا نمیدونی"
    },
    {
      "id": 13,
      "start": 3630.0,
      "end": 3634.0,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:34.000",
      "text": "این خالصه ها خالصه دردیه"
    },
    {
      "id": 14,
      "start": 3634.0,
      "end": 3638.0,
      "formatted_start": "01:00:34.000",
      "formatted_end": "01:00:38.000",
      "text": "این بیماری جسمی نداره"
    },
    {
      "id": 15,
      "start": 3638.0,
      "end": 3640.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:40.000",
      "text": "نه توالا نمیدونی"
    },
    {
      "id": 16,
      "start": 3640.0,
      "end": 3642.0,
      "formatted_start": "01:00:40.000",
      "formatted_end": "01:00:42.000",
      "text": "این بیماری خیلی شدید بیماری"
    },
    {
      "id": 17,
      "start": 3642.0,
      "end": 3644.0,
      "formatted_start": "01:00:42.000",
      "formatted_end": "01:00:44.000",
      "text": "این پیش درد استراف های عصبی داره"
    },
    {
      "id": 18,
      "start": 3644.0,
      "end": 3646.0,
      "formatted_start": "01:00:44.000",
      "formatted_end": "01:00:46.000",
      "text": "که به صورت دردی اینجا باید برده"
    },
    {
      "id": 19,
      "start": 3646.0,
      "end": 3648.0,
      "formatted_start": "01:00:46.000",
      "formatted_end": "01:00:48.000",
      "text": "حالا من اکس میبینم فیگیری منو میفونم"
    },
    {
      "id": 20,
      "start": 3648.0,
      "end": 3650.0,
      "formatted_start": "01:00:48.000",
      "formatted_end": "01:00:50.000",
      "text": "که ببینم زیرش مشکلی نداره"
    },
    {
      "id": 21,
      "start": 3650.0,
      "end": 3654.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:54.000",
      "text": "از این درد قفص سینه مهمه"
    },
    {
      "id": 22,
      "start": 3654.0,
      "end": 3656.0,
      "formatted_start": "01:00:54.000",
      "formatted_end": "01:00:56.000",
      "text": "وقتی قلب و ریش"
    },
    {
      "id": 23,
      "start": 3656.0,
      "end": 3660.0,
      "formatted_start": "01:00:56.000",
      "formatted_end": "01:01:00.000",
      "text": "از این رنگش هم اصلا خیلی سپید میشه"
    },
    {
      "id": 24,
      "start": 3660.0,
      "end": 3664.0,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:04.000",
      "text": "یک چکاپ هم ازماش چکاپ اولیه انجام بگیریم"
    },
    {
      "id": 25,
      "start": 3664.0,
      "end": 3670.0,
      "formatted_start": "01:01:04.000",
      "formatted_end": "01:01:10.000",
      "text": "که همین آهنگ و بیتامین بی و خونه از خوب"
    },
    {
      "id": 26,
      "start": 3670.0,
      "end": 3673.0,
      "formatted_start": "01:01:10.000",
      "formatted_end": "01:01:13.000",
      "text": "این آزماش رو عکسی بگیریم بیاییم هم ببینم"
    },
    {
      "id": 27,
      "start": 3673.0,
      "end": 3679.0,
      "formatted_start": "01:01:13.000",
      "formatted_end": "01:01:19.000",
      "text": "از این با تقییم چیزش رو بیمارتون رو بیچرکه گذاریم"
    },
    {
      "id": 28,
      "start": 3679.0,
      "end": 3681.0,
      "formatted_start": "01:01:19.000",
      "formatted_end": "01:01:21.000",
      "text": "عکس رو ببینیم"
    },
    {
      "id": 29,
      "start": 3681.0,
      "end": 3683.0,
      "formatted_start": "01:01:21.000",
      "formatted_end": "01:01:23.000",
      "text": "ببینیم برنامه"
    },
    {
      "id": 30,
      "start": 3683.0,
      "end": 3687.0,
      "formatted_start": "01:01:23.000",
      "formatted_end": "01:01:27.000",
      "text": "این چکار ازماش های اولیه رو هم انجام بدیم"
    },
    {
      "id": 31,
      "start": 3687.0,
      "end": 3689.0,
      "formatted_start": "01:01:27.000",
      "formatted_end": "01:01:29.000",
      "text": "ببینیم"
    },
    {
      "id": 32,
      "start": 3689.0,
      "end": 3691.0,
      "formatted_start": "01:01:29.000",
      "formatted_end": "01:01:31.000",
      "text": "اینو ببینیم"
    },
    {
      "id": 33,
      "start": 3691.0,
      "end": 3693.0,
      "formatted_start": "01:01:31.000",
      "formatted_end": "01:01:33.000",
      "text": "عکس رو ازماش سخت کنه انجام بدیم"
    },
    {
      "id": 34,
      "start": 3693.0,
      "end": 3695.0,
      "formatted_start": "01:01:33.000",
      "formatted_end": "01:01:35.000",
      "text": "بیاییم هم بیمارتون"
    },
    {
      "id": 35,
      "start": 3695.0,
      "end": 3697.0,
      "formatted_start": "01:01:35.000",
      "formatted_end": "01:01:37.000",
      "text": "عکس رو همین بگیریم؟ بله"
    },
    {
      "id": 36,
      "start": 3697.0,
      "end": 3699.0,
      "formatted_start": "01:01:37.000",
      "formatted_end": "01:01:39.000",
      "text": "عکس رو در جاهای سود بیاد یا نه؟"
    },
    {
      "id": 37,
      "start": 3699.0,
      "end": 3701.0,
      "formatted_start": "01:01:39.000",
      "formatted_end": "01:01:41.000",
      "text": "یا این عکسه؟"
    },
    {
      "id": 38,
      "start": 3701.0,
      "end": 3703.82,
      "formatted_start": "01:01:41.000",
      "formatted_end": "01:01:43.820",
      "text": "عکس زود، آزماییش زمان می بره"
    },
    {
      "id": 39,
      "start": 3703.82,
      "end": 3704.82,
      "formatted_start": "01:01:43.820",
      "formatted_end": "01:01:44.820",
      "text": "آره می برم"
    },
    {
      "id": 40,
      "start": 3704.82,
      "end": 3707.0,
      "formatted_start": "01:01:44.820",
      "formatted_end": "01:01:47.000",
      "text": "حالا، عکس باید زود شد"
    },
    {
      "id": 41,
      "start": 3708.0,
      "end": 3709.0,
      "formatted_start": "01:01:48.000",
      "formatted_end": "01:01:49.000",
      "text": "پیشن هم رفته"
    },
    {
      "id": 42,
      "start": 3715.0,
      "end": 3716.0,
      "formatted_start": "01:01:55.000",
      "formatted_end": "01:01:56.000",
      "text": "بپند جمع"
    },
    {
      "id": 43,
      "start": 3716.0,
      "end": 3717.0,
      "formatted_start": "01:01:56.000",
      "formatted_end": "01:01:57.000",
      "text": "تو تانسونی که زدیدی"
    },
    {
      "id": 44,
      "start": 3717.0,
      "end": 3718.0,
      "formatted_start": "01:01:57.000",
      "formatted_end": "01:01:58.000",
      "text": "خیلی"
    },
    {
      "id": 45,
      "start": 3718.0,
      "end": 3722.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:02.000",
      "text": "این شربت هاش روزی سه بار، پاشوهای مربع خوری"
    },
    {
      "id": 46,
      "start": 3731.0,
      "end": 3744.0,
      "formatted_start": "01:02:11.000",
      "formatted_end": "01:02:24.000",
      "text": "موسیقی"
    },
    {
      "id": 47,
      "start": 3744.0,
      "end": 3748.0,
      "formatted_start": "01:02:24.000",
      "formatted_end": "01:02:28.000",
      "text": "کام سمیر سرمخوردگی رو دو تا زدین؟"
    },
    {
      "id": 48,
      "start": 3748.0,
      "end": 3749.0,
      "formatted_start": "01:02:28.000",
      "formatted_end": "01:02:29.000",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 3749.0,
      "end": 3751.0,
      "formatted_start": "01:02:29.000",
      "formatted_end": "01:02:31.000",
      "text": "ها چرا اینجا یه دانه سخ شده؟"
    },
    {
      "id": 50,
      "start": 3751.0,
      "end": 3757.0,
      "formatted_start": "01:02:31.000",
      "formatted_end": "01:02:37.000",
      "text": "موسیقی"
    },
    {
      "id": 51,
      "start": 3757.0,
      "end": 3759.0,
      "formatted_start": "01:02:37.000",
      "formatted_end": "01:02:39.000",
      "text": "شما بیمه بودید یا آزاد؟"
    },
    {
      "id": 52,
      "start": 3759.0,
      "end": 3760.0,
      "formatted_start": "01:02:39.000",
      "formatted_end": "01:02:40.000",
      "text": "بیمه"
    },
    {
      "id": 53,
      "start": 3760.0,
      "end": 3762.0,
      "formatted_start": "01:02:40.000",
      "formatted_end": "01:02:42.000",
      "text": "آی بلی"
    },
    {
      "id": 54,
      "start": 3771.04,
      "end": 3773.04,
      "formatted_start": "01:02:51.040",
      "formatted_end": "01:02:53.040",
      "text": "دو تا خورده"
    },
    {
      "id": 55,
      "start": 3776.0,
      "end": 3778.0,
      "formatted_start": "01:02:56.000",
      "formatted_end": "01:02:58.000",
      "text": "میخوای دارو خانه یه زنگ بزن"
    },
    {
      "id": 56,
      "start": 3778.0,
      "end": 3782.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:02.000",
      "text": "دوگو با دکتر ما صحبت کرده"
    },
    {
      "id": 57,
      "start": 3782.0,
      "end": 3786.0,
      "formatted_start": "01:03:02.000",
      "formatted_end": "01:03:06.000",
      "text": "قرار...الان اینو اومده"
    },
    {
      "id": 58,
      "start": 3786.0,
      "end": 3790.28,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:10.280",
      "text": "۷۴ توم هم بیمه اصاف کرده ۳۶ توم هم اینجوری اصاف کرده"
    },
    {
      "id": 59,
      "start": 3790.28,
      "end": 3796.48,
      "formatted_start": "01:03:10.280",
      "formatted_end": "01:03:16.480",
      "text": "۳۶۰ پلرژین ۳۶۰ اصاف کرده ۷۴ بیمه زده"
    },
    {
      "id": 60,
      "start": 3799.92,
      "end": 3802.08,
      "formatted_start": "01:03:19.920",
      "formatted_end": "01:03:22.080",
      "text": "بشه بگو ما دو تا زده بودیم حالا"
    },
    {
      "id": 61,
      "start": 3803.28,
      "end": 3804.88,
      "formatted_start": "01:03:23.280",
      "formatted_end": "01:03:24.880",
      "text": "بیتر مرشد میگو"
    },
    {
      "id": 62,
      "start": 3810.8,
      "end": 3812.72,
      "formatted_start": "01:03:30.800",
      "formatted_end": "01:03:32.720",
      "text": "اون داروتون آزاده؟"
    },
    {
      "id": 63,
      "start": 3812.72,
      "end": 3822.72,
      "formatted_start": "01:03:32.720",
      "formatted_end": "01:03:42.720",
      "text": "اونو پلر جین اونوری اونوری ما سرما خوردگی رو دوتا زنیم که بگیم قیمت کمتر براتون بیفتیم"
    },
    {
      "id": 64,
      "start": 3822.72,
      "end": 3829.72,
      "formatted_start": "01:03:42.720",
      "formatted_end": "01:03:49.720",
      "text": "این حالا ۷۴ تومن کمتر بیفتیم چرا خرابه تو باید دوتا بزنیم اونو"
    },
    {
      "id": 65,
      "start": 3829.72,
      "end": 3838.72,
      "formatted_start": "01:03:49.720",
      "formatted_end": "01:03:58.720",
      "text": "خب برای دکتر بوید دکتر سینا بگو اگه دوتا بزنیم اونو ما رایگال میزنیم"
    },
    {
      "id": 66,
      "start": 3838.72,
      "end": 3841.72,
      "formatted_start": "01:03:58.720",
      "formatted_end": "01:04:01.720",
      "text": "سرماخور دیگه بزنی؟"
    },
    {
      "id": 67,
      "start": 3861.72,
      "end": 3863.72,
      "formatted_start": "01:04:21.720",
      "formatted_end": "01:04:23.720",
      "text": "دو تا سرماخور دیگه بزنی؟"
    },
    {
      "id": 68,
      "start": 3863.72,
      "end": 3866.72,
      "formatted_start": "01:04:23.720",
      "formatted_end": "01:04:26.720",
      "text": "بگو باید دکتورت با من چیز دیگه گفت"
    },
    {
      "id": 69,
      "start": 3866.72,
      "end": 3870.72,
      "formatted_start": "01:04:26.720",
      "formatted_end": "01:04:30.720",
      "text": "باشه بشه بگیر سرما خورد دیگه معمولیه بزاره"
    },
    {
      "id": 70,
      "start": 3874.72,
      "end": 3876.72,
      "formatted_start": "01:04:34.720",
      "formatted_end": "01:04:36.720",
      "text": "باشه مرسی"
    },
    {
      "id": 71,
      "start": 3876.72,
      "end": 3878.72,
      "formatted_start": "01:04:36.720",
      "formatted_end": "01:04:38.720",
      "text": "خواهش میکنم؟"
    },
    {
      "id": 72,
      "start": 3878.72,
      "end": 3880.72,
      "formatted_start": "01:04:38.720",
      "formatted_end": "01:04:40.720",
      "text": "خدا باشه"
    },
    {
      "id": 73,
      "start": 3896.72,
      "end": 3898.72,
      "formatted_start": "01:04:56.720",
      "formatted_end": "01:04:58.720",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}