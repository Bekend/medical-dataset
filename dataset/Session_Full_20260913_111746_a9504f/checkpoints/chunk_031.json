      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9354.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:54.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 9354.0,
      "end": 9361.52,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:36:01.520",
      "text": "آی نگو نگو دل ها فضل تو میدونه"
    },
    {
      "id": 3,
      "start": 9361.52,
      "end": 9368.94,
      "formatted_start": "02:36:01.520",
      "formatted_end": "02:36:08.940",
      "text": "بیرگه کشی دیگه باید خود نمیدونه"
    },
    {
      "id": 4,
      "start": 9368.94,
      "end": 9376.56,
      "formatted_start": "02:36:08.940",
      "formatted_end": "02:36:16.560",
      "text": "باز ملامتش نکن چه ایشهای گریه اونه"
    },
    {
      "id": 5,
      "start": 9376.56,
      "end": 9383.56,
      "formatted_start": "02:36:16.560",
      "formatted_end": "02:36:23.560",
      "text": "اون که از هگاه تو چیزی نمیخونه"
    },
    {
      "id": 6,
      "start": 9384.08,
      "end": 9387.74,
      "formatted_start": "02:36:24.080",
      "formatted_end": "02:36:27.740",
      "text": "چیزی نمیپونه"
    },
    {
      "id": 7,
      "start": 9387.74,
      "end": 9394.56,
      "formatted_start": "02:36:27.740",
      "formatted_end": "02:36:34.560",
      "text": "ای پیپی اون که بای تو هده شد"
    },
    {
      "id": 8,
      "start": 9395.32,
      "end": 9398.96,
      "formatted_start": "02:36:35.320",
      "formatted_end": "02:36:38.960",
      "text": "ای پس جمعونی"
    },
    {
      "id": 9,
      "start": 9406.56,
      "end": 9436.54,
      "formatted_start": "02:36:46.560",
      "formatted_end": "02:37:16.540",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 10,
      "start": 9436.56,
      "end": 9456.56,
      "formatted_start": "02:37:16.560",
      "formatted_end": "02:37:36.560",
