    },
    {
      "id": 8,
      "start": 5028.0,
      "end": 5056.0,
      "formatted_start": "01:23:48.000",
      "formatted_end": "01:24:16.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 5058.0,
      "end": 5063.38,
      "formatted_start": "01:24:18.000",
      "formatted_end": "01:24:23.380",
      "text": "در اینجا هیچ تصویر از زم نزدیک نموکرده باشید"
    },
    {
      "id": 10,
      "start": 5063.38,
      "end": 5065.72,
      "formatted_start": "01:24:23.380",
      "formatted_end": "01:24:25.720",
      "text": "که شما سالا خارج از این از اینکه"
    },
    {
      "id": 11,
      "start": 5065.72,
      "end": 5071.62,
      "formatted_start": "01:24:25.720",
      "formatted_end": "01:24:31.620",
      "text": "خیلی تناش میکنند که بیرند شما بهرگشتی که"
    },
    {
      "id": 12,
      "start": 5071.62,
      "end": 5074.86,
      "formatted_start": "01:24:31.620",
      "formatted_end": "01:24:34.860",
      "text": "من بعد از موقعیتی خیلی من کار سوام دیگه"
    },
    {
      "id": 13,
      "start": 5074.86,
      "end": 5076.98,
      "formatted_start": "01:24:34.860",
      "formatted_end": "01:24:36.980",
      "text": "و که دو سوام دیگه من بودم فرانسیه"
    },
    {
      "id": 14,
      "start": 5076.98,
      "end": 5078.68,
      "formatted_start": "01:24:36.980",
      "formatted_end": "01:24:38.680",
      "text": "که هایی دیگه رفتن داشتن"
    },
    {
      "id": 15,
      "start": 5078.68,
      "end": 5080.84,
      "formatted_start": "01:24:38.680",
      "formatted_end": "01:24:40.840",
      "text": "یه دوزه امریکایی که هم مکرم"
    },
    {
      "id": 16,
      "start": 5080.84,
      "end": 5083.78,
      "formatted_start": "01:24:40.840",
      "formatted_end": "01:24:43.780",
      "text": "و من گفت که اون روزان ندارم میرم"
    },
    {
      "id": 17,
      "start": 5083.78,
      "end": 5085.4,
      "formatted_start": "01:24:43.780",
      "formatted_end": "01:24:45.400",
      "text": "گفت که بمون"
    },
    {
      "id": 18,
      "start": 5085.4,
      "end": 5087.84,
      "formatted_start": "01:24:45.400",
      "formatted_end": "01:24:47.840",
      "text": "ایران سویی سخته"
    },
    {
      "id": 19,
      "start": 5087.84,
      "end": 5090.28,
      "formatted_start": "01:24:47.840",
      "formatted_end": "01:24:50.280",
      "text": "من جونقه ای که بهش گفتم"
    },
    {
      "id": 20,
      "start": 5090.28,
      "end": 5091.94,
      "formatted_start": "01:24:50.280",
      "formatted_end": "01:24:51.940",
      "text": "قرار دارم بگم"
    },
    {
      "id": 21,
      "start": 5091.94,
      "end": 5094.68,
      "formatted_start": "01:24:51.940",
      "formatted_end": "01:24:54.680",
      "text": "گفتم ببین ایران سخته"
    },
    {
      "id": 22,
      "start": 5094.68,
      "end": 5096.84,
      "formatted_start": "01:24:54.680",
      "formatted_end": "01:24:56.840",
      "text": "منتقل اینجا پیمانیه"
    },
    {
      "id": 23,
      "start": 5096.84,
      "end": 5100.0,
      "formatted_start": "01:24:56.840",
      "formatted_end": "01:25:00.000",
      "text": "من سختی رو بگم"
    }
  ],
