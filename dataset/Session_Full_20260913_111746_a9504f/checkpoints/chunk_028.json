      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 8430.0,
      "end": 8446.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:46.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 8460.0,
      "end": 8489.98,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 3,
      "start": 8490.0,
      "end": 8519.0,
      "formatted_start": "02:21:30.000",
      "formatted_end": "02:21:59.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 8520.0,
      "end": 8549.0,
      "formatted_start": "02:22:00.000",
      "formatted_end": "02:22:29.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 8549.0,
      "end": 8551.0,
      "formatted_start": "02:22:29.000",
      "formatted_end": "02:22:31.000",
      "text": "سلام اسم جون"
    },
    {
      "id": 6,
      "start": 8551.0,
      "end": 8553.0,
      "formatted_start": "02:22:31.000",
      "formatted_end": "02:22:33.000",
      "text": "سلام بابا"
    },
    {
      "id": 7,
      "start": 8553.0,
      "end": 8557.0,
      "formatted_start": "02:22:33.000",
      "formatted_end": "02:22:37.000",
      "text": "اسم بگم من مدت اب همه شده خوب"
    },
    {
      "id": 8,
      "start": 8557.0,
      "end": 8562.0,
      "formatted_start": "02:22:37.000",
      "formatted_end": "02:22:42.000",
      "text": "دارم میام میخوام برم باشگاه اگر می آیی بیام دنبالت بریم"
    },
    {
      "id": 9,
      "start": 8565.0,
      "end": 8567.0,
      "formatted_start": "02:22:45.000",
      "formatted_end": "02:22:47.000",
      "text": "الو"
    },
    {
      "id": 10,
      "start": 8568.0,
      "end": 8570.0,
      "formatted_start": "02:22:48.000",
      "formatted_end": "02:22:50.000",
      "text": "اسم"
    },
    {
      "id": 11,
      "start": 8570.0,
      "end": 8572.0,
      "formatted_start": "02:22:50.000",
      "formatted_end": "02:22:52.000",
      "text": "اسم جون اسم"
    },
    {
      "id": 12,
      "start": 8572.0,
      "end": 8573.0,
      "formatted_start": "02:22:52.000",
      "formatted_end": "02:22:53.000",
      "text": "الان صدام هست بابا جون"
    },
    {
      "id": 13,
      "start": 8573.0,
      "end": 8575.0,
      "formatted_start": "02:22:53.000",
      "formatted_end": "02:22:55.000",
      "text": "جان آره صده تو دارم بابا جون"
    },
    {
      "id": 14,
      "start": 8575.0,
      "end": 8578.0,
      "formatted_start": "02:22:55.000",
      "formatted_end": "02:22:58.000",
      "text": "میگم من هنوز ماشینه نشستم الان میخوام برم ماشینه بشورم"
    },
    {
      "id": 15,
      "start": 8578.0,
      "end": 8580.2,
      "formatted_start": "02:22:58.000",
      "formatted_end": "02:23:00.200",
      "text": "خب شما چیز کن"
    },
    {
      "id": 16,
      "start": 8580.2,
      "end": 8581.68,
      "formatted_start": "02:23:00.200",
      "formatted_end": "02:23:01.680",
      "text": "ماشین ها بشور"
    },
    {
      "id": 17,
      "start": 8581.68,
      "end": 8583.46,
      "formatted_start": "02:23:01.680",
      "formatted_end": "02:23:03.460",
      "text": "من تا بیست دقیقه دیگه میرسم"
    },
    {
      "id": 18,
      "start": 8583.46,
      "end": 8585.58,
      "formatted_start": "02:23:03.460",
      "formatted_end": "02:23:05.580",
      "text": "تو الان برو پایی ماشین ها بشور"
    },
    {
      "id": 19,
      "start": 8585.58,
      "end": 8587.46,
      "formatted_start": "02:23:05.580",
      "formatted_end": "02:23:07.460",
      "text": "خب من میرسم"
    },
    {
      "id": 20,
      "start": 8587.46,
      "end": 8588.56,
      "formatted_start": "02:23:07.460",
      "formatted_end": "02:23:08.560",
      "text": "بعد با هم میریم اینا"
    },
    {
      "id": 21,
      "start": 8588.56,
      "end": 8591.52,
      "formatted_start": "02:23:08.560",
      "formatted_end": "02:23:11.520",
      "text": "باشه خدافر"
    },
    {
      "id": 22,
      "start": 8591.52,
      "end": 8592.54,
      "formatted_start": "02:23:11.520",
      "formatted_end": "02:23:12.540",
      "text": "خدافر"
    },
    {
      "id": 23,
      "start": 8608.0,
      "end": 8618.88,
      "formatted_start": "02:23:28.000",
      "formatted_end": "02:23:38.880",
      "text": "تو خواستی من نکستم با هم باشم دلو"
    },
    {
      "id": 24,
      "start": 8618.88,
      "end": 8624.28,
      "formatted_start": "02:23:38.880",
      "formatted_end": "02:23:44.280",
      "text": "نشستی من نشستم به پای لرزه دلو"
    },
    {
      "id": 25,
      "start": 8624.28,
      "end": 8627.28,
      "formatted_start": "02:23:44.280",
      "formatted_end": "02:23:47.280",
      "text": "به پای لرزه دلو"
    },
    {
      "id": 26,
      "start": 8627.28,
      "end": 8637.14,
      "formatted_start": "02:23:47.280",
      "formatted_end": "02:23:57.140",
      "text": "تو بودی من نبودم منم دیبونه مثل مجموع"
    },
    {
      "id": 27,
      "start": 8637.14,
      "end": 8641.82,
      "formatted_start": "02:23:57.140",
      "formatted_end": "02:24:01.820",
      "text": "تو موندی من و موندم به پای افتاده"
    },
    {
      "id": 28,
      "start": 8641.82,
      "end": 8652.44,
      "formatted_start": "02:24:01.820",
      "formatted_end": "02:24:12.440",
      "text": "دیشه بابره من کنار من نشدی"
    },
    {
      "id": 29,
      "start": 8652.44,
      "end": 8658.54,
      "formatted_start": "02:24:12.440",
      "formatted_end": "02:24:18.540",
      "text": "کسی که میخواست تو بودی و تو نخواستی"
    },
    {
      "id": 30,
      "start": 8667.14,
      "end": 8683.14,
      "formatted_start": "02:24:27.140",
      "formatted_end": "02:24:43.140",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 8683.14,
      "end": 8700.14,
      "formatted_start": "02:24:43.140",
      "formatted_end": "02:25:00.140",
      "text": "موسیقی"
    }
  ],
