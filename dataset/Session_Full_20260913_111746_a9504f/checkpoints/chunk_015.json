  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4508.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:08.000",
      "text": "همینجوری نیست که بچه هایی ۱۱ سال روش باشد، حالا یک شبه رستن نمیشه."
    },
    {
      "id": 1,
      "start": 4508.0,
      "end": 4517.0,
      "formatted_start": "01:15:08.000",
      "formatted_end": "01:15:17.000",
      "text": "بچه هایی داروخانه، آیا جامعانتی و بخور ها، همینجور مریضه من بودند."
    },
    {
      "id": 2,
      "start": 4517.0,
      "end": 4521.0,
      "formatted_start": "01:15:17.000",
      "formatted_end": "01:15:21.000",
      "text": "یعنی اینها الان من بینم مثل رستن من این گفت بودند."
    },
    {
      "id": 3,
      "start": 4521.0,
      "end": 4528.0,
      "formatted_start": "01:15:21.000",
      "formatted_end": "01:15:28.000",
      "text": "اصلا مادرهایشون می آمدند و گفتند این اصلا چون نه دار مثل موشه، الان من ببینم خوش راپور خدا تو داروخانه."
    },
    {
      "id": 4,
      "start": 4528.0,
      "end": 4532.0,
      "formatted_start": "01:15:28.000",
      "formatted_end": "01:15:32.000",
      "text": "بچه من مریض خودتون بوده"
    },
    {
      "id": 5,
      "start": 4532.0,
      "end": 4534.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:34.000",
      "text": "بچه من بچه یه اولم"
    },
    {
      "id": 6,
      "start": 4534.0,
      "end": 4536.0,
      "formatted_start": "01:15:34.000",
      "formatted_end": "01:15:36.000",
      "text": "اما ۱۵ سالش از شنو هم شنو منه"
    },
    {
      "id": 7,
      "start": 4536.0,
      "end": 4538.0,
      "formatted_start": "01:15:36.000",
      "formatted_end": "01:15:38.000",
      "text": "بره اما"
    },
    {
      "id": 8,
      "start": 4538.0,
      "end": 4540.0,
      "formatted_start": "01:15:38.000",
      "formatted_end": "01:15:40.000",
      "text": "سایز پشت از من بیشتر شده"
    },
    {
      "id": 9,
      "start": 4540.0,
      "end": 4542.0,
      "formatted_start": "01:15:40.000",
      "formatted_end": "01:15:42.000",
      "text": "مریض خودتون بوده"
    },
    {
      "id": 10,
      "start": 4542.0,
      "end": 4544.0,
      "formatted_start": "01:15:42.000",
      "formatted_end": "01:15:44.000",
      "text": "شکر خدا خدا این شده قطعه از شما بردود بزرگتر"
    },
    {
      "id": 11,
      "start": 4544.0,
      "end": 4546.0,
      "formatted_start": "01:15:44.000",
      "formatted_end": "01:15:46.000",
      "text": "سباسه خدا"
    },
    {
      "id": 12,
      "start": 4546.0,
      "end": 4548.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:48.000",
      "text": "زمان روشتر اینجا شنو شنو باید بزرگتر"
    },
    {
      "id": 13,
      "start": 4548.0,
      "end": 4550.0,
      "formatted_start": "01:15:48.000",
      "formatted_end": "01:15:50.000",
      "text": "سباسه خدا"
    },
    {
      "id": 14,
      "start": 4550.0,
      "end": 4552.0,
      "formatted_start": "01:15:50.000",
      "formatted_end": "01:15:52.000",
      "text": "خدا خدا"
    },
    {
      "id": 15,
      "start": 4552.0,
      "end": 4556.0,
      "formatted_start": "01:15:52.000",
      "formatted_end": "01:15:56.000",
      "text": "برین قطعه خیلی بگو برید"
    },
    {
      "id": 16,
      "start": 4556.0,
      "end": 4560.0,
      "formatted_start": "01:15:56.000",
      "formatted_end": "01:16:00.000",
      "text": "بستر هر هشت ساعت هشت قصده برای نفقه"
    },
    {
      "id": 17,
      "start": 4560.0,
      "end": 4562.0,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:02.000",
      "text": "این هم هشت ساعت مربع کنید"
    },
    {
      "id": 18,
      "start": 4562.0,
      "end": 4564.0,
      "formatted_start": "01:16:02.000",
      "formatted_end": "01:16:04.000",
      "text": "عادیه فدمت شو"
    },
    {
      "id": 19,
      "start": 4564.0,
      "end": 4566.0,
      "formatted_start": "01:16:04.000",
      "formatted_end": "01:16:06.000",
      "text": "هر هشت ساعت مربع کنید"
    },
    {
      "id": 20,
      "start": 4566.0,
      "end": 4568.0,
      "formatted_start": "01:16:06.000",
      "formatted_end": "01:16:08.000",
      "text": "یعنی این بودید یک و نمی دو سی سی"
    },
    {
      "id": 21,
      "start": 4568.0,
      "end": 4570.0,
      "formatted_start": "01:16:08.000",
      "formatted_end": "01:16:10.000",
      "text": "سلام خوش آمد"
    },
    {
      "id": 22,
      "start": 4570.0,
      "end": 4572.0,
      "formatted_start": "01:16:10.000",
      "formatted_end": "01:16:12.000",
      "text": "خوبه؟ مرسی بخوام"
    },
    {
      "id": 23,
      "start": 4572.0,
      "end": 4574.0,
      "formatted_start": "01:16:12.000",
      "formatted_end": "01:16:14.000",
      "text": "اون بچه هم در این وقت سفر می کنید"
    },
    {
      "id": 24,
      "start": 4574.0,
      "end": 4576.0,
      "formatted_start": "01:16:14.000",
      "formatted_end": "01:16:16.000",
      "text": "آه اون برگه تونه می زن دیدید که من خوشتش برمیزم"
    },
    {
      "id": 25,
      "start": 4576.0,
      "end": 4578.0,
      "formatted_start": "01:16:16.000",
      "formatted_end": "01:16:18.000",
      "text": "خانمی شیخ راسمی"
    },
    {
      "id": 26,
      "start": 4578.0,
      "end": 4580.0,
      "formatted_start": "01:16:18.000",
      "formatted_end": "01:16:20.000",
      "text": "چند روزه اصحاله؟"
    },
    {
      "id": 27,
      "start": 4580.0,
      "end": 4582.0,
      "formatted_start": "01:16:20.000",
      "formatted_end": "01:16:22.000",
      "text": "نه نه نه یه هفته"
    },
    {
      "id": 28,
      "start": 4582.0,
      "end": 4584.0,
      "formatted_start": "01:16:22.000",
      "formatted_end": "01:16:24.000",
      "text": "استفراح؟ استفراح نه"
    },
    {
      "id": 29,
      "start": 4584.0,
      "end": 4586.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:26.000",
      "text": "گردین دکتور بهش داری دار"
    },
    {
      "id": 30,
      "start": 4586.0,
      "end": 4588.0,
      "formatted_start": "01:16:26.000",
      "formatted_end": "01:16:28.000",
      "text": "قطعه یکچگی دار با یه"
    },
    {
      "id": 31,
      "start": 4588.0,
      "end": 4590.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:30.000",
      "text": "تدیگ تدیگ دار دار داری که"
    },
    {
      "id": 32,
      "start": 4590.0,
      "end": 4592.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:32.000",
      "text": "کمالا زردرنگ رو پا کرده"
    },
    {
      "id": 33,
      "start": 4592.0,
      "end": 4594.0,
      "formatted_start": "01:16:32.000",
      "formatted_end": "01:16:34.000",
      "text": "دیگه؟ آداتو محلول اوار اس دار"
    },
    {
      "id": 34,
      "start": 4594.0,
      "end": 4596.0,
      "formatted_start": "01:16:34.000",
      "formatted_end": "01:16:36.000",
      "text": "اوار اس سروم پراکیه دیگه"
    },
    {
      "id": 35,
      "start": 4596.0,
      "end": 4598.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:38.000",
      "text": "یه استامین افراد با یه سروم دار"
    },
    {
      "id": 36,
      "start": 4598.0,
      "end": 4600.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:40.000",
      "text": "خب پیچ"
    },
    {
      "id": 37,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "الان اصالش مثل آبی یا نیمه اصاله؟"
    },
    {
      "id": 38,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "اصالش خندق خوبه"
    },
    {
      "id": 39,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:46.000",
      "text": "برای چیزی دیگه"
    },
    {
      "id": 40,
      "start": 4606.0,
      "end": 4608.0,
      "formatted_start": "01:16:46.000",
      "formatted_end": "01:16:48.000",
      "text": "الان تو اصالش خونیه؟"
    },
    {
      "id": 41,
      "start": 4608.0,
      "end": 4610.0,
      "formatted_start": "01:16:48.000",
      "formatted_end": "01:16:50.000",
      "text": "مهم به اصابه کنیم"
    },
    {
      "id": 42,
      "start": 4610.0,
      "end": 4612.0,
      "formatted_start": "01:16:50.000",
      "formatted_end": "01:16:52.000",
      "text": "و مثل آبی یا شعل کسپنده"
    },
    {
      "id": 43,
      "start": 4612.0,
      "end": 4614.0,
      "formatted_start": "01:16:52.000",
      "formatted_end": "01:16:54.000",
      "text": "شعل کسپنده"
    },
    {
      "id": 44,
      "start": 4614.0,
      "end": 4616.0,
      "formatted_start": "01:16:54.000",
      "formatted_end": "01:16:56.000",
      "text": "و تب هم داشته؟"
    },
    {
      "id": 45,
      "start": 4616.0,
      "end": 4618.0,
      "formatted_start": "01:16:56.000",
      "formatted_end": "01:16:58.000",
      "text": "نه تب نداشته"
    },
    {
      "id": 46,
      "start": 4618.0,
      "end": 4620.0,
      "formatted_start": "01:16:58.000",
      "formatted_end": "01:17:00.000",
      "text": "تب نداشته، دلت بیقراری؟"
    },
    {
      "id": 47,
      "start": 4620.0,
      "end": 4622.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:02.000",
      "text": "آره"
    },
    {
      "id": 48,
      "start": 4622.0,
      "end": 4624.0,
      "formatted_start": "01:17:02.000",
      "formatted_end": "01:17:04.000",
      "text": "استفراف؟"
    },
    {
      "id": 49,
      "start": 4624.0,
      "end": 4626.0,
      "formatted_start": "01:17:04.000",
      "formatted_end": "01:17:06.000",
      "text": "نه داره"
    },
    {
      "id": 50,
      "start": 4626.0,
      "end": 4628.0,
      "formatted_start": "01:17:06.000",
      "formatted_end": "01:17:08.000",
      "text": "بیقراری سیاده یا کم؟"
    },
    {
      "id": 51,
      "start": 4628.0,
      "end": 4630.0,
      "formatted_start": "01:17:08.000",
      "formatted_end": "01:17:10.000",
      "text": "شبا خیلی بیقراری"
    },
    {
      "id": 52,
      "start": 4630.0,
      "end": 4632.0,
      "formatted_start": "01:17:10.000",
      "formatted_end": "01:17:12.000",
      "text": "تو شما اینقدر وایستیم؟"
    },
    {
      "id": 53,
      "start": 4632.0,
      "end": 4634.0,
      "formatted_start": "01:17:12.000",
      "formatted_end": "01:17:14.000",
      "text": "شما وایست نفرمی شدید"
    },
    {
      "id": 54,
      "start": 4634.0,
      "end": 4636.0,
      "formatted_start": "01:17:14.000",
      "formatted_end": "01:17:16.000",
      "text": "خب نه شما وایست نفرمی شدید"
    },
    {
      "id": 55,
      "start": 4636.0,
      "end": 4638.0,
      "formatted_start": "01:17:16.000",
      "formatted_end": "01:17:18.000",
      "text": "بله، تکن نباش. شما باید باید بسیارید."
    },
    {
      "id": 56,
      "start": 4638.0,
      "end": 4641.0,
      "formatted_start": "01:17:18.000",
      "formatted_end": "01:17:21.000",
      "text": "بله، خوب، خوب، خوب. شما پشت دیگر دارید."
    },
    {
      "id": 57,
      "start": 4641.0,
      "end": 4643.0,
      "formatted_start": "01:17:21.000",
      "formatted_end": "01:17:23.000",
      "text": "نمی کنید باید."
    },
    {
      "id": 58,
      "start": 4647.0,
      "end": 4649.0,
      "formatted_start": "01:17:27.000",
      "formatted_end": "01:17:29.000",
      "text": "سلام. اسم شویشه؟"
    },
    {
      "id": 59,
      "start": 4649.0,
      "end": 4651.0,
      "formatted_start": "01:17:29.000",
      "formatted_end": "01:17:31.000",
      "text": "حالا، ساموشه بسیاریم."
    },
    {
      "id": 60,
      "start": 4651.0,
      "end": 4653.0,
      "formatted_start": "01:17:31.000",
      "formatted_end": "01:17:33.000",
      "text": "حالا، ساموشه بسیاریم."
    },
    {
      "id": 61,
      "start": 4666.0,
      "end": 4668.0,
      "formatted_start": "01:17:46.000",
      "formatted_end": "01:17:48.000",
      "text": "دیگه شو"
    },
    {
      "id": 62,
      "start": 4668.0,
      "end": 4670.0,
      "formatted_start": "01:17:48.000",
      "formatted_end": "01:17:50.000",
      "text": "دستی میرون"
    },
    {
      "id": 63,
      "start": 4672.0,
      "end": 4674.0,
      "formatted_start": "01:17:52.000",
      "formatted_end": "01:17:54.000",
      "text": "خوب"
    },
    {
      "id": 64,
      "start": 4674.0,
      "end": 4676.0,
      "formatted_start": "01:17:54.000",
      "formatted_end": "01:17:56.000",
      "text": "خوب"
    },
    {
      "id": 65,
      "start": 4678.0,
      "end": 4680.0,
      "formatted_start": "01:17:58.000",
      "formatted_end": "01:18:00.000",
      "text": "خوب کانشه خسینی"
    },
    {
      "id": 66,
      "start": 4680.0,
      "end": 4684.0,
      "formatted_start": "01:18:00.000",
      "formatted_end": "01:18:04.000",
      "text": "اصلا بوجه خدمتشون که"
    },
    {
      "id": 67,
      "start": 4684.0,
      "end": 4687.0,
      "formatted_start": "01:18:04.000",
      "formatted_end": "01:18:07.000",
      "text": "دارو براشو می نوستم خب"
    },
    {
      "id": 68,
      "start": 4687.0,
      "end": 4689.0,
      "formatted_start": "01:18:07.000",
      "formatted_end": "01:18:09.000",
      "text": "این استالوخونی خیلی خوب"
    },
    {
      "id": 69,
      "start": 4689.0,
      "end": 4692.0,
      "formatted_start": "01:18:09.000",
      "formatted_end": "01:18:12.000",
      "text": "اون تو استال علامت خوبی نیست بیمه هستید"
    },
    {
      "id": 70,
      "start": 4692.0,
      "end": 4694.0,
      "formatted_start": "01:18:12.000",
      "formatted_end": "01:18:14.000",
      "text": "بیمه ترمیل"
    },
    {
      "id": 71,
      "start": 4694.0,
      "end": 4697.0,
      "formatted_start": "01:18:14.000",
      "formatted_end": "01:18:17.000",
      "text": "سروم خوراکی و آرستشو بهش بده"
    },
    {
      "id": 72,
      "start": 4697.0,
      "end": 4702.12,
      "formatted_start": "01:18:17.000",
      "formatted_end": "01:18:22.120",
      "text": "شماره سیه دونه دیگه داره دو تا داره رو"
    },
    {
      "id": 73,
      "start": 4702.12,
      "end": 4704.22,
      "formatted_start": "01:18:22.120",
      "formatted_end": "01:18:24.220",
      "text": "کامی یکی دیگه هم بگیرستم"
    },
    {
      "id": 74,
      "start": 4704.22,
      "end": 4708.88,
      "formatted_start": "01:18:24.220",
      "formatted_end": "01:18:28.880",
      "text": "بهش سنی شهره؟"
    },
    {
      "id": 75,
      "start": 4708.88,
      "end": 4709.98,
      "formatted_start": "01:18:28.880",
      "formatted_end": "01:18:29.980",
      "text": "دیده همین چیه"
    },
    {
      "id": 76,
      "start": 4709.98,
      "end": 4714.18,
      "formatted_start": "01:18:29.980",
      "formatted_end": "01:18:34.180",
      "text": "کتمستی، کش، روخ، آب، چایی، موز"
    },
    {
      "id": 77,
      "start": 4714.18,
      "end": 4716.74,
      "formatted_start": "01:18:34.180",
      "formatted_end": "01:18:36.740",
      "text": "پیشتر بده، نوشابه نده"
    },
    {
      "id": 78,
      "start": 4716.74,
      "end": 4719.06,
      "formatted_start": "01:18:36.740",
      "formatted_end": "01:18:39.060",
      "text": "آبیبای بازاری ندید"
    },
    {
      "id": 79,
      "start": 4719.06,
      "end": 4723.46,
      "formatted_start": "01:18:39.060",
      "formatted_end": "01:18:43.460",
      "text": "غذای شیرین، سکولیچه و چیزای شیرین و دوغنی هم ندید"
    },
    {
      "id": 80,
      "start": 4723.46,
      "end": 4727.46,
      "formatted_start": "01:18:43.460",
      "formatted_end": "01:18:47.460",
      "text": "باید که ماز، کش، دوخ، آب، موز بهش بیشتر دیدید"
    },
    {
      "id": 81,
      "start": 4727.46,
      "end": 4729.46,
      "formatted_start": "01:18:47.460",
      "formatted_end": "01:18:49.460",
      "text": "بخشید، اینو بیدید سفت کنن"
    },
    {
      "id": 82,
      "start": 4729.46,
      "end": 4731.46,
      "formatted_start": "01:18:49.460",
      "formatted_end": "01:18:51.460",
      "text": "این برگا بیدید"
    },
    {
      "id": 83,
      "start": 4731.46,
      "end": 4733.46,
      "formatted_start": "01:18:51.460",
      "formatted_end": "01:18:53.460",
      "text": "بیمه استید دیگه"
    },
    {
      "id": 84,
      "start": 4733.46,
      "end": 4735.46,
      "formatted_start": "01:18:53.460",
      "formatted_end": "01:18:55.460",
      "text": "بیدید بیدید"
    },
    {
      "id": 85,
      "start": 4735.46,
      "end": 4737.46,
      "formatted_start": "01:18:55.460",
      "formatted_end": "01:18:57.460",
      "text": "درمیزن از دارندی نمیدونید"
    },
    {
      "id": 86,
      "start": 4739.46,
      "end": 4741.46,
      "formatted_start": "01:18:59.460",
      "formatted_end": "01:19:01.460",
      "text": "درمیزن از دارندی نمیدونید"
    },
    {
      "id": 87,
      "start": 4741.46,
      "end": 4743.46,
      "formatted_start": "01:19:01.460",
      "formatted_end": "01:19:03.460",
      "text": "نه بیدید موشیم سفت کنن"
    },
    {
      "id": 88,
      "start": 4743.46,
      "end": 4745.46,
      "formatted_start": "01:19:03.460",
      "formatted_end": "01:19:05.460",
      "text": "درمیزن از دارندی نمیدونید"
    },
    {
      "id": 89,
      "start": 4753.46,
      "end": 4759.46,
      "formatted_start": "01:19:13.460",
      "formatted_end": "01:19:19.460",
      "text": "این چهار ست رو ببینم؟"
    },
    {
      "id": 90,
      "start": 4759.46,
      "end": 4763.46,
      "formatted_start": "01:19:19.460",
      "formatted_end": "01:19:23.460",
      "text": "این چهار ست و این پونسد و پنجه"
    },
    {
      "id": 91,
      "start": 4763.46,
      "end": 4767.46,
      "formatted_start": "01:19:23.460",
      "formatted_end": "01:19:27.460",
      "text": "این پونسد و پنجه، آره، چهار ست رو ببینم"
    },
    {
      "id": 92,
      "start": 4767.46,
      "end": 4769.46,
      "formatted_start": "01:19:27.460",
      "formatted_end": "01:19:29.460",
      "text": "آره، دوست"
    },
    {
      "id": 93,
      "start": 4783.46,
      "end": 4799.46,
      "formatted_start": "01:19:43.460",
      "formatted_end": "01:19:59.460",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}