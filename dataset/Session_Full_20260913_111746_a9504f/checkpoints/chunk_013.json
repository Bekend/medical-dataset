    {
      "id": 12,
      "start": 3944.0,
      "end": 3946.0,
      "formatted_start": "01:05:44.000",
      "formatted_end": "01:05:46.000",
      "text": "نه نارکیش اول روزی بیدیم"
    },
    {
      "id": 13,
      "start": 3946.0,
      "end": 3948.0,
      "formatted_start": "01:05:46.000",
      "formatted_end": "01:05:48.000",
      "text": "زردی"
    },
    {
      "id": 14,
      "start": 3948.0,
      "end": 3950.0,
      "formatted_start": "01:05:48.000",
      "formatted_end": "01:05:50.000",
      "text": "برای زردیش"
    },
    {
      "id": 15,
      "start": 3950.0,
      "end": 3954.0,
      "formatted_start": "01:05:50.000",
      "formatted_end": "01:05:54.000",
      "text": "بعد کوریب داره چون هم شیر مادر داره هم شیر بشه"
    },
    {
      "id": 16,
      "start": 3954.0,
      "end": 3956.0,
      "formatted_start": "01:05:54.000",
      "formatted_end": "01:05:56.000",
      "text": "کوریب داره کوریب کشید"
    },
    {
      "id": 17,
      "start": 3956.0,
      "end": 3960.0,
      "formatted_start": "01:05:56.000",
      "formatted_end": "01:06:00.000",
      "text": "که ادایی میداره؟ این توضیح باید بدین"
    },
    {
      "id": 18,
      "start": 3960.0,
      "end": 3962.0,
      "formatted_start": "01:06:00.000",
      "formatted_end": "01:06:02.000",
      "text": "خودش در اینجا خودش میپیچه"
    },
    {
      "id": 19,
      "start": 3962.0,
      "end": 3964.0,
      "formatted_start": "01:06:02.000",
      "formatted_end": "01:06:04.000",
      "text": "زور میزنه، میپیچه، ارتشار میده"
    },
    {
      "id": 20,
      "start": 3964.0,
      "end": 3968.0,
      "formatted_start": "01:06:04.000",
      "formatted_end": "01:06:08.000",
      "text": "بیقراری، مادر شمایی؟ بیقراری هم داره؟"
    },
    {
      "id": 21,
      "start": 3968.0,
      "end": 3972.0,
      "formatted_start": "01:06:08.000",
      "formatted_end": "01:06:12.000",
      "text": "بیقراری گریه، اون دوره نه چون بچه هم مریضه"
    },
    {
      "id": 22,
      "start": 3972.0,
      "end": 3974.0,
      "formatted_start": "01:06:12.000",
      "formatted_end": "01:06:14.000",
      "text": "تو سرش رو کیسته"
    },
    {
      "id": 23,
      "start": 3974.0,
      "end": 3978.0,
      "formatted_start": "01:06:14.000",
      "formatted_end": "01:06:18.000",
      "text": "شنگراتی کردی، کیست بوده"
    },
    {
      "id": 24,
      "start": 3978.0,
      "end": 3980.0,
      "formatted_start": "01:06:18.000",
      "formatted_end": "01:06:20.000",
      "text": "از درش هم حل باشم گره گذبه باشم"
    },
    {
      "id": 25,
      "start": 3980.0,
      "end": 3982.0,
      "formatted_start": "01:06:20.000",
      "formatted_end": "01:06:22.000",
      "text": "از در خوبه"
    },
    {
      "id": 26,
      "start": 3982.0,
      "end": 3984.0,
      "formatted_start": "01:06:22.000",
      "formatted_end": "01:06:24.000",
      "text": "کلیه هاشم برمیده"
    },
    {
      "id": 27,
      "start": 3984.0,
      "end": 3986.0,
      "formatted_start": "01:06:24.000",
      "formatted_end": "01:06:26.000",
      "text": "خب انشالله خوب بشین"
    },
    {
      "id": 28,
      "start": 3986.0,
      "end": 3988.0,
      "formatted_start": "01:06:26.000",
      "formatted_end": "01:06:28.000",
      "text": "ولی الان صورتی سرده این بچه"
    },
    {
      "id": 29,
      "start": 3988.0,
      "end": 3990.0,
      "formatted_start": "01:06:28.000",
      "formatted_end": "01:06:30.000",
      "text": "خب الان من میام ماینه میکنم"
    },
    {
      "id": 30,
      "start": 3990.0,
      "end": 3992.0,
      "formatted_start": "01:06:30.000",
      "formatted_end": "01:06:32.000",
      "text": "بعد یه در نقص داره"
    },
    {
      "id": 31,
      "start": 3992.0,
      "end": 3994.0,
      "formatted_start": "01:06:32.000",
      "formatted_end": "01:06:34.000",
      "text": "حالت قلنج بهش رسیده"
    },
    {
      "id": 32,
      "start": 3994.0,
      "end": 3996.0,
      "formatted_start": "01:06:34.000",
      "formatted_end": "01:06:36.000",
      "text": "دور میدنه"
    },
    {
      "id": 33,
      "start": 3996.0,
      "end": 3998.0,
      "formatted_start": "01:06:36.000",
      "formatted_end": "01:06:38.000",
      "text": "کشمیده اینا"
    },
    {
      "id": 34,
      "start": 3998.0,
      "end": 4000.0,
      "formatted_start": "01:06:38.000",
      "formatted_end": "01:06:40.000",
      "text": "معمولا غروب و شب پیشتره"
    },
    {
      "id": 35,
      "start": 4000.0,
      "end": 4002.0,
      "formatted_start": "01:06:40.000",
      "formatted_end": "01:06:42.000",
      "text": "ازیاد میشه اینا"
    },
    {
      "id": 36,
      "start": 4002.0,
      "end": 4004.0,
      "formatted_start": "01:06:42.000",
      "formatted_end": "01:06:44.000",
      "text": "شیر خوردنش خوبه؟"
    },
    {
      "id": 37,
      "start": 4004.0,
      "end": 4006.0,
      "formatted_start": "01:06:44.000",
      "formatted_end": "01:06:46.000",
      "text": "هم شیرم میخورم هم شیر خورش میکنم"
    },
    {
      "id": 38,
      "start": 4006.0,
      "end": 4008.0,
      "formatted_start": "01:06:46.000",
      "formatted_end": "01:06:48.000",
      "text": "اینجور کنید"
    },
    {
      "id": 39,
      "start": 4008.0,
      "end": 4009.0,
      "formatted_start": "01:06:48.000",
      "formatted_end": "01:06:49.000",
      "text": "اونزده"
    },
    {
      "id": 40,
      "start": 4009.0,
      "end": 4010.0,
      "formatted_start": "01:06:49.000",
      "formatted_end": "01:06:50.000",
      "text": "کروخونیتون چی هست؟"
    },
    {
      "id": 41,
      "start": 4010.0,
      "end": 4011.0,
      "formatted_start": "01:06:50.000",
      "formatted_end": "01:06:51.000",
      "text": "او هست"
    },
    {
      "id": 42,
      "start": 4011.0,
      "end": 4012.0,
      "formatted_start": "01:06:51.000",
      "formatted_end": "01:06:52.000",
      "text": "او؟"
    },
    {
      "id": 43,
      "start": 4012.0,
      "end": 4013.0,
      "formatted_start": "01:06:52.000",
      "formatted_end": "01:06:53.000",
      "text": "کروخونی بدیه"
    },
    {
      "id": 44,
      "start": 4013.0,
      "end": 4014.0,
      "formatted_start": "01:06:53.000",
      "formatted_end": "01:06:54.000",
      "text": "شوهرتون چیه؟"
    },
    {
      "id": 45,
      "start": 4014.0,
      "end": 4015.0,
      "formatted_start": "01:06:54.000",
      "formatted_end": "01:06:55.000",
      "text": "او هست"
    },
    {
      "id": 46,
      "start": 4015.0,
      "end": 4016.0,
      "formatted_start": "01:06:55.000",
      "formatted_end": "01:06:56.000",
      "text": "اوه؟"
    },
    {
      "id": 47,
      "start": 4016.0,
      "end": 4018.0,
      "formatted_start": "01:06:56.000",
      "formatted_end": "01:06:58.000",
      "text": "یکی حالا او باشین، خوب هستن"
    },
    {
      "id": 48,
      "start": 4018.0,
      "end": 4020.0,
      "formatted_start": "01:06:58.000",
      "formatted_end": "01:07:00.000",
      "text": "حالا چون او بازیم"
    },
    {
      "id": 49,
      "start": 4022.0,
      "end": 4024.0,
      "formatted_start": "01:07:02.000",
      "formatted_end": "01:07:04.000",
      "text": "بس یه میچه بودیم، برای کجای کوریاش"
    },
    {
      "id": 50,
      "start": 4024.0,
      "end": 4026.0,
      "formatted_start": "01:07:04.000",
      "formatted_end": "01:07:06.000",
      "text": "پیرمکتر زیر یک ماه نباید بیدیم"
    },
    {
      "id": 51,
      "start": 4026.0,
      "end": 4028.0,
      "formatted_start": "01:07:06.000",
      "formatted_end": "01:07:08.000",
      "text": "آره، چون کوریاش هم او کنند داره"
    },
    {
      "id": 52,
      "start": 4028.0,
      "end": 4031.0,
      "formatted_start": "01:07:08.000",
      "formatted_end": "01:07:11.000",
      "text": "باید باید میدین شعبتون است، پدر پدیه"
    },
    {
      "id": 53,
      "start": 4031.0,
      "end": 4033.0,
      "formatted_start": "01:07:11.000",
      "formatted_end": "01:07:13.000",
      "text": "بیدیجی بسمشو بگو"
    },
    {
      "id": 54,
      "start": 4033.0,
      "end": 4035.0,
      "formatted_start": "01:07:13.000",
      "formatted_end": "01:07:15.000",
      "text": "نه بیدیجیش"
    },
    {
      "id": 55,
      "start": 4035.0,
      "end": 4037.0,
      "formatted_start": "01:07:15.000",
      "formatted_end": "01:07:17.000",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 4037.0,
      "end": 4039.0,
      "formatted_start": "01:07:17.000",
      "formatted_end": "01:07:19.000",
      "text": "اونقدر زرگ نیست"
    },
    {
      "id": 57,
      "start": 4039.0,
      "end": 4041.0,
      "formatted_start": "01:07:19.000",
      "formatted_end": "01:07:21.000",
      "text": "همون بست"
    },
    {
      "id": 58,
      "start": 4041.0,
      "end": 4043.0,
      "formatted_start": "01:07:21.000",
      "formatted_end": "01:07:23.000",
      "text": "اینکه بودردی معنادار نداره"
    },
    {
      "id": 59,
      "start": 4043.0,
      "end": 4045.0,
      "formatted_start": "01:07:23.000",
      "formatted_end": "01:07:25.000",
      "text": "وگرن اما دستگاه داریم بیدیم ببنیم که"
    },
    {
      "id": 60,
      "start": 4045.0,
      "end": 4047.0,
      "formatted_start": "01:07:25.000",
      "formatted_end": "01:07:27.000",
      "text": "تو دستگاه داریم"
    },
    {
      "id": 61,
      "start": 4047.0,
      "end": 4049.0,
      "formatted_start": "01:07:27.000",
      "formatted_end": "01:07:29.000",
      "text": "نه روز"
    },
    {
      "id": 62,
      "start": 4049.0,
      "end": 4051.0,
      "formatted_start": "01:07:29.000",
      "formatted_end": "01:07:31.000",
      "text": "برای کمالستان بست"
    },
    {
      "id": 63,
      "start": 4051.0,
      "end": 4053.0,
      "formatted_start": "01:07:31.000",
      "formatted_end": "01:07:33.000",
      "text": "کمالستان باشه"
    },
    {
      "id": 64,
      "start": 4057.0,
      "end": 4059.0,
      "formatted_start": "01:07:37.000",
      "formatted_end": "01:07:39.000",
      "text": "شکمش نفت داره"
    },
    {
      "id": 65,
      "start": 4059.0,
      "end": 4063.0,
      "formatted_start": "01:07:39.000",
      "formatted_end": "01:07:43.000",
      "text": "ناطش خوبه، مثلا یکی دو قطعه فراموش میاد مهمی سده"
    },
    {
      "id": 66,
      "start": 4067.0,
      "end": 4069.0,
      "formatted_start": "01:07:47.000",
      "formatted_end": "01:07:49.000",
      "text": "یکم هم داره باید سفر"
    },
    {
      "id": 67,
      "start": 4069.0,
      "end": 4071.0,
      "formatted_start": "01:07:49.000",
      "formatted_end": "01:07:51.000",
      "text": "یکم اینجور کمال کاراندوله"
    },
    {
      "id": 68,
      "start": 4071.0,
      "end": 4073.0,
      "formatted_start": "01:07:51.000",
      "formatted_end": "01:07:53.000",
      "text": "آره برش داد"
    },
    {
      "id": 69,
      "start": 4089.0,
      "end": 4101.0,
      "formatted_start": "01:08:09.000",
      "formatted_end": "01:08:21.000",
      "text": "موسیقی"
    },
    {
      "id": 70,
      "start": 4101.0,
      "end": 4105.34,
      "formatted_start": "01:08:21.000",
      "formatted_end": "01:08:25.340",
      "text": "درست دارید زردیش که مهم نیست ولی نفتش مهمه"
    },
    {
      "id": 71,
      "start": 4105.34,
      "end": 4108.24,
      "formatted_start": "01:08:25.340",
      "formatted_end": "01:08:28.240",
      "text": "سارونیه نیستن شیر خودتون هم میدین"
    },
    {
      "id": 72,
      "start": 4108.24,
      "end": 4111.5,
      "formatted_start": "01:08:28.240",
      "formatted_end": "01:08:31.500",
      "text": "این شیر مادر میخوره خوبوباد نخوریم"
    },
    {
      "id": 73,
      "start": 4111.5,
      "end": 4116.3,
      "formatted_start": "01:08:31.500",
      "formatted_end": "01:08:36.300",
      "text": "حتی آبشو لبنیات گاوی مثل ماس پنیر کره کش"
    },
    {
      "id": 74,
      "start": 4116.3,
      "end": 4120.5,
      "formatted_start": "01:08:36.300",
      "formatted_end": "01:08:40.500",
      "text": "ایچ وچشون سنگینی افته مرسان کربیش همیشتیزه"
    },
    {
      "id": 75,
      "start": 4120.5,
      "end": 4123.5,
      "formatted_start": "01:08:40.500",
      "formatted_end": "01:08:43.500",
      "text": "یکی هم بادیم جلو باد داره"
    },
    {
      "id": 76,
      "start": 4123.5,
      "end": 4126.0,
      "formatted_start": "01:08:43.500",
      "formatted_end": "01:08:46.000",
      "text": "این داروها شو خانم بازی بیرونیم"
    },
    {
      "id": 77,
      "start": 4126.0,
      "end": 4128.3,
      "formatted_start": "01:08:46.000",
      "formatted_end": "01:08:48.300",
      "text": "قطر برا نفتشون خارجی برسید"
    },
    {
      "id": 78,
      "start": 4128.3,
      "end": 4129.3,
      "formatted_start": "01:08:48.300",
      "formatted_end": "01:08:49.300",
      "text": "چه قطره؟"
    },
    {
      "id": 79,
      "start": 4129.3,
      "end": 4130.5,
      "formatted_start": "01:08:49.300",
      "formatted_end": "01:08:50.500",
      "text": "پیدی داشت"
    },
    {
      "id": 80,
      "start": 4130.5,
      "end": 4131.5,
      "formatted_start": "01:08:50.500",
      "formatted_end": "01:08:51.500",
      "text": "پدیغه است؟"
    },
    {
      "id": 81,
      "start": 4131.5,
      "end": 4132.5,
      "formatted_start": "01:08:51.500",
      "formatted_end": "01:08:52.500",
      "text": "نیمانست"
    },
    {
      "id": 82,
      "start": 4132.5,
      "end": 4133.5,
      "formatted_start": "01:08:52.500",
      "formatted_end": "01:08:53.500",
      "text": "صورتی بود؟"
    },
    {
      "id": 83,
      "start": 4133.5,
      "end": 4134.5,
      "formatted_start": "01:08:53.500",
      "formatted_end": "01:08:54.500",
      "text": "چون پدیغه نیست"
    },
    {
      "id": 84,
      "start": 4134.5,
      "end": 4136.5,
      "formatted_start": "01:08:54.500",
      "formatted_end": "01:08:56.500",
      "text": "من برای تو میشم اینه که همینه"
    },
    {
      "id": 85,
      "start": 4136.5,
      "end": 4138.5,
      "formatted_start": "01:08:56.500",
      "formatted_end": "01:08:58.500",
      "text": "تو واسه دختر من نوشته بودی"
    },
    {
      "id": 86,
      "start": 4138.5,
      "end": 4139.5,
      "formatted_start": "01:08:58.500",
      "formatted_end": "01:08:59.500",
      "text": "باش"
    },
    {
      "id": 87,
      "start": 4139.5,
      "end": 4141.5,
      "formatted_start": "01:08:59.500",
      "formatted_end": "01:09:01.500",
      "text": "همین داروخانه خواهی این چیز کنه؟"
    },
    {
      "id": 88,
      "start": 4141.5,
      "end": 4142.5,
      "formatted_start": "01:09:01.500",
      "formatted_end": "01:09:02.500",
      "text": "واسه مشکلی نداره باشه"
    },
    {
      "id": 89,
      "start": 4142.5,
      "end": 4144.5,
      "formatted_start": "01:09:02.500",
      "formatted_end": "01:09:04.500",
      "text": "نه چون مشکلی نداره"
    },
    {
      "id": 90,
      "start": 4144.5,
      "end": 4147.5,
      "formatted_start": "01:09:04.500",
      "formatted_end": "01:09:07.500",
      "text": "داروهایی خطرناکی نیستن"
    },
    {
      "id": 91,
      "start": 4153.5,
      "end": 4155.5,
      "formatted_start": "01:09:13.500",
      "formatted_end": "01:09:15.500",
      "text": "این شدمت شما براتر"
    },
    {
      "id": 92,
      "start": 4155.5,
      "end": 4157.5,
      "formatted_start": "01:09:15.500",
      "formatted_end": "01:09:17.500",
      "text": "این بار ۷۷ سونی دردیش رو ادامه بده؟"
    },
    {
      "id": 93,
      "start": 4157.5,
      "end": 4161.5,
      "formatted_start": "01:09:17.500",
      "formatted_end": "01:09:21.500",
      "text": "مهم نیست اون آر روز پنج قطعه اون تا پنج روز باز دیدن هم چیز نیست"
    },
    {
      "id": 94,
      "start": 4161.5,
      "end": 4165.5,
