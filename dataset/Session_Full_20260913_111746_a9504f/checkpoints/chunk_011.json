    },
    {
      "id": 18,
      "start": 3462.0,
      "end": 3464.0,
      "formatted_start": "00:57:42.000",
      "formatted_end": "00:57:44.000",
      "text": "باید برداریم"
    },
    {
      "id": 19,
      "start": 3464.0,
      "end": 3468.96,
      "formatted_start": "00:57:44.000",
      "formatted_end": "00:57:48.960",
      "text": "برم همین یک در 15 رسپیچ که چند بار بالا می آورد این بیار می شد"
    },
    {
      "id": 20,
      "start": 3468.96,
      "end": 3470.96,
      "formatted_start": "00:57:48.960",
      "formatted_end": "00:57:50.960",
      "text": "بعد می کنم اونجورم اونجورم"
    },
    {
      "id": 21,
      "start": 3470.96,
      "end": 3472.96,
      "formatted_start": "00:57:50.960",
      "formatted_end": "00:57:52.960",
      "text": "بسیار درد می کنم"
    },
    {
      "id": 22,
      "start": 3472.96,
      "end": 3474.96,
      "formatted_start": "00:57:52.960",
      "formatted_end": "00:57:54.960",
      "text": "دردش هم طولت سپید می شد اینکه"
    },
    {
      "id": 23,
      "start": 3474.96,
      "end": 3475.96,
      "formatted_start": "00:57:54.960",
      "formatted_end": "00:57:55.960",
      "text": "بله؟"
    },
    {
      "id": 24,
      "start": 3475.96,
      "end": 3478.76,
      "formatted_start": "00:57:55.960",
      "formatted_end": "00:57:58.760",
      "text": "ببارکتر شد الان باز مریض نیستش"
    },
    {
      "id": 25,
      "start": 3478.76,
      "end": 3479.76,
      "formatted_start": "00:57:58.760",
      "formatted_end": "00:57:59.760",
      "text": "بالا می می آره بردیم"
    },
    {
      "id": 26,
      "start": 3479.76,
      "end": 3482.24,
      "formatted_start": "00:57:59.760",
      "formatted_end": "00:58:02.240",
      "text": "هر چند روز با تنها می گویم اونو گه اینجا درد"
    },
    {
      "id": 27,
      "start": 3482.24,
      "end": 3483.24,
      "formatted_start": "00:58:02.240",
      "formatted_end": "00:58:03.240",
      "text": "کجا؟"
    },
    {
      "id": 28,
      "start": 3483.24,
      "end": 3486.24,
      "formatted_start": "00:58:03.240",
      "formatted_end": "00:58:06.240",
      "text": "نه چند روز می گه قفصی سینم درد"
    },
    {
      "id": 29,
      "start": 3486.24,
      "end": 3487.24,
      "formatted_start": "00:58:06.240",
      "formatted_end": "00:58:07.240",
      "text": "اینجا گویم اینجا درد"
    },
    {
      "id": 30,
      "start": 3487.24,
      "end": 3489.24,
      "formatted_start": "00:58:07.240",
      "formatted_end": "00:58:09.240",
      "text": "چه موقع هایی میگه صبح یا غروب؟"
    },
    {
      "id": 31,
      "start": 3489.24,
      "end": 3491.24,
      "formatted_start": "00:58:09.240",
      "formatted_end": "00:58:11.240",
      "text": "غروب، بعد از باهم صبح میگه"
    },
    {
      "id": 32,
      "start": 3491.24,
      "end": 3494.24,
      "formatted_start": "00:58:11.240",
      "formatted_end": "00:58:14.240",
      "text": "من سردرد هم میشه، بعد اینجا سرد میگه"
    },
    {
      "id": 33,
      "start": 3494.24,
      "end": 3495.24,
      "formatted_start": "00:58:14.240",
      "formatted_end": "00:58:15.240",
      "text": "کجایی سرش؟"
    },
    {
      "id": 34,
      "start": 3495.24,
      "end": 3497.24,
      "formatted_start": "00:58:15.240",
      "formatted_end": "00:58:17.240",
      "text": "اینجا میگه درد میکنه، اینجا"
    },
    {
      "id": 35,
      "start": 3497.24,
      "end": 3499.24,
      "formatted_start": "00:58:17.240",
      "formatted_end": "00:58:19.240",
      "text": "خب خب، اینجا هم اینجا"
    },
    {
      "id": 36,
      "start": 3500.24,
      "end": 3501.24,
      "formatted_start": "00:58:20.240",
      "formatted_end": "00:58:21.240",
      "text": "نه اینجا نیست"
    },
    {
      "id": 37,
      "start": 3501.24,
      "end": 3503.24,
      "formatted_start": "00:58:21.240",
      "formatted_end": "00:58:23.240",
      "text": "اما خوب ها اینجا"
    },
    {
      "id": 38,
      "start": 3503.24,
      "end": 3506.24,
      "formatted_start": "00:58:23.240",
      "formatted_end": "00:58:26.240",
      "text": "کسی من تو خونه سردرد داشته باشه؟"
    },
    {
      "id": 39,
      "start": 3506.24,
      "end": 3507.24,
      "formatted_start": "00:58:26.240",
      "formatted_end": "00:58:27.240",
      "text": "نه خودم"
    },
    {
      "id": 40,
      "start": 3507.24,
      "end": 3509.24,
      "formatted_start": "00:58:27.240",
      "formatted_end": "00:58:29.240",
      "text": "خودت میگه سرم درد میکنه؟"
    },
    {
      "id": 41,
      "start": 3509.24,
      "end": 3510.24,
      "formatted_start": "00:58:29.240",
      "formatted_end": "00:58:30.240",
      "text": "آمین"
    },
    {
      "id": 42,
      "start": 3510.24,
      "end": 3511.24,
      "formatted_start": "00:58:30.240",
      "formatted_end": "00:58:31.240",
      "text": "تو خونه میگی؟"
    },
    {
      "id": 43,
      "start": 3511.24,
      "end": 3514.0,
      "formatted_start": "00:58:31.240",
      "formatted_end": "00:58:34.000",
      "text": "صبح دیگه سردرد بودی که خودس درشو بستی"
    },
    {
      "id": 44,
      "start": 3517.24,
      "end": 3518.24,
      "formatted_start": "00:58:37.240",
      "formatted_end": "00:58:38.240",
      "text": "نفر چطوری؟"
    },
    {
      "id": 45,
      "start": 3519.44,
      "end": 3521.44,
      "formatted_start": "00:58:39.440",
      "formatted_end": "00:58:41.440",
      "text": "کجای سینه ترک میکنه از شویه؟"
    },
    {
      "id": 46,
      "start": 3522.12,
      "end": 3524.12,
      "formatted_start": "00:58:42.120",
      "formatted_end": "00:58:44.120",
      "text": "این سرش کجاش ترک میکنه؟"
    },
    {
      "id": 47,
      "start": 3526.28,
      "end": 3528.28,
      "formatted_start": "00:58:46.280",
      "formatted_end": "00:58:48.280",
      "text": "صبح درک میکنه یا خروبه؟"
    },
    {
      "id": 48,
      "start": 3528.6,
      "end": 3529.6,
      "formatted_start": "00:58:48.600",
      "formatted_end": "00:58:49.600",
      "text": "صبح درک میکنه"
    },
    {
      "id": 49,
      "start": 3529.6,
      "end": 3531.6,
      "formatted_start": "00:58:49.600",
      "formatted_end": "00:58:51.600",
      "text": "الان صبح که سرش درد میکنه"
    },
    {
      "id": 50,
      "start": 3531.6,
      "end": 3533.6,
      "formatted_start": "00:58:51.600",
      "formatted_end": "00:58:53.600",
      "text": "دیگه اون بار جایی بستی"
    },
    {
      "id": 51,
      "start": 3537.64,
      "end": 3540.04,
      "formatted_start": "00:58:57.640",
      "formatted_end": "00:59:00.040",
      "text": "الان اون سر آخرین بار که اون بار را بکنه"
    },
    {
      "id": 52,
      "start": 3540.04,
      "end": 3542.04,
      "formatted_start": "00:59:00.040",
      "formatted_end": "00:59:02.040",
      "text": "نیتشاد نیست"
    },
    {
      "id": 53,
      "start": 3545.04,
      "end": 3548.04,
      "formatted_start": "00:59:05.040",
      "formatted_end": "00:59:08.040",
      "text": "با سردار خوبه با بیچارش"
    },
    {
      "id": 54,
      "start": 3549.04,
      "end": 3551.04,
      "formatted_start": "00:59:09.040",
      "formatted_end": "00:59:11.040",
      "text": "یه بیچار در بار نگه در میده"
    },
    {
      "id": 55,
      "start": 3552.04,
      "end": 3556.04,
      "formatted_start": "00:59:12.040",
      "formatted_end": "00:59:16.040",
      "text": "آیا با رو بیچار بیدیم برای درد قفصی سیندباز یک عکس بینیم"
    },
    {
      "id": 56,
      "start": 3557.04,
      "end": 3561.04,
      "formatted_start": "00:59:17.040",
      "formatted_end": "00:59:21.040",
      "text": "سردردش تو حالت داره یا حالتش نیتشاد تغلیط میکنه"
    },
    {
      "id": 57,
      "start": 3562.04,
      "end": 3564.04,
      "formatted_start": "00:59:22.040",
      "formatted_end": "00:59:24.040",
      "text": "یا حالت اینکه واقعا سردرده"
    },
    {
      "id": 58,
      "start": 3565.04,
      "end": 3567.04,
      "formatted_start": "00:59:25.040",
      "formatted_end": "00:59:27.040",
      "text": "اگه اونجایی باشه باید سی تیز کنیم"
    },
    {
      "id": 59,
      "start": 3567.04,
      "end": 3571.04,
      "formatted_start": "00:59:27.040",
      "formatted_end": "00:59:31.040",
      "text": "سابقه میگرین اینا که خانواده داریم؟"
    },
    {
      "id": 60,
      "start": 3571.04,
      "end": 3574.04,
      "formatted_start": "00:59:31.040",
      "formatted_end": "00:59:34.040",
      "text": "نه میگرین نداریم؟ نه"
    },
    {
      "id": 61,
      "start": 3574.04,
      "end": 3577.04,
      "formatted_start": "00:59:34.040",
      "formatted_end": "00:59:37.040",
      "text": "از طبیعی چطوره بچه؟"
    },
    {
      "id": 62,
      "start": 3577.04,
      "end": 3579.04,
      "formatted_start": "00:59:37.040",
      "formatted_end": "00:59:39.040",
      "text": "تو داره، پرخواشگره، آرومه؟"
    },
    {
      "id": 63,
      "start": 3579.04,
      "end": 3582.04,
      "formatted_start": "00:59:39.040",
      "formatted_end": "00:59:42.040",
      "text": "بریشهره، بازوگوش خیلی"
    },
    {
      "id": 64,
      "start": 3582.04,
      "end": 3584.04,
      "formatted_start": "00:59:42.040",
      "formatted_end": "00:59:44.040",
      "text": "سردردش ببینی؟ صبح پیشتره؟"
    },
    {
      "id": 65,
      "start": 3584.04,
      "end": 3586.04,
      "formatted_start": "00:59:44.040",
      "formatted_end": "00:59:46.040",
      "text": "نه این پاش هم درد بکنه"
    },
    {
      "id": 66,
      "start": 3586.04,
      "end": 3587.04,
      "formatted_start": "00:59:46.040",
      "formatted_end": "00:59:47.040",
      "text": "نه سردرد ببینی؟"
    },
    {
      "id": 67,
      "start": 3587.04,
      "end": 3589.04,
      "formatted_start": "00:59:47.040",
      "formatted_end": "00:59:49.040",
      "text": "پیشتر صبح"
    },
    {
      "id": 68,
      "start": 3589.04,
      "end": 3593.04,
      "formatted_start": "00:59:49.040",
      "formatted_end": "00:59:53.040",
      "text": "حالا تهوه هم بیشتر سمیزه با سردرد؟"
    },
    {
      "id": 69,
      "start": 3593.04,
      "end": 3595.04,
      "formatted_start": "00:59:53.040",
      "formatted_end": "00:59:55.040",
      "text": "پیشتر با موهرم خودم"
    },
    {
      "id": 70,
      "start": 3595.04,
      "end": 3597.04,
      "formatted_start": "00:59:55.040",
      "formatted_end": "00:59:57.040",
      "text": "نه موه صدت نمیدونی؟"
    },
    {
      "id": 71,
      "start": 3597.04,
      "end": 3599.04,
      "formatted_start": "00:59:57.040",
      "formatted_end": "00:59:59.040",
      "text": "نه موه صدت نمیدونی"
    },
    {
      "id": 72,
      "start": 3599.04,
      "end": 3601.04,
      "formatted_start": "00:59:59.040",
      "formatted_end": "01:00:01.040",
      "text": "موه صدت نمیدونی؟"
    }
  ],
