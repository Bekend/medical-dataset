  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3029.98,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 3030.0,
      "end": 3032.0,
      "formatted_start": "00:50:30.000",
      "formatted_end": "00:50:32.000",
      "text": "خدا خوش"
    },
    {
      "id": 2,
      "start": 3039.0,
      "end": 3043.0,
      "formatted_start": "00:50:39.000",
      "formatted_end": "00:50:43.000",
      "text": "خانسنگی به دوروخانه هم میگه اینکه دوز زدیم که وقتشون باشه"
    },
    {
      "id": 3,
      "start": 3043.0,
      "end": 3044.0,
      "formatted_start": "00:50:43.000",
      "formatted_end": "00:50:44.000",
      "text": "سلام"
    },
    {
      "id": 4,
      "start": 3044.0,
      "end": 3046.0,
      "formatted_start": "00:50:44.000",
      "formatted_end": "00:50:46.000",
      "text": "سلامت بشی خدا"
    },
    {
      "id": 5,
      "start": 3046.0,
      "end": 3047.0,
      "formatted_start": "00:50:46.000",
      "formatted_end": "00:50:47.000",
      "text": "گلدا با بازی"
    },
    {
      "id": 6,
      "start": 3047.0,
      "end": 3048.0,
      "formatted_start": "00:50:47.000",
      "formatted_end": "00:50:48.000",
      "text": "این روز اومدیم اینجا"
    },
    {
      "id": 7,
      "start": 3048.0,
      "end": 3049.0,
      "formatted_start": "00:50:48.000",
      "formatted_end": "00:50:49.000",
      "text": "چی بوده؟"
    },
    {
      "id": 8,
      "start": 3049.0,
      "end": 3050.0,
      "formatted_start": "00:50:49.000",
      "formatted_end": "00:50:50.000",
      "text": "زردی"
    },
    {
      "id": 9,
      "start": 3050.0,
      "end": 3051.0,
      "formatted_start": "00:50:50.000",
      "formatted_end": "00:50:51.000",
      "text": "آه زردی داشته"
    },
    {
      "id": 10,
      "start": 3060.0,
      "end": 3072.0,
      "formatted_start": "00:51:00.000",
      "formatted_end": "00:51:12.000",
      "text": "این از درد هست، باید تو رو میبینیم. خب؟ اینجا چند روزشه؟"
    },
    {
      "id": 11,
      "start": 3072.0,
      "end": 3078.0,
      "formatted_start": "00:51:12.000",
      "formatted_end": "00:51:18.000",
      "text": "نسبتی دیروز مثلا یه درد 20 ترصدی زیاد شده."
    },
    {
      "id": 12,
      "start": 3078.0,
      "end": 3086.0,
      "formatted_start": "00:51:18.000",
      "formatted_end": "00:51:26.000",
      "text": "آره، مثلا دیروز شکمش نبود، اینجا شکمش هم زرد شده یه مدار، انگوشتر هم خودتون با شده."
    },
    {
      "id": 13,
      "start": 3086.0,
      "end": 3091.0,
      "formatted_start": "00:51:26.000",
      "formatted_end": "00:51:31.000",
      "text": "یا اینکه پیشتر شده این هم معمولا از دو سه هم، چه هم به بعد شروع میشه"
    },
    {
      "id": 14,
      "start": 3091.0,
      "end": 3097.0,
      "formatted_start": "00:51:31.000",
      "formatted_end": "00:51:37.000",
      "text": "دو کار میتونی کنید یا اینکه از الان دستگاه بگوید بذارید برای که پیشتر به پیشتر نشیده"
    },
    {
      "id": 15,
      "start": 3097.0,
      "end": 3102.0,
      "formatted_start": "00:51:37.000",
      "formatted_end": "00:51:42.000",
      "text": "یا اینکه باید سر کنید حتی ما سه روز تطیب میگیم یا چهارشان، پنشان، فرومه تطیب میگیم"
    },
    {
      "id": 16,
      "start": 3102.0,
      "end": 3105.0,
      "formatted_start": "00:51:42.000",
      "formatted_end": "00:51:45.000",
      "text": "و این میره به شمبه"
    },
    {
      "id": 17,
      "start": 3105.0,
      "end": 3107.0,
      "formatted_start": "00:51:45.000",
      "formatted_end": "00:51:47.000",
      "text": "متدیم میشیم بگم"
    },
    {
      "id": 18,
      "start": 3107.0,
      "end": 3111.0,
      "formatted_start": "00:51:47.000",
      "formatted_end": "00:51:51.000",
      "text": "ولی الان مثل اینکه دیروز به 20% زیاد شده"
    },
    {
      "id": 19,
      "start": 3111.0,
      "end": 3115.0,
      "formatted_start": "00:51:51.000",
      "formatted_end": "00:51:55.000",
      "text": "اگر بخواهید همگیزی زیاد باشه جالب نیست"
    },
    {
      "id": 20,
      "start": 3115.0,
      "end": 3119.0,
      "formatted_start": "00:51:55.000",
      "formatted_end": "00:51:59.000",
      "text": "اگر دستگاه بگیریم مکنه هست"
    },
    {
      "id": 21,
      "start": 3119.0,
      "end": 3123.0,
      "formatted_start": "00:51:59.000",
      "formatted_end": "00:52:03.000",
      "text": "سه روز بعد معلومه چقدر گرمی کنیم"
    },
    {
      "id": 22,
      "start": 3123.0,
      "end": 3125.0,
      "formatted_start": "00:52:03.000",
      "formatted_end": "00:52:05.000",
      "text": "اینجا به منشین بگیم؟"
    },
    {
      "id": 23,
      "start": 3125.0,
      "end": 3127.0,
      "formatted_start": "00:52:05.000",
      "formatted_end": "00:52:07.000",
      "text": "آره تا شمبه دستگاه بگیریم"
    },
    {
      "id": 24,
      "start": 3127.0,
      "end": 3130.0,
      "formatted_start": "00:52:07.000",
      "formatted_end": "00:52:10.000",
      "text": "اون جوش هایی ایزه اینا اشکال نداره"
    },
    {
      "id": 25,
      "start": 3130.0,
      "end": 3132.0,
      "formatted_start": "00:52:10.000",
      "formatted_end": "00:52:12.000",
      "text": "هرمونی همونه"
    },
    {
      "id": 26,
      "start": 3132.0,
      "end": 3134.0,
      "formatted_start": "00:52:12.000",
      "formatted_end": "00:52:14.000",
      "text": "مهمیست"
    },
    {
      "id": 27,
      "start": 3134.0,
      "end": 3136.0,
      "formatted_start": "00:52:14.000",
      "formatted_end": "00:52:16.000",
      "text": "جوش هایی ریزه"
    },
    {
      "id": 28,
      "start": 3136.0,
      "end": 3138.0,
      "formatted_start": "00:52:16.000",
      "formatted_end": "00:52:18.000",
      "text": "این باسی بوشی نمیدونی؟"
    },
    {
      "id": 29,
      "start": 3138.0,
      "end": 3140.0,
      "formatted_start": "00:52:18.000",
      "formatted_end": "00:52:20.000",
      "text": "مشکل هم نمیدونی"
    },
    {
      "id": 30,
      "start": 3140.0,
      "end": 3142.0,
      "formatted_start": "00:52:20.000",
      "formatted_end": "00:52:22.000",
      "text": "جام بوشی شما باشی؟"
    },
    {
      "id": 31,
      "start": 3142.0,
      "end": 3144.0,
      "formatted_start": "00:52:22.000",
      "formatted_end": "00:52:24.000",
      "text": "دیگه مشکل نمیدونی"
    },
    {
      "id": 32,
      "start": 3144.0,
      "end": 3146.0,
      "formatted_start": "00:52:24.000",
      "formatted_end": "00:52:26.000",
      "text": "بر یه چیزاش خوبه نه"
    },
    {
      "id": 33,
      "start": 3146.0,
      "end": 3148.0,
      "formatted_start": "00:52:26.000",
      "formatted_end": "00:52:28.000",
      "text": "از وقت بر موشی"
    },
    {
      "id": 34,
      "start": 3148.0,
      "end": 3150.0,
      "formatted_start": "00:52:28.000",
      "formatted_end": "00:52:30.000",
      "text": "دستگاه رو هم به موشی بگیر"
    },
    {
      "id": 35,
      "start": 3150.0,
      "end": 3152.0,
      "formatted_start": "00:52:30.000",
      "formatted_end": "00:52:32.000",
      "text": "خب در وقتی شما مطمئن تر بگیر"
    },
    {
      "id": 36,
      "start": 3152.0,
      "end": 3154.0,
      "formatted_start": "00:52:32.000",
      "formatted_end": "00:52:34.000",
      "text": "خب از این کان هم زنده باشی"
    },
    {
      "id": 37,
      "start": 3166.0,
      "end": 3195.0,
      "formatted_start": "00:52:46.000",
