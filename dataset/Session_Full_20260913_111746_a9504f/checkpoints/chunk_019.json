  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5702.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:02.000",
      "text": "هر چی ممکنه، براتونی ورا چی نمیشه؟"
    },
    {
      "id": 1,
      "start": 5702.0,
      "end": 5704.0,
      "formatted_start": "01:35:02.000",
      "formatted_end": "01:35:04.000",
      "text": "همه حساسیتش بیمار."
    },
    {
      "id": 2,
      "start": 5704.0,
      "end": 5706.0,
      "formatted_start": "01:35:04.000",
      "formatted_end": "01:35:06.000",
      "text": "باشید، ممنونم. باز لازم دوباره بیارم."
    },
    {
      "id": 3,
      "start": 5706.0,
      "end": 5708.0,
      "formatted_start": "01:35:06.000",
      "formatted_end": "01:35:08.000",
      "text": "این ضرورتی نداره نه."
    },
    {
      "id": 4,
      "start": 5708.0,
      "end": 5710.0,
      "formatted_start": "01:35:08.000",
      "formatted_end": "01:35:10.000",
      "text": "ممنونم، براتونی."
    },
    {
      "id": 5,
      "start": 5710.0,
      "end": 5712.0,
      "formatted_start": "01:35:10.000",
      "formatted_end": "01:35:12.000",
      "text": "درم بیتن هم دارن؟ سلام."
    },
    {
      "id": 6,
      "start": 5730.0,
      "end": 5759.0,
      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:59.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 5759.0,
      "end": 5762.24,
      "formatted_start": "01:35:59.000",
      "formatted_end": "01:36:02.240",
      "text": "سلام. در این بررسی تعمیلی خیلی بشمندید."
    },
    {
      "id": 8,
      "start": 5762.24,
      "end": 5766.38,
      "formatted_start": "01:36:02.240",
      "formatted_end": "01:36:06.380",
      "text": "کمتر کسی اینو میدونه. اما یه راضی هست که همه شکلتای اینترنت ازت پیان کنند."
    },
    {
      "id": 9,
      "start": 5766.38,
      "end": 5768.38,
      "formatted_start": "01:36:06.380",
      "formatted_end": "01:36:08.380",
      "text": "دلیلش هم واضح است. میخوان از اینترنته کن."
    },
    {
      "id": 10,
      "start": 5768.38,
      "end": 5772.98,
      "formatted_start": "01:36:08.380",
      "formatted_end": "01:36:12.980",
      "text": "دو داقه باشون که کسی میتونه تمای زمین این بره به خواهی کنه."
    },
    {
      "id": 11,
      "start": 5772.98,
      "end": 5783.28,
      "formatted_start": "01:36:12.980",
      "formatted_end": "01:36:23.280",
      "text": "دلیل اینکه نمیکنند بخواهد فهم از تعمیل این بره شما موجوده و داقه این رو بشونه بره بکنند."
    },
    {
      "id": 12,
      "start": 5783.28,
      "end": 5811.28,
      "formatted_start": "01:36:23.280",
      "formatted_end": "01:36:51.280",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 5813.28,
      "end": 5841.28,
      "formatted_start": "01:36:53.280",
      "formatted_end": "01:37:21.280",
