      "formatted_end": "02:15:02.000",
      "text": "از اینجا کمی کنید؟"
    },
    {
      "id": 1,
      "start": 8102.0,
      "end": 8107.0,
      "formatted_start": "02:15:02.000",
      "formatted_end": "02:15:07.000",
      "text": "از طوب نردم دارید؟"
    },
    {
      "id": 2,
      "start": 8107.0,
      "end": 8110.0,
      "formatted_start": "02:15:07.000",
      "formatted_end": "02:15:10.000",
      "text": "کم سر؟ چار سر؟"
    },
    {
      "id": 3,
      "start": 8110.0,
      "end": 8113.0,
      "formatted_start": "02:15:10.000",
      "formatted_end": "02:15:13.000",
      "text": "نه، اما جمعیتون چار سر"
    },
    {
      "id": 4,
      "start": 8113.0,
      "end": 8115.0,
      "formatted_start": "02:15:13.000",
      "formatted_end": "02:15:15.000",
      "text": "چار سر، نباشید بسیار"
    },
