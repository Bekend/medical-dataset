  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9622.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:22.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 9630.0,
      "end": 9634.8,
      "formatted_start": "02:40:30.000",
      "formatted_end": "02:40:34.800",
      "text": "برای بگرد تو به داده برسید"
    },
    {
      "id": 2,
      "start": 9634.8,
      "end": 9637.98,
      "formatted_start": "02:40:34.800",
      "formatted_end": "02:40:37.980",
      "text": "که به غیر تو باشنم کسی"
    },
    {
      "id": 3,
      "start": 9637.98,
      "end": 9641.0,
      "formatted_start": "02:40:37.980",
      "formatted_end": "02:40:41.000",
      "text": "یک رهت بلا دیدم نسید"
    },
    {
      "id": 4,
      "start": 9641.86,
      "end": 9654.82,
      "formatted_start": "02:40:41.860",
      "formatted_end": "02:40:54.820",
      "text": "یه جهان برای میخواهم من"
    },
    {
      "id": 5,
      "start": 9654.82,
      "end": 9659.82,
      "formatted_start": "02:40:54.820",
      "formatted_end": "02:40:59.820",
      "text": "زیبای هم بفا میخواهم من"
    },
    {
      "id": 6,
      "start": 9659.82,
      "end": 9665.68,
      "formatted_start": "02:40:59.820",
      "formatted_end": "02:41:05.680",
      "text": "آوه بیت بیت کسر برمیدید"
    },
    {
      "id": 7,
      "start": 9665.68,
      "end": 9669.94,
      "formatted_start": "02:41:05.680",
      "formatted_end": "02:41:09.940",
      "text": "سفر بر کار سرده زمان"
    },
    {
      "id": 8,
      "start": 9669.94,
      "end": 9672.5,
      "formatted_start": "02:41:09.940",
      "formatted_end": "02:41:12.500",
      "text": "نامید سامان"
    },
    {
      "id": 9,
      "start": 9672.5,
      "end": 9675.9,
      "formatted_start": "02:41:12.500",
      "formatted_end": "02:41:15.900",
      "text": "نامید کمال شمال"
    },
    {
      "id": 10,
      "start": 9675.9,
      "end": 9678.06,
      "formatted_start": "02:41:15.900",
      "formatted_end": "02:41:18.060",
      "text": "بیدی زمان"
    },
    {
      "id": 11,
      "start": 9689.82,
      "end": 9693.82,
      "formatted_start": "02:41:29.820",
      "formatted_end": "02:41:33.820",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 9719.82,
      "end": 9725.06,
      "formatted_start": "02:41:59.820",
      "formatted_end": "02:42:05.060",
      "text": "اید شلوه آنکه عاشقیان من و تو"
    },
    {
      "id": 13,
      "start": 9725.06,
      "end": 9736.32,
      "formatted_start": "02:42:05.060",
      "formatted_end": "02:42:16.320",
      "text": "صحبت اشتوه بر شب و روز"
    },
    {
      "id": 14,
      "start": 9736.32,
      "end": 9739.2,
      "formatted_start": "02:42:16.320",
      "formatted_end": "02:42:19.200",
      "text": "باشد میان من و تو"
    },
    {
      "id": 15,
      "start": 9739.2,
      "end": 9742.2,
      "formatted_start": "02:42:19.200",
      "formatted_end": "02:42:22.200",
      "text": "و در زمان من و تو"
    },
    {
      "id": 16,
      "start": 9742.2,
      "end": 9753.24,
      "formatted_start": "02:42:22.200",
      "formatted_end": "02:42:33.240",
      "text": "زندگی آخر شده در سایه"
    },
    {
      "id": 17,
      "start": 9753.24,
      "end": 9756.72,
      "formatted_start": "02:42:33.240",
      "formatted_end": "02:42:36.720",
      "text": "بخی جنابی من و تو"
    },
    {
      "id": 18,
      "start": 9756.72,
      "end": 9759.86,
      "formatted_start": "02:42:36.720",
      "formatted_end": "02:42:39.860",
      "text": "یکم از آمی من و تو"
    },
    {
      "id": 19,
      "start": 9759.86,
      "end": 9766.86,
      "formatted_start": "02:42:39.860",
      "formatted_end": "02:42:46.860",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 9766.86,
      "end": 9772.86,
      "formatted_start": "02:42:46.860",
      "formatted_end": "02:42:52.860",
      "text": "من به کنج رفسی جویمت رفسی"
    },
    {
      "id": 21,
      "start": 9772.86,
      "end": 9778.86,
      "formatted_start": "02:42:52.860",
      "formatted_end": "02:42:58.860",
      "text": "جاست منم اگر تو به داده برسی"
    },
    {
      "id": 22,
      "start": 9778.86,
      "end": 9781.86,
      "formatted_start": "02:42:58.860",
      "formatted_end": "02:43:01.860",
      "text": "که به غیر تو باشدم کسی"
    },
    {
      "id": 23,
      "start": 9781.86,
      "end": 9785.86,
      "formatted_start": "02:43:01.860",
      "formatted_end": "02:43:05.860",
      "text": "دبهت بلا دیدم این قصی"
    },
    {
      "id": 24,
      "start": 9785.86,
      "end": 9794.86,
      "formatted_start": "02:43:05.860",
      "formatted_end": "02:43:14.860",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 9815.86,
      "end": 9821.86,
      "formatted_start": "02:43:35.860",
      "formatted_end": "02:43:41.860",
      "text": "نام تو باشه دید زبان"
    },
    {
      "id": 26,
      "start": 9821.86,
      "end": 9827.86,
      "formatted_start": "02:43:41.860",
      "formatted_end": "02:43:47.860",
