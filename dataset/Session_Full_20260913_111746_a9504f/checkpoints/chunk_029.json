      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:28.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8733.1,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:33.100",
      "text": "برای من کنار من نشست"
    },
    {
      "id": 2,
      "start": 8733.1,
      "end": 8736.0,
      "formatted_start": "02:25:33.100",
      "formatted_end": "02:25:36.000",
      "text": "میریم کسی که این را دست دارد"
    },
    {
      "id": 3,
      "start": 8736.58,
      "end": 8739.0,
      "formatted_start": "02:25:36.580",
      "formatted_end": "02:25:39.000",
      "text": "تو بودی و تو دست دارد"
    },
    {
      "id": 4,
      "start": 8760.0,
      "end": 8789.98,
      "formatted_start": "02:26:00.000",
      "formatted_end": "02:26:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 5,
      "start": 8790.0,
      "end": 8812.0,
      "formatted_start": "02:26:30.000",
      "formatted_end": "02:26:52.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 8812.0,
      "end": 8816.5,
      "formatted_start": "02:26:52.000",
      "formatted_end": "02:26:56.500",
      "text": "دلم میخواد که روزی صد هزار باده"
    },
    {
      "id": 7,
      "start": 8816.5,
      "end": 8820.54,
      "formatted_start": "02:26:56.500",
      "formatted_end": "02:27:00.540",
      "text": "بهت بگم دوست دادم من دیدم"
    },
    {
      "id": 8,
      "start": 8820.54,
      "end": 8825.72,
      "formatted_start": "02:27:00.540",
      "formatted_end": "02:27:05.720",
      "text": "دلم میخواد که امروز زندگی ما"
    },
    {
      "id": 9,
      "start": 8825.72,
      "end": 8830.76,
      "formatted_start": "02:27:05.720",
      "formatted_end": "02:27:10.760",
      "text": "به پای عشق خوبتا بریدم"
    },
    {
      "id": 10,
      "start": 8830.76,
      "end": 8835.0,
      "formatted_start": "02:27:10.760",
      "formatted_end": "02:27:15.000",
      "text": "دلم میخواد که از لمای گره"
    },
    {
      "id": 11,
      "start": 8835.6,
      "end": 8839.08,
      "formatted_start": "02:27:15.600",
      "formatted_end": "02:27:19.080",
      "text": "بلاز سرخه بود سرای چیدم"
    },
    {
      "id": 12,
      "start": 8839.08,
      "end": 8842.9,
      "formatted_start": "02:27:19.080",
      "formatted_end": "02:27:22.900",
      "text": "دلم میخون جواب دوست دارم را"
    },
    {
      "id": 13,
      "start": 8842.9,
      "end": 8846.4,
      "formatted_start": "02:27:22.900",
      "formatted_end": "02:27:26.400",
      "text": "تو چشمای قشنگتا ببینم"
    },
    {
      "id": 14,
      "start": 8846.4,
      "end": 8850.3,
      "formatted_start": "02:27:26.400",
      "formatted_end": "02:27:30.300",
      "text": "دلم میخون جواب دوست دارم را"
    },
    {
      "id": 15,
      "start": 8850.3,
      "end": 8853.9,
      "formatted_start": "02:27:30.300",
      "formatted_end": "02:27:33.900",
      "text": "تو چشمای قشنگتا ببینم"
    },
    {
      "id": 16,
      "start": 8853.9,
      "end": 8858.46,
      "formatted_start": "02:27:33.900",
      "formatted_end": "02:27:38.460",
      "text": "دلم میخون که موزی سمت دارم"
    },
    {
      "id": 17,
      "start": 8858.46,
      "end": 8863.14,
      "formatted_start": "02:27:38.460",
      "formatted_end": "02:27:43.140",
      "text": "بهتر بگم دوست دارم عزیزم"
    },
    {
      "id": 18,
      "start": 8863.14,
      "end": 8868.08,
      "formatted_start": "02:27:43.140",
      "formatted_end": "02:27:48.080",
      "text": "دلم میخون که عمر و زندگی دارم"
    },
    {
      "id": 19,
      "start": 8868.08,
      "end": 8883.08,
      "formatted_start": "02:27:48.080",
      "formatted_end": "02:28:03.080",
