  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7505.64,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:05.640",
      "text": "خیلی ترمش هم خوب رفته و جلو و اینها و همینش مشکلی نداشت."
    },
    {
      "id": 1,
      "start": 7505.64,
      "end": 7509.64,
      "formatted_start": "02:05:05.640",
      "formatted_end": "02:05:09.640",
      "text": "اصلا تو این چهار، پنج سال همین گفت من اینجا تنفس که راضی از شرایطش منم."
    },
    {
      "id": 2,
      "start": 7509.64,
      "end": 7516.84,
      "formatted_start": "02:05:09.640",
      "formatted_end": "02:05:16.840",
      "text": "چون از بومبت اومدن، اونو از تهران اومدن، شب مثلا من برام اینجا خیلی مدینه خواهده دهیم."
    },
    {
      "id": 3,
      "start": 7516.84,
      "end": 7522.24,
      "formatted_start": "02:05:16.840",
      "formatted_end": "02:05:22.240",
      "text": "این امتحان آخری که خراب کرد، یه مکمل خودش هم مثلا شخصیتی خراب شد."
    },
    {
      "id": 4,
      "start": 7522.24,
      "end": 7526.96,
      "formatted_start": "02:05:22.240",
      "formatted_end": "02:05:26.960",
      "text": "تا قبل از این مکالماتش خیلی با این ایویژین همون قسمت هایی دیگه"
    },
    {
      "id": 5,
      "start": 7526.96,
      "end": 7532.24,
      "formatted_start": "02:05:26.960",
      "formatted_end": "02:05:32.240",
      "text": "یه مقدار احساس کردی که پلو ریخته برای خب بیسش اینا بودی زیر اون شخصیتش"
    },
    {
      "id": 6,
      "start": 7532.24,
      "end": 7534.4,
      "formatted_start": "02:05:32.240",
      "formatted_end": "02:05:34.400",
      "text": "اینا بودی که هرنگ اومده بالا"
    },
    {
      "id": 7,
      "start": 7534.4,
      "end": 7537.12,
      "formatted_start": "02:05:34.400",
      "formatted_end": "02:05:37.120",
      "text": "و هرنگ خودشون نشونی داره"
    },
    {
      "id": 8,
      "start": 7537.12,
      "end": 7567.1,
      "formatted_start": "02:05:37.120",
      "formatted_end": "02:06:07.100",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 9,
      "start": 7567.12,
      "end": 7587.12,
      "formatted_start": "02:06:07.120",
      "formatted_end": "02:06:27.120",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 7587.12,
      "end": 7589.12,
      "formatted_start": "02:06:27.120",
      "formatted_end": "02:06:29.120",
      "text": "برسید."
    },
    {
      "id": 11,
      "start": 7602.12,
      "end": 7603.12,
      "formatted_start": "02:06:42.120",
      "formatted_end": "02:06:43.120",
      "text": "شش."
    },
    {
      "id": 12,
      "start": 7603.12,
      "end": 7605.12,
      "formatted_start": "02:06:43.120",
      "formatted_end": "02:06:45.120",
      "text": "حتما. حتما."
    },
    {
      "id": 13,
      "start": 7605.12,
      "end": 7608.12,
      "formatted_start": "02:06:45.120",
      "formatted_end": "02:06:48.120",
      "text": "جناب ایده، جلسه ویدیو تو کنیم دوشنبهه."
    },
    {
      "id": 14,
      "start": 7608.12,
      "end": 7614.12,
      "formatted_start": "02:06:48.120",
      "formatted_end": "02:06:54.120",
      "text": "ولی اگر امکان داره، چون هفته بعدش میره یه جلسه دیگه هم مثلا چهارشنبهه، پنجشنبهه،"
    },
    {
      "id": 15,
      "start": 7614.12,
      "end": 7616.12,
      "formatted_start": "02:06:54.120",
      "formatted_end": "02:06:56.120",
      "text": "ولی هر زمان خودتون سلام نداریم"
    },
    {
      "id": 16,
      "start": 7616.12,
      "end": 7619.12,
      "formatted_start": "02:06:56.120",
      "formatted_end": "02:06:59.120",
      "text": "یعنی باش یا در اعلامه باش کار کنیم"
    },
    {
      "id": 17,
      "start": 7619.12,
      "end": 7620.12,
      "formatted_start": "02:06:59.120",
      "formatted_end": "02:07:00.120",
      "text": "بدش نکنیم"
    },
    {
      "id": 18,
      "start": 7620.12,
      "end": 7622.12,
      "formatted_start": "02:07:00.120",
      "formatted_end": "02:07:02.120",
      "text": "چون شما را قبول دارم"
    },
    {
      "id": 19,
      "start": 7622.12,
      "end": 7625.12,
      "formatted_start": "02:07:02.120",
      "formatted_end": "02:07:05.120",
      "text": "من شما را آدم خیلی توامنندی میبینم توی موضع"
    },
    {
      "id": 20,
      "start": 7625.12,
      "end": 7627.12,
      "formatted_start": "02:07:05.120",
      "formatted_end": "02:07:07.120",
      "text": "دوست دارم واقعا به بچه هم کمک کنیم"
    },
    {
      "id": 21,
      "start": 7627.12,
      "end": 7629.12,
      "formatted_start": "02:07:07.120",
      "formatted_end": "02:07:09.120",
      "text": "ما مدیون شما میشیم"
    },
    {
      "id": 22,
      "start": 7629.12,
      "end": 7634.12,
      "formatted_start": "02:07:09.120",
      "formatted_end": "02:07:14.120",
      "text": "اگر این رو انظر شخصیتی و روحی به یک جایگاه خودش بدیم"
    },
    {
      "id": 23,
      "start": 7634.12,
      "end": 7636.12,
      "formatted_start": "02:07:14.120",
      "formatted_end": "02:07:16.120",
      "text": "چون ما واقعا اطلاعات ما مثل شما نیست"
    },
    {
      "id": 24,
      "start": 7636.12,
      "end": 7639.12,
      "formatted_start": "02:07:16.120",
      "formatted_end": "02:07:19.120",
      "text": "درسته ما پیزش متخصصی تو رشته خود ما هستیم"
    },
    {
      "id": 25,
      "start": 7639.12,
      "end": 7649.12,
      "formatted_start": "02:07:19.120",
      "formatted_end": "02:07:29.120",
      "text": "اینکه برقم ما پسر پادرشترهای شما بودشون میشه برای که بتونیم نجاتش بدیم این خودش یه نجاته"
    },
    {
      "id": 26,
      "start": 7649.12,
      "end": 7655.12,
      "formatted_start": "02:07:29.120",
      "formatted_end": "02:07:35.120",
      "text": "روحان وقتی نیمی باشه خودتون میدونید که دیگه چیزها ارزش نداره به این صورتی"
    },
    {
      "id": 27,
      "start": 7655.12,
      "end": 7659.12,
      "formatted_start": "02:07:35.120",
      "formatted_end": "02:07:39.120",
      "text": "من خود باید وقتتون این شهر اگر عواملی باشه بازم در خدمتون هستیم"
    },
    {
      "id": 28,
      "start": 7659.12,
      "end": 7667.12,
      "formatted_start": "02:07:39.120",
      "formatted_end": "02:07:47.120",
      "text": "برگون شما خیلی ممنونم با محبت و در آیت صحبت کردیشه که من استفاده کردم"
    },
    {
      "id": 29,
      "start": 7667.12,
      "end": 7671.12,
      "formatted_start": "02:07:47.120",
      "formatted_end": "02:07:51.120",
      "text": "سپاس گذارم. قربان شما خود نگه داریم."
    },
    {
      "id": 30,
      "start": 7686.12,
      "end": 7689.12,
      "formatted_start": "02:08:06.120",
      "formatted_end": "02:08:09.120",
      "text": "بخواهید بخواهید. سلامت خواهید. شما خوبه. سلامت بشین."
    },
    {
      "id": 31,
      "start": 7689.12,
      "end": 7692.12,
      "formatted_start": "02:08:09.120",
      "formatted_end": "02:08:12.120",
      "text": "سلامت بخواهید. سلامت خواهید. شما خوبه. شما خوبه. شما خوبه."
    },
    {
      "id": 32,
      "start": 7692.12,
      "end": 7694.12,
      "formatted_start": "02:08:12.120",
      "formatted_end": "02:08:14.120",
      "text": "بعد آزمایشه؟"
    },
    {
      "id": 33,
      "start": 7694.12,
      "end": 7695.12,
      "formatted_start": "02:08:14.120",
      "formatted_end": "02:08:15.120",
      "text": "آره."
    },
    {
      "id": 34,
      "start": 7695.12,
      "end": 7696.12,
      "formatted_start": "02:08:15.120",
      "formatted_end": "02:08:16.120",
      "text": "مشکلش چی بوده؟"
    },
    {
      "id": 35,
      "start": 7696.12,
      "end": 7698.12,
      "formatted_start": "02:08:16.120",
      "formatted_end": "02:08:18.120",
      "text": "کمخونی داشتون و سنگه توریه"
    },
    {
      "id": 36,
      "start": 7698.12,
      "end": 7704.12,
      "formatted_start": "02:08:18.120",
      "formatted_end": "02:08:24.120",
      "text": "کمخونی داشتیم کمخونیش که اینجا سنی شغلت پنج مایه"
    },
    {
      "id": 37,
      "start": 7704.12,
      "end": 7707.12,
      "formatted_start": "02:08:24.120",
      "formatted_end": "02:08:27.120",
      "text": "سابقه خلاسین مینور تو خانواده دادید"
    },
    {
      "id": 38,
      "start": 7707.12,
      "end": 7709.12,
      "formatted_start": "02:08:27.120",
      "formatted_end": "02:08:29.120",
      "text": "تو اینجا مینور داد"
    },
    {
      "id": 39,
      "start": 7709.12,
      "end": 7712.12,
      "formatted_start": "02:08:29.120",
      "formatted_end": "02:08:32.120",
      "text": "حتی بهتره که دو مایه بعد این آزمایش دوباره تکرار"
    },
    {
      "id": 40,
      "start": 7712.12,
      "end": 7716.12,
      "formatted_start": "02:08:32.120",
      "formatted_end": "02:08:36.120",
      "text": "چند هزار خلاسین مینور چون سیه شیش ماه شاید تیگرد شد"
    },
    {
      "id": 41,
      "start": 7716.12,
      "end": 7718.12,
      "formatted_start": "02:08:36.120",
      "formatted_end": "02:08:38.120",
      "text": "دیدید این آزمایش اولش این بود"
    },
    {
      "id": 42,
      "start": 7722.12,
      "end": 7724.12,
      "formatted_start": "02:08:42.120",
      "formatted_end": "02:08:44.120",
      "text": "اینو اونجا نگهر کنشم"
    },
    {
      "id": 43,
      "start": 7724.12,
      "end": 7727.58,
      "formatted_start": "02:08:44.120",
      "formatted_end": "02:08:47.580",
      "text": "این کلیت بوده، زابور بوده، خب این..."
    },
    {
      "id": 44,
      "start": 7727.58,
      "end": 7729.58,
      "formatted_start": "02:08:47.580",
      "formatted_end": "02:08:49.580",
      "text": "بلکه همین یک ماه فاصله باشه"
    },
    {
      "id": 45,
      "start": 7729.58,
      "end": 7731.58,
      "formatted_start": "02:08:49.580",
      "formatted_end": "02:08:51.580",
      "text": "اینو برویم"
    },
    {
      "id": 46,
      "start": 7731.58,
      "end": 7737.58,
      "formatted_start": "02:08:51.580",
      "formatted_end": "02:08:57.580",
      "text": "خب اینها یک کمخونی داشته، خب اون کمخونی خفیف داره"
    },
    {
      "id": 47,
      "start": 7737.58,
      "end": 7742.58,
      "formatted_start": "02:08:57.580",
      "formatted_end": "02:09:02.580",
      "text": "آهنگ آنفونش خوبه، میتامونیش هم خوبه، ولی کالسیومینو رو داره"
    },
    {
      "id": 48,
      "start": 7742.58,
      "end": 7745.58,
      "formatted_start": "02:09:02.580",
      "formatted_end": "02:09:05.580",
      "text": "این سونیگرافی هم تو زابور انجام شده"
    },
    {
      "id": 49,
      "start": 7745.58,
      "end": 7747.58,
      "formatted_start": "02:09:05.580",
      "formatted_end": "02:09:07.580",
      "text": "آره این اولیه، چند ماه؟"
    },
    {
      "id": 50,
      "start": 7747.58,
      "end": 7748.58,
      "formatted_start": "02:09:07.580",
      "formatted_end": "02:09:08.580",
      "text": "بله چی گرفتیم؟"
    },
    {
      "id": 51,
      "start": 7748.58,
      "end": 7749.58,
      "formatted_start": "02:09:08.580",
      "formatted_end": "02:09:09.580",
      "text": "سنگیزه"
    },
    {
      "id": 52,
      "start": 7749.58,
      "end": 7750.58,
      "formatted_start": "02:09:09.580",
      "formatted_end": "02:09:10.580",
      "text": "سنگیزه داشته، بله"
    },
    {
      "id": 53,
      "start": 7750.58,
      "end": 7751.58,
      "formatted_start": "02:09:10.580",
      "formatted_end": "02:09:11.580",
      "text": "چند ماه سنگیزه داره"
    },
    {
      "id": 54,
      "start": 7751.58,
      "end": 7753.58,
      "formatted_start": "02:09:11.580",
      "formatted_end": "02:09:13.580",
      "text": "اینو دوباره اینجا گرفت"
    },
    {
      "id": 55,
      "start": 7753.58,
      "end": 7755.58,
      "formatted_start": "02:09:13.580",
      "formatted_end": "02:09:15.580",
      "text": "کدامون؟"
    },
    {
      "id": 56,
      "start": 7758.58,
      "end": 7761.58,
      "formatted_start": "02:09:18.580",
      "formatted_end": "02:09:21.580",
      "text": "دارو مصرف کردیم دو مالمانو"
    },
    {
      "id": 57,
      "start": 7763.58,
      "end": 7766.58,
      "formatted_start": "02:09:23.580",
      "formatted_end": "02:09:26.580",
      "text": "پلده یه سمتی چپ دوتا سنگیزه"
    },
    {
      "id": 58,
      "start": 7766.58,
      "end": 7769.58,
      "formatted_start": "02:09:26.580",
      "formatted_end": "02:09:29.580",
      "text": "چار و بیدونه سیدی میشه همچنین دو سنگیزه"
    },
    {
      "id": 59,
      "start": 7771.58,
      "end": 7774.58,
      "formatted_start": "02:09:31.580",
      "formatted_end": "02:09:34.580",
      "text": "بله چند تا سنگیزه داره اینا خود؟"
    },
    {
      "id": 60,
      "start": 7774.58,
      "end": 7775.58,
      "formatted_start": "02:09:34.580",
      "formatted_end": "02:09:35.580",
      "text": "این چه داروی برش داره؟"
    },
    {
      "id": 61,
      "start": 7775.58,
      "end": 7777.58,
      "formatted_start": "02:09:35.580",
      "formatted_end": "02:09:37.580",
      "text": "ایچه سنگیزه باید خودش داروی نیست"
    },
    {
      "id": 62,
      "start": 7777.58,
      "end": 7780.58,
      "formatted_start": "02:09:37.580",
      "formatted_end": "02:09:40.580",
      "text": "اینا باید بر بره بخترین مایات مصرف کنه"
    },
    {
      "id": 63,
      "start": 7780.58,
      "end": 7783.58,
      "formatted_start": "02:09:40.580",
      "formatted_end": "02:09:43.580",
      "text": "و از مرور حرکت کنه و بیاد لفت بشه"
    },
    {
      "id": 64,
      "start": 7783.58,
      "end": 7785.58,
      "formatted_start": "02:09:43.580",
      "formatted_end": "02:09:45.580",
      "text": "اوه منجام نرمی دست"
    },
    {
      "id": 65,
      "start": 7785.58,
      "end": 7787.58,
      "formatted_start": "02:09:45.580",
      "formatted_end": "02:09:47.580",
      "text": "حالا اونو سیپراپوتاسیون می ننه دارو هایی می دهد"
    },
    {
      "id": 66,
      "start": 7787.58,
      "end": 7788.58,
      "formatted_start": "02:09:47.580",
      "formatted_end": "02:09:48.580",
      "text": "نرمی دست سیپراپوتاسیون"
    },
    {
      "id": 67,
      "start": 7788.58,
      "end": 7790.58,
      "formatted_start": "02:09:48.580",
      "formatted_end": "02:09:50.580",
      "text": "اینجا نیست ما بگیرم"
    },
    {
      "id": 68,
      "start": 7790.58,
      "end": 7793.58,
      "formatted_start": "02:09:50.580",
      "formatted_end": "02:09:53.580",
      "text": "دارو خانست آقایی سیپراپوتاسیون می نامی ندهد"
    },
    {
      "id": 69,
      "start": 7793.58,
      "end": 7795.58,
      "formatted_start": "02:09:53.580",
      "formatted_end": "02:09:55.580",
      "text": "این دارو هرکت زیادتر می دهد"
    },
    {
      "id": 70,
      "start": 7795.58,
      "end": 7796.58,
      "formatted_start": "02:09:55.580",
      "formatted_end": "02:09:56.580",
      "text": "خوب"
    },
    {
      "id": 71,
      "start": 7796.58,
      "end": 7799.58,
      "formatted_start": "02:09:56.580",
      "formatted_end": "02:09:59.580",
      "text": "سنگ اگه خیلی بزرگ باشه یه علایم انصدادی بده"
    }
  ],
  "status": "completed"
}