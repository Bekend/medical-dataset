  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9907.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:07.000",
      "text": "بیمار شرلنگو، بیمار زیر ماشین نیست."
    },
    {
      "id": 1,
      "start": 9907.0,
      "end": 9913.0,
      "formatted_start": "02:45:07.000",
      "formatted_end": "02:45:13.000",
      "text": "کام شد بابا؟"
    },
    {
      "id": 2,
      "start": 9943.0,
      "end": 9945.0,
      "formatted_start": "02:45:43.000",
      "formatted_end": "02:45:45.000",
      "text": "این رو خوش کنیم بریم"
    },
    {
      "id": 3,
      "start": 9945.0,
      "end": 9947.0,
      "formatted_start": "02:45:45.000",
      "formatted_end": "02:45:47.000",
      "text": "نه نه خوش کنیم"
    },
    {
      "id": 4,
      "start": 9947.0,
      "end": 9949.0,
      "formatted_start": "02:45:47.000",
      "formatted_end": "02:45:49.000",
      "text": "این رو پارچی کشیدید دیگه با خوش داشتن"
    },
    {
      "id": 5,
      "start": 9949.0,
      "end": 9951.0,
      "formatted_start": "02:45:49.000",
      "formatted_end": "02:45:51.000",
      "text": "خوشهایی کشیدیم"
    },
    {
      "id": 6,
      "start": 9951.0,
      "end": 9953.0,
      "formatted_start": "02:45:51.000",
      "formatted_end": "02:45:53.000",
      "text": "آه خب تمام"
    },
    {
      "id": 7,
      "start": 9953.0,
      "end": 9955.0,
      "formatted_start": "02:45:53.000",
      "formatted_end": "02:45:55.000",
      "text": "خوش کنیم"
    },
    {
      "id": 8,
      "start": 9955.0,
      "end": 9957.0,
      "formatted_start": "02:45:55.000",
      "formatted_end": "02:45:57.000",
      "text": "نه نه"
    },
    {
      "id": 9,
      "start": 9957.0,
      "end": 9959.0,
      "formatted_start": "02:45:57.000",
      "formatted_end": "02:45:59.000",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 9959.0,
      "end": 9961.0,
      "formatted_start": "02:45:59.000",
      "formatted_end": "02:46:01.000",
      "text": "آره بگیر"
    },
    {
      "id": 11,
      "start": 9961.0,
      "end": 9963.0,
      "formatted_start": "02:46:01.000",
      "formatted_end": "02:46:03.000",
      "text": "با ماشین بریم یا پیاده"
    },
    {
      "id": 12,
      "start": 9963.0,
      "end": 9965.0,
      "formatted_start": "02:46:03.000",
      "formatted_end": "02:46:05.000",
      "text": "پیاده بریم"
    },
    {
      "id": 13,
      "start": 9965.0,
      "end": 9967.0,
      "formatted_start": "02:46:05.000",
      "formatted_end": "02:46:07.000",
      "text": "پیاده بریم باش"
    },
    {
      "id": 14,
      "start": 9969.0,
      "end": 9971.0,
      "formatted_start": "02:46:09.000",
      "formatted_end": "02:46:11.000",
      "text": "آره ازتاق نداری"
    },
    {
      "id": 15,
      "start": 9971.0,
      "end": 9973.0,
      "formatted_start": "02:46:11.000",
      "formatted_end": "02:46:13.000",
      "text": "این هوایی با خود داریم"
    },
    {
      "id": 16,
      "start": 9978.0,
      "end": 9980.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:20.000",
      "text": "این هوایی در اینکه باشیم"
    },
    {
      "id": 17,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "این هوایی در اینکه باشیم"
    },
    {
      "id": 18,
      "start": 9985.0,
      "end": 9987.0,
      "formatted_start": "02:46:25.000",
      "formatted_end": "02:46:27.000",
      "text": "این هوایی در اینکه باشیم"
    },
    {
      "id": 19,
      "start": 9987.0,
      "end": 9989.0,
      "formatted_start": "02:46:27.000",
      "formatted_end": "02:46:29.000",
      "text": "خودتون بیرون"
    },
    {
      "id": 20,
      "start": 9989.0,
      "end": 9991.0,
      "formatted_start": "02:46:29.000",
      "formatted_end": "02:46:31.000",
      "text": "این هوایی مزخش داریم"
    },
    {
      "id": 21,
      "start": 9995.0,
      "end": 9997.0,
      "formatted_start": "02:46:35.000",
      "formatted_end": "02:46:37.000",
      "text": "خودتون بالا کار داریم؟"
    },
    {
      "id": 22,
      "start": 9997.0,
      "end": 9999.0,
      "formatted_start": "02:46:37.000",
      "formatted_end": "02:46:39.000",
      "text": "نه، نه، خودتون رو خواهد مرزنده خواهید شوید"
    },
    {
      "id": 23,
      "start": 9999.0,
      "end": 10001.0,
      "formatted_start": "02:46:39.000",
      "formatted_end": "02:46:41.000",
      "text": "آهان برش میدونی"
    },
    {
      "id": 24,
      "start": 10001.0,
      "end": 10003.0,
      "formatted_start": "02:46:41.000",
      "formatted_end": "02:46:43.000",
      "text": "آهان برش میدونی"
    },
    {
      "id": 25,
      "start": 10003.0,
      "end": 10005.0,
      "formatted_start": "02:46:43.000",
      "formatted_end": "02:46:45.000",
      "text": "اون رو بزارو کشو سرکرم شو"
    },
    {
      "id": 26,
      "start": 10005.0,
      "end": 10007.0,
      "formatted_start": "02:46:45.000",
      "formatted_end": "02:46:47.000",
      "text": "تبشه برگیشتو بودید؟"
    },
    {
      "id": 27,
      "start": 10009.0,
      "end": 10011.0,
      "formatted_start": "02:46:49.000",
      "formatted_end": "02:46:51.000",
      "text": "آماله کنم"
    },
    {
      "id": 28,
      "start": 10011.0,
      "end": 10013.0,
      "formatted_start": "02:46:51.000",
      "formatted_end": "02:46:53.000",
      "text": "مسلط"
    },
    {
      "id": 29,
      "start": 10013.0,
      "end": 10015.0,
      "formatted_start": "02:46:53.000",
      "formatted_end": "02:46:55.000",
      "text": "مسلط"
    },
    {
      "id": 30,
      "start": 10015.0,
      "end": 10019.0,
      "formatted_start": "02:46:55.000",
      "formatted_end": "02:46:59.000",
      "text": "روب باشگاه"
    },
    {
      "id": 31,
      "start": 10019.0,
      "end": 10021.0,
      "formatted_start": "02:46:59.000",
      "formatted_end": "02:47:01.000",
      "text": "روب باشگاه آقای رجمی"
    },
    {
      "id": 32,
      "start": 10021.0,
      "end": 10025.0,
      "formatted_start": "02:47:01.000",
      "formatted_end": "02:47:05.000",
      "text": "روب باشگاه امیرانی"
    },
    {
      "id": 33,
      "start": 10025.0,
      "end": 10029.0,
      "formatted_start": "02:47:05.000",
      "formatted_end": "02:47:09.000",
      "text": "اسمش خداست"
    },
    {
      "id": 34,
      "start": 10029.0,
      "end": 10031.0,
      "formatted_start": "02:47:09.000",
      "formatted_end": "02:47:11.000",
      "text": "اسمش امیرانی"
    },
    {
      "id": 35,
      "start": 10031.0,
      "end": 10033.0,
      "formatted_start": "02:47:11.000",
      "formatted_end": "02:47:13.000",
      "text": "اسمه پچه رو"
    },
    {
      "id": 36,
      "start": 10033.0,
      "end": 10035.0,
      "formatted_start": "02:47:13.000",
      "formatted_end": "02:47:15.000",
      "text": "نیست به خود همینو یکی"
    },
    {
      "id": 37,
      "start": 10035.0,
      "end": 10037.0,
      "formatted_start": "02:47:15.000",
      "formatted_end": "02:47:17.000",
      "text": "یک بچه باهم میرنی"
    },
    {
      "id": 38,
      "start": 10037.0,
      "end": 10039.0,
      "formatted_start": "02:47:17.000",
      "formatted_end": "02:47:19.000",
      "text": "اینو باید تنبیل میدین یا یک بچه"
    },
    {
      "id": 39,
      "start": 10039.0,
      "end": 10041.0,
      "formatted_start": "02:47:19.000",
      "formatted_end": "02:47:21.000",
      "text": "اونو دیگه های همینو بچه هایی بگیرم"
    },
    {
      "id": 40,
      "start": 10041.0,
      "end": 10043.0,
      "formatted_start": "02:47:21.000",
      "formatted_end": "02:47:23.000",
      "text": "داده همینو دیگه همینو بگیرم"
    },
    {
      "id": 41,
      "start": 10043.0,
      "end": 10045.0,
      "formatted_start": "02:47:23.000",
      "formatted_end": "02:47:25.000",
      "text": "کشت دیگه؟ دیگه هایی"
    },
    {
      "id": 42,
      "start": 10047.0,
      "end": 10049.0,
      "formatted_start": "02:47:27.000",
      "formatted_end": "02:47:29.000",
      "text": "از آنکه باهم بگیرم"
    },
    {
      "id": 43,
      "start": 10063.0,
      "end": 10083.0,
      "formatted_start": "02:47:43.000",
      "formatted_end": "02:48:03.000",
