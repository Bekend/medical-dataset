  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5430.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 1,
      "start": 5430.0,
      "end": 5432.5,
      "formatted_start": "01:30:30.000",
      "formatted_end": "01:30:32.500",
      "text": "بدنشون هم کاملا سفیده"
    },
    {
      "id": 2,
      "start": 5432.5,
      "end": 5437.5,
      "formatted_start": "01:30:32.500",
      "formatted_end": "01:30:37.500",
      "text": "صورت اینجا خوب، اینجا شاید یکم سرکششون پاشه ادادید"
    },
    {
      "id": 3,
      "start": 5437.5,
      "end": 5439.5,
      "formatted_start": "01:30:37.500",
      "formatted_end": "01:30:39.500",
      "text": "اونم از پیم میره"
    },
    {
      "id": 4,
      "start": 5439.5,
      "end": 5443.0,
      "formatted_start": "01:30:39.500",
      "formatted_end": "01:30:43.000",
      "text": "بله یک ساعت اینا ما چیز هم"
    },
    {
      "id": 5,
      "start": 5443.0,
      "end": 5448.0,
      "formatted_start": "01:30:43.000",
      "formatted_end": "01:30:48.000",
      "text": "این چشمنشو بگذاشته ببینیم در آباده نداریم"
    },
    {
      "id": 6,
      "start": 5448.0,
      "end": 5451.0,
      "formatted_start": "01:30:48.000",
      "formatted_end": "01:30:51.000",
      "text": "بشکن نداری، خطر نداری، نگرم نباشی"
    },
    {
      "id": 7,
      "start": 5451.0,
      "end": 5453.0,
      "formatted_start": "01:30:51.000",
      "formatted_end": "01:30:53.000",
      "text": "بله، درده هم نشید"
    },
    {
      "id": 8,
      "start": 5453.0,
      "end": 5459.0,
      "formatted_start": "01:30:53.000",
      "formatted_end": "01:30:59.000",
      "text": "شرط اهورانینی یا این که بیشترهای دیگر زور میگنه، گریه میکنه"
    },
    {
      "id": 9,
      "start": 5459.0,
      "end": 5461.0,
      "formatted_start": "01:30:59.000",
      "formatted_end": "01:31:01.000",
      "text": "اینجوری میشه"
    },
    {
      "id": 10,
      "start": 5461.0,
      "end": 5463.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:03.000",
      "text": "آره زور میزنید"
    },
    {
      "id": 11,
      "start": 5463.0,
      "end": 5465.0,
      "formatted_start": "01:31:03.000",
      "formatted_end": "01:31:05.000",
      "text": "نخ بینا داره"
    },
    {
      "id": 12,
      "start": 5465.0,
      "end": 5467.0,
      "formatted_start": "01:31:05.000",
      "formatted_end": "01:31:07.000",
      "text": "کل گریب بشونید از اینها"
    },
    {
      "id": 13,
      "start": 5469.0,
      "end": 5471.0,
      "formatted_start": "01:31:09.000",
      "formatted_end": "01:31:11.000",
      "text": "خوب"
    },
    {
      "id": 14,
      "start": 5471.0,
      "end": 5473.0,
      "formatted_start": "01:31:11.000",
      "formatted_end": "01:31:13.000",
      "text": "با داره شبوبات و"
    },
    {
      "id": 15,
      "start": 5473.0,
      "end": 5475.0,
      "formatted_start": "01:31:13.000",
      "formatted_end": "01:31:15.000",
      "text": "نخ بینا داره"
    },
    {
      "id": 16,
      "start": 5475.0,
      "end": 5477.0,
      "formatted_start": "01:31:15.000",
      "formatted_end": "01:31:17.000",
      "text": "خوب بلینجای بودیی بش دست میده"
    },
    {
      "id": 17,
      "start": 5481.0,
      "end": 5483.0,
      "formatted_start": "01:31:21.000",
      "formatted_end": "01:31:23.000",
      "text": "اینو روزی دو بار"
    },
    {
      "id": 18,
      "start": 5483.0,
      "end": 5485.0,
      "formatted_start": "01:31:23.000",
      "formatted_end": "01:31:25.000",
      "text": "میتونیم بش بدید"
    },
    {
      "id": 19,
      "start": 5485.0,
      "end": 5487.0,
      "formatted_start": "01:31:25.000",
      "formatted_end": "01:31:27.000",
      "text": "من نسخه نیم کنم"
    },
    {
      "id": 20,
      "start": 5487.0,
      "end": 5497.0,
      "formatted_start": "01:31:27.000",
      "formatted_end": "01:31:37.000",
      "text": "بره نفت و دلدشی نوره"
    },
    {
      "id": 21,
      "start": 5497.0,
      "end": 5499.0,
      "formatted_start": "01:31:37.000",
      "formatted_end": "01:31:39.000",
      "text": "زردش خوبه دیگه"
    },
    {
      "id": 22,
      "start": 5499.0,
      "end": 5501.0,
      "formatted_start": "01:31:39.000",
      "formatted_end": "01:31:41.000",
      "text": "نافش مشکل نمیدونه؟"
    },
    {
      "id": 23,
      "start": 5501.0,
      "end": 5503.0,
      "formatted_start": "01:31:41.000",
      "formatted_end": "01:31:43.000",
      "text": "نه نافش خوبه"
    },
    {
      "id": 24,
      "start": 5503.0,
      "end": 5505.0,
      "formatted_start": "01:31:43.000",
      "formatted_end": "01:31:45.000",
      "text": "بس خیلی میخواه آقایی"
    },
    {
      "id": 25,
      "start": 5505.0,
      "end": 5507.0,
      "formatted_start": "01:31:45.000",
      "formatted_end": "01:31:47.000",
      "text": "این همینجوری هست دیگه"
    },
    {
      "id": 26,
      "start": 5507.0,
      "end": 5509.0,
      "formatted_start": "01:31:47.000",
      "formatted_end": "01:31:49.000",
      "text": "میخواه"
    },
    {
      "id": 27,
      "start": 5509.0,
      "end": 5511.0,
      "formatted_start": "01:31:49.000",
      "formatted_end": "01:31:51.000",
      "text": "اکثرا ۱۸۸ ساعت در روش خواهد"
    },
    {
      "id": 28,
      "start": 5511.0,
      "end": 5513.0,
      "formatted_start": "01:31:51.000",
      "formatted_end": "01:31:53.000",
      "text": "بزرگ بیدار میدونه میخواهد"
    },
    {
      "id": 29,
      "start": 5513.0,
      "end": 5515.0,
      "formatted_start": "01:31:53.000",
      "formatted_end": "01:31:55.000",
      "text": "خب نه آن خوابشون تا"
    },
    {
      "id": 30,
      "start": 5515.0,
      "end": 5517.0,
      "formatted_start": "01:31:55.000",
      "formatted_end": "01:31:57.000",
      "text": "اوشون تا چهر روزگیر و هم بیخته هست"
    },
    {
      "id": 31,
      "start": 5519.0,
      "end": 5521.0,
      "formatted_start": "01:31:59.000",
      "formatted_end": "01:32:01.000",
      "text": "تا چهر روزگیر و هم بیخته هست"
    },
    {
      "id": 32,
      "start": 5523.0,
      "end": 5525.0,
      "formatted_start": "01:32:03.000",
      "formatted_end": "01:32:05.000",
      "text": "بعد اکثرا خواب هست"
    },
    {
      "id": 33,
      "start": 5525.0,
      "end": 5527.0,
      "formatted_start": "01:32:05.000",
      "formatted_end": "01:32:07.000",
      "text": "مشکلی الان نداره"
    },
    {
      "id": 34,
      "start": 5527.0,
      "end": 5529.0,
      "formatted_start": "01:32:07.000",
      "formatted_end": "01:32:09.000",
      "text": "بعد مثلا یه دو ساعت دیگه"
    },
    {
      "id": 35,
      "start": 5529.0,
      "end": 5531.0,
      "formatted_start": "01:32:09.000",
      "formatted_end": "01:32:11.000",
      "text": "اینقدر دیقرار بشه گریه کنی که عفاسی بشه"
    },
    {
      "id": 36,
      "start": 5535.0,
      "end": 5537.0,
      "formatted_start": "01:32:15.000",
      "formatted_end": "01:32:17.000",
      "text": "اینم بدیم به منشی"
    },
    {
      "id": 37,
      "start": 5541.0,
      "end": 5543.0,
      "formatted_start": "01:32:21.000",
      "formatted_end": "01:32:23.000",
      "text": "در باز باشه"
    },
    {
      "id": 38,
      "start": 5543.0,
      "end": 5546.0,
      "formatted_start": "01:32:23.000",
      "formatted_end": "01:32:26.000",
      "text": "اگر می‌کنید به تهوروخانو بینیم، پیماتی شننده"
    },
    {
      "id": 39,
      "start": 5558.0,
      "end": 5560.0,
      "formatted_start": "01:32:38.000",
      "formatted_end": "01:32:40.000",
      "text": "نه، خواهید کنیم با سو"
    },
    {
      "id": 40,
      "start": 5560.0,
      "end": 5580.0,
      "formatted_start": "01:32:40.000",
      "formatted_end": "01:33:00.000",
      "text": "موسیقی"
    },
    {
      "id": 41,
      "start": 5590.0,
      "end": 5612.0,
      "formatted_start": "01:33:10.000",
      "formatted_end": "01:33:32.000",
      "text": "موسیقی"
    },
    {
      "id": 42,
      "start": 5620.0,
      "end": 5623.06,
      "formatted_start": "01:33:40.000",
      "formatted_end": "01:33:43.060",
      "text": "این میدار پرخونی داره وگرنه مثلا چیزی دیگی نداره"
    },
    {
      "id": 43,
      "start": 5623.06,
      "end": 5627.9,
      "formatted_start": "01:33:43.060",
      "formatted_end": "01:33:47.900",
      "text": "اونقدر هم مثلا نبود که فکر کنم هر هفته مریض بشه درسته؟"
    },
    {
      "id": 44,
      "start": 5627.9,
      "end": 5630.64,
      "formatted_start": "01:33:47.900",
      "formatted_end": "01:33:50.640",
      "text": "حالا الان مثلا هفته بشه مریض بشه باز دوباره مریض بشه"
    },
    {
      "id": 45,
      "start": 5630.64,
      "end": 5633.52,
      "formatted_start": "01:33:50.640",
      "formatted_end": "01:33:53.520",
      "text": "نه الان این هم کلیه بیشتر"
    },
    {
      "id": 46,
      "start": 5633.52,
      "end": 5635.52,
      "formatted_start": "01:33:53.520",
      "formatted_end": "01:33:55.520",
      "text": "حالا مثلا دوباره پشتر هم شده"
    },
    {
      "id": 47,
      "start": 5635.52,
      "end": 5638.32,
      "formatted_start": "01:33:55.520",
      "formatted_end": "01:33:58.320",
      "text": "مبنانی میشه بودش باید نه خیلی خطرناک بشه"
    },
    {
      "id": 48,
      "start": 5638.32,
      "end": 5642.48,
      "formatted_start": "01:33:58.320",
      "formatted_end": "01:34:02.480",
      "text": "مثلا نسبت به قبلش میگم خیلی بیشتر هم خوردهش هم بیشتر شده"
    },
    {
      "id": 49,
      "start": 5642.48,
      "end": 5643.52,
      "formatted_start": "01:34:02.480",
      "formatted_end": "01:34:03.520",
      "text": "باز مراقب"
    },
    {
      "id": 50,
      "start": 5643.52,
      "end": 5649.52,
      "formatted_start": "01:34:03.520",
      "formatted_end": "01:34:09.520",
      "text": "ببینید این ها الان سینه شیمده خورخونی داره یه شروط کتو تیفن بهش بدید"
    },
    {
      "id": 51,
      "start": 5649.52,
      "end": 5651.52,
      "formatted_start": "01:34:09.520",
      "formatted_end": "01:34:11.520",
      "text": "کتو تیفن"
    },
    {
      "id": 52,
      "start": 5651.52,
      "end": 5657.52,
      "formatted_start": "01:34:11.520",
      "formatted_end": "01:34:17.520",
      "text": "خوب بعد یه قرص هیروکاست هسته سینه شقدره؟"
    },
    {
      "id": 53,
      "start": 5657.52,
      "end": 5659.52,
      "formatted_start": "01:34:17.520",
      "formatted_end": "01:34:19.520",
      "text": "هر سالش"
    },
    {
      "id": 54,
      "start": 5659.52,
      "end": 5666.52,
      "formatted_start": "01:34:19.520",
      "formatted_end": "01:34:26.520",
      "text": "ده بیس عدد هر روزی نصف قرص خوب یک دومه قرص"
    },
    {
      "id": 55,
      "start": 5666.52,
      "end": 5669.52,
      "formatted_start": "01:34:26.520",
      "formatted_end": "01:34:29.520",
      "text": "این هم هر روز یک پیمانه"
    },
    {
      "id": 56,
      "start": 5669.52,
      "end": 5671.52,
      "formatted_start": "01:34:29.520",
      "formatted_end": "01:34:31.520",
      "text": "این رو هم رحمتی داره"
    },
    {
      "id": 57,
      "start": 5671.52,
      "end": 5673.52,
      "formatted_start": "01:34:31.520",
      "formatted_end": "01:34:33.520",
      "text": "این رو هم رحمتی داره"
    },
    {
      "id": 58,
      "start": 5673.52,
      "end": 5675.52,
      "formatted_start": "01:34:33.520",
      "formatted_end": "01:34:35.520",
      "text": "این رو هم خساسیت هم هست"
    },
    {
      "id": 59,
      "start": 5675.52,
      "end": 5677.52,
      "formatted_start": "01:34:35.520",
      "formatted_end": "01:34:37.520",
      "text": "هوای سردی، سگال، عطر، اتکلون دور برش داره"
    },
    {
      "id": 60,
      "start": 5677.52,
      "end": 5679.52,
      "formatted_start": "01:34:37.520",
      "formatted_end": "01:34:39.520",
      "text": "هوای سردی، سگال، اتکلون دور برش داره"
    },
    {
      "id": 61,
      "start": 5679.52,
      "end": 5681.52,
      "formatted_start": "01:34:39.520",
      "formatted_end": "01:34:41.520",
      "text": "میدونی زمستان ها مثلا صرفه میگرفت تو خواب"
    },
    {
      "id": 62,
      "start": 5681.52,
      "end": 5683.52,
      "formatted_start": "01:34:41.520",
      "formatted_end": "01:34:43.520",
      "text": "میدونی زمستان ها مثلا صرفه میگرفت تو خواب"
    },
    {
      "id": 63,
      "start": 5683.52,
      "end": 5685.52,
      "formatted_start": "01:34:43.520",
      "formatted_end": "01:34:45.520",
      "text": "من باید کنجره رو باز میکردم، هوایی میومد"
    },
    {
      "id": 64,
      "start": 5685.52,
      "end": 5687.52,
      "formatted_start": "01:34:45.520",
      "formatted_end": "01:34:47.520",
      "text": "من باید کنجره رو باز میکردم، هوایی میومد"
    },
    {
      "id": 65,
      "start": 5687.52,
      "end": 5693.52,
      "formatted_start": "01:34:47.520",
      "formatted_end": "01:34:53.520",
      "text": "از هم گل گیا، عق، اتکلون، این ها دربارش نباشه"
    },
    {
      "id": 66,
      "start": 5693.52,
      "end": 5695.52,
      "formatted_start": "01:34:53.520",
      "formatted_end": "01:34:55.520",
      "text": "از اسفند خیلی شوه را دوست داریم"
    },
    {
      "id": 67,
      "start": 5695.52,
      "end": 5697.52,
      "formatted_start": "01:34:55.520",
      "formatted_end": "01:34:57.520",
      "text": "خب اسفند اگه بیاید عذیب می کنید نکنید"
    },
    {
      "id": 68,
      "start": 5697.52,
      "end": 5699.52,
      "formatted_start": "01:34:57.520",
      "formatted_end": "01:34:59.520",
      "text": "این بگوشت از منو بود"
    }
  ],
  "status": "completed"
}