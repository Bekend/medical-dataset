  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9029.98,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 9030.0,
      "end": 9039.7,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:39.700",
      "text": "حیف حیف که عمرم به پای تو هم در شد"
    },
    {
      "id": 2,
      "start": 9039.7,
      "end": 9047.04,
      "formatted_start": "02:30:39.700",
      "formatted_end": "02:30:47.040",
      "text": "حیف از جبههیم که با تو بی سمت شد"
    },
    {
      "id": 3,
      "start": 9047.04,
      "end": 9055.02,
      "formatted_start": "02:30:47.040",
      "formatted_end": "02:30:55.020",
      "text": "خونه یک روشه ی زندن واسه من بود و باز"
    },
    {
      "id": 4,
      "start": 9055.02,
      "end": 9059.2,
      "formatted_start": "02:30:55.020",
      "formatted_end": "02:30:59.200",
      "text": "عشق توی قابه پریشون"
    },
    {
      "id": 5,
      "start": 9059.2,
      "end": 9061.94,
      "formatted_start": "02:30:59.200",
      "formatted_end": "02:31:01.940",
      "text": "باسه من بود و بست"
    },
    {
      "id": 6,
      "start": 9061.94,
      "end": 9066.4,
      "formatted_start": "02:31:01.940",
      "formatted_end": "02:31:06.400",
      "text": "روز رو لبا خونده ظاهر"
    },
    {
      "id": 7,
      "start": 9066.4,
      "end": 9070.12,
      "formatted_start": "02:31:06.400",
      "formatted_end": "02:31:10.120",
      "text": "اگه جنب میگرفت"
    },
    {
      "id": 8,
      "start": 9070.12,
      "end": 9073.74,
      "formatted_start": "02:31:10.120",
      "formatted_end": "02:31:13.740",
      "text": "شب که میشد چشم و یک گریون"
    },
    {
      "id": 9,
      "start": 9073.74,
      "end": 9076.54,
      "formatted_start": "02:31:13.740",
      "formatted_end": "02:31:16.540",
      "text": "باسه من بود و بست"
    },
    {
      "id": 10,
      "start": 9076.54,
      "end": 9080.24,
      "formatted_start": "02:31:16.540",
      "formatted_end": "02:31:20.240",
      "text": "ای پید که عمرم"
    },
    {
      "id": 11,
      "start": 9080.24,
      "end": 9083.86,
      "formatted_start": "02:31:20.240",
      "formatted_end": "02:31:23.860",
      "text": "احای تو حدر شد"
    },
    {
      "id": 12,
      "start": 9083.86,
      "end": 9091.66,
      "formatted_start": "02:31:23.860",
      "formatted_end": "02:31:31.660",
      "text": "ای خواه از جمعونی که با تو می سمر شد"
    },
    {
      "id": 13,
      "start": 9091.66,
      "end": 9106.66,
      "formatted_start": "02:31:31.660",
      "formatted_end": "02:31:46.660",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 9121.66,
      "end": 9128.94,
      "formatted_start": "02:32:01.660",
      "formatted_end": "02:32:08.940",
      "text": "آزمه لومتش نکن چشمای گریه او بود"
    },
    {
      "id": 15,
      "start": 9128.94,
      "end": 9136.94,
      "formatted_start": "02:32:08.940",
      "formatted_end": "02:32:16.940",
      "text": "او که از نگاه تو چیزی نمیخونه"
    },
    {
      "id": 16,
      "start": 9136.94,
      "end": 9140.7,
      "formatted_start": "02:32:16.940",
      "formatted_end": "02:32:20.700",
      "text": "چیزی نمیتونه"
    },
    {
      "id": 17,
      "start": 9140.7,
      "end": 9148.34,
      "formatted_start": "02:32:20.700",
      "formatted_end": "02:32:28.340",
      "text": "که پیده اون رو بای تو هندر شد"
    },
    {
      "id": 18,
      "start": 9148.34,
      "end": 9156.34,
      "formatted_start": "02:32:28.340",
      "formatted_end": "02:32:36.340",
      "text": "خریف از جمعونی که با تو بی سمر شد"
    },
    {
      "id": 19,
      "start": 9156.34,
      "end": 9171.34,
      "formatted_start": "02:32:36.340",
      "formatted_end": "02:32:51.340",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 9186.34,
      "end": 9190.0,
      "formatted_start": "02:33:06.340",
      "formatted_end": "02:33:10.000",
      "text": "خوز ملابتش نکن"
    },
    {
      "id": 21,
      "start": 9190.0,
      "end": 9193.76,
      "formatted_start": "02:33:10.000",
      "formatted_end": "02:33:13.760",
      "text": "که نشان گریه و نورک"
    },
    {
      "id": 22,
      "start": 9193.76,
      "end": 9197.56,
      "formatted_start": "02:33:13.760",
      "formatted_end": "02:33:17.560",
      "text": "اون کس به دارکو"
    },
    {
      "id": 23,
      "start": 9197.56,
      "end": 9201.22,
      "formatted_start": "02:33:17.560",
      "formatted_end": "02:33:21.220",
      "text": "چیزی نمیخونه"
    },
    {
      "id": 24,
      "start": 9201.22,
      "end": 9204.64,
      "formatted_start": "02:33:21.220",
      "formatted_end": "02:33:24.640",
      "text": "چیزی نمیپونه"
    },
    {
      "id": 25,
      "start": 9204.64,
      "end": 9214.64,
      "formatted_start": "02:33:24.640",
      "formatted_end": "02:33:34.640",
