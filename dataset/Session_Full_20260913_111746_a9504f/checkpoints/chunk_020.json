  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6002.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:02.000",
      "text": "مدیشه از اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 6030.0,
      "end": 6032.0,
      "formatted_start": "01:40:30.000",
      "formatted_end": "01:40:32.000",
      "text": "همینگه ماشین چی نوزدید؟"
    },
    {
      "id": 2,
      "start": 6060.0,
      "end": 6078.0,
      "formatted_start": "01:41:00.000",
      "formatted_end": "01:41:18.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 6078.0,
      "end": 6080.0,
      "formatted_start": "01:41:18.000",
      "formatted_end": "01:41:20.000",
      "text": "برد نیست. اوکی."
    },
    {
      "id": 4,
      "start": 6080.0,
      "end": 6081.24,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:21.240",
      "text": "برد نیست. اوکی."
    },
    {
      "id": 5,
      "start": 6081.24,
      "end": 6083.88,
      "formatted_start": "01:41:21.240",
      "formatted_end": "01:41:23.880",
      "text": "اگه بتونید ما مایو ها رو درست جمع کنید"
    },
    {
      "id": 6,
      "start": 6083.88,
      "end": 6085.88,
      "formatted_start": "01:41:23.880",
      "formatted_end": "01:41:25.880",
      "text": "کارت دیگه در اینجا باشید."
    },
    {
      "id": 7,
      "start": 6085.88,
      "end": 6089.16,
      "formatted_start": "01:41:25.880",
      "formatted_end": "01:41:29.160",
      "text": "کارت دیگه هست و این روزه این تاستیل کجاست؟"
    },
    {
      "id": 8,
      "start": 6089.16,
      "end": 6091.16,
      "formatted_start": "01:41:29.160",
      "formatted_end": "01:41:31.160",
      "text": "این روزه این تاستیل."
    },
    {
      "id": 9,
      "start": 6101.16,
      "end": 6102.16,
      "formatted_start": "01:41:41.160",
      "formatted_end": "01:41:42.160",
      "text": "سرودی کاره."
    },
    {
      "id": 10,
      "start": 6102.16,
      "end": 6105.16,
      "formatted_start": "01:41:42.160",
      "formatted_end": "01:41:45.160",
      "text": "اینجا چند سفاره افته به؟"
    },
    {
      "id": 11,
      "start": 6105.16,
      "end": 6106.16,
      "formatted_start": "01:41:45.160",
      "formatted_end": "01:41:46.160",
      "text": "نه. اون نیست."
    },
    {
      "id": 12,
      "start": 6106.16,
      "end": 6107.16,
      "formatted_start": "01:41:46.160",
      "formatted_end": "01:41:47.160",
      "text": "اون نیست."
    },
    {
      "id": 13,
      "start": 6107.16,
      "end": 6109.16,
      "formatted_start": "01:41:47.160",
      "formatted_end": "01:41:49.160",
      "text": "رامرمایتون"
    },
    {
      "id": 14,
      "start": 6113.16,
      "end": 6115.16,
      "formatted_start": "01:41:53.160",
      "formatted_end": "01:41:55.160",
      "text": "دو تا راننده رو که ندارم"
    },
    {
      "id": 15,
      "start": 6117.16,
      "end": 6119.16,
      "formatted_start": "01:41:57.160",
      "formatted_end": "01:41:59.160",
      "text": "این ماشین بگه دوره هست"
    },
    {
      "id": 16,
      "start": 6119.16,
      "end": 6121.16,
      "formatted_start": "01:41:59.160",
      "formatted_end": "01:42:01.160",
      "text": "نه این اوتوبوس دوتاورگ هست"
    },
    {
      "id": 17,
      "start": 6121.16,
      "end": 6123.16,
      "formatted_start": "01:42:01.160",
      "formatted_end": "01:42:03.160",
      "text": "نه نه"
    },
    {
      "id": 18,
      "start": 6123.16,
      "end": 6125.16,
      "formatted_start": "01:42:03.160",
      "formatted_end": "01:42:05.160",
      "text": "تبایی ماده ایران هست"
    },
    {
      "id": 19,
      "start": 6125.16,
      "end": 6127.16,
      "formatted_start": "01:42:05.160",
      "formatted_end": "01:42:07.160",
      "text": "نمیدونم"
    },
    {
      "id": 20,
      "start": 6127.16,
      "end": 6129.16,
      "formatted_start": "01:42:07.160",
      "formatted_end": "01:42:09.160",
      "text": "ماده ای ریزگیری بیستند که بگم"
    },
    {
      "id": 21,
      "start": 6129.16,
      "end": 6131.16,
      "formatted_start": "01:42:09.160",
      "formatted_end": "01:42:11.160",
      "text": "ایران داشتون پیدا کنند"
    },
    {
      "id": 22,
      "start": 6131.16,
      "end": 6133.16,
      "formatted_start": "01:42:11.160",
      "formatted_end": "01:42:13.160",
      "text": "من اینو نمیگم"
    },
    {
      "id": 23,
      "start": 6133.16,
      "end": 6135.16,
      "formatted_start": "01:42:13.160",
      "formatted_end": "01:42:15.160",
      "text": "بچه هایی که دارن ویدیو رو میبینند"
    },
    {
      "id": 24,
      "start": 6135.16,
      "end": 6137.16,
      "formatted_start": "01:42:15.160",
      "formatted_end": "01:42:17.160",
      "text": "باید شما بیاد با همه تا چند درست کنید"
    },
    {
      "id": 25,
      "start": 6137.16,
      "end": 6138.16,
      "formatted_start": "01:42:17.160",
      "formatted_end": "01:42:18.160",
      "text": "امممم"
    },
    {
      "id": 26,
      "start": 6138.16,
      "end": 6139.16,
      "formatted_start": "01:42:18.160",
      "formatted_end": "01:42:19.160",
      "text": "کنید"
    },
    {
      "id": 27,
      "start": 6139.16,
      "end": 6164.16,
      "formatted_start": "01:42:19.160",
      "formatted_end": "01:42:44.160",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 6164.16,
      "end": 6166.16,
      "formatted_start": "01:42:44.160",
      "formatted_end": "01:42:46.160",
      "text": "بسم الله الرحمن الرحیم"
    },
    {
      "id": 29,
      "start": 6166.16,
      "end": 6168.16,
      "formatted_start": "01:42:46.160",
      "formatted_end": "01:42:48.160",
      "text": "این روز ها سوال موجه که"
    },
    {
      "id": 30,
      "start": 6168.16,
      "end": 6170.16,
      "formatted_start": "01:42:48.160",
      "formatted_end": "01:42:50.160",
      "text": "آیا مزاکرات ایران امریکا"
    },
    {
      "id": 31,
      "start": 6170.16,
      "end": 6173.16,
      "formatted_start": "01:42:50.160",
      "formatted_end": "01:42:53.160",
      "text": "همون جبه پایان جنگ خواهد شده نداره؟"
    },
    {
      "id": 32,
      "start": 6173.16,
      "end": 6175.16,
      "formatted_start": "01:42:53.160",
      "formatted_end": "01:42:55.160",
      "text": "به طور قادر..."
    },
    {
      "id": 33,
      "start": 6175.16,
      "end": 6179.16,
      "formatted_start": "01:42:55.160",
      "formatted_end": "01:42:59.160",
      "text": "میخوانی بفرد که این پنج رو پیج رو بچکره کنه؟"
    },
    {
      "id": 34,
      "start": 6181.16,
      "end": 6183.16,
      "formatted_start": "01:43:01.160",
      "formatted_end": "01:43:03.160",
      "text": "میخوانی بفرد؟"
    },
    {
      "id": 35,
      "start": 6183.16,
      "end": 6186.16,
      "formatted_start": "01:43:03.160",
      "formatted_end": "01:43:06.160",
      "text": "من پدرم چهار ماه اکیش باز کردم"
    },
    {
      "id": 36,
      "start": 6186.16,
      "end": 6188.16,
      "formatted_start": "01:43:06.160",
      "formatted_end": "01:43:08.160",
      "text": "و قبل از پیزت"
    },
    {
      "id": 37,
      "start": 6188.16,
      "end": 6191.16,
      "formatted_start": "01:43:08.160",
      "formatted_end": "01:43:11.160",
      "text": "خیلی اصرار داشتم به ما که یه انالی هست"
    },
    {
      "id": 38,
      "start": 6191.16,
      "end": 6193.16,
      "formatted_start": "01:43:11.160",
      "formatted_end": "01:43:13.160",
      "text": "اسمه انال میدانه"
    },
    {
      "id": 39,
      "start": 6193.16,
      "end": 6197.8,
      "formatted_start": "01:43:13.160",
      "formatted_end": "01:43:17.800",
      "text": "پنج کاری که فقط آدم های ساده رو هنجام میدن"
    },
    {
      "id": 40,
      "start": 6197.8,
      "end": 6202.44,
      "formatted_start": "01:43:17.800",
      "formatted_end": "01:43:22.440",
      "text": "ماکی آیلی میگفت بیشتر من رو به روحتی قابل فرمید و کنترول هستم"
    },
    {
      "id": 41,
      "start": 6202.44,
      "end": 6205.84,
      "formatted_start": "01:43:22.440",
      "formatted_end": "01:43:25.840",
      "text": "من در اینش دقیقا همون پنج رفتم هستم"
    },
    {
      "id": 42,
      "start": 6205.84,
      "end": 6209.9,
      "formatted_start": "01:43:25.840",
      "formatted_end": "01:43:29.900",
      "text": "اول، هر چیزی را که به زمینشان میرسن به زمان میامن"
    },
    {
      "id": 43,
      "start": 6209.9,
      "end": 6213.56,
      "formatted_start": "01:43:29.900",
      "formatted_end": "01:43:33.560",
      "text": "نمیتوانم روازدار باشم دهانشان رو بسته بگهتن"
    },
    {
      "id": 44,
      "start": 6213.56,
      "end": 6215.74,
      "formatted_start": "01:43:33.560",
      "formatted_end": "01:43:35.740",
      "text": "ماکی آیلی گوشتی آمیداد"
    },
    {
      "id": 45,
      "start": 6215.74,
      "end": 6220.64,
      "formatted_start": "01:43:35.740",
      "formatted_end": "01:43:40.640",
      "text": "هر چه بیشتر حرف بزنید سلاقایی بیشتر به دست دشمنان نداریم"
    },
    {
      "id": 46,
      "start": 6220.64,
      "end": 6224.1,
      "formatted_start": "01:43:40.640",
      "formatted_end": "01:43:44.100",
      "text": "دوخون به همه اعتماد می کنند"
    },
    {
      "id": 47,
      "start": 6224.1,
      "end": 6226.16,
      "formatted_start": "01:43:44.100",
      "formatted_end": "01:43:46.160",
      "text": "به هر کسی که اطرافشان است"
    },
    {
      "id": 48,
      "start": 6226.16,
      "end": 6228.44,
      "formatted_start": "01:43:46.160",
      "formatted_end": "01:43:48.440",
      "text": "چرا اعتماد دارند؟"
    },
    {
      "id": 49,
      "start": 6228.44,
      "end": 6229.6,
      "formatted_start": "01:43:48.440",
      "formatted_end": "01:43:49.600",
      "text": "ماکیابلی می گفت"
    },
    {
      "id": 50,
      "start": 6250.64,
      "end": 6278.64,
      "formatted_start": "01:44:10.640",
      "formatted_end": "01:44:38.640",
      "text": "موسیقی"
    },
    {
      "id": 51,
      "start": 6280.64,
      "end": 6299.64,
      "formatted_start": "01:44:40.640",
      "formatted_end": "01:44:59.640",
