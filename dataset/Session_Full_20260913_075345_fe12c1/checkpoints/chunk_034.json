      "formatted_end": "02:50:02.000",
      "text": "مدرسه از اینجا باید برداری کنید."
    },
    {
      "id": 1,
      "start": 10202.0,
      "end": 10204.0,
      "formatted_start": "02:50:02.000",
      "formatted_end": "02:50:04.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 2,
      "start": 10204.0,
      "end": 10206.0,
      "formatted_start": "02:50:04.000",
      "formatted_end": "02:50:06.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 3,
      "start": 10206.0,
      "end": 10208.0,
      "formatted_start": "02:50:06.000",
      "formatted_end": "02:50:08.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 4,
      "start": 10208.0,
      "end": 10210.0,
      "formatted_start": "02:50:08.000",
      "formatted_end": "02:50:10.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 5,
      "start": 10210.0,
      "end": 10212.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:12.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 6,
      "start": 10212.0,
      "end": 10214.0,
      "formatted_start": "02:50:12.000",
      "formatted_end": "02:50:14.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 7,
      "start": 10214.0,
      "end": 10216.0,
      "formatted_start": "02:50:14.000",
      "formatted_end": "02:50:16.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 8,
      "start": 10216.0,
      "end": 10218.0,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:18.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 9,
      "start": 10218.0,
      "end": 10246.0,
      "formatted_start": "02:50:18.000",
      "formatted_end": "02:50:46.000",
      "text": "موسیقی"
    },
    {
      "id": 10,
      "start": 10248.0,
      "end": 10250.76,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:50.760",
      "text": "دا میپنه با خامر برادرها"
    },
    {
      "id": 11,
      "start": 10250.76,
      "end": 10253.1,
      "formatted_start": "02:50:50.760",
      "formatted_end": "02:50:53.100",
      "text": "بچه های من هم با هم دیگه خوب بشن"
    },
    {
      "id": 12,
      "start": 10253.1,
      "end": 10254.8,
      "formatted_start": "02:50:53.100",
      "formatted_end": "02:50:54.800",
      "text": "نه برونت برم"
    },
    {
      "id": 13,
      "start": 10254.8,
      "end": 10257.8,
      "formatted_start": "02:50:54.800",
      "formatted_end": "02:50:57.800",
      "text": "قبل دا یه نگاه به رفتارت بکن"
    },
    {
      "id": 14,
      "start": 10257.8,
      "end": 10260.66,
      "formatted_start": "02:50:57.800",
      "formatted_end": "02:51:00.660",
      "text": "یه نگاه به تصمیماتت بکن"
    },
    {
      "id": 15,
      "start": 10260.66,
      "end": 10264.2,
      "formatted_start": "02:51:00.660",
      "formatted_end": "02:51:04.200",
      "text": "اونجایی که بین خامر برادرها دخالت کردی"
    },
    {
      "id": 16,
      "start": 10264.2,
      "end": 10266.38,
      "formatted_start": "02:51:04.200",
      "formatted_end": "02:51:06.380",
      "text": "تقبه کسی و ندید گرفتی"
    },
    {
      "id": 17,
      "start": 10266.38,
      "end": 10268.42,
      "formatted_start": "02:51:06.380",
      "formatted_end": "02:51:08.420",
      "text": "و اون یکی بلندتر درست دادی"
    },
    {
      "id": 18,
      "start": 10268.42,
      "end": 10271.84,
      "formatted_start": "02:51:08.420",
      "formatted_end": "02:51:11.840",
      "text": "اونجایی هم از هم تبا کردی"
    },
    {
      "id": 19,
      "start": 10271.84,
      "end": 10273.3,
      "formatted_start": "02:51:11.840",
      "formatted_end": "02:51:13.300",
      "text": "آره برونت برم"
    },
    {
      "id": 20,
      "start": 10273.3,
      "end": 10274.94,
      "formatted_start": "02:51:13.300",
      "formatted_end": "02:51:14.940",
      "text": "آره جان من"
    },
    {
      "id": 21,
      "start": 10274.94,
      "end": 10276.5,
      "formatted_start": "02:51:14.940",
      "formatted_end": "02:51:16.500",
      "text": "اینجوریه"
    },
    {
      "id": 22,
      "start": 10276.5,
      "end": 10282.4,
      "formatted_start": "02:51:16.500",
      "formatted_end": "02:51:22.400",
      "text": "عزیز من بزرگتر همیشه رو باز تزبیل نمی گیره"
    },
    {
      "id": 23,
      "start": 10282.4,
      "end": 10284.92,
      "formatted_start": "02:51:22.400",
      "formatted_end": "02:51:24.920",
      "text": "همیشه حق با بزرگتر نیست"
    },
    {
      "id": 24,
      "start": 10284.92,
      "end": 10288.18,
      "formatted_start": "02:51:24.920",
      "formatted_end": "02:51:28.180",
      "text": "بزرگتران من مدد نمودم بزرگتری کنم"
    },
    {
      "id": 25,
      "start": 10288.18,
      "end": 10291.52,
      "formatted_start": "02:51:28.180",
      "formatted_end": "02:51:31.520",
      "text": "که بین خوار برادران اینقدر فاصله افتاده"
    },
    {
      "id": 26,
      "start": 10291.52,
      "end": 10295.1,
      "formatted_start": "02:51:31.520",
      "formatted_end": "02:51:35.100",
      "text": "پدر مادرهای عزیز من روی ماهتونو می بوسم"
    },
    {
      "id": 27,
      "start": 10295.1,
      "end": 10298.08,
      "formatted_start": "02:51:35.100",
      "formatted_end": "02:51:38.080",
      "text": "روی ماهتونو می بوسم"
    },
    {
      "id": 28,
      "start": 10298.08,
      "end": 10301.46,
      "formatted_start": "02:51:38.080",
      "formatted_end": "02:51:41.460",
      "text": "اگه یه تیکه تنها به جای افتاده باشه"
    },
    {
      "id": 29,
