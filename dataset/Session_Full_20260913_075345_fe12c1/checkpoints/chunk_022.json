      "start": 6795.24,
      "end": 6797.24,
      "formatted_start": "01:53:15.240",
      "formatted_end": "01:53:17.240",
      "text": "آزمایش رو ما نوشته بودیم"
    },
    {
      "id": 70,
      "start": 6797.24,
      "end": 6799.24,
      "formatted_start": "01:53:17.240",
      "formatted_end": "01:53:19.240",
      "text": "آره"
    },
    {
      "id": 71,
      "start": 6799.24,
      "end": 6801.24,
      "formatted_start": "01:53:19.240",
      "formatted_end": "01:53:21.240",
      "text": "بشکورتونو نوشته بودیم"
