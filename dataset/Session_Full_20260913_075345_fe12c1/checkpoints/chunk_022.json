  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6606.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:06.000",
      "text": "نتوجه نمیگنی، شاید هم خوب بشه به برون، ولی عوارض ذهنی میتونه، بچه ساله بشه."
    },
    {
      "id": 1,
      "start": 6606.0,
      "end": 6616.0,
      "formatted_start": "01:50:06.000",
      "formatted_end": "01:50:16.000",
      "text": "روش درست اینکه دستگاه بزنید، یا میبنید هزینه ندارید بگویید بیمارستان بسترش کنید، یا دستگاه رو ببرید کنید. راه اینه، برقیل بیراهه هست."
    },
    {
      "id": 2,
      "start": 6616.0,
      "end": 6623.0,
      "formatted_start": "01:50:16.000",
      "formatted_end": "01:50:23.000",
      "text": "چون کنید؟ سه به تورت، سه به تورت، دستگاه تا چند روی باید باشید؟"
    },
    {
      "id": 3,
      "start": 6623.0,
      "end": 6625.0,
      "formatted_start": "01:50:23.000",
      "formatted_end": "01:50:25.000",
      "text": "اینکه شنبه بذارید دیگه"
    },
    {
      "id": 4,
      "start": 6625.0,
      "end": 6628.0,
      "formatted_start": "01:50:25.000",
      "formatted_end": "01:50:28.000",
      "text": "حالا 3-4 روز که تطیل هست"
    },
    {
      "id": 5,
      "start": 6628.0,
      "end": 6631.0,
      "formatted_start": "01:50:28.000",
      "formatted_end": "01:50:31.000",
      "text": "فردا تا شنبه تطیله"
    },
    {
      "id": 6,
      "start": 6631.0,
      "end": 6633.0,
      "formatted_start": "01:50:31.000",
      "formatted_end": "01:50:33.000",
      "text": "میشه چند روز خواهید بذارید؟"
    },
    {
      "id": 7,
      "start": 6633.0,
      "end": 6635.0,
      "formatted_start": "01:50:33.000",
      "formatted_end": "01:50:35.000",
      "text": "یک روز، دو روز"
    },
    {
      "id": 8,
      "start": 6635.0,
      "end": 6639.0,
      "formatted_start": "01:50:35.000",
      "formatted_end": "01:50:39.000",
      "text": "میشه یه روز، دو روز، سه روز، چهار روز"
    },
    {
      "id": 9,
      "start": 6639.0,
      "end": 6642.0,
      "formatted_start": "01:50:39.000",
      "formatted_end": "01:50:42.000",
      "text": "چهار روز میشه، یک روزشو میگیم حساب نکنه"
    },
    {
      "id": 10,
      "start": 6642.0,
      "end": 6643.0,
      "formatted_start": "01:50:42.000",
      "formatted_end": "01:50:43.000",
      "text": "سه روز براتون هست"
    },
    {
      "id": 11,
      "start": 6643.0,
      "end": 6644.0,
      "formatted_start": "01:50:43.000",
      "formatted_end": "01:50:44.000",
      "text": "سه روز چه روز میشه؟"
    },
    {
      "id": 12,
      "start": 6644.0,
      "end": 6646.0,
      "formatted_start": "01:50:44.000",
      "formatted_end": "01:50:46.000",
      "text": "سه تا چهارصد کنه، سه روز بسیار"
    },
    {
      "id": 13,
      "start": 6646.0,
      "end": 6649.24,
      "formatted_start": "01:50:46.000",
      "formatted_end": "01:50:49.240",
      "text": "اینجا چهار تا چهارصد میشه، دیگه و شیستصد میشه، یه بودی نیست"
    },
    {
      "id": 14,
      "start": 6649.24,
      "end": 6657.24,
      "formatted_start": "01:50:49.240",
      "formatted_end": "01:50:57.240",
      "text": "دیگه اونو میخوایی پستری کنی، دستگاه بمونشی بگیم، یه دستگاه خوب بگرید، بعدش شروع کنیم"
    },
    {
      "id": 15,
      "start": 6657.24,
      "end": 6660.24,
      "formatted_start": "01:50:57.240",
      "formatted_end": "01:51:00.240",
      "text": "تا آزمایش هم اومد، جاوی شدید"
    },
    {
      "id": 16,
      "start": 6660.24,
      "end": 6665.24,
      "formatted_start": "01:51:00.240",
      "formatted_end": "01:51:05.240",
      "text": "۲۹ خیلی هست، ۲۹ هست، هفته دیگه، پنجه مالی هست"
    },
    {
      "id": 17,
      "start": 6665.24,
      "end": 6669.24,
      "formatted_start": "01:51:05.240",
      "formatted_end": "01:51:09.240",
      "text": "تا اون رو بچه دیگه نمیشه دیگه اشتاشه، سلطتر دراشت میداریم"
    },
    {
      "id": 18,
      "start": 6669.24,
      "end": 6671.24,
      "formatted_start": "01:51:09.240",
      "formatted_end": "01:51:11.240",
      "text": "اون دستگاه باید کنیم؟"
    },
    {
      "id": 19,
      "start": 6671.24,
      "end": 6673.7,
      "formatted_start": "01:51:11.240",
      "formatted_end": "01:51:13.700",
      "text": "بله اینجا دستگاه چیز کنید خوب استفاده کنید"
    },
    {
      "id": 20,
      "start": 6673.7,
      "end": 6677.24,
      "formatted_start": "01:51:13.700",
      "formatted_end": "01:51:17.240",
      "text": "کلیه چیزی دارید روشن کنید چون بچه گرم هوا"
    },
    {
      "id": 21,
      "start": 6677.24,
      "end": 6679.24,
      "formatted_start": "01:51:17.240",
      "formatted_end": "01:51:19.240",
      "text": "را زیر دستگاه خوب نخوابه"
    },
    {
      "id": 22,
      "start": 6679.24,
      "end": 6682.74,
      "formatted_start": "01:51:19.240",
      "formatted_end": "01:51:22.740",
      "text": "یه پرسی هم میگیرسم زیر دستگاه نصبشو بشه بده"
    },
    {
      "id": 23,
      "start": 6682.74,
      "end": 6684.24,
      "formatted_start": "01:51:22.740",
      "formatted_end": "01:51:24.240",
      "text": "هم آروم باشه هم"
    },
    {
      "id": 24,
      "start": 6686.24,
      "end": 6687.24,
      "formatted_start": "01:51:26.240",
      "formatted_end": "01:51:27.240",
      "text": "آمیلتون؟"
    },
    {
      "id": 25,
      "start": 6687.24,
      "end": 6688.24,
      "formatted_start": "01:51:27.240",
      "formatted_end": "01:51:28.240",
      "text": "آزرخش"
    },
    {
      "id": 26,
      "start": 6692.74,
      "end": 6694.74,
      "formatted_start": "01:51:32.740",
      "formatted_end": "01:51:34.740",
      "text": "از این روشن به حساب کنم مشکل نداریم"
    },
    {
      "id": 27,
      "start": 6694.74,
      "end": 6697.24,
      "formatted_start": "01:51:34.740",
      "formatted_end": "01:51:37.240",
      "text": "یه مقررش حالا حساب کنید و اقیلش هم به حساب"
    },
    {
      "id": 28,
      "start": 6697.24,
      "end": 6699.24,
      "formatted_start": "01:51:37.240",
      "formatted_end": "01:51:39.240",
      "text": "اینکی نداریم با خودمون"
    },
    {
      "id": 29,
      "start": 6699.24,
      "end": 6701.24,
      "formatted_start": "01:51:39.240",
      "formatted_end": "01:51:41.240",
      "text": "باشی"
    },
    {
      "id": 30,
      "start": 6701.24,
      "end": 6703.24,
      "formatted_start": "01:51:41.240",
      "formatted_end": "01:51:43.240",
      "text": "بیاییم، میخدمش بگیم"
    },
    {
      "id": 31,
      "start": 6703.24,
      "end": 6705.24,
      "formatted_start": "01:51:43.240",
      "formatted_end": "01:51:45.240",
      "text": "خداحافظ"
    },
    {
      "id": 32,
      "start": 6705.24,
      "end": 6707.24,
      "formatted_start": "01:51:45.240",
      "formatted_end": "01:51:47.240",
      "text": "این روشتش صبح و شب"
    },
    {
      "id": 33,
      "start": 6707.24,
      "end": 6709.24,
      "formatted_start": "01:51:47.240",
      "formatted_end": "01:51:49.240",
      "text": "صبح و شب یک نصف پونی تو آب بشه"
    },
    {
      "id": 34,
      "start": 6709.24,
      "end": 6711.24,
      "formatted_start": "01:51:49.240",
      "formatted_end": "01:51:51.240",
      "text": "بشه"
    },
    {
      "id": 35,
      "start": 6711.24,
      "end": 6713.24,
      "formatted_start": "01:51:51.240",
      "formatted_end": "01:51:53.240",
      "text": "خداحافظ"
    },
    {
      "id": 36,
      "start": 6717.24,
      "end": 6719.24,
      "formatted_start": "01:51:57.240",
      "formatted_end": "01:51:59.240",
      "text": "سلام"
    },
    {
      "id": 37,
      "start": 6719.24,
      "end": 6721.24,
      "formatted_start": "01:51:59.240",
      "formatted_end": "01:52:01.240",
      "text": "این آزمایش رو بسر بین"
    },
    {
      "id": 38,
      "start": 6721.24,
      "end": 6723.24,
      "formatted_start": "01:52:01.240",
      "formatted_end": "01:52:03.240",
      "text": "آزمایش چی بوده؟"
    },
    {
      "id": 39,
      "start": 6723.24,
      "end": 6725.24,
      "formatted_start": "01:52:03.240",
      "formatted_end": "01:52:05.240",
      "text": "اینو ترئیز بوده بکنن"
    },
    {
      "id": 40,
      "start": 6725.24,
      "end": 6727.24,
      "formatted_start": "01:52:05.240",
      "formatted_end": "01:52:07.240",
      "text": "برای من"
    },
    {
      "id": 41,
      "start": 6730.74,
      "end": 6731.74,
      "formatted_start": "01:52:10.740",
      "formatted_end": "01:52:11.740",
      "text": "کنم پدر؟"
    },
    {
      "id": 42,
      "start": 6731.74,
      "end": 6732.74,
      "formatted_start": "01:52:11.740",
      "formatted_end": "01:52:12.740",
      "text": "نه"
    },
    {
      "id": 43,
      "start": 6733.24,
      "end": 6734.74,
      "formatted_start": "01:52:13.240",
      "formatted_end": "01:52:14.740",
      "text": "الان پدر شما این؟"
    },
    {
      "id": 44,
      "start": 6734.74,
      "end": 6735.74,
      "formatted_start": "01:52:14.740",
      "formatted_end": "01:52:15.740",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 6735.74,
      "end": 6736.74,
      "formatted_start": "01:52:15.740",
      "formatted_end": "01:52:16.740",
      "text": "کیه؟"
    },
    {
      "id": 46,
      "start": 6736.74,
      "end": 6737.74,
      "formatted_start": "01:52:16.740",
      "formatted_end": "01:52:17.740",
      "text": "برادر"
    },
    {
      "id": 47,
      "start": 6737.74,
      "end": 6738.74,
      "formatted_start": "01:52:17.740",
      "formatted_end": "01:52:18.740",
      "text": "برادرته؟"
    },
    {
      "id": 48,
      "start": 6738.74,
      "end": 6739.74,
      "formatted_start": "01:52:18.740",
      "formatted_end": "01:52:19.740",
      "text": "نه"
    },
    {
      "id": 49,
      "start": 6742.74,
      "end": 6745.24,
      "formatted_start": "01:52:22.740",
      "formatted_end": "01:52:25.240",
      "text": "خوابش بگو خورسش یه روز درمیان رده"
    },
    {
      "id": 50,
      "start": 6745.24,
      "end": 6747.24,
      "formatted_start": "01:52:25.240",
      "formatted_end": "01:52:27.240",
      "text": "و 20 روز دیگه آزمایشی تکرار بشه"
    },
    {
      "id": 51,
      "start": 6747.24,
      "end": 6748.24,
      "formatted_start": "01:52:27.240",
      "formatted_end": "01:52:28.240",
      "text": "20 روز دیگه روه؟"
    },
    {
      "id": 52,
      "start": 6748.24,
      "end": 6749.24,
      "formatted_start": "01:52:28.240",
      "formatted_end": "01:52:29.240",
      "text": "برای آره"
    },
    {
      "id": 53,
      "start": 6749.24,
      "end": 6751.24,
      "formatted_start": "01:52:29.240",
      "formatted_end": "01:52:31.240",
      "text": "اما خورس باید براش بگیرم یا نه؟"
    },
    {
      "id": 54,
      "start": 6751.74,
      "end": 6753.24,
      "formatted_start": "01:52:31.740",
      "formatted_end": "01:52:33.240",
      "text": "دیگه اگه نداره بگیر دیگه"
    },
