      "start": 6753.24,
      "end": 6755.24,
      "formatted_start": "01:52:33.240",
      "formatted_end": "01:52:35.240",
      "text": "برسه نباشه"
    },
    {
      "id": 56,
      "start": 6755.24,
      "end": 6757.24,
      "formatted_start": "01:52:35.240",
      "formatted_end": "01:52:37.240",
      "text": "برسه میشه به این قسم"
    },
    {
      "id": 57,
      "start": 6757.24,
      "end": 6760.24,
      "formatted_start": "01:52:37.240",
      "formatted_end": "01:52:40.240",
      "text": "یه روز درمیانه رو"
    },
    {
      "id": 58,
      "start": 6760.24,
      "end": 6767.24,
      "formatted_start": "01:52:40.240",
      "formatted_end": "01:52:47.240",
      "text": "اونو یه روز درمیانه نصفه بدم"
    },
    {
