      "end": 8180.74,
      "formatted_start": "02:16:17.000",
      "formatted_end": "02:16:20.740",
      "text": "یعنی شما کلر بزنید رو بیست هشت درجه بزنید"
    },
    {
      "id": 24,
      "start": 8180.74,
      "end": 8183.42,
      "formatted_start": "02:16:20.740",
      "formatted_end": "02:16:23.420",
      "text": "بچه لفت مادر زن هم باشه هیچی نمیشه"
    },
    {
      "id": 25,
      "start": 8183.42,
      "end": 8186.42,
      "formatted_start": "02:16:23.420",
      "formatted_end": "02:16:26.420",
      "text": "بچه مثل بله اگه جاش خیلی گرم باشه"
    },
    {
      "id": 26,
      "start": 8186.42,
      "end": 8187.1,
      "formatted_start": "02:16:26.420",
      "formatted_end": "02:16:27.100",
      "text": "یا سرد باشه"
    },
    {
      "id": 27,
      "start": 8187.1,
      "end": 8187.64,
      "formatted_start": "02:16:27.100",
      "formatted_end": "02:16:27.640",
      "text": "نه نه"
    },
    {
      "id": 28,
      "start": 8187.64,
      "end": 8192.02,
      "formatted_start": "02:16:27.640",
      "formatted_end": "02:16:32.020",
      "text": "حالا من دارم این که راحت تر بگیرید"
    },
    {
      "id": 29,
      "start": 8192.02,
      "end": 8194.48,
      "formatted_start": "02:16:32.020",
      "formatted_end": "02:16:34.480",
      "text": "چون خودتو بکشید بیست هشت درجه"
    },
    {
      "id": 30,
      "start": 8194.48,
      "end": 8196.56,
      "formatted_start": "02:16:34.480",
      "formatted_end": "02:16:36.560",
      "text": "حالا حالا این فکرمتواش بردارید"
    },
    {
      "id": 31,
      "start": 8196.56,
      "end": 8199.14,
      "formatted_start": "02:16:36.560",
      "formatted_end": "02:16:39.140",
      "text": "بسیار باید گیرده"
    },
    {
      "id": 32,
      "start": 8199.14,
      "end": 8201.22,
      "formatted_start": "02:16:39.140",
      "formatted_end": "02:16:41.220",
      "text": "سرده متعدد هم باید گیرده"
    },
    {
      "id": 33,
      "start": 8201.22,
      "end": 8202.48,
      "formatted_start": "02:16:41.220",
      "formatted_end": "02:16:42.480",
      "text": "بیست هشت درجه بیده"
    },
    {
      "id": 34,
      "start": 8202.48,
      "end": 8204.48,
      "formatted_start": "02:16:42.480",
      "formatted_end": "02:16:44.480",
      "text": "چی شده باید؟ زرده؟"
    },
    {
      "id": 35,
      "start": 8204.48,
      "end": 8206.48,
      "formatted_start": "02:16:44.480",
      "formatted_end": "02:16:46.480",
      "text": "اینکه ها بردن نشون برد"
    },
    {
      "id": 36,
      "start": 8206.48,
      "end": 8207.48,
      "formatted_start": "02:16:46.480",
      "formatted_end": "02:16:47.480",
      "text": "بردن زرده؟"
    },
    {
      "id": 37,
      "start": 8207.48,
      "end": 8208.48,
      "formatted_start": "02:16:47.480",
      "formatted_end": "02:16:48.480",
      "text": "آره"
    },
    {
      "id": 38,
      "start": 8208.48,
      "end": 8209.48,
      "formatted_start": "02:16:48.480",
      "formatted_end": "02:16:49.480",
      "text": "حالا بدن شما هم آیه نداره"
    },
    {
      "id": 39,
