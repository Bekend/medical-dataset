    {
      "id": 44,
      "start": 8215.48,
      "end": 8216.48,
      "formatted_start": "02:16:55.480",
      "formatted_end": "02:16:56.480",
      "text": "به"
    },
    {
      "id": 45,
      "start": 8216.48,
      "end": 8217.48,
      "formatted_start": "02:16:56.480",
      "formatted_end": "02:16:57.480",
      "text": "چه؟"
    },
    {
      "id": 46,
      "start": 8217.48,
      "end": 8218.48,
      "formatted_start": "02:16:57.480",
      "formatted_end": "02:16:58.480",
      "text": "آی یا به؟"
    },
    {
      "id": 47,
      "start": 8218.48,
      "end": 8219.48,
      "formatted_start": "02:16:58.480",
      "formatted_end": "02:16:59.480",
      "text": "آی"
    },
    {
      "id": 48,
      "start": 8219.48,
      "end": 8222.48,
      "formatted_start": "02:16:59.480",
      "formatted_end": "02:17:02.480",
      "text": "فرق ندار، اگه خیلی او باشه گروخونی ها با هم نیمونتاره"
    },
    {
      "id": 49,
      "start": 8222.48,
      "end": 8223.48,
      "formatted_start": "02:17:02.480",
      "formatted_end": "02:17:03.480",
      "text": "نه، به"
    },
    {
      "id": 50,
      "start": 8223.48,
      "end": 8224.48,
      "formatted_start": "02:17:03.480",
      "formatted_end": "02:17:04.480",
      "text": "به؟"
    },
    {
      "id": 51,
      "start": 8224.48,
      "end": 8225.48,
      "formatted_start": "02:17:04.480",
      "formatted_end": "02:17:05.480",
      "text": "نه، همساز نیست"
    },
    {
      "id": 52,
      "start": 8225.48,
      "end": 8226.48,
      "formatted_start": "02:17:05.480",
      "formatted_end": "02:17:06.480",
      "text": "نوشته"
    },
    {
      "id": 53,
      "start": 8226.48,
      "end": 8228.48,
      "formatted_start": "02:17:06.480",
      "formatted_end": "02:17:08.480",
      "text": "حالا بردن شرح زردی میشه"
    },
    {
      "id": 54,
      "start": 8232.48,
      "end": 8237.48,
      "formatted_start": "02:17:12.480",
      "formatted_end": "02:17:17.480",
      "text": "اینکه شکمشن موقعی که رسان چیز میکنه قلن چنده آره"
    },
    {
      "id": 55,
      "start": 8237.48,
      "end": 8238.48,
      "formatted_start": "02:17:17.480",
      "formatted_end": "02:17:18.480",
      "text": "نفت داره"
    },
    {
      "id": 56,
      "start": 8238.48,
      "end": 8239.48,
      "formatted_start": "02:17:18.480",
      "formatted_end": "02:17:19.480",
      "text": "نره"
    },
    {
      "id": 57,
      "start": 8239.48,
      "end": 8241.48,
      "formatted_start": "02:17:19.480",
      "formatted_end": "02:17:21.480",
      "text": "این بدنش هم زرده"
    },
    {
      "id": 58,
      "start": 8241.48,
      "end": 8242.48,
      "formatted_start": "02:17:21.480",
      "formatted_end": "02:17:22.480",
      "text": "خوب"
    },
    {
      "id": 59,
      "start": 8242.48,
      "end": 8247.48,
      "formatted_start": "02:17:22.480",
      "formatted_end": "02:17:27.480",
      "text": "ولی هنوز خیلی شدید نشده خب"
    },
    {
      "id": 60,
      "start": 8247.48,
      "end": 8251.48,
      "formatted_start": "02:17:27.480",
      "formatted_end": "02:17:31.480",
      "text": "خوب"
    },
    {
      "id": 61,
      "start": 8251.48,
      "end": 8253.48,
      "formatted_start": "02:17:31.480",
      "formatted_end": "02:17:33.480",
      "text": "خیلی شدید نشده"
    },
    {
      "id": 62,
      "start": 8253.48,
      "end": 8255.48,
      "formatted_start": "02:17:33.480",
      "formatted_end": "02:17:35.480",
      "text": "مرگ در اینجا باید بردارید."
    },
    {
      "id": 63,
      "start": 8255.48,
      "end": 8257.48,
      "formatted_start": "02:17:35.480",
      "formatted_end": "02:17:37.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 64,
      "start": 8257.48,
      "end": 8259.48,
      "formatted_start": "02:17:37.480",
      "formatted_end": "02:17:39.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 65,
      "start": 8259.48,
      "end": 8261.48,
      "formatted_start": "02:17:39.480",
      "formatted_end": "02:17:41.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 66,
      "start": 8261.48,
      "end": 8263.48,
      "formatted_start": "02:17:41.480",
      "formatted_end": "02:17:43.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 67,
      "start": 8263.48,
      "end": 8265.48,
      "formatted_start": "02:17:43.480",
      "formatted_end": "02:17:45.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 68,
      "start": 8265.48,
      "end": 8267.48,
      "formatted_start": "02:17:45.480",
      "formatted_end": "02:17:47.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 69,
      "start": 8267.48,
      "end": 8269.48,
      "formatted_start": "02:17:47.480",
      "formatted_end": "02:17:49.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 70,
      "start": 8269.48,
      "end": 8271.48,
      "formatted_start": "02:17:49.480",
      "formatted_end": "02:17:51.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 71,
      "start": 8271.48,
      "end": 8273.48,
      "formatted_start": "02:17:51.480",
      "formatted_end": "02:17:53.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 72,
      "start": 8273.48,
      "end": 8275.48,
      "formatted_start": "02:17:53.480",
      "formatted_end": "02:17:55.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 73,
      "start": 8275.48,
      "end": 8277.48,
      "formatted_start": "02:17:55.480",
      "formatted_end": "02:17:57.480",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 74,
      "start": 8277.48,
      "end": 8279.48,
      "formatted_start": "02:17:57.480",
      "formatted_end": "02:17:59.480",
      "text": "مدفوع می کنی؟"
    },
    {
      "id": 75,
      "start": 8279.48,
      "end": 8281.48,
      "formatted_start": "02:17:59.480",
      "formatted_end": "02:18:01.480",
      "text": "آره"
    },
    {
      "id": 76,
      "start": 8301.48,
      "end": 8303.48,
      "formatted_start": "02:18:21.480",
      "formatted_end": "02:18:23.480",
      "text": "وضعیت کنونیش خوبه"
    },
    {
      "id": 77,
      "start": 8303.48,
      "end": 8311.48,
      "formatted_start": "02:18:23.480",
      "formatted_end": "02:18:31.480",
      "text": "خوب قلب و تنفس این ها اندام ها ولی یه ضردی تقریباً متوسطی داره"
    },
    {
      "id": 78,
      "start": 8311.48,
      "end": 8313.48,
      "formatted_start": "02:18:31.480",
      "formatted_end": "02:18:33.480",
      "text": "کم امنی شدید انوزه"
    },
    {
      "id": 79,
      "start": 8313.48,
      "end": 8315.48,
      "formatted_start": "02:18:33.480",
      "formatted_end": "02:18:35.480",
      "text": "حتی بچه سه روزه همین روز تازه بسیار"
    },
    {
      "id": 80,
      "start": 8315.48,
      "end": 8319.48,
      "formatted_start": "02:18:35.480",
      "formatted_end": "02:18:39.480",
      "text": "روزهای چهار و پنجام به بعد شروع میشه و هیچ شدید پر میشه"
    },
    {
      "id": 81,
      "start": 8319.48,
      "end": 8323.48,
      "formatted_start": "02:18:39.480",
      "formatted_end": "02:18:43.480",
      "text": "ولی چون اوه مادرش یه میدار زودتر شده"
    },
    {
      "id": 82,
      "start": 8323.48,
      "end": 8327.48,
      "formatted_start": "02:18:43.480",
      "formatted_end": "02:18:47.480",
      "text": "اینو آیه سارانیه چون سه روزم پتیده"
    },
    {
      "id": 83,
      "start": 8327.48,
      "end": 8330.48,
      "formatted_start": "02:18:47.480",
      "formatted_end": "02:18:50.480",
      "text": "با تجربه اوه بودن بروخانی مادر انوزه"
    },
    {
      "id": 84,
      "start": 8330.48,
      "end": 8332.48,
      "formatted_start": "02:18:50.480",
      "formatted_end": "02:18:52.480",
      "text": "بیتر از الان دستگاه بذارید"
    },
    {
      "id": 85,
      "start": 8332.48,
      "end": 8333.48,
      "formatted_start": "02:18:52.480",
      "formatted_end": "02:18:53.480",
      "text": "الان؟"
    },
    {
      "id": 86,
      "start": 8333.48,
      "end": 8335.48,
      "formatted_start": "02:18:53.480",
      "formatted_end": "02:18:55.480",
      "text": "آره یعنی شدیدتر میشه یه زیاد میشه"
    },
    {
      "id": 87,
      "start": 8335.48,
      "end": 8337.48,
      "formatted_start": "02:18:55.480",
      "formatted_end": "02:18:57.480",
      "text": "الان صرف یکی دور زیاد"
    },
    {
      "id": 88,
      "start": 8337.48,
      "end": 8339.48,
      "formatted_start": "02:18:57.480",
      "formatted_end": "02:18:59.480",
      "text": "الان خودتون احساس کنید"
    },
    {
      "id": 89,
      "start": 8339.48,
      "end": 8340.48,
      "formatted_start": "02:18:59.480",
      "formatted_end": "02:19:00.480",
      "text": "آره نه"
    },
    {
      "id": 90,
      "start": 8340.48,
      "end": 8342.48,
      "formatted_start": "02:19:00.480",
      "formatted_end": "02:19:02.480",
      "text": "یه چند شب دستگاه از موشنی بگیرید"
    },
    {
      "id": 91,
      "start": 8342.48,
      "end": 8344.48,
      "formatted_start": "02:19:02.480",
      "formatted_end": "02:19:04.480",
      "text": "ببرید کنه خب"
    },
    {
      "id": 92,
      "start": 8344.48,
      "end": 8345.48,
      "formatted_start": "02:19:04.480",
      "formatted_end": "02:19:05.480",
      "text": "چند تا که؟"
    },
    {
      "id": 93,
      "start": 8345.48,
      "end": 8346.48,
      "formatted_start": "02:19:05.480",
      "formatted_end": "02:19:06.480",
      "text": "تا شمبه دیگه"
    },
    {
      "id": 94,
      "start": 8346.48,
      "end": 8349.48,
      "formatted_start": "02:19:06.480",
      "formatted_end": "02:19:09.480",
      "text": "این درسته روزم همه تطبیرات خوردیم"
    },
    {
      "id": 95,
      "start": 8349.48,
      "end": 8350.48,
      "formatted_start": "02:19:09.480",
      "formatted_end": "02:19:10.480",
      "text": "خب"
    },
    {
      "id": 96,
      "start": 8350.48,
      "end": 8352.48,
      "formatted_start": "02:19:10.480",
      "formatted_end": "02:19:12.480",
      "text": "و این دستا شدید؟"
    },
    {
      "id": 97,
      "start": 8352.48,
      "end": 8354.48,
      "formatted_start": "02:19:12.480",
      "formatted_end": "02:19:14.480",
      "text": "این بیشتر چهار سهته چهار سهت کنید"
    },
    {
      "id": 98,
      "start": 8354.48,
      "end": 8356.48,
      "formatted_start": "02:19:14.480",
      "formatted_end": "02:19:16.480",
      "text": "چهار سهت؟"
    },
    {
      "id": 99,
      "start": 8356.48,
      "end": 8358.48,
      "formatted_start": "02:19:16.480",
      "formatted_end": "02:19:18.480",
      "text": "ببین این میشه چهار شب"
    },
    {
      "id": 100,
      "start": 8358.48,
      "end": 8360.48,
      "formatted_start": "02:19:18.480",
      "formatted_end": "02:19:20.480",
      "text": "هزینه سیار میشه شاید"
    },
    {
      "id": 101,
      "start": 8360.48,
      "end": 8363.48,
      "formatted_start": "02:19:20.480",
      "formatted_end": "02:19:23.480",
      "text": "یه شب شما کمی کنیم برای تون که راحتت باشید"
    },
    {
      "id": 102,
      "start": 8363.48,
      "end": 8365.48,
      "formatted_start": "02:19:23.480",
      "formatted_end": "02:19:25.480",
      "text": "سه شب شو هزینه استفاده بگیریم"
    },
    {
      "id": 103,
      "start": 8365.48,
      "end": 8368.48,
      "formatted_start": "02:19:25.480",
      "formatted_end": "02:19:28.480",
      "text": "چهار شب استفادیمو و این چهار شبو بگذاریم"
    },
    {
      "id": 104,
      "start": 8368.48,
      "end": 8370.48,
      "formatted_start": "02:19:28.480",
      "formatted_end": "02:19:30.480",
      "text": "مثلا نگید سفید شده نمیخواد"
    },
    {
      "id": 105,
      "start": 8370.48,
      "end": 8371.48,
      "formatted_start": "02:19:30.480",
      "formatted_end": "02:19:31.480",
      "text": "نه"
    },
    {
      "id": 106,
      "start": 8371.48,
      "end": 8374.48,
      "formatted_start": "02:19:31.480",
      "formatted_end": "02:19:34.480",
      "text": "ببین اول پوست خوب میشه اون که بدن زرده"
    },
    {
      "id": 107,
      "start": 8374.48,
      "end": 8376.48,
      "formatted_start": "02:19:34.480",
      "formatted_end": "02:19:36.480",
      "text": "شما گل پوست رو نخورید"
    },
    {
      "id": 108,
      "start": 8376.48,
      "end": 8377.48,
      "formatted_start": "02:19:36.480",
      "formatted_end": "02:19:37.480",
      "text": "نه"
    },
    {
      "id": 109,
      "start": 8377.48,
      "end": 8378.48,
      "formatted_start": "02:19:37.480",
      "formatted_end": "02:19:38.480",
      "text": "پامیره تون؟"
    },
    {
      "id": 110,
      "start": 8378.48,
      "end": 8379.48,
      "formatted_start": "02:19:38.480",
      "formatted_end": "02:19:39.480",
      "text": "سارانیه"
    },
    {
      "id": 111,
      "start": 8379.48,
      "end": 8380.48,
      "formatted_start": "02:19:39.480",
      "formatted_end": "02:19:40.480",
      "text": "های سارانیه"
    },
    {
      "id": 112,
      "start": 8380.48,
      "end": 8383.2,
      "formatted_start": "02:19:40.480",
      "formatted_end": "02:19:43.200",
      "text": "این کورس هم از دارو خانه دیده دستگاه هم بمونی شید"
    },
    {
      "id": 113,
      "start": 8383.2,
      "end": 8384.36,
      "formatted_start": "02:19:43.200",
      "formatted_end": "02:19:44.360",
      "text": "مادر نفخشی"
    },
    {
      "id": 114,
      "start": 8384.36,
      "end": 8386.36,
      "formatted_start": "02:19:44.360",
      "formatted_end": "02:19:46.360",
      "text": "نفخش هم یه شربت میدیسن"
    },
    {
      "id": 115,
      "start": 8386.36,
      "end": 8389.24,
      "formatted_start": "02:19:46.360",
      "formatted_end": "02:19:49.240",
      "text": "نفخش هم بمونی سید"
    },
    {
      "id": 116,
      "start": 8389.24,
      "end": 8391.7,
      "formatted_start": "02:19:49.240",
      "formatted_end": "02:19:51.700",
      "text": "شربت اهورانینی"
    },
    {
      "id": 117,
      "start": 8391.7,
      "end": 8396.1,
      "formatted_start": "02:19:51.700",
      "formatted_end": "02:19:56.100",
      "text": "هر هشت سال مرحبا خورید"
    },
    {
      "id": 118,
      "start": 8396.1,
      "end": 8398.06,
      "formatted_start": "02:19:56.100",
      "formatted_end": "02:19:58.060",
      "text": "مادرش خوبوبات اینا هم نفخ بود"
    },
    {
      "id": 119,
      "start": 8398.06,
      "end": 8398.62,
      "formatted_start": "02:19:58.060",
      "formatted_end": "02:19:58.620",
      "text": "باش"
    }
  ],
  "status": "completed"
}