  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6306.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:06.000",
      "text": "چون اتفاق در صورت اینم داشته باشه، آنکنی را براش میدید."
    },
    {
      "id": 1,
      "start": 6306.0,
      "end": 6309.0,
      "formatted_start": "01:45:06.000",
      "formatted_end": "01:45:09.000",
      "text": "آنکنی خوب نمیدونید."
    },
    {
      "id": 2,
      "start": 6309.0,
      "end": 6311.0,
      "formatted_start": "01:45:09.000",
      "formatted_end": "01:45:11.000",
      "text": "نه، تا شگه همش کار نداریم."
    },
    {
      "id": 3,
      "start": 6311.0,
      "end": 6312.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:12.000",
      "text": "آقای مسکودي، آره؟"
    },
    {
      "id": 4,
      "start": 6312.0,
      "end": 6315.0,
      "formatted_start": "01:45:12.000",
      "formatted_end": "01:45:15.000",
      "text": "چکرم اون صورت افغانتی کار کرده تو کنم، نه؟"
    },
    {
      "id": 5,
      "start": 6315.0,
      "end": 6316.0,
      "formatted_start": "01:45:15.000",
      "formatted_end": "01:45:16.000",
      "text": "چجوری؟"
    },
    {
      "id": 6,
      "start": 6316.0,
      "end": 6322.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:22.000",
      "text": "این صورت عفونت داشته باشه، خیلی کم کار کرده بود."
    },
    {
      "id": 7,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "به کار نگرده بود."
    },
    {
      "id": 8,
      "start": 6324.0,
      "end": 6329.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:29.000",
      "text": "خب، اینو ببینید سبت کنند، بمانشیم، درخانه برید."
    },
    {
      "id": 9,
      "start": 6329.0,
      "end": 6331.0,
      "formatted_start": "01:45:29.000",
      "formatted_end": "01:45:31.000",
      "text": "چطوره؟"
    },
    {
      "id": 10,
      "start": 6331.0,
      "end": 6333.0,
      "formatted_start": "01:45:31.000",
      "formatted_end": "01:45:33.000",
      "text": "هفت ماهش دیگره"
    },
    {
      "id": 11,
      "start": 6333.0,
      "end": 6335.0,
      "formatted_start": "01:45:33.000",
      "formatted_end": "01:45:35.000",
      "text": "هفت ماهش دیگره"
    },
    {
      "id": 12,
      "start": 6335.0,
      "end": 6337.0,
      "formatted_start": "01:45:35.000",
      "formatted_end": "01:45:37.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 6337.0,
      "end": 6339.0,
      "formatted_start": "01:45:37.000",
      "formatted_end": "01:45:39.000",
      "text": "موقع تولدش چند کیلو بوده؟"
    },
    {
      "id": 14,
      "start": 6339.0,
      "end": 6341.0,
      "formatted_start": "01:45:39.000",
      "formatted_end": "01:45:41.000",
      "text": "دو و شهستده"
    },
    {
      "id": 15,
      "start": 6341.0,
      "end": 6343.0,
      "formatted_start": "01:45:41.000",
      "formatted_end": "01:45:43.000",
      "text": "دو و شهستده باشه"
    },
    {
      "id": 16,
      "start": 6343.0,
      "end": 6345.0,
      "formatted_start": "01:45:43.000",
      "formatted_end": "01:45:45.000",
      "text": "پنج شویدی شیش کیلو باشه خوبه"
    },
    {
      "id": 17,
      "start": 6345.0,
      "end": 6347.0,
      "formatted_start": "01:45:45.000",
      "formatted_end": "01:45:47.000",
      "text": "یا با شیش کیلو نیم بود"
    },
    {
      "id": 18,
      "start": 6347.0,
      "end": 6349.0,
      "formatted_start": "01:45:47.000",
      "formatted_end": "01:45:49.000",
      "text": "یک ماه پیش شیش کیلو نیم بود"
    },
    {
      "id": 19,
      "start": 6349.0,
      "end": 6351.0,
      "formatted_start": "01:45:49.000",
      "formatted_end": "01:45:51.000",
      "text": "موقع تولدش هم کم بوده"
    },
    {
      "id": 20,
      "start": 6351.0,
      "end": 6353.0,
      "formatted_start": "01:45:51.000",
      "formatted_end": "01:45:53.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 6353.0,
      "end": 6355.0,
      "formatted_start": "01:45:53.000",
      "formatted_end": "01:45:55.000",
      "text": "بعد که شش ماهی باشه"
    },
    {
      "id": 22,
      "start": 6355.0,
      "end": 6357.0,
      "formatted_start": "01:45:55.000",
      "formatted_end": "01:45:57.000",
      "text": "اگر بچه که سه کیلو باشه"
    },
    {
      "id": 23,
      "start": 6357.0,
      "end": 6359.0,
      "formatted_start": "01:45:57.000",
      "formatted_end": "01:45:59.000",
      "text": "این چیز 6 کلونی بود"
    },
    {
      "id": 24,
      "start": 6359.0,
      "end": 6361.0,
      "formatted_start": "01:45:59.000",
      "formatted_end": "01:46:01.000",
      "text": "یادم تو هفت ماه 6 کلونی بودی یه ماه قبل"
    },
    {
      "id": 25,
      "start": 6361.0,
      "end": 6363.0,
      "formatted_start": "01:46:01.000",
      "formatted_end": "01:46:03.000",
      "text": "نه وزنش خوبه"
    },
    {
      "id": 26,
      "start": 6363.0,
      "end": 6365.0,
      "formatted_start": "01:46:03.000",
      "formatted_end": "01:46:05.000",
      "text": "باش خدایی نمیخواد"
    },
    {
      "id": 27,
      "start": 6365.0,
      "end": 6367.0,
      "formatted_start": "01:46:05.000",
      "formatted_end": "01:46:07.000",
      "text": "از اینجا بیرون"
    },
    {
      "id": 28,
      "start": 6367.0,
      "end": 6369.0,
      "formatted_start": "01:46:07.000",
      "formatted_end": "01:46:09.000",
      "text": "بیرون همونجا"
    },
    {
      "id": 29,
      "start": 6369.0,
      "end": 6371.0,
      "formatted_start": "01:46:09.000",
      "formatted_end": "01:46:11.000",
      "text": "آقای مسعوده"
    },
    {
      "id": 30,
      "start": 6371.0,
      "end": 6373.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:13.000",
      "text": "شیاف دیکروپناک خونه داری؟"
    },
    {
      "id": 31,
      "start": 6373.0,
      "end": 6375.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:15.000",
      "text": "نه خونه 125 گره"
    },
    {
      "id": 32,
      "start": 6375.0,
      "end": 6377.0,
      "formatted_start": "01:46:15.000",
      "formatted_end": "01:46:17.000",
      "text": "دیکروپناک"
    },
    {
      "id": 33,
      "start": 6377.0,
      "end": 6379.0,
      "formatted_start": "01:46:17.000",
      "formatted_end": "01:46:19.000",
      "text": "تب رو کنترلو کنید"
    },
    {
      "id": 34,
      "start": 6379.0,
      "end": 6381.0,
      "formatted_start": "01:46:19.000",
      "formatted_end": "01:46:21.000",
      "text": "چون تب بالا خطر تشنج داره"
    },
    {
      "id": 35,
      "start": 6381.0,
      "end": 6383.0,
      "formatted_start": "01:46:21.000",
      "formatted_end": "01:46:23.000",
      "text": "تب 39 درجه"
    },
    {
      "id": 36,
      "start": 6383.0,
      "end": 6385.0,
      "formatted_start": "01:46:23.000",
      "formatted_end": "01:46:25.000",
      "text": "خطر خطر خطر"
    },
    {
      "id": 37,
      "start": 6385.0,
      "end": 6389.0,
      "formatted_start": "01:46:25.000",
      "formatted_end": "01:46:29.000",
      "text": "بیایی جان این چیافه آزاده این رو چیز کن"
    },
    {
      "id": 38,
      "start": 6389.0,
      "end": 6391.0,
      "formatted_start": "01:46:29.000",
      "formatted_end": "01:46:31.000",
      "text": "بسیار درده بیانه"
    },
    {
      "id": 39,
      "start": 6391.0,
      "end": 6393.0,
      "formatted_start": "01:46:31.000",
      "formatted_end": "01:46:33.000",
      "text": "خانسم این کود دور رو چیز کنی"
    },
    {
      "id": 40,
      "start": 6399.0,
      "end": 6400.0,
      "formatted_start": "01:46:39.000",
      "formatted_end": "01:46:40.000",
      "text": "بفهم"
    },
    {
      "id": 41,
      "start": 6400.0,
      "end": 6402.0,
      "formatted_start": "01:46:40.000",
      "formatted_end": "01:46:42.000",
      "text": "سلام بابای جان سلام"
    },
    {
      "id": 42,
      "start": 6402.0,
      "end": 6404.0,
      "formatted_start": "01:46:42.000",
      "formatted_end": "01:46:44.000",
      "text": "چرا رو تخفیزه؟ سلام"
    },
    {
      "id": 43,
      "start": 6404.0,
      "end": 6405.0,
      "formatted_start": "01:46:44.000",
      "formatted_end": "01:46:45.000",
      "text": "خوشحال میکنم"
    },
    {
      "id": 44,
      "start": 6405.0,
      "end": 6408.0,
      "formatted_start": "01:46:45.000",
      "formatted_end": "01:46:48.000",
      "text": "خوب چی شده خانم آزره؟"
    },
    {
      "id": 45,
      "start": 6408.0,
      "end": 6411.0,
      "formatted_start": "01:46:48.000",
      "formatted_end": "01:46:51.000",
      "text": "اینو زردی داشت من اومدم از اونجا دستگاه هم گرفتم"
    },
    {
      "id": 46,
      "start": 6411.0,
      "end": 6413.0,
      "formatted_start": "01:46:51.000",
      "formatted_end": "01:46:53.000",
      "text": "سنش چند الان؟"
    },
    {
      "id": 47,
      "start": 6413.0,
      "end": 6414.0,
      "formatted_start": "01:46:53.000",
      "formatted_end": "01:46:54.000",
      "text": "چند نیشه؟"
    },
    {
      "id": 48,
      "start": 6414.0,
      "end": 6416.5,
      "formatted_start": "01:46:54.000",
      "formatted_end": "01:46:56.500",
      "text": "که این دستگاه بردین؟ یک ماه قبل؟"
    },
    {
      "id": 49,
      "start": 6416.5,
      "end": 6418.0,
      "formatted_start": "01:46:56.500",
      "formatted_end": "01:46:58.000",
      "text": "آره، آره"
    },
    {
      "id": 50,
      "start": 6418.0,
      "end": 6420.0,
      "formatted_start": "01:46:58.000",
      "formatted_end": "01:47:00.000",
      "text": "سه چار روزه بوده؟ آره، آره"
    },
    {
      "id": 51,
      "start": 6420.0,
      "end": 6423.0,
      "formatted_start": "01:47:00.000",
      "formatted_end": "01:47:03.000",
      "text": "خب الان چه روزش خوب؟ الان هم زرده؟"
    },
    {
      "id": 52,
      "start": 6423.0,
      "end": 6425.0,
      "formatted_start": "01:47:03.000",
      "formatted_end": "01:47:05.000",
      "text": "یکم زرده، زرده استی شده و شبه خواهد بچینه"
    },
    {
      "id": 53,
      "start": 6425.0,
      "end": 6428.0,
      "formatted_start": "01:47:05.000",
      "formatted_end": "01:47:08.000",
      "text": "دیگه چه مشکلی داره؟ شکمش نفت و داره"
    },
    {
      "id": 54,
      "start": 6428.0,
      "end": 6430.0,
      "formatted_start": "01:47:08.000",
      "formatted_end": "01:47:10.000",
      "text": "بیکلاری هم داره؟"
    },
    {
      "id": 55,
      "start": 6430.0,
      "end": 6432.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:12.000",
      "text": "بیکلاری، دم دم و غروب یکم"
    },
    {
      "id": 56,
      "start": 6432.0,
      "end": 6434.0,
      "formatted_start": "01:47:12.000",
      "formatted_end": "01:47:14.000",
      "text": "یعنی اینا میتونه؟"
    },
    {
      "id": 57,
      "start": 6434.0,
      "end": 6438.0,
      "formatted_start": "01:47:14.000",
      "formatted_end": "01:47:18.000",
      "text": "تقریبا، نه چون بعد از یک کله نه"
    },
    {
      "id": 58,
      "start": 6438.0,
      "end": 6440.0,
      "formatted_start": "01:47:18.000",
      "formatted_end": "01:47:20.000",
      "text": "شب میخواه به مثلا"
    },
    {
      "id": 59,
      "start": 6440.0,
      "end": 6444.0,
      "formatted_start": "01:47:20.000",
      "formatted_end": "01:47:24.000",
      "text": "این زردیش خیلی عادی هست، هران چه روز"
    },
    {
      "id": 60,
      "start": 6444.0,
      "end": 6446.0,
      "formatted_start": "01:47:24.000",
      "formatted_end": "01:47:26.000",
      "text": "دیدی باید یه آزمایش میگیرید"
    },
    {
      "id": 61,
      "start": 6446.0,
      "end": 6449.0,
      "formatted_start": "01:47:26.000",
      "formatted_end": "01:47:29.000",
      "text": "آزمایش که دیمانستان برودم، از اینکه شکل کردم"
    },
    {
      "id": 62,
      "start": 6449.0,
      "end": 6451.0,
      "formatted_start": "01:47:29.000",
      "formatted_end": "01:47:31.000",
      "text": "برای این کار را برداریم"
    },
    {
      "id": 63,
      "start": 6451.0,
      "end": 6453.0,
      "formatted_start": "01:47:31.000",
      "formatted_end": "01:47:33.000",
      "text": "این درگاه باز باشد"
    },
    {
      "id": 64,
      "start": 6453.0,
      "end": 6455.0,
      "formatted_start": "01:47:33.000",
      "formatted_end": "01:47:35.000",
      "text": "بعد این کار را برداریم"
    },
    {
      "id": 65,
      "start": 6455.0,
      "end": 6457.0,
      "formatted_start": "01:47:35.000",
      "formatted_end": "01:47:37.000",
      "text": "این چیز هم خوش نشونده باشد"
    },
    {
      "id": 66,
      "start": 6457.0,
      "end": 6459.0,
      "formatted_start": "01:47:37.000",
      "formatted_end": "01:47:39.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 67,
      "start": 6459.0,
      "end": 6461.0,
      "formatted_start": "01:47:39.000",
      "formatted_end": "01:47:41.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 68,
      "start": 6461.0,
      "end": 6463.0,
      "formatted_start": "01:47:41.000",
      "formatted_end": "01:47:43.000",
      "text": "درگاه باز برداریم"
    },
    {
      "id": 69,
      "start": 6463.0,
      "end": 6465.0,
      "formatted_start": "01:47:43.000",
      "formatted_end": "01:47:45.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 70,
      "start": 6465.0,
      "end": 6467.0,
      "formatted_start": "01:47:45.000",
      "formatted_end": "01:47:47.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 71,
      "start": 6467.0,
      "end": 6469.0,
      "formatted_start": "01:47:47.000",
      "formatted_end": "01:47:49.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 72,
      "start": 6469.0,
      "end": 6471.0,
      "formatted_start": "01:47:49.000",
      "formatted_end": "01:47:51.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 73,
      "start": 6471.0,
      "end": 6473.0,
      "formatted_start": "01:47:51.000",
      "formatted_end": "01:47:53.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 74,
      "start": 6473.0,
      "end": 6475.0,
      "formatted_start": "01:47:53.000",
      "formatted_end": "01:47:55.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 75,
      "start": 6475.0,
      "end": 6477.0,
      "formatted_start": "01:47:55.000",
      "formatted_end": "01:47:57.000",
      "text": "درگاه باز باشد"
    },
    {
      "id": 76,
      "start": 6477.0,
      "end": 6479.0,
      "formatted_start": "01:47:57.000",
      "formatted_end": "01:47:59.000",
      "text": "باید برم ببینیم"
    },
    {
      "id": 77,
      "start": 6500.0,
      "end": 6502.0,
      "formatted_start": "01:48:20.000",
      "formatted_end": "01:48:22.000",
      "text": "بیقراری نداره بون سرعت؟"
    },
    {
      "id": 78,
      "start": 6502.0,
      "end": 6504.0,
      "formatted_start": "01:48:22.000",
      "formatted_end": "01:48:24.000",
      "text": "داره خیلی کم"
    },
    {
      "id": 79,
      "start": 6504.0,
      "end": 6506.0,
      "formatted_start": "01:48:24.000",
      "formatted_end": "01:48:26.000",
      "text": "شما دارید بابا بابا"
    },
    {
      "id": 80,
      "start": 6506.0,
      "end": 6508.0,
      "formatted_start": "01:48:26.000",
      "formatted_end": "01:48:28.000",
      "text": "یک کمش ماهی نیست"
    },
    {
      "id": 81,
      "start": 6508.0,
      "end": 6510.0,
      "formatted_start": "01:48:28.000",
      "formatted_end": "01:48:30.000",
      "text": "اگه زیاده دارو بینیسه"
    },
    {
      "id": 82,
      "start": 6510.0,
      "end": 6512.0,
      "formatted_start": "01:48:30.000",
      "formatted_end": "01:48:32.000",
      "text": "شیر مادر می کنه؟"
    },
    {
      "id": 83,
      "start": 6512.0,
      "end": 6514.0,
      "formatted_start": "01:48:32.000",
      "formatted_end": "01:48:34.000",
      "text": "آره"
    },
    {
      "id": 84,
      "start": 6514.0,
      "end": 6516.0,
      "formatted_start": "01:48:34.000",
      "formatted_end": "01:48:36.000",
      "text": "مادرش حبوبات و لبنیات اینا نخوره"
    },
    {
      "id": 85,
      "start": 6516.0,
      "end": 6518.0,
      "formatted_start": "01:48:36.000",
      "formatted_end": "01:48:38.000",
      "text": "آره"
    },
    {
      "id": 86,
      "start": 6518.0,
      "end": 6520.0,
      "formatted_start": "01:48:38.000",
      "formatted_end": "01:48:40.000",
      "text": "ازمائی شریفگار هم گرفتی نیست"
    },
    {
      "id": 87,
      "start": 6520.0,
      "end": 6522.0,
      "formatted_start": "01:48:40.000",
      "formatted_end": "01:48:42.000",
      "text": "آره"
    },
    {
      "id": 88,
      "start": 6522.0,
      "end": 6524.0,
      "formatted_start": "01:48:42.000",
      "formatted_end": "01:48:44.000",
      "text": "آزمائی شو جوابش آماده شد"
    },
    {
      "id": 89,
      "start": 6524.0,
      "end": 6526.0,
      "formatted_start": "01:48:44.000",
      "formatted_end": "01:48:46.000",
      "text": "بیاری ما بیریم"
    },
    {
      "id": 90,
      "start": 6526.0,
      "end": 6528.0,
      "formatted_start": "01:48:46.000",
      "formatted_end": "01:48:48.000",
      "text": "خیلی خیلی مشکل نداریم"
    },
    {
      "id": 91,
      "start": 6528.0,
      "end": 6530.0,
      "formatted_start": "01:48:48.000",
      "formatted_end": "01:48:50.000",
      "text": "ببینید این بهتر دستگاه ببریم"
    },
    {
      "id": 92,
      "start": 6530.0,
      "end": 6532.0,
      "formatted_start": "01:48:50.000",
      "formatted_end": "01:48:52.000",
      "text": "یا بستریش برو"
    },
    {
      "id": 93,
      "start": 6532.0,
      "end": 6534.0,
      "formatted_start": "01:48:52.000",
      "formatted_end": "01:48:54.000",
      "text": "یا زیر دستگاه ببریم"
    },
    {
      "id": 94,
      "start": 6534.0,
      "end": 6535.0,
      "formatted_start": "01:48:54.000",
      "formatted_end": "01:48:55.000",
      "text": "کلانی شده"
    },
    {
      "id": 95,
      "start": 6535.0,
      "end": 6538.0,
      "formatted_start": "01:48:55.000",
      "formatted_end": "01:48:58.000",
      "text": "چون این زردیا رو مرد بچه از سر روی نمیزده"
    },
    {
      "id": 96,
      "start": 6538.0,
      "end": 6540.0,
      "formatted_start": "01:48:58.000",
      "formatted_end": "01:49:00.000",
      "text": "و دارو غرص دارید"
    },
    {
      "id": 97,
      "start": 6540.0,
      "end": 6542.0,
      "formatted_start": "01:49:00.000",
      "formatted_end": "01:49:02.000",
      "text": "و دارو غرص ندارید"
    },
    {
      "id": 98,
      "start": 6542.0,
      "end": 6544.0,
      "formatted_start": "01:49:02.000",
      "formatted_end": "01:49:04.000",
      "text": "یا باید بستریمشون تو بیمارستان زیر تر سلام"
    },
    {
      "id": 99,
      "start": 6544.0,
      "end": 6547.0,
      "formatted_start": "01:49:04.000",
      "formatted_end": "01:49:07.000",
      "text": "نه آقای باستید دستگاه رو بیمارستان تبید داده"
    },
    {
      "id": 100,
      "start": 6547.0,
      "end": 6549.0,
      "formatted_start": "01:49:07.000",
      "formatted_end": "01:49:09.000",
      "text": "حالا کار دارید"
    },
    {
      "id": 101,
      "start": 6549.0,
      "end": 6554.0,
      "formatted_start": "01:49:09.000",
      "formatted_end": "01:49:14.000",
      "text": "شما یا باید دستگاه ببرن یا بستریم"
    },
    {
      "id": 102,
      "start": 6554.0,
      "end": 6556.0,
      "formatted_start": "01:49:14.000",
      "formatted_end": "01:49:16.000",
      "text": "دارو قطره و غرص و چیزا خواهیده اید"
    },
    {
      "id": 103,
      "start": 6556.0,
      "end": 6560.0,
      "formatted_start": "01:49:16.000",
      "formatted_end": "01:49:20.000",
      "text": "خواهیده اید دارو رو ببرید"
    },
    {
      "id": 104,
      "start": 6560.0,
      "end": 6566.0,
      "formatted_start": "01:49:20.000",
      "formatted_end": "01:49:26.000",
      "text": "من فایده ای ندارم. دلتو خوش کنم یه ۴۵۰ تا ۱۰۰۰ خانه یک قطعه بگی فایده ای نداری که"
    },
    {
      "id": 105,
      "start": 6566.0,
      "end": 6569.0,
      "formatted_start": "01:49:26.000",
      "formatted_end": "01:49:29.000",
      "text": "بگو بگی اینو من میروشنم تو بخواب میشیم"
    },
    {
      "id": 106,
      "start": 6569.0,
      "end": 6574.0,
      "formatted_start": "01:49:29.000",
      "formatted_end": "01:49:34.000",
      "text": "کار درست نیست. مثلا شما با خمیر بگم برنج درست کن"
    },
    {
      "id": 107,
      "start": 6574.0,
      "end": 6578.0,
      "formatted_start": "01:49:34.000",
      "formatted_end": "01:49:38.000",
      "text": "با خمیر برنج درست نیشید با اون قطعه و اون زردی خوب نیمیشید"
    },
    {
      "id": 108,
      "start": 6578.0,
      "end": 6581.0,
      "formatted_start": "01:49:38.000",
      "formatted_end": "01:49:41.000",
      "text": "نه علکیه ترنجه میشید بخشت"
    },
    {
      "id": 109,
      "start": 6581.0,
      "end": 6585.4,
      "formatted_start": "01:49:41.000",
      "formatted_end": "01:49:45.400",
      "text": "نه ترجمه میشه ریخشتن، اصالش میگرن همین شکل درخواه میده"
    },
    {
      "id": 110,
      "start": 6585.4,
      "end": 6588.9,
      "formatted_start": "01:49:45.400",
      "formatted_end": "01:49:48.900",
      "text": "تا وقتی یه آب آزمایش میاد از همون ها بیدیم، مدتونی داریم کنه"
    },
    {
      "id": 111,
      "start": 6588.9,
      "end": 6594.2,
      "formatted_start": "01:49:48.900",
      "formatted_end": "01:49:54.200",
      "text": "ببین دستگاه خوب، این عطاویه ای که سر سازمان و مغازه ها اصلا فایده ای نده"
    },
    {
      "id": 112,
      "start": 6594.2,
      "end": 6598.2,
      "formatted_start": "01:49:54.200",
      "formatted_end": "01:49:58.200",
      "text": "برای خودت میگم، آب این بچه هم زرد چهر روزم شده"
    },
    {
      "id": 113,
      "start": 6598.2,
      "end": 6600.0,
      "formatted_start": "01:49:58.200",
      "formatted_end": "01:50:00.000",
      "text": "یه علکی پلکی بخونی کار کنیش"
    }
  ],
  "status": "completed"
}