  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9910.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:10.000",
      "text": "از اینجا باید برداشت بگیرد. صبح و شب یک چارم در آب هرکار برداشت بگیرد. دشکا همینجا هست. به منشی بگو. بهت آموزش میده میبرد. اگر از اینجا بسیاری کنید، نامیتن نیستم."
    },
    {
      "id": 1,
      "start": 9910.0,
      "end": 9912.0,
      "formatted_start": "02:45:10.000",
      "formatted_end": "02:45:12.000",
      "text": "اگر از اینجا بسیاری کنید، نامیتن نیستم."
    },
    {
      "id": 2,
      "start": 9912.0,
      "end": 9916.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:16.000",
      "text": "بیمار، اینجا کجا برداشت؟"
    },
    {
      "id": 3,
      "start": 9916.0,
      "end": 9918.0,
      "formatted_start": "02:45:16.000",
      "formatted_end": "02:45:18.000",
      "text": "بیمار، اینجا کجا برداشت؟"
    },
    {
      "id": 4,
      "start": 9918.0,
      "end": 9920.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:20.000",
      "text": "بیمار، اینجا کجا برداشت؟"
    },
    {
      "id": 5,
      "start": 9920.0,
      "end": 9922.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:22.000",
      "text": "یک خیلی نامیست همین هستند"
    },
    {
      "id": 6,
      "start": 9922.0,
      "end": 9925.0,
      "formatted_start": "02:45:22.000",
      "formatted_end": "02:45:25.000",
      "text": "دستگاه راورت کرده دیگه بیمارسان"
    },
    {
      "id": 7,
      "start": 9925.0,
      "end": 9928.0,
      "formatted_start": "02:45:25.000",
      "formatted_end": "02:45:28.000",
      "text": "اون دستگاه راورت کرده؟ دستگاه اون دستگاه راورت میشه؟"
    },
    {
      "id": 8,
      "start": 9928.0,
      "end": 9930.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:30.000",
      "text": "خیلی راورت کرده میشه"
    },
    {
      "id": 9,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "الان ما چند تا ده دوازده تا دستگاه داریم"
    },
    {
      "id": 10,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "بیمارسان هم اون دستگاه را میداره"
    },
    {
      "id": 11,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "آزمایش میداره"
    },
    {
      "id": 12,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "لارول میداره"
    },
    {
      "id": 13,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "دستگاه چند روز باشه؟"
    },
    {
      "id": 14,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "دستگاه شب شنبه نیست"
    },
    {
      "id": 15,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "خواهش باشه"
    },
    {
      "id": 16,
      "start": 9944.0,
      "end": 9945.0,
      "formatted_start": "02:45:44.000",
      "formatted_end": "02:45:45.000",
      "text": "خب؟"
    },
    {
      "id": 17,
      "start": 9945.0,
      "end": 9946.0,
      "formatted_start": "02:45:45.000",
      "formatted_end": "02:45:46.000",
      "text": "دستگاه شنبه؟"
    },
    {
      "id": 18,
      "start": 9946.0,
      "end": 9947.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:47.000",
      "text": "آره"
    },
    {
      "id": 19,
      "start": 9947.0,
      "end": 9949.0,
      "formatted_start": "02:45:47.000",
      "formatted_end": "02:45:49.000",
      "text": "از این رو اصلا اصلا میشونیم"
    },
    {
      "id": 20,
      "start": 9949.0,
      "end": 9951.0,
      "formatted_start": "02:45:49.000",
      "formatted_end": "02:45:51.000",
      "text": "ولی شما استفاده کنید تا شنبه"
    },
    {
      "id": 21,
      "start": 9951.0,
      "end": 9953.0,
      "formatted_start": "02:45:51.000",
      "formatted_end": "02:45:53.000",
      "text": "از اون برافتم بسارم دیگه"
    },
    {
      "id": 22,
      "start": 9953.0,
      "end": 9955.0,
      "formatted_start": "02:45:53.000",
      "formatted_end": "02:45:55.000",
      "text": "آره آره بمونشین بگو بهت آموزش میده"
    },
    {
      "id": 23,
      "start": 9955.0,
      "end": 9957.0,
      "formatted_start": "02:45:55.000",
      "formatted_end": "02:45:57.000",
      "text": "الان چی رو دست کنید"
    },
    {
      "id": 24,
      "start": 9957.0,
      "end": 9959.0,
      "formatted_start": "02:45:57.000",
      "formatted_end": "02:45:59.000",
      "text": "چند شهر دید؟"
    },
    {
      "id": 25,
      "start": 9959.0,
      "end": 9961.0,
      "formatted_start": "02:45:59.000",
      "formatted_end": "02:46:01.000",
      "text": "24 سرده"
    },
    {
      "id": 26,
      "start": 9961.0,
      "end": 9963.0,
      "formatted_start": "02:46:01.000",
      "formatted_end": "02:46:03.000",
      "text": "ببین تا شنبه دیگه"
    },
    {
      "id": 27,
      "start": 9963.0,
      "end": 9965.0,
      "formatted_start": "02:46:03.000",
      "formatted_end": "02:46:05.000",
      "text": "تا شنبه باشه"
    },
    {
      "id": 28,
      "start": 9965.0,
      "end": 9967.0,
      "formatted_start": "02:46:05.000",
      "formatted_end": "02:46:07.000",
      "text": "تا شنبه میشه چهار شهر"
    },
    {
      "id": 29,
      "start": 9967.0,
      "end": 9969.0,
      "formatted_start": "02:46:07.000",
      "formatted_end": "02:46:09.000",
      "text": "ولی دیگه شهر شما اصلا نیستونید"
    },
    {
      "id": 30,
      "start": 9969.0,
      "end": 9971.0,
      "formatted_start": "02:46:09.000",
      "formatted_end": "02:46:11.000",
      "text": "نقفی کنید"
    },
    {
      "id": 31,
      "start": 9971.0,
      "end": 9973.0,
      "formatted_start": "02:46:11.000",
      "formatted_end": "02:46:13.000",
      "text": "ولی شما اون رو تا شنبه استفاده کنید"
    },
    {
      "id": 32,
      "start": 9973.0,
      "end": 9975.0,
      "formatted_start": "02:46:13.000",
      "formatted_end": "02:46:15.000",
      "text": "ببین"
    },
    {
      "id": 33,
      "start": 9975.0,
      "end": 10005.0,
      "formatted_start": "02:46:15.000",
      "formatted_end": "02:46:45.000",
