    },
    {
      "id": 15,
      "start": 11513.0,
      "end": 11514.24,
      "formatted_start": "03:11:53.000",
      "formatted_end": "03:11:54.240",
      "text": "انوز نه ایمده"
    },
    {
      "id": 16,
      "start": 11514.24,
      "end": 11529.24,
      "formatted_start": "03:11:54.240",
      "formatted_end": "03:12:09.240",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 11544.24,
      "end": 11568.24,
      "formatted_start": "03:12:24.240",
      "formatted_end": "03:12:48.240",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 11568.24,
      "end": 11574.24,
      "formatted_start": "03:12:48.240",
      "formatted_end": "03:12:54.240",
      "text": "بفهم سلام جان سلامت بشین بخشید کارم درخواهد بخشید بفهم سلام"
    },
    {
      "id": 19,
      "start": 11574.24,
      "end": 11576.24,
      "formatted_start": "03:12:54.240",
      "formatted_end": "03:12:56.240",
      "text": "بچنون رو تقفل بگیریم"
    },
    {
      "id": 20,
      "start": 11576.24,
      "end": 11579.24,
      "formatted_start": "03:12:56.240",
      "formatted_end": "03:12:59.240",
      "text": "بله"
    },
    {
      "id": 21,
      "start": 11579.24,
      "end": 11584.24,
      "formatted_start": "03:12:59.240",
      "formatted_end": "03:13:04.240",
      "text": "در روز که درنیا آمده"
    },
    {
      "id": 22,
      "start": 11584.24,
      "end": 11585.24,
      "formatted_start": "03:13:04.240",
      "formatted_end": "03:13:05.240",
      "text": "بله"
    },
    {
      "id": 23,
      "start": 11585.24,
      "end": 11590.24,
      "formatted_start": "03:13:05.240",
      "formatted_end": "03:13:10.240",
      "text": "از این در روز کنن احساس بود ولی یه روز بهتر شد دوباره احساسش"
    },
    {
      "id": 24,
      "start": 11590.24,
      "end": 11592.24,
      "formatted_start": "03:13:10.240",
      "formatted_end": "03:13:12.240",
      "text": "برشتون برگتونو بگیرم هم بگیرم"
    },
    {
      "id": 25,
      "start": 11592.24,
      "end": 11596.24,
      "formatted_start": "03:13:12.240",
      "formatted_end": "03:13:16.240",
      "text": "اجتماع شما از فری روز آباکی شدیده"
    },
    {
      "id": 26,
      "start": 11596.24,
      "end": 11597.58,
      "formatted_start": "03:13:16.240",
      "formatted_end": "03:13:17.580",
      "text": "آبکی بدبو هم هسته؟"
    },
    {
      "id": 27,
      "start": 11597.58,
      "end": 11598.24,
      "formatted_start": "03:13:17.580",
      "formatted_end": "03:13:18.240",
      "text": "آره"
    },
    {
      "id": 28,
      "start": 11598.24,
      "end": 11599.44,
      "formatted_start": "03:13:18.240",
      "formatted_end": "03:13:19.440",
      "text": "کسبنده هم هست؟"
    },
    {
      "id": 29,
      "start": 11599.44,
      "end": 11600.08,
      "formatted_start": "03:13:19.440",
      "formatted_end": "03:13:20.080",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 11600.08,
      "end": 11600.78,
      "formatted_start": "03:13:20.080",
      "formatted_end": "03:13:20.780",
      "text": "آره"
    },
    {
      "id": 31,
      "start": 11600.78,
      "end": 11602.78,
      "formatted_start": "03:13:20.780",
      "formatted_end": "03:13:22.780",
      "text": "روز چند باشه کمش بردو کنی؟"
    },
    {
      "id": 32,
      "start": 11602.78,
      "end": 11604.58,
      "formatted_start": "03:13:22.780",
      "formatted_end": "03:13:24.580",
      "text": "بسیار بردو کنم"
    },
    {
      "id": 33,
      "start": 11604.58,
      "end": 11605.82,
      "formatted_start": "03:13:24.580",
      "formatted_end": "03:13:25.820",
      "text": "بعد چند روز شده بودی؟"
    },
    {
      "id": 34,
      "start": 11605.82,
      "end": 11606.62,
      "formatted_start": "03:13:25.820",
      "formatted_end": "03:13:26.620",
      "text": "نه بسیار بردو شده"
    },
    {
      "id": 35,
      "start": 11606.62,
      "end": 11608.28,
      "formatted_start": "03:13:26.620",
      "formatted_end": "03:13:28.280",
      "text": "آقاوزم دکتور"
    },
    {
      "id": 36,
      "start": 11608.28,
      "end": 11609.9,
      "formatted_start": "03:13:28.280",
      "formatted_end": "03:13:29.900",
      "text": "داروهایشو ببینم"
    },
    {
      "id": 37,
      "start": 11609.9,
      "end": 11610.86,
      "formatted_start": "03:13:29.900",
      "formatted_end": "03:13:30.860",
      "text": "خوب بزنم اینجا"
    },
    {
      "id": 38,
      "start": 11610.86,
      "end": 11614.24,
      "formatted_start": "03:13:30.860",
      "formatted_end": "03:13:34.240",
      "text": "از لکت داره که نه نه اون دوره شده"
    },
    {
      "id": 39,
      "start": 11614.24,
      "end": 11615.24,
      "formatted_start": "03:13:34.240",
      "formatted_end": "03:13:35.240",
      "text": "خوب بزنم باشم"
    },
    {
      "id": 40,
      "start": 11621.54,
      "end": 11622.78,
      "formatted_start": "03:13:41.540",
      "formatted_end": "03:13:42.780",
      "text": "زردی هم داشته بود؟"
    },
    {
      "id": 41,
      "start": 11622.78,
      "end": 11624.12,
      "formatted_start": "03:13:42.780",
      "formatted_end": "03:13:44.120",
      "text": "نه نه زردی نه"
    },
    {
      "id": 42,
      "start": 11624.12,
      "end": 11625.4,
      "formatted_start": "03:13:44.120",
      "formatted_end": "03:13:45.400",
      "text": "ببینی کمی زرده"
    },
    {
      "id": 43,
      "start": 11626.24,
      "end": 11628.24,
      "formatted_start": "03:13:46.240",
      "formatted_end": "03:13:48.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 44,
      "start": 11628.24,
      "end": 11630.24,
      "formatted_start": "03:13:48.240",
      "formatted_end": "03:13:50.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 45,
      "start": 11630.24,
      "end": 11632.24,
      "formatted_start": "03:13:50.240",
      "formatted_end": "03:13:52.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 46,
      "start": 11632.24,
      "end": 11634.24,
      "formatted_start": "03:13:52.240",
      "formatted_end": "03:13:54.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 47,
      "start": 11634.24,
      "end": 11636.24,
      "formatted_start": "03:13:54.240",
      "formatted_end": "03:13:56.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 48,
      "start": 11636.24,
      "end": 11638.24,
      "formatted_start": "03:13:56.240",
      "formatted_end": "03:13:58.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 49,
      "start": 11638.24,
      "end": 11640.24,
      "formatted_start": "03:13:58.240",
      "formatted_end": "03:14:00.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 50,
      "start": 11640.24,
      "end": 11642.24,
      "formatted_start": "03:14:00.240",
      "formatted_end": "03:14:02.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 51,
      "start": 11642.24,
      "end": 11644.24,
      "formatted_start": "03:14:02.240",
      "formatted_end": "03:14:04.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 52,
      "start": 11644.24,
      "end": 11646.24,
      "formatted_start": "03:14:04.240",
      "formatted_end": "03:14:06.240",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 53,
      "start": 11646.24,
      "end": 11648.24,
      "formatted_start": "03:14:06.240",
      "formatted_end": "03:14:08.240",
      "text": "از صبح تا حالا چند بار بده؟"
    },
    {
      "id": 54,
      "start": 11648.24,
      "end": 11651.24,
      "formatted_start": "03:14:08.240",
      "formatted_end": "03:14:11.240",
      "text": "از صبح تا حالا بیشتر"
    },
    {
      "id": 55,
      "start": 11651.24,
      "end": 11653.24,
      "formatted_start": "03:14:11.240",
      "formatted_end": "03:14:13.240",
      "text": "۴۶ بار"
    },
    {
      "id": 56,
      "start": 11665.24,
      "end": 11667.24,
      "formatted_start": "03:14:25.240",
      "formatted_end": "03:14:27.240",
      "text": "درواز چی میدون؟"
    },
    {
      "id": 57,
      "start": 11667.24,
      "end": 11669.24,
      "formatted_start": "03:14:27.240",
      "formatted_end": "03:14:29.240",
      "text": "پدی با کتفیه"
    },
    {
      "id": 58,
      "start": 11669.24,
      "end": 11670.24,
      "formatted_start": "03:14:29.240",
      "formatted_end": "03:14:30.240",
      "text": "دیگه؟"
    },
    {
      "id": 59,
      "start": 11670.24,
      "end": 11672.24,
      "formatted_start": "03:14:30.240",
      "formatted_end": "03:14:32.240",
      "text": "بعد این کتفیه نو با این"
    },
    {
      "id": 60,
      "start": 11672.24,
      "end": 11675.24,
      "formatted_start": "03:14:32.240",
      "formatted_end": "03:14:35.240",
      "text": "این کتفیه که باید خسخس سینه برای اصحال بیده"
    },
    {
      "id": 61,
      "start": 11675.24,
      "end": 11677.24,
      "formatted_start": "03:14:35.240",
      "formatted_end": "03:14:37.240",
      "text": "خب دیگر رو دوباره بگو تا رو سه هم زنن"
    },
    {
      "id": 62,
      "start": 11677.24,
      "end": 11679.24,
      "formatted_start": "03:14:37.240",
      "formatted_end": "03:14:39.240",
      "text": "نه نه بله خسخس و اینا دیگر"
    },
    {
      "id": 63,
      "start": 11679.24,
      "end": 11681.24,
      "formatted_start": "03:14:39.240",
      "formatted_end": "03:14:41.240",
      "text": "نه"
    },
    {
      "id": 64,
      "start": 11681.24,
      "end": 11683.24,
      "formatted_start": "03:14:41.240",
      "formatted_end": "03:14:43.240",
      "text": "تو روی اصحال میشه"
    },
    {
      "id": 65,
      "start": 11683.24,
      "end": 11685.24,
      "formatted_start": "03:14:43.240",
      "formatted_end": "03:14:45.240",
      "text": "اصحال هست"
    },
    {
      "id": 66,
      "start": 11685.24,
      "end": 11687.24,
      "formatted_start": "03:14:45.240",
      "formatted_end": "03:14:47.240",
      "text": "پدیرلاکت رو بگو"
    },
    {
      "id": 67,
      "start": 11687.24,
      "end": 11689.24,
      "formatted_start": "03:14:47.240",
      "formatted_end": "03:14:49.240",
      "text": "پدیرلاکت رو بشه بگیم"
    },
    {
      "id": 68,
      "start": 11689.24,
      "end": 11691.24,
      "formatted_start": "03:14:49.240",
      "formatted_end": "03:14:51.240",
      "text": "اینا هم در چشم"
    },
    {
      "id": 69,
      "start": 11691.24,
      "end": 11693.24,
      "formatted_start": "03:14:51.240",
      "formatted_end": "03:14:53.240",
      "text": "بله اون خوبه"
    },
    {
      "id": 70,
      "start": 11693.24,
      "end": 11695.24,
      "formatted_start": "03:14:53.240",
      "formatted_end": "03:14:55.240",
      "text": "بله جانم بفهمتایی کن"
    },
    {
      "id": 71,
      "start": 11695.24,
      "end": 11697.24,
      "formatted_start": "03:14:55.240",
      "formatted_end": "03:14:57.240",
      "text": "بله بفهمتا"
    },
    {
      "id": 72,
      "start": 11697.24,
      "end": 11699.24,
      "formatted_start": "03:14:57.240",
      "formatted_end": "03:14:59.240",
      "text": "بله"
    }
