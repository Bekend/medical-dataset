  "stt_segments": [
    {
      "id": 0,
      "start": 1500.0,
      "end": 1529.98,
      "formatted_start": "00:25:00.000",
      "formatted_end": "00:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 1530.0,
      "end": 1550.0,
      "formatted_start": "00:25:30.000",
      "formatted_end": "00:25:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 1560.0,
      "end": 1564.0,
      "formatted_start": "00:26:00.000",
      "formatted_end": "00:26:04.000",
      "text": "این رو خود پانچ کلاورداری کردید، یک ملیار باید باهم کردید."
    },
    {
      "id": 3,
      "start": 1564.0,
      "end": 1566.0,
      "formatted_start": "00:26:04.000",
      "formatted_end": "00:26:06.000",
      "text": "دو ملیار رو دامر شده."
    },
    {
      "id": 4,
      "start": 1566.0,
      "end": 1570.0,
      "formatted_start": "00:26:06.000",
      "formatted_end": "00:26:10.000",
      "text": "سه مشروع هم تا یک آج، موردش هست دیگه."
    },
    {
      "id": 5,
      "start": 1570.0,
      "end": 1572.0,
      "formatted_start": "00:26:10.000",
      "formatted_end": "00:26:12.000",
      "text": "مجموعه نیست که شیره نباید باهم کشیره."
    },
    {
      "id": 6,
      "start": 1572.0,
      "end": 1576.0,
      "formatted_start": "00:26:12.000",
      "formatted_end": "00:26:16.000",
      "text": "انا رفته شکل کردم، کلاورداری کردم."
    },
    {
      "id": 7,
      "start": 1576.0,
      "end": 1578.0,
      "formatted_start": "00:26:16.000",
      "formatted_end": "00:26:18.000",
      "text": "پانچ هم دوستی را نمیشه."
    },
    {
      "id": 8,
      "start": 1580.0,
      "end": 1583.0,
      "formatted_start": "00:26:20.000",
      "formatted_end": "00:26:23.000",
      "text": "نو ملیار، انا در رفتر هم نو ملیار."
    },
    {
      "id": 9,
      "start": 1583.0,
      "end": 1585.0,
      "formatted_start": "00:26:23.000",
      "formatted_end": "00:26:25.000",
      "text": "آفرین، باهم باهم بیشتر."
    },
    {
      "id": 10,
      "start": 1585.0,
      "end": 1587.0,
      "formatted_start": "00:26:25.000",
      "formatted_end": "00:26:27.000",
      "text": "نه بیشتر، همین را باهم بیشتر."
    },
    {
      "id": 11,
      "start": 1590.0,
      "end": 1620.0,
      "formatted_start": "00:26:30.000",
      "formatted_end": "00:27:00.000",
