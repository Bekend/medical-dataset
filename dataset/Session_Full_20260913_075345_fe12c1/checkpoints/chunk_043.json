      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:30.000",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 1,
      "start": 12930.0,
      "end": 12932.0,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:32.000",
      "text": "حالا سلام استاد جا"
    },
    {
      "id": 2,
      "start": 12932.0,
      "end": 12936.0,
      "formatted_start": "03:35:32.000",
      "formatted_end": "03:35:36.000",
      "text": "خوبی ها حسینی هستم اون رنو دیروز گروهی"
    },
    {
      "id": 3,
      "start": 12936.0,
      "end": 12940.0,
      "formatted_start": "03:35:36.000",
      "formatted_end": "03:35:40.000",
      "text": "آن فندشو من گرفتیم"
    },
    {
      "id": 4,
      "start": 12940.0,
      "end": 12942.0,
      "formatted_start": "03:35:40.000",
      "formatted_end": "03:35:42.000",
      "text": "آره"
    },
    {
      "id": 5,
      "start": 12942.0,
      "end": 12947.0,
      "formatted_start": "03:35:42.000",
      "formatted_end": "03:35:47.000",
      "text": "شنبه خوب صبحیان یا"
    },
    {
      "id": 6,
      "start": 12947.0,
      "end": 12952.0,
      "formatted_start": "03:35:47.000",
      "formatted_end": "03:35:52.000",
      "text": "باش باشه باشه باشه"
    },
    {
      "id": 7,
      "start": 12952.0,
      "end": 12957.0,
      "formatted_start": "03:35:52.000",
      "formatted_end": "03:35:57.000",
      "text": "استاد اینو اگه زغالش اینو بدید این سالمه"
    },
    {
      "id": 8,
      "start": 12957.0,
      "end": 12970.0,
      "formatted_start": "03:35:57.000",
      "formatted_end": "03:36:10.000",
      "text": "همین مطور فن نمیگید دیگر؟"
    },
    {
      "id": 9,
      "start": 12970.0,
      "end": 12979.0,
      "formatted_start": "03:36:10.000",
      "formatted_end": "03:36:19.000",
      "text": "اگر یه وقتی فن سالم باشه، زغال مشکل باشه، باز دربجت به فتر، فن باز حرکت..."
    },
    {
      "id": 10,
      "start": 12979.0,
      "end": 12985.0,
      "formatted_start": "03:36:19.000",
      "formatted_end": "03:36:25.000",
      "text": "خوب؟"
    },
    {
      "id": 11,
      "start": 12986.0,
      "end": 12988.62,
      "formatted_start": "03:36:26.000",
      "formatted_end": "03:36:28.620",
      "text": "آخهل، خوش"
    },
    {
      "id": 12,
      "start": 12988.62,
      "end": 12990.64,
      "formatted_start": "03:36:28.620",
      "formatted_end": "03:36:30.640",
      "text": "خوشه، مرسی، خدافت"
    },
    {
      "id": 13,
      "start": 13009.0,
      "end": 13019.0,
      "formatted_start": "03:36:49.000",
      "formatted_end": "03:36:59.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 13039.0,
      "end": 13068.98,
      "formatted_start": "03:37:19.000",
      "formatted_end": "03:37:48.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 15,
      "start": 13069.0,
      "end": 13081.0,
      "formatted_start": "03:37:49.000",
      "formatted_end": "03:38:01.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 13099.0,
      "end": 13101.0,
      "formatted_start": "03:38:19.000",
      "formatted_end": "03:38:21.000",
      "text": "این امریکا است و اینم ایران است"
    },
    {
      "id": 17,
      "start": 13101.0,
      "end": 13103.0,
      "formatted_start": "03:38:21.000",
      "formatted_end": "03:38:23.000",
      "text": "کتابترین فاصله بین ما و امریکا"
    },
    {
      "id": 18,
      "start": 13103.0,
      "end": 13105.0,
      "formatted_start": "03:38:23.000",
      "formatted_end": "03:38:25.000",
      "text": "عدود 10142 کیلومتره"
    },
    {
      "id": 19,
      "start": 13105.0,
      "end": 13107.0,
      "formatted_start": "03:38:25.000",
      "formatted_end": "03:38:27.000",
      "text": "برای تحکیم در این فاصله"
    },
    {
      "id": 20,
      "start": 13107.0,
      "end": 13110.0,
      "formatted_start": "03:38:27.000",
      "formatted_end": "03:38:30.000",
      "text": "سریعترین مشهد امریکا عدود 25 دقیقه زمان میازد"
    },
    {
      "id": 21,
      "start": 13110.0,
      "end": 13114.0,
      "formatted_start": "03:38:30.000",
      "formatted_end": "03:38:34.000",
      "text": "سریعترین جهت دنیا عدود 2 ساعت و 52 دقیقه زمان بیبره"
    },
    {
      "id": 22,
      "start": 13114.0,
      "end": 13119.0,
      "formatted_start": "03:38:34.000",
      "formatted_end": "03:38:39.000",
      "text": "جهگرده ای اف بیستورد و رمتور عدود 4 ساعت و 12 دقیقه زمان میازد"
    },
    {
      "id": 23,
      "start": 13119.0,
      "end": 13123.0,
      "formatted_start": "03:38:39.000",
      "formatted_end": "03:38:43.000",
      "text": "منبخه نبادر گلز فیدو استریت عدود 11 ساعت و 12 دقیقه"
    },
    {
      "id": 24,
      "start": 13123.0,
      "end": 13131.0,
      "formatted_start": "03:38:43.000",
      "formatted_end": "03:38:51.000",
      "text": "در این وقت، یک پرواز مساکرگری معمولی از 10 ساعت جمعه کشید، در حالی که یک کشی باری، حدود 5 ساعت بردست بازید."
    },
    {
      "id": 25,
      "start": 13131.0,
      "end": 13139.0,
      "formatted_start": "03:38:51.000",
      "formatted_end": "03:38:59.000",
      "text": "اگر بخوایید کل مسیر را از راه زمینی پیاده تقیید کنید، باید از سرزمین اصلی امریکا وارد کانادا و بعد آرستا رشید،"
    },
    {
      "id": 26,
      "start": 13139.0,
      "end": 13146.0,
      "formatted_start": "03:38:59.000",
      "formatted_end": "03:39:06.000",
      "text": "از تنگ یبریب و بوندر و وارد روسی رشید، بعدم از سیدری درزاوستان و ترکمنستان به سمت ایران پیاد."
    },
    {
      "id": 27,
      "start": 13146.0,
      "end": 13151.1,
      "formatted_start": "03:39:06.000",
      "formatted_end": "03:39:11.100",
      "text": "ایران پیار در این صورت تقریبا 193 هزار کلومتر مسیر رو تقییم بودید"
    },
    {
      "id": 28,
      "start": 13151.1,
      "end": 13152.02,
      "formatted_start": "03:39:11.100",
      "formatted_end": "03:39:12.020",
      "text": "حالا یه سوال"
    },
    {
      "id": 29,
      "start": 13152.02,
      "end": 13156.42,
      "formatted_start": "03:39:12.020",
      "formatted_end": "03:39:16.420",
      "text": "تو حاضر همین مسیر رو پیاده برید تا به امریکا برسید یا نه؟"
    },
    {
      "id": 30,
      "start": 13156.42,
      "end": 13158.52,
      "formatted_start": "03:39:16.420",
      "formatted_end": "03:39:18.520",
      "text": "نظر تو دیگه کامل تا برامده بیدید"
    },
    {
      "id": 31,
      "start": 13158.52,
      "end": 13160.46,
      "formatted_start": "03:39:18.520",
      "formatted_end": "03:39:20.460",
      "text": "این امریکا است و اینم ایرانه"
    },
    {
      "id": 32,
      "start": 13160.46,
      "end": 13163.06,
      "formatted_start": "03:39:20.460",
      "formatted_end": "03:39:23.060",
      "text": "تا ترین فاصله یه بین ما و امریکا بوده"
    },
    {
      "id": 33,
      "start": 13163.06,
      "end": 13164.86,
      "formatted_start": "03:39:23.060",
      "formatted_end": "03:39:24.860",
      "text": "در 1141 کلومتره"
    },
    {
      "id": 34,
      "start": 13164.86,
      "end": 13167.86,
      "formatted_start": "03:39:24.860",
      "formatted_end": "03:39:27.860",
      "text": "برای تیر کردن این فاصله سریع ترین موشک امریکا"
    },
    {
      "id": 35,
      "start": 13167.86,
      "end": 13170.12,
      "formatted_start": "03:39:27.860",
      "formatted_end": "03:39:30.120",
      "text": "حدود 25 دقیقه زمان میاز داره"
    },
    {
      "id": 36,
      "start": 13170.12,
      "end": 13173.92,
      "formatted_start": "03:39:30.120",
      "formatted_end": "03:39:33.920",
      "text": "سریعترین جت دنیا حدود 2 ساعت و 50 دقیقه زمان میبره"
    },
    {
      "id": 37,
      "start": 13173.92,
      "end": 13178.68,
      "formatted_start": "03:39:33.920",
      "formatted_end": "03:39:38.680",
      "text": "جگرده ی افریستو و رفتور حدود 4 ساعت و 12 دقیقه زمان میاز داره"
    },
    {
      "id": 38,
      "start": 13178.68,
      "end": 13183.08,
      "formatted_start": "03:39:38.680",
      "formatted_end": "03:39:43.080",
      "text": "موند آفین رادر گوریز ویدو اسپریت حدود 11 ساعت و 500 دقیقه"
    },
    {
      "id": 39,
      "start": 13183.08,
      "end": 13187.52,
      "formatted_start": "03:39:43.080",
      "formatted_end": "03:39:47.520",
      "text": "یه پرواز مسافر بر یه معمولی حدود 11 ساعت تون میکشه در ماریتی"
    }
  ],
  "status": "completed"
}