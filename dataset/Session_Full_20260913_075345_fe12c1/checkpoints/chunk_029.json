  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8706.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:06.000",
      "text": "باید اونقدر هشت ساعت دور برداریم."
    },
    {
      "id": 1,
      "start": 8712.0,
      "end": 8719.0,
      "formatted_start": "02:25:12.000",
      "formatted_end": "02:25:19.000",
      "text": "بخمین، سلامت شما خوبه، قشه رو تخت بذارید. سلامت، برگتونو بزن بذارید."
    },
    {
      "id": 2,
      "start": 8719.0,
      "end": 8729.0,
      "formatted_start": "02:25:19.000",
      "formatted_end": "02:25:29.000",
      "text": "چی شده جانم؟ نافش رو دوباره برداشتیم، یک تیکه اززاکو مونده بود."
    },
    {
      "id": 3,
      "start": 8729.0,
      "end": 8731.0,
      "formatted_start": "02:25:29.000",
      "formatted_end": "02:25:31.000",
      "text": "اون رو برداشتیم؟"
    },
    {
      "id": 4,
      "start": 8731.0,
      "end": 8733.0,
      "formatted_start": "02:25:31.000",
      "formatted_end": "02:25:33.000",
      "text": "آره، این حال دومشه"
    },
    {
      "id": 5,
      "start": 8733.0,
      "end": 8735.0,
      "formatted_start": "02:25:33.000",
      "formatted_end": "02:25:35.000",
      "text": "باید بیاییم چیزی بردم؟"
    },
    {
      "id": 6,
      "start": 8735.0,
      "end": 8737.0,
      "formatted_start": "02:25:35.000",
      "formatted_end": "02:25:37.000",
      "text": "بیاییم خوش"
    },
    {
      "id": 7,
      "start": 8737.0,
      "end": 8739.0,
      "formatted_start": "02:25:37.000",
      "formatted_end": "02:25:39.000",
      "text": "ارمز دیگه نیست"
    },
    {
      "id": 8,
      "start": 8739.0,
      "end": 8741.0,
      "formatted_start": "02:25:39.000",
      "formatted_end": "02:25:41.000",
      "text": "ارمزی دیگه وجود نداره"
    },
    {
      "id": 9,
      "start": 8741.0,
      "end": 8743.0,
      "formatted_start": "02:25:41.000",
      "formatted_end": "02:25:43.000",
      "text": "بیاییم چیزا بگیرم"
    },
    {
      "id": 10,
      "start": 8743.0,
      "end": 8745.0,
      "formatted_start": "02:25:43.000",
      "formatted_end": "02:25:45.000",
      "text": "خب سمجھت مادر کنم"
    },
    {
      "id": 11,
      "start": 8745.0,
      "end": 8747.0,
      "formatted_start": "02:25:45.000",
      "formatted_end": "02:25:47.000",
      "text": "انا میتونم بهش آب بشونم"
    },
    {
      "id": 12,
      "start": 8747.0,
      "end": 8749.0,
      "formatted_start": "02:25:47.000",
      "formatted_end": "02:25:49.000",
      "text": "سنی شقده؟"
    },
    {
      "id": 13,
      "start": 8749.0,
      "end": 8751.0,
      "formatted_start": "02:25:49.000",
      "formatted_end": "02:25:51.000",
      "text": "نه نه، ششمانگی نمیخواد"
    },
    {
      "id": 14,
      "start": 8751.0,
      "end": 8753.0,
      "formatted_start": "02:25:51.000",
      "formatted_end": "02:25:53.000",
      "text": "من آب بشه"
    },
    {
      "id": 15,
      "start": 8753.0,
      "end": 8755.0,
      "formatted_start": "02:25:53.000",
      "formatted_end": "02:25:55.000",
      "text": "نمیخواد نه، خود شیر خوش"
    },
    {
      "id": 16,
      "start": 8755.0,
      "end": 8757.0,
      "formatted_start": "02:25:55.000",
      "formatted_end": "02:25:57.000",
      "text": "شیر مادر پر آبه"
    },
    {
      "id": 17,
      "start": 8757.0,
      "end": 8759.0,
      "formatted_start": "02:25:57.000",
      "formatted_end": "02:25:59.000",
      "text": "شیر مادر پر آب"
    },
    {
      "id": 18,
      "start": 8759.0,
      "end": 8761.0,
      "formatted_start": "02:25:59.000",
      "formatted_end": "02:26:01.000",
      "text": "هوای گرد، هوای بشنمش"
    },
    {
      "id": 19,
      "start": 8761.0,
      "end": 8763.0,
      "formatted_start": "02:26:01.000",
      "formatted_end": "02:26:03.000",
      "text": "پرین بشه"
    },
    {
      "id": 20,
      "start": 8763.0,
      "end": 8767.0,
      "formatted_start": "02:26:03.000",
      "formatted_end": "02:26:07.000",
      "text": "ولی چون شیر مادر 90% آبه بچه سیر میشه اصلا باید"
    },
    {
      "id": 21,
      "start": 8767.0,
      "end": 8769.0,
      "formatted_start": "02:26:07.000",
      "formatted_end": "02:26:09.000",
      "text": "نیاز نیست نه"
    },
    {
      "id": 22,
      "start": 8769.0,
      "end": 8771.0,
      "formatted_start": "02:26:09.000",
      "formatted_end": "02:26:11.000",
      "text": "ولی آبهای دوری دیسیگنامی نیست"
    },
    {
      "id": 23,
      "start": 8771.0,
      "end": 8775.0,
      "formatted_start": "02:26:11.000",
      "formatted_end": "02:26:15.000",
      "text": "اصلا کجایی نیست که هوای گرد؟ دیسیگنامی این زیرش نشته زیرشششمه ها"
    },
    {
      "id": 24,
      "start": 8775.0,
      "end": 8777.0,
      "formatted_start": "02:26:15.000",
      "formatted_end": "02:26:17.000",
      "text": "نه، گفتید موقعی بیقراری بش ببن"
    },
    {
      "id": 25,
      "start": 8777.0,
      "end": 8781.0,
      "formatted_start": "02:26:17.000",
      "formatted_end": "02:26:21.000",
      "text": "بعد موقعی بیقراری، یعنی هر موقعی که بیقرار شد فرما داشت"
    },
    {
      "id": 26,
      "start": 8781.0,
      "end": 8783.0,
      "formatted_start": "02:26:21.000",
      "formatted_end": "02:26:23.000",
      "text": "روز یه بار"
    },
    {
      "id": 27,
      "start": 8787.0,
      "end": 8817.0,
      "formatted_start": "02:26:27.000",
      "formatted_end": "02:26:57.000",
      "text": "در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا در اینجا د"
    },
    {
      "id": 28,
      "start": 8817.0,
      "end": 8819.0,
      "formatted_start": "02:26:57.000",
      "formatted_end": "02:26:59.000",
      "text": "نه کم میدی تصیب میده"
    },
    {
      "id": 29,
      "start": 8819.0,
      "end": 8821.0,
      "formatted_start": "02:26:59.000",
      "formatted_end": "02:27:01.000",
      "text": "صورت این نمک تو غذا کم میدی"
    },
    {
      "id": 30,
      "start": 8821.0,
      "end": 8823.0,
      "formatted_start": "02:27:01.000",
      "formatted_end": "02:27:03.000",
      "text": "بیرزی نمک کنی"
    },
    {
      "id": 31,
      "start": 8823.0,
      "end": 8828.0,
      "formatted_start": "02:27:03.000",
      "formatted_end": "02:27:08.000",
      "text": "از اون چیزها داره، چربی ها داره، بدنش هم خود برده"
    },
    {
      "id": 32,
      "start": 8828.0,
      "end": 8830.0,
      "formatted_start": "02:27:08.000",
      "formatted_end": "02:27:10.000",
      "text": "اونش رو برده؟ نه، اون رو برده"
    },
    {
      "id": 33,
      "start": 8830.0,
      "end": 8832.0,
      "formatted_start": "02:27:10.000",
      "formatted_end": "02:27:12.000",
      "text": "میره بوده؟ برده، عرضش رو برده"
    },
    {
      "id": 34,
      "start": 8832.0,
      "end": 8834.0,
      "formatted_start": "02:27:12.000",
      "formatted_end": "02:27:14.000",
      "text": "خیلی ممنون، دست شما داره"
    },
    {
      "id": 35,
      "start": 8834.0,
      "end": 8836.0,
      "formatted_start": "02:27:14.000",
      "formatted_end": "02:27:16.000",
      "text": "خواهش میکنم، خدا نگرده"
    },
    {
      "id": 36,
      "start": 8836.0,
      "end": 8838.0,
      "formatted_start": "02:27:16.000",
      "formatted_end": "02:27:18.000",
      "text": "خیلی ممنون، عرضش خدا نگرده"
    },
    {
      "id": 37,
      "start": 8838.0,
      "end": 8840.0,
      "formatted_start": "02:27:18.000",
      "formatted_end": "02:27:20.000",
      "text": "خیلی ممنون، عرضش خدا نگرده"
    },
    {
      "id": 38,
      "start": 8840.0,
      "end": 8842.0,
      "formatted_start": "02:27:20.000",
      "formatted_end": "02:27:22.000",
      "text": "خیلی ممنون، عرضش خدا نگرده"
    },
    {
      "id": 39,
      "start": 8842.0,
      "end": 8844.0,
      "formatted_start": "02:27:22.000",
      "formatted_end": "02:27:24.000",
      "text": "خواهش میکنم، خدا نگرده"
    },
    {
      "id": 40,
      "start": 8844.0,
      "end": 8846.0,
      "formatted_start": "02:27:24.000",
      "formatted_end": "02:27:26.000",
      "text": "خامسامی یک و دیویست با کارت بوده"
    },
    {
      "id": 41,
      "start": 8846.0,
      "end": 8874.0,
      "formatted_start": "02:27:26.000",
      "formatted_end": "02:27:54.000",
      "text": "موسیقی"
    },
    {
      "id": 42,
      "start": 8874.0,
      "end": 8877.36,
      "formatted_start": "02:27:54.000",
      "formatted_end": "02:27:57.360",
      "text": "حالا سلام، سلام زنده داشت، خوب است این سلامتی؟"
    },
    {
      "id": 43,
      "start": 8877.36,
      "end": 8878.96,
      "formatted_start": "02:27:57.360",
      "formatted_end": "02:27:58.960",
      "text": "صداش لذا خوبه؟"
    },
    {
      "id": 44,
      "start": 8878.96,
      "end": 8882.56,
      "formatted_start": "02:27:58.960",
      "formatted_end": "02:28:02.560",
      "text": "قربان شما خوب است این بخش من دستم اینجا بنده و دستم نیم شد"
    },
    {
      "id": 45,
      "start": 8882.56,
      "end": 8884.8,
      "formatted_start": "02:28:02.560",
      "formatted_end": "02:28:04.800",
      "text": "نه خواهش میپردن در اینکه من دستم"
    },
    {
      "id": 46,
      "start": 8884.8,
      "end": 8887.76,
      "formatted_start": "02:28:04.800",
      "formatted_end": "02:28:07.760",
      "text": "سلام دارم، خیلی ممنون ماشاکر"
    },
    {
      "id": 47,
      "start": 8887.76,
      "end": 8889.92,
      "formatted_start": "02:28:07.760",
      "formatted_end": "02:28:09.920",
      "text": "ممنون شما ممنون"
    },
    {
      "id": 48,
      "start": 8889.92,
      "end": 8893.2,
      "formatted_start": "02:28:09.920",
      "formatted_end": "02:28:13.200",
      "text": "فکر نکنم دستتون درد نکنه"
    },
    {
      "id": 49,
      "start": 8893.2,
      "end": 8896.56,
      "formatted_start": "02:28:13.200",
      "formatted_end": "02:28:16.560",
      "text": "نه نه من که اصلا خود ما تهران نیم یا یه ناز"
    },
    {
      "id": 50,
      "start": 8896.56,
      "end": 8902.56,
      "formatted_start": "02:28:16.560",
      "formatted_end": "02:28:22.560",
      "text": "اعتمالاً، نه، اعتمالاً، حالا اگه شاید بیاد شاید نه، چون دوستاش اینا هست"
    },
    {
      "id": 51,
      "start": 8902.56,
      "end": 8908.56,
      "formatted_start": "02:28:22.560",
      "formatted_end": "02:28:28.560",
      "text": "معمولاً دیگه سر پیش اونا میره اینا، دستتون درد نکنه، خیلی ممنون"
    },
    {
      "id": 52,
      "start": 8908.56,
      "end": 8914.56,
      "formatted_start": "02:28:28.560",
      "formatted_end": "02:28:34.560",
      "text": "زنده باشین، سپاس کذارم، خدا نگه داره شما رو، داداش رزا رو، خانواده تونو، مامان تونو"
    },
    {
      "id": 53,
      "start": 8914.56,
      "end": 8922.56,
      "formatted_start": "02:28:34.560",
      "formatted_end": "02:28:42.560",
      "text": "زنده باشین، دستتون همشونی بابات خدا رحمت کنید، خواهش میکنند، خواهش میکنند در خدمت هم"
    },
    {
      "id": 54,
      "start": 8922.56,
      "end": 8937.56,
      "formatted_start": "02:28:42.560",
      "formatted_end": "02:28:57.560",
      "text": "بره؟ بره درسته بره بره درسته"
    },
    {
      "id": 55,
      "start": 8944.56,
      "end": 8947.56,
      "formatted_start": "02:29:04.560",
      "formatted_end": "02:29:07.560",
      "text": "بعد چه دروعه ایوش میدین الان؟"
    },
    {
      "id": 56,
      "start": 8952.56,
      "end": 8955.56,
      "formatted_start": "02:29:12.560",
      "formatted_end": "02:29:15.560",
      "text": "خواهش میدونیم. تب داشته؟"
    },
    {
      "id": 57,
      "start": 8955.56,
      "end": 8960.56,
      "formatted_start": "02:29:15.560",
      "formatted_end": "02:29:20.560",
      "text": "یک سرشکایی هم. تب شریک داشته. یک روز شریک داشته."
    },
    {
      "id": 58,
      "start": 8960.56,
      "end": 8961.56,
      "formatted_start": "02:29:20.560",
      "formatted_end": "02:29:21.560",
      "text": "تب نداریم."
    },
    {
      "id": 59,
      "start": 8961.56,
      "end": 8965.56,
      "formatted_start": "02:29:21.560",
      "formatted_end": "02:29:25.560",
      "text": "یک سرشکایی هم. یک روز شریک داشته. یک روز شریک داشته."
    },
    {
      "id": 60,
      "start": 8965.56,
      "end": 8969.56,
      "formatted_start": "02:29:25.560",
      "formatted_end": "02:29:29.560",
      "text": "تایفا؟ تایفا تایفا؟"
    },
    {
      "id": 61,
      "start": 8969.56,
      "end": 8971.56,
      "formatted_start": "02:29:29.560",
      "formatted_end": "02:29:31.560",
      "text": "تایفا اصلا میدونیده یه."
    },
    {
      "id": 62,
      "start": 8971.56,
      "end": 8973.56,
      "formatted_start": "02:29:31.560",
      "formatted_end": "02:29:33.560",
      "text": "داروی ندادن بهش اصلا."
    },
    {
      "id": 63,
      "start": 8973.56,
      "end": 8976.56,
      "formatted_start": "02:29:33.560",
      "formatted_end": "02:29:36.560",
      "text": "یک شرکا دادن بهش اصلا."
    },
    {
      "id": 64,
      "start": 8976.56,
      "end": 8979.56,
      "formatted_start": "02:29:36.560",
      "formatted_end": "02:29:39.560",
      "text": "یک شرکا دادن بهش اصلا."
    },
    {
      "id": 65,
      "start": 8979.56,
      "end": 8981.56,
      "formatted_start": "02:29:39.560",
      "formatted_end": "02:29:41.560",
      "text": "حال منویم"
    },
    {
      "id": 66,
      "start": 8981.56,
      "end": 8983.56,
      "formatted_start": "02:29:41.560",
      "formatted_end": "02:29:43.560",
      "text": "خود"
    },
    {
      "id": 67,
      "start": 8983.56,
      "end": 8985.56,
      "formatted_start": "02:29:43.560",
      "formatted_end": "02:29:45.560",
      "text": "آدم احساسش در روز چند باره"
    },
    {
      "id": 68,
      "start": 8985.56,
      "end": 8987.56,
      "formatted_start": "02:29:45.560",
      "formatted_end": "02:29:47.560",
      "text": "مثلا در یه 24 ساعت"
    },
    {
      "id": 69,
      "start": 8987.56,
      "end": 8989.56,
      "formatted_start": "02:29:47.560",
      "formatted_end": "02:29:49.560",
      "text": "شدیده خفیده"
    },
    {
      "id": 70,
      "start": 8989.56,
      "end": 8991.56,
      "formatted_start": "02:29:49.560",
      "formatted_end": "02:29:51.560",
      "text": "شدیده"
    },
    {
      "id": 71,
      "start": 8991.56,
      "end": 8993.56,
      "formatted_start": "02:29:51.560",
      "formatted_end": "02:29:53.560",
      "text": "آدم کفت که نداره"
    },
    {
      "id": 72,
      "start": 8993.56,
      "end": 8995.56,
      "formatted_start": "02:29:53.560",
      "formatted_end": "02:29:55.560",
      "text": "آها"
    },
    {
      "id": 73,
      "start": 8995.56,
      "end": 8997.56,
      "formatted_start": "02:29:55.560",
      "formatted_end": "02:29:57.560",
      "text": "حضیعت میشه"
    },
    {
      "id": 74,
      "start": 8997.56,
      "end": 8999.56,
      "formatted_start": "02:29:57.560",
      "formatted_end": "02:29:59.560",
      "text": "خیلی خوب من زندگی داشت باید کنم"
    },
    {
      "id": 75,
      "start": 8999.56,
      "end": 9001.56,
      "formatted_start": "02:29:59.560",
      "formatted_end": "02:30:01.560",
      "text": "احساس"
    }
  ],
  "status": "completed"
}