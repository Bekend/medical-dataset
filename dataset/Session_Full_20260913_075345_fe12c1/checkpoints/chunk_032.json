    },
    {
      "id": 5,
      "start": 9638.0,
      "end": 9640.0,
      "formatted_start": "02:40:38.000",
      "formatted_end": "02:40:40.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 6,
      "start": 9640.0,
      "end": 9642.0,
      "formatted_start": "02:40:40.000",
      "formatted_end": "02:40:42.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 7,
      "start": 9642.0,
      "end": 9644.0,
      "formatted_start": "02:40:42.000",
      "formatted_end": "02:40:44.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 8,
      "start": 9644.0,
      "end": 9646.0,
      "formatted_start": "02:40:44.000",
      "formatted_end": "02:40:46.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 9,
      "start": 9646.0,
      "end": 9648.0,
      "formatted_start": "02:40:46.000",
      "formatted_end": "02:40:48.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 10,
      "start": 9648.0,
      "end": 9650.0,
      "formatted_start": "02:40:48.000",
      "formatted_end": "02:40:50.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 11,
      "start": 9650.0,
      "end": 9652.0,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:52.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 12,
      "start": 9652.0,
      "end": 9661.0,
      "formatted_start": "02:40:52.000",
      "formatted_end": "02:41:01.000",
      "text": "اگر با این مدیره از اینجا باید بردارید، از این مدیره باید بردارید."
    },
    {
      "id": 13,
      "start": 9682.0,
      "end": 9710.0,
      "formatted_start": "02:41:22.000",
      "formatted_end": "02:41:50.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 9710.0,
      "end": 9712.0,
      "formatted_start": "02:41:50.000",
      "formatted_end": "02:41:52.000",
      "text": "کامستانی گرد"
    },
    {
      "id": 15,
      "start": 9730.0,
      "end": 9732.0,
      "formatted_start": "02:42:10.000",
      "formatted_end": "02:42:12.000",
      "text": "بخوند سرمایه"
    },
    {
      "id": 16,
      "start": 9732.0,
      "end": 9734.0,
      "formatted_start": "02:42:12.000",
      "formatted_end": "02:42:14.000",
      "text": "چرا رو تخت بذارید؟"
    },
    {
      "id": 17,
      "start": 9736.0,
      "end": 9738.0,
      "formatted_start": "02:42:16.000",
      "formatted_end": "02:42:18.000",
      "text": "بعد اون برگره بزنید ببینید"
    },
    {
      "id": 18,
      "start": 9740.0,
      "end": 9741.0,
      "formatted_start": "02:42:20.000",
      "formatted_end": "02:42:21.000",
      "text": "چند روزشه؟"
    },
    {
      "id": 19,
      "start": 9741.0,
      "end": 9742.0,
      "formatted_start": "02:42:21.000",
      "formatted_end": "02:42:22.000",
      "text": "این، ما شما شویم"
    },
    {
      "id": 20,
      "start": 9742.0,
      "end": 9744.0,
      "formatted_start": "02:42:22.000",
      "formatted_end": "02:42:24.000",
      "text": "چی شده خانمی سیاد؟"
    },
    {
      "id": 21,
      "start": 9744.0,
      "end": 9748.0,
      "formatted_start": "02:42:24.000",
      "formatted_end": "02:42:28.000",
      "text": "این کار بی زرده داره، اونها گریه بکنیم برو بیرون شده"
    },
    {
      "id": 22,
      "start": 9748.0,
      "end": 9749.0,
      "formatted_start": "02:42:28.000",
      "formatted_end": "02:42:29.000",
      "text": "نه، الان هم زرده هستیم"
    },
    {
      "id": 23,
      "start": 9749.0,
      "end": 9750.0,
      "formatted_start": "02:42:29.000",
      "formatted_end": "02:42:30.000",
      "text": "آره"
    },
    {
      "id": 24,
      "start": 9750.0,
      "end": 9754.0,
      "formatted_start": "02:42:30.000",
      "formatted_end": "02:42:34.000",
      "text": "یک ماه نباید دیگه زرده شده، کلو کنیم بادر نوزاد؟"
    },
    {
      "id": 25,
      "start": 9754.0,
      "end": 9755.0,
      "formatted_start": "02:42:34.000",
      "formatted_end": "02:42:35.000",
      "text": "به مصطفی"
    },
    {
      "id": 26,
      "start": 9755.0,
      "end": 9758.0,
      "formatted_start": "02:42:35.000",
      "formatted_end": "02:42:38.000",
      "text": "به مصطفی، از که این موقعی شده این زرد شده؟"
    },
    {
      "id": 27,
      "start": 9758.0,
      "end": 9760.0,
      "formatted_start": "02:42:38.000",
      "formatted_end": "02:42:40.000",
      "text": "این بردن شده؟"
    },
    {
      "id": 28,
      "start": 9760.0,
      "end": 9764.0,
      "formatted_start": "02:42:40.000",
      "formatted_end": "02:42:44.000",
      "text": "این بردن که کفی نمیشه، به داشت نمیشه، شده بردن بیرون که با شیویتی فلانت نمیشه"
    },
    {
      "id": 29,
      "start": 9764.0,
      "end": 9770.0,
      "formatted_start": "02:42:44.000",
      "formatted_end": "02:42:50.000",
      "text": "نه، دیگه این زردی معمولاً 5 روز یه هفته، نایتاً دو هفته، ولی یه ماه زردی غیر آخریه"
    },
    {
      "id": 30,
      "start": 9770.0,
      "end": 9773.0,
      "formatted_start": "02:42:50.000",
      "formatted_end": "02:42:53.000",
      "text": "این هفته با میل چیز، اول یه بیمارستان دهست؟"
    },
    {
      "id": 31,
      "start": 9773.0,
      "end": 9775.0,
      "formatted_start": "02:42:53.000",
      "formatted_end": "02:42:55.000",
      "text": "این زرده"
    },
    {
      "id": 32,
      "start": 9780.0,
      "end": 9782.0,
      "formatted_start": "02:43:00.000",
      "formatted_end": "02:43:02.000",
      "text": "این بردنش هم هست شده"
    },
    {
      "id": 33,
      "start": 9782.0,
      "end": 9788.0,
      "formatted_start": "02:43:02.000",
      "formatted_end": "02:43:08.000",
      "text": "این بدنش هم به زردی میده"
    },
    {
      "id": 34,
      "start": 9788.0,
      "end": 9794.0,
      "formatted_start": "02:43:08.000",
      "formatted_end": "02:43:14.000",
      "text": "این زردی کل کشیده داره"
    },
    {
      "id": 35,
      "start": 9794.0,
      "end": 9796.0,
      "formatted_start": "02:43:14.000",
      "formatted_end": "02:43:16.000",
      "text": "این زردی که یه ماه هم فیل آسیست"
    },
    {
      "id": 36,
      "start": 9796.0,
      "end": 9800.0,
      "formatted_start": "02:43:16.000",
      "formatted_end": "02:43:20.000",
      "text": "بیمارسان آسمایش گرفت سیر"
    },
    {
      "id": 37,
      "start": 9800.0,
      "end": 9802.0,
      "formatted_start": "02:43:20.000",
      "formatted_end": "02:43:22.000",
      "text": "نه اونو برشون"
    },
    {
      "id": 38,
      "start": 9802.0,
      "end": 9804.0,
      "formatted_start": "02:43:22.000",
      "formatted_end": "02:43:24.000",
      "text": "بیمارسان که گرفت روزای اول که برونی با اونو اومده"
    },
    {
      "id": 39,
      "start": 9804.0,
      "end": 9808.0,
      "formatted_start": "02:43:24.000",
      "formatted_end": "02:43:28.000",
      "text": "نه نه روزای اول برونی برونی برونی"
    },
    {
      "id": 40,
      "start": 9808.0,
      "end": 9810.0,
      "formatted_start": "02:43:28.000",
      "formatted_end": "02:43:30.000",
      "text": "اعتماد همونطور در زدگاه بوده"
    },
    {
      "id": 41,
      "start": 9810.0,
      "end": 9818.0,
      "formatted_start": "02:43:30.000",
      "formatted_end": "02:43:38.000",
      "text": "دستگاه بوده و دستگاه که که دستگاه نکرده باید را بودیم خونه دستگاه"
    },
    {
      "id": 42,
      "start": 9818.0,
      "end": 9825.0,
      "formatted_start": "02:43:38.000",
      "formatted_end": "02:43:45.000",
      "text": "این سمانه که شیر زیاده یا گلیه میدار پنگه"
    },
    {
      "id": 43,
      "start": 9825.0,
      "end": 9832.0,
      "formatted_start": "02:43:45.000",
      "formatted_end": "02:43:52.000",
      "text": "خب این خرید بوده چکتیزه ورده بوده"
    },
    {
      "id": 44,
      "start": 9832.0,
      "end": 9836.0,
      "formatted_start": "02:43:52.000",
      "formatted_end": "02:43:56.000",
      "text": "با آب رکه کن یا مثلا سوزو ورده بده"
    },
    {
      "id": 45,
      "start": 9836.0,
      "end": 9850.0,
      "formatted_start": "02:43:56.000",
      "formatted_end": "02:44:10.000",
      "text": "این چیزی که هست، الان بشه دردی، این دردی غیر عادیه، هر چیز دردی که شروع میده میتونه عوارض عصبی بذاره، حتی اون جیخ زدن اشتباه کرده"
    },
    {
      "id": 46,
      "start": 9850.0,
      "end": 9864.0,
      "formatted_start": "02:44:10.000",
      "formatted_end": "02:44:24.000",
      "text": "اینو یا بخواستدیش کن، آزمایش و دستگاه در بیمارستان، یا دستگاه ببر، بذار، اگه با دستگاه خوب شد، هیچ جگه نشد، باید یه آزمایش قامت بگیر"
    },
    {
      "id": 47,
      "start": 9864.0,
      "end": 9868.0,
      "formatted_start": "02:44:24.000",
      "formatted_end": "02:44:28.000",
      "text": "هر کدام که میخوای همون کار رو معرض دارید"
    },
    {
      "id": 48,
      "start": 9868.0,
      "end": 9870.0,
      "formatted_start": "02:44:28.000",
      "formatted_end": "02:44:30.000",
      "text": "دستگاه میبریم"
    },
    {
      "id": 49,
      "start": 9870.0,
      "end": 9872.0,
      "formatted_start": "02:44:30.000",
      "formatted_end": "02:44:32.000",
      "text": "دستگاه میبریم"
    },
    {
      "id": 50,
      "start": 9872.0,
      "end": 9874.0,
      "formatted_start": "02:44:32.000",
      "formatted_end": "02:44:34.000",
      "text": "از چه آقای ما میخوایم مسافر هستم"
    },
    {
      "id": 51,
      "start": 9874.0,
      "end": 9876.0,
      "formatted_start": "02:44:34.000",
      "formatted_end": "02:44:36.000",
      "text": "این هم خواهد هست"
    },
    {
      "id": 52,
      "start": 9876.0,
      "end": 9878.0,
      "formatted_start": "02:44:36.000",
      "formatted_end": "02:44:38.000",
      "text": "این رو آخر هفته هستم"
    },
    {
      "id": 53,
      "start": 9878.0,
      "end": 9881.0,
      "formatted_start": "02:44:38.000",
      "formatted_end": "02:44:41.000",
      "text": "خب همونطور آخر هفته دستگاه رو بزار تا شمبه"
    },
    {
      "id": 54,
      "start": 9881.0,
      "end": 9884.0,
      "formatted_start": "02:44:41.000",
      "formatted_end": "02:44:44.000",
      "text": "این برس هم بره، کجا میشینی؟"
    },
    {
      "id": 55,
      "start": 9884.0,
      "end": 9885.0,
      "formatted_start": "02:44:44.000",
      "formatted_end": "02:44:45.000",
      "text": "این جاور میشینم"
    },
    {
      "id": 56,
      "start": 9885.0,
      "end": 9886.0,
      "formatted_start": "02:44:45.000",
      "formatted_end": "02:44:46.000",
      "text": "جاور"
    },
    {
      "id": 57,
      "start": 9886.0,
      "end": 9888.0,
      "formatted_start": "02:44:46.000",
      "formatted_end": "02:44:48.000",
      "text": "اگه بیمارستان ببرمش، چند روز ببرم؟"
    },
    {
      "id": 58,
      "start": 9888.0,
      "end": 9890.0,
      "formatted_start": "02:44:48.000",
      "formatted_end": "02:44:50.000",
      "text": "بیمارستان هم یه سه چهار روزی کار داره"
    },
    {
      "id": 59,
      "start": 9890.0,
      "end": 9892.0,
      "formatted_start": "02:44:50.000",
      "formatted_end": "02:44:52.000",
      "text": "فامیلتون؟"
    },
    {
      "id": 60,
      "start": 9892.0,
      "end": 9893.0,
      "formatted_start": "02:44:52.000",
      "formatted_end": "02:44:53.000",
      "text": "سه یاد"
    },
    {
      "id": 61,
      "start": 9893.0,
      "end": 9894.0,
      "formatted_start": "02:44:53.000",
      "formatted_end": "02:44:54.000",
      "text": "فام سه یاد"
    },
    {
      "id": 62,
      "start": 9894.0,
      "end": 9898.0,
      "formatted_start": "02:44:54.000",
      "formatted_end": "02:44:58.000",
      "text": "اگه این دستگاه اگه بخواییم ببرید، این برس هم بگیرید"
    },
    {
      "id": 63,
      "start": 9898.0,
      "end": 9899.0,
      "formatted_start": "02:44:58.000",
      "formatted_end": "02:44:59.000",
      "text": "خب؟"
    },
    {
      "id": 64,
      "start": 9899.0,
      "end": 9900.0,
      "formatted_start": "02:44:59.000",
      "formatted_end": "02:45:00.000",
      "text": "این برس هم بگیرید"
    }
  ],
  "status": "completed"
}