  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11705.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:05.000",
      "text": "از دختر فرستاری طبیل بدید."
    },
    {
      "id": 1,
      "start": 11705.0,
      "end": 11710.0,
      "formatted_start": "03:15:05.000",
      "formatted_end": "03:15:10.000",
      "text": "بره بره، اونجا چیسته میشه؟"
    },
    {
      "id": 2,
      "start": 11710.0,
      "end": 11716.0,
      "formatted_start": "03:15:10.000",
      "formatted_end": "03:15:16.000",
      "text": "خواهش کنم بگو اونجا خانم اوتینی بده، زایشگاه، خواهش کنم بگو."
    },
    {
      "id": 3,
      "start": 11716.0,
      "end": 11720.0,
      "formatted_start": "03:15:16.000",
      "formatted_end": "03:15:20.000",
      "text": "حالا اصلا ببرین زایشگاه به خانم اوتینی بدید."
    },
    {
      "id": 4,
      "start": 11720.0,
      "end": 11724.0,
      "formatted_start": "03:15:20.000",
      "formatted_end": "03:15:24.000",
      "text": "کبکه دوم، زایشگاه."
    },
    {
      "id": 5,
      "start": 11724.0,
      "end": 11729.0,
      "formatted_start": "03:15:24.000",
      "formatted_end": "03:15:29.000",
      "text": "باشه خداحافظ. بگو برای ماشین دیرو سفارش داره."
    },
    {
      "id": 6,
      "start": 11729.0,
      "end": 11731.0,
      "formatted_start": "03:15:29.000",
      "formatted_end": "03:15:31.000",
      "text": "میتوانید"
    },
    {
      "id": 7,
      "start": 11731.0,
      "end": 11733.0,
      "formatted_start": "03:15:31.000",
      "formatted_end": "03:15:33.000",
      "text": "اشیای خوش کنم"
    },
    {
      "id": 8,
      "start": 11733.0,
      "end": 11735.0,
      "formatted_start": "03:15:33.000",
      "formatted_end": "03:15:35.000",
      "text": "از که نامیه کم بشیم"
    },
    {
      "id": 9,
      "start": 11735.0,
      "end": 11737.0,
      "formatted_start": "03:15:35.000",
      "formatted_end": "03:15:37.000",
      "text": "اون قطره که همین دست کنید"
    },
    {
      "id": 10,
      "start": 11741.0,
      "end": 11743.0,
      "formatted_start": "03:15:41.000",
      "formatted_end": "03:15:43.000",
      "text": "اسیب پولی کنید"
    },
    {
      "id": 11,
      "start": 11743.0,
      "end": 11745.0,
      "formatted_start": "03:15:43.000",
      "formatted_end": "03:15:45.000",
      "text": "اسیب پولی"
    },
    {
      "id": 12,
      "start": 11745.0,
      "end": 11747.0,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:47.000",
      "text": "برای اسطفان هم مطلع نشاند"
    },
    {
      "id": 13,
      "start": 11747.0,
      "end": 11749.0,
      "formatted_start": "03:15:47.000",
      "formatted_end": "03:15:49.000",
      "text": "خیلی لفتید بگید"
    },
    {
      "id": 14,
      "start": 11749.0,
      "end": 11751.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:51.000",
      "text": "روزی 15 قطره"
    },
    {
      "id": 15,
      "start": 11751.0,
      "end": 11753.0,
      "formatted_start": "03:15:51.000",
      "formatted_end": "03:15:53.000",
      "text": "خب"
    },
    {
      "id": 16,
      "start": 11753.0,
      "end": 11755.0,
      "formatted_start": "03:15:53.000",
      "formatted_end": "03:15:55.000",
      "text": "بازیار"
    },
    {
      "id": 17,
      "start": 11755.0,
      "end": 11757.0,
      "formatted_start": "03:15:55.000",
      "formatted_end": "03:15:57.000",
      "text": "باشید"
    },
    {
      "id": 18,
      "start": 11757.0,
      "end": 11762.0,
      "formatted_start": "03:15:57.000",
      "formatted_end": "03:16:02.000",
      "text": "شیرخوشتون میدین؟ نه شیرخوشتون که مامنی میدونه"
    },
    {
      "id": 19,
      "start": 11762.0,
      "end": 11767.0,
      "formatted_start": "03:16:02.000",
      "formatted_end": "03:16:07.000",
      "text": "از که اینجوری اصال شده؟ از دنیا آمده اصاله"
    },
    {
      "id": 20,
      "start": 11767.0,
      "end": 11770.0,
      "formatted_start": "03:16:07.000",
      "formatted_end": "03:16:10.000",
      "text": "از پدر روز شدید اصاله"
    },
    {
      "id": 21,
      "start": 11770.0,
      "end": 11774.0,
      "formatted_start": "03:16:10.000",
      "formatted_end": "03:16:14.000",
      "text": "تا روز ۷۸۸ شکمشون شوی پرده اصال آبکی بوده"
    },
    {
      "id": 22,
      "start": 11774.0,
      "end": 11778.0,
      "formatted_start": "03:16:14.000",
      "formatted_end": "03:16:18.000",
      "text": "ولی اینکه خیلی شدید باشه که از کوشارو بزنه بیمون"
    },
    {
      "id": 23,
      "start": 11778.0,
      "end": 11782.0,
      "formatted_start": "03:16:18.000",
      "formatted_end": "03:16:22.000",
      "text": "اصال های مرضی بیماریه"
    },
    {
      "id": 24,
      "start": 11787.0,
      "end": 11801.0,
      "formatted_start": "03:16:27.000",
      "formatted_end": "03:16:41.000",
      "text": "و مثلا اگر شیر خشکشونو هایی بتونین الف بدین بهتره مثلا شیر خشک نان الف یا بلاک الف برای اصحاب خوبه"
    },
    {
      "id": 25,
      "start": 11801.0,
      "end": 11806.0,
      "formatted_start": "03:16:41.000",
      "formatted_end": "03:16:46.000",
      "text": "یا کل هم گیگوز الف هرچی الف باشه خوبه برای شیر خشک"
    },
    {
      "id": 26,
      "start": 11806.0,
      "end": 11810.0,
      "formatted_start": "03:16:46.000",
      "formatted_end": "03:16:50.000",
      "text": "دردوزه مشکل نمیدونی؟ نه"
    },
    {
      "id": 27,
      "start": 11810.0,
      "end": 11812.0,
      "formatted_start": "03:16:50.000",
      "formatted_end": "03:16:52.000",
      "text": "این دروار رو بیاریم هم بیاریم"
    },
    {
      "id": 28,
      "start": 11812.0,
      "end": 11814.0,
      "formatted_start": "03:16:52.000",
      "formatted_end": "03:16:54.000",
      "text": "این دهن رو شرمش خوش میشه"
    },
    {
      "id": 29,
      "start": 11814.0,
      "end": 11816.0,
      "formatted_start": "03:16:54.000",
      "formatted_end": "03:16:56.000",
      "text": "اون چیز رو خواستید؟"
    },
    {
      "id": 30,
      "start": 11816.0,
      "end": 11818.0,
      "formatted_start": "03:16:56.000",
      "formatted_end": "03:16:58.000",
      "text": "اصحاب هست، آب و بدن کم میشه"
    },
    {
      "id": 31,
      "start": 11818.0,
      "end": 11820.0,
      "formatted_start": "03:16:58.000",
      "formatted_end": "03:17:00.000",
      "text": "باید مایات بگیرم"
    },
    {
      "id": 32,
      "start": 11820.0,
      "end": 11822.0,
      "formatted_start": "03:17:00.000",
      "formatted_end": "03:17:02.000",
      "text": "درستون داریم"
    },
    {
      "id": 33,
      "start": 11822.0,
      "end": 11824.0,
      "formatted_start": "03:17:02.000",
      "formatted_end": "03:17:04.000",
      "text": "خداحافظ"
    },
    {
      "id": 34,
      "start": 11824.0,
      "end": 11826.0,
      "formatted_start": "03:17:04.000",
      "formatted_end": "03:17:06.000",
      "text": "این دهن رو شرمش خوش میشه"
    },
    {
      "id": 35,
      "start": 11826.0,
      "end": 11828.0,
      "formatted_start": "03:17:06.000",
      "formatted_end": "03:17:08.000",
      "text": "اون چیز رو خواستید؟"
    },
    {
      "id": 36,
      "start": 11828.0,
      "end": 11830.0,
      "formatted_start": "03:17:08.000",
      "formatted_end": "03:17:10.000",
      "text": "این دهن رو شرمش خواستید؟"
    },
    {
      "id": 37,
      "start": 11830.0,
      "end": 11832.0,
      "formatted_start": "03:17:10.000",
      "formatted_end": "03:17:12.000",
      "text": "این دهن رو شرمش خواستید؟"
    },
    {
      "id": 38,
      "start": 11832.0,
      "end": 11834.0,
      "formatted_start": "03:17:12.000",
      "formatted_end": "03:17:14.000",
      "text": "این دهن رو شرمش خواستید؟"
    },
    {
      "id": 39,
      "start": 11834.0,
      "end": 11836.0,
      "formatted_start": "03:17:14.000",
      "formatted_end": "03:17:16.000",
      "text": "این دهن رو شرمش خواستید؟"
    },
    {
      "id": 40,
      "start": 11836.0,
      "end": 11838.0,
      "formatted_start": "03:17:16.000",
      "formatted_end": "03:17:18.000",
      "text": "برای کسی"
    },
    {
      "id": 41,
      "start": 11845.0,
      "end": 11847.0,
      "formatted_start": "03:17:25.000",
      "formatted_end": "03:17:27.000",
      "text": "530.39"
    },
    {
      "id": 42,
      "start": 11855.0,
      "end": 11857.0,
      "formatted_start": "03:17:35.000",
      "formatted_end": "03:17:37.000",
      "text": "بخونید"
    },
    {
      "id": 43,
      "start": 11857.0,
      "end": 11860.0,
      "formatted_start": "03:17:37.000",
      "formatted_end": "03:17:40.000",
      "text": "میخوایید خواهمیتون بیاد مادر بچه"
    },
    {
      "id": 44,
      "start": 11860.0,
      "end": 11862.0,
      "formatted_start": "03:17:40.000",
      "formatted_end": "03:17:42.000",
      "text": "گوش شده ایم؟"
    },
    {
      "id": 45,
      "start": 11862.0,
      "end": 11864.0,
      "formatted_start": "03:17:42.000",
      "formatted_end": "03:17:44.000",
      "text": "نه"
    },
    {
      "id": 46,
      "start": 11864.0,
      "end": 11869.0,
      "formatted_start": "03:17:44.000",
      "formatted_end": "03:17:49.000",
      "text": "دیگه این روزی دو بار میدیم این روزی سه بار"
    },
    {
      "id": 47,
      "start": 11869.0,
      "end": 11876.0,
      "formatted_start": "03:17:49.000",
      "formatted_end": "03:17:56.000",
      "text": "این هم تو چهار تا دیوانت ها پوشیده سرد شده تو پارش برید یه وسط در این هم برید سه رومه"
    },
    {
      "id": 48,
      "start": 11876.0,
      "end": 11878.0,
      "formatted_start": "03:17:56.000",
      "formatted_end": "03:17:58.000",
      "text": "هر چقدر آبخواست از این بیش بوده"
    },
    {
      "id": 49,
      "start": 11878.0,
      "end": 11883.0,
      "formatted_start": "03:17:58.000",
      "formatted_end": "03:18:03.000",
      "text": "خیلی آقای دوتای این شیر پشت همین شیر پشت به از دلار بخورده گه"
    },
    {
      "id": 50,
      "start": 11883.0,
      "end": 11887.0,
      "formatted_start": "03:18:03.000",
      "formatted_end": "03:18:07.000",
      "text": "تا اید بخورده دیگه از اید بخورده نخورده شیر با آف مخورش کننه"
    },
    {
      "id": 51,
      "start": 11887.0,
      "end": 11889.0,
      "formatted_start": "03:18:07.000",
      "formatted_end": "03:18:09.000",
      "text": "نه نخورده نه نه"
    },
    {
      "id": 52,
      "start": 11889.0,
      "end": 11891.0,
      "formatted_start": "03:18:09.000",
      "formatted_end": "03:18:11.000",
      "text": "نه اگر مثلا شیرکشت بخوریدیم"
    },
    {
      "id": 53,
      "start": 11891.0,
      "end": 11892.0,
      "formatted_start": "03:18:11.000",
      "formatted_end": "03:18:12.000",
      "text": "بعد از که اشکال نداریم"
    },
    {
      "id": 54,
      "start": 11892.0,
      "end": 11893.0,
      "formatted_start": "03:18:12.000",
      "formatted_end": "03:18:13.000",
      "text": "دیگه اونو نداریم هایی جایی"
    },
    {
      "id": 55,
      "start": 11893.0,
      "end": 11894.0,
      "formatted_start": "03:18:13.000",
      "formatted_end": "03:18:14.000",
      "text": "نه بیدونم"
    },
    {
      "id": 56,
      "start": 11894.0,
      "end": 11895.0,
      "formatted_start": "03:18:14.000",
      "formatted_end": "03:18:15.000",
      "text": "دست درده باشیم"
    },
    {
      "id": 57,
      "start": 11895.0,
      "end": 11896.0,
      "formatted_start": "03:18:15.000",
      "formatted_end": "03:18:16.000",
      "text": "شیرکشت نداریم"
    },
    {
      "id": 58,
      "start": 11896.0,
      "end": 11898.0,
      "formatted_start": "03:18:16.000",
      "formatted_end": "03:18:18.000",
      "text": "هر هشت سازی اینو در بوده سازیم"
    },
    {
      "id": 59,
      "start": 11898.0,
      "end": 11899.0,
      "formatted_start": "03:18:18.000",
      "formatted_end": "03:18:19.000",
      "text": "بله دقیقا"
    },
    {
      "id": 60,
      "start": 11899.0,
      "end": 11900.0,
      "formatted_start": "03:18:19.000",
      "formatted_end": "03:18:20.000",
      "text": "دست درده باشیم"
    },
    {
      "id": 61,
      "start": 11900.0,
      "end": 11901.0,
      "formatted_start": "03:18:20.000",
      "formatted_end": "03:18:21.000",
      "text": "بله شیرکشت"
    },
    {
      "id": 62,
      "start": 11901.0,
      "end": 11903.0,
      "formatted_start": "03:18:21.000",
      "formatted_end": "03:18:23.000",
      "text": "اون چیزی هم بده میرسیم اون را"
    },
    {
      "id": 63,
      "start": 11903.0,
      "end": 11905.0,
      "formatted_start": "03:18:23.000",
      "formatted_end": "03:18:25.000",
      "text": "کدام بود؟"
    },
    {
      "id": 64,
      "start": 11905.0,
      "end": 11906.0,
      "formatted_start": "03:18:25.000",
      "formatted_end": "03:18:26.000",
      "text": "منظرامین؟"
    },
    {
      "id": 65,
      "start": 11906.0,
      "end": 11907.0,
      "formatted_start": "03:18:26.000",
      "formatted_end": "03:18:27.000",
      "text": "منظرامین آره آره"
    },
    {
      "id": 66,
      "start": 11907.0,
      "end": 11909.0,
      "formatted_start": "03:18:27.000",
      "formatted_end": "03:18:29.000",
      "text": "یک حالت استفراختاله باشیم"
    },
    {
      "id": 67,
      "start": 11909.0,
      "end": 11910.0,
      "formatted_start": "03:18:29.000",
      "formatted_end": "03:18:30.000",
      "text": "ممنون"
    },
    {
      "id": 68,
      "start": 11910.0,
      "end": 11912.0,
      "formatted_start": "03:18:30.000",
      "formatted_end": "03:18:32.000",
      "text": "مام، خدا"
    },
    {
      "id": 69,
      "start": 11940.0,
      "end": 11960.0,
      "formatted_start": "03:19:00.000",
