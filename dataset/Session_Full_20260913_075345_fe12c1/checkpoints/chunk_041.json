      "formatted_end": "03:26:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 12380.0,
      "end": 12404.0,
      "formatted_start": "03:26:20.000",
      "formatted_end": "03:26:44.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 12404.0,
      "end": 12414.0,
      "formatted_start": "03:26:44.000",
      "formatted_end": "03:26:54.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 12434.0,
      "end": 12436.0,
      "formatted_start": "03:27:14.000",
      "formatted_end": "03:27:16.000",
      "text": "از دیگه ها همه چیزی هست"
    },
    {
      "id": 6,
      "start": 12436.0,
      "end": 12438.0,
      "formatted_start": "03:27:16.000",
      "formatted_end": "03:27:18.000",
      "text": "داری چی میگی؟"
    },
    {
      "id": 7,
      "start": 12438.0,
      "end": 12440.0,
      "formatted_start": "03:27:18.000",
      "formatted_end": "03:27:20.000",
      "text": "داری دروغ میگی"
    },
    {
      "id": 8,
      "start": 12440.0,
      "end": 12442.0,
      "formatted_start": "03:27:20.000",
      "formatted_end": "03:27:22.000",
      "text": "تو داری به من خیالت میکنی"
    },
    {
      "id": 9,
      "start": 12442.0,
      "end": 12444.0,
      "formatted_start": "03:27:22.000",
      "formatted_end": "03:27:24.000",
      "text": "برمی افراد با این شده"
    },
    {
      "id": 10,
      "start": 12444.0,
      "end": 12446.0,
      "formatted_start": "03:27:24.000",
      "formatted_end": "03:27:26.000",
      "text": "در آن درگوی پراجه"
    },
    {
      "id": 11,
      "start": 12446.0,
      "end": 12448.0,
      "formatted_start": "03:27:26.000",
      "formatted_end": "03:27:28.000",
      "text": "این کار دارم دیگه بوده میشم"
    },
    {
      "id": 12,
      "start": 12448.0,
      "end": 12450.0,
      "formatted_start": "03:27:28.000",
      "formatted_end": "03:27:30.000",
      "text": "من این کار دارم دقیقا در جهه"
    },
    {
      "id": 13,
      "start": 12450.0,
      "end": 12452.0,
      "formatted_start": "03:27:30.000",
      "formatted_end": "03:27:32.000",
      "text": "با مرمز ها خراجه"
    },
    {
      "id": 14,
      "start": 12452.0,
      "end": 12454.0,
      "formatted_start": "03:27:32.000",
      "formatted_end": "03:27:34.000",
      "text": "کنگید بگید که"
    },
    {
      "id": 15,
      "start": 12454.0,
      "end": 12456.0,
      "formatted_start": "03:27:34.000",
      "formatted_end": "03:27:36.000",
      "text": "در پارت نرم"
    },
    {
      "id": 16,
      "start": 12456.0,
      "end": 12458.0,
      "formatted_start": "03:27:36.000",
      "formatted_end": "03:27:38.000",
      "text": "این کار درگوی پراجه"
    },
    {
      "id": 17,
      "start": 12458.0,
      "end": 12460.0,
      "formatted_start": "03:27:38.000",
      "formatted_end": "03:27:40.000",
      "text": "در این کار درگوی پراجه"
    },
    {
      "id": 18,
      "start": 12460.0,
      "end": 12462.0,
      "formatted_start": "03:27:40.000",
      "formatted_end": "03:27:42.000",
      "text": "این کار درگوی پراجه"
    },
    {
      "id": 19,
      "start": 12492.0,
      "end": 12498.0,
      "formatted_start": "03:28:12.000",
      "formatted_end": "03:28:18.000",
      "text": "و میگن که این ها در یه اسمانی را شما میگن شناسید"
    },
    {
      "id": 20,
      "start": 12498.0,
      "end": 12500.0,
      "formatted_start": "03:28:18.000",
      "formatted_end": "03:28:20.000",
      "text": "این میگن که این ها در یه اسمان شناسید"
    },
    {
      "id": 21,
      "start": 12500.0,
      "end": 12502.0,
      "formatted_start": "03:28:20.000",
      "formatted_end": "03:28:22.000",
      "text": "که همه نیز هم جامعه شناسید"
    },
    {
      "id": 22,
      "start": 12502.0,
      "end": 12505.0,
      "formatted_start": "03:28:22.000",
      "formatted_end": "03:28:25.000",
      "text": "شما در یه نیز هم را بگویید شناسید"
    },
    {
      "id": 23,
      "start": 12505.0,
      "end": 12508.0,
      "formatted_start": "03:28:25.000",
      "formatted_end": "03:28:28.000",
      "text": "اگر شناسید بگویید بگویید از نگه را بگویید"
    },
    {
      "id": 24,
      "start": 12508.0,
      "end": 12511.0,
      "formatted_start": "03:28:28.000",
      "formatted_end": "03:28:31.000",
      "text": "اگر شناسید نیز شناسید به نقیقی را بگویید"
    },
    {
      "id": 25,
      "start": 12511.0,
      "end": 12514.0,
      "formatted_start": "03:28:31.000",
      "formatted_end": "03:28:34.000",
      "text": "که هر آن که اون را به یه اسمانی بگویید"
    },
    {
      "id": 26,
      "start": 12514.0,
      "end": 12515.0,
      "formatted_start": "03:28:34.000",
      "formatted_end": "03:28:35.000",
