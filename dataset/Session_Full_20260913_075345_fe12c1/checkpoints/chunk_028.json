  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8402.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 8402.0,
      "end": 8404.0,
      "formatted_start": "02:20:02.000",
      "formatted_end": "02:20:04.000",
      "text": "خداحافظ."
    },
    {
      "id": 2,
      "start": 8404.0,
      "end": 8406.0,
      "formatted_start": "02:20:04.000",
      "formatted_end": "02:20:06.000",
      "text": "درست شما درده."
    },
    {
      "id": 3,
      "start": 8406.0,
      "end": 8408.0,
      "formatted_start": "02:20:06.000",
      "formatted_end": "02:20:08.000",
      "text": "خواهش میکنم. خداحافظ."
    },
    {
      "id": 4,
      "start": 8410.0,
      "end": 8412.0,
      "formatted_start": "02:20:10.000",
      "formatted_end": "02:20:12.000",
      "text": "دستکار ها یک تکتر داریم."
    },
    {
      "id": 5,
      "start": 8412.0,
      "end": 8414.0,
      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:14.000",
      "text": "ها دستکار یک شب تکتر داریم."
    },
    {
      "id": 6,
      "start": 8414.0,
      "end": 8416.0,
      "formatted_start": "02:20:14.000",
      "formatted_end": "02:20:16.000",
      "text": "سلام."
    },
    {
      "id": 7,
      "start": 8416.0,
      "end": 8418.0,
      "formatted_start": "02:20:16.000",
      "formatted_end": "02:20:18.000",
      "text": "سلام."
    },
    {
      "id": 8,
      "start": 8418.0,
      "end": 8420.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:20.000",
      "text": "خوش آمدید."
    },
    {
      "id": 9,
      "start": 8420.0,
      "end": 8422.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:22.000",
      "text": "خوش آمدید."
    },
    {
      "id": 10,
      "start": 8422.0,
      "end": 8424.0,
      "formatted_start": "02:20:22.000",
      "formatted_end": "02:20:24.000",
      "text": "خواهش میکنم."
    },
    {
      "id": 11,
      "start": 8424.0,
      "end": 8426.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:26.000",
      "text": "برگتونو بیزردید."
    },
    {
      "id": 12,
      "start": 8426.0,
      "end": 8428.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:28.000",
      "text": "ماشین داده بود."
    },
    {
      "id": 13,
      "start": 8428.0,
      "end": 8430.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:30.000",
      "text": "چی شده باید؟"
    },
    {
      "id": 14,
      "start": 8430.0,
      "end": 8433.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:33.000",
      "text": "شروع مای دو روز، دیگر روز، هر روز اصحال میره"
    },
    {
      "id": 15,
      "start": 8433.0,
      "end": 8434.0,
      "formatted_start": "02:20:33.000",
      "formatted_end": "02:20:34.000",
      "text": "اصحال شده؟"
    },
    {
      "id": 16,
      "start": 8434.0,
      "end": 8435.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:35.000",
      "text": "آره"
    },
    {
      "id": 17,
      "start": 8435.0,
      "end": 8436.0,
      "formatted_start": "02:20:35.000",
      "formatted_end": "02:20:36.000",
      "text": "استفراع هم داره؟"
    },
    {
      "id": 18,
      "start": 8436.0,
      "end": 8437.0,
      "formatted_start": "02:20:36.000",
      "formatted_end": "02:20:37.000",
      "text": "نه استفراع هم نداره"
    },
    {
      "id": 19,
      "start": 8437.0,
      "end": 8438.0,
      "formatted_start": "02:20:37.000",
      "formatted_end": "02:20:38.000",
      "text": "تب اینا چی؟"
    },
    {
      "id": 20,
      "start": 8438.0,
      "end": 8440.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:40.000",
      "text": "من متوجه تبشم نشدم"
    },
    {
      "id": 21,
      "start": 8440.0,
      "end": 8441.0,
      "formatted_start": "02:20:40.000",
      "formatted_end": "02:20:41.000",
      "text": "بعد اصحال هره؟"
    },
    {
      "id": 22,
      "start": 8441.0,
      "end": 8446.0,
      "formatted_start": "02:20:41.000",
      "formatted_end": "02:20:46.000",
      "text": "بعد اصحالش بدجوریه، الان دیشب هم نصف شب برن شد"
    },
    {
      "id": 23,
      "start": 8446.0,
      "end": 8450.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:50.000",
      "text": "من تا دیشب صف گرم بخورتم شب پاتی پاتی کردی"
    },
    {
      "id": 24,
      "start": 8450.0,
      "end": 8453.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:53.000",
      "text": "چیزی دیگر هم ندیشب، امروز صبح بباره اصحال شده"
    },
    {
      "id": 25,
      "start": 8453.0,
      "end": 8454.34,
      "formatted_start": "02:20:53.000",
      "formatted_end": "02:20:54.340",
      "text": "سنیت چه هرده؟"
    },
    {
      "id": 26,
      "start": 8454.34,
      "end": 8456.14,
      "formatted_start": "02:20:54.340",
      "formatted_end": "02:20:56.140",
      "text": "این سال رو یک ها"
    },
    {
      "id": 27,
      "start": 8456.8,
      "end": 8458.8,
      "formatted_start": "02:20:56.800",
      "formatted_end": "02:20:58.800",
      "text": "داروی چیزی هم دادی برای سالش؟"
    },
    {
      "id": 28,
      "start": 8458.8,
      "end": 8459.8,
      "formatted_start": "02:20:58.800",
      "formatted_end": "02:20:59.800",
      "text": "هیچ چی"
    },
    {
      "id": 29,
      "start": 8459.8,
      "end": 8461.8,
      "formatted_start": "02:20:59.800",
      "formatted_end": "02:21:01.800",
      "text": "بزنند رو تخت بزنی؟"
    },
    {
      "id": 30,
      "start": 8461.8,
      "end": 8462.8,
      "formatted_start": "02:21:01.800",
      "formatted_end": "02:21:02.800",
      "text": "بزنند"
    },
    {
      "id": 31,
      "start": 8464.24,
      "end": 8469.1,
      "formatted_start": "02:21:04.240",
      "formatted_end": "02:21:09.100",
      "text": "این هر چی درد می‌کنیم درسته انگیز رو برده فیلم برده"
    },
    {
      "id": 32,
      "start": 8469.1,
      "end": 8474.1,
      "formatted_start": "02:21:09.100",
      "formatted_end": "02:21:14.100",
      "text": "چون این کار پرچه، ماشاله بخور هم هست داره، همین حال نون در دستش"
    },
    {
      "id": 33,
      "start": 8474.1,
      "end": 8476.1,
      "formatted_start": "02:21:14.100",
      "formatted_end": "02:21:16.100",
      "text": "نیم، نون خور شده"
    },
    {
      "id": 34,
      "start": 8476.1,
      "end": 8477.1,
      "formatted_start": "02:21:16.100",
      "formatted_end": "02:21:17.100",
      "text": "آره؟"
    },
    {
      "id": 35,
      "start": 8477.6,
      "end": 8478.6,
      "formatted_start": "02:21:17.600",
      "formatted_end": "02:21:18.600",
      "text": "اسمی شیه؟"
    },
    {
      "id": 36,
      "start": 8478.6,
      "end": 8479.6,
      "formatted_start": "02:21:18.600",
      "formatted_end": "02:21:19.600",
      "text": "مارتیه"
    },
    {
      "id": 37,
      "start": 8479.6,
      "end": 8480.6,
      "formatted_start": "02:21:19.600",
      "formatted_end": "02:21:20.600",
      "text": "مارتیه"
    },
    {
      "id": 38,
      "start": 8480.6,
      "end": 8482.1,
      "formatted_start": "02:21:20.600",
      "formatted_end": "02:21:22.100",
      "text": "بچه دیوانی هست"
    },
    {
      "id": 39,
      "start": 8482.1,
      "end": 8484.1,
      "formatted_start": "02:21:22.100",
      "formatted_end": "02:21:24.100",
      "text": "باید بچه بودن"
    },
    {
      "id": 40,
      "start": 8484.1,
      "end": 8485.1,
      "formatted_start": "02:21:24.100",
      "formatted_end": "02:21:25.100",
      "text": "نه مجود"
    },
    {
      "id": 41,
      "start": 8485.1,
      "end": 8486.1,
      "formatted_start": "02:21:25.100",
      "formatted_end": "02:21:26.100",
      "text": "مانتونم"
    },
    {
      "id": 42,
      "start": 8486.1,
      "end": 8487.1,
      "formatted_start": "02:21:26.100",
      "formatted_end": "02:21:27.100",
      "text": "ماما"
    },
    {
      "id": 43,
      "start": 8487.1,
      "end": 8489.1,
      "formatted_start": "02:21:27.100",
      "formatted_end": "02:21:29.100",
      "text": "دستاشو نگه داریم؟"
    },
    {
      "id": 44,
      "start": 8489.1,
      "end": 8490.1,
      "formatted_start": "02:21:29.100",
      "formatted_end": "02:21:30.100",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 8490.1,
      "end": 8492.1,
      "formatted_start": "02:21:30.100",
      "formatted_end": "02:21:32.100",
      "text": "اوه بچه دونتو مخور دونتو مخور"
    },
    {
      "id": 46,
      "start": 8492.1,
      "end": 8493.1,
      "formatted_start": "02:21:32.100",
      "formatted_end": "02:21:33.100",
      "text": "دونتو مخور"
    },
    {
      "id": 47,
      "start": 8493.1,
      "end": 8494.1,
      "formatted_start": "02:21:33.100",
      "formatted_end": "02:21:34.100",
      "text": "کافره"
    },
    {
      "id": 48,
      "start": 8494.1,
      "end": 8496.1,
      "formatted_start": "02:21:34.100",
      "formatted_end": "02:21:36.100",
      "text": "باید این باید قرار داد ببندید و"
    },
    {
      "id": 49,
      "start": 8497.1,
      "end": 8498.1,
      "formatted_start": "02:21:37.100",
      "formatted_end": "02:21:38.100",
      "text": "آرچه را"
    },
    {
      "id": 50,
      "start": 8498.1,
      "end": 8500.1,
      "formatted_start": "02:21:38.100",
      "formatted_end": "02:21:40.100",
      "text": "نه دستاشو نگه داریم"
    },
    {
      "id": 51,
      "start": 8500.1,
      "end": 8501.1,
      "formatted_start": "02:21:40.100",
      "formatted_end": "02:21:41.100",
      "text": "دستاشو نگه داریم"
    },
    {
      "id": 52,
      "start": 8502.1,
      "end": 8503.1,
      "formatted_start": "02:21:42.100",
      "formatted_end": "02:21:43.100",
      "text": "نه نموکن بگو"
    },
    {
      "id": 53,
      "start": 8503.1,
      "end": 8505.1,
      "formatted_start": "02:21:43.100",
      "formatted_end": "02:21:45.100",
      "text": "نه دستشو نگه داریم"
    },
    {
      "id": 54,
      "start": 8506.1,
      "end": 8507.1,
      "formatted_start": "02:21:46.100",
      "formatted_end": "02:21:47.100",
      "text": "بریم اونجور"
    },
    {
      "id": 55,
      "start": 8507.1,
      "end": 8508.1,
      "formatted_start": "02:21:47.100",
      "formatted_end": "02:21:48.100",
      "text": "باید کلپا"
    },
    {
      "id": 56,
      "start": 8510.1,
      "end": 8511.1,
      "formatted_start": "02:21:50.100",
      "formatted_end": "02:21:51.100",
      "text": "باید یه رنگه"
    },
    {
      "id": 57,
      "start": 8512.1,
      "end": 8520.1,
      "formatted_start": "02:21:52.100",
      "formatted_end": "02:22:00.100",
      "text": "جنجو جنجو هر شهرم خوش آگرد"
    },
    {
      "id": 58,
      "start": 8520.1,
      "end": 8528.1,
      "formatted_start": "02:22:00.100",
      "formatted_end": "02:22:08.100",
      "text": "جنجو جنجو همون شد"
    },
    {
      "id": 59,
      "start": 8528.1,
      "end": 8534.1,
      "formatted_start": "02:22:08.100",
      "formatted_end": "02:22:14.100",
      "text": "خب این عفونت بوده ای کرده مصنوعیت غذایی از جزئه بوده می بینی"
    },
    {
      "id": 60,
      "start": 8534.1,
      "end": 8536.1,
      "formatted_start": "02:22:14.100",
      "formatted_end": "02:22:16.100",
      "text": "بهش نساخته"
    },
    {
      "id": 61,
      "start": 8536.1,
      "end": 8538.1,
      "formatted_start": "02:22:16.100",
      "formatted_end": "02:22:18.100",
      "text": "بهش موز بدین"
    },
    {
      "id": 62,
      "start": 8538.1,
      "end": 8540.1,
      "formatted_start": "02:22:18.100",
      "formatted_end": "02:22:20.100",
      "text": "کت ماسیر"
    },
    {
      "id": 63,
      "start": 8540.1,
      "end": 8542.1,
      "formatted_start": "02:22:20.100",
      "formatted_end": "02:22:22.100",
      "text": "کش، دو، آب، چایی"
    },
    {
      "id": 64,
      "start": 8542.1,
      "end": 8544.1,
      "formatted_start": "02:22:22.100",
      "formatted_end": "02:22:24.100",
      "text": "سیر؟"
    },
    {
      "id": 65,
      "start": 8544.1,
      "end": 8546.1,
      "formatted_start": "02:22:24.100",
      "formatted_end": "02:22:26.100",
      "text": "کت ماسیر، کته و ماسیر"
    },
    {
      "id": 66,
      "start": 8546.1,
      "end": 8548.1,
      "formatted_start": "02:22:26.100",
      "formatted_end": "02:22:28.100",
      "text": "اینا باید اصحاب خوبه ایرانده"
    },
    {
      "id": 67,
      "start": 8548.1,
      "end": 8550.1,
      "formatted_start": "02:22:28.100",
      "formatted_end": "02:22:30.100",
      "text": "نوش آبه ندید"
    },
    {
      "id": 68,
      "start": 8550.1,
      "end": 8552.1,
      "formatted_start": "02:22:30.100",
      "formatted_end": "02:22:32.100",
      "text": "آب میوه وازار ندید"
    },
    {
      "id": 69,
      "start": 8552.1,
      "end": 8554.1,
      "formatted_start": "02:22:32.100",
      "formatted_end": "02:22:34.100",
      "text": "غذایی روغنیه یا شیرینه ندید"
    },
    {
      "id": 70,
      "start": 8554.1,
      "end": 8556.1,
      "formatted_start": "02:22:34.100",
      "formatted_end": "02:22:36.100",
      "text": "ولی بهترینش همین"
    },
    {
      "id": 71,
      "start": 8556.1,
      "end": 8558.1,
      "formatted_start": "02:22:36.100",
      "formatted_end": "02:22:38.100",
      "text": "کته و کش و دو و ماس"
    },
    {
      "id": 72,
      "start": 8558.1,
      "end": 8560.1,
      "formatted_start": "02:22:38.100",
      "formatted_end": "02:22:40.100",
      "text": "و آب و چایی نبیشتر دید"
    },
    {
      "id": 73,
      "start": 8560.1,
      "end": 8562.1,
      "formatted_start": "02:22:40.100",
      "formatted_end": "02:22:42.100",
      "text": "کترای آهنگشینه رو بدین"
    },
    {
      "id": 74,
      "start": 8562.1,
      "end": 8564.1,
      "formatted_start": "02:22:42.100",
      "formatted_end": "02:22:44.100",
      "text": "اگر تپ داره ندید"
    },
    {
      "id": 75,
      "start": 8564.1,
      "end": 8566.1,
      "formatted_start": "02:22:44.100",
      "formatted_end": "02:22:46.100",
      "text": "اگر تپ نداره"
    },
    {
      "id": 76,
      "start": 8566.1,
      "end": 8568.1,
      "formatted_start": "02:22:46.100",
      "formatted_end": "02:22:48.100",
      "text": "اگر تپ داره بگید"
    },
    {
      "id": 77,
      "start": 8568.1,
      "end": 8570.1,
      "formatted_start": "02:22:48.100",
      "formatted_end": "02:22:50.100",
      "text": "اگر تپ داشت ندید"
    },
    {
      "id": 78,
      "start": 8570.1,
      "end": 8572.1,
      "formatted_start": "02:22:50.100",
      "formatted_end": "02:22:52.100",
      "text": "مذارتون"
    },
    {
      "id": 79,
      "start": 8572.1,
      "end": 8574.1,
      "formatted_start": "02:22:52.100",
      "formatted_end": "02:22:54.100",
      "text": "این برقا رفتند"
    },
    {
      "id": 80,
      "start": 8574.1,
      "end": 8576.1,
      "formatted_start": "02:22:54.100",
      "formatted_end": "02:22:56.100",
      "text": "صرف این 40 دقیقه دیگه برقا میاد"
    },
    {
      "id": 81,
      "start": 8576.1,
      "end": 8578.1,
      "formatted_start": "02:22:56.100",
      "formatted_end": "02:22:58.100",
      "text": "میخواید اگر بیمه بگیدید دروار شده با من؟"
    },
    {
      "id": 82,
      "start": 8578.1,
      "end": 8580.1,
      "formatted_start": "02:22:58.100",
      "formatted_end": "02:23:00.100",
      "text": "نه"
    },
    {
      "id": 83,
      "start": 8580.1,
      "end": 8582.1,
      "formatted_start": "02:23:00.100",
      "formatted_end": "02:23:02.100",
      "text": "حاضر میگیرم"
    },
    {
      "id": 84,
      "start": 8582.1,
      "end": 8584.1,
      "formatted_start": "02:23:02.100",
      "formatted_end": "02:23:04.100",
      "text": "از رنگ میزنید یه ساعت دیگه"
    },
    {
      "id": 85,
      "start": 8584.1,
      "end": 8586.1,
      "formatted_start": "02:23:04.100",
      "formatted_end": "02:23:06.100",
      "text": "زیاده"
    },
    {
      "id": 86,
      "start": 8586.1,
      "end": 8588.1,
      "formatted_start": "02:23:06.100",
      "formatted_end": "02:23:08.100",
      "text": "نمیدونم فیلمت ها دروار با هم نمیگید"
    },
    {
      "id": 87,
      "start": 8588.1,
      "end": 8590.1,
      "formatted_start": "02:23:08.100",
      "formatted_end": "02:23:10.100",
      "text": "یعنی از تقریب می کنه سریع"
    },
    {
      "id": 88,
      "start": 8590.1,
      "end": 8592.1,
      "formatted_start": "02:23:10.100",
      "formatted_end": "02:23:12.100",
      "text": "مخیر میکنه سریعا"
    },
    {
      "id": 89,
      "start": 8592.1,
      "end": 8594.1,
      "formatted_start": "02:23:12.100",
      "formatted_end": "02:23:14.100",
      "text": "میخواییم می نویسم؟"
    },
    {
      "id": 90,
      "start": 8594.1,
      "end": 8596.1,
      "formatted_start": "02:23:14.100",
      "formatted_end": "02:23:16.100",
      "text": "نه دارباش زیاده میگه"
    },
    {
      "id": 91,
      "start": 8596.1,
      "end": 8598.1,
      "formatted_start": "02:23:16.100",
      "formatted_end": "02:23:18.100",
      "text": "یعنی اینکه رو همین کاری که ما مثلا"
    },
    {
      "id": 92,
      "start": 8598.1,
      "end": 8600.1,
      "formatted_start": "02:23:18.100",
      "formatted_end": "02:23:20.100",
      "text": "به استعمال کنیم"
    },
    {
      "id": 93,
      "start": 8600.1,
      "end": 8602.1,
      "formatted_start": "02:23:20.100",
      "formatted_end": "02:23:22.100",
      "text": "باید بیمان سیدی که خود باشیم"
    },
    {
      "id": 94,
      "start": 8602.1,
      "end": 8604.1,
      "formatted_start": "02:23:22.100",
      "formatted_end": "02:23:24.100",
      "text": "باید بیمیسیم"
    },
    {
      "id": 95,
      "start": 8604.1,
      "end": 8606.1,
      "formatted_start": "02:23:24.100",
      "formatted_end": "02:23:26.100",
      "text": "چون گرما خودشون هست"
    },
    {
      "id": 96,
      "start": 8612.1,
      "end": 8614.1,
      "formatted_start": "02:23:32.100",
      "formatted_end": "02:23:34.100",
      "text": "تب روختی نداشته؟"
    },
    {
      "id": 97,
      "start": 8614.1,
      "end": 8616.1,
      "formatted_start": "02:23:34.100",
      "formatted_end": "02:23:36.100",
      "text": "من متولجه نشدم"
    },
    {
      "id": 98,
      "start": 8616.1,
      "end": 8618.1,
      "formatted_start": "02:23:36.100",
      "formatted_end": "02:23:38.100",
      "text": "درست پیش من بوده"
    },
    {
      "id": 99,
      "start": 8618.1,
      "end": 8622.72,
      "formatted_start": "02:23:38.100",
      "formatted_end": "02:23:42.720",
      "text": "درو زیاد ندارد. دروی گیاییش درصد آزاده. دوتا شربت میخورد."
    },
    {
      "id": 100,
      "start": 8622.72,
      "end": 8625.72,
      "formatted_start": "02:23:42.720",
      "formatted_end": "02:23:45.720",
      "text": "اون دیگه دروشه بیارون ندارد."
    },
    {
      "id": 101,
      "start": 8625.72,
      "end": 8627.72,
      "formatted_start": "02:23:45.720",
      "formatted_end": "02:23:47.720",
      "text": "برای خوابش نمیدونید نه؟"
    },
    {
      "id": 102,
      "start": 8627.72,
      "end": 8636.72,
      "formatted_start": "02:23:47.720",
      "formatted_end": "02:23:56.720",
      "text": "نمیدونید. نگه میگم این باسه شیر و خشکش خوب. شیر و خشک میخورد. شبا نفت میکنه و غیری بدخواب میشه."
    },
    {
      "id": 103,
      "start": 8636.72,
      "end": 8638.1,
      "formatted_start": "02:23:56.720",
      "formatted_end": "02:23:58.100",
      "text": "شیر و خشکی چی؟"
    },
    {
      "id": 104,
      "start": 8638.1,
      "end": 8639.1,
      "formatted_start": "02:23:58.100",
      "formatted_end": "02:23:59.100",
      "text": "آب تامین پرناتران."
    },
    {
      "id": 105,
      "start": 8639.1,
      "end": 8642.1,
      "formatted_start": "02:23:59.100",
      "formatted_end": "02:24:02.100",
      "text": "میخواییم عوض کنید نان یا به بلاف بشون."
    },
    {
      "id": 106,
      "start": 8642.1,
      "end": 8646.1,
      "formatted_start": "02:24:02.100",
      "formatted_end": "02:24:06.100",
      "text": "بیتر ما توی نوزادیشن فارد کردیم ما فرقی نداشتیم"
    },
    {
      "id": 107,
      "start": 8646.1,
      "end": 8648.1,
      "formatted_start": "02:24:06.100",
      "formatted_end": "02:24:08.100",
      "text": "پیشتر نفت می کنه؟"
    },
    {
      "id": 108,
      "start": 8648.1,
      "end": 8650.1,
      "formatted_start": "02:24:08.100",
      "formatted_end": "02:24:10.100",
      "text": "آره شبه نفتی نداشتیم"
    },
    {
      "id": 109,
      "start": 8650.1,
      "end": 8653.1,
      "formatted_start": "02:24:10.100",
      "formatted_end": "02:24:13.100",
      "text": "شبه اوورانیدی، حالا شیر مادرم می پره؟"
    },
    {
      "id": 110,
      "start": 8653.1,
      "end": 8654.1,
      "formatted_start": "02:24:13.100",
      "formatted_end": "02:24:14.100",
      "text": "نه از آزادم نیم"
    },
    {
      "id": 111,
      "start": 8654.1,
      "end": 8658.1,
      "formatted_start": "02:24:14.100",
      "formatted_end": "02:24:18.100",
      "text": "شبه دیگرکولی کنا بینیم اگر نفت داریم، آزاده دیگرکولیشن"
    },
    {
      "id": 112,
      "start": 8658.1,
      "end": 8661.1,
      "formatted_start": "02:24:18.100",
      "formatted_end": "02:24:21.100",
      "text": "برای ضد نفت و ضد پیشتر"
    },
    {
      "id": 113,
      "start": 8661.1,
      "end": 8664.1,
      "formatted_start": "02:24:21.100",
      "formatted_end": "02:24:24.100",
      "text": "ما گیرونیچر میدیم بهش"
    },
    {
      "id": 114,
      "start": 8666.1,
      "end": 8667.1,
      "formatted_start": "02:24:26.100",
      "formatted_end": "02:24:27.100",
      "text": "این بهتره؟"
    },
    {
      "id": 115,
      "start": 8667.1,
      "end": 8668.1,
      "formatted_start": "02:24:27.100",
      "formatted_end": "02:24:28.100",
      "text": "آره"
    },
    {
      "id": 116,
      "start": 8672.1,
      "end": 8675.1,
      "formatted_start": "02:24:32.100",
      "formatted_end": "02:24:35.100",
      "text": "این خدمت شما، خواهش میکنم"
    },
    {
      "id": 117,
      "start": 8675.1,
      "end": 8678.1,
      "formatted_start": "02:24:35.100",
      "formatted_end": "02:24:38.100",
      "text": "خواهش میکنم، زنده باشیم"
    },
    {
      "id": 118,
      "start": 8678.1,
      "end": 8681.1,
      "formatted_start": "02:24:38.100",
      "formatted_end": "02:24:41.100",
      "text": "خوامسه میدون بزیر شد به زنخواهان بردیدی رو"
    },
    {
      "id": 119,
      "start": 8687.1,
      "end": 8690.1,
      "formatted_start": "02:24:47.100",
      "formatted_end": "02:24:50.100",
      "text": "بخونید، خواهش میکنم"
    },
    {
      "id": 120,
      "start": 8690.1,
      "end": 8694.1,
      "formatted_start": "02:24:50.100",
      "formatted_end": "02:24:54.100",
      "text": "این پدرنجی، هر هشت ساعت 15 قصده هست"
    },
    {
      "id": 121,
      "start": 8694.1,
      "end": 8697.1,
      "formatted_start": "02:24:54.100",
      "formatted_end": "02:24:57.100",
      "text": "این هم هشت ساعت مربع خورید، این خدمت شما"
    },
    {
      "id": 122,
      "start": 8697.1,
      "end": 8698.1,
      "formatted_start": "02:24:57.100",
      "formatted_end": "02:24:58.100",
      "text": "اون برگرگی چی؟"
    },
    {
      "id": 123,
      "start": 8698.1,
      "end": 8699.1,
      "formatted_start": "02:24:58.100",
      "formatted_end": "02:24:59.100",
      "text": "همشون هشت ساعتی"
    },
    {
      "id": 124,
      "start": 8699.1,
      "end": 8700.1,
      "formatted_start": "02:24:59.100",
      "formatted_end": "02:25:00.100",
      "text": "هشت ساعت هست؟"
    }
  ],
  "status": "completed"
}