  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12615.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:15.000",
      "text": "این دمشدید، ایه که دیگه اومد، ۷۳، ۵۳، ۵۳، ۵۱."
    },
    {
      "id": 1,
      "start": 12615.0,
      "end": 12644.0,
      "formatted_start": "03:30:15.000",
      "formatted_end": "03:30:44.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 12645.0,
      "end": 12647.0,
      "formatted_start": "03:30:45.000",
      "formatted_end": "03:30:47.000",
      "text": "حالا مشکل رفتیم و تعمل بپریم"
    },
    {
      "id": 3,
      "start": 12647.0,
      "end": 12649.0,
      "formatted_start": "03:30:47.000",
      "formatted_end": "03:30:49.000",
      "text": "با جمعه دارم که بیرون دارم"
    },
    {
      "id": 4,
      "start": 12649.0,
      "end": 12650.0,
      "formatted_start": "03:30:49.000",
      "formatted_end": "03:30:50.000",
      "text": "و بوده نیمه 20 تون"
    },
    {
      "id": 5,
      "start": 12650.0,
      "end": 12653.0,
      "formatted_start": "03:30:50.000",
      "formatted_end": "03:30:53.000",
      "text": "حالا تا اصلا یک قهوه فعال بپریم رابطه نمیدن"
    },
    {
      "id": 6,
      "start": 12653.0,
      "end": 12655.0,
      "formatted_start": "03:30:53.000",
      "formatted_end": "03:30:55.000",
      "text": "باید 100 تون راوی 200 تون راوی 6 تون هستیم"
    },
    {
      "id": 7,
      "start": 12655.0,
      "end": 12656.0,
      "formatted_start": "03:30:55.000",
      "formatted_end": "03:30:56.000",
      "text": "باید دعایش کنیم"
    },
    {
      "id": 8,
      "start": 12656.0,
      "end": 12657.0,
      "formatted_start": "03:30:56.000",
      "formatted_end": "03:30:57.000",
      "text": "تعمل نمزده ببین"
    },
    {
      "id": 9,
      "start": 12657.0,
      "end": 12660.0,
      "formatted_start": "03:30:57.000",
      "formatted_end": "03:31:00.000",
      "text": "بس بابا آجیلو تنبولاتو میبه بپرد"
    },
    {
      "id": 10,
      "start": 12660.0,
      "end": 12661.0,
      "formatted_start": "03:31:00.000",
      "formatted_end": "03:31:01.000",
      "text": "من که از آن مهمون نداشته باشیم"
    },
    {
      "id": 11,
      "start": 12661.0,
      "end": 12663.0,
      "formatted_start": "03:31:01.000",
      "formatted_end": "03:31:03.000",
      "text": "مایی حدای نشونم"
    },
    {
      "id": 12,
      "start": 12663.0,
      "end": 12665.0,
      "formatted_start": "03:31:03.000",
      "formatted_end": "03:31:05.000",
      "text": "چیز دیگه رفت زبابا برم نشان"
    },
    {
      "id": 13,
      "start": 12665.0,
      "end": 12690.0,
      "formatted_start": "03:31:05.000",
      "formatted_end": "03:31:30.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 12690.0,
      "end": 12692.0,
      "formatted_start": "03:31:30.000",
      "formatted_end": "03:31:32.000",
      "text": "سلامتی سلامتی"
    },
    {
      "id": 15,
      "start": 12692.0,
      "end": 12694.0,
      "formatted_start": "03:31:32.000",
      "formatted_end": "03:31:34.000",
      "text": "بسیار خوب"
    },
    {
      "id": 16,
      "start": 12694.0,
      "end": 12696.0,
      "formatted_start": "03:31:34.000",
      "formatted_end": "03:31:36.000",
      "text": "خوب"
    },
    {
      "id": 17,
      "start": 12696.0,
      "end": 12698.0,
      "formatted_start": "03:31:36.000",
      "formatted_end": "03:31:38.000",
      "text": "خوب"
    },
    {
      "id": 18,
      "start": 12706.0,
      "end": 12708.0,
      "formatted_start": "03:31:46.000",
      "formatted_end": "03:31:48.000",
      "text": "خوشا شما اینکرد؟ گفت گرفتاره"
    },
    {
      "id": 19,
      "start": 12708.0,
      "end": 12710.0,
      "formatted_start": "03:31:48.000",
      "formatted_end": "03:31:50.000",
      "text": "سن بچه چقدره؟"
    },
    {
      "id": 20,
      "start": 12710.0,
      "end": 12712.0,
      "formatted_start": "03:31:50.000",
      "formatted_end": "03:31:52.000",
      "text": "دو ماه شه"
    },
    {
      "id": 21,
      "start": 12712.0,
      "end": 12714.0,
      "formatted_start": "03:31:52.000",
      "formatted_end": "03:31:54.000",
      "text": "سرما هم کرده بود؟"
    },
    {
      "id": 22,
      "start": 12714.0,
      "end": 12716.0,
      "formatted_start": "03:31:54.000",
      "formatted_end": "03:31:56.000",
      "text": "نه سرما نم کرده"
    },
    {
      "id": 23,
      "start": 12716.0,
      "end": 12718.0,
      "formatted_start": "03:31:56.000",
      "formatted_end": "03:31:58.000",
      "text": "حالا مشکلش پیشتر چی بود؟"
    },
    {
      "id": 24,
      "start": 12718.0,
      "end": 12722.0,
      "formatted_start": "03:31:58.000",
      "formatted_end": "03:32:02.000",
      "text": "بینده شو میگه دوست داری؟ بسر با کم"
    },
    {
      "id": 25,
      "start": 12724.0,
      "end": 12726.0,
      "formatted_start": "03:32:04.000",
      "formatted_end": "03:32:06.000",
      "text": "بیشمشش رو برای گم بگیرن"
    },
    {
      "id": 26,
      "start": 12726.0,
      "end": 12728.0,
      "formatted_start": "03:32:06.000",
      "formatted_end": "03:32:08.000",
      "text": "ماهیه جمع می کنه و افراد کنن"
    },
    {
      "id": 27,
      "start": 12728.0,
      "end": 12746.0,
      "formatted_start": "03:32:08.000",
      "formatted_end": "03:32:26.000",
      "text": "موسیقی"
