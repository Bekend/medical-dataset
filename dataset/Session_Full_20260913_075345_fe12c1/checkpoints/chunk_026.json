  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7802.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:02.000",
      "text": "خب بیزن درسته، به زدید."
    },
    {
      "id": 1,
      "start": 7808.0,
      "end": 7812.0,
      "formatted_start": "02:10:08.000",
      "formatted_end": "02:10:12.000",
      "text": "خب شما این طرف سشه سشه باشید."
    },
    {
      "id": 2,
      "start": 7815.0,
      "end": 7818.0,
      "formatted_start": "02:10:15.000",
      "formatted_end": "02:10:18.000",
      "text": "آهاشو دیگر دارید، دستاشو بکر کنترل کنید."
    },
    {
      "id": 3,
      "start": 7819.0,
      "end": 7821.0,
      "formatted_start": "02:10:19.000",
      "formatted_end": "02:10:21.000",
      "text": "چوان دیگر دارید، پنجونه نیچش دارید."
    },
    {
      "id": 4,
      "start": 7823.0,
      "end": 7825.0,
      "formatted_start": "02:10:23.000",
      "formatted_end": "02:10:25.000",
      "text": "خب شما دستاشو دیگر دارید."
    },
    {
      "id": 5,
      "start": 7830.0,
      "end": 7860.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:11:00.000",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 6,
      "start": 7860.0,
      "end": 7872.0,
      "formatted_start": "02:11:00.000",
      "formatted_end": "02:11:12.000",
      "text": "این بخونه پنه خوشی داره، گلوش اینا قیمت شده، گلوش دیگه صدا و ترک و صورتش بخواهد برسه"
    },
    {
      "id": 7,
      "start": 7872.0,
      "end": 7873.0,
      "formatted_start": "02:11:12.000",
      "formatted_end": "02:11:13.000",
      "text": "کم ماهشه؟"
    },
    {
      "id": 8,
      "start": 7873.0,
      "end": 7875.0,
      "formatted_start": "02:11:13.000",
      "formatted_end": "02:11:15.000",
      "text": "این یک سال و نیمه"
    },
    {
      "id": 9,
      "start": 7875.0,
      "end": 7883.0,
      "formatted_start": "02:11:15.000",
      "formatted_end": "02:11:23.000",
      "text": "ببینیم برواهر اقتصاد درازم میاد، اگر نیمه میخواییم باید راستون رو باید سرکنیم به برق بیادیم"
    },
    {
      "id": 10,
      "start": 7883.0,
      "end": 7887.0,
      "formatted_start": "02:11:23.000",
      "formatted_end": "02:11:27.000",
      "text": "اگر آزاد میخواییم بگیریم، دلیل ویستن میگیر"
    },
    {
      "id": 11,
      "start": 7887.0,
      "end": 7892.0,
      "formatted_start": "02:11:27.000",
      "formatted_end": "02:11:32.000",
      "text": "که در می آن؟ دوازده تر بود"
    },
    {
      "id": 12,
      "start": 7892.0,
      "end": 7896.0,
      "formatted_start": "02:11:32.000",
      "formatted_end": "02:11:36.000",
      "text": "الان یازده و ده دقیقه یاز رو"
    },
    {
      "id": 13,
      "start": 7896.0,
      "end": 7900.0,
      "formatted_start": "02:11:36.000",
      "formatted_end": "02:11:40.000",
      "text": "چند من میشن از اینجا؟ جا"
    },
    {
      "id": 14,
      "start": 7900.0,
      "end": 7903.0,
      "formatted_start": "02:11:40.000",
      "formatted_end": "02:11:43.000",
      "text": "حالا آمپول داریم"
    },
    {
      "id": 15,
      "start": 7903.0,
      "end": 7907.0,
      "formatted_start": "02:11:43.000",
      "formatted_end": "02:11:47.000",
      "text": "آمپولاشو بزنیم"
    },
    {
      "id": 16,
      "start": 7907.0,
      "end": 7910.0,
      "formatted_start": "02:11:47.000",
      "formatted_end": "02:11:50.000",
      "text": "خانم یه عرب خانم سمیت میگه آمپولاشو"
    },
    {
      "id": 17,
      "start": 7910.0,
      "end": 7913.0,
      "formatted_start": "02:11:50.000",
      "formatted_end": "02:11:53.000",
      "text": "اینجا ما الان داریم بزنیم"
    },
    {
      "id": 18,
      "start": 7913.0,
      "end": 7916.2,
      "formatted_start": "02:11:53.000",
      "formatted_end": "02:11:56.200",
      "text": "بعد داروها رو بگیریم بیاریم آنپول هاش رو جایی بذیریم"
    },
    {
      "id": 19,
      "start": 7916.2,
      "end": 7919.2,
      "formatted_start": "02:11:56.200",
      "formatted_end": "02:11:59.200",
      "text": "بیارم آنپولش که مهمه زده بشه"
    },
    {
      "id": 20,
      "start": 7919.2,
      "end": 7921.2,
      "formatted_start": "02:11:59.200",
      "formatted_end": "02:12:01.200",
      "text": "بعد داروها رو بگیریم شما بگیریم خونه"
    },
    {
      "id": 21,
      "start": 7921.2,
      "end": 7923.2,
      "formatted_start": "02:12:01.200",
      "formatted_end": "02:12:03.200",
      "text": "یکی بیار داروها رو ساعت دوازر بگیره"
    },
    {
      "id": 22,
      "start": 7923.2,
      "end": 7925.2,
      "formatted_start": "02:12:03.200",
      "formatted_end": "02:12:05.200",
      "text": "چند تا آنپول رو بگیریم؟"
    },
    {
      "id": 23,
      "start": 7925.2,
      "end": 7927.2,
      "formatted_start": "02:12:05.200",
      "formatted_end": "02:12:07.200",
      "text": "دوتا داره هرنام تمام میشه"
    },
    {
      "id": 24,
      "start": 7927.2,
      "end": 7929.2,
      "formatted_start": "02:12:07.200",
      "formatted_end": "02:12:09.200",
      "text": "چون تب و بالا"
    },
    {
      "id": 25,
      "start": 7929.2,
      "end": 7931.2,
      "formatted_start": "02:12:09.200",
      "formatted_end": "02:12:11.200",
      "text": "اگر میخوایی نزدینه آنپولش خط بزنیم"
    },
    {
      "id": 26,
      "start": 7931.2,
      "end": 7933.2,
      "formatted_start": "02:12:11.200",
      "formatted_end": "02:12:13.200",
      "text": "چون تبشت"
    },
    {
      "id": 27,
      "start": 7933.2,
      "end": 7936.2,
      "formatted_start": "02:12:13.200",
      "formatted_end": "02:12:16.200",
      "text": "آنپول سریع تر خواهی میاده"
    },
    {
      "id": 28,
      "start": 7936.2,
      "end": 7938.2,
      "formatted_start": "02:12:16.200",
      "formatted_end": "02:12:18.200",
      "text": "ولی بعضی ها خب دوست نداره میبینید"
    },
    {
      "id": 29,
      "start": 7938.2,
      "end": 7940.2,
      "formatted_start": "02:12:18.200",
      "formatted_end": "02:12:20.200",
      "text": "اینگه باید بشین"
    },
    {
      "id": 30,
      "start": 7940.2,
      "end": 7942.2,
      "formatted_start": "02:12:20.200",
      "formatted_end": "02:12:22.200",
      "text": "این یه هم گیرنگ آره آیه"
    },
    {
      "id": 31,
      "start": 7942.2,
      "end": 7944.2,
      "formatted_start": "02:12:22.200",
      "formatted_end": "02:12:24.200",
      "text": "که هم باید بشین"
    },
    {
      "id": 32,
      "start": 7944.2,
      "end": 7945.2,
      "formatted_start": "02:12:24.200",
      "formatted_end": "02:12:25.200",
      "text": "باشه"
    },
    {
      "id": 33,
      "start": 7945.2,
      "end": 7947.2,
      "formatted_start": "02:12:25.200",
      "formatted_end": "02:12:27.200",
      "text": "همسنگی تضریف نمیخواد"
    },
    {
      "id": 34,
      "start": 7947.2,
      "end": 7949.2,
      "formatted_start": "02:12:27.200",
      "formatted_end": "02:12:29.200",
      "text": "مایل نیستن این هم"
    },
    {
      "id": 35,
      "start": 7949.2,
      "end": 7950.2,
      "formatted_start": "02:12:29.200",
      "formatted_end": "02:12:30.200",
      "text": "بله"
    },
    {
      "id": 36,
      "start": 7950.2,
      "end": 7952.2,
      "formatted_start": "02:12:30.200",
      "formatted_end": "02:12:32.200",
      "text": "میخدمت شدید"
    },
    {
      "id": 37,
      "start": 7952.2,
      "end": 7954.2,
      "formatted_start": "02:12:32.200",
      "formatted_end": "02:12:34.200",
      "text": "تاییس میکنن بینیم بس"
    },
    {
      "id": 38,
      "start": 7954.2,
      "end": 7956.2,
      "formatted_start": "02:12:34.200",
      "formatted_end": "02:12:36.200",
      "text": "ساعت دوازه برقومت سفت میکنه"
    },
    {
      "id": 39,
      "start": 7956.2,
      "end": 7957.2,
      "formatted_start": "02:12:36.200",
      "formatted_end": "02:12:37.200",
      "text": "ممنون"
    },
    {
      "id": 40,
      "start": 7957.2,
      "end": 7959.2,
      "formatted_start": "02:12:37.200",
      "formatted_end": "02:12:39.200",
      "text": "تاییس میکنه هم زدنگ باشه نمیخواد"
    },
    {
      "id": 41,
      "start": 7961.2,
      "end": 7963.2,
      "formatted_start": "02:12:41.200",
      "formatted_end": "02:12:43.200",
      "text": "همسنگی یه لحظه سفت میکنه"
    },
    {
      "id": 42,
      "start": 7966.2,
      "end": 7976.2,
      "formatted_start": "02:12:46.200",
      "formatted_end": "02:12:56.200",
      "text": "موسیقی"
    },
    {
      "id": 43,
      "start": 7996.2,
      "end": 8006.2,
      "formatted_start": "02:13:16.200",
      "formatted_end": "02:13:26.200",
      "text": "موسیقی"
    },
    {
      "id": 44,
      "start": 8026.2,
      "end": 8036.2,
      "formatted_start": "02:13:46.200",
      "formatted_end": "02:13:56.200",
      "text": "موسیقی"
    },
    {
      "id": 45,
      "start": 8056.2,
      "end": 8084.2,
      "formatted_start": "02:14:16.200",
      "formatted_end": "02:14:44.200",
      "text": "موسیقی"
    },
    {
