    {
      "id": 5,
      "start": 2768.0,
      "end": 2770.0,
      "formatted_start": "00:46:08.000",
      "formatted_end": "00:46:10.000",
      "text": "ها برداشتون."
    },
    {
      "id": 6,
      "start": 2771.0,
      "end": 2772.0,
      "formatted_start": "00:46:11.000",
      "formatted_end": "00:46:12.000",
      "text": "آره باش."
    },
    {
      "id": 7,
      "start": 2773.0,
      "end": 2774.0,
      "formatted_start": "00:46:13.000",
      "formatted_end": "00:46:14.000",
      "text": "ها برداشتون شانه."
    },
    {
      "id": 8,
      "start": 2774.0,
      "end": 2775.0,
      "formatted_start": "00:46:14.000",
      "formatted_end": "00:46:15.000",
      "text": "درست برداشتون."
    },
    {
      "id": 9,
      "start": 2775.0,
      "end": 2776.0,
      "formatted_start": "00:46:15.000",
      "formatted_end": "00:46:16.000",
      "text": "برداشتون."
    },
    {
      "id": 10,
      "start": 2776.0,
      "end": 2777.0,
      "formatted_start": "00:46:16.000",
      "formatted_end": "00:46:17.000",
      "text": "هایی همون."
    },
    {
      "id": 11,
      "start": 2777.0,
      "end": 2778.0,
      "formatted_start": "00:46:17.000",
      "formatted_end": "00:46:18.000",
      "text": "هایی همون."
    },
    {
      "id": 12,
      "start": 2778.0,
      "end": 2779.0,
      "formatted_start": "00:46:18.000",
      "formatted_end": "00:46:19.000",
      "text": "هایی همون."
    },
    {
      "id": 13,
      "start": 2779.0,
      "end": 2780.0,
      "formatted_start": "00:46:19.000",
      "formatted_end": "00:46:20.000",
      "text": "هایی همون."
    },
    {
      "id": 14,
      "start": 2780.0,
      "end": 2781.0,
      "formatted_start": "00:46:20.000",
      "formatted_end": "00:46:21.000",
      "text": "هایی همون."
    },
    {
      "id": 15,
      "start": 2781.0,
      "end": 2782.0,
      "formatted_start": "00:46:21.000",
      "formatted_end": "00:46:22.000",
      "text": "هایی همون."
    },
    {
      "id": 16,
      "start": 2782.0,
      "end": 2783.0,
      "formatted_start": "00:46:22.000",
      "formatted_end": "00:46:23.000",
      "text": "یکم تو ماشین."
    },
    {
      "id": 17,
      "start": 2783.0,
      "end": 2784.0,
      "formatted_start": "00:46:23.000",
      "formatted_end": "00:46:24.000",
      "text": "خب."
    },
    {
      "id": 18,
      "start": 2784.0,
      "end": 2785.0,
      "formatted_start": "00:46:24.000",
      "formatted_end": "00:46:25.000",
      "text": "بس کار بالا نداریم."
    },
    {
      "id": 19,
      "start": 2785.0,
      "end": 2786.0,
      "formatted_start": "00:46:25.000",
      "formatted_end": "00:46:26.000",
      "text": "آره آره."
    },
    {
      "id": 20,
      "start": 2786.0,
      "end": 2787.0,
      "formatted_start": "00:46:26.000",
      "formatted_end": "00:46:27.000",
      "text": "یکم تو ماشین."
    },
    {
      "id": 21,
      "start": 2787.0,
      "end": 2789.0,
      "formatted_start": "00:46:27.000",
      "formatted_end": "00:46:29.000",
      "text": "یکی که ازشون می‌دهند، یکی که می‌دونند."
    },
    {
      "id": 22,
      "start": 2797.0,
      "end": 2801.0,
      "formatted_start": "00:46:37.000",
      "formatted_end": "00:46:41.000",
      "text": "چرا زنگ نخواهید بکنیم که مثلا آن گولتر از یک چارون بوده با دوباره نسبه دید؟"
    },
    {
      "id": 23,
      "start": 2801.0,
      "end": 2804.0,
      "formatted_start": "00:46:41.000",
      "formatted_end": "00:46:44.000",
      "text": "بکنیم که زنگ نخواهید کاری بود، با دوباره بود."
    },
    {
