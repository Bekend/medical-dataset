      "formatted_end": "00:46:02.000",
      "text": "برگرام می کنید."
    },
    {
      "id": 3,
      "start": 2762.0,
      "end": 2765.0,
      "formatted_start": "00:46:02.000",
      "formatted_end": "00:46:05.000",
      "text": "برگرام برداشتون شما با چرکی برداشتون."
    },
    {
      "id": 4,
      "start": 2767.0,
      "end": 2768.0,
      "formatted_start": "00:46:07.000",
      "formatted_end": "00:46:08.000",
      "text": "ها."
