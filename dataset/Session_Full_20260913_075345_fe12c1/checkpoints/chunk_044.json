  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13229.98,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13232.0,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:32.000",
      "text": "درسته که این چشمش رو بردارید"
    },
    {
      "id": 2,
      "start": 13232.0,
      "end": 13233.0,
      "formatted_start": "03:40:32.000",
      "formatted_end": "03:40:33.000",
      "text": "بله"
    },
    {
      "id": 3,
      "start": 13233.0,
      "end": 13236.0,
      "formatted_start": "03:40:33.000",
      "formatted_end": "03:40:36.000",
      "text": "چشمش رو کسی کشید بشه بشه که کماد رو بردارید"
    },
    {
      "id": 4,
      "start": 13236.0,
      "end": 13238.0,
      "formatted_start": "03:40:36.000",
      "formatted_end": "03:40:38.000",
      "text": "بله"
    },
    {
      "id": 5,
      "start": 13238.0,
      "end": 13242.0,
      "formatted_start": "03:40:38.000",
      "formatted_end": "03:40:42.000",
      "text": "یک قطره چشمی و یک کماد هست"
    },
    {
      "id": 6,
      "start": 13242.0,
      "end": 13244.0,
      "formatted_start": "03:40:42.000",
      "formatted_end": "03:40:44.000",
      "text": "داخل چشمی دید"
    },
    {
      "id": 7,
      "start": 13244.0,
      "end": 13246.0,
      "formatted_start": "03:40:44.000",
      "formatted_end": "03:40:46.000",
      "text": "دور پک کماد نزن"
    },
    {
      "id": 8,
      "start": 13246.0,
      "end": 13248.0,
      "formatted_start": "03:40:46.000",
      "formatted_end": "03:40:48.000",
      "text": "اول قطره بر کماد"
    },
    {
      "id": 9,
      "start": 13248.0,
      "end": 13251.0,
      "formatted_start": "03:40:48.000",
      "formatted_end": "03:40:51.000",
      "text": "نه همزمان بخواهیم است کماد رو بردارید"
    },
    {
      "id": 10,
      "start": 13251.0,
      "end": 13254.0,
      "formatted_start": "03:40:51.000",
      "formatted_end": "03:40:54.000",
      "text": "قطره رو ریفتی در دقیقه بعد کماد"
    },
    {
      "id": 11,
      "start": 13254.0,
      "end": 13256.0,
      "formatted_start": "03:40:54.000",
      "formatted_end": "03:40:56.000",
      "text": "آهان باشیم"
    },
    {
      "id": 12,
      "start": 13256.0,
      "end": 13258.0,
      "formatted_start": "03:40:56.000",
      "formatted_end": "03:40:58.000",
      "text": "چند دقیقه بر کماد"
    },
    {
      "id": 13,
      "start": 13258.0,
      "end": 13262.0,
      "formatted_start": "03:40:58.000",
      "formatted_end": "03:41:02.000",
      "text": "فامیلیتون؟ سارانی"
    },
    {
      "id": 14,
      "start": 13262.0,
      "end": 13266.0,
      "formatted_start": "03:41:02.000",
      "formatted_end": "03:41:06.000",
      "text": "سارانی، بیایید"
    },
    {
      "id": 15,
      "start": 13266.0,
      "end": 13270.0,
      "formatted_start": "03:41:06.000",
      "formatted_end": "03:41:10.000",
      "text": "می خدمت شما"
    },
    {
      "id": 16,
      "start": 13270.0,
      "end": 13272.0,
      "formatted_start": "03:41:10.000",
      "formatted_end": "03:41:12.000",
      "text": "بسیار"
    },
    {
      "id": 17,
      "start": 13288.0,
      "end": 13292.16,
      "formatted_start": "03:41:28.000",
      "formatted_end": "03:41:32.160",
      "text": "وقت آدم ها به خاطر تقدیر و تشکر یا وردگی ترفی و مقام"
    },
    {
      "id": 18,
      "start": 13292.16,
      "end": 13294.98,
      "formatted_start": "03:41:32.160",
      "formatted_end": "03:41:34.980",
      "text": "تا سرحد مرگ از خودشون کار می کشن"
    },
    {
      "id": 19,
      "start": 13294.98,
      "end": 13298.7,
      "formatted_start": "03:41:34.980",
      "formatted_end": "03:41:38.700",
      "text": "اونا استرامتیشون ها رو بششون و حتی زندگیشون می گذرن"
    },
    {
      "id": 20,
      "start": 13298.7,
      "end": 13302.06,
      "formatted_start": "03:41:38.700",
      "formatted_end": "03:41:42.060",
      "text": "جون اطلاع دارن بدین اونا همه چی به هم می نیزه"
    },
    {
      "id": 21,
      "start": 13302.06,
      "end": 13306.18,
      "formatted_start": "03:41:42.060",
      "formatted_end": "03:41:46.180",
      "text": "حدیقات اینه که سیسترها خیلی سریع آدم ها رو جایگزین می کنن"
    },
    {
      "id": 22,
      "start": 13306.18,
      "end": 13310.16,
      "formatted_start": "03:41:46.180",
      "formatted_end": "03:41:50.160",
      "text": "حتی اگه صدق از بکار خودتن باشید تو فقط یه حبساری"
    },
    {
      "id": 23,
      "start": 13310.16,
      "end": 13313.42,
      "formatted_start": "03:41:50.160",
      "formatted_end": "03:41:53.420",
      "text": "یادتو باشه تو کار می کنی که زندگی کنی"
    },
    {
      "id": 24,
      "start": 13313.42,
      "end": 13315.42,
      "formatted_start": "03:41:53.420",
      "formatted_end": "03:41:55.420",
      "text": "موسیقی"
    },
    {
      "id": 25,
      "start": 13343.42,
      "end": 13367.42,
      "formatted_start": "03:42:23.420",
      "formatted_end": "03:42:47.420",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 13367.42,
      "end": 13397.42,
      "formatted_start": "03:42:47.420",
      "formatted_end": "03:43:17.420",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 27,
      "start": 13397.42,
      "end": 13410.42,
      "formatted_start": "03:43:17.420",
      "formatted_end": "03:43:30.420",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 13410.42,
      "end": 13414.42,
      "formatted_start": "03:43:30.420",
      "formatted_end": "03:43:34.420",
      "text": "بخوند بادرش بیرد"
    },
    {
      "id": 29,
      "start": 13414.42,
      "end": 13419.42,
      "formatted_start": "03:43:34.420",
      "formatted_end": "03:43:39.420",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 13419.42,
      "end": 13422.42,
      "formatted_start": "03:43:39.420",
      "formatted_end": "03:43:42.420",
      "text": "ببین این صبح و شب یکونین قطعه چکانه"
    },
    {
      "id": 31,
      "start": 13422.42,
      "end": 13425.42,
      "formatted_start": "03:43:42.420",
      "formatted_end": "03:43:45.420",
      "text": "این روز سه بار یک قطعه چکانه"
    },
    {
      "id": 32,
      "start": 13425.42,
      "end": 13432.62,
      "formatted_start": "03:43:45.420",
      "formatted_end": "03:43:52.620",
      "text": "و این هم های سار دختره اگه اصلا می کنید تب داشت نداشت بدین این بوش و خونتش برای من ترس بینید"
    },
    {
      "id": 33,
      "start": 13432.62,
      "end": 13434.62,
      "formatted_start": "03:43:52.620",
      "formatted_end": "03:43:54.620",
      "text": "خداحید"
    },
    {
      "id": 34,
      "start": 13434.62,
      "end": 13436.62,
      "formatted_start": "03:43:54.620",
      "formatted_end": "03:43:56.620",
      "text": "سوید"
    },
    {
      "id": 35,
      "start": 13455.42,
      "end": 13459.42,
      "formatted_start": "03:44:15.420",
      "formatted_end": "03:44:19.420",
      "text": "موسیقی"
    },
    {
      "id": 36,
      "start": 13485.42,
      "end": 13489.42,
      "formatted_start": "03:44:45.420",
      "formatted_end": "03:44:49.420",
      "text": "از این وقت باز کردم که چنین کاری رو بباره نه آرام خوردم و نه آرام خسیر شدم"
    },
    {
      "id": 37,
      "start": 13489.42,
      "end": 13493.42,
      "formatted_start": "03:44:49.420",
      "formatted_end": "03:44:53.420",
      "text": "بودم تا با این غذایی که میخواد بیمار نمیشه"
    },
    {
      "id": 38,
      "start": 13493.42,
      "end": 13495.42,
      "formatted_start": "03:44:53.420",
      "formatted_end": "03:44:55.420",
      "text": "یک رود دره کسی ببارم کنم"
    },
    {
      "id": 39,
      "start": 13495.42,
      "end": 13497.42,
      "formatted_start": "03:44:55.420",
      "formatted_end": "03:44:57.420",
      "text": "اون رو هر یکی دوره یک ساعتی کنم کنم"
    },
    {
      "id": 40,
      "start": 13497.42,
      "end": 13499.42,
      "formatted_start": "03:44:57.420",
      "formatted_end": "03:44:59.420",
      "text": "رو برد غذا ببارم نمیشه"
    },
    {
      "id": 41,
      "start": 13499.42,
      "end": 13501.42,
      "formatted_start": "03:44:59.420",
      "formatted_end": "03:45:01.420",
      "text": "بگم خوش شدم"
    }
  ],
