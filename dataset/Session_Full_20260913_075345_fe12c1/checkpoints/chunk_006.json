  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1802.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:02.000",
      "text": "یاد داده در اینجا که گفتم."
    },
    {
      "id": 1,
      "start": 1802.0,
      "end": 1806.0,
      "formatted_start": "00:30:02.000",
      "formatted_end": "00:30:06.000",
      "text": "آره، وقتی خرش گرفت به دوره افترده، و بعد دیده این چیه؟"
    },
    {
      "id": 2,
      "start": 1806.0,
      "end": 1808.0,
      "formatted_start": "00:30:06.000",
      "formatted_end": "00:30:08.000",
      "text": "این چیه؟"
    },
    {
      "id": 3,
      "start": 1808.0,
      "end": 1810.0,
      "formatted_start": "00:30:08.000",
      "formatted_end": "00:30:10.000",
      "text": "مال آورده؟"
    },
    {
      "id": 4,
      "start": 1810.0,
      "end": 1812.0,
      "formatted_start": "00:30:10.000",
      "formatted_end": "00:30:12.000",
      "text": "نه"
    },
    {
      "id": 5,
      "start": 1812.0,
      "end": 1814.0,
      "formatted_start": "00:30:12.000",
      "formatted_end": "00:30:14.000",
      "text": "مشکل هست؟"
    },
    {
      "id": 6,
      "start": 1814.0,
      "end": 1816.0,
      "formatted_start": "00:30:14.000",
      "formatted_end": "00:30:16.000",
      "text": "مشکل هست"
    },
    {
      "id": 7,
      "start": 1816.0,
      "end": 1818.0,
      "formatted_start": "00:30:16.000",
      "formatted_end": "00:30:18.000",
      "text": "که چون بخوره"
    },
    {
      "id": 8,
      "start": 1818.0,
      "end": 1820.0,
      "formatted_start": "00:30:18.000",
      "formatted_end": "00:30:20.000",
      "text": "در چین درکتر که چاره درکتر"
    },
    {
      "id": 9,
      "start": 1820.0,
      "end": 1822.0,
      "formatted_start": "00:30:20.000",
      "formatted_end": "00:30:22.000",
      "text": "چیه؟"
    },
    {
      "id": 10,
      "start": 1822.0,
      "end": 1824.0,
      "formatted_start": "00:30:22.000",
      "formatted_end": "00:30:24.000",
      "text": "که چیه؟"
    },
    {
      "id": 11,
      "start": 1824.0,
      "end": 1826.0,
      "formatted_start": "00:30:24.000",
      "formatted_end": "00:30:26.000",
      "text": "که چیه؟"
    },
    {
      "id": 12,
      "start": 1826.0,
      "end": 1828.0,
      "formatted_start": "00:30:26.000",
      "formatted_end": "00:30:28.000",
      "text": "که چیه؟"
    },
    {
      "id": 13,
      "start": 1828.0,
      "end": 1830.0,
      "formatted_start": "00:30:28.000",
      "formatted_end": "00:30:30.000",
      "text": "که چیه؟"
    },
    {
      "id": 14,
      "start": 1830.0,
      "end": 1832.0,
      "formatted_start": "00:30:30.000",
      "formatted_end": "00:30:32.000",
      "text": "که چیه؟"
    },
    {
      "id": 15,
      "start": 1832.0,
      "end": 1834.0,
      "formatted_start": "00:30:32.000",
      "formatted_end": "00:30:34.000",
      "text": "که چیه؟"
    },
    {
      "id": 16,
      "start": 1834.0,
      "end": 1840.0,
      "formatted_start": "00:30:34.000",
      "formatted_end": "00:30:40.000",
      "text": "از اینجور کار را برای از اینجور بردارید."
    },
    {
      "id": 17,
      "start": 1840.0,
      "end": 1846.0,
      "formatted_start": "00:30:40.000",
      "formatted_end": "00:30:46.000",
      "text": "اینجور همه چیزی است که به اینجور بردارید."
    },
    {
      "id": 18,
      "start": 1846.0,
      "end": 1852.0,
      "formatted_start": "00:30:46.000",
      "formatted_end": "00:30:52.000",
      "text": "اینجور همه چیزی است که به اینجور بردارید."
