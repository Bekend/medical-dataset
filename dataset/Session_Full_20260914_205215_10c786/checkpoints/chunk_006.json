  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1830.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 1830.0,
      "end": 1839.0,
      "formatted_start": "00:30:30.000",
      "formatted_end": "00:30:39.000",
      "text": "ما الان تبایی باشیم با پاسخ کامله شما یه اسپری داشتیم و دو تا قرص"
    },
    {
      "id": 2,
      "start": 1839.0,
      "end": 1840.0,
      "formatted_start": "00:30:39.000",
      "formatted_end": "00:30:40.000",
      "text": "سرام انجام دادی؟"
    },
    {
      "id": 3,
      "start": 1840.0,
      "end": 1843.0,
      "formatted_start": "00:30:40.000",
      "formatted_end": "00:30:43.000",
      "text": "دیگه راست هستم فرمانده تو یاد رفته؟"
    },
    {
      "id": 4,
      "start": 1843.0,
      "end": 1844.0,
      "formatted_start": "00:30:43.000",
      "formatted_end": "00:30:44.000",
      "text": "فرمانده؟"
    },
    {
      "id": 5,
      "start": 1844.0,
      "end": 1846.0,
      "formatted_start": "00:30:44.000",
      "formatted_end": "00:30:46.000",
      "text": "که سپرامتر کنم"
    },
    {
      "id": 6,
      "start": 1846.0,
      "end": 1847.0,
      "formatted_start": "00:30:46.000",
      "formatted_end": "00:30:47.000",
      "text": "خودتش؟"
    },
    {
      "id": 7,
      "start": 1847.0,
      "end": 1848.0,
      "formatted_start": "00:30:47.000",
      "formatted_end": "00:30:48.000",
      "text": "خودتش"
    },
    {
      "id": 8,
      "start": 1848.0,
      "end": 1849.0,
      "formatted_start": "00:30:48.000",
      "formatted_end": "00:30:49.000",
      "text": "چند سانشه؟"
    },
    {
      "id": 9,
      "start": 1849.0,
      "end": 1850.0,
      "formatted_start": "00:30:49.000",
      "formatted_end": "00:30:50.000",
      "text": "دوست"
    },
    {
      "id": 10,
      "start": 1850.0,
      "end": 1851.0,
      "formatted_start": "00:30:50.000",
      "formatted_end": "00:30:51.000",
      "text": "دوست"
    },
    {
      "id": 11,
      "start": 1851.0,
      "end": 1853.0,
      "formatted_start": "00:30:51.000",
      "formatted_end": "00:30:53.000",
      "text": "تاریخشو دقیق بگو"
    },
    {
      "id": 12,
      "start": 1853.0,
      "end": 1856.0,
      "formatted_start": "00:30:53.000",
      "formatted_end": "00:30:56.000",
      "text": "سه یکه یادشش"
    },
    {
      "id": 13,
      "start": 1856.0,
      "end": 1858.0,
      "formatted_start": "00:30:56.000",
      "formatted_end": "00:30:58.000",
      "text": "یکه سه یادشش"
    },
    {
      "id": 14,
      "start": 1858.0,
      "end": 1860.0,
      "formatted_start": "00:30:58.000",
      "formatted_end": "00:31:00.000",
      "text": "پروردی ماهی"
    },
    {
      "id": 15,
      "start": 1860.0,
      "end": 1862.0,
      "formatted_start": "00:31:00.000",
      "formatted_end": "00:31:02.000",
      "text": "چهار"
    },
    {
      "id": 16,
      "start": 1862.0,
      "end": 1864.0,
      "formatted_start": "00:31:02.000",
      "formatted_end": "00:31:04.000",
      "text": "نه سال و"
    },
    {
      "id": 17,
      "start": 1864.0,
      "end": 1866.0,
      "formatted_start": "00:31:04.000",
      "formatted_end": "00:31:06.000",
      "text": "خوده"
    },
    {
      "id": 18,
      "start": 1866.0,
      "end": 1868.0,
      "formatted_start": "00:31:06.000",
      "formatted_end": "00:31:08.000",
      "text": "ایش سه"
    },
    {
      "id": 19,
      "start": 1868.0,
      "end": 1870.0,
      "formatted_start": "00:31:08.000",
      "formatted_end": "00:31:10.000",
      "text": "سه زبنه"
    },
    {
      "id": 20,
      "start": 1870.0,
      "end": 1872.0,
      "formatted_start": "00:31:10.000",
      "formatted_end": "00:31:12.000",
      "text": "یا سه"
    },
    {
      "id": 21,
      "start": 1872.0,
      "end": 1874.0,
      "formatted_start": "00:31:12.000",
      "formatted_end": "00:31:14.000",
      "text": "خوب زبنت مصننش کچک بوده"
    },
    {
      "id": 22,
      "start": 1874.0,
      "end": 1876.0,
      "formatted_start": "00:31:14.000",
      "formatted_end": "00:31:16.000",
      "text": "و با قمان به ادرافش"
    },
    {
      "id": 23,
      "start": 1876.0,
      "end": 1878.0,
      "formatted_start": "00:31:16.000",
      "formatted_end": "00:31:18.000",
      "text": "زبنت مصننش کچک بوده"
    },
    {
      "id": 24,
      "start": 1878.0,
      "end": 1880.0,
      "formatted_start": "00:31:18.000",
      "formatted_end": "00:31:20.000",
      "text": "که باید"
    },
    {
      "id": 25,
      "start": 1880.0,
      "end": 1882.0,
      "formatted_start": "00:31:20.000",
      "formatted_end": "00:31:22.000",
      "text": "سه زبنه یا زبنه"
    },
    {
      "id": 26,
      "start": 1882.0,
      "end": 1884.0,
      "formatted_start": "00:31:22.000",
      "formatted_end": "00:31:24.000",
      "text": "باید"
    },
    {
      "id": 27,
      "start": 1884.0,
      "end": 1892.0,
      "formatted_start": "00:31:24.000",
      "formatted_end": "00:31:32.000",
      "text": "که باید از سی زردار ۱۱۰۰۵۰ تا باید جا بشه و چنین ست تا مصانعش کوچیک بوده"
    },
    {
      "id": 28,
      "start": 1892.0,
      "end": 1896.0,
      "formatted_start": "00:31:32.000",
      "formatted_end": "00:31:36.000",
      "text": "و باقی ماندهش هم پنج تا بوده"
    },
    {
      "id": 29,
      "start": 1896.0,
      "end": 1905.0,
      "formatted_start": "00:31:36.000",
      "formatted_end": "00:31:45.000",
      "text": "باید برای تخلیقهای زیر ۱۰۰۰ تنه مصانع باشه"
    },
    {
      "id": 30,
      "start": 1905.0,
      "end": 1908.0,
      "formatted_start": "00:31:45.000",
      "formatted_end": "00:31:48.000",
      "text": "خب اینکه مصانعش اونش رو بیرون کوچیکه"
    },
    {
      "id": 31,
      "start": 1908.0,
      "end": 1911.0,
      "formatted_start": "00:31:48.000",
      "formatted_end": "00:31:51.000",
      "text": "الان اون قرص هایی که ما دادیم مصانع رو باید گشار کنه"
    },
    {
      "id": 32,
      "start": 1911.0,
      "end": 1912.0,
      "formatted_start": "00:31:51.000",
      "formatted_end": "00:31:52.000",
      "text": "خوابابر نبود؟"
    },
    {
      "id": 33,
      "start": 1912.0,
      "end": 1913.0,
      "formatted_start": "00:31:52.000",
      "formatted_end": "00:31:53.000",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 1913.0,
      "end": 1915.0,
      "formatted_start": "00:31:53.000",
      "formatted_end": "00:31:55.000",
      "text": "خوب بود مشکلی نداشت باشه"
    },
    {
      "id": 35,
      "start": 1915.0,
      "end": 1917.0,
      "formatted_start": "00:31:55.000",
      "formatted_end": "00:31:57.000",
      "text": "خوب وضع تو بگیرم"
    },
    {
      "id": 36,
      "start": 1917.0,
      "end": 1919.0,
      "formatted_start": "00:31:57.000",
      "formatted_end": "00:31:59.000",
