      "start": 1995.44,
      "end": 2007.08,
      "formatted_start": "00:33:15.440",
      "formatted_end": "00:33:27.080",
      "text": "اگر در تیه یک ماه آینده کمتر از پنج بار شب ادراری داشت"
    },
