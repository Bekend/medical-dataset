      "start": 1975.0,
      "end": 1978.68,
      "formatted_start": "00:32:55.000",
      "formatted_end": "00:32:58.680",
      "text": "منی قرصه رو فیلم باید بدی همون جوری"
    },
    {
      "id": 55,
      "start": 1978.68,
      "end": 1982.0,
      "formatted_start": "00:32:58.680",
      "formatted_end": "00:33:02.000",
      "text": "ولی اسپریه رو یه شب درمیون بکنیم"
    },
    {
      "id": 56,
      "start": 1982.0,
      "end": 1991.94,
      "formatted_start": "00:33:02.000",
      "formatted_end": "00:33:11.940",
      "text": "اگر اسپریه ها یک شب درمیون شود"
    },
