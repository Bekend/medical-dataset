      "start": 1931.0,
      "end": 1933.0,
      "formatted_start": "00:32:11.000",
      "formatted_end": "00:32:13.000",
      "text": "یه دیگه"
    },
    {
      "id": 43,
      "start": 1933.0,
      "end": 1937.0,
      "formatted_start": "00:32:13.000",
      "formatted_end": "00:32:17.000",
      "text": "میبینم بس چرا هندونه میخونه"
    },
    {
      "id": 44,
      "start": 1937.0,
      "end": 1939.0,
      "formatted_start": "00:32:17.000",
      "formatted_end": "00:32:19.000",
      "text": "چایی میخونه آب میبونه اصلا جیش نداره"
    },
    {
      "id": 45,
      "start": 1939.0,
      "end": 1941.0,
      "formatted_start": "00:32:19.000",
      "formatted_end": "00:32:21.000",
      "text": "بس ماما این رو کنه نمیخوره"
    },
    {
      "id": 46,
      "start": 1941.0,
      "end": 1947.0,
      "formatted_start": "00:32:21.000",
      "formatted_end": "00:32:27.000",
      "text": "اون شبایی که این رو میخوره نداره و نمیخوره"
    },
    {
      "id": 47,
      "start": 1947.0,
      "end": 1950.0,
      "formatted_start": "00:32:27.000",
      "formatted_end": "00:32:30.000",
      "text": "اعتماد که یک غذایی صرف میخوره دیگه طب صرف"
    },
    {
      "id": 48,
      "start": 1950.0,
      "end": 1955.0,
      "formatted_start": "00:32:30.000",
      "formatted_end": "00:32:35.000",
      "text": "دیگه از اینکه مثلا ماس زیاد میخوره حتی و میاهاتی نباشه کنارش مثلا ماس زیاد میخوره"
    },
    {
      "id": 49,
      "start": 1955.0,
      "end": 1959.0,
      "formatted_start": "00:32:35.000",
      "formatted_end": "00:32:39.000",
      "text": "یا گرمی کم میخوره شیرمی اون روز کم تر خورده"
    },
