  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2130.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:30.000",
      "text": "از اینجا، با اینکه باید برنامه بیشتر بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، باید بردارید، با"
    },
    {
      "id": 1,
      "start": 2130.0,
      "end": 2132.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:32.000",
      "text": "خوابش که داره؟"
    },
    {
      "id": 2,
      "start": 2132.0,
      "end": 2134.0,
      "formatted_start": "00:35:32.000",
      "formatted_end": "00:35:34.000",
      "text": "خوابش که داره؟"
    },
    {
      "id": 3,
      "start": 2134.0,
      "end": 2136.0,
      "formatted_start": "00:35:34.000",
      "formatted_end": "00:35:36.000",
      "text": "آه، خستگی هم میشه"
    },
    {
      "id": 4,
      "start": 2136.0,
      "end": 2138.0,
      "formatted_start": "00:35:36.000",
      "formatted_end": "00:35:38.000",
      "text": "خیلی زیادی بیرون بیرون"
    },
    {
      "id": 5,
      "start": 2138.0,
      "end": 2140.0,
      "formatted_start": "00:35:38.000",
      "formatted_end": "00:35:40.000",
      "text": "نه"
    },
    {
      "id": 6,
      "start": 2140.0,
      "end": 2142.0,
      "formatted_start": "00:35:40.000",
      "formatted_end": "00:35:42.000",
      "text": "من یکی اینجا باید برم"
    },
    {
      "id": 7,
      "start": 2142.0,
      "end": 2144.0,
      "formatted_start": "00:35:42.000",
      "formatted_end": "00:35:44.000",
      "text": "خوابش عمیق بشه که نفهمه بیداروش نشه"
    },
    {
      "id": 8,
      "start": 2144.0,
      "end": 2146.0,
      "formatted_start": "00:35:44.000",
      "formatted_end": "00:35:46.000",
      "text": "و خستگی از اینجا هم میشه"
    },
    {
      "id": 9,
      "start": 2146.0,
      "end": 2148.0,
      "formatted_start": "00:35:46.000",
      "formatted_end": "00:35:48.000",
      "text": "زیادی هم بزرگ همش بیرونم"
    },
    {
      "id": 10,
      "start": 2148.0,
      "end": 2150.0,
      "formatted_start": "00:35:48.000",
      "formatted_end": "00:35:50.000",
      "text": "درست داری؟"
    },
    {
      "id": 11,
      "start": 2150.0,
      "end": 2152.0,
      "formatted_start": "00:35:50.000",
      "formatted_end": "00:35:52.000",
      "text": "درست داری؟"
    },
    {
      "id": 12,
      "start": 2152.0,
      "end": 2154.0,
      "formatted_start": "00:35:52.000",
      "formatted_end": "00:35:54.000",
      "text": "درست داری؟"
    },
    {
      "id": 13,
      "start": 2154.0,
      "end": 2156.0,
      "formatted_start": "00:35:54.000",
      "formatted_end": "00:35:56.000",
      "text": "درست داری؟"
    },
    {
      "id": 14,
      "start": 2156.0,
      "end": 2158.0,
      "formatted_start": "00:35:56.000",
      "formatted_end": "00:35:58.000",
      "text": "درست داری؟"
    },
    {
      "id": 15,
      "start": 2158.0,
      "end": 2165.0,
      "formatted_start": "00:35:58.000",
      "formatted_end": "00:36:05.000",
      "text": "خیلی خستگیره شد. دیگه شبت نیمیتونم. برای میریده داریم."
    },
    {
      "id": 16,
      "start": 2178.0,
      "end": 2180.0,
      "formatted_start": "00:36:18.000",
      "formatted_end": "00:36:20.000",
      "text": "بسیار مردم."
    },
    {
      "id": 17,
      "start": 2180.0,
      "end": 2182.0,
      "formatted_start": "00:36:20.000",
      "formatted_end": "00:36:22.000",
      "text": "دارو آزینه که اگر اینجا که..."
    },
    {
      "id": 18,
      "start": 2182.0,
      "end": 2185.0,
      "formatted_start": "00:36:22.000",
      "formatted_end": "00:36:25.000",
      "text": "میدونین دیگه نه. میدونین نمیشنون برای چه اینجا."
    },
    {
      "id": 19,
      "start": 2185.0,
      "end": 2186.0,
      "formatted_start": "00:36:25.000",
      "formatted_end": "00:36:26.000",
      "text": "بسیار مردم."
    },
    {
      "id": 20,
      "start": 2186.0,
      "end": 2192.0,
      "formatted_start": "00:36:26.000",
      "formatted_end": "00:36:32.000",
      "text": "بازم رو برگه بریم سیاه برای دو ماه"
    },
    {
      "id": 21,
      "start": 2192.0,
      "end": 2197.34,
      "formatted_start": "00:36:32.000",
      "formatted_end": "00:36:37.340",
      "text": "برای دو ماه رو برگه دوباره بنویس"
    },
    {
      "id": 22,
      "start": 2197.34,
      "end": 2201.5,
      "formatted_start": "00:36:37.340",
      "formatted_end": "00:36:41.500",
      "text": "آره از این شب باز شروع کنم نویشم برای دو ماه"
    },
    {
      "id": 23,
      "start": 2201.5,
      "end": 2202.18,
      "formatted_start": "00:36:41.500",
      "formatted_end": "00:36:42.180",
      "text": "مهرابان"
    },
    {
      "id": 24,
      "start": 2202.18,
      "end": 2215.5,
      "formatted_start": "00:36:42.180",
      "formatted_end": "00:36:55.500",
      "text": "سلام"
    },
    {
      "id": 25,
      "start": 2215.5,
      "end": 2217.5,
      "formatted_start": "00:36:55.500",
      "formatted_end": "00:36:57.500",
      "text": "سرم سرم"
    },
    {
      "id": 26,
      "start": 2217.5,
      "end": 2219.5,
      "formatted_start": "00:36:57.500",
      "formatted_end": "00:36:59.500",
      "text": "ده بیزشه؟"
    },
    {
      "id": 27,
      "start": 2219.5,
      "end": 2221.5,
      "formatted_start": "00:36:59.500",
      "formatted_end": "00:37:01.500",
      "text": "بله"
    },
    {
      "id": 28,
