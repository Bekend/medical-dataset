    {
      "id": 37,
      "start": 2239.5,
      "end": 2241.5,
      "formatted_start": "00:37:19.500",
      "formatted_end": "00:37:21.500",
      "text": "خلاصه در چیزش هست"
    },
    {
      "id": 38,
      "start": 2241.5,
      "end": 2243.5,
      "formatted_start": "00:37:21.500",
      "formatted_end": "00:37:23.500",
      "text": "بله"
    },
    {
      "id": 39,
      "start": 2243.5,
      "end": 2273.5,
      "formatted_start": "00:37:23.500",
      "formatted_end": "00:37:53.500",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 40,
      "start": 2273.5,
      "end": 2278.5,
      "formatted_start": "00:37:53.500",
      "formatted_end": "00:37:58.500",
      "text": "ناره تا کیمی خفیف بستری چند روز بوده؟"
    },
    {
      "id": 41,
      "start": 2278.5,
      "end": 2280.5,
      "formatted_start": "00:37:58.500",
      "formatted_end": "00:38:00.500",
      "text": "دو روز"
    },
    {
      "id": 42,
      "start": 2280.5,
      "end": 2282.5,
      "formatted_start": "00:38:00.500",
      "formatted_end": "00:38:02.500",
      "text": "بستری دو روزه شیر مادر فقط؟"
    },
    {
      "id": 43,
      "start": 2282.5,
      "end": 2288.5,
      "formatted_start": "00:38:02.500",
      "formatted_end": "00:38:08.500",
      "text": "بستری بود یکی دو با شیر خوش دارم جان باید شیر نشتم"
    },
    {
      "id": 44,
      "start": 2288.5,
      "end": 2290.5,
      "formatted_start": "00:38:08.500",
      "formatted_end": "00:38:10.500",
      "text": "ادرار مدفوعش خوبه؟"
    },
    {
      "id": 45,
      "start": 2290.5,
      "end": 2295.5,
      "formatted_start": "00:38:10.500",
      "formatted_end": "00:38:15.500",
      "text": "آره خب باید بندود دو موزه چوی هستال با صدا"
    },
    {
      "id": 46,
      "start": 2295.5,
      "end": 2297.5,
      "formatted_start": "00:38:15.500",
      "formatted_end": "00:38:17.500",
      "text": "دارو خواست بشتری برای دردی؟"
    },
    {
      "id": 47,
      "start": 2297.5,
      "end": 2298.5,
      "formatted_start": "00:38:17.500",
      "formatted_end": "00:38:18.500",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 2298.5,
      "end": 2300.5,
      "formatted_start": "00:38:18.500",
      "formatted_end": "00:38:20.500",
      "text": "خب اینکه من خواهد نمیدونم"
    },
    {
      "id": 49,
      "start": 2300.5,
      "end": 2305.4,
      "formatted_start": "00:38:20.500",
      "formatted_end": "00:38:25.400",
      "text": "بر اون، من خواهم داشت همون دکتر دانیدیکا نروشت"
    },
    {
      "id": 50,
      "start": 2305.4,
      "end": 2307.4,
      "formatted_start": "00:38:25.400",
      "formatted_end": "00:38:27.400",
      "text": "با اولانی امانیه که ندارم"
    },
    {
      "id": 51,
      "start": 2307.4,
      "end": 2308.4,
      "formatted_start": "00:38:27.400",
      "formatted_end": "00:38:28.400",
      "text": "آره دانیدیکا ندارم"
    },
    {
      "id": 52,
      "start": 2308.4,
      "end": 2312.9,
      "formatted_start": "00:38:28.400",
      "formatted_end": "00:38:32.900",
      "text": "آشکان نداره برو اونو بلی بی نستر یا همون نستر باعث اصحاب میشه"
    },
    {
      "id": 53,
      "start": 2312.9,
      "end": 2314.9,
      "formatted_start": "00:38:32.900",
      "formatted_end": "00:38:34.900",
      "text": "و خوابانی بی بی اونو ندارید"
    },
    {
      "id": 54,
      "start": 2318.9,
      "end": 2320.9,
      "formatted_start": "00:38:38.900",
      "formatted_end": "00:38:40.900",
      "text": "این کاری چقدر خواهید؟"
    },
    {
      "id": 55,
      "start": 2320.9,
      "end": 2322.9,
      "formatted_start": "00:38:40.900",
      "formatted_end": "00:38:42.900",
      "text": "خواهی ندار"
    },
    {
      "id": 56,
      "start": 2326.9,
      "end": 2328.9,
      "formatted_start": "00:38:46.900",
      "formatted_end": "00:38:48.900",
      "text": "این کاری خواهی نداری"
    },
    {
      "id": 57,
      "start": 2328.9,
      "end": 2335.9,
      "formatted_start": "00:38:48.900",
      "formatted_end": "00:38:55.900",
      "text": "این زردی داره، این عرام از اون دنبه در دستگاه این پانیوت رو باید اضافه بشه تقریبا دو سال"
    },
    {
      "id": 58,
      "start": 2335.9,
      "end": 2344.9,
      "formatted_start": "00:38:55.900",
      "formatted_end": "00:39:04.900",
      "text": "بعدی شیرم مادر باشه، انگه افراد ادراوی نباشه، اکنش که آزمانشش رو آزمانش چیز میدادی، خون میدادی بلی"
    },
    {
      "id": 59,
      "start": 2344.9,
      "end": 2353.9,
      "formatted_start": "00:39:04.900",
      "formatted_end": "00:39:13.900",
      "text": "باز هم الان برای دهنگوته اشکال نداره، خب این زردی شما برای این باید دستگاه بذاری دو روز تو خونه"
    },
    {
      "id": 60,
      "start": 2353.9,
      "end": 2359.9,
      "formatted_start": "00:39:13.900",
      "formatted_end": "00:39:19.900",
      "text": "اگر این زردیت رو 14 روزگی ادامه داریم، ما باید آزمایش کامل بریم. ادرار مفهوم."
    },
    {
      "id": 61,
      "start": 2359.9,
      "end": 2361.9,
      "formatted_start": "00:39:19.900",
      "formatted_end": "00:39:21.900",
      "text": "فقط زردی نیست. تیروید و..."
    },
    {
      "id": 62,
      "start": 2361.9,
      "end": 2365.9,
      "formatted_start": "00:39:21.900",
      "formatted_end": "00:39:25.900",
      "text": "تیرویدش ببینیم تکار این هفته دوباره چون بستنش رو داریم."
    },
    {
      "id": 63,
      "start": 2365.9,
      "end": 2368.9,
      "formatted_start": "00:39:25.900",
      "formatted_end": "00:39:28.900",
      "text": "آره آره، 14 روزگی آره."
    },
    {
      "id": 64,
      "start": 2374.9,
      "end": 2375.9,
      "formatted_start": "00:39:34.900",
      "formatted_end": "00:39:35.900",
      "text": "مانو تون یک سی دوتا بود."
    },
    {
      "id": 65,
      "start": 2375.9,
      "end": 2378.9,
      "formatted_start": "00:39:35.900",
      "formatted_end": "00:39:38.900",
      "text": "آره مانو چه مثلا زردی نگه یک دیگه؟"
    },
    {
      "id": 66,
      "start": 2378.9,
      "end": 2380.9,
      "formatted_start": "00:39:38.900",
      "formatted_end": "00:39:40.900",
      "text": "چی گفتی؟ میگه همون یک سی دوتا."
    },
    {
      "id": 67,
      "start": 2380.9,
      "end": 2382.9,
      "formatted_start": "00:39:40.900",
      "formatted_end": "00:39:42.900",
      "text": "زردی نگه یک دیگه؟"
    },
    {
      "id": 68,
      "start": 2382.9,
      "end": 2384.9,
      "formatted_start": "00:39:42.900",
      "formatted_end": "00:39:44.900",
      "text": "محال"
    },
    {
      "id": 69,
      "start": 2390.66,
      "end": 2392.66,
      "formatted_start": "00:39:50.660",
      "formatted_end": "00:39:52.660",
      "text": "بیرون از این شویده"
    }
  ],
