      "start": 2225.5,
      "end": 2227.5,
      "formatted_start": "00:37:05.500",
      "formatted_end": "00:37:07.500",
      "text": "نه نه در بیمارستان بسری شد"
    },
    {
      "id": 31,
      "start": 2227.5,
      "end": 2229.5,
      "formatted_start": "00:37:07.500",
      "formatted_end": "00:37:09.500",
      "text": "نوه دانیا آمدن"
    },
    {
      "id": 32,
      "start": 2229.5,
      "end": 2231.5,
      "formatted_start": "00:37:09.500",
      "formatted_end": "00:37:11.500",
      "text": "او آزمان شده نوه بچه؟"
    },
    {
      "id": 33,
      "start": 2231.5,
      "end": 2233.5,
      "formatted_start": "00:37:11.500",
      "formatted_end": "00:37:13.500",
      "text": "نه نه"
    },
    {
      "id": 34,
      "start": 2233.5,
      "end": 2235.5,
      "formatted_start": "00:37:13.500",
      "formatted_end": "00:37:15.500",
      "text": "در بیمارستان کجا؟"
    },
    {
      "id": 35,
      "start": 2235.5,
      "end": 2237.5,
      "formatted_start": "00:37:15.500",
      "formatted_end": "00:37:17.500",
      "text": "در اینکه بود"
    },
    {
