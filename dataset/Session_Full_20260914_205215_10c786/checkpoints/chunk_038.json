  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11406.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:06.000",
      "text": "داخل هم بره، اشکال نداره، ولی برای بختران، میدیوگران، اینو این مشکلی جایی کنید."
    },
    {
      "id": 1,
      "start": 11412.0,
      "end": 11420.0,
      "formatted_start": "03:10:12.000",
      "formatted_end": "03:10:20.000",
      "text": "این مایه هایی که برای موقع شستش رو، مایه بدن بچه های فیروزه، اونو مشکله نداره استفاده کنید؟"
    },
    {
      "id": 2,
      "start": 11420.0,
      "end": 11429.0,
      "formatted_start": "03:10:20.000",
      "formatted_end": "03:10:29.000",
      "text": "شوینده زیاد استفاده نکنید. شوینده فقط یک بار در روز. اونم افتاده دیگه یک بار هم نمیخواد. همون میره فقط."
    },
    {
      "id": 3,
      "start": 11429.0,
      "end": 11434.0,
      "formatted_start": "03:10:29.000",
      "formatted_end": "03:10:34.000",
      "text": "چون سن نیستش که یک بار در روز. اما اصلا شوینده نمیخواد استفاده کنید چون پوست اونجا حساسه."
    },
    {
      "id": 4,
      "start": 11434.0,
      "end": 11441.0,
      "formatted_start": "03:10:34.000",
      "formatted_end": "03:10:41.000",
      "text": "و با استفاده شوینده آر شروع شیف کنه. اون لایه محفظ رو میبره. شوینده فقط همون."
    },
    {
      "id": 5,
      "start": 11441.0,
      "end": 11447.0,
      "formatted_start": "03:10:41.000",
      "formatted_end": "03:10:47.000",
      "text": "این موقع شس و شویه همون رو بگیرم و حدود به اغر باشه"
    },
    {
      "id": 6,
      "start": 11447.0,
      "end": 11448.0,
      "formatted_start": "03:10:47.000",
      "formatted_end": "03:10:48.000",
      "text": "چی؟"
    },
    {
      "id": 7,
      "start": 11448.0,
      "end": 11449.0,
      "formatted_start": "03:10:48.000",
      "formatted_end": "03:10:49.000",
      "text": "حدود به اغر باشه"
    },
    {
      "id": 8,
      "start": 11449.0,
      "end": 11452.0,
      "formatted_start": "03:10:49.000",
      "formatted_end": "03:10:52.000",
      "text": "این هدوم هم باید تست بگوشم، یعنی لازم به بچه هم هم دست کشته باشه"
    },
    {
      "id": 9,
      "start": 11452.0,
      "end": 11454.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:54.000",
      "text": "توی سکنت جلو باشتیم"
    },
    {
      "id": 10,
      "start": 11454.0,
      "end": 11456.0,
      "formatted_start": "03:10:54.000",
      "formatted_end": "03:10:56.000",
      "text": "برون برون، آب بزنید"
    },
    {
      "id": 11,
      "start": 11456.0,
      "end": 11457.0,
      "formatted_start": "03:10:56.000",
      "formatted_end": "03:10:57.000",
      "text": "برون"
    },
    {
      "id": 12,
      "start": 11457.0,
      "end": 11461.0,
      "formatted_start": "03:10:57.000",
      "formatted_end": "03:11:01.000",
      "text": "اولا این ها میشه، پس اون نگولنزه را سشت بگیرم"
    },
    {
      "id": 13,
      "start": 11461.0,
      "end": 11462.0,
      "formatted_start": "03:11:01.000",
      "formatted_end": "03:11:02.000",
      "text": "هر چی که نزدیک"
    },
    {
      "id": 14,
      "start": 11462.0,
      "end": 11464.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:04.000",
      "text": "آه این هم داری؟"
    },
    {
      "id": 15,
      "start": 11464.0,
      "end": 11466.0,
      "formatted_start": "03:11:04.000",
      "formatted_end": "03:11:06.000",
      "text": "این هم استفاده کن، صبح شبیه"
    },
    {
      "id": 16,
      "start": 11466.0,
      "end": 11468.0,
      "formatted_start": "03:11:06.000",
      "formatted_end": "03:11:08.000",
      "text": "تمام چون این ها همه را استفاده کرد."
    },
    {
      "id": 17,
      "start": 11468.0,
      "end": 11471.0,
      "formatted_start": "03:11:08.000",
      "formatted_end": "03:11:11.000",
      "text": "فقط این دو نگرمه از هر کدوم یک دوست میگیر."
    },
    {
      "id": 18,
      "start": 11471.0,
      "end": 11473.0,
      "formatted_start": "03:11:11.000",
      "formatted_end": "03:11:13.000",
      "text": "این از این و این از اون."
    },
    {
      "id": 19,
      "start": 11475.0,
      "end": 11477.0,
      "formatted_start": "03:11:15.000",
      "formatted_end": "03:11:17.000",
      "text": "خواهشون کلمترش."
    },
    {
      "id": 20,
      "start": 11477.0,
      "end": 11479.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:19.000",
      "text": "کلمترش."
    },
    {
      "id": 21,
      "start": 11479.0,
      "end": 11481.0,
      "formatted_start": "03:11:19.000",
      "formatted_end": "03:11:21.000",
      "text": "باز باشید."
    },
    {
      "id": 22,
      "start": 11481.0,
      "end": 11483.0,
      "formatted_start": "03:11:21.000",
      "formatted_end": "03:11:23.000",
      "text": "خوب بشین."
    },
    {
      "id": 23,
      "start": 11488.0,
      "end": 11490.0,
      "formatted_start": "03:11:28.000",
      "formatted_end": "03:11:30.000",
      "text": "دو یک."
    },
    {
      "id": 24,
      "start": 11490.0,
      "end": 11492.0,
      "formatted_start": "03:11:30.000",
      "formatted_end": "03:11:32.000",
      "text": "الان شن وقتش شده؟"
    },
    {
      "id": 25,
      "start": 11492.0,
      "end": 11494.0,
      "formatted_start": "03:11:32.000",
      "formatted_end": "03:11:34.000",
      "text": "از سیر شده."
    },
    {
      "id": 26,
      "start": 11494.0,
      "end": 11496.0,
      "formatted_start": "03:11:34.000",
      "formatted_end": "03:11:36.000",
      "text": "اینجا برگشت دیگه"
    },
    {
      "id": 27,
      "start": 11503.0,
      "end": 11506.0,
      "formatted_start": "03:11:43.000",
      "formatted_end": "03:11:46.000",
      "text": "آخره سه سالی دیگه"
    },
    {
      "id": 28,
      "start": 11518.0,
      "end": 11520.0,
      "formatted_start": "03:11:58.000",
      "formatted_end": "03:12:00.000",
      "text": "شخصیتی که برای برگشتون خورده؟"
    },
    {
      "id": 29,
      "start": 11520.0,
      "end": 11521.0,
      "formatted_start": "03:12:00.000",
      "formatted_end": "03:12:01.000",
      "text": "یک نصف"
    },
    {
      "id": 30,
      "start": 11521.0,
      "end": 11522.0,
      "formatted_start": "03:12:01.000",
      "formatted_end": "03:12:02.000",
      "text": "یک نصف در هفته؟"
    },
    {
      "id": 31,
      "start": 11522.0,
      "end": 11523.0,
      "formatted_start": "03:12:02.000",
      "formatted_end": "03:12:03.000",
      "text": "آمان"
    },
    {
      "id": 32,
      "start": 11523.0,
      "end": 11524.0,
      "formatted_start": "03:12:03.000",
      "formatted_end": "03:12:04.000",
      "text": "کلیم یک نصف در هفته"
    },
    {
      "id": 33,
      "start": 11524.0,
      "end": 11526.0,
      "formatted_start": "03:12:04.000",
      "formatted_end": "03:12:06.000",
      "text": "یه قطعه براشی"
    },
    {
      "id": 34,
      "start": 11526.0,
      "end": 11527.0,
      "formatted_start": "03:12:06.000",
      "formatted_end": "03:12:07.000",
      "text": "قطعه براشی"
    },
    {
      "id": 35,
      "start": 11527.0,
      "end": 11529.0,
      "formatted_start": "03:12:07.000",
      "formatted_end": "03:12:09.000",
      "text": "با یک برس در هفته"
    },
    {
      "id": 36,
      "start": 11529.0,
      "end": 11532.0,
      "formatted_start": "03:12:09.000",
      "formatted_end": "03:12:12.000",
      "text": "با یک برس در هفته"
    },
    {
      "id": 37,
      "start": 11532.0,
      "end": 11534.0,
      "formatted_start": "03:12:12.000",
      "formatted_end": "03:12:14.000",
      "text": "من..."
    },
    {
      "id": 38,
      "start": 11534.0,
      "end": 11536.0,
      "formatted_start": "03:12:14.000",
      "formatted_end": "03:12:16.000",
      "text": "کلیم یه لحظه بیا"
    },
    {
      "id": 39,
      "start": 11536.0,
      "end": 11537.0,
      "formatted_start": "03:12:16.000",
      "formatted_end": "03:12:17.000",
      "text": "وقت درمان"
    },
    {
      "id": 40,
      "start": 11537.0,
      "end": 11538.0,
      "formatted_start": "03:12:17.000",
      "formatted_end": "03:12:18.000",
      "text": "خوروش"
    },
    {
      "id": 41,
      "start": 11538.0,
      "end": 11539.0,
      "formatted_start": "03:12:18.000",
      "formatted_end": "03:12:19.000",
      "text": "آزمانش بکنم خانم"
    },
    {
      "id": 42,
      "start": 11539.0,
      "end": 11540.0,
      "formatted_start": "03:12:19.000",
      "formatted_end": "03:12:20.000",
      "text": "بگیم بکنم"
    },
    {
      "id": 43,
      "start": 11540.0,
      "end": 11541.0,
      "formatted_start": "03:12:20.000",
      "formatted_end": "03:12:21.000",
      "text": "ما به درمان"
    },
    {
      "id": 44,
      "start": 11541.0,
      "end": 11544.0,
      "formatted_start": "03:12:21.000",
      "formatted_end": "03:12:24.000",
      "text": "ما آخر سه سالگی که داروش رو قطع میکنیم"
    },
    {
      "id": 45,
      "start": 11544.0,
      "end": 11546.0,
      "formatted_start": "03:12:24.000",
      "formatted_end": "03:12:26.000",
      "text": "معمولاً"
    },
    {
      "id": 46,
      "start": 11546.0,
      "end": 11548.0,
      "formatted_start": "03:12:26.000",
      "formatted_end": "03:12:28.000",
      "text": "کلیم من بیماریز نمیدونم"
    },
    {
      "id": 47,
      "start": 11548.0,
      "end": 11550.66,
      "formatted_start": "03:12:28.000",
      "formatted_end": "03:12:30.660",
      "text": "چون خسته شدن بست که خان رو داریم چیز داشتیم"
    },
    {
      "id": 48,
      "start": 11550.66,
      "end": 11553.0,
      "formatted_start": "03:12:30.660",
      "formatted_end": "03:12:33.000",
      "text": "همین مسئله پر ما با زنگ میزنم"
    },
    {
      "id": 49,
      "start": 11553.0,
      "end": 11555.24,
      "formatted_start": "03:12:33.000",
      "formatted_end": "03:12:35.240",
      "text": "خودش بست"
    },
    {
      "id": 50,
      "start": 11555.24,
      "end": 11557.24,
      "formatted_start": "03:12:35.240",
      "formatted_end": "03:12:37.240",
      "text": "نه بسیار خودش بست"
    },
    {
      "id": 51,
      "start": 11557.24,
      "end": 11559.24,
      "formatted_start": "03:12:37.240",
      "formatted_end": "03:12:39.240",
      "text": "نه تایی باید بگیرید دیگه"
    },
    {
      "id": 52,
      "start": 11559.24,
      "end": 11561.24,
      "formatted_start": "03:12:39.240",
      "formatted_end": "03:12:41.240",
      "text": "دیدید سابقه نیم و هر اینجوری"
    },
    {
      "id": 53,
      "start": 11561.24,
      "end": 11564.76,
      "formatted_start": "03:12:41.240",
      "formatted_end": "03:12:44.760",
      "text": "خواستش میدهد نه هم کفتید دیگه مکزوی بزرگت"
    },
    {
      "id": 54,
      "start": 11564.76,
      "end": 11568.0,
      "formatted_start": "03:12:44.760",
      "formatted_end": "03:12:48.000",
      "text": "الان دیگه بعد ازشون شدید یا منو بگیرم بگوشیم"
    },
    {
      "id": 55,
      "start": 11568.0,
      "end": 11571.0,
      "formatted_start": "03:12:48.000",
      "formatted_end": "03:12:51.000",
      "text": "خوب"
    },
    {
      "id": 56,
      "start": 11571.0,
      "end": 11575.0,
      "formatted_start": "03:12:51.000",
      "formatted_end": "03:12:55.000",
      "text": "ببین بعد یک ماه بعد"
    },
    {
      "id": 57,
      "start": 11575.0,
      "end": 11577.0,
      "formatted_start": "03:12:55.000",
      "formatted_end": "03:12:57.000",
      "text": "یک ماه بعد باید آزمایش بدید"
    },
    {
      "id": 58,
      "start": 11577.0,
      "end": 11582.58,
      "formatted_start": "03:12:57.000",
      "formatted_end": "03:13:02.580",
      "text": "اگر حالا زیر سه باشه دیگه نمیخواد اصلا بیاری پیش من"
    },
    {
      "id": 59,
      "start": 11582.58,
      "end": 11585.96,
      "formatted_start": "03:13:02.580",
      "formatted_end": "03:13:05.960",
      "text": "اگه بالای سه باشه دیگه باز باید بیاری"
    },
    {
      "id": 60,
      "start": 11585.96,
      "end": 11586.58,
      "formatted_start": "03:13:05.960",
      "formatted_end": "03:13:06.580",
      "text": "باز"
    },
    {
      "id": 61,
      "start": 11586.58,
      "end": 11588.26,
      "formatted_start": "03:13:06.580",
      "formatted_end": "03:13:08.260",
      "text": "حالا باید شروع"
    },
    {
      "id": 62,
      "start": 11588.26,
      "end": 11590.2,
      "formatted_start": "03:13:08.260",
      "formatted_end": "03:13:10.200",
      "text": "بیا برد"
    },
    {
      "id": 63,
      "start": 11590.2,
      "end": 11592.1,
      "formatted_start": "03:13:10.200",
      "formatted_end": "03:13:12.100",
      "text": "چی میشه به راه میره یا نمیشه"
    },
    {
      "id": 64,
      "start": 11592.1,
      "end": 11593.1,
      "formatted_start": "03:13:12.100",
      "formatted_end": "03:13:13.100",
      "text": "کاردرمی"
    },
    {
      "id": 65,
      "start": 11593.1,
      "end": 11594.02,
      "formatted_start": "03:13:13.100",
      "formatted_end": "03:13:14.020",
      "text": "کاردرمی چی میرفتی که"
    },
    {
      "id": 66,
      "start": 11594.02,
      "end": 11595.24,
      "formatted_start": "03:13:14.020",
      "formatted_end": "03:13:15.240",
      "text": "آرام چی که"
    },
    {
      "id": 67,
      "start": 11595.24,
      "end": 11596.56,
      "formatted_start": "03:13:15.240",
      "formatted_end": "03:13:16.560",
      "text": "کاردرش باشه"
    },
    {
      "id": 68,
      "start": 11596.56,
      "end": 11597.58,
      "formatted_start": "03:13:16.560",
      "formatted_end": "03:13:17.580",
      "text": "که بارو"
    },
    {
      "id": 69,
      "start": 11597.58,
      "end": 11598.24,
      "formatted_start": "03:13:17.580",
      "formatted_end": "03:13:18.240",
      "text": "آرام چی"
    },
    {
      "id": 70,
      "start": 11598.24,
      "end": 11600.06,
      "formatted_start": "03:13:18.240",
      "formatted_end": "03:13:20.060",
      "text": "دو دو مثل مزنی یا مرچ"
    },
    {
      "id": 71,
      "start": 11600.06,
      "end": 11600.82,
      "formatted_start": "03:13:20.060",
      "formatted_end": "03:13:20.820",
      "text": "مزنی"
    },
    {
      "id": 72,
      "start": 11600.82,
      "end": 11602.18,
      "formatted_start": "03:13:20.820",
      "formatted_end": "03:13:22.180",
      "text": "اون یکی چی"
    },
    {
      "id": 73,
      "start": 11602.18,
      "end": 11604.16,
      "formatted_start": "03:13:22.180",
      "formatted_end": "03:13:24.160",
      "text": "اون باید باید که راه میره"
    },
    {
      "id": 74,
      "start": 11604.16,
      "end": 11606.16,
      "formatted_start": "03:13:24.160",
      "formatted_end": "03:13:26.160",
      "text": "اما چون بهترست که اون رو بزنشی؟"
    },
    {
      "id": 75,
      "start": 11606.16,
      "end": 11610.16,
      "formatted_start": "03:13:26.160",
      "formatted_end": "03:13:30.160",
      "text": "اون میرز نداره، اما یه افزیفتیش دید و آشی رو بیتر بیتر آشی رو بازم"
    },
    {
      "id": 76,
      "start": 11610.16,
      "end": 11612.16,
      "formatted_start": "03:13:30.160",
      "formatted_end": "03:13:32.160",
      "text": "آشی رو باید آزاد کنی؟"
    },
    {
      "id": 77,
      "start": 11612.16,
      "end": 11614.16,
      "formatted_start": "03:13:32.160",
      "formatted_end": "03:13:34.160",
      "text": "آه، آشی رو باید آزاد کنیم"
    },
    {
      "id": 78,
      "start": 11614.16,
      "end": 11616.16,
      "formatted_start": "03:13:34.160",
      "formatted_end": "03:13:36.160",
      "text": "بله، بزنشی بزنشی"
    },
    {
      "id": 79,
      "start": 11616.16,
      "end": 11618.16,
      "formatted_start": "03:13:36.160",
      "formatted_end": "03:13:38.160",
      "text": "لسه تو برده و لسه تو برده"
    },
    {
      "id": 80,
      "start": 11618.16,
      "end": 11620.16,
      "formatted_start": "03:13:38.160",
      "formatted_end": "03:13:40.160",
      "text": "خوشش اینا خوبه؟"
    },
    {
      "id": 81,
      "start": 11620.16,
      "end": 11622.16,
      "formatted_start": "03:13:40.160",
      "formatted_end": "03:13:42.160",
      "text": "آه، نه، نه، نه، نه، چون یه بابر برده باید خوبی بازمشی"
    },
    {
      "id": 82,
      "start": 11622.16,
      "end": 11624.16,
      "formatted_start": "03:13:42.160",
      "formatted_end": "03:13:44.160",
      "text": "زیخ نیست"
    },
    {
      "id": 83,
      "start": 11624.16,
      "end": 11626.16,
      "formatted_start": "03:13:44.160",
      "formatted_end": "03:13:46.160",
      "text": "مشکل نیست من امیران زن رو کنجه"
    },
    {
      "id": 84,
      "start": 11626.16,
      "end": 11628.16,
      "formatted_start": "03:13:46.160",
      "formatted_end": "03:13:48.160",
      "text": "بزرگی"
    },
    {
      "id": 85,
      "start": 11628.16,
      "end": 11632.16,
      "formatted_start": "03:13:48.160",
      "formatted_end": "03:13:52.160",
      "text": "یکیش یک تراشتی دیدی"
    },
    {
      "id": 86,
      "start": 11632.16,
      "end": 11634.16,
      "formatted_start": "03:13:52.160",
      "formatted_end": "03:13:54.160",
      "text": "یکیش یک تراشتی دیدی"
    },
    {
      "id": 87,
      "start": 11634.16,
      "end": 11636.16,
      "formatted_start": "03:13:54.160",
      "formatted_end": "03:13:56.160",
      "text": "یکیش یک تراشتی دیدی"
    },
    {
      "id": 88,
      "start": 11636.16,
      "end": 11644.16,
      "formatted_start": "03:13:56.160",
      "formatted_end": "03:14:04.160",
      "text": "ببین اصلا ما خودمون نمیدونیم که واقعا نارسا رو نگه داریم"
    },
    {
      "id": 89,
      "start": 11644.16,
      "end": 11646.16,
      "formatted_start": "03:14:04.160",
      "formatted_end": "03:14:06.160",
      "text": "عرضش داره یا نه"
    },
    {
      "id": 90,
      "start": 11646.16,
      "end": 11650.16,
      "formatted_start": "03:14:06.160",
      "formatted_end": "03:14:10.160",
      "text": "واقعا باید بالا پایین کنیم"
    },
    {
      "id": 91,
      "start": 11650.16,
      "end": 11654.38,
      "formatted_start": "03:14:10.160",
      "formatted_end": "03:14:14.380",
      "text": "آیا برای خانواده عرضش داره ما این بچه ها رو به درچنگ و دردون نجات بدیم؟"
    },
    {
      "id": 92,
      "start": 11654.38,
      "end": 11661.8,
      "formatted_start": "03:14:14.380",
      "formatted_end": "03:14:21.800",
      "text": "عوارض نارستینه دیگه، چشم، پای، مغزی، بینایی، شنبایی، هر کدومشون یه جور داره بینن"
    },
    {
      "id": 93,
      "start": 11661.8,
      "end": 11663.92,
      "formatted_start": "03:14:21.800",
      "formatted_end": "03:14:23.920",
      "text": "و برای بدورش اما از این نظر سخته"
    },
    {
      "id": 94,
      "start": 11663.92,
      "end": 11667.02,
      "formatted_start": "03:14:23.920",
      "formatted_end": "03:14:27.020",
      "text": "از نظر اخلاقی که ما این بچه ها رو نگه داریم"
    },
    {
      "id": 95,
      "start": 11667.02,
      "end": 11670.56,
      "formatted_start": "03:14:27.020",
      "formatted_end": "03:14:30.560",
      "text": "هزار تا مشکل در آینده به خانواده قبول نی کنند داشته باشند؟"
    },
    {
      "id": 96,
      "start": 11670.56,
      "end": 11672.64,
      "formatted_start": "03:14:30.560",
      "formatted_end": "03:14:32.640",
      "text": "یا نه، بذاریم برن"
    },
    {
      "id": 97,
      "start": 11672.64,
      "end": 11676.1,
      "formatted_start": "03:14:32.640",
      "formatted_end": "03:14:36.100",
      "text": "و مطمئن هم خودتون اگه اون موقع جای ما بودیم بودید نگهده"
    },
    {
      "id": 98,
      "start": 11676.1,
      "end": 11679.88,
      "formatted_start": "03:14:36.100",
      "formatted_end": "03:14:39.880",
      "text": "نمیدونیم چقدر سخته"
    },
    {
      "id": 99,
      "start": 11679.88,
      "end": 11685.24,
      "formatted_start": "03:14:39.880",
      "formatted_end": "03:14:45.240",
      "text": "اما از دقیقه اون باید بره و اون دایی برده"
    },
    {
      "id": 100,
      "start": 11685.24,
      "end": 11686.64,
      "formatted_start": "03:14:45.240",
      "formatted_end": "03:14:46.640",
      "text": "خیلی بسیاره"
    },
    {
      "id": 101,
      "start": 11686.64,
      "end": 11688.98,
      "formatted_start": "03:14:46.640",
      "formatted_end": "03:14:48.980",
      "text": "ما هم رشته همون از این قدر سخته که"
    },
    {
      "id": 102,
      "start": 11688.98,
      "end": 11691.64,
      "formatted_start": "03:14:48.980",
      "formatted_end": "03:14:51.640",
      "text": "انتخابه داریم"
    },
    {
      "id": 103,
      "start": 11691.64,
      "end": 11694.18,
      "formatted_start": "03:14:51.640",
      "formatted_end": "03:14:54.180",
      "text": "از اون دقیقه برمیشه"
    },
    {
      "id": 104,
      "start": 11694.18,
      "end": 11697.3,
      "formatted_start": "03:14:54.180",
      "formatted_end": "03:14:57.300",
      "text": "ما شکلات داریم"
    },
    {
      "id": 105,
      "start": 11697.3,
      "end": 11700.0,
      "formatted_start": "03:14:57.300",
      "formatted_end": "03:15:00.000",
      "text": "آرامش نداریم"
    }
  ],
  "status": "completed"
}