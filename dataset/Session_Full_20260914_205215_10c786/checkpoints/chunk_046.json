  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13810.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:10.000",
      "text": "آرده برنج و آب قریز که شد، یه ذره ی آرش آورد کن تو آر، این دقیقه آخر به این مخلیص آرده برنج و آب اضافه کن. شیرخوش بیشتر پنگانه روی گاز نموند."
    },
    {
      "id": 1,
      "start": 13810.0,
      "end": 13814.0,
      "formatted_start": "03:50:10.000",
      "formatted_end": "03:50:14.000",
      "text": "خوب، دیمه ایرانی هست."
    },
    {
      "id": 2,
      "start": 13814.0,
      "end": 13817.0,
      "formatted_start": "03:50:14.000",
      "formatted_end": "03:50:17.000",
      "text": "بعد آب اینا چقدر بدن؟"
    },
    {
      "id": 3,
      "start": 13817.0,
      "end": 13820.0,
      "formatted_start": "03:50:17.000",
      "formatted_end": "03:50:20.000",
      "text": "بعد سرورغایزان میتونی آردشت بدیم، من تا بسیار."
    },
    {
      "id": 4,
      "start": 13820.0,
      "end": 13822.0,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:22.000",
      "text": "هم یک سی سی یا..."
    },
    {
      "id": 5,
      "start": 13822.0,
      "end": 13825.0,
      "formatted_start": "03:50:22.000",
      "formatted_end": "03:50:25.000",
      "text": "یک کاشوقای کچویو، چهار کورید، چهار شیستیو."
    },
    {
      "id": 6,
      "start": 13825.0,
      "end": 13827.0,
      "formatted_start": "03:50:25.000",
      "formatted_end": "03:50:27.000",
      "text": "خواست دلش، خواست مرکز بکنید."
    },
    {
      "id": 7,
      "start": 13827.0,
      "end": 13831.0,
      "formatted_start": "03:50:27.000",
      "formatted_end": "03:50:31.000",
      "text": "این همون بعد از ترواد قصدی یک بار بکنید."
    },
    {
      "id": 8,
      "start": 13831.0,
      "end": 13835.0,
      "formatted_start": "03:50:31.000",
      "formatted_end": "03:50:35.000",
      "text": "درسته بهش آمو دیدن، دیگه همش گریم میکنه، میخواد آزم آمو داشت."
    },
    {
      "id": 9,
      "start": 13835.0,
      "end": 13837.0,
      "formatted_start": "03:50:35.000",
      "formatted_end": "03:50:37.000",
      "text": "درسته بهش آمو دیدن، دیگه همش گریم میکنه، میخواد آزم آمو داشت."
    },
    {
      "id": 10,
      "start": 13837.0,
      "end": 13845.0,
      "formatted_start": "03:50:37.000",
      "formatted_end": "03:50:45.000",
      "text": "اگه بینش حس بکنه، مثلا بهش شیر میدن، شیر خوشکن میدن، همش انگاه که چیزی داره یه دوست داره چیز بکنه."
    },
    {
      "id": 11,
      "start": 13845.0,
      "end": 13851.0,
      "formatted_start": "03:50:45.000",
      "formatted_end": "03:50:51.000",
      "text": "گریم کنه، درنجو بازی کنه، میشه بهش بدم بخور آروم میشن"
    },
    {
      "id": 12,
      "start": 13851.0,
      "end": 13856.0,
      "formatted_start": "03:50:51.000",
      "formatted_end": "03:50:56.000",
      "text": "این اینکه باید پنمایی نمیشه، آخر پنمایی اون این اولین زمانی که میشه"
    },
    {
      "id": 13,
      "start": 13856.0,
      "end": 13860.0,
      "formatted_start": "03:50:56.000",
      "formatted_end": "03:51:00.000",
      "text": "تو چهار و نمیزود چهار و سرده، یه ده روزیه که تنگ براشونی کنی"
    },
    {
      "id": 14,
      "start": 13860.0,
      "end": 13861.0,
      "formatted_start": "03:51:00.000",
      "formatted_end": "03:51:01.000",
      "text": "در بیسکوید مادر هم میشه؟"
    },
    {
      "id": 15,
      "start": 13861.0,
      "end": 13866.0,
      "formatted_start": "03:51:01.000",
      "formatted_end": "03:51:06.000",
      "text": "نه نه، فقط برنی، بعد سوپ، بیسکوید مادر اصلا هشماییه"
    },
    {
      "id": 16,
      "start": 13866.0,
      "end": 13869.0,
      "formatted_start": "03:51:06.000",
      "formatted_end": "03:51:09.000",
      "text": "برنی، سوپ، پلیتر"
    },
    {
      "id": 17,
      "start": 13871.0,
      "end": 13873.0,
      "formatted_start": "03:51:11.000",
      "formatted_end": "03:51:13.000",
      "text": "چی بود کریمی؟"
    },
    {
      "id": 18,
      "start": 13875.0,
      "end": 13877.0,
      "formatted_start": "03:51:15.000",
      "formatted_end": "03:51:17.000",
      "text": "چی بود؟"
    },
    {
      "id": 19,
      "start": 13889.0,
      "end": 13893.0,
      "formatted_start": "03:51:29.000",
      "formatted_end": "03:51:33.000",
      "text": "از اینکه شروع کردی آخرم مایت را شروع کردی"
    },
    {
      "id": 20,
      "start": 13893.0,
      "end": 13898.0,
      "formatted_start": "03:51:33.000",
      "formatted_end": "03:51:38.000",
      "text": "و این شبه خوشکه ای آره تا کم بعد بشه بودن؟"
    },
    {
      "id": 21,
      "start": 13898.0,
      "end": 13900.0,
      "formatted_start": "03:51:38.000",
      "formatted_end": "03:51:40.000",
      "text": "تا شیش ماه بعد از شروعش"
    },
    {
      "id": 22,
      "start": 13900.0,
      "end": 13902.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:42.000",
      "text": "از که شروع کردی؟"
    },
    {
      "id": 23,
      "start": 13902.0,
      "end": 13904.0,
      "formatted_start": "03:51:42.000",
      "formatted_end": "03:51:44.000",
      "text": "از ما همچنین یکی با همشی نیست"
    },
    {
      "id": 24,
      "start": 13904.0,
      "end": 13905.0,
      "formatted_start": "03:51:44.000",
      "formatted_end": "03:51:45.000",
      "text": "نیست"
    },
    {
      "id": 25,
      "start": 13905.0,
      "end": 13908.0,
      "formatted_start": "03:51:45.000",
      "formatted_end": "03:51:48.000",
      "text": "میتونید یه تا همه همون رو بیان باشید؟"
    },
    {
      "id": 26,
      "start": 13908.0,
      "end": 13911.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:51.000",
      "text": "که سپرات دارید؟"
    },
    {
      "id": 27,
      "start": 13911.0,
      "end": 13915.0,
      "formatted_start": "03:51:51.000",
      "formatted_end": "03:51:55.000",
      "text": "چرا؟ واقعا اتفاقا اون نشروتی که بینم دادم"
    },
    {
      "id": 28,
      "start": 13915.0,
      "end": 13917.0,
      "formatted_start": "03:51:55.000",
      "formatted_end": "03:51:57.000",
      "text": "جدید رو ملش ندادم"
    },
    {
      "id": 29,
      "start": 13917.0,
      "end": 13921.5,
      "formatted_start": "03:51:57.000",
      "formatted_end": "03:52:01.500",
      "text": "چون که هم اونن میخورن، بالا میاد و نمیدن، بلکه اشون بالا میارن."
    },
    {
      "id": 30,
      "start": 13921.5,
      "end": 13923.0,
      "formatted_start": "03:52:01.500",
      "formatted_end": "03:52:03.000",
      "text": "شیر پشتیش چیه؟"
    },
    {
      "id": 31,
      "start": 13923.0,
      "end": 13923.5,
      "formatted_start": "03:52:03.000",
      "formatted_end": "03:52:03.500",
      "text": "ای آر."
    },
    {
      "id": 32,
      "start": 13923.5,
      "end": 13925.0,
      "formatted_start": "03:52:03.500",
      "formatted_end": "03:52:05.000",
      "text": "نه، چیه ای آر؟"
    },
    {
      "id": 33,
      "start": 13925.0,
      "end": 13926.0,
      "formatted_start": "03:52:05.000",
      "formatted_end": "03:52:06.000",
      "text": "نان."
    },
    {
      "id": 34,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "نان، مدفوعش چطوره؟"
    },
    {
      "id": 35,
      "start": 13928.0,
      "end": 13930.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:10.000",
      "text": "روز یک بار."
    },
    {
      "id": 36,
      "start": 13930.0,
      "end": 13936.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:16.000",
      "text": "ببین، اگه به بلاک ای آر بدی، اصلا بالا نمیاره، بلی به بلاک ای آر سفر میکنه، شیطا بابره."
    },
    {
      "id": 37,
      "start": 13936.0,
      "end": 13939.5,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:19.500",
      "text": "واسه همین من چون قبلنا سابقه در فرخبیری روشته"
    },
    {
      "id": 38,
      "start": 13939.5,
      "end": 13944.24,
      "formatted_start": "03:52:19.500",
      "formatted_end": "03:52:24.240",
      "text": "واسه همین نان میار احتمالا اگه من بدم تا سری بدم سرکتر نشه"
    },
    {
      "id": 39,
      "start": 13944.24,
      "end": 13948.16,
      "formatted_start": "03:52:24.240",
      "formatted_end": "03:52:28.160",
      "text": "خب ببلایی که میار اصلا استفراغ نمی کنه ولی شیطان سرکت میشه"
    },
    {
      "id": 40,
      "start": 13948.16,
      "end": 13951.58,
      "formatted_start": "03:52:28.160",
      "formatted_end": "03:52:31.580",
      "text": "نه اون برای اون یه ذره استفراغش به نظر من قبول کنه"
    },
    {
      "id": 41,
      "start": 13951.58,
      "end": 13955.24,
      "formatted_start": "03:52:31.580",
      "formatted_end": "03:52:35.240",
      "text": "ای آرش رو ادامه بده با نان ولی ببلای سرکت میکنه محبتشان"
    },
    {
      "id": 42,
      "start": 13955.24,
      "end": 13956.0,
      "formatted_start": "03:52:35.240",
      "formatted_end": "03:52:36.000",
      "text": "نه همون"
    },
    {
      "id": 43,
      "start": 13956.0,
      "end": 13957.2,
      "formatted_start": "03:52:36.000",
      "formatted_end": "03:52:37.200",
      "text": "چون وزگیریش هم حالیه"
    },
    {
      "id": 44,
      "start": 13957.2,
      "end": 13962.72,
      "formatted_start": "03:52:37.200",
      "formatted_end": "03:52:42.720",
      "text": "چون مثلا شبت و صبح بهش شیر خودمون میدم اصلا مالا نمی آره"
    },
    {
      "id": 45,
      "start": 13962.72,
      "end": 13965.84,
      "formatted_start": "03:52:42.720",
      "formatted_end": "03:52:45.840",
      "text": "روزا هم شیر خودمون بهش میدم و زرختو بالا می آره"
    },
    {
      "id": 46,
      "start": 13965.84,
      "end": 13967.84,
      "formatted_start": "03:52:45.840",
      "formatted_end": "03:52:47.840",
      "text": "اون شیر خوشگرم میدم بالا می آره"
    },
    {
      "id": 47,
      "start": 13967.84,
      "end": 13971.92,
      "formatted_start": "03:52:47.840",
      "formatted_end": "03:52:51.920",
      "text": "اصلا مثلا شبت و صبح که دراست کشه بهش میدم اصلا مالا نمی آره"
    },
    {
      "id": 48,
      "start": 13971.92,
      "end": 13978.4,
      "formatted_start": "03:52:51.920",
      "formatted_end": "03:52:58.400",
      "text": "پس روی آمن تهلوتور ویزاره 1 سی سی باشوره غذای کمکی"
    },
    {
      "id": 49,
      "start": 13978.4,
      "end": 13982.08,
      "formatted_start": "03:52:58.400",
      "formatted_end": "03:53:02.080",
      "text": "الان شما ویزاروشو برای سرموکاری خواهید کنید"
    },
    {
      "id": 50,
      "start": 13982.08,
      "end": 13982.58,
      "formatted_start": "03:53:02.080",
      "formatted_end": "03:53:02.580",
      "text": "بشه"
    },
    {
      "id": 51,
      "start": 13982.58,
      "end": 13984.58,
      "formatted_start": "03:53:02.580",
      "formatted_end": "03:53:04.580",
      "text": "خیلی خوشمونده هست"
    },
    {
      "id": 52,
      "start": 13985.68,
      "end": 13988.68,
      "formatted_start": "03:53:05.680",
      "formatted_end": "03:53:08.680",
      "text": "لازم داراشو به همه شویه تن بیایید"
    },
    {
      "id": 53,
      "start": 13988.68,
      "end": 13989.68,
      "formatted_start": "03:53:08.680",
      "formatted_end": "03:53:09.680",
      "text": "بسیاری"
    },
    {
      "id": 54,
      "start": 13993.18,
      "end": 13995.18,
      "formatted_start": "03:53:13.180",
      "formatted_end": "03:53:15.180",
      "text": "کریمی من باید برم دیگه"
    },
    {
      "id": 55,
      "start": 14009.68,
      "end": 14011.68,
      "formatted_start": "03:53:29.680",
      "formatted_end": "03:53:31.680",
      "text": "سلام مام بساییم"
    },
    {
      "id": 56,
      "start": 14011.68,
      "end": 14013.68,
      "formatted_start": "03:53:31.680",
      "formatted_end": "03:53:33.680",
      "text": "اینجا باید برم اون باشه"
    },
    {
      "id": 57,
      "start": 14013.68,
      "end": 14015.68,
      "formatted_start": "03:53:33.680",
      "formatted_end": "03:53:35.680",
      "text": "شش با درست"
    },
    {
      "id": 58,
      "start": 14015.68,
      "end": 14017.68,
      "formatted_start": "03:53:35.680",
      "formatted_end": "03:53:37.680",
      "text": "خب دختری من اما دو سه روز نفر کرده"
    },
    {
      "id": 59,
      "start": 14017.68,
      "end": 14019.68,
      "formatted_start": "03:53:37.680",
      "formatted_end": "03:53:39.680",
      "text": "پرمی نفر؟"
    },
    {
      "id": 60,
      "start": 14019.68,
      "end": 14021.68,
      "formatted_start": "03:53:39.680",
      "formatted_end": "03:53:41.680",
      "text": "پرمی نفر"
    },
    {
      "id": 61,
      "start": 14021.68,
      "end": 14023.68,
      "formatted_start": "03:53:41.680",
      "formatted_end": "03:53:43.680",
      "text": "آقای خانم گرده"
    },
    {
      "id": 62,
      "start": 14023.68,
      "end": 14025.68,
      "formatted_start": "03:53:43.680",
      "formatted_end": "03:53:45.680",
      "text": "چه پرمده رو رای بودین؟"
    },
    {
      "id": 63,
      "start": 14025.68,
      "end": 14027.68,
      "formatted_start": "03:53:45.680",
      "formatted_end": "03:53:47.680",
      "text": "نه نه خیلی وقت اومدم"
    },
    {
      "id": 64,
      "start": 14027.68,
      "end": 14029.68,
      "formatted_start": "03:53:47.680",
      "formatted_end": "03:53:49.680",
      "text": "گرده وقت اومدم"
    },
    {
      "id": 65,
      "start": 14029.68,
      "end": 14031.68,
      "formatted_start": "03:53:49.680",
      "formatted_end": "03:53:51.680",
      "text": "گرده شیخ همان"
    },
    {
      "id": 66,
      "start": 14031.68,
      "end": 14033.68,
      "formatted_start": "03:53:51.680",
      "formatted_end": "03:53:53.680",
      "text": "گرده شیخ"
    },
    {
      "id": 67,
      "start": 14033.68,
      "end": 14035.68,
      "formatted_start": "03:53:53.680",
      "formatted_end": "03:53:55.680",
      "text": "اما خیلی کف داره"
    },
    {
      "id": 68,
      "start": 14035.68,
      "end": 14037.68,
      "formatted_start": "03:53:55.680",
      "formatted_end": "03:53:57.680",
      "text": "و آقای بیزش داره"
    },
    {
      "id": 69,
      "start": 14037.68,
      "end": 14039.68,
      "formatted_start": "03:53:57.680",
      "formatted_end": "03:53:59.680",
      "text": "این با شما؟"
    },
    {
      "id": 70,
      "start": 14069.68,
      "end": 14071.68,
      "formatted_start": "03:54:29.680",
      "formatted_end": "03:54:31.680",
      "text": "یه هفته است میگه اینجوری دلدرد دارد"
    },
    {
      "id": 71,
      "start": 14071.68,
      "end": 14073.68,
      "formatted_start": "03:54:31.680",
      "formatted_end": "03:54:33.680",
      "text": "زیبا چی؟"
    },
    {
      "id": 72,
      "start": 14073.68,
      "end": 14075.68,
      "formatted_start": "03:54:33.680",
      "formatted_end": "03:54:35.680",
      "text": "اسفان نشده"
    },
    {
      "id": 73,
      "start": 14075.68,
      "end": 14077.68,
      "formatted_start": "03:54:35.680",
      "formatted_end": "03:54:37.680",
      "text": "سریع غذا اصلا زیاد نمیخورد"
    },
    {
      "id": 74,
      "start": 14077.68,
      "end": 14079.68,
      "formatted_start": "03:54:37.680",
      "formatted_end": "03:54:39.680",
      "text": "درخواهش بست"
    },
    {
      "id": 75,
      "start": 14079.68,
      "end": 14081.68,
      "formatted_start": "03:54:39.680",
      "formatted_end": "03:54:41.680",
      "text": "بگو کنم مایو نزارو بکنم"
    },
    {
      "id": 76,
      "start": 14081.68,
      "end": 14083.68,
      "formatted_start": "03:54:41.680",
      "formatted_end": "03:54:43.680",
      "text": "بله باش کنم"
    },
    {
      "id": 77,
      "start": 14083.68,
      "end": 14085.68,
      "formatted_start": "03:54:43.680",
      "formatted_end": "03:54:45.680",
      "text": "باید اونجور بشین"
    },
    {
      "id": 78,
      "start": 14085.68,
      "end": 14087.68,
      "formatted_start": "03:54:45.680",
      "formatted_end": "03:54:47.680",
      "text": "باش"
    },
    {
      "id": 79,
      "start": 14087.68,
      "end": 14089.68,
      "formatted_start": "03:54:47.680",
      "formatted_end": "03:54:49.680",
      "text": "بیا بیا"
    },
    {
      "id": 80,
      "start": 14089.68,
      "end": 14091.68,
      "formatted_start": "03:54:49.680",
      "formatted_end": "03:54:51.680",
      "text": "چی کنش"
    },
    {
      "id": 81,
      "start": 14091.68,
      "end": 14093.68,
      "formatted_start": "03:54:51.680",
      "formatted_end": "03:54:53.680",
      "text": "آه"
    },
    {
      "id": 82,
      "start": 14093.68,
      "end": 14095.68,
      "formatted_start": "03:54:53.680",
      "formatted_end": "03:54:55.680",
      "text": "آه"
    },
    {
      "id": 83,
      "start": 14095.68,
      "end": 14097.68,
      "formatted_start": "03:54:55.680",
      "formatted_end": "03:54:57.680",
      "text": "آه"
    },
    {
      "id": 84,
      "start": 14097.68,
      "end": 14099.98,
      "formatted_start": "03:54:57.680",
      "formatted_end": "03:54:59.980",
      "text": "بگو آنها برای خونگردی شده"
    }
  ],
  "status": "completed"
}