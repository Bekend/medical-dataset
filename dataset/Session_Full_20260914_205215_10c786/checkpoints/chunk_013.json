  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3906.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:06.000",
      "text": "دوسته ماه های که مثلاً یه رنگش تغییر میکنی، بیمار میشه."
    },
    {
      "id": 1,
      "start": 3906.0,
      "end": 3908.0,
      "formatted_start": "01:05:06.000",
      "formatted_end": "01:05:08.000",
      "text": "خودش یه رنگش برخوردش."
    },
    {
      "id": 2,
      "start": 3908.0,
      "end": 3910.0,
      "formatted_start": "01:05:08.000",
      "formatted_end": "01:05:10.000",
      "text": "بیمار میشه."
    },
    {
      "id": 3,
      "start": 3910.0,
      "end": 3917.0,
      "formatted_start": "01:05:10.000",
      "formatted_end": "01:05:17.000",
      "text": "مخصوصاً وقتی که مثلاً تا دشوی، دشوی بزرگ که برد، بیجونی میشه."
    },
    {
      "id": 4,
      "start": 3924.0,
      "end": 3926.0,
      "formatted_start": "01:05:24.000",
      "formatted_end": "01:05:26.000",
      "text": "وقتی میخواهد برای دشوی بزرگ کنیم، بیمار میشه."
    },
    {
      "id": 5,
      "start": 3926.0,
      "end": 3930.0,
      "formatted_start": "01:05:26.000",
      "formatted_end": "01:05:30.000",
      "text": "سر می کنید که نگهش دارید"
    },
    {
      "id": 6,
      "start": 3930.0,
      "end": 3932.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:32.000",
      "text": "صرف می آد یا نرمید"
    },
    {
      "id": 7,
      "start": 3932.0,
      "end": 3934.0,
      "formatted_start": "01:05:32.000",
      "formatted_end": "01:05:34.000",
      "text": "ولی الان که از حال و تب جداست"
    },
    {
      "id": 8,
      "start": 3934.0,
      "end": 3936.0,
      "formatted_start": "01:05:34.000",
      "formatted_end": "01:05:36.000",
      "text": "ما قبل یارون می دیم"
    },
    {
      "id": 9,
      "start": 3936.0,
      "end": 3938.0,
      "formatted_start": "01:05:36.000",
      "formatted_end": "01:05:38.000",
      "text": "خب بیاییم وزن تو ببینم"
    },
    {
      "id": 10,
      "start": 3938.0,
      "end": 3940.0,
      "formatted_start": "01:05:38.000",
      "formatted_end": "01:05:40.000",
      "text": "تبشه شده بیا بیا"
    },
    {
      "id": 11,
      "start": 3940.0,
      "end": 3942.0,
      "formatted_start": "01:05:40.000",
      "formatted_end": "01:05:42.000",
      "text": "الان تب مداشت"
    },
    {
      "id": 12,
      "start": 3942.0,
      "end": 3944.0,
      "formatted_start": "01:05:42.000",
      "formatted_end": "01:05:44.000",
      "text": "جوزه نباته شد"
    },
    {
      "id": 13,
      "start": 3944.0,
      "end": 3946.0,
      "formatted_start": "01:05:44.000",
      "formatted_end": "01:05:46.000",
      "text": "دوباره"
    },
    {
      "id": 14,
      "start": 3946.0,
      "end": 3948.0,
      "formatted_start": "01:05:46.000",
      "formatted_end": "01:05:48.000",
      "text": "جانا"
    },
    {
      "id": 15,
      "start": 3948.0,
      "end": 3950.0,
      "formatted_start": "01:05:48.000",
      "formatted_end": "01:05:50.000",
      "text": "سیزده"
    },
    {
      "id": 16,
      "start": 3950.0,
      "end": 3952.0,
      "formatted_start": "01:05:50.000",
      "formatted_end": "01:05:52.000",
      "text": "خب بیاییم اینجا بشیم"
    },
    {
      "id": 17,
      "start": 3952.0,
      "end": 3954.0,
      "formatted_start": "01:05:52.000",
      "formatted_end": "01:05:54.000",
      "text": "باید اینجا بشیم"
    },
    {
      "id": 18,
      "start": 3961.0,
      "end": 3963.0,
      "formatted_start": "01:06:01.000",
      "formatted_end": "01:06:03.000",
      "text": "بدلان تب اونجا بهش تبردادی؟"
    },
    {
      "id": 19,
      "start": 3963.0,
      "end": 3965.0,
      "formatted_start": "01:06:03.000",
      "formatted_end": "01:06:05.000",
      "text": "امن بگو امن"
    },
    {
      "id": 20,
      "start": 3965.0,
      "end": 3967.0,
      "formatted_start": "01:06:05.000",
      "formatted_end": "01:06:07.000",
      "text": "این شب ساعتی را زمینه دادیم"
    },
    {
      "id": 21,
      "start": 3967.0,
      "end": 3969.0,
      "formatted_start": "01:06:07.000",
      "formatted_end": "01:06:09.000",
      "text": "این شب را من اصلا نمی کنم"
    },
    {
      "id": 22,
      "start": 3969.0,
      "end": 3971.0,
      "formatted_start": "01:06:09.000",
      "formatted_end": "01:06:11.000",
      "text": "این باشتون که تو نیست"
    },
    {
      "id": 23,
      "start": 3971.0,
      "end": 3974.0,
      "formatted_start": "01:06:11.000",
      "formatted_end": "01:06:14.000",
      "text": "دلتو ببینم دلت هم درد می کنه"
    },
    {
      "id": 24,
      "start": 3974.0,
      "end": 3975.0,
      "formatted_start": "01:06:14.000",
      "formatted_end": "01:06:15.000",
      "text": "چه آنزه ایه؟"
    },
    {
      "id": 25,
      "start": 3975.0,
      "end": 3976.0,
      "formatted_start": "01:06:15.000",
      "formatted_end": "01:06:16.000",
      "text": "در دوره نه"
    },
    {
      "id": 26,
      "start": 3976.0,
      "end": 3977.0,
      "formatted_start": "01:06:16.000",
      "formatted_end": "01:06:17.000",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 3977.0,
      "end": 3979.0,
      "formatted_start": "01:06:17.000",
      "formatted_end": "01:06:19.000",
      "text": "چند روزه اصواله؟"
    },
    {
      "id": 28,
      "start": 3979.0,
      "end": 3980.0,
      "formatted_start": "01:06:19.000",
      "formatted_end": "01:06:20.000",
      "text": "سه"
    },
    {
      "id": 29,
      "start": 3980.0,
      "end": 3982.0,
      "formatted_start": "01:06:20.000",
      "formatted_end": "01:06:22.000",
      "text": "نیروز چند بار بودید؟"
    },
    {
      "id": 30,
      "start": 3982.0,
      "end": 3984.0,
      "formatted_start": "01:06:22.000",
      "formatted_end": "01:06:24.000",
      "text": "سه، سه، چهار باریم"
    },
    {
      "id": 31,
      "start": 3984.0,
      "end": 3986.0,
      "formatted_start": "01:06:24.000",
      "formatted_end": "01:06:26.000",
      "text": "آورکی خیلی؟"
    },
    {
      "id": 32,
      "start": 3986.0,
      "end": 3988.0,
      "formatted_start": "01:06:26.000",
      "formatted_end": "01:06:28.000",
      "text": "نه، خیلی هم آورکی نیست"
    },
    {
      "id": 33,
      "start": 3988.0,
      "end": 3990.0,
      "formatted_start": "01:06:28.000",
      "formatted_end": "01:06:30.000",
      "text": "طبش رو مطمئنی؟"
    },
    {
      "id": 34,
      "start": 3990.0,
      "end": 3992.0,
      "formatted_start": "01:06:30.000",
      "formatted_end": "01:06:32.000",
      "text": "طبه خیلی داقه داره"
    },
    {
      "id": 35,
      "start": 3992.0,
      "end": 3994.0,
      "formatted_start": "01:06:32.000",
      "formatted_end": "01:06:34.000",
      "text": "و از اینجور نیست که عرق سرکنه"
    },
    {
      "id": 36,
      "start": 3994.0,
      "end": 3996.0,
      "formatted_start": "01:06:34.000",
      "formatted_end": "01:06:36.000",
      "text": "پنجم بدنش داقه داقه"
    },
    {
      "id": 37,
      "start": 3996.0,
      "end": 3998.0,
      "formatted_start": "01:06:36.000",
      "formatted_end": "01:06:38.000",
      "text": "شکمش بیشتر از خود"
    },
    {
      "id": 38,
      "start": 3998.0,
      "end": 4000.0,
      "formatted_start": "01:06:38.000",
      "formatted_end": "01:06:40.000",
      "text": "خطرنه که شده، آره؟"
    },
    {
      "id": 39,
      "start": 4000.0,
      "end": 4002.0,
      "formatted_start": "01:06:40.000",
      "formatted_end": "01:06:42.000",
      "text": "ببین، الان شما یه این آزمایش مطبوع"
    },
    {
      "id": 40,
      "start": 4002.0,
      "end": 4004.0,
      "formatted_start": "01:06:42.000",
      "formatted_end": "01:06:44.000",
      "text": "به نظر من براش بد بدید"
    },
    {
      "id": 41,
      "start": 4004.0,
      "end": 4006.0,
      "formatted_start": "01:06:44.000",
      "formatted_end": "01:06:46.000",
      "text": "چون که"
    },
    {
      "id": 42,
      "start": 4006.0,
      "end": 4008.0,
      "formatted_start": "01:06:46.000",
      "formatted_end": "01:06:48.000",
      "text": "توی ایگلسن خیلی اسمانید"
    },
    {
      "id": 43,
      "start": 4008.0,
      "end": 4010.0,
      "formatted_start": "01:06:48.000",
      "formatted_end": "01:06:50.000",
      "text": "با حال درسته باشه، اینجا باید برداشت"
    },
    {
      "id": 44,
      "start": 4010.0,
      "end": 4012.0,
      "formatted_start": "01:06:50.000",
      "formatted_end": "01:06:52.000",
      "text": "اما مستقرات ها یه هفته است که هم هستیم"
    },
    {
      "id": 45,
      "start": 4012.0,
      "end": 4014.0,
      "formatted_start": "01:06:52.000",
      "formatted_end": "01:06:54.000",
      "text": "آهان"
    },
    {
      "id": 46,
      "start": 4014.0,
      "end": 4016.0,
      "formatted_start": "01:06:54.000",
      "formatted_end": "01:06:56.000",
      "text": "شروط نمیخوره، سرام بشه بدم؟"
    },
    {
      "id": 47,
      "start": 4016.0,
      "end": 4018.0,
      "formatted_start": "01:06:56.000",
      "formatted_end": "01:06:58.000",
      "text": "آره"
    },
    {
      "id": 48,
      "start": 4018.0,
      "end": 4020.0,
      "formatted_start": "01:06:58.000",
      "formatted_end": "01:07:00.000",
      "text": "ولی خب، دوتا پودره"
    },
    {
      "id": 49,
      "start": 4020.0,
      "end": 4022.0,
      "formatted_start": "01:07:00.000",
      "formatted_end": "01:07:02.000",
      "text": "با یه دونه شروط"
    },
    {
      "id": 50,
      "start": 4022.0,
      "end": 4024.0,
      "formatted_start": "01:07:02.000",
      "formatted_end": "01:07:04.000",
      "text": "یه دونه شروط رو باید بخوره"
    },
    {
      "id": 51,
      "start": 4024.0,
      "end": 4026.0,
      "formatted_start": "01:07:04.000",
      "formatted_end": "01:07:06.000",
      "text": "آره شروط هیچ میگیه"
    },
    {
      "id": 52,
      "start": 4026.0,
      "end": 4028.0,
      "formatted_start": "01:07:06.000",
      "formatted_end": "01:07:08.000",
      "text": "حالا به جای شروط"
    },
    {
      "id": 53,
      "start": 4028.0,
      "end": 4030.0,
      "formatted_start": "01:07:08.000",
      "formatted_end": "01:07:10.000",
      "text": "میتونم پودر بدم، ولی اون یه دونه شروط"
    },
    {
      "id": 54,
      "start": 4030.0,
      "end": 4032.0,
      "formatted_start": "01:07:10.000",
      "formatted_end": "01:07:12.000",
      "text": "دیگه پودر نداره"
    },
    {
      "id": 55,
      "start": 4032.0,
      "end": 4034.0,
      "formatted_start": "01:07:12.000",
      "formatted_end": "01:07:14.000",
      "text": "اون یه دونه شروط رو باید تا پنج روز بخوره"
    },
    {
      "id": 56,
      "start": 4034.0,
      "end": 4037.0,
      "formatted_start": "01:07:14.000",
      "formatted_end": "01:07:17.000",
      "text": "باید باید بخوره و پودره رو تو ما حل کن بشه"
    },
    {
      "id": 57,
      "start": 4041.0,
      "end": 4043.0,
      "formatted_start": "01:07:21.000",
      "formatted_end": "01:07:23.000",
      "text": "بعد این قدرابازی میشه چجوری خونده کنه؟"
    },
    {
      "id": 58,
      "start": 4044.0,
      "end": 4048.0,
      "formatted_start": "01:07:24.000",
      "formatted_end": "01:07:28.000",
      "text": "اشناش خوبه ها، افراد که با اینکه اصلاه بره اشناش خوبه ها"
    },
    {
      "id": 59,
      "start": 4048.0,
      "end": 4049.0,
      "formatted_start": "01:07:28.000",
      "formatted_end": "01:07:29.000",
      "text": "استفراغ شدی؟"
    },
    {
      "id": 60,
      "start": 4049.0,
      "end": 4050.0,
      "formatted_start": "01:07:29.000",
      "formatted_end": "01:07:30.000",
      "text": "نه نه، دارم"
    },
    {
      "id": 61,
      "start": 4052.0,
      "end": 4055.0,
      "formatted_start": "01:07:32.000",
      "formatted_end": "01:07:35.000",
      "text": "اونو بعد از باباش بگو برن، بعد بشه خود برن"
    },
    {
      "id": 62,
      "start": 4055.0,
      "end": 4080.0,
      "formatted_start": "01:07:35.000",
      "formatted_end": "01:08:00.000",
      "text": "این مدفوعه صرف در اینکه درداره، شما باید بهش از آمایی مثل رومان زیتون و انجیل و آر بخورا بیشتر دارید."
    },
    {
      "id": 63,
      "start": 4080.0,
      "end": 4092.0,
      "formatted_start": "01:08:00.000",
      "formatted_end": "01:08:12.000",
      "text": "ولی مثلا هرکوله و آدامس، موز، تخمه، کلم، چیزای بادار کم ترهای بخوره"
    },
    {
      "id": 64,
      "start": 4092.0,
      "end": 4095.0,
      "formatted_start": "01:08:12.000",
      "formatted_end": "01:08:15.000",
      "text": "هرکوله که بادر نمیخوره ولی نشابه این هم تصدیق داره"
    },
    {
      "id": 65,
      "start": 4095.0,
      "end": 4100.0,
      "formatted_start": "01:08:15.000",
      "formatted_end": "01:08:20.000",
      "text": "آره نشابه، آدامس آق میبره، اینا به دللر راست تصدیق دارن"
    },
    {
      "id": 66,
      "start": 4110.0,
      "end": 4116.0,
      "formatted_start": "01:08:30.000",
      "formatted_end": "01:08:36.000",
      "text": "از کچکتر که بود من اینجا چطور کلی دارم و از این میتامیدیش پایین بود اونها"
    },
    {
      "id": 67,
      "start": 4116.0,
      "end": 4121.0,
      "formatted_start": "01:08:36.000",
      "formatted_end": "01:08:41.000",
      "text": "میتامیدی تو همه بچه های ما پایین چون به واسه های خوشیده میگوشن"
    },
    {
      "id": 68,
      "start": 4121.0,
      "end": 4127.0,
      "formatted_start": "01:08:41.000",
      "formatted_end": "01:08:47.000",
      "text": "افتاد زیاد نمیدیرن، جنگردری ها نداریم، تو اکثر بچه ها پایین هستن"
    },
    {
      "id": 69,
      "start": 4127.0,
      "end": 4133.0,
      "formatted_start": "01:08:47.000",
      "formatted_end": "01:08:53.000",
      "text": "اگر زیر دهت باشه مهمه، الان دهتا سیر خیلی زیاد برگیست"
    },
    {
      "id": 70,
      "start": 4133.0,
      "end": 4136.0,
      "formatted_start": "01:08:53.000",
      "formatted_end": "01:08:56.000",
      "text": "در حال یک دهت بود یکی شده بود چند های در میدونیم؟"
    },
    {
      "id": 71,
      "start": 4136.0,
      "end": 4140.0,
      "formatted_start": "01:08:56.000",
      "formatted_end": "01:09:00.000",
      "text": "نه یا خیلی نیست. کچک هم بود یه منصابش خوبه."
    },
    {
      "id": 72,
      "start": 4140.0,
      "end": 4143.0,
      "formatted_start": "01:09:00.000",
      "formatted_end": "01:09:03.000",
      "text": "اون موقعی که باید کنتی ریزمان میشه ما نقدر میدونیم."
    },
    {
      "id": 73,
      "start": 4143.0,
      "end": 4151.0,
      "formatted_start": "01:09:03.000",
      "formatted_end": "01:09:11.000",
      "text": "ولی اونقدر اگر زیر دخل نبوده خیلی نگرام کننده نیست که من بخوام بهش چیز بدم."
    },
    {
      "id": 74,
      "start": 4151.0,
      "end": 4155.0,
      "formatted_start": "01:09:11.000",
      "formatted_end": "01:09:15.000",
      "text": "آزمایش برم بیدم. من دید خودت بخوام."
    },
    {
      "id": 75,
      "start": 4157.0,
      "end": 4160.0,
      "formatted_start": "01:09:17.000",
      "formatted_end": "01:09:20.000",
      "text": "به آزمایش منتقل شد. کبز ختم شده بیده."
    },
    {
      "id": 76,
      "start": 4160.0,
      "end": 4161.0,
      "formatted_start": "01:09:20.000",
      "formatted_end": "01:09:21.000",
      "text": "آره."
    },
    {
      "id": 77,
      "start": 4161.0,
      "end": 4163.0,
      "formatted_start": "01:09:21.000",
      "formatted_end": "01:09:23.000",
      "text": "ندارش که مشکل نداره."
    },
    {
      "id": 78,
      "start": 4163.0,
      "end": 4166.0,
      "formatted_start": "01:09:23.000",
      "formatted_end": "01:09:26.000",
      "text": "از این واسه باید چار دو پکنم، بعدش کم آب رنگش"
    },
    {
      "id": 79,
      "start": 4166.0,
      "end": 4167.0,
      "formatted_start": "01:09:26.000",
      "formatted_end": "01:09:27.000",
      "text": "برنگش"
    },
    {
      "id": 80,
      "start": 4167.0,
      "end": 4168.0,
      "formatted_start": "01:09:27.000",
      "formatted_end": "01:09:28.000",
      "text": "برنگش"
    },
    {
      "id": 81,
      "start": 4168.0,
      "end": 4171.0,
      "formatted_start": "01:09:28.000",
      "formatted_end": "01:09:31.000",
      "text": "خب، سر و مایه آن پولی شهر و دو سا پودر"
    },
    {
      "id": 82,
      "start": 4171.0,
      "end": 4174.0,
      "formatted_start": "01:09:31.000",
      "formatted_end": "01:09:34.000",
      "text": "این از این و سندش باید"
    },
    {
      "id": 83,
      "start": 4174.0,
      "end": 4175.0,
      "formatted_start": "01:09:34.000",
      "formatted_end": "01:09:35.000",
      "text": "سه و نیم ساله شهر"
    },
    {
      "id": 84,
      "start": 4175.0,
      "end": 4178.0,
      "formatted_start": "01:09:35.000",
      "formatted_end": "01:09:38.000",
      "text": "سه و نیم ساله باید چار نیم باشه، یک و نیم بیر کمه"
    },
    {
      "id": 85,
      "start": 4178.0,
      "end": 4181.0,
      "formatted_start": "01:09:38.000",
      "formatted_end": "01:09:41.000",
      "text": "و اغادش هم باید نوید و هفت هشت باشه"
    },
    {
      "id": 86,
      "start": 4186.0,
      "end": 4189.0,
      "formatted_start": "01:09:46.000",
      "formatted_end": "01:09:49.000",
      "text": "کریمی من دو و نیم باید برم"
    },
    {
      "id": 87,
      "start": 4193.0,
      "end": 4200.0,
      "formatted_start": "01:09:53.000",
      "formatted_end": "01:10:00.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    }
  ],
  "status": "completed"
}