      "start": 3808.0,
      "end": 3810.0,
      "formatted_start": "01:03:28.000",
      "formatted_end": "01:03:30.000",
      "text": "این موبسته ها موبسته ها"
    },
    {
      "id": 51,
      "start": 3810.0,
      "end": 3812.0,
      "formatted_start": "01:03:30.000",
      "formatted_end": "01:03:32.000",
      "text": "این هریکی نمیزنه"
    },
    {
      "id": 52,
      "start": 3812.0,
      "end": 3814.0,
      "formatted_start": "01:03:32.000",
      "formatted_end": "01:03:34.000",
      "text": "من حرفیش کنم که من باید بخش این میزنه"
    },
