      "id": 39,
      "start": 3786.0,
      "end": 3788.0,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:08.000",
      "text": "مثلا بزنم توی گریشو همه رو بزنم"
    },
    {
