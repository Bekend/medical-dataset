  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3630.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:30.000",
      "text": "بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3632.0,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:32.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 3660.0,
      "end": 3690.0,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که ا"
    },
    {
      "id": 3,
      "start": 3690.0,
      "end": 3696.0,
      "formatted_start": "01:01:30.000",
      "formatted_end": "01:01:36.000",
      "text": "اگه باید بیام دکتور جبهرزاده من اونسایی کادو یک سه تکترسیش گرفتین براتون بیان بگیرید"
    },
    {
      "id": 4,
      "start": 3696.0,
      "end": 3698.0,
      "formatted_start": "01:01:36.000",
      "formatted_end": "01:01:38.000",
      "text": "ندارم اینچه"
    },
    {
      "id": 5,
      "start": 3700.0,
      "end": 3702.0,
      "formatted_start": "01:01:40.000",
      "formatted_end": "01:01:42.000",
      "text": "برم بگیرم"
    },
    {
      "id": 6,
      "start": 3703.0,
      "end": 3706.0,
      "formatted_start": "01:01:43.000",
      "formatted_end": "01:01:46.000",
      "text": "اگه میبانم کادو هم بگیرم میاد باش"
    },
    {
      "id": 7,
      "start": 3706.0,
      "end": 3707.0,
      "formatted_start": "01:01:46.000",
      "formatted_end": "01:01:47.000",
      "text": "باشه"
    },
    {
      "id": 8,
      "start": 3707.0,
      "end": 3711.0,
      "formatted_start": "01:01:47.000",
      "formatted_end": "01:01:51.000",
      "text": "تا کادو گم نشده و هپولی نشده سار پیدا نکرده"
    },
    {
      "id": 9,
      "start": 3712.0,
      "end": 3713.0,
      "formatted_start": "01:01:52.000",
      "formatted_end": "01:01:53.000",
      "text": "مرسی باشه"
    },
    {
      "id": 10,
      "start": 3713.0,
      "end": 3718.0,
      "formatted_start": "01:01:53.000",
      "formatted_end": "01:01:58.000",
      "text": "کاربون هست مرسی خواهش میکنم من همینجور خواهش میکنم تا دو"
    },
    {
      "id": 11,
      "start": 3718.0,
      "end": 3721.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:01.000",
      "text": "از درسته دختران رو بخورن و ادامه شوند"
    },
    {
      "id": 12,
      "start": 3721.0,
      "end": 3724.0,
      "formatted_start": "01:02:01.000",
      "formatted_end": "01:02:04.000",
      "text": "افریدانشون پزیشگیرون میخواند ادامه شوند"
    },
    {
      "id": 13,
      "start": 3724.0,
      "end": 3727.0,
      "formatted_start": "01:02:04.000",
      "formatted_end": "01:02:07.000",
      "text": "در اینجا باشه فیلم گرفتنه"
    },
    {
      "id": 14,
      "start": 3727.0,
      "end": 3730.0,
      "formatted_start": "01:02:07.000",
      "formatted_end": "01:02:10.000",
      "text": "بای جونی جنگون توی این بردر بکنه"
    },
    {
      "id": 15,
      "start": 3730.0,
      "end": 3732.0,
      "formatted_start": "01:02:10.000",
      "formatted_end": "01:02:12.000",
      "text": "چقدر بیردشت"
    },
    {
      "id": 16,
      "start": 3732.0,
      "end": 3734.0,
      "formatted_start": "01:02:12.000",
      "formatted_end": "01:02:14.000",
      "text": "از درسته که بیدم اصلا مو بزنم"
    },
    {
      "id": 17,
      "start": 3734.0,
      "end": 3736.0,
      "formatted_start": "01:02:14.000",
      "formatted_end": "01:02:16.000",
      "text": "ادام کردم و بزنم بزنم"
    },
    {
      "id": 18,
      "start": 3736.0,
      "end": 3738.0,
      "formatted_start": "01:02:16.000",
      "formatted_end": "01:02:18.000",
      "text": "نیدم"
    },
    {
      "id": 19,
      "start": 3738.0,
      "end": 3740.0,
      "formatted_start": "01:02:18.000",
      "formatted_end": "01:02:20.000",
      "text": "خواهد صورتش بگو دیده"
    },
    {
      "id": 20,
      "start": 3740.0,
      "end": 3742.0,
      "formatted_start": "01:02:20.000",
      "formatted_end": "01:02:22.000",
      "text": "اینجا این صورتش نیست"
    },
    {
      "id": 21,
      "start": 3742.0,
      "end": 3746.0,
      "formatted_start": "01:02:22.000",
      "formatted_end": "01:02:26.000",
      "text": "الان اینکه این اجهی زر زر روشد"
    },
    {
      "id": 22,
      "start": 3746.0,
      "end": 3750.5,
      "formatted_start": "01:02:26.000",
      "formatted_end": "01:02:30.500",
      "text": "بزار بزار، این کسی آموند ورشکه است که میشه این کمریکا بزنه باشه"
    },
    {
      "id": 23,
      "start": 3750.5,
      "end": 3752.0,
      "formatted_start": "01:02:30.500",
      "formatted_end": "01:02:32.000",
      "text": "کمریکا برادم؟ آره"
    },
    {
      "id": 24,
      "start": 3752.0,
      "end": 3754.0,
      "formatted_start": "01:02:32.000",
      "formatted_end": "01:02:34.000",
      "text": "کشنگه های مردم رو کشتنزش کردن؟"
    },
    {
      "id": 25,
      "start": 3754.0,
      "end": 3757.0,
      "formatted_start": "01:02:34.000",
      "formatted_end": "01:02:37.000",
      "text": "نه، مشکلی نیست، یه چاره نیست، مباشه نامیشید"
    },
    {
      "id": 26,
      "start": 3757.0,
      "end": 3758.0,
      "formatted_start": "01:02:37.000",
      "formatted_end": "01:02:38.000",
      "text": "بزار بزار بیدشا بیرون"
    },
    {
      "id": 27,
      "start": 3758.0,
      "end": 3764.0,
      "formatted_start": "01:02:38.000",
      "formatted_end": "01:02:44.000",
      "text": "بزار اینا رو رقص به اون بد وقتیش دل ما رو خنک می کنند برسند"
    },
    {
      "id": 28,
      "start": 3764.0,
      "end": 3766.0,
      "formatted_start": "01:02:44.000",
      "formatted_end": "01:02:46.000",
      "text": "آره، باید دو همه رو هیچ از اونها رو خنک برون"
    },
    {
      "id": 29,
      "start": 3766.0,
      "end": 3768.0,
      "formatted_start": "01:02:46.000",
      "formatted_end": "01:02:48.000",
      "text": "اینها رو ببینی چی جوری نست"
    },
    {
      "id": 30,
      "start": 3768.0,
      "end": 3770.0,
      "formatted_start": "01:02:48.000",
      "formatted_end": "01:02:50.000",
      "text": "این رو زدن کردن"
    },
    {
      "id": 31,
      "start": 3770.0,
      "end": 3772.0,
      "formatted_start": "01:02:50.000",
      "formatted_end": "01:02:52.000",
      "text": "خوهرم این هست"
    },
    {
      "id": 32,
      "start": 3772.0,
      "end": 3774.0,
      "formatted_start": "01:02:52.000",
      "formatted_end": "01:02:54.000",
      "text": "ده نفر که بی سی ادامه است"
    },
    {
      "id": 33,
      "start": 3774.0,
      "end": 3776.0,
      "formatted_start": "01:02:54.000",
      "formatted_end": "01:02:56.000",
      "text": "خوهرش کفتی که چشم رو نزده دید"
    },
    {
      "id": 34,
      "start": 3776.0,
      "end": 3778.0,
      "formatted_start": "01:02:56.000",
      "formatted_end": "01:02:58.000",
      "text": "که نبینم خوهرم"
    },
    {
      "id": 35,
      "start": 3778.0,
      "end": 3780.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:00.000",
      "text": "که ادامه شد"
    },
    {
      "id": 36,
      "start": 3780.0,
      "end": 3782.0,
      "formatted_start": "01:03:00.000",
      "formatted_end": "01:03:02.000",
      "text": "چشم رو ببینید که نبینم اون طرف"
    },
    {
      "id": 37,
      "start": 3782.0,
      "end": 3784.0,
      "formatted_start": "01:03:02.000",
      "formatted_end": "01:03:04.000",
      "text": "که ادامه شد"
    },
    {
      "id": 38,
      "start": 3784.0,
      "end": 3786.0,
      "formatted_start": "01:03:04.000",
      "formatted_end": "01:03:06.000",
      "text": "این چیزهایی خدا یاد داره"
    },
