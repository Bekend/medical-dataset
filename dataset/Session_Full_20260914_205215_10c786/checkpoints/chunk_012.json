      "start": 3796.0,
      "end": 3798.0,
      "formatted_start": "01:03:16.000",
      "formatted_end": "01:03:18.000",
      "text": "این چیه؟"
    },
    {
      "id": 45,
      "start": 3798.0,
      "end": 3800.0,
      "formatted_start": "01:03:18.000",
      "formatted_end": "01:03:20.000",
      "text": "این آقایی کنه کنه کشت"
    },
