  "stt_segments": [
    {
      "id": 0,
      "start": 24000.0,
      "end": 24029.98,
      "formatted_start": "06:40:00.000",
      "formatted_end": "06:40:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 24030.0,
      "end": 24035.24,
      "formatted_start": "06:40:30.000",
      "formatted_end": "06:40:35.240",
      "text": "اما وقتی این رو بینم تا قبل یکنش هیچ کار نمی کنن. من یکی توش کل باشم. این یاد باشم."
    },
    {
      "id": 2,
      "start": 24035.24,
      "end": 24039.7,
      "formatted_start": "06:40:35.240",
      "formatted_end": "06:40:39.700",
      "text": "آسمانی توی این رو بینم. این چند نامیده موشیه. بیزی طوبه."
    },
    {
      "id": 3,
      "start": 24039.7,
      "end": 24041.7,
      "formatted_start": "06:40:39.700",
      "formatted_end": "06:40:41.700",
      "text": "بدون من یکی مریضی هست."
    },
    {
      "id": 4,
      "start": 24041.7,
      "end": 24044.7,
      "formatted_start": "06:40:41.700",
      "formatted_end": "06:40:44.700",
      "text": "چون خب یکی بود. این مانند که..."
    },
    {
      "id": 5,
      "start": 24044.7,
      "end": 24045.7,
      "formatted_start": "06:40:44.700",
      "formatted_end": "06:40:45.700",
      "text": "بسیار مردی نمیشه."
    },
    {
      "id": 6,
      "start": 24045.7,
      "end": 24049.7,
      "formatted_start": "06:40:45.700",
      "formatted_end": "06:40:49.700",
      "text": "بشین یکی نمیشه. من رو به مخه من اینجا بشینم. برای اون نمی بفرکت بگم."
    },
    {
      "id": 7,
      "start": 24049.7,
      "end": 24050.7,
      "formatted_start": "06:40:49.700",
      "formatted_end": "06:40:50.700",
      "text": "من رو برکرد بیدم."
    },
    {
      "id": 8,
      "start": 24050.7,
      "end": 24080.7,
      "formatted_start": "06:40:50.700",
      "formatted_end": "06:41:20.700",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 9,
      "start": 24080.7,
      "end": 24082.7,
      "formatted_start": "06:41:20.700",
      "formatted_end": "06:41:22.700",
      "text": "مرزا رو اتنام کنید خوبی چنده اجازه هست"
    },
    {
      "id": 10,
      "start": 24082.7,
      "end": 24085.7,
      "formatted_start": "06:41:22.700",
      "formatted_end": "06:41:25.700",
      "text": "یالله خدا بابت وقتتون بخیر باشه"
    },
    {
      "id": 11,
      "start": 24085.7,
      "end": 24089.7,
      "formatted_start": "06:41:25.700",
      "formatted_end": "06:41:29.700",
      "text": "خیلی ممنونم هم دیگه تو زیاد پرحرکتی نمی کنم"
    },
    {
      "id": 12,
      "start": 24089.7,
      "end": 24091.7,
      "formatted_start": "06:41:29.700",
      "formatted_end": "06:41:31.700",
      "text": "می دانم که مرسولات من برای تو آشنا هست"
    },
    {
      "id": 13,
      "start": 24091.7,
      "end": 24093.7,
      "formatted_start": "06:41:31.700",
      "formatted_end": "06:41:33.700",
      "text": "تا حدودی"
    },
    {
      "id": 14,
      "start": 24093.7,
      "end": 24094.7,
      "formatted_start": "06:41:33.700",
      "formatted_end": "06:41:34.700",
      "text": "البته"
    },
    {
      "id": 15,
      "start": 24094.7,
      "end": 24100.7,
      "formatted_start": "06:41:34.700",
      "formatted_end": "06:41:40.700",
      "text": "کاشه اصمراز ما قطعه کاریپول و شربت های ما"
    },
    {
      "id": 16,
      "start": 24100.7,
      "end": 24103.7,
      "formatted_start": "06:41:40.700",
      "formatted_end": "06:41:43.700",
      "text": "هم دیگه تو شربت پریکان ما"
    },
    {
      "id": 17,
      "start": 24103.7,
      "end": 24104.7,
      "formatted_start": "06:41:43.700",
      "formatted_end": "06:41:44.700",
      "text": "بالاخره لانچ شد"
    },
    {
      "id": 18,
      "start": 24104.7,
      "end": 24107.7,
      "formatted_start": "06:41:44.700",
      "formatted_end": "06:41:47.700",
      "text": "همینطور مردت را با خیلی ممنونم"
    },
    {
      "id": 19,
      "start": 24107.7,
      "end": 24109.7,
      "formatted_start": "06:41:47.700",
      "formatted_end": "06:41:49.700",
      "text": "بله تعداد کم موجود کرده"
    },
    {
      "id": 20,
      "start": 24109.7,
      "end": 24116.7,
      "formatted_start": "06:41:49.700",
      "formatted_end": "06:41:56.700",
      "text": "من کاندیکتور سامنا خدمتون بدم قدرین کالیفور ما و خیلی ممنونم آزادتون"
    },
    {
      "id": 21,
      "start": 24116.7,
      "end": 24124.7,
      "formatted_start": "06:41:56.700",
      "formatted_end": "06:42:04.700",
      "text": "کاندیکتور شربت یک کلو بیرازه من فکر میکنم دیگه مقبول شبه مدرس یا اینقدر شربت هاستی کلابیر ماه"
    },
    {
      "id": 22,
      "start": 24124.7,
      "end": 24131.7,
      "formatted_start": "06:42:04.700",
      "formatted_end": "06:42:11.700",
      "text": "یا اینقدر قص آبای مرگون شدت بیدا کنه و این کاندیکتور یه هدیه ای هم از طرف شرکت هست"
    },
    {
      "id": 23,
      "start": 24131.7,
      "end": 24135.7,
      "formatted_start": "06:42:11.700",
      "formatted_end": "06:42:15.700",
      "text": "هستش کاملویتو خواهدید که انتخاب با خودتون هر کدوم که"
    },
    {
      "id": 24,
      "start": 24135.7,
      "end": 24139.7,
      "formatted_start": "06:42:15.700",
      "formatted_end": "06:42:19.700",
      "text": "کاملویتو بد به نظرتون هست"
    },
    {
      "id": 25,
      "start": 24139.7,
      "end": 24141.7,
      "formatted_start": "06:42:19.700",
      "formatted_end": "06:42:21.700",
      "text": "هم با دست هستم"
    },
    {
      "id": 26,
      "start": 24141.7,
      "end": 24143.7,
      "formatted_start": "06:42:21.700",
      "formatted_end": "06:42:23.700",
      "text": "شکر کاملویتو"
    },
    {
      "id": 27,
      "start": 24143.7,
      "end": 24145.7,
      "formatted_start": "06:42:23.700",
      "formatted_end": "06:42:25.700",
      "text": "هر سطح هم کیفه"
    },
    {
      "id": 28,
      "start": 24145.7,
      "end": 24149.7,
      "formatted_start": "06:42:25.700",
      "formatted_end": "06:42:29.700",
      "text": "بله بسیار عمالی من کاملویتو پیدم بدم خودتون"
    },
    {
      "id": 29,
      "start": 24149.7,
      "end": 24153.7,
      "formatted_start": "06:42:29.700",
      "formatted_end": "06:42:33.700",
      "text": "و اگه بیادم نمیشه یه عکس یادگاری برنده باشیم"
    },
    {
      "id": 30,
      "start": 24153.7,
      "end": 24155.7,
      "formatted_start": "06:42:33.700",
      "formatted_end": "06:42:35.700",
      "text": "بله ممنونم ازتونم"
    },
    {
      "id": 31,
      "start": 24155.7,
      "end": 24163.7,
      "formatted_start": "06:42:35.700",
      "formatted_end": "06:42:43.700",
      "text": "مبارکی تو ماشخان دید و انشاله که همیشه تن تون ساره"
    },
    {
      "id": 32,
      "start": 24163.7,
      "end": 24165.7,
      "formatted_start": "06:42:43.700",
      "formatted_end": "06:42:45.700",
      "text": "خوشکرم کنم از شما"
    },
    {
      "id": 33,
      "start": 24165.7,
      "end": 24171.7,
      "formatted_start": "06:42:45.700",
      "formatted_end": "06:42:51.700",
      "text": "خوشکرم کنم مرسی از شما انشاله که همیشه محصولات منم امتحانیت شما باشه"
    },
    {
      "id": 34,
      "start": 24171.7,
      "end": 24173.7,
      "formatted_start": "06:42:51.700",
      "formatted_end": "06:42:53.700",
      "text": "شکرم"
    },
    {
      "id": 35,
      "start": 24173.7,
      "end": 24175.7,
      "formatted_start": "06:42:53.700",
      "formatted_end": "06:42:55.700",
      "text": "خاندتا خیلی خوب شما"
    },
    {
      "id": 36,
      "start": 24175.7,
      "end": 24177.7,
      "formatted_start": "06:42:55.700",
      "formatted_end": "06:42:57.700",
      "text": "مرسی"
    },
    {
      "id": 37,
      "start": 24177.7,
      "end": 24179.7,
      "formatted_start": "06:42:57.700",
      "formatted_end": "06:42:59.700",
      "text": "انشاله خوب سلامتی انشاله که دیدون همیشه پل پول"
    },
    {
      "id": 38,
      "start": 24179.7,
      "end": 24183.7,
      "formatted_start": "06:42:59.700",
      "formatted_end": "06:43:03.700",
      "text": "خانم کریمی"
    },
    {
      "id": 39,
      "start": 24183.7,
      "end": 24185.7,
      "formatted_start": "06:43:03.700",
      "formatted_end": "06:43:05.700",
      "text": "خیلی ممنون مردمی"
    },
    {
      "id": 40,
      "start": 24185.7,
      "end": 24187.7,
      "formatted_start": "06:43:05.700",
      "formatted_end": "06:43:07.700",
      "text": "خیلی ممنون مردمی"
    },
    {
      "id": 41,
      "start": 24187.7,
      "end": 24189.7,
      "formatted_start": "06:43:07.700",
      "formatted_end": "06:43:09.700",
      "text": "خیلی ممنون مردمی"
    },
    {
      "id": 42,
      "start": 24189.7,
      "end": 24191.7,
      "formatted_start": "06:43:09.700",
      "formatted_end": "06:43:11.700",
      "text": "خیلی ممنون مردمی"
    },
    {
      "id": 43,
      "start": 24191.7,
      "end": 24193.7,
      "formatted_start": "06:43:11.700",
      "formatted_end": "06:43:13.700",
      "text": "خیلی ممنون مردمی"
    },
    {
