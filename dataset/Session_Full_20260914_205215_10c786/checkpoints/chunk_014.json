  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4202.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:02.000",
      "text": "اینجوری که باید اصلا موزه جدشه، برای اصلا موزه نیست."
    },
    {
      "id": 1,
      "start": 4202.0,
      "end": 4204.0,
      "formatted_start": "01:10:02.000",
      "formatted_end": "01:10:04.000",
      "text": "آیا درکترون باید بردارید؟"
    },
    {
      "id": 2,
      "start": 4204.0,
      "end": 4210.0,
      "formatted_start": "01:10:04.000",
      "formatted_end": "01:10:10.000",
      "text": "شما سرام آنکه رو میتونید ولی آیمایش روشی شده."
    },
    {
      "id": 3,
      "start": 4210.0,
      "end": 4212.0,
      "formatted_start": "01:10:10.000",
      "formatted_end": "01:10:12.000",
      "text": "مدخولش رو..."
    },
    {
      "id": 4,
      "start": 4217.0,
      "end": 4222.0,
      "formatted_start": "01:10:17.000",
      "formatted_end": "01:10:22.000",
      "text": "بله این خیلی زیاد میخواهده یعنی اینجوری که باید چون همه او سر جده شده ولی اصلا مردم نیست."
    },
    {
      "id": 5,
      "start": 4222.0,
      "end": 4225.0,
      "formatted_start": "01:10:22.000",
      "formatted_end": "01:10:25.000",
      "text": "آهیه دارید بله. مرکز دارد."
    },
    {
      "id": 6,
      "start": 4234.0,
      "end": 4243.38,
      "formatted_start": "01:10:34.000",
      "formatted_end": "01:10:43.380",
      "text": "مدتون شرق نیست"
    },
    {
      "id": 7,
      "start": 4243.38,
      "end": 4248.74,
      "formatted_start": "01:10:43.380",
      "formatted_end": "01:10:48.740",
      "text": "میشودی دستت میماسه چردی؟"
    },
    {
      "id": 8,
      "start": 4248.74,
      "end": 4250.54,
      "formatted_start": "01:10:48.740",
      "formatted_end": "01:10:50.540",
      "text": "نه زیاد نمیشود"
    },
    {
      "id": 9,
      "start": 4250.54,
      "end": 4257.88,
      "formatted_start": "01:10:50.540",
      "formatted_end": "01:10:57.880",
      "text": "این کوده هم آزمایش هم دادی"
    },
    {
      "id": 10,
      "start": 4257.88,
      "end": 4259.92,
      "formatted_start": "01:10:57.880",
      "formatted_end": "01:10:59.920",
      "text": "باباشو بیار ببینیم"
    },
    {
      "id": 11,
      "start": 4259.92,
      "end": 4260.84,
      "formatted_start": "01:10:59.920",
      "formatted_end": "01:11:00.840",
      "text": "مرسی"
    },
    {
      "id": 12,
      "start": 4260.84,
      "end": 4262.84,
      "formatted_start": "01:11:00.840",
      "formatted_end": "01:11:02.840",
      "text": "خواهید"
    },
    {
      "id": 13,
      "start": 4272.84,
      "end": 4274.84,
      "formatted_start": "01:11:12.840",
      "formatted_end": "01:11:14.840",
      "text": "دوانی"
    },
    {
      "id": 14,
      "start": 4274.84,
      "end": 4276.84,
      "formatted_start": "01:11:14.840",
      "formatted_end": "01:11:16.840",
      "text": "آره"
    },
    {
      "id": 15,
      "start": 4276.84,
      "end": 4278.84,
      "formatted_start": "01:11:16.840",
      "formatted_end": "01:11:18.840",
      "text": "یکم برام بیاری"
    },
    {
      "id": 16,
      "start": 4278.84,
      "end": 4280.84,
      "formatted_start": "01:11:18.840",
      "formatted_end": "01:11:20.840",
      "text": "یکم برام بیاری"
    },
    {
      "id": 17,
      "start": 4280.84,
      "end": 4282.84,
      "formatted_start": "01:11:20.840",
      "formatted_end": "01:11:22.840",
      "text": "دوانی"
    },
    {
      "id": 18,
      "start": 4282.84,
      "end": 4284.84,
      "formatted_start": "01:11:22.840",
      "formatted_end": "01:11:24.840",
      "text": "دوانی"
    },
    {
      "id": 19,
      "start": 4284.84,
      "end": 4286.84,
      "formatted_start": "01:11:24.840",
      "formatted_end": "01:11:26.840",
      "text": "دوست کن"
    },
    {
      "id": 20,
      "start": 4286.84,
      "end": 4288.84,
      "formatted_start": "01:11:26.840",
      "formatted_end": "01:11:28.840",
      "text": "من برای تجهیج"
    },
    {
      "id": 21,
      "start": 4288.84,
      "end": 4290.84,
      "formatted_start": "01:11:28.840",
      "formatted_end": "01:11:30.840",
      "text": "حجاب می کنم چرا من که کم بگیم."
    },
    {
      "id": 22,
      "start": 4290.84,
      "end": 4293.84,
      "formatted_start": "01:11:30.840",
      "formatted_end": "01:11:33.840",
      "text": "در این وقت تا یه بزگی بزگی هم بره نایس رو بزنیم."
    },
    {
      "id": 23,
      "start": 4293.84,
      "end": 4295.84,
      "formatted_start": "01:11:33.840",
      "formatted_end": "01:11:35.840",
      "text": "هه؟ آی خدایی روز."
    },
    {
      "id": 24,
      "start": 4295.84,
      "end": 4299.84,
      "formatted_start": "01:11:35.840",
      "formatted_end": "01:11:39.840",
      "text": "کلی دیشتر، مامانم ببین که تو نظر چیه؟"
    },
    {
      "id": 25,
      "start": 4299.84,
      "end": 4301.84,
      "formatted_start": "01:11:39.840",
      "formatted_end": "01:11:41.840",
      "text": "نظر من اینه که از قرار خودش نوشته."
    },
    {
      "id": 26,
      "start": 4301.84,
      "end": 4305.84,
      "formatted_start": "01:11:41.840",
      "formatted_end": "01:11:45.840",
      "text": "اون پدر این خب چندشش میشن از این؟"
    },
    {
      "id": 27,
      "start": 4305.84,
      "end": 4308.84,
      "formatted_start": "01:11:45.840",
      "formatted_end": "01:11:48.840",
      "text": "یه بار نوشته بود که برای من اجازه بده بیاییم خواستگاری،"
    },
    {
      "id": 28,
      "start": 4308.84,
      "end": 4314.84,
      "formatted_start": "01:11:48.840",
      "formatted_end": "01:11:54.840",
      "text": "تو پدرش رو پدرش رو پدرم بفته بود که من سرقبر اینم نمیرم."
    },
    {
      "id": 29,
      "start": 4318.84,
      "end": 4327.84,
      "formatted_start": "01:11:58.840",
      "formatted_end": "01:12:07.840",
      "text": "چرا؟ چون فیلم باره من زندگی اینو به هم زنم و مثلا بگه اون امامانم توی حرفاشون بشین تو حرفاشون گفته بود که"
    },
    {
      "id": 30,
      "start": 4327.84,
      "end": 4335.84,
      "formatted_start": "01:12:07.840",
      "formatted_end": "01:12:15.840",
      "text": "چیست؟ نبه هام نبه هام و این مامانم خندیده بود گفته بود که خودشی که میگه اونا مال من نیست"
    },
    {
      "id": 31,
      "start": 4335.84,
      "end": 4342.84,
      "formatted_start": "01:12:15.840",
      "formatted_end": "01:12:22.840",
      "text": "اونا نمیگه پدر سرخ شده بود گفتید قلت شده عروس من مثل گله"
    },
    {
      "id": 32,
      "start": 4342.84,
      "end": 4346.6,
      "formatted_start": "01:12:22.840",
      "formatted_end": "01:12:26.600",
      "text": "دو باره، مثلا یا من خودم دست شده و دست پسره برای من عکس کرده"
    },
    {
      "id": 33,
      "start": 4346.6,
      "end": 4352.56,
      "formatted_start": "01:12:26.600",
      "formatted_end": "01:12:32.560",
      "text": "ساد عروض صدر که منو با این دوستیم رابطه ای ما هم مثل شما همش دعواز ولی با هم هستیم"
    },
    {
      "id": 34,
      "start": 4352.56,
      "end": 4356.24,
      "formatted_start": "01:12:32.560",
      "formatted_end": "01:12:36.240",
      "text": "در این معلقه شما بود فرمانه هرماز ماشین بود دست آمدشون"
    },
    {
      "id": 35,
      "start": 4356.24,
      "end": 4357.84,
      "formatted_start": "01:12:36.240",
      "formatted_end": "01:12:37.840",
      "text": "بعد؟"
    },
    {
      "id": 36,
      "start": 4358.52,
      "end": 4359.84,
      "formatted_start": "01:12:38.520",
      "formatted_end": "01:12:39.840",
      "text": "چیز؟"
    },
    {
      "id": 37,
      "start": 4365.84,
      "end": 4367.96,
      "formatted_start": "01:12:45.840",
      "formatted_end": "01:12:47.960",
      "text": "بعد؟"
    },
    {
      "id": 38,
      "start": 4367.96,
      "end": 4368.84,
      "formatted_start": "01:12:47.960",
      "formatted_end": "01:12:48.840",
      "text": "پدره به خاطر؟"
    },
    {
      "id": 39,
      "start": 4368.84,
      "end": 4371.84,
      "formatted_start": "01:12:48.840",
      "formatted_end": "01:12:51.840",
      "text": "پدره به خاطر؟"
    },
    {
      "id": 40,
      "start": 4372.84,
      "end": 4377.84,
      "formatted_start": "01:12:52.840",
      "formatted_end": "01:12:57.840",
      "text": "من مامانم رو پشت شدم، بابانم رو رو پردازم، من بابانم رو پشت شدم"
    },
    {
      "id": 41,
      "start": 4377.84,
      "end": 4384.84,
      "formatted_start": "01:12:57.840",
      "formatted_end": "01:13:04.840",
      "text": "یه روز که من چیز کردم، یه روز که من دیدم میشدم در خونه پیشم، بوده که من نبودم"
    },
    {
      "id": 42,
      "start": 4384.84,
      "end": 4389.84,
      "formatted_start": "01:13:04.840",
      "formatted_end": "01:13:09.840",
      "text": "چی میخوای پشت سر من بیاد؟ گفت میخوری من دست و قرآن میتوانم که تو بیدی"
    },
    {
      "id": 43,
      "start": 4389.84,
      "end": 4395.84,
      "formatted_start": "01:13:09.840",
      "formatted_end": "01:13:15.840",
      "text": "یه منتری پردازم بیاد، چی؟ مزاوره، الان دور زمانه ای کسی بیکاره بیاد تا میداشت بریاده"
    },
    {
      "id": 44,
      "start": 4395.84,
      "end": 4399.84,
      "formatted_start": "01:13:15.840",
      "formatted_end": "01:13:19.840",
      "text": "تو گروهارو بخوابه تو ماشینش، چی میخوای کار رو کنه؟"
    },
    {
      "id": 45,
      "start": 4402.84,
      "end": 4406.5,
      "formatted_start": "01:13:22.840",
      "formatted_end": "01:13:26.500",
      "text": "تو شانس ها بگیر شیست سال، تاریبوی من رو بیرسته نمیرده"
    },
    {
      "id": 46,
      "start": 4406.5,
      "end": 4407.84,
      "formatted_start": "01:13:26.500",
      "formatted_end": "01:13:27.840",
      "text": "بعدی چی؟"
    },
    {
      "id": 47,
      "start": 4407.84,
      "end": 4408.84,
      "formatted_start": "01:13:27.840",
      "formatted_end": "01:13:28.840",
      "text": "نه چی؟"
    },
    {
      "id": 48,
      "start": 4408.84,
      "end": 4412.84,
      "formatted_start": "01:13:28.840",
      "formatted_end": "01:13:32.840",
      "text": "پدر من، مامان من، پدر من بند داره بهش"
    },
    {
      "id": 49,
      "start": 4412.84,
      "end": 4415.84,
      "formatted_start": "01:13:32.840",
      "formatted_end": "01:13:35.840",
      "text": "یا آقا شما میگی میندرش نیمندی، دنبال دختری من"
    },
    {
      "id": 50,
      "start": 4415.84,
      "end": 4417.84,
      "formatted_start": "01:13:35.840",
      "formatted_end": "01:13:37.840",
      "text": "الان شرایط جور در سپر کنه بید"
    },
    {
      "id": 51,
      "start": 4417.84,
      "end": 4419.34,
      "formatted_start": "01:13:37.840",
      "formatted_end": "01:13:39.340",
      "text": "پدر من خواست نیمیده"
    },
    {
      "id": 52,
      "start": 4419.34,
      "end": 4420.84,
      "formatted_start": "01:13:39.340",
      "formatted_end": "01:13:40.840",
      "text": "و یک جواب نداره پدر"
    },
    {
      "id": 53,
      "start": 4420.84,
      "end": 4423.84,
      "formatted_start": "01:13:40.840",
      "formatted_end": "01:13:43.840",
      "text": "با اونو منم چند برگواره، میخواست یک اصلا بشون کاره دیگه"
    },
    {
      "id": 54,
      "start": 4423.84,
      "end": 4425.84,
      "formatted_start": "01:13:43.840",
      "formatted_end": "01:13:45.840",
      "text": "و این میدن مایی که میدونم، ماره های چی؟"
    },
    {
      "id": 55,
      "start": 4425.84,
      "end": 4427.84,
      "formatted_start": "01:13:45.840",
      "formatted_end": "01:13:47.840",
      "text": "و ایستمس داده"
    },
    {
      "id": 56,
      "start": 4427.84,
      "end": 4429.84,
      "formatted_start": "01:13:47.840",
      "formatted_end": "01:13:49.840",
      "text": "گفته دیوز میگنه بوده"
    },
    {
      "id": 57,
      "start": 4429.84,
      "end": 4431.84,
      "formatted_start": "01:13:49.840",
      "formatted_end": "01:13:51.840",
      "text": "الان اینجور در خونهشون بوده"
    },
    {
      "id": 58,
      "start": 4431.84,
      "end": 4433.84,
      "formatted_start": "01:13:51.840",
      "formatted_end": "01:13:53.840",
      "text": "تو کوچهشون بوده"
    },
    {
      "id": 59,
      "start": 4433.84,
      "end": 4435.84,
      "formatted_start": "01:13:53.840",
      "formatted_end": "01:13:55.840",
      "text": "سپرم هلهشون بوده"
    },
    {
      "id": 60,
      "start": 4435.84,
      "end": 4437.84,
      "formatted_start": "01:13:55.840",
      "formatted_end": "01:13:57.840",
      "text": "و اتفاقی بوده آقای ناسلی"
    },
    {
      "id": 61,
      "start": 4437.84,
      "end": 4439.84,
      "formatted_start": "01:13:57.840",
      "formatted_end": "01:13:59.840",
      "text": "این رک میشده از اونجا"
    },
    {
      "id": 62,
      "start": 4439.84,
      "end": 4441.84,
      "formatted_start": "01:13:59.840",
      "formatted_end": "01:14:01.840",
      "text": "حالا شما کتاب بیا"
    },
    {
      "id": 63,
      "start": 4441.84,
      "end": 4443.84,
      "formatted_start": "01:14:01.840",
      "formatted_end": "01:14:03.840",
      "text": "به دختر خانم و خانمتون سلام برسون"
    },
    {
      "id": 64,
      "start": 4443.84,
      "end": 4445.84,
      "formatted_start": "01:14:03.840",
      "formatted_end": "01:14:05.840",
      "text": "حسین آقا"
    },
    {
      "id": 65,
      "start": 4445.84,
      "end": 4447.84,
      "formatted_start": "01:14:05.840",
      "formatted_end": "01:14:07.840",
      "text": "همین کما"
    },
    {
      "id": 66,
      "start": 4447.84,
      "end": 4449.84,
      "formatted_start": "01:14:07.840",
      "formatted_end": "01:14:09.840",
      "text": "و بعد برویم من بیده این از صرف خودشون بگیرم"
    },
    {
      "id": 67,
      "start": 4449.84,
      "end": 4451.84,
      "formatted_start": "01:14:09.840",
      "formatted_end": "01:14:11.840",
      "text": "گفته این آقا"
    },
    {
      "id": 68,
      "start": 4451.84,
      "end": 4453.84,
      "formatted_start": "01:14:11.840",
      "formatted_end": "01:14:13.840",
      "text": "به دختر خانم و خانمتون سلام برسون"
    },
    {
      "id": 69,
      "start": 4453.84,
      "end": 4457.84,
      "formatted_start": "01:14:13.840",
      "formatted_end": "01:14:17.840",
      "text": "این این توی توهماتشیه که ایما داریم برنامه خانواده بی کنیم"
    },
    {
      "id": 70,
      "start": 4457.84,
      "end": 4461.84,
      "formatted_start": "01:14:17.840",
      "formatted_end": "01:14:21.840",
      "text": "در اینجا فقط فرقان به نادی بشه خانواده ها مانوستن"
    },
    {
      "id": 71,
      "start": 4461.84,
      "end": 4465.84,
      "formatted_start": "01:14:21.840",
      "formatted_end": "01:14:25.840",
      "text": "این خود استفیه هست که من از سفر میگه توی من بگه"
    },
    {
      "id": 72,
      "start": 4465.84,
      "end": 4469.84,
      "formatted_start": "01:14:25.840",
      "formatted_end": "01:14:29.840",
      "text": "نه، یاباشکی بگیره، یاباشکی ببین این شیطانه"
    },
    {
      "id": 73,
      "start": 4469.84,
      "end": 4473.84,
      "formatted_start": "01:14:29.840",
      "formatted_end": "01:14:33.840",
      "text": "این بابروشی مادره از خط پدره بیپرسته"
    },
    {
      "id": 74,
      "start": 4473.84,
      "end": 4477.84,
      "formatted_start": "01:14:33.840",
      "formatted_end": "01:14:37.840",
      "text": "اینجوریه، ببین این پدره رو موده بی سراتان"
    },
    {
      "id": 75,
      "start": 4477.84,
      "end": 4481.84,
      "formatted_start": "01:14:37.840",
      "formatted_end": "01:14:41.840",
      "text": "به مصطفیش رو مشکلت عمل کنه، خوشی در اطراف عمل"
    },
    {
      "id": 76,
      "start": 4481.84,
      "end": 4500.0,
      "formatted_start": "01:14:41.840",
      "formatted_end": "01:15:00.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    }
