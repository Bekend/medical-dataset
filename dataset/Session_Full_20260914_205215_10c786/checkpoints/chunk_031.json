  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9330.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:30.000",
      "text": "مردی بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بیشتر از بی"
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9336.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:36.000",
      "text": "اشتباه اون یکی متب رفتند دکتر مسلیه یه فکر میزن زن"
    },
    {
      "id": 2,
      "start": 9336.0,
      "end": 9342.0,
      "formatted_start": "02:35:36.000",
      "formatted_end": "02:35:42.000",
      "text": "بند خدا میگه اصلا زهرهی نیم از اینجا"
    },
    {
      "id": 3,
      "start": 9342.0,
      "end": 9354.0,
      "formatted_start": "02:35:42.000",
      "formatted_end": "02:35:54.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 9354.0,
      "end": 9363.0,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:36:03.000",
      "text": "در این وقت نبودیم، میتونی بودیم. مقداری هم که میخوای بابرزه 3 کیلو، دو پیمانه 60 روی."
    },
    {
      "id": 5,
      "start": 9363.0,
      "end": 9369.0,
      "formatted_start": "02:36:03.000",
      "formatted_end": "02:36:09.000",
      "text": "دو پیمانه برای روی دو تا خط میشه 60 روی. این اسم شیر و کشته."
    },
    {
      "id": 6,
      "start": 9369.0,
      "end": 9374.0,
      "formatted_start": "02:36:09.000",
      "formatted_end": "02:36:14.000",
      "text": "ولی سه تا قطعه داره برای دلدش، فقط عادل رو خودت بده دیگه."
    },
    {
      "id": 7,
      "start": 9374.0,
      "end": 9376.0,
      "formatted_start": "02:36:14.000",
      "formatted_end": "02:36:16.000",
      "text": "اوه، حالا میدونم."
    },
    {
      "id": 8,
      "start": 9376.0,
      "end": 9378.36,
      "formatted_start": "02:36:16.000",
      "formatted_end": "02:36:18.360",
      "text": "اونا رو چیزونی بودن با هم بگیر برن"
    },
    {
      "id": 9,
      "start": 9378.36,
      "end": 9380.5,
      "formatted_start": "02:36:18.360",
      "formatted_end": "02:36:20.500",
      "text": "یه جونی با هم بگیر برن یه سفران بکنید"
    },
    {
      "id": 10,
      "start": 9380.5,
      "end": 9381.36,
      "formatted_start": "02:36:20.500",
      "formatted_end": "02:36:21.360",
      "text": "یه دره فاصله برن"
    },
    {
      "id": 11,
      "start": 9381.36,
      "end": 9383.84,
      "formatted_start": "02:36:21.360",
      "formatted_end": "02:36:23.840",
      "text": "یکی رو یه باره"
    },
    {
      "id": 12,
      "start": 9383.84,
      "end": 9385.0,
      "formatted_start": "02:36:23.840",
      "formatted_end": "02:36:25.000",
      "text": "یکی رو چهار باره"
    },
    {
      "id": 13,
      "start": 9385.56,
      "end": 9392.08,
      "formatted_start": "02:36:25.560",
      "formatted_end": "02:36:32.080",
      "text": "سفر سی و هشت پندر و هست"
    },
    {
      "id": 14,
      "start": 9392.08,
      "end": 9393.28,
      "formatted_start": "02:36:32.080",
      "formatted_end": "02:36:33.280",
      "text": "این کوده"
    },
    {
      "id": 15,
      "start": 9393.28,
      "end": 9394.38,
      "formatted_start": "02:36:33.280",
      "formatted_end": "02:36:34.380",
      "text": "درکی نیست"
    },
    {
      "id": 16,
      "start": 9394.38,
      "end": 9402.46,
      "formatted_start": "02:36:34.380",
      "formatted_end": "02:36:42.460",
      "text": "دست ندارم که اینجوری درست گرده"
    },
    {
      "id": 17,
      "start": 9402.46,
      "end": 9403.2,
      "formatted_start": "02:36:42.460",
      "formatted_end": "02:36:43.200",
      "text": "خیلی ممنونم"
    },
    {
      "id": 18,
      "start": 9406.0,
      "end": 9408.0,
      "formatted_start": "02:36:46.000",
      "formatted_end": "02:36:48.000",
      "text": "مرسی کنید"
    },
    {
      "id": 19,
      "start": 9408.0,
      "end": 9410.0,
      "formatted_start": "02:36:48.000",
      "formatted_end": "02:36:50.000",
      "text": "او براتون تر بخواهید"
    },
    {
      "id": 20,
      "start": 9410.0,
      "end": 9412.0,
      "formatted_start": "02:36:50.000",
      "formatted_end": "02:36:52.000",
      "text": "هاروانی هستش اونجا چیزی"
    },
    {
      "id": 21,
      "start": 9416.0,
      "end": 9418.0,
      "formatted_start": "02:36:56.000",
      "formatted_end": "02:36:58.000",
      "text": "الو"
    },
    {
      "id": 22,
      "start": 9418.0,
      "end": 9420.0,
      "formatted_start": "02:36:58.000",
      "formatted_end": "02:37:00.000",
      "text": "سلام"
    },
    {
      "id": 23,
      "start": 9420.0,
      "end": 9422.0,
      "formatted_start": "02:37:00.000",
      "formatted_end": "02:37:02.000",
      "text": "او در خودشون باشن؟"
    },
    {
      "id": 24,
      "start": 9422.0,
      "end": 9424.0,
      "formatted_start": "02:37:02.000",
      "formatted_end": "02:37:04.000",
      "text": "او در خودشون باشن؟"
    },
    {
      "id": 25,
      "start": 9424.0,
      "end": 9426.0,
      "formatted_start": "02:37:04.000",
      "formatted_end": "02:37:06.000",
      "text": "او در خودشون باشن؟"
    },
    {
      "id": 26,
      "start": 9426.0,
      "end": 9428.0,
      "formatted_start": "02:37:06.000",
      "formatted_end": "02:37:08.000",
      "text": "او در خودشون باشن؟"
    },
    {
      "id": 27,
      "start": 9428.0,
      "end": 9430.0,
      "formatted_start": "02:37:08.000",
      "formatted_end": "02:37:10.000",
      "text": "آمپی وزن شهاده"
    },
    {
      "id": 28,
      "start": 9430.0,
      "end": 9432.0,
      "formatted_start": "02:37:10.000",
      "formatted_end": "02:37:12.000",
      "text": "آمپی وزن شهاده"
    },
    {
      "id": 29,
      "start": 9432.0,
      "end": 9434.0,
      "formatted_start": "02:37:12.000",
      "formatted_end": "02:37:14.000",
      "text": "خانکرمی"
    },
    {
      "id": 30,
      "start": 9434.0,
      "end": 9436.0,
      "formatted_start": "02:37:14.000",
      "formatted_end": "02:37:16.000",
      "text": "چه روزی داری؟"
    },
    {
      "id": 31,
      "start": 9436.0,
      "end": 9438.0,
      "formatted_start": "02:37:16.000",
      "formatted_end": "02:37:18.000",
      "text": "چهار کلو"
    },
    {
      "id": 32,
      "start": 9438.0,
      "end": 9440.0,
      "formatted_start": "02:37:18.000",
      "formatted_end": "02:37:20.000",
      "text": "چهار کلو"
    },
    {
      "id": 33,
      "start": 9440.0,
      "end": 9442.0,
      "formatted_start": "02:37:20.000",
      "formatted_end": "02:37:22.000",
      "text": "سریع تن؟"
    },
    {
      "id": 34,
      "start": 9442.0,
      "end": 9444.0,
      "formatted_start": "02:37:22.000",
      "formatted_end": "02:37:24.000",
      "text": "یکی"
    },
    {
      "id": 35,
      "start": 9444.0,
      "end": 9446.0,
      "formatted_start": "02:37:24.000",
      "formatted_end": "02:37:26.000",
      "text": "یکی"
    },
    {
      "id": 36,
      "start": 9446.0,
      "end": 9448.0,
      "formatted_start": "02:37:26.000",
      "formatted_end": "02:37:28.000",
      "text": "یکی"
    },
    {
      "id": 37,
      "start": 9448.0,
      "end": 9450.0,
      "formatted_start": "02:37:28.000",
      "formatted_end": "02:37:30.000",
      "text": "یکی"
    },
    {
      "id": 38,
      "start": 9450.0,
      "end": 9452.0,
      "formatted_start": "02:37:30.000",
      "formatted_end": "02:37:32.000",
      "text": "یکی"
    },
    {
      "id": 39,
      "start": 9452.0,
      "end": 9454.0,
      "formatted_start": "02:37:32.000",
      "formatted_end": "02:37:34.000",
      "text": "چهار کلو گفتی؟"
    },
    {
      "id": 40,
      "start": 9454.0,
      "end": 9456.0,
      "formatted_start": "02:37:34.000",
      "formatted_end": "02:37:36.000",
      "text": "چهار کلو"
    },
    {
      "id": 41,
      "start": 9456.0,
      "end": 9458.0,
      "formatted_start": "02:37:36.000",
      "formatted_end": "02:37:38.000",
      "text": "چهار کلو گفتی؟"
    },
    {
      "id": 42,
      "start": 9458.0,
      "end": 9460.0,
      "formatted_start": "02:37:38.000",
      "formatted_end": "02:37:40.000",
      "text": "چهار کلو"
    },
    {
      "id": 43,
      "start": 9460.0,
      "end": 9462.0,
      "formatted_start": "02:37:40.000",
      "formatted_end": "02:37:42.000",
      "text": "چهار کلو"
    },
    {
      "id": 44,
      "start": 9462.0,
      "end": 9481.0,
      "formatted_start": "02:37:42.000",
      "formatted_end": "02:38:01.000",
      "text": "آره، آمیکا همشسته دیگی، بعد یه سی بی سی، سی آر پی، فلاد پاچه، بیو اینکرا، سولیوم، فوتاسیوم، بی ایس کلسیوم، بیلیروبین، اکتروکوی دایره"
    },
    {
      "id": 45,
      "start": 9481.0,
      "end": 9488.0,
      "formatted_start": "02:38:01.000",
      "formatted_end": "02:38:08.000",
      "text": "بعد بیاییم بپرسه انفاویشتش چیزی سی چک شده قبل همه؟"
    },
    {
      "id": 46,
      "start": 9488.0,
      "end": 9494.0,
      "formatted_start": "02:38:08.000",
      "formatted_end": "02:38:14.000",
      "text": "نه اونو میدونم"
    },
    {
      "id": 47,
      "start": 9494.0,
      "end": 9494.78,
      "formatted_start": "02:38:14.000",
      "formatted_end": "02:38:14.780",
      "text": "نه اونو میدونم"
    },
    {
      "id": 48,
      "start": 9494.78,
      "end": 9498.82,
      "formatted_start": "02:38:14.780",
      "formatted_end": "02:38:18.820",
      "text": "باشه باشه"
    },
    {
      "id": 49,
      "start": 9498.82,
      "end": 9499.38,
      "formatted_start": "02:38:18.820",
      "formatted_end": "02:38:19.380",
      "text": "باشه"
    },
    {
      "id": 50,
      "start": 9499.38,
      "end": 9502.94,
      "formatted_start": "02:38:19.380",
      "formatted_end": "02:38:22.940",
      "text": "سلام سلام"
    },
    {
      "id": 51,
      "start": 9502.94,
      "end": 9503.98,
      "formatted_start": "02:38:22.940",
      "formatted_end": "02:38:23.980",
      "text": "خوبستیم مرسی"
    },
    {
      "id": 52,
      "start": 9503.98,
      "end": 9504.96,
      "formatted_start": "02:38:23.980",
      "formatted_end": "02:38:24.960",
      "text": "مرمون"
    },
    {
      "id": 53,
      "start": 9504.96,
      "end": 9506.82,
      "formatted_start": "02:38:24.960",
      "formatted_end": "02:38:26.820",
      "text": "بگم که من نمونه"
    },
    {
      "id": 54,
      "start": 9506.82,
      "end": 9508.56,
      "formatted_start": "02:38:26.820",
      "formatted_end": "02:38:28.560",
      "text": "آره جی سیکس بی جی تی سی"
    },
    {
      "id": 55,
      "start": 9508.56,
      "end": 9510.14,
      "formatted_start": "02:38:28.560",
      "formatted_end": "02:38:30.140",
      "text": "اینها رو نمیرسیم"
    },
    {
      "id": 56,
      "start": 9510.14,
      "end": 9511.2,
      "formatted_start": "02:38:30.140",
      "formatted_end": "02:38:31.200",
      "text": "بروسه شما فرستادی"
    },
    {
      "id": 57,
      "start": 9511.2,
      "end": 9514.48,
      "formatted_start": "02:38:31.200",
      "formatted_end": "02:38:34.480",
      "text": "آره باشه"
    },
    {
      "id": 58,
      "start": 9514.48,
      "end": 9515.24,
      "formatted_start": "02:38:34.480",
      "formatted_end": "02:38:35.240",
      "text": "باشه"
    },
    {
      "id": 59,
      "start": 9515.24,
      "end": 9517.24,
      "formatted_start": "02:38:35.240",
      "formatted_end": "02:38:37.240",
      "text": "خب، یک سی برگیر"
    },
    {
      "id": 60,
      "start": 9520.88,
      "end": 9522.88,
      "formatted_start": "02:38:40.880",
      "formatted_end": "02:38:42.880",
      "text": "بله، آره"
    },
    {
      "id": 61,
      "start": 9526.3,
      "end": 9528.3,
      "formatted_start": "02:38:46.300",
      "formatted_end": "02:38:48.300",
      "text": "چی داده؟"
    },
    {
      "id": 62,
      "start": 9528.3,
      "end": 9530.3,
      "formatted_start": "02:38:48.300",
      "formatted_end": "02:38:50.300",
      "text": "ممنون ممنون"
    },
    {
      "id": 63,
      "start": 9530.3,
      "end": 9532.3,
      "formatted_start": "02:38:50.300",
      "formatted_end": "02:38:52.300",
      "text": "ممنون ممنون"
    },
    {
      "id": 64,
      "start": 9532.3,
      "end": 9537.3,
      "formatted_start": "02:38:52.300",
      "formatted_end": "02:38:57.300",
      "text": "این هم کمکی میکنه که مقابل ما توش استفاده نشه"
    },
    {
      "id": 65,
      "start": 9537.3,
      "end": 9539.3,
      "formatted_start": "02:38:57.300",
      "formatted_end": "02:38:59.300",
      "text": "مقابل ماش چیه؟"
    },
    {
      "id": 66,
      "start": 9539.3,
      "end": 9541.3,
      "formatted_start": "02:38:59.300",
      "formatted_end": "02:39:01.300",
      "text": "آتون اینو دیگه رو برم برم"
    },
    {
      "id": 67,
      "start": 9541.3,
      "end": 9543.3,
      "formatted_start": "02:39:01.300",
      "formatted_end": "02:39:03.300",
      "text": "سرمت برم برم برم"
    },
    {
      "id": 68,
      "start": 9543.3,
      "end": 9545.3,
      "formatted_start": "02:39:03.300",
      "formatted_end": "02:39:05.300",
      "text": "آه باشه باشه باشه"
    },
    {
      "id": 69,
      "start": 9545.3,
      "end": 9548.3,
      "formatted_start": "02:39:05.300",
      "formatted_end": "02:39:08.300",
      "text": "من حالا خودم هم میام سطح ایک و اینو ببینم"
    },
    {
      "id": 70,
      "start": 9548.3,
      "end": 9551.3,
      "formatted_start": "02:39:08.300",
      "formatted_end": "02:39:11.300",
      "text": "فقط شیر خوردنش اینو اوکیه دیگه درسته؟"
    },
    {
      "id": 71,
      "start": 9551.3,
      "end": 9552.3,
      "formatted_start": "02:39:11.300",
      "formatted_end": "02:39:12.300",
      "text": "میشه"
    },
    {
      "id": 72,
      "start": 9552.3,
      "end": 9553.3,
      "formatted_start": "02:39:12.300",
      "formatted_end": "02:39:13.300",
      "text": "خوابه"
    },
    {
      "id": 73,
      "start": 9553.3,
      "end": 9555.3,
      "formatted_start": "02:39:13.300",
      "formatted_end": "02:39:15.300",
      "text": "بس ما سرمت در اقل برشو بزنیم"
    },
    {
      "id": 74,
      "start": 9555.3,
      "end": 9557.3,
      "formatted_start": "02:39:15.300",
      "formatted_end": "02:39:17.300",
      "text": "این همه دیگه سال"
    },
    {
      "id": 75,
      "start": 9557.3,
      "end": 9559.3,
      "formatted_start": "02:39:17.300",
      "formatted_end": "02:39:19.300",
      "text": "این همه دیگه سال"
    },
    {
      "id": 76,
      "start": 9559.3,
      "end": 9561.3,
      "formatted_start": "02:39:19.300",
      "formatted_end": "02:39:21.300",
      "text": "این همه دیگه سال"
    },
    {
      "id": 77,
      "start": 9561.3,
      "end": 9563.3,
      "formatted_start": "02:39:21.300",
      "formatted_end": "02:39:23.300",
      "text": "اگه باشه باشه همون رو که بذاشتی باشه"
    },
    {
      "id": 78,
      "start": 9563.3,
      "end": 9565.3,
      "formatted_start": "02:39:23.300",
      "formatted_end": "02:39:25.300",
      "text": "باشه که من آن توی گرام شو ببینم."
    },
    {
      "id": 79,
      "start": 9565.3,
      "end": 9567.3,
      "formatted_start": "02:39:25.300",
      "formatted_end": "02:39:27.300",
      "text": "دیدی بدن آنکه آمیکا."
    },
    {
      "id": 80,
      "start": 9567.3,
      "end": 9571.3,
      "formatted_start": "02:39:27.300",
      "formatted_end": "02:39:31.300",
      "text": "فقط من خواستم بتونم جیز بیدی و ریتیک و تیز تیش رو و اینا..."
    },
    {
      "id": 81,
      "start": 9571.3,
      "end": 9573.3,
      "formatted_start": "02:39:31.300",
      "formatted_end": "02:39:33.300",
      "text": "بنده نمیدونم. آره."
    },
    {
      "id": 82,
      "start": 9573.3,
      "end": 9575.3,
      "formatted_start": "02:39:33.300",
      "formatted_end": "02:39:35.300",
      "text": "ده نیمه باشه. باشه باشه."
    },
    {
      "id": 83,
      "start": 9575.3,
      "end": 9577.3,
      "formatted_start": "02:39:35.300",
      "formatted_end": "02:39:37.300",
      "text": "خوش میکنم."
    },
    {
      "id": 84,
      "start": 9577.3,
      "end": 9579.3,
      "formatted_start": "02:39:37.300",
      "formatted_end": "02:39:39.300",
      "text": "خوش میکنم."
    },
    {
      "id": 85,
      "start": 9579.3,
      "end": 9581.3,
      "formatted_start": "02:39:39.300",
      "formatted_end": "02:39:41.300",
      "text": "خواهد سنوی کلی مجایی از جارم بزاریم."
    },
    {
      "id": 86,
      "start": 9581.3,
      "end": 9583.3,
      "formatted_start": "02:39:41.300",
      "formatted_end": "02:39:43.300",
      "text": "باشه باشه."
    },
    {
      "id": 87,
      "start": 9583.3,
      "end": 9585.3,
      "formatted_start": "02:39:43.300",
      "formatted_end": "02:39:45.300",
      "text": "باشه. مرسی."
    },
    {
      "id": 88,
      "start": 9585.3,
      "end": 9587.3,
      "formatted_start": "02:39:45.300",
      "formatted_end": "02:39:47.300",
      "text": "خواهدم. خوش میکنم."
    },
    {
      "id": 89,
      "start": 9589.3,
      "end": 9591.3,
      "formatted_start": "02:39:49.300",
      "formatted_end": "02:39:51.300",
      "text": "ای لحظه."
    },
    {
      "id": 90,
      "start": 9593.3,
      "end": 9599.3,
      "formatted_start": "02:39:53.300",
      "formatted_end": "02:39:59.300",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}