      "formatted_start": "03:00:58.300",
      "formatted_end": "03:01:06.300",
      "text": "باز باز باز نگاه کنم باز باز نگاه کنم بسه من بگو آم"
    },
    {
      "id": 15,
      "start": 10866.3,
      "end": 10871.3,
      "formatted_start": "03:01:06.300",
      "formatted_end": "03:01:11.300",
      "text": "بله این گریم از دیشه ها این گرد هی بیا حالت اینگه کنم"
    },
    {
      "id": 16,
      "start": 10871.3,
      "end": 10886.3,
      "formatted_start": "03:01:11.300",
      "formatted_end": "03:01:26.300",
      "text": "برای از دیشه ها هی"
    },
    {
      "id": 17,
      "start": 10886.3,
      "end": 10888.3,
      "formatted_start": "03:01:26.300",
      "formatted_end": "03:01:28.300",
      "text": "این صحبه باید سوار کنید"
    },
    {
      "id": 18,
      "start": 10888.3,
      "end": 10890.3,
      "formatted_start": "03:01:28.300",
      "formatted_end": "03:01:30.300",
      "text": "نه این صحبه برش"
    },
    {
      "id": 19,
      "start": 10890.3,
      "end": 10892.3,
      "formatted_start": "03:01:30.300",
      "formatted_end": "03:01:32.300",
      "text": "این صحبه برش"
    },
    {
      "id": 20,
      "start": 10892.3,
      "end": 10894.3,
      "formatted_start": "03:01:32.300",
      "formatted_end": "03:01:34.300",
      "text": "اون صحبه سیست هست"
    },
    {
      "id": 21,
      "start": 10894.3,
      "end": 10896.3,
      "formatted_start": "03:01:34.300",
      "formatted_end": "03:01:36.300",
      "text": "خب برو چی رو خب"
    },
    {
      "id": 22,
      "start": 10896.3,
      "end": 10898.3,
      "formatted_start": "03:01:36.300",
      "formatted_end": "03:01:38.300",
      "text": "از پیشه های مثلا اینجوری می کنند"
    },
    {
      "id": 23,
      "start": 10898.3,
      "end": 10900.3,
      "formatted_start": "03:01:38.300",
      "formatted_end": "03:01:40.300",
      "text": "اینجوری می کنند"
    },
    {
      "id": 24,
      "start": 10900.3,
      "end": 10902.3,
      "formatted_start": "03:01:40.300",
      "formatted_end": "03:01:42.300",
      "text": "برو گلوش که خوب بود"
    },
    {
      "id": 25,
      "start": 10902.3,
      "end": 10904.3,
      "formatted_start": "03:01:42.300",
      "formatted_end": "03:01:44.300",
      "text": "اینجوری می کنند سرد تیک ها"
    },
    {
      "id": 26,
      "start": 10904.3,
      "end": 10906.3,
      "formatted_start": "03:01:44.300",
      "formatted_end": "03:01:46.300",
      "text": "این تیک عصبیه تو بچه ها طبیعیه"
    },
    {
      "id": 27,
      "start": 10906.3,
      "end": 10908.3,
      "formatted_start": "03:01:46.300",
      "formatted_end": "03:01:48.300",
      "text": "این که خواب تو خواب اصلا نیست"
    },
    {
      "id": 28,
      "start": 10908.3,
      "end": 10910.3,
      "formatted_start": "03:01:48.300",
      "formatted_end": "03:01:50.300",
      "text": "یا آدرسی"
    },
    {
      "id": 29,
      "start": 10910.3,
      "end": 10912.3,
      "formatted_start": "03:01:50.300",
      "formatted_end": "03:01:52.300",
      "text": "خب همون تیک یک عادت دیه"
    },
    {
      "id": 30,
      "start": 10912.3,
      "end": 10914.3,
      "formatted_start": "03:01:52.300",
      "formatted_end": "03:01:54.300",
      "text": "این صوربه ها دو هفته طور کشنه"
    },
    {
      "id": 31,
      "start": 10914.3,
      "end": 10924.3,
      "formatted_start": "03:01:54.300",
      "formatted_end": "03:02:04.300",
      "text": "این صرفه تیکه ایجاد شده. ولی گروش مشکلی نداشت. صرفه زمین آلرژی داره. نشانی صدای ویز داره."
    },
    {
      "id": 32,
      "start": 10924.3,
      "end": 10931.3,
      "formatted_start": "03:02:04.300",
      "formatted_end": "03:02:11.300",
      "text": "حالا توی کشیده خیلی چیز رو قبول دارم. انتویتیک رو باید بهش بدیم. فنتاور رو باید بدیم. ولی اسپریه هم لازمش میشه."
    },
    {
      "id": 33,
      "start": 10931.3,
      "end": 10939.3,
      "formatted_start": "03:02:11.300",
      "formatted_end": "03:02:19.300",
      "text": "نبولایزر را هم استفاده کنید"
    },
    {
      "id": 34,
      "start": 10939.3,
      "end": 10941.3,
      "formatted_start": "03:02:19.300",
      "formatted_end": "03:02:21.300",
      "text": "نبولایزر را هم استفاده کنید"
    },
    {
      "id": 35,
      "start": 10941.3,
      "end": 10943.3,
      "formatted_start": "03:02:21.300",
      "formatted_end": "03:02:23.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 36,
      "start": 10943.3,
      "end": 10945.3,
      "formatted_start": "03:02:23.300",
      "formatted_end": "03:02:25.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 37,
      "start": 10945.3,
      "end": 10947.3,
      "formatted_start": "03:02:25.300",
      "formatted_end": "03:02:27.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 38,
      "start": 10947.3,
      "end": 10949.3,
      "formatted_start": "03:02:27.300",
      "formatted_end": "03:02:29.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 39,
      "start": 10949.3,
      "end": 10951.3,
      "formatted_start": "03:02:29.300",
      "formatted_end": "03:02:31.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 40,
      "start": 10951.3,
      "end": 10953.3,
      "formatted_start": "03:02:31.300",
      "formatted_end": "03:02:33.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 41,
      "start": 10953.3,
      "end": 10955.3,
      "formatted_start": "03:02:33.300",
      "formatted_end": "03:02:35.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 42,
      "start": 10955.3,
      "end": 10957.3,
      "formatted_start": "03:02:35.300",
      "formatted_end": "03:02:37.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 43,
      "start": 10957.3,
      "end": 10959.3,
      "formatted_start": "03:02:37.300",
      "formatted_end": "03:02:39.300",
      "text": "نبولایزر هم گراشتیم"
    },
    {
      "id": 44,
      "start": 10959.3,
      "end": 10961.3,
      "formatted_start": "03:02:39.300",
      "formatted_end": "03:02:41.300",
      "text": "از اینجور خودش رو هم سری دادی"
    },
    {
      "id": 45,
      "start": 10961.3,
      "end": 10963.3,
      "formatted_start": "03:02:41.300",
      "formatted_end": "03:02:43.300",
      "text": "ببین این که داروخانه ایشه بره"
    },
    {
      "id": 46,
      "start": 10963.3,
      "end": 10965.3,
      "formatted_start": "03:02:43.300",
      "formatted_end": "03:02:45.300",
      "text": "من میشه من چهرتا بریم سم"
    },
    {
      "id": 47,
      "start": 10965.3,
      "end": 10967.3,
      "formatted_start": "03:02:45.300",
      "formatted_end": "03:02:47.300",
      "text": "چهرتا اگه میشه"
    },
    {
      "id": 48,
      "start": 10969.3,
      "end": 10971.3,
      "formatted_start": "03:02:49.300",
      "formatted_end": "03:02:51.300",
      "text": "من چهرتا بریم سم"
    },
    {
      "id": 49,
      "start": 10971.3,
      "end": 10973.3,
      "formatted_start": "03:02:51.300",
      "formatted_end": "03:02:53.300",
      "text": "هنشتا، افراد، بیست سا"
    },
    {
      "id": 50,
      "start": 10973.3,
      "end": 10975.3,
      "formatted_start": "03:02:53.300",
      "formatted_end": "03:02:55.300",
      "text": "یا خودت خودتی زیاد برده"
    },
    {
      "id": 51,
      "start": 10975.3,
      "end": 10977.3,
      "formatted_start": "03:02:55.300",
      "formatted_end": "03:02:57.300",
      "text": "نه نه"
    },
    {
      "id": 52,
      "start": 10977.3,
      "end": 10979.3,
      "formatted_start": "03:02:57.300",
      "formatted_end": "03:02:59.300",
      "text": "این ها اصلا از آخرین بایی هم که آمدیم"
    },
    {
      "id": 53,
      "start": 10979.3,
      "end": 10981.3,
      "formatted_start": "03:02:59.300",
      "formatted_end": "03:03:01.300",
      "text": "بابا همین موضوع بود"
    },
    {
      "id": 54,
      "start": 10981.3,
      "end": 10983.3,
      "formatted_start": "03:03:01.300",
      "formatted_end": "03:03:03.300",
      "text": "آن پیش شما"
    },
    {
      "id": 55,
      "start": 10983.3,
      "end": 10985.3,
      "formatted_start": "03:03:03.300",
      "formatted_end": "03:03:05.300",
      "text": "این ها برای هم هنشتا"
    },
    {
      "id": 56,
      "start": 10985.3,
      "end": 10987.3,
      "formatted_start": "03:03:05.300",
      "formatted_end": "03:03:07.300",
      "text": "چیزها عادی بیست هم برای چیزها"
    },
    {
      "id": 57,
      "start": 10987.3,
      "end": 10989.3,
      "formatted_start": "03:03:07.300",
      "formatted_end": "03:03:09.300",
      "text": "الان شده فیلنب که ای بوده؟"
    },
    {
      "id": 58,
      "start": 10989.3,
      "end": 10991.3,
      "formatted_start": "03:03:09.300",
      "formatted_end": "03:03:11.300",
      "text": "همه چهار و پنجه هایی دیگه بوده"
    },
    {
      "id": 59,
      "start": 10991.3,
      "end": 10993.3,
      "formatted_start": "03:03:11.300",
      "formatted_end": "03:03:13.300",
      "text": "آها پارسال رو نشون نمیده"
    },
    {
      "id": 60,
      "start": 10993.3,
      "end": 10995.3,
      "formatted_start": "03:03:13.300",
      "formatted_end": "03:03:15.300",
      "text": "چفتی توی اکیتینی بوده؟"
    },
    {
      "id": 61,
      "start": 10995.3,
      "end": 10997.3,
      "formatted_start": "03:03:15.300",
      "formatted_end": "03:03:17.300",
      "text": "نه، قداد داروهای داروشی بوده"
    },
    {
      "id": 62,
      "start": 10997.3,
      "end": 10999.3,
      "formatted_start": "03:03:17.300",
      "formatted_end": "03:03:19.300",
      "text": "او تب کنم"
    },
    {
      "id": 63,
      "start": 10999.3,
      "end": 11001.3,
      "formatted_start": "03:03:19.300",
      "formatted_end": "03:03:21.300",
      "text": "این چی که هست توی"
    },
    {
      "id": 64,
      "start": 11001.3,
      "end": 11003.3,
      "formatted_start": "03:03:21.300",
      "formatted_end": "03:03:23.300",
      "text": "اول دیگه بوده"
    },
    {
      "id": 65,
      "start": 11003.3,
      "end": 11005.3,
      "formatted_start": "03:03:23.300",
      "formatted_end": "03:03:25.300",
      "text": "اینه اون پارسال رو نشون نمیده"
    },
    {
      "id": 66,
      "start": 11005.3,
      "end": 11007.3,
      "formatted_start": "03:03:25.300",
      "formatted_end": "03:03:27.300",
      "text": "سیستم، ولی بیستا"
    },
    {
      "id": 67,
      "start": 11007.3,
      "end": 11009.3,
      "formatted_start": "03:03:27.300",
      "formatted_end": "03:03:29.300",
      "text": "یا خودت گفتی"
    },
    {
      "id": 68,
      "start": 11009.3,
      "end": 11011.3,
      "formatted_start": "03:03:29.300",
      "formatted_end": "03:03:31.300",
      "text": "داشته باشم کنه، فصلتون به نصف بوده؟"
    },
    {
      "id": 69,
      "start": 11011.3,
      "end": 11013.3,
      "formatted_start": "03:03:31.300",
      "formatted_end": "03:03:33.300",
      "text": "نه نه"
    },
    {
      "id": 70,
      "start": 11013.3,
      "end": 11017.46,
      "formatted_start": "03:03:33.300",
      "formatted_end": "03:03:37.460",
      "text": "اولین بار بود که اینجوری باز مثلا سرپاهاش اینجوری شده بود"
    },
    {
      "id": 71,
      "start": 11017.46,
      "end": 11019.72,
      "formatted_start": "03:03:37.460",
      "formatted_end": "03:03:39.720",
      "text": "افران اینجوری استره همه که سفر کرده"
    },
    {
      "id": 72,
      "start": 11019.72,
      "end": 11020.72,
      "formatted_start": "03:03:39.720",
      "formatted_end": "03:03:40.720",
      "text": "صفحه کن بخون"
    },
    {
      "id": 73,
      "start": 11020.72,
      "end": 11023.12,
      "formatted_start": "03:03:40.720",
      "formatted_end": "03:03:43.120",
      "text": "بازم بازم بازم"
    },
    {
      "id": 74,
      "start": 11023.12,
      "end": 11023.82,
      "formatted_start": "03:03:43.120",
      "formatted_end": "03:03:43.820",
      "text": "نگه هست"
    },
    {
      "id": 75,
      "start": 11023.82,
      "end": 11024.82,
      "formatted_start": "03:03:43.820",
      "formatted_end": "03:03:44.820",
      "text": "دست نگه هست"
    },
    {
      "id": 76,
      "start": 11024.82,
      "end": 11026.82,
      "formatted_start": "03:03:44.820",
      "formatted_end": "03:03:46.820",
      "text": "صفحه کن صفحه کن"
    },
    {
      "id": 77,
      "start": 11026.82,
      "end": 11029.82,
      "formatted_start": "03:03:46.820",
      "formatted_end": "03:03:49.820",
      "text": "آها دیگه هم خیلی تایش نست"
    },
    {
      "id": 78,
      "start": 11029.82,
      "end": 11033.82,
      "formatted_start": "03:03:49.820",
      "formatted_end": "03:03:53.820",
      "text": "بده اینکه همه با این ها رو میگم میگم نه تو تشنسه جایی"
    },
    {
      "id": 79,
      "start": 11033.82,
      "end": 11039.3,
      "formatted_start": "03:03:53.820",
      "formatted_end": "03:03:59.300",
      "text": "این من چند بارم دیدم رفلاکس هم هم یک ماهه چار پنج بیتر"
    },
    {
      "id": 80,
      "start": 11039.3,
      "end": 11044.3,
      "formatted_start": "03:03:59.300",
      "formatted_end": "03:04:04.300",
      "text": "از اینجا باید شما به هم بزنن. ریفلاکس بعد دو سالگی اصلا نیست."
    },
    {
      "id": 81,
      "start": 11044.3,
      "end": 11047.3,
      "formatted_start": "03:04:04.300",
      "formatted_end": "03:04:07.300",
      "text": "اصلا اسم ریفلاکس نیست. وجود نداره."
    },
    {
      "id": 82,
      "start": 11047.3,
      "end": 11049.3,
      "formatted_start": "03:04:07.300",
      "formatted_end": "03:04:09.300",
      "text": "همون یعنی اینجا رفته و اومده بالا."
    },
    {
      "id": 83,
      "start": 11049.3,
      "end": 11052.3,
      "formatted_start": "03:04:09.300",
      "formatted_end": "03:04:12.300",
      "text": "این شیر نمیخورد و قبل هم آلرشیالا هم کنه."
    },
    {
      "id": 84,
      "start": 11052.3,
      "end": 11057.8,
      "formatted_start": "03:04:12.300",
      "formatted_end": "03:04:17.800",
      "text": "نه نه نه، اون رو نکرده بزرگشت دیگه، ببین بعد دو سالگی صد درصد از بین میره ریفلاکس، این دیگه مقاله هست،"
    },
    {
      "id": 85,
      "start": 11057.8,
      "end": 11061.8,
      "formatted_start": "03:04:17.800",
      "formatted_end": "03:04:21.800",
      "text": "هشتاد درصد تا یک سالگی، صد درصد تا دو سالگی، تو این سن دیگه ریفلاکس دیگه نیست."
    },
    {
      "id": 86,
      "start": 11061.8,
      "end": 11063.8,
      "formatted_start": "03:04:21.800",
      "formatted_end": "03:04:23.800",
      "text": "این حسید مده دیگه تو اینو باقی نفرده داره؟"
    },
    {
      "id": 87,
      "start": 11063.8,
      "end": 11070.3,
      "formatted_start": "03:04:23.800",
      "formatted_end": "03:04:30.300",
      "text": "چرا؟ چرا؟ مگه ما بزرگان هم داریم؟ اون ریفلاکس دیگه نیست، دیگه ممکنه اصلا زخم مده باشه،"
    },
    {
      "id": 88,
      "start": 11070.3,
      "end": 11074.3,
      "formatted_start": "03:04:30.300",
      "formatted_end": "03:04:34.300",
      "text": "اینجا باشه بلی ریفترات برگرد مونن و تعملشی نداشته باشه"
    },
    {
      "id": 89,
      "start": 11074.3,
      "end": 11078.3,
      "formatted_start": "03:04:34.300",
      "formatted_end": "03:04:38.300",
      "text": "نه که اینجا شده که گفت آره اصلا سوط کنم"
    },
    {
      "id": 90,
      "start": 11078.3,
      "end": 11080.3,
      "formatted_start": "03:04:38.300",
      "formatted_end": "03:04:40.300",
      "text": "یه چهار پنج باری به من این حرف رو زده"
    },
    {
      "id": 91,
      "start": 11080.3,
      "end": 11082.3,
      "formatted_start": "03:04:40.300",
      "formatted_end": "03:04:42.300",
      "text": "خب الان اسپری داری؟"
    },
    {
      "id": 92,
      "start": 11082.3,
      "end": 11084.3,
