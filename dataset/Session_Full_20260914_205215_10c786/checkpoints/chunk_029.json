  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8702.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:02.000",
      "text": "از اینجا همه چیزی ندارم."
    },
    {
      "id": 1,
      "start": 8702.0,
      "end": 8704.0,
      "formatted_start": "02:25:02.000",
      "formatted_end": "02:25:04.000",
      "text": "همه چیزی نداریم."
    },
    {
      "id": 2,
      "start": 8704.0,
      "end": 8708.0,
      "formatted_start": "02:25:04.000",
      "formatted_end": "02:25:08.000",
      "text": "بعد از اینجا نان ندیم، چیز بدیم بهش؟ سپراهومیتی؟"
    },
    {
      "id": 3,
      "start": 8708.0,
      "end": 8715.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:15.000",
      "text": "نه نه، اصلاً، بیا براتو شما فعلاً شیر، فقط گیگوز. شیر خشکی که شکم درسته."
    },
    {
      "id": 4,
      "start": 8715.0,
      "end": 8718.0,
      "formatted_start": "02:25:15.000",
      "formatted_end": "02:25:18.000",
      "text": "آره، آره، روز اول به من گفتم، من هر چیزی که خشکی که شکم درسته."
    },
    {
      "id": 5,
      "start": 8718.0,
      "end": 8722.0,
      "formatted_start": "02:25:18.000",
      "formatted_end": "02:25:22.000",
      "text": "البته من هران شیر خشک براش میدونیم، کم سه ساعت."
    },
    {
      "id": 6,
      "start": 8722.0,
      "end": 8727.0,
      "formatted_start": "02:25:22.000",
      "formatted_end": "02:25:27.000",
      "text": "شما هم یکی که مدکویی که داره یه دست آزمایشگاه آزمایش بده"
    },
    {
      "id": 7,
      "start": 8727.0,
      "end": 8731.0,
      "formatted_start": "02:25:27.000",
      "formatted_end": "02:25:31.000",
      "text": "شاید اصلا این بچه حساسیت پروتینی واقعی داره که مدکویشو رو عذیب میکنه"
    },
    {
      "id": 8,
      "start": 8731.0,
      "end": 8732.0,
      "formatted_start": "02:25:31.000",
      "formatted_end": "02:25:32.000",
      "text": "سبزه لجنی هم هست"
    },
    {
      "id": 9,
      "start": 8732.0,
      "end": 8733.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:33.000",
      "text": "آره سبزه"
    },
    {
      "id": 10,
      "start": 8733.0,
      "end": 8735.0,
      "formatted_start": "02:25:33.000",
      "formatted_end": "02:25:35.000",
      "text": "یک سرورت ما باید چیرشو عوض کنیم ناموشکردی"
    },
    {
      "id": 11,
      "start": 8735.0,
      "end": 8737.0,
      "formatted_start": "02:25:35.000",
      "formatted_end": "02:25:37.000",
      "text": "یعنی شاید چیرشو منو یکم میخوره"
    },
    {
      "id": 12,
      "start": 8737.0,
      "end": 8739.0,
      "formatted_start": "02:25:37.000",
      "formatted_end": "02:25:39.000",
      "text": "من چیر بخورم"
    },
    {
      "id": 13,
      "start": 8739.0,
      "end": 8742.0,
      "formatted_start": "02:25:39.000",
      "formatted_end": "02:25:42.000",
      "text": "ما اقدر دیشتر گفتیم که"
    },
    {
      "id": 14,
      "start": 8742.0,
      "end": 8744.0,
      "formatted_start": "02:25:42.000",
      "formatted_end": "02:25:44.000",
      "text": "بسیار همه جیشه"
    },
    {
      "id": 15,
      "start": 8744.0,
      "end": 8746.0,
      "formatted_start": "02:25:44.000",
      "formatted_end": "02:25:46.000",
      "text": "بس بس بس"
    },
    {
      "id": 16,
      "start": 8768.0,
      "end": 8770.0,
      "formatted_start": "02:26:08.000",
      "formatted_end": "02:26:10.000",
      "text": "من خودم رو میدم کم کم"
    },
    {
      "id": 17,
      "start": 8770.0,
      "end": 8772.0,
      "formatted_start": "02:26:10.000",
      "formatted_end": "02:26:12.000",
      "text": "من خودم کم کم"
    },
    {
      "id": 18,
      "start": 8772.0,
      "end": 8779.0,
      "formatted_start": "02:26:12.000",
      "formatted_end": "02:26:19.000",
      "text": "از لپه ماش کلم، بادم جون، سیرو، پیاز خام، فلفل دلویی یا نوشتاب دلستر نباید فیلم بخوایی خوب"
    },
    {
      "id": 19,
      "start": 8779.0,
      "end": 8787.0,
      "formatted_start": "02:26:19.000",
      "formatted_end": "02:26:27.000",
      "text": "و اینکه بعد از رژیم خود صدای جارو برقیصش و حرکت ماشین براش خوبه"
    },
    {
      "id": 20,
      "start": 8787.0,
      "end": 8791.0,
      "formatted_start": "02:26:27.000",
      "formatted_end": "02:26:31.000",
      "text": "و دل نردشت، ماساجش، صدای جارو برقیصش و حرکت ماشین خوبه"
    },
    {
      "id": 21,
      "start": 8791.0,
      "end": 8797.0,
      "formatted_start": "02:26:31.000",
      "formatted_end": "02:26:37.000",
      "text": "ماساج شکم براغم بدن وچه، تا سه روز پار نکنه اشکالی نداره"
    },
    {
      "id": 22,
      "start": 8797.0,
      "end": 8800.0,
      "formatted_start": "02:26:37.000",
      "formatted_end": "02:26:40.000",
      "text": "بعد از سه روز اگر کار نمی کنه آره ببرش پیش زفر نکنه"
    },
    {
      "id": 23,
      "start": 8800.0,
      "end": 8804.0,
      "formatted_start": "02:26:40.000",
      "formatted_end": "02:26:44.000",
      "text": "برای اینکه این داروما باید اول شیرش رو عوض نمی کنم"
    },
    {
      "id": 24,
      "start": 8804.0,
      "end": 8808.0,
      "formatted_start": "02:26:44.000",
      "formatted_end": "02:26:48.000",
      "text": "آزمایش رو بده تا دو من پس من یه روبه جواب می ده ببینم شیرش رو چی باید بینستم"
    },
    {
      "id": 25,
      "start": 8808.0,
      "end": 8810.0,
      "formatted_start": "02:26:48.000",
      "formatted_end": "02:26:50.000",
      "text": "گیگوز بینستم یا رژینی"
    },
    {
      "id": 26,
      "start": 8810.0,
      "end": 8812.0,
      "formatted_start": "02:26:50.000",
      "formatted_end": "02:26:52.000",
      "text": "آزمایش آزمایشتر اینجا بیده بیده بیده بیده"
    },
    {
      "id": 27,
      "start": 8812.0,
      "end": 8814.0,
      "formatted_start": "02:26:52.000",
      "formatted_end": "02:26:54.000",
      "text": "من یه روبه ببینم"
    },
    {
      "id": 28,
      "start": 8814.0,
      "end": 8816.0,
      "formatted_start": "02:26:54.000",
      "formatted_end": "02:26:56.000",
      "text": "همین مدکوریش که الان یه ذره داره"
    },
    {
      "id": 29,
      "start": 8816.0,
      "end": 8818.0,
      "formatted_start": "02:26:56.000",
      "formatted_end": "02:26:58.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 30,
      "start": 8818.0,
      "end": 8820.0,
      "formatted_start": "02:26:58.000",
      "formatted_end": "02:27:00.000",
      "text": "باید برداریم"
    },
    {
      "id": 31,
      "start": 8820.0,
      "end": 8822.0,
      "formatted_start": "02:27:00.000",
      "formatted_end": "02:27:02.000",
      "text": "باید برداریم"
    },
    {
      "id": 32,
      "start": 8822.0,
      "end": 8824.0,
      "formatted_start": "02:27:02.000",
      "formatted_end": "02:27:04.000",
      "text": "باید برداریم"
    },
    {
      "id": 33,
      "start": 8824.0,
      "end": 8826.0,
      "formatted_start": "02:27:04.000",
      "formatted_end": "02:27:06.000",
      "text": "باید برداریم"
    },
    {
      "id": 34,
      "start": 8826.0,
      "end": 8828.0,
      "formatted_start": "02:27:06.000",
      "formatted_end": "02:27:08.000",
      "text": "باید برداریم"
    },
    {
      "id": 35,
      "start": 8828.0,
      "end": 8830.0,
      "formatted_start": "02:27:08.000",
      "formatted_end": "02:27:10.000",
      "text": "باید برداریم"
    },
    {
      "id": 36,
      "start": 8830.0,
      "end": 8832.0,
      "formatted_start": "02:27:10.000",
      "formatted_end": "02:27:12.000",
      "text": "باید برداریم"
    },
    {
      "id": 37,
      "start": 8832.0,
      "end": 8834.0,
      "formatted_start": "02:27:12.000",
      "formatted_end": "02:27:14.000",
      "text": "باید برداریم"
    },
    {
      "id": 38,
      "start": 8834.0,
      "end": 8836.0,
      "formatted_start": "02:27:14.000",
      "formatted_end": "02:27:16.000",
      "text": "باید برداریم"
    },
    {
      "id": 39,
      "start": 8836.0,
      "end": 8838.0,
      "formatted_start": "02:27:16.000",
      "formatted_end": "02:27:18.000",
      "text": "باید برداریم"
    },
    {
      "id": 40,
      "start": 8838.0,
      "end": 8840.0,
      "formatted_start": "02:27:18.000",
      "formatted_end": "02:27:20.000",
      "text": "باید برداریم"
    },
    {
      "id": 41,
      "start": 8840.0,
      "end": 8842.0,
      "formatted_start": "02:27:20.000",
      "formatted_end": "02:27:22.000",
      "text": "باید برداریم"
    },
    {
      "id": 42,
      "start": 8842.0,
      "end": 8844.0,
      "formatted_start": "02:27:22.000",
      "formatted_end": "02:27:24.000",
      "text": "باید برداریم"
    },
    {
      "id": 43,
      "start": 8844.0,
      "end": 8846.0,
      "formatted_start": "02:27:24.000",
      "formatted_end": "02:27:26.000",
      "text": "شربت هیچی نداری؟"
    },
    {
      "id": 44,
      "start": 8846.0,
      "end": 8848.0,
      "formatted_start": "02:27:26.000",
      "formatted_end": "02:27:28.000",
      "text": "من هیچی ندارم"
    },
    {
      "id": 45,
      "start": 8848.0,
      "end": 8850.0,
      "formatted_start": "02:27:28.000",
      "formatted_end": "02:27:30.000",
      "text": "من عاده دارم"
    },
    {
      "id": 46,
      "start": 8850.0,
      "end": 8852.0,
      "formatted_start": "02:27:30.000",
      "formatted_end": "02:27:32.000",
      "text": "اینو بدونمه که بدون بردید"
    },
    {
      "id": 47,
      "start": 8852.0,
      "end": 8854.0,
      "formatted_start": "02:27:32.000",
      "formatted_end": "02:27:34.000",
      "text": "گریچه رو نامون تو نرزه چند؟"
    },
    {
      "id": 48,
      "start": 8854.0,
      "end": 8856.0,
      "formatted_start": "02:27:34.000",
      "formatted_end": "02:27:36.000",
      "text": "گریچه سرکاره نده"
    },
    {
      "id": 49,
      "start": 8856.0,
      "end": 8858.0,
      "formatted_start": "02:27:36.000",
      "formatted_end": "02:27:38.000",
      "text": "فعلا همین دو تا قلم نصره رو بده"
    },
    {
      "id": 50,
      "start": 8858.0,
      "end": 8860.0,
      "formatted_start": "02:27:38.000",
      "formatted_end": "02:27:40.000",
      "text": "با صداهایی که بودن"
    },
    {
      "id": 51,
      "start": 8860.0,
      "end": 8862.0,
      "formatted_start": "02:27:40.000",
      "formatted_end": "02:27:42.000",
      "text": "و رژیم خود با ماساج شکم"
    },
    {
      "id": 52,
      "start": 8862.0,
      "end": 8864.0,
      "formatted_start": "02:27:42.000",
      "formatted_end": "02:27:44.000",
      "text": "این آزمایش مکثور رو بده"
    },
    {
      "id": 53,
      "start": 8864.0,
      "end": 8866.0,
      "formatted_start": "02:27:44.000",
      "formatted_end": "02:27:46.000",
      "text": "من گناه رو که میدونم حتی هم نباید بدید"
    },
    {
      "id": 54,
      "start": 8866.0,
      "end": 8868.0,
      "formatted_start": "02:27:46.000",
      "formatted_end": "02:27:48.000",
      "text": "یا باید گیگوز بدی"
    },
    {
      "id": 55,
      "start": 8868.0,
      "end": 8870.0,
      "formatted_start": "02:27:48.000",
      "formatted_end": "02:27:50.000",
      "text": "یا آسترالیسی که از این دوتا"
    },
    {
      "id": 56,
      "start": 8870.0,
      "end": 8900.0,
      "formatted_start": "02:27:50.000",
      "formatted_end": "02:28:20.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 57,
      "start": 8900.0,
      "end": 8903.0,
      "formatted_start": "02:28:20.000",
      "formatted_end": "02:28:23.000",
      "text": "جوابش برای من بیا و بعد من بگم شیر شیر"
    },
    {
      "id": 58,
      "start": 8915.0,
      "end": 8918.0,
      "formatted_start": "02:28:35.000",
      "formatted_end": "02:28:38.000",
      "text": "صدا دلتو خوبی؟ خسته نباشی؟ ارحالش نباشی؟"
    },
    {
      "id": 59,
      "start": 8919.0,
      "end": 8922.0,
      "formatted_start": "02:28:39.000",
      "formatted_end": "02:28:42.000",
      "text": "چار دقیقه، پنج بگذاریم، از رو بگیرم"
    },
    {
      "id": 60,
      "start": 8922.0,
      "end": 8923.0,
      "formatted_start": "02:28:42.000",
      "formatted_end": "02:28:43.000",
      "text": "۲۷ روزشه"
    },
    {
      "id": 61,
      "start": 8924.0,
      "end": 8925.0,
      "formatted_start": "02:28:44.000",
      "formatted_end": "02:28:45.000",
      "text": "چی شده؟"
    },
    {
      "id": 62,
      "start": 8925.0,
      "end": 8927.0,
      "formatted_start": "02:28:45.000",
      "formatted_end": "02:28:47.000",
      "text": "این پلیفت آره"
    },
    {
      "id": 63,
      "start": 8927.0,
      "end": 8929.0,
      "formatted_start": "02:28:47.000",
      "formatted_end": "02:28:49.000",
      "text": "چی چی میخوره؟"
    },
    {
      "id": 64,
      "start": 8929.0,
      "end": 8931.0,
      "formatted_start": "02:28:49.000",
      "formatted_end": "02:28:51.000",
      "text": "شیر خودم که میخوره"
    },
    {
      "id": 65,
      "start": 8931.0,
      "end": 8933.0,
      "formatted_start": "02:28:51.000",
      "formatted_end": "02:28:53.000",
      "text": "بله خیلی زیر خوره"
    },
    {
      "id": 66,
      "start": 8933.0,
      "end": 8935.0,
      "formatted_start": "02:28:53.000",
      "formatted_end": "02:28:55.000",
      "text": "و کلوهن شیر هم خوشگرم میشه"
    },
    {
      "id": 67,
      "start": 8935.0,
      "end": 8937.0,
      "formatted_start": "02:28:55.000",
      "formatted_end": "02:28:57.000",
      "text": "وقتی این مادر"
    },
    {
      "id": 68,
      "start": 8937.0,
      "end": 8939.0,
      "formatted_start": "02:28:57.000",
      "formatted_end": "02:28:59.000",
      "text": "بس احساس مندم سیر میخوره"
    },
    {
      "id": 69,
      "start": 8939.0,
      "end": 8941.0,
      "formatted_start": "02:28:59.000",
      "formatted_end": "02:29:01.000",
      "text": "بس هم هفته"
    },
    {
      "id": 70,
      "start": 8941.0,
      "end": 8943.0,
      "formatted_start": "02:29:01.000",
      "formatted_end": "02:29:03.000",
      "text": "چی کار کنه؟"
    },
    {
      "id": 71,
      "start": 8943.0,
      "end": 8945.0,
      "formatted_start": "02:29:03.000",
      "formatted_end": "02:29:05.000",
      "text": "یه نقصه بده میام، اینجا کلون بیمارستان؟"
    },
    {
      "id": 72,
      "start": 8945.0,
      "end": 8947.0,
      "formatted_start": "02:29:05.000",
      "formatted_end": "02:29:07.000",
      "text": "برزویه"
    },
    {
      "id": 73,
      "start": 8947.0,
      "end": 8949.0,
      "formatted_start": "02:29:07.000",
      "formatted_end": "02:29:09.000",
      "text": "استفرا؟"
    },
    {
      "id": 74,
      "start": 8949.0,
      "end": 8951.0,
      "formatted_start": "02:29:09.000",
      "formatted_end": "02:29:11.000",
      "text": "استفرا از همون شیر خودمون میگه"
    },
    {
      "id": 75,
      "start": 8951.0,
      "end": 8953.0,
      "formatted_start": "02:29:11.000",
      "formatted_end": "02:29:13.000",
      "text": "خانه ماستی"
    },
    {
      "id": 76,
      "start": 8953.0,
      "end": 8983.0,
      "formatted_start": "02:29:13.000",
      "formatted_end": "02:29:43.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 77,
      "start": 8983.0,
      "end": 8985.0,
      "formatted_start": "02:29:43.000",
      "formatted_end": "02:29:45.000",
      "text": "از زردی بود و..."
    },
    {
      "id": 78,
      "start": 8985.0,
      "end": 8987.0,
      "formatted_start": "02:29:45.000",
      "formatted_end": "02:29:47.000",
      "text": "آسیجان بود"
    },
    {
      "id": 79,
      "start": 8987.0,
      "end": 8989.0,
      "formatted_start": "02:29:47.000",
      "formatted_end": "02:29:49.000",
      "text": "بعد تملو"
    },
    {
      "id": 80,
      "start": 8989.0,
      "end": 8991.0,
      "formatted_start": "02:29:49.000",
      "formatted_end": "02:29:51.000",
      "text": "تلویل ایسر و های برسی"
    },
    {
      "id": 81,
      "start": 8991.0,
      "end": 8994.0,
      "formatted_start": "02:29:51.000",
      "formatted_end": "02:29:54.000",
      "text": "ناله هم زاد وقتی متولد شد با ناله بود"
    },
    {
      "id": 82,
      "start": 8994.0,
      "end": 8996.0,
