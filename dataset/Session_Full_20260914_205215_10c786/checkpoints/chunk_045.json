  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13507.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:07.000",
      "text": "آقای بمشی این صدا بر میگرده، من میدونم. شما اون دفعه اومدن، نگاه کردن، رفتن، دوباره این صدا بر میگرده."
    },
    {
      "id": 1,
      "start": 13510.0,
      "end": 13514.0,
      "formatted_start": "03:45:10.000",
      "formatted_end": "03:45:14.000",
      "text": "بالا اینقدر صبح کلافه شدی، من از برخ کشیدم چون این..."
    },
    {
      "id": 2,
      "start": 13520.0,
      "end": 13525.0,
      "formatted_start": "03:45:20.000",
      "formatted_end": "03:45:25.000",
      "text": "خب همونو میگم، آره شای عالدینو میگم شما این نگاه بکنید دیگه."
    },
    {
      "id": 3,
      "start": 13530.0,
      "end": 13531.0,
      "formatted_start": "03:45:30.000",
      "formatted_end": "03:45:31.000",
      "text": "خوب"
    },
    {
      "id": 4,
      "start": 13535.0,
      "end": 13537.0,
      "formatted_start": "03:45:35.000",
      "formatted_end": "03:45:37.000",
      "text": "نمیدونم ولی من که خاموش"
    },
    {
      "id": 5,
      "start": 13537.0,
      "end": 13541.0,
      "formatted_start": "03:45:37.000",
      "formatted_end": "03:45:41.000",
      "text": "من که خاموش کردم چیزی نبود روش که بخواد بپره"
    },
    {
      "id": 6,
      "start": 13549.0,
      "end": 13552.0,
      "formatted_start": "03:45:49.000",
      "formatted_end": "03:45:52.000",
      "text": "یه صوتی هستش میدونم"
    },
    {
      "id": 7,
      "start": 13553.0,
      "end": 13555.0,
      "formatted_start": "03:45:53.000",
      "formatted_end": "03:45:55.000",
      "text": "باشه حالا من ببینم"
    },
    {
      "id": 8,
      "start": 13560.0,
      "end": 13568.4,
      "formatted_start": "03:46:00.000",
      "formatted_end": "03:46:08.400",
      "text": "باش باش دوباره شروط منت زنگ زن"
    },
    {
      "id": 9,
      "start": 13568.4,
      "end": 13585.2,
      "formatted_start": "03:46:08.400",
      "formatted_end": "03:46:25.200",
      "text": "نه آقای ممشی کسانتون به من گفت این برنجش باید عوض بشه یه همچیزی من یادم"
    },
    {
      "id": 10,
      "start": 13585.2,
      "end": 13590.88,
      "formatted_start": "03:46:25.200",
      "formatted_end": "03:46:30.880",
      "text": "باشه باشه باشه باشه باشه باشه باشه"
    },
    {
      "id": 11,
      "start": 13590.88,
      "end": 13593.26,
      "formatted_start": "03:46:30.880",
      "formatted_end": "03:46:33.260",
      "text": "من چقدر برازون تمنین کنم برای رفتار من"
    },
    {
      "id": 12,
      "start": 13593.26,
      "end": 13594.2,
      "formatted_start": "03:46:33.260",
      "formatted_end": "03:46:34.200",
      "text": "نه نه"
    },
    {
      "id": 13,
      "start": 13594.2,
      "end": 13596.3,
      "formatted_start": "03:46:34.200",
      "formatted_end": "03:46:36.300",
      "text": "دست کنن نه کنن"
    },
    {
      "id": 14,
      "start": 13596.3,
      "end": 13596.64,
      "formatted_start": "03:46:36.300",
      "formatted_end": "03:46:36.640",
      "text": "مرسی"
    },
    {
      "id": 15,
      "start": 13596.64,
      "end": 13597.68,
      "formatted_start": "03:46:36.640",
      "formatted_end": "03:46:37.680",
      "text": "مرسی"
    },
    {
      "id": 16,
      "start": 13615.2,
      "end": 13627.2,
      "formatted_start": "03:46:55.200",
      "formatted_end": "03:47:07.200",
      "text": "خب ببین پس قرار شده و روی زستگاه براش بده داروهای دلپیچه بده بده"
    },
    {
      "id": 17,
      "start": 13627.2,
      "end": 13631.2,
      "formatted_start": "03:47:07.200",
      "formatted_end": "03:47:11.200",
      "text": "صدای اینجوری میکنه اینشکار نداره قضون باید تنجره شوه"
    },
    {
      "id": 18,
      "start": 13631.2,
      "end": 13635.2,
      "formatted_start": "03:47:11.200",
      "formatted_end": "03:47:15.200",
      "text": "مینیش گرفته به خاطر اینکه شیر موقع خوابیدن شیر خوردن صافه"
    },
    {
      "id": 19,
      "start": 13635.2,
      "end": 13639.2,
      "formatted_start": "03:47:15.200",
      "formatted_end": "03:47:19.200",
      "text": "باید سرش بالا باشه شیر بر نگرده داری قطر اینی؟"
    },
    {
      "id": 20,
      "start": 13639.2,
      "end": 13641.2,
      "formatted_start": "03:47:19.200",
      "formatted_end": "03:47:21.200",
      "text": "نه اصلا این چی نداره خانواده"
    },
    {
      "id": 21,
      "start": 13641.2,
      "end": 13643.2,
      "formatted_start": "03:47:21.200",
      "formatted_end": "03:47:23.200",
      "text": "آدم که دارید"
    },
    {
      "id": 22,
      "start": 13643.2,
      "end": 13645.2,
      "formatted_start": "03:47:23.200",
      "formatted_end": "03:47:25.200",
      "text": "آدم"
    },
    {
      "id": 23,
      "start": 13645.2,
      "end": 13647.2,
      "formatted_start": "03:47:25.200",
      "formatted_end": "03:47:27.200",
      "text": "آدم"
    },
    {
      "id": 24,
      "start": 13647.2,
      "end": 13649.2,
      "formatted_start": "03:47:27.200",
      "formatted_end": "03:47:29.200",
      "text": "آدم"
    },
    {
      "id": 25,
      "start": 13649.2,
      "end": 13651.2,
      "formatted_start": "03:47:29.200",
      "formatted_end": "03:47:31.200",
      "text": "آدم"
    },
    {
      "id": 26,
      "start": 13651.2,
      "end": 13653.2,
      "formatted_start": "03:47:31.200",
      "formatted_end": "03:47:33.200",
      "text": "آدم"
    },
    {
      "id": 27,
      "start": 13653.2,
      "end": 13655.2,
      "formatted_start": "03:47:33.200",
      "formatted_end": "03:47:35.200",
      "text": "آدم"
    },
    {
      "id": 28,
      "start": 13655.2,
      "end": 13657.2,
      "formatted_start": "03:47:35.200",
      "formatted_end": "03:47:37.200",
      "text": "آدم"
    },
    {
      "id": 29,
      "start": 13657.2,
      "end": 13659.2,
      "formatted_start": "03:47:37.200",
      "formatted_end": "03:47:39.200",
      "text": "آدم"
    },
    {
      "id": 30,
      "start": 13659.2,
      "end": 13663.2,
      "formatted_start": "03:47:39.200",
      "formatted_end": "03:47:43.200",
      "text": "خب پس اولا اینکه آدم بده درست دستگاه بذار"
    },
    {
      "id": 31,
      "start": 13663.2,
      "end": 13667.2,
      "formatted_start": "03:47:43.200",
      "formatted_end": "03:47:47.200",
      "text": "داروید پیچر رو بعد ده رو بگیر شروع کن که من درشتم"
    },
    {
      "id": 32,
      "start": 13667.2,
      "end": 13669.72,
      "formatted_start": "03:47:47.200",
      "formatted_end": "03:47:49.720",
      "text": "یا دستی را به ماشین ها نبرد"
    },
    {
      "id": 33,
      "start": 13669.72,
      "end": 13672.56,
      "formatted_start": "03:47:49.720",
      "formatted_end": "03:47:52.560",
      "text": "بلی ما این مورد را موضع بشوش"
    },
    {
      "id": 34,
      "start": 13672.56,
      "end": 13674.76,
      "formatted_start": "03:47:52.560",
      "formatted_end": "03:47:54.760",
      "text": "مورد پازی از کتاب نیمی کنید"
    },
    {
      "id": 35,
      "start": 13674.76,
      "end": 13677.36,
      "formatted_start": "03:47:54.760",
      "formatted_end": "03:47:57.360",
      "text": "این همین را یک رو مونده"
    },
    {
      "id": 36,
      "start": 13677.36,
      "end": 13678.24,
      "formatted_start": "03:47:57.360",
      "formatted_end": "03:47:58.240",
      "text": "اگه خواستی بردید"
    },
    {
      "id": 37,
      "start": 13678.24,
      "end": 13680.96,
      "formatted_start": "03:47:58.240",
      "formatted_end": "03:48:00.960",
      "text": "از همین را برم"
    },
    {
      "id": 38,
      "start": 13680.96,
      "end": 13683.06,
      "formatted_start": "03:48:00.960",
      "formatted_end": "03:48:03.060",
      "text": "به نام دلمان دارید"
    },
    {
      "id": 39,
      "start": 13683.06,
      "end": 13683.52,
      "formatted_start": "03:48:03.060",
      "formatted_end": "03:48:03.520",
      "text": "بله"
    },
    {
      "id": 40,
      "start": 13683.52,
      "end": 13686.06,
      "formatted_start": "03:48:03.520",
      "formatted_end": "03:48:06.060",
      "text": "مفردشی میشه شده"
    },
    {
      "id": 41,
      "start": 13686.06,
      "end": 13687.38,
      "formatted_start": "03:48:06.060",
      "formatted_end": "03:48:07.380",
      "text": "مفردشی برم"
    },
    {
      "id": 42,
      "start": 13687.38,
      "end": 13691.56,
      "formatted_start": "03:48:07.380",
      "formatted_end": "03:48:11.560",
      "text": "از هر شهر آبزشتی میداره"
    },
    {
      "id": 43,
      "start": 13691.56,
      "end": 13693.14,
      "formatted_start": "03:48:11.560",
      "formatted_end": "03:48:13.140",
      "text": "آبزشتی میدی"
    },
    {
      "id": 44,
      "start": 13693.14,
      "end": 13694.64,
      "formatted_start": "03:48:13.140",
      "formatted_end": "03:48:14.640",
      "text": "از فریش هست دیگه"
    },
    {
      "id": 45,
      "start": 13694.64,
      "end": 13696.0,
      "formatted_start": "03:48:14.640",
      "formatted_end": "03:48:16.000",
      "text": "همین دیگه"
    },
    {
      "id": 46,
      "start": 13696.0,
      "end": 13697.28,
      "formatted_start": "03:48:16.000",
      "formatted_end": "03:48:17.280",
      "text": "صرف عجزه تا؟"
    },
    {
      "id": 47,
      "start": 13697.28,
      "end": 13699.28,
      "formatted_start": "03:48:17.280",
      "formatted_end": "03:48:19.280",
      "text": "صرفم کم، اونقدر دیگه بیست"
    },
    {
      "id": 48,
      "start": 13699.28,
      "end": 13704.76,
      "formatted_start": "03:48:19.280",
      "formatted_end": "03:48:24.760",
      "text": "کریمی، یه قطعه سودیوم پولورایی برای خانم آخشلی بنویست؟"
    },
    {
      "id": 49,
      "start": 13704.76,
      "end": 13707.24,
      "formatted_start": "03:48:24.760",
      "formatted_end": "03:48:27.240",
      "text": "آره، عجزه هم می کنم"
    },
    {
      "id": 50,
      "start": 13707.24,
      "end": 13709.48,
      "formatted_start": "03:48:27.240",
      "formatted_end": "03:48:29.480",
      "text": "عجزه هم می کنم، گرفتی؟ یه بینی چی؟"
    },
    {
      "id": 51,
      "start": 13709.48,
      "end": 13711.96,
      "formatted_start": "03:48:29.480",
      "formatted_end": "03:48:31.960",
      "text": "بیشتر آمریزه شد اینجا"
    },
    {
      "id": 52,
      "start": 13711.96,
      "end": 13714.28,
      "formatted_start": "03:48:31.960",
      "formatted_end": "03:48:34.280",
      "text": "ناایشه کردن، خوابش اینو عذیب نمی شد؟"
    },
    {
      "id": 53,
      "start": 13714.28,
      "end": 13715.52,
      "formatted_start": "03:48:34.280",
      "formatted_end": "03:48:35.520",
      "text": "آره، اونجوری چرا؟"
    },
    {
      "id": 54,
      "start": 13715.52,
      "end": 13718.12,
      "formatted_start": "03:48:35.520",
      "formatted_end": "03:48:38.120",
      "text": "که بسه عجزه که می زنه، یه بایی"
    },
    {
      "id": 55,
      "start": 13718.12,
      "end": 13720.76,
      "formatted_start": "03:48:38.120",
      "formatted_end": "03:48:40.760",
      "text": "خود را یه بیرون پریزه می کنه"
    },
    {
      "id": 56,
      "start": 13720.76,
      "end": 13723.76,
      "formatted_start": "03:48:40.760",
      "formatted_end": "03:48:43.760",
      "text": "چارمامونی بشه؟"
    },
    {
      "id": 57,
      "start": 13723.76,
      "end": 13725.76,
      "formatted_start": "03:48:43.760",
      "formatted_end": "03:48:45.760",
      "text": "نه، پنج مانیم"
    },
    {
      "id": 58,
      "start": 13725.76,
      "end": 13726.76,
      "formatted_start": "03:48:45.760",
      "formatted_end": "03:48:46.760",
      "text": "بره شیش؟"
    },
    {
      "id": 59,
      "start": 13726.76,
      "end": 13728.76,
      "formatted_start": "03:48:46.760",
      "formatted_end": "03:48:48.760",
      "text": "نه، نه، نه، چارمامونی بشه"
    },
    {
      "id": 60,
      "start": 13728.76,
      "end": 13730.76,
      "formatted_start": "03:48:48.760",
      "formatted_end": "03:48:50.760",
      "text": "آبتان، آبتان"
    },
    {
      "id": 61,
      "start": 13730.76,
      "end": 13732.76,
      "formatted_start": "03:48:50.760",
      "formatted_end": "03:48:52.760",
      "text": "چارمامون بیشتر بشه"
    },
    {
      "id": 62,
      "start": 13732.76,
      "end": 13734.76,
      "formatted_start": "03:48:52.760",
      "formatted_end": "03:48:54.760",
      "text": "نه، نه، برایت نشستی باید باشه"
    },
    {
      "id": 63,
      "start": 13734.76,
      "end": 13736.76,
      "formatted_start": "03:48:54.760",
      "formatted_end": "03:48:56.760",
      "text": "برای اون تکیه باشه"
    },
    {
      "id": 64,
      "start": 13736.76,
      "end": 13738.76,
      "formatted_start": "03:48:56.760",
      "formatted_end": "03:48:58.760",
      "text": "شب نداریم"
    },
    {
      "id": 65,
      "start": 13738.76,
      "end": 13740.76,
      "formatted_start": "03:48:58.760",
      "formatted_end": "03:49:00.760",
      "text": "شب نداریم"
    },
    {
      "id": 66,
      "start": 13740.76,
      "end": 13743.76,
      "formatted_start": "03:49:00.760",
      "formatted_end": "03:49:03.760",
      "text": "من بهش از پریشان استانویلاسن دادم بابا"
    },
    {
      "id": 67,
      "start": 13743.76,
      "end": 13744.76,
      "formatted_start": "03:49:03.760",
      "formatted_end": "03:49:04.760",
      "text": "نه، نه، نه"
    },
    {
      "id": 68,
      "start": 13744.76,
      "end": 13746.76,
      "formatted_start": "03:49:04.760",
      "formatted_end": "03:49:06.760",
      "text": "خودکارو هم نداریم"
    },
    {
      "id": 69,
      "start": 13746.76,
      "end": 13748.76,
      "formatted_start": "03:49:06.760",
      "formatted_end": "03:49:08.760",
      "text": "نه، نه، همینو بیشتر نداریم"
    },
    {
      "id": 70,
      "start": 13748.76,
      "end": 13778.76,
      "formatted_start": "03:49:08.760",
      "formatted_end": "03:49:38.760",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 71,
      "start": 13778.76,
      "end": 13780.76,
      "formatted_start": "03:49:38.760",
      "formatted_end": "03:49:40.760",
      "text": "دوست داشته باشون من مرگو"
    },
    {
      "id": 72,
      "start": 13780.76,
      "end": 13782.76,
      "formatted_start": "03:49:40.760",
      "formatted_end": "03:49:42.760",
      "text": "چای فری کچی بود"
    },
    {
      "id": 73,
      "start": 13782.76,
      "end": 13784.76,
      "formatted_start": "03:49:42.760",
      "formatted_end": "03:49:44.760",
      "text": "ازشو بیافتون"
    },
    {
      "id": 74,
      "start": 13784.76,
      "end": 13786.76,
      "formatted_start": "03:49:44.760",
      "formatted_end": "03:49:46.760",
      "text": "ببینیم برگ ندارم توی هفته"
    },
    {
      "id": 75,
      "start": 13786.76,
      "end": 13788.76,
      "formatted_start": "03:49:46.760",
      "formatted_end": "03:49:48.760",
      "text": "این شیر خوش که ای آر بهش بیدن"
    },
    {
      "id": 76,
      "start": 13788.76,
      "end": 13790.76,
      "formatted_start": "03:49:48.760",
      "formatted_end": "03:49:50.760",
      "text": "در اون پلیونیا چایی درست کنم با که"
    },
    {
      "id": 77,
      "start": 13790.76,
      "end": 13792.76,
      "formatted_start": "03:49:50.760",
      "formatted_end": "03:49:52.760",
      "text": "شیر خوشی با همون شیر خوشیش"
    },
    {
      "id": 78,
      "start": 13792.76,
      "end": 13794.76,
      "formatted_start": "03:49:52.760",
      "formatted_end": "03:49:54.760",
      "text": "اول آرده برنج و آب و بریت"
    },
    {
      "id": 79,
      "start": 13794.76,
      "end": 13796.76,
      "formatted_start": "03:49:54.760",
      "formatted_end": "03:49:56.760",
      "text": "چیشون هستن"
    },
    {
      "id": 80,
      "start": 13796.76,
      "end": 13798.76,
      "formatted_start": "03:49:56.760",
      "formatted_end": "03:49:58.760",
      "text": "به نواز هاشو ششتن"
    }
  ],
  "status": "completed"
}