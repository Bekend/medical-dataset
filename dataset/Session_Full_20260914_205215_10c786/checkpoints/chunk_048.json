  "stt_segments": [
    {
      "id": 0,
      "start": 14400.0,
      "end": 14402.0,
      "formatted_start": "04:00:00.000",
      "formatted_end": "04:00:02.000",
      "text": "از اینجا دیده؟"
    },
    {
      "id": 1,
      "start": 14402.0,
      "end": 14406.0,
      "formatted_start": "04:00:02.000",
      "formatted_end": "04:00:06.000",
      "text": "از اینجا از همه چی نخورده دیگه همش اینجوری می کنه، دیگه آقا نقل می کنه، اینجا شده."
    },
    {
      "id": 2,
      "start": 14406.0,
      "end": 14408.0,
      "formatted_start": "04:00:06.000",
      "formatted_end": "04:00:08.000",
      "text": "بلار می ده."
    },
    {
      "id": 3,
      "start": 14408.0,
      "end": 14410.0,
      "formatted_start": "04:00:08.000",
      "formatted_end": "04:00:10.000",
      "text": "بلار می ده شد، بعد از هیچی نخورده است."
    },
    {
      "id": 4,
      "start": 14410.0,
      "end": 14440.0,
      "formatted_start": "04:00:10.000",
      "formatted_end": "04:00:40.000",
      "text": "از اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که ا"
    },
    {
      "id": 5,
      "start": 14440.0,
      "end": 14443.0,
      "formatted_start": "04:00:40.000",
      "formatted_end": "04:00:43.000",
      "text": "من آزمایش رو براش میبینیم سندگی با آزمایشش بود"
    },
    {
      "id": 6,
      "start": 14443.0,
      "end": 14444.0,
      "formatted_start": "04:00:43.000",
      "formatted_end": "04:00:44.000",
      "text": "باش"
    },
    {
      "id": 7,
      "start": 14444.0,
      "end": 14448.0,
      "formatted_start": "04:00:44.000",
      "formatted_end": "04:00:48.000",
      "text": "یعنی هم آزمایش رو که باید میتونیم برش جمع بره یا ویتامین رو داشت میتونیم"
    },
    {
      "id": 8,
      "start": 14448.0,
      "end": 14449.0,
      "formatted_start": "04:00:48.000",
      "formatted_end": "04:00:49.000",
      "text": "باش"
    },
    {
      "id": 9,
      "start": 14450.0,
      "end": 14452.0,
      "formatted_start": "04:00:50.000",
      "formatted_end": "04:00:52.000",
      "text": "کجا بگم بهتر آزمایشش رو؟"
    },
    {
      "id": 10,
      "start": 14452.0,
      "end": 14454.0,
      "formatted_start": "04:00:52.000",
      "formatted_end": "04:00:54.000",
      "text": "من گویم توی خواهیمی باز کنم"
    },
    {
      "id": 11,
      "start": 14459.0,
      "end": 14462.0,
      "formatted_start": "04:00:59.000",
      "formatted_end": "04:01:02.000",
      "text": "خود آزمایشی هم که بایدن میگی همین"
    },
    {
      "id": 12,
      "start": 14462.0,
      "end": 14466.0,
      "formatted_start": "04:01:02.000",
      "formatted_end": "04:01:06.000",
      "text": "همین خود داروها و آزمایشش هم نزده"
    },
    {
      "id": 13,
      "start": 14466.0,
      "end": 14468.0,
      "formatted_start": "04:01:06.000",
      "formatted_end": "04:01:08.000",
      "text": "باش، پس این رو گو نتونیم"
    },
    {
      "id": 14,
      "start": 14468.0,
      "end": 14498.0,
      "formatted_start": "04:01:08.000",
      "formatted_end": "04:01:38.000",
      "text": "باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینک"
    },
    {
      "id": 15,
      "start": 14498.0,
      "end": 14518.0,
      "formatted_start": "04:01:38.000",
      "formatted_end": "04:01:58.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 14518.0,
      "end": 14547.98,
      "formatted_start": "04:01:58.000",
      "formatted_end": "04:02:27.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 17,
