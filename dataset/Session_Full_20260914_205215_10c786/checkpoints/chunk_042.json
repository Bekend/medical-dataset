      "end": 12604.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:04.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 1,
      "start": 12604.0,
      "end": 12608.0,
      "formatted_start": "03:30:04.000",
      "formatted_end": "03:30:08.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 2,
      "start": 12608.0,
      "end": 12612.0,
      "formatted_start": "03:30:08.000",
      "formatted_end": "03:30:12.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 3,
      "start": 12612.0,
      "end": 12616.0,
      "formatted_start": "03:30:12.000",
      "formatted_end": "03:30:16.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 4,
      "start": 12616.0,
      "end": 12620.0,
      "formatted_start": "03:30:16.000",
      "formatted_end": "03:30:20.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 5,
      "start": 12620.0,
      "end": 12624.0,
      "formatted_start": "03:30:20.000",
      "formatted_end": "03:30:24.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 6,
      "start": 12624.0,
      "end": 12628.0,
      "formatted_start": "03:30:24.000",
      "formatted_end": "03:30:28.000",
      "text": "آزمایش رو در مطب پزشکی دارید."
    },
    {
      "id": 7,
      "start": 12628.0,
      "end": 12631.0,
      "formatted_start": "03:30:28.000",
      "formatted_end": "03:30:31.000",
      "text": "آره، آره، خیلی خوب باشه"
    },
    {
      "id": 8,
      "start": 12631.0,
      "end": 12633.0,
      "formatted_start": "03:30:31.000",
      "formatted_end": "03:30:33.000",
      "text": "داری خود اینه الان دیگه؟"
    },
    {
      "id": 9,
      "start": 12633.0,
      "end": 12636.0,
      "formatted_start": "03:30:33.000",
      "formatted_end": "03:30:36.000",
      "text": "آره، آره، خیلی خوب باشه"
    },
    {
      "id": 10,
      "start": 12639.0,
      "end": 12642.0,
      "formatted_start": "03:30:39.000",
      "formatted_end": "03:30:42.000",
      "text": "تبش مرادار یکی دونست که چند ساعت نمی کشه"
    },
    {
      "id": 11,
      "start": 12642.0,
      "end": 12644.0,
      "formatted_start": "03:30:42.000",
      "formatted_end": "03:30:44.000",
      "text": "می دونم دوباره در میشه"
    },
    {
      "id": 12,
      "start": 12644.0,
      "end": 12646.0,
      "formatted_start": "03:30:44.000",
      "formatted_end": "03:30:46.000",
      "text": "اما اون سامنه هفته صبحش استقرار کنم"
    },
    {
      "id": 13,
      "start": 12646.0,
      "end": 12648.0,
      "formatted_start": "03:30:46.000",
      "formatted_end": "03:30:48.000",
      "text": "ساعت ده کنم تبش ۳۸ه"
    },
    {
      "id": 14,
      "start": 12648.0,
      "end": 12650.0,
      "formatted_start": "03:30:48.000",
      "formatted_end": "03:30:50.000",
      "text": "دوباره مجبور شدن بهش استقرار کنم"
    },
    {
      "id": 15,
      "start": 12650.0,
      "end": 12651.0,
      "formatted_start": "03:30:50.000",
      "formatted_end": "03:30:51.000",
      "text": "دارم"
    },
    {
      "id": 16,
      "start": 12651.0,
      "end": 12653.0,
      "formatted_start": "03:30:51.000",
      "formatted_end": "03:30:53.000",
      "text": "می دونی تا وقتی که سفکسیم شروع نکنیم"
    },
    {
      "id": 17,
      "start": 12653.0,
      "end": 12655.0,
      "formatted_start": "03:30:53.000",
      "formatted_end": "03:30:55.000",
      "text": "و سفکسی ما چهره هر ساعت دیدانه ندی"
    },
    {
      "id": 18,
      "start": 12655.0,
      "end": 12660.0,
      "formatted_start": "03:30:55.000",
      "formatted_end": "03:31:00.000",
      "text": "تفشی ختم شد. تفنه با اصلاحی هم وقتیم شد. برای برمی گرده."
    },
    {
      "id": 19,
      "start": 12660.0,
      "end": 12665.0,
      "formatted_start": "03:31:00.000",
      "formatted_end": "03:31:05.000",
      "text": "یک دو سپکسیم لازم داره. حالا اما از درخواست من خودم داخل سرون کشون سپکیزوکسیم میگذرم."
    },
    {
      "id": 20,
      "start": 12665.0,
      "end": 12669.0,
      "formatted_start": "03:31:05.000",
      "formatted_end": "03:31:09.000",
      "text": "مترو برای اصاله کشیده است. اصلاحی ندیگه اونجورد شده. نه."
    },
    {
      "id": 21,
      "start": 12669.0,
      "end": 12677.0,
      "formatted_start": "03:31:09.000",
      "formatted_end": "03:31:17.000",
      "text": "سپکسیم باید بدید. پودر بایویتا. هیر پرد ریز هاوین آر با ریستیت آوین زیر."
    },
    {
      "id": 22,
      "start": 12677.0,
      "end": 12679.0,
      "formatted_start": "03:31:17.000",
      "formatted_end": "03:31:19.000",
      "text": "از این را نداریشون را نداریشون"
    },
    {
      "id": 23,
      "start": 12679.0,
      "end": 12681.0,
      "formatted_start": "03:31:19.000",
      "formatted_end": "03:31:21.000",
      "text": "درسته باش"
    },
    {
      "id": 24,
      "start": 12681.0,
      "end": 12683.0,
      "formatted_start": "03:31:21.000",
      "formatted_end": "03:31:23.000",
      "text": "و اگر نیازه که سرون بازش بلیگرم"
    },
    {
      "id": 25,
      "start": 12683.0,
      "end": 12685.0,
      "formatted_start": "03:31:23.000",
      "formatted_end": "03:31:25.000",
      "text": "نه نیاز نیستش بلیگرم"
    },
    {
      "id": 26,
      "start": 12685.0,
      "end": 12687.0,
      "formatted_start": "03:31:25.000",
      "formatted_end": "03:31:27.000",
      "text": "که ازش خودی میگردن"
    },
    {
      "id": 27,
      "start": 12687.0,
      "end": 12689.0,
      "formatted_start": "03:31:27.000",
      "formatted_end": "03:31:29.000",
      "text": "و از بدنش تر شده خود به صورت میومد"
    },
    {
      "id": 28,
      "start": 12689.0,
      "end": 12691.0,
      "formatted_start": "03:31:29.000",
      "formatted_end": "03:31:31.000",
      "text": "از صبح چند باشی کمش کار کردن؟"
    },
    {
      "id": 29,
      "start": 12691.0,
      "end": 12693.0,
      "formatted_start": "03:31:31.000",
      "formatted_end": "03:31:33.000",
      "text": "از صبح یک بار کار کردن"
    },
    {
      "id": 30,
      "start": 12693.0,
      "end": 12695.0,
      "formatted_start": "03:31:33.000",
      "formatted_end": "03:31:35.000",
      "text": "مایی آن چیزو پرده؟"
    },
    {
      "id": 31,
      "start": 12695.0,
      "end": 12697.0,
      "formatted_start": "03:31:35.000",
      "formatted_end": "03:31:37.000",
      "text": "بسیار نیست"
    },
    {
      "id": 32,
      "start": 12697.0,
      "end": 12699.0,
      "formatted_start": "03:31:37.000",
      "formatted_end": "03:31:39.000",
      "text": "اگر تمامی راشوشی بزنیم"
    },
    {
      "id": 33,
      "start": 12699.0,
      "end": 12701.0,
      "formatted_start": "03:31:39.000",
      "formatted_end": "03:31:41.000",
      "text": "ما مشکل ندارم"
    },
    {
      "id": 34,
      "start": 12701.0,
      "end": 12703.0,
      "formatted_start": "03:31:41.000",
      "formatted_end": "03:31:43.000",
      "text": "اگر گرد روزو بزنیم"
    },
    {
      "id": 35,
      "start": 12703.0,
      "end": 12709.0,
      "formatted_start": "03:31:43.000",
      "formatted_end": "03:31:49.000",
      "text": "بعد همه بچه هایی جویی هستن یعنی ولی از که بشن تب میکنن مدفوع شما جویی میشه؟"
    },
    {
      "id": 36,
      "start": 12709.0,
      "end": 12713.0,
      "formatted_start": "03:31:49.000",
      "formatted_end": "03:31:53.000",
      "text": "آره مدفوع که قبامش با هر ویروسی تغییر میکنه"
    },
    {
      "id": 37,
      "start": 12713.0,
      "end": 12717.0,
      "formatted_start": "03:31:53.000",
      "formatted_end": "03:31:57.000",
      "text": "بچه سال ما یه روی میبینی اصلا از این حیات رو بیار رو میشه"
    },
    {
      "id": 38,
      "start": 12717.0,
      "end": 12721.0,
      "formatted_start": "03:31:57.000",
      "formatted_end": "03:32:01.000",
      "text": "اجواب هستن کم کم به شاهره نمیدونه تو بچه ها چی جوییه؟"
    },
    {
      "id": 39,
      "start": 12721.0,
      "end": 12725.0,
      "formatted_start": "03:32:01.000",
      "formatted_end": "03:32:05.000",
      "text": "نه تو بچه ها نگهانیه"
    },
    {
      "id": 40,
      "start": 12725.0,
      "end": 12730.0,
      "formatted_start": "03:32:05.000",
      "formatted_end": "03:32:10.000",
      "text": "حرکت روده کم و زیاده شه رنگ مدفوع و غزتش و قبامش تغییر میکنه"
    },
    {
      "id": 41,
      "start": 12730.0,
      "end": 12745.0,
      "formatted_start": "03:32:10.000",
      "formatted_end": "03:32:25.000",
      "text": "چون بچه ها داداش هم هستند، چهار تا پچی دارند، ولی بیشتر بیشتر را رعایت می کنید، متاسفانه بیشتر هم ندید بیشتر."
    },
    {
      "id": 42,
      "start": 12745.0,
      "end": 12754.0,
      "formatted_start": "03:32:25.000",
      "formatted_end": "03:32:34.000",
      "text": "شاید همین به خاطر رعایت هستش، یک نظریه هست که بچه های مقابل بیشتر با مونیت آمیده سر و کار دارند."
    },
    {
      "id": 43,
      "start": 12754.0,
      "end": 12756.0,
      "formatted_start": "03:32:34.000",
      "formatted_end": "03:32:36.000",
      "text": "درست داریم"
    },
    {
      "id": 44,
      "start": 12756.0,
      "end": 12760.0,
      "formatted_start": "03:32:36.000",
      "formatted_end": "03:32:40.000",
      "text": "من کانترین با ایلدار توییسته و این ساعت های آنگیزه"
    },
    {
      "id": 45,
      "start": 12760.0,
      "end": 12767.0,
      "formatted_start": "03:32:40.000",
      "formatted_end": "03:32:47.000",
      "text": "ممکنه چرا؟ پرشواست دهانی از آشو و لیپان و بشا و دست و اینا آیده منتقل میشه"
    },
    {
      "id": 46,
      "start": 12770.0,
      "end": 12772.0,
      "formatted_start": "03:32:50.000",
      "formatted_end": "03:32:52.000",
      "text": "همینکه این تبرد دادیم؟"
    },
    {
      "id": 47,
      "start": 12772.0,
      "end": 12773.0,
      "formatted_start": "03:32:52.000",
      "formatted_end": "03:32:53.000",
      "text": "ساعت درست داریم"
    },
    {
      "id": 48,
      "start": 12773.0,
      "end": 12774.0,
      "formatted_start": "03:32:53.000",
      "formatted_end": "03:32:54.000",
      "text": "الان تبردشتیم"
    },
    {
      "id": 49,
      "start": 12774.0,
      "end": 12775.0,
      "formatted_start": "03:32:54.000",
      "formatted_end": "03:32:55.000",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 12775.0,
      "end": 12778.0,
      "formatted_start": "03:32:55.000",
      "formatted_end": "03:32:58.000",
      "text": "پس من تبرد داخل سرون نمیخواستم، آنتیویتیک باقی میگذارم"
    },
    {
      "id": 51,
      "start": 12781.0,
      "end": 12782.0,
      "formatted_start": "03:33:01.000",
      "formatted_end": "03:33:02.000",
      "text": "که یه؟"
    },
    {
      "id": 52,
      "start": 12782.0,
      "end": 12788.0,
      "formatted_start": "03:33:02.000",
      "formatted_end": "03:33:08.000",
      "text": "ولی پودرا رو تو ماستر کن بهش بده فیلن شیر نیجات هم نخوره اصلا"
    },
    {
      "id": 53,
      "start": 12788.0,
      "end": 12792.0,
      "formatted_start": "03:33:08.000",
      "formatted_end": "03:33:12.000",
      "text": "حتی طبیعی مثل این که قدیم یاد بودن چای نبات رو اینا خوابن"
    },
    {
      "id": 54,
      "start": 12792.0,
      "end": 12794.0,
      "formatted_start": "03:33:12.000",
      "formatted_end": "03:33:14.000",
      "text": "اینو ولی اصلا بله دیگه دوستان"
    },
    {
      "id": 55,
      "start": 12794.0,
      "end": 12800.0,
      "formatted_start": "03:33:14.000",
      "formatted_end": "03:33:20.000",
      "text": "چای نبات، گرما، اصلا، نیوه، حتی بیسکویت و چیز شیرین کلا فیلن نخوره"
    },
    {
      "id": 56,
      "start": 12800.0,
      "end": 12803.0,
      "formatted_start": "03:33:20.000",
      "formatted_end": "03:33:23.000",
      "text": "کت ماست و سوپ و دوغ و آب و اینا اشکالن"
    },
    {
      "id": 57,
      "start": 12808.0,
      "end": 12810.0,
      "formatted_start": "03:33:28.000",
      "formatted_end": "03:33:30.000",
      "text": "حالا دروارو او زدن که نداره نه؟"
    },
    {
      "id": 58,
      "start": 12810.0,
      "end": 12816.0,
      "formatted_start": "03:33:30.000",
      "formatted_end": "03:33:36.000",
      "text": "فقط دلچه داره که خودشو به روی کمر میدازه و با سنشینه رو میده بالا به خودش پیچ میکاره"
    },
    {
      "id": 59,
      "start": 12817.0,
      "end": 12820.0,
      "formatted_start": "03:33:37.000",
      "formatted_end": "03:33:40.000",
      "text": "یعنی اون میبینم خودشو به پشت میدازه"
    },
    {
      "id": 60,
      "start": 12834.0,
      "end": 12835.0,
      "formatted_start": "03:33:54.000",
      "formatted_end": "03:33:55.000",
      "text": "گره"
    },
    {
      "id": 61,
      "start": 12836.0,
      "end": 12837.0,
      "formatted_start": "03:33:56.000",
      "formatted_end": "03:33:57.000",
      "text": "گره"
    },
    {
      "id": 62,
      "start": 12840.0,
      "end": 12870.0,
      "formatted_start": "03:34:00.000",
      "formatted_end": "03:34:30.000",
      "text": "برای که اینکه باید بردارید، باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید ک"
    },
    {
      "id": 63,
      "start": 12870.0,
      "end": 12873.0,
      "formatted_start": "03:34:30.000",
      "formatted_end": "03:34:33.000",
      "text": "اما گردن زیبا و شکن بیشتر اصلا داخل میشه"
    },
    {
      "id": 64,
      "start": 12874.0,
      "end": 12876.0,
      "formatted_start": "03:34:34.000",
      "formatted_end": "03:34:36.000",
      "text": "او اسپانه"
    },
    {
      "id": 65,
      "start": 12876.0,
      "end": 12878.0,
      "formatted_start": "03:34:36.000",
      "formatted_end": "03:34:38.000",
      "text": "اسپانه دوره از گیش شده"
    },
    {
      "id": 66,
      "start": 12878.0,
      "end": 12880.0,
      "formatted_start": "03:34:38.000",
      "formatted_end": "03:34:40.000",
      "text": "از دوستانه بچه هایی"
    },
    {
      "id": 67,
      "start": 12880.0,
      "end": 12882.0,
      "formatted_start": "03:34:40.000",
      "formatted_end": "03:34:42.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 68,
      "start": 12882.0,
      "end": 12884.0,
      "formatted_start": "03:34:42.000",
      "formatted_end": "03:34:44.000",
      "text": "و..."
    },
    {
      "id": 69,
      "start": 12884.0,
      "end": 12886.0,
      "formatted_start": "03:34:44.000",
      "formatted_end": "03:34:46.000",
      "text": "زیبا"
    },
    {
      "id": 70,
      "start": 12886.0,
      "end": 12888.0,
      "formatted_start": "03:34:46.000",
      "formatted_end": "03:34:48.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 71,
      "start": 12888.0,
      "end": 12890.0,
      "formatted_start": "03:34:48.000",
      "formatted_end": "03:34:50.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 72,
      "start": 12890.0,
      "end": 12892.0,
      "formatted_start": "03:34:50.000",
      "formatted_end": "03:34:52.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 73,
      "start": 12892.0,
      "end": 12894.0,
      "formatted_start": "03:34:52.000",
      "formatted_end": "03:34:54.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 74,
      "start": 12894.0,
      "end": 12896.0,
      "formatted_start": "03:34:54.000",
      "formatted_end": "03:34:56.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 75,
      "start": 12896.0,
      "end": 12898.0,
      "formatted_start": "03:34:56.000",
      "formatted_end": "03:34:58.000",
      "text": "او دوستانه بچه هایی"
    },
    {
      "id": 76,
      "start": 12898.0,
      "end": 12900.0,
      "formatted_start": "03:34:58.000",
      "formatted_end": "03:35:00.000",
      "text": "برای اینجا"
    }
  ],
  "status": "completed"
}