  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12308.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:08.000",
      "text": "من نمیدونم با که حرف سادم که یه شمارهی به من داد، من زنگ زدم و گفتش که ایکی بره من میرم."
    },
    {
      "id": 1,
      "start": 12308.0,
      "end": 12312.0,
      "formatted_start": "03:25:08.000",
      "formatted_end": "03:25:12.000",
      "text": "گفتم باشه بیدار منو نیم ساعت اونجا نشسته، هرشیم در اینجا همش خالص."
    },
    {
      "id": 2,
      "start": 12312.0,
      "end": 12314.0,
      "formatted_start": "03:25:12.000",
      "formatted_end": "03:25:14.000",
      "text": "الان با آقای ممشکی خریده دارم."
    },
    {
      "id": 3,
      "start": 12314.0,
      "end": 12320.0,
      "formatted_start": "03:25:14.000",
      "formatted_end": "03:25:20.000",
      "text": "پس شما آدرس ما برای آقای ممشکی فرست دادم."
    },
    {
      "id": 4,
      "start": 12320.0,
      "end": 12326.0,
      "formatted_start": "03:25:20.000",
      "formatted_end": "03:25:26.000",
      "text": "ما گرباندان شویم بابا، از این حالا میخواد بره از خونوی ما، یک ساعت نشسته، کهی میتونیم برسیم؟"
    },
    {
      "id": 5,
      "start": 12326.0,
      "end": 12341.28,
      "formatted_start": "03:25:26.000",
      "formatted_end": "03:25:41.280",
      "text": "میدونم متوجه شدم خب الان متوجه شدم الان مشکل اینجا اینه که با اون کسی که من با شما هنگ کردم آقای منشه عوضش کرده اتوارم من نمیدونم با که عوض صحبت کردم"
    },
    {
      "id": 6,
      "start": 12341.28,
      "end": 12342.2,
      "formatted_start": "03:25:41.280",
      "formatted_end": "03:25:42.200",
      "text": "الان شما"
    },
    {
      "id": 7,
      "start": 12342.2,
      "end": 12345.68,
      "formatted_start": "03:25:42.200",
      "formatted_end": "03:25:45.680",
      "text": "مرسی مشکل"
    },
    {
      "id": 8,
      "start": 12356.0,
      "end": 12386.0,
      "formatted_start": "03:25:56.000",
      "formatted_end": "03:26:26.000",
      "text": "مرد در اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با این"
    },
    {
      "id": 9,
      "start": 12386.0,
      "end": 12395.0,
      "formatted_start": "03:26:26.000",
      "formatted_end": "03:26:35.000",
      "text": "الو؟ الو آقای ممشکی برنامه چیه؟ این آقا که اصلا میده من در جریان هیچی نیستم. اون یکی جواب نمیده."
    },
    {
      "id": 10,
      "start": 12395.0,
      "end": 12403.0,
      "formatted_start": "03:26:35.000",
      "formatted_end": "03:26:43.000",
      "text": "خب اینو الو میگه من نمیتونم بیام که الو من در دسترس نمیتونم که پدر من الو میره دیگه باش."
    },
    {
      "id": 11,
      "start": 12403.0,
      "end": 12406.0,
      "formatted_start": "03:26:43.000",
      "formatted_end": "03:26:46.000",
      "text": "برای امروز دیگه تمام شد دیگه."
    },
    {
      "id": 12,
      "start": 12406.0,
      "end": 12429.0,
      "formatted_start": "03:26:46.000",
      "formatted_end": "03:27:09.000",
      "text": "خبر که من این تلفونی که به من زد 903 بود. 903 بود در من ده بار گرفتم وسط مریضه آمد. تو متبم شروع شروع آقای مرشدی میدونه. شماره... نمیدونم بعد این چی کار کنم. یه شماره دیگه بده این آقای که الان دیگه خراب دیگه منسط در جریان نیستم دیگه نمیدونم چی به چی."
    },
    {
      "id": 13,
      "start": 12429.0,
      "end": 12434.0,
      "formatted_start": "03:27:09.000",
      "formatted_end": "03:27:14.000",
      "text": "اران چه پار کنم؟"
    },
    {
      "id": 14,
      "start": 12434.0,
      "end": 12438.0,
      "formatted_start": "03:27:14.000",
      "formatted_end": "03:27:18.000",
      "text": "اران بیرید؟"
    },
    {
      "id": 15,
      "start": 12438.0,
      "end": 12442.0,
      "formatted_start": "03:27:18.000",
      "formatted_end": "03:27:22.000",
      "text": "تصمیم شو آدرسی که بهتون دادمه دیگه"
    },
    {
      "id": 16,
      "start": 12459.0,
      "end": 12487.0,
      "formatted_start": "03:27:39.000",
      "formatted_end": "03:28:07.000",
      "text": "موسیقی"
    },
    {
      "id": 17,
      "start": 12487.0,
      "end": 12491.76,
      "formatted_start": "03:28:07.000",
      "formatted_end": "03:28:11.760",
      "text": "حالا تا ده دقیقه دیگه نیموند بابایی به این زنگ بزنه همین آبایی میاد"
    },
    {
      "id": 18,
      "start": 12517.0,
      "end": 12519.0,
      "formatted_start": "03:28:37.000",
      "formatted_end": "03:28:39.000",
      "text": "کلیمی ترونده را بردیم"
    },
    {
      "id": 19,
      "start": 12547.0,
      "end": 12550.28,
      "formatted_start": "03:29:07.000",
      "formatted_end": "03:29:10.280",
      "text": "اینجا چهار ساعت به چهار ساعت می رویستم و دیگه همه چهار ساعت گره"
    },
    {
      "id": 20,
      "start": 12550.28,
      "end": 12553.88,
      "formatted_start": "03:29:10.280",
      "formatted_end": "03:29:13.880",
      "text": "دیگه پیشت مجموع شدم و اجازه اصلا دوازده بردمش"
    },
    {
      "id": 21,
      "start": 12553.88,
      "end": 12556.28,
      "formatted_start": "03:29:13.880",
      "formatted_end": "03:29:16.280",
      "text": "و دیگه همه سراندانه باستش کردم"
    },
    {
      "id": 22,
      "start": 12556.28,
      "end": 12558.28,
      "formatted_start": "03:29:16.280",
      "formatted_end": "03:29:18.280",
      "text": "اینجا اون کار روشتره بردم؟"
    },
    {
      "id": 23,
      "start": 12558.28,
      "end": 12559.28,
      "formatted_start": "03:29:18.280",
      "formatted_end": "03:29:19.280",
      "text": "آره"
    },
    {
      "id": 24,
      "start": 12559.28,
      "end": 12561.28,
      "formatted_start": "03:29:19.280",
      "formatted_end": "03:29:21.280",
      "text": "اون روشتره بردم؟"
    },
    {
      "id": 25,
      "start": 12561.28,
      "end": 12563.28,
      "formatted_start": "03:29:21.280",
      "formatted_end": "03:29:23.280",
      "text": "آره اینو تصویباتی بود"
    },
    {
      "id": 26,
      "start": 12563.28,
      "end": 12565.28,
      "formatted_start": "03:29:23.280",
      "formatted_end": "03:29:25.280",
      "text": "اینو شرکت شده بردم"
    },
    {
      "id": 27,
      "start": 12565.28,
      "end": 12567.28,
      "formatted_start": "03:29:25.280",
      "formatted_end": "03:29:27.280",
      "text": "آره اینو شرکت شده بردم"
    },
    {
      "id": 28,
      "start": 12567.28,
      "end": 12569.28,
      "formatted_start": "03:29:27.280",
      "formatted_end": "03:29:29.280",
      "text": "نه دست نیست بردم"
    },
    {
      "id": 29,
      "start": 12569.28,
      "end": 12571.28,
      "formatted_start": "03:29:29.280",
      "formatted_end": "03:29:31.280",
      "text": "اون روشتره بردم ایچون در اینجا"
    },
    {
      "id": 30,
      "start": 12571.28,
      "end": 12578.28,
      "formatted_start": "03:29:31.280",
      "formatted_end": "03:29:38.280",
      "text": "ولی خب همش مقابل نمیشه، همش هم بازم همونجوریه ولی اینسا از حجم زیاد برام به حجم کم رسیدن"
    },
    {
      "id": 31,
      "start": 12578.28,
      "end": 12581.28,
      "formatted_start": "03:29:38.280",
      "formatted_end": "03:29:41.280",
      "text": "همه از در چانی دیگه هست"
    },
    {
      "id": 32,
      "start": 12581.28,
      "end": 12583.28,
      "formatted_start": "03:29:41.280",
      "formatted_end": "03:29:43.280",
      "text": "از این صورت همه دیگه هست"
    },
    {
      "id": 33,
      "start": 12583.28,
      "end": 12585.28,
      "formatted_start": "03:29:43.280",
      "formatted_end": "03:29:45.280",
      "text": "از این صورت همه دیگه هست"
    },
    {
      "id": 34,
      "start": 12585.28,
      "end": 12586.28,
      "formatted_start": "03:29:45.280",
      "formatted_end": "03:29:46.280",
      "text": "نه"
    },
    {
      "id": 35,
      "start": 12588.28,
      "end": 12595.28,
      "formatted_start": "03:29:48.280",
      "formatted_end": "03:29:55.280",
      "text": "اما دیگه باید بهش شام میدادن، غذاشو که میخو آب که بهش میدادن به گریه میشاد خورده کنن"
    },
    {
      "id": 36,
      "start": 12595.28,
      "end": 12597.28,
      "formatted_start": "03:29:55.280",
      "formatted_end": "03:29:57.280",
      "text": "بلش درد میشد"
    }
  ],
  "status": "completed"
}