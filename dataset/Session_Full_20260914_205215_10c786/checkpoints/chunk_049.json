    },
    {
      "id": 26,
      "start": 14805.54,
      "end": 14807.54,
      "formatted_start": "04:06:45.540",
      "formatted_end": "04:06:47.540",
      "text": "از اینکه بردارید"
    },
    {
      "id": 27,
      "start": 14807.54,
      "end": 14837.54,
      "formatted_start": "04:06:47.540",
      "formatted_end": "04:07:17.540",
      "text": "این کار را برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برای شما برا"
    },
    {
      "id": 28,
      "start": 14837.54,
      "end": 14867.52,
      "formatted_start": "04:07:17.540",
      "formatted_end": "04:07:47.520",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 29,
      "start": 14867.54,
      "end": 14885.54,
      "formatted_start": "04:07:47.540",
      "formatted_end": "04:08:05.540",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 14885.54,
      "end": 14887.54,
      "formatted_start": "04:08:05.540",
      "formatted_end": "04:08:07.540",
      "text": "کریمی"
    },
    {
      "id": 31,
      "start": 14907.54,
      "end": 14910.54,
      "formatted_start": "04:08:27.540",
      "formatted_end": "04:08:30.540",
      "text": "همدو تا این اسکندردی میگه بخور شب کن برام شب کنم"
    },
    {
      "id": 32,
      "start": 14910.54,
      "end": 14911.54,
      "formatted_start": "04:08:30.540",
      "formatted_end": "04:08:31.540",
      "text": "ها؟"
    },
    {
      "id": 33,
      "start": 14911.54,
      "end": 14912.54,
      "formatted_start": "04:08:31.540",
      "formatted_end": "04:08:32.540",
      "text": "اسکندردی"
    },
    {
      "id": 34,
      "start": 14912.54,
      "end": 14913.54,
      "formatted_start": "04:08:32.540",
      "formatted_end": "04:08:33.540",
      "text": "اسکندردی؟"
    },
    {
      "id": 35,
      "start": 14913.54,
      "end": 14914.54,
      "formatted_start": "04:08:33.540",
      "formatted_end": "04:08:34.540",
      "text": "آره شب"
    },
    {
      "id": 36,
      "start": 14915.54,
      "end": 14921.54,
      "formatted_start": "04:08:35.540",
      "formatted_end": "04:08:41.540",
      "text": "برنامه از اینجوری هست."
    },
    {
      "id": 37,
      "start": 14921.54,
      "end": 14927.54,
      "formatted_start": "04:08:41.540",
      "formatted_end": "04:08:47.540",
      "text": "20 تا براش داریم."
    },
    {
      "id": 38,
      "start": 14927.54,
      "end": 14931.54,
      "formatted_start": "04:08:47.540",
      "formatted_end": "04:08:51.540",
      "text": "20 تا زیاده. 10 تا."
    },
    {
      "id": 39,
      "start": 14931.54,
      "end": 14937.54,
      "formatted_start": "04:08:51.540",
      "formatted_end": "04:08:57.540",
      "text": "دیگه دستش رو بدل شما بیاد دادی."
    },
    {
      "id": 40,
      "start": 14937.54,
      "end": 14941.54,
      "formatted_start": "04:08:57.540",
      "formatted_end": "04:09:01.540",
      "text": "20 تا داره."
    },
    {
      "id": 41,
      "start": 14941.54,
      "end": 14944.04,
      "formatted_start": "04:09:01.540",
      "formatted_end": "04:09:04.040",
      "text": "آرامش من الان خودش گفته زیاد نوشتیم"
    },
    {
      "id": 42,
      "start": 14944.04,
      "end": 14947.54,
      "formatted_start": "04:09:04.040",
      "formatted_end": "04:09:07.540",
      "text": "نوشتم الان خیلی زیاد نوشتیم"
    },
    {
      "id": 43,
      "start": 14947.54,
      "end": 14951.54,
      "formatted_start": "04:09:07.540",
      "formatted_end": "04:09:11.540",
      "text": "آرامش من خیلی خواهیدم"
    },
    {
      "id": 44,
      "start": 14951.54,
      "end": 14953.54,
      "formatted_start": "04:09:11.540",
      "formatted_end": "04:09:13.540",
      "text": "دیواره کردم باید"
    },
    {
      "id": 45,
      "start": 14957.54,
      "end": 14961.54,
      "formatted_start": "04:09:17.540",
      "formatted_end": "04:09:21.540",
      "text": "چقدر هستی؟ برم رضی اون"
    },
    {
      "id": 46,
      "start": 14961.54,
      "end": 14964.54,
      "formatted_start": "04:09:21.540",
      "formatted_end": "04:09:24.540",
      "text": "از شد چند بازی برمی؟"
