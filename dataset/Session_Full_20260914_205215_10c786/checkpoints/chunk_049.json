  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14721.64,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:21.640",
      "text": "از اینجا باید باید بازنگهت باشید، باید ملایم سشوار روزی 20 سایت های جلوش بگیرید با فاسده، نه شستونی، نه ستوزه، اینقدر ملایم هم باشه، نه سرد، نه داق، بسرد."
    },
    {
      "id": 1,
      "start": 14721.64,
      "end": 14724.88,
      "formatted_start": "04:05:21.640",
      "formatted_end": "04:05:24.880",
      "text": "دو سه ساعت بدون پوشک باید باشه"
    },
    {
      "id": 2,
      "start": 14724.88,
      "end": 14728.28,
      "formatted_start": "04:05:24.880",
      "formatted_end": "04:05:28.280",
      "text": "میشوری فوری خوش کشور باید باشه با یه دستمال"
    },
    {
      "id": 3,
      "start": 14728.28,
      "end": 14729.78,
      "formatted_start": "04:05:28.280",
      "formatted_end": "04:05:29.780",
      "text": "تمیز نخی"
    },
    {
      "id": 4,
      "start": 14729.78,
      "end": 14731.48,
      "formatted_start": "04:05:29.780",
      "formatted_end": "04:05:31.480",
      "text": "خوش کنی فورا"
    },
    {
      "id": 5,
      "start": 14731.48,
      "end": 14733.58,
      "formatted_start": "04:05:31.480",
      "formatted_end": "04:05:33.580",
      "text": "و غیر از کرما"
    },
    {
      "id": 6,
      "start": 14733.58,
      "end": 14734.82,
      "formatted_start": "04:05:33.580",
      "formatted_end": "04:05:34.820",
      "text": "که من میدم"
    },
    {
      "id": 7,
      "start": 14734.82,
      "end": 14738.62,
      "formatted_start": "04:05:34.820",
      "formatted_end": "04:05:38.620",
      "text": "باید یه کپسول هم باز کنی پودرشو"
    },
    {
      "id": 8,
      "start": 14738.62,
      "end": 14744.42,
      "formatted_start": "04:05:38.620",
      "formatted_end": "04:05:44.420",
      "text": "و تقریبا نصف پودر رو هر روز توی آب یا ماستر کنی بهش بدی بخوره"
    },
    {
      "id": 9,
      "start": 14744.42,
      "end": 14749.54,
      "formatted_start": "04:05:44.420",
      "formatted_end": "04:05:49.540",
      "text": "ولی خیست نمونه بعد سه شوار هم جلو بگیری دو سه ساعت هم بدون پوشک"
    },
    {
      "id": 10,
      "start": 14749.54,
      "end": 14758.54,
      "formatted_start": "04:05:49.540",
      "formatted_end": "04:05:58.540",
      "text": "روزانه از صابون شامپون کائین استفاده نباید بکنید، شوینده نباید بکنید، فقط آم"
    },
    {
      "id": 11,
      "start": 14764.54,
      "end": 14765.54,
      "formatted_start": "04:06:04.540",
      "formatted_end": "04:06:05.540",
      "text": "این از ساسیت چیه؟"
    },
    {
      "id": 12,
      "start": 14765.54,
      "end": 14766.54,
      "formatted_start": "04:06:05.540",
      "formatted_end": "04:06:06.540",
      "text": "مارچی شده"
    },
    {
      "id": 13,
      "start": 14779.54,
      "end": 14781.54,
      "formatted_start": "04:06:19.540",
      "formatted_end": "04:06:21.540",
      "text": "مردم رو بردارید"
    },
    {
      "id": 14,
      "start": 14781.54,
      "end": 14783.54,
      "formatted_start": "04:06:21.540",
      "formatted_end": "04:06:23.540",
      "text": "از اینکه باید بردارید"
    },
    {
      "id": 15,
      "start": 14783.54,
      "end": 14785.54,
      "formatted_start": "04:06:23.540",
      "formatted_end": "04:06:25.540",
      "text": "از اینکه باید بردارید"
    },
    {
      "id": 16,
      "start": 14785.54,
      "end": 14787.54,
      "formatted_start": "04:06:25.540",
