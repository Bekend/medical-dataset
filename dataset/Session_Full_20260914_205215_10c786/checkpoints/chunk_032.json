  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9605.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:05.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 1,
      "start": 9605.0,
      "end": 9609.0,
      "formatted_start": "02:40:05.000",
      "formatted_end": "02:40:09.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 2,
      "start": 9609.0,
      "end": 9613.0,
      "formatted_start": "02:40:09.000",
      "formatted_end": "02:40:13.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 3,
      "start": 9613.0,
      "end": 9617.0,
      "formatted_start": "02:40:13.000",
      "formatted_end": "02:40:17.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 4,
      "start": 9617.0,
      "end": 9621.0,
      "formatted_start": "02:40:17.000",
      "formatted_end": "02:40:21.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 5,
      "start": 9621.0,
      "end": 9625.0,
      "formatted_start": "02:40:21.000",
      "formatted_end": "02:40:25.000",
      "text": "از که این شروع شده؟"
    },
    {
      "id": 6,
      "start": 9625.0,
      "end": 9627.0,
      "formatted_start": "02:40:25.000",
      "formatted_end": "02:40:27.000",
      "text": "دردشی کم هم داره"
    },
    {
      "id": 7,
      "start": 9627.0,
      "end": 9629.0,
      "formatted_start": "02:40:27.000",
      "formatted_end": "02:40:29.000",
      "text": "چی؟"
    },
    {
      "id": 8,
      "start": 9629.0,
      "end": 9633.0,
      "formatted_start": "02:40:29.000",
      "formatted_end": "02:40:33.000",
      "text": "جدید هم چند، مثلا یه هفته اینا شبه دو سه با میره دست شوید"
    },
    {
      "id": 9,
      "start": 9633.0,
      "end": 9634.0,
      "formatted_start": "02:40:33.000",
      "formatted_end": "02:40:34.000",
      "text": "باباش میگه..."
    },
    {
      "id": 10,
      "start": 9634.0,
      "end": 9635.0,
      "formatted_start": "02:40:34.000",
      "formatted_end": "02:40:35.000",
      "text": "قدشو؟"
    },
    {
      "id": 11,
      "start": 9635.0,
      "end": 9636.0,
      "formatted_start": "02:40:35.000",
      "formatted_end": "02:40:36.000",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 9636.0,
      "end": 9639.0,
      "formatted_start": "02:40:36.000",
      "formatted_end": "02:40:39.000",
      "text": "اما صبح رو مهمونی باید سه چند رقم دست خود"
    },
    {
      "id": 13,
      "start": 9639.0,
      "end": 9641.0,
      "formatted_start": "02:40:39.000",
      "formatted_end": "02:40:41.000",
      "text": "باید خود دارن"
    },
    {
      "id": 14,
      "start": 9641.0,
      "end": 9642.0,
      "formatted_start": "02:40:41.000",
      "formatted_end": "02:40:42.000",
      "text": "ترک برده برده برده برده برده"
    },
    {
      "id": 15,
      "start": 9642.0,
      "end": 9645.0,
      "formatted_start": "02:40:42.000",
      "formatted_end": "02:40:45.000",
      "text": "دیدین ست پیش این هم قدشو برده دست خود برده برده برده"
    },
    {
      "id": 16,
      "start": 9645.0,
      "end": 9647.0,
      "formatted_start": "02:40:45.000",
      "formatted_end": "02:40:47.000",
      "text": "دیدین ست و بسته چهاره"
    },
    {
      "id": 17,
      "start": 9648.0,
      "end": 9650.0,
      "formatted_start": "02:40:48.000",
      "formatted_end": "02:40:50.000",
      "text": "ست و بسته باید نشته باشه"
    },
    {
      "id": 18,
      "start": 9650.0,
      "end": 9654.68,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:54.680",
      "text": "الان فایده نداره. آزمایش براش ملوک میتونن ولی ناشته باید انجام بدی."
    },
    {
      "id": 19,
      "start": 9654.68,
      "end": 9658.1,
      "formatted_start": "02:40:54.680",
      "formatted_end": "02:40:58.100",
      "text": "سو دسترم خورده دیگه اصلا نمیشه تفسیر کنه. شیرین بوده دیگه."
    },
    {
      "id": 20,
      "start": 9658.1,
      "end": 9660.76,
      "formatted_start": "02:40:58.100",
      "formatted_end": "02:41:00.760",
      "text": "خب دلت کجاش درمی کنه؟ نشون بده."
    },
    {
      "id": 21,
      "start": 9660.76,
      "end": 9661.52,
      "formatted_start": "02:41:00.760",
      "formatted_end": "02:41:01.520",
      "text": "اینجا."
    },
    {
      "id": 22,
      "start": 9661.52,
      "end": 9664.06,
      "formatted_start": "02:41:01.520",
      "formatted_end": "02:41:04.060",
      "text": "بلند کن. رباستو من بگیرم. اون کجا هست؟"
    },
    {
      "id": 23,
      "start": 9664.06,
      "end": 9665.64,
      "formatted_start": "02:41:04.060",
      "formatted_end": "02:41:05.640",
      "text": "کجا درمی کنه؟"
    },
    {
      "id": 24,
      "start": 9665.64,
      "end": 9666.86,
      "formatted_start": "02:41:05.640",
      "formatted_end": "02:41:06.860",
      "text": "اینجا چی؟"
    },
    {
      "id": 25,
      "start": 9668.06,
      "end": 9669.06,
      "formatted_start": "02:41:08.060",
      "formatted_end": "02:41:09.060",
      "text": "اینجا."
    },
    {
      "id": 26,
      "start": 9669.48,
      "end": 9670.52,
      "formatted_start": "02:41:09.480",
      "formatted_end": "02:41:10.520",
      "text": "بی کنه؟"
    },
    {
      "id": 27,
      "start": 9670.52,
      "end": 9674.28,
      "formatted_start": "02:41:10.520",
      "formatted_end": "02:41:14.280",
      "text": "اینجا هم درد میکنه، اینجا هم میکنه، هر دو جا، اینجا چی؟ اینجا"
    },
    {
      "id": 28,
      "start": 9674.28,
      "end": 9676.28,
      "formatted_start": "02:41:14.280",
      "formatted_end": "02:41:16.280",
      "text": "اینجا، اینجا بگیره"
    },
    {
      "id": 29,
      "start": 9676.28,
      "end": 9678.28,
      "formatted_start": "02:41:16.280",
      "formatted_end": "02:41:18.280",
      "text": "میگیره، اینجا درد بگیره"
    },
    {
      "id": 30,
      "start": 9679.28,
      "end": 9681.78,
      "formatted_start": "02:41:19.280",
      "formatted_end": "02:41:21.780",
      "text": "مطمئنی اینجا آفانیسته، درد بگیره؟"
    },
    {
      "id": 31,
      "start": 9681.78,
      "end": 9683.78,
      "formatted_start": "02:41:21.780",
      "formatted_end": "02:41:23.780",
      "text": "سمع آویا، یا چم آویا"
    },
    {
      "id": 32,
      "start": 9683.78,
      "end": 9684.78,
      "formatted_start": "02:41:23.780",
      "formatted_end": "02:41:24.780",
      "text": "سقفت من آویا"
    },
    {
      "id": 33,
      "start": 9684.78,
      "end": 9686.18,
      "formatted_start": "02:41:24.780",
      "formatted_end": "02:41:26.180",
      "text": "خودت بگو کجا بیشتره؟"
    },
    {
      "id": 34,
      "start": 9686.18,
      "end": 9688.18,
      "formatted_start": "02:41:26.180",
      "formatted_end": "02:41:28.180",
      "text": "اینجا چم آویا"
    },
    {
      "id": 35,
      "start": 9688.18,
      "end": 9690.18,
      "formatted_start": "02:41:28.180",
      "formatted_end": "02:41:30.180",
      "text": "چه میگیره؟ از اینجا پس میگیره"
    },
    {
      "id": 36,
      "start": 9690.18,
      "end": 9692.18,
      "formatted_start": "02:41:30.180",
      "formatted_end": "02:41:32.180",
      "text": "ببین باید اصمان آن بشه، پس"
    },
    {
      "id": 37,
      "start": 9692.18,
      "end": 9697.18,
      "formatted_start": "02:41:32.180",
      "formatted_end": "02:41:37.180",
      "text": "چون استفراق به درسته های و دردش اینجا است به نه آباندیس هم هست"
    },
    {
      "id": 38,
      "start": 9699.18,
      "end": 9701.18,
      "formatted_start": "02:41:39.180",
      "formatted_end": "02:41:41.180",
      "text": "بلنجو برات تو بگیرم"
    },
    {
      "id": 39,
      "start": 9703.18,
      "end": 9705.18,
      "formatted_start": "02:41:43.180",
      "formatted_end": "02:41:45.180",
      "text": "بلنجو برات تو بگیرم"
    },
    {
      "id": 40,
      "start": 9707.18,
      "end": 9709.18,
      "formatted_start": "02:41:47.180",
      "formatted_end": "02:41:49.180",
      "text": "شما اونجا مرسست هست"
    },
    {
      "id": 41,
      "start": 9709.18,
      "end": 9711.18,
      "formatted_start": "02:41:49.180",
      "formatted_end": "02:41:51.180",
      "text": "بیایید اینجا بگیرس"
    },
    {
      "id": 42,
      "start": 9711.18,
      "end": 9713.18,
      "formatted_start": "02:41:51.180",
      "formatted_end": "02:41:53.180",
      "text": "بگیر پر مکن"
    },
    {
      "id": 43,
      "start": 9713.18,
      "end": 9715.18,
      "formatted_start": "02:41:53.180",
      "formatted_end": "02:41:55.180",
      "text": "بازم بازم"
    },
    {
      "id": 44,
      "start": 9715.18,
      "end": 9717.18,
      "formatted_start": "02:41:55.180",
      "formatted_end": "02:41:57.180",
      "text": "الان کجا دردی کنه؟"
    },
    {
      "id": 45,
      "start": 9717.18,
      "end": 9719.18,
      "formatted_start": "02:41:57.180",
      "formatted_end": "02:41:59.180",
      "text": "کجا دردی؟"
    },
    {
      "id": 46,
      "start": 9719.18,
      "end": 9721.18,
      "formatted_start": "02:41:59.180",
      "formatted_end": "02:42:01.180",
      "text": "نه نه جا باشه"
    },
    {
      "id": 47,
      "start": 9722.18,
      "end": 9726.18,
      "formatted_start": "02:42:02.180",
      "formatted_end": "02:42:06.180",
      "text": "بیروز باش کنم درداریم"
    },
    {
      "id": 48,
      "start": 9726.18,
      "end": 9728.18,
      "formatted_start": "02:42:06.180",
      "formatted_end": "02:42:08.180",
      "text": "آین در سمت راست شکم"
    },
    {
      "id": 49,
      "start": 9728.18,
      "end": 9731.18,
      "formatted_start": "02:42:08.180",
      "formatted_end": "02:42:11.180",
      "text": "تو هر استفراقی باید به آفانکیس معنی کنید"
    },
    {
      "id": 50,
      "start": 9731.18,
      "end": 9733.18,
      "formatted_start": "02:42:11.180",
      "formatted_end": "02:42:13.180",
      "text": "علامتش استفراقی دید"
    },
    {
      "id": 51,
      "start": 9733.18,
      "end": 9735.18,
      "formatted_start": "02:42:13.180",
      "formatted_end": "02:42:15.180",
      "text": "و بدون طبت"
    },
    {
      "id": 52,
      "start": 9735.18,
      "end": 9738.18,
      "formatted_start": "02:42:15.180",
      "formatted_end": "02:42:18.180",
      "text": "و این کلمت طبعا ممکنه آفانکیس را داشته باشند"
    },
    {
      "id": 53,
      "start": 9738.18,
      "end": 9741.18,
      "formatted_start": "02:42:18.180",
      "formatted_end": "02:42:21.180",
      "text": "و دید به همه رای هر بچه ای که برای استثاره"
    },
    {
      "id": 54,
      "start": 9741.18,
      "end": 9743.18,
      "formatted_start": "02:42:21.180",
      "formatted_end": "02:42:23.180",
      "text": "برای استثاره شده؟ آنه"
    },
    {
      "id": 55,
      "start": 9743.18,
      "end": 9746.18,
      "formatted_start": "02:42:23.180",
      "formatted_end": "02:42:26.180",
      "text": "برای استثاره برای استفراق و درد این پایین میاد"
    },
    {
      "id": 56,
      "start": 9746.18,
      "end": 9748.18,
      "formatted_start": "02:42:26.180",
      "formatted_end": "02:42:28.180",
      "text": "باید استفراق اینجام بدید"
    },
    {
      "id": 57,
      "start": 9748.18,
      "end": 9750.18,
      "formatted_start": "02:42:28.180",
      "formatted_end": "02:42:30.180",
      "text": "دید به تعمیره؟"
    },
    {
      "id": 58,
      "start": 9750.18,
      "end": 9758.42,
      "formatted_start": "02:42:30.180",
      "formatted_end": "02:42:38.420",
      "text": "خب، سرکیز رو شهار شستانو، دوستو، هشتو، شدید"
    },
    {
      "id": 59,
      "start": 9758.42,
      "end": 9762.94,
      "formatted_start": "02:42:38.420",
      "formatted_end": "02:42:42.940",
      "text": "ببین به نظر من اول سروموش رو انجام بده"
    },
    {
      "id": 60,
      "start": 9762.94,
      "end": 9765.26,
      "formatted_start": "02:42:42.940",
      "formatted_end": "02:42:45.260",
      "text": "بعد سروم و آزمایش"
    },
    {
      "id": 61,
      "start": 9765.26,
      "end": 9768.9,
      "formatted_start": "02:42:45.260",
      "formatted_end": "02:42:48.900",
      "text": "آزمایشش رو چون به خاطر اینکه هناشتا نیست"
    },
    {
      "id": 62,
      "start": 9768.9,
      "end": 9769.46,
      "formatted_start": "02:42:48.900",
      "formatted_end": "02:42:49.460",
      "text": "آره"
    },
    {
      "id": 63,
      "start": 9769.46,
      "end": 9770.74,
      "formatted_start": "02:42:49.460",
      "formatted_end": "02:42:50.740",
      "text": "آنه، فقط سروم"
    },
    {
      "id": 64,
      "start": 9770.74,
      "end": 9773.42,
      "formatted_start": "02:42:50.740",
      "formatted_end": "02:42:53.420",
      "text": "آزمایشش باید بعد این حال عجبه نیست برای اون"
    },
    {
      "id": 65,
      "start": 9774.38,
      "end": 9778.5,
      "formatted_start": "02:42:54.380",
      "formatted_end": "02:42:58.500",
      "text": "فالاشتون خودش دیابتال از اون به خاطر هم میترسه"
    },
    {
      "id": 66,
      "start": 9778.5,
      "end": 9783.4,
      "formatted_start": "02:42:58.500",
      "formatted_end": "02:43:03.400",
      "text": "حالا من براشو میزنم در سیستم تا یه ماه هم اعتبار دارم میتونیم انجام بودیم"
    },
    {
      "id": 67,
      "start": 9783.4,
      "end": 9784.5,
      "formatted_start": "02:43:03.400",
      "formatted_end": "02:43:04.500",
      "text": "من ناشته باشم"
    },
    {
      "id": 68,
      "start": 9784.5,
      "end": 9789.68,
      "formatted_start": "02:43:04.500",
      "formatted_end": "02:43:09.680",
      "text": "سرماشو همه میشه انجام بودیم"
    },
    {
      "id": 69,
      "start": 9789.68,
      "end": 9792.64,
      "formatted_start": "02:43:09.680",
      "formatted_end": "02:43:12.640",
      "text": "آره دیوان باید بزنم به برای کلگایی انجام بودیم"
    },
    {
      "id": 70,
      "start": 9808.5,
      "end": 9838.5,
      "formatted_start": "02:43:28.500",
      "formatted_end": "02:43:58.500",
      "text": "مردم در اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با اینجا با این"
    },
    {
      "id": 71,
      "start": 9838.5,
      "end": 9866.5,
      "formatted_start": "02:43:58.500",
      "formatted_end": "02:44:26.500",
      "text": "موسیقی"
    },
    {
      "id": 72,
      "start": 9866.5,
      "end": 9868.5,
      "formatted_start": "02:44:26.500",
      "formatted_end": "02:44:28.500",
      "text": "سلام"
    },
    {
      "id": 73,
      "start": 9868.5,
      "end": 9870.5,
      "formatted_start": "02:44:28.500",
      "formatted_end": "02:44:30.500",
      "text": "سلام"
    },
    {
      "id": 74,
      "start": 9870.5,
      "end": 9872.5,
      "formatted_start": "02:44:30.500",
      "formatted_end": "02:44:32.500",
      "text": "آره آره"
    },
    {
      "id": 75,
      "start": 9872.5,
      "end": 9874.5,
      "formatted_start": "02:44:32.500",
      "formatted_end": "02:44:34.500",
      "text": "آره"
    },
    {
      "id": 76,
      "start": 9874.5,
      "end": 9876.5,
      "formatted_start": "02:44:34.500",
      "formatted_end": "02:44:36.500",
      "text": "چند وزشه؟"
    },
    {
      "id": 77,
      "start": 9876.5,
      "end": 9878.5,
      "formatted_start": "02:44:36.500",
      "formatted_end": "02:44:38.500",
      "text": "یه هفته شد"
    },
    {
      "id": 78,
      "start": 9878.5,
      "end": 9880.5,
      "formatted_start": "02:44:38.500",
      "formatted_end": "02:44:40.500",
      "text": "یه هفته"
    },
    {
      "id": 79,
      "start": 9880.5,
      "end": 9882.5,
      "formatted_start": "02:44:40.500",
      "formatted_end": "02:44:42.500",
      "text": "وزش شده؟"
    },
    {
      "id": 80,
      "start": 9882.5,
      "end": 9884.5,
      "formatted_start": "02:44:42.500",
      "formatted_end": "02:44:44.500",
      "text": "اشکال نداره"
    },
    {
      "id": 81,
      "start": 9884.5,
      "end": 9886.5,
      "formatted_start": "02:44:44.500",
      "formatted_end": "02:44:46.500",
      "text": "داریم تا ساعت 5 نور بگیره"
    },
    {
      "id": 82,
      "start": 9886.5,
      "end": 9888.5,
      "formatted_start": "02:44:46.500",
      "formatted_end": "02:44:48.500",
      "text": "5 اصبه بگیره"
    },
    {
      "id": 83,
      "start": 9888.5,
      "end": 9890.5,
      "formatted_start": "02:44:48.500",
      "formatted_end": "02:44:50.500",
      "text": "ولی کامل براش بذار بگیره"
    },
    {
      "id": 84,
      "start": 9890.5,
      "end": 9892.5,
      "formatted_start": "02:44:50.500",
      "formatted_end": "02:44:52.500",
      "text": "دیگه"
    },
    {
      "id": 85,
      "start": 9892.5,
      "end": 9894.5,
      "formatted_start": "02:44:52.500",
      "formatted_end": "02:44:54.500",
      "text": "براش بذار بگیره دیگه"
    }
  ],
  "status": "completed"
}