  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11709.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:09.000",
      "text": "میگه خودت میدونی که هرکی یه جوری مشکلات داره، ما وقتی از شما یه جوری درگیر هستیم، میگه لابر شدید، میگه ما هم درگیریم."
    },
    {
      "id": 1,
      "start": 11709.0,
      "end": 11713.0,
      "formatted_start": "03:15:09.000",
      "formatted_end": "03:15:13.000",
      "text": "مغز صالح نباشه، فایه نداره"
    },
    {
      "id": 2,
      "start": 11713.0,
      "end": 11716.0,
      "formatted_start": "03:15:13.000",
      "formatted_end": "03:15:16.000",
      "text": "مغزم صالح نیست، برای اینقدر نگرم بیارم"
    },
    {
      "id": 3,
      "start": 11716.0,
      "end": 11718.0,
      "formatted_start": "03:15:16.000",
      "formatted_end": "03:15:18.000",
      "text": "باز براتنگو کنیم؟"
    },
    {
      "id": 4,
      "start": 11718.0,
      "end": 11722.0,
      "formatted_start": "03:15:18.000",
      "formatted_end": "03:15:22.000",
      "text": "پس ما الان داروش رو براتنگو کنیم، اینجورا میلیسیم"
    },
    {
      "id": 5,
      "start": 11722.0,
      "end": 11725.0,
      "formatted_start": "03:15:22.000",
      "formatted_end": "03:15:25.000",
      "text": "خوشت این ازمشه نیست که یه درمشه ازمشه چون؟"
    },
    {
      "id": 6,
      "start": 11725.0,
      "end": 11728.0,
      "formatted_start": "03:15:25.000",
      "formatted_end": "03:15:28.000",
      "text": "قطعه درمانی هست"
    },
    {
      "id": 7,
      "start": 11728.0,
      "end": 11732.0,
      "formatted_start": "03:15:28.000",
      "formatted_end": "03:15:32.000",
      "text": "یک ماه بعد ببین فقط تی از ای چک شده"
    },
    {
      "id": 8,
      "start": 11732.0,
      "end": 11735.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:35.000",
      "text": "فقط تی از ای چک شده"
    },
    {
      "id": 9,
      "start": 11735.0,
      "end": 11738.5,
      "formatted_start": "03:15:35.000",
      "formatted_end": "03:15:38.500",
      "text": "عدد زیر سه باشد اوکی است"
    },
    {
      "id": 10,
      "start": 11738.5,
      "end": 11743.76,
      "formatted_start": "03:15:38.500",
      "formatted_end": "03:15:43.760",
      "text": "اوکی است و عطای کامل درمان"
    },
    {
      "id": 11,
      "start": 11743.76,
      "end": 11748.2,
      "formatted_start": "03:15:43.760",
      "formatted_end": "03:15:48.200",
      "text": "مارای سه شد مارا جاییم"
    },
    {
      "id": 12,
      "start": 11765.0,
      "end": 11794.98,
      "formatted_start": "03:16:05.000",
      "formatted_end": "03:16:34.980",
      "text": "باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 13,
      "start": 11795.0,
      "end": 11799.0,
      "formatted_start": "03:16:35.000",
      "formatted_end": "03:16:39.000",
      "text": "محسنیت به نیست سواله"
    },
    {
      "id": 14,
      "start": 11799.0,
      "end": 11801.0,
      "formatted_start": "03:16:39.000",
      "formatted_end": "03:16:41.000",
      "text": "هر چی سوال برداشت نمیشه"
    },
    {
      "id": 15,
      "start": 11801.0,
      "end": 11803.0,
      "formatted_start": "03:16:41.000",
      "formatted_end": "03:16:43.000",
      "text": "آخرم در وسط زنانگیش هم مانده کنید"
    },
    {
      "id": 16,
      "start": 11803.0,
      "end": 11805.0,
      "formatted_start": "03:16:43.000",
      "formatted_end": "03:16:45.000",
      "text": "چیشم دهد"
    },
    {
      "id": 17,
      "start": 11805.0,
      "end": 11807.0,
      "formatted_start": "03:16:45.000",
      "formatted_end": "03:16:47.000",
      "text": "محسنیت برداشت نمیشه"
    },
    {
      "id": 18,
      "start": 11807.0,
      "end": 11809.0,
      "formatted_start": "03:16:47.000",
      "formatted_end": "03:16:49.000",
      "text": "برداشت برداشت"
    },
    {
      "id": 19,
      "start": 11809.0,
      "end": 11811.0,
      "formatted_start": "03:16:49.000",
      "formatted_end": "03:16:51.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 20,
      "start": 11811.0,
      "end": 11813.0,
      "formatted_start": "03:16:51.000",
      "formatted_end": "03:16:53.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 21,
      "start": 11813.0,
      "end": 11815.0,
      "formatted_start": "03:16:53.000",
      "formatted_end": "03:16:55.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 22,
      "start": 11815.0,
      "end": 11817.0,
      "formatted_start": "03:16:55.000",
      "formatted_end": "03:16:57.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 23,
      "start": 11817.0,
      "end": 11819.0,
      "formatted_start": "03:16:57.000",
      "formatted_end": "03:16:59.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 24,
      "start": 11819.0,
      "end": 11821.0,
      "formatted_start": "03:16:59.000",
      "formatted_end": "03:17:01.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 25,
      "start": 11821.0,
      "end": 11823.0,
      "formatted_start": "03:17:01.000",
      "formatted_end": "03:17:03.000",
      "text": "محسنیت برداشت"
    },
    {
      "id": 26,
      "start": 11823.0,
      "end": 11825.0,
      "formatted_start": "03:17:03.000",
      "formatted_end": "03:17:05.000",
      "text": "آماده کاری، الان؟"
    },
    {
      "id": 27,
      "start": 11825.0,
      "end": 11828.0,
      "formatted_start": "03:17:05.000",
      "formatted_end": "03:17:08.000",
      "text": "مانا؟ نه اومد؟"
    },
    {
      "id": 28,
      "start": 11828.0,
      "end": 11831.0,
      "formatted_start": "03:17:08.000",
      "formatted_end": "03:17:11.000",
      "text": "ای بابا، بزار من زنگ بزنم ای درمه دیگه"
    },
    {
      "id": 29,
      "start": 11831.0,
      "end": 11833.0,
      "formatted_start": "03:17:11.000",
      "formatted_end": "03:17:13.000",
      "text": "بلیز دارم منم شروع برم"
    },
    {
      "id": 30,
      "start": 11837.0,
      "end": 11841.0,
      "formatted_start": "03:17:17.000",
      "formatted_end": "03:17:21.000",
      "text": "کرشاش دا که آبوده، اگه کرشاش زیاده ببرش مغزه اصلا، همین"
    },
    {
      "id": 31,
      "start": 11841.0,
      "end": 11844.0,
      "formatted_start": "03:17:21.000",
      "formatted_end": "03:17:24.000",
      "text": "من نمیبینم تو خونه بشین، آن از آن رو گفتم چی بیوره"
    },
    {
      "id": 32,
      "start": 11844.0,
      "end": 11846.0,
      "formatted_start": "03:17:24.000",
      "formatted_end": "03:17:26.000",
      "text": "اگه زیاده باید ببره دیگه"
    },
    {
      "id": 33,
      "start": 11846.0,
      "end": 11848.0,
      "formatted_start": "03:17:26.000",
      "formatted_end": "03:17:28.000",
      "text": "عکسشونشون داد این که"
    },
    {
      "id": 34,
      "start": 11853.0,
      "end": 11869.0,
      "formatted_start": "03:17:33.000",
      "formatted_end": "03:17:49.000",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 11883.0,
      "end": 11885.0,
      "formatted_start": "03:18:03.000",
      "formatted_end": "03:18:05.000",
      "text": "میزنم یه میگه اشخال"
    },
    {
      "id": 36,
      "start": 11885.0,
      "end": 11887.0,
      "formatted_start": "03:18:05.000",
      "formatted_end": "03:18:07.000",
      "text": "خب نمیشه اشخال همه اش"
    },
    {
      "id": 37,
      "start": 11887.0,
      "end": 11889.0,
      "formatted_start": "03:18:07.000",
      "formatted_end": "03:18:09.000",
      "text": "من دارم ده بار بهش نمیتونم"
    },
    {
      "id": 38,
      "start": 11891.0,
      "end": 11893.0,
      "formatted_start": "03:18:11.000",
      "formatted_end": "03:18:13.000",
      "text": "یه رقصه بذاریم که بینم"
    },
    {
      "id": 39,
      "start": 11899.0,
      "end": 11901.0,
      "formatted_start": "03:18:19.000",
      "formatted_end": "03:18:21.000",
      "text": "نه من گفتم به من با"
    },
    {
      "id": 40,
      "start": 11901.0,
      "end": 11903.0,
      "formatted_start": "03:18:21.000",
      "formatted_end": "03:18:23.000",
      "text": "903 زنگ زده"
    },
    {
      "id": 41,
      "start": 11903.0,
      "end": 11905.0,
      "formatted_start": "03:18:23.000",
      "formatted_end": "03:18:25.000",
      "text": "903 631 46 69"
    },
    {
      "id": 42,
      "start": 11909.0,
      "end": 11911.0,
      "formatted_start": "03:18:29.000",
      "formatted_end": "03:18:31.000",
