      "end": 9266.58,
      "formatted_start": "02:34:24.580",
      "formatted_end": "02:34:26.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 64,
      "start": 9266.58,
      "end": 9268.58,
      "formatted_start": "02:34:26.580",
      "formatted_end": "02:34:28.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 65,
      "start": 9268.58,
      "end": 9270.58,
      "formatted_start": "02:34:28.580",
      "formatted_end": "02:34:30.580",
      "text": "این هایی که بیگردند."
    },
    {
