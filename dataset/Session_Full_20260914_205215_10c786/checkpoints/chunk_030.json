  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9012.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:12.000",
      "text": "چند روز؟ پنج روز. پنج روز. بیا برام شانو بگویم. الان باید تقریباً 900 گرام اضافه شده باشه. اگه شیرت کافی باشه، 900 گرام گرفتیم."
    },
    {
      "id": 1,
      "start": 9012.0,
      "end": 9023.0,
      "formatted_start": "02:30:12.000",
      "formatted_end": "02:30:23.000",
      "text": "یعنی باشه صبح و هشت صفت برنده برم گرفتیم. بله. صبح و هشت صفت برنده برم. بذارید اون رو. شیر خوش نیمیخواد. شیرت کافیه."
    },
    {
      "id": 2,
      "start": 9023.0,
      "end": 9025.0,
      "formatted_start": "02:30:23.000",
      "formatted_end": "02:30:25.000",
      "text": "یک کلو برد گرفته"
    },
    {
      "id": 3,
      "start": 9025.0,
      "end": 9027.0,
      "formatted_start": "02:30:25.000",
      "formatted_end": "02:30:27.000",
      "text": "میبینید هر بار گریه میکنه"
    },
    {
      "id": 4,
      "start": 9027.0,
      "end": 9029.0,
      "formatted_start": "02:30:27.000",
      "formatted_end": "02:30:29.000",
      "text": "یعنی دریف و گوشنگی که نیست"
    },
    {
      "id": 5,
      "start": 9029.0,
      "end": 9031.0,
      "formatted_start": "02:30:29.000",
      "formatted_end": "02:30:31.000",
      "text": "این دلت داره گریه میکنه"
    },
    {
      "id": 6,
      "start": 9031.0,
      "end": 9033.0,
      "formatted_start": "02:30:31.000",
      "formatted_end": "02:30:33.000",
      "text": "و شما هیچ که نمیذارید درمش"
    },
    {
      "id": 7,
      "start": 9033.0,
      "end": 9035.0,
      "formatted_start": "02:30:33.000",
      "formatted_end": "02:30:35.000",
      "text": "ولی"
    },
    {
      "id": 8,
      "start": 9035.0,
      "end": 9037.0,
      "formatted_start": "02:30:35.000",
      "formatted_end": "02:30:37.000",
      "text": "ورزگیریش اوکیه شیره کافیه"
    },
    {
      "id": 9,
      "start": 9037.0,
      "end": 9039.0,
      "formatted_start": "02:30:37.000",
      "formatted_end": "02:30:39.000",
      "text": "بعد این شیر مادر خوش نمیشه"
    },
    {
      "id": 10,
      "start": 9039.0,
      "end": 9041.0,
      "formatted_start": "02:30:39.000",
      "formatted_end": "02:30:41.000",
      "text": "این هر بار که به مکه"
    },
    {
      "id": 11,
      "start": 9041.0,
      "end": 9043.0,
      "formatted_start": "02:30:41.000",
      "formatted_end": "02:30:43.000",
      "text": "ترشم میشه"
    },
    {
      "id": 12,
      "start": 9043.0,
      "end": 9045.0,
      "formatted_start": "02:30:43.000",
      "formatted_end": "02:30:45.000",
      "text": "اصلا زمان نداره"
    },
    {
      "id": 13,
      "start": 9045.0,
      "end": 9047.0,
      "formatted_start": "02:30:45.000",
      "formatted_end": "02:30:47.000",
      "text": "این رو پشت بودنی؟ قصده نمیده"
    },
    {
      "id": 14,
      "start": 9047.0,
      "end": 9049.0,
      "formatted_start": "02:30:47.000",
      "formatted_end": "02:30:49.000",
      "text": "پشت نه"
    },
    {
      "id": 15,
      "start": 9049.0,
      "end": 9052.0,
      "formatted_start": "02:30:49.000",
      "formatted_end": "02:30:52.000",
      "text": "بچه اون رفلاکس کرولاکین تر شون میشه"
    },
    {
      "id": 16,
      "start": 9072.0,
      "end": 9074.0,
      "formatted_start": "02:31:12.000",
      "formatted_end": "02:31:14.000",
      "text": "زردی که اصلا نداره"
    },
    {
      "id": 17,
      "start": 9075.0,
      "end": 9078.0,
      "formatted_start": "02:31:15.000",
      "formatted_end": "02:31:18.000",
      "text": "اینم پشتش غیری سفته اصلا ندار"
    },
    {
      "id": 18,
      "start": 9079.0,
      "end": 9082.0,
      "formatted_start": "02:31:19.000",
      "formatted_end": "02:31:22.000",
      "text": "مدکویش رنگش طبز نیست؟"
    },
    {
      "id": 19,
      "start": 9082.0,
      "end": 9085.0,
      "formatted_start": "02:31:22.000",
      "formatted_end": "02:31:25.000",
      "text": "نه نه آره، نفتوش خوبه"
    },
    {
      "id": 20,
      "start": 9085.0,
      "end": 9088.0,
      "formatted_start": "02:31:25.000",
      "formatted_end": "02:31:28.000",
      "text": "مدکویش هم که با مواد خوبه نفتوش نیست"
    },
    {
      "id": 21,
      "start": 9088.0,
      "end": 9092.0,
      "formatted_start": "02:31:28.000",
      "formatted_end": "02:31:32.000",
      "text": "ماساج شکم، اینجوری درجهت اقل باشه ساعت باید روغنی"
    },
    {
      "id": 22,
      "start": 9092.0,
      "end": 9096.0,
      "formatted_start": "02:31:32.000",
      "formatted_end": "02:31:36.000",
      "text": "هر روغنی شد، بادا، غیفون، نارگی"
    },
    {
      "id": 23,
      "start": 9096.0,
      "end": 9099.0,
      "formatted_start": "02:31:36.000",
      "formatted_end": "02:31:39.000",
      "text": "بعدش میاد، میبینی اینقدر یه رو گریه میکنه"
    },
    {
      "id": 24,
      "start": 9099.0,
      "end": 9101.0,
      "formatted_start": "02:31:39.000",
      "formatted_end": "02:31:41.000",
      "text": "میپیچه، بعد مدکتی میکنه"
    },
    {
      "id": 25,
      "start": 9101.0,
      "end": 9104.0,
      "formatted_start": "02:31:41.000",
      "formatted_end": "02:31:44.000",
      "text": "این درگاه مشکلش فقط کلیکه"
    },
    {
      "id": 26,
      "start": 9104.0,
      "end": 9105.0,
      "formatted_start": "02:31:44.000",
      "formatted_end": "02:31:45.000",
      "text": "آهان"
    },
    {
      "id": 27,
      "start": 9105.0,
      "end": 9108.0,
      "formatted_start": "02:31:45.000",
      "formatted_end": "02:31:48.000",
      "text": "گریه هاش، کلیکه هست، بله"
    },
    {
      "id": 28,
      "start": 9108.0,
      "end": 9111.0,
      "formatted_start": "02:31:48.000",
      "formatted_end": "02:31:51.000",
      "text": "و چی کنم کورانهی بهش دادم"
    },
    {
      "id": 29,
      "start": 9111.0,
      "end": 9115.0,
      "formatted_start": "02:31:51.000",
      "formatted_end": "02:31:55.000",
      "text": "بهش میدم یا کولیکت از پلر رو امتحان کنم"
    },
    {
      "id": 30,
      "start": 9115.0,
      "end": 9118.0,
      "formatted_start": "02:31:55.000",
      "formatted_end": "02:31:58.000",
      "text": "و الان بهترین چیز همون بود"
    },
    {
      "id": 31,
      "start": 9118.0,
      "end": 9120.0,
      "formatted_start": "02:31:58.000",
      "formatted_end": "02:32:00.000",
      "text": "الان اونم جواب نمیده بود"
    },
    {
      "id": 32,
      "start": 9120.0,
      "end": 9121.0,
      "formatted_start": "02:32:00.000",
      "formatted_end": "02:32:01.000",
      "text": "کولیکت بود؟"
    },
    {
      "id": 33,
      "start": 9121.0,
      "end": 9124.0,
      "formatted_start": "02:32:01.000",
      "formatted_end": "02:32:04.000",
      "text": "آره، بردش همش اصلا خواب نداره این"
    },
    {
      "id": 34,
      "start": 9130.0,
      "end": 9132.0,
      "formatted_start": "02:32:10.000",
      "formatted_end": "02:32:12.000",
      "text": "براش این بار شیره"
    },
    {
      "id": 35,
      "start": 9132.0,
      "end": 9134.0,
      "formatted_start": "02:32:12.000",
      "formatted_end": "02:32:14.000",
      "text": "سپیدت نیست بار شیره"
    },
    {
      "id": 36,
      "start": 9134.0,
      "end": 9136.0,
      "formatted_start": "02:32:14.000",
      "formatted_end": "02:32:16.000",
      "text": "در زبونشه"
    },
    {
      "id": 37,
      "start": 9136.0,
      "end": 9144.0,
      "formatted_start": "02:32:16.000",
      "formatted_end": "02:32:24.000",
      "text": "ببین یابوهای دلپیشت رو یه نبل باید بالاتر ببینید"
    },
    {
      "id": 38,
      "start": 9144.0,
      "end": 9152.0,
      "formatted_start": "02:32:24.000",
      "formatted_end": "02:32:32.000",
      "text": "بعدی رژیم مادر و صدای جاورگی سشور، حرکت ماشین، صدای آب از هر داروی براش دختره"
    },
    {
      "id": 39,
      "start": 9152.0,
      "end": 9155.0,
      "formatted_start": "02:32:32.000",
      "formatted_end": "02:32:35.000",
      "text": "شما اولین کار که رژیم مادره"
    },
    {
      "id": 40,
      "start": 9155.0,
      "end": 9164.0,
      "formatted_start": "02:32:35.000",
      "formatted_end": "02:32:44.000",
      "text": "چیزایی که نباید بخورید، نخو، درژو، عدس، لفه، ماش، کلم، بادنجون، پیم، پیاز، تام، فلیپ دردنی، نشابه دلسته"
    },
    {
      "id": 41,
      "start": 9164.0,
      "end": 9168.5,
      "formatted_start": "02:32:44.000",
      "formatted_end": "02:32:48.500",
      "text": "وردلو بیلاف آناناس این ها هم باید داره که حالا پستش نیست در مدیبیلاس"
    },
    {
      "id": 42,
      "start": 9168.5,
      "end": 9172.0,
      "formatted_start": "02:32:48.500",
      "formatted_end": "02:32:52.000",
      "text": "این ها رو نوید بخورید، ماساج شکم رو بهت گفتم"
    },
    {
      "id": 43,
      "start": 9172.0,
      "end": 9178.0,
      "formatted_start": "02:32:52.000",
      "formatted_end": "02:32:58.000",
      "text": "صدای جاروانیر سشوهر حرکت ماشه، حوشند کن کنارش بذار، دانلود نه، خود سشوهر کنارش بذار"
    },
    {
      "id": 44,
      "start": 9178.0,
      "end": 9184.0,
      "formatted_start": "02:32:58.000",
      "formatted_end": "02:33:04.000",
      "text": "و اینکه دارو در خط آخر داروی شما، 20 تنشتر دارو بهش جواب میده"
    },
    {
      "id": 45,
      "start": 9184.0,
      "end": 9186.0,
      "formatted_start": "02:33:04.000",
      "formatted_end": "02:33:06.000",
      "text": "بیشتر رژیم شما با این صدا هاست"
    },
    {
      "id": 46,
      "start": 9186.0,
      "end": 9197.5,
      "formatted_start": "02:33:06.000",
      "formatted_end": "02:33:17.500",
      "text": "قطره ملتازین، قطره روتفلور و خود دایمیتیکون همین سه تار بودن"
    },
    {
      "id": 47,
      "start": 9197.5,
      "end": 9200.4,
      "formatted_start": "02:33:17.500",
      "formatted_end": "02:33:20.400",
      "text": "گرید میشه را او رانین و اینها دیگه فایده ندارده باشه"
    },
    {
      "id": 48,
      "start": 9200.4,
      "end": 9206.24,
      "formatted_start": "02:33:20.400",
      "formatted_end": "02:33:26.240",
      "text": "آدم که بینید، خوابش با صداها درست میشه، جارو برده روشنگ ها درست میشه"
    },
    {
      "id": 49,
      "start": 9206.24,
      "end": 9210.18,
      "formatted_start": "02:33:26.240",
      "formatted_end": "02:33:30.180",
      "text": "خدا من بردید، اگه بیتار میشه، من به نیمیتره هستم"
    },
    {
      "id": 50,
      "start": 9210.18,
      "end": 9212.94,
      "formatted_start": "02:33:30.180",
      "formatted_end": "02:33:32.940",
      "text": "سخته بودید، یک سا چهر روزگی سختی دارد"
    },
    {
      "id": 51,
      "start": 9212.94,
      "end": 9214.58,
      "formatted_start": "02:33:32.940",
      "formatted_end": "02:33:34.580",
      "text": "از چهر رو بعد کمتر میشه"
    },
    {
      "id": 52,
      "start": 9214.58,
      "end": 9226.58,
      "formatted_start": "02:33:34.580",
      "formatted_end": "02:33:46.580",
      "text": "موسیقی"
    },
    {
      "id": 53,
      "start": 9244.58,
      "end": 9246.58,
      "formatted_start": "02:34:04.580",
      "formatted_end": "02:34:06.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 54,
      "start": 9246.58,
      "end": 9248.58,
      "formatted_start": "02:34:06.580",
      "formatted_end": "02:34:08.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 55,
      "start": 9248.58,
      "end": 9250.58,
      "formatted_start": "02:34:08.580",
      "formatted_end": "02:34:10.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 56,
      "start": 9250.58,
      "end": 9252.58,
      "formatted_start": "02:34:10.580",
      "formatted_end": "02:34:12.580",
      "text": "این هایی که بیگردند."
    },
    {
      "id": 57,
      "start": 9252.58,
      "end": 9254.58,
      "formatted_start": "02:34:12.580",
      "formatted_end": "02:34:14.580",
      "text": "این هایی که بیگردند."
    },
