      "formatted_start": "01:42:38.000",
      "formatted_end": "01:42:40.000",
      "text": "این بروفه میخواد بیداریم"
    },
    {
      "id": 7,
      "start": 6160.0,
      "end": 6162.0,
      "formatted_start": "01:42:40.000",
      "formatted_end": "01:42:42.000",
      "text": "این بروفه میدید؟"
    },
    {
      "id": 8,
      "start": 6162.0,
      "end": 6164.0,
      "formatted_start": "01:42:42.000",
      "formatted_end": "01:42:44.000",
      "text": "این بروفه میدید، این بروفه نداریم"
