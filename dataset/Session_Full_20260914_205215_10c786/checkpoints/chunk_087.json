      "start": 26287.4,
      "end": 26289.4,
      "formatted_start": "07:18:07.400",
      "formatted_end": "07:18:09.400",
      "text": "چون منش در خبید و..."
    },
    {
      "id": 29,
      "start": 26289.4,
      "end": 26291.4,
      "formatted_start": "07:18:09.400",
      "formatted_end": "07:18:11.400",
      "text": "...یه خود باشه."
    },
    {
      "id": 30,
      "start": 26291.4,
      "end": 26293.4,
      "formatted_start": "07:18:11.400",
      "formatted_end": "07:18:13.400",
      "text": "یه هست نه نه."
    },
    {
      "id": 31,
      "start": 26295.4,
      "end": 26297.4,
      "formatted_start": "07:18:15.400",
      "formatted_end": "07:18:17.400",
      "text": "درسته منه دیگه."
