      "formatted_start": "07:17:52.000",
      "formatted_end": "07:17:56.400",
      "text": "چرا؟ چون اون رفتی های زور سامان."
    },
    {
      "id": 25,
      "start": 26276.4,
      "end": 26278.4,
      "formatted_start": "07:17:56.400",
      "formatted_end": "07:17:58.400",
      "text": "ولی تر برده نه."
    },
