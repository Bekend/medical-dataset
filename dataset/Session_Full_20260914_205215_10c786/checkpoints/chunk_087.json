      "end": 26281.4,
      "formatted_start": "07:17:58.400",
      "formatted_end": "07:18:01.400",
      "text": "توسطه نداره نه. تر کم برده بیشتر نداره."
    },
    {
      "id": 27,
      "start": 26285.4,
      "end": 26287.4,
      "formatted_start": "07:18:05.400",
      "formatted_end": "07:18:07.400",
      "text": "این همه کنالش نه نرسته."
    },
