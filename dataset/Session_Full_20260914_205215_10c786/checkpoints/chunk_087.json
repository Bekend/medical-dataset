  "stt_segments": [
    {
      "id": 0,
      "start": 26100.0,
      "end": 26130.0,
      "formatted_start": "07:15:00.000",
      "formatted_end": "07:15:30.000",
      "text": "دولی آفید و یک آدمی که به نام انوی پول بیشتر بود، که درست دارد، دولی آفید از اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه این"
    },
    {
      "id": 1,
      "start": 26130.0,
      "end": 26136.0,
      "formatted_start": "07:15:30.000",
      "formatted_end": "07:15:36.000",
      "text": "از اینجا با این کچی شده همه کشی شده از دست میده که اینو کمک کنه"
    },
    {
      "id": 2,
      "start": 26136.0,
      "end": 26140.0,
      "formatted_start": "07:15:36.000",
      "formatted_end": "07:15:40.000",
      "text": "من اونجور آمدید همه رفیقا مطاب دارم"
    },
    {
      "id": 3,
      "start": 26140.0,
      "end": 26143.0,
      "formatted_start": "07:15:40.000",
      "formatted_end": "07:15:43.000",
      "text": "بکنید ببخش کسم از اینجور"
    },
    {
      "id": 4,
      "start": 26143.0,
      "end": 26147.0,
      "formatted_start": "07:15:43.000",
      "formatted_end": "07:15:47.000",
      "text": "من از دست میده کنم بکنید"
    },
    {
      "id": 5,
      "start": 26147.0,
      "end": 26150.0,
      "formatted_start": "07:15:47.000",
      "formatted_end": "07:15:50.000",
      "text": "من اینو رلشت مردم"
    },
    {
      "id": 6,
      "start": 26150.0,
      "end": 26154.0,
      "formatted_start": "07:15:50.000",
      "formatted_end": "07:15:54.000",
      "text": "اومد یه مددی تو خونه ما نفس اخباری داره بیادری کرد"
    },
    {
      "id": 7,
      "start": 26154.0,
      "end": 26156.0,
      "formatted_start": "07:15:54.000",
      "formatted_end": "07:15:56.000",
      "text": "که البته بیادری ها شوشه مجسید"
    },
    {
      "id": 8,
      "start": 26156.0,
      "end": 26166.0,
      "formatted_start": "07:15:56.000",
      "formatted_end": "07:16:06.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 26186.0,
      "end": 26188.0,
      "formatted_start": "07:16:26.000",
      "formatted_end": "07:16:28.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 10,
      "start": 26188.0,
      "end": 26190.0,
      "formatted_start": "07:16:28.000",
      "formatted_end": "07:16:30.000",
