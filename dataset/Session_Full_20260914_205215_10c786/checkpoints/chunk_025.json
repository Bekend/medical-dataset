  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7530.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:30.000",
      "text": "این همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چیزی برای این، بیشتری همه چی"
    },
    {
      "id": 1,
      "start": 7530.0,
      "end": 7540.0,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:40.000",
      "text": "اگر هم میبینید خسته میشه با سرنگ برید دهندش وزنش کمه شاید نمیمکند"
    },
    {
      "id": 2,
      "start": 7540.0,
      "end": 7544.0,
      "formatted_start": "02:05:40.000",
      "formatted_end": "02:05:44.000",
      "text": "میدوشم کار با شیشه میدونم"
    },
    {
      "id": 3,
      "start": 7544.0,
      "end": 7546.0,
      "formatted_start": "02:05:44.000",
      "formatted_end": "02:05:46.000",
      "text": "شیشه خوب میمکند"
    },
    {
      "id": 4,
      "start": 7546.0,
      "end": 7548.0,
      "formatted_start": "02:05:46.000",
      "formatted_end": "02:05:48.000",
      "text": "شیشه خوب میمکند"
    },
    {
      "id": 5,
      "start": 7548.0,
      "end": 7552.0,
      "formatted_start": "02:05:48.000",
      "formatted_end": "02:05:52.000",
      "text": "خوب شیر خودتون میدوشید شیر خوشکم همینجور با شیشه تون"
    },
    {
      "id": 6,
      "start": 7552.0,
      "end": 7554.0,
      "formatted_start": "02:05:52.000",
      "formatted_end": "02:05:54.000",
      "text": "اینجوری برد میدوشیدن"
    },
    {
      "id": 7,
      "start": 7554.0,
      "end": 7558.0,
      "formatted_start": "02:05:54.000",
      "formatted_end": "02:05:58.000",
      "text": "چرا شیر خودتو نمیدید؟"
    },
    {
      "id": 8,
      "start": 7558.0,
      "end": 7560.0,
      "formatted_start": "02:05:58.000",
      "formatted_end": "02:06:00.000",
      "text": "نمیخوره؟"
    },
    {
      "id": 9,
      "start": 7560.0,
      "end": 7562.0,
      "formatted_start": "02:06:00.000",
      "formatted_end": "02:06:02.000",
      "text": "نه، سینمو نمیگیره"
    },
    {
      "id": 10,
      "start": 7562.0,
      "end": 7568.0,
      "formatted_start": "02:06:02.000",
      "formatted_end": "02:06:08.000",
      "text": "سینی خودمو نمیگیره"
    },
    {
      "id": 11,
      "start": 7568.0,
      "end": 7570.0,
      "formatted_start": "02:06:08.000",
      "formatted_end": "02:06:10.000",
      "text": "من شیشت تنگه نیست"
    },
    {
      "id": 12,
      "start": 7570.0,
      "end": 7572.0,
      "formatted_start": "02:06:10.000",
      "formatted_end": "02:06:12.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 7572.0,
      "end": 7574.0,
      "formatted_start": "02:06:12.000",
      "formatted_end": "02:06:14.000",
      "text": "شاید زیاد نمیاده"
    },
    {
      "id": 14,
      "start": 7574.0,
      "end": 7576.0,
      "formatted_start": "02:06:14.000",
      "formatted_end": "02:06:16.000",
      "text": "اتفاقا خوب نیاد"
    },
    {
      "id": 15,
      "start": 7576.0,
      "end": 7578.0,
      "formatted_start": "02:06:16.000",
      "formatted_end": "02:06:18.000",
      "text": "بعضی موقع تنگه بچه هایی زورو میزنه"
    },
    {
      "id": 16,
      "start": 7578.0,
      "end": 7580.0,
      "formatted_start": "02:06:18.000",
      "formatted_end": "02:06:20.000",
      "text": "خودش لغرش میکنه"
    },
    {
      "id": 17,
      "start": 7580.0,
      "end": 7583.0,
      "formatted_start": "02:06:20.000",
      "formatted_end": "02:06:23.000",
      "text": "چون برای این ها انرژی در حد اون مکسندن هم بسودونه"
    },
    {
      "id": 18,
      "start": 7583.0,
      "end": 7587.0,
      "formatted_start": "02:06:23.000",
      "formatted_end": "02:06:27.000",
      "text": "اگه یه ذریعه بخواد به خودش پشار بیاره همون هم لغرش کنه"
    },
    {
      "id": 19,
      "start": 7587.0,
      "end": 7590.0,
      "formatted_start": "02:06:27.000",
      "formatted_end": "02:06:30.000",
      "text": "ولی توی هم نباشه که بهتره توی گروه شه"
    },
    {
      "id": 20,
      "start": 7596.0,
      "end": 7597.0,
      "formatted_start": "02:06:36.000",
      "formatted_end": "02:06:37.000",
      "text": "نه این تایم نیست"
    },
    {
      "id": 21,
      "start": 7597.0,
      "end": 7598.0,
      "formatted_start": "02:06:37.000",
      "formatted_end": "02:06:38.000",
      "text": "خوب"
    },
    {
      "id": 22,
      "start": 7598.0,
      "end": 7599.0,
      "formatted_start": "02:06:38.000",
      "formatted_end": "02:06:39.000",
      "text": "این اقداز هست"
    },
    {
      "id": 23,
      "start": 7601.0,
      "end": 7603.0,
      "formatted_start": "02:06:41.000",
      "formatted_end": "02:06:43.000",
      "text": "برای اینکه اون بیشتر خوابه"
    },
    {
      "id": 24,
      "start": 7603.0,
      "end": 7605.0,
      "formatted_start": "02:06:43.000",
      "formatted_end": "02:06:45.000",
      "text": "یوزن کفر باش بیراش کن"
    },
    {
      "id": 25,
      "start": 7605.0,
      "end": 7608.0,
      "formatted_start": "02:06:45.000",
      "formatted_end": "02:06:48.000",
      "text": "یه باید بیراش شد و از نگهتونی چیه"
    },
    {
      "id": 26,
      "start": 7608.0,
      "end": 7611.0,
      "formatted_start": "02:06:48.000",
      "formatted_end": "02:06:51.000",
      "text": "باید همون که مدکونه میکنه همینو بگیریم"
    },
    {
      "id": 27,
      "start": 7611.0,
      "end": 7614.0,
      "formatted_start": "02:06:51.000",
      "formatted_end": "02:06:54.000",
      "text": "بعد هم نخوره مدکونه نداریم"
    },
    {
      "id": 28,
      "start": 7622.0,
      "end": 7624.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:04.000",
      "text": "باید اینقدر باش کار کنید"
    },
    {
      "id": 29,
      "start": 7624.0,
      "end": 7628.0,
      "formatted_start": "02:07:04.000",
      "formatted_end": "02:07:08.000",
      "text": "یک رو باید این رو نگه دارید تا 45 دارو بگو برده"
    },
    {
      "id": 30,
      "start": 7638.0,
      "end": 7668.0,
      "formatted_start": "02:07:18.000",
      "formatted_end": "02:07:48.000",
      "text": "از اینکه این کار را برای از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از این"
    },
    {
      "id": 31,
      "start": 7668.0,
      "end": 7674.0,
      "formatted_start": "02:07:48.000",
      "formatted_end": "02:07:54.000",
      "text": "شیر بخورد، ده روز بعد نیمه ها بیار دوباره وزیر شده باشد."
    },
    {
      "id": 32,
      "start": 7674.0,
      "end": 7679.0,
      "formatted_start": "02:07:54.000",
      "formatted_end": "02:07:59.000",
      "text": "ده روز دیگه با این وضعیت باید دو دیویس شده باشد."
    },
    {
      "id": 33,
      "start": 7679.0,
      "end": 7682.0,
      "formatted_start": "02:07:59.000",
      "formatted_end": "02:08:02.000",
      "text": "باید دو دیویس برسند."
    },
    {
      "id": 34,
      "start": 7682.0,
      "end": 7687.0,
      "formatted_start": "02:08:02.000",
      "formatted_end": "02:08:07.000",
      "text": "اینجا هم نیوردین می توانی بهترش برده. دو دیویس ترسیده بودید، اوکی."
    },
    {
      "id": 35,
      "start": 7687.0,
      "end": 7689.0,
      "formatted_start": "02:08:07.000",
      "formatted_end": "02:08:09.000",
      "text": "از اینجا باید باید بردارید."
    },
    {
      "id": 36,
      "start": 7689.0,
      "end": 7691.0,
      "formatted_start": "02:08:09.000",
      "formatted_end": "02:08:11.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 37,
      "start": 7691.0,
      "end": 7693.0,
      "formatted_start": "02:08:11.000",
      "formatted_end": "02:08:13.000",
      "text": "اینجا باید بردارید."
    },
    {
