  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6930.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:30.000",
      "text": "از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه باید برداروها بزنید، از اینکه برداروها بزنید، از اینکه ب"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6952.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:52.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6952.0,
      "end": 6955.34,
      "formatted_start": "01:55:52.000",
      "formatted_end": "01:55:55.340",
      "text": "یکم کود رو فکر کنم بیمارستان داره صورتیه"
    },
    {
      "id": 3,
      "start": 6955.34,
      "end": 6956.22,
      "formatted_start": "01:55:55.340",
      "formatted_end": "01:55:56.220",
      "text": "اون رو ندادم"
    },
    {
      "id": 4,
      "start": 6956.22,
      "end": 6958.5,
      "formatted_start": "01:55:56.220",
      "formatted_end": "01:55:58.500",
      "text": "ولی اونی که نداره رو برسنم"
    },
    {
      "id": 5,
      "start": 6958.5,
      "end": 6960.84,
      "formatted_start": "01:55:58.500",
      "formatted_end": "01:56:00.840",
      "text": "و کودی که"
    },
    {
      "id": 6,
      "start": 6960.84,
      "end": 6961.92,
      "formatted_start": "01:56:00.840",
      "formatted_end": "01:56:01.920",
      "text": "این کود شما بگیرسن"
    },
    {
      "id": 7,
      "start": 6961.92,
      "end": 6964.06,
      "formatted_start": "01:56:01.920",
      "formatted_end": "01:56:04.060",
      "text": "کودی که اران برای این دارو ها است"
    },
    {
      "id": 8,
      "start": 6964.06,
      "end": 6965.32,
      "formatted_start": "01:56:04.060",
      "formatted_end": "01:56:05.320",
      "text": "کنیدش که میدیدید"
    },
    {
      "id": 9,
      "start": 6965.32,
      "end": 6971.96,
      "formatted_start": "01:56:05.320",
      "formatted_end": "01:56:11.960",
      "text": "93"
    },
    {
      "id": 10,
      "start": 6971.96,
      "end": 6972.36,
      "formatted_start": "01:56:11.960",
      "formatted_end": "01:56:12.360",
      "text": "93"
    },
    {
      "id": 11,
      "start": 6972.36,
      "end": 6973.0,
      "formatted_start": "01:56:12.360",
      "formatted_end": "01:56:13.000",
      "text": "93"
    },
    {
      "id": 12,
      "start": 6973.0,
      "end": 6974.0,
      "formatted_start": "01:56:13.000",
      "formatted_end": "01:56:14.000",
      "text": "93"
    },
    {
      "id": 13,
      "start": 6974.0,
      "end": 6976.0,
      "formatted_start": "01:56:14.000",
      "formatted_end": "01:56:16.000",
      "text": "93"
    },
    {
      "id": 14,
      "start": 6976.0,
      "end": 6980.0,
      "formatted_start": "01:56:16.000",
      "formatted_end": "01:56:20.000",
      "text": "93"
    },
    {
      "id": 15,
      "start": 6980.0,
      "end": 6981.98,
      "formatted_start": "01:56:20.000",
      "formatted_end": "01:56:21.980",
      "text": "93"
    },
    {
      "id": 16,
      "start": 6981.98,
      "end": 6983.98,
      "formatted_start": "01:56:21.980",
      "formatted_end": "01:56:23.980",
      "text": "مرسی مهاموش میکنم"
    },
    {
      "id": 17,
      "start": 6983.98,
      "end": 6985.98,
      "formatted_start": "01:56:23.980",
      "formatted_end": "01:56:25.980",
      "text": "اینجا باید یکی هستیم"
    },
    {
      "id": 18,
      "start": 6985.98,
      "end": 6987.98,
      "formatted_start": "01:56:25.980",
      "formatted_end": "01:56:27.980",
      "text": "مرسی"
    },
    {
      "id": 19,
      "start": 6987.98,
      "end": 6989.98,
      "formatted_start": "01:56:27.980",
      "formatted_end": "01:56:29.980",
      "text": "درسته"
    },
    {
      "id": 20,
      "start": 6989.98,
      "end": 6991.98,
      "formatted_start": "01:56:29.980",
      "formatted_end": "01:56:31.980",
      "text": "درسته شما که کنیشیم"
    },
    {
      "id": 21,
      "start": 6991.98,
      "end": 6993.98,
      "formatted_start": "01:56:31.980",
      "formatted_end": "01:56:33.980",
      "text": "خب چی شده؟"
    },
    {
      "id": 22,
      "start": 6993.98,
      "end": 6995.98,
      "formatted_start": "01:56:33.980",
      "formatted_end": "01:56:35.980",
      "text": "ایشب شامانه بود"
    },
    {
      "id": 23,
      "start": 6995.98,
      "end": 6997.98,
      "formatted_start": "01:56:35.980",
      "formatted_end": "01:56:37.980",
      "text": "گفته درد برد"
    },
    {
      "id": 24,
      "start": 6997.98,
      "end": 6999.98,
      "formatted_start": "01:56:37.980",
      "formatted_end": "01:56:39.980",
      "text": "بعدش هم بوده های ساعت درد"
    },
    {
      "id": 25,
      "start": 6999.98,
      "end": 7001.98,
      "formatted_start": "01:56:39.980",
      "formatted_end": "01:56:41.980",
      "text": "از تا این چیزهایی که ازشو"
    },
    {
      "id": 26,
      "start": 7001.98,
      "end": 7003.98,
      "formatted_start": "01:56:41.980",
      "formatted_end": "01:56:43.980",
      "text": "ضرور برده بوده"
    },
    {
      "id": 27,
      "start": 7003.98,
      "end": 7005.98,
      "formatted_start": "01:56:43.980",
      "formatted_end": "01:56:45.980",
      "text": "کجا درد می کرده؟ جایی که درد می کرده؟"
    },
    {
      "id": 28,
      "start": 7005.98,
      "end": 7007.98,
      "formatted_start": "01:56:45.980",
      "formatted_end": "01:56:47.980",
      "text": "اینجا شده بوده"
    },
    {
      "id": 29,
      "start": 7007.98,
      "end": 7009.98,
      "formatted_start": "01:56:47.980",
      "formatted_end": "01:56:49.980",
      "text": "دور نافه شد"
    },
    {
      "id": 30,
      "start": 7009.98,
      "end": 7011.98,
      "formatted_start": "01:56:49.980",
      "formatted_end": "01:56:51.980",
      "text": "دور نافه"
    },
    {
      "id": 31,
      "start": 7011.98,
      "end": 7013.98,
      "formatted_start": "01:56:51.980",
      "formatted_end": "01:56:53.980",
      "text": "خود را دست بسند؟"
    },
    {
      "id": 32,
      "start": 7013.98,
      "end": 7015.98,
      "formatted_start": "01:56:53.980",
      "formatted_end": "01:56:55.980",
      "text": "قبل میره تقایت کن کن"
    },
    {
      "id": 33,
      "start": 7015.98,
      "end": 7017.98,
      "formatted_start": "01:56:55.980",
      "formatted_end": "01:56:57.980",
      "text": "اینجا شد"
    },
    {
      "id": 34,
      "start": 7017.98,
      "end": 7019.98,
      "formatted_start": "01:56:57.980",
      "formatted_end": "01:56:59.980",
      "text": "خودش بگو"
    },
    {
      "id": 35,
      "start": 7019.98,
      "end": 7021.98,
      "formatted_start": "01:56:59.980",
      "formatted_end": "01:57:01.980",
      "text": "میخوام درشوی کنه ولی نمیتونه"
    },
    {
      "id": 36,
      "start": 7021.98,
      "end": 7023.98,
      "formatted_start": "01:57:01.980",
      "formatted_end": "01:57:03.980",
      "text": "میخوام اسپرام بشه ولی نمیتونه بکنم"
    },
    {
      "id": 37,
      "start": 7023.98,
      "end": 7025.98,
      "formatted_start": "01:57:03.980",
      "formatted_end": "01:57:05.980",
      "text": "اینجا هم درد داشت"
    },
    {
      "id": 38,
      "start": 7025.98,
      "end": 7027.98,
      "formatted_start": "01:57:05.980",
      "formatted_end": "01:57:07.980",
      "text": "اکرا اقای همیشه درده"
    },
    {
      "id": 39,
      "start": 7027.98,
      "end": 7029.98,
      "formatted_start": "01:57:07.980",
      "formatted_end": "01:57:09.980",
      "text": "اوه بیوت خانه هم بلازم"
    },
    {
      "id": 40,
      "start": 7029.98,
      "end": 7031.98,
      "formatted_start": "01:57:09.980",
      "formatted_end": "01:57:11.980",
      "text": "بیوت خانه بابایی میاد الان کجا؟"
    },
    {
      "id": 41,
      "start": 7031.98,
      "end": 7033.98,
      "formatted_start": "01:57:11.980",
      "formatted_end": "01:57:13.980",
      "text": "اون اقایی"
    },
    {
      "id": 42,
      "start": 7033.98,
      "end": 7035.98,
      "formatted_start": "01:57:13.980",
      "formatted_end": "01:57:15.980",
      "text": "خود را در روز کنه بابایی اونجا باشه"
    },
    {
      "id": 43,
      "start": 7035.98,
      "end": 7037.98,
      "formatted_start": "01:57:15.980",
      "formatted_end": "01:57:17.980",
      "text": "برنگ زد باز کن"
    },
    {
      "id": 44,
      "start": 7037.98,
      "end": 7039.98,
      "formatted_start": "01:57:17.980",
      "formatted_end": "01:57:19.980",
      "text": "خداحافظ"
    },
    {
      "id": 45,
      "start": 7039.98,
      "end": 7042.98,
      "formatted_start": "01:57:19.980",
      "formatted_end": "01:57:22.980",
      "text": "اشتخام نداره، صبح یکم پرام داشت."
    },
    {
      "id": 46,
      "start": 7042.98,
      "end": 7044.98,
      "formatted_start": "01:57:22.980",
      "formatted_end": "01:57:24.980",
      "text": "هیچی هم نشان داره. اگه بیشتر پرام داره."
    },
    {
      "id": 47,
      "start": 7044.98,
      "end": 7046.98,
      "formatted_start": "01:57:24.980",
      "formatted_end": "01:57:26.980",
      "text": "الان استفاده هم داری؟"
    },
    {
      "id": 48,
      "start": 7046.98,
      "end": 7049.98,
      "formatted_start": "01:57:26.980",
      "formatted_end": "01:57:29.980",
      "text": "نه الان میگه خوبم. ولی صبح تر داشت."
    },
    {
      "id": 49,
      "start": 7049.98,
      "end": 7051.98,
      "formatted_start": "01:57:29.980",
      "formatted_end": "01:57:31.980",
      "text": "الان باید کم بیرون تر شد."
    },
    {
      "id": 50,
      "start": 7053.98,
      "end": 7054.98,
      "formatted_start": "01:57:33.980",
      "formatted_end": "01:57:34.980",
      "text": "صبح میلیم شما؟"
    },
    {
      "id": 51,
      "start": 7054.98,
      "end": 7056.98,
      "formatted_start": "01:57:34.980",
      "formatted_end": "01:57:36.980",
      "text": "الان شما نداشت."
    },
    {
      "id": 52,
      "start": 7057.98,
      "end": 7059.98,
      "formatted_start": "01:57:37.980",
      "formatted_end": "01:57:39.980",
      "text": "ولی صبح داشت الان نه."
    },
    {
      "id": 53,
      "start": 7069.98,
      "end": 7097.98,
      "formatted_start": "01:57:49.980",
      "formatted_end": "01:58:17.980",
      "text": "موسیقی"
    },
    {
      "id": 54,
      "start": 7097.98,
      "end": 7099.98,
      "formatted_start": "01:58:17.980",
      "formatted_end": "01:58:19.980",
      "text": "او روشه"
    },
    {
      "id": 55,
      "start": 7099.98,
      "end": 7101.98,
      "formatted_start": "01:58:19.980",
      "formatted_end": "01:58:21.980",
      "text": "خدا بوده برات ماما"
    },
    {
      "id": 56,
      "start": 7101.98,
      "end": 7103.98,
      "formatted_start": "01:58:21.980",
      "formatted_end": "01:58:23.980",
      "text": "او سفران خوب"
    },
    {
      "id": 57,
      "start": 7103.98,
      "end": 7105.98,
      "formatted_start": "01:58:23.980",
      "formatted_end": "01:58:25.980",
      "text": "یه باکر"
    },
    {
      "id": 58,
      "start": 7105.98,
      "end": 7107.98,
      "formatted_start": "01:58:25.980",
      "formatted_end": "01:58:27.980",
      "text": "خیلی خوب"
    },
    {
      "id": 59,
      "start": 7107.98,
      "end": 7109.98,
      "formatted_start": "01:58:27.980",
      "formatted_end": "01:58:29.980",
      "text": "چی مارده دیروز؟"
    },
    {
      "id": 60,
      "start": 7109.98,
      "end": 7111.98,
      "formatted_start": "01:58:29.980",
      "formatted_end": "01:58:31.980",
      "text": "دیروز بود"
    },
    {
      "id": 61,
      "start": 7111.98,
      "end": 7113.98,
      "formatted_start": "01:58:31.980",
      "formatted_end": "01:58:33.980",
      "text": "نهار شدید"
    },
    {
      "id": 62,
      "start": 7113.98,
      "end": 7115.98,
      "formatted_start": "01:58:33.980",
      "formatted_end": "01:58:35.980",
      "text": "ولی از پیدا شد"
    },
    {
      "id": 63,
      "start": 7115.98,
      "end": 7117.98,
      "formatted_start": "01:58:35.980",
      "formatted_end": "01:58:37.980",
      "text": "یه مکه باقلبه"
    },
    {
      "id": 64,
      "start": 7117.98,
      "end": 7119.98,
      "formatted_start": "01:58:37.980",
      "formatted_end": "01:58:39.980",
      "text": "چیز بود"
    },
    {
      "id": 65,
      "start": 7119.98,
      "end": 7121.98,
      "formatted_start": "01:58:39.980",
      "formatted_end": "01:58:41.980",
      "text": "الان سفران بگیرم ببین"
    },
    {
      "id": 66,
      "start": 7121.98,
      "end": 7123.98,
      "formatted_start": "01:58:41.980",
      "formatted_end": "01:58:43.980",
      "text": "نه نه"
    },
    {
      "id": 67,
      "start": 7123.98,
      "end": 7125.98,
      "formatted_start": "01:58:43.980",
      "formatted_end": "01:58:45.980",
      "text": "ببین تا الان درد می کنی"
    },
    {
      "id": 68,
      "start": 7125.98,
      "end": 7126.98,
      "formatted_start": "01:58:45.980",
      "formatted_end": "01:58:46.980",
      "text": "نه نه"
    },
    {
      "id": 69,
      "start": 7126.98,
      "end": 7128.98,
      "formatted_start": "01:58:46.980",
      "formatted_end": "01:58:48.980",
      "text": "الان پس خوبه"
    },
    {
      "id": 70,
      "start": 7128.98,
      "end": 7130.98,
      "formatted_start": "01:58:48.980",
      "formatted_end": "01:58:50.980",
      "text": "سرام نمیدن"
    },
    {
      "id": 71,
      "start": 7130.98,
      "end": 7132.98,
      "formatted_start": "01:58:50.980",
      "formatted_end": "01:58:52.980",
      "text": "شربت بود"
    },
    {
      "id": 72,
      "start": 7132.98,
      "end": 7134.98,
      "formatted_start": "01:58:52.980",
      "formatted_end": "01:58:54.980",
      "text": "طبرو"
    },
    {
      "id": 73,
      "start": 7134.98,
      "end": 7136.98,
      "formatted_start": "01:58:54.980",
      "formatted_end": "01:58:56.980",
      "text": "طبرو مصنعه نیداشت؟"
    },
    {
      "id": 74,
      "start": 7136.98,
      "end": 7138.98,
      "formatted_start": "01:58:56.980",
      "formatted_end": "01:58:58.980",
      "text": "آره نه"
    },
    {
      "id": 75,
      "start": 7138.98,
      "end": 7140.98,
      "formatted_start": "01:58:58.980",
      "formatted_end": "01:59:00.980",
      "text": "خوابید نیداشت؟"
    },
    {
      "id": 76,
      "start": 7140.98,
      "end": 7142.98,
      "formatted_start": "01:59:00.980",
      "formatted_end": "01:59:02.980",
      "text": "نه نداریم"
    },
    {
      "id": 77,
      "start": 7142.98,
      "end": 7144.98,
      "formatted_start": "01:59:02.980",
      "formatted_end": "01:59:04.980",
      "text": "نه"
    },
    {
      "id": 78,
      "start": 7144.98,
      "end": 7146.98,
      "formatted_start": "01:59:04.980",
      "formatted_end": "01:59:06.980",
      "text": "غذای بیرون اصلا نخورن"
    },
    {
      "id": 79,
      "start": 7146.98,
      "end": 7148.98,
      "formatted_start": "01:59:06.980",
      "formatted_end": "01:59:08.980",
      "text": "غذای سنگیر مثل"
    },
    {
      "id": 80,
      "start": 7148.98,
      "end": 7151.98,
      "formatted_start": "01:59:08.980",
      "formatted_end": "01:59:11.980",
      "text": "تخمه با کتله تکو که توش تخمه بود داره"
    },
    {
      "id": 81,
      "start": 7151.98,
      "end": 7153.98,
      "formatted_start": "01:59:11.980",
      "formatted_end": "01:59:13.980",
      "text": "با چرد نخورن"
    },
    {
      "id": 82,
      "start": 7153.98,
      "end": 7182.98,
      "formatted_start": "01:59:13.980",
      "formatted_end": "01:59:42.980",
      "text": "موسیقی"
    },
    {
      "id": 83,
      "start": 7183.98,
      "end": 7185.48,
      "formatted_start": "01:59:43.980",
      "formatted_end": "01:59:45.480",
      "text": "اصلا شد چی کنی؟"
    },
    {
      "id": 84,
      "start": 7185.48,
      "end": 7188.84,
      "formatted_start": "01:59:45.480",
      "formatted_end": "01:59:48.840",
      "text": "دروهایی که برای جنگ در برای بیدار برای رسخانه مستشید"
    },
    {
      "id": 85,
      "start": 7188.84,
      "end": 7192.6,
      "formatted_start": "01:59:48.840",
      "formatted_end": "01:59:52.600",
      "text": "تب مختصر"
    },
    {
      "id": 86,
      "start": 7192.6,
      "end": 7194.42,
      "formatted_start": "01:59:52.600",
      "formatted_end": "01:59:54.420",
      "text": "درد دور نال"
    },
    {
      "id": 87,
      "start": 7194.42,
      "end": 7196.16,
      "formatted_start": "01:59:54.420",
      "formatted_end": "01:59:56.160",
      "text": "اینو بچه سفر"
    },
    {
      "id": 88,
      "start": 7196.16,
      "end": 7198.66,
      "formatted_start": "01:59:56.160",
      "formatted_end": "01:59:58.660",
      "text": "احساس دفت"
    },
    {
      "id": 89,
      "start": 7198.66,
      "end": 7199.76,
      "formatted_start": "01:59:58.660",
      "formatted_end": "01:59:59.760",
      "text": "اوشه امم"
    }
  ],
  "status": "completed"
}