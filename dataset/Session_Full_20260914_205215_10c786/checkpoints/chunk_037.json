  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11102.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:02.000",
      "text": "اصلا اناب من دارم."
    },
    {
      "id": 1,
      "start": 11102.0,
      "end": 11104.0,
      "formatted_start": "03:05:02.000",
      "formatted_end": "03:05:04.000",
      "text": "او نباید باشه، فعلا."
    },
    {
      "id": 2,
      "start": 11104.0,
      "end": 11110.0,
      "formatted_start": "03:05:04.000",
      "formatted_end": "03:05:10.000",
      "text": "یه ذره تعمل کن تا یه ذره برگرده بشی، هفت-فشت تاریگی به بعد دیگه می توانیم بزنیم."
    },
    {
      "id": 3,
      "start": 11110.0,
      "end": 11112.0,
      "formatted_start": "03:05:10.000",
      "formatted_end": "03:05:12.000",
      "text": "ارام نباید استفاده بکنیم."
    },
    {
      "id": 4,
      "start": 11112.0,
      "end": 11118.0,
      "formatted_start": "03:05:12.000",
      "formatted_end": "03:05:18.000",
      "text": "عطش اسپری، اوتکولون، روژه لب و آرائشی به داشتیم."
    },
    {
      "id": 5,
      "start": 11118.0,
      "end": 11122.0,
      "formatted_start": "03:05:18.000",
      "formatted_end": "03:05:22.000",
      "text": "اونا شیمیایی دیگه ازیب میکنه."
    },
    {
      "id": 6,
      "start": 11122.0,
      "end": 11125.0,
      "formatted_start": "03:05:22.000",
      "formatted_end": "03:05:25.000",
      "text": "ولی خب الان میگی شبا صرفه نمیکنه؟"
    },
    {
      "id": 7,
      "start": 11125.0,
      "end": 11130.0,
      "formatted_start": "03:05:25.000",
      "formatted_end": "03:05:30.000",
      "text": "نه، اما اون سریه دیگه بنده، اون سریه که آدازیده شبان صرفه می کند"
    },
    {
      "id": 8,
      "start": 11130.0,
      "end": 11135.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:35.000",
      "text": "واسه همین ما الان فقط یه سری، موقع صرفه، یه سری ولی به زن فیلن"
    },
    {
      "id": 9,
      "start": 11135.0,
      "end": 11140.0,
      "formatted_start": "03:05:35.000",
      "formatted_end": "03:05:40.000",
      "text": "مثلا موقع صرفه، صرفهش نیست که هی مداران رو لخواد باشه"
    },
    {
      "id": 10,
      "start": 11140.0,
      "end": 11142.0,
      "formatted_start": "03:05:40.000",
      "formatted_end": "03:05:42.000",
      "text": "خب"
    },
    {
      "id": 11,
      "start": 11142.0,
      "end": 11144.0,
      "formatted_start": "03:05:42.000",
      "formatted_end": "03:05:44.000",
      "text": "مرسو"
    },
    {
      "id": 12,
      "start": 11144.0,
      "end": 11146.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:46.000",
      "text": "آراشه"
    },
    {
      "id": 13,
      "start": 11146.0,
      "end": 11148.0,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:48.000",
      "text": "بگیر"
    },
    {
      "id": 14,
      "start": 11148.0,
      "end": 11150.0,
      "formatted_start": "03:05:48.000",
      "formatted_end": "03:05:50.000",
      "text": "مثلا"
    },
    {
      "id": 15,
      "start": 11150.0,
      "end": 11152.0,
      "formatted_start": "03:05:50.000",
      "formatted_end": "03:05:52.000",
      "text": "این هم صرفه"
    },
    {
      "id": 16,
      "start": 11152.0,
      "end": 11154.0,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:05:54.000",
      "text": "صرفه ای که هم مدام"
    },
    {
      "id": 17,
      "start": 11154.0,
      "end": 11156.0,
      "formatted_start": "03:05:54.000",
      "formatted_end": "03:05:56.000",
      "text": "این صرفه"
    },
    {
      "id": 18,
      "start": 11156.0,
      "end": 11158.0,
      "formatted_start": "03:05:56.000",
      "formatted_end": "03:05:58.000",
      "text": "این صرفه"
    },
    {
      "id": 19,
      "start": 11158.0,
      "end": 11160.0,
      "formatted_start": "03:05:58.000",
      "formatted_end": "03:06:00.000",
      "text": "تحلیل که دیگه"
    },
    {
      "id": 20,
      "start": 11160.0,
      "end": 11162.0,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:02.000",
      "text": "الان کرده که بیشتر نداشت"
    },
    {
      "id": 21,
      "start": 11162.0,
      "end": 11164.0,
      "formatted_start": "03:06:02.000",
      "formatted_end": "03:06:04.000",
      "text": "یه ذره تشکیل"
    },
    {
      "id": 22,
      "start": 11164.0,
      "end": 11166.0,
      "formatted_start": "03:06:04.000",
      "formatted_end": "03:06:06.000",
      "text": "ولی اول صبح آره خلطی میشه"
    },
    {
      "id": 23,
      "start": 11166.0,
      "end": 11168.0,
      "formatted_start": "03:06:06.000",
      "formatted_end": "03:06:08.000",
      "text": "کریمی"
    },
    {
      "id": 24,
      "start": 11168.0,
      "end": 11198.0,
      "formatted_start": "03:06:08.000",
      "formatted_end": "03:06:38.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 25,
      "start": 11198.0,
      "end": 11227.98,
      "formatted_start": "03:06:38.000",
      "formatted_end": "03:07:07.980",
      "text": "بودش قطع میشه"
    },
    {
      "id": 26,
      "start": 11228.0,
      "end": 11236.0,
      "formatted_start": "03:07:08.000",
      "formatted_end": "03:07:16.000",
      "text": "اما خودم تو همین دو هفته معیز شده هم گل و درده ها"
    },
    {
      "id": 27,
      "start": 11236.0,
      "end": 11241.0,
      "formatted_start": "03:07:16.000",
      "formatted_end": "03:07:21.000",
      "text": "ما نمیدونم اصلا یعنی که شده ما این که بخواییم مثلا تب کنیم بی حال بشیم"
    },
    {
      "id": 28,
      "start": 11241.0,
      "end": 11243.0,
      "formatted_start": "03:07:21.000",
      "formatted_end": "03:07:23.000",
      "text": "اما گل و درده هم خودم رو داشتم"
    },
    {
      "id": 29,
      "start": 11243.0,
      "end": 11246.0,
      "formatted_start": "03:07:23.000",
      "formatted_end": "03:07:26.000",
      "text": "والا نمیدونم بر همه ها چون هم گرفته یا"
    },
    {
      "id": 30,
      "start": 11246.0,
      "end": 11249.0,
      "formatted_start": "03:07:26.000",
      "formatted_end": "03:07:29.000",
      "text": "شاید اولیشه ویروس بوده ولی خب برنامه رو شده دید"
    },
    {
      "id": 31,
      "start": 11249.0,
      "end": 11253.0,
      "formatted_start": "03:07:29.000",
      "formatted_end": "03:07:33.000",
      "text": "اما تب و دید این معمولا بیشتر همه رو طبیعه اصلا"
    },
    {
      "id": 32,
      "start": 11253.0,
      "end": 11255.0,
      "formatted_start": "03:07:33.000",
      "formatted_end": "03:07:35.000",
      "text": "حد بالا می کنند"
    },
    {
      "id": 33,
      "start": 11255.0,
      "end": 11256.0,
      "formatted_start": "03:07:35.000",
      "formatted_end": "03:07:36.000",
      "text": "تو سرم و پردگی"
    },
    {
      "id": 34,
      "start": 11256.0,
      "end": 11257.0,
      "formatted_start": "03:07:36.000",
      "formatted_end": "03:07:37.000",
      "text": "حالا از ما بگیره"
    },
    {
      "id": 35,
      "start": 11257.0,
      "end": 11258.0,
      "formatted_start": "03:07:37.000",
      "formatted_end": "03:07:38.000",
      "text": "خودش بگیره"
    },
    {
      "id": 36,
      "start": 11258.0,
      "end": 11260.0,
      "formatted_start": "03:07:38.000",
      "formatted_end": "03:07:40.000",
      "text": "همونی سه داره"
    },
    {
      "id": 37,
      "start": 11260.0,
      "end": 11262.0,
      "formatted_start": "03:07:40.000",
      "formatted_end": "03:07:42.000",
      "text": "این میلیوست اولش بوده"
    },
    {
      "id": 38,
      "start": 11262.0,
      "end": 11264.0,
      "formatted_start": "03:07:42.000",
      "formatted_end": "03:07:44.000",
      "text": "همون میلیوست باشه"
    },
    {
      "id": 39,
      "start": 11264.0,
      "end": 11266.0,
      "formatted_start": "03:07:44.000",
      "formatted_end": "03:07:46.000",
      "text": "همون میلیوست هسته"
    },
    {
      "id": 40,
      "start": 11266.0,
      "end": 11268.0,
      "formatted_start": "03:07:46.000",
      "formatted_end": "03:07:48.000",
      "text": "شروط اکسپیکترانت تو دستی کده اینگ داره"
    },
    {
      "id": 41,
      "start": 11268.0,
      "end": 11269.0,
      "formatted_start": "03:07:48.000",
      "formatted_end": "03:07:49.000",
      "text": "میشن"
    },
    {
      "id": 42,
      "start": 11269.0,
      "end": 11270.0,
      "formatted_start": "03:07:49.000",
      "formatted_end": "03:07:50.000",
      "text": "برای اینکه خوشبو کنه"
    },
    {
      "id": 43,
      "start": 11270.0,
      "end": 11271.0,
      "formatted_start": "03:07:50.000",
      "formatted_end": "03:07:51.000",
      "text": "خیلی تاور"
    },
    {
      "id": 44,
      "start": 11271.0,
      "end": 11272.0,
      "formatted_start": "03:07:51.000",
      "formatted_end": "03:07:52.000",
      "text": "کده اینگ داره"
    },
    {
      "id": 45,
      "start": 11272.0,
      "end": 11273.0,
      "formatted_start": "03:07:52.000",
      "formatted_end": "03:07:53.000",
      "text": "من یه ذره خوابابره"
    },
    {
      "id": 46,
      "start": 11273.0,
      "end": 11275.0,
      "formatted_start": "03:07:53.000",
      "formatted_end": "03:07:55.000",
      "text": "یه فودره خیلی تاوره"
    },
    {
      "id": 47,
      "start": 11275.0,
      "end": 11277.0,
      "formatted_start": "03:07:55.000",
      "formatted_end": "03:07:57.000",
      "text": "بخوره هم از هر گلوم برده یه دونه بده"
    },
    {
      "id": 48,
      "start": 11277.0,
      "end": 11282.0,
      "formatted_start": "03:07:57.000",
      "formatted_end": "03:08:02.000",
      "text": "این ایمان هم با دو مدگاری است. یکی موقع صرف یکی هر شیست داره با یکی در اینکه اینه ایمان همه انتویتیکی است."
    },
    {
      "id": 49,
      "start": 11282.0,
      "end": 11286.0,
      "formatted_start": "03:08:02.000",
      "formatted_end": "03:08:06.000",
      "text": "ببینید از صورت خارش یعنی کرمک داره. تو مدکوش کرمک داره."
    },
    {
      "id": 50,
      "start": 11286.0,
      "end": 11291.0,
      "formatted_start": "03:08:06.000",
      "formatted_end": "03:08:11.000",
      "text": "اینجوری که جلو خود از دختر بچه ها هست، پشت میاد جلو شبا هم بیشتره"
    },
    {
      "id": 51,
      "start": 11291.0,
      "end": 11299.0,
      "formatted_start": "03:08:11.000",
      "formatted_end": "03:08:19.000",
      "text": "شبا که اینجوری کنش نشون نمیدونه، اما مثلا در طول روز دستش مثلا جلو شده میخوره"
    },
    {
      "id": 52,
      "start": 11299.0,
      "end": 11305.0,
      "formatted_start": "03:08:19.000",
      "formatted_end": "03:08:25.000",
      "text": "و یه بارم شده، یکی دو بارم شده، خودش شده، اما من در وقت هم درسته ندارم"
    },
    {
      "id": 53,
      "start": 11305.0,
      "end": 11313.0,
      "formatted_start": "03:08:25.000",
      "formatted_end": "03:08:33.000",
      "text": "و ازا خودم میشورم، خودش هم حساس هست، یعنی میدونه با حیفت همیترمه، مراقبه میتونه داده با هم یکی دو با"
    },
    {
      "id": 54,
      "start": 11313.0,
      "end": 11315.0,
      "formatted_start": "03:08:33.000",
      "formatted_end": "03:08:35.000",
      "text": "سوشه اش ادرار که نداره؟"
    },
    {
      "id": 55,
      "start": 11315.0,
      "end": 11317.0,
      "formatted_start": "03:08:35.000",
      "formatted_end": "03:08:37.000",
      "text": "نه، ندارم"
    },
    {
      "id": 56,
      "start": 11319.0,
      "end": 11321.0,
      "formatted_start": "03:08:39.000",
      "formatted_end": "03:08:41.000",
      "text": "میرونش قرار مرد یکی دوش که؟"
    },
    {
      "id": 57,
      "start": 11321.0,
      "end": 11326.0,
      "formatted_start": "03:08:41.000",
      "formatted_end": "03:08:46.000",
      "text": "دوش که ندارم، اما به قضای آداشت بخوادن که یک لحظه بندید برم باشیم"
    },
    {
      "id": 58,
      "start": 11326.0,
      "end": 11327.0,
      "formatted_start": "03:08:46.000",
      "formatted_end": "03:08:47.000",
      "text": "میخواد ببینید؟"
    },
    {
      "id": 59,
      "start": 11327.0,
      "end": 11330.0,
      "formatted_start": "03:08:47.000",
      "formatted_end": "03:08:50.000",
      "text": "آره، تا ما سریع بزنیم، چون دیگه عملت تعمل شده"
    },
    {
      "id": 60,
      "start": 11330.0,
      "end": 11333.0,
      "formatted_start": "03:08:50.000",
      "formatted_end": "03:08:53.000",
      "text": "بذاره باید فروش باشیم، درمو نوشتم"
    },
    {
      "id": 61,
      "start": 11333.0,
      "end": 11335.0,
      "formatted_start": "03:08:53.000",
      "formatted_end": "03:08:55.000",
      "text": "الان در رو ببنیم که مریض نداریم"
    },
    {
      "id": 62,
      "start": 11335.0,
      "end": 11336.0,
      "formatted_start": "03:08:55.000",
      "formatted_end": "03:08:56.000",
      "text": "یک لحظه؟"
    },
    {
      "id": 63,
      "start": 11336.0,
      "end": 11339.0,
      "formatted_start": "03:08:56.000",
      "formatted_end": "03:08:59.000",
      "text": "درکه شده در یک لحظه برم باشیم"
    },
    {
      "id": 64,
      "start": 11343.0,
      "end": 11371.0,
      "formatted_start": "03:09:03.000",
      "formatted_end": "03:09:31.000",
      "text": "موسیقی"
    },
    {
      "id": 65,
      "start": 11371.0,
      "end": 11375.0,
      "formatted_start": "03:09:31.000",
      "formatted_end": "03:09:35.000",
      "text": "از اینکه خوشی نداره، برای خوشی باید کلمه سرخا کنازر بزن"
    },
    {
      "id": 66,
      "start": 11375.0,
      "end": 11378.0,
      "formatted_start": "03:09:35.000",
      "formatted_end": "03:09:38.000",
      "text": "و اصلا خیص نمانه، شرط پاش نکنه"
    },
    {
      "id": 67,
      "start": 11378.0,
      "end": 11382.0,
      "formatted_start": "03:09:38.000",
      "formatted_end": "03:09:42.000",
      "text": "شبا ماساج چیزو باید ملایم استشوار جلوش بدیه"
    },
    {
      "id": 68,
      "start": 11382.0,
      "end": 11387.0,
      "formatted_start": "03:09:42.000",
      "formatted_end": "03:09:47.000",
      "text": "برای خوشی خیص اصلا نمانه، جیشین کنه فوری خوش کنه خودشو با دست مکاقزی"
    },
    {
      "id": 69,
      "start": 11387.0,
      "end": 11389.0,
      "formatted_start": "03:09:47.000",
      "formatted_end": "03:09:49.000",
      "text": "و شرط هم پاش نکنه"
    },
    {
      "id": 70,
      "start": 11389.0,
      "end": 11393.0,
      "formatted_start": "03:09:49.000",
      "formatted_end": "03:09:53.000",
      "text": "و باز هم به منتون برای کرمکش دفت کنه"
    },
    {
      "id": 71,
      "start": 11394.0,
      "end": 11398.0,
      "formatted_start": "03:09:54.000",
      "formatted_end": "03:09:58.000",
      "text": "برای این کرمه رو باید قسمت داخله بگو یه فرق بهتون میداره"
    },
    {
      "id": 72,
      "start": 11398.0,
      "end": 11399.9,
      "formatted_start": "03:09:58.000",
      "formatted_end": "03:09:59.900",
      "text": "یه سر بیرون"
    }
  ],
  "status": "completed"
}