      "end": 14289.0,
      "formatted_start": "03:58:06.000",
      "formatted_end": "03:58:09.000",
      "text": "میخوایم قطره برنیسیم چون قطره ای کارم که خیلی خوبه"
    },
    {
      "id": 38,
      "start": 14289.0,
      "end": 14290.0,
      "formatted_start": "03:58:09.000",
      "formatted_end": "03:58:10.000",
      "text": "یه کنیم سی سی"
    },
    {
      "id": 39,
      "start": 14290.0,
      "end": 14291.0,
      "formatted_start": "03:58:10.000",
      "formatted_end": "03:58:11.000",
      "text": "آره"
    },
    {
      "id": 40,
      "start": 14291.0,
      "end": 14292.0,
      "formatted_start": "03:58:11.000",
      "formatted_end": "03:58:12.000",
      "text": "آره"
    },
    {
      "id": 41,
      "start": 14292.0,
      "end": 14294.0,
      "formatted_start": "03:58:12.000",
      "formatted_end": "03:58:14.000",
      "text": "و تنش هم خوبه بچه ها که میخورن"
    },
    {
      "id": 42,
      "start": 14294.0,
      "end": 14295.0,
      "formatted_start": "03:58:14.000",
