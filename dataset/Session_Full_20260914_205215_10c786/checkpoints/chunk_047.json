  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14129.98,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 14130.0,
      "end": 14160.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:56:00.000",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 2,
      "start": 14160.0,
      "end": 14164.0,
      "formatted_start": "03:56:00.000",
      "formatted_end": "03:56:04.000",
      "text": "از اینکن ازمائش براش بریم بسیاریم"
    },
    {
      "id": 3,
      "start": 14164.0,
      "end": 14168.0,
      "formatted_start": "03:56:04.000",
      "formatted_end": "03:56:08.000",
      "text": "ازمائش افونت اینها نمیخواهید به حال دردیش"
    },
    {
      "id": 4,
      "start": 14168.0,
      "end": 14170.0,
      "formatted_start": "03:56:08.000",
      "formatted_end": "03:56:10.000",
      "text": "ببینم که من رو براتون بگم"
    },
    {
      "id": 5,
      "start": 14170.0,
      "end": 14172.0,
      "formatted_start": "03:56:10.000",
      "formatted_end": "03:56:12.000",
      "text": "بگیر بچه رو"
    },
    {
      "id": 6,
      "start": 14172.0,
      "end": 14178.0,
      "formatted_start": "03:56:12.000",
      "formatted_end": "03:56:18.000",
      "text": "الان ما بساییم برای خاک خوریش ازمائششو افونت الان بدیم"
    },
    {
      "id": 7,
      "start": 14178.0,
      "end": 14180.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:20.000",
      "text": "آهنش میره بالا"
    },
    {
      "id": 8,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "افونت آهن بالا نشون دادی"
    },
    {
      "id": 9,
      "start": 14182.0,
      "end": 14184.0,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:24.000",
      "text": "همه ازمائشگاه"
    },
    {
      "id": 10,
      "start": 14184.0,
      "end": 14186.0,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:26.000",
      "text": "پایده نداره"
    },
    {
      "id": 11,
      "start": 14186.0,
      "end": 14188.0,
      "formatted_start": "03:56:26.000",
      "formatted_end": "03:56:28.000",
      "text": "و اینکه افونت رو داره"
    },
    {
      "id": 12,
      "start": 14188.0,
      "end": 14194.0,
      "formatted_start": "03:56:28.000",
      "formatted_end": "03:56:34.000",
      "text": "همینی داره. شما طبش که کلن قرار شد باید برای یا کم خونیش آزمایششو بدی."
    },
    {
      "id": 13,
      "start": 14194.0,
      "end": 14197.0,
      "formatted_start": "03:56:34.000",
      "formatted_end": "03:56:37.000",
      "text": "من تو سیسته کنم که چهار هفته هست."
    },
    {
      "id": 14,
      "start": 14197.0,
      "end": 14199.0,
      "formatted_start": "03:56:37.000",
      "formatted_end": "03:56:39.000",
      "text": "جوابشو برای من گویده وقتی طب قرار شد."
    },
    {
      "id": 15,
      "start": 14199.0,
      "end": 14200.0,
      "formatted_start": "03:56:39.000",
      "formatted_end": "03:56:40.000",
      "text": "باشه."
    },
    {
      "id": 16,
      "start": 14200.0,
      "end": 14202.0,
      "formatted_start": "03:56:40.000",
      "formatted_end": "03:56:42.000",
      "text": "ولی الان باید یه سران بزنیم."
    },
    {
      "id": 17,
      "start": 14202.0,
      "end": 14203.0,
      "formatted_start": "03:56:42.000",
      "formatted_end": "03:56:43.000",
      "text": "باش. آره."
    },
    {
      "id": 18,
      "start": 14203.0,
      "end": 14204.0,
      "formatted_start": "03:56:43.000",
      "formatted_end": "03:56:44.000",
      "text": "آشان اصلا هیچکم نداره."
    },
    {
      "id": 19,
      "start": 14204.0,
      "end": 14208.0,
      "formatted_start": "03:56:44.000",
      "formatted_end": "03:56:48.000",
      "text": "و درباره که میدهم هم باید تا یک هفته استفاده کنیم."
    },
    {
      "id": 20,
      "start": 14208.0,
      "end": 14210.0,
      "formatted_start": "03:56:48.000",
      "formatted_end": "03:56:50.000",
      "text": "پنج تا هفت روز بگیر."
    },
    {
      "id": 21,
      "start": 14210.0,
      "end": 14213.0,
      "formatted_start": "03:56:50.000",
      "formatted_end": "03:56:53.000",
      "text": "استفراق چی؟ استفراق نداره."
    },
    {
      "id": 22,
      "start": 14213.0,
      "end": 14218.0,
      "formatted_start": "03:56:53.000",
      "formatted_end": "03:56:58.000",
      "text": "خلص چی؟ خلص نداره، آفیزش بیرون تک و دلدرت"
    },
    {
      "id": 23,
      "start": 14218.0,
      "end": 14223.0,
      "formatted_start": "03:56:58.000",
      "formatted_end": "03:57:03.000",
      "text": "آفیزش بیشتبای کامل یعنی چی نمی کنه"
    },
    {
      "id": 24,
      "start": 14223.0,
      "end": 14228.0,
      "formatted_start": "03:57:03.000",
      "formatted_end": "03:57:08.000",
      "text": "بر آن پرو به چه پشتونم می رسیم؟ داخلش برم"
    },
    {
      "id": 25,
      "start": 14228.0,
      "end": 14234.0,
      "formatted_start": "03:57:08.000",
      "formatted_end": "03:57:14.000",
      "text": "کم سالشه؟ الان دو سال و نیمه"
    },
    {
      "id": 26,
      "start": 14234.0,
      "end": 14238.0,
      "formatted_start": "03:57:14.000",
      "formatted_end": "03:57:18.000",
      "text": "بردی بهش تولدش بودی دو سال و نیمه"
    },
    {
      "id": 27,
      "start": 14238.0,
      "end": 14241.0,
      "formatted_start": "03:57:18.000",
      "formatted_end": "03:57:21.000",
      "text": "دو سال و سه چه آن و نیمه"
    },
    {
      "id": 28,
      "start": 14241.0,
      "end": 14256.0,
      "formatted_start": "03:57:21.000",
      "formatted_end": "03:57:36.000",
      "text": "موسیقی"
    },
    {
      "id": 29,
      "start": 14256.0,
      "end": 14261.0,
      "formatted_start": "03:57:36.000",
      "formatted_end": "03:57:41.000",
      "text": "ناله هم داره؟ آره از بدندرد؟ آره آره"
    },
    {
      "id": 30,
      "start": 14261.0,
      "end": 14266.0,
      "formatted_start": "03:57:41.000",
      "formatted_end": "03:57:46.000",
      "text": "ناپارانتا شده گلو گرد آره تشوی بدندرد و ناله و تب و..."
    },
    {
      "id": 31,
      "start": 14266.0,
      "end": 14272.0,
      "formatted_start": "03:57:46.000",
      "formatted_end": "03:57:52.000",
      "text": "پس هر موقع دار واشت تموم شد، بهتر شد من دارم آزماش رو بدم"
    },
    {
      "id": 32,
      "start": 14272.0,
      "end": 14274.0,
      "formatted_start": "03:57:52.000",
      "formatted_end": "03:57:54.000",
      "text": "بله بله باش"
    },
    {
      "id": 33,
      "start": 14274.0,
      "end": 14277.0,
      "formatted_start": "03:57:54.000",
      "formatted_end": "03:57:57.000",
      "text": "یه ماش آزم باش"
    },
    {
      "id": 34,
      "start": 14277.0,
      "end": 14280.0,
      "formatted_start": "03:57:57.000",
      "formatted_end": "03:58:00.000",
      "text": "یه ماش آزم باش"
    },
    {
