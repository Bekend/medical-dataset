  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10519.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:19.000",
      "text": "بیاز خانف، پلورنی، مشابه دلستر تا سمایی نوارد بکنی، آخر سمایی، ماساج شکم بده با روغن شکمشو، صدای جربه سشوه حرکت ماشین برش داره، شیر گیگوز یک یا نان کامفورت برای دلت میخواه شیر بهتر شده."
    },
    {
      "id": 1,
      "start": 10519.0,
      "end": 10523.0,
      "formatted_start": "02:55:19.000",
      "formatted_end": "02:55:23.000",
      "text": "آهان، اینو شیر خوشکنه بگیرم. اینو باید با من شیشه بدن یا نه دیگه؟"
    },
    {
      "id": 2,
      "start": 10523.0,
      "end": 10528.0,
      "formatted_start": "02:55:23.000",
      "formatted_end": "02:55:28.000",
      "text": "ببین اینکه شیر مادر رو نمیگیره، اون دیگه راهکارش دست خودته."
    },
    {
      "id": 3,
      "start": 10528.0,
      "end": 10532.0,
      "formatted_start": "02:55:28.000",
      "formatted_end": "02:55:32.000",
      "text": "اگر میگیره باید اون رو با شیشه بدی که عادت نکنه به شیشه"
    },
    {
      "id": 4,
      "start": 10532.0,
      "end": 10534.0,
      "formatted_start": "02:55:32.000",
      "formatted_end": "02:55:34.000",
      "text": "با دوستورنگ بدی که عادت به شیشه نکنه"
    },
    {
      "id": 5,
      "start": 10534.0,
      "end": 10538.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:38.000",
      "text": "اگه حرات ها رو گرفت با شیشه بده راحترین"
    },
    {
      "id": 6,
      "start": 10538.0,
      "end": 10540.0,
      "formatted_start": "02:55:38.000",
      "formatted_end": "02:55:40.000",
      "text": "دیگه این رو تو خونه شما متوجه میشید"
    },
    {
      "id": 7,
      "start": 10540.0,
      "end": 10543.0,
      "formatted_start": "02:55:40.000",
      "formatted_end": "02:55:43.000",
      "text": "بخواد مقابلت کنه برای سینه مجبور شیشه رو بدید"
    },
    {
      "id": 8,
      "start": 10543.0,
      "end": 10546.0,
      "formatted_start": "02:55:43.000",
      "formatted_end": "02:55:46.000",
      "text": "حالا شاید مقابلتون که من میشم ازشم برمدیم"
    },
    {
      "id": 9,
      "start": 10546.0,
      "end": 10548.0,
      "formatted_start": "02:55:46.000",
      "formatted_end": "02:55:48.000",
      "text": "برای شیشه دادم شو"
    },
    {
      "id": 10,
      "start": 10548.0,
      "end": 10549.0,
      "formatted_start": "02:55:48.000",
      "formatted_end": "02:55:49.000",
      "text": "آره آره"
    },
    {
      "id": 11,
      "start": 10549.0,
      "end": 10552.0,
      "formatted_start": "02:55:49.000",
      "formatted_end": "02:55:52.000",
      "text": "برای وزگیری دهنش بدی"
    },
    {
      "id": 12,
      "start": 10552.0,
      "end": 10554.0,
      "formatted_start": "02:55:52.000",
      "formatted_end": "02:55:54.000",
      "text": "روزی چند بار بدهمش؟ چند سی سی نام؟"
    },
    {
      "id": 13,
      "start": 10554.0,
      "end": 10558.0,
      "formatted_start": "02:55:54.000",
      "formatted_end": "02:55:58.000",
      "text": "دیگه دو سه بار هر بار هم یه تیمانی خط رو بدیم"
    },
    {
      "id": 14,
      "start": 10558.0,
      "end": 10559.0,
      "formatted_start": "02:55:58.000",
      "formatted_end": "02:55:59.000",
      "text": "سی سی سی"
    },
    {
      "id": 15,
      "start": 10559.0,
      "end": 10560.0,
      "formatted_start": "02:55:59.000",
      "formatted_end": "02:56:00.000",
      "text": "سی تا"
    },
    {
      "id": 16,
      "start": 10560.0,
      "end": 10562.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:02.000",
      "text": "روزی دو بار"
    },
    {
      "id": 17,
      "start": 10562.0,
      "end": 10564.0,
      "formatted_start": "02:56:02.000",
      "formatted_end": "02:56:04.000",
      "text": "همونی که همون شده گه"
    },
    {
      "id": 18,
      "start": 10564.0,
      "end": 10566.0,
      "formatted_start": "02:56:04.000",
      "formatted_end": "02:56:06.000",
      "text": "اینو الان نمی بودید که"
    },
    {
      "id": 19,
      "start": 10566.0,
      "end": 10568.0,
      "formatted_start": "02:56:06.000",
      "formatted_end": "02:56:08.000",
      "text": "الان روزی با دوست شده"
    },
    {
      "id": 20,
      "start": 10568.0,
      "end": 10570.0,
      "formatted_start": "02:56:08.000",
      "formatted_end": "02:56:10.000",
      "text": "پس شیر خوردنش هم یه جوری که میخوابه زیر سیر نفرنگ"
    },
    {
      "id": 21,
      "start": 10570.0,
      "end": 10573.0,
      "formatted_start": "02:56:10.000",
      "formatted_end": "02:56:13.000",
      "text": "اگر باز بیدار میشه دوباره خودت کامل سیر نمیکنه"
    },
    {
      "id": 22,
      "start": 10574.0,
      "end": 10577.0,
      "formatted_start": "02:56:14.000",
      "formatted_end": "02:56:17.000",
      "text": "یه دانه چیز هم گره تا سرش نشون دادی؟"
    },
    {
      "id": 23,
      "start": 10577.0,
      "end": 10579.82,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:19.820",
      "text": "حالا نیست، اما افراد بسیاری کنید"
    },
    {
      "id": 24,
      "start": 10579.82,
      "end": 10583.46,
      "formatted_start": "02:56:19.820",
      "formatted_end": "02:56:23.460",
      "text": "بعضی وقتی که بیشتر میشه خواهد بکنه، من بیشتر نگرانم اون روزششم"
    },
    {
      "id": 25,
      "start": 10583.46,
      "end": 10585.66,
      "formatted_start": "02:56:23.460",
      "formatted_end": "02:56:25.660",
      "text": "باید شیر بکنه، غدشون نیفتن"
    },
    {
      "id": 26,
      "start": 10585.66,
      "end": 10587.66,
      "formatted_start": "02:56:25.660",
      "formatted_end": "02:56:27.660",
      "text": "بعد بیفته، پرش بیشتر میشه"
    },
    {
      "id": 27,
      "start": 10587.66,
      "end": 10590.56,
      "formatted_start": "02:56:27.660",
      "formatted_end": "02:56:30.560",
      "text": "دقیقا همینجوریه، شب بکنم میشم، اینو سا میبینم که"
    },
    {
      "id": 28,
      "start": 10590.56,
      "end": 10591.56,
      "formatted_start": "02:56:30.560",
      "formatted_end": "02:56:31.560",
      "text": "کشتی هست میدهن"
    },
    {
      "id": 29,
      "start": 10591.56,
      "end": 10593.56,
      "formatted_start": "02:56:31.560",
      "formatted_end": "02:56:33.560",
      "text": "نخوردار، به زورت دهنش میکنم، بیدارش میکنم"
    },
    {
      "id": 30,
      "start": 10593.56,
      "end": 10594.56,
      "formatted_start": "02:56:33.560",
      "formatted_end": "02:56:34.560",
      "text": "بیدار نمیشه"
    },
    {
      "id": 31,
      "start": 10594.56,
      "end": 10595.56,
      "formatted_start": "02:56:34.560",
      "formatted_end": "02:56:35.560",
      "text": "مشکل ندهد برای؟"
    },
    {
      "id": 32,
      "start": 10595.56,
      "end": 10599.56,
      "formatted_start": "02:56:35.560",
      "formatted_end": "02:56:39.560",
      "text": "باش بزن، ببین یه لحظه ها کن دیگه همه چیزی بیشتر اون سوال کنم"
    },
    {
      "id": 33,
      "start": 10599.56,
      "end": 10602.56,
      "formatted_start": "02:56:39.560",
      "formatted_end": "02:56:42.560",
      "text": "چند تا من اینجا دارم این کاری بکنم شیره خوش میدارم سالهای شما"
    },
    {
      "id": 34,
      "start": 10602.56,
      "end": 10604.56,
      "formatted_start": "02:56:42.560",
      "formatted_end": "02:56:44.560",
      "text": "یکی یکی سوال کنید"
    },
    {
      "id": 35,
      "start": 10604.56,
      "end": 10607.56,
      "formatted_start": "02:56:44.560",
      "formatted_end": "02:56:47.560",
      "text": "مشکلی فیلم رو دیدم، خب اون اشکال نداره"
    },
    {
      "id": 36,
      "start": 10607.56,
      "end": 10611.56,
      "formatted_start": "02:56:47.560",
      "formatted_end": "02:56:51.560",
      "text": "اگر به خواد خیلی زیاد بشه، وانگه داشتن کنترل نشه"
    },
    {
      "id": 37,
      "start": 10611.56,
      "end": 10614.56,
      "formatted_start": "02:56:51.560",
      "formatted_end": "02:56:54.560",
      "text": "و بچه بعدش خواه بالود بشه، چرا؟ اشکال داره"
    },
    {
      "id": 38,
      "start": 10614.56,
      "end": 10617.56,
      "formatted_start": "02:56:54.560",
      "formatted_end": "02:56:57.560",
      "text": "ولی اینکه عکس برای من گرفتی اینو مشکلی نمیشه"
    },
    {
      "id": 39,
      "start": 10617.56,
      "end": 10620.14,
      "formatted_start": "02:56:57.560",
      "formatted_end": "02:57:00.140",
      "text": "الان هم تو مایره من چیزی نیدم به نفع مشکل"
    },
    {
      "id": 40,
      "start": 10620.14,
      "end": 10624.56,
      "formatted_start": "02:57:00.140",
      "formatted_end": "02:57:04.560",
      "text": "ولی اینکه الان مثلا بگی کلن اشکال نداره شراره دید اشکال داره ایناست"
    },
    {
      "id": 41,
      "start": 10624.56,
      "end": 10627.14,
      "formatted_start": "02:57:04.560",
      "formatted_end": "02:57:07.140",
      "text": "خیلی طولانی بشه با نگه داشن اسپیس نکنه"
    },
    {
      "id": 42,
      "start": 10627.14,
      "end": 10630.24,
      "formatted_start": "02:57:07.140",
      "formatted_end": "02:57:10.240",
      "text": "و بعدش بچه خوالود بشه خسته بشه"
    },
    {
      "id": 43,
      "start": 10630.24,
      "end": 10636.22,
      "formatted_start": "02:57:10.240",
      "formatted_end": "02:57:16.220",
      "text": "حطره عاده که میدید"
    },
    {
      "id": 44,
      "start": 10636.22,
      "end": 10637.56,
      "formatted_start": "02:57:16.220",
      "formatted_end": "02:57:17.560",
      "text": "آره روزی بسیار شد"
    },
    {
      "id": 45,
      "start": 10637.56,
      "end": 10640.48,
      "formatted_start": "02:57:17.560",
      "formatted_end": "02:57:20.480",
      "text": "یعنی پاش نگه دارم دوباره"
    },
    {
      "id": 46,
      "start": 10640.48,
      "end": 10641.66,
      "formatted_start": "02:57:20.480",
      "formatted_end": "02:57:21.660",
      "text": "باید ثابت بشه دیگه"
    },
    {
      "id": 47,
      "start": 10641.66,
      "end": 10642.94,
      "formatted_start": "02:57:21.660",
      "formatted_end": "02:57:22.940",
      "text": "برای دسته باید تکنیم"
    },
    {
      "id": 48,
      "start": 10642.94,
      "end": 10644.94,
      "formatted_start": "02:57:22.940",
      "formatted_end": "02:57:24.940",
      "text": "باید باز دوباره اگذت چی؟"
    },
    {
      "id": 49,
      "start": 10644.94,
      "end": 10649.94,
      "formatted_start": "02:57:24.940",
      "formatted_end": "02:57:29.940",
      "text": "دوباره اگر بخواد خیلی تکرار بشه باید ما یک نوار مغز بگیریم ازش دیگه"
    },
    {
      "id": 50,
      "start": 10649.94,
      "end": 10652.94,
      "formatted_start": "02:57:29.940",
      "formatted_end": "02:57:32.940",
      "text": "اگر بخواد خیلی تکرار بشه یک نوار مغز"
    },
    {
      "id": 51,
      "start": 10652.94,
      "end": 10657.94,
      "formatted_start": "02:57:32.940",
      "formatted_end": "02:57:37.940",
      "text": "خب اگر مثلا میزنه کاش نگه هم دارم خودم خب؟ باز میبینم کسان دوباره داره میزنه"
    },
    {
      "id": 52,
      "start": 10659.94,
      "end": 10662.94,
      "formatted_start": "02:57:39.940",
      "formatted_end": "02:57:42.940",
      "text": "اون رو باید یک نوار مغز بگیریم اگر بخواد خیلی تکرار بشه"
    },
    {
      "id": 53,
      "start": 10662.94,
      "end": 10664.94,
      "formatted_start": "02:57:42.940",
      "formatted_end": "02:57:44.940",
      "text": "روکتون روست نگه نگه بگم"
    },
    {
      "id": 54,
      "start": 10664.94,
      "end": 10666.94,
      "formatted_start": "02:57:44.940",
      "formatted_end": "02:57:46.940",
      "text": "اون کار ما نیستی، اون حقوقت نداریم"
    },
    {
      "id": 55,
      "start": 10666.94,
      "end": 10672.28,
      "formatted_start": "02:57:46.940",
      "formatted_end": "02:57:52.280",
      "text": "بررسی ناروزی اطلاعات به کمال مغز و تشنج آیا این تشنجه یا نه"
    },
    {
      "id": 56,
      "start": 10672.28,
      "end": 10674.56,
      "formatted_start": "02:57:52.280",
      "formatted_end": "02:57:54.560",
      "text": "نه اینجا نیست"
    },
    {
      "id": 57,
      "start": 10674.56,
      "end": 10677.28,
      "formatted_start": "02:57:54.560",
      "formatted_end": "02:57:57.280",
      "text": "خواهد مطمئن بشی باید نوار مغز بگیریم"
    },
    {
      "id": 58,
      "start": 10677.28,
      "end": 10679.48,
      "formatted_start": "02:57:57.280",
      "formatted_end": "02:57:59.480",
      "text": "باید بشی"
    },
    {
      "id": 59,
      "start": 10679.48,
      "end": 10684.4,
      "formatted_start": "02:57:59.480",
      "formatted_end": "02:58:04.400",
      "text": "میخواییم تو بیمیگم نه در این مقشه باید در این مقشه بشیم"
    },
    {
      "id": 60,
      "start": 10684.4,
      "end": 10688.4,
      "formatted_start": "02:58:04.400",
      "formatted_end": "02:58:08.400",
      "text": "ببین در مایی دل پیچه و شیر خوش کنه بشتم"
    },
    {
      "id": 61,
      "start": 10688.4,
      "end": 10692.68,
      "formatted_start": "02:58:08.400",
      "formatted_end": "02:58:12.680",
      "text": "شما توصیه های برای دل پیچه هم دادم تا قطعه قصر عادل کنه باشیم"
    },
    {
      "id": 62,
      "start": 10692.68,
      "end": 10693.6,
      "formatted_start": "02:58:12.680",
      "formatted_end": "02:58:13.600",
      "text": "شیر تا عوض کنه بشیم"
    },
    {
      "id": 63,
      "start": 10693.6,
      "end": 10696.6,
      "formatted_start": "02:58:13.600",
      "formatted_end": "02:58:16.600",
      "text": "این رو باید بهش بدن درکتر با یک دلگستید هم میگوید"
    },
    {
      "id": 64,
      "start": 10696.6,
      "end": 10698.6,
      "formatted_start": "02:58:16.600",
      "formatted_end": "02:58:18.600",
      "text": "او تا آخر شیشه تمام شد دیگه قطعا"
    },
    {
      "id": 65,
      "start": 10698.6,
      "end": 10699.6,
      "formatted_start": "02:58:18.600",
      "formatted_end": "02:58:19.600",
      "text": "دلگستید؟"
    },
    {
      "id": 66,
      "start": 10699.6,
      "end": 10701.6,
      "formatted_start": "02:58:19.600",
      "formatted_end": "02:58:21.600",
      "text": "تا آخر شیشه ای که دارید ولی تمام شد دیگه قطعا"
    },
    {
      "id": 67,
      "start": 10701.6,
      "end": 10703.6,
      "formatted_start": "02:58:21.600",
      "formatted_end": "02:58:23.600",
      "text": "چون وزنش داره به 3 میرسه"
    },
    {
      "id": 68,
      "start": 10703.6,
      "end": 10704.6,
      "formatted_start": "02:58:23.600",
      "formatted_end": "02:58:24.600",
      "text": "امم"
    },
    {
      "id": 69,
      "start": 10704.6,
      "end": 10707.6,
      "formatted_start": "02:58:24.600",
      "formatted_end": "02:58:27.600",
      "text": "چون گویش دلگستید یک چاله میباشه بهش بده"
    },
    {
      "id": 70,
      "start": 10707.6,
      "end": 10708.6,
      "formatted_start": "02:58:27.600",
      "formatted_end": "02:58:28.600",
      "text": "قرصه را بیشتر"
    },
    {
      "id": 71,
      "start": 10708.6,
      "end": 10714.6,
      "formatted_start": "02:58:28.600",
      "formatted_end": "02:58:34.600",
      "text": "دارم میگم که خامچه جان تا وقتی که داری قرصه تو دیگه تمام شد نداری"
    },
    {
      "id": 72,
      "start": 10714.6,
      "end": 10716.6,
      "formatted_start": "02:58:34.600",
      "formatted_end": "02:58:36.600",
      "text": "چون وزنش به 3 داره میرسه"
    },
    {
      "id": 73,
      "start": 10716.6,
      "end": 10718.6,
      "formatted_start": "02:58:36.600",
      "formatted_end": "02:58:38.600",
      "text": "باجه میستن"
    },
    {
      "id": 74,
      "start": 10720.6,
      "end": 10724.6,
      "formatted_start": "02:58:40.600",
      "formatted_end": "02:58:44.600",
      "text": "این الان متناجم به اینکه RBC داره"
    },
    {
      "id": 75,
      "start": 10724.6,
      "end": 10726.6,
      "formatted_start": "02:58:44.600",
      "formatted_end": "02:58:46.600",
      "text": "منکورش نیست"
    },
    {
      "id": 76,
      "start": 10726.6,
      "end": 10728.6,
      "formatted_start": "02:58:46.600",
      "formatted_end": "02:58:48.600",
      "text": "بوبیش نیست"
    },
    {
      "id": 77,
      "start": 10728.6,
      "end": 10730.6,
      "formatted_start": "02:58:48.600",
      "formatted_end": "02:58:50.600",
      "text": "نان بودش بودش"
    },
    {
      "id": 78,
      "start": 10730.6,
      "end": 10732.6,
      "formatted_start": "02:58:50.600",
      "formatted_end": "02:58:52.600",
      "text": "اینکه نه بشنه بشنه"
    },
    {
      "id": 79,
      "start": 10732.6,
      "end": 10734.6,
      "formatted_start": "02:58:52.600",
      "formatted_end": "02:58:54.600",
      "text": "باید بشنه باشید"
    },
    {
      "id": 80,
      "start": 10734.6,
      "end": 10736.6,
      "formatted_start": "02:58:54.600",
      "formatted_end": "02:58:56.600",
      "text": "بگو اگر هسته شد"
    },
    {
      "id": 81,
      "start": 10736.6,
      "end": 10738.6,
      "formatted_start": "02:58:56.600",
      "formatted_end": "02:58:58.600",
      "text": "نان بشنه باشه"
    },
    {
      "id": 82,
      "start": 10738.6,
      "end": 10740.6,
      "formatted_start": "02:58:58.600",
      "formatted_end": "02:59:00.600",
      "text": "نان بشنه باشه"
    },
    {
      "id": 83,
      "start": 10740.6,
      "end": 10742.6,
      "formatted_start": "02:59:00.600",
      "formatted_end": "02:59:02.600",
      "text": "نان بشنه باشه"
    },
    {
      "id": 84,
      "start": 10742.6,
      "end": 10744.6,
      "formatted_start": "02:59:02.600",
      "formatted_end": "02:59:04.600",
      "text": "نان بشنه باشه"
    },
    {
      "id": 85,
      "start": 10744.6,
      "end": 10746.6,
      "formatted_start": "02:59:04.600",
      "formatted_end": "02:59:06.600",
      "text": "برای شما نان و اوترا براش بشید"
    },
    {
      "id": 86,
      "start": 10746.6,
      "end": 10748.6,
      "formatted_start": "02:59:06.600",
      "formatted_end": "02:59:08.600",
      "text": "نان و اوترا براش بشید"
    },
    {
      "id": 87,
      "start": 10748.6,
      "end": 10750.6,
      "formatted_start": "02:59:08.600",
      "formatted_end": "02:59:10.600",
      "text": "نان و اوترا براش بشید"
    },
    {
      "id": 88,
      "start": 10750.6,
      "end": 10752.6,
      "formatted_start": "02:59:10.600",
      "formatted_end": "02:59:12.600",
      "text": "نان و اوترا براش بشید"
    },
    {
      "id": 89,
      "start": 10752.6,
      "end": 10754.6,
      "formatted_start": "02:59:12.600",
      "formatted_end": "02:59:14.600",
      "text": "نان و اوترا براش بشید"
    },
    {
      "id": 90,
      "start": 10754.6,
      "end": 10756.6,
      "formatted_start": "02:59:14.600",
      "formatted_end": "02:59:16.600",
      "text": "شیرش نان و اوترا بشید"
    },
    {
      "id": 91,
      "start": 10756.6,
      "end": 10758.6,
      "formatted_start": "02:59:16.600",
      "formatted_end": "02:59:18.600",
      "text": "شیرش نان و اوترا بشید"
    },
    {
      "id": 92,
      "start": 10758.6,
      "end": 10760.6,
      "formatted_start": "02:59:18.600",
      "formatted_end": "02:59:20.600",
      "text": "شیرش نان و اوترا بشید"
    },
    {
      "id": 93,
      "start": 10760.6,
      "end": 10762.6,
      "formatted_start": "02:59:20.600",
      "formatted_end": "02:59:22.600",
      "text": "چی شده؟"
    },
    {
      "id": 94,
      "start": 10762.6,
      "end": 10764.6,
      "formatted_start": "02:59:22.600",
      "formatted_end": "02:59:24.600",
      "text": "اول بره در درده اینجا داره صرفه خیلی تا داره"
    },
    {
      "id": 95,
      "start": 10764.6,
      "end": 10766.6,
      "formatted_start": "02:59:24.600",
      "formatted_end": "02:59:26.600",
      "text": "اول بره درده اینجا داره صرفه خیلی تا داره"
    },
    {
      "id": 96,
      "start": 10766.6,
      "end": 10770.6,
      "formatted_start": "02:59:26.600",
      "formatted_end": "02:59:30.600",
      "text": "اول خوش بوده. دو هفته شده خدی شده."
    },
    {
      "id": 97,
      "start": 10770.6,
      "end": 10775.6,
      "formatted_start": "02:59:30.600",
      "formatted_end": "02:59:35.600",
      "text": "این همه سرماوردی که ترداشت باشه اینا نداشته بود."
    },
    {
      "id": 98,
      "start": 10775.6,
      "end": 10779.6,
      "formatted_start": "02:59:35.600",
      "formatted_end": "02:59:39.600",
      "text": "این همه صبح خدا می کنه."
    },
    {
      "id": 99,
      "start": 10779.6,
      "end": 10781.6,
      "formatted_start": "02:59:39.600",
      "formatted_end": "02:59:41.600",
      "text": "اول صبح؟"
    },
    {
