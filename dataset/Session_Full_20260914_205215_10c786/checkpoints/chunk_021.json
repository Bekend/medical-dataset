    },
    {
      "id": 7,
      "start": 6314.0,
      "end": 6316.0,
      "formatted_start": "01:45:14.000",
      "formatted_end": "01:45:16.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 8,
      "start": 6316.0,
      "end": 6318.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:18.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 9,
      "start": 6318.0,
      "end": 6320.0,
      "formatted_start": "01:45:18.000",
      "formatted_end": "01:45:20.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 10,
      "start": 6320.0,
      "end": 6322.0,
      "formatted_start": "01:45:20.000",
      "formatted_end": "01:45:22.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 11,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "بشین برد"
    },
    {
      "id": 12,
      "start": 6326.0,
      "end": 6328.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:28.000",
      "text": "هفت و هفت ست"
    },
    {
      "id": 13,
      "start": 6328.0,
      "end": 6330.0,
      "formatted_start": "01:45:28.000",
      "formatted_end": "01:45:30.000",
      "text": "دقیقا هفت و شش ست موند"
    },
    {
      "id": 14,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "خب هفت ست"
    },
    {
      "id": 15,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "این هم برکرده"
    },
    {
      "id": 16,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "انا شیر پشتش شیره؟ شیر مادر"
    },
    {
      "id": 17,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "شیر مادر برای ریفلاکسش داروی خاصی داری میدی"
    },
    {
      "id": 18,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "انا که دیگر ببینم"
    },
    {
      "id": 19,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "که دیگر ببینم و یه ماه تا دو ماه"
    },
    {
      "id": 20,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "و از ماه تا سه ماه هم مشکل نداره"
    },
    {
      "id": 21,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "بله ریفلاکس برای بچه ها معمولا"
    },
    {
      "id": 22,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "تنها مالی دیگه هست بعدش کم بشه"
    },
    {
      "id": 23,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "الان هفت ماهو"
    },
    {
      "id": 24,
      "start": 6350.0,
      "end": 6364.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:46:04.000",
      "text": "در حال از شیر نخوردن، بازیگو شیر نخوردن."
    },
    {
      "id": 25,
      "start": 6364.0,
      "end": 6366.5,
      "formatted_start": "01:46:04.000",
      "formatted_end": "01:46:06.500",
      "text": "چون که گیزار رو ندی هم نمیخوره"
    },
    {
      "id": 26,
      "start": 6366.5,
      "end": 6370.5,
      "formatted_start": "01:46:06.500",
      "formatted_end": "01:46:10.500",
      "text": "باید برای شیر خوردن وقتی بچه وزنش خوبه ما مشکل نداریم"
    },
    {
      "id": 27,
      "start": 6370.5,
      "end": 6371.4,
      "formatted_start": "01:46:10.500",
      "formatted_end": "01:46:11.400",
      "text": "باید تقلاب کنید"
    },
    {
      "id": 28,
      "start": 6371.4,
      "end": 6373.1,
      "formatted_start": "01:46:11.400",
      "formatted_end": "01:46:13.100",
      "text": "یه ذریعه براشون وقت بذارید"
    },
    {
      "id": 29,
      "start": 6373.1,
      "end": 6375.0,
      "formatted_start": "01:46:13.100",
      "formatted_end": "01:46:15.000",
      "text": "جای تاریخ و خدمت رو ساکت ببرید"
    },
    {
      "id": 30,
      "start": 6375.0,
      "end": 6376.0,
      "formatted_start": "01:46:15.000",
      "formatted_end": "01:46:16.000",
      "text": "حواسش پرد نشه"
    },
    {
      "id": 31,
      "start": 6376.0,
      "end": 6377.8,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:17.800",
      "text": "موید سرشو گرد نکنه"
    },
    {
      "id": 32,
      "start": 6377.8,
      "end": 6384.4,
      "formatted_start": "01:46:17.800",
      "formatted_end": "01:46:24.400",
      "text": "صدای تلفن و موبایل و تلویزیون و ساعت و چه میدونم زنگ خونه"
    },
    {
      "id": 33,
      "start": 6384.4,
      "end": 6387.0,
      "formatted_start": "01:46:24.400",
      "formatted_end": "01:46:27.000",
      "text": "سایه اینها همه تحلیلش میکنه"
    },
    {
      "id": 34,
      "start": 6387.0,
      "end": 6389.0,
      "formatted_start": "01:46:27.000",
      "formatted_end": "01:46:29.000",
      "text": "شیر نمیخوره، اصلا این رو دوست ندارم بخورم"
    },
    {
      "id": 35,
      "start": 6389.0,
      "end": 6392.6,
      "formatted_start": "01:46:29.000",
      "formatted_end": "01:46:32.600",
      "text": "از وقتی شیر نمیخوره، اصلا سیران دردش مرد چند تا مردی میزن"
    },
    {
      "id": 36,
      "start": 6392.6,
      "end": 6394.6,
      "formatted_start": "01:46:32.600",
      "formatted_end": "01:46:34.600",
      "text": "اصلا دوست نداره بخوره"
    },
    {
      "id": 37,
      "start": 6394.6,
      "end": 6396.6,
      "formatted_start": "01:46:34.600",
      "formatted_end": "01:46:36.600",
      "text": "گفت نداره"
    },
    {
      "id": 38,
      "start": 6396.6,
      "end": 6398.6,
      "formatted_start": "01:46:36.600",
      "formatted_end": "01:46:38.600",
      "text": "نه نه، درد نمیست"
    },
    {
      "id": 39,
      "start": 6398.6,
      "end": 6400.6,
      "formatted_start": "01:46:38.600",
      "formatted_end": "01:46:40.600",
      "text": "داخل هشت ماه کریفلاکس درد نمیاره"
    },
    {
      "id": 40,
      "start": 6400.6,
      "end": 6406.0,
      "formatted_start": "01:46:40.600",
      "formatted_end": "01:46:46.000",
      "text": "ما اگر که بچه شیر خوردنش باعث باشه"
    },
    {
      "id": 41,
      "start": 6406.0,
      "end": 6410.0,
      "formatted_start": "01:46:46.000",
      "formatted_end": "01:46:50.000",
      "text": "که از لحاظ وزنی اگر بیفته خستص زیاد داشته باشه"
    },
    {
      "id": 42,
      "start": 6410.0,
      "end": 6414.0,
      "formatted_start": "01:46:50.000",
      "formatted_end": "01:46:54.000",
      "text": "صرفه زیاد گرفتیدیم دائم اون موقع میگیم کلیزور رو استفاده کنیم"
    },
    {
      "id": 43,
      "start": 6414.0,
      "end": 6418.0,
      "formatted_start": "01:46:54.000",
      "formatted_end": "01:46:58.000",
      "text": "و اولینکه شیر نمیخوره کلیزور اصلا درست نظر علمی جایگاهی نداره"
    },
    {
      "id": 44,
      "start": 6418.0,
      "end": 6422.0,
      "formatted_start": "01:46:58.000",
      "formatted_end": "01:47:02.000",
      "text": "ولی این طرق اینه شما میدید فهم کاری میخوره"
    },
    {
      "id": 45,
      "start": 6422.0,
      "end": 6428.0,
      "formatted_start": "01:47:02.000",
      "formatted_end": "01:47:08.000",
      "text": "اگر دیگه استفراقش قط شده تا کلیزور رو چند وقتی داریم میدید؟"
    },
    {
      "id": 46,
      "start": 6428.0,
      "end": 6430.0,
      "formatted_start": "01:47:08.000",
      "formatted_end": "01:47:10.000",
      "text": "نه قط کن"
    },
    {
      "id": 47,
      "start": 6430.0,
      "end": 6434.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:14.000",
      "text": "نمیتونی یه لفظ قط کنید چون الان سه ماه داریم میدید"
    },
    {
      "id": 48,
      "start": 6434.0,
      "end": 6437.66,
      "formatted_start": "01:47:14.000",
      "formatted_end": "01:47:17.660",
      "text": "با مکلی زورشو الان لیمون درمیون کن"
    },
    {
      "id": 49,
      "start": 6437.66,
      "end": 6440.16,
      "formatted_start": "01:47:17.660",
      "formatted_end": "01:47:20.160",
      "text": "بعد از یه هفته دو رو درمیون کن"
    },
    {
      "id": 50,
      "start": 6440.16,
      "end": 6441.24,
      "formatted_start": "01:47:20.160",
      "formatted_end": "01:47:21.240",
      "text": "بعد دو هفته قطع کن"
    },
    {
      "id": 51,
      "start": 6441.24,
      "end": 6450.26,
      "formatted_start": "01:47:21.240",
      "formatted_end": "01:47:30.260",
      "text": "با توجه به سوال ریفلارس"
    },
    {
      "id": 52,
      "start": 6450.26,
      "end": 6455.26,
      "formatted_start": "01:47:30.260",
      "formatted_end": "01:47:35.260",
      "text": "بهتری که نرژی از مواهی با احتیاط پخته شده"
    },
    {
      "id": 53,
      "start": 6455.26,
      "end": 6456.46,
      "formatted_start": "01:47:35.260",
      "formatted_end": "01:47:36.460",
      "text": "مثل بیسکوی چونوین"
    },
    {
      "id": 54,
      "start": 6456.46,
      "end": 6460.74,
      "formatted_start": "01:47:36.460",
      "formatted_end": "01:47:40.740",
      "text": "الان باید برای بوششن فراموش بردید"
    },
    {
      "id": 55,
      "start": 6460.74,
      "end": 6461.66,
      "formatted_start": "01:47:40.740",
      "formatted_end": "01:47:41.660",
      "text": "برای بوششن شده"
    },
    {
      "id": 56,
      "start": 6461.66,
      "end": 6467.66,
      "formatted_start": "01:47:41.660",
      "formatted_end": "01:47:47.660",
      "text": "موسیقی"
    },
    {
      "id": 57,
      "start": 6491.66,
      "end": 6496.66,
      "formatted_start": "01:48:11.660",
      "formatted_end": "01:48:16.660",
      "text": "از این دیگه عدب ها خیلی برده هستن. زن خیلی بیانه."
    },
    {
      "id": 58,
      "start": 6496.66,
      "end": 6499.66,
      "formatted_start": "01:48:16.660",
      "formatted_end": "01:48:19.660",
      "text": "امیر قیده هستن. دیگه نوبت بیانه."
    },
    {
      "id": 59,
      "start": 6499.66,
      "end": 6501.66,
      "formatted_start": "01:48:19.660",
      "formatted_end": "01:48:21.660",
      "text": "چیزی همه کشیده باشه؟"
    },
    {
      "id": 60,
      "start": 6501.66,
      "end": 6503.66,
      "formatted_start": "01:48:21.660",
      "formatted_end": "01:48:23.660",
      "text": "چیزی همه کشیده باشه؟"
    },
    {
      "id": 61,
      "start": 6503.66,
      "end": 6505.66,
      "formatted_start": "01:48:23.660",
      "formatted_end": "01:48:25.660",
      "text": "میخواست که منو..."
    },
    {
      "id": 62,
      "start": 6505.66,
      "end": 6508.66,
      "formatted_start": "01:48:25.660",
      "formatted_end": "01:48:28.660",
      "text": "من توی را میسه. من اصلا خوشم میده در این دیگه."
    },
    {
      "id": 63,
      "start": 6508.66,
      "end": 6510.66,
      "formatted_start": "01:48:28.660",
      "formatted_end": "01:48:30.660",
      "text": "منو باز دیگه چیزی همه کشیده باشم."
    },
    {
      "id": 64,
      "start": 6510.66,
      "end": 6511.66,
      "formatted_start": "01:48:30.660",
      "formatted_end": "01:48:31.660",
      "text": "بگیشش کار کنه."
    },
    {
      "id": 65,
      "start": 6511.66,
      "end": 6513.66,
      "formatted_start": "01:48:31.660",
      "formatted_end": "01:48:33.660",
      "text": "بگیشش کار کنه. بگیرم که من این قبل که الان بگو."
    },
    {
      "id": 66,
      "start": 6513.66,
      "end": 6516.66,
      "formatted_start": "01:48:33.660",
      "formatted_end": "01:48:36.660",
      "text": "بگو که من چیشوش که شدم نمیاد چیشوش کار کنم"
    },
    {
      "id": 67,
      "start": 6516.66,
      "end": 6517.66,
      "formatted_start": "01:48:36.660",
      "formatted_end": "01:48:37.660",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 6517.66,
      "end": 6519.66,
      "formatted_start": "01:48:37.660",
      "formatted_end": "01:48:39.660",
      "text": "آه گفتم"
    },
    {
      "id": 69,
      "start": 6519.66,
      "end": 6521.66,
      "formatted_start": "01:48:39.660",
      "formatted_end": "01:48:41.660",
      "text": "نه این لفت قبل هم همین بود"
    },
    {
      "id": 70,
      "start": 6521.66,
      "end": 6524.66,
      "formatted_start": "01:48:41.660",
      "formatted_end": "01:48:44.660",
      "text": "لفت اول هم بیاد نفتیم من یادم خیلی بیاد شده"
    },
    {
      "id": 71,
      "start": 6524.66,
      "end": 6527.66,
      "formatted_start": "01:48:44.660",
      "formatted_end": "01:48:47.660",
      "text": "امیر حیدر تقضید دیگه نابد داره"
    },
    {
      "id": 72,
      "start": 6531.66,
      "end": 6533.66,
      "formatted_start": "01:48:51.660",
      "formatted_end": "01:48:53.660",
      "text": "سلام خانم"
    },
    {
      "id": 73,
      "start": 6533.66,
      "end": 6534.66,
      "formatted_start": "01:48:53.660",
      "formatted_end": "01:48:54.660",
      "text": "سلام خیلی مردم"
    },
    {
      "id": 74,
      "start": 6534.66,
      "end": 6535.66,
      "formatted_start": "01:48:54.660",
      "formatted_end": "01:48:55.660",
      "text": "خوبی؟"
    },
    {
      "id": 75,
      "start": 6535.66,
      "end": 6537.66,
      "formatted_start": "01:48:55.660",
      "formatted_end": "01:48:57.660",
      "text": "نیمارم شدید؟ خواهدم؟"
    },
    {
      "id": 76,
      "start": 6537.66,
      "end": 6538.66,
      "formatted_start": "01:48:57.660",
      "formatted_end": "01:48:58.660",
      "text": "خواهدم شدید"
    },
    {
      "id": 77,
      "start": 6538.66,
      "end": 6539.66,
      "formatted_start": "01:48:58.660",
      "formatted_end": "01:48:59.660",
      "text": "چی شده؟"
    },
    {
      "id": 78,
      "start": 6539.66,
      "end": 6569.66,
      "formatted_start": "01:48:59.660",
      "formatted_end": "01:49:29.660",
      "text": "باید برداریم که از اینکه باید برداریم که از اینکه باید برداریم که از اینکه باید برداریم که از اینکه باید برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم که از اینکه برداریم ک"
    },
    {
      "id": 79,
      "start": 6569.66,
      "end": 6572.66,
      "formatted_start": "01:49:29.660",
      "formatted_end": "01:49:32.660",
      "text": "از اینکه در درده خارج شده"
    },
    {
      "id": 80,
      "start": 6572.66,
      "end": 6575.66,
      "formatted_start": "01:49:32.660",
      "formatted_end": "01:49:35.660",
      "text": "از اینکه در درده اصلا یک بیماری گمارشی داره"
    },
    {
      "id": 81,
      "start": 6575.66,
      "end": 6577.66,
      "formatted_start": "01:49:35.660",
      "formatted_end": "01:49:37.660",
      "text": "چون این همه اصحال بچه داره"
    },
    {
      "id": 82,
      "start": 6577.66,
      "end": 6579.66,
      "formatted_start": "01:49:37.660",
      "formatted_end": "01:49:39.660",
      "text": "دابون شده بچه دابون"
    },
    {
      "id": 83,
      "start": 6579.66,
      "end": 6581.66,
      "formatted_start": "01:49:39.660",
      "formatted_end": "01:49:41.660",
      "text": "اصحال بسترین"
    },
    {
      "id": 84,
      "start": 6581.66,
      "end": 6583.66,
      "formatted_start": "01:49:41.660",
      "formatted_end": "01:49:43.660",
      "text": "گوار سختگی"
    },
    {
      "id": 85,
      "start": 6583.66,
      "end": 6585.66,
      "formatted_start": "01:49:43.660",
      "formatted_end": "01:49:45.660",
      "text": "گوار اصحال"
    },
    {
      "id": 86,
      "start": 6585.66,
      "end": 6587.66,
      "formatted_start": "01:49:45.660",
      "formatted_end": "01:49:47.660",
      "text": "الان باز اصحال"
    },
    {
      "id": 87,
      "start": 6587.66,
      "end": 6589.66,
      "formatted_start": "01:49:47.660",
      "formatted_end": "01:49:49.660",
      "text": "دابونه بچه"
    },
    {
      "id": 88,
      "start": 6589.66,
      "end": 6591.66,
      "formatted_start": "01:49:49.660",
      "formatted_end": "01:49:51.660",
      "text": "کدوم بیمارستان بیده ای؟"
    },
    {
      "id": 89,
      "start": 6591.66,
      "end": 6593.66,
      "formatted_start": "01:49:51.660",
      "formatted_end": "01:49:53.660",
      "text": "هایی هم تا در اجتماعیت"
    },
    {
      "id": 90,
      "start": 6593.66,
      "end": 6595.66,
      "formatted_start": "01:49:53.660",
      "formatted_end": "01:49:55.660",
      "text": "تا در اجتماعیت نه"
    },
    {
      "id": 91,
      "start": 6595.66,
      "end": 6597.66,
      "formatted_start": "01:49:55.660",
      "formatted_end": "01:49:57.660",
      "text": "اصحال"
    },
    {
      "id": 92,
      "start": 6597.66,
      "end": 6600.0,
      "formatted_start": "01:49:57.660",
      "formatted_end": "01:50:00.000",
      "text": "اینجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیشتر اونجا بیش"
    }
