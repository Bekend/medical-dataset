      "formatted_start": "02:15:40.000",
      "formatted_end": "02:15:42.000",
      "text": "او که شبهایی گرفت میگیرد"
    },
    {
      "id": 6,
      "start": 8142.0,
      "end": 8144.0,
      "formatted_start": "02:15:42.000",
      "formatted_end": "02:15:44.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 8144.0,
      "end": 8146.0,
      "formatted_start": "02:15:44.000",
      "formatted_end": "02:15:46.000",
      "text": "اونش گرفتگی نمیدونه"
    },
    {
      "id": 8,
      "start": 8146.0,
      "end": 8148.0,
      "formatted_start": "02:15:46.000",
      "formatted_end": "02:15:48.000",
      "text": "از دهن نفس میکشه"
    },
    {
      "id": 9,
      "start": 8148.0,
      "end": 8150.0,
      "formatted_start": "02:15:48.000",
      "formatted_end": "02:15:50.000",
      "text": "انا چند شبهایی نوزده بود"
    },
    {
      "id": 10,
      "start": 8150.0,
      "end": 8152.0,
      "formatted_start": "02:15:50.000",
      "formatted_end": "02:15:52.000",
      "text": "دیشب شد و شد"
    },
    {
      "id": 11,
      "start": 8152.0,
      "end": 8154.0,
      "formatted_start": "02:15:52.000",
      "formatted_end": "02:15:54.000",
      "text": "یک آقایی از صرفه که نداره"
    },
    {
      "id": 12,
      "start": 8154.0,
      "end": 8156.0,
      "formatted_start": "02:15:54.000",
      "formatted_end": "02:15:56.000",
      "text": "صدا شکم تر"
    },
    {
      "id": 13,
      "start": 8156.0,
      "end": 8158.0,
      "formatted_start": "02:15:56.000",
      "formatted_end": "02:15:58.000",
      "text": "نداره"
    },
    {
      "id": 14,
      "start": 8160.0,
      "end": 8186.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:26.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 8190.0,
      "end": 8192.0,
      "formatted_start": "02:16:30.000",
      "formatted_end": "02:16:32.000",
      "text": "او میترداشه"
    },
    {
      "id": 16,
      "start": 8192.0,
      "end": 8194.0,
      "formatted_start": "02:16:32.000",
      "formatted_end": "02:16:34.000",
      "text": "شباره یکم"
    },
    {
      "id": 17,
      "start": 8220.0,
      "end": 8250.0,
      "formatted_start": "02:17:00.000",
      "formatted_end": "02:17:30.000",
      "text": "از اینجا باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که ا"
    },
    {
      "id": 18,
      "start": 8250.0,
      "end": 8253.24,
      "formatted_start": "02:17:30.000",
      "formatted_end": "02:17:33.240",
      "text": "داشت اگه از طب و صورت داشت این روز خرابه"
    },
    {
      "id": 19,
      "start": 8253.24,
      "end": 8254.68,
      "formatted_start": "02:17:33.240",
      "formatted_end": "02:17:34.680",
      "text": "الان نمیخواد"
    },
    {
      "id": 20,
      "start": 8254.68,
      "end": 8259.5,
      "formatted_start": "02:17:34.680",
      "formatted_end": "02:17:39.500",
      "text": "اون مومه چون بچه این نارست بوده"
    },
    {
      "id": 21,
      "start": 8259.5,
      "end": 8261.7,
      "formatted_start": "02:17:39.500",
      "formatted_end": "02:17:41.700",
      "text": "این هر صورتی که همین علامه شده"
    },
    {
      "id": 22,
      "start": 8261.7,
      "end": 8263.78,
      "formatted_start": "02:17:41.700",
      "formatted_end": "02:17:43.780",
      "text": "این صورت ها صورت هایی که اسپری میخواد"
    },
    {
      "id": 23,
      "start": 8263.78,
      "end": 8265.36,
      "formatted_start": "02:17:43.780",
      "formatted_end": "02:17:45.360",
      "text": "الان ولی نیاز داره"
    },
    {
      "id": 24,
      "start": 8265.36,
      "end": 8266.38,
      "formatted_start": "02:17:45.360",
      "formatted_end": "02:17:46.380",
      "text": "این دسته باشه"
    },
    {
      "id": 25,
      "start": 8266.38,
      "end": 8267.84,
      "formatted_start": "02:17:46.380",
      "formatted_end": "02:17:47.840",
      "text": "در صورت این که طب و صورت"
    },
    {
      "id": 26,
      "start": 8267.84,
      "end": 8269.38,
      "formatted_start": "02:17:47.840",
      "formatted_end": "02:17:49.380",
      "text": "اصلا میره که جایی خودش"
    },
    {
      "id": 27,
      "start": 8269.38,
      "end": 8271.34,
      "formatted_start": "02:17:49.380",
      "formatted_end": "02:17:51.340",
      "text": "اون بوششو ای چیز کن"
    },
    {
      "id": 28,
      "start": 8271.34,
      "end": 8272.6,
      "formatted_start": "02:17:51.340",
      "formatted_end": "02:17:52.600",
      "text": "خودت ماساج بده"
    },
    {
      "id": 29,
      "start": 8272.6,
      "end": 8277.46,
      "formatted_start": "02:17:52.600",
      "formatted_end": "02:17:57.460",
      "text": "مرسی مامان"
    },
    {
      "id": 30,
      "start": 8277.46,
      "end": 8278.52,
      "formatted_start": "02:17:57.460",
      "formatted_end": "02:17:58.520",
      "text": "خوشید مامان"
    },
    {
      "id": 31,
      "start": 8278.52,
      "end": 8280.52,
      "formatted_start": "02:17:58.520",
      "formatted_end": "02:18:00.520",
      "text": "بسیاری بوده؟"
    },
    {
      "id": 32,
      "start": 8280.52,
      "end": 8282.52,
      "formatted_start": "02:18:00.520",
      "formatted_end": "02:18:02.520",
      "text": "آره بودیم"
    },
    {
      "id": 33,
      "start": 8282.52,
      "end": 8284.52,
      "formatted_start": "02:18:02.520",
      "formatted_end": "02:18:04.520",
      "text": "کجا؟"
    },
    {
      "id": 34,
      "start": 8284.52,
      "end": 8286.52,
      "formatted_start": "02:18:04.520",
      "formatted_end": "02:18:06.520",
      "text": "طالبانی گرگان"
    },
    {
      "id": 35,
      "start": 8286.52,
      "end": 8288.52,
      "formatted_start": "02:18:06.520",
      "formatted_end": "02:18:08.520",
      "text": "آهان"
    },
    {
      "id": 36,
      "start": 8288.52,
      "end": 8290.52,
      "formatted_start": "02:18:08.520",
      "formatted_end": "02:18:10.520",
      "text": "غجر روی داشته؟"
    },
    {
      "id": 37,
      "start": 8290.52,
      "end": 8292.52,
      "formatted_start": "02:18:10.520",
      "formatted_end": "02:18:12.520",
      "text": "نه قرار بود غجر رویش کنیم"
    },
    {
      "id": 38,
      "start": 8292.52,
      "end": 8294.52,
      "formatted_start": "02:18:12.520",
      "formatted_end": "02:18:14.520",
      "text": "که باید دستشو شکر"
    },
    {
      "id": 39,
      "start": 8294.52,
      "end": 8296.52,
      "formatted_start": "02:18:14.520",
      "formatted_end": "02:18:16.520",
      "text": "از کجا فرستادیمش؟"
    },
    {
      "id": 40,
      "start": 8296.52,
      "end": 8298.52,
      "formatted_start": "02:18:16.520",
      "formatted_end": "02:18:18.520",
      "text": "از اینجا"
    },
    {
      "id": 41,
      "start": 8298.52,
      "end": 8300.52,
      "formatted_start": "02:18:18.520",
      "formatted_end": "02:18:20.520",
      "text": "نه اونبا طالبانی"
    },
    {
      "id": 42,
      "start": 8300.52,
      "end": 8302.52,
      "formatted_start": "02:18:20.520",
      "formatted_end": "02:18:22.520",
      "text": "فرستادیمش طالبانی گرگان"
    },
    {
      "id": 43,
      "start": 8302.52,
      "end": 8304.52,
      "formatted_start": "02:18:22.520",
      "formatted_end": "02:18:24.520",
      "text": "و بعدی دفت نداشت"
    },
    {
      "id": 44,
      "start": 8304.52,
      "end": 8306.52,
      "formatted_start": "02:18:24.520",
      "formatted_end": "02:18:26.520",
      "text": "شما غجر پول فرستاد نبودی"
    },
    {
      "id": 45,
      "start": 8306.52,
      "end": 8309.2,
      "formatted_start": "02:18:26.520",
      "formatted_end": "02:18:29.200",
      "text": "اون شبه که اومدی عکس گرفتن، گفتن اینجا نه؟"
    },
    {
      "id": 46,
      "start": 8309.2,
      "end": 8310.64,
      "formatted_start": "02:18:29.200",
      "formatted_end": "02:18:30.640",
      "text": "نه، من اونجا عکس نگرفتیم."
    },
    {
      "id": 47,
      "start": 8310.64,
      "end": 8312.52,
      "formatted_start": "02:18:30.640",
      "formatted_end": "02:18:32.520",
      "text": "چی شد که از اوجانس برسادن؟"
    },
    {
      "id": 48,
      "start": 8312.52,
      "end": 8315.92,
      "formatted_start": "02:18:32.520",
      "formatted_end": "02:18:35.920",
      "text": "نه، من از آیمان کردیم، این مدخون نکرد."
    },
    {
      "id": 49,
      "start": 8315.92,
      "end": 8316.52,
      "formatted_start": "02:18:35.920",
      "formatted_end": "02:18:36.520",
      "text": "بعد گفت که..."
    },
    {
      "id": 50,
      "start": 8316.52,
      "end": 8317.76,
      "formatted_start": "02:18:36.520",
      "formatted_end": "02:18:37.760",
      "text": "کل روز مدخون نکرد؟"
    },
    {
      "id": 51,
      "start": 8317.76,
      "end": 8319.72,
      "formatted_start": "02:18:37.760",
      "formatted_end": "02:18:39.720",
      "text": "همون روز شب اول نکرد."
    },
    {
      "id": 52,
      "start": 8319.72,
      "end": 8320.32,
      "formatted_start": "02:18:39.720",
      "formatted_end": "02:18:40.320",
      "text": "آه؟"
    },
    {
      "id": 53,
      "start": 8320.32,
      "end": 8322.92,
      "formatted_start": "02:18:40.320",
      "formatted_end": "02:18:42.920",
      "text": "بعدش من گفتن که چکار تا سه روز محلت داره؟"
    },
    {
      "id": 54,
      "start": 8322.92,
      "end": 8324.28,
      "formatted_start": "02:18:42.920",
      "formatted_end": "02:18:44.280",
      "text": "بعد من رفتم کنه..."
    },
    {
      "id": 55,
      "start": 8324.28,
      "end": 8326.08,
      "formatted_start": "02:18:44.280",
      "formatted_end": "02:18:46.080",
      "text": "مرخصه کردن بدون دستشوی؟"
    },
    {
      "id": 56,
      "start": 8326.08,
      "end": 8332.08,
      "formatted_start": "02:18:46.080",
      "formatted_end": "02:18:52.080",
      "text": "بعد گفت که شکر آنسا سر نمورد داره، بعد دکترام که معانه کرد اطفال گفت مشکل نداره بچه ام"
    },
    {
      "id": 57,
      "start": 8332.08,
      "end": 8337.08,
      "formatted_start": "02:18:52.080",
      "formatted_end": "02:18:57.080",
      "text": "بعدی چیمم رفتیت خونه، رفتیت خونه که دهانش شیر میاد و نیمی خوره"
    },
    {
      "id": 58,
      "start": 8337.08,
      "end": 8340.08,
      "formatted_start": "02:18:57.080",
      "formatted_end": "02:19:00.080",
      "text": "آره شکمشم صف بود"
    },
    {
      "id": 59,
      "start": 8340.08,
      "end": 8341.08,
      "formatted_start": "02:19:00.080",
      "formatted_end": "02:19:01.080",
      "text": "اقتصاد شکم"
    },
    {
      "id": 60,
      "start": 8341.08,
      "end": 8347.08,
      "formatted_start": "02:19:01.080",
      "formatted_end": "02:19:07.080",
      "text": "آره بعدی چیم دیگه صبح میشه نه خواهش دیگه بعد شیر اصلا نیمی خوره، رنگشم پرید، منو وردم توی آقانی گل برد"
    },
    {
      "id": 61,
      "start": 8347.08,
      "end": 8348.08,
      "formatted_start": "02:19:07.080",
      "formatted_end": "02:19:08.080",
      "text": "بله"
    },
    {
      "id": 62,
      "start": 8348.08,
      "end": 8355.08,
      "formatted_start": "02:19:08.080",
      "formatted_end": "02:19:15.080",
      "text": "و اینجا سونو دادن، بستریش کردن، سونوگرافی گرفتن، بعد فراموش کردن باید از اینجا دادن به منطقه بشه گرگان."
    },
    {
      "id": 63,
      "start": 8355.08,
      "end": 8357.08,
      "formatted_start": "02:19:15.080",
      "formatted_end": "02:19:17.080",
      "text": "اینجا کنید؟"
    },
    {
      "id": 64,
      "start": 8357.08,
      "end": 8359.08,
      "formatted_start": "02:19:17.080",
      "formatted_end": "02:19:19.080",
      "text": "اینجا؟ یا خانم بود، نمی‌دونم که اینجا بود."
    },
    {
      "id": 65,
      "start": 8359.08,
      "end": 8361.08,
      "formatted_start": "02:19:19.080",
      "formatted_end": "02:19:21.080",
      "text": "از اینطورش کنید؟"
    },
    {
      "id": 66,
      "start": 8361.08,
      "end": 8363.08,
      "formatted_start": "02:19:21.080",
      "formatted_end": "02:19:23.080",
      "text": "آره آره آره"
    },
    {
      "id": 67,
      "start": 8363.08,
      "end": 8368.08,
      "formatted_start": "02:19:23.080",
      "formatted_end": "02:19:28.080",
      "text": "بعدی چیمانش کردن و گفتن که آره اصولیم گوباد بای گرگا ما همچنین دستگاه شدیم"
    },
    {
      "id": 68,
      "start": 8368.08,
      "end": 8370.08,
      "formatted_start": "02:19:28.080",
      "formatted_end": "02:19:30.080",
      "text": "می کنند عمل با جرایش کنیم"
    },
    {
      "id": 69,
      "start": 8370.08,
      "end": 8374.08,
      "formatted_start": "02:19:30.080",
      "formatted_end": "02:19:34.080",
      "text": "پس این گرگا هم ببینید تو این آسیو کزایش بیس پنج اونجا بود"
    },
    {
      "id": 70,
      "start": 8374.08,
      "end": 8379.08,
      "formatted_start": "02:19:34.080",
      "formatted_end": "02:19:39.080",
      "text": "بعد عکس رنگی و عکس سیاسیفی دینا گرفتن و گفتن که باید نمونه برداری کنیم"
    },
    {
      "id": 71,
      "start": 8379.08,
      "end": 8382.08,
      "formatted_start": "02:19:39.080",
      "formatted_end": "02:19:42.080",
      "text": "این پیش گرم یعنی گفتن شاید تنوری رو می دهست"
    },
    {
      "id": 72,
      "start": 8382.08,
      "end": 8391.18,
      "formatted_start": "02:19:42.080",
      "formatted_end": "02:19:51.180",
      "text": "بعد نموه برداری کردن ازش گفت تا چند روز دیگه نموه برداش میاد بعدی که بچن دستشوی کردن با کمکی نام خب میتونی برد خونه ترخیص کردن بردیس خمس"
    },
    {
      "id": 73,
      "start": 8391.18,
      "end": 8399.98,
      "formatted_start": "02:19:51.180",
      "formatted_end": "02:19:59.980",
      "text": "ترخیصش کردن میتونی بردن خونه دستشوی میتونی برد چهار روز بعدش مرخص کردن جواب نموه ناشوند که سطح چهار"
    }
  ],
  "status": "completed"
}