  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2419.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:19.000",
      "text": "در مطب پوستی، سو سیزده و پنجه، شیرسته خوبه، صبح شاکت بده، اما صبح توشکی، این مند گرفته، پس کم نکرده، ولی ضربی داره، دو روز زیر نور آبی باید باشه، دو روز دستگاه،"
    },
    {
      "id": 1,
      "start": 2419.0,
      "end": 2425.0,
      "formatted_start": "00:40:19.000",
      "formatted_end": "00:40:25.000",
      "text": "بعد اون بطر زریع رو بز کن"
    },
    {
      "id": 2,
      "start": 2425.0,
      "end": 2429.0,
      "formatted_start": "00:40:25.000",
      "formatted_end": "00:40:29.000",
      "text": "بطر نفتش رو دیدی"
    },
    {
      "id": 3,
      "start": 2429.0,
      "end": 2433.0,
      "formatted_start": "00:40:29.000",
      "formatted_end": "00:40:33.000",
      "text": "نفتش رو دیدی؟ نه نفتش هستیده، الان طبیعیه"
    },
    {
      "id": 4,
      "start": 2433.0,
      "end": 2437.0,
      "formatted_start": "00:40:33.000",
      "formatted_end": "00:40:37.000",
      "text": "منو زیاد باز نداره شد کمش، ولی صدا داره، زور رو میزنه"
    },
    {
      "id": 5,
      "start": 2437.0,
      "end": 2439.0,
      "formatted_start": "00:40:37.000",
      "formatted_end": "00:40:39.000",
      "text": "این بطر نیمون میزنه، نه کمش بزنه، یکی سبب نشیده"
    },
    {
      "id": 6,
      "start": 2439.0,
      "end": 2443.0,
      "formatted_start": "00:40:39.000",
      "formatted_end": "00:40:43.000",
      "text": "این بده تر میشه، آره، دستش کمش بزنی، درد داره"
    },
    {
      "id": 7,
      "start": 2443.0,
      "end": 2447.0,
      "formatted_start": "00:40:43.000",
      "formatted_end": "00:40:47.000",
      "text": "این تا چه روی؟ نفتش بود، منو نه"
    },
    {
      "id": 8,
      "start": 2447.0,
      "end": 2450.0,
      "formatted_start": "00:40:47.000",
      "formatted_end": "00:40:50.000",
      "text": "این تا چند روزیگی بیشتر میشه"
    },
    {
      "id": 9,
      "start": 2450.0,
      "end": 2453.0,
      "formatted_start": "00:40:50.000",
      "formatted_end": "00:40:53.000",
      "text": "ولی دارویت و اولوانیوی رو میتونی"
    },
    {
      "id": 10,
      "start": 2453.0,
      "end": 2455.0,
      "formatted_start": "00:40:53.000",
      "formatted_end": "00:40:55.000",
      "text": "از دو هفته گیر به بعد بدی"
    },
    {
      "id": 11,
      "start": 2455.0,
      "end": 2457.0,
      "formatted_start": "00:40:55.000",
      "formatted_end": "00:40:57.000",
      "text": "یا ایمیتیکورت هم هر شیر سال نیم سی سی"
    },
    {
      "id": 12,
      "start": 2457.0,
      "end": 2461.0,
      "formatted_start": "00:40:57.000",
      "formatted_end": "00:41:01.000",
      "text": "یه یخچاری پرو بیوتی که هم هست را در متر داخل یخچار باید باشه"
    },
    {
      "id": 13,
      "start": 2461.0,
      "end": 2463.0,
      "formatted_start": "00:41:01.000",
      "formatted_end": "00:41:03.000",
      "text": "من میرسم"
    },
    {
      "id": 14,
      "start": 2463.0,
      "end": 2465.0,
      "formatted_start": "00:41:03.000",
      "formatted_end": "00:41:05.000",
      "text": "مثلا دستگاه متری دانه باره"
    },
    {
      "id": 15,
      "start": 2465.0,
      "end": 2467.0,
      "formatted_start": "00:41:05.000",
      "formatted_end": "00:41:07.000",
      "text": "فقط آده و تیرویل رو باید دومشو ببر"
    },
    {
      "id": 16,
      "start": 2467.0,
      "end": 2471.0,
      "formatted_start": "00:41:07.000",
      "formatted_end": "00:41:11.000",
      "text": "اگه تا دو هفته گیر بچه یعنی پنج روزیگی"
    },
    {
      "id": 17,
      "start": 2471.0,
      "end": 2476.0,
      "formatted_start": "00:41:11.000",
      "formatted_end": "00:41:16.000",
      "text": "اگر بخواد این ذریع کم نشه، الارم به دستگاه و آزمایش خون رای دارو باید بگیر."
    },
    {
      "id": 18,
      "start": 2476.0,
      "end": 2479.0,
      "formatted_start": "00:41:16.000",
      "formatted_end": "00:41:19.000",
      "text": "خب اینو بخوادم پنشنده بیایش، آسفه که افرادی چرا بید."
    },
    {
      "id": 19,
      "start": 2479.0,
      "end": 2481.0,
      "formatted_start": "00:41:19.000",
      "formatted_end": "00:41:21.000",
      "text": "نه برمش، شبه ببرمش."
    },
    {
      "id": 20,
      "start": 2481.0,
      "end": 2485.0,
      "formatted_start": "00:41:21.000",
      "formatted_end": "00:41:25.000",
      "text": "شما الان پنشنده بیشه چهارده روی زیدی بچه."
    },
    {
      "id": 21,
      "start": 2485.0,
      "end": 2486.0,
      "formatted_start": "00:41:25.000",
      "formatted_end": "00:41:26.000",
      "text": "آره، چهارده."
    },
    {
      "id": 22,
      "start": 2486.0,
      "end": 2487.0,
      "formatted_start": "00:41:26.000",
      "formatted_end": "00:41:27.000",
      "text": "آره."
    },
    {
      "id": 23,
      "start": 2487.0,
      "end": 2488.0,
      "formatted_start": "00:41:27.000",
      "formatted_end": "00:41:28.000",
      "text": "نه اون که شبه باشه."
    },
    {
      "id": 24,
      "start": 2488.0,
      "end": 2489.0,
      "formatted_start": "00:41:28.000",
      "formatted_end": "00:41:29.000",
      "text": "نه اون امروز ده دومی هر روزه."
    },
    {
      "id": 25,
      "start": 2489.0,
      "end": 2491.0,
      "formatted_start": "00:41:29.000",
      "formatted_end": "00:41:31.000",
      "text": "نمیبینم، اون شبه باشه، اون کاری ندارو کرده."
    },
    {
      "id": 26,
      "start": 2491.0,
      "end": 2494.0,
      "formatted_start": "00:41:31.000",
      "formatted_end": "00:41:34.000",
      "text": "او رو ببر. من از ماشه خون میگم."
    },
    {
      "id": 27,
      "start": 2494.0,
      "end": 2496.0,
      "formatted_start": "00:41:34.000",
      "formatted_end": "00:41:36.000",
      "text": "آره. او جداست."
    },
    {
      "id": 28,
      "start": 2504.0,
      "end": 2507.0,
      "formatted_start": "00:41:44.000",
      "formatted_end": "00:41:47.000",
      "text": "اون روی چی جز دست پا لازم نداری؟"
    },
    {
      "id": 29,
      "start": 2507.0,
      "end": 2527.0,
      "formatted_start": "00:41:47.000",
      "formatted_end": "00:42:07.000",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 2527.0,
      "end": 2529.0,
      "formatted_start": "00:42:07.000",
      "formatted_end": "00:42:09.000",
      "text": "از دستگاه ماشین رو شوید ببینید"
    },
    {
      "id": 31,
      "start": 2529.0,
      "end": 2535.0,
      "formatted_start": "00:42:09.000",
      "formatted_end": "00:42:15.000",
      "text": "بعد صدای جارورده سشوار حرکت ماشین برای این ناله رو زندگی زندگی شده"
    },
    {
      "id": 32,
      "start": 2535.0,
      "end": 2539.0,
      "formatted_start": "00:42:15.000",
      "formatted_end": "00:42:19.000",
      "text": "صدای آب جارورده سشوار حرکت ماشین"
    },
    {
      "id": 33,
      "start": 2539.0,
      "end": 2545.0,
      "formatted_start": "00:42:19.000",
      "formatted_end": "00:42:25.000",
      "text": "آرامش رو بگیر و اینکه بینیش میگیره بزنید"
    },
    {
      "id": 34,
      "start": 2545.0,
      "end": 2547.0,
      "formatted_start": "00:42:25.000",
      "formatted_end": "00:42:27.000",
      "text": "آرامش هم از دو موزه یکی میزن"
    },
    {
      "id": 35,
      "start": 2547.0,
      "end": 2549.0,
      "formatted_start": "00:42:27.000",
      "formatted_end": "00:42:29.000",
      "text": "خود میزن اما بلوشه"
    },
    {
      "id": 36,
      "start": 2549.0,
      "end": 2579.0,
      "formatted_start": "00:42:29.000",
      "formatted_end": "00:42:59.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 37,
      "start": 2579.0,
      "end": 2581.0,
      "formatted_start": "00:42:59.000",
      "formatted_end": "00:43:01.000",
      "text": "ریفلاکسش داره شروع میشه"
    },
    {
      "id": 38,
      "start": 2581.0,
      "end": 2584.0,
      "formatted_start": "00:43:01.000",
      "formatted_end": "00:43:04.000",
      "text": "برای این سر ما گردیده باید نوزد"
    },
    {
      "id": 39,
      "start": 2584.0,
      "end": 2586.0,
      "formatted_start": "00:43:04.000",
      "formatted_end": "00:43:06.000",
      "text": "نه اینه دوش که مشکل نداره"
    },
    {
      "id": 40,
      "start": 2586.0,
      "end": 2588.0,
      "formatted_start": "00:43:06.000",
      "formatted_end": "00:43:08.000",
      "text": "از این درسته چی نفرمش کنم؟"
    },
    {
      "id": 41,
      "start": 2588.0,
      "end": 2590.0,
      "formatted_start": "00:43:08.000",
      "formatted_end": "00:43:10.000",
      "text": "نه یه نداره بیرشی که پس"
    },
    {
      "id": 42,
      "start": 2590.0,
