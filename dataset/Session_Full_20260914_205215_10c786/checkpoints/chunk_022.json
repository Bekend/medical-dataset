      "formatted_start": "01:51:47.000",
      "formatted_end": "01:51:50.000",
      "text": "اون دفعه بهت گفتم که ال اف باید بیدیم"
    },
    {
      "id": 26,
      "start": 6710.0,
      "end": 6716.58,
      "formatted_start": "01:51:50.000",
      "formatted_end": "01:51:56.580",
      "text": "این افرانگین خوب نمیشه خب"
    },
    {
      "id": 27,
      "start": 6716.58,
      "end": 6718.18,
      "formatted_start": "01:51:56.580",
      "formatted_end": "01:51:58.180",
      "text": "صورتش چطوره؟"
    },
    {
      "id": 28,
      "start": 6718.18,
      "end": 6719.0,
      "formatted_start": "01:51:58.180",
      "formatted_end": "01:51:59.000",
      "text": "او خوب شده"
    },
    {
      "id": 29,
      "start": 6719.0,
      "end": 6720.66,
      "formatted_start": "01:51:59.000",
      "formatted_end": "01:52:00.660",
      "text": "الان صورت اصلا نداره؟"
    },
    {
      "id": 30,
      "start": 6720.66,
      "end": 6720.98,
      "formatted_start": "01:52:00.660",
      "formatted_end": "01:52:00.980",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 6720.98,
      "end": 6722.1,
      "formatted_start": "01:52:00.980",
      "formatted_end": "01:52:02.100",
      "text": "بچه نیفتر ها؟"
    },
    {
      "id": 32,
      "start": 6722.1,
      "end": 6724.98,
      "formatted_start": "01:52:02.100",
      "formatted_end": "01:52:04.980",
      "text": "نه صورت هم در اصلا نداره"
    },
    {
      "id": 33,
      "start": 6724.98,
      "end": 6727.98,
      "formatted_start": "01:52:04.980",
      "formatted_end": "01:52:07.980",
      "text": "تا اون یک هفته افراد که استفاده کردیم خوب شده"
    },
    {
      "id": 34,
      "start": 6727.98,
      "end": 6746.98,
      "formatted_start": "01:52:07.980",
      "formatted_end": "01:52:26.980",
      "text": "از اینجا باید به ویلاک LF می گیرید. اینو اول از اینکه بریدید مالشتون تنهایی کنید و ببینید اگه LF نگیرید هیچ فایده نداره."
    },
    {
      "id": 35,
      "start": 6746.98,
      "end": 6752.98,
      "formatted_start": "01:52:26.980",
      "formatted_end": "01:52:32.980",
      "text": "الان هم به خاطر همون که به LF نگیرفتید دوباره برداشتید. برای مثل صرف هشت اسخالش هم خض می شود."
    },
    {
      "id": 36,
      "start": 6752.98,
      "end": 6754.98,
      "formatted_start": "01:52:32.980",
      "formatted_end": "01:52:34.980",
      "text": "تا کمی درست داریم؟"
    },
    {
      "id": 37,
      "start": 6754.98,
      "end": 6756.98,
      "formatted_start": "01:52:34.980",
      "formatted_end": "01:52:36.980",
      "text": "تا یک ماه"
    },
    {
      "id": 38,
      "start": 6756.98,
      "end": 6758.98,
      "formatted_start": "01:52:36.980",
      "formatted_end": "01:52:38.980",
      "text": "تا یک ماه"
    },
    {
      "id": 39,
      "start": 6758.98,
      "end": 6760.98,
      "formatted_start": "01:52:38.980",
      "formatted_end": "01:52:40.980",
      "text": "بعد کن یک سال بر میگرد"
    },
    {
      "id": 40,
      "start": 6760.98,
      "end": 6762.98,
      "formatted_start": "01:52:40.980",
      "formatted_end": "01:52:42.980",
      "text": "این پرزایی بوده از دست داده فقط در مورد این میزه"
    },
    {
      "id": 41,
      "start": 6762.98,
      "end": 6764.98,
      "formatted_start": "01:52:42.980",
      "formatted_end": "01:52:44.980",
      "text": "هر بچه یک سالی تو کشیده"
    },
    {
      "id": 42,
      "start": 6764.98,
      "end": 6766.98,
      "formatted_start": "01:52:44.980",
      "formatted_end": "01:52:46.980",
      "text": "اضافه یک ماه میخواد"
    },
    {
      "id": 43,
      "start": 6766.98,
      "end": 6768.98,
      "formatted_start": "01:52:46.980",
      "formatted_end": "01:52:48.980",
      "text": "کجا رو داری؟"
    },
    {
      "id": 44,
      "start": 6768.98,
      "end": 6770.98,
      "formatted_start": "01:52:48.980",
      "formatted_end": "01:52:50.980",
      "text": "آره"
    },
    {
      "id": 45,
      "start": 6770.98,
      "end": 6772.98,
      "formatted_start": "01:52:50.980",
      "formatted_end": "01:52:52.980",
      "text": "مزرک می کنن باز آسانی نداشت"
    },
    {
      "id": 46,
      "start": 6772.98,
      "end": 6774.98,
      "formatted_start": "01:52:52.980",
      "formatted_end": "01:52:54.980",
      "text": "چه خوشمون که بهش ندادی؟"
    },
    {
      "id": 47,
      "start": 6774.98,
      "end": 6776.98,
      "formatted_start": "01:52:54.980",
      "formatted_end": "01:52:56.980",
      "text": "نه"
    },
    {
      "id": 48,
      "start": 6776.98,
      "end": 6778.98,
      "formatted_start": "01:52:56.980",
      "formatted_end": "01:52:58.980",
      "text": "سه"
    },
    {
      "id": 49,
      "start": 6778.98,
      "end": 6780.98,
      "formatted_start": "01:52:58.980",
      "formatted_end": "01:53:00.980",
      "text": "برای هم مطمئن بهش داریم"
    },
    {
      "id": 50,
      "start": 6780.98,
      "end": 6782.98,
      "formatted_start": "01:53:00.980",
      "formatted_end": "01:53:02.980",
      "text": "درست دارنده که گرمی برون برون"
    },
    {
      "id": 51,
      "start": 6782.98,
      "end": 6784.98,
      "formatted_start": "01:53:02.980",
      "formatted_end": "01:53:04.980",
      "text": "باید برون دردشی هم ترشو کن"
    },
    {
      "id": 52,
      "start": 6790.98,
      "end": 6792.98,
      "formatted_start": "01:53:10.980",
      "formatted_end": "01:53:12.980",
      "text": "تبا بعض وقتا می کنیم"
    },
    {
      "id": 53,
      "start": 6792.98,
      "end": 6794.98,
      "formatted_start": "01:53:12.980",
      "formatted_end": "01:53:14.980",
      "text": "بعض وقتا"
    },
    {
      "id": 54,
      "start": 6794.98,
      "end": 6796.98,
      "formatted_start": "01:53:14.980",
      "formatted_end": "01:53:16.980",
      "text": "دیروز یه بار دارم بشم"
    },
    {
      "id": 55,
      "start": 6798.98,
      "end": 6800.98,
      "formatted_start": "01:53:18.980",
      "formatted_end": "01:53:20.980",
      "text": "خانم فکر نکنم بشن بشم"
    },
    {
      "id": 56,
      "start": 6800.98,
      "end": 6802.98,
      "formatted_start": "01:53:20.980",
      "formatted_end": "01:53:22.980",
      "text": "نه"
    },
    {
      "id": 57,
      "start": 6806.98,
      "end": 6808.98,
      "formatted_start": "01:53:26.980",
      "formatted_end": "01:53:28.980",
      "text": "اصلا شیر هنجا تر بشن"
    },
    {
      "id": 58,
      "start": 6840.98,
      "end": 6847.98,
      "formatted_start": "01:54:00.980",
      "formatted_end": "01:54:07.980",
      "text": "این پودر رو بدیسید. این که شیر خوش میشه. این دستت باشه."
    },
    {
      "id": 59,
      "start": 6847.98,
      "end": 6853.98,
      "formatted_start": "01:54:07.980",
      "formatted_end": "01:54:13.980",
      "text": "یه دره باشه. الف. تا یک نداری."
    },
    {
      "id": 60,
      "start": 6853.98,
      "end": 6859.98,
      "formatted_start": "01:54:13.980",
      "formatted_end": "01:54:19.980",
      "text": "نداشتی؟ ساده نه. هر به بلاد نه. هر به بلاد الف."
    },
    {
      "id": 61,
      "start": 6859.98,
      "end": 6862.98,
      "formatted_start": "01:54:19.980",
      "formatted_end": "01:54:22.980",
      "text": "الف."
    },
    {
      "id": 62,
      "start": 6892.98,
      "end": 6899.98,
      "formatted_start": "01:54:52.980",
      "formatted_end": "01:54:59.980",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}