    },
    {
      "id": 15,
      "start": 6678.0,
      "end": 6680.0,
      "formatted_start": "01:51:18.000",
      "formatted_end": "01:51:20.000",
      "text": "آه چی؟ تب سنتی کردم؟"
    },
    {
      "id": 16,
      "start": 6680.0,
      "end": 6682.0,
      "formatted_start": "01:51:20.000",
      "formatted_end": "01:51:22.000",
      "text": "آه چی؟ تب سنتی کردم؟"
    },
    {
      "id": 17,
      "start": 6682.0,
      "end": 6687.0,
      "formatted_start": "01:51:22.000",
      "formatted_end": "01:51:27.000",
      "text": "من که بستریش میکنم ولی کلن اومدم ورد نیستش که"
    },
    {
      "id": 18,
      "start": 6687.0,
      "end": 6692.0,
      "formatted_start": "01:51:27.000",
      "formatted_end": "01:51:32.000",
      "text": "شیرخواه یک ساله با اسمال ترکشیره"
    },
    {
      "id": 19,
      "start": 6692.0,
      "end": 6696.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:36.000",
      "text": "شیرخواهش هیچکه ال افه درسته؟ نه نه"
    },
    {
      "id": 20,
      "start": 6696.0,
      "end": 6698.0,
      "formatted_start": "01:51:36.000",
      "formatted_end": "01:51:38.000",
      "text": "ال اف باید بخوره حتما"
    },
    {
      "id": 21,
      "start": 6698.0,
      "end": 6700.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:40.000",
      "text": "هران شما شیر خود هم بیدی؟ نه"
    },
    {
      "id": 22,
      "start": 6700.0,
      "end": 6702.0,
      "formatted_start": "01:51:40.000",
      "formatted_end": "01:51:42.000",
      "text": "نه بچه هایی بیدی؟ نه باید شیرخواهش بیدی"
    },
    {
      "id": 23,
      "start": 6702.0,
      "end": 6704.0,
      "formatted_start": "01:51:42.000",
      "formatted_end": "01:51:44.000",
      "text": "خب چرا ال اف ندادی؟"
    },
    {
      "id": 24,
      "start": 6704.0,
      "end": 6707.0,
      "formatted_start": "01:51:44.000",
      "formatted_end": "01:51:47.000",
      "text": "نه گرفتی"
    },
    {
      "id": 25,
      "start": 6707.0,
