      "formatted_start": "03:39:45.100",
      "formatted_end": "03:39:47.100",
      "text": "استفراح؟"
    },
    {
      "id": 42,
      "start": 13187.1,
      "end": 13188.1,
      "formatted_start": "03:39:47.100",
      "formatted_end": "03:39:48.100",
      "text": "نه"
    },
    {
      "id": 43,
      "start": 13188.1,
      "end": 13190.1,
      "formatted_start": "03:39:48.100",
      "formatted_end": "03:39:50.100",
      "text": "ادرار و مطبوعش خوبه؟"
    },
    {
      "id": 44,
      "start": 13190.1,
      "end": 13191.1,
      "formatted_start": "03:39:50.100",
      "formatted_end": "03:39:51.100",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 13191.1,
      "end": 13192.1,
      "formatted_start": "03:39:51.100",
      "formatted_end": "03:39:52.100",
      "text": "بستری؟"
    },
    {
      "id": 46,
      "start": 13192.1,
      "end": 13193.1,
      "formatted_start": "03:39:52.100",
      "formatted_end": "03:39:53.100",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 13193.1,
      "end": 13194.1,
      "formatted_start": "03:39:53.100",
      "formatted_end": "03:39:54.100",
      "text": "پنه آملگی، غند، پشار، تیروی؟"
    },
    {
      "id": 48,
