  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12908.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:08.000",
      "text": "از این مطب پزشکی را بردارید."
    },
    {
      "id": 1,
      "start": 12908.0,
      "end": 12916.0,
      "formatted_start": "03:35:08.000",
      "formatted_end": "03:35:16.000",
      "text": "از این مطب پزشکی را بردارید."
    },
    {
      "id": 2,
      "start": 12916.0,
      "end": 12918.0,
      "formatted_start": "03:35:16.000",
      "formatted_end": "03:35:18.000",
      "text": "حالا خودشون میتونن بگه؟"
    },
    {
      "id": 3,
      "start": 12918.0,
      "end": 12920.0,
      "formatted_start": "03:35:18.000",
      "formatted_end": "03:35:20.000",
      "text": "ازش اینکه نوشته تفسیر بسیاری کنه"
    },
    {
      "id": 4,
      "start": 12920.0,
      "end": 12922.0,
      "formatted_start": "03:35:20.000",
      "formatted_end": "03:35:22.000",
      "text": "خوشمون میتونن بگه"
    },
    {
      "id": 5,
      "start": 12922.0,
      "end": 12924.0,
      "formatted_start": "03:35:22.000",
      "formatted_end": "03:35:24.000",
      "text": "ساره از آزمونشون مطبوعه شده"
    },
    {
      "id": 6,
      "start": 12924.0,
      "end": 12926.0,
      "formatted_start": "03:35:24.000",
      "formatted_end": "03:35:26.000",
      "text": "چرا؟"
    },
    {
      "id": 7,
      "start": 12926.0,
      "end": 12928.0,
      "formatted_start": "03:35:26.000",
      "formatted_end": "03:35:28.000",
      "text": "اینکه؟"
    },
    {
      "id": 8,
      "start": 12928.0,
      "end": 12930.0,
      "formatted_start": "03:35:28.000",
      "formatted_end": "03:35:30.000",
      "text": "جاوان"
    },
    {
      "id": 9,
      "start": 12930.0,
      "end": 12932.0,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:32.000",
      "text": "رنگ مطبوع سیاه زود یا نه؟"
    },
    {
      "id": 10,
      "start": 12932.0,
      "end": 12934.0,
      "formatted_start": "03:35:32.000",
      "formatted_end": "03:35:34.000",
      "text": "نه نه"
    },
    {
      "id": 11,
      "start": 12934.0,
      "end": 12936.0,
      "formatted_start": "03:35:34.000",
      "formatted_end": "03:35:36.000",
      "text": "یه حالت زرده بیان و توش"
    },
    {
      "id": 12,
      "start": 12936.0,
      "end": 12938.0,
      "formatted_start": "03:35:36.000",
      "formatted_end": "03:35:38.000",
      "text": "بیمه های سبز و سپید زیاده باشه"
    },
    {
      "id": 13,
      "start": 12938.0,
      "end": 12940.0,
      "formatted_start": "03:35:38.000",
      "formatted_end": "03:35:40.000",
      "text": "میگن که باشه خوبه"
    },
    {
      "id": 14,
      "start": 12940.0,
      "end": 12942.0,
      "formatted_start": "03:35:40.000",
      "formatted_end": "03:35:42.000",
      "text": "نه باشه"
    },
    {
      "id": 15,
      "start": 12942.0,
      "end": 12944.0,
      "formatted_start": "03:35:42.000",
      "formatted_end": "03:35:44.000",
      "text": "چون خواهد نوشته"
    },
    {
      "id": 16,
      "start": 12944.0,
      "end": 12951.62,
      "formatted_start": "03:35:44.000",
      "formatted_end": "03:35:51.620",
      "text": "ممکنه تو آزمایش مدخوش انگر باشه"
    },
    {
      "id": 17,
      "start": 12951.62,
      "end": 12953.86,
      "formatted_start": "03:35:51.620",
      "formatted_end": "03:35:53.860",
      "text": "انگر سیاه بشه رنگی مدخوش"
    },
    {
      "id": 18,
      "start": 12953.86,
      "end": 12956.86,
      "formatted_start": "03:35:53.860",
      "formatted_end": "03:35:56.860",
      "text": "و اگه انگر باشه بازمسرو رو شروع کن"
    },
    {
      "id": 19,
      "start": 12956.86,
      "end": 12959.32,
      "formatted_start": "03:35:56.860",
      "formatted_end": "03:35:59.320",
      "text": "ولی الان فیلم مسرو لازم نداره تا آزمایش"
    },
    {
      "id": 20,
      "start": 12959.32,
      "end": 12962.26,
      "formatted_start": "03:35:59.320",
      "formatted_end": "03:36:02.260",
      "text": "من میزانشو که نبشه"
    },
    {
      "id": 21,
      "start": 12962.26,
      "end": 12965.66,
      "formatted_start": "03:36:02.260",
      "formatted_end": "03:36:05.660",
      "text": "من رای سال سه سی سی سه سی سی هشت سال هشت"
    },
    {
      "id": 22,
      "start": 12965.66,
      "end": 12970.1,
      "formatted_start": "03:36:05.660",
      "formatted_end": "03:36:10.100",
      "text": "خب ببینید الان من سه رو مونیم"
    },
    {
      "id": 23,
      "start": 12970.1,
      "end": 12978.1,
      "formatted_start": "03:36:10.100",
      "formatted_end": "03:36:18.100",
      "text": "دو مادر پول رو یه شربت و یه شربت دلد و با اکشه صورتان ورش بازه نیستم"
    },
    {
      "id": 24,
      "start": 12978.1,
      "end": 12983.1,
      "formatted_start": "03:36:18.100",
      "formatted_end": "03:36:23.100",
      "text": "از شورترش رو یکمانیمی سی سی برداشت بودیم"
    },
    {
      "id": 25,
      "start": 12983.1,
      "end": 12990.1,
      "formatted_start": "03:36:23.100",
      "formatted_end": "03:36:30.100",
      "text": "شربت بودتا برشن"
    },
    {
      "id": 26,
      "start": 12990.1,
      "end": 13020.1,
      "formatted_start": "03:36:30.100",
      "formatted_end": "03:37:00.100",
      "text": "بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا ب"
    },
    {
      "id": 27,
      "start": 13020.1,
      "end": 13028.1,
      "formatted_start": "03:37:00.100",
      "formatted_end": "03:37:08.100",
      "text": "موسیقی"
    },
    {
      "id": 28,
      "start": 13050.1,
      "end": 13080.08,
      "formatted_start": "03:37:30.100",
      "formatted_end": "03:38:00.080",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 29,
      "start": 13080.1,
      "end": 13100.1,
      "formatted_start": "03:38:00.100",
      "formatted_end": "03:38:20.100",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 13100.1,
      "end": 13125.1,
      "formatted_start": "03:38:20.100",
      "formatted_end": "03:38:45.100",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 13125.1,
      "end": 13127.1,
      "formatted_start": "03:38:45.100",
      "formatted_end": "03:38:47.100",
      "text": "خب این خود را داریم"
    },
    {
      "id": 32,
      "start": 13127.1,
      "end": 13129.1,
      "formatted_start": "03:38:47.100",
      "formatted_end": "03:38:49.100",
      "text": "نه"
    },
    {
      "id": 33,
      "start": 13129.1,
      "end": 13131.1,
      "formatted_start": "03:38:49.100",
      "formatted_end": "03:38:51.100",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 13131.1,
      "end": 13133.1,
      "formatted_start": "03:38:51.100",
      "formatted_end": "03:38:53.100",
      "text": "باید باید اینجا از اینجا سرور نداشتیم"
    },
    {
      "id": 35,
      "start": 13133.1,
      "end": 13135.1,
      "formatted_start": "03:38:53.100",
      "formatted_end": "03:38:55.100",
      "text": "نه ببین"
    },
    {
      "id": 36,
      "start": 13135.1,
      "end": 13137.1,
      "formatted_start": "03:38:55.100",
      "formatted_end": "03:38:57.100",
      "text": "نه ببین"
    },
    {
      "id": 37,
      "start": 13143.1,
      "end": 13145.1,
      "formatted_start": "03:39:03.100",
      "formatted_end": "03:39:05.100",
      "text": "سلام"
    },
    {
      "id": 38,
      "start": 13145.1,
      "end": 13147.1,
      "formatted_start": "03:39:05.100",
      "formatted_end": "03:39:07.100",
      "text": "سلام"
    },
    {
      "id": 39,
      "start": 13147.1,
      "end": 13149.1,
      "formatted_start": "03:39:07.100",
      "formatted_end": "03:39:09.100",
      "text": "کلیمی آزمایش رو بگیر"
    },
    {
      "id": 40,
      "start": 13155.1,
      "end": 13165.1,
      "formatted_start": "03:39:15.100",
      "formatted_end": "03:39:25.100",
