  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8405.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:05.000",
      "text": "برامش بوده کچی، تانچیز داره، عصب نداره."
    },
    {
      "id": 1,
      "start": 8405.0,
      "end": 8410.0,
      "formatted_start": "02:20:05.000",
      "formatted_end": "02:20:10.000",
      "text": "بعد گفت که دوچار همه پیش گفت، دو جدهش، همون کلیز رو بردار گرفته ورده."
    },
    {
      "id": 2,
      "start": 8410.0,
      "end": 8416.0,
      "formatted_start": "02:20:10.000",
      "formatted_end": "02:20:16.000",
      "text": "بعد اون گفت داره، اگه دستشوش ماردن، گفت دارششو میکنه، دستشوش ماردن میکنه."
    },
    {
      "id": 3,
      "start": 8416.0,
      "end": 8422.0,
      "formatted_start": "02:20:16.000",
      "formatted_end": "02:20:22.000",
      "text": "گفت اگه این هاشو کمش رو برم کرد، بیارین گروه کنم، که مثلا عمل میکنن یا از پهرون باز میکنن."
    },
    {
      "id": 4,
      "start": 8422.0,
      "end": 8424.0,
      "formatted_start": "02:20:22.000",
      "formatted_end": "02:20:24.000",
      "text": "نه، باز میکنن."
    },
    {
      "id": 5,
      "start": 8424.0,
      "end": 8425.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:25.000",
      "text": "نه، باز میکنن."
    },
    {
      "id": 6,
      "start": 8425.0,
      "end": 8426.0,
      "formatted_start": "02:20:25.000",
      "formatted_end": "02:20:26.000",
      "text": "چرا شده؟"
    },
    {
      "id": 7,
      "start": 8426.0,
      "end": 8427.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:27.000",
      "text": "درستش نمی کند"
    },
    {
      "id": 8,
      "start": 8427.0,
      "end": 8428.0,
      "formatted_start": "02:20:27.000",
      "formatted_end": "02:20:28.000",
      "text": "چند روزه؟"
    },
    {
      "id": 9,
      "start": 8428.0,
      "end": 8430.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:30.000",
      "text": "دیوز نکرد، دیشب کهر"
    },
    {
      "id": 10,
      "start": 8430.0,
      "end": 8431.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:31.000",
      "text": "باز داره دیگه خد شده"
    },
    {
      "id": 11,
      "start": 8431.0,
      "end": 8433.0,
      "formatted_start": "02:20:31.000",
      "formatted_end": "02:20:33.000",
      "text": "الان صفته شکل می شود"
    },
    {
      "id": 12,
      "start": 8433.0,
      "end": 8434.0,
      "formatted_start": "02:20:33.000",
      "formatted_end": "02:20:34.000",
      "text": "دست کنه؟"
    },
    {
      "id": 13,
      "start": 8434.0,
      "end": 8435.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:35.000",
      "text": "اگه گریه می کنه، شیرم تو تنبی خود"
    },
    {
      "id": 14,
      "start": 8435.0,
      "end": 8436.0,
      "formatted_start": "02:20:35.000",
      "formatted_end": "02:20:36.000",
      "text": "خودش شرزه شده الان؟"
    },
    {
      "id": 15,
      "start": 8436.0,
      "end": 8438.0,
      "formatted_start": "02:20:36.000",
      "formatted_end": "02:20:38.000",
      "text": "الان یه ماه صفت می شود"
    },
    {
      "id": 16,
      "start": 8438.0,
      "end": 8439.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:39.000",
      "text": "دیوز صفت شده؟"
    },
    {
      "id": 17,
      "start": 8439.0,
      "end": 8440.0,
      "formatted_start": "02:20:39.000",
      "formatted_end": "02:20:40.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 8446.0,
      "end": 8448.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:48.000",
      "text": "از این خوشی می پیچه دستشوش به"
    },
    {
      "id": 19,
      "start": 8448.0,
      "end": 8450.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:50.000",
      "text": "این روزو، اون روزو یه ذر اومده"
    },
    {
      "id": 20,
      "start": 8450.0,
      "end": 8452.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:52.000",
      "text": "دیشب چرا؟ تخلیق کردی کنی؟"
    },
    {
      "id": 21,
      "start": 8452.0,
      "end": 8482.0,
      "formatted_start": "02:20:52.000",
      "formatted_end": "02:21:22.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 22,
      "start": 8482.0,
      "end": 8485.28,
      "formatted_start": "02:21:22.000",
      "formatted_end": "02:21:25.280",
      "text": "من رو خودتون بیاییم گرگار برد، من رو خودتون بیاییم اتخاذش"
    },
    {
      "id": 23,
      "start": 8485.28,
      "end": 8488.28,
      "formatted_start": "02:21:25.280",
      "formatted_end": "02:21:28.280",
      "text": "به نظر آنها خواستم بدونم چیز رو بیشتر بگیم"
    },
    {
      "id": 24,
      "start": 8493.72,
      "end": 8495.92,
      "formatted_start": "02:21:33.720",
      "formatted_end": "02:21:35.920",
      "text": "به موضوع سرنوزه دوتا حالت هست"
    },
    {
      "id": 25,
      "start": 8495.92,
      "end": 8499.6,
      "formatted_start": "02:21:35.920",
      "formatted_end": "02:21:39.600",
      "text": "خب اگه این بچه اون نمونه ویروسی جوابش نبود"
    },
    {
      "id": 26,
      "start": 8499.6,
      "end": 8502.88,
      "formatted_start": "02:21:39.600",
      "formatted_end": "02:21:42.880",
      "text": "ما میگفتیم که این حرام خوری که دیگه شکن باز داره"
    },
    {
      "id": 27,
      "start": 8502.88,
      "end": 8505.76,
      "formatted_start": "02:21:42.880",
      "formatted_end": "02:21:45.760",
      "text": "صرف دل لرد داره، زنفهان دل بیچشت هست"
    },
    {
      "id": 28,
      "start": 8505.76,
      "end": 8507.16,
      "formatted_start": "02:21:45.760",
      "formatted_end": "02:21:47.160",
      "text": "این بادر بخاطر اونه"
    },
    {
      "id": 29,
      "start": 8507.16,
      "end": 8512.4,
      "formatted_start": "02:21:47.160",
      "formatted_end": "02:21:52.400",
      "text": "ولی اون بیوبسیه باعث میشه که شما یه روز همشکنمش کار نکنه بترسید"
    },
    {
      "id": 30,
      "start": 8512.4,
      "end": 8513.4,
      "formatted_start": "02:21:52.400",
      "formatted_end": "02:21:53.400",
      "text": "تو؟"
    },
    {
      "id": 31,
      "start": 8513.4,
      "end": 8514.76,
      "formatted_start": "02:21:53.400",
      "formatted_end": "02:21:54.760",
      "text": "الان منم بترسم"
    },
    {
      "id": 32,
      "start": 8514.76,
      "end": 8516.96,
      "formatted_start": "02:21:54.760",
      "formatted_end": "02:21:56.960",
      "text": "چون بیوبسیه اینجوری جبهت داده"
    },
    {
      "id": 33,
      "start": 8516.96,
      "end": 8518.96,
      "formatted_start": "02:21:56.960",
      "formatted_end": "02:21:58.960",
      "text": "ولی اگه این بچه بیوبسی نداشت"
    },
    {
      "id": 34,
      "start": 8518.96,
      "end": 8522.84,
      "formatted_start": "02:21:58.960",
      "formatted_end": "02:22:02.840",
      "text": "مثل همه بچه های دیگه همه که الان معمولیه عادیه باز داره شکنمش"
    },
    {
      "id": 35,
      "start": 8522.84,
      "end": 8523.88,
      "formatted_start": "02:22:02.840",
      "formatted_end": "02:22:03.880",
      "text": "یعنی میتونن نداره"
    },
    {
      "id": 36,
      "start": 8523.88,
      "end": 8526.28,
      "formatted_start": "02:22:03.880",
      "formatted_end": "02:22:06.280",
      "text": "باید قطعه بی بی کیل بده"
    },
    {
      "id": 37,
      "start": 8526.28,
      "end": 8529.08,
      "formatted_start": "02:22:06.280",
      "formatted_end": "02:22:09.080",
      "text": "مثلا چه که یه درم شیاف بذار بیاد بیرون"
    },
    {
      "id": 38,
      "start": 8529.08,
      "end": 8530.6,
      "formatted_start": "02:22:09.080",
      "formatted_end": "02:22:10.600",
      "text": "دردش کمتر بشه"
    },
    {
      "id": 39,
      "start": 8530.6,
      "end": 8535.6,
      "formatted_start": "02:22:10.600",
      "formatted_end": "02:22:15.600",
      "text": "هرچنکه بعد یک مایه تا هفت روزم کار نکنه ما مشکلی نداریم"
    },
    {
      "id": 40,
      "start": 8535.6,
      "end": 8540.6,
      "formatted_start": "02:22:15.600",
      "formatted_end": "02:22:20.600",
      "text": "ولی الان با اون بیوسی همه میترسیم یعنی حتی زفرانی هم میترسه"
    },
    {
      "id": 41,
      "start": 8540.6,
      "end": 8545.6,
      "formatted_start": "02:22:20.600",
      "formatted_end": "02:22:25.600",
      "text": "بنابراین من الان باید یه دونه آزمایش الان با دست خودم مغل شده"
    },
    {
      "id": 42,
      "start": 8545.6,
      "end": 8551.6,
      "formatted_start": "02:22:25.600",
      "formatted_end": "02:22:31.600",
      "text": "کچرو پشار بدم اگر متفوق امتجار بیاد باید بریم تو زفرانی"
    },
    {
      "id": 43,
      "start": 8551.6,
      "end": 8554.6,
      "formatted_start": "02:22:31.600",
      "formatted_end": "02:22:34.600",
      "text": "اگر نه یک کچرو نرم بیاد همه چیز کشکار نداره"
    },
    {
      "id": 44,
      "start": 8554.6,
      "end": 8584.6,
      "formatted_start": "02:22:34.600",
      "formatted_end": "02:23:04.600",
      "text": "در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت"
    },
    {
      "id": 45,
      "start": 8584.6,
      "end": 8594.68,
      "formatted_start": "02:23:04.600",
      "formatted_end": "02:23:14.680",
      "text": "هیچ بچه ای رو قبل از اینکه مدفوع بکنه من به شخص از دیمارستان خارج نمیکنم"
    },
    {
      "id": 46,
      "start": 8594.68,
      "end": 8596.24,
      "formatted_start": "02:23:14.680",
      "formatted_end": "02:23:16.240",
      "text": "اینجا سریستارونه"
    },
    {
      "id": 47,
      "start": 8596.24,
      "end": 8602.22,
      "formatted_start": "02:23:16.240",
      "formatted_end": "02:23:22.220",
      "text": "هیچ بچه ای نباید دیمارستان ترخیص بشه تا شکلش پردن"
    },
    {
      "id": 48,
      "start": 8602.22,
      "end": 8604.14,
      "formatted_start": "02:23:22.220",
      "formatted_end": "02:23:24.140",
      "text": "نه یک داره کار کن یک کمپانه"
    },
    {
      "id": 49,
      "start": 8604.14,
      "end": 8605.34,
      "formatted_start": "02:23:24.140",
      "formatted_end": "02:23:25.340",
      "text": "سلام"
    },
    {
      "id": 50,
      "start": 8605.34,
      "end": 8610.06,
      "formatted_start": "02:23:25.340",
      "formatted_end": "02:23:30.060",
      "text": "برای این چیز رو خانمتون محتمل حضور دادم"
    },
    {
      "id": 51,
      "start": 8610.06,
      "end": 8612.38,
      "formatted_start": "02:23:30.060",
      "formatted_end": "02:23:32.380",
      "text": "یکی که خواهد تو مقعدشو تحلیل کنم"
    },
    {
      "id": 52,
      "start": 8612.38,
      "end": 8613.74,
      "formatted_start": "02:23:32.380",
      "formatted_end": "02:23:33.740",
      "text": "یکی که در برایش"
    },
    {
      "id": 53,
      "start": 8613.74,
      "end": 8615.74,
      "formatted_start": "02:23:33.740",
      "formatted_end": "02:23:35.740",
      "text": "اینکه ممکن نداره؟"
    },
    {
      "id": 54,
      "start": 8615.74,
      "end": 8617.74,
      "formatted_start": "02:23:35.740",
      "formatted_end": "02:23:37.740",
      "text": "اینکه ممکن نداره، این دستشوی کنن"
    },
    {
      "id": 55,
      "start": 8617.74,
      "end": 8619.74,
      "formatted_start": "02:23:37.740",
      "formatted_end": "02:23:39.740",
      "text": "اگه این پچاری بیاد، تو باید برد و یکش زفر نیم"
    },
    {
      "id": 56,
      "start": 8619.74,
      "end": 8621.74,
      "formatted_start": "02:23:39.740",
      "formatted_end": "02:23:41.740",
      "text": "اگه دفعه نرد بیاد، اشکال نداره"
    },
    {
      "id": 57,
      "start": 8621.74,
      "end": 8623.74,
      "formatted_start": "02:23:41.740",
      "formatted_end": "02:23:43.740",
      "text": "میشه تا سه روز بهش خورده بید"
    },
    {
      "id": 58,
      "start": 8623.74,
      "end": 8625.74,
      "formatted_start": "02:23:43.740",
      "formatted_end": "02:23:45.740",
      "text": "یه دستشوی"
    },
    {
      "id": 59,
      "start": 8625.74,
      "end": 8627.74,
      "formatted_start": "02:23:45.740",
      "formatted_end": "02:23:47.740",
      "text": "این بکه اول شبانگیری بود"
    },
    {
      "id": 60,
      "start": 8627.74,
      "end": 8629.74,
      "formatted_start": "02:23:47.740",
      "formatted_end": "02:23:49.740",
      "text": "باید همه از این بکه"
    },
    {
      "id": 61,
      "start": 8629.74,
      "end": 8631.74,
      "formatted_start": "02:23:49.740",
      "formatted_end": "02:23:51.740",
      "text": "نگه شده بود"
    },
    {
      "id": 62,
      "start": 8631.74,
      "end": 8633.74,
      "formatted_start": "02:23:51.740",
      "formatted_end": "02:23:53.740",
      "text": "یعنی اینو بگیر دوشت"
    },
    {
      "id": 63,
      "start": 8633.74,
      "end": 8635.74,
      "formatted_start": "02:23:53.740",
      "formatted_end": "02:23:55.740",
      "text": "دوشت میدی، همینجور"
    },
    {
      "id": 64,
      "start": 8635.74,
      "end": 8637.74,
      "formatted_start": "02:23:55.740",
      "formatted_end": "02:23:57.740",
      "text": "نگه داره؟"
    },
    {
      "id": 65,
      "start": 8637.74,
      "end": 8639.74,
      "formatted_start": "02:23:57.740",
      "formatted_end": "02:23:59.740",
      "text": "خوب نگه داره؟"
    },
    {
      "id": 66,
      "start": 8639.74,
      "end": 8641.74,
      "formatted_start": "02:23:59.740",
      "formatted_end": "02:24:01.740",
      "text": "جا ماما جا"
    },
    {
      "id": 67,
      "start": 8641.74,
      "end": 8645.74,
      "formatted_start": "02:24:01.740",
      "formatted_end": "02:24:05.740",
      "text": "نه داره میاد و انتجاری هم نبود"
    },
    {
      "id": 68,
      "start": 8645.74,
      "end": 8648.74,
      "formatted_start": "02:24:05.740",
      "formatted_end": "02:24:08.740",
      "text": "داره میاد بگیر درست داره بگیر"
    },
    {
      "id": 69,
      "start": 8648.74,
      "end": 8651.74,
      "formatted_start": "02:24:08.740",
      "formatted_end": "02:24:11.740",
      "text": "چون اینجا الان تحلیل شکل نداره"
    },
    {
      "id": 70,
      "start": 8651.74,
      "end": 8653.74,
      "formatted_start": "02:24:11.740",
      "formatted_end": "02:24:13.740",
      "text": "جا خدا داره نمونی"
    },
    {
      "id": 71,
      "start": 8653.74,
      "end": 8655.74,
      "formatted_start": "02:24:13.740",
      "formatted_end": "02:24:15.740",
      "text": "چون الان درست انتجاری نداره خوب؟"
    },
    {
      "id": 72,
      "start": 8655.74,
      "end": 8656.74,
      "formatted_start": "02:24:15.740",
      "formatted_end": "02:24:16.740",
      "text": "آه"
    },
    {
      "id": 73,
      "start": 8656.74,
      "end": 8659.74,
      "formatted_start": "02:24:16.740",
      "formatted_end": "02:24:19.740",
      "text": "پس اینکه چهره هم مشکلی در واقع دوم بیاد"
    },
    {
      "id": 74,
      "start": 8659.74,
      "end": 8660.74,
      "formatted_start": "02:24:19.740",
      "formatted_end": "02:24:20.740",
      "text": "چهره مشکلش نیست"
    },
    {
      "id": 75,
      "start": 8660.74,
      "end": 8662.74,
      "formatted_start": "02:24:20.740",
      "formatted_end": "02:24:22.740",
      "text": "اگه گفتم من اینو کار کردم"
    },
    {
      "id": 76,
      "start": 8662.74,
      "end": 8663.74,
      "formatted_start": "02:24:22.740",
      "formatted_end": "02:24:23.740",
      "text": "پشت میزن در اون"
    },
    {
      "id": 77,
      "start": 8663.74,
      "end": 8665.74,
      "formatted_start": "02:24:23.740",
      "formatted_end": "02:24:25.740",
      "text": "در این اون آره کم برمیزن"
    },
    {
      "id": 78,
      "start": 8665.74,
      "end": 8667.74,
      "formatted_start": "02:24:25.740",
      "formatted_end": "02:24:27.740",
      "text": "تو اونجا دیشتره"
    },
    {
      "id": 79,
      "start": 8667.74,
      "end": 8697.74,
      "formatted_start": "02:24:27.740",
      "formatted_end": "02:24:57.740",
      "text": "اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه، اوه"
    },
    {
      "id": 80,
      "start": 8697.74,
      "end": 8699.74,
      "formatted_start": "02:24:57.740",
      "formatted_end": "02:24:59.740",
      "text": "اینجا باید بگیرم که چی داری؟"
    }
  ],
  "status": "completed"
}