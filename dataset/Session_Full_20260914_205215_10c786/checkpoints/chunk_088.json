  "stt_segments": [
    {
      "id": 0,
      "start": 26400.0,
      "end": 26419.0,
      "formatted_start": "07:20:00.000",
      "formatted_end": "07:20:19.000",
      "text": "بگید مثلا با مزه ای نام، این پزشکی خوبشکیه. زمانی که من وارد شدم به سینما و در زمانی که ما نوجوان بودیم که زمان شیطنت مولده هر روز داریم بوده مورد توجه جز مخالف قرار بگیریم، من اصلا موضوع نکنی نکنی نمیدونم من رو بگیریم."
    },
    {
      "id": 1,
      "start": 26430.0,
      "end": 26459.0,
      "formatted_start": "07:20:30.000",
      "formatted_end": "07:20:59.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 26460.0,
      "end": 26464.8,
      "formatted_start": "07:21:00.000",
      "formatted_end": "07:21:04.800",
      "text": "سلام، پدران شمسه ای از سرمانمونم از تیم اومان ای از حدیثی به ایپلی شد"
    },
    {
      "id": 3,
      "start": 26464.8,
      "end": 26467.76,
      "formatted_start": "07:21:04.800",
      "formatted_end": "07:21:07.760",
      "text": "چون برای سطحی شمسه ای زمان موقع فراموش بیشتر ایزم"
    },
    {
      "id": 4,
      "start": 26467.76,
      "end": 26469.04,
      "formatted_start": "07:21:07.760",
      "formatted_end": "07:21:09.040",
      "text": "بیا به ایپلی بگم ببین"
    },
    {
      "id": 5,
      "start": 26469.04,
      "end": 26475.44,
      "formatted_start": "07:21:09.040",
      "formatted_end": "07:21:15.440",
      "text": "موج محاجرت پرستران پاده دوان به موجه خلیج پارس از جهان اومان امروز فقط ترزیاد شده"
    },
    {
      "id": 6,
      "start": 26475.44,
      "end": 26478.64,
      "formatted_start": "07:21:15.440",
      "formatted_end": "07:21:18.640",
      "text": "اگه پاده دوانی و دوستای دستر تا این زمان مون؟"
    },
    {
      "id": 7,
      "start": 26490.0,
      "end": 26509.0,
      "formatted_start": "07:21:30.000",
      "formatted_end": "07:21:49.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 26509.0,
      "end": 26511.0,
      "formatted_start": "07:21:49.000",
      "formatted_end": "07:21:51.000",
      "text": "الهانو بررفت؟"
    },
    {
      "id": 9,
      "start": 26511.0,
      "end": 26515.0,
      "formatted_start": "07:21:51.000",
      "formatted_end": "07:21:55.000",
      "text": "آه، نفس نگوزه میخوام کل رو ببرم"
    },
    {
      "id": 10,
      "start": 26515.0,
      "end": 26517.0,
      "formatted_start": "07:21:55.000",
      "formatted_end": "07:21:57.000",
      "text": "فکر کردی؟"
    },
    {
      "id": 11,
      "start": 26517.0,
      "end": 26519.0,
      "formatted_start": "07:21:57.000",
      "formatted_end": "07:21:59.000",
      "text": "آه"
    },
    {
      "id": 12,
      "start": 26519.0,
      "end": 26522.0,
      "formatted_start": "07:21:59.000",
      "formatted_end": "07:22:02.000",
      "text": "او رو تا اونو گفتم"
    },
    {
      "id": 13,
      "start": 26522.0,
      "end": 26524.0,
      "formatted_start": "07:22:02.000",
      "formatted_end": "07:22:04.000",
      "text": "کننده"
    },
    {
      "id": 14,
      "start": 26524.0,
      "end": 26526.0,
      "formatted_start": "07:22:04.000",
      "formatted_end": "07:22:06.000",
      "text": "باشه خدا فهمیست"
    },
    {
      "id": 15,
      "start": 26539.0,
      "end": 26549.0,
      "formatted_start": "07:22:19.000",
      "formatted_end": "07:22:29.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 26569.0,
      "end": 26598.98,
      "formatted_start": "07:22:49.000",
      "formatted_end": "07:23:18.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 17,
      "start": 26599.0,
      "end": 26628.98,
      "formatted_start": "07:23:19.000",
      "formatted_end": "07:23:48.980",
