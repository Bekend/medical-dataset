  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7204.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:04.000",
      "text": "از اینجا ترق نداشت."
    },
    {
      "id": 1,
      "start": 7204.0,
      "end": 7209.0,
      "formatted_start": "02:00:04.000",
      "formatted_end": "02:00:09.000",
      "text": "من از نداشت اشتباه شده بودم. من گریه اینجا رو میباشم."
    },
    {
      "id": 2,
      "start": 7209.0,
      "end": 7212.0,
      "formatted_start": "02:00:09.000",
      "formatted_end": "02:00:12.000",
      "text": "همینجا رو میباشم."
    },
    {
      "id": 3,
      "start": 7212.0,
      "end": 7214.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:14.000",
      "text": "الان پنج سال رو میباشت. درسته؟"
    },
    {
      "id": 4,
      "start": 7214.0,
      "end": 7216.0,
      "formatted_start": "02:00:14.000",
      "formatted_end": "02:00:16.000",
      "text": "نه، چهار."
    },
    {
      "id": 5,
      "start": 7216.0,
      "end": 7218.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:18.000",
      "text": "۱۶۱۱۱؟"
    },
    {
      "id": 6,
      "start": 7218.0,
      "end": 7220.0,
      "formatted_start": "02:00:18.000",
      "formatted_end": "02:00:20.000",
      "text": "آره، چهار رو برمی کنم."
    },
    {
      "id": 7,
      "start": 7220.0,
      "end": 7221.0,
      "formatted_start": "02:00:20.000",
      "formatted_end": "02:00:21.000",
      "text": "سه سال رو میباشی؟"
    },
    {
      "id": 8,
      "start": 7221.0,
      "end": 7222.0,
      "formatted_start": "02:00:21.000",
      "formatted_end": "02:00:22.000",
      "text": "بله، سه سال."
    },
    {
      "id": 9,
      "start": 7222.0,
      "end": 7223.0,
      "formatted_start": "02:00:22.000",
      "formatted_end": "02:00:23.000",
      "text": "بله، سه سال برمی کنم."
    },
    {
      "id": 10,
      "start": 7223.0,
      "end": 7226.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:26.000",
      "text": "گرژ یازده، چهار سالش برمیشه؟"
    },
    {
      "id": 11,
      "start": 7226.0,
      "end": 7227.0,
      "formatted_start": "02:00:26.000",
      "formatted_end": "02:00:27.000",
      "text": "بله، بله."
    },
    {
      "id": 12,
      "start": 7227.0,
      "end": 7228.0,
      "formatted_start": "02:00:27.000",
      "formatted_end": "02:00:28.000",
      "text": "سه سال رو هفت برمیشه؟"
    },
    {
      "id": 13,
      "start": 7228.0,
      "end": 7230.0,
      "formatted_start": "02:00:28.000",
      "formatted_end": "02:00:30.000",
      "text": "برزش اضافه همه هست"
    },
    {
      "id": 14,
      "start": 7230.0,
      "end": 7232.0,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:32.000",
      "text": "افران یکم بکنید"
    },
    {
      "id": 15,
      "start": 7232.0,
      "end": 7234.0,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:34.000",
      "text": "اولی بکنید"
    },
    {
      "id": 16,
      "start": 7234.0,
      "end": 7236.0,
      "formatted_start": "02:00:34.000",
      "formatted_end": "02:00:36.000",
      "text": "خوبه که وقتش اینا هست"
    },
    {
      "id": 17,
      "start": 7236.0,
      "end": 7238.0,
      "formatted_start": "02:00:36.000",
      "formatted_end": "02:00:38.000",
      "text": "دفتر به همسیده هاشی"
    },
    {
      "id": 18,
      "start": 7238.0,
      "end": 7240.0,
      "formatted_start": "02:00:38.000",
      "formatted_end": "02:00:40.000",
      "text": "بینیس قردشو بگیم"
    },
    {
      "id": 19,
      "start": 7240.0,
      "end": 7242.0,
      "formatted_start": "02:00:40.000",
      "formatted_end": "02:00:42.000",
      "text": "باید ۹۸ کشکت بکنیم"
    },
    {
      "id": 20,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "نه این صدق خورده نیست"
    },
    {
      "id": 21,
      "start": 7244.0,
      "end": 7246.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:46.000",
      "text": "صدا دو بود فکر کنن"
    },
    {
      "id": 22,
      "start": 7246.0,
      "end": 7248.0,
      "formatted_start": "02:00:46.000",
      "formatted_end": "02:00:48.000",
      "text": "بدون کفش"
    },
    {
      "id": 23,
      "start": 7248.0,
      "end": 7250.0,
      "formatted_start": "02:00:48.000",
      "formatted_end": "02:00:50.000",
      "text": "الان"
    },
    {
      "id": 24,
      "start": 7250.0,
      "end": 7252.0,
      "formatted_start": "02:00:50.000",
      "formatted_end": "02:00:52.000",
      "text": "بدون دستد و پنجه"
    },
    {
      "id": 25,
      "start": 7252.0,
      "end": 7254.0,
      "formatted_start": "02:00:52.000",
      "formatted_end": "02:00:54.000",
      "text": "بدون کفش صدا دو بود فکر کنن"
    },
    {
      "id": 26,
      "start": 7254.0,
      "end": 7256.0,
      "formatted_start": "02:00:54.000",
      "formatted_end": "02:00:56.000",
      "text": "بدون دستد و پنجه"
    },
    {
      "id": 27,
      "start": 7256.0,
      "end": 7259.0,
      "formatted_start": "02:00:56.000",
      "formatted_end": "02:00:59.000",
      "text": "کششو در بیارون توقت منوشیم که"
    },
    {
      "id": 28,
      "start": 7259.0,
      "end": 7260.0,
      "formatted_start": "02:00:59.000",
      "formatted_end": "02:01:00.000",
      "text": "تدریش کنیم؟"
    },
    {
      "id": 29,
      "start": 7260.0,
      "end": 7263.0,
      "formatted_start": "02:01:00.000",
      "formatted_end": "02:01:03.000",
      "text": "نویده هشت باید باشه اینقدر دیش برم"
    },
    {
      "id": 30,
      "start": 7263.0,
      "end": 7266.0,
      "formatted_start": "02:01:03.000",
      "formatted_end": "02:01:06.000",
      "text": "خب بنابراین بدون کشش و آقایش"
    },
    {
      "id": 31,
      "start": 7266.0,
      "end": 7267.0,
      "formatted_start": "02:01:06.000",
      "formatted_end": "02:01:07.000",
      "text": "صدا داریم"
    },
    {
      "id": 32,
      "start": 7267.0,
      "end": 7268.0,
      "formatted_start": "02:01:07.000",
      "formatted_end": "02:01:08.000",
      "text": "صدا داریم"
    },
    {
      "id": 33,
      "start": 7268.0,
      "end": 7270.0,
      "formatted_start": "02:01:08.000",
      "formatted_end": "02:01:10.000",
      "text": "خب خوب"
    },
    {
      "id": 34,
      "start": 7271.0,
      "end": 7274.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:14.000",
      "text": "هرچی بلد بیشتر باشه باید کشش برم"
    },
    {
      "id": 35,
      "start": 7277.0,
      "end": 7281.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:21.000",
      "text": "اندازه مشانه بچه چهار و نمی سال هست"
    },
    {
      "id": 36,
      "start": 7281.0,
      "end": 7282.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:22.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 7282.0,
      "end": 7288.0,
      "formatted_start": "02:01:22.000",
      "formatted_end": "02:01:28.000",
      "text": "یکمی کنن یکم که پرسید مدرسه میره نه؟ نه گفتم آره"
    },
    {
      "id": 38,
      "start": 7288.0,
      "end": 7290.0,
      "formatted_start": "02:01:28.000",
      "formatted_end": "02:01:30.000",
      "text": "آره چیست؟"
    },
    {
      "id": 39,
      "start": 7290.0,
      "end": 7293.0,
      "formatted_start": "02:01:30.000",
      "formatted_end": "02:01:33.000",
      "text": "یکجایی بودیم پرسید، یکم چی نیست؟"
    },
    {
      "id": 40,
      "start": 7293.0,
      "end": 7302.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:42.000",
      "text": "اصلا الان چون تب داره چیز نلرد داره و یا نوبت استفراق اصلا بهش چیز نده"
    },
    {
      "id": 41,
      "start": 7302.0,
      "end": 7305.0,
      "formatted_start": "02:01:42.000",
      "formatted_end": "02:01:45.000",
      "text": "گروه نده برای تب و نلرد"
    },
    {
      "id": 42,
      "start": 7305.0,
      "end": 7308.0,
      "formatted_start": "02:01:45.000",
      "formatted_end": "02:01:48.000",
      "text": "نوبت هایی که درکون نمیدن، تب بکنن اون کراکی داره"
    },
    {
      "id": 43,
      "start": 7308.0,
      "end": 7310.0,
      "formatted_start": "02:01:48.000",
      "formatted_end": "02:01:50.000",
      "text": "آره کراکی کماستان"
    },
    {
      "id": 44,
      "start": 7310.0,
      "end": 7312.0,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:52.000",
      "text": "اون همه ها داره یک چیز"
    },
    {
      "id": 45,
      "start": 7332.0,
      "end": 7333.0,
      "formatted_start": "02:02:12.000",
      "formatted_end": "02:02:13.000",
      "text": "درسته ایم؟"
    },
    {
      "id": 46,
      "start": 7333.0,
      "end": 7335.0,
      "formatted_start": "02:02:13.000",
      "formatted_end": "02:02:15.000",
      "text": "باید چشم و مزارشم رایی هم آزیم"
    },
    {
      "id": 47,
      "start": 7336.0,
      "end": 7338.0,
      "formatted_start": "02:02:16.000",
      "formatted_end": "02:02:18.000",
      "text": "خوب، یه هم آزیم، بذارین شده"
    },
    {
      "id": 48,
      "start": 7338.0,
      "end": 7340.0,
      "formatted_start": "02:02:18.000",
      "formatted_end": "02:02:20.000",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 49,
      "start": 7340.0,
      "end": 7342.0,
      "formatted_start": "02:02:20.000",
      "formatted_end": "02:02:22.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 50,
      "start": 7342.0,
      "end": 7344.0,
      "formatted_start": "02:02:22.000",
      "formatted_end": "02:02:24.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 51,
      "start": 7344.0,
      "end": 7346.0,
      "formatted_start": "02:02:24.000",
      "formatted_end": "02:02:26.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 52,
      "start": 7346.0,
      "end": 7348.0,
      "formatted_start": "02:02:26.000",
      "formatted_end": "02:02:28.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 53,
      "start": 7348.0,
      "end": 7350.0,
      "formatted_start": "02:02:28.000",
      "formatted_end": "02:02:30.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 54,
      "start": 7350.0,
      "end": 7352.0,
      "formatted_start": "02:02:30.000",
      "formatted_end": "02:02:32.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 55,
      "start": 7352.0,
      "end": 7354.0,
      "formatted_start": "02:02:32.000",
      "formatted_end": "02:02:34.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 56,
      "start": 7354.0,
      "end": 7356.0,
      "formatted_start": "02:02:34.000",
      "formatted_end": "02:02:36.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 57,
      "start": 7356.0,
      "end": 7358.0,
      "formatted_start": "02:02:36.000",
      "formatted_end": "02:02:38.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 58,
      "start": 7358.0,
      "end": 7360.0,
      "formatted_start": "02:02:38.000",
      "formatted_end": "02:02:40.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 59,
      "start": 7360.0,
      "end": 7362.0,
      "formatted_start": "02:02:40.000",
      "formatted_end": "02:02:42.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 60,
      "start": 7362.0,
      "end": 7365.0,
      "formatted_start": "02:02:42.000",
      "formatted_end": "02:02:45.000",
      "text": "داروی خاصی شروع کردی توی این هشتان روزه؟"
    },
    {
      "id": 61,
      "start": 7365.0,
      "end": 7368.0,
      "formatted_start": "02:02:45.000",
      "formatted_end": "02:02:48.000",
      "text": "داریمکتیکوم، میلکیل، میخازیم"
    },
    {
      "id": 62,
      "start": 7368.0,
      "end": 7371.0,
      "formatted_start": "02:02:48.000",
      "formatted_end": "02:02:51.000",
      "text": "خودتون داده بودید، یکی هم یخچاری است"
    },
    {
      "id": 63,
      "start": 7371.0,
      "end": 7372.0,
      "formatted_start": "02:02:51.000",
      "formatted_end": "02:02:52.000",
      "text": "یخچاری روتپلور دیگه اتماده؟"
    },
    {
      "id": 64,
      "start": 7372.0,
      "end": 7374.0,
      "formatted_start": "02:02:52.000",
      "formatted_end": "02:02:54.000",
      "text": "آهان همونم"
    },
    {
      "id": 65,
      "start": 7374.0,
      "end": 7376.0,
      "formatted_start": "02:02:54.000",
      "formatted_end": "02:02:56.000",
      "text": "میخازیمو باید قطع کنیم"
    },
    {
      "id": 66,
      "start": 7376.0,
      "end": 7377.0,
      "formatted_start": "02:02:56.000",
      "formatted_end": "02:02:57.000",
      "text": "قطع کنم"
    },
    {
      "id": 67,
      "start": 7377.0,
      "end": 7379.0,
      "formatted_start": "02:02:57.000",
      "formatted_end": "02:02:59.000",
      "text": "و به جای روتپلورم باید بیویکیلی بدیم"
    },
    {
      "id": 68,
      "start": 7379.0,
      "end": 7381.0,
      "formatted_start": "02:02:59.000",
      "formatted_end": "02:03:01.000",
      "text": "یه دن شیاف باید بزنیم"
    },
    {
      "id": 69,
      "start": 7381.0,
      "end": 7383.0,
      "formatted_start": "02:03:01.000",
      "formatted_end": "02:03:03.000",
      "text": "چون این غذایی که نخورده"
    },
    {
      "id": 70,
      "start": 7383.0,
      "end": 7387.0,
      "formatted_start": "02:03:03.000",
      "formatted_end": "02:03:07.000",
      "text": "چیلش که عوض نشده داروی که مصرف نکرده جز همین داروی دیگه چه"
    },
    {
      "id": 71,
      "start": 7387.0,
      "end": 7388.0,
      "formatted_start": "02:03:07.000",
      "formatted_end": "02:03:08.000",
      "text": "آه ایو"
    },
    {
      "id": 72,
      "start": 7388.0,
      "end": 7390.0,
      "formatted_start": "02:03:08.000",
      "formatted_end": "02:03:10.000",
      "text": "نه آن رو کس قدر نکردیم"
    },
    {
      "id": 73,
      "start": 7390.0,
      "end": 7392.0,
      "formatted_start": "02:03:10.000",
      "formatted_end": "02:03:12.000",
      "text": "بیا رو من ازشو بگیرم"
    },
    {
      "id": 74,
      "start": 7394.0,
      "end": 7397.0,
      "formatted_start": "02:03:14.000",
      "formatted_end": "02:03:17.000",
      "text": "اون ایو خوری کستی خوری مکس رو نمیشه بگیرم"
    },
    {
      "id": 75,
      "start": 7397.0,
      "end": 7398.0,
      "formatted_start": "02:03:17.000",
      "formatted_end": "02:03:18.000",
      "text": "نمیشه بگیرم"
    },
    {
      "id": 76,
      "start": 7401.0,
      "end": 7403.0,
      "formatted_start": "02:03:21.000",
      "formatted_end": "02:03:23.000",
      "text": "نه نشده"
    },
    {
      "id": 77,
      "start": 7407.0,
      "end": 7408.0,
      "formatted_start": "02:03:27.000",
      "formatted_end": "02:03:28.000",
      "text": "حالا بگیرم"
    },
    {
      "id": 78,
      "start": 7408.0,
      "end": 7409.0,
      "formatted_start": "02:03:28.000",
      "formatted_end": "02:03:29.000",
      "text": "بگیرم"
    },
    {
      "id": 79,
      "start": 7413.0,
      "end": 7415.0,
      "formatted_start": "02:03:33.000",
      "formatted_end": "02:03:35.000",
      "text": "اینکه باید برداری کنید."
    },
    {
      "id": 80,
      "start": 7415.0,
      "end": 7417.0,
      "formatted_start": "02:03:35.000",
      "formatted_end": "02:03:37.000",
      "text": "اینکه باید برداری کنید."
    },
    {
      "id": 81,
      "start": 7417.0,
      "end": 7419.0,
      "formatted_start": "02:03:37.000",
      "formatted_end": "02:03:39.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 82,
      "start": 7419.0,
      "end": 7421.0,
      "formatted_start": "02:03:39.000",
      "formatted_end": "02:03:41.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 83,
      "start": 7421.0,
      "end": 7423.0,
      "formatted_start": "02:03:41.000",
      "formatted_end": "02:03:43.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 84,
      "start": 7423.0,
      "end": 7425.0,
      "formatted_start": "02:03:43.000",
      "formatted_end": "02:03:45.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 85,
      "start": 7425.0,
      "end": 7427.0,
      "formatted_start": "02:03:45.000",
      "formatted_end": "02:03:47.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 86,
      "start": 7427.0,
      "end": 7429.0,
      "formatted_start": "02:03:47.000",
      "formatted_end": "02:03:49.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 87,
      "start": 7429.0,
      "end": 7431.0,
      "formatted_start": "02:03:49.000",
      "formatted_end": "02:03:51.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 88,
      "start": 7431.0,
      "end": 7433.0,
      "formatted_start": "02:03:51.000",
      "formatted_end": "02:03:53.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 89,
      "start": 7433.0,
      "end": 7435.0,
      "formatted_start": "02:03:53.000",
      "formatted_end": "02:03:55.000",
      "text": "چرا از اینکه برداری کنید؟"
    },
    {
      "id": 90,
      "start": 7435.0,
      "end": 7439.0,
      "formatted_start": "02:03:55.000",
      "formatted_end": "02:03:59.000",
      "text": "اونی که خورده به درد سخت و سازش باید خورده"
    },
    {
      "id": 91,
      "start": 7439.0,
      "end": 7441.0,
      "formatted_start": "02:03:59.000",
      "formatted_end": "02:04:01.000",
      "text": "به روده دیگه نرسیده"
    },
    {
      "id": 92,
      "start": 7441.0,
      "end": 7444.0,
      "formatted_start": "02:04:01.000",
      "formatted_end": "02:04:04.000",
      "text": "قبل روده دیگه مصرف کالوری کرده تمام شده"
    },
    {
      "id": 93,
      "start": 7444.0,
      "end": 7447.0,
      "formatted_start": "02:04:04.000",
      "formatted_end": "02:04:07.000",
      "text": "الان چیزی های اینجا خیلی باید بیشتر کنی"
    },
    {
      "id": 94,
      "start": 7447.0,
      "end": 7450.0,
      "formatted_start": "02:04:07.000",
      "formatted_end": "02:04:10.000",
      "text": "این الان باید توی ۸۰۰۰۰۰ گلق میگرد"
    },
    {
      "id": 95,
      "start": 7450.0,
      "end": 7454.0,
      "formatted_start": "02:04:10.000",
      "formatted_end": "02:04:14.000",
      "text": "یکی از علتهای مجدد بستری شدن نارستان"
    },
    {
      "id": 96,
      "start": 7454.0,
      "end": 7456.0,
      "formatted_start": "02:04:14.000",
      "formatted_end": "02:04:16.000",
      "text": "از خوردن شیر و از نگرفتنه"
    },
    {
      "id": 97,
      "start": 7456.0,
      "end": 7459.0,
      "formatted_start": "02:04:16.000",
      "formatted_end": "02:04:19.000",
      "text": "همینجوری پیش بره ما باید بستریش کنیم"
    },
    {
      "id": 98,
      "start": 7459.0,
      "end": 7466.0,
      "formatted_start": "02:04:19.000",
      "formatted_end": "02:04:26.000",
      "text": "اصلا تو شیر دادن حتی شده استفراغم می کنه بکنه ولی خصیص بازی نباید داری"
    },
    {
      "id": 99,
      "start": 7466.0,
      "end": 7467.0,
      "formatted_start": "02:04:26.000",
      "formatted_end": "02:04:27.000",
      "text": "نه نمی کنه"
    },
    {
      "id": 100,
      "start": 7467.0,
      "end": 7468.0,
      "formatted_start": "02:04:27.000",
      "formatted_end": "02:04:28.000",
      "text": "که بترسی"
    },
    {
      "id": 101,
      "start": 7468.0,
      "end": 7471.0,
      "formatted_start": "02:04:28.000",
      "formatted_end": "02:04:31.000",
      "text": "نه بکنه بزار بزار بمانش کنه"
    },
    {
      "id": 102,
      "start": 7471.0,
      "end": 7475.0,
      "formatted_start": "02:04:31.000",
      "formatted_end": "02:04:35.000",
      "text": "الان این خطرنافترین چیزی باید نگرفتنه برای ما"
    },
    {
      "id": 103,
      "start": 7475.0,
      "end": 7479.0,
      "formatted_start": "02:04:35.000",
      "formatted_end": "02:04:39.000",
      "text": "مذکور نکنه ده روزم نکنه معلومه الان چیزی نخورده"
    },
    {
      "id": 104,
      "start": 7479.0,
      "end": 7482.0,
      "formatted_start": "02:04:39.000",
      "formatted_end": "02:04:42.000",
      "text": "شما الان شیر شواض چند رو بیدی؟"
    },
    {
      "id": 105,
      "start": 7482.0,
      "end": 7484.0,
