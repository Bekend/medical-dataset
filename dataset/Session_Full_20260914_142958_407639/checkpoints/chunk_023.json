      "text": "این همه باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی که باشگاه هایی"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6932.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:32.000",
      "text": "از این روز چند تا خورده کنم؟"
    },
    {
      "id": 2,
      "start": 6932.0,
      "end": 6934.0,
      "formatted_start": "01:55:32.000",
      "formatted_end": "01:55:34.000",
      "text": "یه صبح و شب"
    },
    {
      "id": 3,
      "start": 6934.0,
      "end": 6936.0,
      "formatted_start": "01:55:34.000",
      "formatted_end": "01:55:36.000",
      "text": "یعنی یه براق کنم برم"
    },
    {
      "id": 4,
      "start": 6936.0,
      "end": 6938.0,
      "formatted_start": "01:55:36.000",
      "formatted_end": "01:55:38.000",
      "text": "شام بود که تو کل مزول هم زده؟"
    },
    {
      "id": 5,
      "start": 6938.0,
      "end": 6940.0,
      "formatted_start": "01:55:38.000",
      "formatted_end": "01:55:40.000",
      "text": "بله بله شام بودم"
    },
    {
      "id": 6,
      "start": 6940.0,
      "end": 6942.0,
      "formatted_start": "01:55:40.000",
      "formatted_end": "01:55:42.000",
      "text": "کمات هست این آفیازه؟"
    },
    {
      "id": 7,
      "start": 6942.0,
      "end": 6944.0,
      "formatted_start": "01:55:42.000",
      "formatted_end": "01:55:44.000",
      "text": "کمات هست این آفیازه"
    },
    {
      "id": 8,
      "start": 6944.0,
      "end": 6946.0,
      "formatted_start": "01:55:44.000",
      "formatted_end": "01:55:46.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 9,
      "start": 6946.0,
      "end": 6948.0,
      "formatted_start": "01:55:46.000",
      "formatted_end": "01:55:48.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 10,
      "start": 6948.0,
      "end": 6950.0,
      "formatted_start": "01:55:48.000",
      "formatted_end": "01:55:50.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 11,
      "start": 6950.0,
      "end": 6952.0,
      "formatted_start": "01:55:50.000",
      "formatted_end": "01:55:52.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 12,
      "start": 6952.0,
      "end": 6954.0,
      "formatted_start": "01:55:52.000",
      "formatted_end": "01:55:54.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 13,
      "start": 6954.0,
      "end": 6956.0,
      "formatted_start": "01:55:54.000",
      "formatted_end": "01:55:56.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 14,
      "start": 6956.0,
      "end": 6958.0,
      "formatted_start": "01:55:56.000",
      "formatted_end": "01:55:58.000",
      "text": "این آفیازه برم"
    },
    {
      "id": 15,
      "start": 6958.0,
      "end": 6965.0,
      "formatted_start": "01:55:58.000",
      "formatted_end": "01:56:05.000",
      "text": "اینجوری باید جواب میدونیم چون شما بردارش هست"
    },
    {
      "id": 16,
      "start": 6965.0,
      "end": 6967.0,
      "formatted_start": "01:56:05.000",
      "formatted_end": "01:56:07.000",
      "text": "و بعدی تمام بردارش هست"
    },
    {
      "id": 17,
      "start": 6967.0,
      "end": 6969.0,
      "formatted_start": "01:56:07.000",
      "formatted_end": "01:56:09.000",
      "text": "و اینکاره میره به سرده"
    },
    {
      "id": 18,
      "start": 6969.0,
      "end": 6973.4,
      "formatted_start": "01:56:09.000",
      "formatted_end": "01:56:13.400",
      "text": "از اینجور را برداشت و تمام درسته اومده باشه و تا آرچش کشید"
    },
    {
      "id": 19,
      "start": 6973.4,
      "end": 6975.4,
      "formatted_start": "01:56:13.400",
      "formatted_end": "01:56:15.400",
      "text": "حالا 60 درجه"
    },
    {
      "id": 20,
      "start": 6975.4,
      "end": 6977.96,
      "formatted_start": "01:56:15.400",
      "formatted_end": "01:56:17.960",
      "text": "و اینکه خوب شده باشه و وقتی میشه دوره"
    },
    {
      "id": 21,
      "start": 6977.96,
      "end": 6979.4,
      "formatted_start": "01:56:17.960",
      "formatted_end": "01:56:19.400",
      "text": "این مورد کشتی میده برد"
    },
    {
      "id": 22,
      "start": 6979.4,
      "end": 6981.4,
      "formatted_start": "01:56:19.400",
      "formatted_end": "01:56:21.400",
      "text": "از اینجور کشتی برداشت"
    },
    {
      "id": 23,
      "start": 6981.4,
      "end": 6985.4,
      "formatted_start": "01:56:21.400",
      "formatted_end": "01:56:25.400",
      "text": "کشتی محل آرچه"
    },
    {
      "id": 24,
      "start": 6985.4,
      "end": 6991.4,
      "formatted_start": "01:56:25.400",
      "formatted_end": "01:56:31.400",
      "text": "از اینجور کشتی گرفتید"
    },
    {
      "id": 25,
      "start": 6991.4,
      "end": 6995.4,
      "formatted_start": "01:56:31.400",
      "formatted_end": "01:56:35.400",
      "text": "اصلا در کشتگیرها فر آرچه"
    },
    {
      "id": 26,
      "start": 6995.4,
      "end": 6998.4,
      "formatted_start": "01:56:35.400",
      "formatted_end": "01:56:38.400",
      "text": "باید مردون نیمونیم، تنیز میتونیم برسنیم"
    },
    {
      "id": 27,
      "start": 6998.4,
      "end": 6999.4,
      "formatted_start": "01:56:38.400",
      "formatted_end": "01:56:39.400",
      "text": "اصلا سرگز نرم"
    },
    {
      "id": 28,
      "start": 6999.4,
      "end": 7001.4,
      "formatted_start": "01:56:39.400",
      "formatted_end": "01:56:41.400",
      "text": "قارش خیلی مقابل هست"
    },
    {
      "id": 29,
      "start": 7001.4,
      "end": 7005.4,
      "formatted_start": "01:56:41.400",
      "formatted_end": "01:56:45.400",
      "text": "تو دمایی پای ندلی میده، قارش ها خیلی مقابل هست"
    },
    {
      "id": 30,
      "start": 7005.4,
      "end": 7008.4,
      "formatted_start": "01:56:45.400",
      "formatted_end": "01:56:48.400",
      "text": "من برای دارو میده مثلا خواه"
    },
    {
      "id": 31,
      "start": 7008.4,
      "end": 7010.4,
      "formatted_start": "01:56:48.400",
      "formatted_end": "01:56:50.400",
      "text": "داروش رو یکم عوض میکنم"
    },
    {
      "id": 32,
      "start": 7010.4,
      "end": 7011.4,
      "formatted_start": "01:56:50.400",
      "formatted_end": "01:56:51.400",
      "text": "شامپود همون"
    },
    {
      "id": 33,
      "start": 7011.4,
      "end": 7013.4,
      "formatted_start": "01:56:51.400",
      "formatted_end": "01:56:53.400",
      "text": "شامپود یه روز در میان میده"
    },
    {
      "id": 34,
      "start": 7013.4,
      "end": 7015.4,
      "formatted_start": "01:56:53.400",
      "formatted_end": "01:56:55.400",
      "text": "شامپودش، اون درشتا روش نرشد شامپود"
    },
    {
      "id": 35,
      "start": 7015.4,
      "end": 7017.4,
      "formatted_start": "01:56:55.400",
      "formatted_end": "01:56:57.400",
      "text": "یه سرگز رو برمیخونه، اون روشتون درخون نخونه"
    },
    {
      "id": 36,
      "start": 7017.4,
      "end": 7021.4,
      "formatted_start": "01:56:57.400",
      "formatted_end": "01:57:01.400",
      "text": "اینجوری بمونه که کف تولید کنه، کفه بمونه، اینو نباشه من موضوعش بده"
    },
    {
      "id": 37,
      "start": 7021.4,
      "end": 7025.4,
      "formatted_start": "01:57:01.400",
      "formatted_end": "01:57:05.400",
      "text": "نه، کفه بمونه، پنج دقیقه کفش رو تنبی بمونه، باشه؟"
    },
    {
      "id": 38,
      "start": 7025.4,
      "end": 7027.4,
      "formatted_start": "01:57:05.400",
      "formatted_end": "01:57:07.400",
      "text": "5 دقیقه کفش بمونه"
    },
    {
      "id": 39,
      "start": 7027.4,
      "end": 7029.4,
      "formatted_start": "01:57:07.400",
      "formatted_end": "01:57:09.400",
      "text": "یعنی اینجوری بمونه که کف تولید کنه"
    },
    {
      "id": 40,
      "start": 7029.4,
      "end": 7031.4,
      "formatted_start": "01:57:09.400",
      "formatted_end": "01:57:11.400",
      "text": "کفه بمونه"
    },
    {
      "id": 41,
      "start": 7031.4,
      "end": 7033.4,
      "formatted_start": "01:57:11.400",
      "formatted_end": "01:57:13.400",
      "text": "نه کفه بمونه"
    },
    {
      "id": 42,
      "start": 7033.4,
      "end": 7035.4,
      "formatted_start": "01:57:13.400",
      "formatted_end": "01:57:15.400",
      "text": "5 دقیقه کفش رو تنه بمونه باشه"
    },
    {
      "id": 43,
      "start": 7035.4,
      "end": 7037.4,
      "formatted_start": "01:57:15.400",
      "formatted_end": "01:57:17.400",
      "text": "بعد اعتماد همه یه قصه ها هم گوش میده"
    },
    {
      "id": 44,
      "start": 7037.4,
      "end": 7039.4,
      "formatted_start": "01:57:17.400",
      "formatted_end": "01:57:19.400",
      "text": "یه قصه ها همه اینکه اعتماد هم"
    },
    {
      "id": 45,
      "start": 7039.4,
      "end": 7041.4,
      "formatted_start": "01:57:19.400",
      "formatted_end": "01:57:21.400",
      "text": "با استرسی یا کفه مونه"
    },
    {
      "id": 46,
      "start": 7041.4,
      "end": 7043.4,
      "formatted_start": "01:57:21.400",
      "formatted_end": "01:57:23.400",
      "text": "خان پارچین جان"
    },
    {
      "id": 47,
      "start": 7043.4,
      "end": 7045.4,
      "formatted_start": "01:57:23.400",
      "formatted_end": "01:57:25.400",
      "text": "بسیار"
    },
    {
      "id": 48,
      "start": 7045.4,
      "end": 7047.4,
      "formatted_start": "01:57:25.400",
      "formatted_end": "01:57:27.400",
      "text": "بسیار"
    },
    {
      "id": 49,
      "start": 7047.4,
      "end": 7049.4,
      "formatted_start": "01:57:27.400",
      "formatted_end": "01:57:29.400",
      "text": "باید برس بشکت ما که استرس کنیم"
    },
    {
      "id": 50,
      "start": 7049.4,
      "end": 7051.4,
      "formatted_start": "01:57:29.400",
      "formatted_end": "01:57:31.400",
      "text": "خانو چی؟"
    },
    {
      "id": 51,
      "start": 7051.4,
      "end": 7053.4,
      "formatted_start": "01:57:31.400",
      "formatted_end": "01:57:33.400",
      "text": "خانو چی؟"
    },
    {
      "id": 52,
      "start": 7053.4,
      "end": 7055.4,
      "formatted_start": "01:57:33.400",
      "formatted_end": "01:57:35.400",
      "text": "اه تایره"
    },
    {
      "id": 53,
      "start": 7057.4,
      "end": 7059.4,
      "formatted_start": "01:57:37.400",
      "formatted_end": "01:57:39.400",
      "text": "نه انوز خب"
    },
    {
      "id": 54,
      "start": 7061.4,
      "end": 7063.4,
      "formatted_start": "01:57:41.400",
      "formatted_end": "01:57:43.400",
      "text": "از داخل رفتر"
    },
    {
      "id": 55,
      "start": 7063.4,
      "end": 7065.4,
      "formatted_start": "01:57:43.400",
      "formatted_end": "01:57:45.400",
      "text": "رفتر ریزی درمده داری"
    },
    {
      "id": 56,
      "start": 7067.4,
      "end": 7069.4,
      "formatted_start": "01:57:47.400",
      "formatted_end": "01:57:49.400",
      "text": "این کسی از دیوانش خیلی بروش کرده"
    },
    {
      "id": 57,
      "start": 7069.4,
      "end": 7071.4,
      "formatted_start": "01:57:49.400",
      "formatted_end": "01:57:51.400",
      "text": "شبیه دختران"
    },
    {
      "id": 58,
      "start": 7071.4,
      "end": 7073.4,
      "formatted_start": "01:57:51.400",
      "formatted_end": "01:57:53.400",
      "text": "بادر شده"
    },
    {
      "id": 59,
      "start": 7073.4,
      "end": 7075.4,
      "formatted_start": "01:57:53.400",
      "formatted_end": "01:57:55.400",
      "text": "نه"
    },
    {
      "id": 60,
      "start": 7075.4,
      "end": 7077.4,
      "formatted_start": "01:57:55.400",
      "formatted_end": "01:57:57.400",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 7077.4,
      "end": 7079.4,
      "formatted_start": "01:57:57.400",
      "formatted_end": "01:57:59.400",
      "text": "همه داریمش"
    },
    {
      "id": 62,
      "start": 7079.4,
      "end": 7081.4,
      "formatted_start": "01:57:59.400",
      "formatted_end": "01:58:01.400",
      "text": "هیچ کرو"
    },
    {
      "id": 63,
      "start": 7083.4,
      "end": 7085.4,
      "formatted_start": "01:58:03.400",
      "formatted_end": "01:58:05.400",
      "text": "داروی چیزی بچه نداره؟"
    },
    {
      "id": 64,
      "start": 7085.4,
      "end": 7087.4,
      "formatted_start": "01:58:05.400",
      "formatted_end": "01:58:07.400",
      "text": "نه"
    },
    {
      "id": 65,
      "start": 7087.4,
      "end": 7091.4,
      "formatted_start": "01:58:07.400",
      "formatted_end": "01:58:11.400",
      "text": "این هم به سن بلوغ درست خانه ده که راست هفته اوم کرده"
    },
    {
      "id": 66,
      "start": 7091.4,
      "end": 7093.4,
      "formatted_start": "01:58:11.400",
      "formatted_end": "01:58:13.400",
      "text": "تو خانه ده شما هشکی سینه نداره؟"
    },
    {
      "id": 67,
      "start": 7093.4,
      "end": 7095.4,
      "formatted_start": "01:58:13.400",
      "formatted_end": "01:58:15.400",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 7095.4,
      "end": 7097.4,
      "formatted_start": "01:58:15.400",
      "formatted_end": "01:58:17.400",
      "text": "چرا؟ برنامه از آدم بوده بس اون طریق مادرش اونجوری بوده"
    },
    {
      "id": 69,
      "start": 7097.4,
      "end": 7099.4,
      "formatted_start": "01:58:17.400",
      "formatted_end": "01:58:19.400",
      "text": "اون سینه داره دیگه"
    },
    {
      "id": 70,
      "start": 7099.4,
      "end": 7101.4,
      "formatted_start": "01:58:19.400",
      "formatted_end": "01:58:21.400",
      "text": "حالا اگه بزرگ باشه دوست ماشه باشه میتونه برداره"
    },
    {
      "id": 71,
      "start": 7101.4,
      "end": 7103.4,
      "formatted_start": "01:58:21.400",
      "formatted_end": "01:58:23.400",
      "text": "خب برنامه داروی نیست که اونو مصرف کنه"
    },
    {
      "id": 72,
      "start": 7105.4,
      "end": 7107.4,
      "formatted_start": "01:58:25.400",
      "formatted_end": "01:58:27.400",
      "text": "و بعد چربی اصلا نباید بخوره"
    },
    {
      "id": 73,
      "start": 7107.4,
      "end": 7109.4,
      "formatted_start": "01:58:27.400",
      "formatted_end": "01:58:29.400",
      "text": "سوس نباید بخوره"
    },
    {
      "id": 74,
      "start": 7113.4,
      "end": 7115.4,
      "formatted_start": "01:58:33.400",
      "formatted_end": "01:58:35.400",
      "text": "اختلافات شدید و برمونی"
    },
    {
      "id": 75,
      "start": 7115.4,
      "end": 7117.4,
      "formatted_start": "01:58:35.400",
      "formatted_end": "01:58:37.400",
      "text": "توبیلار معتادش نیست"
    },
    {
      "id": 76,
      "start": 7117.4,
      "end": 7119.4,
      "formatted_start": "01:58:37.400",
      "formatted_end": "01:58:39.400",
      "text": "برای این خود میخواهد به دردش آزمانی"
    },
    {
      "id": 77,
      "start": 7119.4,
      "end": 7121.4,
      "formatted_start": "01:58:39.400",
      "formatted_end": "01:58:41.400",
      "text": "او باید دو تا کارت باید بکنیم"
    },
    {
      "id": 78,
      "start": 7133.4,
      "end": 7135.4,
      "formatted_start": "01:58:53.400",
      "formatted_end": "01:58:55.400",
      "text": "بزرگ دردی میکنه به سرم"
    },
    {
      "id": 79,
      "start": 7135.4,
      "end": 7137.4,
      "formatted_start": "01:58:55.400",
      "formatted_end": "01:58:57.400",
      "text": "فرقی نکرده"
    },
    {
      "id": 80,
      "start": 7137.4,
