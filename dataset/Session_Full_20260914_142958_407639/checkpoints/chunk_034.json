      "end": 10239.0,
      "formatted_start": "02:50:37.000",
      "formatted_end": "02:50:39.000",
      "text": "نه من اونجا پیاده آمده میکنم"
    },
    {
      "id": 10,
      "start": 10239.0,
      "end": 10241.0,
      "formatted_start": "02:50:39.000",
      "formatted_end": "02:50:41.000",
      "text": "از پله آمدی؟"
    },
    {
      "id": 11,
      "start": 10241.0,
      "end": 10247.0,
      "formatted_start": "02:50:41.000",
      "formatted_end": "02:50:47.000",
      "text": "باید کلان از جا جوی تلقی است از اونجا پیاده"
    },
    {
      "id": 12,
      "start": 10247.0,
      "end": 10249.0,
      "formatted_start": "02:50:47.000",
      "formatted_end": "02:50:49.000",
