      "start": 5691.496,
      "end": 5691.968,
      "formatted_start": "01:34:51.496",
      "formatted_end": "01:34:51.968",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 5692.964,
      "end": 5693.352,
      "formatted_start": "01:34:52.964",
      "formatted_end": "01:34:53.352",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 5693.352,
      "end": 5693.943,
      "formatted_start": "01:34:53.352",
      "formatted_end": "01:34:53.943",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 5693.943,
      "end": 5695.951,
      "formatted_start": "01:34:53.943",
      "formatted_end": "01:34:55.951",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 5694.905,
      "end": 5698.263,
      "formatted_start": "01:34:54.905",
      "formatted_end": "01:34:58.263",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 5697.166,
      "end": 5699.967,
      "formatted_start": "01:34:57.166",
      "formatted_end": "01:34:59.967",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5403.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:03.000",
      "text": "باید اکسترنال جدید برای این بخرم، درسته؟"
    },
    {
      "id": 1,
      "start": 5403.0,
      "end": 5406.0,
      "formatted_start": "01:30:03.000",
      "formatted_end": "01:30:06.000",
      "text": "نه، همینطوری خوب است."
    },
    {
      "id": 2,
      "start": 5406.0,
      "end": 5412.0,
      "formatted_start": "01:30:06.000",
      "formatted_end": "01:30:12.000",
      "text": "اصلا یک کیس دیگه دارم، اون کیس همون بیارم، اطلاعا اون جدیده."
    },
    {
      "id": 3,
      "start": 5412.0,
      "end": 5416.0,
      "formatted_start": "01:30:12.000",
      "formatted_end": "01:30:16.000",
      "text": "من نمیدونم، این بیان گیرنده داره؟"
    },
    {
      "id": 4,
      "start": 5416.0,
      "end": 5421.0,
      "formatted_start": "01:30:16.000",
      "formatted_end": "01:30:21.000",
      "text": "چیزی هست اینکه با یو اس پی، یو اس پی صورت رو زیاده دیگر جالب خوب نمیده،"
    },
    {
      "id": 5,
      "start": 5421.0,
      "end": 5427.0,
      "formatted_start": "01:30:21.000",
      "formatted_end": "01:30:27.000",
      "text": "این صورت کم، اینو اول لنه و وایلسه، بعد یو اس پی."
    },
    {
      "id": 6,
      "start": 5427.0,
      "end": 5431.56,
      "formatted_start": "01:30:27.000",
      "formatted_end": "01:30:31.560",
      "text": "خب من چیز می کنم؟ این نداره یه دونه برای خونه برای دستگیری خریدم"
    },
    {
      "id": 7,
      "start": 5431.56,
      "end": 5435.96,
      "formatted_start": "01:30:31.560",
      "formatted_end": "01:30:35.960",
      "text": "آهان، اون که مار خواهد گرچینه اونو تازه خریدم"
    },
    {
      "id": 8,
      "start": 5435.96,
      "end": 5437.56,
      "formatted_start": "01:30:35.960",
      "formatted_end": "01:30:37.560",
      "text": "چیه؟ پتر بود؟"
    },
    {
      "id": 9,
      "start": 5437.56,
      "end": 5442.76,
      "formatted_start": "01:30:37.560",
      "formatted_end": "01:30:42.760",
      "text": "نه، نه، بردم تو خونه است یه دونه مودم اکسترنال رو خریدم اون اطباعی بتره"
    },
    {
      "id": 10,
      "start": 5442.76,
      "end": 5444.36,
      "formatted_start": "01:30:42.760",
      "formatted_end": "01:30:44.360",
      "text": "مودم نازداری؟"
    },
    {
      "id": 11,
      "start": 5444.36,
      "end": 5445.96,
      "formatted_start": "01:30:44.360",
      "formatted_end": "01:30:45.960",
      "text": "آهان به مودم رفت نداره"
    },
    {
      "id": 12,
      "start": 5445.96,
      "end": 5449.4,
      "formatted_start": "01:30:45.960",
      "formatted_end": "01:30:49.400",
      "text": "خب نه این وای فایل دیگه به این رفت نداره نه؟"
    },
    {
      "id": 13,
      "start": 5449.4,
      "end": 5450.52,
      "formatted_start": "01:30:49.400",
      "formatted_end": "01:30:50.520",
      "text": "نه، این نگاه که دیدم"
    },
    {
      "id": 14,
      "start": 5450.52,
      "end": 5453.52,
      "formatted_start": "01:30:50.520",
      "formatted_end": "01:30:53.520",
      "text": "سیستم خود کامپیوتر و پی سی فرد داره"
    },
    {
      "id": 15,
      "start": 5453.52,
      "end": 5454.52,
      "formatted_start": "01:30:53.520",
      "formatted_end": "01:30:54.520",
      "text": "اینی که دارید اینجا"
    },
    {
      "id": 16,
      "start": 5454.52,
      "end": 5456.52,
      "formatted_start": "01:30:54.520",
      "formatted_end": "01:30:56.520",
      "text": "اینی که ایسش دقیق به درسته"
    },
    {
      "id": 17,
      "start": 5456.52,
      "end": 5458.52,
      "formatted_start": "01:30:56.520",
      "formatted_end": "01:30:58.520",
      "text": "اینش پوشکت اینی که اینجا دارید"
    },
    {
      "id": 18,
      "start": 5458.52,
      "end": 5460.52,
      "formatted_start": "01:30:58.520",
      "formatted_end": "01:31:00.520",
      "text": "اینها در صرف دو چار"
    },
    {
      "id": 19,
      "start": 5460.52,
      "end": 5462.52,
      "formatted_start": "01:31:00.520",
      "formatted_end": "01:31:02.520",
      "text": "اگر لکاب جدید باشه خواب"
    },
    {
      "id": 20,
      "start": 5462.52,
      "end": 5466.52,
      "formatted_start": "01:31:02.520",
      "formatted_end": "01:31:06.520",
      "text": "نگاه این هر این گوشی یا اون یا خودشان سیستم"
    },
    {
      "id": 21,
      "start": 5466.52,
      "end": 5468.52,
      "formatted_start": "01:31:06.520",
      "formatted_end": "01:31:08.520",
      "text": "اینا توی مثلا جدید که میاد"
    },
    {
      "id": 22,
      "start": 5468.52,
      "end": 5470.52,
      "formatted_start": "01:31:08.520",
      "formatted_end": "01:31:10.520",
      "text": "میاد اون قسمت وایلسشون"
    },
    {
      "id": 23,
      "start": 5470.52,
      "end": 5472.52,
      "formatted_start": "01:31:10.520",
      "formatted_end": "01:31:12.520",
      "text": "دو پنج میزنن جدید ها رو هم برون"
    },
    {
      "id": 24,
      "start": 5472.52,
      "end": 5475.52,
      "formatted_start": "01:31:12.520",
      "formatted_end": "01:31:15.520",
      "text": "اون یونیکی که شما مانداشتی فقط دو چار"
    },
    {
      "id": 25,
      "start": 5475.52,
      "end": 5477.52,
      "formatted_start": "01:31:15.520",
      "formatted_end": "01:31:17.520",
      "text": "اینجا دو چار، آخرش دو چار، بیشتر نمیدونی"
    },
    {
      "id": 26,
      "start": 5477.52,
      "end": 5479.52,
      "formatted_start": "01:31:17.520",
      "formatted_end": "01:31:19.520",
      "text": "یعنی الان یه تونه نو هم خریدم"
    },
    {
      "id": 27,
      "start": 5479.52,
      "end": 5480.52,
      "formatted_start": "01:31:19.520",
      "formatted_end": "01:31:20.520",
      "text": "شاید اون جدید باشه"
    },
    {
      "id": 28,
      "start": 5480.52,
      "end": 5481.52,
      "formatted_start": "01:31:20.520",
      "formatted_end": "01:31:21.520",
      "text": "یه تونه نو خریدم"
    },
    {
      "id": 29,
      "start": 5481.52,
      "end": 5482.52,
      "formatted_start": "01:31:21.520",
      "formatted_end": "01:31:22.520",
      "text": "اگر خرید باشه شاید"
    },
    {
      "id": 30,
      "start": 5482.52,
      "end": 5484.52,
      "formatted_start": "01:31:22.520",
      "formatted_end": "01:31:24.520",
      "text": "اگر اصلا این روز لپتاپ رو نه بردم"
    },
    {
      "id": 31,
      "start": 5484.52,
      "end": 5485.52,
      "formatted_start": "01:31:24.520",
      "formatted_end": "01:31:25.520",
      "text": "اون رو دور بینم"
    },
    {
      "id": 32,
      "start": 5485.52,
      "end": 5490.52,
      "formatted_start": "01:31:25.520",
      "formatted_end": "01:31:30.520",
      "text": "اگر لپتاپ باشه مثلا اگر خودتون لپتاپ باشه، لپتاپ مثلا به پنجم وزد شد"
    },
    {
      "id": 33,
      "start": 5490.52,
      "end": 5492.52,
      "formatted_start": "01:31:30.520",
      "formatted_end": "01:31:32.520",
      "text": "الان گوشتون وزد شد؟"
    },
    {
      "id": 34,
      "start": 5492.52,
      "end": 5493.52,
      "formatted_start": "01:31:32.520",
      "formatted_end": "01:31:33.520",
      "text": "گوشتون رو نکردم"
    },
    {
      "id": 35,
      "start": 5493.52,
      "end": 5497.52,
      "formatted_start": "01:31:33.520",
      "formatted_end": "01:31:37.520",
      "text": "بعد از این میتونم حاط اثبات کنم اگه حاط اثبات کنم سرعت قایم میاد نگه"
    },
    {
      "id": 36,
      "start": 5497.52,
      "end": 5499.52,
      "formatted_start": "01:31:37.520",
      "formatted_end": "01:31:39.520",
      "text": "این قایم میاد ولی خوابه"
    },
    {
      "id": 37,
      "start": 5499.52,
      "end": 5500.52,
      "formatted_start": "01:31:39.520",
      "formatted_end": "01:31:40.520",
      "text": "بعد این اپلیکیشن های..."
    },
    {
      "id": 38,
      "start": 5500.52,
      "end": 5502.52,
      "formatted_start": "01:31:40.520",
      "formatted_end": "01:31:42.520",
      "text": "نه اگه میتونی هستن مستقیل به دوی همین رو بشن"
    },
    {
      "id": 39,
      "start": 5502.52,
      "end": 5503.52,
      "formatted_start": "01:31:42.520",
      "formatted_end": "01:31:43.520",
      "text": "این با فایل بشن"
    },
    {
      "id": 40,
      "start": 5503.52,
      "end": 5505.52,
      "formatted_start": "01:31:43.520",
      "formatted_end": "01:31:45.520",
      "text": "اولا شما مثلا این فایل باشه الان چیز که خیلی راضی بود"
    },
    {
      "id": 41,
      "start": 5505.52,
      "end": 5507.52,
      "formatted_start": "01:31:45.520",
      "formatted_end": "01:31:47.520",
      "text": "آره اون گفت خیلی سرعتش بود"
    },
    {
      "id": 42,
      "start": 5507.52,
      "end": 5508.52,
      "formatted_start": "01:31:47.520",
      "formatted_end": "01:31:48.520",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 5508.52,
      "end": 5511.52,
      "formatted_start": "01:31:48.520",
      "formatted_end": "01:31:51.520",
      "text": "بعد شما بعد الان داخل رسته ها هم داره"
    },
    {
      "id": 44,
      "start": 5511.52,
      "end": 5512.52,
      "formatted_start": "01:31:51.520",
      "formatted_end": "01:31:52.520",
      "text": "اجا"
    },
    {
      "id": 45,
      "start": 5512.52,
      "end": 5514.52,
      "formatted_start": "01:31:52.520",
      "formatted_end": "01:31:54.520",
      "text": "مرز بانی آخر رسته هایی"
    },
    {
      "id": 46,
      "start": 5514.52,
      "end": 5517.28,
      "formatted_start": "01:31:54.520",
      "formatted_end": "01:31:57.280",
      "text": "نه اونجا از فیبرونی نه اونجا فقط چیز میده"
    },
    {
      "id": 47,
      "start": 5517.28,
      "end": 5517.78,
      "formatted_start": "01:31:57.280",
      "formatted_end": "01:31:57.780",
      "text": "چی؟"
    },
    {
      "id": 48,
      "start": 5517.78,
      "end": 5520.28,
      "formatted_start": "01:31:57.780",
      "formatted_end": "01:32:00.280",
      "text": "اونجا فقط این انترنت دقیقا یه سکت"
    },
    {
      "id": 49,
      "start": 5520.28,
      "end": 5523.82,
      "formatted_start": "01:32:00.280",
      "formatted_end": "01:32:03.820",
      "text": "اون که اصلا داشتم دیگه شاهاش نکردیم مدرن مال هم بود اصلا"
    },
    {
      "id": 50,
      "start": 5523.82,
      "end": 5524.98,
      "formatted_start": "01:32:03.820",
      "formatted_end": "01:32:04.980",
      "text": "اون که چی قد آبود؟"
    },
    {
      "id": 51,
      "start": 5524.98,
      "end": 5528.62,
      "formatted_start": "01:32:04.980",
      "formatted_end": "01:32:08.620",
      "text": "نه فیبر فعیلن تنها جایی که توی این رستاکیتن از را ترقه"
    },
    {
      "id": 52,
      "start": 5528.62,
      "end": 5530.62,
      "formatted_start": "01:32:08.620",
      "formatted_end": "01:32:10.620",
      "text": "از طرف اون کافز روشون"
    },
    {
      "id": 53,
      "start": 5530.62,
      "end": 5532.12,
      "formatted_start": "01:32:10.620",
      "formatted_end": "01:32:12.120",
      "text": "اصلا از ایک بشه دیگه باشه درست بشه"
    },
    {
      "id": 54,
      "start": 5532.12,
      "end": 5534.12,
      "formatted_start": "01:32:12.120",
      "formatted_end": "01:32:14.120",
      "text": "چون از اون رستاک میخوام که افزا بگیر کنم"
    },
    {
      "id": 55,
      "start": 5534.12,
      "end": 5537.32,
      "formatted_start": "01:32:14.120",
      "formatted_end": "01:32:17.320",
      "text": "اونجا برای همین گفتم که این موضوع می آید"
    },
    {
      "id": 56,
      "start": 5537.32,
      "end": 5540.44,
      "formatted_start": "01:32:17.320",
      "formatted_end": "01:32:20.440",
      "text": "اونجا مگر اینکه فیلد بکشن اگر کشیدن"
    },
    {
      "id": 57,
      "start": 5540.44,
      "end": 5545.4,
      "formatted_start": "01:32:20.440",
      "formatted_end": "01:32:25.400",
      "text": "مثلا اونوقت که کشیدن اونگو مثلا میگن آرکتونی خودشون میگن میگن انجام"
    },
    {
      "id": 58,
      "start": 5545.4,
      "end": 5548.64,
      "formatted_start": "01:32:25.400",
      "formatted_end": "01:32:28.640",
      "text": "الان پسپورتش هم همون چیز رو جایی نوشتیدی که خود"
    },
    {
      "id": 59,
      "start": 5548.64,
      "end": 5550.52,
      "formatted_start": "01:32:28.640",
      "formatted_end": "01:32:30.520",
      "text": "نه از اون تو باشیم سیده دیگه"
    },
    {
      "id": 60,
      "start": 5550.52,
      "end": 5554.6,
      "formatted_start": "01:32:30.520",
      "formatted_end": "01:32:34.600",
      "text": "میبایی پنج صورتش بیشتره اگر اینگو بساوات هم باسیب استفاده بیشتره"
    },
    {
      "id": 61,
      "start": 5554.6,
      "end": 5557.3,
      "formatted_start": "01:32:34.600",
      "formatted_end": "01:32:37.300",
      "text": "همدرش هم چی استفاده کنید؟"
    },
    {
      "id": 62,
      "start": 5557.3,
      "end": 5560.02,
      "formatted_start": "01:32:37.300",
      "formatted_end": "01:32:40.020",
      "text": "نه ببین چون میگم هم هم هم که دیگه"
    },
    {
      "id": 63,
      "start": 5560.02,
      "end": 5561.06,
      "formatted_start": "01:32:40.020",
      "formatted_end": "01:32:41.060",
      "text": "سنیات ها کن ده"
    },
    {
      "id": 64,
      "start": 5561.06,
      "end": 5563.18,
      "formatted_start": "01:32:41.060",
      "formatted_end": "01:32:43.180",
      "text": "سنه پس دارن دیگه فیلمی کن کن کن"
    },
    {
      "id": 65,
      "start": 5563.18,
      "end": 5564.58,
      "formatted_start": "01:32:43.180",
      "formatted_end": "01:32:44.580",
      "text": "آره تایید این چیزی هست"
    },
    {
      "id": 66,
      "start": 5564.58,
      "end": 5566.82,
      "formatted_start": "01:32:44.580",
      "formatted_end": "01:32:46.820",
      "text": "الان آقا وردین اگر دوربینات ها"
    },
    {
      "id": 67,
      "start": 5566.82,
      "end": 5568.14,
      "formatted_start": "01:32:46.820",
      "formatted_end": "01:32:48.140",
      "text": "دوربینات که اینست که؟"
    },
    {
      "id": 68,
      "start": 5568.14,
      "end": 5570.14,
      "formatted_start": "01:32:48.140",
      "formatted_end": "01:32:50.140",
      "text": "دوربینات ها یه سال بود"
    },
    {
      "id": 69,
      "start": 5570.14,
      "end": 5572.7,
      "formatted_start": "01:32:50.140",
      "formatted_end": "01:32:52.700",
      "text": "پنج سال هست دیگه ندید تازه که"
    },
    {
      "id": 70,
      "start": 5572.7,
      "end": 5574.7,
      "formatted_start": "01:32:52.700",
      "formatted_end": "01:32:54.700",
      "text": "اردن یه ساله که شما هدف اپدیت کردید"
    },
    {
      "id": 71,
      "start": 5574.7,
      "end": 5575.7,
      "formatted_start": "01:32:54.700",
      "formatted_end": "01:32:55.700",
      "text": "خب نه اگر"
    },
    {
      "id": 72,
      "start": 5575.7,
      "end": 5578.58,
      "formatted_start": "01:32:55.700",
      "formatted_end": "01:32:58.580",
      "text": "خودش وصل شد که وصل میشه خب"
    },
    {
      "id": 73,
      "start": 5578.58,
      "end": 5581.58,
      "formatted_start": "01:32:58.580",
      "formatted_end": "01:33:01.580",
      "text": "اگر وصل نشد، باید بیاد آی پی بدید"
    },
    {
      "id": 74,
      "start": 5581.58,
      "end": 5586.58,
      "formatted_start": "01:33:01.580",
      "formatted_end": "01:33:06.580",
      "text": "اگر نیاز به آی پی شد، این شماله مجازیتون خوب"
    },
    {
      "id": 75,
      "start": 5586.58,
      "end": 5588.58,
      "formatted_start": "01:33:06.580",
      "formatted_end": "01:33:08.580",
      "text": "من اینو برای شما ختم بگیشم"
    },
    {
      "id": 76,
      "start": 5588.58,
      "end": 5591.58,
      "formatted_start": "01:33:08.580",
      "formatted_end": "01:33:11.580",
      "text": "اینو ختم بگیشتید، شمال مجازیتون میده"
    },
    {
      "id": 77,
      "start": 5591.58,
      "end": 5596.58,
      "formatted_start": "01:33:11.580",
      "formatted_end": "01:33:16.580",
      "text": "این شمال مجازیتون ما اینه، یعنی از این همجا کل ملی تنها میدید، نگهنده"
    },
    {
      "id": 78,
      "start": 5596.58,
      "end": 5598.58,
      "formatted_start": "01:33:16.580",
      "formatted_end": "01:33:18.580",
      "text": "تمام"
    },
    {
      "id": 79,
      "start": 5598.58,
      "end": 5604.58,
      "formatted_start": "01:33:18.580",
      "formatted_end": "01:33:24.580",
      "text": "اینو من بگیرش میشم که برای از این زمانی که از دسته افتار رو درست کنم"
    },
    {
      "id": 80,
      "start": 5604.58,
      "end": 5608.58,
      "formatted_start": "01:33:24.580",
      "formatted_end": "01:33:28.580",
      "text": "من سری قدر نمو دهیم پیش شما خب وقتا رو بزینم دارم"
    },
    {
      "id": 81,
      "start": 5608.58,
      "end": 5612.58,
      "formatted_start": "01:33:28.580",
      "formatted_end": "01:33:32.580",
      "text": "یه برام آزمایش نداشتیم منم بخوای شالکالی هم بود اصلا نرفتم"
    },
    {
      "id": 82,
      "start": 5612.58,
      "end": 5614.58,
      "formatted_start": "01:33:32.580",
      "formatted_end": "01:33:34.580",
      "text": "نه خب بگیم براتون نمیتونم کار داریم"
    },
    {
      "id": 83,
      "start": 5614.58,
      "end": 5618.58,
      "formatted_start": "01:33:34.580",
      "formatted_end": "01:33:38.580",
      "text": "یه چیز چکم هم خب جاییم بخوای براتون باروی توم"
    },
    {
      "id": 84,
      "start": 5618.58,
      "end": 5621.58,
      "formatted_start": "01:33:38.580",
      "formatted_end": "01:33:41.580",
      "text": "احساس کنم خودتی داره یه توم و این هم کلی"
    },
    {
      "id": 85,
      "start": 5621.58,
      "end": 5622.58,
      "formatted_start": "01:33:41.580",
      "formatted_end": "01:33:42.580",
      "text": "برام چربیه"
    },
    {
      "id": 86,
      "start": 5622.58,
      "end": 5625.58,
      "formatted_start": "01:33:42.580",
      "formatted_end": "01:33:45.580",
      "text": "چربیه آره و بعد خودتی میتونم حالا بازی نگاه کنیم ایشان"
    },
    {
      "id": 87,
      "start": 5625.58,
      "end": 5627.58,
      "formatted_start": "01:33:45.580",
      "formatted_end": "01:33:47.580",
      "text": "بعد تیویل هم داشتن و اونم برمیشه"
    },
    {
      "id": 88,
      "start": 5627.58,
      "end": 5628.58,
      "formatted_start": "01:33:47.580",
      "formatted_end": "01:33:48.580",
      "text": "این چی بود؟ ترمین؟"
    },
    {
      "id": 89,
      "start": 5628.58,
      "end": 5629.08,
      "formatted_start": "01:33:48.580",
      "formatted_end": "01:33:49.080",
      "text": "ها؟"
    },
    {
      "id": 90,
      "start": 5629.08,
      "end": 5630.08,
      "formatted_start": "01:33:49.080",
      "formatted_end": "01:33:50.080",
      "text": "این برمیشه ترمین هست؟"
    },
    {
      "id": 91,
      "start": 5630.08,
      "end": 5630.58,
      "formatted_start": "01:33:50.080",
      "formatted_end": "01:33:50.580",
      "text": "آره ترمین هست"
    },
    {
      "id": 92,
      "start": 5630.58,
      "end": 5631.58,
      "formatted_start": "01:33:50.580",
      "formatted_end": "01:33:51.580",
      "text": "خدا مدت چی بگم؟"
    },
    {
      "id": 93,
      "start": 5631.58,
      "end": 5632.58,
      "formatted_start": "01:33:51.580",
      "formatted_end": "01:33:52.580",
      "text": "چه سایه 24"
    },
    {
      "id": 94,
      "start": 5632.58,
      "end": 5633.08,
      "formatted_start": "01:33:52.580",
      "formatted_end": "01:33:53.080",
      "text": "نه؟"
    },
    {
      "id": 95,
      "start": 5633.08,
      "end": 5634.08,
      "formatted_start": "01:33:53.080",
      "formatted_end": "01:33:54.080",
      "text": "970"
    },
    {
      "id": 96,
      "start": 5634.08,
      "end": 5635.58,
      "formatted_start": "01:33:54.080",
      "formatted_end": "01:33:55.580",
      "text": "62.50 هم بود"
    },
    {
      "id": 97,
      "start": 5635.58,
      "end": 5638.58,
      "formatted_start": "01:33:55.580",
      "formatted_end": "01:33:58.580",
      "text": "این ایران خاصی میتونی به چیزم وست کنی دار"
    },
    {
      "id": 98,
      "start": 5638.58,
      "end": 5639.58,
      "formatted_start": "01:33:58.580",
      "formatted_end": "01:33:59.580",
      "text": "به همین دو"
    },
    {
      "id": 99,
      "start": 5639.58,
      "end": 5640.58,
      "formatted_start": "01:33:59.580",
      "formatted_end": "01:34:00.580",
      "text": "قرش"
    },
    {
      "id": 100,
      "start": 5640.58,
      "end": 5641.58,
      "formatted_start": "01:34:00.580",
      "formatted_end": "01:34:01.580",
      "text": "باید"
    },
    {
      "id": 101,
      "start": 5641.58,
      "end": 5643.58,
      "formatted_start": "01:34:01.580",
      "formatted_end": "01:34:03.580",
      "text": "به همین دو و چهار ما وست کنی؟"
    },
    {
      "id": 102,
      "start": 5643.58,
      "end": 5645.58,
      "formatted_start": "01:34:03.580",
      "formatted_end": "01:34:05.580",
      "text": "باید باید باز کنم"
    },
    {
      "id": 103,
      "start": 5647.58,
      "end": 5649.58,
      "formatted_start": "01:34:07.580",
      "formatted_end": "01:34:09.580",
      "text": "الان همین دو و چهار که کشی؟"
    },
    {
      "id": 104,
      "start": 5649.58,
      "end": 5651.58,
      "formatted_start": "01:34:09.580",
      "formatted_end": "01:34:11.580",
      "text": "اون دور آبازار فس فارده داره"
    },
    {
      "id": 105,
      "start": 5651.58,
      "end": 5653.58,
      "formatted_start": "01:34:11.580",
      "formatted_end": "01:34:13.580",
      "text": "نه اونجا نزدین این فس فارده دیگه"
    },
    {
      "id": 106,
      "start": 5653.58,
      "end": 5655.58,
      "formatted_start": "01:34:13.580",
      "formatted_end": "01:34:15.580",
      "text": "بزرگ بزرگ بزرگ"
    },
    {
      "id": 107,
      "start": 5655.58,
      "end": 5657.58,
      "formatted_start": "01:34:15.580",
      "formatted_end": "01:34:17.580",
      "text": "نه بزرگ نکنه بزرگ نمیزنم از اینجا کپی میکنم"
    },
    {
      "id": 108,
      "start": 5657.58,
      "end": 5659.58,
      "formatted_start": "01:34:17.580",
      "formatted_end": "01:34:19.580",
      "text": "برد"
    },
    {
      "id": 109,
      "start": 5659.58,
      "end": 5661.58,
      "formatted_start": "01:34:19.580",
      "formatted_end": "01:34:21.580",
      "text": "چون"
    },
    {
      "id": 110,
      "start": 5661.58,
      "end": 5663.58,
      "formatted_start": "01:34:21.580",
      "formatted_end": "01:34:23.580",
      "text": "اون داره خاطره که داریم"
    },
    {
      "id": 111,
      "start": 5663.58,
      "end": 5665.58,
      "formatted_start": "01:34:23.580",
      "formatted_end": "01:34:25.580",
      "text": "آه اونجا هم یه تیک"
    },
    {
      "id": 112,
      "start": 5665.58,
      "end": 5667.58,
      "formatted_start": "01:34:25.580",
      "formatted_end": "01:34:27.580",
      "text": "بردش دار اگه بزنین شما"
    },
    {
      "id": 113,
      "start": 5667.58,
      "end": 5669.58,
      "formatted_start": "01:34:27.580",
      "formatted_end": "01:34:29.580",
      "text": "هم"
    },
    {
      "id": 114,
      "start": 5673.58,
      "end": 5675.58,
      "formatted_start": "01:34:33.580",
      "formatted_end": "01:34:35.580",
      "text": "بزرگ همون"
    },
    {
      "id": 115,
      "start": 5675.58,
      "end": 5677.58,
      "formatted_start": "01:34:35.580",
      "formatted_end": "01:34:37.580",
      "text": "ستره هست"
    },
    {
      "id": 116,
      "start": 5677.58,
      "end": 5681.58,
      "formatted_start": "01:34:37.580",
      "formatted_end": "01:34:41.580",
      "text": "برای اون روبرو چیزا ستاره این همسایه روبرویی تا نداره"
    },
    {
      "id": 117,
      "start": 5681.58,
      "end": 5683.58,
      "formatted_start": "01:34:41.580",
      "formatted_end": "01:34:43.580",
      "text": "برکانه بزن"
    },
    {
      "id": 118,
      "start": 5691.58,
      "end": 5693.58,
      "formatted_start": "01:34:51.580",
      "formatted_end": "01:34:53.580",
      "text": "خوب بچه"
    },
    {
      "id": 119,
      "start": 5693.58,
      "end": 5695.58,
      "formatted_start": "01:34:53.580",
      "formatted_end": "01:34:55.580",
      "text": "باش مرسی خوبی"
    },
    {
      "id": 120,
      "start": 5695.58,
      "end": 5697.58,
      "formatted_start": "01:34:55.580",
      "formatted_end": "01:34:57.580",
      "text": "خوبی خوبی"
    },
    {
      "id": 121,
      "start": 5697.58,
      "end": 5699.58,
      "formatted_start": "01:34:57.580",
      "formatted_end": "01:34:59.580",
      "text": "بزن بزن"
    }
  ],
  "status": "completed"
}