  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13830.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:30.000",
      "text": "مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدتر بیشتر و مدت"
    },
    {
      "id": 1,
      "start": 13830.0,
      "end": 13850.0,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 13850.0,
      "end": 13870.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:51:10.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 13870.0,
      "end": 13900.0,
      "formatted_start": "03:51:10.000",
      "formatted_end": "03:51:40.000",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم ک"
    },
    {
      "id": 4,
      "start": 13900.0,
      "end": 13902.0,
      "formatted_start": "03:51:40.000",
      "formatted_end": "03:51:42.000",
      "text": "از اینجا باید برنامه بودیم"
    },
    {
      "id": 5,
      "start": 13902.0,
      "end": 13904.0,
      "formatted_start": "03:51:42.000",
      "formatted_end": "03:51:44.000",
      "text": "تنشنه برای بودانده بود"
    },
    {
      "id": 6,
      "start": 13904.0,
      "end": 13906.0,
      "formatted_start": "03:51:44.000",
      "formatted_end": "03:51:46.000",
      "text": "خب الان چی کار شده؟"
    },
    {
      "id": 7,
      "start": 13906.0,
      "end": 13908.0,
      "formatted_start": "03:51:46.000",
      "formatted_end": "03:51:48.000",
      "text": "الان که خداشت بود ناشته شدی"
    },
    {
      "id": 8,
      "start": 13908.0,
      "end": 13910.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:50.000",
      "text": "روز که ارزم صبح 41"
    },
    {
      "id": 9,
      "start": 13910.0,
      "end": 13912.0,
      "formatted_start": "03:51:50.000",
      "formatted_end": "03:51:52.000",
      "text": "اولا که چند بوده؟"
    },
    {
      "id": 10,
      "start": 13912.0,
      "end": 13914.0,
      "formatted_start": "03:51:52.000",
      "formatted_end": "03:51:54.000",
      "text": "اولا چهار صبح بود"
    },
    {
      "id": 11,
      "start": 13914.0,
      "end": 13916.0,
      "formatted_start": "03:51:54.000",
      "formatted_end": "03:51:56.000",
      "text": "خوب"
    },
    {
      "id": 12,
      "start": 13916.0,
      "end": 13918.0,
      "formatted_start": "03:51:56.000",
      "formatted_end": "03:51:58.000",
      "text": "پس الان بعد صبح نه چند؟"
    },
    {
      "id": 13,
      "start": 13918.0,
      "end": 13920.0,
      "formatted_start": "03:51:58.000",
      "formatted_end": "03:52:00.000",
      "text": "بعد صبح نه دیگه نگرفتم"
    },
    {
      "id": 14,
      "start": 13920.0,
      "end": 13922.0,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:02.000",
      "text": "دست کنید"
    },
    {
      "id": 15,
      "start": 13922.0,
      "end": 13924.0,
      "formatted_start": "03:52:02.000",
      "formatted_end": "03:52:04.000",
      "text": "چرا؟"
    },
    {
      "id": 16,
      "start": 13924.0,
      "end": 13926.0,
      "formatted_start": "03:52:04.000",
      "formatted_end": "03:52:06.000",
      "text": "چه آتن برگیر؟"
    },
    {
      "id": 17,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "برنامه ندادم برنامه"
    },
    {
      "id": 18,
      "start": 13928.0,
      "end": 13930.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:10.000",
      "text": "که یه آورده بودی؟"
    },
    {
      "id": 19,
      "start": 13930.0,
      "end": 13932.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:12.000",
      "text": "فکر کنم یک ماه برده ای داده بشه"
    },
    {
      "id": 20,
      "start": 13932.0,
      "end": 13934.0,
      "formatted_start": "03:52:12.000",
      "formatted_end": "03:52:14.000",
      "text": "آورده چی گفتن؟"
    },
    {
      "id": 21,
      "start": 13934.0,
      "end": 13938.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:18.000",
      "text": "آورده هم و دوباره باز دارو رو دادیم"
    },
    {
      "id": 22,
      "start": 13938.0,
      "end": 13942.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:22.000",
      "text": "گفتن دوباره باز دارو شما نسخه کردیم"
    },
    {
      "id": 23,
      "start": 13942.0,
      "end": 13944.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:24.000",
      "text": "پس یعنی خوب بوده؟"
    },
    {
      "id": 24,
      "start": 13944.0,
      "end": 13946.0,
      "formatted_start": "03:52:24.000",
      "formatted_end": "03:52:26.000",
      "text": "بله"
    },
    {
      "id": 25,
      "start": 13946.0,
      "end": 13948.0,
      "formatted_start": "03:52:26.000",
      "formatted_end": "03:52:28.000",
      "text": "چون من درسته اینو بگم نمیشه"
    },
    {
      "id": 26,
      "start": 13948.0,
      "end": 13950.0,
      "formatted_start": "03:52:28.000",
      "formatted_end": "03:52:30.000",
      "text": "در روش این نبوده"
    },
    {
      "id": 27,
      "start": 13950.0,
      "end": 13954.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:34.000",
      "text": "جمعه روز غنجات و نعیز دیابتی میبینن خواهد مون"
    },
    {
      "id": 28,
      "start": 13954.0,
      "end": 13956.0,
      "formatted_start": "03:52:34.000",
      "formatted_end": "03:52:36.000",
      "text": "هم هم مثل هم همی"
    },
    {
      "id": 29,
      "start": 13956.0,
      "end": 13961.0,
      "formatted_start": "03:52:36.000",
      "formatted_end": "03:52:41.000",
      "text": "بعد اینجا هم که خدا شکر کرده از اونها آراش کرده کنم بیستا فامیله"
    },
    {
      "id": 30,
      "start": 13961.0,
      "end": 13964.0,
      "formatted_start": "03:52:41.000",
      "formatted_end": "03:52:44.000",
      "text": "همه جیب فامیله تکلوری دار میسنن"
    },
    {
      "id": 31,
      "start": 13964.0,
      "end": 13967.0,
      "formatted_start": "03:52:44.000",
      "formatted_end": "03:52:47.000",
      "text": "همه محمودی حسینی در چند دوست داره"
    },
    {
      "id": 32,
      "start": 13967.0,
      "end": 13970.0,
      "formatted_start": "03:52:47.000",
      "formatted_end": "03:52:50.000",
      "text": "یعنی دیگه بعد مثلا میاد مثلا این منشه ما خوب معلی هم میشن"
    },
    {
      "id": 33,
      "start": 13970.0,
      "end": 13974.0,
      "formatted_start": "03:52:50.000",
      "formatted_end": "03:52:54.000",
      "text": "اون خالم چیست دیگه؟ حسینی، حسینی"
    },
    {
      "id": 34,
      "start": 13974.0,
      "end": 13978.0,
      "formatted_start": "03:52:54.000",
      "formatted_end": "03:52:58.000",
      "text": "از صبح بگیرم همین الان اینو صبح چند نفر حسینی هستیم"
    },
    {
      "id": 35,
      "start": 13978.0,
      "end": 13981.0,
      "formatted_start": "03:52:58.000",
      "formatted_end": "03:53:01.000",
      "text": "خب یه ده پنج هزار مامان میخورده"
    },
    {
      "id": 36,
      "start": 13981.0,
      "end": 13985.0,
      "formatted_start": "03:53:01.000",
      "formatted_end": "03:53:05.000",
      "text": "بعد قطور داشته، زیلت میخورده"
    },
    {
      "id": 37,
      "start": 13985.0,
      "end": 13988.0,
      "formatted_start": "03:53:05.000",
      "formatted_end": "03:53:08.000",
      "text": "از اینجورد آسپریم اگر این کلاسید هشتا"
    },
    {
      "id": 38,
      "start": 13988.0,
      "end": 13991.0,
      "formatted_start": "03:53:08.000",
      "formatted_end": "03:53:11.000",
      "text": "خب بعد"
    },
    {
      "id": 39,
      "start": 14000.0,
      "end": 14003.0,
      "formatted_start": "03:53:20.000",
      "formatted_end": "03:53:23.000",
      "text": "همون رو تبدیل کرده ماشید"
    },
    {
      "id": 40,
      "start": 14003.0,
      "end": 14005.0,
      "formatted_start": "03:53:23.000",
      "formatted_end": "03:53:25.000",
      "text": "حالا بعدی بفرستیمشون آزمایش"
    },
    {
      "id": 41,
      "start": 14005.0,
      "end": 14007.0,
      "formatted_start": "03:53:25.000",
      "formatted_end": "03:53:27.000",
      "text": "حالا تمد دارم از این پر آزمایشم برم"
    },
    {
      "id": 42,
      "start": 14007.0,
      "end": 14009.0,
      "formatted_start": "03:53:27.000",
      "formatted_end": "03:53:29.000",
      "text": "خانم دکتر ببخشی"
    },
    {
      "id": 43,
      "start": 14009.0,
      "end": 14010.0,
      "formatted_start": "03:53:29.000",
      "formatted_end": "03:53:30.000",
      "text": "چا؟"
    },
    {
      "id": 44,
      "start": 14010.0,
      "end": 14012.0,
      "formatted_start": "03:53:30.000",
      "formatted_end": "03:53:32.000",
      "text": "اونو ما دانم قرن من ایچی"
    },
    {
      "id": 45,
      "start": 14012.0,
      "end": 14014.0,
      "formatted_start": "03:53:32.000",
      "formatted_end": "03:53:34.000",
      "text": "این شکرمون من خیلی عذیب میکنم"
    },
    {
      "id": 46,
      "start": 14014.0,
      "end": 14017.0,
      "formatted_start": "03:53:34.000",
      "formatted_end": "03:53:37.000",
      "text": "چی کار میشه؟ درد پیچ میشه؟"
    },
    {
      "id": 47,
      "start": 14017.0,
      "end": 14023.1,
      "formatted_start": "03:53:37.000",
      "formatted_end": "03:53:43.100",
      "text": "درد پیچ هم نیسته، فقط توی شکرمان به نظر من روده ها من میگه پیچ خوردم"
    },
    {
      "id": 48,
      "start": 14023.1,
      "end": 14026.76,
      "formatted_start": "03:53:43.100",
      "formatted_end": "03:53:46.760",
      "text": "همیشه همه گریگری داره اینجا هم درده"
    },
    {
      "id": 49,
      "start": 14026.76,
      "end": 14029.0,
      "formatted_start": "03:53:46.760",
      "formatted_end": "03:53:49.000",
      "text": "الان به تو میگم چیه؟"
    },
    {
      "id": 50,
      "start": 14029.0,
      "end": 14032.0,
      "formatted_start": "03:53:49.000",
      "formatted_end": "03:53:52.000",
      "text": "دیابیتی ها خب؟ چون قندشون والاست"
    },
    {
      "id": 51,
      "start": 14032.66,
      "end": 14036.6,
      "formatted_start": "03:53:52.660",
      "formatted_end": "03:53:56.600",
      "text": "توی روده ها این باکتریه که توی روده همه آدم ها هستن"
    },
    {
      "id": 52,
      "start": 14036.6,
      "end": 14041.3,
      "formatted_start": "03:53:56.600",
      "formatted_end": "03:54:01.300",
      "text": "شما قند داروه که میخوره قند رو میریزه بیرون توی روده ها خب؟"
    },
    {
      "id": 53,
      "start": 14041.3,
      "end": 14045.78,
      "formatted_start": "03:54:01.300",
      "formatted_end": "03:54:05.780",
      "text": "اون میکروبا خب دیگه اون باکتریا خدا خدا جنن پر از غذاست اونجا"
    },
    {
      "id": 54,
      "start": 14045.78,
      "end": 14048.18,
      "formatted_start": "03:54:05.780",
      "formatted_end": "03:54:08.180",
      "text": "رشد بیش از حد میکنن"
    },
    {
      "id": 55,
      "start": 14048.18,
      "end": 14052.82,
      "formatted_start": "03:54:08.180",
      "formatted_end": "03:54:12.820",
      "text": "چون رشد بیش از حد میکنن؟ شما یه حالت احساس نراحتی"
    },
    {
      "id": 56,
      "start": 14052.82,
      "end": 14056.18,
      "formatted_start": "03:54:12.820",
      "formatted_end": "03:54:16.180",
      "text": "یه احساسی که برگون میده یکای وقت رو باد زیاد"
    },
    {
      "id": 57,
      "start": 14056.18,
      "end": 14061.86,
      "formatted_start": "03:54:16.180",
      "formatted_end": "03:54:21.860",
      "text": "وقت رو حتی که مطابق مطابق بردن بشه، فرد بشه، تمام اینو بخاطر آنه باشه"
    },
    {
      "id": 58,
      "start": 14061.86,
      "end": 14063.86,
      "formatted_start": "03:54:21.860",
      "formatted_end": "03:54:23.860",
      "text": "چون چون میده شما پر غنده"
    },
    {
      "id": 59,
      "start": 14063.86,
      "end": 14069.86,
      "formatted_start": "03:54:23.860",
      "formatted_end": "03:54:29.860",
      "text": "اونجای شکم و اونجایی که دست میکنی قشنگ پیچ کرده"
    },
    {
      "id": 60,
      "start": 14069.86,
      "end": 14071.86,
      "formatted_start": "03:54:29.860",
      "formatted_end": "03:54:31.860",
      "text": "خدا موارد"
    },
    {
      "id": 61,
      "start": 14071.86,
      "end": 14075.86,
      "formatted_start": "03:54:31.860",
      "formatted_end": "03:54:35.860",
      "text": "آره ولی اون پیچی نیست که میخواد باشه"
    },
    {
      "id": 62,
      "start": 14075.86,
      "end": 14078.86,
      "formatted_start": "03:54:35.860",
      "formatted_end": "03:54:38.860",
      "text": "کامیدکتور دکتور که جنرالیه"
    },
    {
      "id": 63,
      "start": 14078.86,
      "end": 14082.86,
      "formatted_start": "03:54:38.860",
      "formatted_end": "03:54:42.860",
      "text": "منشوشون کنید و خودشون دوباره تماس بکنید"
    },
    {
      "id": 64,
      "start": 14082.86,
      "end": 14085.86,
      "formatted_start": "03:54:42.860",
      "formatted_end": "03:54:45.860",
      "text": "چیزی نداره"
    },
    {
      "id": 65,
      "start": 14085.86,
      "end": 14087.86,
      "formatted_start": "03:54:45.860",
      "formatted_end": "03:54:47.860",
      "text": "نه نه نه نه"
    },
    {
      "id": 66,
      "start": 14087.86,
      "end": 14090.86,
      "formatted_start": "03:54:47.860",
      "formatted_end": "03:54:50.860",
      "text": "خودتونو تا که خواهشونید"
    },
    {
      "id": 67,
      "start": 14090.86,
      "end": 14093.68,
      "formatted_start": "03:54:50.860",
      "formatted_end": "03:54:53.680",
      "text": "اینو نتابش بوده"
    },
    {
      "id": 68,
      "start": 14093.68,
      "end": 14095.38,
      "formatted_start": "03:54:53.680",
      "formatted_end": "03:54:55.380",
      "text": "دوست کنیم باید"
    }
  ],
  "status": "completed"
}