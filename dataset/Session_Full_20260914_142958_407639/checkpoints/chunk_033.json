      "start": 10182.923,
      "end": 10183.683,
      "formatted_start": "02:49:42.923",
      "formatted_end": "02:49:43.683",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 10184.813,
      "end": 10186.332,
      "formatted_start": "02:49:44.813",
      "formatted_end": "02:49:46.332",
      "speaker": "SPEAKER_03"
    },
    {
      "start": 10186.906,
      "end": 10188.222,
      "formatted_start": "02:49:46.906",
      "formatted_end": "02:49:48.222",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 10189.015,
      "end": 10189.876,
      "formatted_start": "02:49:49.015",
      "formatted_end": "02:49:49.876",
      "speaker": "SPEAKER_03"
    },
    {
      "start": 10190.72,
      "end": 10191.766,
      "formatted_start": "02:49:50.720",
      "formatted_end": "02:49:51.766",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 10192.002,
      "end": 10193.521,
      "formatted_start": "02:49:52.002",
      "formatted_end": "02:49:53.521",
      "speaker": "SPEAKER_03"
    },
    {
      "start": 10194.331,
      "end": 10194.82,
      "formatted_start": "02:49:54.331",
      "formatted_end": "02:49:54.820",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 10194.5,
      "end": 10197.908,
      "formatted_start": "02:49:54.500",
      "formatted_end": "02:49:57.908",
      "speaker": "SPEAKER_03"
    },
    {
      "start": 10198.162,
      "end": 10199.967,
      "formatted_start": "02:49:58.162",
      "formatted_end": "02:49:59.967",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9930.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:30.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 1,
      "start": 9930.0,
      "end": 9933.76,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:33.760",
      "text": "نه بنابراین خدا بگو دید خیلی دارم این آدم یه نگاه انداخت"
    },
    {
      "id": 2,
      "start": 9934.9,
      "end": 9936.9,
      "formatted_start": "02:45:34.900",
      "formatted_end": "02:45:36.900",
      "text": "نه منم چون بیدم آدم هم موضوع بوده"
    },
    {
      "id": 3,
      "start": 9936.9,
      "end": 9940.98,
      "formatted_start": "02:45:36.900",
      "formatted_end": "02:45:40.980",
      "text": "نه گو که زیر کلر خوابیده یه موثع شدی"
    },
    {
      "id": 4,
      "start": 9942.0,
      "end": 9943.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:43.000",
      "text": "آره انشاءالله"
    },
    {
      "id": 5,
      "start": 9945.9,
      "end": 9947.9,
      "formatted_start": "02:45:45.900",
      "formatted_end": "02:45:47.900",
      "text": "همه دارو ها دارو اضافتون کنم؟"
    },
    {
      "id": 6,
      "start": 9948.5,
      "end": 9950.1,
      "formatted_start": "02:45:48.500",
      "formatted_end": "02:45:50.100",
      "text": "خب دکتور این همه دارو"
    },
    {
      "id": 7,
      "start": 9950.1,
      "end": 9954.1,
      "formatted_start": "02:45:50.100",
      "formatted_end": "02:45:54.100",
      "text": "مردم شما زنپت و چی رو نوشتیم بران شب هم بخورم"
    },
    {
      "id": 8,
      "start": 9954.5,
      "end": 9957.2,
      "formatted_start": "02:45:54.500",
      "formatted_end": "02:45:57.200",
      "text": "اون دوز رو دکتور گیاهیم گفت شد نپر کنید"
    },
    {
      "id": 9,
      "start": 9957.2,
      "end": 9960.2,
      "formatted_start": "02:45:57.200",
      "formatted_end": "02:46:00.200",
      "text": "اینجا دستگاه میدازه ولی باید برم کنترل شده"
    },
    {
      "id": 10,
      "start": 9960.2,
      "end": 9963.2,
      "formatted_start": "02:46:00.200",
      "formatted_end": "02:46:03.200",
      "text": "اون گیاهی ها بدبخ کرده مریضانا"
    },
    {
      "id": 11,
      "start": 9963.2,
      "end": 9967.2,
      "formatted_start": "02:46:03.200",
      "formatted_end": "02:46:07.200",
      "text": "مریضانا اونها همه را به دیالیز کشند و اینا ها"
    },
    {
      "id": 12,
      "start": 9967.2,
      "end": 9970.2,
      "formatted_start": "02:46:07.200",
      "formatted_end": "02:46:10.200",
      "text": "تو فکر کردی تو امریکا و اروپا نه فهمیدن"
    },
    {
      "id": 13,
      "start": 9970.2,
      "end": 9974.2,
      "formatted_start": "02:46:10.200",
      "formatted_end": "02:46:14.200",
      "text": "میت گرمین کلیت خراب می کنه این گیاهی های اینجا فهمیدن؟"
    },
    {
      "id": 14,
      "start": 9974.2,
      "end": 9980.2,
      "formatted_start": "02:46:14.200",
      "formatted_end": "02:46:20.200",
      "text": "میدونی از شفاره اینه رو خوش بگیرید چند تا ما دیالیزی داشتیم بادار گیاهی؟"
    },
    {
      "id": 15,
      "start": 9980.2,
      "end": 9983.2,
      "formatted_start": "02:46:20.200",
      "formatted_end": "02:46:23.200",
      "text": "چند تا داشتیم که عبدشون رو عدست دادن؟"
    },
    {
      "id": 16,
      "start": 9983.2,
      "end": 9986.2,
      "formatted_start": "02:46:23.200",
      "formatted_end": "02:46:26.200",
      "text": "خب چیز رو سلامتی تونو میدید از دست هرکی هست؟"
    },
    {
      "id": 17,
      "start": 9986.2,
      "end": 9990.2,
      "formatted_start": "02:46:26.200",
      "formatted_end": "02:46:30.200",
      "text": "خانه دکتور الان به من گیر داده بود بیا بادکش رحم انجام بدم"
    },
    {
      "id": 18,
      "start": 9990.2,
      "end": 9996.2,
      "formatted_start": "02:46:30.200",
      "formatted_end": "02:46:36.200",
      "text": "نه چی میگم؟ شیاب بذارم داخل رحمه، تو خونت رحم دیرفتی"
    },
    {
      "id": 19,
      "start": 9996.2,
      "end": 9999.2,
      "formatted_start": "02:46:36.200",
      "formatted_end": "02:46:39.200",
      "text": "خب تو خدا سلامتی تونو ندین دست هرکی هست"
    },
    {
      "id": 20,
      "start": 9999.2,
      "end": 10003.2,
      "formatted_start": "02:46:39.200",
      "formatted_end": "02:46:43.200",
      "text": "ندیده من اومدم پیش شما گفتم از اینکه بیرم اونجا"
    },
    {
      "id": 21,
      "start": 10007.2,
      "end": 10010.2,
      "formatted_start": "02:46:47.200",
      "formatted_end": "02:46:50.200",
      "text": "همه دکتور الان این آن پوله یا ورسه؟"
    },
    {
      "id": 22,
      "start": 10010.2,
      "end": 10012.72,
      "formatted_start": "02:46:50.200",
      "formatted_end": "02:46:52.720",
      "text": "جندارواد هم آنفول هم گرس"
    },
    {
      "id": 23,
      "start": 10012.72,
      "end": 10015.04,
      "formatted_start": "02:46:52.720",
      "formatted_end": "02:46:55.040",
      "text": "یک دونا گرس و یک آنفول"
    },
    {
      "id": 24,
      "start": 10015.04,
      "end": 10016.2,
      "formatted_start": "02:46:55.040",
      "formatted_end": "02:46:56.200",
      "text": "چه موقعی پاید بخوری؟"
    },
    {
      "id": 25,
      "start": 10016.2,
      "end": 10017.96,
      "formatted_start": "02:46:56.200",
      "formatted_end": "02:46:57.960",
      "text": "یکی شوک شبا بخوری"
    },
    {
      "id": 26,
      "start": 10017.96,
      "end": 10019.6,
      "formatted_start": "02:46:57.960",
      "formatted_end": "02:46:59.600",
      "text": "خیلی قوی نمیشن"
    },
    {
      "id": 27,
      "start": 10019.6,
      "end": 10021.4,
      "formatted_start": "02:46:59.600",
      "formatted_end": "02:47:01.400",
      "text": "چون برای اینو بس نیتر تو نرزه"
    },
    {
      "id": 28,
      "start": 10021.4,
      "end": 10022.96,
      "formatted_start": "02:47:01.400",
      "formatted_end": "02:47:02.960",
      "text": "آنفولات هم دوتا رو همگوز میزنی"
    },
    {
      "id": 29,
      "start": 10022.96,
      "end": 10023.96,
      "formatted_start": "02:47:02.960",
      "formatted_end": "02:47:03.960",
      "text": "یکی بس فردا"
    },
    {
      "id": 30,
      "start": 10023.96,
      "end": 10025.56,
      "formatted_start": "02:47:03.960",
      "formatted_end": "02:47:05.560",
      "text": "پاید یه جل میده"
    },
    {
      "id": 31,
      "start": 10025.56,
      "end": 10026.72,
      "formatted_start": "02:47:05.560",
      "formatted_end": "02:47:06.720",
      "text": "سه ماساج بده همین"
    },
    {
      "id": 32,
      "start": 10026.72,
      "end": 10028.12,
      "formatted_start": "02:47:06.720",
      "formatted_end": "02:47:08.120",
      "text": "فقط اگه دونه زد بیا"
    },
    {
      "id": 33,
      "start": 10028.12,
      "end": 10029.0,
      "formatted_start": "02:47:08.120",
      "formatted_end": "02:47:09.000",
      "text": "باشه چشم"
    },
    {
      "id": 34,
      "start": 10029.0,
      "end": 10031.76,
      "formatted_start": "02:47:09.000",
      "formatted_end": "02:47:11.760",
      "text": "گرس برد کبیده چرا نمیمونیم"
    },
    {
      "id": 35,
      "start": 10031.76,
      "end": 10033.44,
      "formatted_start": "02:47:11.760",
      "formatted_end": "02:47:13.440",
      "text": "سه هم دیگه همون رو بیاد"
    },
    {
      "id": 36,
      "start": 10033.44,
      "end": 10036.44,
      "formatted_start": "02:47:13.440",
      "formatted_end": "02:47:16.440",
      "text": "اصلا داروی یا هیاتو بخور دیگه استفاده کن."
    },
    {
      "id": 37,
      "start": 10036.44,
      "end": 10039.44,
      "formatted_start": "02:47:16.440",
      "formatted_end": "02:47:19.440",
      "text": "اون چیزو دانی چیه و خمه ها رو شما کنید."
    },
    {
      "id": 38,
      "start": 10039.44,
      "end": 10041.44,
      "formatted_start": "02:47:19.440",
      "formatted_end": "02:47:21.440",
      "text": "در قهوه پیش گفتید سرد بخوریم."
    },
    {
      "id": 39,
      "start": 10041.44,
      "end": 10043.44,
      "formatted_start": "02:47:21.440",
      "formatted_end": "02:47:23.440",
      "text": "قهوه که گفتید استفاده نکن دیگه."
    },
    {
      "id": 40,
      "start": 10043.44,
      "end": 10045.44,
      "formatted_start": "02:47:23.440",
      "formatted_end": "02:47:25.440",
      "text": "مدت مشکل هست خوب ازش."
    },
    {
      "id": 41,
      "start": 10045.44,
      "end": 10048.44,
      "formatted_start": "02:47:25.440",
      "formatted_end": "02:47:28.440",
      "text": "قهوه سرد بخور دیگه فکر کنم."
    },
    {
      "id": 42,
      "start": 10048.44,
      "end": 10054.44,
      "formatted_start": "02:47:28.440",
      "formatted_end": "02:47:34.440",
      "text": "نه قهوه یا قهوه چرک یا قهوه عرب اینا ها."
    },
    {
      "id": 43,
      "start": 10054.44,
      "end": 10056.44,
      "formatted_start": "02:47:34.440",
      "formatted_end": "02:47:36.440",
      "text": "ولی اگه مدتو ازیاد می کنن همینجوری."
    },
    {
      "id": 44,
      "start": 10056.44,
      "end": 10059.74,
      "formatted_start": "02:47:36.440",
      "formatted_end": "02:47:39.740",
      "text": "او شاید زندگی نمی آره خورم دوتا"
    },
    {
      "id": 45,
      "start": 10059.74,
      "end": 10060.34,
      "formatted_start": "02:47:39.740",
      "formatted_end": "02:47:40.340",
      "text": "چرا؟"
    },
    {
      "id": 46,
      "start": 10060.34,
      "end": 10064.62,
      "formatted_start": "02:47:40.340",
      "formatted_end": "02:47:44.620",
      "text": "چون روز تا ساعت هشت شاید باید جوب بکنی"
    },
    {
      "id": 47,
      "start": 10064.62,
      "end": 10066.72,
      "formatted_start": "02:47:44.620",
      "formatted_end": "02:47:46.720",
      "text": "و دو ساعت میخوایی بخوابی"
    },
    {
      "id": 48,
      "start": 10066.72,
      "end": 10068.52,
      "formatted_start": "02:47:46.720",
      "formatted_end": "02:47:48.520",
      "text": "و رکی قفه بخوابی داری دیگه"
    },
    {
      "id": 49,
      "start": 10068.52,
      "end": 10069.04,
      "formatted_start": "02:47:48.520",
      "formatted_end": "02:47:49.040",
      "text": "چرا؟"
    },
    {
      "id": 50,
      "start": 10069.04,
      "end": 10071.36,
      "formatted_start": "02:47:49.040",
      "formatted_end": "02:47:51.360",
      "text": "با همین کدورن"
    },
    {
      "id": 51,
      "start": 10071.36,
      "end": 10072.16,
      "formatted_start": "02:47:51.360",
      "formatted_end": "02:47:52.160",
      "text": "مردی"
    },
    {
      "id": 52,
      "start": 10072.16,
      "end": 10072.76,
      "formatted_start": "02:47:52.160",
      "formatted_end": "02:47:52.760",
      "text": "خوبا"
    },
    {
      "id": 53,
      "start": 10072.76,
      "end": 10073.36,
      "formatted_start": "02:47:52.760",
      "formatted_end": "02:47:53.360",
      "text": "تشکر میکنم"
    },
    {
      "id": 54,
      "start": 10073.36,
      "end": 10074.34,
      "formatted_start": "02:47:53.360",
      "formatted_end": "02:47:54.340",
      "text": "مردی"
    },
    {
      "id": 55,
      "start": 10074.34,
      "end": 10076.1,
      "formatted_start": "02:47:54.340",
      "formatted_end": "02:47:56.100",
      "text": "یه درصد دیدیم خورم نشدی"
    },
    {
      "id": 56,
      "start": 10076.1,
      "end": 10077.66,
      "formatted_start": "02:47:56.100",
      "formatted_end": "02:47:57.660",
      "text": "آزمایشا ادرار نوشتند"
    },
    {
      "id": 57,
      "start": 10077.66,
      "end": 10079.08,
      "formatted_start": "02:47:57.660",
      "formatted_end": "02:47:59.080",
      "text": "آن باشه من میاد باشم"
    },
    {
      "id": 58,
      "start": 10079.08,
      "end": 10080.42,
      "formatted_start": "02:47:59.080",
      "formatted_end": "02:48:00.420",
      "text": "نه کدش داری"
    },
    {
      "id": 59,
      "start": 10080.42,
      "end": 10082.44,
      "formatted_start": "02:48:00.420",
      "formatted_end": "02:48:02.440",
      "text": "همین عکس دیدید تو باشید"
    },
    {
      "id": 60,
      "start": 10082.44,
      "end": 10083.64,
      "formatted_start": "02:48:02.440",
      "formatted_end": "02:48:03.640",
      "text": "با همین بود آزماشگاه"
    },
    {
      "id": 61,
      "start": 10083.64,
      "end": 10086.48,
      "formatted_start": "02:48:03.640",
      "formatted_end": "02:48:06.480",
      "text": "آه این آزماشگاه چی بود بگیر سپید"
    },
    {
      "id": 62,
      "start": 10086.48,
      "end": 10091.0,
      "formatted_start": "02:48:06.480",
      "formatted_end": "02:48:11.000",
      "text": "سپید میتونی بری بیمارستان میتونی بری با بهداری با همین کودت میتونی بری هر جا میخوانی"
    },
    {
      "id": 63,
      "start": 10091.0,
      "end": 10091.4,
      "formatted_start": "02:48:11.000",
      "formatted_end": "02:48:11.400",
      "text": "من مونم"
    },
    {
      "id": 64,
      "start": 10091.4,
      "end": 10092.72,
      "formatted_start": "02:48:11.400",
      "formatted_end": "02:48:12.720",
      "text": "هرگیه در سالی دیده بود"
    },
    {
      "id": 65,
      "start": 10092.72,
      "end": 10094.44,
      "formatted_start": "02:48:12.720",
      "formatted_end": "02:48:14.440",
      "text": "نه اگه دونست نداره واقعا"
    },
    {
      "id": 66,
      "start": 10094.44,
      "end": 10095.76,
      "formatted_start": "02:48:14.440",
      "formatted_end": "02:48:15.760",
      "text": "اونم بیره به ما بگیر"
    },
    {
      "id": 67,
      "start": 10095.76,
      "end": 10096.52,
      "formatted_start": "02:48:15.760",
      "formatted_end": "02:48:16.520",
      "text": "باش من برم"
    },
    {
      "id": 68,
      "start": 10096.52,
      "end": 10097.32,
      "formatted_start": "02:48:16.520",
      "formatted_end": "02:48:17.320",
      "text": "سه همه باشم"
    },
    {
      "id": 69,
      "start": 10097.32,
      "end": 10097.76,
      "formatted_start": "02:48:17.320",
      "formatted_end": "02:48:17.760",
      "text": "نه"
    },
    {
      "id": 70,
      "start": 10099.76,
      "end": 10100.84,
      "formatted_start": "02:48:19.760",
      "formatted_end": "02:48:20.840",
      "text": "که فراموش هست"
    },
    {
      "id": 71,
      "start": 10100.84,
      "end": 10102.76,
      "formatted_start": "02:48:20.840",
      "formatted_end": "02:48:22.760",
      "text": "اینجوری جلده از این تقسیم"
    },
    {
      "id": 72,
      "start": 10105.76,
      "end": 10106.76,
      "formatted_start": "02:48:25.760",
      "formatted_end": "02:48:26.760",
      "text": "چه خبر؟"
    },
    {
      "id": 73,
      "start": 10108.28,
      "end": 10109.28,
      "formatted_start": "02:48:28.280",
      "formatted_end": "02:48:29.280",
      "text": "چی با کردی؟"
    },
    {
      "id": 74,
      "start": 10109.28,
      "end": 10114.28,
      "formatted_start": "02:48:29.280",
      "formatted_end": "02:48:34.280",
      "text": "اون درخواهی های اینکه هیچی که دارویات میکنی؟"
    },
    {
      "id": 75,
      "start": 10114.28,
      "end": 10117.28,
      "formatted_start": "02:48:34.280",
      "formatted_end": "02:48:37.280",
      "text": "اون رو قط کردم، دو ماه فیلم قط کردم"
    },
    {
      "id": 76,
      "start": 10117.28,
      "end": 10118.28,
      "formatted_start": "02:48:37.280",
      "formatted_end": "02:48:38.280",
      "text": "برای چی؟"
    },
    {
      "id": 77,
      "start": 10118.28,
      "end": 10120.28,
      "formatted_start": "02:48:38.280",
      "formatted_end": "02:48:40.280",
      "text": "چون میدم از یک بیگه"
    },
    {
      "id": 78,
      "start": 10120.28,
      "end": 10122.28,
      "formatted_start": "02:48:40.280",
      "formatted_end": "02:48:42.280",
      "text": "چی دیگه این کار رو بکنه تو؟"
    },
    {
      "id": 79,
      "start": 10122.28,
      "end": 10126.28,
      "formatted_start": "02:48:42.280",
      "formatted_end": "02:48:46.280",
      "text": "قرار بود که آقای مجابی رو رفتم شبت مجابی رو بسیار"
    },
    {
      "id": 80,
      "start": 10126.28,
      "end": 10129.28,
      "formatted_start": "02:48:46.280",
      "formatted_end": "02:48:49.280",
      "text": "گفت، اون دارویات میکنم، قط کنم باز"
    },
    {
      "id": 81,
      "start": 10129.28,
      "end": 10134.28,
      "formatted_start": "02:48:49.280",
      "formatted_end": "02:48:54.280",
      "text": "چون میدم یکم ها تا دیگه نرفتم باز یکم ها رفتم نشد"
    },
    {
      "id": 82,
      "start": 10134.28,
      "end": 10139.28,
      "formatted_start": "02:48:54.280",
      "formatted_end": "02:48:59.280",
      "text": "اون برابرشن رو برد شد و گفت که تا سال شیش وزده سینورو برداشت"
    },
    {
      "id": 83,
      "start": 10139.28,
      "end": 10142.28,
      "formatted_start": "02:48:59.280",
      "formatted_end": "02:49:02.280",
      "text": "به چهار پنج بار حالا برداشت و تا این برداشت"
    },
    {
      "id": 84,
      "start": 10142.28,
      "end": 10145.28,
      "formatted_start": "02:49:02.280",
      "formatted_end": "02:49:05.280",
      "text": "دیگه برد گفتم بیم اینجا برد میدم"
    },
    {
      "id": 85,
      "start": 10145.28,
      "end": 10149.28,
      "formatted_start": "02:49:05.280",
      "formatted_end": "02:49:09.280",
      "text": "مجلو گفت چی کنی میخواد دو کنه؟ سینورو آینا شروع کنه؟ ترجریبی؟"
    },
    {
      "id": 86,
      "start": 10149.28,
      "end": 10154.28,
      "formatted_start": "02:49:09.280",
      "formatted_end": "02:49:14.280",
      "text": "گفت که آزمایش رو دوباره بده و سونوگرافی انجام بده ببینیم چیه"
    },
    {
      "id": 87,
      "start": 10154.28,
      "end": 10159.28,
      "formatted_start": "02:49:14.280",
      "formatted_end": "02:49:19.280",
      "text": "گفت که اون چیز رو میبای کرد، این نمونه برداری"
    },
    {
      "id": 88,
      "start": 10159.28,
      "end": 10165.28,
      "formatted_start": "02:49:19.280",
      "formatted_end": "02:49:25.280",
      "text": "گفت که برای تو خطر آن شمایی نداشت. میگن مثلاً بدخینی که این توی گفت."
    },
    {
      "id": 89,
      "start": 10165.28,
      "end": 10170.28,
      "formatted_start": "02:49:25.280",
      "formatted_end": "02:49:30.280",
      "text": "گفت که اگه اون بود اون دو سه سال اول کلیات باید پیغم میشه."
    },
    {
      "id": 90,
      "start": 10170.28,
      "end": 10173.28,
      "formatted_start": "02:49:30.280",
      "formatted_end": "02:49:33.280",
      "text": "خب من بدخین به معلومه نبودم."
    },
    {
      "id": 91,
      "start": 10173.28,
      "end": 10177.28,
      "formatted_start": "02:49:33.280",
      "formatted_end": "02:49:37.280",
      "text": "گفت که چون بیست سال بیشتر الان این توی یستی چیز نداره."
    },
    {
      "id": 92,
      "start": 10177.28,
      "end": 10180.28,
      "formatted_start": "02:49:37.280",
      "formatted_end": "02:49:40.280",
      "text": "صدا چرا گفت؟"
    },
    {
      "id": 93,
      "start": 10180.28,
      "end": 10182.28,
      "formatted_start": "02:49:40.280",
      "formatted_end": "02:49:42.280",
      "text": "میبینم کلیات خوشگذار."
    },
    {
      "id": 94,
      "start": 10182.28,
      "end": 10186.28,
      "formatted_start": "02:49:42.280",
      "formatted_end": "02:49:46.280",
      "text": "پردنزلان هم تو نمیخوره؟ پردنزلان هم نمیخوره؟"
    },
    {
      "id": 95,
      "start": 10186.28,
      "end": 10188.28,
      "formatted_start": "02:49:46.280",
      "formatted_end": "02:49:48.280",
      "text": "کلی همین چیزی تا باشه"
    },
    {
      "id": 96,
      "start": 10188.28,
      "end": 10190.28,
      "formatted_start": "02:49:48.280",
      "formatted_end": "02:49:50.280",
      "text": "چند وقته؟"
    },
    {
      "id": 97,
      "start": 10190.28,
      "end": 10192.28,
      "formatted_start": "02:49:50.280",
      "formatted_end": "02:49:52.280",
      "text": "یکمیشه"
    },
    {
      "id": 98,
      "start": 10192.28,
      "end": 10194.28,
      "formatted_start": "02:49:52.280",
      "formatted_end": "02:49:54.280",
      "text": "خیلی کار بدی می کنی"
    },
    {
      "id": 99,
      "start": 10194.28,
      "end": 10198.28,
      "formatted_start": "02:49:54.280",
      "formatted_end": "02:49:58.280",
      "text": "در آقای تا وقتی نردی دکتر فرد نزدونتو که بخور دیگه"
    },
    {
      "id": 100,
      "start": 10198.28,
      "end": 10200.28,
      "formatted_start": "02:49:58.280",
      "formatted_end": "02:50:00.280",
      "text": "آزمایش رای چیز"
    }
  ],
  "status": "completed"
}