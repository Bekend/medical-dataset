  "stt_segments": [
    {
      "id": 0,
      "start": 21300.0,
      "end": 21302.0,
      "formatted_start": "05:55:00.000",
      "formatted_end": "05:55:02.000",
      "text": "اگر گرمز باشه، اصیدوریکیه."
    },
    {
      "id": 1,
      "start": 21302.0,
      "end": 21304.0,
      "formatted_start": "05:55:02.000",
      "formatted_end": "05:55:04.000",
      "text": "یعنی که نباید گوشت قرمز بخوره."
    },
    {
      "id": 2,
      "start": 21304.0,
      "end": 21310.0,
      "formatted_start": "05:55:04.000",
      "formatted_end": "05:55:10.000",
      "text": "گوشت قرمز و اسفناج و نمک."
    },
    {
      "id": 3,
      "start": 21310.0,
      "end": 21312.0,
      "formatted_start": "05:55:10.000",
      "formatted_end": "05:55:12.000",
      "text": "پردیجات نباید بخورن."
    },
    {
      "id": 4,
      "start": 21312.0,
      "end": 21314.0,
      "formatted_start": "05:55:12.000",
      "formatted_end": "05:55:14.000",
      "text": "نه، فقط اسفناج."
    },
    {
      "id": 5,
      "start": 21314.0,
      "end": 21318.0,
      "formatted_start": "05:55:14.000",
      "formatted_end": "05:55:18.000",
      "text": "بعد گوشت قرمز نباید بخورن، تو قضاشون هم نباید نمک زیاد بزنن."
    },
    {
      "id": 6,
      "start": 21318.0,
      "end": 21320.0,
      "formatted_start": "05:55:18.000",
      "formatted_end": "05:55:20.000",
      "text": "نه، نباید بزنن."
    },
    {
      "id": 7,
      "start": 21320.0,
      "end": 21322.0,
      "formatted_start": "05:55:20.000",
      "formatted_end": "05:55:22.000",
      "text": "قضاش خوب هستن چون داقشه بزن."
    },
    {
      "id": 8,
      "start": 21322.0,
      "end": 21324.0,
      "formatted_start": "05:55:22.000",
      "formatted_end": "05:55:24.000",
      "text": "کم رنگ پلیت هست، کم خونه بزن."
    },
    {
      "id": 9,
      "start": 21324.0,
      "end": 21326.0,
      "formatted_start": "05:55:24.000",
      "formatted_end": "05:55:26.000",
      "text": "گوشت تورون چون خیلی درد دار."
    },
    {
      "id": 10,
      "start": 21356.0,
      "end": 21372.0,
      "formatted_start": "05:55:56.000",
      "formatted_end": "05:56:12.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 21386.0,
      "end": 21395.0,
      "formatted_start": "05:56:26.000",
      "formatted_end": "05:56:35.000",
      "text": "خوش کن و مامان با غذا با قصد و مددی بخورن که مددشون عذیب نشد"
    },
    {
      "id": 12,
      "start": 21395.0,
      "end": 21400.0,
      "formatted_start": "05:56:35.000",
      "formatted_end": "05:56:40.000",
      "text": "اما دوتا از ماشبت بدارن؟"
    },
    {
      "id": 13,
      "start": 21400.0,
      "end": 21406.0,
      "formatted_start": "05:56:40.000",
      "formatted_end": "05:56:46.000",
      "text": "دستی تیزکن برو، اول برستی تیزکن، اگه باز لازم شد میمونیم"
    },
    {
      "id": 14,
      "start": 21406.0,
      "end": 21408.0,
      "formatted_start": "05:56:46.000",
      "formatted_end": "05:56:48.000",
      "text": "دستی تیزکن؟"
    },
    {
      "id": 15,
      "start": 21408.0,
      "end": 21410.0,
      "formatted_start": "05:56:48.000",
      "formatted_end": "05:56:50.000",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 21410.0,
      "end": 21412.0,
      "formatted_start": "05:56:50.000",
      "formatted_end": "05:56:52.000",
      "text": "پاسرانگاره، دنجان؟"
    },
    {
      "id": 17,
      "start": 21412.0,
      "end": 21414.0,
      "formatted_start": "05:56:52.000",
      "formatted_end": "05:56:54.000",
      "text": "نه، بیمارستان"
    },
    {
      "id": 18,
      "start": 21414.0,
      "end": 21418.0,
      "formatted_start": "05:56:54.000",
      "formatted_end": "05:56:58.000",
      "text": "بیمارستان بری هر وقت بری میتونی"
    },
    {
      "id": 19,
      "start": 21432.0,
      "end": 21434.0,
      "formatted_start": "05:57:12.000",
      "formatted_end": "05:57:14.000",
      "text": "یک کلمه هم گرفتی"
    },
    {
      "id": 20,
      "start": 21434.0,
      "end": 21438.0,
      "formatted_start": "05:57:14.000",
      "formatted_end": "05:57:18.000",
      "text": "ماما باست تقنیتی چی نمیخورده؟"
    },
    {
      "id": 21,
      "start": 21438.0,
      "end": 21441.0,
      "formatted_start": "05:57:18.000",
      "formatted_end": "05:57:21.000",
      "text": "یه لیگه همونهایی که دادیم"
    },
    {
      "id": 22,
      "start": 21441.0,
      "end": 21443.0,
      "formatted_start": "05:57:21.000",
      "formatted_end": "05:57:23.000",
      "text": "شکمتون صف کار میکنه؟"
    },
    {
      "id": 23,
      "start": 21445.0,
      "end": 21448.0,
      "formatted_start": "05:57:25.000",
      "formatted_end": "05:57:28.000",
      "text": "اگر غذا بخورم بتانم که نه"
    },
    {
      "id": 24,
      "start": 21448.0,
      "end": 21449.0,
      "formatted_start": "05:57:28.000",
      "formatted_end": "05:57:29.000",
      "text": "اگر نخورم..."
    },
    {
      "id": 25,
      "start": 21449.0,
      "end": 21452.0,
      "formatted_start": "05:57:29.000",
      "formatted_end": "05:57:32.000",
      "text": "اجازه این چند روزه مریضه این غذا میخوردی روزهای دیگه؟"
    },
    {
      "id": 26,
      "start": 21453.0,
      "end": 21455.0,
      "formatted_start": "05:57:33.000",
      "formatted_end": "05:57:35.000",
      "text": "باید بردم کم"
    },
    {
      "id": 27,
      "start": 21455.0,
      "end": 21457.0,
      "formatted_start": "05:57:35.000",
      "formatted_end": "05:57:37.000",
      "text": "غذا هم خیلی کمه"
    },
    {
      "id": 28,
      "start": 21457.0,
      "end": 21459.0,
      "formatted_start": "05:57:37.000",
      "formatted_end": "05:57:39.000",
      "text": "غذا هم از اون اول همیتونی غذا کنه"
    },
    {
      "id": 29,
      "start": 21459.0,
      "end": 21462.0,
      "formatted_start": "05:57:39.000",
      "formatted_end": "05:57:42.000",
      "text": "الان که میگه این چیشت یا نداره؟"
    },
    {
      "id": 30,
      "start": 21465.0,
      "end": 21466.0,
      "formatted_start": "05:57:45.000",
      "formatted_end": "05:57:46.000",
      "text": "صحیب شد کنم"
    },
    {
      "id": 31,
      "start": 21466.0,
      "end": 21468.0,
      "formatted_start": "05:57:46.000",
      "formatted_end": "05:57:48.000",
      "text": "خونه تو کجاست؟"
    },
    {
      "id": 32,
      "start": 21468.0,
      "end": 21470.0,
      "formatted_start": "05:57:48.000",
      "formatted_end": "05:57:50.000",
      "text": "از این تنفره"
    },
    {
      "id": 33,
      "start": 21470.0,
      "end": 21474.0,
      "formatted_start": "05:57:50.000",
      "formatted_end": "05:57:54.000",
      "text": "آزمایش برم سر میتونی ببری مامان تمن اجتماعی آزمایش بدی؟"
    },
    {
      "id": 34,
      "start": 21474.0,
      "end": 21476.0,
      "formatted_start": "05:57:54.000",
      "formatted_end": "05:57:56.000",
      "text": "میدونم"
    },
    {
      "id": 35,
      "start": 21476.0,
      "end": 21479.0,
      "formatted_start": "05:57:56.000",
      "formatted_end": "05:57:59.000",
      "text": "برم خانه، از این تنفره بریم"
    },
    {
      "id": 36,
      "start": 21479.0,
      "end": 21482.0,
      "formatted_start": "05:57:59.000",
      "formatted_end": "05:58:02.000",
      "text": "نه امروز که نه فردا ناشته برم باشه"
    },
    {
      "id": 37,
      "start": 21482.0,
      "end": 21485.0,
      "formatted_start": "05:58:02.000",
      "formatted_end": "05:58:05.000",
      "text": "برای آزمایشم بده خیلی وقتا نداده"
    },
    {
      "id": 38,
      "start": 21485.0,
      "end": 21488.0,
      "formatted_start": "05:58:05.000",
      "formatted_end": "05:58:08.000",
      "text": "همون دولتی ببر همون چند جامعه"
    },
    {
      "id": 39,
      "start": 21488.0,
      "end": 21490.0,
      "formatted_start": "05:58:08.000",
      "formatted_end": "05:58:10.000",
      "text": "برای توی دنبال"
    },
    {
      "id": 40,
      "start": 21490.0,
      "end": 21491.0,
      "formatted_start": "05:58:10.000",
      "formatted_end": "05:58:11.000",
      "text": "میگم؟"
    },
    {
      "id": 41,
      "start": 21491.0,
      "end": 21492.0,
      "formatted_start": "05:58:11.000",
      "formatted_end": "05:58:12.000",
      "text": "میگم"
    },
    {
      "id": 42,
      "start": 21492.0,
      "end": 21494.0,
      "formatted_start": "05:58:12.000",
      "formatted_end": "05:58:14.000",
      "text": "برای توی دنبال"
    },
    {
      "id": 43,
      "start": 21494.0,
      "end": 21502.0,
      "formatted_start": "05:58:14.000",
      "formatted_end": "05:58:22.000",
      "text": "میگم کامل میریمستم و اگه گفت همه رو نداریم تو با هر چی رو داری ننجام بده"
    },
    {
      "id": 44,
      "start": 21502.0,
      "end": 21507.0,
      "formatted_start": "05:58:22.000",
      "formatted_end": "05:58:27.000",
      "text": "چون یک آزمایش ممنون یک چیزی بشه بگیرم کم خونه خیلی"
    },
    {
      "id": 45,
      "start": 21507.0,
      "end": 21509.0,
      "formatted_start": "05:58:27.000",
      "formatted_end": "05:58:29.000",
      "text": "حالا نمیشه اینکه نشونیم"
    },
    {
      "id": 46,
      "start": 21509.0,
      "end": 21511.0,
      "formatted_start": "05:58:29.000",
      "formatted_end": "05:58:31.000",
      "text": "آره ویروس داریم"
    },
    {
      "id": 47,
      "start": 21511.0,
      "end": 21513.0,
      "formatted_start": "05:58:31.000",
      "formatted_end": "05:58:33.000",
      "text": "اون سه هم داد اینه کم خونه بود"
    },
    {
      "id": 48,
      "start": 21513.0,
      "end": 21517.0,
      "formatted_start": "05:58:33.000",
      "formatted_end": "05:58:37.000",
      "text": "آن پوده بود اون زنه فکر کنم الان همین شبیه تیزیده"
    },
    {
      "id": 49,
      "start": 21517.0,
      "end": 21520.0,
      "formatted_start": "05:58:37.000",
      "formatted_end": "05:58:40.000",
      "text": "زیادی رنگ برده اصلا"
    },
    {
      "id": 50,
      "start": 21524.0,
      "end": 21530.0,
      "formatted_start": "05:58:44.000",
      "formatted_end": "05:58:50.000",
      "text": "و همون بیمارستان که در مورد تمنیم، همون همون هر چی دارن"
    },
    {
      "id": 51,
      "start": 21530.0,
      "end": 21537.0,
      "formatted_start": "05:58:50.000",
      "formatted_end": "05:58:57.000",
      "text": "پس این همه شد آزمایش ادراد ماما، سی تی اسکن، آزمایش کل، سی تی اسکن داروهای ماما خوب؟"
    },
    {
      "id": 52,
      "start": 21537.0,
      "end": 21539.0,
      "formatted_start": "05:58:57.000",
      "formatted_end": "05:58:59.000",
      "text": "همه، همون برخورد"
    },
    {
      "id": 53,
      "start": 21539.0,
      "end": 21541.0,
      "formatted_start": "05:58:59.000",
      "formatted_end": "05:59:01.000",
      "text": "اما عرق قرمزه همه چیه؟"
    },
    {
      "id": 54,
      "start": 21541.0,
      "end": 21543.0,
      "formatted_start": "05:59:01.000",
      "formatted_end": "05:59:03.000",
      "text": "پرده این هم نشونده نماره نه؟"
    },
    {
      "id": 55,
      "start": 21543.0,
      "end": 21546.0,
      "formatted_start": "05:59:03.000",
      "formatted_end": "05:59:06.000",
      "text": "آره دیگه، اونو باید داشته باشی، گل آن رو بکنه، با یک عکس بگیر"
    },
    {
      "id": 56,
      "start": 21546.0,
      "end": 21552.0,
      "formatted_start": "05:59:06.000",
      "formatted_end": "05:59:12.000",
      "text": "بگیر هم آزمایشگاه اونو میخواد هم سی تی اسکن بیمارستان هم همه دارواشون"
    },
    {
      "id": 57,
      "start": 21552.0,
      "end": 21554.0,
      "formatted_start": "05:59:12.000",
      "formatted_end": "05:59:14.000",
      "text": "باید درد ندیده"
    },
    {
      "id": 58,
      "start": 21554.0,
      "end": 21556.0,
      "formatted_start": "05:59:14.000",
      "formatted_end": "05:59:16.000",
      "text": "خدا مطلق"
    },
    {
      "id": 59,
      "start": 21556.0,
      "end": 21558.0,
      "formatted_start": "05:59:16.000",
      "formatted_end": "05:59:18.000",
      "text": "سلامتون بخورد"
    },
    {
      "id": 60,
      "start": 21558.0,
      "end": 21560.0,
      "formatted_start": "05:59:18.000",
      "formatted_end": "05:59:20.000",
      "text": "سلامتون بخورد"
    },
    {
      "id": 61,
      "start": 21560.0,
      "end": 21562.0,
      "formatted_start": "05:59:20.000",
      "formatted_end": "05:59:22.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 62,
      "start": 21562.0,
      "end": 21564.0,
      "formatted_start": "05:59:22.000",
      "formatted_end": "05:59:24.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 63,
      "start": 21564.0,
      "end": 21566.0,
      "formatted_start": "05:59:24.000",
      "formatted_end": "05:59:26.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 64,
      "start": 21566.0,
      "end": 21568.0,
      "formatted_start": "05:59:26.000",
      "formatted_end": "05:59:28.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 65,
      "start": 21568.0,
      "end": 21570.0,
      "formatted_start": "05:59:28.000",
      "formatted_end": "05:59:30.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 66,
      "start": 21570.0,
      "end": 21572.0,
      "formatted_start": "05:59:30.000",
      "formatted_end": "05:59:32.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 67,
      "start": 21572.0,
      "end": 21574.0,
      "formatted_start": "05:59:32.000",
      "formatted_end": "05:59:34.000",
      "text": "بسیار مطلق"
    },
    {
      "id": 68,
      "start": 21574.0,
      "end": 21576.0,
      "formatted_start": "05:59:34.000",
      "formatted_end": "05:59:36.000",
      "text": "خواستی فرده بودی؟"
    },
    {
      "id": 69,
      "start": 21576.0,
      "end": 21580.0,
      "formatted_start": "05:59:36.000",
      "formatted_end": "05:59:40.000",
      "text": "نه اصلا نکردم. الان جلو سندلی باید بلند باشم. نمیتونم اینکه اون خواهی خواهی خواهی برم تب براست باشم"
    },
    {
      "id": 70,
      "start": 21580.0,
      "end": 21582.0,
      "formatted_start": "05:59:40.000",
      "formatted_end": "05:59:42.000",
      "text": "سرمامی خورد بدتر میشدی؟"
    },
    {
      "id": 71,
      "start": 21582.0,
      "end": 21588.0,
      "formatted_start": "05:59:42.000",
      "formatted_end": "05:59:48.000",
      "text": "آره. اینجا بودم خیلی شخص سر بگذارد با خورد یادش کردم. آره از همون بود نمیدونم"
    },
    {
      "id": 72,
      "start": 21588.0,
      "end": 21591.0,
      "formatted_start": "05:59:48.000",
      "formatted_end": "05:59:51.000",
      "text": "ادعالتون نگشن. عوض نشده؟"
    },
    {
      "id": 73,
      "start": 21591.0,
      "end": 21593.0,
      "formatted_start": "05:59:51.000",
      "formatted_end": "05:59:53.000",
      "text": "نه اصلا نمیتونم خورد باشم"
    },
    {
      "id": 74,
      "start": 21593.0,
      "end": 21596.0,
      "formatted_start": "05:59:53.000",
      "formatted_end": "05:59:56.000",
      "text": "نه اینو ندارم. تن تن من در دست شویم."
    },
    {
      "id": 75,
      "start": 21596.0,
      "end": 21600.0,
      "formatted_start": "05:59:56.000",
      "formatted_end": "06:00:00.000",
      "text": "پس اونقدر میاد در دست شویم نخواهیم خوب درست شو شد برم."
    }
  ],
  "status": "completed"
}