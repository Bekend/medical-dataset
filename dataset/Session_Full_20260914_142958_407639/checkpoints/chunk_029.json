  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8730.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:30.000",
      "text": "از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیروید رو ببینید که از این تیرو"
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "نه، صافتون"
    },
    {
      "id": 2,
      "start": 8732.0,
      "end": 8735.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:35.000",
      "text": "نه، اون هستگاه نمیشه، اون رجلش دست هم خیلی زیادی شدین کرده"
    },
    {
      "id": 3,
      "start": 8735.0,
      "end": 8737.0,
      "formatted_start": "02:25:35.000",
      "formatted_end": "02:25:37.000",
      "text": "خیلی که نمیشه که که دست نمیشه"
    },
    {
      "id": 4,
      "start": 8737.0,
      "end": 8738.0,
      "formatted_start": "02:25:37.000",
      "formatted_end": "02:25:38.000",
      "text": "صورت چی؟"
    },
    {
      "id": 5,
      "start": 8738.0,
      "end": 8742.0,
      "formatted_start": "02:25:38.000",
      "formatted_end": "02:25:42.000",
      "text": "نه، در یک درخیر میرم تو همو و در یک درخیر دوچار هستگاه نیستم میرم تو همو"
    },
    {
      "id": 6,
      "start": 8742.0,
      "end": 8748.0,
      "formatted_start": "02:25:42.000",
      "formatted_end": "02:25:48.000",
      "text": "دوچار مثلا حس بین کنم که دوچار هستگاه نیستم فروتش کنم"
    },
    {
      "id": 7,
      "start": 8748.0,
      "end": 8750.0,
      "formatted_start": "02:25:48.000",
      "formatted_end": "02:25:50.000",
      "text": "دوچار هستگاه بی خالی بشم"
    },
    {
      "id": 8,
      "start": 8750.0,
      "end": 8752.0,
      "formatted_start": "02:25:50.000",
      "formatted_end": "02:25:52.000",
      "text": "خب فشایز میفت و پای میدونه"
    },
    {
      "id": 9,
      "start": 8752.0,
      "end": 8753.0,
      "formatted_start": "02:25:52.000",
      "formatted_end": "02:25:53.000",
      "text": "خوبه"
    },
    {
      "id": 10,
      "start": 8753.0,
      "end": 8754.0,
      "formatted_start": "02:25:53.000",
      "formatted_end": "02:25:54.000",
      "text": "مرسی خب"
    },
    {
      "id": 11,
      "start": 8754.0,
      "end": 8758.28,
      "formatted_start": "02:25:54.000",
      "formatted_end": "02:25:58.280",
      "text": "ببخش این همین سونوگرافی یادگار امام بدم یا دیگه سونوگرافی"
    },
    {
      "id": 12,
      "start": 8758.28,
      "end": 8759.2,
      "formatted_start": "02:25:58.280",
      "formatted_end": "02:25:59.200",
      "text": "آره خوبم"
    },
    {
      "id": 13,
      "start": 8759.2,
      "end": 8759.96,
      "formatted_start": "02:25:59.200",
      "formatted_end": "02:25:59.960",
      "text": "نه خوبم"
    },
    {
      "id": 14,
      "start": 8759.96,
      "end": 8761.34,
      "formatted_start": "02:25:59.960",
      "formatted_end": "02:26:01.340",
      "text": "برسی مردم"
    },
    {
      "id": 15,
      "start": 8761.34,
      "end": 8762.04,
      "formatted_start": "02:26:01.340",
      "formatted_end": "02:26:02.040",
      "text": "مردم"
    },
    {
      "id": 16,
      "start": 8762.04,
      "end": 8771.04,
      "formatted_start": "02:26:02.040",
      "formatted_end": "02:26:11.040",
      "text": "از این درم خودش بیاد توی نه؟"
    },
    {
      "id": 17,
      "start": 8771.04,
      "end": 8772.4,
      "formatted_start": "02:26:11.040",
      "formatted_end": "02:26:12.400",
      "text": "آره خودش بیاد توی نه"
    },
    {
      "id": 18,
      "start": 8772.4,
      "end": 8774.62,
      "formatted_start": "02:26:12.400",
      "formatted_end": "02:26:14.620",
      "text": "برسی منیست خودش بیاد باشی"
    },
    {
      "id": 19,
      "start": 8774.62,
      "end": 8775.82,
      "formatted_start": "02:26:14.620",
      "formatted_end": "02:26:15.820",
      "text": "کامل همین"
    },
    {
      "id": 20,
      "start": 8775.82,
      "end": 8785.82,
      "formatted_start": "02:26:15.820",
      "formatted_end": "02:26:25.820",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 8805.82,
      "end": 8808.82,
      "formatted_start": "02:26:45.820",
      "formatted_end": "02:26:48.820",
      "text": "نه بلچین نه اینو داری"
    },
    {
      "id": 22,
      "start": 8810.82,
      "end": 8814.82,
      "formatted_start": "02:26:50.820",
      "formatted_end": "02:26:54.820",
      "text": "خب، گرده چربی یک به دو چند ساله تونه؟"
    },
    {
      "id": 23,
      "start": 8814.82,
      "end": 8815.82,
      "formatted_start": "02:26:54.820",
      "formatted_end": "02:26:55.820",
      "text": "چه روز"
    },
    {
      "id": 24,
      "start": 8815.82,
      "end": 8816.82,
      "formatted_start": "02:26:55.820",
      "formatted_end": "02:26:56.820",
      "text": "چه روز؟"
    },
    {
      "id": 25,
      "start": 8816.82,
      "end": 8820.82,
      "formatted_start": "02:26:56.820",
      "formatted_end": "02:27:00.820",
      "text": "اون سینا تدکیه که قلب مزدکه"
    },
    {
      "id": 26,
      "start": 8820.82,
      "end": 8822.82,
      "formatted_start": "02:27:00.820",
      "formatted_end": "02:27:02.820",
      "text": "غذای چربو چه روزه؟"
    },
    {
      "id": 27,
      "start": 8822.82,
      "end": 8823.82,
      "formatted_start": "02:27:02.820",
      "formatted_end": "02:27:03.820",
      "text": "اینو میکنه"
    },
    {
      "id": 28,
      "start": 8823.82,
      "end": 8830.82,
      "formatted_start": "02:27:03.820",
      "formatted_end": "02:27:10.820",
      "text": "نخو، دخونه، آجی، فاسفو، دو شابه، دلسته، قلبهای ساده"
    },
    {
      "id": 29,
      "start": 8830.82,
      "end": 8834.82,
      "formatted_start": "02:27:10.820",
      "formatted_end": "02:27:14.820",
      "text": "این تهرون که تو باید زیاد کنی پیاده روی داشته باشه در من کمی چرده"
    },
    {
      "id": 30,
      "start": 8834.82,
      "end": 8837.82,
      "formatted_start": "02:27:14.820",
      "formatted_end": "02:27:17.820",
      "text": "از اینجا برزش شروع کردم یکی درمانه"
    },
    {
      "id": 31,
      "start": 8837.82,
      "end": 8840.82,
      "formatted_start": "02:27:17.820",
      "formatted_end": "02:27:20.820",
      "text": "تره لایف استایل زندگیت برزش"
    },
    {
      "id": 32,
      "start": 8840.82,
      "end": 8844.82,
      "formatted_start": "02:27:20.820",
      "formatted_end": "02:27:24.820",
      "text": "نصف برنکارش با قطعه مصنوعی"
    },
    {
      "id": 33,
      "start": 8844.82,
      "end": 8846.82,
      "formatted_start": "02:27:24.820",
      "formatted_end": "02:27:26.820",
      "text": "چردی اشباه"
    },
    {
      "id": 34,
      "start": 8846.82,
      "end": 8849.82,
      "formatted_start": "02:27:26.820",
      "formatted_end": "02:27:29.820",
      "text": "تنها چیز که چطورا یکم سال چده میتونه کمک کنه"
    },
    {
      "id": 35,
      "start": 8849.82,
      "end": 8851.82,
      "formatted_start": "02:27:29.820",
      "formatted_end": "02:27:31.820",
      "text": "قهر و یک فرنون در مستقبل"
    },
    {
      "id": 36,
      "start": 8851.82,
      "end": 8855.82,
      "formatted_start": "02:27:31.820",
      "formatted_end": "02:27:35.820",
      "text": "اگر که تقویش قلبوی آرده این نامداد وزیر کنه"
    },
    {
      "id": 37,
      "start": 8855.82,
      "end": 8858.82,
      "formatted_start": "02:27:35.820",
      "formatted_end": "02:27:38.820",
      "text": "نه نمی کنم اما خب استفاده نمی کرده"
    },
    {
      "id": 38,
      "start": 8858.82,
      "end": 8860.82,
      "formatted_start": "02:27:38.820",
      "formatted_end": "02:27:40.820",
      "text": "اگر خوبه این استفاده نمی کنه"
    },
    {
      "id": 39,
      "start": 8860.82,
      "end": 8862.82,
      "formatted_start": "02:27:40.820",
      "formatted_end": "02:27:42.820",
      "text": "برای کبز خوبه"
    },
    {
      "id": 40,
      "start": 8862.82,
      "end": 8864.82,
      "formatted_start": "02:27:42.820",
      "formatted_end": "02:27:44.820",
      "text": "باید برس کنید. بچه ها باید مانده."
    },
    {
      "id": 41,
      "start": 8866.82,
      "end": 8868.82,
      "formatted_start": "02:27:46.820",
      "formatted_end": "02:27:48.820",
      "text": "سنسه با همه بی کم بزرگه."
    },
    {
      "id": 42,
      "start": 8868.82,
      "end": 8870.82,
      "formatted_start": "02:27:48.820",
      "formatted_end": "02:27:50.820",
      "text": "باید برس کنید."
    },
    {
      "id": 43,
      "start": 8872.82,
      "end": 8874.82,
      "formatted_start": "02:27:52.820",
      "formatted_end": "02:27:54.820",
      "text": "بچه داری؟"
    },
    {
      "id": 44,
      "start": 8874.82,
      "end": 8876.82,
      "formatted_start": "02:27:54.820",
      "formatted_end": "02:27:56.820",
      "text": "بروید تا سپس بکنید."
    },
    {
      "id": 45,
      "start": 8876.82,
      "end": 8878.82,
      "formatted_start": "02:27:56.820",
      "formatted_end": "02:27:58.820",
      "text": "نه نه نه. یک توضیح براتون میدونم."
    },
    {
      "id": 46,
      "start": 8878.82,
      "end": 8880.82,
      "formatted_start": "02:27:58.820",
      "formatted_end": "02:28:00.820",
      "text": "اول که این سنور رو گفت، یه درد خیلی عجبی."
    },
    {
      "id": 47,
      "start": 8880.82,
      "end": 8882.82,
      "formatted_start": "02:28:00.820",
      "formatted_end": "02:28:02.820",
      "text": "اینجا هم موفقه بود."
    },
    {
      "id": 48,
      "start": 8882.82,
      "end": 8884.82,
      "formatted_start": "02:28:02.820",
      "formatted_end": "02:28:04.820",
      "text": "عدود اردم دو ماهه."
    },
    {
      "id": 49,
      "start": 8884.82,
      "end": 8886.82,
      "formatted_start": "02:28:04.820",
      "formatted_end": "02:28:06.820",
      "text": "مثلا این درخواه مثلا ساعت"
    },
    {
      "id": 50,
      "start": 8886.82,
      "end": 8888.82,
      "formatted_start": "02:28:06.820",
      "formatted_end": "02:28:08.820",
      "text": "۷-۸ ساعت مثلا توی ماشین"
    },
    {
      "id": 51,
      "start": 8888.82,
      "end": 8894.82,
      "formatted_start": "02:28:08.820",
      "formatted_end": "02:28:14.820",
      "text": "این درده اینقدر شدتش سیار بشه که اینکه ها سنگ و کلیه داریم در این حده"
    },
    {
      "id": 52,
      "start": 8894.82,
      "end": 8898.82,
      "formatted_start": "02:28:14.820",
      "formatted_end": "02:28:18.820",
      "text": "که دیگه به خاطر من این گفتم که چیز سنو انجام دارم"
    },
    {
      "id": 53,
      "start": 8898.82,
      "end": 8907.82,
      "formatted_start": "02:28:18.820",
      "formatted_end": "02:28:27.820",
      "text": "بعد یک ماه دو ماه پیش یه امرهای رنگی انجام دادم"
    },
    {
      "id": 54,
      "start": 8907.82,
      "end": 8910.82,
      "formatted_start": "02:28:27.820",
      "formatted_end": "02:28:30.820",
      "text": "با آزمایش دادم که دیش کنون توی بیچ هم نشون دارده"
    },
    {
      "id": 55,
      "start": 8910.82,
      "end": 8914.82,
      "formatted_start": "02:28:30.820",
      "formatted_end": "02:28:34.820",
      "text": "نه دیست نشون داره نه آزمایش هم نشون داره"
    },
    {
      "id": 56,
      "start": 8914.82,
      "end": 8917.82,
      "formatted_start": "02:28:34.820",
      "formatted_end": "02:28:37.820",
      "text": "اینکه آزمایش همه"
    },
    {
      "id": 57,
      "start": 8926.82,
      "end": 8930.82,
      "formatted_start": "02:28:46.820",
      "formatted_end": "02:28:50.820",
      "text": "من بعد از سزاریانی که انجام دادم"
    },
    {
      "id": 58,
      "start": 8932.82,
      "end": 8933.82,
      "formatted_start": "02:28:52.820",
      "formatted_end": "02:28:53.820",
      "text": "هشت ماه"
    },
    {
      "id": 59,
      "start": 8933.82,
      "end": 8934.82,
      "formatted_start": "02:28:53.820",
      "formatted_end": "02:28:54.820",
      "text": "میازون بود خیلی پایینه"
    },
    {
      "id": 60,
      "start": 8934.82,
      "end": 8936.82,
      "formatted_start": "02:28:54.820",
      "formatted_end": "02:28:56.820",
      "text": "برگرد میشه با تو خود"
    },
    {
      "id": 61,
      "start": 8936.82,
      "end": 8937.82,
      "formatted_start": "02:28:56.820",
      "formatted_end": "02:28:57.820",
      "text": "من برگرد باشم"
    },
    {
      "id": 62,
      "start": 8937.82,
      "end": 8938.82,
      "formatted_start": "02:28:57.820",
      "formatted_end": "02:28:58.820",
      "text": "خیلی خوب"
    },
    {
      "id": 63,
      "start": 8938.82,
      "end": 8939.82,
      "formatted_start": "02:28:58.820",
      "formatted_end": "02:28:59.820",
      "text": "خیلی خوب"
    },
    {
      "id": 64,
      "start": 8939.82,
      "end": 8940.82,
      "formatted_start": "02:28:59.820",
      "formatted_end": "02:29:00.820",
      "text": "خیلی خوب"
    },
    {
      "id": 65,
      "start": 8940.82,
      "end": 8941.82,
      "formatted_start": "02:29:00.820",
      "formatted_end": "02:29:01.820",
      "text": "خیلی خوب"
    },
    {
      "id": 66,
      "start": 8941.82,
      "end": 8942.82,
      "formatted_start": "02:29:01.820",
      "formatted_end": "02:29:02.820",
      "text": "خیلی خوب"
    },
    {
      "id": 67,
      "start": 8942.82,
      "end": 8943.82,
      "formatted_start": "02:29:02.820",
      "formatted_end": "02:29:03.820",
      "text": "خیلی خوب"
    },
    {
      "id": 68,
      "start": 8943.82,
      "end": 8949.82,
      "formatted_start": "02:29:03.820",
      "formatted_end": "02:29:09.820",
      "text": "و میخوای خودش رو هم گرفته گه از وقت اون موقع میکنه و بس گفته بینیش"
    },
    {
      "id": 69,
      "start": 8949.82,
      "end": 8956.82,
      "formatted_start": "02:29:09.820",
      "formatted_end": "02:29:16.820",
      "text": "پشت ما بعد از سزاریانم، من پریود که میشم، پریودیان همینطور ادامه داره"
    },
    {
      "id": 70,
      "start": 8956.82,
      "end": 8960.82,
      "formatted_start": "02:29:16.820",
      "formatted_end": "02:29:20.820",
      "text": "یعنی تا 20 روز اینا طول میکشه"
    },
    {
      "id": 71,
      "start": 8960.82,
      "end": 8967.82,
      "formatted_start": "02:29:20.820",
      "formatted_end": "02:29:27.820",
      "text": "نه مثلا شدتش بگم خیلی زیاده اما دارم یعنی شروطم خوشنگ دیگه آلوده میشه دیگه هر سری"
    },
    {
      "id": 72,
      "start": 8967.82,
      "end": 8971.82,
      "formatted_start": "02:29:27.820",
      "formatted_end": "02:29:31.820",
      "text": "بعد رفتم سونگرافی که انجام دادم"
    },
    {
      "id": 73,
      "start": 8971.82,
      "end": 8975.82,
      "formatted_start": "02:29:31.820",
      "formatted_end": "02:29:35.820",
      "text": "از چند مرحله سونگیرافی به من گفتند که"
    },
    {
      "id": 74,
      "start": 8975.82,
      "end": 8979.82,
      "formatted_start": "02:29:35.820",
      "formatted_end": "02:29:39.820",
      "text": "سلسل داریان اینکه انجام شده یه هفره ایجاد شده"
    },
    {
      "id": 75,
      "start": 8979.82,
      "end": 8981.82,
      "formatted_start": "02:29:39.820",
      "formatted_end": "02:29:41.820",
      "text": "این بعد از هفت روز میاد"
    },
    {
      "id": 76,
      "start": 8981.82,
      "end": 8983.82,
      "formatted_start": "02:29:41.820",
      "formatted_end": "02:29:43.820",
      "text": "اون خونلیزی که اونجا جمع میشه تو هفره"
    },
    {
      "id": 77,
      "start": 8983.82,
      "end": 8985.82,
      "formatted_start": "02:29:43.820",
      "formatted_end": "02:29:45.820",
      "text": "بعد از هفت روز میاد تقریه میشه"
    },
    {
      "id": 78,
      "start": 8985.82,
      "end": 8987.82,
      "formatted_start": "02:29:45.820",
      "formatted_end": "02:29:47.820",
      "text": "اون همچین چیزی همونگو"
    },
    {
      "id": 79,
      "start": 8987.82,
      "end": 8990.82,
      "formatted_start": "02:29:47.820",
      "formatted_end": "02:29:50.820",
      "text": "خب باید یه عوض کنید فلان کنید"
    },
    {
      "id": 80,
      "start": 8990.82,
      "end": 8992.82,
      "formatted_start": "02:29:50.820",
      "formatted_end": "02:29:52.820",
      "text": "یا باید رحمتو کامل لرم بیارید"
    },
    {
      "id": 81,
      "start": 8992.82,
      "end": 8994.82,
      "formatted_start": "02:29:52.820",
      "formatted_end": "02:29:54.820",
      "text": "چی عوض کنید؟"
    },
    {
      "id": 82,
      "start": 8994.82,
      "end": 8996.82,
      "formatted_start": "02:29:54.820",
      "formatted_end": "02:29:56.820",
      "text": "تهران تو میشینم رستم پیش دو سال"
    },
    {
      "id": 83,
      "start": 8996.82,
      "end": 8999.06,
      "formatted_start": "02:29:56.820",
      "formatted_end": "02:29:59.060",
      "text": "تو بقیه تل داره افزا"
    }
  ],
  "status": "completed"
}