  "stt_segments": [
    {
      "id": 0,
      "start": 23700.0,
      "end": 23730.0,
      "formatted_start": "06:35:00.000",
      "formatted_end": "06:35:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 23730.0,
      "end": 23732.0,
      "formatted_start": "06:35:30.000",
      "formatted_end": "06:35:32.000",
      "text": "فقط دشتاده بودم"
    },
    {
      "id": 2,
      "start": 23734.0,
      "end": 23736.0,
      "formatted_start": "06:35:34.000",
      "formatted_end": "06:35:36.000",
      "text": "اصلا متممه متممه محسن"
    },
    {
      "id": 3,
      "start": 23736.0,
      "end": 23738.0,
      "formatted_start": "06:35:36.000",
      "formatted_end": "06:35:38.000",
      "text": "اینکه من بودم"
    },
    {
      "id": 4,
      "start": 23738.0,
      "end": 23740.0,
      "formatted_start": "06:35:38.000",
      "formatted_end": "06:35:40.000",
      "text": "نمی بینم چون"
    },
    {
      "id": 5,
      "start": 23740.0,
      "end": 23742.0,
      "formatted_start": "06:35:40.000",
      "formatted_end": "06:35:42.000",
      "text": "چون نمیتونم فراموش میکنم"
    },
    {
      "id": 6,
      "start": 23742.0,
      "end": 23744.0,
      "formatted_start": "06:35:42.000",
      "formatted_end": "06:35:44.000",
      "text": "ایتامیتیشم آینه"
    },
    {
      "id": 7,
      "start": 23746.0,
      "end": 23748.0,
      "formatted_start": "06:35:46.000",
      "formatted_end": "06:35:48.000",
      "text": "آهنم که موقعی پریادش از من بکرده"
    },
    {
      "id": 8,
      "start": 23748.0,
      "end": 23750.0,
      "formatted_start": "06:35:48.000",
      "formatted_end": "06:35:50.000",
      "text": "حداقل"
    },
    {
      "id": 9,
      "start": 23750.0,
      "end": 23752.0,
      "formatted_start": "06:35:50.000",
      "formatted_end": "06:35:52.000",
      "text": "نرماله"
    },
    {
      "id": 10,
      "start": 23752.0,
      "end": 23754.0,
      "formatted_start": "06:35:52.000",
      "formatted_end": "06:35:54.000",
      "text": "در مورد داشت مرشونه نیستم"
    },
    {
      "id": 11,
      "start": 23754.0,
      "end": 23756.0,
      "formatted_start": "06:35:54.000",
      "formatted_end": "06:35:56.000",
      "text": "اگه خوب نشد باش"
    },
    {
      "id": 12,
      "start": 23756.0,
      "end": 23758.0,
      "formatted_start": "06:35:56.000",
      "formatted_end": "06:35:58.000",
      "text": "بعدی بیاید این رو تو رسامون تکرار کنم"
    },
    {
      "id": 13,
      "start": 23760.0,
      "end": 23790.0,
      "formatted_start": "06:36:00.000",
      "formatted_end": "06:36:30.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 14,
      "start": 23790.0,
      "end": 23799.0,
      "formatted_start": "06:36:30.000",
      "formatted_end": "06:36:39.000",
      "text": "باید مثلا شکرم در میره و بعدش میشه"
    },
    {
      "id": 15,
      "start": 23799.0,
      "end": 23801.0,
      "formatted_start": "06:36:39.000",
      "formatted_end": "06:36:41.000",
      "text": "با استرس بدتر نمیشه؟"
    },
    {
      "id": 16,
      "start": 23801.0,
      "end": 23802.0,
      "formatted_start": "06:36:41.000",
      "formatted_end": "06:36:42.000",
      "text": "چی؟"
    },
    {
      "id": 17,
      "start": 23802.0,
      "end": 23804.0,
      "formatted_start": "06:36:42.000",
      "formatted_end": "06:36:44.000",
      "text": "با استرس بدتر نمیشه؟"
    },
    {
      "id": 18,
      "start": 23804.0,
      "end": 23806.0,
      "formatted_start": "06:36:44.000",
      "formatted_end": "06:36:46.000",
      "text": "نمیشه"
    },
    {
      "id": 19,
      "start": 23806.0,
      "end": 23808.0,
      "formatted_start": "06:36:46.000",
      "formatted_end": "06:36:48.000",
      "text": "ببین خوب و باد"
    },
    {
      "id": 20,
      "start": 23808.0,
      "end": 23812.0,
      "formatted_start": "06:36:48.000",
      "formatted_end": "06:36:52.000",
      "text": "من دروهاشو منیسم، سنوشو منیسم، سنوشو زیاد تکرار نکن"
    },
    {
      "id": 21,
      "start": 23812.0,
      "end": 23817.0,
      "formatted_start": "06:36:52.000",
      "formatted_end": "06:36:57.000",
      "text": "شب کن، میشه همه لوده عصبی میخوره، خیلی هم تأثیر نداره در سنو"
    },
    {
      "id": 22,
      "start": 23817.0,
      "end": 23819.0,
      "formatted_start": "06:36:57.000",
      "formatted_end": "06:36:59.000",
      "text": "اگر تون رو ده عصبی باشه"
    },
    {
      "id": 23,
      "start": 23819.0,
      "end": 23822.0,
      "formatted_start": "06:36:59.000",
      "formatted_end": "06:37:02.000",
      "text": "بعد فرصان رو فعلا اصلا بهش نده"
    },
    {
      "id": 24,
      "start": 23822.0,
      "end": 23824.0,
      "formatted_start": "06:37:02.000",
      "formatted_end": "06:37:04.000",
      "text": "بذار خشنگ شرایطش خوب بشه"
    },
    {
      "id": 25,
      "start": 23824.0,
      "end": 23826.0,
      "formatted_start": "06:37:04.000",
      "formatted_end": "06:37:06.000",
      "text": "بعد فرصان بخوره"
    },
    {
      "id": 26,
      "start": 23826.0,
      "end": 23828.0,
      "formatted_start": "06:37:06.000",
      "formatted_end": "06:37:08.000",
      "text": "دارو که بهش نمشتم"
    },
    {
      "id": 27,
      "start": 23828.0,
      "end": 23830.0,
      "formatted_start": "06:37:08.000",
      "formatted_end": "06:37:10.000",
      "text": "داروش رو بخوره"
    },
    {
      "id": 28,
      "start": 23830.0,
      "end": 23834.0,
      "formatted_start": "06:37:10.000",
      "formatted_end": "06:37:14.000",
      "text": "پوبوبات، سیبزمینی، مکارانی ایناها نخوره اصلا"
    },
    {
      "id": 29,
      "start": 23834.0,
      "end": 23838.0,
      "formatted_start": "06:37:14.000",
      "formatted_end": "06:37:18.000",
      "text": "یه مدت اینا رایت کن ببین چطور میشه"
    },
    {
      "id": 30,
      "start": 23838.0,
      "end": 23843.0,
      "formatted_start": "06:37:18.000",
      "formatted_end": "06:37:23.000",
      "text": "این الان درد هم بگم شاید مثلا ماهیه باید اینجوری میشه"
    },
    {
      "id": 31,
      "start": 23843.0,
      "end": 23845.0,
      "formatted_start": "06:37:23.000",
      "formatted_end": "06:37:25.000",
      "text": "همینیم که این رو ده عصبیه"
    },
    {
      "id": 32,
      "start": 23845.0,
      "end": 23855.0,
      "formatted_start": "06:37:25.000",
      "formatted_end": "06:37:35.000",
      "text": "اصابه ایه چیزی نیست. سمروم روده اصابه ایه. برامی درداش اینقدر شدیده. چون اسباسمند خیلی شدید و روده میده که عرق میشه و دردش خیلی شدیده."
    },
    {
      "id": 33,
      "start": 23855.0,
      "end": 23859.0,
      "formatted_start": "06:37:35.000",
      "formatted_end": "06:37:39.000",
      "text": "از این مدرسه در روده میشه. این صورت باشه."
    },
    {
      "id": 34,
      "start": 23859.0,
      "end": 23862.0,
      "formatted_start": "06:37:39.000",
      "formatted_end": "06:37:42.000",
      "text": "موالد آرزی نیست؟"
    },
    {
      "id": 35,
      "start": 23862.0,
      "end": 23867.0,
      "formatted_start": "06:37:42.000",
      "formatted_end": "06:37:47.000",
      "text": "۳۹۱۱۷، ۷۹۵، ۹۴۰۰"
    },
    {
      "id": 36,
      "start": 23867.0,
      "end": 23869.0,
      "formatted_start": "06:37:47.000",
      "formatted_end": "06:37:49.000",
      "text": "بیماره خواستی نداری؟"
    },
    {
      "id": 37,
      "start": 23869.0,
      "end": 23871.0,
      "formatted_start": "06:37:49.000",
      "formatted_end": "06:37:51.000",
      "text": "نه، نه خواستی نیست."
    },
    {
      "id": 38,
      "start": 23875.0,
      "end": 23877.0,
      "formatted_start": "06:37:55.000",
      "formatted_end": "06:37:57.000",
      "text": "مردم در اینجا باید باید برداری کنید."
    },
    {
      "id": 39,
      "start": 23877.0,
      "end": 23879.0,
      "formatted_start": "06:37:57.000",
      "formatted_end": "06:37:59.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 40,
      "start": 23879.0,
      "end": 23881.0,
      "formatted_start": "06:37:59.000",
      "formatted_end": "06:38:01.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 41,
      "start": 23881.0,
      "end": 23883.0,
      "formatted_start": "06:38:01.000",
      "formatted_end": "06:38:03.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 42,
      "start": 23883.0,
      "end": 23885.0,
      "formatted_start": "06:38:03.000",
      "formatted_end": "06:38:05.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 43,
      "start": 23885.0,
      "end": 23887.0,
      "formatted_start": "06:38:05.000",
      "formatted_end": "06:38:07.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 44,
      "start": 23887.0,
      "end": 23889.0,
      "formatted_start": "06:38:07.000",
      "formatted_end": "06:38:09.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 45,
      "start": 23889.0,
      "end": 23891.0,
      "formatted_start": "06:38:09.000",
      "formatted_end": "06:38:11.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 46,
      "start": 23891.0,
      "end": 23893.0,
      "formatted_start": "06:38:11.000",
      "formatted_end": "06:38:13.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 47,
      "start": 23893.0,
      "end": 23895.0,
      "formatted_start": "06:38:13.000",
      "formatted_end": "06:38:15.000",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 48,
      "start": 23895.0,
      "end": 23925.0,
      "formatted_start": "06:38:15.000",
      "formatted_end": "06:38:45.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 49,
      "start": 23925.0,
      "end": 23941.0,
      "formatted_start": "06:38:45.000",
      "formatted_end": "06:39:01.000",
      "text": "موسیقی"
    },
    {
      "id": 50,
      "start": 23985.0,
      "end": 23987.0,
      "formatted_start": "06:39:45.000",
      "formatted_end": "06:39:47.000",
      "text": "و از این سیره دورو بزنند"
    },
    {
      "id": 51,
      "start": 23987.0,
      "end": 23989.0,
      "formatted_start": "06:39:47.000",
      "formatted_end": "06:39:49.000",
      "text": "اگر یک سیره دورو کاندلتوری خرید کنند"
    },
    {
      "id": 52,
      "start": 23989.0,
      "end": 23991.0,
      "formatted_start": "06:39:49.000",
      "formatted_end": "06:39:51.000",
      "text": "و خیلی خوب استفاده کنند"
    },
    {
      "id": 53,
      "start": 23991.0,
      "end": 23993.0,
      "formatted_start": "06:39:51.000",
      "formatted_end": "06:39:53.000",
      "text": "این سیره را بگویم دوستش قریب استفاده کنند"
    },
    {
      "id": 54,
      "start": 23993.0,
      "end": 23995.0,
      "formatted_start": "06:39:53.000",
      "formatted_end": "06:39:55.000",
      "text": "کارتونش را زیاد کرده"
    },
    {
      "id": 55,
      "start": 23995.0,
      "end": 23997.0,
      "formatted_start": "06:39:55.000",
      "formatted_end": "06:39:57.000",
      "text": "آره"
    },
    {
      "id": 56,
      "start": 23997.0,
      "end": 23999.0,
      "formatted_start": "06:39:57.000",
      "formatted_end": "06:39:59.000",
      "text": "این تشکیل کاندلتوری دورش"
    },
    {
      "id": 57,
      "start": 23999.0,
      "end": 24001.0,
      "formatted_start": "06:39:59.000",
      "formatted_end": "06:40:01.000",
      "text": "کارتونش چی است؟"
    }
