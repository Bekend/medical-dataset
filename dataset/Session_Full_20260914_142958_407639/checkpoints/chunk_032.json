  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9603.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:03.000",
      "text": "اگر بیمار بیمار در مطب پزشکی، باید بگوید که اینجوری کودومدی را درست دارد."
    },
    {
      "id": 1,
      "start": 9603.0,
      "end": 9606.0,
      "formatted_start": "02:40:03.000",
      "formatted_end": "02:40:06.000",
      "text": "بچه اونها که وارد کردن تو سیستمشت را باید دارند."
    },
    {
      "id": 2,
      "start": 9606.0,
      "end": 9610.0,
      "formatted_start": "02:40:06.000",
      "formatted_end": "02:40:10.000",
      "text": "اون روز همین خانمه دیگه با همجوری که در رادیو داشته میکنند، همکیه."
    },
    {
      "id": 3,
      "start": 9610.0,
      "end": 9613.0,
      "formatted_start": "02:40:10.000",
      "formatted_end": "02:40:13.000",
      "text": "تو رادیو داشته میکنند، دقیقا."
    },
    {
      "id": 4,
      "start": 9613.0,
      "end": 9618.0,
      "formatted_start": "02:40:13.000",
      "formatted_end": "02:40:18.000",
      "text": "از سه تا مریض هم همجوری باید سختی پیدا میکنند."
    },
    {
      "id": 5,
      "start": 9618.0,
      "end": 9631.2,
      "formatted_start": "02:40:18.000",
      "formatted_end": "02:40:31.200",
      "text": "با هر وقت بکترین رفتی بخوای پیدا کنید بگو اونجا 6000 و 6000"
    },
    {
      "id": 6,
      "start": 9631.2,
      "end": 9661.2,
      "formatted_start": "02:40:31.200",
      "formatted_end": "02:41:01.200",
      "text": "برای اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که"
    },
    {
      "id": 7,
      "start": 9661.2,
      "end": 9691.2,
      "formatted_start": "02:41:01.200",
      "formatted_end": "02:41:31.200",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 8,
      "start": 9691.2,
      "end": 9693.2,
      "formatted_start": "02:41:31.200",
      "formatted_end": "02:41:33.200",
      "text": "خوش نمیشه"
    },
    {
      "id": 9,
      "start": 9693.2,
      "end": 9695.2,
      "formatted_start": "02:41:33.200",
      "formatted_end": "02:41:35.200",
      "text": "هر صد خورد"
    },
    {
      "id": 10,
      "start": 9695.2,
      "end": 9697.2,
      "formatted_start": "02:41:35.200",
      "formatted_end": "02:41:37.200",
      "text": "سر سر نمیشه"
    },
    {
      "id": 11,
      "start": 9697.2,
      "end": 9699.2,
      "formatted_start": "02:41:37.200",
      "formatted_end": "02:41:39.200",
      "text": "سر خوش بشن"
    },
    {
      "id": 12,
      "start": 9713.2,
      "end": 9715.2,
      "formatted_start": "02:41:53.200",
      "formatted_end": "02:41:55.200",
      "text": "بگو یه دقیقه بزنم بشه بگم"
    },
    {
      "id": 13,
      "start": 9715.2,
      "end": 9717.2,
      "formatted_start": "02:41:55.200",
      "formatted_end": "02:41:57.200",
      "text": "بلاشتشون"
    },
    {
      "id": 14,
      "start": 9717.2,
      "end": 9719.2,
      "formatted_start": "02:41:57.200",
      "formatted_end": "02:41:59.200",
      "text": "خام قرارداری درخواستشون که یه خام دختر کار کنه"
    },
    {
      "id": 15,
      "start": 9719.2,
      "end": 9721.2,
      "formatted_start": "02:41:59.200",
      "formatted_end": "02:42:01.200",
      "text": "بردی؟ بله"
    },
    {
      "id": 16,
      "start": 9725.2,
      "end": 9727.2,
      "formatted_start": "02:42:05.200",
      "formatted_end": "02:42:07.200",
      "text": "سلام خوبی هستی؟ خوبی هستی"
    },
    {
      "id": 17,
      "start": 9727.2,
      "end": 9728.2,
      "formatted_start": "02:42:07.200",
      "formatted_end": "02:42:08.200",
      "text": "خوشی هست"
    },
    {
      "id": 18,
      "start": 9728.2,
      "end": 9731.2,
      "formatted_start": "02:42:08.200",
      "formatted_end": "02:42:11.200",
      "text": "ببین مایه خود ملیتون اینکه شیش اضافه وارد کردن"
    },
    {
      "id": 19,
      "start": 9731.2,
      "end": 9733.2,
      "formatted_start": "02:42:11.200",
      "formatted_end": "02:42:13.200",
      "text": "اگه یک وقت دکتور دیگه وارد باشه"
    },
    {
      "id": 20,
      "start": 9733.2,
      "end": 9735.2,
      "formatted_start": "02:42:13.200",
      "formatted_end": "02:42:15.200",
      "text": "ما با اسمت پیدا کردیم"
    },
    {
      "id": 21,
      "start": 9735.2,
      "end": 9736.2,
      "formatted_start": "02:42:15.200",
      "formatted_end": "02:42:16.200",
      "text": "خب"
    },
    {
      "id": 22,
      "start": 9736.2,
      "end": 9738.2,
      "formatted_start": "02:42:16.200",
      "formatted_end": "02:42:18.200",
      "text": "بعد سیتیتون که همو آسمه"
    },
    {
      "id": 23,
      "start": 9738.2,
      "end": 9739.2,
      "formatted_start": "02:42:18.200",
      "formatted_end": "02:42:19.200",
      "text": "آسمه"
    },
    {
      "id": 24,
      "start": 9739.2,
      "end": 9741.2,
      "formatted_start": "02:42:19.200",
      "formatted_end": "02:42:21.200",
      "text": "چیز اضافه ای در جان نیست خب"
    },
    {
      "id": 25,
      "start": 9741.2,
      "end": 9742.2,
      "formatted_start": "02:42:21.200",
      "formatted_end": "02:42:22.200",
      "text": "خب"
    },
    {
      "id": 26,
      "start": 9742.2,
      "end": 9745.2,
      "formatted_start": "02:42:22.200",
      "formatted_end": "02:42:25.200",
      "text": "فقط چیزی که هست اینکه شما یک روی قلب باید بشین"
    },
    {
      "id": 27,
      "start": 9745.2,
      "end": 9746.2,
      "formatted_start": "02:42:25.200",
      "formatted_end": "02:42:26.200",
      "text": "خب"
    },
    {
      "id": 28,
      "start": 9746.2,
      "end": 9747.2,
      "formatted_start": "02:42:26.200",
      "formatted_end": "02:42:27.200",
      "text": "چرا؟"
    },
    {
      "id": 29,
      "start": 9747.2,
      "end": 9752.44,
      "formatted_start": "02:42:27.200",
      "formatted_end": "02:42:32.440",
      "text": "نه اشکال نداره هر کسی که ریشنجی میشه ممکنه که ریایی یک ذره رو قلب پشار بیاره"
    },
    {
      "id": 30,
      "start": 9752.44,
      "end": 9753.78,
      "formatted_start": "02:42:32.440",
      "formatted_end": "02:42:33.780",
      "text": "هیچ مشکلی هم نداره"
    },
    {
      "id": 31,
      "start": 9753.78,
      "end": 9758.98,
      "formatted_start": "02:42:33.780",
      "formatted_end": "02:42:38.980",
      "text": "بقیه اکو قلب بد بشی اکو تو برو دکتر پایزین میداشت انجام بده"
    },
    {
      "id": 32,
      "start": 9758.98,
      "end": 9764.04,
      "formatted_start": "02:42:38.980",
      "formatted_end": "02:42:44.040",
      "text": "آره میخوام فشار شریان ریعتو مشخص کنه اون خودش میدونه"
    },
    {
      "id": 33,
      "start": 9764.04,
      "end": 9765.82,
      "formatted_start": "02:42:44.040",
      "formatted_end": "02:42:45.820",
      "text": "من آسن دارم"
    },
    {
      "id": 34,
      "start": 9765.82,
      "end": 9767.06,
      "formatted_start": "02:42:45.820",
      "formatted_end": "02:42:47.060",
      "text": "آره اکو همونجا میدونم"
    },
    {
      "id": 35,
      "start": 9767.06,
      "end": 9770.88,
      "formatted_start": "02:42:47.060",
      "formatted_end": "02:42:50.880",
      "text": "آسن دارم دکتر با تو ممکنه رو قلب هم از سر گذاشته باشه اکو میخوام"
    },
    {
      "id": 36,
      "start": 9770.88,
      "end": 9776.34,
      "formatted_start": "02:42:50.880",
      "formatted_end": "02:42:56.340",
      "text": "اون تاین میکنه که آیا چه درصد ریادتون روی قلب از هر گود داشتی و نزده شده خب؟"
    },
    {
      "id": 37,
      "start": 9776.34,
      "end": 9776.84,
      "formatted_start": "02:42:56.340",
      "formatted_end": "02:42:56.840",
      "text": "خب"
    },
    {
      "id": 38,
      "start": 9776.84,
      "end": 9779.84,
      "formatted_start": "02:42:56.840",
      "formatted_end": "02:42:59.840",
      "text": "بعد ممکنه همه یه دارو به داروتون اضافه کنی یا نه"
    },
    {
      "id": 39,
      "start": 9779.84,
      "end": 9781.84,
      "formatted_start": "02:42:59.840",
      "formatted_end": "02:43:01.840",
      "text": "دارواتونو همه رو کامل ببنی"
    },
    {
      "id": 40,
      "start": 9781.84,
      "end": 9782.34,
      "formatted_start": "02:43:01.840",
      "formatted_end": "02:43:02.340",
      "text": "باشی"
    },
    {
      "id": 41,
      "start": 9782.34,
      "end": 9783.84,
      "formatted_start": "02:43:02.340",
      "formatted_end": "02:43:03.840",
      "text": "چون ممکنه به داروتون یه قلب اضافه کنی"
    },
    {
      "id": 42,
      "start": 9783.84,
      "end": 9785.84,
      "formatted_start": "02:43:03.840",
      "formatted_end": "02:43:05.840",
      "text": "پس آسم شدیده ی خفیفه"
    },
    {
      "id": 43,
      "start": 9785.84,
      "end": 9788.84,
      "formatted_start": "02:43:05.840",
      "formatted_end": "02:43:08.840",
      "text": "شدیده خفیفهش با تصد تنفس مشامل میشه"
    },
    {
      "id": 44,
      "start": 9788.84,
      "end": 9790.84,
      "formatted_start": "02:43:08.840",
      "formatted_end": "02:43:10.840",
      "text": "اما آسمتون متوسط تو شدیده"
    },
    {
      "id": 45,
      "start": 9790.84,
      "end": 9791.84,
      "formatted_start": "02:43:10.840",
      "formatted_end": "02:43:11.840",
      "text": "آه"
    },
    {
      "id": 46,
      "start": 9791.84,
      "end": 9792.34,
      "formatted_start": "02:43:11.840",
      "formatted_end": "02:43:12.340",
      "text": "بله"
    },
    {
      "id": 47,
      "start": 9792.34,
      "end": 9795.34,
      "formatted_start": "02:43:12.340",
      "formatted_end": "02:43:15.340",
      "text": "داروهاتون رو به هیچ اما نباید قرار کنید"
    },
    {
      "id": 48,
      "start": 9795.34,
      "end": 9799.34,
      "formatted_start": "02:43:15.340",
      "formatted_end": "02:43:19.340",
      "text": "اگر چیز بهتر نشید باید یکم داروهاتون اضافه کنید"
    },
    {
      "id": 49,
      "start": 9799.34,
      "end": 9802.34,
      "formatted_start": "02:43:19.340",
      "formatted_end": "02:43:22.340",
      "text": "آره اینیت برای صرفه نوشتی کم پنجتایی"
    },
    {
      "id": 50,
      "start": 9802.34,
      "end": 9805.34,
      "formatted_start": "02:43:22.340",
      "formatted_end": "02:43:25.340",
      "text": "تموم شده یک کار کنم از از روش که گیرم"
    },
    {
      "id": 51,
      "start": 9805.34,
      "end": 9808.34,
      "formatted_start": "02:43:25.340",
      "formatted_end": "02:43:28.340",
      "text": "یکی برای شباتو صرفه نوشتیم"
    },
    {
      "id": 52,
      "start": 9808.34,
      "end": 9812.34,
      "formatted_start": "02:43:28.340",
      "formatted_end": "02:43:32.340",
      "text": "باش اون درمان موقعته باید با داروه تنفسی صرفتون خوب بشه"
    },
    {
      "id": 53,
      "start": 9812.34,
      "end": 9815.34,
      "formatted_start": "02:43:32.340",
      "formatted_end": "02:43:35.340",
      "text": "نه با علامتی که بیاد بیدون بر دارو"
    },
    {
      "id": 54,
      "start": 9815.34,
      "end": 9817.34,
      "formatted_start": "02:43:35.340",
      "formatted_end": "02:43:37.340",
      "text": "این آسمتون اینقدر کنترل باشه که صرفه نکنین"
    },
    {
      "id": 55,
      "start": 9817.34,
      "end": 9819.34,
      "formatted_start": "02:43:37.340",
      "formatted_end": "02:43:39.340",
      "text": "صرفه شما آسمتونه"
    },
    {
      "id": 56,
      "start": 9819.34,
      "end": 9821.34,
      "formatted_start": "02:43:39.340",
      "formatted_end": "02:43:41.340",
      "text": "چند سالی میگیره؟"
    },
    {
      "id": 57,
      "start": 9821.34,
      "end": 9823.34,
      "formatted_start": "02:43:41.340",
      "formatted_end": "02:43:43.340",
      "text": "باید داروی دیگه قوی تر شروع کنیم"
    },
    {
      "id": 58,
      "start": 9823.34,
      "end": 9825.34,
      "formatted_start": "02:43:43.340",
      "formatted_end": "02:43:45.340",
      "text": "مثلا یه سری کپسوله داخل دستگاه میذاریم"
    },
    {
      "id": 59,
      "start": 9825.34,
      "end": 9827.34,
      "formatted_start": "02:43:45.340",
      "formatted_end": "02:43:47.340",
      "text": "اگر که جواب نگیریم"
    },
    {
      "id": 60,
      "start": 9827.34,
      "end": 9829.34,
      "formatted_start": "02:43:47.340",
      "formatted_end": "02:43:49.340",
      "text": "باید صبر کنیم"
    },
    {
      "id": 61,
      "start": 9829.34,
      "end": 9831.34,
      "formatted_start": "02:43:49.340",
      "formatted_end": "02:43:51.340",
      "text": "سرسرس نه داروی آسمتونه"
    },
    {
      "id": 62,
      "start": 9831.34,
      "end": 9833.34,
      "formatted_start": "02:43:51.340",
      "formatted_end": "02:43:53.340",
      "text": "دو ماه صبر کنید"
    },
    {
      "id": 63,
      "start": 9833.34,
      "end": 9835.34,
      "formatted_start": "02:43:53.340",
      "formatted_end": "02:43:55.340",
      "text": "بهترش یا نه؟"
    },
    {
      "id": 64,
      "start": 9835.34,
      "end": 9837.34,
      "formatted_start": "02:43:55.340",
      "formatted_end": "02:43:57.340",
      "text": "خب الان ما بهتر دارو دادیم"
    },
    {
      "id": 65,
      "start": 9837.34,
      "end": 9839.34,
      "formatted_start": "02:43:57.340",
      "formatted_end": "02:43:59.340",
      "text": "یه ماه استفاده کن"
    },
    {
      "id": 66,
      "start": 9839.34,
      "end": 9841.34,
      "formatted_start": "02:43:59.340",
      "formatted_end": "02:44:01.340",
      "text": "بهترین شد باز یه داروی دیگه"
    },
    {
      "id": 67,
      "start": 9841.34,
      "end": 9843.34,
      "formatted_start": "02:44:01.340",
      "formatted_end": "02:44:03.340",
      "text": "این آسمتونه که داری صرفه میکنی"
    },
    {
      "id": 68,
      "start": 9843.34,
      "end": 9845.34,
      "formatted_start": "02:44:03.340",
      "formatted_end": "02:44:05.340",
      "text": "صرفه حساسی هست"
    },
    {
      "id": 69,
      "start": 9845.34,
      "end": 9847.34,
      "formatted_start": "02:44:05.340",
      "formatted_end": "02:44:07.340",
      "text": "اینگار گلون یه مشت"
    },
    {
      "id": 70,
      "start": 9847.34,
      "end": 9849.34,
      "formatted_start": "02:44:07.340",
      "formatted_end": "02:44:09.340",
      "text": "چیرکه هم بخواهد بر بر بر بر بر بخواهد"
    },
    {
      "id": 71,
      "start": 9849.34,
      "end": 9851.34,
      "formatted_start": "02:44:09.340",
      "formatted_end": "02:44:11.340",
      "text": "از اینکه وقتی اینجور میکنن"
    },
    {
      "id": 72,
      "start": 9851.34,
      "end": 9853.34,
      "formatted_start": "02:44:11.340",
      "formatted_end": "02:44:13.340",
      "text": "اینگار که داره میخورن"
    },
    {
      "id": 73,
      "start": 9853.34,
      "end": 9855.34,
      "formatted_start": "02:44:13.340",
      "formatted_end": "02:44:15.340",
      "text": "این آسمتون وقت کنترل شد"
    },
    {
      "id": 74,
      "start": 9855.34,
      "end": 9857.34,
      "formatted_start": "02:44:15.340",
      "formatted_end": "02:44:17.340",
      "text": "خب؟ انا انشالله بهتر میشه"
    },
    {
      "id": 75,
      "start": 9857.34,
      "end": 9859.34,
      "formatted_start": "02:44:17.340",
      "formatted_end": "02:44:19.340",
      "text": "اکوه قدر من بگیر چه هر دکتر داروی اضافه کنند"
    },
    {
      "id": 76,
      "start": 9859.34,
      "end": 9861.34,
      "formatted_start": "02:44:19.340",
      "formatted_end": "02:44:21.340",
      "text": "خب؟ یه مقدارش"
    },
    {
      "id": 77,
      "start": 9861.34,
      "end": 9863.34,
      "formatted_start": "02:44:21.340",
      "formatted_end": "02:44:23.340",
      "text": "ممکنه صرفه ناشی است"
    },
    {
      "id": 78,
      "start": 9863.34,
      "end": 9865.34,
      "formatted_start": "02:44:23.340",
      "formatted_end": "02:44:25.340",
      "text": "باید مردت بشیم"
    },
    {
      "id": 79,
      "start": 9865.34,
      "end": 9867.34,
      "formatted_start": "02:44:25.340",
      "formatted_end": "02:44:27.340",
      "text": "همینجور میشه یا نه؟"
    },
    {
      "id": 80,
      "start": 9867.34,
      "end": 9869.34,
      "formatted_start": "02:44:27.340",
      "formatted_end": "02:44:29.340",
      "text": "خواهشفایی همه های میکنه"
    },
    {
      "id": 81,
      "start": 9869.34,
      "end": 9871.34,
      "formatted_start": "02:44:29.340",
      "formatted_end": "02:44:31.340",
      "text": "بگیر زکر بزاره میتونه براتونه ها رو بگیره"
    },
    {
      "id": 82,
      "start": 9871.34,
      "end": 9873.34,
      "formatted_start": "02:44:31.340",
      "formatted_end": "02:44:33.340",
      "text": "خواهشفایی نه بیانم پشت مردت بشیم"
    },
    {
      "id": 83,
      "start": 9873.34,
      "end": 9875.34,
      "formatted_start": "02:44:33.340",
      "formatted_end": "02:44:35.340",
      "text": "مردت استفاده کن"
    },
    {
      "id": 84,
      "start": 9875.34,
      "end": 9877.34,
      "formatted_start": "02:44:35.340",
      "formatted_end": "02:44:37.340",
      "text": "بعد از اینجور مایو بگیریم پیشه"
    },
    {
      "id": 85,
      "start": 9877.34,
      "end": 9879.34,
      "formatted_start": "02:44:37.340",
      "formatted_end": "02:44:39.340",
      "text": "اگر خدا یک اکر مشکل داشتیم به امروز رو تکنی"
    },
    {
      "id": 86,
      "start": 9879.34,
      "end": 9881.34,
      "formatted_start": "02:44:39.340",
      "formatted_end": "02:44:41.340",
      "text": "اشعالا که مشکل نشد"
    },
    {
      "id": 87,
      "start": 9881.34,
      "end": 9883.34,
      "formatted_start": "02:44:41.340",
      "formatted_end": "02:44:43.340",
      "text": "اکر گردی برگردی برگردی"
    },
    {
      "id": 88,
      "start": 9883.34,
      "end": 9885.34,
      "formatted_start": "02:44:43.340",
      "formatted_end": "02:44:45.340",
      "text": "این درد شما خامده را بیدارید؟"
    },
    {
      "id": 89,
      "start": 9885.34,
      "end": 9887.34,
      "formatted_start": "02:44:45.340",
      "formatted_end": "02:44:47.340",
      "text": "درسته پرلوک و دلیل باروز دارید"
    },
    {
      "id": 90,
      "start": 9887.34,
      "end": 9889.34,
      "formatted_start": "02:44:47.340",
      "formatted_end": "02:44:49.340",
      "text": "کبت چربه"
    },
    {
      "id": 91,
      "start": 9889.34,
      "end": 9891.34,
      "formatted_start": "02:44:49.340",
      "formatted_end": "02:44:51.340",
      "text": "خب"
    },
    {
      "id": 92,
      "start": 9891.34,
      "end": 9893.34,
      "formatted_start": "02:44:51.340",
      "formatted_end": "02:44:53.340",
      "text": "کبت که در فیلنگ شما پیشت گریه دور یاسه بودن"
    },
    {
      "id": 93,
      "start": 9893.34,
      "end": 9895.34,
      "formatted_start": "02:44:53.340",
      "formatted_end": "02:44:55.340",
      "text": "خب"
    },
    {
      "id": 94,
      "start": 9895.34,
      "end": 9897.34,
      "formatted_start": "02:44:55.340",
      "formatted_end": "02:44:57.340",
      "text": "از اینکه در خاشه میشن"
    },
    {
      "id": 95,
      "start": 9897.34,
      "end": 9899.34,
      "formatted_start": "02:44:57.340",
      "formatted_end": "02:44:59.340",
      "text": "اشرف کرده"
    },
    {
      "id": 96,
      "start": 9899.34,
      "end": 9901.34,
      "formatted_start": "02:44:59.340",
      "formatted_end": "02:45:01.340",
      "text": "اشرف کرده"
    }
  ],
  "status": "completed"
}