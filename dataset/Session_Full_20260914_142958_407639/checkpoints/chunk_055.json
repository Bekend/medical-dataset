  "stt_segments": [
    {
      "id": 0,
      "start": 16500.0,
      "end": 16506.0,
      "formatted_start": "04:35:00.000",
      "formatted_end": "04:35:06.000",
      "text": "این پرستاد شروع کنید چون از این میترسم که شاشپند بشه. اون مصیبت میشه."
    },
    {
      "id": 1,
      "start": 16506.0,
      "end": 16512.0,
      "formatted_start": "04:35:06.000",
      "formatted_end": "04:35:12.000",
      "text": "چون پرستادش هم از این بخواد اگه سن نمی بزنند، غل نمیشه، خون ریزی زیاد میخواد مریض را عذیب می کند."
    },
    {
      "id": 2,
      "start": 16512.0,
      "end": 16519.0,
      "formatted_start": "04:35:12.000",
      "formatted_end": "04:35:19.000",
      "text": "شما سن را انجام بدید ولی اگه امروز به ما نرسیدید، تا ما هستید، داروها را بگیر شروع کنید."
    },
    {
      "id": 3,
      "start": 16519.0,
      "end": 16523.0,
      "formatted_start": "04:35:19.000",
      "formatted_end": "04:35:23.000",
      "text": "بعد سن، بعد سن هنوان دارو بگیرید؟"
    },
    {
      "id": 4,
      "start": 16523.0,
      "end": 16525.0,
      "formatted_start": "04:35:23.000",
      "formatted_end": "04:35:25.000",
      "text": "آره دارواشو بهشون بده"
    },
    {
      "id": 5,
      "start": 16525.0,
      "end": 16528.0,
      "formatted_start": "04:35:25.000",
      "formatted_end": "04:35:28.000",
      "text": "چون قطعا پرستاتشو اکومت کرد"
    },
    {
      "id": 6,
      "start": 16528.0,
      "end": 16530.0,
      "formatted_start": "04:35:28.000",
      "formatted_end": "04:35:30.000",
      "text": "بعد"
    },
    {
      "id": 7,
      "start": 16530.0,
      "end": 16532.0,
      "formatted_start": "04:35:30.000",
      "formatted_end": "04:35:32.000",
      "text": "کچه زندگی داری؟"
    },
    {
      "id": 8,
      "start": 16532.0,
      "end": 16534.0,
      "formatted_start": "04:35:32.000",
      "formatted_end": "04:35:34.000",
      "text": "سرامت"
    },
    {
      "id": 9,
      "start": 16534.0,
      "end": 16536.0,
      "formatted_start": "04:35:34.000",
      "formatted_end": "04:35:36.000",
      "text": "کسی دادی سرام بزنه بشه"
    },
    {
      "id": 10,
      "start": 16536.0,
      "end": 16537.0,
      "formatted_start": "04:35:36.000",
      "formatted_end": "04:35:37.000",
      "text": "آره سرامت"
    },
    {
      "id": 11,
      "start": 16537.0,
      "end": 16538.0,
      "formatted_start": "04:35:37.000",
      "formatted_end": "04:35:38.000",
      "text": "ده"
    },
    {
      "id": 12,
      "start": 16538.0,
      "end": 16540.0,
      "formatted_start": "04:35:38.000",
      "formatted_end": "04:35:40.000",
      "text": "اون دیگه زبطه دیده"
    },
    {
