  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6329.98,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:29.980",
      "text": "باید بردارو بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6340.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:40.000",
      "text": "این راز گفتم. این راز باشه گفتم. من گفتم شما ببینید. اگه یادت باشه من بهت گفتم که احتمالی که قلبش نارسته باشه خیلی بیاده."
    },
    {
      "id": 2,
      "start": 6340.0,
      "end": 6346.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:46.000",
      "text": "بله اصلا من چند روی سخت نداشتم خب ببینید. بسه انتیکه رفتم گفت بچه توی این موانه مونده. آره."
    },
    {
      "id": 3,
      "start": 6346.0,
      "end": 6352.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:52.000",
      "text": "قلب روشته تا میکنه دیگه روش نکرده. آره دیگه هم بچه هم مونده بوده. خب معلومات جاریم بود ولی خودم خود سرد شد."
    },
    {
      "id": 4,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "خورزی افتاده گفته"
    },
    {
      "id": 5,
      "start": 6354.0,
      "end": 6356.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:56.000",
      "text": "نه خب اینجوری نیستی"
    },
    {
      "id": 6,
      "start": 6356.0,
      "end": 6358.0,
      "formatted_start": "01:45:56.000",
      "formatted_end": "01:45:58.000",
      "text": "خودم خیلی ناراضی هستم"
    },
    {
      "id": 7,
      "start": 6358.0,
      "end": 6361.0,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:01.000",
      "text": "بعد ببین بعضی ها دور اجون همین میشه سخت فرموش شده"
    },
    {
      "id": 8,
      "start": 6361.0,
      "end": 6363.0,
      "formatted_start": "01:46:01.000",
      "formatted_end": "01:46:03.000",
      "text": "بچه ها نیمیده"
    },
    {
      "id": 9,
      "start": 6363.0,
      "end": 6365.0,
      "formatted_start": "01:46:03.000",
      "formatted_end": "01:46:05.000",
      "text": "مادر خب نمیفرم جانویس به دستوپا نمیزنه"
    },
    {
      "id": 10,
      "start": 6365.0,
      "end": 6367.0,
      "formatted_start": "01:46:05.000",
      "formatted_end": "01:46:07.000",
      "text": "بعد سه ماه تو بردن مادر مرده بیمونه"
    },
    {
      "id": 11,
      "start": 6367.0,
      "end": 6369.0,
      "formatted_start": "01:46:07.000",
      "formatted_end": "01:46:09.000",
      "text": "مادر رو فونت بکنه"
    },
    {
      "id": 12,
      "start": 6369.0,
      "end": 6371.0,
      "formatted_start": "01:46:09.000",
      "formatted_end": "01:46:11.000",
      "text": "کم کم ایراد شد"
    },
    {
      "id": 13,
      "start": 6371.0,
      "end": 6373.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:13.000",
      "text": "شما به چونی سخت فرموش شده"
    },
    {
      "id": 14,
      "start": 6373.0,
      "end": 6375.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:15.000",
      "text": "خب من همجوری شده بودی"
    },
    {
      "id": 15,
      "start": 6375.0,
      "end": 6377.0,
      "formatted_start": "01:46:15.000",
      "formatted_end": "01:46:17.000",
      "text": "این تی رفتم و دفت به همگی سه ماهی که رفتم"
    },
    {
      "id": 16,
      "start": 6377.0,
      "end": 6379.0,
      "formatted_start": "01:46:17.000",
      "formatted_end": "01:46:19.000",
      "text": "شما برد خود رو شکر رفتیم"
    },
    {
      "id": 17,
      "start": 6379.0,
      "end": 6383.0,
      "formatted_start": "01:46:19.000",
      "formatted_end": "01:46:23.000",
      "text": "این تی بودم که من در شکرم در خوریدی هیچ چی ندارم"
    },
    {
      "id": 18,
      "start": 6383.0,
      "end": 6385.0,
      "formatted_start": "01:46:23.000",
      "formatted_end": "01:46:25.000",
      "text": "مثلا حال اجتماعی من خوب بود"
    },
    {
      "id": 19,
      "start": 6385.0,
      "end": 6387.0,
      "formatted_start": "01:46:25.000",
      "formatted_end": "01:46:27.000",
      "text": "الان برده یه برد نداشتم"
    },
    {
      "id": 20,
      "start": 6387.0,
      "end": 6389.0,
      "formatted_start": "01:46:27.000",
      "formatted_end": "01:46:29.000",
      "text": "بودم خب خیلی بچه درشگیر شده همه چیش نرماله"
    },
    {
      "id": 21,
      "start": 6389.0,
      "end": 6391.0,
      "formatted_start": "01:46:29.000",
      "formatted_end": "01:46:31.000",
      "text": "چون دارو هم از صرف نیکردم"
    },
    {
      "id": 22,
      "start": 6391.0,
      "end": 6393.0,
      "formatted_start": "01:46:31.000",
      "formatted_end": "01:46:33.000",
      "text": "این تی رو دیگر رو خود نداشت"
    },
    {
      "id": 23,
      "start": 6393.0,
      "end": 6395.0,
      "formatted_start": "01:46:33.000",
      "formatted_end": "01:46:35.000",
      "text": "این شروع در عدد ده باز دنیا بود"
    },
    {
      "id": 24,
      "start": 6395.0,
      "end": 6399.5,
      "formatted_start": "01:46:35.000",
      "formatted_end": "01:46:39.500",
      "text": "قلب به نهانجار مطور نهانجار متوجه شده"
    },
    {
      "id": 25,
      "start": 6399.5,
      "end": 6401.76,
      "formatted_start": "01:46:39.500",
      "formatted_end": "01:46:41.760",
      "text": "قلب از خود از شده به نهانجار شده"
    },
    {
      "id": 26,
      "start": 6401.76,
      "end": 6402.64,
      "formatted_start": "01:46:41.760",
      "formatted_end": "01:46:42.640",
      "text": "این کار خدا است"
    },
    {
      "id": 27,
      "start": 6402.64,
      "end": 6404.6,
      "formatted_start": "01:46:42.640",
      "formatted_end": "01:46:44.600",
      "text": "یک بار بهت این موضوع رو گفتم یادت"
    },
    {
      "id": 28,
      "start": 6404.6,
      "end": 6406.26,
      "formatted_start": "01:46:44.600",
      "formatted_end": "01:46:46.260",
      "text": "گفتم خدا یک کاری میکنه"
    },
    {
      "id": 29,
      "start": 6406.26,
      "end": 6408.64,
      "formatted_start": "01:46:46.260",
      "formatted_end": "01:46:48.640",
      "text": "یعنی قانون طبیعتون هست به میره"
    },
    {
      "id": 30,
      "start": 6408.64,
      "end": 6412.0,
      "formatted_start": "01:46:48.640",
      "formatted_end": "01:46:52.000",
      "text": "پرده شاید هم یه چوری به ما ثابت کرد که"
    },
    {
      "id": 31,
      "start": 6412.0,
      "end": 6413.92,
      "formatted_start": "01:46:52.000",
      "formatted_end": "01:46:53.920",
      "text": "شاید برای آقا یه چوری ثابت کرد"
    },
    {
      "id": 32,
      "start": 6413.92,
      "end": 6414.74,
      "formatted_start": "01:46:53.920",
      "formatted_end": "01:46:54.740",
      "text": "جمعه"
    },
    {
      "id": 33,
      "start": 6414.74,
      "end": 6416.54,
      "formatted_start": "01:46:54.740",
      "formatted_end": "01:46:56.540",
      "text": "اگه خدا از ما چیز کنه"
    },
    {
      "id": 34,
      "start": 6416.54,
      "end": 6418.1,
      "formatted_start": "01:46:56.540",
      "formatted_end": "01:46:58.100",
      "text": "مفوضش کنه"
    },
    {
      "id": 35,
      "start": 6418.1,
      "end": 6420.46,
      "formatted_start": "01:46:58.100",
      "formatted_end": "01:47:00.460",
      "text": "رفتیم که دو بار که مثلا دورو بگیر"
    },
    {
      "id": 36,
      "start": 6420.46,
      "end": 6450.46,
      "formatted_start": "01:47:00.460",
      "formatted_end": "01:47:30.460",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 37,
      "start": 6450.46,
      "end": 6455.92,
      "formatted_start": "01:47:30.460",
      "formatted_end": "01:47:35.920",
      "text": "خب هنوز اون هرمونه جفتی تو خونت بوده این عدد 13 همه گول نباید بزنه ما رو"
    },
    {
      "id": 38,
      "start": 6455.92,
      "end": 6457.42,
      "formatted_start": "01:47:35.920",
      "formatted_end": "01:47:37.420",
      "text": "آره؟"
    },
    {
      "id": 39,
      "start": 6457.42,
      "end": 6459.42,
      "formatted_start": "01:47:37.420",
      "formatted_end": "01:47:39.420",
      "text": "چون باز نخوز سرمان کم خورم"
    },
    {
      "id": 40,
      "start": 6459.42,
      "end": 6464.1,
      "formatted_start": "01:47:39.420",
      "formatted_end": "01:47:44.100",
      "text": "نه نه چون باید اینو نگاه کنید تیفور ده و سه ده و سه تیفور نرماله"
    },
    {
      "id": 41,
      "start": 6464.1,
      "end": 6467.5,
      "formatted_start": "01:47:44.100",
      "formatted_end": "01:47:47.500",
      "text": "خب همونه ادامه بده"
    },
    {
      "id": 42,
      "start": 6467.5,
      "end": 6469.86,
      "formatted_start": "01:47:47.500",
      "formatted_end": "01:47:49.860",
      "text": "روز جمعه نخوه کن"
    },
    {
      "id": 43,
      "start": 6469.86,
      "end": 6471.62,
      "formatted_start": "01:47:49.860",
      "formatted_end": "01:47:51.620",
      "text": "جمعه نخوه"
    },
    {
      "id": 44,
      "start": 6471.62,
      "end": 6473.62,
      "formatted_start": "01:47:51.620",
      "formatted_end": "01:47:53.620",
      "text": "روزانه یه درده به جز جمعه"
    },
    {
      "id": 45,
      "start": 6476.62,
      "end": 6478.62,
      "formatted_start": "01:47:56.620",
      "formatted_end": "01:47:58.620",
      "text": "سه ماهیری که آزمایش بگویم هست"
    },
    {
      "id": 46,
      "start": 6478.62,
      "end": 6481.62,
      "formatted_start": "01:47:58.620",
      "formatted_end": "01:48:01.620",
      "text": "بسیار داره سنهای دیگه برم یه آدم بگم"
    },
    {
      "id": 47,
      "start": 6481.62,
      "end": 6486.62,
      "formatted_start": "01:48:01.620",
      "formatted_end": "01:48:06.620",
      "text": "امروز بوده سه شیش، میشه سه نام"
    },
    {
      "id": 48,
      "start": 6489.62,
      "end": 6492.62,
      "formatted_start": "01:48:09.620",
      "formatted_end": "01:48:12.620",
      "text": "بله همینجور بیدابازماشکن تامینه"
    },
    {
      "id": 49,
      "start": 6492.62,
      "end": 6495.62,
      "formatted_start": "01:48:12.620",
      "formatted_end": "01:48:15.620",
      "text": "خوبه آره، من چند تا مریض رو بیدونم برم نکنم"
    },
    {
      "id": 50,
      "start": 6495.62,
      "end": 6498.62,
      "formatted_start": "01:48:15.620",
      "formatted_end": "01:48:18.620",
      "text": "ممکنه مثلا یه سر عدداشون یکم جا به جایی داره"
    },
    {
      "id": 51,
      "start": 6498.62,
      "end": 6502.62,
      "formatted_start": "01:48:18.620",
      "formatted_end": "01:48:22.620",
      "text": "بله دو داره میزین از آره چیزه تامینشتون ویدیو تامین"
    },
    {
      "id": 52,
      "start": 6502.62,
      "end": 6504.62,
      "formatted_start": "01:48:22.620",
      "formatted_end": "01:48:24.620",
      "text": "آره میگم، تامینه"
    },
    {
      "id": 53,
      "start": 6504.62,
      "end": 6508.62,
      "formatted_start": "01:48:24.620",
      "formatted_end": "01:48:28.620",
      "text": "حالا مریض ها می فرستند یه دفتر شدند و می بگید همین آزمایش کنید"
    },
    {
      "id": 54,
      "start": 6508.62,
      "end": 6511.62,
      "formatted_start": "01:48:28.620",
      "formatted_end": "01:48:31.620",
      "text": "از که سفید اسم نمی می شود بیاریم تو شرط و درموگاهی"
    },
    {
      "id": 55,
      "start": 6511.62,
      "end": 6513.62,
      "formatted_start": "01:48:31.620",
      "formatted_end": "01:48:33.620",
      "text": "نه سفید بچه همونوش می کنش"
    },
    {
      "id": 56,
      "start": 6513.62,
      "end": 6517.62,
      "formatted_start": "01:48:33.620",
      "formatted_end": "01:48:37.620",
      "text": "که من الان که گفت که چیزی برد برد شدی که خود آزمایش که سفید خواست داره بگوید"
    },
    {
      "id": 57,
      "start": 6517.62,
      "end": 6521.62,
      "formatted_start": "01:48:37.620",
      "formatted_end": "01:48:41.620",
      "text": "خب شد من نرستم از این امپیلاتوشنگ هم نزدن آزمایش نگرفتم"
    },
    {
      "id": 58,
      "start": 6521.62,
      "end": 6523.62,
      "formatted_start": "01:48:41.620",
      "formatted_end": "01:48:43.620",
      "text": "می گفتم بچه می موجوده؟"
    },
    {
      "id": 59,
      "start": 6523.62,
      "end": 6528.62,
      "formatted_start": "01:48:43.620",
      "formatted_end": "01:48:48.620",
      "text": "بچه هم توپور هم پشتگیر هم چشم نگیره از بد بیرون هم سفیدتر"
    },
    {
      "id": 60,
      "start": 6528.62,
      "end": 6533.62,
      "formatted_start": "01:48:48.620",
      "formatted_end": "01:48:53.620",
      "text": "بعد یکی هم که خب منو کنم بسه لغری قرص مصرف کنم یا نه؟"
    },
    {
      "id": 61,
      "start": 6533.62,
      "end": 6535.62,
      "formatted_start": "01:48:53.620",
      "formatted_end": "01:48:55.620",
      "text": "ایران اصلا دویت زائمان داشتی؟"
    },
    {
      "id": 62,
      "start": 6535.62,
      "end": 6537.62,
      "formatted_start": "01:48:55.620",
      "formatted_end": "01:48:57.620",
      "text": "بله من اصلا دورم هم نرسید"
    },
    {
      "id": 63,
      "start": 6537.62,
      "end": 6539.62,
      "formatted_start": "01:48:57.620",
      "formatted_end": "01:48:59.620",
      "text": "برم دورتر زمان؟"
    },
    {
      "id": 64,
      "start": 6539.62,
      "end": 6541.62,
      "formatted_start": "01:48:59.620",
      "formatted_end": "01:49:01.620",
      "text": "که ای بوده چند روز؟"
    },
    {
      "id": 65,
      "start": 6541.62,
      "end": 6543.62,
      "formatted_start": "01:49:01.620",
      "formatted_end": "01:49:03.620",
      "text": "همونه کورتاشی که همجام دادی"
    },
    {
      "id": 66,
      "start": 6543.62,
      "end": 6544.62,
      "formatted_start": "01:49:03.620",
      "formatted_end": "01:49:04.620",
      "text": "چه روز؟"
    },
    {
      "id": 67,
      "start": 6544.62,
      "end": 6545.62,
      "formatted_start": "01:49:04.620",
      "formatted_end": "01:49:05.620",
      "text": "چهار روز"
    },
    {
      "id": 68,
      "start": 6545.62,
      "end": 6546.62,
      "formatted_start": "01:49:05.620",
      "formatted_end": "01:49:06.620",
      "text": "چهار؟"
    },
    {
      "id": 69,
      "start": 6546.62,
      "end": 6547.62,
      "formatted_start": "01:49:06.620",
      "formatted_end": "01:49:07.620",
      "text": "کاملا بشه؟"
    },
    {
      "id": 70,
      "start": 6547.62,
      "end": 6549.62,
      "formatted_start": "01:49:07.620",
      "formatted_end": "01:49:09.620",
      "text": "نه اصلا دریا نبوده"
    },
    {
      "id": 71,
      "start": 6549.62,
      "end": 6551.62,
      "formatted_start": "01:49:09.620",
      "formatted_end": "01:49:11.620",
      "text": "شدت مستقبل بگذارید"
    },
    {
      "id": 72,
      "start": 6551.62,
      "end": 6553.62,
      "formatted_start": "01:49:11.620",
      "formatted_end": "01:49:13.620",
      "text": "آه"
    },
    {
      "id": 73,
      "start": 6553.62,
      "end": 6555.62,
      "formatted_start": "01:49:13.620",
      "formatted_end": "01:49:15.620",
      "text": "خیلی"
    },
    {
      "id": 74,
      "start": 6555.62,
      "end": 6557.62,
      "formatted_start": "01:49:15.620",
      "formatted_end": "01:49:17.620",
      "text": "نه اصلا جایی اصلا انقدر گرفتاری بود که"
    },
    {
      "id": 75,
      "start": 6557.62,
      "end": 6559.62,
      "formatted_start": "01:49:17.620",
      "formatted_end": "01:49:19.620",
      "text": "خواهستازی داره اصلا نه دوستی بهم داره"
    },
    {
      "id": 76,
      "start": 6559.62,
      "end": 6561.62,
      "formatted_start": "01:49:19.620",
      "formatted_end": "01:49:21.620",
      "text": "آه خیلی موضوع پاش خامله نشید"
    },
    {
      "id": 77,
      "start": 6561.62,
      "end": 6563.62,
      "formatted_start": "01:49:21.620",
      "formatted_end": "01:49:23.620",
      "text": "خیلی"
    },
    {
      "id": 78,
      "start": 6563.62,
      "end": 6565.62,
      "formatted_start": "01:49:23.620",
      "formatted_end": "01:49:25.620",
      "text": "بعد نه واستان"
    },
    {
      "id": 79,
      "start": 6565.62,
      "end": 6567.62,
      "formatted_start": "01:49:25.620",
      "formatted_end": "01:49:27.620",
      "text": "اگه دیدی که سه ماه شد بر بیام کنی"
    },
    {
      "id": 80,
      "start": 6567.62,
      "end": 6569.62,
      "formatted_start": "01:49:27.620",
      "formatted_end": "01:49:29.620",
      "text": "اصلا از من تخمیران خیلی درد دارم"
    },
    {
      "id": 81,
      "start": 6569.62,
      "end": 6571.62,
      "formatted_start": "01:49:29.620",
      "formatted_end": "01:49:31.620",
      "text": "با وقت اقعب می آفتان اینجوری میشه"
    },
    {
      "id": 82,
      "start": 6571.62,
      "end": 6573.62,
      "formatted_start": "01:49:31.620",
      "formatted_end": "01:49:33.620",
      "text": "سابقا کیست نداشتی؟"
    },
    {
      "id": 83,
      "start": 6573.62,
      "end": 6575.62,
      "formatted_start": "01:49:33.620",
      "formatted_end": "01:49:35.620",
      "text": "چرا؟ کنن کیست هم اصلا دلر ما نشوند"
    },
    {
      "id": 84,
      "start": 6575.62,
      "end": 6577.62,
      "formatted_start": "01:49:35.620",
      "formatted_end": "01:49:37.620",
      "text": "پولی کیستیکی یا یه دونه کیست بزرگ؟"
    },
    {
      "id": 85,
      "start": 6577.62,
      "end": 6579.62,
      "formatted_start": "01:49:37.620",
      "formatted_end": "01:49:39.620",
      "text": "پولی کیستیکی مهمی است"
    },
    {
      "id": 86,
      "start": 6579.62,
      "end": 6581.62,
      "formatted_start": "01:49:39.620",
      "formatted_end": "01:49:41.620",
      "text": "کن که کیست 3 سانتی 4 سانتی"
    },
    {
      "id": 87,
      "start": 6581.62,
      "end": 6583.62,
      "formatted_start": "01:49:41.620",
      "formatted_end": "01:49:43.620",
      "text": "آره از این مداراست که بزرگی بیتره که"
    },
    {
      "id": 88,
      "start": 6583.62,
      "end": 6585.62,
      "formatted_start": "01:49:43.620",
      "formatted_end": "01:49:45.620",
      "text": "آه اگه اون طریق بس خونه باری"
    },
    {
      "id": 89,
      "start": 6585.62,
      "end": 6587.62,
      "formatted_start": "01:49:45.620",
      "formatted_end": "01:49:47.620",
      "text": "آهان"
    },
    {
      "id": 90,
      "start": 6587.62,
      "end": 6589.62,
      "formatted_start": "01:49:47.620",
      "formatted_end": "01:49:49.620",
      "text": "چون تیروید هم داره تیروید هم از درد کیست دختارنه"
    },
    {
      "id": 91,
      "start": 6589.62,
      "end": 6591.62,
      "formatted_start": "01:49:49.620",
      "formatted_end": "01:49:51.620",
      "text": "بعد این همون باشه باز بعد این دیگه داستانه خودشو داره"
    },
    {
      "id": 92,
      "start": 6591.62,
      "end": 6593.62,
      "formatted_start": "01:49:51.620",
      "formatted_end": "01:49:53.620",
      "text": "و از این صورت دختارنه هم باید بینیم"
    },
    {
      "id": 93,
      "start": 6593.62,
      "end": 6595.62,
      "formatted_start": "01:49:53.620",
      "formatted_end": "01:49:55.620",
      "text": "بس یه بزرگی بزرگی"
    },
    {
      "id": 94,
      "start": 6595.62,
      "end": 6597.62,
      "formatted_start": "01:49:55.620",
      "formatted_end": "01:49:57.620",
      "text": "صورت بینیم سه"
    }
  ],
  "status": "completed"
}