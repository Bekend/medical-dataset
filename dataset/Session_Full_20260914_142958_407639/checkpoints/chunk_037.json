  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11130.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:30.000",
      "text": "از اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 1,
      "start": 11130.0,
      "end": 11135.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:35.000",
      "text": "باید بشه بادر میشه مثل متعدایی نه که قبلین برام نوشتن باید بشه"
    },
    {
      "id": 2,
      "start": 11135.0,
      "end": 11139.0,
      "formatted_start": "03:05:35.000",
      "formatted_end": "03:05:39.000",
      "text": "این رو که باز بکنم با بادر شما تصویری باشم"
    },
    {
      "id": 3,
      "start": 11139.0,
      "end": 11143.0,
      "formatted_start": "03:05:39.000",
      "formatted_end": "03:05:43.000",
      "text": "این ها شب دقا فرو نیست که جا"
    },
    {
      "id": 4,
      "start": 11143.0,
      "end": 11146.0,
      "formatted_start": "03:05:43.000",
      "formatted_end": "03:05:46.000",
      "text": "بیا ببین مردم چقدر دارون میخورن"
    },
    {
      "id": 5,
      "start": 11146.0,
      "end": 11149.0,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:49.000",
      "text": "روزه پیس سی تا این اصل اجازه دارون برم"
    },
    {
      "id": 6,
      "start": 11149.0,
      "end": 11152.0,
      "formatted_start": "03:05:49.000",
      "formatted_end": "03:05:52.000",
      "text": "میده من دیگه دارون رو خواهم بکنم میدن برتر میشه"
    },
    {
      "id": 7,
      "start": 11152.0,
      "end": 11156.0,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:05:56.000",
      "text": "من باید باشم کمان کنم خوشم چیز برم"
    },
    {
      "id": 8,
      "start": 11156.0,
      "end": 11160.54,
      "formatted_start": "03:05:56.000",
      "formatted_end": "03:06:00.540",
      "text": "این رو خود دانی روشتی نمیتونن"
    },
    {
      "id": 9,
      "start": 11160.54,
      "end": 11163.24,
      "formatted_start": "03:06:00.540",
      "formatted_end": "03:06:03.240",
      "text": "این واسه اینه که سنگ ساخته نشه وگرنه"
    },
    {
      "id": 10,
      "start": 11163.24,
      "end": 11164.32,
      "formatted_start": "03:06:03.240",
      "formatted_end": "03:06:04.320",
      "text": "این به خاطر همه"
    },
    {
      "id": 11,
      "start": 11164.32,
      "end": 11166.38,
      "formatted_start": "03:06:04.320",
      "formatted_end": "03:06:06.380",
      "text": "ولی یه قرصی هست کدو بود"
    },
    {
      "id": 12,
      "start": 11166.38,
      "end": 11168.4,
      "formatted_start": "03:06:06.380",
      "formatted_end": "03:06:08.400",
      "text": "توبوتی بود"
    },
    {
      "id": 13,
      "start": 11168.4,
      "end": 11170.62,
      "formatted_start": "03:06:08.400",
      "formatted_end": "03:06:10.620",
      "text": "توبوتی؟"
    },
    {
      "id": 14,
      "start": 11170.62,
      "end": 11171.6,
      "formatted_start": "03:06:10.620",
      "formatted_end": "03:06:11.600",
      "text": "قبل نخواهدید"
    },
    {
      "id": 15,
      "start": 11171.6,
      "end": 11173.48,
      "formatted_start": "03:06:11.600",
      "formatted_end": "03:06:13.480",
      "text": "کنون دارید کدو همیستر"
    },
    {
      "id": 16,
      "start": 11173.48,
      "end": 11176.12,
      "formatted_start": "03:06:13.480",
      "formatted_end": "03:06:16.120",
      "text": "اونه که سنگی که آزاده"
    },
    {
      "id": 17,
      "start": 11176.12,
      "end": 11177.8,
      "formatted_start": "03:06:16.120",
      "formatted_end": "03:06:17.800",
      "text": "واسه اینه که سنگ آخون کنی"
    },
    {
      "id": 18,
      "start": 11177.8,
      "end": 11179.42,
      "formatted_start": "03:06:17.800",
      "formatted_end": "03:06:19.420",
      "text": "اینو میده کنید"
    },
    {
      "id": 19,
      "start": 11179.42,
      "end": 11181.18,
      "formatted_start": "03:06:19.420",
      "formatted_end": "03:06:21.180",
      "text": "اینو نمیده؟"
    },
    {
      "id": 20,
      "start": 11181.18,
      "end": 11183.4,
      "formatted_start": "03:06:21.180",
      "formatted_end": "03:06:23.400",
      "text": "اونی داره من رو بیدونید"
    },
    {
      "id": 21,
      "start": 11183.4,
      "end": 11184.4,
      "formatted_start": "03:06:23.400",
      "formatted_end": "03:06:24.400",
      "text": "من رو میشم دارید"
    },
    {
      "id": 22,
      "start": 11184.4,
      "end": 11187.9,
      "formatted_start": "03:06:24.400",
      "formatted_end": "03:06:27.900",
      "text": "اینجا میده میخورند که این نیمه را کاغذ برده که برن و درگان کنه"
    },
    {
      "id": 23,
      "start": 11187.9,
      "end": 11188.9,
      "formatted_start": "03:06:27.900",
      "formatted_end": "03:06:28.900",
      "text": "نه این نام نمیده"
    },
    {
      "id": 24,
      "start": 11188.9,
      "end": 11190.4,
      "formatted_start": "03:06:28.900",
      "formatted_end": "03:06:30.400",
      "text": "خارجی ها"
    },
    {
      "id": 25,
      "start": 11190.4,
      "end": 11194.4,
      "formatted_start": "03:06:30.400",
      "formatted_end": "03:06:34.400",
      "text": "خارجی ها تحت پشش پیمه نیست"
    },
    {
      "id": 26,
      "start": 11194.4,
      "end": 11196.4,
      "formatted_start": "03:06:34.400",
      "formatted_end": "03:06:36.400",
      "text": "این عرض کلی ها جان را شد"
    },
    {
      "id": 27,
      "start": 11196.4,
      "end": 11199.4,
      "formatted_start": "03:06:36.400",
      "formatted_end": "03:06:39.400",
      "text": "سنگ چیز کنند تحت پشش پیمه نیست"
    },
    {
      "id": 28,
      "start": 11199.4,
      "end": 11200.4,
      "formatted_start": "03:06:39.400",
      "formatted_end": "03:06:40.400",
      "text": "آمده از آدم"
    },
    {
      "id": 29,
      "start": 11200.4,
      "end": 11203.4,
      "formatted_start": "03:06:40.400",
      "formatted_end": "03:06:43.400",
      "text": "الان برای کلی ها هم چیزا نمیسی"
    },
    {
      "id": 30,
      "start": 11203.4,
      "end": 11205.4,
      "formatted_start": "03:06:43.400",
      "formatted_end": "03:06:45.400",
      "text": "سونو چیزی استخدم شده"
    },
    {
      "id": 31,
      "start": 11205.4,
      "end": 11207.4,
      "formatted_start": "03:06:45.400",
      "formatted_end": "03:06:47.400",
      "text": "آخرین بار که استخدم شده این؟"
    },
    {
      "id": 32,
      "start": 11207.4,
      "end": 11210.4,
      "formatted_start": "03:06:47.400",
      "formatted_end": "03:06:50.400",
      "text": "این ششمه الان نست استخدم شده"
    },
    {
      "id": 33,
      "start": 11210.4,
      "end": 11211.4,
      "formatted_start": "03:06:50.400",
      "formatted_end": "03:06:51.400",
      "text": "بس الان من نگاه کنم"
    },
    {
      "id": 34,
      "start": 11211.4,
      "end": 11214.4,
      "formatted_start": "03:06:51.400",
      "formatted_end": "03:06:54.400",
      "text": "باید شش ماه رو رو بشه وگرنه بیمونه برد اینجا رو آمده"
    },
    {
      "id": 35,
      "start": 11218.4,
      "end": 11220.4,
      "formatted_start": "03:06:58.400",
      "formatted_end": "03:07:00.400",
      "text": "اینجا دارو دارم به چه کار کنیم؟"
    },
    {
      "id": 36,
      "start": 11220.4,
      "end": 11223.4,
      "formatted_start": "03:07:00.400",
      "formatted_end": "03:07:03.400",
      "text": "یه قطعه سنگ کل بازم خودش کلی مهدر عذیب میکنه"
    },
    {
      "id": 37,
      "start": 11223.4,
      "end": 11224.4,
      "formatted_start": "03:07:03.400",
      "formatted_end": "03:07:04.400",
      "text": "قطعه هست؟"
    },
    {
      "id": 38,
      "start": 11224.4,
      "end": 11225.4,
      "formatted_start": "03:07:04.400",
      "formatted_end": "03:07:05.400",
      "text": "تونده"
    },
    {
      "id": 39,
      "start": 11225.4,
      "end": 11229.4,
      "formatted_start": "03:07:05.400",
      "formatted_end": "03:07:09.400",
      "text": "باید بخوریم وگرنه سنگات همچین خود به خود که نمیدونی"
    },
    {
      "id": 40,
      "start": 11229.4,
      "end": 11232.4,
      "formatted_start": "03:07:09.400",
      "formatted_end": "03:07:12.400",
      "text": "نه ایچ چیز هم نیافتاد اصلا اصلا نیافتاد همونجوری هست"
    },
    {
      "id": 41,
      "start": 11233.4,
      "end": 11236.4,
      "formatted_start": "03:07:13.400",
      "formatted_end": "03:07:16.400",
      "text": "خودتون از سانه چارموندی داره اونجا چار پنج"
    },
    {
      "id": 42,
      "start": 11236.4,
      "end": 11238.4,
      "formatted_start": "03:07:16.400",
      "formatted_end": "03:07:18.400",
      "text": "باید باید بوهم میده از خانم"
    },
    {
      "id": 43,
      "start": 11238.4,
      "end": 11239.4,
      "formatted_start": "03:07:18.400",
      "formatted_end": "03:07:19.400",
      "text": "چی؟"
    },
    {
      "id": 44,
      "start": 11239.4,
      "end": 11241.4,
      "formatted_start": "03:07:19.400",
      "formatted_end": "03:07:21.400",
      "text": "نه، اونو میده"
    },
    {
      "id": 45,
      "start": 11241.4,
      "end": 11243.4,
      "formatted_start": "03:07:21.400",
      "formatted_end": "03:07:23.400",
      "text": "اونو"
    },
    {
      "id": 46,
      "start": 11243.4,
      "end": 11245.4,
      "formatted_start": "03:07:23.400",
      "formatted_end": "03:07:25.400",
      "text": "فقط بعضی باقتا میگم"
    },
    {
      "id": 47,
      "start": 11245.4,
      "end": 11249.4,
      "formatted_start": "03:07:25.400",
      "formatted_end": "03:07:29.400",
      "text": "در اینجا میساس میکنم که چیز زیخ میزنه اینطوری میشه"
    },
    {
      "id": 48,
      "start": 11249.4,
      "end": 11251.4,
      "formatted_start": "03:07:29.400",
      "formatted_end": "03:07:31.400",
      "text": "از یکی کنم"
    },
    {
      "id": 49,
      "start": 11251.4,
      "end": 11255.4,
      "formatted_start": "03:07:31.400",
      "formatted_end": "03:07:35.400",
      "text": "اسمو تو نخوری مده درده فردتر میشه؟"
    },
    {
      "id": 50,
      "start": 11255.4,
      "end": 11257.4,
      "formatted_start": "03:07:35.400",
      "formatted_end": "03:07:37.400",
      "text": "آره، اگه نخورم میشه"
    },
    {
      "id": 51,
      "start": 11257.4,
      "end": 11260.4,
      "formatted_start": "03:07:37.400",
      "formatted_end": "03:07:40.400",
      "text": "اینجا، آن دختر این هست"
    },
    {
      "id": 52,
      "start": 11260.4,
      "end": 11261.4,
      "formatted_start": "03:07:40.400",
      "formatted_end": "03:07:41.400",
      "text": "این هست، این هست"
    },
    {
      "id": 53,
      "start": 11261.4,
      "end": 11262.4,
      "formatted_start": "03:07:41.400",
      "formatted_end": "03:07:42.400",
      "text": "تو روده هست"
    },
    {
      "id": 54,
      "start": 11262.4,
      "end": 11264.4,
      "formatted_start": "03:07:42.400",
      "formatted_end": "03:07:44.400",
      "text": "همین زیر این فردی"
    },
    {
      "id": 55,
      "start": 11264.4,
      "end": 11266.4,
      "formatted_start": "03:07:44.400",
      "formatted_end": "03:07:46.400",
      "text": "اینجا بیدید و اینجا بردید"
    },
    {
      "id": 56,
      "start": 11268.4,
      "end": 11273.4,
      "formatted_start": "03:07:48.400",
      "formatted_end": "03:07:53.400",
      "text": "یعنی من درد من باقتی من بشترین همینو اینجا"
    },
    {
      "id": 57,
      "start": 11273.4,
      "end": 11275.4,
      "formatted_start": "03:07:53.400",
      "formatted_end": "03:07:55.400",
      "text": "درد چطور کنی؟"
    },
    {
      "id": 58,
      "start": 11277.4,
      "end": 11278.4,
      "formatted_start": "03:07:57.400",
      "formatted_end": "03:07:58.400",
      "text": "اینجا درد داری؟"
    },
    {
      "id": 59,
      "start": 11278.4,
      "end": 11280.4,
      "formatted_start": "03:07:58.400",
      "formatted_end": "03:08:00.400",
      "text": "اینجا، اینجا، همین دارد بیدید"
    },
    {
      "id": 60,
      "start": 11280.4,
      "end": 11281.4,
      "formatted_start": "03:08:00.400",
      "formatted_end": "03:08:01.400",
      "text": "این تنها بود؟"
    },
    {
      "id": 61,
      "start": 11281.4,
      "end": 11282.4,
      "formatted_start": "03:08:01.400",
      "formatted_end": "03:08:02.400",
      "text": "میده؟"
    },
    {
      "id": 62,
      "start": 11282.4,
      "end": 11287.4,
      "formatted_start": "03:08:02.400",
      "formatted_end": "03:08:07.400",
      "text": "آمین، درد، همینه رو در اینجا، یه بسمتی من رو در اینجا بیدید"
    },
    {
      "id": 63,
      "start": 11287.4,
      "end": 11288.4,
      "formatted_start": "03:08:07.400",
      "formatted_end": "03:08:08.400",
      "text": "خب اینکه دیگه هم"
    },
    {
      "id": 64,
      "start": 11294.4,
      "end": 11299.04,
      "formatted_start": "03:08:14.400",
      "formatted_end": "03:08:19.040",
      "text": "من که رفتم کریزکویی و همه چیزم کردم باقی همون پدرک دیدم"
    },
    {
      "id": 65,
      "start": 11299.04,
      "end": 11300.04,
      "formatted_start": "03:08:19.040",
      "formatted_end": "03:08:20.040",
      "text": "پرسال یک سال"
    },
    {
      "id": 66,
      "start": 11300.04,
      "end": 11301.04,
      "formatted_start": "03:08:20.040",
      "formatted_end": "03:08:21.040",
      "text": "تو هست هست بیرون"
    },
    {
      "id": 67,
      "start": 11301.04,
      "end": 11302.04,
      "formatted_start": "03:08:21.040",
      "formatted_end": "03:08:22.040",
      "text": "هست بیرون"
    },
    {
      "id": 68,
      "start": 11303.8,
      "end": 11305.8,
      "formatted_start": "03:08:23.800",
      "formatted_end": "03:08:25.800",
      "text": "جوش نمی بزنیم"
    },
    {
      "id": 69,
      "start": 11305.8,
      "end": 11308.8,
      "formatted_start": "03:08:25.800",
      "formatted_end": "03:08:28.800",
      "text": "اگر در این دنیا می شه باید دکتر بی جوش باشن"
    },
    {
      "id": 70,
      "start": 11308.8,
      "end": 11309.8,
      "formatted_start": "03:08:28.800",
      "formatted_end": "03:08:29.800",
      "text": "نه"
    },
    {
      "id": 71,
      "start": 11312.0,
      "end": 11314.0,
      "formatted_start": "03:08:32.000",
      "formatted_end": "03:08:34.000",
      "text": "باید خب باید"
    },
    {
      "id": 72,
      "start": 11317.2,
      "end": 11320.2,
      "formatted_start": "03:08:37.200",
      "formatted_end": "03:08:40.200",
      "text": "این رو از اینجا نمیشه کنیم که تو روز مردی بیرون"
    },
    {
      "id": 73,
      "start": 11320.2,
      "end": 11322.2,
      "formatted_start": "03:08:40.200",
      "formatted_end": "03:08:42.200",
      "text": "من گفتم این رو خوب بکنم"
    },
    {
      "id": 74,
      "start": 11322.2,
      "end": 11324.2,
      "formatted_start": "03:08:42.200",
      "formatted_end": "03:08:44.200",
      "text": "این رو برم نمی سازم"
    },
    {
      "id": 75,
      "start": 11324.2,
      "end": 11326.2,
      "formatted_start": "03:08:44.200",
      "formatted_end": "03:08:46.200",
      "text": "این رو برم نمی سازم"
    },
    {
      "id": 76,
      "start": 11326.2,
      "end": 11328.2,
      "formatted_start": "03:08:46.200",
      "formatted_end": "03:08:48.200",
      "text": "من همون رو نمی بشم"
    },
    {
      "id": 77,
      "start": 11328.2,
      "end": 11330.2,
      "formatted_start": "03:08:48.200",
      "formatted_end": "03:08:50.200",
      "text": "کارخونه نوزشه به داروخونه بگیرم"
    },
    {
      "id": 78,
      "start": 11330.2,
      "end": 11332.2,
      "formatted_start": "03:08:50.200",
      "formatted_end": "03:08:52.200",
      "text": "شما"
    },
    {
      "id": 79,
      "start": 11332.2,
      "end": 11334.2,
      "formatted_start": "03:08:52.200",
      "formatted_end": "03:08:54.200",
      "text": "بیست و شیش"
    },
    {
      "id": 80,
      "start": 11334.2,
      "end": 11336.2,
      "formatted_start": "03:08:54.200",
      "formatted_end": "03:08:56.200",
      "text": "دوزار و بیست و شیش رفتی"
    },
    {
      "id": 81,
      "start": 11336.2,
      "end": 11338.2,
      "formatted_start": "03:08:56.200",
      "formatted_end": "03:08:58.200",
      "text": "دیدیم"
    },
    {
      "id": 82,
      "start": 11338.2,
      "end": 11340.2,
      "formatted_start": "03:08:58.200",
      "formatted_end": "03:09:00.200",
      "text": "برجه"
    },
    {
      "id": 83,
      "start": 11340.2,
      "end": 11342.2,
      "formatted_start": "03:09:00.200",
      "formatted_end": "03:09:02.200",
      "text": "یک دوزار و بیست و شیش رفتی"
    },
    {
      "id": 84,
      "start": 11342.2,
      "end": 11344.2,
      "formatted_start": "03:09:02.200",
      "formatted_end": "03:09:04.200",
      "text": "خوب"
    },
    {
      "id": 85,
      "start": 11344.2,
      "end": 11346.2,
      "formatted_start": "03:09:04.200",
      "formatted_end": "03:09:06.200",
      "text": "یعنی دهی رفتی"
    },
    {
      "id": 86,
      "start": 11346.2,
      "end": 11348.2,
      "formatted_start": "03:09:06.200",
      "formatted_end": "03:09:08.200",
      "text": "تا ما شش ماه خود شدیم"
    },
    {
      "id": 87,
      "start": 11348.2,
      "end": 11350.2,
      "formatted_start": "03:09:08.200",
      "formatted_end": "03:09:10.200",
      "text": "شش ماه داپر شده رو"
    },
    {
      "id": 88,
      "start": 11350.2,
      "end": 11353.44,
      "formatted_start": "03:09:10.200",
      "formatted_end": "03:09:13.440",
      "text": "حالا هشت دوزار و بیست و شیشه"
    },
    {
      "id": 89,
      "start": 11353.44,
      "end": 11355.44,
      "formatted_start": "03:09:13.440",
      "formatted_end": "03:09:15.440",
      "text": "شش ماه بذاشته"
    },
    {
      "id": 90,
      "start": 11355.44,
      "end": 11358.84,
      "formatted_start": "03:09:15.440",
      "formatted_end": "03:09:18.840",
      "text": "چون سی تی کلن موزه یعنی نه وقت منششه"
    },
    {
      "id": 91,
      "start": 11358.84,
      "end": 11360.84,
      "formatted_start": "03:09:18.840",
      "formatted_end": "03:09:20.840",
      "text": "باید بیسته باید خب چه کار کنم"
    },
    {
      "id": 92,
      "start": 11364.84,
      "end": 11367.84,
      "formatted_start": "03:09:24.840",
      "formatted_end": "03:09:27.840",
      "text": "سونا هم اگه یه سونا خوب بریم میتونم همون کارو بکنم"
    },
    {
      "id": 93,
      "start": 11367.84,
      "end": 11370.84,
      "formatted_start": "03:09:27.840",
      "formatted_end": "03:09:30.840",
      "text": "سونا نشان نمیتونم دو کورنه قبلن گرفتن از اینجور"
    },
    {
      "id": 94,
      "start": 11370.84,
      "end": 11372.84,
      "formatted_start": "03:09:30.840",
      "formatted_end": "03:09:32.840",
      "text": "از اینجور نشان نداریم"
    },
    {
      "id": 95,
      "start": 11372.84,
      "end": 11375.84,
      "formatted_start": "03:09:32.840",
      "formatted_end": "03:09:35.840",
      "text": "محامولا موزه استفاده اینجوریه که"
    },
    {
      "id": 96,
      "start": 11375.84,
      "end": 11399.84,
      "formatted_start": "03:09:35.840",
      "formatted_end": "03:09:59.840",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}