  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8123.56,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:23.560",
      "text": "اما از یک طرف، از اید تا بیستره همه تیر، ده با شده، یعنی این چهرگزه برش، یا زامی بار هم که دوچار خیلی بی حالی شدید و دست پا داخل داشت می نرزید و اینا دی رفتن یادگیار ما، دی یادگیار ما و اینا سرم نوشتو اینا، یعنی همون سر اولی فریودی."
    },
    {
      "id": 1,
      "start": 8123.56,
      "end": 8126.2,
      "formatted_start": "02:15:23.560",
      "formatted_end": "02:15:26.200",
      "text": "دیگه چیزی دیگه خیلی حالم"
    },
    {
      "id": 2,
      "start": 8126.2,
      "end": 8129.56,
      "formatted_start": "02:15:26.200",
      "formatted_end": "02:15:29.560",
      "text": "اصلا خوبیست تو اینها و درخواست نهایت باش کردن"
    },
    {
      "id": 3,
      "start": 8129.56,
      "end": 8133.4,
      "formatted_start": "02:15:29.560",
      "formatted_end": "02:15:33.400",
      "text": "پنجاتو این مایچه های پشت پان در ازت"
    },
    {
      "id": 4,
      "start": 8133.4,
      "end": 8134.98,
      "formatted_start": "02:15:33.400",
      "formatted_end": "02:15:34.980",
      "text": "که خواب خیلی بار برفته"
    },
    {
      "id": 5,
      "start": 8134.98,
      "end": 8136.86,
      "formatted_start": "02:15:34.980",
      "formatted_end": "02:15:36.860",
      "text": "برفته دیداشته باشه"
    },
    {
      "id": 6,
      "start": 8136.86,
      "end": 8142.94,
      "formatted_start": "02:15:36.860",
      "formatted_end": "02:15:42.940",
      "text": "مایچه های پشت پان خیلی درد می کنه"
    },
    {
      "id": 7,
      "start": 8142.94,
      "end": 8145.78,
      "formatted_start": "02:15:42.940",
      "formatted_end": "02:15:45.780",
      "text": "و دست پان خیلی بزرگ خواب می ده"
    },
    {
      "id": 8,
      "start": 8145.78,
      "end": 8147.1,
      "formatted_start": "02:15:45.780",
      "formatted_end": "02:15:47.100",
      "text": "استسخ خیلی"
    },
    {
      "id": 9,
      "start": 8147.1,
      "end": 8149.16,
      "formatted_start": "02:15:47.100",
      "formatted_end": "02:15:49.160",
      "text": "این داره اصلا بولیمه داره"
    },
    {
      "id": 10,
      "start": 8149.16,
      "end": 8169.16,
      "formatted_start": "02:15:49.160",
      "formatted_end": "02:16:09.160",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 8179.16,
      "end": 8181.16,
      "formatted_start": "02:16:19.160",
      "formatted_end": "02:16:21.160",
      "text": "برای اینجوریه"
    },
    {
      "id": 12,
      "start": 8181.16,
      "end": 8183.16,
      "formatted_start": "02:16:21.160",
      "formatted_end": "02:16:23.160",
      "text": "سرزخون"
    },
    {
      "id": 13,
      "start": 8189.16,
      "end": 8191.16,
      "formatted_start": "02:16:29.160",
      "formatted_end": "02:16:31.160",
      "text": "درسته شما چیکار کنید؟"
    },
    {
      "id": 14,
      "start": 8191.16,
      "end": 8193.16,
      "formatted_start": "02:16:31.160",
      "formatted_end": "02:16:33.160",
      "text": "نمیدونم"
    },
    {
      "id": 15,
      "start": 8193.16,
      "end": 8195.16,
      "formatted_start": "02:16:33.160",
      "formatted_end": "02:16:35.160",
      "text": "بقیه من ها یهجوری خاندوتو دارست کنید که"
    },
    {
      "id": 16,
      "start": 8195.16,
      "end": 8197.16,
      "formatted_start": "02:16:35.160",
      "formatted_end": "02:16:37.160",
      "text": "یعنی"
    },
    {
      "id": 17,
      "start": 8197.16,
      "end": 8199.16,
      "formatted_start": "02:16:37.160",
      "formatted_end": "02:16:39.160",
      "text": "توب باشند"
    },
    {
      "id": 18,
      "start": 8199.16,
      "end": 8201.16,
      "formatted_start": "02:16:39.160",
      "formatted_end": "02:16:41.160",
      "text": "یه قرصه انرژی پرامون هست"
    },
    {
      "id": 19,
      "start": 8201.16,
      "end": 8203.16,
      "formatted_start": "02:16:41.160",
      "formatted_end": "02:16:43.160",
      "text": "میگن یکی هست"
    },
    {
      "id": 20,
      "start": 8203.16,
      "end": 8205.16,
      "formatted_start": "02:16:43.160",
      "formatted_end": "02:16:45.160",
      "text": "میگن فارماتون هست"
    },
    {
      "id": 21,
      "start": 8205.16,
      "end": 8207.16,
      "formatted_start": "02:16:45.160",
      "formatted_end": "02:16:47.160",
      "text": "میگن خیلی انرژی سرهادون میخوانه خاندوتو"
    },
    {
      "id": 22,
      "start": 8207.16,
      "end": 8212.16,
      "formatted_start": "02:16:47.160",
      "formatted_end": "02:16:52.160",
      "text": "اینجوری به این خواهی نداریم. یعنی با دوتا بچه ای که دارم سرکله هم ندارم."
    },
    {
      "id": 23,
      "start": 8212.16,
      "end": 8217.16,
      "formatted_start": "02:16:52.160",
      "formatted_end": "02:16:57.160",
      "text": "دیروز مثلا وقتی یک کاری انجام نخسته ای خیلی شدید بیجانوشه درم."
    },
    {
      "id": 24,
      "start": 8217.16,
      "end": 8223.16,
      "formatted_start": "02:16:57.160",
      "formatted_end": "02:17:03.160",
      "text": "ازت خواهش میکنم که خودت استرس بارد نکن."
    },
    {
      "id": 25,
      "start": 8223.16,
      "end": 8226.16,
      "formatted_start": "02:17:03.160",
      "formatted_end": "02:17:06.160",
      "text": "نه خواهش میکنم استرس یک چیز بارد نمیکنم."
    },
    {
      "id": 26,
      "start": 8226.16,
      "end": 8229.16,
      "formatted_start": "02:17:06.160",
      "formatted_end": "02:17:09.160",
      "text": "سریم کنم در آرامش کامل خودم رو درست دارم."
    },
    {
      "id": 27,
      "start": 8229.16,
      "end": 8234.24,
      "formatted_start": "02:17:09.160",
      "formatted_end": "02:17:14.240",
      "text": "دختر آرونیه، ولی مثلا یه سری بدیشه از یه آدم هایی که خیلی زاهده با من زمان"
    },
    {
      "id": 28,
      "start": 8234.24,
      "end": 8236.24,
      "formatted_start": "02:17:14.240",
      "formatted_end": "02:17:16.240",
      "text": "گاهی بعدها خیلی خودخوری میکنن"
    },
    {
      "id": 29,
      "start": 8236.24,
      "end": 8236.74,
      "formatted_start": "02:17:16.240",
      "formatted_end": "02:17:16.740",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 8236.74,
      "end": 8238.74,
      "formatted_start": "02:17:16.740",
      "formatted_end": "02:17:18.740",
      "text": "ما از این تکهش میترسیم"
    },
    {
      "id": 31,
      "start": 8238.74,
      "end": 8239.74,
      "formatted_start": "02:17:18.740",
      "formatted_end": "02:17:19.740",
      "text": "نه، خب، نمیتونی"
    },
    {
      "id": 32,
      "start": 8239.74,
      "end": 8242.74,
      "formatted_start": "02:17:19.740",
      "formatted_end": "02:17:22.740",
      "text": "از صورت این کام مشکل هیچی زمانی پیش میگه"
    },
    {
      "id": 33,
      "start": 8242.74,
      "end": 8244.74,
      "formatted_start": "02:17:22.740",
      "formatted_end": "02:17:24.740",
      "text": "اگه هم درست میشه، یه دیگه نداره"
    },
    {
      "id": 34,
      "start": 8245.74,
      "end": 8246.74,
      "formatted_start": "02:17:25.740",
      "formatted_end": "02:17:26.740",
      "text": "با شوهرت خوبی بیره"
    },
    {
      "id": 35,
      "start": 8246.74,
      "end": 8247.74,
      "formatted_start": "02:17:26.740",
      "formatted_end": "02:17:27.740",
      "text": "آره"
    },
    {
      "id": 36,
      "start": 8247.74,
      "end": 8248.74,
      "formatted_start": "02:17:27.740",
      "formatted_end": "02:17:28.740",
      "text": "مادر شوهرت چی؟"
    },
    {
      "id": 37,
      "start": 8248.74,
      "end": 8249.74,
      "formatted_start": "02:17:28.740",
      "formatted_end": "02:17:29.740",
      "text": "بوبالی"
    },
    {
      "id": 38,
      "start": 8249.74,
      "end": 8250.74,
      "formatted_start": "02:17:29.740",
      "formatted_end": "02:17:30.740",
      "text": "نه"
    },
    {
      "id": 39,
      "start": 8250.74,
      "end": 8252.74,
      "formatted_start": "02:17:30.740",
      "formatted_end": "02:17:32.740",
      "text": "اما وقتی منواردگی هیچ مشکلی نداره"
    },
    {
      "id": 40,
      "start": 8252.74,
      "end": 8254.74,
      "formatted_start": "02:17:32.740",
      "formatted_end": "02:17:34.740",
      "text": "فقط خوزونی بچه ها؟"
    },
    {
      "id": 41,
      "start": 8254.74,
      "end": 8256.74,
      "formatted_start": "02:17:34.740",
      "formatted_end": "02:17:36.740",
      "text": "آره خانم اینطور"
    },
    {
      "id": 42,
      "start": 8256.74,
      "end": 8260.74,
      "formatted_start": "02:17:36.740",
      "formatted_end": "02:17:40.740",
      "text": "همیشه بخواست بکنم که تو دانیا آدم هایی که آرزو دارن یک دینار از هر بچه ها رو باشن"
    },
    {
      "id": 43,
      "start": 8260.74,
      "end": 8264.74,
      "formatted_start": "02:17:40.740",
      "formatted_end": "02:17:44.740",
      "text": "که سر صدا خودم من خودشونو بترک کنم"
    },
    {
      "id": 44,
      "start": 8264.74,
      "end": 8266.74,
      "formatted_start": "02:17:44.740",
      "formatted_end": "02:17:46.740",
      "text": "خانم دوتو خانم فراز من سه تا یا..."
    },
    {
      "id": 45,
      "start": 8266.74,
      "end": 8270.74,
      "formatted_start": "02:17:46.740",
      "formatted_end": "02:17:50.740",
      "text": "خب چه خواب جایی من هم خبر داریم دیگه ما جوال هم هست"
    },
    {
      "id": 46,
      "start": 8270.74,
      "end": 8273.74,
      "formatted_start": "02:17:50.740",
      "formatted_end": "02:17:53.740",
      "text": "اینا سه تا و امدید وقتی یک دو هم..."
    },
    {
      "id": 47,
      "start": 8273.74,
      "end": 8274.74,
      "formatted_start": "02:17:53.740",
      "formatted_end": "02:17:54.740",
      "text": "چند ساله داری؟"
    },
    {
      "id": 48,
      "start": 8274.74,
      "end": 8275.74,
      "formatted_start": "02:17:54.740",
      "formatted_end": "02:17:55.740",
      "text": "من مثل چه های"
    },
    {
      "id": 49,
      "start": 8275.74,
      "end": 8278.28,
      "formatted_start": "02:17:55.740",
      "formatted_end": "02:17:58.280",
      "text": "قدرموستانتو بودن دهتا بچه باشن"
    },
    {
      "id": 50,
      "start": 8278.28,
      "end": 8278.78,
      "formatted_start": "02:17:58.280",
      "formatted_end": "02:17:58.780",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 8278.78,
      "end": 8280.98,
      "formatted_start": "02:17:58.780",
      "formatted_end": "02:18:00.980",
      "text": "اما نیم درما همیشه اینو بخودم میاد"
    },
    {
      "id": 52,
      "start": 8280.98,
      "end": 8283.38,
      "formatted_start": "02:18:00.980",
      "formatted_end": "02:18:03.380",
      "text": "میاد اونو قدیمه چیجوری بخواهشون زندگی می کنن"
    },
    {
      "id": 53,
      "start": 8283.38,
      "end": 8284.12,
      "formatted_start": "02:18:03.380",
      "formatted_end": "02:18:04.120",
      "text": "با سه تا بچه"
    },
    {
      "id": 54,
      "start": 8284.12,
      "end": 8286.46,
      "formatted_start": "02:18:04.120",
      "formatted_end": "02:18:06.460",
      "text": "اینا هم کسان نجوری نجوری بودن"
    },
    {
      "id": 55,
      "start": 8286.46,
      "end": 8288.64,
      "formatted_start": "02:18:06.460",
      "formatted_end": "02:18:08.640",
      "text": "وقتی دعوه میکنن بهشون هم میگم ساکل باشن"
    },
    {
      "id": 56,
      "start": 8288.64,
      "end": 8289.32,
      "formatted_start": "02:18:08.640",
      "formatted_end": "02:18:09.320",
      "text": "ساکل بمیکنن"
    },
    {
      "id": 57,
      "start": 8289.32,
      "end": 8292.02,
      "formatted_start": "02:18:09.320",
      "formatted_end": "02:18:12.020",
      "text": "و وقتی دعوه شو شدید دمشون خودم اصلا بمیکنن"
    },
    {
      "id": 58,
      "start": 8292.02,
      "end": 8293.26,
      "formatted_start": "02:18:12.020",
      "formatted_end": "02:18:13.260",
      "text": "چون سنگیم کنن دعوه شون نکنن"
    },
    {
      "id": 59,
      "start": 8293.26,
      "end": 8295.76,
      "formatted_start": "02:18:13.260",
      "formatted_end": "02:18:15.760",
      "text": "میرن بچه‌گی خودشونی باید انجام بدن"
    },
    {
      "id": 60,
      "start": 8295.76,
      "end": 8299.76,
      "formatted_start": "02:18:15.760",
      "formatted_end": "02:18:19.760",
      "text": "و اخی من دعواشون کنم بگم ساکت باشین و بشین بازی نکنی"
    },
    {
      "id": 61,
      "start": 8299.76,
      "end": 8301.76,
      "formatted_start": "02:18:19.760",
      "formatted_end": "02:18:21.760",
      "text": "جرون روشتشون رو دارن می‌گیرن"
    },
    {
      "id": 62,
      "start": 8305.26,
      "end": 8306.76,
      "formatted_start": "02:18:25.260",
      "formatted_end": "02:18:26.760",
      "text": "بله نیست تو نابات بشین"
    },
    {
      "id": 63,
      "start": 8306.76,
      "end": 8309.76,
      "formatted_start": "02:18:26.760",
      "formatted_end": "02:18:29.760",
      "text": "نه بدم بهم اقدر آگه‌ان توی حدود یادم"
    },
    {
      "id": 64,
      "start": 8309.76,
      "end": 8310.76,
      "formatted_start": "02:18:29.760",
      "formatted_end": "02:18:30.760",
      "text": "آره"
    },
    {
      "id": 65,
      "start": 8311.76,
      "end": 8315.76,
      "formatted_start": "02:18:31.760",
      "formatted_end": "02:18:35.760",
      "text": "بله نه دیگه تو چند وقته یکم کالا از رو مود خارج شدی"
    },
    {
      "id": 66,
      "start": 8316.76,
      "end": 8317.76,
      "formatted_start": "02:18:36.760",
      "formatted_end": "02:18:37.760",
      "text": "نه؟"
    },
    {
      "id": 67,
      "start": 8317.76,
      "end": 8318.76,
      "formatted_start": "02:18:37.760",
      "formatted_end": "02:18:38.760",
      "text": "آره"
    },
    {
      "id": 68,
      "start": 8318.76,
      "end": 8325.32,
      "formatted_start": "02:18:38.760",
      "formatted_end": "02:18:45.320",
      "text": "سر می کنم خود من همیشه قلیل یادارو کنم و پرالوژی می آمیم"
    },
    {
      "id": 69,
      "start": 8325.32,
      "end": 8327.72,
      "formatted_start": "02:18:45.320",
      "formatted_end": "02:18:47.720",
      "text": "چون شاهرم حقیقتا سه روز سر رو کنه"
    },
    {
      "id": 70,
      "start": 8327.72,
      "end": 8332.84,
      "formatted_start": "02:18:47.720",
      "formatted_end": "02:18:52.840",
      "text": "سه روز هم یه خانانه سه روزی که هست خانه ها یه شوق دوم می کنه میره سر کار شوق دومش"
    },
    {
      "id": 71,
      "start": 8332.84,
      "end": 8340.04,
      "formatted_start": "02:18:52.840",
      "formatted_end": "02:19:00.040",
      "text": "سر کار شوق دومش میره فقط تا اینه ساعت هشت سبخانه"
    },
    {
      "id": 72,
      "start": 8340.04,
      "end": 8342.36,
      "formatted_start": "02:19:00.040",
      "formatted_end": "02:19:02.360",
      "text": "اشارتو خیلی نمی بگیر"
    },
    {
      "id": 73,
      "start": 8342.36,
      "end": 8343.32,
      "formatted_start": "02:19:02.360",
      "formatted_end": "02:19:03.320",
      "text": "نه"
    },
    {
      "id": 74,
      "start": 8343.32,
      "end": 8347.28,
      "formatted_start": "02:19:03.320",
      "formatted_end": "02:19:07.280",
      "text": "خب رو بهش بگو من با کمت می سازم ولی بیشتر خونه باش"
    },
    {
      "id": 75,
      "start": 8347.28,
      "end": 8349.28,
      "formatted_start": "02:19:07.280",
      "formatted_end": "02:19:09.280",
      "text": "بسازیم"
    },
    {
      "id": 76,
      "start": 8349.28,
      "end": 8353.28,
      "formatted_start": "02:19:09.280",
      "formatted_end": "02:19:13.280",
      "text": "نه خاندوتا چون قصد غرضای خونستادی خیلی شدیده"
    },
    {
      "id": 77,
      "start": 8353.28,
      "end": 8356.28,
      "formatted_start": "02:19:13.280",
      "formatted_end": "02:19:16.280",
      "text": "همین زن بگو بسازم آره خونی برمی سازم"
    },
    {
      "id": 78,
      "start": 8356.28,
      "end": 8359.28,
      "formatted_start": "02:19:16.280",
      "formatted_end": "02:19:19.280",
      "text": "بعد همین دارم تعمال می کنم"
    },
    {
      "id": 79,
      "start": 8359.28,
      "end": 8362.28,
      "formatted_start": "02:19:19.280",
      "formatted_end": "02:19:22.280",
      "text": "آفرین ما هم شما نیقن ندست بیادیم"
    },
    {
      "id": 80,
      "start": 8362.28,
      "end": 8364.28,
      "formatted_start": "02:19:22.280",
      "formatted_end": "02:19:24.280",
      "text": "آه تعماله"
    },
    {
      "id": 81,
      "start": 8364.28,
      "end": 8366.28,
      "formatted_start": "02:19:24.280",
      "formatted_end": "02:19:26.280",
      "text": "کنارش چیزایی را از دست میدیم"
    },
    {
      "id": 82,
      "start": 8366.28,
      "end": 8368.28,
      "formatted_start": "02:19:26.280",
      "formatted_end": "02:19:28.280",
      "text": "و تو همیشه دخترم خوبیستانه داری"
    },
    {
      "id": 83,
      "start": 8368.28,
      "end": 8371.28,
      "formatted_start": "02:19:28.280",
      "formatted_end": "02:19:31.280",
      "text": "ما همه این روزای سختتان رو همه این ماه هم بزرگ می کنیم"
    },
    {
      "id": 84,
      "start": 8371.28,
      "end": 8374.62,
      "formatted_start": "02:19:31.280",
      "formatted_end": "02:19:34.620",
      "text": "به این درم نگاه میکنن آینده که یه زندگی بهتر بشه"
    },
    {
      "id": 85,
      "start": 8374.62,
      "end": 8376.32,
      "formatted_start": "02:19:34.620",
      "formatted_end": "02:19:36.320",
      "text": "و اشنا حالا خوشگزارونه میکنن"
    },
    {
      "id": 86,
      "start": 8376.32,
      "end": 8377.92,
      "formatted_start": "02:19:36.320",
      "formatted_end": "02:19:37.920",
      "text": "آینده هیچی درم نیست"
    },
    {
      "id": 87,
      "start": 8377.92,
      "end": 8379.78,
      "formatted_start": "02:19:37.920",
      "formatted_end": "02:19:39.780",
      "text": "اما حالا بهتر سختی بگیشن"
    },
    {
      "id": 88,
      "start": 8379.78,
      "end": 8381.14,
      "formatted_start": "02:19:39.780",
      "formatted_end": "02:19:41.140",
      "text": "تا آینده خوب داشته باشه"
    },
    {
      "id": 89,
      "start": 8381.14,
      "end": 8383.22,
      "formatted_start": "02:19:41.140",
      "formatted_end": "02:19:43.220",
