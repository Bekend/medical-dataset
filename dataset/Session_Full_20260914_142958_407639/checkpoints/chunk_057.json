  "stt_segments": [
    {
      "id": 0,
      "start": 17100.0,
      "end": 17104.0,
      "formatted_start": "04:45:00.000",
      "formatted_end": "04:45:04.000",
      "text": "در صدقشون کامل نوشتم، بین انو، نینو، همه نوشتم، آره."
    },
    {
      "id": 1,
      "start": 17104.0,
      "end": 17114.0,
      "formatted_start": "04:45:04.000",
      "formatted_end": "04:45:14.000",
      "text": "آره، دیگه ما همیشه، اینو داروی همیشه گیر شدیم، آره، آره."
    },
    {
      "id": 2,
      "start": 17114.0,
      "end": 17127.0,
      "formatted_start": "04:45:14.000",
      "formatted_end": "04:45:27.000",
      "text": "نه، نه، نه، آنتیبیوتیکشون، سپروکسی، مادی نازولایت نوشتم، مدود ده روز میشه، اونا، یکیش، هر دوش، دوازده ساعتی بعد غذا."
    },
    {
      "id": 3,
      "start": 17127.0,
      "end": 17131.1,
      "formatted_start": "04:45:27.000",
      "formatted_end": "04:45:31.100",
      "text": "باشو رفتی ندارم"
    },
    {
      "id": 4,
      "start": 17131.1,
      "end": 17135.1,
      "formatted_start": "04:45:31.100",
      "formatted_end": "04:45:35.100",
      "text": "آره"
    },
    {
      "id": 5,
      "start": 17135.1,
      "end": 17137.2,
      "formatted_start": "04:45:35.100",
      "formatted_end": "04:45:37.200",
      "text": "آره"
    },
    {
      "id": 6,
      "start": 17137.2,
      "end": 17138.9,
      "formatted_start": "04:45:37.200",
      "formatted_end": "04:45:38.900",
      "text": "سلامت باشه ایت خواهش میکنم"
    },
    {
      "id": 7,
      "start": 17138.9,
      "end": 17140.82,
      "formatted_start": "04:45:38.900",
      "formatted_end": "04:45:40.820",
      "text": "نه خواهش میکنم نه خواهش میکنم"
    },
    {
      "id": 8,
      "start": 17140.82,
      "end": 17142.48,
      "formatted_start": "04:45:40.820",
      "formatted_end": "04:45:42.480",
      "text": "چرده نبابا من جامعه فصل"
    },
    {
      "id": 9,
      "start": 17142.48,
      "end": 17144.66,
      "formatted_start": "04:45:42.480",
      "formatted_end": "04:45:44.660",
      "text": "نه خواهش میکنم"
    },
    {
      "id": 10,
      "start": 17144.66,
      "end": 17145.8,
      "formatted_start": "04:45:44.660",
      "formatted_end": "04:45:45.800",
      "text": "آره"
    },
    {
      "id": 11,
      "start": 17145.8,
      "end": 17149.6,
      "formatted_start": "04:45:45.800",
      "formatted_end": "04:45:49.600",
      "text": "سلامت باشه نه این شده بهتر باشم"
    },
    {
      "id": 12,
      "start": 17149.6,
      "end": 17151.22,
      "formatted_start": "04:45:49.600",
      "formatted_end": "04:45:51.220",
      "text": "سلامت باشه ایت خواهش میکنم"
    },
    {
      "id": 13,
      "start": 17151.22,
      "end": 17153.2,
      "formatted_start": "04:45:51.220",
      "formatted_end": "04:45:53.200",
      "text": "سلامت باشه ایت خواهش میکنم"
    },
    {
      "id": 14,
      "start": 17153.2,
      "end": 17153.88,
      "formatted_start": "04:45:53.200",
      "formatted_end": "04:45:53.880",
      "text": "من جامعه فصل"
    },
    {
      "id": 15,
      "start": 17153.88,
      "end": 17155.42,
      "formatted_start": "04:45:53.880",
      "formatted_end": "04:45:55.420",
      "text": "سلامت باشه ایت خدا نگهت"
    },
    {
      "id": 16,
      "start": 17155.42,
      "end": 17157.42,
      "formatted_start": "04:45:55.420",
      "formatted_end": "04:45:57.420",
      "text": "خانم اطراف خودی خودم"
    },
    {
      "id": 17,
      "start": 17157.42,
      "end": 17161.42,
      "formatted_start": "04:45:57.420",
      "formatted_end": "04:46:01.420",
      "text": "بابا اطرافت سخت میاد تازگی"
    },
    {
      "id": 18,
      "start": 17161.42,
      "end": 17163.42,
      "formatted_start": "04:46:01.420",
      "formatted_end": "04:46:03.420",
      "text": "آره یک خیلی مثلا"
    },
    {
      "id": 19,
      "start": 17163.42,
      "end": 17165.42,
      "formatted_start": "04:46:03.420",
      "formatted_end": "04:46:05.420",
      "text": "ازیاد میکنه"
    },
    {
      "id": 20,
      "start": 17165.42,
      "end": 17167.42,
      "formatted_start": "04:46:05.420",
      "formatted_end": "04:46:07.420",
      "text": "بعد خانم دکتر کمان رو نکرد"
    },
    {
      "id": 21,
      "start": 17167.42,
      "end": 17169.42,
      "formatted_start": "04:46:07.420",
      "formatted_end": "04:46:09.420",
      "text": "ازیاد میکنه"
    },
    {
      "id": 22,
      "start": 17169.42,
      "end": 17171.42,
      "formatted_start": "04:46:09.420",
      "formatted_end": "04:46:11.420",
      "text": "چیزهایی که مثل جله هستند"
    },
    {
      "id": 23,
      "start": 17171.42,
      "end": 17173.42,
      "formatted_start": "04:46:11.420",
      "formatted_end": "04:46:13.420",
      "text": "مثل گوچه کرمه"
    },
    {
      "id": 24,
      "start": 17173.42,
      "end": 17175.42,
      "formatted_start": "04:46:13.420",
      "formatted_end": "04:46:15.420",
      "text": "هست که یک کلمه باشه"
    },
    {
      "id": 25,
      "start": 17175.42,
      "end": 17177.42,
      "formatted_start": "04:46:15.420",
      "formatted_end": "04:46:17.420",
      "text": "از اونه بگیرن بگیرن"
    },
    {
      "id": 26,
      "start": 17177.42,
      "end": 17179.42,
      "formatted_start": "04:46:17.420",
      "formatted_end": "04:46:19.420",
      "text": "اون بخونه"
    },
    {
      "id": 27,
      "start": 17179.42,
      "end": 17181.42,
      "formatted_start": "04:46:19.420",
      "formatted_end": "04:46:21.420",
      "text": "کمات ها اونها که باشند"
    },
    {
      "id": 28,
      "start": 17181.42,
      "end": 17183.42,
      "formatted_start": "04:46:21.420",
      "formatted_end": "04:46:23.420",
      "text": "مثل ویرسه"
    },
    {
      "id": 29,
      "start": 17183.42,
      "end": 17188.1,
      "formatted_start": "04:46:23.420",
      "formatted_end": "04:46:28.100",
      "text": "اونا لیمه نیست که بابا فقط شما پماد دکتوفینک بیمست با پماد پیروکسیکا"
    },
    {
      "id": 30,
      "start": 17188.1,
      "end": 17190.3,
      "formatted_start": "04:46:28.100",
      "formatted_end": "04:46:30.300",
      "text": "اونا آزاد همجیبت بشونید"
    },
    {
      "id": 31,
      "start": 17190.3,
      "end": 17192.82,
      "formatted_start": "04:46:30.300",
      "formatted_end": "04:46:32.820",
      "text": "خب باشه دست دردن"
    },
    {
      "id": 32,
      "start": 17192.82,
      "end": 17195.2,
      "formatted_start": "04:46:32.820",
      "formatted_end": "04:46:35.200",
      "text": "من فرست رو تو بینار نمیشتم"
    },
    {
      "id": 33,
      "start": 17195.2,
      "end": 17197.46,
      "formatted_start": "04:46:35.200",
      "formatted_end": "04:46:37.460",
      "text": "خوش کنید تو نمرد دو هفته بخوایید خب"
    },
    {
      "id": 34,
      "start": 17197.46,
      "end": 17200.88,
      "formatted_start": "04:46:37.460",
      "formatted_end": "04:46:40.880",
      "text": "بعد خورس فشارتون رو از این بعد مرتب بخوایید"
    },
    {
      "id": 35,
      "start": 17200.88,
      "end": 17202.22,
      "formatted_start": "04:46:40.880",
      "formatted_end": "04:46:42.220",
      "text": "چشم دیگه برم"
    },
    {
      "id": 36,
      "start": 17202.22,
      "end": 17203.66,
      "formatted_start": "04:46:42.220",
      "formatted_end": "04:46:43.660",
      "text": "خوفی آماده شد که خواستیم"
    },
    {
      "id": 37,
      "start": 17203.66,
      "end": 17204.42,
      "formatted_start": "04:46:43.660",
      "formatted_end": "04:46:44.420",
      "text": "خواستیم"
    },
    {
      "id": 38,
      "start": 17204.42,
      "end": 17206.42,
      "formatted_start": "04:46:44.420",
      "formatted_end": "04:46:46.420",
      "text": "خانم زن شوهر رو بگیر نخوایید"
    },
    {
      "id": 39,
      "start": 17206.42,
      "end": 17208.42,
      "formatted_start": "04:46:46.420",
      "formatted_end": "04:46:48.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 40,
      "start": 17208.42,
      "end": 17210.42,
      "formatted_start": "04:46:48.420",
      "formatted_end": "04:46:50.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 41,
      "start": 17210.42,
      "end": 17212.42,
      "formatted_start": "04:46:50.420",
      "formatted_end": "04:46:52.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 42,
      "start": 17212.42,
      "end": 17214.42,
      "formatted_start": "04:46:52.420",
      "formatted_end": "04:46:54.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 43,
      "start": 17214.42,
      "end": 17216.42,
      "formatted_start": "04:46:54.420",
      "formatted_end": "04:46:56.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 44,
      "start": 17216.42,
      "end": 17218.42,
      "formatted_start": "04:46:56.420",
      "formatted_end": "04:46:58.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 45,
      "start": 17218.42,
      "end": 17220.42,
      "formatted_start": "04:46:58.420",
      "formatted_end": "04:47:00.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 46,
      "start": 17220.42,
      "end": 17222.42,
      "formatted_start": "04:47:00.420",
      "formatted_end": "04:47:02.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 47,
      "start": 17222.42,
      "end": 17224.42,
      "formatted_start": "04:47:02.420",
      "formatted_end": "04:47:04.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 48,
      "start": 17224.42,
      "end": 17226.42,
      "formatted_start": "04:47:04.420",
      "formatted_end": "04:47:06.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 49,
      "start": 17226.42,
      "end": 17228.42,
      "formatted_start": "04:47:06.420",
      "formatted_end": "04:47:08.420",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 50,
      "start": 17228.42,
      "end": 17230.42,
      "formatted_start": "04:47:08.420",
      "formatted_end": "04:47:10.420",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 51,
      "start": 17235.42,
      "end": 17237.42,
      "formatted_start": "04:47:15.420",
      "formatted_end": "04:47:17.420",
      "text": "خوش خانم، کبهتون شربه"
    },
    {
      "id": 52,
      "start": 17237.42,
      "end": 17239.42,
      "formatted_start": "04:47:17.420",
      "formatted_end": "04:47:19.420",
      "text": "مال من راستی که کبهت هم چطوری بزنیم؟"
    },
    {
      "id": 53,
      "start": 17239.42,
      "end": 17241.42,
      "formatted_start": "04:47:19.420",
      "formatted_end": "04:47:21.420",
      "text": "اون مهم نیست، اون گفته بود که یکم خشن شده"
    },
    {
      "id": 54,
      "start": 17241.42,
      "end": 17243.42,
      "formatted_start": "04:47:21.420",
      "formatted_end": "04:47:23.420",
      "text": "ولی آزمایشتون خوب بود"
    },
    {
      "id": 55,
      "start": 17243.42,
      "end": 17245.42,
      "formatted_start": "04:47:23.420",
      "formatted_end": "04:47:25.420",
      "text": "آه، خواهد نارا شد، دست داریم"
    },
    {
      "id": 56,
      "start": 17245.42,
      "end": 17247.42,
      "formatted_start": "04:47:25.420",
      "formatted_end": "04:47:27.420",
      "text": "کبهت چرب یک ذره داری، یکم حتما پیاده رویتون بکن"
    },
    {
      "id": 57,
      "start": 17247.42,
      "end": 17249.42,
      "formatted_start": "04:47:27.420",
      "formatted_end": "04:47:29.420",
      "text": "و سرخ کردنی، چرب و چیلی"
    },
    {
      "id": 58,
      "start": 17249.42,
      "end": 17252.42,
      "formatted_start": "04:47:29.420",
      "formatted_end": "04:47:32.420",
      "text": "نخور، روغن فقط یکم زیتون استفاده کن"
    },
    {
      "id": 59,
      "start": 17252.42,
      "end": 17259.42,
      "formatted_start": "04:47:32.420",
      "formatted_end": "04:47:39.420",
      "text": "این هایی استفاده نکن، روغمایی رو جامد استفاده نکن، تخمه ها و تخمه پلستر نشابه این ها استفاده نکن"
    },
    {
      "id": 60,
      "start": 17259.42,
      "end": 17268.42,
      "formatted_start": "04:47:39.420",
      "formatted_end": "04:47:48.420",
      "text": "کبت خوبه، فقط شرب شده، تحال خوبه، کلیه ها خوبه، سالمه، رحم افتادگی داره"
    },
    {
      "id": 61,
      "start": 17268.42,
      "end": 17272.42,
      "formatted_start": "04:47:48.420",
      "formatted_end": "04:47:52.420",
      "text": "حالا اگه اینکه رحمت میاد، پایین مثالت بادمانه هست"
    },
    {
      "id": 62,
      "start": 17272.42,
      "end": 17284.42,
      "formatted_start": "04:47:52.420",
      "formatted_end": "04:48:04.420",
      "text": "این بچه خانم این کشون در خانم درخشی های خانمی کشون خانم توشی نت یاد باره اینو کشون رو بردمش و برد که با این دارو خوب بشه"
    },
    {
      "id": 63,
      "start": 17284.42,
      "end": 17286.42,
      "formatted_start": "04:48:04.420",
      "formatted_end": "04:48:06.420",
      "text": "آره من نگرد خودم که کشون رو ببینم"
    },
    {
      "id": 64,
      "start": 17286.42,
      "end": 17290.42,
      "formatted_start": "04:48:06.420",
      "formatted_end": "04:48:10.420",
      "text": "ما اونو میتونیم ببینیم داروی چه اینو من نیمیتونم ببینم"
    },
    {
      "id": 65,
      "start": 17290.42,
      "end": 17296.42,
      "formatted_start": "04:48:10.420",
      "formatted_end": "04:48:16.420",
      "text": "این خودش خودم که نگاه کرد اینو ببینم اما اینو خود بشید آره اینو ببینیم"
    },
    {
      "id": 66,
      "start": 17296.42,
      "end": 17298.42,
      "formatted_start": "04:48:16.420",
      "formatted_end": "04:48:18.420",
      "text": "اونا باید سلا کنیم"
    },
    {
      "id": 67,
      "start": 17298.42,
      "end": 17300.42,
      "formatted_start": "04:48:18.420",
      "formatted_end": "04:48:20.420",
      "text": "آره اونو دارو خودی میتونه نگاه کنه"
    },
    {
      "id": 68,
      "start": 17302.42,
      "end": 17304.42,
      "formatted_start": "04:48:22.420",
      "formatted_end": "04:48:24.420",
      "text": "اگر ببینم هاجخاندار رو خونه میبینم"
    },
    {
      "id": 69,
      "start": 17304.42,
      "end": 17306.42,
      "formatted_start": "04:48:24.420",
      "formatted_end": "04:48:26.420",
      "text": "هاجخاندار چربی تنبال است"
    },
    {
      "id": 70,
      "start": 17306.42,
      "end": 17308.42,
      "formatted_start": "04:48:26.420",
      "formatted_end": "04:48:28.420",
      "text": "در همین کبده چربه"
    },
    {
      "id": 71,
      "start": 17308.42,
      "end": 17310.42,
      "formatted_start": "04:48:28.420",
      "formatted_end": "04:48:30.420",
      "text": "رایت نمیکنه"
    },
    {
      "id": 72,
      "start": 17310.42,
      "end": 17312.42,
      "formatted_start": "04:48:30.420",
      "formatted_end": "04:48:32.420",
      "text": "چه کافره؟"
    },
    {
      "id": 73,
      "start": 17312.42,
      "end": 17314.42,
      "formatted_start": "04:48:32.420",
      "formatted_end": "04:48:34.420",
      "text": "نه زیاد رایت نمیکنه"
    },
    {
      "id": 74,
      "start": 17314.42,
      "end": 17316.42,
      "formatted_start": "04:48:34.420",
      "formatted_end": "04:48:36.420",
      "text": "راست میگیم"
    },
    {
      "id": 75,
      "start": 17316.42,
      "end": 17318.42,
      "formatted_start": "04:48:36.420",
      "formatted_end": "04:48:38.420",
      "text": "گرساش که تمام بشه"
    },
    {
      "id": 76,
      "start": 17318.42,
      "end": 17320.42,
      "formatted_start": "04:48:38.420",
      "formatted_end": "04:48:40.420",
      "text": "مثلا چرمیاش دیگه نمیخوره"
    },
    {
      "id": 77,
      "start": 17320.42,
      "end": 17322.42,
      "formatted_start": "04:48:40.420",
      "formatted_end": "04:48:42.420",
      "text": "باید بگیریم بگیریم"
    },
    {
      "id": 78,
      "start": 17322.42,
      "end": 17324.42,
      "formatted_start": "04:48:42.420",
      "formatted_end": "04:48:44.420",
      "text": "باید مقعدت بکنیم"
    },
    {
      "id": 79,
      "start": 17324.42,
      "end": 17326.42,
      "formatted_start": "04:48:44.420",
      "formatted_end": "04:48:46.420",
      "text": "یا به خودتون ستم نکنه"
    },
    {
      "id": 80,
      "start": 17326.42,
      "end": 17328.42,
      "formatted_start": "04:48:46.420",
      "formatted_end": "04:48:48.420",
      "text": "الان میگوید این پیرمرده در جنش آن شد"
    },
    {
      "id": 81,
      "start": 17328.42,
      "end": 17330.42,
      "formatted_start": "04:48:48.420",
      "formatted_end": "04:48:50.420",
      "text": "سر سال شده"
    },
    {
      "id": 82,
      "start": 17330.42,
      "end": 17332.42,
      "formatted_start": "04:48:50.420",
      "formatted_end": "04:48:52.420",
      "text": "اینجا موش بده که نکنه من خواستش دارم"
    },
    {
      "id": 83,
      "start": 17332.42,
      "end": 17333.42,
      "formatted_start": "04:48:52.420",
      "formatted_end": "04:48:53.420",
      "text": "آف خاره"
    },
    {
      "id": 84,
      "start": 17333.42,
      "end": 17335.42,
      "formatted_start": "04:48:53.420",
      "formatted_end": "04:48:55.420",
      "text": "خلاکی، آنها برای چی برد بخونه؟"
    },
    {
      "id": 85,
      "start": 17335.42,
      "end": 17337.42,
      "formatted_start": "04:48:55.420",
      "formatted_end": "04:48:57.420",
      "text": "چقدر تونن بالاست؟"
    },
    {
      "id": 86,
      "start": 17337.42,
      "end": 17339.42,
      "formatted_start": "04:48:57.420",
      "formatted_end": "04:48:59.420",
      "text": "مادر و در تو من داشتن"
    },
    {
      "id": 87,
      "start": 17339.42,
      "end": 17343.42,
      "formatted_start": "04:48:59.420",
      "formatted_end": "04:49:03.420",
      "text": "نه، نه، ما طایفه مایتوان از این تیزا همه راحت بودم"
    },
    {
      "id": 88,
      "start": 17343.42,
      "end": 17346.42,
      "formatted_start": "04:49:03.420",
      "formatted_end": "04:49:06.420",
      "text": "با خیلی حرصه چوش کردم، از اونجا دارم این بنده باشیم"
    },
    {
      "id": 89,
      "start": 17346.42,
      "end": 17349.42,
      "formatted_start": "04:49:06.420",
      "formatted_end": "04:49:09.420",
      "text": "آره، بند، چربی، کبد، همه با هم"
    },
    {
      "id": 90,
      "start": 17349.42,
      "end": 17351.42,
      "formatted_start": "04:49:09.420",
      "formatted_end": "04:49:11.420",
      "text": "نه، نه، نه"
    },
    {
      "id": 91,
      "start": 17351.42,
      "end": 17355.42,
      "formatted_start": "04:49:11.420",
      "formatted_end": "04:49:15.420",
      "text": "باید خیلی رایه کنی، یکم مدل غذا پخدنتو عوض کنه"
    },
    {
      "id": 92,
      "start": 17360.42,
      "end": 17362.42,
      "formatted_start": "04:49:20.420",
      "formatted_end": "04:49:22.420",
      "text": "باید باید برداشتیم"
    },
    {
      "id": 93,
      "start": 17362.42,
      "end": 17364.42,
      "formatted_start": "04:49:22.420",
      "formatted_end": "04:49:24.420",
      "text": "امتحانات اینجور همه شده دارم"
    },
    {
      "id": 94,
      "start": 17364.42,
      "end": 17365.42,
      "formatted_start": "04:49:24.420",
      "formatted_end": "04:49:25.420",
      "text": "آره"
    },
    {
      "id": 95,
      "start": 17365.42,
      "end": 17368.42,
      "formatted_start": "04:49:25.420",
      "formatted_end": "04:49:28.420",
      "text": "همینجور خیلی بیشت همینجور برداشت"
    },
    {
      "id": 96,
      "start": 17368.42,
      "end": 17370.42,
      "formatted_start": "04:49:28.420",
      "formatted_end": "04:49:30.420",
      "text": "الان پنج زنی میبه باشه خب"
    },
    {
      "id": 97,
      "start": 17370.42,
      "end": 17372.42,
      "formatted_start": "04:49:30.420",
      "formatted_end": "04:49:32.420",
      "text": "تو که روشن میکنیم"
    },
    {
      "id": 98,
      "start": 17372.42,
      "end": 17374.42,
      "formatted_start": "04:49:32.420",
      "formatted_end": "04:49:34.420",
      "text": "از اون خیلی نفردم"
    },
    {
      "id": 99,
      "start": 17374.42,
      "end": 17375.42,
      "formatted_start": "04:49:34.420",
      "formatted_end": "04:49:35.420",
      "text": "بگو منو درما بگیرم"
    },
    {
      "id": 100,
      "start": 17375.42,
      "end": 17377.42,
      "formatted_start": "04:49:35.420",
      "formatted_end": "04:49:37.420",
      "text": "ولی کم خالق صرفی باز خوبه"
    },
    {
      "id": 101,
      "start": 17377.42,
      "end": 17379.42,
      "formatted_start": "04:49:37.420",
      "formatted_end": "04:49:39.420",
      "text": "موقعی نفرده که درد داری؟"
    },
    {
      "id": 102,
      "start": 17379.42,
      "end": 17380.42,
      "formatted_start": "04:49:39.420",
      "formatted_end": "04:49:40.420",
      "text": "درد دارم"
    },
    {
      "id": 103,
      "start": 17380.42,
      "end": 17382.42,
      "formatted_start": "04:49:40.420",
      "formatted_end": "04:49:42.420",
      "text": "اصلا انگار نه انگار هست"
    },
    {
      "id": 104,
      "start": 17382.42,
      "end": 17384.42,
      "formatted_start": "04:49:42.420",
      "formatted_end": "04:49:44.420",
      "text": "باید برداشتیم"
    },
    {
      "id": 105,
      "start": 17384.42,
      "end": 17387.92,
      "formatted_start": "04:49:44.420",
      "formatted_end": "04:49:47.920",
      "text": "و ترشوهاتون برقیم بردور خارش دارید؟"
    },
    {
      "id": 106,
      "start": 17387.92,
      "end": 17389.92,
      "formatted_start": "04:49:47.920",
      "formatted_end": "04:49:49.920",
      "text": "نه، اونجوران دسته مردیست"
    },
    {
      "id": 107,
      "start": 17392.92,
      "end": 17395.92,
      "formatted_start": "04:49:52.920",
      "formatted_end": "04:49:55.920",
      "text": "اینگه به خاطر یاسه شدید، خوش شدید، خوب؟"
    },
    {
      "id": 108,
      "start": 17395.92,
      "end": 17398.92,
      "formatted_start": "04:49:55.920",
      "formatted_end": "04:49:58.920",
      "text": "این پاماتو به نفس اونی وقت را استفاده کنید، بله"
    }
  ],
  "status": "completed"
}