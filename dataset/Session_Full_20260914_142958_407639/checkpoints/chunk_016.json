  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4802.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:02.000",
      "text": "کار داریم؟"
    },
    {
      "id": 1,
      "start": 4802.0,
      "end": 4804.0,
      "formatted_start": "01:20:02.000",
      "formatted_end": "01:20:04.000",
      "text": "خب، چه کار میخوای بکنیم؟"
    },
    {
      "id": 2,
      "start": 4804.0,
      "end": 4808.0,
      "formatted_start": "01:20:04.000",
      "formatted_end": "01:20:08.000",
      "text": "کار داری که خطرناکه وقتی دردش اینقدر شدید میشه."
    },
    {
      "id": 3,
      "start": 4808.0,
      "end": 4815.0,
      "formatted_start": "01:20:08.000",
      "formatted_end": "01:20:15.000",
      "text": "این وقت ممکنه پاره بشه، مثل کار چیز دیگه، داروی اینجایی نیست که بخواهش کنه کلا."
    },
    {
      "id": 4,
      "start": 4815.0,
      "end": 4817.0,
      "formatted_start": "01:20:15.000",
      "formatted_end": "01:20:17.000",
      "text": "حالا، تا کار رو میدونیم اشتخاب داریم؟"
    },
    {
      "id": 5,
      "start": 4817.0,
      "end": 4822.0,
      "formatted_start": "01:20:17.000",
      "formatted_end": "01:20:22.000",
      "text": "آره، حالا من صورتگرافه کرد و پیت بخورم، میرسام تا آخر برش وقت داریم."
    },
    {
      "id": 6,
      "start": 4822.0,
      "end": 4825.0,
      "formatted_start": "01:20:22.000",
      "formatted_end": "01:20:25.000",
      "text": "ببینید تا آخر برش رسیدی برو دیگه، خب؟"
    },
    {
      "id": 7,
      "start": 4825.0,
      "end": 4825.5,
      "formatted_start": "01:20:25.000",
      "formatted_end": "01:20:25.500",
      "text": "خوب؟"
    },
    {
      "id": 8,
      "start": 4825.5,
      "end": 4826.0,
      "formatted_start": "01:20:25.500",
      "formatted_end": "01:20:26.000",
      "text": "خوش"
    },
    {
      "id": 9,
      "start": 4826.0,
      "end": 4829.0,
      "formatted_start": "01:20:26.000",
      "formatted_end": "01:20:29.000",
      "text": "برای یه قرص نیستم میتونید از اینکه ارتعابشو کم کنیم"
    },
    {
      "id": 10,
      "start": 4829.0,
      "end": 4831.0,
      "formatted_start": "01:20:29.000",
      "formatted_end": "01:20:31.000",
      "text": "برای خوب قطعا نمی کند"
    },
    {
      "id": 11,
      "start": 4831.0,
      "end": 4834.0,
      "formatted_start": "01:20:31.000",
      "formatted_end": "01:20:34.000",
      "text": "اون پیسایت دوباره قطع شد خبرا بشو کنیم"
    },
    {
      "id": 12,
      "start": 4834.0,
      "end": 4837.0,
      "formatted_start": "01:20:34.000",
      "formatted_end": "01:20:37.000",
      "text": "شما برو قرص دو زن رو تو راه باز کنید"
    },
    {
      "id": 13,
      "start": 4837.0,
      "end": 4839.0,
      "formatted_start": "01:20:37.000",
      "formatted_end": "01:20:39.000",
      "text": "تا باشیم از صناتو تن"
    },
    {
      "id": 14,
      "start": 4839.0,
      "end": 4840.0,
      "formatted_start": "01:20:39.000",
      "formatted_end": "01:20:40.000",
      "text": "خوش"
    },
    {
      "id": 15,
      "start": 4840.0,
      "end": 4842.0,
      "formatted_start": "01:20:40.000",
      "formatted_end": "01:20:42.000",
      "text": "الان قندم بالا یا باز؟"
    },
    {
      "id": 16,
      "start": 4842.0,
      "end": 4844.0,
      "formatted_start": "01:20:42.000",
      "formatted_end": "01:20:44.000",
      "text": "نه فقط ناشتاد اون روز بالا بوده"
    },
    {
      "id": 17,
      "start": 4844.0,
      "end": 4846.0,
      "formatted_start": "01:20:44.000",
      "formatted_end": "01:20:46.000",
      "text": "سماهاتو خوبه شیشه قندت خوبه"
    },
    {
      "id": 18,
      "start": 4846.0,
      "end": 4848.0,
      "formatted_start": "01:20:46.000",
      "formatted_end": "01:20:48.000",
      "text": "چربیت هم خوب بود"
    },
    {
      "id": 19,
      "start": 4848.0,
      "end": 4850.0,
      "formatted_start": "01:20:48.000",
      "formatted_end": "01:20:50.000",
      "text": "کلیت هم خوب بود"
    },
    {
      "id": 20,
      "start": 4850.0,
      "end": 4851.0,
      "formatted_start": "01:20:50.000",
      "formatted_end": "01:20:51.000",
      "text": "ممنون"
    },
    {
      "id": 21,
      "start": 4851.0,
      "end": 4853.0,
      "formatted_start": "01:20:51.000",
      "formatted_end": "01:20:53.000",
      "text": "باید بشیم"
    },
    {
      "id": 22,
      "start": 4881.0,
      "end": 4909.0,
      "formatted_start": "01:21:21.000",
      "formatted_end": "01:21:49.000",
      "text": "موسیقی"
    },
    {
      "id": 23,
      "start": 4911.0,
      "end": 4914.5,
      "formatted_start": "01:21:51.000",
      "formatted_end": "01:21:54.500",
      "text": "خیلی بهش گفتم نمیخواهم سستم. من خواستم سستم خودمون میزنم"
    },
    {
      "id": 24,
      "start": 4914.5,
      "end": 4915.5,
      "formatted_start": "01:21:54.500",
      "formatted_end": "01:21:55.500",
      "text": "اون شما وصلیستی؟"
    },
    {
      "id": 25,
      "start": 4915.5,
      "end": 4916.0,
      "formatted_start": "01:21:55.500",
      "formatted_end": "01:21:56.000",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 4916.0,
      "end": 4917.5,
      "formatted_start": "01:21:56.000",
      "formatted_end": "01:21:57.500",
      "text": "چرا برمنه وصلیه؟"
    },
    {
      "id": 27,
      "start": 4917.5,
      "end": 4918.5,
      "formatted_start": "01:21:57.500",
      "formatted_end": "01:21:58.500",
      "text": "احمای"
    },
    {
      "id": 28,
      "start": 4918.5,
      "end": 4919.5,
      "formatted_start": "01:21:58.500",
      "formatted_end": "01:21:59.500",
      "text": "باید بهش میاد خواهید کنی؟"
    },
    {
      "id": 29,
      "start": 4919.5,
      "end": 4920.5,
      "formatted_start": "01:21:59.500",
      "formatted_end": "01:22:00.500",
      "text": "نه هیچی"
    },
    {
      "id": 30,
      "start": 4920.5,
      "end": 4921.5,
      "formatted_start": "01:22:00.500",
      "formatted_end": "01:22:01.500",
      "text": "اون نه نیوزی قد خودی؟"
    },
    {
      "id": 31,
      "start": 4921.5,
      "end": 4922.5,
      "formatted_start": "01:22:01.500",
      "formatted_end": "01:22:02.500",
      "text": "نه نه"
    },
    {
      "id": 32,
      "start": 4922.5,
      "end": 4923.5,
      "formatted_start": "01:22:02.500",
      "formatted_end": "01:22:03.500",
      "text": "به چاپی نمیبخواهم"
    },
    {
      "id": 33,
      "start": 4923.5,
      "end": 4925.5,
      "formatted_start": "01:22:03.500",
      "formatted_end": "01:22:05.500",
      "text": "نه پولم گفته"
    },
    {
      "id": 34,
      "start": 4927.5,
      "end": 4929.5,
      "formatted_start": "01:22:07.500",
      "formatted_end": "01:22:09.500",
      "text": "باید بشه کاری کنی"
    },
    {
      "id": 35,
      "start": 4929.5,
      "end": 4930.5,
      "formatted_start": "01:22:09.500",
      "formatted_end": "01:22:10.500",
      "text": "اینکه نه باشه که میگیر"
    },
    {
      "id": 36,
      "start": 4930.5,
      "end": 4931.5,
      "formatted_start": "01:22:10.500",
      "formatted_end": "01:22:11.500",
      "text": "بشه بشه بشه"
    },
    {
      "id": 37,
      "start": 4931.5,
      "end": 4932.5,
      "formatted_start": "01:22:11.500",
      "formatted_end": "01:22:12.500",
      "text": "باید بشه"
    },
    {
      "id": 38,
      "start": 4932.5,
      "end": 4933.5,
      "formatted_start": "01:22:12.500",
      "formatted_end": "01:22:13.500",
      "text": "باید بشه"
    },
    {
      "id": 39,
      "start": 4933.5,
      "end": 4963.5,
      "formatted_start": "01:22:13.500",
      "formatted_end": "01:22:43.500",
      "text": "باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برد"
    },
    {
      "id": 40,
      "start": 4963.5,
      "end": 4965.5,
      "formatted_start": "01:22:43.500",
      "formatted_end": "01:22:45.500",
      "text": "باید رو باشیم دوربین ها رو ببینم"
    },
    {
      "id": 41,
      "start": 4965.5,
      "end": 4967.5,
      "formatted_start": "01:22:45.500",
      "formatted_end": "01:22:47.500",
      "text": "فقط به این دلیل خریدن"
    },
    {
      "id": 42,
      "start": 4971.5,
      "end": 4973.5,
      "formatted_start": "01:22:51.500",
      "formatted_end": "01:22:53.500",
      "text": "چون سرعت پایده دوربین ها نمیاد رو باشیم"
    },
    {
      "id": 43,
      "start": 4973.5,
      "end": 4975.5,
      "formatted_start": "01:22:53.500",
      "formatted_end": "01:22:55.500",
      "text": "میخواد وقتی بخونم اصلا دوربین ها فرار باشیم"
    },
    {
      "id": 44,
      "start": 4977.5,
      "end": 4979.5,
      "formatted_start": "01:22:57.500",
      "formatted_end": "01:22:59.500",
      "text": "حسن هم ندارید یا جاویه پایین بشیم؟"
    },
    {
      "id": 45,
      "start": 4979.5,
      "end": 4981.5,
      "formatted_start": "01:22:59.500",
      "formatted_end": "01:23:01.500",
      "text": "پیشیم پایین"
    },
    {
      "id": 46,
      "start": 4981.5,
      "end": 4983.5,
      "formatted_start": "01:23:01.500",
      "formatted_end": "01:23:03.500",
      "text": "پیشیم بشیم"
    },
    {
      "id": 47,
      "start": 4983.5,
      "end": 4985.5,
      "formatted_start": "01:23:03.500",
      "formatted_end": "01:23:05.500",
      "text": "از ناظره از استریکو هست"
    },
    {
      "id": 48,
      "start": 4985.5,
      "end": 4987.5,
      "formatted_start": "01:23:05.500",
      "formatted_end": "01:23:07.500",
      "text": "۵۵ سال باید دلیگر هستیم"
    },
    {
      "id": 49,
      "start": 4987.5,
      "end": 4989.5,
      "formatted_start": "01:23:07.500",
      "formatted_end": "01:23:09.500",
      "text": "الان نه زدیم"
    },
    {
      "id": 50,
      "start": 4989.5,
      "end": 4991.5,
      "formatted_start": "01:23:09.500",
      "formatted_end": "01:23:11.500",
      "text": "خوش برده چند؟"
    },
    {
      "id": 51,
      "start": 4991.5,
      "end": 4994.5,
      "formatted_start": "01:23:11.500",
      "formatted_end": "01:23:14.500",
      "text": "آزمایششو بگید پشت روزما ساته نینام داره"
    },
    {
      "id": 52,
      "start": 4994.5,
      "end": 4996.5,
      "formatted_start": "01:23:14.500",
      "formatted_end": "01:23:16.500",
      "text": "پشت آزمایششو نمیشتم"
    },
    {
      "id": 53,
      "start": 4996.5,
      "end": 4998.5,
      "formatted_start": "01:23:16.500",
      "formatted_end": "01:23:18.500",
      "text": "پشت آزمایششو نمیشتم"
    },
    {
      "id": 54,
      "start": 4998.5,
      "end": 5001.5,
      "formatted_start": "01:23:18.500",
      "formatted_end": "01:23:21.500",
      "text": "این آزمایش تروجه چند داره؟"
    },
    {
      "id": 55,
      "start": 5001.5,
      "end": 5004.5,
      "formatted_start": "01:23:21.500",
      "formatted_end": "01:23:24.500",
      "text": "ازاره چارده یازده"
    },
    {
      "id": 56,
      "start": 5004.5,
      "end": 5006.5,
      "formatted_start": "01:23:24.500",
      "formatted_end": "01:23:26.500",
      "text": "چارده یازده داره بودم"
    },
    {
      "id": 57,
      "start": 5006.5,
      "end": 5008.5,
      "formatted_start": "01:23:26.500",
      "formatted_end": "01:23:28.500",
      "text": "که تروید هم گفته بود بالای بینیم"
    },
    {
      "id": 58,
      "start": 5008.5,
      "end": 5009.5,
      "formatted_start": "01:23:28.500",
      "formatted_end": "01:23:29.500",
      "text": "چارده یازده؟"
    },
    {
      "id": 59,
      "start": 5009.5,
      "end": 5011.5,
      "formatted_start": "01:23:29.500",
      "formatted_end": "01:23:31.500",
      "text": "هاسته یه لحظه قرن بوده"
    },
    {
      "id": 60,
      "start": 5011.5,
      "end": 5013.5,
      "formatted_start": "01:23:31.500",
      "formatted_end": "01:23:33.500",
      "text": "بیا پایین اینجا"
    },
    {
      "id": 61,
      "start": 5013.5,
      "end": 5015.5,
      "formatted_start": "01:23:33.500",
      "formatted_end": "01:23:35.500",
      "text": "آزمایی کبتت خوبه"
    },
    {
      "id": 62,
      "start": 5015.5,
      "end": 5017.5,
      "formatted_start": "01:23:35.500",
      "formatted_end": "01:23:37.500",
      "text": "چربیت بالا بوده"
    },
    {
      "id": 63,
      "start": 5017.5,
      "end": 5019.5,
      "formatted_start": "01:23:37.500",
      "formatted_end": "01:23:39.500",
      "text": "برای چی بوده؟"
    },
    {
      "id": 64,
      "start": 5019.5,
      "end": 5021.5,
      "formatted_start": "01:23:39.500",
      "formatted_end": "01:23:41.500",
      "text": "دارویین یا چیزی نداده"
    },
    {
      "id": 65,
      "start": 5021.5,
      "end": 5023.5,
      "formatted_start": "01:23:41.500",
      "formatted_end": "01:23:43.500",
      "text": "لیلا اسلامی رفتم"
    },
    {
      "id": 66,
      "start": 5023.5,
      "end": 5025.5,
      "formatted_start": "01:23:43.500",
      "formatted_end": "01:23:45.500",
      "text": "تیمتت خیلی بالا نبوده"
    },
    {
      "id": 67,
      "start": 5025.5,
      "end": 5027.5,
      "formatted_start": "01:23:45.500",
      "formatted_end": "01:23:47.500",
      "text": "بعد صد داده بود"
    },
    {
      "id": 68,
      "start": 5027.5,
      "end": 5029.5,
      "formatted_start": "01:23:47.500",
      "formatted_end": "01:23:49.500",
      "text": "بعد شاهرود که رفتم دکتور"
    },
    {
      "id": 69,
      "start": 5029.5,
      "end": 5031.5,
      "formatted_start": "01:23:49.500",
      "formatted_end": "01:23:51.500",
      "text": "برای چی بود؟"
    },
    {
      "id": 70,
      "start": 5031.5,
      "end": 5033.5,
      "formatted_start": "01:23:51.500",
      "formatted_end": "01:23:53.500",
      "text": "پنجه میخوردم"
    },
    {
      "id": 71,
      "start": 5033.5,
      "end": 5035.5,
      "formatted_start": "01:23:53.500",
      "formatted_end": "01:23:55.500",
      "text": "شاهرود پاس این آزمایش های جدید نوشتن"
    },
    {
      "id": 72,
      "start": 5035.5,
      "end": 5037.5,
      "formatted_start": "01:23:55.500",
      "formatted_end": "01:23:57.500",
      "text": "جدید نوشتن"
    },
    {
      "id": 73,
      "start": 5037.5,
      "end": 5039.5,
      "formatted_start": "01:23:57.500",
      "formatted_end": "01:23:59.500",
      "text": "پسیبش"
    },
    {
      "id": 74,
      "start": 5039.5,
      "end": 5041.5,
      "formatted_start": "01:23:59.500",
      "formatted_end": "01:24:01.500",
      "text": "پسیبش رو مادرم پیش شما"
    },
    {
      "id": 75,
      "start": 5041.5,
      "end": 5043.5,
      "formatted_start": "01:24:01.500",
      "formatted_end": "01:24:03.500",
      "text": "مامانم خیلی ترکیب داشت که برو پیش با دکتر من"
    },
    {
      "id": 76,
      "start": 5043.5,
      "end": 5045.5,
      "formatted_start": "01:24:03.500",
      "formatted_end": "01:24:05.500",
      "text": "الان جدید هست"
    },
    {
      "id": 77,
      "start": 5045.5,
      "end": 5049.5,
      "formatted_start": "01:24:05.500",
      "formatted_end": "01:24:09.500",
      "text": "بگو بگو سپیده برای زیاد بوده همون 50 تا تو جمعه هایی نخور باشه"
    },
    {
      "id": 78,
      "start": 5049.5,
      "end": 5051.5,
      "formatted_start": "01:24:09.500",
      "formatted_end": "01:24:11.500",
      "text": "خصوصا هارم بد میشده"
    },
    {
      "id": 79,
      "start": 5051.5,
      "end": 5053.5,
      "formatted_start": "01:24:11.500",
      "formatted_end": "01:24:13.500",
      "text": "خستهی"
    },
    {
      "id": 80,
      "start": 5053.5,
      "end": 5055.5,
      "formatted_start": "01:24:13.500",
      "formatted_end": "01:24:15.500",
      "text": "نه بیهایی میشده"
    },
    {
      "id": 81,
      "start": 5055.5,
      "end": 5057.5,
      "formatted_start": "01:24:15.500",
      "formatted_end": "01:24:17.500",
      "text": "50 رو از این بخور"
    },
    {
      "id": 82,
      "start": 5057.5,
      "end": 5059.5,
      "formatted_start": "01:24:17.500",
      "formatted_end": "01:24:19.500",
      "text": "به جمعه هایی نخوری باشه"
    },
    {
      "id": 83,
      "start": 5059.5,
      "end": 5061.5,
      "formatted_start": "01:24:19.500",
      "formatted_end": "01:24:21.500",
      "text": "50 پس شد"
    },
    {
      "id": 84,
      "start": 5061.5,
      "end": 5063.5,
      "formatted_start": "01:24:21.500",
      "formatted_end": "01:24:23.500",
      "text": "اینو اینجا بلیمیسم که بدونیم"
    },
    {
      "id": 85,
      "start": 5063.5,
      "end": 5065.5,
      "formatted_start": "01:24:23.500",
      "formatted_end": "01:24:25.500",
      "text": "50 روزانه"
    },
    {
      "id": 86,
      "start": 5065.5,
      "end": 5067.5,
      "formatted_start": "01:24:25.500",
      "formatted_end": "01:24:27.500",
      "text": "به جز دیدم"
    },
    {
      "id": 87,
      "start": 5067.5,
      "end": 5069.5,
      "formatted_start": "01:24:27.500",
      "formatted_end": "01:24:29.500",
      "text": "اینو باشه که سپیده داده دادن"
    },
    {
      "id": 88,
      "start": 5069.5,
      "end": 5071.5,
      "formatted_start": "01:24:29.500",
      "formatted_end": "01:24:31.500",
      "text": "همینو کامل بودی"
    },
    {
      "id": 89,
      "start": 5071.5,
      "end": 5073.5,
      "formatted_start": "01:24:31.500",
      "formatted_end": "01:24:33.500",
      "text": "سپیده یا"
    },
    {
      "id": 90,
      "start": 5073.5,
      "end": 5076.5,
      "formatted_start": "01:24:33.500",
      "formatted_end": "01:24:36.500",
      "text": "تمنش نگه گفت اینو نداره با سپیده؟"
    },
    {
      "id": 91,
      "start": 5076.5,
      "end": 5078.5,
      "formatted_start": "01:24:36.500",
      "formatted_end": "01:24:38.500",
      "text": "بازم نمونست"
    },
    {
      "id": 92,
      "start": 5078.5,
      "end": 5081.5,
      "formatted_start": "01:24:38.500",
      "formatted_end": "01:24:41.500",
      "text": "چیکار کنیم نگه؟ هم تو میفرستم و میگیم دیگه"
    },
    {
      "id": 93,
      "start": 5081.5,
      "end": 5087.5,
      "formatted_start": "01:24:41.500",
      "formatted_end": "01:24:47.500",
      "text": "نه، پس جامعه ها نفرد، هر روز بخور کلمه ها بود، تراب تراب چه، سویا شغل هم نمیخوری"
    },
    {
      "id": 94,
      "start": 5087.5,
      "end": 5091.5,
      "formatted_start": "01:24:47.500",
      "formatted_end": "01:24:51.500",
      "text": "صبح باستو بخوری، یک ساعت ناشته ای تو لطفا نگه دار"
    },
    {
      "id": 95,
      "start": 5091.5,
      "end": 5094.5,
      "formatted_start": "01:24:51.500",
      "formatted_end": "01:24:54.500",
      "text": "پس میگم وقتی برای نماز و صبح برم میشی بخور"
    },
    {
      "id": 96,
      "start": 5094.5,
      "end": 5097.5,
      "formatted_start": "01:24:54.500",
      "formatted_end": "01:24:57.500",
      "text": "ما برای این میگیم که نیزه بعدش پزا نمونیم"
    }
  ],
  "status": "completed"
}