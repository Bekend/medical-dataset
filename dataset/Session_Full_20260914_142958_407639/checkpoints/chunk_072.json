  "stt_segments": [
    {
      "id": 0,
      "start": 21600.0,
      "end": 21604.0,
      "formatted_start": "06:00:00.000",
      "formatted_end": "06:00:04.000",
      "text": "این شمک در آخر اینجا شد یا بوده ای؟"
    },
    {
      "id": 1,
      "start": 21604.0,
      "end": 21605.0,
      "formatted_start": "06:00:04.000",
      "formatted_end": "06:00:05.000",
      "text": "برای چیجه؟"
    },
    {
      "id": 2,
      "start": 21605.0,
      "end": 21606.0,
      "formatted_start": "06:00:05.000",
      "formatted_end": "06:00:06.000",
      "text": "در شویه اونجا بود."
    },
    {
      "id": 3,
      "start": 21606.0,
      "end": 21611.0,
      "formatted_start": "06:00:06.000",
      "formatted_end": "06:00:11.000",
      "text": "نه در شویه اونجا رو اترگه خورده، ماشالله خیلی خوب بود، از سیسران تا قربه هم نمی‌رده، ازیت هم نمی‌کرد."
    },
    {
      "id": 4,
      "start": 21611.0,
      "end": 21613.0,
      "formatted_start": "06:00:11.000",
      "formatted_end": "06:00:13.000",
      "text": "حالا ما چند بزه؟"
    },
    {
      "id": 5,
      "start": 21613.0,
      "end": 21617.0,
      "formatted_start": "06:00:13.000",
      "formatted_end": "06:00:17.000",
      "text": "نه در خانده بودم، اونجا اینجا آمده، بیا همینجا یه جکه هم."
    },
    {
      "id": 6,
      "start": 21617.0,
      "end": 21619.0,
      "formatted_start": "06:00:17.000",
      "formatted_end": "06:00:19.000",
      "text": "حالا مانده بود؟"
    },
    {
      "id": 7,
      "start": 21619.0,
      "end": 21621.0,
      "formatted_start": "06:00:19.000",
      "formatted_end": "06:00:21.000",
      "text": "نه پرونت نداره."
    },
    {
      "id": 8,
      "start": 21621.0,
      "end": 21627.0,
      "formatted_start": "06:00:21.000",
      "formatted_end": "06:00:27.000",
      "text": "نه، آقا من این را فیلم هم داشتم، خودتون اینجور بودند، بیا باشد لازم باشد، یک آدم باشند"
    },
    {
      "id": 9,
      "start": 21633.0,
      "end": 21635.0,
      "formatted_start": "06:00:33.000",
      "formatted_end": "06:00:35.000",
      "text": "آم باچین جان"
    },
    {
      "id": 10,
      "start": 21647.0,
      "end": 21649.0,
      "formatted_start": "06:00:47.000",
      "formatted_end": "06:00:49.000",
      "text": "قبل من هم صدا را اوکنه تا اید را که داشتیم"
    },
    {
      "id": 11,
      "start": 21649.0,
      "end": 21655.0,
      "formatted_start": "06:00:49.000",
      "formatted_end": "06:00:55.000",
      "text": "در آزم باشم اصلا درد ندارم تا بخوا بلند باشم"
    },
    {
      "id": 12,
      "start": 21655.0,
      "end": 21659.0,
      "formatted_start": "06:00:55.000",
      "formatted_end": "06:00:59.000",
      "text": "این باز بشتر میشه که گرفته که کمر باشه"
    },
    {
      "id": 13,
      "start": 21659.0,
      "end": 21661.0,
      "formatted_start": "06:00:59.000",
      "formatted_end": "06:01:01.000",
      "text": "کبدتان خیلی چرد بوده"
    },
    {
      "id": 14,
      "start": 21661.0,
      "end": 21662.0,
      "formatted_start": "06:01:01.000",
      "formatted_end": "06:01:02.000",
      "text": "چند؟ دو؟"
    },
    {
      "id": 15,
      "start": 21662.0,
      "end": 21664.0,
      "formatted_start": "06:01:02.000",
      "formatted_end": "06:01:04.000",
      "text": "سه، دو، بی سه"
    },
    {
      "id": 16,
      "start": 21664.0,
      "end": 21666.0,
      "formatted_start": "06:01:04.000",
      "formatted_end": "06:01:06.000",
      "text": "سنگ کلیه هم آخوا داشتیم"
    },
    {
