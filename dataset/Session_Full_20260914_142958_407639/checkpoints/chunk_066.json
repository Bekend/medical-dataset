  "stt_segments": [
    {
      "id": 0,
      "start": 19800.0,
      "end": 19808.0,
      "formatted_start": "05:30:00.000",
      "formatted_end": "05:30:08.000",
      "text": "اما از این وقت ها اشتباه زیاد که اینو میخورن، این خیلی تا حالت کف میشه، تمام راه هوایی پر کف میشه."
    },
    {
      "id": 1,
      "start": 19808.0,
      "end": 19814.0,
      "formatted_start": "05:30:08.000",
      "formatted_end": "05:30:14.000",
      "text": "یک مایه بزنی، یک ظرفی و خوب، و در دویر وقت ها تو مجموع میشنن با برونکوسکووی، تمام اون راه ها رو بشورن."
    },
    {
      "id": 2,
      "start": 19814.0,
      "end": 19821.0,
      "formatted_start": "05:30:14.000",
      "formatted_end": "05:30:21.000",
      "text": "اونقدر پر میشه، به سطح تنفس رو میاره پایین، ارتقال عوار کم داره."
    },
    {
      "id": 3,
      "start": 19821.0,
      "end": 19823.5,
      "formatted_start": "05:30:21.000",
      "formatted_end": "05:30:23.500",
      "text": "سردی نداریم که بلاو هم بزرگ می کنیم"
    },
    {
      "id": 4,
      "start": 19823.5,
      "end": 19824.7,
      "formatted_start": "05:30:23.500",
      "formatted_end": "05:30:24.700",
      "text": "سردی نداریم که خیلی زیادی بود"
    },
    {
      "id": 5,
      "start": 19824.7,
      "end": 19825.7,
      "formatted_start": "05:30:24.700",
      "formatted_end": "05:30:25.700",
      "text": "پنجامه تویی"
    },
    {
      "id": 6,
      "start": 19825.7,
      "end": 19827.2,
      "formatted_start": "05:30:25.700",
      "formatted_end": "05:30:27.200",
      "text": "چند تا پل نمی روی بالا؟"
    },
    {
      "id": 7,
      "start": 19827.2,
      "end": 19829.0,
      "formatted_start": "05:30:27.200",
      "formatted_end": "05:30:29.000",
      "text": "همین پل را بیان بالا می کنه"
    },
    {
      "id": 8,
      "start": 19829.0,
      "end": 19830.2,
      "formatted_start": "05:30:29.000",
      "formatted_end": "05:30:30.200",
      "text": "پس تا پس بزنم"
    },
    {
      "id": 9,
      "start": 19830.2,
      "end": 19832.2,
      "formatted_start": "05:30:30.200",
      "formatted_end": "05:30:32.200",
      "text": "چیزم ندارن اخوان"
    },
    {
      "id": 10,
      "start": 19832.2,
      "end": 19833.7,
      "formatted_start": "05:30:32.200",
      "formatted_end": "05:30:33.700",
      "text": "دوتو و فعالیت هم اونقدر ندارن"
    },
    {
      "id": 11,
      "start": 19833.7,
      "end": 19835.0,
      "formatted_start": "05:30:33.700",
      "formatted_end": "05:30:35.000",
      "text": "فعالیت ربطی نداره"
    },
    {
      "id": 12,
      "start": 19835.0,
      "end": 19838.0,
      "formatted_start": "05:30:35.000",
      "formatted_end": "05:30:38.000",
      "text": "سردی چقدر می توانید بره؟"
    },
    {
      "id": 13,
      "start": 19838.0,
      "end": 19839.0,
      "formatted_start": "05:30:38.000",
      "formatted_end": "05:30:39.000",
      "text": "سردی نیست"
    },
    {
      "id": 14,
      "start": 19839.0,
      "end": 19840.0,
      "formatted_start": "05:30:39.000",
      "formatted_end": "05:30:40.000",
      "text": "از سردی دیگه ایست"
    },
    {
      "id": 15,
      "start": 19840.0,
      "end": 19842.0,
      "formatted_start": "05:30:40.000",
      "formatted_end": "05:30:42.000",
      "text": "از اینکه اونکه می توانید فهم نیست"
    },
    {
      "id": 16,
      "start": 19842.0,
      "end": 19845.5,
      "formatted_start": "05:30:42.000",
      "formatted_end": "05:30:45.500",
      "text": "یا کار مردمشون، الان کارشون اینقدر مثلا راحته"
    },
    {
      "id": 17,
      "start": 19845.5,
      "end": 19847.24,
      "formatted_start": "05:30:45.500",
      "formatted_end": "05:30:47.240",
      "text": "دیروی این تخت هم، از اون رو موتور هند"
    },
    {
      "id": 18,
      "start": 19847.24,
      "end": 19849.5,
      "formatted_start": "05:30:47.240",
      "formatted_end": "05:30:49.500",
      "text": "خب، پایین کلیدی رو بزنن که موتورهای هوا روشن بشه"
    },
    {
      "id": 19,
      "start": 19849.5,
      "end": 19851.5,
      "formatted_start": "05:30:49.500",
      "formatted_end": "05:30:51.500",
      "text": "خب، این از کار مردمشون"
    },
    {
      "id": 20,
      "start": 19851.5,
      "end": 19854.5,
      "formatted_start": "05:30:51.500",
      "formatted_end": "05:30:54.500",
      "text": "بعد روزهایی که بیکاری دو روز هم خونند، دو روز هم گره اجانس"
    },
    {
      "id": 21,
      "start": 19854.5,
      "end": 19858.0,
      "formatted_start": "05:30:54.500",
      "formatted_end": "05:30:58.000",
      "text": "هیچ فعالیت بدنی ندارند، تأثیر نداره"
    },
    {
      "id": 22,
      "start": 19858.0,
      "end": 19860.0,
      "formatted_start": "05:30:58.000",
      "formatted_end": "05:31:00.000",
      "text": "الان محسن شده، افتاده باشی؟"
    },
    {
      "id": 23,
      "start": 19860.0,
      "end": 19862.0,
      "formatted_start": "05:31:00.000",
      "formatted_end": "05:31:02.000",
      "text": "من که چیزی بگو فرستن کنم"
    },
    {
      "id": 24,
      "start": 19862.0,
      "end": 19863.0,
      "formatted_start": "05:31:02.000",
      "formatted_end": "05:31:03.000",
      "text": "نه نه"
    },
    {
      "id": 25,
      "start": 19863.0,
      "end": 19865.44,
      "formatted_start": "05:31:03.000",
      "formatted_end": "05:31:05.440",
      "text": "از اینجوری گفتی درست برده بکنی"
    },
    {
      "id": 26,
      "start": 19865.44,
      "end": 19867.34,
      "formatted_start": "05:31:05.440",
      "formatted_end": "05:31:07.340",
      "text": "میخوای درست به ترتیله اینجا درست کشته"
    },
    {
      "id": 27,
      "start": 19867.34,
      "end": 19867.84,
      "formatted_start": "05:31:07.340",
      "formatted_end": "05:31:07.840",
      "text": "نه نه"
    },
    {
      "id": 28,
      "start": 19867.84,
      "end": 19870.14,
      "formatted_start": "05:31:07.840",
      "formatted_end": "05:31:10.140",
      "text": "اما پدر خودم فوق هم دوری پدر خودم میگرد اینجا"
    },
    {
      "id": 29,
      "start": 19870.14,
      "end": 19871.06,
      "formatted_start": "05:31:10.140",
      "formatted_end": "05:31:11.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 30,
      "start": 19871.06,
      "end": 19872.06,
      "formatted_start": "05:31:11.060",
      "formatted_end": "05:31:12.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 31,
      "start": 19872.06,
      "end": 19873.06,
      "formatted_start": "05:31:12.060",
      "formatted_end": "05:31:13.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 32,
      "start": 19873.06,
      "end": 19874.06,
      "formatted_start": "05:31:13.060",
      "formatted_end": "05:31:14.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 33,
      "start": 19874.06,
      "end": 19875.06,
      "formatted_start": "05:31:14.060",
      "formatted_end": "05:31:15.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 34,
      "start": 19875.06,
      "end": 19876.06,
      "formatted_start": "05:31:15.060",
      "formatted_end": "05:31:16.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 35,
      "start": 19876.06,
      "end": 19877.06,
      "formatted_start": "05:31:16.060",
      "formatted_end": "05:31:17.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 36,
      "start": 19877.06,
      "end": 19878.06,
      "formatted_start": "05:31:17.060",
      "formatted_end": "05:31:18.060",
      "text": "آقای معهوی ایگمون"
    },
    {
      "id": 37,
      "start": 19878.06,
      "end": 19880.06,
      "formatted_start": "05:31:18.060",
      "formatted_end": "05:31:20.060",
      "text": "در 13 سال رو مردم کار کرده"
    },
    {
      "id": 38,
      "start": 19880.06,
      "end": 19882.56,
      "formatted_start": "05:31:20.060",
      "formatted_end": "05:31:22.560",
      "text": "یه چیز باید بگم، اول توان آدمان اصلا"
    },
    {
      "id": 39,
      "start": 19882.56,
      "end": 19884.06,
      "formatted_start": "05:31:22.560",
      "formatted_end": "05:31:24.060",
      "text": "میگه چون خواهیت مردمی داره"
    },
    {
      "id": 40,
      "start": 19884.06,
      "end": 19886.06,
      "formatted_start": "05:31:24.060",
      "formatted_end": "05:31:26.060",
      "text": "نه میگه شاید یک نیش کار میکشه"
    },
    {
      "id": 41,
      "start": 19886.06,
      "end": 19888.06,
      "formatted_start": "05:31:26.060",
      "formatted_end": "05:31:28.060",
      "text": "یکی دور ازشون میده مردم"
    },
    {
      "id": 42,
      "start": 19888.06,
      "end": 19890.06,
      "formatted_start": "05:31:28.060",
      "formatted_end": "05:31:30.060",
      "text": "3 سال میده آشون شد"
    },
    {
      "id": 43,
      "start": 19890.06,
      "end": 19892.06,
      "formatted_start": "05:31:30.060",
      "formatted_end": "05:31:32.060",
      "text": "بعد 3 سال میاد با سه تاریه"
    },
    {
      "id": 44,
      "start": 19892.06,
      "end": 19894.06,
      "formatted_start": "05:31:32.060",
      "formatted_end": "05:31:34.060",
      "text": "خب ما اینجا داریم"
    },
    {
      "id": 45,
      "start": 19894.06,
      "end": 19896.06,
      "formatted_start": "05:31:34.060",
      "formatted_end": "05:31:36.060",
      "text": "ولی یکی میاد، الان اینجا میان تست"
    },
    {
      "id": 46,
      "start": 19896.06,
      "end": 19898.06,
      "formatted_start": "05:31:36.060",
      "formatted_end": "05:31:38.060",
      "text": "برای تندید کار مردمی"
    },
    {
      "id": 47,
      "start": 19898.06,
      "end": 19900.06,
      "formatted_start": "05:31:38.060",
      "formatted_end": "05:31:40.060",
      "text": "خب پیره مرده 70 ساله"
    },
    {
      "id": 48,
      "start": 19900.06,
      "end": 19902.06,
      "formatted_start": "05:31:40.060",
      "formatted_end": "05:31:42.060",
      "text": "دفعه دوباره 30 سال مردم کار کرده"
    },
    {
      "id": 49,
      "start": 19902.06,
      "end": 19905.06,
      "formatted_start": "05:31:42.060",
      "formatted_end": "05:31:45.060",
      "text": "مهمار، بودن داره میگیره"
    },
    {
      "id": 50,
      "start": 19905.06,
      "end": 19909.06,
      "formatted_start": "05:31:45.060",
      "formatted_end": "05:31:49.060",
      "text": "جبون میاد 20 سال است دو سال اقلیونی دیشه دیگه نداره"
    },
    {
      "id": 51,
      "start": 19909.06,
      "end": 19912.06,
      "formatted_start": "05:31:49.060",
      "formatted_end": "05:31:52.060",
      "text": "نمیتونی آدم ها رو با هم مقایسه کنی"
    },
    {
      "id": 52,
      "start": 19912.06,
      "end": 19915.06,
      "formatted_start": "05:31:52.060",
      "formatted_end": "05:31:55.060",
      "text": "نه من خودم احساس که مثلا یه چون باباشون کار کشورزی داره میکنه من یه نه"
    },
    {
      "id": 53,
      "start": 19915.06,
      "end": 19918.06,
      "formatted_start": "05:31:55.060",
      "formatted_end": "05:31:58.060",
      "text": "نه باباتون مثلا این زمانی بوده کارو کرده"
    },
    {
      "id": 54,
      "start": 19918.06,
      "end": 19920.06,
      "formatted_start": "05:31:58.060",
      "formatted_end": "05:32:00.060",
      "text": "تو این یه راحتی به فعالیت نداره"
    },
    {
      "id": 55,
      "start": 19920.06,
      "end": 19922.06,
      "formatted_start": "05:32:00.060",
      "formatted_end": "05:32:02.060",
      "text": "حجم ریا رو تو نمیتونی زیاد رو کم کنی"
    },
    {
      "id": 56,
      "start": 19922.06,
      "end": 19924.06,
      "formatted_start": "05:32:02.060",
      "formatted_end": "05:32:04.060",
      "text": "این ریاش بیبروز شده"
    },
    {
      "id": 57,
      "start": 19924.06,
      "end": 19930.06,
      "formatted_start": "05:32:04.060",
      "formatted_end": "05:32:10.060",
      "text": "الان بره اونو می کنیم، پنمی هم حتی یک سال دو سال مواجهه، ما کافیه برای این آسمه گردیم"
    },
    {
      "id": 58,
      "start": 19930.06,
      "end": 19934.06,
      "formatted_start": "05:32:10.060",
      "formatted_end": "05:32:14.060",
      "text": "بعد ریه شو صدا ش سیاده پرهواز کامل، ریه بگوش میدم"
    },
    {
      "id": 59,
      "start": 19934.06,
      "end": 19938.06,
      "formatted_start": "05:32:14.060",
      "formatted_end": "05:32:18.060",
      "text": "از این موقع که میخوابم صدا من مثلا صدای نفسدشی نمیشه، صدا من خیلی صدا ش برم"
    },
    {
      "id": 60,
      "start": 19938.06,
      "end": 19940.06,
      "formatted_start": "05:32:18.060",
      "formatted_end": "05:32:20.060",
      "text": "آره دیگه پرهواز آدمی هسته که این طریق نیست"
    },
    {
      "id": 61,
      "start": 19940.06,
      "end": 19942.06,
      "formatted_start": "05:32:20.060",
      "formatted_end": "05:32:22.060",
      "text": "این یک آسمه"
    },
    {
      "id": 62,
      "start": 19950.06,
      "end": 19952.06,
      "formatted_start": "05:32:30.060",
      "formatted_end": "05:32:32.060",
      "text": "اما اینه دردون که هیچی ندارن؟"
    },
    {
      "id": 63,
      "start": 19952.06,
      "end": 19955.06,
      "formatted_start": "05:32:32.060",
      "formatted_end": "05:32:35.060",
      "text": "نه، اولین خب دارو اگه بخورن پیشنفت نمی کنه"
    },
    {
      "id": 64,
      "start": 19955.06,
      "end": 19957.06,
      "formatted_start": "05:32:35.060",
      "formatted_end": "05:32:37.060",
      "text": "یک، دو، این که رو قلبشون پشانه"
    },
    {
      "id": 65,
      "start": 19957.06,
      "end": 19960.06,
      "formatted_start": "05:32:37.060",
      "formatted_end": "05:32:40.060",
      "text": "شما وقتی که بدن میخواد تصانی کنه"
    },
    {
      "id": 66,
      "start": 19960.06,
      "end": 19964.06,
      "formatted_start": "05:32:40.060",
      "formatted_end": "05:32:44.060",
      "text": "وقتی که راه هوایی تنگه، دورش خلته"
    },
    {
      "id": 67,
      "start": 19964.06,
      "end": 19966.06,
      "formatted_start": "05:32:44.060",
      "formatted_end": "05:32:46.060",
      "text": "باید تلاش بیشتری بکنه قبل"
    },
    {
      "id": 68,
      "start": 19966.06,
      "end": 19968.06,
      "formatted_start": "05:32:46.060",
      "formatted_end": "05:32:48.060",
      "text": "حالا اتفاقا بعد از اینکه ریش خوب شد"
    },
    {
      "id": 69,
      "start": 19968.06,
      "end": 19970.36,
      "formatted_start": "05:32:48.060",
      "formatted_end": "05:32:50.360",
      "text": "شد یه جایی رفته میره دوستانو تو بیت داشتن"
    },
    {
      "id": 70,
      "start": 19970.36,
      "end": 19971.82,
      "formatted_start": "05:32:50.360",
      "formatted_end": "05:32:51.820",
      "text": "گفت گفت گفت که صوت مهمیده"
    },
    {
      "id": 71,
      "start": 19971.82,
      "end": 19973.92,
      "formatted_start": "05:32:51.820",
      "formatted_end": "05:32:53.920",
      "text": "مگر با قلبش بشه همونه قلب رو بزرگ میشه"
    },
    {
      "id": 72,
      "start": 19973.92,
      "end": 19976.46,
      "formatted_start": "05:32:53.920",
      "formatted_end": "05:32:56.460",
      "text": "اینجوری همون بازی که قلب صوت برده صوتو کراهات"
    },
    {
      "id": 73,
      "start": 19976.46,
      "end": 19976.82,
      "formatted_start": "05:32:56.460",
      "formatted_end": "05:32:56.820",
      "text": "اینجوری همون بازی که کلب صوت برده صوتو کراهات"
    },
    {
      "id": 74,
      "start": 19976.82,
      "end": 19976.86,
      "formatted_start": "05:32:56.820",
      "formatted_end": "05:32:56.860",
      "text": "اینجوری همون بازی که کلب صوت برده صوتو کراهات"
    },
    {
      "id": 75,
      "start": 19976.86,
      "end": 19976.96,
      "formatted_start": "05:32:56.860",
      "formatted_end": "05:32:56.960",
      "text": "اینجوری همون بازی که کلب صوت برده صوتو کراهات"
    },
    {
      "id": 76,
      "start": 19976.96,
      "end": 19981.3,
      "formatted_start": "05:32:56.960",
      "formatted_end": "05:33:01.300",
      "text": "اگر بگم که دادرشونش دوره اتونش دیگه بیدار نمیشه"
    },
    {
      "id": 77,
      "start": 19981.3,
      "end": 19984.8,
      "formatted_start": "05:33:01.300",
      "formatted_end": "05:33:04.800",
      "text": "چون این وقتی هواه دیگه خب یه پرس سراخ میشه"
    },
    {
      "id": 78,
      "start": 19984.8,
      "end": 19986.64,
      "formatted_start": "05:33:04.800",
      "formatted_end": "05:33:06.640",
      "text": "خب یه دفعه باد میکنی باد میکنه"
    },
    {
      "id": 79,
      "start": 19986.64,
      "end": 19988.72,
      "formatted_start": "05:33:06.640",
      "formatted_end": "05:33:08.720",
      "text": "اینجا تراش هست میچستونه قلب"
    },
    {
      "id": 80,
      "start": 19988.72,
      "end": 19990.76,
      "formatted_start": "05:33:08.720",
      "formatted_end": "05:33:10.760",
      "text": "من اینجا بفترم که"
    },
    {
      "id": 81,
      "start": 19990.76,
      "end": 19992.32,
      "formatted_start": "05:33:10.760",
      "formatted_end": "05:33:12.320",
      "text": "اینجا من به شما بفترم بفترم"
    },
    {
      "id": 82,
      "start": 19992.32,
      "end": 19994.38,
      "formatted_start": "05:33:12.320",
      "formatted_end": "05:33:14.380",
      "text": "خب بفترم نکنه زدن ریشت سراخ کرده شما"
    },
    {
      "id": 83,
      "start": 19994.38,
      "end": 19995.68,
      "formatted_start": "05:33:14.380",
      "formatted_end": "05:33:15.680",
      "text": "من بفترم نه این حال برم نزدن"
    },
    {
      "id": 84,
      "start": 19995.68,
      "end": 19997.64,
      "formatted_start": "05:33:15.680",
      "formatted_end": "05:33:17.640",
      "text": "بعد من استاده کردیم گفتیم بیا داخل"
    },
    {
      "id": 85,
      "start": 19997.64,
      "end": 19998.94,
      "formatted_start": "05:33:17.640",
      "formatted_end": "05:33:18.940",
      "text": "شوهردت نگه دستند"
    },
    {
      "id": 86,
      "start": 19998.94,
      "end": 20028.94,
      "formatted_start": "05:33:18.940",
      "formatted_end": "05:33:48.940",
      "text": "من که مطمئن بودم ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت راخ شده که از ریشت"
    },
    {
      "id": 87,
      "start": 20028.94,
      "end": 20031.48,
      "formatted_start": "05:33:48.940",
      "formatted_end": "05:33:51.480",
      "text": "خیلی شایعه من خیلی برونبوسکوپی میترسم"
    },
    {
      "id": 88,
      "start": 20031.48,
      "end": 20032.88,
      "formatted_start": "05:33:51.480",
      "formatted_end": "05:33:52.880",
      "text": "خب اونه نمیدونستین؟"
    },
    {
      "id": 89,
      "start": 20032.88,
      "end": 20034.94,
      "formatted_start": "05:33:52.880",
      "formatted_end": "05:33:54.940",
      "text": "چاره اینست دیگه تو برونکوپای تشکیل سازم"
    },
    {
      "id": 90,
      "start": 20034.94,
      "end": 20039.24,
      "formatted_start": "05:33:54.940",
      "formatted_end": "05:33:59.240",
      "text": "خب گوابه جام آمد دیگه بعد آقای دوز رو گفتم که آقای جوابش چی شد و هیچ مشکلی نداشت"
    },
    {
      "id": 91,
      "start": 20039.24,
      "end": 20043.92,
      "formatted_start": "05:33:59.240",
      "formatted_end": "05:34:03.920",
      "text": "موقعی که رفته بودیم بود من اینجا یه چیزون میبینم یا این بپرست یا تو دست"
    },
    {
      "id": 92,
      "start": 20043.92,
      "end": 20045.38,
      "formatted_start": "05:34:03.920",
      "formatted_end": "05:34:05.380",
      "text": "خب چیزون دارن؟"
    },
    {
      "id": 93,
      "start": 20045.38,
      "end": 20050.62,
      "formatted_start": "05:34:05.380",
      "formatted_end": "05:34:10.620",
      "text": "دارم چی میگم؟ میگم از مدنی همه میتوستن چون خیلی دوشون سرزنستن"
    },
    {
      "id": 94,
      "start": 20050.62,
      "end": 20054.1,
      "formatted_start": "05:34:10.620",
      "formatted_end": "05:34:14.100",
      "text": "ولی بونبوسکوپی کلن کار فردن، هر کسی قبول هم نمی کنه"
    },
    {
      "id": 95,
      "start": 20054.1,
      "end": 20057.3,
      "formatted_start": "05:34:14.100",
      "formatted_end": "05:34:17.300",
      "text": "از این طور توی آنسان سه نفر انجام میدن بونبوسکوپی و"
    },
    {
      "id": 96,
      "start": 20057.3,
      "end": 20061.94,
      "formatted_start": "05:34:17.300",
      "formatted_end": "05:34:21.940",
      "text": "به خاطر یک کار پرخطی هست، یک پزشکی میگو بلش کنن، این کار انجام میدن، هر که میلد می کنن"
    },
    {
      "id": 97,
      "start": 20061.94,
      "end": 20065.62,
      "formatted_start": "05:34:21.940",
      "formatted_end": "05:34:25.620",
      "text": "آدم ها کمی قبول می کنن انجام ندارن، چون برای تو چه صرفی داره؟"
    },
    {
      "id": 98,
      "start": 20065.62,
      "end": 20067.62,
      "formatted_start": "05:34:25.620",
      "formatted_end": "05:34:27.620",
      "text": "و اصلا تو بگو نیه بزرگی سر میرن دارید"
    },
    {
      "id": 99,
      "start": 20067.62,
      "end": 20068.62,
      "formatted_start": "05:34:27.620",
      "formatted_end": "05:34:28.620",
      "text": "و این راست میرزد"
    },
    {
      "id": 100,
      "start": 20068.62,
      "end": 20070.62,
      "formatted_start": "05:34:28.620",
      "formatted_end": "05:34:30.620",
      "text": "خیلی کم ها انجام میدونیم"
    },
    {
      "id": 101,
      "start": 20070.62,
      "end": 20072.62,
      "formatted_start": "05:34:30.620",
      "formatted_end": "05:34:32.620",
      "text": "چون توی مرگ این بر آدم آتی همیست"
    },
    {
      "id": 102,
      "start": 20072.62,
