  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11429.98,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 11430.0,
      "end": 11460.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:11:00.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 2,
      "start": 11460.0,
      "end": 11462.0,
      "formatted_start": "03:11:00.000",
      "formatted_end": "03:11:02.000",
      "text": "بچه زودتر استفاده کن که میترسن بزنن"
    },
    {
      "id": 3,
      "start": 11462.0,
      "end": 11463.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:03.000",
      "text": "برکره همشونه؟"
    },
    {
      "id": 4,
      "start": 11463.0,
      "end": 11465.0,
      "formatted_start": "03:11:03.000",
      "formatted_end": "03:11:05.000",
      "text": "برکره همشونه، برکره همشونه، برکره همشونه"
    },
    {
      "id": 5,
      "start": 11473.0,
      "end": 11476.0,
      "formatted_start": "03:11:13.000",
      "formatted_end": "03:11:16.000",
      "text": "شبت دو همه منت از متب اومده"
    },
    {
      "id": 6,
      "start": 11476.0,
      "end": 11477.0,
      "formatted_start": "03:11:16.000",
      "formatted_end": "03:11:17.000",
      "text": "همه استفاده شونه؟"
    },
    {
      "id": 7,
      "start": 11477.0,
      "end": 11481.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:21.000",
      "text": "آر بگو که بگیرن به زنگ بزنن داروشو و زودتر شروع کنن"
    },
    {
      "id": 8,
      "start": 11481.0,
      "end": 11482.0,
      "formatted_start": "03:11:21.000",
      "formatted_end": "03:11:22.000",
      "text": "برکره همشونه"
    },
    {
      "id": 9,
      "start": 11486.0,
      "end": 11488.0,
      "formatted_start": "03:11:26.000",
      "formatted_end": "03:11:28.000",
      "text": "به خود چیز همه کتن سی زنگ بزن"
    },
    {
      "id": 10,
      "start": 11488.0,
      "end": 11490.0,
      "formatted_start": "03:11:28.000",
      "formatted_end": "03:11:30.000",
      "text": "مردم مستجم"
    },
    {
      "id": 11,
      "start": 11490.0,
      "end": 11492.0,
      "formatted_start": "03:11:30.000",
      "formatted_end": "03:11:32.000",
      "text": "مردم مستجم"
    },
    {
      "id": 12,
      "start": 11492.0,
      "end": 11494.0,
      "formatted_start": "03:11:32.000",
      "formatted_end": "03:11:34.000",
      "text": "خود خانوم باید بیرون چطور بچه چکنه"
    },
    {
      "id": 13,
      "start": 11494.0,
      "end": 11496.0,
      "formatted_start": "03:11:34.000",
      "formatted_end": "03:11:36.000",
      "text": "باش"
    },
    {
      "id": 14,
      "start": 11496.0,
      "end": 11498.0,
      "formatted_start": "03:11:36.000",
      "formatted_end": "03:11:38.000",
      "text": "برون حالش چطور رفت چکنه"
    },
    {
      "id": 15,
      "start": 11498.0,
      "end": 11500.0,
      "formatted_start": "03:11:38.000",
      "formatted_end": "03:11:40.000",
      "text": "چکنه"
    },
    {
      "id": 16,
      "start": 11500.0,
      "end": 11502.0,
      "formatted_start": "03:11:40.000",
      "formatted_end": "03:11:42.000",
      "text": "آراداره؟"
    },
    {
      "id": 17,
      "start": 11502.0,
      "end": 11504.0,
      "formatted_start": "03:11:42.000",
      "formatted_end": "03:11:44.000",
      "text": "مطلعه درش هستم"
    },
    {
      "id": 18,
      "start": 11504.0,
      "end": 11506.0,
      "formatted_start": "03:11:44.000",
      "formatted_end": "03:11:46.000",
      "text": "مطلعه درش هستم"
    },
    {
      "id": 19,
      "start": 11506.0,
      "end": 11508.0,
      "formatted_start": "03:11:46.000",
      "formatted_end": "03:11:48.000",
      "text": "مطلعه درش هستم"
    },
    {
      "id": 20,
      "start": 11508.0,
      "end": 11510.0,
      "formatted_start": "03:11:48.000",
      "formatted_end": "03:11:50.000",
      "text": "عریف کردی؟"
    },
    {
      "id": 21,
      "start": 11510.0,
      "end": 11512.0,
      "formatted_start": "03:11:50.000",
      "formatted_end": "03:11:52.000",
      "text": "عریف"
    },
    {
      "id": 22,
      "start": 11512.0,
      "end": 11514.0,
      "formatted_start": "03:11:52.000",
      "formatted_end": "03:11:54.000",
      "text": "بچه اول اتره؟"
    },
    {
      "id": 23,
      "start": 11514.0,
      "end": 11516.0,
      "formatted_start": "03:11:54.000",
      "formatted_end": "03:11:56.000",
      "text": "بچه اول اتره"
    },
    {
      "id": 24,
      "start": 11516.0,
      "end": 11516.7,
      "formatted_start": "03:11:56.000",
      "formatted_end": "03:11:56.700",
      "text": "هفته یه؟"
    },
    {
      "id": 25,
      "start": 11516.7,
      "end": 11518.0,
      "formatted_start": "03:11:56.700",
      "formatted_end": "03:11:58.000",
      "text": "برای هفته یه چار ده ها"
    },
    {
      "id": 26,
      "start": 11518.0,
      "end": 11520.94,
      "formatted_start": "03:11:58.000",
      "formatted_end": "03:12:00.940",
      "text": "قبل بارداری آزمایش ندادی؟"
    },
    {
      "id": 27,
      "start": 11520.94,
      "end": 11522.0,
      "formatted_start": "03:12:00.940",
      "formatted_end": "03:12:02.000",
      "text": "آزمایش ندادی"
    },
    {
      "id": 28,
      "start": 11522.0,
      "end": 11524.0,
      "formatted_start": "03:12:02.000",
      "formatted_end": "03:12:04.000",
      "text": "قبل بارداری آزمایش ندادی؟"
    },
    {
      "id": 29,
      "start": 11524.64,
      "end": 11526.7,
      "formatted_start": "03:12:04.640",
      "formatted_end": "03:12:06.700",
      "text": "قبل بارداری یادم نیست"
    },
    {
      "id": 30,
      "start": 11526.7,
      "end": 11528.9,
      "formatted_start": "03:12:06.700",
      "formatted_end": "03:12:08.900",
      "text": "چجوری این توی رفته آگی؟"
    },
    {
      "id": 31,
      "start": 11528.9,
      "end": 11530.4,
      "formatted_start": "03:12:08.900",
      "formatted_end": "03:12:10.400",
      "text": "آزمایش دادم دادم دادم"
    },
    {
      "id": 32,
      "start": 11530.4,
      "end": 11531.24,
      "formatted_start": "03:12:10.400",
      "formatted_end": "03:12:11.240",
      "text": "تو پرونده ها"
    },
    {
      "id": 33,
      "start": 11531.24,
      "end": 11533.58,
      "formatted_start": "03:12:11.240",
      "formatted_end": "03:12:13.580",
      "text": "اونجا تیویتت سادم بوده؟"
    },
    {
      "id": 34,
      "start": 11533.58,
      "end": 11534.0,
      "formatted_start": "03:12:13.580",
      "formatted_end": "03:12:14.000",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 11534.0,
      "end": 11536.66,
      "formatted_start": "03:12:14.000",
      "formatted_end": "03:12:16.660",
      "text": "افونت ادرالت هم خیلی شدید"
    },
    {
      "id": 36,
      "start": 11536.66,
      "end": 11537.9,
      "formatted_start": "03:12:16.660",
      "formatted_end": "03:12:17.900",
      "text": "دارو دار؟"
    },
    {
      "id": 37,
      "start": 11537.9,
      "end": 11538.58,
      "formatted_start": "03:12:17.900",
      "formatted_end": "03:12:18.580",
      "text": "دارو داد"
    },
    {
      "id": 38,
      "start": 11538.58,
      "end": 11540.0,
      "formatted_start": "03:12:18.580",
      "formatted_end": "03:12:20.000",
      "text": "آره؟"
    },
    {
      "id": 39,
      "start": 11540.52,
      "end": 11541.1,
      "formatted_start": "03:12:20.520",
      "formatted_end": "03:12:21.100",
      "text": "اونجا"
    },
    {
      "id": 40,
      "start": 11541.1,
      "end": 11543.44,
      "formatted_start": "03:12:21.100",
      "formatted_end": "03:12:23.440",
      "text": "خاندکتور بهت بردرتو انصافی"
    },
    {
      "id": 41,
      "start": 11543.44,
      "end": 11546.02,
      "formatted_start": "03:12:23.440",
      "formatted_end": "03:12:26.020",
      "text": "بعد افغانتتون رو برد آزمایش دارو دار؟"
    },
    {
      "id": 42,
      "start": 11546.02,
      "end": 11546.78,
      "formatted_start": "03:12:26.020",
      "formatted_end": "03:12:26.780",
      "text": "نه دار نه"
    },
    {
      "id": 43,
      "start": 11546.78,
      "end": 11548.02,
      "formatted_start": "03:12:26.780",
      "formatted_end": "03:12:28.020",
      "text": "نه دار؟"
    },
    {
      "id": 44,
      "start": 11548.02,
      "end": 11548.44,
      "formatted_start": "03:12:28.020",
      "formatted_end": "03:12:28.440",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 11549.18,
      "end": 11551.68,
      "formatted_start": "03:12:29.180",
      "formatted_end": "03:12:31.680",
      "text": "بعد برد خیلی افغانتت شده دار"
    },
    {
      "id": 46,
      "start": 11551.68,
      "end": 11554.76,
      "formatted_start": "03:12:31.680",
      "formatted_end": "03:12:34.760",
      "text": "ببین اینو باید تکرار کنی خب"
    },
    {
      "id": 47,
      "start": 11554.76,
      "end": 11557.64,
      "formatted_start": "03:12:34.760",
      "formatted_end": "03:12:37.640",
      "text": "برد گنبه انجام بدید"
    },
    {
      "id": 48,
      "start": 11557.64,
      "end": 11559.62,
      "formatted_start": "03:12:37.640",
      "formatted_end": "03:12:39.620",
      "text": "اما امروز فردا تا جوابش بیار"
    },
    {
      "id": 49,
      "start": 11559.62,
      "end": 11562.8,
      "formatted_start": "03:12:39.620",
      "formatted_end": "03:12:42.800",
      "text": "دستات همشه میدرده؟"
    },
    {
      "id": 50,
      "start": 11562.8,
      "end": 11563.98,
      "formatted_start": "03:12:42.800",
      "formatted_end": "03:12:43.980",
      "text": "همه دست هم میدرد"
    },
    {
      "id": 51,
      "start": 11563.98,
      "end": 11571.66,
      "formatted_start": "03:12:43.980",
      "formatted_end": "03:12:51.660",
      "text": "کلم، کاهو، تروب، ترابچه، سویا، شرقم، لبو نباید بخوری"
    },
    {
      "id": 52,
      "start": 11571.66,
      "end": 11572.82,
      "formatted_start": "03:12:51.660",
      "formatted_end": "03:12:52.820",
      "text": "بچه دیگه هم داری؟"
    },
    {
      "id": 53,
      "start": 11572.82,
      "end": 11574.82,
      "formatted_start": "03:12:52.820",
      "formatted_end": "03:12:54.820",
      "text": "نه، همین اولیه"
    },
    {
      "id": 54,
      "start": 11574.82,
      "end": 11576.82,
      "formatted_start": "03:12:54.820",
      "formatted_end": "03:12:56.820",
      "text": "اما مفتی شمه هفته شده؟"
    },
    {
      "id": 55,
      "start": 11576.82,
      "end": 11578.82,
      "formatted_start": "03:12:56.820",
      "formatted_end": "03:12:58.820",
      "text": "چهار ده هفته"
    },
    {
      "id": 56,
      "start": 11578.82,
      "end": 11580.82,
      "formatted_start": "03:12:58.820",
      "formatted_end": "03:13:00.820",
      "text": "قد داشت؟"
    },
    {
      "id": 57,
      "start": 11580.82,
      "end": 11582.82,
      "formatted_start": "03:13:00.820",
      "formatted_end": "03:13:02.820",
      "text": "دوتایش هم قد ده"
    },
    {
      "id": 58,
      "start": 11582.82,
      "end": 11584.82,
      "formatted_start": "03:13:02.820",
      "formatted_end": "03:13:04.820",
      "text": "برای میگم یک علتش دقلویه"
    },
    {
      "id": 59,
      "start": 11584.82,
      "end": 11586.82,
      "formatted_start": "03:13:04.820",
      "formatted_end": "03:13:06.820",
      "text": "اینو همینو ببینم"
    },
    {
      "id": 60,
      "start": 11586.82,
      "end": 11588.82,
      "formatted_start": "03:13:06.820",
      "formatted_end": "03:13:08.820",
      "text": "اینو برای دوتو برن کردیم نوشته بوده"
    },
    {
      "id": 61,
      "start": 11588.82,
      "end": 11590.82,
      "formatted_start": "03:13:08.820",
      "formatted_end": "03:13:10.820",
      "text": "برای چونگه من اونجا گرمده"
    },
    {
      "id": 62,
      "start": 11590.82,
      "end": 11592.82,
      "formatted_start": "03:13:10.820",
      "formatted_end": "03:13:12.820",
      "text": "من برنم بشو"
    },
    {
      "id": 63,
      "start": 11592.82,
      "end": 11594.82,
      "formatted_start": "03:13:12.820",
      "formatted_end": "03:13:14.820",
      "text": "آهان برام هم فرق نداره"
    },
    {
      "id": 64,
      "start": 11594.82,
      "end": 11596.82,
      "formatted_start": "03:13:14.820",
      "formatted_end": "03:13:16.820",
      "text": "برای بعضی باید نگرید چرا اونو"
    },
    {
      "id": 65,
      "start": 11596.82,
      "end": 11598.82,
      "formatted_start": "03:13:16.820",
      "formatted_end": "03:13:18.820",
      "text": "نه، من بهش میدم"
    },
    {
      "id": 66,
      "start": 11598.82,
      "end": 11600.82,
      "formatted_start": "03:13:18.820",
      "formatted_end": "03:13:20.820",
      "text": "تو سریتو بازده"
    },
    {
      "id": 67,
      "start": 11602.82,
      "end": 11604.82,
      "formatted_start": "03:13:22.820",
      "formatted_end": "03:13:24.820",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 68,
      "start": 11604.82,
      "end": 11606.82,
      "formatted_start": "03:13:24.820",
      "formatted_end": "03:13:26.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 69,
      "start": 11606.82,
      "end": 11608.82,
      "formatted_start": "03:13:26.820",
      "formatted_end": "03:13:28.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 70,
      "start": 11608.82,
      "end": 11610.82,
      "formatted_start": "03:13:28.820",
      "formatted_end": "03:13:30.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 71,
      "start": 11610.82,
      "end": 11612.82,
      "formatted_start": "03:13:30.820",
      "formatted_end": "03:13:32.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 72,
      "start": 11612.82,
      "end": 11614.82,
      "formatted_start": "03:13:32.820",
      "formatted_end": "03:13:34.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 73,
      "start": 11614.82,
      "end": 11616.82,
      "formatted_start": "03:13:34.820",
      "formatted_end": "03:13:36.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 74,
      "start": 11616.82,
      "end": 11618.82,
      "formatted_start": "03:13:36.820",
      "formatted_end": "03:13:38.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 75,
      "start": 11618.82,
      "end": 11620.82,
      "formatted_start": "03:13:38.820",
      "formatted_end": "03:13:40.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 76,
      "start": 11620.82,
      "end": 11622.82,
      "formatted_start": "03:13:40.820",
      "formatted_end": "03:13:42.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 77,
      "start": 11622.82,
      "end": 11624.82,
      "formatted_start": "03:13:42.820",
      "formatted_end": "03:13:44.820",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 78,
      "start": 11624.82,
      "end": 11626.82,
      "formatted_start": "03:13:44.820",
      "formatted_end": "03:13:46.820",
      "text": "یادم نیست، قرار تیره داشت"
    },
    {
      "id": 79,
      "start": 11626.82,
      "end": 11627.82,
      "formatted_start": "03:13:46.820",
      "formatted_end": "03:13:47.820",
      "text": "تیره داشت، نه"
    },
    {
      "id": 80,
      "start": 11627.82,
      "end": 11628.82,
      "formatted_start": "03:13:47.820",
      "formatted_end": "03:13:48.820",
      "text": "لاغره نکرده که؟"
    },
    {
      "id": 81,
      "start": 11628.82,
      "end": 11629.82,
      "formatted_start": "03:13:48.820",
      "formatted_end": "03:13:49.820",
      "text": "نه"
    },
    {
      "id": 82,
      "start": 11629.82,
      "end": 11630.82,
      "formatted_start": "03:13:49.820",
      "formatted_end": "03:13:50.820",
      "text": "بعد عرقا؟"
    },
    {
      "id": 83,
      "start": 11630.82,
      "end": 11632.82,
      "formatted_start": "03:13:50.820",
      "formatted_end": "03:13:52.820",
      "text": "هفته و سه کیلومتر"
    },
    {
      "id": 84,
      "start": 11632.82,
      "end": 11633.82,
      "formatted_start": "03:13:52.820",
      "formatted_end": "03:13:53.820",
      "text": "عرقا اینا زیاد نمی کنی؟"
    },
    {
      "id": 85,
      "start": 11633.82,
      "end": 11634.82,
      "formatted_start": "03:13:53.820",
      "formatted_end": "03:13:54.820",
      "text": "نه"
    },
    {
      "id": 86,
      "start": 11634.82,
      "end": 11635.82,
      "formatted_start": "03:13:54.820",
      "formatted_end": "03:13:55.820",
      "text": "تپش قرار نمی گیری؟"
    },
    {
      "id": 87,
      "start": 11635.82,
      "end": 11636.82,
      "formatted_start": "03:13:55.820",
      "formatted_end": "03:13:56.820",
      "text": "نه"
    },
    {
      "id": 88,
      "start": 11636.82,
      "end": 11638.82,
      "formatted_start": "03:13:56.820",
      "formatted_end": "03:13:58.820",
      "text": "خب اینو برو پردیس آزمایش بده خب؟"
    },
    {
      "id": 89,
      "start": 11638.82,
      "end": 11639.82,
      "formatted_start": "03:13:58.820",
      "formatted_end": "03:13:59.820",
      "text": "نمیشه سپید برم؟"
    },
    {
      "id": 90,
      "start": 11639.82,
      "end": 11642.82,
      "formatted_start": "03:13:59.820",
      "formatted_end": "03:14:02.820",
      "text": "نه، اصلا نه برای اینجا بریم"
    },
    {
      "id": 91,
      "start": 11645.82,
      "end": 11646.82,
      "formatted_start": "03:14:05.820",
      "formatted_end": "03:14:06.820",
      "text": "این آزمایش قبول نیست؟"
    },
    {
      "id": 92,
      "start": 11647.82,
      "end": 11650.82,
      "formatted_start": "03:14:07.820",
      "formatted_end": "03:14:10.820",
      "text": "باید حتما تکرار کنید، چون داروش داروی پرخطریه"
    },
    {
      "id": 93,
      "start": 11650.82,
      "end": 11654.82,
      "formatted_start": "03:14:10.820",
      "formatted_end": "03:14:14.820",
      "text": "خوب؟ برای نمیتونیم سریع با یک آزمایش شروع کنیم"
    },
    {
      "id": 94,
      "start": 11654.82,
      "end": 11657.82,
      "formatted_start": "03:14:14.820",
      "formatted_end": "03:14:17.820",
      "text": "خصوصا که قبل باردارید آزمایشت سالم بوده"
    },
    {
      "id": 95,
      "start": 11657.82,
      "end": 11658.82,
      "formatted_start": "03:14:17.820",
      "formatted_end": "03:14:18.820",
      "text": "بله"
    },
    {
      "id": 96,
      "start": 11658.82,
      "end": 11659.82,
      "formatted_start": "03:14:18.820",
      "formatted_end": "03:14:19.820",
      "text": "درسته؟"
    },
    {
      "id": 97,
      "start": 11659.82,
      "end": 11660.82,
      "formatted_start": "03:14:19.820",
      "formatted_end": "03:14:20.820",
      "text": "سالم بود"
    },
    {
      "id": 98,
      "start": 11660.82,
      "end": 11663.82,
      "formatted_start": "03:14:20.820",
      "formatted_end": "03:14:23.820",
      "text": "ولی خوش کن اوخنات ادارتو و شروع کن"
    },
    {
      "id": 99,
      "start": 11663.82,
      "end": 11670.82,
      "formatted_start": "03:14:23.820",
      "formatted_end": "03:14:30.820",
      "text": "برای جنین مشکلی نداره دورای اوخنات کنم؟"
    },
    {
      "id": 100,
      "start": 11670.82,
      "end": 11674.82,
      "formatted_start": "03:14:30.820",
      "formatted_end": "03:14:34.820",
      "text": "نه من یه چیز میدونستم مشکل نداشته باشه نکردم نداشته"
    },
    {
      "id": 101,
      "start": 11674.82,
      "end": 11676.82,
      "formatted_start": "03:14:34.820",
      "formatted_end": "03:14:36.820",
      "text": "خواست هم هستیم"
    },
    {
      "id": 102,
      "start": 11676.82,
      "end": 11682.82,
      "formatted_start": "03:14:36.820",
      "formatted_end": "03:14:42.820",
      "text": "الانم به خاطر که برای جنگ نگرانم نمیزارم قرص نمیخوام زود شروع کنیم"
    },
    {
      "id": 103,
      "start": 11682.82,
      "end": 11685.82,
      "formatted_start": "03:14:42.820",
      "formatted_end": "03:14:45.820",
      "text": "چون برای مهمه که جنگی چیز نخواهشه دیگه"
    },
    {
      "id": 104,
      "start": 11685.82,
      "end": 11689.82,
      "formatted_start": "03:14:45.820",
      "formatted_end": "03:14:49.820",
      "text": "بس هم مطمئنش هم و زود بهت دارو ندارم"
    },
    {
      "id": 105,
      "start": 11693.82,
      "end": 11696.82,
      "formatted_start": "03:14:53.820",
      "formatted_end": "03:14:56.820",
      "text": "مارس آدماشو پرسی بمیدید؟"
    },
    {
      "id": 106,
      "start": 11696.82,
      "end": 11699.82,
      "formatted_start": "03:14:56.820",
      "formatted_end": "03:14:59.820",
      "text": "آره انا میگم گرچه اونو برگردم"
    }
  ],
  "status": "completed"
}