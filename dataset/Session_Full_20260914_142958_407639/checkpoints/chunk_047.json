      "formatted_start": "03:55:44.000",
      "formatted_end": "03:55:46.000",
      "text": "از همین عموشت پان"
    },
    {
      "id": 7,
      "start": 14146.0,
      "end": 14148.0,
      "formatted_start": "03:55:46.000",
      "formatted_end": "03:55:48.000",
      "text": "میگه فقط آن پولی که داره"
    },
    {
      "id": 8,
      "start": 14148.0,
      "end": 14150.0,
      "formatted_start": "03:55:48.000",
      "formatted_end": "03:55:50.000",
      "text": "بعضی موقع با قرارزیت"
    },
    {
      "id": 9,
      "start": 14150.0,
      "end": 14152.0,
      "formatted_start": "03:55:50.000",
      "formatted_end": "03:55:52.000",
      "text": "فرو میکنه توی بدن من"
    },
    {
      "id": 10,
      "start": 14152.0,
      "end": 14154.0,
      "formatted_start": "03:55:52.000",
      "formatted_end": "03:55:54.000",
      "text": "سوزن سوزن"
    },
    {
      "id": 11,
      "start": 14154.0,
      "end": 14156.0,
      "formatted_start": "03:55:54.000",
      "formatted_end": "03:55:56.000",
      "text": "گوشت بدن منه"
    },
    {
      "id": 12,
      "start": 14156.0,
      "end": 14158.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:55:58.000",
      "text": "آب کرده یه دفعه"
    },
    {
      "id": 13,
      "start": 14160.0,
      "end": 14162.0,
      "formatted_start": "03:56:00.000",
      "formatted_end": "03:56:02.000",
      "text": "این رو بسیار سردن نداریم"
    },
    {
      "id": 14,
      "start": 14164.0,
      "end": 14166.0,
      "formatted_start": "03:56:04.000",
      "formatted_end": "03:56:06.000",
      "text": "تیکه غنده مادر"
    },
    {
      "id": 15,
      "start": 14166.0,
      "end": 14169.0,
      "formatted_start": "03:56:06.000",
      "formatted_end": "03:56:09.000",
      "text": "همه ای اصاباتو واقعا سوزنگ میزن از بینی"
    },
    {
      "id": 16,
      "start": 14169.0,
      "end": 14171.0,
      "formatted_start": "03:56:09.000",
      "formatted_end": "03:56:11.000",
      "text": "غندش خیلی برا بود"
    },
    {
      "id": 17,
      "start": 14171.0,
      "end": 14174.0,
      "formatted_start": "03:56:11.000",
      "formatted_end": "03:56:14.000",
      "text": "نه مالان دست ده درد نکنی اشاله خدا"
    },
    {
      "id": 18,
      "start": 14174.0,
      "end": 14178.0,
      "formatted_start": "03:56:14.000",
      "formatted_end": "03:56:18.000",
      "text": "سلامتید بده دروارت خیلی به من"
    },
    {
      "id": 19,
      "start": 14178.0,
      "end": 14180.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:20.000",
      "text": "آفرش بخور"
    },
    {
      "id": 20,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "خداحشت"
    },
    {
      "id": 21,
      "start": 14182.0,
      "end": 14184.0,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:24.000",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 14184.0,
      "end": 14187.0,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:27.000",
      "text": "550 الان رفتیس سری 21"
    },
    {
      "id": 23,
      "start": 14187.0,
      "end": 14189.0,
      "formatted_start": "03:56:27.000",
      "formatted_end": "03:56:29.000",
      "text": "خیلی"
    },
    {
      "id": 24,
      "start": 14202.0,
      "end": 14204.0,
      "formatted_start": "03:56:42.000",
      "formatted_end": "03:56:44.000",
      "text": "خودش مریضی خوب نیست"
    },
    {
      "id": 25,
      "start": 14204.0,
      "end": 14207.0,
      "formatted_start": "03:56:44.000",
      "formatted_end": "03:56:47.000",
      "text": "من می گفتم شاید میده منی، روده منی"
    },
    {
      "id": 26,
      "start": 14207.0,
      "end": 14211.0,
      "formatted_start": "03:56:47.000",
      "formatted_end": "03:56:51.000",
      "text": "اصلا دیگه سرطانو خیلی بده گرفتم دون کشم"
    },
    {
      "id": 27,
      "start": 14211.0,
      "end": 14213.0,
      "formatted_start": "03:56:51.000",
      "formatted_end": "03:56:53.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 28,
      "start": 14213.0,
      "end": 14215.0,
      "formatted_start": "03:56:53.000",
      "formatted_end": "03:56:55.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 29,
      "start": 14215.0,
      "end": 14217.0,
      "formatted_start": "03:56:55.000",
      "formatted_end": "03:56:57.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 30,
      "start": 14217.0,
      "end": 14219.0,
      "formatted_start": "03:56:57.000",
      "formatted_end": "03:56:59.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 31,
      "start": 14219.0,
      "end": 14221.0,
      "formatted_start": "03:56:59.000",
      "formatted_end": "03:57:01.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 32,
      "start": 14221.0,
      "end": 14223.0,
      "formatted_start": "03:57:01.000",
      "formatted_end": "03:57:03.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 33,
      "start": 14223.0,
      "end": 14225.0,
      "formatted_start": "03:57:03.000",
      "formatted_end": "03:57:05.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 34,
      "start": 14225.0,
      "end": 14227.0,
      "formatted_start": "03:57:05.000",
      "formatted_end": "03:57:07.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 35,
      "start": 14227.0,
      "end": 14229.0,
      "formatted_start": "03:57:07.000",
      "formatted_end": "03:57:09.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 36,
      "start": 14229.0,
      "end": 14231.0,
      "formatted_start": "03:57:09.000",
      "formatted_end": "03:57:11.000",
      "text": "از اینجور باید برداری کنید"
    },
    {
      "id": 37,
      "start": 14231.0,
      "end": 14233.0,
      "formatted_start": "03:57:11.000",
      "formatted_end": "03:57:13.000",
      "text": "داشت خونه؟"
    },
    {
      "id": 38,
      "start": 14233.0,
      "end": 14235.0,
      "formatted_start": "03:57:13.000",
      "formatted_end": "03:57:15.000",
      "text": "که؟"
    },
    {
      "id": 39,
      "start": 14235.0,
      "end": 14237.0,
      "formatted_start": "03:57:15.000",
      "formatted_end": "03:57:17.000",
      "text": "شاگار، اینی، فکر کنم سشار بسته"
    },
    {
      "id": 40,
      "start": 14237.0,
      "end": 14239.0,
      "formatted_start": "03:57:17.000",
      "formatted_end": "03:57:19.000",
      "text": "اونم نسک داره"
    },
    {
      "id": 41,
      "start": 14239.0,
      "end": 14241.0,
      "formatted_start": "03:57:19.000",
      "formatted_end": "03:57:21.000",
      "text": "قبل غذایی؟"
    },
    {
      "id": 42,
      "start": 14241.0,
      "end": 14243.0,
      "formatted_start": "03:57:21.000",
      "formatted_end": "03:57:23.000",
      "text": "نسک"
    },
    {
      "id": 43,
      "start": 14243.0,
      "end": 14245.0,
      "formatted_start": "03:57:23.000",
      "formatted_end": "03:57:25.000",
      "text": "اونو سشار بسته دیگه داره"
    },
    {
      "id": 44,
      "start": 14245.0,
      "end": 14247.0,
      "formatted_start": "03:57:25.000",
      "formatted_end": "03:57:27.000",
      "text": "حالا مهمستان دیگه این همه"
    },
    {
      "id": 45,
      "start": 14247.0,
      "end": 14249.0,
      "formatted_start": "03:57:27.000",
      "formatted_end": "03:57:29.000",
      "text": "آزمایش نمیشه، ممنون نشون"
    },
    {
      "id": 46,
      "start": 14249.0,
      "end": 14251.0,
      "formatted_start": "03:57:29.000",
      "formatted_end": "03:57:31.000",
      "text": "اینو وقت ترک میتونه، فکر میسره"
    },
    {
      "id": 47,
      "start": 14251.0,
      "end": 14253.0,
      "formatted_start": "03:57:31.000",
      "formatted_end": "03:57:33.000",
      "text": "مشکال نره"
    },
    {
      "id": 48,
      "start": 14253.0,
      "end": 14255.0,
      "formatted_start": "03:57:33.000",
      "formatted_end": "03:57:35.000",
      "text": "به همون روال خودتون بخورید"
    },
    {
      "id": 49,
      "start": 14255.0,
      "end": 14257.0,
      "formatted_start": "03:57:35.000",
      "formatted_end": "03:57:37.000",
      "text": "خب چون من از هم من مید"
    },
    {
      "id": 50,
      "start": 14257.0,
      "end": 14259.0,
      "formatted_start": "03:57:37.000",
      "formatted_end": "03:57:39.000",
      "text": "یکی شوی ناچاوچا بزنم"
    },
    {
      "id": 51,
      "start": 14259.0,
      "end": 14261.0,
      "formatted_start": "03:57:39.000",
      "formatted_end": "03:57:41.000",
      "text": "باید بیشتر دارو بدن"
    },
    {
      "id": 52,
      "start": 14261.0,
      "end": 14263.0,
      "formatted_start": "03:57:41.000",
      "formatted_end": "03:57:43.000",
      "text": "بس مثل همه داروش مثل خنداشو بیاد"
    },
    {
      "id": 53,
      "start": 14263.0,
      "end": 14265.0,
      "formatted_start": "03:57:43.000",
      "formatted_end": "03:57:45.000",
      "text": "دقیقا مثل روال قبل"
    },
    {
      "id": 54,
      "start": 14265.0,
      "end": 14267.0,
      "formatted_start": "03:57:45.000",
      "formatted_end": "03:57:47.000",
      "text": "به مصرف کنن"
    },
    {
      "id": 55,
      "start": 14267.0,
      "end": 14269.0,
      "formatted_start": "03:57:47.000",
      "formatted_end": "03:57:49.000",
      "text": "من یه آزمایش نوشتم بهشون"
    },
    {
      "id": 56,
      "start": 14269.0,
      "end": 14271.0,
      "formatted_start": "03:57:49.000",
      "formatted_end": "03:57:51.000",
      "text": "ببینم پالت و خونشو سماهه چطور نمیدونه"
    },
    {
      "id": 57,
      "start": 14271.0,
      "end": 14273.0,
      "formatted_start": "03:57:51.000",
      "formatted_end": "03:57:53.000",
      "text": "اگه داشته آزمایش"
    },
    {
      "id": 58,
      "start": 14273.0,
      "end": 14275.0,
      "formatted_start": "03:57:53.000",
      "formatted_end": "03:57:55.000",
      "text": "قبلی بیاد نمیدونه"
    },
    {
      "id": 59,
      "start": 14275.0,
      "end": 14277.0,
      "formatted_start": "03:57:55.000",
      "formatted_end": "03:57:57.000",
      "text": "بعد برای پاهاشو نمیدونه"
    },
    {
      "id": 60,
      "start": 14277.0,
      "end": 14279.0,
      "formatted_start": "03:57:57.000",
      "formatted_end": "03:57:59.000",
      "text": "چند تا میتامی نوشتم"
    },
    {
      "id": 61,
      "start": 14279.0,
      "end": 14281.0,
      "formatted_start": "03:57:59.000",
      "formatted_end": "03:58:01.000",
      "text": "یکم احساسشونو بهتر نمیدونه"
    },
    {
      "id": 62,
      "start": 14283.0,
      "end": 14285.0,
      "formatted_start": "03:58:03.000",
      "formatted_end": "03:58:05.000",
      "text": "نه پا هم دستان کلن"
    },
    {
      "id": 63,
      "start": 14285.0,
      "end": 14287.0,
      "formatted_start": "03:58:05.000",
      "formatted_end": "03:58:07.000",
      "text": "گوشتو بدن منو سیگاه کرده"
    },
    {
      "id": 64,
      "start": 14287.0,
      "end": 14290.2,
      "formatted_start": "03:58:07.000",
      "formatted_end": "03:58:10.200",
      "text": "پوشتم که ریخته و دیگه آب شده پوسته"
    },
    {
      "id": 65,
      "start": 14290.2,
      "end": 14293.2,
      "formatted_start": "03:58:10.200",
      "formatted_end": "03:58:13.200",
      "text": "کلیم بدنم سیار سفید نبودم"
    },
    {
      "id": 66,
      "start": 14293.2,
      "end": 14294.2,
      "formatted_start": "03:58:13.200",
      "formatted_end": "03:58:14.200",
      "text": "اما اینجور..."
    },
    {
      "id": 67,
      "start": 14294.2,
      "end": 14296.2,
      "formatted_start": "03:58:14.200",
      "formatted_end": "03:58:16.200",
      "text": "پوست آدمی ذاته دیگه مادر"
    },
    {
      "id": 68,
      "start": 14296.2,
      "end": 14298.2,
      "formatted_start": "03:58:16.200",
      "formatted_end": "03:58:18.200",
      "text": "همون حرف شما درسته جمع میشه"
    },
    {
      "id": 69,
      "start": 14298.2,
      "end": 14302.2,
      "formatted_start": "03:58:18.200",
      "formatted_end": "03:58:22.200",
      "text": "پوشتم که آب شده کلیم بدنم سیار سفید نبودم"
    },
    {
      "id": 70,
      "start": 14302.2,
      "end": 14304.2,
      "formatted_start": "03:58:22.200",
      "formatted_end": "03:58:24.200",
      "text": "بله"
    },
    {
      "id": 71,
      "start": 14306.2,
      "end": 14308.2,
      "formatted_start": "03:58:26.200",
      "formatted_end": "03:58:28.200",
      "text": "حرف با شما است"
    },
    {
      "id": 72,
      "start": 14309.2,
      "end": 14311.2,
      "formatted_start": "03:58:29.200",
      "formatted_end": "03:58:31.200",
      "text": "درسته با شما با من"
    },
    {
      "id": 73,
      "start": 14314.2,
      "end": 14316.2,
      "formatted_start": "03:58:34.200",
      "formatted_end": "03:58:36.200",
      "text": "چرا اونو بیارم؟"
    },
    {
      "id": 74,
      "start": 14316.2,
      "end": 14321.82,
      "formatted_start": "03:58:36.200",
      "formatted_end": "03:58:41.820",
      "text": "چون داره قدر نمیتونه چند تا ویتامینه اگه سوال داشتی نمیدونی بسیار بیار هم بردازی باش"
    },
    {
      "id": 75,
      "start": 14321.82,
      "end": 14338.2,
      "formatted_start": "03:58:41.820",
      "formatted_end": "03:58:58.200",
      "text": "بکن تبشه قلب داشتن نه سرس داشتن"
    },
    {
      "id": 76,
      "start": 14338.82,
      "end": 14341.2,
      "formatted_start": "03:58:58.820",
      "formatted_end": "03:59:01.200",
      "text": "سرس من ماری دارم"
    },
    {
      "id": 77,
      "start": 14341.2,
      "end": 14342.68,
      "formatted_start": "03:59:01.200",
      "formatted_end": "03:59:02.680",
      "text": "همچنین سرس داریم"
    },
    {
      "id": 78,
      "start": 14342.68,
      "end": 14343.52,
      "formatted_start": "03:59:02.680",
      "formatted_end": "03:59:03.520",
      "text": "خانم داده خانم"
    },
    {
      "id": 79,
      "start": 14343.52,
      "end": 14345.1,
      "formatted_start": "03:59:03.520",
      "formatted_end": "03:59:05.100",
      "text": "خانم هم خانم داریم"
    },
    {
      "id": 80,
      "start": 14345.1,
      "end": 14347.1,
      "formatted_start": "03:59:05.100",
      "formatted_end": "03:59:07.100",
      "text": "برس قلب می کنن و سیت می کنن"
    },
    {
      "id": 81,
      "start": 14347.1,
      "end": 14349.1,
      "formatted_start": "03:59:07.100",
      "formatted_end": "03:59:09.100",
      "text": "برس قلب هم دارم"
    },
    {
      "id": 82,
      "start": 14349.1,
      "end": 14352.1,
      "formatted_start": "03:59:09.100",
      "formatted_end": "03:59:12.100",
      "text": "یکم تپشتن همیشه تپشتن یا امروز اینجوری بوده؟"
    },
    {
      "id": 83,
      "start": 14352.1,
      "end": 14355.1,
      "formatted_start": "03:59:12.100",
      "formatted_end": "03:59:15.100",
      "text": "نه امروز تنها نیه خیلی وقت همیشه دارم"
    },
    {
      "id": 84,
      "start": 14355.1,
      "end": 14358.1,
      "formatted_start": "03:59:15.100",
      "formatted_end": "03:59:18.100",
      "text": "مگر خیلی کم نداشته باشن"
    },
    {
      "id": 85,
      "start": 14358.1,
      "end": 14361.1,
      "formatted_start": "03:59:18.100",
      "formatted_end": "03:59:21.100",
      "text": "برس نیستم روز نصف شویدن بخورم باشم"
    },
    {
      "id": 86,
      "start": 14361.1,
      "end": 14363.1,
      "formatted_start": "03:59:21.100",
      "formatted_end": "03:59:23.100",
      "text": "برس قلب همیشه دارن"
    },
    {
      "id": 87,
      "start": 14363.1,
      "end": 14365.1,
      "formatted_start": "03:59:23.100",
      "formatted_end": "03:59:25.100",
      "text": "چون قلب هم فنر هم هستیم"
    },
    {
      "id": 88,
      "start": 14365.1,
      "end": 14368.1,
      "formatted_start": "03:59:25.100",
      "formatted_end": "03:59:28.100",
