  "stt_segments": [
    {
      "id": 0,
      "start": 15300.0,
      "end": 15307.0,
      "formatted_start": "04:15:00.000",
      "formatted_end": "04:15:07.000",
      "text": "باید یک علت دارد یا میتروبی توی رودتونه یا اضطهاب که دکتر باید چک کنه."
    },
    {
      "id": 1,
      "start": 15307.0,
      "end": 15308.0,
      "formatted_start": "04:15:07.000",
      "formatted_end": "04:15:08.000",
      "text": "خب؟"
    },
    {
      "id": 2,
      "start": 15308.0,
      "end": 15314.0,
      "formatted_start": "04:15:08.000",
      "formatted_end": "04:15:14.000",
      "text": "باید همینجوری که تا که میخواید فصل مزدید، بزرگشت کنه بخوره."
    },
    {
      "id": 3,
      "start": 15314.0,
      "end": 15320.0,
      "formatted_start": "04:15:14.000",
      "formatted_end": "04:15:20.000",
      "text": "باید قرص انگل هم که استفاده کرده بود."
    },
    {
      "id": 4,
      "start": 15320.0,
      "end": 15324.0,
      "formatted_start": "04:15:20.000",
      "formatted_end": "04:15:24.000",
      "text": "باید مجموع دازارتون رو..."
    },
    {
      "id": 5,
      "start": 15324.0,
      "end": 15325.0,
      "formatted_start": "04:15:24.000",
      "formatted_end": "04:15:25.000",
      "text": "یعنی همون باز برام از شما بگیرم؟"
    },
    {
      "id": 6,
      "start": 15325.0,
      "end": 15329.0,
      "formatted_start": "04:15:25.000",
      "formatted_end": "04:15:29.000",
      "text": "ببین ما یک کاری که میتونیم بکنیم، شما برای چی؟"
    },
    {
      "id": 7,
      "start": 15329.0,
      "end": 15333.0,
      "formatted_start": "04:15:29.000",
      "formatted_end": "04:15:33.000",
      "text": "انگل دیده بودن بچه ها تو مذکرون، دیدن؟"
    },
    {
      "id": 8,
      "start": 15333.0,
      "end": 15340.0,
      "formatted_start": "04:15:33.000",
      "formatted_end": "04:15:40.000",
      "text": "خب، چون اون روزی، اونطور که درمان کردیم، الان ما میمونیم درمان هر کیسته،"
    },
    {
      "id": 9,
      "start": 15340.0,
      "end": 15370.0,
      "formatted_start": "04:15:40.000",
      "formatted_end": "04:16:10.000",
      "text": "این هایی که در این وقت برای از این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای ا"
    },
    {
      "id": 10,
      "start": 15370.0,
      "end": 15400.0,
      "formatted_start": "04:16:10.000",
      "formatted_end": "04:16:40.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 11,
      "start": 15400.0,
      "end": 15403.0,
      "formatted_start": "04:16:40.000",
      "formatted_end": "04:16:43.000",
      "text": "این بازی از انگله کیست ایجاد میدونند تو بودن"
    },
    {
      "id": 12,
      "start": 15403.0,
      "end": 15406.0,
      "formatted_start": "04:16:43.000",
      "formatted_end": "04:16:46.000",
      "text": "درمانش دو هفته است دیگه دو هفته کامل بگوییم"
    },
    {
      "id": 13,
      "start": 15406.0,
      "end": 15409.0,
      "formatted_start": "04:16:46.000",
      "formatted_end": "04:16:49.000",
      "text": "اگر این بار واد کرد حتما من باید دکتر بگو و شداتونو برم"
    },
    {
      "id": 14,
      "start": 15409.0,
      "end": 15412.0,
      "formatted_start": "04:16:49.000",
      "formatted_end": "04:16:52.000",
      "text": "این بود اینی مثلا تو سراغریه"
    },
    {
      "id": 15,
      "start": 15412.0,
      "end": 15415.0,
      "formatted_start": "04:16:52.000",
      "formatted_end": "04:16:55.000",
      "text": "من دکتر قرابی میپیستم ارشامون"
    },
    {
      "id": 16,
      "start": 15415.0,
      "end": 15417.0,
      "formatted_start": "04:16:55.000",
      "formatted_end": "04:16:57.000",
      "text": "گنبر"
    },
    {
      "id": 17,
      "start": 15417.0,
      "end": 15419.0,
      "formatted_start": "04:16:57.000",
      "formatted_end": "04:16:59.000",
      "text": "دکتر بیر اسلام خانم من اونها هست"
    },
    {
      "id": 18,
      "start": 15419.0,
      "end": 15422.0,
      "formatted_start": "04:16:59.000",
      "formatted_end": "04:17:02.000",
      "text": "ولی خیلی شدوقه یکم با اجله میبینه"
    },
    {
      "id": 19,
      "start": 15422.0,
      "end": 15425.0,
      "formatted_start": "04:17:02.000",
      "formatted_end": "04:17:05.000",
      "text": "ای قطعش من پیش اسلامی بودم"
    },
    {
      "id": 20,
      "start": 15425.0,
      "end": 15428.0,
      "formatted_start": "04:17:05.000",
      "formatted_end": "04:17:08.000",
      "text": "برای خیلی تو بودم"
    },
    {
      "id": 21,
      "start": 15428.0,
      "end": 15434.0,
      "formatted_start": "04:17:08.000",
      "formatted_end": "04:17:14.000",
      "text": "آره، حالا بخوایی بگی من یه نامه بگی بگی برات بدنیستم خب"
    },
    {
      "id": 22,
      "start": 15434.0,
      "end": 15436.0,
      "formatted_start": "04:17:14.000",
      "formatted_end": "04:17:16.000",
      "text": "که برای نوبت بدنیستم"
    },
    {
      "id": 23,
      "start": 15436.0,
      "end": 15440.0,
      "formatted_start": "04:17:16.000",
      "formatted_end": "04:17:20.000",
      "text": "آره، من تشکیل هستم، میدون تا که کرا بگیم"
    },
    {
      "id": 24,
      "start": 15440.0,
      "end": 15443.0,
      "formatted_start": "04:17:20.000",
      "formatted_end": "04:17:23.000",
      "text": "ممکن همین انگله باشه، نگهر نباشه"
    },
    {
      "id": 25,
      "start": 15443.0,
      "end": 15445.0,
      "formatted_start": "04:17:23.000",
      "formatted_end": "04:17:25.000",
      "text": "درمانش دو هفته است"
    },
    {
      "id": 26,
      "start": 15445.0,
      "end": 15450.0,
      "formatted_start": "04:17:25.000",
      "formatted_end": "04:17:30.000",
      "text": "همون کودتون دارتونو بگیم، من به همین سر رو براتون زدم"
    },
    {
      "id": 27,
      "start": 15450.0,
      "end": 15454.0,
      "formatted_start": "04:17:30.000",
      "formatted_end": "04:17:34.000",
      "text": "یعنی همین گروه دی که تو نوشته بودین"
    },
    {
      "id": 28,
      "start": 15454.0,
      "end": 15459.0,
      "formatted_start": "04:17:34.000",
      "formatted_end": "04:17:39.000",
      "text": "حالا براتون نوشتم. نجار نیاز آفیم. نجار نیاز آفیم."
    },
    {
      "id": 29,
      "start": 15459.0,
      "end": 15468.0,
      "formatted_start": "04:17:39.000",
      "formatted_end": "04:17:48.000",
      "text": "تا دو هفته. براتون سی تا نوشتم. دو هفته. اگر عود کنه مرتب بخوایید. اگر عود کردید."
    },
    {
      "id": 30,
      "start": 15468.0,
      "end": 15472.0,
      "formatted_start": "04:17:48.000",
      "formatted_end": "04:17:52.000",
      "text": "اینه مردی نصیب بود. اینه یکی نجکن شده."
    },
    {
      "id": 31,
      "start": 15472.0,
      "end": 15477.0,
      "formatted_start": "04:17:52.000",
      "formatted_end": "04:17:57.000",
      "text": "خب بابا دیگه بودی؟ آرشایی گرفتی؟ نگرفتی؟"
    },
    {
      "id": 32,
      "start": 15477.0,
      "end": 15507.0,
      "formatted_start": "04:17:57.000",
      "formatted_end": "04:18:27.000",
      "text": "اگر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر"
    },
    {
      "id": 33,
      "start": 15537.0,
      "end": 15539.0,
      "formatted_start": "04:18:57.000",
      "formatted_end": "04:18:59.000",
      "text": "تفه اول، تو دیشت"
    },
    {
      "id": 34,
      "start": 15539.0,
      "end": 15541.0,
      "formatted_start": "04:18:59.000",
      "formatted_end": "04:19:01.000",
      "text": "کجا؟"
    },
    {
      "id": 35,
      "start": 15541.0,
      "end": 15543.0,
      "formatted_start": "04:19:01.000",
      "formatted_end": "04:19:03.000",
      "text": "زر رویده"
    },
    {
      "id": 36,
      "start": 15543.0,
      "end": 15545.0,
      "formatted_start": "04:19:03.000",
      "formatted_end": "04:19:05.000",
      "text": "از رویده اون همه باید برداشت"
    },
    {
      "id": 37,
      "start": 15545.0,
      "end": 15547.0,
      "formatted_start": "04:19:05.000",
      "formatted_end": "04:19:07.000",
      "text": "خب؟"
    },
    {
      "id": 38,
      "start": 15547.0,
      "end": 15549.0,
      "formatted_start": "04:19:07.000",
      "formatted_end": "04:19:09.000",
      "text": "تفه دوم افناد کرد"
    },
    {
      "id": 39,
      "start": 15549.0,
      "end": 15551.0,
      "formatted_start": "04:19:09.000",
      "formatted_end": "04:19:11.000",
      "text": "تفه سوام چسپنده برداشت"
    },
    {
      "id": 40,
      "start": 15551.0,
      "end": 15553.0,
      "formatted_start": "04:19:11.000",
      "formatted_end": "04:19:13.000",
      "text": "باز کیسه هست"
    },
    {
      "id": 41,
      "start": 15553.0,
      "end": 15555.0,
      "formatted_start": "04:19:13.000",
      "formatted_end": "04:19:15.000",
      "text": "تفه آبادشت"
    },
    {
      "id": 42,
      "start": 15555.0,
      "end": 15557.0,
      "formatted_start": "04:19:15.000",
      "formatted_end": "04:19:17.000",
      "text": "با رفتم خانه با دوباره افناد کرد"
    },
    {
      "id": 43,
      "start": 15557.0,
      "end": 15559.0,
      "formatted_start": "04:19:17.000",
      "formatted_end": "04:19:19.000",
      "text": "با دوباره هم شد"
    },
    {
      "id": 44,
      "start": 15559.0,
      "end": 15561.0,
      "formatted_start": "04:19:19.000",
      "formatted_end": "04:19:21.000",
      "text": "دو دفعه"
    },
    {
      "id": 45,
      "start": 15561.0,
      "end": 15563.0,
      "formatted_start": "04:19:21.000",
      "formatted_end": "04:19:23.000",
      "text": "کیسه استفدای کرد"
    },
    {
      "id": 46,
      "start": 15563.0,
      "end": 15565.0,
      "formatted_start": "04:19:23.000",
      "formatted_end": "04:19:25.000",
      "text": "الان زر دلمه"
    },
    {
      "id": 47,
      "start": 15565.0,
      "end": 15567.0,
      "formatted_start": "04:19:25.000",
      "formatted_end": "04:19:27.000",
      "text": "باید برداریم"
    },
    {
      "id": 48,
      "start": 15567.0,
      "end": 15569.0,
      "formatted_start": "04:19:27.000",
      "formatted_end": "04:19:29.000",
      "text": "شکم تو مهتم کار میکنه؟"
    },
    {
      "id": 49,
      "start": 15569.0,
      "end": 15571.0,
      "formatted_start": "04:19:29.000",
      "formatted_end": "04:19:31.000",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 15571.0,
      "end": 15573.0,
      "formatted_start": "04:19:31.000",
      "formatted_end": "04:19:33.000",
      "text": "شما نباید شکم تو صفحه شد"
    },
    {
      "id": 51,
      "start": 15573.0,
      "end": 15575.0,
      "formatted_start": "04:19:33.000",
      "formatted_end": "04:19:35.000",
      "text": "چون چسبندگی داری"
    },
    {
      "id": 52,
      "start": 15575.0,
      "end": 15577.0,
      "formatted_start": "04:19:35.000",
      "formatted_end": "04:19:37.000",
      "text": "چون جودتونو برداشتن و چسبندگی داری"
    },
    {
      "id": 53,
      "start": 15577.0,
      "end": 15579.0,
      "formatted_start": "04:19:37.000",
      "formatted_end": "04:19:39.000",
      "text": "شکمت همیشه باید رو خوب بیاد"
    },
    {
      "id": 54,
      "start": 15579.0,
      "end": 15581.0,
      "formatted_start": "04:19:39.000",
      "formatted_end": "04:19:41.000",
      "text": "هرچیم به دکتر مروم"
    },
    {
      "id": 55,
      "start": 15581.0,
      "end": 15583.0,
      "formatted_start": "04:19:41.000",
      "formatted_end": "04:19:43.000",
      "text": "یک قرص یا یک شربت نمیدونیم"
    },
    {
      "id": 56,
      "start": 15583.0,
      "end": 15585.0,
      "formatted_start": "04:19:43.000",
      "formatted_end": "04:19:45.000",
      "text": "که روان کار کنیم"
    },
    {
      "id": 57,
      "start": 15585.0,
      "end": 15587.0,
      "formatted_start": "04:19:45.000",
      "formatted_end": "04:19:47.000",
      "text": "مهمترین چیز"
    },
    {
      "id": 58,
      "start": 15587.0,
      "end": 15589.0,
      "formatted_start": "04:19:47.000",
      "formatted_end": "04:19:49.000",
      "text": "برای شما دابی"
    },
    {
      "id": 59,
      "start": 15589.0,
      "end": 15591.0,
      "formatted_start": "04:19:49.000",
      "formatted_end": "04:19:51.000",
      "text": "شما همه روانگودن"
    },
    {
      "id": 60,
      "start": 15591.0,
      "end": 15593.0,
      "formatted_start": "04:19:51.000",
      "formatted_end": "04:19:53.000",
      "text": "چسبندگی داره"
    },
    {
      "id": 61,
      "start": 15593.0,
      "end": 15599.98,
      "formatted_start": "04:19:53.000",
      "formatted_end": "04:19:59.980",
      "text": "میبنده و دلپیچه خیلی میافته و رودا برم میکنه تا التواب به جمعه درده"
    }
  ],
  "status": "completed"
}