  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3910.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:10.000",
      "text": "مدت زمان استفاده نشده به دلیل مشکل مخابراتی را داد."
    },
    {
      "id": 1,
      "start": 3915.0,
      "end": 3919.0,
      "formatted_start": "01:05:15.000",
      "formatted_end": "01:05:19.000",
      "text": "اینکه اینکه افضا بزنید، در اینجور برم اونجور بزنید، بگیرش بشویم، این زمانت را باید برگردیم."
    },
    {
      "id": 2,
      "start": 3920.0,
      "end": 3923.0,
      "formatted_start": "01:05:20.000",
      "formatted_end": "01:05:23.000",
      "text": "شما سرویسی موندین، نه ماشه باید برگردیم."
    },
    {
      "id": 3,
      "start": 3924.0,
      "end": 3925.0,
      "formatted_start": "01:05:24.000",
      "formatted_end": "01:05:25.000",
      "text": "خب، مولا من..."
    },
    {
      "id": 4,
      "start": 3926.0,
      "end": 3927.0,
      "formatted_start": "01:05:26.000",
      "formatted_end": "01:05:27.000",
      "text": "خب، نوزه پزشو؟"
    },
    {
      "id": 5,
      "start": 3927.0,
      "end": 3928.0,
      "formatted_start": "01:05:27.000",
      "formatted_end": "01:05:28.000",
      "text": "بازه پسشون؟"
    },
    {
      "id": 6,
      "start": 3928.0,
      "end": 3930.0,
      "formatted_start": "01:05:28.000",
      "formatted_end": "01:05:30.000",
      "text": "نه بازه من الان میخوام یه اسم بزنم خب"
    },
    {
      "id": 7,
      "start": 3930.0,
      "end": 3933.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:33.000",
      "text": "دیگه ها دوتا آنتین میاد خب من به تو"
    },
    {
