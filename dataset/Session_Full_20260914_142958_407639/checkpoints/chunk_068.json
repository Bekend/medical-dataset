  "stt_segments": [
    {
      "id": 0,
      "start": 20400.0,
      "end": 20406.0,
      "formatted_start": "05:40:00.000",
      "formatted_end": "05:40:06.000",
      "text": "تربیخون بالاست، کمخونی، آزمایی کبیدت بالاست."
    },
    {
      "id": 1,
      "start": 20406.0,
      "end": 20408.0,
      "formatted_start": "05:40:06.000",
      "formatted_end": "05:40:08.000",
      "text": "آزمایی کبیدت بالاست؟"
    },
    {
      "id": 2,
      "start": 20408.0,
      "end": 20410.0,
      "formatted_start": "05:40:08.000",
      "formatted_end": "05:40:10.000",
      "text": "آزمایی کبیدت بالاست."
    },
    {
      "id": 3,
      "start": 20410.0,
      "end": 20412.0,
      "formatted_start": "05:40:10.000",
      "formatted_end": "05:40:12.000",
      "text": "از این مشکلات تازیگی هستند، چمکش ما آزمایش داشته شده شده نشید."
    },
    {
      "id": 4,
      "start": 20412.0,
      "end": 20415.0,
      "formatted_start": "05:40:12.000",
      "formatted_end": "05:40:15.000",
      "text": "یک ماه باشکار رو بزرگشم کنار بکنم باشکار رو"
    },
    {
      "id": 5,
      "start": 20415.0,
      "end": 20418.0,
      "formatted_start": "05:40:15.000",
      "formatted_end": "05:40:18.000",
      "text": "و پریز غذایی اصلا ندارم برای همینطور شدنه"
    },
    {
      "id": 6,
      "start": 20418.0,
      "end": 20420.0,
      "formatted_start": "05:40:18.000",
      "formatted_end": "05:40:20.000",
      "text": "این خیلی برای؟"
    },
    {
      "id": 7,
      "start": 20420.0,
      "end": 20421.0,
      "formatted_start": "05:40:20.000",
      "formatted_end": "05:40:21.000",
      "text": "نه خیلی"
    },
    {
      "id": 8,
      "start": 20421.0,
      "end": 20422.0,
      "formatted_start": "05:40:21.000",
      "formatted_end": "05:40:22.000",
      "text": "زیاد نیست؟"
    },
    {
      "id": 9,
      "start": 20422.0,
      "end": 20423.0,
      "formatted_start": "05:40:22.000",
      "formatted_end": "05:40:23.000",
      "text": "نه"
    },
    {
      "id": 10,
      "start": 20423.0,
      "end": 20426.0,
      "formatted_start": "05:40:23.000",
      "formatted_end": "05:40:26.000",
      "text": "حالا بخوام کبه هایی هم چرباشه نمیخواد نمهم گره داری یک نه دیگه نه؟"
    },
    {
      "id": 11,
      "start": 20426.0,
      "end": 20429.0,
      "formatted_start": "05:40:26.000",
      "formatted_end": "05:40:29.000",
      "text": "نه میتونیم با سونا بگیم با آزمایش بگیم"
    },
    {
      "id": 12,
      "start": 20429.0,
      "end": 20432.0,
      "formatted_start": "05:40:29.000",
      "formatted_end": "05:40:32.000",
      "text": "بس توبون کنیم بلی اصلا مهم نیست دیگه"
    },
    {
      "id": 13,
      "start": 20432.0,
      "end": 20434.0,
      "formatted_start": "05:40:32.000",
      "formatted_end": "05:40:34.000",
      "text": "مشخصه چربی دیگه"
    },
    {
      "id": 14,
      "start": 20434.0,
      "end": 20446.0,
      "formatted_start": "05:40:34.000",
      "formatted_end": "05:40:46.000",
      "text": "اگر با سرنه تو بده، باید ورزش کنی، سخکر رو بچه کنی، شیط رو روی کنی، تخمه، آجیل، نشابه دخسته"
    },
    {
      "id": 15,
      "start": 20446.0,
      "end": 20454.0,
      "formatted_start": "05:40:46.000",
      "formatted_end": "05:40:54.000",
      "text": "من از دوازه اشتر کنم، امچنگ بیاد بودم جا سخکرم، شب شم نمی کنم، امچنگ باید برم شرکرم کنم"
    },
    {
      "id": 16,
      "start": 20454.0,
      "end": 20459.0,
      "formatted_start": "05:40:54.000",
      "formatted_end": "05:40:59.000",
      "text": "اگر داشتن تو خود رو بگو دارن این های اصلا هم چیز هم براموش کرده و باشکم براموش کرده"
    },
    {
      "id": 17,
      "start": 20459.0,
      "end": 20464.0,
      "formatted_start": "05:40:59.000",
      "formatted_end": "05:41:04.000",
      "text": "وقتی که اینجا میشه خیال بوجه نمیدونم کدوم برام آفرد رو خرسخ کرده ایچی"
    },
    {
      "id": 18,
      "start": 20464.0,
      "end": 20465.0,
      "formatted_start": "05:41:04.000",
      "formatted_end": "05:41:05.000",
      "text": "برگتو بده؟"
    },
    {
      "id": 19,
      "start": 20465.0,
      "end": 20469.0,
      "formatted_start": "05:41:05.000",
      "formatted_end": "05:41:09.000",
      "text": "برگتو بده، این هم آزمایش ها برای آقا بوده که"
    },
    {
      "id": 20,
      "start": 20469.0,
      "end": 20472.0,
      "formatted_start": "05:41:09.000",
      "formatted_end": "05:41:12.000",
      "text": "باشه براموش کرده"
    },
    {
      "id": 21,
      "start": 20472.0,
      "end": 20474.0,
      "formatted_start": "05:41:12.000",
      "formatted_end": "05:41:14.000",
      "text": "از اینجا میشه"
    },
    {
      "id": 22,
      "start": 20477.0,
      "end": 20482.0,
      "formatted_start": "05:41:17.000",
      "formatted_end": "05:41:22.000",
      "text": "نکم خیلی علامت دار نیست نه باشه در خودت بردرایت کنی"
    },
    {
      "id": 23,
      "start": 20482.0,
      "end": 20485.0,
      "formatted_start": "05:41:22.000",
      "formatted_end": "05:41:25.000",
      "text": "اما چی می کنم باز یه مادیت دیدو بره می رویم؟"
    },
    {
      "id": 24,
      "start": 20485.0,
      "end": 20486.0,
      "formatted_start": "05:41:25.000",
      "formatted_end": "05:41:26.000",
      "text": "سه ماه"
    },
    {
      "id": 25,
      "start": 20486.0,
      "end": 20487.0,
      "formatted_start": "05:41:26.000",
      "formatted_end": "05:41:27.000",
      "text": "سه ماه با جای آمدید"
    },
    {
      "id": 26,
      "start": 20487.0,
      "end": 20490.0,
      "formatted_start": "05:41:27.000",
      "formatted_end": "05:41:30.000",
      "text": "سه ماه دیده نمی شه علاکه به خود هم استرس برمی"
    },
    {
      "id": 27,
      "start": 20491.0,
      "end": 20495.0,
      "formatted_start": "05:41:31.000",
      "formatted_end": "05:41:35.000",
      "text": "سه ماه طول می کنه شو تا سلونار بیکاوریک رو من دوباره برگرم"
    },
    {
      "id": 28,
      "start": 20495.0,
      "end": 20498.0,
      "formatted_start": "05:41:35.000",
      "formatted_end": "05:41:38.000",
      "text": "الان چربی که بالا بره علایه ممثل این چه علایه می ده؟"
    },
    {
      "id": 29,
      "start": 20498.0,
      "end": 20500.0,
      "formatted_start": "05:41:38.000",
      "formatted_end": "05:41:40.000",
      "text": "خوابت می آد که سلونار داره"
    },
    {
      "id": 30,
      "start": 20500.0,
      "end": 20501.0,
      "formatted_start": "05:41:40.000",
      "formatted_end": "05:41:41.000",
      "text": "خوابم خیلی ساره"
    },
    {
      "id": 31,
      "start": 20502.0,
      "end": 20503.0,
      "formatted_start": "05:41:42.000",
      "formatted_end": "05:41:43.000",
      "text": "از خواب با همشه خسته ای"
    },
    {
      "id": 32,
      "start": 20503.0,
      "end": 20504.0,
      "formatted_start": "05:41:43.000",
      "formatted_end": "05:41:44.000",
      "text": "برسه"
    },
    {
      "id": 33,
      "start": 20504.0,
      "end": 20506.0,
      "formatted_start": "05:41:44.000",
      "formatted_end": "05:41:46.000",
      "text": "هر چی میخوایید خواهید به سرتو بزاریم"
    },
    {
      "id": 34,
      "start": 20506.0,
      "end": 20508.0,
      "formatted_start": "05:41:46.000",
      "formatted_end": "05:41:48.000",
      "text": "این علامه میشه"
    },
    {
      "id": 35,
      "start": 20508.0,
      "end": 20510.0,
      "formatted_start": "05:41:48.000",
      "formatted_end": "05:41:50.000",
      "text": "این یک ماه که نرفتم باشکه میشه همجوریم"
    },
    {
      "id": 36,
      "start": 20512.0,
      "end": 20514.0,
      "formatted_start": "05:41:52.000",
      "formatted_end": "05:41:54.000",
      "text": "باشکه باعث میشده بسوزونیش"
    },
    {
      "id": 37,
      "start": 20514.0,
      "end": 20516.0,
      "formatted_start": "05:41:54.000",
      "formatted_end": "05:41:56.000",
      "text": "در واقع تغذیر ایران داشته"
    },
    {
      "id": 38,
      "start": 20516.0,
      "end": 20518.0,
      "formatted_start": "05:41:56.000",
      "formatted_end": "05:41:58.000",
      "text": "از اولواری باشکه باعث میشده بسوزونیش"
    },
    {
      "id": 39,
      "start": 20518.0,
      "end": 20520.0,
      "formatted_start": "05:41:58.000",
      "formatted_end": "05:42:00.000",
      "text": "این علامه نرمشته باشه"
    },
    {
      "id": 40,
      "start": 20520.0,
      "end": 20522.0,
      "formatted_start": "05:42:00.000",
      "formatted_end": "05:42:02.000",
      "text": "من قضاون که ازم برنجا هم کلیدم"
    },
    {
      "id": 41,
      "start": 20522.0,
      "end": 20524.0,
      "formatted_start": "05:42:02.000",
      "formatted_end": "05:42:04.000",
      "text": "برنج روغن هست"
    },
    {
      "id": 42,
      "start": 20524.0,
      "end": 20526.0,
      "formatted_start": "05:42:04.000",
      "formatted_end": "05:42:06.000",
      "text": "فقط یک فروشتو دوست کنم"
    },
    {
      "id": 43,
      "start": 20526.0,
      "end": 20528.0,
      "formatted_start": "05:42:06.000",
      "formatted_end": "05:42:08.000",
      "text": "روغن جامعه شاید است"
    },
    {
      "id": 44,
      "start": 20528.0,
      "end": 20530.0,
      "formatted_start": "05:42:08.000",
      "formatted_end": "05:42:10.000",
      "text": "روغن جامعه داره"
    },
    {
      "id": 45,
      "start": 20530.0,
      "end": 20532.0,
      "formatted_start": "05:42:10.000",
      "formatted_end": "05:42:12.000",
      "text": "اتماه نمیجونید سرسر کن روغنتون"
    },
    {
      "id": 46,
      "start": 20532.0,
      "end": 20534.0,
      "formatted_start": "05:42:12.000",
      "formatted_end": "05:42:14.000",
      "text": "مایه بگیری"
    },
    {
      "id": 47,
      "start": 20534.0,
      "end": 20536.0,
      "formatted_start": "05:42:14.000",
      "formatted_end": "05:42:16.000",
      "text": "مایه زیتون"
    },
    {
      "id": 48,
      "start": 20536.0,
      "end": 20538.0,
      "formatted_start": "05:42:16.000",
      "formatted_end": "05:42:18.000",
      "text": "زیتون بگیری"
    },
    {
      "id": 49,
      "start": 20538.0,
      "end": 20540.0,
      "formatted_start": "05:42:18.000",
      "formatted_end": "05:42:20.000",
      "text": "اونو باز از جای مطمئن باید بگیری"
    },
    {
      "id": 50,
      "start": 20540.0,
      "end": 20542.0,
      "formatted_start": "05:42:20.000",
      "formatted_end": "05:42:22.000",
      "text": "وگنم که هر آشنا باش باشید"
    },
    {
      "id": 51,
      "start": 20544.0,
      "end": 20546.0,
      "formatted_start": "05:42:24.000",
      "formatted_end": "05:42:26.000",
      "text": "آهنه تو خارجی بینمسم یا ایرانی؟"
    },
    {
      "id": 52,
      "start": 20546.0,
      "end": 20548.0,
      "formatted_start": "05:42:26.000",
      "formatted_end": "05:42:28.000",
      "text": "آهنه تو خودتون"
    },
    {
      "id": 53,
      "start": 20548.0,
      "end": 20550.0,
      "formatted_start": "05:42:28.000",
      "formatted_end": "05:42:30.000",
      "text": "خارجی بهتر"
    },
    {
      "id": 54,
      "start": 20550.0,
      "end": 20552.0,
      "formatted_start": "05:42:30.000",
      "formatted_end": "05:42:32.000",
      "text": "خودتون که بود"
    },
    {
      "id": 55,
      "start": 20552.0,
      "end": 20554.0,
      "formatted_start": "05:42:32.000",
      "formatted_end": "05:42:34.000",
      "text": "خودش که بود"
    },
    {
      "id": 56,
      "start": 20554.0,
      "end": 20556.0,
      "formatted_start": "05:42:34.000",
      "formatted_end": "05:42:36.000",
      "text": "تارخون وقتی هر چور برات بهتر بود"
    },
    {
      "id": 57,
      "start": 20556.0,
      "end": 20558.0,
      "formatted_start": "05:42:36.000",
      "formatted_end": "05:42:38.000",
      "text": "ببین کسان"
    },
    {
      "id": 58,
      "start": 20558.0,
      "end": 20561.46,
      "formatted_start": "05:42:38.000",
      "formatted_end": "05:42:41.460",
      "text": "دادی گفت که پراش نمی‌سیم توی دارو رو کنم"
    },
    {
      "id": 59,
      "start": 20561.46,
      "end": 20561.96,
      "formatted_start": "05:42:41.460",
      "formatted_end": "05:42:41.960",
      "text": "چیه؟"
    },
    {
      "id": 60,
      "start": 20561.96,
      "end": 20565.24,
      "formatted_start": "05:42:41.960",
      "formatted_end": "05:42:45.240",
      "text": "این هم مشکل کبد داشت"
    },
    {
      "id": 61,
      "start": 20565.24,
      "end": 20569.24,
      "formatted_start": "05:42:45.240",
      "formatted_end": "05:42:49.240",
      "text": "این هم یک لیواروپور هفته"
    },
    {
      "id": 62,
      "start": 20569.24,
      "end": 20570.76,
      "formatted_start": "05:42:49.240",
      "formatted_end": "05:42:50.760",
      "text": "خودت باید بخورید"
    },
    {
      "id": 63,
      "start": 20570.76,
      "end": 20571.76,
      "formatted_start": "05:42:50.760",
      "formatted_end": "05:42:51.760",
      "text": "اه"
    },
    {
      "id": 64,
      "start": 20571.76,
      "end": 20574.76,
      "formatted_start": "05:42:51.760",
      "formatted_end": "05:42:54.760",
      "text": "و یکی فولیک اسید رو به آموگاسته"
    },
    {
      "id": 65,
      "start": 20574.76,
      "end": 20577.0,
      "formatted_start": "05:42:54.760",
      "formatted_end": "05:42:57.000",
      "text": "آموگاسته به آساده دیگه"
    },
    {
      "id": 66,
      "start": 20577.0,
      "end": 20579.0,
      "formatted_start": "05:42:57.000",
      "formatted_end": "05:42:59.000",
      "text": "شوهر تمازی می‌توازه شوهر تمازی می‌توازه"
    },
    {
      "id": 67,
      "start": 20579.0,
      "end": 20580.4,
      "formatted_start": "05:42:59.000",
      "formatted_end": "05:43:00.400",
      "text": "اونم کبدش چرمید"
    },
    {
      "id": 68,
      "start": 20580.4,
      "end": 20582.2,
      "formatted_start": "05:43:00.400",
      "formatted_end": "05:43:02.200",
      "text": "این کار مشکل کبد اصلا داشت"
    },
    {
      "id": 69,
      "start": 20582.2,
      "end": 20585.76,
      "formatted_start": "05:43:02.200",
      "formatted_end": "05:43:05.760",
      "text": "و پسرمانم گریده دو ایونم مشکل کبد داره"
    },
    {
      "id": 70,
      "start": 20585.76,
      "end": 20587.76,
      "formatted_start": "05:43:05.760",
      "formatted_end": "05:43:07.760",
      "text": "این شوهر کمبود ویتامین دی داره"
    },
    {
      "id": 71,
      "start": 20587.76,
      "end": 20589.76,
      "formatted_start": "05:43:07.760",
      "formatted_end": "05:43:09.760",
      "text": "شوهر کمبونه"
    },
    {
      "id": 72,
      "start": 20589.76,
      "end": 20591.76,
      "formatted_start": "05:43:09.760",
      "formatted_end": "05:43:11.760",
      "text": "شوهر شوهر داره"
    },
    {
      "id": 73,
      "start": 20591.76,
      "end": 20593.76,
      "formatted_start": "05:43:11.760",
      "formatted_end": "05:43:13.760",
      "text": "شوهر مستان"
    },
    {
      "id": 74,
      "start": 20593.76,
      "end": 20595.76,
      "formatted_start": "05:43:13.760",
      "formatted_end": "05:43:15.760",
      "text": "کلیه شبکه نداره"
    },
    {
      "id": 75,
      "start": 20595.76,
      "end": 20597.76,
      "formatted_start": "05:43:15.760",
      "formatted_end": "05:43:17.760",
      "text": "تو مرد و شوهر هستن کلیه داره؟"
    },
    {
      "id": 76,
      "start": 20597.76,
      "end": 20599.76,
      "formatted_start": "05:43:17.760",
      "formatted_end": "05:43:19.760",
      "text": "نه نمیدونم"
    },
    {
      "id": 77,
      "start": 20599.76,
      "end": 20601.76,
      "formatted_start": "05:43:19.760",
      "formatted_end": "05:43:21.760",
      "text": "کلیه شوهر هم داره"
    },
    {
      "id": 78,
      "start": 20601.76,
      "end": 20603.76,
      "formatted_start": "05:43:21.760",
      "formatted_end": "05:43:23.760",
      "text": "اینو حتما باید بیدوها نیم"
    },
    {
      "id": 79,
      "start": 20603.76,
      "end": 20605.76,
      "formatted_start": "05:43:23.760",
      "formatted_end": "05:43:25.760",
      "text": "اینو حتما باید سونا برای نام"
    },
    {
      "id": 80,
      "start": 20605.76,
      "end": 20607.76,
      "formatted_start": "05:43:25.760",
      "formatted_end": "05:43:27.760",
      "text": "پس یه همه داروی چیز نداره"
    },
    {
      "id": 81,
      "start": 20607.76,
      "end": 20609.76,
      "formatted_start": "05:43:27.760",
      "formatted_end": "05:43:29.760",
      "text": "یا خودش بیاد؟"
    },
    {
      "id": 82,
      "start": 20609.76,
      "end": 20611.76,
      "formatted_start": "05:43:29.760",
      "formatted_end": "05:43:31.760",
      "text": "خودش بیاد"
    },
    {
      "id": 83,
      "start": 20611.76,
      "end": 20613.76,
      "formatted_start": "05:43:31.760",
      "formatted_end": "05:43:33.760",
      "text": "اول بخواهم بگو چی بگو"
    },
    {
      "id": 84,
      "start": 20613.76,
      "end": 20615.76,
      "formatted_start": "05:43:33.760",
      "formatted_end": "05:43:35.760",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 85,
      "start": 20615.76,
      "end": 20617.76,
      "formatted_start": "05:43:35.760",
      "formatted_end": "05:43:37.760",
      "text": "سونا چی برداریم؟"
    },
    {
      "id": 86,
      "start": 20617.76,
      "end": 20619.76,
      "formatted_start": "05:43:37.760",
      "formatted_end": "05:43:39.760",
      "text": "سونا کامل شکم داریم"
    },
    {
      "id": 87,
      "start": 20619.76,
      "end": 20621.76,
      "formatted_start": "05:43:39.760",
      "formatted_end": "05:43:41.760",
      "text": "چون هم کودش باداست"
    },
    {
      "id": 88,
      "start": 20621.76,
      "end": 20623.76,
      "formatted_start": "05:43:41.760",
      "formatted_end": "05:43:43.760",
      "text": "برداریم"
    },
    {
      "id": 89,
      "start": 20623.76,
      "end": 20625.76,
      "formatted_start": "05:43:43.760",
      "formatted_end": "05:43:45.760",
      "text": "این سونا کامل برداریم"
    },
    {
      "id": 90,
      "start": 20625.76,
      "end": 20627.76,
      "formatted_start": "05:43:45.760",
      "formatted_end": "05:43:47.760",
      "text": "برداریم؟"
    },
    {
      "id": 91,
      "start": 20627.76,
      "end": 20629.76,
      "formatted_start": "05:43:47.760",
      "formatted_end": "05:43:49.760",
      "text": "برداریم"
    },
    {
      "id": 92,
      "start": 20629.76,
      "end": 20631.76,
      "formatted_start": "05:43:49.760",
      "formatted_end": "05:43:51.760",
      "text": "برداریم"
    },
    {
      "id": 93,
      "start": 20631.76,
      "end": 20633.76,
      "formatted_start": "05:43:51.760",
      "formatted_end": "05:43:53.760",
      "text": "برداریم"
    },
    {
      "id": 94,
      "start": 20633.76,
      "end": 20635.76,
      "formatted_start": "05:43:53.760",
      "formatted_end": "05:43:55.760",
      "text": "برداریم"
    },
    {
      "id": 95,
      "start": 20635.76,
      "end": 20637.76,
      "formatted_start": "05:43:55.760",
      "formatted_end": "05:43:57.760",
      "text": "برداریم"
    },
    {
      "id": 96,
      "start": 20637.76,
      "end": 20639.76,
      "formatted_start": "05:43:57.760",
      "formatted_end": "05:43:59.760",
      "text": "برداریم"
    },
    {
      "id": 97,
      "start": 20639.76,
      "end": 20641.76,
      "formatted_start": "05:43:59.760",
      "formatted_end": "05:44:01.760",
      "text": "برداریم"
    },
    {
      "id": 98,
      "start": 20641.76,
      "end": 20671.76,
