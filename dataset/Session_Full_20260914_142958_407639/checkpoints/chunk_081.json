  "stt_segments": [
    {
      "id": 0,
      "start": 24300.0,
      "end": 24330.0,
      "formatted_start": "06:45:00.000",
      "formatted_end": "06:45:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 1,
      "start": 24330.0,
      "end": 24332.0,
      "formatted_start": "06:45:30.000",
      "formatted_end": "06:45:32.000",
      "text": "پیروز میخوام شبهایی"
    },
    {
      "id": 2,
      "start": 24332.0,
      "end": 24333.0,
      "formatted_start": "06:45:32.000",
      "formatted_end": "06:45:33.000",
      "text": "چی پیروز؟"
    },
    {
      "id": 3,
      "start": 24333.0,
      "end": 24335.0,
      "formatted_start": "06:45:33.000",
      "formatted_end": "06:45:35.000",
      "text": "یه دیروز بودی 150 تومن اومد"
    },
    {
      "id": 4,
      "start": 24335.0,
      "end": 24337.0,
      "formatted_start": "06:45:35.000",
      "formatted_end": "06:45:37.000",
      "text": "یه 50 تومن یه 50 تومن"
    },
    {
      "id": 5,
      "start": 24337.0,
      "end": 24339.0,
      "formatted_start": "06:45:37.000",
      "formatted_end": "06:45:39.000",
      "text": "نه هرگزی 315 هزار تومن"
    },
    {
      "id": 6,
      "start": 24339.0,
      "end": 24341.0,
      "formatted_start": "06:45:39.000",
      "formatted_end": "06:45:41.000",
      "text": "به چه حسابی؟"
    },
    {
      "id": 7,
      "start": 24341.0,
      "end": 24343.0,
      "formatted_start": "06:45:41.000",
      "formatted_end": "06:45:43.000",
      "text": "اون حسابی که"
    },
    {
      "id": 8,
      "start": 24343.0,
      "end": 24345.0,
      "formatted_start": "06:45:43.000",
      "formatted_end": "06:45:45.000",
      "text": "مال مسکنتی"
    },
    {
      "id": 9,
      "start": 24345.0,
      "end": 24347.0,
      "formatted_start": "06:45:45.000",
      "formatted_end": "06:45:47.000",
      "text": "مسکنتی نمیده که ای"
    },
    {
      "id": 10,
      "start": 24347.0,
      "end": 24348.0,
      "formatted_start": "06:45:47.000",
      "formatted_end": "06:45:48.000",
      "text": "نه"
    },
    {
      "id": 11,
      "start": 24348.0,
      "end": 24349.0,
      "formatted_start": "06:45:48.000",
      "formatted_end": "06:45:49.000",
      "text": "بابا نمیده؟"
    },
    {
      "id": 12,
      "start": 24349.0,
      "end": 24350.0,
      "formatted_start": "06:45:49.000",
      "formatted_end": "06:45:50.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 24350.0,
      "end": 24351.0,
      "formatted_start": "06:45:50.000",
      "formatted_end": "06:45:51.000",
      "text": "ولی همون بگو زنگ زنگ"
    },
    {
      "id": 14,
      "start": 24351.0,
      "end": 24352.0,
      "formatted_start": "06:45:51.000",
      "formatted_end": "06:45:52.000",
      "text": "من تیکش اومده"
    },
    {
      "id": 15,
      "start": 24352.0,
      "end": 24354.0,
      "formatted_start": "06:45:52.000",
      "formatted_end": "06:45:54.000",
      "text": "بس اینجور من دو دقیقه نمیده"
    },
    {
      "id": 16,
      "start": 24354.0,
      "end": 24355.0,
      "formatted_start": "06:45:54.000",
      "formatted_end": "06:45:55.000",
      "text": "بگو بگو"
    },
    {
      "id": 17,
      "start": 24355.0,
      "end": 24356.0,
      "formatted_start": "06:45:55.000",
      "formatted_end": "06:45:56.000",
      "text": "ها کهی بوده؟ بزرگ کن"
    },
    {
      "id": 18,
      "start": 24356.0,
      "end": 24358.0,
      "formatted_start": "06:45:56.000",
      "formatted_end": "06:45:58.000",
      "text": "31 یه 5 313 آمده"
    },
    {
      "id": 19,
      "start": 24358.0,
      "end": 24360.0,
      "formatted_start": "06:45:58.000",
      "formatted_end": "06:46:00.000",
      "text": "همون روزایی که همونی که..."
    },
    {
      "id": 20,
      "start": 24360.0,
      "end": 24362.0,
      "formatted_start": "06:46:00.000",
      "formatted_end": "06:46:02.000",
      "text": "سایت دو و چهر دقیقه"
    },
    {
      "id": 21,
      "start": 24362.0,
      "end": 24364.0,
      "formatted_start": "06:46:02.000",
      "formatted_end": "06:46:04.000",
      "text": "من اینجور مردم که پیزنی بودن"
    },
    {
      "id": 22,
      "start": 24364.0,
      "end": 24366.0,
      "formatted_start": "06:46:04.000",
      "formatted_end": "06:46:06.000",
      "text": "اینگو ما فولادی ایم"
    },
    {
      "id": 23,
      "start": 24366.0,
      "end": 24368.0,
      "formatted_start": "06:46:06.000",
      "formatted_end": "06:46:08.000",
      "text": "ما فولادی ایم"
    },
    {
      "id": 24,
      "start": 24368.0,
      "end": 24370.0,
      "formatted_start": "06:46:08.000",
      "formatted_end": "06:46:10.000",
      "text": "من گفتن این فولاد نباشی"
    },
    {
      "id": 25,
      "start": 24370.0,
      "end": 24372.0,
      "formatted_start": "06:46:10.000",
      "formatted_end": "06:46:12.000",
      "text": "نمیزنم بگم که که فول میگیرم"
    },
    {
      "id": 26,
      "start": 24372.0,
      "end": 24374.0,
      "formatted_start": "06:46:12.000",
      "formatted_end": "06:46:14.000",
      "text": "که بعدش که سایت برشو چک کردم"
    },
    {
      "id": 27,
      "start": 24374.0,
      "end": 24376.0,
      "formatted_start": "06:46:14.000",
      "formatted_end": "06:46:16.000",
      "text": "یا فولاد نیستم"
    },
    {
      "id": 28,
      "start": 24376.0,
      "end": 24378.0,
      "formatted_start": "06:46:16.000",
      "formatted_end": "06:46:18.000",
      "text": "در این وقت شما پسنش خوب شدید"
    },
    {
      "id": 29,
      "start": 24378.0,
      "end": 24380.0,
      "formatted_start": "06:46:18.000",
      "formatted_end": "06:46:20.000",
      "text": "در این وقت پسنش بر پسنش بگفت"
    },
    {
      "id": 30,
      "start": 24380.0,
      "end": 24382.0,
      "formatted_start": "06:46:20.000",
      "formatted_end": "06:46:22.000",
      "text": "پسنش در همون لحظه"
    },
    {
      "id": 31,
      "start": 24382.0,
      "end": 24385.24,
      "formatted_start": "06:46:22.000",
      "formatted_end": "06:46:25.240",
      "text": "آره میتونست این بیرونتی کمی نپرونی کسی"
    },
    {
      "id": 32,
      "start": 24385.24,
      "end": 24385.74,
      "formatted_start": "06:46:25.240",
      "formatted_end": "06:46:25.740",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 24385.74,
      "end": 24386.96,
      "formatted_start": "06:46:25.740",
      "formatted_end": "06:46:26.960",
      "text": "بعد دیگه هیچی"
    },
    {
      "id": 34,
      "start": 24386.96,
      "end": 24387.4,
      "formatted_start": "06:46:26.960",
      "formatted_end": "06:46:27.400",
      "text": "بعدش"
    },
    {
      "id": 35,
      "start": 24387.4,
      "end": 24388.72,
      "formatted_start": "06:46:27.400",
      "formatted_end": "06:46:28.720",
      "text": "مولا روز روز پشت رسیدید"
    },
    {
      "id": 36,
      "start": 24388.72,
      "end": 24391.3,
      "formatted_start": "06:46:28.720",
      "formatted_end": "06:46:31.300",
      "text": "ببخشیده آموز من 33 تا 13 تا"
    },
    {
      "id": 37,
      "start": 24391.3,
      "end": 24392.74,
      "formatted_start": "06:46:31.300",
      "formatted_end": "06:46:32.740",
      "text": "شمار من که رو شماره بود؟"
    },
    {
      "id": 38,
      "start": 24392.74,
      "end": 24394.42,
      "formatted_start": "06:46:32.740",
      "formatted_end": "06:46:34.420",
      "text": "با ماما نداره تو بشیش داده"
    },
    {
      "id": 39,
      "start": 24394.42,
      "end": 24395.42,
      "formatted_start": "06:46:34.420",
      "formatted_end": "06:46:35.420",
      "text": "کنه چرا شماره من؟"
    },
    {
      "id": 40,
      "start": 24395.42,
      "end": 24396.22,
      "formatted_start": "06:46:35.420",
      "formatted_end": "06:46:36.220",
      "text": "اگه با سمان نمیدونه بود"
    },
    {
      "id": 41,
      "start": 24396.22,
      "end": 24397.36,
      "formatted_start": "06:46:36.220",
      "formatted_end": "06:46:37.360",
      "text": "تو بشیش من حسن رو فیده"
    },
    {
      "id": 42,
      "start": 24397.36,
      "end": 24398.26,
      "formatted_start": "06:46:37.360",
      "formatted_end": "06:46:38.260",
      "text": "من فیده کردم"
    },
    {
      "id": 43,
      "start": 24398.26,
      "end": 24399.28,
      "formatted_start": "06:46:38.260",
      "formatted_end": "06:46:39.280",
      "text": "چون حسن نمیدونه بود"
    },
    {
      "id": 44,
      "start": 24399.28,
      "end": 24401.28,
      "formatted_start": "06:46:39.280",
      "formatted_end": "06:46:41.280",
      "text": "315 تومن"
    },
    {
      "id": 45,
      "start": 24401.28,
      "end": 24403.28,
      "formatted_start": "06:46:41.280",
      "formatted_end": "06:46:43.280",
      "text": "دیده اگه معید اشتباهی بوده"
    },
    {
      "id": 46,
      "start": 24403.28,
      "end": 24405.28,
      "formatted_start": "06:46:43.280",
      "formatted_end": "06:46:45.280",
      "text": "ست هزار تومن یه تومن ببنده داره"
    },
    {
      "id": 47,
      "start": 24405.28,
      "end": 24407.28,
      "formatted_start": "06:46:45.280",
      "formatted_end": "06:46:47.280",
      "text": "اینو منتش برگرده"
    },
    {
      "id": 48,
      "start": 24407.28,
      "end": 24409.28,
      "formatted_start": "06:46:47.280",
      "formatted_end": "06:46:49.280",
      "text": "مثل نگاه نکرده ببینم که ست تومن"
    },
    {
      "id": 49,
      "start": 24409.28,
      "end": 24411.28,
      "formatted_start": "06:46:49.280",
      "formatted_end": "06:46:51.280",
      "text": "دیده ست هزار تومن"
    },
    {
      "id": 50,
      "start": 24411.28,
      "end": 24413.28,
      "formatted_start": "06:46:51.280",
      "formatted_end": "06:46:53.280",
      "text": "ست هزار تومن"
    },
    {
      "id": 51,
      "start": 24413.28,
      "end": 24415.28,
      "formatted_start": "06:46:53.280",
      "formatted_end": "06:46:55.280",
      "text": "ست هزار تومن"
    },
    {
      "id": 52,
      "start": 24415.28,
      "end": 24417.28,
      "formatted_start": "06:46:55.280",
      "formatted_end": "06:46:57.280",
      "text": "یکو"
    },
    {
      "id": 53,
      "start": 24417.28,
      "end": 24419.28,
      "formatted_start": "06:46:57.280",
      "formatted_end": "06:46:59.280",
      "text": "یکو پونزده هزار تومن بود"
    },
    {
      "id": 54,
      "start": 24419.28,
      "end": 24421.28,
      "formatted_start": "06:46:59.280",
      "formatted_end": "06:47:01.280",
      "text": "شیست هزار تومنش مورد"
    },
    {
      "id": 55,
      "start": 24421.28,
      "end": 24423.28,
      "formatted_start": "06:47:01.280",
      "formatted_end": "06:47:03.280",
      "text": "یه روزه کامل کن"
    },
    {
      "id": 56,
      "start": 24423.28,
      "end": 24425.28,
      "formatted_start": "06:47:03.280",
      "formatted_end": "06:47:05.280",
      "text": "و برمش مورد یه روزه"
    },
    {
      "id": 57,
      "start": 24425.28,
      "end": 24427.28,
      "formatted_start": "06:47:05.280",
      "formatted_end": "06:47:07.280",
      "text": "خب هیچی به تنگ زد که من یه تومنی زدم"
    },
    {
      "id": 58,
      "start": 24427.28,
      "end": 24434.78,
      "formatted_start": "06:47:07.280",
      "formatted_end": "06:47:14.780",
      "text": "نه، بعد همون زنگیری نداره و دختری گفت، آره پدر شوهر من چیزه به جایی صد تومنی یا دوتا زبانی بوده،"
    },
    {
      "id": 59,
      "start": 24434.78,
      "end": 24440.78,
      "formatted_start": "06:47:14.780",
      "formatted_end": "06:47:20.780",
      "text": "من صد تومنی بخواستم برد، یه تومنی داده، بعد اشتباه بنده خود رو نمیشناخته،"
    },
    {
      "id": 60,
      "start": 24440.78,
      "end": 24444.78,
      "formatted_start": "06:47:20.780",
      "formatted_end": "06:47:24.780",
      "text": "بعد من رو افتادم که یه مدار این هستم پولا تو جیبه من رو برداشتم،"
    },
    {
      "id": 61,
      "start": 24444.78,
      "end": 24448.28,
      "formatted_start": "06:47:24.780",
      "formatted_end": "06:47:28.280",
      "text": "زنگیرم برده خورم تقریبا تو جیبه من نیابه بودم، پولا هست گفت، باید کم چیه؟"
    },
    {
      "id": 62,
      "start": 24448.28,
      "end": 24450.28,
      "formatted_start": "06:47:28.280",
      "formatted_end": "06:47:30.280",
      "text": "چند قدر بود یک و پونزدر"
    },
    {
      "id": 63,
      "start": 24450.28,
      "end": 24452.28,
      "formatted_start": "06:47:30.280",
      "formatted_end": "06:47:32.280",
      "text": "در حال پدرش ست ست میگو دیگه"
    },
    {
      "id": 64,
      "start": 24452.28,
      "end": 24454.28,
      "formatted_start": "06:47:32.280",
      "formatted_end": "06:47:34.280",
      "text": "باید هم باشه پدر بخونم بلا باسر بدم"
    },
    {
      "id": 65,
      "start": 24454.28,
      "end": 24457.28,
      "formatted_start": "06:47:34.280",
      "formatted_end": "06:47:37.280",
      "text": "دستان رخیان که وقت مشتری همه که کسی دست و جیب هم برده"
    },
    {
      "id": 66,
      "start": 24457.28,
      "end": 24459.28,
      "formatted_start": "06:47:37.280",
      "formatted_end": "06:47:39.280",
      "text": "باید فرده بیاد دیگه"
    },
    {
      "id": 67,
      "start": 24459.28,
      "end": 24461.28,
      "formatted_start": "06:47:39.280",
      "formatted_end": "06:47:41.280",
      "text": "دیگه منو منو دیگه برگرده بیاد نیم"
    },
    {
      "id": 68,
      "start": 24461.28,
      "end": 24463.28,
      "formatted_start": "06:47:41.280",
      "formatted_end": "06:47:43.280",
      "text": "من خودمونم نگاه هرکه"
    },
    {
      "id": 69,
      "start": 24463.28,
      "end": 24466.28,
      "formatted_start": "06:47:43.280",
      "formatted_end": "06:47:46.280",
      "text": "من خودم واقعا نگاه نمیدونم فقط اینجور که اوله اینقدر نومون بخنده بشن"
    },
    {
      "id": 70,
      "start": 24466.28,
      "end": 24468.28,
      "formatted_start": "06:47:46.280",
      "formatted_end": "06:47:48.280",
      "text": "اپار اینو که ببینم اصله یا نه"
    },
    {
      "id": 71,
      "start": 24468.28,
      "end": 24470.28,
      "formatted_start": "06:47:48.280",
      "formatted_end": "06:47:50.280",
      "text": "نه، در اینجور دیگه نیست"
    },
    {
      "id": 72,
      "start": 24470.28,
      "end": 24472.28,
      "formatted_start": "06:47:50.280",
      "formatted_end": "06:47:52.280",
      "text": "نه، در اینجور دیگه نشونده"
    },
    {
      "id": 73,
      "start": 24472.28,
      "end": 24474.28,
      "formatted_start": "06:47:52.280",
      "formatted_end": "06:47:54.280",
      "text": "اصفت میخواد نه"
    },
    {
      "id": 74,
      "start": 24474.28,
      "end": 24476.28,
      "formatted_start": "06:47:54.280",
      "formatted_end": "06:47:56.280",
      "text": "اصفت میخواد نه، اینکه هم ست تومنی جدیده"
    },
    {
      "id": 75,
      "start": 24476.28,
      "end": 24480.28,
      "formatted_start": "06:47:56.280",
      "formatted_end": "06:48:00.280",
      "text": "اینه در جوانی چرا پیش شد؟"
    },
    {
      "id": 76,
      "start": 24480.28,
      "end": 24482.28,
      "formatted_start": "06:48:00.280",
      "formatted_end": "06:48:02.280",
      "text": "وقتی مشینم دیگه نمیتونم بلند بشیم"
    },
    {
      "id": 77,
      "start": 24482.28,
      "end": 24484.28,
      "formatted_start": "06:48:02.280",
      "formatted_end": "06:48:04.280",
      "text": "از زانو"
    },
    {
      "id": 78,
      "start": 24484.28,
      "end": 24486.28,
      "formatted_start": "06:48:04.280",
      "formatted_end": "06:48:06.280",
      "text": "از زانو"
    },
    {
      "id": 79,
      "start": 24486.28,
      "end": 24488.28,
      "formatted_start": "06:48:06.280",
      "formatted_end": "06:48:08.280",
      "text": "این زانو پرده درده"
    },
    {
      "id": 80,
      "start": 24488.28,
      "end": 24490.28,
      "formatted_start": "06:48:08.280",
      "formatted_end": "06:48:10.280",
      "text": "باید فیزیترافی برم نمیدونم"
    },
    {
      "id": 81,
      "start": 24492.28,
      "end": 24494.28,
      "formatted_start": "06:48:12.280",
      "formatted_end": "06:48:14.280",
      "text": "میگم"
    },
    {
      "id": 82,
      "start": 24494.28,
      "end": 24496.28,
      "formatted_start": "06:48:14.280",
      "formatted_end": "06:48:16.280",
      "text": "دیروز که همین تایده رو پیاده کردم"
    },
    {
      "id": 83,
      "start": 24496.28,
      "end": 24502.28,
      "formatted_start": "06:48:16.280",
      "formatted_end": "06:48:22.280",
      "text": "پیاده کردم این شهر بغلوه بگو که ملی بیا سرام دارم برم بزنم"
    },
    {
      "id": 84,
      "start": 24502.28,
      "end": 24507.08,
      "formatted_start": "06:48:22.280",
      "formatted_end": "06:48:27.080",
      "text": "رای سرام جدن همونجا دیدم که از زینبابا زنگ دادم بیا سرام ما را بزن"
    },
    {
      "id": 85,
      "start": 24507.08,
      "end": 24516.28,
      "formatted_start": "06:48:27.080",
      "formatted_end": "06:48:36.280",
      "text": "پیر مرده سلام به قرآن مجید اگه دیرو خون راضی دخترش گفت شفایی چطور تورو میشناسه"
    },
    {
      "id": 86,
      "start": 24516.28,
      "end": 24520.28,
      "formatted_start": "06:48:36.280",
      "formatted_end": "06:48:40.280",
      "text": "سلام تو چرا بخوام دکتر نایی ملی"
    },
    {
      "id": 87,
      "start": 24520.28,
      "end": 24524.28,
      "formatted_start": "06:48:40.280",
      "formatted_end": "06:48:44.280",
      "text": "صبح اومدم بتایید تا تایر پیر مرده تا من را دید شناخت"
    },
    {
      "id": 88,
      "start": 24524.28,
      "end": 24528.04,
      "formatted_start": "06:48:44.280",
      "formatted_end": "06:48:48.040",
      "text": "اون دختر دیگهش گفته گو نگاه چی خوشم میشه اصطلاح تو"
    },
    {
      "id": 89,
      "start": 24528.04,
      "end": 24532.12,
      "formatted_start": "06:48:48.040",
      "formatted_end": "06:48:52.120",
      "text": "بعد من سرام شده درم سرام شده تو ست سی سی بردی دیگه دو گرم چیزی چیز"
    },
    {
      "id": 90,
      "start": 24532.12,
      "end": 24536.28,
      "formatted_start": "06:48:52.120",
      "formatted_end": "06:48:56.280",
      "text": "بعد من سرام شده و از که من گفته نرو دیگه وایستا با من بگه حرف بزنیم"
    },
    {
      "id": 91,
      "start": 24536.28,
      "end": 24540.2,
      "formatted_start": "06:48:56.280",
      "formatted_end": "06:49:00.200",
      "text": "من من تو کیفم رو یادم وقعا سن برم دست جا برم رق پاره کرد"
    },
    {
      "id": 92,
      "start": 24540.2,
      "end": 24542.84,
      "formatted_start": "06:49:00.200",
      "formatted_end": "06:49:02.840",
      "text": "فا مجبور شدن که بیام از این دست این برش بیرن"
    },
    {
      "id": 93,
      "start": 24542.84,
      "end": 24546.84,
      "formatted_start": "06:49:02.840",
      "formatted_end": "06:49:06.840",
      "text": "خب نگاه کن من بهت میگم نه رو دیگه میگم وایست با من یه حرف بزنیم"
    },
    {
      "id": 94,
      "start": 24546.84,
      "end": 24550.84,
      "formatted_start": "06:49:06.840",
      "formatted_end": "06:49:10.840",
      "text": "اگه می آمدی به خدا خود تیکه فارق می کرده"
    },
    {
      "id": 95,
      "start": 24550.84,
      "end": 24554.84,
      "formatted_start": "06:49:10.840",
      "formatted_end": "06:49:14.840",
      "text": "اینقدر وایست دادم دست اینجوری پوزیشن داد اون دخترش"
    },
    {
      "id": 96,
      "start": 24554.84,
      "end": 24558.84,
      "formatted_start": "06:49:14.840",
      "formatted_end": "06:49:18.840",
      "text": "من میگم اینکه تو مکن فشار میدی به دخترش فقط من آروم اینجوری کردم"
    },
    {
      "id": 97,
      "start": 24558.84,
      "end": 24562.84,
      "formatted_start": "06:49:18.840",
      "formatted_end": "06:49:22.840",
      "text": "دستش پمه گذاشتم و این سرامش اینقدر سی سی شفته"
    },
    {
      "id": 98,
      "start": 24562.84,
      "end": 24566.84,
      "formatted_start": "06:49:22.840",
      "formatted_end": "06:49:26.840",
      "text": "چی پسش کارمند بانکه؟ اون کراسه کارمند بانکه"
    },
    {
      "id": 99,
      "start": 24566.84,
      "end": 24570.84,
      "formatted_start": "06:49:26.840",
      "formatted_end": "06:49:30.840",
      "text": "نه همینه همیشه همین حساب میکنه"
    },
    {
      "id": 100,
      "start": 24570.84,
      "end": 24572.2,
      "formatted_start": "06:49:30.840",
      "formatted_end": "06:49:32.200",
      "text": "اون کارمند بانکه یا..."
    },
    {
      "id": 101,
      "start": 24572.2,
      "end": 24573.2,
      "formatted_start": "06:49:32.200",
      "formatted_end": "06:49:33.200",
      "text": "اونش گوهرده"
    },
    {
      "id": 102,
      "start": 24573.2,
      "end": 24575.8,
      "formatted_start": "06:49:33.200",
      "formatted_end": "06:49:35.800",
      "text": "اون با کلاسه که اونجایی ماشی یه برم کنه که یکم..."
    },
    {
      "id": 103,
      "start": 24575.8,
      "end": 24577.68,
      "formatted_start": "06:49:35.800",
      "formatted_end": "06:49:37.680",
      "text": "او خود ما سنگین تره"
    },
    {
      "id": 104,
      "start": 24577.68,
      "end": 24579.08,
      "formatted_start": "06:49:37.680",
      "formatted_end": "06:49:39.080",
      "text": "حالا همون ما دوست دستی میکنم"
    },
    {
      "id": 105,
      "start": 24579.08,
      "end": 24580.08,
      "formatted_start": "06:49:39.080",
      "formatted_end": "06:49:40.080",
      "text": "نه اون نیست"
    },
    {
      "id": 106,
      "start": 24580.08,
      "end": 24583.24,
      "formatted_start": "06:49:40.080",
      "formatted_end": "06:49:43.240",
      "text": "و اینم... نه اون که من رو رسوند ماشینش این نبود"
    },
    {
      "id": 107,
      "start": 24583.24,
      "end": 24584.28,
      "formatted_start": "06:49:43.240",
      "formatted_end": "06:49:44.280",
      "text": "اون ماشین شیزه"
    },
    {
      "id": 108,
      "start": 24584.28,
      "end": 24586.6,
      "formatted_start": "06:49:44.280",
      "formatted_end": "06:49:46.600",
      "text": "این چیز بیدار بود و خیلی سنگین مردم"
    },
    {
      "id": 109,
      "start": 24586.6,
      "end": 24587.6,
      "formatted_start": "06:49:46.600",
      "formatted_end": "06:49:47.600",
      "text": "خیلی سنگین"
    },
    {
      "id": 110,
      "start": 24587.6,
      "end": 24592.28,
      "formatted_start": "06:49:47.600",
      "formatted_end": "06:49:52.280",
      "text": "این اینم دوست و شیش داره رانا داره اون نه اون از اون"
    },
    {
      "id": 111,
      "start": 24592.28,
      "end": 24596.12,
      "formatted_start": "06:49:52.280",
      "formatted_end": "06:49:56.120",
      "text": "او خیلی اون کلن مثل کارمانده بانک سنگیر ایمارو یه برد پیش بوده"
    },
    {
      "id": 112,
      "start": 24596.12,
      "end": 24597.44,
      "formatted_start": "06:49:56.120",
      "formatted_end": "06:49:57.440",
      "text": "شبیه حراست های بانک"
    },
    {
      "id": 113,
      "start": 24597.44,
      "end": 24597.84,
      "formatted_start": "06:49:57.440",
      "formatted_end": "06:49:57.840",
      "text": "باری"
    },
    {
      "id": 114,
      "start": 24597.84,
      "end": 24599.52,
      "formatted_start": "06:49:57.840",
      "formatted_end": "06:49:59.520",
      "text": "از اون رئیس بانک بوده برد"
    }
  ],
  "status": "completed"
}