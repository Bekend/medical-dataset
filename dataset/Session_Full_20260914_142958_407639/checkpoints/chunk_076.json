      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 9,
      "start": 22860.0,
      "end": 22862.0,
      "formatted_start": "06:21:00.000",
      "formatted_end": "06:21:02.000",
      "text": "خب برای من که نشانش کاری نداره"
    },
    {
      "id": 10,
      "start": 22862.0,
      "end": 22864.0,
      "formatted_start": "06:21:02.000",
      "formatted_end": "06:21:04.000",
      "text": "این ها خب آسیب های عزیزانی این ها میزن"
