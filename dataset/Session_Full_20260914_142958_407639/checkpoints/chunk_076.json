      "end": 22866.0,
      "formatted_start": "06:21:04.000",
      "formatted_end": "06:21:06.000",
      "text": "و جهانی"
    },
    {
      "id": 12,
      "start": 22866.0,
      "end": 22868.0,
      "formatted_start": "06:21:06.000",
      "formatted_end": "06:21:08.000",
      "text": "مثلا فکر نیستی که بگیم 50 سال هنوز نیستم"
    },
    {
      "id": 13,
      "start": 22868.0,
      "end": 22870.0,
      "formatted_start": "06:21:08.000",
      "formatted_end": "06:21:10.000",
      "text": "بیشتر باید خودتون"
    },
    {
      "id": 14,
      "start": 22870.0,
      "end": 22872.0,
      "formatted_start": "06:21:10.000",
      "formatted_end": "06:21:12.000",
      "text": "چون دارو من الان بلویستم"
    },
    {
      "id": 15,
      "start": 22872.0,
      "end": 22874.0,
      "formatted_start": "06:21:12.000",
      "formatted_end": "06:21:14.000",
      "text": "دیگه مثلا طرف سهنشه"
    },
    {
      "id": 16,
      "start": 22874.0,
      "end": 22876.0,
      "formatted_start": "06:21:14.000",
      "formatted_end": "06:21:16.000",
      "text": "خب من که غرس می کنم الان باشه من که"
    },
    {
      "id": 17,
      "start": 22876.0,
      "end": 22878.0,
      "formatted_start": "06:21:16.000",
      "formatted_end": "06:21:18.000",
      "text": "همه چند رو خورم این ریگرم درده خورم"
    },
    {
      "id": 18,
      "start": 22878.0,
      "end": 22880.0,
      "formatted_start": "06:21:18.000",
      "formatted_end": "06:21:20.000",
      "text": "اون من که بیدارم غرس می کنم"
    },
    {
      "id": 19,
      "start": 22880.0,
      "end": 22882.0,
      "formatted_start": "06:21:20.000",
      "formatted_end": "06:21:22.000",
      "text": "یعنی هیچ تلاشی نکن"
    },
    {
      "id": 20,
      "start": 22882.0,
      "end": 22884.0,
      "formatted_start": "06:21:22.000",
      "formatted_end": "06:21:24.000",
      "text": "این را چند وقت دیگه دوباره سر نکنی؟"
    },
    {
      "id": 21,
      "start": 22884.0,
      "end": 22886.0,
      "formatted_start": "06:21:24.000",
      "formatted_end": "06:21:26.000",
      "text": "اون سردرد هم اوقاتی چه هست؟"
    },
    {
      "id": 22,
      "start": 22886.0,
      "end": 22888.0,
      "formatted_start": "06:21:26.000",
      "formatted_end": "06:21:28.000",
      "text": "سردرد به این رقم نداره، چه موقعی سردردی؟"
    },
    {
      "id": 23,
      "start": 22888.0,
      "end": 22894.0,
      "formatted_start": "06:21:28.000",
      "formatted_end": "06:21:34.000",
      "text": "از وقتی بخور میشه، اشاره پانی زیاد میشه"
    },
    {
      "id": 24,
      "start": 22894.0,
      "end": 22896.0,
      "formatted_start": "06:21:34.000",
      "formatted_end": "06:21:36.000",
      "text": "وقتی سردردی نور چاشاتو میزنه؟"
    },
    {
      "id": 25,
      "start": 22896.0,
      "end": 22898.0,
      "formatted_start": "06:21:36.000",
      "formatted_end": "06:21:38.000",
      "text": "نه، نه"
    },
    {
      "id": 26,
      "start": 22898.0,
      "end": 22901.0,
      "formatted_start": "06:21:38.000",
      "formatted_end": "06:21:41.000",
      "text": "دوست داری اتاقت گرم باشه یا سردرد باشه؟"
    },
    {
      "id": 27,
      "start": 22901.0,
      "end": 22904.0,
      "formatted_start": "06:21:41.000",
      "formatted_end": "06:21:44.000",
      "text": "سردرد، چون همه موضوعی هست؟"
    },
    {
      "id": 28,
      "start": 22904.0,
      "end": 22908.0,
      "formatted_start": "06:21:44.000",
      "formatted_end": "06:21:48.000",
      "text": "گرما سردردت میکنه، حالا تهوان داری؟"
    },
    {
      "id": 29,
      "start": 22908.0,
      "end": 22910.0,
      "formatted_start": "06:21:48.000",
      "formatted_end": "06:21:50.000",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 22910.0,
      "end": 22914.0,
      "formatted_start": "06:21:50.000",
      "formatted_end": "06:21:54.000",
      "text": "سردرد که هسته دل میزنه یک کالا یه سردرد"
    },
    {
      "id": 31,
      "start": 22914.0,
      "end": 22920.0,
      "formatted_start": "06:21:54.000",
      "formatted_end": "06:22:00.000",
      "text": "از اینجا همه وقت هم احساسی نیزده دارم"
    },
    {
      "id": 32,
      "start": 22920.0,
      "end": 22922.0,
      "formatted_start": "06:22:00.000",
      "formatted_end": "06:22:02.000",
      "text": "مدام و درد نکرده؟"
    },
    {
      "id": 33,
      "start": 22922.0,
      "end": 22924.0,
      "formatted_start": "06:22:02.000",
      "formatted_end": "06:22:04.000",
      "text": "مدام و درد نکرده"
    },
    {
      "id": 34,
      "start": 22924.0,
      "end": 22926.0,
      "formatted_start": "06:22:04.000",
      "formatted_end": "06:22:06.000",
      "text": "اینجا هم درد داری؟"
    },
    {
      "id": 35,
      "start": 22926.0,
      "end": 22928.0,
      "formatted_start": "06:22:06.000",
      "formatted_end": "06:22:08.000",
      "text": "مدام و درد نکرده"
    },
    {
      "id": 36,
      "start": 22928.0,
      "end": 22930.0,
      "formatted_start": "06:22:08.000",
      "formatted_end": "06:22:10.000",
      "text": "اینجا هم درد داری؟"
    },
    {
      "id": 37,
      "start": 22930.0,
      "end": 22932.0,
      "formatted_start": "06:22:10.000",
      "formatted_end": "06:22:12.000",
      "text": "چشمات که ضعیب نیست؟"
    },
    {
      "id": 38,
      "start": 22932.0,
      "end": 22934.0,
      "formatted_start": "06:22:12.000",
      "formatted_end": "06:22:14.000",
      "text": "چشمات نیست"
    },
    {
      "id": 39,
      "start": 22934.0,
      "end": 22936.0,
      "formatted_start": "06:22:14.000",
      "formatted_end": "06:22:16.000",
      "text": "خوابت خوبه؟"
    },
    {
      "id": 40,
      "start": 22936.0,
      "end": 22939.0,
      "formatted_start": "06:22:16.000",
      "formatted_end": "06:22:19.000",
      "text": "خوابم 7 ساعت و 6-7 ساعت"
    },
    {
      "id": 41,
      "start": 22939.0,
      "end": 22941.0,
      "formatted_start": "06:22:19.000",
      "formatted_end": "06:22:21.000",
      "text": "استرساتون که زیاد نیست؟"
    },
    {
      "id": 42,
      "start": 22941.0,
      "end": 22943.0,
      "formatted_start": "06:22:21.000",
      "formatted_end": "06:22:23.000",
      "text": "استرساتون که زیاد نیست"
    },
    {
      "id": 43,
      "start": 22943.0,
      "end": 22945.0,
      "formatted_start": "06:22:23.000",
      "formatted_end": "06:22:25.000",
      "text": "شب خوبه ای خوابی؟"
    },
    {
      "id": 44,
      "start": 22945.0,
      "end": 22946.0,
      "formatted_start": "06:22:25.000",
      "formatted_end": "06:22:26.000",
      "text": "آه"
    },
    {
      "id": 45,
      "start": 22946.0,
      "end": 22947.0,
      "formatted_start": "06:22:26.000",
      "formatted_end": "06:22:27.000",
      "text": "خوابه بد نمیدی؟"
    },
    {
      "id": 46,
      "start": 22947.0,
      "end": 22948.0,
      "formatted_start": "06:22:27.000",
      "formatted_end": "06:22:28.000",
      "text": "آه"
    },
    {
      "id": 47,
      "start": 22948.0,
      "end": 22950.0,
      "formatted_start": "06:22:28.000",
      "formatted_end": "06:22:30.000",
      "text": "چند روز در رفته سردرد؟"
    },
    {
      "id": 48,
      "start": 22950.0,
      "end": 22954.0,
      "formatted_start": "06:22:30.000",
      "formatted_end": "06:22:34.000",
      "text": "خصوصاً اشاره کاری زیادی شده"
    },
    {
      "id": 49,
      "start": 22954.0,
      "end": 22956.0,
      "formatted_start": "06:22:34.000",
      "formatted_end": "06:22:36.000",
      "text": "خب میشه چند روز در رفته یعنی؟"
    },
    {
      "id": 50,
      "start": 22956.0,
      "end": 22958.0,
      "formatted_start": "06:22:36.000",
      "formatted_end": "06:22:38.000",
      "text": "در رفته سه دو"
    },
    {
      "id": 51,
      "start": 22958.0,
      "end": 22960.0,
      "formatted_start": "06:22:38.000",
      "formatted_end": "06:22:40.000",
      "text": "دو روز در رفته؟"
    },
    {
      "id": 52,
      "start": 22960.0,
      "end": 22962.0,
      "formatted_start": "06:22:40.000",
      "formatted_end": "06:22:42.000",
      "text": "حداکسر دو روز در رفته؟"
    },
    {
      "id": 53,
      "start": 22962.0,
      "end": 22964.0,
      "formatted_start": "06:22:42.000",
      "formatted_end": "06:22:44.000",
      "text": "خصوصاً زمانی که براموامیل گرده میکنه"
    },
    {
      "id": 54,
      "start": 22964.0,
      "end": 22967.0,
      "formatted_start": "06:22:44.000",
      "formatted_end": "06:22:47.000",
      "text": "چرا سردرد میشه؟ بگو میتونه اندازی خب"
    },
    {
      "id": 55,
      "start": 22967.0,
      "end": 22970.0,
      "formatted_start": "06:22:47.000",
      "formatted_end": "06:22:50.000",
      "text": "بگو مثلاً ما بخواییم بهت دارو دائم بدیم"
    },
    {
      "id": 56,
      "start": 22970.0,
      "end": 22975.0,
      "formatted_start": "06:22:50.000",
      "formatted_end": "06:22:55.000",
      "text": "باید ببینیم چند روز دارده تو سردرده های عرضش داره کلومیتیش به محفظ"
    },
    {
      "id": 57,
      "start": 22975.0,
      "end": 22980.0,
      "formatted_start": "06:22:55.000",
      "formatted_end": "06:23:00.000",
      "text": "اینکه یه بار سردرد بشی یه مسکن بخوری یا اینکه دارو میبینیم سردرد نشید"
    },
    {
      "id": 58,
      "start": 22980.0,
      "end": 22985.0,
      "formatted_start": "06:23:00.000",
      "formatted_end": "06:23:05.000",
      "text": "اگه سردرد ها توترش سیاده یعنی مثلا میدونه که هفته سه تا مسکن میخوره"
    },
    {
      "id": 59,
      "start": 22985.0,
      "end": 22987.0,
      "formatted_start": "06:23:05.000",
      "formatted_end": "06:23:07.000",
      "text": "چهار تا مسکن دارید"
    },
    {
      "id": 60,
      "start": 22987.0,
      "end": 22989.0,
      "formatted_start": "06:23:07.000",
      "formatted_end": "06:23:09.000",
      "text": "خیلی مسکن نمیخورم"
    },
    {
      "id": 61,
      "start": 22989.0,
      "end": 22992.0,
      "formatted_start": "06:23:09.000",
      "formatted_end": "06:23:12.000",
      "text": "خیلی هم که درم داشته و شش هستم"
    },
    {
      "id": 62,
      "start": 22992.0,
      "end": 22996.5,
      "formatted_start": "06:23:12.000",
      "formatted_end": "06:23:16.500",
      "text": "اگه خیلی ده اونقدر پس شدید نیست یعنی قابل تهماله"
    },
    {
      "id": 63,
      "start": 22996.5,
      "end": 22999.34,
      "formatted_start": "06:23:16.500",
      "formatted_end": "06:23:19.340",
      "text": "تازه اینجور شده هست که دراز محتق نیست"
    },
    {
      "id": 64,
      "start": 22999.34,
      "end": 23005.08,
      "formatted_start": "06:23:19.340",
      "formatted_end": "06:23:25.080",
      "text": "بخواد یک گرم و کامسون و آبی و اینا هاست بیشتر"
    },
    {
      "id": 65,
      "start": 23005.08,
      "end": 23006.54,
      "formatted_start": "06:23:25.080",
      "formatted_end": "06:23:26.540",
      "text": "پس فیلم عجبه نکن"
    },
    {
      "id": 66,
      "start": 23006.54,
      "end": 23008.82,
      "formatted_start": "06:23:26.540",
      "formatted_end": "06:23:28.820",
      "text": "دارو نمیخواد بخوری"
    },
    {
      "id": 67,
      "start": 23008.82,
      "end": 23012.5,
      "formatted_start": "06:23:28.820",
      "formatted_end": "06:23:32.500",
      "text": "یه منیزیوم جوشان برده نه"
    },
    {
      "id": 68,
      "start": 23012.5,
      "end": 23015.0,
      "formatted_start": "06:23:32.500",
      "formatted_end": "06:23:35.000",
      "text": "انسان خودش میکرد سردردارو کم کنه"
    },
    {
      "id": 69,
      "start": 23015.0,
      "end": 23019.18,
      "formatted_start": "06:23:35.000",
      "formatted_end": "06:23:39.180",
      "text": "بعد سونگرافی کولیات ها انجام بده"
    },
    {
      "id": 70,
      "start": 23019.18,
      "end": 23021.82,
      "formatted_start": "06:23:39.180",
      "formatted_end": "06:23:41.820",
      "text": "سونگرافی تا کامل برنیم سمیه کولیات برن"
    },
    {
      "id": 71,
      "start": 23021.82,
      "end": 23023.82,
      "formatted_start": "06:23:41.820",
      "formatted_end": "06:23:43.820",
      "text": "بریم میسی کامون با من"
    },
    {
      "id": 72,
      "start": 23023.82,
      "end": 23026.82,
      "formatted_start": "06:23:43.820",
      "formatted_end": "06:23:46.820",
      "text": "چون من فرق کنه یکی میخوای"
    },
    {
      "id": 73,
      "start": 23026.82,
      "end": 23028.82,
      "formatted_start": "06:23:46.820",
      "formatted_end": "06:23:48.820",
      "text": "کامون نمیشه کمون"
    },
    {
      "id": 74,
      "start": 23028.82,
      "end": 23029.82,
      "formatted_start": "06:23:48.820",
      "formatted_end": "06:23:49.820",
      "text": "چون میبخوایم"
    },
    {
      "id": 75,
      "start": 23029.82,
      "end": 23031.82,
      "formatted_start": "06:23:49.820",
      "formatted_end": "06:23:51.820",
      "text": "بد نیست بعد از"
    },
    {
      "id": 76,
      "start": 23031.82,
      "end": 23034.82,
      "formatted_start": "06:23:51.820",
      "formatted_end": "06:23:54.820",
      "text": "من رو برسیم به چهری سالگی"
    },
    {
      "id": 77,
      "start": 23034.82,
      "end": 23035.82,
      "formatted_start": "06:23:54.820",
      "formatted_end": "06:23:55.820",
      "text": "اگه تانا نرفتی برو"
    },
    {
      "id": 78,
      "start": 23035.82,
      "end": 23036.82,
      "formatted_start": "06:23:55.820",
      "formatted_end": "06:23:56.820",
      "text": "آره تانا"
    },
    {
      "id": 79,
      "start": 23036.82,
      "end": 23037.82,
      "formatted_start": "06:23:56.820",
      "formatted_end": "06:23:57.820",
      "text": "آره"
    },
    {
      "id": 80,
      "start": 23037.82,
      "end": 23039.82,
      "formatted_start": "06:23:57.820",
      "formatted_end": "06:23:59.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 81,
      "start": 23039.82,
      "end": 23040.82,
      "formatted_start": "06:23:59.820",
      "formatted_end": "06:24:00.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 82,
      "start": 23040.82,
      "end": 23041.82,
      "formatted_start": "06:24:00.820",
      "formatted_end": "06:24:01.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 83,
      "start": 23041.82,
      "end": 23042.82,
      "formatted_start": "06:24:01.820",
      "formatted_end": "06:24:02.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 84,
      "start": 23042.82,
      "end": 23043.82,
      "formatted_start": "06:24:02.820",
      "formatted_end": "06:24:03.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 85,
      "start": 23043.82,
      "end": 23044.82,
      "formatted_start": "06:24:03.820",
      "formatted_end": "06:24:04.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 86,
      "start": 23044.82,
      "end": 23045.82,
      "formatted_start": "06:24:04.820",
      "formatted_end": "06:24:05.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 87,
      "start": 23045.82,
      "end": 23046.82,
      "formatted_start": "06:24:05.820",
      "formatted_end": "06:24:06.820",
      "text": "دارو نمیبشه"
    },
    {
      "id": 88,
      "start": 23046.82,
      "end": 23047.82,
      "formatted_start": "06:24:06.820",
      "formatted_end": "06:24:07.820",
      "text": "برسن شکر کنی"
    },
    {
      "id": 89,
      "start": 23047.82,
      "end": 23077.82,
      "formatted_start": "06:24:07.820",
      "formatted_end": "06:24:37.820",
      "text": "برنامه اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای ا"
    },
