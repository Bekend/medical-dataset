  "stt_segments": [
    {
      "id": 0,
      "start": 23100.0,
      "end": 23129.98,
      "formatted_start": "06:25:00.000",
      "formatted_end": "06:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 23130.0,
      "end": 23136.0,
      "formatted_start": "06:25:30.000",
      "formatted_end": "06:25:36.000",
      "text": "خانتور جامی دالوار هر تو نوشته بودن برای خانتور جامی؟"
    },
    {
      "id": 2,
      "start": 23136.0,
      "end": 23138.0,
      "formatted_start": "06:25:36.000",
      "formatted_end": "06:25:38.000",
      "text": "بله دالوار نوشته بودم"
    },
    {
      "id": 3,
      "start": 23138.0,
      "end": 23142.0,
      "formatted_start": "06:25:38.000",
      "formatted_end": "06:25:42.000",
      "text": "چون خانتور جامی سنگات ریزه سلامتی"
    },
    {
      "id": 4,
      "start": 23142.0,
      "end": 23144.0,
      "formatted_start": "06:25:42.000",
      "formatted_end": "06:25:44.000",
      "text": "یعنی کمتر شده یا زمان"
    },
    {
      "id": 5,
      "start": 23144.0,
      "end": 23148.0,
      "formatted_start": "06:25:44.000",
      "formatted_end": "06:25:48.000",
      "text": "خیلی، سمت چپ کیست داری، کیستت بزرگه که کاری خواستی نمیشه"
    },
    {
      "id": 6,
      "start": 23148.0,
      "end": 23154.0,
      "formatted_start": "06:25:48.000",
      "formatted_end": "06:25:54.000",
      "text": "سمت راست سنگ تو پولیت یک دونه، درد دو میلیمت خیلی کچیکه"
    },
    {
      "id": 7,
      "start": 23154.0,
      "end": 23156.0,
      "formatted_start": "06:25:54.000",
      "formatted_end": "06:25:56.000",
      "text": "همه قدره سنگ کلاینا که نوشته هم بخورده"
    },
    {
      "id": 8,
      "start": 23156.0,
      "end": 23186.0,
      "formatted_start": "06:25:56.000",
      "formatted_end": "06:26:26.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 9,
      "start": 23186.0,
      "end": 23188.0,
      "formatted_start": "06:26:26.000",
      "formatted_end": "06:26:28.000",
      "text": "از اینجا باید بخورم که چیزا نکنه"
    },
    {
      "id": 10,
      "start": 23188.0,
      "end": 23190.0,
      "formatted_start": "06:26:28.000",
      "formatted_end": "06:26:30.000",
      "text": "چیزا باید بخورم که چیزا نکنه"
    },
    {
      "id": 11,
      "start": 23190.0,
      "end": 23192.0,
      "formatted_start": "06:26:30.000",
      "formatted_end": "06:26:32.000",
