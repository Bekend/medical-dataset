    {
      "id": 14,
      "start": 23196.0,
      "end": 23198.0,
      "formatted_start": "06:26:36.000",
      "formatted_end": "06:26:38.000",
      "text": "چیزا باید بخورم که چیزا نکنه"
    },
    {
      "id": 15,
      "start": 23198.0,
      "end": 23200.0,
      "formatted_start": "06:26:38.000",
      "formatted_end": "06:26:40.000",
      "text": "چیزا باید بخورم که چیزا نکنه"
    },
    {
      "id": 16,
      "start": 23200.0,
      "end": 23202.0,
      "formatted_start": "06:26:40.000",
      "formatted_end": "06:26:42.000",
      "text": "چیزا باید بخورم که چیزا نکنه"
    },
    {
      "id": 17,
      "start": 23202.0,
      "end": 23204.0,
      "formatted_start": "06:26:42.000",
      "formatted_end": "06:26:44.000",
      "text": "چیزا باید بخورم که چیزا نکنه"
    },
    {
      "id": 18,
      "start": 23204.0,
      "end": 23206.0,
      "formatted_start": "06:26:44.000",
      "formatted_end": "06:26:46.000",
      "text": "همه شما هستیم؟"
    },
    {
      "id": 19,
      "start": 23206.0,
      "end": 23208.0,
      "formatted_start": "06:26:46.000",
      "formatted_end": "06:26:48.000",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 23208.0,
      "end": 23210.0,
      "formatted_start": "06:26:48.000",
      "formatted_end": "06:26:50.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 23210.0,
      "end": 23213.0,
      "formatted_start": "06:26:50.000",
      "formatted_end": "06:26:53.000",
      "text": "این خاطر باشه قبلا گفتیم بیایی که"
    },
    {
      "id": 22,
      "start": 23213.0,
      "end": 23215.0,
      "formatted_start": "06:26:53.000",
      "formatted_end": "06:26:55.000",
      "text": "خرافی چی کنم اینجا بیریم"
    },
    {
      "id": 23,
      "start": 23215.0,
      "end": 23217.0,
      "formatted_start": "06:26:55.000",
      "formatted_end": "06:26:57.000",
      "text": "کم خون هم موده نبودی؟"
    },
    {
      "id": 24,
      "start": 23217.0,
      "end": 23218.0,
      "formatted_start": "06:26:57.000",
      "formatted_end": "06:26:58.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 23218.0,
      "end": 23220.0,
      "formatted_start": "06:26:58.000",
      "formatted_end": "06:27:00.000",
      "text": "کم خون هم موده"
    },
    {
      "id": 26,
      "start": 23222.0,
      "end": 23224.0,
      "formatted_start": "06:27:02.000",
      "formatted_end": "06:27:04.000",
      "text": "بیا شکر میکنی"
    },
    {
      "id": 27,
      "start": 23224.0,
      "end": 23226.0,
      "formatted_start": "06:27:04.000",
      "formatted_end": "06:27:06.000",
      "text": "بشین"
    },
    {
      "id": 28,
      "start": 23226.0,
      "end": 23228.0,
      "formatted_start": "06:27:06.000",
      "formatted_end": "06:27:08.000",
      "text": "کم خونی که خوب خوب شده"
    },
    {
      "id": 29,
      "start": 23228.0,
      "end": 23231.0,
      "formatted_start": "06:27:08.000",
      "formatted_end": "06:27:11.000",
      "text": "تو روی درم از درم از این کم خواهی"
    },
    {
      "id": 30,
      "start": 23231.0,
      "end": 23261.0,
      "formatted_start": "06:27:11.000",
      "formatted_end": "06:27:41.000",
      "text": "برای اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 31,
      "start": 23261.0,
      "end": 23265.0,
      "formatted_start": "06:27:41.000",
      "formatted_end": "06:27:45.000",
      "text": "از اینجا فراموش می کنید"
    },
    {
      "id": 32,
      "start": 23265.0,
      "end": 23290.98,
      "formatted_start": "06:27:45.000",
      "formatted_end": "06:28:10.980",
      "text": "از اینجا فراموش می کنید"
    },
    {
      "id": 33,
      "start": 23291.0,
      "end": 23295.0,
      "formatted_start": "06:28:11.000",
      "formatted_end": "06:28:15.000",
      "text": "نه، فقط پنج شنبه ها بخور، بس صبر باشی"
    },
    {
      "id": 34,
      "start": 23295.0,
      "end": 23300.0,
      "formatted_start": "06:28:15.000",
      "formatted_end": "06:28:20.000",
      "text": "تیروید تا به عدد مورد نظرت برسید، یکم تونی میگشه"
    },
    {
      "id": 35,
      "start": 23300.0,
      "end": 23305.0,
      "formatted_start": "06:28:20.000",
      "formatted_end": "06:28:25.000",
      "text": "استرس زیاد داری خانموی؟ خانمو زنده استرس زیاده؟"
    },
    {
      "id": 36,
      "start": 23305.0,
      "end": 23306.0,
      "formatted_start": "06:28:25.000",
      "formatted_end": "06:28:26.000",
      "text": "نه، نه"
    },
    {
      "id": 37,
      "start": 23306.0,
      "end": 23311.0,
      "formatted_start": "06:28:26.000",
      "formatted_end": "06:28:31.000",
      "text": "یون آدم هایی که تیروید هاشون خیلی اینجوریه، آدم هایی هم که استرس داره"
    },
    {
      "id": 38,
      "start": 23311.0,
      "end": 23316.0,
      "formatted_start": "06:28:31.000",
      "formatted_end": "06:28:36.000",
      "text": "تیروید خیلی به مغزت رفت داره، به روح رو عمال داره"
    },
    {
      "id": 39,
      "start": 23316.0,
      "end": 23321.44,
      "formatted_start": "06:28:36.000",
      "formatted_end": "06:28:41.440",
      "text": "یه است از یه شک بتایب بشه یه هون کمکار شده بشه"
    },
    {
      "id": 40,
      "start": 23321.44,
      "end": 23324.44,
      "formatted_start": "06:28:41.440",
      "formatted_end": "06:28:44.440",
      "text": "برای کم حاضر خودت بشه"
    },
    {
      "id": 41,
      "start": 23324.44,
      "end": 23329.44,
      "formatted_start": "06:28:44.440",
      "formatted_end": "06:28:49.440",
      "text": "بله این اشتاق خیلی زیاد شده نه؟ سویده یا نه؟"
    },
    {
      "id": 42,
      "start": 23329.44,
      "end": 23333.44,
      "formatted_start": "06:28:49.440",
      "formatted_end": "06:28:53.440",
      "text": "ما نه از حالاتی دو ماه پایک بزافه کرده"
    },
    {
      "id": 43,
      "start": 23333.44,
      "end": 23337.44,
      "formatted_start": "06:28:53.440",
      "formatted_end": "06:28:57.440",
      "text": "کمکار شده دیگه، کمکاری گرفتی دوباره"
    },
    {
      "id": 44,
      "start": 23337.44,
      "end": 23341.44,
      "formatted_start": "06:28:57.440",
      "formatted_end": "06:29:01.440",
      "text": "شده پنج و نیم، از معمول خارج شده دیگه"
    },
    {
      "id": 45,
      "start": 23341.44,
      "end": 23344.44,
      "formatted_start": "06:29:01.440",
      "formatted_end": "06:29:04.440",
      "text": "دوتارو کم کرده دوباره کمکاری گرفتی"
    },
    {
      "id": 46,
      "start": 23346.0,
      "end": 23350.0,
      "formatted_start": "06:29:06.000",
      "formatted_end": "06:29:10.000",
      "text": "میترسم چون قبلن چقدر میخوردی که شد ریست ده همون؟"
    },
    {
      "id": 47,
      "start": 23350.0,
      "end": 23352.0,
      "formatted_start": "06:29:10.000",
      "formatted_end": "06:29:12.000",
      "text": "هر روز ترین خوردیم"
    },
    {
      "id": 48,
      "start": 23352.0,
      "end": 23353.0,
      "formatted_start": "06:29:12.000",
      "formatted_end": "06:29:13.000",
      "text": "هر روز ترین خوردیم؟"
    },
    {
      "id": 49,
      "start": 23353.0,
      "end": 23356.0,
      "formatted_start": "06:29:13.000",
      "formatted_end": "06:29:16.000",
      "text": "آهسته کم کنیم، یه روز رو فیلن کم کنیم"
    },
    {
      "id": 50,
      "start": 23356.0,
      "end": 23359.0,
      "formatted_start": "06:29:16.000",
      "formatted_end": "06:29:19.000",
      "text": "چون که باز رفتی شده بودی سه ده همون، باید هر روز ترین خوردیم"
    },
    {
      "id": 51,
      "start": 23359.0,
      "end": 23362.0,
      "formatted_start": "06:29:19.000",
      "formatted_end": "06:29:22.000",
      "text": "باز الان دوباره شدید، پنج روز باز از این برای خود دادیم"
    },
    {
      "id": 52,
      "start": 23362.0,
      "end": 23367.0,
      "formatted_start": "06:29:22.000",
      "formatted_end": "06:29:27.000",
      "text": "خیلی جا به جا میشید با دو روز خوردن، این همه جا به جا شدید"
    },
    {
      "id": 53,
      "start": 23367.0,
      "end": 23388.0,
      "formatted_start": "06:29:27.000",
      "formatted_end": "06:29:48.000",
      "text": "از این حال تیرویب باوست است به همین استرس جسمی قبالی"
    },
    {
      "id": 54,
      "start": 23388.0,
      "end": 23400.0,
      "formatted_start": "06:29:48.000",
      "formatted_end": "06:30:00.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}