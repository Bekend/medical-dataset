      "id": 0,
      "start": 14700.0,
      "end": 14702.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 14730.0,
      "end": 14734.0,
      "formatted_start": "04:05:30.000",
      "formatted_end": "04:05:34.000",
      "text": "این از داره داره"
    },
    {
      "id": 2,
      "start": 14734.0,
      "end": 14736.0,
      "formatted_start": "04:05:34.000",
      "formatted_end": "04:05:36.000",
      "text": "خوبی هست"
    },
    {
      "id": 3,
      "start": 14744.0,
      "end": 14746.0,
      "formatted_start": "04:05:44.000",
      "formatted_end": "04:05:46.000",
      "text": "کجا درد میکنه مادر؟"
    },
    {
      "id": 4,
      "start": 14746.0,
      "end": 14748.0,
      "formatted_start": "04:05:46.000",
      "formatted_end": "04:05:48.000",
      "text": "کچنان یکه؟"
    },
    {
      "id": 5,
      "start": 14748.0,
      "end": 14750.0,
      "formatted_start": "04:05:48.000",
      "formatted_end": "04:05:50.000",
      "text": "نه"
    },
    {
      "id": 6,
      "start": 14750.0,
      "end": 14752.0,
      "formatted_start": "04:05:50.000",
      "formatted_end": "04:05:52.000",
      "text": "اینجا؟"
