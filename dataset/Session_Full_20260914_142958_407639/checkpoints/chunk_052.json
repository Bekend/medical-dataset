      "end": 15854.557,
      "formatted_start": "04:24:14.033",
      "formatted_end": "04:24:14.557",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15854.59,
      "end": 15855.333,
      "formatted_start": "04:24:14.590",
      "formatted_end": "04:24:15.333",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15856.025,
      "end": 15862.184,
      "formatted_start": "04:24:16.025",
      "formatted_end": "04:24:22.184",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15861.644,
      "end": 15866.032,
      "formatted_start": "04:24:21.644",
      "formatted_end": "04:24:26.032",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 15865.778,
      "end": 15869.693,
      "formatted_start": "04:24:25.778",
      "formatted_end": "04:24:29.693",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15870.352,
      "end": 15876.713,
      "formatted_start": "04:24:30.352",
      "formatted_end": "04:24:36.713",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15877.844,
      "end": 15880.51,
      "formatted_start": "04:24:37.844",
      "formatted_end": "04:24:40.510",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15880.679,
      "end": 15882.434,
      "formatted_start": "04:24:40.679",
      "formatted_end": "04:24:42.434",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15892.34,
      "end": 15893.656,
      "formatted_start": "04:24:52.340",
      "formatted_end": "04:24:53.656",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 15894.162,
      "end": 15894.652,
      "formatted_start": "04:24:54.162",
      "formatted_end": "04:24:54.652",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 15600.0,
      "end": 15612.0,
      "formatted_start": "04:20:00.000",
      "formatted_end": "04:20:12.000",
      "text": "از پشت و از در درم هم گلنم."
    },
    {
      "id": 1,
      "start": 15612.0,
      "end": 15614.0,
      "formatted_start": "04:20:12.000",
      "formatted_end": "04:20:14.000",
      "text": "درد نمی کنه؟"
    },
    {
      "id": 2,
      "start": 15614.0,
      "end": 15618.0,
      "formatted_start": "04:20:14.000",
      "formatted_end": "04:20:18.000",
      "text": "درد نمی کنه، گلنم نشد."
    },
    {
      "id": 3,
      "start": 15618.0,
      "end": 15621.0,
      "formatted_start": "04:20:18.000",
      "formatted_end": "04:20:21.000",
      "text": "آزمایش بره تو ده، بازم هیچک می کنی؟"
    },
    {
      "id": 4,
      "start": 15621.0,
      "end": 15623.0,
      "formatted_start": "04:20:21.000",
      "formatted_end": "04:20:23.000",
      "text": "آره، هر سال می کنیم."
    },
    {
      "id": 5,
      "start": 15623.0,
      "end": 15624.0,
      "formatted_start": "04:20:23.000",
      "formatted_end": "04:20:24.000",
      "text": "آره، میریدی؟"
    },
    {
      "id": 6,
      "start": 15624.0,
      "end": 15629.0,
      "formatted_start": "04:20:24.000",
      "formatted_end": "04:20:29.000",
      "text": "آره، هر رفته بلدشون خوب شد."
    },
    {
      "id": 7,
      "start": 15629.0,
      "end": 15631.0,
      "formatted_start": "04:20:29.000",
      "formatted_end": "04:20:31.000",
      "text": "اینجا باید خرد خرد شده جایی خرد شده"
    },
    {
      "id": 8,
      "start": 15632.0,
      "end": 15634.0,
      "formatted_start": "04:20:32.000",
      "formatted_end": "04:20:34.000",
      "text": "چون اینجا مده ایده اید"
    },
    {
      "id": 9,
      "start": 15635.0,
      "end": 15637.0,
      "formatted_start": "04:20:35.000",
      "formatted_end": "04:20:37.000",
      "text": "اینجا مده ایده اید"
    },
    {
      "id": 10,
      "start": 15639.0,
      "end": 15642.0,
      "formatted_start": "04:20:39.000",
      "formatted_end": "04:20:42.000",
      "text": "خب اینجا هم عمل شده هم فرق ایجاد شده"
    },
    {
      "id": 11,
      "start": 15644.0,
      "end": 15646.0,
      "formatted_start": "04:20:44.000",
      "formatted_end": "04:20:46.000",
      "text": "خوشبه است تو ماما؟"
    },
    {
      "id": 12,
      "start": 15646.0,
      "end": 15647.0,
      "formatted_start": "04:20:46.000",
      "formatted_end": "04:20:47.000",
      "text": "خوشبه است تا از این؟"
    },
    {
      "id": 13,
      "start": 15647.0,
      "end": 15648.0,
      "formatted_start": "04:20:47.000",
      "formatted_end": "04:20:48.000",
      "text": "خوشبه است"
    },
    {
      "id": 14,
      "start": 15650.0,
      "end": 15652.0,
      "formatted_start": "04:20:50.000",
      "formatted_end": "04:20:52.000",
      "text": "مابا که نمیخواد؟"
    },
    {
      "id": 15,
      "start": 15652.0,
      "end": 15653.0,
      "formatted_start": "04:20:52.000",
      "formatted_end": "04:20:53.000",
      "text": "جرو"
    },
    {
      "id": 16,
      "start": 15654.0,
      "end": 15655.0,
      "formatted_start": "04:20:54.000",
      "formatted_end": "04:20:55.000",
      "text": "نه نمیخواد"
    },
    {
      "id": 17,
      "start": 15657.0,
      "end": 15658.0,
      "formatted_start": "04:20:57.000",
      "formatted_end": "04:20:58.000",
      "text": "چون نمیسازه بهش"
    },
    {
      "id": 18,
      "start": 15658.0,
      "end": 15660.0,
      "formatted_start": "04:20:58.000",
      "formatted_end": "04:21:00.000",
      "text": "اصلا خطرمنده برای شما"
    },
    {
      "id": 19,
      "start": 15660.0,
      "end": 15664.0,
      "formatted_start": "04:21:00.000",
      "formatted_end": "04:21:04.000",
      "text": "یه دلیل دیگه اش تا ارزا خیلی مشکل نرشده اینکه مواد نمیخورند"
    },
    {
      "id": 20,
      "start": 15664.0,
      "end": 15667.0,
      "formatted_start": "04:21:04.000",
      "formatted_end": "04:21:07.000",
      "text": "اونا که مواد بخورند روده اشو برمیدارند"
    },
    {
      "id": 21,
      "start": 15667.0,
      "end": 15670.0,
      "formatted_start": "04:21:07.000",
      "formatted_end": "04:21:10.000",
      "text": "یعنی حکس دارند و بعد روده اشو میبنده خوره میشه"
    },
    {
      "id": 22,
      "start": 15670.0,
      "end": 15673.0,
      "formatted_start": "04:21:10.000",
      "formatted_end": "04:21:13.000",
      "text": "اگه جا مواد نمیخورند خوبند"
    },
    {
      "id": 23,
      "start": 15673.0,
      "end": 15677.0,
      "formatted_start": "04:21:13.000",
      "formatted_end": "04:21:17.000",
      "text": "ولی باید یه پودر هست به جای آب"
    },
    {
      "id": 24,
      "start": 15677.0,
      "end": 15679.0,
      "formatted_start": "04:21:17.000",
      "formatted_end": "04:21:19.000",
      "text": "همه اون رود باید بخورید"
    },
    {
      "id": 25,
      "start": 15679.0,
      "end": 15682.0,
      "formatted_start": "04:21:19.000",
      "formatted_end": "04:21:22.000",
      "text": "از پودر که به محمد صاحبه دادی؟"
    },
    {
      "id": 26,
      "start": 15682.0,
      "end": 15685.24,
      "formatted_start": "04:21:22.000",
      "formatted_end": "04:21:25.240",
      "text": "آره آره، که مدفوع تون شکل حالت نرم بیاد"
    },
    {
      "id": 27,
      "start": 15685.24,
      "end": 15687.24,
      "formatted_start": "04:21:25.240",
      "formatted_end": "04:21:27.240",
      "text": "گواه تا چیه شکل تون رو بیاد؟"
    },
    {
      "id": 28,
      "start": 15687.24,
      "end": 15689.24,
      "formatted_start": "04:21:27.240",
      "formatted_end": "04:21:29.240",
      "text": "باد داره شکل همش زیاد باد داره"
    },
    {
      "id": 29,
      "start": 15689.24,
      "end": 15691.24,
      "formatted_start": "04:21:29.240",
      "formatted_end": "04:21:31.240",
      "text": "باد داره، باد خوب برانه میکنه"
    },
    {
      "id": 30,
      "start": 15691.24,
      "end": 15693.24,
      "formatted_start": "04:21:31.240",
      "formatted_end": "04:21:33.240",
      "text": "کار نمی کنه باد زیاد داره"
    },
    {
      "id": 31,
      "start": 15693.24,
      "end": 15694.24,
      "formatted_start": "04:21:33.240",
      "formatted_end": "04:21:34.240",
      "text": "آره"
    },
    {
      "id": 32,
      "start": 15694.24,
      "end": 15695.24,
      "formatted_start": "04:21:34.240",
      "formatted_end": "04:21:35.240",
      "text": "اما باد همون"
    },
    {
      "id": 33,
      "start": 15696.24,
      "end": 15697.24,
      "formatted_start": "04:21:36.240",
      "formatted_end": "04:21:37.240",
      "text": "همون پودر رو درد"
    },
    {
      "id": 34,
      "start": 15697.24,
      "end": 15698.24,
      "formatted_start": "04:21:37.240",
      "formatted_end": "04:21:38.240",
      "text": "باده اینجا"
    },
    {
      "id": 35,
      "start": 15698.24,
      "end": 15700.24,
      "formatted_start": "04:21:38.240",
      "formatted_end": "04:21:40.240",
      "text": "همیشه به جای آب بخورم"
    },
    {
      "id": 36,
      "start": 15700.24,
      "end": 15705.24,
      "formatted_start": "04:21:40.240",
      "formatted_end": "04:21:45.240",
      "text": "بعد شربت همینو سم هر وقت که میبینی که پودر رو میخوری فایده نداره"
    },
    {
      "id": 37,
      "start": 15705.24,
      "end": 15710.24,
      "formatted_start": "04:21:45.240",
      "formatted_end": "04:21:50.240",
      "text": "از شربت پنج پشتوی لیوان آب گرم هم میزنیم میخوریم"
    },
    {
      "id": 38,
      "start": 15710.24,
      "end": 15714.24,
      "formatted_start": "04:21:50.240",
      "formatted_end": "04:21:54.240",
      "text": "همیشه باید هر روز شکمتون کار کنیم"
    },
    {
      "id": 39,
      "start": 15714.24,
      "end": 15718.24,
      "formatted_start": "04:21:54.240",
      "formatted_end": "04:21:58.240",
      "text": "هیچ وقت نباید بذارید شکمتون بانی بشه"
    },
    {
      "id": 40,
      "start": 15718.24,
      "end": 15720.24,
      "formatted_start": "04:21:58.240",
      "formatted_end": "04:22:00.240",
      "text": "میوه هام هم نمیتونه بخوره"
    },
    {
      "id": 41,
      "start": 15720.24,
      "end": 15723.24,
      "formatted_start": "04:22:00.240",
      "formatted_end": "04:22:03.240",
      "text": "مثلا برش پنجیرون و هم بگیره که کار کنه"
    },
    {
      "id": 42,
      "start": 15723.24,
      "end": 15725.24,
      "formatted_start": "04:22:03.240",
      "formatted_end": "04:22:05.240",
      "text": "برش آپس کنیم"
    },
    {
      "id": 43,
      "start": 15725.24,
      "end": 15727.24,
      "formatted_start": "04:22:05.240",
      "formatted_end": "04:22:07.240",
      "text": "مثلا بخون میتونیم برش آپس کنیم"
    },
    {
      "id": 44,
      "start": 15727.24,
      "end": 15730.24,
      "formatted_start": "04:22:07.240",
      "formatted_end": "04:22:10.240",
      "text": "حالا تو میوایی که برش کار میندازه گلو"
    },
    {
      "id": 45,
      "start": 15730.24,
      "end": 15733.24,
      "formatted_start": "04:22:10.240",
      "formatted_end": "04:22:13.240",
      "text": "گلو میتونیم آپس کنیم بده بخونم"
    },
    {
      "id": 46,
      "start": 15733.24,
      "end": 15735.24,
      "formatted_start": "04:22:13.240",
      "formatted_end": "04:22:15.240",
      "text": "به عمرو خونه هم تانه می آیند"
    },
    {
      "id": 47,
      "start": 15735.24,
      "end": 15736.24,
      "formatted_start": "04:22:15.240",
      "formatted_end": "04:22:16.240",
      "text": "ذره"
    },
    {
      "id": 48,
      "start": 15736.24,
      "end": 15739.24,
      "formatted_start": "04:22:16.240",
      "formatted_end": "04:22:19.240",
      "text": "میوه هر مدل هر رغم"
    },
    {
      "id": 49,
      "start": 15739.24,
      "end": 15741.24,
      "formatted_start": "04:22:19.240",
      "formatted_end": "04:22:21.240",
      "text": "که به دنخو بکنن خونه"
    },
    {
      "id": 50,
      "start": 15741.24,
      "end": 15743.24,
      "formatted_start": "04:22:21.240",
      "formatted_end": "04:22:23.240",
      "text": "انگور مثلا خوبه انجیر الاخو نیمتونه خونه"
    },
    {
      "id": 51,
      "start": 15745.24,
      "end": 15747.24,
      "formatted_start": "04:22:25.240",
      "formatted_end": "04:22:27.240",
      "text": "مدت هم سوزش میده"
    },
    {
      "id": 52,
      "start": 15747.24,
      "end": 15749.24,
      "formatted_start": "04:22:27.240",
      "formatted_end": "04:22:29.240",
      "text": "الان رو مدت هم خوش آمدن درد داشتی؟"
    },
    {
      "id": 53,
      "start": 15749.24,
      "end": 15751.24,
      "formatted_start": "04:22:29.240",
      "formatted_end": "04:22:31.240",
      "text": "خیلی"
    },
    {
      "id": 54,
      "start": 15751.24,
      "end": 15753.24,
      "formatted_start": "04:22:31.240",
      "formatted_end": "04:22:33.240",
      "text": "خورس مدت ناشته هم میخوری؟"
    },
    {
      "id": 55,
      "start": 15753.24,
      "end": 15755.24,
      "formatted_start": "04:22:33.240",
      "formatted_end": "04:22:35.240",
      "text": "ناشته اقبل همو دهدن الان ندارم"
    },
    {
      "id": 56,
      "start": 15755.24,
      "end": 15757.24,
      "formatted_start": "04:22:35.240",
      "formatted_end": "04:22:37.240",
      "text": "خورس هم نیست نرده نرخونه"
    },
    {
      "id": 57,
      "start": 15757.24,
      "end": 15759.24,
      "formatted_start": "04:22:37.240",
      "formatted_end": "04:22:39.240",
      "text": "دکتور اون خورس ها رو خودش میگیره میخوره"
    },
    {
      "id": 58,
      "start": 15759.24,
      "end": 15761.24,
      "formatted_start": "04:22:39.240",
      "formatted_end": "04:22:41.240",
      "text": "براش خوبه نیسته"
    },
    {
      "id": 59,
      "start": 15761.24,
      "end": 15763.24,
      "formatted_start": "04:22:41.240",
      "formatted_end": "04:22:43.240",
      "text": "این روزی برای شما سم هست"
    },
    {
      "id": 60,
      "start": 15763.24,
      "end": 15765.24,
      "formatted_start": "04:22:43.240",
      "formatted_end": "04:22:45.240",
      "text": "این رو چجوری میخوری؟"
    },
    {
      "id": 61,
      "start": 15765.24,
      "end": 15767.24,
      "formatted_start": "04:22:45.240",
      "formatted_end": "04:22:47.240",
      "text": "کدوم"
    },
    {
      "id": 62,
      "start": 15767.24,
      "end": 15769.24,
      "formatted_start": "04:22:47.240",
      "formatted_end": "04:22:49.240",
      "text": "این رو برای چی میخوری؟"
    },
    {
      "id": 63,
      "start": 15769.24,
      "end": 15771.24,
      "formatted_start": "04:22:49.240",
      "formatted_end": "04:22:51.240",
      "text": "این خیلی برای شما خطرناکه"
    },
    {
      "id": 64,
      "start": 15771.24,
      "end": 15773.24,
      "formatted_start": "04:22:51.240",
      "formatted_end": "04:22:53.240",
      "text": "درد پا"
    },
    {
      "id": 65,
      "start": 15773.24,
      "end": 15775.24,
      "formatted_start": "04:22:53.240",
      "formatted_end": "04:22:55.240",
      "text": "خب این ممکنه رودار ببنده یه دفعه کاره بشه"
    },
    {
      "id": 66,
      "start": 15775.24,
      "end": 15777.24,
      "formatted_start": "04:22:55.240",
      "formatted_end": "04:22:57.240",
      "text": "اون اصلا سم نبازد"
    },
    {
      "id": 67,
      "start": 15777.24,
      "end": 15779.24,
      "formatted_start": "04:22:57.240",
      "formatted_end": "04:22:59.240",
      "text": "من دیشه میخورم اونو"
    },
    {
      "id": 68,
      "start": 15779.24,
      "end": 15781.24,
      "formatted_start": "04:22:59.240",
      "formatted_end": "04:23:01.240",
      "text": "بعد این همچنین"
    },
    {
      "id": 69,
      "start": 15781.24,
      "end": 15783.24,
      "formatted_start": "04:23:01.240",
      "formatted_end": "04:23:03.240",
      "text": "روزی چندتا میخوره؟"
    },
    {
      "id": 70,
      "start": 15783.24,
      "end": 15785.24,
      "formatted_start": "04:23:03.240",
      "formatted_end": "04:23:05.240",
      "text": "روزی یکی"
    },
    {
      "id": 71,
      "start": 15785.24,
      "end": 15787.24,
      "formatted_start": "04:23:05.240",
      "formatted_end": "04:23:07.240",
      "text": "یکی از نداره"
    },
    {
      "id": 72,
      "start": 15787.24,
      "end": 15789.24,
      "formatted_start": "04:23:07.240",
      "formatted_end": "04:23:09.240",
      "text": "چون این زیاد نخونی میبنده"
    },
    {
      "id": 73,
      "start": 15789.24,
      "end": 15791.24,
      "formatted_start": "04:23:09.240",
      "formatted_end": "04:23:11.240",
      "text": "اینجا خودش میبنده"
    },
    {
      "id": 74,
      "start": 15791.24,
      "end": 15794.24,
      "formatted_start": "04:23:11.240",
      "formatted_end": "04:23:14.240",
      "text": "آره با تو این پهان زیاده"
    },
    {
      "id": 75,
      "start": 15794.24,
      "end": 15798.24,
      "formatted_start": "04:23:14.240",
      "formatted_end": "04:23:18.240",
      "text": "خیلی کم آرز داره باسترشو ایجا گیرم آید"
    },
    {
      "id": 76,
      "start": 15798.24,
      "end": 15801.24,
      "formatted_start": "04:23:18.240",
      "formatted_end": "04:23:21.240",
      "text": "این زیاده شوکر خود خیلی برمیاره"
    },
    {
      "id": 77,
      "start": 15801.24,
      "end": 15803.24,
      "formatted_start": "04:23:21.240",
      "formatted_end": "04:23:23.240",
      "text": "نه زیاده"
    },
    {
      "id": 78,
      "start": 15803.24,
      "end": 15808.24,
      "formatted_start": "04:23:23.240",
      "formatted_end": "04:23:28.240",
      "text": "بهت مسکن میدم مادر خب مثل اینا قوی نیست ولی نباید اینا رو دفتاری"
    },
    {
      "id": 79,
      "start": 15808.24,
      "end": 15812.24,
      "formatted_start": "04:23:28.240",
      "formatted_end": "04:23:32.240",
      "text": "این برای تو خیلی بده این شیاف دار شما بده"
    },
    {
      "id": 80,
      "start": 15812.24,
      "end": 15814.24,
      "formatted_start": "04:23:32.240",
      "formatted_end": "04:23:34.240",
      "text": "شیافو میذاره هر شب میذاره اینو میخوره"
    },
    {
      "id": 81,
      "start": 15814.24,
      "end": 15816.24,
      "formatted_start": "04:23:34.240",
      "formatted_end": "04:23:36.240",
      "text": "هنوز دیگه برای چون یه بسته برام گرفتی"
    },
    {
      "id": 82,
      "start": 15816.24,
      "end": 15846.24,
      "formatted_start": "04:23:36.240",
      "formatted_end": "04:24:06.240",
      "text": "برای اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 83,
      "start": 15846.24,
      "end": 15848.24,
      "formatted_start": "04:24:06.240",
      "formatted_end": "04:24:08.240",
      "text": "درد زیاد دارید زیر دلیل"
    },
    {
      "id": 84,
      "start": 15848.24,
      "end": 15850.24,
      "formatted_start": "04:24:08.240",
      "formatted_end": "04:24:10.240",
      "text": "مثلا رای مشین هم درد دارید"
    },
    {
      "id": 85,
      "start": 15850.24,
      "end": 15855.24,
      "formatted_start": "04:24:10.240",
      "formatted_end": "04:24:15.240",
      "text": "اصلا هم اون ببین هم کسای که چسبندگی دارند درد دارند"
    },
    {
      "id": 86,
      "start": 15855.24,
      "end": 15859.24,
      "formatted_start": "04:24:15.240",
      "formatted_end": "04:24:19.240",
      "text": "یه قولنج می آورده انقدر براشون درد ایجاد می کند"
    },
    {
      "id": 87,
      "start": 15859.24,
      "end": 15861.24,
      "formatted_start": "04:24:19.240",
      "formatted_end": "04:24:21.240",
      "text": "پیم التحا پیدم"
    },
    {
      "id": 88,
      "start": 15861.24,
      "end": 15865.24,
      "formatted_start": "04:24:21.240",
      "formatted_end": "04:24:25.240",
      "text": "داخلی میگه برام بر دکترون داخلی مثل افونتش از زن هم داشته باشند"
    },
    {
      "id": 89,
      "start": 15865.24,
      "end": 15867.24,
      "formatted_start": "04:24:25.240",
      "formatted_end": "04:24:27.240",
      "text": "اصلا دیگه با همین داراش یکیه"
    },
    {
      "id": 90,
      "start": 15867.24,
      "end": 15869.24,
      "formatted_start": "04:24:27.240",
      "formatted_end": "04:24:29.240",
      "text": "منو براش داره افونت می نیستم"
    },
    {
      "id": 91,
      "start": 15869.24,
      "end": 15874.24,
      "formatted_start": "04:24:29.240",
      "formatted_end": "04:24:34.240",
      "text": "افونت برسش با افونت زنان یکی افونتش داره"
    },
    {
      "id": 92,
      "start": 15876.24,
      "end": 15878.24,
      "formatted_start": "04:24:36.240",
      "formatted_end": "04:24:38.240",
      "text": "نه"
    },
    {
      "id": 93,
      "start": 15878.24,
      "end": 15880.24,
      "formatted_start": "04:24:38.240",
      "formatted_end": "04:24:40.240",
      "text": "شوهرگاه هست"
    },
    {
      "id": 94,
      "start": 15880.24,
      "end": 15882.24,
      "formatted_start": "04:24:40.240",
      "formatted_end": "04:24:42.240",
      "text": "موقع نردگی ندارد"
    },
    {
      "id": 95,
      "start": 15882.24,
      "end": 15884.24,
      "formatted_start": "04:24:42.240",
      "formatted_end": "04:24:44.240",
      "text": "نه"
    },
    {
      "id": 96,
      "start": 15892.24,
      "end": 15894.24,
      "formatted_start": "04:24:52.240",
      "formatted_end": "04:24:54.240",
      "text": "خوشکرین داره بایشه نه"
    },
    {
      "id": 97,
      "start": 15894.24,
      "end": 15896.24,
      "formatted_start": "04:24:54.240",
      "formatted_end": "04:24:56.240",
      "text": "خوشکرین"
    }
  ],
  "status": "completed"
}