  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6002.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:02.000",
      "text": "از اینجا سه ماهی رفتم."
    },
    {
      "id": 1,
      "start": 6002.0,
      "end": 6013.0,
      "formatted_start": "01:40:02.000",
      "formatted_end": "01:40:13.000",
      "text": "چون دیتامین دیتونو قبول نمی کنه. خب ولی شما، من صد کردم آزاد، میگه آزاد ولی برید چون موضوع کمارتون هست، دیتامین دیتانم برای ما مهمه برای شما."
    },
    {
      "id": 2,
      "start": 6013.0,
      "end": 6014.0,
      "formatted_start": "01:40:13.000",
      "formatted_end": "01:40:14.000",
      "text": "طبیعا."
    },
    {
      "id": 3,
      "start": 6014.0,
      "end": 6016.0,
      "formatted_start": "01:40:14.000",
      "formatted_end": "01:40:16.000",
      "text": "خب؟ اینه منیستن برید. باشه."
    },
    {
      "id": 4,
      "start": 6016.0,
      "end": 6019.0,
      "formatted_start": "01:40:16.000",
      "formatted_end": "01:40:19.000",
      "text": "کش. بر این ازموش کامل بذاریم."
    },
    {
      "id": 5,
      "start": 6019.0,
      "end": 6020.0,
      "formatted_start": "01:40:19.000",
      "formatted_end": "01:40:20.000",
      "text": "کامل بذارم بابا جان."
    },
    {
      "id": 6,
      "start": 6020.0,
      "end": 6022.0,
      "formatted_start": "01:40:20.000",
      "formatted_end": "01:40:22.000",
      "text": "ها با فشار چرا این کمباد هست؟"
    },
    {
      "id": 7,
      "start": 6022.0,
      "end": 6023.0,
      "formatted_start": "01:40:22.000",
      "formatted_end": "01:40:23.000",
      "text": "فشار؟"
    },
    {
      "id": 8,
      "start": 6023.0,
      "end": 6025.0,
      "formatted_start": "01:40:23.000",
      "formatted_end": "01:40:25.000",
      "text": "برسه فشار میخورید؟"
    },
    {
      "id": 9,
      "start": 6025.0,
      "end": 6026.0,
      "formatted_start": "01:40:25.000",
      "formatted_end": "01:40:26.000",
      "text": "میخورم، آره."
    },
    {
      "id": 10,
      "start": 6026.0,
      "end": 6056.0,
      "formatted_start": "01:40:26.000",
      "formatted_end": "01:40:56.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 11,
      "start": 6056.0,
      "end": 6058.0,
      "formatted_start": "01:40:56.000",
      "formatted_end": "01:40:58.000",
      "text": "ترشون میده اوه ترشون"
    },
    {
      "id": 12,
      "start": 6058.0,
      "end": 6060.0,
      "formatted_start": "01:40:58.000",
      "formatted_end": "01:41:00.000",
      "text": "یه پامات میده بسن بزن این شبها خود"
    },
    {
      "id": 13,
      "start": 6060.0,
      "end": 6062.0,
      "formatted_start": "01:41:00.000",
      "formatted_end": "01:41:02.000",
      "text": "ترشون میده اوه ترشون"
    },
    {
      "id": 14,
      "start": 6062.0,
      "end": 6064.0,
      "formatted_start": "01:41:02.000",
      "formatted_end": "01:41:04.000",
      "text": "در همون کودتو بابا جون اضافه میکنن"
    },
    {
      "id": 15,
      "start": 6064.0,
      "end": 6066.0,
      "formatted_start": "01:41:04.000",
      "formatted_end": "01:41:06.000",
      "text": "با همون بریت هم دارو خونه هم آزمایش کن"
    },
    {
      "id": 16,
      "start": 6066.0,
      "end": 6068.0,
      "formatted_start": "01:41:06.000",
      "formatted_end": "01:41:08.000",
      "text": "شکر داشتون بودم"
    },
    {
      "id": 17,
      "start": 6068.0,
      "end": 6070.0,
      "formatted_start": "01:41:08.000",
      "formatted_end": "01:41:10.000",
      "text": "سلام علیه و باشه"
    },
    {
      "id": 18,
      "start": 6070.0,
      "end": 6072.0,
      "formatted_start": "01:41:10.000",
      "formatted_end": "01:41:12.000",
      "text": "بابا بسیار"
    },
    {
      "id": 19,
      "start": 6072.0,
      "end": 6074.0,
      "formatted_start": "01:41:12.000",
      "formatted_end": "01:41:14.000",
      "text": "میده اوه ترشون"
    },
    {
      "id": 20,
      "start": 6074.0,
      "end": 6076.0,
      "formatted_start": "01:41:14.000",
      "formatted_end": "01:41:16.000",
      "text": "ماما هستی؟ نه میده هست"
    },
    {
      "id": 21,
      "start": 6076.0,
      "end": 6078.0,
      "formatted_start": "01:41:16.000",
      "formatted_end": "01:41:18.000",
      "text": "سلام"
    },
    {
      "id": 22,
      "start": 6078.0,
      "end": 6080.0,
      "formatted_start": "01:41:18.000",
      "formatted_end": "01:41:20.000",
      "text": "بیا بیا هیگه یادیم"
    },
    {
      "id": 23,
      "start": 6080.0,
      "end": 6082.0,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:22.000",
      "text": "خواهید باشه این عواشه مالی رو برده"
    },
    {
      "id": 24,
      "start": 6082.0,
      "end": 6112.0,
      "formatted_start": "01:41:22.000",
      "formatted_end": "01:41:52.000",
      "text": "از اینجا با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما ب"
    },
    {
      "id": 25,
      "start": 6112.0,
      "end": 6142.0,
      "formatted_start": "01:41:52.000",
      "formatted_end": "01:42:22.000",
      "text": "از اینجا باید بردارید که اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه ا"
    },
    {
      "id": 26,
      "start": 6142.0,
      "end": 6144.0,
      "formatted_start": "01:42:22.000",
      "formatted_end": "01:42:24.000",
      "text": "اول برو سونا"
    },
    {
      "id": 27,
      "start": 6144.0,
      "end": 6146.0,
      "formatted_start": "01:42:24.000",
      "formatted_end": "01:42:26.000",
      "text": "میخوام شفایی اینجا برد روشانسه نامداری"
    },
    {
      "id": 28,
      "start": 6146.0,
      "end": 6148.0,
      "formatted_start": "01:42:26.000",
      "formatted_end": "01:42:28.000",
      "text": "برد کبد و کسی سفراتو سوخون کنه"
    },
    {
      "id": 29,
      "start": 6148.0,
      "end": 6150.0,
      "formatted_start": "01:42:28.000",
      "formatted_end": "01:42:30.000",
      "text": "ادارت که نمیسوزه؟"
    },
    {
      "id": 30,
      "start": 6150.0,
      "end": 6152.0,
      "formatted_start": "01:42:30.000",
      "formatted_end": "01:42:32.000",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 6152.0,
      "end": 6154.0,
      "formatted_start": "01:42:32.000",
      "formatted_end": "01:42:34.000",
      "text": "ادارت بر نمیده؟"
    },
    {
      "id": 32,
      "start": 6154.0,
      "end": 6156.0,
      "formatted_start": "01:42:34.000",
      "formatted_end": "01:42:36.000",
      "text": "نه نه خونم نمیده"
    },
    {
      "id": 33,
      "start": 6156.0,
      "end": 6158.0,
      "formatted_start": "01:42:36.000",
      "formatted_end": "01:42:38.000",
      "text": "خانوادتون تا حالا کسی سنگ نداشته؟"
    },
    {
      "id": 34,
      "start": 6158.0,
      "end": 6160.0,
      "formatted_start": "01:42:38.000",
      "formatted_end": "01:42:40.000",
      "text": "بابا میداشت دیگه همه دیگه"
    },
    {
      "id": 35,
      "start": 6160.0,
      "end": 6162.0,
      "formatted_start": "01:42:40.000",
      "formatted_end": "01:42:42.000",
      "text": "البته چون تو جبه اینا بود"
    },
    {
      "id": 36,
      "start": 6162.0,
      "end": 6164.0,
      "formatted_start": "01:42:42.000",
      "formatted_end": "01:42:44.000",
      "text": "نه سنگ کولیه"
    },
    {
      "id": 37,
      "start": 6164.0,
      "end": 6166.0,
      "formatted_start": "01:42:44.000",
      "formatted_end": "01:42:46.000",
      "text": "سنگ کولیه نه نداشتم"
    },
    {
      "id": 38,
      "start": 6166.0,
      "end": 6168.0,
      "formatted_start": "01:42:46.000",
      "formatted_end": "01:42:48.000",
      "text": "سنگ سفرات داشتیم کولیه"
    },
    {
      "id": 39,
      "start": 6168.0,
      "end": 6171.76,
      "formatted_start": "01:42:48.000",
      "formatted_end": "01:42:51.760",
      "text": "بگو که زنگ بزن و برات سریع نوکردی که چون درمانگان مناسب تره"
    },
    {
      "id": 40,
      "start": 6174.56,
      "end": 6176.56,
      "formatted_start": "01:42:54.560",
      "formatted_end": "01:42:56.560",
      "text": "میتونیم از لحاظ مشکل مالی هم چند؟"
    },
    {
      "id": 41,
      "start": 6176.56,
      "end": 6178.56,
      "formatted_start": "01:42:56.560",
      "formatted_end": "01:42:58.560",
      "text": "باید میتونیم مناسب تره"
    },
    {
      "id": 42,
      "start": 6178.56,
      "end": 6183.0,
      "formatted_start": "01:42:58.560",
      "formatted_end": "01:43:03.000",
      "text": "چون شما دیاویتی هستیم خب؟"
    },
    {
      "id": 43,
      "start": 6183.0,
      "end": 6183.5,
      "formatted_start": "01:43:03.000",
      "formatted_end": "01:43:03.500",
      "text": "درسته"
    },
    {
      "id": 44,
      "start": 6183.5,
      "end": 6186.7,
      "formatted_start": "01:43:03.500",
      "formatted_end": "01:43:06.700",
      "text": "اولین تدسیس با درد این محل کسی صفرا کرد"
    },
    {
      "id": 45,
      "start": 6186.7,
      "end": 6188.7,
      "formatted_start": "01:43:06.700",
      "formatted_end": "01:43:08.700",
      "text": "که اونو چرش میده کسی صفرا کرد"
    },
    {
      "id": 46,
      "start": 6188.7,
      "end": 6191.5,
      "formatted_start": "01:43:08.700",
      "formatted_end": "01:43:11.500",
      "text": "از این باید خاطرمون جمع بشه"
    },
    {
      "id": 47,
      "start": 6191.5,
      "end": 6193.5,
      "formatted_start": "01:43:11.500",
      "formatted_end": "01:43:13.500",
      "text": "بعد بریم بقیه جهات رو درمان کنیم"
    },
    {
      "id": 48,
      "start": 6198.0,
      "end": 6200.0,
      "formatted_start": "01:43:18.000",
      "formatted_end": "01:43:20.000",
      "text": "کجا درمانگاه باید بید؟"
    },
    {
      "id": 49,
      "start": 6200.0,
      "end": 6202.0,
      "formatted_start": "01:43:20.000",
      "formatted_end": "01:43:22.000",
      "text": "این درمانگاه سپاه است"
    },
    {
      "id": 50,
      "start": 6202.0,
      "end": 6204.0,
      "formatted_start": "01:43:22.000",
      "formatted_end": "01:43:24.000",
      "text": "کجا است؟ گمبه؟"
    },
    {
      "id": 51,
      "start": 6204.0,
      "end": 6206.0,
      "formatted_start": "01:43:24.000",
      "formatted_end": "01:43:26.000",
      "text": "نه نه، همه چند تا گجه باید بید"
    },
    {
      "id": 52,
      "start": 6208.0,
      "end": 6210.0,
      "formatted_start": "01:43:28.000",
      "formatted_end": "01:43:30.000",
      "text": "من اینو من به خاطر خیلی گمم نشد"
    },
    {
      "id": 53,
      "start": 6210.0,
      "end": 6212.0,
      "formatted_start": "01:43:30.000",
      "formatted_end": "01:43:32.000",
      "text": "چون سمت کامل به دو میلیون است"
    },
    {
      "id": 54,
      "start": 6212.0,
      "end": 6214.0,
      "formatted_start": "01:43:32.000",
      "formatted_end": "01:43:34.000",
      "text": "خب؟"
    },
    {
      "id": 55,
      "start": 6214.0,
      "end": 6216.0,
      "formatted_start": "01:43:34.000",
      "formatted_end": "01:43:36.000",
      "text": "اگه مشکل نداری کامل بگیرم"
    },
    {
      "id": 56,
      "start": 6216.0,
      "end": 6218.0,
      "formatted_start": "01:43:36.000",
      "formatted_end": "01:43:38.000",
      "text": "اگر کچی..."
    },
    {
      "id": 57,
      "start": 6218.0,
      "end": 6220.0,
      "formatted_start": "01:43:38.000",
      "formatted_end": "01:43:40.000",
      "text": "خیلی خوب، بر اینکه کم تر بشه"
    },
    {
      "id": 58,
      "start": 6220.0,
      "end": 6222.0,
      "formatted_start": "01:43:40.000",
      "formatted_end": "01:43:42.000",
      "text": "خب؟ چون من سمت رو داشته باشم"
    },
    {
      "id": 59,
      "start": 6222.0,
      "end": 6224.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:44.000",
      "text": "کافی است"
    },
    {
      "id": 60,
      "start": 6224.0,
      "end": 6226.0,
      "formatted_start": "01:43:44.000",
      "formatted_end": "01:43:46.000",
      "text": "اگه دیدیم توش چیزیه که ایچی"
    },
    {
      "id": 61,
      "start": 6226.0,
      "end": 6229.7,
      "formatted_start": "01:43:46.000",
      "formatted_end": "01:43:49.700",
      "text": "اگر دیدیم چیزی نبود میری ازماشه ادرار همین این سامانجام میدی"
    },
    {
      "id": 62,
      "start": 6230.54,
      "end": 6233.24,
      "formatted_start": "01:43:50.540",
      "formatted_end": "01:43:53.240",
      "text": "مگه سنوی کامل از اون بدم؟"
    },
    {
      "id": 63,
      "start": 6233.24,
      "end": 6235.24,
      "formatted_start": "01:43:53.240",
      "formatted_end": "01:43:55.240",
      "text": "ازماشه ادرار نمیمیخواد"
    },
    {
      "id": 64,
      "start": 6235.24,
      "end": 6237.24,
      "formatted_start": "01:43:55.240",
      "formatted_end": "01:43:57.240",
      "text": "ازماشه ادرار ما؟"
    },
    {
      "id": 65,
      "start": 6238.38,
      "end": 6240.38,
      "formatted_start": "01:43:58.380",
      "formatted_end": "01:44:00.380",
      "text": "اگر تو سنو سنگ بده بشه نه"
    },
    {
      "id": 66,
      "start": 6240.38,
      "end": 6241.48,
      "formatted_start": "01:44:00.380",
      "formatted_end": "01:44:01.480",
      "text": "هرچی بخوایی برم"
    },
    {
      "id": 67,
      "start": 6241.48,
      "end": 6242.92,
      "formatted_start": "01:44:01.480",
      "formatted_end": "01:44:02.920",
      "text": "به تشکیزت نرمی"
    },
    {
      "id": 68,
      "start": 6242.92,
      "end": 6246.12,
      "formatted_start": "01:44:02.920",
      "formatted_end": "01:44:06.120",
      "text": "نه تو الان من کبه دو کسی صفرات رو نمیشتم با یه ازماشه ادرار"
    },
    {
      "id": 69,
      "start": 6246.12,
      "end": 6247.52,
      "formatted_start": "01:44:06.120",
      "formatted_end": "01:44:07.520",
      "text": "اینجوری خیلی مناسبتر"
    },
    {
      "id": 70,
      "start": 6247.52,
      "end": 6250.08,
      "formatted_start": "01:44:07.520",
      "formatted_end": "01:44:10.080",
      "text": "ازماشه ادرار تو در مورد هجام ندی خوب نیست"
    },
    {
      "id": 71,
      "start": 6250.08,
      "end": 6252.08,
      "formatted_start": "01:44:10.080",
      "formatted_end": "01:44:12.080",
      "text": "خیلی بیادش خب"
    },
    {
      "id": 72,
      "start": 6252.08,
      "end": 6254.08,
      "formatted_start": "01:44:12.080",
      "formatted_end": "01:44:14.080",
      "text": "فصل ناشون خوبه"
    },
    {
      "id": 73,
      "start": 6254.08,
      "end": 6256.08,
      "formatted_start": "01:44:14.080",
      "formatted_end": "01:44:16.080",
      "text": "برو بیا ما هستیم"
    },
    {
      "id": 74,
      "start": 6256.08,
      "end": 6260.08,
      "formatted_start": "01:44:16.080",
      "formatted_end": "01:44:20.080",
      "text": "دو خانشفایی بگو برای سفرینه مورد بگیره نوانده"
    },
    {
      "id": 75,
      "start": 6260.08,
      "end": 6262.08,
      "formatted_start": "01:44:20.080",
      "formatted_end": "01:44:22.080",
      "text": "چون دوتورشون میره ساعت دوازداره"
    },
    {
      "id": 76,
      "start": 6262.08,
      "end": 6264.08,
      "formatted_start": "01:44:22.080",
      "formatted_end": "01:44:24.080",
      "text": "برو باشه"
    },
    {
      "id": 77,
      "start": 6264.08,
      "end": 6266.08,
      "formatted_start": "01:44:24.080",
      "formatted_end": "01:44:26.080",
      "text": "خانشفایی جهان برو"
    },
    {
      "id": 78,
      "start": 6266.08,
      "end": 6268.08,
      "formatted_start": "01:44:26.080",
      "formatted_end": "01:44:28.080",
      "text": "یه خانشفایی برش که که سفرینه مورد بگیره"
    },
    {
      "id": 79,
      "start": 6268.08,
      "end": 6270.08,
      "formatted_start": "01:44:28.080",
      "formatted_end": "01:44:30.080",
      "text": "دوتور اسلام بیخوام دوتور؟"
    },
    {
      "id": 80,
      "start": 6270.08,
      "end": 6272.08,
      "formatted_start": "01:44:30.080",
      "formatted_end": "01:44:32.080",
      "text": "نه هم دوتور یادگاه"
    },
    {
      "id": 81,
      "start": 6272.08,
      "end": 6274.08,
      "formatted_start": "01:44:32.080",
