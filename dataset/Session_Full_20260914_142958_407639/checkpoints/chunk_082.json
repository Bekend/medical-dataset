      "start": 24896.575,
      "end": 24896.93,
      "formatted_start": "06:54:56.575",
      "formatted_end": "06:54:56.930",
      "speaker": "SPEAKER_02"
    },
    {
      "start": 24897.925,
      "end": 24899.967,
      "formatted_start": "06:54:57.925",
      "formatted_end": "06:54:59.967",
      "speaker": "SPEAKER_02"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 24600.0,
      "end": 24602.0,
      "formatted_start": "06:50:00.000",
      "formatted_end": "06:50:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 24630.0,
      "end": 24632.0,
      "formatted_start": "06:50:30.000",
      "formatted_end": "06:50:32.000",
      "text": "باید تا بیمارستان شد"
    },
    {
      "id": 2,
      "start": 24632.0,
      "end": 24635.0,
      "formatted_start": "06:50:32.000",
      "formatted_end": "06:50:35.000",
      "text": "یه روز که مستقیم خواستی فردا خانه بری"
    },
    {
      "id": 3,
      "start": 24635.0,
      "end": 24637.0,
      "formatted_start": "06:50:35.000",
      "formatted_end": "06:50:37.000",
      "text": "نه بیرون هم داده باشه"
    },
    {
      "id": 4,
      "start": 24637.0,
      "end": 24639.0,
      "formatted_start": "06:50:37.000",
      "formatted_end": "06:50:39.000",
      "text": "نمیشه باز"
    },
    {
      "id": 5,
      "start": 24639.0,
      "end": 24643.0,
      "formatted_start": "06:50:39.000",
      "formatted_end": "06:50:43.000",
      "text": "از اینجور من فاندوکو فرومان روزیه باز داره"
    },
    {
      "id": 6,
      "start": 24643.0,
      "end": 24644.0,
      "formatted_start": "06:50:43.000",
      "formatted_end": "06:50:44.000",
      "text": "نه"
    },
    {
      "id": 7,
      "start": 24644.0,
      "end": 24647.0,
      "formatted_start": "06:50:44.000",
      "formatted_end": "06:50:47.000",
      "text": "چون دو گرمه من به رازیه گفتم دیگه"
    },
    {
      "id": 8,
      "start": 24647.0,
      "end": 24649.0,
      "formatted_start": "06:50:47.000",
      "formatted_end": "06:50:49.000",
      "text": "آره خب دو گرمه دیگه"
    },
    {
      "id": 9,
      "start": 24649.0,
      "end": 24651.0,
      "formatted_start": "06:50:49.000",
      "formatted_end": "06:50:51.000",
      "text": "باشه نه فیلمرده رو میگی"
    },
    {
      "id": 10,
      "start": 24651.0,
      "end": 24652.0,
      "formatted_start": "06:50:51.000",
      "formatted_end": "06:50:52.000",
      "text": "آره عزیزم موشی"
    },
    {
      "id": 11,
      "start": 24652.0,
      "end": 24653.0,
      "formatted_start": "06:50:52.000",
      "formatted_end": "06:50:53.000",
      "text": "کلو فیلمرده"
    },
    {
      "id": 12,
      "start": 24653.0,
      "end": 24655.0,
      "formatted_start": "06:50:53.000",
      "formatted_end": "06:50:55.000",
      "text": "هر دوازده ساعت داره"
    },
    {
      "id": 13,
      "start": 24655.0,
      "end": 24657.0,
      "formatted_start": "06:50:55.000",
      "formatted_end": "06:50:57.000",
      "text": "تو اونه ترکید کردم دیگه"
    },
    {
      "id": 14,
      "start": 24657.0,
      "end": 24659.0,
      "formatted_start": "06:50:57.000",
      "formatted_end": "06:50:59.000",
      "text": "هر دوازده ساعت"
    },
    {
      "id": 15,
      "start": 24660.74,
      "end": 24662.74,
      "formatted_start": "06:51:00.740",
      "formatted_end": "06:51:02.740",
      "text": "آره سرما هر دوازده ساعت"
    },
    {
      "id": 16,
      "start": 24662.74,
      "end": 24664.74,
      "formatted_start": "06:51:02.740",
      "formatted_end": "06:51:04.740",
      "text": "داداشتی که من مشته برای نمایی کردی"
    },
    {
      "id": 17,
      "start": 24664.74,
      "end": 24666.74,
      "formatted_start": "06:51:04.740",
      "formatted_end": "06:51:06.740",
      "text": "بهش میگی هر دوازده ساعت یه دونه سرما"
    },
    {
      "id": 18,
      "start": 24668.18,
      "end": 24670.18,
      "formatted_start": "06:51:08.180",
      "formatted_end": "06:51:10.180",
      "text": "روزی دوبار برده"
    },
    {
      "id": 19,
      "start": 24670.18,
      "end": 24672.18,
      "formatted_start": "06:51:10.180",
      "formatted_end": "06:51:12.180",
      "text": "توی روزی دوبار شویدی"
    },
    {
      "id": 20,
      "start": 24672.18,
      "end": 24674.18,
      "formatted_start": "06:51:12.180",
      "formatted_end": "06:51:14.180",
      "text": "برده خواهش میکنم"
    },
    {
      "id": 21,
      "start": 24674.18,
      "end": 24677.18,
      "formatted_start": "06:51:14.180",
      "formatted_end": "06:51:17.180",
      "text": "خواهش میکنم خداسو قبلا مترفت برم پسنو برش"
    },
    {
      "id": 22,
      "start": 24679.18,
      "end": 24683.18,
      "formatted_start": "06:51:19.180",
      "formatted_end": "06:51:23.180",
      "text": "میگفت ایروز یه دن دیگه ازیتم کردی دو گناه سرما"
    },
    {
      "id": 23,
      "start": 24683.18,
      "end": 24685.18,
      "formatted_start": "06:51:23.180",
      "formatted_end": "06:51:25.180",
      "text": "بخواهش میکنم که شوش کنم"
    },
    {
      "id": 24,
      "start": 24685.18,
      "end": 24691.18,
      "formatted_start": "06:51:25.180",
      "formatted_end": "06:51:31.180",
      "text": "بس تازه گو بشین آهانو جوشتارو بدید بشین ممنون در واقع بعد روزی سه بار بزنیم"
    },
    {
      "id": 25,
      "start": 24691.18,
      "end": 24693.18,
      "formatted_start": "06:51:31.180",
      "formatted_end": "06:51:33.180",
      "text": "این منی خوب سخته براتون که میخواهیم گیرم"
    },
    {
      "id": 26,
      "start": 24693.18,
      "end": 24697.18,
      "formatted_start": "06:51:33.180",
      "formatted_end": "06:51:37.180",
      "text": "اینکه متروین ازو چندتا براش خواهد بگیرید؟ ببخش نیست درست درستو چندتا بزنم؟"
    },
    {
      "id": 27,
      "start": 24697.18,
      "end": 24699.18,
      "formatted_start": "06:51:37.180",
      "formatted_end": "06:51:39.180",
      "text": "دختره"
    },
    {
      "id": 28,
      "start": 24699.18,
      "end": 24700.18,
      "formatted_start": "06:51:39.180",
      "formatted_end": "06:51:40.180",
      "text": "همین لحظه؟"
    },
    {
      "id": 29,
      "start": 24700.18,
      "end": 24701.18,
      "formatted_start": "06:51:40.180",
      "formatted_end": "06:51:41.180",
      "text": "نه نه"
    },
    {
      "id": 30,
      "start": 24701.18,
      "end": 24703.18,
      "formatted_start": "06:51:41.180",
      "formatted_end": "06:51:43.180",
      "text": "آه نوشتم من در از ازتره پرستم"
    },
    {
      "id": 31,
      "start": 24703.18,
      "end": 24705.18,
      "formatted_start": "06:51:43.180",
      "formatted_end": "06:51:45.180",
      "text": "اینو داریم در بخش این چیه؟"
    },
    {
      "id": 32,
      "start": 24705.18,
      "end": 24709.18,
      "formatted_start": "06:51:45.180",
      "formatted_end": "06:51:49.180",
      "text": "اگر در نسخه قبل نبودی تو بگیر کارتیلش"
    },
    {
      "id": 33,
      "start": 24709.18,
      "end": 24711.18,
      "formatted_start": "06:51:49.180",
      "formatted_end": "06:51:51.180",
      "text": "اما خود روسته هستم"
    },
    {
      "id": 34,
      "start": 24711.18,
      "end": 24713.18,
      "formatted_start": "06:51:51.180",
      "formatted_end": "06:51:53.180",
      "text": "تو چیه؟"
    },
    {
      "id": 35,
      "start": 24713.18,
      "end": 24715.18,
      "formatted_start": "06:51:53.180",
      "formatted_end": "06:51:55.180",
      "text": "تو از هم انگلیسش رو تایب کنی"
    },
    {
      "id": 36,
      "start": 24715.18,
      "end": 24719.18,
      "formatted_start": "06:51:55.180",
      "formatted_end": "06:51:59.180",
      "text": "اگر بنویس اگر در نسخه قبل نبودی"
    },
    {
      "id": 37,
      "start": 24719.18,
      "end": 24721.18,
      "formatted_start": "06:51:59.180",
      "formatted_end": "06:52:01.180",
      "text": "در نسخه قبل"
    },
    {
      "id": 38,
      "start": 24721.18,
      "end": 24723.18,
      "formatted_start": "06:52:01.180",
      "formatted_end": "06:52:03.180",
      "text": "بروکس ست"
    },
    {
      "id": 39,
      "start": 24723.18,
      "end": 24725.18,
      "formatted_start": "06:52:03.180",
      "formatted_end": "06:52:05.180",
      "text": "بایا ای بی اس"
    },
    {
      "id": 40,
      "start": 24725.18,
      "end": 24727.18,
      "formatted_start": "06:52:05.180",
      "formatted_end": "06:52:07.180",
      "text": "سی سده"
    },
    {
      "id": 41,
      "start": 24727.18,
      "end": 24729.18,
      "formatted_start": "06:52:07.180",
      "formatted_end": "06:52:09.180",
      "text": "نه آن پول سی سده و ویتامون دیه"
    },
    {
      "id": 42,
      "start": 24729.18,
      "end": 24731.18,
      "formatted_start": "06:52:09.180",
      "formatted_end": "06:52:11.180",
      "text": "آه این ویتامون دیه"
    },
    {
      "id": 43,
      "start": 24731.18,
      "end": 24733.18,
      "formatted_start": "06:52:11.180",
      "formatted_end": "06:52:13.180",
      "text": "آن پول"
    },
    {
      "id": 44,
      "start": 24733.18,
      "end": 24735.18,
      "formatted_start": "06:52:13.180",
      "formatted_end": "06:52:15.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 45,
      "start": 24735.18,
      "end": 24737.18,
      "formatted_start": "06:52:15.180",
      "formatted_end": "06:52:17.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 46,
      "start": 24737.18,
      "end": 24739.18,
      "formatted_start": "06:52:17.180",
      "formatted_end": "06:52:19.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 47,
      "start": 24739.18,
      "end": 24741.18,
      "formatted_start": "06:52:19.180",
      "formatted_end": "06:52:21.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 48,
      "start": 24741.18,
      "end": 24743.18,
      "formatted_start": "06:52:21.180",
      "formatted_end": "06:52:23.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 49,
      "start": 24743.18,
      "end": 24745.18,
      "formatted_start": "06:52:23.180",
      "formatted_end": "06:52:25.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 50,
      "start": 24745.18,
      "end": 24747.18,
      "formatted_start": "06:52:25.180",
      "formatted_end": "06:52:27.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 51,
      "start": 24747.18,
      "end": 24749.18,
      "formatted_start": "06:52:27.180",
      "formatted_end": "06:52:29.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 52,
      "start": 24749.18,
      "end": 24751.18,
      "formatted_start": "06:52:29.180",
      "formatted_end": "06:52:31.180",
      "text": "این هر روز هایی که برگرده باشه"
    },
    {
      "id": 53,
      "start": 24751.18,
      "end": 24752.18,
      "formatted_start": "06:52:31.180",
      "formatted_end": "06:52:32.180",
      "text": "این چند سو؟"
    },
    {
      "id": 54,
      "start": 24752.18,
      "end": 24753.18,
      "formatted_start": "06:52:32.180",
      "formatted_end": "06:52:33.180",
      "text": "۳۰"
    },
    {
      "id": 55,
      "start": 24753.18,
      "end": 24755.18,
      "formatted_start": "06:52:33.180",
      "formatted_end": "06:52:35.180",
      "text": "ها چند سو هست؟"
    },
    {
      "id": 56,
      "start": 24755.18,
      "end": 24756.18,
      "formatted_start": "06:52:35.180",
      "formatted_end": "06:52:36.180",
      "text": "روز یکی"
    },
    {
      "id": 57,
      "start": 24756.18,
      "end": 24759.18,
      "formatted_start": "06:52:36.180",
      "formatted_end": "06:52:39.180",
      "text": "مردم اصلا یک گولنجی که ماهی یه بارو میگیرشون"
    },
    {
      "id": 58,
      "start": 24759.18,
      "end": 24760.18,
      "formatted_start": "06:52:39.180",
      "formatted_end": "06:52:40.180",
      "text": "استر استر"
    },
    {
      "id": 59,
      "start": 24760.18,
      "end": 24763.18,
      "formatted_start": "06:52:40.180",
      "formatted_end": "06:52:43.180",
      "text": "با دیگه آدم ببخشون از آن"
    },
    {
      "id": 60,
      "start": 24763.18,
      "end": 24766.18,
      "formatted_start": "06:52:43.180",
      "formatted_end": "06:52:46.180",
      "text": "اون چیه دیگه؟ اونجا بذاشتی؟ اصلا نمیشه"
    },
    {
      "id": 61,
      "start": 24766.18,
      "end": 24767.18,
      "formatted_start": "06:52:46.180",
      "formatted_end": "06:52:47.180",
      "text": "پیچن میشه دیگه نه؟"
    },
    {
      "id": 62,
      "start": 24767.18,
      "end": 24767.68,
      "formatted_start": "06:52:47.180",
      "formatted_end": "06:52:47.680",
      "text": "ها؟"
    },
    {
      "id": 63,
      "start": 24767.68,
      "end": 24768.68,
      "formatted_start": "06:52:47.680",
      "formatted_end": "06:52:48.680",
      "text": "حاضر داشته"
    },
    {
      "id": 64,
      "start": 24768.68,
      "end": 24769.18,
      "formatted_start": "06:52:48.680",
      "formatted_end": "06:52:49.180",
      "text": "ها؟"
    },
    {
      "id": 65,
      "start": 24769.18,
      "end": 24769.68,
      "formatted_start": "06:52:49.180",
      "formatted_end": "06:52:49.680",
      "text": "نه"
    },
    {
      "id": 66,
      "start": 24770.18,
      "end": 24771.68,
      "formatted_start": "06:52:50.180",
      "formatted_end": "06:52:51.680",
      "text": "دیگه چه چیزایی؟"
    },
    {
      "id": 67,
      "start": 24774.18,
      "end": 24775.18,
      "formatted_start": "06:52:54.180",
      "formatted_end": "06:52:55.180",
      "text": "آه"
    },
    {
      "id": 68,
      "start": 24781.18,
      "end": 24783.18,
      "formatted_start": "06:53:01.180",
      "formatted_end": "06:53:03.180",
      "text": "فردا چاشملا هست؟"
    },
    {
      "id": 69,
      "start": 24783.18,
      "end": 24784.18,
      "formatted_start": "06:53:03.180",
      "formatted_end": "06:53:04.180",
      "text": "نه"
    },
    {
      "id": 70,
      "start": 24784.18,
      "end": 24785.18,
      "formatted_start": "06:53:04.180",
      "formatted_end": "06:53:05.180",
      "text": "آخ جون"
    },
    {
      "id": 71,
      "start": 24786.68,
      "end": 24788.68,
      "formatted_start": "06:53:06.680",
      "formatted_end": "06:53:08.680",
      "text": "تو همه مثل معاشر چاشملایی؟"
    },
    {
      "id": 72,
      "start": 24789.18,
      "end": 24790.68,
      "formatted_start": "06:53:09.180",
      "formatted_end": "06:53:10.680",
      "text": "معلوم بگویم معاشر چاشملا"
    },
    {
      "id": 73,
      "start": 24790.68,
      "end": 24793.18,
      "formatted_start": "06:53:10.680",
      "formatted_end": "06:53:13.180",
      "text": "باید به پسر آقای دکتور بگم"
    },
    {
      "id": 74,
      "start": 24793.18,
      "end": 24795.18,
      "formatted_start": "06:53:13.180",
      "formatted_end": "06:53:15.180",
      "text": "اینجا حرفایی که شنیدی امین باشی"
    },
    {
      "id": 75,
      "start": 24795.68,
      "end": 24796.18,
      "formatted_start": "06:53:15.680",
      "formatted_end": "06:53:16.180",
      "text": "داره باشه"
    },
    {
      "id": 76,
      "start": 24796.18,
      "end": 24798.7,
      "formatted_start": "06:53:16.180",
      "formatted_end": "06:53:18.700",
      "text": "از رازهای مطبع ما رو فهمیدیو کسی چیزی نکنه"
    },
    {
      "id": 77,
      "start": 24798.7,
      "end": 24800.7,
      "formatted_start": "06:53:18.700",
      "formatted_end": "06:53:20.700",
      "text": "به پدرزم نکنه"
    },
    {
      "id": 78,
      "start": 24804.7,
      "end": 24807.22,
      "formatted_start": "06:53:24.700",
      "formatted_end": "06:53:27.220",
      "text": "میان پسر دکتر وقت بگیم اینجا آمدید"
    },
    {
      "id": 79,
      "start": 24807.22,
      "end": 24809.14,
      "formatted_start": "06:53:27.220",
      "formatted_end": "06:53:29.140",
      "text": "اومد گوششو بگید بهش بگی"
    },
    {
      "id": 80,
      "start": 24809.14,
