  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13502.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:02.000",
      "text": "مشکل ندارید که زیبتتون همون رو ندارید."
    },
    {
      "id": 1,
      "start": 13502.0,
      "end": 13503.0,
      "formatted_start": "03:45:02.000",
      "formatted_end": "03:45:03.000",
      "text": "بله، چشم."
    },
    {
      "id": 2,
      "start": 13503.0,
      "end": 13504.0,
      "formatted_start": "03:45:03.000",
      "formatted_end": "03:45:04.000",
      "text": "اون رو بازه دور شدید."
    },
    {
      "id": 3,
      "start": 13504.0,
      "end": 13508.0,
      "formatted_start": "03:45:04.000",
      "formatted_end": "03:45:08.000",
      "text": "بله، اگه ببینیم، احساسا شما تا و سنو همشه غندتون میرد باید برد بازه بازه بزنید."
    },
    {
      "id": 4,
      "start": 13508.0,
      "end": 13511.0,
      "formatted_start": "03:45:08.000",
      "formatted_end": "03:45:11.000",
      "text": "آره، تا و سنو همه دور شدید، کارا کشوردی نیست که از این کارا کشوردی برد برد برد."
    },
    {
      "id": 5,
      "start": 13511.0,
      "end": 13514.24,
      "formatted_start": "03:45:11.000",
      "formatted_end": "03:45:14.240",
      "text": "بعد چون سه ماه هاتون خوبه ها"
    },
    {
      "id": 6,
      "start": 13514.24,
      "end": 13516.24,
      "formatted_start": "03:45:14.240",
      "formatted_end": "03:45:16.240",
      "text": "یعنی سه ماه پایین نمی آمده"
    },
    {
      "id": 7,
      "start": 13516.24,
      "end": 13518.88,
      "formatted_start": "03:45:16.240",
      "formatted_end": "03:45:18.880",
      "text": "افتقانتون تو اون بعد اتفاق افتاده"
    },
    {
      "id": 8,
      "start": 13518.88,
      "end": 13523.5,
      "formatted_start": "03:45:18.880",
      "formatted_end": "03:45:23.500",
      "text": "اگه بازم این سه ماه بعد دوباره ناشته و بعدش اینقدر پایین بود که"
    },
    {
      "id": 9,
      "start": 13523.5,
      "end": 13526.24,
      "formatted_start": "03:45:23.500",
      "formatted_end": "03:45:26.240",
      "text": "یعنی از اون بعد متفارمنو بردارید یه زیبتین میدهد"
    },
    {
      "id": 10,
      "start": 13526.24,
      "end": 13528.24,
      "formatted_start": "03:45:26.240",
      "formatted_end": "03:45:28.240",
      "text": "اون زیبتین تنها"
    },
    {
      "id": 11,
      "start": 13528.24,
      "end": 13530.24,
      "formatted_start": "03:45:28.240",
      "formatted_end": "03:45:30.240",
      "text": "یعنی قرص سیتا گلوتین تک"
    },
    {
      "id": 12,
      "start": 13530.24,
      "end": 13532.24,
      "formatted_start": "03:45:30.240",
      "formatted_end": "03:45:32.240",
      "text": "و همون یه جوری کنتر میشید"
    },
    {
      "id": 13,
      "start": 13532.24,
      "end": 13536.24,
      "formatted_start": "03:45:32.240",
      "formatted_end": "03:45:36.240",
      "text": "آتروباستی نمیدوند هر دوسته رو از یک بار میکنن یا آیس هارو"
    },
    {
      "id": 14,
      "start": 13536.24,
      "end": 13540.54,
      "formatted_start": "03:45:36.240",
      "formatted_end": "03:45:40.540",
      "text": "نه این کار نکنی آس آید قلب بفته بخورید یا کی بخورید"
    },
    {
      "id": 15,
      "start": 13540.54,
      "end": 13541.7,
      "formatted_start": "03:45:40.540",
      "formatted_end": "03:45:41.700",
      "text": "نه شما فهمید"
    },
    {
      "id": 16,
      "start": 13541.7,
      "end": 13543.54,
      "formatted_start": "03:45:41.700",
      "formatted_end": "03:45:43.540",
      "text": "بس خونتون و علیت بوده چیه؟"
    },
    {
      "id": 17,
      "start": 13543.54,
      "end": 13544.1,
      "formatted_start": "03:45:43.540",
      "formatted_end": "03:45:44.100",
      "text": "میتواند کار داریم"
    },
    {
      "id": 18,
      "start": 13544.1,
      "end": 13548.86,
      "formatted_start": "03:45:44.100",
      "formatted_end": "03:45:48.860",
      "text": "یه علت داشته من چون اصلا تا قلب اوکی نده آسکریه شروع نمی کنم"
    },
    {
      "id": 19,
      "start": 13548.86,
      "end": 13551.74,
      "formatted_start": "03:45:48.860",
      "formatted_end": "03:45:51.740",
      "text": "مگره که یه علت خاصی پشتش باشیم"
    },
    {
      "id": 20,
      "start": 13551.74,
      "end": 13552.44,
      "formatted_start": "03:45:51.740",
      "formatted_end": "03:45:52.440",
      "text": "شروع کنید"
    },
    {
      "id": 21,
      "start": 13552.44,
      "end": 13555.76,
      "formatted_start": "03:45:52.440",
      "formatted_end": "03:45:55.760",
      "text": "سرده دیده شان از آسکریه می کنید چون سرده رفت شده"
    },
    {
      "id": 22,
      "start": 13555.76,
      "end": 13559.72,
      "formatted_start": "03:45:55.760",
      "formatted_end": "03:45:59.720",
      "text": "بس یه اسکمی بوده یه چیز علت داشته که نشونیم"
    },
    {
      "id": 23,
      "start": 13559.72,
      "end": 13561.72,
      "formatted_start": "03:45:59.720",
      "formatted_end": "03:46:01.720",
      "text": "اگه علت داشته قد نکنیم"
    },
    {
      "id": 24,
      "start": 13561.72,
      "end": 13564.72,
      "formatted_start": "03:46:01.720",
      "formatted_end": "03:46:04.720",
      "text": "چون شما با دابر سطح خونی داره دیگه تا چند وقت خوبید"
    },
    {
      "id": 25,
      "start": 13564.72,
      "end": 13566.72,
      "formatted_start": "03:46:04.720",
      "formatted_end": "03:46:06.720",
      "text": "بعد دوباره همه برایش می کنیم"
    },
    {
      "id": 26,
      "start": 13566.72,
      "end": 13568.72,
      "formatted_start": "03:46:06.720",
      "formatted_end": "03:46:08.720",
      "text": "حالا تو بساطه این رو موضوع برات کنیم"
    },
    {
      "id": 27,
      "start": 13568.72,
      "end": 13570.72,
      "formatted_start": "03:46:08.720",
      "formatted_end": "03:46:10.720",
      "text": "خب اون رو از شب بفردید؟"
    },
    {
      "id": 28,
      "start": 13570.72,
      "end": 13572.72,
      "formatted_start": "03:46:10.720",
      "formatted_end": "03:46:12.720",
      "text": "مردم از جا چار سیم چند"
    },
    {
      "id": 29,
      "start": 13572.72,
      "end": 13576.72,
      "formatted_start": "03:46:12.720",
      "formatted_end": "03:46:16.720",
      "text": "از همه ها یک کنفرانس از جا روزه ایچی دعوت کرده بودن"
    },
    {
      "id": 30,
      "start": 13576.72,
      "end": 13577.72,
      "formatted_start": "03:46:16.720",
      "formatted_end": "03:46:17.720",
      "text": "گفتن که"
    },
    {
      "id": 31,
      "start": 13577.72,
      "end": 13579.72,
      "formatted_start": "03:46:17.720",
      "formatted_end": "03:46:19.720",
      "text": "حالا احنا شما هم خوبه بودن"
    },
    {
      "id": 32,
      "start": 13579.72,
      "end": 13582.72,
      "formatted_start": "03:46:19.720",
      "formatted_end": "03:46:22.720",
      "text": "ولی گفتن که احنا شما باید کلسترین ها بیانید هنجا"
    },
    {
      "id": 33,
      "start": 13582.72,
      "end": 13587.72,
      "formatted_start": "03:46:22.720",
      "formatted_end": "03:46:27.720",
      "text": "چه یعنی برای این امورد کلیس که دور از این سکتر رو دادن"
    },
    {
      "id": 34,
      "start": 13587.72,
      "end": 13595.72,
      "formatted_start": "03:46:27.720",
      "formatted_end": "03:46:35.720",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 13617.72,
      "end": 13619.72,
      "formatted_start": "03:46:57.720",
      "formatted_end": "03:46:59.720",
      "text": "زهر داری براتون سیره"
    },
    {
      "id": 36,
      "start": 13619.72,
      "end": 13621.72,
      "formatted_start": "03:46:59.720",
      "formatted_end": "03:47:01.720",
      "text": "برای این روان شما زهر بخوریم"
    },
    {
      "id": 37,
      "start": 13631.72,
      "end": 13635.72,
      "formatted_start": "03:47:11.720",
      "formatted_end": "03:47:15.720",
      "text": "یه سو نیاردیه کارستان همین بسیار که"
    },
    {
      "id": 38,
      "start": 13635.72,
      "end": 13637.72,
      "formatted_start": "03:47:15.720",
      "formatted_end": "03:47:17.720",
      "text": "براد امم"
    },
    {
      "id": 39,
      "start": 13637.72,
      "end": 13639.72,
      "formatted_start": "03:47:17.720",
      "formatted_end": "03:47:19.720",
      "text": "یه سو نیاردیه کامل میشه از شکل"
    },
    {
      "id": 40,
      "start": 13639.72,
      "end": 13641.72,
      "formatted_start": "03:47:19.720",
      "formatted_end": "03:47:21.720",
      "text": "براد چون"
    },
    {
      "id": 41,
      "start": 13641.72,
      "end": 13643.72,
      "formatted_start": "03:47:21.720",
      "formatted_end": "03:47:23.720",
      "text": "تعمیلاتونو دارید یه تعمیل"
    },
    {
      "id": 42,
      "start": 13643.72,
      "end": 13645.72,
      "formatted_start": "03:47:23.720",
      "formatted_end": "03:47:25.720",
      "text": "براد نه دارم"
    },
    {
      "id": 43,
      "start": 13645.72,
      "end": 13647.72,
      "formatted_start": "03:47:25.720",
      "formatted_end": "03:47:27.720",
      "text": "جیسینگ با بیتامیگی"
    },
    {
      "id": 44,
      "start": 13647.72,
      "end": 13651.72,
      "formatted_start": "03:47:27.720",
      "formatted_end": "03:47:31.720",
      "text": "نامداران رو نامدارتون داده بودن درسته؟"
    },
    {
      "id": 45,
      "start": 13651.72,
      "end": 13653.72,
      "formatted_start": "03:47:31.720",
      "formatted_end": "03:47:33.720",
      "text": "آمپول دادی؟"
    },
    {
      "id": 46,
      "start": 13653.72,
      "end": 13655.72,
      "formatted_start": "03:47:33.720",
      "formatted_end": "03:47:35.720",
      "text": "آمپول آره آره"
    },
    {
      "id": 47,
      "start": 13655.72,
      "end": 13657.72,
      "formatted_start": "03:47:35.720",
      "formatted_end": "03:47:37.720",
      "text": "این مشکلتون رفت کرده یا نه؟"
    },
    {
      "id": 48,
      "start": 13657.72,
      "end": 13659.72,
      "formatted_start": "03:47:37.720",
      "formatted_end": "03:47:39.720",
      "text": "حالا صحیحه اش نزده آمپوله بود ترس آدم"
    },
    {
      "id": 49,
      "start": 13659.72,
      "end": 13661.72,
      "formatted_start": "03:47:39.720",
      "formatted_end": "03:47:41.720",
      "text": "منم خیلی کچیگه آمپوله"
    },
    {
      "id": 50,
      "start": 13661.72,
      "end": 13663.72,
      "formatted_start": "03:47:41.720",
      "formatted_end": "03:47:43.720",
      "text": "آدمش هستم اینکن"
    },
    {
      "id": 51,
      "start": 13663.72,
      "end": 13665.72,
      "formatted_start": "03:47:43.720",
      "formatted_end": "03:47:45.720",
      "text": "آمپوله تو مایی بردنید"
    },
    {
      "id": 52,
      "start": 13665.72,
      "end": 13667.72,
      "formatted_start": "03:47:45.720",
      "formatted_end": "03:47:47.720",
      "text": "چون از این موضوع مردمی بیرابتی نداره"
    },
    {
      "id": 53,
      "start": 13667.72,
      "end": 13669.72,
      "formatted_start": "03:47:47.720",
      "formatted_end": "03:47:49.720",
      "text": "از اونها تا تونو تقریت میکنه"
    },
    {
      "id": 54,
      "start": 13669.72,
      "end": 13671.72,
      "formatted_start": "03:47:49.720",
      "formatted_end": "03:47:51.720",
      "text": "تو دیابته"
    },
    {
      "id": 55,
      "start": 13671.72,
      "end": 13673.72,
      "formatted_start": "03:47:51.720",
      "formatted_end": "03:47:53.720",
      "text": "تو دیابته"
    },
    {
      "id": 56,
      "start": 13673.72,
      "end": 13682.72,
      "formatted_start": "03:47:53.720",
      "formatted_end": "03:48:02.720",
      "text": "خیلی کار ندارم. جدا از اون به این نقره بهتون میدونم که از اولادتون میخواد دارب تنیم میره دیگه. اون از اولادتون تنیم میده."
    },
    {
      "id": 57,
      "start": 13682.72,
      "end": 13689.72,
      "formatted_start": "03:48:02.720",
      "formatted_end": "03:48:09.720",
      "text": "از این آن پولیه که بازار با چاقه دلش اینه که برزشکار ها اینها همه ایران میزنن که از اولادتشون آموشیس کنن."
    },
    {
      "id": 58,
      "start": 13689.72,
      "end": 13694.72,
      "formatted_start": "03:48:09.720",
      "formatted_end": "03:48:14.720",
      "text": "خانم خدمت را سرار بسیار کنه بخواد خمدکتر را گوه. مهر کار میکنه. لاغر نمیشه."
    },
    {
      "id": 59,
      "start": 13694.72,
      "end": 13697.32,
      "formatted_start": "03:48:14.720",
      "formatted_end": "03:48:17.320",
      "text": "برعکس من دیگه بود"
    },
    {
      "id": 60,
      "start": 13697.32,
      "end": 13699.9,
      "formatted_start": "03:48:17.320",
      "formatted_end": "03:48:19.900",
      "text": "باید بیاد از پارتیم نبذارم"
    },
    {
      "id": 61,
      "start": 13699.9,
      "end": 13710.94,
      "formatted_start": "03:48:19.900",
      "formatted_end": "03:48:30.940",
      "text": "خوشکنتون رو دو هفته باید استفاده کنید"
    },
    {
      "id": 62,
      "start": 13710.94,
      "end": 13712.4,
      "formatted_start": "03:48:30.940",
      "formatted_end": "03:48:32.400",
      "text": "مشکل میده که نداریم"
    },
    {
      "id": 63,
      "start": 13712.4,
      "end": 13714.72,
      "formatted_start": "03:48:32.400",
      "formatted_end": "03:48:34.720",
      "text": "حتما بعد غذا بخوریم"
    },
    {
      "id": 64,
      "start": 13715.78,
      "end": 13717.86,
      "formatted_start": "03:48:35.780",
      "formatted_end": "03:48:37.860",
      "text": "پرستات خیلی دیگه درموی میشه"
    },
    {
      "id": 65,
      "start": 13717.86,
      "end": 13721.2,
      "formatted_start": "03:48:37.860",
      "formatted_end": "03:48:41.200",
      "text": "حتما حتما دارو که من تا آخر بخوریم"
    },
    {
      "id": 66,
      "start": 13721.2,
      "end": 13722.72,
      "formatted_start": "03:48:41.200",
      "formatted_end": "03:48:42.720",
      "text": "چون بی علامت مزمن میشه"
    },
    {
      "id": 67,
      "start": 13722.72,
      "end": 13724.72,
      "formatted_start": "03:48:42.720",
      "formatted_end": "03:48:44.720",
      "text": "اینجا برای از این پروفیل اکساسی هست"
    },
    {
      "id": 68,
      "start": 13724.72,
      "end": 13726.72,
      "formatted_start": "03:48:44.720",
      "formatted_end": "03:48:46.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 69,
      "start": 13726.72,
      "end": 13728.72,
      "formatted_start": "03:48:46.720",
      "formatted_end": "03:48:48.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 70,
      "start": 13728.72,
      "end": 13730.72,
      "formatted_start": "03:48:48.720",
      "formatted_end": "03:48:50.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 71,
      "start": 13730.72,
      "end": 13732.72,
      "formatted_start": "03:48:50.720",
      "formatted_end": "03:48:52.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 72,
      "start": 13732.72,
      "end": 13734.72,
      "formatted_start": "03:48:52.720",
      "formatted_end": "03:48:54.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 73,
      "start": 13734.72,
      "end": 13736.72,
      "formatted_start": "03:48:54.720",
      "formatted_end": "03:48:56.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 74,
      "start": 13736.72,
      "end": 13738.72,
      "formatted_start": "03:48:56.720",
      "formatted_end": "03:48:58.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 75,
      "start": 13738.72,
      "end": 13740.72,
      "formatted_start": "03:48:58.720",
      "formatted_end": "03:49:00.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 76,
      "start": 13740.72,
      "end": 13742.72,
      "formatted_start": "03:49:00.720",
      "formatted_end": "03:49:02.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 77,
      "start": 13742.72,
      "end": 13744.72,
      "formatted_start": "03:49:02.720",
      "formatted_end": "03:49:04.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 78,
      "start": 13744.72,
      "end": 13746.72,
      "formatted_start": "03:49:04.720",
      "formatted_end": "03:49:06.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 79,
      "start": 13746.72,
      "end": 13748.72,
      "formatted_start": "03:49:06.720",
      "formatted_end": "03:49:08.720",
      "text": "این پروفیل اکساسی هست"
    },
    {
      "id": 80,
      "start": 13748.72,
      "end": 13750.72,
      "formatted_start": "03:49:08.720",
      "formatted_end": "03:49:10.720",
      "text": "اول گو دنبال چیز هست؟"
    },
    {
      "id": 81,
      "start": 13750.72,
      "end": 13752.72,
      "formatted_start": "03:49:10.720",
      "formatted_end": "03:49:12.720",
      "text": "آه آه اون باید چیز آره"
    },
    {
      "id": 82,
      "start": 13752.72,
      "end": 13754.72,
      "formatted_start": "03:49:12.720",
      "formatted_end": "03:49:14.720",
      "text": "من کسی جاوب شدم"
    },
    {
      "id": 83,
      "start": 13754.72,
      "end": 13756.72,
      "formatted_start": "03:49:14.720",
      "formatted_end": "03:49:16.720",
      "text": "اول اکسشو گرفتم"
    },
    {
      "id": 84,
      "start": 13756.72,
      "end": 13758.72,
      "formatted_start": "03:49:16.720",
      "formatted_end": "03:49:18.720",
      "text": "اکسشو هم درست"
    },
    {
      "id": 85,
      "start": 13758.72,
      "end": 13760.72,
      "formatted_start": "03:49:18.720",
      "formatted_end": "03:49:20.720",
      "text": "آه اکس رو هم میگن درست"
    },
    {
      "id": 86,
      "start": 13766.72,
      "end": 13768.72,
      "formatted_start": "03:49:26.720",
      "formatted_end": "03:49:28.720",
      "text": "چند حرف نادباه کنیم"
    },
    {
      "id": 87,
      "start": 13768.72,
      "end": 13770.72,
      "formatted_start": "03:49:28.720",
      "formatted_end": "03:49:30.720",
      "text": "شیر در سمت رو باز کرده"
    },
    {
      "id": 88,
      "start": 13774.72,
      "end": 13776.72,
      "formatted_start": "03:49:34.720",
      "formatted_end": "03:49:36.720",
      "text": "بسیار تکرار گذار شد"
    },
    {
      "id": 89,
      "start": 13776.72,
      "end": 13778.72,
      "formatted_start": "03:49:36.720",
      "formatted_end": "03:49:38.720",
      "text": "چیز نکفته چیز دیده نشون"
    },
    {
      "id": 90,
      "start": 13780.36,
      "end": 13782.36,
      "formatted_start": "03:49:40.360",
      "formatted_end": "03:49:42.360",
      "text": "تب نمیشه ما سلوک نشون"
    },
    {
      "id": 91,
      "start": 13782.36,
      "end": 13784.36,
      "formatted_start": "03:49:42.360",
      "formatted_end": "03:49:44.360",
      "text": "بچه برنامه داستو زده کنه"
    },
    {
      "id": 92,
      "start": 13784.36,
      "end": 13786.36,
      "formatted_start": "03:49:44.360",
      "formatted_end": "03:49:46.360",
      "text": "تب نشون"
    },
    {
      "id": 93,
      "start": 13786.36,
      "end": 13788.36,
      "formatted_start": "03:49:46.360",
      "formatted_end": "03:49:48.360",
      "text": "شکرم باید ازش"
    },
    {
      "id": 94,
      "start": 13792.36,
      "end": 13794.36,
      "formatted_start": "03:49:52.360",
      "formatted_end": "03:49:54.360",
      "text": "گوالچین جان"
    },
    {
      "id": 95,
      "start": 13794.36,
      "end": 13796.36,
      "formatted_start": "03:49:54.360",
      "formatted_end": "03:49:56.360",
      "text": "کده میرین؟"
    },
    {
      "id": 96,
      "start": 13796.36,
      "end": 13798.36,
      "formatted_start": "03:49:56.360",
      "formatted_end": "03:49:58.360",
      "text": "پانگوالچین؟"
    }
  ],
  "status": "completed"
}