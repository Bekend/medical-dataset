    },
    {
      "id": 4,
      "start": 14436.0,
      "end": 14438.0,
      "formatted_start": "04:00:36.000",
      "formatted_end": "04:00:38.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 5,
      "start": 14438.0,
      "end": 14440.0,
      "formatted_start": "04:00:38.000",
      "formatted_end": "04:00:40.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 6,
      "start": 14440.0,
      "end": 14442.0,
      "formatted_start": "04:00:40.000",
      "formatted_end": "04:00:42.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 7,
      "start": 14442.0,
      "end": 14444.0,
      "formatted_start": "04:00:42.000",
      "formatted_end": "04:00:44.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 8,
      "start": 14444.0,
      "end": 14446.0,
      "formatted_start": "04:00:44.000",
      "formatted_end": "04:00:46.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 9,
      "start": 14446.0,
      "end": 14448.0,
      "formatted_start": "04:00:46.000",
      "formatted_end": "04:00:48.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 10,
      "start": 14448.0,
      "end": 14450.0,
      "formatted_start": "04:00:48.000",
      "formatted_end": "04:00:50.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 11,
      "start": 14450.0,
      "end": 14452.0,
      "formatted_start": "04:00:50.000",
      "formatted_end": "04:00:52.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 12,
      "start": 14452.0,
      "end": 14454.0,
      "formatted_start": "04:00:52.000",
      "formatted_end": "04:00:54.000",
      "text": "خانم مرا"
    },
    {
      "id": 13,
      "start": 14454.0,
      "end": 14457.0,
      "formatted_start": "04:00:54.000",
      "formatted_end": "04:00:57.000",
      "text": "خب، عند ناشته هایش هنوز بالا هست"
    },
    {
      "id": 14,
      "start": 14457.0,
      "end": 14460.0,
      "formatted_start": "04:00:57.000",
      "formatted_end": "04:01:00.000",
      "text": "که راتینش خوبه"
    },
    {
      "id": 15,
      "start": 14460.0,
      "end": 14464.0,
      "formatted_start": "04:01:00.000",
      "formatted_end": "04:01:04.000",
      "text": "این همیشه گرس و غن دونار رو مرتبه میخوره"
    },
    {
      "id": 16,
      "start": 14464.0,
      "end": 14467.0,
      "formatted_start": "04:01:04.000",
      "formatted_end": "04:01:07.000",
      "text": "از اختیار خودم بر برداریم خودمیت باید"
    },
    {
      "id": 17,
      "start": 14467.0,
      "end": 14472.0,
      "formatted_start": "04:01:07.000",
      "formatted_end": "04:01:12.000",
      "text": "بعد این خانمتو به روشنی مزید یه داره"
    },
    {
      "id": 18,
      "start": 14472.0,
      "end": 14475.0,
      "formatted_start": "04:01:12.000",
      "formatted_end": "04:01:15.000",
      "text": "من شما اونجا خوهرم و این برگرنه"
    },
    {
      "id": 19,
      "start": 14475.0,
      "end": 14479.0,
      "formatted_start": "04:01:15.000",
      "formatted_end": "04:01:19.000",
      "text": "یک سال اصلا با خواهیم رو باهم نکنیم"
    },
    {
      "id": 20,
      "start": 14479.0,
      "end": 14481.68,
      "formatted_start": "04:01:19.000",
      "formatted_end": "04:01:21.680",
      "text": "غیر از این مسئله، در حالتی حساب داریم."
    },
    {
      "id": 21,
      "start": 14481.68,
      "end": 14484.52,
      "formatted_start": "04:01:21.680",
      "formatted_end": "04:01:24.520",
      "text": "دکتر حساب رو میبریم، غرص حساب اصلا نمیخونیم."
    },
    {
      "id": 22,
      "start": 14484.52,
      "end": 14487.56,
      "formatted_start": "04:01:24.520",
      "formatted_end": "04:01:27.560",
      "text": "مثلا به غرص حساب، اصاسیت داشته میده."
    },
    {
      "id": 23,
      "start": 14487.56,
      "end": 14488.72,
      "formatted_start": "04:01:27.560",
      "formatted_end": "04:01:28.720",
      "text": "نمیدونیم چیکارش کنیم."
    },
    {
      "id": 24,
      "start": 14488.72,
      "end": 14491.92,
      "formatted_start": "04:01:28.720",
      "formatted_end": "04:01:31.920",
      "text": "بعضی اوقات پرت و پلا میگه بچه هاش ناراض میشن،"
    },
    {
      "id": 25,
      "start": 14491.92,
      "end": 14494.84,
      "formatted_start": "04:01:31.920",
      "formatted_end": "04:01:34.840",
      "text": "عرفایت میزنه، که اون زما داره."
    },
    {
      "id": 26,
      "start": 14494.84,
      "end": 14499.76,
      "formatted_start": "04:01:34.840",
      "formatted_end": "04:01:39.760",
      "text": "تصخیصش هم نیست، انگار خواب میبینه که مثلا عرفای بسنه."
    },
    {
      "id": 27,
      "start": 14499.76,
      "end": 14500.56,
      "formatted_start": "04:01:39.760",
      "formatted_end": "04:01:40.560",
      "text": "همیشه نیست داره."
    },
    {
      "id": 28,
      "start": 14500.56,
      "end": 14505.56,
      "formatted_start": "04:01:40.560",
      "formatted_end": "04:01:45.560",
      "text": "مثلا اگر تلویز روشنگه یا یکی صحبتی میکنه، هیچی از اون برای خودش جدا میگه."
    },
    {
      "id": 29,
      "start": 14505.56,
      "end": 14506.56,
      "formatted_start": "04:01:45.560",
      "formatted_end": "04:01:46.560",
      "text": "آها."
    },
    {
      "id": 30,
      "start": 14506.56,
      "end": 14507.56,
      "formatted_start": "04:01:46.560",
      "formatted_end": "04:01:47.560",
      "text": "میشه."
    },
    {
      "id": 31,
      "start": 14507.56,
      "end": 14511.56,
      "formatted_start": "04:01:47.560",
      "formatted_end": "04:01:51.560",
      "text": "خب بعد، غرص غندشون الان چجوری میخورن؟"
    },
    {
      "id": 32,
      "start": 14511.56,
      "end": 14514.56,
      "formatted_start": "04:01:51.560",
      "formatted_end": "04:01:54.560",
      "text": "روی دو تا هر روز میکرده، مارتا هم میکرده."
    },
    {
      "id": 33,
      "start": 14514.56,
      "end": 14518.56,
      "formatted_start": "04:01:54.560",
      "formatted_end": "04:01:58.560",
      "text": "یعنی نصف غرص غند، شکلت، شما بگین یکی بخورد، اون دو تا میکرده."
    },
    {
      "id": 34,
      "start": 14518.56,
      "end": 14521.56,
      "formatted_start": "04:01:58.560",
      "formatted_end": "04:02:01.560",
      "text": "اگر بگین دو تا بخورد، ستا چهار تا میکرده."
    },
    {
      "id": 35,
      "start": 14521.56,
      "end": 14522.56,
      "formatted_start": "04:02:01.560",
      "formatted_end": "04:02:02.560",
      "text": "در این حال."
    },
    {
      "id": 36,
      "start": 14522.56,
      "end": 14524.56,
      "formatted_start": "04:02:02.560",
      "formatted_end": "04:02:04.560",
      "text": "در غرص های دیگه رو."
    },
    {
      "id": 37,
      "start": 14524.56,
      "end": 14529.86,
      "formatted_start": "04:02:04.560",
      "formatted_end": "04:02:09.860",
      "text": "از این حال از غرس هساب و چیز من حتی بشه دکتر رو بردمش."
    },
    {
      "id": 38,
      "start": 14529.86,
      "end": 14532.46,
      "formatted_start": "04:02:09.860",
      "formatted_end": "04:02:12.460",
      "text": "این دکتر ببین از نظر من باید بسیاری بشه."
    },
    {
      "id": 39,
      "start": 14532.46,
      "end": 14533.46,
      "formatted_start": "04:02:12.460",
      "formatted_end": "04:02:13.460",
      "text": "در این حال."
    },
    {
      "id": 40,
      "start": 14533.46,
      "end": 14538.36,
      "formatted_start": "04:02:13.460",
      "formatted_end": "04:02:18.360",
      "text": "ولی گفتیم غرس بهش داده بردم یکی درسته به زود دادیمش خورد."
    },
    {
      "id": 41,
      "start": 14538.36,
      "end": 14539.36,
      "formatted_start": "04:02:18.360",
      "formatted_end": "04:02:19.360",
      "text": "دیگه نکرد."
    },
    {
      "id": 42,
      "start": 14539.36,
      "end": 14541.36,
      "formatted_start": "04:02:19.360",
      "formatted_end": "04:02:21.360",
      "text": "اصلا من غرس ها چیکار کردم."
    },
    {
      "id": 43,
      "start": 14541.36,
      "end": 14542.36,
      "formatted_start": "04:02:21.360",
      "formatted_end": "04:02:22.360",
      "text": "در این حال."
    },
    {
      "id": 44,
      "start": 14542.36,
      "end": 14544.36,
      "formatted_start": "04:02:22.360",
      "formatted_end": "04:02:24.360",
      "text": "حالا ما هم دارو بدیم که نمیخوریم."
    },
    {
      "id": 45,
      "start": 14544.36,
      "end": 14547.36,
      "formatted_start": "04:02:24.360",
      "formatted_end": "04:02:27.360",
      "text": "شما اگه غرسش مثلا اصلا غرس میشنست."
    },
    {
      "id": 46,
      "start": 14547.36,
      "end": 14549.36,
      "formatted_start": "04:02:27.360",
      "formatted_end": "04:02:29.360",
      "text": "ریز باشه میمال هساب نیرو برن."
    },
    {
      "id": 47,
      "start": 14549.36,
      "end": 14555.36,
      "formatted_start": "04:02:29.360",
      "formatted_end": "04:02:35.360",
      "text": "برای برسی باشی که بخور دارو درسته شبیه بخور سادگی باشه میخوره"
    },
    {
      "id": 48,
      "start": 14555.36,
      "end": 14558.36,
      "formatted_start": "04:02:35.360",
      "formatted_end": "04:02:38.360",
      "text": "نشناسه به سلام"
    },
    {
      "id": 49,
      "start": 14558.36,
      "end": 14563.36,
      "formatted_start": "04:02:38.360",
      "formatted_end": "04:02:43.360",
      "text": "یعنی که باید تو نیاد مثلا چونو باش توبت کنیم"
    },
    {
      "id": 50,
      "start": 14563.36,
      "end": 14566.36,
      "formatted_start": "04:02:43.360",
      "formatted_end": "04:02:46.360",
      "text": "نردتی تو ملیزی تو بخواد رسال بکنی"
    },
    {
      "id": 51,
      "start": 14566.36,
      "end": 14568.36,
      "formatted_start": "04:02:46.360",
      "formatted_end": "04:02:48.360",
      "text": "چون یه بار دیگرم گفتیدیم که یه برسی بخوره"
    },
    {
      "id": 52,
      "start": 14568.36,
      "end": 14571.36,
      "formatted_start": "04:02:48.360",
      "formatted_end": "04:02:51.360",
      "text": "آره ای حسن من این سریعی کافت نوشتم"
    },
    {
      "id": 53,
      "start": 14571.36,
      "end": 14574.36,
      "formatted_start": "04:02:51.360",
      "formatted_end": "04:02:54.360",
      "text": "حالا که بدونه که مثلا من نرسال گفتم نرد میشم"
    },
    {
      "id": 54,
      "start": 14574.36,
      "end": 14578.36,
      "formatted_start": "04:02:54.360",
      "formatted_end": "04:02:58.360",
      "text": "نه من باش توبت کردم ولی اصلا گوش نمیده"
    },
    {
      "id": 55,
      "start": 14578.36,
      "end": 14584.0,
      "formatted_start": "04:02:58.360",
      "formatted_end": "04:03:04.000",
      "text": "بچه ها همونطوری هم بچه ها شتبهت میکنند. حتی اون بسرم آده بود."
    },
    {
      "id": 56,
      "start": 14584.0,
      "end": 14586.0,
      "formatted_start": "04:03:04.000",
      "formatted_end": "04:03:06.000",
      "text": "پروش ناراض بود."
    },
    {
      "id": 57,
      "start": 14586.0,
      "end": 14587.0,
      "formatted_start": "04:03:06.000",
      "formatted_end": "04:03:07.000",
      "text": "یکی..."
    },
    {
      "id": 58,
      "start": 14587.0,
      "end": 14589.0,
      "formatted_start": "04:03:07.000",
      "formatted_end": "04:03:09.000",
      "text": "من هر دیگه گری افته بچه."
    },
    {
      "id": 59,
      "start": 14589.0,
      "end": 14591.0,
      "formatted_start": "04:03:09.000",
      "formatted_end": "04:03:11.000",
      "text": "من کم می نمیسم."
    },
    {
      "id": 60,
      "start": 14591.0,
      "end": 14594.0,
      "formatted_start": "04:03:11.000",
      "formatted_end": "04:03:14.000",
      "text": "اگه دیدی خورد یا براش بیشتر بکنیم."
    },
    {
      "id": 61,
      "start": 14594.0,
      "end": 14596.0,
      "formatted_start": "04:03:14.000",
      "formatted_end": "04:03:16.000",
      "text": "باش داریم."
    },
    {
      "id": 62,
      "start": 14596.0,
      "end": 14626.0,
      "formatted_start": "04:03:16.000",
      "formatted_end": "04:03:46.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 63,
      "start": 14626.0,
      "end": 14630.0,
      "formatted_start": "04:03:46.000",
      "formatted_end": "04:03:50.000",
      "text": "اینجور تو روزه غندت بالاه یه سی دارو اضافه کردن"
    },
    {
      "id": 64,
      "start": 14630.0,
      "end": 14634.0,
      "formatted_start": "04:03:50.000",
      "formatted_end": "04:03:54.000",
      "text": "آها، اونطوری بگیرم برای یه ترسی میکنم"
    },
    {
      "id": 65,
      "start": 14634.0,
      "end": 14636.0,
      "formatted_start": "04:03:54.000",
      "formatted_end": "04:03:56.000",
      "text": "یه مرسو دیگرم میکنم"
    },
    {
      "id": 66,
      "start": 14636.0,
      "end": 14640.0,
      "formatted_start": "04:03:56.000",
      "formatted_end": "04:04:00.000",
      "text": "یه مرسو هم اضافه کردم، یه نصف زور بخور یه نصف شب"
    },
    {
      "id": 67,
      "start": 14640.0,
      "end": 14642.0,
      "formatted_start": "04:04:00.000",
      "formatted_end": "04:04:02.000",
      "text": "بیار این خامی شفاره بیاریم بگیر چون مرسیه"
    },
    {
      "id": 68,
      "start": 14642.0,
      "end": 14644.0,
      "formatted_start": "04:04:02.000",
      "formatted_end": "04:04:04.000",
      "text": "باش دارم"
    },
    {
      "id": 69,
      "start": 14656.0,
      "end": 14658.0,
      "formatted_start": "04:04:16.000",
      "formatted_end": "04:04:18.000",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 70,
      "start": 14658.0,
      "end": 14660.0,
      "formatted_start": "04:04:18.000",
      "formatted_end": "04:04:20.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 71,
      "start": 14660.0,
      "end": 14662.0,
      "formatted_start": "04:04:20.000",
      "formatted_end": "04:04:22.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 72,
      "start": 14662.0,
      "end": 14664.0,
      "formatted_start": "04:04:22.000",
      "formatted_end": "04:04:24.000",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 73,
      "start": 14664.0,
      "end": 14666.0,
      "formatted_start": "04:04:24.000",
