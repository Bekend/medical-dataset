      "start": 15940.0,
      "end": 15943.0,
      "formatted_start": "04:25:40.000",
      "formatted_end": "04:25:43.000",
      "text": "فعلا تا خالی بشه شربت بشه"
    },
    {
      "id": 19,
      "start": 15943.0,
      "end": 15945.0,
      "formatted_start": "04:25:43.000",
      "formatted_end": "04:25:45.000",
      "text": "شربت پیچ میدازه"
    },
    {
      "id": 20,
      "start": 15945.0,
      "end": 15947.0,
      "formatted_start": "04:25:45.000",
      "formatted_end": "04:25:47.000",
      "text": "خب دوست نداریم خیلی بچه حالش بد میشه"
    },
    {
      "id": 21,
      "start": 15947.0,
      "end": 15951.0,
      "formatted_start": "04:25:47.000",
      "formatted_end": "04:25:51.000",
      "text": "اگه پود رو دادی کار نکرد شربت بخوری خب"
    },
    {
      "id": 22,
      "start": 15951.0,
      "end": 15954.5,
      "formatted_start": "04:25:51.000",
      "formatted_end": "04:25:54.500",
      "text": "هر وقت که دیدی امروز کار نکرد یه فرد و شروط بخورید"
    },
    {
      "id": 23,
      "start": 15954.5,
      "end": 15960.5,
      "formatted_start": "04:25:54.500",
      "formatted_end": "04:26:00.500",
      "text": "این بگی ولش کن، حالا من که همیشه سرز بودم اصلاً اینجوری ولش کن نکنید بندازید"
    },
    {
      "id": 24,
      "start": 15960.5,
      "end": 15962.5,
      "formatted_start": "04:26:00.500",
      "formatted_end": "04:26:02.500",
      "text": "خطرناکه"
    },
    {
      "id": 25,
      "start": 15966.5,
      "end": 15969.0,
      "formatted_start": "04:26:06.500",
      "formatted_end": "04:26:09.000",
      "text": "اون قرصاش هم میتونه با اون پودره بخوره دیگه"
    },
    {
      "id": 26,
      "start": 15969.0,
      "end": 15972.0,
      "formatted_start": "04:26:09.000",
      "formatted_end": "04:26:12.000",
      "text": "آره، اون اصلاً غیر قابل جزبیه"
    },
    {
      "id": 27,
      "start": 15974.5,
      "end": 15977.0,
      "formatted_start": "04:26:14.500",
      "formatted_end": "04:26:17.000",
      "text": "کمکونی شدید"
    },
    {
      "id": 28,
      "start": 15977.0,
      "end": 15983.0,
      "formatted_start": "04:26:17.000",
      "formatted_end": "04:26:23.000",
      "text": "بگو بگو چه برای خریدی اون دوزانه هرش بکنه با خوشگلیش"
    },
    {
      "id": 29,
      "start": 15983.0,
      "end": 15985.0,
      "formatted_start": "04:26:23.000",
      "formatted_end": "04:26:25.000",
      "text": "این رو تو برام خودم گفتیم گرفتم"
    },
    {
      "id": 30,
      "start": 15985.0,
      "end": 15989.0,
      "formatted_start": "04:26:25.000",
      "formatted_end": "04:26:29.000",
      "text": "من فروپورت و دودنال میلیمستم این رو نمیلیمستم"
    },
    {
      "id": 31,
      "start": 15989.0,
      "end": 15991.0,
      "formatted_start": "04:26:29.000",
      "formatted_end": "04:26:31.000",
      "text": "نه این رو من آزاد گرفتم"
    },
    {
      "id": 32,
      "start": 15991.0,
      "end": 15996.0,
      "formatted_start": "04:26:31.000",
      "formatted_end": "04:26:36.000",
      "text": "بگو این ها خارجی ها یا شرکت خوشگلی"
    },
    {
      "id": 33,
      "start": 15996.0,
      "end": 15998.0,
      "formatted_start": "04:26:36.000",
      "formatted_end": "04:26:38.000",
      "text": "اونو بیمار میلیمستیم"
    },
    {
      "id": 34,
      "start": 15998.0,
      "end": 16001.0,
      "formatted_start": "04:26:38.000",
      "formatted_end": "04:26:41.000",
      "text": "چه داریم؟ دادو خدا دیگه این کار رو می کنه"
    },
    {
      "id": 35,
      "start": 16001.0,
      "end": 16003.0,
      "formatted_start": "04:26:41.000",
      "formatted_end": "04:26:43.000",
      "text": "بگو بسیار برام شو"
    },
    {
      "id": 36,
      "start": 16003.0,
      "end": 16006.5,
      "formatted_start": "04:26:43.000",
      "formatted_end": "04:26:46.500",
      "text": "اول بذار شکمش خوب راه میفته خب"
    },
    {
      "id": 37,
      "start": 16006.5,
      "end": 16010.0,
      "formatted_start": "04:26:46.500",
      "formatted_end": "04:26:50.000",
      "text": "بعد آزمایشش دادی کمخونی شدید بوده"
    },
    {
      "id": 38,
      "start": 16010.0,
      "end": 16013.0,
      "formatted_start": "04:26:50.000",
      "formatted_end": "04:26:53.000",
      "text": "آره منم به مادرم رفتم که آزمایشش"
    },
    {
      "id": 39,
      "start": 16013.0,
      "end": 16016.0,
      "formatted_start": "04:26:53.000",
      "formatted_end": "04:26:56.000",
      "text": "خب چون اگه کمخونیش خیلی شدید بود آن فول خون میزدی بهش"
    },
    {
      "id": 40,
      "start": 16016.0,
      "end": 16019.0,
      "formatted_start": "04:26:56.000",
      "formatted_end": "04:26:59.000",
      "text": "نه دادم نه رفتم به"
    },
    {
      "id": 41,
      "start": 16019.0,
      "end": 16022.0,
      "formatted_start": "04:26:59.000",
      "formatted_end": "04:27:02.000",
      "text": "یه سی وی سی ساده میدونی زن تا که مادرتون بشه"
    },
    {
      "id": 42,
      "start": 16022.0,
      "end": 16023.0,
      "formatted_start": "04:27:02.000",
      "formatted_end": "04:27:03.000",
      "text": "خستشی"
    },
    {
      "id": 43,
      "start": 16023.0,
      "end": 16025.0,
      "formatted_start": "04:27:03.000",
      "formatted_end": "04:27:05.000",
      "text": "این آزمایش رو بده خب"
    },
    {
      "id": 44,
      "start": 16025.0,
      "end": 16026.0,
      "formatted_start": "04:27:05.000",
      "formatted_end": "04:27:06.000",
      "text": "باش"
    },
    {
      "id": 45,
      "start": 16026.0,
      "end": 16036.0,
      "formatted_start": "04:27:06.000",
      "formatted_end": "04:27:16.000",
      "text": "اینجور جز کسی که بهشون آهن تصویقی باید بزنه اینو مثل مادر شماست چون از این روداش جزم نمی کنه چون جرایه شده"
    },
    {
      "id": 46,
      "start": 16036.0,
      "end": 16038.0,
      "formatted_start": "04:27:16.000",
      "formatted_end": "04:27:18.000",
      "text": "آزمانش براش برسید همجا؟"
    },
    {
      "id": 47,
      "start": 16038.0,
      "end": 16040.0,
      "formatted_start": "04:27:18.000",
      "formatted_end": "04:27:20.000",
      "text": "آره ببینم"
    },
    {
      "id": 48,
      "start": 16040.0,
      "end": 16042.0,
      "formatted_start": "04:27:20.000",
      "formatted_end": "04:27:22.000",
      "text": "پول آزمانش از کجا شده؟"
    },
    {
      "id": 49,
      "start": 16042.0,
      "end": 16046.0,
      "formatted_start": "04:27:22.000",
      "formatted_end": "04:27:26.000",
      "text": "اونقدر نیست، خیلی نیست آزمانش"
    },
    {
      "id": 50,
      "start": 16046.0,
      "end": 16048.0,
      "formatted_start": "04:27:26.000",
      "formatted_end": "04:27:28.000",
      "text": "چرا؟"
    },
    {
      "id": 51,
      "start": 16048.0,
      "end": 16055.0,
      "formatted_start": "04:27:28.000",
      "formatted_end": "04:27:35.000",
      "text": "چهار دار بیشتر نخواست، من فقط چیزی واجب میخوام ببینم که اگه کم خون باشه اداره بیمه بفرستیم آهن دولتی بگیرم"
    },
    {
      "id": 52,
      "start": 16055.0,
      "end": 16058.68,
      "formatted_start": "04:27:35.000",
      "formatted_end": "04:27:38.680",
      "text": "اونجوری 300-400 تومنه هفت میلیونه میشه 300 تومنه"
    },
    {
      "id": 53,
      "start": 16058.68,
      "end": 16060.68,
      "formatted_start": "04:27:38.680",
      "formatted_end": "04:27:40.680",
      "text": "آمپولشو میزنیم"
    },
    {
      "id": 54,
      "start": 16063.98,
      "end": 16066.82,
      "formatted_start": "04:27:43.980",
      "formatted_end": "04:27:46.820",
      "text": "آمپولش مثلا خودتونم میتونیم بزنیم یا نبودیم؟"
    },
    {
      "id": 55,
      "start": 16066.82,
      "end": 16067.82,
      "formatted_start": "04:27:46.820",
      "formatted_end": "04:27:47.820",
      "text": "آره"
    },
    {
      "id": 56,
      "start": 16067.82,
      "end": 16069.82,
      "formatted_start": "04:27:47.820",
      "formatted_end": "04:27:49.820",
      "text": "آنجور بیاد میزنیم"
    },
    {
      "id": 57,
      "start": 16071.4,
      "end": 16073.22,
      "formatted_start": "04:27:51.400",
      "formatted_end": "04:27:53.220",
      "text": "الان برای شامپولم نوشته"
    },
    {
      "id": 58,
      "start": 16073.22,
      "end": 16075.82,
      "formatted_start": "04:27:53.220",
      "formatted_end": "04:27:55.820",
      "text": "آمپول باید آزمایش باشه برای هم میگم"
    },
    {
      "id": 59,
      "start": 16075.82,
      "end": 16080.06,
      "formatted_start": "04:27:55.820",
      "formatted_end": "04:28:00.060",
      "text": "اگه آزمایش باشه مثلا مکرد از آن شامبه آزمایش 600 تومنه بدید"
    },
    {
      "id": 60,
      "start": 16080.06,
      "end": 16082.32,
      "formatted_start": "04:28:00.060",
      "formatted_end": "04:28:02.320",
      "text": "اون آمپولا هفت میلیونه"
    },
    {
      "id": 61,
      "start": 16082.32,
      "end": 16084.66,
      "formatted_start": "04:28:02.320",
      "formatted_end": "04:28:04.660",
      "text": "بیمه که تقییم می کنه میشه 400 تومنه"
    },
    {
      "id": 62,
      "start": 16084.66,
      "end": 16086.66,
      "formatted_start": "04:28:04.660",
      "formatted_end": "04:28:06.660",
      "text": "و 6 میمونت افرادش هست"
    },
    {
      "id": 63,
      "start": 16086.66,
      "end": 16087.66,
      "formatted_start": "04:28:06.660",
      "formatted_end": "04:28:07.660",
      "text": "میارزه"
    },
    {
      "id": 64,
      "start": 16087.66,
      "end": 16089.66,
      "formatted_start": "04:28:07.660",
      "formatted_end": "04:28:09.660",
      "text": "بعد مادر شما در واقع جزو گروه یکی"
    },
    {
      "id": 65,
      "start": 16089.66,
      "end": 16091.66,
      "formatted_start": "04:28:09.660",
      "formatted_end": "04:28:11.660",
      "text": "آمپولای تحضیب بر همین مریض ها ساختن"
    },
    {
      "id": 66,
      "start": 16091.66,
      "end": 16093.66,
      "formatted_start": "04:28:11.660",
      "formatted_end": "04:28:13.660",
      "text": "نه برای آدم های آخری"
    },
    {
      "id": 67,
      "start": 16093.66,
      "end": 16096.66,
      "formatted_start": "04:28:13.660",
      "formatted_end": "04:28:16.660",
      "text": "برای بیناره که جراحی شده همه نمیتونن برس بخورن"
    },
    {
      "id": 68,
      "start": 16096.66,
      "end": 16098.66,
      "formatted_start": "04:28:16.660",
      "formatted_end": "04:28:18.660",
      "text": "چون آهم خود سفت میکنه"
    },
    {
      "id": 69,
      "start": 16098.66,
      "end": 16100.66,
      "formatted_start": "04:28:18.660",
      "formatted_end": "04:28:20.660",
      "text": "بعد این روداش باد داره"
    },
    {
      "id": 70,
      "start": 16100.66,
      "end": 16102.66,
      "formatted_start": "04:28:20.660",
      "formatted_end": "04:28:22.660",
      "text": "بازون باد ها هیلویشتر میکنه"
    },
    {
      "id": 71,
      "start": 16102.66,
      "end": 16104.66,
      "formatted_start": "04:28:22.660",
      "formatted_end": "04:28:24.660",
      "text": "و عذیب میشه مریض دیگه"
    },
    {
      "id": 72,
      "start": 16106.66,
      "end": 16108.66,
      "formatted_start": "04:28:26.660",
      "formatted_end": "04:28:28.660",
      "text": "تا حالا مثلا این رو به دکتورم بردیم"
    },
    {
      "id": 73,
      "start": 16108.66,
      "end": 16138.66,
      "formatted_start": "04:28:28.660",
      "formatted_end": "04:28:58.660",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 74,
      "start": 16138.66,
      "end": 16140.66,
      "formatted_start": "04:28:58.660",
      "formatted_end": "04:29:00.660",
      "text": "برای دو تا مراجمه برای خودم هرکس بگیریم"
    },
    {
      "id": 75,
      "start": 16151.66,
      "end": 16153.66,
      "formatted_start": "04:29:11.660",
      "formatted_end": "04:29:13.660",
      "text": "این امپولی هست مادرم اون اساسیت داره"
    },
    {
      "id": 76,
      "start": 16153.66,
      "end": 16155.66,
      "formatted_start": "04:29:13.660",
      "formatted_end": "04:29:15.660",
      "text": "نه امپولی ها چیه اتید؟"
    },
    {
      "id": 77,
      "start": 16155.66,
      "end": 16157.66,
      "formatted_start": "04:29:15.660",
      "formatted_end": "04:29:17.660",
      "text": "چه امپولی اساسیت داری؟"
    },
    {
      "id": 78,
      "start": 16157.66,
      "end": 16159.66,
      "formatted_start": "04:29:17.660",
      "formatted_end": "04:29:19.660",
      "text": "باشه به داداشتو زنی بگیری"
    },
    {
      "id": 79,
      "start": 16159.66,
      "end": 16161.66,
      "formatted_start": "04:29:19.660",
      "formatted_end": "04:29:21.660",
      "text": "چون یه وارونه زده بود"
    },
    {
      "id": 80,
      "start": 16161.66,
      "end": 16163.66,
      "formatted_start": "04:29:21.660",
      "formatted_end": "04:29:23.660",
      "text": "کلان حالش خراب شده بود"
    },
    {
      "id": 81,
      "start": 16163.66,
      "end": 16165.66,
      "formatted_start": "04:29:23.660",
      "formatted_end": "04:29:25.660",
      "text": "درست دو کما؟"
    },
    {
      "id": 82,
      "start": 16165.66,
      "end": 16167.66,
      "formatted_start": "04:29:25.660",
      "formatted_end": "04:29:27.660",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 83,
      "start": 16167.66,
      "end": 16169.66,
      "formatted_start": "04:29:27.660",
      "formatted_end": "04:29:29.660",
      "text": "چی بود؟ مصاکم بود؟ چی بود؟"
    },
    {
      "id": 84,
      "start": 16169.66,
      "end": 16171.66,
      "formatted_start": "04:29:29.660",
      "formatted_end": "04:29:31.660",
      "text": "سیپروفنک"
    },
    {
      "id": 85,
      "start": 16171.66,
      "end": 16173.66,
      "formatted_start": "04:29:31.660",
      "formatted_end": "04:29:33.660",
      "text": "نه اصلا بودم نمی بود"
    },
    {
      "id": 86,
      "start": 16173.66,
      "end": 16175.66,
      "formatted_start": "04:29:33.660",
      "formatted_end": "04:29:35.660",
      "text": "میکروفنک؟"
    },
    {
      "id": 87,
      "start": 16175.66,
      "end": 16177.66,
      "formatted_start": "04:29:35.660",
      "formatted_end": "04:29:37.660",
      "text": "پیروکسیکا؟"
    },
    {
      "id": 88,
      "start": 16177.66,
      "end": 16179.66,
      "formatted_start": "04:29:37.660",
      "formatted_end": "04:29:39.660",
      "text": "نه ببینم، منم به منم گفته یادم"
    },
    {
      "id": 89,
      "start": 16179.66,
      "end": 16181.66,
      "formatted_start": "04:29:39.660",
      "formatted_end": "04:29:41.660",
      "text": "سیپروفنک سازی؟"
    },
    {
      "id": 90,
      "start": 16181.66,
      "end": 16183.66,
      "formatted_start": "04:29:41.660",
      "formatted_end": "04:29:43.660",
      "text": "دکتر گوهر وقت که ردگی دکتر"
    },
    {
      "id": 91,
      "start": 16183.66,
      "end": 16185.66,
      "formatted_start": "04:29:43.660",
      "formatted_end": "04:29:45.660",
      "text": "آره دیگه باید بدونی"
    },
    {
      "id": 92,
      "start": 16185.66,
      "end": 16187.66,
      "formatted_start": "04:29:45.660",
      "formatted_end": "04:29:47.660",
      "text": "اونو پشت کارت ملیت بچست بود مادر"
    },
    {
      "id": 93,
      "start": 16187.66,
      "end": 16189.66,
      "formatted_start": "04:29:47.660",
      "formatted_end": "04:29:49.660",
      "text": "خیلی مانه من"
    },
    {
      "id": 94,
      "start": 16189.66,
