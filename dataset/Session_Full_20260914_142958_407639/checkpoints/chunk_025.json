  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7508.0,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:08.000",
      "text": "از اینجوری میشه بچهت فقط این چیز رو کن کن، بیتار رو کن، دکتر گفته فیلن تعلیم نوشته باشه، نمیدونه کن، این چیز رو کن، شروع کن."
    },
    {
      "id": 1,
      "start": 7508.0,
      "end": 7513.0,
      "formatted_start": "02:05:08.000",
      "formatted_end": "02:05:13.000",
      "text": "قاچش خوب نمیشه، عرف کن کن، قاچش خوب نمیشه، باقر هم همینطور کن."
    },
    {
      "id": 2,
      "start": 7513.0,
      "end": 7514.0,
      "formatted_start": "02:05:13.000",
      "formatted_end": "02:05:14.000",
      "text": "از اینجوری باقر عرف کن کن کن."
    },
    {
      "id": 3,
      "start": 7514.0,
      "end": 7516.0,
      "formatted_start": "02:05:14.000",
      "formatted_end": "02:05:16.000",
      "text": "از اینجوری باقر کن کن کن، سنو براش نمیشه؟"
    },
    {
      "id": 4,
      "start": 7516.0,
      "end": 7518.0,
      "formatted_start": "02:05:16.000",
      "formatted_end": "02:05:18.000",
      "text": "آره، یک ماه وقت داری همه رو داریم."
    },
    {
      "id": 5,
      "start": 7518.0,
      "end": 7520.0,
      "formatted_start": "02:05:18.000",
      "formatted_end": "02:05:20.000",
      "text": "از آن دراش انجام بدیم"
    },
    {
      "id": 6,
      "start": 7520.0,
      "end": 7525.0,
      "formatted_start": "02:05:20.000",
      "formatted_end": "02:05:25.000",
      "text": "آزمایشش، داروش، خودت هم سنو و داروش"
    },
    {
      "id": 7,
      "start": 7525.0,
      "end": 7527.0,
      "formatted_start": "02:05:25.000",
      "formatted_end": "02:05:27.000",
      "text": "آزمایش هم تره، آزمایش کجا بریم؟"
    },
    {
      "id": 8,
      "start": 7527.0,
      "end": 7530.0,
      "formatted_start": "02:05:27.000",
      "formatted_end": "02:05:30.000",
      "text": "آزمایشش پردیس، شفا، گنبه داریم"
    },
    {
      "id": 9,
      "start": 7530.0,
      "end": 7531.0,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:31.000",
      "text": "شفا؟"
    },
    {
      "id": 10,
      "start": 7531.0,
      "end": 7533.0,
      "formatted_start": "02:05:31.000",
      "formatted_end": "02:05:33.000",
      "text": "پردیس، بخواهم شفا برمونم"
    },
    {
      "id": 11,
      "start": 7533.0,
      "end": 7537.0,
      "formatted_start": "02:05:33.000",
      "formatted_end": "02:05:37.000",
      "text": "دکتور ایرینو هست؟"
    },
    {
      "id": 12,
      "start": 7537.0,
      "end": 7539.0,
      "formatted_start": "02:05:37.000",
      "formatted_end": "02:05:39.000",
      "text": "آزمایشگاه؟"
    },
    {
      "id": 13,
      "start": 7539.0,
      "end": 7541.0,
      "formatted_start": "02:05:39.000",
      "formatted_end": "02:05:41.000",
      "text": "آزمایشگاه چرا برمونم؟"
    },
    {
      "id": 14,
      "start": 7541.0,
      "end": 7542.0,
      "formatted_start": "02:05:41.000",
