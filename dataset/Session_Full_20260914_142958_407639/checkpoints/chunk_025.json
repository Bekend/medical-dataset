    },
    {
      "id": 30,
      "start": 7568.0,
      "end": 7570.0,
      "formatted_start": "02:06:08.000",
      "formatted_end": "02:06:10.000",
      "text": "با شما با شما"
    },
    {
      "id": 31,
      "start": 7570.0,
      "end": 7572.0,
      "formatted_start": "02:06:10.000",
      "formatted_end": "02:06:12.000",
      "text": "با شما با شما"
    },
    {
      "id": 32,
      "start": 7572.0,
      "end": 7574.0,
      "formatted_start": "02:06:12.000",
      "formatted_end": "02:06:14.000",
      "text": "با شما با شما"
    },
    {
      "id": 33,
      "start": 7574.0,
      "end": 7604.0,
      "formatted_start": "02:06:14.000",
      "formatted_end": "02:06:44.000",
      "text": "نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه ن"
    },
    {
      "id": 34,
      "start": 7604.0,
      "end": 7607.0,
      "formatted_start": "02:06:44.000",
      "formatted_end": "02:06:47.000",
      "text": "تو فکر کردیم ما هر روز گریم همکنه کنیم"
    },
    {
      "id": 35,
      "start": 7607.0,
      "end": 7609.0,
      "formatted_start": "02:06:47.000",
      "formatted_end": "02:06:49.000",
      "text": "ما از آخر بزنیم میشیم گریم"
    },
    {
      "id": 36,
      "start": 7609.0,
      "end": 7611.0,
      "formatted_start": "02:06:49.000",
      "formatted_end": "02:06:51.000",
      "text": "اما تو داری خودتو زج رو میدی"
    },
    {
      "id": 37,
      "start": 7611.0,
      "end": 7613.0,
      "formatted_start": "02:06:51.000",
      "formatted_end": "02:06:53.000",
      "text": "و بابا داره از آن می کشی"
    },
    {
      "id": 38,
      "start": 7613.0,
      "end": 7617.0,
      "formatted_start": "02:06:53.000",
      "formatted_end": "02:06:57.000",
      "text": "دارم که شبا در ما بلیشه دارم هر چی دم نانه"
    },
    {
      "id": 39,
      "start": 7617.0,
      "end": 7619.0,
      "formatted_start": "02:06:57.000",
      "formatted_end": "02:06:59.000",
      "text": "اصلا خوشک شدی"
    },
    {
      "id": 40,
      "start": 7619.0,
      "end": 7622.0,
      "formatted_start": "02:06:59.000",
      "formatted_end": "02:07:02.000",
      "text": "یک دونه"
    },
    {
      "id": 41,
      "start": 7622.0,
      "end": 7624.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:04.000",
      "text": "دو سایی رو بگیریم"
    },
    {
      "id": 42,
      "start": 7624.0,
      "end": 7626.0,
      "formatted_start": "02:07:04.000",
      "formatted_end": "02:07:06.000",
      "text": "یک دو سایی رو بگیریم"
    },
    {
      "id": 43,
      "start": 7626.0,
      "end": 7628.0,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:08.000",
      "text": "مرسی"
    },
    {
      "id": 44,
      "start": 7628.0,
      "end": 7630.0,
      "formatted_start": "02:07:08.000",
      "formatted_end": "02:07:10.000",
      "text": "سلامت باشید"
    },
    {
      "id": 45,
      "start": 7630.0,
      "end": 7632.0,
      "formatted_start": "02:07:10.000",
      "formatted_end": "02:07:12.000",
      "text": "با نام شرفی بخواییم"
    },
    {
      "id": 46,
      "start": 7632.0,
      "end": 7634.0,
      "formatted_start": "02:07:12.000",
      "formatted_end": "02:07:14.000",
      "text": "خوش آشتادم برنامه"
    },
    {
      "id": 47,
      "start": 7634.0,
      "end": 7636.0,
      "formatted_start": "02:07:14.000",
      "formatted_end": "02:07:16.000",
      "text": "سلامه خوشی"
    },
    {
      "id": 48,
      "start": 7636.0,
      "end": 7638.0,
      "formatted_start": "02:07:16.000",
      "formatted_end": "02:07:18.000",
      "text": "دو هفته پیش تالش رو دادیم"
    },
    {
      "id": 49,
      "start": 7638.0,
      "end": 7640.0,
      "formatted_start": "02:07:18.000",
      "formatted_end": "02:07:20.000",
      "text": "خدا هم با چه ما رو عمد کنه"
    },
    {
      "id": 50,
      "start": 7640.0,
      "end": 7642.0,
      "formatted_start": "02:07:20.000",
      "formatted_end": "02:07:22.000",
      "text": "بعد دیگه همسایی ها با قاله بخنین دوست داشته ها"
    },
    {
      "id": 51,
      "start": 7642.0,
      "end": 7644.0,
      "formatted_start": "02:07:22.000",
      "formatted_end": "02:07:24.000",
      "text": "آمده مارو از آدار آده"
    },
    {
      "id": 52,
      "start": 7644.0,
      "end": 7646.0,
      "formatted_start": "02:07:24.000",
      "formatted_end": "02:07:26.000",
      "text": "اگه هنوز که هنوز سیاه باشی"
    },
    {
      "id": 53,
      "start": 7646.0,
      "end": 7648.0,
      "formatted_start": "02:07:26.000",
      "formatted_end": "02:07:28.000",
      "text": "نه از هم خوب نیست"
    },
    {
      "id": 54,
      "start": 7648.0,
      "end": 7650.0,
      "formatted_start": "02:07:28.000",
      "formatted_end": "02:07:30.000",
      "text": "من خواهم با چیز از شکل کنم یه ساله نیم به زور حیوی ببنیم"
    },
    {
      "id": 55,
      "start": 7650.0,
      "end": 7652.0,
      "formatted_start": "02:07:30.000",
      "formatted_end": "02:07:32.000",
      "text": "ولی"
    },
    {
      "id": 56,
      "start": 7652.0,
      "end": 7654.0,
      "formatted_start": "02:07:32.000",
      "formatted_end": "02:07:34.000",
      "text": "بعد الان خودم دیگه وقت اون روز برمیرم"
    },
    {
      "id": 57,
      "start": 7654.0,
      "end": 7656.0,
      "formatted_start": "02:07:34.000",
      "formatted_end": "02:07:36.000",
      "text": "خواهم بد میشه"
    },
    {
      "id": 58,
      "start": 7656.0,
      "end": 7660.0,
      "formatted_start": "02:07:36.000",
      "formatted_end": "02:07:40.000",
      "text": "او برنامه چند وقت میشه کشیم و ازشم خیلی یکسو همه رو پا کردم"
    },
    {
      "id": 59,
      "start": 7660.0,
      "end": 7664.0,
      "formatted_start": "02:07:40.000",
      "formatted_end": "02:07:44.000",
      "text": "از خودم تو اون روزای قلم بود خودم اون اکسو هم میرزم، آدم بد میشه"
    },
    {
      "id": 60,
      "start": 7664.0,
      "end": 7668.0,
      "formatted_start": "02:07:44.000",
      "formatted_end": "02:07:48.000",
      "text": "نه مامان یه فیلم توی مارسون ازش کرده دادم پر از گاهی خودم"
    },
    {
      "id": 61,
      "start": 7668.0,
      "end": 7670.0,
      "formatted_start": "02:07:48.000",
      "formatted_end": "02:07:50.000",
      "text": "تنهایی خودم نگاه میکنم"
    },
    {
      "id": 62,
      "start": 7670.0,
      "end": 7673.0,
      "formatted_start": "02:07:50.000",
      "formatted_end": "02:07:53.000",
      "text": "نگاه میکنم و تا صبح دیگه فکر و خیال دارم"
    },
    {
      "id": 63,
      "start": 7673.0,
      "end": 7678.0,
      "formatted_start": "02:07:53.000",
      "formatted_end": "02:07:58.000",
      "text": "چون دارین، نه که من یک گوی وقتا یک اون فیلمان رو نمی کنم شاید همونجا ببینم"
    },
    {
      "id": 64,
      "start": 7678.0,
      "end": 7680.76,
      "formatted_start": "02:07:58.000",
      "formatted_end": "02:08:00.760",
      "text": "شاید آدم همجوری باید تو داری زهرشو کنی"
    },
    {
      "id": 65,
      "start": 7680.76,
      "end": 7682.76,
      "formatted_start": "02:08:00.760",
      "formatted_end": "02:08:02.760",
      "text": "کجاونه پدر داره زهرشو میکشه"
    },
    {
      "id": 66,
      "start": 7682.76,
      "end": 7684.76,
      "formatted_start": "02:08:02.760",
      "formatted_end": "02:08:04.760",
      "text": "دقیقا همینجوریه برای که بازم"
    },
    {
      "id": 67,
      "start": 7684.76,
      "end": 7687.76,
      "formatted_start": "02:08:04.760",
      "formatted_end": "02:08:07.760",
      "text": "باید سرگرم شید دیگه سردنی برداری کنی"
    },
    {
      "id": 68,
      "start": 7687.76,
      "end": 7689.76,
      "formatted_start": "02:08:07.760",
      "formatted_end": "02:08:09.760",
      "text": "باید برداری که هنوز که هنوز سخت"
    },
    {
      "id": 69,
      "start": 7689.76,
      "end": 7691.76,
      "formatted_start": "02:08:09.760",
      "formatted_end": "02:08:11.760",
      "text": "سخت که خیلی سخته سخت مادر یه لحظه"
    },
    {
      "id": 70,
      "start": 7691.76,
      "end": 7695.76,
      "formatted_start": "02:08:11.760",
      "formatted_end": "02:08:15.760",
      "text": "چون بچش خدا شد مادرت هنوز هست شکر کنه"
    },
    {
      "id": 71,
      "start": 7695.76,
      "end": 7699.76,
      "formatted_start": "02:08:15.760",
      "formatted_end": "02:08:19.760",
      "text": "از اینجا همون هم از بسیار دوش کرده، فشار چشم زده باند، یه چشم از دسته"
    },
    {
      "id": 72,
      "start": 7699.76,
      "end": 7703.76,
      "formatted_start": "02:08:19.760",
      "formatted_end": "02:08:23.760",
      "text": "خب وقتی که تو دخترش اینجایی باشه آروم نیست، خب چی داری برند؟"
    },
    {
      "id": 73,
      "start": 7703.76,
      "end": 7707.76,
      "formatted_start": "02:08:23.760",
      "formatted_end": "02:08:27.760",
      "text": "دقیقا دیروز یه دباس رفتم بپوشم داخل خونه، تیشرت را را خطی بپوشم"
    },
    {
      "id": 74,
      "start": 7707.76,
      "end": 7711.76,
      "formatted_start": "02:08:27.760",
      "formatted_end": "02:08:31.760",
      "text": "ای مادر، چقدر ناغر شده، این تیشرت همینی بود که کیت بترده"
    },
    {
      "id": 75,
      "start": 7711.76,
      "end": 7714.76,
      "formatted_start": "02:08:31.760",
      "formatted_end": "02:08:34.760",
      "text": "خب آره، خب بگو سر میخورن دیگه"
    },
    {
      "id": 76,
      "start": 7714.76,
      "end": 7744.76,
      "formatted_start": "02:08:34.760",
      "formatted_end": "02:09:04.760",
      "text": "با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با شما با ش"
    },
    {
      "id": 77,
      "start": 7744.76,
      "end": 7747.76,
      "formatted_start": "02:09:04.760",
      "formatted_end": "02:09:07.760",
      "text": "اینجا بزنم از خود را خونه نمی برسم باد کنم"
    },
    {
      "id": 78,
      "start": 7747.76,
      "end": 7749.76,
      "formatted_start": "02:09:07.760",
      "formatted_end": "02:09:09.760",
      "text": "سلامت بزنم"
    },
    {
      "id": 79,
      "start": 7749.76,
      "end": 7750.76,
      "formatted_start": "02:09:09.760",
      "formatted_end": "02:09:10.760",
      "text": "برخوزو بزنش با ترخوزت سلامت"
    },
    {
      "id": 80,
      "start": 7750.76,
      "end": 7752.76,
      "formatted_start": "02:09:10.760",
      "formatted_end": "02:09:12.760",
      "text": "مرسی هست برقم همین"
    },
    {
      "id": 81,
      "start": 7752.76,
      "end": 7753.76,
      "formatted_start": "02:09:12.760",
      "formatted_end": "02:09:13.760",
      "text": "برم آشکانو باید بخورم"
    },
    {
      "id": 82,
      "start": 7753.76,
      "end": 7754.76,
      "formatted_start": "02:09:13.760",
      "formatted_end": "02:09:14.760",
      "text": "بفهم بدم"
    },
    {
      "id": 83,
      "start": 7754.76,
      "end": 7755.76,
      "formatted_start": "02:09:14.760",
      "formatted_end": "02:09:15.760",
      "text": "سی تی؟"
    },
    {
      "id": 84,
      "start": 7755.76,
      "end": 7757.76,
      "formatted_start": "02:09:15.760",
      "formatted_end": "02:09:17.760",
      "text": "آره سی تی داشتیم"
    },
    {
      "id": 85,
      "start": 7759.76,
      "end": 7761.76,
      "formatted_start": "02:09:19.760",
      "formatted_end": "02:09:21.760",
      "text": "باید پنج روز برد میشنیم"
    },
    {
      "id": 86,
      "start": 7761.76,
      "end": 7762.76,
      "formatted_start": "02:09:21.760",
      "formatted_end": "02:09:22.760",
      "text": "موهره"
    },
    {
      "id": 87,
      "start": 7762.76,
      "end": 7763.76,
      "formatted_start": "02:09:22.760",
      "formatted_end": "02:09:23.760",
      "text": "پا چانه میبینیم بردن"
    },
    {
      "id": 88,
      "start": 7763.76,
      "end": 7766.76,
      "formatted_start": "02:09:23.760",
      "formatted_end": "02:09:26.760",
      "text": "بفهم بشین بشین بفهم بشین بشین"
    },
    {
      "id": 89,
      "start": 7768.76,
      "end": 7769.76,
      "formatted_start": "02:09:28.760",
      "formatted_end": "02:09:29.760",
      "text": "آمانه هست"
    },
    {
      "id": 90,
      "start": 7770.76,
