  "stt_segments": [
    {
      "id": 0,
      "start": 20100.0,
      "end": 20130.0,
      "formatted_start": "05:35:00.000",
      "formatted_end": "05:35:30.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که ا"
    },
    {
      "id": 1,
      "start": 20130.0,
      "end": 20132.0,
      "formatted_start": "05:35:30.000",
      "formatted_end": "05:35:32.000",
      "text": "شب خوب میخوادی؟"
    },
    {
      "id": 2,
      "start": 20132.0,
      "end": 20134.0,
      "formatted_start": "05:35:32.000",
      "formatted_end": "05:35:34.000",
      "text": "اصلا اولین مدت اصلا میتونم بخوابم"
    },
    {
      "id": 3,
      "start": 20134.0,
      "end": 20136.0,
      "formatted_start": "05:35:34.000",
      "formatted_end": "05:35:36.000",
      "text": "خواب بردی میدی؟"
    },
    {
      "id": 4,
      "start": 20136.0,
      "end": 20138.0,
      "formatted_start": "05:35:36.000",
      "formatted_end": "05:35:38.000",
      "text": "خوابم نمیخوابم که خواب رو بینم رو میاد"
    },
    {
      "id": 5,
      "start": 20138.0,
      "end": 20140.0,
      "formatted_start": "05:35:38.000",
      "formatted_end": "05:35:40.000",
      "text": "خوابم نمیخوابم که خواب رو بینم رو میاد"
    },
    {
      "id": 6,
      "start": 20140.0,
      "end": 20142.0,
      "formatted_start": "05:35:40.000",
      "formatted_end": "05:35:42.000",
      "text": "کشم واسه خواب داریم"
    },
    {
      "id": 7,
      "start": 20142.0,
      "end": 20144.0,
      "formatted_start": "05:35:42.000",
      "formatted_end": "05:35:44.000",
      "text": "بازم نخوابیدم رو بینم"
    },
    {
      "id": 8,
      "start": 20144.0,
      "end": 20146.0,
      "formatted_start": "05:35:44.000",
      "formatted_end": "05:35:46.000",
      "text": "رابط زنشویتون خوبه؟"
    },
    {
      "id": 9,
      "start": 20146.0,
      "end": 20148.0,
      "formatted_start": "05:35:46.000",
      "formatted_end": "05:35:48.000",
      "text": "خوبه"
    },
    {
      "id": 10,
      "start": 20148.0,
      "end": 20150.0,
      "formatted_start": "05:35:48.000",
      "formatted_end": "05:35:50.000",
      "text": "یعنی توی مرد دانکیتون این هم مشکل نرم؟"
    },
    {
      "id": 11,
      "start": 20150.0,
      "end": 20152.0,
      "formatted_start": "05:35:50.000",
      "formatted_end": "05:35:52.000",
      "text": "نه حدشم بیشتره"
    },
    {
      "id": 12,
      "start": 20152.0,
      "end": 20154.0,
      "formatted_start": "05:35:52.000",
      "formatted_end": "05:35:54.000",
      "text": "نه حدش بیشتره اتفاقا همین"
    },
    {
      "id": 13,
      "start": 20154.0,
      "end": 20156.0,
      "formatted_start": "05:35:54.000",
      "formatted_end": "05:35:56.000",
      "text": "یعنی که استرست زیاده"
    },
    {
      "id": 14,
      "start": 20156.0,
      "end": 20162.0,
      "formatted_start": "05:35:56.000",
      "formatted_end": "05:36:02.000",
      "text": "وقتی از رابطتون از یه حدی خود احساس می کنی اون از حالت نرمور خواهد شده"
    },
    {
      "id": 15,
      "start": 20162.0,
      "end": 20164.0,
      "formatted_start": "05:36:02.000",
      "formatted_end": "05:36:04.000",
      "text": "یعنی استرست خیلی خیال شده"
    },
    {
      "id": 16,
      "start": 20164.0,
      "end": 20166.0,
      "formatted_start": "05:36:04.000",
      "formatted_end": "05:36:06.000",
      "text": "این یه راهیه برای تخلیه استرس"
    },
    {
      "id": 17,
      "start": 20166.0,
      "end": 20170.0,
      "formatted_start": "05:36:06.000",
      "formatted_end": "05:36:10.000",
      "text": "آنچه همونی که یه رنگ می کنی و برس می کنی"
    },
    {
      "id": 18,
      "start": 20170.0,
      "end": 20172.0,
      "formatted_start": "05:36:10.000",
      "formatted_end": "05:36:12.000",
      "text": "برس بازم"
    },
    {
      "id": 19,
      "start": 20172.0,
      "end": 20176.0,
      "formatted_start": "05:36:12.000",
      "formatted_end": "05:36:16.000",
      "text": "نه خب باز بدتر می شود"
    },
    {
      "id": 20,
      "start": 20176.0,
      "end": 20179.0,
      "formatted_start": "05:36:16.000",
      "formatted_end": "05:36:19.000",
      "text": "چون بدتره دیگه بیاین آفرینه شده"
    },
    {
      "id": 21,
      "start": 20179.0,
      "end": 20183.0,
      "formatted_start": "05:36:19.000",
      "formatted_end": "05:36:23.000",
      "text": "این چیزی دیگه ماتوه اون چیزی که خدا میذاره که دخالت نمیشه بکنه"
    },
    {
      "id": 22,
      "start": 20192.0,
      "end": 20197.0,
      "formatted_start": "05:36:32.000",
      "formatted_end": "05:36:37.000",
      "text": "خب، ما حالا باید دوز پایین باز شروع کردیم ببین چطوری دو ساعت قبل خواب بخور"
    },
    {
      "id": 23,
      "start": 20197.0,
      "end": 20202.0,
      "formatted_start": "05:36:37.000",
      "formatted_end": "05:36:42.000",
      "text": "بعد اگر دیدی اثر نداره کامل بخوریم، اما دوز کم شد این کار هم نمیشه داره بخوریم"
    },
    {
      "id": 24,
      "start": 20202.0,
      "end": 20204.0,
      "formatted_start": "05:36:42.000",
      "formatted_end": "05:36:44.000",
      "text": "ولی یه اسپره براتون شروع کردیم"
    },
    {
      "id": 25,
      "start": 20204.0,
      "end": 20206.0,
      "formatted_start": "05:36:44.000",
      "formatted_end": "05:36:46.000",
      "text": "اسپره داره هم ها دوتا"
    },
    {
      "id": 26,
      "start": 20206.0,
      "end": 20207.0,
      "formatted_start": "05:36:46.000",
      "formatted_end": "05:36:47.000",
      "text": "اسپره چه رنگه؟"
    },
    {
      "id": 27,
      "start": 20207.0,
      "end": 20209.0,
      "formatted_start": "05:36:47.000",
      "formatted_end": "05:36:49.000",
      "text": "یه آبی هم داره هم فراموز چند رو هست؟"
    },
    {
      "id": 28,
      "start": 20209.0,
      "end": 20214.0,
      "formatted_start": "05:36:49.000",
      "formatted_end": "05:36:54.000",
      "text": "از آبیه که به درگی هست، اصلا نباید از این رو استفاده کنید، حتی خودش باز پاشید، همون قرنزه"
    },
    {
      "id": 29,
      "start": 20214.0,
      "end": 20223.0,
      "formatted_start": "05:36:54.000",
      "formatted_end": "05:37:03.000",
      "text": "برنخش نه، قرنزه و فلی باشه، صورتیه، توی یخچاله، داریش، همونه هر دوزن سالتونه، پس این ننویس هم برای آن"
    },
    {
      "id": 30,
      "start": 20223.0,
      "end": 20225.0,
      "formatted_start": "05:37:03.000",
      "formatted_end": "05:37:05.000",
      "text": "اینجور بگیم سه فاطبه"
    },
    {
      "id": 31,
      "start": 20225.0,
      "end": 20227.0,
      "formatted_start": "05:37:05.000",
      "formatted_end": "05:37:07.000",
      "text": "نه خب داره همه از همه"
    },
    {
      "id": 32,
      "start": 20227.0,
      "end": 20229.0,
      "formatted_start": "05:37:07.000",
      "formatted_end": "05:37:09.000",
      "text": "سه ها سه فاطبه"
    },
    {
      "id": 33,
      "start": 20229.0,
      "end": 20231.0,
      "formatted_start": "05:37:09.000",
      "formatted_end": "05:37:11.000",
      "text": "این دارو شدن چی تاثیر میذار وردش؟"
    },
    {
      "id": 34,
      "start": 20231.0,
      "end": 20233.0,
      "formatted_start": "05:37:11.000",
      "formatted_end": "05:37:13.000",
      "text": "داروی؟"
    },
    {
      "id": 35,
      "start": 20233.0,
      "end": 20235.0,
      "formatted_start": "05:37:13.000",
      "formatted_end": "05:37:15.000",
      "text": "نفذش پاس میشه"
    },
    {
      "id": 36,
      "start": 20235.0,
      "end": 20237.0,
      "formatted_start": "05:37:15.000",
      "formatted_end": "05:37:17.000",
      "text": "اسپرات تو مهنتان نمیزن"
    },
    {
      "id": 37,
      "start": 20237.0,
      "end": 20239.0,
      "formatted_start": "05:37:17.000",
      "formatted_end": "05:37:19.000",
      "text": "نه نه"
    },
    {
      "id": 38,
      "start": 20239.0,
      "end": 20241.0,
      "formatted_start": "05:37:19.000",
      "formatted_end": "05:37:21.000",
      "text": "میدونی چرا چون مشکل نداری خود"
    },
    {
      "id": 39,
      "start": 20241.0,
      "end": 20243.0,
      "formatted_start": "05:37:21.000",
      "formatted_end": "05:37:23.000",
      "text": "در زندگی آرکی"
    },
    {
      "id": 40,
      "start": 20243.0,
      "end": 20245.0,
      "formatted_start": "05:37:23.000",
      "formatted_end": "05:37:25.000",
      "text": "چون مشکل نداری فکر میکنی مشکل نداری"
    },
    {
      "id": 41,
      "start": 20245.0,
      "end": 20247.0,
      "formatted_start": "05:37:25.000",
      "formatted_end": "05:37:27.000",
      "text": "در حال که بیمارتون نخواد به پیش رفت"
    },
    {
      "id": 42,
      "start": 20247.0,
      "end": 20249.0,
      "formatted_start": "05:37:27.000",
      "formatted_end": "05:37:29.000",
      "text": "میدونی استرس که میگی"
    },
    {
      "id": 43,
      "start": 20249.0,
      "end": 20251.0,
      "formatted_start": "05:37:29.000",
      "formatted_end": "05:37:31.000",
      "text": "نفذ هم کم میره"
    },
    {
      "id": 44,
      "start": 20251.0,
      "end": 20255.24,
      "formatted_start": "05:37:31.000",
      "formatted_end": "05:37:35.240",
      "text": "تو استرس تنگ نفس میده، استرس، خشم، گرمای زیاده هوا"
    },
    {
      "id": 45,
      "start": 20255.24,
      "end": 20258.06,
      "formatted_start": "05:37:35.240",
      "formatted_end": "05:37:38.060",
      "text": "اینو همه تنگی هرم میکنند، خیلی دیگر..."
    },
    {
      "id": 46,
      "start": 20258.06,
      "end": 20261.56,
      "formatted_start": "05:37:38.060",
      "formatted_end": "05:37:41.560",
      "text": "تلاش تنفسی در بدنش، گفتم رو بردار بشانده"
    },
    {
      "id": 47,
      "start": 20261.56,
      "end": 20266.24,
      "formatted_start": "05:37:41.560",
      "formatted_end": "05:37:46.240",
      "text": "اسپره تونو علامت داری یا نداری، حتی هر روزی یه بار بزنیم برای شما دردار شدیم"
    },
    {
      "id": 48,
      "start": 20266.24,
      "end": 20268.44,
      "formatted_start": "05:37:46.240",
      "formatted_end": "05:37:48.440",
      "text": "این دو رنگ این اسپریه داره به نفسی نگهان باشه"
    },
    {
      "id": 49,
      "start": 20268.44,
      "end": 20270.24,
      "formatted_start": "05:37:48.440",
      "formatted_end": "05:37:50.240",
      "text": "این اسپریه که میگه اینجا الیسینه باشه؟"
    },
    {
      "id": 50,
      "start": 20270.24,
      "end": 20274.48,
      "formatted_start": "05:37:50.240",
      "formatted_end": "05:37:54.480",
      "text": "این دراش رو هم استفاده کنید"
    },
    {
      "id": 51,
      "start": 20274.48,
      "end": 20276.44,
      "formatted_start": "05:37:54.480",
      "formatted_end": "05:37:56.440",
      "text": "نسبه شما به ایلیسی نگیره باشه"
    },
    {
      "id": 52,
      "start": 20276.44,
      "end": 20277.2,
      "formatted_start": "05:37:56.440",
      "formatted_end": "05:37:57.200",
      "text": "اونو میگیرم"
    },
    {
      "id": 53,
      "start": 20277.2,
      "end": 20280.12,
      "formatted_start": "05:37:57.200",
      "formatted_end": "05:38:00.120",
      "text": "هر دوازده ساعت شما باشید"
    },
    {
      "id": 54,
      "start": 20280.12,
      "end": 20281.44,
      "formatted_start": "05:38:00.120",
      "formatted_end": "05:38:01.440",
      "text": "اینکه علامت ندار باشید"
    },
    {
      "id": 55,
      "start": 20281.44,
      "end": 20282.36,
      "formatted_start": "05:38:01.440",
      "formatted_end": "05:38:02.360",
      "text": "هر شب بزنید"
    },
    {
      "id": 56,
      "start": 20282.36,
      "end": 20283.66,
      "formatted_start": "05:38:02.360",
      "formatted_end": "05:38:03.660",
      "text": "خود سرماده جایید"
    },
    {
      "id": 57,
      "start": 20283.66,
      "end": 20285.14,
      "formatted_start": "05:38:03.660",
      "formatted_end": "05:38:05.140",
      "text": "مقاید بگیر هر شب بزنید"
    },
    {
      "id": 58,
      "start": 20285.14,
      "end": 20287.2,
      "formatted_start": "05:38:05.140",
      "formatted_end": "05:38:07.200",
      "text": "وقتی سرماده بخوری دوازده ساعتی"
    },
    {
      "id": 59,
      "start": 20287.2,
      "end": 20289.72,
      "formatted_start": "05:38:07.200",
      "formatted_end": "05:38:09.720",
      "text": "و همین کود بگیرید"
    },
    {
      "id": 60,
      "start": 20289.72,
      "end": 20292.06,
      "formatted_start": "05:38:09.720",
      "formatted_end": "05:38:12.060",
      "text": "بابا شما کمتر شما درده"
    },
    {
      "id": 61,
      "start": 20292.06,
      "end": 20293.76,
      "formatted_start": "05:38:12.060",
      "formatted_end": "05:38:13.760",
      "text": "بابا شما کمتر شما درده"
    },
    {
      "id": 62,
      "start": 20293.76,
      "end": 20294.62,
      "formatted_start": "05:38:13.760",
      "formatted_end": "05:38:14.620",
      "text": "بابا شما کمتر شما درده"
    },
    {
      "id": 63,
      "start": 20324.62,
      "end": 20332.62,
      "formatted_start": "05:38:44.620",
      "formatted_end": "05:38:52.620",
      "text": "از این وقت باید از فرداش یک سرموخورده شده گرفت"
    },
    {
      "id": 64,
      "start": 20332.62,
      "end": 20334.62,
      "formatted_start": "05:38:52.620",
      "formatted_end": "05:38:54.620",
      "text": "دیگه سه روز کامل هم داخته بودم"
    },
    {
      "id": 65,
      "start": 20334.62,
      "end": 20336.62,
      "formatted_start": "05:38:54.620",
      "formatted_end": "05:38:56.620",
      "text": "آزمایش رو چند روز قبلش رفته بودی؟"
    },
    {
      "id": 66,
      "start": 20336.62,
      "end": 20341.62,
      "formatted_start": "05:38:56.620",
      "formatted_end": "05:39:01.620",
      "text": "آزمایش رو... آره دیگه آزمایش که برم نمیشه بود فرداش رو اونجا میدونم"
    },
    {
      "id": 67,
      "start": 20341.62,
      "end": 20343.62,
      "formatted_start": "05:39:01.620",
      "formatted_end": "05:39:03.620",
      "text": "باید فرداش رو بودیم؟"
    },
    {
      "id": 68,
      "start": 20343.62,
      "end": 20345.62,
      "formatted_start": "05:39:03.620",
      "formatted_end": "05:39:05.620",
      "text": "آره فرداش شبش میدون شدم"
    },
    {
      "id": 69,
      "start": 20345.62,
      "end": 20349.62,
      "formatted_start": "05:39:05.620",
      "formatted_end": "05:39:09.620",
      "text": "یعنی نمیرفتم بعدش بهتر بدارم؟"
    },
    {
      "id": 70,
      "start": 20349.62,
      "end": 20351.62,
      "formatted_start": "05:39:09.620",
      "formatted_end": "05:39:11.620",
      "text": "نه، باید بیدارم"
    },
    {
      "id": 71,
      "start": 20351.62,
      "end": 20353.62,
      "formatted_start": "05:39:11.620",
      "formatted_end": "05:39:13.620",
      "text": "از اینجا خیلی خیلی خوبه"
    },
    {
      "id": 72,
      "start": 20353.62,
      "end": 20355.62,
      "formatted_start": "05:39:13.620",
      "formatted_end": "05:39:15.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 73,
      "start": 20355.62,
      "end": 20357.62,
      "formatted_start": "05:39:15.620",
      "formatted_end": "05:39:17.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 74,
      "start": 20357.62,
      "end": 20359.62,
      "formatted_start": "05:39:17.620",
      "formatted_end": "05:39:19.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 75,
      "start": 20359.62,
      "end": 20361.62,
      "formatted_start": "05:39:19.620",
      "formatted_end": "05:39:21.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 76,
      "start": 20361.62,
      "end": 20363.62,
      "formatted_start": "05:39:21.620",
      "formatted_end": "05:39:23.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 77,
      "start": 20363.62,
      "end": 20365.62,
      "formatted_start": "05:39:23.620",
      "formatted_end": "05:39:25.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 78,
      "start": 20365.62,
      "end": 20367.62,
      "formatted_start": "05:39:25.620",
      "formatted_end": "05:39:27.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 79,
      "start": 20367.62,
      "end": 20369.62,
      "formatted_start": "05:39:27.620",
      "formatted_end": "05:39:29.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 80,
      "start": 20369.62,
      "end": 20371.62,
      "formatted_start": "05:39:29.620",
      "formatted_end": "05:39:31.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 81,
      "start": 20371.62,
      "end": 20373.62,
      "formatted_start": "05:39:31.620",
      "formatted_end": "05:39:33.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 82,
      "start": 20373.62,
      "end": 20375.62,
      "formatted_start": "05:39:33.620",
      "formatted_end": "05:39:35.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 83,
      "start": 20375.62,
      "end": 20377.62,
      "formatted_start": "05:39:35.620",
      "formatted_end": "05:39:37.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 84,
      "start": 20377.62,
      "end": 20379.62,
      "formatted_start": "05:39:37.620",
      "formatted_end": "05:39:39.620",
      "text": "از اینجا خیلی خوبه"
    },
    {
      "id": 85,
      "start": 20379.62,
      "end": 20381.62,
      "formatted_start": "05:39:39.620",
      "formatted_end": "05:39:41.620",
      "text": "500 میخواییم"
    },
    {
      "id": 86,
      "start": 20382.92,
      "end": 20384.92,
      "formatted_start": "05:39:42.920",
      "formatted_end": "05:39:44.920",
      "text": "ما اگه دیگه بگید چرا دوتا بگیم"
    },
    {
      "id": 87,
      "start": 20384.92,
      "end": 20386.32,
      "formatted_start": "05:39:44.920",
      "formatted_end": "05:39:46.320",
      "text": "پس اگه اونجور باشه"
    },
    {
      "id": 88,
      "start": 20386.32,
      "end": 20389.32,
      "formatted_start": "05:39:46.320",
      "formatted_end": "05:39:49.320",
      "text": "آره چهتا بگیریم هر دوازه ساعت دوتا بگیم"
    },
    {
      "id": 89,
      "start": 20391.32,
      "end": 20393.32,
      "formatted_start": "05:39:51.320",
      "formatted_end": "05:39:53.320",
      "text": "آره آره"
    },
    {
      "id": 90,
      "start": 20393.32,
      "end": 20395.32,
      "formatted_start": "05:39:53.320",
      "formatted_end": "05:39:55.320",
      "text": "سنم هم کشیم خواستیم اون پاکستان"
    },
    {
      "id": 91,
      "start": 20395.32,
      "end": 20396.32,
      "formatted_start": "05:39:55.320",
      "formatted_end": "05:39:56.320",
      "text": "چرا خواستیم؟"
    },
    {
      "id": 92,
      "start": 20396.32,
      "end": 20398.32,
      "formatted_start": "05:39:56.320",
      "formatted_end": "05:39:58.320",
      "text": "الان فشار خونه بودیم بله"
    },
    {
      "id": 93,
      "start": 20398.32,
