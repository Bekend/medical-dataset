    },
    {
      "id": 37,
      "start": 12424.0,
      "end": 12425.0,
      "formatted_start": "03:27:04.000",
      "formatted_end": "03:27:05.000",
      "text": "از این داری؟"
    },
    {
      "id": 38,
      "start": 12425.0,
      "end": 12428.0,
      "formatted_start": "03:27:05.000",
      "formatted_end": "03:27:08.000",
      "text": "ایچی ندارم یک بود و نفت رو جانا دارم"
    },
    {
      "id": 39,
      "start": 12433.0,
      "end": 12436.0,
      "formatted_start": "03:27:13.000",
      "formatted_end": "03:27:16.000",
      "text": "من یه ماه براتو دارو میدم؟"
    },
    {
      "id": 40,
