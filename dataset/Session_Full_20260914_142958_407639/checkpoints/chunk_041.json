    },
    {
      "id": 41,
      "start": 12442.0,
      "end": 12444.0,
      "formatted_start": "03:27:22.000",
      "formatted_end": "03:27:24.000",
      "text": "بگیدم چطور میشه"
    },
    {
      "id": 42,
      "start": 12444.0,
      "end": 12448.0,
      "formatted_start": "03:27:24.000",
      "formatted_end": "03:27:28.000",
