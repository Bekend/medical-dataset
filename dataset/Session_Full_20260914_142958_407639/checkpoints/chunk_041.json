  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12302.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:02.000",
      "text": "این کار سخت میشه."
    },
    {
      "id": 1,
      "start": 12302.0,
      "end": 12304.0,
      "formatted_start": "03:25:02.000",
      "formatted_end": "03:25:04.000",
      "text": "نه باید."
    },
    {
      "id": 2,
      "start": 12304.0,
      "end": 12306.0,
      "formatted_start": "03:25:04.000",
      "formatted_end": "03:25:06.000",
      "text": "دستگاه باید داشته باشید."
    },
    {
      "id": 3,
      "start": 12306.0,
      "end": 12308.0,
      "formatted_start": "03:25:06.000",
      "formatted_end": "03:25:08.000",
      "text": "دستگاه الانگرهانو نمیتونم، دندانو چه کسا نمیتونم."
    },
    {
      "id": 4,
      "start": 12308.0,
      "end": 12310.0,
      "formatted_start": "03:25:08.000",
      "formatted_end": "03:25:10.000",
      "text": "صلوص کنم."
    },
    {
      "id": 5,
      "start": 12310.0,
      "end": 12312.0,
      "formatted_start": "03:25:10.000",
      "formatted_end": "03:25:12.000",
      "text": "معرفتون کنیم."
    },
    {
      "id": 6,
      "start": 12312.0,
      "end": 12314.0,
      "formatted_start": "03:25:12.000",
      "formatted_end": "03:25:14.000",
      "text": "توانم نمیشه."
    },
    {
      "id": 7,
      "start": 12314.0,
      "end": 12316.0,
      "formatted_start": "03:25:14.000",
      "formatted_end": "03:25:16.000",
      "text": "یک کلین ایبا نمیتونه بگیر."
    },
    {
      "id": 8,
      "start": 12316.0,
      "end": 12318.0,
      "formatted_start": "03:25:16.000",
      "formatted_end": "03:25:18.000",
      "text": "اینکه باید برداریم."
    },
    {
      "id": 9,
      "start": 12318.0,
      "end": 12320.0,
      "formatted_start": "03:25:18.000",
      "formatted_end": "03:25:20.000",
      "text": "اینکه باید برداریم."
    },
    {
      "id": 10,
      "start": 12320.0,
      "end": 12322.0,
      "formatted_start": "03:25:20.000",
      "formatted_end": "03:25:22.000",
      "text": "اینکه باید برداریم."
    },
    {
      "id": 11,
      "start": 12322.0,
      "end": 12324.0,
      "formatted_start": "03:25:22.000",
      "formatted_end": "03:25:24.000",
      "text": "اینکه باید برداریم."
    },
    {
      "id": 12,
      "start": 12324.0,
      "end": 12326.0,
      "formatted_start": "03:25:24.000",
      "formatted_end": "03:25:26.000",
      "text": "اینکه باید برداریم."
    },
    {
      "id": 13,
      "start": 12326.0,
      "end": 12330.0,
      "formatted_start": "03:25:26.000",
      "formatted_end": "03:25:30.000",
      "text": "این کلینه ای برنه میتونه بگه"
    },
    {
      "id": 14,
      "start": 12330.0,
      "end": 12336.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:36.000",
      "text": "به رفتاری هم زیاد چرده خانم داد"
    },
    {
      "id": 15,
      "start": 12336.0,
      "end": 12354.0,
      "formatted_start": "03:25:36.000",
      "formatted_end": "03:25:54.000",
      "text": "من یک مسکن دیگه میگم شب اونو نخون همیشه"
    },
    {
      "id": 16,
      "start": 12354.0,
      "end": 12384.0,
      "formatted_start": "03:25:54.000",
      "formatted_end": "03:26:24.000",
