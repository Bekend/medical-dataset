  "stt_segments": [
    {
      "id": 0,
      "start": 20700.0,
      "end": 20702.0,
      "formatted_start": "05:45:00.000",
      "formatted_end": "05:45:02.000",
      "text": "این برس هم خیلی خوبه."
    },
    {
      "id": 1,
      "start": 20702.0,
      "end": 20704.0,
      "formatted_start": "05:45:02.000",
      "formatted_end": "05:45:04.000",
      "text": "بزرگمار کجاست؟"
    },
    {
      "id": 2,
      "start": 20704.0,
      "end": 20706.0,
      "formatted_start": "05:45:04.000",
      "formatted_end": "05:45:06.000",
      "text": "این شکل راضیه دیگه."
    },
    {
      "id": 3,
      "start": 20706.0,
      "end": 20708.0,
      "formatted_start": "05:45:06.000",
      "formatted_end": "05:45:08.000",
      "text": "نیست داروها نمیگنه."
    },
    {
      "id": 4,
      "start": 20708.0,
      "end": 20710.0,
      "formatted_start": "05:45:08.000",
      "formatted_end": "05:45:10.000",
      "text": "کارخونه راضیه که زن زدن."
    },
    {
      "id": 5,
      "start": 20710.0,
      "end": 20712.0,
      "formatted_start": "05:45:10.000",
      "formatted_end": "05:45:12.000",
      "text": "دیگه هم زدشت دیگه."
    },
    {
      "id": 6,
      "start": 20712.0,
      "end": 20714.0,
      "formatted_start": "05:45:12.000",
      "formatted_end": "05:45:14.000",
      "text": "آره، کارخونه راضیه که زن زدن."
    },
    {
      "id": 7,
      "start": 20714.0,
      "end": 20716.0,
      "formatted_start": "05:45:14.000",
      "formatted_end": "05:45:16.000",
      "text": "این برس هم اصلی که تو نویشتی نیسته."
    },
    {
      "id": 8,
      "start": 20716.0,
      "end": 20718.0,
      "formatted_start": "05:45:16.000",
      "formatted_end": "05:45:18.000",
      "text": "بله، خوب باز خوبه شرکل شعبه از شده."
    },
    {
      "id": 9,
      "start": 20718.0,
      "end": 20720.0,
      "formatted_start": "05:45:18.000",
      "formatted_end": "05:45:20.000",
      "text": "بله اینکه اصلا نمیتونم بخورم."
    },
    {
      "id": 10,
      "start": 20720.0,
      "end": 20722.0,
      "formatted_start": "05:45:20.000",
      "formatted_end": "05:45:22.000",
      "text": "میخورم تأثیر بخورم."
    },
    {
      "id": 11,
      "start": 20722.0,
      "end": 20727.24,
      "formatted_start": "05:45:22.000",
      "formatted_end": "05:45:27.240",
      "text": "این ورس هایی هم اصلی که تو نوشتی نیسته، بله خب باز خوبه شرکت شبه هست شده"
    },
    {
      "id": 12,
      "start": 20727.24,
      "end": 20730.56,
      "formatted_start": "05:45:27.240",
      "formatted_end": "05:45:30.560",
      "text": "بله اینکه اصلا نمیتونم بخورم، میخورم تاثیر نمیزنم"
    },
    {
      "id": 13,
      "start": 20730.56,
      "end": 20731.64,
      "formatted_start": "05:45:30.560",
      "formatted_end": "05:45:31.640",
      "text": "نصف کارخونه هم زنده هست"
    },
    {
      "id": 14,
      "start": 20731.64,
      "end": 20735.4,
      "formatted_start": "05:45:31.640",
      "formatted_end": "05:45:35.400",
      "text": "الان سه چهار شبه هستن، یه افتیم قد مفصل هم درمون داره"
    },
    {
      "id": 15,
      "start": 20735.4,
      "end": 20737.96,
      "formatted_start": "05:45:35.400",
      "formatted_end": "05:45:37.960",
      "text": "خب از ندارم، خب صوف و سالازه مت میساخت"
    },
    {
      "id": 16,
      "start": 20737.96,
      "end": 20742.4,
      "formatted_start": "05:45:37.960",
      "formatted_end": "05:45:42.400",
      "text": "قصص است، عرض نایفیه، گرده"
    },
    {
      "id": 17,
      "start": 20742.4,
      "end": 20743.28,
      "formatted_start": "05:45:42.400",
      "formatted_end": "05:45:43.280",
      "text": "مال چی آمد؟"
    },
    {
      "id": 18,
      "start": 20743.28,
      "end": 20746.04,
      "formatted_start": "05:45:43.280",
      "formatted_end": "05:45:46.040",
      "text": "من روماتیستیم، تا لازمانه خوردید میدم"
    },
    {
      "id": 19,
      "start": 20746.04,
      "end": 20751.04,
      "formatted_start": "05:45:46.040",
      "formatted_end": "05:45:51.040",
      "text": "اینجا از مورد یک زنگی نوزن بگیم اگه باید می سازم به جای این رو برچون کنم"
    },
    {
      "id": 20,
      "start": 20751.04,
      "end": 20754.04,
      "formatted_start": "05:45:51.040",
      "formatted_end": "05:45:54.040",
      "text": "اگه جایی خواره شده تا بعدی زخمی چیزی"
    },
    {
      "id": 21,
      "start": 20754.04,
      "end": 20757.04,
      "formatted_start": "05:45:54.040",
      "formatted_end": "05:45:57.040",
      "text": "پس این نماز ماشای قبلی منه یک نماز نگاه کنیم"
    },
    {
      "id": 22,
      "start": 20757.04,
      "end": 20761.04,
      "formatted_start": "05:45:57.040",
      "formatted_end": "05:46:01.040",
      "text": "خب اگه جای تر جایی مشکل باشی بیاییم بگم بگم باشم"
    },
    {
      "id": 23,
      "start": 20762.04,
      "end": 20767.04,
      "formatted_start": "05:46:02.040",
      "formatted_end": "05:46:07.040",
      "text": "حتی زاهیدان خوهرزاده می نرمیل گفتم نگاه که او کشتن در خانه خیلی نمی کنه"
    },
    {
      "id": 24,
      "start": 20767.04,
      "end": 20769.04,
      "formatted_start": "05:46:07.040",
      "formatted_end": "05:46:09.040",
      "text": "این کارخونه از کجا می کنی؟"
    },
    {
      "id": 25,
      "start": 20769.04,
      "end": 20771.04,
      "formatted_start": "05:46:09.040",
      "formatted_end": "05:46:11.040",
      "text": "آره نیست"
    },
    {
      "id": 26,
      "start": 20771.04,
      "end": 20773.04,
      "formatted_start": "05:46:11.040",
      "formatted_end": "05:46:13.040",
      "text": "چی؟"
    },
    {
      "id": 27,
      "start": 20773.04,
      "end": 20775.04,
      "formatted_start": "05:46:13.040",
      "formatted_end": "05:46:15.040",
      "text": "اینجا کمی چکنیم"
    },
    {
      "id": 28,
      "start": 20775.04,
      "end": 20777.04,
      "formatted_start": "05:46:15.040",
      "formatted_end": "05:46:17.040",
      "text": "اینجا کمی چکنیم"
    },
    {
      "id": 29,
      "start": 20777.04,
      "end": 20779.04,
      "formatted_start": "05:46:17.040",
      "formatted_end": "05:46:19.040",
      "text": "ازش چند؟"
    },
    {
      "id": 30,
      "start": 20779.04,
      "end": 20781.04,
      "formatted_start": "05:46:19.040",
      "formatted_end": "05:46:21.040",
      "text": "خب"
    },
    {
      "id": 31,
      "start": 20781.04,
      "end": 20783.04,
      "formatted_start": "05:46:21.040",
      "formatted_end": "05:46:23.040",
      "text": "خب"
    },
    {
      "id": 32,
      "start": 20783.04,
      "end": 20785.04,
      "formatted_start": "05:46:23.040",
      "formatted_end": "05:46:25.040",
      "text": "این مفصلان"
    },
    {
      "id": 33,
      "start": 20785.04,
      "end": 20787.04,
      "formatted_start": "05:46:25.040",
      "formatted_end": "05:46:27.040",
      "text": "افونت زیاد می کنید"
    },
    {
      "id": 34,
      "start": 20787.04,
      "end": 20789.04,
      "formatted_start": "05:46:27.040",
      "formatted_end": "05:46:29.040",
      "text": "از این چند ها می کنید؟"
    },
    {
      "id": 35,
      "start": 20789.04,
      "end": 20791.04,
      "formatted_start": "05:46:29.040",
      "formatted_end": "05:46:31.040",
      "text": "از این ها"
    },
    {
      "id": 36,
      "start": 20791.04,
      "end": 20793.04,
      "formatted_start": "05:46:31.040",
      "formatted_end": "05:46:33.040",
      "text": "از این ها"
    },
    {
      "id": 37,
      "start": 20793.04,
      "end": 20795.04,
      "formatted_start": "05:46:33.040",
      "formatted_end": "05:46:35.040",
      "text": "قبل از زمستان بود"
    },
    {
      "id": 38,
      "start": 20795.04,
      "end": 20797.04,
      "formatted_start": "05:46:35.040",
      "formatted_end": "05:46:37.040",
      "text": "این ها سوه و شب میخوردن"
    },
    {
      "id": 39,
      "start": 20797.04,
      "end": 20799.04,
      "formatted_start": "05:46:37.040",
      "formatted_end": "05:46:39.040",
      "text": "از این هم سوه و شب میخوردن"
    },
    {
      "id": 40,
      "start": 20799.04,
      "end": 20801.04,
      "formatted_start": "05:46:39.040",
      "formatted_end": "05:46:41.040",
      "text": "ولی الان از روز که این ها کم شده"
    },
    {
      "id": 41,
      "start": 20801.04,
      "end": 20803.04,
      "formatted_start": "05:46:41.040",
      "formatted_end": "05:46:43.040",
      "text": "دقیقه سه چهار روزی که میخورم"
    },
    {
      "id": 42,
      "start": 20803.04,
      "end": 20805.04,
      "formatted_start": "05:46:43.040",
      "formatted_end": "05:46:45.040",
      "text": "نه از این"
    },
    {
      "id": 43,
      "start": 20805.04,
      "end": 20807.04,
      "formatted_start": "05:46:45.040",
      "formatted_end": "05:46:47.040",
      "text": "از این چند تا میخورم"
    },
    {
      "id": 44,
      "start": 20807.04,
      "end": 20809.04,
      "formatted_start": "05:46:47.040",
      "formatted_end": "05:46:49.040",
      "text": "از این الان میخورم"
    },
    {
      "id": 45,
      "start": 20809.04,
      "end": 20811.04,
      "formatted_start": "05:46:49.040",
      "formatted_end": "05:46:51.040",
      "text": "یکو نسکی بشتر نخور"
    },
    {
      "id": 46,
      "start": 20811.04,
      "end": 20813.04,
      "formatted_start": "05:46:51.040",
      "formatted_end": "05:46:53.040",
      "text": "دوتا میخوریم"
    },
    {
      "id": 47,
      "start": 20813.04,
      "end": 20815.94,
      "formatted_start": "05:46:53.040",
      "formatted_end": "05:46:55.940",
      "text": "نه روزی که میخواید راحت هوا گرد شد روزی که میخواید"
    },
    {
      "id": 48,
      "start": 20815.94,
      "end": 20818.7,
      "formatted_start": "05:46:55.940",
      "formatted_end": "05:46:58.700",
      "text": "یکون زیر یکونسکی هم خواهیده نداره خب"
    },
    {
      "id": 49,
      "start": 20818.7,
      "end": 20821.68,
      "formatted_start": "05:46:58.700",
      "formatted_end": "05:47:01.680",
      "text": "اینگار که نمیخوایید یکونسکی بخوایید"
    },
    {
      "id": 50,
      "start": 20821.68,
      "end": 20822.74,
      "formatted_start": "05:47:01.680",
      "formatted_end": "05:47:02.740",
      "text": "روزی؟"
    },
    {
      "id": 51,
      "start": 20822.74,
      "end": 20823.02,
      "formatted_start": "05:47:02.740",
      "formatted_end": "05:47:03.020",
      "text": "آره"
    },
    {
      "id": 52,
      "start": 20823.02,
      "end": 20826.44,
      "formatted_start": "05:47:03.020",
      "formatted_end": "05:47:06.440",
      "text": "حتی یکی شب بخوایید نسبت آره بخوایید"
    },
    {
      "id": 53,
      "start": 20826.44,
      "end": 20829.28,
      "formatted_start": "05:47:06.440",
      "formatted_end": "05:47:09.280",
      "text": "آره ولی ما دوست هم نداریم زیاد توتا بخوایید"
    },
    {
      "id": 54,
      "start": 20829.28,
      "end": 20831.22,
      "formatted_start": "05:47:09.280",
      "formatted_end": "05:47:11.220",
      "text": "بهترین عددش یکونسکی هست"
    },
    {
      "id": 55,
      "start": 20831.22,
      "end": 20833.96,
      "formatted_start": "05:47:11.220",
      "formatted_end": "05:47:13.960",
      "text": "نظرم از این که خیلی سردرد زیاد داشتن میخوایید"
    },
    {
      "id": 56,
      "start": 20833.96,
      "end": 20834.4,
      "formatted_start": "05:47:13.960",
      "formatted_end": "05:47:14.400",
      "text": "از این جانه"
    },
    {
      "id": 57,
      "start": 20834.4,
      "end": 20841.4,
      "formatted_start": "05:47:14.400",
      "formatted_end": "05:47:21.400",
      "text": "اگر اینجا باید جواب دهید، اگر جواب دهید، خوب به اون پیدا میشه."
    },
    {
      "id": 58,
      "start": 20841.4,
      "end": 20848.4,
      "formatted_start": "05:47:21.400",
      "formatted_end": "05:47:28.400",
      "text": "بعد این مفصل هم نمیشه، خب یک طور آمپول برمیسی و خوش کنید، مفصل ها رو یک مدت باید بیتر باشید."
    },
    {
      "id": 59,
      "start": 20848.4,
      "end": 20850.4,
      "formatted_start": "05:47:28.400",
      "formatted_end": "05:47:30.400",
      "text": "چرا؟ از یک کمی نمیستم."
    },
    {
      "id": 60,
      "start": 20850.4,
      "end": 20854.4,
      "formatted_start": "05:47:30.400",
      "formatted_end": "05:47:34.400",
      "text": "مثلا تو سرون برزه خوش کنید، چند تا استفاده کنید؟"
    },
    {
      "id": 61,
      "start": 20854.4,
      "end": 20861.4,
      "formatted_start": "05:47:34.400",
      "formatted_end": "05:47:41.400",
      "text": "نشکاکه نیست، آمپول. این آمپول رو در واقع ستلتها بودید، بعد پرتونه دیگه، این رو پوکت می کنه."
    },
    {
      "id": 62,
      "start": 20864.4,
      "end": 20894.4,
      "formatted_start": "05:47:44.400",
      "formatted_end": "05:48:14.400",
      "text": "اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینجوری اینج"
    },
    {
      "id": 63,
      "start": 20894.4,
      "end": 20896.4,
      "formatted_start": "05:48:14.400",
      "formatted_end": "05:48:16.400",
      "text": "اینجا باید ایرانی برسم بیمنده خورنه کنم"
    },
    {
      "id": 64,
      "start": 20896.4,
      "end": 20898.4,
      "formatted_start": "05:48:16.400",
      "formatted_end": "05:48:18.400",
      "text": "اون تا ایرانی بیمنم"
    },
    {
      "id": 65,
      "start": 20898.4,
      "end": 20900.4,
      "formatted_start": "05:48:18.400",
      "formatted_end": "05:48:20.400",
      "text": "این ایرانی نیستن نگه؟"
    },
    {
      "id": 66,
      "start": 20900.4,
      "end": 20902.4,
      "formatted_start": "05:48:20.400",
      "formatted_end": "05:48:22.400",
      "text": "نه اون خارجه"
    },
    {
      "id": 67,
      "start": 20902.4,
      "end": 20904.4,
      "formatted_start": "05:48:22.400",
      "formatted_end": "05:48:24.400",
      "text": "آمان"
    },
    {
      "id": 68,
      "start": 20904.4,
      "end": 20906.4,
      "formatted_start": "05:48:24.400",
      "formatted_end": "05:48:26.400",
      "text": "حالا یه دوره نیست"
    },
    {
      "id": 69,
      "start": 20906.4,
      "end": 20908.4,
      "formatted_start": "05:48:26.400",
      "formatted_end": "05:48:28.400",
      "text": "یه دوره نیست"
    },
    {
      "id": 70,
      "start": 20908.4,
      "end": 20910.4,
      "formatted_start": "05:48:28.400",
      "formatted_end": "05:48:30.400",
      "text": "دیگه برگاه بکنه"
    },
    {
      "id": 71,
      "start": 20910.4,
      "end": 20912.4,
      "formatted_start": "05:48:30.400",
      "formatted_end": "05:48:32.400",
      "text": "می کنه آزاده دیگه خورنه"
    },
    {
      "id": 72,
      "start": 20912.4,
      "end": 20914.4,
      "formatted_start": "05:48:32.400",
      "formatted_end": "05:48:34.400",
      "text": "چرا آزاده دیگه؟"
    },
    {
      "id": 73,
      "start": 20914.4,
      "end": 20916.4,
      "formatted_start": "05:48:34.400",
      "formatted_end": "05:48:36.400",
      "text": "یه وقت دیگه آنه بزرگ"
    },
    {
      "id": 74,
      "start": 20916.4,
      "end": 20918.4,
      "formatted_start": "05:48:36.400",
      "formatted_end": "05:48:38.400",
      "text": "اصلا فرننه برمنده بر خوهرم خودم"
    },
    {
      "id": 75,
      "start": 20918.4,
      "end": 20920.4,
      "formatted_start": "05:48:38.400",
      "formatted_end": "05:48:40.400",
      "text": "می برسم فرمشه ایرانی برسم"
    },
    {
      "id": 76,
      "start": 20920.4,
      "end": 20922.4,
      "formatted_start": "05:48:40.400",
      "formatted_end": "05:48:42.400",
      "text": "بهش می سازه خیلی"
    },
    {
      "id": 77,
      "start": 20922.4,
      "end": 20927.4,
      "formatted_start": "05:48:42.400",
      "formatted_end": "05:48:47.400",
      "text": "چربی روز دوتا میخورم از غند روز دوتا میخورم"
    },
    {
      "id": 78,
      "start": 20927.4,
      "end": 20930.4,
      "formatted_start": "05:48:47.400",
      "formatted_end": "05:48:50.400",
      "text": "اون رو که دوست دا سه ماهه می نویسم"
    },
    {
      "id": 79,
      "start": 20930.4,
      "end": 20932.4,
      "formatted_start": "05:48:50.400",
      "formatted_end": "05:48:52.400",
      "text": "که داشته باشید"
    },
    {
      "id": 80,
      "start": 20932.4,
      "end": 20933.4,
      "formatted_start": "05:48:52.400",
      "formatted_end": "05:48:53.400",
      "text": "آه تایید نکرده"
    },
    {
      "id": 81,
      "start": 20933.4,
      "end": 20937.4,
      "formatted_start": "05:48:53.400",
      "formatted_end": "05:48:57.400",
      "text": "اگر غند اگر بیترش هست خارجیش هست بیترش برام بینیسی خیلی بیترست"
    },
    {
      "id": 82,
      "start": 20937.4,
      "end": 20940.4,
      "formatted_start": "05:48:57.400",
      "formatted_end": "05:49:00.400",
      "text": "این که ازم تایید نکرده سه ماه دو ماه تایید کرده"
    },
    {
      "id": 83,
      "start": 20940.4,
      "end": 20943.4,
      "formatted_start": "05:49:00.400",
      "formatted_end": "05:49:03.400",
      "text": "غند خارجشون قیمه نمیخورد"
    },
    {
      "id": 84,
      "start": 20943.4,
      "end": 20944.4,
      "formatted_start": "05:49:03.400",
      "formatted_end": "05:49:04.400",
      "text": "نداره"
    },
    {
      "id": 85,
      "start": 20944.4,
      "end": 20945.4,
      "formatted_start": "05:49:04.400",
      "formatted_end": "05:49:05.400",
      "text": "آه"
    },
    {
      "id": 86,
      "start": 20945.4,
      "end": 20947.4,
      "formatted_start": "05:49:05.400",
      "formatted_end": "05:49:07.400",
      "text": "نه ازم بینیس بسیار"
    },
    {
      "id": 87,
      "start": 20947.4,
      "end": 20949.4,
      "formatted_start": "05:49:07.400",
      "formatted_end": "05:49:09.400",
      "text": "اگر شرکت بیتری هست بینیس"
    },
    {
      "id": 88,
      "start": 20949.4,
      "end": 20953.4,
      "formatted_start": "05:49:09.400",
      "formatted_end": "05:49:13.400",
      "text": "شرکت ها که خود میدونید دست ما نیست و از بیمه نمیدونید"
    },
    {
      "id": 89,
      "start": 20953.4,
      "end": 20958.4,
      "formatted_start": "05:49:13.400",
      "formatted_end": "05:49:18.400",
      "text": "ولی خارجی هست که باز بیمه نمیخواد"
    },
    {
      "id": 90,
      "start": 20961.4,
      "end": 20964.4,
      "formatted_start": "05:49:21.400",
      "formatted_end": "05:49:24.400",
      "text": "میگه آن خارجی هاش میگه برای کلی زرد نداره؟"
    },
    {
      "id": 91,
      "start": 20964.4,
      "end": 20967.4,
      "formatted_start": "05:49:24.400",
      "formatted_end": "05:49:27.400",
      "text": "هیچ فرق نمیدونید کلی همه چه هر فرقه"
    },
    {
      "id": 92,
      "start": 20967.4,
      "end": 20970.4,
      "formatted_start": "05:49:27.400",
      "formatted_end": "05:49:30.400",
      "text": "خارجی هاش آهسته تو خون باز میشه"
    },
    {
      "id": 93,
      "start": 20970.4,
      "end": 20973.4,
      "formatted_start": "05:49:30.400",
      "formatted_end": "05:49:33.400",
      "text": "یه دفعه میشه ممکنه یکم تا هم بوده هم"
    },
    {
      "id": 94,
      "start": 20973.4,
      "end": 20975.4,
      "formatted_start": "05:49:33.400",
      "formatted_end": "05:49:35.400",
      "text": "هیچ فرقی توی اصل نمیدونید"
    },
    {
      "id": 95,
      "start": 20975.4,
      "end": 20977.4,
      "formatted_start": "05:49:35.400",
      "formatted_end": "05:49:37.400",
      "text": "نه پیاده نبی میرن بیتر آنها"
    },
    {
      "id": 96,
      "start": 20977.4,
      "end": 20979.4,
      "formatted_start": "05:49:37.400",
      "formatted_end": "05:49:39.400",
      "text": "اینو با من چیزا حق باید مدتونه دهیم"
    },
    {
      "id": 97,
      "start": 20979.4,
      "end": 20981.4,
      "formatted_start": "05:49:39.400",
      "formatted_end": "05:49:41.400",
      "text": "اینو می نویسم برای تو"
    },
    {
      "id": 98,
      "start": 20981.4,
      "end": 20983.4,
      "formatted_start": "05:49:41.400",
      "formatted_end": "05:49:43.400",
      "text": "خب به دارو خونه اک دو نگاه کردم"
    },
    {
      "id": 99,
      "start": 20983.4,
      "end": 20985.4,
      "formatted_start": "05:49:43.400",
      "formatted_end": "05:49:45.400",
      "text": "نگاه باشم شاید یه وقت دیدی پیدا شدم"
    },
    {
      "id": 100,
      "start": 20985.4,
      "end": 20987.4,
      "formatted_start": "05:49:45.400",
      "formatted_end": "05:49:47.400",
      "text": "اگه دیدی از اینو بگو نمی خواهم"
    },
    {
      "id": 101,
      "start": 20987.4,
      "end": 20989.4,
      "formatted_start": "05:49:47.400",
      "formatted_end": "05:49:49.400",
      "text": "خب؟"
    },
    {
      "id": 102,
      "start": 20989.4,
      "end": 20991.4,
      "formatted_start": "05:49:49.400",
      "formatted_end": "05:49:51.400",
      "text": "یه وقت دیدی اونو یکی پیدا میکنم"
    },
    {
      "id": 103,
      "start": 20991.4,
      "end": 20993.4,
      "formatted_start": "05:49:51.400",
      "formatted_end": "05:49:53.400",
      "text": "اونو نوشتم برای تو"
    },
    {
      "id": 104,
      "start": 20993.4,
      "end": 20995.4,
      "formatted_start": "05:49:53.400",
      "formatted_end": "05:49:55.400",
      "text": "یعنی یه دو سال سی سال"
    },
    {
      "id": 105,
      "start": 20995.4,
      "end": 20997.4,
      "formatted_start": "05:49:55.400",
      "formatted_end": "05:49:57.400",
      "text": "می خواهم به خود"
    },
    {
      "id": 106,
      "start": 20997.4,
      "end": 20999.4,
      "formatted_start": "05:49:57.400",
      "formatted_end": "05:49:59.400",
      "text": "هر وقت می خواهم برامش برای دارو"
    },
    {
      "id": 107,
      "start": 20999.4,
      "end": 21001.4,
      "formatted_start": "05:49:59.400",
      "formatted_end": "05:50:01.400",
      "text": "نمی خواهم برای دارو"
    }
  ],
  "status": "completed"
}