    {
      "id": 0,
      "start": 22200.0,
      "end": 22230.0,
      "formatted_start": "06:10:00.000",
      "formatted_end": "06:10:30.000",
      "text": "از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم که از اینجا باید بگم"
    },
    {
      "id": 1,
      "start": 22230.0,
      "end": 22233.0,
      "formatted_start": "06:10:30.000",
      "formatted_end": "06:10:33.000",
      "text": "باید باید بزرگرد مادر باشیم"
    },
    {
      "id": 2,
      "start": 22233.0,
      "end": 22236.0,
      "formatted_start": "06:10:33.000",
      "formatted_end": "06:10:36.000",
      "text": "آهان بزرگرد باشیم، باز خودتون میدازیم"
    },
    {
      "id": 3,
      "start": 22236.0,
      "end": 22240.0,
      "formatted_start": "06:10:36.000",
      "formatted_end": "06:10:40.000",
      "text": "مگرم دیگه، ما بگویم دیگه مثلا هفتاد، افتاد در سه سال ما"
    },
    {
      "id": 4,
      "start": 22240.0,
      "end": 22242.0,
      "formatted_start": "06:10:40.000",
      "formatted_end": "06:10:42.000",
      "text": "خواهی خوب باشه، خیلی رزینه"
    },
    {
      "id": 5,
      "start": 22242.0,
      "end": 22245.0,
      "formatted_start": "06:10:42.000",
      "formatted_end": "06:10:45.000",
      "text": "هفتاد و هشت یا ما شروع باد، تمسی چهار سال شروع باشیم"
    },
    {
      "id": 6,
      "start": 22245.0,
      "end": 22248.0,
      "formatted_start": "06:10:45.000",
      "formatted_end": "06:10:48.000",
      "text": "نه مادرم، من بخوادم محکم صبات ندارم بذارم"
    },
    {
      "id": 7,
      "start": 22248.0,
      "end": 22250.0,
      "formatted_start": "06:10:48.000",
      "formatted_end": "06:10:50.000",
      "text": "انشاله که سه رو بیست سال باشیم"
    },
    {
      "id": 8,
      "start": 22250.0,
      "end": 22254.34,
      "formatted_start": "06:10:50.000",
      "formatted_end": "06:10:54.340",
      "text": "دست شما درد نکنه خدا همه بندگان خدا را سلامت باشه"
    },
    {
      "id": 9,
      "start": 22254.34,
      "end": 22257.88,
      "formatted_start": "06:10:54.340",
      "formatted_end": "06:10:57.880",
      "text": "شیعه علی مریض نباشه گرفته و نشید"
    },
    {
      "id": 10,
      "start": 22257.88,
      "end": 22259.98,
      "formatted_start": "06:10:57.880",
      "formatted_end": "06:10:59.980",
      "text": "توانه با ما نبهقه بشده"
    },
    {
      "id": 11,
      "start": 22259.98,
      "end": 22263.84,
      "formatted_start": "06:10:59.980",
      "formatted_end": "06:11:03.840",
      "text": "نه برده اون کنم میبنم اون دولت خود سرخون"
    },
    {
      "id": 12,
      "start": 22263.84,
      "end": 22266.8,
      "formatted_start": "06:11:03.840",
      "formatted_end": "06:11:06.800",
      "text": "اما خواه شکر خدا از این چیزان نباشه"
    },
    {
      "id": 13,
      "start": 22266.8,
      "end": 22270.04,
      "formatted_start": "06:11:06.800",
      "formatted_end": "06:11:10.040",
      "text": "اصلا از کلیه این بود"
    },
    {
      "id": 14,
      "start": 22270.04,
      "end": 22272.72,
      "formatted_start": "06:11:10.040",
      "formatted_end": "06:11:12.720",
      "text": "همه خوبه مادر جا"
    },
    {
      "id": 15,
      "start": 22272.72,
      "end": 22274.72,
      "formatted_start": "06:11:12.720",
      "formatted_end": "06:11:14.720",
      "text": "فقط کمخونی عزیز"
    },
    {
      "id": 16,
      "start": 22274.72,
      "end": 22276.02,
      "formatted_start": "06:11:14.720",
      "formatted_end": "06:11:16.020",
      "text": "هیچی دیگه نیست"
    },
    {
      "id": 17,
      "start": 22276.02,
      "end": 22278.52,
      "formatted_start": "06:11:16.020",
      "formatted_end": "06:11:18.520",
      "text": "قصه ها هنتونم مینویستم خب"
    },
    {
      "id": 18,
      "start": 22278.52,
      "end": 22279.02,
      "formatted_start": "06:11:18.520",
      "formatted_end": "06:11:19.020",
      "text": "آره"
    },
    {
      "id": 19,
      "start": 22279.56,
      "end": 22282.76,
      "formatted_start": "06:11:19.560",
      "formatted_end": "06:11:22.760",
      "text": "یک شب درمیان بخور که شکمت صف نشه"
    },
    {
      "id": 20,
      "start": 22282.76,
      "end": 22285.6,
      "formatted_start": "06:11:22.760",
      "formatted_end": "06:11:25.600",
      "text": "شبها موقع خواب بخورین با یک لیوان آب"
    },
    {
      "id": 21,
      "start": 22285.6,
      "end": 22286.8,
      "formatted_start": "06:11:25.600",
      "formatted_end": "06:11:26.800",
      "text": "آب گند"
    },
    {
      "id": 22,
      "start": 22287.4,
      "end": 22289.4,
      "formatted_start": "06:11:27.400",
      "formatted_end": "06:11:29.400",
      "text": "بله همه دیگه آره"
    },
    {
      "id": 23,
      "start": 22289.88,
      "end": 22293.84,
      "formatted_start": "06:11:29.880",
      "formatted_end": "06:11:33.840",
      "text": "تموم شد بچه ها رو بگی دو بار دیگه از روش برات بخرن"
    },
    {
      "id": 24,
      "start": 22294.6,
      "end": 22295.8,
      "formatted_start": "06:11:34.600",
      "formatted_end": "06:11:35.800",
      "text": "از چی؟ از اون؟"
    },
    {
      "id": 25,
      "start": 22295.8,
      "end": 22298.88,
      "formatted_start": "06:11:35.800",
      "formatted_end": "06:11:38.880",
      "text": "از آهنگ دو بار دیگه بچه ها جوهش بخرن"
    },
    {
      "id": 26,
      "start": 22298.88,
      "end": 22299.52,
      "formatted_start": "06:11:38.880",
      "formatted_end": "06:11:39.520",
      "text": "خب؟"
    },
    {
      "id": 27,
      "start": 22299.52,
      "end": 22302.6,
      "formatted_start": "06:11:39.520",
      "formatted_end": "06:11:42.600",
      "text": "بر هر کشت هم با اون باشه ده دفع دیگر هم بخرن"
    },
    {
      "id": 28,
      "start": 22302.6,
      "end": 22303.88,
      "formatted_start": "06:11:42.600",
      "formatted_end": "06:11:43.880",
      "text": "نه بسته دیگه"
    },
    {
      "id": 29,
      "start": 22303.88,
      "end": 22304.84,
      "formatted_start": "06:11:43.880",
      "formatted_end": "06:11:44.840",
      "text": "نه واقعا"
    },
    {
      "id": 30,
      "start": 22304.84,
      "end": 22307.94,
      "formatted_start": "06:11:44.840",
      "formatted_end": "06:11:47.940",
      "text": "ایمانو بگن امی خوب باشه خدا بابا از خوش آن"
    },
    {
      "id": 31,
      "start": 22307.94,
      "end": 22309.64,
      "formatted_start": "06:11:47.940",
      "formatted_end": "06:11:49.640",
      "text": "من ره بیاره نه نشدیم"
    },
    {
      "id": 32,
      "start": 22309.64,
      "end": 22311.72,
      "formatted_start": "06:11:49.640",
      "formatted_end": "06:11:51.720",
      "text": "بگن میبه جاها تا دنیا رو میاره میکنم"
    },
    {
      "id": 33,
      "start": 22311.72,
      "end": 22312.88,
      "formatted_start": "06:11:51.720",
      "formatted_end": "06:11:52.880",
      "text": "کنم دورت بگم"
    },
    {
      "id": 34,
      "start": 22312.88,
      "end": 22315.08,
      "formatted_start": "06:11:52.880",
      "formatted_end": "06:11:55.080",
      "text": "بگم تو بچه تا کسو باید میکنی"
    },
    {
      "id": 35,
      "start": 22315.08,
      "end": 22317.08,
      "formatted_start": "06:11:55.080",
      "formatted_end": "06:11:57.080",
      "text": "بگه خوش میشه دردانت"
    },
    {
      "id": 36,
      "start": 22317.08,
      "end": 22319.08,
      "formatted_start": "06:11:57.080",
      "formatted_end": "06:11:59.080",
      "text": "گفتم همینه نمیدونم خودم"
    },
    {
      "id": 37,
      "start": 22319.08,
      "end": 22321.68,
      "formatted_start": "06:11:59.080",
      "formatted_end": "06:12:01.680",
      "text": "پا هم از اینجا در ساویت کرد"
    },
    {
      "id": 38,
      "start": 22321.68,
      "end": 22323.88,
      "formatted_start": "06:12:01.680",
      "formatted_end": "06:12:03.880",
      "text": "از اون میریم بگم بوی چقدر"
    },
    {
      "id": 39,
      "start": 22323.88,
      "end": 22326.84,
      "formatted_start": "06:12:03.880",
      "formatted_end": "06:12:06.840",
      "text": "حال آهنگتون بهتر بشه سرحالتر میشه خود"
    },
    {
      "id": 40,
      "start": 22326.84,
      "end": 22328.04,
      "formatted_start": "06:12:06.840",
      "formatted_end": "06:12:08.040",
      "text": "دستشی خواهد داریم"
    },
    {
      "id": 41,
      "start": 22328.04,
      "end": 22330.04,
      "formatted_start": "06:12:08.040",
      "formatted_end": "06:12:10.040",
      "text": "سلامت باشیم"
    },
    {
      "id": 42,
      "start": 22330.04,
      "end": 22334.04,
      "formatted_start": "06:12:10.040",
      "formatted_end": "06:12:14.040",
      "text": "شکر خدا و همه تو ما خشان شدیم با لطف خدا"
    },
    {
      "id": 43,
      "start": 22334.04,
      "end": 22336.04,
      "formatted_start": "06:12:14.040",
      "formatted_end": "06:12:16.040",
      "text": "همه خشان باشن با دوچن هم شما"
    },
    {
      "id": 44,
      "start": 22336.04,
      "end": 22338.04,
      "formatted_start": "06:12:16.040",
      "formatted_end": "06:12:18.040",
      "text": "سلامت باشیم"
    },
    {
      "id": 45,
      "start": 22338.04,
      "end": 22342.04,
      "formatted_start": "06:12:18.040",
      "formatted_end": "06:12:22.040",
      "text": "دارو خانه داره دیگه نیست در بلد درد"
    },
    {
      "id": 46,
      "start": 22342.04,
      "end": 22344.04,
      "formatted_start": "06:12:22.040",
      "formatted_end": "06:12:24.040",
      "text": "نه نه نشان باشیم"
    },
    {
      "id": 47,
      "start": 22344.04,
      "end": 22346.04,
      "formatted_start": "06:12:24.040",
      "formatted_end": "06:12:26.040",
      "text": "نه از اینجا بخور ساهم"
    },
    {
      "id": 48,
      "start": 22346.04,
      "end": 22348.04,
      "formatted_start": "06:12:26.040",
      "formatted_end": "06:12:28.040",
      "text": "شاهم در این موقع خواب"
    },
    {
      "id": 49,
      "start": 22348.04,
      "end": 22350.04,
      "formatted_start": "06:12:28.040",
      "formatted_end": "06:12:30.040",
      "text": "بعد اینجا دو بار دیگه هم دارو شد"
    },
    {
      "id": 50,
      "start": 22350.04,
      "end": 22352.04,
      "formatted_start": "06:12:30.040",
      "formatted_end": "06:12:32.040",
      "text": "بگیر بعدن هفته ی دوتا رو بخورن"
    },
    {
      "id": 51,
      "start": 22352.04,
      "end": 22354.04,
      "formatted_start": "06:12:32.040",
      "formatted_end": "06:12:34.040",
      "text": "چون دیگه لازمه تا افراد مستانه"
    },
    {
      "id": 52,
      "start": 22354.04,
      "end": 22356.04,
      "formatted_start": "06:12:34.040",
      "formatted_end": "06:12:36.040",
      "text": "بعد باز کمخون نشه"
    },
    {
      "id": 53,
      "start": 22356.04,
      "end": 22364.04,
      "formatted_start": "06:12:36.040",
      "formatted_end": "06:12:44.040",
      "text": "اول روز اول بودن قرص ها خیلی بودن خانه هم خیلی دارن برای پیش بازه"
    },
    {
      "id": 54,
      "start": 22364.04,
      "end": 22367.04,
      "formatted_start": "06:12:44.040",
      "formatted_end": "06:12:47.040",
      "text": "اسکل و فشار و همچین قرص ها رو خوردی برن"
    },
    {
      "id": 55,
      "start": 22367.04,
      "end": 22370.04,
      "formatted_start": "06:12:47.040",
      "formatted_end": "06:12:50.040",
      "text": "یکم برفتم لک کردی از دست مال بکشم دید"
    },
    {
      "id": 56,
      "start": 22370.04,
      "end": 22374.04,
      "formatted_start": "06:12:50.040",
      "formatted_end": "06:12:54.040",
      "text": "آمدیم خانم بودی اول دلم از نمیت گفت دستم رو بودم"
    },
    {
      "id": 57,
      "start": 22374.04,
      "end": 22378.04,
      "formatted_start": "06:12:54.040",
      "formatted_end": "06:12:58.040",
      "text": "خودم هلی ورچ هم بودن یعنی اینجا بودن بارشون هر روز خدا واسه هم نخوادی"
    },
    {
      "id": 58,
      "start": 22378.04,
      "end": 22380.04,
      "formatted_start": "06:12:58.040",
      "formatted_end": "06:13:00.040",
      "text": "در قبل دراز و کشی هم"
    },
    {
      "id": 59,
      "start": 22380.04,
      "end": 22381.04,
      "formatted_start": "06:13:00.040",
      "formatted_end": "06:13:01.040",
      "text": "خدا نکنه"
    },
    {
      "id": 60,
      "start": 22381.04,
      "end": 22383.04,
      "formatted_start": "06:13:01.040",
      "formatted_end": "06:13:03.040",
      "text": "خدا خانم دکتر عزیز"
    },
    {
      "id": 61,
      "start": 22383.04,
      "end": 22387.2,
      "formatted_start": "06:13:03.040",
      "formatted_end": "06:13:07.200",
      "text": "گفتیم خدا جا نلش کرده این بچه روز مره از سر کل شد"
    },
    {
      "id": 62,
      "start": 22387.2,
      "end": 22390.26,
      "formatted_start": "06:13:07.200",
      "formatted_end": "06:13:10.260",
      "text": "نه انشالله که سرمیستانه باشید"
    },
    {
      "id": 63,
      "start": 22390.26,
      "end": 22392.44,
      "formatted_start": "06:13:10.260",
      "formatted_end": "06:13:12.440",
      "text": "سرمیستانه باشه انشالله"
    },
    {
      "id": 64,
      "start": 22392.44,
      "end": 22396.36,
      "formatted_start": "06:13:12.440",
      "formatted_end": "06:13:16.360",
      "text": "هر محل که خوب بخوشه انشالله به دیدن و بخوبی بگیر"
    },
    {
      "id": 65,
      "start": 22396.36,
      "end": 22398.9,
      "formatted_start": "06:13:16.360",
      "formatted_end": "06:13:18.900",
      "text": "سرمت باشه انشالله همیشه سرمیستانه باشه"
    },
    {
      "id": 66,
      "start": 22398.9,
      "end": 22401.04,
      "formatted_start": "06:13:18.900",
      "formatted_end": "06:13:21.040",
      "text": "خدا خود مادر جاییم"
    },
    {
      "id": 67,
      "start": 22401.04,
      "end": 22403.04,
      "formatted_start": "06:13:21.040",
      "formatted_end": "06:13:23.040",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 68,
      "start": 22403.04,
      "end": 22405.04,
      "formatted_start": "06:13:23.040",
      "formatted_end": "06:13:25.040",
      "text": "باید بردارید."
    },
    {
      "id": 69,
      "start": 22405.04,
      "end": 22407.04,
      "formatted_start": "06:13:25.040",
      "formatted_end": "06:13:27.040",
      "text": "باید بردارید."
    },
    {
      "id": 70,
      "start": 22407.04,
      "end": 22409.04,
      "formatted_start": "06:13:27.040",
      "formatted_end": "06:13:29.040",
      "text": "باید بردارید."
    },
    {
      "id": 71,
      "start": 22409.04,
      "end": 22411.04,
      "formatted_start": "06:13:29.040",
      "formatted_end": "06:13:31.040",
      "text": "باید بردارید."
    },
    {
      "id": 72,
      "start": 22411.04,
      "end": 22413.04,
      "formatted_start": "06:13:31.040",
      "formatted_end": "06:13:33.040",
      "text": "باید بردارید."
    },
    {
      "id": 73,
      "start": 22413.04,
      "end": 22415.04,
      "formatted_start": "06:13:33.040",
      "formatted_end": "06:13:35.040",
      "text": "باید بردارید."
    },
    {
      "id": 74,
      "start": 22415.04,
      "end": 22417.04,
      "formatted_start": "06:13:35.040",
      "formatted_end": "06:13:37.040",
      "text": "باید بردارید."
    },
    {
      "id": 75,
      "start": 22417.04,
      "end": 22419.04,
      "formatted_start": "06:13:37.040",
      "formatted_end": "06:13:39.040",
      "text": "باید بردارید."
    },
    {
      "id": 76,
      "start": 22419.04,
      "end": 22421.04,
      "formatted_start": "06:13:39.040",
      "formatted_end": "06:13:41.040",
      "text": "باید بردارید."
    },
    {
      "id": 77,
      "start": 22421.04,
      "end": 22423.04,
      "formatted_start": "06:13:41.040",
      "formatted_end": "06:13:43.040",
      "text": "باید بردارید."
    },
    {
      "id": 78,
      "start": 22423.04,
      "end": 22425.04,
      "formatted_start": "06:13:43.040",
      "formatted_end": "06:13:45.040",
      "text": "باید بردارید."
    },
    {
      "id": 79,
      "start": 22425.04,
      "end": 22427.04,
      "formatted_start": "06:13:45.040",
      "formatted_end": "06:13:47.040",
      "text": "باید بردارید."
    },
    {
      "id": 80,
      "start": 22427.04,
      "end": 22429.04,
      "formatted_start": "06:13:47.040",
      "formatted_end": "06:13:49.040",
      "text": "باید بردارید."
    },
    {
      "id": 81,
      "start": 22429.04,
      "end": 22431.04,
      "formatted_start": "06:13:49.040",
      "formatted_end": "06:13:51.040",
      "text": "موسیقی"
    },
    {
      "id": 82,
      "start": 22459.04,
      "end": 22463.04,
      "formatted_start": "06:14:19.040",
      "formatted_end": "06:14:23.040",
      "text": "قندتون خوبه"
    },
    {
      "id": 83,
      "start": 22463.04,
      "end": 22467.04,
      "formatted_start": "06:14:23.040",
      "formatted_end": "06:14:27.040",
      "text": "چربیتی زیادی بالاست"
    },
    {
      "id": 84,
