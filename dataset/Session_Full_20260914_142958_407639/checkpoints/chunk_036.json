  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10806.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:06.000",
      "text": "این بازه خیلی بیشتر است. از این بازه همین قیمت شده است."
    },
    {
      "id": 1,
      "start": 10806.0,
      "end": 10807.0,
      "formatted_start": "03:00:06.000",
      "formatted_end": "03:00:07.000",
      "text": "این بازه خیلی بیشتر است. از این بازه همین قیمت شده است. این بازه خیلی بیشتر است."
    },
    {
      "id": 2,
      "start": 10807.0,
      "end": 10812.0,
      "formatted_start": "03:00:07.000",
      "formatted_end": "03:00:12.000",
      "text": "این یک درگاه اومده که کنری با هر سی تا شکل نداریم دوست داریم"
    },
    {
      "id": 3,
      "start": 10812.0,
      "end": 10815.0,
      "formatted_start": "03:00:12.000",
      "formatted_end": "03:00:15.000",
      "text": "شدید هم دفع پرتینو یاد بکنیم"
    },
    {
      "id": 4,
      "start": 10815.0,
      "end": 10819.0,
      "formatted_start": "03:00:15.000",
      "formatted_end": "03:00:19.000",
      "text": "خیلی داریم بکنیم، فیلنان نبیستیم"
    },
    {
      "id": 5,
      "start": 10821.0,
      "end": 10822.0,
      "formatted_start": "03:00:21.000",
      "formatted_end": "03:00:22.000",
      "text": "بیمه پوشش نداری؟"
    },
    {
      "id": 6,
      "start": 10822.0,
      "end": 10826.0,
      "formatted_start": "03:00:22.000",
      "formatted_end": "03:00:26.000",
      "text": "اصلاً کلن پوشش بیمه نداریم، کلن توی شما"
    },
    {
      "id": 7,
      "start": 10827.0,
      "end": 10831.0,
      "formatted_start": "03:00:27.000",
      "formatted_end": "03:00:31.000",
      "text": "اونو مثلاً بگیری، ماهی دیگه بودید یک افراد نگیشه"
    },
    {
      "id": 8,
      "start": 10832.0,
      "end": 10835.0,
      "formatted_start": "03:00:32.000",
      "formatted_end": "03:00:35.000",
      "text": "اون خیلی دفع پرتینو کنترال می کنیم"
    },
    {
      "id": 9,
      "start": 10837.0,
      "end": 10839.0,
      "formatted_start": "03:00:37.000",
      "formatted_end": "03:00:39.000",
      "text": "میدت هم عذیب نمی کنه"
    },
    {
      "id": 10,
      "start": 10839.0,
      "end": 10842.0,
      "formatted_start": "03:00:39.000",
      "formatted_end": "03:00:42.000",
      "text": "شاید اصلا باید پرتنسونو کلتون نداریم"
    },
    {
      "id": 11,
      "start": 10844.0,
      "end": 10846.0,
      "formatted_start": "03:00:44.000",
      "formatted_end": "03:00:46.000",
      "text": "پچه ها رو میبینم"
    },
    {
      "id": 12,
      "start": 10847.0,
      "end": 10850.0,
      "formatted_start": "03:00:47.000",
      "formatted_end": "03:00:50.000",
      "text": "اول به این میگم کار ندارم درست کنم"
    },
    {
      "id": 13,
      "start": 10850.0,
      "end": 10851.0,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:00:51.000",
      "text": "و بعد بردارم"
    },
    {
      "id": 14,
      "start": 10851.0,
      "end": 10852.0,
      "formatted_start": "03:00:51.000",
      "formatted_end": "03:00:52.000",
      "text": "باشه"
    },
    {
      "id": 15,
      "start": 10852.0,
      "end": 10882.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:01:22.000",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 16,
      "start": 10882.0,
      "end": 10884.0,
      "formatted_start": "03:01:22.000",
      "formatted_end": "03:01:24.000",
      "text": "اینجا بودم"
    },
    {
      "id": 17,
      "start": 10888.0,
      "end": 10890.0,
      "formatted_start": "03:01:28.000",
      "formatted_end": "03:01:30.000",
      "text": "اصلا اصلا به کالت خونه"
    },
    {
      "id": 18,
      "start": 10892.0,
      "end": 10894.0,
      "formatted_start": "03:01:32.000",
      "formatted_end": "03:01:34.000",
      "text": "نه برای من اصلا اصلا به کالت خونه نگویم"
    },
    {
      "id": 19,
      "start": 10896.0,
      "end": 10898.0,
      "formatted_start": "03:01:36.000",
      "formatted_end": "03:01:38.000",
      "text": "آه چرا سرم به کالت نمومد"
    },
    {
      "id": 20,
      "start": 10900.0,
      "end": 10902.0,
      "formatted_start": "03:01:40.000",
      "formatted_end": "03:01:42.000",
      "text": "باشو خداحافظ"
    },
    {
      "id": 21,
      "start": 10904.0,
      "end": 10906.0,
      "formatted_start": "03:01:44.000",
      "formatted_end": "03:01:46.000",
      "text": "خب بعد؟"
    },
    {
      "id": 22,
      "start": 10906.0,
      "end": 10908.0,
      "formatted_start": "03:01:46.000",
      "formatted_end": "03:01:48.000",
      "text": "بعد که کارم رو گشته دید"
    },
    {
      "id": 23,
      "start": 10908.0,
      "end": 10910.0,
      "formatted_start": "03:01:48.000",
      "formatted_end": "03:01:50.000",
      "text": "من مثلا میگم سرگیری"
    },
    {
      "id": 24,
      "start": 10910.0,
      "end": 10913.0,
      "formatted_start": "03:01:50.000",
      "formatted_end": "03:01:53.000",
      "text": "مثلا یک لحظه سرم اونطوری کنم به یک میشهرخانه"
    },
    {
      "id": 25,
      "start": 10913.0,
      "end": 10917.0,
      "formatted_start": "03:01:53.000",
      "formatted_end": "03:01:57.000",
      "text": "اینگاه یک میشهرخانه یا از صفحه چشمان سیاه میمیدی اونطوری"
    },
    {
      "id": 26,
      "start": 10917.0,
      "end": 10921.0,
      "formatted_start": "03:01:57.000",
      "formatted_end": "03:02:01.000",
      "text": "مثلا بعضی کلیبار دیگه تیکی تیکه میشه اونطوری"
    },
    {
      "id": 27,
      "start": 10921.0,
      "end": 10925.0,
      "formatted_start": "03:02:01.000",
      "formatted_end": "03:02:05.000",
      "text": "به دوازت میاد پایین دیگه چون بوشت قرمز کم میخوری درسته"
    },
    {
      "id": 28,
      "start": 10925.0,
      "end": 10927.0,
      "formatted_start": "03:02:05.000",
      "formatted_end": "03:02:07.000",
      "text": "کلن همه هست داره"
    },
    {
      "id": 29,
      "start": 10927.0,
      "end": 10930.0,
      "formatted_start": "03:02:07.000",
      "formatted_end": "03:02:10.000",
      "text": "برای اینطور به دوازت پایین همیشه باید به دوازت نباییم بخوریم"
    },
    {
      "id": 30,
      "start": 10930.0,
      "end": 10935.0,
      "formatted_start": "03:02:10.000",
      "formatted_end": "03:02:15.000",
      "text": "باید برای موانون یه نمک دریا بگیر"
    },
    {
      "id": 31,
      "start": 10935.0,
      "end": 10935.9,
      "formatted_start": "03:02:15.000",
      "formatted_end": "03:02:15.900",
      "text": "نه اصلا"
    },
    {
      "id": 32,
      "start": 10935.9,
      "end": 10937.0,
      "formatted_start": "03:02:15.900",
      "formatted_end": "03:02:17.000",
      "text": "خب بهش میاد با"
    },
    {
      "id": 33,
      "start": 10937.0,
      "end": 10943.0,
      "formatted_start": "03:02:17.000",
      "formatted_end": "03:02:23.000",
      "text": "نه باید دریا و غیر دریا و سورتی و نه نمیدونم کبیر تبست و اینا همه همشون"
    },
    {
      "id": 34,
      "start": 10943.0,
      "end": 10946.0,
      "formatted_start": "03:02:23.000",
      "formatted_end": "03:02:26.000",
      "text": "اما فیلانی گفته خب میاد با من"
    },
    {
      "id": 35,
      "start": 10946.0,
      "end": 10948.0,
      "formatted_start": "03:02:26.000",
      "formatted_end": "03:02:28.000",
      "text": "دکتور باید گفته کنه هر نوع نمکی هست"
    },
    {
      "id": 36,
      "start": 10948.0,
      "end": 10951.0,
      "formatted_start": "03:02:28.000",
      "formatted_end": "03:02:31.000",
      "text": "اون اصلا میخواد غذاها شما نمیدونه زنه پا تو ببینم"
    },
    {
      "id": 37,
      "start": 10953.0,
      "end": 10954.0,
      "formatted_start": "03:02:33.000",
      "formatted_end": "03:02:34.000",
      "text": "بگو نمکی کنه"
    },
    {
      "id": 38,
      "start": 10955.0,
      "end": 10956.0,
      "formatted_start": "03:02:35.000",
      "formatted_end": "03:02:36.000",
      "text": "نه خوبه"
    },
    {
      "id": 39,
      "start": 10957.0,
      "end": 10958.0,
      "formatted_start": "03:02:37.000",
      "formatted_end": "03:02:38.000",
      "text": "خیلی خب بنایی اینو انجام بگذار"
    },
    {
      "id": 40,
      "start": 10958.0,
      "end": 10960.0,
      "formatted_start": "03:02:38.000",
      "formatted_end": "03:02:40.000",
      "text": "تو غذنیتو هم خدا شوره خوبه فیلان"
    },
    {
      "id": 41,
      "start": 10960.0,
      "end": 10964.96,
      "formatted_start": "03:02:40.000",
      "formatted_end": "03:02:44.960",
      "text": "پس همین چهارتا قرص رو لعقل بخور خب، اینا رو ترک نکنید"
    },
    {
      "id": 42,
      "start": 10964.96,
      "end": 10968.64,
      "formatted_start": "03:02:44.960",
      "formatted_end": "03:02:48.640",
      "text": "اینا توی یه بیسی نگه میگن"
    },
    {
      "id": 43,
      "start": 10968.64,
      "end": 10972.56,
      "formatted_start": "03:02:48.640",
      "formatted_end": "03:02:52.560",
      "text": "یه کورتون هم نیست که مدت ها از هیچ دستیر رو مدت نداره این دارو"
    },
    {
      "id": 44,
      "start": 10972.56,
      "end": 10976.04,
      "formatted_start": "03:02:52.560",
      "formatted_end": "03:02:56.040",
      "text": "تو جواب آدویکی رو مدت بیاد فرد به دارو بدن باشه"
    },
    {
      "id": 45,
      "start": 10976.04,
      "end": 10977.16,
      "formatted_start": "03:02:56.040",
      "formatted_end": "03:02:57.160",
      "text": "باشه"
    },
    {
      "id": 46,
      "start": 10977.16,
      "end": 10978.34,
      "formatted_start": "03:02:57.160",
      "formatted_end": "03:02:58.340",
      "text": "اون برگه توی در"
    },
    {
      "id": 47,
      "start": 10978.34,
      "end": 10981.06,
      "formatted_start": "03:02:58.340",
      "formatted_end": "03:03:01.060",
      "text": "این دفعه فرد نو برد"
    },
    {
      "id": 48,
      "start": 10981.06,
      "end": 10984.96,
      "formatted_start": "03:03:01.060",
      "formatted_end": "03:03:04.960",
      "text": "بخوان گلشین بدن"
    },
    {
      "id": 49,
      "start": 10990.0,
      "end": 10992.0,
      "formatted_start": "03:03:10.000",
      "formatted_end": "03:03:12.000",
      "text": "مردم از برگرده باید برگرده بشه"
    },
    {
      "id": 50,
      "start": 10992.0,
      "end": 10994.0,
      "formatted_start": "03:03:12.000",
      "formatted_end": "03:03:14.000",
      "text": "و از اینکه باید برگرده بشه"
    },
    {
      "id": 51,
      "start": 10994.0,
      "end": 10996.0,
      "formatted_start": "03:03:14.000",
      "formatted_end": "03:03:16.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 52,
      "start": 10996.0,
      "end": 10998.0,
      "formatted_start": "03:03:16.000",
      "formatted_end": "03:03:18.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 53,
      "start": 10998.0,
      "end": 11000.0,
      "formatted_start": "03:03:18.000",
      "formatted_end": "03:03:20.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 54,
      "start": 11000.0,
      "end": 11002.0,
      "formatted_start": "03:03:20.000",
      "formatted_end": "03:03:22.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 55,
      "start": 11002.0,
      "end": 11004.0,
      "formatted_start": "03:03:22.000",
      "formatted_end": "03:03:24.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 56,
      "start": 11004.0,
      "end": 11006.0,
      "formatted_start": "03:03:24.000",
      "formatted_end": "03:03:26.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 57,
      "start": 11006.0,
      "end": 11008.0,
      "formatted_start": "03:03:26.000",
      "formatted_end": "03:03:28.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 58,
      "start": 11008.0,
      "end": 11010.0,
      "formatted_start": "03:03:28.000",
      "formatted_end": "03:03:30.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 59,
      "start": 11010.0,
      "end": 11012.0,
      "formatted_start": "03:03:30.000",
      "formatted_end": "03:03:32.000",
      "text": "و از اینکه برگرده بشه"
    },
    {
      "id": 60,
      "start": 11012.0,
      "end": 11015.0,
      "formatted_start": "03:03:32.000",
      "formatted_end": "03:03:35.000",
      "text": "اوه، پستر و چکار فرق کم خود نمیخوای اجابه؟"
    },
    {
      "id": 61,
      "start": 11015.0,
      "end": 11019.0,
      "formatted_start": "03:03:35.000",
      "formatted_end": "03:03:39.000",
      "text": "اولش گفت که مهمی که پستر رو دارم و بعدش گفت که چکارو کامل بگیز"
    },
    {
      "id": 62,
      "start": 11019.0,
      "end": 11021.0,
      "formatted_start": "03:03:39.000",
      "formatted_end": "03:03:41.000",
      "text": "من که چیز دیگه نیازیست که بکنی؟"
    },
    {
      "id": 63,
      "start": 11021.0,
      "end": 11024.0,
      "formatted_start": "03:03:41.000",
      "formatted_end": "03:03:44.000",
      "text": "چون اینجا نمیخوایم تومال مارکر نمیشتم"
    },
    {
      "id": 64,
      "start": 11025.0,
      "end": 11027.0,
      "formatted_start": "03:03:45.000",
      "formatted_end": "03:03:47.000",
      "text": "این بوتو ها نمیشتم"
    },
    {
      "id": 65,
      "start": 11027.0,
      "end": 11031.0,
      "formatted_start": "03:03:47.000",
      "formatted_end": "03:03:51.000",
      "text": "گفت آها دکتور گفته که در این وقت بردومری اینها رو ببینیم تون آزمایشه بگیزم"
    },
    {
      "id": 66,
      "start": 11031.0,
      "end": 11034.0,
      "formatted_start": "03:03:51.000",
      "formatted_end": "03:03:54.000",
      "text": "اوه، از خونه مرخی هم بگیز؟"
    },
    {
      "id": 67,
      "start": 11035.0,
      "end": 11036.0,
      "formatted_start": "03:03:55.000",
      "formatted_end": "03:03:56.000",
      "text": "خونه مرخی؟"
    },
    {
      "id": 68,
      "start": 11036.0,
      "end": 11046.0,
      "formatted_start": "03:03:56.000",
      "formatted_end": "03:04:06.000",
      "text": "موسیقی"
    },
    {
      "id": 69,
      "start": 11066.0,
      "end": 11096.0,
      "formatted_start": "03:04:26.000",
      "formatted_end": "03:04:56.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید ک"
    },
    {
      "id": 70,
      "start": 11096.0,
      "end": 11098.0,
      "formatted_start": "03:04:56.000",
      "formatted_end": "03:04:58.000",
      "text": "باقی با دویر"
    },
    {
      "id": 71,
      "start": 11098.0,
      "end": 11100.0,
      "formatted_start": "03:04:58.000",
      "formatted_end": "03:05:00.000",
      "text": "چون سوچی نه"
    }
  ],
  "status": "completed"
}