  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3320.0,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3330.0,
      "end": 3335.76,
      "formatted_start": "00:55:30.000",
      "formatted_end": "00:55:35.760",
      "text": "باشی و هم تشکر کنیم بابت زحماتتون"
    },
    {
      "id": 2,
      "start": 3335.76,
      "end": 3346.06,
      "formatted_start": "00:55:35.760",
      "formatted_end": "00:55:46.060",
      "text": "همین کارنامه همین که برای کمبود داروم و هر سی مایل ها"
    },
    {
      "id": 3,
      "start": 3346.06,
      "end": 3350.68,
      "formatted_start": "00:55:46.060",
      "formatted_end": "00:55:50.680",
      "text": "برای کارش اقدام داروی تلین سال"
    },
    {
      "id": 4,
      "start": 3350.68,
      "end": 3353.76,
      "formatted_start": "00:55:50.680",
      "formatted_end": "00:55:53.760",
      "text": "این کارنامه سال چهار سبت و چوباره"
    },
    {
      "id": 5,
      "start": 3353.76,
      "end": 3359.36,
      "formatted_start": "00:55:53.760",
      "formatted_end": "00:55:59.360",
      "text": "اینجا داروم میانگیر کشورایی چهار و شیشه"
    },
    {
      "id": 6,
      "start": 3359.36,
      "end": 3361.88,
      "formatted_start": "00:55:59.360",
      "formatted_end": "00:56:01.880",
      "text": "شما اصلا شیشه دوی خستان چهارم شیشه"
    },
    {
      "id": 7,
      "start": 3361.88,
      "end": 3364.4,
      "formatted_start": "00:56:01.880",
      "formatted_end": "00:56:04.400",
      "text": "بعد آزمایش هموشتن هست"
    },
    {
      "id": 8,
      "start": 3364.4,
      "end": 3366.8,
      "formatted_start": "00:56:04.400",
      "formatted_end": "00:56:06.800",
      "text": "اینجا من جانبازانم"
    },
    {
      "id": 9,
      "start": 3366.8,
      "end": 3367.64,
      "formatted_start": "00:56:06.800",
      "formatted_end": "00:56:07.640",
      "text": "میدونم"
    },
    {
      "id": 10,
      "start": 3367.64,
      "end": 3369.64,
      "formatted_start": "00:56:07.640",
      "formatted_end": "00:56:09.640",
      "text": "یعنی پیشتون میروند دیگه"
    },
    {
      "id": 11,
      "start": 3369.64,
      "end": 3370.14,
      "formatted_start": "00:56:09.640",
      "formatted_end": "00:56:10.140",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 3370.14,
      "end": 3371.84,
      "formatted_start": "00:56:10.140",
      "formatted_end": "00:56:11.840",
      "text": "چه قهر طلاف کنید"
    },
    {
      "id": 13,
      "start": 3371.84,
      "end": 3375.48,
      "formatted_start": "00:56:11.840",
      "formatted_end": "00:56:15.480",
      "text": "من در ساعتهای زندگی نیز باید رو بلیس پنجه کنیم"
    },
    {
      "id": 14,
      "start": 3375.48,
      "end": 3376.02,
      "formatted_start": "00:56:15.480",
      "formatted_end": "00:56:16.020",
      "text": "خب"
    },
    {
      "id": 15,
      "start": 3376.02,
      "end": 3379.4,
      "formatted_start": "00:56:16.020",
      "formatted_end": "00:56:19.400",
      "text": "البته باید نیز بلیس پنجه باید بلیس پنجه باید بلیس پنجه برم"
    },
    {
      "id": 16,
      "start": 3379.4,
      "end": 3382.0,
      "formatted_start": "00:56:19.400",
      "formatted_end": "00:56:22.000",
      "text": "بلیس میروند اینجا دستور میروند"
    },
    {
      "id": 17,
      "start": 3382.0,
      "end": 3383.6,
      "formatted_start": "00:56:22.000",
      "formatted_end": "00:56:23.600",
      "text": "باید"
    },
    {
      "id": 18,
      "start": 3383.6,
      "end": 3387.6,
      "formatted_start": "00:56:23.600",
      "formatted_end": "00:56:27.600",
      "text": "تو اصلا اگه اینجا هستی، من جامعه خواست تونه اینجا برم"
    },
    {
      "id": 19,
      "start": 3387.6,
      "end": 3391.6,
      "formatted_start": "00:56:27.600",
      "formatted_end": "00:56:31.600",
      "text": "من موهرم، من سفرم، سفر من"
    },
    {
      "id": 20,
      "start": 3391.6,
      "end": 3397.6,
      "formatted_start": "00:56:31.600",
      "formatted_end": "00:56:37.600",
      "text": "یعنی باور کنی، من سه بار دوزه نگه تو مدتر در پیزشکی، پولیس هست، پولیس هست، اینجا دوزم"
    },
    {
      "id": 21,
      "start": 3397.6,
      "end": 3401.6,
      "formatted_start": "00:56:37.600",
      "formatted_end": "00:56:41.600",
      "text": "اصلا لبغرداد گرامون در جمعه رو میگن"
    },
    {
      "id": 22,
      "start": 3401.6,
      "end": 3403.6,
      "formatted_start": "00:56:41.600",
      "formatted_end": "00:56:43.600",
      "text": "بوجه یادچا یاددرچا لبغرداد کردن"
    },
    {
      "id": 23,
      "start": 3403.6,
      "end": 3406.6,
      "formatted_start": "00:56:43.600",
      "formatted_end": "00:56:46.600",
      "text": "گفتم آقا نمیخوام، برم کنی، نمیخوام دیگه"
    },
    {
      "id": 24,
      "start": 3406.6,
      "end": 3408.6,
      "formatted_start": "00:56:46.600",
      "formatted_end": "00:56:48.600",
      "text": "نفولی میخوام، هیچی نمیخوام"
    },
    {
      "id": 25,
      "start": 3408.6,
      "end": 3411.6,
      "formatted_start": "00:56:48.600",
      "formatted_end": "00:56:51.600",
      "text": "و دوباره اینقدر زنگ زدن از دیوانه اونجا"
    },
    {
      "id": 26,
      "start": 3411.6,
      "end": 3413.6,
      "formatted_start": "00:56:51.600",
      "formatted_end": "00:56:53.600",
      "text": "اینش بی قبول نمیکنه که این رو باید نکنه"
    },
    {
      "id": 27,
      "start": 3413.6,
      "end": 3415.6,
      "formatted_start": "00:56:53.600",
      "formatted_end": "00:56:55.600",
      "text": "قد طلب کن"
    },
    {
      "id": 28,
      "start": 3415.6,
      "end": 3417.6,
      "formatted_start": "00:56:55.600",
      "formatted_end": "00:56:57.600",
      "text": "بگوییست تو باید نمیسی"
    },
    {
      "id": 29,
      "start": 3417.6,
      "end": 3420.6,
      "formatted_start": "00:56:57.600",
      "formatted_end": "00:57:00.600",
      "text": "آقا اون مریض اونهاد کلاریت رو آورده"
    },
    {
      "id": 30,
      "start": 3420.6,
      "end": 3423.6,
      "formatted_start": "00:57:00.600",
      "formatted_end": "00:57:03.600",
      "text": "این یک میلونه میگن بگوییم برای چی میخوری آخه"
    },
    {
      "id": 31,
      "start": 3423.6,
      "end": 3425.6,
      "formatted_start": "00:57:03.600",
      "formatted_end": "00:57:05.600",
      "text": "این هر وقت میدن و اینجوری میشه"
    },
    {
      "id": 32,
      "start": 3425.6,
      "end": 3428.6,
      "formatted_start": "00:57:05.600",
      "formatted_end": "00:57:08.600",
      "text": "گفتم خانم اینجور میدونی اول اگه این چند رو برسد"
    },
    {
      "id": 33,
      "start": 3428.6,
      "end": 3431.6,
      "formatted_start": "00:57:08.600",
      "formatted_end": "00:57:11.600",
      "text": "این درق یک میلونه چرا باید تو بخوری؟"
    },
    {
      "id": 34,
      "start": 3431.6,
      "end": 3437.6,
      "formatted_start": "00:57:11.600",
      "formatted_end": "00:57:17.600",
      "text": "بابر کنید که شب باید گفتم اگه نسخه اون رو کنید دیگه مثلا آماسی یک برق"
    },
    {
      "id": 35,
      "start": 3437.6,
      "end": 3439.6,
      "formatted_start": "00:57:17.600",
      "formatted_end": "00:57:19.600",
      "text": "دیگه میدونیم یه جوری هم دهن اونو بستش کنیم"
    },
    {
      "id": 36,
      "start": 3439.6,
      "end": 3443.6,
      "formatted_start": "00:57:19.600",
      "formatted_end": "00:57:23.600",
      "text": "اما یعنی داریم چشم بازم بیشتر تلاش میدونیم"
    },
    {
      "id": 37,
      "start": 3443.6,
      "end": 3447.6,
      "formatted_start": "00:57:23.600",
      "formatted_end": "00:57:27.600",
      "text": "الان بهشون میگم که مثلا شاید اینجوری میخوامشون میگم"
    },
    {
      "id": 38,
      "start": 3447.6,
      "end": 3451.6,
      "formatted_start": "00:57:27.600",
      "formatted_end": "00:57:31.600",
      "text": "یه کوئی آزمایش چی کاف داریم میریم سرمیتون پرمشون آخر سال باید آزاد بریم"
    },
    {
      "id": 39,
      "start": 3451.6,
      "end": 3456.16,
      "formatted_start": "00:57:31.600",
      "formatted_end": "00:57:36.160",
      "text": "بخواد چه خبری؟ خدا شاید من شما که دفتین سنو آزمایش"
    },
    {
      "id": 40,
      "start": 3456.16,
      "end": 3460.56,
      "formatted_start": "00:57:36.160",
      "formatted_end": "00:57:40.560",
      "text": "نه سنگ من تو خالی من سنو برده باید بیانه چی"
    },
    {
      "id": 41,
      "start": 3460.56,
      "end": 3464.84,
      "formatted_start": "00:57:40.560",
      "formatted_end": "00:57:44.840",
      "text": "یعنی ولی چشم حتما تحشم کنیم یعنی تو موقع جنگی خوب بود"
    },
    {
      "id": 42,
      "start": 3464.84,
      "end": 3494.84,
      "formatted_start": "00:57:44.840",
      "formatted_end": "00:58:14.840",
      "text": "بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم بخواهیم ب"
    },
    {
      "id": 43,
      "start": 3494.84,
      "end": 3499.34,
      "formatted_start": "00:58:14.840",
      "formatted_end": "00:58:19.340",
      "text": "و اینکه دیدگاه سازمان رفته به سمت پیشگیری"
    },
    {
      "id": 44,
      "start": 3499.34,
      "end": 3502.34,
      "formatted_start": "00:58:19.340",
      "formatted_end": "00:58:22.340",
      "text": "نه به ده مان"
    },
    {
      "id": 45,
      "start": 3502.34,
      "end": 3504.34,
      "formatted_start": "00:58:22.340",
      "formatted_end": "00:58:24.340",
      "text": "دیر همیشه بود"
    },
    {
      "id": 46,
      "start": 3504.34,
      "end": 3506.34,
      "formatted_start": "00:58:24.340",
      "formatted_end": "00:58:26.340",
      "text": "ده مان هست"
    },
    {
      "id": 47,
      "start": 3506.34,
      "end": 3510.34,
      "formatted_start": "00:58:26.340",
      "formatted_end": "00:58:30.340",
      "text": "ارمان من که اخلاق همیشه از این کتا نمی آمد"
    },
    {
      "id": 48,
      "start": 3510.34,
      "end": 3513.34,
      "formatted_start": "00:58:30.340",
      "formatted_end": "00:58:33.340",
      "text": "آیا بیایید میدین چه دستو، اگه عرض سر باشه"
    },
    {
      "id": 49,
      "start": 3513.34,
      "end": 3515.34,
      "formatted_start": "00:58:33.340",
      "formatted_end": "00:58:35.340",
      "text": "مثلا مزدک رو ماجی میلند، میگن مزدک شاید تاندانه"
    },
    {
      "id": 50,
      "start": 3515.34,
      "end": 3518.34,
      "formatted_start": "00:58:35.340",
      "formatted_end": "00:58:38.340",
      "text": "بعد چیز داشته باشه، بشه تو بره قدر بشه"
    },
    {
      "id": 51,
      "start": 3518.34,
      "end": 3522.34,
      "formatted_start": "00:58:38.340",
      "formatted_end": "00:58:42.340",
      "text": "بعد میرن به شوید، برد بشن، یاد میدن"
    },
    {
      "id": 52,
      "start": 3522.34,
      "end": 3526.84,
      "formatted_start": "00:58:42.340",
      "formatted_end": "00:58:46.840",
      "text": "اگر بزنید و اگر لیزر بزنید، بزنید 20-40 دقیقا"
    },
    {
      "id": 53,
      "start": 3526.84,
      "end": 3529.34,
      "formatted_start": "00:58:46.840",
      "formatted_end": "00:58:49.340",
      "text": "چیزهایی به مردم یاد میدهد"
    },
    {
      "id": 54,
      "start": 3529.34,
      "end": 3531.34,
      "formatted_start": "00:58:49.340",
      "formatted_end": "00:58:51.340",
      "text": "مشه ها موشه ها"
    },
    {
      "id": 55,
      "start": 3531.34,
      "end": 3533.34,
      "formatted_start": "00:58:51.340",
      "formatted_end": "00:58:53.340",
      "text": "از خودمون نبوده"
    },
    {
      "id": 56,
      "start": 3533.34,
      "end": 3535.34,
      "formatted_start": "00:58:53.340",
      "formatted_end": "00:58:55.340",
      "text": "اون خود بینه"
    },
    {
      "id": 57,
      "start": 3535.34,
      "end": 3538.34,
      "formatted_start": "00:58:55.340",
      "formatted_end": "00:58:58.340",
      "text": "من پیرواز سامنه بودم سامنه بودم"
    },
    {
      "id": 58,
      "start": 3538.34,
      "end": 3542.34,
      "formatted_start": "00:58:58.340",
      "formatted_end": "00:59:02.340",
      "text": "مریض مثلا می آمد و می بود من با موتور خوردم سنیم"
    },
    {
      "id": 59,
      "start": 3542.34,
      "end": 3544.34,
      "formatted_start": "00:59:02.340",
      "formatted_end": "00:59:04.340",
      "text": "من همیشه اینهی عجب من"
    },
    {
      "id": 60,
      "start": 3544.34,
      "end": 3548.34,
      "formatted_start": "00:59:04.340",
      "formatted_end": "00:59:08.340",
      "text": "با موتور خوردم سنیم، بعد می آمد و می قبولم کرد"
    },
    {
      "id": 61,
      "start": 3548.34,
      "end": 3550.34,
      "formatted_start": "00:59:08.340",
      "formatted_end": "00:59:10.340",
      "text": "بعد می گفت از باشیبا مفتادم قبول میکردم"
    },
    {
      "id": 62,
      "start": 3550.34,
      "end": 3552.34,
      "formatted_start": "00:59:10.340",
      "formatted_end": "00:59:12.340",
      "text": "میرونیم اینکه در حقوق نیست"
    },
    {
      "id": 63,
      "start": 3552.34,
      "end": 3555.34,
      "formatted_start": "00:59:12.340",
      "formatted_end": "00:59:15.340",
      "text": "ولی مجرم ما خودمون میگم مجبورشون میگن"
    },
    {
      "id": 64,
      "start": 3555.34,
      "end": 3556.34,
      "formatted_start": "00:59:15.340",
      "formatted_end": "00:59:16.340",
      "text": "اینکه در حقوق بگن"
    },
    {
      "id": 65,
      "start": 3556.34,
      "end": 3559.34,
      "formatted_start": "00:59:16.340",
      "formatted_end": "00:59:19.340",
      "text": "لطف میگرفتن که این رو چاند افرادی هم میگفتن"
    },
    {
      "id": 66,
      "start": 3559.34,
      "end": 3562.34,
      "formatted_start": "00:59:19.340",
      "formatted_end": "00:59:22.340",
      "text": "خب چرا وقتی کسی که راستشون داره میگه"
    },
    {
      "id": 67,
      "start": 3562.34,
      "end": 3564.34,
      "formatted_start": "00:59:22.340",
      "formatted_end": "00:59:24.340",
      "text": "که اون روش میگه اینجوری میگه نه با آزاد بذار"
    },
    {
      "id": 68,
      "start": 3564.34,
      "end": 3565.34,
      "formatted_start": "00:59:24.340",
      "formatted_end": "00:59:25.340",
      "text": "که اون روی در حقوق نیست"
    },
    {
      "id": 69,
      "start": 3565.34,
      "end": 3567.34,
      "formatted_start": "00:59:25.340",
      "formatted_end": "00:59:27.340",
      "text": "و میرو میگه در حقوق نیست"
    },
    {
      "id": 70,
      "start": 3567.34,
      "end": 3568.34,
      "formatted_start": "00:59:27.340",
      "formatted_end": "00:59:28.340",
      "text": "همه"
    },
    {
      "id": 71,
      "start": 3569.34,
      "end": 3572.34,
      "formatted_start": "00:59:29.340",
      "formatted_end": "00:59:32.340",
      "text": "جزا آزمانش کن یه جور بهشون"
    },
    {
      "id": 72,
      "start": 3572.34,
      "end": 3575.34,
      "formatted_start": "00:59:32.340",
      "formatted_end": "00:59:35.340",
      "text": "فیزیو تراپیا"
    },
    {
      "id": 73,
      "start": 3575.34,
      "end": 3576.34,
      "formatted_start": "00:59:35.340",
      "formatted_end": "00:59:36.340",
      "text": "دارن نه؟"
    },
    {
      "id": 74,
      "start": 3576.34,
      "end": 3580.82,
      "formatted_start": "00:59:36.340",
      "formatted_end": "00:59:40.820",
      "text": "اما درخانه برو خانه بزنید و بردنجه منبونه بردنجه"
    },
    {
      "id": 75,
      "start": 3580.82,
      "end": 3585.24,
      "formatted_start": "00:59:40.820",
      "formatted_end": "00:59:45.240",
      "text": "همه این مشکل افراد از خودمان ما بجایی که خودمون شروع بردنیم"
    },
    {
      "id": 76,
      "start": 3585.24,
      "end": 3586.9,
      "formatted_start": "00:59:45.240",
      "formatted_end": "00:59:46.900",
      "text": "بردنیم در خانه مردم"
    },
    {
      "id": 77,
      "start": 3586.9,
      "end": 3588.58,
      "formatted_start": "00:59:46.900",
      "formatted_end": "00:59:48.580",
      "text": "و ما همچنین به شما گمگم داریم"
    },
    {
      "id": 78,
      "start": 3588.58,
      "end": 3592.02,
      "formatted_start": "00:59:48.580",
      "formatted_end": "00:59:52.020",
      "text": "شما همین کارهایی که برشدید از شما برمیدونیم"
    },
    {
      "id": 79,
      "start": 3592.02,
      "end": 3594.14,
      "formatted_start": "00:59:52.020",
      "formatted_end": "00:59:54.140",
      "text": "الان بگیم تجمیلی"
    },
    {
      "id": 80,
      "start": 3594.14,
      "end": 3595.98,
      "formatted_start": "00:59:54.140",
      "formatted_end": "00:59:55.980",
      "text": "میماناتی سازم رو کارم"
    },
    {
      "id": 81,
      "start": 3595.98,
      "end": 3598.18,
      "formatted_start": "00:59:55.980",
      "formatted_end": "00:59:58.180",
      "text": "درستم دو رو برمونو نوشته"
    },
    {
      "id": 82,
      "start": 3598.18,
      "end": 3599.38,
      "formatted_start": "00:59:58.180",
      "formatted_end": "00:59:59.380",
      "text": "خون دردی کرد"
    }
  ],
  "status": "completed"
}