  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9302.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:02.000",
      "text": "اصلا در نمون دوستون."
    },
    {
      "id": 1,
      "start": 9302.0,
      "end": 9304.0,
      "formatted_start": "02:35:02.000",
      "formatted_end": "02:35:04.000",
      "text": "نه، خطرناک نیست."
    },
    {
      "id": 2,
      "start": 9304.0,
      "end": 9310.0,
      "formatted_start": "02:35:04.000",
      "formatted_end": "02:35:10.000",
      "text": "نه، خطرناک نیست، من شما چهر ساله درکمه ده، چرب تو خیلی هست برای این زن، چرا باید نیستی؟"
    },
    {
      "id": 3,
      "start": 9310.0,
      "end": 9314.0,
      "formatted_start": "02:35:10.000",
      "formatted_end": "02:35:14.000",
      "text": "نه، الکولیوزری، نه، موسکل کنی، نه، بیماری خاصی داره که دارو بخوره."
    },
    {
      "id": 4,
      "start": 9314.0,
      "end": 9317.0,
      "formatted_start": "02:35:14.000",
      "formatted_end": "02:35:17.000",
      "text": "اگه یک الکولیوزر میمون، گفتون خودوی الکولیه."
    },
    {
      "id": 5,
      "start": 9317.0,
      "end": 9321.0,
      "formatted_start": "02:35:17.000",
      "formatted_end": "02:35:21.000",
      "text": "یک خانم که هیچ چیز استفاده نمی کنه، چرا باید نیستی؟"
    },
    {
      "id": 6,
      "start": 9321.0,
      "end": 9323.0,
      "formatted_start": "02:35:21.000",
      "formatted_end": "02:35:23.000",
      "text": "که خودتون استفاده کنه."
    },
    {
      "id": 7,
      "start": 9323.0,
      "end": 9329.0,
      "formatted_start": "02:35:23.000",
      "formatted_end": "02:35:29.000",
      "text": "این درگاه هایی که میدونم ترکیب زرچوبه و زنجفیده"
    },
    {
      "id": 8,
      "start": 9329.0,
      "end": 9331.0,
      "formatted_start": "02:35:29.000",
      "formatted_end": "02:35:31.000",
      "text": "این درگاه هایی که میدونم ترکیب زرچوبه و زنجفیده"
    },
    {
      "id": 9,
      "start": 9331.0,
      "end": 9333.0,
      "formatted_start": "02:35:31.000",
      "formatted_end": "02:35:33.000",
      "text": "این درگاه هایی که میدونم ترکیب زنجفیده"
    },
    {
      "id": 10,
      "start": 9333.0,
      "end": 9335.0,
      "formatted_start": "02:35:33.000",
      "formatted_end": "02:35:35.000",
      "text": "این درگاه هایی که میدونم ترکیب زنجفیده"
    },
    {
      "id": 11,
      "start": 9335.0,
      "end": 9337.0,
      "formatted_start": "02:35:35.000",
      "formatted_end": "02:35:37.000",
      "text": "این درگاه هایی که میدونم ترکیب زنجفیده"
    },
    {
      "id": 12,
      "start": 9337.0,
      "end": 9339.0,
      "formatted_start": "02:35:37.000",
      "formatted_end": "02:35:39.000",
      "text": "این درگاه هایی که میدونم ترکیب زنجفیده"
    },
    {
      "id": 13,
      "start": 9339.0,
      "end": 9341.0,
      "formatted_start": "02:35:39.000",
      "formatted_end": "02:35:41.000",
      "text": "این درگاه هایی که میدونم ترکیب زنجفیده"
    },
    {
      "id": 14,
      "start": 9341.0,
      "end": 9346.0,
      "formatted_start": "02:35:41.000",
      "formatted_end": "02:35:46.000",
      "text": "من از جانب بردنشم که تو میکنم هفته بسیار"
    },
    {
      "id": 15,
      "start": 9351.0,
      "end": 9353.0,
      "formatted_start": "02:35:51.000",
      "formatted_end": "02:35:53.000",
      "text": "چند هفته کمان این دردو داری؟"
    },
    {
      "id": 16,
      "start": 9353.0,
      "end": 9354.0,
      "formatted_start": "02:35:53.000",
      "formatted_end": "02:35:54.000",
      "text": "این دو ماهه"
    },
    {
      "id": 17,
      "start": 9354.0,
      "end": 9356.0,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:35:56.000",
      "text": "الان که سر درد داری؟"
    },
    {
      "id": 18,
      "start": 9356.0,
      "end": 9358.0,
      "formatted_start": "02:35:56.000",
      "formatted_end": "02:35:58.000",
      "text": "آره درد دارم"
    },
    {
      "id": 19,
      "start": 9358.0,
      "end": 9361.0,
      "formatted_start": "02:35:58.000",
      "formatted_end": "02:36:01.000",
      "text": "مثلا میگم که طولانی میشینم درد شده سیار میشن"
    },
    {
      "id": 20,
      "start": 9361.0,
      "end": 9364.0,
      "formatted_start": "02:36:01.000",
      "formatted_end": "02:36:04.000",
      "text": "ما مثلا یکمان که میزنه آرومه"
    },
    {
      "id": 21,
      "start": 9364.0,
      "end": 9368.0,
      "formatted_start": "02:36:04.000",
      "formatted_end": "02:36:08.000",
      "text": "خب الان که دردم آرومه دست میزنی درد داره"
    },
    {
      "id": 22,
      "start": 9368.0,
      "end": 9370.0,
      "formatted_start": "02:36:08.000",
      "formatted_end": "02:36:10.000",
      "text": "خب ببین یه التابه دیسک داری خب"
    },
    {
      "id": 23,
      "start": 9370.0,
      "end": 9375.6,
      "formatted_start": "02:36:10.000",
      "formatted_end": "02:36:15.600",
      "text": "خب من بهت دارم میتنم این چربز دوستفن زیاد طولانی نباید بشین"
    },
    {
      "id": 24,
      "start": 9375.6,
      "end": 9378.72,
      "formatted_start": "02:36:15.600",
      "formatted_end": "02:36:18.720",
      "text": "کار سنگین نوید بکنی بار نباید بلند کنی"
    },
    {
      "id": 25,
      "start": 9378.72,
      "end": 9382.14,
      "formatted_start": "02:36:18.720",
      "formatted_end": "02:36:22.140",
      "text": "بعد توال فرنگی بری"
    },
    {
      "id": 26,
      "start": 9382.14,
      "end": 9387.1,
      "formatted_start": "02:36:22.140",
      "formatted_end": "02:36:27.100",
      "text": "اینو نداریم متاسفانه توانه همجا نداریم برای تو باشیم"
    },
    {
      "id": 27,
      "start": 9387.1,
      "end": 9390.68,
      "formatted_start": "02:36:27.100",
      "formatted_end": "02:36:30.680",
      "text": "میخوام اینو رایت کن و تو باید داخلش رو نوشته"
    },
    {
      "id": 28,
      "start": 9390.68,
      "end": 9391.88,
      "formatted_start": "02:36:30.680",
      "formatted_end": "02:36:31.880",
      "text": "من این ناخرین"
    },
    {
      "id": 29,
      "start": 9391.88,
      "end": 9394.84,
      "formatted_start": "02:36:31.880",
      "formatted_end": "02:36:34.840",
      "text": "وقت داری کار میکنی تا اشباز کنی جایی"
    },
    {
      "id": 30,
      "start": 9394.84,
      "end": 9397.06,
      "formatted_start": "02:36:34.840",
      "formatted_end": "02:36:37.060",
      "text": "هیپا تا هر سه دقیقه جاشو عوض کن"
    },
    {
      "id": 31,
      "start": 9397.06,
      "end": 9400.92,
      "formatted_start": "02:36:37.060",
      "formatted_end": "02:36:40.920",
      "text": "این چهار روز رو دوست دارید کنید که با همین درمان تمام شد"
    },
    {
      "id": 32,
      "start": 9400.92,
      "end": 9406.38,
      "formatted_start": "02:36:40.920",
      "formatted_end": "02:36:46.380",
      "text": "چون میخوابه بلی این دوباره عاد میکنه"
    },
    {
      "id": 33,
      "start": 9406.38,
      "end": 9409.9,
      "formatted_start": "02:36:46.380",
      "formatted_end": "02:36:49.900",
      "text": "در جایی مدت که مشکل نداره"
    },
    {
      "id": 34,
      "start": 9409.9,
      "end": 9412.06,
      "formatted_start": "02:36:49.900",
      "formatted_end": "02:36:52.060",
      "text": "چون نافروکسر میخوابه"
    },
    {
      "id": 35,
      "start": 9412.06,
      "end": 9416.06,
      "formatted_start": "02:36:52.060",
      "formatted_end": "02:36:56.060",
      "text": "حتما باید بعد غذا و فاریج و مدت عذیب میدونه"
    },
    {
      "id": 36,
      "start": 9416.06,
      "end": 9421.26,
      "formatted_start": "02:36:56.060",
      "formatted_end": "02:37:01.260",
      "text": "این دهتای که نمیشتم پنج روز دوست دارید که کامل به خود"
    },
    {
      "id": 37,
      "start": 9421.26,
      "end": 9422.72,
      "formatted_start": "02:37:01.260",
      "formatted_end": "02:37:02.720",
      "text": "چه درداشتی چه نداشته"
    },
    {
      "id": 38,
      "start": 9422.72,
      "end": 9424.82,
      "formatted_start": "02:37:02.720",
      "formatted_end": "02:37:04.820",
      "text": "با فاموتیدین بعد از غذا"
    },
    {
      "id": 39,
      "start": 9427.06,
      "end": 9449.06,
      "formatted_start": "02:37:07.060",
      "formatted_end": "02:37:29.060",
      "text": "اما اینکه سرکتون میکنی اصلا داشت فکر نکنی"
    },
    {
      "id": 40,
      "start": 9449.06,
      "end": 9451.88,
      "formatted_start": "02:37:29.060",
      "formatted_end": "02:37:31.880",
      "text": "که هیچ وقتی خانم جمان با شده ایت شما"
    },
    {
      "id": 41,
      "start": 9451.88,
      "end": 9455.5,
      "formatted_start": "02:37:31.880",
      "formatted_end": "02:37:35.500",
      "text": "یک خونه سپونیلی من از پاشتار خون میریزه"
    },
    {
      "id": 42,
      "start": 9455.5,
      "end": 9457.5,
      "formatted_start": "02:37:35.500",
      "formatted_end": "02:37:37.500",
      "text": "اون زرست"
    },
    {
      "id": 43,
      "start": 9457.5,
      "end": 9459.5,
      "formatted_start": "02:37:37.500",
      "formatted_end": "02:37:39.500",
      "text": "برای این کاری برای این تصمیم نیست"
    },
    {
      "id": 44,
      "start": 9461.5,
      "end": 9463.5,
      "formatted_start": "02:37:41.500",
      "formatted_end": "02:37:43.500",
      "text": "دستتون برنگام خیلی باشید"
    },
    {
      "id": 45,
      "start": 9463.5,
      "end": 9465.5,
      "formatted_start": "02:37:43.500",
      "formatted_end": "02:37:45.500",
      "text": "برنگام"
    },
    {
      "id": 46,
      "start": 9471.5,
      "end": 9473.5,
      "formatted_start": "02:37:51.500",
      "formatted_end": "02:37:53.500",
      "text": "اونجا میدونه؟"
    },
    {
      "id": 47,
      "start": 9475.5,
      "end": 9477.5,
      "formatted_start": "02:37:55.500",
      "formatted_end": "02:37:57.500",
      "text": "بگیر به همین کدومیدش بزن"
    },
    {
      "id": 48,
      "start": 9477.5,
      "end": 9479.5,
      "formatted_start": "02:37:57.500",
      "formatted_end": "02:37:59.500",
      "text": "میاد بزن"
    },
    {
      "id": 49,
      "start": 9479.5,
      "end": 9481.5,
      "formatted_start": "02:37:59.500",
      "formatted_end": "02:38:01.500",
      "text": "بزنم"
    },
    {
      "id": 50,
      "start": 9481.5,
      "end": 9483.5,
      "formatted_start": "02:38:01.500",
      "formatted_end": "02:38:03.500",
      "text": "بزنم"
    },
    {
      "id": 51,
      "start": 9483.5,
      "end": 9503.5,
      "formatted_start": "02:38:03.500",
      "formatted_end": "02:38:23.500",
      "text": "موسیقی"
    },
    {
      "id": 52,
      "start": 9503.5,
      "end": 9507.5,
      "formatted_start": "02:38:23.500",
      "formatted_end": "02:38:27.500",
      "text": "نه، اون 66.92 و این 26.92 داره"
    },
    {
      "id": 53,
      "start": 9509.5,
      "end": 9511.5,
      "formatted_start": "02:38:29.500",
      "formatted_end": "02:38:31.500",
      "text": "624"
    },
    {
      "id": 54,
      "start": 9511.5,
      "end": 9513.5,
      "formatted_start": "02:38:31.500",
      "formatted_end": "02:38:33.500",
      "text": "نه، 624 نمیشه"
    },
    {
      "id": 55,
      "start": 9513.5,
      "end": 9515.5,
      "formatted_start": "02:38:33.500",
      "formatted_end": "02:38:35.500",
      "text": "624 500"
    },
    {
      "id": 56,
      "start": 9515.5,
      "end": 9517.5,
      "formatted_start": "02:38:35.500",
      "formatted_end": "02:38:37.500",
      "text": "این از همه کلمه دیگه است"
    },
    {
      "id": 57,
      "start": 9519.5,
      "end": 9521.5,
      "formatted_start": "02:38:39.500",
      "formatted_end": "02:38:41.500",
      "text": "آقایی نصیب بشید تونو بیدیم هم کلمه دیرو بزنم؟"
    },
    {
      "id": 58,
      "start": 9521.5,
      "end": 9523.5,
      "formatted_start": "02:38:41.500",
      "formatted_end": "02:38:43.500",
      "text": "باید"
    },
    {
      "id": 59,
      "start": 9529.5,
      "end": 9531.5,
      "formatted_start": "02:38:49.500",
      "formatted_end": "02:38:51.500",
      "text": "اون 624 نه داره"
    },
    {
      "id": 60,
      "start": 9531.5,
      "end": 9533.5,
      "formatted_start": "02:38:51.500",
      "formatted_end": "02:38:53.500",
      "text": "چه پرچی بود؟"
    },
    {
      "id": 61,
      "start": 9533.5,
      "end": 9535.5,
      "formatted_start": "02:38:53.500",
      "formatted_end": "02:38:55.500",
      "text": "چه پرچی بود؟"
    },
    {
      "id": 62,
