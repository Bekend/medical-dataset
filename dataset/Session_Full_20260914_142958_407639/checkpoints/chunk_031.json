    {
      "id": 67,
      "start": 9545.5,
      "end": 9547.5,
      "formatted_start": "02:39:05.500",
      "formatted_end": "02:39:07.500",
      "text": "بودی اینو بزنیم"
    },
    {
      "id": 68,
      "start": 9547.5,
      "end": 9549.5,
      "formatted_start": "02:39:07.500",
      "formatted_end": "02:39:09.500",
      "text": "نه هم زدم به نام کست دیگه یه دفتر"
    },
    {
      "id": 69,
      "start": 9549.5,
      "end": 9551.5,
      "formatted_start": "02:39:09.500",
      "formatted_end": "02:39:11.500",
