      "end": 4598.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:38.000",
      "text": "باید اینجوره میشه"
    },
    {
      "id": 7,
      "start": 4598.0,
      "end": 4600.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:40.000",
      "text": "اونجوره یک کشور"
    },
    {
      "id": 8,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "باید روزی میدهیم"
    },
    {
      "id": 9,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "که به قسمت داره اصلی"
    },
    {
      "id": 10,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:46.000",
      "text": "اونم دیگه به آن نداره"
    },
    {
      "id": 11,
      "start": 4620.0,
      "end": 4642.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:22.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 4642.0,
      "end": 4645.12,
      "formatted_start": "01:17:22.000",
      "formatted_end": "01:17:25.120",
      "text": "سایت اندیار مزن در برسی نمیشه"
    },
    {
      "id": 13,
      "start": 4645.12,
      "end": 4654.12,
      "formatted_start": "01:17:25.120",
      "formatted_end": "01:17:34.120",
      "text": "ساعت نمون سله همیشه قدر، گاهی وقتا وصله"
    },
    {
      "id": 14,
      "start": 4654.12,
      "end": 4662.12,
      "formatted_start": "01:17:34.120",
      "formatted_end": "01:17:42.120",
      "text": "خانم دکتر، هر چند وقت اینجام درد میگرد، آب میخورند، وایه نیستند"
    },
    {
      "id": 15,
      "start": 4662.12,
      "end": 4665.12,
      "formatted_start": "01:17:42.120",
      "formatted_end": "01:17:45.120",
      "text": "بلکه چند تا سوزند هم اینجام رو میکنند"
    },
    {
      "id": 16,
      "start": 4665.12,
      "end": 4667.12,
      "formatted_start": "01:17:45.120",
      "formatted_end": "01:17:47.120",
      "text": "تو تو قلب رفتی؟"
    },
    {
      "id": 17,
      "start": 4667.12,
      "end": 4668.12,
      "formatted_start": "01:17:47.120",
      "formatted_end": "01:17:48.120",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 4668.12,
      "end": 4670.12,
      "formatted_start": "01:17:48.120",
      "formatted_end": "01:17:50.120",
      "text": "چه گفت تو تو قلب؟"
    },
    {
      "id": 19,
      "start": 4670.12,
      "end": 4674.12,
      "formatted_start": "01:17:50.120",
      "formatted_end": "01:17:54.120",
      "text": "قلب چند روزه هم اینجام درد میگرد، الان اون روز باز کم شد"
    },
    {
      "id": 20,
      "start": 4674.12,
      "end": 4678.12,
      "formatted_start": "01:17:54.120",
      "formatted_end": "01:17:58.120",
      "text": "ناشته ای تمروز که آزماش دادی خیلی بالا بوده"
    },
    {
      "id": 21,
      "start": 4678.12,
      "end": 4680.12,
      "formatted_start": "01:17:58.120",
      "formatted_end": "01:18:00.120",
      "text": "بعضی وقتا قدرت میفته"
    },
    {
      "id": 22,
      "start": 4680.12,
      "end": 4683.12,
      "formatted_start": "01:18:00.120",
      "formatted_end": "01:18:03.120",
      "text": "نه نه، من همون کوستقنم میفترم دارم"
    },
    {
      "id": 23,
      "start": 4683.12,
      "end": 4685.12,
      "formatted_start": "01:18:03.120",
      "formatted_end": "01:18:05.120",
      "text": "خب بعضی وقتا افتقن میدی؟"
    },
    {
      "id": 24,
      "start": 4685.12,
      "end": 4686.12,
      "formatted_start": "01:18:05.120",
      "formatted_end": "01:18:06.120",
      "text": "آره، بعضی وقتا"
    },
    {
      "id": 25,
      "start": 4686.12,
      "end": 4687.12,
      "formatted_start": "01:18:06.120",
      "formatted_end": "01:18:07.120",
      "text": "کهیا افتقن میدی؟"
    },
    {
      "id": 26,
      "start": 4687.12,
      "end": 4690.12,
      "formatted_start": "01:18:07.120",
      "formatted_end": "01:18:10.120",
      "text": "بعضی وقتا کمحال میشه، بهتر ملان میشه میدی"
    },
    {
      "id": 27,
      "start": 4690.12,
      "end": 4693.12,
      "formatted_start": "01:18:10.120",
      "formatted_end": "01:18:13.120",
      "text": "کهیا؟ صبح، زور، شب، بیشتر کهیا؟"
    },
    {
      "id": 28,
      "start": 4693.12,
      "end": 4697.12,
      "formatted_start": "01:18:13.120",
      "formatted_end": "01:18:17.120",
      "text": "بعضی وقتا بعد زورا میشه، شبا میشه"
    },
    {
      "id": 29,
      "start": 4697.12,
      "end": 4702.12,
      "formatted_start": "01:18:17.120",
      "formatted_end": "01:18:22.120",
      "text": "کجا بیشتر میشی؟ پس غذا تو مرکز نمیخوری درسته؟"
    },
    {
      "id": 30,
      "start": 4702.12,
      "end": 4706.12,
      "formatted_start": "01:18:22.120",
      "formatted_end": "01:18:26.120",
      "text": "کم و زیاد می کنید"
    },
    {
      "id": 31,
      "start": 4706.12,
      "end": 4710.12,
      "formatted_start": "01:18:26.120",
      "formatted_end": "01:18:30.120",
      "text": "کم و زیاد می کنید غذاتو"
    },
    {
      "id": 32,
      "start": 4710.12,
      "end": 4714.12,
      "formatted_start": "01:18:30.120",
      "formatted_end": "01:18:34.120",
      "text": "ناشته میده می خورید؟"
    },
    {
      "id": 33,
      "start": 4714.12,
      "end": 4718.12,
      "formatted_start": "01:18:34.120",
      "formatted_end": "01:18:38.120",
      "text": "ناشته میده، بعضی باقی می خورند"
    },
    {
      "id": 34,
      "start": 4718.12,
      "end": 4722.12,
      "formatted_start": "01:18:38.120",
      "formatted_end": "01:18:42.120",
      "text": "اینجا خامتوپس چند ساله، الان هم نیستم"
    },
    {
      "id": 35,
      "start": 4722.12,
      "end": 4726.12,
      "formatted_start": "01:18:42.120",
      "formatted_end": "01:18:46.120",
      "text": "الان گرفتم، باید آب بخورم"
    },
    {
      "id": 36,
      "start": 4726.12,
      "end": 4730.12,
      "formatted_start": "01:18:46.120",
      "formatted_end": "01:18:50.120",
      "text": "میده است اسباسماشه، برس میده تو باید ناشته و مردت بخورید"
    },
    {
      "id": 37,
      "start": 4730.12,
      "end": 4732.12,
      "formatted_start": "01:18:50.120",
      "formatted_end": "01:18:52.120",
      "text": "این گری شاید از سنگی داره"
    },
    {
      "id": 38,
      "start": 4732.12,
      "end": 4733.12,
      "formatted_start": "01:18:52.120",
      "formatted_end": "01:18:53.120",
      "text": "سفرم اگه داری؟"
    },
    {
      "id": 39,
      "start": 4733.12,
      "end": 4734.12,
      "formatted_start": "01:18:53.120",
      "formatted_end": "01:18:54.120",
      "text": "آره"
    },
    {
      "id": 40,
      "start": 4734.12,
      "end": 4736.12,
      "formatted_start": "01:18:54.120",
      "formatted_end": "01:18:56.120",
      "text": "خب بری عمل کنی، معلومه بدتر ات میکنم"
    },
    {
      "id": 41,
      "start": 4737.12,
      "end": 4738.12,
      "formatted_start": "01:18:57.120",
      "formatted_end": "01:18:58.120",
      "text": "چون نمیری عمل کنی؟"
    },
    {
      "id": 42,
      "start": 4738.12,
      "end": 4744.12,
      "formatted_start": "01:18:58.120",
      "formatted_end": "01:19:04.120",
      "text": "اون سال رفتم مشکل گرد، رفتم گفت ببین باید پروراً عمل کنی سو سال پیش"
    },
    {
      "id": 43,
      "start": 4744.12,
      "end": 4749.12,
      "formatted_start": "01:19:04.120",
      "formatted_end": "01:19:09.120",
      "text": "باید عمل کنی، هر روز غن داری، هر روزی که دیر عمل کنی خطر داره"
    },
    {
      "id": 44,
      "start": 4750.12,
      "end": 4753.12,
      "formatted_start": "01:19:10.120",
      "formatted_end": "01:19:13.120",
      "text": "من نمیتونم سنگ داره، سنگ داره مال همین مال داره"
    },
    {
      "id": 45,
      "start": 4753.12,
      "end": 4756.12,
      "formatted_start": "01:19:13.120",
      "formatted_end": "01:19:16.120",
      "text": "پرس مدت بخور برو دنبال عمل"
    },
    {
      "id": 46,
      "start": 4756.12,
      "end": 4760.12,
      "formatted_start": "01:19:16.120",
      "formatted_end": "01:19:20.120",
      "text": "باست ۹۸۷۷۷"
    },
    {
      "id": 47,
      "start": 4786.12,
      "end": 4788.42,
      "formatted_start": "01:19:46.120",
      "formatted_end": "01:19:48.420",
      "text": "من یک سوناگرافی پس براتون می نویسم"
    },
    {
      "id": 48,
      "start": 4788.42,
      "end": 4791.88,
      "formatted_start": "01:19:48.420",
      "formatted_end": "01:19:51.880",
      "text": "سونا جدید نرفته نه؟"
    },
    {
      "id": 49,
      "start": 4791.88,
      "end": 4792.22,
      "formatted_start": "01:19:51.880",
      "formatted_end": "01:19:52.220",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 4792.22,
      "end": 4794.78,
      "formatted_start": "01:19:52.220",
      "formatted_end": "01:19:54.780",
      "text": "بخوان اول خونم یک سونا جدید می خوان خود"
    },
    {
      "id": 51,
      "start": 4794.78,
      "end": 4796.62,
      "formatted_start": "01:19:54.780",
      "formatted_end": "01:19:56.620",
      "text": "سوناگرافی رو بگیر"
    },
    {
      "id": 52,
      "start": 4796.62,
      "end": 4798.34,
      "formatted_start": "01:19:56.620",
      "formatted_end": "01:19:58.340",
      "text": "بعد بریم پیش جراف باشه"
    },
    {
      "id": 53,
      "start": 4798.34,
      "end": 4799.98,
      "formatted_start": "01:19:58.340",
      "formatted_end": "01:19:59.980",
      "text": "آره الان اینکه نمیتونم"
    }
  ],
  "status": "completed"
}