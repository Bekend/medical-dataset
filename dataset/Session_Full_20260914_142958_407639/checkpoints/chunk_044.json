  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13230.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:30.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداری"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13234.4,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:34.400",
      "text": "دیوز این آقای این ناملنده هر ساس رای مانتند روزه پزشت"
    },
    {
      "id": 2,
      "start": 13234.4,
      "end": 13238.12,
      "formatted_start": "03:40:34.400",
      "formatted_end": "03:40:38.120",
      "text": "خوبه همه چیز شکر خود همچی بودن از آن"
    },
    {
      "id": 3,
      "start": 13238.12,
      "end": 13243.04,
      "formatted_start": "03:40:38.120",
      "formatted_end": "03:40:43.040",
      "text": "تو ما اونو هر این اشتباهی کردیم تیمی چندگی خودی"
    },
    {
      "id": 4,
      "start": 13243.04,
      "end": 13246.24,
      "formatted_start": "03:40:43.040",
      "formatted_end": "03:40:46.240",
      "text": "پشیمان کردم هم شهردن"
    },
    {
      "id": 5,
      "start": 13246.24,
      "end": 13248.24,
      "formatted_start": "03:40:46.240",
      "formatted_end": "03:40:48.240",
      "text": "چرا شهردن یه ازیات رو میکنی؟"
    },
    {
      "id": 6,
      "start": 13248.24,
      "end": 13252.24,
      "formatted_start": "03:40:48.240",
      "formatted_end": "03:40:52.240",
      "text": "بخش داره یه بخشی مستاده"
    },
    {
      "id": 7,
      "start": 13252.24,
      "end": 13254.24,
      "formatted_start": "03:40:52.240",
      "formatted_end": "03:40:54.240",
      "text": "آنکنی که مردمان رو سپس میگی؟"
    },
    {
      "id": 8,
      "start": 13254.24,
      "end": 13256.24,
      "formatted_start": "03:40:54.240",
      "formatted_end": "03:40:56.240",
      "text": "شوهرشی نمیزنن، نه اونو گرفتن به شوهرشی"
    },
    {
      "id": 9,
      "start": 13256.24,
      "end": 13258.24,
      "formatted_start": "03:40:56.240",
      "formatted_end": "03:40:58.240",
      "text": "نه باشه"
    },
    {
      "id": 10,
      "start": 13260.24,
      "end": 13262.24,
      "formatted_start": "03:41:00.240",
      "formatted_end": "03:41:02.240",
      "text": "برای آب و برگو کنسه"
    },
    {
      "id": 11,
      "start": 13262.24,
      "end": 13264.24,
      "formatted_start": "03:41:02.240",
      "formatted_end": "03:41:04.240",
      "text": "پشت شوهرگو های صادقی من خوش بگو برم"
    },
    {
      "id": 12,
      "start": 13264.24,
      "end": 13266.24,
      "formatted_start": "03:41:04.240",
      "formatted_end": "03:41:06.240",
      "text": "نه ببنی خود خودمون پستانی"
    },
    {
      "id": 13,
      "start": 13266.24,
      "end": 13268.24,
      "formatted_start": "03:41:06.240",
      "formatted_end": "03:41:08.240",
      "text": "با همه آقای پستانی زنگ زده"
    },
    {
      "id": 14,
      "start": 13268.24,
      "end": 13270.24,
      "formatted_start": "03:41:08.240",
      "formatted_end": "03:41:10.240",
      "text": "اصلا میگم پایینونده هم همینو میگم"
    },
    {
      "id": 15,
      "start": 13270.24,
      "end": 13272.24,
      "formatted_start": "03:41:10.240",
      "formatted_end": "03:41:12.240",
      "text": "یه بی پایینی ها"
    },
    {
      "id": 16,
      "start": 13272.24,
      "end": 13274.24,
      "formatted_start": "03:41:12.240",
      "formatted_end": "03:41:14.240",
      "text": "چیه؟"
    },
    {
      "id": 17,
      "start": 13280.24,
      "end": 13282.24,
      "formatted_start": "03:41:20.240",
      "formatted_end": "03:41:22.240",
      "text": "خوب"
    },
    {
      "id": 18,
      "start": 13282.24,
      "end": 13298.74,
      "formatted_start": "03:41:22.240",
      "formatted_end": "03:41:38.740",
      "text": "این ایراد داشت من بهش گفتم شما اسوویس میخورید یا اینو میخورید"
    },
    {
      "id": 19,
      "start": 13298.74,
      "end": 13300.24,
      "formatted_start": "03:41:38.740",
      "formatted_end": "03:41:40.240",
      "text": "با هم اسوویس بردارید"
    },
    {
      "id": 20,
      "start": 13300.24,
      "end": 13303.24,
      "formatted_start": "03:41:40.240",
      "formatted_end": "03:41:43.240",
      "text": "تو نسخه قبلش هست اسوویس بردارید"
    },
    {
      "id": 21,
      "start": 13303.24,
      "end": 13307.24,
      "formatted_start": "03:41:43.240",
      "formatted_end": "03:41:47.240",
      "text": "من چون روش نوشته که در واقع اصلا فکر میکنم از هم گوتی استفاده داره میکنه"
    },
    {
      "id": 22,
      "start": 13307.24,
      "end": 13319.24,
      "formatted_start": "03:41:47.240",
      "formatted_end": "03:41:59.240",
      "text": "از این بوتی داشته و اما رفته تو بوتی وره هم موجود نشده که بدون آس آر استفاده شده"
    },
    {
      "id": 23,
      "start": 13319.24,
      "end": 13349.22,
      "formatted_start": "03:41:59.240",
      "formatted_end": "03:42:29.220",
      "text": "از اینجا باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 24,
      "start": 13349.24,
      "end": 13352.24,
      "formatted_start": "03:42:29.240",
      "formatted_end": "03:42:32.240",
      "text": "اما سیپت رو بکنم داشتن یکی"
    },
    {
      "id": 25,
      "start": 13352.24,
      "end": 13355.24,
      "formatted_start": "03:42:32.240",
      "formatted_end": "03:42:35.240",
      "text": "این سه تا بود همین یه دارش کردم"
    },
    {
      "id": 26,
      "start": 13355.24,
      "end": 13357.24,
      "formatted_start": "03:42:35.240",
      "formatted_end": "03:42:37.240",
      "text": "تو چون همونو تو افتخان داریشی"
    },
    {
      "id": 27,
      "start": 13357.24,
      "end": 13360.24,
      "formatted_start": "03:42:37.240",
      "formatted_end": "03:42:40.240",
      "text": "شب ها نباید بخونیم زبنها بخونیم"
    },
    {
      "id": 28,
      "start": 13360.24,
      "end": 13364.24,
      "formatted_start": "03:42:40.240",
      "formatted_end": "03:42:44.240",
      "text": "چون سه ماهتون خوبه بردیا برد"
    },
    {
      "id": 29,
      "start": 13364.24,
      "end": 13368.24,
      "formatted_start": "03:42:44.240",
      "formatted_end": "03:42:48.240",
      "text": "اما ناشته ها باید دو ساپ بعد از افتخان داشتیم داریم"
    },
    {
      "id": 30,
      "start": 13368.24,
      "end": 13372.24,
      "formatted_start": "03:42:48.240",
      "formatted_end": "03:42:52.240",
      "text": "خب معمولا شام هم کم بخونیم هم فاصله ش با سخانه زیاده"
    },
    {
      "id": 31,
      "start": 13372.24,
      "end": 13374.24,
      "formatted_start": "03:42:52.240",
      "formatted_end": "03:42:54.240",
      "text": "نهار باید بخونیم"
    },
    {
      "id": 32,
      "start": 13374.24,
      "end": 13375.24,
      "formatted_start": "03:42:54.240",
      "formatted_end": "03:42:55.240",
      "text": "خب چشمتون برم"
    },
    {
      "id": 33,
      "start": 13375.24,
      "end": 13378.24,
      "formatted_start": "03:42:55.240",
      "formatted_end": "03:42:58.240",
      "text": "آره دیگه شرکت نخوریم دوست یک دونه"
    },
    {
      "id": 34,
      "start": 13378.24,
      "end": 13382.24,
      "formatted_start": "03:42:58.240",
      "formatted_end": "03:43:02.240",
      "text": "کلیتون خوبه، چربی خوبه، آنزیمای کبد خوبه"
    },
    {
      "id": 35,
      "start": 13382.24,
      "end": 13387.24,
      "formatted_start": "03:43:02.240",
      "formatted_end": "03:43:07.240",
      "text": "پروستاد اندازه برخیمی چیزی نداره، تیروید معموله"
    },
    {
      "id": 36,
      "start": 13387.24,
      "end": 13390.24,
      "formatted_start": "03:43:07.240",
      "formatted_end": "03:43:10.240",
      "text": "اما پروستاد خوب نداره"
    },
    {
      "id": 37,
      "start": 13390.24,
      "end": 13393.24,
      "formatted_start": "03:43:10.240",
      "formatted_end": "03:43:13.240",
      "text": "در این حال موضوع همین بود"
    },
    {
      "id": 38,
      "start": 13393.24,
      "end": 13395.24,
      "formatted_start": "03:43:13.240",
      "formatted_end": "03:43:15.240",
      "text": "او تا شاید چیزی هست"
    },
    {
      "id": 39,
      "start": 13395.24,
      "end": 13400.24,
      "formatted_start": "03:43:15.240",
      "formatted_end": "03:43:20.240",
      "text": "آنجوریتون سرچه از آب و چه استفاده میکنند، باید باید سرپاشی میکنند، اعتماد داره از این موشه"
    },
    {
      "id": 40,
      "start": 13400.24,
      "end": 13404.24,
      "formatted_start": "03:43:20.240",
      "formatted_end": "03:43:24.240",
      "text": "آقا چاپ برای شما دیوهات این اصلا آقا چاپ نخواهید"
    },
    {
      "id": 41,
      "start": 13404.24,
      "end": 13409.24,
      "formatted_start": "03:43:24.240",
      "formatted_end": "03:43:29.240",
      "text": "آقا چاپ مسئولیت های خیلی بحشنگه درشو کشنده این میتونه بود"
    },
    {
      "id": 42,
      "start": 13409.24,
      "end": 13416.24,
      "formatted_start": "03:43:29.240",
      "formatted_end": "03:43:36.240",
      "text": "اگر ما داریم از نالسایه کلیه شدید، نالسایه قلبی، نالسایه قلبی شدید، نالسایه کبد شدید"
    },
    {
      "id": 43,
      "start": 13416.24,
      "end": 13419.24,
      "formatted_start": "03:43:36.240",
      "formatted_end": "03:43:39.240",
      "text": "اصلا آقا چاپ نخواهید اما ادرارتون راحت میاد؟"
    },
    {
      "id": 44,
      "start": 13419.24,
      "end": 13420.24,
      "formatted_start": "03:43:39.240",
      "formatted_end": "03:43:40.240",
      "text": "آقا چاپ نخواهید"
    },
    {
      "id": 45,
      "start": 13420.24,
      "end": 13422.24,
      "formatted_start": "03:43:40.240",
      "formatted_end": "03:43:42.240",
      "text": "اصلا باریک نشده؟ نالسایه کلیه شدید؟"
    },
    {
      "id": 46,
      "start": 13422.24,
      "end": 13424.24,
      "formatted_start": "03:43:42.240",
      "formatted_end": "03:43:44.240",
      "text": "مثلا گیر نمی کند"
    },
    {
      "id": 47,
      "start": 13424.24,
      "end": 13427.24,
      "formatted_start": "03:43:44.240",
      "formatted_end": "03:43:47.240",
      "text": "ادارتون مثلا با پنج سال قبلتون"
    },
    {
      "id": 48,
      "start": 13427.24,
      "end": 13431.24,
      "formatted_start": "03:43:47.240",
      "formatted_end": "03:43:51.240",
      "text": "مرکزیت اداره کردنتون فشارش میزانش یکیه"
    },
    {
      "id": 49,
      "start": 13431.24,
      "end": 13435.24,
      "formatted_start": "03:43:51.240",
      "formatted_end": "03:43:55.240",
      "text": "هران یک باری یک احساس نمیدونید بخش دارید گیر تب و تخیر"
    },
    {
      "id": 50,
      "start": 13435.24,
      "end": 13436.24,
      "formatted_start": "03:43:55.240",
      "formatted_end": "03:43:56.240",
      "text": "میان"
    },
    {
      "id": 51,
      "start": 13436.24,
      "end": 13439.24,
      "formatted_start": "03:43:56.240",
      "formatted_end": "03:43:59.240",
      "text": "خیلی نزدیکیده خیلی کم جایی که دو سالی اینا بود"
    },
    {
      "id": 52,
      "start": 13439.24,
      "end": 13443.24,
      "formatted_start": "03:43:59.240",
      "formatted_end": "03:44:03.240",
      "text": "چون پروستات برام داره سونا گرفت کردین پروستاتتونو"
    },
    {
      "id": 53,
      "start": 13443.24,
      "end": 13444.24,
      "formatted_start": "03:44:03.240",
      "formatted_end": "03:44:04.240",
      "text": "جیدن نمیدونید"
    },
    {
      "id": 54,
      "start": 13444.24,
      "end": 13445.24,
      "formatted_start": "03:44:04.240",
      "formatted_end": "03:44:05.240",
      "text": "آخر ماه که بودم"
    },
    {
      "id": 55,
      "start": 13445.24,
      "end": 13446.24,
      "formatted_start": "03:44:05.240",
      "formatted_end": "03:44:06.240",
      "text": "آرسو بودیم"
    },
    {
      "id": 56,
      "start": 13446.24,
      "end": 13448.24,
      "formatted_start": "03:44:06.240",
      "formatted_end": "03:44:08.240",
      "text": "پروستاتتونو سونا انجام بودید"
    },
    {
      "id": 57,
      "start": 13448.24,
      "end": 13478.24,
      "formatted_start": "03:44:08.240",
      "formatted_end": "03:44:38.240",
      "text": "افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستانی افغانستان"
    },
    {
      "id": 58,
      "start": 13478.24,
      "end": 13480.24,
      "formatted_start": "03:44:38.240",
      "formatted_end": "03:44:40.240",
      "text": "و از در مورد چیز همه چیز تأثیر نداره"
    },
    {
      "id": 59,
      "start": 13480.24,
      "end": 13481.24,
      "formatted_start": "03:44:40.240",
      "formatted_end": "03:44:41.240",
      "text": "آره دیگه فرقش اینه"
    },
    {
      "id": 60,
      "start": 13481.24,
      "end": 13483.24,
      "formatted_start": "03:44:41.240",
      "formatted_end": "03:44:43.240",
      "text": "زیبتین و زیبمیت"
    },
    {
      "id": 61,
      "start": 13483.24,
      "end": 13485.24,
      "formatted_start": "03:44:43.240",
      "formatted_end": "03:44:45.240",
      "text": "ترکیل متفرمین آهستگاهش"
    },
    {
      "id": 62,
      "start": 13485.24,
      "end": 13488.24,
      "formatted_start": "03:44:45.240",
      "formatted_end": "03:44:48.240",
      "text": "به اضافه دابر سیتاگلیبتین"
    },
    {
      "id": 63,
      "start": 13488.24,
      "end": 13491.24,
      "formatted_start": "03:44:48.240",
      "formatted_end": "03:44:51.240",
      "text": "سیتاگلیبتین رو تر بس هیچ تأثیر نداره"
    },
    {
      "id": 64,
      "start": 13491.24,
      "end": 13495.24,
      "formatted_start": "03:44:51.240",
      "formatted_end": "03:44:55.240",
      "text": "مثلا خارجی هم خیلی بس برته نداره"
    },
    {
      "id": 65,
      "start": 13495.24,
      "end": 13496.24,
      "formatted_start": "03:44:55.240",
      "formatted_end": "03:44:56.240",
      "text": "اما ایرانی ها چرا؟"
    },
    {
      "id": 66,
      "start": 13496.24,
      "end": 13498.24,
      "formatted_start": "03:44:56.240",
      "formatted_end": "03:44:58.240",
      "text": "کاششتای شریک میده"
    },
    {
      "id": 67,
      "start": 13498.24,
      "end": 13500.24,
      "formatted_start": "03:44:58.240",
      "formatted_end": "03:45:00.240",
      "text": "اگر نظره هزه نو بیمه موزه"
    }
  ],
  "status": "completed"
}