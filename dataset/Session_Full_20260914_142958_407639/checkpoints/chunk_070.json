      "formatted_end": "05:50:36.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 4,
      "start": 21036.0,
      "end": 21038.0,
      "formatted_start": "05:50:36.000",
      "formatted_end": "05:50:38.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 5,
      "start": 21038.0,
      "end": 21040.0,
      "formatted_start": "05:50:38.000",
      "formatted_end": "05:50:40.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 6,
      "start": 21040.0,
      "end": 21042.0,
      "formatted_start": "05:50:40.000",
      "formatted_end": "05:50:42.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 7,
      "start": 21042.0,
      "end": 21044.0,
      "formatted_start": "05:50:42.000",
      "formatted_end": "05:50:44.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 8,
      "start": 21044.0,
      "end": 21046.0,
      "formatted_start": "05:50:44.000",
      "formatted_end": "05:50:46.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 9,
      "start": 21046.0,
      "end": 21048.0,
      "formatted_start": "05:50:46.000",
      "formatted_end": "05:50:48.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 10,
      "start": 21048.0,
      "end": 21050.0,
      "formatted_start": "05:50:48.000",
      "formatted_end": "05:50:50.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 11,
      "start": 21050.0,
      "end": 21052.0,
      "formatted_start": "05:50:50.000",
      "formatted_end": "05:50:52.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 12,
      "start": 21052.0,
      "end": 21054.0,
      "formatted_start": "05:50:52.000",
      "formatted_end": "05:50:54.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 13,
      "start": 21054.0,
      "end": 21056.0,
      "formatted_start": "05:50:54.000",
      "formatted_end": "05:50:56.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 14,
      "start": 21056.0,
      "end": 21058.0,
      "formatted_start": "05:50:56.000",
      "formatted_end": "05:50:58.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 15,
      "start": 21060.0,
      "end": 21090.0,
      "formatted_start": "05:51:00.000",
      "formatted_end": "05:51:30.000",
      "text": "اما اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، اینجا که امکان را براش دارید، ا"
    },
    {
      "id": 16,
      "start": 21090.0,
      "end": 21091.0,
      "formatted_start": "05:51:30.000",
      "formatted_end": "05:51:31.000",
      "text": "سنگ خوردی؟"
    },
    {
      "id": 17,
      "start": 21091.0,
      "end": 21092.0,
      "formatted_start": "05:51:31.000",
      "formatted_end": "05:51:32.000",
      "text": "نه، نه دارم"
    },
    {
      "id": 18,
      "start": 21092.0,
      "end": 21093.0,
      "formatted_start": "05:51:32.000",
      "formatted_end": "05:51:33.000",
      "text": "هیچی؟"
    },
    {
      "id": 19,
      "start": 21093.0,
      "end": 21095.0,
      "formatted_start": "05:51:33.000",
      "formatted_end": "05:51:35.000",
      "text": "که عمد کرد؟"
    },
    {
      "id": 20,
      "start": 21095.0,
      "end": 21098.0,
      "formatted_start": "05:51:35.000",
      "formatted_end": "05:51:38.000",
      "text": "دو بیشمان، علیه پیرمان"
    },
    {
      "id": 21,
      "start": 21098.0,
      "end": 21100.0,
      "formatted_start": "05:51:38.000",
      "formatted_end": "05:51:40.000",
      "text": "نه، همینجا خودتون معرفی کردیم"
    },
    {
      "id": 22,
      "start": 21100.0,
      "end": 21102.0,
      "formatted_start": "05:51:40.000",
      "formatted_end": "05:51:42.000",
      "text": "خودت معرفی کردید، دکتور"
    },
    {
      "id": 23,
      "start": 21102.0,
      "end": 21103.0,
      "formatted_start": "05:51:42.000",
      "formatted_end": "05:51:43.000",
      "text": "مومبت؟"
    },
    {
      "id": 24,
      "start": 21103.0,
      "end": 21104.0,
      "formatted_start": "05:51:43.000",
      "formatted_end": "05:51:44.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 21104.0,
      "end": 21105.0,
      "formatted_start": "05:51:44.000",
      "formatted_end": "05:51:45.000",
      "text": "شفید خوش؟"
    },
    {
      "id": 26,
      "start": 21105.0,
      "end": 21106.0,
      "formatted_start": "05:51:45.000",
      "formatted_end": "05:51:46.000",
      "text": "نه، نجمزدانه شد"
    },
    {
      "id": 27,
      "start": 21106.0,
      "end": 21107.0,
      "formatted_start": "05:51:46.000",
      "formatted_end": "05:51:47.000",
      "text": "نجمزدانه"
    },
    {
      "id": 28,
      "start": 21107.0,
      "end": 21109.0,
      "formatted_start": "05:51:47.000",
      "formatted_end": "05:51:49.000",
      "text": "کیس صفراش رو میگیم عمد کردیم"
    },
    {
      "id": 29,
      "start": 21109.0,
      "end": 21113.0,
      "formatted_start": "05:51:49.000",
      "formatted_end": "05:51:53.000",
      "text": "کیس صفراش هم بود، کلیه شان سنگ داشت"
    },
    {
      "id": 30,
      "start": 21113.0,
      "end": 21118.0,
      "formatted_start": "05:51:53.000",
      "formatted_end": "05:51:58.000",
      "text": "خب، از کلیه تو که عمد نکردی"
    },
    {
      "id": 31,
      "start": 21118.0,
      "end": 21120.0,
      "formatted_start": "05:51:58.000",
      "formatted_end": "05:52:00.000",
      "text": "نه، سنگ داشته"
    },
    {
      "id": 32,
      "start": 21120.0,
      "end": 21121.0,
      "formatted_start": "05:52:00.000",
      "formatted_end": "05:52:01.000",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 21121.0,
      "end": 21124.0,
      "formatted_start": "05:52:01.000",
      "formatted_end": "05:52:04.000",
      "text": "خوشا نگاه کنم بگم سیتی آخر رو دارم"
    },
    {
      "id": 34,
      "start": 21126.0,
      "end": 21128.0,
      "formatted_start": "05:52:06.000",
      "formatted_end": "05:52:08.000",
      "text": "ادالت من بومیده؟"
    },
    {
      "id": 35,
      "start": 21129.0,
      "end": 21131.0,
      "formatted_start": "05:52:09.000",
      "formatted_end": "05:52:11.000",
      "text": "اول آره"
    },
    {
      "id": 36,
      "start": 21131.0,
      "end": 21133.0,
      "formatted_start": "05:52:11.000",
      "formatted_end": "05:52:13.000",
      "text": "که عمل نکرده بودم"
    },
    {
      "id": 37,
      "start": 21133.0,
      "end": 21135.0,
      "formatted_start": "05:52:13.000",
      "formatted_end": "05:52:15.000",
      "text": "الان؟"
    },
    {
      "id": 38,
      "start": 21135.0,
      "end": 21137.0,
      "formatted_start": "05:52:15.000",
      "formatted_end": "05:52:17.000",
      "text": "الان چشم ادالت میسوزه یا نه؟"
    },
    {
      "id": 39,
      "start": 21137.0,
      "end": 21140.0,
      "formatted_start": "05:52:17.000",
      "formatted_end": "05:52:20.000",
      "text": "الان مثلا دو سه روز خوبه"
    },
    {
      "id": 40,
      "start": 21140.0,
      "end": 21144.0,
      "formatted_start": "05:52:20.000",
      "formatted_end": "05:52:24.000",
      "text": "باز نبینی دو روز باز یکم سوزش داره"
    },
    {
      "id": 41,
      "start": 21144.0,
      "end": 21146.0,
      "formatted_start": "05:52:24.000",
      "formatted_end": "05:52:26.000",
      "text": "مثلا بند نیاد بود"
    },
    {
      "id": 42,
      "start": 21146.0,
      "end": 21147.0,
      "formatted_start": "05:52:26.000",
      "formatted_end": "05:52:27.000",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 21147.0,
      "end": 21149.0,
      "formatted_start": "05:52:27.000",
      "formatted_end": "05:52:29.000",
      "text": "این کمه هایی که باید بردارید، باید بردارید."
    },
    {
      "id": 44,
      "start": 21149.0,
      "end": 21151.0,
      "formatted_start": "05:52:29.000",
      "formatted_end": "05:52:31.000",
      "text": "این کمه هایی که باید بردارید، باید بردارید."
    },
    {
      "id": 45,
      "start": 21151.0,
      "end": 21153.0,
      "formatted_start": "05:52:31.000",
      "formatted_end": "05:52:33.000",
      "text": "این کمه هایی که باید بردارید، باید بردارید."
    },
    {
      "id": 46,
      "start": 21153.0,
      "end": 21155.0,
      "formatted_start": "05:52:33.000",
      "formatted_end": "05:52:35.000",
      "text": "این کمه هایی که باید بردارید، باید بردارید."
    },
    {
      "id": 47,
      "start": 21155.0,
      "end": 21157.0,
      "formatted_start": "05:52:35.000",
      "formatted_end": "05:52:37.000",
      "text": "این کمه هایی که بردارید، باید بردارید."
    },
    {
      "id": 48,
      "start": 21157.0,
      "end": 21159.0,
      "formatted_start": "05:52:37.000",
      "formatted_end": "05:52:39.000",
      "text": "این کمه هایی که بردارید، باید بردارید."
    },
    {
      "id": 49,
      "start": 21159.0,
      "end": 21165.0,
      "formatted_start": "05:52:39.000",
      "formatted_end": "05:52:45.000",
      "text": "این کمر رو من هم چیزی که بودم آرکنه"
    },
    {
      "id": 50,
      "start": 21165.0,
      "end": 21173.0,
      "formatted_start": "05:52:45.000",
      "formatted_end": "05:52:53.000",
      "text": "بعد این دوتا پان درد خیلی شدیدیه مثلا"
    },
    {
      "id": 51,
      "start": 21173.0,
      "end": 21178.0,
      "formatted_start": "05:52:53.000",
      "formatted_end": "05:52:58.000",
      "text": "به کوریا هم چیز میکنه مربوط میشه"
    },
    {
      "id": 52,
      "start": 21178.0,
      "end": 21179.0,
      "formatted_start": "05:52:58.000",
      "formatted_end": "05:52:59.000",
      "text": "چی؟"
    },
    {
      "id": 53,
      "start": 21179.0,
      "end": 21180.0,
      "formatted_start": "05:52:59.000",
      "formatted_end": "05:53:00.000",
      "text": "مثلا از"
    },
    {
      "id": 54,
      "start": 21180.0,
      "end": 21181.0,
      "formatted_start": "05:53:00.000",
      "formatted_end": "05:53:01.000",
      "text": "برد پا؟"
    },
    {
      "id": 55,
      "start": 21181.0,
      "end": 21182.0,
      "formatted_start": "05:53:01.000",
      "formatted_end": "05:53:02.000",
      "text": "برد پا"
    },
    {
      "id": 56,
      "start": 21182.0,
      "end": 21184.0,
      "formatted_start": "05:53:02.000",
      "formatted_end": "05:53:04.000",
      "text": "کوریا مربوط میشه"
    },
    {
      "id": 57,
      "start": 21184.0,
      "end": 21187.0,
      "formatted_start": "05:53:04.000",
      "formatted_end": "05:53:07.000",
      "text": "ببین بیشتر برد پا مال کمره که"
    },
    {
      "id": 58,
      "start": 21187.0,
      "end": 21189.0,
      "formatted_start": "05:53:07.000",
      "formatted_end": "05:53:09.000",
      "text": "برای کمرش بردن نمیشه؟"
    },
    {
      "id": 59,
      "start": 21191.0,
      "end": 21193.0,
      "formatted_start": "05:53:11.000",
      "formatted_end": "05:53:13.000",
      "text": "نه باش کمرش یکم جا به جایی دارد"
    },
    {
      "id": 60,
      "start": 21193.0,
      "end": 21195.0,
      "formatted_start": "05:53:13.000",
      "formatted_end": "05:53:15.000",
      "text": "نه نه"
    },
    {
      "id": 61,
      "start": 21195.0,
      "end": 21197.0,
      "formatted_start": "05:53:15.000",
      "formatted_end": "05:53:17.000",
      "text": "تو چیزون کنست"
    },
    {
      "id": 62,
      "start": 21197.0,
      "end": 21199.0,
      "formatted_start": "05:53:17.000",
      "formatted_end": "05:53:19.000",
      "text": "حالا باید سی تی کنه دیگه"
    },
    {
      "id": 63,
      "start": 21199.0,
      "end": 21201.0,
      "formatted_start": "05:53:19.000",
      "formatted_end": "05:53:21.000",
      "text": "برین نواره سنگ چقدریه"
    },
    {
      "id": 64,
      "start": 21201.0,
      "end": 21203.0,
      "formatted_start": "05:53:21.000",
      "formatted_end": "05:53:23.000",
      "text": "چی کار شده"
    },
    {
      "id": 65,
      "start": 21203.0,
      "end": 21205.0,
      "formatted_start": "05:53:23.000",
      "formatted_end": "05:53:25.000",
      "text": "بیمارسان چیز انجام بده"
    },
    {
      "id": 66,
      "start": 21205.0,
      "end": 21207.0,
      "formatted_start": "05:53:25.000",
      "formatted_end": "05:53:27.000",
      "text": "هزار پرسون پشتون موهده"
    },
    {
      "id": 67,
      "start": 21207.0,
      "end": 21209.0,
      "formatted_start": "05:53:27.000",
      "formatted_end": "05:53:29.000",
      "text": "سلامت باشه عزیز"
    },
    {
      "id": 68,
      "start": 21211.0,
      "end": 21213.0,
      "formatted_start": "05:53:31.000",
      "formatted_end": "05:53:33.000",
      "text": "آمده؟"
    },
    {
      "id": 69,
      "start": 21213.0,
      "end": 21215.0,
      "formatted_start": "05:53:33.000",
      "formatted_end": "05:53:35.000",
      "text": "اینجا درد می کنم"
    },
    {
      "id": 70,
      "start": 21215.0,
      "end": 21221.0,
      "formatted_start": "05:53:35.000",
      "formatted_end": "05:53:41.000",
      "text": "اینجا بیشتره"
    },
    {
      "id": 71,
      "start": 21221.0,
      "end": 21227.0,
      "formatted_start": "05:53:41.000",
      "formatted_end": "05:53:47.000",
      "text": "اینجا؟ اینجا؟ اینکه سر استخانه یا آتاریز استخانه"
    },
    {
      "id": 72,
      "start": 21227.0,
      "end": 21231.0,
      "formatted_start": "05:53:47.000",
      "formatted_end": "05:53:51.000",
      "text": "این کالیه درد می کنه، اینو درد می کنه"
    },
    {
      "id": 73,
      "start": 21231.0,
      "end": 21237.0,
      "formatted_start": "05:53:51.000",
      "formatted_end": "05:53:57.000",
      "text": "اینجا فشار می دهند، درد می کنه"
    },
    {
      "id": 74,
      "start": 21237.0,
      "end": 21241.0,
      "formatted_start": "05:53:57.000",
      "formatted_end": "05:54:01.000",
      "text": "اینو کالیه دید، اون استخانه درد می کنه"
    },
    {
      "id": 75,
      "start": 21241.0,
      "end": 21244.0,
      "formatted_start": "05:54:01.000",
      "formatted_end": "05:54:04.000",
      "text": "میگم نیست کالیت. میگه نه کولیان."
    },
    {
      "id": 76,
      "start": 21244.0,
      "end": 21245.0,
      "formatted_start": "05:54:04.000",
      "formatted_end": "05:54:05.000",
      "text": "تکیه بود عزیزم."
    },
    {
      "id": 77,
      "start": 21246.0,
      "end": 21247.0,
      "formatted_start": "05:54:06.000",
      "formatted_end": "05:54:07.000",
      "text": "ها میگه کولیان."
    },
    {
      "id": 78,
      "start": 21251.0,
      "end": 21252.0,
      "formatted_start": "05:54:11.000",
      "formatted_end": "05:54:12.000",
      "text": "اینجا درد داره؟"
    },
    {
      "id": 79,
      "start": 21252.0,
      "end": 21253.0,
      "formatted_start": "05:54:12.000",
      "formatted_end": "05:54:13.000",
      "text": "آره."
    },
    {
      "id": 80,
      "start": 21253.0,
      "end": 21255.0,
      "formatted_start": "05:54:13.000",
      "formatted_end": "05:54:15.000",
      "text": "آره اینها میشه اونجا درد بیشتر."
    },
    {
      "id": 81,
      "start": 21255.0,
      "end": 21257.0,
      "formatted_start": "05:54:15.000",
      "formatted_end": "05:54:17.000",
      "text": "خب محسا نشون خونه دارم."
    },
    {
      "id": 82,
      "start": 21257.0,
      "end": 21258.0,
      "formatted_start": "05:54:17.000",
      "formatted_end": "05:54:18.000",
      "text": "نه."
    },
    {
      "id": 83,
      "start": 21259.0,
      "end": 21262.0,
      "formatted_start": "05:54:19.000",
      "formatted_end": "05:54:22.000",
      "text": "یه از زمینجا تا اینجا اونجا."
    },
    {
      "id": 84,
      "start": 21264.0,
      "end": 21266.0,
