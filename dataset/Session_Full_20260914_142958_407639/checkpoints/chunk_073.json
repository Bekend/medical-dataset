      "formatted_start": "06:05:00.000",
      "formatted_end": "06:05:02.000",
      "text": "اینجا باید بخوریم."
    },
    {
      "id": 1,
      "start": 21908.0,
      "end": 21910.0,
      "formatted_start": "06:05:08.000",
      "formatted_end": "06:05:10.000",
      "text": "اینجا بودیم دامانم."
    },
    {
      "id": 2,
      "start": 21910.0,
      "end": 21912.0,
      "formatted_start": "06:05:10.000",
      "formatted_end": "06:05:12.000",
      "text": "نیکویی."
    },
    {
      "id": 3,
      "start": 21912.0,
      "end": 21914.0,
      "formatted_start": "06:05:12.000",
      "formatted_end": "06:05:14.000",
      "text": "آره، آره."
    },
    {
      "id": 4,
      "start": 21914.0,
      "end": 21916.0,
      "formatted_start": "06:05:14.000",
      "formatted_end": "06:05:16.000",
      "text": "دوست دارید؟"
    },
    {
      "id": 5,
      "start": 21916.0,
      "end": 21918.0,
      "formatted_start": "06:05:16.000",
      "formatted_end": "06:05:18.000",
      "text": "آره، دوست دارید؟"
    },
    {
      "id": 6,
      "start": 21918.0,
      "end": 21920.0,
      "formatted_start": "06:05:18.000",
      "formatted_end": "06:05:20.000",
      "text": "آره، دوست دارید؟"
    },
    {
      "id": 7,
      "start": 21920.0,
      "end": 21922.0,
      "formatted_start": "06:05:20.000",
      "formatted_end": "06:05:22.000",
