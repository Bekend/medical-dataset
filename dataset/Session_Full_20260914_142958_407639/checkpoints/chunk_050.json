  "stt_segments": [
    {
      "id": 0,
      "start": 15000.0,
      "end": 15010.0,
      "formatted_start": "04:10:00.000",
      "formatted_end": "04:10:10.000",
      "text": "ببین این پای که درده که مای نیزارم، ایشو ممکنه هر لحظه پشت پشت ببینفتر. دادن دور ازشون این مریض همه کشی کسی بیا بگن."
    },
    {
      "id": 1,
      "start": 15010.0,
      "end": 15019.0,
      "formatted_start": "04:10:10.000",
      "formatted_end": "04:10:19.000",
      "text": "ببین دیگه، موقعاً میخوادم بیشین، از این نمالیه، دیوتوری هم زده دیگه، موقعاً موازه بدم، در رنگی روز این حالت ها به ما،"
    },
    {
      "id": 2,
      "start": 15019.0,
      "end": 15049.0,
      "formatted_start": "04:10:19.000",
      "formatted_end": "04:10:49.000",
