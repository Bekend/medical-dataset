      "id": 72,
      "start": 15227.56,
      "end": 15230.56,
      "formatted_start": "04:13:47.560",
      "formatted_end": "04:13:50.560",
      "text": "یعنی خوب هست. خوب هست. با دو برداری برم."
    },
