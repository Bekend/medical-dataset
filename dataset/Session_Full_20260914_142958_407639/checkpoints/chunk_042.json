  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12619.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:19.000",
      "text": "سفت کنیم تو سیستم، بعد دیابت داشتم که گفتم یه سالی بود بذاشتم کنار قرصو اینا رو، آزمایش رو دیدیم گفتیم خیلی بالاستو، هم باید برای قرص گلورنتا ده پنج دادیم برای قند، برای چربیم هم یکی برای زور، یکی برای شب میخورم."
    },
    {
      "id": 1,
      "start": 12619.0,
      "end": 12625.0,
      "formatted_start": "03:30:19.000",
      "formatted_end": "03:30:25.000",
      "text": "از اینجا باید گفتیم که از اسفان و مصطفی را خاطر کنیم و رفتم"
    },
    {
      "id": 2,
      "start": 12625.0,
      "end": 12629.0,
      "formatted_start": "03:30:25.000",
      "formatted_end": "03:30:29.000",
      "text": "اینجا نادار مشقله بود و دیگر قرص غرن تمام شد"
    },
    {
      "id": 3,
      "start": 12629.0,
      "end": 12633.0,
      "formatted_start": "03:30:29.000",
      "formatted_end": "03:30:33.000",
      "text": "و از اینجا باید بردارم کلمتون را بازیم و از اینجا باید مجدد سلام میدونیم"
    },
    {
      "id": 4,
      "start": 12633.0,
      "end": 12635.0,
      "formatted_start": "03:30:33.000",
      "formatted_end": "03:30:35.000",
      "text": "اینجا اینجا برای قرص را نخوردید و نسلوید کردید؟"
    },
    {
      "id": 5,
      "start": 12635.0,
      "end": 12639.0,
      "formatted_start": "03:30:35.000",
      "formatted_end": "03:30:39.000",
      "text": "نه چرا؟ میگم اینجا دو روز در اینجا تمام شد"
    },
    {
      "id": 6,
      "start": 12639.0,
      "end": 12643.0,
      "formatted_start": "03:30:39.000",
      "formatted_end": "03:30:43.000",
      "text": "اهمیت قرص غرن اتون را متوجه نشده هست"
    },
    {
      "id": 7,
      "start": 12643.0,
      "end": 12645.0,
      "formatted_start": "03:30:43.000",
      "formatted_end": "03:30:45.000",
      "text": "چقدر میتونی کلیه و چشمیت و داقم"
    },
    {
      "id": 8,
      "start": 12645.0,
      "end": 12645.5,
      "formatted_start": "03:30:45.000",
      "formatted_end": "03:30:45.500",
      "text": "بله"
    },
    {
      "id": 9,
      "start": 12645.5,
      "end": 12647.5,
      "formatted_start": "03:30:45.500",
      "formatted_end": "03:30:47.500",
      "text": "من حتی میگم اسفان رفتم"
    },
    {
      "id": 10,
      "start": 12647.5,
      "end": 12649.5,
      "formatted_start": "03:30:47.500",
      "formatted_end": "03:30:49.500",
      "text": "به اگرمانه که کارمون دو سه روز طول می کشه"
    },
    {
      "id": 11,
      "start": 12649.5,
      "end": 12651.5,
      "formatted_start": "03:30:49.500",
      "formatted_end": "03:30:51.500",
      "text": "اونجا تمام شد"
    },
    {
      "id": 12,
      "start": 12651.5,
      "end": 12653.5,
      "formatted_start": "03:30:51.500",
      "formatted_end": "03:30:53.500",
      "text": "خورستم رفتم آزاد گرفتم"
    },
    {
      "id": 13,
      "start": 12653.5,
      "end": 12655.5,
      "formatted_start": "03:30:53.500",
      "formatted_end": "03:30:55.500",
      "text": "گرفتم خوردم"
    },
    {
      "id": 14,
      "start": 12655.5,
      "end": 12657.5,
      "formatted_start": "03:30:55.500",
      "formatted_end": "03:30:57.500",
      "text": "اینجا میتونیت بگفتن اون رو قطع کرده باشم"
    },
    {
      "id": 15,
      "start": 12657.5,
      "end": 12659.5,
      "formatted_start": "03:30:57.500",
      "formatted_end": "03:30:59.500",
      "text": "خیلی"
    },
    {
      "id": 16,
      "start": 12659.5,
      "end": 12661.5,
      "formatted_start": "03:30:59.500",
      "formatted_end": "03:31:01.500",
      "text": "دیروز دیگه تمام شد دیروز اگر رفتم گرگان"
    },
    {
      "id": 17,
      "start": 12661.5,
      "end": 12663.5,
      "formatted_start": "03:31:01.500",
      "formatted_end": "03:31:03.500",
      "text": "کارم طول کشید نتونستم بیان خودمون"
    },
    {
      "id": 18,
      "start": 12663.5,
      "end": 12665.5,
      "formatted_start": "03:31:03.500",
      "formatted_end": "03:31:05.500",
      "text": "امروز گفتم"
    },
    {
      "id": 19,
      "start": 12665.5,
      "end": 12667.5,
      "formatted_start": "03:31:05.500",
      "formatted_end": "03:31:07.500",
      "text": "هر وقت که به هر دلیلی نتونستی بیان"
    },
    {
      "id": 20,
      "start": 12667.5,
      "end": 12669.5,
      "formatted_start": "03:31:07.500",
      "formatted_end": "03:31:09.500",
      "text": "بگیرن و تلفونی داروتونو بزنید"
    },
    {
      "id": 21,
      "start": 12669.5,
      "end": 12671.5,
      "formatted_start": "03:31:09.500",
      "formatted_end": "03:31:11.500",
      "text": "ولی داروتونو تحت ایش شرح اعتقاد نکنید"
    },
    {
      "id": 22,
      "start": 12671.5,
      "end": 12673.5,
      "formatted_start": "03:31:11.500",
      "formatted_end": "03:31:13.500",
      "text": "درسته"
    },
    {
      "id": 23,
      "start": 12673.5,
      "end": 12677.5,
      "formatted_start": "03:31:13.500",
      "formatted_end": "03:31:17.500",
      "text": "چون شما محرزی تو سرم خوردیدی که نیست که بگیرن و تمام شد"
    },
    {
      "id": 24,
      "start": 12677.5,
      "end": 12679.5,
      "formatted_start": "03:31:17.500",
      "formatted_end": "03:31:19.500",
      "text": "بله بله"
    },
    {
      "id": 25,
      "start": 12679.5,
      "end": 12681.5,
      "formatted_start": "03:31:19.500",
      "formatted_end": "03:31:21.500",
      "text": "خوب گلی کلازید هم داشتید"
    },
    {
      "id": 26,
      "start": 12681.5,
      "end": 12683.5,
      "formatted_start": "03:31:21.500",
      "formatted_end": "03:31:23.500",
      "text": "آره دارم"
    },
    {
      "id": 27,
      "start": 12683.5,
      "end": 12685.5,
      "formatted_start": "03:31:23.500",
      "formatted_end": "03:31:25.500",
      "text": "صبح و شب میخورید؟"
    },
    {
      "id": 28,
      "start": 12685.5,
      "end": 12687.5,
      "formatted_start": "03:31:25.500",
      "formatted_end": "03:31:27.500",
      "text": "نصف قبل از صبح و نصف قبل از شام دارم"
    },
    {
      "id": 29,
      "start": 12687.5,
      "end": 12689.5,
      "formatted_start": "03:31:27.500",
      "formatted_end": "03:31:29.500",
      "text": "اون روز یه گلی کامل دست نخورده است"
    },
    {
      "id": 30,
      "start": 12689.5,
      "end": 12691.5,
      "formatted_start": "03:31:29.500",
      "formatted_end": "03:31:31.500",
      "text": "گلارنتاتو هم دارید؟"
    },
    {
      "id": 31,
      "start": 12691.5,
      "end": 12693.5,
      "formatted_start": "03:31:31.500",
      "formatted_end": "03:31:33.500",
      "text": "گلارنتات تمام شدن"
    },
    {
      "id": 32,
      "start": 12693.5,
      "end": 12695.5,
      "formatted_start": "03:31:33.500",
      "formatted_end": "03:31:35.500",
      "text": "برسه چربیتون؟"
    },
    {
      "id": 33,
      "start": 12695.5,
      "end": 12697.5,
      "formatted_start": "03:31:35.500",
      "formatted_end": "03:31:37.500",
      "text": "اونم دارم"
    },
    {
      "id": 34,
      "start": 12697.5,
      "end": 12699.5,
      "formatted_start": "03:31:37.500",
      "formatted_end": "03:31:39.500",
      "text": "خب بزار بگو"
    },
    {
      "id": 35,
      "start": 12699.5,
      "end": 12701.5,
      "formatted_start": "03:31:39.500",
      "formatted_end": "03:31:41.500",
      "text": "بسه بگو"
    },
    {
      "id": 36,
      "start": 12701.5,
      "end": 12703.5,
      "formatted_start": "03:31:41.500",
      "formatted_end": "03:31:43.500",
      "text": "از فقط یه برم که دو لنتا بزنم"
    },
    {
      "id": 37,
      "start": 12703.5,
      "end": 12705.5,
      "formatted_start": "03:31:43.500",
      "formatted_end": "03:31:45.500",
      "text": "تا آزمارشتون ببینم چی میشه"
    },
    {
      "id": 38,
      "start": 12705.5,
      "end": 12707.5,
      "formatted_start": "03:31:45.500",
      "formatted_end": "03:31:47.500",
      "text": "چی با خطر آزاد مونست؟"
    },
    {
      "id": 39,
      "start": 12707.5,
      "end": 12709.5,
      "formatted_start": "03:31:47.500",
      "formatted_end": "03:31:49.500",
      "text": "قمزمان"
    },
    {
      "id": 40,
      "start": 12709.5,
      "end": 12711.5,
      "formatted_start": "03:31:49.500",
      "formatted_end": "03:31:51.500",
      "text": "این مادر دیگه"
    },
    {
      "id": 41,
      "start": 12711.5,
      "end": 12713.5,
      "formatted_start": "03:31:51.500",
      "formatted_end": "03:31:53.500",
      "text": "اونو یک دارو برم نرسنم"
    },
    {
      "id": 42,
      "start": 12713.5,
      "end": 12715.5,
      "formatted_start": "03:31:53.500",
      "formatted_end": "03:31:55.500",
      "text": "بعد خانمتون"
    },
    {
      "id": 43,
      "start": 12715.5,
      "end": 12717.5,
      "formatted_start": "03:31:55.500",
      "formatted_end": "03:31:57.500",
      "text": "و مادر خانم هم"
    },
    {
      "id": 44,
      "start": 12717.5,
      "end": 12719.5,
      "formatted_start": "03:31:57.500",
      "formatted_end": "03:31:59.500",
      "text": "چیز درهمی همه دیابت داره"
    },
    {
      "id": 45,
      "start": 12719.5,
      "end": 12721.5,
      "formatted_start": "03:31:59.500",
      "formatted_end": "03:32:01.500",
      "text": "یه برسشو تموم کرده"
    },
    {
      "id": 46,
      "start": 12721.5,
      "end": 12724.5,
      "formatted_start": "03:32:01.500",
      "formatted_end": "03:32:04.500",
      "text": "می توانیم به نسخه من بگیرم؟"
    },
    {
      "id": 47,
      "start": 12724.5,
      "end": 12727.5,
      "formatted_start": "03:32:04.500",
      "formatted_end": "03:32:07.500",
      "text": "ببینیم دارو خودتو بزنیم تایید کنم"
    },
    {
      "id": 48,
      "start": 12727.5,
      "end": 12730.5,
      "formatted_start": "03:32:07.500",
      "formatted_end": "03:32:10.500",
      "text": "دارو خودت پیدا تایید نمیشه"
    },
    {
      "id": 49,
      "start": 12730.5,
      "end": 12737.5,
      "formatted_start": "03:32:10.500",
      "formatted_end": "03:32:17.500",
      "text": "از همه شخص گلا بودن بیما تنزکون دادن"
    },
    {
      "id": 50,
      "start": 12737.5,
      "end": 12740.5,
      "formatted_start": "03:32:17.500",
      "formatted_end": "03:32:20.500",
      "text": "دارو خودتون به صورت آزاد محصول میشه"
    },
    {
      "id": 51,
      "start": 12740.5,
      "end": 12744.5,
      "formatted_start": "03:32:20.500",
      "formatted_end": "03:32:24.500",
      "text": "چون تموم شده که من چون اطلاعا"
    },
    {
      "id": 52,
      "start": 12744.5,
      "end": 12748.5,
      "formatted_start": "03:32:24.500",
      "formatted_end": "03:32:28.500",
      "text": "رفته اون نداره بعد بفرستم در دفتر ساتا تایید کنم"
    },
    {
      "id": 53,
      "start": 12748.5,
      "end": 12750.5,
      "formatted_start": "03:32:28.500",
      "formatted_end": "03:32:30.500",
      "text": "دو تا دارین دیگه؟"
    },
    {
      "id": 54,
      "start": 12750.5,
      "end": 12752.5,
      "formatted_start": "03:32:30.500",
      "formatted_end": "03:32:32.500",
      "text": "دو تا دارم"
    },
    {
      "id": 55,
      "start": 12752.5,
      "end": 12754.5,
      "formatted_start": "03:32:32.500",
      "formatted_end": "03:32:34.500",
      "text": "حتی خودمون رو میخوایم چک کنیم"
    },
    {
      "id": 56,
      "start": 12754.5,
      "end": 12756.5,
      "formatted_start": "03:32:34.500",
      "formatted_end": "03:32:36.500",
      "text": "اگر نه"
    },
    {
      "id": 57,
      "start": 12756.5,
      "end": 12758.5,
      "formatted_start": "03:32:36.500",
      "formatted_end": "03:32:38.500",
      "text": "باید برگرد دفتر سالتایی برگرد هست"
    },
    {
      "id": 58,
      "start": 12758.5,
      "end": 12760.5,
      "formatted_start": "03:32:38.500",
      "formatted_end": "03:32:40.500",
      "text": "دقیقا این آنها میدن بشین"
    },
    {
      "id": 59,
      "start": 12766.5,
      "end": 12768.5,
      "formatted_start": "03:32:46.500",
      "formatted_end": "03:32:48.500",
      "text": "این آنها دارا تحریک نمیدونه"
    },
    {
      "id": 60,
      "start": 12770.5,
      "end": 12772.5,
      "formatted_start": "03:32:50.500",
      "formatted_end": "03:32:52.500",
      "text": "اونجا باید نشان داریم"
    },
    {
      "id": 61,
      "start": 12772.5,
      "end": 12774.5,
      "formatted_start": "03:32:52.500",
      "formatted_end": "03:32:54.500",
      "text": "این یعنی چند ساله یه بار باید تمدید بشاره"
    },
    {
      "id": 62,
      "start": 12774.5,
      "end": 12776.5,
      "formatted_start": "03:32:54.500",
      "formatted_end": "03:32:56.500",
      "text": "نمیدونست"
    },
    {
      "id": 63,
      "start": 12776.5,
      "end": 12780.16,
      "formatted_start": "03:32:56.500",
      "formatted_end": "03:33:00.160",
      "text": "نمیدونست. من فکرم یه بار که اقدام کردم دیگه این خودکار چیز میشه"
    },
    {
      "id": 64,
      "start": 12780.16,
      "end": 12784.5,
      "formatted_start": "03:33:00.160",
      "formatted_end": "03:33:04.500",
      "text": "او نه تا روشن هم عوض شد. یه بعضی دورهایی کم یه همون پردر نشان دارد"
    },
    {
      "id": 65,
      "start": 12784.5,
      "end": 12804.5,
      "formatted_start": "03:33:04.500",
      "formatted_end": "03:33:24.500",
      "text": "آره"
    },
    {
      "id": 66,
      "start": 12804.5,
      "end": 12808.5,
      "formatted_start": "03:33:24.500",
      "formatted_end": "03:33:28.500",
      "text": "یک تحریم ها هم که مجدد تمدید شد و خدا حافظ"
    },
    {
      "id": 67,
      "start": 12808.5,
      "end": 12812.5,
      "formatted_start": "03:33:28.500",
      "formatted_end": "03:33:32.500",
      "text": "بعد از این بعد رفتیم تا"
    },
    {
      "id": 68,
      "start": 12812.5,
      "end": 12821.5,
      "formatted_start": "03:33:32.500",
      "formatted_end": "03:33:41.500",
      "text": "حالا این صبح این گوله همه اداره بیمه بودن که اتماس دارا داشتن که"
    },
    {
      "id": 69,
      "start": 12821.5,
      "end": 12826.5,
      "formatted_start": "03:33:41.500",
      "formatted_end": "03:33:46.500",
      "text": "دیگه داریمون رو نداریم و سیماس ماش نداریم سیماس"
    },
    {
      "id": 70,
      "start": 12826.5,
      "end": 12832.5,
      "formatted_start": "03:33:46.500",
      "formatted_end": "03:33:52.500",
      "text": "البته که ما توی ایران خیلی داریم آس، هزمه ندیم"
    },
    {
      "id": 71,
      "start": 12832.5,
      "end": 12839.5,
      "formatted_start": "03:33:52.500",
      "formatted_end": "03:33:59.500",
      "text": "خالا شما که واقعا نیاز دارین، این رایگان ها می آمدن."
    },
    {
      "id": 72,
      "start": 12839.5,
      "end": 12850.5,
      "formatted_start": "03:33:59.500",
      "formatted_end": "03:34:10.500",
      "text": "طلبکار هم هر روز آزمای شرکی می دهند."
    },
    {
      "id": 73,
      "start": 12850.5,
      "end": 12854.5,
      "formatted_start": "03:34:10.500",
      "formatted_end": "03:34:14.500",
      "text": "چرعت می دهند با شما حرف بزنند، هر طلبی که می خواهند بزنند."
    },
    {
      "id": 74,
      "start": 12854.5,
      "end": 12858.5,
      "formatted_start": "03:34:14.500",
      "formatted_end": "03:34:18.500",
      "text": "ولی متاسفانه بعضا طلبکار می دهند خودشون."
    },
    {
      "id": 75,
      "start": 12858.5,
      "end": 12864.5,
      "formatted_start": "03:34:18.500",
      "formatted_end": "03:34:24.500",
      "text": "بعد یک وقتی که معیزه باقی میرسه مثل شما اینجوری میشه که اختار میده آزاد"
    },
    {
      "id": 76,
      "start": 12864.5,
      "end": 12869.5,
      "formatted_start": "03:34:24.500",
      "formatted_end": "03:34:29.500",
      "text": "خب باز هم باز بیایید یه برق آزاد بگیری تا جلب آزمایش بیاد"
    },
    {
      "id": 77,
      "start": 12869.5,
      "end": 12872.5,
      "formatted_start": "03:34:29.500",
      "formatted_end": "03:34:32.500",
      "text": "زیاد نگه بیایید شما یه برق بگیری تا جلب آزمایش بیاد"
    },
    {
      "id": 78,
      "start": 12872.5,
      "end": 12875.5,
      "formatted_start": "03:34:32.500",
      "formatted_end": "03:34:35.500",
      "text": "نفتر سالتا معرفتون کنم"
    },
    {
      "id": 79,
      "start": 12875.5,
      "end": 12878.5,
      "formatted_start": "03:34:35.500",
      "formatted_end": "03:34:38.500",
      "text": "خواهم شفایی؟ بیا"
    },
    {
      "id": 80,
      "start": 12878.5,
      "end": 12881.5,
      "formatted_start": "03:34:38.500",
      "formatted_end": "03:34:41.500",
      "text": "پس یعنی برای مادر خوانم رو من بزنی آزاد بگیرن دیگه ها؟"
    },
    {
      "id": 81,
      "start": 12881.5,
      "end": 12882.5,
      "formatted_start": "03:34:41.500",
      "formatted_end": "03:34:42.500",
      "text": "آزاده دیگه ها"
    },
    {
      "id": 82,
      "start": 12882.5,
      "end": 12883.5,
      "formatted_start": "03:34:42.500",
      "formatted_end": "03:34:43.500",
      "text": "توی تمام کرده بندقود"
    },
    {
      "id": 83,
      "start": 12883.5,
      "end": 12884.5,
      "formatted_start": "03:34:43.500",
      "formatted_end": "03:34:44.500",
      "text": "اون چیه؟"
    },
    {
      "id": 84,
      "start": 12884.5,
      "end": 12886.5,
      "formatted_start": "03:34:44.500",
      "formatted_end": "03:34:46.500",
      "text": "پیو گلیتا زونه 15"
    },
    {
      "id": 85,
      "start": 12888.26,
      "end": 12890.26,
      "formatted_start": "03:34:48.260",
      "formatted_end": "03:34:50.260",
      "text": "داره قدر برونده ایه"
    },
    {
      "id": 86,
      "start": 12890.26,
      "end": 12892.26,
      "formatted_start": "03:34:50.260",
      "formatted_end": "03:34:52.260",
      "text": "چون من جور خانم شخصیه مریض میشم"
    },
    {
      "id": 87,
      "start": 12892.26,
      "end": 12894.26,
      "formatted_start": "03:34:52.260",
      "formatted_end": "03:34:54.260",
      "text": "آره کارش دارم دیگه"
    },
    {
      "id": 88,
      "start": 12894.26,
      "end": 12896.26,
      "formatted_start": "03:34:54.260",
      "formatted_end": "03:34:56.260",
      "text": "چونش مریض میشه"
    },
    {
      "id": 89,
      "start": 12896.26,
      "end": 12898.26,
      "formatted_start": "03:34:56.260",
      "formatted_end": "03:34:58.260",
      "text": "این چون خودش تمنین اجتماعی داره"
    },
    {
      "id": 90,
      "start": 12898.26,
      "end": 12900.26,
      "formatted_start": "03:34:58.260",
      "formatted_end": "03:35:00.260",
      "text": "معمولا میره میگیره"
    }
  ],
  "status": "completed"
}