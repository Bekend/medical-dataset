    },
    {
      "id": 84,
      "start": 5326.7,
      "end": 5356.7,
      "formatted_start": "01:28:46.700",
      "formatted_end": "01:29:16.700",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برد"
    },
    {
      "id": 85,
      "start": 5356.7,
      "end": 5358.7,
      "formatted_start": "01:29:16.700",
      "formatted_end": "01:29:18.700",
      "text": "یک بار دیگه بزنیم"
    },
    {
      "id": 86,
      "start": 5359.7,
      "end": 5362.7,
      "formatted_start": "01:29:19.700",
      "formatted_end": "01:29:22.700",
      "text": "اگر 5D شو بیاد خوبه"
    },
    {
      "id": 87,
      "start": 5364.7,
      "end": 5366.7,
      "formatted_start": "01:29:24.700",
      "formatted_end": "01:29:26.700",
      "text": "نمیدونی خواهد بگیر"
    },
    {
      "id": 88,
      "start": 5366.7,
      "end": 5367.7,
      "formatted_start": "01:29:26.700",
      "formatted_end": "01:29:27.700",
      "text": "چرا نمیدونی؟"
    },
    {
      "id": 89,
      "start": 5367.7,
      "end": 5370.7,
      "formatted_start": "01:29:27.700",
      "formatted_end": "01:29:30.700",
      "text": "خب خواهد بگیر گفتم که بستگیر داره به تجهیزاتی که شما دارید"
    },
    {
      "id": 90,
      "start": 5370.7,
      "end": 5372.7,
      "formatted_start": "01:29:30.700",
      "formatted_end": "01:29:32.700",
      "text": "هرچی جدید تر باشه خواهد"
    },
    {
      "id": 91,
      "start": 5372.7,
      "end": 5374.7,
      "formatted_start": "01:29:32.700",
      "formatted_end": "01:29:34.700",
      "text": "آه یعنی سیستم قدیل میاده؟"
    },
    {
      "id": 92,
      "start": 5374.7,
      "end": 5376.7,
      "formatted_start": "01:29:34.700",
      "formatted_end": "01:29:36.700",
      "text": "چند سال کش گردیم؟ مثلا شاید اون"
    },
    {
      "id": 93,
      "start": 5376.7,
      "end": 5377.7,
      "formatted_start": "01:29:36.700",
      "formatted_end": "01:29:37.700",
      "text": "اون 5-6 سال شد"
    },
    {
      "id": 94,
      "start": 5377.7,
      "end": 5378.7,
      "formatted_start": "01:29:37.700",
      "formatted_end": "01:29:38.700",
      "text": "خواهد همونه"
    },
    {
      "id": 95,
      "start": 5378.7,
      "end": 5379.7,
      "formatted_start": "01:29:38.700",
      "formatted_end": "01:29:39.700",
      "text": "توی بازم؟"
    },
    {
      "id": 96,
      "start": 5379.7,
      "end": 5382.7,
      "formatted_start": "01:29:39.700",
      "formatted_end": "01:29:42.700",
      "text": "خواهد اینکه از مادمش باره چیزه، مادم اکستروم نامده"
    },
    {
      "id": 97,
      "start": 5386.7,
      "end": 5391.7,
      "formatted_start": "01:29:46.700",
      "formatted_end": "01:29:51.700",
      "text": "این سرعت جانا ضعیبه"
    },
    {
      "id": 98,
      "start": 5391.7,
      "end": 5394.7,
      "formatted_start": "01:29:51.700",
      "formatted_end": "01:29:54.700",
      "text": "اگر قوی ترم میخوایی ببینید دوی این وسیع از اون قوی ترم"
    },
    {
      "id": 99,
      "start": 5394.7,
      "end": 5397.7,
      "formatted_start": "01:29:54.700",
      "formatted_end": "01:29:57.700",
      "text": "ببینید چند ترم دارم"
    },
    {
      "id": 100,
      "start": 5397.7,
      "end": 5399.7,
      "formatted_start": "01:29:57.700",
      "formatted_end": "01:29:59.700",
      "text": "خب نه فایده نداره اون موضوع"
    }
  ],
  "status": "completed"
}