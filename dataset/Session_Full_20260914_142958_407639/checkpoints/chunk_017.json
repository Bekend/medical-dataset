      "end": 5111.0,
      "formatted_start": "01:25:10.000",
      "formatted_end": "01:25:11.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 8,
      "start": 5111.0,
      "end": 5112.0,
      "formatted_start": "01:25:11.000",
      "formatted_end": "01:25:12.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 9,
      "start": 5112.0,
      "end": 5113.0,
      "formatted_start": "01:25:12.000",
      "formatted_end": "01:25:13.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 10,
      "start": 5113.0,
      "end": 5114.0,
      "formatted_start": "01:25:13.000",
      "formatted_end": "01:25:14.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 11,
      "start": 5114.0,
      "end": 5115.0,
      "formatted_start": "01:25:14.000",
      "formatted_end": "01:25:15.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 12,
      "start": 5115.0,
      "end": 5116.0,
      "formatted_start": "01:25:15.000",
      "formatted_end": "01:25:16.000",
      "text": "برداشت بخورید."
    },
    {
      "id": 13,
      "start": 5116.0,
      "end": 5122.0,
      "formatted_start": "01:25:16.000",
      "formatted_end": "01:25:22.000",
      "text": "اینجا یه موزه میبینم خوبه و ماه برش بردن ولی خیلی شدید میشه"
    },
    {
      "id": 14,
      "start": 5122.0,
      "end": 5124.0,
      "formatted_start": "01:25:22.000",
      "formatted_end": "01:25:24.000",
      "text": "بله همین موزه کمپون شده"
    },
    {
      "id": 15,
      "start": 5124.0,
      "end": 5125.0,
      "formatted_start": "01:25:24.000",
      "formatted_end": "01:25:25.000",
      "text": "نه نه"
    },
    {
      "id": 16,
      "start": 5125.0,
      "end": 5126.0,
      "formatted_start": "01:25:25.000",
      "formatted_end": "01:25:26.000",
      "text": "تیرویدتو داری؟"
    },
    {
      "id": 17,
      "start": 5126.0,
      "end": 5130.0,
      "formatted_start": "01:25:26.000",
      "formatted_end": "01:25:30.000",
      "text": "نه نه اصلا هیچ دار نه تیروید نه کمپون هست"
    },
    {
      "id": 18,
      "start": 5130.0,
      "end": 5132.0,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:32.000",
      "text": "هیچی ندارم باش دارم داریم میریم"
    },
    {
      "id": 19,
      "start": 5132.0,
      "end": 5133.0,
      "formatted_start": "01:25:32.000",
      "formatted_end": "01:25:33.000",
      "text": "دست نزدیکیم"
    },
    {
      "id": 20,
      "start": 5133.0,
      "end": 5135.0,
      "formatted_start": "01:25:33.000",
      "formatted_end": "01:25:35.000",
      "text": "بله ماما اینجا حالیه نه تون"
    },
    {
      "id": 21,
      "start": 5135.0,
      "end": 5137.0,
      "formatted_start": "01:25:35.000",
      "formatted_end": "01:25:37.000",
      "text": "خالی خانم دکتر چون صابتی؟"
    },
    {
      "id": 22,
      "start": 5137.0,
      "end": 5139.0,
      "formatted_start": "01:25:37.000",
      "formatted_end": "01:25:39.000",
      "text": "خالی خانم چون ایرانی منو نوسم یا خالا چی؟"
    },
    {
      "id": 23,
      "start": 5139.0,
      "end": 5141.0,
      "formatted_start": "01:25:39.000",
      "formatted_end": "01:25:41.000",
      "text": "ایرانی میخورم ببین"
    },
    {
      "id": 24,
      "start": 5141.0,
      "end": 5142.0,
      "formatted_start": "01:25:41.000",
      "formatted_end": "01:25:42.000",
      "text": "باش"
    },
    {
      "id": 25,
      "start": 5146.0,
      "end": 5148.0,
      "formatted_start": "01:25:46.000",
      "formatted_end": "01:25:48.000",
      "text": "اگر کسی بهش می سازه ایرانی که ایرانی شده"
    },
    {
      "id": 26,
      "start": 5148.0,
      "end": 5151.0,
      "formatted_start": "01:25:48.000",
      "formatted_end": "01:25:51.000",
      "text": "نه الان چند ماه بود نزدیک هفتهش بود ایرانی می خواهد"
    },
    {
      "id": 27,
      "start": 5151.0,
      "end": 5152.0,
      "formatted_start": "01:25:51.000",
      "formatted_end": "01:25:52.000",
      "text": "آفرین"
    },
    {
      "id": 28,
      "start": 5152.0,
      "end": 5154.0,
      "formatted_start": "01:25:52.000",
      "formatted_end": "01:25:54.000",
      "text": "همونو موردتا پرشت بباید مو بخواهی"
    },
    {
      "id": 29,
      "start": 5154.0,
      "end": 5155.0,
      "formatted_start": "01:25:54.000",
      "formatted_end": "01:25:55.000",
      "text": "اینکه"
    },
    {
      "id": 30,
      "start": 5155.0,
      "end": 5158.0,
      "formatted_start": "01:25:55.000",
      "formatted_end": "01:25:58.000",
      "text": "من خانوم دکتر از دیروزه این واسه پدرم اونقدر درد دارم"
    },
    {
      "id": 31,
      "start": 5158.0,
      "end": 5162.0,
      "formatted_start": "01:25:58.000",
      "formatted_end": "01:26:02.000",
      "text": "چربیتو چک نکرده دوباره چون اونجا یه ذریعه چند سیت برای بوده"
    },
    {
      "id": 32,
      "start": 5162.0,
      "end": 5164.0,
      "formatted_start": "01:26:02.000",
      "formatted_end": "01:26:04.000",
      "text": "آه نه چک نگه باید اونکه کم برم"
    },
    {
      "id": 33,
      "start": 5164.0,
      "end": 5165.0,
      "formatted_start": "01:26:04.000",
      "formatted_end": "01:26:05.000",
      "text": "اینجا دیگه دیگه"
    },
    {
      "id": 34,
      "start": 5165.0,
      "end": 5169.0,
      "formatted_start": "01:26:05.000",
      "formatted_end": "01:26:09.000",
      "text": "این قصه درد شدید دارم اینجا باره"
    },
    {
      "id": 35,
      "start": 5169.0,
      "end": 5173.0,
      "formatted_start": "01:26:09.000",
      "formatted_end": "01:26:13.000",
      "text": "داشتم قبل چند ساله پیش"
    },
    {
      "id": 36,
      "start": 5173.0,
      "end": 5175.0,
      "formatted_start": "01:26:13.000",
      "formatted_end": "01:26:15.000",
      "text": "اینجا باره شما هم سنگیر و کلیت دارد"
    },
    {
      "id": 37,
      "start": 5175.0,
      "end": 5177.0,
      "formatted_start": "01:26:15.000",
      "formatted_end": "01:26:17.000",
      "text": "اتارت میسوزه"
    },
    {
      "id": 38,
      "start": 5177.0,
      "end": 5179.0,
      "formatted_start": "01:26:17.000",
      "formatted_end": "01:26:19.000",
      "text": "نه ولی حس افونت دارم"
    },
    {
      "id": 39,
      "start": 5179.0,
      "end": 5181.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:21.000",
      "text": "گوشام خیلی سنگین شده"
    },
    {
      "id": 40,
      "start": 5181.0,
      "end": 5185.0,
      "formatted_start": "01:26:21.000",
      "formatted_end": "01:26:25.000",
      "text": "حس میگونم از اون فونت دارید برام"
    },
    {
      "id": 41,
      "start": 5185.0,
      "end": 5188.0,
      "formatted_start": "01:26:25.000",
      "formatted_end": "01:26:28.000",
      "text": "چون سابقه افونت دارم"
    },
    {
      "id": 42,
      "start": 5188.0,
      "end": 5190.0,
      "formatted_start": "01:26:28.000",
      "formatted_end": "01:26:30.000",
      "text": "تندنم افونتیه"
    },
    {
      "id": 43,
      "start": 5190.0,
      "end": 5192.0,
      "formatted_start": "01:26:30.000",
      "formatted_end": "01:26:32.000",
      "text": "میگم به گوشامم زده"
    },
    {
      "id": 44,
      "start": 5192.0,
      "end": 5194.0,
      "formatted_start": "01:26:32.000",
      "formatted_end": "01:26:34.000",
      "text": "خوشگان می نویستم خوب؟"
    },
    {
      "id": 45,
      "start": 5194.0,
      "end": 5197.0,
      "formatted_start": "01:26:34.000",
      "formatted_end": "01:26:37.000",
      "text": "برای خوشگان می نویستم که همه جا رو پوشش بده"
    },
    {
      "id": 46,
      "start": 5197.0,
      "end": 5202.0,
      "formatted_start": "01:26:37.000",
      "formatted_end": "01:26:42.000",
      "text": "اما اگر دیدی درد پهلوت خوب نشدی از ما شهر را برن بسام با خوب؟"
    },
    {
      "id": 47,
      "start": 5202.0,
      "end": 5205.0,
      "formatted_start": "01:26:42.000",
      "formatted_end": "01:26:45.000",
      "text": "اگر دیدی خوب نشدی بری"
    },
    {
      "id": 48,
      "start": 5205.0,
      "end": 5208.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:48.000",
      "text": "چون که ما هم یک کلیه"
    },
    {
      "id": 49,
      "start": 5208.0,
      "end": 5211.0,
      "formatted_start": "01:26:48.000",
      "formatted_end": "01:26:51.000",
      "text": "سه ماه دیگه حتما میگه چربیت هم چک کن"
    },
    {
      "id": 50,
      "start": 5211.0,
      "end": 5213.0,
      "formatted_start": "01:26:51.000",
      "formatted_end": "01:26:53.000",
      "text": "چربیتو ننوشت"
    },
    {
      "id": 51,
      "start": 5213.0,
      "end": 5217.0,
      "formatted_start": "01:26:53.000",
      "formatted_end": "01:26:57.000",
      "text": "میگم تو روستا میشینیم هنوز برداشت شالی ها شروع نشده"
    },
    {
      "id": 52,
      "start": 5217.0,
      "end": 5225.16,
      "formatted_start": "01:26:57.000",
      "formatted_end": "01:27:05.160",
      "text": "میگم یه چیز از این سونا انجام بدم بیارم ببینیم ببینم اگه واقعا ضروری کیس صفران چون سنگ داره"
    },
    {
      "id": 53,
      "start": 5225.16,
      "end": 5228.46,
      "formatted_start": "01:27:05.160",
      "formatted_end": "01:27:08.460",
      "text": "مدبر دارید دیگه شما چون اینجوریم به اون مادر"
    },
    {
      "id": 54,
      "start": 5228.46,
      "end": 5232.42,
      "formatted_start": "01:27:08.460",
      "formatted_end": "01:27:12.420",
      "text": "چند سال الان دارم؟ 13 میریه، 11 میریه شده؟"
    },
    {
      "id": 55,
      "start": 5232.42,
      "end": 5236.4,
      "formatted_start": "01:27:12.420",
      "formatted_end": "01:27:16.400",
      "text": "میگم کاری نداره، نداره، یه دفعه ممکنه، یه دفعه درست"
    },
    {
      "id": 56,
      "start": 5236.4,
      "end": 5240.14,
      "formatted_start": "01:27:16.400",
      "formatted_end": "01:27:20.140",
      "text": "او باید خیلی میترسه، خودشم چون داشت ترکی"
    },
    {
      "id": 57,
      "start": 5240.14,
      "end": 5243.0,
      "formatted_start": "01:27:20.140",
      "formatted_end": "01:27:23.000",
      "text": "بابانی، باید که من خودم برم"
    },
    {
      "id": 58,
      "start": 5243.0,
      "end": 5244.7,
      "formatted_start": "01:27:23.000",
      "formatted_end": "01:27:24.700",
      "text": "بابانی باید حتما برم"
    },
    {
      "id": 59,
      "start": 5244.7,
      "end": 5274.7,
      "formatted_start": "01:27:24.700",
      "formatted_end": "01:27:54.700",
      "text": "اینجا باید باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم ک"
    },
    {
      "id": 60,
      "start": 5274.7,
      "end": 5276.7,
      "formatted_start": "01:27:54.700",
      "formatted_end": "01:27:56.700",
      "text": "باید باید بشو باشیم"
    },
    {
      "id": 61,
      "start": 5276.7,
      "end": 5278.7,
      "formatted_start": "01:27:56.700",
      "formatted_end": "01:27:58.700",
      "text": "باید بشو باشیم"
    },
    {
      "id": 62,
      "start": 5278.7,
      "end": 5280.7,
      "formatted_start": "01:27:58.700",
      "formatted_end": "01:28:00.700",
