      "start": 5284.7,
      "end": 5286.7,
      "formatted_start": "01:28:04.700",
      "formatted_end": "01:28:06.700",
      "text": "باید بشو باشیم"
    },
    {
      "id": 66,
      "start": 5286.7,
      "end": 5288.7,
      "formatted_start": "01:28:06.700",
      "formatted_end": "01:28:08.700",
