    },
    {
      "id": 9,
      "start": 24018.0,
      "end": 24020.0,
      "formatted_start": "06:40:18.000",
      "formatted_end": "06:40:20.000",
      "text": "از اینجا بیماری شدیده."
    },
    {
      "id": 10,
      "start": 24020.0,
      "end": 24022.0,
      "formatted_start": "06:40:20.000",
      "formatted_end": "06:40:22.000",
      "text": "از اینجا بیماری شدیده."
    },
    {
      "id": 11,
      "start": 24022.0,
      "end": 24024.0,
      "formatted_start": "06:40:22.000",
      "formatted_end": "06:40:24.000",
      "text": "اما فیلمه هایی که دیگه همش کهسته میکنه"
    },
    {
      "id": 12,
      "start": 24026.0,
      "end": 24028.0,
      "formatted_start": "06:40:26.000",
      "formatted_end": "06:40:28.000",
      "text": "من رو ببینم باید چشماش نرد شده"
    },
    {
      "id": 13,
      "start": 24028.0,
      "end": 24030.0,
      "formatted_start": "06:40:28.000",
      "formatted_end": "06:40:30.000",
      "text": "نه باید عمل کنه"
    },
    {
      "id": 14,
      "start": 24030.0,
      "end": 24032.0,
      "formatted_start": "06:40:30.000",
      "formatted_end": "06:40:32.000",
      "text": "تمنوش هسته بیم کنه"
    },
    {
      "id": 15,
      "start": 24032.0,
      "end": 24034.0,
      "formatted_start": "06:40:32.000",
      "formatted_end": "06:40:34.000",
      "text": "من بیشتر شده میکنم"
    },
    {
      "id": 16,
      "start": 24034.0,
      "end": 24036.0,
      "formatted_start": "06:40:34.000",
      "formatted_end": "06:40:36.000",
      "text": "من کود رکیشم بیدم من دقیقا براش برسیم"
    },
    {
      "id": 17,
      "start": 24036.0,
      "end": 24038.0,
      "formatted_start": "06:40:36.000",
      "formatted_end": "06:40:38.000",
      "text": "چون که اونجا جا باشه من فیلمه روستایی نردشتم"
    },
    {
      "id": 18,
      "start": 24038.0,
      "end": 24040.0,
      "formatted_start": "06:40:38.000",
      "formatted_end": "06:40:40.000",
      "text": "این رو برم برم برم برم"
    },
    {
      "id": 19,
      "start": 24040.0,
      "end": 24042.0,
      "formatted_start": "06:40:40.000",
      "formatted_end": "06:40:42.000",
      "text": "این فیلمه سن سالشه"
    },
    {
      "id": 20,
      "start": 24042.0,
      "end": 24044.0,
      "formatted_start": "06:40:42.000",
      "formatted_end": "06:40:44.000",
      "text": "این گوزی که زمنش نمی کنه"
    },
    {
      "id": 21,
      "start": 24044.0,
      "end": 24046.0,
      "formatted_start": "06:40:44.000",
      "formatted_end": "06:40:46.000",
      "text": "دخترشه"
    },
    {
      "id": 22,
      "start": 24046.0,
      "end": 24047.0,
      "formatted_start": "06:40:46.000",
      "formatted_end": "06:40:47.000",
      "text": "نماشه؟"
    },
    {
      "id": 23,
      "start": 24047.0,
      "end": 24048.0,
      "formatted_start": "06:40:47.000",
      "formatted_end": "06:40:48.000",
      "text": "نه"
    },
    {
      "id": 24,
      "start": 24048.0,
      "end": 24056.0,
      "formatted_start": "06:40:48.000",
      "formatted_end": "06:40:56.000",
      "text": "این کسی سرده شده برم که سنگ داشته برم کرده خب سرد شده دیگه"
    },
    {
      "id": 25,
      "start": 24056.0,
      "end": 24062.0,
      "formatted_start": "06:40:56.000",
      "formatted_end": "06:41:02.000",
      "text": "این سرده مسیر میبنده زردی میزنه بالا تو برده"
    },
    {
      "id": 26,
      "start": 24062.0,
      "end": 24066.0,
      "formatted_start": "06:41:02.000",
      "formatted_end": "06:41:06.000",
      "text": "برای نمیبونه چون چشم سرد میبنه"
    },
    {
      "id": 27,
      "start": 24066.0,
      "end": 24069.0,
      "formatted_start": "06:41:06.000",
      "formatted_end": "06:41:09.000",
      "text": "از این مردم که پستاش بزرگ شده"
    },
    {
      "id": 28,
      "start": 24069.0,
      "end": 24072.0,
      "formatted_start": "06:41:09.000",
      "formatted_end": "06:41:12.000",
      "text": "که همون همه اش بازه پستاش شده کرده"
    },
    {
      "id": 29,
      "start": 24072.0,
      "end": 24076.0,
      "formatted_start": "06:41:12.000",
      "formatted_end": "06:41:16.000",
      "text": "پستاش بزرگ شده پشت میاد از پشت مسانه"
    },
    {
      "id": 30,
      "start": 24076.0,
      "end": 24079.6,
      "formatted_start": "06:41:16.000",
      "formatted_end": "06:41:19.600",
      "text": "مسئله خود نمیذاره، دم سراخ مسئله بسته افراد نمید"
    },
    {
      "id": 31,
      "start": 24079.6,
      "end": 24082.76,
      "formatted_start": "06:41:19.600",
      "formatted_end": "06:41:22.760",
      "text": "حالا بر همینم میگه من قرمز شدم"
    },
    {
      "id": 32,
      "start": 24082.76,
      "end": 24085.16,
      "formatted_start": "06:41:22.760",
      "formatted_end": "06:41:25.160",
      "text": "بساییم گفتم پرستادارو شویم شبت بگیریم"
    },
    {
      "id": 33,
      "start": 24085.16,
      "end": 24088.68,
      "formatted_start": "06:41:25.160",
      "formatted_end": "06:41:28.680",
      "text": "مگرن شاشپند میشه، قشنگ، یعنی پدر ملیز در میاد"
    },
    {
      "id": 34,
      "start": 24088.68,
      "end": 24090.24,
      "formatted_start": "06:41:28.680",
      "formatted_end": "06:41:30.240",
      "text": "مجبور میشن از این بالا سراخ کنن"
    },
    {
      "id": 35,
      "start": 24090.24,
      "end": 24093.88,
      "formatted_start": "06:41:30.240",
      "formatted_end": "06:41:33.880",
      "text": "چون این پرستاد هم مزوره که سند اصلا ند نمیشه ازش"
    },
    {
      "id": 36,
      "start": 24093.88,
      "end": 24097.0,
      "formatted_start": "06:41:33.880",
      "formatted_end": "06:41:37.000",
      "text": "برای همین زودتر داروش باید بدی که را بیاخته"
    },
    {
      "id": 37,
      "start": 24097.0,
      "end": 24101.0,
      "formatted_start": "06:41:37.000",
      "formatted_end": "06:41:41.000",
      "text": "اما سنگ پیمکست سفراشویی دیگه با ترجمه سنگی کسی عمل نمیکنه"
    },
    {
      "id": 38,
      "start": 24101.0,
      "end": 24102.0,
      "formatted_start": "06:41:41.000",
      "formatted_end": "06:41:42.000",
      "text": "نبوده که عمل نداره؟"
    },
    {
      "id": 39,
      "start": 24102.0,
      "end": 24105.0,
      "formatted_start": "06:41:42.000",
      "formatted_end": "06:41:45.000",
      "text": "آره، فقط یه قرص خشکان"
    },
    {
      "id": 40,
      "start": 24105.0,
      "end": 24107.0,
      "formatted_start": "06:41:45.000",
      "formatted_end": "06:41:47.000",
      "text": "هرچی دارو هست فقط یه شمایی سفر بکنه"
    },
    {
      "id": 41,
      "start": 24107.0,
      "end": 24111.0,
      "formatted_start": "06:41:47.000",
      "formatted_end": "06:41:51.000",
      "text": "آره، تونس کم زیاد نمیتونه بخوره، بکو برش"
    },
    {
      "id": 42,
      "start": 24111.0,
      "end": 24113.0,
      "formatted_start": "06:41:51.000",
      "formatted_end": "06:41:53.000",
      "text": "بکو بم، چاره نیستی؟"
    },
    {
      "id": 43,
      "start": 24113.0,
      "end": 24115.0,
      "formatted_start": "06:41:53.000",
      "formatted_end": "06:41:55.000",
      "text": "سه سند سنگی کسی سفراشویی"
    },
    {
      "id": 44,
      "start": 24115.0,
      "end": 24118.0,
      "formatted_start": "06:41:55.000",
      "formatted_end": "06:41:58.000",
      "text": "آره، این آدمایشو دو سریز دیگه بدش کن باشه"
    },
    {
      "id": 45,
      "start": 24118.0,
      "end": 24120.0,
      "formatted_start": "06:41:58.000",
      "formatted_end": "06:42:00.000",
      "text": "آدمایی تا خود بختاره"
    },
    {
      "id": 46,
      "start": 24120.0,
      "end": 24150.0,
      "formatted_start": "06:42:00.000",
      "formatted_end": "06:42:30.000",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 47,
      "start": 24150.0,
      "end": 24153.0,
      "formatted_start": "06:42:30.000",
      "formatted_end": "06:42:33.000",
      "text": "نه گم نکنه اونجا داد با اینا دست و نه"
    },
    {
      "id": 48,
      "start": 24153.0,
      "end": 24156.0,
      "formatted_start": "06:42:33.000",
      "formatted_end": "06:42:36.000",
      "text": "نه دست دارم"
    },
    {
      "id": 49,
      "start": 24156.0,
      "end": 24158.0,
      "formatted_start": "06:42:36.000",
      "formatted_end": "06:42:38.000",
      "text": "دست دارم"
    },
    {
      "id": 50,
      "start": 24158.0,
      "end": 24163.0,
      "formatted_start": "06:42:38.000",
      "formatted_end": "06:42:43.000",
      "text": "فقط داروی و طبیعی بدین که بسایی دیگه جمعش کنیم"
    },
    {
      "id": 51,
      "start": 24163.0,
      "end": 24167.0,
      "formatted_start": "06:42:43.000",
      "formatted_end": "06:42:47.000",
      "text": "قرص پروستاتشو تا روز که زدین دست باید بدین خب؟"
    },
    {
      "id": 52,
      "start": 24167.0,
      "end": 24168.0,
      "formatted_start": "06:42:47.000",
      "formatted_end": "06:42:48.000",
      "text": "نه اونو که بدین دیگه"
    },
    {
      "id": 53,
      "start": 24168.0,
      "end": 24170.0,
      "formatted_start": "06:42:48.000",
      "formatted_end": "06:42:50.000",
      "text": "تا دیگه نزدین تموم شد"
    },
    {
      "id": 54,
      "start": 24170.0,
      "end": 24173.0,
      "formatted_start": "06:42:50.000",
      "formatted_end": "06:42:53.000",
      "text": "یعنی تموم شد باید براش بگیریم همیشه"
    },
    {
      "id": 55,
      "start": 24173.0,
      "end": 24174.0,
      "formatted_start": "06:42:53.000",
      "formatted_end": "06:42:54.000",
      "text": "چون نرسیم"
    },
    {
      "id": 56,
      "start": 24174.0,
      "end": 24176.0,
      "formatted_start": "06:42:54.000",
      "formatted_end": "06:42:56.000",
      "text": "اونکه اون یکده درز مانده که من براش میگیرم دیگه"
    },
    {
      "id": 57,
      "start": 24176.0,
      "end": 24182.1,
      "formatted_start": "06:42:56.000",
      "formatted_end": "06:43:02.100",
      "text": "و یه چیز کبیه باشه که این همه چیزش باز به گردن منو اشتاده دیگه"
    },
    {
      "id": 58,
      "start": 24182.1,
      "end": 24184.1,
      "formatted_start": "06:43:02.100",
      "formatted_end": "06:43:04.100",
      "text": "هر روز نمتنم رو برم بیانم شیرم"
    },
    {
      "id": 59,
      "start": 24184.1,
      "end": 24186.1,
      "formatted_start": "06:43:04.100",
      "formatted_end": "06:43:06.100",
      "text": "من نیمونم بشم"
    },
    {
      "id": 60,
      "start": 24186.1,
      "end": 24190.1,
      "formatted_start": "06:43:06.100",
      "formatted_end": "06:43:10.100",
      "text": "خدا خوش کنید دو روز نوشتم دو روز بعدی که برش بزنم از سرام"
    },
    {
      "id": 61,
      "start": 24190.1,
      "end": 24192.1,
      "formatted_start": "06:43:10.100",
      "formatted_end": "06:43:12.100",
      "text": "تمام"
    },
    {
      "id": 62,
      "start": 24192.1,
      "end": 24196.1,
      "formatted_start": "06:43:12.100",
      "formatted_end": "06:43:16.100",
      "text": "کبزی پرستاد هم هم این روز شروع کنم اشتاد شیرم و انشانه بیانم شیرم"
    },
    {
      "id": 63,
      "start": 24196.1,
      "end": 24200.1,
      "formatted_start": "06:43:16.100",
      "formatted_end": "06:43:20.100",
      "text": "زمان میبرید دیگه چون این پرستاده بزرگیه"
    },
    {
      "id": 64,
      "start": 24200.1,
      "end": 24202.6,
      "formatted_start": "06:43:20.100",
      "formatted_end": "06:43:22.600",
      "text": "یک دفعه برس بخوایید ترکه پوستات کچک نمیشه"
    },
    {
      "id": 65,
      "start": 24202.6,
      "end": 24204.6,
      "formatted_start": "06:43:22.600",
      "formatted_end": "06:43:24.600",
      "text": "درست داریم"
    },
    {
      "id": 66,
      "start": 24204.6,
      "end": 24207.6,
      "formatted_start": "06:43:24.600",
      "formatted_end": "06:43:27.600",
      "text": "حالا این ادرار کچکش برای ادرار را میاد؟"
    },
    {
      "id": 67,
      "start": 24207.6,
      "end": 24208.6,
      "formatted_start": "06:43:27.600",
      "formatted_end": "06:43:28.600",
      "text": "برای ادرار را میاد، درست داریم"
    },
    {
      "id": 68,
      "start": 24208.6,
      "end": 24211.6,
      "formatted_start": "06:43:28.600",
      "formatted_end": "06:43:31.600",
      "text": "یکی چهار پر روز دیگه شروع کنه، بهتر شده"
    },
    {
      "id": 69,
      "start": 24211.6,
      "end": 24214.6,
      "formatted_start": "06:43:31.600",
      "formatted_end": "06:43:34.600",
      "text": "چون راهی هم نداره، اصلا صنع نمیشه برای اصلا"
    },
    {
      "id": 70,
      "start": 24214.6,
      "end": 24217.6,
      "formatted_start": "06:43:34.600",
      "formatted_end": "06:43:37.600",
      "text": "هیچ کار نمیشه باشه که، تا دارو اثر کنه"
    },
    {
      "id": 71,
      "start": 24217.6,
      "end": 24219.6,
      "formatted_start": "06:43:37.600",
      "formatted_end": "06:43:39.600",
      "text": "درست داریم"
    },
    {
      "id": 72,
      "start": 24232.6,
      "end": 24236.6,
      "formatted_start": "06:43:52.600",
      "formatted_end": "06:43:56.600",
      "text": "از اینجا باید برداریم که سرفه شمسه بهش نگذنگ داره"
    },
    {
      "id": 73,
      "start": 24236.6,
      "end": 24238.6,
      "formatted_start": "06:43:56.600",
      "formatted_end": "06:43:58.600",
      "text": "نه، نه بوده"
    },
    {
      "id": 74,
      "start": 24238.6,
      "end": 24240.6,
      "formatted_start": "06:43:58.600",
      "formatted_end": "06:44:00.600",
      "text": "تا خون برقای نه که میگید نمیخوره"
    },
    {
      "id": 75,
      "start": 24240.6,
      "end": 24242.6,
      "formatted_start": "06:44:00.600",
      "formatted_end": "06:44:02.600",
      "text": "نه بوده"
    },
    {
      "id": 76,
      "start": 24242.6,
      "end": 24244.6,
      "formatted_start": "06:44:02.600",
      "formatted_end": "06:44:04.600",
      "text": "برای شیر و عرصه"
    },
    {
      "id": 77,
      "start": 24244.6,
      "end": 24246.6,
      "formatted_start": "06:44:04.600",
      "formatted_end": "06:44:06.600",
      "text": "برای شیر و عرصه"
    },
    {
      "id": 78,
      "start": 24246.6,
      "end": 24248.6,
      "formatted_start": "06:44:06.600",
      "formatted_end": "06:44:08.600",
      "text": "پس با من این هم دارو بگیرم"
    },
    {
      "id": 79,
      "start": 24248.6,
      "end": 24250.6,
      "formatted_start": "06:44:08.600",
      "formatted_end": "06:44:10.600",
      "text": "و هم آزمایش دیگه"
    },
    {
      "id": 80,
      "start": 24250.6,
      "end": 24252.6,
      "formatted_start": "06:44:10.600",
      "formatted_end": "06:44:12.600",
      "text": "آره، باشه"
    },
    {
      "id": 81,
      "start": 24252.6,
      "end": 24254.6,
      "formatted_start": "06:44:12.600",
      "formatted_end": "06:44:14.600",
      "text": "آزمایشش هم قرجانست"
    },
    {
      "id": 82,
      "start": 24254.6,
      "end": 24256.6,
      "formatted_start": "06:44:14.600",
      "formatted_end": "06:44:16.600",
      "text": "چون هم میخواد بیاد عفونت اضرار شده"
    },
    {
      "id": 83,
      "start": 24256.6,
      "end": 24258.6,
      "formatted_start": "06:44:16.600",
      "formatted_end": "06:44:18.600",
      "text": "کمی الان مطمئن هست"
    },
    {
      "id": 84,
      "start": 24258.6,
      "end": 24260.6,
      "formatted_start": "06:44:18.600",
      "formatted_end": "06:44:20.600",
      "text": "میخواد بیاد کسی سرفه شده داره"
    },
    {
      "id": 85,
      "start": 24260.6,
      "end": 24262.6,
      "formatted_start": "06:44:20.600",
      "formatted_end": "06:44:22.600",
      "text": "چون یه ماه فرق دارید"
    },
    {
      "id": 86,
      "start": 24262.6,
      "end": 24264.6,
      "formatted_start": "06:44:22.600",
      "formatted_end": "06:44:24.600",
      "text": "دست شما داده"
    },
    {
      "id": 87,
      "start": 24264.6,
      "end": 24266.6,
      "formatted_start": "06:44:24.600",
      "formatted_end": "06:44:26.600",
      "text": "دست شما داده"
    },
    {
      "id": 88,
      "start": 24290.6,
      "end": 24292.6,
      "formatted_start": "06:44:50.600",
      "formatted_end": "06:44:52.600",
      "text": "بیایید"
    }
  ],
  "status": "completed"
}