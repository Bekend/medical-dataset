      "end": 12275.414,
      "formatted_start": "03:24:31.077",
      "formatted_end": "03:24:35.414",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 12275.853,
      "end": 12277.793,
      "formatted_start": "03:24:35.853",
      "formatted_end": "03:24:37.793",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 12278.401,
      "end": 12289.083,
      "formatted_start": "03:24:38.401",
      "formatted_end": "03:24:49.083",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 12279.92,
      "end": 12280.628,
      "formatted_start": "03:24:39.920",
      "formatted_end": "03:24:40.628",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 12282.248,
      "end": 12283.126,
      "formatted_start": "03:24:42.248",
      "formatted_end": "03:24:43.126",
      "speaker": "SPEAKER_01"
    },
    {
      "start": 12289.167,
      "end": 12293.656,
      "formatted_start": "03:24:49.167",
      "formatted_end": "03:24:53.656",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 12294.382,
      "end": 12297.284,
      "formatted_start": "03:24:54.382",
      "formatted_end": "03:24:57.284",
      "speaker": "SPEAKER_00"
    },
    {
      "start": 12297.723,
      "end": 12299.967,
      "formatted_start": "03:24:57.723",
      "formatted_end": "03:24:59.967",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12006.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:06.000",
      "text": "اینجا چند سال همچنین یکی میخوردی؟ یکی دو. ببینیم و بعد رو یادش کنیم."
    },
    {
      "id": 1,
      "start": 12006.0,
      "end": 12014.0,
      "formatted_start": "03:20:06.000",
      "formatted_end": "03:20:14.000",
      "text": "اونو برای چی میخوری؟ ببینیم اینو. اینو نباید بخورید. این خلیت رو دامون میکنند."
    },
    {
      "id": 2,
      "start": 12014.0,
      "end": 12023.0,
      "formatted_start": "03:20:14.000",
      "formatted_end": "03:20:23.000",
      "text": "امتحان بودن هم که درد میکنه. فقط ماهی یکی دوتا. ماهی یکی دوتا. این خلیت رو خراب میکنند. خب، خب."
    },
    {
      "id": 3,
      "start": 12023.0,
      "end": 12028.0,
      "formatted_start": "03:20:23.000",
      "formatted_end": "03:20:28.000",
      "text": "بعد مادر قرص تیرویدتو پنج شمه جمال قرص دوتا مو کنید"
    },
    {
      "id": 4,
      "start": 12028.0,
      "end": 12032.0,
      "formatted_start": "03:20:28.000",
      "formatted_end": "03:20:32.000",
      "text": "بگیر وقتا از چربت میگیرم خوانم دکتور"
    },
    {
      "id": 5,
      "start": 12032.0,
      "end": 12035.0,
      "formatted_start": "03:20:32.000",
      "formatted_end": "03:20:35.000",
      "text": "قندت بالاست خوب مونند میکنه دودار"
    },
    {
      "id": 6,
      "start": 12035.0,
      "end": 12037.0,
      "formatted_start": "03:20:35.000",
      "formatted_end": "03:20:37.000",
      "text": "از این یوسین میکنم"
    },
    {
      "id": 7,
      "start": 12037.0,
      "end": 12038.0,
      "formatted_start": "03:20:37.000",
      "formatted_end": "03:20:38.000",
      "text": "بتر میشید"
    },
    {
      "id": 8,
      "start": 12038.0,
      "end": 12039.0,
      "formatted_start": "03:20:38.000",
      "formatted_end": "03:20:39.000",
      "text": "بتر میشید"
    },
    {
      "id": 9,
      "start": 12039.0,
      "end": 12043.0,
      "formatted_start": "03:20:39.000",
      "formatted_end": "03:20:43.000",
      "text": "مادر چربیت هم بالاست با اینکه قرص میخونید"
    },
    {
      "id": 10,
      "start": 12043.0,
      "end": 12044.0,
      "formatted_start": "03:20:43.000",
      "formatted_end": "03:20:44.000",
      "text": "رایت فهمی کنید"
    },
    {
      "id": 11,
      "start": 12044.0,
      "end": 12047.0,
      "formatted_start": "03:20:44.000",
      "formatted_end": "03:20:47.000",
      "text": "نه راحت میکنم خوانم دکتور"
    },
    {
      "id": 12,
      "start": 12047.0,
      "end": 12049.0,
      "formatted_start": "03:20:47.000",
      "formatted_end": "03:20:49.000",
      "text": "شکلی شکلات مشابه دلسته"
    },
    {
      "id": 13,
      "start": 12049.0,
      "end": 12057.0,
      "formatted_start": "03:20:49.000",
      "formatted_end": "03:20:57.000",
      "text": "یک وقت های مثلا که روی صفره هست که یک وقت هایی که بیمان چیزی باره"
    },
    {
      "id": 14,
      "start": 12057.0,
      "end": 12063.0,
      "formatted_start": "03:20:57.000",
      "formatted_end": "03:21:03.000",
      "text": "نه باید بخوری هندونه، خربازه، انگور، موز، واکارانی"
    },
    {
      "id": 15,
      "start": 12063.0,
      "end": 12065.0,
      "formatted_start": "03:21:03.000",
      "formatted_end": "03:21:05.000",
      "text": "این دوانه میخورم"
    },
    {
      "id": 16,
      "start": 12065.0,
      "end": 12067.0,
      "formatted_start": "03:21:05.000",
      "formatted_end": "03:21:07.000",
      "text": "خب ما میخوری که غنده بالاست"
    },
    {
      "id": 17,
      "start": 12067.0,
      "end": 12069.0,
      "formatted_start": "03:21:07.000",
      "formatted_end": "03:21:09.000",
      "text": "آقا دیگه هندونه"
    },
    {
      "id": 18,
      "start": 12069.0,
      "end": 12071.0,
      "formatted_start": "03:21:09.000",
      "formatted_end": "03:21:11.000",
      "text": "نون و برنج رو تو باید کم کنی"
    },
    {
      "id": 19,
      "start": 12071.0,
      "end": 12073.0,
      "formatted_start": "03:21:11.000",
      "formatted_end": "03:21:13.000",
      "text": "برنج مثلا 10 کاشور بیشتر نه خوری"
    },
    {
      "id": 20,
      "start": 12073.0,
      "end": 12077.0,
      "formatted_start": "03:21:13.000",
      "formatted_end": "03:21:17.000",
      "text": "سیر نمیشی مثلا یکم رو بیا ماش رو بیچش بروی"
    },
    {
      "id": 21,
      "start": 12077.0,
      "end": 12079.0,
      "formatted_start": "03:21:17.000",
      "formatted_end": "03:21:19.000",
      "text": "ماش عدس آپست کنی قاطع کنی"
    },
    {
      "id": 22,
      "start": 12079.0,
      "end": 12081.0,
      "formatted_start": "03:21:19.000",
      "formatted_end": "03:21:21.000",
      "text": "خیال راجه دیز کن برو"
    },
    {
      "id": 23,
      "start": 12081.0,
      "end": 12083.0,
      "formatted_start": "03:21:21.000",
      "formatted_end": "03:21:23.000",
      "text": "همیشه سر گرد میگیرم مثلا"
    },
    {
      "id": 24,
      "start": 12083.0,
      "end": 12087.06,
      "formatted_start": "03:21:23.000",
      "formatted_end": "03:21:27.060",
      "text": "اطلاعا آفز میکنم میتونم توی روزر"
    },
    {
      "id": 25,
      "start": 12087.06,
      "end": 12087.56,
      "formatted_start": "03:21:27.060",
      "formatted_end": "03:21:27.560",
      "text": "آفز"
    },
    {
      "id": 26,
      "start": 12087.56,
      "end": 12089.56,
      "formatted_start": "03:21:27.560",
      "formatted_end": "03:21:29.560",
      "text": "که هر وقت موازم داشتم"
    },
    {
      "id": 27,
      "start": 12089.56,
      "end": 12090.32,
      "formatted_start": "03:21:29.560",
      "formatted_end": "03:21:30.320",
      "text": "از تو پرزم"
    },
    {
      "id": 28,
      "start": 12090.32,
      "end": 12093.4,
      "formatted_start": "03:21:30.320",
      "formatted_end": "03:21:33.400",
      "text": "کردو، بادمجون، فاش، اینجور چیزا آفز کن بخور"
    },
    {
      "id": 29,
      "start": 12093.4,
      "end": 12093.9,
      "formatted_start": "03:21:33.400",
      "formatted_end": "03:21:33.900",
      "text": "خوبه"
    },
    {
      "id": 30,
      "start": 12093.9,
      "end": 12096.44,
      "formatted_start": "03:21:33.900",
      "formatted_end": "03:21:36.440",
      "text": "منو برنجتو نخور با آمیه خیلی خوبه"
    },
    {
      "id": 31,
      "start": 12096.44,
      "end": 12097.86,
      "formatted_start": "03:21:36.440",
      "formatted_end": "03:21:37.860",
      "text": "شمبلیده رو برنجه"
    },
    {
      "id": 32,
      "start": 12097.86,
      "end": 12100.46,
      "formatted_start": "03:21:37.860",
      "formatted_end": "03:21:40.460",
      "text": "دارچین تو چای اگه حساسیت نداری"
    },
    {
      "id": 33,
      "start": 12100.46,
      "end": 12102.22,
      "formatted_start": "03:21:40.460",
      "formatted_end": "03:21:42.220",
      "text": "دارچین همیشه میخورم"
    },
    {
      "id": 34,
      "start": 12102.22,
      "end": 12102.56,
      "formatted_start": "03:21:42.220",
      "formatted_end": "03:21:42.560",
      "text": "بعد"
    },
    {
      "id": 35,
      "start": 12102.56,
      "end": 12106.34,
      "formatted_start": "03:21:42.560",
      "formatted_end": "03:21:46.340",
      "text": "گزنه هفته یکی علاتو بار بجشون بخور"
    },
    {
      "id": 36,
      "start": 12106.34,
      "end": 12107.96,
      "formatted_start": "03:21:46.340",
      "formatted_end": "03:21:47.960",
      "text": "گزنه هم خوبه"
    },
    {
      "id": 37,
      "start": 12107.96,
      "end": 12109.58,
      "formatted_start": "03:21:47.960",
      "formatted_end": "03:21:49.580",
      "text": "خودتو میاره پایین"
    },
    {
      "id": 38,
      "start": 12109.58,
      "end": 12109.96,
      "formatted_start": "03:21:49.580",
      "formatted_end": "03:21:49.960",
      "text": "بعد"
    },
    {
      "id": 39,
      "start": 12109.96,
      "end": 12117.2,
      "formatted_start": "03:21:49.960",
      "formatted_end": "03:21:57.200",
      "text": "چربی یکم بالاست اینکه هیچی دارو تو نوالو باید عوض کنی"
    },
    {
      "id": 40,
      "start": 12117.2,
      "end": 12121.2,
      "formatted_start": "03:21:57.200",
      "formatted_end": "03:22:01.200",
      "text": "برای اون همین آقای دکتر برای رسپت نوالو"
    },
    {
      "id": 41,
      "start": 12121.2,
      "end": 12124.2,
      "formatted_start": "03:22:01.200",
      "formatted_end": "03:22:04.200",
      "text": "باید باس تیروید تماده هم باز کنی"
    },
    {
      "id": 42,
      "start": 12124.2,
      "end": 12129.2,
      "formatted_start": "03:22:04.200",
      "formatted_end": "03:22:09.200",
      "text": "این همارو همارو هم در آقای دکتر برای هم نخطه کرده همین ها رو بگیرم"
    },
    {
      "id": 43,
      "start": 12129.2,
      "end": 12132.2,
      "formatted_start": "03:22:09.200",
      "formatted_end": "03:22:12.200",
      "text": "این ها رو بر من تازه نخطه کرده"
    },
    {
      "id": 44,
      "start": 12132.2,
      "end": 12135.2,
      "formatted_start": "03:22:12.200",
      "formatted_end": "03:22:15.200",
      "text": "باید عوض کنی و این جواب نمیده به"
    },
    {
      "id": 45,
      "start": 12135.2,
      "end": 12136.2,
      "formatted_start": "03:22:15.200",
      "formatted_end": "03:22:16.200",
      "text": "جواب"
    },
    {
      "id": 46,
      "start": 12136.2,
      "end": 12138.2,
      "formatted_start": "03:22:16.200",
      "formatted_end": "03:22:18.200",
      "text": "باس چربی جواب نمیده"
    },
    {
      "id": 47,
      "start": 12139.96,
      "end": 12148.96,
      "formatted_start": "03:22:19.960",
      "formatted_end": "03:22:28.960",
      "text": "قرص چربین این بوده"
    },
    {
      "id": 48,
      "start": 12148.96,
      "end": 12154.96,
      "formatted_start": "03:22:28.960",
      "formatted_end": "03:22:34.960",
      "text": "ولی الان چند وقت به من پایین ترشم میدن میگن دوتا دوتا بخود"
    },
    {
      "id": 49,
      "start": 12154.96,
      "end": 12158.96,
      "formatted_start": "03:22:34.960",
      "formatted_end": "03:22:38.960",
      "text": "الان این بروز گفتم نه همین قرص رو خودمانه بده"
    },
    {
      "id": 50,
      "start": 12158.96,
      "end": 12161.96,
      "formatted_start": "03:22:38.960",
      "formatted_end": "03:22:41.960",
      "text": "خوب پس انشاءالله شاید الان بخوری خوب بشه"
    },
    {
      "id": 51,
      "start": 12161.96,
      "end": 12164.96,
      "formatted_start": "03:22:41.960",
      "formatted_end": "03:22:44.960",
      "text": "چرا یه برق داده؟"
    },
    {
      "id": 52,
      "start": 12164.96,
      "end": 12169.12,
      "formatted_start": "03:22:44.960",
      "formatted_end": "03:22:49.120",
      "text": "این تیرویدت دو تا میگن نداره داری خانه میگن نیسته"
    },
    {
      "id": 53,
      "start": 12169.12,
      "end": 12169.92,
      "formatted_start": "03:22:49.120",
      "formatted_end": "03:22:49.920",
      "text": "اوکی"
    },
    {
      "id": 54,
      "start": 12169.92,
      "end": 12173.84,
      "formatted_start": "03:22:49.920",
      "formatted_end": "03:22:53.840",
      "text": "اوکی که کسی به چیزی نمیرسه"
    },
    {
      "id": 55,
      "start": 12173.84,
      "end": 12177.14,
      "formatted_start": "03:22:53.840",
      "formatted_end": "03:22:57.140",
      "text": "اون که به چیزی نمیرسه"
    },
    {
      "id": 56,
      "start": 12177.14,
      "end": 12179.96,
      "formatted_start": "03:22:57.140",
      "formatted_end": "03:22:59.960",
      "text": "امیدواری که نمیدن داری خانه سخته"
    },
    {
      "id": 57,
      "start": 12180.66,
      "end": 12181.96,
      "formatted_start": "03:23:00.660",
      "formatted_end": "03:23:01.960",
      "text": "آقای دکتور میمیته"
    },
    {
      "id": 58,
      "start": 12183.28,
      "end": 12184.88,
      "formatted_start": "03:23:03.280",
      "formatted_end": "03:23:04.880",
      "text": "یا خانم دکتور میمیته"
    },
    {
      "id": 59,
      "start": 12184.88,
      "end": 12187.22,
      "formatted_start": "03:23:04.880",
      "formatted_end": "03:23:07.220",
      "text": "فرده نمیدن داری خانه"
    },
    {
      "id": 60,
      "start": 12187.22,
      "end": 12190.9,
      "formatted_start": "03:23:07.220",
      "formatted_end": "03:23:10.900",
      "text": "قرص تیرویدت ما در روزهای جمعه دو تا بخوری خب؟"
    },
    {
      "id": 61,
      "start": 12190.9,
      "end": 12191.84,
      "formatted_start": "03:23:10.900",
      "formatted_end": "03:23:11.840",
      "text": "دو تا بخورم"
    },
    {
      "id": 62,
      "start": 12191.84,
      "end": 12193.84,
      "formatted_start": "03:23:11.840",
      "formatted_end": "03:23:13.840",
      "text": "قره پنشنگه و جمعه دو تا"
    },
    {
      "id": 63,
      "start": 12193.84,
      "end": 12196.28,
      "formatted_start": "03:23:13.840",
      "formatted_end": "03:23:16.280",
      "text": "تیرویدت خیلی اومده پایین"
    },
    {
      "id": 64,
      "start": 12196.28,
      "end": 12197.12,
      "formatted_start": "03:23:16.280",
      "formatted_end": "03:23:17.120",
      "text": "آه"
    },
    {
      "id": 65,
      "start": 12197.12,
      "end": 12199.84,
      "formatted_start": "03:23:17.120",
      "formatted_end": "03:23:19.840",
      "text": "همین غیرمزار داده دارم"
    },
    {
      "id": 66,
      "start": 12199.84,
      "end": 12201.98,
      "formatted_start": "03:23:19.840",
      "formatted_end": "03:23:21.980",
      "text": "مرتب میخوردی"
    },
    {
      "id": 67,
      "start": 12201.98,
      "end": 12204.2,
      "formatted_start": "03:23:21.980",
      "formatted_end": "03:23:24.200",
      "text": "پس پنشنبه جمعه دوتا بخور"
    },
    {
      "id": 68,
      "start": 12204.2,
      "end": 12204.76,
      "formatted_start": "03:23:24.200",
      "formatted_end": "03:23:24.760",
      "text": "خب؟"
    },
    {
      "id": 69,
      "start": 12204.76,
      "end": 12206.36,
      "formatted_start": "03:23:24.760",
      "formatted_end": "03:23:26.360",
      "text": "این در مورد تیرویده"
    },
    {
      "id": 70,
      "start": 12206.36,
      "end": 12209.0,
      "formatted_start": "03:23:26.360",
      "formatted_end": "03:23:29.000",
      "text": "ویتامین دیتر رو که دکتر دارو داده"
    },
    {
      "id": 71,
      "start": 12209.0,
      "end": 12211.06,
      "formatted_start": "03:23:29.000",
      "formatted_end": "03:23:31.060",
      "text": "که پایین بوده"
    },
    {
      "id": 72,
      "start": 12211.06,
      "end": 12212.78,
      "formatted_start": "03:23:31.060",
      "formatted_end": "03:23:32.780",
      "text": "خب اینجا رو که دکتر درمون کرده"
    },
    {
      "id": 73,
      "start": 12212.78,
      "end": 12214.26,
      "formatted_start": "03:23:32.780",
      "formatted_end": "03:23:34.260",
      "text": "بقیه افونتی داشتی"
    },
    {
      "id": 74,
      "start": 12214.26,
      "end": 12216.86,
      "formatted_start": "03:23:34.260",
      "formatted_end": "03:23:36.860",
      "text": "افونتم آه داشتم"
    },
    {
      "id": 75,
      "start": 12216.86,
      "end": 12218.18,
      "formatted_start": "03:23:36.860",
      "formatted_end": "03:23:38.180",
      "text": "آه دو داشتی"
    },
    {
      "id": 76,
      "start": 12218.18,
      "end": 12219.08,
      "formatted_start": "03:23:38.180",
      "formatted_end": "03:23:39.080",
      "text": "من"
    },
    {
      "id": 77,
      "start": 12219.08,
      "end": 12219.46,
      "formatted_start": "03:23:39.080",
      "formatted_end": "03:23:39.460",
      "text": "من"
    },
    {
      "id": 78,
      "start": 12219.46,
      "end": 12222.46,
      "formatted_start": "03:23:39.460",
      "formatted_end": "03:23:42.460",
      "text": "اون دقیقه نمیشته کرد"
    },
    {
      "id": 79,
      "start": 12222.46,
      "end": 12232.46,
      "formatted_start": "03:23:42.460",
      "formatted_end": "03:23:52.460",
      "text": "خوشکن داد به من یک بسیار گرسه بود"
    },
    {
      "id": 80,
      "start": 12232.46,
      "end": 12234.46,
      "formatted_start": "03:23:52.460",
      "formatted_end": "03:23:54.460",
      "text": "اوه، اون درستگی چیزی داشتی؟"
    },
    {
      "id": 81,
      "start": 12234.46,
      "end": 12240.46,
      "formatted_start": "03:23:54.460",
      "formatted_end": "03:24:00.460",
      "text": "آره، همجوری روزه ها اونو فونت داشته بود، فلون درد می کرد"
    },
    {
      "id": 82,
      "start": 12240.46,
      "end": 12244.46,
      "formatted_start": "03:24:00.460",
      "formatted_end": "03:24:04.460",
      "text": "بله، بیتر نشدم"
    },
    {
      "id": 83,
      "start": 12244.46,
      "end": 12250.46,
      "formatted_start": "03:24:04.460",
      "formatted_end": "03:24:10.460",
      "text": "اینو صبح و شب بخور باشه"
    },
    {
      "id": 84,
      "start": 12250.46,
      "end": 12252.46,
      "formatted_start": "03:24:10.460",
      "formatted_end": "03:24:12.460",
      "text": "من اینه خانم دکتر"
    },
    {
      "id": 85,
      "start": 12252.46,
      "end": 12256.46,
      "formatted_start": "03:24:12.460",
      "formatted_end": "03:24:16.460",
      "text": "صبح صبحانه منو که میخوردم"
    },
    {
      "id": 86,
      "start": 12256.46,
      "end": 12260.46,
      "formatted_start": "03:24:16.460",
      "formatted_end": "03:24:20.460",
      "text": "اونجا گرسان توی زرد بذاشتم اونجا پیش بکنم"
    },
    {
      "id": 87,
      "start": 12260.46,
      "end": 12264.46,
      "formatted_start": "03:24:20.460",
      "formatted_end": "03:24:24.460",
      "text": "یا جایم میرم تو کیبم بسته میکنم"
    },
    {
      "id": 88,
      "start": 12264.46,
      "end": 12267.46,
      "formatted_start": "03:24:24.460",
      "formatted_end": "03:24:27.460",
      "text": "زرد کدم یه دونه ما تکن میذارم"
    },
    {
      "id": 89,
      "start": 12267.46,
      "end": 12270.46,
      "formatted_start": "03:24:27.460",
      "formatted_end": "03:24:30.460",
      "text": "صبحانه که میخورم یکی میکنم"
    },
    {
      "id": 90,
      "start": 12270.46,
      "end": 12272.46,
      "formatted_start": "03:24:30.460",
      "formatted_end": "03:24:32.460",
      "text": "زور نهار بخورم اونجا"
    },
    {
      "id": 91,
      "start": 12272.46,
      "end": 12274.46,
      "formatted_start": "03:24:32.460",
      "formatted_end": "03:24:34.460",
      "text": "اصراله بخورم اونجا"
    },
    {
      "id": 92,
      "start": 12274.46,
      "end": 12277.46,
      "formatted_start": "03:24:34.460",
      "formatted_end": "03:24:37.460",
      "text": "گرس منو تکمید میخورم"
    },
    {
      "id": 93,
      "start": 12277.46,
      "end": 12279.46,
      "formatted_start": "03:24:37.460",
      "formatted_end": "03:24:39.460",
      "text": "خب بعدی غندتون بالا است"
    },
    {
      "id": 94,
      "start": 12279.46,
      "end": 12281.46,
      "formatted_start": "03:24:39.460",
      "formatted_end": "03:24:41.460",
      "text": "بالا است بدن همین همه دفتر"
    },
    {
      "id": 95,
      "start": 12281.46,
      "end": 12283.46,
      "formatted_start": "03:24:41.460",
      "formatted_end": "03:24:43.460",
      "text": "نصف شب ها زعف نمیافتی؟"
    },
    {
      "id": 96,
      "start": 12283.46,
      "end": 12288.46,
      "formatted_start": "03:24:43.460",
      "formatted_end": "03:24:48.460",
      "text": "زعف میافتم وقتی برند میشم یه چیزی میخورم"
    },
    {
      "id": 97,
      "start": 12288.46,
      "end": 12290.46,
      "formatted_start": "03:24:48.460",
      "formatted_end": "03:24:50.460",
      "text": "ریشتر شب ها زعف میافتی یا نه؟"
    },
    {
      "id": 98,
      "start": 12290.46,
      "end": 12296.46,
      "formatted_start": "03:24:50.460",
      "formatted_end": "03:24:56.460",
      "text": "فرق نمیکنه صبح یا زوره یه دقتا زعف هم میافته"
    },
    {
      "id": 99,
      "start": 12296.46,
      "end": 12298.46,
      "formatted_start": "03:24:56.460",
      "formatted_end": "03:24:58.460",
      "text": "دستگاه چکه غند داری تو خورند؟"
    },
    {
      "id": 100,
      "start": 12298.46,
      "end": 12299.46,
      "formatted_start": "03:24:58.460",
      "formatted_end": "03:24:59.460",
      "text": "نه نه برده"
    }
  ],
  "status": "completed"
}