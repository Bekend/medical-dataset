  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9030.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:30.000",
      "text": "از اینجا باید برداریم، از اینجا باید برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا برداریم، از اینجا ب"
    },
    {
      "id": 1,
      "start": 9030.0,
      "end": 9033.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:33.000",
      "text": "یک دقیقه بزنم که اینترنت آدنو میاز"
    },
    {
      "id": 2,
      "start": 9033.0,
      "end": 9039.0,
      "formatted_start": "02:30:33.000",
      "formatted_end": "02:30:39.000",
      "text": "آدنو میاز یک نوع رهمیه که در واقع بیماری اندومتریوز"
    },
    {
      "id": 3,
      "start": 9039.0,
      "end": 9042.0,
      "formatted_start": "02:30:39.000",
      "formatted_end": "02:30:42.000",
      "text": "اون رهم سه تا لایه داره خب"
    },
    {
      "id": 4,
      "start": 9042.0,
      "end": 9046.0,
      "formatted_start": "02:30:42.000",
      "formatted_end": "02:30:46.000",
      "text": "اندومتریوز، میومتر، و این میومتر خالجه خب"
    },
    {
      "id": 5,
      "start": 9046.0,
      "end": 9051.0,
      "formatted_start": "02:30:46.000",
      "formatted_end": "02:30:51.000",
      "text": "اون اندومتریوز، این بیماریه که این اندومتر"
    },
    {
      "id": 6,
      "start": 9051.0,
      "end": 9056.0,
      "formatted_start": "02:30:51.000",
      "formatted_end": "02:30:56.000",
      "text": "به داخل میومتر به صورت شاخری نفوز میکنه خب"
    },
    {
      "id": 7,
      "start": 9056.0,
      "end": 9060.0,
      "formatted_start": "02:30:56.000",
      "formatted_end": "02:31:00.000",
      "text": "شما تو پیروت چه اتفاق میفته؟ آندومت ریزرش میکنه"
    },
    {
      "id": 8,
      "start": 9060.0,
      "end": 9071.0,
      "formatted_start": "02:31:00.000",
      "formatted_end": "02:31:11.000",
      "text": "حالا این از نوع میومیه که اون لایه میومت زخیمه، خشنه و آندومت ها توش نفوز کرده"
    },
    {
      "id": 9,
      "start": 9071.0,
      "end": 9082.0,
      "formatted_start": "02:31:11.000",
      "formatted_end": "02:31:22.000",
      "text": "چه عوارضی داره؟ نزدیکی های دردناک، پریود های طولانی، پریود با خمولیزی های شدید و همین داستانی که شما دارید بیدید"
    },
    {
      "id": 10,
      "start": 9082.0,
      "end": 9091.18,
      "formatted_start": "02:31:22.000",
      "formatted_end": "02:31:31.180",
      "text": "خدا گاهی وقتا چی کار ما می کنیم مثلا یا با الی اینها در راه خونوزی تو کم می کنیم اگه به حد بسازه"
    },
    {
      "id": 11,
      "start": 9091.18,
      "end": 9095.5,
      "formatted_start": "02:31:31.180",
      "formatted_end": "02:31:35.500",
      "text": "اگه خیلی لکی بینی زیاد باشه پرشسترون دافا مدیدی"
    },
    {
      "id": 12,
      "start": 9095.5,
      "end": 9097.42,
      "formatted_start": "02:31:35.500",
      "formatted_end": "02:31:37.420",
      "text": "استفاده کردم همه یا"
    },
    {
      "id": 13,
      "start": 9097.42,
      "end": 9100.0,
      "formatted_start": "02:31:37.420",
      "formatted_end": "02:31:40.000",
      "text": "خدا چند روز خونوزی داری؟"
    },
    {
      "id": 14,
      "start": 9100.82,
      "end": 9104.0,
      "formatted_start": "02:31:40.820",
      "formatted_end": "02:31:44.000",
      "text": "از پیدیادت که تا ماشه چند روز تونم کشه؟"
    },
    {
      "id": 15,
      "start": 9104.62,
      "end": 9107.14,
      "formatted_start": "02:31:44.620",
      "formatted_end": "02:31:47.140",
      "text": "دقیقا دفترون و دفترون"
    },
    {
      "id": 16,
      "start": 9107.14,
      "end": 9110.0,
      "formatted_start": "02:31:47.140",
      "formatted_end": "02:31:50.000",
      "text": "مفتنامی که اگه بخوری هم قد نمی شه"
    },
    {
      "id": 17,
      "start": 9110.0,
      "end": 9116.46,
      "formatted_start": "02:31:50.000",
      "formatted_end": "02:31:56.460",
      "text": "نخوردم. مفتنامیت نخوردم. اما این درویه که اینام گفتیم ایلدی و ترانسامیت بخوردم"
    },
    {
      "id": 18,
      "start": 9116.46,
      "end": 9123.48,
      "formatted_start": "02:31:56.460",
      "formatted_end": "02:32:03.480",
      "text": "مفتنامیت بخور کار سنگین نباید بکنی به محصه پاک شدن باید بار سنگین نباید اصلا بلند کنی"
    },
    {
      "id": 19,
      "start": 9123.48,
      "end": 9125.48,
      "formatted_start": "02:32:03.480",
      "formatted_end": "02:32:05.480",
      "text": "همون آب داق نباید بکنی"
    },
    {
      "id": 20,
      "start": 9125.48,
      "end": 9129.86,
      "formatted_start": "02:32:05.480",
      "formatted_end": "02:32:09.860",
      "text": "فعالیت سنگین و ورزش نباید بکنی نزدیکی نباید شده باشه"
    },
    {
      "id": 21,
      "start": 9129.86,
      "end": 9131.86,
      "formatted_start": "02:32:09.860",
      "formatted_end": "02:32:11.860",
      "text": "همه اینها رو باید رایت کنی"
    },
    {
      "id": 22,
      "start": 9131.86,
      "end": 9134.66,
      "formatted_start": "02:32:11.860",
      "formatted_end": "02:32:14.660",
      "text": "چون از اون دهه ماه یکی مستعد درکه بینه"
    },
    {
      "id": 23,
      "start": 9140.0,
      "end": 9146.66,
      "formatted_start": "02:32:20.000",
      "formatted_end": "02:32:26.660",
      "text": "وکه خب دیگه اون دوره که چی رو گذروندی یعنی حتی اون زن فقط در بهترین حالت ناسان دیگه میخواد بگو چی"
    },
    {
      "id": 24,
      "start": 9146.66,
      "end": 9152.0,
      "formatted_start": "02:32:26.660",
      "formatted_end": "02:32:32.000",
      "text": "برداشت رهنگ دنیا خوشگیب بنابرای هزار و ازدیار تا زندگی"
    },
    {
      "id": 25,
      "start": 9152.0,
      "end": 9159.44,
      "formatted_start": "02:32:32.000",
      "formatted_end": "02:32:39.440",
      "text": "جره رهنگ جز زنگی نیست همه اینجا همین بود"
    },
    {
      "id": 26,
      "start": 9159.44,
      "end": 9161.54,
      "formatted_start": "02:32:39.440",
      "formatted_end": "02:32:41.540",
      "text": "میگفتم که بر ندارم"
    },
    {
      "id": 27,
      "start": 9161.54,
      "end": 9167.14,
      "formatted_start": "02:32:41.540",
      "formatted_end": "02:32:47.140",
      "text": "چون میگفتم اگر میخوام یایسته بشم خب دیگه من نخوایتش برد هفت سال دیگه بشم"
    },
    {
      "id": 28,
      "start": 9167.14,
      "end": 9177.14,
      "formatted_start": "02:32:47.140",
      "formatted_end": "02:32:57.140",
      "text": "من این درد رو قبول کنم اما خب عذیب هم میکنم اونجا که خب من میخوام نزدیکی چیزی داشته باشم خونیزی داشته باشم واقعا کلافه میشم سرش"
    },
    {
      "id": 29,
      "start": 9177.14,
      "end": 9180.14,
      "formatted_start": "02:32:57.140",
      "formatted_end": "02:33:00.140",
      "text": "عصبی میشم هر سری میرم دشی میرم خونیزی دارم"
    },
    {
      "id": 30,
      "start": 9180.14,
      "end": 9183.14,
      "formatted_start": "02:33:00.140",
      "formatted_end": "02:33:03.140",
      "text": "میخوام این مثلا قط بشه"
    },
    {
      "id": 31,
      "start": 9183.14,
      "end": 9187.14,
      "formatted_start": "02:33:03.140",
      "formatted_end": "02:33:07.140",
      "text": "یعنی مفنامک بخور هر هیچ ساعت خب و چیزی که بخورتم خیلی"
    },
    {
      "id": 32,
      "start": 9187.14,
      "end": 9190.14,
      "formatted_start": "02:33:07.140",
      "formatted_end": "02:33:10.140",
      "text": "توی همون دوران پریودی بخورم و نکلن"
    },
    {
      "id": 33,
      "start": 9190.14,
      "end": 9193.14,
      "formatted_start": "02:33:10.140",
      "formatted_end": "02:33:13.140",
      "text": "از اینجا، از اول روش دارید."
    },
    {
      "id": 34,
      "start": 9193.14,
      "end": 9196.14,
      "formatted_start": "02:33:13.140",
      "formatted_end": "02:33:16.140",
      "text": "دوره خون ریزی را بود."
    },
    {
      "id": 35,
      "start": 9196.14,
      "end": 9199.14,
      "formatted_start": "02:33:16.140",
      "formatted_end": "02:33:19.140",
      "text": "از اینجا، از اول روش دارید."
    },
    {
      "id": 36,
      "start": 9199.14,
      "end": 9202.14,
      "formatted_start": "02:33:19.140",
      "formatted_end": "02:33:22.140",
      "text": "از اول روش دارید."
    },
    {
      "id": 37,
      "start": 9202.14,
      "end": 9205.14,
      "formatted_start": "02:33:22.140",
      "formatted_end": "02:33:25.140",
      "text": "از اول روش دارید."
    },
    {
      "id": 38,
      "start": 9205.14,
      "end": 9208.14,
      "formatted_start": "02:33:25.140",
      "formatted_end": "02:33:28.140",
      "text": "از اول روش دارید."
    },
    {
      "id": 39,
      "start": 9208.14,
      "end": 9211.14,
      "formatted_start": "02:33:28.140",
      "formatted_end": "02:33:31.140",
