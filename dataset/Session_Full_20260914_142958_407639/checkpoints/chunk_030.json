      "formatted_start": "02:33:34.140",
      "formatted_end": "02:33:37.140",
      "text": "از اول روش دارید."
    },
    {
      "id": 42,
      "start": 9217.14,
      "end": 9247.14,
      "formatted_start": "02:33:37.140",
      "formatted_end": "02:34:07.140",
      "text": "این درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد درد در"
    },
    {
      "id": 43,
      "start": 9247.14,
      "end": 9249.48,
      "formatted_start": "02:34:07.140",
      "formatted_end": "02:34:09.480",
      "text": "این کامل اصحاب اینجا هست"
    },
