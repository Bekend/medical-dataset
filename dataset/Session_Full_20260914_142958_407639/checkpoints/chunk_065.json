  "stt_segments": [
    {
      "id": 0,
      "start": 19500.0,
      "end": 19529.98,
      "formatted_start": "05:25:00.000",
      "formatted_end": "05:25:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 19530.0,
      "end": 19532.0,
      "formatted_start": "05:25:30.000",
      "formatted_end": "05:25:32.000",
      "text": "صدای خودش"
    },
    {
      "id": 2,
      "start": 19532.0,
      "end": 19534.0,
      "formatted_start": "05:25:32.000",
      "formatted_end": "05:25:34.000",
      "text": "نفس بوده همه باز"
    },
    {
      "id": 3,
      "start": 19534.0,
      "end": 19556.0,
      "formatted_start": "05:25:34.000",
      "formatted_end": "05:25:56.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 19556.0,
      "end": 19559.64,
      "formatted_start": "05:25:56.000",
      "formatted_end": "05:25:59.640",
      "text": "بعد چستیو برگشتن، عکس گرفتی؟"
    },
    {
      "id": 5,
      "start": 19559.64,
      "end": 19561.0,
      "formatted_start": "05:25:59.640",
      "formatted_end": "05:26:01.000",
      "text": "آره، آره"
    },
    {
      "id": 6,
      "start": 19561.0,
      "end": 19563.4,
      "formatted_start": "05:26:01.000",
      "formatted_end": "05:26:03.400",
      "text": "یاد کنستن محالت طبیعی دوباره برگشتی؟"
    },
    {
      "id": 7,
      "start": 19563.4,
      "end": 19564.0,
      "formatted_start": "05:26:03.400",
      "formatted_end": "05:26:04.000",
      "text": "نه، نه"
    },
    {
      "id": 8,
      "start": 19564.0,
      "end": 19566.0,
      "formatted_start": "05:26:04.000",
      "formatted_end": "05:26:06.000",
      "text": "چون اینجا خواهش استداره"
    },
    {
      "id": 9,
      "start": 19566.0,
      "end": 19568.6,
      "formatted_start": "05:26:06.000",
      "formatted_end": "05:26:08.600",
      "text": "چون از اینجا که تا چینه شد، بیلو مانو مکرد کردی؟"
    },
    {
      "id": 10,
      "start": 19568.6,
      "end": 19569.4,
      "formatted_start": "05:26:08.600",
      "formatted_end": "05:26:09.400",
      "text": "آره، نه"
    },
    {
      "id": 11,
      "start": 19569.4,
      "end": 19571.0,
      "formatted_start": "05:26:09.400",
      "formatted_end": "05:26:11.000",
      "text": "چند بار عکس گرفت"
    },
    {
      "id": 12,
      "start": 19571.0,
      "end": 19574.0,
      "formatted_start": "05:26:11.000",
      "formatted_end": "05:26:14.000",
      "text": "اینکه هوا مونده بود، بعد دوباره بازم بگذارم"
    },
    {
      "id": 13,
      "start": 19574.0,
      "end": 19575.6,
      "formatted_start": "05:26:14.000",
      "formatted_end": "05:26:15.600",
      "text": "یک دو سر روز خطردیتی بودم"
    },
    {
      "id": 14,
      "start": 19575.6,
      "end": 19577.6,
      "formatted_start": "05:26:15.600",
      "formatted_end": "05:26:17.600",
      "text": "چستیو بازم بکشن، دوباره بودم"
    },
    {
      "id": 15,
      "start": 19577.6,
      "end": 19582.6,
      "formatted_start": "05:26:17.600",
      "formatted_end": "05:26:22.600",
      "text": "اینجا باید دوباره بگویم که اگر اینکه بود ولی اگر بود مجبوری دو بزرگ تا موقعی بزاریم"
    },
    {
      "id": 16,
      "start": 19582.6,
      "end": 19585.6,
      "formatted_start": "05:26:22.600",
      "formatted_end": "05:26:25.600",
      "text": "بعد برداخل اون آنها خودش رو هم تجرب کرد"
    },
    {
      "id": 17,
      "start": 19585.6,
      "end": 19589.6,
      "formatted_start": "05:26:25.600",
      "formatted_end": "05:26:29.600",
      "text": "بعد من صدای که هم رفتم بگویم که همه ریست هست می کردم هوا داره ولی نداره"
    },
    {
      "id": 18,
      "start": 19589.6,
      "end": 19592.6,
      "formatted_start": "05:26:29.600",
      "formatted_end": "05:26:32.600",
      "text": "داخل آخرین عکسی که گرفته بود یه چرو بود"
    },
    {
      "id": 19,
      "start": 19592.6,
      "end": 19595.6,
      "formatted_start": "05:26:32.600",
      "formatted_end": "05:26:35.600",
      "text": "وقتی گرفتم که بود دیگر از تو باید یه زبه شد و خودش میرده"
    },
    {
      "id": 20,
      "start": 19595.6,
      "end": 19596.6,
      "formatted_start": "05:26:35.600",
      "formatted_end": "05:26:36.600",
      "text": "چرس می شد"
    },
    {
      "id": 21,
      "start": 19596.6,
      "end": 19597.6,
      "formatted_start": "05:26:36.600",
      "formatted_end": "05:26:37.600",
      "text": "آره بود چرس می شد"
    },
    {
      "id": 22,
      "start": 19597.6,
      "end": 19599.6,
      "formatted_start": "05:26:37.600",
      "formatted_end": "05:26:39.600",
      "text": "از اینجا برگرده نگرده بود"
    },
    {
      "id": 23,
      "start": 19599.6,
      "end": 19601.6,
      "formatted_start": "05:26:39.600",
      "formatted_end": "05:26:41.600",
      "text": "اینجا باید همه چیزی بگرده بود"
    },
    {
      "id": 24,
      "start": 19601.6,
      "end": 19603.6,
      "formatted_start": "05:26:41.600",
      "formatted_end": "05:26:43.600",
      "text": "نه بگیرده نگرده بود"
    },
    {
      "id": 25,
      "start": 19605.6,
      "end": 19607.6,
      "formatted_start": "05:26:45.600",
      "formatted_end": "05:26:47.600",
      "text": "ترس سیاد بود"
    },
    {
      "id": 26,
      "start": 19607.6,
      "end": 19609.6,
      "formatted_start": "05:26:47.600",
      "formatted_end": "05:26:49.600",
      "text": "اینجا باید استرس بود"
    },
    {
      "id": 27,
      "start": 19609.6,
      "end": 19611.6,
      "formatted_start": "05:26:49.600",
      "formatted_end": "05:26:51.600",
      "text": "نه باید بود"
    },
    {
      "id": 28,
      "start": 19611.6,
      "end": 19613.6,
      "formatted_start": "05:26:51.600",
      "formatted_end": "05:26:53.600",
      "text": "نه باید بود"
    },
    {
      "id": 29,
      "start": 19613.6,
      "end": 19615.6,
      "formatted_start": "05:26:53.600",
      "formatted_end": "05:26:55.600",
      "text": "شما شما اینجا نه بود"
    },
    {
      "id": 30,
      "start": 19615.6,
      "end": 19617.6,
      "formatted_start": "05:26:55.600",
      "formatted_end": "05:26:57.600",
      "text": "باید باید استرس بود"
    },
    {
      "id": 31,
      "start": 19617.6,
      "end": 19619.6,
      "formatted_start": "05:26:57.600",
      "formatted_end": "05:26:59.600",
      "text": "باید برگرده بود"
    },
    {
      "id": 32,
      "start": 19619.6,
      "end": 19621.6,
      "formatted_start": "05:26:59.600",
      "formatted_end": "05:27:01.600",
      "text": "باید برگرده بود"
    },
    {
      "id": 33,
      "start": 19621.6,
      "end": 19623.6,
      "formatted_start": "05:27:01.600",
      "formatted_end": "05:27:03.600",
      "text": "آف"
    },
    {
      "id": 34,
      "start": 19623.6,
      "end": 19625.6,
      "formatted_start": "05:27:03.600",
      "formatted_end": "05:27:05.600",
      "text": "آف"
    },
    {
      "id": 35,
      "start": 19625.6,
      "end": 19628.6,
      "formatted_start": "05:27:05.600",
      "formatted_end": "05:27:08.600",
      "text": "آه، خیلی سفید داری هموشه"
    },
    {
      "id": 36,
      "start": 19628.6,
      "end": 19630.6,
      "formatted_start": "05:27:08.600",
      "formatted_end": "05:27:10.600",
      "text": "چرا همون بیشتر داره؟"
    },
    {
      "id": 37,
      "start": 19630.6,
      "end": 19631.6,
      "formatted_start": "05:27:10.600",
      "formatted_end": "05:27:11.600",
      "text": "اون رب داره"
    },
    {
      "id": 38,
      "start": 19631.6,
      "end": 19632.6,
      "formatted_start": "05:27:11.600",
      "formatted_end": "05:27:12.600",
      "text": "اینجوری؟"
    },
    {
      "id": 39,
      "start": 19632.6,
      "end": 19633.6,
      "formatted_start": "05:27:12.600",
      "formatted_end": "05:27:13.600",
      "text": "اون رب داره دیگه"
    },
    {
      "id": 40,
      "start": 19633.6,
      "end": 19637.6,
      "formatted_start": "05:27:13.600",
      "formatted_end": "05:27:17.600",
      "text": "آره، اینجوری، چون توی مدرنان یکمان پرومشت میشه"
    },
    {
      "id": 41,
      "start": 19637.6,
      "end": 19642.6,
      "formatted_start": "05:27:17.600",
      "formatted_end": "05:27:22.600",
      "text": "پرومشت چیه؟ یعنی طولی دیگه خیلی تا چسبنده"
    },
    {
      "id": 42,
      "start": 19642.6,
      "end": 19645.6,
      "formatted_start": "05:27:22.600",
      "formatted_end": "05:27:25.600",
      "text": "سفید همه بیشتر از آنه، حالت کفه"
    },
    {
      "id": 43,
      "start": 19645.6,
      "end": 19648.6,
      "formatted_start": "05:27:25.600",
      "formatted_end": "05:27:28.600",
      "text": "بیرون هم که میاد، یک کفه سفیده"
    },
    {
      "id": 44,
      "start": 19648.6,
      "end": 19650.6,
      "formatted_start": "05:27:28.600",
      "formatted_end": "05:27:30.600",
      "text": "یعنی خیلی زنی سبز و اینها"
    },
    {
      "id": 45,
      "start": 19650.6,
      "end": 19657.1,
      "formatted_start": "05:27:30.600",
      "formatted_end": "05:27:37.100",
      "text": "حالا دیگر این خلطه محیط رشد چیز در واقع میکروب"
    },
    {
      "id": 46,
      "start": 19657.1,
      "end": 19663.3,
      "formatted_start": "05:27:37.100",
      "formatted_end": "05:27:43.300",
      "text": "و اینو به مرز که یک میکروبی در تماس باشه یک سرمای هوا، هوای سر تنفس کنند"
    },
    {
      "id": 47,
      "start": 19663.3,
      "end": 19668.1,
      "formatted_start": "05:27:43.300",
      "formatted_end": "05:27:48.100",
      "text": "و بیشتر از افراد عادی در مرز سرمو خوردگیرند و سرمایی که میخورند"
    },
    {
      "id": 48,
      "start": 19668.1,
      "end": 19673.6,
      "formatted_start": "05:27:48.100",
      "formatted_end": "05:27:53.600",
      "text": "این خلطه باز چسبنده تا این لنقص یه احساس سختی تنفس میده"
    },
    {
      "id": 49,
      "start": 19673.6,
      "end": 19677.6,
      "formatted_start": "05:27:53.600",
      "formatted_end": "05:27:57.600",
      "text": "این موضوع هست، خطر نداره"
    },
    {
      "id": 50,
      "start": 19677.6,
      "end": 19679.6,
      "formatted_start": "05:27:57.600",
      "formatted_end": "05:27:59.600",
      "text": "دارو برمشون رو روش کنیم"
    },
    {
      "id": 51,
      "start": 19679.6,
      "end": 19681.6,
      "formatted_start": "05:27:59.600",
      "formatted_end": "05:28:01.600",
      "text": "دارو متوقف میکنیم"
    },
    {
      "id": 52,
      "start": 19681.6,
      "end": 19683.6,
      "formatted_start": "05:28:01.600",
      "formatted_end": "05:28:03.600",
      "text": "یعنی بگیم مثلا اون حالت برشیده"
    },
    {
      "id": 53,
      "start": 19683.6,
      "end": 19685.6,
      "formatted_start": "05:28:03.600",
      "formatted_end": "05:28:05.600",
      "text": "اون راه ها که پشت شدن یه دیگه بزرگ شدن"
    },
    {
      "id": 54,
      "start": 19685.6,
      "end": 19687.6,
      "formatted_start": "05:28:05.600",
      "formatted_end": "05:28:07.600",
      "text": "خب شما فقط اینکه"
    },
    {
      "id": 55,
      "start": 19687.6,
      "end": 19689.6,
      "formatted_start": "05:28:07.600",
      "formatted_end": "05:28:09.600",
      "text": "واقعا که چند سال مردم هستیم"
    },
    {
      "id": 56,
      "start": 19689.6,
      "end": 19691.6,
      "formatted_start": "05:28:09.600",
      "formatted_end": "05:28:11.600",
      "text": "نه نه بردی بازش هست"
    },
    {
      "id": 57,
      "start": 19691.6,
      "end": 19693.6,
      "formatted_start": "05:28:11.600",
      "formatted_end": "05:28:13.600",
      "text": "شما دیگه بازش هستن"
    },
    {
      "id": 58,
      "start": 19693.6,
      "end": 19695.6,
      "formatted_start": "05:28:13.600",
      "formatted_end": "05:28:15.600",
      "text": "بردش دیگه مردم همه دامه ندید"
    },
    {
      "id": 59,
      "start": 19695.6,
      "end": 19697.6,
      "formatted_start": "05:28:15.600",
      "formatted_end": "05:28:17.600",
      "text": "فقط دیگه تمام شما"
    },
    {
      "id": 60,
      "start": 19697.6,
      "end": 19699.6,
      "formatted_start": "05:28:17.600",
      "formatted_end": "05:28:19.600",
      "text": "همه رو تمتید میکنم"
    },
    {
      "id": 61,
      "start": 19699.6,
      "end": 19701.6,
      "formatted_start": "05:28:19.600",
      "formatted_end": "05:28:21.600",
      "text": "با شرط جمعه بیرون بیرون"
    },
    {
      "id": 62,
      "start": 19701.6,
      "end": 19703.6,
      "formatted_start": "05:28:21.600",
      "formatted_end": "05:28:23.600",
      "text": "خب خود اصلا ده"
    },
    {
      "id": 63,
      "start": 19707.6,
      "end": 19737.6,
      "formatted_start": "05:28:27.600",
      "formatted_end": "05:28:57.600",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 64,
      "start": 19737.6,
      "end": 19767.6,
      "formatted_start": "05:28:57.600",
      "formatted_end": "05:29:27.600",
      "text": "اگر خود را بسازد، خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را بسازد و خود را"
    },
    {
      "id": 65,
      "start": 19767.6,
      "end": 19770.6,
      "formatted_start": "05:29:27.600",
      "formatted_end": "05:29:30.600",
      "text": "خودش یک وقت میگی من نمیتونم بگفت نه"
    },
    {
      "id": 66,
      "start": 19770.6,
      "end": 19773.6,
      "formatted_start": "05:29:30.600",
      "formatted_end": "05:29:33.600",
      "text": "و بعد درخواهانم بگو سمت برای خلطاوره"
    },
    {
      "id": 67,
      "start": 19773.6,
      "end": 19775.6,
      "formatted_start": "05:29:33.600",
      "formatted_end": "05:29:35.600",
      "text": "خلطاوره خیلی"
    },
    {
      "id": 68,
      "start": 19775.6,
      "end": 19777.6,
      "formatted_start": "05:29:35.600",
      "formatted_end": "05:29:37.600",
      "text": "از اینکه از اونو بشم برسن من با قیادش"
    },
    {
      "id": 69,
      "start": 19777.6,
      "end": 19779.6,
      "formatted_start": "05:29:37.600",
      "formatted_end": "05:29:39.600",
      "text": "میگی برای خلطا دفت بشه"
    },
    {
      "id": 70,
      "start": 19779.6,
      "end": 19781.6,
      "formatted_start": "05:29:39.600",
      "formatted_end": "05:29:41.600",
      "text": "یه جوری خلط نمیشه بگی"
    },
    {
      "id": 71,
      "start": 19781.6,
      "end": 19783.6,
      "formatted_start": "05:29:41.600",
      "formatted_end": "05:29:43.600",
      "text": "نه اون خلطا زیاد میکنه"
    },
    {
      "id": 72,
      "start": 19783.6,
      "end": 19785.6,
      "formatted_start": "05:29:43.600",
      "formatted_end": "05:29:45.600",
      "text": "من جراف بردم"
    },
    {
      "id": 73,
      "start": 19785.6,
      "end": 19787.6,
      "formatted_start": "05:29:45.600",
      "formatted_end": "05:29:47.600",
      "text": "پس اون وقتی که قدم بهش داشتم"
    },
    {
      "id": 74,
      "start": 19787.6,
      "end": 19789.6,
      "formatted_start": "05:29:47.600",
      "formatted_end": "05:29:49.600",
      "text": "گفتم اینو من یه گست میگسم همیشه بخور"
    },
    {
      "id": 75,
      "start": 19789.6,
      "end": 19791.6,
      "formatted_start": "05:29:49.600",
      "formatted_end": "05:29:51.600",
      "text": "ولی وقتی که خلطا چسپنده میشه اونو برد بگو"
    },
    {
      "id": 76,
      "start": 19797.6,
      "end": 19799.98,
      "formatted_start": "05:29:57.600",
      "formatted_end": "05:29:59.980",
      "text": "اونو می کنن که شروط برن"
    }
  ],
  "status": "completed"
}