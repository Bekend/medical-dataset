  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3613.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:13.000",
      "text": "این تکمیلی میگه، باید یا امروی داشته بیان سی تیز کن. من رفتم امروی هم در کور نداشته باشم، ولی مسکنه."
    },
    {
      "id": 1,
      "start": 3613.0,
      "end": 3618.0,
      "formatted_start": "01:00:13.000",
      "formatted_end": "01:00:18.000",
      "text": "قبل از اینکه من توش بود، باید بنابراین سه موه من سپسیت بیان داشتم."
    },
    {
      "id": 2,
      "start": 3618.0,
      "end": 3624.0,
      "formatted_start": "01:00:18.000",
      "formatted_end": "01:00:24.000",
      "text": "سی سپانونا هم های اینو واقعا انقدر توش داشتن. تو هیچ جای دومیا اول مریضان رو یه امروی داشتن."
    },
    {
      "id": 3,
      "start": 3624.0,
      "end": 3629.0,
      "formatted_start": "01:00:24.000",
      "formatted_end": "01:00:29.000",
      "text": "این نسکار رو بر چقدر از امرالی افتادن از مردم؟"
    },
    {
      "id": 4,
      "start": 3629.0,
      "end": 3632.0,
      "formatted_start": "01:00:29.000",
      "formatted_end": "01:00:32.000",
      "text": "خب این نیمه تکمیلی نداره پول منو بگیر"
    },
    {
      "id": 5,
      "start": 3632.0,
      "end": 3636.0,
      "formatted_start": "01:00:32.000",
      "formatted_end": "01:00:36.000",
      "text": "گفت چون شما باید اول می رفتید یا امرال یا سی تیز گرم"
    },
    {
      "id": 6,
      "start": 3636.0,
      "end": 3640.0,
      "formatted_start": "01:00:36.000",
      "formatted_end": "01:00:40.000",
      "text": "گفتن بابا من تو نوبت هم بشه باید از درد بگیرم"
    },
    {
      "id": 7,
      "start": 3640.0,
      "end": 3642.0,
      "formatted_start": "01:00:40.000",
      "formatted_end": "01:00:42.000",
      "text": "نه اصلا نظر علمی هم اینست"
    },
    {
      "id": 8,
      "start": 3642.0,
      "end": 3646.0,
      "formatted_start": "01:00:42.000",
      "formatted_end": "01:00:46.000",
      "text": "مگه تو دنیا تعداد امرالی تهران با کل انگلیس برابره"
    },
    {
      "id": 9,
      "start": 3646.0,
      "end": 3648.0,
      "formatted_start": "01:00:46.000",
      "formatted_end": "01:00:48.000",
      "text": "اینجا الان اتفاقا دیروزم اومد گفت"
    },
    {
      "id": 10,
      "start": 3648.0,
      "end": 3653.0,
      "formatted_start": "01:00:48.000",
      "formatted_end": "01:00:53.000",
      "text": "میدونی گلا تر روی یک بوده شده یک تا رو گفتم شما هنوز همه چه ارسال میگیرید؟"
    },
    {
      "id": 11,
      "start": 3653.0,
      "end": 3656.0,
      "formatted_start": "01:00:53.000",
      "formatted_end": "01:00:56.000",
      "text": "شما یک سرمخوادی که به ادامه کار چرا میگیرون؟"
    },
    {
      "id": 12,
      "start": 3656.0,
      "end": 3665.0,
      "formatted_start": "01:00:56.000",
      "formatted_end": "01:01:05.000",
      "text": "مردم نمیتونند گفتند هنوز شما خیلی... من حقیقتش خودتون میدونیم مقابل مکنم با آرام آیش با آمده با آرام برای چشم"
    },
    {
      "id": 13,
      "start": 3665.0,
      "end": 3674.0,
      "formatted_start": "01:01:05.000",
      "formatted_end": "01:01:14.000",
      "text": "سطح صحابه سلامت نو مردم پایینه انتظار این پیزه شیف سرم مردم خوراکی نداده"
    },
    {
      "id": 14,
      "start": 3674.0,
      "end": 3676.0,
      "formatted_start": "01:01:14.000",
      "formatted_end": "01:01:16.000",
      "text": "این کساش به درد نمیدونه"
    },
    {
      "id": 15,
      "start": 3676.0,
      "end": 3678.0,
      "formatted_start": "01:01:16.000",
      "formatted_end": "01:01:18.000",
      "text": "این یه بابا یادون من خودم بابا بودم"
    },
    {
      "id": 16,
      "start": 3678.0,
      "end": 3680.0,
      "formatted_start": "01:01:18.000",
      "formatted_end": "01:01:20.000",
      "text": "این به درد"
    },
    {
      "id": 17,
      "start": 3680.0,
      "end": 3682.0,
      "formatted_start": "01:01:20.000",
      "formatted_end": "01:01:22.000",
      "text": "بابا من که سوامیست که درد"
    },
    {
      "id": 18,
      "start": 3682.0,
      "end": 3684.0,
      "formatted_start": "01:01:22.000",
      "formatted_end": "01:01:24.000",
      "text": "که خودی توی دیمارسایی آورده"
    },
    {
      "id": 19,
      "start": 3684.0,
      "end": 3686.0,
      "formatted_start": "01:01:24.000",
      "formatted_end": "01:01:26.000",
      "text": "اون زمان به یک تاکرامت بود"
    },
    {
      "id": 20,
      "start": 3686.0,
      "end": 3688.0,
      "formatted_start": "01:01:26.000",
      "formatted_end": "01:01:28.000",
      "text": "رفت توی بلو سر مریض"
    },
    {
      "id": 21,
      "start": 3688.0,
      "end": 3690.0,
      "formatted_start": "01:01:28.000",
      "formatted_end": "01:01:30.000",
      "text": "بعد براش"
    },
    {
      "id": 22,
      "start": 3690.0,
      "end": 3692.0,
      "formatted_start": "01:01:30.000",
      "formatted_end": "01:01:32.000",
      "text": "برنی سه قرنم دارون کردش"
    },
    {
      "id": 23,
      "start": 3692.0,
      "end": 3694.0,
      "formatted_start": "01:01:32.000",
      "formatted_end": "01:01:34.000",
      "text": "برون توی قرونتش"
    },
    {
      "id": 24,
      "start": 3694.0,
      "end": 3696.0,
      "formatted_start": "01:01:34.000",
      "formatted_end": "01:01:36.000",
      "text": "بریم بیرزم به خودو خود"
    },
    {
      "id": 25,
      "start": 3696.0,
      "end": 3698.0,
      "formatted_start": "01:01:36.000",
      "formatted_end": "01:01:38.000",
      "text": "بریم برگشتوشون بریم گرد"
    },
    {
      "id": 26,
      "start": 3698.0,
      "end": 3700.0,
      "formatted_start": "01:01:38.000",
      "formatted_end": "01:01:40.000",
      "text": "گفت چرا اینجوری؟"
    },
    {
      "id": 27,
      "start": 3700.0,
      "end": 3702.0,
      "formatted_start": "01:01:40.000",
      "formatted_end": "01:01:42.000",
      "text": "توی به درد نمیدونه"
    },
    {
      "id": 28,
      "start": 3702.0,
      "end": 3706.0,
      "formatted_start": "01:01:42.000",
      "formatted_end": "01:01:46.000",
      "text": "اینجا همین کورپس های سوره میشه از این مشکل هست و برامون داشت و دوز کرده"
    },
    {
      "id": 29,
      "start": 3706.0,
      "end": 3708.0,
      "formatted_start": "01:01:46.000",
      "formatted_end": "01:01:48.000",
      "text": "آره اون باز خوب هست آره اون باز خوب هست"
    },
    {
      "id": 30,
      "start": 3708.0,
      "end": 3713.0,
      "formatted_start": "01:01:48.000",
      "formatted_end": "01:01:53.000",
      "text": "اینجا الان هر یک نکرد اگه میخواست تو بگیم آرزاو بخوره میرفتیم سیزایی فیرامون"
    },
    {
      "id": 31,
      "start": 3713.0,
      "end": 3716.0,
      "formatted_start": "01:01:53.000",
      "formatted_end": "01:01:56.000",
      "text": "آره همین دیگه بگیرم"
    },
    {
      "id": 32,
      "start": 3716.0,
      "end": 3718.0,
      "formatted_start": "01:01:56.000",
      "formatted_end": "01:01:58.000",
      "text": "آره یعنی همین ترسید خواهده"
    },
    {
      "id": 33,
      "start": 3718.0,
      "end": 3720.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:00.000",
      "text": "ولی چشم حتما"
    },
    {
      "id": 34,
      "start": 3720.0,
      "end": 3722.0,
      "formatted_start": "01:02:00.000",
      "formatted_end": "01:02:02.000",
      "text": "خیلی زحمت بشین"
    },
    {
      "id": 35,
      "start": 3722.0,
      "end": 3726.0,
      "formatted_start": "01:02:02.000",
      "formatted_end": "01:02:06.000",
      "text": "برامت بشین خواهد شدیم که اینکه این واربینش ما باید برسیم"
    },
    {
      "id": 36,
      "start": 3732.0,
      "end": 3734.0,
      "formatted_start": "01:02:12.000",
      "formatted_end": "01:02:14.000",
      "text": "خدا بگم"
    },
    {
      "id": 37,
      "start": 3734.0,
      "end": 3736.0,
      "formatted_start": "01:02:14.000",
      "formatted_end": "01:02:16.000",
      "text": "خدا بگم"
    },
    {
      "id": 38,
      "start": 3736.0,
      "end": 3738.0,
      "formatted_start": "01:02:16.000",
      "formatted_end": "01:02:18.000",
      "text": "یکی دو در این راه افتاد سیستم بخواب"
    },
    {
      "id": 39,
      "start": 3738.0,
      "end": 3740.0,
      "formatted_start": "01:02:18.000",
      "formatted_end": "01:02:20.000",
      "text": "خدا بگم"
    },
    {
      "id": 40,
      "start": 3740.0,
      "end": 3742.0,
      "formatted_start": "01:02:20.000",
      "formatted_end": "01:02:22.000",
      "text": "او اصلا پسپورت شما مانتو ازو بزنید"
    },
    {
      "id": 41,
      "start": 3742.0,
      "end": 3744.0,
      "formatted_start": "01:02:22.000",
      "formatted_end": "01:02:24.000",
      "text": "دوباره همه رو خواب کردید"
    },
    {
      "id": 42,
      "start": 3744.0,
      "end": 3746.0,
      "formatted_start": "01:02:24.000",
      "formatted_end": "01:02:26.000",
      "text": "میدونیم مال که بوده بهت گفتم"
    },
    {
      "id": 43,
      "start": 3746.0,
      "end": 3748.0,
      "formatted_start": "01:02:26.000",
      "formatted_end": "01:02:28.000",
      "text": "چیه؟"
    },
    {
      "id": 44,
      "start": 3748.0,
      "end": 3750.0,
      "formatted_start": "01:02:28.000",
      "formatted_end": "01:02:30.000",
      "text": "چشمه از اون قضیه که اومد ایدی"
    },
    {
      "id": 45,
      "start": 3750.0,
      "end": 3752.0,
      "formatted_start": "01:02:30.000",
      "formatted_end": "01:02:32.000",
      "text": "خواب بگیرم"
    },
    {
      "id": 46,
      "start": 3752.0,
      "end": 3754.0,
      "formatted_start": "01:02:32.000",
      "formatted_end": "01:02:34.000",
      "text": "من ازا خوابتت داریم"
    },
    {
      "id": 47,
      "start": 3754.0,
      "end": 3756.0,
      "formatted_start": "01:02:34.000",
      "formatted_end": "01:02:36.000",
      "text": "من خوابتت دارم"
    },
    {
      "id": 48,
      "start": 3756.0,
      "end": 3758.0,
      "formatted_start": "01:02:36.000",
      "formatted_end": "01:02:38.000",
      "text": "من خود من من یک گوشی داشتم خواب"
    },
    {
      "id": 49,
      "start": 3758.0,
      "end": 3760.0,
      "formatted_start": "01:02:38.000",
      "formatted_end": "01:02:40.000",
      "text": "گوشی افتاد تو زمین شادی کلن کم شد"
    },
    {
      "id": 50,
      "start": 3760.0,
      "end": 3762.0,
      "formatted_start": "01:02:40.000",
      "formatted_end": "01:02:42.000",
      "text": "اون میگه پریت خاندکتون"
    },
    {
      "id": 51,
      "start": 3762.0,
      "end": 3764.0,
      "formatted_start": "01:02:42.000",
      "formatted_end": "01:02:44.000",
      "text": "نه اون دیگه من همه رو جا به جاش کردم"
    },
    {
      "id": 52,
      "start": 3764.0,
      "end": 3766.0,
      "formatted_start": "01:02:44.000",
      "formatted_end": "01:02:46.000",
      "text": "خب من اینجا رو جا به جا موردت می کنیم"
    },
    {
      "id": 53,
      "start": 3766.0,
      "end": 3768.0,
      "formatted_start": "01:02:46.000",
      "formatted_end": "01:02:48.000",
      "text": "برد دیگه کن الان وصل شد خب"
    },
    {
      "id": 54,
      "start": 3768.0,
      "end": 3770.0,
      "formatted_start": "01:02:48.000",
      "formatted_end": "01:02:50.000",
      "text": "الان کنه اینترنت هم وصله"
    },
    {
      "id": 55,
      "start": 3770.0,
      "end": 3772.0,
      "formatted_start": "01:02:50.000",
      "formatted_end": "01:02:52.000",
      "text": "فقط من میخوام اسم وایلس"
    },
    {
      "id": 56,
      "start": 3772.0,
      "end": 3774.0,
      "formatted_start": "01:02:52.000",
      "formatted_end": "01:02:54.000",
      "text": "چون عوض کنم خب"
    },
    {
      "id": 57,
      "start": 3774.0,
      "end": 3776.0,
      "formatted_start": "01:02:54.000",
      "formatted_end": "01:02:56.000",
      "text": "بگه وایلس بذارم"
    },
    {
      "id": 58,
      "start": 3776.0,
      "end": 3778.0,
      "formatted_start": "01:02:56.000",
      "formatted_end": "01:02:58.000",
      "text": "برد یه درخواست هم"
    },
    {
      "id": 59,
      "start": 3778.0,
      "end": 3780.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:00.000",
      "text": "شما وایلس بگیرین"
    },
    {
      "id": 60,
      "start": 3780.0,
      "end": 3782.0,
      "formatted_start": "01:03:00.000",
      "formatted_end": "01:03:02.000",
      "text": "درخواست اصلا"
    },
    {
      "id": 61,
      "start": 3782.0,
      "end": 3784.0,
      "formatted_start": "01:03:02.000",
      "formatted_end": "01:03:04.000",
      "text": "چون بچه ها گفتیم"
    },
    {
      "id": 62,
      "start": 3784.0,
      "end": 3786.0,
      "formatted_start": "01:03:04.000",
      "formatted_end": "01:03:06.000",
      "text": "نه اصلا نزدم اونو از پوتون"
    },
    {
      "id": 63,
      "start": 3786.0,
      "end": 3788.0,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:08.000",
      "text": "بگیرم از کنم"
    },
    {
      "id": 64,
      "start": 3788.0,
      "end": 3792.0,
      "formatted_start": "01:03:08.000",
      "formatted_end": "01:03:12.000",
      "text": "از اینکه من خود دوربین رو بشم و از کنم چند ماه دوربین هم حکم شده و ازش بزنشم"
    },
    {
      "id": 65,
      "start": 3792.0,
      "end": 3793.0,
      "formatted_start": "01:03:12.000",
      "formatted_end": "01:03:13.000",
      "text": "خب؟"
    },
    {
      "id": 66,
      "start": 3793.0,
      "end": 3798.0,
      "formatted_start": "01:03:13.000",
      "formatted_end": "01:03:18.000",
      "text": "مادر میشه که حکم میشه برای همه دیگه، مجبوریم خیلی سکرت بدانه که این رو بزنم"
    },
    {
      "id": 67,
      "start": 3798.0,
      "end": 3801.0,
      "formatted_start": "01:03:18.000",
      "formatted_end": "01:03:21.000",
      "text": "نه ماند، پس اگر اون توی دعا بگیر باشیم"
    },
    {
      "id": 68,
      "start": 3801.0,
      "end": 3807.0,
      "formatted_start": "01:03:21.000",
      "formatted_end": "01:03:27.000",
      "text": "اوه، این سیمه دوربین بعدی که بیارم ببره بیرون از دور کابل شبکه شده داره و از کنه به اون مادر"
    },
    {
      "id": 69,
      "start": 3807.0,
      "end": 3809.0,
      "formatted_start": "01:03:27.000",
      "formatted_end": "01:03:29.000",
      "text": "دوربین سوال از بالا"
    },
    {
      "id": 70,
      "start": 3809.0,
      "end": 3811.0,
      "formatted_start": "01:03:29.000",
      "formatted_end": "01:03:31.000",
      "text": "از اینکه من کورنی بخواد دوربین مرس کردم"
    },
    {
      "id": 71,
      "start": 3811.0,
      "end": 3813.0,
      "formatted_start": "01:03:31.000",
      "formatted_end": "01:03:33.000",
      "text": "چون دوربین اینو به ما جمع میشه"
    },
    {
      "id": 72,
      "start": 3813.0,
      "end": 3815.0,
      "formatted_start": "01:03:33.000",
      "formatted_end": "01:03:35.000",
      "text": "نه نه این اضافه زیاده خب"
    },
    {
      "id": 73,
      "start": 3815.0,
      "end": 3818.0,
      "formatted_start": "01:03:35.000",
      "formatted_end": "01:03:38.000",
      "text": "این اضافه زیاده فقط من الان میخواهم اسمو باشید"
    },
    {
      "id": 74,
      "start": 3818.0,
      "end": 3820.0,
      "formatted_start": "01:03:38.000",
      "formatted_end": "01:03:40.000",
      "text": "یه درخواست هم شما باید بینو سید خب"
    },
    {
      "id": 75,
      "start": 3820.0,
      "end": 3822.0,
      "formatted_start": "01:03:40.000",
      "formatted_end": "01:03:42.000",
      "text": "این جانه"
    },
    {
      "id": 76,
      "start": 3822.0,
      "end": 3824.0,
      "formatted_start": "01:03:42.000",
      "formatted_end": "01:03:44.000",
      "text": "رو همیشه همه سا در پردشت"
    },
    {
      "id": 77,
      "start": 3824.0,
      "end": 3825.0,
      "formatted_start": "01:03:44.000",
      "formatted_end": "01:03:45.000",
      "text": "برن؟"
    },
    {
      "id": 78,
      "start": 3825.0,
      "end": 3827.0,
      "formatted_start": "01:03:45.000",
      "formatted_end": "01:03:47.000",
      "text": "برن برن اینجا بیتر"
    },
    {
      "id": 79,
      "start": 3827.0,
      "end": 3829.0,
      "formatted_start": "01:03:47.000",
      "formatted_end": "01:03:49.000",
      "text": "آه آه آه پرین ترس"
    },
    {
      "id": 80,
      "start": 3829.0,
      "end": 3843.0,
      "formatted_start": "01:03:49.000",
      "formatted_end": "01:04:03.000",
      "text": "این جانب استفاده می‌سوند."
    },
    {
      "id": 81,
      "start": 3843.0,
      "end": 3861.24,
      "formatted_start": "01:04:03.000",
      "formatted_end": "01:04:21.240",
      "text": "در تاریخ 19 1604، یک سیرویز فیبر نوری سبتنام کرده"
    },
    {
      "id": 82,
      "start": 3861.24,
      "end": 3867.76,
      "formatted_start": "01:04:21.240",
      "formatted_end": "01:04:27.760",
      "text": "و در تاریخ 3.6.1605"
    },
    {
      "id": 83,
      "start": 3867.76,
      "end": 3875.2,
      "formatted_start": "01:04:27.760",
      "formatted_end": "01:04:35.200",
      "text": "سرویز تحویل بنده شد"
    },
    {
      "id": 84,
      "start": 3875.2,
      "end": 3877.18,
      "formatted_start": "01:04:35.200",
      "formatted_end": "01:04:37.180",
      "text": "لطفا"
    },
    {
      "id": 85,
      "start": 3877.18,
      "end": 3882.24,
      "formatted_start": "01:04:37.180",
      "formatted_end": "01:04:42.240",
      "text": "لطفا"
    },
    {
      "id": 86,
      "start": 3882.24,
      "end": 3885.76,
      "formatted_start": "01:04:42.240",
      "formatted_end": "01:04:45.760",
      "text": "این زمانی که الان ماندید چی میشه؟"
    },
    {
      "id": 87,
      "start": 3886.72,
      "end": 3887.12,
      "formatted_start": "01:04:46.720",
      "formatted_end": "01:04:47.120",
      "text": "لطفا"
    },
    {
      "id": 88,
      "start": 3887.12,
      "end": 3888.32,
      "formatted_start": "01:04:47.120",
      "formatted_end": "01:04:48.320",
      "text": "درخواست"
    },
    {
      "id": 89,
      "start": 3888.32,
      "end": 3900.0,
      "formatted_start": "01:04:48.320",
      "formatted_end": "01:05:00.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    }
  ],
