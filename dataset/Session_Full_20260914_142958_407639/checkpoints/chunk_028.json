  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8418.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:18.000",
      "text": "اینجا باید بزرگ شدن بگیرم، یک بچه دیگه با این شرایط دیگه به دنیا بیارم، باید بزرگشم بکنم، حالا خودم بیشتر چیزی ندارم."
    },
    {
      "id": 1,
      "start": 8418.0,
      "end": 8426.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:26.000",
      "text": "یعنی خودم نمیدونم با خامیدون بچه دیگه به دنیا بیارم، احساس و کمپرول بچه داشته باشم."
    },
    {
      "id": 2,
      "start": 8426.0,
      "end": 8428.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:28.000",
      "text": "زندگی خیلی زود شروع کرده دیگه"
    },
    {
      "id": 3,
      "start": 8428.0,
      "end": 8430.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:30.000",
      "text": "آه"
    },
    {
      "id": 4,
      "start": 8430.0,
      "end": 8432.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:32.000",
      "text": "ولی شاید خوبه همشو شد به خدا خوبه"
    },
    {
      "id": 5,
      "start": 8432.0,
      "end": 8434.0,
      "formatted_start": "02:20:32.000",
      "formatted_end": "02:20:34.000",
      "text": "آره"
    },
    {
      "id": 6,
      "start": 8434.0,
      "end": 8436.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:36.000",
      "text": "خصاها داری"
    },
    {
      "id": 7,
      "start": 8436.0,
      "end": 8438.0,
      "formatted_start": "02:20:36.000",
      "formatted_end": "02:20:38.000",
      "text": "نه برکور"
    },
    {
      "id": 8,
      "start": 8438.0,
      "end": 8440.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:40.000",
      "text": "یه وقتش داری نداره"
    },
    {
      "id": 9,
      "start": 8440.0,
      "end": 8442.0,
      "formatted_start": "02:20:40.000",
      "formatted_end": "02:20:42.000",
      "text": "زندگی زود شروع کرده خواهد نداره"
    },
    {
      "id": 10,
      "start": 8442.0,
      "end": 8444.0,
      "formatted_start": "02:20:42.000",
      "formatted_end": "02:20:44.000",
      "text": "ولی دیگه بقیهشو بذاری کم بهت خوش بده"
    },
    {
      "id": 11,
      "start": 8444.0,
      "end": 8446.0,
      "formatted_start": "02:20:44.000",
      "formatted_end": "02:20:46.000",
      "text": "چون"
    },
    {
      "id": 12,
      "start": 8446.0,
      "end": 8448.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:48.000",
      "text": "حیف عمرته"
    },
    {
      "id": 13,
      "start": 8448.0,
      "end": 8450.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:50.000",
      "text": "تا مرقب زندگی داره دیگه"
    },
    {
      "id": 14,
      "start": 8450.0,
      "end": 8452.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:52.000",
      "text": "آه امجادتو بسرخوان من تجربه میدم"
    },
    {
      "id": 15,
      "start": 8452.0,
      "end": 8454.0,
      "formatted_start": "02:20:52.000",
      "formatted_end": "02:20:54.000",
      "text": "سختی میشه داره"
    },
    {
      "id": 16,
      "start": 8454.0,
      "end": 8461.0,
      "formatted_start": "02:20:54.000",
      "formatted_end": "02:21:01.000",
      "text": "از این زن به سن مثلا سه ساله ی سی ساله می گیرستم همه چی اون برا باش و اون موقع عشق دنیا رو اون موقع خواهان کنم"
    },
    {
      "id": 17,
      "start": 8461.0,
      "end": 8463.0,
      "formatted_start": "02:21:01.000",
      "formatted_end": "02:21:03.000",
      "text": "آه انشاءالله"
    },
    {
      "id": 18,
      "start": 8463.0,
      "end": 8466.0,
      "formatted_start": "02:21:03.000",
      "formatted_end": "02:21:06.000",
      "text": "دیگه توقم خورده عذیب نکنی باشه"
    },
    {
      "id": 19,
      "start": 8466.0,
      "end": 8472.0,
      "formatted_start": "02:21:06.000",
      "formatted_end": "02:21:12.000",
      "text": "کارسیومیتو اینا هم خوبه خوب یعنی بشتر درداد آزمایشات کلن خوبه"
    },
    {
      "id": 20,
      "start": 8472.0,
      "end": 8475.0,
      "formatted_start": "02:21:12.000",
      "formatted_end": "02:21:15.000",
      "text": "حالا من فقط ویتامیتیتو ها همتون اینا رو گذردم برات خوب؟"
    },
    {
      "id": 21,
      "start": 8475.0,
      "end": 8476.0,
      "formatted_start": "02:21:15.000",
      "formatted_end": "02:21:16.000",
      "text": "ها"
    },
    {
      "id": 22,
      "start": 8476.0,
      "end": 8479.0,
      "formatted_start": "02:21:16.000",
      "formatted_end": "02:21:19.000",
      "text": "باید یکم شبه خوب میخوابی یا نه؟"
    },
    {
      "id": 23,
      "start": 8479.0,
      "end": 8480.0,
      "formatted_start": "02:21:19.000",
      "formatted_end": "02:21:20.000",
      "text": "آه آه خوابی باشم"
    },
    {
      "id": 24,
      "start": 8480.0,
      "end": 8481.5,
      "formatted_start": "02:21:20.000",
      "formatted_end": "02:21:21.500",
      "text": "خواه و بعد نمیبینی؟"
    },
    {
      "id": 25,
      "start": 8481.5,
      "end": 8482.0,
      "formatted_start": "02:21:21.500",
      "formatted_end": "02:21:22.000",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 8482.0,
      "end": 8484.0,
      "formatted_start": "02:21:22.000",
      "formatted_end": "02:21:24.000",
      "text": "گریه زیاد نمی کنی؟"
    },
    {
      "id": 27,
      "start": 8484.0,
      "end": 8486.0,
      "formatted_start": "02:21:24.000",
      "formatted_end": "02:21:26.000",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 8486.0,
      "end": 8488.0,
      "formatted_start": "02:21:26.000",
      "formatted_end": "02:21:28.000",
      "text": "خواه و بعدی از اینکه من رو گریه کردم"
    },
    {
      "id": 29,
      "start": 8488.0,
      "end": 8493.0,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:33.000",
      "text": "اون روح و اون شجاعتی که در خودم دارم"
    },
    {
      "id": 30,
      "start": 8493.0,
      "end": 8494.0,
      "formatted_start": "02:21:33.000",
      "formatted_end": "02:21:34.000",
      "text": "اون روح باید میره"
    },
    {
      "id": 31,
      "start": 8494.0,
      "end": 8497.0,
      "formatted_start": "02:21:34.000",
      "formatted_end": "02:21:37.000",
      "text": "سر می کنم تا اون رو جا خدا من نگرده بکنم"
    },
    {
      "id": 32,
      "start": 8497.0,
      "end": 8498.0,
      "formatted_start": "02:21:37.000",
      "formatted_end": "02:21:38.000",
      "text": "تا اون جایی که من رو برم"
    },
    {
      "id": 33,
      "start": 8498.0,
      "end": 8501.0,
      "formatted_start": "02:21:38.000",
      "formatted_end": "02:21:41.000",
      "text": "پس این حس گریه داری ولی جلوی گریهتون اینجایی؟"
    },
    {
      "id": 34,
      "start": 8501.0,
      "end": 8504.0,
      "formatted_start": "02:21:41.000",
      "formatted_end": "02:21:44.000",
      "text": "آره زمانی که واقعا از دست بچه ها گریه"
    },
    {
      "id": 35,
      "start": 8504.0,
      "end": 8506.0,
      "formatted_start": "02:21:44.000",
      "formatted_end": "02:21:46.000",
      "text": "مثلا سختی زندگی گریه نمی کنه"
    },
    {
      "id": 36,
      "start": 8506.0,
      "end": 8514.0,
      "formatted_start": "02:21:46.000",
      "formatted_end": "02:21:54.000",
      "text": "اگر یکی که حرفی به هم بگه یا مشکلاتی درش دارد یا یک سلسله که بابد جنگ اختشاشات و این چیزها شده بود"
    },
    {
      "id": 37,
      "start": 8514.0,
      "end": 8523.0,
      "formatted_start": "02:21:54.000",
      "formatted_end": "02:22:03.000",
      "text": "مثلا دو چرک تلش هایی که شده بیدم سر می کردم گریه نکنم. هم یا همین فرق جاری همه داشتن گریه می کردم و من سر می کردم خود من رو کنترل کنم."
    },
    {
      "id": 38,
      "start": 8523.0,
      "end": 8529.0,
      "formatted_start": "02:22:03.000",
      "formatted_end": "02:22:09.000",
      "text": "مثلا ندارم گریه هم در بده. حس می کردم با گریه کردن همتون رو به بچه ها تحصیل می زنم"
    },
    {
      "id": 39,
      "start": 8529.0,
      "end": 8532.44,
      "formatted_start": "02:22:09.000",
      "formatted_end": "02:22:12.440",
      "text": "چون طول خانواده در حال قهر نوعتی بودند و اینها"
    },
    {
      "id": 40,
      "start": 8532.44,
      "end": 8535.56,
      "formatted_start": "02:22:12.440",
      "formatted_end": "02:22:15.560",
      "text": "بعد همه داشتن مثلا ماه جوادش برگیر نگاه میکرد"
    },
    {
      "id": 41,
      "start": 8535.56,
      "end": 8537.56,
      "formatted_start": "02:22:15.560",
      "formatted_end": "02:22:17.560",
      "text": "چون درخواد خانواده ما بود دیگه"
    },
    {
      "id": 42,
      "start": 8537.56,
      "end": 8540.36,
      "formatted_start": "02:22:17.560",
      "formatted_end": "02:22:20.360",
      "text": "مثلا با شما نوعتی میکرد، برای شما هم نوعتی میکرد"
    },
    {
      "id": 43,
      "start": 8540.36,
      "end": 8541.88,
      "formatted_start": "02:22:20.360",
      "formatted_end": "02:22:21.880",
      "text": "آره چاهرش اینها"
    },
    {
      "id": 44,
      "start": 8541.88,
      "end": 8544.12,
      "formatted_start": "02:22:21.880",
      "formatted_end": "02:22:24.120",
      "text": "بعد مثلا اینکه هم خودمون رو جوری نگهر دار کنم"
    },
    {
      "id": 45,
      "start": 8544.12,
      "end": 8547.08,
      "formatted_start": "02:22:24.120",
      "formatted_end": "02:22:27.080",
      "text": "که این بچه هدف و روحی من کش آسیب نداریم"
    },
    {
      "id": 46,
      "start": 8547.08,
      "end": 8552.66,
      "formatted_start": "02:22:27.080",
      "formatted_end": "02:22:32.660",
      "text": "چون احساسات خیلی فراغان موجود میشه تا بعد"
    },
    {
      "id": 47,
      "start": 8552.66,
      "end": 8554.66,
      "formatted_start": "02:22:32.660",
      "formatted_end": "02:22:34.660",
      "text": "بسر خود همچنین احساساتی نداره"
    },
    {
      "id": 48,
      "start": 8554.66,
      "end": 8558.9,
      "formatted_start": "02:22:34.660",
      "formatted_end": "02:22:38.900",
      "text": "اما اون سنه کمش بشه خاطرات توی زنی سرکارنه"
    },
    {
      "id": 49,
      "start": 8558.9,
      "end": 8562.3,
      "formatted_start": "02:22:38.900",
      "formatted_end": "02:22:42.300",
      "text": "مثلا از گذشتهش دو سال و هفت ماهشون مورده"
    },
    {
      "id": 50,
      "start": 8562.3,
      "end": 8564.3,
      "formatted_start": "02:22:42.300",
      "formatted_end": "02:22:44.300",
      "text": "خاطرات مادرش اصلا بازگونه کنه"
    },
    {
      "id": 51,
      "start": 8564.3,
      "end": 8567.04,
      "formatted_start": "02:22:44.300",
      "formatted_end": "02:22:47.040",
      "text": "میگه فلانجا رفتیم و فلانکار کردیم"
    },
    {
      "id": 52,
      "start": 8567.04,
      "end": 8569.2,
      "formatted_start": "02:22:47.040",
      "formatted_end": "02:22:49.200",
      "text": "ببین آره خب تو این خیلی خوبه"
    },
    {
      "id": 53,
      "start": 8569.2,
      "end": 8573.24,
      "formatted_start": "02:22:49.200",
      "formatted_end": "02:22:53.240",
      "text": "ولی یه تایمی بعد برای خلوت خودت داشته باشی"
    },
    {
      "id": 54,
      "start": 8573.24,
      "end": 8574.6,
      "formatted_start": "02:22:53.240",
      "formatted_end": "02:22:54.600",
      "text": "اگر من اینو از باشم"
    },
    {
      "id": 55,
      "start": 8574.6,
      "end": 8583.6,
      "formatted_start": "02:22:54.600",
      "formatted_end": "02:23:03.600",
      "text": "چون تایب اون بچه رسیده بود. بچه های خودم. منم. بچه های خودم. اینو میخوابونم اون یکی دیگه بیدار میشه. اونو اینکار میفردن اون یکی دیگه گریش داره."
    },
    {
      "id": 56,
      "start": 8583.6,
      "end": 8586.6,
      "formatted_start": "02:23:03.600",
      "formatted_end": "02:23:06.600",
      "text": "اینجوری دابان میشه چون این گریه ها همه از اینجوری سرده میکنه."
    },
    {
      "id": 57,
      "start": 8586.6,
      "end": 8587.6,
      "formatted_start": "02:23:06.600",
      "formatted_end": "02:23:07.600",
      "text": "بله."
    },
    {
      "id": 58,
      "start": 8589.6,
      "end": 8591.6,
      "formatted_start": "02:23:09.600",
      "formatted_end": "02:23:11.600",
      "text": "چه شد؟ بسیار درست کرد؟"
    },
    {
      "id": 59,
      "start": 8591.6,
      "end": 8597.6,
      "formatted_start": "02:23:11.600",
      "formatted_end": "02:23:17.600",
      "text": "گفتم من که میستم میرد بکنه تو برم ندارم به سیرد بکنم و برم ندارم بکنم."
    },
    {
      "id": 60,
      "start": 8597.6,
      "end": 8601.6,
      "formatted_start": "02:23:17.600",
      "formatted_end": "02:23:21.600",
      "text": "این سومه ارنسی جناب پرستادیم"
    },
    {
      "id": 61,
      "start": 8601.6,
      "end": 8607.6,
      "formatted_start": "02:23:21.600",
      "formatted_end": "02:23:27.600",
      "text": "این هم یه سومه هایی که گفتیم که خواهی باشیم رو به نگه بخونیم"
    },
    {
      "id": 62,
      "start": 8607.6,
      "end": 8611.6,
      "formatted_start": "02:23:27.600",
      "formatted_end": "02:23:31.600",
      "text": "ارنسی هم خواهی بیشتر هست"
    },
    {
      "id": 63,
      "start": 8611.6,
      "end": 8617.6,
      "formatted_start": "02:23:31.600",
      "formatted_end": "02:23:37.600",
      "text": "همه چیز کنیم؟ برخواهم برنشیم"
    },
    {
      "id": 64,
      "start": 8617.6,
      "end": 8621.6,
      "formatted_start": "02:23:37.600",
      "formatted_end": "02:23:41.600",
      "text": "همه چیز کنیم؟ برنشی بیتامین داریم بهش"
    },
    {
      "id": 65,
      "start": 8621.6,
      "end": 8625.6,
      "formatted_start": "02:23:41.600",
      "formatted_end": "02:23:45.600",
      "text": "برنشی؟ آجانی داریم باشیم"
    },
    {
      "id": 66,
      "start": 8625.6,
      "end": 8627.6,
      "formatted_start": "02:23:45.600",
      "formatted_end": "02:23:47.600",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 67,
      "start": 8627.6,
      "end": 8629.6,
      "formatted_start": "02:23:47.600",
      "formatted_end": "02:23:49.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 68,
      "start": 8629.6,
      "end": 8631.6,
      "formatted_start": "02:23:49.600",
      "formatted_end": "02:23:51.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 69,
      "start": 8631.6,
      "end": 8633.6,
      "formatted_start": "02:23:51.600",
      "formatted_end": "02:23:53.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 70,
      "start": 8633.6,
      "end": 8635.6,
      "formatted_start": "02:23:53.600",
      "formatted_end": "02:23:55.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 71,
      "start": 8635.6,
      "end": 8637.6,
      "formatted_start": "02:23:55.600",
      "formatted_end": "02:23:57.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 72,
      "start": 8637.6,
      "end": 8639.6,
      "formatted_start": "02:23:57.600",
      "formatted_end": "02:23:59.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 73,
      "start": 8639.6,
      "end": 8641.6,
      "formatted_start": "02:23:59.600",
      "formatted_end": "02:24:01.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 74,
      "start": 8641.6,
      "end": 8643.6,
      "formatted_start": "02:24:01.600",
      "formatted_end": "02:24:03.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 75,
      "start": 8643.6,
      "end": 8645.6,
      "formatted_start": "02:24:03.600",
      "formatted_end": "02:24:05.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 76,
      "start": 8645.6,
      "end": 8647.6,
      "formatted_start": "02:24:05.600",
      "formatted_end": "02:24:07.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 77,
      "start": 8647.6,
      "end": 8649.6,
      "formatted_start": "02:24:07.600",
      "formatted_end": "02:24:09.600",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 78,
      "start": 8649.6,
      "end": 8652.6,
      "formatted_start": "02:24:09.600",
      "formatted_end": "02:24:12.600",
      "text": "این کفیت زیاد دیدار میشه یا نه؟"
    },
    {
      "id": 79,
      "start": 8652.6,
      "end": 8656.6,
      "formatted_start": "02:24:12.600",
      "formatted_end": "02:24:16.600",
      "text": "نه، بچه همه هر یک را تا سه یک کنیم میخواهد، سه هفته صبح بلند میشه"
    },
    {
      "id": 80,
      "start": 8656.6,
      "end": 8659.6,
      "formatted_start": "02:24:16.600",
      "formatted_end": "02:24:19.600",
      "text": "واسه تایم شیرش، هر یک کنیم تا هفته را هر میخواهد"
    },
    {
      "id": 81,
      "start": 8659.6,
      "end": 8663.6,
      "formatted_start": "02:24:19.600",
      "formatted_end": "02:24:23.600",
      "text": "کفیت خواهد اصلا خوب نست، نباید قصد نشید"
    },
    {
      "id": 82,
      "start": 8663.6,
      "end": 8664.6,
      "formatted_start": "02:24:23.600",
      "formatted_end": "02:24:24.600",
      "text": "نیست"
    },
    {
      "id": 83,
      "start": 8664.6,
      "end": 8668.6,
      "formatted_start": "02:24:24.600",
      "formatted_end": "02:24:28.600",
      "text": "یه سری تغییراتی نوشتم، من یزی و مونه را شب بخوری خوب جشانه"
    },
    {
      "id": 84,
      "start": 8668.6,
      "end": 8675.6,
      "formatted_start": "02:24:28.600",
      "formatted_end": "02:24:35.600",
      "text": "یکم کلیفیت خواهد تو بالا بره به دوازن رو دادم آهن و اینا ها یکم بیتامین دی و از این حالا"
    },
    {
      "id": 85,
      "start": 8675.6,
      "end": 8678.6,
      "formatted_start": "02:24:35.600",
      "formatted_end": "02:24:38.600",
      "text": "یک انرژی فیکس نوشتم صبح و بعد از صبحانه بخور"
    },
    {
      "id": 86,
      "start": 8678.6,
      "end": 8682.6,
      "formatted_start": "02:24:38.600",
      "formatted_end": "02:24:42.600",
      "text": "اگر بهتر نشدی بعد خواب بی اختلاف تو خواب داری"
    },
    {
      "id": 87,
      "start": 8682.6,
      "end": 8685.6,
      "formatted_start": "02:24:42.600",
      "formatted_end": "02:24:45.600",
      "text": "آره برای همینش صبح هست بیدی"
    },
    {
      "id": 88,
      "start": 8685.6,
      "end": 8689.6,
      "formatted_start": "02:24:45.600",
      "formatted_end": "02:24:49.600",
      "text": "چون وقتی که صبح بیدار میشه خستی یعنی اختلاف خواب داری"
    },
    {
      "id": 89,
      "start": 8689.6,
      "end": 8691.6,
      "formatted_start": "02:24:49.600",
      "formatted_end": "02:24:51.600",
      "text": "یعنی خوابت با کفیت شد"
    },
    {
      "id": 90,
      "start": 8691.6,
      "end": 8695.6,
      "formatted_start": "02:24:51.600",
      "formatted_end": "02:24:55.600",
      "text": "شاید در خواب درگیری و اگه مثلا خودتو یادت نمیاد"
    },
    {
      "id": 91,
      "start": 8695.6,
      "end": 8697.6,
      "formatted_start": "02:24:55.600",
      "formatted_end": "02:24:57.600",
      "text": "فتح مانداره این باشه"
    },
    {
      "id": 92,
      "start": 8697.6,
      "end": 8699.6,
      "formatted_start": "02:24:57.600",
      "formatted_end": "02:24:59.600",
      "text": "طاراتو بخور اگر خون نشدی"
    }
  ],
  "status": "completed"
}