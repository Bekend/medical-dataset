      "start": 5724.0,
      "end": 5726.0,
      "formatted_start": "01:35:24.000",
      "formatted_end": "01:35:26.000",
      "text": "از این تاکه هایی هست؟"
    },
    {
      "id": 13,
      "start": 5726.0,
      "end": 5728.82,
      "formatted_start": "01:35:26.000",
      "formatted_end": "01:35:28.820",
      "text": "باز باطرش شد یه زنگ بزنیم بگیم براتون میدونم"
    },
    {
      "id": 14,
      "start": 5728.82,
      "end": 5730.02,
      "formatted_start": "01:35:28.820",
      "formatted_end": "01:35:30.020",
      "text": "این تا که هست؟"
