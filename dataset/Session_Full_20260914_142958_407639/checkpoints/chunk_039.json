      "id": 68,
      "start": 11889.9,
      "end": 11892.9,
      "formatted_start": "03:18:09.900",
      "formatted_end": "03:18:12.900",
      "text": "خب علکه که نگفتم اون حتما یه چیز دیگه بود"
    },
