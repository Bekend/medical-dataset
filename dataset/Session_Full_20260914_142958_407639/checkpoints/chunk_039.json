      "start": 11880.9,
      "end": 11882.9,
      "formatted_start": "03:18:00.900",
      "formatted_end": "03:18:02.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 66,
      "start": 11882.9,
      "end": 11886.9,
      "formatted_start": "03:18:02.900",
      "formatted_end": "03:18:06.900",
      "text": "خب من حتما میخواستم عوض کنم داروش را"
    },
    {
      "id": 67,
      "start": 11886.9,
      "end": 11889.9,
      "formatted_start": "03:18:06.900",
      "formatted_end": "03:18:09.900",
      "text": "نمیدونم که گفتی که رو بیرون میگیرن ساتر"
    },
