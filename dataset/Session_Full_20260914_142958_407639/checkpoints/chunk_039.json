      "start": 11779.0,
      "end": 11781.0,
      "formatted_start": "03:16:19.000",
      "formatted_end": "03:16:21.000",
      "text": "برم تروپ تروپ چه سایی هاشم"
    },
    {
      "id": 21,
      "start": 11781.0,
      "end": 11783.0,
      "formatted_start": "03:16:21.000",
      "formatted_end": "03:16:23.000",
      "text": "هم نبود نفره"
    },
    {
      "id": 22,
      "start": 11783.0,
      "end": 11785.0,
      "formatted_start": "03:16:23.000",
      "formatted_end": "03:16:25.000",
      "text": "سنغست برم"
    },
    {
      "id": 23,
      "start": 11785.0,
      "end": 11787.0,
      "formatted_start": "03:16:25.000",
      "formatted_end": "03:16:27.000",
      "text": "بعد حتما دو هفته دیگه"
    },
    {
      "id": 24,
      "start": 11787.0,
      "end": 11792.0,
      "formatted_start": "03:16:27.000",
      "formatted_end": "03:16:32.000",
      "text": "نمیشتم برای تو این کود رو برم نکن دو هفته دیگه حتما باید آزما شده رو دارم"
    },
    {
      "id": 25,
      "start": 11792.0,
      "end": 11793.0,
      "formatted_start": "03:16:32.000",
      "formatted_end": "03:16:33.000",
      "text": "کجا برم؟"
    },
    {
      "id": 26,
      "start": 11793.0,
      "end": 11794.0,
      "formatted_start": "03:16:33.000",
      "formatted_end": "03:16:34.000",
      "text": "هر جا رفتیم"
    },
    {
      "id": 27,
      "start": 11794.0,
      "end": 11797.0,
      "formatted_start": "03:16:34.000",
      "formatted_end": "03:16:37.000",
      "text": "اینو باز این دفعه برو بحاری"
    },
    {
      "id": 28,
      "start": 11797.0,
      "end": 11798.0,
      "formatted_start": "03:16:37.000",
      "formatted_end": "03:16:38.000",
      "text": "سپید برم؟"
    },
    {
      "id": 29,
      "start": 11798.0,
      "end": 11800.0,
      "formatted_start": "03:16:38.000",
      "formatted_end": "03:16:40.000",
      "text": "سپید که رفته بودی سریقا"
    },
    {
      "id": 30,
      "start": 11800.0,
      "end": 11801.0,
      "formatted_start": "03:16:40.000",
      "formatted_end": "03:16:41.000",
      "text": "رفتی بگیر سپید"
    },
    {
      "id": 31,
      "start": 11801.0,
      "end": 11802.0,
      "formatted_start": "03:16:41.000",
      "formatted_end": "03:16:42.000",
      "text": "سپید رفتم"
    },
    {
      "id": 32,
      "start": 11802.0,
      "end": 11804.0,
      "formatted_start": "03:16:42.000",
      "formatted_end": "03:16:44.000",
      "text": "این دفعه باز ادرارتو برو بحاری"
    },
    {
      "id": 33,
      "start": 11804.0,
      "end": 11807.0,
      "formatted_start": "03:16:44.000",
      "formatted_end": "03:16:47.000",
      "text": "ادرارتو الان نه دو هفته دیگه"
    },
    {
      "id": 34,
      "start": 11807.0,
      "end": 11810.0,
      "formatted_start": "03:16:47.000",
      "formatted_end": "03:16:50.000",
      "text": "با همین کود دو هفته دیگه به طاقه پایین انجامه"
    },
    {
      "id": 35,
      "start": 11810.0,
      "end": 11813.56,
      "formatted_start": "03:16:50.000",
      "formatted_end": "03:16:53.560",
      "text": "از من که برم؟ همه پردیست؟"
    },
    {
      "id": 36,
      "start": 11813.56,
      "end": 11815.34,
      "formatted_start": "03:16:53.560",
      "formatted_end": "03:16:55.340",
      "text": "الان برو فردا صبح ناشتا"
    },
    {
      "id": 37,
      "start": 11815.34,
      "end": 11816.58,
      "formatted_start": "03:16:55.340",
      "formatted_end": "03:16:56.580",
      "text": "فردا صبح ناشتا؟"
    },
    {
      "id": 38,
      "start": 11816.58,
      "end": 11818.96,
      "formatted_start": "03:16:56.580",
      "formatted_end": "03:16:58.960",
      "text": "که بیم شبابست؟"
    },
    {
      "id": 39,
      "start": 11818.96,
      "end": 11820.06,
      "formatted_start": "03:16:58.960",
      "formatted_end": "03:17:00.060",
      "text": "جوابشو بگیر بیم"
    },
    {
      "id": 40,
      "start": 11820.06,
      "end": 11821.78,
      "formatted_start": "03:17:00.060",
      "formatted_end": "03:17:01.780",
      "text": "ادران را رفتن؟"
    },
    {
      "id": 41,
      "start": 11821.78,
      "end": 11823.1,
      "formatted_start": "03:17:01.780",
      "formatted_end": "03:17:03.100",
      "text": "ادران باید دو هفته دیگه است"
    },
    {
      "id": 42,
      "start": 11823.1,
      "end": 11824.7,
      "formatted_start": "03:17:03.100",
      "formatted_end": "03:17:04.700",
      "text": "فیلن الان موضوع تیرویلته"
    },
    {
      "id": 43,
      "start": 11824.7,
      "end": 11826.68,
      "formatted_start": "03:17:04.700",
      "formatted_end": "03:17:06.680",
      "text": "فقط بهت بگیم قرص بخوری یا نخوری"
    },
    {
      "id": 44,
      "start": 11826.68,
      "end": 11830.36,
      "formatted_start": "03:17:06.680",
      "formatted_end": "03:17:10.360",
      "text": "اون دو هفته دیگه قرصتن بگیری از دارو خونه خب؟"
    },
    {
      "id": 45,
      "start": 11830.36,
      "end": 11831.6,
      "formatted_start": "03:17:10.360",
      "formatted_end": "03:17:11.600",
      "text": "الان برم قرصتن بگیریم"
    },
    {
      "id": 46,
      "start": 11831.6,
      "end": 11832.9,
      "formatted_start": "03:17:11.600",
      "formatted_end": "03:17:12.900",
      "text": "هم قرص داریم هم آره"
    },
    {
      "id": 47,
      "start": 11832.9,
      "end": 11842.9,
      "formatted_start": "03:17:12.900",
      "formatted_end": "03:17:22.900",
      "text": "خانه آرزو که بچه های دارو خونه است رفته بیشتر دکتر آرش ریاض نجرو جانومیکس می کند"
    },
    {
      "id": 48,
      "start": 11842.9,
      "end": 11847.9,
      "formatted_start": "03:17:22.900",
      "formatted_end": "03:17:27.900",
      "text": "اندش همو بالا بهش نمی سند و نامه بهش داده ارجاز می کند"
    },
    {
      "id": 49,
      "start": 11847.9,
      "end": 11851.9,
      "formatted_start": "03:17:27.900",
      "formatted_end": "03:17:31.900",
      "text": "می آمد که می خواستم براش اطراف بگیرم من بیرون مریب برنم"
    },
    {
      "id": 50,
      "start": 11851.9,
      "end": 11853.9,
      "formatted_start": "03:17:31.900",
      "formatted_end": "03:17:33.900",
      "text": "من می گوشم ازش می گیرم"
    },
    {
      "id": 51,
      "start": 11853.9,
      "end": 11856.9,
      "formatted_start": "03:17:33.900",
      "formatted_end": "03:17:36.900",
      "text": "برام این یک دفعه شرمند که اومد سوان شد"
    },
    {
      "id": 52,
      "start": 11856.9,
      "end": 11857.9,
      "formatted_start": "03:17:36.900",
      "formatted_end": "03:17:37.900",
      "text": "پس پردا که جوا آزماش شد"
    },
    {
      "id": 53,
      "start": 11857.9,
      "end": 11858.9,
      "formatted_start": "03:17:37.900",
      "formatted_end": "03:17:38.900",
      "text": "جوا آگرد براش آزماشه"
    },
    {
      "id": 54,
      "start": 11858.9,
      "end": 11860.9,
      "formatted_start": "03:17:38.900",
      "formatted_end": "03:17:40.900",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 55,
      "start": 11860.9,
      "end": 11862.9,
      "formatted_start": "03:17:40.900",
      "formatted_end": "03:17:42.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 56,
      "start": 11862.9,
      "end": 11864.9,
      "formatted_start": "03:17:42.900",
      "formatted_end": "03:17:44.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 57,
      "start": 11864.9,
      "end": 11866.9,
      "formatted_start": "03:17:44.900",
      "formatted_end": "03:17:46.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 58,
      "start": 11866.9,
      "end": 11868.9,
      "formatted_start": "03:17:46.900",
      "formatted_end": "03:17:48.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 59,
      "start": 11868.9,
      "end": 11870.9,
      "formatted_start": "03:17:48.900",
      "formatted_end": "03:17:50.900",
      "text": "در اینجا باید برداریم"
    },
    {
