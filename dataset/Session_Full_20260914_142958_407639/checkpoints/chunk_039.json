    },
    {
      "id": 1,
      "start": 11730.0,
      "end": 11732.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:32.000",
      "text": "کل بار گیریم بشونشون بدم"
    },
    {
      "id": 2,
      "start": 11732.0,
      "end": 11734.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:34.000",
      "text": "بدم بدم"
    },
    {
      "id": 3,
      "start": 11738.0,
      "end": 11740.0,
      "formatted_start": "03:15:38.000",
      "formatted_end": "03:15:40.000",
      "text": "اینو بازی کل بار گیریم"
    },
    {
      "id": 4,
      "start": 11743.0,
      "end": 11745.0,
      "formatted_start": "03:15:43.000",
      "formatted_end": "03:15:45.000",
      "text": "شاید یک کل برات"
    },
    {
      "id": 5,
      "start": 11745.0,
      "end": 11747.0,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:47.000",
      "text": "همین ساره"
    },
    {
      "id": 6,
      "start": 11750.0,
      "end": 11752.0,
      "formatted_start": "03:15:50.000",
      "formatted_end": "03:15:52.000",
      "text": "چند تا انتها داده بودی؟"
    },
    {
      "id": 7,
      "start": 11752.0,
      "end": 11754.0,
      "formatted_start": "03:15:52.000",
      "formatted_end": "03:15:54.000",
      "text": "سه تا"
    },
    {
      "id": 8,
      "start": 11755.0,
      "end": 11757.0,
      "formatted_start": "03:15:55.000",
      "formatted_end": "03:15:57.000",
      "text": "شاید چند سال به شاید؟"
    },
    {
      "id": 9,
      "start": 11757.0,
      "end": 11759.0,
      "formatted_start": "03:15:57.000",
      "formatted_end": "03:15:59.000",
      "text": "شهست"
    },
    {
      "id": 10,
      "start": 11759.0,
      "end": 11761.0,
      "formatted_start": "03:15:59.000",
      "formatted_end": "03:16:01.000",
      "text": "اینجا آمده شوند از اینجا"
    },
    {
      "id": 11,
      "start": 11761.0,
      "end": 11763.0,
      "formatted_start": "03:16:01.000",
      "formatted_end": "03:16:03.000",
      "text": "این قرن شوند از اینجا"
    },
    {
      "id": 12,
      "start": 11763.0,
      "end": 11765.0,
      "formatted_start": "03:16:03.000",
      "formatted_end": "03:16:05.000",
      "text": "آه قرن"
    },
    {
      "id": 13,
      "start": 11765.0,
      "end": 11767.0,
      "formatted_start": "03:16:05.000",
      "formatted_end": "03:16:07.000",
      "text": "خب خدا رو بشو"
    },
    {
      "id": 14,
      "start": 11767.0,
      "end": 11769.0,
      "formatted_start": "03:16:07.000",
      "formatted_end": "03:16:09.000",
      "text": "آزمانشو تو دیو"
    },
    {
      "id": 15,
      "start": 11769.0,
      "end": 11771.0,
      "formatted_start": "03:16:09.000",
      "formatted_end": "03:16:11.000",
      "text": "برای من ناشته ببینیم چی کار کنی"
    },
    {
      "id": 16,
      "start": 11771.0,
      "end": 11773.0,
      "formatted_start": "03:16:11.000",
      "formatted_end": "03:16:13.000",
      "text": "باشه"
    },
    {
      "id": 17,
      "start": 11773.0,
      "end": 11775.0,
      "formatted_start": "03:16:13.000",
      "formatted_end": "03:16:15.000",
      "text": "سوتر آورده بیده بچه رو"
    },
    {
      "id": 18,
      "start": 11775.0,
      "end": 11777.0,
      "formatted_start": "03:16:15.000",
      "formatted_end": "03:16:17.000",
      "text": "ناشته آزمایش برم؟ آره"
