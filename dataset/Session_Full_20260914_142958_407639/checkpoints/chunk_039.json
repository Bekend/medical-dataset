      "start": 11940.9,
      "end": 11956.42,
      "formatted_start": "03:19:00.900",
      "formatted_end": "03:19:16.420",
      "text": "این رندم دکتر پرستاد پیش شما"
    },
    {
      "id": 77,
      "start": 11956.42,
      "end": 11960.52,
      "formatted_start": "03:19:16.420",
      "formatted_end": "03:19:20.520",
      "text": "بخاطر که رندم بالاه"
    },
    {
      "id": 78,
      "start": 11960.52,
      "end": 11968.02,
      "formatted_start": "03:19:20.520",
      "formatted_end": "03:19:28.020",
      "text": "ورد تریوتم میخورد"
    },
    {
      "id": 79,
      "start": 11968.02,
      "end": 11973.02,
      "formatted_start": "03:19:28.020",
      "formatted_end": "03:19:33.020",
      "text": "امروز داشتم. اول نرز دارم برای یک باجم دارم."
    },
    {
      "id": 80,
      "start": 11973.02,
      "end": 11978.02,
      "formatted_start": "03:19:33.020",
      "formatted_end": "03:19:38.020",
      "text": "غرص تیروید دارم برای مثلا این چروی منه."
    },
    {
      "id": 81,
      "start": 11978.02,
      "end": 11980.02,
      "formatted_start": "03:19:38.020",
      "formatted_end": "03:19:40.020",
      "text": "بله."
    },
    {
      "id": 82,
      "start": 11980.02,
      "end": 11983.02,
      "formatted_start": "03:19:40.020",
      "formatted_end": "03:19:43.020",
      "text": "دستگاه چه که خواهیم داری مادر؟"
    },
    {
      "id": 83,
      "start": 11983.02,
      "end": 11986.02,
      "formatted_start": "03:19:43.020",
      "formatted_end": "03:19:46.020",
      "text": "نه."
    },
    {
      "id": 84,
      "start": 11986.02,
      "end": 11990.02,
      "formatted_start": "03:19:46.020",
      "formatted_end": "03:19:50.020",
      "text": "خب این تیرویدت که تنظیم میست از که غرص بردارن؟"
    },
    {
      "id": 85,
      "start": 11990.02,
      "end": 11994.02,
      "formatted_start": "03:19:50.020",
      "formatted_end": "03:19:54.020",
      "text": "غرص الان چند ساله میخورم."
    },
    {
      "id": 86,
      "start": 11994.02,
      "end": 11996.02,
      "formatted_start": "03:19:54.020",
      "formatted_end": "03:19:56.020",
      "text": "ناشتایش رو یک ساعت نگه میداری؟"
    },
    {
      "id": 87,
      "start": 11996.02,
      "end": 12000.02,
      "formatted_start": "03:19:56.020",
      "formatted_end": "03:20:00.020",
