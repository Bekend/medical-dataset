      "start": 11892.9,
      "end": 11893.9,
      "formatted_start": "03:18:12.900",
      "formatted_end": "03:18:13.900",
      "text": "حتما قرنش بالا بود"
    },
    {
      "id": 70,
      "start": 11893.9,
      "end": 11896.9,
      "formatted_start": "03:18:13.900",
      "formatted_end": "03:18:16.900",
      "text": "قرنش بالا بودم میخواستم داروش را عوض کنم"
    },
    {
      "id": 71,
      "start": 11896.9,
      "end": 11898.9,
      "formatted_start": "03:18:16.900",
      "formatted_end": "03:18:18.900",
      "text": "گلکلازید میخورم"
    },
