      "start": 11870.9,
      "end": 11872.9,
      "formatted_start": "03:17:50.900",
      "formatted_end": "03:17:52.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 61,
      "start": 11872.9,
      "end": 11874.9,
      "formatted_start": "03:17:52.900",
      "formatted_end": "03:17:54.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 62,
      "start": 11874.9,
      "end": 11876.9,
      "formatted_start": "03:17:54.900",
      "formatted_end": "03:17:56.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 63,
      "start": 11876.9,
      "end": 11878.9,
      "formatted_start": "03:17:56.900",
      "formatted_end": "03:17:58.900",
      "text": "در اینجا باید برداریم"
    },
    {
      "id": 64,
      "start": 11878.9,
      "end": 11880.9,
      "formatted_start": "03:17:58.900",
      "formatted_end": "03:18:00.900",
      "text": "در اینجا باید برداریم"
    },
    {
