  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7202.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:02.000",
      "text": "اینجا باید برداری بسیار پیش روز بود."
    },
    {
      "id": 1,
      "start": 7202.0,
      "end": 7206.0,
      "formatted_start": "02:00:02.000",
      "formatted_end": "02:00:06.000",
      "text": "برای این درموشنی با شما ملافتن میخواد درموشن کنیم"
    },
    {
      "id": 2,
      "start": 7206.0,
      "end": 7210.0,
      "formatted_start": "02:00:06.000",
      "formatted_end": "02:00:10.000",
      "text": "آره، ما گوزیم درموشن بیسترش بگیر باش بگیر این ها همون چیز باشن"
    },
    {
      "id": 3,
      "start": 7210.0,
      "end": 7212.0,
      "formatted_start": "02:00:10.000",
      "formatted_end": "02:00:12.000",
      "text": "اصلا"
    },
    {
      "id": 4,
      "start": 7212.0,
      "end": 7216.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:16.000",
      "text": "اصلا مهم صاف بشینید، هیچ ره هم بزنکنید"
    },
    {
      "id": 5,
      "start": 7216.0,
      "end": 7220.0,
      "formatted_start": "02:00:16.000",
      "formatted_end": "02:00:20.000",
      "text": "بعد، پولا زیاده هم این موضوع"
    },
    {
      "id": 6,
      "start": 7220.0,
      "end": 7223.0,
      "formatted_start": "02:00:20.000",
      "formatted_end": "02:00:23.000",
      "text": "اینو نمیتونم، یک آلمت سر باید چیزی شده همیشه"
    },
    {
      "id": 7,
      "start": 7223.0,
      "end": 7227.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:27.000",
      "text": "خب آره ما هم دیدیم اطراف اون طور شهر ما هر کلومتر سرم زیاد هم"
    },
    {
      "id": 8,
      "start": 7227.0,
      "end": 7229.24,
      "formatted_start": "02:00:27.000",
      "formatted_end": "02:00:29.240",
      "text": "ولی توفقا میره ما کسی نیستیم"
    },
    {
      "id": 9,
      "start": 7229.24,
      "end": 7234.16,
      "formatted_start": "02:00:29.240",
      "formatted_end": "02:00:34.160",
      "text": "به خاطر تغذیه های بد و مزاقار مقاد شمیری قضاها"
    },
    {
      "id": 10,
      "start": 7234.16,
      "end": 7237.04,
      "formatted_start": "02:00:34.160",
      "formatted_end": "02:00:37.040",
      "text": "بچه ها اصلا کل سیستمشون به هم بخورن"
    },
    {
      "id": 11,
      "start": 7237.04,
      "end": 7243.12,
      "formatted_start": "02:00:37.040",
      "formatted_end": "02:00:43.120",
      "text": "من مثلا جز اون بچه هاییستم که از محل و سیابی نوخور که میخورن"
    },
    {
      "id": 12,
      "start": 7243.12,
      "end": 7244.44,
      "formatted_start": "02:00:43.120",
      "formatted_end": "02:00:44.440",
      "text": "نه نه نوخور هم نیست"
    },
    {
      "id": 13,
      "start": 7244.44,
      "end": 7246.44,
      "formatted_start": "02:00:44.440",
      "formatted_end": "02:00:46.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 14,
      "start": 7246.44,
      "end": 7248.44,
      "formatted_start": "02:00:46.440",
      "formatted_end": "02:00:48.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 15,
      "start": 7248.44,
      "end": 7250.44,
      "formatted_start": "02:00:48.440",
      "formatted_end": "02:00:50.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 16,
      "start": 7250.44,
      "end": 7252.44,
      "formatted_start": "02:00:50.440",
      "formatted_end": "02:00:52.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 17,
      "start": 7252.44,
      "end": 7254.44,
      "formatted_start": "02:00:52.440",
      "formatted_end": "02:00:54.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 18,
      "start": 7254.44,
      "end": 7256.44,
      "formatted_start": "02:00:54.440",
      "formatted_end": "02:00:56.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 19,
      "start": 7256.44,
      "end": 7258.44,
      "formatted_start": "02:00:56.440",
      "formatted_end": "02:00:58.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 20,
      "start": 7258.44,
      "end": 7260.44,
      "formatted_start": "02:00:58.440",
      "formatted_end": "02:01:00.440",
      "text": "نه، این مردم هم با هر کلی رو ترک میشه"
    },
    {
      "id": 21,
      "start": 7260.44,
      "end": 7262.44,
      "formatted_start": "02:01:00.440",
      "formatted_end": "02:01:02.440",
      "text": "چاری نداریم در موقع چون همین"
    },
    {
      "id": 22,
      "start": 7264.44,
      "end": 7266.44,
      "formatted_start": "02:01:04.440",
      "formatted_end": "02:01:06.440",
      "text": "بسر هم زیر بخطت مای دروش درمده هست"
    },
    {
      "id": 23,
      "start": 7266.44,
      "end": 7268.44,
      "formatted_start": "02:01:06.440",
      "formatted_end": "02:01:08.440",
      "text": "آره"
    },
    {
      "id": 24,
      "start": 7270.44,
      "end": 7272.44,
      "formatted_start": "02:01:10.440",
      "formatted_end": "02:01:12.440",
      "text": "خصوصی چی؟"
    },
    {
      "id": 25,
      "start": 7272.44,
      "end": 7274.44,
      "formatted_start": "02:01:12.440",
      "formatted_end": "02:01:14.440",
      "text": "آره"
    },
    {
      "id": 26,
      "start": 7276.44,
      "end": 7278.44,
      "formatted_start": "02:01:16.440",
      "formatted_end": "02:01:18.440",
      "text": "گردنت خارش هم میده؟"
    },
    {
      "id": 27,
      "start": 7278.44,
      "end": 7280.44,
      "formatted_start": "02:01:18.440",
      "formatted_end": "02:01:20.440",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 7280.44,
      "end": 7282.44,
      "formatted_start": "02:01:20.440",
      "formatted_end": "02:01:22.440",
      "text": "پامازه تو هر هشت ساعت بزن"
    },
    {
      "id": 29,
      "start": 7282.44,
      "end": 7284.44,
      "formatted_start": "02:01:22.440",
      "formatted_end": "02:01:24.440",
      "text": "خب این هممان بگه"
    },
    {
      "id": 30,
      "start": 7284.44,
      "end": 7286.44,
      "formatted_start": "02:01:24.440",
      "formatted_end": "02:01:26.440",
      "text": "پامازه کامل تنیز با کفتی شروع شامل بزن"
    },
    {
      "id": 31,
      "start": 7286.44,
      "end": 7288.44,
      "formatted_start": "02:01:26.440",
      "formatted_end": "02:01:28.440",
      "text": "آره دیگه هر هشت ساعت دهد"
    },
    {
      "id": 32,
      "start": 7288.44,
      "end": 7291.68,
      "formatted_start": "02:01:28.440",
      "formatted_end": "02:01:31.680",
      "text": "برای همونجا بدقشنگ بزن و ماساج بده جزب بشه"
    },
    {
      "id": 33,
      "start": 7291.68,
      "end": 7293.68,
      "formatted_start": "02:01:31.680",
      "formatted_end": "02:01:33.680",
      "text": "یه قرص هم نمیشم شامبو داری"
    },
    {
      "id": 34,
      "start": 7293.68,
      "end": 7296.68,
      "formatted_start": "02:01:33.680",
      "formatted_end": "02:01:36.680",
      "text": "خیلی داروات استفاده کن تا ببینیم"
    },
    {
      "id": 35,
      "start": 7296.68,
      "end": 7298.68,
      "formatted_start": "02:01:36.680",
      "formatted_end": "02:01:38.680",
      "text": "بگو من برای هم نمانی نکنم"
    },
    {
      "id": 36,
      "start": 7298.68,
      "end": 7300.68,
      "formatted_start": "02:01:38.680",
      "formatted_end": "02:01:40.680",
      "text": "هر هر زده؟"
    },
    {
      "id": 37,
      "start": 7300.68,
      "end": 7302.68,
      "formatted_start": "02:01:40.680",
      "formatted_end": "02:01:42.680",
      "text": "نمانی نمانی"
    },
    {
      "id": 38,
      "start": 7302.68,
      "end": 7304.68,
      "formatted_start": "02:01:42.680",
      "formatted_end": "02:01:44.680",
      "text": "خشک"
    },
    {
      "id": 39,
      "start": 7304.68,
      "end": 7306.68,
      "formatted_start": "02:01:44.680",
      "formatted_end": "02:01:46.680",
      "text": "بزن مرسایت نمانی نمانی"
    },
    {
      "id": 40,
      "start": 7306.68,
      "end": 7308.68,
      "formatted_start": "02:01:46.680",
      "formatted_end": "02:01:48.680",
      "text": "بزن مرسایت نمانی"
    },
    {
      "id": 41,
      "start": 7308.68,
      "end": 7310.68,
      "formatted_start": "02:01:48.680",
      "formatted_end": "02:01:50.680",
      "text": "بزن مرسایت نمانی"
    },
    {
      "id": 42,
      "start": 7310.68,
      "end": 7312.68,
      "formatted_start": "02:01:50.680",
      "formatted_end": "02:01:52.680",
      "text": "بزن مرسایت نمانی"
    },
    {
      "id": 43,
      "start": 7312.68,
      "end": 7314.68,
      "formatted_start": "02:01:52.680",
      "formatted_end": "02:01:54.680",
      "text": "دختری بیرون بیرون"
    },
    {
      "id": 44,
      "start": 7314.68,
      "end": 7316.68,
      "formatted_start": "02:01:54.680",
      "formatted_end": "02:01:56.680",
      "text": "بزن مرسایت نمانی"
    },
    {
      "id": 45,
      "start": 7316.68,
      "end": 7318.68,
      "formatted_start": "02:01:56.680",
      "formatted_end": "02:01:58.680",
      "text": "موسیقی"
    },
    {
      "id": 46,
      "start": 7346.68,
      "end": 7348.68,
      "formatted_start": "02:02:26.680",
      "formatted_end": "02:02:28.680",
      "text": "اصلا سوچی رو میکنه بگذاری؟"
    },
    {
      "id": 47,
      "start": 7348.68,
      "end": 7351.68,
      "formatted_start": "02:02:28.680",
      "formatted_end": "02:02:31.680",
      "text": "اینجا برای مدام اینجایی نمی کنید"
    },
    {
      "id": 48,
      "start": 7351.68,
      "end": 7353.68,
      "formatted_start": "02:02:31.680",
      "formatted_end": "02:02:33.680",
      "text": "آخ، اینجایی خوبه"
    },
    {
      "id": 49,
      "start": 7353.68,
      "end": 7356.68,
      "formatted_start": "02:02:33.680",
      "formatted_end": "02:02:36.680",
      "text": "اینجا در کمبرای جست شده همه بود"
    },
    {
      "id": 50,
      "start": 7356.68,
      "end": 7358.68,
      "formatted_start": "02:02:36.680",
      "formatted_end": "02:02:38.680",
      "text": "نه، این باز میشه"
    },
    {
      "id": 51,
      "start": 7358.68,
      "end": 7360.68,
      "formatted_start": "02:02:38.680",
      "formatted_end": "02:02:40.680",
      "text": "چند ماه شد سرچ کرده؟"
    },
    {
      "id": 52,
      "start": 7360.68,
      "end": 7362.68,
      "formatted_start": "02:02:40.680",
      "formatted_end": "02:02:42.680",
      "text": "سه ماه، یکی برده"
    },
    {
      "id": 53,
      "start": 7362.68,
      "end": 7364.68,
      "formatted_start": "02:02:42.680",
      "formatted_end": "02:02:44.680",
      "text": "اوه، تیره کنم"
    },
    {
      "id": 54,
      "start": 7366.68,
      "end": 7368.68,
      "formatted_start": "02:02:46.680",
      "formatted_end": "02:02:48.680",
      "text": "این صورتی برده بود"
    },
    {
      "id": 55,
      "start": 7368.68,
      "end": 7370.68,
      "formatted_start": "02:02:48.680",
      "formatted_end": "02:02:50.680",
      "text": "اینجا برای مختلفیه"
    },
    {
      "id": 56,
      "start": 7370.68,
      "end": 7373.68,
      "formatted_start": "02:02:50.680",
      "formatted_end": "02:02:53.680",
      "text": "مختلفیه، چرا اونو میشه؟"
    },
    {
      "id": 57,
      "start": 7373.68,
      "end": 7376.68,
      "formatted_start": "02:02:53.680",
      "formatted_end": "02:02:56.680",
      "text": "یعنی نمازاش رو یه بار پرکستان جامعه زیره"
    },
    {
      "id": 58,
      "start": 7376.68,
      "end": 7378.68,
      "formatted_start": "02:02:56.680",
      "formatted_end": "02:02:58.680",
      "text": "از برخوردن باید برخوردن"
    },
    {
      "id": 59,
      "start": 7378.68,
      "end": 7379.68,
      "formatted_start": "02:02:58.680",
      "formatted_end": "02:02:59.680",
      "text": "چی؟"
    },
    {
      "id": 60,
      "start": 7379.68,
      "end": 7381.68,
      "formatted_start": "02:02:59.680",
      "formatted_end": "02:03:01.680",
      "text": "خیلی برموش زیاد نیست"
    },
    {
      "id": 61,
      "start": 7381.68,
      "end": 7382.68,
      "formatted_start": "02:03:01.680",
      "formatted_end": "02:03:02.680",
      "text": "نه، استراحش"
    },
    {
      "id": 62,
      "start": 7382.68,
      "end": 7383.68,
      "formatted_start": "02:03:02.680",
      "formatted_end": "02:03:03.680",
      "text": "استراحش که این وحشت"
    },
    {
      "id": 63,
      "start": 7383.68,
      "end": 7385.68,
      "formatted_start": "02:03:03.680",
      "formatted_end": "02:03:05.680",
      "text": "نه، ما فقط محضون تا محضونتا شروع شویم"
    },
    {
      "id": 64,
      "start": 7385.68,
      "end": 7387.68,
      "formatted_start": "02:03:05.680",
      "formatted_end": "02:03:07.680",
      "text": "تو فرگزیر نیست که نه، محضون اجراحت بدا کنه"
    },
    {
      "id": 65,
      "start": 7387.68,
      "end": 7389.68,
      "formatted_start": "02:03:07.680",
      "formatted_end": "02:03:09.680",
      "text": "چون اینجا شخصی هست؟"
    },
    {
      "id": 66,
      "start": 7389.68,
      "end": 7391.68,
      "formatted_start": "02:03:09.680",
      "formatted_end": "02:03:11.680",
      "text": "آره، تورفتر"
    },
    {
      "id": 67,
      "start": 7391.68,
      "end": 7394.68,
      "formatted_start": "02:03:11.680",
      "formatted_end": "02:03:14.680",
      "text": "یعنی که که از روز پیش اینقدر انصابشو هرام برد کردیم"
    },
    {
      "id": 68,
      "start": 7394.68,
      "end": 7396.68,
      "formatted_start": "02:03:14.680",
      "formatted_end": "02:03:16.680",
      "text": "بیچاره، زیر چکاله براتش بود"
    },
    {
      "id": 69,
      "start": 7396.68,
      "end": 7398.68,
      "formatted_start": "02:03:16.680",
      "formatted_end": "02:03:18.680",
      "text": "اصلا اقای من بچه نیستم"
    },
    {
      "id": 70,
      "start": 7398.68,
      "end": 7402.34,
      "formatted_start": "02:03:18.680",
      "formatted_end": "02:03:22.340",
      "text": "اینقدر راف و میراونه، دیگه اینقدر شده در اصابه ش کنه"
    },
    {
      "id": 71,
      "start": 7402.34,
      "end": 7405.8,
      "formatted_start": "02:03:22.340",
      "formatted_end": "02:03:25.800",
      "text": "از اینجوروز که اومدم من اومدم دیدم که چشمش را را سر کنم چشم را با من زده"
    },
    {
      "id": 72,
      "start": 7405.8,
      "end": 7409.58,
      "formatted_start": "02:03:25.800",
      "formatted_end": "02:03:29.580",
      "text": "شدید هم زده یعنی من تا اینجورو بابا ندارم سر کنم"
    },
    {
      "id": 73,
      "start": 7409.58,
      "end": 7413.3,
      "formatted_start": "02:03:29.580",
      "formatted_end": "02:03:33.300",
      "text": "وقتی که میزنیم اش استناب که پیدا میکنه اینجورو باشه"
    },
    {
      "id": 74,
      "start": 7413.3,
      "end": 7415.78,
      "formatted_start": "02:03:33.300",
      "formatted_end": "02:03:35.780",
      "text": "حتی یه بار هم بسرم خوش خوشید"
    },
    {
      "id": 75,
      "start": 7415.78,
      "end": 7417.1,
      "formatted_start": "02:03:35.780",
      "formatted_end": "02:03:37.100",
      "text": "سیزده سالگی"
    },
    {
      "id": 76,
      "start": 7417.1,
      "end": 7418.78,
      "formatted_start": "02:03:37.100",
      "formatted_end": "02:03:38.780",
      "text": "بسرم شده بودم"
    },
    {
      "id": 77,
      "start": 7418.78,
      "end": 7425.38,
      "formatted_start": "02:03:38.780",
      "formatted_end": "02:03:45.380",
      "text": "سرناد بیخوابی شوانه با اینکه ندام سر کاره بیخوابی شوانه مورد سیزده طولانی گرفته"
    },
    {
      "id": 78,
      "start": 7425.38,
      "end": 7427.38,
      "formatted_start": "02:03:45.380",
      "formatted_end": "02:03:47.380",
      "text": "از اینجا باید براش شوی کنیم"
    },
    {
      "id": 79,
      "start": 7429.38,
      "end": 7433.38,
      "formatted_start": "02:03:49.380",
      "formatted_end": "02:03:53.380",
      "text": "بعد هم بگو که کدوم آخر میخواد استواهد کنه و کدوم نمیخواد براش شوی کنه"
    },
    {
      "id": 80,
      "start": 7433.38,
      "end": 7437.38,
      "formatted_start": "02:03:53.380",
      "formatted_end": "02:03:57.380",
      "text": "اصلا شما هم به خود رو اشناسه کنید که امانت خوبه خونده"
    },
    {
      "id": 81,
      "start": 7437.38,
      "end": 7439.38,
      "formatted_start": "02:03:57.380",
      "formatted_end": "02:03:59.380",
      "text": "امانت خوبه بچه ها از دوازه رو روی"
    },
    {
      "id": 82,
      "start": 7439.38,
      "end": 7443.38,
      "formatted_start": "02:03:59.380",
      "formatted_end": "02:04:03.380",
      "text": "حتی من که مادر عاشق همیون کنید کار نکنید که بچه ها ترسیب سوا پاشه"
    },
    {
      "id": 83,
      "start": 7443.38,
      "end": 7445.38,
      "formatted_start": "02:04:03.380",
      "formatted_end": "02:04:05.380",
      "text": "با این بحث"
    },
    {
      "id": 84,
      "start": 7445.38,
      "end": 7447.38,
      "formatted_start": "02:04:05.380",
      "formatted_end": "02:04:07.380",
      "text": "ولی میره سر کار پیشه"
    },
    {
      "id": 85,
      "start": 7447.38,
      "end": 7451.38,
      "formatted_start": "02:04:07.380",
      "formatted_end": "02:04:11.380",
      "text": "اموش یه کاخ ازو بگه بردار دیر بردار بزاره اینجور"
    },
    {
      "id": 86,
      "start": 7451.38,
      "end": 7453.38,
      "formatted_start": "02:04:11.380",
      "formatted_end": "02:04:13.380",
      "text": "اهم بگیم که دیگه چیز شده"
    },
    {
      "id": 87,
      "start": 7453.38,
      "end": 7456.38,
      "formatted_start": "02:04:13.380",
      "formatted_end": "02:04:16.380",
      "text": "این نصف روز پیششه از صبح شروع میکنه"
    },
    {
      "id": 88,
      "start": 7456.38,
      "end": 7458.38,
      "formatted_start": "02:04:16.380",
      "formatted_end": "02:04:18.380",
      "text": "برخور سر اینجوریه"
    },
    {
      "id": 89,
      "start": 7458.38,
      "end": 7460.38,
      "formatted_start": "02:04:18.380",
      "formatted_end": "02:04:20.380",
      "text": "اموش میگه تو خیلی خیلی توتو کنی"
    },
    {
      "id": 90,
      "start": 7460.38,
      "end": 7462.38,
      "formatted_start": "02:04:20.380",
      "formatted_end": "02:04:22.380",
      "text": "چون خیلی لعافه دیدم میگه توتو کنی"
    },
    {
      "id": 91,
      "start": 7462.38,
      "end": 7464.38,
      "formatted_start": "02:04:22.380",
      "formatted_end": "02:04:24.380",
      "text": "چیزی؟ بچه تو بزاری؟"
    },
    {
      "id": 92,
      "start": 7464.38,
      "end": 7467.38,
      "formatted_start": "02:04:24.380",
      "formatted_end": "02:04:27.380",
      "text": "کاری بچه تو باید آسیب بزار کنی"
    },
    {
      "id": 93,
      "start": 7467.38,
      "end": 7469.38,
      "formatted_start": "02:04:27.380",
      "formatted_end": "02:04:29.380",
      "text": "این آسیب شده که هیچ وقت نداشته نیست"
    },
    {
      "id": 94,
      "start": 7469.38,
      "end": 7471.38,
      "formatted_start": "02:04:29.380",
      "formatted_end": "02:04:31.380",
      "text": "چندین گو تذکر داده آخون بهش"
    },
    {
      "id": 95,
      "start": 7471.38,
      "end": 7473.38,
      "formatted_start": "02:04:31.380",
      "formatted_end": "02:04:33.380",
      "text": "بچه دو داره داره"
    },
    {
      "id": 96,
      "start": 7473.38,
      "end": 7475.38,
      "formatted_start": "02:04:33.380",
      "formatted_end": "02:04:35.380",
      "text": "مگه تاروک داره بخونه"
    },
    {
      "id": 97,
      "start": 7475.38,
      "end": 7477.38,
      "formatted_start": "02:04:35.380",
      "formatted_end": "02:04:37.380",
      "text": "بچه همون الان دیگه دوتو کفته"
    },
    {
      "id": 98,
      "start": 7477.38,
      "end": 7479.38,
      "formatted_start": "02:04:37.380",
      "formatted_end": "02:04:39.380",
      "text": "فعالیت نشده"
    },
    {
      "id": 99,
      "start": 7479.38,
      "end": 7481.38,
      "formatted_start": "02:04:39.380",
      "formatted_end": "02:04:41.380",
      "text": "من میدونم"
    },
    {
      "id": 100,
      "start": 7481.38,
      "end": 7483.38,
      "formatted_start": "02:04:41.380",
      "formatted_end": "02:04:43.380",
      "text": "من از همون استرزست بودش"
    },
    {
      "id": 101,
      "start": 7483.38,
      "end": 7485.38,
      "formatted_start": "02:04:43.380",
      "formatted_end": "02:04:45.380",
      "text": "این لحظه خیلی بهش دیگه"
    },
    {
      "id": 102,
      "start": 7485.38,
      "end": 7487.38,
      "formatted_start": "02:04:45.380",
      "formatted_end": "02:04:47.380",
      "text": "زیادتون همون کلن تهنش خیلی پول پردی میده"
    },
    {
      "id": 103,
      "start": 7487.38,
      "end": 7489.38,
      "formatted_start": "02:04:47.380",
      "formatted_end": "02:04:49.380",
      "text": "از شدتش میده"
    },
    {
      "id": 104,
      "start": 7489.38,
      "end": 7491.38,
      "formatted_start": "02:04:49.380",
      "formatted_end": "02:04:51.380",
      "text": "موقعی کشه مایی از پیش پدرش پنج صبح میکار میکنه"
    },
    {
      "id": 105,
      "start": 7491.38,
      "end": 7493.38,
      "formatted_start": "02:04:51.380",
      "formatted_end": "02:04:53.380",
      "text": "باید شادار هم و دوست داره"
    },
    {
      "id": 106,
      "start": 7493.38,
      "end": 7496.38,
      "formatted_start": "02:04:53.380",
      "formatted_end": "02:04:56.380",
      "text": "هفته صبح که میشه هم مهمیات کلی این بچه میرسه"
    },
    {
      "id": 107,
      "start": 7496.38,
      "end": 7498.38,
      "formatted_start": "02:04:56.380",
      "formatted_end": "02:04:58.380",
      "text": "و هم در صبحاشو گوانی کنه"
    },
    {
      "id": 108,
      "start": 7498.38,
      "end": 7499.38,
      "formatted_start": "02:04:58.380",
      "formatted_end": "02:04:59.380",
      "text": "و از صدرانش میزنه"
    }
  ],
  "status": "completed"
}