  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12904.96,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:04.960",
      "text": "برنامه به من زنگ زنگ گفت که تموم کردن و اگه میتونی برای موسیقی خود این مال من رو بگیاد بش بیام."
    },
    {
      "id": 1,
      "start": 12904.96,
      "end": 12906.96,
      "formatted_start": "03:35:04.960",
      "formatted_end": "03:35:06.960",
      "text": "این حالا خودمون جواب ندارد بگیرم."
    },
    {
      "id": 2,
      "start": 12908.96,
      "end": 12911.64,
      "formatted_start": "03:35:08.960",
      "formatted_end": "03:35:11.640",
      "text": "یه مسلح به شدت سخت گیره خود."
    },
    {
      "id": 3,
      "start": 12911.64,
      "end": 12917.92,
      "formatted_start": "03:35:11.640",
      "formatted_end": "03:35:17.920",
      "text": "آره، ما هر بار که میم یه بسیار میاد دارم اون که دریایی شما به اینجا مراجعه کردید با این عنوان."
    },
    {
      "id": 4,
      "start": 12917.92,
      "end": 12920.32,
      "formatted_start": "03:35:17.920",
      "formatted_end": "03:35:20.320",
      "text": "اگه مقایلت داره بده این سر شما رو ارسال کنید."
    },
    {
      "id": 5,
      "start": 12920.32,
      "end": 12923.64,
      "formatted_start": "03:35:20.320",
      "formatted_end": "03:35:23.640",
      "text": "بعد خیلی پسلا سر نداریم."
    },
    {
      "id": 6,
      "start": 12923.64,
      "end": 12925.64,
      "formatted_start": "03:35:23.640",
      "formatted_end": "03:35:25.640",
      "text": "داده یه شونو زدم"
    },
    {
      "id": 7,
      "start": 12925.64,
      "end": 12927.64,
      "formatted_start": "03:35:25.640",
      "formatted_end": "03:35:27.640",
      "text": "منتظر مصخه خورمانه"
    },
    {
      "id": 8,
      "start": 12927.64,
      "end": 12929.64,
      "formatted_start": "03:35:27.640",
      "formatted_end": "03:35:29.640",
      "text": "یا کن آقای صالح فرد دوتا آزمایش داره"
    },
    {
      "id": 9,
      "start": 12929.64,
      "end": 12931.64,
      "formatted_start": "03:35:29.640",
      "formatted_end": "03:35:31.640",
      "text": "خب من احنادم برای شیرونه"
    },
    {
      "id": 10,
      "start": 12931.64,
      "end": 12933.64,
      "formatted_start": "03:35:31.640",
      "formatted_end": "03:35:33.640",
      "text": "ایفل ساتا"
    },
    {
      "id": 11,
      "start": 12933.64,
      "end": 12935.64,
      "formatted_start": "03:35:33.640",
      "formatted_end": "03:35:35.640",
      "text": "آره"
    },
    {
      "id": 12,
      "start": 12935.64,
      "end": 12937.64,
      "formatted_start": "03:35:35.640",
      "formatted_end": "03:35:37.640",
      "text": "من نمیدونم چرا هرچی که دارم تا میزنم"
    },
    {
      "id": 13,
      "start": 12937.64,
      "end": 12939.64,
      "formatted_start": "03:35:37.640",
      "formatted_end": "03:35:39.640",
      "text": "اصلا میمونسته که"
    },
    {
      "id": 14,
      "start": 12939.64,
      "end": 12941.64,
      "formatted_start": "03:35:39.640",
      "formatted_end": "03:35:41.640",
      "text": "این باید مقایره داره"
    },
    {
      "id": 15,
      "start": 12941.64,
      "end": 12943.64,
      "formatted_start": "03:35:41.640",
      "formatted_end": "03:35:43.640",
      "text": "که اصلا هیچ دوره برایشو ننمیشتم"
    },
    {
      "id": 16,
      "start": 12943.64,
      "end": 12945.64,
      "formatted_start": "03:35:43.640",
      "formatted_end": "03:35:45.640",
      "text": "همه گلونتون نمیخورده؟"
    },
    {
      "id": 17,
      "start": 12945.64,
      "end": 12947.64,
      "formatted_start": "03:35:45.640",
      "formatted_end": "03:35:47.640",
      "text": "نه سری خرف هم آزاد خورده"
    },
    {
      "id": 18,
      "start": 12947.64,
      "end": 12952.14,
      "formatted_start": "03:35:47.640",
      "formatted_end": "03:35:52.140",
      "text": "این سری که شما نوشتید که گلونتر نداشته بیم مشابه شویم در دارو خونه پایین"
    },
    {
      "id": 19,
      "start": 12952.14,
      "end": 12953.64,
      "formatted_start": "03:35:52.140",
      "formatted_end": "03:35:53.640",
      "text": "با همه یارانه اصاب شو"
    },
    {
      "id": 20,
      "start": 12953.64,
      "end": 12956.64,
      "formatted_start": "03:35:53.640",
      "formatted_end": "03:35:56.640",
      "text": "خب ارز کردم من رفتم مسافره کم برده بودم"
    },
    {
      "id": 21,
      "start": 12956.64,
      "end": 12959.64,
      "formatted_start": "03:35:56.640",
      "formatted_end": "03:35:59.640",
      "text": "بعد که در رای گیری هم پیزش نوشت برام رفتم دارو خونه"
    },
    {
      "id": 22,
      "start": 12959.64,
      "end": 12963.64,
      "formatted_start": "03:35:59.640",
      "formatted_end": "03:36:03.640",
      "text": "گو شما هنوز نوبته نشده آزاد گرفتم یه برم"
    },
    {
      "id": 23,
      "start": 12963.64,
      "end": 12967.64,
      "formatted_start": "03:36:03.640",
      "formatted_end": "03:36:07.640",
      "text": "خب چجوری آزاد نوبته تو نشده؟ تموم نشده که؟"
    },
    {
      "id": 24,
      "start": 12967.64,
      "end": 12970.64,
      "formatted_start": "03:36:07.640",
      "formatted_end": "03:36:10.640",
      "text": "نه ارز کردم من کم بردم مسافره"
    },
    {
      "id": 25,
      "start": 12970.64,
      "end": 12971.64,
      "formatted_start": "03:36:10.640",
      "formatted_end": "03:36:11.640",
      "text": "ها شما کم بردم"
    },
    {
      "id": 26,
      "start": 12971.64,
      "end": 12972.64,
      "formatted_start": "03:36:11.640",
      "formatted_end": "03:36:12.640",
      "text": "خونه داشتم"
    },
    {
      "id": 27,
      "start": 12972.64,
      "end": 12974.64,
      "formatted_start": "03:36:12.640",
      "formatted_end": "03:36:14.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 28,
      "start": 12974.64,
      "end": 12976.64,
      "formatted_start": "03:36:14.640",
      "formatted_end": "03:36:16.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 29,
      "start": 12976.64,
      "end": 12978.64,
      "formatted_start": "03:36:16.640",
      "formatted_end": "03:36:18.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 30,
      "start": 12978.64,
      "end": 12980.64,
      "formatted_start": "03:36:18.640",
      "formatted_end": "03:36:20.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 31,
      "start": 12980.64,
      "end": 12982.64,
      "formatted_start": "03:36:20.640",
      "formatted_end": "03:36:22.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 32,
      "start": 12982.64,
      "end": 12984.64,
      "formatted_start": "03:36:22.640",
      "formatted_end": "03:36:24.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 33,
      "start": 12984.64,
      "end": 12986.64,
      "formatted_start": "03:36:24.640",
      "formatted_end": "03:36:26.640",
      "text": "همینطور که باید بردارید، باید بردارید."
    },
    {
      "id": 34,
      "start": 12986.64,
      "end": 12989.64,
      "formatted_start": "03:36:26.640",
      "formatted_end": "03:36:29.640",
      "text": "بسمشو با امان چیز تغییر نمی کنه"
    },
    {
      "id": 35,
      "start": 12989.64,
      "end": 12991.64,
      "formatted_start": "03:36:29.640",
      "formatted_end": "03:36:31.640",
      "text": "بکنم باید ساتا برواد دو تا آزمایشش"
    },
    {
      "id": 36,
      "start": 12991.64,
      "end": 12995.64,
      "formatted_start": "03:36:31.640",
      "formatted_end": "03:36:35.640",
      "text": "نشاندار نشده خودش"
    },
    {
      "id": 37,
      "start": 12995.64,
      "end": 12997.64,
      "formatted_start": "03:36:35.640",
      "formatted_end": "03:36:37.640",
      "text": "با امان"
    },
    {
      "id": 38,
      "start": 13003.64,
      "end": 13005.64,
      "formatted_start": "03:36:43.640",
      "formatted_end": "03:36:45.640",
      "text": "بدون آرزه نشاندار شده"
    },
    {
      "id": 39,
      "start": 13005.64,
      "end": 13007.64,
      "formatted_start": "03:36:45.640",
      "formatted_end": "03:36:47.640",
      "text": "ده ده 1400"
    },
    {
      "id": 40,
      "start": 13007.64,
      "end": 13009.64,
      "formatted_start": "03:36:47.640",
      "formatted_end": "03:36:49.640",
      "text": "چون آزمایش نبوده نشان نرزشون میگه"
    },
    {
      "id": 41,
      "start": 13009.64,
      "end": 13012.64,
      "formatted_start": "03:36:49.640",
      "formatted_end": "03:36:52.640",
      "text": "نه تا 412 اعتبار دیابتش هست"
    },
    {
      "id": 42,
      "start": 13012.64,
      "end": 13019.64,
      "formatted_start": "03:36:52.640",
      "formatted_end": "03:36:59.640",
      "text": "یکی از آقای سالانی رو این تلفونی جرم میده بگید چرا داروی ما از من سبت کردن"
    },
    {
      "id": 43,
      "start": 13019.64,
      "end": 13022.64,
      "formatted_start": "03:36:59.640",
      "formatted_end": "03:37:02.640",
      "text": "بگو چرا میگه آزاد باش که اینش چیه خب؟"
    },
    {
      "id": 44,
      "start": 13022.64,
      "end": 13027.64,
      "formatted_start": "03:37:02.640",
      "formatted_end": "03:37:07.640",
      "text": "یه دقیقه ازش بخوش همینو بیایی کدومده شونیم، من لازم ندارم"
    },
    {
      "id": 45,
      "start": 13042.64,
      "end": 13045.64,
      "formatted_start": "03:37:22.640",
      "formatted_end": "03:37:25.640",
      "text": "چی کار بر بکنه درست بشه؟"
    },
    {
      "id": 46,
      "start": 13048.64,
      "end": 13050.64,
      "formatted_start": "03:37:28.640",
      "formatted_end": "03:37:30.640",
      "text": "یه قلمه ها میزنم"
    },
    {
      "id": 47,
      "start": 13062.64,
      "end": 13064.64,
      "formatted_start": "03:37:42.640",
      "formatted_end": "03:37:44.640",
      "text": "قاطمه سلام"
    },
    {
      "id": 48,
      "start": 13064.64,
      "end": 13065.64,
      "formatted_start": "03:37:44.640",
      "formatted_end": "03:37:45.640",
      "text": "سلام"
    },
    {
      "id": 49,
      "start": 13065.64,
      "end": 13066.64,
      "formatted_start": "03:37:45.640",
      "formatted_end": "03:37:46.640",
      "text": "خوبی؟ سلامتی؟"
    },
    {
      "id": 50,
      "start": 13066.64,
      "end": 13067.64,
      "formatted_start": "03:37:46.640",
      "formatted_end": "03:37:47.640",
      "text": "چکر؟"
    },
    {
      "id": 51,
      "start": 13067.64,
      "end": 13074.64,
      "formatted_start": "03:37:47.640",
      "formatted_end": "03:37:54.640",
      "text": "اینکه این مریض رو به نام آقای سالهی فقه براش دروهاشو میزنه خامدوتو گولرنتاشو"
    },
    {
      "id": 52,
      "start": 13074.64,
      "end": 13081.64,
      "formatted_start": "03:37:54.640",
      "formatted_end": "03:38:01.640",
      "text": "تو سیستم ارور میزنه که نشاندار همه از صحابه تو سیستم تا 1400 درازم نوع دیابتشو خورده"
    },
    {
      "id": 53,
      "start": 13081.64,
      "end": 13086.64,
      "formatted_start": "03:38:01.640",
      "formatted_end": "03:38:06.640",
      "text": "بعدی هرچی میزنه براش ارور میزنه که نمیتونه خامدوتو باش پیدیسه"
    },
    {
      "id": 54,
      "start": 13087.64,
      "end": 13089.64,
      "formatted_start": "03:38:07.640",
      "formatted_end": "03:38:09.640",
      "text": "دریافت من شما خواه بپرسم"
    },
    {
      "id": 55,
      "start": 13089.64,
      "end": 13091.64,
      "formatted_start": "03:38:09.640",
      "formatted_end": "03:38:11.640",
      "text": "همشون؟"
    },
    {
      "id": 56,
      "start": 13091.64,
      "end": 13094.64,
      "formatted_start": "03:38:11.640",
      "formatted_end": "03:38:14.640",
      "text": "میزنن عدم و همخانه باید که یک قلمه نیست"
    },
    {
      "id": 57,
      "start": 13094.64,
      "end": 13096.64,
      "formatted_start": "03:38:14.640",
      "formatted_end": "03:38:16.640",
      "text": "این کلم همخوانی میدونیست؟ یک قلمه"
    },
    {
      "id": 58,
      "start": 13096.64,
      "end": 13099.64,
      "formatted_start": "03:38:16.640",
      "formatted_end": "03:38:19.640",
      "text": "چیزی نداره که قلم همخوانی داشته باشه"
    },
    {
      "id": 59,
      "start": 13099.64,
      "end": 13101.64,
      "formatted_start": "03:38:19.640",
      "formatted_end": "03:38:21.640",
      "text": "اصلا یک قلمه"
    },
    {
      "id": 60,
      "start": 13101.64,
      "end": 13103.64,
      "formatted_start": "03:38:21.640",
      "formatted_end": "03:38:23.640",
      "text": "فقط یک قلم گلورنتا پهم میخوره مریض"
    },
    {
      "id": 61,
      "start": 13103.64,
      "end": 13106.64,
      "formatted_start": "03:38:23.640",
      "formatted_end": "03:38:26.640",
      "text": "من یک گلورنتا اصلا گل کلاسیشو نزدادم"
    },
    {
      "id": 62,
      "start": 13106.64,
      "end": 13108.64,
      "formatted_start": "03:38:26.640",
      "formatted_end": "03:38:28.640",
      "text": "باشه تمام مرسی خدا"
    },
    {
      "id": 63,
      "start": 13108.64,
      "end": 13112.64,
      "formatted_start": "03:38:28.640",
      "formatted_end": "03:38:32.640",
      "text": "گلورنتا شو باید بیدارید خودش نسخه شو چه کنه نسخه مریضو"
    },
    {
      "id": 64,
      "start": 13112.64,
      "end": 13114.64,
      "formatted_start": "03:38:32.640",
      "formatted_end": "03:38:34.640",
      "text": "میگه بازا یه دقیقه باید برات بگم"
    },
    {
      "id": 65,
      "start": 13114.64,
      "end": 13118.64,
      "formatted_start": "03:38:34.640",
      "formatted_end": "03:38:38.640",
      "text": "خطا سامانه شو باشه باید برده توانست سامانه از درست کنه"
    },
    {
      "id": 66,
      "start": 13118.64,
      "end": 13120.64,
      "formatted_start": "03:38:38.640",
      "formatted_end": "03:38:40.640",
      "text": "ایشون بیرون باشه؟"
    },
    {
      "id": 67,
      "start": 13120.64,
      "end": 13122.64,
      "formatted_start": "03:38:40.640",
      "formatted_end": "03:38:42.640",
      "text": "آره، باید دارو تون هر روز نگهت بگیر تا داریم چی کار میکنم"
    },
    {
      "id": 68,
      "start": 13122.64,
      "end": 13124.64,
      "formatted_start": "03:38:42.640",
      "formatted_end": "03:38:44.640",
      "text": "آره، باید دارو تون هر روز نگهت بگیر تا داریم چی کار میکنم"
    },
    {
      "id": 69,
      "start": 13124.64,
      "end": 13126.64,
      "formatted_start": "03:38:44.640",
      "formatted_end": "03:38:46.640",
      "text": "آره، باید دارو تون هر روز نگهت بگیر تا داریم چی کار میکنم"
    },
    {
      "id": 70,
      "start": 13126.64,
      "end": 13128.64,
      "formatted_start": "03:38:46.640",
      "formatted_end": "03:38:48.640",
      "text": "آره، باید دارو تون هر روز نگهت بگیر تا داریم چی کار میکنم"
    },
    {
