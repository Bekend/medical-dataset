      "end": 13156.08,
      "formatted_start": "03:39:10.940",
      "formatted_end": "03:39:16.080",
      "text": "با روزارتان 50 دوزمانی"
    },
    {
      "id": 75,
      "start": 13156.08,
      "end": 13159.46,
      "formatted_start": "03:39:16.080",
      "formatted_end": "03:39:19.460",
      "text": "دیابزید 60"
    },
    {
      "id": 76,
      "start": 13159.46,
      "end": 13162.78,
      "formatted_start": "03:39:19.460",
      "formatted_end": "03:39:22.780",
