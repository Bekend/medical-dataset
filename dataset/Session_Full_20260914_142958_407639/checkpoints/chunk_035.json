    },
    {
      "id": 1,
      "start": 10530.0,
      "end": 10534.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:34.000",
      "text": "اگر بیمه نیست، باید بیمه نیست"
    },
    {
      "id": 2,
      "start": 10534.0,
      "end": 10536.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:36.000",
      "text": "این رو فاکتور بهت میدن؟"
    },
    {
      "id": 3,
      "start": 10536.0,
      "end": 10537.0,
      "formatted_start": "02:55:36.000",
      "formatted_end": "02:55:37.000",
      "text": "نه"
    },
    {
      "id": 4,
      "start": 10537.0,
      "end": 10540.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:40.000",
      "text": "نه بیمه که چیزی... بیمه روشت بیمه"
    },
    {
      "id": 5,
      "start": 10540.0,
      "end": 10542.0,
      "formatted_start": "02:55:40.000",
      "formatted_end": "02:55:42.000",
      "text": "فاکتورت رو هم نمیدن؟"
    },
    {
      "id": 6,
      "start": 10542.0,
      "end": 10543.0,
      "formatted_start": "02:55:42.000",
      "formatted_end": "02:55:43.000",
      "text": "نه"
    },
    {
      "id": 7,
      "start": 10543.0,
      "end": 10545.0,
      "formatted_start": "02:55:43.000",
      "formatted_end": "02:55:45.000",
      "text": "مثل بیمه کلا نیست؟"
    },
    {
      "id": 8,
      "start": 10545.0,
      "end": 10546.0,
      "formatted_start": "02:55:45.000",
      "formatted_end": "02:55:46.000",
      "text": "نه"
    },
    {
      "id": 9,
      "start": 10546.0,
      "end": 10548.0,
      "formatted_start": "02:55:46.000",
      "formatted_end": "02:55:48.000",
      "text": "نه این بیمه هست نه این"
    },
    {
      "id": 10,
      "start": 10548.0,
      "end": 10550.0,
      "formatted_start": "02:55:48.000",
      "formatted_end": "02:55:50.000",
      "text": "بیمه هست"
    },
    {
      "id": 11,
      "start": 10550.0,
      "end": 10552.0,
      "formatted_start": "02:55:50.000",
      "formatted_end": "02:55:52.000",
      "text": "بیمه ها مجبوره"
    },
    {
      "id": 12,
      "start": 10552.0,
      "end": 10555.0,
      "formatted_start": "02:55:52.000",
      "formatted_end": "02:55:55.000",
      "text": "ولی در واقع تو باید ترتفع شده بیمه ها"
    },
    {
      "id": 13,
      "start": 10555.0,
      "end": 10557.0,
      "formatted_start": "02:55:55.000",
      "formatted_end": "02:55:57.000",
      "text": "بیمه ها خاصتر بزن نمیدونی؟"
    },
    {
      "id": 14,
      "start": 10557.0,
      "end": 10562.24,
      "formatted_start": "02:55:57.000",
      "formatted_end": "02:56:02.240",
      "text": "بیماری خواست خیلی هستم برای همون دفعه پروتیمری فقط به بیمارستان برم و"
    },
    {
      "id": 15,
      "start": 10562.24,
      "end": 10565.0,
      "formatted_start": "02:56:02.240",
      "formatted_end": "02:56:05.000",
      "text": "چون گفت که عوض شده بخوایی فقط مثلاً"
    },
    {
      "id": 16,
      "start": 10565.0,
      "end": 10570.0,
      "formatted_start": "02:56:05.000",
      "formatted_end": "02:56:10.000",
      "text": "از نوشکا بیمارستان بری و با درورات هم که بعضی درورات"
    },
    {
      "id": 17,
      "start": 10570.0,
      "end": 10575.0,
      "formatted_start": "02:56:10.000",
      "formatted_end": "02:56:15.000",
      "text": "مثلاً این ها، اطباگراف این ها هست، این ها پوشش میده"
    },
    {
      "id": 18,
      "start": 10575.0,
      "end": 10577.0,
      "formatted_start": "02:56:15.000",
      "formatted_end": "02:56:17.000",
      "text": "آره، اونها که خیلی گفت"
    },
    {
      "id": 19,
      "start": 10577.0,
      "end": 10581.0,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:21.000",
      "text": "چون اون داری خواب پوشش دادنش مثلاً این طریق چه تا دانه"
    },
    {
      "id": 20,
      "start": 10581.0,
      "end": 10584.0,
      "formatted_start": "02:56:21.000",
      "formatted_end": "02:56:24.000",
      "text": "اون طریق پوشش میده مثلاً به شرکت اینستو دکتور"
    },
    {
      "id": 21,
      "start": 10587.0,
      "end": 10592.0,
      "formatted_start": "02:56:27.000",
      "formatted_end": "02:56:32.000",
      "text": "اینجا تهم میشه باز دیابیتی همین هست"
    },
    {
      "id": 22,
      "start": 10592.0,
      "end": 10598.0,
      "formatted_start": "02:56:32.000",
      "formatted_end": "02:56:38.000",
      "text": "خب نمیارزه باز آزمایش کابیدتو ببری یه جا"
    },
    {
      "id": 23,
      "start": 10598.0,
      "end": 10602.0,
      "formatted_start": "02:56:38.000",
      "formatted_end": "02:56:42.000",
      "text": "سی تی اسکنت و سی تی اسکنت بزنه"
    },
    {
      "id": 24,
      "start": 10602.0,
      "end": 10605.0,
      "formatted_start": "02:56:42.000",
      "formatted_end": "02:56:45.000",
      "text": "اگه بیمارستان اینجا میده؟"
    },
    {
      "id": 25,
      "start": 10605.0,
      "end": 10608.0,
      "formatted_start": "02:56:45.000",
      "formatted_end": "02:56:48.000",
      "text": "نه، میکروب مده نه، دولتی نیست"
    },
    {
      "id": 26,
      "start": 10608.0,
      "end": 10613.0,
      "formatted_start": "02:56:48.000",
      "formatted_end": "02:56:53.000",
      "text": "اصلاً کلاً میکروب مده تو تمام دفترچه ها آزاده"
    },
    {
      "id": 27,
      "start": 10613.0,
      "end": 10643.0,
      "formatted_start": "02:56:53.000",
      "formatted_end": "02:57:23.000",
      "text": "همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور که همینطور ک"
    },
    {
      "id": 28,
      "start": 10643.0,
      "end": 10645.0,
      "formatted_start": "02:57:23.000",
      "formatted_end": "02:57:25.000",
      "text": "از دیگه چی اعتمادی ندارم"
    },
    {
      "id": 29,
      "start": 10647.0,
      "end": 10649.0,
      "formatted_start": "02:57:27.000",
      "formatted_end": "02:57:29.000",
      "text": "این مستقاشون اینو قدیم یکی هست"
    },
    {
      "id": 30,
      "start": 10651.0,
      "end": 10653.0,
      "formatted_start": "02:57:31.000",
      "formatted_end": "02:57:33.000",
      "text": "از آسمانش ها بیمارستان نه؟"
    },
    {
      "id": 31,
      "start": 10653.0,
      "end": 10655.0,
      "formatted_start": "02:57:33.000",
      "formatted_end": "02:57:35.000",
      "text": "یا بیمارستان جای دیگه بوده هست؟"
    },
    {
      "id": 32,
      "start": 10655.0,
      "end": 10657.0,
      "formatted_start": "02:57:35.000",
      "formatted_end": "02:57:37.000",
      "text": "مثلا گمبت یکی برکن"
    },
    {
      "id": 33,
      "start": 10657.0,
      "end": 10659.0,
      "formatted_start": "02:57:37.000",
      "formatted_end": "02:57:39.000",
      "text": "آسمانش"
    },
    {
      "id": 34,
      "start": 10659.0,
      "end": 10661.0,
      "formatted_start": "02:57:39.000",
      "formatted_end": "02:57:41.000",
      "text": "کل اینو بسایی بردفع پلته یه نه؟"
    },
    {
      "id": 35,
      "start": 10661.0,
      "end": 10663.0,
      "formatted_start": "02:57:41.000",
      "formatted_end": "02:57:43.000",
      "text": "نه اون خوبه"
    },
    {
      "id": 36,
      "start": 10663.0,
      "end": 10665.0,
      "formatted_start": "02:57:43.000",
      "formatted_end": "02:57:45.000",
      "text": "حتی اینجا بیشترش میگه"
    },
    {
      "id": 37,
      "start": 10665.0,
      "end": 10667.0,
      "formatted_start": "02:57:45.000",
      "formatted_end": "02:57:47.000",
      "text": "چیز نداری؟ فقط"
    },
    {
      "id": 38,
      "start": 10667.0,
      "end": 10669.0,
      "formatted_start": "02:57:47.000",
      "formatted_end": "02:57:49.000",
      "text": "از اون پدرانه 24 ساعته نیگه"
    },
    {
      "id": 39,
      "start": 10669.0,
      "end": 10671.0,
      "formatted_start": "02:57:49.000",
      "formatted_end": "02:57:51.000",
      "text": "خونه نه نیگه"
    },
    {
      "id": 40,
      "start": 10671.0,
      "end": 10674.0,
      "formatted_start": "02:57:51.000",
      "formatted_end": "02:57:54.000",
      "text": "یک بار پیشتر نگه داریم."
    },
    {
      "id": 41,
      "start": 10681.0,
      "end": 10684.0,
      "formatted_start": "02:58:01.000",
      "formatted_end": "02:58:04.000",
      "text": "من همون پذکریمش مشکل نخواهیم دادم."
    },
    {
      "id": 42,
      "start": 10684.0,
      "end": 10688.0,
      "formatted_start": "02:58:04.000",
      "formatted_end": "02:58:08.000",
      "text": "پایین از هزارون دفعه پرتگیرون مشکل نداریم."
    },
    {
      "id": 43,
      "start": 10688.0,
      "end": 10691.0,
      "formatted_start": "02:58:08.000",
      "formatted_end": "02:58:11.000",
      "text": "تو مشکل نداریم، من مشکل ندارم."
    },
    {
      "id": 44,
      "start": 10693.0,
      "end": 10697.0,
      "formatted_start": "02:58:13.000",
      "formatted_end": "02:58:17.000",
      "text": "اگه خوانده که قبلن، اون بوقت قبلن بیرفتم چند سال پیش،"
    },
    {
      "id": 45,
      "start": 10697.0,
      "end": 10701.0,
      "formatted_start": "02:58:17.000",
      "formatted_end": "02:58:21.000",
      "text": "چند سال پیش نفتی تا سه هزار هم برسه مشکلی ندار بردار"
    },
    {
      "id": 46,
      "start": 10701.0,
      "end": 10703.0,
      "formatted_start": "02:58:21.000",
      "formatted_end": "02:58:23.000",
      "text": "نه نه سردگیتو میکنی"
    },
    {
      "id": 47,
      "start": 10703.0,
      "end": 10707.0,
      "formatted_start": "02:58:23.000",
      "formatted_end": "02:58:27.000",
      "text": "خدا شکر انا سی سال تکراتینه تنوز نرماله"
    },
    {
      "id": 48,
      "start": 10707.0,
      "end": 10711.0,
      "formatted_start": "02:58:27.000",
      "formatted_end": "02:58:31.000",
      "text": "تو رنجو مثل اینه نشدی به دکتور که سریع برنده سمتو نارسه برنده"
    },
    {
      "id": 49,
      "start": 10711.0,
      "end": 10713.0,
      "formatted_start": "02:58:31.000",
      "formatted_end": "02:58:33.000",
      "text": "اما دارو تو باید بخوری"
    },
    {
      "id": 50,
      "start": 10713.0,
      "end": 10717.0,
      "formatted_start": "02:58:33.000",
      "formatted_end": "02:58:37.000",
      "text": "آقای مجموعه آخرین گفت که دارو باید تا آخرانو بخوری"
    },
    {
      "id": 51,
      "start": 10717.0,
      "end": 10719.0,
      "formatted_start": "02:58:37.000",
      "formatted_end": "02:58:39.000",
      "text": "چرا؟ نمیخوادی نمیدون"
    },
    {
      "id": 52,
      "start": 10719.0,
      "end": 10721.0,
      "formatted_start": "02:58:39.000",
      "formatted_end": "02:58:41.000",
      "text": "آقای تو باید بازارتانو بخور"
    },
    {
      "id": 53,
      "start": 10721.0,
      "end": 10724.06,
      "formatted_start": "02:58:41.000",
      "formatted_end": "02:58:44.060",
      "text": "بابا بازارتان که دیگه به میده تو رفتی نداده دیگه"
    },
    {
      "id": 54,
      "start": 10724.06,
      "end": 10726.06,
      "formatted_start": "02:58:44.060",
      "formatted_end": "02:58:46.060",
      "text": "بازارتان چیلو بخور دیگه؟"
    },
    {
      "id": 55,
      "start": 10726.06,
      "end": 10729.06,
      "formatted_start": "02:58:46.060",
      "formatted_end": "02:58:49.060",
      "text": "چیلو بخورم؟ دارم خونه"
    },
    {
      "id": 56,
      "start": 10729.06,
      "end": 10733.06,
      "formatted_start": "02:58:49.060",
      "formatted_end": "02:58:53.060",
      "text": "داری؟ نه تا اخر حملو خورده دارم"
    },
    {
      "id": 57,
      "start": 10733.06,
      "end": 10738.06,
      "formatted_start": "02:58:53.060",
      "formatted_end": "02:58:58.060",
      "text": "چیلو فهمی کنی؟ خوصله نداری یا از بازار حزینه فهمی کنی؟"
    },
    {
      "id": 58,
      "start": 10738.06,
      "end": 10740.06,
      "formatted_start": "02:58:58.060",
      "formatted_end": "02:59:00.060",
      "text": "نه از حزینه که نیست"
    },
    {
      "id": 59,
      "start": 10740.06,
      "end": 10743.06,
      "formatted_start": "02:59:00.060",
      "formatted_end": "02:59:03.060",
      "text": "بس و ازیاد شده میده هم"
    },
    {
      "id": 60,
      "start": 10743.06,
      "end": 10744.06,
      "formatted_start": "02:59:03.060",
      "formatted_end": "02:59:04.060",
      "text": "بازارتان هیچ"
    },
    {
      "id": 61,
      "start": 10744.06,
      "end": 10749.06,
      "formatted_start": "02:59:04.060",
      "formatted_end": "02:59:09.060",
      "text": "بعد اینکه کلم گفته آرموریو کلم میخوام دوراتو عوض کنم"
    },
    {
      "id": 62,
      "start": 10749.06,
      "end": 10779.06,
      "formatted_start": "02:59:09.060",
      "formatted_end": "02:59:39.060",
      "text": "این رو برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برا"
    },
    {
      "id": 63,
      "start": 10779.06,
      "end": 10792.06,
      "formatted_start": "02:59:39.060",
      "formatted_end": "02:59:52.060",
      "text": "اینجا همین روز بشم و گفتم همه چیز هم یه حرف میزارنده."
    },
    {
      "id": 64,
      "start": 10792.06,
      "end": 10794.06,
      "formatted_start": "02:59:52.060",
      "formatted_end": "02:59:54.060",
      "text": "یاد فرق نداره بخواییم."
    }
  ],
