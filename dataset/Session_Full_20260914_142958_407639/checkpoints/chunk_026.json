  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7830.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 7830.0,
      "end": 7832.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:32.000",
      "text": "چی؟ تیتی چی داشت؟"
    },
    {
      "id": 2,
      "start": 7832.0,
      "end": 7834.0,
      "formatted_start": "02:10:32.000",
      "formatted_end": "02:10:34.000",
      "text": "یه؟"
    },
    {
      "id": 3,
      "start": 7834.0,
      "end": 7836.0,
      "formatted_start": "02:10:34.000",
      "formatted_end": "02:10:36.000",
      "text": "آه این صد روزان رو بیسته"
    },
    {
      "id": 4,
      "start": 7836.0,
      "end": 7838.0,
      "formatted_start": "02:10:36.000",
      "formatted_end": "02:10:38.000",
      "text": "گفت خودت برو پیش دکتر رو بیده"
    },
    {
      "id": 5,
      "start": 7838.0,
      "end": 7840.0,
      "formatted_start": "02:10:38.000",
      "formatted_end": "02:10:40.000",
      "text": "آه نیم مرده تو سامانه برشن"
    },
    {
      "id": 6,
      "start": 7840.0,
      "end": 7842.0,
      "formatted_start": "02:10:40.000",
      "formatted_end": "02:10:42.000",
      "text": "آقای میرا را گذاریم"
    },
    {
      "id": 7,
      "start": 7842.0,
      "end": 7844.0,
      "formatted_start": "02:10:42.000",
      "formatted_end": "02:10:44.000",
      "text": "من نیم بگم بگم شای نیم مرده"
    },
    {
      "id": 8,
      "start": 7844.0,
      "end": 7846.0,
      "formatted_start": "02:10:44.000",
      "formatted_end": "02:10:46.000",
      "text": "این زندگاه بزنی؟"
    },
    {
      "id": 9,
      "start": 7846.0,
      "end": 7850.0,
      "formatted_start": "02:10:46.000",
      "formatted_end": "02:10:50.000",
      "text": "آه خاندکتر ما تا وز ساعت پیش"
    },
    {
      "id": 10,
      "start": 7850.0,
      "end": 7852.0,
      "formatted_start": "02:10:50.000",
      "formatted_end": "02:10:52.000",
      "text": "چون آتی کشی ماما خواهد باشید"
    },
    {
      "id": 11,
      "start": 7852.0,
      "end": 7854.0,
      "formatted_start": "02:10:52.000",
      "formatted_end": "02:10:54.000",
      "text": "قرارید ناشتاشون چهار ساعت بود"
    },
    {
      "id": 12,
      "start": 7854.0,
      "end": 7856.0,
      "formatted_start": "02:10:54.000",
      "formatted_end": "02:10:56.000",
      "text": "بعد براشون درون نوشتیم"
    },
    {
      "id": 13,
      "start": 7856.0,
      "end": 7858.0,
      "formatted_start": "02:10:56.000",
      "formatted_end": "02:10:58.000",
      "text": "از اینجور برات بازی که بگرسیم با تقرار نداریم"
    },
    {
      "id": 14,
      "start": 7858.0,
      "end": 7862.76,
      "formatted_start": "02:10:58.000",
      "formatted_end": "02:11:02.760",
      "text": "اگر دوباره آزمایش براشون براشون برنیسین قبل صبحونه بعد صبحونه تو برام آزمایشون"
    },
    {
      "id": 15,
      "start": 7862.76,
      "end": 7864.76,
      "formatted_start": "02:11:02.760",
      "formatted_end": "02:11:04.760",
      "text": "چرا این مدت خودتون نگرفتین؟"
    },
    {
      "id": 16,
      "start": 7864.76,
      "end": 7868.76,
      "formatted_start": "02:11:04.760",
      "formatted_end": "02:11:08.760",
      "text": "چرا؟ قبل صبحونه 128 بود بعد صبحونه 168 بود"
    },
    {
      "id": 17,
      "start": 7868.76,
      "end": 7870.76,
      "formatted_start": "02:11:08.760",
      "formatted_end": "02:11:10.760",
      "text": "انشاءالله برام تونه میشه خیلی خوبه"
    },
    {
      "id": 18,
      "start": 7870.76,
      "end": 7872.26,
      "formatted_start": "02:11:10.760",
      "formatted_end": "02:11:12.260",
      "text": "حالتون خوبه؟"
    },
    {
      "id": 19,
      "start": 7872.26,
      "end": 7873.26,
      "formatted_start": "02:11:12.260",
      "formatted_end": "02:11:13.260",
      "text": "الان خوبه"
    },
    {
      "id": 20,
      "start": 7873.26,
      "end": 7875.26,
      "formatted_start": "02:11:13.260",
      "formatted_end": "02:11:15.260",
      "text": "اگه اینجور باشه انشاءالله برام"
    },
    {
      "id": 21,
      "start": 7875.26,
      "end": 7877.26,
      "formatted_start": "02:11:15.260",
      "formatted_end": "02:11:17.260",
      "text": "قبلن خیلی تشنشون میشه در اینجور"
    },
    {
      "id": 22,
      "start": 7877.26,
      "end": 7879.26,
      "formatted_start": "02:11:17.260",
      "formatted_end": "02:11:19.260",
      "text": "اوه یعنی قدرشون رو رفتیم الان تشن نمیشه؟"
    },
    {
      "id": 23,
      "start": 7879.26,
      "end": 7881.26,
      "formatted_start": "02:11:19.260",
      "formatted_end": "02:11:21.260",
