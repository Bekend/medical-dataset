      "start": 7929.26,
      "end": 7931.26,
      "formatted_start": "02:12:09.260",
      "formatted_end": "02:12:11.260",
      "text": "تموم شد دوباره بگیم"
    },
    {
      "id": 49,
      "start": 7931.26,
      "end": 7933.26,
      "formatted_start": "02:12:11.260",
      "formatted_end": "02:12:13.260",
      "text": "ولی معنا امپیرازول هم تموم شده"
    },
