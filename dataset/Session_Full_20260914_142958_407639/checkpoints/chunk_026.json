      "end": 7889.26,
      "formatted_start": "02:11:27.260",
      "formatted_end": "02:11:29.260",
      "text": "اینکه باید بردارید"
    },
    {
      "id": 28,
      "start": 7889.26,
      "end": 7891.26,
      "formatted_start": "02:11:29.260",
      "formatted_end": "02:11:31.260",
      "text": "اینکه باید بردارید"
    },
    {
      "id": 29,
      "start": 7891.26,
      "end": 7893.26,
      "formatted_start": "02:11:31.260",
      "formatted_end": "02:11:33.260",
      "text": "سربان قلب شما خواهید"
    },
    {
      "id": 30,
      "start": 7893.26,
      "end": 7895.26,
      "formatted_start": "02:11:33.260",
      "formatted_end": "02:11:35.260",
      "text": "همه داروش آوردید"
    },
