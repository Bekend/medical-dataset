      "id": 32,
      "start": 7897.26,
      "end": 7899.26,
      "formatted_start": "02:11:37.260",
      "formatted_end": "02:11:39.260",
      "text": "دکتر قلبشو نوشید برای ما نوشید"
    },
    {
      "id": 33,
      "start": 7899.26,
      "end": 7901.26,
      "formatted_start": "02:11:39.260",
      "formatted_end": "02:11:41.260",
