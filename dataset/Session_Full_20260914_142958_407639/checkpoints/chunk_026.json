      "id": 46,
      "start": 7925.26,
      "end": 7927.26,
      "formatted_start": "02:12:05.260",
      "formatted_end": "02:12:07.260",
      "text": "خودم هم پیشمون اومده هم برام دارو نداشتین"
    },
