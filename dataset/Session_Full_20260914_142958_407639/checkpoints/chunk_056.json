  "stt_segments": [
    {
      "id": 0,
      "start": 16800.0,
      "end": 16830.0,
      "formatted_start": "04:40:00.000",
      "formatted_end": "04:40:30.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 16830.0,
      "end": 16834.0,
      "formatted_start": "04:40:30.000",
      "formatted_end": "04:40:34.000",
      "text": "چیز میشه سخت میاد از اینکه کمی"
    },
    {
      "id": 2,
      "start": 16834.0,
      "end": 16836.0,
      "formatted_start": "04:40:34.000",
      "formatted_end": "04:40:36.000",
      "text": "پرساتون یکم رو گنات کردن"
    },
    {
      "id": 3,
      "start": 16836.0,
      "end": 16839.0,
      "formatted_start": "04:40:36.000",
      "formatted_end": "04:40:39.000",
      "text": "پولیتون یکم آسیب دیده"
    },
    {
      "id": 4,
      "start": 16839.0,
      "end": 16843.0,
      "formatted_start": "04:40:39.000",
      "formatted_end": "04:40:43.000",
      "text": "بدونی که خودتون مترجم بشین یک ذره آسیب دیده کنید"
    },
    {
      "id": 5,
      "start": 16843.0,
      "end": 16845.0,
      "formatted_start": "04:40:43.000",
      "formatted_end": "04:40:45.000",
      "text": "به خاطر همون کیستان"
    },
    {
      "id": 6,
      "start": 16845.0,
      "end": 16847.0,
      "formatted_start": "04:40:45.000",
      "formatted_end": "04:40:47.000",
      "text": "منتظر شما کار نمیتونید بگیرین"
    },
    {
      "id": 7,
      "start": 16847.0,
      "end": 16849.0,
      "formatted_start": "04:40:47.000",
      "formatted_end": "04:40:49.000",
      "text": "کاری که شما میتونید بگیرین چیه؟"
    },
    {
      "id": 8,
      "start": 16849.0,
      "end": 16852.0,
      "formatted_start": "04:40:49.000",
      "formatted_end": "04:40:52.000",
      "text": "نحمک نخوری، اسفه ناش نخوری"
    },
    {
      "id": 9,
      "start": 16854.0,
      "end": 16856.0,
      "formatted_start": "04:40:54.000",
      "formatted_end": "04:40:56.000",
      "text": "مشتقیری بزن کم رو خورید"
    },
    {
      "id": 10,
      "start": 16856.0,
      "end": 16861.0,
      "formatted_start": "04:40:56.000",
      "formatted_end": "04:41:01.000",
      "text": "در این وقت، هر دو هفته یا هر دهر روز"
    },
    {
      "id": 11,
      "start": 16861.0,
      "end": 16862.0,
      "formatted_start": "04:41:01.000",
      "formatted_end": "04:41:02.000",
      "text": "گوشت گستن بودیم؟"
    },
    {
      "id": 12,
      "start": 16862.0,
      "end": 16863.0,
      "formatted_start": "04:41:02.000",
      "formatted_end": "04:41:03.000",
      "text": "آره"
    },
    {
      "id": 13,
      "start": 16863.0,
      "end": 16865.0,
      "formatted_start": "04:41:03.000",
      "formatted_end": "04:41:05.000",
      "text": "چون گوشتناک زیاد خونه خونه"
    },
    {
      "id": 14,
      "start": 16865.0,
      "end": 16867.0,
      "formatted_start": "04:41:05.000",
      "formatted_end": "04:41:07.000",
      "text": "خیلی اصلا پیشتن بگیره"
    },
    {
      "id": 15,
      "start": 16867.0,
      "end": 16869.0,
      "formatted_start": "04:41:07.000",
      "formatted_end": "04:41:09.000",
      "text": "نه باید بخوریم خاطر کنش خرمان"
    },
    {
      "id": 16,
      "start": 16869.0,
      "end": 16871.0,
      "formatted_start": "04:41:09.000",
      "formatted_end": "04:41:11.000",
      "text": "نه گوش گسفر نباید بیدیم"
    },
    {
      "id": 17,
      "start": 16871.0,
      "end": 16873.0,
      "formatted_start": "04:41:11.000",
      "formatted_end": "04:41:13.000",
      "text": "باید باید پیشتن بگویم چون دارم"
    },
    {
      "id": 18,
      "start": 16873.0,
      "end": 16875.0,
      "formatted_start": "04:41:13.000",
      "formatted_end": "04:41:15.000",
      "text": "اونکه ایرانی همه شن گوشتو برای دوستان"
    },
    {
      "id": 19,
      "start": 16875.0,
      "end": 16877.0,
      "formatted_start": "04:41:15.000",
      "formatted_end": "04:41:17.000",
      "text": "ما بس داریم"
    },
    {
      "id": 20,
      "start": 16877.0,
      "end": 16879.0,
      "formatted_start": "04:41:17.000",
      "formatted_end": "04:41:19.000",
      "text": "ولی خب نمیشه دیگه دوست داریم"
    },
    {
      "id": 21,
      "start": 16879.0,
      "end": 16881.0,
      "formatted_start": "04:41:19.000",
      "formatted_end": "04:41:21.000",
      "text": "نه باید که بخوریم خواهش نمیزیه"
    },
    {
      "id": 22,
      "start": 16881.0,
      "end": 16883.0,
      "formatted_start": "04:41:21.000",
      "formatted_end": "04:41:23.000",
      "text": "کمتر مثلا پیر"
    },
    {
      "id": 23,
      "start": 16883.0,
      "end": 16885.0,
      "formatted_start": "04:41:23.000",
      "formatted_end": "04:41:25.000",
      "text": "بعد زردی نداره"
    },
    {
      "id": 24,
      "start": 16885.0,
      "end": 16890.0,
      "formatted_start": "04:41:25.000",
      "formatted_end": "04:41:30.000",
      "text": "قدر خوبه و ویتامیدی خوبه و تیروید سالمه"
    },
    {
      "id": 25,
      "start": 16890.0,
      "end": 16895.0,
      "formatted_start": "04:41:30.000",
      "formatted_end": "04:41:35.000",
      "text": "یکم که خون اومده پایین بخاطر اینه که کلیتون نیزیست خون داره"
    },
    {
      "id": 26,
      "start": 16895.0,
      "end": 16898.0,
      "formatted_start": "04:41:35.000",
      "formatted_end": "04:41:38.000",
      "text": "خون ریزی داره و منتها شما متحجش نمیشوید"
    },
    {
      "id": 27,
      "start": 16898.0,
      "end": 16902.0,
      "formatted_start": "04:41:38.000",
      "formatted_end": "04:41:42.000",
      "text": "الان همینجا میشخصم و یکم افناد کرده"
    },
    {
      "id": 28,
      "start": 16902.0,
      "end": 16906.0,
      "formatted_start": "04:41:42.000",
      "formatted_end": "04:41:46.000",
      "text": "اصلا خون واضح داره توی آزمایشاتون"
    },
    {
      "id": 29,
      "start": 16906.0,
      "end": 16910.0,
      "formatted_start": "04:41:46.000",
      "formatted_end": "04:41:50.000",
      "text": "اونم بخاطر کیست هست که خطر نشه"
    },
    {
      "id": 30,
      "start": 16910.0,
      "end": 16914.0,
      "formatted_start": "04:41:50.000",
      "formatted_end": "04:41:54.000",
      "text": "آب بد فرامره نه"
    },
    {
      "id": 31,
      "start": 16914.0,
      "end": 16926.32,
      "formatted_start": "04:41:54.000",
      "formatted_end": "04:42:06.320",
      "text": "اگر یه روز دیدی یه ها پرداد خدا رکته، درد شدید شد، ادرال خون شد، سریعت به بیمارستان که جده خون ریزیش رو در آقا بگیرن، همین بگنن هیچ کار دیگه نمیشه"
    },
    {
      "id": 32,
      "start": 16926.32,
      "end": 16931.98,
      "formatted_start": "04:42:06.320",
      "formatted_end": "04:42:11.980",
      "text": "قطعه ها نداره، محاضر باشی هیچ اتفاق نمیاده، فقط رایت"
    },
    {
      "id": 33,
      "start": 16931.98,
      "end": 16934.0,
      "formatted_start": "04:42:11.980",
      "formatted_end": "04:42:14.000",
      "text": "درگرد چی کار کردم؟"
    },
    {
      "id": 34,
      "start": 16935.06,
      "end": 16937.92,
      "formatted_start": "04:42:15.060",
      "formatted_end": "04:42:17.920",
      "text": "دارباتون رو نمیدونیم تا یه درگرد"
    },
    {
      "id": 35,
      "start": 16937.92,
      "end": 16939.68,
      "formatted_start": "04:42:17.920",
      "formatted_end": "04:42:19.680",
      "text": "فشارتون شروع باده است؟"
    },
    {
      "id": 36,
      "start": 16939.68,
      "end": 16942.92,
      "formatted_start": "04:42:19.680",
      "formatted_end": "04:42:22.920",
      "text": "فشار ما، فشار ما میشه همین 15-16 دقیقه"
    },
    {
      "id": 37,
      "start": 16942.92,
      "end": 16943.92,
      "formatted_start": "04:42:22.920",
      "formatted_end": "04:42:23.920",
      "text": "فشار میکنه"
    },
    {
      "id": 38,
      "start": 16943.92,
      "end": 16947.08,
      "formatted_start": "04:42:23.920",
      "formatted_end": "04:42:27.080",
      "text": "از ازاری که ازیت هم نمیکنه ولی خب مگه بالایی دیگه"
    },
    {
      "id": 39,
      "start": 16947.08,
      "end": 16948.88,
      "formatted_start": "04:42:27.080",
      "formatted_end": "04:42:28.880",
      "text": "کالیت هم خراب میشه"
    },
    {
      "id": 40,
      "start": 16948.88,
      "end": 16951.92,
      "formatted_start": "04:42:28.880",
      "formatted_end": "04:42:31.920",
      "text": "اینه مبنی جایی که آسیب میده کالیت هم"
    },
    {
      "id": 41,
      "start": 16951.92,
      "end": 16953.64,
      "formatted_start": "04:42:31.920",
      "formatted_end": "04:42:33.640",
      "text": "خب کالیت خراب میشه"
    },
    {
      "id": 42,
      "start": 16953.64,
      "end": 16955.24,
      "formatted_start": "04:42:33.640",
      "formatted_end": "04:42:35.240",
      "text": "اهم اینه که کالیت هم هست"
    },
    {
      "id": 43,
      "start": 16955.24,
      "end": 16957.84,
      "formatted_start": "04:42:35.240",
      "formatted_end": "04:42:37.840",
      "text": "50% کار میکنه"
    },
    {
      "id": 44,
      "start": 16957.84,
      "end": 16960.44,
      "formatted_start": "04:42:37.840",
      "formatted_end": "04:42:40.440",
      "text": "افت کرده عمل کرده شی"
    },
    {
      "id": 45,
      "start": 16960.44,
      "end": 16962.44,
      "formatted_start": "04:42:40.440",
      "formatted_end": "04:42:42.440",
      "text": "و سنتون که زیاد نیست که"
    },
    {
      "id": 46,
      "start": 16962.44,
      "end": 16964.44,
      "formatted_start": "04:42:42.440",
      "formatted_end": "04:42:44.440",
      "text": "نه بابا سنتون کفید"
    },
    {
      "id": 47,
      "start": 16969.68,
      "end": 16974.68,
      "formatted_start": "04:42:49.680",
      "formatted_end": "04:42:54.680",
      "text": "موسیقی"
    },
    {
      "id": 48,
      "start": 16999.68,
      "end": 17004.68,
      "formatted_start": "04:43:19.680",
      "formatted_end": "04:43:24.680",
      "text": "متابعه شون گفتم یکیش خارجیه، اما همه جا ندارن گمبت دارن خونه دوتا هر روی"
    },
    {
      "id": 49,
      "start": 17004.68,
      "end": 17007.68,
      "formatted_start": "04:43:24.680",
      "formatted_end": "04:43:27.680",
      "text": "حتی اینها بر بگیم چون این نزارهایید مزه آن خوره"
    },
    {
      "id": 50,
      "start": 17007.68,
      "end": 17010.68,
      "formatted_start": "04:43:27.680",
      "formatted_end": "04:43:30.680",
      "text": "خود یکو خورده یه، بعد بیمه نمیخوره و همه جا هم نیست"
    },
    {
      "id": 51,
      "start": 17010.68,
      "end": 17013.68,
      "formatted_start": "04:43:30.680",
      "formatted_end": "04:43:33.680",
      "text": "اینها حتما داراشونو شروع کنن خب"
    },
    {
      "id": 52,
      "start": 17013.68,
      "end": 17018.68,
      "formatted_start": "04:43:33.680",
      "formatted_end": "04:43:38.680",
      "text": "فروزمایدشونو صبح و شب، اون پینرنونشونو یه دونه زهرا"
    },
    {
      "id": 53,
      "start": 17018.68,
      "end": 17022.68,
      "formatted_start": "04:43:38.680",
      "formatted_end": "04:43:42.680",
      "text": "و فقط فروزم، فرق نمی کنه"
    },
    {
      "id": 54,
      "start": 17022.68,
      "end": 17026.68,
      "formatted_start": "04:43:42.680",
      "formatted_end": "04:43:46.680",
      "text": "ببینین یه جوری باشه که بین فروزماید صبح و از"
    },
    {
      "id": 55,
      "start": 17026.68,
      "end": 17031.68,
      "formatted_start": "04:43:46.680",
      "formatted_end": "04:43:51.680",
      "text": "واسه شیشه صبح ششه است فاصله باشه چون این هم فشار میاده پایین همزمان با هم نشه"
    },
    {
      "id": 56,
      "start": 17031.68,
      "end": 17035.68,
      "formatted_start": "04:43:51.680",
      "formatted_end": "04:43:55.680",
      "text": "بعد حتما با پرزمایی یه تونه گوجه بخورن"
    },
    {
      "id": 57,
      "start": 17035.68,
      "end": 17036.68,
      "formatted_start": "04:43:55.680",
      "formatted_end": "04:43:56.680",
      "text": "حتما"
    },
    {
      "id": 58,
      "start": 17037.68,
      "end": 17039.68,
      "formatted_start": "04:43:57.680",
      "formatted_end": "04:43:59.680",
      "text": "آره همیشه"
    },
    {
      "id": 59,
      "start": 17041.68,
      "end": 17045.68,
      "formatted_start": "04:44:01.680",
      "formatted_end": "04:44:05.680",
      "text": "خصوص ناشته ای مده که یه چی خصوص صبح ناشته بخورن"
    },
    {
      "id": 60,
      "start": 17047.68,
      "end": 17050.68,
      "formatted_start": "04:44:07.680",
      "formatted_end": "04:44:10.680",
      "text": "آه اون که همیشه به موردتر بخورن"
    },
    {
      "id": 61,
      "start": 17050.68,
      "end": 17052.68,
      "formatted_start": "04:44:10.680",
      "formatted_end": "04:44:12.680",
      "text": "نمیدونم اون رو دارن یا نم"
    },
    {
      "id": 62,
      "start": 17052.68,
      "end": 17057.3,
      "formatted_start": "04:44:12.680",
      "formatted_end": "04:44:17.300",
      "text": "چقدر گرفتی؟"
    },
    {
      "id": 63,
      "start": 17057.3,
      "end": 17059.74,
      "formatted_start": "04:44:17.300",
      "formatted_end": "04:44:19.740",
      "text": "آه خب پس ایچی دارن"
    },
    {
      "id": 64,
      "start": 17059.74,
      "end": 17062.64,
      "formatted_start": "04:44:19.740",
      "formatted_end": "04:44:22.640",
      "text": "اونو به همون روالی که گفتم بخورم"
    },
    {
      "id": 65,
      "start": 17062.64,
      "end": 17068.22,
      "formatted_start": "04:44:22.640",
      "formatted_end": "04:44:28.220",
      "text": "حتما یک ساعت فاصله باشه"
    },
    {
      "id": 66,
      "start": 17068.22,
      "end": 17068.9,
      "formatted_start": "04:44:28.220",
      "formatted_end": "04:44:28.900",
      "text": "حتما"
    },
    {
      "id": 67,
      "start": 17068.9,
      "end": 17071.86,
      "formatted_start": "04:44:28.900",
      "formatted_end": "04:44:31.860",
      "text": "آره حتما"
    },
    {
      "id": 68,
      "start": 17071.86,
      "end": 17073.7,
      "formatted_start": "04:44:31.860",
      "formatted_end": "04:44:33.700",
      "text": "آره"
    },
    {
      "id": 69,
      "start": 17073.7,
      "end": 17078.74,
      "formatted_start": "04:44:33.700",
      "formatted_end": "04:44:38.740",
      "text": "آره آره"
    },
    {
      "id": 70,
      "start": 17078.74,
      "end": 17082.9,
      "formatted_start": "04:44:38.740",
      "formatted_end": "04:44:42.900",
      "text": "این دو هم بود که نرین"
    },
    {
      "id": 71,
      "start": 17082.9,
      "end": 17087.94,
      "formatted_start": "04:44:42.900",
      "formatted_end": "04:44:47.940",
      "text": "یا این دو هم یا شب"
    },
    {
      "id": 72,
      "start": 17087.94,
      "end": 17089.16,
      "formatted_start": "04:44:47.940",
      "formatted_end": "04:44:49.160",
      "text": "چون افتشار نده"
    },
    {
      "id": 73,
      "start": 17089.16,
      "end": 17091.2,
      "formatted_start": "04:44:49.160",
      "formatted_end": "04:44:51.200",
      "text": "حالا اگر افتشارشون اگر افتشار شد"
    },
    {
      "id": 74,
      "start": 17091.2,
      "end": 17092.68,
      "formatted_start": "04:44:51.200",
      "formatted_end": "04:44:52.680",
      "text": "فرز مایید رو نسل می کنیم"
    },
    {
      "id": 75,
      "start": 17092.68,
      "end": 17094.66,
      "formatted_start": "04:44:52.680",
      "formatted_end": "04:44:54.660",
      "text": "آره"
    },
    {
      "id": 76,
      "start": 17094.66,
      "end": 17096.7,
      "formatted_start": "04:44:54.660",
      "formatted_end": "04:44:56.700",
      "text": "آره"
    },
    {
      "id": 77,
      "start": 17096.7,
      "end": 17099.42,
      "formatted_start": "04:44:56.700",
      "formatted_end": "04:44:59.420",
      "text": "آره"
    }
  ],
  "status": "completed"
}