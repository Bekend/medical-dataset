      "formatted_end": "01:49:17.000",
      "text": "بخوایید خوش کنید"
    },
    {
      "id": 10,
      "start": 6557.0,
      "end": 6559.0,
      "formatted_start": "01:49:17.000",
      "formatted_end": "01:49:19.000",
      "text": "خوب"
    },
    {
      "id": 11,
      "start": 6559.0,
      "end": 6561.0,
      "formatted_start": "01:49:19.000",
      "formatted_end": "01:49:21.000",
      "text": "برش یک خوش کنید"
    },
    {
      "id": 12,
      "start": 6561.0,
      "end": 6563.0,
      "formatted_start": "01:49:21.000",
      "formatted_end": "01:49:23.000",
      "text": "این همه چیزی نداشت"
    },
    {
      "id": 13,
      "start": 6563.0,
      "end": 6565.0,
      "formatted_start": "01:49:23.000",
      "formatted_end": "01:49:25.000",
      "text": "به بلا کنید"
    },
    {
      "id": 14,
      "start": 6565.0,
      "end": 6567.0,
      "formatted_start": "01:49:25.000",
      "formatted_end": "01:49:27.000",
      "text": "اینو توی اخشار میزنید"
    },
    {
      "id": 15,
      "start": 6567.0,
      "end": 6569.0,
      "formatted_start": "01:49:27.000",
      "formatted_end": "01:49:29.000",
      "text": "روزی یه بار پونزه قطعه"
    },
    {
      "id": 16,
      "start": 6569.0,
      "end": 6571.0,
      "formatted_start": "01:49:29.000",
      "formatted_end": "01:49:31.000",
      "text": "اینو روزی سه بار پاشوغ ملکا خورید"
    },
    {
      "id": 17,
      "start": 6571.0,
      "end": 6573.0,
      "formatted_start": "01:49:31.000",
      "formatted_end": "01:49:33.000",
      "text": "این بوقایی"
    },
    {
      "id": 18,
      "start": 6573.0,
      "end": 6575.0,
      "formatted_start": "01:49:33.000",
      "formatted_end": "01:49:35.000",
      "text": "که در چای شدید داره"
    },
    {
      "id": 19,
      "start": 6575.0,
      "end": 6577.0,
      "formatted_start": "01:49:35.000",
      "formatted_end": "01:49:37.000",
      "text": "پونزه قطعه داره"
    },
    {
      "id": 20,
      "start": 6577.0,
      "end": 6579.0,
      "formatted_start": "01:49:37.000",
      "formatted_end": "01:49:39.000",
      "text": "درش نداشتن هست؟"
    },
    {
      "id": 21,
      "start": 6579.0,
      "end": 6581.0,
      "formatted_start": "01:49:39.000",
      "formatted_end": "01:49:41.000",
      "text": "بله"
    },
    {
      "id": 22,
      "start": 6581.0,
      "end": 6583.0,
      "formatted_start": "01:49:41.000",
      "formatted_end": "01:49:43.000",
      "text": "بعد اگر در چای شدید نداشت"
    },
    {
      "id": 23,
      "start": 6583.0,
      "end": 6585.0,
      "formatted_start": "01:49:43.000",
      "formatted_end": "01:49:45.000",
      "text": "بردیم"
    },
    {
      "id": 24,
      "start": 6587.0,
      "end": 6589.0,
      "formatted_start": "01:49:47.000",
      "formatted_end": "01:49:49.000",
      "text": "این چیز ها اشتراکتاش نوشته داره"
    },
    {
      "id": 25,
      "start": 6589.0,
      "end": 6590.0,
      "formatted_start": "01:49:49.000",
      "formatted_end": "01:49:50.000",
      "text": "چقدر بگیم؟"
    },
    {
      "id": 26,
      "start": 6590.0,
      "end": 6592.0,
      "formatted_start": "01:49:50.000",
      "formatted_end": "01:49:52.000",
      "text": "برد نان درسته"
    },
    {
      "id": 27,
      "start": 6592.0,
      "end": 6594.0,
      "formatted_start": "01:49:52.000",
      "formatted_end": "01:49:54.000",
      "text": "نان نوشته"
    },
    {
      "id": 28,
      "start": 6594.0,
      "end": 6596.0,
      "formatted_start": "01:49:54.000",
      "formatted_end": "01:49:56.000",
      "text": "برد نان نوشته"
    },
    {
      "id": 29,
      "start": 6596.0,
      "end": 6598.0,
      "formatted_start": "01:49:56.000",
      "formatted_end": "01:49:58.000",
