  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "خود چهار، پنجتا، سرکار مهمیست."
    },
    {
      "id": 1,
      "start": 6602.0,
      "end": 6603.0,
      "formatted_start": "01:50:02.000",
      "formatted_end": "01:50:03.000",
      "text": "همینه هم بسیار."
    },
    {
      "id": 2,
      "start": 6603.0,
      "end": 6606.0,
      "formatted_start": "01:50:03.000",
      "formatted_end": "01:50:06.000",
      "text": "تحریکی هست این هم، فرس، چند فرس."
    },
    {
      "id": 3,
      "start": 6606.0,
      "end": 6608.0,
      "formatted_start": "01:50:06.000",
      "formatted_end": "01:50:08.000",
      "text": "پرس شیخش که نامی باره؟"
    },
    {
      "id": 4,
      "start": 6608.0,
      "end": 6613.0,
      "formatted_start": "01:50:08.000",
      "formatted_end": "01:50:13.000",
      "text": "شیخش خوشکرید، هر مدل باشه اشکال نداره، به بلا، کی گذار، همه شبیه همه."
    },
    {
      "id": 5,
      "start": 6613.0,
      "end": 6616.0,
      "formatted_start": "01:50:13.000",
      "formatted_end": "01:50:16.000",
      "text": "حالا ما نامی گفتیم، خیلی چی نفرم."
    },
    {
      "id": 6,
      "start": 6616.0,
      "end": 6618.0,
      "formatted_start": "01:50:16.000",
      "formatted_end": "01:50:18.000",
      "text": "پیرامه نامی دیگه؟"
    },
    {
      "id": 7,
      "start": 6618.0,
      "end": 6620.0,
      "formatted_start": "01:50:18.000",
      "formatted_end": "01:50:20.000",
      "text": "یک آره، کلن شماری یک."
    },
    {
      "id": 8,
      "start": 6620.0,
      "end": 6622.0,
      "formatted_start": "01:50:20.000",
      "formatted_end": "01:50:22.000",
      "text": "ولی خانم میگو که دو شب بر بر این رسیده."
    },
    {
      "id": 9,
      "start": 6622.0,
      "end": 6624.0,
      "formatted_start": "01:50:22.000",
      "formatted_end": "01:50:24.000",
      "text": "مشکل ندارده دو شب ببرید"
    },
    {
      "id": 10,
      "start": 6624.0,
      "end": 6625.0,
      "formatted_start": "01:50:24.000",
      "formatted_end": "01:50:25.000",
      "text": "دو شب جواب میکنی؟"
    },
    {
      "id": 11,
      "start": 6625.0,
      "end": 6628.0,
      "formatted_start": "01:50:25.000",
      "formatted_end": "01:50:28.000",
      "text": "ببینی سه شب بهتره ولی سه شب میخوریم به جمع"
    },
    {
      "id": 12,
      "start": 6628.0,
      "end": 6629.0,
      "formatted_start": "01:50:28.000",
      "formatted_end": "01:50:29.000",
      "text": "سه شب به ترتیبی"
    },
    {
      "id": 13,
      "start": 6629.0,
      "end": 6631.0,
      "formatted_start": "01:50:29.000",
      "formatted_end": "01:50:31.000",
      "text": "بعد میشه چهار شب"
    },
    {
      "id": 14,
      "start": 6631.0,
      "end": 6632.0,
      "formatted_start": "01:50:31.000",
      "formatted_end": "01:50:32.000",
      "text": "متشکلی"
    },
    {
      "id": 15,
      "start": 6632.0,
      "end": 6634.0,
      "formatted_start": "01:50:32.000",
      "formatted_end": "01:50:34.000",
      "text": "یا با چهار شب ببرید یا دو شب"
    },
    {
      "id": 16,
      "start": 6634.0,
      "end": 6636.0,
      "formatted_start": "01:50:34.000",
      "formatted_end": "01:50:36.000",
      "text": "هر زمان پیشتر بذارید بهتره"
    },
    {
      "id": 17,
      "start": 6636.0,
      "end": 6638.0,
      "formatted_start": "01:50:36.000",
      "formatted_end": "01:50:38.000",
      "text": "هرچی زیر تره"
    },
    {
      "id": 18,
      "start": 6638.0,
      "end": 6640.0,
      "formatted_start": "01:50:38.000",
      "formatted_end": "01:50:40.000",
      "text": "چون عوارضی نداره"
    },
    {
      "id": 19,
      "start": 6640.0,
      "end": 6642.0,
      "formatted_start": "01:50:40.000",
      "formatted_end": "01:50:42.000",
      "text": "بحث هزینه و"
    },
    {
      "id": 20,
      "start": 6642.0,
      "end": 6644.0,
      "formatted_start": "01:50:42.000",
      "formatted_end": "01:50:44.000",
      "text": "نیاز بچه رو"
    },
    {
      "id": 21,
      "start": 6644.0,
      "end": 6647.0,
      "formatted_start": "01:50:44.000",
      "formatted_end": "01:50:47.000",
      "text": "بعد آبای دویتور این زردیش چند درصده؟"
    },
    {
      "id": 22,
      "start": 6647.0,
      "end": 6652.0,
      "formatted_start": "01:50:47.000",
      "formatted_end": "01:50:52.000",
      "text": "اونو باید آزمایش میبینید، فایده ای نداره، ولی الان تقوی متوسط هست"
    },
    {
      "id": 23,
      "start": 6652.0,
      "end": 6653.0,
      "formatted_start": "01:50:52.000",
      "formatted_end": "01:50:53.000",
      "text": "متوسط هست؟"
    },
    {
      "id": 24,
      "start": 6653.0,
      "end": 6656.0,
      "formatted_start": "01:50:53.000",
      "formatted_end": "01:50:56.000",
      "text": "متوسط هست، شدید نیست الان متوسط هست"
    },
    {
      "id": 25,
      "start": 6656.0,
      "end": 6660.0,
      "formatted_start": "01:50:56.000",
      "formatted_end": "01:51:00.000",
      "text": "ما هم دو شبت داریم فیلا، دو شبت جواب میدهیم"
    },
    {
      "id": 26,
      "start": 6660.0,
      "end": 6663.0,
      "formatted_start": "01:51:00.000",
      "formatted_end": "01:51:03.000",
      "text": "یه شب کنید جواب بید، چه شب دارید؟"
    },
    {
      "id": 27,
      "start": 6663.0,
      "end": 6667.0,
      "formatted_start": "01:51:03.000",
      "formatted_end": "01:51:07.000",
      "text": "من برای خودت میگم دو شبت، چه شب ببینید"
    },
    {
      "id": 28,
      "start": 6667.0,
      "end": 6672.0,
      "formatted_start": "01:51:07.000",
      "formatted_end": "01:51:12.000",
      "text": "او باید اینو که بودم اونو دردش کنم، باید دو شب میباییم؟"
    },
    {
      "id": 29,
      "start": 6672.0,
      "end": 6674.0,
      "formatted_start": "01:51:12.000",
      "formatted_end": "01:51:14.000",
      "text": "اونو الان میادن ما میبینیم دید"
    },
    {
      "id": 30,
      "start": 6674.0,
      "end": 6679.0,
      "formatted_start": "01:51:14.000",
      "formatted_end": "01:51:19.000",
      "text": "اگر ما یک روش دیگه بیدیم که الان باید یک آزمایش بدیم"
    },
    {
      "id": 31,
      "start": 6679.0,
      "end": 6685.0,
      "formatted_start": "01:51:19.000",
      "formatted_end": "01:51:25.000",
      "text": "دستگاه سه شب بزاریم، چهار شب بزاریم، دوباره یک آزمایش بدیم، متجه شدیم، این میشه"
    },
    {
      "id": 32,
      "start": 6685.0,
      "end": 6692.0,
      "formatted_start": "01:51:25.000",
      "formatted_end": "01:51:32.000",
      "text": "ولی تمام اینها درده سره و ما به تجربه تونیم سی سال فهمیدیم که با این چشمی که ما بیدیم درسته را داریم"
    },
    {
      "id": 33,
      "start": 6692.0,
      "end": 6694.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:34.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 34,
      "start": 6694.0,
      "end": 6696.0,
      "formatted_start": "01:51:34.000",
      "formatted_end": "01:51:36.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 35,
      "start": 6696.0,
      "end": 6698.0,
      "formatted_start": "01:51:36.000",
      "formatted_end": "01:51:38.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 36,
      "start": 6698.0,
      "end": 6700.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:40.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 37,
      "start": 6700.0,
      "end": 6702.0,
      "formatted_start": "01:51:40.000",
      "formatted_end": "01:51:42.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 38,
      "start": 6702.0,
      "end": 6704.0,
      "formatted_start": "01:51:42.000",
      "formatted_end": "01:51:44.000",
      "text": "از اینجوری باید بردارید که این کلشر از کلشر میشه"
    },
    {
      "id": 39,
      "start": 6704.0,
      "end": 6707.3,
      "formatted_start": "01:51:44.000",
      "formatted_end": "01:51:47.300",
      "text": "حالا، چشماش نه، این عزیزی ها خوب میشه میاد بالا"
    },
    {
      "id": 40,
      "start": 6707.3,
      "end": 6708.92,
      "formatted_start": "01:51:47.300",
      "formatted_end": "01:51:48.920",
      "text": "بقیه میشه کمی دست میده"
    },
    {
      "id": 41,
      "start": 6708.92,
      "end": 6710.46,
      "formatted_start": "01:51:48.920",
      "formatted_end": "01:51:50.460",
      "text": "شکمی، پیشتر میشه"
    },
    {
      "id": 42,
      "start": 6710.46,
      "end": 6712.06,
      "formatted_start": "01:51:50.460",
      "formatted_end": "01:51:52.060",
      "text": "صورت شاید مثلا یکم بود"
    },
    {
      "id": 43,
      "start": 6712.06,
      "end": 6714.06,
      "formatted_start": "01:51:52.060",
      "formatted_end": "01:51:54.060",
      "text": "صورتش هم تقریب می کنه، سیفید میشه"
    },
    {
      "id": 44,
      "start": 6714.06,
      "end": 6716.06,
      "formatted_start": "01:51:54.060",
      "formatted_end": "01:51:56.060",
      "text": "و خوب به جای داره"
    },
    {
      "id": 45,
      "start": 6716.06,
      "end": 6718.06,
      "formatted_start": "01:51:56.060",
      "formatted_end": "01:51:58.060",
      "text": "پیشتر بگیرم، خیلی شده هم اون کارشه هم میزنیم"
    },
    {
      "id": 46,
      "start": 6718.06,
      "end": 6721.06,
      "formatted_start": "01:51:58.060",
      "formatted_end": "01:52:01.060",
      "text": "حالا اگر خواستی دو شب دیگه اضافه بزاریم، اونها دو شب دیگه اضافه بزاریم"
    },
    {
      "id": 47,
      "start": 6721.06,
      "end": 6724.26,
      "formatted_start": "01:52:01.060",
      "formatted_end": "01:52:04.260",
      "text": "ما چیزی حرفی نداریم، نمیگیم بده ندار"
    },
    {
      "id": 48,
      "start": 6724.26,
      "end": 6726.26,
      "formatted_start": "01:52:04.260",
      "formatted_end": "01:52:06.260",
      "text": "خوبه، اگر میخوایی بذار"
    },
    {
      "id": 49,
      "start": 6726.26,
      "end": 6730.1,
      "formatted_start": "01:52:06.260",
      "formatted_end": "01:52:10.100",
      "text": "چار شب هم دوست داشتی، مطمئن باشی، خیالت راحت باشه"
    },
    {
      "id": 50,
      "start": 6730.1,
      "end": 6732.82,
      "formatted_start": "01:52:10.100",
      "formatted_end": "01:52:12.820",
      "text": "میگو من دو شب دیگه میذارم، کاملا بیاد پایین"
    },
    {
      "id": 51,
      "start": 6732.82,
      "end": 6735.3,
      "formatted_start": "01:52:12.820",
      "formatted_end": "01:52:15.300",
      "text": "هر چی پیشتر بذاری، زرگی پیشتر پایین برد"
    },
    {
      "id": 52,
      "start": 6735.3,
      "end": 6738.82,
      "formatted_start": "01:52:15.300",
      "formatted_end": "01:52:18.820",
      "text": "این اوایل سیپیت میشه، مثلا که من آرمان میذارید"
    },
    {
      "id": 53,
      "start": 6738.82,
      "end": 6740.82,
      "formatted_start": "01:52:18.820",
      "formatted_end": "01:52:20.820",
      "text": "تا فردا میدونید چه سیپیت شد این بچه"
    },
    {
      "id": 54,
      "start": 6740.82,
      "end": 6743.3,
      "formatted_start": "01:52:20.820",
      "formatted_end": "01:52:23.300",
      "text": "آخه این سطح ظاهری"
    },
    {
      "id": 55,
      "start": 6743.3,
      "end": 6748.3,
      "formatted_start": "01:52:23.300",
      "formatted_end": "01:52:28.300",
      "text": "مثلا دستگاه یه ساعت دو ساعت دو سه ساعت که خاموش مونید باید میفهمید موضوع چیه"
    },
    {
      "id": 56,
      "start": 6748.3,
      "end": 6752.3,
      "formatted_start": "01:52:28.300",
      "formatted_end": "01:52:32.300",
      "text": "یه چند ساعتی باید خاموش باشید که اون خوشو نشون بده"
    },
    {
      "id": 57,
      "start": 6752.3,
      "end": 6755.3,
      "formatted_start": "01:52:32.300",
      "formatted_end": "01:52:35.300",
      "text": "خوشو نشون بده"
    },
    {
      "id": 58,
      "start": 6755.3,
      "end": 6757.3,
      "formatted_start": "01:52:35.300",
      "formatted_end": "01:52:37.300",
      "text": "بله"
    },
    {
      "id": 59,
      "start": 6766.3,
      "end": 6769.3,
      "formatted_start": "01:52:46.300",
      "formatted_end": "01:52:49.300",
      "text": "بفهمید بفهمید جان"
    },
    {
      "id": 60,
      "start": 6769.3,
      "end": 6771.3,
      "formatted_start": "01:52:49.300",
      "formatted_end": "01:52:51.300",
      "text": "سلامتان شما خوبه؟ سلامتان"
    },
    {
      "id": 61,
      "start": 6771.3,
      "end": 6773.3,
      "formatted_start": "01:52:51.300",
      "formatted_end": "01:52:53.300",
      "text": "پجیل رو کشت بزنیم"
    },
    {
      "id": 62,
      "start": 6773.3,
      "end": 6775.3,
      "formatted_start": "01:52:53.300",
      "formatted_end": "01:52:55.300",
      "text": "چیز رو بزنیم"
    },
    {
      "id": 63,
      "start": 6781.3,
      "end": 6783.3,
      "formatted_start": "01:53:01.300",
      "formatted_end": "01:53:03.300",
      "text": "پاکون برگیر رو بزنیم"
    },
    {
      "id": 64,
      "start": 6795.3,
      "end": 6797.3,
      "formatted_start": "01:53:15.300",
      "formatted_end": "01:53:17.300",
      "text": "پاکی شده با جوز؟"
    },
    {
      "id": 65,
      "start": 6797.3,
      "end": 6799.3,
      "formatted_start": "01:53:17.300",
      "formatted_end": "01:53:19.300",
      "text": "زرگی"
    },
    {
      "id": 66,
      "start": 6799.3,
      "end": 6801.3,
      "formatted_start": "01:53:19.300",
      "formatted_end": "01:53:21.300",
      "text": "زرگی داری"
    },
    {
      "id": 67,
      "start": 6801.3,
      "end": 6803.3,
      "formatted_start": "01:53:21.300",
      "formatted_end": "01:53:23.300",
      "text": "بگو بگو"
    },
    {
      "id": 68,
      "start": 6803.3,
      "end": 6805.3,
      "formatted_start": "01:53:23.300",
      "formatted_end": "01:53:25.300",
      "text": "یه برگی بگیر"
    },
    {
      "id": 69,
      "start": 6805.3,
      "end": 6807.3,
      "formatted_start": "01:53:25.300",
      "formatted_end": "01:53:27.300",
      "text": "زرگی دار"
    },
    {
      "id": 70,
      "start": 6811.3,
      "end": 6813.3,
      "formatted_start": "01:53:31.300",
      "formatted_end": "01:53:33.300",
      "text": "دوست دید"
    },
    {
      "id": 71,
      "start": 6813.3,
      "end": 6815.3,
      "formatted_start": "01:53:33.300",
      "formatted_end": "01:53:35.300",
      "text": "دوست دید"
    },
    {
      "id": 72,
      "start": 6819.3,
      "end": 6821.3,
      "formatted_start": "01:53:39.300",
      "formatted_end": "01:53:41.300",
      "text": "دوست دارم"
    },
    {
      "id": 73,
      "start": 6821.3,
      "end": 6823.3,
      "formatted_start": "01:53:41.300",
      "formatted_end": "01:53:43.300",
      "text": "برگی"
    },
    {
      "id": 74,
      "start": 6823.3,
      "end": 6825.3,
      "formatted_start": "01:53:43.300",
      "formatted_end": "01:53:45.300",
      "text": "چند روزشه"
    },
    {
      "id": 75,
      "start": 6825.3,
      "end": 6827.3,
      "formatted_start": "01:53:45.300",
      "formatted_end": "01:53:47.300",
      "text": "این از این گوزش هست؟"
    },
    {
      "id": 76,
      "start": 6827.3,
      "end": 6829.3,
      "formatted_start": "01:53:47.300",
      "formatted_end": "01:53:49.300",
      "text": "هر گوزش هست"
    },
    {
      "id": 77,
      "start": 6829.3,
      "end": 6831.3,
      "formatted_start": "01:53:49.300",
      "formatted_end": "01:53:51.300",
      "text": "زرده"
    },
    {
      "id": 78,
      "start": 6831.3,
      "end": 6833.3,
      "formatted_start": "01:53:51.300",
      "formatted_end": "01:53:53.300",
      "text": "گوز های غزه هست؟"
    },
    {
      "id": 79,
      "start": 6833.3,
      "end": 6835.3,
      "formatted_start": "01:53:53.300",
      "formatted_end": "01:53:55.300",
      "text": "اون دلش هم زرده می کنه"
    },
    {
      "id": 80,
      "start": 6835.3,
      "end": 6837.3,
      "formatted_start": "01:53:55.300",
      "formatted_end": "01:53:57.300",
      "text": "دیگه هم زرده"
    },
    {
      "id": 81,
      "start": 6837.3,
      "end": 6839.3,
      "formatted_start": "01:53:57.300",
      "formatted_end": "01:53:59.300",
      "text": "خودت غبوبات و لبنیات نخواد"
    },
    {
      "id": 82,
      "start": 6839.3,
      "end": 6841.3,
      "formatted_start": "01:53:59.300",
      "formatted_end": "01:54:01.300",
      "text": "به خلوپی ها ماشه"
    },
    {
      "id": 83,
      "start": 6841.3,
      "end": 6843.3,
      "formatted_start": "01:54:01.300",
      "formatted_end": "01:54:03.300",
      "text": "لبنیات مثل شیر، ماز، کشبو"
    },
    {
      "id": 84,
      "start": 6843.3,
      "end": 6845.3,
      "formatted_start": "01:54:03.300",
      "formatted_end": "01:54:05.300",
      "text": "خوادینجون هم باد باید"
    },
    {
      "id": 85,
      "start": 6845.3,
      "end": 6847.3,
      "formatted_start": "01:54:05.300",
      "formatted_end": "01:54:07.300",
      "text": "با خیال"
    },
    {
      "id": 86,
      "start": 6855.3,
      "end": 6857.3,
      "formatted_start": "01:54:15.300",
      "formatted_end": "01:54:17.300",
      "text": "خوب"
    },
    {
      "id": 87,
      "start": 6859.3,
      "end": 6861.3,
      "formatted_start": "01:54:19.300",
      "formatted_end": "01:54:21.300",
      "text": "خوب این کامرم زنده"
    },
    {
      "id": 88,
      "start": 6861.3,
      "end": 6863.3,
      "formatted_start": "01:54:21.300",
      "formatted_end": "01:54:23.300",
      "text": "خوب"
    },
    {
      "id": 89,
      "start": 6867.3,
      "end": 6869.3,
      "formatted_start": "01:54:27.300",
      "formatted_end": "01:54:29.300",
      "text": "آی شاوزی آله؟"
    },
    {
      "id": 90,
      "start": 6869.3,
      "end": 6871.3,
      "formatted_start": "01:54:29.300",
      "formatted_end": "01:54:31.300",
      "text": "آمیدون؟"
    },
    {
      "id": 91,
      "start": 6871.3,
      "end": 6873.3,
      "formatted_start": "01:54:31.300",
      "formatted_end": "01:54:33.300",
      "text": "داریم اینو باید دستگاه ببرید بذارید یا بستنیش کنید"
    },
    {
      "id": 92,
      "start": 6873.3,
      "end": 6875.3,
      "formatted_start": "01:54:33.300",
      "formatted_end": "01:54:35.300",
      "text": "هر کدام میخوایی مهم کارم کنید"
    },
    {
      "id": 93,
      "start": 6875.3,
      "end": 6877.3,
      "formatted_start": "01:54:35.300",
      "formatted_end": "01:54:37.300",
      "text": "دستگاه راحت تره"
    },
    {
      "id": 94,
      "start": 6877.3,
      "end": 6879.3,
      "formatted_start": "01:54:37.300",
      "formatted_end": "01:54:39.300",
      "text": "اما اکثرا دستگاه بیدید"
    },
    {
      "id": 95,
      "start": 6879.3,
      "end": 6881.3,
      "formatted_start": "01:54:39.300",
      "formatted_end": "01:54:41.300",
      "text": "یه دو روزی ببر"
    },
    {
      "id": 96,
      "start": 6881.3,
      "end": 6883.3,
      "formatted_start": "01:54:41.300",
      "formatted_end": "01:54:43.300",
      "text": "و بعد بذارید سیفیت بشید"
    },
    {
      "id": 97,
      "start": 6883.3,
      "end": 6885.3,
      "formatted_start": "01:54:43.300",
      "formatted_end": "01:54:45.300",
      "text": "این سیفیت میشه"
    },
    {
      "id": 98,
      "start": 6885.3,
      "end": 6887.3,
      "formatted_start": "01:54:45.300",
      "formatted_end": "01:54:47.300",
      "text": "اون رو بگیرم چهار ساعت یا چهار ساعت"
    },
    {
      "id": 99,
      "start": 6887.3,
      "end": 6889.3,
      "formatted_start": "01:54:47.300",
      "formatted_end": "01:54:49.300",
      "text": "کم تر میگیر تو با این دستگاه"
    },
    {
      "id": 100,
      "start": 6889.3,
      "end": 6891.3,
      "formatted_start": "01:54:49.300",
      "formatted_end": "01:54:51.300",
      "text": "الان دستگاه نداری"
    },
    {
      "id": 101,
      "start": 6891.3,
      "end": 6893.3,
      "formatted_start": "01:54:51.300",
      "formatted_end": "01:54:53.300",
      "text": "این هردن بگیرم تو بگیرم"
    },
    {
      "id": 102,
      "start": 6893.3,
      "end": 6895.3,
      "formatted_start": "01:54:53.300",
      "formatted_end": "01:54:55.300",
      "text": "شاید آخرین دستگاه ماهیم"
    },
    {
      "id": 103,
      "start": 6895.3,
      "end": 6897.3,
      "formatted_start": "01:54:55.300",
      "formatted_end": "01:54:57.300",
      "text": "متعشق دادیم"
    },
    {
      "id": 104,
      "start": 6897.3,
      "end": 6899.3,
      "formatted_start": "01:54:57.300",
      "formatted_end": "01:54:59.300",
      "text": "میگم یه میدار کم تر ساعت"
    }
  ],
  "status": "completed"
}