  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10505.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:05.000",
      "text": "این ها مال چیزه، این ها رو بگیرید دارو خانه از بین هم، جشن، من اولین درگه درمیشون."
    },
    {
      "id": 1,
      "start": 10505.0,
      "end": 10506.0,
      "formatted_start": "02:55:05.000",
      "formatted_end": "02:55:06.000",
      "text": "این ها رو بگیرید درمیشون؟"
    },
    {
      "id": 2,
      "start": 10506.0,
      "end": 10509.0,
      "formatted_start": "02:55:06.000",
      "formatted_end": "02:55:09.000",
      "text": "بله، میخوانید به نیلو ترزه نزده وزیر بگیرید."
    },
    {
      "id": 3,
      "start": 10509.0,
      "end": 10513.0,
      "formatted_start": "02:55:09.000",
      "formatted_end": "02:55:13.000",
      "text": "نه، اونجا بذار، لبه نزده، اونور بذار، این لبه نیست، اینه بذار."
    },
    {
      "id": 4,
      "start": 10520.0,
      "end": 10523.0,
      "formatted_start": "02:55:20.000",
      "formatted_end": "02:55:23.000",
      "text": "چیانو بسیار خیلی نداره، هر طرف درزه ای بذاره."
    },
    {
      "id": 5,
      "start": 10523.0,
      "end": 10524.0,
      "formatted_start": "02:55:23.000",
      "formatted_end": "02:55:24.000",
      "text": "چیانو بسیار خیلی نداره، هر طرف درزه ای بذاره."
    },
    {
      "id": 6,
      "start": 10524.0,
      "end": 10527.14,
      "formatted_start": "02:55:24.000",
      "formatted_end": "02:55:27.140",
      "text": "این چهار کیلو دویز"
    },
    {
      "id": 7,
      "start": 10527.14,
      "end": 10528.04,
      "formatted_start": "02:55:27.140",
      "formatted_end": "02:55:28.040",
      "text": "چهار کیلو دویز"
    },
    {
      "id": 8,
      "start": 10528.04,
      "end": 10530.04,
      "formatted_start": "02:55:28.040",
      "formatted_end": "02:55:30.040",
      "text": "مرد باید بردارید"
    },
    {
      "id": 9,
      "start": 10530.04,
      "end": 10532.04,
      "formatted_start": "02:55:30.040",
      "formatted_end": "02:55:32.040",
      "text": "باید بردارید"
    },
    {
      "id": 10,
      "start": 10552.04,
      "end": 10554.04,
      "formatted_start": "02:55:52.040",
      "formatted_end": "02:55:54.040",
      "text": "جان؟"
    },
    {
      "id": 11,
      "start": 10554.04,
      "end": 10556.04,
      "formatted_start": "02:55:54.040",
      "formatted_end": "02:55:56.040",
      "text": "من بهتون میگرم"
    },
    {
      "id": 12,
      "start": 10556.04,
      "end": 10559.04,
      "formatted_start": "02:55:56.040",
      "formatted_end": "02:55:59.040",
      "text": "دیگرم نباشه من خودم دیگرم دیسی ساله در میرم"
    },
    {
      "id": 13,
      "start": 10569.04,
      "end": 10570.04,
      "formatted_start": "02:56:09.040",
      "formatted_end": "02:56:10.040",
      "text": "سلام خوشید"
    },
    {
      "id": 14,
      "start": 10570.04,
      "end": 10573.04,
      "formatted_start": "02:56:10.040",
      "formatted_end": "02:56:13.040",
      "text": "سلام خوشید شما خوبه سلامت بشید خوشید"
    },
    {
      "id": 15,
      "start": 10573.04,
      "end": 10578.04,
      "formatted_start": "02:56:13.040",
      "formatted_end": "02:56:18.040",
      "text": "خوشید برگتونو بگیرم کنم برگتونو بگیرم"
    },
    {
      "id": 16,
      "start": 10578.04,
      "end": 10584.04,
      "formatted_start": "02:56:18.040",
      "formatted_end": "02:56:24.040",
      "text": "بله مرسی خانوای براویی چی شده جانم؟"
    },
    {
      "id": 17,
      "start": 10584.04,
      "end": 10588.04,
      "formatted_start": "02:56:24.040",
      "formatted_end": "02:56:28.040",
      "text": "این اکزم های خشک میشه میخواره آره"
    },
    {
      "id": 18,
      "start": 10588.04,
      "end": 10590.04,
      "formatted_start": "02:56:28.040",
      "formatted_end": "02:56:30.040",
      "text": "بزنید اونجا"
    },
    {
      "id": 19,
      "start": 10594.04,
      "end": 10596.04,
      "formatted_start": "02:56:34.040",
      "formatted_end": "02:56:36.040",
      "text": "سنیت چه هست؟"
    },
    {
      "id": 20,
      "start": 10600.04,
      "end": 10602.04,
      "formatted_start": "02:56:40.040",
      "formatted_end": "02:56:42.040",
      "text": "از که اینجوری شده سرعتش؟"
    },
    {
      "id": 21,
      "start": 10604.04,
      "end": 10606.04,
      "formatted_start": "02:56:44.040",
      "formatted_end": "02:56:46.040",
      "text": "شیر مادر میخوره؟"
    },
    {
      "id": 22,
      "start": 10609.04,
      "end": 10611.04,
      "formatted_start": "02:56:49.040",
      "formatted_end": "02:56:51.040",
      "text": "آفرین بختر این گوهر"
    },
    {
      "id": 23,
      "start": 10614.04,
      "end": 10624.04,
      "formatted_start": "02:56:54.040",
      "formatted_end": "02:57:04.040",
      "text": "برد میخواد زیاد میشه و برد کم میشه"
    },
    {
      "id": 24,
      "start": 10624.04,
      "end": 10627.04,
      "formatted_start": "02:57:04.040",
      "formatted_end": "02:57:07.040",
      "text": "این ها یک نوع اکزمالی یک نوع احساسیتیه"
    },
    {
      "id": 25,
      "start": 10627.04,
      "end": 10633.04,
      "formatted_start": "02:57:07.040",
      "formatted_end": "02:57:13.040",
      "text": "خود غذایی گرمی نخورد مثل خورما، آجی، خود غذایی تشجیجا، این ها رو نخورد"
    },
    {
      "id": 26,
      "start": 10633.04,
      "end": 10634.04,
      "formatted_start": "02:57:13.040",
      "formatted_end": "02:57:14.040",
      "text": "تقنی مخمه"
    },
    {
      "id": 27,
      "start": 10634.04,
      "end": 10636.04,
      "formatted_start": "02:57:14.040",
      "formatted_end": "02:57:16.040",
      "text": "آره تقنی این ها نخورد"
    },
    {
      "id": 28,
      "start": 10636.04,
      "end": 10638.04,
      "formatted_start": "02:57:16.040",
      "formatted_end": "02:57:18.040",
      "text": "روز 500 تن بیشتر نخورد"
    },
    {
      "id": 29,
      "start": 10638.04,
      "end": 10640.04,
      "formatted_start": "02:57:18.040",
      "formatted_end": "02:57:20.040",
      "text": "روز 500 تن تقنی میخورد؟"
    },
    {
      "id": 30,
      "start": 10640.04,
      "end": 10641.04,
      "formatted_start": "02:57:20.040",
      "formatted_end": "02:57:21.040",
      "text": "پیشتر؟"
    },
    {
      "id": 31,
      "start": 10641.04,
      "end": 10642.04,
      "formatted_start": "02:57:21.040",
      "formatted_end": "02:57:22.040",
      "text": "500 تن بیشتر"
    },
    {
      "id": 32,
      "start": 10642.04,
      "end": 10644.04,
      "formatted_start": "02:57:22.040",
      "formatted_end": "02:57:24.040",
      "text": "500 پومت تقمه چجور می کنی؟"
    },
    {
      "id": 33,
      "start": 10644.04,
      "end": 10646.04,
      "formatted_start": "02:57:24.040",
      "formatted_end": "02:57:26.040",
      "text": "نه مغازه داری"
    },
    {
      "id": 34,
      "start": 10646.04,
      "end": 10648.04,
      "formatted_start": "02:57:26.040",
      "formatted_end": "02:57:28.040",
      "text": "مغازه هم دو تقمه چک چک چک"
    },
    {
      "id": 35,
      "start": 10648.04,
      "end": 10650.04,
      "formatted_start": "02:57:28.040",
      "formatted_end": "02:57:30.040",
      "text": "هایی کسه میاد تا این نام مشتری کنی؟"
    },
    {
      "id": 36,
      "start": 10650.04,
      "end": 10652.04,
      "formatted_start": "02:57:30.040",
      "formatted_end": "02:57:32.040",
      "text": "نه بروختیم"
    },
    {
      "id": 37,
      "start": 10652.04,
      "end": 10654.04,
      "formatted_start": "02:57:32.040",
      "formatted_end": "02:57:34.040",
      "text": "برای خودتون بروخونیم"
    },
    {
      "id": 38,
      "start": 10654.04,
      "end": 10656.04,
      "formatted_start": "02:57:34.040",
      "formatted_end": "02:57:36.040",
      "text": "خوب آیا برای این"
    },
    {
      "id": 39,
      "start": 10658.04,
      "end": 10660.04,
      "formatted_start": "02:57:38.040",
      "formatted_end": "02:57:40.040",
      "text": "این دو تا پومت میخواد"
    },
    {
      "id": 40,
      "start": 10660.04,
      "end": 10662.04,
      "formatted_start": "02:57:40.040",
      "formatted_end": "02:57:42.040",
      "text": "یه پومتش که اصلا"
    },
    {
      "id": 41,
      "start": 10662.04,
      "end": 10664.04,
      "formatted_start": "02:57:42.040",
      "formatted_end": "02:57:44.040",
      "text": "آزاده"
    },
    {
      "id": 42,
      "start": 10664.04,
      "end": 10666.04,
      "formatted_start": "02:57:44.040",
      "formatted_end": "02:57:46.040",
      "text": "یه پومتش قیمتی هم نداره"
    },
    {
      "id": 43,
      "start": 10666.04,
      "end": 10668.04,
      "formatted_start": "02:57:46.040",
      "formatted_end": "02:57:48.040",
      "text": "اون بینیم سنده ها"
    },
    {
      "id": 44,
      "start": 10668.04,
      "end": 10670.04,
      "formatted_start": "02:57:48.040",
      "formatted_end": "02:57:50.040",
      "text": "کلندورو بشن باشیم"
    },
    {
      "id": 45,
      "start": 10670.04,
      "end": 10679.04,
      "formatted_start": "02:57:50.040",
      "formatted_end": "02:57:59.040",
      "text": "سمیت این نرم کننده ی هر روز میزنی یه کمات دیگه هست این این"
    },
    {
      "id": 46,
      "start": 10679.04,
      "end": 10683.04,
      "formatted_start": "02:57:59.040",
      "formatted_end": "02:58:03.040",
      "text": "این این هر هشت"
    },
    {
      "id": 47,
      "start": 10683.04,
      "end": 10686.04,
      "formatted_start": "02:58:03.040",
      "formatted_end": "02:58:06.040",
      "text": "بر جا بر جا"
    },
    {
      "id": 48,
      "start": 10686.04,
      "end": 10692.04,
      "formatted_start": "02:58:06.040",
      "formatted_end": "02:58:12.040",
      "text": "بابت نداره بوشواره هاش دویست دو من الان"
    },
    {
      "id": 49,
      "start": 10692.04,
      "end": 10695.04,
      "formatted_start": "02:58:12.040",
      "formatted_end": "02:58:15.040",
      "text": "یه ست دوانده این خامسمی کم تر بگیر"
    },
    {
      "id": 50,
      "start": 10695.04,
      "end": 10697.04,
      "formatted_start": "02:58:15.040",
      "formatted_end": "02:58:17.040",
      "text": "میخوایید صورت کنید"
    },
    {
      "id": 51,
      "start": 10697.04,
      "end": 10699.04,
      "formatted_start": "02:58:17.040",
      "formatted_end": "02:58:19.040",
      "text": "بخش بشین"
    },
    {
      "id": 52,
      "start": 10699.04,
      "end": 10701.04,
      "formatted_start": "02:58:19.040",
      "formatted_end": "02:58:21.040",
      "text": "بخش بشین"
    },
    {
      "id": 53,
      "start": 10701.04,
      "end": 10703.04,
      "formatted_start": "02:58:21.040",
      "formatted_end": "02:58:23.040",
      "text": "بخش بشین"
    },
    {
      "id": 54,
      "start": 10703.04,
      "end": 10705.04,
      "formatted_start": "02:58:23.040",
      "formatted_end": "02:58:25.040",
      "text": "بخش بشین"
    },
    {
      "id": 55,
      "start": 10705.04,
      "end": 10707.04,
      "formatted_start": "02:58:25.040",
      "formatted_end": "02:58:27.040",
      "text": "بخش بشین"
    },
    {
      "id": 56,
      "start": 10707.04,
      "end": 10709.04,
      "formatted_start": "02:58:27.040",
      "formatted_end": "02:58:29.040",
      "text": "بخش بشین"
    },
    {
      "id": 57,
      "start": 10709.04,
      "end": 10711.04,
      "formatted_start": "02:58:29.040",
      "formatted_end": "02:58:31.040",
      "text": "بخش بشین"
    },
    {
      "id": 58,
      "start": 10711.04,
      "end": 10713.04,
      "formatted_start": "02:58:31.040",
      "formatted_end": "02:58:33.040",
      "text": "بخش بشین"
    },
    {
      "id": 59,
      "start": 10713.04,
      "end": 10715.04,
      "formatted_start": "02:58:33.040",
      "formatted_end": "02:58:35.040",
      "text": "بخش بشین"
    },
    {
      "id": 60,
      "start": 10715.04,
      "end": 10717.04,
      "formatted_start": "02:58:35.040",
      "formatted_end": "02:58:37.040",
      "text": "بخش بشین"
    },
    {
      "id": 61,
      "start": 10717.04,
      "end": 10719.04,
      "formatted_start": "02:58:37.040",
      "formatted_end": "02:58:39.040",
      "text": "بخش بشین"
    },
    {
      "id": 62,
      "start": 10719.04,
      "end": 10721.04,
      "formatted_start": "02:58:39.040",
      "formatted_end": "02:58:41.040",
      "text": "بخش بشین"
    },
    {
      "id": 63,
      "start": 10721.04,
      "end": 10723.04,
      "formatted_start": "02:58:41.040",
      "formatted_end": "02:58:43.040",
      "text": "بخش بشین"
    },
    {
      "id": 64,
      "start": 10723.04,
      "end": 10725.04,
      "formatted_start": "02:58:43.040",
      "formatted_end": "02:58:45.040",
      "text": "بخش بشین"
    },
    {
      "id": 65,
      "start": 10725.04,
      "end": 10728.04,
      "formatted_start": "02:58:45.040",
      "formatted_end": "02:58:48.040",
      "text": "اینجا آلیرژی هم باید چشم بزه شده"
    },
    {
      "id": 66,
      "start": 10728.04,
      "end": 10729.04,
      "formatted_start": "02:58:48.040",
      "formatted_end": "02:58:49.040",
      "text": "چطور؟"
    },
    {
      "id": 67,
      "start": 10729.04,
      "end": 10733.04,
      "formatted_start": "02:58:49.040",
      "formatted_end": "02:58:53.040",
      "text": "اماده ممکن است"
    },
    {
      "id": 68,
      "start": 10733.04,
      "end": 10735.04,
      "formatted_start": "02:58:53.040",
      "formatted_end": "02:58:55.040",
      "text": "اون رو بگیر بیا من درستم"
    },
    {
      "id": 69,
      "start": 10735.04,
      "end": 10736.04,
      "formatted_start": "02:58:55.040",
      "formatted_end": "02:58:56.040",
      "text": "بلا برای من بگیرم؟"
    },
    {
      "id": 70,
      "start": 10736.04,
      "end": 10737.04,
      "formatted_start": "02:58:56.040",
      "formatted_end": "02:58:57.040",
      "text": "آره بیا"
    },
    {
      "id": 71,
      "start": 10745.04,
      "end": 10748.04,
      "formatted_start": "02:59:05.040",
      "formatted_end": "02:59:08.040",
      "text": "کجا گذاره؟ اونها چرمی هست"
    },
    {
      "id": 72,
      "start": 10748.04,
      "end": 10749.04,
      "formatted_start": "02:59:08.040",
      "formatted_end": "02:59:09.040",
      "text": "خودشی؟"
    },
    {
      "id": 73,
      "start": 10749.04,
      "end": 10751.04,
      "formatted_start": "02:59:09.040",
      "formatted_end": "02:59:11.040",
      "text": "بله، اجره نداشت"
    },
    {
      "id": 74,
      "start": 10751.04,
      "end": 10752.04,
      "formatted_start": "02:59:11.040",
      "formatted_end": "02:59:12.040",
      "text": "دارم کم شد"
    },
    {
      "id": 75,
      "start": 10752.04,
      "end": 10753.04,
      "formatted_start": "02:59:12.040",
      "formatted_end": "02:59:13.040",
      "text": "کم شد؟"
    },
    {
      "id": 76,
      "start": 10753.04,
      "end": 10754.04,
      "formatted_start": "02:59:13.040",
      "formatted_end": "02:59:14.040",
      "text": "کم شد، اونها از بین میره"
    },
    {
      "id": 77,
      "start": 10754.04,
      "end": 10756.28,
      "formatted_start": "02:59:14.040",
      "formatted_end": "02:59:16.280",
      "text": "نه افونی نیست این ها چک"
    },
    {
      "id": 78,
      "start": 10756.28,
      "end": 10758.08,
      "formatted_start": "02:59:16.280",
      "formatted_end": "02:59:18.080",
      "text": "آبسایی چکی نیست ببینم"
    },
    {
      "id": 79,
      "start": 10758.08,
      "end": 10761.78,
      "formatted_start": "02:59:18.080",
      "formatted_end": "02:59:21.780",
      "text": "نه ویز ویز این ها مثلا"
    },
    {
      "id": 80,
      "start": 10761.78,
      "end": 10763.24,
      "formatted_start": "02:59:21.780",
      "formatted_end": "02:59:23.240",
      "text": "این جام همه در این"
    },
    {
      "id": 81,
      "start": 10763.24,
      "end": 10765.38,
      "formatted_start": "02:59:23.240",
      "formatted_end": "02:59:25.380",
      "text": "خیلی ویز هستن"
    },
    {
      "id": 82,
      "start": 10765.38,
      "end": 10766.38,
      "formatted_start": "02:59:25.380",
      "formatted_end": "02:59:26.380",
      "text": "نه مهم نیست"
    },
    {
      "id": 83,
      "start": 10766.38,
      "end": 10769.02,
      "formatted_start": "02:59:26.380",
      "formatted_end": "02:59:29.020",
      "text": "خدا باشیم"
    },
    {
      "id": 84,
      "start": 10769.02,
      "end": 10774.0,
      "formatted_start": "02:59:29.020",
      "formatted_end": "02:59:34.000",
      "text": "نه نه خیلی"
    },
    {
      "id": 85,
      "start": 10784.04,
      "end": 10800.04,
      "formatted_start": "02:59:44.040",
      "formatted_end": "03:00:00.040",
      "text": "موسیقی"
    }
  ],
