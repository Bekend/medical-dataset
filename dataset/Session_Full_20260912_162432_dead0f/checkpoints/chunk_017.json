  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5106.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:06.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 5130.0,
      "end": 5132.0,
      "formatted_start": "01:25:30.000",
      "formatted_end": "01:25:32.000",
      "text": "این برده رو بیسنیدید"
    },
    {
      "id": 2,
      "start": 5133.06,
      "end": 5134.06,
      "formatted_start": "01:25:33.060",
      "formatted_end": "01:25:34.060",
      "text": "دستگاه برده بودید؟"
    },
    {
      "id": 3,
      "start": 5134.06,
      "end": 5134.56,
      "formatted_start": "01:25:34.060",
      "formatted_end": "01:25:34.560",
      "text": "نه"
    },
    {
      "id": 4,
      "start": 5134.56,
      "end": 5136.56,
      "formatted_start": "01:25:34.560",
      "formatted_end": "01:25:36.560",
      "text": "دیده دستگاه بود کابیله؟"
    },
    {
      "id": 5,
      "start": 5136.56,
      "end": 5137.06,
      "formatted_start": "01:25:36.560",
      "formatted_end": "01:25:37.060",
      "text": "آره دیده"
    },
    {
      "id": 6,
      "start": 5137.06,
      "end": 5139.06,
      "formatted_start": "01:25:37.060",
      "formatted_end": "01:25:39.060",
      "text": "در اینجا که تو نسید بودشتید"
    },
    {
      "id": 7,
      "start": 5139.06,
      "end": 5141.06,
      "formatted_start": "01:25:39.060",
      "formatted_end": "01:25:41.060",
      "text": "خوبه"
    },
    {
      "id": 8,
      "start": 5143.06,
      "end": 5146.06,
      "formatted_start": "01:25:43.060",
      "formatted_end": "01:25:46.060",
      "text": "پردنم چون آخونش خوریدم دستگاه هم نداشته بوده"
    },
    {
      "id": 9,
      "start": 5146.06,
      "end": 5148.06,
      "formatted_start": "01:25:46.060",
      "formatted_end": "01:25:48.060",
      "text": "اوه چنین دستگاه رو پس سریع تر بیادی؟"
    },
    {
      "id": 10,
      "start": 5148.06,
      "end": 5149.06,
      "formatted_start": "01:25:48.060",
      "formatted_end": "01:25:49.060",
      "text": "آره"
    },
    {
      "id": 11,
      "start": 5152.06,
      "end": 5154.06,
      "formatted_start": "01:25:52.060",
      "formatted_end": "01:25:54.060",
      "text": "خوبه سفیده"
    },
    {
      "id": 12,
      "start": 5155.06,
      "end": 5157.06,
      "formatted_start": "01:25:55.060",
      "formatted_end": "01:25:57.060",
      "text": "صورتش کنشان سفیده"
    },
    {
      "id": 13,
      "start": 5157.06,
      "end": 5159.06,
      "formatted_start": "01:25:57.060",
      "formatted_end": "01:25:59.060",
      "text": "بدنشون سید"
    },
    {
      "id": 14,
      "start": 5159.06,
      "end": 5161.06,
      "formatted_start": "01:25:59.060",
      "formatted_end": "01:26:01.060",
      "text": "شده چند شب رو بشدی؟"
    },
    {
      "id": 15,
      "start": 5161.06,
      "end": 5163.06,
      "formatted_start": "01:26:01.060",
      "formatted_end": "01:26:03.060",
      "text": "سه شب"
    },
    {
      "id": 16,
      "start": 5163.06,
      "end": 5165.06,
      "formatted_start": "01:26:03.060",
      "formatted_end": "01:26:05.060",
      "text": "عالیه"
    },
    {
      "id": 17,
      "start": 5165.06,
      "end": 5167.06,
      "formatted_start": "01:26:05.060",
      "formatted_end": "01:26:07.060",
      "text": "این ۹۰ درصد خوب شد"
    },
    {
      "id": 18,
      "start": 5167.06,
      "end": 5169.06,
      "formatted_start": "01:26:07.060",
      "formatted_end": "01:26:09.060",
      "text": "برس هم داده بودن"
    },
    {
      "id": 19,
      "start": 5169.06,
      "end": 5171.06,
      "formatted_start": "01:26:09.060",
      "formatted_end": "01:26:11.060",
      "text": "برسشون یکم"
    },
    {
      "id": 20,
      "start": 5171.06,
      "end": 5173.06,
      "formatted_start": "01:26:11.060",
      "formatted_end": "01:26:13.060",
      "text": "درست داریم"
    },
    {
      "id": 21,
      "start": 5173.06,
      "end": 5175.06,
      "formatted_start": "01:26:13.060",
      "formatted_end": "01:26:15.060",
      "text": "این ها شب هم شب شر کار می کنه"
    },
    {
      "id": 22,
      "start": 5175.06,
      "end": 5177.06,
      "formatted_start": "01:26:15.060",
      "formatted_end": "01:26:17.060",
      "text": "مثل آبکی"
    },
    {
      "id": 23,
      "start": 5177.06,
      "end": 5179.06,
      "formatted_start": "01:26:17.060",
      "formatted_end": "01:26:19.060",
      "text": "روز شکل خوره غربی کار می کنه"
    },
    {
      "id": 24,
      "start": 5179.06,
      "end": 5181.06,
      "formatted_start": "01:26:19.060",
      "formatted_end": "01:26:21.060",
      "text": "مخصوصا زیر"
    },
    {
      "id": 25,
      "start": 5181.06,
      "end": 5183.06,
      "formatted_start": "01:26:21.060",
      "formatted_end": "01:26:23.060",
      "text": "نه سبز نشبه ها"
    },
    {
      "id": 26,
      "start": 5183.06,
      "end": 5185.06,
      "formatted_start": "01:26:23.060",
      "formatted_end": "01:26:25.060",
      "text": "می دهیم نداره خانم"
    },
    {
      "id": 27,
      "start": 5185.06,
      "end": 5188.36,
      "formatted_start": "01:26:25.060",
      "formatted_end": "01:26:28.360",
      "text": "این هم زیر دستگاه که هستند یکمشون رو بیتن کنند"
    },
    {
      "id": 28,
      "start": 5188.36,
      "end": 5191.06,
      "formatted_start": "01:26:28.360",
      "formatted_end": "01:26:31.060",
      "text": "چون شیوپش بیدادادی میتونید درگان نساخته بره"
    },
    {
      "id": 29,
      "start": 5191.06,
      "end": 5193.06,
      "formatted_start": "01:26:31.060",
      "formatted_end": "01:26:33.060",
      "text": "نه، اصلا همینه، دور بشنند"
    },
