    {
      "id": 4,
      "start": 13020.0,
      "end": 13042.0,
      "formatted_start": "03:37:00.000",
      "formatted_end": "03:37:22.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 13050.0,
      "end": 13063.0,
      "formatted_start": "03:37:30.000",
      "formatted_end": "03:37:43.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 13080.0,
      "end": 13082.0,
      "formatted_start": "03:38:00.000",
      "formatted_end": "03:38:02.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 13110.0,
      "end": 13112.62,
      "formatted_start": "03:38:30.000",
      "formatted_end": "03:38:32.620",
      "text": "و همراه مورس سرافیلک میتونید استفاده کنید"
    },
    {
      "id": 8,
      "start": 13112.62,
      "end": 13116.24,
      "formatted_start": "03:38:32.620",
      "formatted_end": "03:38:36.240",
      "text": "برای شکار همگول مگرسی نیوی پیشترانه"
    },
    {
      "id": 9,
      "start": 13116.24,
      "end": 13121.06,
      "formatted_start": "03:38:36.240",
      "formatted_end": "03:38:41.060",
      "text": "میتونید دست سموم مثل کارتزام، جوپیتر، مالاتیوم، دیکونرو،"
    },
    {
      "id": 10,
      "start": 13121.06,
      "end": 13124.56,
      "formatted_start": "03:38:41.060",
      "formatted_end": "03:38:44.560",
      "text": "و کروتین نیترولیزاد به صنعت تومه پاشی استفاده کنید"
    },
    {
      "id": 11,
      "start": 13124.56,
      "end": 13139.0,
      "formatted_start": "03:38:44.560",
      "formatted_end": "03:38:59.000",
      "text": "راستی رعایت دوره کارنز برای حفظ سلامت محصول رو حتماً منده داشته باشید"
    },
    {
      "id": 12,
      "start": 13139.0,
      "end": 13142.44,
      "formatted_start": "03:38:59.000",
      "formatted_end": "03:39:02.440",
      "text": "برای معابله و مبارزه با مگسی دیوهی مدیترانه"
    },
    {
      "id": 13,
      "start": 13142.44,
      "end": 13145.0,
      "formatted_start": "03:39:02.440",
      "formatted_end": "03:39:05.000",
      "text": "و تأییر محصولاتی که فرماندون مارک بیشتر"
    },
    {
      "id": 14,
      "start": 13145.0,
      "end": 13147.08,
      "formatted_start": "03:39:05.000",
      "formatted_end": "03:39:07.080",
      "text": "همینمان کلمه مبارزه رو براموند"
    },
    {
      "id": 15,
      "start": 13169.0,
      "end": 13198.98,
      "formatted_start": "03:39:29.000",
      "formatted_end": "03:39:58.980",
      "text": "موسیقی در موسیقی"
    },
    {
