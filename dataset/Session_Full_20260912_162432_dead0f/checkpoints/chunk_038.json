      "formatted_start": "03:12:32.000",
      "formatted_end": "03:12:34.000",
      "text": "این که چیزی هست شما بهت میگم که کار دارید"
    },
    {
      "id": 34,
      "start": 11554.0,
      "end": 11557.0,
      "formatted_start": "03:12:34.000",
      "formatted_end": "03:12:37.000",
      "text": "این گاز هم که مال گوششه"
    },
    {
      "id": 35,
      "start": 11557.0,
      "end": 11559.0,
      "formatted_start": "03:12:37.000",
      "formatted_end": "03:12:39.000",
      "text": "این کیقه هم مال گوششه"
    },
    {
      "id": 36,
      "start": 11559.0,
      "end": 11560.0,
      "formatted_start": "03:12:39.000",
      "formatted_end": "03:12:40.000",
      "text": "باید می کنید باید بردید اینا"
    },
    {
      "id": 37,
      "start": 11560.0,
      "end": 11562.0,
      "formatted_start": "03:12:40.000",
      "formatted_end": "03:12:42.000",
      "text": "همین دیگه"
    },
    {
      "id": 38,
      "start": 11562.0,
      "end": 11563.0,
      "formatted_start": "03:12:42.000",
      "formatted_end": "03:12:43.000",
      "text": "خب؟"
    },
    {
      "id": 39,
      "start": 11563.0,
      "end": 11565.0,
      "formatted_start": "03:12:43.000",
      "formatted_end": "03:12:45.000",
      "text": "خوشنرده هم کمان روز دیده رو بهش بدم"
    },
    {
      "id": 40,
      "start": 11565.0,
      "end": 11567.0,
      "formatted_start": "03:12:45.000",
      "formatted_end": "03:12:47.000",
      "text": "بابرش سر بابر مردم"
    },
    {
      "id": 41,
      "start": 11567.0,
      "end": 11569.0,
      "formatted_start": "03:12:47.000",
      "formatted_end": "03:12:49.000",
      "text": "بر شیشه رو آتونیم 24 ساعت کار نیست"
    },
    {
      "id": 42,
      "start": 11569.0,
      "end": 11571.0,
      "formatted_start": "03:12:49.000",
      "formatted_end": "03:12:51.000",
      "text": "این شیاخ مثلا این بروز بجا"
    },
    {
      "id": 43,
      "start": 11573.0,
      "end": 11575.0,
      "formatted_start": "03:12:53.000",
      "formatted_end": "03:12:55.000",
      "text": "های سایی شما اون پشت رو"
    },
    {
      "id": 44,
      "start": 11575.0,
      "end": 11577.0,
      "formatted_start": "03:12:55.000",
      "formatted_end": "03:12:57.000",
      "text": "این در هم ببن شما بیرون بشین"
    },
    {
      "id": 45,
      "start": 11577.0,
      "end": 11579.0,
      "formatted_start": "03:12:57.000",
      "formatted_end": "03:12:59.000",
      "text": "در هم باکم ببین"
    },
    {
      "id": 46,
      "start": 11579.0,
      "end": 11583.0,
      "formatted_start": "03:12:59.000",
      "formatted_end": "03:13:03.000",
      "text": "این یادم دلانه انتخاب شده"
    },
    {
      "id": 47,
      "start": 11583.0,
      "end": 11585.0,
      "formatted_start": "03:13:03.000",
      "formatted_end": "03:13:05.000",
      "text": "چرا؟ من دل ندارم"
    },
    {
      "id": 48,
      "start": 11585.0,
      "end": 11587.0,
      "formatted_start": "03:13:05.000",
      "formatted_end": "03:13:07.000",
      "text": "هشت کدام عشق ندارم"
    },
    {
      "id": 49,
      "start": 11587.0,
      "end": 11589.0,
      "formatted_start": "03:13:07.000",
      "formatted_end": "03:13:09.000",
      "text": "مادر دل ندارم"
    },
    {
      "id": 50,
      "start": 11589.0,
      "end": 11591.0,
      "formatted_start": "03:13:09.000",
      "formatted_end": "03:13:11.000",
      "text": "اصلا نگاه نکن چشمات رو ببین"
    },
    {
      "id": 51,
      "start": 11591.0,
      "end": 11593.0,
      "formatted_start": "03:13:11.000",
      "formatted_end": "03:13:13.000",
      "text": "باید برکش بوده این سر کن من"
    },
    {
      "id": 52,
      "start": 11593.0,
      "end": 11595.0,
      "formatted_start": "03:13:13.000",
      "formatted_end": "03:13:15.000",
      "text": "جوبسته"
    },
    {
      "id": 53,
      "start": 11595.0,
      "end": 11597.0,
      "formatted_start": "03:13:15.000",
      "formatted_end": "03:13:17.000",
      "text": "جا"
    },
    {
      "id": 54,
      "start": 11597.0,
      "end": 11599.0,
      "formatted_start": "03:13:17.000",
      "formatted_end": "03:13:19.000",
      "text": "جانمو"
    },
    {
      "id": 55,
      "start": 11603.0,
      "end": 11605.0,
      "formatted_start": "03:13:23.000",
      "formatted_end": "03:13:25.000",
      "text": "چون"
    },
    {
      "id": 56,
      "start": 11605.0,
      "end": 11607.0,
      "formatted_start": "03:13:25.000",
      "formatted_end": "03:13:27.000",
      "text": "باید بقیهشون باز باید بینده کشید"
    },
    {
      "id": 57,
      "start": 11607.0,
      "end": 11609.0,
      "formatted_start": "03:13:27.000",
      "formatted_end": "03:13:29.000",
      "text": "من برمی آمده"
    },
    {
      "id": 58,
      "start": 11609.0,
      "end": 11611.0,
      "formatted_start": "03:13:29.000",
      "formatted_end": "03:13:31.000",
      "text": "دو روز دیگه میاریم من میبینم"
    },
    {
      "id": 59,
      "start": 11611.0,
      "end": 11613.0,
      "formatted_start": "03:13:31.000",
      "formatted_end": "03:13:33.000",
      "text": "بابش من دو روز دیگه بیم"
    },
    {
      "id": 60,
      "start": 11613.0,
      "end": 11615.0,
      "formatted_start": "03:13:33.000",
      "formatted_end": "03:13:35.000",
      "text": "باید بندنیم"
    },
    {
      "id": 61,
      "start": 11615.0,
      "end": 11617.0,
      "formatted_start": "03:13:35.000",
      "formatted_end": "03:13:37.000",
      "text": "چوب"
    },
    {
      "id": 62,
      "start": 11619.0,
      "end": 11621.0,
      "formatted_start": "03:13:39.000",
      "formatted_end": "03:13:41.000",
      "text": "چوب"
    },
    {
      "id": 63,
      "start": 11621.0,
      "end": 11623.0,
      "formatted_start": "03:13:41.000",
      "formatted_end": "03:13:43.000",
      "text": "چرا؟"
    },
    {
      "id": 64,
      "start": 11625.0,
      "end": 11627.0,
      "formatted_start": "03:13:45.000",
      "formatted_end": "03:13:47.000",
      "text": "این رو باز جلتر برمی داشتید"
    },
    {
      "id": 65,
      "start": 11627.0,
      "end": 11629.0,
      "formatted_start": "03:13:47.000",
      "formatted_end": "03:13:49.000",
      "text": "درسته"
    },
    {
      "id": 66,
      "start": 11629.0,
      "end": 11631.0,
      "formatted_start": "03:13:49.000",
      "formatted_end": "03:13:51.000",
      "text": "ادخالت کردن"
    },
    {
      "id": 67,
      "start": 11647.0,
      "end": 11649.0,
      "formatted_start": "03:14:07.000",
      "formatted_end": "03:14:09.000",
      "text": "پی ایس نمیشه؟"
    },
    {
      "id": 68,
      "start": 11649.0,
      "end": 11678.98,
      "formatted_start": "03:14:09.000",
      "formatted_end": "03:14:38.980",
      "text": "این کاری که شما می کنید این کاری که این را دستاشو باید نگهدار کنید"
    },
    {
      "id": 69,
      "start": 11679.0,
      "end": 11680.0,
      "formatted_start": "03:14:39.000",
      "formatted_end": "03:14:40.000",
      "text": "پاشه دیگه نه؟"
    },
    {
      "id": 70,
      "start": 11680.0,
      "end": 11684.46,
      "formatted_start": "03:14:40.000",
      "formatted_end": "03:14:44.460",
      "text": "آره، تو راحت هم این وقت با من کسان نداری که حالت برمیده"
    },
    {
      "id": 71,
      "start": 11684.46,
      "end": 11685.96,
      "formatted_start": "03:14:44.460",
      "formatted_end": "03:14:45.960",
      "text": "کجا دستیشو نگرده دار؟"
    },
    {
      "id": 72,
      "start": 11685.96,
      "end": 11687.4,
      "formatted_start": "03:14:45.960",
      "formatted_end": "03:14:47.400",
      "text": "کاری نیستی"
    },
    {
      "id": 73,
      "start": 11687.4,
      "end": 11691.6,
      "formatted_start": "03:14:47.400",
      "formatted_end": "03:14:51.600",
      "text": "بچه هر پسنک هم عدم نمیخوره، بی خود چیز نکنی، دستاش هم نگرده دار"
    },
    {
      "id": 74,
      "start": 11691.6,
      "end": 11695.86,
      "formatted_start": "03:14:51.600",
      "formatted_end": "03:14:55.860",
      "text": "تو فقط دستا، دوتا دست بگو نیم، با اون دست دیگه دستا شدیم"
    },
    {
      "id": 75,
      "start": 11695.86,
      "end": 11696.8,
      "formatted_start": "03:14:55.860",
      "formatted_end": "03:14:56.800",
      "text": "متعیش شدیم؟"
    },
    {
      "id": 76,
      "start": 11696.8,
      "end": 11697.5,
      "formatted_start": "03:14:56.800",
      "formatted_end": "03:14:57.500",
      "text": "آهان"
    },
    {
      "id": 77,
      "start": 11697.5,
      "end": 11699.6,
      "formatted_start": "03:14:57.500",
      "formatted_end": "03:14:59.600",
      "text": "خیلی، هیچ نگران نباش"
    },
    {
      "id": 78,
      "start": 11699.6,
      "end": 11700.0,
      "formatted_start": "03:14:59.600",
      "formatted_end": "03:15:00.000",
      "text": "از اینو"
    }
  ],
  "status": "completed"
}