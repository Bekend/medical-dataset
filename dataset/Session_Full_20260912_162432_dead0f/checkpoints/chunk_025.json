      "end": 7514.04,
      "formatted_start": "02:05:12.000",
      "formatted_end": "02:05:14.040",
      "text": "خامسامی 600 حساب کنیم براش"
    },
    {
      "id": 4,
      "start": 7514.04,
      "end": 7518.88,
      "formatted_start": "02:05:14.040",
      "formatted_end": "02:05:18.880",
      "text": "بعد خامسامی در اول چهارتای بیمارستان جدا کن و اونا حواست باشه"
    },
    {
      "id": 5,
      "start": 7518.88,
      "end": 7520.88,
      "formatted_start": "02:05:18.880",
      "formatted_end": "02:05:20.880",
      "text": "چطور نوم بود؟"
    },
    {
      "id": 6,
      "start": 7533.88,
      "end": 7534.88,
      "formatted_start": "02:05:33.880",
      "formatted_end": "02:05:34.880",
      "text": "بفرمایی"
    },
    {
      "id": 7,
      "start": 7534.88,
      "end": 7535.88,
      "formatted_start": "02:05:34.880",
      "formatted_end": "02:05:35.880",
      "text": "سلام"
    },
    {
      "id": 8,
      "start": 7535.88,
      "end": 7536.88,
      "formatted_start": "02:05:35.880",
      "formatted_end": "02:05:36.880",
      "text": "سلام بابایی جان سلامت باشی"
    },
    {
      "id": 9,
      "start": 7536.88,
      "end": 7539.88,
      "formatted_start": "02:05:36.880",
      "formatted_end": "02:05:39.880",
      "text": "این اقایت رو روز چارشنبه افراد نمی گرد باشه"
    },
    {
      "id": 10,
      "start": 7539.88,
      "end": 7540.88,
      "formatted_start": "02:05:39.880",
      "formatted_end": "02:05:40.880",
      "text": "بله"
    },
    {
      "id": 11,
      "start": 7540.88,
      "end": 7542.88,
      "formatted_start": "02:05:40.880",
      "formatted_end": "02:05:42.880",
      "text": "دوباره بیارید نشده اید دوباره برده"
    },
    {
      "id": 12,
      "start": 7542.88,
      "end": 7543.88,
      "formatted_start": "02:05:42.880",
      "formatted_end": "02:05:43.880",
      "text": "چارشنبه چی بود مشکله شد؟"
    },
    {
      "id": 13,
      "start": 7543.88,
      "end": 7544.88,
      "formatted_start": "02:05:43.880",
      "formatted_end": "02:05:44.880",
      "text": "سما خورده بود دیگه"
    },
    {
      "id": 14,
      "start": 7544.88,
      "end": 7546.88,
      "formatted_start": "02:05:44.880",
      "formatted_end": "02:05:46.880",
      "text": "خب چه مشکل؟ نه ببین"
    },
    {
      "id": 15,
      "start": 7546.88,
      "end": 7550.34,
      "formatted_start": "02:05:46.880",
      "formatted_end": "02:05:50.340",
      "text": "نه یا نه اول صحبت بگو چی بوده؟"
    },
    {
      "id": 16,
      "start": 7550.34,
      "end": 7551.34,
      "formatted_start": "02:05:50.340",
      "formatted_end": "02:05:51.340",
      "text": "سرما برده بود"
    },
    {
      "id": 17,
      "start": 7551.34,
      "end": 7552.34,
      "formatted_start": "02:05:51.340",
      "formatted_end": "02:05:52.340",
      "text": "چی مشکل داشته؟"
    },
    {
      "id": 18,
      "start": 7552.34,
      "end": 7554.34,
      "formatted_start": "02:05:52.340",
      "formatted_end": "02:05:54.340",
      "text": "سرما برده بود صرفه میدهد"
    },
    {
      "id": 19,
      "start": 7554.34,
      "end": 7555.34,
      "formatted_start": "02:05:54.340",
      "formatted_end": "02:05:55.340",
      "text": "تب هم داشته بود؟"
    },
    {
      "id": 20,
      "start": 7555.34,
      "end": 7556.34,
      "formatted_start": "02:05:55.340",
      "formatted_end": "02:05:56.340",
      "text": "تب نداشته"
    },
    {
      "id": 21,
      "start": 7556.34,
      "end": 7557.34,
      "formatted_start": "02:05:56.340",
      "formatted_end": "02:05:57.340",
      "text": "برد صرفه میدهد؟"
    },
    {
      "id": 22,
      "start": 7557.34,
      "end": 7558.34,
      "formatted_start": "02:05:57.340",
      "formatted_end": "02:05:58.340",
      "text": "آره"
    },
    {
      "id": 23,
      "start": 7558.34,
      "end": 7559.34,
      "formatted_start": "02:05:58.340",
      "formatted_end": "02:05:59.340",
      "text": "صرفه های زیاد بود یا کم؟"
    },
    {
      "id": 24,
      "start": 7559.34,
      "end": 7560.34,
      "formatted_start": "02:05:59.340",
      "formatted_end": "02:06:00.340",
      "text": "زیاد بود بگفت داریم"
    },
    {
      "id": 25,
      "start": 7560.34,
      "end": 7562.34,
      "formatted_start": "02:06:00.340",
      "formatted_end": "02:06:02.340",
      "text": "خب الان صرفه های چجوری بود؟"
    },
    {
      "id": 26,
      "start": 7562.34,
      "end": 7567.34,
      "formatted_start": "02:06:02.340",
      "formatted_end": "02:06:07.340",
      "text": "الان صرفه میکنه که چی اینجا چی اینجا از پرید"
    },
    {
      "id": 27,
      "start": 7567.34,
      "end": 7570.34,
      "formatted_start": "02:06:07.340",
      "formatted_end": "02:06:10.340",
      "text": "نه اون فرق داره اون ضربه خورده یا آز شده"
    },
    {
      "id": 28,
      "start": 7570.34,
      "end": 7572.34,
      "formatted_start": "02:06:10.340",
      "formatted_end": "02:06:12.340",
      "text": "نه از آب دمه خوب"
    },
    {
      "id": 29,
      "start": 7572.34,
      "end": 7574.34,
      "formatted_start": "02:06:12.340",
      "formatted_end": "02:06:14.340",
      "text": "آب کشیده از اینجا چه شده ازیاد شده"
    },
    {
      "id": 30,
      "start": 7574.34,
      "end": 7576.34,
      "formatted_start": "02:06:14.340",
      "formatted_end": "02:06:16.340",
      "text": "مردم برم"
    },
    {
      "id": 31,
      "start": 7576.34,
      "end": 7578.34,
      "formatted_start": "02:06:16.340",
      "formatted_end": "02:06:18.340",
      "text": "الان صرفات زیاد یا کم هموجود؟"
    },
    {
      "id": 32,
      "start": 7578.34,
      "end": 7580.34,
      "formatted_start": "02:06:18.340",
      "formatted_end": "02:06:20.340",
      "text": "نه صرفات هسته اینجا شده"
    },
    {
      "id": 33,
      "start": 7580.34,
      "end": 7582.34,
      "formatted_start": "02:06:20.340",
      "formatted_end": "02:06:22.340",
      "text": "نه خالما شب کن"
    },
    {
      "id": 34,
      "start": 7582.34,
      "end": 7584.34,
      "formatted_start": "02:06:22.340",
      "formatted_end": "02:06:24.340",
      "text": "یه دقیقه شب کن"
    },
    {
      "id": 35,
      "start": 7584.34,
      "end": 7586.34,
      "formatted_start": "02:06:24.340",
      "formatted_end": "02:06:26.340",
      "text": "بگویید قریب بگویید"
    },
    {
      "id": 36,
      "start": 7586.34,
      "end": 7588.34,
      "formatted_start": "02:06:26.340",
      "formatted_end": "02:06:28.340",
      "text": "من میخوام میگم اگر"
    },
    {
      "id": 37,
      "start": 7588.34,
      "end": 7590.34,
      "formatted_start": "02:06:28.340",
      "formatted_end": "02:06:30.340",
      "text": "چارشنبه ده تا صرفه میزده"
    },
    {
      "id": 38,
      "start": 7590.34,
      "end": 7592.34,
      "formatted_start": "02:06:30.340",
      "formatted_end": "02:06:32.340",
      "text": "الان ده تا میزنی که دروش قدیل کنه"
    },
    {
      "id": 39,
      "start": 7592.34,
      "end": 7594.34,
      "formatted_start": "02:06:32.340",
      "formatted_end": "02:06:34.340",
      "text": "یا الان ده تا میزده"
    },
    {
      "id": 40,
      "start": 7594.34,
      "end": 7596.34,
      "formatted_start": "02:06:34.340",
      "formatted_end": "02:06:36.340",
      "text": "الان خنج تا شده"
    },
    {
      "id": 41,
      "start": 7596.34,
      "end": 7598.34,
      "formatted_start": "02:06:36.340",
      "formatted_end": "02:06:38.340",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 7598.34,
      "end": 7600.34,
      "formatted_start": "02:06:38.340",
      "formatted_end": "02:06:40.340",
      "text": "درده هسته کمتر نشده"
    },
    {
      "id": 43,
      "start": 7600.34,
      "end": 7601.34,
      "formatted_start": "02:06:40.340",
      "formatted_end": "02:06:41.340",
      "text": "خب تمام"
    },
    {
      "id": 44,
      "start": 7601.34,
      "end": 7602.34,
      "formatted_start": "02:06:41.340",
      "formatted_end": "02:06:42.340",
      "text": "خب حالا بعدا نشونی شو"
    },
    {
      "id": 45,
      "start": 7602.34,
      "end": 7604.34,
      "formatted_start": "02:06:42.340",
      "formatted_end": "02:06:44.340",
      "text": "اینجا شده روشی داده"
    },
    {
      "id": 46,
      "start": 7611.34,
      "end": 7613.34,
      "formatted_start": "02:06:51.340",
      "formatted_end": "02:06:53.340",
      "text": "اینجاش اینجا شده"
    },
    {
      "id": 47,
      "start": 7613.34,
      "end": 7614.34,
      "formatted_start": "02:06:53.340",
      "formatted_end": "02:06:54.340",
      "text": "اونو گذیدگیه"
    },
    {
      "id": 48,
      "start": 7614.34,
      "end": 7616.34,
      "formatted_start": "02:06:54.340",
      "formatted_end": "02:06:56.340",
      "text": "نه اینجا اینجا است جواب داده"
    },
    {
      "id": 49,
      "start": 7616.34,
      "end": 7618.34,
      "formatted_start": "02:06:56.340",
      "formatted_end": "02:06:58.340",
      "text": "خب گذیدگیه اینجا خواهر من"
    },
    {
      "id": 50,
      "start": 7618.34,
      "end": 7619.34,
      "formatted_start": "02:06:58.340",
      "formatted_end": "02:06:59.340",
      "text": "یعنی چی؟"
    },
    {
      "id": 51,
      "start": 7619.34,
      "end": 7620.34,
      "formatted_start": "02:06:59.340",
      "formatted_end": "02:07:00.340",
      "text": "یعنی این چه هشره زده"
    },
    {
      "id": 52,
      "start": 7620.34,
      "end": 7621.34,
      "formatted_start": "02:07:00.340",
      "formatted_end": "02:07:01.340",
      "text": "اینجا"
    },
    {
      "id": 53,
      "start": 7621.34,
      "end": 7622.34,
      "formatted_start": "02:07:01.340",
      "formatted_end": "02:07:02.340",
      "text": "اینجا شده خورده"
    },
    {
      "id": 54,
      "start": 7622.34,
      "end": 7624.34,
      "formatted_start": "02:07:02.340",
      "formatted_end": "02:07:04.340",
      "text": "خب همه خورده اینجا همه"
    },
    {
      "id": 55,
      "start": 7624.34,
      "end": 7625.34,
      "formatted_start": "02:07:04.340",
      "formatted_end": "02:07:05.340",
      "text": "گذیدگیه"
    },
    {
      "id": 56,
      "start": 7625.34,
      "end": 7626.34,
      "formatted_start": "02:07:05.340",
      "formatted_end": "02:07:06.340",
      "text": "به اینجا"
    },
    {
      "id": 57,
      "start": 7626.34,
      "end": 7630.34,
      "formatted_start": "02:07:06.340",
      "formatted_end": "02:07:10.340",
      "text": "این ارتباطی به صورت پیشنا نداره"
    },
    {
      "id": 58,
      "start": 7630.34,
      "end": 7632.34,
      "formatted_start": "02:07:10.340",
      "formatted_end": "02:07:12.340",
      "text": "ببین این ها گزشه میشه"
    },
    {
      "id": 59,
      "start": 7632.34,
      "end": 7634.34,
      "formatted_start": "02:07:12.340",
      "formatted_end": "02:07:14.340",
      "text": "چشم جز داره ماده"
    },
    {
      "id": 60,
      "start": 7634.34,
      "end": 7636.34,
      "formatted_start": "02:07:14.340",
      "formatted_end": "02:07:16.340",
      "text": "ببین این ها یک جاهایی رو زده"
    },
    {
      "id": 61,
      "start": 7636.34,
      "end": 7638.34,
      "formatted_start": "02:07:16.340",
      "formatted_end": "02:07:18.340",
      "text": "جایی نیشه شو میبینین"
    },
    {
      "id": 62,
      "start": 7638.34,
      "end": 7640.34,
      "formatted_start": "02:07:18.340",
      "formatted_end": "02:07:20.340",
      "text": "این سیاهی رو میبینین"
    },
    {
      "id": 63,
      "start": 7640.34,
      "end": 7642.34,
      "formatted_start": "02:07:20.340",
      "formatted_end": "02:07:22.340",
      "text": "جایی نیشه هشره"
    },
    {
      "id": 64,
      "start": 7642.34,
      "end": 7644.34,
      "formatted_start": "02:07:22.340",
      "formatted_end": "02:07:24.340",
      "text": "یک جایی اومده تخت تخت تخت زده رفته"
    },
    {
      "id": 65,
      "start": 7644.34,
      "end": 7646.34,
      "formatted_start": "02:07:24.340",
      "formatted_end": "02:07:26.340",
      "text": "شاید اینجا رو هم زده شو"
    },
    {
      "id": 66,
      "start": 7646.34,
      "end": 7648.34,
      "formatted_start": "02:07:26.340",
      "formatted_end": "02:07:28.340",
      "text": "اونجاش هم زده"
    },
    {
      "id": 67,
      "start": 7648.34,
      "end": 7650.34,
      "formatted_start": "02:07:28.340",
      "formatted_end": "02:07:30.340",
      "text": "جایی نیشه میبینین همه گزشه"
    },
    {
      "id": 68,
      "start": 7650.34,
      "end": 7652.34,
      "formatted_start": "02:07:30.340",
      "formatted_end": "02:07:32.340",
      "text": "همه یک جا"
    },
    {
      "id": 69,
      "start": 7652.34,
      "end": 7654.34,
      "formatted_start": "02:07:32.340",
      "formatted_end": "02:07:34.340",
      "text": "حتی دماهاش هم گزشه دیکی هست"
    },
    {
      "id": 70,
      "start": 7654.34,
      "end": 7655.34,
      "formatted_start": "02:07:34.340",
      "formatted_end": "02:07:35.340",
      "text": "حالا این چی خواهد بازم؟"
    },
    {
      "id": 71,
      "start": 7655.34,
      "end": 7656.34,
      "formatted_start": "02:07:35.340",
      "formatted_end": "02:07:36.340",
      "text": "دارو میدیم دیگه نه دیگه"
    },
    {
      "id": 72,
      "start": 7656.34,
      "end": 7660.34,
      "formatted_start": "02:07:36.340",
      "formatted_end": "02:07:40.340",
      "text": "خدا بزار من گروه سینه شما ببینم که میگید خوب نشده"
    },
    {
      "id": 73,
      "start": 7661.34,
      "end": 7663.34,
      "formatted_start": "02:07:41.340",
      "formatted_end": "02:07:43.340",
      "text": "این هنگو که اینجا آمد صرفه زد پیش من دیگه"
    },
    {
      "id": 74,
      "start": 7663.34,
      "end": 7664.34,
      "formatted_start": "02:07:43.340",
      "formatted_end": "02:07:44.340",
      "text": "آره"
    },
    {
      "id": 75,
      "start": 7664.34,
      "end": 7666.34,
      "formatted_start": "02:07:44.340",
      "formatted_end": "02:07:46.340",
      "text": "گفت که حرکت میکنه صرفه میزنه"
    },
    {
      "id": 76,
      "start": 7666.34,
      "end": 7667.34,
      "formatted_start": "02:07:46.340",
      "formatted_end": "02:07:47.340",
      "text": "آره آره"
    },
    {
      "id": 77,
      "start": 7667.34,
      "end": 7670.34,
      "formatted_start": "02:07:47.340",
      "formatted_end": "02:07:50.340",
      "text": "او اصلا از اینجا پاشت صرفه ها رو شروع کرد"
    },
    {
      "id": 78,
      "start": 7670.34,
      "end": 7672.34,
      "formatted_start": "02:07:50.340",
      "formatted_end": "02:07:52.340",
      "text": "گفتی راه میده صرفه میزنه"
    },
    {
      "id": 79,
      "start": 7672.34,
      "end": 7673.34,
      "formatted_start": "02:07:52.340",
      "formatted_end": "02:07:53.340",
      "text": "نه اونجوره نه دیگه آخو"
    },
    {
      "id": 80,
      "start": 7673.34,
      "end": 7674.34,
      "formatted_start": "02:07:53.340",
      "formatted_end": "02:07:54.340",
      "text": "اون خوب شده"
    },
    {
      "id": 81,
      "start": 7674.34,
      "end": 7676.34,
      "formatted_start": "02:07:54.340",
      "formatted_end": "02:07:56.340",
      "text": "اون روز درده راه میزنه"
    },
    {
      "id": 82,
      "start": 7676.34,
      "end": 7678.34,
      "formatted_start": "02:07:56.340",
      "formatted_end": "02:07:58.340",
      "text": "اونقدر یاد رو بگیرم"
    },
    {
      "id": 83,
      "start": 7678.34,
      "end": 7680.34,
      "formatted_start": "02:07:58.340",
      "formatted_end": "02:08:00.340",
      "text": "من بگیرم داروی گروم براتون بزنیم"
    },
    {
      "id": 84,
      "start": 7680.34,
      "end": 7682.34,
      "formatted_start": "02:08:00.340",
      "formatted_end": "02:08:02.340",
      "text": "نفس بگیر"
    },
    {
      "id": 85,
      "start": 7682.34,
      "end": 7684.34,
      "formatted_start": "02:08:02.340",
      "formatted_end": "02:08:04.340",
      "text": "نفس"
    },
    {
      "id": 86,
      "start": 7684.34,
      "end": 7686.34,
      "formatted_start": "02:08:04.340",
      "formatted_end": "02:08:06.340",
      "text": "سینش و گرش خوبه نه باید صرف اونقدر بزنیم"
    },
    {
      "id": 87,
      "start": 7688.34,
      "end": 7690.34,
      "formatted_start": "02:08:08.340",
      "formatted_end": "02:08:10.340",
      "text": "من اونو آمده باید بیشتر بره همین دیگه"
    },
    {
      "id": 88,
      "start": 7690.34,
      "end": 7692.34,
      "formatted_start": "02:08:10.340",
      "formatted_end": "02:08:12.340",
      "text": "آه اون فرق داره"
    },
    {
      "id": 89,
      "start": 7692.34,
      "end": 7694.34,
      "formatted_start": "02:08:12.340",
      "formatted_end": "02:08:14.340",
      "text": "خب این اومدین داروی من همین نیستم"
    },
    {
      "id": 90,
      "start": 7694.34,
      "end": 7696.34,
      "formatted_start": "02:08:14.340",
      "formatted_end": "02:08:16.340",
      "text": "کامیل چیه؟ شهزده ای"
    },
    {
      "id": 91,
      "start": 7696.34,
      "end": 7698.34,
      "formatted_start": "02:08:16.340",
      "formatted_end": "02:08:18.340",
      "text": "چی شهزده ای؟ صبحان شهزده ای"
    },
    {
      "id": 92,
      "start": 7698.34,
      "end": 7700.34,
      "formatted_start": "02:08:18.340",
      "formatted_end": "02:08:20.340",
      "text": "شهزده ای همینجا بیگرده"
    },
    {
      "id": 93,
      "start": 7700.34,
      "end": 7702.34,
      "formatted_start": "02:08:20.340",
      "formatted_end": "02:08:22.340",
      "text": "خونه رو عشر کش اینا بزن"
    },
    {
      "id": 94,
      "start": 7702.34,
      "end": 7706.04,
      "formatted_start": "02:08:22.340",
      "formatted_end": "02:08:26.040",
      "text": "خواه خونه رو هشر کش بزن در پنجره بمن"
    },
    {
      "id": 95,
      "start": 7706.04,
      "end": 7707.54,
      "formatted_start": "02:08:26.040",
      "formatted_end": "02:08:27.540",
      "text": "یه چیزی هست میگذر"
    },
    {
      "id": 96,
      "start": 7707.54,
      "end": 7710.54,
      "formatted_start": "02:08:27.540",
      "formatted_end": "02:08:30.540",
      "text": "خواه رخ خواباشو بریز بیرون"
    },
    {
      "id": 97,
      "start": 7710.54,
      "end": 7711.54,
      "formatted_start": "02:08:30.540",
      "formatted_end": "02:08:31.540",
      "text": "خوارش هم میده؟"
    },
    {
      "id": 98,
      "start": 7711.54,
      "end": 7713.54,
      "formatted_start": "02:08:31.540",
      "formatted_end": "02:08:33.540",
      "text": "آره درد هم میکنه"
    },
    {
      "id": 99,
      "start": 7713.54,
      "end": 7715.54,
      "formatted_start": "02:08:33.540",
      "formatted_end": "02:08:35.540",
      "text": "آره اون گذیریدیه"
    },
    {
      "id": 100,
      "start": 7715.54,
      "end": 7720.54,
      "formatted_start": "02:08:35.540",
      "formatted_end": "02:08:40.540",
      "text": "اون جایی بعدی هم زده اون هم همین فماده رو بزن"
    },
    {
      "id": 101,
      "start": 7720.54,
      "end": 7750.54,
      "formatted_start": "02:08:40.540",
      "formatted_end": "02:09:10.540",
      "text": "اینجا باید بردارید که در اینجا باید بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا بردارید که در اینجا ب"
    },
    {
      "id": 102,
      "start": 7750.54,
      "end": 7752.54,
      "formatted_start": "02:09:10.540",
      "formatted_end": "02:09:12.540",
      "text": "ادامه بده قطع نکن"
    },
    {
      "id": 103,
      "start": 7752.54,
      "end": 7754.54,
      "formatted_start": "02:09:12.540",
      "formatted_end": "02:09:14.540",
      "text": "چون به نظرم سینه خوب ده"
    },
    {
      "id": 104,
      "start": 7754.54,
      "end": 7756.54,
      "formatted_start": "02:09:14.540",
      "formatted_end": "02:09:16.540",
      "text": "خدافض"
    },
    {
      "id": 105,
      "start": 7756.54,
      "end": 7758.54,
      "formatted_start": "02:09:16.540",
      "formatted_end": "02:09:18.540",
      "text": "در هم بیزنش ببن"
    },
    {
      "id": 106,
      "start": 7760.54,
      "end": 7762.54,
      "formatted_start": "02:09:20.540",
      "formatted_end": "02:09:22.540",
      "text": "باکن داری"
    },
    {
      "id": 107,
      "start": 7764.54,
      "end": 7766.54,
      "formatted_start": "02:09:24.540",
      "formatted_end": "02:09:26.540",
      "text": "خانسمین خفله چرخوندن در بسته نمیشه"
    },
    {
      "id": 108,
      "start": 7766.54,
      "end": 7768.54,
      "formatted_start": "02:09:26.540",
      "formatted_end": "02:09:28.540",
      "text": "کلیدی همهاره"
    },
    {
      "id": 109,
      "start": 7768.54,
      "end": 7770.54,
      "formatted_start": "02:09:28.540",
      "formatted_end": "02:09:30.540",
      "text": "خانسمین فقط هیدروکسیزین"
    },
    {
      "id": 110,
      "start": 7770.54,
      "end": 7772.54,
      "formatted_start": "02:09:30.540",
      "formatted_end": "02:09:32.540",
      "text": "در من بینویسم"
    },
    {
      "id": 111,
      "start": 7772.54,
      "end": 7774.54,
      "formatted_start": "02:09:32.540",
      "formatted_end": "02:09:34.540",
      "text": "شاوروزین"
    },
    {
      "id": 112,
      "start": 7776.54,
      "end": 7778.54,
      "formatted_start": "02:09:36.540",
      "formatted_end": "02:09:38.540",
      "text": "این دوتا کمادی گذشتاری"
    },
    {
      "id": 113,
      "start": 7778.54,
      "end": 7790.04,
      "formatted_start": "02:09:38.540",
      "formatted_end": "02:09:50.040",
      "text": "این میخوره هیدروکسیزینش رو میخوره سفتیزوکسین، ایگزا، این دو نره"
    },
    {
      "id": 114,
      "start": 7790.04,
      "end": 7793.94,
      "formatted_start": "02:09:50.040",
      "formatted_end": "02:09:53.940",
      "text": "اکسپیکترون مادرش که میصرفان شدید و به هندر نیم"
    },
    {
      "id": 115,
      "start": 7793.94,
      "end": 7796.64,
      "formatted_start": "02:09:53.940",
      "formatted_end": "02:09:56.640",
      "text": "این رو حمله دارواش ایگزا بوده"
    }
  ],
  "status": "completed"
}