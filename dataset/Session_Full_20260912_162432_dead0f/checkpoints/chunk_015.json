  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4529.98,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:29.980",
      "text": "مردگرد، رفیق و خمدمی،"
    },
    {
      "id": 1,
      "start": 4530.0,
      "end": 4540.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:40.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 4560.0,
      "end": 4589.98,
      "formatted_start": "01:16:00.000",
      "formatted_end": "01:16:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 3,
      "start": 4590.0,
      "end": 4619.98,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 4,
      "start": 4620.0,
      "end": 4628.5,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:08.500",
      "text": "با قرور و باشدار"
    },
    {
      "id": 5,
      "start": 4628.5,
      "end": 4633.52,
      "formatted_start": "01:17:08.500",
      "formatted_end": "01:17:13.520",
      "text": "بر سینه نرم آر"
    },
    {
      "id": 6,
      "start": 4633.52,
      "end": 4637.92,
      "formatted_start": "01:17:13.520",
      "formatted_end": "01:17:17.920",
      "text": "دیوانه میخزیدم"
    },
    {
      "id": 7,
      "start": 4637.92,
      "end": 4642.84,
      "formatted_start": "01:17:17.920",
      "formatted_end": "01:17:22.840",
      "text": "در قایت خود خواهی"
    },
    {
      "id": 8,
      "start": 4642.84,
      "end": 4647.72,
      "formatted_start": "01:17:22.840",
      "formatted_end": "01:17:27.720",
      "text": "در قنبوه سیاهی"
    },
    {
      "id": 9,
      "start": 4647.72,
      "end": 4652.26,
      "formatted_start": "01:17:27.720",
      "formatted_end": "01:17:32.260",
      "text": "جز خود نمی شدیدم"
    },
    {
      "id": 10,
      "start": 4652.26,
      "end": 4657.4,
      "formatted_start": "01:17:32.260",
      "formatted_end": "01:17:37.400",
      "text": "خروشانا بسته چشم"
    },
    {
      "id": 11,
      "start": 4657.4,
      "end": 4662.24,
      "formatted_start": "01:17:37.400",
      "formatted_end": "01:17:42.240",
      "text": "با کنباری از خشم"
    },
    {
      "id": 12,
      "start": 4662.24,
      "end": 4665.8,
      "formatted_start": "01:17:42.240",
      "formatted_end": "01:17:45.800",
      "text": "می رفتم از خشم خود"
    },
    {
      "id": 13,
      "start": 4665.8,
      "end": 4668.96,
      "formatted_start": "01:17:45.800",
      "formatted_end": "01:17:48.960",
      "text": "دنیا پیران سازم"
    },
    {
      "id": 14,
      "start": 4668.96,
      "end": 4671.96,
      "formatted_start": "01:17:48.960",
      "formatted_end": "01:17:51.960",
      "text": "در در زندگی"
    },
    {
      "id": 15,
      "start": 4671.96,
      "end": 4675.22,
      "formatted_start": "01:17:51.960",
      "formatted_end": "01:17:55.220",
      "text": "از خود افثان سازم"
    },
    {
      "id": 16,
      "start": 4675.22,
      "end": 4681.42,
      "formatted_start": "01:17:55.220",
      "formatted_end": "01:18:01.420",
      "text": "اما زفازی زمان گمرا و بافل بود"
    },
    {
      "id": 17,
      "start": 4681.42,
      "end": 4689.98,
      "formatted_start": "01:18:01.420",
      "formatted_end": "01:18:09.980",
      "text": "در آج پرفاز هوای خواهشه بودم"
    },
    {
      "id": 18,
      "start": 4689.98,
      "end": 4698.44,
      "formatted_start": "01:18:09.980",
      "formatted_end": "01:18:18.440",
      "text": "در سر نبود اندیشه ی جسفه ترپی ایرانگری"
    },
    {
      "id": 19,
      "start": 4698.44,
      "end": 4700.44,
      "formatted_start": "01:18:18.440",
      "formatted_end": "01:18:20.440",
      "text": "موسیقی"
    },
    {
      "id": 20,
      "start": 4728.44,
      "end": 4746.44,
      "formatted_start": "01:18:48.440",
      "formatted_end": "01:19:06.440",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 4746.44,
      "end": 4751.18,
      "formatted_start": "01:19:06.440",
      "formatted_end": "01:19:11.180",
      "text": "پیچید تو فرده وجودم"
    },
    {
      "id": 22,
      "start": 4751.18,
      "end": 4755.74,
      "formatted_start": "01:19:11.180",
      "formatted_end": "01:19:15.740",
      "text": "شد فاقر از هم تارو بودم"
    },
    {
      "id": 23,
      "start": 4755.74,
      "end": 4767.22,
      "formatted_start": "01:19:15.740",
      "formatted_end": "01:19:27.220",
      "text": "در لحظه های با پسید تی که عجل آمد مرا افلادمو از فارشم وستم"
    },
    {
      "id": 24,
      "start": 4767.22,
      "end": 4779.72,
      "formatted_start": "01:19:27.220",
      "formatted_end": "01:19:39.720",
      "text": "ویداد تو فرمان چند بستنگ ساره زد مرا تنشید شدید و هم شکم وستم"
    },
    {
      "id": 25,
      "start": 4779.72,
      "end": 4786.64,
      "formatted_start": "01:19:39.720",
      "formatted_end": "01:19:46.640",
      "text": "گفتم به خود ای ما که سرگردار که آخر"
    },
    {
      "id": 26,
      "start": 4786.64,
      "end": 4792.24,
      "formatted_start": "01:19:46.640",
      "formatted_end": "01:19:52.240",
      "text": "به گرد به خود چه بود یا کن که هستی"
    },
    {
      "id": 27,
      "start": 4792.24,
      "end": 4799.12,
      "formatted_start": "01:19:52.240",
      "formatted_end": "01:19:59.120",
      "text": "حاصل چه بود از آن قرور بی دلیل و بر"
    }
  ],
  "status": "completed"
}