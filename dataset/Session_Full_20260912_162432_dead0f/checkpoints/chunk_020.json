    },
    {
      "id": 36,
      "start": 6238.0,
      "end": 6242.5,
      "formatted_start": "01:43:58.000",
      "formatted_end": "01:44:02.500",
      "text": "خب وضعیت اونوش خوبه خب فقط ضردی داره"
    },
    {
      "id": 37,
      "start": 6242.5,
      "end": 6246.5,
      "formatted_start": "01:44:02.500",
      "formatted_end": "01:44:06.500",
      "text": "این ضردی هم باید حتما دستگاه بگیریم خب"
    },
    {
      "id": 38,
      "start": 6246.5,
      "end": 6253.5,
      "formatted_start": "01:44:06.500",
      "formatted_end": "01:44:13.500",
      "text": "بگیریم بگیریم دو شب دستگاه بگیریم چون سه شب میخوره و هر وی نمیشه"
    },
    {
      "id": 39,
      "start": 6253.5,
      "end": 6258.5,
      "formatted_start": "01:44:13.500",
      "formatted_end": "01:44:18.500",
      "text": "یه قرصی هم میگیرسم از پایین بگیر بیا"
    },
    {
      "id": 40,
      "start": 6258.5,
      "end": 6262.0,
      "formatted_start": "01:44:18.500",
      "formatted_end": "01:44:22.000",
      "text": "صبح شب یک چار و تا نصفش میگیم"
    },
    {
      "id": 41,
      "start": 6262.0,
      "end": 6265.5,
      "formatted_start": "01:44:22.000",
      "formatted_end": "01:44:25.500",
      "text": "خانمی؟ سعادت که الان بیشتر"
    },
    {
      "id": 42,
      "start": 6265.5,
      "end": 6267.5,
      "formatted_start": "01:44:25.500",
      "formatted_end": "01:44:27.500",
      "text": "این خدمت شما"
    },
    {
      "id": 43,
      "start": 6267.5,
      "end": 6269.5,
      "formatted_start": "01:44:27.500",
      "formatted_end": "01:44:29.500",
      "text": "این خرسو هر دوازده سال یه چهار روشنید"
    },
    {
      "id": 44,
      "start": 6269.5,
      "end": 6271.5,
      "formatted_start": "01:44:29.500",
      "formatted_end": "01:44:31.500",
      "text": "تو آفل می کنی بشین"
    },
    {
      "id": 45,
      "start": 6271.5,
      "end": 6273.5,
      "formatted_start": "01:44:31.500",
      "formatted_end": "01:44:33.500",
      "text": "دست باید بمشینید"
    },
    {
      "id": 46,
      "start": 6273.5,
      "end": 6275.5,
      "formatted_start": "01:44:33.500",
      "formatted_end": "01:44:35.500",
      "text": "بشین باش"
    },
    {
      "id": 47,
      "start": 6275.5,
      "end": 6277.5,
      "formatted_start": "01:44:35.500",
      "formatted_end": "01:44:37.500",
      "text": "مرسی خدافت باشم"
    },
    {
      "id": 48,
      "start": 6277.5,
      "end": 6279.5,
      "formatted_start": "01:44:37.500",
      "formatted_end": "01:44:39.500",
