  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11130.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:30.000",
      "text": "مدیشه باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید با"
    },
    {
      "id": 1,
      "start": 11130.0,
      "end": 11158.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:58.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 11158.0,
      "end": 11160.0,
      "formatted_start": "03:05:58.000",
      "formatted_end": "03:06:00.000",
      "text": "این هایی که باید بردارید"
    },
    {
      "id": 3,
      "start": 11176.0,
      "end": 11178.0,
      "formatted_start": "03:06:16.000",
      "formatted_end": "03:06:18.000",
      "text": "همین هایی که باید بردارید"
    },
    {
      "id": 4,
      "start": 11178.0,
      "end": 11180.0,
      "formatted_start": "03:06:18.000",
      "formatted_end": "03:06:20.000",
      "text": "همین هایی که بردارید"
    },
    {
      "id": 5,
      "start": 11180.0,
      "end": 11182.0,
      "formatted_start": "03:06:20.000",
      "formatted_end": "03:06:22.000",
      "text": "همین هایی که بردارید"
    },
    {
      "id": 6,
      "start": 11182.0,
      "end": 11184.0,
      "formatted_start": "03:06:22.000",
      "formatted_end": "03:06:24.000",
      "text": "همین هایی که بردارید"
    },
    {
      "id": 7,
      "start": 11184.0,
      "end": 11186.0,
      "formatted_start": "03:06:24.000",
      "formatted_end": "03:06:26.000",
      "text": "همین هایی که بردارید"
    },
    {
      "id": 8,
      "start": 11186.0,
      "end": 11188.0,
      "formatted_start": "03:06:26.000",
      "formatted_end": "03:06:28.000",
      "text": "طولا پولیه"
    },
    {
      "id": 9,
      "start": 11188.0,
      "end": 11190.0,
      "formatted_start": "03:06:28.000",
      "formatted_end": "03:06:30.000",
      "text": "میخوام بگرو تو چیه روزی سنی؟"
    },
    {
      "id": 10,
      "start": 11190.0,
      "end": 11192.0,
      "formatted_start": "03:06:30.000",
      "formatted_end": "03:06:32.000",
      "text": "اینو هر روز میزنی؟"
    },
    {
      "id": 11,
      "start": 11192.0,
      "end": 11193.0,
      "formatted_start": "03:06:32.000",
      "formatted_end": "03:06:33.000",
      "text": "بله"
    },
    {
      "id": 12,
      "start": 11193.0,
      "end": 11195.0,
      "formatted_start": "03:06:33.000",
      "formatted_end": "03:06:35.000",
      "text": "خوب و روزی سه بار میزن"
    },
    {
      "id": 13,
      "start": 11195.0,
      "end": 11196.0,
      "formatted_start": "03:06:35.000",
      "formatted_end": "03:06:36.000",
      "text": "هر روز"
    },
    {
      "id": 14,
      "start": 11196.0,
      "end": 11198.0,
      "formatted_start": "03:06:36.000",
      "formatted_end": "03:06:38.000",
      "text": "این کماد اینو"
    },
    {
      "id": 15,
      "start": 11198.0,
      "end": 11200.0,
      "formatted_start": "03:06:38.000",
      "formatted_end": "03:06:40.000",
      "text": "تا یه هفته بزن"
    },
    {
      "id": 16,
      "start": 11200.0,
      "end": 11202.0,
      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:42.000",
      "text": "روزی سه بار"
    },
    {
      "id": 17,
      "start": 11202.0,
      "end": 11203.0,
      "formatted_start": "03:06:42.000",
      "formatted_end": "03:06:43.000",
      "text": "کدام؟"
    },
    {
      "id": 18,
      "start": 11203.0,
      "end": 11205.0,
      "formatted_start": "03:06:43.000",
      "formatted_end": "03:06:45.000",
      "text": "همه نامون با اون کماد یه هفته بزن"
    },
    {
      "id": 19,
      "start": 11205.0,
      "end": 11207.0,
      "formatted_start": "03:06:45.000",
      "formatted_end": "03:06:47.000",
      "text": "آره"
    },
    {
      "id": 20,
      "start": 11207.0,
      "end": 11210.0,
      "formatted_start": "03:06:47.000",
      "formatted_end": "03:06:50.000",
      "text": "تا یک هفته میزنی خوب"
    },
    {
      "id": 21,
      "start": 11210.0,
      "end": 11213.0,
      "formatted_start": "03:06:50.000",
      "formatted_end": "03:06:53.000",
      "text": "هشت ساعت خوب"
    },
    {
      "id": 22,
      "start": 11213.0,
      "end": 11215.0,
      "formatted_start": "03:06:53.000",
      "formatted_end": "03:06:55.000",
      "text": "این کماد هم برای گوششه"
    },
    {
      "id": 23,
      "start": 11215.0,
      "end": 11218.28,
      "formatted_start": "03:06:55.000",
      "formatted_end": "03:06:58.280",
      "text": "چاپنگ روزی صلاخ کردیم میزنیم این برای گوش"
    },
    {
      "id": 24,
      "start": 11219.8,
      "end": 11221.0,
      "formatted_start": "03:06:59.800",
      "formatted_end": "03:07:01.000",
      "text": "بره گوش نبشته"
    },
    {
      "id": 25,
      "start": 11222.1,
      "end": 11224.1,
      "formatted_start": "03:07:02.100",
      "formatted_end": "03:07:04.100",
      "text": "پس کدوم روزی کدوم کمال بزنیم؟"
    },
    {
      "id": 26,
      "start": 11224.1,
      "end": 11228.8,
      "formatted_start": "03:07:04.100",
      "formatted_end": "03:07:08.800",
      "text": "پره نداره این هر روز بدن تا هر روز قطع نکن"
    },
    {
      "id": 27,
      "start": 11229.8,
      "end": 11230.9,
      "formatted_start": "03:07:09.800",
      "formatted_end": "03:07:10.900",
      "text": "همون روز سه بار؟"
    },
    {
      "id": 28,
      "start": 11230.9,
      "end": 11234.3,
      "formatted_start": "03:07:10.900",
      "formatted_end": "03:07:14.300",
      "text": "آره روزی دو بار تا سه بار دو بار میگه عطاقه بزنیم"
    },
    {
      "id": 29,
      "start": 11234.3,
      "end": 11236.9,
      "formatted_start": "03:07:14.300",
      "formatted_end": "03:07:16.900",
      "text": "اون کمال باشه یعنی این روز بدنیم شما نداره"
    },
    {
      "id": 30,
      "start": 11236.9,
      "end": 11240.0,
      "formatted_start": "03:07:16.900",
      "formatted_end": "03:07:20.000",
      "text": "یه ده دقیقه یه میم ساعت بدن بلا فاصله نزدیک"
    },
    {
      "id": 31,
      "start": 11240.0,
      "end": 11240.7,
      "formatted_start": "03:07:20.000",
      "formatted_end": "03:07:20.700",
      "text": "خب"
    },
    {
      "id": 32,
      "start": 11240.7,
      "end": 11242.7,
      "formatted_start": "03:07:20.700",
      "formatted_end": "03:07:22.700",
      "text": "این هایی رو من همینجور کنم"
    },
    {
      "id": 33,
      "start": 11242.7,
      "end": 11244.7,
      "formatted_start": "03:07:22.700",
      "formatted_end": "03:07:24.700",
      "text": "این هم بنده"
    },
    {
      "id": 34,
      "start": 11244.7,
      "end": 11248.7,
      "formatted_start": "03:07:24.700",
      "formatted_end": "03:07:28.700",
      "text": "اگه میبینید خوبه، خیلی خوبتره"
    },
    {
      "id": 35,
      "start": 11248.7,
      "end": 11250.7,
      "formatted_start": "03:07:28.700",
      "formatted_end": "03:07:30.700",
      "text": "میتونید استفاده کنید"
    },
    {
      "id": 36,
      "start": 11250.7,
      "end": 11252.7,
      "formatted_start": "03:07:30.700",
      "formatted_end": "03:07:32.700",
      "text": "چون بعضی ما دوسته ما این صورت های بچه هایی میبینید"
    },
    {
      "id": 37,
      "start": 11252.7,
      "end": 11254.7,
      "formatted_start": "03:07:32.700",
      "formatted_end": "03:07:34.700",
      "text": "این ها از دوستیدن نیست"
    },
    {
      "id": 38,
      "start": 11254.7,
      "end": 11256.7,
      "formatted_start": "03:07:34.700",
      "formatted_end": "03:07:36.700",
      "text": "مثلا دیگه هم میبینید سمیتونی هایی که بیشه اینا"
    },
    {
      "id": 39,
      "start": 11256.7,
      "end": 11258.7,
      "formatted_start": "03:07:36.700",
      "formatted_end": "03:07:38.700",
      "text": "نه"
    },
    {
      "id": 40,
      "start": 11258.7,
      "end": 11260.7,
      "formatted_start": "03:07:38.700",
      "formatted_end": "03:07:40.700",
      "text": "اینا از جنتیک اکزمایه"
    },
    {
      "id": 41,
      "start": 11260.7,
      "end": 11262.7,
      "formatted_start": "03:07:40.700",
      "formatted_end": "03:07:42.700",
      "text": "از غذای مادر هم هست"
    },
    {
      "id": 42,
      "start": 11264.7,
      "end": 11268.7,
      "formatted_start": "03:07:44.700",
      "formatted_end": "03:07:48.700",
      "text": "اگه هر جایی که احساس کنید خشک زبره"
    },
    {
      "id": 43,
      "start": 11268.7,
      "end": 11270.7,
      "formatted_start": "03:07:48.700",
      "formatted_end": "03:07:50.700",
      "text": "که زهره مثل اونه بزنش کنه"
    },
    {
      "id": 44,
      "start": 11270.7,
      "end": 11273.7,
      "formatted_start": "03:07:50.700",
      "formatted_end": "03:07:53.700",
      "text": "یه نفر داخل باشیم دیتره"
    },
    {
      "id": 45,
      "start": 11273.7,
      "end": 11276.7,
      "formatted_start": "03:07:53.700",
      "formatted_end": "03:07:56.700",
      "text": "پدرش نگه داره مادرش اون بچه بیرون کشی"
    },
    {
      "id": 46,
      "start": 11276.7,
      "end": 11278.7,
      "formatted_start": "03:07:56.700",
      "formatted_end": "03:07:58.700",
      "text": "دیوین الان من یه توضیح بدم"
    },
    {
      "id": 47,
      "start": 11278.7,
      "end": 11281.7,
      "formatted_start": "03:07:58.700",
      "formatted_end": "03:08:01.700",
      "text": "اینه که سراخ کردن تا دو هفته تو گوشش باشه"
    },
    {
      "id": 48,
      "start": 11281.7,
      "end": 11284.7,
      "formatted_start": "03:08:01.700",
      "formatted_end": "03:08:04.700",
      "text": "بعد از دو هفته گوشباره ها از گوشش در بیاد"
    },
    {
      "id": 49,
      "start": 11284.7,
      "end": 11286.7,
      "formatted_start": "03:08:04.700",
      "formatted_end": "03:08:06.700",
      "text": "تا فردا هم هموم نبر"
    },
    {
      "id": 50,
      "start": 11286.7,
      "end": 11288.7,
      "formatted_start": "03:08:06.700",
      "formatted_end": "03:08:08.700",
      "text": "این پومادی هم که برای گوششی میشن"
    },
    {
      "id": 51,
      "start": 11288.7,
      "end": 11290.7,
      "formatted_start": "03:08:08.700",
      "formatted_end": "03:08:10.700",
      "text": "چاخنیوزی بزن کورفونه"
    },
    {
      "id": 52,
      "start": 11290.7,
      "end": 11291.7,
      "formatted_start": "03:08:10.700",
      "formatted_end": "03:08:11.700",
      "text": "بعد امروز بزنه؟"
    },
    {
      "id": 53,
      "start": 11291.7,
      "end": 11294.7,
      "formatted_start": "03:08:11.700",
      "formatted_end": "03:08:14.700",
      "text": "بله از این روز که من زیر دختر از امیشه هم بزنیم"
    },
    {
      "id": 54,
      "start": 11295.46,
      "end": 11297.82,
      "formatted_start": "03:08:15.460",
      "formatted_end": "03:08:17.820",
      "text": "خب شما بیرون میشین گریم کردید داخل نگهد"
    },
    {
      "id": 55,
      "start": 11297.82,
      "end": 11298.82,
      "formatted_start": "03:08:17.820",
      "formatted_end": "03:08:18.820",
      "text": "پدرش هست"
    },
    {
      "id": 56,
      "start": 11298.82,
      "end": 11300.26,
      "formatted_start": "03:08:18.820",
      "formatted_end": "03:08:20.260",
      "text": "خب شما آیه"
    },
    {
      "id": 57,
      "start": 11300.26,
      "end": 11302.98,
      "formatted_start": "03:08:20.260",
      "formatted_end": "03:08:22.980",
      "text": "دوست دوست ندارید اینجا میتونید دخترتن بیرون بگیر"
    },
    {
      "id": 58,
      "start": 11302.98,
      "end": 11303.98,
      "formatted_start": "03:08:22.980",
      "formatted_end": "03:08:23.980",
      "text": "بله بله بله"
    },
    {
      "id": 59,
      "start": 11303.98,
      "end": 11304.98,
      "formatted_start": "03:08:23.980",
      "formatted_end": "03:08:24.980",
      "text": "بله شما"
    },
    {
      "id": 60,
      "start": 11305.66,
      "end": 11306.66,
      "formatted_start": "03:08:25.660",
      "formatted_end": "03:08:26.660",
      "text": "به هم میشین"
    },
    {
      "id": 61,
      "start": 11306.66,
      "end": 11307.66,
      "formatted_start": "03:08:26.660",
      "formatted_end": "03:08:27.660",
      "text": "بله بله"
