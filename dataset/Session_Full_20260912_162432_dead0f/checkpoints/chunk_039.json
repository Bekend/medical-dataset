      "text": "بابا باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید بردن باید"
    },
    {
      "id": 34,
      "start": 11869.22,
      "end": 11899.22,
      "formatted_start": "03:17:49.220",
      "formatted_end": "03:18:19.220",
      "text": "ببینید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید با"
    },
    {
      "id": 35,
      "start": 11899.22,
      "end": 11909.22,
      "formatted_start": "03:18:19.220",
      "formatted_end": "03:18:29.220",
      "text": "برنامه بیرون آروم بشه و بعد بیا من دیچی زیر تلتیب بزنم"
    },
    {
      "id": 36,
      "start": 11909.22,
      "end": 11913.22,
      "formatted_start": "03:18:29.220",
      "formatted_end": "03:18:33.220",
      "text": "جیان بابا جیان بابا جیان بابا"
    },
    {
      "id": 37,
      "start": 11913.22,
      "end": 11917.22,
      "formatted_start": "03:18:33.220",
      "formatted_end": "03:18:37.220",
      "text": "جیان بابا جیان بابا جیان بابا"
    },
    {
      "id": 38,
      "start": 11917.22,
      "end": 11920.22,
      "formatted_start": "03:18:37.220",
      "formatted_end": "03:18:40.220",
      "text": "برنامه آروم بشه"
    },
    {
      "id": 39,
      "start": 11920.22,
      "end": 11927.22,
      "formatted_start": "03:18:40.220",
      "formatted_end": "03:18:47.220",
      "text": "آیه سایدی جیان ببین فردا نه فردا بیا بیرون من ببینم تا اون موقع همون بیمانه بردین"
    },
    {
      "id": 40,
      "start": 11927.22,
      "end": 11928.22,
      "formatted_start": "03:18:47.220",
      "formatted_end": "03:18:48.220",
      "text": "نه، بعد این آب نخواهید"
    },
    {
      "id": 41,
      "start": 11928.22,
      "end": 11929.22,
      "formatted_start": "03:18:48.220",
      "formatted_end": "03:18:49.220",
      "text": "نه، همون تا این دیگر دور می‌گیرم"
    },
    {
      "id": 42,
      "start": 11929.22,
      "end": 11930.22,
      "formatted_start": "03:18:49.220",
      "formatted_end": "03:18:50.220",
      "text": "خوبه، خوبه"
    },
    {
      "id": 43,
      "start": 11930.22,
      "end": 11932.22,
      "formatted_start": "03:18:50.220",
      "formatted_end": "03:18:52.220",
      "text": "ببین، بعضی از بچه‌ها توی یه مرحله تمام می‌شه"
    },
    {
      "id": 44,
      "start": 11932.22,
      "end": 11935.22,
      "formatted_start": "03:18:52.220",
      "formatted_end": "03:18:55.220",
      "text": "ولی بعضی از بچه‌ها یکم می‌مانه و اونو باز باز دوباره ما بردیم"
    },
    {
      "id": 45,
      "start": 11935.22,
      "end": 11936.22,
      "formatted_start": "03:18:55.220",
      "formatted_end": "03:18:56.220",
      "text": "بله، انشالله که تمام"
    },
    {
      "id": 46,
      "start": 11936.22,
      "end": 11939.22,
      "formatted_start": "03:18:56.220",
      "formatted_end": "03:18:59.220",
      "text": "آره، شما دو روز دیگه بیاریم هم ببینیم"
    },
    {
      "id": 47,
      "start": 11939.22,
      "end": 11940.22,
      "formatted_start": "03:18:59.220",
      "formatted_end": "03:19:00.220",
      "text": "باش، باش"
    },
    {
      "id": 48,
      "start": 11940.22,
      "end": 11941.22,
      "formatted_start": "03:19:00.220",
      "formatted_end": "03:19:01.220",
      "text": "زنده باش"
    },
    {
      "id": 49,
      "start": 11941.22,
      "end": 11942.22,
      "formatted_start": "03:19:01.220",
      "formatted_end": "03:19:02.220",
      "text": "شما لباس شربار روی این بره"
    },
    {
      "id": 50,
      "start": 11942.22,
      "end": 11944.22,
      "formatted_start": "03:19:02.220",
      "formatted_end": "03:19:04.220",
      "text": "نه، نه، این الان آروم می‌شه شد"
    },
    {
      "id": 51,
      "start": 11944.22,
      "end": 11946.88,
      "formatted_start": "03:19:04.220",
      "formatted_end": "03:19:06.880",
      "text": "اشتراک از این بقلش خون بیاد، نگران نباشید"
    },
    {
      "id": 52,
      "start": 11946.88,
      "end": 11949.22,
      "formatted_start": "03:19:06.880",
      "formatted_end": "03:19:09.220",
      "text": "بندش که بر نداریم"
    },
    {
      "id": 53,
      "start": 11949.22,
      "end": 11950.52,
      "formatted_start": "03:19:09.220",
      "formatted_end": "03:19:10.520",
      "text": "نه نه، اصلا دست نداریم"
    },
    {
      "id": 54,
      "start": 11950.52,
      "end": 11951.72,
      "formatted_start": "03:19:10.520",
      "formatted_end": "03:19:11.720",
      "text": "تا دو روز هیچ دست نداریم"
    },
    {
      "id": 55,
      "start": 11951.72,
      "end": 11953.46,
      "formatted_start": "03:19:11.720",
      "formatted_end": "03:19:13.460",
      "text": "یه وقت یه چسپش رد شد، چسپش شد"
    },
    {
      "id": 56,
      "start": 11953.46,
      "end": 11954.72,
      "formatted_start": "03:19:13.460",
      "formatted_end": "03:19:14.720",
      "text": "آره، چسپش باشید"
    },
    {
      "id": 57,
      "start": 11954.72,
      "end": 11955.88,
      "formatted_start": "03:19:14.720",
      "formatted_end": "03:19:15.880",
      "text": "باید رسیب باشید"
    },
    {
      "id": 58,
      "start": 11955.88,
      "end": 11958.22,
      "formatted_start": "03:19:15.880",
      "formatted_end": "03:19:18.220",
      "text": "چسپای کاغذی که گیرید"
    },
    {
      "id": 59,
      "start": 11958.22,
      "end": 11962.02,
      "formatted_start": "03:19:18.220",
      "formatted_end": "03:19:22.020",
      "text": "مثلا شاید بچه چسپا دیگه حال نداده"
    },
    {
      "id": 60,
      "start": 11962.02,
      "end": 11962.52,
      "formatted_start": "03:19:22.020",
      "formatted_end": "03:19:22.520",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 11962.52,
      "end": 11965.02,
      "formatted_start": "03:19:22.520",
      "formatted_end": "03:19:25.020",
      "text": "یه چسپ کاغذی هم داشته وش یه وقت لازم داشت"
    },
    {
      "id": 62,
      "start": 11965.02,
      "end": 11972.52,
      "formatted_start": "03:19:25.020",
      "formatted_end": "03:19:32.520",
      "text": "ببینید اولا شما این شروط رو بده اگر جواب ندارید فروز رو اضافه کنید"
    },
    {
      "id": 63,
      "start": 11972.52,
      "end": 11974.52,
      "formatted_start": "03:19:32.520",
      "formatted_end": "03:19:34.520",
      "text": "باشه ممنونم"
    },
    {
      "id": 64,
      "start": 11974.52,
      "end": 11976.52,
      "formatted_start": "03:19:34.520",
      "formatted_end": "03:19:36.520",
      "text": "تو صبح و آشق شب مارم بخوریم"
    },
    {
      "id": 65,
      "start": 11976.52,
      "end": 11980.52,
      "formatted_start": "03:19:36.520",
      "formatted_end": "03:19:40.520",
      "text": "این آخری کلو چیزی؟"
    },
    {
      "id": 66,
      "start": 11980.52,
      "end": 11982.52,
      "formatted_start": "03:19:40.520",
      "formatted_end": "03:19:42.520",
      "text": "چیزی نه"
    },
    {
      "id": 67,
      "start": 11982.52,
      "end": 11984.52,
      "formatted_start": "03:19:42.520",
      "formatted_end": "03:19:44.520",
      "text": "چیزی نه؟ اشکال نداری"
    },
    {
      "id": 68,
      "start": 11984.52,
      "end": 11986.52,
      "formatted_start": "03:19:44.520",
      "formatted_end": "03:19:46.520",
      "text": "اشکال نداری"
    },
    {
      "id": 69,
      "start": 11986.52,
      "end": 11988.52,
      "formatted_start": "03:19:46.520",
      "formatted_end": "03:19:48.520",
      "text": "همانطور که شاید یک مرتبه امفجاری آبکی کار کنید"
    },
    {
      "id": 70,
      "start": 11988.52,
      "end": 11990.52,
      "formatted_start": "03:19:48.520",
      "formatted_end": "03:19:50.520",
      "text": "چیزی ها فراموش بگذارید"
    },
    {
      "id": 71,
      "start": 11990.52,
      "end": 11992.52,
      "formatted_start": "03:19:50.520",
      "formatted_end": "03:19:52.520",
      "text": "چرا الان این زور بزنه"
    },
    {
      "id": 72,
      "start": 11992.52,
      "end": 11994.52,
      "formatted_start": "03:19:52.520",
      "formatted_end": "03:19:54.520",
      "text": "اون پولی که ما برداشتیم خون میاد"
    },
    {
      "id": 73,
      "start": 11994.52,
      "end": 11996.52,
      "formatted_start": "03:19:54.520",
      "formatted_end": "03:19:56.520",
      "text": "چون رقا همینطور که خوب نیستن"
    },
    {
      "id": 74,
      "start": 11996.52,
      "end": 11998.52,
      "formatted_start": "03:19:56.520",
      "formatted_end": "03:19:58.520",
      "text": "آره"
    }
  ],
  "status": "completed"
}