  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11707.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:07.000",
      "text": "اینها زیاد پرداشتید؟ بیان. خیلی خیلی. تو فقط همکاری کن با ما که تکن نخواهی."
    },
    {
      "id": 1,
      "start": 11713.0,
      "end": 11715.0,
      "formatted_start": "03:15:13.000",
      "formatted_end": "03:15:15.000",
      "text": "خانسان یکم دفتر دیدی؟"
    },
    {
      "id": 2,
      "start": 11718.0,
      "end": 11720.0,
      "formatted_start": "03:15:18.000",
      "formatted_end": "03:15:20.000",
      "text": "یکم دید. خیلی خیلی خیلی."
    },
    {
      "id": 3,
      "start": 11730.0,
      "end": 11732.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:32.000",
      "text": "تا پرده"
    },
    {
      "id": 4,
      "start": 11732.0,
      "end": 11734.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:34.000",
      "text": "یا راسته"
    },
    {
      "id": 5,
      "start": 11734.0,
      "end": 11736.0,
      "formatted_start": "03:15:34.000",
      "formatted_end": "03:15:36.000",
      "text": "نه خوبش"
    },
    {
      "id": 6,
      "start": 11740.0,
      "end": 11742.0,
      "formatted_start": "03:15:40.000",
      "formatted_end": "03:15:42.000",
      "text": "خوب کنشم دید"
    },
    {
      "id": 7,
      "start": 11742.0,
      "end": 11744.0,
      "formatted_start": "03:15:42.000",
      "formatted_end": "03:15:44.000",
      "text": "پنسی"
    },
    {
      "id": 8,
      "start": 11748.0,
      "end": 11750.0,
      "formatted_start": "03:15:48.000",
      "formatted_end": "03:15:50.000",
      "text": "فرقی نداره"
    },
    {
      "id": 9,
      "start": 11750.0,
      "end": 11752.0,
      "formatted_start": "03:15:50.000",
      "formatted_end": "03:15:52.000",
      "text": "یه همینطور"
    },
    {
      "id": 10,
      "start": 11752.0,
      "end": 11754.0,
      "formatted_start": "03:15:52.000",
      "formatted_end": "03:15:54.000",
      "text": "شما"
    },
    {
      "id": 11,
      "start": 11754.0,
      "end": 11756.0,
      "formatted_start": "03:15:54.000",
      "formatted_end": "03:15:56.000",
      "text": "باید سید شما رو بکنید"
    },
    {
      "id": 12,
      "start": 11756.0,
      "end": 11758.0,
      "formatted_start": "03:15:56.000",
      "formatted_end": "03:15:58.000",
      "text": "نگاه نکنید"
    },
    {
      "id": 13,
      "start": 11758.0,
      "end": 11763.0,
      "formatted_start": "03:15:58.000",
      "formatted_end": "03:16:03.000",
      "text": "خانسینی چون دست درستون نیستی؟"
    },
    {
      "id": 14,
      "start": 11763.0,
      "end": 11767.0,
      "formatted_start": "03:16:03.000",
      "formatted_end": "03:16:07.000",
      "text": "خانسینی ده چون خانسینی نیست؟"
    },
    {
      "id": 15,
      "start": 11767.0,
      "end": 11771.0,
      "formatted_start": "03:16:07.000",
      "formatted_end": "03:16:11.000",
      "text": "جوان بابا"
    },
    {
      "id": 16,
      "start": 11771.0,
      "end": 11775.0,
      "formatted_start": "03:16:11.000",
      "formatted_end": "03:16:15.000",
      "text": "جوانم، پسرم، جوان بابا"
    },
    {
      "id": 17,
      "start": 11775.0,
      "end": 11781.0,
      "formatted_start": "03:16:15.000",
      "formatted_end": "03:16:21.000",
      "text": "جوانم علی جوانم"
    },
    {
      "id": 18,
      "start": 11781.0,
      "end": 11784.0,
      "formatted_start": "03:16:21.000",
      "formatted_end": "03:16:24.000",
      "text": "جوان بابا"
    },
    {
      "id": 19,
      "start": 11784.0,
      "end": 11786.82,
      "formatted_start": "03:16:24.000",
      "formatted_end": "03:16:26.820",
      "text": "جان بابا"
    },
    {
      "id": 20,
      "start": 11786.82,
      "end": 11788.3,
      "formatted_start": "03:16:26.820",
      "formatted_end": "03:16:28.300",
      "text": "جان بیسرم"
    },
    {
      "id": 21,
      "start": 11788.3,
      "end": 11789.74,
      "formatted_start": "03:16:28.300",
      "formatted_end": "03:16:29.740",
