  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10203.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:03.000",
      "text": "در این وقتی این کار رو خودت رو بردارید، اون چی میشه؟"
    },
    {
      "id": 1,
      "start": 10203.0,
      "end": 10205.0,
      "formatted_start": "02:50:03.000",
      "formatted_end": "02:50:05.000",
      "text": "نیستی دوست دارم."
    },
    {
      "id": 2,
      "start": 10205.0,
      "end": 10206.0,
      "formatted_start": "02:50:05.000",
      "formatted_end": "02:50:06.000",
      "text": "خواهد می کنم؟"
    },
    {
      "id": 3,
      "start": 10206.0,
      "end": 10207.0,
      "formatted_start": "02:50:06.000",
      "formatted_end": "02:50:07.000",
      "text": "نیست."
    },
    {
      "id": 4,
      "start": 10207.0,
      "end": 10209.0,
      "formatted_start": "02:50:07.000",
      "formatted_end": "02:50:09.000",
      "text": "خواهد می کنم."
    },
    {
      "id": 5,
      "start": 10209.0,
      "end": 10210.0,
      "formatted_start": "02:50:09.000",
      "formatted_end": "02:50:10.000",
      "text": "بپنم."
    },
    {
      "id": 6,
      "start": 10210.0,
      "end": 10211.0,
      "formatted_start": "02:50:10.000",
      "formatted_end": "02:50:11.000",
      "text": "سلامت بکنید."
    },
    {
      "id": 7,
      "start": 10211.0,
      "end": 10212.0,
      "formatted_start": "02:50:11.000",
      "formatted_end": "02:50:12.000",
      "text": "برسه دقیقه."
    },
    {
      "id": 8,
      "start": 10212.0,
      "end": 10213.0,
      "formatted_start": "02:50:12.000",
      "formatted_end": "02:50:13.000",
      "text": "محبت باشید."
    },
    {
      "id": 9,
      "start": 10213.0,
      "end": 10214.0,
      "formatted_start": "02:50:13.000",
      "formatted_end": "02:50:14.000",
      "text": "سلامت بکنید."
    },
    {
      "id": 10,
      "start": 10214.0,
      "end": 10215.0,
      "formatted_start": "02:50:14.000",
      "formatted_end": "02:50:15.000",
      "text": "خدمت شما."
    },
    {
      "id": 11,
      "start": 10215.0,
      "end": 10216.0,
      "formatted_start": "02:50:15.000",
      "formatted_end": "02:50:16.000",
      "text": "خدمت شما."
    },
    {
      "id": 12,
      "start": 10216.0,
      "end": 10217.0,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:17.000",
      "text": "چرا تخصیلی؟"
    },
    {
      "id": 13,
      "start": 10217.0,
      "end": 10218.0,
      "formatted_start": "02:50:17.000",
      "formatted_end": "02:50:18.000",
      "text": "چرا چرا کنید؟"
    },
    {
      "id": 14,
      "start": 10218.0,
      "end": 10222.0,
      "formatted_start": "02:50:18.000",
      "formatted_end": "02:50:22.000",
      "text": "این علیه ما سه روز در درم، برمونتش 24 ساعت مدتونه کرد."
    },
    {
      "id": 15,
      "start": 10222.0,
      "end": 10226.5,
      "formatted_start": "02:50:22.000",
      "formatted_end": "02:50:26.500",
      "text": "این قبلش در اینجا هر سه ساعت یه ماه بی بی رو باید داره شد و از این کردیم"
    },
    {
      "id": 16,
      "start": 10226.5,
      "end": 10230.6,
      "formatted_start": "02:50:26.500",
      "formatted_end": "02:50:30.600",
      "text": "بعد من مزاهم شدم خدمت منشی شمایشون فرمانه ترق تجربه"
    },
    {
      "id": 17,
      "start": 10230.6,
      "end": 10235.9,
      "formatted_start": "02:50:30.600",
      "formatted_end": "02:50:35.900",
      "text": "دو الا سه روز تریه الان دو روز مجددن هنوز مطمئنه کرده"
    },
    {
      "id": 18,
      "start": 10235.9,
      "end": 10241.04,
      "formatted_start": "02:50:35.900",
      "formatted_end": "02:50:41.040",
      "text": "بعد دیشه بی شکمشون می آورد برای می برد"
    },
    {
      "id": 19,
      "start": 10241.04,
      "end": 10245.6,
      "formatted_start": "02:50:41.040",
      "formatted_end": "02:50:45.600",
      "text": "اصلا افتزاه از یه تشکیل"
    },
    {
      "id": 20,
      "start": 10245.6,
      "end": 10246.32,
      "formatted_start": "02:50:45.600",
      "formatted_end": "02:50:46.320",
      "text": "زوریدت"
    },
    {
      "id": 21,
      "start": 10246.32,
      "end": 10250.94,
      "formatted_start": "02:50:46.320",
      "formatted_end": "02:50:50.940",
      "text": "برای کاکرنه منظورتون شکمش بسامی خواست تفکر کنه"
    },
    {
      "id": 22,
      "start": 10250.94,
      "end": 10252.94,
      "formatted_start": "02:50:50.940",
      "formatted_end": "02:50:52.940",
      "text": "اینجوریم"
    },
    {
      "id": 23,
      "start": 10252.94,
      "end": 10254.94,
      "formatted_start": "02:50:52.940",
      "formatted_end": "02:50:54.940",
      "text": "نفخه است"
    },
    {
      "id": 24,
      "start": 10254.94,
      "end": 10256.94,
      "formatted_start": "02:50:54.940",
      "formatted_end": "02:50:56.940",
      "text": "سنی شده انا؟"
    },
    {
      "id": 25,
      "start": 10256.94,
      "end": 10258.94,
      "formatted_start": "02:50:56.940",
      "formatted_end": "02:50:58.940",
      "text": "دو ماه نشده"
    },
    {
      "id": 26,
      "start": 10258.94,
      "end": 10260.94,
      "formatted_start": "02:50:58.940",
      "formatted_end": "02:51:00.940",
      "text": "توسته ماه"
    },
    {
      "id": 27,
      "start": 10260.94,
      "end": 10262.94,
      "formatted_start": "02:51:00.940",
      "formatted_end": "02:51:02.940",
      "text": "نه دو ماه پنجه و دو سه بیسی"
    },
    {
      "id": 28,
      "start": 10262.94,
      "end": 10264.94,
      "formatted_start": "02:51:02.940",
      "formatted_end": "02:51:04.940",
      "text": "پس شکم"
    },
    {
      "id": 29,
      "start": 10264.94,
      "end": 10266.94,
      "formatted_start": "02:51:04.940",
      "formatted_end": "02:51:06.940",
      "text": "کفرنش شکم میشه"
    },
    {
      "id": 30,
      "start": 10266.94,
      "end": 10268.94,
      "formatted_start": "02:51:06.940",
      "formatted_end": "02:51:08.940",
      "text": "هر سه چار ساعت یکمان باید عوض میشن"
    },
    {
      "id": 31,
      "start": 10268.94,
      "end": 10270.94,
      "formatted_start": "02:51:08.940",
      "formatted_end": "02:51:10.940",
      "text": "یه میدار زیاد شد"
    },
    {
      "id": 32,
      "start": 10270.94,
      "end": 10272.94,
      "formatted_start": "02:51:10.940",
      "formatted_end": "02:51:12.940",
      "text": "تبیهش همه سه چار ساعت"
    },
    {
      "id": 33,
      "start": 10272.94,
      "end": 10274.94,
      "formatted_start": "02:51:12.940",
      "formatted_end": "02:51:14.940",
      "text": "شکم میشه"
    },
    {
      "id": 34,
      "start": 10274.94,
      "end": 10276.94,
      "formatted_start": "02:51:14.940",
      "formatted_end": "02:51:16.940",
      "text": "قبض شده"
    },
    {
      "id": 35,
      "start": 10276.94,
      "end": 10278.94,
      "formatted_start": "02:51:16.940",
      "formatted_end": "02:51:18.940",
      "text": "شیر خشکم بهش نیست"
    },
    {
      "id": 36,
      "start": 10278.94,
      "end": 10282.94,
      "formatted_start": "02:51:18.940",
      "formatted_end": "02:51:22.940",
      "text": "این گوشت از این نوع میزنه و بیرون میزنه"
    },
    {
      "id": 37,
      "start": 10282.94,
      "end": 10284.94,
      "formatted_start": "02:51:22.940",
      "formatted_end": "02:51:24.940",
      "text": "این گوشت اضافه اینو بردارید"
    },
    {
      "id": 38,
      "start": 10284.94,
      "end": 10286.94,
      "formatted_start": "02:51:24.940",
      "formatted_end": "02:51:26.940",
      "text": "چیزی بردارید؟"
    },
    {
      "id": 39,
      "start": 10286.94,
      "end": 10288.94,
      "formatted_start": "02:51:26.940",
      "formatted_end": "02:51:28.940",
      "text": "اینو بردارید، اینو بردارید، اینو پولیده"
    },
    {
      "id": 40,
      "start": 10288.94,
      "end": 10290.94,
      "formatted_start": "02:51:28.940",
      "formatted_end": "02:51:30.940",
      "text": "پولیده بردنافه"
    },
    {
      "id": 41,
      "start": 10290.94,
      "end": 10292.94,
      "formatted_start": "02:51:30.940",
      "formatted_end": "02:51:32.940",
      "text": "بعضی اونها چک اینو میزنید"
    },
    {
      "id": 42,
      "start": 10292.94,
      "end": 10294.94,
      "formatted_start": "02:51:32.940",
      "formatted_end": "02:51:34.940",
      "text": "اونجا هر شب بردارید"
    },
    {
      "id": 43,
      "start": 10294.94,
      "end": 10296.94,
      "formatted_start": "02:51:34.940",
      "formatted_end": "02:51:36.940",
      "text": "بعضی اونها خشکه"
    },
    {
      "id": 44,
      "start": 10296.94,
      "end": 10298.94,
      "formatted_start": "02:51:36.940",
      "formatted_end": "02:51:38.940",
      "text": "کجا بردارید؟"
    },
    {
      "id": 45,
      "start": 10298.94,
      "end": 10300.94,
      "formatted_start": "02:51:38.940",
      "formatted_end": "02:51:40.940",
      "text": "همینجا بردارید"
    },
    {
      "id": 46,
      "start": 10300.94,
      "end": 10302.94,
      "formatted_start": "02:51:40.940",
      "formatted_end": "02:51:42.940",
      "text": "همینجا بردارید"
    },
    {
      "id": 47,
      "start": 10302.94,
      "end": 10304.94,
      "formatted_start": "02:51:42.940",
      "formatted_end": "02:51:44.940",
      "text": "این طبیعی اینو افونت می کنه"
    },
    {
      "id": 48,
      "start": 10304.94,
      "end": 10306.94,
      "formatted_start": "02:51:44.940",
      "formatted_end": "02:51:46.940",
      "text": "میزنید به اینجا"
    },
    {
      "id": 49,
      "start": 10306.94,
      "end": 10308.94,
      "formatted_start": "02:51:46.940",
      "formatted_end": "02:51:48.940",
      "text": "خون میشه اون خیلی خطرناکه"
    },
    {
      "id": 50,
      "start": 10308.94,
      "end": 10310.94,
      "formatted_start": "02:51:48.940",
      "formatted_end": "02:51:50.940",
      "text": "نه اگه من بگم تبیه نیسته"
    },
    {
      "id": 51,
      "start": 10310.94,
      "end": 10312.94,
      "formatted_start": "02:51:50.940",
      "formatted_end": "02:51:52.940",
      "text": "نه نه"
    },
    {
      "id": 52,
      "start": 10312.94,
      "end": 10314.94,
      "formatted_start": "02:51:52.940",
      "formatted_end": "02:51:54.940",
      "text": "یا باید جرا برداری"
    },
    {
      "id": 53,
      "start": 10314.94,
      "end": 10316.94,
      "formatted_start": "02:51:54.940",
      "formatted_end": "02:51:56.940",
      "text": "جرا برداری که از هم"
    },
    {
      "id": 54,
      "start": 10316.94,
      "end": 10318.94,
      "formatted_start": "02:51:56.940",
      "formatted_end": "02:51:58.940",
      "text": "خوشتون هم بی کنه با اون برداشته"
    },
    {
      "id": 55,
      "start": 10318.94,
      "end": 10320.94,
      "formatted_start": "02:51:58.940",
      "formatted_end": "02:52:00.940",
      "text": "اینجا باز برداری"
    },
    {
      "id": 56,
      "start": 10328.94,
      "end": 10330.94,
      "formatted_start": "02:52:08.940",
      "formatted_end": "02:52:10.940",
      "text": "باشه کمش راحت کار کنه"
    },
    {
      "id": 57,
      "start": 10330.94,
      "end": 10332.94,
      "formatted_start": "02:52:10.940",
      "formatted_end": "02:52:12.940",
      "text": "آیه سعیدی"
    },
    {
      "id": 58,
      "start": 10332.94,
      "end": 10334.94,
      "formatted_start": "02:52:12.940",
      "formatted_end": "02:52:14.940",
      "text": "دیگه هم تا قبل میدین که دوباره کار کنه"
    },
    {
      "id": 59,
      "start": 10334.94,
      "end": 10337.94,
      "formatted_start": "02:52:14.940",
      "formatted_end": "02:52:17.940",
      "text": "خوب کار میکرده بچه آقای خود"
    },
    {
      "id": 60,
      "start": 10337.94,
      "end": 10339.94,
      "formatted_start": "02:52:17.940",
      "formatted_end": "02:52:19.940",
      "text": "این چند روزه؟"
    },
    {
      "id": 61,
      "start": 10339.94,
      "end": 10341.94,
      "formatted_start": "02:52:19.940",
      "formatted_end": "02:52:21.940",
      "text": "آمدنیه درمت موجوده"
    },
    {
      "id": 62,
      "start": 10341.94,
      "end": 10342.94,
      "formatted_start": "02:52:21.940",
      "formatted_end": "02:52:22.940",
      "text": "خب برش"
    },
    {
      "id": 63,
      "start": 10342.94,
      "end": 10344.94,
      "formatted_start": "02:52:22.940",
      "formatted_end": "02:52:24.940",
      "text": "بعد آجبتون این دسمت رو پشت سرش"
    },
    {
      "id": 64,
      "start": 10344.94,
      "end": 10348.94,
      "formatted_start": "02:52:24.940",
      "formatted_end": "02:52:28.940",
      "text": "این دسمت نرمی کنه موانش یک عصیر منه"
    },
    {
      "id": 65,
      "start": 10348.94,
      "end": 10350.94,
      "formatted_start": "02:52:28.940",
      "formatted_end": "02:52:30.940",
      "text": "یک مقداری دیگه رو عادتی"
    },
    {
      "id": 66,
      "start": 10350.94,
      "end": 10352.94,
      "formatted_start": "02:52:30.940",
      "formatted_end": "02:52:32.940",
      "text": "این ملاجش خورده بگویده"
    },
    {
      "id": 67,
      "start": 10352.94,
      "end": 10354.94,
      "formatted_start": "02:52:32.940",
      "formatted_end": "02:52:34.940",
      "text": "نه این عشقل نداره"
    },
    {
      "id": 68,
      "start": 10354.94,
      "end": 10355.94,
      "formatted_start": "02:52:34.940",
      "formatted_end": "02:52:35.940",
      "text": "عشقل نداره"
    },
    {
      "id": 69,
      "start": 10355.94,
      "end": 10356.94,
      "formatted_start": "02:52:35.940",
      "formatted_end": "02:52:36.940",
      "text": "استخوان ها رو هم هستن"
    },
    {
      "id": 70,
      "start": 10356.94,
      "end": 10360.94,
      "formatted_start": "02:52:36.940",
      "formatted_end": "02:52:40.940",
      "text": "استخوان ها هفت هشت استخوان ها رو هم جان روش شدن"
    },
    {
      "id": 71,
      "start": 10360.94,
      "end": 10361.94,
      "formatted_start": "02:52:40.940",
      "formatted_end": "02:52:41.940",
      "text": "چرا؟"
    },
    {
      "id": 72,
      "start": 10361.94,
      "end": 10363.94,
      "formatted_start": "02:52:41.940",
      "formatted_end": "02:52:43.940",
      "text": "چی طبیعیه؟ خوب؟"
    },
    {
      "id": 73,
      "start": 10363.94,
      "end": 10364.94,
      "formatted_start": "02:52:43.940",
      "formatted_end": "02:52:44.940",
      "text": "خواهی زیدی؟"
    },
    {
      "id": 74,
      "start": 10364.94,
      "end": 10365.94,
      "formatted_start": "02:52:44.940",
      "formatted_end": "02:52:45.940",
      "text": "جمع"
    },
    {
      "id": 75,
      "start": 10365.94,
      "end": 10366.94,
      "formatted_start": "02:52:45.940",
      "formatted_end": "02:52:46.940",
      "text": "اینکه رو خدمت کن"
    },
    {
      "id": 76,
      "start": 10369.94,
      "end": 10371.94,
      "formatted_start": "02:52:49.940",
      "formatted_end": "02:52:51.940",
      "text": "من دارو بردارم"
    },
    {
      "id": 77,
      "start": 10371.94,
      "end": 10373.94,
      "formatted_start": "02:52:51.940",
      "formatted_end": "02:52:53.940",
      "text": "این دارو هاش آزاده"
    },
    {
      "id": 78,
      "start": 10373.94,
      "end": 10374.94,
      "formatted_start": "02:52:53.940",
      "formatted_end": "02:52:54.940",
      "text": "اشکال میکنه"
    },
    {
      "id": 79,
      "start": 10374.94,
      "end": 10375.94,
      "formatted_start": "02:52:54.940",
      "formatted_end": "02:52:55.940",
      "text": "یه شعبت روحان کرچکه"
    },
    {
      "id": 80,
      "start": 10375.94,
      "end": 10377.94,
      "formatted_start": "02:52:55.940",
      "formatted_end": "02:52:57.940",
      "text": "رازقسیمه"
    },
    {
      "id": 81,
      "start": 10377.94,
      "end": 10379.94,
      "formatted_start": "02:52:57.940",
      "formatted_end": "02:52:59.940",
      "text": "شکمش کار کنه"
    },
    {
      "id": 82,
      "start": 10379.94,
      "end": 10381.94,
      "formatted_start": "02:52:59.940",
      "formatted_end": "02:53:01.940",
      "text": "و برای نفخش چیزی میدین؟"
    },
    {
      "id": 83,
      "start": 10381.94,
      "end": 10383.94,
      "formatted_start": "02:53:01.940",
      "formatted_end": "02:53:03.940",
      "text": "نفخش"
    },
    {
      "id": 84,
      "start": 10383.94,
      "end": 10385.94,
      "formatted_start": "02:53:03.940",
      "formatted_end": "02:53:05.940",
      "text": "با کلیت شدید"
    },
    {
      "id": 85,
      "start": 10385.94,
      "end": 10387.94,
      "formatted_start": "02:53:05.940",
      "formatted_end": "02:53:07.940",
      "text": "با را"
    },
    {
      "id": 86,
      "start": 10387.94,
      "end": 10389.94,
      "formatted_start": "02:53:07.940",
      "formatted_end": "02:53:09.940",
      "text": "خب اینا آرومش میکنه"
    },
    {
      "id": 87,
      "start": 10389.94,
      "end": 10399.94,
      "formatted_start": "02:53:09.940",
      "formatted_end": "02:53:19.940",
      "text": "این شیاف و شربت بیارید"
    },
    {
      "id": 88,
      "start": 10399.94,
      "end": 10405.94,
      "formatted_start": "02:53:19.940",
      "formatted_end": "02:53:25.940",
      "text": "اگر شما درست دارید این شکل هایی تقنیه میشه"
    },
    {
      "id": 89,
      "start": 10405.94,
      "end": 10409.94,
      "formatted_start": "02:53:25.940",
      "formatted_end": "02:53:29.940",
      "text": "دارید یایی هم هست به نام فلوس"
    },
    {
      "id": 90,
      "start": 10409.94,
      "end": 10414.94,
      "formatted_start": "02:53:29.940",
      "formatted_end": "02:53:34.940",
      "text": "این چوبمانند فخ داره سیاره"
    },
    {
      "id": 91,
      "start": 10414.94,
      "end": 10417.94,
      "formatted_start": "02:53:34.940",
      "formatted_end": "02:53:37.940",
      "text": "این روزه رو بکنید و تو آب نیم گرد"
    },
    {
      "id": 92,
      "start": 10417.94,
      "end": 10420.94,
      "formatted_start": "02:53:37.940",
      "formatted_end": "02:53:40.940",
      "text": "لحن می کنید مثل این رو از آبش"
    },
    {
      "id": 93,
      "start": 10420.94,
      "end": 10423.94,
      "formatted_start": "02:53:40.940",
      "formatted_end": "02:53:43.940",
      "text": "ریکه دو قاشق صبح ریکه دو قاشق شب به بچه می دید"
    },
    {
      "id": 94,
      "start": 10423.94,
      "end": 10426.94,
      "formatted_start": "02:53:43.940",
      "formatted_end": "02:53:46.940",
      "text": "این روزه رو تند تند کار کنید و آزارو"
    },
    {
      "id": 95,
      "start": 10426.94,
      "end": 10429.94,
      "formatted_start": "02:53:46.940",
      "formatted_end": "02:53:49.940",
      "text": "نتیجه باید دفت بشه"
    },
    {
      "id": 96,
      "start": 10429.94,
      "end": 10432.94,
      "formatted_start": "02:53:49.940",
      "formatted_end": "02:53:52.940",
      "text": "این بنده ناخش جدا از بزیده"
    },
    {
      "id": 97,
      "start": 10432.94,
      "end": 10435.94,
      "formatted_start": "02:53:52.940",
      "formatted_end": "02:53:55.940",
      "text": "این کار درداری هست"
    },
    {
      "id": 98,
      "start": 10435.94,
      "end": 10438.94,
      "formatted_start": "02:53:55.940",
      "formatted_end": "02:53:58.940",
      "text": "هر رو می توانید یه دقیقه ما برد"
    },
    {
      "id": 99,
      "start": 10438.94,
      "end": 10441.94,
      "formatted_start": "02:53:58.940",
      "formatted_end": "02:54:01.940",
      "text": "من یه سری لوازی می لازمه"
    },
    {
      "id": 100,
      "start": 10441.94,
      "end": 10445.94,
      "formatted_start": "02:54:01.940",
      "formatted_end": "02:54:05.940",
      "text": "خب من رینا رو می رویستم اون لبازیم رو باید بیارید که من با اونا رو بیارید"
    },
    {
      "id": 101,
      "start": 10445.94,
      "end": 10449.94,
      "formatted_start": "02:54:05.940",
      "formatted_end": "02:54:09.940",
      "text": "چیز کنم و تقابل شمار نظر آمدیده برداشتشم یک و سی سره"
    },
    {
      "id": 102,
      "start": 10449.94,
      "end": 10451.94,
      "formatted_start": "02:54:09.940",
      "formatted_end": "02:54:11.940",
      "text": "اشکال نداریم"
    },
    {
      "id": 103,
      "start": 10451.94,
      "end": 10457.94,
      "formatted_start": "02:54:11.940",
      "formatted_end": "02:54:17.940",
      "text": "این توی شربه سفالکسین خوش کننده"
    },
    {
      "id": 104,
      "start": 10457.94,
      "end": 10460.94,
      "formatted_start": "02:54:17.940",
      "formatted_end": "02:54:20.940",
      "text": "توی می خواهم فماده به داری کافیه"
    },
    {
      "id": 105,
      "start": 10460.94,
      "end": 10463.94,
      "formatted_start": "02:54:20.940",
      "formatted_end": "02:54:23.940",
      "text": "نه نه خامسمی نمی خواهد"
    },
    {
      "id": 106,
      "start": 10463.94,
      "end": 10467.94,
      "formatted_start": "02:54:23.940",
      "formatted_end": "02:54:27.940",
      "text": "تترا سی کلینو بند رافه می خواهد برداریم"
    },
    {
      "id": 107,
      "start": 10467.94,
      "end": 10470.94,
      "formatted_start": "02:54:27.940",
      "formatted_end": "02:54:30.940",
      "text": "بعد چیز داریم چسپریم"
    },
    {
      "id": 108,
      "start": 10470.94,
      "end": 10474.94,
      "formatted_start": "02:54:30.940",
      "formatted_end": "02:54:34.940",
      "text": "به تعدیر هم که دارید درسته؟"
    },
    {
      "id": 109,
      "start": 10474.94,
      "end": 10483.94,
      "formatted_start": "02:54:34.940",
      "formatted_end": "02:54:43.940",
      "text": "یک گاز استرید، دو تا گاز استرید، یک عدد نخ بخیر"
    },
    {
      "id": 110,
      "start": 10483.94,
      "end": 10494.94,
      "formatted_start": "02:54:43.940",
      "formatted_end": "02:54:54.940",
      "text": "چار صفر، یک عدد پیغ پیستوری کوچک"
    },
    {
      "id": 111,
      "start": 10494.94,
      "end": 10499.98,
      "formatted_start": "02:54:54.940",
      "formatted_end": "02:54:59.980",
      "text": "شکر میکنم"
    }
  ],
  "status": "completed"
}