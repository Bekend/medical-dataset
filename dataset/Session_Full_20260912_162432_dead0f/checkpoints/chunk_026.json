  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7804.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:04.000",
      "text": "اینکه اون مقاعده از من نیستم، من گویم. شما هر چند سایت تو بلدیه."
    },
    {
      "id": 1,
      "start": 7804.0,
      "end": 7807.0,
      "formatted_start": "02:10:04.000",
      "formatted_end": "02:10:07.000",
      "text": "آره آره آره، دیمارستان معاین تره."
    },
    {
      "id": 2,
      "start": 7807.0,
      "end": 7809.0,
      "formatted_start": "02:10:07.000",
      "formatted_end": "02:10:09.000",
      "text": "آقای شازه ای؟ نمیشه."
    },
    {
      "id": 3,
      "start": 7809.0,
      "end": 7810.0,
      "formatted_start": "02:10:09.000",
      "formatted_end": "02:10:10.000",
      "text": "دیمارستان..."
    },
    {
      "id": 4,
      "start": 7810.0,
      "end": 7815.0,
      "formatted_start": "02:10:10.000",
      "formatted_end": "02:10:15.000",
      "text": "اونها از تو بومدن گرفتن، دستگاه رو نمیتونید. ساعتی یک بهشون بود."
    },
    {
      "id": 5,
      "start": 7815.0,
      "end": 7823.0,
      "formatted_start": "02:10:15.000",
      "formatted_end": "02:10:23.000",
      "text": "اما دستگاه اول کسی بید بردنگیدن، اول به شما دنگیدن. باشه؟ اول ساعتی که بعد از دو بیم به شما بگم."
    },
    {
      "id": 6,
      "start": 7830.0,
      "end": 7832.0,
      "formatted_start": "02:10:30.000",
      "formatted_end": "02:10:32.000",
      "text": "مانسانم خاموشی که؟"
    },
    {
      "id": 7,
      "start": 7832.0,
      "end": 7834.0,
      "formatted_start": "02:10:32.000",
      "formatted_end": "02:10:34.000",
      "text": "نه نه"
    },
    {
      "id": 8,
      "start": 7834.0,
      "end": 7836.0,
      "formatted_start": "02:10:34.000",
      "formatted_end": "02:10:36.000",
      "text": "این دیگه این سنده باشه"
    },
    {
      "id": 9,
      "start": 7836.0,
      "end": 7838.0,
      "formatted_start": "02:10:36.000",
      "formatted_end": "02:10:38.000",
      "text": "این دیگه؟"
    },
    {
      "id": 10,
      "start": 7838.0,
      "end": 7840.0,
      "formatted_start": "02:10:38.000",
      "formatted_end": "02:10:40.000",
      "text": "یه خانه"
    },
    {
      "id": 11,
      "start": 7840.0,
      "end": 7842.0,
      "formatted_start": "02:10:40.000",
      "formatted_end": "02:10:42.000",
      "text": "اونا که اینجوره نباشه"
    },
    {
      "id": 12,
      "start": 7842.0,
      "end": 7844.0,
      "formatted_start": "02:10:42.000",
      "formatted_end": "02:10:44.000",
      "text": "این لعبه ملیز نگه"
    },
    {
      "id": 13,
      "start": 7844.0,
      "end": 7846.0,
      "formatted_start": "02:10:44.000",
      "formatted_end": "02:10:46.000",
      "text": "میبون کسی هست؟"
    },
    {
      "id": 14,
      "start": 7846.0,
      "end": 7848.0,
      "formatted_start": "02:10:46.000",
      "formatted_end": "02:10:48.000",
      "text": "برون برون"
    },
    {
      "id": 15,
      "start": 7848.0,
      "end": 7850.0,
      "formatted_start": "02:10:48.000",
      "formatted_end": "02:10:50.000",
      "text": "برون"
    },
    {
      "id": 16,
      "start": 7850.0,
      "end": 7852.0,
      "formatted_start": "02:10:50.000",
      "formatted_end": "02:10:52.000",
      "text": "این شعبت ها روزی ثبت"
    },
    {
      "id": 17,
      "start": 7852.0,
      "end": 7854.0,
      "formatted_start": "02:10:52.000",
      "formatted_end": "02:10:54.000",
      "text": "و اصحاب"
    },
    {
      "id": 18,
      "start": 7854.0,
      "end": 7856.0,
      "formatted_start": "02:10:54.000",
      "formatted_end": "02:10:56.000",
      "text": "این"
    },
    {
      "id": 19,
      "start": 7856.0,
      "end": 7858.0,
      "formatted_start": "02:10:56.000",
      "formatted_end": "02:10:58.000",
      "text": "برای روزی ثبت"
    },
    {
      "id": 20,
      "start": 7858.0,
      "end": 7860.0,
      "formatted_start": "02:10:58.000",
      "formatted_end": "02:11:00.000",
      "text": "این باشه های طبعا بزرگ بچه ها هستن"
    },
    {
      "id": 21,
      "start": 7860.0,
      "end": 7862.0,
      "formatted_start": "02:11:00.000",
      "formatted_end": "02:11:02.000",
      "text": "میشه غذا خورید نه خور نداره"
    },
    {
      "id": 22,
      "start": 7862.0,
      "end": 7866.0,
      "formatted_start": "02:11:02.000",
      "formatted_end": "02:11:06.000",
      "text": "اینو یه بسته رو توی پنجان آب بینیده ده بخوره"
    },
    {
      "id": 23,
      "start": 7866.0,
      "end": 7868.0,
      "formatted_start": "02:11:06.000",
      "formatted_end": "02:11:08.000",
      "text": "اینو تو چهار تا دیوان بخوره"
    },
    {
      "id": 24,
      "start": 7868.0,
      "end": 7869.0,
      "formatted_start": "02:11:08.000",
      "formatted_end": "02:11:09.000",
      "text": "این آب دوشیده باشه؟"
    },
    {
      "id": 25,
      "start": 7869.0,
      "end": 7870.0,
      "formatted_start": "02:11:09.000",
      "formatted_end": "02:11:10.000",
      "text": "همه دوشیده"
    },
    {
      "id": 26,
      "start": 7870.0,
      "end": 7872.0,
      "formatted_start": "02:11:10.000",
      "formatted_end": "02:11:12.000",
      "text": "فرز یه فرز کم هست نصفه بگیر"
    },
    {
      "id": 27,
      "start": 7872.0,
      "end": 7874.0,
      "formatted_start": "02:11:12.000",
      "formatted_end": "02:11:14.000",
      "text": "چجوری بدنم آخور؟"
    },
    {
      "id": 28,
      "start": 7874.0,
      "end": 7876.0,
      "formatted_start": "02:11:14.000",
      "formatted_end": "02:11:16.000",
      "text": "نصفه دیگه، روزی سه بار"
    },
    {
      "id": 29,
      "start": 7876.0,
      "end": 7878.0,
      "formatted_start": "02:11:16.000",
      "formatted_end": "02:11:18.000",
      "text": "نصفش خونم آنو باشه"
    },
    {
      "id": 30,
      "start": 7878.0,
      "end": 7882.0,
      "formatted_start": "02:11:18.000",
      "formatted_end": "02:11:22.000",
      "text": "اگه اصال شدید باشه اتا کامل هم میشه"
    },
    {
      "id": 31,
      "start": 7912.0,
      "end": 7914.0,
      "formatted_start": "02:11:52.000",
      "formatted_end": "02:11:54.000",
      "text": "موسیقی"
    },
    {
      "id": 32,
      "start": 7942.0,
      "end": 7952.0,
      "formatted_start": "02:12:22.000",
      "formatted_end": "02:12:32.000",
      "text": "موسیقی"
    },
    {
