    },
    {
      "id": 37,
      "start": 7064.12,
      "end": 7066.12,
      "formatted_start": "01:57:44.120",
      "formatted_end": "01:57:46.120",
      "text": "نداری؟ آب دیده شیمنتی؟"
    },
    {
      "id": 38,
      "start": 7066.12,
      "end": 7067.12,
      "formatted_start": "01:57:46.120",
      "formatted_end": "01:57:47.120",
