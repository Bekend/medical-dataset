    },
    {
      "id": 33,
      "start": 7055.0,
      "end": 7057.52,
      "formatted_start": "01:57:35.000",
      "formatted_end": "01:57:37.520",
      "text": "واقعا اگر خورده بگی همینطوری"
    },
    {
      "id": 34,
      "start": 7057.52,
      "end": 7059.52,
      "formatted_start": "01:57:37.520",
      "formatted_end": "01:57:39.520",
      "text": "تو داروش زیاد نشد"
    },
    {
      "id": 35,
      "start": 7059.52,
      "end": 7063.12,
      "formatted_start": "01:57:39.520",
      "formatted_end": "01:57:43.120",
      "text": "خب اگر صرفه این زیاد داره"
    },
    {
      "id": 36,
      "start": 7063.12,
      "end": 7064.12,
      "formatted_start": "01:57:43.120",
      "formatted_end": "01:57:44.120",
