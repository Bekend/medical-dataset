      "id": 69,
      "start": 7135.12,
      "end": 7137.12,
      "formatted_start": "01:58:55.120",
      "formatted_end": "01:58:57.120",
      "text": "دارو میخوره"
    },
    {
      "id": 70,
      "start": 7137.12,
      "end": 7139.12,
      "formatted_start": "01:58:57.120",
      "formatted_end": "01:58:59.120",
      "text": "آنکول داره؟"
    },
    {
      "id": 71,
      "start": 7139.12,
      "end": 7141.12,
      "formatted_start": "01:58:59.120",
      "formatted_end": "01:59:01.120",
      "text": "هیوی منو هشت خودتان برم"
    },
    {
      "id": 72,
      "start": 7141.12,
      "end": 7145.12,
      "formatted_start": "01:59:01.120",
      "formatted_end": "01:59:05.120",
      "text": "اگر اشتفراخ شدید نداره"
    },
    {
      "id": 73,
      "start": 7145.12,
      "end": 7147.12,
      "formatted_start": "01:59:05.120",
      "formatted_end": "01:59:07.120",
      "text": "من یه بار دیشب"
    },
    {
      "id": 74,
      "start": 7147.12,
      "end": 7149.12,
      "formatted_start": "01:59:07.120",
      "formatted_end": "01:59:09.120",
      "text": "حتی تب هم نداشت دارشه آنکول نمیخوره"
    },
    {
      "id": 75,
      "start": 7149.12,
      "end": 7151.12,
      "formatted_start": "01:59:09.120",
      "formatted_end": "01:59:11.120",
      "text": "نه نداشت"
    },
    {
      "id": 76,
      "start": 7151.12,
      "end": 7155.12,
      "formatted_start": "01:59:11.120",
      "formatted_end": "01:59:15.120",
      "text": "خودت شما"
    },
    {
      "id": 77,
      "start": 7155.12,
      "end": 7157.12,
      "formatted_start": "01:59:15.120",
      "formatted_end": "01:59:17.120",
      "text": "این زرگاه هاش هم دیدی منو ببینم"
    },
    {
      "id": 78,
      "start": 7157.12,
      "end": 7159.12,
      "formatted_start": "01:59:17.120",
      "formatted_end": "01:59:19.120",
      "text": "باید برمونم"
    },
    {
      "id": 79,
      "start": 7161.12,
      "end": 7163.12,
      "formatted_start": "01:59:21.120",
      "formatted_end": "01:59:23.120",
      "text": "این همون چند ویروس که بخورده بود ویروس نیست"
    },
    {
      "id": 80,
      "start": 7163.12,
      "end": 7165.12,
      "formatted_start": "01:59:23.120",
      "formatted_end": "01:59:25.120",
      "text": "بچه ها خواهد ندارید"
    },
    {
      "id": 81,
      "start": 7165.12,
      "end": 7167.12,
      "formatted_start": "01:59:25.120",
      "formatted_end": "01:59:27.120",
      "text": "بله این چیز خواهده آروده بوده"
    },
