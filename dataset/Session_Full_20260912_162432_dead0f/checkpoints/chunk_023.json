    },
    {
      "id": 28,
      "start": 6992.0,
      "end": 6994.0,
      "formatted_start": "01:56:32.000",
      "formatted_end": "01:56:34.000",
      "text": "ولی اصحال داره، تب اینا چی؟"
    },
    {
      "id": 29,
      "start": 6994.0,
      "end": 6997.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:37.000",
      "text": "تب که نداره به نظرم ولی میدهش هم برم داره"
    },
    {
      "id": 30,
      "start": 6997.0,
      "end": 7000.0,
      "formatted_start": "01:56:37.000",
      "formatted_end": "01:56:40.000",
      "text": "میدهش هم نفت کرده، تب نداره، اصحال داره"
    },
    {
      "id": 31,
      "start": 7000.0,
      "end": 7003.0,
      "formatted_start": "01:56:40.000",
      "formatted_end": "01:56:43.000",
      "text": "میدهش یکی دو هفته یکی بالا بود"
    },
    {
      "id": 32,
      "start": 7033.0,
      "end": 7055.0,
      "formatted_start": "01:57:13.000",
      "formatted_end": "01:57:35.000",
