  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12008.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:08.000",
      "text": "اینجا باید آروم بشه بچه، یعنی شروط دیدین، آرام بخشون، چیزایی که دیوشتون بینا، بچه باید آروم باشی که اون بندناف خریده."
    },
    {
      "id": 1,
      "start": 12008.0,
      "end": 12009.0,
      "formatted_start": "03:20:08.000",
      "formatted_end": "03:20:09.000",
      "text": "ممنون ممنون."
    },
    {
      "id": 2,
      "start": 12009.0,
      "end": 12011.0,
      "formatted_start": "03:20:09.000",
      "formatted_end": "03:20:11.000",
      "text": "که چی رو خواهید برسی کنید؟"
    },
    {
      "id": 3,
      "start": 12011.0,
      "end": 12012.0,
      "formatted_start": "03:20:11.000",
      "formatted_end": "03:20:12.000",
      "text": "چی رو؟"
    },
    {
      "id": 4,
      "start": 12012.0,
      "end": 12013.0,
      "formatted_start": "03:20:12.000",
      "formatted_end": "03:20:13.000",
      "text": "ناوشو اولی نیست."
    },
    {
      "id": 5,
      "start": 12013.0,
      "end": 12020.0,
      "formatted_start": "03:20:13.000",
      "formatted_end": "03:20:20.000",
      "text": "ببینید که این ناو پیچ خورده گوید، ببینید اصلا روزای اول آوردی همون بندناف بوده شاید، همون بندناف نیفتاده بوده."
    },
    {
      "id": 6,
      "start": 12020.0,
      "end": 12022.0,
      "formatted_start": "03:20:20.000",
      "formatted_end": "03:20:22.000",
      "text": "و این چند روزی بهش خون اومد؟"
    },
    {
      "id": 7,
      "start": 12022.0,
      "end": 12027.0,
      "formatted_start": "03:20:22.000",
      "formatted_end": "03:20:27.000",
      "text": "بله، الان با فرمایی، مثلا بندن آف که میوفته اون پولیپه زیر آخهاشو نمایابده"
    },
    {
      "id": 8,
      "start": 12027.0,
      "end": 12030.0,
      "formatted_start": "03:20:27.000",
      "formatted_end": "03:20:30.000",
      "text": "آفای، اون بندن آف تا وقتی هست اصلا پولیپ نداریم"
    },
    {
      "id": 9,
      "start": 12030.0,
      "end": 12032.0,
      "formatted_start": "03:20:30.000",
      "formatted_end": "03:20:32.000",
      "text": "و بندن آف میوفته پولیپ گیره بشه"
    },
    {
      "id": 10,
      "start": 12032.0,
      "end": 12034.0,
      "formatted_start": "03:20:32.000",
      "formatted_end": "03:20:34.000",
      "text": "اصلا چند روزی بهش اومد؟"
    },
    {
      "id": 11,
      "start": 12034.0,
      "end": 12037.0,
      "formatted_start": "03:20:34.000",
      "formatted_end": "03:20:37.000",
      "text": "آره، ضروری است، این همون روزم که شما زندگی باشید"
    },
    {
      "id": 12,
      "start": 12041.0,
      "end": 12044.0,
      "formatted_start": "03:20:41.000",
      "formatted_end": "03:20:44.000",
      "text": "بفرمایی، سلامتون، خوبه، سلامتون"
    },
    {
      "id": 13,
      "start": 12044.0,
      "end": 12049.0,
      "formatted_start": "03:20:44.000",
      "formatted_end": "03:20:49.000",
      "text": "بگیر بگیر بگیر، چی شده؟ خانم؟"
    },
    {
      "id": 14,
      "start": 12050.0,
      "end": 12052.0,
      "formatted_start": "03:20:50.000",
      "formatted_end": "03:20:52.000",
      "text": "حسامون باید سی و دو روزش باشه"
    },
    {
      "id": 15,
      "start": 12052.0,
      "end": 12052.5,
      "formatted_start": "03:20:52.000",
      "formatted_end": "03:20:52.500",
      "text": "باید؟"
    },
    {
      "id": 16,
      "start": 12052.5,
      "end": 12056.0,
      "formatted_start": "03:20:52.500",
      "formatted_end": "03:20:56.000",
      "text": "بعد اصحال امروز سه روزه"
    },
    {
      "id": 17,
      "start": 12056.0,
      "end": 12058.0,
      "formatted_start": "03:20:56.000",
      "formatted_end": "03:20:58.000",
      "text": "برای ما بودم خوب شد خوب بشه دیگه"
    },
    {
      "id": 18,
      "start": 12058.0,
      "end": 12060.0,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:00.000",
      "text": "اصحالش هم سرکرنگ بود"
    },
    {
      "id": 19,
      "start": 12060.0,
      "end": 12064.0,
      "formatted_start": "03:21:00.000",
      "formatted_end": "03:21:04.000",
      "text": "امروز دیدم رقیق خون تو اصحالش بود"
    },
    {
      "id": 20,
      "start": 12064.0,
      "end": 12066.0,
      "formatted_start": "03:21:04.000",
      "formatted_end": "03:21:06.000",
      "text": "آسخون مهم بوده اصحالو خونی"
    },
    {
      "id": 21,
      "start": 12066.0,
      "end": 12068.0,
      "formatted_start": "03:21:06.000",
      "formatted_end": "03:21:08.000",
      "text": "قمرینا چی؟"
    },
    {
      "id": 22,
      "start": 12068.0,
      "end": 12070.0,
      "formatted_start": "03:21:08.000",
      "formatted_end": "03:21:10.000",
      "text": "جهان قمرینا سرکرنگ بود"
    },
    {
      "id": 23,
      "start": 12070.0,
      "end": 12073.0,
      "formatted_start": "03:21:10.000",
      "formatted_end": "03:21:13.000",
      "text": "نه قمره کلن قمره چی بشه خوب بود"
    },
    {
      "id": 24,
      "start": 12073.0,
      "end": 12074.0,
      "formatted_start": "03:21:13.000",
      "formatted_end": "03:21:14.000",
      "text": "استفراق اینا چی؟"
    },
    {
      "id": 25,
      "start": 12074.0,
      "end": 12075.0,
      "formatted_start": "03:21:14.000",
      "formatted_end": "03:21:15.000",
      "text": "نه نه استفراق اینا بود"
    },
    {
      "id": 26,
      "start": 12075.0,
      "end": 12076.0,
      "formatted_start": "03:21:15.000",
      "formatted_end": "03:21:16.000",
      "text": "بعد اصحال؟"
    },
    {
      "id": 27,
      "start": 12076.0,
      "end": 12077.0,
      "formatted_start": "03:21:16.000",
      "formatted_end": "03:21:17.000",
      "text": "آره"
    },
    {
      "id": 28,
      "start": 12077.0,
      "end": 12078.0,
      "formatted_start": "03:21:17.000",
      "formatted_end": "03:21:18.000",
      "text": "جا ماما"
    },
    {
      "id": 29,
      "start": 12080.0,
      "end": 12084.0,
      "formatted_start": "03:21:20.000",
      "formatted_end": "03:21:24.000",
      "text": "تب نکرده؟ از حال بودی که رقیق خون داشته"
    },
    {
      "id": 30,
      "start": 12084.0,
      "end": 12088.0,
      "formatted_start": "03:21:24.000",
      "formatted_end": "03:21:28.000",
      "text": "تب داره، لابرای یکم درخواسته"
    },
    {
      "id": 31,
      "start": 12093.0,
      "end": 12095.0,
      "formatted_start": "03:21:33.000",
      "formatted_end": "03:21:35.000",
      "text": "تب داره؟"
    },
    {
      "id": 32,
      "start": 12095.0,
      "end": 12096.0,
      "formatted_start": "03:21:35.000",
      "formatted_end": "03:21:36.000",
      "text": "یکم درخواسته"
    },
    {
      "id": 33,
      "start": 12096.0,
      "end": 12097.0,
      "formatted_start": "03:21:36.000",
      "formatted_end": "03:21:37.000",
      "text": "نه، این بیشتره؟"
    },
    {
      "id": 34,
      "start": 12097.0,
      "end": 12098.0,
      "formatted_start": "03:21:37.000",
      "formatted_end": "03:21:38.000",
      "text": "این نیسته"
    },
    {
      "id": 35,
      "start": 12098.0,
      "end": 12101.0,
      "formatted_start": "03:21:38.000",
      "formatted_end": "03:21:41.000",
      "text": "نه، اونه تب نمیدونه"
    },
    {
      "id": 36,
      "start": 12104.0,
      "end": 12106.0,
      "formatted_start": "03:21:44.000",
      "formatted_end": "03:21:46.000",
      "text": "کمی داره؟"
    },
    {
      "id": 37,
      "start": 12106.0,
      "end": 12108.0,
      "formatted_start": "03:21:46.000",
      "formatted_end": "03:21:48.000",
      "text": "32 درخواسته"
    },
    {
      "id": 38,
      "start": 12110.0,
      "end": 12112.0,
      "formatted_start": "03:21:50.000",
      "formatted_end": "03:21:52.000",
      "text": "کسی اینجا تو خانواده که درست کن"
    },
    {
