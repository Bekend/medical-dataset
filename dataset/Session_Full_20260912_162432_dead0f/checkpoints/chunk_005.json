      "formatted_end": "00:25:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 1530.0,
      "end": 1548.0,
      "formatted_start": "00:25:30.000",
      "formatted_end": "00:25:48.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 1560.0,
      "end": 1582.0,
      "formatted_start": "00:26:00.000",
      "formatted_end": "00:26:22.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 1582.0,
      "end": 1584.0,
      "formatted_start": "00:26:22.000",
      "formatted_end": "00:26:24.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 1612.0,
      "end": 1633.0,
      "formatted_start": "00:26:52.000",
      "formatted_end": "00:27:13.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 1633.0,
      "end": 1639.04,
      "formatted_start": "00:27:13.000",
      "formatted_end": "00:27:19.040",
      "text": "بازدن تو نه اشق و نه عادتی"
    },
    {
      "id": 6,
      "start": 1639.04,
      "end": 1645.92,
      "formatted_start": "00:27:19.040",
      "formatted_end": "00:27:25.920",
      "text": "دیدن تو به حرمت زیارت اممام تو"
    },
    {
      "id": 7,
      "start": 1645.92,
      "end": 1652.92,
      "formatted_start": "00:27:25.920",
      "formatted_end": "00:27:32.920",
      "text": "تو رد تا یه تو گمشم فراش و دندر تو برام نمایده"
    },
    {
      "id": 8,
      "start": 1652.92,
      "end": 1662.4,
      "formatted_start": "00:27:32.920",
      "formatted_end": "00:27:42.400",
      "text": "نیاز تو چرا به خونه یه منه هر جا باشی"
    },
    {
      "id": 9,
      "start": 1662.4,
      "end": 1668.26,
      "formatted_start": "00:27:42.400",
      "formatted_end": "00:27:48.260",
      "text": "چرا به خونت روشنه یادت باشه"
    },
    {
      "id": 10,
      "start": 1668.26,
      "end": 1674.76,
      "formatted_start": "00:27:48.260",
      "formatted_end": "00:27:54.760",
      "text": "از تو اگه من نباشم یکی تو رو تو خونه پر یاد میزنه"
    },
    {
      "id": 11,
      "start": 1692.4,
      "end": 1695.4,
      "formatted_start": "00:28:12.400",
      "formatted_end": "00:28:15.400",
      "text": "بی خود با تو بودم من"
    },
    {
      "id": 12,
      "start": 1695.4,
      "end": 1698.4,
      "formatted_start": "00:28:15.400",
      "formatted_end": "00:28:18.400",
      "text": "مسته به تو رسیدنم"
    },
    {
      "id": 13,
      "start": 1698.4,
      "end": 1701.4,
      "formatted_start": "00:28:18.400",
      "formatted_end": "00:28:21.400",
      "text": "مسته از روح شدن"
    },
    {
      "id": 14,
      "start": 1701.4,
      "end": 1703.4,
      "formatted_start": "00:28:21.400",
      "formatted_end": "00:28:23.400",
      "text": "خراب عشق تو منم"
    },
    {
      "id": 15,
      "start": 1703.4,
      "end": 1706.4,
      "formatted_start": "00:28:23.400",
      "formatted_end": "00:28:26.400",
      "text": "خراب عشق تو منم"
    },
    {
      "id": 16,
      "start": 1706.4,
      "end": 1708.4,
      "formatted_start": "00:28:26.400",
      "formatted_end": "00:28:28.400",
      "text": "خراب عشق تو منم"
    },
    {
      "id": 17,
      "start": 1708.4,
      "end": 1711.4,
      "formatted_start": "00:28:28.400",
      "formatted_end": "00:28:31.400",
      "text": "باستن تو"
    },
    {
      "id": 18,
      "start": 1711.4,
      "end": 1714.4,
      "formatted_start": "00:28:31.400",
      "formatted_end": "00:28:34.400",
      "text": "نه عشق بود نه عادته"
    },
    {
      "id": 19,
      "start": 1714.4,
      "end": 1717.4,
      "formatted_start": "00:28:34.400",
      "formatted_end": "00:28:37.400",
      "text": "دیدن تو"
    },
    {
      "id": 20,
      "start": 1717.4,
      "end": 1719.4,
      "formatted_start": "00:28:37.400",
      "formatted_end": "00:28:39.400",
      "text": "به غرمت زیارته"
    },
    {
      "id": 21,
      "start": 1719.4,
      "end": 1723.82,
      "formatted_start": "00:28:39.400",
      "formatted_end": "00:28:43.820",
      "text": "اما میخوام تو دستو یه دو گم بشم"
    },
    {
      "id": 22,
      "start": 1723.82,
      "end": 1727.92,
      "formatted_start": "00:28:43.820",
      "formatted_end": "00:28:47.920",
      "text": "برای شدن زرد و برای نفای افتیم"
    },
    {
      "id": 23,
      "start": 1727.92,
      "end": 1741.4,
      "formatted_start": "00:28:47.920",
      "formatted_end": "00:29:01.400",
      "text": "موسیقی"
    },
    {
      "id": 24,
      "start": 1741.4,
      "end": 1746.4,
      "formatted_start": "00:29:01.400",
      "formatted_end": "00:29:06.400",
      "text": "همقدر میخوام حتی اگه پشت دیدارو خوب باشه"
    },
    {
      "id": 25,
      "start": 1746.4,
      "end": 1752.46,
      "formatted_start": "00:29:06.400",
      "formatted_end": "00:29:12.460",
      "text": "باشه یادت باشه چرا به پونمون واسه تو روشنه"
    },
    {
      "id": 26,
      "start": 1752.46,
      "end": 1759.12,
      "formatted_start": "00:29:12.460",
      "formatted_end": "00:29:19.120",
      "text": "هم تو اگه من نباشم چرا برم تو پونمون"
    },
    {
      "id": 27,
      "start": 1759.12,
      "end": 1765.22,
      "formatted_start": "00:29:19.120",
      "formatted_end": "00:29:25.220",
      "text": "تا تو بیار همیشه توسو میدنه"
    },
    {
      "id": 28,
      "start": 1765.22,
      "end": 1772.58,
      "formatted_start": "00:29:25.220",
      "formatted_end": "00:29:32.580",
      "text": "هر کنی من زمزمه یه فاهشه"
    },
    {
      "id": 29,
      "start": 1772.58,
      "end": 1775.24,
      "formatted_start": "00:29:32.580",
      "formatted_end": "00:29:35.240",
      "text": "نه انتماس"
    },
    {
      "id": 30,
      "start": 1775.24,
      "end": 1778.0,
      "formatted_start": "00:29:35.240",
      "formatted_end": "00:29:38.000",
      "text": "نه خواهشه نه بازشه"
    },
    {
      "id": 31,
      "start": 1778.0,
      "end": 1779.7,
      "formatted_start": "00:29:38.000",
      "formatted_end": "00:29:39.700",
      "text": "بقیه تویی"
    },
    {
      "id": 32,
      "start": 1779.7,
      "end": 1782.14,
      "formatted_start": "00:29:39.700",
      "formatted_end": "00:29:42.140",
      "text": "برم به همه وجود من"
    },
    {
      "id": 33,
      "start": 1782.14,
      "end": 1783.18,
      "formatted_start": "00:29:42.140",
      "formatted_end": "00:29:43.180",
      "text": "وقت دو"
    },
    {
      "id": 34,
      "start": 1783.18,
      "end": 1785.82,
      "formatted_start": "00:29:43.180",
      "formatted_end": "00:29:45.820",
      "text": "دم دمه یه وجود من"
    }
  ],
  "status": "completed"
}