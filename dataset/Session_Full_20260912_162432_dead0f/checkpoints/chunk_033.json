      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 9960.0,
      "end": 9988.0,
      "formatted_start": "02:46:00.000",
      "formatted_end": "02:46:28.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 9990.0,
      "end": 10004.0,
      "formatted_start": "02:46:30.000",
      "formatted_end": "02:46:44.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 10004.0,
      "end": 10006.24,
      "formatted_start": "02:46:44.000",
      "formatted_end": "02:46:46.240",
      "text": "هشتاده شیش، هفتاده چار، صف"
    },
    {
      "id": 5,
      "start": 10006.24,
      "end": 10008.24,
      "formatted_start": "02:46:46.240",
      "formatted_end": "02:46:48.240",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 10020.0,
      "end": 10040.0,
      "formatted_start": "02:47:00.000",
      "formatted_end": "02:47:20.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 10050.0,
      "end": 10078.0,
      "formatted_start": "02:47:30.000",
      "formatted_end": "02:47:58.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 10080.0,
      "end": 10100.0,
      "formatted_start": "02:48:00.000",
      "formatted_end": "02:48:20.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 10100.0,
      "end": 10102.0,
      "formatted_start": "02:48:20.000",
      "formatted_end": "02:48:22.000",
      "text": "سلام"
    },
    {
      "id": 10,
      "start": 10102.0,
      "end": 10108.0,
      "formatted_start": "02:48:22.000",
      "formatted_end": "02:48:28.000",
      "text": "گفتم این هفته سرما خورده بود و خوب شاده از اون هفته"
    },
    {
      "id": 11,
      "start": 10108.0,
      "end": 10110.0,
      "formatted_start": "02:48:28.000",
      "formatted_end": "02:48:30.000",
      "text": "اول هفته اون یه هفته داره میبنه ود شده"
    },
    {
      "id": 12,
      "start": 10110.0,
      "end": 10112.0,
      "formatted_start": "02:48:30.000",
      "formatted_end": "02:48:32.000",
      "text": "اینجا غذا نمیخورند"
    },
    {
      "id": 13,
      "start": 10112.0,
      "end": 10116.0,
      "formatted_start": "02:48:32.000",
      "formatted_end": "02:48:36.000",
      "text": "سرما خورده ای که ارتباط نداره"
    },
    {
      "id": 14,
      "start": 10116.0,
      "end": 10118.0,
      "formatted_start": "02:48:36.000",
      "formatted_end": "02:48:38.000",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 10118.0,
      "end": 10120.0,
      "formatted_start": "02:48:38.000",
      "formatted_end": "02:48:40.000",
      "text": "سرما میخورند و بعد هم بسکوی بادر میخورند"
    },
    {
      "id": 16,
      "start": 10120.0,
      "end": 10122.0,
      "formatted_start": "02:48:40.000",
      "formatted_end": "02:48:42.000",
      "text": "سمیشه قده؟"
    },
    {
      "id": 17,
      "start": 10122.0,
      "end": 10124.0,
      "formatted_start": "02:48:42.000",
      "formatted_end": "02:48:44.000",
      "text": "10 ماشه"
    },
    {
      "id": 18,
      "start": 10124.0,
      "end": 10126.0,
      "formatted_start": "02:48:44.000",
      "formatted_end": "02:48:46.000",
      "text": "و بیتامین آهمیشون رو مورد تقوی میدید"
    },
    {
      "id": 19,
      "start": 10126.0,
      "end": 10131.0,
      "formatted_start": "02:48:46.000",
      "formatted_end": "02:48:51.000",
      "text": "چون کمبود آهن بیشتایی بوده، کمبود ویتامین ها بیشتایی بوده"
    },
    {
      "id": 20,
      "start": 10131.0,
      "end": 10135.0,
      "formatted_start": "02:48:51.000",
      "formatted_end": "02:48:55.000",
      "text": "چند وقت که آهن کمبود نده در برگونه شد کنم؟"
    },
    {
      "id": 21,
      "start": 10135.0,
      "end": 10138.0,
      "formatted_start": "02:48:55.000",
      "formatted_end": "02:48:58.000",
      "text": "خب در برگونه چی بلیده؟ آهن نده"
    },
    {
      "id": 22,
      "start": 10138.0,
      "end": 10144.0,
      "formatted_start": "02:48:58.000",
      "formatted_end": "02:49:04.000",
      "text": "شما باید آهن بیشتایی بوده، آهن یکی از چیزها وقتی میدن بیشتایی برد شدن خلق و خلق بکشه"
    },
    {
      "id": 23,
      "start": 10144.0,
      "end": 10146.0,
      "formatted_start": "02:49:04.000",
      "formatted_end": "02:49:06.000",
      "text": "دراصل این خیلی عالی هست"
    },
    {
      "id": 24,
      "start": 10146.0,
      "end": 10149.0,
      "formatted_start": "02:49:06.000",
      "formatted_end": "02:49:09.000",
      "text": "مثلا اینو بهش ندی سرشون رو کربونه"
    },
    {
      "id": 25,
      "start": 10149.0,
      "end": 10151.0,
      "formatted_start": "02:49:09.000",
      "formatted_end": "02:49:11.000",
      "text": "یا بقال هرکی وای نیسته"
    },
    {
      "id": 26,
      "start": 10151.0,
      "end": 10153.0,
      "formatted_start": "02:49:11.000",
      "formatted_end": "02:49:13.000",
      "text": "یه این خود چی شده"
    },
    {
      "id": 27,
      "start": 10153.0,
      "end": 10155.0,
      "formatted_start": "02:49:13.000",
      "formatted_end": "02:49:15.000",
      "text": "این هم چون آهن بدنشون کم میشه"
    },
    {
      "id": 28,
      "start": 10155.0,
      "end": 10157.0,
      "formatted_start": "02:49:15.000",
      "formatted_end": "02:49:17.000",
      "text": "اولین چیز خود و خوشون بدن میشه"
    },
    {
      "id": 29,
      "start": 10157.0,
      "end": 10159.0,
      "formatted_start": "02:49:17.000",
      "formatted_end": "02:49:19.000",
      "text": "و بعد بی اشتراک میشه"
    },
    {
      "id": 30,
      "start": 10159.0,
      "end": 10161.0,
      "formatted_start": "02:49:19.000",
      "formatted_end": "02:49:21.000",
      "text": "شما آهن از این یک پرزوماله"
    },
    {
      "id": 31,
      "start": 10161.0,
      "end": 10163.0,
      "formatted_start": "02:49:21.000",
      "formatted_end": "02:49:23.000",
      "text": "آهنهای خود میشه"
    },
    {
      "id": 32,
      "start": 10163.0,
      "end": 10165.0,
      "formatted_start": "02:49:23.000",
      "formatted_end": "02:49:25.000",
      "text": "از هم میدادم در این شبایی که شده بود"
    },
    {
      "id": 33,
      "start": 10165.0,
      "end": 10167.0,
      "formatted_start": "02:49:25.000",
      "formatted_end": "02:49:27.000",
      "text": "آخر یه جا رو بگم ازتر آهن"
    },
    {
      "id": 34,
      "start": 10167.0,
      "end": 10169.0,
      "formatted_start": "02:49:27.000",
      "formatted_end": "02:49:29.000",
      "text": "و بهش نرویم"
    },
    {
      "id": 35,
      "start": 10169.0,
      "end": 10171.0,
      "formatted_start": "02:49:29.000",
      "formatted_end": "02:49:31.000",
      "text": "و از اینترنت"
    },
    {
      "id": 36,
      "start": 10171.0,
      "end": 10173.0,
      "formatted_start": "02:49:31.000",
      "formatted_end": "02:49:33.000",
      "text": "بس یلا مطالبه نیست"
    },
    {
      "id": 37,
      "start": 10173.0,
      "end": 10175.0,
      "formatted_start": "02:49:33.000",
      "formatted_end": "02:49:35.000",
      "text": "اونها از چفته پردن"
    },
    {
      "id": 38,
      "start": 10175.0,
      "end": 10177.0,
      "formatted_start": "02:49:35.000",
      "formatted_end": "02:49:37.000",
      "text": "اکثران دروره"
    },
    {
      "id": 39,
      "start": 10177.0,
      "end": 10179.0,
      "formatted_start": "02:49:37.000",
      "formatted_end": "02:49:39.000",
      "text": "او برنن هم نهالو پاش برنن"
    },
    {
      "id": 40,
      "start": 10179.0,
      "end": 10184.0,
      "formatted_start": "02:49:39.000",
      "formatted_end": "02:49:44.000",
      "text": "حالا اگر توسیع می کنم شما یه دو سه هفته آهنگ و بیتامیناش رو سر سر بده"
    },
    {
      "id": 41,
      "start": 10184.0,
      "end": 10186.0,
      "formatted_start": "02:49:44.000",
      "formatted_end": "02:49:46.000",
      "text": "انا دقناشو برم آهنگ بدم اونو"
    },
    {
      "id": 42,
      "start": 10186.0,
      "end": 10187.0,
      "formatted_start": "02:49:46.000",
      "formatted_end": "02:49:47.000",
      "text": "با بیتامین برد برد برد"
    },
    {
      "id": 43,
      "start": 10187.0,
      "end": 10191.0,
      "formatted_start": "02:49:47.000",
      "formatted_end": "02:49:51.000",
