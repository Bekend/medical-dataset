  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4213.52,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:13.520",
      "text": "در غایت خود خواهی، در انبوه زیر، جز خود نمیشه میدم."
    },
    {
      "id": 1,
      "start": 4215.08,
      "end": 4223.9,
      "formatted_start": "01:10:15.080",
      "formatted_end": "01:10:23.900",
      "text": "خروشان و بست چشم، با کول باری از خشم."
    },
    {
      "id": 2,
      "start": 4223.9,
      "end": 4230.76,
      "formatted_start": "01:10:23.900",
      "formatted_end": "01:10:30.760",
      "text": "میره تم از خشم خود دنیا ویران سازم"
    },
    {
      "id": 3,
      "start": 4230.76,
      "end": 4237.14,
      "formatted_start": "01:10:30.760",
      "formatted_end": "01:10:37.140",
      "text": "در ده تر زندگی از خود افثان سازم"
    },
    {
      "id": 4,
      "start": 4237.14,
      "end": 4244.54,
      "formatted_start": "01:10:37.140",
      "formatted_end": "01:10:44.540",
      "text": "اما زبازی زمان گم را پوافل بودم"
    },
    {
      "id": 5,
      "start": 4244.54,
      "end": 4251.84,
      "formatted_start": "01:10:44.540",
      "formatted_end": "01:10:51.840",
      "text": "در اونجه پرواز خواهی خواهشه بودم"
    },
    {
      "id": 6,
      "start": 4251.84,
      "end": 4259.46,
      "formatted_start": "01:10:51.840",
      "formatted_end": "01:10:59.460",
      "text": "در سر نبودن دیشه ی جز فکر بیرانگری"
    },
    {
      "id": 7,
      "start": 4259.46,
      "end": 4267.22,
      "formatted_start": "01:10:59.460",
      "formatted_end": "01:11:07.220",
      "text": "غافل من از افسادی تو بودم"
    },
    {
      "id": 8,
      "start": 4267.22,
      "end": 4271.22,
      "formatted_start": "01:11:07.220",
      "formatted_end": "01:11:11.220",
      "text": "ماجم ولی خاموش و خسته"
    },
    {
      "id": 9,
      "start": 4271.22,
      "end": 4275.92,
      "formatted_start": "01:11:11.220",
      "formatted_end": "01:11:15.920",
      "text": "با دست خود در هم شکسته"
    },
    {
      "id": 10,
      "start": 4275.92,
      "end": 4281.14,
      "formatted_start": "01:11:15.920",
      "formatted_end": "01:11:21.140",
      "text": "آری منم کوه غرورم"
    },
    {
      "id": 11,
      "start": 4281.14,
      "end": 4285.92,
      "formatted_start": "01:11:21.140",
      "formatted_end": "01:11:25.920",
      "text": "در منده و اسپا نشسته"
    },
    {
      "id": 12,
      "start": 4311.14,
      "end": 4335.14,
      "formatted_start": "01:11:51.140",
      "formatted_end": "01:12:15.140",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 4335.14,
      "end": 4344.38,
      "formatted_start": "01:12:15.140",
      "formatted_end": "01:12:24.380",
      "text": "پیچیده توفان در وجودم شد پار از هم تارو کودم"
    },
    {
      "id": 14,
      "start": 4344.38,
      "end": 4355.14,
      "formatted_start": "01:12:24.380",
      "formatted_end": "01:12:35.140",
      "text": "در لحظه های بار پس این پی که عجل آمد مرا افتادم و از پانش هستم"
    },
    {
      "id": 15,
      "start": 4355.14,
      "end": 4364.04,
      "formatted_start": "01:12:35.140",
      "formatted_end": "01:12:44.040",
      "text": "بیداد توفانان چنان بر سنگ ساحل زد مرا"
    },
    {
      "id": 16,
      "start": 4364.04,
      "end": 4368.34,
      "formatted_start": "01:12:44.040",
      "formatted_end": "01:12:48.340",
      "text": "چون شیشی در هم شکستن"
    },
    {
      "id": 17,
      "start": 4368.34,
      "end": 4376.24,
      "formatted_start": "01:12:48.340",
      "formatted_end": "01:12:56.240",
      "text": "گفتم به خود ای ماجه زرگردان که آخر"
    },
    {
      "id": 18,
      "start": 4376.24,
      "end": 4382.24,
      "formatted_start": "01:12:56.240",
      "formatted_end": "01:13:02.240",
      "text": "بنگرم به خود چه بودی و مکنون چه خستی"
    },
    {
      "id": 19,
      "start": 4382.24,
      "end": 4388.82,
      "formatted_start": "01:13:02.240",
      "formatted_end": "01:13:08.820",
      "text": "خاصل چه بود از آن قرور بی دلیلت"
    },
    {
      "id": 20,
      "start": 4388.82,
      "end": 4395.28,
      "formatted_start": "01:13:08.820",
      "formatted_end": "01:13:15.280",
      "text": "آخر به دست سخقه ساحه شکستی"
    },
    {
      "id": 21,
      "start": 4395.28,
      "end": 4400.08,
      "formatted_start": "01:13:15.280",
      "formatted_end": "01:13:20.080",
      "text": "مجمولی خواهش و خسته"
    },
    {
      "id": 22,
      "start": 4400.08,
      "end": 4404.84,
      "formatted_start": "01:13:20.080",
      "formatted_end": "01:13:24.840",
      "text": "با دست خود در هم شکسته"
    },
    {
      "id": 23,
      "start": 4404.84,
      "end": 4409.8,
      "formatted_start": "01:13:24.840",
      "formatted_end": "01:13:29.800",
      "text": "آی منم کوه قرورم"
    },
    {
      "id": 24,
      "start": 4409.8,
      "end": 4414.24,
      "formatted_start": "01:13:29.800",
      "formatted_end": "01:13:34.240",
      "text": "درمانده و از پا بشسته"
    },
    {
      "id": 25,
      "start": 4414.24,
      "end": 4419.24,
      "formatted_start": "01:13:34.240",
      "formatted_end": "01:13:39.240",
      "text": "ماجم ولی خاموش و خسته"
    },
    {
      "id": 26,
      "start": 4419.24,
      "end": 4424.2,
      "formatted_start": "01:13:39.240",
      "formatted_end": "01:13:44.200",
      "text": "با دست خود در هم شکسته"
    },
    {
      "id": 27,
      "start": 4424.2,
      "end": 4429.12,
      "formatted_start": "01:13:44.200",
      "formatted_end": "01:13:49.120",
      "text": "آری من و کوه غرورم"
    },
    {
      "id": 28,
      "start": 4429.12,
      "end": 4436.5,
      "formatted_start": "01:13:49.120",
      "formatted_end": "01:13:56.500",
      "text": "درمانده و از پا بشسته"
    },
    {
      "id": 29,
      "start": 4439.8,
      "end": 4469.78,
      "formatted_start": "01:13:59.800",
      "formatted_end": "01:14:29.780",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 30,
      "start": 4469.8,
      "end": 4492.8,
      "formatted_start": "01:14:29.800",
      "formatted_end": "01:14:52.800",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 4492.8,
      "end": 4500.0,
      "formatted_start": "01:14:52.800",
      "formatted_end": "01:15:00.000",
      "text": "منم موجب بی آراسم"
    }
