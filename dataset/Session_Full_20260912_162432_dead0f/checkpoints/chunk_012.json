      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3633.66,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:33.660",
      "text": "در سفرت گون مرا"
    },
    {
      "id": 2,
      "start": 3633.66,
      "end": 3638.82,
      "formatted_start": "01:00:33.660",
      "formatted_end": "01:00:38.820",
      "text": "سر بلن کن موقع مرشو"
    },
    {
      "id": 3,
      "start": 3638.82,
      "end": 3642.28,
      "formatted_start": "01:00:38.820",
      "formatted_end": "01:00:42.280",
      "text": "غرب حیرت کن مرا"
    },
    {
      "id": 4,
      "start": 3642.28,
      "end": 3647.48,
      "formatted_start": "01:00:42.280",
      "formatted_end": "01:00:47.480",
      "text": "عاشقم من پیش مردم"
    },
    {
      "id": 5,
      "start": 3647.48,
      "end": 3652.04,
      "formatted_start": "01:00:47.480",
      "formatted_end": "01:00:52.040",
      "text": "در سفرت گون مرا"
    },
    {
      "id": 6,
      "start": 3660.0,
      "end": 3688.0,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:28.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 3688.0,
      "end": 3697.14,
      "formatted_start": "01:01:28.000",
      "formatted_end": "01:01:37.140",
      "text": "در چشم آشق قدردیش که بر جان من افتاده است"
    },
    {
      "id": 8,
      "start": 3697.14,
      "end": 3706.14,
      "formatted_start": "01:01:37.140",
      "formatted_end": "01:01:46.140",
      "text": "به نازم این قلندر را هنوز از بانه یفتاده است"
    },
    {
      "id": 9,
      "start": 3706.14,
      "end": 3711.54,
      "formatted_start": "01:01:46.140",
      "formatted_end": "01:01:51.540",
      "text": "هنوز از بانه یفتاده است"
    },
    {
      "id": 10,
      "start": 3718.0,
      "end": 3726.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:06.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 3748.0,
      "end": 3750.0,
      "formatted_start": "01:02:28.000",
      "formatted_end": "01:02:30.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 3778.0,
      "end": 3780.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:00.000",
      "text": "آره آره دستگاهی مطبع"
    },
    {
      "id": 13,
      "start": 3780.0,
      "end": 3780.5,
      "formatted_start": "01:03:00.000",
      "formatted_end": "01:03:00.500",
      "text": "درسته؟"
    },
    {
      "id": 14,
      "start": 3780.5,
      "end": 3781.0,
      "formatted_start": "01:03:00.500",
      "formatted_end": "01:03:01.000",
      "text": "آره آره"
    },
    {
      "id": 15,
      "start": 3781.0,
      "end": 3783.0,
      "formatted_start": "01:03:01.000",
      "formatted_end": "01:03:03.000",
      "text": "چارتا میخوایی؟ مطبع دارین چارتا؟"
    },
    {
      "id": 16,
      "start": 3783.0,
      "end": 3784.0,
      "formatted_start": "01:03:03.000",
      "formatted_end": "01:03:04.000",
      "text": "اعتمالا باید باشه"
    },
    {
      "id": 17,
      "start": 3784.0,
      "end": 3786.0,
      "formatted_start": "01:03:04.000",
      "formatted_end": "01:03:06.000",
      "text": "به خانو سمیه یه زنگ بزن بهش بگو"
    },
    {
      "id": 18,
      "start": 3786.0,
      "end": 3788.0,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:08.000",
      "text": "امروز یه هفت هشتایی میاد"
    },
    {
      "id": 19,
      "start": 3788.0,
      "end": 3790.0,
      "formatted_start": "01:03:08.000",
      "formatted_end": "01:03:10.000",
      "text": "چون باشه"
    },
    {
      "id": 20,
      "start": 3790.0,
      "end": 3792.0,
      "formatted_start": "01:03:10.000",
      "formatted_end": "01:03:12.000",
      "text": "آه خیلی خوب بس الان من زنگ بزنم"
    },
    {
      "id": 21,
      "start": 3792.0,
      "end": 3794.0,
      "formatted_start": "01:03:12.000",
      "formatted_end": "01:03:14.000",
      "text": "باشه باشه"
    },
    {
      "id": 22,
      "start": 3808.0,
      "end": 3812.44,
      "formatted_start": "01:03:28.000",
      "formatted_end": "01:03:32.440",
      "text": "داده در کنجه سر موید"
    },
    {
      "id": 23,
      "start": 3812.44,
      "end": 3817.28,
      "formatted_start": "01:03:32.440",
      "formatted_end": "01:03:37.280",
      "text": "من از سمت سپاهش بازان"
    },
    {
      "id": 24,
      "start": 3817.28,
      "end": 3821.38,
      "formatted_start": "01:03:37.280",
      "formatted_end": "01:03:41.380",
      "text": "آمدم سوید که مندیسم"
    },
    {
      "id": 25,
      "start": 3821.38,
      "end": 3827.14,
      "formatted_start": "01:03:41.380",
      "formatted_end": "01:03:47.140",
      "text": "خجالت می کشد ما از گل روید"
    },
    {
      "id": 26,
      "start": 3827.14,
      "end": 3831.52,
      "formatted_start": "01:03:47.140",
      "formatted_end": "01:03:51.520",
