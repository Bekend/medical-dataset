  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1808.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:08.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 1830.0,
      "end": 1853.78,
      "formatted_start": "00:30:30.000",
      "formatted_end": "00:30:53.780",
      "text": "برنامه از این اصاسنامه شرکت ما بسیار اشکالات داره"
    },
    {
      "id": 2,
      "start": 1853.78,
      "end": 1855.78,
      "formatted_start": "00:30:53.780",
      "formatted_end": "00:30:55.780",
      "text": "یعنی بسیار کفت نیست"
    },
    {
      "id": 3,
      "start": 1855.78,
      "end": 1857.78,
      "formatted_start": "00:30:55.780",
      "formatted_end": "00:30:57.780",
      "text": "بله اشکال داره"
    },
    {
      "id": 4,
      "start": 1857.78,
      "end": 1860.78,
      "formatted_start": "00:30:57.780",
      "formatted_end": "00:31:00.780",
      "text": "بعد اینو میخواییم یه تغییراتی بدیم"
    },
    {
      "id": 5,
      "start": 1860.78,
      "end": 1861.78,
      "formatted_start": "00:31:00.780",
      "formatted_end": "00:31:01.780",
      "text": "خب"
    },
    {
      "id": 6,
      "start": 1861.78,
      "end": 1862.78,
      "formatted_start": "00:31:01.780",
      "formatted_end": "00:31:02.780",
      "text": "بله"
    },
    {
      "id": 7,
      "start": 1862.78,
      "end": 1865.78,
      "formatted_start": "00:31:02.780",
      "formatted_end": "00:31:05.780",
      "text": "و شما باید با ما مشابهه بدین همکاری کنید"
    },
    {
      "id": 8,
      "start": 1865.78,
      "end": 1866.78,
      "formatted_start": "00:31:05.780",
      "formatted_end": "00:31:06.780",
      "text": "بله اطفاً"
    },
    {
      "id": 9,
      "start": 1866.78,
      "end": 1871.78,
      "formatted_start": "00:31:06.780",
      "formatted_end": "00:31:11.780",
      "text": "من کلیت قد زیره گفتم که شما اگه تو این زمینه میخواییم متعلق بودید"
    },
    {
      "id": 10,
      "start": 1871.78,
      "end": 1874.78,
      "formatted_start": "00:31:11.780",
      "formatted_end": "00:31:14.780",
      "text": "من اونو دادم اونو هم پرسن پرسال به آقای رحیمی دادم"
    },
    {
      "id": 11,
      "start": 1874.78,
      "end": 1875.78,
      "formatted_start": "00:31:14.780",
      "formatted_end": "00:31:15.780",
      "text": "از دستانه یه چیز"
    },
    {
      "id": 12,
      "start": 1875.78,
      "end": 1879.78,
      "formatted_start": "00:31:15.780",
      "formatted_end": "00:31:19.780",
      "text": "از دستانه وای و سیستم جدید رو بهشون دادم"
    },
    {
      "id": 13,
      "start": 1879.78,
      "end": 1882.08,
      "formatted_start": "00:31:19.780",
      "formatted_end": "00:31:22.080",
      "text": "بابا هر ویرایشی میخوایی نانجام بدین"
    },
    {
      "id": 14,
      "start": 1882.08,
      "end": 1883.54,
      "formatted_start": "00:31:22.080",
      "formatted_end": "00:31:23.540",
      "text": "بابا ویرایش شده"
    },
    {
      "id": 15,
      "start": 1883.54,
      "end": 1886.44,
      "formatted_start": "00:31:23.540",
      "formatted_end": "00:31:26.440",
      "text": "مثلا بگیم با همدیگه بگیم سوال که خجاواشی میخوایی ویرایش کنی"
    },
    {
      "id": 16,
      "start": 1886.44,
      "end": 1887.88,
      "formatted_start": "00:31:26.440",
      "formatted_end": "00:31:27.880",
      "text": "من از دست ناموی تاقیدی"
    },
    {
      "id": 17,
      "start": 1887.88,
      "end": 1890.02,
      "formatted_start": "00:31:27.880",
      "formatted_end": "00:31:30.020",
      "text": "از جدید رو بهشون دادم پرسانتری"
    },
    {
      "id": 18,
      "start": 1890.02,
      "end": 1890.36,
      "formatted_start": "00:31:30.020",
      "formatted_end": "00:31:30.360",
      "text": "سوال"
    },
    {
      "id": 19,
      "start": 1890.36,
      "end": 1891.98,
      "formatted_start": "00:31:30.360",
      "formatted_end": "00:31:31.980",
      "text": "پس ما این رو بگیریم"
    },
    {
      "id": 20,
      "start": 1891.98,
      "end": 1892.96,
      "formatted_start": "00:31:31.980",
      "formatted_end": "00:31:32.960",
      "text": "یه مطالعه کنیم"
    },
    {
      "id": 21,
      "start": 1892.96,
      "end": 1897.34,
      "formatted_start": "00:31:32.960",
      "formatted_end": "00:31:37.340",
      "text": "ببینیم که چه کار باید کردید"
    },
    {
      "id": 22,
      "start": 1897.34,
      "end": 1897.94,
      "formatted_start": "00:31:37.340",
      "formatted_end": "00:31:37.940",
      "text": "موردی نه"
    },
    {
      "id": 23,
      "start": 1897.94,
      "end": 1900.82,
      "formatted_start": "00:31:37.940",
      "formatted_end": "00:31:40.820",
      "text": "اگر میخوایی تو مجموعه ورد گذارید"
    },
    {
      "id": 24,
      "start": 1900.82,
      "end": 1902.6,
      "formatted_start": "00:31:40.820",
      "formatted_end": "00:31:42.600",
      "text": "قبلش باید آقای دعوت بدیم"
    },
    {
      "id": 25,
      "start": 1909.78,
      "end": 1913.58,
      "formatted_start": "00:31:49.780",
      "formatted_end": "00:31:53.580",
      "text": "در اصلا تو مجرم مصبوب بشه"
    },
    {
      "id": 26,
      "start": 1913.58,
      "end": 1916.18,
      "formatted_start": "00:31:53.580",
      "formatted_end": "00:31:56.180",
      "text": "ما میتونیم مثلا قبلش به برانویزی کنیم"
    },
    {
      "id": 27,
      "start": 1916.18,
      "end": 1917.18,
      "formatted_start": "00:31:56.180",
      "formatted_end": "00:31:57.180",
      "text": "آمادهش کنیم"
    },
    {
      "id": 28,
      "start": 1917.18,
      "end": 1918.84,
      "formatted_start": "00:31:57.180",
      "formatted_end": "00:31:58.840",
      "text": "تو مجرم تصدیبش کنیم"
    },
    {
      "id": 29,
      "start": 1918.84,
      "end": 1920.64,
      "formatted_start": "00:31:58.840",
      "formatted_end": "00:32:00.640",
      "text": "چارچوبو ببندیم"
    },
    {
      "id": 30,
      "start": 1920.64,
      "end": 1924.28,
      "formatted_start": "00:32:00.640",
      "formatted_end": "00:32:04.280",
      "text": "بعد تو مجرم مصبوبش رو بگیریم"
    },
    {
      "id": 31,
      "start": 1924.28,
      "end": 1926.2,
      "formatted_start": "00:32:04.280",
      "formatted_end": "00:32:06.200",
      "text": "بعد یه سال دیگه"
    },
    {
      "id": 32,
      "start": 1926.2,
      "end": 1927.06,
      "formatted_start": "00:32:06.200",
      "formatted_end": "00:32:07.060",
      "text": "این بازرست"
    },
    {
      "id": 33,
      "start": 1927.06,
      "end": 1929.02,
      "formatted_start": "00:32:07.060",
      "formatted_end": "00:32:09.020",
      "text": "در چه جلساتی از حیات مدیره"
    },
    {
      "id": 34,
      "start": 1929.02,
      "end": 1930.84,
      "formatted_start": "00:32:09.020",
      "formatted_end": "00:32:10.840",
      "text": "میتونه شرکت کنه"
    },
    {
      "id": 35,
      "start": 1930.84,
      "end": 1931.94,
      "formatted_start": "00:32:10.840",
      "formatted_end": "00:32:11.940",
      "text": "تو حیات مدیره نمیدونه"
    },
    {
      "id": 36,
      "start": 1931.94,
      "end": 1933.5,
      "formatted_start": "00:32:11.940",
      "formatted_end": "00:32:13.500",
      "text": "بازرست فقط جلساتی ای که"
    },
    {
      "id": 37,
      "start": 1933.5,
      "end": 1935.24,
      "formatted_start": "00:32:13.500",
      "formatted_end": "00:32:15.240",
      "text": "از طرف سهمداراست"
    },
    {
      "id": 38,
      "start": 1935.24,
      "end": 1940.86,
      "formatted_start": "00:32:15.240",
      "formatted_end": "00:32:20.860",
      "text": "که میاد تو مجرامه اعلام نظر می کنه تو حیط مدیره جلسه حیط مدیره شرکت می کنه"
    },
    {
      "id": 39,
      "start": 1940.86,
      "end": 1945.44,
      "formatted_start": "00:32:20.860",
      "formatted_end": "00:32:25.440",
      "text": "مگه اینکه یک مدیر ازش درخواست کنی که آه بیا مثلا تعدیه جواب بده"
    },
    {
      "id": 40,
      "start": 1945.44,
      "end": 1949.96,
      "formatted_start": "00:32:25.440",
      "formatted_end": "00:32:29.960",
      "text": "تعدیه جواب یا مثلا برای الان ما مدیران رو می خواهیم انتخاب کنیم"
    },
    {
      "id": 41,
      "start": 1949.96,
