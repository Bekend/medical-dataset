      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 8430.0,
      "end": 8459.98,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 8460.0,
      "end": 8476.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:16.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 8476.0,
      "end": 8477.0,
      "formatted_start": "02:21:16.000",
      "formatted_end": "02:21:17.000",
      "text": "بخشید"
    },
    {
      "id": 4,
      "start": 8477.0,
      "end": 8478.0,
      "formatted_start": "02:21:17.000",
      "formatted_end": "02:21:18.000",
      "text": "بخشید سلام خانشونو"
    },
    {
      "id": 5,
      "start": 8478.0,
      "end": 8481.0,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:21.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 8481.0,
      "end": 8484.0,
      "formatted_start": "02:21:21.000",
      "formatted_end": "02:21:24.000",
      "text": "بخشید مو ترگه روی زن خودیه که کارت سناشیده"
    },
    {
      "id": 7,
      "start": 8484.0,
      "end": 8485.0,
      "formatted_start": "02:21:24.000",
      "formatted_end": "02:21:25.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 8485.0,
      "end": 8487.0,
      "formatted_start": "02:21:25.000",
      "formatted_end": "02:21:27.000",
      "text": "زن کچولو چقدر بگویی؟"
    },
    {
      "id": 9,
      "start": 8487.0,
      "end": 8488.0,
      "formatted_start": "02:21:27.000",
      "formatted_end": "02:21:28.000",
      "text": "یک سال"
    },
    {
      "id": 10,
      "start": 8488.0,
      "end": 8489.0,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:29.000",
      "text": "یک سال"
    },
    {
      "id": 11,
      "start": 8489.0,
      "end": 8491.5,
      "formatted_start": "02:21:29.000",
      "formatted_end": "02:21:31.500",
      "text": "باره 11، اون شهر این ساله"
    },
    {
      "id": 12,
      "start": 8491.5,
      "end": 8493.5,
      "formatted_start": "02:21:31.500",
      "formatted_end": "02:21:33.500",
      "text": "پردابان چیش کرده؟"
    },
    {
      "id": 13,
      "start": 8493.5,
      "end": 8494.5,
      "formatted_start": "02:21:33.500",
      "formatted_end": "02:21:34.500",
      "text": "این سرنخواده دیگه"
    },
    {
      "id": 14,
      "start": 8494.5,
      "end": 8496.5,
      "formatted_start": "02:21:34.500",
      "formatted_end": "02:21:36.500",
      "text": "چه علایه میداره؟"
    },
    {
      "id": 15,
      "start": 8496.5,
      "end": 8498.5,
      "formatted_start": "02:21:36.500",
      "formatted_end": "02:21:38.500",
      "text": "پراتاست، صرفه خوشگاه"
    },
    {
      "id": 16,
      "start": 8498.5,
      "end": 8499.5,
      "formatted_start": "02:21:38.500",
      "formatted_end": "02:21:39.500",
      "text": "صرفه دیگه؟"
    },
    {
      "id": 17,
      "start": 8499.5,
      "end": 8501.5,
      "formatted_start": "02:21:39.500",
      "formatted_end": "02:21:41.500",
      "text": "گرفتگی بینیش گرفته است"
    },
    {
      "id": 18,
      "start": 8501.5,
      "end": 8504.0,
      "formatted_start": "02:21:41.500",
      "formatted_end": "02:21:44.000",
      "text": "گرفتگی بینی، صرفه، هم اینا؟"
    },
    {
      "id": 19,
      "start": 8504.0,
      "end": 8505.0,
      "formatted_start": "02:21:44.000",
      "formatted_end": "02:21:45.000",
      "text": "تمام داره"
    },
    {
      "id": 20,
      "start": 8505.0,
      "end": 8507.0,
      "formatted_start": "02:21:45.000",
      "formatted_end": "02:21:47.000",
      "text": "صرفه ها خوشگاه خفتی؟"
    },
    {
      "id": 21,
      "start": 8507.0,
      "end": 8508.0,
      "formatted_start": "02:21:47.000",
      "formatted_end": "02:21:48.000",
      "text": "خوشگاه"
    },
    {
      "id": 22,
      "start": 8508.0,
      "end": 8509.0,
      "formatted_start": "02:21:48.000",
      "formatted_end": "02:21:49.000",
      "text": "خوش سرهم یا تک تک؟"
    },
    {
      "id": 23,
      "start": 8509.0,
      "end": 8510.0,
      "formatted_start": "02:21:49.000",
      "formatted_end": "02:21:50.000",
      "text": "تک تک"
    },
    {
      "id": 24,
      "start": 8510.0,
      "end": 8511.0,
      "formatted_start": "02:21:50.000",
      "formatted_end": "02:21:51.000",
      "text": "تک تک"
    },
    {
      "id": 25,
      "start": 8511.0,
      "end": 8513.0,
      "formatted_start": "02:21:51.000",
      "formatted_end": "02:21:53.000",
      "text": "داروی که چیزی هم بهش دادی؟"
    },
    {
      "id": 26,
      "start": 8513.0,
      "end": 8516.0,
      "formatted_start": "02:21:53.000",
      "formatted_end": "02:21:56.000",
      "text": "اون رو خود فقط شهر بی پلرژی می دهند که تا بیشتر بیداریم"
    },
    {
      "id": 27,
      "start": 8516.0,
      "end": 8517.24,
      "formatted_start": "02:21:56.000",
      "formatted_end": "02:21:57.240",
      "text": "سنی شهر هده؟"
    },
    {
      "id": 28,
      "start": 8517.24,
      "end": 8518.24,
      "formatted_start": "02:21:57.240",
      "formatted_end": "02:21:58.240",
      "text": "یک سالی بود"
    },
    {
      "id": 29,
      "start": 8518.24,
      "end": 8519.38,
      "formatted_start": "02:21:58.240",
      "formatted_end": "02:21:59.380",
      "text": "یک سالی بود"
    },
    {
      "id": 30,
      "start": 8519.38,
      "end": 8522.24,
      "formatted_start": "02:21:59.380",
      "formatted_end": "02:22:02.240",
      "text": "پلرژی باز باز کردید یا مال قرار دارید؟"
    },
    {
      "id": 31,
      "start": 8522.24,
      "end": 8524.24,
      "formatted_start": "02:22:02.240",
      "formatted_end": "02:22:04.240",
      "text": "نه، تازه دیگرز باز کردم"
    },
    {
      "id": 32,
      "start": 8526.0,
      "end": 8527.0,
      "formatted_start": "02:22:06.000",
      "formatted_end": "02:22:07.000",
      "text": "ارواح نداشته"
    },
    {
      "id": 33,
      "start": 8537.0,
      "end": 8538.0,
      "formatted_start": "02:22:17.000",
      "formatted_end": "02:22:18.000",
      "text": "دست شدید"
    },
    {
      "id": 34,
      "start": 8543.0,
      "end": 8567.0,
      "formatted_start": "02:22:23.000",
      "formatted_end": "02:22:47.000",
      "text": "موسیقی"
    },
    {
      "id": 35,
      "start": 8567.0,
      "end": 8569.0,
      "formatted_start": "02:22:47.000",
      "formatted_end": "02:22:49.000",
      "text": "باز کردیم"
    },
    {
      "id": 36,
      "start": 8571.9,
      "end": 8572.9,
      "formatted_start": "02:22:51.900",
      "formatted_end": "02:22:52.900",
      "text": "بسیار عادی"
    },
    {
      "id": 37,
      "start": 8574.9,
      "end": 8576.9,
      "formatted_start": "02:22:54.900",
      "formatted_end": "02:22:56.900",
      "text": "در شروع افنات تنظیم بسیار"
    },
    {
      "id": 38,
      "start": 8576.9,
      "end": 8578.9,
      "formatted_start": "02:22:56.900",
      "formatted_end": "02:22:58.900",
      "text": "کوتین پراویشین تازه باز کردی؟"
    },
    {
      "id": 39,
      "start": 8578.9,
      "end": 8580.9,
      "formatted_start": "02:22:58.900",
      "formatted_end": "02:23:00.900",
      "text": "آره تو لازم از این روز باز کردیم"
    },
    {
      "id": 40,
      "start": 8580.9,
      "end": 8582.3,
      "formatted_start": "02:23:00.900",
      "formatted_end": "02:23:02.300",
      "text": "آخونو بهش بگیر"
    },
    {
      "id": 41,
      "start": 8582.3,
      "end": 8583.6,
      "formatted_start": "02:23:02.300",
      "formatted_end": "02:23:03.600",
      "text": "خطره یا شربت؟"
    },
    {
      "id": 42,
      "start": 8583.6,
      "end": 8584.6,
      "formatted_start": "02:23:03.600",
      "formatted_end": "02:23:04.600",
      "text": "خطره"
    },
    {
      "id": 43,
      "start": 8584.6,
      "end": 8585.6,
      "formatted_start": "02:23:04.600",
      "formatted_end": "02:23:05.600",
      "text": "خطره هسته"
    },
    {
      "id": 44,
      "start": 8585.6,
      "end": 8588.1,
      "formatted_start": "02:23:05.600",
      "formatted_end": "02:23:08.100",
      "text": "بعد دارو کردنش خوبه؟"
    },
    {
      "id": 45,
      "start": 8588.1,
      "end": 8589.1,
      "formatted_start": "02:23:08.100",
      "formatted_end": "02:23:09.100",
      "text": "میخورم آره"
    },
    {
      "id": 46,
      "start": 8589.1,
      "end": 8591.1,
      "formatted_start": "02:23:09.100",
      "formatted_end": "02:23:11.100",
      "text": "ولی بعضی موقع هم میتونه"
    },
    {
      "id": 47,
      "start": 8591.1,
      "end": 8593.1,
      "formatted_start": "02:23:11.100",
      "formatted_end": "02:23:13.100",
      "text": "دارو بد میخوری که دار تزدیق میسن"
    },
    {
      "id": 48,
      "start": 8593.1,
      "end": 8595.1,
      "formatted_start": "02:23:13.100",
      "formatted_end": "02:23:15.100",
      "text": "اگر خوب میخوره اونطور نمیسن"
    },
    {
      "id": 49,
      "start": 8595.1,
      "end": 8597.1,
      "formatted_start": "02:23:15.100",
      "formatted_end": "02:23:17.100",
      "text": "آن طور بگیر"
    },
    {
      "id": 50,
      "start": 8598.54,
      "end": 8599.74,
      "formatted_start": "02:23:18.540",
      "formatted_end": "02:23:19.740",
      "text": "اینجا خواهد کنیم؟"
    },
    {
      "id": 51,
      "start": 8599.74,
      "end": 8600.24,
      "formatted_start": "02:23:19.740",
      "formatted_end": "02:23:20.240",
      "text": "آره"
    },
    {
      "id": 52,
      "start": 8609.1,
      "end": 8610.62,
      "formatted_start": "02:23:29.100",
      "formatted_end": "02:23:30.620",
      "text": "آه، اسمی چیه؟"
    },
    {
      "id": 53,
      "start": 8610.62,
      "end": 8611.62,
      "formatted_start": "02:23:30.620",
      "formatted_end": "02:23:31.620",
      "text": "فرید رضا"
    },
    {
      "id": 54,
      "start": 8611.62,
      "end": 8612.42,
      "formatted_start": "02:23:31.620",
      "formatted_end": "02:23:32.420",
      "text": "چی؟"
    },
    {
      "id": 55,
      "start": 8612.42,
      "end": 8613.62,
      "formatted_start": "02:23:32.420",
      "formatted_end": "02:23:33.620",
      "text": "فرید رضا"
    },
    {
      "id": 56,
      "start": 8613.62,
      "end": 8616.38,
      "formatted_start": "02:23:33.620",
      "formatted_end": "02:23:36.380",
      "text": "فرید رضا، بکار جالبه"
    },
    {
      "id": 57,
      "start": 8617.5,
      "end": 8619.5,
      "formatted_start": "02:23:37.500",
      "formatted_end": "02:23:39.500",
      "text": "فرید رو با رضا اطلاع کردی"
    },
    {
      "id": 58,
      "start": 8620.7,
      "end": 8621.7,
      "formatted_start": "02:23:40.700",
      "formatted_end": "02:23:41.700",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 8622.34,
      "end": 8624.78,
      "formatted_start": "02:23:42.340",
      "formatted_end": "02:23:44.780",
      "text": "با پویا میخواستیم رضایی میگه دخول"
    },
    {
      "id": 60,
      "start": 8625.1,
      "end": 8628.1,
      "formatted_start": "02:23:45.100",
      "formatted_end": "02:23:48.100",
      "text": "پویانت؟ آه دیگه، برای ما بزرگان یکی زدن"
    },
    {
      "id": 61,
      "start": 8628.1,
      "end": 8631.1,
      "formatted_start": "02:23:48.100",
      "formatted_end": "02:23:51.100",
      "text": "شما اسم حضرتی میذارید؟"
    },
    {
      "id": 62,
      "start": 8631.1,
      "end": 8632.1,
      "formatted_start": "02:23:51.100",
      "formatted_end": "02:23:52.100",
      "text": "بله"
    },
    {
      "id": 63,
      "start": 8632.1,
      "end": 8635.1,
      "formatted_start": "02:23:52.100",
      "formatted_end": "02:23:55.100",
      "text": "اسم حضرتی چه نمایی میذارید؟ اسمای قبلی میذارید؟"
    },
    {
      "id": 64,
      "start": 8635.1,
      "end": 8640.1,
      "formatted_start": "02:23:55.100",
      "formatted_end": "02:24:00.100",
      "text": "آهان، اسمای اهمه گفتن، آن رضا، همون رضای فرید چی شد؟"
    },
    {
      "id": 65,
      "start": 8640.1,
      "end": 8642.1,
      "formatted_start": "02:24:00.100",
      "formatted_end": "02:24:02.100",
      "text": "فرید که ما حضرتی میذاریم"
    },
    {
      "id": 66,
      "start": 8642.1,
      "end": 8645.1,
      "formatted_start": "02:24:02.100",
      "formatted_end": "02:24:05.100",
      "text": "زدتیم تو گوگل که فرید هست"
    },
    {
      "id": 67,
      "start": 8645.1,
      "end": 8647.1,
      "formatted_start": "02:24:05.100",
      "formatted_end": "02:24:07.100",
      "text": "پا پویانت اجرا میزنش"
    },
    {
      "id": 68,
      "start": 8647.1,
      "end": 8650.1,
      "formatted_start": "02:24:07.100",
      "formatted_end": "02:24:10.100",
      "text": "پدرن میبود که پویانت، اونا هم میگن رضا"
    },
    {
      "id": 69,
      "start": 8650.1,
      "end": 8652.1,
      "formatted_start": "02:24:10.100",
      "formatted_end": "02:24:12.100",
      "text": "خیله باشید"
    },
    {
      "id": 70,
      "start": 8652.1,
      "end": 8654.1,
      "formatted_start": "02:24:12.100",
      "formatted_end": "02:24:14.100",
      "text": "خب این هم خشنگ همه خرید بخونیم"
    },
    {
      "id": 71,
      "start": 8654.1,
      "end": 8656.1,
      "formatted_start": "02:24:14.100",
      "formatted_end": "02:24:16.100",
      "text": "خرید بشه باشه"
    },
    {
      "id": 72,
      "start": 8656.1,
      "end": 8658.1,
      "formatted_start": "02:24:16.100",
      "formatted_end": "02:24:18.100",
      "text": "آه خوب"
    },
    {
      "id": 73,
      "start": 8658.1,
      "end": 8660.1,
      "formatted_start": "02:24:18.100",
      "formatted_end": "02:24:20.100",
      "text": "خرید خرید خیلی همیشه"
    },
    {
      "id": 74,
      "start": 8660.1,
      "end": 8662.1,
      "formatted_start": "02:24:20.100",
      "formatted_end": "02:24:22.100",
      "text": "خامسامی سرمافرگی میشه نزن"
    },
    {
      "id": 75,
      "start": 8662.1,
      "end": 8664.1,
      "formatted_start": "02:24:22.100",
      "formatted_end": "02:24:24.100",
      "text": "چون که چیز داره"
    },
    {
      "id": 76,
      "start": 8664.1,
      "end": 8666.1,
      "formatted_start": "02:24:24.100",
      "formatted_end": "02:24:26.100",
      "text": "خونه پلاجین داره"
    },
    {
      "id": 77,
      "start": 8672.1,
      "end": 8674.1,
      "formatted_start": "02:24:32.100",
      "formatted_end": "02:24:34.100",
      "text": "بفرمای سلام"
    },
    {
      "id": 78,
      "start": 8674.1,
      "end": 8676.1,
      "formatted_start": "02:24:34.100",
      "formatted_end": "02:24:36.100",
      "text": "سلامت بشین"
    },
    {
      "id": 79,
      "start": 8676.1,
      "end": 8678.1,
      "formatted_start": "02:24:36.100",
      "formatted_end": "02:24:38.100",
      "text": "بفرمای سلام دختر خوشگیر"
    },
    {
      "id": 80,
      "start": 8678.1,
      "end": 8680.1,
      "formatted_start": "02:24:38.100",
      "formatted_end": "02:24:40.100",
      "text": "آفرین"
    },
    {
      "id": 81,
      "start": 8680.1,
      "end": 8682.1,
      "formatted_start": "02:24:40.100",
      "formatted_end": "02:24:42.100",
      "text": "مردم اینجا اینجا جایید"
    },
    {
      "id": 82,
      "start": 8682.1,
      "end": 8684.1,
      "formatted_start": "02:24:42.100",
      "formatted_end": "02:24:44.100",
      "text": "نه با جمعی جنون خوبه"
    },
    {
      "id": 83,
      "start": 8684.1,
      "end": 8686.1,
      "formatted_start": "02:24:44.100",
      "formatted_end": "02:24:46.100",
      "text": "خوبه بگیر بزنید خیلی خوشید"
    },
    {
      "id": 84,
      "start": 8686.1,
      "end": 8688.1,
      "formatted_start": "02:24:46.100",
      "formatted_end": "02:24:48.100",
      "text": "نه سمشه"
    },
    {
      "id": 85,
      "start": 8688.1,
      "end": 8690.1,
      "formatted_start": "02:24:48.100",
      "formatted_end": "02:24:50.100",
      "text": "کار سفری بعد بخونم"
    },
    {
      "id": 86,
      "start": 8690.1,
      "end": 8692.1,
      "formatted_start": "02:24:50.100",
      "formatted_end": "02:24:52.100",
      "text": "بخونم شیمی خوشید"
    },
    {
      "id": 87,
      "start": 8692.1,
      "end": 8694.1,
      "formatted_start": "02:24:52.100",
      "formatted_end": "02:24:54.100",
      "text": "نه انگاری میداره"
    },
    {
      "id": 88,
      "start": 8694.1,
      "end": 8696.1,
      "formatted_start": "02:24:54.100",
      "formatted_end": "02:24:56.100",
      "text": "تق نمی کنه؟"
    },
    {
      "id": 89,
      "start": 8696.1,
      "end": 8698.1,
      "formatted_start": "02:24:56.100",
      "formatted_end": "02:24:58.100",
      "text": "تق می کنه"
    },
    {
      "id": 90,
      "start": 8698.1,
      "end": 8700.1,
      "formatted_start": "02:24:58.100",
      "formatted_end": "02:25:00.100",
      "text": "تق داره و بعد دیگه؟"
    },
    {
      "id": 91,
      "start": 8700.1,
      "end": 8702.1,
      "formatted_start": "02:25:00.100",
      "formatted_end": "02:25:02.100",
      "text": "هیچ"
    }
  ],
  "status": "completed"
}