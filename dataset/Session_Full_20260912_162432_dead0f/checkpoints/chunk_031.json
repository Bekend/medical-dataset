  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9302.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:02.000",
      "text": "باید بردارید."
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "بعدی که دوتا داره بگوییم ماشین بگوییم"
    },
    {
      "id": 2,
      "start": 9332.0,
      "end": 9334.0,
      "formatted_start": "02:35:32.000",
      "formatted_end": "02:35:34.000",
      "text": "الان با ترک بگوییم"
    },
    {
      "id": 3,
      "start": 9334.0,
      "end": 9336.0,
      "formatted_start": "02:35:34.000",
      "formatted_end": "02:35:36.000",
      "text": "الان با ترک بگوییم"
    },
    {
      "id": 4,
      "start": 9345.0,
      "end": 9347.0,
      "formatted_start": "02:35:45.000",
      "formatted_end": "02:35:47.000",
      "text": "سلام بابا جان سلامت باشید"
    },
    {
      "id": 5,
      "start": 9347.0,
      "end": 9349.0,
      "formatted_start": "02:35:47.000",
      "formatted_end": "02:35:49.000",
      "text": "بخواهم این سلام"
    },
    {
      "id": 6,
      "start": 9349.0,
      "end": 9353.16,
      "formatted_start": "02:35:49.000",
      "formatted_end": "02:35:53.160",
      "text": "ببخشید کارتون هم که خانم سمی داده بود بدیم"
    },
    {
      "id": 7,
      "start": 9353.16,
      "end": 9354.96,
      "formatted_start": "02:35:53.160",
      "formatted_end": "02:35:54.960",
      "text": "نه اونی که داده به شما"
    },
    {
      "id": 8,
      "start": 9354.96,
      "end": 9356.72,
      "formatted_start": "02:35:54.960",
      "formatted_end": "02:35:56.720",
      "text": "دیده خانم سمی شما رو"
    },
    {
      "id": 9,
      "start": 9356.72,
      "end": 9360.9,
      "formatted_start": "02:35:56.720",
      "formatted_end": "02:36:00.900",
