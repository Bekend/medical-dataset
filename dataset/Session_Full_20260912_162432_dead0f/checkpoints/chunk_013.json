      "end": 3943.86,
      "formatted_start": "01:05:34.300",
      "formatted_end": "01:05:43.860",
      "text": "میدونه بیاشیونم"
    },
    {
      "id": 3,
      "start": 3943.86,
      "end": 3948.74,
      "formatted_start": "01:05:43.860",
      "formatted_end": "01:05:48.740",
      "text": "میدونه بیخواب زبونم"
    },
    {
      "id": 4,
      "start": 3948.74,
      "end": 3953.48,
      "formatted_start": "01:05:48.740",
      "formatted_end": "01:05:53.480",
      "text": "نمیخواد تنها ببونم"
    },
    {
      "id": 5,
      "start": 3953.48,
      "end": 3958.58,
      "formatted_start": "01:05:53.480",
      "formatted_end": "01:05:58.580",
      "text": "بابا بابا به زبونم"
    },
    {
      "id": 6,
      "start": 3960.0,
      "end": 3989.98,
      "formatted_start": "01:06:00.000",
      "formatted_end": "01:06:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
