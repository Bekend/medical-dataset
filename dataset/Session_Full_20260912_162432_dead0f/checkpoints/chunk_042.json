    {
      "id": 19,
      "start": 12751.0,
      "end": 12753.0,
      "formatted_start": "03:32:31.000",
      "formatted_end": "03:32:33.000",
      "text": "سی ماستکر بخونید"
    },
    {
      "id": 20,
      "start": 12753.0,
      "end": 12755.0,
      "formatted_start": "03:32:33.000",
      "formatted_end": "03:32:35.000",
      "text": "خانم زیرایی مقدم"
    },
    {
      "id": 21,
      "start": 12755.0,
      "end": 12757.0,
      "formatted_start": "03:32:35.000",
      "formatted_end": "03:32:37.000",
      "text": "سلام"
    },
    {
      "id": 22,
      "start": 12757.0,
      "end": 12759.0,
      "formatted_start": "03:32:37.000",
      "formatted_end": "03:32:39.000",
      "text": "نازاده؟"
    },
    {
      "id": 23,
      "start": 12759.0,
      "end": 12761.0,
      "formatted_start": "03:32:39.000",
      "formatted_end": "03:32:41.000",
      "text": "چند روز شد؟"
    },
    {
      "id": 24,
      "start": 12761.0,
      "end": 12767.0,
      "formatted_start": "03:32:41.000",
      "formatted_end": "03:32:47.000",
      "text": "بله، زن کنید. سرد شده بود. یکی باید یه بشید"
    },
    {
      "id": 25,
      "start": 12767.0,
      "end": 12769.0,
      "formatted_start": "03:32:47.000",
      "formatted_end": "03:32:49.000",
      "text": "خوب"
    },
    {
      "id": 26,
      "start": 12782.0,
      "end": 12785.0,
      "formatted_start": "03:33:02.000",
      "formatted_end": "03:33:05.000",
      "text": "زرد هست ولی شدید نشده"
    },
    {
      "id": 27,
      "start": 12785.0,
      "end": 12786.0,
      "formatted_start": "03:33:05.000",
      "formatted_end": "03:33:06.000",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 12786.0,
      "end": 12788.0,
      "formatted_start": "03:33:06.000",
      "formatted_end": "03:33:08.000",
      "text": "خوب"
    },
    {
      "id": 29,
      "start": 12791.0,
      "end": 12793.0,
      "formatted_start": "03:33:11.000",
      "formatted_end": "03:33:13.000",
      "text": "خانسمی دستگاه رو..."
    },
    {
      "id": 30,
      "start": 12793.0,
      "end": 12794.0,
      "formatted_start": "03:33:13.000",
      "formatted_end": "03:33:14.000",
      "text": "بله..."
    },
    {
      "id": 31,
      "start": 12794.0,
      "end": 12795.0,
      "formatted_start": "03:33:14.000",
      "formatted_end": "03:33:15.000",
      "text": "داری؟"
    },
    {
      "id": 32,
      "start": 12796.0,
      "end": 12797.0,
      "formatted_start": "03:33:16.000",
      "formatted_end": "03:33:17.000",
      "text": "بب؟"
    },
    {
      "id": 33,
      "start": 12797.0,
      "end": 12799.0,
      "formatted_start": "03:33:17.000",
      "formatted_end": "03:33:19.000",
      "text": "این نافش اینجا خود اینو بگیره"
    },
    {
      "id": 34,
      "start": 12799.0,
      "end": 12800.0,
      "formatted_start": "03:33:19.000",
      "formatted_end": "03:33:20.000",
      "text": "بردستهه؟"
    },
    {
      "id": 35,
      "start": 12800.0,
      "end": 12801.0,
      "formatted_start": "03:33:20.000",
      "formatted_end": "03:33:21.000",
      "text": "آره"
    },
    {
      "id": 36,
      "start": 12801.0,
      "end": 12804.0,
      "formatted_start": "03:33:21.000",
      "formatted_end": "03:33:24.000",
      "text": "اون خورتومی اشکال نداره، اون به مرورو خوب میشه"
    },
    {
      "id": 37,
      "start": 12804.0,
      "end": 12807.0,
      "formatted_start": "03:33:24.000",
      "formatted_end": "03:33:27.000",
      "text": "بله دوتور این سیکن بچه زیاد کار می کنه"
    },
    {
      "id": 38,
      "start": 12807.0,
      "end": 12809.0,
      "formatted_start": "03:33:27.000",
      "formatted_end": "03:33:29.000",
      "text": "کار می کنه؟ مثل اصحال؟"
    },
    {
      "id": 39,
      "start": 12809.0,
      "end": 12810.0,
      "formatted_start": "03:33:29.000",
      "formatted_end": "03:33:30.000",
      "text": "نه، آقایی"
    },
    {
      "id": 40,
      "start": 12810.0,
      "end": 12813.0,
      "formatted_start": "03:33:30.000",
      "formatted_end": "03:33:33.000",
      "text": "مثل اصحال، آبکی، دونه دونه، درستی ۱۷۰ باز"
    },
    {
      "id": 41,
      "start": 12813.0,
      "end": 12815.0,
      "formatted_start": "03:33:33.000",
      "formatted_end": "03:33:35.000",
      "text": "بله بله"
    },
    {
      "id": 42,
      "start": 12815.0,
      "end": 12818.0,
      "formatted_start": "03:33:35.000",
      "formatted_end": "03:33:38.000",
      "text": "یادم بچه گوشی میشه"
    },
    {
      "id": 43,
      "start": 12818.0,
      "end": 12821.44,
      "formatted_start": "03:33:38.000",
      "formatted_end": "03:33:41.440",
      "text": "نه اون میخوره و اپینی کنه بعد میخواهد"
    },
    {
      "id": 44,
      "start": 12821.44,
      "end": 12824.76,
      "formatted_start": "03:33:41.440",
      "formatted_end": "03:33:44.760",
      "text": "صرف کار اصلی داره خوابیدن خوردن"
    },
    {
      "id": 45,
      "start": 12824.76,
      "end": 12827.24,
      "formatted_start": "03:33:44.760",
      "formatted_end": "03:33:47.240",
      "text": "مشکلی دیگه نیست؟"
    },
    {
      "id": 46,
      "start": 12827.24,
      "end": 12828.64,
      "formatted_start": "03:33:47.240",
      "formatted_end": "03:33:48.640",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 12828.64,
      "end": 12831.24,
      "formatted_start": "03:33:48.640",
      "formatted_end": "03:33:51.240",
      "text": "ببینید این زردیش شدید نیست خب"
    },
    {
      "id": 48,
      "start": 12831.24,
      "end": 12835.28,
      "formatted_start": "03:33:51.240",
      "formatted_end": "03:33:55.280",
      "text": "ولی من صلاح یه قرص میمونستم فردا بیاد من ببینم"
    },
    {
      "id": 49,
      "start": 12835.28,
      "end": 12838.68,
      "formatted_start": "03:33:55.280",
      "formatted_end": "03:33:58.680",
      "text": "شرایطشی بید نمیخواد فردا بیاد کجا میشینی؟"
    },
    {
      "id": 50,
      "start": 12838.68,
      "end": 12840.0,
      "formatted_start": "03:33:58.680",
      "formatted_end": "03:34:00.000",
      "text": "همینجایی باید"
    },
    {
      "id": 51,
      "start": 12840.0,
      "end": 12840.88,
      "formatted_start": "03:34:00.000",
      "formatted_end": "03:34:00.880",
      "text": "آداشخه"
    },
    {
      "id": 52,
      "start": 12840.88,
      "end": 12843.12,
      "formatted_start": "03:34:00.880",
      "formatted_end": "03:34:03.120",
      "text": "فردا بردازور که هستی؟"
    },
    {
      "id": 53,
      "start": 12843.12,
      "end": 12844.08,
      "formatted_start": "03:34:03.120",
      "formatted_end": "03:34:04.080",
      "text": "هستیم آره"
    },
    {
      "id": 54,
      "start": 12844.08,
      "end": 12846.56,
      "formatted_start": "03:34:04.080",
      "formatted_end": "03:34:06.560",
      "text": "فردا زور هم هستیم چه صرف هستی؟"
    },
    {
      "id": 55,
      "start": 12846.56,
      "end": 12848.56,
      "formatted_start": "03:34:06.560",
      "formatted_end": "03:34:08.560",
      "text": "5 تا 7"
    },
    {
      "id": 56,
      "start": 12848.56,
      "end": 12850.56,
      "formatted_start": "03:34:08.560",
      "formatted_end": "03:34:10.560",
      "text": "فردا بعد زور بیاری"
    },
    {
      "id": 57,
      "start": 12850.56,
      "end": 12852.56,
      "formatted_start": "03:34:10.560",
      "formatted_end": "03:34:12.560",
      "text": "بعد زورتر بیاری خوابه از بیترین صبح میزونستی بیاری"
    },
    {
      "id": 58,
      "start": 12852.56,
      "end": 12856.56,
      "formatted_start": "03:34:12.560",
      "formatted_end": "03:34:16.560",
      "text": "این گرس صبح شب یک چارم بشو بزنید"
    },
    {
      "id": 59,
      "start": 12856.56,
      "end": 12858.56,
      "formatted_start": "03:34:16.560",
      "formatted_end": "03:34:18.560",
      "text": "دارو خانه خانه بگیر بیاین شوید"
    },
    {
      "id": 60,
      "start": 12858.56,
      "end": 12860.56,
      "formatted_start": "03:34:18.560",
      "formatted_end": "03:34:20.560",
      "text": "میخدمتشون کنید"
    },
    {
      "id": 61,
      "start": 12860.56,
      "end": 12864.56,
      "formatted_start": "03:34:20.560",
      "formatted_end": "03:34:24.560",
      "text": "فردا بیارم دردیشو چک کنیم"
    },
    {
      "id": 62,
      "start": 12864.56,
      "end": 12866.56,
      "formatted_start": "03:34:24.560",
      "formatted_end": "03:34:26.560",
      "text": "آره آره"
    },
    {
      "id": 63,
      "start": 12866.56,
      "end": 12868.56,
      "formatted_start": "03:34:26.560",
      "formatted_end": "03:34:28.560",
      "text": "یه قضایی چیزی نداری"
    },
    {
      "id": 64,
      "start": 12868.56,
      "end": 12870.56,
      "formatted_start": "03:34:28.560",
      "formatted_end": "03:34:30.560",
      "text": "نه نه فقط همین گرس"
    },
    {
      "id": 65,
      "start": 12870.56,
      "end": 12872.56,
      "formatted_start": "03:34:30.560",
      "formatted_end": "03:34:32.560",
      "text": "این گرس شب نمیشه دستیراشون"
    },
    {
      "id": 66,
      "start": 12872.56,
      "end": 12874.56,
      "formatted_start": "03:34:32.560",
      "formatted_end": "03:34:34.560",
      "text": "آره صبح شب یک چارم بزنید"
    },
    {
      "id": 67,
      "start": 12874.56,
      "end": 12876.56,
      "formatted_start": "03:34:34.560",
      "formatted_end": "03:34:36.560",
      "text": "با درداری با درداری"
    },
    {
      "id": 68,
      "start": 12876.56,
      "end": 12878.56,
      "formatted_start": "03:34:36.560",
      "formatted_end": "03:34:38.560",
      "text": "با درداری"
    },
    {
      "id": 69,
      "start": 12878.56,
      "end": 12880.56,
      "formatted_start": "03:34:38.560",
      "formatted_end": "03:34:40.560",
      "text": "این یادو دست کنیسته؟"
    },
    {
      "id": 70,
      "start": 12880.56,
      "end": 12884.56,
      "formatted_start": "03:34:40.560",
      "formatted_end": "03:34:44.560",
      "text": "فیلن نه، فردا بینم اگه شدیده شد چرا بودم"
    }
  ],
  "status": "completed"
}