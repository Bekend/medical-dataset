  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12310.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:10.000",
      "text": "اینجا، جا، جا، این مادرین خوششون میدهد، باید بیارید، باید جوکن بیارید، سیزد چیزش؟"
    },
    {
      "id": 1,
      "start": 12314.0,
      "end": 12329.0,
      "formatted_start": "03:25:14.000",
      "formatted_end": "03:25:29.000",
      "text": "هران دیگه، جیبش بالا بود، اصلا یکم صدا شدن، یونو باز دوباره برند، هران باز شد، اصلا بسته بود، این بسمتر، برای بیتره که،"
    },
    {
      "id": 2,
      "start": 12330.0,
      "end": 12332.82,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:32.820",
      "text": "ایمالستان ببریدی ساکشن کنم"
    },
    {
      "id": 3,
      "start": 12333.42,
      "end": 12336.76,
      "formatted_start": "03:25:33.420",
      "formatted_end": "03:25:36.760",
      "text": "من کارایی که واجب بوده اواجانسی رو انجام دادم"
    },
    {
      "id": 4,
      "start": 12336.76,
      "end": 12337.26,
      "formatted_start": "03:25:36.760",
      "formatted_end": "03:25:37.260",
      "text": "بله"
    },
    {
      "id": 5,
      "start": 12337.26,
      "end": 12338.06,
      "formatted_start": "03:25:37.260",
      "formatted_end": "03:25:38.060",
      "text": "آمد"
    },
    {
      "id": 6,
      "start": 12338.7,
      "end": 12341.24,
      "formatted_start": "03:25:38.700",
      "formatted_end": "03:25:41.240",
      "text": "تو ممکنه دوباره تکرار بشه"
    },
    {
      "id": 7,
      "start": 12343.24,
      "end": 12344.88,
      "formatted_start": "03:25:43.240",
      "formatted_end": "03:25:44.880",
      "text": "همه خفشه ای بچه"
    },
    {
      "id": 8,
      "start": 12347.76,
      "end": 12348.76,
      "formatted_start": "03:25:47.760",
      "formatted_end": "03:25:48.760",
      "text": "آمد"
    },
    {
      "id": 9,
      "start": 12350.24,
      "end": 12352.98,
      "formatted_start": "03:25:50.240",
      "formatted_end": "03:25:52.980",
      "text": "این راه گلو میسه یه لوله خودکاره"
    },
    {
      "id": 10,
      "start": 12352.98,
      "end": 12353.48,
      "formatted_start": "03:25:52.980",
      "formatted_end": "03:25:53.480",
      "text": "آمد"
    },
    {
      "id": 11,
      "start": 12353.48,
      "end": 12356.84,
      "formatted_start": "03:25:53.480",
      "formatted_end": "03:25:56.840",
      "text": "یک کم خف بگیره نفس کبود میشه بچه میره"
    },
    {
      "id": 12,
      "start": 12356.84,
      "end": 12358.84,
      "formatted_start": "03:25:56.840",
      "formatted_end": "03:25:58.840",
      "text": "از اینجا باید باید برداریم"
    },
    {
      "id": 13,
      "start": 12358.84,
      "end": 12360.84,
      "formatted_start": "03:25:58.840",
      "formatted_end": "03:26:00.840",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 14,
      "start": 12360.84,
      "end": 12362.84,
      "formatted_start": "03:26:00.840",
      "formatted_end": "03:26:02.840",
      "text": "از اینجا باید برداریم"
    },
