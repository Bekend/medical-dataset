  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8702.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:02.000",
      "text": "باید داروی چیزی هم دادیم؟"
    },
    {
      "id": 1,
      "start": 8702.0,
      "end": 8706.0,
      "formatted_start": "02:25:02.000",
      "formatted_end": "02:25:06.000",
      "text": "داروی، دیشم شیاب بذاشتم، صبح هم کم تا شیاب استعمال کنم و برای شما بذاشتم."
    },
    {
      "id": 2,
      "start": 8706.0,
      "end": 8708.0,
      "formatted_start": "02:25:06.000",
      "formatted_end": "02:25:08.000",
      "text": "و کسی هم از دخانه مدید باشه؟"
    },
    {
      "id": 3,
      "start": 8708.0,
      "end": 8710.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:10.000",
      "text": "خودم."
    },
    {
      "id": 4,
      "start": 8710.0,
      "end": 8712.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:12.000",
      "text": "خودتون چه علایه میدادی؟"
    },
    {
      "id": 5,
      "start": 8712.0,
      "end": 8714.0,
      "formatted_start": "02:25:12.000",
      "formatted_end": "02:25:14.000",
      "text": "من خوب شادم."
    },
    {
      "id": 6,
      "start": 8714.0,
      "end": 8716.0,
      "formatted_start": "02:25:14.000",
      "formatted_end": "02:25:16.000",
      "text": "نه، چه علایه میداشتی؟"
    },
    {
      "id": 7,
      "start": 8716.0,
      "end": 8720.0,
      "formatted_start": "02:25:16.000",
      "formatted_end": "02:25:20.000",
      "text": "سرم خوردگی، آقایش بینی، گلو درد، دردونر، سرم درد."
    },
    {
      "id": 8,
      "start": 8720.0,
      "end": 8725.14,
      "formatted_start": "02:25:20.000",
      "formatted_end": "02:25:25.140",
      "text": "سراخوردگی، آوزشمینی، گلیدر، درمونر، سختر"
    },
    {
      "id": 9,
      "start": 8725.14,
      "end": 8731.56,
      "formatted_start": "02:25:25.140",
      "formatted_end": "02:25:31.560",
      "text": "اینها چون ویروس انتقال دارد، اینها الان فقط با ترپت کمتر اون علایم که شما دارید رو برونده دارید"
    },
    {
      "id": 10,
      "start": 8731.56,
      "end": 8732.06,
      "formatted_start": "02:25:31.560",
      "formatted_end": "02:25:32.060",
      "text": "خب؟"
    },
    {
      "id": 11,
      "start": 8732.06,
      "end": 8733.42,
      "formatted_start": "02:25:32.060",
      "formatted_end": "02:25:33.420",
      "text": "این"
    },
    {
      "id": 12,
      "start": 8733.42,
      "end": 8740.98,
      "formatted_start": "02:25:33.420",
      "formatted_end": "02:25:40.980",
      "text": "خب، خانم یک زمد رون سفری، بچه رو بغل کنید، محتملیت دارید که این دارید ترس بچه"
    },
    {
      "id": 13,
      "start": 8740.98,
      "end": 8741.6,
      "formatted_start": "02:25:40.980",
      "formatted_end": "02:25:41.600",
      "text": "بیرون"
    },
    {
      "id": 14,
      "start": 8741.6,
      "end": 8743.6,
      "formatted_start": "02:25:41.600",
      "formatted_end": "02:25:43.600",
      "text": "آفرین"
    },
    {
      "id": 15,
      "start": 8743.6,
      "end": 8746.6,
      "formatted_start": "02:25:43.600",
      "formatted_end": "02:25:46.600",
      "text": "بشه همونجون چون مواه کشنگی هم داره"
    },
    {
      "id": 16,
      "start": 8746.6,
      "end": 8748.6,
      "formatted_start": "02:25:46.600",
      "formatted_end": "02:25:48.600",
      "text": "پدایی، هنایی"
    },
    {
      "id": 17,
      "start": 8748.6,
      "end": 8750.6,
      "formatted_start": "02:25:48.600",
      "formatted_end": "02:25:50.600",
      "text": "آفرین"
    },
    {
      "id": 18,
      "start": 8750.6,
      "end": 8752.6,
      "formatted_start": "02:25:50.600",
      "formatted_end": "02:25:52.600",
      "text": "آفرین"
    },
    {
      "id": 19,
      "start": 8752.6,
      "end": 8756.6,
      "formatted_start": "02:25:52.600",
      "formatted_end": "02:25:56.600",
      "text": "بخشتو که دیگه بگیرم همه چون همه آینی باید همزاد بگیرم"
    },
    {
      "id": 20,
      "start": 8756.6,
      "end": 8758.6,
      "formatted_start": "02:25:56.600",
      "formatted_end": "02:25:58.600",
      "text": "که بشید که برایش بشم"
    },
    {
      "id": 21,
      "start": 8758.6,
      "end": 8760.6,
      "formatted_start": "02:25:58.600",
      "formatted_end": "02:26:00.600",
      "text": "ماما نه خواستی؟"
    },
    {
      "id": 22,
      "start": 8760.6,
      "end": 8762.6,
      "formatted_start": "02:26:00.600",
      "formatted_end": "02:26:02.600",
      "text": "نه همونجون نه خواستی"
    },
    {
      "id": 23,
      "start": 8762.6,
      "end": 8764.6,
      "formatted_start": "02:26:02.600",
      "formatted_end": "02:26:04.600",
      "text": "نه ترس کنید"
    },
    {
      "id": 24,
      "start": 8764.6,
      "end": 8766.6,
      "formatted_start": "02:26:04.600",
      "formatted_end": "02:26:06.600",
      "text": "حالا میگرد بگیرد"
    },
    {
      "id": 25,
      "start": 8766.6,
      "end": 8768.6,
      "formatted_start": "02:26:06.600",
      "formatted_end": "02:26:08.600",
      "text": "نه دستتونو بردارید"
    },
    {
      "id": 26,
      "start": 8768.6,
      "end": 8792.28,
      "formatted_start": "02:26:08.600",
      "formatted_end": "02:26:32.280",
      "text": "باید درسته باید درسته"
    },
    {
      "id": 27,
      "start": 8798.6,
      "end": 8800.6,
      "formatted_start": "02:26:38.600",
      "formatted_end": "02:26:40.600",
      "text": "نه، نه ترسنید"
    },
    {
      "id": 28,
      "start": 8800.6,
      "end": 8802.6,
      "formatted_start": "02:26:40.600",
      "formatted_end": "02:26:42.600",
      "text": "تا تمام"
    },
    {
      "id": 29,
      "start": 8802.6,
      "end": 8804.6,
      "formatted_start": "02:26:42.600",
      "formatted_end": "02:26:44.600",
      "text": "تمام، تمام، تمام، دختر میرونید"
    },
    {
      "id": 30,
      "start": 8804.6,
      "end": 8807.6,
      "formatted_start": "02:26:44.600",
      "formatted_end": "02:26:47.600",
      "text": "با چه اینجوریه من مجبورم یه دونه سویت رو پردنید"
    },
    {
      "id": 31,
      "start": 8807.6,
      "end": 8809.6,
      "formatted_start": "02:26:47.600",
      "formatted_end": "02:26:49.600",
      "text": "بشین برم"
    },
    {
      "id": 32,
      "start": 8809.6,
      "end": 8811.6,
      "formatted_start": "02:26:49.600",
      "formatted_end": "02:26:51.600",
      "text": "نه، باشون"
    },
    {
      "id": 33,
      "start": 8811.6,
      "end": 8814.6,
      "formatted_start": "02:26:51.600",
      "formatted_end": "02:26:54.600",
      "text": "از درخواهاشو کاملتر میرسن"
    },
    {
      "id": 34,
      "start": 8814.6,
      "end": 8817.6,
      "formatted_start": "02:26:54.600",
      "formatted_end": "02:26:57.600",
      "text": "چون اعتماد روی توفیق نام شب شروع کنه"
    },
    {
      "id": 35,
      "start": 8817.6,
      "end": 8819.6,
      "formatted_start": "02:26:57.600",
      "formatted_end": "02:26:59.600",
      "text": "و باسمانش بچرسه، خب؟"
    },
    {
      "id": 36,
      "start": 8821.6,
      "end": 8823.6,
      "formatted_start": "02:27:01.600",
      "formatted_end": "02:27:03.600",
      "text": "جان"
    },
    {
      "id": 37,
      "start": 8823.6,
      "end": 8826.6,
      "formatted_start": "02:27:03.600",
      "formatted_end": "02:27:06.600",
      "text": "از تامیل فن هر چهار ساعت هم میتونیم بشین"
    },
    {
      "id": 38,
      "start": 8826.6,
      "end": 8828.6,
      "formatted_start": "02:27:06.600",
      "formatted_end": "02:27:08.600",
      "text": "شیاختان همشون نداره"
    },
    {
      "id": 39,
      "start": 8828.6,
      "end": 8831.6,
      "formatted_start": "02:27:08.600",
      "formatted_end": "02:27:11.600",
      "text": "شیاختان دیکلوفناک خوبه نصفشو داری؟"
    },
    {
      "id": 40,
      "start": 8831.6,
      "end": 8832.6,
      "formatted_start": "02:27:11.600",
      "formatted_end": "02:27:12.600",
      "text": "آمیده"
    },
    {
      "id": 41,
      "start": 8832.6,
      "end": 8835.6,
      "formatted_start": "02:27:12.600",
      "formatted_end": "02:27:15.600",
      "text": "دیکلوفناک 50 یک گم گم هر 8 سال"
    },
    {
      "id": 42,
      "start": 8835.6,
      "end": 8837.6,
      "formatted_start": "02:27:15.600",
      "formatted_end": "02:27:17.600",
      "text": "دستتون برن"
    },
    {
      "id": 43,
      "start": 8837.6,
      "end": 8840.6,
      "formatted_start": "02:27:17.600",
      "formatted_end": "02:27:20.600",
      "text": "از تاملی فا مثلا کاراکیت خوبه"
    },
    {
      "id": 44,
      "start": 8840.6,
      "end": 8843.6,
      "formatted_start": "02:27:20.600",
      "formatted_end": "02:27:23.600",
      "text": "بعدن نوشتن بازا ازش بیتره بچه ها بیتر میکنه"
    },
    {
      "id": 45,
      "start": 8843.6,
      "end": 8845.6,
      "formatted_start": "02:27:23.600",
      "formatted_end": "02:27:25.600",
      "text": "اثرشون خوبه"
    },
    {
      "id": 46,
      "start": 8845.6,
      "end": 8847.6,
      "formatted_start": "02:27:25.600",
      "formatted_end": "02:27:27.600",
      "text": "بدین صفت کنن"
    },
    {
      "id": 47,
      "start": 8850.6,
      "end": 8852.6,
      "formatted_start": "02:27:30.600",
      "formatted_end": "02:27:32.600",
      "text": "بخنید سلامتون"
    },
    {
      "id": 48,
      "start": 8852.6,
      "end": 8854.6,
      "formatted_start": "02:27:32.600",
      "formatted_end": "02:27:34.600",
      "text": "شما خوبه؟ خوبه ازش؟"
    },
    {
      "id": 49,
      "start": 8854.6,
      "end": 8855.6,
      "formatted_start": "02:27:34.600",
      "formatted_end": "02:27:35.600",
      "text": "برنامه خوبی؟"
    },
    {
      "id": 50,
      "start": 8855.6,
      "end": 8856.6,
      "formatted_start": "02:27:35.600",
      "formatted_end": "02:27:36.600",
      "text": "نه"
    },
    {
      "id": 51,
      "start": 8856.6,
      "end": 8857.6,
      "formatted_start": "02:27:36.600",
      "formatted_end": "02:27:37.600",
      "text": "نداشتی؟"
    },
    {
      "id": 52,
      "start": 8859.6,
      "end": 8861.6,
      "formatted_start": "02:27:39.600",
      "formatted_end": "02:27:41.600",
      "text": "سیلاکس، در ملیان عدد"
    },
    {
      "id": 53,
      "start": 8861.6,
      "end": 8863.6,
      "formatted_start": "02:27:41.600",
      "formatted_end": "02:27:43.600",
      "text": "سیرو، سیلاکس"
    },
    {
      "id": 54,
      "start": 8877.6,
      "end": 8879.6,
      "formatted_start": "02:27:57.600",
      "formatted_end": "02:27:59.600",
      "text": "نه، سی خدا"
    },
    {
      "id": 55,
      "start": 8879.6,
      "end": 8880.6,
      "formatted_start": "02:27:59.600",
      "formatted_end": "02:28:00.600",
      "text": "شکل دیگه باشی"
    },
    {
      "id": 56,
      "start": 8884.6,
      "end": 8886.6,
      "formatted_start": "02:28:04.600",
      "formatted_end": "02:28:06.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 57,
      "start": 8886.6,
      "end": 8888.6,
      "formatted_start": "02:28:06.600",
      "formatted_end": "02:28:08.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 58,
      "start": 8888.6,
      "end": 8890.6,
      "formatted_start": "02:28:08.600",
      "formatted_end": "02:28:10.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 59,
      "start": 8890.6,
      "end": 8892.6,
      "formatted_start": "02:28:10.600",
      "formatted_end": "02:28:12.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 60,
      "start": 8892.6,
      "end": 8894.6,
      "formatted_start": "02:28:12.600",
      "formatted_end": "02:28:14.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 61,
      "start": 8894.6,
      "end": 8896.6,
      "formatted_start": "02:28:14.600",
      "formatted_end": "02:28:16.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 62,
      "start": 8896.6,
      "end": 8898.6,
      "formatted_start": "02:28:16.600",
      "formatted_end": "02:28:18.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 63,
      "start": 8898.6,
      "end": 8900.6,
      "formatted_start": "02:28:18.600",
      "formatted_end": "02:28:20.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 64,
      "start": 8900.6,
      "end": 8902.6,
      "formatted_start": "02:28:20.600",
      "formatted_end": "02:28:22.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 65,
      "start": 8902.6,
      "end": 8904.6,
      "formatted_start": "02:28:22.600",
      "formatted_end": "02:28:24.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 66,
      "start": 8904.6,
      "end": 8906.6,
      "formatted_start": "02:28:24.600",
      "formatted_end": "02:28:26.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 67,
      "start": 8906.6,
      "end": 8908.6,
      "formatted_start": "02:28:26.600",
      "formatted_end": "02:28:28.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 68,
      "start": 8908.6,
      "end": 8910.6,
      "formatted_start": "02:28:28.600",
      "formatted_end": "02:28:30.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 69,
      "start": 8910.6,
      "end": 8912.6,
      "formatted_start": "02:28:30.600",
      "formatted_end": "02:28:32.600",
      "text": "بخواهیم برگردیم"
    },
    {
      "id": 70,
      "start": 8912.6,
      "end": 8914.6,
      "formatted_start": "02:28:32.600",
      "formatted_end": "02:28:34.600",
      "text": "چشاش همسه که زرده"
    },
    {
      "id": 71,
      "start": 8914.6,
      "end": 8916.6,
      "formatted_start": "02:28:34.600",
      "formatted_end": "02:28:36.600",
      "text": "چشاش زرده؟"
    },
    {
      "id": 72,
      "start": 8916.6,
      "end": 8918.6,
      "formatted_start": "02:28:36.600",
      "formatted_end": "02:28:38.600",
      "text": "دارم خودتونو میکنیم"
    },
    {
      "id": 73,
      "start": 8918.6,
      "end": 8920.6,
      "formatted_start": "02:28:38.600",
      "formatted_end": "02:28:40.600",
      "text": "نه اون مهم نیست ها"
    },
    {
      "id": 74,
      "start": 8920.6,
      "end": 8922.6,
      "formatted_start": "02:28:40.600",
      "formatted_end": "02:28:42.600",
      "text": "دیوین از اینجا خوب میشه"
    },
    {
      "id": 75,
      "start": 8922.6,
      "end": 8924.6,
      "formatted_start": "02:28:42.600",
      "formatted_end": "02:28:44.600",
      "text": "مثلا بگیر الان این"
    },
    {
      "id": 76,
      "start": 8924.6,
      "end": 8926.6,
      "formatted_start": "02:28:44.600",
      "formatted_end": "02:28:46.600",
      "text": "بدنش خوبه"
    },
    {
      "id": 77,
      "start": 8926.6,
      "end": 8928.6,
      "formatted_start": "02:28:46.600",
      "formatted_end": "02:28:48.600",
      "text": "دیوینید سفیده"
    },
    {
      "id": 78,
      "start": 8928.6,
      "end": 8930.6,
      "formatted_start": "02:28:48.600",
      "formatted_end": "02:28:50.600",
      "text": "اینجاها پارچه انداختید"
    },
    {
      "id": 79,
      "start": 8930.6,
      "end": 8932.6,
      "formatted_start": "02:28:50.600",
      "formatted_end": "02:28:52.600",
      "text": "دیر خوب میشه"
    },
    {
      "id": 80,
      "start": 8932.6,
      "end": 8934.6,
      "formatted_start": "02:28:52.600",
      "formatted_end": "02:28:54.600",
      "text": "چند شب گذاشتی؟"
    },
    {
      "id": 81,
      "start": 8934.6,
      "end": 8936.6,
      "formatted_start": "02:28:54.600",
      "formatted_end": "02:28:56.600",
      "text": "دیگه سه شب گذاشتیم"
    },
    {
      "id": 82,
      "start": 8936.6,
      "end": 8938.6,
      "formatted_start": "02:28:56.600",
      "formatted_end": "02:28:58.600",
      "text": "چه شب گذاشتی؟"
    },
    {
      "id": 83,
      "start": 8938.6,
      "end": 8940.6,
      "formatted_start": "02:28:58.600",
      "formatted_end": "02:29:00.600",
      "text": "الان خیلی بیتره"
    },
    {
      "id": 84,
      "start": 8940.6,
      "end": 8944.04,
      "formatted_start": "02:29:00.600",
      "formatted_end": "02:29:04.040",
      "text": "یکی دو روز دیگه بده و خواست داری"
    },
    {
      "id": 85,
      "start": 8944.04,
      "end": 8945.16,
      "formatted_start": "02:29:04.040",
      "formatted_end": "02:29:05.160",
      "text": "خوب"
    },
    {
      "id": 86,
      "start": 8945.16,
      "end": 8947.28,
      "formatted_start": "02:29:05.160",
      "formatted_end": "02:29:07.280",
      "text": "برسش یک روز دیگه بده"
    },
    {
      "id": 87,
      "start": 8947.28,
      "end": 8950.36,
      "formatted_start": "02:29:07.280",
      "formatted_end": "02:29:10.360",
      "text": "برس گفتم پنج روز من دادم دیگه ندارم"
    },
    {
      "id": 88,
      "start": 8950.36,
      "end": 8955.84,
      "formatted_start": "02:29:10.360",
      "formatted_end": "02:29:15.840",
      "text": "پنج روز نشده که سه شنبه، چاشم، فنج شنبه، جمعه، شنبه همون دیگه نداری"
    },
    {
      "id": 89,
      "start": 8955.84,
      "end": 8959.52,
      "formatted_start": "02:29:15.840",
      "formatted_end": "02:29:19.520",
      "text": "حالا اشکال نداره اگر نداری هم خیلی واجب نیست دیگه"
    },
    {
      "id": 90,
      "start": 8959.52,
      "end": 8963.84,
      "formatted_start": "02:29:19.520",
      "formatted_end": "02:29:23.840",
      "text": "چون دیگه کار اون حرکت شکسته شده"
    },
    {
      "id": 91,
      "start": 8963.84,
      "end": 8965.84,
      "formatted_start": "02:29:23.840",
      "formatted_end": "02:29:25.840",
      "text": "بله، بسیار خوبه"
    },
    {
      "id": 92,
      "start": 8965.84,
      "end": 8966.6,
      "formatted_start": "02:29:25.840",
      "formatted_end": "02:29:26.600",
      "text": "چون؟"
    },
    {
      "id": 93,
      "start": 8966.6,
      "end": 8967.6,
      "formatted_start": "02:29:26.600",
      "formatted_end": "02:29:27.600",
      "text": "دیگه مشکل نداره"
    },
    {
      "id": 94,
      "start": 8967.6,
      "end": 8969.6,
      "formatted_start": "02:29:27.600",
      "formatted_end": "02:29:29.600",
      "text": "نه نه الان خوبه"
    },
    {
      "id": 95,
      "start": 8969.6,
      "end": 8970.6,
      "formatted_start": "02:29:29.600",
      "formatted_end": "02:29:30.600",
      "text": "خوبه"
    },
    {
      "id": 96,
      "start": 8970.6,
      "end": 8972.6,
      "formatted_start": "02:29:30.600",
      "formatted_end": "02:29:32.600",
      "text": "تمام بلند شده"
    },
    {
      "id": 97,
      "start": 8972.6,
      "end": 8974.6,
      "formatted_start": "02:29:32.600",
      "formatted_end": "02:29:34.600",
      "text": "خیلی خوب شده الان خوبه"
    },
    {
      "id": 98,
      "start": 8974.6,
      "end": 8976.6,
      "formatted_start": "02:29:34.600",
      "formatted_end": "02:29:36.600",
      "text": "آیا دکتر چرا بازیم؟ بینهای سنجی شیران؟"
    },
    {
      "id": 99,
      "start": 8976.6,
      "end": 8978.6,
      "formatted_start": "02:29:36.600",
      "formatted_end": "02:29:38.600",
      "text": "بینهای سنجی شش ماهی دیم"
    },
    {
      "id": 100,
      "start": 8978.6,
      "end": 8981.6,
      "formatted_start": "02:29:38.600",
      "formatted_end": "02:29:41.600",
      "text": "ولی شنوای سنجی توقع بالا خانم آبشناسی"
    },
    {
      "id": 101,
      "start": 8981.6,
      "end": 8983.6,
      "formatted_start": "02:29:41.600",
      "formatted_end": "02:29:43.600",
      "text": "آم آبشناس باید بازیم"
    },
    {
      "id": 102,
      "start": 8983.6,
      "end": 8985.6,
