      "end": 13229.98,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 13230.0,
      "end": 13259.98,
      "formatted_start": "03:40:30.000",
      "formatted_end": "03:40:59.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 2,
      "start": 13260.0,
      "end": 13270.0,
      "formatted_start": "03:41:00.000",
      "formatted_end": "03:41:10.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 13290.0,
      "end": 13316.0,
      "formatted_start": "03:41:30.000",
      "formatted_end": "03:41:56.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 13316.0,
      "end": 13318.0,
      "formatted_start": "03:41:56.000",
      "formatted_end": "03:41:58.000",
      "text": "اینکه اینکه هم زدین"
    },
    {
      "id": 5,
      "start": 13318.0,
      "end": 13322.0,
      "formatted_start": "03:41:58.000",
      "formatted_end": "03:42:02.000",
      "text": "من بیشتری آموال دوست دارم"
    },
    {
      "id": 6,
      "start": 13322.0,
      "end": 13324.0,
      "formatted_start": "03:42:02.000",
      "formatted_end": "03:42:04.000",
      "text": "یکی اینجا افتد اینکم"
    },
    {
      "id": 7,
      "start": 13324.0,
      "end": 13326.0,
      "formatted_start": "03:42:04.000",
      "formatted_end": "03:42:06.000",
      "text": "این این از نافی چارده تا"
    },
    {
      "id": 8,
      "start": 13326.0,
      "end": 13332.0,
      "formatted_start": "03:42:06.000",
      "formatted_end": "03:42:12.000",
      "text": "پس میشه دو تا سه چار پنج شیش هفت بشه نه جنب"
    },
    {
      "id": 9,
      "start": 13332.0,
      "end": 13334.0,
      "formatted_start": "03:42:12.000",
      "formatted_end": "03:42:14.000",
      "text": "آره چارده تا"
    },
    {
      "id": 10,
      "start": 13337.0,
      "end": 13339.0,
      "formatted_start": "03:42:17.000",
      "formatted_end": "03:42:19.000",
      "text": "با نافی میشه پونزه تا"
    },
    {
      "id": 11,
      "start": 13346.0,
      "end": 13375.98,
      "formatted_start": "03:42:26.000",
      "formatted_end": "03:42:55.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 12,
      "start": 13376.0,
      "end": 13405.0,
      "formatted_start": "03:42:56.000",
      "formatted_end": "03:43:25.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 13405.0,
      "end": 13408.0,
      "formatted_start": "03:43:25.000",
      "formatted_end": "03:43:28.000",
      "text": "همسنگی چهار تا دستگاه اومده؟"
    },
    {
      "id": 14,
      "start": 13408.0,
      "end": 13410.0,
      "formatted_start": "03:43:28.000",
      "formatted_end": "03:43:30.000",
      "text": "آه"
    },
    {
      "id": 15,
      "start": 13410.0,
      "end": 13414.0,
      "formatted_start": "03:43:30.000",
      "formatted_end": "03:43:34.000",
      "text": "دمید این روزی دو بار یک قطعه چکان"
    },
    {
      "id": 16,
      "start": 13414.0,
      "end": 13415.0,
      "formatted_start": "03:43:34.000",
      "formatted_end": "03:43:35.000",
      "text": "خوب"
    },
    {
      "id": 17,
      "start": 13415.0,
      "end": 13417.0,
      "formatted_start": "03:43:35.000",
      "formatted_end": "03:43:37.000",
      "text": "اینم روزی سه بار یک قطعه چکان"
    },
    {
      "id": 18,
      "start": 13417.0,
      "end": 13418.0,
      "formatted_start": "03:43:37.000",
      "formatted_end": "03:43:38.000",
      "text": "قطعه چکان"
    },
    {
      "id": 19,
      "start": 13418.0,
      "end": 13420.0,
      "formatted_start": "03:43:38.000",
      "formatted_end": "03:43:40.000",
      "text": "اینم روزی یک بار یک قطعه چکان خوب"
    },
    {
      "id": 20,
      "start": 13420.0,
      "end": 13421.0,
      "formatted_start": "03:43:40.000",
      "formatted_end": "03:43:41.000",
      "text": "خوش نوشته دید"
    },
    {
      "id": 21,
      "start": 13421.0,
      "end": 13423.0,
      "formatted_start": "03:43:41.000",
      "formatted_end": "03:43:43.000",
      "text": "نوشته بارد با خوری شما یک قطعه چکان"
    },
    {
      "id": 22,
      "start": 13423.0,
      "end": 13424.0,
      "formatted_start": "03:43:43.000",
      "formatted_end": "03:43:44.000",
      "text": "نوشته بارد با خوری شما یک قطعه چکان"
    },
    {
      "id": 23,
      "start": 13424.0,
      "end": 13426.0,
      "formatted_start": "03:43:44.000",
      "formatted_end": "03:43:46.000",
      "text": "تا یک کنی پتر چکان داده اشکال نداره"
    },
    {
      "id": 24,
      "start": 13426.0,
      "end": 13428.0,
      "formatted_start": "03:43:46.000",
      "formatted_end": "03:43:48.000",
      "text": "بلکه بندومت دیگه همه ما هست"
    },
    {
      "id": 25,
      "start": 13428.0,
      "end": 13432.0,
      "formatted_start": "03:43:48.000",
      "formatted_end": "03:43:52.000",
      "text": "یک تا یکونیم قطعه شو پنده دی یکونیم بده باز کم پیشتر"
    },
    {
      "id": 26,
      "start": 13432.0,
      "end": 13433.0,
      "formatted_start": "03:43:52.000",
      "formatted_end": "03:43:53.000",
      "text": "بس"
    },
    {
      "id": 27,
      "start": 13433.0,
      "end": 13434.0,
      "formatted_start": "03:43:53.000",
      "formatted_end": "03:43:54.000",
      "text": "خدا فراموش"
    },
    {
      "id": 28,
      "start": 13434.0,
      "end": 13436.0,
      "formatted_start": "03:43:54.000",
      "formatted_end": "03:43:56.000",
      "text": "نیست داره دیده ممنون خدا فراموش"
    },
    {
      "id": 29,
      "start": 13458.0,
      "end": 13462.0,
      "formatted_start": "03:44:18.000",
      "formatted_end": "03:44:22.000",
      "text": "یکی از پسای داروخانه رو تنگ بزنن"
    },
    {
      "id": 30,
      "start": 13462.0,
      "end": 13465.0,
      "formatted_start": "03:44:22.000",
      "formatted_end": "03:44:25.000",
      "text": "یا اینها رو کمک کنن"
    },
    {
      "id": 31,
      "start": 13465.0,
      "end": 13468.0,
      "formatted_start": "03:44:25.000",
      "formatted_end": "03:44:28.000",
      "text": "خوب"
    },
    {
      "id": 32,
      "start": 13468.0,
      "end": 13472.0,
      "formatted_start": "03:44:28.000",
      "formatted_end": "03:44:32.000",
      "text": "یا در یک سوال چیز نسیدی"
    }
  ],
  "status": "completed"
}