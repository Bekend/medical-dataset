  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13811.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:11.000",
      "text": "ایرانی ها از روی تحقیق میخونند ارای بیدن. دیده این فرق می کند. تا اونا ارای ندادن ما هر چیز بدیم هم حساب نیست."
    },
    {
      "id": 1,
      "start": 13811.0,
      "end": 13818.0,
      "formatted_start": "03:50:11.000",
      "formatted_end": "03:50:18.000",
      "text": "قربون شما، سلامت باشید. ما فرقش نیست گفتم نمی آمده، اقلی پیام داده باشم فرمت شما."
    },
    {
      "id": 2,
      "start": 13818.0,
      "end": 13827.0,
      "formatted_start": "03:50:18.000",
      "formatted_end": "03:50:27.000",
      "text": "عزیز دلیل، قربون شما، سلامت باشید، خدا نگهدار."
    },
    {
      "id": 3,
      "start": 13830.0,
      "end": 13859.98,
      "formatted_start": "03:50:30.000",
      "formatted_end": "03:50:59.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 4,
      "start": 13860.0,
      "end": 13889.98,
      "formatted_start": "03:51:00.000",
      "formatted_end": "03:51:29.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 5,
      "start": 13890.0,
      "end": 13920.0,
      "formatted_start": "03:51:30.000",
      "formatted_end": "03:52:00.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 6,
      "start": 13920.0,
      "end": 13949.98,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:29.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 7,
      "start": 13950.0,
      "end": 13970.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:50.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 13970.0,
      "end": 13997.0,
      "formatted_start": "03:52:50.000",
      "formatted_end": "03:53:17.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 13997.0,
      "end": 13999.0,
      "formatted_start": "03:53:17.000",
      "formatted_end": "03:53:19.000",
      "text": "سلام"
    },
    {
      "id": 10,
      "start": 14027.0,
      "end": 14031.0,
      "formatted_start": "03:53:47.000",
      "formatted_end": "03:53:51.000",
      "text": "برنامه شما دست دارید"
    },
    {
      "id": 11,
      "start": 14031.0,
      "end": 14033.0,
      "formatted_start": "03:53:51.000",
      "formatted_end": "03:53:53.000",
      "text": "برنامه شما دست دارید"
    },
    {
      "id": 12,
      "start": 14033.0,
      "end": 14035.0,
      "formatted_start": "03:53:53.000",
      "formatted_end": "03:53:55.000",
      "text": "اول مشکل هم داریم"
    },
    {
      "id": 13,
      "start": 14035.0,
      "end": 14037.0,
      "formatted_start": "03:53:55.000",
      "formatted_end": "03:53:57.000",
      "text": "بعدی؟"
    },
    {
      "id": 14,
      "start": 14037.0,
      "end": 14039.0,
      "formatted_start": "03:53:57.000",
      "formatted_end": "03:53:59.000",
      "text": "بعدی"
    },
    {
      "id": 15,
      "start": 14039.0,
      "end": 14041.0,
      "formatted_start": "03:53:59.000",
      "formatted_end": "03:54:01.000",
      "text": "خارجی قسمت جلو"
    },
    {
      "id": 16,
      "start": 14041.0,
      "end": 14043.0,
      "formatted_start": "03:54:01.000",
      "formatted_end": "03:54:03.000",
      "text": "اقا براتیم خارجی کلی شدید"
    },
    {
      "id": 17,
      "start": 14043.0,
      "end": 14045.0,
      "formatted_start": "03:54:03.000",
      "formatted_end": "03:54:05.000",
      "text": "او جا کن؟"
    },
    {
      "id": 18,
      "start": 14045.0,
      "end": 14047.0,
      "formatted_start": "03:54:05.000",
      "formatted_end": "03:54:07.000",
      "text": "جلو، اقا براتیم جلو"
    },
    {
      "id": 19,
      "start": 14047.0,
      "end": 14049.0,
      "formatted_start": "03:54:07.000",
      "formatted_end": "03:54:09.000",
      "text": "دیرونیه"
    },
    {
      "id": 20,
      "start": 14049.0,
      "end": 14051.0,
      "formatted_start": "03:54:09.000",
      "formatted_end": "03:54:11.000",
      "text": "بعد در حالت یک خطیق خارجی"
    },
    {
      "id": 21,
      "start": 14051.0,
      "end": 14053.0,
      "formatted_start": "03:54:11.000",
      "formatted_end": "03:54:13.000",
      "text": "دیگه از این اعتباری ندارم"
    },
    {
      "id": 22,
      "start": 14053.0,
      "end": 14055.0,
      "formatted_start": "03:54:13.000",
      "formatted_end": "03:54:15.000",
      "text": "همین در حالت خارجی کلی شدید"
    },
    {
      "id": 23,
      "start": 14055.0,
      "end": 14057.0,
      "formatted_start": "03:54:15.000",
      "formatted_end": "03:54:17.000",
      "text": "این شده شدید"
    },
    {
      "id": 24,
      "start": 14057.0,
      "end": 14059.0,
      "formatted_start": "03:54:17.000",
      "formatted_end": "03:54:19.000",
      "text": "از کنش شده باشه؟"
    },
    {
      "id": 25,
      "start": 14059.0,
      "end": 14061.0,
      "formatted_start": "03:54:19.000",
      "formatted_end": "03:54:21.000",
      "text": "اصلا"
    },
    {
      "id": 26,
      "start": 14061.0,
      "end": 14063.0,
      "formatted_start": "03:54:21.000",
      "formatted_end": "03:54:23.000",
      "text": "خوشکه و خوارشی"
    },
    {
      "id": 27,
      "start": 14063.0,
      "end": 14065.0,
      "formatted_start": "03:54:23.000",
      "formatted_end": "03:54:25.000",
      "text": "کمی از پوست هم دیدی"
    },
    {
      "id": 28,
      "start": 14065.0,
      "end": 14067.0,
      "formatted_start": "03:54:25.000",
      "formatted_end": "03:54:27.000",
      "text": "نه هست هیچ"
    },
    {
      "id": 29,
      "start": 14067.0,
      "end": 14069.0,
      "formatted_start": "03:54:27.000",
      "formatted_end": "03:54:29.000",
      "text": "نگاه کردی"
    },
    {
      "id": 30,
      "start": 14069.0,
      "end": 14071.0,
      "formatted_start": "03:54:29.000",
      "formatted_end": "03:54:31.000",
      "text": "نه هست"
    },
    {
      "id": 31,
      "start": 14071.0,
      "end": 14073.0,
      "formatted_start": "03:54:31.000",
      "formatted_end": "03:54:33.000",
      "text": "چند وقت در این خوارشی داری؟"
    },
    {
      "id": 32,
      "start": 14073.0,
      "end": 14075.0,
      "formatted_start": "03:54:33.000",
      "formatted_end": "03:54:35.000",
      "text": "دو ماه"
    },
    {
      "id": 33,
      "start": 14075.0,
      "end": 14077.0,
      "formatted_start": "03:54:35.000",
      "formatted_end": "03:54:37.000",
      "text": "مهمونی برای این برس کردن"
    },
    {
      "id": 34,
      "start": 14077.0,
      "end": 14079.0,
      "formatted_start": "03:54:37.000",
      "formatted_end": "03:54:39.000",
      "text": "اکثری خانم ها در"
    },
    {
      "id": 35,
      "start": 14079.0,
      "end": 14081.0,
      "formatted_start": "03:54:39.000",
      "formatted_end": "03:54:41.000",
      "text": "سریل یایسکی"
    },
    {
      "id": 36,
      "start": 14081.0,
      "end": 14083.0,
      "formatted_start": "03:54:41.000",
      "formatted_end": "03:54:43.000",
      "text": "بچاری این خوارش هایی بیشن"
    },
    {
      "id": 37,
      "start": 14083.0,
      "end": 14100.0,
      "formatted_start": "03:54:43.000",
      "formatted_end": "03:55:00.000",
      "text": "چند محلول، چند کار است، هم بعد از دائمان استفاده میشه و دختیه ها جاش کارش میدهید، هم در دوران یایسگی استفاده اش اینجوری روشک روزوی بکنید، چند باشه رو هستیم بیرسیم داخل یه لیمون ها و دو باشه رو سباشه نازیم."
    }
  ],
