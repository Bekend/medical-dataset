  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13521.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:21.000",
      "text": "این روز ریفرنس های مرغز و حساب باز می بسن که الیم های زیر سر استهکام جدار حقوق رو در داخل مرغزی به هم میزنه، علت ها خسیدی حقوق مرغز به هم میخوره و به احتمال CBA رو افزایش میده."
    },
    {
      "id": 1,
      "start": 13521.0,
      "end": 13525.5,
      "formatted_start": "03:45:21.000",
      "formatted_end": "03:45:25.500",
      "text": "این کلمه ما نیشترانجوری به این مطلب می کنیم و شما این را موصیه اش میتونیم بکنیم"
    },
    {
      "id": 2,
      "start": 13525.5,
      "end": 13527.5,
      "formatted_start": "03:45:25.500",
      "formatted_end": "03:45:27.500",
      "text": "اگر محتمی کنیم اسمو کنم"
    },
    {
      "id": 3,
      "start": 13527.5,
      "end": 13529.5,
      "formatted_start": "03:45:27.500",
      "formatted_end": "03:45:29.500",
      "text": "از منابع مرزی"
    },
    {
      "id": 4,
      "start": 13529.5,
      "end": 13530.5,
      "formatted_start": "03:45:29.500",
      "formatted_end": "03:45:30.500",
      "text": "میبینیم مرزی"
    },
    {
      "id": 5,
      "start": 13530.5,
      "end": 13532.5,
      "formatted_start": "03:45:30.500",
      "formatted_end": "03:45:32.500",
      "text": "اگر مثلا به بستیبال شما میده بکنید"
    },
    {
      "id": 6,
      "start": 13532.5,
      "end": 13534.5,
      "formatted_start": "03:45:32.500",
      "formatted_end": "03:45:34.500",
      "text": "شما تو بستیبالتون"
    },
    {
      "id": 7,
      "start": 13534.5,
      "end": 13536.5,
      "formatted_start": "03:45:34.500",
      "formatted_end": "03:45:36.500",
      "text": "از این مطالب"
    },
    {
      "id": 8,
      "start": 13536.5,
      "end": 13539.5,
      "formatted_start": "03:45:36.500",
      "formatted_end": "03:45:39.500",
      "text": "پاره از این باید لایم ها بیاید استفاده بکنید"
    },
    {
      "id": 9,
      "start": 13539.5,
      "end": 13542.5,
      "formatted_start": "03:45:39.500",
      "formatted_end": "03:45:42.500",
      "text": "و بستیبالتون رو بلندجون بکنید"
    },
    {
      "id": 10,
      "start": 13542.5,
      "end": 13544.5,
      "formatted_start": "03:45:42.500",
      "formatted_end": "03:45:44.500",
      "text": "خب"
    },
    {
      "id": 11,
      "start": 13544.5,
      "end": 13565.5,
      "formatted_start": "03:45:44.500",
      "formatted_end": "03:46:05.500",
      "text": "محاصد زیاد دارند، مثلا محاصدشون کار ندارند، ایرانی که دارند تو خود اون رشته تراحی میشند"
    },
    {
      "id": 12,
      "start": 13565.5,
      "end": 13570.5,
      "formatted_start": "03:46:05.500",
      "formatted_end": "03:46:10.500",
      "text": "خواه قایدان های میان رشدی هم در آینده انشادان جا باز بکنه"
    },
    {
      "id": 13,
      "start": 13570.5,
      "end": 13578.5,
      "formatted_start": "03:46:10.500",
      "formatted_end": "03:46:18.500",
      "text": "بگو مثلا برای قیمان سی، اولی بگفتن که قاید حتما بیاد زیر شیش، شیش و میون"
    },
    {
      "id": 14,
      "start": 13578.5,
      "end": 13586.5,
      "formatted_start": "03:46:18.500",
      "formatted_end": "03:46:26.500",
      "text": "بعد دیدم که نه سنی مختلف، تمام مندی، کیفیت زندگی، ما هفته و نیم هم قبول کردیم"
    },
    {
      "id": 15,
      "start": 13586.5,
      "end": 13592.5,
      "formatted_start": "03:46:26.500",
      "formatted_end": "03:46:32.500",
      "text": "خواه همین قیمان سی رو میگم، خواه تو چمرده قندوری که"
    },
    {
      "id": 16,
      "start": 13592.5,
      "end": 13603.5,
      "formatted_start": "03:46:32.500",
      "formatted_end": "03:46:43.500",
      "text": "بعد هفتونیم رو قبول کردیم برای فرد پیده ۸۵ ساله، خواهیم این رو می آرم جوانش رو کنیم که آخرش کیپیت اون برام می بینیم، در طول آن"
    },
    {
      "id": 17,
      "start": 13603.5,
      "end": 13614.5,
      "formatted_start": "03:46:43.500",
      "formatted_end": "03:46:54.500",
      "text": "و پذیرفتیم، یعنی نمی افتاری تعدیل شد اینجا، خب اون زمان کسی که می گفت نه هفتونیم می گفت اون دویجه برد، پسید هفتونیم برد، چی باید حتما بیاد ۶۵ بشه این واسه"
    },
    {
      "id": 18,
      "start": 13614.5,
      "end": 13627.0,
      "formatted_start": "03:46:54.500",
      "formatted_end": "03:47:07.000",
      "text": "ولی الان میگه که اگه فردی با عصا را میره و مثلا سن ۸۸ سال داره، برای ۶۵ بیگه بلاف نمیکنیم، فردش را زیاده افره بیدیم، تا با ۶۶ بیدیم."
    },
    {
      "id": 19,
      "start": 13627.0,
      "end": 13638.5,
      "formatted_start": "03:47:07.000",
      "formatted_end": "03:47:18.500",
      "text": "در مورد LDL هم فعلا گایدان قلب که اونشون رو بسیار مهم میخواید داشت یا اعداد پایین رو باید دست دارن، ولی معرض اینها معتقد هم نه."
    },
    {
      "id": 20,
      "start": 13638.5,
      "end": 13654.5,
      "formatted_start": "03:47:18.500",
      "formatted_end": "03:47:34.500",
      "text": "عددهای زیر صد برای الیت شکرندگی اروپ را افزایش میدهد، در داخل مرز اروپش با قرار فراموش می کنه، دیوار اروپ باید معتف باشه"
    },
    {
      "id": 21,
      "start": 13654.5,
      "end": 13663.5,
      "formatted_start": "03:47:34.500",
      "formatted_end": "03:47:43.500",
      "text": "اگه این اطافه از بین بره احتمال پارگی احتمال ارزایی اون رو هر دوشت رو بینده CBA بهش میکنن"
    },
    {
      "id": 22,
      "start": 13663.5,
      "end": 13669.5,
      "formatted_start": "03:47:43.500",
      "formatted_end": "03:47:49.500",
      "text": "یعنی سکت مرزی به مورد نرد کنه بود درست سکت مرزی درشون مرزوش بدون میکنیم"
    },
    {
      "id": 23,
      "start": 13669.5,
      "end": 13673.5,
      "formatted_start": "03:47:49.500",
      "formatted_end": "03:47:53.500",
      "text": "ما قلب طرف رو نجات داریم مرزش رو به ولها ناخته بیدیم"
    },
    {
      "id": 24,
      "start": 13673.5,
      "end": 13678.5,
      "formatted_start": "03:47:53.500",
      "formatted_end": "03:47:58.500",
      "text": "شما اگه وقتی خواستید مثلا های احتلالتی میشه چیزش میشه بیاین سرچ بکنیم"
    },
    {
      "id": 25,
      "start": 13678.5,
      "end": 13686.5,
      "formatted_start": "03:47:58.500",
      "formatted_end": "03:48:06.500",
      "text": "این مسئله رو عوارض و عروض مرزی بگیرین در ال دی ایل های بسیار کم"
    },
    {
      "id": 26,
      "start": 13686.5,
      "end": 13697.5,
      "formatted_start": "03:48:06.500",
      "formatted_end": "03:48:17.500",
      "text": "و از این طبق که داده میشه همراه با بزرگ استادی که مثلا این رو خوب تقریب می کنه و خیلی خوب هم پس"
    },
    {
      "id": 27,
      "start": 13697.5,
      "end": 13703.5,
      "formatted_start": "03:48:17.500",
      "formatted_end": "03:48:23.500",
      "text": "ریسک اون قضیه رو از ریسک سیریه رو افزایش میتونه بگیره"
    },
    {
      "id": 28,
      "start": 13703.5,
      "end": 13705.5,
      "formatted_start": "03:48:23.500",
      "formatted_end": "03:48:25.500",
      "text": "با قطعی همیشه میتونه"
    },
    {
      "id": 29,
      "start": 13705.5,
      "end": 13707.5,
      "formatted_start": "03:48:25.500",
      "formatted_end": "03:48:27.500",
      "text": "و اینه فردهای جدیده"
    },
    {
      "id": 30,
      "start": 13707.5,
      "end": 13709.5,
      "formatted_start": "03:48:27.500",
      "formatted_end": "03:48:29.500",
      "text": "PCSK9"
    },
    {
      "id": 31,
      "start": 13709.5,
      "end": 13711.5,
      "formatted_start": "03:48:29.500",
      "formatted_end": "03:48:31.500",
      "text": "این هی میتونه با"
    },
    {
      "id": 32,
      "start": 13711.5,
      "end": 13713.5,
      "formatted_start": "03:48:31.500",
      "formatted_end": "03:48:33.500",
      "text": "اینم داره بیاد دیگه"
    },
    {
      "id": 33,
      "start": 13713.5,
      "end": 13715.5,
      "formatted_start": "03:48:33.500",
      "formatted_end": "03:48:35.500",
      "text": "اینم داره بیاد"
    },
    {
      "id": 34,
      "start": 13715.5,
      "end": 13717.5,
      "formatted_start": "03:48:35.500",
      "formatted_end": "03:48:37.500",
      "text": "اینم خیلی گرونه"
    },
    {
      "id": 35,
      "start": 13717.5,
      "end": 13719.5,
      "formatted_start": "03:48:37.500",
      "formatted_end": "03:48:39.500",
      "text": "بله خیلی گرونه"
    },
    {
      "id": 36,
      "start": 13719.5,
      "end": 13721.5,
      "formatted_start": "03:48:39.500",
      "formatted_end": "03:48:41.500",
      "text": "بله"
    },
    {
      "id": 37,
      "start": 13721.5,
      "end": 13723.5,
      "formatted_start": "03:48:41.500",
      "formatted_end": "03:48:43.500",
      "text": "انشاءالله در آینده نزدیک"
    },
    {
      "id": 38,
      "start": 13723.5,
      "end": 13725.5,
      "formatted_start": "03:48:43.500",
      "formatted_end": "03:48:45.500",
      "text": "این از اون روحوارز به دوبه"
    },
    {
      "id": 39,
      "start": 13725.5,
      "end": 13727.5,
      "formatted_start": "03:48:45.500",
      "formatted_end": "03:48:47.500",
      "text": "برای سکت مغزی هم پیشگیری میکنه"
    },
    {
      "id": 40,
      "start": 13727.5,
      "end": 13729.5,
      "formatted_start": "03:48:47.500",
      "formatted_end": "03:48:49.500",
      "text": "پیشگیری از سرنوهای سرطانی هم"
    },
    {
      "id": 41,
      "start": 13729.5,
      "end": 13731.5,
      "formatted_start": "03:48:49.500",
      "formatted_end": "03:48:51.500",
      "text": "توش هست"
    },
    {
      "id": 42,
      "start": 13731.5,
      "end": 13742.5,
      "formatted_start": "03:48:51.500",
      "formatted_end": "03:49:02.500",
      "text": "از این اصلاسیت کانسر هم برام. وقتی اون رو نزیاب نگیرم، بعد اون هم برام."
    },
    {
      "id": 43,
      "start": 13742.5,
      "end": 13749.5,
      "formatted_start": "03:49:02.500",
      "formatted_end": "03:49:09.500",
      "text": "بودم که جز اکسپنسیب دراک ها است، جز درگاه بیان است و اون هم این عوارس رو ندارد."
    },
    {
      "id": 44,
      "start": 13749.5,
      "end": 13757.5,
      "formatted_start": "03:49:09.500",
      "formatted_end": "03:49:17.500",
      "text": "و منی به همه ماه هستم این کار. وقتی ما ایل دی ایل رو تارگیت می کنیم، این ایل دی ایل رو می خواهیم زیر صد نکهت برم"
    },
    {
      "id": 45,
      "start": 13757.5,
      "end": 13760.5,
      "formatted_start": "03:49:17.500",
      "formatted_end": "03:49:20.500",
      "text": "برای بیمار فردی از این هفته رو بیانیم"
    },
    {
      "id": 46,
      "start": 13760.5,
      "end": 13764.5,
      "formatted_start": "03:49:20.500",
      "formatted_end": "03:49:24.500",
      "text": "میگم از اون طرف بردیم، مقصد اون حواس هم باشه"
    },
    {
      "id": 47,
      "start": 13764.5,
      "end": 13769.5,
      "formatted_start": "03:49:24.500",
      "formatted_end": "03:49:29.500",
      "text": "من اشکالی رو که دیدم، نه اینکه من بیا برد این حرف هم بگم"
    },
    {
      "id": 48,
      "start": 13769.5,
      "end": 13771.5,
      "formatted_start": "03:49:29.500",
      "formatted_end": "03:49:31.500",
      "text": "و دکترهای قلب دست از این کار رو بردارن"
    },
    {
      "id": 49,
      "start": 13771.5,
      "end": 13776.5,
      "formatted_start": "03:49:31.500",
      "formatted_end": "03:49:36.500",
      "text": "من به توصیه به خودتون گفتم، ممکنه تو بسترانتون داشته باشید"
    },
    {
      "id": 50,
      "start": 13776.5,
      "end": 13781.5,
      "formatted_start": "03:49:36.500",
      "formatted_end": "03:49:41.500",
      "text": "برای این اشتباه فعیلیه، بهتشباه قلب بیاد اعمال بکنیم"
    },
    {
      "id": 51,
      "start": 13781.5,
      "end": 13785.5,
