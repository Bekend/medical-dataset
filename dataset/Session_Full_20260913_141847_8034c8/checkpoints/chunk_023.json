  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6905.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:05.000",
      "text": "اینجا با شما هست."
    },
    {
      "id": 1,
      "start": 6905.0,
      "end": 6908.0,
      "formatted_start": "01:55:05.000",
      "formatted_end": "01:55:08.000",
      "text": "با شما هست."
    },
    {
      "id": 2,
      "start": 6908.0,
      "end": 6910.0,
      "formatted_start": "01:55:08.000",
      "formatted_end": "01:55:10.000",
      "text": "با شما هستیم."
    },
    {
      "id": 3,
      "start": 6910.0,
      "end": 6916.0,
      "formatted_start": "01:55:10.000",
      "formatted_end": "01:55:16.000",
      "text": "همه اینسان ها یه جایی مثلا محچش ماند مرد مرد مرد، زاموش ماند."
    },
    {
      "id": 4,
      "start": 6916.0,
      "end": 6919.0,
      "formatted_start": "01:55:16.000",
      "formatted_end": "01:55:19.000",
      "text": "یه جایی اندر انسان هست."
    },
    {
      "id": 5,
      "start": 6919.0,
      "end": 6922.0,
      "formatted_start": "01:55:19.000",
      "formatted_end": "01:55:22.000",
      "text": "و خب بعد آقای افتراحیت، بعد ازید میشه نه."
    },
    {
      "id": 6,
      "start": 6922.0,
      "end": 6927.0,
      "formatted_start": "01:55:22.000",
      "formatted_end": "01:55:27.000",
      "text": "بسه همین برای هم میگه اندر انسان هست، نفید خسر."
    },
    {
      "id": 7,
      "start": 6927.0,
      "end": 6930.46,
      "formatted_start": "01:55:27.000",
      "formatted_end": "01:55:30.460",
      "text": "انسان در حال زیاده بیدید. یک جاش بخوره."
    },
    {
      "id": 8,
      "start": 6930.46,
      "end": 6936.72,
      "formatted_start": "01:55:30.460",
      "formatted_end": "01:55:36.720",
      "text": "بیتامین دهیتون کم هست، شربیتون بالا هست، چیزهایی که داستاناش میشن، قسمت کلیه."
    },
    {
      "id": 9,
      "start": 6936.72,
      "end": 6944.06,
      "formatted_start": "01:55:36.720",
      "formatted_end": "01:55:44.060",
      "text": "و دو تا از دیسکاتون هستن، بیگون زدیدید، دو تا از روی مدیمی تره، چیز همین جدید تره از روی."
    },
    {
      "id": 10,
      "start": 6944.06,
      "end": 6948.98,
      "formatted_start": "01:55:44.060",
      "formatted_end": "01:55:48.980",
      "text": "دکتر پیشانه تان بده هم، خیلی دنبال جدید و قدیم نماشون بید."
    },
    {
      "id": 11,
      "start": 6948.98,
      "end": 6952.54,
      "formatted_start": "01:55:48.980",
      "formatted_end": "01:55:52.540",
      "text": "این هم دیسک هستن. این هم دیسک. باریکا."
    },
    {
      "id": 12,
      "start": 6952.54,
      "end": 6956.54,
      "formatted_start": "01:55:52.540",
      "formatted_end": "01:55:56.540",
      "text": "اصلا اونجور دور بزنید"
    },
    {
      "id": 13,
      "start": 6956.54,
      "end": 6962.54,
      "formatted_start": "01:55:56.540",
      "formatted_end": "01:56:02.540",
      "text": "این ها استخانه هستن"
    },
    {
      "id": 14,
      "start": 6962.54,
      "end": 6966.54,
      "formatted_start": "01:56:02.540",
      "formatted_end": "01:56:06.540",
      "text": "این مشکی ها نیستن"
    },
    {
      "id": 15,
      "start": 6966.54,
      "end": 6972.54,
      "formatted_start": "01:56:06.540",
      "formatted_end": "01:56:12.540",
      "text": "این ها در یک جایی که عکس بازه باشه"
    },
    {
      "id": 16,
      "start": 6972.54,
      "end": 6974.54,
      "formatted_start": "01:56:12.540",
      "formatted_end": "01:56:14.540",
      "text": "مثلا اینجا"
    },
    {
      "id": 17,
      "start": 6974.54,
      "end": 6978.54,
      "formatted_start": "01:56:14.540",
      "formatted_end": "01:56:18.540",
      "text": "این مسیر مایه نخاییه"
    },
    {
      "id": 18,
      "start": 6978.54,
      "end": 6990.54,
      "formatted_start": "01:56:18.540",
      "formatted_end": "01:56:30.540",
      "text": "در اینجا دیسکر رفته به سبت توی لخایی. اونجا یه ذره رفته و میویند تنگی کانال."
    },
    {
      "id": 19,
      "start": 6990.54,
      "end": 6996.54,
      "formatted_start": "01:56:30.540",
      "formatted_end": "01:56:36.540",
      "text": "اینجا یه ذره تنگ شده. از دیسکر بود و اونجا لخا رو تنگ کردن."
    },
    {
      "id": 20,
      "start": 6996.54,
      "end": 7003.54,
      "formatted_start": "01:56:36.540",
      "formatted_end": "01:56:43.540",
      "text": "این کانال لخاییه یعنی دیسکر رفته کانال لخا رو تنگ کرده."
    },
    {
      "id": 21,
      "start": 7003.54,
      "end": 7005.54,
      "formatted_start": "01:56:43.540",
      "formatted_end": "01:56:45.540",
      "text": "دارو نداری؟"
    },
    {
      "id": 22,
      "start": 7005.54,
      "end": 7006.54,
      "formatted_start": "01:56:45.540",
      "formatted_end": "01:56:46.540",
      "text": "چرا؟"
    },
    {
      "id": 23,
      "start": 7006.54,
      "end": 7008.54,
      "formatted_start": "01:56:46.540",
      "formatted_end": "01:56:48.540",
      "text": "یک کارش اینه که اینه جرداری کنن"
    },
    {
      "id": 24,
      "start": 7008.54,
      "end": 7010.54,
      "formatted_start": "01:56:48.540",
      "formatted_end": "01:56:50.540",
      "text": "این مقدارش خیلی کمه"
    },
    {
      "id": 25,
      "start": 7010.54,
      "end": 7012.54,
      "formatted_start": "01:56:50.540",
      "formatted_end": "01:56:52.540",
      "text": "که به جرداری برسه"
    },
    {
      "id": 26,
      "start": 7012.54,
      "end": 7015.54,
      "formatted_start": "01:56:52.540",
      "formatted_end": "01:56:55.540",
      "text": "این مقدارش اینه که محلت بین دو دست هم حلوه میذارم"
    },
    {
      "id": 27,
      "start": 7015.54,
      "end": 7018.54,
      "formatted_start": "01:56:55.540",
      "formatted_end": "01:56:58.540",
      "text": "این حلوه رو فشار بدم چه اتفاق میفته؟"
    },
    {
      "id": 28,
      "start": 7018.54,
      "end": 7020.54,
      "formatted_start": "01:56:58.540",
      "formatted_end": "01:57:00.540",
      "text": "میزنه بیرون بگرد وستادم"
    },
    {
      "id": 29,
      "start": 7020.54,
      "end": 7022.54,
      "formatted_start": "01:57:00.540",
      "formatted_end": "01:57:02.540",
      "text": "پانه اگه دستن بکشم چه اتفاق میفته؟"
    },
    {
      "id": 30,
      "start": 7022.54,
      "end": 7024.54,
      "formatted_start": "01:57:02.540",
      "formatted_end": "01:57:04.540",
      "text": "حلوه برگیر"
    },
    {
      "id": 31,
      "start": 7024.54,
      "end": 7025.54,
      "formatted_start": "01:57:04.540",
      "formatted_end": "01:57:05.540",
      "text": "اگه نرمه شد"
    },
    {
      "id": 32,
      "start": 7025.54,
      "end": 7027.54,
      "formatted_start": "01:57:05.540",
      "formatted_end": "01:57:07.540",
      "text": "اگه صف شده باشه این دو دست فشار بدم"
    },
    {
      "id": 33,
      "start": 7027.54,
      "end": 7030.54,
      "formatted_start": "01:57:07.540",
      "formatted_end": "01:57:10.540",
      "text": "بیرون بگیرم جلوه افتاقی حلوه خوش بشه"
    },
    {
      "id": 34,
      "start": 7030.54,
      "end": 7035.54,
      "formatted_start": "01:57:10.540",
      "formatted_end": "01:57:15.540",
      "text": "بعد بکشم و بیرون برنمیگرده درسته؟ بیگرد که که کهونه شده برنمیگرده"
    },
    {
      "id": 35,
      "start": 7035.54,
      "end": 7040.54,
      "formatted_start": "01:57:15.540",
      "formatted_end": "01:57:20.540",
      "text": "فیزو تراپی بیرون چیکار بکنه؟ کمر شما رو که اینجوری فشارده بود"
    },
    {
      "id": 36,
      "start": 7040.54,
      "end": 7047.54,
      "formatted_start": "01:57:20.540",
      "formatted_end": "01:57:27.540",
      "text": "این زده فشارش رو کم میکنه استخت جکوزی میرید فشار کمر شما رو کم میکنید درست؟"
    },
    {
      "id": 37,
      "start": 7047.54,
      "end": 7051.54,
      "formatted_start": "01:57:27.540",
      "formatted_end": "01:57:31.540",
      "text": "شما کمره دکامپرس میشه کامپرس یعنی فشارده شده"
    },
    {
      "id": 38,
      "start": 7051.54,
      "end": 7055.54,
      "formatted_start": "01:57:31.540",
      "formatted_end": "01:57:35.540",
      "text": "برعکس کشیده شده"
    },
    {
      "id": 39,
      "start": 7055.54,
      "end": 7057.54,
      "formatted_start": "01:57:35.540",
      "formatted_end": "01:57:37.540",
      "text": "چون میره تو جگوزی باید بشینی"
    },
    {
      "id": 40,
      "start": 7057.54,
      "end": 7059.54,
      "formatted_start": "01:57:37.540",
      "formatted_end": "01:57:39.540",
      "text": "دوتا مشتو میزر زمین"
    },
    {
      "id": 41,
      "start": 7059.54,
      "end": 7061.54,
      "formatted_start": "01:57:39.540",
      "formatted_end": "01:57:41.540",
      "text": "شوناتو میکشی بالا"
    },
    {
      "id": 42,
      "start": 7061.54,
      "end": 7063.54,
      "formatted_start": "01:57:41.540",
      "formatted_end": "01:57:43.540",
      "text": "این باسنت به پایین میکشه به اون وزن"
    },
    {
      "id": 43,
      "start": 7063.54,
      "end": 7065.54,
      "formatted_start": "01:57:43.540",
      "formatted_end": "01:57:45.540",
      "text": "شونات به بالا میکشی"
    },
    {
      "id": 44,
      "start": 7065.54,
      "end": 7069.54,
      "formatted_start": "01:57:45.540",
      "formatted_end": "01:57:49.540",
      "text": "این دوست در محراها از هم فاصله بدا میتونه"
    },
    {
      "id": 45,
      "start": 7069.54,
      "end": 7071.54,
      "formatted_start": "01:57:49.540",
      "formatted_end": "01:57:51.540",
      "text": "جدا میشه"
    },
    {
      "id": 46,
      "start": 7071.54,
      "end": 7073.54,
      "formatted_start": "01:57:51.540",
      "formatted_end": "01:57:53.540",
      "text": "وقتی جدا میشن مثل اینکه دوتا دست هم میکشن"
    },
    {
      "id": 47,
      "start": 7073.54,
      "end": 7075.54,
      "formatted_start": "01:57:53.540",
      "formatted_end": "01:57:55.540",
      "text": "حلوایه بر میگن اگه نرم مشه بر"
    },
    {
      "id": 48,
      "start": 7075.54,
      "end": 7079.54,
      "formatted_start": "01:57:55.540",
      "formatted_end": "01:57:59.540",
      "text": "اگر نخوش شده باشیم هیچ فایده"
    },
    {
      "id": 49,
      "start": 7079.54,
      "end": 7087.54,
      "formatted_start": "01:57:59.540",
      "formatted_end": "01:58:07.540",
      "text": "باید بگویم. چرا دیگه؟ اونجورو میگیرن، عرض می کنن، می بارن، اضافه شون، می ندازن سطح لاشون."
    },
    {
      "id": 50,
      "start": 7087.54,
      "end": 7089.54,
      "formatted_start": "01:58:07.540",
      "formatted_end": "01:58:09.540",
      "text": "درست نشه برای این؟"
    },
    {
      "id": 51,
      "start": 7089.54,
      "end": 7106.54,
      "formatted_start": "01:58:09.540",
      "formatted_end": "01:58:26.540",
      "text": "تقریبا درست میشه. خودعمل و دستگاری خیلی مصیبت ها داره. دو ماه، سه ماه فرد یه ریس باید ببنده، نمیتونه دستجوری بره، نمیتونه بشین، نمیتونه فلان کنه، بخیه می کنن، لحظه ها عمل می کنن، لازم پلاتین می شه، این سالگی نیست."
    },
    {
      "id": 52,
      "start": 7106.54,
      "end": 7111.54,
      "formatted_start": "01:58:26.540",
      "formatted_end": "01:58:31.540",
      "text": "این ایمار هایی نیست مثلا بریم اتاق و من دیگه بیرون جوان شمزه سالش می کنم"
    },
    {
      "id": 53,
      "start": 7111.54,
      "end": 7116.54,
      "formatted_start": "01:58:31.540",
      "formatted_end": "01:58:36.540",
      "text": "این نیست ولی زمانی هم حالی می کنن که می خواد این فشار فلج کنه"
    },
    {
      "id": 54,
      "start": 7116.54,
      "end": 7121.54,
      "formatted_start": "01:58:36.540",
      "formatted_end": "01:58:41.540",
      "text": "و نخوا رو آسیب بزنه یعنی چه کار رو می کنن؟ جراحی می کنن"
    },
    {
      "id": 55,
      "start": 7121.54,
      "end": 7128.54,
      "formatted_start": "01:58:41.540",
      "formatted_end": "01:58:48.540",
      "text": "این جراحی چون خیلی امکان داره عفونت کنه، امکان داره آسیب به نخوا برسه، امکانهای خیلی زیاد داره"
    },
    {
      "id": 56,
      "start": 7128.54,
      "end": 7133.54,
      "formatted_start": "01:58:48.540",
      "formatted_end": "01:58:53.540",
      "text": "این مقداری که من توی این میبینم و تو اون اموارهای جدیدتره توی میشون میده"
    },
    {
      "id": 57,
      "start": 7133.54,
      "end": 7138.54,
      "formatted_start": "01:58:53.540",
      "formatted_end": "01:58:58.540",
      "text": "آلجین میگن این رو سعی میکنم با روش های غیر جراحی در مون"
    },
    {
      "id": 58,
      "start": 7138.54,
      "end": 7141.54,
      "formatted_start": "01:58:58.540",
      "formatted_end": "01:59:01.540",
      "text": "که از اون ماه هم همین کار داریم"
    },
    {
      "id": 59,
      "start": 7141.54,
      "end": 7147.54,
      "formatted_start": "01:59:01.540",
      "formatted_end": "01:59:07.540",
      "text": "ولی در مال نهایی همه دیسک ها جراحی هست"
    },
    {
      "id": 60,
      "start": 7147.54,
      "end": 7149.54,
      "formatted_start": "01:59:07.540",
      "formatted_end": "01:59:09.540",
      "text": "ولی اقتدا در اون نهایی رو نمی کنن"
    },
    {
      "id": 61,
      "start": 7149.54,
      "end": 7153.54,
      "formatted_start": "01:59:09.540",
      "formatted_end": "01:59:13.540",
      "text": "چون اثرات عمل، عوارض عمل خیلی زیاده هست"
    },
    {
      "id": 62,
      "start": 7153.54,
      "end": 7155.54,
      "formatted_start": "01:59:13.540",
      "formatted_end": "01:59:15.540",
      "text": "حتی ممکنه که فرق هست"
    },
    {
      "id": 63,
      "start": 7155.54,
      "end": 7162.54,
      "formatted_start": "01:59:15.540",
      "formatted_end": "01:59:22.540",
      "text": "برد از همین که هست بیماره را خودتان آمدید، خودتان ماشین سوا شدید، خودتان را ندید، به همموره درد داشتید آمدید ایجاد"
    },
    {
      "id": 64,
      "start": 7163.54,
      "end": 7168.54,
      "formatted_start": "01:59:23.540",
      "formatted_end": "01:59:28.540",
      "text": "ممکنه عمل کنید، دیگه نتونید بیایید، باید کسی های دیگر زیر بقلتون را به چستان بیایید"
    },
    {
      "id": 65,
      "start": 7169.54,
      "end": 7174.54,
      "formatted_start": "01:59:29.540",
      "formatted_end": "01:59:34.540",
      "text": "یعنی عمل بکنید، شما به رخت خواب بیفتید، عمل کنید، نخواهی بشید، عمل کنید"
    },
    {
      "id": 66,
      "start": 7174.54,
      "end": 7182.54,
      "formatted_start": "01:59:34.540",
      "formatted_end": "01:59:42.540",
      "text": "این ریزک ها وقتی وجود داره بیمار با یه مقدار دردی که توی پشت پاش احساس می کنه یه راست نمی رو تا قابل"
    },
    {
      "id": 67,
      "start": 7182.54,
      "end": 7190.54,
      "formatted_start": "01:59:42.540",
      "formatted_end": "01:59:50.540",
      "text": "اینها رو باید روش های درمانی ثبوت کرده رو برای شما اجرا بشه ورزش های آموزش داده بشه"
    },
    {
      "id": 68,
      "start": 7190.54,
      "end": 7199.54,
      "formatted_start": "01:59:50.540",
      "formatted_end": "01:59:59.540",
      "text": "مدام باید انجام بدیم و دارهایی هست که به نگهت طولانی باید صحیحه تحت نظر راشد و درمانی ما دهتر بشه"
    }
  ],
  "status": "completed"
}