  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3304.0,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:04.000",
      "text": "بیمار، سلام عزیزم، دکتر هیچی نگه دکتر نیست."
    },
    {
      "id": 1,
      "start": 3304.0,
      "end": 3307.0,
      "formatted_start": "00:55:04.000",
      "formatted_end": "00:55:07.000",
      "text": "یا الله، بفرما، بفرما."
    },
    {
      "id": 2,
      "start": 3307.0,
      "end": 3309.0,
      "formatted_start": "00:55:07.000",
      "formatted_end": "00:55:09.000",
      "text": "هیچی نگه دکتر نیست."
    },
    {
      "id": 3,
      "start": 3309.0,
      "end": 3314.0,
      "formatted_start": "00:55:09.000",
      "formatted_end": "00:55:14.000",
      "text": "در فشار من آمد دکتر، مردم دیگه، میبینم من."
    },
    {
      "id": 4,
      "start": 3314.0,
      "end": 3315.0,
      "formatted_start": "00:55:14.000",
      "formatted_end": "00:55:15.000",
      "text": "با قوامم میبینم من."
    },
    {
      "id": 5,
      "start": 3315.0,
      "end": 3317.0,
      "formatted_start": "00:55:15.000",
      "formatted_end": "00:55:17.000",
      "text": "چی شده با من؟"
    },
    {
      "id": 6,
      "start": 3317.0,
      "end": 3320.0,
      "formatted_start": "00:55:17.000",
      "formatted_end": "00:55:20.000",
      "text": "هیچی نگه دکتر، به خدا..."
    },
    {
      "id": 7,
      "start": 3320.0,
      "end": 3322.0,
      "formatted_start": "00:55:20.000",
      "formatted_end": "00:55:22.000",
      "text": "باد کرده سوال."
    },
    {
      "id": 8,
      "start": 3322.0,
      "end": 3324.0,
      "formatted_start": "00:55:22.000",
      "formatted_end": "00:55:24.000",
      "text": "هیچی نگه دکتر نیست."
    },
    {
      "id": 9,
      "start": 3324.0,
      "end": 3326.0,
      "formatted_start": "00:55:24.000",
      "formatted_end": "00:55:26.000",
      "text": "چی شد که اینجا شد؟"
    },
    {
      "id": 10,
      "start": 3326.0,
      "end": 3333.0,
      "formatted_start": "00:55:26.000",
      "formatted_end": "00:55:33.000",
      "text": "اگر دختر منه از شماله ساله رنگ میکشم تو نیمیدونه که همین ظالمه که بیارن دیگه اینه در اینجا نکنن"
    },
    {
      "id": 11,
      "start": 3333.0,
      "end": 3336.0,
      "formatted_start": "00:55:33.000",
      "formatted_end": "00:55:36.000",
      "text": "میدونم پست کله مردا رو میکنن زنم"
    },
    {
      "id": 12,
      "start": 3336.0,
      "end": 3340.0,
      "formatted_start": "00:55:36.000",
      "formatted_end": "00:55:40.000",
      "text": "چه در دنان رفته تراجیل چند میدون پول داره؟"
    },
    {
      "id": 13,
      "start": 3340.0,
      "end": 3342.0,
      "formatted_start": "00:55:40.000",
      "formatted_end": "00:55:42.000",
      "text": "توی این موقعیت که ازم"
    },
    {
      "id": 14,
      "start": 3342.0,
      "end": 3346.0,
      "formatted_start": "00:55:42.000",
      "formatted_end": "00:55:46.000",
      "text": "من این یه دن دندان خواستم سی و پنگ بیندون"
    },
    {
      "id": 15,
      "start": 3346.0,
      "end": 3351.0,
      "formatted_start": "00:55:46.000",
      "formatted_end": "00:55:51.000",
      "text": "یک دارم اون سه تا رنجون دارم یک دارم اصلا گرانی افتضاهه"
    },
    {
      "id": 16,
      "start": 3351.0,
      "end": 3353.0,
      "formatted_start": "00:55:51.000",
      "formatted_end": "00:55:53.000",
      "text": "تو دستگیش دستگیش را کن و بینی نگاه کن"
    },
    {
      "id": 17,
      "start": 3353.0,
      "end": 3355.0,
      "formatted_start": "00:55:53.000",
      "formatted_end": "00:55:55.000",
      "text": "خیلی نگاه کنم میبینیم ازش"
    },
    {
      "id": 18,
      "start": 3355.0,
      "end": 3357.0,
      "formatted_start": "00:55:55.000",
      "formatted_end": "00:55:57.000",
      "text": "دهنم باز کنیم ببینیم"
    },
    {
      "id": 19,
      "start": 3357.0,
      "end": 3359.0,
      "formatted_start": "00:55:57.000",
      "formatted_end": "00:55:59.000",
      "text": "آخ نه"
    },
    {
      "id": 20,
      "start": 3359.0,
      "end": 3361.0,
      "formatted_start": "00:55:59.000",
      "formatted_end": "00:56:01.000",
      "text": "نه ندارم همه چیز دو شیوانی داخل کنم"
    },
    {
      "id": 21,
      "start": 3361.0,
      "end": 3363.0,
      "formatted_start": "00:56:01.000",
      "formatted_end": "00:56:03.000",
      "text": "باز باز"
    },
    {
      "id": 22,
      "start": 3363.0,
      "end": 3365.0,
      "formatted_start": "00:56:03.000",
      "formatted_end": "00:56:05.000",
      "text": "این عاقصه انتهاست"
    },
    {
      "id": 23,
      "start": 3365.0,
      "end": 3367.0,
      "formatted_start": "00:56:05.000",
      "formatted_end": "00:56:07.000",
      "text": "عاقصه انتهاییه"
    },
    {
      "id": 24,
      "start": 3367.0,
      "end": 3369.0,
      "formatted_start": "00:56:07.000",
      "formatted_end": "00:56:09.000",
      "text": "اینو دوابیدم"
    },
    {
      "id": 25,
      "start": 3369.0,
      "end": 3371.0,
      "formatted_start": "00:56:09.000",
      "formatted_end": "00:56:11.000",
      "text": "خوب بشه دیگه"
    },
    {
      "id": 26,
      "start": 3371.0,
      "end": 3373.0,
      "formatted_start": "00:56:11.000",
