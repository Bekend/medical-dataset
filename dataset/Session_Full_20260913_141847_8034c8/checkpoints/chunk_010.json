  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3030.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:30.000",
      "text": "از اینجا، با اینکه از اینجا، با اینکه از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، ب"
    },
    {
      "id": 1,
      "start": 3030.0,
      "end": 3032.0,
      "formatted_start": "00:50:30.000",
      "formatted_end": "00:50:32.000",
      "text": "چند روز ششتون رزیعت شده؟"
    },
    {
      "id": 2,
      "start": 3032.0,
      "end": 3034.0,
      "formatted_start": "00:50:32.000",
      "formatted_end": "00:50:34.000",
      "text": "تقریبا یه هفته بشه"
    },
    {
      "id": 3,
      "start": 3034.0,
      "end": 3036.0,
      "formatted_start": "00:50:34.000",
      "formatted_end": "00:50:36.000",
      "text": "بله، صورتتون خیلی جوش داره"
    },
    {
      "id": 4,
      "start": 3036.0,
      "end": 3038.0,
      "formatted_start": "00:50:36.000",
      "formatted_end": "00:50:38.000",
      "text": "این برنامه ازت جوشه کن"
    },
    {
      "id": 5,
      "start": 3038.0,
      "end": 3040.0,
      "formatted_start": "00:50:38.000",
      "formatted_end": "00:50:40.000",
      "text": "خواهید نمیستم برای تو جوش های اتحابی داری"
    },
    {
      "id": 6,
      "start": 3040.0,
      "end": 3042.0,
      "formatted_start": "00:50:40.000",
      "formatted_end": "00:50:42.000",
      "text": "و خوارش هم بیده صورتتون؟"
    },
    {
      "id": 7,
      "start": 3042.0,
      "end": 3043.0,
      "formatted_start": "00:50:42.000",
      "formatted_end": "00:50:43.000",
      "text": "نه"
    },
    {
      "id": 8,
      "start": 3043.0,
      "end": 3044.0,
      "formatted_start": "00:50:43.000",
      "formatted_end": "00:50:44.000",
      "text": "ششتتون خوارش بیده؟"
    },
    {
      "id": 9,
      "start": 3044.0,
      "end": 3045.0,
      "formatted_start": "00:50:44.000",
      "formatted_end": "00:50:45.000",
      "text": "نه خوارش نمیدون"
    },
    {
      "id": 10,
      "start": 3045.0,
      "end": 3046.0,
      "formatted_start": "00:50:45.000",
      "formatted_end": "00:50:46.000",
      "text": "پشانتون رو میگیرم؟"
    },
    {
      "id": 11,
      "start": 3046.0,
      "end": 3047.0,
      "formatted_start": "00:50:46.000",
      "formatted_end": "00:50:47.000",
      "text": "نه، درد، درد، درد، سرد"
    },
    {
      "id": 12,
      "start": 3047.0,
      "end": 3048.0,
      "formatted_start": "00:50:47.000",
      "formatted_end": "00:50:48.000",
      "text": "چند روز ششت درده؟"
    },
    {
      "id": 13,
      "start": 3048.0,
      "end": 3060.0,
      "formatted_start": "00:50:48.000",
      "formatted_end": "00:51:00.000",
      "text": "یکی از چهار یا پنج همه همه شما دردید و یک موقع تیزیو به آرکتی بیشتر بود و یک افتران به کار آرکتی بود."
    },
    {
      "id": 14,
      "start": 3060.0,
      "end": 3062.0,
      "formatted_start": "00:51:00.000",
      "formatted_end": "00:51:02.000",
      "text": "هر زیر؟"
    },
    {
      "id": 15,
      "start": 3062.0,
      "end": 3064.0,
      "formatted_start": "00:51:02.000",
      "formatted_end": "00:51:04.000",
      "text": "هر زیر."
    },
    {
      "id": 16,
      "start": 3064.0,
      "end": 3066.0,
      "formatted_start": "00:51:04.000",
      "formatted_end": "00:51:06.000",
      "text": "سپس بین دردید و چشم باشید؟"
    },
    {
      "id": 17,
      "start": 3066.0,
      "end": 3068.0,
      "formatted_start": "00:51:06.000",
      "formatted_end": "00:51:08.000",
      "text": "بین دردید."
    },
    {
      "id": 18,
      "start": 3068.0,
      "end": 3070.0,
      "formatted_start": "00:51:08.000",
      "formatted_end": "00:51:10.000",
      "text": "از این حاله هست."
    },
    {
      "id": 19,
      "start": 3070.0,
      "end": 3072.0,
      "formatted_start": "00:51:10.000",
      "formatted_end": "00:51:12.000",
      "text": "از این حاله هست."
    },
    {
      "id": 20,
      "start": 3072.0,
      "end": 3074.0,
      "formatted_start": "00:51:12.000",
      "formatted_end": "00:51:14.000",
      "text": "از این حاله هست."
    },
    {
      "id": 21,
      "start": 3074.0,
      "end": 3076.0,
      "formatted_start": "00:51:14.000",
      "formatted_end": "00:51:16.000",
      "text": "بچه کم آرزون هم چونه"
    },
    {
      "id": 22,
      "start": 3076.0,
      "end": 3088.0,
      "formatted_start": "00:51:16.000",
      "formatted_end": "00:51:28.000",
      "text": "در این حال هم بیهاری و کمپولی و دسترس خاندی و آل بچه هم یک قفتا افتاده دید"
    },
    {
      "id": 23,
      "start": 3088.0,
      "end": 3098.0,
      "formatted_start": "00:51:28.000",
      "formatted_end": "00:51:38.000",
      "text": "تغییر مو هست، این در سور 850 هزار تا مرگی دوست داشته بدم هم برای بیهاری هم برای نتشنهای"
    },
    {
      "id": 24,
      "start": 3098.0,
      "end": 3100.0,
      "formatted_start": "00:51:38.000",
      "formatted_end": "00:51:40.000",
      "text": "اینجا باید جوش افترک بدهد"
    },
    {
      "id": 25,
      "start": 3100.0,
      "end": 3102.0,
      "formatted_start": "00:51:40.000",
      "formatted_end": "00:51:42.000",
      "text": "تو باید پشت کنید"
    },
    {
      "id": 26,
      "start": 3102.0,
      "end": 3104.0,
      "formatted_start": "00:51:42.000",
      "formatted_end": "00:51:44.000",
      "text": "این رو باید پشت میکنید"
    },
    {
      "id": 27,
      "start": 3104.0,
      "end": 3106.0,
      "formatted_start": "00:51:44.000",
      "formatted_end": "00:51:46.000",
      "text": "جان"
    },
    {
      "id": 28,
      "start": 3106.0,
      "end": 3108.0,
      "formatted_start": "00:51:46.000",
      "formatted_end": "00:51:48.000",
      "text": "صد درصد باجه باید باشیم"
    },
    {
      "id": 29,
      "start": 3108.0,
      "end": 3110.0,
      "formatted_start": "00:51:48.000",
      "formatted_end": "00:51:50.000",
      "text": "من این رو سیره شدم بدهد به شما"
    },
    {
      "id": 30,
      "start": 3110.0,
      "end": 3112.0,
      "formatted_start": "00:51:50.000",
      "formatted_end": "00:51:52.000",
      "text": "که این رو بهتر دارای ماست"
    },
    {
      "id": 31,
      "start": 3112.0,
      "end": 3114.0,
      "formatted_start": "00:51:52.000",
      "formatted_end": "00:51:54.000",
      "text": "جان"
    },
    {
      "id": 32,
      "start": 3114.0,
      "end": 3116.0,
      "formatted_start": "00:51:54.000",
      "formatted_end": "00:51:56.000",
      "text": "چشم دیگر باشید"
    },
    {
      "id": 33,
      "start": 3116.0,
      "end": 3118.0,
      "formatted_start": "00:51:56.000",
      "formatted_end": "00:51:58.000",
      "text": "سیره باید برم سرسی"
    },
    {
      "id": 34,
      "start": 3118.0,
      "end": 3120.0,
      "formatted_start": "00:51:58.000",
      "formatted_end": "00:52:00.000",
      "text": "در چشم"
    },
    {
      "id": 35,
      "start": 3120.0,
      "end": 3122.0,
      "formatted_start": "00:52:00.000",
      "formatted_end": "00:52:02.000",
      "text": "افترک"
    },
    {
      "id": 36,
      "start": 3122.0,
      "end": 3124.0,
      "formatted_start": "00:52:02.000",
      "formatted_end": "00:52:04.000",
      "text": "در رو به"
    },
    {
      "id": 37,
      "start": 3124.0,
      "end": 3126.0,
      "formatted_start": "00:52:04.000",
      "formatted_end": "00:52:06.000",
      "text": "پوکی"
    },
    {
      "id": 38,
      "start": 3126.0,
      "end": 3131.0,
      "formatted_start": "00:52:06.000",
      "formatted_end": "00:52:11.000",
      "text": "سه تا قطره چشم استفاده می کنید"
    },
    {
      "id": 39,
      "start": 3131.0,
      "end": 3141.0,
      "formatted_start": "00:52:11.000",
      "formatted_end": "00:52:21.000",
      "text": "شروط دکسیون تا کارپی، کپسول بوکسیه 500، برس سپکسیه 400، کپسول پاسیفه"
    },
    {
      "id": 40,
      "start": 3141.0,
      "end": 3145.0,
      "formatted_start": "00:52:21.000",
      "formatted_end": "00:52:25.000",
      "text": "این هست دربای خوراکی، دربای موزه ای"
    },
    {
      "id": 41,
      "start": 3145.0,
      "end": 3151.0,
      "formatted_start": "00:52:25.000",
      "formatted_end": "00:52:31.000",
      "text": "این برای بیوالی و رویزش و سلامت موز برس زیبایی هست"
    },
    {
      "id": 42,
      "start": 3151.0,
      "end": 3153.0,
      "formatted_start": "00:52:31.000",
      "formatted_end": "00:52:33.000",
      "text": "خب بیماری و زیبایی باقی نه"
    },
    {
      "id": 43,
      "start": 3153.0,
      "end": 3160.0,
      "formatted_start": "00:52:33.000",
      "formatted_end": "00:52:40.000",
      "text": "این هم چیز کرمه سلطاناتلی و موشانسی که سریع ترین حالت درمانی رو داره"
    },
    {
      "id": 44,
      "start": 3160.0,
      "end": 3162.0,
      "formatted_start": "00:52:40.000",
      "formatted_end": "00:52:42.000",
      "text": "ولی اینا رو هم رزق دو میلیون توامن شده"
    },
    {
      "id": 45,
      "start": 3162.0,
      "end": 3164.0,
      "formatted_start": "00:52:42.000",
      "formatted_end": "00:52:44.000",
      "text": "یه میلیون نمیزده هفته ده"
    },
    {
      "id": 46,
      "start": 3164.0,
      "end": 3166.0,
      "formatted_start": "00:52:44.000",
      "formatted_end": "00:52:46.000",
      "text": "یه میلیون نمیزده هفته ده"
    },
    {
      "id": 47,
      "start": 3166.0,
      "end": 3168.0,
      "formatted_start": "00:52:46.000",
      "formatted_end": "00:52:48.000",
      "text": "این هم پشت هفته جاییه"
    },
    {
      "id": 48,
      "start": 3168.0,
      "end": 3170.0,
      "formatted_start": "00:52:48.000",
      "formatted_end": "00:52:50.000",
      "text": "اینا رو من اجبار به خریدش نمی کنم"
    },
    {
      "id": 49,
      "start": 3170.0,
      "end": 3172.0,
      "formatted_start": "00:52:50.000",
      "formatted_end": "00:52:52.000",
      "text": "کنون داریم بگیر بهترین داری زیبایی هست"
    },
    {
      "id": 50,
      "start": 3172.0,
      "end": 3174.0,
      "formatted_start": "00:52:52.000",
      "formatted_end": "00:52:54.000",
      "text": "نداری که یه چیز استفاده نکن"
    },
    {
      "id": 51,
      "start": 3174.0,
      "end": 3179.74,
      "formatted_start": "00:52:54.000",
      "formatted_end": "00:52:59.740",
      "text": "بعد این دوران ها ولی ایما و چیز ها بیمان نداره تو که برمش مزارید"
    },
    {
      "id": 52,
      "start": 3179.74,
      "end": 3186.24,
      "formatted_start": "00:52:59.740",
      "formatted_end": "00:53:06.240",
      "text": "قطعه چشم میباشتم سه تا دوای صرفه و سردردی هالی"
    },
    {
      "id": 53,
      "start": 3186.24,
      "end": 3192.7,
      "formatted_start": "00:53:06.240",
      "formatted_end": "00:53:12.700",
      "text": "این دوای بیهالی باجب برد باید بگیر کار داری اگه کار دار اینا بهترین هم بدم بهترین"
    },
    {
      "id": 54,
      "start": 3192.7,
      "end": 3194.0,
      "formatted_start": "00:53:12.700",
      "formatted_end": "00:53:14.000",
      "text": "خب میخوای همون برنیم"
    },
    {
      "id": 55,
      "start": 3194.0,
      "end": 3197.24,
      "formatted_start": "00:53:14.000",
      "formatted_end": "00:53:17.240",
      "text": "بیهالی رو نیست دارم باید بریم گوهر بگیریم بریم"
    },
    {
      "id": 56,
      "start": 3197.24,
      "end": 3201.0,
      "formatted_start": "00:53:17.240",
      "formatted_end": "00:53:21.000",
      "text": "بیهال نیم از گروه میردم برای گوهرم آموان ندارم"
    },
    {
      "id": 57,
      "start": 3201.0,
      "end": 3203.0,
      "formatted_start": "00:53:21.000",
      "formatted_end": "00:53:23.000",
      "text": "اوه، مندازه شعر نیست که سنگیرون داره"
    },
    {
      "id": 58,
      "start": 3203.0,
      "end": 3205.0,
      "formatted_start": "00:53:23.000",
      "formatted_end": "00:53:25.000",
      "text": "آره، این دیگه خیلی بازشکرده"
    },
    {
      "id": 59,
      "start": 3205.0,
      "end": 3209.0,
      "formatted_start": "00:53:25.000",
      "formatted_end": "00:53:29.000",
      "text": "بده، کارترین به نیست که نیست کارترین برگاه"
    },
    {
      "id": 60,
      "start": 3211.0,
      "end": 3212.0,
      "formatted_start": "00:53:31.000",
      "formatted_end": "00:53:32.000",
      "text": "کارتر؟"
    },
    {
      "id": 61,
      "start": 3212.0,
      "end": 3213.0,
      "formatted_start": "00:53:32.000",
      "formatted_end": "00:53:33.000",
      "text": "بانکی"
    },
    {
      "id": 62,
      "start": 3213.0,
      "end": 3218.0,
      "formatted_start": "00:53:33.000",
      "formatted_end": "00:53:38.000",
      "text": "بده، زنده جوشو میخوایی آشان دیگه گرانه موصلت"
    },
    {
      "id": 63,
      "start": 3218.0,
      "end": 3220.0,
      "formatted_start": "00:53:38.000",
      "formatted_end": "00:53:40.000",
      "text": "درسته؟"
    },
    {
      "id": 64,
      "start": 3220.0,
      "end": 3226.0,
      "formatted_start": "00:53:40.000",
      "formatted_end": "00:53:46.000",
      "text": "آره، برای شسلا، خوبسته، روزی یک دوره میخوایی"
    },
    {
      "id": 65,
      "start": 3226.0,
      "end": 3228.0,
      "formatted_start": "00:53:46.000",
      "formatted_end": "00:53:48.000",
      "text": "منم اول غذا باید بخواییم"
    },
    {
      "id": 66,
      "start": 3228.0,
      "end": 3232.0,
      "formatted_start": "00:53:48.000",
      "formatted_end": "00:53:52.000",
      "text": "او روزی که بخوایید، قبل از غذا روزی یک دنبال دارید"
    },
    {
      "id": 67,
      "start": 3232.0,
      "end": 3237.0,
      "formatted_start": "00:53:52.000",
      "formatted_end": "00:53:57.000",
      "text": "روشنش دوتا اینه و اونه دارید، بسایی یک دنبال دارید، در یک دو ماه کافی میدونید"
    },
    {
      "id": 68,
      "start": 3237.0,
      "end": 3245.0,
      "formatted_start": "00:53:57.000",
      "formatted_end": "00:54:05.000",
      "text": "روزی چی؟ یک دنبال قبل از غذا دارید، نها رو در نظر دارید، قبل از نها دارید"
    },
    {
      "id": 69,
      "start": 3245.0,
      "end": 3248.0,
      "formatted_start": "00:54:05.000",
      "formatted_end": "00:54:08.000",
      "text": "به لحاظ روشن، غذا دارید"
    },
    {
      "id": 70,
      "start": 3248.0,
      "end": 3262.8,
      "formatted_start": "00:54:08.000",
      "formatted_end": "00:54:22.800",
      "text": "بیبالی و زیبایی درمان چکی هست"
    },
    {
      "id": 71,
      "start": 3278.0,
      "end": 3280.0,
      "formatted_start": "00:54:38.000",
      "formatted_end": "00:54:40.000",
      "text": "بسیار"
    },
    {
      "id": 72,
      "start": 3287.0,
      "end": 3290.0,
      "formatted_start": "00:54:47.000",
      "formatted_end": "00:54:50.000",
      "text": "یک هفته دیگه برای چشمت باز برده"
    },
    {
      "id": 73,
      "start": 3292.0,
      "end": 3294.0,
      "formatted_start": "00:54:52.000",
      "formatted_end": "00:54:54.000",
      "text": "بیر در خورما ببین"
    }
  ],
  "status": "completed"
}