      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:59.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 2,
      "start": 2160.0,
      "end": 2189.98,
      "formatted_start": "00:36:00.000",
      "formatted_end": "00:36:29.980",
      "text": "مرد در اینجا"
    },
    {
      "id": 3,
      "start": 2220.0,
      "end": 2250.0,
      "formatted_start": "00:37:00.000",
      "formatted_end": "00:37:30.000",
      "text": "برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینک"
    },
    {
      "id": 4,
      "start": 2250.0,
      "end": 2259.92,
      "formatted_start": "00:37:30.000",
      "formatted_end": "00:37:39.920",
      "text": "بفرما"
    },
    {
      "id": 5,
      "start": 2259.92,
      "end": 2266.92,
      "formatted_start": "00:37:39.920",
      "formatted_end": "00:37:46.920",
      "text": "بفرما"
    },
    {
      "id": 6,
      "start": 2266.92,
      "end": 2267.64,
      "formatted_start": "00:37:46.920",
      "formatted_end": "00:37:47.640",
      "text": "بفرما"
    },
    {
      "id": 7,
      "start": 2267.64,
      "end": 2268.3,
      "formatted_start": "00:37:47.640",
      "formatted_end": "00:37:48.300",
      "text": "بفرما"
    },
    {
      "id": 8,
      "start": 2268.3,
      "end": 2270.68,
      "formatted_start": "00:37:48.300",
      "formatted_end": "00:37:50.680",
      "text": "بفرما"
    },
    {
      "id": 9,
      "start": 2270.68,
      "end": 2274.92,
      "formatted_start": "00:37:50.680",
      "formatted_end": "00:37:54.920",
      "text": "بفرما بشید"
    },
    {
      "id": 10,
      "start": 2274.92,
      "end": 2284.92,
      "formatted_start": "00:37:54.920",
      "formatted_end": "00:38:04.920",
      "text": "این مورد ترسی نداشت من از اینجا تنها درد میشم"
    },
    {
      "id": 11,
      "start": 2284.92,
      "end": 2290.92,
      "formatted_start": "00:38:04.920",
      "formatted_end": "00:38:10.920",
      "text": "این درد شما سه ماه هست"
    },
    {
      "id": 12,
      "start": 2290.92,
      "end": 2294.92,
      "formatted_start": "00:38:10.920",
      "formatted_end": "00:38:14.920",
      "text": "نه نه خواهش بود نمیشه"
    },
    {
      "id": 13,
      "start": 2294.92,
      "end": 2300.92,
      "formatted_start": "00:38:14.920",
      "formatted_end": "00:38:20.920",
      "text": "این هر روز زوده"
    },
    {
      "id": 14,
      "start": 2300.92,
      "end": 2302.92,
      "formatted_start": "00:38:20.920",
      "formatted_end": "00:38:22.920",
      "text": "نه، نه، نه، چیز نیست، چیز نیست"
    },
    {
      "id": 15,
      "start": 2302.92,
      "end": 2304.92,
      "formatted_start": "00:38:22.920",
      "formatted_end": "00:38:24.920",
      "text": "نه، نه، چیز نیست، چیز نیست"
    },
    {
      "id": 16,
      "start": 2304.92,
      "end": 2306.92,
      "formatted_start": "00:38:24.920",
      "formatted_end": "00:38:26.920",
      "text": "ما که، ما واقعاً بیخوانیم"
    },
    {
      "id": 17,
      "start": 2306.92,
      "end": 2308.92,
      "formatted_start": "00:38:26.920",
      "formatted_end": "00:38:28.920",
      "text": "اتیادم داری؟"
    },
    {
      "id": 18,
      "start": 2308.92,
      "end": 2310.92,
      "formatted_start": "00:38:28.920",
      "formatted_end": "00:38:30.920",
      "text": "نه، نه، خوشی؟"
    },
    {
      "id": 19,
      "start": 2310.92,
      "end": 2312.92,
      "formatted_start": "00:38:30.920",
      "formatted_end": "00:38:32.920",
      "text": "داروی اصاب میخوانی؟"
    },
    {
      "id": 20,
      "start": 2312.92,
      "end": 2314.92,
      "formatted_start": "00:38:32.920",
      "formatted_end": "00:38:34.920",
      "text": "نه، اصلاً دارو نمیخوانم"
    },
    {
      "id": 21,
      "start": 2314.92,
      "end": 2316.92,
      "formatted_start": "00:38:34.920",
      "formatted_end": "00:38:36.920",
      "text": "همینجوری خودش بی حال"
    },
    {
      "id": 22,
      "start": 2316.92,
      "end": 2318.92,
      "formatted_start": "00:38:36.920",
      "formatted_end": "00:38:38.920",
      "text": "بس چون باشه که میشنم از من خواهد میبردم"
    },
    {
      "id": 23,
      "start": 2318.92,
      "end": 2320.92,
      "formatted_start": "00:38:38.920",
      "formatted_end": "00:38:40.920",
      "text": "بس چون باشه که میشنم از من خواهد میبردم"
    },
    {
      "id": 24,
      "start": 2320.92,
      "end": 2322.92,
      "formatted_start": "00:38:40.920",
      "formatted_end": "00:38:42.920",
      "text": "این تازبورو که هست که نیاز به جا به جایی داره"
    },
    {
      "id": 25,
      "start": 2322.92,
      "end": 2326.92,
      "formatted_start": "00:38:42.920",
      "formatted_end": "00:38:46.920",
      "text": "در اینجا که اینجا که جا به جایی داره. خواهید یک جهاندازی انجام بده."
    },
    {
      "id": 26,
      "start": 2326.92,
      "end": 2330.92,
      "formatted_start": "00:38:46.920",
      "formatted_end": "00:38:50.920",
      "text": "در رفته. تانگل هاش برده. از تو خونش در رفته."
    },
    {
      "id": 27,
      "start": 2330.92,
      "end": 2334.92,
      "formatted_start": "00:38:50.920",
      "formatted_end": "00:38:54.920",
      "text": "در جا به جایی تانگل داره."
    },
    {
      "id": 28,
      "start": 2334.92,
      "end": 2338.92,
      "formatted_start": "00:38:54.920",
      "formatted_end": "00:38:58.920",
      "text": "شما باید متعونید."
    },
    {
      "id": 29,
      "start": 2338.92,
      "end": 2342.92,
      "formatted_start": "00:38:58.920",
      "formatted_end": "00:39:02.920",
      "text": "همسر صحبت کنید. جزوی دارد انجام بده."
    },
    {
      "id": 30,
      "start": 2342.92,
      "end": 2346.92,
      "formatted_start": "00:39:02.920",
      "formatted_end": "00:39:06.920",
      "text": "زنگ بزن. شاید کجایی؟"
    },
    {
      "id": 31,
      "start": 2346.92,
      "end": 2350.92,
      "formatted_start": "00:39:06.920",
      "formatted_end": "00:39:10.920",
      "text": "شاید کجا؟"
    },
    {
      "id": 32,
      "start": 2350.92,
      "end": 2352.92,
      "formatted_start": "00:39:10.920",
      "formatted_end": "00:39:12.920",
      "text": "درشه درشه"
    },
    {
      "id": 33,
      "start": 2352.92,
      "end": 2354.92,
      "formatted_start": "00:39:12.920",
      "formatted_end": "00:39:14.920",
      "text": "کدوم رضایی؟"
    },
    {
      "id": 34,
      "start": 2354.92,
      "end": 2356.92,
      "formatted_start": "00:39:14.920",
      "formatted_end": "00:39:16.920",
      "text": "کدوم درشه؟"
    },
    {
      "id": 35,
      "start": 2356.92,
      "end": 2358.92,
      "formatted_start": "00:39:16.920",
      "formatted_end": "00:39:18.920",
      "text": "رضا؟"
    },
    {
      "id": 36,
      "start": 2358.92,
      "end": 2360.92,
      "formatted_start": "00:39:18.920",
      "formatted_end": "00:39:20.920",
      "text": "خسن علی درشو میشناسی ادام کردن"
    },
    {
      "id": 37,
      "start": 2360.92,
      "end": 2362.92,
      "formatted_start": "00:39:20.920",
      "formatted_end": "00:39:22.920",
      "text": "آره"
    },
    {
      "id": 38,
      "start": 2362.92,
      "end": 2364.92,
      "formatted_start": "00:39:22.920",
      "formatted_end": "00:39:24.920",
      "text": "من زن و رضا روش هستم"
    },
    {
      "id": 39,
      "start": 2364.92,
      "end": 2366.92,
      "formatted_start": "00:39:24.920",
      "formatted_end": "00:39:26.920",
      "text": "حسین ادام کردن؟"
    },
    {
      "id": 40,
      "start": 2366.92,
      "end": 2368.92,
      "formatted_start": "00:39:26.920",
      "formatted_end": "00:39:28.920",
      "text": "خسن علی درشه"
    },
    {
      "id": 41,
      "start": 2368.92,
      "end": 2370.92,
      "formatted_start": "00:39:28.920",
      "formatted_end": "00:39:30.920",
      "text": "ادام کردن"
    },
    {
      "id": 42,
      "start": 2370.92,
      "end": 2372.92,
      "formatted_start": "00:39:30.920",
      "formatted_end": "00:39:32.920",
      "text": "و رضا بیرونه؟"
    },
    {
      "id": 43,
      "start": 2372.92,
      "end": 2374.92,
      "formatted_start": "00:39:32.920",
      "formatted_end": "00:39:34.920",
      "text": "رضا درش"
    },
    {
      "id": 44,
      "start": 2374.92,
      "end": 2376.92,
      "formatted_start": "00:39:34.920",
      "formatted_end": "00:39:36.920",
      "text": "رضا آره"
    },
    {
      "id": 45,
      "start": 2376.92,
      "end": 2378.92,
      "formatted_start": "00:39:36.920",
      "formatted_end": "00:39:38.920",
      "text": "توران فارس میشه"
    },
    {
      "id": 46,
      "start": 2378.92,
      "end": 2380.92,
      "formatted_start": "00:39:38.920",
      "formatted_end": "00:39:40.920",
      "text": "زن اموش نیستی"
    },
    {
      "id": 47,
      "start": 2380.92,
      "end": 2384.92,
      "formatted_start": "00:39:40.920",
      "formatted_end": "00:39:44.920",
      "text": "حسین ای ادام کرده تو زن برار برادر اموش"
    },
    {
      "id": 48,
      "start": 2384.92,
      "end": 2387.92,
      "formatted_start": "00:39:44.920",
      "formatted_end": "00:39:47.920",
      "text": "حسین درست پسر خواله منو هست"
    },
    {
      "id": 49,
      "start": 2387.92,
      "end": 2389.92,
      "formatted_start": "00:39:47.920",
      "formatted_end": "00:39:49.920",
      "text": "شوهر تو هم پسر خوالت بود دیگه"
    },
    {
      "id": 50,
      "start": 2389.92,
      "end": 2391.92,
      "formatted_start": "00:39:49.920",
      "formatted_end": "00:39:51.920",
      "text": "آره پسر خواله بود"
    },
    {
      "id": 51,
      "start": 2391.92,
      "end": 2393.92,
      "formatted_start": "00:39:51.920",
      "formatted_end": "00:39:53.920",
      "text": "اسم شوهر چی بود؟"
    },
    {
      "id": 52,
      "start": 2393.92,
      "end": 2394.92,
      "formatted_start": "00:39:53.920",
      "formatted_end": "00:39:54.920",
      "text": "سلطان علی"
    },
    {
      "id": 53,
      "start": 2394.92,
      "end": 2399.92,
      "formatted_start": "00:39:54.920",
      "formatted_end": "00:39:59.920",
      "text": "یه زنگ بذار اجازه بگیر اگر اجازه بگیره من اینو حالا برای تو درست کنم"
    }
  ],
  "status": "completed"
