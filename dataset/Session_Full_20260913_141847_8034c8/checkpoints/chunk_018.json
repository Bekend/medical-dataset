  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5405.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:05.000",
      "text": "از اینجا آمده دکتر متوجه شدند، ولی الان برامش خوابیده است."
    },
    {
      "id": 1,
      "start": 5405.0,
      "end": 5409.0,
      "formatted_start": "01:30:05.000",
      "formatted_end": "01:30:09.000",
      "text": "بله، پس ما دو تکلیفن ها بزنیم، سشوه ها رو بزنید کشکا."
    },
    {
      "id": 2,
      "start": 5409.0,
      "end": 5411.0,
      "formatted_start": "01:30:09.000",
      "formatted_end": "01:30:11.000",
      "text": "ما سشوه ها بزنیم."
    },
    {
      "id": 3,
      "start": 5411.0,
      "end": 5415.0,
      "formatted_start": "01:30:11.000",
      "formatted_end": "01:30:15.000",
      "text": "سشوه ها بزنید، از پشت گردن، این حضوره کسیش؟"
    },
    {
      "id": 4,
      "start": 5415.0,
      "end": 5420.0,
      "formatted_start": "01:30:15.000",
      "formatted_end": "01:30:20.000",
      "text": "زور زنقیه، قسمتش رو گردن، قسمتش میاد روی بازون."
    },
    {
      "id": 5,
      "start": 5420.0,
      "end": 5422.0,
      "formatted_start": "01:30:20.000",
      "formatted_end": "01:30:22.000",
      "text": "علتش، همه ای دنتر به بچه دارید."
    },
    {
      "id": 6,
      "start": 5422.0,
      "end": 5427.58,
      "formatted_start": "01:30:22.000",
      "formatted_end": "01:30:27.580",
      "text": "بعد خوابیدن، موبایل استفاده کردن، استفاده از گردن بیش از اندازه"
    },
    {
      "id": 7,
      "start": 5427.58,
      "end": 5430.7,
      "formatted_start": "01:30:27.580",
      "formatted_end": "01:30:30.700",
      "text": "و نخوردن منیازیوم و کلسیوم"
    },
    {
      "id": 8,
      "start": 5430.7,
      "end": 5432.7,
      "formatted_start": "01:30:30.700",
      "formatted_end": "01:30:32.700",
      "text": "منیازیوم و کلسیوم؟"
    },
    {
      "id": 9,
      "start": 5432.7,
      "end": 5434.7,
      "formatted_start": "01:30:32.700",
      "formatted_end": "01:30:34.700",
      "text": "آره، این رو براتونیم"
    },
    {
      "id": 10,
      "start": 5434.7,
      "end": 5436.7,
      "formatted_start": "01:30:34.700",
      "formatted_end": "01:30:36.700",
      "text": "من ملیتو برم برم"
    },
    {
      "id": 11,
      "start": 5436.7,
      "end": 5438.7,
      "formatted_start": "01:30:36.700",
      "formatted_end": "01:30:38.700",
      "text": "یعنی ماست اینا میخورم"
    },
    {
      "id": 12,
      "start": 5438.7,
      "end": 5441.7,
      "formatted_start": "01:30:38.700",
      "formatted_end": "01:30:41.700",
      "text": "نه، ماست اصلا میگیم نخواییم، ماست کجا کجا کنیم"
    },
    {
      "id": 13,
      "start": 5441.7,
      "end": 5444.7,
      "formatted_start": "01:30:41.700",
      "formatted_end": "01:30:44.700",
      "text": "اولتی خواه من انجیل خوش خوش، کشمش اینا رو میخورم"
    },
    {
      "id": 14,
      "start": 5444.7,
      "end": 5446.7,
      "formatted_start": "01:30:44.700",
      "formatted_end": "01:30:46.700",
      "text": "اصلا ایرانی ها زیاد میخورن"
    },
    {
      "id": 15,
      "start": 5446.7,
      "end": 5448.7,
      "formatted_start": "01:30:46.700",
      "formatted_end": "01:30:48.700",
      "text": "شما اون خوردن کم نیست"
    },
    {
      "id": 16,
      "start": 5448.7,
      "end": 5455.7,
      "formatted_start": "01:30:48.700",
      "formatted_end": "01:30:55.700",
      "text": "میگن پردن اونجون کم نیست، جذب اینها مشکل داره، با دسته، جذبشون"
    },
    {
      "id": 17,
      "start": 5455.7,
      "end": 5465.7,
      "formatted_start": "01:30:55.700",
      "formatted_end": "01:31:05.700",
      "text": "به خاطر خاصیت های هرمانی خانوم ها است که بعضی چیزها مختلف میشه و دیگه دو چاره درده گستخانی میشن"
    },
    {
      "id": 18,
      "start": 5465.7,
      "end": 5471.7,
      "formatted_start": "01:31:05.700",
      "formatted_end": "01:31:11.700",
      "text": "همین خانوم های گستخانشون در وید زانوشه، کمهرشه، گوچه دستشه، گستخانه میلنگه"
    },
    {
      "id": 19,
      "start": 5471.7,
      "end": 5478.7,
      "formatted_start": "01:31:11.700",
      "formatted_end": "01:31:18.700",
      "text": "آدت میشن، زایبان میکنن، بچه شیر میدین، همه گستخان رو مصرف میکنن"
    },
    {
      "id": 20,
      "start": 5478.7,
      "end": 5485.7,
      "formatted_start": "01:31:18.700",
      "formatted_end": "01:31:25.700",
      "text": "و بهتر شدی از اون روز، بعدی خب با زده میدن، من گفت اون رو بیاد که..."
    },
    {
      "id": 21,
      "start": 5489.7,
      "end": 5494.7,
      "formatted_start": "01:31:29.700",
      "formatted_end": "01:31:34.700",
      "text": "من در واقع طریقا تقریتی نمیخورم اصلا، بخصی صدید بیدم"
    },
    {
      "id": 22,
      "start": 5494.7,
      "end": 5524.7,
      "formatted_start": "01:31:34.700",
      "formatted_end": "01:32:04.700",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 23,
      "start": 5524.7,
      "end": 5527.7,
      "formatted_start": "01:32:04.700",
      "formatted_end": "01:32:07.700",
      "text": "ارز کنم که دویست و بیست و پنج درجه چربی داره"
    },
    {
      "id": 24,
      "start": 5527.7,
      "end": 5529.7,
      "formatted_start": "01:32:07.700",
      "formatted_end": "01:32:09.700",
      "text": "یه هومه چگاه هفت کراتین"
    },
    {
      "id": 25,
      "start": 5529.7,
      "end": 5531.7,
      "formatted_start": "01:32:09.700",
      "formatted_end": "01:32:11.700",
      "text": "کراتین چیزی مهم نیه"
    },
    {
      "id": 26,
      "start": 5531.7,
      "end": 5533.7,
      "formatted_start": "01:32:11.700",
      "formatted_end": "01:32:13.700",
      "text": "جان سلام های اتحالتون خوبه؟"
    },
    {
      "id": 27,
      "start": 5533.7,
      "end": 5534.7,
      "formatted_start": "01:32:13.700",
      "formatted_end": "01:32:14.700",
      "text": "خوبه"
    },
    {
      "id": 28,
      "start": 5534.7,
      "end": 5537.7,
      "formatted_start": "01:32:14.700",
      "formatted_end": "01:32:17.700",
      "text": "بسته نباشه خوبی؟ من به آی نیست نک زدم"
    },
    {
      "id": 29,
      "start": 5537.7,
      "end": 5540.7,
      "formatted_start": "01:32:17.700",
      "formatted_end": "01:32:20.700",
      "text": "خواهش می کنم باره دوتا موردش"
    },
    {
      "id": 30,
      "start": 5540.7,
      "end": 5542.7,
      "formatted_start": "01:32:20.700",
      "formatted_end": "01:32:22.700",
      "text": "آره برم نیست"
    },
    {
      "id": 31,
      "start": 5542.7,
      "end": 5544.7,
      "formatted_start": "01:32:22.700",
      "formatted_end": "01:32:24.700",
      "text": "عزیز دلی ها قربانشون"
    },
    {
      "id": 32,
      "start": 5544.7,
      "end": 5546.7,
      "formatted_start": "01:32:24.700",
      "formatted_end": "01:32:26.700",
      "text": "بره خواهش می کنم"
    },
    {
      "id": 33,
      "start": 5546.7,
      "end": 5548.7,
      "formatted_start": "01:32:26.700",
      "formatted_end": "01:32:28.700",
      "text": "خواهش می کنم برم شما"
    },
    {
      "id": 34,
      "start": 5548.7,
      "end": 5571.7,
      "formatted_start": "01:32:28.700",
      "formatted_end": "01:32:51.700",
      "text": "دو تا مشکل اینکی تجمیه ۵۰۰ بود، آره اون تجمیهش نیومده، یکی هم نو مال مرکزی که نوه قسمت دومش نیومده، آره دو ماه، دو ماه"
    },
    {
      "id": 35,
      "start": 5571.7,
      "end": 5573.7,
      "formatted_start": "01:32:51.700",
      "formatted_end": "01:32:53.700",
      "text": "اون اوله 26 روزه"
    },
    {
      "id": 36,
      "start": 5577.12,
      "end": 5579.82,
      "formatted_start": "01:32:57.120",
      "formatted_end": "01:32:59.820",
      "text": "نه، شما که خودتون تجمیل کردید دیگه"
    },
    {
      "id": 37,
      "start": 5580.02,
      "end": 5583.68,
      "formatted_start": "01:33:00.020",
      "formatted_end": "01:33:03.680",
      "text": "اون 26 روز داردید، 20 و 50 روز شما دارید"
    },
    {
      "id": 38,
      "start": 5583.68,
      "end": 5585.68,
      "formatted_start": "01:33:03.680",
      "formatted_end": "01:33:05.680",
      "text": "6 و 50 روزش مانده بوده"
    },
    {
      "id": 39,
      "start": 5587.56,
      "end": 5591.96,
      "formatted_start": "01:33:07.560",
      "formatted_end": "01:33:11.960",
      "text": "26 روز 6 و 50، آفره 6 و 50، 5 سا سکیه بود"
    },
    {
      "id": 40,
      "start": 5592.38,
      "end": 5597.24,
      "formatted_start": "01:33:12.380",
      "formatted_end": "01:33:17.240",
      "text": "بعد یکی همچین، خاشیه مرکز، آفره"
    },
    {
      "id": 41,
      "start": 5597.92,
      "end": 5599.92,
      "formatted_start": "01:33:17.920",
      "formatted_end": "01:33:19.920",
      "text": "قامه نه، خاشیه شد"
    },
    {
      "id": 42,
      "start": 5599.92,
      "end": 5605.92,
      "formatted_start": "01:33:19.920",
      "formatted_end": "01:33:25.920",
      "text": "دو ماه هاشیه، این هم دو ماه هاشیه، این تجمیه هاشیه، بعده"
    },
    {
      "id": 43,
      "start": 5605.92,
      "end": 5611.92,
      "formatted_start": "01:33:25.920",
      "formatted_end": "01:33:31.920",
      "text": "آره گفت من میام رنگ زنده با خودتون برم، برم روشون برم"
    },
    {
      "id": 44,
      "start": 5611.92,
      "end": 5616.92,
      "formatted_start": "01:33:31.920",
      "formatted_end": "01:33:36.920",
      "text": "سر اختیار دارید، دشمنتون شرمده باشه، برم برم خودتون"
    },
    {
      "id": 45,
      "start": 5616.92,
      "end": 5622.92,
      "formatted_start": "01:33:36.920",
      "formatted_end": "01:33:42.920",
      "text": "آه دکتر ببخشید، اول از وایه کمر هم رفتم روک دور چون این تلجه هاش میره فیزیترابی هم بره"
    },
    {
      "id": 46,
      "start": 5622.92,
      "end": 5623.92,
      "formatted_start": "01:33:42.920",
      "formatted_end": "01:33:43.920",
      "text": "اینه با؟"
    },
    {
      "id": 47,
      "start": 5623.92,
      "end": 5624.92,
      "formatted_start": "01:33:43.920",
      "formatted_end": "01:33:44.920",
      "text": "بره"
    },
    {
      "id": 48,
      "start": 5624.92,
      "end": 5630.08,
      "formatted_start": "01:33:44.920",
      "formatted_end": "01:33:50.080",
      "text": "نه اینکه بهش باید عمل جرایی بشی و بعد که نیست استا کم زده بیرون"
    },
    {
      "id": 49,
      "start": 5630.08,
      "end": 5632.36,
      "formatted_start": "01:33:50.080",
      "formatted_end": "01:33:52.360",
      "text": "استا؟ اونو که امارای میشه بسکنی"
    },
    {
      "id": 50,
      "start": 5632.36,
      "end": 5633.74,
      "formatted_start": "01:33:52.360",
      "formatted_end": "01:33:53.740",
      "text": "آره امارای رفته دیگه"
    },
    {
      "id": 51,
      "start": 5633.74,
      "end": 5640.16,
      "formatted_start": "01:33:53.740",
      "formatted_end": "01:34:00.160",
      "text": "نه اینکه الان باید کلیهش باید اول درکتور کلیه کلیهش رو درمان کنیم"
    },
    {
      "id": 52,
      "start": 5640.16,
      "end": 5642.92,
      "formatted_start": "01:34:00.160",
      "formatted_end": "01:34:02.920",
      "text": "پد نیاز به دارو یا نداری؟ یا باید درکتور کلیه؟"
    },
    {
      "id": 53,
      "start": 5642.92,
      "end": 5644.04,
      "formatted_start": "01:34:02.920",
      "formatted_end": "01:34:04.040",
      "text": "چرا بود؟"
    },
    {
      "id": 54,
      "start": 5644.04,
      "end": 5648.54,
      "formatted_start": "01:34:04.040",
      "formatted_end": "01:34:08.540",
      "text": "نه این نیاز به داروی چردی خون داری، نیاز به درمان کلیه داری"
    },
    {
      "id": 55,
      "start": 5648.54,
      "end": 5678.54,
      "formatted_start": "01:34:08.540",
      "formatted_end": "01:34:38.540",
      "text": "از اینه بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 56,
      "start": 5678.54,
      "end": 5680.54,
      "formatted_start": "01:34:38.540",
      "formatted_end": "01:34:40.540",
      "text": "از اینجور من چون نقش کشی شما می آمده"
    },
    {
      "id": 57,
      "start": 5680.54,
      "end": 5682.54,
      "formatted_start": "01:34:40.540",
      "formatted_end": "01:34:42.540",
      "text": "سی"
    },
    {
      "id": 58,
      "start": 5682.54,
      "end": 5684.54,
      "formatted_start": "01:34:42.540",
      "formatted_end": "01:34:44.540",
      "text": "۸۲ بره"
    },
    {
      "id": 59,
      "start": 5684.54,
      "end": 5686.54,
      "formatted_start": "01:34:44.540",
      "formatted_end": "01:34:46.540",
      "text": "این کار برای کراتینی نیست"
    },
    {
      "id": 60,
      "start": 5686.54,
      "end": 5688.54,
      "formatted_start": "01:34:46.540",
      "formatted_end": "01:34:48.540",
      "text": "پرسه"
    },
    {
      "id": 61,
      "start": 5688.54,
      "end": 5690.54,
      "formatted_start": "01:34:48.540",
      "formatted_end": "01:34:50.540",
      "text": "رینالیکس"
    },
    {
      "id": 62,
      "start": 5690.54,
      "end": 5692.54,
      "formatted_start": "01:34:50.540",
      "formatted_end": "01:34:52.540",
      "text": "پس اینکار اول برای کراتینش و ارکولیه شما"
    },
    {
      "id": 63,
      "start": 5692.54,
      "end": 5694.54,
      "formatted_start": "01:34:52.540",
      "formatted_end": "01:34:54.540",
      "text": "اینکار کراتین پایین نه کسی بیوشش شده بکنه که"
    },
    {
      "id": 64,
      "start": 5694.54,
      "end": 5696.54,
      "formatted_start": "01:34:54.540",
      "formatted_end": "01:34:56.540",
      "text": "پرسه"
    },
    {
      "id": 65,
      "start": 5696.54,
      "end": 5698.54,
      "formatted_start": "01:34:56.540",
      "formatted_end": "01:34:58.540",
      "text": "نفرو"
    },
    {
      "id": 66,
      "start": 5698.54,
      "end": 5700.54,
      "formatted_start": "01:34:58.540",
      "formatted_end": "01:35:00.540",
      "text": "ویدیو"
    }
  ],
  "status": "completed"
}