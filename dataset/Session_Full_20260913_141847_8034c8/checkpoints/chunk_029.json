  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8729.98,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:29.980",
      "text": "بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "خودشو صافتنشو بیاییم"
    },
    {
      "id": 2,
      "start": 8732.0,
      "end": 8734.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:34.000",
      "text": "دو پا میز رو دردید"
    },
    {
      "id": 3,
      "start": 8734.0,
      "end": 8736.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:36.000",
      "text": "بله انشالله بهتر میشه"
    },
    {
      "id": 4,
      "start": 8736.0,
      "end": 8738.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:38.000",
      "text": "رقاب شم شده"
    },
    {
      "id": 5,
      "start": 8738.0,
      "end": 8740.0,
      "formatted_start": "02:25:38.000",
      "formatted_end": "02:25:40.000",
      "text": "این دیگه"
    },
    {
      "id": 6,
      "start": 8740.0,
      "end": 8742.0,
      "formatted_start": "02:25:40.000",
      "formatted_end": "02:25:42.000",
      "text": "این دردیه"
    },
    {
      "id": 7,
      "start": 8742.0,
      "end": 8744.0,
      "formatted_start": "02:25:42.000",
      "formatted_end": "02:25:44.000",
      "text": "از همین پاهم نمیدونیم"
    },
    {
      "id": 8,
      "start": 8744.0,
      "end": 8746.0,
      "formatted_start": "02:25:44.000",
      "formatted_end": "02:25:46.000",
      "text": "چپ بتریه"
    },
    {
      "id": 9,
      "start": 8746.0,
      "end": 8748.0,
      "formatted_start": "02:25:46.000",
      "formatted_end": "02:25:48.000",
      "text": "چپ ضعیفه"
    },
    {
      "id": 10,
      "start": 8748.0,
      "end": 8750.0,
      "formatted_start": "02:25:48.000",
      "formatted_end": "02:25:50.000",
      "text": "این راگ سیادی که دخواهد"
    },
    {
      "id": 11,
      "start": 8750.0,
      "end": 8752.0,
      "formatted_start": "02:25:50.000",
      "formatted_end": "02:25:52.000",
      "text": "راگ سیادی"
    },
    {
      "id": 12,
      "start": 8752.0,
      "end": 8754.0,
      "formatted_start": "02:25:52.000",
      "formatted_end": "02:25:54.000",
      "text": "اینجا چی؟"
    },
    {
      "id": 13,
      "start": 8754.0,
      "end": 8756.0,
      "formatted_start": "02:25:54.000",
      "formatted_end": "02:25:56.000",
      "text": "اینجا هم نه؟"
    },
    {
      "id": 14,
      "start": 8756.0,
      "end": 8758.0,
      "formatted_start": "02:25:56.000",
      "formatted_end": "02:25:58.000",
      "text": "نه نه، اینجا هم شروع میشه"
    },
    {
      "id": 15,
      "start": 8758.0,
      "end": 8760.0,
      "formatted_start": "02:25:58.000",
      "formatted_end": "02:26:00.000",
      "text": "باید سیادی، پشارتون بکنم ها چکنم؟"
    },
    {
      "id": 16,
      "start": 8760.0,
      "end": 8762.0,
      "formatted_start": "02:26:00.000",
      "formatted_end": "02:26:02.000",
      "text": "بگیر"
    },
    {
      "id": 17,
      "start": 8762.0,
      "end": 8764.0,
      "formatted_start": "02:26:02.000",
      "formatted_end": "02:26:04.000",
      "text": "کار هم میرفتی قدیم؟"
    },
    {
      "id": 18,
      "start": 8764.0,
      "end": 8766.0,
      "formatted_start": "02:26:04.000",
      "formatted_end": "02:26:06.000",
      "text": "قدیم دوی هست"
    },
    {
      "id": 19,
      "start": 8766.0,
      "end": 8768.0,
      "formatted_start": "02:26:06.000",
      "formatted_end": "02:26:08.000",
      "text": "قدیم پمبه بود، قدیم پمبه میرفتی نه؟"
    },
    {
      "id": 20,
      "start": 8768.0,
      "end": 8770.0,
      "formatted_start": "02:26:08.000",
