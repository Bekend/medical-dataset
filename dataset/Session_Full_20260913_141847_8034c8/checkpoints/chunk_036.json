  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10808.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:08.000",
      "text": "اگر خانم مادم گوشی رو برداره با من همه آیند بیاد، خوب میشه. من از این دوباره زنگ میزنم بهش؟ آره، بردارو گوشی."
    },
    {
      "id": 1,
      "start": 10808.0,
      "end": 10822.0,
      "formatted_start": "03:00:08.000",
      "formatted_end": "03:00:22.000",
      "text": "جانم. بله، بله، چشم. بله، از من، از من. بله."
    },
    {
      "id": 2,
      "start": 10822.0,
      "end": 10822.5,
      "formatted_start": "03:00:22.000",
      "formatted_end": "03:00:22.500",
      "text": "بله"
    },
    {
      "id": 3,
      "start": 10825.38,
      "end": 10827.28,
      "formatted_start": "03:00:25.380",
      "formatted_end": "03:00:27.280",
      "text": "نه به موبایل هم زنگ نزن"
    },
    {
      "id": 4,
      "start": 10827.28,
      "end": 10830.1,
      "formatted_start": "03:00:27.280",
      "formatted_end": "03:00:30.100",
      "text": "من میخوام با یه گوشی دیگه باشیم به موبایل کار کنم"
    },
    {
      "id": 5,
      "start": 10830.1,
      "end": 10831.18,
      "formatted_start": "03:00:30.100",
      "formatted_end": "03:00:31.180",
      "text": "خودم زنگ نزنم"
    },
    {
      "id": 6,
      "start": 10831.18,
      "end": 10832.78,
      "formatted_start": "03:00:31.180",
      "formatted_end": "03:00:32.780",
      "text": "چند دقیقه زنگ نزن چشم"
    },
    {
      "id": 7,
      "start": 10832.78,
      "end": 10833.78,
      "formatted_start": "03:00:32.780",
      "formatted_end": "03:00:33.780",
      "text": "برون شوید"
    },
    {
      "id": 8,
      "start": 10852.0,
      "end": 10872.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:01:12.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 10872.0,
      "end": 10901.98,
      "formatted_start": "03:01:12.000",
      "formatted_end": "03:01:41.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 10,
      "start": 10902.0,
      "end": 10907.0,
      "formatted_start": "03:01:42.000",
      "formatted_end": "03:01:47.000",
      "text": "بله بله پونزده هم که میزنم دویست و هشتاده یک و هفتصد میشه"
    },
    {
      "id": 11,
      "start": 10907.0,
      "end": 10911.0,
      "formatted_start": "03:01:47.000",
      "formatted_end": "03:01:51.000",
      "text": "شونزده هم دویست نوید چهار میشه"
    },
    {
      "id": 12,
      "start": 10911.0,
      "end": 10918.0,
      "formatted_start": "03:01:51.000",
      "formatted_end": "03:01:58.000",
      "text": "دویست و هشتاده یک و هفتصد داشته چشم"
    },
    {
      "id": 13,
      "start": 10918.0,
      "end": 10923.0,
      "formatted_start": "03:01:58.000",
      "formatted_end": "03:02:03.000",
      "text": "پونزده هم شد باشه اما چیز شد بهش تماس میگیرم"
    },
    {
      "id": 14,
      "start": 10923.0,
      "end": 10926.0,
      "formatted_start": "03:02:03.000",
      "formatted_end": "03:02:06.000",
      "text": "یک گره پاشه یا باید برویم خدا باشم"
    },
    {
      "id": 15,
      "start": 10932.0,
      "end": 10961.98,
      "formatted_start": "03:02:12.000",
      "formatted_end": "03:02:41.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 16,
      "start": 10962.0,
      "end": 10991.98,
      "formatted_start": "03:02:42.000",
