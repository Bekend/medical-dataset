  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3904.46,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:04.460",
      "text": "براداره دیگه، این بیچاره بیرسی، اصلا نه باقص نمیشه."
    },
    {
      "id": 1,
      "start": 3904.46,
      "end": 3908.46,
      "formatted_start": "01:05:04.460",
      "formatted_end": "01:05:08.460",
      "text": "اشانه امروز دردردتی نبود میشه، پا برد."
    },
    {
      "id": 2,
      "start": 3908.46,
      "end": 3911.46,
      "formatted_start": "01:05:08.460",
      "formatted_end": "01:05:11.460",
      "text": "ببخشید، پهرون درد، اینجا درده."
    },
    {
      "id": 3,
      "start": 3911.46,
      "end": 3913.46,
      "formatted_start": "01:05:11.460",
      "formatted_end": "01:05:13.460",
      "text": "هرچی بگیری، این چیزی دیگه، درد دیگه."
    },
    {
      "id": 4,
      "start": 3913.46,
      "end": 3915.46,
      "formatted_start": "01:05:13.460",
      "formatted_end": "01:05:15.460",
      "text": "نه، اینجا خوبه، درد اینجا درد دیگه."
    },
    {
      "id": 5,
      "start": 3915.46,
      "end": 3918.46,
      "formatted_start": "01:05:15.460",
      "formatted_end": "01:05:18.460",
      "text": "اون چیزی دیگه از موانع اصحال، اون چداست."
    },
    {
      "id": 6,
      "start": 3918.46,
      "end": 3920.46,
      "formatted_start": "01:05:18.460",
      "formatted_end": "01:05:20.460",
      "text": "اینجا درده، افرادی."
    },
    {
      "id": 7,
      "start": 3920.46,
      "end": 3922.46,
      "formatted_start": "01:05:20.460",
      "formatted_end": "01:05:22.460",
      "text": "اینجا درده، افرادی."
    },
    {
      "id": 8,
      "start": 3922.46,
      "end": 3927.46,
      "formatted_start": "01:05:22.460",
      "formatted_end": "01:05:27.460",
      "text": "چون دهنر نداره میگم دهنر نیست که دهنر یه چیز دیگه"
    },
    {
      "id": 9,
      "start": 3927.46,
      "end": 3931.46,
      "formatted_start": "01:05:27.460",
      "formatted_end": "01:05:31.460",
      "text": "مایی کبد باید سونوگرافی کبد هم برده بیسیم"
    },
    {
      "id": 10,
      "start": 3931.46,
      "end": 3933.46,
      "formatted_start": "01:05:31.460",
      "formatted_end": "01:05:33.460",
      "text": "به نسی که دست داره برم"
    },
    {
      "id": 11,
      "start": 3933.46,
      "end": 3935.46,
      "formatted_start": "01:05:33.460",
      "formatted_end": "01:05:35.460",
      "text": "میمه تکمیلی ده دیگه رایگانه"
    },
    {
      "id": 12,
      "start": 3935.46,
      "end": 3940.46,
      "formatted_start": "01:05:35.460",
      "formatted_end": "01:05:40.460",
      "text": "اینجا سونوگرافی خیابان شاهرو دهشه با میمه تکمیلی قرار داد داره رایگانه"
    },
    {
      "id": 13,
      "start": 3940.46,
      "end": 3943.46,
      "formatted_start": "01:05:40.460",
      "formatted_end": "01:05:43.460",
      "text": "میمه تکمیلی چیه؟ ایرانه؟"
    },
    {
      "id": 14,
      "start": 3943.46,
      "end": 3944.46,
      "formatted_start": "01:05:43.460",
      "formatted_end": "01:05:44.460",
      "text": "البورز"
    },
    {
      "id": 15,
      "start": 3944.46,
      "end": 3946.46,
      "formatted_start": "01:05:44.460",
      "formatted_end": "01:05:46.460",
      "text": "البورز دهشه البورز چون اینجا رایگانه هست"
    },
    {
      "id": 16,
      "start": 3946.46,
      "end": 3948.46,
      "formatted_start": "01:05:46.460",
      "formatted_end": "01:05:48.460",
      "text": "میشه بیمه ی عرض برز رایگان میشه"
    },
    {
      "id": 17,
      "start": 3948.46,
      "end": 3950.46,
      "formatted_start": "01:05:48.460",
      "formatted_end": "01:05:50.460",
      "text": "برین همجور رایگان انجام دید"
    },
    {
      "id": 18,
      "start": 3950.46,
      "end": 3952.46,
      "formatted_start": "01:05:50.460",
      "formatted_end": "01:05:52.460",
      "text": "بعد از برا ساعت سه به برد میاد"
    },
    {
      "id": 19,
      "start": 3952.46,
      "end": 3954.46,
      "formatted_start": "01:05:52.460",
      "formatted_end": "01:05:54.460",
      "text": "پاساش مولوهاییت فی آبان شاهرونه"
    },
    {
      "id": 20,
      "start": 3954.46,
      "end": 3956.46,
      "formatted_start": "01:05:54.460",
      "formatted_end": "01:05:56.460",
      "text": "بره همجوری بیدیم"
    },
    {
      "id": 21,
      "start": 3956.46,
      "end": 3959.46,
      "formatted_start": "01:05:56.460",
      "formatted_end": "01:05:59.460",
      "text": "بره این جا به جایی انجام بدین یا ندید؟"
    },
    {
      "id": 22,
      "start": 3959.46,
      "end": 3962.46,
      "formatted_start": "01:05:59.460",
      "formatted_end": "01:06:02.460",
      "text": "اون بابا رو شما برم اجازه بگیرم"
    },
    {
      "id": 23,
      "start": 3962.46,
      "end": 3964.46,
      "formatted_start": "01:06:02.460",
      "formatted_end": "01:06:04.460",
      "text": "نه بری اجازه بیدید"
    },
    {
      "id": 24,
      "start": 3964.46,
      "end": 3966.46,
      "formatted_start": "01:06:04.460",
      "formatted_end": "01:06:06.460",
      "text": "زنگ بزن اجازه بگیرم اون دارم میمیرم"
    },
    {
      "id": 25,
      "start": 3966.46,
      "end": 3968.46,
      "formatted_start": "01:06:06.460",
      "formatted_end": "01:06:08.460",
      "text": "اجازه میتی بگیرم اجازه بیدیم"
    },
    {
      "id": 26,
      "start": 3968.46,
      "end": 3970.46,
      "formatted_start": "01:06:08.460",
      "formatted_end": "01:06:10.460",
      "text": "همینجور رو تنجاب کنید"
    },
    {
      "id": 27,
      "start": 3970.46,
      "end": 3972.46,
      "formatted_start": "01:06:10.460",
      "formatted_end": "01:06:12.460",
      "text": "اگر اجازه نمیده خب میرید"
    },
    {
      "id": 28,
      "start": 3972.46,
      "end": 3973.46,
      "formatted_start": "01:06:12.460",
      "formatted_end": "01:06:13.460",
      "text": "بسیار ملت"
    },
    {
      "id": 29,
      "start": 3973.46,
      "end": 3976.46,
      "formatted_start": "01:06:13.460",
      "formatted_end": "01:06:16.460",
      "text": "اگر دروارو مصرف کنم بهتر نمیشم"
    },
    {
      "id": 30,
      "start": 3976.46,
      "end": 3978.46,
      "formatted_start": "01:06:16.460",
      "formatted_end": "01:06:18.460",
      "text": "چرا؟ بهتر میشی؟ یهوش باش بهتر میشی"
    },
    {
      "id": 31,
      "start": 3978.46,
      "end": 3980.46,
      "formatted_start": "01:06:18.460",
      "formatted_end": "01:06:20.460",
      "text": "تو پس دروارو مصرف کنم"
    },
    {
      "id": 32,
      "start": 3980.46,
      "end": 3982.46,
      "formatted_start": "01:06:20.460",
      "formatted_end": "01:06:22.460",
      "text": "چرا بهتر؟ بله اگر بهتر مصرف کنم"
    },
    {
      "id": 33,
      "start": 3982.46,
      "end": 3984.46,
      "formatted_start": "01:06:22.460",
      "formatted_end": "01:06:24.460",
      "text": "اجره داشتی؟ میفرد"
    },
    {
      "id": 34,
      "start": 3984.46,
      "end": 3986.46,
      "formatted_start": "01:06:24.460",
      "formatted_end": "01:06:26.460",
      "text": "باز میام پیش شما"
    },
    {
      "id": 35,
      "start": 3986.46,
      "end": 3988.46,
      "formatted_start": "01:06:26.460",
      "formatted_end": "01:06:28.460",
      "text": "جان مال توی خوهر جان"
    },
    {
      "id": 36,
      "start": 3988.46,
      "end": 3990.46,
      "formatted_start": "01:06:28.460",
      "formatted_end": "01:06:30.460",
      "text": "هر جور تو میخواه خواه خوهر مالت"
    },
    {
      "id": 37,
      "start": 3990.46,
      "end": 3992.46,
      "formatted_start": "01:06:30.460",
      "formatted_end": "01:06:32.460",
      "text": "سلامت باشی"
    },
    {
      "id": 38,
      "start": 3992.46,
      "end": 3994.46,
      "formatted_start": "01:06:32.460",
      "formatted_end": "01:06:34.460",
      "text": "یه وقت یکی رارندگی می کنه"
    },
    {
      "id": 39,
      "start": 3994.46,
      "end": 4002.46,
      "formatted_start": "01:06:34.460",
      "formatted_end": "01:06:42.460",
      "text": "ماشینالاتی می کنه ممکنه بیفته یا آتیش سر کارشه، آشپز، مسجدجایی کار کنه ممکنه بیفته سرش داره"
    },
    {
      "id": 40,
      "start": 4002.46,
      "end": 4010.46,
      "formatted_start": "01:06:42.460",
      "formatted_end": "01:06:50.460",
      "text": "شما خوردن و دستشوی نفتن، فقط تو دستشوی نیفتی، در باز نمیشه، این روستایی دستشوی درشون روبه تو باز میشه"
    },
    {
      "id": 41,
      "start": 4010.46,
      "end": 4016.46,
      "formatted_start": "01:06:50.460",
      "formatted_end": "01:06:56.460",
      "text": "بعد میفتن و میمانن آنجا، چاق هم هستن، بعد دره می کرده باید"
    },
    {
      "id": 42,
      "start": 4016.46,
      "end": 4022.46,
      "formatted_start": "01:06:56.460",
      "formatted_end": "01:07:02.460",
      "text": "چند تا از ورزهای من همینجا بودند. گفتند بریم خوب میشیم افتادن تو دستشویش. شوهرش میگه در کندم رفتند."
    },
    {
      "id": 43,
      "start": 4022.46,
      "end": 4024.46,
      "formatted_start": "01:07:02.460",
      "formatted_end": "01:07:04.460",
      "text": "کندم ها بردم به چیزی رو."
    },
    {
      "id": 44,
      "start": 4024.46,
      "end": 4026.46,
      "formatted_start": "01:07:04.460",
      "formatted_end": "01:07:06.460",
      "text": "خنر کردن. بله."
    },
    {
      "id": 45,
      "start": 4026.46,
      "end": 4028.46,
      "formatted_start": "01:07:06.460",
      "formatted_end": "01:07:08.460",
      "text": "در کندم تا که نرشتیم."
    },
    {
      "id": 46,
      "start": 4028.46,
      "end": 4030.46,
      "formatted_start": "01:07:08.460",
      "formatted_end": "01:07:10.460",
      "text": "در کندم تا که نرشتیم. پرابر مزارم بزنیم دیگه."
    },
    {
      "id": 47,
      "start": 4030.46,
      "end": 4034.16,
      "formatted_start": "01:07:10.460",
      "formatted_end": "01:07:14.160",
      "text": "دیگه دوست داشتی بیدید جایی"
    },
    {
      "id": 48,
      "start": 4034.16,
      "end": 4035.6,
      "formatted_start": "01:07:14.160",
      "formatted_end": "01:07:15.600",
      "text": "این من از من کتاییست"
    },
    {
      "id": 49,
      "start": 4035.6,
      "end": 4038.0,
      "formatted_start": "01:07:15.600",
      "formatted_end": "01:07:18.000",
      "text": "برش سونوگرافی کاملا بزن که"
    },
    {
      "id": 50,
      "start": 4038.0,
      "end": 4040.36,
      "formatted_start": "01:07:18.000",
      "formatted_end": "01:07:20.360",
      "text": "پاشکان ما برد درست کنیم"
    },
    {
      "id": 51,
      "start": 4040.36,
      "end": 4041.44,
      "formatted_start": "01:07:20.360",
      "formatted_end": "01:07:21.440",
      "text": "یا"
    },
    {
      "id": 52,
      "start": 4041.44,
      "end": 4046.98,
      "formatted_start": "01:07:21.440",
      "formatted_end": "01:07:26.980",
      "text": "کار تو چیه؟"
    },
    {
      "id": 53,
      "start": 4046.98,
      "end": 4048.18,
      "formatted_start": "01:07:26.980",
      "formatted_end": "01:07:28.180",
      "text": "کار آقا تو چیه؟"
    },
    {
      "id": 54,
      "start": 4048.18,
      "end": 4049.46,
      "formatted_start": "01:07:28.180",
      "formatted_end": "01:07:29.460",
      "text": "توی شرکت ادارگاه"
    },
    {
      "id": 55,
      "start": 4049.46,
      "end": 4051.32,
      "formatted_start": "01:07:29.460",
      "formatted_end": "01:07:31.320",
      "text": "ادارگاه"
    },
    {
      "id": 56,
      "start": 4051.32,
      "end": 4053.14,
      "formatted_start": "01:07:31.320",
      "formatted_end": "01:07:33.140",
      "text": "دیروز ادارگاه"
    },
    {
      "id": 57,
      "start": 4053.14,
      "end": 4056.0,
      "formatted_start": "01:07:33.140",
      "formatted_end": "01:07:36.000",
      "text": "جواب آسمان شفتانو شاوردوید"
    },
    {
      "id": 58,
      "start": 4056.0,
      "end": 4057.8,
      "formatted_start": "01:07:36.000",
      "formatted_end": "01:07:37.800",
      "text": "رفته بود نوروزی"
    },
    {
      "id": 59,
      "start": 4057.8,
      "end": 4059.68,
      "formatted_start": "01:07:37.800",
      "formatted_end": "01:07:39.680",
      "text": "چون من نگفتیم"
    },
    {
      "id": 60,
      "start": 4059.68,
      "end": 4066.68,
      "formatted_start": "01:07:39.680",
      "formatted_end": "01:07:46.680",
      "text": "و بعد از تو از رنگ زده، باباش سرنگ زده، دیگه شامل گفتم نه بگو درسته، یه تکمیلی هم داره، اما چرا؟"
    },
    {
      "id": 61,
      "start": 4066.68,
      "end": 4067.68,
      "formatted_start": "01:07:46.680",
      "formatted_end": "01:07:47.680",
      "text": "نه، اما باید برام برام برام برام..."
    },
    {
      "id": 62,
      "start": 4067.68,
      "end": 4068.68,
      "formatted_start": "01:07:47.680",
      "formatted_end": "01:07:48.680",
      "text": "اجابه من نگفتی؟"
    },
    {
      "id": 63,
      "start": 4068.68,
      "end": 4073.68,
      "formatted_start": "01:07:48.680",
      "formatted_end": "01:07:53.680",
      "text": "خب نه، آقا قرار بود بیا دیو، گفت برام تلفن صحبت کنم، میام، دیگه رفت که دیگه"
    },
    {
      "id": 64,
      "start": 4073.68,
      "end": 4078.68,
      "formatted_start": "01:07:53.680",
      "formatted_end": "01:07:58.680",
      "text": "و همه گره رنگ زده، نه گفتیم نه، با قانونی هم برام دیگه بگو چرا؟"
    },
    {
      "id": 65,
      "start": 4078.68,
      "end": 4082.68,
      "formatted_start": "01:07:58.680",
      "formatted_end": "01:08:02.680",
      "text": "چیزم داره از خاصی تکمیلین داره"
    },
    {
      "id": 66,
      "start": 4082.68,
      "end": 4086.68,
      "formatted_start": "01:08:02.680",
      "formatted_end": "01:08:06.680",
      "text": "میگه دارون نداشتی؟ دارون داشتی دیگه روز قبلش داری داشتی"
    },
    {
      "id": 67,
      "start": 4086.68,
      "end": 4090.68,
      "formatted_start": "01:08:06.680",
      "formatted_end": "01:08:10.680",
      "text": "آره، خودم هم دارونه بشین، آرمایه شده"
    },
    {
      "id": 68,
      "start": 4090.68,
      "end": 4092.68,
      "formatted_start": "01:08:10.680",
      "formatted_end": "01:08:12.680",
      "text": "باید اون روز بیرونم"
    },
    {
      "id": 69,
      "start": 4092.68,
      "end": 4094.68,
      "formatted_start": "01:08:12.680",
      "formatted_end": "01:08:14.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 70,
      "start": 4094.68,
      "end": 4096.68,
      "formatted_start": "01:08:14.680",
      "formatted_end": "01:08:16.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 71,
      "start": 4096.68,
      "end": 4098.68,
      "formatted_start": "01:08:16.680",
      "formatted_end": "01:08:18.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 72,
      "start": 4098.68,
      "end": 4100.68,
      "formatted_start": "01:08:18.680",
      "formatted_end": "01:08:20.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 73,
      "start": 4100.68,
      "end": 4102.68,
      "formatted_start": "01:08:20.680",
      "formatted_end": "01:08:22.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 74,
      "start": 4102.68,
      "end": 4104.68,
      "formatted_start": "01:08:22.680",
      "formatted_end": "01:08:24.680",
      "text": "خانقالمی جان، فیصد شما هست؟"
    },
    {
      "id": 75,
      "start": 4104.68,
      "end": 4106.68,
      "formatted_start": "01:08:24.680",
      "formatted_end": "01:08:26.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 76,
      "start": 4106.68,
      "end": 4108.68,
      "formatted_start": "01:08:26.680",
      "formatted_end": "01:08:28.680",
      "text": "کودش رو ببینید"
    },
    {
      "id": 77,
      "start": 4108.68,
      "end": 4110.68,
      "formatted_start": "01:08:28.680",
      "formatted_end": "01:08:30.680",
      "text": "کود رو برگرد ها ببینید"
    },
    {
      "id": 78,
      "start": 4110.68,
      "end": 4112.68,
      "formatted_start": "01:08:30.680",
      "formatted_end": "01:08:32.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 79,
      "start": 4112.68,
      "end": 4114.68,
      "formatted_start": "01:08:32.680",
      "formatted_end": "01:08:34.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 80,
      "start": 4114.68,
      "end": 4116.68,
      "formatted_start": "01:08:34.680",
      "formatted_end": "01:08:36.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 81,
      "start": 4116.68,
      "end": 4118.68,
      "formatted_start": "01:08:36.680",
      "formatted_end": "01:08:38.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 82,
      "start": 4118.68,
      "end": 4120.68,
      "formatted_start": "01:08:38.680",
      "formatted_end": "01:08:40.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 83,
      "start": 4120.68,
      "end": 4122.68,
      "formatted_start": "01:08:40.680",
      "formatted_end": "01:08:42.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 84,
      "start": 4122.68,
      "end": 4124.68,
      "formatted_start": "01:08:42.680",
      "formatted_end": "01:08:44.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 85,
      "start": 4124.68,
      "end": 4126.68,
      "formatted_start": "01:08:44.680",
      "formatted_end": "01:08:46.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 86,
      "start": 4126.68,
      "end": 4128.68,
      "formatted_start": "01:08:46.680",
      "formatted_end": "01:08:48.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 87,
      "start": 4128.68,
      "end": 4130.68,
      "formatted_start": "01:08:48.680",
      "formatted_end": "01:08:50.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 88,
      "start": 4130.68,
      "end": 4132.68,
      "formatted_start": "01:08:50.680",
      "formatted_end": "01:08:52.680",
      "text": "برگرد ها ببینید"
    },
    {
      "id": 89,
      "start": 4132.68,
      "end": 4134.68,
      "formatted_start": "01:08:52.680",
      "formatted_end": "01:08:54.680",
      "text": "مردم در اینجا باید بردارید."
    },
    {
      "id": 90,
      "start": 4134.68,
      "end": 4136.68,
      "formatted_start": "01:08:54.680",
      "formatted_end": "01:08:56.680",
      "text": "اینجا باید بردارید."
    },
    {
      "id": 91,
      "start": 4136.68,
      "end": 4138.68,
      "formatted_start": "01:08:56.680",
      "formatted_end": "01:08:58.680",
      "text": "سلام."
    },
    {
      "id": 92,
      "start": 4138.68,
      "end": 4140.68,
      "formatted_start": "01:08:58.680",
      "formatted_end": "01:09:00.680",
      "text": "انگوشتو اجازه گرفتی؟"
    },
    {
      "id": 93,
      "start": 4140.68,
      "end": 4142.68,
      "formatted_start": "01:09:00.680",
      "formatted_end": "01:09:02.680",
      "text": "اجازه گرفتیم."
    },
    {
      "id": 94,
      "start": 4142.68,
      "end": 4144.68,
      "formatted_start": "01:09:02.680",
      "formatted_end": "01:09:04.680",
      "text": "اینجا کسی نیست."
    },
    {
      "id": 95,
      "start": 4144.68,
      "end": 4146.68,
      "formatted_start": "01:09:04.680",
      "formatted_end": "01:09:06.680",
      "text": "تو باید زنگ بزنی."
    },
    {
      "id": 96,
      "start": 4146.68,
      "end": 4148.68,
      "formatted_start": "01:09:06.680",
      "formatted_end": "01:09:08.680",
      "text": "اینجا باید زنگ بزنی."
    },
    {
      "id": 97,
      "start": 4148.68,
      "end": 4150.68,
      "formatted_start": "01:09:08.680",
      "formatted_end": "01:09:10.680",
      "text": "اینجا باید زنگ بزنی."
    },
    {
      "id": 98,
      "start": 4150.68,
      "end": 4152.68,
      "formatted_start": "01:09:10.680",
      "formatted_end": "01:09:12.680",
      "text": "اینجا باید زنگ بزنی."
    },
    {
      "id": 99,
      "start": 4152.68,
