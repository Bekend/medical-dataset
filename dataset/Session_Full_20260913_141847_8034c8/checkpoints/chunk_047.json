  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14107.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:07.000",
      "text": "میتونید یه دیگه آب جوشیده سرچونه، عبر رو بهش میزنید و خودتونو کمپرس میکنید با شوید."
    },
    {
      "id": 1,
      "start": 14107.0,
      "end": 14114.0,
      "formatted_start": "03:55:07.000",
      "formatted_end": "03:55:14.000",
      "text": "بعد از شوستن این کار رو بجا میدید، میذارید بیمار چند لحظه نصف شوید، میشین خوش میشه، بلند میشین میدید."
    },
    {
      "id": 2,
      "start": 14114.0,
      "end": 14122.0,
      "formatted_start": "03:55:14.000",
      "formatted_end": "03:55:22.000",
      "text": "محلول رو تمامی بودید، کرم هایی هستید. اونها بعد از خوش شدن این کرم ها رو استفاده میکنید."
    },
    {
      "id": 3,
      "start": 14122.0,
      "end": 14125.0,
      "formatted_start": "03:55:22.000",
      "formatted_end": "03:55:25.000",
      "text": "داخل باجان هم خواهش دارید؟ نه، اصلا."
    },
    {
      "id": 4,
      "start": 14125.0,
      "end": 14132.0,
      "formatted_start": "03:55:25.000",
      "formatted_end": "03:55:32.000",
      "text": "این محلول کاملین است که زرده گذاشته باشه و برای همین حرف بستش"
    },
    {
      "id": 5,
      "start": 14132.0,
      "end": 14135.0,
      "formatted_start": "03:55:32.000",
      "formatted_end": "03:55:35.000",
      "text": "و کرم های مخصوص کاری است"
    },
    {
      "id": 6,
      "start": 14135.0,
      "end": 14143.0,
      "formatted_start": "03:55:35.000",
      "formatted_end": "03:55:43.000",
      "text": "بولا، سیزه، کرمه، کتر، کتر، کرمه، روزه، لیفت"
    },
    {
      "id": 7,
      "start": 14143.0,
      "end": 14148.0,
      "formatted_start": "03:55:43.000",
      "formatted_end": "03:55:48.000",
      "text": "سه تا کرم هستش، همچنان با هم کف دست مخلوب می کنید و اینجاها بینالید"
    },
    {
      "id": 8,
      "start": 14148.0,
      "end": 14151.0,
      "formatted_start": "03:55:48.000",
      "formatted_end": "03:55:51.000",
      "text": "خیلی راحت شد، بسیار محلول زده اید"
    },
    {
      "id": 9,
      "start": 14151.0,
      "end": 14156.5,
      "formatted_start": "03:55:51.000",
      "formatted_end": "03:55:56.500",
      "text": "و شویان دیگه شما سابون گل ختمین"
    },
    {
      "id": 10,
      "start": 14156.5,
      "end": 14162.5,
      "formatted_start": "03:55:56.500",
      "formatted_end": "03:56:02.500",
      "text": "گل ختمین، گیاهی هست گل ختمین، برای این کار درخواهان آدار میشه"
    },
    {
      "id": 11,
      "start": 14162.5,
      "end": 14164.5,
      "formatted_start": "03:56:02.500",
      "formatted_end": "03:56:04.500",
      "text": "بله، برای درخواهان آدار میشه"
    },
    {
      "id": 12,
      "start": 14164.5,
      "end": 14167.5,
      "formatted_start": "03:56:04.500",
      "formatted_end": "03:56:07.500",
      "text": "درخواهان هم نواشه گل ختمین درد نیوشه"
    },
    {
      "id": 13,
      "start": 14167.5,
      "end": 14172.5,
      "formatted_start": "03:56:07.500",
      "formatted_end": "03:56:12.500",
      "text": "آره، نه، گل ختمین، سابونش هم اجای هزبتالی ها هم برزم میاد"
    },
    {
      "id": 14,
      "start": 14172.5,
      "end": 14175.0,
      "formatted_start": "03:56:12.500",
      "formatted_end": "03:56:15.000",
      "text": "برزم میاد، آره، شیسته بیستش"
    },
    {
      "id": 15,
      "start": 14175.0,
      "end": 14176.0,
      "formatted_start": "03:56:15.000",
      "formatted_end": "03:56:16.000",
      "text": "خب، بگو"
    },
    {
      "id": 16,
      "start": 14176.0,
      "end": 14178.0,
      "formatted_start": "03:56:16.000",
      "formatted_end": "03:56:18.000",
      "text": "این ها دیگه، این ها رو هم بروسنم"
    },
    {
      "id": 17,
      "start": 14178.0,
      "end": 14179.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:19.000",
      "text": "این ها که دابرین زادو است"
    },
    {
      "id": 18,
      "start": 14179.0,
      "end": 14181.66,
      "formatted_start": "03:56:19.000",
      "formatted_end": "03:56:21.660",
      "text": "درسته میگیش هر چیزی ایست."
    },
    {
      "id": 19,
      "start": 14181.66,
      "end": 14182.46,
      "formatted_start": "03:56:21.660",
      "formatted_end": "03:56:22.460",
      "text": "خیلی خوب."
    },
    {
      "id": 20,
      "start": 14182.46,
      "end": 14183.66,
      "formatted_start": "03:56:22.460",
      "formatted_end": "03:56:23.660",
      "text": "یه و نیست قبل تکنی."
    },
    {
      "id": 21,
      "start": 14183.66,
      "end": 14184.46,
      "formatted_start": "03:56:23.660",
      "formatted_end": "03:56:24.460",
      "text": "خیلی چند."
    },
    {
      "id": 22,
      "start": 14184.46,
      "end": 14189.24,
      "formatted_start": "03:56:24.460",
      "formatted_end": "03:56:29.240",
      "text": "ولی این پرس آهنگ من از اینکن هم سبتی کموم شده نخوادم."
    },
    {
      "id": 23,
      "start": 14189.24,
      "end": 14190.0,
      "formatted_start": "03:56:29.240",
      "formatted_end": "03:56:30.000",
      "text": "ایشه اردوید."
    },
    {
      "id": 24,
      "start": 14190.0,
      "end": 14192.66,
      "formatted_start": "03:56:30.000",
      "formatted_end": "03:56:32.660",
      "text": "پرس آهنگ چون یه روزی که استفاده میکنم"
    },
    {
      "id": 25,
      "start": 14192.66,
      "end": 14193.26,
      "formatted_start": "03:56:32.660",
      "formatted_end": "03:56:33.260",
      "text": "شیشه شیشه."
    },
    {
      "id": 26,
      "start": 14193.26,
      "end": 14194.66,
      "formatted_start": "03:56:33.260",
      "formatted_end": "03:56:34.660",
      "text": "من دیگه سی کام چه تموم."
    },
    {
      "id": 27,
      "start": 14194.66,
      "end": 14195.66,
      "formatted_start": "03:56:34.660",
      "formatted_end": "03:56:35.660",
      "text": "شیشه شیشه."
    },
    {
      "id": 28,
      "start": 14195.66,
      "end": 14196.66,
      "formatted_start": "03:56:35.660",
      "formatted_end": "03:56:36.660",
      "text": "خیلی خوب."
    },
    {
      "id": 29,
      "start": 14196.66,
      "end": 14197.66,
      "formatted_start": "03:56:36.660",
      "formatted_end": "03:56:37.660",
      "text": "اینش."
    },
    {
      "id": 30,
      "start": 14197.66,
      "end": 14199.66,
      "formatted_start": "03:56:37.660",
      "formatted_end": "03:56:39.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 31,
      "start": 14199.66,
      "end": 14201.66,
      "formatted_start": "03:56:39.660",
      "formatted_end": "03:56:41.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 32,
      "start": 14201.66,
      "end": 14203.66,
      "formatted_start": "03:56:41.660",
      "formatted_end": "03:56:43.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 33,
      "start": 14203.66,
      "end": 14205.66,
      "formatted_start": "03:56:43.660",
      "formatted_end": "03:56:45.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 34,
      "start": 14205.66,
      "end": 14207.66,
      "formatted_start": "03:56:45.660",
      "formatted_end": "03:56:47.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 35,
      "start": 14207.66,
      "end": 14209.66,
      "formatted_start": "03:56:47.660",
      "formatted_end": "03:56:49.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 36,
      "start": 14209.66,
      "end": 14211.66,
      "formatted_start": "03:56:49.660",
      "formatted_end": "03:56:51.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 37,
      "start": 14211.66,
      "end": 14213.66,
      "formatted_start": "03:56:51.660",
      "formatted_end": "03:56:53.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 38,
      "start": 14213.66,
      "end": 14215.66,
      "formatted_start": "03:56:53.660",
      "formatted_end": "03:56:55.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 39,
      "start": 14215.66,
      "end": 14217.66,
      "formatted_start": "03:56:55.660",
      "formatted_end": "03:56:57.660",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 40,
      "start": 14217.66,
      "end": 14219.66,
      "formatted_start": "03:56:57.660",
      "formatted_end": "03:56:59.660",
      "text": "با درگاه ما شروع شد"
    },
    {
      "id": 41,
      "start": 14219.66,
      "end": 14222.66,
      "formatted_start": "03:56:59.660",
      "formatted_end": "03:57:02.660",
      "text": "باز ۸۰۰۰ رو خواستم این رنگی خورده"
    },
    {
      "id": 42,
      "start": 14222.66,
      "end": 14225.66,
      "formatted_start": "03:57:02.660",
      "formatted_end": "03:57:05.660",
      "text": "از راه"
    },
    {
      "id": 43,
      "start": 14225.66,
      "end": 14227.66,
      "formatted_start": "03:57:05.660",
      "formatted_end": "03:57:07.660",
      "text": "از راه"
    },
    {
      "id": 44,
      "start": 14227.66,
      "end": 14229.66,
      "formatted_start": "03:57:07.660",
      "formatted_end": "03:57:09.660",
      "text": "راه"
    },
    {
      "id": 45,
      "start": 14229.66,
      "end": 14231.66,
      "formatted_start": "03:57:09.660",
      "formatted_end": "03:57:11.660",
      "text": "۸۰۰۰ رو خواستم این رنگی"
    },
    {
      "id": 46,
      "start": 14231.66,
      "end": 14233.66,
      "formatted_start": "03:57:11.660",
      "formatted_end": "03:57:13.660",
      "text": "با درگاه میشون که خیلی بدتر بزنه"
    },
    {
      "id": 47,
      "start": 14233.66,
      "end": 14235.66,
      "formatted_start": "03:57:13.660",
      "formatted_end": "03:57:15.660",
      "text": "چند ها گراتین بودش نه؟"
    },
    {
      "id": 48,
      "start": 14235.66,
      "end": 14237.66,
      "formatted_start": "03:57:15.660",
      "formatted_end": "03:57:17.660",
      "text": "آه، گراتین رو خوب گفتو کنیم"
    },
    {
      "id": 49,
      "start": 14237.66,
      "end": 14239.66,
      "formatted_start": "03:57:17.660",
      "formatted_end": "03:57:19.660",
      "text": "سه شنبه گذشتیم یه روز"
    },
    {
      "id": 50,
      "start": 14239.66,
      "end": 14242.66,
      "formatted_start": "03:57:19.660",
      "formatted_end": "03:57:22.660",
      "text": "خب، این جرمه اش گیری؟"
    },
    {
      "id": 51,
      "start": 14242.66,
      "end": 14245.66,
      "formatted_start": "03:57:22.660",
      "formatted_end": "03:57:25.660",
      "text": "آه، گراتین یونس پاستی"
    },
    {
      "id": 52,
      "start": 14245.66,
      "end": 14247.66,
      "formatted_start": "03:57:25.660",
      "formatted_end": "03:57:27.660",
      "text": "این جدید است"
    },
    {
      "id": 53,
      "start": 14247.66,
      "end": 14253.66,
      "formatted_start": "03:57:27.660",
      "formatted_end": "03:57:33.660",
      "text": "باید ترکه هم هم باشه بکنم"
    },
    {
      "id": 54,
      "start": 14253.66,
      "end": 14255.66,
      "formatted_start": "03:57:33.660",
      "formatted_end": "03:57:35.660",
      "text": "این رو بکسونه"
    },
    {
      "id": 55,
      "start": 14255.66,
      "end": 14257.66,
      "formatted_start": "03:57:35.660",
      "formatted_end": "03:57:37.660",
      "text": "این چیز رو بکسونه"
    },
    {
      "id": 56,
      "start": 14257.66,
      "end": 14259.66,
      "formatted_start": "03:57:37.660",
      "formatted_end": "03:57:39.660",
      "text": "ملکسیکا"
    },
    {
      "id": 57,
      "start": 14259.66,
      "end": 14263.66,
      "formatted_start": "03:57:39.660",
      "formatted_end": "03:57:43.660",
      "text": "در هفته سه نشین جاییستیم به تهران"
    },
    {
      "id": 58,
      "start": 14263.66,
      "end": 14265.66,
      "formatted_start": "03:57:43.660",
      "formatted_end": "03:57:45.660",
      "text": "امروز همه اینجا رو برام نمیشه"
    },
    {
      "id": 59,
      "start": 14265.66,
      "end": 14269.66,
      "formatted_start": "03:57:45.660",
      "formatted_end": "03:57:49.660",
      "text": "برای خوبه تر اساس می کنی"
    },
    {
      "id": 60,
      "start": 14269.66,
      "end": 14271.66,
      "formatted_start": "03:57:49.660",
      "formatted_end": "03:57:51.660",
      "text": "دکتور تهران چی؟ بابا پوره"
    },
    {
      "id": 61,
      "start": 14271.66,
      "end": 14278.54,
      "formatted_start": "03:57:51.660",
      "formatted_end": "03:57:58.540",
      "text": "بابا پول تیران برای اون مستقبل برای اون راه مبارک میشونده در راه بکنه بابا پول"
    },
    {
      "id": 62,
      "start": 14278.54,
      "end": 14279.54,
      "formatted_start": "03:57:58.540",
      "formatted_end": "03:57:59.540",
      "text": "بابا پول"
    },
    {
      "id": 63,
      "start": 14279.54,
      "end": 14282.26,
      "formatted_start": "03:57:59.540",
      "formatted_end": "03:58:02.260",
      "text": "این باکسیکولو ممکنه که ندن"
    },
    {
      "id": 64,
      "start": 14282.26,
      "end": 14282.86,
      "formatted_start": "03:58:02.260",
      "formatted_end": "03:58:02.860",
      "text": "آهان"
    },
    {
      "id": 65,
      "start": 14282.86,
      "end": 14285.22,
      "formatted_start": "03:58:02.860",
      "formatted_end": "03:58:05.220",
      "text": "این یک کمی از آن سردیه شد و"
    },
    {
      "id": 66,
      "start": 14285.22,
      "end": 14287.5,
      "formatted_start": "03:58:05.220",
      "formatted_end": "03:58:07.500",
      "text": "خودشنگ بابا پول خاصیست بریمیسید"
    },
    {
      "id": 67,
      "start": 14287.5,
      "end": 14290.06,
      "formatted_start": "03:58:07.500",
      "formatted_end": "03:58:10.060",
      "text": "بله بله اینها هست حالا نمیبونه"
    },
    {
      "id": 68,
      "start": 14290.06,
      "end": 14292.78,
      "formatted_start": "03:58:10.060",
      "formatted_end": "03:58:12.780",
      "text": "این زیرا نمیبونه نصف درد یک درد شده"
    },
    {
      "id": 69,
      "start": 14292.78,
      "end": 14295.14,
      "formatted_start": "03:58:12.780",
      "formatted_end": "03:58:15.140",
      "text": "25 من میریمسن 20 دردون"
    },
    {
      "id": 70,
      "start": 14295.14,
      "end": 14297.9,
      "formatted_start": "03:58:15.140",
      "formatted_end": "03:58:17.900",
      "text": "آهان اگه دادن ندن داردی"
    },
    {
      "id": 71,
      "start": 14297.9,
      "end": 14299.1,
      "formatted_start": "03:58:17.900",
      "formatted_end": "03:58:19.100",
      "text": "بنارون من برسیم"
    },
    {
      "id": 72,
      "start": 14299.1,
      "end": 14305.1,
      "formatted_start": "03:58:19.100",
      "formatted_end": "03:58:25.100",
      "text": "داروزشان اینو صدشونه بیشتر باشد"
    },
    {
      "id": 73,
      "start": 14305.1,
      "end": 14309.1,
      "formatted_start": "03:58:25.100",
      "formatted_end": "03:58:29.100",
      "text": "پرتین هم مسکنند"
    },
    {
      "id": 74,
      "start": 14309.1,
      "end": 14313.1,
      "formatted_start": "03:58:29.100",
      "formatted_end": "03:58:33.100",
      "text": "درموی که نیست"
    },
    {
      "id": 75,
      "start": 14313.1,
      "end": 14317.1,
      "formatted_start": "03:58:33.100",
      "formatted_end": "03:58:37.100",
      "text": "مخصوص مخصوص اینو هم نکیه"
    },
    {
      "id": 76,
      "start": 14317.1,
      "end": 14321.1,
      "formatted_start": "03:58:37.100",
      "formatted_end": "03:58:41.100",
      "text": "همین درموی که خسروی هم نمیدونند"
    },
    {
      "id": 77,
      "start": 14321.1,
      "end": 14325.1,
      "formatted_start": "03:58:41.100",
      "formatted_end": "03:58:45.100",
      "text": "داروزشان اینو بزرگ بودند"
    },
    {
      "id": 78,
      "start": 14325.1,
      "end": 14329.74,
      "formatted_start": "03:58:45.100",
      "formatted_end": "03:58:49.740",
      "text": "شیراز یه دارو سازی رو زده بودن که افرار بود اسمش"
    },
    {
      "id": 79,
      "start": 14329.74,
      "end": 14333.66,
      "formatted_start": "03:58:49.740",
      "formatted_end": "03:58:53.660",
      "text": "چون مال سپاه هم یک سنن، این سنن مال سپاه هست"
    },
    {
      "id": 80,
      "start": 14333.66,
      "end": 14339.66,
      "formatted_start": "03:58:53.660",
      "formatted_end": "03:58:59.660",
      "text": "شما مثلا میرونید حتی بانک هم به ظاهر مال بانک هستن"
    },
    {
      "id": 81,
      "start": 14339.66,
      "end": 14349.38,
      "formatted_start": "03:58:59.660",
      "formatted_end": "03:59:09.380",
      "text": "مثلا مال سپاه هست دیگه، الان محسسات مثل بانک آینده مثلا یه جور مال سپاه بود"
    },
    {
      "id": 82,
      "start": 14349.38,
      "end": 14350.98,
      "formatted_start": "03:59:09.380",
      "formatted_end": "03:59:10.980",
      "text": "این یکی باگردی"
    },
    {
      "id": 83,
      "start": 14350.98,
      "end": 14352.98,
      "formatted_start": "03:59:10.980",
      "formatted_end": "03:59:12.980",
      "text": "انصار نام این سپاه بوده"
    },
    {
      "id": 84,
      "start": 14352.98,
      "end": 14358.62,
      "formatted_start": "03:59:12.980",
      "formatted_end": "03:59:18.620",
      "text": "یعنی در پشت سرش هم مثلا اقتصاد مهره اقتصاد چیه؟"
    },
    {
      "id": 85,
      "start": 14358.62,
      "end": 14360.62,
      "formatted_start": "03:59:18.620",
      "formatted_end": "03:59:20.620",
      "text": "مهره سپاهیه"
    },
    {
      "id": 86,
      "start": 14360.62,
      "end": 14363.62,
      "formatted_start": "03:59:20.620",
      "formatted_end": "03:59:23.620",
      "text": "اکسون همه چیز دست سپاهیه"
    },
    {
      "id": 87,
      "start": 14363.62,
      "end": 14366.62,
      "formatted_start": "03:59:23.620",
      "formatted_end": "03:59:26.620",
      "text": "مهمی که دست سپاهیه"
    },
    {
      "id": 88,
      "start": 14366.62,
      "end": 14373.62,
      "formatted_start": "03:59:26.620",
      "formatted_end": "03:59:33.620",
      "text": "ببینید سرمایه دارها هم الان سپاهیه مثلا داروهایی که آرایشی هستند"
    },
    {
      "id": 89,
      "start": 14373.62,
      "end": 14375.62,
      "formatted_start": "03:59:33.620",
      "formatted_end": "03:59:35.620",
      "text": "ماتیگ، کاتیگ، تا تیگ"
    },
    {
      "id": 90,
      "start": 14375.62,
      "end": 14377.62,
      "formatted_start": "03:59:35.620",
      "formatted_end": "03:59:37.620",
      "text": "همینو همون سپاهیه از اون بود"
    },
    {
      "id": 91,
      "start": 14377.62,
      "end": 14381.62,
      "formatted_start": "03:59:37.620",
      "formatted_end": "03:59:41.620",
      "text": "الان قریزش این مورد داروهایی پوستی که الان برای ما میارند"
    },
    {
      "id": 92,
      "start": 14381.62,
      "end": 14383.92,
      "formatted_start": "03:59:41.620",
      "formatted_end": "03:59:43.920",
      "text": "اینجوری مال شخص سپاه نیست داره"
    },
    {
      "id": 93,
      "start": 14383.92,
      "end": 14386.98,
      "formatted_start": "03:59:43.920",
      "formatted_end": "03:59:46.980",
      "text": "مثلا سرداری بهش خواستن امتیاز کنن"
    },
    {
      "id": 94,
      "start": 14386.98,
      "end": 14390.86,
