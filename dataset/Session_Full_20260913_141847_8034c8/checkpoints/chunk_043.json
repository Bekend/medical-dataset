      "end": 12929.98,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 12930.0,
      "end": 12959.98,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 2,
      "start": 12960.0,
      "end": 12989.98,
      "formatted_start": "03:36:00.000",
      "formatted_end": "03:36:29.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 3,
      "start": 12990.0,
      "end": 12996.0,
      "formatted_start": "03:36:30.000",
      "formatted_end": "03:36:36.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 13020.0,
      "end": 13048.0,
      "formatted_start": "03:37:00.000",
      "formatted_end": "03:37:28.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 13050.0,
      "end": 13070.0,
      "formatted_start": "03:37:30.000",
      "formatted_end": "03:37:50.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 13070.0,
      "end": 13080.0,
      "formatted_start": "03:37:50.000",
      "formatted_end": "03:38:00.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 13100.0,
      "end": 13125.0,
      "formatted_start": "03:38:20.000",
      "formatted_end": "03:38:45.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 13155.0,
      "end": 13157.0,
      "formatted_start": "03:39:15.000",
      "formatted_end": "03:39:17.000",
      "text": "این رو باید بردیم"
    },
    {
      "id": 9,
      "start": 13157.0,
      "end": 13160.0,
      "formatted_start": "03:39:17.000",
      "formatted_end": "03:39:20.000",
      "text": "در بعدش، از اینکه رو کرمی کریم داریم"
    },
    {
      "id": 10,
      "start": 13160.0,
      "end": 13161.0,
      "formatted_start": "03:39:20.000",
      "formatted_end": "03:39:21.000",
      "text": "این رو شیشه باشید"
    },
    {
      "id": 11,
      "start": 13161.0,
      "end": 13163.0,
      "formatted_start": "03:39:21.000",
      "formatted_end": "03:39:23.000",
      "text": "باشید، شیشه باشید"
    },
    {
      "id": 12,
      "start": 13163.0,
      "end": 13165.0,
      "formatted_start": "03:39:23.000",
      "formatted_end": "03:39:25.000",
      "text": "کرمی کریمه لامینین است، آره کور"
    },
    {
      "id": 13,
      "start": 13165.0,
      "end": 13167.0,
      "formatted_start": "03:39:25.000",
      "formatted_end": "03:39:27.000",
      "text": "برای انواع پوست"
    },
    {
      "id": 14,
      "start": 13167.0,
      "end": 13171.0,
      "formatted_start": "03:39:27.000",
      "formatted_end": "03:39:31.000",
      "text": "ما در شخصش های لامینین، همه شما میجنگ کرده هستیم"
    },
    {
      "id": 15,
      "start": 13171.0,
      "end": 13174.0,
      "formatted_start": "03:39:31.000",
      "formatted_end": "03:39:34.000",
      "text": "پوست چرب، پوست چرب مستعده، پوست خوش بشتیم"
    },
    {
      "id": 16,
      "start": 13174.0,
      "end": 13176.0,
      "formatted_start": "03:39:34.000",
      "formatted_end": "03:39:36.000",
      "text": "این انواع پوست است، ولی حاوی کرمه"
    },
    {
      "id": 17,
      "start": 13176.0,
      "end": 13181.0,
      "formatted_start": "03:39:36.000",
      "formatted_end": "03:39:41.000",
      "text": "چند تا روغن مقعدی مثل روغن دانه کرم و سبوس برنج هم داخلش دارن"
    },
    {
      "id": 18,
      "start": 13181.0,
      "end": 13184.0,
      "formatted_start": "03:39:41.000",
      "formatted_end": "03:39:44.000",
      "text": "خب، بعد کموم سرین هم میتونن اتفاده کنن"
    },
    {
      "id": 19,
      "start": 13184.0,
      "end": 13189.0,
      "formatted_start": "03:39:44.000",
      "formatted_end": "03:39:49.000",
      "text": "چه سرین بالا، چه چیز برای شست و شوشی روزانه، چون پر کنندگی دارن"
    },
    {
      "id": 20,
      "start": 13190.0,
      "end": 13194.0,
      "formatted_start": "03:39:50.000",
      "formatted_end": "03:39:54.000",
      "text": "ممنون میشم اگر مورد تاییدتون بود، محبت من یه چند..."
    },
    {
      "id": 21,
      "start": 13194.0,
      "end": 13196.0,
      "formatted_start": "03:39:54.000",
      "formatted_end": "03:39:56.000",
      "text": "ازش ها خوبه، پونسندتون هستن؟"
    },
    {
      "id": 22,
      "start": 13196.0,
      "end": 13200.0,
      "formatted_start": "03:39:56.000",
      "formatted_end": "03:40:00.000",
      "text": "آره، به عنوان شوینده غیر ثابونیه"
    }
  ],
  "status": "completed"
}