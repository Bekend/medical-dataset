    },
    {
      "id": 30,
      "start": 8243.0,
      "end": 8245.0,
      "formatted_start": "02:17:23.000",
      "formatted_end": "02:17:25.000",
      "text": "همه دکتر را رده باشی"
    },
    {
      "id": 31,
      "start": 8245.0,
      "end": 8247.0,
      "formatted_start": "02:17:25.000",
      "formatted_end": "02:17:27.000",
      "text": "اینکه دیگه راقعی خانه بودی"
    },
    {
      "id": 32,
      "start": 8247.0,
      "end": 8249.0,
      "formatted_start": "02:17:27.000",
      "formatted_end": "02:17:29.000",
      "text": "هم که نصرش همه افتاده"
    },
    {
      "id": 33,
      "start": 8249.0,
      "end": 8251.0,
      "formatted_start": "02:17:29.000",
      "formatted_end": "02:17:31.000",
      "text": "اینجا چی؟"
    },
    {
      "id": 34,
      "start": 8251.0,
      "end": 8253.0,
      "formatted_start": "02:17:31.000",
      "formatted_end": "02:17:33.000",
      "text": "نرمورده بگو، خود همین بقیه"
    },
    {
      "id": 35,
      "start": 8253.0,
      "end": 8255.0,
      "formatted_start": "02:17:33.000",
      "formatted_end": "02:17:35.000",
      "text": "این روگایی ای دونه ای؟"
    },
    {
      "id": 36,
      "start": 8255.0,
      "end": 8257.0,
      "formatted_start": "02:17:35.000",
      "formatted_end": "02:17:37.000",
      "text": "این روگایی ها افتادن دیگه"
    },
    {
      "id": 37,
      "start": 8257.0,
      "end": 8259.0,
      "formatted_start": "02:17:37.000",
      "formatted_end": "02:17:39.000",
      "text": "دیشه را راه نیم"
    },
    {
      "id": 38,
      "start": 8259.0,
      "end": 8261.0,
      "formatted_start": "02:17:39.000",
      "formatted_end": "02:17:41.000",
      "text": "هران نامورده ای نه؟"
    },
    {
      "id": 39,
      "start": 8261.0,
      "end": 8263.0,
      "formatted_start": "02:17:41.000",
      "formatted_end": "02:17:43.000",
      "text": "هران جا"
    },
    {
      "id": 40,
      "start": 8263.0,
      "end": 8265.0,
      "formatted_start": "02:17:43.000",
      "formatted_end": "02:17:45.000",
      "text": "شما؟ نه"
    },
    {
      "id": 41,
      "start": 8265.0,
      "end": 8267.0,
      "formatted_start": "02:17:45.000",
      "formatted_end": "02:17:47.000",
      "text": "خودشون"
    },
    {
      "id": 42,
      "start": 8267.0,
      "end": 8269.0,
      "formatted_start": "02:17:47.000",
      "formatted_end": "02:17:49.000",
      "text": "نرمورده بگو"
    },
    {
      "id": 43,
      "start": 8269.0,
      "end": 8271.0,
      "formatted_start": "02:17:49.000",
      "formatted_end": "02:17:51.000",
      "text": "ادرار چی خواهده؟"
    },
    {
      "id": 44,
      "start": 8271.0,
      "end": 8273.0,
      "formatted_start": "02:17:51.000",
      "formatted_end": "02:17:53.000",
      "text": "ادرار ها زیاده"
    },
    {
      "id": 45,
      "start": 8273.0,
      "end": 8275.0,
      "formatted_start": "02:17:53.000",
      "formatted_end": "02:17:55.000",
      "text": "ادرار ها زیاده"
    },
    {
      "id": 46,
      "start": 8275.0,
      "end": 8277.0,
      "formatted_start": "02:17:55.000",
      "formatted_end": "02:17:57.000",
      "text": "چشم"
    },
    {
      "id": 47,
      "start": 8277.0,
      "end": 8293.0,
      "formatted_start": "02:17:57.000",
      "formatted_end": "02:18:13.000",
      "text": "ادرار کوچیک ازیاد نیست؟ ادرار کوچیک تن تن بری، سوزش بکنی؟ نه، نه، نه، نه، کنترولت هم خوبه، متوجه چه سالی هستی؟ 55، 55،"
    },
    {
      "id": 48,
      "start": 8293.0,
      "end": 8299.0,
      "formatted_start": "02:18:13.000",
      "formatted_end": "02:18:19.000",
      "text": "اما زن همه کلاس همون زن همین بیشتر که"
    },
    {
      "id": 49,
      "start": 8299.0,
      "end": 8302.0,
      "formatted_start": "02:18:19.000",
      "formatted_end": "02:18:22.000",
      "text": "حمید محمدی"
    },
    {
      "id": 50,
      "start": 8302.0,
      "end": 8303.0,
      "formatted_start": "02:18:22.000",
      "formatted_end": "02:18:23.000",
      "text": "چیز صغرا خانم؟"
    },
    {
      "id": 51,
      "start": 8303.0,
      "end": 8305.0,
      "formatted_start": "02:18:23.000",
      "formatted_end": "02:18:25.000",
      "text": "چیز زهر خانم"
    },
    {
      "id": 52,
      "start": 8305.0,
      "end": 8309.0,
      "formatted_start": "02:18:25.000",
      "formatted_end": "02:18:29.000",
      "text": "اون ما شاید خوب شده، الان خیلی دیشتر"
    },
    {
      "id": 53,
      "start": 8309.0,
      "end": 8312.0,
      "formatted_start": "02:18:29.000",
      "formatted_end": "02:18:32.000",
      "text": "با غند داشت نامید میشد دیگه"
    },
    {
      "id": 54,
      "start": 8312.0,
      "end": 8314.0,
      "formatted_start": "02:18:32.000",
      "formatted_end": "02:18:34.000",
      "text": "نامید شیطانه این"
    },
    {
      "id": 55,
      "start": 8314.0,
      "end": 8315.0,
      "formatted_start": "02:18:34.000",
      "formatted_end": "02:18:35.000",
      "text": "خیلی دیشتر"
    },
    {
      "id": 56,
      "start": 8315.0,
      "end": 8318.0,
      "formatted_start": "02:18:35.000",
      "formatted_end": "02:18:38.000",
      "text": "خدا انشالله که مختوفیه باشه، ما باید سلامتی"
    },
    {
      "id": 57,
      "start": 8318.0,
      "end": 8321.0,
      "formatted_start": "02:18:38.000",
      "formatted_end": "02:18:41.000",
      "text": "همین که داریم که مردم انجام میدیم، خدا انشالله که باید"
    },
    {
      "id": 58,
      "start": 8321.0,
      "end": 8323.0,
      "formatted_start": "02:18:41.000",
      "formatted_end": "02:18:43.000",
      "text": "بدا بدا سلامت"
    },
    {
      "id": 59,
      "start": 8323.0,
      "end": 8325.0,
      "formatted_start": "02:18:43.000",
      "formatted_end": "02:18:45.000",
      "text": "شما باشه"
    },
    {
      "id": 60,
      "start": 8325.0,
      "end": 8327.0,
      "formatted_start": "02:18:45.000",
      "formatted_end": "02:18:47.000",
      "text": "ارتماس دعا داریم"
    },
    {
      "id": 61,
      "start": 8327.0,
      "end": 8329.0,
      "formatted_start": "02:18:47.000",
      "formatted_end": "02:18:49.000",
      "text": "بدا سلامت"
    },
    {
      "id": 62,
      "start": 8329.0,
      "end": 8331.0,
      "formatted_start": "02:18:49.000",
      "formatted_end": "02:18:51.000",
      "text": "چند وقت پردود اینجا شده؟"
    },
    {
      "id": 63,
      "start": 8331.0,
      "end": 8333.0,
      "formatted_start": "02:18:51.000",
      "formatted_end": "02:18:53.000",
      "text": "پید وقت"
    },
    {
      "id": 64,
      "start": 8333.0,
      "end": 8335.0,
      "formatted_start": "02:18:53.000",
      "formatted_end": "02:18:55.000",
      "text": "چند سال آمدید"
    },
    {
      "id": 65,
      "start": 8335.0,
      "end": 8337.0,
      "formatted_start": "02:18:55.000",
      "formatted_end": "02:18:57.000",
      "text": "پردود میری فایده نمی کنه"
    },
    {
      "id": 66,
      "start": 8337.0,
      "end": 8339.0,
      "formatted_start": "02:18:57.000",
      "formatted_end": "02:18:59.000",
      "text": "کجا میشینی شما؟"
    },
    {
      "id": 67,
      "start": 8339.0,
      "end": 8341.0,
      "formatted_start": "02:18:59.000",
      "formatted_end": "02:19:01.000",
      "text": "که بار مذا گذار بسیاره"
    },
    {
      "id": 68,
      "start": 8341.0,
      "end": 8343.0,
      "formatted_start": "02:19:01.000",
      "formatted_end": "02:19:03.000",
      "text": "آهان"
    },
    {
      "id": 69,
      "start": 8343.0,
      "end": 8345.0,
      "formatted_start": "02:19:03.000",
      "formatted_end": "02:19:05.000",
      "text": "اون از دقیق شیخ رجالی موجود شده"
    },
    {
      "id": 70,
      "start": 8345.0,
      "end": 8347.0,
      "formatted_start": "02:19:05.000",
      "formatted_end": "02:19:07.000",
      "text": "آهان"
    },
    {
      "id": 71,
      "start": 8347.0,
      "end": 8349.0,
      "formatted_start": "02:19:07.000",
      "formatted_end": "02:19:09.000",
      "text": "استعجال میشین"
    },
    {
      "id": 72,
      "start": 8349.0,
      "end": 8351.0,
      "formatted_start": "02:19:09.000",
      "formatted_end": "02:19:11.000",
      "text": "شما بهتر میشه"
    },
    {
      "id": 73,
      "start": 8351.0,
      "end": 8359.0,
      "formatted_start": "02:19:11.000",
      "formatted_end": "02:19:19.000",
      "text": "از سینه شما که خیلی دیگه این مرد برای کار و خانه باید محیط مصروف کرده سینه شما کلن دو خانه باشه"
    },
    {
      "id": 74,
      "start": 8359.0,
      "end": 8365.0,
      "formatted_start": "02:19:19.000",
      "formatted_end": "02:19:25.000",
      "text": "این همه نام را کار بکنه"
    },
    {
      "id": 75,
      "start": 8365.0,
      "end": 8368.0,
      "formatted_start": "02:19:25.000",
      "formatted_end": "02:19:28.000",
      "text": "این همه نام را از قضا نمی بکنه"
    },
    {
      "id": 76,
      "start": 8368.0,
      "end": 8371.0,
      "formatted_start": "02:19:28.000",
      "formatted_end": "02:19:31.000",
      "text": "این قضا این هم اصلا بجور بود با اول خانه"
    },
    {
      "id": 77,
      "start": 8371.0,
      "end": 8373.0,
      "formatted_start": "02:19:31.000",
      "formatted_end": "02:19:33.000",
      "text": "این هم بجور بود به شکل این"
    },
    {
      "id": 78,
      "start": 8373.0,
      "end": 8375.0,
      "formatted_start": "02:19:33.000",
      "formatted_end": "02:19:35.000",
      "text": "این از اون پردهتیه"
    },
    {
      "id": 79,
      "start": 8375.0,
      "end": 8378.0,
      "formatted_start": "02:19:35.000",
      "formatted_end": "02:19:38.000",
      "text": "این کار بودنی برای کار و خانه بکنه شما نه داره"
    },
    {
      "id": 80,
      "start": 8378.0,
      "end": 8382.0,
      "formatted_start": "02:19:38.000",
      "formatted_end": "02:19:42.000",
      "text": "از اینکه باید بردارید که روی گذرن آبادش شده"
    },
    {
      "id": 81,
      "start": 8382.0,
      "end": 8383.0,
      "formatted_start": "02:19:42.000",
      "formatted_end": "02:19:43.000",
      "text": "از چه هم داری خانه ای؟"
    },
    {
      "id": 82,
      "start": 8383.0,
      "end": 8384.0,
      "formatted_start": "02:19:43.000",
      "formatted_end": "02:19:44.000",
      "text": "یه دانه داره"
    },
    {
      "id": 83,
      "start": 8385.0,
      "end": 8387.0,
      "formatted_start": "02:19:45.000",
      "formatted_end": "02:19:47.000",
      "text": "یه دانه داره کنم"
    },
    {
      "id": 84,
      "start": 8387.0,
      "end": 8389.0,
      "formatted_start": "02:19:47.000",
      "formatted_end": "02:19:49.000",
      "text": "تو هم میره خانه ای مردم کار بکنی؟"
    },
    {
      "id": 85,
      "start": 8389.0,
      "end": 8390.0,
      "formatted_start": "02:19:49.000",
      "formatted_end": "02:19:50.000",
      "text": "آهه واقعا"
    },
    {
      "id": 86,
      "start": 8390.0,
      "end": 8392.0,
      "formatted_start": "02:19:50.000",
      "formatted_end": "02:19:52.000",
      "text": "نیفت میاد نامشانو بخوایی هم؟"
    },
    {
      "id": 87,
      "start": 8392.0,
      "end": 8394.0,
      "formatted_start": "02:19:52.000",
      "formatted_end": "02:19:54.000",
      "text": "نه بله بله"
    },
    {
      "id": 88,
      "start": 8394.0,
      "end": 8396.0,
      "formatted_start": "02:19:54.000",
      "formatted_end": "02:19:56.000",
      "text": "ازا و ازا خوب هست"
    },
    {
      "id": 89,
      "start": 8396.0,
      "end": 8398.0,
      "formatted_start": "02:19:56.000",
      "formatted_end": "02:19:58.000",
      "text": "ازای خوب هم میذارن جراوت"
    },
    {
      "id": 90,
      "start": 8398.0,
      "end": 8400.0,
      "formatted_start": "02:19:58.000",
      "formatted_end": "02:20:00.000",
      "text": "برای فاس بایش"
    }
  ],
