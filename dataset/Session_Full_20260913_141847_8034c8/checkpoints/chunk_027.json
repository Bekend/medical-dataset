      "end": 8193.0,
      "formatted_start": "02:16:30.000",
      "formatted_end": "02:16:33.000",
      "text": "اگر ارزاعتر برسم بیمی برسم بردم."
    },
    {
      "id": 14,
      "start": 8193.0,
      "end": 8197.0,
      "formatted_start": "02:16:33.000",
      "formatted_end": "02:16:37.000",
      "text": "باید بگوییم که شبه دیگه"
    },
    {
      "id": 15,
      "start": 8205.0,
      "end": 8209.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:49.000",
      "text": "باید بگوییم که شبه نمی کنیم"
    },
    {
      "id": 16,
      "start": 8209.0,
      "end": 8213.0,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:53.000",
      "text": "باید بگوییم که شبه نمی کنیم"
    },
    {
      "id": 17,
      "start": 8213.0,
      "end": 8217.0,
      "formatted_start": "02:16:53.000",
      "formatted_end": "02:16:57.000",
      "text": "باید بگوییم که شبه نمی کنیم"
    },
    {
      "id": 18,
      "start": 8217.0,
      "end": 8221.0,
      "formatted_start": "02:16:57.000",
      "formatted_end": "02:17:01.000",
      "text": "باید بگوییم که شبه نمی کنیم"
    },
    {
