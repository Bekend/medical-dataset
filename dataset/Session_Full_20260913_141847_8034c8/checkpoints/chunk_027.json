  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8129.98,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 8130.0,
      "end": 8159.98,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:15:59.980",
      "text": "از اینجا باید بردارید که این روزه هایی رو باید بردارید."
    },
    {
      "id": 2,
      "start": 8160.0,
      "end": 8162.0,
      "formatted_start": "02:16:00.000",
      "formatted_end": "02:16:02.000",
      "text": "برای اینجا، اینجا باید بردارید."
    },
    {
      "id": 3,
      "start": 8162.0,
      "end": 8164.0,
      "formatted_start": "02:16:02.000",
      "formatted_end": "02:16:04.000",
      "text": "برای اینجا، اینجا باید بردارید."
    },
    {
      "id": 4,
      "start": 8164.0,
      "end": 8166.0,
      "formatted_start": "02:16:04.000",
      "formatted_end": "02:16:06.000",
      "text": "برای اینجا، اینجا باید بردارید."
    },
    {
      "id": 5,
      "start": 8166.0,
      "end": 8169.0,
      "formatted_start": "02:16:06.000",
      "formatted_end": "02:16:09.000",
      "text": "این طول خواهش می کنید."
    },
    {
      "id": 6,
      "start": 8169.0,
      "end": 8172.0,
      "formatted_start": "02:16:09.000",
      "formatted_end": "02:16:12.000",
      "text": "چون این طول خواهش می کنید."
    },
    {
      "id": 7,
      "start": 8172.0,
      "end": 8175.0,
      "formatted_start": "02:16:12.000",
      "formatted_end": "02:16:15.000",
      "text": "آدم ها کارگاه عرار نمی آمده جور آوردن به جایی تو."
    },
    {
      "id": 8,
      "start": 8175.0,
      "end": 8178.0,
      "formatted_start": "02:16:15.000",
      "formatted_end": "02:16:18.000",
      "text": "آره."
    },
    {
      "id": 9,
      "start": 8178.0,
      "end": 8181.0,
      "formatted_start": "02:16:18.000",
      "formatted_end": "02:16:21.000",
      "text": "آره."
    },
    {
      "id": 10,
      "start": 8181.0,
      "end": 8184.0,
      "formatted_start": "02:16:21.000",
      "formatted_end": "02:16:24.000",
      "text": "یه پومات هست یه میدین تو آدمانی."
    },
    {
      "id": 11,
      "start": 8184.0,
      "end": 8187.0,
      "formatted_start": "02:16:24.000",
      "formatted_end": "02:16:27.000",
      "text": "خدای بدن بید؟"
    },
    {
      "id": 12,
      "start": 8187.0,
      "end": 8190.0,
      "formatted_start": "02:16:27.000",
      "formatted_end": "02:16:30.000",
      "text": "اگر..."
    },
