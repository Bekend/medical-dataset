  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5716.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:16.000",
      "text": "سماغ هم هر روز دم کنه بود، باید. قرص چربی روز، ستا، تینه، بیست، سی تا شبیه که قرصه."
    },
    {
      "id": 1,
      "start": 5716.0,
      "end": 5722.0,
      "formatted_start": "01:35:16.000",
      "formatted_end": "01:35:22.000",
      "text": "از اینجوری همه چیزی باشه که باید برداشت کنیم."
    },
    {
      "id": 2,
      "start": 5722.0,
      "end": 5726.0,
      "formatted_start": "01:35:22.000",
      "formatted_end": "01:35:26.000",
      "text": "اینجوری همه چیزی باشه که باید برداشت کنیم."
    },
    {
      "id": 3,
      "start": 5726.0,
      "end": 5730.0,
      "formatted_start": "01:35:26.000",
      "formatted_end": "01:35:30.000",
      "text": "اینجوری همه چیزی باشه که باید برداشت کنیم."
    },
    {
      "id": 4,
      "start": 5730.0,
      "end": 5734.0,
      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:34.000",
      "text": "اینجوری همه چیزی باشه که برداشت کنیم."
    },
    {
      "id": 5,
      "start": 5734.0,
      "end": 5738.0,
      "formatted_start": "01:35:34.000",
      "formatted_end": "01:35:38.000",
      "text": "اینجوری همه چیزی باشه که برداشت کنیم."
    },
    {
      "id": 6,
      "start": 5738.0,
      "end": 5742.0,
      "formatted_start": "01:35:38.000",
      "formatted_end": "01:35:42.000",
      "text": "اینجوری همه چیزی باشه که برداشت کنیم."
    },
    {
      "id": 7,
      "start": 5742.0,
      "end": 5748.0,
      "formatted_start": "01:35:42.000",
      "formatted_end": "01:35:48.000",
      "text": "سونوگرافی میاز نیست برام. برای کجا تو؟"
    },
    {
      "id": 8,
      "start": 5748.0,
      "end": 5752.0,
      "formatted_start": "01:35:48.000",
      "formatted_end": "01:35:52.000",
      "text": "برای گوکم. کبه دانم چند بوده. یکی شما آدم درست میده."
    },
    {
      "id": 9,
      "start": 5752.0,
      "end": 5754.0,
      "formatted_start": "01:35:52.000",
      "formatted_end": "01:35:54.000",
      "text": "سونوگرافی کامل هم براتون بریم. سرسون."
    },
    {
      "id": 10,
      "start": 5754.0,
      "end": 5761.0,
      "formatted_start": "01:35:54.000",
      "formatted_end": "01:36:01.000",
      "text": "این از که از کشش رایبانه بیده برست. سونوگرافی کامل."
    },
    {
      "id": 11,
      "start": 5761.0,
      "end": 5763.0,
      "formatted_start": "01:36:01.000",
      "formatted_end": "01:36:03.000",
      "text": "مرسی باید."
    },
    {
      "id": 12,
      "start": 5763.0,
      "end": 5766.0,
      "formatted_start": "01:36:03.000",
      "formatted_end": "01:36:06.000",
      "text": "برای اینکشون سونو نمشتن دکتران؟"
    },
    {
      "id": 13,
      "start": 5766.0,
      "end": 5768.0,
      "formatted_start": "01:36:06.000",
      "formatted_end": "01:36:08.000",
      "text": "نه سونو شما جایی همون براتون."
    },
    {
      "id": 14,
      "start": 5768.0,
      "end": 5798.0,
      "formatted_start": "01:36:08.000",
      "formatted_end": "01:36:38.000",
      "text": "برای اینکه 5 سال در این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای این وقت برای ا"
    },
    {
      "id": 15,
      "start": 5798.0,
      "end": 5828.0,
      "formatted_start": "01:36:38.000",
      "formatted_end": "01:37:08.000",
      "text": "سماغ، پروز، درم ورده، مصنف شما، گزنه، درم ورده، ورده، روزگوگان، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ورده، درم ور"
    },
    {
      "id": 16,
      "start": 5828.0,
      "end": 5831.66,
      "formatted_start": "01:37:08.000",
      "formatted_end": "01:37:11.660",
      "text": "دختر رو برده میگو، فرقیتا من فرموشی میکردم به شما بگم اون موضوع رو"
    },
    {
      "id": 17,
      "start": 5831.66,
      "end": 5834.0,
      "formatted_start": "01:37:11.660",
      "formatted_end": "01:37:14.000",
      "text": "این دفعه مختبره بشیم، بگم از تو چونه"
    },
    {
      "id": 18,
      "start": 5834.0,
      "end": 5835.0,
      "formatted_start": "01:37:14.000",
      "formatted_end": "01:37:15.000",
      "text": "چونه؟"
    },
    {
      "id": 19,
      "start": 5835.0,
      "end": 5839.0,
      "formatted_start": "01:37:15.000",
      "formatted_end": "01:37:19.000",
      "text": "دختر اصلا بهش دوام نداده باید دختر برای آزمایشی"
    },
    {
      "id": 20,
      "start": 5839.0,
      "end": 5841.0,
      "formatted_start": "01:37:19.000",
      "formatted_end": "01:37:21.000",
      "text": "دختر فریه نرده گره"
    },
    {
      "id": 21,
      "start": 5841.0,
      "end": 5845.0,
      "formatted_start": "01:37:21.000",
      "formatted_end": "01:37:25.000",
      "text": "من اصلا تقریبا تو حیطه ای رو کار خودشانه برمون کنم"
    },
    {
      "id": 22,
      "start": 5845.0,
      "end": 5846.0,
      "formatted_start": "01:37:25.000",
      "formatted_end": "01:37:26.000",
      "text": "ببین شما میدین"
    },
    {
      "id": 23,
      "start": 5846.0,
      "end": 5847.0,
      "formatted_start": "01:37:26.000",
      "formatted_end": "01:37:27.000",
      "text": "الان ما اینکه دوست داریم"
    },
    {
      "id": 24,
      "start": 5847.0,
      "end": 5849.0,
      "formatted_start": "01:37:27.000",
      "formatted_end": "01:37:29.000",
      "text": "ما دوست داریم، اونان دوست داریم"
    },
    {
      "id": 25,
      "start": 5849.0,
      "end": 5852.5,
      "formatted_start": "01:37:29.000",
      "formatted_end": "01:37:32.500",
      "text": "ما به همه چیزی بارک میشیم، چشمی باشیم، گوش باشیم"
    },
    {
      "id": 26,
      "start": 5852.5,
      "end": 5857.9,
      "formatted_start": "01:37:32.500",
      "formatted_end": "01:37:37.900",
      "text": "اما کسی که جرای مرقصه، شما اگه از کبت بی میریم بهتر آوردیم"
    },
    {
      "id": 27,
      "start": 5857.9,
      "end": 5860.3,
      "formatted_start": "01:37:37.900",
      "formatted_end": "01:37:40.300",
      "text": "میگه باید بری فوقت تحصیل کردیم"
    },
    {
      "id": 28,
      "start": 5860.3,
      "end": 5863.9,
      "formatted_start": "01:37:40.300",
      "formatted_end": "01:37:43.900",
      "text": "باز میری فوقت تحصیل کردیم، بعد اونجا مثلا نشون اطلاعه داره بود"
    },
    {
      "id": 29,
      "start": 5863.9,
      "end": 5865.9,
      "formatted_start": "01:37:43.900",
      "formatted_end": "01:37:45.900",
      "text": "میگه به من ربطی باشیم، باید بری فوقت تحصیل کردیم"
    },
    {
      "id": 30,
      "start": 5865.9,
      "end": 5867.9,
      "formatted_start": "01:37:45.900",
      "formatted_end": "01:37:47.900",
      "text": "هر قسمت برای این کارش"
    },
    {
      "id": 31,
      "start": 5867.9,
      "end": 5870.9,
      "formatted_start": "01:37:47.900",
      "formatted_end": "01:37:50.900",
      "text": "بهزش کنم میگی؟ نه، به همه چی میتونه بارک بشه"
    },
    {
      "id": 32,
      "start": 5870.9,
      "end": 5876.9,
      "formatted_start": "01:37:50.900",
      "formatted_end": "01:37:56.900",
      "text": "و درستش اینکه ابتدا به شمون میبینیم درمان میکنه اگه درمان نشد نامی ارجاع بده"
    },
    {
      "id": 33,
      "start": 5876.9,
      "end": 5882.9,
      "formatted_start": "01:37:56.900",
      "formatted_end": "01:38:02.900",
      "text": "بگه آقا من تلاشم رو کردم علمم همین بود مثلا نتونستم آقای متخصص هستم"
    },
    {
      "id": 34,
      "start": 5882.9,
      "end": 5886.9,
      "formatted_start": "01:38:02.900",
      "formatted_end": "01:38:06.900",
      "text": "نه چون دکتور احزونه یه زر پیرون پیش رو درمان سازه"
    },
    {
      "id": 35,
      "start": 5886.9,
      "end": 5892.9,
      "formatted_start": "01:38:06.900",
      "formatted_end": "01:38:12.900",
      "text": "یعنی متحسیص میره که یه چیزی درمان میکنه ایشون نه کلت که ایران اینجوریه"
    },
    {
      "id": 36,
      "start": 5892.9,
      "end": 5896.9,
      "formatted_start": "01:38:12.900",
      "formatted_end": "01:38:16.900",
      "text": "چون یه دکتور میره باز کن چیزای دیگه مثلا زخمه در نظر نمیگه"
    },
    {
      "id": 37,
      "start": 5896.9,
      "end": 5902.9,
      "formatted_start": "01:38:16.900",
      "formatted_end": "01:38:22.900",
      "text": "دوهای زانوش دوهایی باید دوهای زانو به میدهش خوندزیر می کنه می گه به من رفتی نباید به دکتر رو بیده"
    },
    {
      "id": 38,
      "start": 5902.9,
      "end": 5908.9,
      "formatted_start": "01:38:22.900",
      "formatted_end": "01:38:28.900",
      "text": "اصلا نباید انسان ها مستقیم به متخصص مراجعه بیده"
    },
    {
      "id": 39,
      "start": 5908.9,
      "end": 5912.9,
      "formatted_start": "01:38:28.900",
      "formatted_end": "01:38:32.900",
      "text": "متخصص پیزشکی اینکه در تمام دنیا بیمار نمی بیده"
    },
    {
      "id": 40,
      "start": 5912.9,
      "end": 5915.9,
      "formatted_start": "01:38:32.900",
      "formatted_end": "01:38:35.900",
      "text": "بعد که پیزشکی می بیده اشکالجان می بیده"
    },
    {
      "id": 41,
      "start": 5915.9,
      "end": 5917.9,
      "formatted_start": "01:38:35.900",
      "formatted_end": "01:38:37.900",
      "text": "ما تو ایرانه که هر دن می بیده"
    },
    {
      "id": 42,
      "start": 5917.9,
      "end": 5921.9,
      "formatted_start": "01:38:37.900",
      "formatted_end": "01:38:41.900",
      "text": "مستقیم میگه میگه تبیه باید متخصص یعنی دکتر خوب، پیزشکومی یعنی دکتر بد"
    },
    {
      "id": 43,
      "start": 5921.9,
      "end": 5927.9,
      "formatted_start": "01:38:41.900",
      "formatted_end": "01:38:47.900",
      "text": "نه، پیزشکومی یعنی دکتر اول، متخصص یعنی دکتر دوم، فوقتخصص یعنی دکتر ثبوت"
    },
    {
      "id": 44,
      "start": 5927.9,
      "end": 5934.9,
      "formatted_start": "01:38:47.900",
      "formatted_end": "01:38:54.900",
      "text": "یعنی باید اون اجابه، مثلا متخصص باید بگیری و بعد میگه که نه این نمیشه ما، نمیتونیم برای این کاری انجام بده"
    },
    {
      "id": 45,
      "start": 5934.9,
      "end": 5938.9,
      "formatted_start": "01:38:54.900",
      "formatted_end": "01:38:58.900",
      "text": "این باید بره پیش فوقتخصص، نامون میده آقای فوقتخصصی ببین، اونم ببین"
    },
    {
      "id": 46,
      "start": 5947.9,
      "end": 5952.3,
      "formatted_start": "01:39:07.900",
      "formatted_end": "01:39:12.300",
      "text": "در نظر نمی گیره، میدهش رو در نظر نمی گیره، فقط میاد برای کبلش رو ببین"
    },
    {
      "id": 47,
      "start": 5952.3,
      "end": 5957.9,
      "formatted_start": "01:39:12.300",
      "formatted_end": "01:39:17.900",
      "text": "میاد برای زانوش رو ببین، میاد برای یه جاشی، یه جای خاصی رو ببین"
    },
    {
      "id": 48,
      "start": 5957.9,
      "end": 5960.3,
      "formatted_start": "01:39:17.900",
      "formatted_end": "01:39:20.300",
      "text": "برای بقیه چیزها رو میگه به من رفت میرن"
    },
    {
      "id": 49,
      "start": 5960.3,
      "end": 5963.9,
      "formatted_start": "01:39:20.300",
      "formatted_end": "01:39:23.900",
      "text": "از اینجا برای کلیه چی کدوم دکتر بره؟ همه دکتر شما همه کنید"
    },
    {
      "id": 50,
      "start": 5963.9,
      "end": 5972.3,
      "formatted_start": "01:39:23.900",
      "formatted_end": "01:39:32.300",
      "text": "برای کلیه دو دکتر داریم دیگه، یکی برای جلدهی گردان، یکی مجردوه"
    },
    {
      "id": 51,
      "start": 5972.3,
      "end": 5974.8,
      "formatted_start": "01:39:32.300",
      "formatted_end": "01:39:34.800",
      "text": "دو تا گردان دکتر کلیه اینا هستن"
    },
    {
      "id": 52,
      "start": 5974.8,
      "end": 5976.16,
      "formatted_start": "01:39:34.800",
      "formatted_end": "01:39:36.160",
      "text": "یه لطفی کلیه بینیم بیستیم"
    },
    {
      "id": 53,
      "start": 5976.16,
      "end": 5977.56,
      "formatted_start": "01:39:36.160",
      "formatted_end": "01:39:37.560",
      "text": "جرائه کلیه نه ها"
    },
    {
      "id": 54,
      "start": 5977.56,
      "end": 5979.02,
      "formatted_start": "01:39:37.560",
      "formatted_end": "01:39:39.020",
      "text": "اما میتونه متوقعیتی شده"
    },
    {
      "id": 55,
      "start": 5979.02,
      "end": 5981.1,
      "formatted_start": "01:39:39.020",
      "formatted_end": "01:39:41.100",
      "text": "جرائه کلیه زیاده اورولوژیسته"
    },
    {
      "id": 56,
      "start": 5981.1,
      "end": 5983.0,
      "formatted_start": "01:39:41.100",
      "formatted_end": "01:39:43.000",
      "text": "اینا با خاصی نفرولوژیه"
    },
    {
      "id": 57,
      "start": 5983.0,
      "end": 5985.02,
      "formatted_start": "01:39:43.000",
      "formatted_end": "01:39:45.020",
      "text": "فرجالایی مهران"
    },
    {
      "id": 58,
      "start": 5985.02,
      "end": 5986.58,
      "formatted_start": "01:39:45.020",
      "formatted_end": "01:39:46.580",
      "text": "و اون یکی چی گفتم؟"
    },
    {
      "id": 59,
      "start": 5986.58,
      "end": 5987.28,
      "formatted_start": "01:39:46.580",
      "formatted_end": "01:39:47.280",
      "text": "موجرلو"
    },
    {
      "id": 60,
      "start": 5987.28,
      "end": 5991.5,
      "formatted_start": "01:39:47.280",
      "formatted_end": "01:39:51.500",
      "text": "دو تا دو تا دکتر دانشگاه آلی"
    },
    {
      "id": 61,
      "start": 5991.5,
      "end": 5992.62,
      "formatted_start": "01:39:51.500",
      "formatted_end": "01:39:52.620",
      "text": "بهترین دکتر هستن"
    },
    {
      "id": 62,
      "start": 5992.62,
      "end": 5995.42,
      "formatted_start": "01:39:52.620",
      "formatted_end": "01:39:55.420",
      "text": "دارویل که لازم داره"
    },
    {
      "id": 63,
      "start": 5995.42,
      "end": 5997.38,
      "formatted_start": "01:39:55.420",
      "formatted_end": "01:39:57.380",
      "text": "فعلا قدم اول نمشتم"
    },
    {
      "id": 64,
      "start": 5997.38,
      "end": 5999.92,
      "formatted_start": "01:39:57.380",
      "formatted_end": "01:39:59.920",
      "text": "به صفحه این دوری که یا این"
    }
  ],
  "status": "completed"
}