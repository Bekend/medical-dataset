    },
    {
      "id": 10,
      "start": 7220.0,
      "end": 7222.0,
      "formatted_start": "02:00:20.000",
      "formatted_end": "02:00:22.000",
      "text": "مرسوم کشم آخه."
    },
    {
      "id": 11,
      "start": 7222.0,
      "end": 7224.0,
      "formatted_start": "02:00:22.000",
      "formatted_end": "02:00:24.000",
      "text": "مرسوم کشم آخه."
    },
    {
      "id": 12,
      "start": 7224.0,
      "end": 7226.0,
      "formatted_start": "02:00:24.000",
      "formatted_end": "02:00:26.000",
      "text": "مرسوم کشم آخه."
    },
    {
      "id": 13,
      "start": 7226.0,
      "end": 7228.0,
      "formatted_start": "02:00:26.000",
      "formatted_end": "02:00:28.000",
      "text": "مرسوم کشم آخه."
    },
    {
      "id": 14,
      "start": 7228.0,
      "end": 7232.0,
      "formatted_start": "02:00:28.000",
      "formatted_end": "02:00:32.000",
      "text": "برای اینو فرداشون رو یکوزی رو سنو اینو اینو اونو"
    },
    {
      "id": 15,
      "start": 7232.0,
      "end": 7235.0,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:35.000",
      "text": "اما سرکن هم هم پنجه هزار درصد یکوزی رو سنو دیتن"
    },
    {
      "id": 16,
      "start": 7235.0,
      "end": 7239.0,
      "formatted_start": "02:00:35.000",
      "formatted_end": "02:00:39.000",
      "text": "تا وقت این خیلی خوبه ولی فرداشون بیمیبه بسر نمیشه سر"
    },
    {
      "id": 17,
      "start": 7239.0,
      "end": 7240.0,
      "formatted_start": "02:00:39.000",
      "formatted_end": "02:00:40.000",
      "text": "نقطه سر خط"
    },
    {
      "id": 18,
      "start": 7240.0,
      "end": 7241.0,
      "formatted_start": "02:00:40.000",
      "formatted_end": "02:00:41.000",
      "text": "بله بله"
    },
    {
      "id": 19,
      "start": 7241.0,
      "end": 7242.0,
      "formatted_start": "02:00:41.000",
      "formatted_end": "02:00:42.000",
      "text": "این همون بشه"
    },
    {
      "id": 20,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "یک کاری بده براش بود هم خوابی بود"
    },
    {
      "id": 21,
      "start": 7244.0,
      "end": 7247.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:47.000",
      "text": "نزدیکی کردی فرداشون باز دوباره هم ناشون میکنه"
    },
    {
      "id": 22,
      "start": 7247.0,
      "end": 7248.0,
      "formatted_start": "02:00:47.000",
      "formatted_end": "02:00:48.000",
      "text": "این"
    },
    {
      "id": 23,
      "start": 7248.0,
      "end": 7249.0,
      "formatted_start": "02:00:48.000",
      "formatted_end": "02:00:49.000",
      "text": "چکار بود؟"
    },
    {
      "id": 24,
      "start": 7249.0,
      "end": 7250.0,
      "formatted_start": "02:00:49.000",
      "formatted_end": "02:00:50.000",
      "text": "همون برات"
    },
    {
      "id": 25,
      "start": 7250.0,
      "end": 7257.0,
      "formatted_start": "02:00:50.000",
      "formatted_end": "02:00:57.000",
      "text": "سنگیتر است، تردمند هفت کلو بلند کردند، باز دوباره باز همون آشوی، ده کلیه پیت ده کلیه دست میگیریم،"
    },
    {
      "id": 26,
      "start": 7257.0,
      "end": 7263.0,
      "formatted_start": "02:00:57.000",
      "formatted_end": "02:01:03.000",
      "text": "نواره بزرگ میگیریم، خواهد ببری خواهد باید دواره هر چین جکوزی رفتند، کجا رفتیم، همه چی برزرگ میشیم."
    },
    {
      "id": 27,
      "start": 7263.0,
      "end": 7271.0,
      "formatted_start": "02:01:03.000",
      "formatted_end": "02:01:11.000",
      "text": "یک کار سخت، یک کاری که به شکم خوابیده بخواست انجام بدید، یا یک کاری که مثلا توی جای تنگ بشین،"
    },
    {
      "id": 28,
      "start": 7271.0,
      "end": 7277.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:17.000",
      "text": "این چیزی رو پیچیده ببندیم دوباره همون آشو همون کاسه میشه"
    },
    {
      "id": 29,
      "start": 7277.0,
      "end": 7280.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:20.000",
      "text": "بس این سایه همین هم شو سرد نیست"
    },
    {
      "id": 30,
      "start": 7280.0,
      "end": 7286.0,
      "formatted_start": "02:01:20.000",
      "formatted_end": "02:01:26.000",
      "text": "مصرف دارومه و قضروف ساز باعث میشه این قضروف این اطافه بیشتری بدون بکنه خوشکشی کم میشه"
    },
    {
      "id": 31,
      "start": 7286.0,
      "end": 7289.0,
      "formatted_start": "02:01:26.000",
      "formatted_end": "02:01:29.000",
      "text": "مصرف آب آب کردن خیلی به توی کمک میکنیم"
    },
    {
      "id": 32,
      "start": 7289.0,
      "end": 7293.0,
      "formatted_start": "02:01:29.000",
      "formatted_end": "02:01:33.000",
      "text": "الان نوشته که قضروف های شما آبشون رو از دست دادن"
    },
    {
      "id": 33,
      "start": 7293.0,
      "end": 7296.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:36.000",
      "text": "شما روزی چند لیبون آب اضافه ترستش نیم؟"
    },
    {
      "id": 34,
      "start": 7296.0,
      "end": 7299.5,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:39.500",
      "text": "من اصلا سریبان چایی نخواهم ولی آب زیاد بخورم"
    },
    {
      "id": 35,
      "start": 7299.5,
      "end": 7300.5,
      "formatted_start": "02:01:39.500",
      "formatted_end": "02:01:40.500",
      "text": "آب چون؟"
    },
    {
      "id": 36,
      "start": 7300.5,
      "end": 7304.5,
      "formatted_start": "02:01:40.500",
      "formatted_end": "02:01:44.500",
      "text": "خودمون روزی که شاید تقریباً 8-9 تا 10 تا مرمونه میخورم"
    },
    {
      "id": 37,
      "start": 7304.5,
      "end": 7305.5,
      "formatted_start": "02:01:44.500",
      "formatted_end": "02:01:45.500",
      "text": "بله، 8-9 تا 10 تا مرمونه؟"
    },
    {
      "id": 38,
      "start": 7305.5,
      "end": 7309.0,
      "formatted_start": "02:01:45.500",
      "formatted_end": "02:01:49.000",
      "text": "بله، یک درخواست صبح بگذاریم که اول صبح 4-5 تا نخورم"
    },
    {
      "id": 39,
      "start": 7309.0,
      "end": 7310.0,
      "formatted_start": "02:01:49.000",
      "formatted_end": "02:01:50.000",
      "text": "اصلا"
    },
    {
      "id": 40,
      "start": 7310.0,
      "end": 7312.5,
      "formatted_start": "02:01:50.000",
      "formatted_end": "02:01:52.500",
      "text": "این به شما ایشه هست، بلد بلد از این"
    },
    {
      "id": 41,
      "start": 7312.5,
      "end": 7314.5,
      "formatted_start": "02:01:52.500",
      "formatted_end": "02:01:54.500",
      "text": "کل دیدارون به شما دارو کمک میکنه"
    },
    {
      "id": 42,
      "start": 7314.5,
      "end": 7317.0,
      "formatted_start": "02:01:54.500",
      "formatted_end": "02:01:57.000",
      "text": "آقایی افتیشی هایی کم عرضه شدن به احساس میکنه"
    },
    {
      "id": 43,
      "start": 7317.0,
      "end": 7319.0,
      "formatted_start": "02:01:57.000",
      "formatted_end": "02:01:59.000",
      "text": "از این حسابات بودید این حسابات خوب بود"
    },
    {
      "id": 44,
      "start": 7319.0,
      "end": 7321.0,
      "formatted_start": "02:01:59.000",
      "formatted_end": "02:02:01.000",
      "text": "این آب هر چه ملر و گرم باشه برای شما خوب بود"
    },
    {
      "id": 45,
      "start": 7321.0,
      "end": 7323.0,
      "formatted_start": "02:02:01.000",
      "formatted_end": "02:02:03.000",
      "text": "استفاده از داروهای گیاهی"
    },
    {
      "id": 46,
      "start": 7323.0,
      "end": 7325.0,
      "formatted_start": "02:02:03.000",
      "formatted_end": "02:02:05.000",
      "text": "مخصوصا زنجبی"
    },
    {
      "id": 47,
      "start": 7325.0,
      "end": 7327.0,
      "formatted_start": "02:02:05.000",
      "formatted_end": "02:02:07.000",
      "text": "بخواهم زیادش یک دفعه نه"
    },
    {
      "id": 48,
      "start": 7327.0,
      "end": 7329.0,
      "formatted_start": "02:02:07.000",
      "formatted_end": "02:02:09.000",
      "text": "بلکه منتظر طولهایی مقدار کم"
    },
    {
      "id": 49,
      "start": 7329.0,
      "end": 7331.0,
      "formatted_start": "02:02:09.000",
      "formatted_end": "02:02:11.000",
      "text": "بخواهم ارتعاف بزیر یک غزروف رو"
    },
    {
      "id": 50,
      "start": 7331.0,
      "end": 7333.0,
      "formatted_start": "02:02:11.000",
      "formatted_end": "02:02:13.000",
      "text": "خیلی بیشتر کنید"
    },
    {
      "id": 51,
      "start": 7333.0,
      "end": 7335.0,
      "formatted_start": "02:02:13.000",
      "formatted_end": "02:02:15.000",
      "text": "یک غزروف هر چه خوش بشه به اون نقا آسیب نیزه"
    },
    {
      "id": 52,
      "start": 7335.0,
      "end": 7337.0,
      "formatted_start": "02:02:15.000",
      "formatted_end": "02:02:17.000",
      "text": "هر چه نرم باشه"
    },
    {
      "id": 53,
      "start": 7337.0,
      "end": 7339.0,
      "formatted_start": "02:02:17.000",
      "formatted_end": "02:02:19.000",
      "text": "ازیادش کم بشه"
    },
    {
      "id": 54,
      "start": 7339.0,
      "end": 7350.0,
      "formatted_start": "02:02:19.000",
      "formatted_end": "02:02:30.000",
      "text": "در وسط چند تا چیز مثلا کمک نمیشه داروی هست هم بینیم سرنادین که مخصوص غزروف استش خیلی خیلی بهتر"
    },
    {
      "id": 55,
      "start": 7350.0,
      "end": 7356.0,
      "formatted_start": "02:02:30.000",
      "formatted_end": "02:02:36.000",
      "text": "سه روز اولش روزی دو بعد از سه روز روزی یکی بخوید تا یک ماه بسیار روز"
    },
    {
      "id": 56,
      "start": 7356.0,
      "end": 7360.0,
      "formatted_start": "02:02:36.000",
      "formatted_end": "02:02:40.000",
      "text": "ساده هم کامپل ماه بودیم در این خمشه بودیم"
    },
    {
      "id": 57,
      "start": 7360.0,
      "end": 7366.0,
      "formatted_start": "02:02:40.000",
      "formatted_end": "02:02:46.000",
      "text": "نه بله این غزروف سازه داره همون هم سی تا روزی دو تا تا سه روز بعد روزی یکی"
    },
    {
      "id": 58,
      "start": 7366.0,
      "end": 7372.0,
      "formatted_start": "02:02:46.000",
      "formatted_end": "02:02:52.000",
      "text": "این داروی احساسی. آن پر جهت تسکینه که این رو در صورت و سویس راحت تر بشید."
    },
    {
      "id": 59,
      "start": 7372.0,
      "end": 7377.0,
      "formatted_start": "02:02:52.000",
      "formatted_end": "02:02:57.000",
      "text": "مثلا باز امکان عودش هست. آن داروی با نقشه قضروف ساز رو داره."
    },
    {
      "id": 60,
      "start": 7377.0,
      "end": 7381.0,
      "formatted_start": "02:02:57.000",
      "formatted_end": "02:03:01.000",
      "text": "این قضروف هایی لحیده شده. خشک شده اینجور شده."
    },
    {
      "id": 61,
      "start": 7381.0,
      "end": 7386.0,
      "formatted_start": "02:03:01.000",
      "formatted_end": "02:03:06.000",
      "text": "اگر قضروف حالت ارتجایی خودش رو داشته باشه مثل عبر ممبور که فشار میده"
    },
    {
      "id": 62,
      "start": 7386.0,
      "end": 7390.0,
      "formatted_start": "02:03:06.000",
      "formatted_end": "02:03:10.000",
      "text": "ممبورهایی خوب فشار میده دست و دیده دیوار برمی کرده."
    },
    {
      "id": 63,
      "start": 7390.0,
      "end": 7396.0,
      "formatted_start": "02:03:10.000",
      "formatted_end": "02:03:16.000",
      "text": "ولی ممل هایی که خمیه شده فشار میدی، پردون چاله میمانه"
    },
    {
      "id": 64,
      "start": 7396.0,
      "end": 7400.0,
      "formatted_start": "02:03:16.000",
      "formatted_end": "02:03:20.000",
      "text": "آن چاله میمانه ممل عرضان برمته یا خرابه یا فلان"
    },
    {
      "id": 65,
      "start": 7400.0,
      "end": 7403.0,
      "formatted_start": "02:03:20.000",
      "formatted_end": "02:03:23.000",
      "text": "اون مملی که خوب باشه، دست برداشته فوری باید بیازه برد"
    },
    {
      "id": 66,
      "start": 7403.0,
      "end": 7406.0,
      "formatted_start": "02:03:23.000",
      "formatted_end": "02:03:26.000",
      "text": "یه نفر برداشت و نفر برداشته میشه، یه گاری چه کس نشست"
    },
    {
      "id": 67,
      "start": 7406.0,
      "end": 7411.0,
      "formatted_start": "02:03:26.000",
      "formatted_end": "02:03:31.000",
      "text": "این قدرت ارتجایی میگه، یعنی برگشت به حالت قبلی"
    },
    {
      "id": 68,
      "start": 7411.0,
      "end": 7413.0,
      "formatted_start": "02:03:31.000",
      "formatted_end": "02:03:33.000",
      "text": "این که باید تو برگشتش برداشت"
    },
    {
      "id": 69,
      "start": 7413.0,
      "end": 7415.0,
      "formatted_start": "02:03:33.000",
      "formatted_end": "02:03:35.000",
      "text": "این کار است که خودت ارتجاه کرده"
    },
    {
      "id": 70,
      "start": 7415.0,
      "end": 7417.0,
      "formatted_start": "02:03:35.000",
      "formatted_end": "02:03:37.000",
      "text": "خدا بهتون کمک کرده"
    },
    {
      "id": 71,
      "start": 7419.0,
      "end": 7421.0,
      "formatted_start": "02:03:39.000",
      "formatted_end": "02:03:41.000",
      "text": "میده از تو نورد بیست؟"
    },
    {
      "id": 72,
      "start": 7421.0,
      "end": 7423.0,
      "formatted_start": "02:03:41.000",
      "formatted_end": "02:03:43.000",
      "text": "نه میده فکرم خورم"
    },
    {
      "id": 73,
      "start": 7423.0,
      "end": 7425.0,
      "formatted_start": "02:03:43.000",
      "formatted_end": "02:03:45.000",
      "text": "برو تو برم"
    },
    {
      "id": 74,
      "start": 7425.0,
      "end": 7427.0,
      "formatted_start": "02:03:45.000",
      "formatted_end": "02:03:47.000",
      "text": "که اینجا کمک برم"
    },
    {
      "id": 75,
      "start": 7427.0,
      "end": 7429.0,
      "formatted_start": "02:03:47.000",
      "formatted_end": "02:03:49.000",
      "text": "اینجا بشین شو من بگم بشم"
    },
    {
      "id": 76,
      "start": 7437.0,
      "end": 7439.0,
      "formatted_start": "02:03:57.000",
      "formatted_end": "02:03:59.000",
      "text": "گردن بالا بکن"
    },
    {
      "id": 77,
      "start": 7439.0,
      "end": 7442.24,
      "formatted_start": "02:03:59.000",
      "formatted_end": "02:04:02.240",
      "text": "اوه، می‌کشه کامل می‌کشه"
    },
    {
      "id": 78,
      "start": 7442.24,
      "end": 7444.24,
      "formatted_start": "02:04:02.240",
      "formatted_end": "02:04:04.240",
      "text": "نرمشت برزش می‌کنه"
    },
    {
      "id": 79,
      "start": 7444.24,
      "end": 7447.24,
      "formatted_start": "02:04:04.240",
      "formatted_end": "02:04:07.240",
      "text": "کدوم پا تو می‌ریزه درمش؟"
    },
    {
      "id": 80,
      "start": 7447.24,
      "end": 7451.24,
      "formatted_start": "02:04:07.240",
      "formatted_end": "02:04:11.240",
      "text": "الان جلیلن، الان که اون‌بادن این‌جا دوتایش این‌جا رو دارن"
    },
    {
      "id": 81,
      "start": 7451.24,
      "end": 7453.24,
      "formatted_start": "02:04:11.240",
      "formatted_end": "02:04:13.240",
      "text": "دوتا دوتا"
    },
    {
      "id": 82,
      "start": 7453.24,
      "end": 7457.24,
      "formatted_start": "02:04:13.240",
      "formatted_end": "02:04:17.240",
      "text": "ولی توی این مدت، توی این ده سال، اصلا با پا هم نمی‌زنن"
    },
    {
      "id": 83,
      "start": 7457.24,
      "end": 7459.24,
      "formatted_start": "02:04:17.240",
      "formatted_end": "02:04:19.240",
      "text": "فقط این قسمت کمر می‌زنن"
    },
    {
      "id": 84,
      "start": 7459.24,
      "end": 7461.24,
      "formatted_start": "02:04:19.240",
      "formatted_end": "02:04:21.240",
      "text": "کمر، درست کنید"
    },
    {
      "id": 85,
      "start": 7461.24,
      "end": 7465.24,
      "formatted_start": "02:04:21.240",
      "formatted_end": "02:04:25.240",
      "text": "این‌ها همین دوتا همین‌که"
    },
    {
      "id": 86,
      "start": 7465.24,
      "end": 7467.24,
      "formatted_start": "02:04:25.240",
      "formatted_end": "02:04:27.240",
      "text": "برگره سیارتیکه"
    },
    {
      "id": 87,
      "start": 7467.24,
      "end": 7473.48,
      "formatted_start": "02:04:27.240",
      "formatted_end": "02:04:33.480",
      "text": "سیوتاش می‌دهند، هر دو تا می‌زند، بعد سیوتیت به هر دو می‌تونه بزنید، بعضی افتادا به یکی هست"
    },
    {
      "id": 88,
      "start": 7473.48,
      "end": 7476.28,
      "formatted_start": "02:04:33.480",
      "formatted_end": "02:04:36.280",
      "text": "به هر دو می‌زند، خب خفیف سیوتیت هست"
    },
    {
      "id": 89,
      "start": 7476.28,
      "end": 7479.28,
      "formatted_start": "02:04:36.280",
      "formatted_end": "02:04:39.280",
      "text": "چون پنج کم هستش"
    },
    {
      "id": 90,
      "start": 7481.28,
      "end": 7484.28,
      "formatted_start": "02:04:41.280",
      "formatted_end": "02:04:44.280",
      "text": "مکس مگلی فورد، سیوتیت"
    },
    {
      "id": 91,
      "start": 7486.28,
      "end": 7491.28,
      "formatted_start": "02:04:46.280",
      "formatted_end": "02:04:51.280",
      "text": "این شروعاندی خارجی هست، یک کمیم گرام، برای خیلی خاصیتش خوب"
    },
    {
      "id": 92,
      "start": 7491.28,
      "end": 7493.28,
      "formatted_start": "02:04:51.280",
      "formatted_end": "02:04:53.280",
      "text": "این پولینام دادم استفاده کنیم"
    },
    {
      "id": 93,
      "start": 7493.28,
      "end": 7497.28,
      "formatted_start": "02:04:53.280",
      "formatted_end": "02:04:57.280",
      "text": "پا مادم هست که بولی کمر به نام آرومیس میزنیم"
    },
    {
      "id": 94,
      "start": 7497.28,
      "end": 7500.28,
      "formatted_start": "02:04:57.280",
      "formatted_end": "02:05:00.280",
      "text": "که هم مستقل زیر"
    }
  ],
  "status": "completed"
}