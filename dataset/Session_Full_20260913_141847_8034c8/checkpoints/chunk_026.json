  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7802.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:02.000",
      "text": "دستاتو داریم؟"
    },
    {
      "id": 1,
      "start": 7802.0,
      "end": 7802.5,
      "formatted_start": "02:10:02.000",
      "formatted_end": "02:10:02.500",
      "text": "بله؟"
    },
    {
      "id": 2,
      "start": 7802.5,
      "end": 7804.0,
      "formatted_start": "02:10:02.500",
      "formatted_end": "02:10:04.000",
      "text": "دستاتو داریم؟"
    },
    {
      "id": 3,
      "start": 7804.0,
      "end": 7806.0,
      "formatted_start": "02:10:04.000",
      "formatted_end": "02:10:06.000",
      "text": "دارم، دارم."
    },
    {
      "id": 4,
      "start": 7806.0,
      "end": 7836.0,
      "formatted_start": "02:10:06.000",
      "formatted_end": "02:10:36.000",
      "text": "بسیار خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 5,
      "start": 7836.0,
      "end": 7840.0,
      "formatted_start": "02:10:36.000",
      "formatted_end": "02:10:40.000",
      "text": "این بود هرق کاستی باش کنید"
    },
    {
      "id": 6,
      "start": 7840.0,
      "end": 7842.0,
      "formatted_start": "02:10:40.000",
      "formatted_end": "02:10:42.000",
      "text": "هرق کاستی؟"
    },
    {
      "id": 7,
      "start": 7842.0,
      "end": 7846.0,
      "formatted_start": "02:10:42.000",
      "formatted_end": "02:10:46.000",
      "text": "زنجبی و هرق کاستی"
    },
    {
      "id": 8,
      "start": 7854.0,
      "end": 7856.0,
      "formatted_start": "02:10:54.000",
      "formatted_end": "02:10:56.000",
      "text": "چبا؟"
    },
    {
      "id": 9,
      "start": 7861.0,
      "end": 7865.0,
      "formatted_start": "02:11:01.000",
      "formatted_end": "02:11:05.000",
      "text": "اینجا من باشم که شما جلوشتو بگیری خاموش کنید"
    },
    {
      "id": 10,
      "start": 7866.0,
      "end": 7896.0,
      "formatted_start": "02:11:06.000",
      "formatted_end": "02:11:36.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 11,
      "start": 7896.0,
      "end": 7898.0,
      "formatted_start": "02:11:36.000",
      "formatted_end": "02:11:38.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 12,
      "start": 7898.0,
      "end": 7900.0,
      "formatted_start": "02:11:38.000",
      "formatted_end": "02:11:40.000",
      "text": "که کمی سال های این سال را شده شده شده؟"
    },
    {
      "id": 13,
      "start": 7900.0,
      "end": 7902.0,
      "formatted_start": "02:11:40.000",
      "formatted_end": "02:11:42.000",
      "text": "آره."
    },
    {
      "id": 14,
      "start": 7902.0,
      "end": 7904.0,
      "formatted_start": "02:11:42.000",
      "formatted_end": "02:11:44.000",
      "text": "این خیلی خوبه."
    },
    {
      "id": 15,
      "start": 7904.0,
      "end": 7906.0,
      "formatted_start": "02:11:44.000",
      "formatted_end": "02:11:46.000",
      "text": "این بیزه فروز هست."
    },
    {
      "id": 16,
      "start": 7906.0,
      "end": 7908.0,
      "formatted_start": "02:11:46.000",
      "formatted_end": "02:11:48.000",
      "text": "بیزه فروز و دولی."
    },
    {
      "id": 17,
      "start": 7908.0,
      "end": 7910.0,
      "formatted_start": "02:11:48.000",
      "formatted_end": "02:11:50.000",
      "text": "این همه چیزی در اینجا بشه."
    },
    {
      "id": 18,
      "start": 7910.0,
      "end": 7912.0,
      "formatted_start": "02:11:50.000",
      "formatted_end": "02:11:52.000",
      "text": "نیاز نیست باید بشه؟"
    },
    {
      "id": 19,
      "start": 7912.0,
      "end": 7914.0,
      "formatted_start": "02:11:52.000",
      "formatted_end": "02:11:54.000",
      "text": "نیست."
    },
    {
      "id": 20,
      "start": 7914.0,
      "end": 7916.0,
      "formatted_start": "02:11:54.000",
      "formatted_end": "02:11:56.000",
      "text": "از اینجا بشه."
    },
    {
      "id": 21,
      "start": 7916.0,
      "end": 7918.0,
      "formatted_start": "02:11:56.000",
      "formatted_end": "02:11:58.000",
      "text": "در اینجا بشه؟"
    },
    {
      "id": 22,
      "start": 7918.0,
      "end": 7920.0,
      "formatted_start": "02:11:58.000",
      "formatted_end": "02:12:00.000",
