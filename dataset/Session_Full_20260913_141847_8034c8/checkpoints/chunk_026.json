      "text": "از اینجا بشه."
    },
    {
      "id": 25,
      "start": 7924.0,
      "end": 7926.0,
      "formatted_start": "02:12:04.000",
      "formatted_end": "02:12:06.000",
      "text": "برنامه خوب خواهید بگیم"
    },
    {
      "id": 26,
      "start": 7926.0,
      "end": 7928.0,
      "formatted_start": "02:12:06.000",
      "formatted_end": "02:12:08.000",
      "text": "کجا شادمنی شما؟"
    },
    {
      "id": 27,
      "start": 7928.0,
      "end": 7930.0,
      "formatted_start": "02:12:08.000",
      "formatted_end": "02:12:10.000",
      "text": "برنامه دست هسته چار روی خیلی ها"
    },
    {
      "id": 28,
      "start": 7930.0,
      "end": 7932.0,
      "formatted_start": "02:12:10.000",
      "formatted_end": "02:12:12.000",
      "text": "آقای دکتور شادمند خوبه"
    },
    {
      "id": 29,
      "start": 7932.0,
      "end": 7934.0,
      "formatted_start": "02:12:12.000",
      "formatted_end": "02:12:14.000",
      "text": "کجاست؟"
    },
    {
      "id": 30,
      "start": 7934.0,
