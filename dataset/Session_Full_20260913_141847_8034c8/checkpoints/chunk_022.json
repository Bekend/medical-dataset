      "formatted_start": "01:51:14.000",
      "formatted_end": "01:51:16.000",
      "text": "باید از صبح"
    },
    {
      "id": 20,
      "start": 6676.0,
      "end": 6678.0,
      "formatted_start": "01:51:16.000",
      "formatted_end": "01:51:18.000",
      "text": "بسرم برم بیرون از شویه"
    },
    {
      "id": 21,
      "start": 6678.0,
      "end": 6680.0,
      "formatted_start": "01:51:18.000",
      "formatted_end": "01:51:20.000",
      "text": "بعد"
    },
    {
      "id": 22,
      "start": 6680.0,
      "end": 6682.0,
      "formatted_start": "01:51:20.000",
      "formatted_end": "01:51:22.000",
      "text": "بسرم"
    },
    {
      "id": 23,
      "start": 6682.0,
      "end": 6684.0,
      "formatted_start": "01:51:22.000",
      "formatted_end": "01:51:24.000",
      "text": "یک لک خونه برم"
    },
    {
      "id": 24,
      "start": 6684.0,
      "end": 6686.0,
      "formatted_start": "01:51:24.000",
      "formatted_end": "01:51:26.000",
      "text": "باید شهر مرسن بیریم"
    },
    {
      "id": 25,
      "start": 6686.0,
      "end": 6688.0,
      "formatted_start": "01:51:26.000",
      "formatted_end": "01:51:28.000",
      "text": "برای چی هایی دفتار؟"
    },
    {
      "id": 26,
      "start": 6688.0,
      "end": 6690.0,
      "formatted_start": "01:51:28.000",
      "formatted_end": "01:51:30.000",
      "text": "سنگوز ماس دفت گرده"
    },
    {
      "id": 27,
      "start": 6690.0,
      "end": 6692.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:32.000",
      "text": "از آنها"
    },
    {
      "id": 28,
      "start": 6692.0,
      "end": 6694.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:34.000",
      "text": "این چیزی نمیشد"
    },
    {
      "id": 29,
      "start": 6694.0,
      "end": 6696.0,
      "formatted_start": "01:51:34.000",
      "formatted_end": "01:51:36.000",
      "text": "دفت شده"
    },
    {
      "id": 30,
      "start": 6696.0,
      "end": 6698.0,
      "formatted_start": "01:51:36.000",
      "formatted_end": "01:51:38.000",
      "text": "یعنی دفت شده برای من"
    },
    {
      "id": 31,
      "start": 6698.0,
      "end": 6700.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:40.000",
      "text": "نه همه ش دفت نمیشه"
    },
    {
      "id": 32,
      "start": 6700.0,
      "end": 6702.0,
      "formatted_start": "01:51:40.000",
      "formatted_end": "01:51:42.000",
      "text": "یه ذره ذره درد بخواد"
    },
    {
      "id": 33,
      "start": 6702.0,
      "end": 6704.0,
      "formatted_start": "01:51:42.000",
      "formatted_end": "01:51:44.000",
      "text": "درد وحشتناک"
    },
    {
      "id": 34,
      "start": 6704.0,
      "end": 6706.0,
      "formatted_start": "01:51:44.000",
      "formatted_end": "01:51:46.000",
      "text": "ماس های ریز دفت میشه اینجور"
    },
    {
      "id": 35,
      "start": 6706.0,
      "end": 6708.0,
      "formatted_start": "01:51:46.000",
      "formatted_end": "01:51:48.000",
      "text": "بیاده داشت"
    },
    {
      "id": 36,
      "start": 6708.0,
      "end": 6710.0,
      "formatted_start": "01:51:48.000",
      "formatted_end": "01:51:50.000",
      "text": "درد تو نوا"
    },
    {
      "id": 37,
      "start": 6710.0,
      "end": 6712.0,
      "formatted_start": "01:51:50.000",
      "formatted_end": "01:51:52.000",
      "text": "به اضافه یه"
    },
    {
      "id": 38,
      "start": 6712.0,
      "end": 6714.0,
      "formatted_start": "01:51:52.000",
      "formatted_end": "01:51:54.000",
      "text": "چیه؟ ترسید"
    },
    {
      "id": 39,
      "start": 6714.0,
      "end": 6716.0,
      "formatted_start": "01:51:54.000",
      "formatted_end": "01:51:56.000",
      "text": "مردم کنه چیزی نوازه بیشتر بیشتر بیشتر بیشتر"
    },
    {
      "id": 40,
      "start": 6716.0,
      "end": 6719.0,
      "formatted_start": "01:51:56.000",
      "formatted_end": "01:51:59.000",
      "text": "نه شده داریه این مجرای دار"
    },
    {
      "id": 41,
      "start": 6719.0,
      "end": 6723.0,
      "formatted_start": "01:51:59.000",
      "formatted_end": "01:52:03.000",
      "text": "ماسه های تیز که دفت میشه با خودش یه ذره خونیه باشه"
    },
    {
      "id": 42,
      "start": 6723.0,
      "end": 6724.0,
      "formatted_start": "01:52:03.000",
      "formatted_end": "01:52:04.000",
      "text": "اوه نه"
    },
    {
      "id": 43,
      "start": 6724.0,
      "end": 6725.0,
      "formatted_start": "01:52:04.000",
      "formatted_end": "01:52:05.000",
      "text": "چیزی"
    },
    {
      "id": 44,
      "start": 6725.0,
      "end": 6727.0,
      "formatted_start": "01:52:05.000",
      "formatted_end": "01:52:07.000",
      "text": "یه داشته بیشتر بیشتر بیشتر"
    },
    {
      "id": 45,
      "start": 6729.0,
      "end": 6731.0,
      "formatted_start": "01:52:09.000",
      "formatted_end": "01:52:11.000",
      "text": "سونوگرافی هم بگیر و"
    },
    {
      "id": 46,
      "start": 6735.0,
      "end": 6737.0,
      "formatted_start": "01:52:15.000",
      "formatted_end": "01:52:17.000",
      "text": "دارو میشتر بره؟"
    },
    {
      "id": 47,
      "start": 6737.0,
      "end": 6739.0,
      "formatted_start": "01:52:17.000",
      "formatted_end": "01:52:19.000",
      "text": "اه دارو بره"
    },
    {
      "id": 48,
      "start": 6741.0,
      "end": 6743.0,
      "formatted_start": "01:52:21.000",
      "formatted_end": "01:52:23.000",
      "text": "سونوگرافی هم بشه"
    },
    {
      "id": 49,
      "start": 6743.0,
      "end": 6773.0,
      "formatted_start": "01:52:23.000",
      "formatted_end": "01:52:53.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 50,
      "start": 6773.0,
      "end": 6775.52,
      "formatted_start": "01:52:53.000",
      "formatted_end": "01:52:55.520",
      "text": "در بیتر کمانه همه آسی کرده"
    },
    {
      "id": 51,
      "start": 6782.32,
      "end": 6783.32,
      "formatted_start": "01:53:02.320",
      "formatted_end": "01:53:03.320",
      "text": "بابایی بود؟"
    },
    {
      "id": 52,
      "start": 6783.32,
      "end": 6785.0,
      "formatted_start": "01:53:03.320",
      "formatted_end": "01:53:05.000",
      "text": "نه دوست خیلی همه"
    },
    {
      "id": 53,
      "start": 6785.0,
      "end": 6788.28,
      "formatted_start": "01:53:05.000",
      "formatted_end": "01:53:08.280",
      "text": "کام نوعی بود های دوست ها که پیگمنت ها بهش نداده بودن"
    },
    {
      "id": 54,
      "start": 6788.28,
      "end": 6791.0,
      "formatted_start": "01:53:08.280",
      "formatted_end": "01:53:11.000",
      "text": "وقتی باید پیگمنت ها رو برفته این دوتا هاییه"
    },
    {
      "id": 55,
      "start": 6791.0,
      "end": 6791.72,
      "formatted_start": "01:53:11.000",
      "formatted_end": "01:53:11.720",
      "text": "مثل این دوست هاییه"
    },
    {
      "id": 56,
      "start": 6791.72,
      "end": 6793.0,
      "formatted_start": "01:53:11.720",
      "formatted_end": "01:53:13.000",
      "text": "این به جای پیگمنت ها دادن؟"
    },
    {
      "id": 57,
      "start": 6793.0,
      "end": 6795.4,
      "formatted_start": "01:53:13.000",
      "formatted_end": "01:53:15.400",
      "text": "نه، پیگمنت ها رو هم برفته"
    },
    {
      "id": 58,
      "start": 6795.4,
      "end": 6797.4,
      "formatted_start": "01:53:15.400",
      "formatted_end": "01:53:17.400",
      "text": "این دوتا هاییه"
    },
    {
      "id": 59,
      "start": 6797.4,
      "end": 6798.4,
      "formatted_start": "01:53:17.400",
      "formatted_end": "01:53:18.400",
      "text": "میگه چیزی از دارو خواهد دادن"
    },
    {
      "id": 60,
      "start": 6798.4,
      "end": 6799.4,
      "formatted_start": "01:53:18.400",
      "formatted_end": "01:53:19.400",
      "text": "این دوتا هاییه؟"
    },
    {
      "id": 61,
      "start": 6799.4,
      "end": 6800.4,
      "formatted_start": "01:53:19.400",
      "formatted_end": "01:53:20.400",
      "text": "از دارو خواهد دادن"
    },
    {
      "id": 62,
      "start": 6800.4,
      "end": 6802.4,
      "formatted_start": "01:53:20.400",
      "formatted_end": "01:53:22.400",
      "text": "این روش نکردن"
    },
    {
      "id": 63,
      "start": 6802.4,
      "end": 6806.4,
      "formatted_start": "01:53:22.400",
      "formatted_end": "01:53:26.400",
      "text": "این روش شب و این روش موزه"
    },
    {
      "id": 64,
      "start": 6810.4,
      "end": 6812.4,
      "formatted_start": "01:53:30.400",
      "formatted_end": "01:53:32.400",
      "text": "این نایت"
    },
    {
      "id": 65,
      "start": 6812.4,
      "end": 6814.4,
      "formatted_start": "01:53:32.400",
      "formatted_end": "01:53:34.400",
      "text": "این شب"
    },
    {
      "id": 66,
      "start": 6814.4,
      "end": 6816.4,
      "formatted_start": "01:53:34.400",
      "formatted_end": "01:53:36.400",
      "text": "و این روش"
    },
    {
      "id": 67,
      "start": 6816.4,
      "end": 6818.4,
      "formatted_start": "01:53:36.400",
      "formatted_end": "01:53:38.400",
      "text": "و باز برده"
    },
    {
      "id": 68,
      "start": 6820.4,
      "end": 6822.4,
      "formatted_start": "01:53:40.400",
      "formatted_end": "01:53:42.400",
      "text": "اینجوری میکنن و باز پیشه یه داره میپیچنن"
    },
    {
      "id": 69,
      "start": 6822.4,
      "end": 6825.4,
      "formatted_start": "01:53:42.400",
      "formatted_end": "01:53:45.400",
      "text": "چونن میاد بیرون، باید بسیار سپریم کنن"
    },
    {
      "id": 70,
      "start": 6825.4,
      "end": 6827.4,
      "formatted_start": "01:53:45.400",
      "formatted_end": "01:53:47.400",
      "text": "اما باز دوران اینجور بیشون نمیدونید"
    },
    {
      "id": 71,
      "start": 6827.4,
      "end": 6829.4,
      "formatted_start": "01:53:47.400",
      "formatted_end": "01:53:49.400",
      "text": "بسایی اینجور بشه بسایی اینجور بشه بشه"
    },
    {
      "id": 72,
      "start": 6829.4,
      "end": 6832.4,
      "formatted_start": "01:53:49.400",
      "formatted_end": "01:53:52.400",
      "text": "نه، بسایی همینجور برجست کن و بشه بیده"
    },
    {
      "id": 73,
      "start": 6832.4,
      "end": 6834.4,
      "formatted_start": "01:53:52.400",
      "formatted_end": "01:53:54.400",
      "text": "اونجور بیشون"
    },
    {
      "id": 74,
      "start": 6834.4,
      "end": 6836.4,
      "formatted_start": "01:53:54.400",
      "formatted_end": "01:53:56.400",
      "text": "اونجور چه بود؟"
    },
    {
      "id": 75,
      "start": 6836.4,
      "end": 6838.4,
      "formatted_start": "01:53:56.400",
      "formatted_end": "01:53:58.400",
      "text": "این، نه این"
    },
    {
      "id": 76,
      "start": 6838.4,
      "end": 6841.4,
      "formatted_start": "01:53:58.400",
      "formatted_end": "01:54:01.400",
      "text": "یه پنجه سبب کنیم"
    },
    {
      "id": 77,
      "start": 6841.4,
      "end": 6843.4,
      "formatted_start": "01:54:01.400",
      "formatted_end": "01:54:03.400",
      "text": "اینجور بشه بشه بشه"
    },
    {
      "id": 78,
      "start": 6843.4,
      "end": 6846.4,
      "formatted_start": "01:54:03.400",
      "formatted_end": "01:54:06.400",
      "text": "اینجور بشه بشه"
    },
    {
      "id": 79,
      "start": 6846.4,
      "end": 6849.4,
      "formatted_start": "01:54:06.400",
      "formatted_end": "01:54:09.400",
      "text": "این یکم قریب خیلی دلیلیشم خودش هست آمدید"
    },
    {
      "id": 80,
      "start": 6849.4,
      "end": 6854.4,
      "formatted_start": "01:54:09.400",
      "formatted_end": "01:54:14.400",
      "text": "بعد این دیسکتونه دو تا از دیسکتونه رو رفته به دخواه پشا رو میاد"
    },
    {
      "id": 81,
      "start": 6860.4,
      "end": 6862.4,
      "formatted_start": "01:54:20.400",
      "formatted_end": "01:54:22.400",
      "text": "دو تا یکیه؟"
    },
    {
      "id": 82,
      "start": 6862.4,
      "end": 6868.4,
      "formatted_start": "01:54:22.400",
      "formatted_end": "01:54:28.400",
      "text": "نه این گریه تره، اون قریب تره آره اونو یکیه ولی داخلش همین چند مرخوش کرده"
    },
    {
      "id": 83,
      "start": 6868.4,
      "end": 6870.4,
      "formatted_start": "01:54:28.400",
      "formatted_end": "01:54:30.400",
      "text": "خیلی گریه ده اکسی با خیلی"
    },
    {
      "id": 84,
      "start": 6870.4,
      "end": 6872.4,
      "formatted_start": "01:54:30.400",
      "formatted_end": "01:54:32.400",
      "text": "باز قیل از این در یه چند مرخوش"
    },
    {
      "id": 85,
      "start": 6872.4,
      "end": 6877.4,
      "formatted_start": "01:54:32.400",
      "formatted_end": "01:54:37.400",
      "text": "داخل همونه گریه تره اینش داخل با همونه یه ماه پیشه"
    },
    {
      "id": 86,
      "start": 6879.4,
      "end": 6885.4,
      "formatted_start": "01:54:39.400",
      "formatted_end": "01:54:45.400",
      "text": "اینجا می‌گیم، پفسیره، خودعکس نیست، پفسیره"
    },
    {
      "id": 87,
      "start": 6886.4,
      "end": 6891.4,
      "formatted_start": "01:54:46.400",
      "formatted_end": "01:54:51.400",
      "text": "این CD داره، این رو بگیرن نمی‌گنیم، برم نامنشونیم"
    },
    {
      "id": 88,
      "start": 6891.4,
      "end": 6899.4,
      "formatted_start": "01:54:51.400",
      "formatted_end": "01:54:59.400",
      "text": "رایت که یای بعده، 3، 4، فشردگی تقریب کانال گفته داره، 4، 5، چکنه کنیم"
    }
  ],
  "status": "completed"
}