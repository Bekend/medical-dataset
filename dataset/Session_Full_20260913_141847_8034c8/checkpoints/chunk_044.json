  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13205.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:05.000",
      "text": "این مکی کریموکریزه، پوستای چی بود؟"
    },
    {
      "id": 1,
      "start": 13205.0,
      "end": 13212.0,
      "formatted_start": "03:40:05.000",
      "formatted_end": "03:40:12.000",
      "text": "پوستای شرب و مستعد جوش بود، سرس بود. اون داخلش زین پی سی ایل داشت و تیتری آیل داشت."
    },
    {
      "id": 2,
      "start": 13212.0,
      "end": 13216.0,
      "formatted_start": "03:40:12.000",
      "formatted_end": "03:40:16.000",
      "text": "دانشگرم بود، ساموس و برنج دارد."
    },
    {
      "id": 3,
      "start": 13216.0,
      "end": 13229.0,
      "formatted_start": "03:40:16.000",
      "formatted_end": "03:40:29.000",
      "text": "این همه دو کسی رو میشه نمیشه."
    },
    {
      "id": 4,
      "start": 13229.0,
      "end": 13231.0,
      "formatted_start": "03:40:29.000",
      "formatted_end": "03:40:31.000",
      "text": "اینجا باید باید بشه"
    },
    {
      "id": 5,
      "start": 13231.0,
      "end": 13233.0,
      "formatted_start": "03:40:31.000",
      "formatted_end": "03:40:33.000",
      "text": "چرا باید بشه؟"
    },
    {
      "id": 6,
      "start": 13233.0,
      "end": 13235.0,
      "formatted_start": "03:40:33.000",
      "formatted_end": "03:40:35.000",
      "text": "چون قیده ساهمانیه نه فیاج را تغییر میده"
    },
    {
      "id": 7,
      "start": 13235.0,
      "end": 13237.0,
      "formatted_start": "03:40:35.000",
      "formatted_end": "03:40:37.000",
      "text": "نه چربی نفید را از بین میبره"
    },
    {
      "id": 8,
      "start": 13237.0,
      "end": 13239.0,
      "formatted_start": "03:40:37.000",
      "formatted_end": "03:40:39.000",
      "text": "نه صد دفاعی را تقریب می کنه"
    },
    {
      "id": 9,
      "start": 13239.0,
      "end": 13241.0,
      "formatted_start": "03:40:39.000",
      "formatted_end": "03:40:41.000",
      "text": "مثلا خودتون برای استفاده ای بزنه"
    },
    {
      "id": 10,
      "start": 13241.0,
      "end": 13243.0,
      "formatted_start": "03:40:41.000",
      "formatted_end": "03:40:43.000",
      "text": "حل مهایی هست"
    },
    {
      "id": 11,
      "start": 13243.0,
      "end": 13245.0,
      "formatted_start": "03:40:43.000",
      "formatted_end": "03:40:45.000",
      "text": "آهان"
    },
    {
      "id": 12,
      "start": 13245.0,
      "end": 13247.0,
      "formatted_start": "03:40:45.000",
      "formatted_end": "03:40:47.000",
      "text": "در طور روز میخوایید چندین بار دستاتون را بشورید"
    },
    {
      "id": 13,
      "start": 13247.0,
      "end": 13249.0,
      "formatted_start": "03:40:47.000",
      "formatted_end": "03:40:49.000",
      "text": "این واقعا خوبه"
    },
    {
      "id": 14,
      "start": 13249.0,
      "end": 13251.0,
      "formatted_start": "03:40:49.000",
      "formatted_end": "03:40:51.000",
      "text": "برای صورت هم واقع استفاده است"
    },
    {
      "id": 15,
      "start": 13251.0,
      "end": 13253.0,
      "formatted_start": "03:40:51.000",
      "formatted_end": "03:40:53.000",
      "text": "برای اینکه هم خوش خوش شده"
    },
    {
      "id": 16,
      "start": 13253.0,
      "end": 13255.0,
      "formatted_start": "03:40:53.000",
      "formatted_end": "03:40:55.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 17,
      "start": 13255.0,
      "end": 13257.0,
      "formatted_start": "03:40:55.000",
      "formatted_end": "03:40:57.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 18,
      "start": 13257.0,
      "end": 13259.0,
      "formatted_start": "03:40:57.000",
      "formatted_end": "03:40:59.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 19,
      "start": 13259.0,
      "end": 13261.0,
      "formatted_start": "03:40:59.000",
      "formatted_end": "03:41:01.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 20,
      "start": 13261.0,
      "end": 13263.0,
      "formatted_start": "03:41:01.000",
      "formatted_end": "03:41:03.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 21,
      "start": 13263.0,
      "end": 13265.0,
      "formatted_start": "03:41:03.000",
      "formatted_end": "03:41:05.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 22,
      "start": 13265.0,
      "end": 13267.0,
      "formatted_start": "03:41:05.000",
      "formatted_end": "03:41:07.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 23,
      "start": 13267.0,
      "end": 13269.0,
      "formatted_start": "03:41:07.000",
      "formatted_end": "03:41:09.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 24,
      "start": 13269.0,
      "end": 13271.0,
      "formatted_start": "03:41:09.000",
      "formatted_end": "03:41:11.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 25,
      "start": 13271.0,
      "end": 13273.0,
      "formatted_start": "03:41:11.000",
      "formatted_end": "03:41:13.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 26,
      "start": 13273.0,
      "end": 13275.0,
      "formatted_start": "03:41:13.000",
      "formatted_end": "03:41:15.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 27,
      "start": 13275.0,
      "end": 13277.0,
      "formatted_start": "03:41:15.000",
      "formatted_end": "03:41:17.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 28,
      "start": 13277.0,
      "end": 13279.0,
      "formatted_start": "03:41:17.000",
      "formatted_end": "03:41:19.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 29,
      "start": 13279.0,
      "end": 13281.0,
      "formatted_start": "03:41:19.000",
      "formatted_end": "03:41:21.000",
      "text": "این افتخار مناسب است."
    },
    {
      "id": 30,
      "start": 13281.0,
      "end": 13293.0,
      "formatted_start": "03:41:21.000",
      "formatted_end": "03:41:33.000",
      "text": "این افرانس های شکمی که اومده اصابه سر راه و درز و اینا همونم میرن و میگن دو میلیون و خونصد رو روزهای عادی هستن"
    },
    {
      "id": 31,
      "start": 13293.0,
      "end": 13300.0,
      "formatted_start": "03:41:33.000",
      "formatted_end": "03:41:40.000",
      "text": "برقیل خودمون جلسه محشم میکنه وقتی مریض میاد میخواد داروهاش و ضروریهاش رو برداره کمش کنه"
    },
    {
      "id": 32,
      "start": 13300.0,
      "end": 13306.0,
      "formatted_start": "03:41:40.000",
      "formatted_end": "03:41:46.000",
      "text": "این ایسه برام پوستی من نمیدونستم یه روز دو تا سه تا رفتم بدون پوستی برگشتم"
    },
    {
      "id": 33,
      "start": 13306.0,
      "end": 13309.0,
      "formatted_start": "03:41:46.000",
      "formatted_end": "03:41:49.000",
      "text": "میگه پوستی من توانم به پوستی نمیرسیم"
    },
    {
      "id": 34,
      "start": 13309.0,
      "end": 13311.0,
      "formatted_start": "03:41:49.000",
      "formatted_end": "03:41:51.000",
      "text": "این راست شما برداریم"
    },
    {
      "id": 35,
      "start": 13311.0,
      "end": 13313.0,
      "formatted_start": "03:41:51.000",
      "formatted_end": "03:41:53.000",
      "text": "با اطلاع اگر محبت دارید"
    },
    {
      "id": 36,
      "start": 13313.0,
      "end": 13315.0,
      "formatted_start": "03:41:53.000",
      "formatted_end": "03:41:55.000",
      "text": "مثل هر شروط شما محبت دارید همیشه"
    },
    {
      "id": 37,
      "start": 13315.0,
      "end": 13317.0,
      "formatted_start": "03:41:55.000",
      "formatted_end": "03:41:57.000",
      "text": "ممنونم"
    },
    {
      "id": 38,
      "start": 13317.0,
      "end": 13319.0,
      "formatted_start": "03:41:57.000",
      "formatted_end": "03:41:59.000",
      "text": "خدا باشم"
    },
    {
      "id": 39,
      "start": 13319.0,
      "end": 13321.0,
      "formatted_start": "03:41:59.000",
      "formatted_end": "03:42:01.000",
      "text": "مردم ورده سلام"
    },
    {
      "id": 40,
      "start": 13321.0,
      "end": 13323.0,
      "formatted_start": "03:42:01.000",
      "formatted_end": "03:42:03.000",
      "text": "احوال شما حالتون چطوره؟"
    },
    {
      "id": 41,
      "start": 13323.0,
      "end": 13327.0,
      "formatted_start": "03:42:03.000",
      "formatted_end": "03:42:07.000",
      "text": "این خورپونه در خدمتون است همچنان"
    },
    {
      "id": 42,
      "start": 13327.0,
      "end": 13329.0,
      "formatted_start": "03:42:07.000",
      "formatted_end": "03:42:09.000",
      "text": "هم بفرمید"
    },
    {
      "id": 43,
      "start": 13329.0,
      "end": 13331.0,
      "formatted_start": "03:42:09.000",
      "formatted_end": "03:42:11.000",
      "text": "بردید"
    },
    {
      "id": 44,
      "start": 13331.0,
      "end": 13333.0,
      "formatted_start": "03:42:11.000",
      "formatted_end": "03:42:13.000",
      "text": "بردید"
    },
    {
      "id": 45,
      "start": 13333.0,
      "end": 13335.0,
      "formatted_start": "03:42:13.000",
      "formatted_end": "03:42:15.000",
      "text": "بردید"
    },
    {
      "id": 46,
      "start": 13335.0,
      "end": 13337.0,
      "formatted_start": "03:42:15.000",
      "formatted_end": "03:42:17.000",
      "text": "بردید"
    },
    {
      "id": 47,
      "start": 13337.0,
      "end": 13339.0,
      "formatted_start": "03:42:17.000",
      "formatted_end": "03:42:19.000",
      "text": "کجا؟"
    },
    {
      "id": 48,
      "start": 13357.0,
      "end": 13359.0,
      "formatted_start": "03:42:37.000",
      "formatted_end": "03:42:39.000",
      "text": "گرگان"
    },
    {
      "id": 49,
      "start": 13359.0,
      "end": 13366.0,
      "formatted_start": "03:42:39.000",
      "formatted_end": "03:42:46.000",
      "text": "اولا پنج شبه متب به شهرستانها دایره، گرگان یه مفهوم تحتیلن، آره"
    },
    {
      "id": 50,
      "start": 13366.0,
      "end": 13373.0,
      "formatted_start": "03:42:46.000",
      "formatted_end": "03:42:53.000",
      "text": "پنج شبه ها متب گازه، متاسفانه تا گرگان هم برسید، ده باید بردیم"
    },
    {
      "id": 51,
      "start": 13373.0,
      "end": 13381.0,
      "formatted_start": "03:42:53.000",
      "formatted_end": "03:43:01.000",
      "text": "آهه، بله بله، بذار با تون هم، تاره دیگه رو محفظ بکنی، بله"
    },
    {
      "id": 52,
      "start": 13381.0,
      "end": 13384.0,
      "formatted_start": "03:43:01.000",
      "formatted_end": "03:43:04.000",
      "text": "این برای لاین چرمی خون هست نام؟"
    },
    {
      "id": 53,
      "start": 13384.0,
      "end": 13406.0,
      "formatted_start": "03:43:04.000",
      "formatted_end": "03:43:26.000",
      "text": "موسیقی"
    },
    {
      "id": 54,
      "start": 13406.0,
      "end": 13425.0,
      "formatted_start": "03:43:26.000",
      "formatted_end": "03:43:45.000",
      "text": "مونوکولونال آنتیپادی از ازد مایک رو اضافه کردن به روزوستاتین خیلی هم زهف میده و این زبان که مصرف دارن می کنن بعد از مثلا آنجویو کلاستی و اونها استفاده می کنن خیلی زهف میده و این راهکارهایی برای زهفشون دارن"
    },
    {
      "id": 55,
      "start": 13425.0,
      "end": 13440.0,
      "formatted_start": "03:43:45.000",
      "formatted_end": "03:44:00.000",
      "text": "یک بار همین گرگان مطبخ شده از ساری آگذبود این فوقتخصوص قلب قیلی از متاوریکا بود"
    },
    {
      "id": 56,
      "start": 13440.0,
      "end": 13447.0,
      "formatted_start": "03:44:00.000",
      "formatted_end": "03:44:07.000",
      "text": "و بعد می گفتند که باید حتما اردیل را بیاریم زیر قلبی، یک فوقتخصوص قلب رفیلی بود از ساری"
    },
    {
      "id": 57,
      "start": 13447.0,
      "end": 13459.0,
      "formatted_start": "03:44:07.000",
      "formatted_end": "03:44:19.000",
      "text": "ما می‌کنیم دیلیل باید بیاریم زیر هفتاد و من یک اعتراضی کردم بهشون که قایدان قلبی رو می‌گن و تو شخصیشون اومد به نظر نیست"
    },
    {
      "id": 58,
      "start": 13459.0,
      "end": 13475.0,
      "formatted_start": "03:44:19.000",
      "formatted_end": "03:44:35.000",
      "text": "قایدان اون قلب برای جهت اعتراض خود رو دارن می‌گن که من که نمی‌آم سمینام اما قلبی‌ها که تا باید قلب متقیبن هست که باید دیلیل رو زیر هفتاد بیاریم و اشتیال ما با بالا باشه دیگه"
    },
    {
      "id": 59,
      "start": 13475.0,
      "end": 13477.0,
      "formatted_start": "03:44:35.000",
      "formatted_end": "03:44:37.000",
      "text": "الدیلن زیر هفتاد بید"
    },
    {
      "id": 60,
      "start": 13477.0,
      "end": 13479.0,
      "formatted_start": "03:44:37.000",
      "formatted_end": "03:44:39.000",
      "text": "الدیلن زیر هفتاد"
    },
    {
      "id": 61,
      "start": 13479.0,
      "end": 13481.0,
      "formatted_start": "03:44:39.000",
      "formatted_end": "03:44:41.000",
      "text": "قیمت از اینکه ضخم و عبوری ناتوانی جنسی"
    },
    {
      "id": 62,
      "start": 13481.0,
      "end": 13483.0,
      "formatted_start": "03:44:41.000",
      "formatted_end": "03:44:43.000",
      "text": "نمیدونم به همکردن"
    },
    {
      "id": 63,
      "start": 13483.0,
      "end": 13485.0,
      "formatted_start": "03:44:43.000",
      "formatted_end": "03:44:45.000",
      "text": "کلیفیت زنگی"
    },
    {
      "id": 64,
      "start": 13485.0,
      "end": 13487.0,
      "formatted_start": "03:44:45.000",
      "formatted_end": "03:44:47.000",
      "text": "تا قدم تعادل این چیزها"
    },
    {
      "id": 65,
      "start": 13487.0,
      "end": 13489.0,
      "formatted_start": "03:44:47.000",
      "formatted_end": "03:44:49.000",
      "text": "برای بیمار اجار بکنه"
    },
    {
      "id": 66,
      "start": 13489.0,
      "end": 13491.0,
      "formatted_start": "03:44:49.000",
      "formatted_end": "03:44:51.000",
      "text": "خب من این طول عمروش"
    },
    {
      "id": 67,
      "start": 13491.0,
      "end": 13493.0,
      "formatted_start": "03:44:51.000",
      "formatted_end": "03:44:53.000",
      "text": "خود نظر قلبی افزایش میده"
    },
    {
      "id": 68,
      "start": 13493.0,
      "end": 13495.0,
      "formatted_start": "03:44:53.000",
      "formatted_end": "03:44:55.000",
      "text": "یعنی احتمال ریسک سکته مربی رو"
    },
    {
      "id": 69,
      "start": 13495.0,
      "end": 13497.0,
      "formatted_start": "03:44:55.000",
      "formatted_end": "03:44:57.000",
      "text": "کاهش میده"
    },
    {
      "id": 70,
      "start": 13497.0,
      "end": 13499.0,
      "formatted_start": "03:44:57.000",
      "formatted_end": "03:44:59.000",
      "text": "سکته مجدد رو کاهش میده"
    },
    {
      "id": 71,
      "start": 13499.0,
      "end": 13501.0,
      "formatted_start": "03:44:59.000",
      "formatted_end": "03:45:01.000",
      "text": "من یکی برطنابه میگم"
    }
  ],
  "status": "completed"
}