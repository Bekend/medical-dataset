      "end": 5268.0,
      "formatted_start": "01:27:42.000",
      "formatted_end": "01:27:48.000",
      "text": "آره میکنه جبهه ترشین دستی رو بیاری اینجوری آره همیجاست داره"
    },
    {
      "id": 33,
      "start": 5268.0,
      "end": 5274.0,
      "formatted_start": "01:27:48.000",
      "formatted_end": "01:27:54.000",
      "text": "اینجوری درد میگیره یکم"
    },
    {
      "id": 34,
      "start": 5274.0,
      "end": 5278.0,
      "formatted_start": "01:27:54.000",
      "formatted_end": "01:27:58.000",
      "text": "اینجوری یکم اینجوری اینجوری اینجوری بریم بلا"
    },
    {
      "id": 35,
      "start": 5278.0,
      "end": 5282.0,
      "formatted_start": "01:27:58.000",
      "formatted_end": "01:28:02.000",
      "text": "یه دوره این پندکان دیوارم انجام میده اینجوری بریم بلا"
    },
    {
      "id": 36,
      "start": 5282.0,
      "end": 5284.0,
      "formatted_start": "01:28:02.000",
      "formatted_end": "01:28:04.000",
      "text": "اینجوری بریم درگفته"
    },
    {
      "id": 37,
      "start": 5284.0,
      "end": 5288.0,
      "formatted_start": "01:28:04.000",
      "formatted_end": "01:28:08.000",
      "text": "کاب دقای اینو مثل من اینجوری روی به دیوار میستیم"
    },
    {
      "id": 38,
      "start": 5288.0,
      "end": 5292.0,
      "formatted_start": "01:28:08.000",
      "formatted_end": "01:28:12.000",
      "text": "کاب دست کنید و اینجوری راه میدید"
    },
    {
      "id": 39,
      "start": 5292.0,
      "end": 5296.0,
      "formatted_start": "01:28:12.000",
      "formatted_end": "01:28:16.000",
      "text": "اینجوری زیر برقلب بچسبه به دیوار"
    },
    {
      "id": 40,
      "start": 5296.0,
      "end": 5306.0,
      "formatted_start": "01:28:16.000",
      "formatted_end": "01:28:26.000",
      "text": "از اینجا باید بچسب بریم"
    },
    {
      "id": 41,
      "start": 5306.0,
      "end": 5312.0,
      "formatted_start": "01:28:26.000",
      "formatted_end": "01:28:32.000",
      "text": "این دو هرکت را باید برسیم"
    },
    {
      "id": 42,
      "start": 5312.0,
      "end": 5316.0,
      "formatted_start": "01:28:32.000",
      "formatted_end": "01:28:36.000",
      "text": "توی بعضی کستراتیا خودشون اینجوری کلیفان درست کردن"
    },
    {
      "id": 43,
      "start": 5316.0,
      "end": 5320.0,
      "formatted_start": "01:28:36.000",
      "formatted_end": "01:28:40.000",
      "text": "چوبی اگه داشته باشه از طرف من بگی تطور انجام میشه"
    },
    {
      "id": 44,
      "start": 5320.0,
      "end": 5323.0,
      "formatted_start": "01:28:40.000",
      "formatted_end": "01:28:43.000",
      "text": "اگه نداریم تو با دیوارم هم اینجوری دستان وزندست بگیم"
    },
    {
      "id": 45,
      "start": 5323.0,
      "end": 5325.0,
      "formatted_start": "01:28:43.000",
      "formatted_end": "01:28:45.000",
      "text": "اینجوری دست نمیخواییم بلند بگیم"
    },
    {
      "id": 46,
      "start": 5325.0,
      "end": 5326.0,
      "formatted_start": "01:28:45.000",
      "formatted_end": "01:28:46.000",
      "text": "دست با؟"
    },
    {
      "id": 47,
      "start": 5326.0,
      "end": 5333.0,
      "formatted_start": "01:28:46.000",
      "formatted_end": "01:28:53.000",
      "text": "نه شما نیست که اینجوری باید با دستتون بریم بالا بریم"
    },
    {
      "id": 48,
      "start": 5333.0,
      "end": 5335.0,
      "formatted_start": "01:28:53.000",
      "formatted_end": "01:28:55.000",
      "text": "با دست را بریم"
    },
    {
      "id": 49,
      "start": 5335.0,
      "end": 5336.0,
      "formatted_start": "01:28:55.000",
      "formatted_end": "01:28:56.000",
      "text": "و اینجوری بزنیم"
    },
    {
      "id": 50,
      "start": 5336.0,
      "end": 5338.0,
      "formatted_start": "01:28:56.000",
      "formatted_end": "01:28:58.000",
      "text": "اوه هر که اینجوری دست صافی باشه"
    },
    {
      "id": 51,
      "start": 5338.0,
      "end": 5340.0,
      "formatted_start": "01:28:58.000",
      "formatted_end": "01:29:00.000",
      "text": "از اول این کار اینجا صافی"
    },
    {
      "id": 52,
      "start": 5340.0,
      "end": 5342.0,
      "formatted_start": "01:29:00.000",
      "formatted_end": "01:29:02.000",
      "text": "اونجا میری میری میری میری"
    },
    {
      "id": 53,
      "start": 5342.0,
      "end": 5344.0,
      "formatted_start": "01:29:02.000",
      "formatted_end": "01:29:04.000",
      "text": "قرار که بچسبیم به دیوار"
    },
    {
      "id": 54,
      "start": 5344.0,
      "end": 5346.0,
      "formatted_start": "01:29:04.000",
      "formatted_end": "01:29:06.000",
      "text": "خواب یه بار بریم"
    },
    {
      "id": 55,
      "start": 5346.0,
      "end": 5348.0,
      "formatted_start": "01:29:06.000",
      "formatted_end": "01:29:08.000",
      "text": "با دستون برین"
    },
    {
      "id": 56,
      "start": 5348.0,
      "end": 5350.0,
      "formatted_start": "01:29:08.000",
      "formatted_end": "01:29:10.000",
      "text": "شستتون بکار نمیبرین"
    },
    {
      "id": 57,
      "start": 5350.0,
      "end": 5352.0,
      "formatted_start": "01:29:10.000",
      "formatted_end": "01:29:12.000",
      "text": "با نه بچسبیم"
    },
    {
      "id": 58,
      "start": 5352.0,
      "end": 5354.0,
      "formatted_start": "01:29:12.000",
      "formatted_end": "01:29:14.000",
      "text": "بچسبیم بچسبیم"
    },
    {
      "id": 59,
      "start": 5354.0,
      "end": 5356.0,
      "formatted_start": "01:29:14.000",
      "formatted_end": "01:29:16.000",
      "text": "اونجا اونجا دست صدا کنیم"
    },
    {
      "id": 60,
      "start": 5356.0,
      "end": 5358.0,
      "formatted_start": "01:29:16.000",
      "formatted_end": "01:29:18.000",
      "text": "پهلی هم که میریم"
    },
    {
      "id": 61,
      "start": 5358.0,
      "end": 5360.0,
      "formatted_start": "01:29:18.000",
      "formatted_end": "01:29:20.000",
      "text": "اینجا زیر برم به دیوار بچسبیم"
    },
    {
      "id": 62,
      "start": 5360.0,
      "end": 5362.0,
      "formatted_start": "01:29:20.000",
      "formatted_end": "01:29:22.000",
      "text": "خواب این حرکت رو"
    },
    {
      "id": 63,
      "start": 5362.0,
      "end": 5364.0,
      "formatted_start": "01:29:22.000",
      "formatted_end": "01:29:24.000",
      "text": "بیسته صبح بیسته صبح بیسته صبح"
    },
    {
      "id": 64,
      "start": 5364.0,
      "end": 5366.0,
      "formatted_start": "01:29:24.000",
      "formatted_end": "01:29:26.000",
      "text": "هر اکس هم گفتیه هر اکس"
    },
    {
      "id": 65,
      "start": 5366.0,
      "end": 5368.0,
      "formatted_start": "01:29:26.000",
      "formatted_end": "01:29:28.000",
      "text": "باید به بالا میریم. باید به بالا میریم."
    },
    {
      "id": 66,
      "start": 5368.0,
      "end": 5370.0,
      "formatted_start": "01:29:28.000",
      "formatted_end": "01:29:30.000",
      "text": "یکمان رو برو، یکمان به پهلون."
    },
    {
      "id": 67,
      "start": 5370.0,
      "end": 5372.0,
      "formatted_start": "01:29:30.000",
      "formatted_end": "01:29:32.000",
      "text": "باید اینجوری میریم تا به شما."
    },
    {
      "id": 68,
      "start": 5372.0,
      "end": 5374.0,
      "formatted_start": "01:29:32.000",
      "formatted_end": "01:29:34.000",
      "text": "این دو ترکت رو بهت."
    },
    {
      "id": 69,
      "start": 5374.0,
      "end": 5376.0,
      "formatted_start": "01:29:34.000",
      "formatted_end": "01:29:36.000",
      "text": "توی فیزیوتراپی هم، بعضی از فیزیوتراپیس"
    },
    {
      "id": 70,
      "start": 5376.0,
      "end": 5378.0,
      "formatted_start": "01:29:36.000",
      "formatted_end": "01:29:38.000",
      "text": "رو انجام میده و بعضی هایی"
    },
    {
      "id": 71,
      "start": 5378.0,
      "end": 5380.0,
      "formatted_start": "01:29:38.000",
      "formatted_end": "01:29:40.000",
      "text": "مثل من آموزش میده که یک تونه"
    },
    {
      "id": 72,
      "start": 5380.0,
      "end": 5382.0,
      "formatted_start": "01:29:40.000",
      "formatted_end": "01:29:42.000",
      "text": "شستا انجام بدید"
    },
    {
      "id": 73,
      "start": 5382.0,
      "end": 5384.0,
      "formatted_start": "01:29:42.000",
      "formatted_end": "01:29:44.000",
      "text": "در روز بیست سال، بیست سال، بیست شب."
    },
    {
      "id": 74,
      "start": 5384.0,
      "end": 5386.0,
      "formatted_start": "01:29:44.000",
      "formatted_end": "01:29:46.000",
      "text": "خب، پردر نظر"
    },
    {
      "id": 75,
      "start": 5386.0,
      "end": 5388.0,
      "formatted_start": "01:29:46.000",
      "formatted_end": "01:29:48.000",
      "text": "موزه اینچه داروی"
    },
    {
      "id": 76,
      "start": 5388.0,
      "end": 5390.0,
      "formatted_start": "01:29:48.000",
      "formatted_end": "01:29:50.000",
      "text": "نمیزنید که برایش"
    },
    {
      "id": 77,
      "start": 5396.0,
      "end": 5400.0,
      "formatted_start": "01:29:56.000",
      "formatted_end": "01:30:00.000",
      "text": "این بسمت هایی کچولو ورم کرده بود"
    }
  ],
  "status": "completed"
}