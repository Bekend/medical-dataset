  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4807.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:07.000",
      "text": "پس بخورم اونا رو. بله بخورید سکته نمی کنید، نخورید سکته می کنید. با سرگیجت هیچ کاری نداره اون خوش."
    },
    {
      "id": 1,
      "start": 4807.0,
      "end": 4813.0,
      "formatted_start": "01:20:07.000",
      "formatted_end": "01:20:13.000",
      "text": "دستش آدم. بله مبارکه. پشت دست چپ نه، ایپی نترال نه. چیز تعییز نسخه نیست."
    },
    {
      "id": 2,
      "start": 4813.0,
      "end": 4816.0,
      "formatted_start": "01:20:13.000",
      "formatted_end": "01:20:16.000",
      "text": "حالا همونجا همین رو که داشتید."
    },
    {
      "id": 3,
      "start": 4816.0,
      "end": 4818.0,
      "formatted_start": "01:20:16.000",
      "formatted_end": "01:20:18.000",
      "text": "همین رو برم."
    },
    {
      "id": 4,
      "start": 4818.0,
      "end": 4820.0,
      "formatted_start": "01:20:18.000",
      "formatted_end": "01:20:20.000",
      "text": "نه."
    },
    {
      "id": 5,
      "start": 4820.0,
      "end": 4822.0,
      "formatted_start": "01:20:20.000",
      "formatted_end": "01:20:22.000",
      "text": "نه."
    },
    {
      "id": 6,
      "start": 4822.0,
      "end": 4824.0,
      "formatted_start": "01:20:22.000",
      "formatted_end": "01:20:24.000",
      "text": "نه تعییز اونجوری نیست."
    },
    {
      "id": 7,
      "start": 4824.0,
      "end": 4826.0,
      "formatted_start": "01:20:24.000",
