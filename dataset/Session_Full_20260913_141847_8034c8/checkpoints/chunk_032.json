  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9610.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:10.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 9630.0,
      "end": 9639.0,
      "formatted_start": "02:40:30.000",
      "formatted_end": "02:40:39.000",
      "text": "این شعرات را به شما بگیرم. شعرات اشتباه را به شما بگیرم. روزی 3 بار قبل از قضایی."
    },
    {
      "id": 2,
      "start": 9639.0,
      "end": 9644.0,
      "formatted_start": "02:40:39.000",
      "formatted_end": "02:40:44.000",
      "text": "می کنید از قبل شعرات بگیرم. یا باید قبل از قضایی بگیرم. برد بشو می کنید."
    },
    {
      "id": 3,
      "start": 9644.0,
      "end": 9650.0,
      "formatted_start": "02:40:44.000",
      "formatted_end": "02:40:50.000",
      "text": "روزی باید به قضایی بگیرم. این شعرات را به شما بگیرم. روزی 3 بار برنامه نکرده نکرده شد."
    },
    {
      "id": 4,
      "start": 9650.0,
      "end": 9655.0,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:55.000",
      "text": "از چیز که بگیرم. روزی 3 بار هر هر سال یک پاشه ما مرقب است."
    },
    {
      "id": 5,
      "start": 9655.0,
      "end": 9657.0,
      "formatted_start": "02:40:55.000",
      "formatted_end": "02:40:57.000",
      "text": "مدارش آخری نردن از گره"
    },
    {
      "id": 6,
      "start": 9657.0,
      "end": 9659.0,
      "formatted_start": "02:40:57.000",
      "formatted_end": "02:40:59.000",
      "text": "روزیسته بود"
    },
    {
      "id": 7,
      "start": 9659.0,
      "end": 9661.0,
      "formatted_start": "02:40:59.000",
      "formatted_end": "02:41:01.000",
      "text": "یا باشون بردارید"
    },
    {
      "id": 8,
      "start": 9661.0,
      "end": 9663.0,
      "formatted_start": "02:41:01.000",
      "formatted_end": "02:41:03.000",
      "text": "نماندارید"
    },
    {
      "id": 9,
      "start": 9663.0,
      "end": 9665.0,
      "formatted_start": "02:41:03.000",
      "formatted_end": "02:41:05.000",
      "text": "همینجور برشون"
    },
    {
      "id": 10,
      "start": 9665.0,
      "end": 9667.0,
      "formatted_start": "02:41:05.000",
      "formatted_end": "02:41:07.000",
      "text": "که گردن برده"
    },
    {
      "id": 11,
      "start": 9667.0,
      "end": 9669.0,
      "formatted_start": "02:41:07.000",
      "formatted_end": "02:41:09.000",
      "text": "شیوی را بیرون"
    },
    {
      "id": 12,
      "start": 9669.0,
      "end": 9671.0,
      "formatted_start": "02:41:09.000",
      "formatted_end": "02:41:11.000",
      "text": "شیوی را برده"
    },
    {
      "id": 13,
      "start": 9671.0,
      "end": 9673.0,
      "formatted_start": "02:41:11.000",
      "formatted_end": "02:41:13.000",
      "text": "این یا آره این یا بیرون"
    },
    {
      "id": 14,
      "start": 9673.0,
      "end": 9675.0,
      "formatted_start": "02:41:13.000",
      "formatted_end": "02:41:15.000",
      "text": "باید شکر میکنیم"
    },
    {
      "id": 15,
      "start": 9675.0,
      "end": 9677.0,
      "formatted_start": "02:41:15.000",
      "formatted_end": "02:41:17.000",
      "text": "باید شکر میکنیم"
    },
    {
      "id": 16,
      "start": 9677.0,
      "end": 9679.0,
      "formatted_start": "02:41:17.000",
