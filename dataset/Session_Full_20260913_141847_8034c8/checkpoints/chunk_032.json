      "formatted_start": "02:41:43.000",
      "formatted_end": "02:41:47.000",
      "text": "از تکیه سال چشمونه هست"
    },
    {
      "id": 21,
      "start": 9707.0,
      "end": 9709.0,
      "formatted_start": "02:41:47.000",
      "formatted_end": "02:41:49.000",
      "text": "آره"
    },
    {
      "id": 22,
      "start": 9709.0,
      "end": 9711.0,
      "formatted_start": "02:41:49.000",
      "formatted_end": "02:41:51.000",
      "text": "سالی؟"
    },
    {
      "id": 23,
      "start": 9711.0,
      "end": 9713.0,
      "formatted_start": "02:41:51.000",
      "formatted_end": "02:41:53.000",
      "text": "نه این روز هست هفتونه چشمونه"
    },
    {
      "id": 24,
      "start": 9713.0,
      "end": 9715.0,
      "formatted_start": "02:41:53.000",
      "formatted_end": "02:41:55.000",
      "text": "از این تصاوی چه؟"
    },
    {
      "id": 25,
      "start": 9715.0,
      "end": 9717.0,
      "formatted_start": "02:41:55.000",
      "formatted_end": "02:41:57.000",
