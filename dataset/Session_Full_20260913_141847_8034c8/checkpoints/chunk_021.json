  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6304.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:04.000",
      "text": "این یک خورد زمان درد میگیرد، جز زمان."
    },
    {
      "id": 1,
      "start": 6304.0,
      "end": 6306.0,
      "formatted_start": "01:45:04.000",
      "formatted_end": "01:45:06.000",
      "text": "این نماز ها..."
    },
    {
      "id": 2,
      "start": 6306.0,
      "end": 6308.0,
      "formatted_start": "01:45:06.000",
      "formatted_end": "01:45:08.000",
      "text": "مرتبت؟"
    },
    {
      "id": 3,
      "start": 6308.0,
      "end": 6313.0,
      "formatted_start": "01:45:08.000",
      "formatted_end": "01:45:13.000",
      "text": "مرتبت، اما چیز شده، خیلی حجمش کم شد."
    },
    {
      "id": 4,
      "start": 6313.0,
      "end": 6315.0,
      "formatted_start": "01:45:13.000",
      "formatted_end": "01:45:15.000",
      "text": "اون اوله..."
    },
    {
      "id": 5,
      "start": 6315.0,
      "end": 6318.0,
      "formatted_start": "01:45:15.000",
      "formatted_end": "01:45:18.000",
      "text": "اوله، اوله، جمعه باشه."
    },
    {
      "id": 6,
      "start": 6324.0,
      "end": 6326.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:26.000",
      "text": "اون چه درد میگیرد؟"
    },
    {
      "id": 7,
      "start": 6326.0,
      "end": 6330.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:30.000",
      "text": "دو سایی با هم یک سندگی دو سایی بزرگ میشه"
    },
    {
      "id": 8,
      "start": 6330.0,
      "end": 6334.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:34.000",
      "text": "بله شروع میشه، گذرفهش تحلیل رفته"
    },
    {
      "id": 9,
      "start": 6334.0,
      "end": 6338.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:38.000",
      "text": "و دو تا اسلکون به هم نزدیک شدن"
    },
    {
      "id": 10,
      "start": 6338.0,
      "end": 6342.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:42.000",
      "text": "صدا هم می کنه، قچکش و سایش هم داره"
    },
    {
      "id": 11,
      "start": 6342.0,
      "end": 6346.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:46.000",
      "text": "بین دو تا اسلکونی که دوزان می که پایین این بار باری یه گذرفه هست"
    },
    {
      "id": 12,
      "start": 6346.0,
      "end": 6350.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:50.000",
      "text": "گذرفه در سر حالا نقیلاتها درد"
    },
    {
      "id": 13,
      "start": 6350.0,
      "end": 6354.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:54.000",
      "text": "در سر پچه دار شدن، سایی مختلف زنون"
    },
    {
      "id": 14,
      "start": 6354.0,
      "end": 6362.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:46:02.000",
      "text": "این موضوع نازر میشه، چرک پس چروک میشه، موضوع هم چروکی ده میشه، پس تو خانه زارو باید همینی کنه"
    },
    {
      "id": 15,
      "start": 6362.0,
      "end": 6368.0,
      "formatted_start": "01:46:02.000",
      "formatted_end": "01:46:08.000",
      "text": "یک اپسول هست، موضوع سازه، کم گرون خارجی، یک میلیون و یک میلیون و یک نیز منجود"
    },
    {
      "id": 16,
      "start": 6368.0,
      "end": 6376.0,
      "formatted_start": "01:46:08.000",
      "formatted_end": "01:46:16.000",
      "text": "باید میلیون سنبهان، نه نیز، میلیون و مصرف بکنید، یک نیز بهتر میشه زارو"
    },
    {
      "id": 17,
      "start": 6376.0,
      "end": 6406.0,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:46.000",
      "text": "همین زنها توانشون حرام میشه و در سن ۵۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰�"
    },
    {
      "id": 18,
      "start": 6406.0,
      "end": 6436.0,
      "formatted_start": "01:46:46.000",
      "formatted_end": "01:47:16.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 19,
      "start": 6436.0,
      "end": 6441.0,
      "formatted_start": "01:47:16.000",
      "formatted_end": "01:47:21.000",
      "text": "از این زنان قردم ببینم. یعنی بدون اون نمیدونم. از این کلت تا آخری."
    },
    {
      "id": 20,
      "start": 6441.0,
      "end": 6445.0,
      "formatted_start": "01:47:21.000",
      "formatted_end": "01:47:25.000",
      "text": "مثل نون و برنج و یکی نیست. این هم شما هم سجده."
    },
    {
      "id": 21,
      "start": 6445.0,
      "end": 6450.0,
      "formatted_start": "01:47:25.000",
      "formatted_end": "01:47:30.000",
      "text": "تو تا که یک حسد بیاره باز داروی نرم کننده یه هاشون آلو هم بخونه."
    },
    {
      "id": 22,
      "start": 6450.0,
      "end": 6456.0,
      "formatted_start": "01:47:30.000",
      "formatted_end": "01:47:36.000",
      "text": "مثلا همینو هنجیره بکنه. همه چیزو بکنه. اون سجده برای زنان لازم جدا."
    },
    {
      "id": 23,
      "start": 6456.0,
      "end": 6460.0,
      "formatted_start": "01:47:36.000",
      "formatted_end": "01:47:40.000",
      "text": "برگاه نه ها. برگاه بعضی هاشون برگاه نیست. برای زنان هم هم هشون سجده."
    },
    {
      "id": 24,
      "start": 6460.0,
      "end": 6474.0,
      "formatted_start": "01:47:40.000",
      "formatted_end": "01:47:54.000",
      "text": "اینجوریه که تا چه سالگی قدروب سازی دارن، بعد چه سالگی با هرمون استروجین تیدهاش بدارون کن، قدروب سازی از نمیدونه."
    },
    {
      "id": 25,
      "start": 6474.0,
      "end": 6480.0,
      "formatted_start": "01:47:54.000",
      "formatted_end": "01:48:00.000",
      "text": "نیازه نداشتونه؟ نه، شهرمان به زنان شما خوب طریق است، 34 سالگی."
    },
    {
      "id": 26,
      "start": 6480.0,
      "end": 6482.0,
      "formatted_start": "01:48:00.000",
      "formatted_end": "01:48:02.000",
      "text": "اصلا زنبه که سی سال شده میشه"
    },
    {
      "id": 27,
      "start": 6482.0,
      "end": 6484.0,
      "formatted_start": "01:48:02.000",
      "formatted_end": "01:48:04.000",
      "text": "خدایت چندی؟"
    },
    {
      "id": 28,
      "start": 6484.0,
      "end": 6486.0,
      "formatted_start": "01:48:04.000",
      "formatted_end": "01:48:06.000",
      "text": "چند سال شده؟"
    },
    {
      "id": 29,
      "start": 6486.0,
      "end": 6488.0,
      "formatted_start": "01:48:06.000",
      "formatted_end": "01:48:08.000",
      "text": "۷۷ سالی نزدیکی"
    },
    {
      "id": 30,
      "start": 6488.0,
      "end": 6490.0,
      "formatted_start": "01:48:08.000",
      "formatted_end": "01:48:10.000",
      "text": "از ۳۵، ۶۶ دیگه یه ارشد شده باشه"
    },
    {
      "id": 31,
      "start": 6490.0,
      "end": 6492.0,
      "formatted_start": "01:48:10.000",
      "formatted_end": "01:48:12.000",
      "text": "بچه ها که فردی من"
    },
    {
      "id": 32,
      "start": 6492.0,
      "end": 6494.0,
      "formatted_start": "01:48:12.000",
      "formatted_end": "01:48:14.000",
      "text": "مثلا جوربانی یک هرچی"
    },
    {
      "id": 33,
      "start": 6494.0,
      "end": 6496.0,
      "formatted_start": "01:48:14.000",
      "formatted_end": "01:48:16.000",
      "text": "میشه که شده"
    },
    {
      "id": 34,
      "start": 6496.0,
      "end": 6498.0,
      "formatted_start": "01:48:16.000",
      "formatted_end": "01:48:18.000",
      "text": "کم بودی فردون استرالی شده"
    },
    {
      "id": 35,
      "start": 6498.0,
      "end": 6500.0,
      "formatted_start": "01:48:18.000",
      "formatted_end": "01:48:20.000",
      "text": "آهان"
    },
    {
      "id": 36,
      "start": 6500.0,
      "end": 6502.0,
      "formatted_start": "01:48:20.000",
      "formatted_end": "01:48:22.000",
      "text": "اونم بردید"
    },
    {
      "id": 37,
      "start": 6502.0,
      "end": 6504.0,
      "formatted_start": "01:48:22.000",
      "formatted_end": "01:48:24.000",
      "text": "۳۰۰، ۹۰۰"
    },
    {
      "id": 38,
      "start": 6504.0,
      "end": 6506.0,
      "formatted_start": "01:48:24.000",
      "formatted_end": "01:48:26.000",
      "text": "اونم خواهیم"
    },
    {
      "id": 39,
      "start": 6506.0,
      "end": 6508.0,
      "formatted_start": "01:48:26.000",
      "formatted_end": "01:48:28.000",
      "text": "بردید میاد"
    },
    {
      "id": 40,
      "start": 6508.0,
      "end": 6510.0,
      "formatted_start": "01:48:28.000",
      "formatted_end": "01:48:30.000",
      "text": "کم شده"
    },
    {
      "id": 41,
      "start": 6510.0,
      "end": 6512.0,
      "formatted_start": "01:48:30.000",
      "formatted_end": "01:48:32.000",
      "text": "اونم با همینه"
    },
    {
      "id": 42,
      "start": 6512.0,
      "end": 6514.0,
      "formatted_start": "01:48:32.000",
      "formatted_end": "01:48:34.000",
      "text": "این زنان هم به هم اومد"
    },
    {
      "id": 43,
      "start": 6514.0,
      "end": 6516.0,
      "formatted_start": "01:48:34.000",
      "formatted_end": "01:48:36.000",
      "text": "این توی پیشنگی هم بالا هم"
    },
    {
      "id": 44,
      "start": 6516.0,
      "end": 6518.0,
      "formatted_start": "01:48:36.000",
      "formatted_end": "01:48:38.000",
      "text": "این بوسه دیگه هم بالا هم بوده"
    },
    {
      "id": 45,
      "start": 6518.0,
      "end": 6520.0,
      "formatted_start": "01:48:38.000",
      "formatted_end": "01:48:40.000",
      "text": "این چار تا چیز با هم بوده"
    },
    {
      "id": 46,
      "start": 6520.0,
      "end": 6522.0,
      "formatted_start": "01:48:40.000",
      "formatted_end": "01:48:42.000",
      "text": "این رو با هم بوده"
    },
    {
      "id": 47,
      "start": 6522.0,
      "end": 6524.0,
      "formatted_start": "01:48:42.000",
      "formatted_end": "01:48:44.000",
      "text": "بعد"
    },
    {
      "id": 48,
      "start": 6524.0,
      "end": 6526.0,
      "formatted_start": "01:48:44.000",
      "formatted_end": "01:48:46.000",
      "text": "چندی میبینم اینجور شده"
    },
    {
      "id": 49,
      "start": 6526.0,
      "end": 6528.0,
      "formatted_start": "01:48:46.000",
      "formatted_end": "01:48:48.000",
      "text": "اصلا مو سره من دارم"
    },
    {
      "id": 50,
      "start": 6528.0,
      "end": 6530.0,
      "formatted_start": "01:48:48.000",
      "formatted_end": "01:48:50.000",
      "text": "داد میزن"
    },
    {
      "id": 51,
      "start": 6530.0,
      "end": 6532.0,
      "formatted_start": "01:48:50.000",
      "formatted_end": "01:48:52.000",
      "text": "اینجور رو آقا تونم میفردش میکنه"
    },
    {
      "id": 52,
      "start": 6532.0,
      "end": 6534.0,
      "formatted_start": "01:48:52.000",
      "formatted_end": "01:48:54.000",
      "text": "نه آقا هم داره"
    },
    {
      "id": 53,
      "start": 6534.0,
      "end": 6536.0,
      "formatted_start": "01:48:54.000",
      "formatted_end": "01:48:56.000",
      "text": "گراشه باشه"
    },
    {
      "id": 54,
      "start": 6536.0,
      "end": 6537.56,
      "formatted_start": "01:48:56.000",
      "formatted_end": "01:48:57.560",
      "text": "بله، چند دفتر چی دارید؟"
    },
    {
      "id": 55,
      "start": 6537.56,
      "end": 6538.52,
      "formatted_start": "01:48:57.560",
      "formatted_end": "01:48:58.520",
      "text": "دوست دفترم"
    },
    {
      "id": 56,
      "start": 6538.52,
      "end": 6540.02,
      "formatted_start": "01:48:58.520",
      "formatted_end": "01:49:00.020",
      "text": "ماشه، ماشه، ماشه، ماشه"
    },
    {
      "id": 57,
      "start": 6540.02,
      "end": 6541.78,
      "formatted_start": "01:49:00.020",
      "formatted_end": "01:49:01.780",
      "text": "اون دفترها تحجب کن، مومون چرا خوششید"
    },
    {
      "id": 58,
      "start": 6541.78,
      "end": 6543.42,
      "formatted_start": "01:49:01.780",
      "formatted_end": "01:49:03.420",
      "text": "آره، انقدر هم اون..."
    },
    {
      "id": 59,
      "start": 6543.42,
      "end": 6545.02,
      "formatted_start": "01:49:03.420",
      "formatted_end": "01:49:05.020",
      "text": "استراجن کم میشه؟"
    },
    {
      "id": 60,
      "start": 6545.02,
      "end": 6546.64,
      "formatted_start": "01:49:05.020",
      "formatted_end": "01:49:06.640",
      "text": "بله، بله، بله"
    },
    {
      "id": 61,
      "start": 6546.64,
      "end": 6549.44,
      "formatted_start": "01:49:06.640",
      "formatted_end": "01:49:09.440",
      "text": "درمان این باطر سروره من خواهی نباشه"
    },
    {
      "id": 62,
      "start": 6549.44,
      "end": 6551.44,
      "formatted_start": "01:49:09.440",
      "formatted_end": "01:49:11.440",
      "text": "آه، چرا؟"
    },
    {
      "id": 63,
      "start": 6551.44,
      "end": 6554.2,
      "formatted_start": "01:49:11.440",
      "formatted_end": "01:49:14.200",
      "text": "درمانش این سونوگرافی باید بکنیم، ببینید"
    },
    {
      "id": 64,
      "start": 6554.2,
      "end": 6555.8,
      "formatted_start": "01:49:14.200",
      "formatted_end": "01:49:15.800",
      "text": "سونو هم براش به زنانه ها"
    },
    {
      "id": 65,
      "start": 6555.8,
      "end": 6558.4,
      "formatted_start": "01:49:15.800",
      "formatted_end": "01:49:18.400",
      "text": "چون امیدوارش سونوگرافی رو بردن میگیرن"
    },
    {
      "id": 66,
      "start": 6558.4,
      "end": 6572.4,
      "formatted_start": "01:49:18.400",
      "formatted_end": "01:49:32.400",
      "text": "هر این نگران میگن زنان ولی همه اشکالاتی اینها رو شروع به اصلاح می کنید"
    },
    {
      "id": 67,
      "start": 6572.4,
      "end": 6574.4,
      "formatted_start": "01:49:32.400",
      "formatted_end": "01:49:34.400",
      "text": "مردم از اینجا بردارید"
    },
    {
      "id": 68,
      "start": 6574.4,
      "end": 6576.4,
      "formatted_start": "01:49:34.400",
      "formatted_end": "01:49:36.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 69,
      "start": 6576.4,
      "end": 6578.4,
      "formatted_start": "01:49:36.400",
      "formatted_end": "01:49:38.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 70,
      "start": 6578.4,
      "end": 6580.4,
      "formatted_start": "01:49:38.400",
      "formatted_end": "01:49:40.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 71,
      "start": 6580.4,
      "end": 6582.4,
      "formatted_start": "01:49:40.400",
      "formatted_end": "01:49:42.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 72,
      "start": 6582.4,
      "end": 6584.4,
      "formatted_start": "01:49:42.400",
      "formatted_end": "01:49:44.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 73,
      "start": 6584.4,
      "end": 6586.4,
      "formatted_start": "01:49:44.400",
      "formatted_end": "01:49:46.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 74,
      "start": 6586.4,
      "end": 6588.4,
      "formatted_start": "01:49:46.400",
      "formatted_end": "01:49:48.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 75,
      "start": 6588.4,
      "end": 6590.4,
      "formatted_start": "01:49:48.400",
      "formatted_end": "01:49:50.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 76,
      "start": 6590.4,
      "end": 6592.4,
      "formatted_start": "01:49:50.400",
      "formatted_end": "01:49:52.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 77,
      "start": 6592.4,
      "end": 6594.4,
      "formatted_start": "01:49:52.400",
      "formatted_end": "01:49:54.400",
      "text": "از اینجا بردارید"
    },
    {
      "id": 78,
