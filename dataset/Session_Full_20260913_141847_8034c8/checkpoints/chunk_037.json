    {
      "id": 7,
      "start": 11306.0,
      "end": 11306.98,
      "formatted_start": "03:08:26.000",
      "formatted_end": "03:08:26.980",
      "text": "سلام و حدکتر"
    },
    {
      "id": 8,
      "start": 11306.98,
      "end": 11308.98,
      "formatted_start": "03:08:26.980",
      "formatted_end": "03:08:28.980",
      "text": "سلام آقای سلام"
    },
    {
      "id": 9,
      "start": 11308.98,
      "end": 11309.98,
      "formatted_start": "03:08:28.980",
      "formatted_end": "03:08:29.980",
      "text": "سلام"
    },
    {
      "id": 10,
      "start": 11309.98,
      "end": 11311.98,
      "formatted_start": "03:08:29.980",
      "formatted_end": "03:08:31.980",
      "text": "برای شما هستیم بفرما"
    },
    {
      "id": 11,
      "start": 11326.98,
      "end": 11328.98,
      "formatted_start": "03:08:46.980",
      "formatted_end": "03:08:48.980",
      "text": "جوان آقای سلام"
    },
    {
      "id": 12,
      "start": 11329.98,
      "end": 11331.98,
      "formatted_start": "03:08:49.980",
      "formatted_end": "03:08:51.980",
      "text": "آرام باش بابا"
    },
    {
      "id": 13,
      "start": 11331.98,
      "end": 11332.98,
      "formatted_start": "03:08:51.980",
      "formatted_end": "03:08:52.980",
      "text": "بفرما"
    },
    {
      "id": 14,
      "start": 11332.98,
      "end": 11336.64,
      "formatted_start": "03:08:52.980",
      "formatted_end": "03:08:56.640",
      "text": "هفته پیش احساس ترم خوردگی می کرد گلو درد و گوشتن"
    },
    {
      "id": 15,
      "start": 11336.64,
      "end": 11343.08,
      "formatted_start": "03:08:56.640",
      "formatted_end": "03:09:03.080",
      "text": "بردیمش دکتر بهش دارو دارم از دیروزه می گوید گوشتن خیلی درد می کند"
    },
    {
      "id": 16,
      "start": 11343.08,
      "end": 11347.84,
      "formatted_start": "03:09:03.080",
      "formatted_end": "03:09:07.840",
      "text": "دو نوبت هم آنبور پلسلین اینا استفاده کرده"
    },
    {
      "id": 17,
      "start": 11347.84,
      "end": 11351.84,
      "formatted_start": "03:09:07.840",
      "formatted_end": "03:09:11.840",
      "text": "خوشت خوشان هم خورده خب بازم این گوشتن خیلی درد می کند"
    },
    {
      "id": 18,
      "start": 11351.84,
      "end": 11354.44,
      "formatted_start": "03:09:11.840",
      "formatted_end": "03:09:14.440",
      "text": "چه ارکن می آید از گوشتن؟"
    },
    {
      "id": 19,
      "start": 11354.44,
      "end": 11357.44,
      "formatted_start": "03:09:14.440",
      "formatted_end": "03:09:17.440",
      "text": "نه نه نه نه نه"
    },
    {
      "id": 20,
      "start": 11357.44,
      "end": 11360.32,
      "formatted_start": "03:09:17.440",
      "formatted_end": "03:09:20.320",
      "text": "هنو دارو می دارم به تو گوشتن"
    },
    {
      "id": 21,
      "start": 11360.32,
      "end": 11362.32,
      "formatted_start": "03:09:20.320",
      "formatted_end": "03:09:22.320",
      "text": "اینجا باید برداشتیم"
    },
    {
      "id": 22,
      "start": 11370.32,
      "end": 11372.32,
      "formatted_start": "03:09:30.320",
      "formatted_end": "03:09:32.320",
      "text": "خیلی آب سرد استفاده میکنند"
    },
    {
      "id": 23,
      "start": 11372.32,
      "end": 11374.32,
      "formatted_start": "03:09:32.320",
      "formatted_end": "03:09:34.320",
      "text": "بخشید"
    },
    {
      "id": 24,
      "start": 11374.32,
      "end": 11376.32,
      "formatted_start": "03:09:34.320",
      "formatted_end": "03:09:36.320",
