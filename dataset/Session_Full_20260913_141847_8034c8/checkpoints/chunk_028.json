  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8402.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:02.000",
      "text": "او نجفی ای مراب زرگان."
    },
    {
      "id": 1,
      "start": 8402.0,
      "end": 8404.0,
      "formatted_start": "02:20:02.000",
      "formatted_end": "02:20:04.000",
      "text": "آه نجفی."
    },
    {
      "id": 2,
      "start": 8404.0,
      "end": 8406.0,
      "formatted_start": "02:20:04.000",
      "formatted_end": "02:20:06.000",
      "text": "نجفی، خانم رزید باشه."
    },
    {
      "id": 3,
      "start": 8406.0,
      "end": 8408.0,
      "formatted_start": "02:20:06.000",
      "formatted_end": "02:20:08.000",
      "text": "نجفی که جراحی کشون یا اون که..."
    },
    {
      "id": 4,
      "start": 8408.0,
      "end": 8412.0,
      "formatted_start": "02:20:08.000",
      "formatted_end": "02:20:12.000",
      "text": "نه نه، چیز بود، بیمارستان که تمیز بود."
    },
    {
      "id": 5,
      "start": 8412.0,
      "end": 8414.0,
      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:14.000",
      "text": "بیمارستان که تمیز بود، بره."
    },
    {
      "id": 6,
      "start": 8414.0,
      "end": 8416.0,
      "formatted_start": "02:20:14.000",
      "formatted_end": "02:20:16.000",
      "text": "چند سال به خانه اون مراب."
    },
    {
      "id": 7,
      "start": 8416.0,
      "end": 8418.0,
      "formatted_start": "02:20:16.000",
      "formatted_end": "02:20:18.000",
      "text": "اونا، خانمش هم دکتری یا نه؟"
    },
    {
      "id": 8,
      "start": 8418.0,
      "end": 8420.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:20.000",
      "text": "نه نه، خانمش خانه داره."
    },
    {
      "id": 9,
      "start": 8420.0,
      "end": 8424.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:24.000",
      "text": "خانمش مارسایی کشون، خانمش آبالبابون."
    },
    {
      "id": 10,
      "start": 8424.0,
      "end": 8428.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:28.000",
      "text": "بعد برشه، نه دیدمش این کشوری برساش."
    },
    {
      "id": 11,
      "start": 8428.0,
      "end": 8437.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:37.000",
      "text": "رسیدگی میکردن بدید یا نه؟ نه بابا. اینش نمیدونی. این پول رو کارگیرش نمیدادن آقایی درم. نه بابا."
    },
    {
      "id": 12,
      "start": 8437.0,
      "end": 8445.0,
      "formatted_start": "02:20:37.000",
      "formatted_end": "02:20:45.000",
      "text": "بابا پول رو کارگیرش نمیدادن. روی سی سنت و پندیت منشون دادن. ست منشون باز کرده و در اون زمان گریست من براش مانده."
    },
    {
      "id": 13,
      "start": 8445.0,
      "end": 8454.0,
      "formatted_start": "02:20:45.000",
      "formatted_end": "02:20:54.000",
      "text": "کجا بود خونش؟ خونش گم و دروز. کچه جهاد نگاه داردش. از این کار خود کجایی؟"
    },
    {
      "id": 14,
      "start": 8454.0,
      "end": 8457.24,
      "formatted_start": "02:20:54.000",
      "formatted_end": "02:20:57.240",
      "text": "رفت و برگشت پولش تمام شد"
    },
    {
      "id": 15,
      "start": 8457.24,
      "end": 8462.0,
      "formatted_start": "02:20:57.240",
      "formatted_end": "02:21:02.000",
      "text": "آره تمام شد. ما می گویم نرم. ما می گویم ما چی کار کنیم؟ نرم چی کار کنیم"
    },
    {
      "id": 16,
      "start": 8462.0,
      "end": 8466.0,
      "formatted_start": "02:21:02.000",
      "formatted_end": "02:21:06.000",
      "text": "پول گردن خواهد شده بود زحمت کسی چی نرم"
    },
    {
      "id": 17,
      "start": 8466.0,
      "end": 8471.0,
      "formatted_start": "02:21:06.000",
      "formatted_end": "02:21:11.000",
      "text": "دیگر هم بسیار چنگ رفت. دانشگاه تنا جدن. دیگر اینم نبردن بگیر"
    },
    {
      "id": 18,
      "start": 8471.0,
      "end": 8475.0,
      "formatted_start": "02:21:11.000",
      "formatted_end": "02:21:15.000",
      "text": "آره. ببینیم بازی همجور پول میگه هیچ کار نمی کنه"
    },
    {
      "id": 19,
      "start": 8475.0,
      "end": 8479.0,
      "formatted_start": "02:21:15.000",
      "formatted_end": "02:21:19.000",
      "text": "نمی آره. کار میکنند. زحمت میشن. پیشن هم میخورند"
    },
    {
      "id": 20,
      "start": 8479.0,
      "end": 8509.0,
      "formatted_start": "02:21:19.000",
      "formatted_end": "02:21:49.000",
      "text": "در این وقت، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد، با این افراد،"
    },
    {
      "id": 21,
      "start": 8509.0,
      "end": 8511.0,
      "formatted_start": "02:21:49.000",
      "formatted_end": "02:21:51.000",
      "text": "اصلا در نبتی"
    },
    {
      "id": 22,
      "start": 8511.0,
      "end": 8513.0,
      "formatted_start": "02:21:51.000",
      "formatted_end": "02:21:53.000",
      "text": "چیز کومیته داری؟ بوشش کومیته داری؟"
    },
    {
      "id": 23,
      "start": 8513.0,
      "end": 8515.0,
      "formatted_start": "02:21:53.000",
      "formatted_end": "02:21:55.000",
      "text": "نه نه، بنیاد شهید داری"
    },
    {
      "id": 24,
      "start": 8515.0,
      "end": 8517.0,
      "formatted_start": "02:21:55.000",
      "formatted_end": "02:21:57.000",
      "text": "شهید داری؟ آهان رو یک اونو فاکتور بدیم"
    },
    {
      "id": 25,
      "start": 8517.0,
      "end": 8519.0,
      "formatted_start": "02:21:57.000",
      "formatted_end": "02:21:59.000",
      "text": "بروش میتونیم، از این دختر درست داریم"
    },
    {
      "id": 26,
      "start": 8519.0,
      "end": 8521.0,
      "formatted_start": "02:21:59.000",
      "formatted_end": "02:22:01.000",
      "text": "اصلا در نبتی"
    },
    {
      "id": 27,
      "start": 8521.0,
      "end": 8523.0,
      "formatted_start": "02:22:01.000",
      "formatted_end": "02:22:03.000",
      "text": "دارو خانم رفتی، بگو که چیزی کوریان شهید داری"
    },
    {
      "id": 28,
      "start": 8523.0,
      "end": 8525.0,
      "formatted_start": "02:22:03.000",
      "formatted_end": "02:22:05.000",
      "text": "همه همه شو باید کنی؟"
    },
    {
      "id": 29,
      "start": 8525.0,
      "end": 8527.0,
      "formatted_start": "02:22:05.000",
      "formatted_end": "02:22:07.000",
      "text": "اصلا در نبتی"
    },
    {
      "id": 30,
      "start": 8527.0,
      "end": 8529.0,
      "formatted_start": "02:22:07.000",
      "formatted_end": "02:22:09.000",
      "text": "خیلی ممنون بودم، خیلی خیلی خیلی خیلی"
    },
    {
      "id": 31,
      "start": 8529.0,
      "end": 8531.0,
      "formatted_start": "02:22:09.000",
      "formatted_end": "02:22:11.000",
      "text": "چرا چهید شده؟"
    },
    {
      "id": 32,
      "start": 8531.0,
      "end": 8537.0,
      "formatted_start": "02:22:11.000",
      "formatted_end": "02:22:17.000",
      "text": "نه میگی جانباده درک درصدش کم مثلا هفت رو بزنید نه لفت رو برمن"
    },
    {
      "id": 33,
      "start": 8537.0,
      "end": 8542.0,
      "formatted_start": "02:22:17.000",
      "formatted_end": "02:22:22.000",
      "text": "مثلا اگه یه حقوق مشهدتیش شما برند درصدش کم"
    },
    {
      "id": 34,
      "start": 8542.0,
      "end": 8547.0,
      "formatted_start": "02:22:22.000",
      "formatted_end": "02:22:27.000",
      "text": "نه چهید ندارید برنامه خدا مثلا چیز رویه گرفتهش دیگه"
    },
    {
      "id": 35,
      "start": 8547.0,
      "end": 8549.0,
      "formatted_start": "02:22:27.000",
      "formatted_end": "02:22:29.000",
      "text": "رویه گرفتهش قلن دیگه"
    },
    {
      "id": 36,
      "start": 8549.0,
      "end": 8555.0,
      "formatted_start": "02:22:29.000",
      "formatted_end": "02:22:35.000",
      "text": "درمیازی مثلا 5 درصد بود واسه که خودش مرد خود رو بیامرد استفاده درصدش"
    },
    {
      "id": 37,
      "start": 8555.0,
      "end": 8559.0,
      "formatted_start": "02:22:35.000",
      "formatted_end": "02:22:39.000",
      "text": "اما میگه این یه مشرکتی که شما بودند، اون نیست"
    },
    {
      "id": 38,
      "start": 8559.0,
      "end": 8563.0,
      "formatted_start": "02:22:39.000",
      "formatted_end": "02:22:43.000",
      "text": "هفته من، تازه ست من بود، همه تازه هفته من میریم"
    },
    {
      "id": 39,
      "start": 8563.0,
      "end": 8567.0,
      "formatted_start": "02:22:43.000",
      "formatted_end": "02:22:47.000",
      "text": "فیلمت اون باشه باز خوبه، مثلا پشت برد مورد بدن"
    },
    {
      "id": 40,
      "start": 8567.0,
      "end": 8572.0,
      "formatted_start": "02:22:47.000",
      "formatted_end": "02:22:52.000",
      "text": "آنها باید مخده ی بزرگ چیز، چند سال همین کامل از همین بیری دارد درد دارد"
    },
    {
      "id": 41,
      "start": 8572.0,
      "end": 8577.0,
      "formatted_start": "02:22:52.000",
      "formatted_end": "02:22:57.000",
      "text": "بهتر میشه، باید نورویل خوب و خوب که دروبه، بیایی مورد تبدیل"
    },
    {
      "id": 42,
      "start": 8577.0,
      "end": 8579.0,
      "formatted_start": "02:22:57.000",
      "formatted_end": "02:22:59.000",
      "text": "در روی رسید، دو هفته بید، آفته بید"
    },
    {
      "id": 43,
      "start": 8579.0,
      "end": 8583.12,
      "formatted_start": "02:22:59.000",
      "formatted_end": "02:23:03.120",
      "text": "آنان راهشم ترست می کنیم که پول دارو و پول چیزی رو یک بدن"
    },
    {
      "id": 44,
      "start": 8583.12,
      "end": 8586.0,
      "formatted_start": "02:23:03.120",
      "formatted_end": "02:23:06.000",
      "text": "من از هر سیستمون داریم رفت می کنم"
    },
    {
      "id": 45,
      "start": 8586.0,
      "end": 8590.38,
      "formatted_start": "02:23:06.000",
      "formatted_end": "02:23:10.380",
      "text": "شما هم زرمت می کشید"
    },
    {
      "id": 46,
      "start": 8590.38,
      "end": 8592.42,
      "formatted_start": "02:23:10.380",
      "formatted_end": "02:23:12.420",
      "text": "خدا خیلی"
    },
    {
      "id": 47,
      "start": 8592.42,
      "end": 8598.32,
      "formatted_start": "02:23:12.420",
      "formatted_end": "02:23:18.320",
      "text": "بایتکس بایتکس نفستان استیام می کنید"
    },
    {
      "id": 48,
      "start": 8598.32,
      "end": 8600.64,
      "formatted_start": "02:23:18.320",
      "formatted_end": "02:23:20.640",
      "text": "خواهید نکنم"
    },
    {
      "id": 49,
      "start": 8600.64,
      "end": 8602.82,
      "formatted_start": "02:23:20.640",
      "formatted_end": "02:23:22.820",
      "text": "زمین شور با بایتکس خواهید نکنم"
    },
    {
      "id": 50,
      "start": 8602.82,
      "end": 8604.56,
      "formatted_start": "02:23:22.820",
      "formatted_end": "02:23:24.560",
      "text": "هر چیز جدا باید باشه"
    },
    {
      "id": 51,
      "start": 8604.56,
      "end": 8608.04,
      "formatted_start": "02:23:24.560",
      "formatted_end": "02:23:28.040",
      "text": "اگر با همه ریزی یک بخار سمی تره"
    },
    {
      "id": 52,
      "start": 8608.04,
      "end": 8611.04,
      "formatted_start": "02:23:28.040",
      "formatted_end": "02:23:31.040",
      "text": "این افراد که کشنده است، این افراد مذبا مرد"
    },
    {
      "id": 53,
      "start": 8611.04,
      "end": 8614.04,
      "formatted_start": "02:23:31.040",
      "formatted_end": "02:23:34.040",
      "text": "باطی کرده بود، تمام چسون مفتاد"
    },
    {
      "id": 54,
      "start": 8614.04,
      "end": 8617.04,
      "formatted_start": "02:23:34.040",
      "formatted_end": "02:23:37.040",
      "text": "تا ببرن بیمار سرطان"
    },
    {
      "id": 55,
      "start": 8617.04,
      "end": 8620.04,
      "formatted_start": "02:23:37.040",
      "formatted_end": "02:23:40.040",
      "text": "آنها زیاد مردن مردن، خواله دینا دارن مردن"
    },
    {
      "id": 56,
      "start": 8620.04,
      "end": 8623.04,
      "formatted_start": "02:23:40.040",
      "formatted_end": "02:23:43.040",
      "text": "تو آنها خواله نگاه سر تو خانه خودتون ملازی"
    },
    {
      "id": 57,
      "start": 8623.04,
      "end": 8626.04,
      "formatted_start": "02:23:43.040",
      "formatted_end": "02:23:46.040",
      "text": "که میرد که تو نگاه میرد مردن بگیرن از تو خانه من"
    },
    {
      "id": 58,
      "start": 8626.04,
      "end": 8632.04,
      "formatted_start": "02:23:46.040",
      "formatted_end": "02:23:52.040",
      "text": "بچه ها که اصلا گار نگار دارند که مادر تو خانه هست"
    },
    {
      "id": 59,
      "start": 8632.04,
      "end": 8640.04,
      "formatted_start": "02:23:52.040",
      "formatted_end": "02:24:00.040",
      "text": "شوهران میدوام بشند، زود نمیدونند، مردم هم روشیدند، زن ها مریض بشند، مردم هم میدونند"
    },
    {
      "id": 60,
      "start": 8640.04,
      "end": 8647.04,
      "formatted_start": "02:24:00.040",
      "formatted_end": "02:24:07.040",
      "text": "خدا خیلی باشد، در درگاه بچه ها مریض بشند، خدا خیلی باشد، خدا خیلی باشد، خدا خیلی باشد"
    },
    {
      "id": 61,
      "start": 8647.04,
      "end": 8650.04,
      "formatted_start": "02:24:07.040",
      "formatted_end": "02:24:10.040",
      "text": "خدا خیلی باشد"
    },
    {
      "id": 62,
      "start": 8656.04,
      "end": 8666.04,
      "formatted_start": "02:24:16.040",
      "formatted_end": "02:24:26.040",
      "text": "موسیقی"
    },
    {
      "id": 63,
      "start": 8666.04,
      "end": 8676.04,
      "formatted_start": "02:24:26.040",
      "formatted_end": "02:24:36.040",
      "text": "موسیقی"
    },
    {
      "id": 64,
      "start": 8676.04,
      "end": 8678.04,
      "formatted_start": "02:24:36.040",
      "formatted_end": "02:24:38.040",
      "text": "بفرمایی ببینیم"
    },
    {
      "id": 65,
      "start": 8678.04,
      "end": 8679.04,
      "formatted_start": "02:24:38.040",
      "formatted_end": "02:24:39.040",
      "text": "بفرمایی"
    },
    {
      "id": 66,
      "start": 8679.04,
      "end": 8680.04,
      "formatted_start": "02:24:39.040",
      "formatted_end": "02:24:40.040",
      "text": "سلام"
    },
    {
      "id": 67,
      "start": 8680.04,
      "end": 8681.04,
      "formatted_start": "02:24:40.040",
      "formatted_end": "02:24:41.040",
      "text": "سلام"
    },
    {
      "id": 68,
      "start": 8681.04,
      "end": 8682.04,
      "formatted_start": "02:24:41.040",
      "formatted_end": "02:24:42.040",
      "text": "سلام"
    },
    {
      "id": 69,
      "start": 8682.04,
      "end": 8684.04,
      "formatted_start": "02:24:42.040",
      "formatted_end": "02:24:44.040",
      "text": "سلام مادرشان"
    },
    {
      "id": 70,
      "start": 8684.04,
      "end": 8685.04,
      "formatted_start": "02:24:44.040",
      "formatted_end": "02:24:45.040",
      "text": "سلام سلام"
    },
    {
      "id": 71,
      "start": 8685.04,
      "end": 8686.04,
      "formatted_start": "02:24:45.040",
      "formatted_end": "02:24:46.040",
      "text": "خیلی خوش آمدید"
    },
    {
      "id": 72,
      "start": 8686.04,
      "end": 8688.04,
      "formatted_start": "02:24:46.040",
      "formatted_end": "02:24:48.040",
