  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6007.24,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:07.240",
      "text": "یک ماه باید بخوره، دوباره آزمایش بده، این آزمایش شکراتین درست شد، الهم دارو بیمار."
    },
    {
      "id": 1,
      "start": 6007.24,
      "end": 6010.0,
      "formatted_start": "01:40:07.240",
      "formatted_end": "01:40:10.000",
      "text": "درست نشد، اصلاح پرده، برمشه اینو."
    },
    {
      "id": 2,
      "start": 6010.0,
      "end": 6011.0,
      "formatted_start": "01:40:10.000",
      "formatted_end": "01:40:11.000",
      "text": "آهان، خیلی مهم."
    },
    {
      "id": 3,
      "start": 6011.0,
      "end": 6011.5,
      "formatted_start": "01:40:11.000",
      "formatted_end": "01:40:11.500",
      "text": "حتی شدید؟"
    },
    {
      "id": 4,
      "start": 6011.5,
      "end": 6012.0,
      "formatted_start": "01:40:11.500",
      "formatted_end": "01:40:12.000",
      "text": "خیلی مهم."
    },
    {
      "id": 5,
      "start": 6012.0,
      "end": 6019.0,
      "formatted_start": "01:40:12.000",
      "formatted_end": "01:40:19.000",
      "text": "یعنی این راهش اینه، نه اینکه مثلا این دبایی که دادم قلطه بره، که هر جور بره، که هر جور بره، که هر جور بره، اول همینه."
    },
    {
      "id": 6,
      "start": 6019.0,
      "end": 6021.0,
      "formatted_start": "01:40:19.000",
      "formatted_end": "01:40:21.000",
      "text": "اون سوال درسته، آجو تو موشکرم."
    },
    {
      "id": 7,
      "start": 6021.0,
      "end": 6023.0,
      "formatted_start": "01:40:21.000",
      "formatted_end": "01:40:23.000",
      "text": "تازه شانسکیاره اینه بیده"
    },
    {
      "id": 8,
      "start": 6023.0,
      "end": 6027.0,
      "formatted_start": "01:40:23.000",
      "formatted_end": "01:40:27.000",
      "text": "من کبلشم نوشتم، کلیهشم نوشتم، چربیرم نوشتم"
    },
    {
      "id": 9,
      "start": 6027.0,
      "end": 6029.0,
      "formatted_start": "01:40:27.000",
      "formatted_end": "01:40:29.000",
      "text": "سه تا کار یه جاییم"
    },
    {
      "id": 10,
      "start": 6029.0,
      "end": 6033.0,
      "formatted_start": "01:40:29.000",
      "formatted_end": "01:40:33.000",
      "text": "ممنونم خدا خیلی تونه در ما ترک کرم، زنده باشین، خدا نگه داریم"
    },
    {
      "id": 11,
      "start": 6039.0,
      "end": 6041.0,
      "formatted_start": "01:40:39.000",
      "formatted_end": "01:40:41.000",
      "text": "سلام"
    },
    {
      "id": 12,
      "start": 6041.0,
      "end": 6043.0,
      "formatted_start": "01:40:41.000",
      "formatted_end": "01:40:43.000",
      "text": "بخورم آییم"
    },
    {
      "id": 13,
      "start": 6047.0,
      "end": 6049.0,
      "formatted_start": "01:40:47.000",
      "formatted_end": "01:40:49.000",
      "text": "بخورم آییم"
    },
    {
      "id": 14,
