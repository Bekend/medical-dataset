  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12329.98,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:29.980",
      "text": "اما اینجا همینجوری بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 12330.0,
      "end": 12332.5,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:32.500",
      "text": "از این ازاش قنده دیگه قیما بیدیم میکروب روش می‌کنیم"
    },
    {
      "id": 2,
      "start": 12332.5,
      "end": 12333.5,
      "formatted_start": "03:25:32.500",
      "formatted_end": "03:25:33.500",
      "text": "رژیم از راقب بیدیم"
    },
    {
      "id": 3,
      "start": 12333.5,
      "end": 12334.5,
      "formatted_start": "03:25:33.500",
      "formatted_end": "03:25:34.500",
      "text": "پل این رژیم باید بیدیم"
    },
    {
      "id": 4,
      "start": 12334.5,
      "end": 12335.5,
      "formatted_start": "03:25:34.500",
      "formatted_end": "03:25:35.500",
      "text": "رژیم بگیره از"
    },
    {
      "id": 5,
      "start": 12335.5,
      "end": 12337.5,
      "formatted_start": "03:25:35.500",
      "formatted_end": "03:25:37.500",
      "text": "خیلی ممنونم دکتور ماشکرم"
    },
    {
      "id": 6,
      "start": 12337.5,
      "end": 12338.5,
      "formatted_start": "03:25:37.500",
      "formatted_end": "03:25:38.500",
      "text": "ماشکرم مرسی"
    },
    {
      "id": 7,
      "start": 12338.5,
      "end": 12340.5,
      "formatted_start": "03:25:38.500",
      "formatted_end": "03:25:40.500",
      "text": "نجمه خانم بگیریم"
    },
    {
      "id": 8,
      "start": 12340.5,
      "end": 12342.5,
      "formatted_start": "03:25:40.500",
      "formatted_end": "03:25:42.500",
      "text": "رژیم نجمه خانم بگیریم"
    },
    {
      "id": 9,
      "start": 12346.5,
      "end": 12348.5,
      "formatted_start": "03:25:46.500",
      "formatted_end": "03:25:48.500",
      "text": "هم خوش نمی‌دهد"
    },
    {
      "id": 10,
      "start": 12348.5,
      "end": 12350.5,
      "formatted_start": "03:25:48.500",
      "formatted_end": "03:25:50.500",
      "text": "مالی هست دیگه هم خوش نمی‌دهد"
    },
    {
      "id": 11,
      "start": 12350.5,
      "end": 12352.5,
      "formatted_start": "03:25:50.500",
      "formatted_end": "03:25:52.500",
      "text": "بگو بگم بگو"
    },
    {
      "id": 12,
      "start": 12352.5,
      "end": 12354.5,
      "formatted_start": "03:25:52.500",
      "formatted_end": "03:25:54.500",
      "text": "چند بار برده زنده شده"
    },
    {
      "id": 13,
      "start": 12354.5,
      "end": 12355.5,
      "formatted_start": "03:25:54.500",
      "formatted_end": "03:25:55.500",
      "text": "چکر میدیم؟"
    },
    {
      "id": 14,
      "start": 12355.5,
      "end": 12356.5,
      "formatted_start": "03:25:55.500",
      "formatted_end": "03:25:56.500",
      "text": "آره"
    },
    {
      "id": 15,
      "start": 12356.5,
      "end": 12360.5,
      "formatted_start": "03:25:56.500",
      "formatted_end": "03:26:00.500",
      "text": "اینکه اینکه خود رو براشد بزنیم، تفزیل چیز نشونه براشد"
    },
    {
      "id": 16,
      "start": 12360.5,
      "end": 12362.5,
      "formatted_start": "03:26:00.500",
      "formatted_end": "03:26:02.500",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 17,
      "start": 12362.5,
      "end": 12367.5,
      "formatted_start": "03:26:02.500",
      "formatted_end": "03:26:07.500",
      "text": "اعتقاد من میخواستم اینو با آسانس هم رو برید، من نه خودش مثل برود برود باید"
    },
    {
      "id": 18,
      "start": 12367.5,
      "end": 12369.5,
      "formatted_start": "03:26:07.500",
      "formatted_end": "03:26:09.500",
      "text": "باید برداریم"
    },
    {
      "id": 19,
      "start": 12369.5,
      "end": 12371.5,
      "formatted_start": "03:26:09.500",
