      "formatted_start": "00:41:16.000",
      "formatted_end": "00:41:18.000",
      "text": "برای اندوشان خردار می آرد"
    },
    {
      "id": 23,
      "start": 2478.0,
      "end": 2480.0,
      "formatted_start": "00:41:18.000",
      "formatted_end": "00:41:20.000",
      "text": "برای اندوشان خردار می آرد"
    },
    {
      "id": 24,
      "start": 2480.0,
      "end": 2482.0,
      "formatted_start": "00:41:20.000",
      "formatted_end": "00:41:22.000",
      "text": "خانم آبی"
    },
    {
      "id": 25,
      "start": 2482.0,
      "end": 2484.0,
      "formatted_start": "00:41:22.000",
      "formatted_end": "00:41:24.000",
      "text": "که برگاه هستند"
    },
    {
      "id": 26,
      "start": 2484.0,
      "end": 2486.0,
      "formatted_start": "00:41:24.000",
      "formatted_end": "00:41:26.000",
      "text": "سلام"
    },
    {
      "id": 27,
      "start": 2486.0,
      "end": 2488.0,
      "formatted_start": "00:41:26.000",
      "formatted_end": "00:41:28.000",
      "text": "چیز گرفتند"
    },
    {
      "id": 28,
      "start": 2488.0,
      "end": 2490.0,
      "formatted_start": "00:41:28.000",
      "formatted_end": "00:41:30.000",
      "text": "گروه گرفتند"
    },
    {
      "id": 29,
      "start": 2490.0,
      "end": 2492.0,
      "formatted_start": "00:41:30.000",
      "formatted_end": "00:41:32.000",
      "text": "نیلیتون ها برای شما همگه هستند"
    },
    {
      "id": 30,
      "start": 2492.0,
      "end": 2494.0,
      "formatted_start": "00:41:32.000",
      "formatted_end": "00:41:34.000",
      "text": "دارید باشید"
    },
    {
      "id": 31,
      "start": 2494.0,
      "end": 2496.0,
      "formatted_start": "00:41:34.000",
      "formatted_end": "00:41:36.000",
      "text": "و اینکه معنون رو که زدم"
    },
    {
      "id": 32,
      "start": 2496.0,
      "end": 2498.0,
      "formatted_start": "00:41:36.000",
      "formatted_end": "00:41:38.000",
      "text": "اونه تابع گرفتم"
    },
    {
      "id": 33,
      "start": 2498.0,
      "end": 2500.0,
      "formatted_start": "00:41:38.000",
      "formatted_end": "00:41:40.000",
      "text": "رفت داریم با من"
    },
    {
      "id": 34,
      "start": 2500.0,
      "end": 2502.0,
      "formatted_start": "00:41:40.000",
      "formatted_end": "00:41:42.000",
      "text": "معنون چی بوده؟"
    },
    {
      "id": 35,
      "start": 2502.0,
      "end": 2504.0,
      "formatted_start": "00:41:42.000",
      "formatted_end": "00:41:44.000",
      "text": "اگر معنون نیلا سمیت نداره"
    },
    {
      "id": 36,
      "start": 2504.0,
      "end": 2506.0,
      "formatted_start": "00:41:44.000",
      "formatted_end": "00:41:46.000",
      "text": "نوشته زن برگاه میتونه است کادر نکنه"
    },
    {
      "id": 37,
      "start": 2506.0,
      "end": 2508.0,
      "formatted_start": "00:41:46.000",
      "formatted_end": "00:41:48.000",
      "text": "چون بگرفتم همون توش گرفتم"
    },
    {
      "id": 38,
      "start": 2508.0,
      "end": 2512.0,
      "formatted_start": "00:41:48.000",
      "formatted_end": "00:41:52.000",
      "text": "بله تو بگو اشکار نداره دمیترون بخوره برای تهام بوش دمیترون بخوره"
    },
    {
      "id": 39,
      "start": 2512.0,
      "end": 2513.0,
      "formatted_start": "00:41:52.000",
      "formatted_end": "00:41:53.000",
      "text": "ماه چندومه؟"
    },
    {
      "id": 40,
      "start": 2513.0,
      "end": 2514.0,
      "formatted_start": "00:41:53.000",
      "formatted_end": "00:41:54.000",
      "text": "هشتوم"
    },
    {
      "id": 41,
      "start": 2514.0,
      "end": 2517.0,
      "formatted_start": "00:41:54.000",
      "formatted_end": "00:41:57.000",
      "text": "آه هشتوم بله بگو دمیترون بخوره برای تهام بوش"
    },
    {
      "id": 42,
      "start": 2517.0,
      "end": 2521.0,
      "formatted_start": "00:41:57.000",
      "formatted_end": "00:42:01.000",
      "text": "بله صمیت نداره از گوش رو کارش برام خورده اشکاری نداره"
    },
    {
      "id": 43,
      "start": 2521.0,
      "end": 2523.0,
      "formatted_start": "00:42:01.000",
      "formatted_end": "00:42:03.000",
      "text": "دفت میتونم دومی همه سفاده کنم"
    },
    {
      "id": 44,
      "start": 2523.0,
      "end": 2526.0,
      "formatted_start": "00:42:03.000",
      "formatted_end": "00:42:06.000",
      "text": "بله اصلا خطر نداره روش نمیشه زنباردار مجازه است"
    },
    {
      "id": 45,
      "start": 2526.0,
      "end": 2529.0,
      "formatted_start": "00:42:06.000",
      "formatted_end": "00:42:09.000",
      "text": "صمیت نداره اون کیاهیه صمیت از گوش روش برام خورده"
    },
    {
      "id": 46,
      "start": 2529.0,
      "end": 2529.5,
      "formatted_start": "00:42:09.000",
      "formatted_end": "00:42:09.500",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 2529.5,
      "end": 2531.0,
      "formatted_start": "00:42:09.500",
      "formatted_end": "00:42:11.000",
      "text": "جمعیت هرمون"
    },
    {
      "id": 48,
      "start": 2531.0,
      "end": 2534.0,
      "formatted_start": "00:42:11.000",
      "formatted_end": "00:42:14.000",
      "text": "آسیب من نمیدونم بدن هایی ایچه"
    },
    {
      "id": 49,
      "start": 2534.0,
      "end": 2538.0,
      "formatted_start": "00:42:14.000",
      "formatted_end": "00:42:18.000",
      "text": "خلافه چه فارشی که اینا در میداره"
    },
    {
      "id": 50,
      "start": 2538.0,
      "end": 2539.0,
      "formatted_start": "00:42:18.000",
      "formatted_end": "00:42:19.000",
      "text": "ببینم فارش"
    },
    {
      "id": 51,
      "start": 2539.0,
      "end": 2541.0,
      "formatted_start": "00:42:19.000",
      "formatted_end": "00:42:21.000",
      "text": "توی قام هست؟"
    },
    {
      "id": 52,
      "start": 2541.0,
      "end": 2542.0,
      "formatted_start": "00:42:21.000",
      "formatted_end": "00:42:22.000",
      "text": "هر جایی فارش هست"
    },
    {
      "id": 53,
      "start": 2542.0,
      "end": 2543.0,
      "formatted_start": "00:42:22.000",
      "formatted_end": "00:42:23.000",
      "text": "هر جایی بدن لخته"
    },
    {
      "id": 54,
      "start": 2543.0,
      "end": 2544.0,
      "formatted_start": "00:42:23.000",
      "formatted_end": "00:42:24.000",
      "text": "مخون همونجایی که"
    },
    {
      "id": 55,
      "start": 2544.0,
      "end": 2545.0,
      "formatted_start": "00:42:24.000",
      "formatted_end": "00:42:25.000",
      "text": "هیچ جایی باقی؟"
    },
    {
      "id": 56,
      "start": 2545.0,
      "end": 2546.0,
      "formatted_start": "00:42:25.000",
      "formatted_end": "00:42:26.000",
      "text": "نه نه نه همونجا نه نه"
    },
    {
      "id": 57,
      "start": 2546.0,
      "end": 2547.0,
      "formatted_start": "00:42:26.000",
      "formatted_end": "00:42:27.000",
      "text": "اینجا؟"
    },
    {
      "id": 58,
      "start": 2547.0,
      "end": 2548.0,
      "formatted_start": "00:42:27.000",
      "formatted_end": "00:42:28.000",
      "text": "هر جایی دوست داره"
    },
    {
      "id": 59,
      "start": 2548.0,
      "end": 2549.0,
      "formatted_start": "00:42:28.000",
      "formatted_end": "00:42:29.000",
      "text": "هر جایی باقی"
    },
    {
      "id": 60,
      "start": 2549.0,
      "end": 2551.0,
      "formatted_start": "00:42:29.000",
      "formatted_end": "00:42:31.000",
      "text": "مشمارو با داشتم که این بدنه ای"
    },
    {
      "id": 61,
      "start": 2552.0,
      "end": 2554.0,
      "formatted_start": "00:42:32.000",
      "formatted_end": "00:42:34.000",
      "text": "توی قام اینجا هست؟"
    },
    {
      "id": 62,
      "start": 2554.0,
      "end": 2556.0,
      "formatted_start": "00:42:34.000",
      "formatted_end": "00:42:36.000",
      "text": "اینجا خیلی زیاده"
    },
    {
      "id": 63,
      "start": 2556.0,
      "end": 2558.0,
      "formatted_start": "00:42:36.000",
      "formatted_end": "00:42:38.000",
      "text": "بعد آنوش هم دارم"
    },
    {
      "id": 64,
      "start": 2558.0,
      "end": 2560.0,
      "formatted_start": "00:42:38.000",
      "formatted_end": "00:42:40.000",
      "text": "بعده؟"
    },
    {
      "id": 65,
      "start": 2560.0,
      "end": 2562.0,
      "formatted_start": "00:42:40.000",
      "formatted_end": "00:42:42.000",
      "text": "بعده آنوش هم باید نیست بله"
    },
    {
      "id": 66,
      "start": 2562.0,
      "end": 2564.0,
      "formatted_start": "00:42:42.000",
      "formatted_end": "00:42:44.000",
      "text": "چیز شیرین نباید بخورید"
    },
    {
      "id": 67,
      "start": 2564.0,
      "end": 2566.0,
      "formatted_start": "00:42:44.000",
      "formatted_end": "00:42:46.000",
      "text": "آهان"
    },
    {
      "id": 68,
      "start": 2566.0,
      "end": 2568.0,
      "formatted_start": "00:42:46.000",
      "formatted_end": "00:42:48.000",
      "text": "هم چیز شیرین بخورید"
    },
    {
      "id": 69,
      "start": 2568.0,
      "end": 2570.0,
      "formatted_start": "00:42:48.000",
      "formatted_end": "00:42:50.000",
      "text": "خوارش هم زیاد میده؟"
    },
    {
      "id": 70,
      "start": 2570.0,
      "end": 2572.0,
      "formatted_start": "00:42:50.000",
      "formatted_end": "00:42:52.000",
      "text": "بله خیلی مخورید"
    },
    {
      "id": 71,
      "start": 2572.0,
      "end": 2574.0,
      "formatted_start": "00:42:52.000",
      "formatted_end": "00:42:54.000",
      "text": "خوب خوب میشه باید دوباره جاش میده"
    },
    {
      "id": 72,
      "start": 2574.0,
      "end": 2576.0,
      "formatted_start": "00:42:54.000",
      "formatted_end": "00:42:56.000",
      "text": "بله دوباره میده"
    },
    {
      "id": 73,
      "start": 2576.0,
      "end": 2578.0,
      "formatted_start": "00:42:56.000",
      "formatted_end": "00:42:58.000",
      "text": "باید سابون استفاده نکنید"
    },
    {
      "id": 74,
      "start": 2578.0,
      "end": 2580.0,
      "formatted_start": "00:42:58.000",
      "formatted_end": "00:43:00.000",
      "text": "سابون... یه شامپو بگم داده"
    },
    {
      "id": 75,
      "start": 2580.0,
      "end": 2582.0,
      "formatted_start": "00:43:00.000",
      "formatted_end": "00:43:02.000",
      "text": "اونها استفاده میکنن"
    },
    {
      "id": 76,
      "start": 2582.0,
      "end": 2584.0,
      "formatted_start": "00:43:02.000",
      "formatted_end": "00:43:04.000",
      "text": "بعده؟"
    },
    {
      "id": 77,
      "start": 2584.0,
      "end": 2588.0,
      "formatted_start": "00:43:04.000",
      "formatted_end": "00:43:08.000",
      "text": "دارو های خیلی دو معلوم هستند، از کنون هستند کسی ندارد"
    },
    {
      "id": 78,
      "start": 2588.0,
      "end": 2590.0,
      "formatted_start": "00:43:08.000",
      "formatted_end": "00:43:10.000",
      "text": "ازار کرا دارو شده بود"
    },
    {
      "id": 79,
      "start": 2590.0,
      "end": 2592.0,
      "formatted_start": "00:43:10.000",
      "formatted_end": "00:43:12.000",
      "text": "دارو یکی از کنون باید بزرگ کنند"
    },
    {
      "id": 80,
      "start": 2592.0,
      "end": 2594.0,
      "formatted_start": "00:43:12.000",
      "formatted_end": "00:43:14.000",
      "text": "چرا اینجا نیست؟ من نبیدم"
    },
    {
      "id": 81,
      "start": 2594.0,
      "end": 2596.0,
      "formatted_start": "00:43:14.000",
      "formatted_end": "00:43:16.000",
      "text": "من نیستم شاهدیت نشینم"
    },
    {
      "id": 82,
      "start": 2596.0,
      "end": 2598.0,
      "formatted_start": "00:43:16.000",
      "formatted_end": "00:43:18.000",
      "text": "کدوم شهر شاهدیه؟ شاهدیت زیار بیرون"
    },
    {
      "id": 83,
      "start": 2598.0,
      "end": 2600.0,
      "formatted_start": "00:43:18.000",
      "formatted_end": "00:43:20.000",
      "text": "در سبب سبب تیره نشد"
    },
    {
      "id": 84,
      "start": 2600.0,
      "end": 2602.0,
      "formatted_start": "00:43:20.000",
      "formatted_end": "00:43:22.000",
      "text": "در اینجا"
    },
    {
      "id": 85,
      "start": 2604.0,
      "end": 2606.0,
      "formatted_start": "00:43:24.000",
      "formatted_end": "00:43:26.000",
      "text": "آزمایش هم چیز نشونند"
    },
    {
      "id": 86,
      "start": 2606.0,
      "end": 2608.0,
      "formatted_start": "00:43:26.000",
      "formatted_end": "00:43:28.000",
      "text": "همه رو نزدیک نمیستند"
    },
    {
      "id": 87,
      "start": 2608.0,
      "end": 2610.0,
      "formatted_start": "00:43:28.000",
      "formatted_end": "00:43:30.000",
      "text": "هیچ فایده ندارد"
    },
    {
      "id": 88,
      "start": 2610.0,
      "end": 2616.0,
      "formatted_start": "00:43:30.000",
      "formatted_end": "00:43:36.000",
      "text": "بدنی ریمونتون شب"
    },
    {
      "id": 89,
      "start": 2616.0,
      "end": 2621.0,
      "formatted_start": "00:43:36.000",
      "formatted_end": "00:43:41.000",
      "text": "سابون ممنون"
    },
    {
      "id": 90,
      "start": 2621.0,
      "end": 2627.0,
      "formatted_start": "00:43:41.000",
      "formatted_end": "00:43:47.000",
      "text": "تا ده سال باید فقط همین شامکو بدن استفاده بکنید"
