  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2402.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:02.000",
      "text": "میشه فردا بیام؟"
    },
    {
      "id": 1,
      "start": 2402.0,
      "end": 2404.0,
      "formatted_start": "00:40:02.000",
      "formatted_end": "00:40:04.000",
      "text": "یا فردا بیام، یا پس فردا بیام."
    },
    {
      "id": 2,
      "start": 2404.0,
      "end": 2406.0,
      "formatted_start": "00:40:04.000",
      "formatted_end": "00:40:06.000",
      "text": "شما باوشه، الله دیگه خود داره."
    },
    {
      "id": 3,
      "start": 2406.0,
      "end": 2410.0,
      "formatted_start": "00:40:06.000",
      "formatted_end": "00:40:10.000",
      "text": "یا پس فردای سری خودشان هستن شاید برگرده بیده شاند."
    },
    {
      "id": 4,
      "start": 2410.0,
      "end": 2412.0,
      "formatted_start": "00:40:10.000",
      "formatted_end": "00:40:12.000",
      "text": "اجازه بگیر."
    },
    {
      "id": 5,
      "start": 2412.0,
      "end": 2414.0,
      "formatted_start": "00:40:12.000",
      "formatted_end": "00:40:14.000",
      "text": "باشه، فردا بیام."
    },
    {
      "id": 6,
      "start": 2414.0,
      "end": 2416.0,
      "formatted_start": "00:40:14.000",
      "formatted_end": "00:40:16.000",
      "text": "باشه."
    },
    {
      "id": 7,
      "start": 2421.0,
      "end": 2423.0,
      "formatted_start": "00:40:21.000",
      "formatted_end": "00:40:23.000",
      "text": "سه ماه سبر کردی."
    },
    {
      "id": 8,
      "start": 2423.0,
      "end": 2430.0,
      "formatted_start": "00:40:23.000",
      "formatted_end": "00:40:30.000",
      "text": "آره، نباید، این، پا منم، واسه که پا منم، نو، قا چه، نمیدونیم چی، پا چه بیاد کنم."
    },
    {
      "id": 9,
      "start": 2430.0,
      "end": 2432.0,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:32.000",
