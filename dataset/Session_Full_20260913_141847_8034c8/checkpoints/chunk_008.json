    },
    {
      "id": 10,
      "start": 2452.0,
      "end": 2454.0,
      "formatted_start": "00:40:52.000",
      "formatted_end": "00:40:54.000",
      "text": "این چیز داره باری زنده"
    },
    {
      "id": 11,
      "start": 2454.0,
      "end": 2456.0,
      "formatted_start": "00:40:54.000",
      "formatted_end": "00:40:56.000",
      "text": "بگیر و بیر"
    },
    {
      "id": 12,
      "start": 2456.0,
      "end": 2458.0,
      "formatted_start": "00:40:56.000",
      "formatted_end": "00:40:58.000",
      "text": "برای اندوشان خردار می آرد"
    },
    {
      "id": 13,
      "start": 2458.0,
      "end": 2460.0,
      "formatted_start": "00:40:58.000",
      "formatted_end": "00:41:00.000",
      "text": "برای اندوشان خردار می آرد"
    },
    {
