    },
    {
      "id": 18,
      "start": 2468.0,
      "end": 2470.0,
      "formatted_start": "00:41:08.000",
      "formatted_end": "00:41:10.000",
      "text": "برای اندوشان خردار می آرد"
    },
    {
      "id": 19,
      "start": 2470.0,
      "end": 2472.0,
      "formatted_start": "00:41:10.000",
      "formatted_end": "00:41:12.000",
