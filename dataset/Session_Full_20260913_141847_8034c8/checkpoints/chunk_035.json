      "formatted_end": "02:55:30.000",
      "text": "اگر باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید"
    },
    {
      "id": 1,
      "start": 10530.0,
      "end": 10550.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 10550.0,
      "end": 10572.0,
      "formatted_start": "02:55:50.000",
      "formatted_end": "02:56:12.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 10572.0,
      "end": 10574.0,
      "formatted_start": "02:56:12.000",
      "formatted_end": "02:56:14.000",
      "text": "خوشی کار نداشته باشی تا چه؟"
    },
    {
      "id": 4,
      "start": 10582.8,
      "end": 10584.8,
      "formatted_start": "02:56:22.800",
      "formatted_end": "02:56:24.800",
      "text": "خوشی کار نداشته باشی تا چه؟"
    },
    {
      "id": 5,
      "start": 10584.8,
      "end": 10586.8,
      "formatted_start": "02:56:24.800",
      "formatted_end": "02:56:26.800",
      "text": "هر تا دیگه"
    },
    {
      "id": 6,
      "start": 10602.0,
      "end": 10622.0,
      "formatted_start": "02:56:42.000",
      "formatted_end": "02:57:02.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 10622.0,
      "end": 10651.98,
      "formatted_start": "02:57:02.000",
      "formatted_end": "02:57:31.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 8,
      "start": 10652.0,
      "end": 10676.0,
      "formatted_start": "02:57:32.000",
      "formatted_end": "02:57:56.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 10676.0,
      "end": 10682.56,
      "formatted_start": "02:57:56.000",
      "formatted_end": "02:58:02.560",
      "text": "بله سلامتون ببینیم این مثلا من 16 هم انتخاب می کنم 294 بیان"
    },
    {
      "id": 10,
      "start": 10682.56,
      "end": 10685.6,
      "formatted_start": "02:58:02.560",
      "formatted_end": "02:58:05.600",
      "text": "15 همه که انتخاب کنم 270 در برده اینکه انتخاب"
    },
    {
      "id": 11,
      "start": 10685.6,
      "end": 10690.16,
      "formatted_start": "02:58:05.600",
      "formatted_end": "02:58:10.160",
      "text": "حالا من این 16 هم انتخاب کنم بیشتر از این هستش"
    },
    {
      "id": 12,
      "start": 10690.16,
      "end": 10692.56,
      "formatted_start": "02:58:10.160",
      "formatted_end": "02:58:12.560",
      "text": "حالا باید تقیید باید بگیر انتخاب بکنیم"
    },
    {
      "id": 13,
      "start": 10692.56,
      "end": 10695.36,
      "formatted_start": "02:58:12.560",
      "formatted_end": "02:58:15.360",
      "text": "یکشون باید انتخاب کنه 294 رو داره انتخاب میکنه"
    },
    {
      "id": 14,
      "start": 10695.36,
      "end": 10699.2,
      "formatted_start": "02:58:15.360",
      "formatted_end": "02:58:19.200",
      "text": "من تقیید نزدم باید میشه کم کهرم؟ نه تقیید نزدم"
    },
    {
      "id": 15,
      "start": 10699.2,
      "end": 10700.96,
      "formatted_start": "02:58:19.200",
      "formatted_end": "02:58:20.960",
      "text": "باید چی کار کنیم اینجا؟"
    },
    {
      "id": 16,
      "start": 10700.96,
      "end": 10704.56,
      "formatted_start": "02:58:20.960",
      "formatted_end": "02:58:24.560",
      "text": "هیچ ماشه تونم گوشی برای نداشت سعی زدن برای مادرن گوشی رو برای نداشت"
    },
    {
      "id": 17,
      "start": 10707.06,
      "end": 10711.56,
      "formatted_start": "02:58:27.060",
      "formatted_end": "02:58:31.560",
      "text": "ببینید الان برای دیویس ۹۴ که میاد من تعیید رو نزدم"
    },
    {
      "id": 18,
      "start": 10711.56,
      "end": 10715.56,
      "formatted_start": "02:58:31.560",
      "formatted_end": "02:58:35.560",
      "text": "باید یک شو انتحاب کنیم با دست نمیتونیم بریم دیویس ۹۲"
    },
    {
      "id": 19,
      "start": 10715.56,
      "end": 10717.56,
      "formatted_start": "02:58:35.560",
      "formatted_end": "02:58:37.560",
      "text": "یا شاید میشه من برای دستخیرم"
    },
    {
      "id": 20,
      "start": 10717.56,
      "end": 10721.06,
      "formatted_start": "02:58:37.560",
      "formatted_end": "02:58:41.060",
      "text": "آره آره خب الان این دیویس ۹۴ میاد"
    },
    {
      "id": 21,
      "start": 10725.06,
      "end": 10728.36,
      "formatted_start": "02:58:45.060",
      "formatted_end": "02:58:48.360",
      "text": "خب اون خیلی کمتر میشه از دیویس ۲ و باز"
    },
    {
      "id": 22,
      "start": 10728.36,
      "end": 10758.36,
      "formatted_start": "02:58:48.360",
      "formatted_end": "02:59:18.360",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 23,
      "start": 10758.36,
      "end": 10764.36,
      "formatted_start": "02:59:18.360",
      "formatted_end": "02:59:24.360",
      "text": "این دقیقه نمیفترد دویست نمیدونه"
    },
    {
      "id": 24,
      "start": 10764.36,
      "end": 10768.36,
      "formatted_start": "02:59:24.360",
      "formatted_end": "02:59:28.360",
      "text": "مثلا دویست و هشت را ادار باشه"
    },
    {
      "id": 25,
      "start": 10768.36,
      "end": 10770.36,
      "formatted_start": "02:59:28.360",
      "formatted_end": "02:59:30.360",
      "text": "باش باش"
    },
    {
      "id": 26,
      "start": 10770.36,
      "end": 10772.36,
      "formatted_start": "02:59:30.360",
      "formatted_end": "02:59:32.360",
      "text": "الان یه رست تغییر بدن ببینم"
    },
    {
      "id": 27,
      "start": 10772.36,
      "end": 10774.36,
      "formatted_start": "02:59:32.360",
      "formatted_end": "02:59:34.360",
      "text": "اگر یه نفر ادارش خیلی بزرگ باشه"
    },
    {
      "id": 28,
      "start": 10774.36,
      "end": 10776.36,
      "formatted_start": "02:59:34.360",
      "formatted_end": "02:59:36.360",
      "text": "ادار را بیچیده نمیتونه انتخاب کنه"
    },
    {
      "id": 29,
      "start": 10776.36,
      "end": 10778.36,
      "formatted_start": "02:59:36.360",
      "formatted_end": "02:59:38.360",
      "text": "چه کاری این باشه؟"
    },
    {
      "id": 30,
      "start": 10778.36,
      "end": 10780.36,
      "formatted_start": "02:59:38.360",
      "formatted_end": "02:59:40.360",
      "text": "این را انتخاب کنید"
    },
    {
      "id": 31,
      "start": 10780.36,
      "end": 10782.36,
      "formatted_start": "02:59:40.360",
      "formatted_end": "02:59:42.360",
      "text": "انتخابش که می کنید"
    },
    {
      "id": 32,
      "start": 10782.36,
      "end": 10784.36,
      "formatted_start": "02:59:42.360",
      "formatted_end": "02:59:44.360",
      "text": "ادار بزرگ بید تغییر کنید"
    },
    {
      "id": 33,
      "start": 10784.36,
      "end": 10786.36,
      "formatted_start": "02:59:44.360",
      "formatted_end": "02:59:46.360",
      "text": "دیگه دویست نمیدونه دو تغییر میشوند"
    },
    {
      "id": 34,
      "start": 10786.36,
      "end": 10788.36,
      "formatted_start": "02:59:46.360",
      "formatted_end": "02:59:48.360",
      "text": "دیویس نمی دو تایید میشون برد"
    },
    {
      "id": 35,
      "start": 10788.36,
      "end": 10790.36,
      "formatted_start": "02:59:48.360",
      "formatted_end": "02:59:50.360",
      "text": "دیویس نمی چهار تایید"
    },
    {
      "id": 36,
      "start": 10790.36,
      "end": 10792.36,
      "formatted_start": "02:59:50.360",
      "formatted_end": "02:59:52.360",
      "text": "بخش ۴ تایید میشه اینجا"
    },
    {
      "id": 37,
      "start": 10792.36,
      "end": 10794.36,
      "formatted_start": "02:59:52.360",
      "formatted_end": "02:59:54.360",
      "text": "بله"
    },
    {
      "id": 38,
      "start": 10794.36,
      "end": 10796.36,
      "formatted_start": "02:59:54.360",
      "formatted_end": "02:59:56.360",
      "text": "آنه یه رو سرمی بیدار کم میشه"
    },
    {
      "id": 39,
      "start": 10796.36,
      "end": 10798.36,
      "formatted_start": "02:59:56.360",
      "formatted_end": "02:59:58.360",
      "text": "ولی"
    },
    {
      "id": 40,
      "start": 10798.36,
      "end": 10800.36,
      "formatted_start": "02:59:58.360",
      "formatted_end": "03:00:00.360",
      "text": "واسلش باز بود"
    }
  ],
