      "end": 656.0,
      "formatted_start": "00:10:54.000",
      "formatted_end": "00:10:56.000",
      "text": "اما شننده باشه"
    },
    {
      "id": 9,
      "start": 656.0,
      "end": 658.0,
      "formatted_start": "00:10:56.000",
      "formatted_end": "00:10:58.000",
      "text": "برن دید"
    },
    {
      "id": 10,
      "start": 660.0,
      "end": 672.0,
      "formatted_start": "00:11:00.000",
      "formatted_end": "00:11:12.000",
