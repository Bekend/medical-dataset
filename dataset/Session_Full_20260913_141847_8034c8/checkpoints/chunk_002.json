      "end": 636.0,
      "formatted_start": "00:10:34.000",
      "formatted_end": "00:10:36.000",
      "text": "آنها برن"
    },
    {
      "id": 4,
      "start": 638.0,
      "end": 640.0,
      "formatted_start": "00:10:38.000",
      "formatted_end": "00:10:40.000",
      "text": "درمون"
    },
    {
      "id": 5,
