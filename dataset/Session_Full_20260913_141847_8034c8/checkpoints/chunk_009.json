      "id": 19,
      "start": 2859.32,
      "end": 2860.72,
      "formatted_start": "00:47:39.320",
      "formatted_end": "00:47:40.720",
      "text": "نشانی دی که این تو چه"
    },
    {
      "id": 20,
      "start": 2860.72,
      "end": 2862.52,
      "formatted_start": "00:47:40.720",
      "formatted_end": "00:47:42.520",
      "text": "سینوزی داره"
    },
    {
      "id": 21,
      "start": 2862.52,
      "end": 2864.08,
      "formatted_start": "00:47:42.520",
      "formatted_end": "00:47:44.080",
      "text": "سقه دورنگ"
    },
    {
      "id": 22,
      "start": 2864.08,
      "end": 2867.32,
      "formatted_start": "00:47:44.080",
      "formatted_end": "00:47:47.320",
      "text": "سمت مامان نگاه کن"
    },
    {
      "id": 23,
      "start": 2867.32,
      "end": 2870.14,
      "formatted_start": "00:47:47.320",
      "formatted_end": "00:47:50.140",
      "text": "آب در برد برد"
    },
    {
      "id": 24,
      "start": 2870.14,
      "end": 2871.74,
      "formatted_start": "00:47:50.140",
      "formatted_end": "00:47:51.740",
      "text": "سرمه بزن"
    },
    {
      "id": 25,
      "start": 2871.74,
      "end": 2873.56,
      "formatted_start": "00:47:51.740",
      "formatted_end": "00:47:53.560",
      "text": "کمپونی هم داره"
    },
    {
      "id": 26,
      "start": 2873.56,
      "end": 2875.54,
      "formatted_start": "00:47:53.560",
      "formatted_end": "00:47:55.540",
      "text": "شدید کمپونی داره"
    },
    {
      "id": 27,
      "start": 2875.54,
      "end": 2877.1,
      "formatted_start": "00:47:55.540",
      "formatted_end": "00:47:57.100",
      "text": "بیهالی داره"
    },
    {
      "id": 28,
      "start": 2877.1,
      "end": 2878.82,
      "formatted_start": "00:47:57.100",
      "formatted_end": "00:47:58.820",
      "text": "دست بزنید"
    },
    {
      "id": 29,
      "start": 2878.82,
      "end": 2883.82,
      "formatted_start": "00:47:58.820",
      "formatted_end": "00:48:03.820",
      "text": "سی روزی تنفرده. آبه نونم نیمی خوره، هیپش میاد نون رو باشه مو خوره. نه؟"
    },
    {
      "id": 30,
      "start": 2883.82,
      "end": 2888.82,
      "formatted_start": "00:48:03.820",
      "formatted_end": "00:48:08.820",
      "text": "آبه دیگه غذا که دیگه این رو بزرگ باشه. باباشو زیاد پیش داره. نه؟ نوناشو نمی خوره."
    },
    {
      "id": 31,
      "start": 2888.82,
      "end": 2893.82,
      "formatted_start": "00:48:08.820",
      "formatted_end": "00:48:13.820",
      "text": "خلیبونه زیاد مو خوره آبه. نه؟ نون شده. غذایی خوب نمی خوره."
    },
    {
      "id": 32,
      "start": 2893.82,
      "end": 2900.82,
      "formatted_start": "00:48:13.820",
      "formatted_end": "00:48:20.820",
      "text": "حسن نون نمی خوره. نه؟ برنج باشه، مکارولی باشه یه ذریبی خوره، آن نون میانه نه داره."
    },
    {
      "id": 33,
      "start": 2900.82,
      "end": 2904.82,
      "formatted_start": "00:48:20.820",
      "formatted_end": "00:48:24.820",
      "text": "که اینو خوردی؟ نه اونو باید تره"
    },
    {
      "id": 34,
      "start": 2904.82,
      "end": 2906.82,
      "formatted_start": "00:48:24.820",
      "formatted_end": "00:48:26.820",
      "text": "صورت که صبح هست نه بود"
    },
    {
      "id": 35,
      "start": 2906.82,
      "end": 2910.82,
      "formatted_start": "00:48:26.820",
      "formatted_end": "00:48:30.820",
      "text": "نه بود، نونیه نه، این صورت باید درست کن شده"
    },
    {
      "id": 36,
      "start": 2912.82,
      "end": 2914.82,
      "formatted_start": "00:48:32.820",
      "formatted_end": "00:48:34.820",
      "text": "مخوردی دوست داری؟"
    },
    {
      "id": 37,
      "start": 2914.82,
      "end": 2915.82,
      "formatted_start": "00:48:34.820",
      "formatted_end": "00:48:35.820",
      "text": "نه"
    },
    {
      "id": 38,
      "start": 2915.82,
      "end": 2918.82,
      "formatted_start": "00:48:35.820",
      "formatted_end": "00:48:38.820",
      "text": "برخوردتن هم دوست داری، همین دوست داری"
    },
    {
      "id": 39,
      "start": 2918.82,
      "end": 2921.82,
      "formatted_start": "00:48:38.820",
      "formatted_end": "00:48:41.820",
      "text": "خیلی خوب، خیلی خوب، دوست داری"
    },
    {
      "id": 40,
      "start": 2921.82,
      "end": 2923.82,
      "formatted_start": "00:48:41.820",
      "formatted_end": "00:48:43.820",
      "text": "این دیگه از باز مایشون داره باشه"
    },
    {
      "id": 41,
      "start": 2923.82,
      "end": 2926.82,
      "formatted_start": "00:48:43.820",
      "formatted_end": "00:48:46.820",
      "text": "آره، بچه"
    },
    {
      "id": 42,
      "start": 2930.82,
      "end": 2932.22,
      "formatted_start": "00:48:50.820",
      "formatted_end": "00:48:52.220",
      "text": "خوندورسکه هستیم بچه ها؟"
    },
    {
      "id": 43,
      "start": 2932.22,
      "end": 2932.54,
      "formatted_start": "00:48:52.220",
      "formatted_end": "00:48:52.540",
      "text": "بله"
    },
    {
      "id": 44,
      "start": 2932.54,
      "end": 2933.6,
      "formatted_start": "00:48:52.540",
      "formatted_end": "00:48:53.600",
      "text": "بوردکه هستیم؟"
    },
    {
      "id": 45,
      "start": 2933.6,
      "end": 2933.84,
      "formatted_start": "00:48:53.600",
      "formatted_end": "00:48:53.840",
      "text": "بله"
    },
    {
      "id": 46,
      "start": 2960.82,
      "end": 2962.82,
      "formatted_start": "00:49:20.820",
      "formatted_end": "00:49:22.820",
      "text": "قدم رو میارون دیده باشون"
    },
    {
      "id": 47,
      "start": 2962.82,
      "end": 2964.82,
      "formatted_start": "00:49:22.820",
      "formatted_end": "00:49:24.820",
      "text": "باشون"
    },
    {
      "id": 48,
      "start": 2974.82,
      "end": 2976.82,
      "formatted_start": "00:49:34.820",
      "formatted_end": "00:49:36.820",
      "text": "سلام"
    },
    {
      "id": 49,
      "start": 2976.82,
      "end": 2978.82,
      "formatted_start": "00:49:36.820",
      "formatted_end": "00:49:38.820",
      "text": "سلام مهد"
    },
    {
      "id": 50,
      "start": 2982.82,
      "end": 2984.82,
      "formatted_start": "00:49:42.820",
      "formatted_end": "00:49:44.820",
      "text": "دو تا شماره"
    },
    {
      "id": 51,
      "start": 2984.82,
      "end": 2986.82,
      "formatted_start": "00:49:44.820",
      "formatted_end": "00:49:46.820",
