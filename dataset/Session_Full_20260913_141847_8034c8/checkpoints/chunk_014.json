      "end": 4260.0,
      "formatted_start": "01:10:58.000",
      "formatted_end": "01:11:00.000",
      "text": "برای اینجوری زنگ میتونی پرسن"
    },
    {
      "id": 16,
      "start": 4260.0,
      "end": 4262.0,
      "formatted_start": "01:11:00.000",
      "formatted_end": "01:11:02.000",
      "text": "چی شده بود؟"
    },
    {
      "id": 17,
      "start": 4262.0,
      "end": 4264.0,
      "formatted_start": "01:11:02.000",
      "formatted_end": "01:11:04.000",
      "text": "نشده زفره و مفرار"
    },
    {
      "id": 18,
      "start": 4264.0,
      "end": 4266.0,
      "formatted_start": "01:11:04.000",
      "formatted_end": "01:11:06.000",
      "text": "هرچی جمع کننده است"
    },
    {
      "id": 19,
      "start": 4266.0,
      "end": 4268.0,
      "formatted_start": "01:11:06.000",
      "formatted_end": "01:11:08.000",
      "text": "باید بخورید"
    },
    {
      "id": 20,
      "start": 4268.0,
      "end": 4270.0,
      "formatted_start": "01:11:08.000",
      "formatted_end": "01:11:10.000",
      "text": "نشده این فامیلهاش میره"
    },
    {
      "id": 21,
      "start": 4270.0,
      "end": 4272.0,
      "formatted_start": "01:11:10.000",
      "formatted_end": "01:11:12.000",
      "text": "یکی دیگه براش میگه"
    },
    {
      "id": 22,
      "start": 4272.0,
      "end": 4274.0,
      "formatted_start": "01:11:12.000",
      "formatted_end": "01:11:14.000",
      "text": "نشده بوده"
    },
    {
      "id": 23,
      "start": 4274.0,
      "end": 4276.0,
      "formatted_start": "01:11:14.000",
      "formatted_end": "01:11:16.000",
      "text": "اصلا بد نمیدونند"
    },
    {
      "id": 24,
      "start": 4276.0,
      "end": 4278.0,
      "formatted_start": "01:11:16.000",
      "formatted_end": "01:11:18.000",
      "text": "بچه کار نشد"
    },
    {
      "id": 25,
      "start": 4278.0,
      "end": 4280.0,
      "formatted_start": "01:11:18.000",
      "formatted_end": "01:11:20.000",
      "text": "بشه"
    },
    {
      "id": 26,
      "start": 4280.0,
      "end": 4282.0,
      "formatted_start": "01:11:20.000",
      "formatted_end": "01:11:22.000",
      "text": "بشه"
    },
    {
      "id": 27,
      "start": 4282.0,
      "end": 4286.8,
      "formatted_start": "01:11:22.000",
      "formatted_end": "01:11:26.800",
      "text": "میشه فاطمه میگفت که ترس دن همون اومده تو خوابش"
    },
    {
      "id": 28,
      "start": 4286.8,
      "end": 4287.3,
      "formatted_start": "01:11:26.800",
      "formatted_end": "01:11:27.300",
      "text": "ای خب"
    },
    {
      "id": 29,
      "start": 4287.3,
      "end": 4289.3,
      "formatted_start": "01:11:27.300",
      "formatted_end": "01:11:29.300",
      "text": "یه چادر هشکی بهش رده"
    },
    {
      "id": 30,
      "start": 4289.3,
      "end": 4290.24,
      "formatted_start": "01:11:29.300",
      "formatted_end": "01:11:30.240",
      "text": "به کنسون"
    },
    {
      "id": 31,
      "start": 4290.24,
      "end": 4293.86,
      "formatted_start": "01:11:30.240",
      "formatted_end": "01:11:33.860",
      "text": "نه فاطمه گفته این چادر سرد بان"
    },
    {
      "id": 32,
      "start": 4293.86,
      "end": 4296.24,
      "formatted_start": "01:11:33.860",
      "formatted_end": "01:11:36.240",
      "text": "حالا بعدشم نه"
    },
    {
      "id": 33,
      "start": 4296.24,
      "end": 4297.32,
      "formatted_start": "01:11:36.240",
      "formatted_end": "01:11:37.320",
      "text": "یه چادر رو هم دخته"
    },
    {
      "id": 34,
      "start": 4297.32,
      "end": 4299.36,
      "formatted_start": "01:11:37.320",
      "formatted_end": "01:11:39.360",
      "text": "گفت من نمیتونم جنگ کنم چادر"
    },
    {
      "id": 35,
      "start": 4299.36,
      "end": 4301.36,
      "formatted_start": "01:11:39.360",
      "formatted_end": "01:11:41.360",
      "text": "حالا میترسه به خوابه"
    },
    {
      "id": 36,
      "start": 4301.36,
      "end": 4303.12,
      "formatted_start": "01:11:41.360",
      "formatted_end": "01:11:43.120",
      "text": "چرا مامانم آمده چادر ببنده"
    },
    {
      "id": 37,
      "start": 4303.12,
      "end": 4306.98,
      "formatted_start": "01:11:43.120",
      "formatted_end": "01:11:46.980",
      "text": "با مبارک دیدی چادر بهت داده شاید تو با شوهر کن"
    },
    {
      "id": 38,
      "start": 4306.98,
      "end": 4308.32,
      "formatted_start": "01:11:46.980",
      "formatted_end": "01:11:48.320",
      "text": "نه شوهر کنم"
    },
    {
      "id": 39,
      "start": 4308.32,
      "end": 4311.06,
      "formatted_start": "01:11:48.320",
      "formatted_end": "01:11:51.060",
      "text": "بعدش نمیاد"
    },
    {
      "id": 40,
      "start": 4311.06,
      "end": 4316.06,
      "formatted_start": "01:11:51.060",
      "formatted_end": "01:11:56.060",
      "text": "و اگر در این چهار و خوش خواستگارم اومد، برایش اموی زنده داشت."
    },
    {
      "id": 41,
      "start": 4316.06,
      "end": 4320.06,
      "formatted_start": "01:11:56.060",
      "formatted_end": "01:12:00.060",
      "text": "برایش شست سالشه. من نمیخوایم."
    },
    {
      "id": 42,
      "start": 4320.06,
      "end": 4325.06,
      "formatted_start": "01:12:00.060",
      "formatted_end": "01:12:05.060",
      "text": "و امم اومد و خونه اون میگفت که برای من بیا."
    },
    {
      "id": 43,
      "start": 4325.06,
      "end": 4327.06,
      "formatted_start": "01:12:05.060",
      "formatted_end": "01:12:07.060",
      "text": "من شست ساله میگیرم؟"
    },
    {
      "id": 44,
      "start": 4327.06,
      "end": 4331.06,
      "formatted_start": "01:12:07.060",
      "formatted_end": "01:12:11.060",
      "text": "نه، الان زنهای کومیته یه روح میگیرند، یه شوهر نمی کنند."
    },
    {
      "id": 45,
      "start": 4331.06,
      "end": 4332.06,
      "formatted_start": "01:12:11.060",
      "formatted_end": "01:12:12.060",
      "text": "که میگوید؟"
    },
    {
      "id": 46,
      "start": 4332.06,
      "end": 4333.06,
      "formatted_start": "01:12:12.060",
      "formatted_end": "01:12:13.060",
      "text": "امم."
    },
    {
      "id": 47,
      "start": 4333.06,
      "end": 4335.06,
      "formatted_start": "01:12:13.060",
      "formatted_end": "01:12:15.060",
      "text": "من کومیته چرا بکنه؟"
    },
    {
      "id": 48,
      "start": 4335.06,
      "end": 4337.06,
      "formatted_start": "01:12:15.060",
      "formatted_end": "01:12:17.060",
      "text": "نه نه"
    },
    {
      "id": 49,
      "start": 4337.06,
      "end": 4367.06,
      "formatted_start": "01:12:17.060",
      "formatted_end": "01:12:47.060",
      "text": "اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه اوه ا"
    },
