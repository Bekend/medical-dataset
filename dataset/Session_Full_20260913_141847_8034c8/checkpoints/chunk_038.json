  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11411.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:11.000",
      "text": "از این بابا گردن کلپ شده، دیگه زیر گوشش اینقدر عبثه کرده، از تو گوش میاده میکرون، دو تا چهرخشکون هست، سه تا مترونه کشون."
    },
    {
      "id": 1,
      "start": 11411.0,
      "end": 11422.0,
      "formatted_start": "03:10:11.000",
      "formatted_end": "03:10:22.000",
      "text": "قطر مترانی دازل استفاده کرده. نه، باید نترونه. اون سرما خورده، هفته بزرگشته، آبیت خورده، آویت خورده."
    },
    {
      "id": 2,
      "start": 11422.0,
      "end": 11432.0,
      "formatted_start": "03:10:22.000",
      "formatted_end": "03:10:32.000",
      "text": "خوبش اینه که به اینجا بزنه، بدش اینه که به مغز بزنه، مغز بزنه تشنوش میده، میکشه، ولی این نمیباشه، خوب میشه این شیطان"
    },
    {
      "id": 3,
      "start": 11432.0,
      "end": 11440.0,
      "formatted_start": "03:10:32.000",
      "formatted_end": "03:10:40.000",
      "text": "خطر رفت شده یعنی اون به خطر بوده توی گوش آبزه کرده تخلیه شده توی گلو"
    },
    {
      "id": 4,
      "start": 11440.0,
      "end": 11445.0,
      "formatted_start": "03:10:40.000",
      "formatted_end": "03:10:45.000",
      "text": "آره از اینجا میشه یه یاشتش خوشکاره اگه به زم توی مغز میزده اینه خطر نبود"
    },
    {
      "id": 5,
      "start": 11445.0,
      "end": 11450.0,
      "formatted_start": "03:10:45.000",
      "formatted_end": "03:10:50.000",
      "text": "بسیار بستریم که میرفت به کمار بگیره این هاو میشه ایشه"
    },
    {
      "id": 6,
      "start": 11450.0,
      "end": 11454.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:10:54.000",
      "text": "همون آبیه هرکه دیگه"
    },
    {
      "id": 7,
      "start": 11454.0,
      "end": 11461.0,
      "formatted_start": "03:10:54.000",
      "formatted_end": "03:11:01.000",
      "text": "این همه در قطعه گوشی سپروفروساسین یا چشمی در گوش باید بزنه"
    },
    {
      "id": 8,
      "start": 11461.0,
      "end": 11463.0,
      "formatted_start": "03:11:01.000",
      "formatted_end": "03:11:03.000",
      "text": "هشت راستی که اطراف داره"
    },
    {
      "id": 9,
      "start": 11463.0,
      "end": 11465.0,
      "formatted_start": "03:11:03.000",
      "formatted_end": "03:11:05.000",
      "text": "داوی دیگه نمیخوایی بیمار دوچه براد نمیسه؟"
    },
    {
      "id": 10,
      "start": 11465.0,
      "end": 11467.0,
      "formatted_start": "03:11:05.000",
      "formatted_end": "03:11:07.000",
      "text": "نا خود این داوی شدیم نیست"
    },
    {
      "id": 11,
      "start": 11467.0,
      "end": 11469.0,
      "formatted_start": "03:11:07.000",
      "formatted_end": "03:11:09.000",
      "text": "همین خواست همون"
    },
    {
      "id": 12,
      "start": 11469.0,
      "end": 11474.0,
      "formatted_start": "03:11:09.000",
      "formatted_end": "03:11:14.000",
      "text": "همین سوزن چیزو کسان میبره مارد سارم چی پشاونه"
    },
    {
      "id": 13,
      "start": 11474.0,
      "end": 11475.0,
      "formatted_start": "03:11:14.000",
      "formatted_end": "03:11:15.000",
      "text": "نه آنها هست"
    },
    {
      "id": 14,
      "start": 11475.0,
      "end": 11476.0,
      "formatted_start": "03:11:15.000",
      "formatted_end": "03:11:16.000",
      "text": "آنها هست"
    },
    {
      "id": 15,
      "start": 11476.0,
      "end": 11477.0,
      "formatted_start": "03:11:16.000",
      "formatted_end": "03:11:17.000",
      "text": "داره پشاونش هم داره"
    },
    {
      "id": 16,
      "start": 11477.0,
      "end": 11479.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:19.000",
      "text": "چهرخشکو میخواد توسط جور"
    },
    {
      "id": 17,
      "start": 11479.0,
      "end": 11486.9,
      "formatted_start": "03:11:19.000",
      "formatted_end": "03:11:26.900",
      "text": "اولا باید دید امروز روز دوشنبه، هفته دیگه دوشنبه، هفته دیگه دوشنبه، دو تا دوشنبه باید دید"
    },
    {
      "id": 18,
      "start": 11486.9,
      "end": 11487.9,
      "formatted_start": "03:11:26.900",
      "formatted_end": "03:11:27.900",
      "text": "آه باید دید؟"
    },
    {
      "id": 19,
      "start": 11487.9,
      "end": 11497.4,
      "formatted_start": "03:11:27.900",
      "formatted_end": "03:11:37.400",
      "text": "آه، آه، این باید دوشنبه باید دید، این باید شرکه، راه گریز هم نداره، مثلا این تو گلون نیست، میگن بره پایین، زیر جهنده اینجا، این باید خوش میشوند"
    },
    {
      "id": 20,
      "start": 11497.4,
      "end": 11498.4,
      "formatted_start": "03:11:37.400",
      "formatted_end": "03:11:38.400",
      "text": "آه، باشه شد"
    },
    {
      "id": 21,
      "start": 11498.4,
      "end": 11501.4,
      "formatted_start": "03:11:38.400",
      "formatted_end": "03:11:41.400",
      "text": "بعد تازه دو روز هم اثر نمی کنید این ها"
    },
    {
      "id": 22,
      "start": 11501.4,
      "end": 11504.4,
      "formatted_start": "03:11:41.400",
      "formatted_end": "03:11:44.400",
      "text": "بعد از دو روز چهره سال پیزه های یاشمش اثرش شروع میشه"
    },
    {
      "id": 23,
      "start": 11504.4,
      "end": 11506.4,
      "formatted_start": "03:11:44.400",
      "formatted_end": "03:11:46.400",
      "text": "از این سال یک هفته میرین باز"
    },
    {
      "id": 24,
      "start": 11506.4,
      "end": 11507.4,
      "formatted_start": "03:11:46.400",
      "formatted_end": "03:11:47.400",
      "text": "باشه باشه"
    },
    {
      "id": 25,
      "start": 11507.4,
      "end": 11510.4,
      "formatted_start": "03:11:47.400",
      "formatted_end": "03:11:50.400",
      "text": "اگه در ما درست مصرفتش نمیشه"
    },
    {
      "id": 26,
      "start": 11510.4,
      "end": 11511.4,
      "formatted_start": "03:11:50.400",
      "formatted_end": "03:11:51.400",
      "text": "باشه باشه"
    },
    {
      "id": 27,
      "start": 11511.4,
      "end": 11512.4,
      "formatted_start": "03:11:51.400",
      "formatted_end": "03:11:52.400",
      "text": "مرسی برام"
    },
    {
