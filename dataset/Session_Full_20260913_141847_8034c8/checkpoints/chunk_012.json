  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3630.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:30.000",
      "text": "از اینجا، با اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه"
    },
    {
      "id": 1,
      "start": 3630.0,
      "end": 3632.0,
      "formatted_start": "01:00:30.000",
      "formatted_end": "01:00:32.000",
      "text": "این تیم گوشت هست؟"
    },
    {
      "id": 2,
      "start": 3632.0,
      "end": 3635.0,
      "formatted_start": "01:00:32.000",
      "formatted_end": "01:00:35.000",
      "text": "همون فضا شروع میشه سرگیج"
    },
    {
      "id": 3,
      "start": 3635.0,
      "end": 3637.0,
      "formatted_start": "01:00:35.000",
      "formatted_end": "01:00:37.000",
      "text": "ببین سه تا غذای باعث سرگیج میشه"
    },
    {
      "id": 4,
      "start": 3637.0,
      "end": 3639.0,
      "formatted_start": "01:00:37.000",
      "formatted_end": "01:00:39.000",
      "text": "یکی کشب و قام سرشیده"
    },
    {
      "id": 5,
      "start": 3639.0,
      "end": 3641.0,
      "formatted_start": "01:00:39.000",
      "formatted_end": "01:00:41.000",
      "text": "یکی آبوش گله پاچه"
    },
    {
      "id": 6,
      "start": 3641.0,
      "end": 3644.0,
      "formatted_start": "01:00:41.000",
      "formatted_end": "01:00:44.000",
      "text": "قیمه قلمه چرده"
    },
    {
      "id": 7,
      "start": 3644.0,
      "end": 3646.0,
      "formatted_start": "01:00:44.000",
      "formatted_end": "01:00:46.000",
      "text": "مثلا مجانه باشه بیشتر سرگیج داره"
    },
    {
      "id": 8,
      "start": 3646.0,
      "end": 3648.0,
      "formatted_start": "01:00:46.000",
      "formatted_end": "01:00:48.000",
      "text": "سه بومیش آجیه"
    },
    {
      "id": 9,
      "start": 3648.0,
      "end": 3650.0,
      "formatted_start": "01:00:48.000",
      "formatted_end": "01:00:50.000",
      "text": "یکی تقمه پسته بادم زمین"
    },
    {
      "id": 10,
      "start": 3650.0,
      "end": 3654.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:54.000",
      "text": "همون آبوشته"
    },
    {
      "id": 11,
      "start": 3654.0,
      "end": 3656.0,
      "formatted_start": "01:00:54.000",
      "formatted_end": "01:00:56.000",
      "text": "آبوشته چشمه بردی؟"
    },
    {
      "id": 12,
      "start": 3656.0,
      "end": 3658.0,
      "formatted_start": "01:00:56.000",
      "formatted_end": "01:00:58.000",
      "text": "تقریبا چهار دوز میشه"
    },
    {
      "id": 13,
      "start": 3658.0,
      "end": 3660.0,
      "formatted_start": "01:00:58.000",
      "formatted_end": "01:01:00.000",
      "text": "چهار دوز، این سرگیج دوباره شما شد"
    },
    {
      "id": 14,
      "start": 3660.0,
      "end": 3663.66,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:03.660",
      "text": "سرنیجه با این سه تا غذا چارمش مشروع کنه کنه؟"
    },
    {
      "id": 15,
      "start": 3663.66,
      "end": 3664.16,
      "formatted_start": "01:01:03.660",
      "formatted_end": "01:01:04.160",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 3664.16,
      "end": 3665.66,
      "formatted_start": "01:01:04.160",
      "formatted_end": "01:01:05.660",
      "text": "آبی همین چه آبوشتو بکنه؟"
    },
    {
      "id": 17,
      "start": 3665.66,
      "end": 3668.54,
      "formatted_start": "01:01:05.660",
      "formatted_end": "01:01:08.540",
      "text": "آبوشتو بله باشه قیمه قرمه به زنجال"
    },
    {
      "id": 18,
      "start": 3668.54,
      "end": 3670.54,
      "formatted_start": "01:01:08.540",
      "formatted_end": "01:01:10.540",
      "text": "هزاری هسابی چرب دارن"
    },
    {
      "id": 19,
      "start": 3670.54,
      "end": 3672.54,
      "formatted_start": "01:01:10.540",
      "formatted_end": "01:01:12.540",
      "text": "یه چربش توی گوش اینجور بکنه"
    },
    {
      "id": 20,
      "start": 3672.54,
      "end": 3674.54,
      "formatted_start": "01:01:12.540",
      "formatted_end": "01:01:14.540",
      "text": "کره خامه سرشی بکنه؟"
    },
    {
      "id": 21,
      "start": 3674.54,
      "end": 3675.04,
      "formatted_start": "01:01:14.540",
      "formatted_end": "01:01:15.040",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 3675.04,
      "end": 3675.54,
      "formatted_start": "01:01:15.040",
      "formatted_end": "01:01:15.540",
      "text": "آران نمی کنه؟"
    },
    {
      "id": 23,
      "start": 3675.54,
      "end": 3676.04,
      "formatted_start": "01:01:15.540",
      "formatted_end": "01:01:16.040",
      "text": "نه"
    },
    {
      "id": 24,
      "start": 3676.04,
      "end": 3677.04,
      "formatted_start": "01:01:16.040",
      "formatted_end": "01:01:17.040",
      "text": "آجی بادام زمینی؟"
    },
    {
      "id": 25,
      "start": 3677.04,
      "end": 3677.54,
      "formatted_start": "01:01:17.040",
      "formatted_end": "01:01:17.540",
      "text": "نه"
    },
    {
      "id": 26,
      "start": 3677.54,
      "end": 3678.04,
      "formatted_start": "01:01:17.540",
      "formatted_end": "01:01:18.040",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 3678.04,
      "end": 3681.04,
      "formatted_start": "01:01:18.040",
      "formatted_end": "01:01:21.040",
      "text": "بله چربی دارم"
    },
    {
      "id": 28,
      "start": 3681.04,
      "end": 3683.04,
      "formatted_start": "01:01:21.040",
      "formatted_end": "01:01:23.040",
      "text": "آبوشتو هم دارید"
    },
    {
      "id": 29,
      "start": 3683.04,
      "end": 3685.04,
      "formatted_start": "01:01:23.040",
      "formatted_end": "01:01:25.040",
      "text": "هم آبوشتو دارید هم چربی"
    },
    {
      "id": 30,
      "start": 3685.04,
      "end": 3688.7,
      "formatted_start": "01:01:25.040",
      "formatted_end": "01:01:28.700",
      "text": "الان آبوشتو کجا رفته؟ بردونی کشتو بگم"
    },
    {
      "id": 31,
      "start": 3688.7,
      "end": 3692.28,
      "formatted_start": "01:01:28.700",
      "formatted_end": "01:01:32.280",
      "text": "بقیه مدت همه برسته فکر می کنم ازن کبد درد و این داره"
    },
    {
      "id": 32,
      "start": 3692.28,
      "end": 3693.04,
      "formatted_start": "01:01:32.280",
      "formatted_end": "01:01:33.040",
      "text": "بله بله"
    },
    {
      "id": 33,
      "start": 3693.04,
      "end": 3694.74,
      "formatted_start": "01:01:33.040",
      "formatted_end": "01:01:34.740",
      "text": "چه کم همه خیلی سوزی بگه"
    },
    {
      "id": 34,
      "start": 3694.74,
      "end": 3696.74,
      "formatted_start": "01:01:34.740",
      "formatted_end": "01:01:36.740",
      "text": "سرگی چه؟ خب؟"
    },
    {
      "id": 35,
      "start": 3696.74,
      "end": 3700.6,
      "formatted_start": "01:01:36.740",
      "formatted_end": "01:01:40.600",
      "text": "دهنم خوش میشه، تق میشه"
    },
    {
      "id": 36,
      "start": 3700.6,
      "end": 3701.54,
      "formatted_start": "01:01:40.600",
      "formatted_end": "01:01:41.540",
      "text": "چه هن؟"
    },
    {
      "id": 37,
      "start": 3701.54,
      "end": 3705.48,
      "formatted_start": "01:01:41.540",
      "formatted_end": "01:01:45.480",
      "text": "بعد بگه چی بگم، اگه بگم پاهم درد میکنه"
    },
    {
      "id": 38,
      "start": 3705.48,
      "end": 3708.8,
      "formatted_start": "01:01:45.480",
      "formatted_end": "01:01:48.800",
      "text": "بیباری متابریک ده، دست نمیسه دیگه"
    },
    {
      "id": 39,
      "start": 3708.8,
      "end": 3712.7,
      "formatted_start": "01:01:48.800",
      "formatted_end": "01:01:52.700",
      "text": "اون که همین زن را پاکنه، اگه یه این تو پاک درد نمی کنه"
    },
    {
      "id": 40,
      "start": 3712.7,
      "end": 3717.46,
      "formatted_start": "01:01:52.700",
      "formatted_end": "01:01:57.460",
      "text": "زنه بدون پادر کنه، اسم زن قدیم چی بود؟ می گفتن پاشکسته"
    },
    {
      "id": 41,
      "start": 3717.46,
      "end": 3722.3,
      "formatted_start": "01:01:57.460",
      "formatted_end": "01:02:02.300",
      "text": "یکی می گفت من دوتا پاشکسته دارم، یکی می گفت من چار تا پاشکسته دارم"
    },
    {
      "id": 42,
      "start": 3722.3,
      "end": 3726.14,
      "formatted_start": "01:02:02.300",
      "formatted_end": "01:02:06.140",
      "text": "در جای زن می گفتن پاشکسته، یعنی پادر داره، زن که پادر داره"
    },
    {
      "id": 43,
      "start": 3726.14,
      "end": 3730.06,
      "formatted_start": "01:02:06.140",
      "formatted_end": "01:02:10.060",
      "text": "اما می مانه سرگیجه، اسم زن دیگه سرگیجه نمی ده که"
    },
    {
      "id": 44,
      "start": 3730.06,
      "end": 3736.22,
      "formatted_start": "01:02:10.060",
      "formatted_end": "01:02:16.220",
      "text": "سرگیجه هم تیم آبگوش بخوره، مشروب بخوره، آجین بخوره، کشک و خامه بخوره، سرگیجه می ده"
    },
    {
      "id": 45,
      "start": 3736.22,
      "end": 3740.46,
      "formatted_start": "01:02:16.220",
      "formatted_end": "01:02:20.460",
      "text": "مخصوصا چاق باشه، چربش پر باشه، دیگه میره تو موشیش خواه"
    },
    {
      "id": 46,
      "start": 3740.46,
      "end": 3744.46,
      "formatted_start": "01:02:20.460",
      "formatted_end": "01:02:24.460",
      "text": "سرمزده، حالا بعد اینکه اون از تو گوشتر بیادی، دوتا کار هم شده"
    },
    {
      "id": 47,
      "start": 3744.46,
      "end": 3749.98,
      "formatted_start": "01:02:24.460",
      "formatted_end": "01:02:29.980",
      "text": "یکی دارو میدی، یکی جا به جایی میکنه، اون چاگوشتر پشت بود"
    },
    {
      "id": 48,
      "start": 3749.98,
      "end": 3755.86,
      "formatted_start": "01:02:29.980",
      "formatted_end": "01:02:35.860",
      "text": "خب، و داروش هم که همین مکانی میلو سمیلو بیلو کرد"
    },
    {
      "id": 49,
      "start": 3755.86,
      "end": 3761.78,
      "formatted_start": "01:02:35.860",
      "formatted_end": "01:02:41.780",
      "text": "اما اون دیگه مشغول بیمه و اینا نیست، اون پشت بیمه نیست"
    },
    {
      "id": 50,
      "start": 3761.78,
      "end": 3763.78,
      "formatted_start": "01:02:41.780",
      "formatted_end": "01:02:43.780",
      "text": "این روش همه نگو کردن؟"
    },
    {
      "id": 51,
      "start": 3763.78,
      "end": 3765.78,
      "formatted_start": "01:02:43.780",
      "formatted_end": "01:02:45.780",
      "text": "هر دو تا نگو کردن"
    },
    {
      "id": 52,
      "start": 3765.78,
      "end": 3767.78,
      "formatted_start": "01:02:45.780",
      "formatted_end": "01:02:47.780",
      "text": "این از کچکی نگو کردن که شنوایی هست"
    },
    {
      "id": 53,
      "start": 3767.78,
      "end": 3773.78,
      "formatted_start": "01:02:47.780",
      "formatted_end": "01:02:53.780",
      "text": "شنوایی یه بخش از کار گوش تعادل یه بخش از کارشه"
    },
    {
      "id": 54,
      "start": 3773.78,
      "end": 3775.78,
      "formatted_start": "01:02:53.780",
      "formatted_end": "01:02:55.780",
      "text": "یه گوش انسان دوتا کار انجام میده"
    },
    {
      "id": 55,
      "start": 3775.78,
      "end": 3777.78,
      "formatted_start": "01:02:55.780",
      "formatted_end": "01:02:57.780",
      "text": "یکی شنواییه یکی تعادله"
    },
    {
      "id": 56,
      "start": 3777.78,
      "end": 3779.78,
      "formatted_start": "01:02:57.780",
      "formatted_end": "01:02:59.780",
      "text": "اینو به هم زیاد ارتباط نداره"
    },
    {
      "id": 57,
      "start": 3779.78,
      "end": 3781.78,
      "formatted_start": "01:02:59.780",
      "formatted_end": "01:03:01.780",
      "text": "ممکنه یه گوشی تعادلش خوب باشه"
    },
    {
      "id": 58,
      "start": 3781.78,
      "end": 3783.78,
      "formatted_start": "01:03:01.780",
      "formatted_end": "01:03:03.780",
      "text": "اما شنواییش خوب نباشه"
    },
    {
      "id": 59,
      "start": 3783.78,
      "end": 3785.78,
      "formatted_start": "01:03:03.780",
      "formatted_end": "01:03:05.780",
      "text": "یا برنگز"
    },
    {
      "id": 60,
      "start": 3785.78,
      "end": 3787.78,
      "formatted_start": "01:03:05.780",
      "formatted_end": "01:03:07.780",
      "text": "پس شما اون شنواییت یه بخش دیگری"
    },
    {
      "id": 61,
      "start": 3787.78,
      "end": 3794.78,
      "formatted_start": "01:03:07.780",
      "formatted_end": "01:03:14.780",
      "text": "باید دکتر گوش، نوار گوش، سمعک، بلا برنامه های دیگر داره که کار من نیست"
    },
    {
      "id": 62,
      "start": 3794.78,
      "end": 3800.78,
      "formatted_start": "01:03:14.780",
      "formatted_end": "01:03:20.780",
      "text": "اما این سرگیجه یک کار دیگر گوشه که با چربی در ارتباطه"
    },
    {
      "id": 63,
      "start": 3800.78,
      "end": 3801.78,
      "formatted_start": "01:03:20.780",
      "formatted_end": "01:03:21.780",
      "text": "خب؟"
    },
    {
      "id": 64,
      "start": 3801.78,
      "end": 3807.78,
      "formatted_start": "01:03:21.780",
      "formatted_end": "01:03:27.780",
      "text": "باید نگفتم نه مونا باید دکتر من از دیروز، بگو پلیر روز گروه دیگه"
    },
    {
      "id": 65,
      "start": 3807.78,
      "end": 3814.78,
      "formatted_start": "01:03:27.780",
      "formatted_end": "01:03:34.780",
      "text": "از دیروز کامل من برس فایمتادین و برس چربی است"
    },
    {
      "id": 66,
      "start": 3814.78,
      "end": 3818.78,
      "formatted_start": "01:03:34.780",
      "formatted_end": "01:03:38.780",
      "text": "مال چربی این الان شیست ساله دارم این دوتار مساهم میکنم"
    },
    {
      "id": 67,
      "start": 3818.78,
      "end": 3827.78,
      "formatted_start": "01:03:38.780",
      "formatted_end": "01:03:47.780",
      "text": "اگر دیروز نخوردم بردم شاید این درد شکم ها این الان نصیبی یه هفته شروع این ها گرفته فکر میکنم کبد همه"
    },
    {
      "id": 68,
      "start": 3827.78,
      "end": 3829.78,
      "formatted_start": "01:03:47.780",
      "formatted_end": "01:03:49.780",
      "text": "آره مالی کبد چرب آفر"
    },
    {
      "id": 69,
      "start": 3829.78,
      "end": 3832.78,
      "formatted_start": "01:03:49.780",
      "formatted_end": "01:03:52.780",
      "text": "چون خیلی دیگر مالی چربی هست"
    },
    {
      "id": 70,
      "start": 3832.78,
      "end": 3835.78,
      "formatted_start": "01:03:52.780",
      "formatted_end": "01:03:55.780",
      "text": "این آبوش چون دنبه هم داشت خاشنگ کوبی دیرون رو آب شراب هردو"
    },
    {
      "id": 71,
      "start": 3835.78,
      "end": 3837.78,
      "formatted_start": "01:03:55.780",
      "formatted_end": "01:03:57.780",
      "text": "نه آبوش چربی داریم اصلا گوش نمیدونم"
    },
    {
      "id": 72,
      "start": 3837.78,
      "end": 3840.78,
      "formatted_start": "01:03:57.780",
      "formatted_end": "01:04:00.780",
      "text": "اگر شما چربی دارید، این بگو که این آبوش مخش مزه بود"
    },
    {
      "id": 73,
      "start": 3840.78,
      "end": 3843.78,
      "formatted_start": "01:04:00.780",
      "formatted_end": "01:04:03.780",
      "text": "ازا مابر مخشی که بگم گوشت مار دارست"
    },
    {
      "id": 74,
      "start": 3843.78,
      "end": 3844.78,
      "formatted_start": "01:04:03.780",
      "formatted_end": "01:04:04.780",
      "text": "گوشت چی بود؟"
    },
    {
      "id": 75,
      "start": 3844.78,
      "end": 3845.78,
      "formatted_start": "01:04:04.780",
      "formatted_end": "01:04:05.780",
      "text": "مار"
    },
    {
      "id": 76,
      "start": 3845.78,
      "end": 3847.78,
      "formatted_start": "01:04:05.780",
      "formatted_end": "01:04:07.780",
      "text": "گوشت مار دارست، که اون نخودش باعث میشه"
    },
    {
      "id": 77,
      "start": 3847.78,
      "end": 3849.78,
      "formatted_start": "01:04:07.780",
      "formatted_end": "01:04:09.780",
      "text": "چون دیگه چربی داری اونطوری نیست"
    },
    {
      "id": 78,
      "start": 3849.78,
      "end": 3852.78,
      "formatted_start": "01:04:09.780",
      "formatted_end": "01:04:12.780",
      "text": "نه، نخودش باعث میشه بیشتر به سرگی جمیده"
    },
    {
      "id": 79,
      "start": 3852.78,
      "end": 3855.78,
      "formatted_start": "01:04:12.780",
      "formatted_end": "01:04:15.780",
      "text": "گفتم که شما آجیب کردید، گفتی نه"
    },
    {
      "id": 80,
      "start": 3855.78,
      "end": 3859.78,
      "formatted_start": "01:04:15.780",
      "formatted_end": "01:04:19.780",
      "text": "بادام زرمینی، اون نخود که توی آبوش میرسید غیر از چربی"
    },
    {
      "id": 81,
      "start": 3859.78,
      "end": 3865.78,
      "formatted_start": "01:04:19.780",
      "formatted_end": "01:04:25.780",
      "text": "از شرمی خود و نخود یک بلایی داره که شما اگه بری اینو چپسکوه چیه میفروشن"
    },
    {
      "id": 82,
      "start": 3865.78,
      "end": 3868.78,
      "formatted_start": "01:04:25.780",
      "formatted_end": "01:04:28.780",
      "text": "فلافل فلافل هم بخوری همین میشه"
    },
    {
      "id": 83,
      "start": 3868.78,
      "end": 3873.78,
      "formatted_start": "01:04:28.780",
      "formatted_end": "01:04:33.780",
      "text": "اونم با نخود درست میشه دیگره مثل که پوشکو بیده همه دردیزرند تو رو برده"
    },
    {
      "id": 84,
      "start": 3873.78,
      "end": 3877.78,
      "formatted_start": "01:04:33.780",
      "formatted_end": "01:04:37.780",
      "text": "خواستی جا بندازن ولن انجام بیدن ولن"
    },
    {
      "id": 85,
      "start": 3877.78,
      "end": 3882.78,
      "formatted_start": "01:04:37.780",
      "formatted_end": "01:04:42.780",
