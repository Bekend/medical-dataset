  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13809.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:09.000",
      "text": "شروعات الکولی رو درش گفته برنشم. در شد شیمی های حرزگرداری شرکت نمیدونیم. درسته."
    },
    {
      "id": 1,
      "start": 13809.0,
      "end": 13820.0,
      "formatted_start": "03:50:09.000",
      "formatted_end": "03:50:20.000",
      "text": "هیچوقت دوست ندارم که روابط یعنی و آزاد جنسی روشن با هر زنی که پیش اومد. بله، اینا درسته."
    },
    {
      "id": 2,
      "start": 13820.0,
      "end": 13848.64,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:48.640",
      "text": "نرمی کنید، در غذا خوردن هم هم دقیق میکنید، اما این فقط تو رفتاره، یعنی تو گفتاری پیرداره، دیرم هوای اونها رو میکنیم، اینه که در رویاه ها اون رویاه ها رو میبینم، در خیال پردازی ها اون خیال پردازی ها رو دارم، نرمی کنید، دیر نبودید، اما دست کشیدن، از اونا دست کشیدن، اما دیر نبودید"
    },
    {
      "id": 3,
      "start": 13850.0,
      "end": 13858.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:50:58.000",
      "text": "که هر جا میرید توی داستان ببینید که هر یک هر در رفتارش استوار تره"
    },
    {
      "id": 4,
      "start": 13858.0,
      "end": 13869.0,
      "formatted_start": "03:50:58.000",
      "formatted_end": "03:51:09.000",
      "text": "اما اصلا در ذکرش استوار نیست، در روانش استوار نیست، در روانش این چیزها روج میزنند"
    },
    {
      "id": 5,
      "start": 13869.0,
      "end": 13876.0,
      "formatted_start": "03:51:09.000",
      "formatted_end": "03:51:16.000",
      "text": "هنوز قلقه داره به این چیزها و بعد را که میبینید که تقریبا از عواصل کتاب به بعد"
    },
    {
      "id": 6,
      "start": 13876.0,
      "end": 13879.72,
      "formatted_start": "03:51:16.000",
      "formatted_end": "03:51:19.720",
      "text": "ببینید وقتی موقعیت پیش میاد تن روز بوده به این چیزها"
    },
    {
      "id": 7,
      "start": 13879.72,
      "end": 13883.68,
      "formatted_start": "03:51:19.720",
      "formatted_end": "03:51:23.680",
      "text": "معلوم میشه که دل نقودیده بوده اما دست کشیده بوده"
    },
    {
      "id": 8,
      "start": 13883.68,
      "end": 13888.12,
      "formatted_start": "03:51:23.680",
      "formatted_end": "03:51:28.120",
      "text": "خب دست کشیدن منهای دل بریدن این نافعه نیست"
    },
    {
      "id": 9,
      "start": 13888.12,
      "end": 13889.64,
      "formatted_start": "03:51:28.120",
      "formatted_end": "03:51:29.640",
      "text": "یه روز خودشو برسنید"
    },
    {
      "id": 10,
      "start": 13889.64,
      "end": 13892.68,
      "formatted_start": "03:51:29.640",
      "formatted_end": "03:51:32.680",
      "text": "که در رفتار احتیاط میکنم"
    },
    {
      "id": 11,
      "start": 13892.68,
      "end": 13894.86,
      "formatted_start": "03:51:32.680",
      "formatted_end": "03:51:34.860",
      "text": "در رفتار خیشتن دارم"
    },
    {
      "id": 12,
      "start": 13894.86,
      "end": 13898.12,
      "formatted_start": "03:51:34.860",
      "formatted_end": "03:51:38.120",
      "text": "در رفتار مهمیز رفتار خودم در دست همه"
    },
    {
      "id": 13,
      "start": 13898.12,
      "end": 13901.28,
      "formatted_start": "03:51:38.120",
      "formatted_end": "03:51:41.280",
      "text": "اما باور هم چیز دیگه اید"
    },
    {
      "id": 14,
      "start": 13901.28,
      "end": 13904.72,
      "formatted_start": "03:51:41.280",
      "formatted_end": "03:51:44.720",
      "text": "احساسات و عواطفت چیز دیگه اید"
    },
    {
      "id": 15,
      "start": 13904.72,
      "end": 13906.72,
      "formatted_start": "03:51:44.720",
      "formatted_end": "03:51:46.720",
      "text": "خواسته ها چیز دیگه یه"
    },
    {
      "id": 16,
      "start": 13906.72,
      "end": 13908.48,
      "formatted_start": "03:51:46.720",
      "formatted_end": "03:51:48.480",
      "text": "اونی که در درمونم هست"
    },
    {
      "id": 17,
      "start": 13908.48,
      "end": 13909.66,
      "formatted_start": "03:51:48.480",
      "formatted_end": "03:51:49.660",
      "text": "چیز دیگه یه"
    },
    {
      "id": 18,
      "start": 13909.66,
      "end": 13914.66,
      "formatted_start": "03:51:49.660",
      "formatted_end": "03:51:54.660",
      "text": "خب اگر من یک دره بودم"
    },
    {
      "id": 19,
      "start": 13914.66,
      "end": 13915.96,
      "formatted_start": "03:51:54.660",
      "formatted_end": "03:51:55.960",
      "text": "خب بهتر زندگی بودم"
    },
    {
      "id": 20,
      "start": 13915.96,
      "end": 13919.82,
      "formatted_start": "03:51:55.960",
      "formatted_end": "03:51:59.820",
      "text": "اگر من فقط به نوبار لذت بودم"
    },
    {
      "id": 21,
      "start": 13919.82,
      "end": 13921.5,
      "formatted_start": "03:51:59.820",
      "formatted_end": "03:52:01.500",
      "text": "خیلی بهتر بودم"
    },
    {
      "id": 22,
      "start": 13921.5,
      "end": 13923.54,
      "formatted_start": "03:52:01.500",
      "formatted_end": "03:52:03.540",
      "text": "اگر من مثل قدیسان"
    },
    {
      "id": 23,
      "start": 13923.54,
      "end": 13925.48,
      "formatted_start": "03:52:03.540",
      "formatted_end": "03:52:05.480",
      "text": "مثل فرزانگان"
    },
    {
      "id": 24,
      "start": 13925.48,
      "end": 13928.88,
      "formatted_start": "03:52:05.480",
      "formatted_end": "03:52:08.880",
      "text": "مثل آرفان بودم"
    },
    {
      "id": 25,
      "start": 13928.88,
      "end": 13931.48,
      "formatted_start": "03:52:08.880",
      "formatted_end": "03:52:11.480",
      "text": "که فقط به نوبار مهنگیت بودم"
    },
    {
      "id": 26,
      "start": 13931.48,
      "end": 13932.88,
      "formatted_start": "03:52:11.480",
      "formatted_end": "03:52:12.880",
      "text": "خب اونم زندگی"
    },
    {
      "id": 27,
      "start": 13932.88,
      "end": 13935.2,
      "formatted_start": "03:52:12.880",
      "formatted_end": "03:52:15.200",
      "text": "بهتر بود چرا؟"
    },
    {
      "id": 28,
      "start": 13935.2,
      "end": 13936.54,
      "formatted_start": "03:52:15.200",
      "formatted_end": "03:52:16.540",
      "text": "توی یه عربا داشتم"
    },
    {
      "id": 29,
      "start": 13936.54,
      "end": 13938.2,
      "formatted_start": "03:52:16.540",
      "formatted_end": "03:52:18.200",
      "text": "یه خدا داشتم"
    },
    {
      "id": 30,
      "start": 13938.2,
      "end": 13939.68,
      "formatted_start": "03:52:18.200",
      "formatted_end": "03:52:19.680",
      "text": "یه سربردشتم"
    },
    {
      "id": 31,
      "start": 13939.68,
      "end": 13941.42,
      "formatted_start": "03:52:19.680",
      "formatted_end": "03:52:21.420",
      "text": "الان من دو تا عربا برم"
    },
    {
      "id": 32,
      "start": 13941.42,
      "end": 13944.02,
      "formatted_start": "03:52:21.420",
      "formatted_end": "03:52:24.020",
      "text": "شهبت و معنویم"
    },
    {
      "id": 33,
      "start": 13944.02,
      "end": 13945.6,
      "formatted_start": "03:52:24.020",
      "formatted_end": "03:52:25.600",
      "text": "لذت و معنو"
    },
    {
      "id": 34,
      "start": 13945.6,
      "end": 13947.36,
      "formatted_start": "03:52:25.600",
      "formatted_end": "03:52:27.360",
      "text": "هر دو عربا با منم"
    },
    {
      "id": 35,
      "start": 13947.36,
      "end": 13951.54,
      "formatted_start": "03:52:27.360",
      "formatted_end": "03:52:31.540",
      "text": "و این عربا هم عموماً حقامشون با هم متفاوتیم"
    },
    {
      "id": 36,
      "start": 13951.54,
      "end": 13952.96,
      "formatted_start": "03:52:31.540",
      "formatted_end": "03:52:32.960",
      "text": "یکی شونگه بکنی کارو"
    },
    {
      "id": 37,
      "start": 13952.96,
      "end": 13954.86,
      "formatted_start": "03:52:32.960",
      "formatted_end": "03:52:34.860",
      "text": "یکی شونگه نکنی کارو"
    },
    {
      "id": 38,
      "start": 13954.86,
      "end": 13956.4,
      "formatted_start": "03:52:34.860",
      "formatted_end": "03:52:36.400",
      "text": "یکی شونگه ایکسو بکن"
    },
    {
      "id": 39,
      "start": 13956.4,
      "end": 13958.08,
      "formatted_start": "03:52:36.400",
      "formatted_end": "03:52:38.080",
      "text": "یکی شونگه ایگرگو بکن"
    },
    {
      "id": 40,
      "start": 13958.08,
      "end": 13960.6,
      "formatted_start": "03:52:38.080",
      "formatted_end": "03:52:40.600",
      "text": "خب این دو تا عربا با هم دعوا دارن"
    },
    {
      "id": 41,
      "start": 13960.6,
      "end": 13962.6,
      "formatted_start": "03:52:40.600",
      "formatted_end": "03:52:42.600",
      "text": "من ممکنه دو تا عربابم"
    },
    {
      "id": 42,
      "start": 13962.6,
      "end": 13964.6,
      "formatted_start": "03:52:42.600",
      "formatted_end": "03:52:44.600",
      "text": "یعنی از می کنیم"
    },
    {
      "id": 43,
      "start": 13964.6,
      "end": 13966.6,
      "formatted_start": "03:52:44.600",
      "formatted_end": "03:52:46.600",
      "text": "درده دو تا سرورم"
    },
    {
      "id": 44,
      "start": 13966.6,
      "end": 13968.6,
      "formatted_start": "03:52:46.600",
      "formatted_end": "03:52:48.600",
      "text": "که این دو تا سرور هر حکمی"
    },
    {
      "id": 45,
      "start": 13968.6,
      "end": 13970.6,
      "formatted_start": "03:52:48.600",
      "formatted_end": "03:52:50.600",
      "text": "اینکی می کنه و دیگری نقض می کنه"
    },
    {
      "id": 46,
      "start": 13970.6,
      "end": 13972.6,
      "formatted_start": "03:52:50.600",
      "formatted_end": "03:52:52.600",
      "text": "و هر حکمی این می کنه و دیگری فستش می کنه"
    },
    {
      "id": 47,
      "start": 13972.6,
      "end": 13974.6,
      "formatted_start": "03:52:52.600",
      "formatted_end": "03:52:54.600",
      "text": "و هر حکمی این می کنه"
    },
    {
      "id": 48,
      "start": 13974.6,
      "end": 13976.6,
      "formatted_start": "03:52:54.600",
      "formatted_end": "03:52:56.600",
      "text": "و دیگری نقض می کنه"
    },
    {
      "id": 49,
      "start": 13976.6,
      "end": 13978.6,
      "formatted_start": "03:52:56.600",
      "formatted_end": "03:52:58.600",
      "text": "و هر حکمی اون می کنه و این دیگری فستش می کنه"
    },
    {
      "id": 50,
      "start": 13978.6,
      "end": 13980.6,
      "formatted_start": "03:52:58.600",
      "formatted_end": "03:53:00.600",
      "text": "من باید چی کار کنم"
    },
    {
      "id": 51,
      "start": 13980.6,
      "end": 13982.6,
      "formatted_start": "03:53:00.600",
      "formatted_end": "03:53:02.600",
      "text": "این وسط موندم"
    },
    {
      "id": 52,
      "start": 13982.6,
      "end": 13984.6,
      "formatted_start": "03:53:02.600",
      "formatted_end": "03:53:04.600",
      "text": "اگر یک عرباب داشتم"
    },
    {
      "id": 53,
      "start": 13984.6,
      "end": 13986.6,
      "formatted_start": "03:53:04.600",
      "formatted_end": "03:53:06.600",
      "text": "اگر اون عرباب لذت بود"
    },
    {
      "id": 54,
      "start": 13986.6,
      "end": 14008.6,
      "formatted_start": "03:53:06.600",
      "formatted_end": "03:53:28.600",
      "text": "خوب، عالی بود، اگر اون ارواح، اون معنا بود، اون هم عالی بود، ولی اعضا دانم، و اینه که اون هم خوشگیست، دانم نمیدونه بود و از این دستر که خواهی درست دارد، چند از مصنوع معنوی خودم رو زیر پا گذاشتم، به کامل تد خوشیده بزنم،"
    },
    {
      "id": 55,
      "start": 14008.6,
      "end": 14015.6,
      "formatted_start": "03:53:28.600",
      "formatted_end": "03:53:35.600",
      "text": "میرم به طرف معنویت، میرم یک کار معنوی بکنم"
    },
    {
      "id": 56,
      "start": 14015.6,
      "end": 14023.6,
      "formatted_start": "03:53:35.600",
      "formatted_end": "03:53:43.600",
      "text": "ببینم که با خودم در نظر دارم ببین با این کار معنوی تو چه دستاتو از دست دادی؟"
    },
    {
      "id": 57,
      "start": 14023.6,
      "end": 14032.6,
      "formatted_start": "03:53:43.600",
      "formatted_end": "03:53:52.600",
      "text": "ببین دوستانتو که دفتر دقیق معنویت ندارن، الان دارن چه گوته میخورن در نظر، چقدر شادن"
    },
    {
      "id": 58,
      "start": 14032.6,
      "end": 14052.6,
      "formatted_start": "03:53:52.600",
      "formatted_end": "03:54:12.600",
      "text": "موسیقی"
    },
    {
      "id": 59,
      "start": 14062.6,
      "end": 14086.6,
      "formatted_start": "03:54:22.600",
      "formatted_end": "03:54:46.600",
      "text": "موسیقی"
    },
    {
      "id": 60,
      "start": 14086.6,
      "end": 14091.14,
      "formatted_start": "03:54:46.600",
      "formatted_end": "03:54:51.140",
      "text": "سلام دوست دوست عزیز خوبی؟ خسته نباشه خوب موند"
    },
    {
      "id": 61,
      "start": 14091.14,
      "end": 14095.62,
      "formatted_start": "03:54:51.140",
      "formatted_end": "03:54:55.620",
      "text": "آه امروز تماس رفتیم بعد از رو خانمان برای روکیشش اینا"
    },
    {
      "id": 62,
      "start": 14095.62,
      "end": 14099.98,
      "formatted_start": "03:54:55.620",
      "formatted_end": "03:54:59.980",
      "text": "گفتم میگه آخر وقت تون مایبت من چه ساعتی همون"
    }
  ],
  "status": "completed"
}