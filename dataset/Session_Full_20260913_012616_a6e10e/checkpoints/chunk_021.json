  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6308.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:08.000",
      "text": "بله، دکتر ببخشی، این شکمش برای چی از این میکنه؟ اگر روده، قبل از که تنبالی روده داشته یا نه؟"
    },
    {
      "id": 1,
      "start": 6308.0,
      "end": 6311.0,
      "formatted_start": "01:45:08.000",
      "formatted_end": "01:45:11.000",
      "text": "خب، این کار کردن شکمش خوبه یا دیر و دیره؟"
    },
    {
      "id": 2,
      "start": 6311.0,
      "end": 6314.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:14.000",
      "text": "نه، دیر روز فقط کار نکرد، خوب بود، فره روز کار دیر و دیره، خوب بود."
    },
    {
      "id": 3,
      "start": 6314.0,
      "end": 6320.0,
      "formatted_start": "01:45:14.000",
      "formatted_end": "01:45:20.000",
      "text": "اگر راحت کار میکنی که هیچ، ممکنه قدر لنفید آخری شکم واسه درد بشه این مرد."
    },
    {
      "id": 4,
      "start": 6320.0,
      "end": 6321.0,
      "formatted_start": "01:45:20.000",
      "formatted_end": "01:45:21.000",
      "text": "چی؟"
    },
    {
      "id": 5,
      "start": 6321.0,
      "end": 6322.0,
      "formatted_start": "01:45:21.000",
      "formatted_end": "01:45:22.000",
      "text": "اگر شکمش دیر، کار میکنه..."
    },
    {
      "id": 6,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "مشکل که ندارن"
    },
    {
      "id": 7,
      "start": 6324.0,
      "end": 6326.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:26.000",
      "text": "کنو انجام شده"
    },
    {
      "id": 8,
      "start": 6326.0,
      "end": 6328.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:28.000",
      "text": "تنبالی روده داره"
    },
    {
      "id": 9,
      "start": 6328.0,
      "end": 6330.0,
      "formatted_start": "01:45:28.000",
      "formatted_end": "01:45:30.000",
      "text": "آه تنبالی روده داره شرط انجیل بیدیم"
    },
    {
      "id": 10,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "داره روده هاش فعال تر بشیم"
    },
    {
      "id": 11,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "شرط انجیل دارو خانه داره اینا"
    },
    {
      "id": 12,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "آه خوشتون"
    },
    {
      "id": 13,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "اما فشارش آقایی تو بیدیم"
    },
    {
      "id": 14,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "فشار اینا معمولا چیز نیست خانه رودی نیست"
    },
    {
      "id": 15,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "اقبال"
    },
    {
      "id": 16,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "تو اقبال ما فشار اون"
    },
    {
      "id": 17,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "آین و بالا نداریم تو بچه ها"
    },
    {
      "id": 18,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "مثل بزرگ سال ها"
    },
    {
      "id": 19,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "نیستن"
    },
    {
      "id": 20,
      "start": 6350.0,
      "end": 6354.64,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:54.640",
      "text": "میگه آل ندارم، میگم آل ندارم خودتیه"
    },
    {
      "id": 21,
      "start": 6354.64,
      "end": 6355.64,
      "formatted_start": "01:45:54.640",
      "formatted_end": "01:45:55.640",
      "text": "آفرین خودتیه"
    },
    {
      "id": 22,
      "start": 6355.64,
      "end": 6356.64,
      "formatted_start": "01:45:55.640",
      "formatted_end": "01:45:56.640",
      "text": "میگم از همونه"
    },
    {
      "id": 23,
      "start": 6356.64,
      "end": 6357.64,
      "formatted_start": "01:45:56.640",
      "formatted_end": "01:45:57.640",
      "text": "از همونه، آدی؟"
    },
    {
      "id": 24,
      "start": 6357.64,
      "end": 6359.64,
      "formatted_start": "01:45:57.640",
      "formatted_end": "01:45:59.640",
      "text": "ای گلوم ای گلوم"
    },
    {
      "id": 25,
      "start": 6359.64,
      "end": 6362.04,
      "formatted_start": "01:45:59.640",
      "formatted_end": "01:46:02.040",
      "text": "این شروط هاشو قاشوهای غذا خوری بده"
    },
    {
      "id": 26,
      "start": 6362.04,
      "end": 6364.04,
      "formatted_start": "01:46:02.040",
      "formatted_end": "01:46:04.040",
      "text": "آره غذا خوری دارم بده"
    },
    {
      "id": 27,
      "start": 6364.04,
      "end": 6366.04,
      "formatted_start": "01:46:04.040",
      "formatted_end": "01:46:06.040",
      "text": "امروش صبح دادم"
    },
    {
      "id": 28,
      "start": 6375.64,
      "end": 6377.64,
      "formatted_start": "01:46:15.640",
      "formatted_end": "01:46:17.640",
      "text": "پشارش 10 دقیقه"
    },
    {
      "id": 29,
      "start": 6377.64,
      "end": 6379.64,
      "formatted_start": "01:46:17.640",
      "formatted_end": "01:46:19.640",
      "text": "اگه سرگیجه زیاد داره یه سرو میده"
    },
    {
      "id": 30,
      "start": 6379.64,
      "end": 6381.64,
      "formatted_start": "01:46:19.640",
      "formatted_end": "01:46:21.640",
      "text": "سرگیجه داره یا نداره؟"
    },
    {
      "id": 31,
      "start": 6381.64,
      "end": 6383.64,
      "formatted_start": "01:46:21.640",
      "formatted_end": "01:46:23.640",
      "text": "اون داره"
    },
    {
      "id": 32,
      "start": 6383.64,
      "end": 6385.64,
      "formatted_start": "01:46:23.640",
      "formatted_end": "01:46:25.640",
      "text": "چی میگه؟"
    },
    {
      "id": 33,
      "start": 6385.64,
      "end": 6387.64,
      "formatted_start": "01:46:25.640",
      "formatted_end": "01:46:27.640",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 6387.64,
      "end": 6390.14,
      "formatted_start": "01:46:27.640",
      "formatted_end": "01:46:30.140",
      "text": "حالا اگه سرپیج سیاده بده من یه سر رو بدم"
    },
    {
      "id": 35,
      "start": 6390.14,
      "end": 6391.64,
      "formatted_start": "01:46:30.140",
      "formatted_end": "01:46:31.640",
      "text": "میگه یک کم نمیدونه"
    },
    {
      "id": 36,
      "start": 6391.64,
      "end": 6393.14,
      "formatted_start": "01:46:31.640",
      "formatted_end": "01:46:33.140",
      "text": "نه یک کم مهم نیست"
    },
    {
      "id": 37,
      "start": 6393.14,
      "end": 6394.14,
      "formatted_start": "01:46:33.140",
      "formatted_end": "01:46:34.140",
      "text": "میگم مهم نیست"
    },
    {
      "id": 38,
      "start": 6394.14,
      "end": 6396.14,
      "formatted_start": "01:46:34.140",
      "formatted_end": "01:46:36.140",
      "text": "حالا مایات اینا پیشتر بینیم استراحت کنه"
    },
    {
      "id": 39,
      "start": 6396.14,
      "end": 6398.14,
      "formatted_start": "01:46:36.140",
      "formatted_end": "01:46:38.140",
      "text": "گلده مایاشی بود استراحت هم بود"
    },
    {
      "id": 40,
      "start": 6398.14,
      "end": 6399.14,
      "formatted_start": "01:46:38.140",
      "formatted_end": "01:46:39.140",
      "text": "آره"
    },
    {
      "id": 41,
      "start": 6399.14,
      "end": 6401.14,
      "formatted_start": "01:46:39.140",
      "formatted_end": "01:46:41.140",
      "text": "ولی کلاس داره امروز"
    },
    {
      "id": 42,
      "start": 6401.14,
      "end": 6403.14,
      "formatted_start": "01:46:41.140",
      "formatted_end": "01:46:43.140",
      "text": "نه نه این داره استراحت کنه"
    },
    {
      "id": 43,
      "start": 6403.14,
      "end": 6403.64,
      "formatted_start": "01:46:43.140",
      "formatted_end": "01:46:43.640",
      "text": "نه نه"
    },
    {
      "id": 44,
      "start": 6403.64,
      "end": 6405.14,
      "formatted_start": "01:46:43.640",
      "formatted_end": "01:46:45.140",
      "text": "ولی خمسنین بود و گواهی بود"
    },
    {
      "id": 45,
      "start": 6405.14,
      "end": 6407.14,
      "formatted_start": "01:46:45.140",
      "formatted_end": "01:46:47.140",
      "text": "باشه نه این کلاس رو برم نه"
    },
    {
      "id": 46,
      "start": 6407.14,
      "end": 6408.64,
      "formatted_start": "01:46:47.140",
      "formatted_end": "01:46:48.640",
      "text": "خب پس هیچی مهم نیست"
    },
    {
      "id": 47,
      "start": 6408.64,
      "end": 6409.64,
      "formatted_start": "01:46:48.640",
      "formatted_end": "01:46:49.640",
      "text": "خیلی شکر میکنم"
    },
    {
      "id": 48,
      "start": 6409.64,
      "end": 6411.64,
      "formatted_start": "01:46:49.640",
      "formatted_end": "01:46:51.640",
      "text": "یک را اون پیش را دست نمیشم؟ برم برم باشیم"
    },
    {
      "id": 49,
      "start": 6411.64,
      "end": 6413.64,
      "formatted_start": "01:46:51.640",
      "formatted_end": "01:46:53.640",
      "text": "باشیم ممنون"
    },
    {
      "id": 50,
      "start": 6413.64,
      "end": 6415.64,
      "formatted_start": "01:46:53.640",
      "formatted_end": "01:46:55.640",
      "text": "خواهش کنم خدا باشیم"
    },
    {
      "id": 51,
      "start": 6429.64,
      "end": 6431.64,
      "formatted_start": "01:47:09.640",
      "formatted_end": "01:47:11.640",
      "text": "سلام بابا جا سلامت بشید"
    },
    {
      "id": 52,
      "start": 6431.64,
      "end": 6433.64,
      "formatted_start": "01:47:11.640",
      "formatted_end": "01:47:13.640",
      "text": "بفرمید"
    },
    {
      "id": 53,
      "start": 6433.64,
      "end": 6435.64,
      "formatted_start": "01:47:13.640",
      "formatted_end": "01:47:15.640",
      "text": "گوشهاشو میکنید شراخ کنید"
    },
    {
      "id": 54,
      "start": 6435.64,
      "end": 6437.64,
      "formatted_start": "01:47:15.640",
      "formatted_end": "01:47:17.640",
      "text": "خانم مالیز هم هست"
    },
    {
      "id": 55,
      "start": 6437.64,
      "end": 6442.14,
      "formatted_start": "01:47:17.640",
      "formatted_end": "01:47:22.140",
      "text": "برای ملیز شماله گرفتی این ملیزیش؟ نه"
    },
    {
      "id": 56,
      "start": 6442.14,
      "end": 6445.14,
      "formatted_start": "01:47:22.140",
      "formatted_end": "01:47:25.140",
      "text": "خامسمی این گوشه یا فقط ملیز هم هست؟ دوتا هم"
    },
    {
      "id": 57,
      "start": 6445.14,
      "end": 6446.64,
      "formatted_start": "01:47:25.140",
      "formatted_end": "01:47:26.640",
      "text": "فقط گوشه"
    },
    {
      "id": 58,
      "start": 6446.64,
      "end": 6447.64,
      "formatted_start": "01:47:26.640",
      "formatted_end": "01:47:27.640",
      "text": "بله؟"
    },
    {
      "id": 59,
      "start": 6447.64,
      "end": 6450.64,
      "formatted_start": "01:47:27.640",
      "formatted_end": "01:47:30.640",
      "text": "فقط گوشه نوزار بیلوره"
    },
    {
      "id": 60,
      "start": 6450.64,
      "end": 6453.64,
      "formatted_start": "01:47:30.640",
      "formatted_end": "01:47:33.640",
      "text": "خیلی خوب فقط گوشه خب بفهم میشه نیست؟"
    },
    {
      "id": 61,
      "start": 6453.64,
      "end": 6455.64,
      "formatted_start": "01:47:33.640",
      "formatted_end": "01:47:35.640",
      "text": "اشکال نده است اما اون"
    },
    {
      "id": 62,
      "start": 6455.64,
      "end": 6461.64,
      "formatted_start": "01:47:35.640",
      "formatted_end": "01:47:41.640",
      "text": "نه نه اون اشکال نده ببینیم الان که سراخ کردم گوشوارات رو عرفته تو گوشش باشه"
    },
    {
      "id": 63,
      "start": 6461.64,
      "end": 6465.96,
      "formatted_start": "01:47:41.640",
      "formatted_end": "01:47:45.960",
      "text": "خانم سمی پنسون وره"
    },
    {
      "id": 64,
      "start": 6465.96,
      "end": 6468.22,
      "formatted_start": "01:47:45.960",
      "formatted_end": "01:47:48.220",
      "text": "پنسون بیاریم"
    },
    {
      "id": 65,
      "start": 6468.22,
      "end": 6470.54,
      "formatted_start": "01:47:48.220",
      "formatted_end": "01:47:50.540",
      "text": "تا فردا به بوشاش"
    },
    {
      "id": 66,
      "start": 6470.54,
      "end": 6471.62,
      "formatted_start": "01:47:50.540",
      "formatted_end": "01:47:51.620",
      "text": "آب نخوره"
    },
    {
      "id": 67,
      "start": 6471.62,
      "end": 6474.36,
      "formatted_start": "01:47:51.620",
      "formatted_end": "01:47:54.360",
      "text": "یه کماد موپیلیسینم"
    },
    {
      "id": 68,
      "start": 6474.36,
      "end": 6475.16,
      "formatted_start": "01:47:54.360",
      "formatted_end": "01:47:55.160",
      "text": "می نویسن"
    },
    {
      "id": 69,
      "start": 6475.16,
      "end": 6477.74,
      "formatted_start": "01:47:55.160",
      "formatted_end": "01:47:57.740",
      "text": "هر هشت ساعت مالیده شده"
    },
    {
      "id": 70,
      "start": 6477.74,
      "end": 6479.0,
      "formatted_start": "01:47:57.740",
      "formatted_end": "01:47:59.000",
      "text": "به بوشاش آفرد"
    },
    {
      "id": 71,
      "start": 6479.0,
      "end": 6479.48,
      "formatted_start": "01:47:59.000",
      "formatted_end": "01:47:59.480",
      "text": "یه بیاریم"
    },
    {
      "id": 72,
      "start": 6479.48,
      "end": 6482.38,
      "formatted_start": "01:47:59.480",
      "formatted_end": "01:48:02.380",
      "text": "شما بیرون باش"
    },
    {
      "id": 73,
      "start": 6482.38,
      "end": 6484.62,
      "formatted_start": "01:48:02.380",
      "formatted_end": "01:48:04.620",
      "text": "یه نفر داخل کنید"
    },
    {
      "id": 74,
      "start": 6484.62,
      "end": 6486.0,
      "formatted_start": "01:48:04.620",
      "formatted_end": "01:48:06.000",
      "text": "بفرمایید یه نفر داخل کنید"
    },
    {
      "id": 75,
      "start": 6486.0,
      "end": 6488.34,
      "formatted_start": "01:48:06.000",
      "formatted_end": "01:48:08.340",
      "text": "خیلی بفرمایید"
    },
    {
      "id": 76,
      "start": 6488.34,
      "end": 6493.66,
      "formatted_start": "01:48:08.340",
      "formatted_end": "01:48:13.660",
      "text": "آدم کم باشه تو اتاق باید ترس رو بخشید"
    },
    {
      "id": 77,
      "start": 6493.66,
      "end": 6495.22,
      "formatted_start": "01:48:13.660",
      "formatted_end": "01:48:15.220",
      "text": "چرا؟"
    },
    {
      "id": 78,
      "start": 6518.34,
      "end": 6542.34,
      "formatted_start": "01:48:38.340",
      "formatted_end": "01:49:02.340",
      "text": "موسیقی"
    },
    {
      "id": 79,
      "start": 6542.34,
      "end": 6557.34,
      "formatted_start": "01:49:02.340",
      "formatted_end": "01:49:17.340",
      "text": "اینجوری نگهندار"
    },
    {
      "id": 80,
      "start": 6557.34,
      "end": 6562.34,
      "formatted_start": "01:49:17.340",
      "formatted_end": "01:49:22.340",
      "text": "بچه هستون تکیل بده به سینه دیگه از اینجوری دست اینجوری"
    },
    {
      "id": 81,
      "start": 6562.34,
      "end": 6566.34,
      "formatted_start": "01:49:22.340",
      "formatted_end": "01:49:26.340",
      "text": "خوب نگهندار"
    },
    {
      "id": 82,
      "start": 6566.34,
      "end": 6570.34,
      "formatted_start": "01:49:26.340",
      "formatted_end": "01:49:30.340",
      "text": "و سر بلا"
    },
    {
      "id": 83,
      "start": 6570.34,
      "end": 6572.34,
      "formatted_start": "01:49:30.340",
      "formatted_end": "01:49:32.340",
      "text": "تمام"
    },
    {
      "id": 84,
      "start": 6572.34,
      "end": 6574.34,
      "formatted_start": "01:49:32.340",
      "formatted_end": "01:49:34.340",
      "text": "حالا موش موبری؟"
    },
    {
      "id": 85,
      "start": 6574.34,
      "end": 6576.34,
      "formatted_start": "01:49:34.340",
      "formatted_end": "01:49:36.340",
      "text": "جان جان جان تمام شد"
    },
    {
      "id": 86,
      "start": 6576.34,
      "end": 6578.34,
      "formatted_start": "01:49:36.340",
      "formatted_end": "01:49:38.340",
      "text": "جان"
    },
    {
      "id": 87,
      "start": 6578.34,
      "end": 6584.34,
      "formatted_start": "01:49:38.340",
      "formatted_end": "01:49:44.340",
      "text": "جان جان تمام شد تمام شد"
    },
    {
      "id": 88,
      "start": 6584.34,
      "end": 6586.34,
      "formatted_start": "01:49:44.340",
      "formatted_end": "01:49:46.340",
      "text": "جان جان جان تمام شد تمام شد"
    },
    {
      "id": 89,
      "start": 6586.34,
      "end": 6588.34,
      "formatted_start": "01:49:46.340",
      "formatted_end": "01:49:48.340",
      "text": "جان جان جان جان تمام شد تمام شد"
    },
    {
      "id": 90,
      "start": 6588.34,
      "end": 6590.34,
      "formatted_start": "01:49:48.340",
      "formatted_end": "01:49:50.340",
      "text": "جان جان جان جان تمام شد تمام شد"
    },
    {
      "id": 91,
      "start": 6590.34,
      "end": 6592.34,
      "formatted_start": "01:49:50.340",
      "formatted_end": "01:49:52.340",
      "text": "جان جان جان جان تمام شد تمام شد"
    },
    {
      "id": 92,
      "start": 6592.34,
      "end": 6596.34,
      "formatted_start": "01:49:52.340",
      "formatted_end": "01:49:56.340",
      "text": "این دومی اندر آمیشه و دیگه از این اتاق ترکیه میگذار"
    },
    {
      "id": 93,
      "start": 6596.34,
      "end": 6600.34,
      "formatted_start": "01:49:56.340",
      "formatted_end": "01:50:00.340",
      "text": "نه آروم نیشه آروم نیشه"
    }
  ],
  "status": "completed"
}