  "stt_segments": [
    {
      "id": 0,
      "start": 13200.0,
      "end": 13203.0,
      "formatted_start": "03:40:00.000",
      "formatted_end": "03:40:03.000",
      "text": "ناشادتری زندگی رو خواهید داشت."
    },
    {
      "id": 1,
      "start": 13205.0,
      "end": 13207.0,
      "formatted_start": "03:40:05.000",
      "formatted_end": "03:40:07.000",
      "text": "بدتری زندگی رو خواهید داشت."
    },
    {
      "id": 2,
      "start": 13209.0,
      "end": 13212.0,
      "formatted_start": "03:40:09.000",
      "formatted_end": "03:40:12.000",
      "text": "نخوشایندتری زندگی رو خواهید داشت."
    },
    {
      "id": 3,
      "start": 13213.0,
      "end": 13221.0,
      "formatted_start": "03:40:13.000",
      "formatted_end": "03:40:21.000",
      "text": "پس کسانی که زندگی از این آدمی که بیتره و خوشایندتره،"
    },
    {
      "id": 4,
      "start": 13221.0,
      "end": 13224.0,
      "formatted_start": "03:40:21.000",
      "formatted_end": "03:40:24.000",
      "text": "یا تو تقسیم مندی اول توی قسم دیگه جا میگیرن،"
    },
    {
      "id": 5,
      "start": 13224.0,
      "end": 13228.0,
      "formatted_start": "03:40:24.000",
      "formatted_end": "03:40:28.000",
      "text": "یا تو تقسیم مندی دومان توی قسم دیگه جا میگیرن،"
    },
    {
      "id": 6,
      "start": 13228.0,
      "end": 13234.0,
      "formatted_start": "03:40:28.000",
      "formatted_end": "03:40:34.000",
      "text": "یا تو تقسیم بندی اسم بردم توی قسم دیگه جامع گیرم یا تو تقسیم بندی چاقرم توی قسم دیگه جامع گیرم"
    },
    {
      "id": 7,
      "start": 13234.0,
      "end": 13237.0,
      "formatted_start": "03:40:34.000",
      "formatted_end": "03:40:37.000",
      "text": "این نکنه؟"
    },
    {
      "id": 8,
      "start": 13238.0,
      "end": 13249.0,
      "formatted_start": "03:40:38.000",
      "formatted_end": "03:40:49.000",
      "text": "اونی که تو این چهار تا تقسیم بندی تو هر کنامش تو اون قسمی که اسم بردم جامع گیره این زندگیش واقعا زندگی جهنمی خواهد بود"
    },
    {
      "id": 9,
      "start": 13249.0,
      "end": 13257.24,
      "formatted_start": "03:40:49.000",
      "formatted_end": "03:40:57.240",
      "text": "و این شخصی که محل بحث ماست یعنی حلیلر اعتبار می کنه"
    },
    {
      "id": 10,
      "start": 13257.24,
      "end": 13262.66,
      "formatted_start": "03:40:57.240",
      "formatted_end": "03:41:02.660",
      "text": "دسته برقضایی توی این شوزه می کنید"
    },
    {
      "id": 11,
      "start": 13262.66,
      "end": 13270.0,
      "formatted_start": "03:41:02.660",
      "formatted_end": "03:41:10.000",
      "text": "که همتون که گفتم نازل زندگیش خیلی از باره به زندگیش نگاه می کنه"
    },
    {
      "id": 12,
      "start": 13270.64,
      "end": 13274.08,
      "formatted_start": "03:41:10.640",
      "formatted_end": "03:41:14.080",
      "text": "فقط آمل زندگی نیست"
    },
    {
      "id": 13,
      "start": 13274.08,
      "end": 13277.54,
      "formatted_start": "03:41:14.080",
      "formatted_end": "03:41:17.540",
      "text": "و از این جهت هم"
    },
    {
      "id": 14,
      "start": 13277.54,
      "end": 13279.92,
      "formatted_start": "03:41:17.540",
      "formatted_end": "03:41:19.920",
      "text": "از توده های مردم متنفیه"
    },
    {
      "id": 15,
      "start": 13279.92,
      "end": 13282.3,
      "formatted_start": "03:41:19.920",
      "formatted_end": "03:41:22.300",
      "text": "چون فکر میکنه"
    },
    {
      "id": 16,
      "start": 13282.3,
      "end": 13283.66,
      "formatted_start": "03:41:22.300",
      "formatted_end": "03:41:23.660",
      "text": "توده های مردم"
    },
    {
      "id": 17,
      "start": 13283.66,
      "end": 13286.7,
      "formatted_start": "03:41:23.660",
      "formatted_end": "03:41:26.700",
      "text": "اصلا نمیدونن چرا اینجوری دارن زندگی میکنن"
    },
    {
      "id": 18,
      "start": 13286.7,
      "end": 13288.34,
      "formatted_start": "03:41:26.700",
      "formatted_end": "03:41:28.340",
      "text": "چون فقط توده های مردم"
    },
    {
      "id": 19,
      "start": 13288.34,
      "end": 13289.38,
      "formatted_start": "03:41:28.340",
      "formatted_end": "03:41:29.380",
      "text": "به نظره اون"
    },
    {
      "id": 20,
      "start": 13289.38,
      "end": 13290.8,
      "formatted_start": "03:41:29.380",
      "formatted_end": "03:41:30.800",
      "text": "فقط آمنه"
    },
    {
      "id": 21,
      "start": 13290.8,
      "end": 13293.74,
      "formatted_start": "03:41:30.800",
      "formatted_end": "03:41:33.740",
      "text": "و این اصلا مرزده در زندگی"
    },
    {
      "id": 22,
      "start": 13293.74,
      "end": 13295.3,
      "formatted_start": "03:41:33.740",
      "formatted_end": "03:41:35.300",
      "text": "که توش فقط آمن باشن"
    },
    {
      "id": 23,
      "start": 13295.3,
      "end": 13296.36,
      "formatted_start": "03:41:35.300",
      "formatted_end": "03:41:36.360",
      "text": "نداری کنید"
    },
    {
      "id": 24,
      "start": 13296.36,
      "end": 13299.26,
      "formatted_start": "03:41:36.360",
      "formatted_end": "03:41:39.260",
      "text": "همیشه میگه چقدر اینا توده که مرزن"
    },
    {
      "id": 25,
      "start": 13299.26,
      "end": 13301.32,
      "formatted_start": "03:41:39.260",
      "formatted_end": "03:41:41.320",
      "text": "چقدر سبانه مردم"
    },
    {
      "id": 26,
      "start": 13301.32,
      "end": 13303.56,
      "formatted_start": "03:41:41.320",
      "formatted_end": "03:41:43.560",
      "text": "هیچ فرق فکر نمیدونن"
    },
    {
      "id": 27,
      "start": 13303.56,
      "end": 13308.56,
      "formatted_start": "03:41:43.560",
      "formatted_end": "03:41:48.560",
      "text": "که چرا ما این موسیقی رو بوشه میدیم، نه اون موسیقی را؟"
    },
    {
      "id": 28,
      "start": 13308.56,
      "end": 13312.56,
      "formatted_start": "03:41:48.560",
      "formatted_end": "03:41:52.560",
      "text": "چرا این رقص رو ترجیم میدیم بر اون رقص؟"
    },
    {
      "id": 29,
      "start": 13312.56,
      "end": 13317.56,
      "formatted_start": "03:41:52.560",
      "formatted_end": "03:41:57.560",
      "text": "چرا از این نوع جلسات خوشمونیاد؟ نه از اونجور جلسات"
    },
    {
      "id": 30,
      "start": 13317.56,
      "end": 13324.56,
      "formatted_start": "03:41:57.560",
      "formatted_end": "03:42:04.560",
      "text": "چرا از این فیلم ها و نمایشنام ها خوشمونیاد؟ نه از فیلم های دیگه و نمایشنام های دیگه"
    },
    {
      "id": 31,
      "start": 13324.56,
      "end": 13326.56,
      "formatted_start": "03:42:04.560",
      "formatted_end": "03:42:06.560",
      "text": "نه ببینیم"
    },
    {
      "id": 32,
      "start": 13326.56,
      "end": 13329.56,
      "formatted_start": "03:42:06.560",
      "formatted_end": "03:42:09.560",
      "text": "چرا این ناطفلی رو ترجیم میدیم بر اون ناطفلی؟"
    },
    {
      "id": 33,
      "start": 13329.56,
      "end": 13335.56,
      "formatted_start": "03:42:09.560",
      "formatted_end": "03:42:15.560",
      "text": "چرا به جای کتاب های گته کتاب های مدیگردی ترجیم میده؟"
    },
    {
      "id": 34,
      "start": 13335.56,
      "end": 13341.56,
      "formatted_start": "03:42:15.560",
      "formatted_end": "03:42:21.560",
      "text": "چرا به جای موسیقی موتسالتو با خوبه تومه ما موسیقی های محتضر را ترجیم میدیم؟"
    },
    {
      "id": 35,
      "start": 13341.56,
      "end": 13347.56,
      "formatted_start": "03:42:21.560",
      "formatted_end": "03:42:27.560",
      "text": "چرا مثلا به نظر ما جزب ترجیم میدیم؟ این را از ما چونه میپرسن؟"
    },
    {
      "id": 36,
      "start": 13347.56,
      "end": 13356.56,
      "formatted_start": "03:42:27.560",
      "formatted_end": "03:42:36.560",
      "text": "اگر میپرسید چرا تو موسیقی جزب داری؟ میگویید چون همه موسیقی جزب دارند، نه می کنی؟"
    },
    {
      "id": 37,
      "start": 13356.56,
      "end": 13375.4,
      "formatted_start": "03:42:36.560",
      "formatted_end": "03:42:55.400",
      "text": "بنابراین نه برای ترجیحاتشون در صور و زیان، نه برای ترجیحاتشون در دو نر، یعنی در سی بایوزشی، نه برای ترجیحاتشون در عمل، یعنی خوبی و بدی عمل، نیم، روسیان ها دوستی عمل، این ازن هیچ استداری ندارن."
    },
    {
      "id": 38,
      "start": 13375.4,
      "end": 13384.04,
      "formatted_start": "03:42:55.400",
      "formatted_end": "03:43:04.040",
      "text": "هری حالر گریزش و نفرتش از توده های مردم که تو سر تا سر این کتاب میبینید"
    },
    {
      "id": 39,
      "start": 13384.04,
      "end": 13389.54,
      "formatted_start": "03:43:04.040",
      "formatted_end": "03:43:09.540",
      "text": "به خاطر اینه که میبینید اینم فقط آمل هستن، ناظر نیستن"
    },
    {
      "id": 40,
      "start": 13389.54,
      "end": 13394.26,
      "formatted_start": "03:43:09.540",
      "formatted_end": "03:43:14.260",
      "text": "هر چیزی رو ازشون بپرسید چرا این کتاب، نمون کتاب"
    },
    {
      "id": 41,
      "start": 13394.26,
      "end": 13398.64,
      "formatted_start": "03:43:14.260",
      "formatted_end": "03:43:18.640",
      "text": "و به هر ترتیب دیگری هر چیزی رو بپرسید چرا این و نمون"
    },
    {
      "id": 42,
      "start": 13398.64,
      "end": 13401.7,
      "formatted_start": "03:43:18.640",
      "formatted_end": "03:43:21.700",
      "text": "میگن اون چون بقیه اونجونی هستن، این ماموس بقیه"
    },
    {
      "id": 43,
      "start": 13401.7,
      "end": 13409.3,
      "formatted_start": "03:43:21.700",
      "formatted_end": "03:43:29.300",
      "text": "اینا کسانی هستن که مجتمعا فضای هیچ میشن"
    },
    {
      "id": 44,
      "start": 13409.3,
      "end": 13412.28,
      "formatted_start": "03:43:29.300",
      "formatted_end": "03:43:32.280",
      "text": "همه شون فضای هیچ میشن"
    },
    {
      "id": 45,
      "start": 13412.28,
      "end": 13414.44,
      "formatted_start": "03:43:32.280",
      "formatted_end": "03:43:34.440",
      "text": "چرا؟"
    },
    {
      "id": 46,
      "start": 13414.44,
      "end": 13418.16,
      "formatted_start": "03:43:34.440",
      "formatted_end": "03:43:38.160",
      "text": "چون وقتی از تو میپرسن از توی آقای خانم"
    },
    {
      "id": 47,
      "start": 13418.16,
      "end": 13420.98,
      "formatted_start": "03:43:38.160",
      "formatted_end": "03:43:40.980",
      "text": "میپرسن چرا اینجوری زندگی میکنی"
    },
    {
      "id": 48,
      "start": 13420.98,
      "end": 13423.7,
      "formatted_start": "03:43:40.980",
      "formatted_end": "03:43:43.700",
      "text": "وقتی به شون میگی که"
    },
    {
      "id": 49,
      "start": 13423.7,
      "end": 13427.28,
      "formatted_start": "03:43:43.700",
      "formatted_end": "03:43:47.280",
      "text": "چون دیگران زندگیشون اینجوریه"
    },
    {
      "id": 50,
      "start": 13427.28,
      "end": 13429.94,
      "formatted_start": "03:43:47.280",
      "formatted_end": "03:43:49.940",
      "text": "یکی از اون دیگران هم برای مصطفی میگی"
    },
    {
      "id": 51,
      "start": 13429.94,
      "end": 13435.38,
      "formatted_start": "03:43:49.940",
      "formatted_end": "03:43:55.380",
      "text": "از تو به من هم تکیه دادی"
    },
    {
      "id": 52,
      "start": 13435.38,
      "end": 13437.26,
      "formatted_start": "03:43:55.380",
      "formatted_end": "03:43:57.260",
      "text": "چون یکی از اون دیگران هم من"
    },
    {
      "id": 53,
      "start": 13437.26,
      "end": 13439.98,
      "formatted_start": "03:43:57.260",
      "formatted_end": "03:43:59.980",
      "text": "حالا اگر من مستقبل مستم"
    },
    {
      "id": 54,
      "start": 13439.98,
      "end": 13442.4,
      "formatted_start": "03:43:59.980",
      "formatted_end": "03:44:02.400",
      "text": "تو چرا اینجوری زندگی میکنی"
    },
    {
      "id": 55,
      "start": 13442.4,
      "end": 13444.24,
      "formatted_start": "03:44:02.400",
      "formatted_end": "03:44:04.240",
      "text": "بگم چون دیگران بیکنن"
    },
    {
      "id": 56,
      "start": 13444.24,
      "end": 13446.28,
      "formatted_start": "03:44:04.240",
      "formatted_end": "03:44:06.280",
      "text": "یکی از دیگران هم توی دیگر"
    },
    {
      "id": 57,
      "start": 13446.28,
      "end": 13450.04,
      "formatted_start": "03:44:06.280",
      "formatted_end": "03:44:10.040",
      "text": "و با این استعداد قرار بکنید"
    },
    {
      "id": 58,
      "start": 13450.04,
      "end": 13454.12,
      "formatted_start": "03:44:10.040",
      "formatted_end": "03:44:14.120",
      "text": "همه من در فدایی نابود میشه"
    },
    {
      "id": 59,
      "start": 13454.12,
      "end": 13455.86,
      "formatted_start": "03:44:14.120",
      "formatted_end": "03:44:15.860",
      "text": "فدایی نابوده"
    },
    {
      "id": 60,
      "start": 13455.86,
      "end": 13457.94,
      "formatted_start": "03:44:15.860",
      "formatted_end": "03:44:17.940",
      "text": "فدایی موجودی که موجود نداری"
    },
    {
      "id": 61,
      "start": 13457.94,
      "end": 13463.94,
      "formatted_start": "03:44:17.940",
      "formatted_end": "03:44:23.940",
      "text": "چون من تکیب توی کنم تو تکیب من داریم"
    },
    {
      "id": 62,
      "start": 13463.94,
      "end": 13470.94,
      "formatted_start": "03:44:23.940",
      "formatted_end": "03:44:30.940",
      "text": "ممکنه بگید نه من تکیب تو نردم تکیب هزاران هزار دیگرم دارم"
    },
    {
      "id": 63,
      "start": 13470.94,
      "end": 13474.94,
      "formatted_start": "03:44:30.940",
      "formatted_end": "03:44:34.940",
      "text": "یا با هزار تا هزار تا هزار دیگرم همینجونم سراغ هر کدامشون برید"
    },
    {
      "id": 64,
      "start": 13474.94,
      "end": 13480.94,
      "formatted_start": "03:44:34.940",
      "formatted_end": "03:44:40.940",
      "text": "میگن به دیگران ما اعتماد کردیم و یکی از اون دیگران خودتونی"
    },
    {
      "id": 65,
      "start": 13480.94,
      "end": 13485.1,
      "formatted_start": "03:44:40.940",
      "formatted_end": "03:44:45.100",
      "text": "از همه محافظه هیچ میشه"
    },
    {
      "id": 66,
      "start": 13485.1,
      "end": 13486.28,
      "formatted_start": "03:44:45.100",
      "formatted_end": "03:44:46.280",
      "text": "در باید"
    },
    {
      "id": 67,
      "start": 13486.28,
      "end": 13488.44,
      "formatted_start": "03:44:46.280",
      "formatted_end": "03:44:48.440",
      "text": "نه بگوییم"
    },
    {
      "id": 68,
      "start": 13488.44,
      "end": 13490.68,
      "formatted_start": "03:44:48.440",
      "formatted_end": "03:44:50.680",
      "text": "یک نوع حیاغو"
    },
    {
      "id": 69,
      "start": 13490.68,
      "end": 13492.32,
      "formatted_start": "03:44:50.680",
      "formatted_end": "03:44:52.320",
      "text": "به تربیل شکسپیر"
    },
    {
      "id": 70,
      "start": 13492.32,
      "end": 13494.94,
      "formatted_start": "03:44:52.320",
      "formatted_end": "03:44:54.940",
      "text": "یک نوع حیاغو بر سرهیچی داریم"
    },
    {
      "id": 71,
      "start": 13494.94,
      "end": 13497.08,
      "formatted_start": "03:44:54.940",
      "formatted_end": "03:44:57.080",
      "text": "چون دیگران"
    },
    {
      "id": 72,
      "start": 13497.08,
      "end": 13498.54,
      "formatted_start": "03:44:57.080",
      "formatted_end": "03:44:58.540",
      "text": "این دیگری تفریم میکنن"
    },
    {
      "id": 73,
      "start": 13498.54,
      "end": 13499.6,
      "formatted_start": "03:44:58.540",
      "formatted_end": "03:44:59.600",
      "text": "چرا شما"
    }
  ],
  "status": "completed"
}