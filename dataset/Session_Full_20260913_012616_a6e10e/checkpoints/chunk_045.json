  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13508.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:08.000",
      "text": "فلان جزیر رو انتخاب کردید برای تفریه تو، چون خب همه هن جزیر رو انتخاب کردید."
    },
    {
      "id": 1,
      "start": 13508.0,
      "end": 13516.0,
      "formatted_start": "03:45:08.000",
      "formatted_end": "03:45:16.000",
      "text": "ترکو کنید؟ چرا شما میرید هوایی؟ چون همه هوایی میرند."
    },
    {
      "id": 2,
      "start": 13516.0,
      "end": 13520.0,
      "formatted_start": "03:45:16.000",
      "formatted_end": "03:45:20.000",
      "text": "چرا شما کیش میرید؟ چون همه کیش میرند."
    },
    {
      "id": 3,
      "start": 13520.0,
      "end": 13524.0,
      "formatted_start": "03:45:20.000",
      "formatted_end": "03:45:24.000",
      "text": "ترکو کنید؟ چون همه کیش میرند."
    },
    {
      "id": 4,
      "start": 13524.0,
      "end": 13538.88,
      "formatted_start": "03:45:24.000",
      "formatted_end": "03:45:38.880",
      "text": "هیچ کس نمیگه که من تحقیق کردم دیدم به لحاظ جسمانی یا به لحاظ ذهنی یا به لحاظ روانی آب و هوای فلان جزیره اثر مصمت تر گفت"
    },
    {
      "id": 5,
      "start": 13538.88,
      "end": 13542.64,
      "formatted_start": "03:45:38.880",
      "formatted_end": "03:45:42.640",
      "text": "کسی نمیخواهد گفتم نمیبینید چون"
    },
    {
      "id": 6,
      "start": 13542.64,
      "end": 13546.54,
      "formatted_start": "03:45:42.640",
      "formatted_end": "03:45:46.540",
      "text": "چرا این قضا را ترجیم میدید بر اون قضا چون"
    },
    {
      "id": 7,
      "start": 13546.54,
      "end": 13551.14,
      "formatted_start": "03:45:46.540",
      "formatted_end": "03:45:51.140",
      "text": "معمولا قضا را اگه پیش دیگرم بزنن ترجیم در بقیه قضا ها"
    },
    {
      "id": 8,
      "start": 13551.14,
      "end": 13558.94,
      "formatted_start": "03:45:51.140",
      "formatted_end": "03:45:58.940",
      "text": "هیچوقت تحقیق نکردم که تقادر مقصی و مخفی و مشکلی این قضا بیشتر از بقیه قضاهاست"
    },
    {
      "id": 9,
      "start": 13558.94,
      "end": 13562.7,
      "formatted_start": "03:45:58.940",
      "formatted_end": "03:46:02.700",
      "text": "یعنی این قضا مقصی تر و مقصی تر و مشکلی تر"
    },
    {
      "id": 10,
      "start": 13562.7,
      "end": 13564.7,
      "formatted_start": "03:46:02.700",
      "formatted_end": "03:46:04.700",
      "text": "تحقیق که من نکردم"
    },
    {
      "id": 11,
      "start": 13564.7,
      "end": 13569.54,
      "formatted_start": "03:46:04.700",
      "formatted_end": "03:46:09.540",
      "text": "و به همه تک چیزی ریاضی رو خواهیم کنم"
    },
    {
      "id": 12,
      "start": 13569.54,
      "end": 13577.94,
      "formatted_start": "03:46:09.540",
      "formatted_end": "03:46:17.940",
      "text": "من نمیگم این ریاضی ریاض به خاطر اینکه برای نگاه هایی که مندوش میشه سالت پریم"
    },
    {
      "id": 13,
      "start": 13577.94,
      "end": 13586.86,
      "formatted_start": "03:46:17.940",
      "formatted_end": "03:46:26.860",
      "text": "نمیگم چون این لباس در تابستان بعدم رو خونکتر نگهردار به جهد رنگش"
    },
    {
      "id": 14,
      "start": 13586.86,
      "end": 13590.82,
      "formatted_start": "03:46:26.860",
      "formatted_end": "03:46:30.820",
      "text": "یا در زبستان جهد بدم رو گردتر نگهردار به جهد رنگش"
    },
    {
      "id": 15,
      "start": 13590.82,
      "end": 13592.2,
      "formatted_start": "03:46:30.820",
      "formatted_end": "03:46:32.200",
      "text": "این رو تقریب نکردم"
    },
    {
      "id": 16,
      "start": 13592.2,
      "end": 13596.52,
      "formatted_start": "03:46:32.200",
      "formatted_end": "03:46:36.520",
      "text": "میگم چون گیگرانم این لباس رو ترجیم میدن"
    },
    {
      "id": 17,
      "start": 13596.52,
      "end": 13598.72,
      "formatted_start": "03:46:36.520",
      "formatted_end": "03:46:38.720",
      "text": "این رنگ رو ترجیم میدن"
    },
    {
      "id": 18,
      "start": 13598.72,
      "end": 13603.46,
      "formatted_start": "03:46:38.720",
      "formatted_end": "03:46:43.460",
      "text": "و به همین ترتیب در تابه هر خوند و کار زندگی اینجوریه"
    },
    {
      "id": 19,
      "start": 13603.46,
      "end": 13608.36,
      "formatted_start": "03:46:43.460",
      "formatted_end": "03:46:48.360",
      "text": "و به نوانه اصلا نازق زندگی نیستن"
    },
    {
      "id": 20,
      "start": 13608.36,
      "end": 13609.46,
      "formatted_start": "03:46:48.360",
      "formatted_end": "03:46:49.460",
      "text": "نگاه نمی کنن"
    },
    {
      "id": 21,
      "start": 13609.46,
      "end": 13611.44,
      "formatted_start": "03:46:49.460",
      "formatted_end": "03:46:51.440",
      "text": "از خودم نمی پوستن"
    },
    {
      "id": 22,
      "start": 13611.44,
      "end": 13613.92,
      "formatted_start": "03:46:51.440",
      "formatted_end": "03:46:53.920",
      "text": "که چرا این کارو کردی"
    },
    {
      "id": 23,
      "start": 13613.92,
      "end": 13615.16,
      "formatted_start": "03:46:53.920",
      "formatted_end": "03:46:55.160",
      "text": "یا اون کارو"
    },
    {
      "id": 24,
      "start": 13615.16,
      "end": 13617.28,
      "formatted_start": "03:46:55.160",
      "formatted_end": "03:46:57.280",
      "text": "حالا"
    },
    {
      "id": 25,
      "start": 13617.28,
      "end": 13618.4,
      "formatted_start": "03:46:57.280",
      "formatted_end": "03:46:58.400",
      "text": "طرف"
    },
    {
      "id": 26,
      "start": 13618.4,
      "end": 13619.64,
      "formatted_start": "03:46:58.400",
      "formatted_end": "03:46:59.640",
      "text": "تنفلش"
    },
    {
      "id": 27,
      "start": 13619.64,
      "end": 13622.14,
      "formatted_start": "03:46:59.640",
      "formatted_end": "03:47:02.140",
      "text": "و بیزاریش از مردمان"
    },
    {
      "id": 28,
      "start": 13622.14,
      "end": 13624.12,
      "formatted_start": "03:47:02.140",
      "formatted_end": "03:47:04.120",
      "text": "این به اینه"
    },
    {
      "id": 29,
      "start": 13624.12,
      "end": 13626.56,
      "formatted_start": "03:47:04.120",
      "formatted_end": "03:47:06.560",
      "text": "البته خطایی داره"
    },
    {
      "id": 30,
      "start": 13626.56,
      "end": 13627.98,
      "formatted_start": "03:47:06.560",
      "formatted_end": "03:47:07.980",
      "text": "من منو خطاش کندم"
    },
    {
      "id": 31,
      "start": 13627.98,
      "end": 13630.18,
      "formatted_start": "03:47:07.980",
      "formatted_end": "03:47:10.180",
      "text": "ولی به هر حال اینو میبینه"
    },
    {
      "id": 32,
      "start": 13630.18,
      "end": 13631.94,
      "formatted_start": "03:47:10.180",
      "formatted_end": "03:47:11.940",
      "text": "چرا اینو فقط میبینه"
    },
    {
      "id": 33,
      "start": 13631.94,
      "end": 13639.94,
      "formatted_start": "03:47:11.940",
      "formatted_end": "03:47:19.940",
      "text": "رمعه ها دارن به دنبال یک دیگر می‌گنند، هر خدا بهشون به جهتی به این راه می‌دهد که دیگران به این جهت بودند."
    },
    {
      "id": 34,
      "start": 13639.94,
      "end": 13643.94,
      "formatted_start": "03:47:19.940",
      "formatted_end": "03:47:23.940",
      "text": "اون بیگمی هم به این جهت به این راه می‌دهد که دیگران به این جهت بودند."
    },
    {
      "id": 35,
      "start": 13643.94,
      "end": 13649.94,
      "formatted_start": "03:47:23.940",
      "formatted_end": "03:47:29.940",
      "text": "با قدرت همه‌مون نمی‌فرامده از که تبعیت می‌کنیم، از که تبلیغ می‌کنیم."
    },
    {
      "id": 36,
      "start": 13649.94,
      "end": 13656.94,
      "formatted_start": "03:47:29.940",
      "formatted_end": "03:47:36.940",
      "text": "حلیر در واقع مسئله‌اش بر سر اینه، توی قسمت اول تقسیم‌بندی،"
    },
    {
      "id": 37,
      "start": 13656.94,
      "end": 13662.94,
      "formatted_start": "03:47:36.940",
      "formatted_end": "03:47:42.940",
      "text": "که خودش رو هم نازر میدونه و هم آمل میدونه ولی دیگران رو فقط آمل داره"
    },
    {
      "id": 38,
      "start": 13662.94,
      "end": 13670.86,
      "formatted_start": "03:47:42.940",
      "formatted_end": "03:47:50.860",
      "text": "و وقتی دیگران آمل باشن خب طبعا من اینکه نازرم کم کم کم کم ازشون فاصله میگنم"
    },
    {
      "id": 39,
      "start": 13670.86,
      "end": 13675.68,
      "formatted_start": "03:47:50.860",
      "formatted_end": "03:47:55.680",
      "text": "و این تنهایی هم بگیرم ایجاد میکنم من دیگه تنها"
    },
    {
      "id": 40,
      "start": 13675.68,
      "end": 13680.56,
      "formatted_start": "03:47:55.680",
      "formatted_end": "03:48:00.560",
      "text": "چون با تو که میشیدم بعد از یک جلسه میبینم تو هم از هم بردیگه"
    },
    {
      "id": 41,
      "start": 13680.56,
      "end": 13685.32,
      "formatted_start": "03:48:00.560",
      "formatted_end": "03:48:05.320",
      "text": "دلم از تو هم بیزنه و بعد در جلسه بعدم با کسی دیگه میشیدم"
    },
    {
      "id": 42,
      "start": 13685.32,
      "end": 13693.34,
      "formatted_start": "03:48:05.320",
      "formatted_end": "03:48:13.340",
      "text": "و کم کم یک جا ببینم من باید دوری کنم از این جماعت رمهی که نوز شده"
    },
    {
      "id": 43,
      "start": 13693.34,
      "end": 13698.72,
      "formatted_start": "03:48:13.340",
      "formatted_end": "03:48:18.720",
      "text": "این گله یک سانه ها من موافقت همم نیست که تونگر زندگی بکنم"
    },
    {
      "id": 44,
      "start": 13698.72,
      "end": 13700.32,
      "formatted_start": "03:48:18.720",
      "formatted_end": "03:48:20.320",
      "text": "میخوام یه جودی که زندگی بکنم"
    },
    {
      "id": 45,
      "start": 13700.32,
      "end": 13704.42,
      "formatted_start": "03:48:20.320",
      "formatted_end": "03:48:24.420",
      "text": "خب این مطلب خیلی مطلب جدیدیه"
    },
    {
      "id": 46,
      "start": 13704.42,
      "end": 13706.22,
      "formatted_start": "03:48:24.420",
      "formatted_end": "03:48:26.220",
      "text": "یعنی میخوام میگم دوستان تک نکنم"
    },
    {
      "id": 47,
      "start": 13706.22,
      "end": 13710.9,
      "formatted_start": "03:48:26.220",
      "formatted_end": "03:48:30.900",
      "text": "این ادای روشند تک بازی در موردن"
    },
    {
      "id": 48,
      "start": 13710.9,
      "end": 13718.64,
      "formatted_start": "03:48:30.900",
      "formatted_end": "03:48:38.640",
      "text": "با آقا اینکه این که ما از این سر زندگیمون رو داریم به تولید از دیگران انجام میدیم"
    },
    {
      "id": 49,
      "start": 13718.64,
      "end": 13722.9,
      "formatted_start": "03:48:38.640",
      "formatted_end": "03:48:42.900",
      "text": "و هیچ فکر نکردیم که اولاً اون دیگران چی هست؟"
    },
    {
      "id": 50,
      "start": 13723.6,
      "end": 13726.9,
      "formatted_start": "03:48:43.600",
      "formatted_end": "03:48:46.900",
      "text": "وقتی داخل نکردیم ببینیم کسی نمیده"
    },
    {
      "id": 51,
      "start": 13726.9,
      "end": 13729.18,
      "formatted_start": "03:48:46.900",
      "formatted_end": "03:48:49.180",
      "text": "اون دیگران صفر هست"
    },
    {
      "id": 52,
      "start": 13729.18,
      "end": 13733.9,
      "formatted_start": "03:48:49.180",
      "formatted_end": "03:48:53.900",
      "text": "یکی دیگران فرض می کنم اون دیگران یک کسانی باشن که"
    },
    {
      "id": 53,
      "start": 13734.64,
      "end": 13738.88,
      "formatted_start": "03:48:54.640",
      "formatted_end": "03:48:58.880",
      "text": "بشه بر هم انگوشت اشاره به نرمشون گرفت"
    },
    {
      "id": 54,
      "start": 13738.88,
      "end": 13743.12,
      "formatted_start": "03:48:58.880",
      "formatted_end": "03:49:03.120",
      "text": "و با اینه که ازش تبعیت میکردم، اونه که ازش تبعیت میکردم"
    },
    {
      "id": 55,
      "start": 13743.12,
      "end": 13747.12,
      "formatted_start": "03:49:03.120",
      "formatted_end": "03:49:07.120",
      "text": "خب سوال میگی، چه ازم رو تبعیت کنی از اون دیگری یا دیگرها؟"
    },
    {
      "id": 56,
      "start": 13747.12,
      "end": 13749.12,
      "formatted_start": "03:49:07.120",
      "formatted_end": "03:49:09.120",
      "text": "چرا؟"
    },
    {
      "id": 57,
      "start": 13749.12,
      "end": 13755.72,
      "formatted_start": "03:49:09.120",
      "formatted_end": "03:49:15.720",
      "text": "اما من حالر، که ناظرم به ضدیقی خودم خب بی جور عمل نمیکنم"
    },
    {
      "id": 58,
      "start": 13755.72,
      "end": 13759.72,
      "formatted_start": "03:49:15.720",
      "formatted_end": "03:49:19.720",
      "text": "و بنابراین جدا میشم از دیگرها، تنها میشم از دیگرها"
    },
    {
      "id": 59,
      "start": 13759.72,
      "end": 13765.12,
      "formatted_start": "03:49:19.720",
      "formatted_end": "03:49:25.120",
      "text": "اما تو مطلب دوم، تو مطلب دوم"
    },
    {
      "id": 60,
      "start": 13765.12,
      "end": 13776.82,
      "formatted_start": "03:49:25.120",
      "formatted_end": "03:49:36.820",
      "text": "بدیه کار من اینه که من حریالر نمیتونم از معنویت چشم بپوشم، نمیتونم از شهوانیت چشم بپوشم."
    },
    {
      "id": 61,
      "start": 13778.0,
      "end": 13785.98,
      "formatted_start": "03:49:38.000",
      "formatted_end": "03:49:45.980",
      "text": "درست خیلی سعی میکنم معنوی زندگی کنم، ولی فقط در رفتارم میجونم."
    },
    {
      "id": 62,
      "start": 13785.98,
      "end": 13788.52,
      "formatted_start": "03:49:45.980",
      "formatted_end": "03:49:48.520",
      "text": "در ذهنم اینجوری نیستم"
    },
    {
      "id": 63,
      "start": 13788.52,
      "end": 13790.76,
      "formatted_start": "03:49:48.520",
      "formatted_end": "03:49:50.760",
      "text": "در زمیرم اینجوری نیستم"
    },
    {
      "id": 64,
      "start": 13790.76,
      "end": 13793.44,
      "formatted_start": "03:49:50.760",
      "formatted_end": "03:49:53.440",
      "text": "من در رفتارم من اینکه هر یا در"
    },
    {
      "id": 65,
      "start": 13793.44,
      "end": 13796.2,
      "formatted_start": "03:49:53.440",
      "formatted_end": "03:49:56.200",
      "text": "در رفتارم اینجورم که سر کنم"
    },
    {
      "id": 66,
      "start": 13796.2,
      "end": 13799.64,
      "formatted_start": "03:49:56.200",
      "formatted_end": "03:49:59.640",
      "text": "زندگی اینجور باشه که"
    }
  ],
  "status": "completed"
}