  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10230.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:30.000",
      "text": "همچنان، از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 1,
      "start": 10230.0,
      "end": 10236.0,
      "formatted_start": "02:50:30.000",
      "formatted_end": "02:50:36.000",
      "text": "و یک درس نیست قدیل نیست. از این معلوم درست کنید."
    },
    {
      "id": 2,
      "start": 10236.0,
      "end": 10240.0,
      "formatted_start": "02:50:36.000",
      "formatted_end": "02:50:40.000",
      "text": "حالا دیگه؟ حالا کبارتون چیکار کردید؟"
    },
    {
      "id": 3,
      "start": 10240.0,
      "end": 10246.0,
      "formatted_start": "02:50:40.000",
      "formatted_end": "02:50:46.000",
      "text": "کبارتون از اون محصولی خواستید به بخورت که"
    },
    {
      "id": 4,
      "start": 10246.0,
      "end": 10248.0,
      "formatted_start": "02:50:46.000",
      "formatted_end": "02:50:48.000",
      "text": "از این محصولی همچنان تو کلومینا اون طرف اومدن."
    },
    {
      "id": 5,
      "start": 10248.0,
      "end": 10252.0,
      "formatted_start": "02:50:48.000",
      "formatted_end": "02:50:52.000",
      "text": "از این محصولی درست ما از اونجا ایرانجا تصامیم دیدن"
    },
    {
      "id": 6,
      "start": 10252.0,
      "end": 10256.0,
      "formatted_start": "02:50:52.000",
      "formatted_end": "02:50:56.000",
      "text": "مثل زرایی خالی و اردنهایی باید باشده بود"
    },
    {
      "id": 7,
      "start": 10256.0,
      "end": 10259.0,
      "formatted_start": "02:50:56.000",
      "formatted_end": "02:50:59.000",
      "text": "و برای فارکنگ باید خالی رو بیاره بگیرد."
    },
    {
      "id": 8,
      "start": 10259.0,
      "end": 10265.0,
      "formatted_start": "02:50:59.000",
      "formatted_end": "02:51:05.000",
      "text": "راستن همه دیده منسایه برگیرده با من، با شما بشونه با من، اونها را که انسان هست با من"
    },
    {
      "id": 9,
      "start": 10265.0,
      "end": 10266.0,
      "formatted_start": "02:51:05.000",
      "formatted_end": "02:51:06.000",
      "text": "با من"
    },
    {
      "id": 10,
      "start": 10266.0,
      "end": 10269.0,
      "formatted_start": "02:51:06.000",
      "formatted_end": "02:51:09.000",
      "text": "و بعد راستن رو بیاره داره به دلگرده برگیرده با من"
    },
    {
      "id": 11,
      "start": 10269.0,
      "end": 10273.0,
      "formatted_start": "02:51:09.000",
      "formatted_end": "02:51:13.000",
      "text": "یک برای اینکه همه اصلاسیان همون دوره از درده دردیده برده"
    },
    {
      "id": 12,
      "start": 10273.0,
      "end": 10277.0,
      "formatted_start": "02:51:13.000",
      "formatted_end": "02:51:17.000",
      "text": "و از اینکه همون درده چیزی بره، سخت میشه"
    },
    {
      "id": 13,
      "start": 10277.0,
      "end": 10279.0,
      "formatted_start": "02:51:17.000",
      "formatted_end": "02:51:19.000",
      "text": "و میاد برده کشه به درست کنش"
    },
    {
      "id": 14,
      "start": 10279.0,
      "end": 10283.0,
      "formatted_start": "02:51:19.000",
      "formatted_end": "02:51:23.000",
      "text": "دیگه برده سو سیوند کچه، سر کچه، سر کچه"
    },
    {
      "id": 15,
      "start": 10283.0,
      "end": 10313.0,
      "formatted_start": "02:51:23.000",
      "formatted_end": "02:51:53.000",
      "text": "او چرا بقیه نمیدونید بقیه نمیدونید بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بی"
    },
    {
      "id": 16,
      "start": 10313.0,
      "end": 10316.0,
      "formatted_start": "02:51:53.000",
      "formatted_end": "02:51:56.000",
      "text": "از هنگی بهترنشون ترسیه هاشون نیست"
    },
    {
      "id": 17,
      "start": 10316.0,
      "end": 10319.0,
      "formatted_start": "02:51:56.000",
      "formatted_end": "02:51:59.000",
      "text": "سوال جواب کردن اگه اینجا با اولیوزه"
    },
    {
      "id": 18,
      "start": 10319.0,
      "end": 10321.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:01.000",
      "text": "چون گاز نیمیره هسته"
    },
    {
      "id": 19,
      "start": 10321.0,
      "end": 10325.0,
      "formatted_start": "02:52:01.000",
      "formatted_end": "02:52:05.000",
      "text": "خراف به شما بده آتش بوده چی بشه"
    },
    {
      "id": 20,
      "start": 10325.0,
      "end": 10355.0,
      "formatted_start": "02:52:05.000",
      "formatted_end": "02:52:35.000",
      "text": "اینکه این پیشنه دیست، این کار را بازید که این زیر یک حدودی ندارد و از اینکه این پیشنه در حدودی ندارد، این کار را بازید که این پیشنه در حدودی ندارد و از این کار را بازید که این پیشنه در حدودی ندارد و از این کار را بازید که این پیشنه در حدودی ندارد و از این کار را بازید که این پیشنه در حدودی ندارد و از این کار را بازید که این پیشنه در حدودی ندار"
    },
    {
      "id": 21,
      "start": 10355.0,
      "end": 10359.0,
      "formatted_start": "02:52:35.000",
      "formatted_end": "02:52:39.000",
      "text": "ساله ندارم بیرون دارم و یک دیگه بکیجه را راحت می دادم"
    },
    {
      "id": 22,
      "start": 10359.0,
      "end": 10363.0,
      "formatted_start": "02:52:39.000",
      "formatted_end": "02:52:43.000",
      "text": "من اینجا می گفتیم چه دیگه خوریده از دیگه یکی نداشت"
    },
    {
      "id": 23,
      "start": 10363.0,
      "end": 10367.0,
      "formatted_start": "02:52:43.000",
      "formatted_end": "02:52:47.000",
      "text": "من دارم خود را دردید"
    },
    {
      "id": 24,
      "start": 10367.0,
      "end": 10369.0,
      "formatted_start": "02:52:47.000",
      "formatted_end": "02:52:49.000",
      "text": "درست شد خودش"
    },
    {
      "id": 25,
      "start": 10369.0,
      "end": 10373.0,
      "formatted_start": "02:52:49.000",
      "formatted_end": "02:52:53.000",
      "text": "شما با اومده یا من توی یافتید یا بیشترن ندارم"
    },
    {
      "id": 26,
      "start": 10373.0,
      "end": 10377.0,
      "formatted_start": "02:52:53.000",
      "formatted_end": "02:52:57.000",
      "text": "به درست کنم باید بیشترن درست کنم"
    },
    {
      "id": 27,
      "start": 10385.0,
      "end": 10415.0,
      "formatted_start": "02:53:05.000",
      "formatted_end": "02:53:35.000",
      "text": "مرخصت از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا"
    },
    {
      "id": 28,
      "start": 10415.0,
      "end": 10445.0,
      "formatted_start": "02:53:35.000",
      "formatted_end": "02:54:05.000",
      "text": "این برادر هم برادر ۸۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰"
    },
    {
      "id": 29,
      "start": 10445.0,
      "end": 10448.0,
      "formatted_start": "02:54:05.000",
      "formatted_end": "02:54:08.000",
      "text": "اینجا با برام شاورزی رو یه لاتشنام کنه"
    },
    {
      "id": 30,
      "start": 10448.0,
      "end": 10451.0,
      "formatted_start": "02:54:08.000",
      "formatted_end": "02:54:11.000",
      "text": "مثلا بیشتر و تنها درست کنه"
    },
    {
      "id": 31,
      "start": 10460.0,
      "end": 10463.0,
      "formatted_start": "02:54:20.000",
      "formatted_end": "02:54:23.000",
      "text": "حالا یه برده شده یه هست که کنارم و"
    },
    {
      "id": 32,
      "start": 10463.0,
      "end": 10467.0,
      "formatted_start": "02:54:23.000",
      "formatted_end": "02:54:27.000",
      "text": "میگه که من رسیم دارم، رسیم دارم، رسیم نداریم"
    },
    {
      "id": 33,
      "start": 10467.0,
      "end": 10471.0,
      "formatted_start": "02:54:27.000",
      "formatted_end": "02:54:31.000",
      "text": "و میگه کار اینکی ها در برنامه دارم که کنم"
    },
    {
      "id": 34,
      "start": 10471.0,
      "end": 10500.0,
      "formatted_start": "02:54:31.000",
      "formatted_end": "02:55:00.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینج"
    }
