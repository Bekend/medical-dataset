  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11130.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:30.000",
      "text": "از این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موضوع، با این موض"
    },
    {
      "id": 1,
      "start": 11130.0,
      "end": 11152.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:52.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 11152.0,
      "end": 11181.0,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:06:21.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 11182.0,
      "end": 11188.0,
      "formatted_start": "03:06:22.000",
      "formatted_end": "03:06:28.000",
      "text": "موزه مختزنی جدید با هم ببینیم آموزش کامل"
    },
    {
      "id": 4,
      "start": 11188.0,
      "end": 11194.0,
      "formatted_start": "03:06:28.000",
      "formatted_end": "03:06:34.000",
      "text": "این نوشته که استان چطوری میتونم توی یک نگاه مخ بزنم"
    },
    {
      "id": 5,
      "start": 11194.0,
      "end": 11197.0,
      "formatted_start": "03:06:34.000",
      "formatted_end": "03:06:37.000",
      "text": "خب عزیزان شاید مشکل خیلی در اون باشه"
    },
    {
      "id": 6,
      "start": 11197.0,
      "end": 11202.0,
      "formatted_start": "03:06:37.000",
      "formatted_end": "03:06:42.000",
      "text": "البت کنید تا این آموزش رو بهتون بدن باشید"
    },
    {
      "id": 7,
      "start": 11202.0,
      "end": 11204.0,
      "formatted_start": "03:06:42.000",
      "formatted_end": "03:06:44.000",
      "text": "البت کنید یک بار دیگر ببینید"
    },
    {
      "id": 8,
      "start": 11204.0,
      "end": 11209.0,
      "formatted_start": "03:06:44.000",
      "formatted_end": "03:06:49.000",
      "text": "تو جفتتو که میبینید به محضه که جفتتو میبینید فرامو کنید دختری بسر"
    },
    {
      "id": 9,
      "start": 11209.0,
      "end": 11239.0,
      "formatted_start": "03:06:49.000",
      "formatted_end": "03:07:19.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 10,
      "start": 11239.0,
      "end": 11241.0,
      "formatted_start": "03:07:19.000",
      "formatted_end": "03:07:21.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 11269.0,
      "end": 11274.06,
      "formatted_start": "03:07:49.000",
      "formatted_end": "03:07:54.060",
      "text": "با آقایی بکنن و بپردیدن یا مشکلات قرار نیستی چون خرشید"
    },
    {
      "id": 12,
      "start": 11274.06,
      "end": 11275.96,
      "formatted_start": "03:07:54.060",
      "formatted_end": "03:07:55.960",
      "text": "ایچ وقت نمیشه مشکلاتتون با همسر"
    },
    {
      "id": 13,
      "start": 11275.96,
      "end": 11280.06,
      "formatted_start": "03:07:55.960",
      "formatted_end": "03:08:00.060",
      "text": "آدم خودشیفته رو توی این کارتوهجه با این شما بشنست"
    },
    {
      "id": 14,
      "start": 11280.06,
      "end": 11283.86,
      "formatted_start": "03:08:00.060",
      "formatted_end": "03:08:03.860",
      "text": "اگه نشنستی شما با شما رابطه بشید فقط از آب بکشید"
    },
    {
      "id": 15,
      "start": 11283.86,
      "end": 11285.82,
      "formatted_start": "03:08:03.860",
      "formatted_end": "03:08:05.820",
      "text": "خودشیفته هایی که در حیوه ازمه"
    },
    {
      "id": 16,
      "start": 11285.82,
      "end": 11287.7,
      "formatted_start": "03:08:05.820",
      "formatted_end": "03:08:07.700",
      "text": "ببخشید که در رقاتشون اون نیست"
    },
    {
      "id": 17,
      "start": 11287.7,
      "end": 11288.74,
      "formatted_start": "03:08:07.700",
      "formatted_end": "03:08:08.740",
      "text": "مهمیست از این چی شده"
    },
    {
      "id": 18,
      "start": 11288.74,
      "end": 11290.28,
      "formatted_start": "03:08:08.740",
      "formatted_end": "03:08:10.280",
      "text": "در هر صورت همه بسته"
    },
    {
      "id": 19,
      "start": 11290.28,
      "end": 11295.74,
      "formatted_start": "03:08:10.280",
      "formatted_end": "03:08:15.740",
      "text": "برعکس، توی مشکلاتی که با هر کسی دارن، خودشون رو قربانی و بیتفسیر میشوندن."
    },
    {
      "id": 20,
      "start": 11295.74,
      "end": 11301.22,
      "formatted_start": "03:08:15.740",
      "formatted_end": "03:08:21.220",
      "text": "عاشق اینن که یکی ازشون تعریف کنه، این طریقه که زرد به تعریف و ترجیلشون سراختند."
    },
    {
      "id": 21,
      "start": 11301.22,
      "end": 11304.58,
      "formatted_start": "03:08:21.220",
      "formatted_end": "03:08:24.580",
      "text": "و هر روز باید ازشون تعریف های نهیمتر خالی نشهد."
    },
    {
      "id": 22,
      "start": 11304.58,
      "end": 11312.04,
      "formatted_start": "03:08:24.580",
      "formatted_end": "03:08:32.040",
      "text": "نمیتونن احساس و دردشون رو دردی کنند، مگر در یک صورت، اون درد و مشهر یه طورهایی خودشون مرد میشه."
    },
    {
      "id": 23,
      "start": 11312.04,
      "end": 11318.84,
      "formatted_start": "03:08:32.040",
      "formatted_end": "03:08:38.840",
      "text": "بود بازی رو افراد کنن، یه طوری بابریت و تعریف و تحریف می کنن که تو به حافظه خودتن شکر کن."
    },
    {
      "id": 24,
      "start": 11318.84,
      "end": 11323.24,
      "formatted_start": "03:08:38.840",
      "formatted_end": "03:08:43.240",
      "text": "خودشیفته ها اگه ناراحت بشن، یه کارای عجیب غریب اینجا می دن."
    },
    {
      "id": 25,
      "start": 11323.24,
      "end": 11325.88,
      "formatted_start": "03:08:43.240",
      "formatted_end": "03:08:45.880",
      "text": "رابطه داشتن با این آدم ها یه اواقبی داره."
    },
    {
      "id": 26,
      "start": 11325.88,
      "end": 11329.84,
      "formatted_start": "03:08:45.880",
      "formatted_end": "03:08:49.840",
      "text": "تو رابطه مدام سرس داری و حس تخفیقی رو حدست می ده."
    },
    {
      "id": 27,
      "start": 11329.84,
      "end": 11334.12,
      "formatted_start": "03:08:49.840",
      "formatted_end": "03:08:54.120",
      "text": "هر چه قدم که بهش عشق و محبت بدی، بازم یه طورای بهت شک دارم."
    },
    {
      "id": 28,
      "start": 11334.12,
      "end": 11338.02,
      "formatted_start": "03:08:54.120",
      "formatted_end": "03:08:58.020",
      "text": "با کوچکترین سردی و بیترجوهی هم به هم گریزه و غصه بیرون شد"
    },
    {
      "id": 29,
      "start": 11338.02,
      "end": 11339.82,
      "formatted_start": "03:08:58.020",
      "formatted_end": "03:08:59.820",
      "text": "خب میتونیم رو تعمال کنیم؟"
    },
    {
      "id": 30,
      "start": 11339.82,
      "end": 11341.88,
      "formatted_start": "03:08:59.820",
      "formatted_end": "03:09:01.880",
      "text": "مدام حسن بدهکاری داریم بهش"
    },
    {
      "id": 31,
      "start": 11341.88,
      "end": 11343.52,
      "formatted_start": "03:09:01.880",
      "formatted_end": "03:09:03.520",
      "text": "من یه طول با ترکترم"
    },
    {
      "id": 32,
      "start": 11343.52,
      "end": 11346.18,
      "formatted_start": "03:09:03.520",
      "formatted_end": "03:09:06.180",
      "text": "من اینگار از همه چیزش به خاطر تو بزشتیم"
    },
    {
      "id": 33,
      "start": 11346.18,
      "end": 11347.86,
      "formatted_start": "03:09:06.180",
      "formatted_end": "03:09:07.860",
      "text": "در صورتی که اصلا اطول نیست"
    },
    {
      "id": 34,
      "start": 11347.86,
      "end": 11349.76,
      "formatted_start": "03:09:07.860",
      "formatted_end": "03:09:09.760",
      "text": "من به همه مراجعینم رو بگم"
    },
    {
      "id": 35,
      "start": 11349.76,
      "end": 11351.6,
      "formatted_start": "03:09:09.760",
      "formatted_end": "03:09:11.600",
      "text": "اول نشونه ها رو بشناسید"
    },
    {
      "id": 36,
      "start": 11351.6,
      "end": 11353.48,
      "formatted_start": "03:09:11.600",
      "formatted_end": "03:09:13.480",
      "text": "بدونید دلیل حال بدتنشیه"
    },
    {
      "id": 37,
      "start": 11353.48,
      "end": 11355.28,
      "formatted_start": "03:09:13.480",
      "formatted_end": "03:09:15.280",
      "text": "بعد با هم درستش کنیم"
    },
    {
      "id": 38,
      "start": 11364.12,
      "end": 11392.12,
      "formatted_start": "03:09:24.120",
      "formatted_end": "03:09:52.120",
      "text": "موسیقی"
    },
    {
      "id": 39,
      "start": 11392.12,
      "end": 11400.12,
      "formatted_start": "03:09:52.120",
      "formatted_end": "03:10:00.120",
      "text": "موسیقی"
    }
  ],
