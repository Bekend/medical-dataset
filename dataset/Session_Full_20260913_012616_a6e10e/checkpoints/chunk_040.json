  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12025.22,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:25.220",
      "text": "آب هم از آب کنید. خب اگر اینجور باشه، اون وقت ارزش های اخلاقی، اگر اینها رو به این صورت تلقید کنید، اون وقت در واقع اینکار ارزش ها خودشون کوچند، خودشون صفرند، خودشون هیچند، ما اومدیم به شون رویتیت داریم."
    },
    {
      "id": 1,
      "start": 12025.22,
      "end": 12042.22,
      "formatted_start": "03:20:25.220",
      "formatted_end": "03:20:42.220",
      "text": "ما اومده اینکه قبلی درست کرده ایم برای درست گفتن، ما اومده اینکه خصوصی درست کرده ایم برای راست گفتن و هم اجماع کرده ایم یا قرارداد کرده ایم یا قرارداد پیشتر انجام گرفته رو بهش رضا داده ایم."
    },
    {
      "id": 2,
      "start": 12042.22,
      "end": 12049.22,
      "formatted_start": "03:20:42.220",
      "formatted_end": "03:20:49.220",
      "text": "وگرنه خود درست گفتن مبهی نداره، خود راست گفتن را مصدی نداره."
    },
    {
      "id": 3,
      "start": 12049.22,
      "end": 12063.22,
      "formatted_start": "03:20:49.220",
      "formatted_end": "03:21:03.220",
      "text": "خب اگر اینجور باشه، این یک روایت از بیمعناییز می‌گیرد، که بهش می‌گیم نیلیزم، یک روایت دو هم وجود داره از این بیمعنایی که بهش می‌گیم ابزوردیزم،"
    },
    {
      "id": 4,
      "start": 12063.22,
      "end": 12071.48,
      "formatted_start": "03:21:03.220",
      "formatted_end": "03:21:11.480",
      "text": "خب در حضور دید من باز یک نوع بیمعنایی وجود داره"
    },
    {
      "id": 5,
      "start": 12071.48,
      "end": 12074.36,
      "formatted_start": "03:21:11.480",
      "formatted_end": "03:21:14.360",
      "text": "ولی خب بیمعنایی به اون امقی نیست"
    },
    {
      "id": 6,
      "start": 12074.36,
      "end": 12076.32,
      "formatted_start": "03:21:14.360",
      "formatted_end": "03:21:16.320",
      "text": "که در نیلیز میتونه"
    },
    {
      "id": 7,
      "start": 12076.32,
      "end": 12079.64,
      "formatted_start": "03:21:16.320",
      "formatted_end": "03:21:19.640",
      "text": "در حضور دید میگی کسانی مثل البرکامو"
    },
    {
      "id": 8,
      "start": 12079.64,
      "end": 12082.88,
      "formatted_start": "03:21:19.640",
      "formatted_end": "03:21:22.880",
      "text": "اون دانه اول بودیم قائلش"
    },
    {
      "id": 9,
      "start": 12082.88,
      "end": 12087.28,
      "formatted_start": "03:21:22.880",
      "formatted_end": "03:21:27.280",
      "text": "و کسانی مثل موژین یونسکو و میان فاکر"
    },
    {
      "id": 10,
      "start": 12087.28,
      "end": 12090.56,
      "formatted_start": "03:21:27.280",
      "formatted_end": "03:21:30.560",
      "text": "اینها بهش قائلن"
    },
    {
      "id": 11,
      "start": 12090.56,
      "end": 12097.56,
      "formatted_start": "03:21:30.560",
      "formatted_end": "03:21:37.560",
      "text": "در افزاق دیگر گفته می شود که معقولیتی نداره زندگی این جهان"
    },
    {
      "id": 12,
      "start": 12097.56,
      "end": 12100.56,
      "formatted_start": "03:21:37.560",
      "formatted_end": "03:21:40.560",
      "text": "زندگی انسانی معقول نیست"
    },
    {
      "id": 13,
      "start": 12100.56,
      "end": 12107.56,
      "formatted_start": "03:21:40.560",
      "formatted_end": "03:21:47.560",
      "text": "یعنی قابل محاسبه و اونم محاسبه معتبر نیست"
    },
    {
      "id": 14,
      "start": 12107.56,
      "end": 12110.56,
      "formatted_start": "03:21:47.560",
      "formatted_end": "03:21:50.560",
      "text": "آدم که انتظاراتی داره از هستی"
    },
    {
      "id": 15,
      "start": 12110.56,
      "end": 12114.56,
      "formatted_start": "03:21:50.560",
      "formatted_end": "03:21:54.560",
      "text": "باید ایچ کنید انتظاراتی برای برداشت کنید نیست"
    },
    {
      "id": 16,
      "start": 12114.56,
      "end": 12126.82,
      "formatted_start": "03:21:54.560",
      "formatted_end": "03:22:06.820",
      "text": "مثلا آدم انتظار داره که در جهان اگر معقوم، در جهان اگر کسی سعی کوشش کرد موفق بشه"
    },
    {
      "id": 17,
      "start": 12126.82,
      "end": 12129.32,
      "formatted_start": "03:22:06.820",
      "formatted_end": "03:22:09.320",
      "text": "برای همونش از اینه در بار"
    },
    {
      "id": 18,
      "start": 12129.32,
      "end": 12142.04,
      "formatted_start": "03:22:09.320",
      "formatted_end": "03:22:22.040",
      "text": "انتظار بودن که اگر کسی خادم بشه، اهل خدمت بشه، مورد ارزش و اعتبار قائد بشه"
    },
    {
      "id": 19,
      "start": 12142.04,
      "end": 12147.68,
      "formatted_start": "03:22:22.040",
      "formatted_end": "03:22:27.680",
      "text": "و برای خائلان ارزو کنم اعتبار و عرضش خائل نباشید"
    },
    {
      "id": 20,
      "start": 12147.68,
      "end": 12149.16,
      "formatted_start": "03:22:27.680",
      "formatted_end": "03:22:29.160",
      "text": "اما همه چیزی هم نیست"
    },
    {
      "id": 21,
      "start": 12149.16,
      "end": 12153.4,
      "formatted_start": "03:22:29.160",
      "formatted_end": "03:22:33.400",
      "text": "چقدر خادمانی به بشریت آمدند و رفتند"
    },
    {
      "id": 22,
      "start": 12153.4,
      "end": 12157.16,
      "formatted_start": "03:22:33.400",
      "formatted_end": "03:22:37.160",
      "text": "و کسی سر سوزنی براشون وقتی خائل نبود"
    },
    {
      "id": 23,
      "start": 12157.16,
      "end": 12159.5,
      "formatted_start": "03:22:37.160",
      "formatted_end": "03:22:39.500",
      "text": "و چقدر خائلانی براشون وقتی خواهدند و رفتند"
    },
    {
      "id": 24,
      "start": 12159.5,
      "end": 12162.66,
      "formatted_start": "03:22:39.500",
      "formatted_end": "03:22:42.660",
      "text": "و چرا همه ما براشون احترام قائل بودیم"
    },
    {
      "id": 25,
      "start": 12162.66,
      "end": 12164.32,
      "formatted_start": "03:22:42.660",
      "formatted_end": "03:22:44.320",
      "text": "و پیش ما آبرومندونند"
    },
    {
      "id": 26,
      "start": 12164.32,
      "end": 12166.02,
      "formatted_start": "03:22:44.320",
      "formatted_end": "03:22:46.020",
      "text": "اعتباری نیست"
    },
    {
      "id": 27,
      "start": 12166.02,
      "end": 12169.72,
      "formatted_start": "03:22:46.020",
      "formatted_end": "03:22:49.720",
      "text": "آدم انتظار داره که اگر پدر و مادر"
    },
    {
      "id": 28,
      "start": 12169.72,
      "end": 12173.72,
      "formatted_start": "03:22:49.720",
      "formatted_end": "03:22:53.720",
      "text": "از اینکه از اینکه تمام جد و جهدشون رو برای تربیت فرزندشون کردن"
    },
    {
      "id": 29,
      "start": 12173.72,
      "end": 12177.72,
      "formatted_start": "03:22:53.720",
      "formatted_end": "03:22:57.720",
      "text": "فرزندشون انسان سالمی بار بیاد"
    },
    {
      "id": 30,
      "start": 12177.72,
      "end": 12179.72,
      "formatted_start": "03:22:57.720",
      "formatted_end": "03:22:59.720",
      "text": "ولی نه، اینجورم نیست نظر من"
    },
    {
      "id": 31,
      "start": 12179.72,
      "end": 12185.72,
      "formatted_start": "03:22:59.720",
      "formatted_end": "03:23:05.720",
      "text": "و از اون طرف میگیم اگر پدر و مادر کاملا سهلنگار بودند"
    },
    {
      "id": 32,
      "start": 12185.72,
      "end": 12190.72,
      "formatted_start": "03:23:05.720",
      "formatted_end": "03:23:10.720",
      "text": "نرسید و هیچ اقتناعی به تربیت بچه هاشون نداشتند"
    },
    {
      "id": 33,
      "start": 12190.72,
      "end": 12193.72,
      "formatted_start": "03:23:10.720",
      "formatted_end": "03:23:13.720",
      "text": "بچه هاشون یه بچه های ناسالمی هستند"
    },
    {
      "id": 34,
      "start": 12193.72,
      "end": 12197.72,
      "formatted_start": "03:23:13.720",
      "formatted_end": "03:23:17.720",
      "text": "آب در بیان ولی افتباه عکسشون رو میبینید"
    },
    {
      "id": 35,
      "start": 12197.72,
      "end": 12200.72,
      "formatted_start": "03:23:17.720",
      "formatted_end": "03:23:20.720",
      "text": "نمیتونیم چونکه بگذاریم"
    },
    {
      "id": 36,
      "start": 12200.72,
      "end": 12205.72,
      "formatted_start": "03:23:20.720",
      "formatted_end": "03:23:25.720",
      "text": "نداریم جهان انسانی جهان معقولی نیست برخلاف جهان فیزیک"
    },
    {
      "id": 37,
      "start": 12205.72,
      "end": 12209.72,
      "formatted_start": "03:23:25.720",
      "formatted_end": "03:23:29.720",
      "text": "برخلاف جهان شیمی برخلاف جهان زیستجناسی"
    },
    {
      "id": 38,
      "start": 12209.72,
      "end": 12215.72,
      "formatted_start": "03:23:29.720",
      "formatted_end": "03:23:35.720",
      "text": "جهان روای شناسی و جامعه شناسی این دو جهان که جهان انسانی هست"
    },
    {
      "id": 39,
      "start": 12215.72,
      "end": 12219.72,
      "formatted_start": "03:23:35.720",
      "formatted_end": "03:23:39.720",
      "text": "این ها معقولیتشون براشون حاکم نیست"
    },
    {
      "id": 40,
      "start": 12219.72,
      "end": 12221.72,
      "formatted_start": "03:23:39.720",
      "formatted_end": "03:23:41.720",
      "text": "نداریم کنیم"
    },
    {
      "id": 41,
      "start": 12221.72,
      "end": 12225.72,
      "formatted_start": "03:23:41.720",
      "formatted_end": "03:23:45.720",
      "text": "خب این همکر باشی با ضدیم شد بیمعنا"
    },
    {
      "id": 42,
      "start": 12225.72,
      "end": 12232.78,
      "formatted_start": "03:23:45.720",
      "formatted_end": "03:23:52.780",
      "text": "چون میبینید این آدم چی اگر بکنه حتما به نتیجه میرسه"
    },
    {
      "id": 43,
      "start": 12232.78,
      "end": 12236.7,
      "formatted_start": "03:23:52.780",
      "formatted_end": "03:23:56.700",
      "text": "و اگر چه کار رو نکرد حتما به نتیجه نمیرسه"
    },
    {
      "id": 44,
      "start": 12236.7,
      "end": 12239.48,
      "formatted_start": "03:23:56.700",
      "formatted_end": "03:23:59.480",
      "text": "همه چی تابع چی خواهد بود"
    },
    {
      "id": 45,
      "start": 12239.48,
      "end": 12243.9,
      "formatted_start": "03:23:59.480",
      "formatted_end": "03:24:03.900",
      "text": "خانم نمیخواد تابع استفاده کنم که تابع فلسفی دقیقی نیست"
    },
    {
      "id": 46,
      "start": 12243.9,
      "end": 12245.86,
      "formatted_start": "03:24:03.900",
      "formatted_end": "03:24:05.860",
      "text": "ولی اگر همه چیز تابع شانسه"
    },
    {
      "id": 47,
      "start": 12245.86,
      "end": 12248.54,
      "formatted_start": "03:24:05.860",
      "formatted_end": "03:24:08.540",
      "text": "همه چیز تابع تصادفه"
    },
    {
      "id": 48,
      "start": 12248.54,
      "end": 12250.22,
      "formatted_start": "03:24:08.540",
      "formatted_end": "03:24:10.220",
      "text": "معناهی برگهانه"
    },
    {
      "id": 49,
      "start": 12250.22,
      "end": 12251.98,
      "formatted_start": "03:24:10.220",
      "formatted_end": "03:24:11.980",
      "text": "انسانی حاکم نیست"
    },
    {
      "id": 50,
      "start": 12251.98,
      "end": 12252.96,
      "formatted_start": "03:24:11.980",
      "formatted_end": "03:24:12.960",
      "text": "شانسی"
    },
    {
      "id": 51,
      "start": 12252.96,
      "end": 12257.26,
      "formatted_start": "03:24:12.960",
      "formatted_end": "03:24:17.260",
      "text": "یه وقت تو اهمالکاری ولی بچه بسیار خوبی بود"
    },
    {
      "id": 52,
      "start": 12257.26,
      "end": 12258.7,
      "formatted_start": "03:24:17.260",
      "formatted_end": "03:24:18.700",
      "text": "بار میاد از تو"
    },
    {
      "id": 53,
      "start": 12258.7,
      "end": 12261.72,
      "formatted_start": "03:24:18.700",
      "formatted_end": "03:24:21.720",
      "text": "یه وقت هم تو بسیار جدی و سایی"
    },
    {
      "id": 54,
      "start": 12261.72,
      "end": 12265.04,
      "formatted_start": "03:24:21.720",
      "formatted_end": "03:24:25.040",
      "text": "و سرسنزنی که کهورت و کاهلی نداری"
    },
    {
      "id": 55,
      "start": 12265.04,
      "end": 12266.5,
      "formatted_start": "03:24:25.040",
      "formatted_end": "03:24:26.500",
      "text": "ولی با این همه چرا"
    },
    {
      "id": 56,
      "start": 12282.96,
      "end": 12286.96,
      "formatted_start": "03:24:42.960",
      "formatted_end": "03:24:46.960",
      "text": "موسیقی"
    },
    {
      "id": 57,
      "start": 12286.96,
      "end": 12288.96,
      "formatted_start": "03:24:46.960",
      "formatted_end": "03:24:48.960",
      "text": "موسیقی"
    },
    {
