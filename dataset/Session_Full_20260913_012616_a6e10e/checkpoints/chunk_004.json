    },
    {
      "id": 3,
      "start": 1290.0,
      "end": 1318.0,
      "formatted_start": "00:21:30.000",
      "formatted_end": "00:21:58.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 1320.0,
      "end": 1323.0,
      "formatted_start": "00:22:00.000",
      "formatted_end": "00:22:03.000",
      "text": "اینجا با چند پرده گره روی"
    },
    {
      "id": 5,
      "start": 1323.0,
      "end": 1327.0,
      "formatted_start": "00:22:03.000",
      "formatted_end": "00:22:07.000",
      "text": "ترکت کنید، برای اون باید باید بگیرده شده"
    },
    {
      "id": 6,
      "start": 1327.0,
      "end": 1329.0,
      "formatted_start": "00:22:07.000",
      "formatted_end": "00:22:09.000",
      "text": "خود رو بگیرد"
    },
    {
      "id": 7,
      "start": 1329.0,
      "end": 1330.0,
      "formatted_start": "00:22:09.000",
      "formatted_end": "00:22:10.000",
      "text": "و..."
    },
    {
      "id": 8,
      "start": 1330.0,
      "end": 1332.0,
      "formatted_start": "00:22:10.000",
      "formatted_end": "00:22:12.000",
      "text": "که یه تشکیل"
    },
    {
      "id": 9,
      "start": 1332.0,
      "end": 1334.0,
      "formatted_start": "00:22:12.000",
      "formatted_end": "00:22:14.000",
      "text": "اینجا بیار"
    },
    {
      "id": 10,
      "start": 1334.0,
      "end": 1337.0,
      "formatted_start": "00:22:14.000",
      "formatted_end": "00:22:17.000",
      "text": "همین که میاد که جا برده بود که برای این همون"
    },
    {
      "id": 11,
      "start": 1337.0,
      "end": 1340.0,
      "formatted_start": "00:22:17.000",
      "formatted_end": "00:22:20.000",
      "text": "خود رو بگیرد"
    },
    {
      "id": 12,
      "start": 1340.0,
      "end": 1341.0,
      "formatted_start": "00:22:20.000",
      "formatted_end": "00:22:21.000",
      "text": "و..."
    },
    {
      "id": 13,
      "start": 1341.0,
      "end": 1345.0,
      "formatted_start": "00:22:21.000",
      "formatted_end": "00:22:25.000",
      "text": "اینجا با سه شوارت که یک ترکت نداشت"
    },
    {
