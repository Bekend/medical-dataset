  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7228.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:28.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 7230.0,
      "end": 7244.0,
      "formatted_start": "02:00:30.000",
      "formatted_end": "02:00:44.000",
      "text": "ایمان با خدایی دیدن، تنها ایمانیت رو رفتن، با خدا زندگی کردن، با خدا نفذ گشتن، با خدا ارگاه به خود دارستن"
    },
    {
      "id": 2,
      "start": 7244.0,
      "end": 7255.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:55.000",
      "text": "رب، کیده اصلی مسئله توحید خدا شناسیه، تنها اعتقادی که یه خدایی هست، بسیار اعتقادی بود"
    },
    {
      "id": 3,
      "start": 7255.0,
      "end": 7275.0,
      "formatted_start": "02:00:55.000",
      "formatted_end": "02:01:15.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 7285.0,
      "end": 7307.0,
      "formatted_start": "02:01:25.000",
      "formatted_end": "02:01:47.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 7315.0,
      "end": 7330.0,
      "formatted_start": "02:01:55.000",
      "formatted_end": "02:02:10.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 7345.0,
      "end": 7373.0,
      "formatted_start": "02:02:25.000",
      "formatted_end": "02:02:53.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 7375.0,
      "end": 7393.0,
      "formatted_start": "02:02:55.000",
      "formatted_end": "02:03:13.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 7405.0,
      "end": 7432.0,
      "formatted_start": "02:03:25.000",
      "formatted_end": "02:03:52.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 7435.0,
      "end": 7437.0,
      "formatted_start": "02:03:55.000",
      "formatted_end": "02:03:57.000",
      "text": "مجید، موقعیت پادشاه عربستان رو آماده کن"
    },
    {
      "id": 10,
      "start": 7437.0,
      "end": 7439.0,
      "formatted_start": "02:03:57.000",
      "formatted_end": "02:03:59.000",
      "text": "و منتظر دستور شلیک باش"
    },
    {
      "id": 11,
      "start": 7439.0,
      "end": 7440.0,
      "formatted_start": "02:03:59.000",
      "formatted_end": "02:04:00.000",
      "text": "لطال"
    },
    {
      "id": 12,
      "start": 7440.0,
      "end": 7441.0,
      "formatted_start": "02:04:00.000",
      "formatted_end": "02:04:01.000",
      "text": "نوشک رو آماده کن"
    },
    {
      "id": 13,
      "start": 7441.0,
      "end": 7442.0,
      "formatted_start": "02:04:01.000",
      "formatted_end": "02:04:02.000",
      "text": "لطال"
    },
    {
      "id": 14,
      "start": 7450.0,
      "end": 7452.0,
      "formatted_start": "02:04:10.000",
      "formatted_end": "02:04:12.000",
      "text": "مجید، شلیک کن"
    },
    {
      "id": 15,
      "start": 7452.0,
      "end": 7480.0,
      "formatted_start": "02:04:12.000",
      "formatted_end": "02:04:40.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 7482.0,
      "end": 7484.0,
      "formatted_start": "02:04:42.000",
      "formatted_end": "02:04:44.000",
      "text": "برام غذای باجد می بانم"
    },
    {
      "id": 17,
      "start": 7486.0,
      "end": 7488.0,
      "formatted_start": "02:04:46.000",
      "formatted_end": "02:04:48.000",
      "text": "محصر خیلی که ای کامش مارسته اینجا باشید"
    },
    {
      "id": 18,
      "start": 7488.0,
      "end": 7490.0,
      "formatted_start": "02:04:48.000",
      "formatted_end": "02:04:50.000",
      "text": "اگر نه اضافه بیدارم برام"
    }
  ],
  "status": "completed"
}