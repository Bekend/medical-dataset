  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11729.98,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:29.980",
      "text": "بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 11730.0,
      "end": 11733.0,
      "formatted_start": "03:15:30.000",
      "formatted_end": "03:15:33.000",
      "text": "چی شده خانم گرگی؟"
    },
    {
      "id": 2,
      "start": 11733.0,
      "end": 11738.0,
      "formatted_start": "03:15:33.000",
      "formatted_end": "03:15:38.000",
      "text": "سرما خورد و بس شبا خیلی دلگوچه داره"
    },
    {
      "id": 3,
      "start": 11738.0,
      "end": 11740.0,
      "formatted_start": "03:15:38.000",
      "formatted_end": "03:15:40.000",
      "text": "بیقراری شبا نداره"
    },
    {
      "id": 4,
      "start": 11740.0,
      "end": 11742.0,
      "formatted_start": "03:15:40.000",
      "formatted_end": "03:15:42.000",
      "text": "الان صرفه نامیزنه؟"
    },
    {
      "id": 5,
      "start": 11742.0,
      "end": 11743.0,
      "formatted_start": "03:15:42.000",
      "formatted_end": "03:15:43.000",
      "text": "آره"
    },
    {
      "id": 6,
      "start": 11743.0,
      "end": 11745.0,
      "formatted_start": "03:15:43.000",
      "formatted_end": "03:15:45.000",
      "text": "آبریزه شدسه؟"
    },
    {
      "id": 7,
      "start": 11745.0,
      "end": 11747.0,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:47.000",
      "text": "شدسه نمیزنه، آبریزه نمیزنه"
    },
    {
      "id": 8,
      "start": 11747.0,
      "end": 11748.0,
      "formatted_start": "03:15:47.000",
      "formatted_end": "03:15:48.000",
      "text": "خسخس سینه؟"
    },
    {
      "id": 9,
      "start": 11748.0,
      "end": 11749.0,
      "formatted_start": "03:15:48.000",
      "formatted_end": "03:15:49.000",
      "text": "یکی"
    },
    {
      "id": 10,
      "start": 11749.0,
      "end": 11752.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:52.000",
      "text": "و بیقراریش طرف عروب و شب پیشتر نیست؟"
    },
    {
      "id": 11,
      "start": 11752.0,
      "end": 11754.0,
      "formatted_start": "03:15:52.000",
      "formatted_end": "03:15:54.000",
      "text": "خیلی نیست، ازا شبا نمیخواه بره"
    },
    {
      "id": 12,
      "start": 11754.0,
      "end": 11756.0,
      "formatted_start": "03:15:54.000",
      "formatted_end": "03:15:56.000",
      "text": "شبا نمیخواه بره، رو هم داشته؟"
    },
    {
      "id": 13,
      "start": 11756.0,
      "end": 11758.0,
      "formatted_start": "03:15:56.000",
      "formatted_end": "03:15:58.000",
      "text": "نه، الان تب داره"
    },
    {
      "id": 14,
      "start": 11758.0,
      "end": 11764.0,
      "formatted_start": "03:15:58.000",
      "formatted_end": "03:16:04.000",
      "text": "اطلاعات درست بیدید که هر کلمه اشتباه یک راه اشتباه بودید"
    },
    {
      "id": 15,
      "start": 11764.0,
      "end": 11769.0,
      "formatted_start": "03:16:04.000",
      "formatted_end": "03:16:09.000",
      "text": "اگر دیگه این طب داره ما میریم توی راه شدید اوفنده"
    },
    {
      "id": 16,
      "start": 11769.0,
      "end": 11774.0,
      "formatted_start": "03:16:09.000",
      "formatted_end": "03:16:14.000",
      "text": "مثلا اگر واقعا این سوست مرد میریم هر درم طب نداریم، گرمای محیطه"
    },
    {
      "id": 17,
      "start": 11774.0,
      "end": 11776.0,
      "formatted_start": "03:16:14.000",
      "formatted_end": "03:16:16.000",
      "text": "خوب"
    },
    {
      "id": 18,
      "start": 11781.0,
      "end": 11782.0,
      "formatted_start": "03:16:21.000",
      "formatted_end": "03:16:22.000",
      "text": "چند روزشه؟"
    },
    {
      "id": 19,
      "start": 11782.0,
      "end": 11783.0,
      "formatted_start": "03:16:22.000",
      "formatted_end": "03:16:23.000",
      "text": "۲۷"
    },
    {
      "id": 20,
      "start": 11783.0,
      "end": 11785.0,
      "formatted_start": "03:16:23.000",
      "formatted_end": "03:16:25.000",
      "text": "دردی داشته بود؟"
    },
    {
      "id": 21,
      "start": 11785.0,
      "end": 11786.0,
      "formatted_start": "03:16:25.000",
      "formatted_end": "03:16:26.000",
      "text": "آره"
    },
    {
      "id": 22,
      "start": 11786.0,
      "end": 11788.82,
      "formatted_start": "03:16:26.000",
      "formatted_end": "03:16:28.820",
      "text": "چکمش خیلی نفت داره، باز داره"
    },
    {
      "id": 23,
      "start": 11788.82,
      "end": 11792.58,
      "formatted_start": "03:16:28.820",
      "formatted_end": "03:16:32.580",
      "text": "این پیچش میده، زور میزنه خودشو، کش میده"
    },
    {
      "id": 24,
      "start": 11792.58,
      "end": 11794.58,
      "formatted_start": "03:16:32.580",
      "formatted_end": "03:16:34.580",
      "text": "باید"
    },
    {
      "id": 25,
      "start": 11801.72,
      "end": 11804.42,
      "formatted_start": "03:16:41.720",
      "formatted_end": "03:16:44.420",
      "text": "بچه ها که از سرما خورده هم هستن ببینه؟"
    },
    {
      "id": 26,
      "start": 11804.42,
      "end": 11806.42,
      "formatted_start": "03:16:44.420",
      "formatted_end": "03:16:46.420",
      "text": "آره بچه ها میبینه"
    },
    {
      "id": 27,
      "start": 11806.42,
      "end": 11808.42,
      "formatted_start": "03:16:46.420",
      "formatted_end": "03:16:48.420",
      "text": "بله بچه ها میبینه"
    },
    {
      "id": 28,
      "start": 11808.42,
      "end": 11812.48,
      "formatted_start": "03:16:48.420",
      "formatted_end": "03:16:52.480",
      "text": "این بزرگ سرما خورده باید گولنج بهش دست میده"
    },
    {
      "id": 29,
      "start": 11812.48,
      "end": 11817.48,
      "formatted_start": "03:16:52.480",
      "formatted_end": "03:16:57.480",
      "text": "مادر شما این حبوبات و لبنیات گاوی نخواهید"
    },
    {
      "id": 30,
      "start": 11817.48,
      "end": 11819.48,
      "formatted_start": "03:16:57.480",
      "formatted_end": "03:16:59.480",
      "text": "حبوبات نخواهید اصلا"
    },
    {
      "id": 31,
      "start": 11819.48,
      "end": 11821.48,
      "formatted_start": "03:16:59.480",
      "formatted_end": "03:17:01.480",
      "text": "اصلا نخواهید آبش هم نخواهید"
    },
    {
      "id": 32,
      "start": 11821.48,
      "end": 11823.48,
      "formatted_start": "03:17:01.480",
      "formatted_end": "03:17:03.480",
      "text": "به خوری بچه درکی چه میده"
    },
    {
      "id": 33,
      "start": 11823.48,
      "end": 11825.48,
      "formatted_start": "03:17:03.480",
      "formatted_end": "03:17:05.480",
      "text": "یکم لبنیات گاوی"
    },
    {
      "id": 34,
      "start": 11825.48,
      "end": 11827.48,
      "formatted_start": "03:17:05.480",
      "formatted_end": "03:17:07.480",
      "text": "بادر جون خیال هم نخواهید"
    },
    {
      "id": 35,
      "start": 11827.48,
      "end": 11830.48,
      "formatted_start": "03:17:07.480",
      "formatted_end": "03:17:10.480",
      "text": "باد داره خوب؟ کش میدی؟"
    },
    {
      "id": 36,
      "start": 11830.48,
      "end": 11832.48,
      "formatted_start": "03:17:10.480",
      "formatted_end": "03:17:12.480",
      "text": "دارو چیزی هم بهش میدی خانم بودی؟"
    },
    {
      "id": 37,
      "start": 11832.48,
      "end": 11834.48,
      "formatted_start": "03:17:12.480",
      "formatted_end": "03:17:14.480",
      "text": "باد شربت اوووی میکنی"
    },
    {
      "id": 38,
      "start": 11834.48,
      "end": 11836.48,
      "formatted_start": "03:17:14.480",
      "formatted_end": "03:17:16.480",
      "text": "خوابیه؟"
    },
    {
      "id": 39,
      "start": 11836.48,
      "end": 11838.48,
      "formatted_start": "03:17:16.480",
      "formatted_end": "03:17:18.480",
      "text": "باد رو آده"
    },
    {
      "id": 40,
      "start": 11838.48,
      "end": 11840.48,
      "formatted_start": "03:17:18.480",
      "formatted_end": "03:17:20.480",
      "text": "برادرانی بهش میسازه؟"
    },
    {
      "id": 41,
      "start": 11840.48,
      "end": 11844.48,
      "formatted_start": "03:17:20.480",
      "formatted_end": "03:17:24.480",
      "text": "اران بشه همونو میتونیم بیتر میسنس کنیم"
    },
    {
      "id": 42,
      "start": 11844.48,
      "end": 11846.48,
      "formatted_start": "03:17:24.480",
      "formatted_end": "03:17:26.480",
      "text": "روزی سه بار بهش بده"
    },
    {
      "id": 43,
      "start": 11846.48,
      "end": 11850.48,
      "formatted_start": "03:17:26.480",
      "formatted_end": "03:17:30.480",
      "text": "روزی سه بار هر بار یه پاشوق مربع خورید"
    },
    {
      "id": 44,
      "start": 11859.48,
      "end": 11861.48,
      "formatted_start": "03:17:39.480",
      "formatted_end": "03:17:41.480",
      "text": "صرفه زیاد داری یا کم؟"
    },
    {
      "id": 45,
      "start": 11861.48,
      "end": 11863.48,
      "formatted_start": "03:17:41.480",
      "formatted_end": "03:17:43.480",
      "text": "شبه خیلی زیاد میزنیم"
    },
    {
      "id": 46,
      "start": 11863.48,
      "end": 11865.48,
      "formatted_start": "03:17:43.480",
      "formatted_end": "03:17:45.480",
      "text": "زیاد؟ زیاد صرفه میزنی؟"
    },
    {
      "id": 47,
      "start": 11865.48,
      "end": 11866.48,
      "formatted_start": "03:17:45.480",
      "formatted_end": "03:17:46.480",
      "text": "هره"
    },
    {
      "id": 48,
      "start": 11866.48,
      "end": 11868.48,
      "formatted_start": "03:17:46.480",
      "formatted_end": "03:17:48.480",
      "text": "طبقه زیاد یا کمه؟"
    },
    {
      "id": 49,
      "start": 11868.48,
      "end": 11870.48,
      "formatted_start": "03:17:48.480",
      "formatted_end": "03:17:50.480",
      "text": "کمی زیاد نیست"
    },
    {
      "id": 50,
      "start": 11870.48,
      "end": 11871.48,
      "formatted_start": "03:17:50.480",
      "formatted_end": "03:17:51.480",
      "text": "کمی زیاد نیست"
    },
    {
      "id": 51,
      "start": 11871.48,
      "end": 11874.48,
      "formatted_start": "03:17:51.480",
      "formatted_end": "03:17:54.480",
      "text": "ولی صورتش خوبه زیاد داره"
    },
    {
      "id": 52,
      "start": 11874.48,
      "end": 11877.48,
      "formatted_start": "03:17:54.480",
      "formatted_end": "03:17:57.480",
      "text": "این جاروها رو بیاینی من ببینم"
    },
    {
      "id": 53,
      "start": 11881.48,
      "end": 11882.48,
      "formatted_start": "03:18:01.480",
      "formatted_end": "03:18:02.480",
      "text": "بیا باش"
    },
    {
      "id": 54,
      "start": 11885.48,
      "end": 11888.48,
      "formatted_start": "03:18:05.480",
      "formatted_end": "03:18:08.480",
      "text": "هم برای نفت گشته بشم هم برای سرمان بشم"
    },
    {
      "id": 55,
      "start": 11888.48,
      "end": 11890.48,
      "formatted_start": "03:18:08.480",
      "formatted_end": "03:18:10.480",
      "text": "بیا جا"
    },
    {
      "id": 56,
      "start": 11898.48,
      "end": 11920.48,
      "formatted_start": "03:18:18.480",
      "formatted_end": "03:18:40.480",
      "text": "موسیقی"
    },
    {
      "id": 57,
      "start": 11920.48,
      "end": 11926.48,
      "formatted_start": "03:18:40.480",
      "formatted_end": "03:18:46.480",
      "text": "از قراردار نیست، با حرکت برویم و پشت چراق زرد آماده بر حرکت بشیم"
    },
    {
      "id": 58,
      "start": 11926.48,
      "end": 11932.48,
      "formatted_start": "03:18:46.480",
      "formatted_end": "03:18:52.480",
      "text": "ببینید صرف قرارداره اگه قراردار را عکس بکن من آب از آقای منه"
    },
    {
      "id": 59,
      "start": 11932.48,
      "end": 11940.48,
      "formatted_start": "03:18:52.480",
      "formatted_end": "03:19:00.480",
      "text": "درسته؟ اگه بگیم پشت چراق قرمز نباید استاد باید حرکت کرد، پشت چراق سبز باید استاد"
    },
    {
      "id": 60,
      "start": 11940.48,
      "end": 11946.48,
      "formatted_start": "03:19:00.480",
      "formatted_end": "03:19:06.480",
      "text": "فرادونه میکنه، خود ما تصمیم گرفته ایم، قراردار کرده ایم"
    },
    {
      "id": 61,
      "start": 11946.48,
      "end": 11949.76,
      "formatted_start": "03:19:06.480",
      "formatted_end": "03:19:09.760",
      "text": "که قرمز را علامت توقف بدونید"
    },
    {
      "id": 62,
      "start": 11949.76,
      "end": 11952.62,
      "formatted_start": "03:19:09.760",
      "formatted_end": "03:19:12.620",
      "text": "و سطر را علامت منور بدونید"
    },
    {
      "id": 63,
      "start": 11952.62,
      "end": 11957.0,
      "formatted_start": "03:19:12.620",
      "formatted_end": "03:19:17.000",
      "text": "پرخواهد این هم داستان هم در باب راست گفتن و درو گفتن هست"
    },
    {
      "id": 64,
      "start": 11957.0,
      "end": 11958.88,
      "formatted_start": "03:19:17.000",
      "formatted_end": "03:19:18.880",
      "text": "قرارداد کرده ایم"
    },
    {
      "id": 65,
      "start": 11958.88,
      "end": 11961.38,
      "formatted_start": "03:19:18.880",
      "formatted_end": "03:19:21.380",
      "text": "که راست بگونید"
    },
    {
      "id": 66,
      "start": 11961.38,
      "end": 11964.58,
      "formatted_start": "03:19:21.380",
      "formatted_end": "03:19:24.580",
      "text": "و قرارداد کرده ایم که دونه نبونید"
    },
    {
      "id": 67,
      "start": 11964.58,
      "end": 11966.18,
      "formatted_start": "03:19:24.580",
      "formatted_end": "03:19:26.180",
      "text": "چیزی بیشتر از این نیست"
    },
    {
      "id": 68,
      "start": 11966.18,
      "end": 11972.0,
      "formatted_start": "03:19:26.180",
      "formatted_end": "03:19:32.000",
      "text": "یعنی قبه درو گفتن و حسن راست گفتن هست"
    },
    {
      "id": 69,
      "start": 11972.0,
      "end": 11974.7,
      "formatted_start": "03:19:32.000",
      "formatted_end": "03:19:34.700",
      "text": "اینا اینه"
    },
    {
      "id": 70,
      "start": 11974.7,
      "end": 11983.86,
      "formatted_start": "03:19:34.700",
      "formatted_end": "03:19:43.860",
      "text": "این هست که پشت چراب قرمز باید استاد و پشت چراب سرز نباید استادیم"
    },
    {
      "id": 71,
      "start": 11983.86,
      "end": 11989.86,
      "formatted_start": "03:19:43.860",
      "formatted_end": "03:19:49.860",
      "text": "خودمون درست کرده ایم خودمون هم درست کرده ایم خودمون رو نبود کنیم"
    },
    {
      "id": 72,
      "start": 11989.86,
      "end": 11995.98,
      "formatted_start": "03:19:49.860",
      "formatted_end": "03:19:55.980",
      "text": "خودمون اعتبار داده ایم خودمون هم اعتبار رو که علم یک آنشی کنیم"
    },
    {
      "id": 73,
      "start": 11995.98,
      "end": 11999.94,
      "formatted_start": "03:19:55.980",
      "formatted_end": "03:19:59.940",
      "text": "میگیم اعتباری در کار نیست اعتبار رو از بدش میده"
    }
  ],
  "status": "completed"
}