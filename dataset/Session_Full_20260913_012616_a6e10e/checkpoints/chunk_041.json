    },
    {
      "id": 13,
      "start": 12401.0,
      "end": 12403.0,
      "formatted_start": "03:26:41.000",
      "formatted_end": "03:26:43.000",
      "text": "برخواهیم"
    },
    {
      "id": 14,
      "start": 12403.0,
      "end": 12405.0,
      "formatted_start": "03:26:43.000",
      "formatted_end": "03:26:45.000",
      "text": "برخواهیم"
    },
    {
      "id": 15,
      "start": 12405.0,
      "end": 12407.0,
      "formatted_start": "03:26:45.000",
      "formatted_end": "03:26:47.000",
      "text": "برخواهیم"
    },
    {
      "id": 16,
      "start": 12407.0,
      "end": 12409.0,
      "formatted_start": "03:26:47.000",
      "formatted_end": "03:26:49.000",
      "text": "کاریدگاه یک نیز نوشته"
    },
    {
      "id": 17,
      "start": 12409.0,
      "end": 12411.0,
      "formatted_start": "03:26:49.000",
      "formatted_end": "03:26:51.000",
      "text": "یکونیم سی سی یکونیم قطعه چکان"
    },
    {
      "id": 18,
      "start": 12411.0,
      "end": 12413.0,
      "formatted_start": "03:26:51.000",
      "formatted_end": "03:26:53.000",
      "text": "درشون پشت های نوشته"
    },
    {
      "id": 19,
      "start": 12413.0,
      "end": 12415.0,
      "formatted_start": "03:26:53.000",
      "formatted_end": "03:26:55.000",
      "text": "باید دهنش اینجا باید خریده باشه"
    },
    {
      "id": 20,
      "start": 12415.0,
      "end": 12417.0,
      "formatted_start": "03:26:55.000",
      "formatted_end": "03:26:57.000",
      "text": "اون طوریه"
    },
    {
      "id": 21,
      "start": 12417.0,
      "end": 12419.0,
      "formatted_start": "03:26:57.000",
      "formatted_end": "03:26:59.000",
      "text": "نه کف دهنش یا رخ باشه؟"
    },
    {
      "id": 22,
      "start": 12419.0,
      "end": 12421.0,
      "formatted_start": "03:26:59.000",
      "formatted_end": "03:27:01.000",
      "text": "دهنش"
    },
    {
      "id": 23,
      "start": 12421.0,
      "end": 12423.0,
      "formatted_start": "03:27:01.000",
      "formatted_end": "03:27:03.000",
      "text": "ببینم"
    },
    {
      "id": 24,
      "start": 12423.0,
      "end": 12425.0,
      "formatted_start": "03:27:03.000",
      "formatted_end": "03:27:05.000",
      "text": "درشون"
    },
    {
      "id": 25,
      "start": 12425.0,
      "end": 12427.0,
      "formatted_start": "03:27:05.000",
      "formatted_end": "03:27:07.000",
      "text": "زبونش هم نزده"
    },
    {
      "id": 26,
      "start": 12427.0,
      "end": 12429.0,
      "formatted_start": "03:27:07.000",
      "formatted_end": "03:27:09.000",
      "text": "یک قطعه میستاتین میگیرید"
    },
    {
      "id": 27,
      "start": 12429.0,
      "end": 12431.0,
      "formatted_start": "03:27:09.000",
      "formatted_end": "03:27:11.000",
      "text": "میستاتین؟"
    },
    {
      "id": 28,
      "start": 12431.0,
      "end": 12433.0,
      "formatted_start": "03:27:11.000",
      "formatted_end": "03:27:13.000",
      "text": "آره دارین"
    },
    {
      "id": 29,
      "start": 12433.0,
      "end": 12435.0,
      "formatted_start": "03:27:13.000",
      "formatted_end": "03:27:15.000",
      "text": "من براتون میبینم"
    },
    {
      "id": 30,
      "start": 12435.0,
      "end": 12437.0,
      "formatted_start": "03:27:15.000",
      "formatted_end": "03:27:17.000",
      "text": "این خود هم بزن"
    },
    {
      "id": 31,
      "start": 12437.0,
      "end": 12439.0,
      "formatted_start": "03:27:17.000",
      "formatted_end": "03:27:19.000",
      "text": "تا یه ده روزی هم بزن"
    },
    {
      "id": 32,
      "start": 12443.0,
      "end": 12445.0,
      "formatted_start": "03:27:23.000",
      "formatted_end": "03:27:25.000",
      "text": "خانم گلگی جاید"
    },
    {
      "id": 33,
      "start": 12445.0,
      "end": 12447.0,
      "formatted_start": "03:27:25.000",
      "formatted_end": "03:27:27.000",
      "text": "براجون"
    },
    {
      "id": 34,
      "start": 12447.0,
      "end": 12449.0,
      "formatted_start": "03:27:27.000",
      "formatted_end": "03:27:29.000",
      "text": "نصف مرشد"
    },
    {
      "id": 35,
      "start": 12449.0,
      "end": 12451.0,
      "formatted_start": "03:27:29.000",
      "formatted_end": "03:27:31.000",
      "text": "براجون بگم"
    },
    {
      "id": 36,
      "start": 12451.0,
      "end": 12453.0,
      "formatted_start": "03:27:31.000",
      "formatted_end": "03:27:33.000",
      "text": "با دست بگم"
    },
    {
      "id": 37,
      "start": 12461.0,
      "end": 12463.0,
      "formatted_start": "03:27:41.000",
      "formatted_end": "03:27:43.000",
      "text": "بچه ها ببینه که نصالم از باب در من"
    },
    {
      "id": 38,
      "start": 12463.0,
      "end": 12470.0,
      "formatted_start": "03:27:43.000",
      "formatted_end": "03:27:50.000",
      "text": "خب اینجا چیکار میخوایی بکنی تو؟ آیا میتونی برنامه ریزی دقیقی بکنی؟ نه"
    },
    {
      "id": 39,
      "start": 12470.0,
      "end": 12476.0,
      "formatted_start": "03:27:50.000",
      "formatted_end": "03:27:56.000",
      "text": "خب این معنیشه که نه تو نهاد خانواده، نه تو نهاد اقتصاد، نه تو نهاد سیاست"
    },
    {
      "id": 40,
      "start": 12476.0,
      "end": 12482.0,
      "formatted_start": "03:27:56.000",
      "formatted_end": "03:28:02.000",
      "text": "تو هیچ نهادی مبنای محکم و زمین محکم و استواری نداریم"
    },
    {
      "id": 41,
      "start": 12482.0,
      "end": 12488.0,
      "formatted_start": "03:28:02.000",
      "formatted_end": "03:28:08.000",
      "text": "که بر اساس اون مبنا و بر اساس اون زمین و زمینه ما تصمیم بگیریم"
    },
    {
      "id": 42,
      "start": 12488.0,
      "end": 12491.0,
      "formatted_start": "03:28:08.000",
      "formatted_end": "03:28:11.000",
      "text": "خب این هم میشه زندگی میشه یکی بیمعنا دیگه"
    },
    {
      "id": 43,
      "start": 12491.0,
      "end": 12496.0,
      "formatted_start": "03:28:11.000",
      "formatted_end": "03:28:16.000",
      "text": "یعنی اینکه اینجا یک نوع هر جو مرج بر آلم اصانی حاکمه"
    },
    {
      "id": 44,
      "start": 12496.0,
      "end": 12498.0,
      "formatted_start": "03:28:16.000",
      "formatted_end": "03:28:18.000",
      "text": "یک نوع آناشی حاکمه"
    },
    {
      "id": 45,
      "start": 12498.0,
      "end": 12501.0,
      "formatted_start": "03:28:18.000",
      "formatted_end": "03:28:21.000",
      "text": "و هر جا هر جو مرد باشه این قانونی در کارو نیست"
    },
    {
      "id": 46,
      "start": 12501.0,
      "end": 12506.0,
      "formatted_start": "03:28:21.000",
      "formatted_end": "03:28:26.000",
      "text": "و هر جا قانون نماشه دیگه نمیشه فهمید که چی باید کرد و چی نباید کرد"
    },
    {
      "id": 47,
      "start": 12507.0,
      "end": 12512.0,
      "formatted_start": "03:28:27.000",
      "formatted_end": "03:28:32.000",
      "text": "خب بعدا هز کسانی هستن که زندگی بیمعنادار میابند"
    },
    {
      "id": 48,
      "start": 12512.0,
      "end": 12519.0,
      "formatted_start": "03:28:32.000",
      "formatted_end": "03:28:39.000",
      "text": "و کسان هستن که زندگی رو بی معنا میابن با روایت های مختلف بی معنایی"
    },
    {
      "id": 49,
      "start": 12519.0,
      "end": 12520.0,
      "formatted_start": "03:28:39.000",
      "formatted_end": "03:28:40.000",
      "text": "این"
    },
    {
      "id": 50,
      "start": 12522.0,
      "end": 12527.0,
      "formatted_start": "03:28:42.000",
      "formatted_end": "03:28:47.000",
      "text": "خب به این دهازم، الاسم را به دو دسته قابل فرق سیمند"
    },
    {
      "id": 51,
      "start": 12527.0,
      "end": 12532.0,
      "formatted_start": "03:28:47.000",
      "formatted_end": "03:28:52.000",
      "text": "کسانی که زندگی رو معنا دار میابن و کسانی که زندگی رو بی معنا میابن"
    },
    {
      "id": 52,
      "start": 12532.0,
      "end": 12536.0,
      "formatted_start": "03:28:52.000",
      "formatted_end": "03:28:56.000",
      "text": "دقیقا دوستان بکنن که در اینجا مردم از معنا ارزش بود"
    },
    {
      "id": 53,
      "start": 12536.0,
      "end": 12541.0,
      "formatted_start": "03:28:56.000",
      "formatted_end": "03:29:01.000",
      "text": "چون گاهی وقتی بخصی مردم ارزش بود میشه، هدف زندگی مورد هست"
    },
    {
      "id": 54,
      "start": 12541.0,
      "end": 12544.0,
      "formatted_start": "03:29:01.000",
      "formatted_end": "03:29:04.000",
      "text": "اینجا هدف زندگی محل بستان نرمید."
    },
    {
      "id": 55,
      "start": 12544.0,
      "end": 12549.0,
      "formatted_start": "03:29:04.000",
      "formatted_end": "03:29:09.000",
      "text": "گاه بختان مراد از معنای زندگی کارچرد زندگی."
    },
    {
      "id": 56,
      "start": 12549.0,
      "end": 12551.0,
      "formatted_start": "03:29:09.000",
      "formatted_end": "03:29:11.000",
      "text": "اونم محل بست من نیست در اینجا."
    },
    {
      "id": 57,
      "start": 12551.0,
      "end": 12555.0,
      "formatted_start": "03:29:11.000",
      "formatted_end": "03:29:15.000",
      "text": "من مرادم از معنای زندگی در اینجا عرضش زندگی."
    },
    {
      "id": 58,
      "start": 12555.0,
      "end": 12559.0,
      "formatted_start": "03:29:15.000",
      "formatted_end": "03:29:19.000",
      "text": "یعنی زیستن آیا عرضش منده؟"
    },
    {
      "id": 59,
      "start": 12559.0,
      "end": 12561.0,
      "formatted_start": "03:29:19.000",
      "formatted_end": "03:29:21.000",
      "text": "نیه عرض ما زندگی کنیم؟"
    },
    {
      "id": 60,
      "start": 12561.0,
      "end": 12563.0,
      "formatted_start": "03:29:21.000",
      "formatted_end": "03:29:23.000",
      "text": "نیه عرض ما زندگی کنیم؟"
    },
    {
      "id": 61,
      "start": 12563.0,
      "end": 12566.0,
      "formatted_start": "03:29:23.000",
      "formatted_end": "03:29:26.000",
      "text": "تو اگر همه چیز دست کنشه تصادف کنشیم،"
    },
    {
      "id": 62,
      "start": 12566.0,
      "end": 12568.0,
      "formatted_start": "03:29:26.000",
      "formatted_end": "03:29:28.000",
      "text": "زندگی چرزش کنم؟"
    },
    {
      "id": 63,
      "start": 12568.0,
      "end": 12573.24,
      "formatted_start": "03:29:28.000",
      "formatted_end": "03:29:33.240",
      "text": "و اگر ارزش ها هیچ اعتباری نداشتی باشند قیل از قراردادهایی"
    },
    {
      "id": 64,
      "start": 12573.24,
      "end": 12576.64,
      "formatted_start": "03:29:33.240",
      "formatted_end": "03:29:36.640",
      "text": "این همه هایی زندگی که ما بر اساس این قراردادها می کنیم"
    },
    {
      "id": 65,
      "start": 12576.64,
      "end": 12580.24,
      "formatted_start": "03:29:36.640",
      "formatted_end": "03:29:40.240",
      "text": "چه عرضشی داده چون قراردادها رو اگر عوض هم میکنیم"
    },
    {
      "id": 66,
      "start": 12580.24,
      "end": 12583.24,
      "formatted_start": "03:29:40.240",
      "formatted_end": "03:29:43.240",
      "text": "زندگی هیچ فرضی از اونکه حده می کنه"
    },
    {
      "id": 67,
      "start": 12583.24,
      "end": 12590.24,
      "formatted_start": "03:29:43.240",
      "formatted_end": "03:29:50.240",
      "text": "این هم در حال تقسیم بندی سه ماهه از انسانها"
    },
    {
      "id": 68,
      "start": 12590.24,
      "end": 12595.24,
      "formatted_start": "03:29:50.240",
      "formatted_end": "03:29:55.240",
      "text": "یک تقسیم بندی چهار ماه از انسانها میشه داشت"
    },
    {
      "id": 69,
      "start": 12595.24,
      "end": 12597.5,
      "formatted_start": "03:29:55.240",
      "formatted_end": "03:29:57.500",
      "text": "با اون تقسیم بندی این"
    },
    {
      "id": 70,
      "start": 12597.5,
      "end": 12599.88,
      "formatted_start": "03:29:57.500",
      "formatted_end": "03:29:59.880",
      "text": "ما بعضیمون"
    }
  ],
  "status": "completed"
}