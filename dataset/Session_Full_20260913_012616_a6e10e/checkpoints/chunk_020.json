  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6004.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:04.000",
      "text": "خب ببینید این زرده، برقی چیزاش خوبه."
    },
    {
      "id": 1,
      "start": 6004.0,
      "end": 6011.0,
      "formatted_start": "01:40:04.000",
      "formatted_end": "01:40:11.000",
      "text": "یه گرس برای زردیش میدویسم، فردا بیاد من ببینم، بیدم زردیش کجاییه."
    },
    {
      "id": 2,
      "start": 6011.0,
      "end": 6015.0,
      "formatted_start": "01:40:11.000",
      "formatted_end": "01:40:15.000",
      "text": "خب، بزید نمیخواد، فردا بیاد من ببینم."
    },
    {
      "id": 3,
      "start": 6015.0,
      "end": 6016.0,
      "formatted_start": "01:40:15.000",
      "formatted_end": "01:40:16.000",
      "text": "باباشه بگرد."
    },
    {
      "id": 4,
      "start": 6016.0,
      "end": 6017.0,
      "formatted_start": "01:40:16.000",
      "formatted_end": "01:40:17.000",
      "text": "کجا میشه؟"
    },
    {
      "id": 5,
      "start": 6017.0,
      "end": 6022.0,
      "formatted_start": "01:40:17.000",
      "formatted_end": "01:40:22.000",
      "text": "دلنده. باباشه بازار میره، که باشه اینجا باید میگرد."
    },
    {
      "id": 6,
      "start": 6022.0,
      "end": 6025.0,
      "formatted_start": "01:40:22.000",
      "formatted_end": "01:40:25.000",
      "text": "بازاریه میرفته بازار، وساط داره."
    },
    {
      "id": 7,
      "start": 6025.0,
      "end": 6026.0,
      "formatted_start": "01:40:25.000",
      "formatted_end": "01:40:26.000",
      "text": "خب فامیلتون بلوت چهاره؟"
    },
    {
      "id": 8,
      "start": 6026.0,
      "end": 6027.0,
      "formatted_start": "01:40:26.000",
      "formatted_end": "01:40:27.000",
      "text": "بلوت چهاره."
    },
    {
      "id": 9,
      "start": 6027.0,
      "end": 6031.0,
      "formatted_start": "01:40:27.000",
      "formatted_end": "01:40:31.000",
      "text": "این گرسه بگی بیاد من بگی نه؟ این درخواهی تا این درخواهی"
    },
    {
      "id": 10,
      "start": 6035.0,
      "end": 6040.0,
      "formatted_start": "01:40:35.000",
      "formatted_end": "01:40:40.000",
      "text": "بقیه چیزا شبه ولی زردی شما تیرید کشید وقتی استیاد نشد"
    },
    {
      "id": 11,
      "start": 6045.0,
      "end": 6048.0,
      "formatted_start": "01:40:45.000",
      "formatted_end": "01:40:48.000",
      "text": "در جای دیگه نیاز نیست؟ نه نه فیضان داری"
    },
    {
      "id": 12,
      "start": 6048.0,
      "end": 6050.0,
      "formatted_start": "01:40:48.000",
      "formatted_end": "01:40:50.000",
      "text": "باید برم برم"
    },
    {
      "id": 13,
      "start": 6055.0,
      "end": 6057.0,
      "formatted_start": "01:40:55.000",
      "formatted_end": "01:40:57.000",
      "text": "درمیزنده بندی"
    },
    {
      "id": 14,
      "start": 6078.0,
      "end": 6104.0,
      "formatted_start": "01:41:18.000",
      "formatted_end": "01:41:44.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 6104.0,
      "end": 6133.98,
      "formatted_start": "01:41:44.000",
      "formatted_end": "01:42:13.980",
      "text": "مردم در اینجا"
    },
    {
      "id": 16,
      "start": 6134.0,
      "end": 6163.98,
      "formatted_start": "01:42:14.000",
      "formatted_end": "01:42:43.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 17,
      "start": 6164.0,
      "end": 6193.98,
      "formatted_start": "01:42:44.000",
      "formatted_end": "01:43:13.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 18,
      "start": 6194.0,
      "end": 6220.0,
      "formatted_start": "01:43:14.000",
      "formatted_end": "01:43:40.000",
      "text": "موسیقی"
    },
    {
      "id": 19,
      "start": 6220.0,
      "end": 6222.0,
      "formatted_start": "01:43:40.000",
      "formatted_end": "01:43:42.000",
      "text": "سلام باشیم"
    },
    {
      "id": 20,
      "start": 6222.0,
      "end": 6224.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:44.000",
      "text": "سلام باشیم"
    },
    {
      "id": 21,
      "start": 6224.0,
      "end": 6226.0,
      "formatted_start": "01:43:44.000",
      "formatted_end": "01:43:46.000",
      "text": "برسانی"
    },
    {
      "id": 22,
      "start": 6226.0,
      "end": 6228.0,
      "formatted_start": "01:43:46.000",
      "formatted_end": "01:43:48.000",
      "text": "امیرالی"
    },
    {
      "id": 23,
      "start": 6228.0,
      "end": 6230.0,
      "formatted_start": "01:43:48.000",
      "formatted_end": "01:43:50.000",
      "text": "چی بگم مابا دکتر"
    },
    {
      "id": 24,
      "start": 6230.0,
      "end": 6234.0,
      "formatted_start": "01:43:50.000",
      "formatted_end": "01:43:54.000",
      "text": "دیروز کن از اینجا که بردم همه سه داره هم آب ریزش"
    },
    {
      "id": 25,
      "start": 6234.0,
      "end": 6236.0,
      "formatted_start": "01:43:54.000",
      "formatted_end": "01:43:56.000",
      "text": "فقط دیشب گفت هم با همون قرار قضا کن"
    },
    {
      "id": 26,
      "start": 6236.0,
      "end": 6238.0,
      "formatted_start": "01:43:56.000",
      "formatted_end": "01:43:58.000",
      "text": "برینیم اختبار داریم"
    },
    {
      "id": 27,
      "start": 6238.0,
      "end": 6240.0,
      "formatted_start": "01:43:58.000",
      "formatted_end": "01:44:00.000",
      "text": "حب نارتی نداشته"
    },
    {
      "id": 28,
      "start": 6240.0,
      "end": 6242.0,
      "formatted_start": "01:44:00.000",
      "formatted_end": "01:44:02.000",
      "text": "گلوش میگه گلو هدر میکنه"
    },
    {
      "id": 29,
      "start": 6242.0,
      "end": 6244.0,
      "formatted_start": "01:44:02.000",
      "formatted_end": "01:44:04.000",
      "text": "یکی میگه حال ندارم"
    },
    {
      "id": 30,
      "start": 6244.0,
      "end": 6246.0,
      "formatted_start": "01:44:04.000",
      "formatted_end": "01:44:06.000",
      "text": "ببینی خامی رودی میگن سه چار روز این"
    },
    {
      "id": 31,
      "start": 6246.0,
      "end": 6248.0,
      "formatted_start": "01:44:06.000",
      "formatted_end": "01:44:08.000",
      "text": "میگم آره"
    },
    {
      "id": 32,
      "start": 6248.0,
      "end": 6250.0,
      "formatted_start": "01:44:08.000",
      "formatted_end": "01:44:10.000",
      "text": "یک گلوشو میگو کنیم"
    },
    {
      "id": 33,
      "start": 6250.0,
      "end": 6252.0,
      "formatted_start": "01:44:10.000",
      "formatted_end": "01:44:12.000",
      "text": "شروط خوشکن دارم"
    },
    {
      "id": 34,
      "start": 6252.0,
      "end": 6256.0,
      "formatted_start": "01:44:12.000",
      "formatted_end": "01:44:16.000",
      "text": "شما باید از تا کلیت درسته دارو رو بده"
    },
    {
      "id": 35,
      "start": 6256.0,
      "end": 6258.0,
      "formatted_start": "01:44:16.000",
      "formatted_end": "01:44:18.000",
      "text": "برای اینکه اینجوری نیست که"
    },
    {
      "id": 36,
      "start": 6258.0,
      "end": 6264.0,
      "formatted_start": "01:44:18.000",
      "formatted_end": "01:44:24.000",
      "text": "کلیت همیشه قیل میگفت"
    },
    {
      "id": 37,
      "start": 6264.0,
      "end": 6266.0,
      "formatted_start": "01:44:24.000",
      "formatted_end": "01:44:26.000",
      "text": "خوشکن رو دارم بهش بدم خب"
    },
    {
      "id": 38,
      "start": 6266.0,
      "end": 6268.0,
      "formatted_start": "01:44:26.000",
      "formatted_end": "01:44:28.000",
      "text": "اون تقیید"
    },
    {
      "id": 39,
      "start": 6268.0,
      "end": 6270.0,
      "formatted_start": "01:44:28.000",
      "formatted_end": "01:44:30.000",
      "text": "این کلیتانش هم که خوبه"
    },
    {
      "id": 40,
      "start": 6270.0,
      "end": 6272.0,
      "formatted_start": "01:44:30.000",
      "formatted_end": "01:44:32.000",
      "text": "دارم بدم"
    },
    {
      "id": 41,
      "start": 6272.0,
      "end": 6274.0,
      "formatted_start": "01:44:32.000",
      "formatted_end": "01:44:34.000",
      "text": "داروها خوبن"
    },
    {
      "id": 42,
      "start": 6274.0,
      "end": 6276.0,
      "formatted_start": "01:44:34.000",
      "formatted_end": "01:44:36.000",
      "text": "سریع عوضش کنم بده بگیم"
    },
    {
      "id": 43,
      "start": 6276.0,
      "end": 6278.0,
      "formatted_start": "01:44:36.000",
      "formatted_end": "01:44:38.000",
      "text": "فقط گفتم آمپول چیزی داره"
    },
    {
      "id": 44,
      "start": 6278.0,
      "end": 6280.0,
      "formatted_start": "01:44:38.000",
      "formatted_end": "01:44:40.000",
      "text": "نه نه میاد چون تق نداره نیاز نداره"
    },
    {
      "id": 45,
      "start": 6280.0,
      "end": 6282.0,
      "formatted_start": "01:44:40.000",
      "formatted_end": "01:44:42.000",
