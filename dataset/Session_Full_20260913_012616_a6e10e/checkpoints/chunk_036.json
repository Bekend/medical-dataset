  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10827.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:27.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 10830.0,
      "end": 10840.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:40.000",
      "text": "اگر بیلای شما بودید، که رکز 3 تا باید خریده ای همون باید بکنید."
    },
    {
      "id": 2,
      "start": 10840.0,
      "end": 10844.0,
      "formatted_start": "03:00:40.000",
      "formatted_end": "03:00:44.000",
      "text": "اگر یا بودید، خریده ای بودید."
    },
    {
      "id": 3,
      "start": 10844.0,
      "end": 10846.0,
      "formatted_start": "03:00:44.000",
      "formatted_end": "03:00:46.000",
      "text": "نه، این سیاه بود باید بود."
    },
    {
      "id": 4,
      "start": 10846.0,
      "end": 10848.0,
      "formatted_start": "03:00:46.000",
      "formatted_end": "03:00:48.000",
      "text": "برامت بود."
    },
    {
      "id": 5,
      "start": 10848.0,
      "end": 10850.0,
      "formatted_start": "03:00:48.000",
      "formatted_end": "03:00:50.000",
      "text": "باشه بود."
    },
    {
      "id": 6,
      "start": 10850.0,
      "end": 10874.0,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:01:14.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 10874.0,
      "end": 10877.0,
      "formatted_start": "03:01:14.000",
      "formatted_end": "03:01:17.000",
      "text": "با خومشی موقع دادیم"
    },
    {
      "id": 8,
      "start": 10904.0,
      "end": 10905.0,
      "formatted_start": "03:01:44.000",
      "formatted_end": "03:01:45.000",
      "text": "آیو بی جان"
    },
    {
      "id": 9,
      "start": 10905.0,
      "end": 10908.5,
      "formatted_start": "03:01:45.000",
      "formatted_end": "03:01:48.500",
      "text": "شش مفهومات فرنسف میگم بهت که توی زندگی با اونان بکاره"
    },
    {
      "id": 10,
      "start": 10908.5,
      "end": 10909.5,
      "formatted_start": "03:01:48.500",
      "formatted_end": "03:01:49.500",
      "text": "یک"
    },
    {
      "id": 11,
      "start": 10909.5,
      "end": 10911.5,
      "formatted_start": "03:01:49.500",
      "formatted_end": "03:01:51.500",
      "text": "دانیره ی کنترول از اپیتیتوس"
    },
    {
      "id": 12,
      "start": 10911.5,
      "end": 10913.0,
      "formatted_start": "03:01:51.500",
      "formatted_end": "03:01:53.000",
      "text": "تهران ساج منجستره"
    },
    {
      "id": 13,
      "start": 10913.0,
      "end": 10914.0,
      "formatted_start": "03:01:53.000",
      "formatted_end": "03:01:54.000",
      "text": "جرافیت گل شده"
    },
    {
      "id": 14,
      "start": 10914.0,
      "end": 10916.5,
      "formatted_start": "03:01:54.000",
      "formatted_end": "03:01:56.500",
      "text": "داری هر سن روی بو میزنی فنشتن ویدی"
    },
    {
      "id": 15,
      "start": 10916.5,
      "end": 10918.0,
      "formatted_start": "03:01:56.500",
      "formatted_end": "03:01:58.000",
      "text": "بوگی غذا از خودت بپوز"
    },
    {
      "id": 16,
      "start": 10918.0,
      "end": 10920.0,
      "formatted_start": "03:01:58.000",
      "formatted_end": "03:02:00.000",
      "text": "باز چیانه این ترافیگای دست منه؟"
    },
    {
      "id": 17,
      "start": 10920.0,
      "end": 10920.5,
      "formatted_start": "03:02:00.000",
      "formatted_end": "03:02:00.500",
      "text": "نه"
    },
    {
      "id": 18,
      "start": 10920.5,
      "end": 10922.5,
      "formatted_start": "03:02:00.500",
      "formatted_end": "03:02:02.500",
      "text": "از چون اون ده انرژی تو داری میسازونی؟"
    },
    {
      "id": 19,
      "start": 10922.5,
      "end": 10923.5,
      "formatted_start": "03:02:02.500",
      "formatted_end": "03:02:03.500",
      "text": "اپیتیتوس میگفت"
    },
    {
      "id": 20,
      "start": 10923.5,
      "end": 10927.0,
      "formatted_start": "03:02:03.500",
      "formatted_end": "03:02:07.000",
      "text": "بزیر چیزها در اختیار ما هستن و بزیر چیزها نیسته"
    },
    {
      "id": 21,
      "start": 10927.0,
      "end": 10929.38,
      "formatted_start": "03:02:07.000",
      "formatted_end": "03:02:09.380",
      "text": "روی اولین همه رو کفت بکنی و اون رو میروی ببذیر"
    },
    {
      "id": 22,
      "start": 10929.38,
      "end": 10932.2,
      "formatted_start": "03:02:09.380",
      "formatted_end": "03:02:12.200",
      "text": "هر چیزی که عذیبت کرد اولستم از خود رو بپرسیم"
    },
    {
      "id": 23,
      "start": 10932.2,
      "end": 10933.04,
      "formatted_start": "03:02:12.200",
      "formatted_end": "03:02:13.040",
      "text": "بابند است منه"
    },
    {
      "id": 24,
      "start": 10933.04,
      "end": 10933.56,
      "formatted_start": "03:02:13.040",
      "formatted_end": "03:02:13.560",
      "text": "دو"
    },
    {
      "id": 25,
      "start": 10933.56,
      "end": 10935.38,
      "formatted_start": "03:02:13.560",
      "formatted_end": "03:02:15.380",
      "text": "تیوکام"
    },
    {
      "id": 26,
      "start": 10935.38,
      "end": 10937.66,
      "formatted_start": "03:02:15.380",
      "formatted_end": "03:02:17.660",
      "text": "به دوست زن میگنی جمع میبینه"
    },
    {
      "id": 27,
      "start": 10937.66,
      "end": 10940.42,
      "formatted_start": "03:02:17.660",
      "formatted_end": "03:02:20.420",
      "text": "اون ساعت بعد ذهن بودی سیلوه کامل میسازه"
    },
    {
      "id": 28,
      "start": 10940.42,
      "end": 10942.5,
      "formatted_start": "03:02:20.420",
      "formatted_end": "03:02:22.500",
      "text": "هر طور ناراحته ازم دل خورد"
    },
    {
      "id": 29,
      "start": 10942.5,
      "end": 10943.78,
      "formatted_start": "03:02:22.500",
      "formatted_end": "03:02:23.780",
      "text": "که کنه چیزی شده باشی"
    },
    {
      "id": 30,
      "start": 10943.78,
      "end": 10945.14,
      "formatted_start": "03:02:23.780",
      "formatted_end": "03:02:25.140",
      "text": "سرکون عزیزم"
    },
    {
      "id": 31,
      "start": 10945.14,
      "end": 10949.3,
      "formatted_start": "03:02:25.140",
      "formatted_end": "03:02:29.300",
      "text": "شاید گوشیش ساینته، شاید خوابیده شاید گلز هست، که موقع میگه"
    },
    {
      "id": 32,
      "start": 10949.3,
      "end": 10953.3,
      "formatted_start": "03:02:29.300",
      "formatted_end": "03:02:33.300",
      "text": "وقتی چند تا توضیح میکنیم داریم، بیداری خرزوی از آن نسائیه"
    },
    {
      "id": 33,
      "start": 10953.3,
      "end": 10957.9,
      "formatted_start": "03:02:33.300",
      "formatted_end": "03:02:37.900",
      "text": "ذهن ما آشرا دستان سازی رو پید، هر دستانی هم باید انترویو سه"
    },
    {
      "id": 34,
      "start": 10957.9,
      "end": 10962.3,
      "formatted_start": "03:02:37.900",
      "formatted_end": "03:02:42.300",
      "text": "پوکی و شروعش از کامو، همونطور میدار میشیم دانشگاه، کار، مترو، خونه"
    },
    {
      "id": 35,
      "start": 10962.3,
      "end": 10967.14,
      "formatted_start": "03:02:42.300",
      "formatted_end": "03:02:47.140",
      "text": "دو در از اولین چرخه که هر روز وردت یک جامعه شد، ایجاد با خود میدونه که کهی"
    },
    {
      "id": 36,
      "start": 10967.14,
      "end": 10969.14,
      "formatted_start": "03:02:47.140",
      "formatted_end": "03:02:49.140",
      "text": "چی کار دارن می کنن؟"
    },
    {
      "id": 37,
      "start": 10969.14,
      "end": 10973.14,
      "formatted_start": "03:02:49.140",
      "formatted_end": "03:02:53.140",
      "text": "کامل می گفت که اما موضوعاً منایی آماده ای که منتظر کشفش باشیم"
    },
    {
      "id": 38,
      "start": 10973.14,
      "end": 10976.14,
      "formatted_start": "03:02:53.140",
      "formatted_end": "03:02:56.140",
      "text": "به ما به نکار نیست، عربی رو ما نمی ده"
    },
    {
      "id": 39,
      "start": 10976.14,
      "end": 10978.14,
      "formatted_start": "03:02:56.140",
      "formatted_end": "03:02:58.140",
      "text": "اما جوابش نامیدی هم نیست"
    },
    {
      "id": 40,
      "start": 10978.14,
      "end": 10981.14,
      "formatted_start": "03:02:58.140",
      "formatted_end": "03:03:01.140",
      "text": "شبهش علاقه پوچی رو ادامه دادن ی زندگی با آقایی از اون"
    },
    {
      "id": 41,
      "start": 10981.14,
      "end": 10985.14,
      "formatted_start": "03:03:01.140",
      "formatted_end": "03:03:05.140",
      "text": "که قرار نیست همون قبول ببینیم همون زندگی رو بیدیو کنیم و بعد زندگی ببینیم که"
    },
    {
      "id": 42,
      "start": 10985.14,
      "end": 10988.14,
      "formatted_start": "03:03:05.140",
      "formatted_end": "03:03:08.140",
      "text": "گاهی باید توی همون زندگی خودمون یه منایی بسازیم"
    },
    {
      "id": 43,
      "start": 10988.14,
      "end": 10992.78,
      "formatted_start": "03:03:08.140",
      "formatted_end": "03:03:12.780",
      "text": "برای اینکه ویدیو خیلی طولانی نشد، این ششت مفهوم رو توی گو بخشی بخشن"
    },
    {
      "id": 44,
      "start": 10992.78,
      "end": 10994.7,
      "formatted_start": "03:03:12.780",
      "formatted_end": "03:03:14.700",
      "text": "بخشن، این قسمت از کتاب ما برد"
    },
    {
      "id": 45,
      "start": 10994.7,
      "end": 10996.42,
      "formatted_start": "03:03:14.700",
      "formatted_end": "03:03:16.420",
      "text": "ششت مفهوم رو فرزد کنیم"
    },
    {
      "id": 46,
      "start": 10996.42,
      "end": 11004.26,
      "formatted_start": "03:03:16.420",
      "formatted_end": "03:03:24.260",
      "text": "باید خیلی پیش میدن بره همه"
    },
    {
      "id": 47,
      "start": 11004.26,
      "end": 11006.86,
      "formatted_start": "03:03:24.260",
      "formatted_end": "03:03:26.860",
      "text": "اینکه یه سه خیلی چهار مفهوم فرزد کنیم"
    },
    {
      "id": 48,
      "start": 11006.86,
      "end": 11035.86,
      "formatted_start": "03:03:26.860",
      "formatted_end": "03:03:55.860",
      "text": "موسیقی"
    },
    {
      "id": 49,
      "start": 11036.86,
      "end": 11058.86,
      "formatted_start": "03:03:56.860",
      "formatted_end": "03:04:18.860",
      "text": "موسیقی"
    },
    {
      "id": 50,
      "start": 11066.86,
      "end": 11068.86,
      "formatted_start": "03:04:26.860",
      "formatted_end": "03:04:28.860",
      "text": "مردی باید بردارید"
    },
    {
      "id": 51,
      "start": 11068.86,
      "end": 11070.86,
      "formatted_start": "03:04:28.860",
      "formatted_end": "03:04:30.860",
      "text": "باید بردارید"
    },
    {
      "id": 52,
      "start": 11070.86,
      "end": 11072.86,
      "formatted_start": "03:04:30.860",
      "formatted_end": "03:04:32.860",
      "text": "باید بردارید"
    },
    {
      "id": 53,
      "start": 11072.86,
      "end": 11074.86,
      "formatted_start": "03:04:32.860",
      "formatted_end": "03:04:34.860",
      "text": "باید بردارید"
    },
    {
      "id": 54,
      "start": 11074.86,
      "end": 11076.86,
      "formatted_start": "03:04:34.860",
      "formatted_end": "03:04:36.860",
      "text": "باید بردارید"
    },
    {
      "id": 55,
      "start": 11076.86,
      "end": 11078.86,
      "formatted_start": "03:04:36.860",
      "formatted_end": "03:04:38.860",
      "text": "باید بردارید"
    },
    {
      "id": 56,
      "start": 11078.86,
      "end": 11080.86,
      "formatted_start": "03:04:38.860",
      "formatted_end": "03:04:40.860",
      "text": "باید بردارید"
    },
    {
