    {
      "id": 2,
      "start": 5760.0,
      "end": 5780.0,
      "formatted_start": "01:36:00.000",
      "formatted_end": "01:36:20.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 5790.0,
      "end": 5820.0,
      "formatted_start": "01:36:30.000",
      "formatted_end": "01:37:00.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 4,
      "start": 5820.0,
      "end": 5836.0,
      "formatted_start": "01:37:00.000",
      "formatted_end": "01:37:16.000",
      "text": "موسیقی"
    },
    {
      "id": 5,
      "start": 5850.0,
      "end": 5875.0,
      "formatted_start": "01:37:30.000",
      "formatted_end": "01:37:55.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 5880.0,
      "end": 5894.0,
      "formatted_start": "01:38:00.000",
      "formatted_end": "01:38:14.000",
      "text": "موسیقی"
    },
    {
      "id": 7,
      "start": 5894.0,
      "end": 5896.0,
      "formatted_start": "01:38:14.000",
      "formatted_end": "01:38:16.000",
      "text": "بخشید"
    },
    {
      "id": 8,
      "start": 5896.0,
      "end": 5907.0,
      "formatted_start": "01:38:16.000",
      "formatted_end": "01:38:27.000",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 5907.0,
      "end": 5910.0,
      "formatted_start": "01:38:27.000",
      "formatted_end": "01:38:30.000",
      "text": "سلام بابا جا سلامت باشید"
    },
    {
      "id": 10,
      "start": 5910.0,
      "end": 5912.0,
      "formatted_start": "01:38:30.000",
      "formatted_end": "01:38:32.000",
      "text": "بفرمایی که چی شده؟"
    },
    {
      "id": 11,
      "start": 5912.0,
      "end": 5915.0,
      "formatted_start": "01:38:32.000",
      "formatted_end": "01:38:35.000",
      "text": "نزد آمده دیورستان داره که نفرمه"
    },
    {
      "id": 12,
      "start": 5915.0,
      "end": 5916.0,
      "formatted_start": "01:38:35.000",
      "formatted_end": "01:38:36.000",
      "text": "باید کنترل رو آوردیم"
    },
    {
      "id": 13,
      "start": 5916.0,
      "end": 5919.0,
      "formatted_start": "01:38:36.000",
      "formatted_end": "01:38:39.000",
      "text": "نه دو تحفظ دارید، شیر بردنش خوبه؟"
    },
    {
      "id": 14,
      "start": 5919.0,
      "end": 5920.0,
      "formatted_start": "01:38:39.000",
      "formatted_end": "01:38:40.000",
      "text": "نه خدا شکرم"
    },
    {
      "id": 15,
      "start": 5920.0,
      "end": 5921.0,
      "formatted_start": "01:38:40.000",
      "formatted_end": "01:38:41.000",
      "text": "شکرمش خوب کار میکنه؟"
    },
    {
      "id": 16,
      "start": 5921.0,
      "end": 5922.0,
      "formatted_start": "01:38:41.000",
      "formatted_end": "01:38:42.000",
      "text": "نه استحال هم هست"
    },
    {
      "id": 17,
      "start": 5922.0,
      "end": 5923.0,
      "formatted_start": "01:38:42.000",
      "formatted_end": "01:38:43.000",
      "text": "استحال هم هست؟"
    },
    {
      "id": 18,
      "start": 5923.0,
      "end": 5924.0,
      "formatted_start": "01:38:43.000",
      "formatted_end": "01:38:44.000",
      "text": "نه"
    },
    {
      "id": 19,
      "start": 5924.0,
      "end": 5926.0,
      "formatted_start": "01:38:44.000",
      "formatted_end": "01:38:46.000",
      "text": "بله"
    },
    {
      "id": 20,
      "start": 5926.0,
      "end": 5928.0,
      "formatted_start": "01:38:46.000",
      "formatted_end": "01:38:48.000",
      "text": "شکرمش اینا خوب کار میکنه نه؟"
    },
    {
      "id": 21,
      "start": 5928.0,
      "end": 5930.0,
      "formatted_start": "01:38:48.000",
      "formatted_end": "01:38:50.000",
      "text": "نه خدا شکرم"
    },
    {
      "id": 22,
      "start": 5931.0,
      "end": 5934.0,
      "formatted_start": "01:38:51.000",
      "formatted_end": "01:38:54.000",
      "text": "اما از این ویزارتو تا دیدیم خدا شکرم"
    },
    {
      "id": 23,
      "start": 5934.0,
      "end": 5936.0,
      "formatted_start": "01:38:54.000",
      "formatted_end": "01:38:56.000",
      "text": "بسیار مردم"
    },
    {
      "id": 24,
      "start": 5943.0,
      "end": 5944.0,
      "formatted_start": "01:39:03.000",
      "formatted_end": "01:39:04.000",
      "text": "کجا میشونی؟"
    },
    {
      "id": 25,
      "start": 5944.0,
      "end": 5946.0,
      "formatted_start": "01:39:04.000",
      "formatted_end": "01:39:06.000",
      "text": "بله"
    },
    {
      "id": 26,
      "start": 5946.0,
      "end": 5948.0,
      "formatted_start": "01:39:06.000",
      "formatted_end": "01:39:08.000",
      "text": "یکمی هره"
    },
    {
      "id": 27,
      "start": 5948.0,
      "end": 5950.0,
      "formatted_start": "01:39:08.000",
      "formatted_end": "01:39:10.000",
      "text": "هره فره از روز بردم هره پاک پاشت"
    },
    {
      "id": 28,
      "start": 5950.0,
      "end": 5952.0,
      "formatted_start": "01:39:10.000",
      "formatted_end": "01:39:12.000",
      "text": "از اون روز بردم زندهش دیاد بود"
    },
    {
      "id": 29,
      "start": 5952.0,
      "end": 5954.0,
      "formatted_start": "01:39:12.000",
      "formatted_end": "01:39:14.000",
      "text": "دکتر دید گفت"
    },
    {
      "id": 30,
      "start": 5954.0,
      "end": 5956.0,
      "formatted_start": "01:39:14.000",
      "formatted_end": "01:39:16.000",
      "text": "دیستره بابانشو ببین شیره خودشو بینی"
    },
    {
      "id": 31,
      "start": 5956.0,
      "end": 5958.0,
      "formatted_start": "01:39:16.000",
      "formatted_end": "01:39:18.000",
      "text": "نه یکمی بیتر شد از اون روز که بردم"
    },
    {
      "id": 32,
      "start": 5958.0,
      "end": 5960.0,
      "formatted_start": "01:39:18.000",
      "formatted_end": "01:39:20.000",
      "text": "زنده هره"
    },
    {
      "id": 33,
      "start": 5960.0,
      "end": 5962.0,
      "formatted_start": "01:39:20.000",
      "formatted_end": "01:39:22.000",
      "text": "امروز یکمی خودشو بیتر شد"
    },
    {
      "id": 34,
      "start": 5962.0,
      "end": 5964.0,
      "formatted_start": "01:39:22.000",
      "formatted_end": "01:39:24.000",
      "text": "از اون روزو کاراندولا"
    },
    {
      "id": 35,
      "start": 5964.0,
      "end": 5966.0,
      "formatted_start": "01:39:24.000",
      "formatted_end": "01:39:26.000",
      "text": "هر این چند روزشه؟"
    },
    {
      "id": 36,
      "start": 5966.0,
      "end": 5968.0,
      "formatted_start": "01:39:26.000",
      "formatted_end": "01:39:28.000",
      "text": "پنج روز"
    },
    {
      "id": 37,
      "start": 5970.0,
      "end": 5972.0,
      "formatted_start": "01:39:30.000",
      "formatted_end": "01:39:32.000",
      "text": "بخش بخشه"
    },
    {
      "id": 38,
      "start": 5972.0,
      "end": 5974.0,
      "formatted_start": "01:39:32.000",
      "formatted_end": "01:39:34.000",
      "text": "به خاطر اولین سال همه خود"
    },
    {
      "id": 39,
      "start": 5974.0,
      "end": 5976.0,
      "formatted_start": "01:39:34.000",
      "formatted_end": "01:39:36.000",
      "text": "درست داریم"
    },
    {
      "id": 40,
      "start": 5976.0,
      "end": 5978.0,
      "formatted_start": "01:39:36.000",
      "formatted_end": "01:39:38.000",
      "text": "باشه در این روز"
    },
    {
      "id": 41,
      "start": 5978.0,
      "end": 5980.0,
      "formatted_start": "01:39:38.000",
      "formatted_end": "01:39:40.000",
      "text": "سخته؟"
    },
    {
      "id": 42,
      "start": 5980.0,
      "end": 5982.0,
      "formatted_start": "01:39:40.000",
      "formatted_end": "01:39:42.000",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 5982.0,
      "end": 5984.0,
      "formatted_start": "01:39:42.000",
      "formatted_end": "01:39:44.000",
      "text": "بعد کماد بزرگم"
    },
    {
      "id": 44,
      "start": 5984.0,
      "end": 5986.0,
      "formatted_start": "01:39:44.000",
      "formatted_end": "01:39:46.000",
      "text": "خانه یکمی بیتر شد"
    },
    {
      "id": 45,
      "start": 5986.0,
      "end": 5988.0,
      "formatted_start": "01:39:46.000",
      "formatted_end": "01:39:48.000",
      "text": "این کماد کاراندولا"
    },
    {
      "id": 46,
      "start": 5988.0,
      "end": 5990.0,
      "formatted_start": "01:39:48.000",
      "formatted_end": "01:39:50.000",
      "text": "کماد چی زدیم؟"
    },
    {
      "id": 47,
      "start": 5990.0,
      "end": 5992.0,
      "formatted_start": "01:39:50.000",
      "formatted_end": "01:39:52.000",
      "text": "این همون از دنبال خوب شد"
    },
    {
      "id": 48,
      "start": 5992.0,
      "end": 5994.0,
      "formatted_start": "01:39:52.000",
      "formatted_end": "01:39:54.000",
      "text": "باید میخواهم دوست داریم"
    },
    {
      "id": 49,
      "start": 5994.0,
      "end": 5996.0,
      "formatted_start": "01:39:54.000",
      "formatted_end": "01:39:56.000",
      "text": "این همون از دنبال خوب شد"
    },
    {
      "id": 50,
      "start": 5996.0,
      "end": 5998.0,
      "formatted_start": "01:39:56.000",
      "formatted_end": "01:39:58.000",
      "text": "این همون به زندگی هست"
    },
    {
      "id": 51,
      "start": 5998.0,
      "end": 6000.0,
      "formatted_start": "01:39:58.000",
      "formatted_end": "01:40:00.000",
      "text": "نه نه نه نه"
    }
  ],
