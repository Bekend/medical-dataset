  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12624.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:24.000",
      "text": "می توانیم زندگی کنیم، اما نمی توانیم بیمار. به این معناه که ما از زندگی خوشمون می آمیم، از زیستم خوشمون می آمیم، اما به شدت وحشت داریم از مدت."
    },
    {
      "id": 1,
      "start": 12624.0,
      "end": 12627.86,
      "formatted_start": "03:30:24.000",
      "formatted_end": "03:30:27.860",
      "text": "و بنابراین نمیتونید بلیدید"
    },
    {
      "id": 2,
      "start": 12627.86,
      "end": 12629.58,
      "formatted_start": "03:30:27.860",
      "formatted_end": "03:30:29.580",
      "text": "دیگه به جبر"
    },
    {
      "id": 3,
      "start": 12629.58,
      "end": 12632.16,
      "formatted_start": "03:30:29.580",
      "formatted_end": "03:30:32.160",
      "text": "فیزیولوژی و بیولوژی"
    },
    {
      "id": 4,
      "start": 12632.16,
      "end": 12633.4,
      "formatted_start": "03:30:32.160",
      "formatted_end": "03:30:33.400",
      "text": "نمیدونید"
    },
    {
      "id": 5,
      "start": 12633.4,
      "end": 12634.1,
      "formatted_start": "03:30:33.400",
      "formatted_end": "03:30:34.100",
      "text": "وگرن ما"
    },
    {
      "id": 6,
      "start": 12634.1,
      "end": 12637.18,
      "formatted_start": "03:30:34.100",
      "formatted_end": "03:30:37.180",
      "text": "توان مواجهه با مرگو نداریم"
    },
    {
      "id": 7,
      "start": 12637.18,
      "end": 12639.44,
      "formatted_start": "03:30:37.180",
      "formatted_end": "03:30:39.440",
      "text": "خیلی وحشتناکه"
    },
    {
      "id": 8,
      "start": 12639.44,
      "end": 12640.68,
      "formatted_start": "03:30:39.440",
      "formatted_end": "03:30:40.680",
      "text": "برای ما مرگ"
    },
    {
      "id": 9,
      "start": 12640.68,
      "end": 12642.94,
      "formatted_start": "03:30:40.680",
      "formatted_end": "03:30:42.940",
      "text": "هر آسانی دیگه با مرگو"
    },
    {
      "id": 10,
      "start": 12642.94,
      "end": 12643.64,
      "formatted_start": "03:30:42.940",
      "formatted_end": "03:30:43.640",
      "text": "نمیترسیم"
    },
    {
      "id": 11,
      "start": 12643.64,
      "end": 12646.88,
      "formatted_start": "03:30:43.640",
      "formatted_end": "03:30:46.880",
      "text": "یک سال اینجوریه"
    },
    {
      "id": 12,
      "start": 12646.88,
      "end": 12651.28,
      "formatted_start": "03:30:46.880",
      "formatted_end": "03:30:51.280",
      "text": "یک سالی هستن که"
    },
    {
      "id": 13,
      "start": 12651.28,
      "end": 12652.12,
      "formatted_start": "03:30:51.280",
      "formatted_end": "03:30:52.120",
      "text": "برعکس این"
    },
    {
      "id": 14,
      "start": 12652.12,
      "end": 12656.12,
      "formatted_start": "03:30:52.120",
      "formatted_end": "03:30:56.120",
      "text": "نمیتونن زندگی کنن ولی میتونن بمیرن"
    },
    {
      "id": 15,
      "start": 12656.12,
      "end": 12659.12,
      "formatted_start": "03:30:56.120",
      "formatted_end": "03:30:59.120",
      "text": "اینها کسانی هست که دست با خودکشی نزدن"
    },
    {
      "id": 16,
      "start": 12659.12,
      "end": 12663.12,
      "formatted_start": "03:30:59.120",
      "formatted_end": "03:31:03.120",
      "text": "دیگه نمیتونه زندگی کنن ولی میتونه بمیرن"
    },
    {
      "id": 17,
      "start": 12663.12,
      "end": 12666.12,
      "formatted_start": "03:31:03.120",
      "formatted_end": "03:31:06.120",
      "text": "و چون میتونه بمیره، میمیرن"
    },
    {
      "id": 18,
      "start": 12666.12,
      "end": 12670.12,
      "formatted_start": "03:31:06.120",
      "formatted_end": "03:31:10.120",
      "text": "یک درخواهی دیگر من که بخواهم"
    },
    {
      "id": 19,
      "start": 12670.12,
      "end": 12677.12,
      "formatted_start": "03:31:10.120",
      "formatted_end": "03:31:17.120",
      "text": "که این دستی که نمیتونن زندگی کنن ولی میتونن بمیرن"
    },
    {
      "id": 20,
      "start": 12677.12,
      "end": 12679.12,
      "formatted_start": "03:31:17.120",
      "formatted_end": "03:31:19.120",
      "text": "یعنی از مرد هیچ حراسی ندارن"
    },
    {
      "id": 21,
      "start": 12679.12,
      "end": 12685.42,
      "formatted_start": "03:31:19.120",
      "formatted_end": "03:31:25.420",
      "text": "هیچ ترسی ندارن ممکنه به جهاد بیگه ای دست خودکشی نزنن"
    },
    {
      "id": 22,
      "start": 12685.42,
      "end": 12691.32,
      "formatted_start": "03:31:25.420",
      "formatted_end": "03:31:31.320",
      "text": "اما خب جهاد دیگه خودشون از مرد ترسی ندارن"
    },
    {
      "id": 23,
      "start": 12691.32,
      "end": 12694.12,
      "formatted_start": "03:31:31.320",
      "formatted_end": "03:31:34.120",
      "text": "از مرد حراسی ندارن"
    },
    {
      "id": 24,
      "start": 12695.18,
      "end": 12698.12,
      "formatted_start": "03:31:35.180",
      "formatted_end": "03:31:38.120",
      "text": "زندگی که باشون قدر قابل تهم بوده"
    },
    {
      "id": 25,
      "start": 12698.12,
      "end": 12700.74,
      "formatted_start": "03:31:38.120",
      "formatted_end": "03:31:40.740",
      "text": "زندگی رو نمیخوام اما مرد رو میخوام"
    },
    {
      "id": 26,
      "start": 12700.74,
      "end": 12704.1,
      "formatted_start": "03:31:40.740",
      "formatted_end": "03:31:44.100",
      "text": "اما خب لزومت به خودکشی دست نمیزنن"
    },
    {
      "id": 27,
      "start": 12704.1,
      "end": 12706.44,
      "formatted_start": "03:31:44.100",
      "formatted_end": "03:31:46.440",
      "text": "چون ممکنه مرد دیگه ای داشته باشن"
    },
    {
      "id": 28,
      "start": 12706.44,
      "end": 12710.04,
      "formatted_start": "03:31:46.440",
      "formatted_end": "03:31:50.040",
      "text": "مانعه شون این نیست که از مرد میترسن"
    },
    {
      "id": 29,
      "start": 12710.04,
      "end": 12711.76,
      "formatted_start": "03:31:50.040",
      "formatted_end": "03:31:51.760",
      "text": "مانعه دیگه یه"
    },
    {
      "id": 30,
      "start": 12711.76,
      "end": 12714.72,
      "formatted_start": "03:31:51.760",
      "formatted_end": "03:31:54.720",
      "text": "ممکنه مانعه ایدئولوژیک داشته باشن"
    },
    {
      "id": 31,
      "start": 12714.72,
      "end": 12716.98,
      "formatted_start": "03:31:54.720",
      "formatted_end": "03:31:56.980",
      "text": "یعنی اطابه ایدئولوژی هستن"
    },
    {
      "id": 32,
      "start": 12716.98,
      "end": 12720.0,
      "formatted_start": "03:31:56.980",
      "formatted_end": "03:32:00.000",
      "text": "که اون ایدئولوژی میگه خودکشی نباید کنن"
    },
    {
      "id": 33,
      "start": 12720.0,
      "end": 12722.78,
      "formatted_start": "03:32:00.000",
      "formatted_end": "03:32:02.780",
      "text": "ممکنه به این جهت خودکشی نبونن"
    },
    {
      "id": 34,
      "start": 12722.78,
      "end": 12725.72,
      "formatted_start": "03:32:02.780",
      "formatted_end": "03:32:05.720",
      "text": "ممکنه آمده دومه در کار ماشیم"
    },
    {
      "id": 35,
      "start": 12726.36,
      "end": 12728.02,
      "formatted_start": "03:32:06.360",
      "formatted_end": "03:32:08.020",
      "text": "نبوی کنیم"
    },
    {
      "id": 36,
      "start": 12728.02,
      "end": 12730.96,
      "formatted_start": "03:32:08.020",
      "formatted_end": "03:32:10.960",
      "text": "آمده دومه با اون که"
    },
    {
      "id": 37,
      "start": 12730.96,
      "end": 12732.5,
      "formatted_start": "03:32:10.960",
      "formatted_end": "03:32:12.500",
      "text": "عزیزانی دارن"
    },
    {
      "id": 38,
      "start": 12732.5,
      "end": 12736.06,
      "formatted_start": "03:32:12.500",
      "formatted_end": "03:32:16.060",
      "text": "که میدونن اگر خودکشی کنن"
    },
    {
      "id": 39,
      "start": 12736.06,
      "end": 12741.06,
      "formatted_start": "03:32:16.060",
      "formatted_end": "03:32:21.060",
      "text": "اون عزیزان خودم عزیزان هستند"
    },
    {
      "id": 40,
      "start": 12741.06,
      "end": 12750.06,
      "formatted_start": "03:32:21.060",
      "formatted_end": "03:32:30.060",
      "text": "این ها قرین در دورنج زندگی شد وقتی که شخص خودشون رو کشه"
    },
    {
      "id": 41,
      "start": 12750.06,
      "end": 12754.06,
      "formatted_start": "03:32:30.060",
      "formatted_end": "03:32:34.060",
      "text": "اینو من حساب می کنم که اگر خودم رو مکشم عزیزانی هستند"
    },
    {
      "id": 42,
      "start": 12754.06,
      "end": 12761.06,
      "formatted_start": "03:32:34.060",
      "formatted_end": "03:32:41.060",
      "text": "کم یا بیشتر زندگی که این ها برای شون در دورنج غیر قابل تعملی تعملی کنه"
    },
    {
      "id": 43,
      "start": 12761.06,
      "end": 12764.06,
      "formatted_start": "03:32:41.060",
      "formatted_end": "03:32:44.060",
      "text": "از دنیا رفتن من"
    },
    {
      "id": 44,
      "start": 12764.06,
      "end": 12769.7,
      "formatted_start": "03:32:44.060",
      "formatted_end": "03:32:49.700",
      "text": "برای اینکه من اونها دردونج غیر قابل تعملی من تحمیل نکنم"
    },
    {
      "id": 45,
      "start": 12769.7,
      "end": 12775.18,
      "formatted_start": "03:32:49.700",
      "formatted_end": "03:32:55.180",
      "text": "اونها میام و خودکشی نمیکنن با اینکه اصلا زندگی من اونچه مطلوب نیست"
    },
    {
      "id": 46,
      "start": 12775.18,
      "end": 12782.06,
      "formatted_start": "03:32:55.180",
      "formatted_end": "03:33:02.060",
      "text": "اصلا دوستش ندارم ولی خب رضا میدم یعنی اگر دارم دیگران رو باید خودم ترجیح میدم"
    },
    {
      "id": 47,
      "start": 12782.06,
      "end": 12787.62,
      "formatted_start": "03:33:02.060",
      "formatted_end": "03:33:07.620",
      "text": "میگم یا باید خودم بمیرم و خودکشی بکنم که خودم از درد و رنج برهم"
    },
    {
      "id": 48,
      "start": 12787.62,
      "end": 12790.42,
      "formatted_start": "03:33:07.620",
      "formatted_end": "03:33:10.420",
      "text": "ولی دیگرهایی رو به درد و رنج بیاندازم"
    },
    {
      "id": 49,
      "start": 12790.42,
      "end": 12793.92,
      "formatted_start": "03:33:10.420",
      "formatted_end": "03:33:13.920",
      "text": "یا اینکه نه خودم درد و رنج زندگی رو تهم کنم"
    },
    {
      "id": 50,
      "start": 12793.92,
      "end": 12796.88,
      "formatted_start": "03:33:13.920",
      "formatted_end": "03:33:16.880",
      "text": "من معاف کنم دیگر رو از درد و رنج"
    },
    {
      "id": 51,
      "start": 12796.88,
      "end": 12800.18,
      "formatted_start": "03:33:16.880",
      "formatted_end": "03:33:20.180",
      "text": "خب اینجا بودم دیگر رو بر خودم برگذیدم"
    },
    {
      "id": 52,
      "start": 12800.18,
      "end": 12802.62,
      "formatted_start": "03:33:20.180",
      "formatted_end": "03:33:22.620",
      "text": "من می گم نه دیگر رو درد و رنج نکشم"
    },
    {
      "id": 53,
      "start": 12802.62,
      "end": 12807.08,
      "formatted_start": "03:33:22.620",
      "formatted_end": "03:33:27.080",
      "text": "خودم با هزار شکنجه و مشققی زندگی رو دنبالیم"
    },
    {
      "id": 54,
      "start": 12807.08,
      "end": 12810.12,
      "formatted_start": "03:33:27.080",
      "formatted_end": "03:33:30.120",
      "text": "اینه به دست دومه از آدم هست"
    },
    {
      "id": 55,
      "start": 12810.12,
      "end": 12813.02,
      "formatted_start": "03:33:30.120",
      "formatted_end": "03:33:33.020",
      "text": "یه دست سه اومه از آدم هست"
    },
    {
      "id": 56,
      "start": 12813.02,
      "end": 12818.12,
      "formatted_start": "03:33:33.020",
      "formatted_end": "03:33:38.120",
      "text": "اینها هم می تونن زندگی کنن و هم می تونن بیرون"
    },
    {
      "id": 57,
      "start": 12818.12,
      "end": 12822.1,
      "formatted_start": "03:33:38.120",
      "formatted_end": "03:33:42.100",
      "text": "اون چیزی که صورات از ما میخواست"
    },
    {
      "id": 58,
      "start": 12822.1,
      "end": 12824.74,
      "formatted_start": "03:33:42.100",
      "formatted_end": "03:33:44.740",
      "text": "اون چیزی که بودا از ما میخواست"
    },
    {
      "id": 59,
      "start": 12824.74,
      "end": 12827.1,
      "formatted_start": "03:33:44.740",
      "formatted_end": "03:33:47.100",
      "text": "اون چیزی که رواقی هم میخواستن از ما"
    },
    {
      "id": 60,
      "start": 12827.1,
      "end": 12830.0,
      "formatted_start": "03:33:47.100",
      "formatted_end": "03:33:50.000",
      "text": "میگفتن یه جوی باشید که زندگی رو"
    },
    {
      "id": 61,
      "start": 12830.0,
      "end": 12831.82,
      "formatted_start": "03:33:50.000",
      "formatted_end": "03:33:51.820",
      "text": "عاشقش باشید"
    },
    {
      "id": 62,
      "start": 12831.82,
      "end": 12833.82,
      "formatted_start": "03:33:51.820",
      "formatted_end": "03:33:53.820",
      "text": "ولی مرد رو هم دوست بدهید"
    },
    {
      "id": 63,
      "start": 12833.82,
      "end": 12835.96,
      "formatted_start": "03:33:53.820",
      "formatted_end": "03:33:55.960",
      "text": "جوری زندگی بود"
    },
    {
      "id": 64,
      "start": 12835.96,
      "end": 12839.8,
      "formatted_start": "03:33:55.960",
      "formatted_end": "03:33:59.800",
      "text": "که هم من وقتی که زندگی رو نگاه میتونم"
    },
    {
      "id": 65,
      "start": 12839.8,
      "end": 12841.5,
      "formatted_start": "03:33:59.800",
      "formatted_end": "03:34:01.500",
      "text": "ببینم عاشق زندگی"
    },
    {
      "id": 66,
      "start": 12841.5,
      "end": 12844.12,
      "formatted_start": "03:34:01.500",
      "formatted_end": "03:34:04.120",
      "text": "و هم ببینم مرد رو هم دوست بدهید"
    },
    {
      "id": 67,
      "start": 12844.12,
      "end": 12847.8,
      "formatted_start": "03:34:04.120",
      "formatted_end": "03:34:07.800",
      "text": "و این از طرز زندگی کردن آدمیان"
    },
    {
      "id": 68,
      "start": 12847.8,
      "end": 12856.8,
      "formatted_start": "03:34:07.800",
      "formatted_end": "03:34:16.800",
      "text": "پیداست که فرانکه هست که البته کمنت نه را ببینی فرانکه هست آشق زندگیه ولی مر را هم دوست داره"
    },
    {
      "id": 69,
      "start": 12856.8,
      "end": 12867.8,
      "formatted_start": "03:34:16.800",
      "formatted_end": "03:34:27.800",
      "text": "نه بکنی؟ مر را هم دوست داره البته نه اینجا توقع میکنید که تکیه بیشتر عشق و دوستیه"
    },
    {
      "id": 70,
      "start": 12867.8,
      "end": 12872.52,
      "formatted_start": "03:34:27.800",
      "formatted_end": "03:34:32.520",
      "text": "بازم ببینه کفه چیز سنگیدتره، کفه زندگی سنگیدتره"
    },
    {
      "id": 71,
      "start": 12872.52,
      "end": 12876.08,
      "formatted_start": "03:34:32.520",
      "formatted_end": "03:34:36.080",
      "text": "می‌گیم آشق زندگیه، ولی مردم دوست دارن"
    },
    {
      "id": 72,
      "start": 12876.08,
      "end": 12880.48,
      "formatted_start": "03:34:36.080",
      "formatted_end": "03:34:40.480",
      "text": "نفرت ندارن از دوست، از مرد، چینه‌ای از مرد نداره"
    },
    {
      "id": 73,
      "start": 12880.48,
      "end": 12884.36,
      "formatted_start": "03:34:40.480",
      "formatted_end": "03:34:44.360",
      "text": "بیزار نیست از مرد، خشبود از مرد"
    },
    {
      "id": 74,
      "start": 12884.36,
      "end": 12886.28,
      "formatted_start": "03:34:44.360",
      "formatted_end": "03:34:46.280",
      "text": "این‌ها داسته سه‌بوم هستن"
    },
    {
      "id": 75,
      "start": 12886.28,
      "end": 12894.44,
      "formatted_start": "03:34:46.280",
      "formatted_end": "03:34:54.440",
      "text": "و این‌ها کسانی هستن که می‌کنن هزار سال در آلم زندگی کنن و خند به ابرونه یادن"
    },
    {
      "id": 76,
      "start": 12894.44,
      "end": 12898.06,
      "formatted_start": "03:34:54.440",
      "formatted_end": "03:34:58.060",
      "text": "از اون طرف هم میتونن هر وقت مردشون رسید"
    },
    {
      "id": 77,
      "start": 12898.06,
      "end": 12899.98,
      "formatted_start": "03:34:58.060",
      "formatted_end": "03:34:59.980",
      "text": "چه در بیستارگی برسه چه در..."
    }
  ],
  "status": "completed"
}