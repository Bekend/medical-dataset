  "stt_segments": [
    {
      "id": 0,
      "start": 900.0,
      "end": 907.0,
      "formatted_start": "00:15:00.000",
      "formatted_end": "00:15:07.000",
      "text": "بعد وقتی که بچه رو درمان کنی، حالا این خوب میشه، بعد باز دوباره سینه تا میخوره، دوباره از اون بین."
    },
    {
      "id": 1,
      "start": 907.0,
      "end": 913.0,
      "formatted_start": "00:15:07.000",
      "formatted_end": "00:15:13.000",
      "text": "خود وجه شدید، هست باید سینه مادرم روزی سه مار این کرم رو براش بزنید."
    },
    {
      "id": 2,
      "start": 913.0,
      "end": 919.0,
      "formatted_start": "00:15:13.000",
      "formatted_end": "00:15:19.000",
      "text": "اینو که شیر دادی، تموم شد، با یه آب خالی میشورید، این کرم رو میزنید."
    },
    {
      "id": 3,
      "start": 919.0,
      "end": 925.0,
      "formatted_start": "00:15:19.000",
      "formatted_end": "00:15:25.000",
      "text": "بعد دفعه بدخواستی شیر بدی، از اون بر شیر بدی، دوباره با آب میشورید، خوش کنید."
    },
    {
      "id": 4,
      "start": 925.0,
      "end": 927.0,
      "formatted_start": "00:15:25.000",
      "formatted_end": "00:15:27.000",
      "text": "با هم بخوره"
    },
    {
      "id": 5,
      "start": 927.0,
      "end": 929.0,
      "formatted_start": "00:15:27.000",
      "formatted_end": "00:15:29.000",
      "text": "با هم بخوره"
    },
    {
      "id": 6,
      "start": 929.0,
      "end": 931.0,
      "formatted_start": "00:15:29.000",
      "formatted_end": "00:15:31.000",
      "text": "بعدش هر گطور کرم میزنه"
    },
    {
      "id": 7,
      "start": 931.0,
      "end": 933.0,
      "formatted_start": "00:15:31.000",
      "formatted_end": "00:15:33.000",
      "text": "دفعه باید خاص بخوره"
    },
    {
      "id": 8,
      "start": 933.0,
      "end": 935.0,
      "formatted_start": "00:15:33.000",
      "formatted_end": "00:15:35.000",
      "text": "معمولا دیگه جذب شده"
    },
    {
      "id": 9,
      "start": 935.0,
      "end": 937.0,
      "formatted_start": "00:15:35.000",
      "formatted_end": "00:15:37.000",
      "text": "اگه جذب نشده بود دیدی خیلی چربه"
    },
    {
      "id": 10,
      "start": 937.0,
      "end": 939.0,
      "formatted_start": "00:15:37.000",
      "formatted_end": "00:15:39.000",
      "text": "باید کرمکس پاک کن بشه"
    },
    {
      "id": 11,
      "start": 939.0,
      "end": 941.0,
      "formatted_start": "00:15:39.000",
      "formatted_end": "00:15:41.000",
      "text": "حالا این کرم رو"
    },
    {
      "id": 12,
      "start": 941.0,
      "end": 943.0,
      "formatted_start": "00:15:41.000",
      "formatted_end": "00:15:43.000",
      "text": "برای جای ادرار سختگی هم"
    },
    {
      "id": 13,
      "start": 943.0,
      "end": 945.0,
      "formatted_start": "00:15:43.000",
      "formatted_end": "00:15:45.000",
      "text": "اگر دیدی دوندون شد"
    },
    {
      "id": 14,
      "start": 945.0,
      "end": 947.0,
      "formatted_start": "00:15:45.000",
      "formatted_end": "00:15:47.000",
      "text": "استفاده کن"
    },
    {
      "id": 15,
      "start": 947.0,
      "end": 949.0,
      "formatted_start": "00:15:47.000",
      "formatted_end": "00:15:49.000",
      "text": "چون اینا قارچ و گرد میدن"
    },
    {
      "id": 16,
      "start": 949.0,
      "end": 951.0,
      "formatted_start": "00:15:49.000",
      "formatted_end": "00:15:51.000",
      "text": "از اون طرف مجموعه شده"
    },
    {
      "id": 17,
      "start": 951.0,
      "end": 953.0,
      "formatted_start": "00:15:51.000",
      "formatted_end": "00:15:53.000",
      "text": "ممکنه که"
    },
    {
      "id": 18,
      "start": 953.0,
      "end": 955.5,
      "formatted_start": "00:15:53.000",
      "formatted_end": "00:15:55.500",
      "text": "که جای دوشتشون خاصی میشه خب؟"
    },
    {
      "id": 19,
      "start": 957.0,
      "end": 958.0,
      "formatted_start": "00:15:57.000",
      "formatted_end": "00:15:58.000",
      "text": "این درمانش"
    },
    {
      "id": 20,
      "start": 958.0,
      "end": 959.0,
      "formatted_start": "00:15:58.000",
      "formatted_end": "00:15:59.000",
      "text": "آره"
    },
    {
      "id": 21,
      "start": 960.5,
      "end": 964.5,
      "formatted_start": "00:16:00.500",
      "formatted_end": "00:16:04.500",
      "text": "ملتی و چیزم چی دادم بهش؟ آهن و ملتی"
    },
    {
      "id": 22,
      "start": 964.5,
      "end": 965.5,
      "formatted_start": "00:16:04.500",
      "formatted_end": "00:16:05.500",
      "text": "چی داری بهش میگرد؟"
    },
    {
      "id": 23,
      "start": 967.0,
      "end": 971.0,
      "formatted_start": "00:16:07.000",
      "formatted_end": "00:16:11.000",
      "text": "ملتی ویتامین، الان شرکت چی بود اسمش؟"
    },
    {
      "id": 24,
      "start": 971.0,
      "end": 972.0,
      "formatted_start": "00:16:11.000",
      "formatted_end": "00:16:12.000",
      "text": "پیدیا بست"
    },
    {
      "id": 25,
      "start": 972.0,
      "end": 974.5,
      "formatted_start": "00:16:12.000",
      "formatted_end": "00:16:14.500",
      "text": "پیدیا بست بود، آهنم"
    },
    {
      "id": 26,
      "start": 976.5,
      "end": 978.0,
      "formatted_start": "00:16:16.500",
      "formatted_end": "00:16:18.000",
      "text": "آهن جدا نیست"
    },
    {
      "id": 27,
      "start": 980.0,
      "end": 981.5,
      "formatted_start": "00:16:20.000",
      "formatted_end": "00:16:21.500",
      "text": "آهنشون فرافقت میدید"
    },
    {
      "id": 28,
      "start": 981.5,
      "end": 983.5,
      "formatted_start": "00:16:21.500",
      "formatted_end": "00:16:23.500",
      "text": "این رو خود میشن"
    },
    {
      "id": 29,
      "start": 983.5,
      "end": 985.5,
      "formatted_start": "00:16:23.500",
      "formatted_end": "00:16:25.500",
      "text": "خب مناران الان چند سال"
    },
    {
      "id": 30,
      "start": 985.5,
      "end": 987.5,
      "formatted_start": "00:16:25.500",
      "formatted_end": "00:16:27.500",
      "text": "چند قصه شده؟"
    },
    {
      "id": 31,
      "start": 987.5,
      "end": 989.5,
      "formatted_start": "00:16:27.500",
      "formatted_end": "00:16:29.500",
      "text": "یه سال و چهار ماه"
    },
    {
      "id": 32,
      "start": 989.5,
      "end": 991.5,
      "formatted_start": "00:16:29.500",
      "formatted_end": "00:16:31.500",
      "text": "نه باید دست بزنیم"
    },
    {
      "id": 33,
      "start": 991.5,
      "end": 993.5,
      "formatted_start": "00:16:31.500",
      "formatted_end": "00:16:33.500",
      "text": "نه نه نه"
    },
    {
      "id": 34,
      "start": 993.5,
      "end": 995.5,
      "formatted_start": "00:16:33.500",
      "formatted_end": "00:16:35.500",
      "text": "چند سال تو به دنیا آن؟"
    },
    {
      "id": 35,
      "start": 995.5,
      "end": 997.5,
      "formatted_start": "00:16:35.500",
      "formatted_end": "00:16:37.500",
      "text": "سه و نیم"
    },
    {
      "id": 36,
      "start": 997.5,
      "end": 1003.5,
      "formatted_start": "00:16:37.500",
      "formatted_end": "00:16:43.500",
      "text": "از مایش دادی تا الان باز نیم"
    },
    {
      "id": 37,
      "start": 1003.5,
      "end": 1005.5,
      "formatted_start": "00:16:43.500",
      "formatted_end": "00:16:45.500",
      "text": "از اینکه غذا نمیخور"
    },
    {
      "id": 38,
      "start": 1005.5,
      "end": 1007.5,
      "formatted_start": "00:16:45.500",
      "formatted_end": "00:16:47.500",
      "text": "خانداشو خیلی هم حضور میکنن"
    },
    {
      "id": 39,
      "start": 1007.5,
      "end": 1009.5,
      "formatted_start": "00:16:47.500",
      "formatted_end": "00:16:49.500",
      "text": "خیلی"
    },
    {
      "id": 40,
      "start": 1009.5,
      "end": 1013.96,
      "formatted_start": "00:16:49.500",
      "formatted_end": "00:16:53.960",
      "text": "بله، همه بچه ها باید توی یک سالگی یک چکاب بشن."
    },
    {
      "id": 41,
      "start": 1013.96,
      "end": 1021.16,
      "formatted_start": "00:16:53.960",
      "formatted_end": "00:17:01.160",
      "text": "خب، حالا اونهایی که کم ورد نه، چه بهتر که بیشتر تحکیم میکنیم برای یک چکاب بشن."
    },
    {
      "id": 42,
      "start": 1021.16,
      "end": 1022.16,
      "formatted_start": "00:17:01.160",
      "formatted_end": "00:17:02.160",
      "text": "آهنگ."
    },
    {
      "id": 43,
      "start": 1022.16,
      "end": 1024.74,
      "formatted_start": "00:17:02.160",
      "formatted_end": "00:17:04.740",
      "text": "خب، میخواییم برمیسیم تو برمیسیم."
    },
    {
      "id": 44,
      "start": 1024.74,
      "end": 1027.84,
      "formatted_start": "00:17:04.740",
      "formatted_end": "00:17:07.840",
      "text": "بعد، الان شما بیزیت رو برمیسیم تا..."
    },
    {
      "id": 45,
      "start": 1027.84,
      "end": 1028.34,
      "formatted_start": "00:17:07.840",
      "formatted_end": "00:17:08.340",
      "text": "آهنگ."
    },
    {
      "id": 46,
      "start": 1028.34,
      "end": 1030.0,
      "formatted_start": "00:17:08.340",
      "formatted_end": "00:17:10.000",
      "text": "یکی ما میتونیم استفاده کنیم."
    },
    {
      "id": 47,
      "start": 1030.0,
      "end": 1032.0,
      "formatted_start": "00:17:10.000",
      "formatted_end": "00:17:12.000",
      "text": "آهنگ."
    },
    {
      "id": 48,
      "start": 1032.0,
      "end": 1034.0,
      "formatted_start": "00:17:12.000",
      "formatted_end": "00:17:14.000",
      "text": "چی میگی؟"
    },
    {
      "id": 49,
      "start": 1034.0,
      "end": 1035.0,
      "formatted_start": "00:17:14.000",
      "formatted_end": "00:17:15.000",
      "text": "آهنگ."
    },
