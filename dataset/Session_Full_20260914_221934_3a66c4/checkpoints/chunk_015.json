  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4529.98,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:29.980",
      "text": "این همه بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 4530.0,
      "end": 4532.0,
      "formatted_start": "01:15:30.000",
      "formatted_end": "01:15:32.000",
      "text": "این را فراموش کرده"
    },
    {
      "id": 2,
      "start": 4532.0,
      "end": 4538.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:38.000",
      "text": "اول را رسید که این واکسان را در بیمارستان یادش دارد"
    },
    {
      "id": 3,
      "start": 4538.0,
      "end": 4542.0,
      "formatted_start": "01:15:38.000",
      "formatted_end": "01:15:42.000",
      "text": "بعد از این را بخشیم و در مدت بیرون بگم"
    },
    {
      "id": 4,
      "start": 4542.0,
      "end": 4546.0,
      "formatted_start": "01:15:42.000",
      "formatted_end": "01:15:46.000",
      "text": "بعد از این را بخشیم و در خصوصی بگم"
    },
    {
      "id": 5,
      "start": 4546.0,
      "end": 4548.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:48.000",
      "text": "خیلی چیزی دارد"
    },
    {
      "id": 6,
      "start": 4548.0,
      "end": 4551.0,
      "formatted_start": "01:15:48.000",
      "formatted_end": "01:15:51.000",
      "text": "می توانیم بزنیم یا نباشیم برای بیمارستان"
    },
    {
      "id": 7,
      "start": 4551.0,
      "end": 4554.0,
      "formatted_start": "01:15:51.000",
      "formatted_end": "01:15:54.000",
      "text": "تو بازمیش کنم"
    },
    {
      "id": 8,
      "start": 4554.0,
      "end": 4557.0,
      "formatted_start": "01:15:54.000",
      "formatted_end": "01:15:57.000",
      "text": "که سه زار نگردند چرا بزنید؟"
    },
    {
      "id": 9,
      "start": 4557.0,
      "end": 4559.0,
      "formatted_start": "01:15:57.000",
      "formatted_end": "01:15:59.000",
      "text": "یعنی بیداشون بزنند؟"
    },
    {
      "id": 10,
      "start": 4559.0,
      "end": 4561.0,
      "formatted_start": "01:15:59.000",
      "formatted_end": "01:16:01.000",
      "text": "او سواز نیستی؟ نه مشکل نمیدونی؟"
    },
    {
      "id": 11,
      "start": 4561.0,
      "end": 4563.0,
      "formatted_start": "01:16:01.000",
      "formatted_end": "01:16:03.000",
      "text": "نه مشکل نمیدونی"
    },
    {
      "id": 12,
      "start": 4563.0,
      "end": 4565.0,
      "formatted_start": "01:16:03.000",
      "formatted_end": "01:16:05.000",
      "text": "او سواز نیستی؟ نه مشکل نمیدونی؟"
    },
    {
      "id": 13,
      "start": 4565.0,
      "end": 4567.0,
      "formatted_start": "01:16:05.000",
      "formatted_end": "01:16:07.000",
      "text": "نه مشکل نمیدونی؟"
    },
    {
      "id": 14,
      "start": 4567.0,
      "end": 4569.0,
      "formatted_start": "01:16:07.000",
      "formatted_end": "01:16:09.000",
      "text": "اینجا باید بردارید"
    },
    {
      "id": 15,
      "start": 4569.0,
