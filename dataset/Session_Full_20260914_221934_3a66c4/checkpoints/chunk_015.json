      "formatted_start": "01:16:45.000",
      "formatted_end": "01:16:47.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 26,
      "start": 4607.0,
      "end": 4609.0,
      "formatted_start": "01:16:47.000",
      "formatted_end": "01:16:49.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 27,
      "start": 4609.0,
      "end": 4611.0,
      "formatted_start": "01:16:49.000",
      "formatted_end": "01:16:51.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 28,
      "start": 4611.0,
      "end": 4613.0,
      "formatted_start": "01:16:51.000",
      "formatted_end": "01:16:53.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 29,
      "start": 4613.0,
      "end": 4615.0,
      "formatted_start": "01:16:53.000",
      "formatted_end": "01:16:55.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 30,
      "start": 4615.0,
      "end": 4617.0,
      "formatted_start": "01:16:55.000",
      "formatted_end": "01:16:57.000",
      "text": "برگرده از اینجا برگرده"
    },
    {
      "id": 31,
      "start": 4617.0,
      "end": 4621.0,
      "formatted_start": "01:16:57.000",
      "formatted_end": "01:17:01.000",
      "text": "زخم شده و آفتیزی زوده برطک سکوت زده"
    },
    {
      "id": 32,
      "start": 4621.0,
      "end": 4623.0,
      "formatted_start": "01:17:01.000",
      "formatted_end": "01:17:03.000",
      "text": "نه نه آفتیزی زوده"
    },
    {
      "id": 33,
      "start": 4623.0,
      "end": 4628.0,
      "formatted_start": "01:17:03.000",
      "formatted_end": "01:17:08.000",
      "text": "خسرش و ترپ پلاشین از اونا گرفته"
    },
    {
      "id": 34,
      "start": 4628.0,
      "end": 4630.0,
      "formatted_start": "01:17:08.000",
      "formatted_end": "01:17:10.000",
      "text": "نیستاتین"
    },
    {
      "id": 35,
      "start": 4630.0,
      "end": 4634.0,
      "formatted_start": "01:17:10.000",
      "formatted_end": "01:17:14.000",
      "text": "میگن آتو دیگه نداره سرکنی خیلی بیشتر تا صبح بیرون"
    },
    {
      "id": 36,
      "start": 4634.0,
      "end": 4636.0,
      "formatted_start": "01:17:14.000",
      "formatted_end": "01:17:16.000",
      "text": "نیستاتینو بده خب"
    },
    {
      "id": 37,
      "start": 4636.0,
      "end": 4639.0,
      "formatted_start": "01:17:16.000",
      "formatted_end": "01:17:19.000",
      "text": "پلاشین اگر صرف داره بده اگر نداره نده"
    },
    {
      "id": 38,
      "start": 4639.0,
      "end": 4642.0,
      "formatted_start": "01:17:19.000",
      "formatted_end": "01:17:22.000",
      "text": "دیفنتیترامین بعدی دهنش بده خب"
    },
    {
      "id": 39,
      "start": 4642.0,
      "end": 4646.0,
      "formatted_start": "01:17:22.000",
      "formatted_end": "01:17:26.000",
      "text": "یه دونه شخص آسیبیو بیر بهش بده"
    },
    {
      "id": 40,
      "start": 4646.0,
      "end": 4654.0,
      "formatted_start": "01:17:26.000",
      "formatted_end": "01:17:34.000",
      "text": "8 ساعت دو سی سی و اسام نفنده های دیگه"
    },
    {
      "id": 41,
      "start": 4654.0,
      "end": 4659.0,
      "formatted_start": "01:17:34.000",
      "formatted_end": "01:17:39.000",
      "text": "اسم شیره؟"
    },
    {
      "id": 42,
      "start": 4659.0,
      "end": 4659.92,
      "formatted_start": "01:17:39.000",
      "formatted_end": "01:17:39.920",
      "text": "دیگه دیگه بودی"
    },
    {
      "id": 43,
      "start": 4659.92,
      "end": 4663.0,
      "formatted_start": "01:17:39.920",
      "formatted_end": "01:17:43.000",
      "text": "اسمه کشکر کشکر دیگه بودی"
    },
    {
      "id": 44,
      "start": 4663.0,
      "end": 4665.0,
      "formatted_start": "01:17:43.000",
      "formatted_end": "01:17:45.000",
      "text": "بیا دیگه"
    },
    {
      "id": 45,
      "start": 4665.0,
      "end": 4668.0,
      "formatted_start": "01:17:45.000",
      "formatted_end": "01:17:48.000",
      "text": "سماره بیدی شما در این درگاه بیدید"
    },
    {
      "id": 46,
      "start": 4668.0,
      "end": 4670.5,
      "formatted_start": "01:17:48.000",
      "formatted_end": "01:17:50.500",
      "text": "باید براشو"
    },
    {
      "id": 47,
      "start": 4670.5,
      "end": 4674.12,
      "formatted_start": "01:17:50.500",
      "formatted_end": "01:17:54.120",
      "text": "بیده در مرگه"
    },
    {
      "id": 48,
      "start": 4674.12,
      "end": 4677.42,
      "formatted_start": "01:17:54.120",
      "formatted_end": "01:17:57.420",
      "text": "مال این هم بیمون ساپ نشده"
    },
    {
      "id": 49,
      "start": 4677.42,
      "end": 4678.92,
      "formatted_start": "01:17:57.420",
      "formatted_end": "01:17:58.920",
      "text": "این مال چیه؟"
    },
    {
      "id": 50,
      "start": 4678.92,
      "end": 4680.12,
      "formatted_start": "01:17:58.920",
      "formatted_end": "01:18:00.120",
      "text": "خدا مونده همون"
    },
    {
      "id": 51,
      "start": 4684.12,
      "end": 4687.12,
      "formatted_start": "01:18:04.120",
      "formatted_end": "01:18:07.120",
      "text": "منه با اینجا با بیرگاه همینم"
    },
    {
      "id": 52,
      "start": 4687.12,
      "end": 4690.12,
      "formatted_start": "01:18:07.120",
      "formatted_end": "01:18:10.120",
      "text": "نخواسته آمرشت بدم پدرم برم"
    },
    {
      "id": 53,
      "start": 4690.12,
      "end": 4693.12,
      "formatted_start": "01:18:10.120",
      "formatted_end": "01:18:13.120",
      "text": "چون در دسته های آمرشت خاطر بودن"
    },
    {
      "id": 54,
      "start": 4696.12,
      "end": 4699.12,
      "formatted_start": "01:18:16.120",
      "formatted_end": "01:18:19.120",
      "text": "منه رفتم بیدر میگرستم ما مشاده رو هستیم"
    },
    {
      "id": 55,
      "start": 4699.12,
      "end": 4700.12,
      "formatted_start": "01:18:19.120",
      "formatted_end": "01:18:20.120",
      "text": "جا دیگه نمیدونیم"
    },
    {
      "id": 56,
      "start": 4700.12,
      "end": 4701.12,
      "formatted_start": "01:18:20.120",
      "formatted_end": "01:18:21.120",
      "text": "شست داده چه؟"
    },
    {
      "id": 57,
      "start": 4701.12,
      "end": 4702.12,
      "formatted_start": "01:18:21.120",
      "formatted_end": "01:18:22.120",
      "text": "آهان"
    },
    {
      "id": 58,
      "start": 4702.12,
      "end": 4704.12,
      "formatted_start": "01:18:22.120",
      "formatted_end": "01:18:24.120",
      "text": "بچه همینجور بچه داریم"
    },
    {
      "id": 59,
      "start": 4704.12,
      "end": 4708.12,
      "formatted_start": "01:18:24.120",
      "formatted_end": "01:18:28.120",
      "text": "۶۱۸۱۷۹"
    },
    {
      "id": 60,
      "start": 4708.12,
      "end": 4712.12,
      "formatted_start": "01:18:28.120",
      "formatted_end": "01:18:32.120",
      "text": "بچه خرزون پرست"
    },
    {
      "id": 61,
      "start": 4712.12,
      "end": 4716.12,
      "formatted_start": "01:18:32.120",
      "formatted_end": "01:18:36.120",
      "text": "۲۰۰۰۹۹"
    },
    {
      "id": 62,
      "start": 4716.12,
      "end": 4720.12,
      "formatted_start": "01:18:36.120",
      "formatted_end": "01:18:40.120",
      "text": "یک ماه دیگه بگو موسیقی خراب داره بوده یه نه؟"
    },
    {
      "id": 63,
      "start": 4720.12,
      "end": 4722.12,
      "formatted_start": "01:18:40.120",
      "formatted_end": "01:18:42.120",
      "text": "یه نه نه نه"
    },
    {
      "id": 64,
      "start": 4722.12,
      "end": 4724.12,
      "formatted_start": "01:18:42.120",
      "formatted_end": "01:18:44.120",
      "text": "۶۶"
    },
    {
      "id": 65,
      "start": 4725.12,
      "end": 4727.12,
      "formatted_start": "01:18:45.120",
      "formatted_end": "01:18:47.120",
      "text": "۶۶۸"
    },
    {
      "id": 66,
      "start": 4727.12,
      "end": 4729.12,
      "formatted_start": "01:18:47.120",
      "formatted_end": "01:18:49.120",
      "text": "۷۷"
    },
    {
      "id": 67,
      "start": 4732.12,
      "end": 4734.12,
      "formatted_start": "01:18:52.120",
      "formatted_end": "01:18:54.120",
      "text": "نه"
    },
    {
      "id": 68,
      "start": 4734.12,
      "end": 4736.12,
      "formatted_start": "01:18:54.120",
      "formatted_end": "01:18:56.120",
      "text": "بخونید با اینکه برنامه باشید"
    },
    {
      "id": 69,
      "start": 4741.12,
      "end": 4743.12,
      "formatted_start": "01:19:01.120",
      "formatted_end": "01:19:03.120",
      "text": "خب، شست و دو چهر؟"
    },
    {
      "id": 70,
      "start": 4743.12,
      "end": 4745.12,
      "formatted_start": "01:19:03.120",
      "formatted_end": "01:19:05.120",
      "text": "شست و یک"
    },
    {
      "id": 71,
      "start": 4745.12,
      "end": 4747.12,
      "formatted_start": "01:19:05.120",
      "formatted_end": "01:19:07.120",
      "text": "حالا اول شست و دو چهر دارید؟"
    },
    {
      "id": 72,
      "start": 4747.12,
      "end": 4748.12,
      "formatted_start": "01:19:07.120",
      "formatted_end": "01:19:08.120",
      "text": "نه"
    },
    {
      "id": 73,
      "start": 4748.12,
      "end": 4751.12,
      "formatted_start": "01:19:08.120",
      "formatted_end": "01:19:11.120",
      "text": "شست و یک، عشق و یک، عشق و دنبال"
    },
    {
      "id": 74,
      "start": 4751.12,
      "end": 4762.46,
      "formatted_start": "01:19:11.120",
      "formatted_end": "01:19:22.460",
      "text": "جانم سلام"
    },
    {
      "id": 75,
      "start": 4762.46,
      "end": 4764.52,
      "formatted_start": "01:19:22.460",
      "formatted_end": "01:19:24.520",
      "text": "حالا چطوره؟"
    },
    {
      "id": 76,
      "start": 4764.52,
      "end": 4766.1,
      "formatted_start": "01:19:24.520",
      "formatted_end": "01:19:26.100",
      "text": "برگونه؟ ممنون"
    },
    {
      "id": 77,
      "start": 4766.1,
      "end": 4767.74,
      "formatted_start": "01:19:26.100",
      "formatted_end": "01:19:27.740",
      "text": "خواهش میکنم مرسی"
    },
    {
      "id": 78,
      "start": 4767.74,
      "end": 4769.26,
      "formatted_start": "01:19:27.740",
      "formatted_end": "01:19:29.260",
      "text": "آره"
    },
    {
      "id": 79,
      "start": 4769.26,
      "end": 4772.24,
      "formatted_start": "01:19:29.260",
      "formatted_end": "01:19:32.240",
      "text": "ببینی به من گفتش که من حتما"
    },
    {
      "id": 80,
      "start": 4772.24,
      "end": 4774.04,
      "formatted_start": "01:19:32.240",
      "formatted_end": "01:19:34.040",
      "text": "اونجور میام تا آخر وقتی"
    },
    {
      "id": 81,
      "start": 4774.04,
      "end": 4775.82,
      "formatted_start": "01:19:34.040",
      "formatted_end": "01:19:35.820",
      "text": "یه کار میکنه گفتش میام"
    },
    {
      "id": 82,
      "start": 4775.82,
      "end": 4777.84,
      "formatted_start": "01:19:35.820",
      "formatted_end": "01:19:37.840",
      "text": "این همون آقاییه که اومده بوده"
    },
    {
      "id": 83,
      "start": 4777.84,
      "end": 4779.42,
      "formatted_start": "01:19:37.840",
      "formatted_end": "01:19:39.420",
      "text": "با سایه جدید"
    },
    {
      "id": 84,
      "start": 4779.42,
      "end": 4782.66,
      "formatted_start": "01:19:39.420",
      "formatted_end": "01:19:42.660",
      "text": "برای آیه خالی خود"
    },
    {
      "id": 85,
      "start": 4782.66,
      "end": 4783.28,
      "formatted_start": "01:19:42.660",
      "formatted_end": "01:19:43.280",
      "text": "آره"
    },
    {
      "id": 86,
      "start": 4783.28,
      "end": 4786.18,
      "formatted_start": "01:19:43.280",
      "formatted_end": "01:19:46.180",
      "text": "بعد بعد این روز باید صحبت کردم"
    },
    {
      "id": 87,
      "start": 4786.18,
      "end": 4789.02,
      "formatted_start": "01:19:46.180",
      "formatted_end": "01:19:49.020",
      "text": "گفتم که آره مثلا ما اینطوری شده ساختمون"
    },
    {
      "id": 88,
      "start": 4789.02,
      "end": 4791.02,
      "formatted_start": "01:19:49.020",
      "formatted_end": "01:19:51.020",
      "text": "گفت ای بله به فقط اومدم"
    },
    {
      "id": 89,
      "start": 4791.02,
      "end": 4792.82,
      "formatted_start": "01:19:51.020",
      "formatted_end": "01:19:52.820",
      "text": "گفتم که شما اومده بودی"
    },
    {
      "id": 90,
      "start": 4792.82,
      "end": 4793.52,
      "formatted_start": "01:19:52.820",
      "formatted_end": "01:19:53.520",
      "text": "گفت آره"
    },
    {
      "id": 91,
      "start": 4793.52,
      "end": 4798.42,
      "formatted_start": "01:19:53.520",
      "formatted_end": "01:19:58.420",
      "text": "گفتش که بله حضرنه چسباش 20 ملی تومن بشده"
    },
    {
      "id": 92,
      "start": 4798.42,
      "end": 4800.02,
      "formatted_start": "01:19:58.420",
      "formatted_end": "01:20:00.020",
      "text": "من به دو جوری"
    }
  ],
  "status": "completed"
}