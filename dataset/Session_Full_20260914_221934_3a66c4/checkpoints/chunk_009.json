  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2710.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:10.000",
      "text": "خود راحت گیریش."
    },
    {
      "id": 1,
      "start": 2710.0,
      "end": 2716.0,
      "formatted_start": "00:45:10.000",
      "formatted_end": "00:45:16.000",
      "text": "اجانب در با دختر خوشگیره خوبی هستی."
    },
    {
      "id": 2,
      "start": 2716.0,
      "end": 2720.0,
      "formatted_start": "00:45:16.000",
      "formatted_end": "00:45:20.000",
      "text": "آزمایش هایی کدام ندیش رو بدم، دیگه کدام ندیش نمیخواد."
    },
    {
      "id": 3,
      "start": 2720.0,
      "end": 2722.0,
      "formatted_start": "00:45:20.000",
      "formatted_end": "00:45:22.000",
      "text": "نمیخواد کدام ندیش."
    },
    {
      "id": 4,
      "start": 2722.0,
      "end": 2726.0,
      "formatted_start": "00:45:22.000",
      "formatted_end": "00:45:26.000",
      "text": "خودشت درخواد سخت هستی، اتما سبر کنی."
    },
    {
      "id": 5,
      "start": 2726.0,
      "end": 2756.0,
      "formatted_start": "00:45:26.000",
      "formatted_end": "00:45:56.000",
      "text": "باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برد"
    },
    {
      "id": 6,
      "start": 2756.0,
      "end": 2786.0,
      "formatted_start": "00:45:56.000",
      "formatted_end": "00:46:26.000",
      "text": "خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیلی خیل"
    },
    {
      "id": 7,
      "start": 2786.0,
      "end": 2796.0,
      "formatted_start": "00:46:26.000",
      "formatted_end": "00:46:36.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 2816.0,
      "end": 2818.0,
      "formatted_start": "00:46:56.000",
      "formatted_end": "00:46:58.000",
      "text": "ایلا"
    },
    {
      "id": 9,
      "start": 2818.0,
      "end": 2820.0,
      "formatted_start": "00:46:58.000",
      "formatted_end": "00:47:00.000",
      "text": "ایلا، اسم خوشنگی داری"
    },
    {
      "id": 10,
      "start": 2820.0,
      "end": 2822.0,
      "formatted_start": "00:47:00.000",
      "formatted_end": "00:47:02.000",
      "text": "خب، شب ها بیشتر صرفه"
    },
    {
      "id": 11,
      "start": 2822.0,
      "end": 2824.0,
      "formatted_start": "00:47:02.000",
      "formatted_end": "00:47:04.000",
      "text": "ترم داره؟"
    },
    {
      "id": 12,
      "start": 2824.0,
      "end": 2826.0,
      "formatted_start": "00:47:04.000",
      "formatted_end": "00:47:06.000",
      "text": "تقریبا، یکی دو روز پیش داشت"
    },
    {
      "id": 13,
      "start": 2826.0,
      "end": 2828.0,
      "formatted_start": "00:47:06.000",
      "formatted_end": "00:47:08.000",
      "text": "قرار شدن، خب آبزش بینی داره"
    },
    {
      "id": 14,
      "start": 2828.0,
      "end": 2830.0,
      "formatted_start": "00:47:08.000",
      "formatted_end": "00:47:10.000",
      "text": "آره داره"
    },
    {
      "id": 15,
      "start": 2830.0,
      "end": 2832.0,
      "formatted_start": "00:47:10.000",
      "formatted_end": "00:47:12.000",
      "text": "چرک میادن؟"
    },
    {
      "id": 16,
      "start": 2832.0,
      "end": 2834.0,
      "formatted_start": "00:47:12.000",
      "formatted_end": "00:47:14.000",
      "text": "آره چرک داره"
    },
    {
      "id": 17,
      "start": 2834.0,
      "end": 2836.0,
      "formatted_start": "00:47:14.000",
      "formatted_end": "00:47:16.000",
      "text": "سینه شب این"
    },
    {
      "id": 18,
      "start": 2836.0,
      "end": 2838.0,
      "formatted_start": "00:47:16.000",
      "formatted_end": "00:47:18.000",
      "text": "پکرمون خیلی گرهت زد"
    },
    {
      "id": 19,
      "start": 2838.0,
      "end": 2840.0,
      "formatted_start": "00:47:18.000",
      "formatted_end": "00:47:20.000",
      "text": "نفس بکشت"
    },
    {
      "id": 20,
      "start": 2840.0,
      "end": 2842.0,
      "formatted_start": "00:47:20.000",
      "formatted_end": "00:47:22.000",
