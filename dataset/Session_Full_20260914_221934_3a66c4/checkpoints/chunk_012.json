  "stt_segments": [
    {
      "id": 0,
      "start": 3600.0,
      "end": 3602.0,
      "formatted_start": "01:00:00.000",
      "formatted_end": "01:00:02.000",
      "text": "با سیرتش درسته."
    },
    {
      "id": 1,
      "start": 3604.0,
      "end": 3609.0,
      "formatted_start": "01:00:04.000",
      "formatted_end": "01:00:09.000",
      "text": "تفاراش که بود امتدائش اینجا خونگی ادراش نارنجی بود."
    },
    {
      "id": 2,
      "start": 3609.0,
      "end": 3618.0,
      "formatted_start": "01:00:09.000",
      "formatted_end": "01:00:18.000",
      "text": "نارنجی بود. ببین وقتی بچه ادراش پرونگه یا لکه های نارنجی توش داره یعنی اینکه بچه کمشی خورده."
    },
    {
      "id": 3,
      "start": 3618.0,
      "end": 3623.0,
      "formatted_start": "01:00:18.000",
      "formatted_end": "01:00:23.000",
      "text": "یا جاش یرمه. این دشون دهنده اینکه بچه آب و بدنش کم."
    },
    {
      "id": 4,
      "start": 3623.0,
      "end": 3625.0,
      "formatted_start": "01:00:23.000",
      "formatted_end": "01:00:25.000",
      "text": "خب؟"
    },
    {
      "id": 5,
      "start": 3625.0,
      "end": 3627.0,
      "formatted_start": "01:00:25.000",
      "formatted_end": "01:00:27.000",
      "text": "چون همیشه نمی بود، بعضی موقع ها بود."
    },
    {
      "id": 6,
      "start": 3627.0,
      "end": 3629.0,
      "formatted_start": "01:00:27.000",
      "formatted_end": "01:00:29.000",
      "text": "آره"
    },
    {
      "id": 7,
      "start": 3629.0,
      "end": 3632.5,
      "formatted_start": "01:00:29.000",
      "formatted_end": "01:00:32.500",
      "text": "لباسهای خیلی مرد زیاد بکشونیش تو کنه"
    },
    {
      "id": 8,
      "start": 3632.5,
      "end": 3636.0,
      "formatted_start": "01:00:32.500",
      "formatted_end": "01:00:36.000",
      "text": "لباسها شنگر زیاد بشه، شیردلی برزیاد"
    },
    {
      "id": 9,
      "start": 3636.0,
      "end": 3638.0,
      "formatted_start": "01:00:36.000",
      "formatted_end": "01:00:38.000",
      "text": "خواهی شده"
    },
    {
      "id": 10,
      "start": 3638.0,
      "end": 3641.0,
      "formatted_start": "01:00:38.000",
      "formatted_end": "01:00:41.000",
      "text": "الان شده یک و فونصد رو شد"
    },
    {
      "id": 11,
      "start": 3641.0,
      "end": 3644.0,
      "formatted_start": "01:00:41.000",
      "formatted_end": "01:00:44.000",
      "text": "کنیم و تفرکوش"
    },
    {
      "id": 12,
      "start": 3644.0,
      "end": 3647.0,
      "formatted_start": "01:00:44.000",
      "formatted_end": "01:00:47.000",
      "text": "یعنی که این هسته، تو گفتیم یک و فونصد رو سردی"
    },
    {
      "id": 13,
      "start": 3647.0,
      "end": 3649.0,
      "formatted_start": "01:00:47.000",
      "formatted_end": "01:00:49.000",
      "text": "یا سه هست"
    },
    {
      "id": 14,
      "start": 3650.0,
      "end": 3652.0,
      "formatted_start": "01:00:50.000",
      "formatted_end": "01:00:52.000",
      "text": "دو شنده بگو"
    },
    {
      "id": 15,
      "start": 3652.0,
      "end": 3654.0,
      "formatted_start": "01:00:52.000",
      "formatted_end": "01:00:54.000",
      "text": "چنون همه هستی؟"
    },
    {
      "id": 16,
      "start": 3654.0,
      "end": 3656.0,
      "formatted_start": "01:00:54.000",
      "formatted_end": "01:00:56.000",
      "text": "دو شنده بگو تمام"
    },
    {
      "id": 17,
      "start": 3656.0,
      "end": 3658.0,
      "formatted_start": "01:00:56.000",
      "formatted_end": "01:00:58.000",
      "text": "خب"
    },
    {
      "id": 18,
      "start": 3660.0,
      "end": 3662.0,
      "formatted_start": "01:01:00.000",
      "formatted_end": "01:01:02.000",
      "text": "چیزی بوده؟"
    },
    {
      "id": 19,
      "start": 3664.0,
      "end": 3666.0,
      "formatted_start": "01:01:04.000",
      "formatted_end": "01:01:06.000",
      "text": "هر شیشه بگیر بخورده؟"
    },
    {
      "id": 20,
      "start": 3666.0,
      "end": 3668.0,
      "formatted_start": "01:01:06.000",
      "formatted_end": "01:01:08.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 3668.0,
      "end": 3670.0,
      "formatted_start": "01:01:08.000",
      "formatted_end": "01:01:10.000",
      "text": "نه، خب بگیر چون این مکینه هیچ خوبه؟"
    },
    {
      "id": 22,
      "start": 3670.0,
      "end": 3672.0,
      "formatted_start": "01:01:10.000",
      "formatted_end": "01:01:12.000",
      "text": "خب چند چیزی به شیر بزید؟"
    },
    {
      "id": 23,
      "start": 3672.0,
      "end": 3674.0,
      "formatted_start": "01:01:12.000",
      "formatted_end": "01:01:14.000",
      "text": "شیر یه شماره می دادم، از دیره زیر کم بیشتر بزید"
    },
    {
      "id": 24,
      "start": 3674.0,
      "end": 3676.0,
      "formatted_start": "01:01:14.000",
      "formatted_end": "01:01:16.000",
      "text": "بیشتر بزید؟"
    },
    {
      "id": 25,
      "start": 3676.0,
      "end": 3678.0,
      "formatted_start": "01:01:16.000",
      "formatted_end": "01:01:18.000",
      "text": "تو شماره درست کن هر چقدر شو خورد، خب؟"
    },
    {
      "id": 26,
      "start": 3678.0,
      "end": 3680.0,
      "formatted_start": "01:01:18.000",
      "formatted_end": "01:01:20.000",
      "text": "نه، هر چند چند شیر بزید؟"
    },
    {
      "id": 27,
      "start": 3680.0,
      "end": 3682.0,
      "formatted_start": "01:01:20.000",
      "formatted_end": "01:01:22.000",
      "text": "نه، هر چند چند شیر بزید؟"
    },
    {
      "id": 28,
      "start": 3682.0,
      "end": 3684.0,
      "formatted_start": "01:01:22.000",
      "formatted_end": "01:01:24.000",
      "text": "نه، هر چند چند شیر بزید؟"
    },
    {
      "id": 29,
      "start": 3684.0,
      "end": 3689.0,
      "formatted_start": "01:01:24.000",
      "formatted_end": "01:01:29.000",
      "text": "خب دیگه به هنجز ندادن در روی طبیعتی"
    },
    {
      "id": 30,
      "start": 3689.0,
      "end": 3692.0,
      "formatted_start": "01:01:29.000",
      "formatted_end": "01:01:32.000",
      "text": "مردات رای عاده با موتامین ایلا"
    },
    {
      "id": 31,
      "start": 3692.0,
      "end": 3697.0,
      "formatted_start": "01:01:32.000",
      "formatted_end": "01:01:37.000",
      "text": "آه اون هم که داری بشونید به قطعه عادش را برید داخل شیر خوش کشنج بدم"
    },
    {
      "id": 32,
      "start": 3697.0,
      "end": 3698.0,
      "formatted_start": "01:01:37.000",
      "formatted_end": "01:01:38.000",
      "text": "آره بیدید"
    },
    {
      "id": 33,
      "start": 3698.0,
      "end": 3699.0,
      "formatted_start": "01:01:38.000",
      "formatted_end": "01:01:39.000",
      "text": "آره"
    },
    {
      "id": 34,
      "start": 3699.0,
      "end": 3702.0,
      "formatted_start": "01:01:39.000",
      "formatted_end": "01:01:42.000",
      "text": "باید گرمیسورم خودم خارجی گرمیسورم مشکل نداری؟"
    },
    {
      "id": 35,
      "start": 3702.0,
      "end": 3704.0,
      "formatted_start": "01:01:42.000",
      "formatted_end": "01:01:44.000",
      "text": "گرمیسورم الان نباید بشنید"
    },
    {
      "id": 36,
      "start": 3704.0,
      "end": 3705.0,
      "formatted_start": "01:01:44.000",
      "formatted_end": "01:01:45.000",
      "text": "خب"
    },
    {
      "id": 37,
      "start": 3706.0,
      "end": 3709.0,
      "formatted_start": "01:01:46.000",
      "formatted_end": "01:01:49.000",
      "text": "نه از چی کار نمی کنید دو روزی با؟"
    },
    {
      "id": 38,
      "start": 3709.0,
      "end": 3711.0,
      "formatted_start": "01:01:49.000",
      "formatted_end": "01:01:51.000",
      "text": "به خطر شیر خوش کشنج"
    },
    {
      "id": 39,
      "start": 3711.0,
      "end": 3715.0,
      "formatted_start": "01:01:51.000",
      "formatted_end": "01:01:55.000",
      "text": "خب بعد از اینکه دو روزی باید پاریشان شده"
    },
    {
      "id": 40,
      "start": 3715.0,
      "end": 3718.0,
      "formatted_start": "01:01:55.000",
      "formatted_end": "01:01:58.000",
      "text": "یعنی اینکه مثلا دل کننده و سفته"
    },
    {
      "id": 41,
      "start": 3718.0,
      "end": 3721.0,
      "formatted_start": "01:01:58.000",
      "formatted_end": "01:02:01.000",
      "text": "سفت نیست این گلویه زرد داره"
    },
    {
      "id": 42,
      "start": 3721.0,
      "end": 3724.0,
      "formatted_start": "01:02:01.000",
      "formatted_end": "01:02:04.000",
      "text": "ببین ببین بازان راحت میادی"
    },
    {
      "id": 43,
      "start": 3724.0,
      "end": 3729.0,
      "formatted_start": "01:02:04.000",
      "formatted_end": "01:02:09.000",
      "text": "ببین بچه که شیر خوش میخوره حتی مکره هر یه هفته یه هفته کام نماشه"
    },
    {
      "id": 44,
      "start": 3729.0,
      "end": 3730.0,
      "formatted_start": "01:02:09.000",
      "formatted_end": "01:02:10.000",
      "text": "تو با چه هفته گم شیر خوش میخوره؟"
    },
    {
      "id": 45,
      "start": 3730.0,
      "end": 3734.0,
      "formatted_start": "01:02:10.000",
      "formatted_end": "01:02:14.000",
      "text": "اشکار نداره خب بعد ببین نه آخه پراه ها اینجوری هستن"
    },
    {
      "id": 46,
      "start": 3734.0,
      "end": 3736.0,
      "formatted_start": "01:02:14.000",
      "formatted_end": "01:02:16.000",
      "text": "پراه ها یکم شکم سر میکنن"
    },
    {
      "id": 47,
      "start": 3736.0,
      "end": 3739.0,
      "formatted_start": "01:02:16.000",
      "formatted_end": "01:02:19.000",
      "text": "هر روز شکم کنید، اینجوری ماساج بدید."
    },
    {
      "id": 48,
      "start": 3739.0,
      "end": 3742.0,
      "formatted_start": "01:02:19.000",
      "formatted_end": "01:02:22.000",
      "text": "خب، بعد بدنی که مشتش بهترین بشه،"
    },
    {
      "id": 49,
      "start": 3742.0,
      "end": 3745.0,
      "formatted_start": "01:02:22.000",
      "formatted_end": "01:02:25.000",
      "text": "بعدی که بچه هست، مشتشی که بگذاره،"
    },
    {
      "id": 50,
      "start": 3745.0,
      "end": 3748.0,
      "formatted_start": "01:02:25.000",
      "formatted_end": "01:02:28.000",
      "text": "روز یک ایلا دو گل ماساجش میده."
    },
    {
      "id": 51,
      "start": 3748.0,
      "end": 3753.0,
      "formatted_start": "01:02:28.000",
      "formatted_end": "01:02:33.000",
      "text": "خب، دست بذار با روغن رتون یا روغن بچه،"
    },
    {
      "id": 52,
      "start": 3753.0,
      "end": 3757.0,
      "formatted_start": "01:02:33.000",
      "formatted_end": "01:02:37.000",
      "text": "چرپین کنه داشت، خب، اینجوری، اینجوری،"
    },
    {
      "id": 53,
      "start": 3757.0,
      "end": 3759.0,
      "formatted_start": "01:02:37.000",
      "formatted_end": "01:02:39.000",
      "text": "پد به پاش ماساج میدید،"
    },
    {
      "id": 54,
      "start": 3759.0,
      "end": 3762.0,
      "formatted_start": "01:02:39.000",
      "formatted_end": "01:02:42.000",
      "text": "لای اندوشتای پاشا ماساج میدید،"
    },
    {
      "id": 55,
      "start": 3762.0,
      "end": 3778.0,
      "formatted_start": "01:02:42.000",
      "formatted_end": "01:02:58.000",
      "text": "بعد می آیی روی پشت، پشت پشت، رونش، پشت رونش، شکمش در جهت اهمومه ساعت، اینجوری ماساج می دید"
    },
    {
      "id": 56,
      "start": 3778.0,
      "end": 3790.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:10.000",
      "text": "بعد می دهی پشت و تقلاتشان، از بالا تا اینجوری، روی تن لبکه، نه روی لباس، اینجوری از بالا تا خواهیم ماساج می دید"
    },
    {
      "id": 57,
      "start": 3790.0,
      "end": 3793.44,
      "formatted_start": "01:03:10.000",
      "formatted_end": "01:03:13.440",
      "text": "بعد اینجا روپاش رو مساج بدید"
    },
    {
      "id": 58,
      "start": 3793.44,
      "end": 3798.06,
      "formatted_start": "01:03:13.440",
      "formatted_end": "01:03:18.060",
      "text": "و آخرش رو دیده سرش رو از مایی بکنید"
    },
    {
      "id": 59,
      "start": 3798.06,
      "end": 3803.76,
      "formatted_start": "01:03:18.060",
      "formatted_end": "01:03:23.760",
      "text": "این باعث میشه که بچه تکاملش بهتر میشه"
    },
    {
      "id": 60,
      "start": 3803.76,
      "end": 3806.2,
      "formatted_start": "01:03:23.760",
      "formatted_end": "01:03:26.200",
      "text": "یعنی زودتر وضع نگیره"
    },
    {
      "id": 61,
      "start": 3806.2,
      "end": 3808.28,
      "formatted_start": "01:03:26.200",
      "formatted_end": "01:03:28.280",
      "text": "زودتر دست و پا بزنه"
    },
    {
      "id": 62,
      "start": 3808.28,
      "end": 3809.8,
      "formatted_start": "01:03:28.280",
      "formatted_end": "01:03:29.800",
      "text": "زودتر قط بزنه"
    },
    {
      "id": 63,
      "start": 3809.8,
      "end": 3811.6,
      "formatted_start": "01:03:29.800",
      "formatted_end": "01:03:31.600",
      "text": "گردنش رو خوبتر بگیره"
    },
    {
      "id": 64,
      "start": 3811.6,
      "end": 3814.9,
      "formatted_start": "01:03:31.600",
      "formatted_end": "01:03:34.900",
      "text": "سلولای نقضش با این بیشتر میشه"
    },
    {
      "id": 65,
      "start": 3814.9,
      "end": 3815.28,
      "formatted_start": "01:03:34.900",
      "formatted_end": "01:03:35.280",
      "text": "خب؟"
    },
    {
      "id": 66,
      "start": 3815.28,
      "end": 3817.8,
      "formatted_start": "01:03:35.280",
      "formatted_end": "01:03:37.800",
      "text": "پس مساج رو هر روز و روش انجام بده"
    },
    {
      "id": 67,
      "start": 3817.8,
      "end": 3826.2,
      "formatted_start": "01:03:37.800",
      "formatted_end": "01:03:46.200",
      "text": "ایران هم خود روشون که از بردگیریش بهتر بوده، شیر خشکشو بیشتر داده، اشخال نداره، اضافه شو بردم بیرون"
    },
    {
      "id": 68,
      "start": 3826.2,
      "end": 3829.2,
      "formatted_start": "01:03:46.200",
      "formatted_end": "01:03:49.200",
      "text": "بیشتر بشه بده، بزار بردگیریش خوری کشید"
    },
    {
      "id": 69,
      "start": 3829.2,
      "end": 3831.0,
      "formatted_start": "01:03:49.200",
      "formatted_end": "01:03:51.000",
      "text": "که آروم همسه میده"
    },
    {
      "id": 70,
      "start": 3831.0,
      "end": 3836.2,
      "formatted_start": "01:03:51.000",
      "formatted_end": "01:03:56.200",
      "text": "خب، به حاله کمزاری شو گرده، از میدهش به اینقدر، این میده اینقدر کجوری میتونه آروم بده"
    },
    {
      "id": 71,
      "start": 3836.2,
      "end": 3839.6,
      "formatted_start": "01:03:56.200",
      "formatted_end": "01:03:59.600",
      "text": "کم کم که بزرگتر باشه آروم همیتره"
    },
    {
      "id": 72,
      "start": 3839.6,
      "end": 3843.36,
      "formatted_start": "01:03:59.600",
      "formatted_end": "01:04:03.360",
      "text": "و اگر شیرش مشکل داره، باید برمینه بده"
    },
    {
      "id": 73,
      "start": 3843.36,
      "end": 3845.04,
      "formatted_start": "01:04:03.360",
      "formatted_end": "01:04:05.040",
      "text": "نه، پره آبتامیل که خوبه"
    },
    {
      "id": 74,
      "start": 3845.04,
      "end": 3845.84,
      "formatted_start": "01:04:05.040",
      "formatted_end": "01:04:05.840",
      "text": "ها؟"
    },
    {
      "id": 75,
      "start": 3845.84,
      "end": 3850.16,
      "formatted_start": "01:04:05.840",
      "formatted_end": "01:04:10.160",
      "text": "پره آبتامیل بده، ولی اگر که شیر خشکش داره"
    },
    {
      "id": 76,
      "start": 3850.16,
      "end": 3854.8,
      "formatted_start": "01:04:10.160",
      "formatted_end": "01:04:14.800",
      "text": "مثلا، دیدی خیلی دیگه مثلا هفته به هفته شگرمش کار نمی کنه"
    },
    {
      "id": 77,
      "start": 3854.8,
      "end": 3857.4,
      "formatted_start": "01:04:14.800",
      "formatted_end": "01:04:17.400",
      "text": "به جای پره آبتامیل تریکی گز بده"
    },
    {
      "id": 78,
      "start": 3857.4,
      "end": 3858.0,
      "formatted_start": "01:04:17.400",
      "formatted_end": "01:04:18.000",
      "text": "ها؟"
    },
    {
      "id": 79,
      "start": 3858.0,
      "end": 3859.44,
      "formatted_start": "01:04:18.000",
      "formatted_end": "01:04:19.440",
      "text": "تا وقت جسمش بزرگ هستم"
    },
    {
      "id": 80,
      "start": 3859.44,
      "end": 3860.2,
      "formatted_start": "01:04:19.440",
      "formatted_end": "01:04:20.200",
      "text": "باش"
    },
    {
      "id": 81,
      "start": 3862.4,
      "end": 3866.24,
      "formatted_start": "01:04:22.400",
      "formatted_end": "01:04:26.240",
      "text": "و بعد پره آبتامیل رو فر یک و هفتصد بدن باید مشکل شدن؟"
    },
    {
      "id": 82,
      "start": 3866.84,
      "end": 3868.4,
      "formatted_start": "01:04:26.840",
      "formatted_end": "01:04:28.400",
      "text": "تا وقتی که دوتیر شد"
    },
    {
      "id": 83,
      "start": 3868.4,
      "end": 3870.4,
      "formatted_start": "01:04:28.400",
      "formatted_end": "01:04:30.400",
      "text": "آمان"
    },
    {
      "id": 84,
      "start": 3872.4,
      "end": 3874.4,
      "formatted_start": "01:04:32.400",
      "formatted_end": "01:04:34.400",
      "text": "خب اسمشو چی گذاشتی؟"
    },
    {
      "id": 85,
      "start": 3874.4,
      "end": 3876.4,
      "formatted_start": "01:04:34.400",
      "formatted_end": "01:04:36.400",
      "text": "میکرو بردیم"
    },
    {
      "id": 86,
      "start": 3876.4,
      "end": 3878.4,
      "formatted_start": "01:04:36.400",
      "formatted_end": "01:04:38.400",
      "text": "میکرو بردیم"
    },
    {
      "id": 87,
      "start": 3878.4,
      "end": 3880.4,
      "formatted_start": "01:04:38.400",
      "formatted_end": "01:04:40.400",
      "text": "خب بردی برای ماینه چشمو اینا؟"
    },
    {
      "id": 88,
      "start": 3880.4,
      "end": 3882.4,
      "formatted_start": "01:04:40.400",
      "formatted_end": "01:04:42.400",
      "text": "آمان بردیم"
    },
    {
      "id": 89,
      "start": 3882.4,
      "end": 3884.4,
      "formatted_start": "01:04:42.400",
      "formatted_end": "01:04:44.400",
      "text": "آمان بالا بوده؟"
    },
    {
      "id": 90,
      "start": 3884.4,
      "end": 3886.4,
      "formatted_start": "01:04:44.400",
      "formatted_end": "01:04:46.400",
      "text": "آمان بردیم"
    },
    {
      "id": 91,
      "start": 3886.4,
      "end": 3888.4,
      "formatted_start": "01:04:46.400",
      "formatted_end": "01:04:48.400",
      "text": "خب باید چشاشو نور نکره ها؟"
    },
    {
      "id": 92,
      "start": 3888.4,
      "end": 3890.4,
      "formatted_start": "01:04:48.400",
      "formatted_end": "01:04:50.400",
      "text": "نور نکره"
    },
    {
      "id": 93,
      "start": 3890.4,
      "end": 3892.4,
      "formatted_start": "01:04:50.400",
      "formatted_end": "01:04:52.400",
      "text": "مگه قطعه نریست تو چشش؟"
    },
    {
      "id": 94,
      "start": 3892.4,
      "end": 3894.4,
      "formatted_start": "01:04:52.400",
      "formatted_end": "01:04:54.400",
      "text": "نور نکره"
    },
    {
      "id": 95,
      "start": 3894.4,
      "end": 3896.4,
      "formatted_start": "01:04:54.400",
      "formatted_end": "01:04:56.400",
      "text": "خب باید تا چند ساعت نور به چشش نکره"
    },
    {
      "id": 96,
      "start": 3896.4,
      "end": 3898.4,
      "formatted_start": "01:04:56.400",
      "formatted_end": "01:04:58.400",
      "text": "چشم"
    }
  ],
  "status": "completed"
}