  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3302.0,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:02.000",
      "text": "اینجا باید بردردشو کاملا تنظیم کنید."
    },
    {
      "id": 1,
      "start": 3302.0,
      "end": 3304.0,
      "formatted_start": "00:55:02.000",
      "formatted_end": "00:55:04.000",
      "text": "فقط این چیزی که باید بهش بدید، درست دارید."
    },
    {
      "id": 2,
      "start": 3304.0,
      "end": 3306.0,
      "formatted_start": "00:55:04.000",
      "formatted_end": "00:55:06.000",
      "text": "بهش بیتامین دی باید بدید."
    },
    {
      "id": 3,
      "start": 3306.0,
      "end": 3308.0,
      "formatted_start": "00:55:06.000",
      "formatted_end": "00:55:08.000",
      "text": "باید این دردشو کاملا درد کنید."
    },
    {
      "id": 4,
      "start": 3308.0,
      "end": 3310.0,
      "formatted_start": "00:55:08.000",
      "formatted_end": "00:55:10.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 5,
      "start": 3310.0,
      "end": 3312.0,
      "formatted_start": "00:55:10.000",
      "formatted_end": "00:55:12.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 6,
      "start": 3312.0,
      "end": 3314.0,
      "formatted_start": "00:55:12.000",
      "formatted_end": "00:55:14.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 7,
      "start": 3314.0,
      "end": 3316.0,
      "formatted_start": "00:55:14.000",
      "formatted_end": "00:55:16.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 8,
      "start": 3316.0,
      "end": 3318.0,
      "formatted_start": "00:55:16.000",
      "formatted_end": "00:55:18.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 9,
      "start": 3318.0,
      "end": 3320.0,
      "formatted_start": "00:55:18.000",
      "formatted_end": "00:55:20.000",
      "text": "این دردشو کاملا درد کنید."
    },
    {
      "id": 10,
      "start": 3320.0,
      "end": 3322.0,
      "formatted_start": "00:55:20.000",
      "formatted_end": "00:55:22.000",
      "text": "این رو باست کنید"
    },
    {
      "id": 11,
      "start": 3322.0,
      "end": 3324.0,
      "formatted_start": "00:55:22.000",
      "formatted_end": "00:55:24.000",
      "text": "کچی کچی آره"
    },
    {
      "id": 12,
      "start": 3324.0,
      "end": 3326.0,
      "formatted_start": "00:55:24.000",
      "formatted_end": "00:55:26.000",
      "text": "بهش بدید"
    },
    {
      "id": 13,
      "start": 3326.0,
      "end": 3328.0,
      "formatted_start": "00:55:26.000",
      "formatted_end": "00:55:28.000",
      "text": "از اون قطره یک سری قطره دارید"
    },
    {
      "id": 14,
      "start": 3328.0,
      "end": 3330.0,
      "formatted_start": "00:55:28.000",
      "formatted_end": "00:55:30.000",
      "text": "که نیم بیلی برده بشید"
    },
    {
      "id": 15,
      "start": 3330.0,
      "end": 3332.0,
      "formatted_start": "00:55:30.000",
      "formatted_end": "00:55:32.000",
      "text": "برده این رو باید بشید"
    },
    {
      "id": 16,
      "start": 3332.0,
      "end": 3334.0,
      "formatted_start": "00:55:32.000",
      "formatted_end": "00:55:34.000",
      "text": "هم شرکیه دیگه"
    },
    {
      "id": 17,
      "start": 3334.0,
      "end": 3336.0,
      "formatted_start": "00:55:34.000",
      "formatted_end": "00:55:36.000",
      "text": "آه همونه"
    },
    {
      "id": 18,
      "start": 3336.0,
      "end": 3338.0,
      "formatted_start": "00:55:36.000",
      "formatted_end": "00:55:38.000",
      "text": "این قطره رو"
    },
    {
      "id": 19,
      "start": 3338.0,
      "end": 3340.0,
      "formatted_start": "00:55:38.000",
      "formatted_end": "00:55:40.000",
      "text": "چیزهایی بدنش مثل این سبم"
    },
    {
      "id": 20,
      "start": 3340.0,
      "end": 3342.0,
      "formatted_start": "00:55:40.000",
      "formatted_end": "00:55:42.000",
      "text": "الان سال سلوزش"
    },
    {
      "id": 21,
      "start": 3342.0,
      "end": 3344.0,
      "formatted_start": "00:55:42.000",
      "formatted_end": "00:55:44.000",
      "text": "گرفتم خوب بشیدن"
    },
    {
      "id": 22,
      "start": 3344.0,
      "end": 3346.0,
      "formatted_start": "00:55:44.000",
      "formatted_end": "00:55:46.000",
      "text": "زرن که نبوده بشید"
    },
    {
      "id": 23,
      "start": 3346.0,
      "end": 3348.0,
      "formatted_start": "00:55:46.000",
      "formatted_end": "00:55:48.000",
      "text": "خوب خوب خوب خوب"
    },
    {
      "id": 24,
      "start": 3348.0,
      "end": 3350.0,
      "formatted_start": "00:55:48.000",
      "formatted_end": "00:55:50.000",
      "text": "سه هزار واحد براشنشن"
    },
    {
      "id": 25,
      "start": 3350.0,
      "end": 3352.0,
      "formatted_start": "00:55:50.000",
      "formatted_end": "00:55:52.000",
      "text": "خب"
    },
    {
      "id": 26,
      "start": 3352.0,
      "end": 3354.0,
      "formatted_start": "00:55:52.000",
      "formatted_end": "00:55:54.000",
      "text": "اینو روزی"
    },
    {
