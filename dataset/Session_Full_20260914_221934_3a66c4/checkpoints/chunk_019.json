  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5709.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:09.000",
      "text": "اینجور برنوشتن نداشت. تو گلوک. آره. هیچکی نداشت. آخه بابا تو دلتون که نمیشه موافق باشین. خب؟"
    },
    {
      "id": 1,
      "start": 5709.0,
      "end": 5719.0,
      "formatted_start": "01:35:09.000",
      "formatted_end": "01:35:19.000",
      "text": "میدونین من اومدن نوشتم. چون آقای دوستان خودش مثلا حرف دست. گفتش که مثلا الان شما میگید ایزاگام اینجوریه. من رفتم بالا رو دیدم."
    },
    {
      "id": 2,
      "start": 5719.0,
      "end": 5729.0,
      "formatted_start": "01:35:19.000",
      "formatted_end": "01:35:29.000",
      "text": "مثلا رفتم کلر نفت بکنم. اومدن کنده شده. ایزاگام منو کندن. گفت من باید از که خصوصیت این رو بگیرم. خب؟"
    },
    {
      "id": 3,
      "start": 5729.0,
      "end": 5736.24,
      "formatted_start": "01:35:29.000",
      "formatted_end": "01:35:36.240",
      "text": "من الان میگه بکنم آخری مریضم رو بردم"
    },
    {
      "id": 4,
      "start": 5736.24,
      "end": 5746.0,
      "formatted_start": "01:35:36.240",
      "formatted_end": "01:35:46.000",
      "text": "باشه باشه عزیزم باشه"
    },
    {
      "id": 5,
      "start": 5759.0,
      "end": 5763.8,
      "formatted_start": "01:35:59.000",
      "formatted_end": "01:36:03.800",
      "text": "نه اصلا به نظر من اینو به دلتون این رینا باید بگیم"
    },
    {
      "id": 6,
      "start": 5763.8,
      "end": 5766.4,
      "formatted_start": "01:36:03.800",
      "formatted_end": "01:36:06.400",
      "text": "آره اول خودمون باید بهش ما بگیم"
    },
    {
      "id": 7,
      "start": 5766.4,
      "end": 5768.64,
      "formatted_start": "01:36:06.400",
      "formatted_end": "01:36:08.640",
      "text": "آره"
    },
    {
      "id": 8,
      "start": 5768.64,
      "end": 5774.94,
      "formatted_start": "01:36:08.640",
      "formatted_end": "01:36:14.940",
      "text": "آه همینو بگو بردشم که شاید دردی از من کلیبیش دادم"
    },
    {
      "id": 9,
      "start": 5774.94,
      "end": 5785.22,
      "formatted_start": "01:36:14.940",
      "formatted_end": "01:36:25.220",
      "text": "آره آره"
    },
    {
      "id": 10,
      "start": 5789.0,
      "end": 5809.0,
      "formatted_start": "01:36:29.000",
      "formatted_end": "01:36:49.000",
      "text": "مردم از این مردم را باید برداریم."
    },
    {
      "id": 11,
      "start": 5809.0,
      "end": 5813.98,
      "formatted_start": "01:36:49.000",
      "formatted_end": "01:36:53.980",
      "text": "ببین عزیزم من الان این یه مرز آخرم ببینم"
    },
    {
      "id": 12,
      "start": 5813.98,
      "end": 5815.26,
      "formatted_start": "01:36:53.980",
      "formatted_end": "01:36:55.260",
      "text": "باید برم میمارشتم"
    },
    {
      "id": 13,
      "start": 5815.26,
      "end": 5817.04,
      "formatted_start": "01:36:55.260",
      "formatted_end": "01:36:57.040",
      "text": "خب"
    },
    {
      "id": 14,
      "start": 5817.04,
      "end": 5822.18,
      "formatted_start": "01:36:57.040",
      "formatted_end": "01:37:02.180",
      "text": "میخوایی بذاریم یه موقعی دیگه یادو"
    },
    {
      "id": 15,
      "start": 5822.18,
      "end": 5823.04,
      "formatted_start": "01:37:02.180",
      "formatted_end": "01:37:03.040",
      "text": "شما خوبه ببینید"
    },
    {
      "id": 16,
      "start": 5823.04,
      "end": 5825.44,
      "formatted_start": "01:37:03.040",
      "formatted_end": "01:37:05.440",
      "text": "افنی شما با خودت با دوست قجب زدن بید"
    },
    {
      "id": 17,
      "start": 5825.44,
      "end": 5826.48,
      "formatted_start": "01:37:05.440",
      "formatted_end": "01:37:06.480",
      "text": "تماس بگید"
    },
    {
      "id": 18,
      "start": 5826.48,
      "end": 5827.98,
      "formatted_start": "01:37:06.480",
      "formatted_end": "01:37:07.980",
      "text": "آره بهش بگو"
    },
    {
      "id": 19,
      "start": 5827.98,
      "end": 5830.86,
      "formatted_start": "01:37:07.980",
      "formatted_end": "01:37:10.860",
      "text": "نظرشون رو برم بگید"
    },
    {
      "id": 20,
      "start": 5830.86,
      "end": 5832.28,
      "formatted_start": "01:37:10.860",
      "formatted_end": "01:37:12.280",
      "text": "باشه عزیزم"
    },
    {
      "id": 21,
      "start": 5832.28,
      "end": 5834.46,
      "formatted_start": "01:37:12.280",
      "formatted_end": "01:37:14.460",
      "text": "من موافقم"
    },
    {
      "id": 22,
      "start": 5834.46,
      "end": 5835.72,
      "formatted_start": "01:37:14.460",
      "formatted_end": "01:37:15.720",
      "text": "آره من موافقم"
    },
    {
      "id": 23,
      "start": 5835.72,
      "end": 5839.66,
      "formatted_start": "01:37:15.720",
      "formatted_end": "01:37:19.660",
      "text": "من هر جوری که کار همه را بیافته معافقم"
    },
    {
      "id": 24,
      "start": 5839.66,
      "end": 5845.64,
      "formatted_start": "01:37:19.660",
      "formatted_end": "01:37:25.640",
      "text": "آره آره خوب این بار بخواییم"
    },
    {
      "id": 25,
      "start": 5845.64,
      "end": 5850.02,
      "formatted_start": "01:37:25.640",
      "formatted_end": "01:37:30.020",
      "text": "آره آره دقیقا دقیقا دقیقا"
    },
    {
      "id": 26,
      "start": 5850.02,
      "end": 5851.72,
      "formatted_start": "01:37:30.020",
      "formatted_end": "01:37:31.720",
      "text": "آره عزیزم باشیم"
    },
    {
      "id": 27,
      "start": 5854.98,
      "end": 5856.28,
      "formatted_start": "01:37:34.980",
      "formatted_end": "01:37:36.280",
      "text": "خیلی خوب"
    },
    {
      "id": 28,
      "start": 5856.28,
      "end": 5865.22,
      "formatted_start": "01:37:36.280",
      "formatted_end": "01:37:45.220",
      "text": "آره آره"
    },
    {
      "id": 29,
      "start": 5865.72,
      "end": 5874.68,
      "formatted_start": "01:37:45.720",
      "formatted_end": "01:37:54.680",
      "text": "باشه آره عزیزم باشه باشه حتما حتما قرمونت برم مرسی خدافز باشه خدافز خدافز"
    },
    {
      "id": 30,
      "start": 5895.72,
      "end": 5905.72,
