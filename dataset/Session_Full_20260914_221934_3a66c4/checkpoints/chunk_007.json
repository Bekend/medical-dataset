  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2108.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:08.000",
      "text": "داروها رو دارن، روز آخر دقیقا همون پنج رنبش اینها بود، کامدوکرا اصحابشون شد خونه."
    },
    {
      "id": 1,
      "start": 2108.0,
      "end": 2118.0,
      "formatted_start": "00:35:08.000",
      "formatted_end": "00:35:18.000",
      "text": "آره، شد خونه من آوردم بیمارستان، همین تارگانی دیگه خیلی ترسیدم با اینکه دارویان هم میدادن و میخوردن قضاهمون کامدوکرا و همین میخوردن و میرفتن سرویست."
    },
    {
      "id": 2,
      "start": 2118.0,
      "end": 2127.0,
      "formatted_start": "00:35:18.000",
      "formatted_end": "00:35:27.000",
      "text": "آوردم اینجا گفتن چیزی نیست، سرام بهشون دادن، اونه نمیدونم دارو زدن، به من میتفاون دازور داد، آوردم خونه بعد از اون بهتر شدن"
    },
    {
      "id": 3,
      "start": 2127.0,
      "end": 2134.0,
      "formatted_start": "00:35:27.000",
      "formatted_end": "00:35:34.000",
      "text": "دیگه اصحال آروم آروم کم شد، اون خونه یکی دو بار مثلا بعدش مثلا اتفاق افتاد تموم شد"
    },
    {
      "id": 4,
      "start": 2134.0,
      "end": 2144.0,
      "formatted_start": "00:35:34.000",
      "formatted_end": "00:35:44.000",
      "text": "دوبار خانم دکتور تا دیروز پریروز، دیروز پریروز، احنا خانم دکتور اصحال نیست دا چکمش کار میکنه، یکم یعنی صفته خودش میگه"
    },
    {
      "id": 5,
      "start": 2144.0,
      "end": 2146.0,
      "formatted_start": "00:35:44.000",
      "formatted_end": "00:35:46.000",
      "text": "دوباره خون"
    },
    {
      "id": 6,
      "start": 2146.0,
      "end": 2149.0,
      "formatted_start": "00:35:46.000",
      "formatted_end": "00:35:49.000",
      "text": "بعد انگار که ببخشید دستتو بریده باشی"
    },
    {
      "id": 7,
      "start": 2149.0,
      "end": 2152.0,
      "formatted_start": "00:35:49.000",
      "formatted_end": "00:35:52.000",
      "text": "قشن اینجوری خون میریزه"
    },
    {
      "id": 8,
      "start": 2152.0,
      "end": 2156.0,
      "formatted_start": "00:35:52.000",
      "formatted_end": "00:35:56.000",
      "text": "بعد داخلش حتی انگار زخته باشه"
    },
    {
      "id": 9,
      "start": 2156.0,
      "end": 2158.0,
      "formatted_start": "00:35:56.000",
      "formatted_end": "00:35:58.000",
      "text": "اونجوری هم هست"
    },
    {
      "id": 10,
      "start": 2158.0,
      "end": 2160.0,
      "formatted_start": "00:35:58.000",
      "formatted_end": "00:36:00.000",
      "text": "و خودش میگه درد میگیره"
    },
    {
      "id": 11,
      "start": 2160.0,
      "end": 2162.0,
      "formatted_start": "00:36:00.000",
      "formatted_end": "00:36:02.000",
      "text": "این زخته نیست هیچی"
    },
    {
      "id": 12,
      "start": 2162.0,
      "end": 2164.0,
      "formatted_start": "00:36:02.000",
      "formatted_end": "00:36:04.000",
      "text": "خاند بود که قسمت شکرمش اینجوری هست"
    },
    {
      "id": 13,
      "start": 2164.0,
      "end": 2166.0,
      "formatted_start": "00:36:04.000",
      "formatted_end": "00:36:06.000",
      "text": "همین همونیه که قولش"
    },
    {
      "id": 14,
      "start": 2166.0,
      "end": 2168.0,
      "formatted_start": "00:36:06.000",
      "formatted_end": "00:36:08.000",
      "text": "یه دو روز خوبه"
    },
    {
      "id": 15,
      "start": 2168.0,
      "end": 2169.0,
      "formatted_start": "00:36:08.000",
      "formatted_end": "00:36:09.000",
      "text": "بله"
    },
    {
      "id": 16,
      "start": 2169.0,
      "end": 2172.0,
      "formatted_start": "00:36:09.000",
      "formatted_end": "00:36:12.000",
      "text": "آمان جامعه اونگه شیشه بیتمی دیدمشو دوباره مجازم خوش آردی باشه"
    },
    {
      "id": 17,
      "start": 2172.0,
      "end": 2174.0,
      "formatted_start": "00:36:12.000",
      "formatted_end": "00:36:14.000",
      "text": "اونو همیشه یه باز بخواهید"
    },
    {
      "id": 18,
      "start": 2174.0,
      "end": 2176.0,
      "formatted_start": "00:36:14.000",
      "formatted_end": "00:36:16.000",
      "text": "شکنش"
    },
    {
      "id": 19,
      "start": 2176.0,
      "end": 2178.0,
      "formatted_start": "00:36:16.000",
      "formatted_end": "00:36:18.000",
      "text": "مثلا تغذیهش"
    },
    {
      "id": 20,
      "start": 2178.0,
      "end": 2180.0,
      "formatted_start": "00:36:18.000",
      "formatted_end": "00:36:20.000",
      "text": "میبه بخواهید اصلا کلان احل میبه"
    },
    {
      "id": 21,
      "start": 2180.0,
      "end": 2182.0,
      "formatted_start": "00:36:20.000",
      "formatted_end": "00:36:22.000",
      "text": "هر چی باشید نیست"
    },
    {
      "id": 22,
      "start": 2182.0,
      "end": 2184.0,
      "formatted_start": "00:36:22.000",
      "formatted_end": "00:36:24.000",
      "text": "نیست زیاد نمیخورن"
    },
    {
      "id": 23,
      "start": 2184.0,
      "end": 2186.0,
      "formatted_start": "00:36:24.000",
      "formatted_end": "00:36:26.000",
      "text": "برنجم بگیر ماما من سفید میخوام"
    },
    {
      "id": 24,
      "start": 2186.0,
      "end": 2188.0,
      "formatted_start": "00:36:26.000",
      "formatted_end": "00:36:28.000",
      "text": "هر چی خونش درست میکنم"
    },
    {
      "id": 25,
      "start": 2188.0,
      "end": 2190.0,
      "formatted_start": "00:36:28.000",
      "formatted_end": "00:36:30.000",
      "text": "صبح درست میکنم ماما این که قضان است"
    },
    {
      "id": 26,
      "start": 2190.0,
      "end": 2192.0,
      "formatted_start": "00:36:30.000",
      "formatted_end": "00:36:32.000",
      "text": "بد قضانم خیلی"
    },
    {
      "id": 27,
      "start": 2192.0,
      "end": 2194.0,
      "formatted_start": "00:36:32.000",
      "formatted_end": "00:36:34.000",
      "text": "یعنی قبل از این که ازحال بشه"
    },
    {
      "id": 28,
      "start": 2194.0,
      "end": 2196.0,
      "formatted_start": "00:36:34.000",
      "formatted_end": "00:36:36.000",
      "text": "یه روزت داشت"
    },
    {
      "id": 29,
      "start": 2196.0,
      "end": 2198.0,
      "formatted_start": "00:36:36.000",
      "formatted_end": "00:36:38.000",
      "text": "از قبلم؟ آره"
    },
    {
      "id": 30,
      "start": 2198.0,
      "end": 2202.5,
      "formatted_start": "00:36:38.000",
      "formatted_end": "00:36:42.500",
      "text": "این گلش که خیلی چیزه این باز بهتر از اون بود"
    },
    {
      "id": 31,
      "start": 2202.5,
      "end": 2206.72,
      "formatted_start": "00:36:42.500",
      "formatted_end": "00:36:46.720",
      "text": "من همچنین انتظار داشتم اون مشکله مثلا اینجوری چیز زده"
    },
    {
      "id": 32,
      "start": 2206.72,
      "end": 2208.98,
      "formatted_start": "00:36:46.720",
      "formatted_end": "00:36:48.980",
      "text": "چون از قبل داشت اون خاندوتو"
    },
    {
      "id": 33,
      "start": 2208.98,
      "end": 2210.98,
      "formatted_start": "00:36:48.980",
      "formatted_end": "00:36:50.980",
      "text": "این الان اینجوری شده"
    },
    {
      "id": 34,
      "start": 2210.98,
      "end": 2215.8,
      "formatted_start": "00:36:50.980",
      "formatted_end": "00:36:55.800",
      "text": "خب بعد مثلا این خونه جدایی از مدفوع یعنی با مدفوعش قاطی نیست"
    },
    {
      "id": 35,
      "start": 2215.8,
      "end": 2220.0,
      "formatted_start": "00:36:55.800",
      "formatted_end": "00:37:00.000",
      "text": "با نخان دکتر یعنی جدا کشن میاد"
    },
    {
      "id": 36,
      "start": 2220.0,
      "end": 2223.76,
      "formatted_start": "00:37:00.000",
      "formatted_end": "00:37:03.760",
      "text": "شده اصلا مدفوع نکنه بازم خون بیاد؟"
    },
    {
      "id": 37,
      "start": 2223.76,
      "end": 2224.76,
      "formatted_start": "00:37:03.760",
      "formatted_end": "00:37:04.760",
      "text": "نه نخان"
    },
    {
      "id": 38,
      "start": 2224.76,
      "end": 2225.26,
      "formatted_start": "00:37:04.760",
      "formatted_end": "00:37:05.260",
      "text": "نمیشه؟"
    },
    {
      "id": 39,
      "start": 2225.26,
      "end": 2225.76,
      "formatted_start": "00:37:05.260",
      "formatted_end": "00:37:05.760",
      "text": "نه"
    },
    {
      "id": 40,
      "start": 2225.76,
      "end": 2226.76,
      "formatted_start": "00:37:05.760",
      "formatted_end": "00:37:06.760",
      "text": "خب میشه من یه مایلش بکنم"
    },
    {
      "id": 41,
      "start": 2226.76,
      "end": 2227.76,
      "formatted_start": "00:37:06.760",
      "formatted_end": "00:37:07.760",
      "text": "آره"
    },
    {
      "id": 42,
      "start": 2227.76,
      "end": 2229.76,
      "formatted_start": "00:37:07.760",
      "formatted_end": "00:37:09.760",
      "text": "خب یه آنا بود اسم..."
    },
    {
      "id": 43,
      "start": 2229.76,
      "end": 2231.22,
      "formatted_start": "00:37:09.760",
      "formatted_end": "00:37:11.220",
      "text": "خاندرتور آشنا"
    },
    {
      "id": 44,
      "start": 2231.22,
      "end": 2233.22,
      "formatted_start": "00:37:11.220",
      "formatted_end": "00:37:13.220",
      "text": "اسم اون یکی اون..."
    },
    {
      "id": 45,
      "start": 2233.22,
      "end": 2235.22,
      "formatted_start": "00:37:13.220",
      "formatted_end": "00:37:15.220",
      "text": "اسم آمو دو پلش چی بود؟"
    },
    {
      "id": 46,
      "start": 2235.22,
      "end": 2237.22,
      "formatted_start": "00:37:15.220",
      "formatted_end": "00:37:17.220",
      "text": "آبجی اسم آبجی چیه؟ به خاندرتور بگو"
    },
    {
      "id": 47,
      "start": 2237.22,
      "end": 2239.22,
      "formatted_start": "00:37:17.220",
      "formatted_end": "00:37:19.220",
      "text": "آبجی چی بود؟"
    },
    {
      "id": 48,
      "start": 2239.22,
      "end": 2241.22,
      "formatted_start": "00:37:19.220",
      "formatted_end": "00:37:21.220",
      "text": "اسمش چی بود؟"
    },
    {
      "id": 49,
      "start": 2241.22,
      "end": 2243.22,
      "formatted_start": "00:37:21.220",
      "formatted_end": "00:37:23.220",
      "text": "جانا"
    },
    {
      "id": 50,
      "start": 2243.22,
      "end": 2245.22,
      "formatted_start": "00:37:23.220",
      "formatted_end": "00:37:25.220",
      "text": "جانا بود"
    },
    {
      "id": 51,
      "start": 2245.22,
      "end": 2247.22,
      "formatted_start": "00:37:25.220",
      "formatted_end": "00:37:27.220",
      "text": "خب پتنه هم ستاره بهت میدن خب"
    },
    {
      "id": 52,
      "start": 2247.22,
      "end": 2249.22,
      "formatted_start": "00:37:27.220",
      "formatted_end": "00:37:29.220",
      "text": "هم برای خودت"
    },
    {
      "id": 53,
      "start": 2249.22,
      "end": 2251.22,
      "formatted_start": "00:37:29.220",
      "formatted_end": "00:37:31.220",
      "text": "یه تنم برای جانا باشه"
    },
    {
      "id": 54,
      "start": 2253.22,
      "end": 2256.22,
      "formatted_start": "00:37:33.220",
      "formatted_end": "00:37:36.220",
      "text": "چون از طالب بودن اطلاعا قومت بودن"
    },
    {
      "id": 55,
      "start": 2256.22,
      "end": 2260.78,
      "formatted_start": "00:37:36.220",
      "formatted_end": "00:37:40.780",
      "text": "خانوادگو میره ویلایی داریم خارج شهره میرن به سخت داره"
    },
    {
      "id": 56,
      "start": 2260.78,
      "end": 2264.74,
      "formatted_start": "00:37:40.780",
      "formatted_end": "00:37:44.740",
      "text": "میرن باز نمیدونم مستقل از این شو چی شد هر چی هم ماند"
    },
    {
      "id": 57,
      "start": 2264.74,
      "end": 2267.74,
      "formatted_start": "00:37:44.740",
      "formatted_end": "00:37:47.740",
      "text": "یکیشم بعد شما یکیشم بعد جانم خب؟"
    },
    {
      "id": 58,
      "start": 2267.74,
      "end": 2269.74,
      "formatted_start": "00:37:47.740",
      "formatted_end": "00:37:49.740",
      "text": "گفتیم نیستی به خانوادگو"
    },
    {
      "id": 59,
      "start": 2269.74,
      "end": 2273.22,
      "formatted_start": "00:37:49.740",
      "formatted_end": "00:37:53.220",
      "text": "بیایی صافی با قلم اونجا خانوادگو این خیلی مایی میکنه باشه"
    },
    {
      "id": 60,
      "start": 2273.22,
      "end": 2275.22,
      "formatted_start": "00:37:53.220",
      "formatted_end": "00:37:55.220",
      "text": "کمشوکو دردن بگذارم"
    },
    {
      "id": 61,
      "start": 2275.22,
      "end": 2278.22,
      "formatted_start": "00:37:55.220",
      "formatted_end": "00:37:58.220",
      "text": "ببینم چی رو بیرون کرده"
    },
    {
      "id": 62,
      "start": 2278.22,
      "end": 2281.22,
      "formatted_start": "00:37:58.220",
      "formatted_end": "00:38:01.220",
      "text": "خوب؟ باشه؟"
    },
    {
      "id": 63,
      "start": 2281.22,
      "end": 2284.28,
      "formatted_start": "00:38:01.220",
      "formatted_end": "00:38:04.280",
      "text": "ازا کاندوکو اینجوریه که یه خوشون قضا میخورن"
    },
    {
      "id": 64,
      "start": 2284.28,
      "end": 2286.58,
      "formatted_start": "00:38:04.280",
      "formatted_end": "00:38:06.580",
      "text": "یه کم از همون و درست بگیر"
    },
    {
      "id": 65,
      "start": 2286.58,
      "end": 2287.5,
      "formatted_start": "00:38:06.580",
      "formatted_end": "00:38:07.500",
      "text": "مامان چه کنی؟"
    },
    {
      "id": 66,
      "start": 2287.5,
      "end": 2288.5,
      "formatted_start": "00:38:07.500",
      "formatted_end": "00:38:08.500",
      "text": "به کاندوکو کن"
    },
    {
      "id": 67,
      "start": 2288.5,
      "end": 2290.06,
      "formatted_start": "00:38:08.500",
      "formatted_end": "00:38:10.060",
      "text": "رو بش بده چی بهت بیدن"
    },
    {
      "id": 68,
      "start": 2290.06,
      "end": 2291.06,
      "formatted_start": "00:38:10.060",
      "formatted_end": "00:38:11.060",
      "text": "مامان چه کنی؟"
    },
    {
      "id": 69,
      "start": 2291.06,
      "end": 2293.62,
      "formatted_start": "00:38:11.060",
      "formatted_end": "00:38:13.620",
      "text": "یه آرائب نداره خب ببین یه آرائب میخوان"
    },
    {
      "id": 70,
      "start": 2293.62,
      "end": 2294.26,
      "formatted_start": "00:38:13.620",
      "formatted_end": "00:38:14.260",
      "text": "از اونجا درست بیدن"
    },
    {
      "id": 71,
      "start": 2294.26,
      "end": 2295.22,
      "formatted_start": "00:38:14.260",
      "formatted_end": "00:38:15.220",
      "text": "بشی بهت بدن؟"
    },
    {
      "id": 72,
      "start": 2295.22,
      "end": 2296.78,
      "formatted_start": "00:38:15.220",
      "formatted_end": "00:38:16.780",
      "text": "من فقط یه درست میخوان ببینم"
    },
    {
      "id": 73,
      "start": 2296.78,
      "end": 2298.98,
      "formatted_start": "00:38:16.780",
      "formatted_end": "00:38:18.980",
      "text": "اونجا چه بردیدید خیلی پیپی کنی؟"
    },
    {
      "id": 74,
      "start": 2298.98,
      "end": 2299.74,
      "formatted_start": "00:38:18.980",
      "formatted_end": "00:38:19.740",
      "text": "خودت گفتی"
    },
    {
      "id": 75,
      "start": 2299.74,
      "end": 2300.24,
      "formatted_start": "00:38:19.740",
      "formatted_end": "00:38:20.240",
      "text": "باشه"
    },
    {
      "id": 76,
      "start": 2300.24,
      "end": 2302.24,
      "formatted_start": "00:38:20.240",
      "formatted_end": "00:38:22.240",
      "text": "میاد هم دو دو ببینه چرا"
    },
    {
      "id": 77,
      "start": 2302.24,
      "end": 2304.24,
      "formatted_start": "00:38:22.240",
      "formatted_end": "00:38:24.240",
      "text": "میاد"
    },
    {
      "id": 78,
      "start": 2304.24,
      "end": 2306.24,
      "formatted_start": "00:38:24.240",
      "formatted_end": "00:38:26.240",
      "text": "نشستن نمیشه مامانی"
    },
    {
      "id": 79,
      "start": 2306.24,
      "end": 2308.24,
      "formatted_start": "00:38:26.240",
      "formatted_end": "00:38:28.240",
      "text": "ببین باشه"
    },
    {
      "id": 80,
      "start": 2308.24,
      "end": 2310.24,
      "formatted_start": "00:38:28.240",
      "formatted_end": "00:38:30.240",
      "text": "نمیخواد محمد رو بگیر"
    },
    {
      "id": 81,
      "start": 2310.24,
      "end": 2312.24,
      "formatted_start": "00:38:30.240",
      "formatted_end": "00:38:32.240",
      "text": "نگاه کن همه چیز آمکولی نداری"
    },
    {
      "id": 82,
      "start": 2312.24,
      "end": 2314.24,
      "formatted_start": "00:38:32.240",
      "formatted_end": "00:38:34.240",
      "text": "خیالت را هم باشه"
    },
    {
      "id": 83,
      "start": 2314.24,
      "end": 2316.24,
      "formatted_start": "00:38:34.240",
      "formatted_end": "00:38:36.240",
      "text": "من بهت باز بدم"
    },
    {
      "id": 84,
      "start": 2316.24,
      "end": 2318.24,
      "formatted_start": "00:38:36.240",
      "formatted_end": "00:38:38.240",
      "text": "بقل مامانت باش"
    },
    {
      "id": 85,
      "start": 2318.24,
      "end": 2320.24,
      "formatted_start": "00:38:38.240",
      "formatted_end": "00:38:40.240",
      "text": "بقل مامانت باش"
    },
    {
      "id": 86,
      "start": 2320.24,
      "end": 2322.24,
      "formatted_start": "00:38:40.240",
      "formatted_end": "00:38:42.240",
      "text": "باید دراز بگیری"
    },
    {
      "id": 87,
      "start": 2322.24,
      "end": 2324.24,
      "formatted_start": "00:38:42.240",
