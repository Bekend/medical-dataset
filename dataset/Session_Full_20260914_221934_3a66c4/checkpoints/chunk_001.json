  "stt_segments": [
    {
      "id": 0,
      "start": 300.0,
      "end": 322.0,
      "formatted_start": "00:05:00.000",
      "formatted_end": "00:05:22.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 322.0,
      "end": 323.0,
      "formatted_start": "00:05:22.000",
      "formatted_end": "00:05:23.000",
      "text": "هلو سلام"
    },
    {
      "id": 2,
      "start": 323.64,
      "end": 325.2,
      "formatted_start": "00:05:23.640",
      "formatted_end": "00:05:25.200",
      "text": "خانه شما خوب هستی؟"
    },
    {
      "id": 3,
      "start": 325.2,
      "end": 328.0,
      "formatted_start": "00:05:25.200",
      "formatted_end": "00:05:28.000",
      "text": "قربونشان مرسی ممنونم مرسی"
    },
    {
      "id": 4,
      "start": 328.0,
      "end": 330.0,
      "formatted_start": "00:05:28.000",
      "formatted_end": "00:05:30.000",
      "text": "این سوما رو برای چی میخوای شما؟"
    },
    {
      "id": 5,
      "start": 334.68,
      "end": 335.68,
      "formatted_start": "00:05:34.680",
      "formatted_end": "00:05:35.680",
      "text": "درسته؟"
    },
    {
      "id": 6,
      "start": 341.36,
      "end": 343.36,
      "formatted_start": "00:05:41.360",
      "formatted_end": "00:05:43.360",
      "text": "ببین آخه این از سوما ده"
    },
    {
      "id": 7,
      "start": 343.36,
      "end": 346.6,
      "formatted_start": "00:05:43.360",
      "formatted_end": "00:05:46.600",
      "text": "جز داروهاییه که حتما باید توی لیست بله"
    },
    {
      "id": 8,
      "start": 346.6,
      "end": 348.8,
      "formatted_start": "00:05:46.600",
      "formatted_end": "00:05:48.800",
      "text": "اسم بچه میره و بذار از خونه"
    },
    {
      "id": 9,
      "start": 348.8,
      "end": 350.8,
      "formatted_start": "00:05:48.800",
      "formatted_end": "00:05:50.800",
      "text": "و بعدا برایش چیز میشه"
    },
    {
      "id": 10,
      "start": 350.8,
      "end": 352.8,
      "formatted_start": "00:05:50.800",
      "formatted_end": "00:05:52.800",
      "text": "خب نمیشه برای هر کسی نبشه"
    },
    {
      "id": 11,
      "start": 352.8,
      "end": 354.8,
      "formatted_start": "00:05:52.800",
      "formatted_end": "00:05:54.800",
      "text": "آره عزیزم"
    },
    {
      "id": 12,
      "start": 354.8,
      "end": 356.8,
      "formatted_start": "00:05:54.800",
      "formatted_end": "00:05:56.800",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 356.8,
      "end": 358.8,
      "formatted_start": "00:05:56.800",
      "formatted_end": "00:05:58.800",
      "text": "نه نه نه"
    },
    {
      "id": 14,
      "start": 358.8,
      "end": 360.8,
      "formatted_start": "00:05:58.800",
      "formatted_end": "00:06:00.800",
      "text": "نه نه نمیشه"
    },
    {
      "id": 15,
      "start": 360.8,
      "end": 362.8,
      "formatted_start": "00:06:00.800",
      "formatted_end": "00:06:02.800",
      "text": "میدونم میدونم عزیزم"
    },
    {
      "id": 16,
      "start": 362.8,
      "end": 364.8,
      "formatted_start": "00:06:02.800",
      "formatted_end": "00:06:04.800",
      "text": "خب ببین سوماتیفتران"
    },
    {
      "id": 17,
      "start": 364.8,
      "end": 366.8,
      "formatted_start": "00:06:04.800",
      "formatted_end": "00:06:06.800",
      "text": "چیزیه که"
    },
    {
      "id": 18,
      "start": 366.8,
      "end": 368.8,
      "formatted_start": "00:06:06.800",
      "formatted_end": "00:06:08.800",
      "text": "باید جواب"
    },
    {
      "id": 19,
      "start": 368.8,
      "end": 370.8,
      "formatted_start": "00:06:08.800",
      "formatted_end": "00:06:10.800",
      "text": "آزمایش های هرمونیش"
    },
    {
      "id": 20,
      "start": 370.8,
      "end": 372.8,
      "formatted_start": "00:06:10.800",
      "formatted_end": "00:06:12.800",
      "text": "خب اپلود بشه"
    },
    {
      "id": 21,
      "start": 372.8,
      "end": 374.8,
      "formatted_start": "00:06:12.800",
      "formatted_end": "00:06:14.800",
      "text": "توی سایت بزارت خونه"
    },
    {
      "id": 22,
      "start": 374.8,
      "end": 376.8,
      "formatted_start": "00:06:14.800",
      "formatted_end": "00:06:16.800",
      "text": "اسمش بره تو لیز"
    },
    {
      "id": 23,
      "start": 376.8,
      "end": 378.8,
      "formatted_start": "00:06:16.800",
      "formatted_end": "00:06:18.800",
      "text": "و بعد این آنپولو بدن"
    },
    {
      "id": 24,
      "start": 378.8,
      "end": 383.8,
      "formatted_start": "00:06:18.800",
      "formatted_end": "00:06:23.800",
      "text": "به خاطر اینکه این آمپول آمپول گرمونیه دورت داردجوش سبسید میده"
    },
    {
      "id": 25,
      "start": 383.8,
      "end": 386.8,
      "formatted_start": "00:06:23.800",
      "formatted_end": "00:06:26.800",
      "text": "بعد خیلی ها میرن اینو با دفترچه هشون بیخرن"
    },
    {
      "id": 26,
      "start": 386.8,
      "end": 389.8,
      "formatted_start": "00:06:26.800",
      "formatted_end": "00:06:29.800",
      "text": "بعد میرن تو بازارو آزاد میفروشن"
    },
    {
      "id": 27,
      "start": 389.8,
      "end": 391.8,
      "formatted_start": "00:06:29.800",
      "formatted_end": "00:06:31.800",
      "text": "به خاطر اینکه جلو گیری از این بشه"
    },
    {
      "id": 28,
      "start": 391.8,
      "end": 398.8,
      "formatted_start": "00:06:31.800",
      "formatted_end": "00:06:38.800",
      "text": "حتما باید آزمایش های مریض که نشوندهنده اینه که این ویس اونها نیاز داره"
    },
    {
      "id": 29,
      "start": 398.8,
      "end": 401.0,
      "formatted_start": "00:06:38.800",
      "formatted_end": "00:06:41.000",
      "text": "همراه باتست"
    },
    {
      "id": 30,
      "start": 401.0,
      "end": 404.64,
      "formatted_start": "00:06:41.000",
      "formatted_end": "00:06:44.640",
      "text": "همراه با اسم ملیز و خود ملیش"
    },
    {
      "id": 31,
      "start": 404.64,
      "end": 406.4,
      "formatted_start": "00:06:44.640",
      "formatted_end": "00:06:46.400",
      "text": "توی بزارت خونه"
    },
    {
      "id": 32,
      "start": 406.4,
      "end": 408.34,
      "formatted_start": "00:06:46.400",
      "formatted_end": "00:06:48.340",
      "text": "توی سایت دارو"
    },
    {
      "id": 33,
      "start": 408.34,
      "end": 409.36,
      "formatted_start": "00:06:48.340",
      "formatted_end": "00:06:49.360",
      "text": "آره دارو وقتا"
    },
    {
      "id": 34,
      "start": 409.36,
      "end": 411.9,
      "formatted_start": "00:06:49.360",
      "formatted_end": "00:06:51.900",
      "text": "بزارت خونه سخت بشن"
    },
    {
      "id": 35,
      "start": 411.9,
      "end": 413.78,
      "formatted_start": "00:06:51.900",
      "formatted_end": "00:06:53.780",
      "text": "نمیدن و گرم"
    },
    {
      "id": 36,
      "start": 413.78,
      "end": 415.72,
      "formatted_start": "00:06:53.780",
      "formatted_end": "00:06:55.720",
      "text": "آره عزیزم"
    },
    {
      "id": 37,
      "start": 415.72,
      "end": 417.94,
      "formatted_start": "00:06:55.720",
      "formatted_end": "00:06:57.940",
      "text": "آره قربون شما خریش میکنم"
    },
    {
      "id": 38,
      "start": 417.94,
      "end": 418.54,
      "formatted_start": "00:06:57.940",
      "formatted_end": "00:06:58.540",
      "text": "خدا خدا"
    },
    {
      "id": 39,
      "start": 418.54,
      "end": 420.62,
      "formatted_start": "00:06:58.540",
      "formatted_end": "00:07:00.620",
      "text": "وقت قربون شما خریش میکنم"
    },
    {
      "id": 40,
      "start": 420.62,
      "end": 421.16,
      "formatted_start": "00:07:00.620",
      "formatted_end": "00:07:01.160",
      "text": "خدا خدا"
    },
