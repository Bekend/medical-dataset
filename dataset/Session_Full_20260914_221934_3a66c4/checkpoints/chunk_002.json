      "formatted_end": "00:10:20.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 630.0,
      "end": 636.0,
      "formatted_start": "00:10:30.000",
      "formatted_end": "00:10:36.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 660.0,
      "end": 688.0,
      "formatted_start": "00:11:00.000",
      "formatted_end": "00:11:28.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 690.0,
      "end": 719.98,
      "formatted_start": "00:11:30.000",
      "formatted_end": "00:11:59.980",
      "text": "بخواهید بخواهید"
    },
    {
      "id": 4,
      "start": 720.0,
      "end": 724.0,
      "formatted_start": "00:12:00.000",
      "formatted_end": "00:12:04.000",
      "text": "از اینجا هم اصلا سفید سفید شده نمیتونم برده که چیه"
    },
    {
      "id": 5,
      "start": 724.0,
      "end": 726.0,
      "formatted_start": "00:12:04.000",
      "formatted_end": "00:12:06.000",
      "text": "خب تقویم هم نداره"
    },
    {
      "id": 6,
      "start": 726.0,
      "end": 728.0,
      "formatted_start": "00:12:06.000",
      "formatted_end": "00:12:08.000",
      "text": "نه نه نه"
    },
    {
      "id": 7,
      "start": 728.0,
      "end": 731.0,
      "formatted_start": "00:12:08.000",
      "formatted_end": "00:12:11.000",
      "text": "هر دو شهرمه قبل اومدن گرد هم نداره شده نمیتونم بگیم"
    },
    {
      "id": 8,
      "start": 731.0,
      "end": 734.0,
      "formatted_start": "00:12:11.000",
      "formatted_end": "00:12:14.000",
      "text": "صرفه آبزش بگیره"
    },
    {
      "id": 9,
      "start": 738.0,
      "end": 740.0,
      "formatted_start": "00:12:18.000",
      "formatted_end": "00:12:20.000",
      "text": "دیشتر چی خورده؟"
    },
    {
      "id": 10,
      "start": 741.0,
      "end": 744.0,
      "formatted_start": "00:12:21.000",
      "formatted_end": "00:12:24.000",
      "text": "کالباس همه نیزی خورده"
    },
    {
      "id": 11,
      "start": 745.0,
      "end": 746.0,
      "formatted_start": "00:12:25.000",
      "formatted_end": "00:12:26.000",
      "text": "خب"
    },
    {
      "id": 12,
      "start": 746.0,
      "end": 748.0,
      "formatted_start": "00:12:26.000",
      "formatted_end": "00:12:28.000",
      "text": "جزنه شو نگرده"
    },
    {
      "id": 13,
      "start": 750.0,
      "end": 752.0,
      "formatted_start": "00:12:30.000",
      "formatted_end": "00:12:32.000",
      "text": "آره"
    },
    {
      "id": 14,
      "start": 752.0,
      "end": 756.0,
      "formatted_start": "00:12:32.000",
      "formatted_end": "00:12:36.000",
      "text": "بزار تیه هل بهتون ببینم عزیزم"
    },
    {
      "id": 15,
      "start": 756.0,
      "end": 758.0,
      "formatted_start": "00:12:36.000",
      "formatted_end": "00:12:38.000",
      "text": "برو تماما ببین"
    },
    {
      "id": 16,
      "start": 758.0,
      "end": 762.0,
      "formatted_start": "00:12:38.000",
      "formatted_end": "00:12:42.000",
      "text": "این لسه هاشو همینو زده"
    },
    {
      "id": 17,
      "start": 762.0,
      "end": 766.0,
      "formatted_start": "00:12:42.000",
      "formatted_end": "00:12:46.000",
      "text": "تیه هل چه خبره؟ خب"
    },
    {
      "id": 18,
      "start": 766.0,
      "end": 768.0,
      "formatted_start": "00:12:46.000",
      "formatted_end": "00:12:48.000",
      "text": "یه نقاش"
    },
    {
      "id": 19,
      "start": 768.0,
      "end": 770.0,
      "formatted_start": "00:12:48.000",
      "formatted_end": "00:12:50.000",
      "text": "خب یه نقاش"
    },
    {
      "id": 20,
      "start": 770.0,
      "end": 772.0,
      "formatted_start": "00:12:50.000",
      "formatted_end": "00:12:52.000",
      "text": "حالا یه چیزی دستش آرود و میگه تو دهندش کرد"
    },
    {
      "id": 21,
      "start": 772.0,
      "end": 776.0,
      "formatted_start": "00:12:52.000",
      "formatted_end": "00:12:56.000",
      "text": "دستش این چهار تا همه اش تو دهندش"
    },
    {
      "id": 22,
      "start": 776.0,
      "end": 778.0,
      "formatted_start": "00:12:56.000",
      "formatted_end": "00:12:58.000",
      "text": "داره دندونه یه کرسیش در میاد"
    },
    {
      "id": 23,
      "start": 778.0,
      "end": 780.0,
      "formatted_start": "00:12:58.000",
      "formatted_end": "00:13:00.000",
      "text": "دو تا درمه دو تا درمه دیده"
    },
    {
      "id": 24,
      "start": 780.0,
      "end": 782.0,
      "formatted_start": "00:13:00.000",
      "formatted_end": "00:13:02.000",
      "text": "درمه دیده"
    },
    {
      "id": 25,
      "start": 782.0,
      "end": 784.0,
      "formatted_start": "00:13:02.000",
      "formatted_end": "00:13:04.000",
      "text": "بچه ازی میتونه بخوره"
    },
    {
      "id": 26,
      "start": 784.0,
      "end": 787.0,
      "formatted_start": "00:13:04.000",
      "formatted_end": "00:13:07.000",
      "text": "چون معمولا اینا دردناک نیست خیلی"
    },
    {
      "id": 27,
      "start": 787.0,
      "end": 790.0,
      "formatted_start": "00:13:07.000",
      "formatted_end": "00:13:10.000",
      "text": "ولی چون مثلا یه ذر حالت تب نیست"
    },
    {
      "id": 28,
      "start": 790.0,
      "end": 792.0,
      "formatted_start": "00:13:10.000",
      "formatted_end": "00:13:12.000",
      "text": "کل من خوشحالگان نیست"
    },
    {
      "id": 29,
      "start": 792.0,
      "end": 795.0,
      "formatted_start": "00:13:12.000",
      "formatted_end": "00:13:15.000",
      "text": "اینا معمولا دردناک نیست، تب نمیده"
    },
    {
      "id": 30,
      "start": 795.0,
      "end": 798.0,
      "formatted_start": "00:13:15.000",
      "formatted_end": "00:13:18.000",
