  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1802.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:02.000",
      "text": "از مرشدش رو گرفت کنید."
    },
    {
      "id": 1,
      "start": 1802.0,
      "end": 1804.0,
      "formatted_start": "00:30:02.000",
      "formatted_end": "00:30:04.000",
      "text": "باز نکردم، نگاه برده چی بی چی رو باز کنید."
    },
    {
      "id": 2,
      "start": 1804.0,
      "end": 1806.0,
      "formatted_start": "00:30:04.000",
      "formatted_end": "00:30:06.000",
      "text": "کار خوبی کردی."
    },
    {
      "id": 3,
      "start": 1806.0,
      "end": 1808.0,
      "formatted_start": "00:30:06.000",
      "formatted_end": "00:30:08.000",
      "text": "باز کنید، یه چیزهایی میبینید، هرکه کنید، که مشکل داره."
    },
    {
      "id": 4,
      "start": 1808.0,
      "end": 1810.0,
      "formatted_start": "00:30:08.000",
      "formatted_end": "00:30:10.000",
      "text": "آرسان."
    },
    {
      "id": 5,
      "start": 1810.0,
      "end": 1812.0,
      "formatted_start": "00:30:10.000",
      "formatted_end": "00:30:12.000",
      "text": "ما شاید کمپونی که اصلا نداریم،"
    },
    {
      "id": 6,
      "start": 1812.0,
      "end": 1814.0,
      "formatted_start": "00:30:12.000",
      "formatted_end": "00:30:14.000",
      "text": "اون روزه خیلی خوبه، تلتتاش خوبه،"
    },
    {
      "id": 7,
      "start": 1814.0,
      "end": 1816.0,
      "formatted_start": "00:30:14.000",
      "formatted_end": "00:30:16.000",
      "text": "قندش خوبه، کلیهش عالی،"
    },
    {
      "id": 8,
      "start": 1816.0,
      "end": 1818.0,
      "formatted_start": "00:30:16.000",
      "formatted_end": "00:30:18.000",
      "text": "کبدش عالی،"
    },
    {
      "id": 9,
      "start": 1818.0,
      "end": 1820.0,
      "formatted_start": "00:30:18.000",
      "formatted_end": "00:30:20.000",
      "text": "کمسیومش خیلی خوب،"
    },
    {
      "id": 10,
      "start": 1820.0,
      "end": 1822.0,
      "formatted_start": "00:30:20.000",
      "formatted_end": "00:30:22.000",
      "text": "تفتاکیرویدش خیلی خوبه،"
    },
    {
      "id": 11,
      "start": 1822.0,
      "end": 1837.0,
      "formatted_start": "00:30:22.000",
      "formatted_end": "00:30:37.000",
      "text": "کبدش عالی، کمسیومش خیلی خوب، تفتای تیرویدش خیلی خوبه، ویتامویدیش یه ذره کائینه، زخوای آرزش یه ذره کائینه و این هست"
    },
    {
      "id": 12,
      "start": 1837.0,
      "end": 1840.76,
      "formatted_start": "00:30:37.000",
      "formatted_end": "00:30:40.760",
      "text": "پس بعد آرزی ما یه بیتامیلی پر نگاه برده"
    },
    {
      "id": 13,
      "start": 1840.76,
      "end": 1842.76,
      "formatted_start": "00:30:40.760",
      "formatted_end": "00:30:42.760",
      "text": "سه ما آهنگ چی میخورن؟"
    },
    {
      "id": 14,
      "start": 1842.76,
      "end": 1844.76,
      "formatted_start": "00:30:42.760",
      "formatted_end": "00:30:44.760",
      "text": "هیچی نیم"
    },
    {
      "id": 15,
      "start": 1844.76,
      "end": 1846.76,
      "formatted_start": "00:30:44.760",
      "formatted_end": "00:30:46.760",
      "text": "بردی هیچ نمیخورن"
    },
    {
      "id": 16,
      "start": 1846.76,
      "end": 1848.76,
      "formatted_start": "00:30:46.760",
      "formatted_end": "00:30:48.760",
      "text": "دو سالش هست؟"
    },
    {
      "id": 17,
      "start": 1848.76,
      "end": 1850.76,
      "formatted_start": "00:30:48.760",
      "formatted_end": "00:30:50.760",
      "text": "دو سال و نیم"
    },
    {
      "id": 18,
      "start": 1850.76,
      "end": 1853.76,
      "formatted_start": "00:30:50.760",
      "formatted_end": "00:30:53.760",
      "text": "پس یه قطعه آرزی یا آرز زخمه"
    },
    {
      "id": 19,
      "start": 1853.76,
      "end": 1855.76,
      "formatted_start": "00:30:53.760",
      "formatted_end": "00:30:55.760",
      "text": "بهش بدم و خوره"
    },
    {
      "id": 20,
      "start": 1855.76,
      "end": 1857.76,
      "formatted_start": "00:30:55.760",
      "formatted_end": "00:30:57.760",
      "text": "روز یک سیست"
    },
    {
      "id": 21,
      "start": 1857.76,
      "end": 1859.76,
      "formatted_start": "00:30:57.760",
      "formatted_end": "00:30:59.760",
      "text": "کمی تو ترمیلی کنی؟"
    },
    {
      "id": 22,
      "start": 1859.76,
      "end": 1860.76,
      "formatted_start": "00:30:59.760",
      "formatted_end": "00:31:00.760",
      "text": "هیچ فرق"
    },
    {
      "id": 23,
      "start": 1860.76,
      "end": 1862.76,
      "formatted_start": "00:31:00.760",
      "formatted_end": "00:31:02.760",
      "text": "این آرزی"
    },
    {
      "id": 24,
      "start": 1862.76,
      "end": 1864.76,
      "formatted_start": "00:31:02.760",
      "formatted_end": "00:31:04.760",
      "text": "هم آهنگ کنه هم بیتامیلی"
    },
    {
      "id": 25,
      "start": 1864.76,
      "end": 1866.76,
      "formatted_start": "00:31:04.760",
      "formatted_end": "00:31:06.760",
      "text": "هم میتوانید در باقی"
    },
    {
      "id": 26,
      "start": 1868.76,
      "end": 1869.76,
      "formatted_start": "00:31:08.760",
      "formatted_end": "00:31:09.760",
      "text": "خب، دیگه نظریم"
    },
    {
      "id": 27,
      "start": 1869.76,
      "end": 1870.76,
      "formatted_start": "00:31:09.760",
      "formatted_end": "00:31:10.760",
      "text": "برای"
    },
    {
      "id": 28,
      "start": 1870.76,
      "end": 1872.76,
      "formatted_start": "00:31:10.760",
      "formatted_end": "00:31:12.760",
      "text": "سامیت در باقی"
    },
    {
      "id": 29,
      "start": 1872.76,
      "end": 1874.76,
      "formatted_start": "00:31:12.760",
      "formatted_end": "00:31:14.760",
      "text": "خب، دوستان من که سوالی کتا فراموش دارم"
