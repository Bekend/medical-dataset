  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2430.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:30.000",
      "text": "از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور"
    },
    {
      "id": 1,
      "start": 2430.0,
      "end": 2432.0,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:32.000",
      "text": "یعنی درسته ای کننده بشه"
    },
    {
      "id": 2,
      "start": 2432.0,
      "end": 2434.0,
      "formatted_start": "00:40:32.000",
      "formatted_end": "00:40:34.000",
      "text": "نه، کندم شد"
    },
    {
      "id": 3,
      "start": 2438.0,
      "end": 2441.0,
      "formatted_start": "00:40:38.000",
      "formatted_end": "00:40:41.000",
      "text": "این تحلیفت خواهشم رو درمش کنم؟"
    },
    {
      "id": 4,
      "start": 2441.0,
      "end": 2444.0,
      "formatted_start": "00:40:41.000",
      "formatted_end": "00:40:44.000",
      "text": "نه، یکی درسته درمش کنه"
    },
    {
      "id": 5,
      "start": 2444.0,
      "end": 2446.0,
      "formatted_start": "00:40:44.000",
      "formatted_end": "00:40:46.000",
      "text": "نه، گرام نماش برم"
    },
    {
      "id": 6,
      "start": 2452.0,
      "end": 2455.0,
      "formatted_start": "00:40:52.000",
      "formatted_end": "00:40:55.000",
      "text": "بعد هم رو بکنم آزنش خون نمی بیسیم براش؟"
    },
    {
      "id": 7,
      "start": 2455.0,
      "end": 2457.0,
      "formatted_start": "00:40:55.000",
      "formatted_end": "00:40:57.000",
      "text": "همه رو تقییم"
    },
    {
      "id": 8,
      "start": 2457.0,
      "end": 2457.84,
      "formatted_start": "00:40:57.000",
      "formatted_end": "00:40:57.840",
      "text": "چرا بگو موزن؟"
    },
    {
      "id": 9,
      "start": 2457.84,
      "end": 2463.16,
      "formatted_start": "00:40:57.840",
      "formatted_end": "00:41:03.160",
      "text": "آه چون من از که چند یک سال بوده چک آب داشتن دادم دیگه همونه"
    },
    {
      "id": 10,
      "start": 2463.16,
      "end": 2464.04,
      "formatted_start": "00:41:03.160",
      "formatted_end": "00:41:04.040",
      "text": "باشه"
    },
    {
      "id": 11,
      "start": 2480.6,
      "end": 2482.6,
      "formatted_start": "00:41:20.600",
      "formatted_end": "00:41:22.600",
      "text": "بیرم چک آبش"
    },
    {
      "id": 12,
      "start": 2487.0,
      "end": 2516.98,
      "formatted_start": "00:41:27.000",
      "formatted_end": "00:41:56.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 13,
      "start": 2517.0,
      "end": 2531.0,
      "formatted_start": "00:41:57.000",
      "formatted_end": "00:42:11.000",
      "text": "موسیقی"
    },
    {
      "id": 14,
      "start": 2547.0,
      "end": 2569.0,
      "formatted_start": "00:42:27.000",
      "formatted_end": "00:42:49.000",
      "text": "موسیقی"
    },
    {
      "id": 15,
      "start": 2569.0,
      "end": 2599.0,
      "formatted_start": "00:42:49.000",
      "formatted_end": "00:43:19.000",
      "text": "برای اینجا که از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که"
    },
    {
      "id": 16,
      "start": 2599.0,
      "end": 2601.0,
      "formatted_start": "00:43:19.000",
      "formatted_end": "00:43:21.000",
      "text": "این که بازی کشی"
    },
    {
      "id": 17,
      "start": 2601.0,
      "end": 2603.0,
      "formatted_start": "00:43:21.000",
      "formatted_end": "00:43:23.000",
      "text": "آه"
    },
    {
      "id": 18,
      "start": 2603.0,
      "end": 2605.0,
      "formatted_start": "00:43:23.000",
      "formatted_end": "00:43:25.000",
      "text": "طبعا"
    },
    {
      "id": 19,
      "start": 2605.0,
      "end": 2607.0,
      "formatted_start": "00:43:25.000",
      "formatted_end": "00:43:27.000",
      "text": "داگی خوب یا براش؟"
    },
    {
      "id": 20,
      "start": 2607.0,
      "end": 2609.0,
      "formatted_start": "00:43:27.000",
      "formatted_end": "00:43:29.000",
      "text": "نه دارم کن دکترون نه"
    },
    {
      "id": 21,
      "start": 2609.0,
      "end": 2611.0,
      "formatted_start": "00:43:29.000",
      "formatted_end": "00:43:31.000",
      "text": "میگم آخه یارا قبل اینکه جان آنگه که اینجور بود استفاده کرد خودتون داگی"
    },
    {
      "id": 22,
      "start": 2611.0,
      "end": 2613.0,
      "formatted_start": "00:43:31.000",
      "formatted_end": "00:43:33.000",
      "text": "میزدم براش"
    },
    {
      "id": 23,
      "start": 2617.0,
      "end": 2623.0,
      "formatted_start": "00:43:37.000",
      "formatted_end": "00:43:43.000",
      "text": "اونو خاندوتو فرمودین که بیشتر از یه هفته نباید بزنید درسته؟"
    },
    {
      "id": 24,
      "start": 2623.0,
      "end": 2625.0,
      "formatted_start": "00:43:43.000",
      "formatted_end": "00:43:45.000",
      "text": "نه میتونی بیشتر نباید بزنیم"
    },
    {
      "id": 25,
      "start": 2625.0,
      "end": 2627.0,
      "formatted_start": "00:43:45.000",
      "formatted_end": "00:43:47.000",
      "text": "نه معلوم یه هفته این کافی شد"
    },
    {
      "id": 26,
      "start": 2627.0,
      "end": 2629.0,
      "formatted_start": "00:43:47.000",
      "formatted_end": "00:43:49.000",
      "text": "افتراضی هم نباید مثلا بیشتر بگو"
    },
    {
      "id": 27,
      "start": 2629.0,
      "end": 2631.0,
      "formatted_start": "00:43:49.000",
      "formatted_end": "00:43:51.000",
      "text": "نه، نه، نه، درست"
    },
    {
      "id": 28,
      "start": 2631.0,
      "end": 2635.0,
      "formatted_start": "00:43:51.000",
      "formatted_end": "00:43:55.000",
      "text": "هر دوزده سال براش یک بار براش"
    },
    {
      "id": 29,
      "start": 2635.0,
      "end": 2637.0,
      "formatted_start": "00:43:55.000",
      "formatted_end": "00:43:57.000",
      "text": "چشم"
    },
    {
      "id": 30,
      "start": 2637.0,
      "end": 2639.0,
      "formatted_start": "00:43:57.000",
      "formatted_end": "00:43:59.000",
      "text": "اینو براتید"
    },
    {
      "id": 31,
      "start": 2641.0,
      "end": 2644.0,
      "formatted_start": "00:44:01.000",
      "formatted_end": "00:44:04.000",
      "text": "یه دونه بهش پرویویو تیک میدید"
    },
    {
      "id": 32,
      "start": 2644.0,
      "end": 2646.0,
      "formatted_start": "00:44:04.000",
      "formatted_end": "00:44:06.000",
      "text": "خوب، براش"
    },
    {
      "id": 33,
      "start": 2646.0,
      "end": 2648.0,
      "formatted_start": "00:44:06.000",
      "formatted_end": "00:44:08.000",
      "text": "چشم"
    },
    {
      "id": 34,
      "start": 2652.0,
      "end": 2653.0,
      "formatted_start": "00:44:12.000",
      "formatted_end": "00:44:13.000",
      "text": "حسن باشم؟"
    },
    {
      "id": 35,
      "start": 2653.0,
      "end": 2655.0,
      "formatted_start": "00:44:13.000",
      "formatted_end": "00:44:15.000",
      "text": "سه سال و دو سه ماه"
    },
    {
      "id": 36,
      "start": 2655.0,
      "end": 2663.0,
      "formatted_start": "00:44:15.000",
      "formatted_end": "00:44:23.000",
      "text": "از این کپسول ها موضوع می کنید."
    },
    {
      "id": 37,
      "start": 2663.0,
      "end": 2667.0,
      "formatted_start": "00:44:23.000",
      "formatted_end": "00:44:27.000",
      "text": "موضوعی که موضوعی یا آب نیده نام."
    },
    {
      "id": 38,
      "start": 2667.0,
      "end": 2677.0,
      "formatted_start": "00:44:27.000",
      "formatted_end": "00:44:37.000",
      "text": "اوه، پیترو درکس."
    },
    {
      "id": 39,
      "start": 2677.0,
      "end": 2689.0,
      "formatted_start": "00:44:37.000",
      "formatted_end": "00:44:49.000",
      "text": "این هم بزرگیه خواهش خوبه از مرافق خوریشون میکنه انجینرش او کار کرد چه بهتر اگه کار نکرد باید خواهش خوریشون کنید"
    },
    {
      "id": 40,
      "start": 2689.0,
      "end": 2694.0,
      "formatted_start": "00:44:49.000",
      "formatted_end": "00:44:54.000",
      "text": "روزی یه دونه خواسته اون مرافق خوریشون؟ آره اصلا"
    },
    {
      "id": 41,
      "start": 2694.0,
      "end": 2699.0,
