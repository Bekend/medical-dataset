  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6602.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:02.000",
      "text": "دکتر های دیگه یا سر."
    },
    {
      "id": 1,
      "start": 6602.0,
      "end": 6608.0,
      "formatted_start": "01:50:02.000",
      "formatted_end": "01:50:08.000",
      "text": "نه، دختر همسایی ما اصلا شنبایی نداشت. اینقدر خانه زندگی رو بروتر رفتن، هر از اون کارشن، وچه هر اون که نصر آبیداد درس میکنه."
    },
    {
      "id": 2,
      "start": 6608.0,
      "end": 6620.0,
      "formatted_start": "01:50:08.000",
      "formatted_end": "01:50:20.000",
      "text": "این پیش رفتن، ببینید یک دینه خورس نداشتن باشه. یک چارم شبا تو آپل میکنید، بشمزوی یک قاشب آپل میکنید، بشمزوی خورد تا پنج شب."
    },
    {
      "id": 3,
      "start": 6620.0,
      "end": 6623.66,
      "formatted_start": "01:50:20.000",
      "formatted_end": "01:50:23.660",
      "text": "بعد از 5 شب یک چارم صبح بیدی، یک چارم شب بیدی"
    },
    {
      "id": 4,
      "start": 6623.66,
      "end": 6624.58,
      "formatted_start": "01:50:23.660",
      "formatted_end": "01:50:24.580",
      "text": "همون بینید صورتون"
    },
    {
      "id": 5,
      "start": 6624.58,
      "end": 6630.74,
      "formatted_start": "01:50:24.580",
      "formatted_end": "01:50:30.740",
      "text": "تا یک ماه، یک ماه دیگه بیانی من میبینم ببینم همینقدر کافی شد یا باید دوزشو کم و زیاد بیدی"
    },
    {
      "id": 6,
      "start": 6630.74,
      "end": 6636.94,
      "formatted_start": "01:50:30.740",
      "formatted_end": "01:50:36.940",
      "text": "پا، بعد یه قطر هم نوشتم ببین که اسمش روزی یک سی سی هم عذبش بیدی"
    },
    {
      "id": 7,
      "start": 6636.94,
      "end": 6638.98,
      "formatted_start": "01:50:36.940",
      "formatted_end": "01:50:38.980",
      "text": "پا، این هستید"
    },
    {
      "id": 8,
      "start": 6638.98,
      "end": 6642.28,
      "formatted_start": "01:50:38.980",
      "formatted_end": "01:50:42.280",
      "text": "یه هفته که اینو دادی، بعد میداریش"
    },
    {
      "id": 9,
      "start": 6642.28,
      "end": 6644.22,
      "formatted_start": "01:50:42.280",
      "formatted_end": "01:50:44.220",
      "text": "قارن"
    },
    {
      "id": 10,
      "start": 6644.22,
      "end": 6648.22,
      "formatted_start": "01:50:44.220",
      "formatted_end": "01:50:48.220",
      "text": "از اینجا باید بردارید که این کار را بردارید."
    },
    {
      "id": 11,
      "start": 6648.22,
      "end": 6678.22,
      "formatted_start": "01:50:48.220",
      "formatted_end": "01:51:18.220",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 12,
      "start": 6678.22,
      "end": 6685.22,
      "formatted_start": "01:51:18.220",
      "formatted_end": "01:51:25.220",
      "text": "خب اینم برای بخدار درمانی و اینم برای بسیاری"
    },
    {
      "id": 13,
      "start": 6685.22,
      "end": 6689.22,
      "formatted_start": "01:51:25.220",
      "formatted_end": "01:51:29.220",
      "text": "برانو تو بسیاری کشید برادان برداری؟"
    },
    {
      "id": 14,
      "start": 6689.22,
      "end": 6690.22,
      "formatted_start": "01:51:29.220",
      "formatted_end": "01:51:30.220",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 6690.22,
      "end": 6691.22,
      "formatted_start": "01:51:30.220",
      "formatted_end": "01:51:31.220",
      "text": "نه؟"
    },
    {
      "id": 16,
      "start": 6691.22,
      "end": 6692.22,
      "formatted_start": "01:51:31.220",
      "formatted_end": "01:51:32.220",
      "text": "نه؟"
    },
    {
      "id": 17,
      "start": 6692.22,
      "end": 6693.22,
      "formatted_start": "01:51:32.220",
      "formatted_end": "01:51:33.220",
      "text": "نه؟"
    },
    {
      "id": 18,
      "start": 6693.22,
      "end": 6694.22,
      "formatted_start": "01:51:33.220",
      "formatted_end": "01:51:34.220",
      "text": "نه؟"
    },
    {
      "id": 19,
      "start": 6694.22,
      "end": 6695.22,
      "formatted_start": "01:51:34.220",
      "formatted_end": "01:51:35.220",
      "text": "نه؟"
    },
    {
      "id": 20,
      "start": 6695.22,
      "end": 6696.22,
      "formatted_start": "01:51:35.220",
      "formatted_end": "01:51:36.220",
      "text": "نه؟"
    },
    {
      "id": 21,
      "start": 6696.22,
      "end": 6697.22,
      "formatted_start": "01:51:36.220",
      "formatted_end": "01:51:37.220",
      "text": "نه؟"
    },
    {
      "id": 22,
      "start": 6697.22,
      "end": 6698.22,
      "formatted_start": "01:51:37.220",
      "formatted_end": "01:51:38.220",
      "text": "نه؟"
    },
    {
      "id": 23,
      "start": 6698.22,
      "end": 6699.22,
      "formatted_start": "01:51:38.220",
      "formatted_end": "01:51:39.220",
      "text": "نه؟"
    },
    {
      "id": 24,
      "start": 6699.22,
      "end": 6700.22,
      "formatted_start": "01:51:39.220",
      "formatted_end": "01:51:40.220",
      "text": "نه؟"
    },
    {
      "id": 25,
      "start": 6700.22,
      "end": 6701.22,
      "formatted_start": "01:51:40.220",
      "formatted_end": "01:51:41.220",
      "text": "نه؟"
    },
    {
      "id": 26,
      "start": 6701.22,
      "end": 6702.22,
      "formatted_start": "01:51:41.220",
      "formatted_end": "01:51:42.220",
      "text": "نه؟"
    },
    {
      "id": 27,
      "start": 6702.22,
      "end": 6703.22,
      "formatted_start": "01:51:42.220",
      "formatted_end": "01:51:43.220",
      "text": "نه؟"
    },
    {
      "id": 28,
      "start": 6703.22,
      "end": 6704.22,
      "formatted_start": "01:51:43.220",
      "formatted_end": "01:51:44.220",
      "text": "نه؟"
    },
    {
      "id": 29,
      "start": 6704.22,
      "end": 6705.22,
      "formatted_start": "01:51:44.220",
      "formatted_end": "01:51:45.220",
      "text": "نه؟"
    },
    {
      "id": 30,
      "start": 6705.22,
      "end": 6706.22,
      "formatted_start": "01:51:45.220",
      "formatted_end": "01:51:46.220",
      "text": "نه؟"
    },
    {
      "id": 31,
      "start": 6706.22,
      "end": 6707.22,
      "formatted_start": "01:51:46.220",
      "formatted_end": "01:51:47.220",
      "text": "نه؟"
    },
    {
      "id": 32,
      "start": 6707.22,
      "end": 6708.22,
      "formatted_start": "01:51:47.220",
      "formatted_end": "01:51:48.220",
      "text": "تو باش باید"
    },
    {
      "id": 33,
      "start": 6708.22,
      "end": 6710.66,
      "formatted_start": "01:51:48.220",
      "formatted_end": "01:51:50.660",
      "text": "پس اونطوری بود روز ده دفعه من اینو پرستادم"
    },
    {
      "id": 34,
      "start": 6710.66,
      "end": 6712.66,
      "formatted_start": "01:51:50.660",
      "formatted_end": "01:51:52.660",
      "text": "گفتم برای اینو بردارم"
    },
    {
      "id": 35,
      "start": 6712.66,
      "end": 6714.1,
      "formatted_start": "01:51:52.660",
      "formatted_end": "01:51:54.100",
      "text": "اینو؟"
    },
    {
      "id": 36,
      "start": 6714.1,
      "end": 6715.78,
      "formatted_start": "01:51:54.100",
      "formatted_end": "01:51:55.780",
      "text": "بلچه به خوبی"
    },
    {
      "id": 37,
      "start": 6715.78,
      "end": 6717.3,
      "formatted_start": "01:51:55.780",
      "formatted_end": "01:51:57.300",
      "text": "تو کنه تعدید من همینه"
    },
    {
      "id": 38,
      "start": 6717.3,
      "end": 6718.74,
      "formatted_start": "01:51:57.300",
      "formatted_end": "01:51:58.740",
      "text": "میگن اینو ببر به زیستی بذار"
    },
    {
      "id": 39,
      "start": 6718.74,
      "end": 6720.74,
      "formatted_start": "01:51:58.740",
      "formatted_end": "01:52:00.740",
      "text": "بیا الان من را رابط کنم"
    },
    {
      "id": 40,
      "start": 6726.82,
      "end": 6728.98,
      "formatted_start": "01:52:06.820",
      "formatted_end": "01:52:08.980",
      "text": "دقیقا ما مادرهای ما وقتی از بست کنید"
    },
    {
      "id": 41,
      "start": 6728.98,
      "end": 6730.98,
      "formatted_start": "01:52:08.980",
      "formatted_end": "01:52:10.980",
      "text": "اصلابانی بیشترن میگفتن که"
    },
    {
      "id": 42,
      "start": 6730.98,
      "end": 6732.98,
      "formatted_start": "01:52:10.980",
      "formatted_end": "01:52:12.980",
      "text": "آخر بست کن سر به بیاده"
    },
    {
      "id": 43,
      "start": 6732.98,
      "end": 6733.98,
      "formatted_start": "01:52:12.980",
      "formatted_end": "01:52:13.980",
      "text": "آه"
    },
    {
      "id": 44,
      "start": 6733.98,
      "end": 6736.98,
      "formatted_start": "01:52:13.980",
      "formatted_end": "01:52:16.980",
      "text": "مادرهای الان میگن بیایید بهتر بزیستید"
    },
    {
      "id": 45,
      "start": 6737.98,
      "end": 6739.98,
      "formatted_start": "01:52:17.980",
      "formatted_end": "01:52:19.980",
      "text": "یک جایی باشد دستون فرار"
    },
    {
      "id": 46,
      "start": 6740.98,
      "end": 6741.98,
      "formatted_start": "01:52:20.980",
      "formatted_end": "01:52:21.980",
      "text": "الان ما دیگه حسن نداریم"
    },
    {
      "id": 47,
      "start": 6741.98,
      "end": 6743.98,
      "formatted_start": "01:52:21.980",
      "formatted_end": "01:52:23.980",
      "text": "دیگه از ما رفتیم سر به بیابون بزنیم"
    },
    {
      "id": 48,
      "start": 6743.98,
      "end": 6745.98,
      "formatted_start": "01:52:23.980",
      "formatted_end": "01:52:25.980",
      "text": "ما اون زندگی ما رو بزنیم"
    },
    {
      "id": 49,
      "start": 6745.98,
      "end": 6746.98,
      "formatted_start": "01:52:25.980",
      "formatted_end": "01:52:26.980",
      "text": "این رو میرونیم بزنیم"
    },
    {
      "id": 50,
      "start": 6746.98,
      "end": 6748.98,
      "formatted_start": "01:52:26.980",
      "formatted_end": "01:52:28.980",
      "text": "مامانه من بزنم اینجور من سر به بیابون بزنم"
    },
    {
      "id": 51,
      "start": 6748.98,
      "end": 6752.98,
      "formatted_start": "01:52:28.980",
      "formatted_end": "01:52:32.980",
      "text": "اون وقت فانوس دستتون بگیریم بیایید منو پیدا کنیم"
    },
    {
      "id": 52,
      "start": 6753.98,
      "end": 6754.98,
      "formatted_start": "01:52:33.980",
      "formatted_end": "01:52:34.980",
      "text": "بیایید بزنم"
    },
    {
      "id": 53,
      "start": 6754.98,
      "end": 6755.98,
      "formatted_start": "01:52:34.980",
      "formatted_end": "01:52:35.980",
      "text": "این پسور بهتر بزیستید"
    },
    {
      "id": 54,
      "start": 6755.98,
      "end": 6757.98,
      "formatted_start": "01:52:35.980",
      "formatted_end": "01:52:37.980",
      "text": "این برای کاردرمانی"
    },
    {
      "id": 55,
      "start": 6757.98,
      "end": 6759.98,
      "formatted_start": "01:52:37.980",
      "formatted_end": "01:52:39.980",
      "text": "اینم داروهاش"
    },
    {
      "id": 56,
      "start": 6759.98,
      "end": 6761.98,
      "formatted_start": "01:52:39.980",
      "formatted_end": "01:52:41.980",
      "text": "داروهاشو بهش بره بره"
    },
    {
      "id": 57,
      "start": 6761.98,
      "end": 6765.5,
      "formatted_start": "01:52:41.980",
      "formatted_end": "01:52:45.500",
      "text": "نه نیست، این ورس نوشتم باید چیز توضیحشم رو نوشتم برای تو"
    },
    {
      "id": 58,
      "start": 6765.5,
      "end": 6766.94,
      "formatted_start": "01:52:45.500",
      "formatted_end": "01:52:46.940",
      "text": "کلاله گیه میاد دارواش؟"
    },
    {
      "id": 59,
      "start": 6766.94,
      "end": 6767.44,
      "formatted_start": "01:52:46.940",
      "formatted_end": "01:52:47.440",
      "text": "نمیگیم"
    },
    {
      "id": 60,
      "start": 6769.12,
      "end": 6770.14,
      "formatted_start": "01:52:49.120",
      "formatted_end": "01:52:50.140",
      "text": "همینجا میگه دیگه"
    },
    {
      "id": 61,
      "start": 6770.14,
      "end": 6772.86,
      "formatted_start": "01:52:50.140",
      "formatted_end": "01:52:52.860",
      "text": "همینجا میگه، بس اینجا نیرم بالانشون دارم"
    },
    {
      "id": 62,
      "start": 6772.86,
      "end": 6776.34,
      "formatted_start": "01:52:52.860",
      "formatted_end": "01:52:56.340",
      "text": "خب این گفتی بهزیستی، فرما بگم بهزیستی نشون بدم اینو"
    },
    {
      "id": 63,
      "start": 6776.34,
      "end": 6777.22,
      "formatted_start": "01:52:56.340",
      "formatted_end": "01:52:57.220",
      "text": "بگم در اونجا بدم"
    },
    {
      "id": 64,
      "start": 6777.22,
      "end": 6780.3,
      "formatted_start": "01:52:57.220",
      "formatted_end": "01:53:00.300",
      "text": "آه، و اینو گفتیم، این کاردرمونی کجایی؟"
    },
    {
      "id": 65,
      "start": 6780.3,
      "end": 6782.42,
      "formatted_start": "01:53:00.300",
      "formatted_end": "01:53:02.420",
      "text": "کاردرمونی گفتیم، درمونی شما کلاله این دیگه"
    },
    {
      "id": 66,
      "start": 6782.42,
      "end": 6785.82,
      "formatted_start": "01:53:02.420",
      "formatted_end": "01:53:05.820",
      "text": "آره کلاله نمیدونم کجاست اونو از بهتاشت رو پرسیبت"
    },
    {
      "id": 67,
      "start": 6785.82,
      "end": 6787.42,
      "formatted_start": "01:53:05.820",
      "formatted_end": "01:53:07.420",
      "text": "داره داره داره"
    },
    {
      "id": 68,
      "start": 6787.42,
      "end": 6788.7,
      "formatted_start": "01:53:07.420",
      "formatted_end": "01:53:08.700",
      "text": "همون کلاله منزون بیدم"
    },
    {
      "id": 69,
      "start": 6788.7,
      "end": 6793.38,
      "formatted_start": "01:53:08.700",
      "formatted_end": "01:53:13.380",
      "text": "اگر بهتونی بیاری بومبایت من آدرست بدم"
    },
    {
      "id": 70,
      "start": 6793.38,
      "end": 6795.16,
      "formatted_start": "01:53:13.380",
      "formatted_end": "01:53:15.160",
      "text": "ولی برای تردینه خیلی بیشتر بیدم"
    },
    {
      "id": 71,
      "start": 6795.16,
      "end": 6797.42,
      "formatted_start": "01:53:15.160",
      "formatted_end": "01:53:17.420",
      "text": "میدونم کلون بهتر عزیز؟"
    },
    {
      "id": 72,
      "start": 6798.16,
      "end": 6801.42,
      "formatted_start": "01:53:18.160",
      "formatted_end": "01:53:21.420",
      "text": "ببین من مال کلاله هم مریضای من رفتم خیلی خوب جواب گرفتم"
    },
    {
      "id": 73,
      "start": 6802.0,
      "end": 6802.86,
      "formatted_start": "01:53:22.000",
      "formatted_end": "01:53:22.860",
      "text": "رفتم؟"
    },
    {
      "id": 74,
      "start": 6802.86,
      "end": 6805.42,
      "formatted_start": "01:53:22.860",
      "formatted_end": "01:53:25.420",
      "text": "آره این شیط مریضای من مال کلاله هم دیگه"
    },
    {
      "id": 75,
      "start": 6805.98,
      "end": 6810.32,
      "formatted_start": "01:53:25.980",
      "formatted_end": "01:53:30.320",
      "text": "این روزم برای بومبایت من بهت آدرست بدم"
    },
    {
      "id": 76,
      "start": 6812.42,
      "end": 6814.42,
      "formatted_start": "01:53:32.420",
      "formatted_end": "01:53:34.420",
      "text": "برای اینجا برای اینجا برای اینجا"
    },
    {
      "id": 77,
      "start": 6814.42,
      "end": 6816.42,
      "formatted_start": "01:53:34.420",
      "formatted_end": "01:53:36.420",
      "text": "برای اینجا برای اینجا"
    },
    {
      "id": 78,
      "start": 6816.42,
      "end": 6818.42,
      "formatted_start": "01:53:36.420",
      "formatted_end": "01:53:38.420",
      "text": "شروعاش خود درمیر بود بود بود بود بود"
    },
    {
      "id": 79,
      "start": 6818.42,
      "end": 6848.42,
      "formatted_start": "01:53:38.420",
      "formatted_end": "01:54:08.420",
      "text": "از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از اینجور برداشت که از"
    },
    {
      "id": 80,
      "start": 6848.42,
      "end": 6850.42,
      "formatted_start": "01:54:08.420",
      "formatted_end": "01:54:10.420",
      "text": "با اینکه اینجا باید بردارید."
    },
    {
      "id": 81,
      "start": 6850.42,
      "end": 6852.42,
      "formatted_start": "01:54:10.420",
      "formatted_end": "01:54:12.420",
      "text": "با اینکه باید بردارید."
    },
    {
      "id": 82,
      "start": 6852.42,
      "end": 6854.42,
      "formatted_start": "01:54:12.420",
      "formatted_end": "01:54:14.420",
      "text": "با اینکه باید بردارید."
    },
    {
      "id": 83,
      "start": 6878.42,
      "end": 6899.42,
      "formatted_start": "01:54:38.420",
      "formatted_end": "01:54:59.420",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}