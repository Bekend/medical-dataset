  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6311.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:11.000",
      "text": "برای ما بخاطر کفیت در ورش رو میریزه، ما بهش میدیم، یه لغم من یه لغم بابا چیزی، شکم سیر بشه."
    },
    {
      "id": 1,
      "start": 6311.0,
      "end": 6316.0,
      "formatted_start": "01:45:11.000",
      "formatted_end": "01:45:16.000",
      "text": "باز میبنیم که خودش بخوره، شاستی نشد. برای لغم هر کلومهی لغم بشه تو بچه سیر بشه."
    },
    {
      "id": 2,
      "start": 6316.0,
      "end": 6319.0,
      "formatted_start": "01:45:16.000",
      "formatted_end": "01:45:19.000",
      "text": "تقالی به خاطر این حالتاش بود، در جای دکتر بود؟"
    },
    {
      "id": 3,
      "start": 6319.0,
      "end": 6321.0,
      "formatted_start": "01:45:19.000",
      "formatted_end": "01:45:21.000",
      "text": "نه، نه، نه، نه بودم."
    },
    {
      "id": 4,
      "start": 6321.0,
      "end": 6327.0,
      "formatted_start": "01:45:21.000",
      "formatted_end": "01:45:27.000",
      "text": "پیش دکتر قدر جمال خودم دیگه نظر اونجا بودم، افزارودگی نه، اونجا رفتم."
    },
    {
      "id": 5,
      "start": 6327.0,
      "end": 6357.0,
      "formatted_start": "01:45:27.000",
      "formatted_end": "01:45:57.000",
      "text": "از اینجور برده بودم باید برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده برده بر"
    },
    {
      "id": 6,
      "start": 6357.0,
      "end": 6359.0,
      "formatted_start": "01:45:57.000",
      "formatted_end": "01:45:59.000",
      "text": "مشکل توجه نداره"
    },
    {
      "id": 7,
      "start": 6359.0,
      "end": 6361.0,
      "formatted_start": "01:45:59.000",
      "formatted_end": "01:46:01.000",
      "text": "ببین مشکل توجه"
    },
    {
      "id": 8,
      "start": 6361.0,
      "end": 6363.0,
      "formatted_start": "01:46:01.000",
      "formatted_end": "01:46:03.000",
      "text": "بس زبونشو"
    },
    {
      "id": 9,
      "start": 6363.0,
      "end": 6365.0,
      "formatted_start": "01:46:03.000",
      "formatted_end": "01:46:05.000",
      "text": "شیریان گفتهش که زبونشو برم"
    },
    {
      "id": 10,
      "start": 6365.0,
      "end": 6367.0,
      "formatted_start": "01:46:05.000",
      "formatted_end": "01:46:07.000",
      "text": "چرا حرف نداره"
    },
    {
      "id": 11,
      "start": 6367.0,
      "end": 6369.0,
      "formatted_start": "01:46:07.000",
      "formatted_end": "01:46:09.000",
      "text": "شیریان گفتهش که زبونش گره داره"
    },
    {
      "id": 12,
      "start": 6369.0,
      "end": 6371.0,
      "formatted_start": "01:46:09.000",
      "formatted_end": "01:46:11.000",
      "text": "چند جا دیگرم بردم"
    },
    {
      "id": 13,
      "start": 6371.0,
      "end": 6373.0,
      "formatted_start": "01:46:11.000",
      "formatted_end": "01:46:13.000",
      "text": "گره داره"
    },
    {
      "id": 14,
      "start": 6373.0,
      "end": 6375.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:15.000",
      "text": "ببین عدم توجه"
    },
    {
      "id": 15,
      "start": 6375.0,
      "end": 6377.0,
      "formatted_start": "01:46:15.000",
      "formatted_end": "01:46:17.000",
      "text": "یه سنتش میشه"
    },
    {
      "id": 16,
      "start": 6377.0,
      "end": 6379.0,
      "formatted_start": "01:46:17.000",
      "formatted_end": "01:46:19.000",
      "text": "بیش فقالی"
    },
    {
      "id": 17,
      "start": 6379.0,
      "end": 6381.0,
      "formatted_start": "01:46:19.000",
      "formatted_end": "01:46:21.000",
      "text": "بشه نداره"
    },
    {
      "id": 18,
      "start": 6381.0,
      "end": 6383.0,
      "formatted_start": "01:46:21.000",
      "formatted_end": "01:46:23.000",
      "text": "یه سنتش میشه اوتیزم"
    },
    {
      "id": 19,
      "start": 6383.0,
      "end": 6385.0,
      "formatted_start": "01:46:23.000",
      "formatted_end": "01:46:25.000",
      "text": "اوتیزم نداره"
    },
    {
      "id": 20,
      "start": 6385.0,
      "end": 6389.2,
      "formatted_start": "01:46:25.000",
      "formatted_end": "01:46:29.200",
      "text": "یه سری از ارائم بیش فرق آگیرون داره، یه سری از ارائم با خود استفاده کنن"
    },
    {
      "id": 21,
      "start": 6389.2,
      "end": 6390.2,
      "formatted_start": "01:46:29.200",
      "formatted_end": "01:46:30.200",
      "text": "خب؟"
    },
    {
      "id": 22,
      "start": 6390.86,
      "end": 6393.66,
      "formatted_start": "01:46:30.860",
      "formatted_end": "01:46:33.660",
      "text": "حتماً باید دارو استفاده کنیم"
    },
    {
      "id": 23,
      "start": 6393.66,
      "end": 6395.66,
      "formatted_start": "01:46:33.660",
      "formatted_end": "01:46:35.660",
      "text": "کار درمانی ذهنی ببریم"
    },
    {
      "id": 24,
      "start": 6395.66,
      "end": 6397.66,
      "formatted_start": "01:46:35.660",
      "formatted_end": "01:46:37.660",
      "text": "و اومگاسه، اومگاسه هم یه سرگشت بشه"
    },
    {
      "id": 25,
      "start": 6397.66,
      "end": 6399.66,
      "formatted_start": "01:46:37.660",
      "formatted_end": "01:46:39.660",
      "text": "اومگاسه بشه بیدن، و ویتامین ها دیگه هم بشه بیدن"
    },
    {
      "id": 26,
      "start": 6399.66,
      "end": 6400.16,
      "formatted_start": "01:46:39.660",
      "formatted_end": "01:46:40.160",
      "text": "اومگاسه؟"
    },
    {
      "id": 27,
      "start": 6400.16,
      "end": 6405.16,
      "formatted_start": "01:46:40.160",
      "formatted_end": "01:46:45.160",
      "text": "ببینیم ویتامین و اومگاسه یه ذره کمکش میکنه ولی درمان اصلیش نداریم، خب؟"
    },
    {
      "id": 28,
      "start": 6405.16,
      "end": 6409.8,
      "formatted_start": "01:46:45.160",
      "formatted_end": "01:46:49.800",
      "text": "بعد، کار درمانی ذهنی باید ببریش، گفتار درمانی باید ببریش"
    },
    {
      "id": 29,
      "start": 6409.8,
      "end": 6413.72,
      "formatted_start": "01:46:49.800",
      "formatted_end": "01:46:53.720",
      "text": "یه اگر به بچه تا روز سیدگی کنی میتونه مثل یه بچه عادی بشه"
    },
    {
      "id": 30,
      "start": 6413.72,
      "end": 6416.72,
      "formatted_start": "01:46:53.720",
      "formatted_end": "01:46:56.720",
      "text": "من آن دکتور شیریان گفتیم بچه خوب نمیشه تو شمون زد"
    },
    {
      "id": 31,
      "start": 6416.72,
      "end": 6418.4,
      "formatted_start": "01:46:56.720",
      "formatted_end": "01:46:58.400",
      "text": "باید بگیر میکنه دور یک کننه ماما"
    },
    {
      "id": 32,
      "start": 6418.4,
      "end": 6420.92,
      "formatted_start": "01:46:58.400",
      "formatted_end": "01:47:00.920",
      "text": "ببین دکتور شیریان برای متخص اطفال"
    },
    {
      "id": 33,
      "start": 6420.92,
      "end": 6422.52,
      "formatted_start": "01:47:00.920",
      "formatted_end": "01:47:02.520",
      "text": "نه، حلقه بینه گوشه"
    },
    {
      "id": 34,
      "start": 6422.52,
      "end": 6425.32,
      "formatted_start": "01:47:02.520",
      "formatted_end": "01:47:05.320",
      "text": "نه، حلقه خوب میشه، امید داره خوب بشه"
    },
    {
      "id": 35,
      "start": 6425.32,
      "end": 6429.62,
      "formatted_start": "01:47:05.320",
      "formatted_end": "01:47:09.620",
      "text": "این نگران نمیخواد باشه ولی به گیری لازمه"
    },
    {
      "id": 36,
      "start": 6429.62,
      "end": 6434.92,
      "formatted_start": "01:47:09.620",
      "formatted_end": "01:47:14.920",
      "text": "این یه چیزی مثل سرمخوردگیه من الان به دارو میدن همینطور که بخواهم"
    },
    {
      "id": 37,
      "start": 6434.92,
      "end": 6440.3,
      "formatted_start": "01:47:14.920",
      "formatted_end": "01:47:20.300",
      "text": "ولی یه چیزی مثل مثلا دیابته تا آخر اون باید یکی دارو میخواهم"
    },
    {
      "id": 38,
      "start": 6440.3,
      "end": 6444.34,
      "formatted_start": "01:47:20.300",
      "formatted_end": "01:47:24.340",
      "text": "ولی این یه چیزیه که درمانش طولانی"
    },
    {
      "id": 39,
      "start": 6444.34,
      "end": 6449.72,
      "formatted_start": "01:47:24.340",
      "formatted_end": "01:47:29.720",
      "text": "درمانش اینه که مثلا فقط دارو نیست در کنارش کارایی گرم باید انجام بدون"
    },
    {
      "id": 40,
      "start": 6449.72,
      "end": 6452.88,
      "formatted_start": "01:47:29.720",
      "formatted_end": "01:47:32.880",
      "text": "و خودت میبینید چقدر بهتر میشه"
    },
    {
      "id": 41,
      "start": 6452.88,
      "end": 6454.88,
      "formatted_start": "01:47:32.880",
      "formatted_end": "01:47:34.880",
      "text": "اصلا بچه از این رو به قوم میشه"
    },
    {
      "id": 42,
      "start": 6454.88,
      "end": 6455.88,
      "formatted_start": "01:47:34.880",
      "formatted_end": "01:47:35.880",
      "text": "خب؟"
    },
    {
      "id": 43,
      "start": 6455.88,
      "end": 6457.88,
      "formatted_start": "01:47:35.880",
      "formatted_end": "01:47:37.880",
      "text": "بشرت این که"
    },
    {
      "id": 44,
      "start": 6457.88,
      "end": 6459.88,
      "formatted_start": "01:47:37.880",
      "formatted_end": "01:47:39.880",
      "text": "بشرت این که فرمت منو"
    },
    {
      "id": 45,
      "start": 6459.88,
      "end": 6461.88,
      "formatted_start": "01:47:39.880",
      "formatted_end": "01:47:41.880",
      "text": "خوش بدی خب؟"
    },
    {
      "id": 46,
      "start": 6461.88,
      "end": 6463.88,
      "formatted_start": "01:47:41.880",
      "formatted_end": "01:47:43.880",
      "text": "اگر که با همدیگه"
    },
    {
      "id": 47,
      "start": 6463.88,
      "end": 6465.88,
      "formatted_start": "01:47:43.880",
      "formatted_end": "01:47:45.880",
      "text": "تیگیری بخونیم"
    },
    {
      "id": 48,
      "start": 6465.88,
      "end": 6467.88,
      "formatted_start": "01:47:45.880",
      "formatted_end": "01:47:47.880",
      "text": "همونطوری که من میگم انجام بشه"
    },
    {
      "id": 49,
      "start": 6467.88,
      "end": 6469.88,
      "formatted_start": "01:47:47.880",
      "formatted_end": "01:47:49.880",
      "text": "خوب شدن"
    },
    {
      "id": 50,
      "start": 6469.88,
      "end": 6471.88,
      "formatted_start": "01:47:49.880",
      "formatted_end": "01:47:51.880",
      "text": "خیلی بهتر شدن"
    },
    {
      "id": 51,
      "start": 6471.88,
      "end": 6473.88,
      "formatted_start": "01:47:51.880",
      "formatted_end": "01:47:53.880",
      "text": "نه نتیجه گرفتن"
    },
    {
      "id": 52,
      "start": 6473.88,
      "end": 6475.88,
      "formatted_start": "01:47:53.880",
      "formatted_end": "01:47:55.880",
      "text": "خیلی بهتر شدن"
    },
    {
      "id": 53,
      "start": 6475.88,
      "end": 6477.88,
      "formatted_start": "01:47:55.880",
      "formatted_end": "01:47:57.880",
      "text": "خب حالا شاید مثلاً"
    },
    {
      "id": 54,
      "start": 6477.88,
      "end": 6479.88,
      "formatted_start": "01:47:57.880",
      "formatted_end": "01:47:59.880",
      "text": "بازم قسمت به بچه یه معموله بگیشد"
    },
    {
      "id": 55,
      "start": 6479.88,
      "end": 6481.88,
      "formatted_start": "01:47:59.880",
      "formatted_end": "01:48:01.880",
      "text": "یه برای این چیزشون باشه"
    },
    {
      "id": 56,
      "start": 6481.88,
      "end": 6483.88,
      "formatted_start": "01:48:01.880",
      "formatted_end": "01:48:03.880",
      "text": "ولی واقعاً کنستن وزیرا عادی برن"
    },
    {
      "id": 57,
      "start": 6483.88,
      "end": 6485.88,
      "formatted_start": "01:48:03.880",
      "formatted_end": "01:48:05.880",
      "text": "اینقدر شان حفظ زدنشون خوب شده"
    },
    {
      "id": 58,
      "start": 6485.88,
      "end": 6487.88,
      "formatted_start": "01:48:05.880",
      "formatted_end": "01:48:07.880",
      "text": "مثلا این حالت"
    },
    {
      "id": 59,
      "start": 6487.88,
      "end": 6489.88,
      "formatted_start": "01:48:07.880",
      "formatted_end": "01:48:09.880",
      "text": "باید بیش فرق"
    },
    {
      "id": 60,
      "start": 6489.88,
      "end": 6491.88,
      "formatted_start": "01:48:09.880",
      "formatted_end": "01:48:11.880",
      "text": "خیلی همه روونه"
    },
    {
      "id": 61,
      "start": 6491.88,
      "end": 6493.88,
      "formatted_start": "01:48:11.880",
      "formatted_end": "01:48:13.880",
      "text": "اگه ارگان روش اونوری باشه"
    },
    {
      "id": 62,
      "start": 6493.88,
      "end": 6495.88,
      "formatted_start": "01:48:13.880",
      "formatted_end": "01:48:15.880",
      "text": "مثلا ما که یه اطلاع دیگه باشیم"
    },
    {
      "id": 63,
      "start": 6495.88,
      "end": 6499.12,
      "formatted_start": "01:48:15.880",
      "formatted_end": "01:48:19.120",
      "text": "اوه اوه اوه دیگه باشیم درش بادرو سدای چیپسینا بیاد"
    },
    {
      "id": 64,
      "start": 6499.12,
      "end": 6501.12,
      "formatted_start": "01:48:19.120",
      "formatted_end": "01:48:21.120",
      "text": "سدای خوردنی خوردیون در اینجا میاد"
    },
    {
      "id": 65,
      "start": 6501.12,
      "end": 6503.12,
      "formatted_start": "01:48:21.120",
      "formatted_end": "01:48:23.120",
      "text": "اینا اینا خوششون خیلی خوبه"
    },
    {
      "id": 66,
      "start": 6503.12,
      "end": 6505.12,
      "formatted_start": "01:48:23.120",
      "formatted_end": "01:48:25.120",
      "text": "خب؟ ولی داریم ما"
    },
    {
      "id": 67,
      "start": 6505.12,
      "end": 6507.12,
      "formatted_start": "01:48:25.120",
      "formatted_end": "01:48:27.120",
      "text": "مغزمون و"
    },
    {
      "id": 68,
      "start": 6507.12,
      "end": 6509.12,
      "formatted_start": "01:48:27.120",
      "formatted_end": "01:48:29.120",
      "text": "اینجا مغز"
    },
    {
      "id": 69,
      "start": 6509.12,
      "end": 6511.12,
      "formatted_start": "01:48:29.120",
      "formatted_end": "01:48:31.120",
      "text": "مغزمون دو قسمت داره"
    },
    {
      "id": 70,
      "start": 6511.12,
      "end": 6513.12,
      "formatted_start": "01:48:31.120",
      "formatted_end": "01:48:33.120",
      "text": "این مغزه خب؟ یکی ماده سفیده"
    },
    {
      "id": 71,
      "start": 6513.12,
      "end": 6515.12,
      "formatted_start": "01:48:33.120",
      "formatted_end": "01:48:35.120",
      "text": "که حوشمون"
    },
    {
      "id": 72,
      "start": 6515.12,
      "end": 6517.12,
      "formatted_start": "01:48:35.120",
      "formatted_end": "01:48:37.120",
      "text": "نمیدونم مهربونیمون"
    },
    {
      "id": 73,
      "start": 6517.12,
      "end": 6519.12,
      "formatted_start": "01:48:37.120",
      "formatted_end": "01:48:39.120",
      "text": "کارهایی که انجام کرده"
    },
    {
      "id": 74,
      "start": 6519.12,
      "end": 6521.12,
      "formatted_start": "01:48:39.120",
      "formatted_end": "01:48:41.120",
      "text": "اینا تو ماده سفیده"
    },
    {
      "id": 75,
      "start": 6521.12,
      "end": 6523.12,
      "formatted_start": "01:48:41.120",
      "formatted_end": "01:48:43.120",
      "text": "ولی یک قشن خاکستری داریم"
    },
    {
      "id": 76,
      "start": 6523.12,
      "end": 6526.62,
      "formatted_start": "01:48:43.120",
      "formatted_end": "01:48:46.620",
      "text": "که میاد کارهای بخش سفید رو کنترل میکنند"
    },
    {
      "id": 77,
      "start": 6526.62,
      "end": 6527.12,
      "formatted_start": "01:48:46.620",
      "formatted_end": "01:48:47.120",
      "text": "خب؟"
    },
    {
      "id": 78,
      "start": 6527.12,
      "end": 6531.62,
      "formatted_start": "01:48:47.120",
      "formatted_end": "01:48:51.620",
      "text": "ما الان این خاک سریع این رو خوب کنترل نمیکنیم"
    },
    {
      "id": 79,
      "start": 6531.62,
      "end": 6535.12,
      "formatted_start": "01:48:51.620",
      "formatted_end": "01:48:55.120",
      "text": "مثلا این الان بخوادید داد بزنه"
    },
    {
      "id": 80,
      "start": 6535.12,
      "end": 6537.12,
      "formatted_start": "01:48:55.120",
      "formatted_end": "01:48:57.120",
      "text": "من الان بخواهم داد بزنم"
    },
    {
      "id": 81,
      "start": 6537.12,
      "end": 6539.62,
      "formatted_start": "01:48:57.120",
      "formatted_end": "01:48:59.620",
      "text": "یکی به من میگه نه الان وقتی داد بزنم"
    },
    {
      "id": 82,
      "start": 6539.62,
      "end": 6541.12,
      "formatted_start": "01:48:59.620",
      "formatted_end": "01:49:01.120",
      "text": "دستانی که این بچه این رو بیدی؟"
    },
    {
      "id": 83,
      "start": 6541.12,
      "end": 6541.62,
      "formatted_start": "01:49:01.120",
      "formatted_end": "01:49:01.620",
      "text": "نیست"
    },
    {
      "id": 84,
      "start": 6541.62,
      "end": 6543.12,
      "formatted_start": "01:49:01.620",
      "formatted_end": "01:49:03.120",
      "text": "کنترلش کمی"
    },
    {
      "id": 85,
      "start": 6543.12,
      "end": 6544.62,
      "formatted_start": "01:49:03.120",
      "formatted_end": "01:49:04.620",
      "text": "کنترل و کاراش کمی"
    },
    {
      "id": 86,
      "start": 6544.62,
      "end": 6545.62,
      "formatted_start": "01:49:04.620",
      "formatted_end": "01:49:05.620",
      "text": "خب؟"
    },
    {
      "id": 87,
      "start": 6545.62,
      "end": 6547.62,
      "formatted_start": "01:49:05.620",
      "formatted_end": "01:49:07.620",
      "text": "این رو باید ما درمانش بخواییم"
    },
    {
      "id": 88,
      "start": 6547.62,
      "end": 6548.62,
      "formatted_start": "01:49:07.620",
      "formatted_end": "01:49:08.620",
      "text": "خب ببین"
    },
    {
      "id": 89,
      "start": 6550.12,
      "end": 6551.62,
      "formatted_start": "01:49:10.120",
      "formatted_end": "01:49:11.620",
      "text": "یک قرص براش نمیشتم"
    },
    {
      "id": 90,
      "start": 6551.62,
      "end": 6553.92,
      "formatted_start": "01:49:11.620",
      "formatted_end": "01:49:13.920",
      "text": "نه، حرف زاده هستن و این کار رد داره"
    },
    {
      "id": 91,
      "start": 6553.92,
      "end": 6556.22,
      "formatted_start": "01:49:13.920",
      "formatted_end": "01:49:16.220",
      "text": "یعنی نیاز نیست مدرسه بسیاری"
    },
    {
      "id": 92,
      "start": 6556.22,
      "end": 6557.78,
      "formatted_start": "01:49:16.220",
      "formatted_end": "01:49:17.780",
      "text": "باید خاندوتون هم خواهیم بباشه"
    },
    {
      "id": 93,
      "start": 6557.78,
      "end": 6559.52,
      "formatted_start": "01:49:17.780",
      "formatted_end": "01:49:19.520",
      "text": "پیشتبستانی ببارمش"
    },
    {
      "id": 94,
      "start": 6559.52,
      "end": 6560.32,
      "formatted_start": "01:49:19.520",
      "formatted_end": "01:49:20.320",
      "text": "الان نه"
    },
    {
      "id": 95,
      "start": 6560.32,
      "end": 6562.32,
      "formatted_start": "01:49:20.320",
      "formatted_end": "01:49:22.320",
      "text": "نه، خاندوتون میخوام توی بچه ها باشه"
    },
    {
      "id": 96,
      "start": 6562.32,
      "end": 6565.12,
      "formatted_start": "01:49:22.320",
      "formatted_end": "01:49:25.120",
      "text": "نه، نه باشه الان بره اونجا"
    },
    {
      "id": 97,
      "start": 6565.12,
      "end": 6567.52,
      "formatted_start": "01:49:25.120",
      "formatted_end": "01:49:27.520",
      "text": "نه تونه با بچه ها حرف بزنه"
    },
    {
      "id": 98,
      "start": 6567.52,
      "end": 6569.62,
      "formatted_start": "01:49:27.520",
      "formatted_end": "01:49:29.620",
