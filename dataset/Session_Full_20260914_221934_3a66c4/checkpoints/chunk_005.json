  "stt_segments": [
    {
      "id": 0,
      "start": 1500.0,
      "end": 1502.0,
      "formatted_start": "00:25:00.000",
      "formatted_end": "00:25:02.000",
      "text": "خودتون را بردارید."
    },
    {
      "id": 1,
      "start": 1502.0,
      "end": 1504.0,
      "formatted_start": "00:25:02.000",
      "formatted_end": "00:25:04.000",
      "text": "خودتون را بردارید."
    },
    {
      "id": 2,
      "start": 1530.0,
      "end": 1537.24,
      "formatted_start": "00:25:30.000",
      "formatted_end": "00:25:37.240",
      "text": "خب 3 سند میشه 153"
    },
    {
      "id": 3,
      "start": 1537.24,
      "end": 1538.3,
      "formatted_start": "00:25:37.240",
      "formatted_end": "00:25:38.300",
      "text": "خب"
    },
    {
      "id": 4,
      "start": 1538.3,
      "end": 1540.88,
      "formatted_start": "00:25:38.300",
      "formatted_end": "00:25:40.880",
      "text": "یه سند و سند رو کفششه بیگه"
    },
    {
      "id": 5,
      "start": 1540.88,
      "end": 1541.6,
      "formatted_start": "00:25:40.880",
      "formatted_end": "00:25:41.600",
      "text": "داریم"
    },
    {
      "id": 6,
      "start": 1541.6,
      "end": 1545.62,
      "formatted_start": "00:25:41.600",
      "formatted_end": "00:25:45.620",
      "text": "یه کنیم سند رو کفششه"
    },
    {
      "id": 7,
      "start": 1545.62,
      "end": 1547.12,
      "formatted_start": "00:25:45.620",
      "formatted_end": "00:25:47.120",
      "text": "میشه 153"
    },
    {
      "id": 8,
      "start": 1547.12,
      "end": 1548.0,
      "formatted_start": "00:25:47.120",
      "formatted_end": "00:25:48.000",
      "text": "یه کنیم"
    },
    {
      "id": 9,
      "start": 1548.0,
      "end": 1548.54,
      "formatted_start": "00:25:48.000",
      "formatted_end": "00:25:48.540",
      "text": "خب"
    },
    {
      "id": 10,
      "start": 1548.54,
      "end": 1554.0,
      "formatted_start": "00:25:48.540",
      "formatted_end": "00:25:54.000",
      "text": "سندش رو بذاره"
    },
    {
      "id": 11,
      "start": 1554.0,
      "end": 1556.36,
      "formatted_start": "00:25:54.000",
      "formatted_end": "00:25:56.360",
      "text": "میشه 11"
    },
    {
      "id": 12,
      "start": 1556.36,
      "end": 1558.62,
      "formatted_start": "00:25:56.360",
      "formatted_end": "00:25:58.620",
      "text": "کنم در وضعی چند ماه مونده"
    },
    {
      "id": 13,
      "start": 1558.62,
      "end": 1560.62,
      "formatted_start": "00:25:58.620",
      "formatted_end": "00:26:00.620",
      "text": "یازده اونیم به طرف من"
    },
    {
      "id": 14,
      "start": 1560.62,
      "end": 1564.62,
      "formatted_start": "00:26:00.620",
      "formatted_end": "00:26:04.620",
      "text": "خب بلیگه دختر یازده اونیم ساله"
    },
    {
      "id": 15,
      "start": 1564.62,
      "end": 1567.62,
      "formatted_start": "00:26:04.620",
      "formatted_end": "00:26:07.620",
      "text": "با قدر صد و پنجاهون"
    },
    {
      "id": 16,
      "start": 1567.62,
      "end": 1571.62,
      "formatted_start": "00:26:07.620",
      "formatted_end": "00:26:11.620",
      "text": "مثلا بین صد و چهرونو تا صد و پنجاهون"
    },
    {
      "id": 17,
      "start": 1571.62,
      "end": 1573.62,
      "formatted_start": "00:26:11.620",
      "formatted_end": "00:26:13.620",
      "text": "باید صد و پنجاهون باشه"
    },
    {
      "id": 18,
      "start": 1573.62,
      "end": 1576.62,
      "formatted_start": "00:26:13.620",
      "formatted_end": "00:26:16.620",
      "text": "آه سه کیرو اضافه دارم"
    },
    {
      "id": 19,
      "start": 1576.62,
      "end": 1578.62,
      "formatted_start": "00:26:16.620",
      "formatted_end": "00:26:18.620",
      "text": "حالا اینو با لباسهاش دو کیرو اضافه"
    },
    {
      "id": 20,
      "start": 1578.62,
      "end": 1579.62,
      "formatted_start": "00:26:18.620",
      "formatted_end": "00:26:19.620",
      "text": "خیلی اضافه نداره"
    },
    {
      "id": 21,
      "start": 1579.62,
      "end": 1580.62,
      "formatted_start": "00:26:19.620",
      "formatted_end": "00:26:20.620",
      "text": "نه خیلی اضافه نداره"
    },
    {
      "id": 22,
      "start": 1580.62,
      "end": 1581.62,
      "formatted_start": "00:26:20.620",
      "formatted_end": "00:26:21.620",
      "text": "آه خیلی اضافه نداره"
    },
    {
      "id": 23,
      "start": 1581.62,
      "end": 1582.62,
      "formatted_start": "00:26:21.620",
      "formatted_end": "00:26:22.620",
      "text": "به قدرش پاشاترش برم داره"
    },
    {
      "id": 24,
      "start": 1582.62,
      "end": 1586.62,
      "formatted_start": "00:26:22.620",
      "formatted_end": "00:26:26.620",
      "text": "ولی نباید بذاره عرضی اون بیشتر بشه بگه"
    },
    {
      "id": 25,
      "start": 1586.62,
      "end": 1590.62,
      "formatted_start": "00:26:26.620",
      "formatted_end": "00:26:30.620",
      "text": "همین که اینو ثابت نگهت داری وزن تو این موهبه"
    },
    {
      "id": 26,
      "start": 1590.62,
      "end": 1594.62,
      "formatted_start": "00:26:30.620",
      "formatted_end": "00:26:34.620",
      "text": "باشه عزیزم خدمت شما"
    },
    {
      "id": 27,
      "start": 1594.62,
      "end": 1598.62,
      "formatted_start": "00:26:34.620",
      "formatted_end": "00:26:38.620",
      "text": "ببین ناتروکسنشو"
    },
    {
      "id": 28,
      "start": 1598.62,
      "end": 1602.62,
      "formatted_start": "00:26:38.620",
      "formatted_end": "00:26:42.620",
      "text": "هر در روز ده ساعت یه دونه"
    },
    {
      "id": 29,
      "start": 1602.62,
      "end": 1606.62,
      "formatted_start": "00:26:42.620",
      "formatted_end": "00:26:46.620",
      "text": "بعد از غذا بخوره اینو تا دو روز بخوره"
    },
    {
      "id": 30,
      "start": 1606.62,
      "end": 1610.62,
      "formatted_start": "00:26:46.620",
      "formatted_end": "00:26:50.620",
      "text": "اسلام الافرن در صورت تن"
    },
    {
      "id": 31,
      "start": 1610.62,
      "end": 1617.62,
      "formatted_start": "00:26:50.620",
      "formatted_end": "00:26:57.620",
      "text": "یا بدنده یک گره هر چهار الى شیش ساعت"
    },
    {
      "id": 32,
      "start": 1617.62,
      "end": 1624.62,
      "formatted_start": "00:26:57.620",
      "formatted_end": "00:27:04.620",
      "text": "و یک اسپری نمیشتم برای گرفتگی از شب یک رو بزنیم"
    },
    {
      "id": 33,
      "start": 1624.62,
      "end": 1626.62,
      "formatted_start": "00:27:04.620",
      "formatted_end": "00:27:06.620",
      "text": "خوب"
    },
    {
      "id": 34,
      "start": 1626.62,
      "end": 1628.62,
      "formatted_start": "00:27:06.620",
      "formatted_end": "00:27:08.620",
      "text": "شیخ میشه یا خصوصی؟"
    },
    {
      "id": 35,
      "start": 1628.62,
