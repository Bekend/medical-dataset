  "stt_segments": [
    {
      "id": 0,
      "start": 1200.0,
      "end": 1202.0,
      "formatted_start": "00:20:00.000",
      "formatted_end": "00:20:02.000",
      "text": "کلس چند رو شدی؟"
    },
    {
      "id": 1,
      "start": 1202.0,
      "end": 1204.0,
      "formatted_start": "00:20:02.000",
      "formatted_end": "00:20:04.000",
      "text": "سویم شیشا"
    },
    {
      "id": 2,
      "start": 1204.0,
      "end": 1206.0,
      "formatted_start": "00:20:04.000",
      "formatted_end": "00:20:06.000",
      "text": "شیشا، هزار ما شاید."
    },
    {
      "id": 3,
      "start": 1206.0,
      "end": 1207.0,
      "formatted_start": "00:20:06.000",
      "formatted_end": "00:20:07.000",
      "text": "شما خوبی؟"
    },
    {
      "id": 4,
      "start": 1207.0,
      "end": 1208.0,
      "formatted_start": "00:20:07.000",
      "formatted_end": "00:20:08.000",
      "text": "ممنونم ماجده"
    },
    {
      "id": 5,
      "start": 1208.0,
      "end": 1209.0,
      "formatted_start": "00:20:08.000",
      "formatted_end": "00:20:09.000",
      "text": "چه خبراتی شده؟"
    },
    {
      "id": 6,
      "start": 1209.0,
      "end": 1210.0,
      "formatted_start": "00:20:09.000",
      "formatted_end": "00:20:10.000",
      "text": "برابر"
    },
    {
      "id": 7,
      "start": 1210.0,
      "end": 1218.0,
      "formatted_start": "00:20:10.000",
      "formatted_end": "00:20:18.000",
      "text": "خانم دکتر، دیروز تب داره همه چیز، تب می کنه، دیشبت دورت خیلی شعیب بود، ما مجبور شدیم برای شیشی آب استفاده کنیم."
    },
    {
      "id": 8,
      "start": 1218.0,
      "end": 1220.0,
      "formatted_start": "00:20:18.000",
      "formatted_end": "00:20:20.000",
      "text": "خب، دیگه چه علاماتی داره؟"
    },
    {
      "id": 9,
      "start": 1220.0,
      "end": 1222.0,
      "formatted_start": "00:20:20.000",
      "formatted_end": "00:20:22.000",
      "text": "داریم بینیش که فقط..."
    },
    {
      "id": 10,
      "start": 1222.0,
      "end": 1223.0,
      "formatted_start": "00:20:22.000",
      "formatted_end": "00:20:23.000",
      "text": "گل و درد داری؟"
    },
    {
      "id": 11,
      "start": 1223.0,
      "end": 1224.0,
      "formatted_start": "00:20:23.000",
      "formatted_end": "00:20:24.000",
      "text": "نه"
    },
    {
      "id": 12,
      "start": 1224.0,
      "end": 1254.0,
      "formatted_start": "00:20:24.000",
      "formatted_end": "00:20:54.000",
      "text": "از اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه برداری"
    },
    {
      "id": 13,
      "start": 1254.0,
      "end": 1264.0,
      "formatted_start": "00:20:54.000",
      "formatted_end": "00:21:04.000",
      "text": "برندن داری باشه"
    },
    {
      "id": 14,
      "start": 1264.0,
      "end": 1266.0,
      "formatted_start": "00:21:04.000",
      "formatted_end": "00:21:06.000",
      "text": "برندن"
    },
    {
      "id": 15,
      "start": 1266.0,
      "end": 1268.0,
      "formatted_start": "00:21:06.000",
      "formatted_end": "00:21:08.000",
      "text": "نخیلی"
    },
    {
      "id": 16,
      "start": 1268.0,
      "end": 1270.0,
      "formatted_start": "00:21:08.000",
      "formatted_end": "00:21:10.000",
      "text": "نه مثلا احساس کنی خسته"
    },
    {
      "id": 17,
      "start": 1270.0,
      "end": 1272.0,
      "formatted_start": "00:21:10.000",
      "formatted_end": "00:21:12.000",
      "text": "چون اینجوری است"
    },
    {
      "id": 18,
      "start": 1272.0,
      "end": 1276.0,
      "formatted_start": "00:21:12.000",
      "formatted_end": "00:21:16.000",
      "text": "نفسو کر"
    },
    {
      "id": 19,
      "start": 1276.0,
      "end": 1278.0,
      "formatted_start": "00:21:16.000",
      "formatted_end": "00:21:18.000",
      "text": "نفسو کر"
    },
    {
      "id": 20,
      "start": 1278.0,
      "end": 1280.0,
      "formatted_start": "00:21:18.000",
      "formatted_end": "00:21:20.000",
      "text": "نفسو"
    },
    {
      "id": 21,
      "start": 1280.0,
      "end": 1282.0,
      "formatted_start": "00:21:20.000",
      "formatted_end": "00:21:22.000",
      "text": "نفسو"
    },
    {
      "id": 22,
      "start": 1282.0,
      "end": 1290.0,
      "formatted_start": "00:21:22.000",
      "formatted_end": "00:21:30.000",
      "text": "ببین هیچ جاش اوفانت نداره، سینه ش خوبه، گرمش خوبه، گوشش خوبه، خوب"
    },
    {
      "id": 23,
      "start": 1290.0,
      "end": 1295.0,
      "formatted_start": "00:21:30.000",
      "formatted_end": "00:21:35.000",
      "text": "حالت مفرد این سوزش ادران نداری، میردست شونی؟"
    },
    {
      "id": 24,
      "start": 1295.0,
      "end": 1296.0,
      "formatted_start": "00:21:35.000",
      "formatted_end": "00:21:36.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 1296.0,
      "end": 1307.0,
      "formatted_start": "00:21:36.000",
      "formatted_end": "00:21:47.000",
      "text": "خب اون از ادران نداری خیال مقاعده، اینا ویروس هست دیگه، ویروس های سرم و خوردگی انا شایه شده، تب میده و او نه تو فصل از دیگه فصل پایزه اینا شروع بشه"
    },
    {
      "id": 26,
      "start": 1307.0,
      "end": 1310.06,
      "formatted_start": "00:21:47.000",
      "formatted_end": "00:21:50.060",
      "text": "تب میدونید یک ذره علایم سرم و کردگی"
    },
    {
      "id": 27,
      "start": 1310.06,
      "end": 1312.76,
      "formatted_start": "00:21:50.060",
      "formatted_end": "00:21:52.760",
      "text": "ما این رو کمی کنیم هیچ افونتی نداریم"
    },
    {
      "id": 28,
      "start": 1312.76,
      "end": 1316.06,
      "formatted_start": "00:21:52.760",
      "formatted_end": "00:21:56.060",
      "text": "دارو براش میدونیم بهتری درمانش استراحته"
    },
    {
      "id": 29,
      "start": 1316.06,
      "end": 1317.88,
      "formatted_start": "00:21:56.060",
      "formatted_end": "00:21:57.880",
      "text": "غذاهای مقوی بخور"
    },
    {
      "id": 30,
      "start": 1317.88,
      "end": 1319.88,
      "formatted_start": "00:21:57.880",
      "formatted_end": "00:21:59.880",
      "text": "مایات زیاد بخور خوبش"
    },
    {
      "id": 31,
      "start": 1319.88,
      "end": 1321.04,
      "formatted_start": "00:21:59.880",
      "formatted_end": "00:22:01.040",
      "text": "خب؟"
    },
    {
      "id": 32,
      "start": 1321.04,
      "end": 1322.66,
      "formatted_start": "00:22:01.040",
      "formatted_end": "00:22:02.660",
      "text": "ما این دارو هایی که من براتون میدونیم"
    },
    {
      "id": 33,
      "start": 1322.66,
      "end": 1325.22,
      "formatted_start": "00:22:02.660",
      "formatted_end": "00:22:05.220",
      "text": "ارس میتونی بخور داشتن"
    },
    {
      "id": 34,
      "start": 1325.22,
      "end": 1333.8,
      "formatted_start": "00:22:05.220",
      "formatted_end": "00:22:13.800",
      "text": "آره تبشن میدین دارو خواهیم"
    },
    {
      "id": 35,
      "start": 1333.8,
      "end": 1334.54,
      "formatted_start": "00:22:13.800",
      "formatted_end": "00:22:14.540",
      "text": "آره سیزم"
    },
    {
      "id": 36,
      "start": 1334.54,
      "end": 1336.18,
      "formatted_start": "00:22:14.540",
      "formatted_end": "00:22:16.180",
      "text": "خب"
    },
    {
      "id": 37,
      "start": 1336.18,
      "end": 1342.18,
      "formatted_start": "00:22:16.180",
      "formatted_end": "00:22:22.180",
      "text": "شما تو خونه چی دادین بهش برداشت؟ فقط شیاف بذاشتین؟"
    },
    {
      "id": 38,
      "start": 1342.18,
      "end": 1346.18,
      "formatted_start": "00:22:22.180",
      "formatted_end": "00:22:26.180",
      "text": "شیاف بله، اول دو گوشو بهش اسکامینوفن دادم"
    },
    {
      "id": 39,
      "start": 1346.18,
      "end": 1347.18,
      "formatted_start": "00:22:26.180",
      "formatted_end": "00:22:27.180",
      "text": "آها"
    },
    {
      "id": 40,
      "start": 1347.18,
      "end": 1349.18,
      "formatted_start": "00:22:27.180",
      "formatted_end": "00:22:29.180",
      "text": "ولی دیدم اصلا نفرده"
    },
    {
      "id": 41,
      "start": 1349.18,
      "end": 1352.18,
      "formatted_start": "00:22:29.180",
      "formatted_end": "00:22:32.180",
      "text": "نه بگه، با وزن این اصلا نمیکنه، گورسشو برداشتیم"
    },
    {
      "id": 42,
      "start": 1352.18,
      "end": 1355.18,
      "formatted_start": "00:22:32.180",
      "formatted_end": "00:22:35.180",
      "text": "نداشتیم گورسشو، این مطلوب شیاف اسکامینوفن است"
    },
    {
      "id": 43,
      "start": 1355.18,
      "end": 1357.18,
      "formatted_start": "00:22:35.180",
      "formatted_end": "00:22:37.180",
      "text": "چند کیلو بودی؟"
    },
    {
      "id": 44,
      "start": 1357.18,
      "end": 1358.18,
      "formatted_start": "00:22:37.180",
      "formatted_end": "00:22:38.180",
      "text": "چند کیلو رو کافتیم؟"
    },
    {
      "id": 45,
      "start": 1358.18,
      "end": 1360.18,
      "formatted_start": "00:22:38.180",
      "formatted_end": "00:22:40.180",
      "text": "چه رو نه هفت سر"
    },
    {
      "id": 46,
      "start": 1360.18,
      "end": 1362.18,
      "formatted_start": "00:22:40.180",
      "formatted_end": "00:22:42.180",
      "text": "اسکامینوفن 500 براش میده بود"
    },
    {
      "id": 47,
      "start": 1362.18,
      "end": 1366.02,
      "formatted_start": "00:22:42.180",
      "formatted_end": "00:22:46.020",
      "text": "خب، هر 6 ساعت اگر تب داشت بهش بده"
    },
    {
      "id": 48,
      "start": 1367.56,
      "end": 1370.42,
      "formatted_start": "00:22:47.560",
      "formatted_end": "00:22:50.420",
      "text": "بعد براشه خورس ناکروکسن می نکسن"
    },
    {
      "id": 49,
      "start": 1373.9,
      "end": 1377.94,
      "formatted_start": "00:22:53.900",
      "formatted_end": "00:22:57.940",
      "text": "هر 12 ساعت یکی مونه تا دو روز بهش بده"
    },
    {
      "id": 50,
      "start": 1377.94,
      "end": 1378.44,
      "formatted_start": "00:22:57.940",
      "formatted_end": "00:22:58.440",
      "text": "بله"
    },
    {
      "id": 51,
      "start": 1378.44,
      "end": 1380.4,
      "formatted_start": "00:22:58.440",
      "formatted_end": "00:23:00.400",
      "text": "و یه اسپره یه دیر"
    },
    {
      "id": 52,
      "start": 1385.56,
      "end": 1387.56,
      "formatted_start": "00:23:05.560",
      "formatted_end": "00:23:07.560",
      "text": "خب، بی کم این دیران می خوره؟"
    },
    {
      "id": 53,
      "start": 1388.5,
      "end": 1390.5,
      "formatted_start": "00:23:08.500",
      "formatted_end": "00:23:10.500",
      "text": "دی سه می خوره"
    },
    {
      "id": 54,
      "start": 1390.5,
      "end": 1394.5,
      "formatted_start": "00:23:10.500",
      "formatted_end": "00:23:14.500",
      "text": "از شمبه گو جا شمبه"
    },
    {
      "id": 55,
      "start": 1394.5,
      "end": 1396.5,
      "formatted_start": "00:23:14.500",
      "formatted_end": "00:23:16.500",
      "text": "هزار؟"
    },
    {
      "id": 56,
      "start": 1396.5,
      "end": 1398.5,
      "formatted_start": "00:23:16.500",
      "formatted_end": "00:23:18.500",
      "text": "بله"
    },
    {
      "id": 57,
      "start": 1398.5,
      "end": 1400.5,
      "formatted_start": "00:23:18.500",
      "formatted_end": "00:23:20.500",
      "text": "هزار واحد"
    },
    {
      "id": 58,
      "start": 1400.5,
      "end": 1402.5,
      "formatted_start": "00:23:20.500",
      "formatted_end": "00:23:22.500",
      "text": "دیگه همین کفایات همین رو باید بخواست کنم"
    },
    {
      "id": 59,
      "start": 1402.5,
      "end": 1404.5,
      "formatted_start": "00:23:22.500",
      "formatted_end": "00:23:24.500",
      "text": "اینو که برای آن خورد؟"
    },
    {
      "id": 60,
      "start": 1404.5,
      "end": 1406.5,
      "formatted_start": "00:23:24.500",
      "formatted_end": "00:23:26.500",
      "text": "آمیدو"
    },
    {
      "id": 61,
      "start": 1406.5,
      "end": 1408.5,
      "formatted_start": "00:23:26.500",
      "formatted_end": "00:23:28.500",
      "text": "اینم خیلی نداشت"
    },
    {
      "id": 62,
      "start": 1408.5,
      "end": 1410.5,
      "formatted_start": "00:23:28.500",
      "formatted_end": "00:23:30.500",
      "text": "از شما همه تر سیزه"
    },
    {
      "id": 63,
      "start": 1410.5,
      "end": 1412.5,
      "formatted_start": "00:23:30.500",
      "formatted_end": "00:23:32.500",
      "text": "آزمایش ادرار نیاز نیست؟"
    },
    {
      "id": 64,
      "start": 1412.5,
      "end": 1414.5,
      "formatted_start": "00:23:32.500",
      "formatted_end": "00:23:34.500",
      "text": "نه نه"
    },
    {
      "id": 65,
      "start": 1414.5,
      "end": 1416.5,
      "formatted_start": "00:23:34.500",
      "formatted_end": "00:23:36.500",
      "text": "خب اینکه آزمایش خون و اینا تهاره نداشت"
    },
    {
      "id": 66,
      "start": 1416.5,
      "end": 1418.5,
      "formatted_start": "00:23:36.500",
      "formatted_end": "00:23:38.500",
      "text": "سامانه در دسته باشی"
    },
    {
      "id": 67,
      "start": 1418.5,
      "end": 1421.5,
      "formatted_start": "00:23:38.500",
      "formatted_end": "00:23:41.500",
      "text": "چون مثلا دو سال پیش، دو سال پیش اینجوری هست؟"
    },
    {
      "id": 68,
      "start": 1421.5,
      "end": 1424.5,
      "formatted_start": "00:23:41.500",
      "formatted_end": "00:23:44.500",
      "text": "مثلا ما ببینیم کمخونی ای چیز اینجوری؟"
    },
    {
      "id": 69,
      "start": 1424.5,
      "end": 1431.5,
      "formatted_start": "00:23:44.500",
      "formatted_end": "00:23:51.500",
      "text": "همون براش می نویسم، بلی چون ماشالله رشدش و اینا خوبه، همه چیز اوکیه،"
    },
    {
      "id": 70,
      "start": 1431.5,
      "end": 1436.5,
      "formatted_start": "00:23:51.500",
      "formatted_end": "00:23:56.500",
      "text": "بلی مثلا به هر کار بد نیست آندم، هر دو سال، یه بار یه چکار بگو."
    },
    {
      "id": 71,
      "start": 1436.5,
      "end": 1439.5,
      "formatted_start": "00:23:56.500",
      "formatted_end": "00:23:59.500",
      "text": "بس هر چیز که نیازه خودتون براش باش."
    },
    {
      "id": 72,
      "start": 1448.5,
      "end": 1463.86,
      "formatted_start": "00:24:08.500",
      "formatted_end": "00:24:23.860",
      "text": "روزه بود یا باشن؟"
    },
    {
      "id": 73,
      "start": 1463.86,
      "end": 1464.52,
      "formatted_start": "00:24:23.860",
      "formatted_end": "00:24:24.520",
      "text": "تروجی ها"
    },
    {
      "id": 74,
      "start": 1464.52,
      "end": 1468.56,
      "formatted_start": "00:24:24.520",
      "formatted_end": "00:24:28.560",
      "text": "هر دفعه که میخوانید"
    },
    {
      "id": 75,
      "start": 1468.56,
      "end": 1469.3,
      "formatted_start": "00:24:28.560",
      "formatted_end": "00:24:29.300",
      "text": "یا نه"
    },
    {
      "id": 76,
      "start": 1469.3,
      "end": 1469.98,
      "formatted_start": "00:24:29.300",
      "formatted_end": "00:24:29.980",
      "text": "روزه بود"
    },
    {
      "id": 77,
      "start": 1469.98,
      "end": 1476.98,
      "formatted_start": "00:24:29.980",
      "formatted_end": "00:24:36.980",
      "text": "این های تروجی خانم"
    },
    {
      "id": 78,
      "start": 1476.98,
      "end": 1480.98,
      "formatted_start": "00:24:36.980",
      "formatted_end": "00:24:40.980",
      "text": "این هم برای روزه همینو خوش کردیم"
    },
    {
      "id": 79,
      "start": 1480.98,
      "end": 1486.98,
      "formatted_start": "00:24:40.980",
      "formatted_end": "00:24:46.980",
      "text": "همازهاشو ادرار داشتم همازهاشو خند و چربیشو هم بگیر بگیر بس"
    },
    {
      "id": 80,
      "start": 1486.98,
      "end": 1490.98,
      "formatted_start": "00:24:46.980",
      "formatted_end": "00:24:50.980",
      "text": "زنده شوی شده که باید چربیشو هم چربیشو بگیر بس"
    },
    {
      "id": 81,
      "start": 1490.98,
      "end": 1492.98,
      "formatted_start": "00:24:50.980",
      "formatted_end": "00:24:52.980",
      "text": "پس حتما ناشت آمده"
    },
    {
      "id": 82,
      "start": 1492.98,
      "end": 1494.98,
      "formatted_start": "00:24:52.980",
      "formatted_end": "00:24:54.980",
      "text": "بله بله"
    },
    {
      "id": 83,
      "start": 1494.98,
      "end": 1498.98,
      "formatted_start": "00:24:54.980",
      "formatted_end": "00:24:58.980",
      "text": "وزن شکلی زیاد نیست نیست در قدرش"
    }
  ],
  "status": "completed"
}