  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5401.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:01.000",
      "text": "مالیز نداشت؟"
    },
    {
      "id": 1,
      "start": 5401.0,
      "end": 5404.0,
      "formatted_start": "01:30:01.000",
      "formatted_end": "01:30:04.000",
      "text": "نه، حالا مانده من مالیز دخله."
    },
    {
      "id": 2,
      "start": 5405.0,
      "end": 5407.0,
      "formatted_start": "01:30:05.000",
      "formatted_end": "01:30:07.000",
      "text": "من تجرب کردم بسای که مالیز اومد تو."
    },
    {
      "id": 3,
      "start": 5408.0,
      "end": 5410.0,
      "formatted_start": "01:30:08.000",
      "formatted_end": "01:30:10.000",
      "text": "من منو دارم برشوی، بگرده همه چیز نیست."
    },
    {
      "id": 4,
      "start": 5412.0,
      "end": 5413.0,
      "formatted_start": "01:30:12.000",
      "formatted_end": "01:30:13.000",
      "text": "خب چهارده تا خانده تو؟"
    },
    {
      "id": 5,
      "start": 5413.0,
      "end": 5415.0,
      "formatted_start": "01:30:13.000",
      "formatted_end": "01:30:15.000",
      "text": "بیشکرم نرابی نداریم."
    },
    {
      "id": 6,
      "start": 5417.0,
      "end": 5418.0,
      "formatted_start": "01:30:17.000",
      "formatted_end": "01:30:18.000",
      "text": "افراد ببرم؟"
    },
    {
      "id": 7,
      "start": 5418.0,
      "end": 5419.0,
      "formatted_start": "01:30:18.000",
      "formatted_end": "01:30:19.000",
      "text": "ببر بسیار."
    },
    {
      "id": 8,
      "start": 5423.0,
      "end": 5424.0,
      "formatted_start": "01:30:23.000",
      "formatted_end": "01:30:24.000",
      "text": "من یه دفعه نرم."
    },
    {
      "id": 9,
      "start": 5424.0,
      "end": 5425.0,
      "formatted_start": "01:30:24.000",
      "formatted_end": "01:30:25.000",
      "text": "خانده تو سوگان مانده نرم؟"
    },
    {
      "id": 10,
      "start": 5426.0,
      "end": 5427.0,
      "formatted_start": "01:30:26.000",
      "formatted_end": "01:30:27.000",
      "text": "با حال باش خانده تو."
    },
    {
      "id": 11,
      "start": 5427.0,
      "end": 5457.0,
      "formatted_start": "01:30:27.000",
      "formatted_end": "01:30:57.000",
      "text": "بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله بله ب"
    },
    {
      "id": 12,
      "start": 5457.0,
      "end": 5461.0,
      "formatted_start": "01:30:57.000",
      "formatted_end": "01:31:01.000",
      "text": "من گفتم که مدرب دوتور در بجی هم چکه می کنه"
    },
    {
      "id": 13,
      "start": 5461.0,
      "end": 5468.0,
      "formatted_start": "01:31:01.000",
      "formatted_end": "01:31:08.000",
      "text": "بعد گفتش که آره اتفاقا من رفتم طلاق بالا دوتور رجمزاده فلاشتان کجا آرش درست کردم"
    },
    {
      "id": 14,
      "start": 5468.0,
      "end": 5474.0,
      "formatted_start": "01:31:08.000",
      "formatted_end": "01:31:14.000",
      "text": "بعد گفتم که نه اونو درست نکردی فلاشتان کجا فقط آوردید ولی دست نکردی"
    },
    {
      "id": 15,
      "start": 5474.0,
      "end": 5478.0,
      "formatted_start": "01:31:14.000",
      "formatted_end": "01:31:18.000",
      "text": "گفت آره آره راستی اونم دوتور ایری فولشان به من ندار"
    },
    {
      "id": 16,
      "start": 5478.0,
      "end": 5481.0,
      "formatted_start": "01:31:18.000",
      "formatted_end": "01:31:21.000",
      "text": "بهش گفتم که آقایتو پول فلاشتان بگو دیما اینو نصب بکنم"
    },
    {
      "id": 17,
      "start": 5481.0,
      "end": 5484.0,
      "formatted_start": "01:31:21.000",
      "formatted_end": "01:31:24.000",
      "text": "گفته فلان فلان ولش کن"
    },
    {
      "id": 18,
      "start": 5484.0,
      "end": 5501.0,
      "formatted_start": "01:31:24.000",
      "formatted_end": "01:31:41.000",
      "text": "خب بعد من به خانومش گفتم، ببین فاسی جان هر چیزی، هر ساختم، این بله خریم هم از یه منتظی به خرش میفته"
    },
    {
      "id": 19,
      "start": 5501.0,
      "end": 5507.0,
      "formatted_start": "01:31:41.000",
      "formatted_end": "01:31:47.000",
      "text": "گفتم اینو از این سال ساخته شده، تو از این خیلی خوب ساخته شده که الان داره به خرش میفته"
    },
    {
      "id": 20,
      "start": 5507.0,
      "end": 5516.0,
      "formatted_start": "01:31:47.000",
      "formatted_end": "01:31:56.000",
      "text": "گفتند باید انجام شده، گفت آره منم میدونم به خودش هستم، برگره گفت نمیدونم شما اینجوریه، گفت سه هر روش همه اینجوری نیستم"
    },
    {
      "id": 21,
      "start": 5516.0,
      "end": 5546.0,
      "formatted_start": "01:31:56.000",
      "formatted_end": "01:32:26.000",
      "text": "بعد آقایه گفتش، گفت الان ما اصلا اونقدر چیز نداریم، بسیار دمیدن رو، گفت اونقدر الان ما پروژه ای هم نداریم و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و این و"
    },
    {
      "id": 22,
      "start": 5546.0,
      "end": 5552.0,
      "formatted_start": "01:32:26.000",
      "formatted_end": "01:32:32.000",
      "text": "کاری باش نشد. گفت من به چیزم گفتم خب اصلا شمارهشم دیگه من گذاشتم بلاکش کردم"
    },
    {
      "id": 23,
      "start": 5552.0,
      "end": 5557.0,
      "formatted_start": "01:32:32.000",
      "formatted_end": "01:32:37.000",
      "text": "گفتم دکتور ایریزاین بزنه من دیگه نمیدم. گفتم ببین حالا من دارم بهت میگم بیا"
    },
    {
      "id": 24,
      "start": 5557.0,
      "end": 5563.0,
      "formatted_start": "01:32:37.000",
      "formatted_end": "01:32:43.000",
      "text": "حالا قراره بیاد دیگه. گفت باشه گفت من اتفاقا چفت زیاد لازم دارم دو تا کارتون چفت لازم دارم"
    },
    {
      "id": 25,
      "start": 5563.0,
      "end": 5565.0,
      "formatted_start": "01:32:43.000",
      "formatted_end": "01:32:45.000",
      "text": "من همه رو رمایخ کار میکنم"
    },
    {
      "id": 26,
      "start": 5565.0,
      "end": 5567.0,
      "formatted_start": "01:32:45.000",
      "formatted_end": "01:32:47.000",
      "text": "آره این هست"
    },
    {
      "id": 27,
      "start": 5567.0,
      "end": 5569.0,
      "formatted_start": "01:32:47.000",
      "formatted_end": "01:32:49.000",
      "text": "بله منظور من اینه که"
    },
    {
      "id": 28,
      "start": 5569.0,
      "end": 5571.0,
      "formatted_start": "01:32:49.000",
      "formatted_end": "01:32:51.000",
      "text": "مثلا حتی من بهش گفتم"
    },
    {
      "id": 29,
      "start": 5571.0,
      "end": 5573.0,
      "formatted_start": "01:32:51.000",
      "formatted_end": "01:32:53.000",
      "text": "اون دفعه که دکتر یوی گفتم که مثلا"
    },
    {
      "id": 30,
      "start": 5573.0,
      "end": 5575.0,
      "formatted_start": "01:32:53.000",
      "formatted_end": "01:32:55.000",
      "text": "آقای دکتر این کارم برده کنی"
    },
    {
      "id": 31,
      "start": 5575.0,
      "end": 5577.0,
      "formatted_start": "01:32:55.000",
      "formatted_end": "01:32:57.000",
      "text": "گفتم ایزوگاه پشت بون"
    },
    {
      "id": 32,
      "start": 5577.0,
      "end": 5579.0,
      "formatted_start": "01:32:57.000",
      "formatted_end": "01:32:59.000",
      "text": "بعد اول دشونجا آب میدارم"
    },
    {
      "id": 33,
      "start": 5579.0,
      "end": 5581.0,
