  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3907.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:07.000",
      "text": "همانطور که بینای سنجی بیمار در مطب پزشکی، بینای سنجی، سینما کردی."
    },
    {
      "id": 1,
      "start": 3907.0,
      "end": 3907.5,
      "formatted_start": "01:05:07.000",
      "formatted_end": "01:05:07.500",
      "text": "آهان."
    },
    {
      "id": 2,
      "start": 3907.5,
      "end": 3908.3,
      "formatted_start": "01:05:07.500",
      "formatted_end": "01:05:08.300",
      "text": "الان هست کسی؟"
    },
    {
      "id": 3,
      "start": 3908.3,
      "end": 3909.3,
      "formatted_start": "01:05:08.300",
      "formatted_end": "01:05:09.300",
      "text": "آره، آره، آره."
    },
    {
      "id": 4,
      "start": 3911.7,
      "end": 3912.9,
      "formatted_start": "01:05:11.700",
      "formatted_end": "01:05:12.900",
      "text": "اوه، یه قطعه هست."
    },
    {
      "id": 5,
      "start": 3912.9,
      "end": 3916.7,
      "formatted_start": "01:05:12.900",
      "formatted_end": "01:05:16.700",
      "text": "بعد، اه، سونوگرافیه، مردش انجام کردی؟"
    },
    {
      "id": 6,
      "start": 3917.7,
      "end": 3919.5,
      "formatted_start": "01:05:17.700",
      "formatted_end": "01:05:19.500",
      "text": "مردش نریا، اونجا تو بیرون روز."
    },
    {
      "id": 7,
      "start": 3919.5,
      "end": 3920.8,
      "formatted_start": "01:05:19.500",
      "formatted_end": "01:05:20.800",
      "text": "اکشو کردی؟"
    },
    {
      "id": 8,
      "start": 3921.2,
      "end": 3921.9,
      "formatted_start": "01:05:21.200",
      "formatted_end": "01:05:21.900",
      "text": "اکشو کردی."
    },
    {
      "id": 9,
      "start": 3921.9,
      "end": 3923.5,
      "formatted_start": "01:05:21.900",
      "formatted_end": "01:05:23.500",
      "text": "درم اون، دارم بگویم."
    },
    {
      "id": 10,
      "start": 3923.5,
      "end": 3924.7,
      "formatted_start": "01:05:23.500",
      "formatted_end": "01:05:24.700",
      "text": "پرمندشو ببینم."
    },
    {
      "id": 11,
      "start": 3925.6,
      "end": 3926.2,
      "formatted_start": "01:05:25.600",
      "formatted_end": "01:05:26.200",
      "text": "یا."
    },
    {
      "id": 12,
      "start": 3929.7,
      "end": 3933.7,
      "formatted_start": "01:05:29.700",
      "formatted_end": "01:05:33.700",
      "text": "اوه، این از کم نباشتی به برای، تا چه تلاشتی؟"
    },
    {
      "id": 13,
      "start": 3934.6,
      "end": 3935.7,
      "formatted_start": "01:05:34.600",
      "formatted_end": "01:05:35.700",
      "text": "اینجا باشت."
    },
    {
      "id": 14,
      "start": 3937.0,
      "end": 3939.0,
      "formatted_start": "01:05:37.000",
      "formatted_end": "01:05:39.000",
      "text": "بله"
    },
    {
      "id": 15,
      "start": 3939.0,
      "end": 3941.0,
      "formatted_start": "01:05:39.000",
      "formatted_end": "01:05:41.000",
      "text": "بیا از من"
    },
    {
      "id": 16,
      "start": 3951.0,
      "end": 3955.0,
      "formatted_start": "01:05:51.000",
      "formatted_end": "01:05:55.000",
      "text": "خب با روشت درسته"
    },
    {
      "id": 17,
      "start": 3961.0,
      "end": 3964.0,
      "formatted_start": "01:06:01.000",
      "formatted_end": "01:06:04.000",
      "text": "اینو بدایی بدایی موشی بره"
    },
    {
      "id": 18,
      "start": 3964.0,
      "end": 3966.0,
      "formatted_start": "01:06:04.000",
      "formatted_end": "01:06:06.000",
      "text": "او خورشه"
    },
    {
      "id": 19,
      "start": 3967.0,
      "end": 3971.0,
      "formatted_start": "01:06:07.000",
      "formatted_end": "01:06:11.000",
      "text": "برنامه از سفن شما رو برد"
    },
    {
      "id": 20,
      "start": 3971.0,
      "end": 3975.0,
      "formatted_start": "01:06:11.000",
      "formatted_end": "01:06:15.000",
      "text": "خب من چه؟"
    },
    {
      "id": 21,
      "start": 3975.0,
      "end": 3977.0,
      "formatted_start": "01:06:15.000",
      "formatted_end": "01:06:17.000",
      "text": "خدا سه همه چشم"
    },
    {
      "id": 22,
      "start": 3977.0,
      "end": 3980.0,
      "formatted_start": "01:06:17.000",
      "formatted_end": "01:06:20.000",
      "text": "چرا سود زایمان کردی؟"
    },
    {
      "id": 23,
      "start": 3980.0,
      "end": 3982.0,
      "formatted_start": "01:06:20.000",
      "formatted_end": "01:06:22.000",
      "text": "که ما توم رو داشتم"
    },
    {
      "id": 24,
      "start": 3982.0,
      "end": 3985.0,
      "formatted_start": "01:06:22.000",
      "formatted_end": "01:06:25.000",
      "text": "برنامه از سفن بارش بودیم"
    },
    {
      "id": 25,
      "start": 3985.0,
      "end": 3987.0,
      "formatted_start": "01:06:25.000",
      "formatted_end": "01:06:27.000",
      "text": "من توش ناسو دارم"
    },
    {
      "id": 26,
      "start": 3997.0,
      "end": 4005.4,
      "formatted_start": "01:06:37.000",
      "formatted_end": "01:06:45.400",
      "text": "من خواهیم سیگه داره بازتران آنکورانزا یکی داره از تورکیمیات اونجا بگم بگیره بسامان بیاره"
    },
    {
      "id": 27,
      "start": 4005.4,
      "end": 4006.7,
      "formatted_start": "01:06:45.400",
      "formatted_end": "01:06:46.700",
      "text": "کهی گفت؟"
    },
    {
      "id": 28,
      "start": 4006.7,
      "end": 4007.7,
      "formatted_start": "01:06:46.700",
      "formatted_end": "01:06:47.700",
      "text": "اما زنگتر"
    },
    {
      "id": 29,
      "start": 4007.7,
      "end": 4009.4,
      "formatted_start": "01:06:47.700",
      "formatted_end": "01:06:49.400",
      "text": "من براش نداشتم"
    },
    {
      "id": 30,
      "start": 4009.4,
      "end": 4010.2,
      "formatted_start": "01:06:49.400",
      "formatted_end": "01:06:50.200",
      "text": "اینجا نمیدونی؟"
    },
    {
      "id": 31,
      "start": 4010.2,
      "end": 4012.2,
      "formatted_start": "01:06:50.200",
      "formatted_end": "01:06:52.200",
      "text": "دیشب براش نداشتم"
    },
    {
      "id": 32,
      "start": 4013.5,
      "end": 4015.0,
      "formatted_start": "01:06:53.500",
      "formatted_end": "01:06:55.000",
      "text": "خیلی زنگی بگی بابا نه بر تکیه نه"
    },
    {
      "id": 33,
      "start": 4015.0,
      "end": 4016.2,
      "formatted_start": "01:06:55.000",
      "formatted_end": "01:06:56.200",
      "text": "آره میسایی دلالیز"
    },
    {
      "id": 34,
      "start": 4016.2,
      "end": 4018.0,
      "formatted_start": "01:06:56.200",
