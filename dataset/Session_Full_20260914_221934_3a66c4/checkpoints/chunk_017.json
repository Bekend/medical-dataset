      "id": 26,
      "start": 5175.0,
      "end": 5177.0,
      "formatted_start": "01:26:15.000",
      "formatted_end": "01:26:17.000",
      "text": "اوه از خبر برده خدا"
    },
    {
      "id": 27,
      "start": 5177.0,
      "end": 5179.0,
      "formatted_start": "01:26:17.000",
      "formatted_end": "01:26:19.000",
      "text": "اوه از خبر برده خدا"
    },
    {
      "id": 28,
      "start": 5179.0,
      "end": 5181.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:21.000",
      "text": "اوه از خبر برده خدا"
    },
    {
      "id": 29,
      "start": 5181.0,
      "end": 5183.0,
      "formatted_start": "01:26:21.000",
      "formatted_end": "01:26:23.000",
      "text": "اوه از خبر برده خدا"
    },
    {
      "id": 30,
      "start": 5183.0,
      "end": 5201.0,
      "formatted_start": "01:26:23.000",
      "formatted_end": "01:26:41.000",
      "text": "موسیقی"
    },
    {
      "id": 31,
      "start": 5201.0,
      "end": 5203.0,
      "formatted_start": "01:26:41.000",
      "formatted_end": "01:26:43.000",
      "text": "حلو سلام"
    },
    {
      "id": 32,
      "start": 5203.0,
      "end": 5205.0,
      "formatted_start": "01:26:43.000",
      "formatted_end": "01:26:45.000",
      "text": "حلو شما خوبی؟"
    },
    {
      "id": 33,
      "start": 5205.0,
      "end": 5207.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:47.000",
      "text": "مرسی قربونت ممنونم"
    },
    {
      "id": 34,
      "start": 5207.0,
      "end": 5209.0,
      "formatted_start": "01:26:47.000",
      "formatted_end": "01:26:49.000",
      "text": "مرسی خواهش میکنم با شکرم"
    },
    {
      "id": 35,
      "start": 5209.0,
      "end": 5211.0,
      "formatted_start": "01:26:49.000",
      "formatted_end": "01:26:51.000",
      "text": "مرسی بچه ها چطورم؟"
    },
    {
      "id": 36,
      "start": 5211.0,
      "end": 5213.0,
      "formatted_start": "01:26:51.000",
      "formatted_end": "01:26:53.000",
      "text": "خوبم"
    },
    {
      "id": 37,
      "start": 5213.0,
      "end": 5215.0,
      "formatted_start": "01:26:53.000",
      "formatted_end": "01:26:55.000",
      "text": "قربونت شما لطف داریم"
    },
    {
      "id": 38,
      "start": 5215.0,
      "end": 5217.0,
      "formatted_start": "01:26:55.000",
      "formatted_end": "01:26:57.000",
      "text": "آره انشالله"
    },
    {
      "id": 39,
      "start": 5217.0,
      "end": 5219.0,
      "formatted_start": "01:26:57.000",
      "formatted_end": "01:26:59.000",
      "text": "آره انشالله تو خیابمون بگیم همدیگر رو"
    },
    {
      "id": 40,
      "start": 5219.0,
      "end": 5221.0,
      "formatted_start": "01:26:59.000",
      "formatted_end": "01:27:01.000",
      "text": "تو خرید"
    },
    {
      "id": 41,
      "start": 5221.0,
      "end": 5223.0,
      "formatted_start": "01:27:01.000",
      "formatted_end": "01:27:03.000",
      "text": "تو جایی خوب جانم"
    },
    {
      "id": 42,
      "start": 5231.0,
      "end": 5233.0,
      "formatted_start": "01:27:11.000",
      "formatted_end": "01:27:13.000",
      "text": "آهان"
    },
    {
      "id": 43,
      "start": 5234.0,
      "end": 5238.0,
      "formatted_start": "01:27:14.000",
      "formatted_end": "01:27:18.000",
      "text": "آره بیاد شده آره آره آره"
    },
    {
      "id": 44,
      "start": 5240.0,
      "end": 5241.0,
      "formatted_start": "01:27:20.000",
      "formatted_end": "01:27:21.000",
      "text": "جا"
    },
    {
      "id": 45,
      "start": 5242.0,
      "end": 5244.0,
      "formatted_start": "01:27:22.000",
      "formatted_end": "01:27:24.000",
      "text": "خب"
    },
    {
      "id": 46,
      "start": 5250.0,
      "end": 5252.0,
      "formatted_start": "01:27:30.000",
      "formatted_end": "01:27:32.000",
      "text": "کام هم گفت آورده دیگه"
    },
    {
      "id": 47,
      "start": 5252.0,
      "end": 5255.0,
      "formatted_start": "01:27:32.000",
      "formatted_end": "01:27:35.000",
      "text": "گفتم اگه میتونه زنجله ترما شرایط بکنه بیارم"
    },
    {
      "id": 48,
      "start": 5255.0,
      "end": 5260.76,
      "formatted_start": "01:27:35.000",
      "formatted_end": "01:27:40.760",
      "text": "ببین اصلا معلوم نیست"
    },
    {
      "id": 49,
      "start": 5260.76,
      "end": 5262.5,
      "formatted_start": "01:27:40.760",
      "formatted_end": "01:27:42.500",
      "text": "یعنی نه دارو کنه ها میدونم"
    },
    {
      "id": 50,
      "start": 5262.5,
      "end": 5263.44,
      "formatted_start": "01:27:42.500",
      "formatted_end": "01:27:43.440",
      "text": "نه هیچی"
    },
    {
      "id": 51,
      "start": 5263.44,
      "end": 5265.5,
      "formatted_start": "01:27:43.440",
      "formatted_end": "01:27:45.500",
      "text": "اوضای من بکنم دیدی یه روز جنگ"
    },
    {
      "id": 52,
      "start": 5265.5,
      "end": 5267.22,
      "formatted_start": "01:27:45.500",
      "formatted_end": "01:27:47.220",
      "text": "یه روز سرده یه روز بلانه"
    },
    {
      "id": 53,
      "start": 5267.22,
      "end": 5269.22,
      "formatted_start": "01:27:47.220",
      "formatted_end": "01:27:49.220",
      "text": "اصلا قابل پیشبینی نیست"
    },
    {
      "id": 54,
      "start": 5269.22,
      "end": 5271.04,
      "formatted_start": "01:27:49.220",
      "formatted_end": "01:27:51.040",
      "text": "خب ولی"
    },
    {
      "id": 55,
      "start": 5271.04,
      "end": 5277.78,
      "formatted_start": "01:27:51.040",
      "formatted_end": "01:27:57.780",
      "text": "آره ببین که هیچیشی نمیتونه"
    },
    {
      "id": 56,
      "start": 5277.78,
      "end": 5280.04,
      "formatted_start": "01:27:57.780",
      "formatted_end": "01:28:00.040",
      "text": "قطعا بگی اصلا نمیاد یا میاد"
    },
    {
      "id": 57,
      "start": 5280.04,
      "end": 5281.58,
      "formatted_start": "01:28:00.040",
      "formatted_end": "01:28:01.580",
      "text": "خب میاد واقعا همه"
    },
    {
      "id": 58,
      "start": 5281.58,
      "end": 5282.68,
      "formatted_start": "01:28:01.580",
      "formatted_end": "01:28:02.680",
      "text": "الان بلا تکلیف هست"
    },
    {
      "id": 59,
      "start": 5282.68,
      "end": 5296.68,
      "formatted_start": "01:28:02.680",
      "formatted_end": "01:28:16.680",
      "text": "چون برای تکلیف هست اگر کسی دار اینکه بتونه این رو قشنگ مثلا بیاره و از اینکه میخواد پروازش انتها هاتیس باشه گرگان باشه باز بکره"
    },
    {
      "id": 60,
      "start": 5296.68,
      "end": 5310.94,
      "formatted_start": "01:28:16.680",
      "formatted_end": "01:28:30.940",
      "text": "فردا میخواد بیاد خوب؟ آره بیر توی یه کلمن بذاره کلمنش توش یک داشته باشه اگر کسی نتونه تو پرواز ایران نمیگیرن مشکل نداره برداره بیار"
    },
    {
      "id": 61,
      "start": 5312.68,
      "end": 5329.48,
      "formatted_start": "01:28:32.680",
      "formatted_end": "01:28:49.480",
      "text": "این کسی که داره میاره یکی هم باید متقهد باشه"
    },
    {
      "id": 62,
      "start": 5329.48,
      "end": 5330.98,
      "formatted_start": "01:28:49.480",
      "formatted_end": "01:28:50.980",
      "text": "خب؟"
    },
    {
      "id": 63,
      "start": 5330.98,
      "end": 5333.14,
      "formatted_start": "01:28:50.980",
      "formatted_end": "01:28:53.140",
      "text": "یعنی اون یخی که استفاده میکنه"
    },
    {
      "id": 64,
      "start": 5333.14,
      "end": 5335.52,
      "formatted_start": "01:28:53.140",
      "formatted_end": "01:28:55.520",
      "text": "یخ آب نشه و سطر را میتونیم"
    },
    {
      "id": 65,
      "start": 5335.52,
      "end": 5337.5,
      "formatted_start": "01:28:55.520",
      "formatted_end": "01:28:57.500",
      "text": "یه اون زرفی که استفاده میکنه"
    },
    {
      "id": 66,
      "start": 5337.5,
      "end": 5339.28,
      "formatted_start": "01:28:57.500",
      "formatted_end": "01:28:59.280",
      "text": "حالا اون سطر هم توی تو خودش کن"
    },
    {
      "id": 67,
      "start": 5339.28,
      "end": 5342.52,
      "formatted_start": "01:28:59.280",
      "formatted_end": "01:29:02.520",
      "text": "من نبیدونم مخصوص باقی سن این چیزا داشته با خودشو برده"
    },
    {
      "id": 68,
      "start": 5342.52,
      "end": 5346.46,
      "formatted_start": "01:29:02.520",
      "formatted_end": "01:29:06.460",
      "text": "دیگه اون دست خودت دیگه"
    },
    {
      "id": 69,
      "start": 5346.46,
      "end": 5347.62,
      "formatted_start": "01:29:06.460",
      "formatted_end": "01:29:07.620",
      "text": "آره عزیزم"
    },
    {
      "id": 70,
      "start": 5347.62,
      "end": 5348.4,
      "formatted_start": "01:29:07.620",
      "formatted_end": "01:29:08.400",
      "text": "آره"
    },
    {
      "id": 71,
      "start": 5348.4,
      "end": 5353.74,
      "formatted_start": "01:29:08.400",
      "formatted_end": "01:29:13.740",
      "text": "تشکیلات داره بیاره با خودش"
    },
    {
      "id": 72,
      "start": 5353.74,
      "end": 5354.26,
      "formatted_start": "01:29:13.740",
      "formatted_end": "01:29:14.260",
      "text": "آره"
    },
    {
      "id": 73,
      "start": 5354.26,
      "end": 5357.68,
      "formatted_start": "01:29:14.260",
      "formatted_end": "01:29:17.680",
      "text": "قربون شما خواهش میکنم"
    },
    {
      "id": 74,
      "start": 5357.68,
      "end": 5359.26,
      "formatted_start": "01:29:17.680",
      "formatted_end": "01:29:19.260",
      "text": "قربون شما خدافر"
    },
    {
      "id": 75,
      "start": 5359.26,
      "end": 5360.16,
      "formatted_start": "01:29:19.260",
      "formatted_end": "01:29:20.160",
      "text": "خدافر"
    },
    {
      "id": 76,
      "start": 5360.16,
      "end": 5361.8,
      "formatted_start": "01:29:20.160",
      "formatted_end": "01:29:21.800",
      "text": "مرسی همچنین خدافر"
    },
    {
      "id": 77,
      "start": 5361.8,
      "end": 5391.8,
      "formatted_start": "01:29:21.800",
      "formatted_end": "01:29:51.800",
      "text": "برای اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که"
    },
    {
      "id": 78,
      "start": 5391.8,
      "end": 5392.8,
      "formatted_start": "01:29:51.800",
      "formatted_end": "01:29:52.800",
      "text": "چی میگه؟"
    },
    {
      "id": 79,
      "start": 5392.8,
      "end": 5393.8,
      "formatted_start": "01:29:52.800",
      "formatted_end": "01:29:53.800",
      "text": "چی؟ باید بخور"
    },
    {
      "id": 80,
      "start": 5393.8,
      "end": 5394.8,
      "formatted_start": "01:29:53.800",
      "formatted_end": "01:29:54.800",
      "text": "بخور"
    },
    {
      "id": 81,
      "start": 5395.8,
      "end": 5398.8,
      "formatted_start": "01:29:55.800",
      "formatted_end": "01:29:58.800",
      "text": "همجور برام ترفتن سویس و یه همینه اومده تا آخر"
    },
    {
      "id": 82,
      "start": 5398.8,
      "end": 5399.8,
      "formatted_start": "01:29:58.800",
      "formatted_end": "01:29:59.800",
      "text": "بش بیا مگه"
    }
  ],
  "status": "completed"
}