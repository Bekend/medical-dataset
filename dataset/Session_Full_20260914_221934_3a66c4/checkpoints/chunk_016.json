  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4807.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:07.000",
      "text": "این ایری گفتم که مثلاً 20 ملی به حسابم برسید نگیرم، بخواهم یا آقایی هم دو جان ایری هم به حسابم نریفته."
    },
    {
      "id": 1,
      "start": 4807.0,
      "end": 4813.0,
      "formatted_start": "01:20:07.000",
      "formatted_end": "01:20:13.000",
      "text": "من هم به قدر من دیگه نگیرم، من ندارم چجوری من 20 ملی بدم، بعد دکتر معلوم نیست که ایران بوده."
    },
    {
      "id": 2,
      "start": 4813.0,
      "end": 4818.0,
      "formatted_start": "01:20:13.000",
      "formatted_end": "01:20:18.000",
      "text": "گفتن ببین شما بیا من مدیر ساختمونم، من پولتو میدم، خب؟"
    },
    {
      "id": 3,
      "start": 4818.0,
      "end": 4826.96,
      "formatted_start": "01:20:18.000",
      "formatted_end": "01:20:26.960",
      "text": "گفتم من پولتو میدن، بعد میخوام به دکتور ایلیتیز بدن، اجاره بدن، اجاره رو مکن میکنم، دیگه در اول انجام شده قرار میدیده"
    },
    {
      "id": 4,
      "start": 4826.96,
      "end": 4831.04,
      "formatted_start": "01:20:26.960",
      "formatted_end": "01:20:31.040",
      "text": "گفت باشه بیام حتما، امروز صبح بهش پیام دادم"
    },
    {
      "id": 5,
      "start": 4831.04,
      "end": 4840.14,
      "formatted_start": "01:20:31.040",
      "formatted_end": "01:20:40.140",
      "text": "آره، آره، امروز سبم بهش پیام دادم، گفتش که من بیام ببین یه جایی کار میکنه، انگار چیه ساختمون در روی دکشتو انجام میده"
    },
    {
      "id": 6,
      "start": 4840.14,
      "end": 4842.26,
      "formatted_start": "01:20:40.140",
      "formatted_end": "01:20:42.260",
      "text": "من کارم تموم شد یه سر میزنم"
    },
    {
      "id": 7,
      "start": 4842.26,
      "end": 4843.78,
      "formatted_start": "01:20:42.260",
      "formatted_end": "01:20:43.780",
      "text": "با آقای روی همو همی کنم"
    },
    {
      "id": 8,
      "start": 4843.78,
      "end": 4845.46,
      "formatted_start": "01:20:43.780",
      "formatted_end": "01:20:45.460",
      "text": "آره"
    },
    {
      "id": 9,
      "start": 4845.46,
      "end": 4848.26,
      "formatted_start": "01:20:45.460",
      "formatted_end": "01:20:48.260",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 4848.26,
      "end": 4849.52,
      "formatted_start": "01:20:48.260",
      "formatted_end": "01:20:49.520",
      "text": "بگه من بهش گفتم"
    },
    {
      "id": 11,
      "start": 4849.52,
      "end": 4852.64,
      "formatted_start": "01:20:49.520",
      "formatted_end": "01:20:52.640",
      "text": "گفتم طبقه پنگ طبقه شیش طبقه هفت"
    },
    {
      "id": 12,
      "start": 4852.64,
      "end": 4854.04,
      "formatted_start": "01:20:52.640",
      "formatted_end": "01:20:54.040",
      "text": "طبقه چار گفتم"
    },
    {
      "id": 13,
      "start": 4854.04,
      "end": 4855.9,
      "formatted_start": "01:20:54.040",
      "formatted_end": "01:20:55.900",
      "text": "همین رو بگفت آره یه بار رفتم"
    },
    {
      "id": 14,
      "start": 4855.9,
      "end": 4857.08,
      "formatted_start": "01:20:55.900",
      "formatted_end": "01:20:57.080",
      "text": "میدینم چی به چیه"
    },
    {
      "id": 15,
      "start": 4857.08,
      "end": 4858.62,
      "formatted_start": "01:20:57.080",
      "formatted_end": "01:20:58.620",
      "text": "آره عزیزم"
    },
    {
      "id": 16,
      "start": 4858.62,
      "end": 4859.78,
      "formatted_start": "01:20:58.620",
      "formatted_end": "01:20:59.780",
      "text": "جان"
    },
    {
      "id": 17,
      "start": 4859.78,
      "end": 4863.08,
      "formatted_start": "01:20:59.780",
      "formatted_end": "01:21:03.080",
      "text": "آهان"
    },
    {
      "id": 18,
      "start": 4863.08,
      "end": 4870.5,
      "formatted_start": "01:21:03.080",
      "formatted_end": "01:21:10.500",
      "text": "اما افراد"
    },
    {
      "id": 19,
      "start": 4870.5,
      "end": 4873.54,
      "formatted_start": "01:21:10.500",
      "formatted_end": "01:21:13.540",
      "text": "اما"
    },
    {
      "id": 20,
      "start": 4873.54,
      "end": 4884.94,
      "formatted_start": "01:21:13.540",
      "formatted_end": "01:21:24.940",
      "text": "اما"
    },
    {
      "id": 21,
      "start": 4884.94,
      "end": 4887.3,
      "formatted_start": "01:21:24.940",
      "formatted_end": "01:21:27.300",
      "text": "اما"
    },
    {
      "id": 22,
      "start": 4887.3,
      "end": 4890.5,
      "formatted_start": "01:21:27.300",
      "formatted_end": "01:21:30.500",
      "text": "اما"
    },
    {
      "id": 23,
      "start": 4890.5,
      "end": 4892.5,
      "formatted_start": "01:21:30.500",
      "formatted_end": "01:21:32.500",
      "text": "ها"
    },
    {
      "id": 24,
      "start": 4896.5,
      "end": 4900.5,
      "formatted_start": "01:21:36.500",
      "formatted_end": "01:21:40.500",
      "text": "ببین اصلا من چی بودم چه ببینم چی بود بگم"
    },
    {
      "id": 25,
      "start": 4900.5,
      "end": 4902.5,
      "formatted_start": "01:21:40.500",
      "formatted_end": "01:21:42.500",
      "text": "این رسید ها با من نرید آن رو دستن بگیرم"
    },
    {
      "id": 26,
      "start": 4902.5,
      "end": 4905.5,
      "formatted_start": "01:21:42.500",
      "formatted_end": "01:21:45.500",
      "text": "ببین بزن من یه پنج دقیقه دیگه به زنگی زنم"
    },
    {
      "id": 27,
      "start": 4905.5,
      "end": 4909.5,
      "formatted_start": "01:21:45.500",
      "formatted_end": "01:21:49.500",
