    },
    {
      "id": 72,
      "start": 5013.82,
      "end": 5013.84,
      "formatted_start": "01:23:33.820",
      "formatted_end": "01:23:33.840",
      "text": "خوبستی؟"
    },
    {
      "id": 73,
      "start": 5013.84,
      "end": 5017.14,
      "formatted_start": "01:23:33.840",
      "formatted_end": "01:23:37.140",
      "text": "خیلی شما خیلی شکر میکنم ممنونم از مطبق تو مرسی"
    },
    {
      "id": 74,
      "start": 5017.14,
      "end": 5020.64,
      "formatted_start": "01:23:37.140",
      "formatted_end": "01:23:40.640",
      "text": "بخونیتو برامر من یک شنبا اینجا شایلان کلابی مشابه هست"
    },
    {
      "id": 75,
      "start": 5020.64,
      "end": 5021.14,
      "formatted_start": "01:23:40.640",
      "formatted_end": "01:23:41.140",
      "text": "آها خب"
    },
    {
      "id": 76,
      "start": 5021.14,
      "end": 5024.14,
      "formatted_start": "01:23:41.140",
      "formatted_end": "01:23:44.140",
      "text": "بعد دوستهای شما رو میبینم و همیشه دنبالش میبینیم"
    },
    {
      "id": 77,
      "start": 5024.14,
      "end": 5026.54,
      "formatted_start": "01:23:44.140",
      "formatted_end": "01:23:46.540",
      "text": "این چیز همه اصلات من نه نفشت خاندویتو"
    },
    {
      "id": 78,
      "start": 5026.54,
      "end": 5027.04,
      "formatted_start": "01:23:46.540",
      "formatted_end": "01:23:47.040",
      "text": "از اینجا"
    },
    {
      "id": 79,
      "start": 5027.04,
      "end": 5029.74,
      "formatted_start": "01:23:47.040",
      "formatted_end": "01:23:49.740",
      "text": "خاندویتو اگه ترمیم کنه یا شباب مینویسید"
    },
    {
      "id": 80,
      "start": 5029.74,
      "end": 5031.14,
      "formatted_start": "01:23:49.740",
      "formatted_end": "01:23:51.140",
      "text": "جانب بذاریم اشکال نداریم"
    },
    {
      "id": 81,
      "start": 5031.14,
      "end": 5031.64,
      "formatted_start": "01:23:51.140",
      "formatted_end": "01:23:51.640",
      "text": "نه"
    },
    {
      "id": 82,
      "start": 5031.64,
      "end": 5032.64,
      "formatted_start": "01:23:51.640",
      "formatted_end": "01:23:52.640",
      "text": "برسید باشیم"
    },
    {
      "id": 83,
      "start": 5032.64,
      "end": 5033.64,
      "formatted_start": "01:23:52.640",
      "formatted_end": "01:23:53.640",
      "text": "آرام باشیم"
    },
    {
      "id": 84,
      "start": 5033.64,
      "end": 5035.64,
      "formatted_start": "01:23:53.640",
      "formatted_end": "01:23:55.640",
      "text": "مخواهم یه اجازه نگرم ازتون"
    },
    {
      "id": 85,
      "start": 5035.64,
      "end": 5036.64,
      "formatted_start": "01:23:55.640",
      "formatted_end": "01:23:56.640",
      "text": "نه نه مخواهم"
    },
    {
      "id": 86,
      "start": 5036.64,
      "end": 5038.64,
      "formatted_start": "01:23:56.640",
      "formatted_end": "01:23:58.640",
      "text": "خدمت شما"
    },
    {
      "id": 87,
      "start": 5038.64,
      "end": 5050.64,
      "formatted_start": "01:23:58.640",
      "formatted_end": "01:24:10.640",
      "text": "خب لطفا از اینجایی که ما همیشه واسه شما متخصص های اطفال یا شباب آوردیم یا ترمیم آوردیم یا شوره آوردیم و تباییم تا شپش دوباره این چرخه تکرار شده"
    },
    {
      "id": 88,
      "start": 5050.64,
      "end": 5052.64,
      "formatted_start": "01:24:10.640",
      "formatted_end": "01:24:12.640",
      "text": "دیگه من درخواستم بودم"
    },
    {
      "id": 89,
      "start": 5052.64,
      "end": 5055.64,
      "formatted_start": "01:24:12.640",
      "formatted_end": "01:24:15.640",
      "text": "شپش فقط انا سریتا میدبسم خدایش"
    },
    {
      "id": 90,
      "start": 5055.64,
      "end": 5057.64,
      "formatted_start": "01:24:15.640",
      "formatted_end": "01:24:17.640",
      "text": "اینجا به جزئون دیگه هیچی نمیرسن"
    },
    {
      "id": 91,
      "start": 5057.64,
      "end": 5062.64,
      "formatted_start": "01:24:17.640",
      "formatted_end": "01:24:22.640",
      "text": "ولی راست میگم اصلا من از شراب سینه جنرال را میتونستم فراموش کرده"
    },
    {
      "id": 92,
      "start": 5062.64,
      "end": 5065.64,
      "formatted_start": "01:24:22.640",
      "formatted_end": "01:24:25.640",
      "text": "اشکال نوره چون خیلی برند و بیا چند"
    },
    {
      "id": 93,
      "start": 5065.64,
      "end": 5067.64,
      "formatted_start": "01:24:25.640",
      "formatted_end": "01:24:27.640",
      "text": "آره حقیقه"
    },
    {
      "id": 94,
      "start": 5067.64,
      "end": 5073.64,
      "formatted_start": "01:24:27.640",
      "formatted_end": "01:24:33.640",
      "text": "امروز من دیگه گفتم توی این پارت واقعا یه چیزی بذاریم که حالا در کنار اینکه برد و بکچه ها رو میخورده"
    },
    {
      "id": 95,
      "start": 5073.64,
      "end": 5076.64,
      "formatted_start": "01:24:33.640",
      "formatted_end": "01:24:36.640",
      "text": "حتی خاندکتر همون بتونه استفاده با منه"
    },
    {
      "id": 96,
      "start": 5076.64,
      "end": 5079.64,
      "formatted_start": "01:24:36.640",
      "formatted_end": "01:24:39.640",
      "text": "اینکه با خدمت شما کرم زیر افتباه باردیم"
    },
    {
      "id": 97,
      "start": 5079.64,
      "end": 5082.64,
      "formatted_start": "01:24:39.640",
      "formatted_end": "01:24:42.640",
      "text": "خب بگو پوستتون چرب هست دیگه درسته؟"
    },
    {
      "id": 98,
      "start": 5082.64,
      "end": 5084.64,
      "formatted_start": "01:24:42.640",
      "formatted_end": "01:24:44.640",
      "text": "نه من پوستم شدیدن خوشگید"
    },
    {
      "id": 99,
      "start": 5084.64,
      "end": 5087.64,
      "formatted_start": "01:24:44.640",
      "formatted_end": "01:24:47.640",
      "text": "چربیدن خوشگید این مال چرب و بیرونگیه"
    },
    {
      "id": 100,
      "start": 5087.64,
      "end": 5089.64,
      "formatted_start": "01:24:47.640",
      "formatted_end": "01:24:49.640",
      "text": "اجازه بدیم من پراتون پس عوضش کنم"
    },
    {
      "id": 101,
      "start": 5089.64,
      "end": 5091.64,
      "formatted_start": "01:24:49.640",
      "formatted_end": "01:24:51.640",
      "text": "چرب مختلط هست"
    },
    {
      "id": 102,
      "start": 5091.64,
      "end": 5093.64,
      "formatted_start": "01:24:51.640",
      "formatted_end": "01:24:53.640",
      "text": "براتون پوست خوش میارم؟"
    },
    {
      "id": 103,
      "start": 5093.64,
      "end": 5094.64,
      "formatted_start": "01:24:53.640",
      "formatted_end": "01:24:54.640",
      "text": "باشه"
    },
    {
      "id": 104,
      "start": 5094.64,
      "end": 5096.64,
      "formatted_start": "01:24:54.640",
      "formatted_end": "01:24:56.640",
      "text": "از دارخونه شایدان کلبی"
    },
    {
      "id": 105,
      "start": 5096.64,
      "end": 5097.64,
      "formatted_start": "01:24:56.640",
      "formatted_end": "01:24:57.640",
      "text": "باشه عزیزم"
    },
    {
      "id": 106,
      "start": 5097.64,
      "end": 5099.64,
      "formatted_start": "01:24:57.640",
      "formatted_end": "01:24:59.640",
      "text": "اینو عوضش بکنم و بعد دروقت خودتون استفاده کنید"
    },
    {
      "id": 107,
      "start": 5099.64,
      "end": 5100.64,
      "formatted_start": "01:24:59.640",
      "formatted_end": "01:25:00.640",
      "text": "مرسی"
    }
  ],
