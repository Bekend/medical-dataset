    },
    {
      "id": 45,
      "start": 6119.0,
      "end": 6121.0,
      "formatted_start": "01:41:59.000",
      "formatted_end": "01:42:01.000",
      "text": "دو دو، پنج روز پیش"
    },
    {
      "id": 46,
      "start": 6121.0,
      "end": 6123.0,
      "formatted_start": "01:42:01.000",
      "formatted_end": "01:42:03.000",
      "text": "من ریش سویک می داشتم"
    },
    {
      "id": 47,
      "start": 6123.0,
      "end": 6125.0,
      "formatted_start": "01:42:03.000",
      "formatted_end": "01:42:05.000",
      "text": "بعد ریش هم زدن"
    },
    {
      "id": 48,
      "start": 6125.0,
      "end": 6127.0,
      "formatted_start": "01:42:05.000",
      "formatted_end": "01:42:07.000",
      "text": "این برای عبرون"
    },
    {
      "id": 49,
      "start": 6127.0,
      "end": 6129.0,
      "formatted_start": "01:42:07.000",
      "formatted_end": "01:42:09.000",
      "text": "یه زخم شده"
    },
    {
      "id": 50,
      "start": 6129.0,
      "end": 6131.0,
      "formatted_start": "01:42:09.000",
      "formatted_end": "01:42:11.000",
      "text": "نرم از پنجه هایی"
    },
    {
      "id": 51,
      "start": 6131.0,
      "end": 6133.0,
      "formatted_start": "01:42:11.000",
      "formatted_end": "01:42:13.000",
      "text": "از این کچیک بود"
    },
    {
      "id": 52,
      "start": 6133.0,
      "end": 6135.0,
      "formatted_start": "01:42:13.000",
      "formatted_end": "01:42:15.000",
      "text": "شد بزرگ باره"
    },
    {
      "id": 53,
      "start": 6135.0,
      "end": 6165.0,
      "formatted_start": "01:42:15.000",
      "formatted_end": "01:42:45.000",
      "text": "این همین کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کشی کش"
    },
    {
      "id": 54,
      "start": 6165.0,
      "end": 6167.0,
      "formatted_start": "01:42:45.000",
      "formatted_end": "01:42:47.000",
      "text": "اینجا همونه هست"
    },
    {
      "id": 55,
      "start": 6167.0,
      "end": 6169.0,
      "formatted_start": "01:42:47.000",
      "formatted_end": "01:42:49.000",
      "text": "نگران نباش"
    },
    {
      "id": 56,
      "start": 6169.0,
      "end": 6171.0,
      "formatted_start": "01:42:49.000",
      "formatted_end": "01:42:51.000",
      "text": "یه اسپلیک داری"
    },
    {
      "id": 57,
      "start": 6171.0,
      "end": 6173.0,
      "formatted_start": "01:42:51.000",
      "formatted_end": "01:42:53.000",
      "text": "چشمتو ببرم بزرگ بزرگ"
    },
    {
      "id": 58,
      "start": 6173.0,
      "end": 6175.0,
      "formatted_start": "01:42:53.000",
      "formatted_end": "01:42:55.000",
      "text": "مزاج بده"
    },
    {
      "id": 59,
      "start": 6175.0,
      "end": 6177.0,
      "formatted_start": "01:42:55.000",
      "formatted_end": "01:42:57.000",
      "text": "زرگ بره"
    },
    {
      "id": 60,
      "start": 6177.0,
      "end": 6179.0,
      "formatted_start": "01:42:57.000",
      "formatted_end": "01:42:59.000",
      "text": "اول یکم زیرگ کنه"
    },
    {
      "id": 61,
      "start": 6179.0,
      "end": 6181.0,
      "formatted_start": "01:42:59.000",
      "formatted_end": "01:43:01.000",
      "text": "دست داری بردی"
    },
    {
      "id": 62,
      "start": 6181.0,
      "end": 6183.0,
      "formatted_start": "01:43:01.000",
      "formatted_end": "01:43:03.000",
      "text": "دست داروده کردی"
    },
    {
      "id": 63,
      "start": 6183.0,
      "end": 6185.0,
      "formatted_start": "01:43:03.000",
      "formatted_end": "01:43:05.000",
      "text": "دست داروده کردی"
    },
    {
      "id": 64,
      "start": 6185.0,
      "end": 6187.0,
      "formatted_start": "01:43:05.000",
      "formatted_end": "01:43:07.000",
      "text": "نگران نماش"
    },
    {
      "id": 65,
      "start": 6187.0,
      "end": 6189.0,
      "formatted_start": "01:43:07.000",
      "formatted_end": "01:43:09.000",
      "text": "شما بر طرف میشه"
    },
    {
      "id": 66,
      "start": 6189.0,
      "end": 6191.0,
      "formatted_start": "01:43:09.000",
      "formatted_end": "01:43:11.000",
      "text": "ردش همون خواهر نماش"
    },
    {
      "id": 67,
      "start": 6191.0,
      "end": 6193.0,
      "formatted_start": "01:43:11.000",
      "formatted_end": "01:43:13.000",
      "text": "بچه کچیک دارم بس برای بچه"
    },
    {
      "id": 68,
      "start": 6193.0,
      "end": 6196.0,
      "formatted_start": "01:43:13.000",
      "formatted_end": "01:43:16.000",
      "text": "از فردان بهتر شده این گره"
    },
    {
      "id": 69,
      "start": 6196.0,
      "end": 6201.0,
      "formatted_start": "01:43:16.000",
      "formatted_end": "01:43:21.000",
      "text": "این بچه همه یعنی دست دارم تابل نگرفت و خدارش شد"
    },
    {
      "id": 70,
      "start": 6201.0,
      "end": 6205.0,
      "formatted_start": "01:43:21.000",
      "formatted_end": "01:43:25.000",
      "text": "به این دست نزدیم مثلا به این دست بزنیم به راپاس بزنیم"
    },
    {
      "id": 71,
      "start": 6205.0,
      "end": 6209.0,
      "formatted_start": "01:43:25.000",
      "formatted_end": "01:43:29.000",
      "text": "اینجا دست میزنیم راپاس بزنیم به راپاس بزنیم شیرش مرتقل میشه"
    },
    {
      "id": 72,
      "start": 6209.0,
      "end": 6213.0,
      "formatted_start": "01:43:29.000",
      "formatted_end": "01:43:33.000",
      "text": "خب کنیم سیزه"
    },
    {
