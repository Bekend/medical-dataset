      "id": 86,
      "start": 6248.0,
      "end": 6250.0,
      "formatted_start": "01:44:08.000",
      "formatted_end": "01:44:10.000",
      "text": "من خیلی بخیمتا هر روز دولت میباره بالا"
    },
    {
      "id": 87,
      "start": 6250.0,
      "end": 6253.0,
      "formatted_start": "01:44:10.000",
      "formatted_end": "01:44:13.000",
      "text": "آره، آره، خیلی زیاد"
    },
    {
      "id": 88,
      "start": 6253.0,
      "end": 6256.0,
      "formatted_start": "01:44:13.000",
      "formatted_end": "01:44:16.000",
      "text": "بتونم بگم، من 200 همشتر نمیدونم"
    },
    {
      "id": 89,
      "start": 6256.0,
      "end": 6257.0,
      "formatted_start": "01:44:16.000",
      "formatted_end": "01:44:17.000",
      "text": "نه با 200 باید نشون"
    },
    {
      "id": 90,
      "start": 6257.0,
      "end": 6260.0,
      "formatted_start": "01:44:17.000",
      "formatted_end": "01:44:20.000",
      "text": "از پرش میدونن با دنبالی 20-80 دقیقا تون"
    },
