      "end": 6271.0,
      "formatted_start": "01:44:29.000",
      "formatted_end": "01:44:31.000",
      "text": "سیکالیفتش را"
    },
    {
      "id": 97,
      "start": 6271.0,
      "end": 6273.0,
      "formatted_start": "01:44:31.000",
      "formatted_end": "01:44:33.000",
      "text": "این سیکالیفت را بیشتر برای زنان میده"
    },
    {
      "id": 98,
      "start": 6273.0,
      "end": 6276.0,
      "formatted_start": "01:44:33.000",
      "formatted_end": "01:44:36.000",
      "text": "بازه میده همین دوتاش خیلی باجبه"
    },
    {
      "id": 99,
      "start": 6276.0,
      "end": 6278.0,
      "formatted_start": "01:44:36.000",
      "formatted_end": "01:44:38.000",
      "text": "چشمی دوتا باشه"
    },
    {
      "id": 100,
      "start": 6278.0,
      "end": 6280.0,
      "formatted_start": "01:44:38.000",
      "formatted_end": "01:44:40.000",
      "text": "باید باید بشونیم"
    },
    {
      "id": 101,
      "start": 6280.0,
      "end": 6282.0,
      "formatted_start": "01:44:40.000",
      "formatted_end": "01:44:42.000",
      "text": "باید بشونیم"
    },
    {
      "id": 102,
      "start": 6282.0,
      "end": 6284.0,
      "formatted_start": "01:44:42.000",
      "formatted_end": "01:44:44.000",
      "text": "باید بشونیم"
    },
    {
      "id": 103,
      "start": 6284.0,
