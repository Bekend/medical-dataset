      "start": 6217.0,
      "end": 6221.0,
      "formatted_start": "01:43:37.000",
      "formatted_end": "01:43:41.000",
      "text": "سه تا کما قارتی بکنیم ایست"
    },
    {
      "id": 75,
      "start": 6221.0,
      "end": 6222.0,
      "formatted_start": "01:43:41.000",
      "formatted_end": "01:43:42.000",
      "text": "پارتی کنم؟"
    },
    {
      "id": 76,
      "start": 6222.0,
      "end": 6223.0,
      "formatted_start": "01:43:42.000",
      "formatted_end": "01:43:43.000",
      "text": "نه"
    },
    {
      "id": 77,
      "start": 6223.0,
      "end": 6224.0,
      "formatted_start": "01:43:43.000",
      "formatted_end": "01:43:44.000",
      "text": "توی مثلا هیچ چیز"
    },
    {
      "id": 78,
      "start": 6224.0,
      "end": 6227.0,
      "formatted_start": "01:43:44.000",
      "formatted_end": "01:43:47.000",
      "text": "کف دست درست دردویکیه یا روغم روغم بزن"
    },
    {
      "id": 79,
      "start": 6227.0,
      "end": 6230.0,
      "formatted_start": "01:43:47.000",
      "formatted_end": "01:43:50.000",
      "text": "اول استره جلده قسمت"
    },
    {
      "id": 80,
      "start": 6230.0,
      "end": 6231.0,
      "formatted_start": "01:43:50.000",
      "formatted_end": "01:43:51.000",
      "text": "باشم"
    },
    {
      "id": 81,
      "start": 6233.0,
      "end": 6235.0,
      "formatted_start": "01:43:53.000",
      "formatted_end": "01:43:55.000",
      "text": "این طولت چقدر میشه؟"
    },
    {
      "id": 82,
      "start": 6235.0,
      "end": 6237.0,
      "formatted_start": "01:43:55.000",
      "formatted_end": "01:43:57.000",
      "text": "چون نه من اینقدر طولی ندارم"
    },
    {
      "id": 83,
      "start": 6238.0,
      "end": 6239.0,
      "formatted_start": "01:43:58.000",
      "formatted_end": "01:43:59.000",
