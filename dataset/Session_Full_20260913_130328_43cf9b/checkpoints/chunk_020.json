      "end": 6262.0,
      "formatted_start": "01:44:21.000",
      "formatted_end": "01:44:22.000",
      "text": "خب؟"
    },
    {
      "id": 93,
      "start": 6262.0,
      "end": 6264.0,
      "formatted_start": "01:44:22.000",
      "formatted_end": "01:44:24.000",
      "text": "و این سیکالیفتش را اگه آره"
    },
