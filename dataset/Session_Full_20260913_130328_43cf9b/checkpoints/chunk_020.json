    },
    {
      "id": 12,
      "start": 6052.0,
      "end": 6054.0,
      "formatted_start": "01:40:52.000",
      "formatted_end": "01:40:54.000",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 13,
      "start": 6054.0,
      "end": 6056.0,
      "formatted_start": "01:40:54.000",
      "formatted_end": "01:40:56.000",
      "text": "این افتخار خوبه"
    },
    {
      "id": 14,
      "start": 6059.0,
      "end": 6061.0,
      "formatted_start": "01:40:59.000",
      "formatted_end": "01:41:01.000",
      "text": "باستان بزنم اون"
    },
    {
      "id": 15,
      "start": 6061.0,
      "end": 6063.0,
      "formatted_start": "01:41:01.000",
      "formatted_end": "01:41:03.000",
      "text": "اون دفعه قبل نداده ایده"
    },
    {
      "id": 16,
      "start": 6063.0,
      "end": 6065.0,
      "formatted_start": "01:41:03.000",
      "formatted_end": "01:41:05.000",
      "text": "کمبر خیلی تر"
    },
    {
      "id": 17,
      "start": 6065.0,
      "end": 6067.0,
      "formatted_start": "01:41:05.000",
      "formatted_end": "01:41:07.000",
      "text": "کمبر اینشه"
    },
    {
      "id": 18,
      "start": 6068.0,
      "end": 6070.0,
      "formatted_start": "01:41:08.000",
      "formatted_end": "01:41:10.000",
      "text": "به خیلی خوبه داشتون بود که"
    },
    {
      "id": 19,
      "start": 6073.0,
      "end": 6075.0,
      "formatted_start": "01:41:13.000",
      "formatted_end": "01:41:15.000",
      "text": "بازم یه داروشتون بشه"
    },
    {
      "id": 20,
      "start": 6075.0,
      "end": 6077.0,
      "formatted_start": "01:41:15.000",
      "formatted_end": "01:41:17.000",
      "text": "آره، که این مقدمه شده؟"
    },
    {
      "id": 21,
      "start": 6077.0,
      "end": 6080.0,
      "formatted_start": "01:41:17.000",
      "formatted_end": "01:41:20.000",
      "text": "که داروشتون بکرده تا دهان داره"
    },
    {
      "id": 22,
      "start": 6080.0,
      "end": 6082.0,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:22.000",
      "text": "تا دهان؟"
    },
    {
      "id": 23,
      "start": 6082.0,
      "end": 6085.0,
      "formatted_start": "01:41:22.000",
      "formatted_end": "01:41:25.000",
      "text": "روز بیسی پردنجم دو هفته همون قبل مشهد رفته این یه بار نیست"
    },
    {
      "id": 24,
      "start": 6085.0,
      "end": 6086.0,
      "formatted_start": "01:41:25.000",
      "formatted_end": "01:41:26.000",
      "text": "باید زیر مورد رو برم"
    },
    {
      "id": 25,
      "start": 6086.0,
      "end": 6088.0,
      "formatted_start": "01:41:26.000",
      "formatted_end": "01:41:28.000",
      "text": "تا حالا شما که هر روز میشین"
    },
    {
      "id": 26,
      "start": 6088.0,
      "end": 6090.0,
      "formatted_start": "01:41:28.000",
      "formatted_end": "01:41:30.000",
      "text": "حالا درم هم دردید"
    },
    {
      "id": 27,
      "start": 6090.0,
      "end": 6092.0,
      "formatted_start": "01:41:30.000",
      "formatted_end": "01:41:32.000",
      "text": "حالا میارن راستتون رو بیرون"
    },
    {
      "id": 28,
      "start": 6092.0,
      "end": 6093.0,
      "formatted_start": "01:41:32.000",
      "formatted_end": "01:41:33.000",
      "text": "سلام"
    },
    {
      "id": 29,
      "start": 6093.0,
      "end": 6094.0,
      "formatted_start": "01:41:33.000",
      "formatted_end": "01:41:34.000",
      "text": "یک سلام سلام"
    },
    {
      "id": 30,
      "start": 6094.0,
      "end": 6096.0,
      "formatted_start": "01:41:34.000",
      "formatted_end": "01:41:36.000",
      "text": "از درد نیست"
    },
    {
      "id": 31,
      "start": 6096.0,
      "end": 6097.0,
      "formatted_start": "01:41:36.000",
      "formatted_end": "01:41:37.000",
      "text": "سلام شما"
    },
    {
      "id": 32,
      "start": 6097.0,
      "end": 6099.0,
      "formatted_start": "01:41:37.000",
      "formatted_end": "01:41:39.000",
