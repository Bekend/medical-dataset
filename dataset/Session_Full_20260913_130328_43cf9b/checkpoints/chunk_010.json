  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3007.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:07.000",
      "text": "مرزه بخورید، سبزی مرزه درم کنید."
    },
    {
      "id": 1,
      "start": 3007.0,
      "end": 3010.0,
      "formatted_start": "00:50:07.000",
      "formatted_end": "00:50:10.000",
      "text": "برنامه گلپوره بخورید."
    },
    {
      "id": 2,
      "start": 3010.0,
      "end": 3013.0,
      "formatted_start": "00:50:10.000",
      "formatted_end": "00:50:13.000",
      "text": "مردم اینجا میگن کلپوره برنامه."
    },
    {
      "id": 3,
      "start": 3013.0,
      "end": 3016.0,
      "formatted_start": "00:50:13.000",
      "formatted_end": "00:50:16.000",
      "text": "سبزی مرزه بخورید."
    },
    {
      "id": 4,
      "start": 3016.0,
      "end": 3018.0,
      "formatted_start": "00:50:16.000",
      "formatted_end": "00:50:18.000",
      "text": "مرزه بخورید."
    },
    {
      "id": 5,
      "start": 3018.0,
      "end": 3020.0,
      "formatted_start": "00:50:18.000",
      "formatted_end": "00:50:20.000",
      "text": "مرزه بخورید."
    },
    {
      "id": 6,
      "start": 3020.0,
      "end": 3022.0,
      "formatted_start": "00:50:20.000",
      "formatted_end": "00:50:22.000",
      "text": "این ره همه باید میشه."
    },
    {
      "id": 7,
      "start": 3022.0,
      "end": 3024.0,
      "formatted_start": "00:50:22.000",
      "formatted_end": "00:50:24.000",
      "text": "الان بیدار مرزه بشنید."
    },
    {
      "id": 8,
      "start": 3024.0,
      "end": 3026.0,
      "formatted_start": "00:50:24.000",
      "formatted_end": "00:50:26.000",
      "text": "این ره همه باید بشنید."
    },
    {
      "id": 9,
      "start": 3026.0,
      "end": 3028.0,
      "formatted_start": "00:50:26.000",
      "formatted_end": "00:50:28.000",
      "text": "باید بشنید."
    },
    {
      "id": 10,
      "start": 3028.0,
      "end": 3031.24,
      "formatted_start": "00:50:28.000",
      "formatted_end": "00:50:31.240",
      "text": "خب، شکرم باز بگو روی تخت بگو واسه تو"
    },
    {
      "id": 11,
      "start": 3031.24,
      "end": 3033.0,
      "formatted_start": "00:50:31.240",
      "formatted_end": "00:50:33.000",
      "text": "پس اونو براش بگو بخور"
    },
    {
      "id": 12,
      "start": 3033.0,
      "end": 3034.0,
      "formatted_start": "00:50:33.000",
      "formatted_end": "00:50:34.000",
      "text": "بیا"
    },
    {
      "id": 13,
      "start": 3034.0,
      "end": 3036.5,
      "formatted_start": "00:50:34.000",
      "formatted_end": "00:50:36.500",
      "text": "چون از دوست در حتیری رفته بگو نداریم"
    },
    {
      "id": 14,
      "start": 3036.5,
      "end": 3038.5,
      "formatted_start": "00:50:36.500",
      "formatted_end": "00:50:38.500",
      "text": "باشی نداشت میشه به جهنم"
    },
    {
      "id": 15,
      "start": 3038.5,
      "end": 3041.0,
      "formatted_start": "00:50:38.500",
      "formatted_end": "00:50:41.000",
      "text": "هر وقت تاریم میگن یا این صادقه اونو"
    },
    {
      "id": 16,
      "start": 3041.0,
      "end": 3042.5,
      "formatted_start": "00:50:41.000",
      "formatted_end": "00:50:42.500",
      "text": "یا اونو ورد خیابان و شاول"
    },
    {
      "id": 17,
      "start": 3042.5,
      "end": 3045.0,
      "formatted_start": "00:50:42.500",
      "formatted_end": "00:50:45.000",
      "text": "اول یه حتیری خیلی کچیک هست همه چی داره"
    },
    {
      "id": 18,
      "start": 3045.0,
      "end": 3047.0,
      "formatted_start": "00:50:45.000",
      "formatted_end": "00:50:47.000",
      "text": "سر نبا"
    },
    {
      "id": 19,
      "start": 3047.0,
      "end": 3048.0,
      "formatted_start": "00:50:47.000",
      "formatted_end": "00:50:48.000",
      "text": "چارا نبا"
    },
    {
      "id": 20,
      "start": 3048.0,
      "end": 3050.0,
      "formatted_start": "00:50:48.000",
      "formatted_end": "00:50:50.000",
      "text": "نب نبا بگو نیست"
    },
    {
      "id": 21,
      "start": 3050.0,
      "end": 3054.0,
      "formatted_start": "00:50:50.000",
      "formatted_end": "00:50:54.000",
      "text": "همین دارو خانه ای دوست در خویستانه که گذشتی"
    },
    {
      "id": 22,
      "start": 3054.0,
      "end": 3056.0,
      "formatted_start": "00:50:54.000",
      "formatted_end": "00:50:56.000",
      "text": "خیلی خوشکاری هست"
    },
    {
      "id": 23,
      "start": 3056.0,
      "end": 3058.0,
      "formatted_start": "00:50:56.000",
      "formatted_end": "00:50:58.000",
      "text": "اکتارش بگیر یه وجه بگیر"
    },
    {
      "id": 24,
      "start": 3058.0,
      "end": 3060.0,
      "formatted_start": "00:50:58.000",
      "formatted_end": "00:51:00.000",
      "text": "جان سلام"
    },
    {
      "id": 25,
      "start": 3060.0,
      "end": 3062.0,
      "formatted_start": "00:51:00.000",
      "formatted_end": "00:51:02.000",
      "text": "سلام گرفتی؟"
    },
    {
      "id": 26,
      "start": 3062.0,
      "end": 3064.0,
