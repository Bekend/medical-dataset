  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9307.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:07.000",
      "text": "اوه، اوه، رفتن، حروسی من نرفته میشه، سخته بودم. این، من رسان بگو به اینجایی که بتونم قدمات را بیدارم."
    },
    {
      "id": 1,
      "start": 9307.0,
      "end": 9312.0,
      "formatted_start": "02:35:07.000",
      "formatted_end": "02:35:12.000",
      "text": "اما چون دو ریال از بیمار بگیرم، بیمار بیاد، واقعا این را دارم بگیرم."
    },
    {
      "id": 2,
      "start": 9312.0,
      "end": 9321.0,
      "formatted_start": "02:35:12.000",
      "formatted_end": "02:35:21.000",
      "text": "حالا من بگم خانم سرامی دفعه پیش موبایل من برد. ها؟ هزار بگیری بیا بگرد که فکر کنم. من دلت میشکرم از من دیگه."
    },
    {
      "id": 3,
      "start": 9321.0,
      "end": 9323.0,
      "formatted_start": "02:35:21.000",
      "formatted_end": "02:35:23.000",
      "text": "دفعه وقت دیگه می‌گه اینجا می‌گه نه"
    },
    {
      "id": 4,
      "start": 9323.0,
      "end": 9326.0,
      "formatted_start": "02:35:23.000",
      "formatted_end": "02:35:26.000",
      "text": "این به من دوست می‌گه من چجوری بیا"
    },
    {
      "id": 5,
      "start": 9326.0,
      "end": 9329.0,
      "formatted_start": "02:35:26.000",
      "formatted_end": "02:35:29.000",
      "text": "هر چقدر به من طلبم بده باز می‌گه نمی‌خواب"
    },
    {
      "id": 6,
      "start": 9329.0,
      "end": 9331.0,
      "formatted_start": "02:35:29.000",
      "formatted_end": "02:35:31.000",
      "text": "چون شخصیت من ها خوب"
    },
    {
      "id": 7,
      "start": 9331.0,
      "end": 9335.0,
      "formatted_start": "02:35:31.000",
      "formatted_end": "02:35:35.000",
      "text": "پیش فرضش اینه که این دوست به من می‌گه دنباله بیا که مثلا پول بگیره"
    },
    {
      "id": 8,
      "start": 9335.0,
      "end": 9338.0,
      "formatted_start": "02:35:35.000",
      "formatted_end": "02:35:38.000",
      "text": "اگه چه فکر و پزش که داشته باشه"
    },
    {
      "id": 9,
      "start": 9338.0,
      "end": 9342.0,
      "formatted_start": "02:35:38.000",
      "formatted_end": "02:35:42.000",
      "text": "باید ازش دوری کرده باقی همه من به شما پزش کنم"
    },
    {
      "id": 10,
      "start": 9342.0,
      "end": 9345.0,
      "formatted_start": "02:35:42.000",
      "formatted_end": "02:35:45.000",
      "text": "او نمی‌گم من که نتیجه رو دیدم مثلا"
    },
    {
      "id": 11,
      "start": 9345.0,
      "end": 9347.0,
      "formatted_start": "02:35:45.000",
      "formatted_end": "02:35:47.000",
      "text": "ماردام شده نیسته"
    },
    {
      "id": 12,
      "start": 9347.0,
      "end": 9349.0,
      "formatted_start": "02:35:47.000",
      "formatted_end": "02:35:49.000",
      "text": "این کسی دیگه کامل کدام بود"
    },
    {
      "id": 13,
      "start": 9349.0,
      "end": 9350.0,
      "formatted_start": "02:35:49.000",
      "formatted_end": "02:35:50.000",
      "text": "این کسی دیگه کامل کدام بود"
    },
    {
      "id": 14,
      "start": 9350.0,
      "end": 9352.0,
      "formatted_start": "02:35:50.000",
      "formatted_end": "02:35:52.000",
      "text": "این کسی دیگه کامل کدام بود"
    },
    {
      "id": 15,
      "start": 9352.0,
      "end": 9353.0,
      "formatted_start": "02:35:52.000",
      "formatted_end": "02:35:53.000",
