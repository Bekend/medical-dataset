      "id": 46,
      "start": 9425.0,
      "end": 9427.0,
      "formatted_start": "02:37:05.000",
      "formatted_end": "02:37:07.000",
      "text": "از این چی نیست؟"
    },
    {
      "id": 47,
      "start": 9427.0,
      "end": 9429.0,
      "formatted_start": "02:37:07.000",
      "formatted_end": "02:37:09.000",
      "text": "از این چی نیست؟"
    },
    {
      "id": 48,
      "start": 9429.0,
      "end": 9431.0,
      "formatted_start": "02:37:09.000",
      "formatted_end": "02:37:11.000",
      "text": "از این چی نیست؟"
    },
    {
      "id": 49,
      "start": 9431.0,
      "end": 9433.0,
      "formatted_start": "02:37:11.000",
      "formatted_end": "02:37:13.000",
      "text": "از این چی نیست؟"
    },
    {
      "id": 50,
      "start": 9433.0,
      "end": 9437.0,
      "formatted_start": "02:37:13.000",
      "formatted_end": "02:37:17.000",
      "text": "این روز جوشان روزیه، میبینم مخلول مثل آقایی به درزون شده"
    },
    {
      "id": 51,
      "start": 9437.0,
      "end": 9441.0,
      "formatted_start": "02:37:17.000",
      "formatted_end": "02:37:21.000",
      "text": "از این کسی کسی کرده، فقط بگه نه، روزهای نزدیکی دیگه ها ماشه"
    },
    {
      "id": 52,
      "start": 9441.0,
      "end": 9447.0,
      "formatted_start": "02:37:21.000",
      "formatted_end": "02:37:27.000",
      "text": "یه درست سونو جرافی بردیم، این روز همه روز"
    },
    {
      "id": 53,
      "start": 9447.0,
      "end": 9461.0,
      "formatted_start": "02:37:27.000",
      "formatted_end": "02:37:41.000",
      "text": "روز سونو جرافی، مرکز سونو جرافی، دوران، آقایی، مزمت همه روز سیزه، یادی"
    },
    {
      "id": 54,
      "start": 9461.0,
      "end": 9465.0,
      "formatted_start": "02:37:41.000",
      "formatted_end": "02:37:45.000",
      "text": "امروز از این روز شیشون باشه؟"
    },
    {
      "id": 55,
      "start": 9465.0,
      "end": 9471.0,
      "formatted_start": "02:37:45.000",
      "formatted_end": "02:37:51.000",
      "text": "نه، همه روز دیگه باشه، در این روز شیشون باشه"
    },
    {
      "id": 56,
      "start": 9471.0,
      "end": 9474.0,
      "formatted_start": "02:37:51.000",
      "formatted_end": "02:37:54.000",
      "text": "ساله برای تو بگیرم که دیگه باشه"
    },
    {
      "id": 57,
      "start": 9474.0,
      "end": 9477.0,
      "formatted_start": "02:37:54.000",
      "formatted_end": "02:37:57.000",
      "text": "خوب، شما باید برداریم"
    },
    {
      "id": 58,
      "start": 9477.0,
      "end": 9481.0,
      "formatted_start": "02:37:57.000",
      "formatted_end": "02:38:01.000",
      "text": "روزهای نزدیکی دو ساعت باید باقی ببینید، نزدیکی ترمب شد"
    },
    {
      "id": 59,
      "start": 9481.0,
      "end": 9485.0,
      "formatted_start": "02:38:01.000",
      "formatted_end": "02:38:05.000",
      "text": "کیسی پلیزر رو یه ماشن بذارید، هوا باره نشد، کاردو ساعت باره نشد"
    },
    {
      "id": 60,
      "start": 9485.0,
      "end": 9488.0,
      "formatted_start": "02:38:05.000",
      "formatted_end": "02:38:08.000",
      "text": "سطح شیف داره خواهد باقی باره نشد"
    },
    {
      "id": 61,
      "start": 9488.0,
      "end": 9499.0,
      "formatted_start": "02:38:08.000",
      "formatted_end": "02:38:19.000",
      "text": "حتما سنگ کنی قبل از نزدیک، قبل از، برد، ممکنه قبل از اینکه شوهرت مایه مری برزه، ارزا بشی، بدنت شمشون بارد بشه و برزه"
    },
    {
      "id": 62,
      "start": 9499.0,
      "end": 9507.0,
      "formatted_start": "02:38:19.000",
      "formatted_end": "02:38:27.000",
      "text": "وقتی مایه مری شیر افتاد جرون نکنه میمانه به بدنه و سابق بیم سی تا حالت کچی بشه، بعد خارج بکنه"
    },
    {
      "id": 63,
      "start": 9507.0,
      "end": 9511.0,
      "formatted_start": "02:38:27.000",
      "formatted_end": "02:38:31.000",
      "text": "اگر حالت بزرگ رو بکشه بیرون، همه رو میمکنه میارو بیرون"
    },
    {
      "id": 64,
      "start": 9511.0,
      "end": 9516.0,
      "formatted_start": "02:38:31.000",
      "formatted_end": "02:38:36.000",
      "text": "خداواً برای این دوتا فاس بزاشته برای برده اینجا حالتش بزرگ و اینجا کچیب میشه"
    },
    {
      "id": 65,
      "start": 9516.0,
      "end": 9520.0,
      "formatted_start": "02:38:36.000",
      "formatted_end": "02:38:40.000",
      "text": "بخاطر اینکه کچیب بشه که نکشه بیرون مایون پرده رو جمع بشه"
    },
    {
      "id": 66,
      "start": 9520.0,
      "end": 9525.0,
      "formatted_start": "02:38:40.000",
      "formatted_end": "02:38:45.000",
      "text": "برد بیاره بیرون، کشه بیرون، دهن رنگ گاز میاد، هوا میده، مایون پشت میشه"
    },
    {
      "id": 67,
      "start": 9525.0,
      "end": 9529.0,
      "formatted_start": "02:38:45.000",
      "formatted_end": "02:38:49.000",
      "text": "کیس پلیزر رو بزاره، کلوم کنه، یه زنن با دست بمنده"
    },
    {
      "id": 68,
      "start": 9529.0,
      "end": 9534.0,
      "formatted_start": "02:38:49.000",
      "formatted_end": "02:38:54.000",
      "text": "روی شگه ها بخشونه، گرم باشه، پوله نمیخوشنه، به نهایت نخورید"
    },
    {
      "id": 69,
      "start": 9534.0,
      "end": 9539.0,
      "formatted_start": "02:38:54.000",
      "formatted_end": "02:38:59.000",
      "text": "بسته باشه، باد بارا باشه، دو ساعت بیمانی، توقع هموردی خداست"
    },
    {
      "id": 70,
      "start": 9539.0,
      "end": 9543.0,
      "formatted_start": "02:38:59.000",
      "formatted_end": "02:39:03.000",
      "text": "انشاءالله اگر خروج این پنجتان از زیر رو که کنجا نداشتم"
    },
    {
      "id": 71,
      "start": 9543.0,
      "end": 9547.0,
      "formatted_start": "02:39:03.000",
      "formatted_end": "02:39:07.000",
      "text": "انجام بدین، اینش انشاءالله میگیره، بفردید"
    },
    {
      "id": 72,
      "start": 9547.0,
      "end": 9549.0,
      "formatted_start": "02:39:07.000",
      "formatted_end": "02:39:09.000",
      "text": "بسیار بخورید"
    },
    {
      "id": 73,
      "start": 9549.0,
      "end": 9556.0,
      "formatted_start": "02:39:09.000",
      "formatted_end": "02:39:16.000",
      "text": "پس پنج باره یه آ اضافه بکنید و سنان که من نوشتم دیگه صفت چیز نداره"
    },
    {
      "id": 74,
      "start": 9556.0,
      "end": 9564.0,
      "formatted_start": "02:39:16.000",
      "formatted_end": "02:39:24.000",
      "text": "این سرام ها یکی هست"
    },
    {
      "id": 75,
      "start": 9564.0,
      "end": 9568.0,
      "formatted_start": "02:39:24.000",
      "formatted_end": "02:39:28.000",
      "text": "این هم آنکول هار داخلش بریسند"
    },
    {
      "id": 76,
      "start": 9568.0,
      "end": 9572.0,
      "formatted_start": "02:39:28.000",
      "formatted_end": "02:39:32.000",
      "text": "این هم برای کبه تصمیم داده هست"
    },
    {
      "id": 77,
      "start": 9572.0,
      "end": 9576.0,
      "formatted_start": "02:39:32.000",
      "formatted_end": "02:39:36.000",
      "text": "مردتونی که میخوردی سه بوده"
    },
    {
      "id": 78,
      "start": 9576.0,
      "end": 9580.0,
      "formatted_start": "02:39:36.000",
      "formatted_end": "02:39:40.000",
      "text": "این پنج ها شفقه از دروهی که میخوردی"
    },
    {
      "id": 79,
      "start": 9580.0,
      "end": 9584.0,
      "formatted_start": "02:39:40.000",
      "formatted_end": "02:39:44.000",
      "text": "این هم زیر زبانی نخوردن این"
    },
    {
      "id": 80,
      "start": 9584.0,
      "end": 9587.0,
      "formatted_start": "02:39:44.000",
      "formatted_end": "02:39:47.000",
      "text": "نه نه، یک ساعت پرست که سوالش نیست در این وقت"
    },
    {
      "id": 81,
      "start": 9587.0,
      "end": 9593.0,
      "formatted_start": "02:39:47.000",
      "formatted_end": "02:39:53.000",
      "text": "یک ساعت پرست خواب بخون، اگه به یکی جواب نداد دوتا هم میشه خوابه، یکیش میشه دوتا هم، یکیش هم"
    },
    {
      "id": 82,
      "start": 9593.0,
      "end": 9594.0,
      "formatted_start": "02:39:53.000",
      "formatted_end": "02:39:54.000",
      "text": "پنجه"
    },
    {
      "id": 83,
      "start": 9594.0,
      "end": 9595.0,
      "formatted_start": "02:39:54.000",
      "formatted_end": "02:39:55.000",
      "text": "خب از این صبح برن شما نداریم"
    },
    {
      "id": 84,
      "start": 9595.0,
      "end": 9598.0,
      "formatted_start": "02:39:55.000",
      "formatted_end": "02:39:58.000",
      "text": "آره برن میشیم، یک ساعت پرست خواب"
    }
  ],
  "status": "completed"
}