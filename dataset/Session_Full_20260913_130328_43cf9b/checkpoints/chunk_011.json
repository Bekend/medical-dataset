  "stt_segments": [
    {
      "id": 0,
      "start": 3300.0,
      "end": 3312.0,
      "formatted_start": "00:55:00.000",
      "formatted_end": "00:55:12.000",
      "text": "سیپ، موز، انام، برنج، برنج هم بیشتر به کته بخدو شده همه سردشو بگیرد، زرنه نرم باشه برنج."
    },
    {
      "id": 1,
      "start": 3312.0,
      "end": 3314.0,
      "formatted_start": "00:55:12.000",
      "formatted_end": "00:55:14.000",
      "text": "سرخوانم برنج بخورم"
    },
    {
      "id": 2,
      "start": 3314.0,
      "end": 3317.0,
      "formatted_start": "00:55:14.000",
      "formatted_end": "00:55:17.000",
      "text": "برنج با مربع بهت"
    },
    {
      "id": 3,
      "start": 3317.0,
      "end": 3320.0,
      "formatted_start": "00:55:17.000",
      "formatted_end": "00:55:20.000",
      "text": "برنج با مربع بهتوش برزون بخورم"
    },
    {
      "id": 4,
      "start": 3320.0,
      "end": 3323.0,
      "formatted_start": "00:55:20.000",
      "formatted_end": "00:55:23.000",
      "text": "هیچ اشکال نداره دو سه روز نوی اصلا نخورم"
    },
    {
      "id": 5,
      "start": 3323.0,
      "end": 3324.0,
      "formatted_start": "00:55:23.000",
      "formatted_end": "00:55:24.000",
      "text": "گندم هیچی هست"
    },
    {
      "id": 6,
      "start": 3324.0,
      "end": 3326.0,
      "formatted_start": "00:55:24.000",
      "formatted_end": "00:55:26.000",
      "text": "سویت هم نخورم"
    },
    {
      "id": 7,
      "start": 3326.0,
      "end": 3328.0,
      "formatted_start": "00:55:26.000",
      "formatted_end": "00:55:28.000",
      "text": "بودت به گندم حساس شده"
    },
    {
      "id": 8,
      "start": 3328.0,
      "end": 3329.0,
      "formatted_start": "00:55:28.000",
      "formatted_end": "00:55:29.000",
      "text": "اسفه بوده"
    },
    {
      "id": 9,
      "start": 3329.0,
      "end": 3331.0,
      "formatted_start": "00:55:29.000",
      "formatted_end": "00:55:31.000",
      "text": "دکتر مقصد سو دوتا سو دوتا شب"
    },
    {
      "id": 10,
      "start": 3331.0,
      "end": 3333.0,
      "formatted_start": "00:55:31.000",
      "formatted_end": "00:55:33.000",
      "text": "روی فرامیل از این"
    },
    {
      "id": 11,
      "start": 3333.0,
      "end": 3335.0,
      "formatted_start": "00:55:33.000",
      "formatted_end": "00:55:35.000",
      "text": "چهان پرسه"
    },
    {
      "id": 12,
      "start": 3337.0,
      "end": 3338.0,
      "formatted_start": "00:55:37.000",
      "formatted_end": "00:55:38.000",
      "text": "چیز"
    },
    {
      "id": 13,
      "start": 3338.0,
      "end": 3340.0,
      "formatted_start": "00:55:38.000",
      "formatted_end": "00:55:40.000",
      "text": "فارمیل آکت"
    },
    {
      "id": 14,
      "start": 3340.0,
      "end": 3342.0,
      "formatted_start": "00:55:40.000",
      "formatted_end": "00:55:42.000",
      "text": "بایو فلورا"
    },
    {
      "id": 15,
      "start": 3342.0,
      "end": 3351.0,
      "formatted_start": "00:55:42.000",
      "formatted_end": "00:55:51.000",
      "text": "بایو فلورا"
    },
    {
      "id": 16,
      "start": 3351.0,
      "end": 3354.0,
      "formatted_start": "00:55:51.000",
      "formatted_end": "00:55:54.000",
      "text": "روزی بعده"
    },
    {
      "id": 17,
      "start": 3354.0,
      "end": 3356.0,
      "formatted_start": "00:55:54.000",
      "formatted_end": "00:55:56.000",
      "text": "چرا؟ خود پیشنه کردم"
    },
    {
      "id": 18,
      "start": 3356.0,
      "end": 3358.0,
      "formatted_start": "00:55:56.000",
      "formatted_end": "00:55:58.000",
      "text": "سروم"
    },
    {
      "id": 19,
      "start": 3358.0,
      "end": 3362.0,
      "formatted_start": "00:55:58.000",
      "formatted_end": "00:56:02.000",
      "text": "سروم پنتو بوتون"
    },
    {
      "id": 20,
      "start": 3362.0,
      "end": 3366.0,
      "formatted_start": "00:56:02.000",
      "formatted_end": "00:56:06.000",
      "text": "سروم پنتو بوتون"
    },
    {
      "id": 21,
      "start": 3366.0,
      "end": 3368.0,
      "formatted_start": "00:56:06.000",
      "formatted_end": "00:56:08.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 22,
      "start": 3368.0,
      "end": 3370.0,
      "formatted_start": "00:56:08.000",
      "formatted_end": "00:56:10.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 23,
      "start": 3370.0,
      "end": 3372.0,
      "formatted_start": "00:56:10.000",
      "formatted_end": "00:56:12.000",
      "text": "اینجا باید برداریم"
    },
    {
      "id": 24,
      "start": 3372.0,
      "end": 3374.0,
      "formatted_start": "00:56:12.000",
      "formatted_end": "00:56:14.000",
      "text": "بگو بگو بگو"
    },
    {
      "id": 25,
      "start": 3374.0,
      "end": 3376.0,
      "formatted_start": "00:56:14.000",
      "formatted_end": "00:56:16.000",
      "text": "آیرو بیت"
    },
    {
      "id": 26,
      "start": 3376.0,
      "end": 3378.0,
      "formatted_start": "00:56:16.000",
      "formatted_end": "00:56:18.000",
      "text": "آیرو بیت داری؟"
    },
    {
      "id": 27,
      "start": 3378.0,
      "end": 3380.0,
      "formatted_start": "00:56:18.000",
      "formatted_end": "00:56:20.000",
      "text": "آیرو بیتش بگیرسم"
    },
    {
      "id": 28,
      "start": 3380.0,
      "end": 3382.0,
      "formatted_start": "00:56:20.000",
      "formatted_end": "00:56:22.000",
      "text": "آیرو بیت"
    },
    {
      "id": 29,
      "start": 3382.0,
      "end": 3384.0,
      "formatted_start": "00:56:22.000",
      "formatted_end": "00:56:24.000",
      "text": "اگه نبود، گاهی نمیتونی بکنه"
    },
    {
      "id": 30,
      "start": 3384.0,
      "end": 3386.0,
      "formatted_start": "00:56:24.000",
      "formatted_end": "00:56:26.000",
      "text": "چون گاهی باست شروع میکنه"
    },
    {
      "id": 31,
      "start": 3386.0,
      "end": 3388.0,
      "formatted_start": "00:56:26.000",
      "formatted_end": "00:56:28.000",
      "text": "آیرون مکس میکنه"
    },
    {
      "id": 32,
      "start": 3388.0,
      "end": 3390.0,
      "formatted_start": "00:56:28.000",
      "formatted_end": "00:56:30.000",
      "text": "نه من راجع به دیگه میگم"
    },
    {
      "id": 33,
      "start": 3390.0,
      "end": 3392.0,
      "formatted_start": "00:56:30.000",
      "formatted_end": "00:56:32.000",
      "text": "چون هین هر کافین آزاده داریم"
    },
    {
      "id": 34,
      "start": 3392.0,
      "end": 3394.0,
      "formatted_start": "00:56:32.000",
      "formatted_end": "00:56:34.000",
      "text": "آزاده بگیرم؟ تو فاکتر میده"
    },
    {
      "id": 35,
      "start": 3394.0,
      "end": 3396.0,
      "formatted_start": "00:56:34.000",
