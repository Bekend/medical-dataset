  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9030.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:30.000",
      "text": "از اینجا، من از اینجا، از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من از اینجا، من"
    },
    {
      "id": 1,
      "start": 9030.0,
      "end": 9032.54,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:32.540",
      "text": "دخترها میزید میگیدید یه هندانه نمیدن"
    },
    {
      "id": 2,
      "start": 9032.54,
      "end": 9035.66,
      "formatted_start": "02:30:32.540",
      "formatted_end": "02:30:35.660",
      "text": "من الان میخوام اصلا سی میلیون تا پول بگیدم"
    },
    {
      "id": 3,
      "start": 9035.66,
      "end": 9037.84,
      "formatted_start": "02:30:35.660",
      "formatted_end": "02:30:37.840",
      "text": "سی میلیون زیاده یا این مثلا"
    },
    {
      "id": 4,
      "start": 9037.84,
      "end": 9039.54,
      "formatted_start": "02:30:37.840",
      "formatted_end": "02:30:39.540",
      "text": "میگن دیگران میبینید ما هم نمیگن"
    },
    {
      "id": 5,
      "start": 9039.54,
      "end": 9041.06,
      "formatted_start": "02:30:39.540",
      "formatted_end": "02:30:41.060",
      "text": "اصلا درشون نمیخواد من دوباره بگم"
    },
    {
      "id": 6,
      "start": 9041.06,
      "end": 9042.06,
      "formatted_start": "02:30:41.060",
      "formatted_end": "02:30:42.060",
      "text": "اینجا برای درمانه یا"
    },
    {
      "id": 7,
      "start": 9042.06,
      "end": 9043.6,
      "formatted_start": "02:30:42.060",
      "formatted_end": "02:30:43.600",
      "text": "خب پیرانگیان رو دوستن دارم برم"
    },
    {
      "id": 8,
      "start": 9043.6,
      "end": 9044.5,
      "formatted_start": "02:30:43.600",
      "formatted_end": "02:30:44.500",
      "text": "دکتور دیگه ببرم"
    },
    {
      "id": 9,
      "start": 9044.5,
      "end": 9047.86,
      "formatted_start": "02:30:44.500",
      "formatted_end": "02:30:47.860",
      "text": "اصلا زن اصیرشون یه هر جایی پاس دارن ببرن"
    },
    {
      "id": 10,
      "start": 9047.86,
      "end": 9049.76,
      "formatted_start": "02:30:47.860",
      "formatted_end": "02:30:49.760",
      "text": "یک فراموش میگیدیم"
    },
    {
      "id": 11,
      "start": 9049.76,
      "end": 9051.76,
      "formatted_start": "02:30:49.760",
      "formatted_end": "02:30:51.760",
      "text": "امروز نامدکتر گرفتم به این فلان باشم"
    },
    {
      "id": 12,
      "start": 9051.76,
      "end": 9054.76,
      "formatted_start": "02:30:51.760",
      "formatted_end": "02:30:54.760",
      "text": "اسم دکتر بود و اگه مثلا منمتقه دکتر رو باید داریم"
    },
    {
      "id": 13,
      "start": 9054.76,
      "end": 9055.76,
      "formatted_start": "02:30:54.760",
      "formatted_end": "02:30:55.760",
      "text": "از هیوان هست بتونشون بدم"
    },
    {
      "id": 14,
      "start": 9055.76,
      "end": 9056.76,
      "formatted_start": "02:30:55.760",
      "formatted_end": "02:30:56.760",
      "text": "تو من فقط دارم کنم"
    },
    {
      "id": 15,
      "start": 9056.76,
      "end": 9058.76,
      "formatted_start": "02:30:56.760",
      "formatted_end": "02:30:58.760",
      "text": "الان خب من اینجا منمتقه بدم"
    },
    {
      "id": 16,
      "start": 9058.76,
      "end": 9060.76,
      "formatted_start": "02:30:58.760",
      "formatted_end": "02:31:00.760",
      "text": "اصلا اینجا اصلا اینمتقه دکتر رو خوب بود"
    },
    {
      "id": 17,
      "start": 9060.76,
      "end": 9061.76,
      "formatted_start": "02:31:00.760",
      "formatted_end": "02:31:01.760",
      "text": "من دیگه دست می کشیدم"
    },
    {
      "id": 18,
      "start": 9061.76,
      "end": 9065.76,
      "formatted_start": "02:31:01.760",
      "formatted_end": "02:31:05.760",
      "text": "من اگه می دونستم اینجا می توانید کار انجام بده"
    },
    {
      "id": 19,
      "start": 9065.76,
      "end": 9067.76,
      "formatted_start": "02:31:05.760",
      "formatted_end": "02:31:07.760",
      "text": "من دیوانم بیایم این کار رو ننجام بدن"
    },
    {
      "id": 20,
      "start": 9067.76,
      "end": 9069.76,
      "formatted_start": "02:31:07.760",
      "formatted_end": "02:31:09.760",
      "text": "من اصلا شما بیدونید"
    },
    {
      "id": 21,
      "start": 9069.76,
      "end": 9072.3,
      "formatted_start": "02:31:09.760",
      "formatted_end": "02:31:12.300",
      "text": "پزشگیری برای هیچ چی دارم انجام بیدم"
    },
    {
      "id": 22,
      "start": 9072.3,
      "end": 9074.06,
      "formatted_start": "02:31:12.300",
      "formatted_end": "02:31:14.060",
      "text": "هیچ درآمدی حساب نکنی"
    },
    {
      "id": 23,
      "start": 9074.06,
      "end": 9075.1,
      "formatted_start": "02:31:14.060",
      "formatted_end": "02:31:15.100",
      "text": "اصلا کل نیست"
    },
    {
      "id": 24,
      "start": 9075.1,
      "end": 9077.0,
      "formatted_start": "02:31:15.100",
      "formatted_end": "02:31:17.000",
      "text": "صبح تا شب جمع میشه پنج تومن نمیشه"
    },
    {
      "id": 25,
      "start": 9077.0,
      "end": 9079.66,
      "formatted_start": "02:31:17.000",
      "formatted_end": "02:31:19.660",
      "text": "ما پنج تومن، شش تومن در این هم ورزه"
    },
    {
      "id": 26,
      "start": 9079.66,
      "end": 9082.76,
      "formatted_start": "02:31:19.660",
      "formatted_end": "02:31:22.760",
      "text": "اصلا عددی، شما هرام چند توم دادی آمدی؟"
    },
    {
      "id": 27,
      "start": 9082.76,
      "end": 9084.76,
      "formatted_start": "02:31:22.760",
      "formatted_end": "02:31:24.760",
      "text": "الان چند توم دادی؟"
    },
    {
      "id": 28,
      "start": 9084.76,
      "end": 9086.1,
      "formatted_start": "02:31:24.760",
      "formatted_end": "02:31:26.100",
      "text": "میزین تا چهار ساعت"
    },
    {
      "id": 29,
      "start": 9086.1,
      "end": 9088.22,
      "formatted_start": "02:31:26.100",
      "formatted_end": "02:31:28.220",
      "text": "چهار ساعت، دو تا چهار ساعت هم میشه هشت ساعت"
    },
    {
      "id": 30,
      "start": 9088.22,
      "end": 9090.76,
      "formatted_start": "02:31:28.220",
      "formatted_end": "02:31:30.760",
      "text": "هشت ساعت هشت ساعت شما برو آشق بخرد"
    },
    {
      "id": 31,
      "start": 9090.76,
      "end": 9091.9,
      "formatted_start": "02:31:30.760",
      "formatted_end": "02:31:31.900",
      "text": "برای مران جان"
    },
    {
      "id": 32,
      "start": 9091.9,
      "end": 9096.9,
      "formatted_start": "02:31:31.900",
      "formatted_end": "02:31:36.900",
      "text": "یه نوعی مایت های بخواهد، یه نوعی پیشترسی، هیچ چی نمیدونی بگوییم هشتر تورن"
    },
    {
      "id": 33,
      "start": 9096.9,
      "end": 9102.9,
      "formatted_start": "02:31:36.900",
      "formatted_end": "02:31:42.900",
      "text": "هشتر تورن هیچ چی دادن نمیشه، آخیره بگوییم مایت هایی که مثلا من با اون هشتر تورن میخواهم به پوچار نمیسهم، نه"
    },
    {
      "id": 34,
      "start": 9102.9,
      "end": 9111.9,
      "formatted_start": "02:31:42.900",
      "formatted_end": "02:31:51.900",
      "text": "شما اگر هر چی زور تعدادار بشی اون به نفع مردم، دارید رمیدی که سیخ کرده ما بایستی کسی که ایها رو خارج بکنیم"
    },
    {
      "id": 35,
      "start": 9111.9,
      "end": 9116.9,
      "formatted_start": "02:31:51.900",
      "formatted_end": "02:31:56.900",
      "text": "من منتظر بودم که شما حتما این خونه سیاه رو ببینید. من قادرتون رو دیده بودم؟"
    },
    {
      "id": 36,
      "start": 9116.9,
      "end": 9117.9,
      "formatted_start": "02:31:56.900",
      "formatted_end": "02:31:57.900",
      "text": "نه."
    },
    {
      "id": 37,
      "start": 9117.9,
      "end": 9120.9,
      "formatted_start": "02:31:57.900",
      "formatted_end": "02:32:00.900",
      "text": "پس اونگیشتون زنگ زدی گفتی سیاهی، من قرارم چی بگیر کنستم؟"
    },
    {
      "id": 38,
      "start": 9120.9,
      "end": 9126.9,
      "formatted_start": "02:32:00.900",
      "formatted_end": "02:32:06.900",
      "text": "گفتم سیاهی آمد و من میدونم اون رو چه خبره دیگه از این دربانی که دادم میفهمم."
    },
    {
      "id": 39,
      "start": 9126.9,
      "end": 9129.9,
      "formatted_start": "02:32:06.900",
      "formatted_end": "02:32:09.900",
      "text": "خب، حالا که آمد، حالا میتونم برامون بذاره برای نزدیکی."
    },
    {
      "id": 40,
      "start": 9129.9,
      "end": 9134.9,
      "formatted_start": "02:32:09.900",
      "formatted_end": "02:32:14.900",
      "text": "و قبل از این ضیانی دیاد هزار من برای تو باردارون می دادم"
    },
    {
      "id": 41,
      "start": 9134.9,
      "end": 9137.9,
      "formatted_start": "02:32:14.900",
      "formatted_end": "02:32:17.900",
      "text": "نمیتونست باردارون بکنه که من باید می رسندم به اینجا"
    },
    {
      "id": 42,
      "start": 9137.9,
      "end": 9139.9,
      "formatted_start": "02:32:17.900",
      "formatted_end": "02:32:19.900",
      "text": "حالا قصیبی خواره نیست"
    },
    {
      "id": 43,
      "start": 9139.9,
      "end": 9142.9,
      "formatted_start": "02:32:19.900",
      "formatted_end": "02:32:22.900",
      "text": "حالا راه باز شد اسپرد میتونه رو پوست میکنه"
    },
    {
      "id": 44,
      "start": 9142.9,
      "end": 9144.9,
      "formatted_start": "02:32:22.900",
      "formatted_end": "02:32:24.900",
      "text": "تا وقت میتونه افتاده کنه"
    },
    {
      "id": 45,
      "start": 9144.9,
      "end": 9147.9,
      "formatted_start": "02:32:24.900",
      "formatted_end": "02:32:27.900",
      "text": "هر دکتور خوبی هم بینی باز همین کار رو باید پردان بگیره"
    },
    {
      "id": 46,
      "start": 9147.9,
      "end": 9151.9,
      "formatted_start": "02:32:27.900",
      "formatted_end": "02:32:31.900",
      "text": "دکتور خوب باید بگیره میگفت که بعد چهر روز دوباره اقدام میکرده"
    },
    {
      "id": 47,
      "start": 9151.9,
      "end": 9153.9,
      "formatted_start": "02:32:31.900",
      "formatted_end": "02:32:33.900",
      "text": "خب بعد همون با تعمیلش رو داشته باشه"
    },
    {
      "id": 48,
      "start": 9153.9,
      "end": 9157.9,
      "formatted_start": "02:32:33.900",
      "formatted_end": "02:32:37.900",
      "text": "خب الان سؤال کنیم از اینترنت ببینیم بعد چند روز میشه"
    },
    {
      "id": 49,
      "start": 9157.9,
      "end": 9159.9,
      "formatted_start": "02:32:37.900",
      "formatted_end": "02:32:39.900",
      "text": "آنجا با تو تماس گرده"
    },
    {
      "id": 50,
      "start": 9159.9,
      "end": 9161.9,
      "formatted_start": "02:32:39.900",
      "formatted_end": "02:32:41.900",
      "text": "بله بله بله"
    },
    {
      "id": 51,
      "start": 9161.9,
      "end": 9163.9,
      "formatted_start": "02:32:41.900",
      "formatted_end": "02:32:43.900",
      "text": "در یک پیشه بله"
    },
    {
      "id": 52,
      "start": 9163.9,
      "end": 9166.9,
      "formatted_start": "02:32:43.900",
      "formatted_end": "02:32:46.900",
      "text": "بعد اینو فقط دعایش رو کن"
    },
    {
      "id": 53,
      "start": 9166.9,
      "end": 9173.9,
      "formatted_start": "02:32:46.900",
      "formatted_end": "02:32:53.900",
      "text": "سؤال چی کن؟ بعد از سه چند روز باید می کنیم کار بشه"
    },
    {
      "id": 54,
      "start": 9173.9,
      "end": 9175.9,
      "formatted_start": "02:32:53.900",
      "formatted_end": "02:32:55.900",
      "text": "بچه چند ماهه بود؟"
    },
    {
      "id": 55,
      "start": 9175.9,
      "end": 9176.9,
      "formatted_start": "02:32:55.900",
      "formatted_end": "02:32:56.900",
      "text": "شش ماه بودن ببینیم"
    },
    {
      "id": 56,
      "start": 9176.9,
      "end": 9178.9,
      "formatted_start": "02:32:56.900",
      "formatted_end": "02:32:58.900",
      "text": "بچه شش ماهه بود"
    },
    {
      "id": 57,
      "start": 9178.9,
      "end": 9180.9,
      "formatted_start": "02:32:58.900",
      "formatted_end": "02:33:00.900",
      "text": "یه سوال بکنن از همین اینترنت"
    },
    {
      "id": 58,
      "start": 9180.9,
      "end": 9182.9,
      "formatted_start": "02:33:00.900",
      "formatted_end": "02:33:02.900",
      "text": "دارید جواباش مقتول بزاره"
    },
    {
      "id": 59,
      "start": 9182.9,
      "end": 9184.9,
      "formatted_start": "02:33:02.900",
      "formatted_end": "02:33:04.900",
      "text": "نه خدا را کنه بودم"
    },
    {
      "id": 60,
      "start": 9184.9,
      "end": 9186.9,
      "formatted_start": "02:33:04.900",
      "formatted_end": "02:33:06.900",
      "text": "آها باید فارسه نگذاری کنیم"
    },
    {
      "id": 61,
      "start": 9186.9,
      "end": 9188.9,
      "formatted_start": "02:33:06.900",
      "formatted_end": "02:33:08.900",
      "text": "یه دکتر سعی را کن زدن به خواستش بفتش بفتش"
    },
    {
      "id": 62,
      "start": 9188.9,
      "end": 9190.9,
      "formatted_start": "02:33:08.900",
      "formatted_end": "02:33:10.900",
      "text": "بفتش چهار تا شیش ماه باید شب کنی"
    },
    {
      "id": 63,
      "start": 9190.9,
      "end": 9192.9,
      "formatted_start": "02:33:10.900",
      "formatted_end": "02:33:12.900",
      "text": "اول خدا به طرف تو سنوی کنی"
    },
    {
      "id": 64,
      "start": 9192.9,
      "end": 9194.9,
      "formatted_start": "02:33:12.900",
      "formatted_end": "02:33:14.900",
      "text": "پس یه نفر دیگه گفته"
    },
    {
      "id": 65,
      "start": 9194.9,
      "end": 9196.9,
      "formatted_start": "02:33:14.900",
      "formatted_end": "02:33:16.900",
      "text": "تو منتظر این بوده که دکتر رویان بیزیت بگیره از تو"
    },
    {
      "id": 66,
      "start": 9196.9,
      "end": 9198.9,
      "formatted_start": "02:33:16.900",
      "formatted_end": "02:33:18.900",
      "text": "این چیزی؟"
    },
    {
      "id": 67,
      "start": 9198.9,
      "end": 9202.1,
      "formatted_start": "02:33:18.900",
      "formatted_end": "02:33:22.100",
      "text": "تو تو رو این حرف رو منداد. بخورت مثلا 4 تا 6 موبایت سر کنی."
    },
    {
      "id": 68,
      "start": 9202.1,
      "end": 9206.1,
      "formatted_start": "02:33:22.100",
      "formatted_end": "02:33:26.100",
      "text": "مثلا دل سر میشن. واسه من میخوام کسی رو درمان کنم که او من رو دوزدید."
    },
    {
      "id": 69,
      "start": 9206.1,
      "end": 9209.1,
      "formatted_start": "02:33:26.100",
      "formatted_end": "02:33:29.100",
      "text": "خب باز شما ببینید مثلا من تو نفرش گرستم دارم."
    },
    {
      "id": 70,
      "start": 9209.1,
      "end": 9211.1,
      "formatted_start": "02:33:29.100",
      "formatted_end": "02:33:31.100",
      "text": "ببینید من دفعه که شروع میزم. دفعه که شروع میزم. دوتا موبایل گذارید."
    },
    {
      "id": 71,
      "start": 9211.1,
      "end": 9214.1,
      "formatted_start": "02:33:31.100",
      "formatted_end": "02:33:34.100",
      "text": "یکیشون تو ندازدید. به نظرم تو دازید."
    },
    {
      "id": 72,
      "start": 9214.1,
      "end": 9216.1,
      "formatted_start": "02:33:34.100",
      "formatted_end": "02:33:36.100",
      "text": "تا من به تو این حرف رو بگم. تو دفعه بعد اینجا می آیی."
    },
    {
      "id": 73,
      "start": 9216.1,
      "end": 9231.1,
      "formatted_start": "02:33:36.100",
      "formatted_end": "02:33:51.100",
      "text": "نه نه، خانم سرانی دوزه دیگه، من این حد دوزدی دارم میگم، من اگر تو رو بدون این چیز دریافت کنم از تو دوزدی محسوس میشه"
    },
    {
      "id": 74,
      "start": 9231.1,
      "end": 9238.1,
      "formatted_start": "02:33:51.100",
      "formatted_end": "02:33:58.100",
      "text": "من اما تصورم با شخص دیگه یه لحظه آمد، برگره نشان نداره بود به من خانم"
    },
    {
      "id": 75,
      "start": 9238.1,
      "end": 9241.76,
      "formatted_start": "02:33:58.100",
      "formatted_end": "02:34:01.760",
      "text": "گفتش که این خانم سرانی اومده تازه آمده بودن، الان چند تا میدیرم،"
    },
    {
      "id": 76,
      "start": 9241.76,
      "end": 9244.56,
      "formatted_start": "02:34:01.760",
      "formatted_end": "02:34:04.560",
      "text": "خب گفتم اون سرانی زیاد دارم بودی، خب؟"
    },
    {
      "id": 77,
      "start": 9244.56,
      "end": 9249.92,
      "formatted_start": "02:34:04.560",
      "formatted_end": "02:34:09.920",
      "text": "گفتم من یه شمالی بیریم، گفتم یه را در کنه اشتباهی از اون فرق دوتا شمالی بگیره،"
    },
    {
      "id": 78,
      "start": 9249.92,
      "end": 9252.76,
      "formatted_start": "02:34:09.920",
      "formatted_end": "02:34:12.760",
      "text": "خب؟ الان عادت نشده که، تلویم."
    },
    {
      "id": 79,
      "start": 9252.76,
      "end": 9257.04,
      "formatted_start": "02:34:12.760",
      "formatted_end": "02:34:17.040",
      "text": "بعد من اینجا مراقبم که اضافه از تو نگیرم،"
    },
    {
      "id": 80,
      "start": 9257.04,
      "end": 9262.34,
      "formatted_start": "02:34:17.040",
      "formatted_end": "02:34:22.340",
      "text": "این حرف برای من مثل یه قام سر روی آخر داغون."
    },
    {
      "id": 81,
      "start": 9262.34,
      "end": 9265.34,
      "formatted_start": "02:34:22.340",
      "formatted_end": "02:34:25.340",
      "text": "خودشون مثلا دو دفعه شون اومدن اینجا واردار شدن"
    },
    {
      "id": 82,
      "start": 9265.34,
      "end": 9270.34,
      "formatted_start": "02:34:25.340",
      "formatted_end": "02:34:30.340",
      "text": "هم باید که یه بار اومدم و گفتم خب این چیزی که من میدونم هم بیرون در مارم هم اینجا ادامه بیدم"
    },
    {
      "id": 83,
      "start": 9270.34,
      "end": 9272.34,
      "formatted_start": "02:34:30.340",
      "formatted_end": "02:34:32.340",
      "text": "خودشون هم تازه واردار شدن این حرف رو دارن"
    },
    {
      "id": 84,
      "start": 9272.34,
      "end": 9275.34,
      "formatted_start": "02:34:32.340",
      "formatted_end": "02:34:35.340",
      "text": "از خون بچه همین خودم دارن این حرف رو میگن"
    },
    {
      "id": 85,
      "start": 9275.34,
      "end": 9277.34,
      "formatted_start": "02:34:35.340",
      "formatted_end": "02:34:37.340",
      "text": "پس دیگه باید کنار بذارم"
    },
    {
      "id": 86,
      "start": 9277.34,
      "end": 9280.34,
      "formatted_start": "02:34:37.340",
      "formatted_end": "02:34:40.340",
      "text": "نه خب بگم یکی مثل همین"
    },
    {
      "id": 87,
      "start": 9280.34,
      "end": 9287.34,
      "formatted_start": "02:34:40.340",
      "formatted_end": "02:34:47.340",
      "text": "نه دخترم ببین کامل بزشگی دولت تجیب اونها سبسیخ داره ببین"
    },
    {
      "id": 88,
      "start": 9287.34,
      "end": 9291.84,
      "formatted_start": "02:34:47.340",
      "formatted_end": "02:34:51.840",
      "text": "اما این نیست که، ببینید همون شما ترکیه به طورت از اون بیشتر میگیرند"
    },
    {
      "id": 89,
      "start": 9291.84,
      "end": 9297.84,
      "formatted_start": "02:34:51.840",
      "formatted_end": "02:34:57.840",
      "text": "دولت در بعض چیزی که ما سبسکرد میده، واقعا اون رو ما رو زندگی ما رو تفریح نمیدونیم"
    },
    {
      "id": 90,
      "start": 9297.84,
      "end": 9299.84,
      "formatted_start": "02:34:57.840",
      "formatted_end": "02:34:59.840",
      "text": "اون رفتر جنگر گشتن من نشستم اطلاع کنم"
    }
  ],
  "status": "completed"
}