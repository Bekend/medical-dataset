      "end": 10911.0,
      "formatted_start": "03:01:49.000",
      "formatted_end": "03:01:51.000",
      "text": "برابر کلا بیام بیام"
    },
    {
      "id": 35,
      "start": 10911.0,
      "end": 10913.0,
      "formatted_start": "03:01:51.000",
      "formatted_end": "03:01:53.000",
      "text": "بلوچه بازم مشروع"
    },
    {
      "id": 36,
      "start": 10913.0,
      "end": 10917.0,
      "formatted_start": "03:01:53.000",
      "formatted_end": "03:01:57.000",
      "text": "خیلی درمایی بیدم خلقت باز بشه"
    },
    {
      "id": 37,
      "start": 10917.0,
      "end": 10921.0,
      "formatted_start": "03:01:57.000",
      "formatted_end": "03:02:01.000",
      "text": "اول دیپ رو هم شستم"
    },
    {
      "id": 38,
      "start": 10921.0,
      "end": 10925.0,
      "formatted_start": "03:02:01.000",
      "formatted_end": "03:02:05.000",
      "text": "من جزارتن یه شکل قربی که در نظر شما"
    },
    {
      "id": 39,
      "start": 10925.0,
      "end": 10927.0,
      "formatted_start": "03:02:05.000",
      "formatted_end": "03:02:07.000",
      "text": "اوه بده آره"
    },
    {
      "id": 40,
      "start": 10927.0,
      "end": 10929.0,
      "formatted_start": "03:02:07.000",
      "formatted_end": "03:02:09.000",
      "text": "نه نه"
    },
    {
      "id": 41,
      "start": 10929.0,
      "end": 10931.0,
      "formatted_start": "03:02:09.000",
      "formatted_end": "03:02:11.000",
      "text": "جنگر میرفتم دکترون رو بگیرم چرا من یه شکل شدم"
    },
    {
      "id": 42,
      "start": 10931.0,
      "end": 10933.0,
      "formatted_start": "03:02:11.000",
      "formatted_end": "03:02:13.000",
      "text": "یه واسه نه"
    },
    {
      "id": 43,
      "start": 10933.0,
      "end": 10935.0,
      "formatted_start": "03:02:13.000",
      "formatted_end": "03:02:15.000",
      "text": "تنگرسن"
    },
    {
      "id": 44,
      "start": 10935.0,
      "end": 10940.54,
      "formatted_start": "03:02:15.000",
      "formatted_end": "03:02:20.540",
      "text": "چه سرد میشه یه اووان دیگه یا فرقون گوزه داستان نوریگی من کلن برداد"
    },
    {
      "id": 45,
      "start": 10940.54,
      "end": 10941.24,
      "formatted_start": "03:02:20.540",
      "formatted_end": "03:02:21.240",
      "text": "چین سی"
    },
    {
      "id": 46,
      "start": 10941.24,
      "end": 10942.24,
      "formatted_start": "03:02:21.240",
      "formatted_end": "03:02:22.240",
      "text": "اصلا کلن برداد"
    },
    {
      "id": 47,
      "start": 10942.24,
      "end": 10944.88,
      "formatted_start": "03:02:22.240",
      "formatted_end": "03:02:24.880",
      "text": "یه چین سی بکنیم خیلی بهتر میشیم"
    },
    {
      "id": 48,
      "start": 10944.88,
      "end": 10946.98,
      "formatted_start": "03:02:24.880",
      "formatted_end": "03:02:26.980",
      "text": "نکسه"
    },
    {
      "id": 49,
      "start": 10946.98,
      "end": 10949.24,
      "formatted_start": "03:02:26.980",
      "formatted_end": "03:02:29.240",
      "text": "نکسی کنم"
    },
    {
      "id": 50,
      "start": 10949.24,
      "end": 10950.36,
      "formatted_start": "03:02:29.240",
      "formatted_end": "03:02:30.360",
      "text": "کشکر میدیم"
    },
    {
      "id": 51,
      "start": 10950.36,
      "end": 10958.54,
      "formatted_start": "03:02:30.360",
      "formatted_end": "03:02:38.540",
      "text": "خواستم برم درمونتو بشه دو یادارو گفتم"
    },
    {
      "id": 52,
      "start": 10958.54,
      "end": 10960.44,
      "formatted_start": "03:02:38.540",
      "formatted_end": "03:02:40.440",
      "text": "او من درمونتو بشه دو یادارو گفتم"
    },
    {
      "id": 53,
      "start": 10960.44,
      "end": 10962.4,
      "formatted_start": "03:02:40.440",
      "formatted_end": "03:02:42.400",
      "text": "یکی درمونتو بشه درمونتو بشه درمونتو"
    },
    {
      "id": 54,
      "start": 10962.4,
      "end": 10963.42,
      "formatted_start": "03:02:42.400",
      "formatted_end": "03:02:43.420",
      "text": "شمارش یادارو"
    },
    {
      "id": 55,
      "start": 10963.42,
      "end": 10965.42,
      "formatted_start": "03:02:43.420",
      "formatted_end": "03:02:45.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 56,
      "start": 10965.42,
      "end": 10967.42,
      "formatted_start": "03:02:45.420",
      "formatted_end": "03:02:47.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 57,
      "start": 10967.42,
      "end": 10969.42,
      "formatted_start": "03:02:47.420",
      "formatted_end": "03:02:49.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 58,
      "start": 10969.42,
      "end": 10971.42,
      "formatted_start": "03:02:49.420",
      "formatted_end": "03:02:51.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 59,
      "start": 10971.42,
      "end": 10973.42,
      "formatted_start": "03:02:51.420",
      "formatted_end": "03:02:53.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 60,
      "start": 10973.42,
      "end": 10975.42,
      "formatted_start": "03:02:53.420",
      "formatted_end": "03:02:55.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 61,
      "start": 10975.42,
      "end": 10977.42,
      "formatted_start": "03:02:55.420",
      "formatted_end": "03:02:57.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 62,
      "start": 10977.42,
      "end": 10979.42,
      "formatted_start": "03:02:57.420",
      "formatted_end": "03:02:59.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 63,
      "start": 10979.42,
      "end": 10981.42,
      "formatted_start": "03:02:59.420",
      "formatted_end": "03:03:01.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 64,
      "start": 10981.42,
      "end": 10983.42,
      "formatted_start": "03:03:01.420",
      "formatted_end": "03:03:03.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 65,
      "start": 10983.42,
      "end": 10985.42,
      "formatted_start": "03:03:03.420",
      "formatted_end": "03:03:05.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 66,
      "start": 10985.42,
      "end": 10987.42,
      "formatted_start": "03:03:05.420",
      "formatted_end": "03:03:07.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 67,
      "start": 10987.42,
      "end": 10989.42,
      "formatted_start": "03:03:07.420",
      "formatted_end": "03:03:09.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 68,
      "start": 10989.42,
      "end": 10991.42,
      "formatted_start": "03:03:09.420",
      "formatted_end": "03:03:11.420",
      "text": "این را باید بگیریم."
    },
    {
      "id": 69,
      "start": 10993.42,
      "end": 11003.02,
      "formatted_start": "03:03:13.420",
      "formatted_end": "03:03:23.020",
      "text": "در بهداش باید آدم کار رو برای خدا بکنه مثل یک حالت بسیجی بود"
    },
    {
      "id": 70,
      "start": 11003.02,
      "end": 11008.02,
      "formatted_start": "03:03:23.020",
      "formatted_end": "03:03:28.020",
      "text": "همین برای حقوق و برنامه های تشکیل هایی هر پا هم باشدن"
    },
    {
      "id": 71,
      "start": 11008.02,
      "end": 11011.82,
      "formatted_start": "03:03:28.020",
      "formatted_end": "03:03:31.820",
      "text": "لازم فوز بشکن و آبیا یکی هست"
    },
    {
      "id": 72,
      "start": 11011.82,
      "end": 11017.42,
      "formatted_start": "03:03:31.820",
      "formatted_end": "03:03:37.420",
      "text": "چه بسیار کسی که بیشتر قدمت میخواد توضیح هم بشه"
    },
    {
      "id": 73,
      "start": 11017.42,
      "end": 11023.42,
      "formatted_start": "03:03:37.420",
      "formatted_end": "03:03:43.420",
      "text": "هم هست که بسیار برای من این سال گذشته تو این سیستم کاری اصلا فیک نیست"
    },
    {
      "id": 74,
      "start": 11023.42,
      "end": 11028.88,
      "formatted_start": "03:03:43.420",
      "formatted_end": "03:03:48.880",
      "text": "یعنی من میگم نیروار شما همون کاری که انجام میدین دوتا بیمار تشابهانی بسیار میگم اینکه"
    },
    {
      "id": 75,
      "start": 11028.88,
      "end": 11031.24,
      "formatted_start": "03:03:48.880",
      "formatted_end": "03:03:51.240",
      "text": "همونا رو بشنسین و لیبر همونا رو بسنین"
    },
    {
      "id": 76,
      "start": 11031.24,
      "end": 11035.56,
      "formatted_start": "03:03:51.240",
      "formatted_end": "03:03:55.560",
      "text": "ولی شما تو استانت مومری عدده است که شما رو برزن بودن"
    },
    {
      "id": 77,
      "start": 11035.56,
      "end": 11038.58,
      "formatted_start": "03:03:55.560",
      "formatted_end": "03:03:58.580",
      "text": "آقا میزن دکتور شاپس نوید درست دارد خیلی اوکی"
    },
    {
      "id": 78,
      "start": 11038.58,
      "end": 11040.36,
      "formatted_start": "03:03:58.580",
      "formatted_end": "03:04:00.360",
      "text": "شما ده هفته دی چرا هفته دی؟"
    },
    {
      "id": 79,
      "start": 11040.36,
      "end": 11043.18,
      "formatted_start": "03:04:00.360",
      "formatted_end": "03:04:03.180",
      "text": "باید بیایی توضیح دیدید آقا من حقیقتاً واقعیه"
    },
    {
      "id": 80,
      "start": 11043.18,
      "end": 11047.98,
      "formatted_start": "03:04:03.180",
      "formatted_end": "03:04:07.980",
      "text": "اصلا سراغونی که ۱۹۰ نمیرونید، آقا باید باشید تو این جمعیت شما ۹۵ درصد"
    },
    {
      "id": 81,
      "start": 11047.98,
      "end": 11052.12,
      "formatted_start": "03:04:07.980",
      "formatted_end": "03:04:12.120",
      "text": "این برنامه رو تو این حضای جامعه مثلا معقب کنید، واقعا احلامی نیست کدار"
    },
    {
      "id": 82,
      "start": 11052.12,
      "end": 11055.12,
      "formatted_start": "03:04:12.120",
      "formatted_end": "03:04:15.120",
      "text": "ولی بابد این کار پایین داره، یکی ایفی شما محسوس میشوند"
    },
    {
      "id": 83,
      "start": 11055.12,
      "end": 11056.86,
      "formatted_start": "03:04:15.120",
      "formatted_end": "03:04:16.860",
      "text": "چون تشمیل به آمارسازی می کنند؟"
    },
    {
      "id": 84,
      "start": 11056.86,
      "end": 11057.98,
      "formatted_start": "03:04:16.860",
      "formatted_end": "03:04:17.980",
      "text": "اصلا اینجوری دارد"
    },
    {
      "id": 85,
      "start": 11057.98,
      "end": 11059.18,
      "formatted_start": "03:04:17.980",
      "formatted_end": "03:04:19.180",
      "text": "در اینجور؟"
    },
    {
      "id": 86,
      "start": 11059.18,
      "end": 11063.58,
      "formatted_start": "03:04:19.180",
      "formatted_end": "03:04:23.580",
      "text": "چرا؟ دیگه ندارم کده یا ازن بگیر انتی سیسم شده و بگیر نه کار من اجامه داره"
    },
    {
      "id": 87,
      "start": 11063.58,
      "end": 11064.86,
      "formatted_start": "03:04:23.580",
      "formatted_end": "03:04:24.860",
      "text": "ولی دیگه دار عذیب هم داره"
    },
    {
      "id": 88,
      "start": 11064.86,
      "end": 11067.74,
      "formatted_start": "03:04:24.860",
      "formatted_end": "03:04:27.740",
      "text": "از این احساس میگویم بگیر یکم 22 سال سابق داره دیگه"
    },
    {
      "id": 89,
      "start": 11069.74,
      "end": 11071.34,
      "formatted_start": "03:04:29.740",
      "formatted_end": "03:04:31.340",
      "text": "بگیر یکم بغل مارفت"
    },
    {
      "id": 90,
      "start": 11071.34,
      "end": 11074.22,
      "formatted_start": "03:04:31.340",
      "formatted_end": "03:04:34.220",
      "text": "اینجا بغل شما هایی که بیشتر کار کنند بیشتر هم"
    },
    {
      "id": 91,
      "start": 11074.94,
      "end": 11080.7,
      "formatted_start": "03:04:34.940",
      "formatted_end": "03:04:40.700",
      "text": "زیر سوال میره و بعد کارش در وسیع مغد ظالمانه میشه"
    },
    {
      "id": 92,
      "start": 11081.74,
      "end": 11084.94,
      "formatted_start": "03:04:41.740",
      "formatted_end": "03:04:44.940",
      "text": "واقعا باید کسی که معایب رو بیشتر پیدا می کنه"
    },
    {
      "id": 93,
      "start": 11084.94,
      "end": 11097.94,
      "formatted_start": "03:04:44.940",
      "formatted_end": "03:04:57.940",
      "text": "این دقت برستی داشته، قضاوت های پیش از تحقیق نداشته، اون قضاوت های پیش از تحقیق ویاست میگه دخالت میکنه، کار رو در انتهاک کلن خراب می کنه."
    },
    {
      "id": 94,
      "start": 11097.94,
      "end": 11099.94,
      "formatted_start": "03:04:57.940",
      "formatted_end": "03:04:59.940",
      "text": "دست اینو باید برداشت کنید."
    }
  ],
  "status": "completed"
}