  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10803.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:03.000",
      "text": "این اونکه پشتشتی اصلا ماهه، همه دوستش دارن."
    },
    {
      "id": 1,
      "start": 10803.0,
      "end": 10807.0,
      "formatted_start": "03:00:03.000",
      "formatted_end": "03:00:07.000",
      "text": "خب، برادر آزما ما هم پشتشتی دو ترین میزن."
    },
    {
      "id": 2,
      "start": 10807.0,
      "end": 10812.0,
      "formatted_start": "03:00:07.000",
      "formatted_end": "03:00:12.000",
      "text": "درسته، کترون. سر شار، سرها، شانا، دخترت هم معفق بشه."
    },
    {
      "id": 3,
      "start": 10812.0,
      "end": 10813.0,
      "formatted_start": "03:00:12.000",
      "formatted_end": "03:00:13.000",
      "text": "پشتشتی هدا؟"
    },
    {
      "id": 4,
      "start": 10813.0,
      "end": 10814.0,
      "formatted_start": "03:00:13.000",
      "formatted_end": "03:00:14.000",
      "text": "تجربه دو ترین."
    },
    {
      "id": 5,
      "start": 10814.0,
      "end": 10819.0,
      "formatted_start": "03:00:14.000",
      "formatted_end": "03:00:19.000",
      "text": "انشالله، پشتشتی که دوست داره بره، همه شان میگن پشتشتی بریم."
    },
    {
      "id": 6,
      "start": 10819.0,
      "end": 10823.0,
      "formatted_start": "03:00:19.000",
      "formatted_end": "03:00:23.000",
      "text": "نه من دو ترینمش باید روی درمتون بگیرم. خیلی خدا تراحت کن."
    },
    {
      "id": 7,
      "start": 10823.0,
      "end": 10825.0,
      "formatted_start": "03:00:23.000",
      "formatted_end": "03:00:25.000",
      "text": "ساعده بین"
    },
    {
      "id": 8,
      "start": 10825.0,
      "end": 10827.0,
      "formatted_start": "03:00:25.000",
      "formatted_end": "03:00:27.000",
      "text": "تلایف"
    },
    {
      "id": 9,
      "start": 10827.0,
      "end": 10829.0,
      "formatted_start": "03:00:27.000",
      "formatted_end": "03:00:29.000",
      "text": "زندگیش میرسه، بچه هاش میرسه"
    },
    {
      "id": 10,
      "start": 10833.0,
      "end": 10835.0,
      "formatted_start": "03:00:33.000",
      "formatted_end": "03:00:35.000",
      "text": "یازده یه پشار چه نشون؟"
    },
    {
      "id": 11,
      "start": 10835.0,
      "end": 10837.0,
      "formatted_start": "03:00:35.000",
      "formatted_end": "03:00:37.000",
      "text": "یازده رو چند دوز؟"
    },
    {
      "id": 12,
      "start": 10837.0,
      "end": 10839.0,
      "formatted_start": "03:00:37.000",
      "formatted_end": "03:00:39.000",
      "text": "یازده رو هفته"
    },
    {
      "id": 13,
      "start": 10839.0,
      "end": 10841.0,
      "formatted_start": "03:00:39.000",
      "formatted_end": "03:00:41.000",
      "text": "اصلا پشار مشکل نداره"
    },
    {
      "id": 14,
      "start": 10841.0,
      "end": 10843.0,
      "formatted_start": "03:00:41.000",
      "formatted_end": "03:00:43.000",
      "text": "الان اعتماد در"
    },
    {
      "id": 15,
      "start": 10843.0,
      "end": 10845.0,
      "formatted_start": "03:00:43.000",
      "formatted_end": "03:00:45.000",
      "text": "من هر هفته دارم"
    },
    {
      "id": 16,
      "start": 10845.0,
      "end": 10847.0,
      "formatted_start": "03:00:45.000",
      "formatted_end": "03:00:47.000",
      "text": "همگارون گفتن پشار رو میگفت"
    },
    {
      "id": 17,
      "start": 10847.0,
      "end": 10849.0,
      "formatted_start": "03:00:47.000",
      "formatted_end": "03:00:49.000",
      "text": "سیزه رو دهی گفتن من سابقه"
    },
    {
      "id": 18,
      "start": 10849.0,
      "end": 10851.0,
      "formatted_start": "03:00:49.000",
      "formatted_end": "03:00:51.000",
      "text": "پشار ندارم"
    },
    {
      "id": 19,
      "start": 10851.0,
      "end": 10881.0,
      "formatted_start": "03:00:51.000",
      "formatted_end": "03:01:21.000",
      "text": "برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینکه برای اینک"
    },
    {
      "id": 20,
      "start": 10881.0,
      "end": 10883.0,
      "formatted_start": "03:01:21.000",
      "formatted_end": "03:01:23.000",
      "text": "از اینجوریه"
    },
    {
      "id": 21,
      "start": 10883.0,
      "end": 10885.0,
      "formatted_start": "03:01:23.000",
      "formatted_end": "03:01:25.000",
      "text": "سر عبدالله"
    },
    {
      "id": 22,
      "start": 10885.0,
      "end": 10887.0,
      "formatted_start": "03:01:25.000",
      "formatted_end": "03:01:27.000",
      "text": "صرف کارم است"
    },
    {
      "id": 23,
      "start": 10887.0,
      "end": 10889.0,
      "formatted_start": "03:01:27.000",
      "formatted_end": "03:01:29.000",
      "text": "از اینجوریه"
    },
    {
      "id": 24,
      "start": 10889.0,
      "end": 10891.0,
      "formatted_start": "03:01:29.000",
      "formatted_end": "03:01:31.000",
