      "end": 1734.0,
      "formatted_start": "00:28:52.000",
      "formatted_end": "00:28:54.000",
      "text": "چون پدر امیدوارد خواستند سیپ فدجه محضوظه"
    },
    {
      "id": 26,
      "start": 1734.0,
      "end": 1736.0,
      "formatted_start": "00:28:54.000",
      "formatted_end": "00:28:56.000",
      "text": "بله دکتور جان"
    },
    {
      "id": 27,
      "start": 1736.0,
      "end": 1738.0,
      "formatted_start": "00:28:56.000",
      "formatted_end": "00:28:58.000",
      "text": "بله چند هم آب میخوره"
    },
    {
      "id": 28,
      "start": 1738.0,
      "end": 1740.0,
      "formatted_start": "00:28:58.000",
      "formatted_end": "00:29:00.000",
      "text": "غذا میخوره"
    },
    {
      "id": 29,
      "start": 1740.0,
      "end": 1742.0,
      "formatted_start": "00:29:00.000",
      "formatted_end": "00:29:02.000",
      "text": "یک مقدار تابستان که میشه کم آب میشه بدنش"
    },
    {
      "id": 30,
      "start": 1742.0,
      "end": 1744.0,
      "formatted_start": "00:29:02.000",
      "formatted_end": "00:29:04.000",
      "text": "خواستم از اینجا"
    },
    {
      "id": 31,
      "start": 1744.0,
      "end": 1746.0,
      "formatted_start": "00:29:04.000",
      "formatted_end": "00:29:06.000",
      "text": "یک نظر بخواهیم امکانش هست"
    },
    {
      "id": 32,
      "start": 1746.0,
      "end": 1748.0,
      "formatted_start": "00:29:06.000",
      "formatted_end": "00:29:08.000",
      "text": "ما سه روان هر که را بودیم تو خونه"
    },
    {
      "id": 33,
      "start": 1748.0,
      "end": 1750.0,
      "formatted_start": "00:29:08.000",
      "formatted_end": "00:29:10.000",
      "text": "نتونستم دقیقا در این اجتماعی میبریم"
    },
    {
      "id": 34,
      "start": 1750.0,
      "end": 1752.0,
      "formatted_start": "00:29:10.000",
      "formatted_end": "00:29:12.000",
      "text": "اونجا راحته"
    },
    {
      "id": 35,
      "start": 1752.0,
      "end": 1754.0,
      "formatted_start": "00:29:12.000",
      "formatted_end": "00:29:14.000",
      "text": "بعد از بیرونم میبریم دکتور فکر نمیزن"
    },
    {
      "id": 36,
      "start": 1754.0,
      "end": 1756.0,
      "formatted_start": "00:29:14.000",
      "formatted_end": "00:29:16.000",
      "text": "میزنون برامون"
    },
    {
      "id": 37,
      "start": 1756.0,
      "end": 1758.0,
      "formatted_start": "00:29:16.000",
      "formatted_end": "00:29:18.000",
      "text": "توی چند بیمارستان درخواهیم قبول نگرم"
    },
    {
      "id": 38,
      "start": 1758.0,
      "end": 1760.0,
      "formatted_start": "00:29:18.000",
      "formatted_end": "00:29:20.000",
      "text": "توی بیمارستان یا سرون ببریم بهتون"
    },
    {
      "id": 39,
      "start": 1760.0,
      "end": 1762.0,
      "formatted_start": "00:29:20.000",
      "formatted_end": "00:29:22.000",
      "text": "آره ما از اینجا شما زمان بکشید"
    },
    {
      "id": 40,
      "start": 1762.0,
      "end": 1764.0,
      "formatted_start": "00:29:22.000",
      "formatted_end": "00:29:24.000",
      "text": "نیازن هست دابور داخلش"
    },
    {
      "id": 41,
      "start": 1764.0,
      "end": 1766.0,
      "formatted_start": "00:29:24.000",
      "formatted_end": "00:29:26.000",
      "text": "تزریغ بشه"
    },
    {
      "id": 42,
      "start": 1766.0,
      "end": 1768.0,
      "formatted_start": "00:29:26.000",
      "formatted_end": "00:29:28.000",
      "text": "شما"
    },
    {
      "id": 43,
      "start": 1772.0,
      "end": 1774.0,
      "formatted_start": "00:29:32.000",
      "formatted_end": "00:29:34.000",
      "text": "سرون دو جور ورس میشه"
    },
    {
      "id": 44,
      "start": 1774.0,
      "end": 1776.0,
      "formatted_start": "00:29:34.000",
      "formatted_end": "00:29:36.000",
      "text": "یکی با سرسوزن های کوچک ورس میشه"
    },
    {
      "id": 45,
      "start": 1776.0,
      "end": 1778.0,
      "formatted_start": "00:29:36.000",
      "formatted_end": "00:29:38.000",
      "text": "پروانهی که"
    },
    {
      "id": 46,
      "start": 1778.0,
      "end": 1780.0,
      "formatted_start": "00:29:38.000",
      "formatted_end": "00:29:40.000",
      "text": "بیمارستان ها تمنیش نباید اینها انجام نبیده"
    },
    {
      "id": 47,
      "start": 1780.0,
      "end": 1782.0,
      "formatted_start": "00:29:40.000",
      "formatted_end": "00:29:42.000",
      "text": "متقا انجام بیده"
    },
    {
      "id": 48,
      "start": 1782.0,
      "end": 1784.0,
      "formatted_start": "00:29:42.000",
      "formatted_end": "00:29:44.000",
      "text": "یکی با آنجیوکت هست"
    },
    {
      "id": 49,
      "start": 1784.0,
      "end": 1786.0,
      "formatted_start": "00:29:44.000",
      "formatted_end": "00:29:46.000",
      "text": "درست"
    },
    {
      "id": 50,
      "start": 1786.0,
      "end": 1790.0,
      "formatted_start": "00:29:46.000",
      "formatted_end": "00:29:50.000",
      "text": "شما کدوم بیمارستان راحت بیتونین رنگشون برده؟"
    },
    {
      "id": 51,
      "start": 1790.0,
      "end": 1796.0,
      "formatted_start": "00:29:50.000",
      "formatted_end": "00:29:56.000",
      "text": "امیشم های خیلی برده بیمارستان های بیمارستان پست مصروم ها بیتونین؟"
    },
    {
      "id": 52,
      "start": 1796.0,
      "end": 1798.0,
      "formatted_start": "00:29:56.000",
      "formatted_end": "00:29:58.000",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 1798.0,
      "end": 1800.0,
      "formatted_start": "00:29:58.000",
      "formatted_end": "00:30:00.000",
