  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5404.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:04.000",
      "text": "اینکه این پود کم رنگ شده، من این دوتایی که جدید پود، تمرن نشده."
    },
    {
      "id": 1,
      "start": 5404.0,
      "end": 5408.0,
      "formatted_start": "01:30:04.000",
      "formatted_end": "01:30:08.000",
      "text": "قبوله؟ شما چجوری میتونین اونو بیارین بقل اینکه حافظه؟"
    },
    {
      "id": 2,
      "start": 5408.0,
      "end": 5416.0,
      "formatted_start": "01:30:08.000",
      "formatted_end": "01:30:16.000",
      "text": "نمیشه که این حافظه غذاوتش خیلی خیلی ضعیقه در همه انسان ها."
    },
    {
      "id": 3,
      "start": 5416.0,
      "end": 5422.0,
      "formatted_start": "01:30:16.000",
      "formatted_end": "01:30:22.000",
      "text": "باعث مدرک، عکس بگیری، امروز عکس بگیری، 21 روز دیگه دوباره میاری، عکس بگیری."
    },
    {
      "id": 4,
      "start": 5422.0,
      "end": 5425.0,
      "formatted_start": "01:30:22.000",
      "formatted_end": "01:30:25.000",
      "text": "خب، اون دفعه دو هفته بگفت، این دفعه سخته."
    },
    {
      "id": 5,
      "start": 5425.0,
      "end": 5428.1,
      "formatted_start": "01:30:25.000",
      "formatted_end": "01:30:28.100",
      "text": "بعد امروز عکس میگی دارو رو شروع می کنی"
    },
    {
      "id": 6,
      "start": 5428.1,
      "end": 5429.0,
      "formatted_start": "01:30:28.100",
      "formatted_end": "01:30:29.000",
      "text": "خب"
    },
    {
      "id": 7,
      "start": 5429.0,
      "end": 5432.3,
      "formatted_start": "01:30:29.000",
      "formatted_end": "01:30:32.300",
      "text": "سه هفته دیگه این عکس رو با اون سه هفته دیگه مقایسه می کنی"
    },
    {
      "id": 8,
      "start": 5432.3,
      "end": 5433.5,
      "formatted_start": "01:30:32.300",
      "formatted_end": "01:30:33.500",
      "text": "میگی چیجور تأثیر نکرد؟"
    },
    {
      "id": 9,
      "start": 5433.5,
      "end": 5436.5,
      "formatted_start": "01:30:33.500",
      "formatted_end": "01:30:36.500",
      "text": "تأثیر نکرد و آجان اول می دهد و دیگرش اشاره میکشه"
    },
    {
      "id": 10,
      "start": 5436.5,
      "end": 5437.5,
      "formatted_start": "01:30:36.500",
      "formatted_end": "01:30:37.500",
      "text": "خواهی نداری؟"
    },
    {
      "id": 11,
      "start": 5437.5,
      "end": 5438.5,
      "formatted_start": "01:30:37.500",
      "formatted_end": "01:30:38.500",
      "text": "ها؟"
    },
    {
      "id": 12,
      "start": 5438.5,
      "end": 5440.5,
      "formatted_start": "01:30:38.500",
      "formatted_end": "01:30:40.500",
      "text": "اصلا اون عکس رو چرا نگرد؟"
    },
    {
      "id": 13,
      "start": 5440.5,
      "end": 5442.5,
      "formatted_start": "01:30:40.500",
      "formatted_end": "01:30:42.500",
      "text": "می گفت اما عکس بگیر تا به فهمی که چه"
    },
    {
      "id": 14,
      "start": 5442.5,
      "end": 5444.5,
      "formatted_start": "01:30:42.500",
      "formatted_end": "01:30:44.500",
      "text": "چون خانم ها میرن پیش بهتری دکتوری باید بگیر میگن"
    },
    {
      "id": 15,
      "start": 5444.5,
      "end": 5450.5,
      "formatted_start": "01:30:44.500",
      "formatted_end": "01:30:50.500",
      "text": "دیده دیدیم خانموی رو رفت کنیم؟ چون عکس نمیدونیم. عکس نگه نیچون"
    },
    {
      "id": 16,
      "start": 5450.5,
      "end": 5452.5,
      "formatted_start": "01:30:50.500",
      "formatted_end": "01:30:52.500",
      "text": "همون دیدر بقیه که شیعه هم هست"
    },
    {
      "id": 17,
      "start": 5452.5,
      "end": 5456.5,
      "formatted_start": "01:30:52.500",
      "formatted_end": "01:30:56.500",
      "text": "دیدر بقیه هم اسمش نایگرا هستش، یه رقاچه"
    },
    {
      "id": 18,
      "start": 5456.5,
      "end": 5460.5,
      "formatted_start": "01:30:56.500",
      "formatted_end": "01:31:00.500",
      "text": "که ایجاد هم بولی بد می کنه هم ایجاد تیرگی"
    },
    {
      "id": 19,
      "start": 5460.5,
      "end": 5465.5,
      "formatted_start": "01:31:00.500",
      "formatted_end": "01:31:05.500",
      "text": "توی کشاله هم همینو داره، لای باسن هم ایجاد داره تو چین های ودن"
    },
    {
      "id": 20,
      "start": 5465.5,
      "end": 5467.5,
      "formatted_start": "01:31:05.500",
      "formatted_end": "01:31:07.500",
      "text": "ممکنه ایجاد..."
    },
    {
      "id": 21,
      "start": 5467.5,
      "end": 5468.5,
      "formatted_start": "01:31:07.500",
      "formatted_end": "01:31:08.500",
      "text": "اون شکلی نیست"
    },
    {
      "id": 22,
      "start": 5468.5,
      "end": 5470.5,
      "formatted_start": "01:31:08.500",
      "formatted_end": "01:31:10.500",
      "text": "اون شکلی نیست، باز یه شکل دیگه هست، بله"
    },
    {
      "id": 23,
      "start": 5474.5,
      "end": 5480.5,
      "formatted_start": "01:31:14.500",
      "formatted_end": "01:31:20.500",
      "text": "که بیدن یک چیز هم اضافه تن بیدن که با یکی هم هم از این بزنه هم اضافه درسته"
    },
    {
      "id": 24,
      "start": 5480.5,
      "end": 5485.5,
      "formatted_start": "01:31:20.500",
      "formatted_end": "01:31:25.500",
      "text": "از اینکه رنگ دانه است در مانچون مشترکه از اینکه آمل آن رنگ دانه نیست"
    },
    {
      "id": 25,
      "start": 5485.5,
      "end": 5490.5,
      "formatted_start": "01:31:25.500",
      "formatted_end": "01:31:30.500",
      "text": "آمل آن قارچه یک داری زده قارچه اضافه درست شده"
    },
    {
      "id": 26,
      "start": 5490.5,
      "end": 5498.5,
      "formatted_start": "01:31:30.500",
      "formatted_end": "01:31:38.500",
      "text": "حالا بریم شوینده بایده"
    },
    {
      "id": 27,
      "start": 5498.5,
      "end": 5503.66,
      "formatted_start": "01:31:38.500",
      "formatted_end": "01:31:43.660",
      "text": "این اصلا مایکل جکسون سیاه گوست رو تبدیل به سفید گوست کردن"
    },
    {
      "id": 28,
      "start": 5503.66,
      "end": 5505.22,
      "formatted_start": "01:31:43.660",
      "formatted_end": "01:31:45.220",
      "text": "این که چیزی نیست"
    },
    {
      "id": 29,
      "start": 5505.22,
      "end": 5509.62,
      "formatted_start": "01:31:45.220",
      "formatted_end": "01:31:49.620",
      "text": "حتما مطمئن ماشه تمام رکه ها و سیاده ها سفید میشه"
    },
    {
      "id": 30,
      "start": 5509.62,
      "end": 5510.5,
      "formatted_start": "01:31:49.620",
      "formatted_end": "01:31:50.500",
      "text": "مطمئن ماشه"
    },
    {
      "id": 31,
      "start": 5510.5,
      "end": 5513.68,
      "formatted_start": "01:31:50.500",
      "formatted_end": "01:31:53.680",
      "text": "فقط اگه یه چیزی کم اثره عوض میتونی میشید دیگه"
    },
    {
      "id": 32,
      "start": 5513.68,
      "end": 5514.72,
      "formatted_start": "01:31:53.680",
      "formatted_end": "01:31:54.720",
      "text": "عوض میتونی میشید"
    },
    {
      "id": 33,
      "start": 5514.72,
      "end": 5516.4,
      "formatted_start": "01:31:54.720",
      "formatted_end": "01:31:56.400",
      "text": "وراخره راشده کنیم"
    },
    {
      "id": 34,
      "start": 5516.4,
      "end": 5518.18,
      "formatted_start": "01:31:56.400",
      "formatted_end": "01:31:58.180",
      "text": "ولی عکس نباشید شمایید"
    },
    {
      "id": 35,
      "start": 5518.18,
      "end": 5521.94,
      "formatted_start": "01:31:58.180",
      "formatted_end": "01:32:01.940",
      "text": "با قضاوت های مهمان ها اصلا نمیتونیم ما درمان بکنیم"
    },
    {
      "id": 36,
      "start": 5521.94,
      "end": 5522.98,
      "formatted_start": "01:32:01.940",
      "formatted_end": "01:32:02.980",
      "text": "خودشم خودشم"
    },
    {
      "id": 37,
      "start": 5522.98,
      "end": 5524.98,
      "formatted_start": "01:32:02.980",
      "formatted_end": "01:32:04.980",
      "text": "از آبت خودشن"
    },
    {
      "id": 38,
      "start": 5524.98,
      "end": 5526.98,
      "formatted_start": "01:32:04.980",
      "formatted_end": "01:32:06.980",
      "text": "آفرین"
    },
    {
      "id": 39,
      "start": 5526.98,
      "end": 5528.98,
      "formatted_start": "01:32:06.980",
      "formatted_end": "01:32:08.980",
      "text": "هیچ تغییر نخواهد کرد"
    },
    {
      "id": 40,
      "start": 5528.98,
      "end": 5530.98,
      "formatted_start": "01:32:08.980",
      "formatted_end": "01:32:10.980",
      "text": "خونه تو دربین نیست"
    },
    {
      "id": 41,
      "start": 5530.98,
      "end": 5532.98,
      "formatted_start": "01:32:10.980",
      "formatted_end": "01:32:12.980",
      "text": "عکس نگیری هیچ خواهد نداری"
    },
    {
      "id": 42,
      "start": 5532.98,
      "end": 5534.98,
      "formatted_start": "01:32:12.980",
      "formatted_end": "01:32:14.980",
      "text": "شوینده دیگه بایتنین"
    },
    {
      "id": 43,
      "start": 5534.98,
      "end": 5536.98,
      "formatted_start": "01:32:14.980",
      "formatted_end": "01:32:16.980",
      "text": "عکس هم شبا واضح در همه آزاد"
    },
    {
      "id": 44,
      "start": 5536.98,
      "end": 5538.98,
      "formatted_start": "01:32:16.980",
      "formatted_end": "01:32:18.980",
      "text": "با بدون فلش"
    },
    {
      "id": 45,
      "start": 5538.98,
      "end": 5540.98,
      "formatted_start": "01:32:18.980",
      "formatted_end": "01:32:20.980",
      "text": "خان با نور طبیعی"
    },
    {
      "id": 46,
      "start": 5540.98,
      "end": 5542.98,
      "formatted_start": "01:32:20.980",
      "formatted_end": "01:32:22.980",
      "text": "و با یک دربین خوب میگیری امروز"
    },
    {
      "id": 47,
      "start": 5542.98,
      "end": 5544.98,
      "formatted_start": "01:32:22.980",
      "formatted_end": "01:32:24.980",
      "text": "با وایده خوب بردگه میداری"
    },
    {
      "id": 48,
      "start": 5544.98,
      "end": 5546.98,
      "formatted_start": "01:32:24.980",
      "formatted_end": "01:32:26.980",
      "text": "سه هفته دیگه مخالجه"
    },
    {
      "id": 49,
      "start": 5546.98,
      "end": 5548.98,
      "formatted_start": "01:32:26.980",
      "formatted_end": "01:32:28.980",
      "text": "شوینده وایتنینگ بیوریچ"
    },
    {
      "id": 50,
      "start": 5548.98,
      "end": 5550.98,
      "formatted_start": "01:32:28.980",
      "formatted_end": "01:32:30.980",
      "text": "خشکه میزنی"
    },
    {
      "id": 51,
      "start": 5550.98,
      "end": 5552.98,
      "formatted_start": "01:32:30.980",
      "formatted_end": "01:32:32.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 52,
      "start": 5552.98,
      "end": 5554.98,
      "formatted_start": "01:32:32.980",
      "formatted_end": "01:32:34.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 53,
      "start": 5554.98,
      "end": 5556.98,
      "formatted_start": "01:32:34.980",
      "formatted_end": "01:32:36.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 54,
      "start": 5556.98,
      "end": 5558.98,
      "formatted_start": "01:32:36.980",
      "formatted_end": "01:32:38.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 55,
      "start": 5558.98,
      "end": 5560.98,
      "formatted_start": "01:32:38.980",
      "formatted_end": "01:32:40.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 56,
      "start": 5560.98,
      "end": 5562.98,
      "formatted_start": "01:32:40.980",
      "formatted_end": "01:32:42.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 57,
      "start": 5562.98,
      "end": 5564.98,
      "formatted_start": "01:32:42.980",
      "formatted_end": "01:32:44.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 58,
      "start": 5564.98,
      "end": 5566.98,
      "formatted_start": "01:32:44.980",
      "formatted_end": "01:32:46.980",
      "text": "این درسته در حالتی باید بردارید."
    },
    {
      "id": 59,
      "start": 5566.98,
      "end": 5568.98,
      "formatted_start": "01:32:46.980",
      "formatted_end": "01:32:48.980",
      "text": "اینجا شیخان فقط همون رکم رو داره"
    },
    {
      "id": 60,
      "start": 5568.98,
      "end": 5570.98,
      "formatted_start": "01:32:48.980",
      "formatted_end": "01:32:50.980",
      "text": "همون رکم رو دارم"
    },
    {
      "id": 61,
      "start": 5570.98,
      "end": 5571.98,
      "formatted_start": "01:32:50.980",
      "formatted_end": "01:32:51.980",
      "text": "رکم رو نیاز داریم"
    },
    {
      "id": 62,
      "start": 5571.98,
      "end": 5572.98,
      "formatted_start": "01:32:51.980",
      "formatted_end": "01:32:52.980",
      "text": "خواهید کلش سفید کنیم"
    },
    {
      "id": 63,
      "start": 5572.98,
      "end": 5573.98,
      "formatted_start": "01:32:52.980",
      "formatted_end": "01:32:53.980",
      "text": "کلش رو بزنیم"
    },
    {
      "id": 64,
      "start": 5573.98,
      "end": 5575.98,
      "formatted_start": "01:32:53.980",
      "formatted_end": "01:32:55.980",
      "text": "ولی الان زوبتر کلش رو سفید کنیم"
    },
    {
      "id": 65,
      "start": 5575.98,
      "end": 5577.98,
      "formatted_start": "01:32:55.980",
      "formatted_end": "01:32:57.980",
      "text": "میشه آن لکه تیره ترده ده میشه"
    },
    {
      "id": 66,
      "start": 5577.98,
      "end": 5579.98,
      "formatted_start": "01:32:57.980",
      "formatted_end": "01:32:59.980",
      "text": "به نظر خودتی"
    },
    {
      "id": 67,
      "start": 5579.98,
      "end": 5581.98,
      "formatted_start": "01:32:59.980",
      "formatted_end": "01:33:01.980",
      "text": "ولی درقصد کلش رو بزنیم"
    },
    {
      "id": 68,
      "start": 5581.98,
      "end": 5583.98,
      "formatted_start": "01:33:01.980",
      "formatted_end": "01:33:03.980",
      "text": "ولی یکی دوباره هم به کلش بزنیم"
    },
    {
      "id": 69,
      "start": 5583.98,
      "end": 5584.98,
      "formatted_start": "01:33:03.980",
      "formatted_end": "01:33:04.980",
      "text": "اصلا صورت تو باشه"
    },
    {
      "id": 70,
      "start": 5584.98,
      "end": 5586.98,
      "formatted_start": "01:33:04.980",
      "formatted_end": "01:33:06.980",
      "text": "اصلا صورتت خیلی سفیده"
    },
    {
      "id": 71,
      "start": 5586.98,
      "end": 5587.98,
      "formatted_start": "01:33:06.980",
      "formatted_end": "01:33:07.980",
      "text": "خواهید تیره شده"
    },
    {
      "id": 72,
      "start": 5587.98,
      "end": 5589.98,
      "formatted_start": "01:33:07.980",
      "formatted_end": "01:33:09.980",
      "text": "یک کمی، ذاتش سفیده"
    },
    {
      "id": 73,
      "start": 5589.98,
      "end": 5592.98,
      "formatted_start": "01:33:09.980",
      "formatted_end": "01:33:12.980",
      "text": "دو سه دفعه بزنی صورت سفیده"
    },
    {
      "id": 74,
      "start": 5592.98,
      "end": 5594.98,
      "formatted_start": "01:33:12.980",
      "formatted_end": "01:33:14.980",
      "text": "در موقع اتنام داره؟"
    },
    {
      "id": 75,
      "start": 5594.98,
      "end": 5596.98,
      "formatted_start": "01:33:14.980",
      "formatted_end": "01:33:16.980",
      "text": "نه، نه نه، مطمئن باشه"
    },
    {
      "id": 76,
      "start": 5596.98,
      "end": 5599.98,
      "formatted_start": "01:33:16.980",
      "formatted_end": "01:33:19.980",
      "text": "اصلا کارش همینه برای از بین بردن لکه های"
    },
    {
      "id": 77,
      "start": 5599.98,
      "end": 5603.98,
      "formatted_start": "01:33:19.980",
      "formatted_end": "01:33:23.980",
      "text": "قفتا، سختگی، خالقا، آرچا، هر جدیدی تیره بود"
    },
    {
      "id": 78,
      "start": 5603.98,
      "end": 5605.98,
      "formatted_start": "01:33:23.980",
      "formatted_end": "01:33:25.980",
      "text": "باید بگویید مثل وایتک سفید"
    },
    {
      "id": 79,
      "start": 5605.98,
      "end": 5609.98,
      "formatted_start": "01:33:25.980",
      "formatted_end": "01:33:29.980",
      "text": "آلمانیف، یا یه چیزی، یا کموتی داره رنگش مرد"
    },
    {
      "id": 80,
      "start": 5609.98,
      "end": 5611.98,
      "formatted_start": "01:33:29.980",
      "formatted_end": "01:33:31.980",
      "text": "این شوینده است"
    },
    {
      "id": 81,
      "start": 5611.98,
      "end": 5613.98,
      "formatted_start": "01:33:31.980",
      "formatted_end": "01:33:33.980",
      "text": "من میلالیفت داشتیم"
    },
    {
      "id": 82,
      "start": 5613.98,
      "end": 5616.98,
      "formatted_start": "01:33:33.980",
      "formatted_end": "01:33:36.980",
      "text": "چیز درمالیف داشتیم"
    },
    {
      "id": 83,
      "start": 5616.98,
      "end": 5618.98,
      "formatted_start": "01:33:36.980",
      "formatted_end": "01:33:38.980",
      "text": "الان دایش دیگه درسته؟"
    },
    {
      "id": 84,
      "start": 5618.98,
      "end": 5621.98,
      "formatted_start": "01:33:38.980",
      "formatted_end": "01:33:41.980",
      "text": "پس باید یک پیک مازون بردم بشیم"
    },
    {
      "id": 85,
      "start": 5621.98,
      "end": 5625.98,
      "formatted_start": "01:33:41.980",
      "formatted_end": "01:33:45.980",
      "text": "کرم پیک مازون"
    },
    {
      "id": 86,
      "start": 5625.98,
      "end": 5627.98,
      "formatted_start": "01:33:45.980",
      "formatted_end": "01:33:47.980",
      "text": "همون با همی سبید"
    },
    {
      "id": 87,
      "start": 5627.98,
      "end": 5630.98,
      "formatted_start": "01:33:47.980",
      "formatted_end": "01:33:50.980",
      "text": "کرم زبه با هرش"
    },
    {
      "id": 88,
      "start": 5630.98,
      "end": 5632.98,
      "formatted_start": "01:33:50.980",
      "formatted_end": "01:33:52.980",
      "text": "بردم بشه سه روشن بردم"
    },
    {
      "id": 89,
      "start": 5632.98,
      "end": 5634.98,
      "formatted_start": "01:33:52.980",
      "formatted_end": "01:33:54.980",
      "text": "سه روشن بردم بشیم"
    },
    {
      "id": 90,
      "start": 5634.98,
      "end": 5637.98,
      "formatted_start": "01:33:54.980",
      "formatted_end": "01:33:57.980",
      "text": "از اینجا بردم بشیم"
    },
    {
      "id": 91,
      "start": 5637.98,
      "end": 5640.98,
      "formatted_start": "01:33:57.980",
      "formatted_end": "01:34:00.980",
      "text": "از اینجا میترش درم بردم"
    },
    {
      "id": 92,
      "start": 5640.98,
      "end": 5660.98,
      "formatted_start": "01:34:00.980",
      "formatted_end": "01:34:20.980",
      "text": "موسیقی"
    },
    {
      "id": 93,
      "start": 5670.98,
      "end": 5688.98,
      "formatted_start": "01:34:30.980",
      "formatted_end": "01:34:48.980",
      "text": "موسیقی"
    },
    {
      "id": 94,
      "start": 5688.98,
      "end": 5693.98,
      "formatted_start": "01:34:48.980",
      "formatted_end": "01:34:53.980",
      "text": "یک خورسی داره به نام فلو فرانسور، یه روز میخوانی یه روز نمیکنی"
    },
    {
      "id": 95,
      "start": 5693.98,
      "end": 5699.98,
      "formatted_start": "01:34:53.980",
      "formatted_end": "01:34:59.980",
      "text": "برای بارچه زیاده قبل از تنظیمی در این حال"
    }
  ],
  "status": "completed"
}