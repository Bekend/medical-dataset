  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6329.98,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:29.980",
      "text": "برنامه بیمار، بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "این همانه که از اونو..."
    },
    {
      "id": 2,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "آره، بله، من نوشته بود که این دیگه..."
    },
    {
      "id": 3,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "بله، میفته، من چه؟"
    },
    {
      "id": 4,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "این دیگه خواهدکی بابا است"
    },
    {
      "id": 5,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "آره"
    },
    {
      "id": 6,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "خواهدکی"
    },
    {
      "id": 7,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "آره"
    },
    {
      "id": 8,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "بله"
    },
    {
      "id": 9,
      "start": 6350.0,
      "end": 6352.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:52.000",
      "text": "بله، بله"
    },
    {
      "id": 10,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "میشه خواهدکی بابا است"
    },
    {
      "id": 11,
      "start": 6354.0,
      "end": 6356.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:56.000",
      "text": "بله، در شما..."
    },
    {
      "id": 12,
      "start": 6356.0,
      "end": 6358.0,
      "formatted_start": "01:45:56.000",
      "formatted_end": "01:45:58.000",
      "text": "اینم حوض کنه با مولو بیاد"
    },
    {
      "id": 13,
      "start": 6358.0,
      "end": 6388.0,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:28.000",
      "text": "برانی بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار بیار"
    },
    {
      "id": 14,
      "start": 6388.0,
      "end": 6401.0,
      "formatted_start": "01:46:28.000",
      "formatted_end": "01:46:41.000",
      "text": "متوسط قلدتون متوست 114 از 14 فرصت هست"
    },
    {
      "id": 15,
      "start": 6401.0,
      "end": 6402.0,
      "formatted_start": "01:46:41.000",
      "formatted_end": "01:46:42.000",
      "text": "شیر میخوریم؟"
    },
    {
      "id": 16,
      "start": 6402.0,
      "end": 6403.0,
      "formatted_start": "01:46:42.000",
      "formatted_end": "01:46:43.000",
      "text": "نه"
    },
    {
      "id": 17,
      "start": 6403.0,
      "end": 6405.0,
      "formatted_start": "01:46:43.000",
      "formatted_end": "01:46:45.000",
      "text": "نه باید بخوریم"
    },
    {
      "id": 18,
      "start": 6405.0,
      "end": 6407.0,
      "formatted_start": "01:46:45.000",
      "formatted_end": "01:46:47.000",
      "text": "نه، سه تا سه قلد شیر"
    },
    {
      "id": 19,
      "start": 6407.0,
      "end": 6411.0,
      "formatted_start": "01:46:47.000",
      "formatted_end": "01:46:51.000",
      "text": "که از صیابتون کمه قلدتون زیاده"
    },
    {
      "id": 20,
      "start": 6418.0,
      "end": 6424.0,
      "formatted_start": "01:46:58.000",
      "formatted_end": "01:47:04.000",
      "text": "یا سر پردرمان"
    },
    {
      "id": 21,
      "start": 6424.0,
      "end": 6426.0,
      "formatted_start": "01:47:04.000",
      "formatted_end": "01:47:06.000",
      "text": "یا سر پردرمان"
    },
    {
      "id": 22,
      "start": 6426.0,
      "end": 6428.0,
      "formatted_start": "01:47:06.000",
      "formatted_end": "01:47:08.000",
      "text": "یا سر پردرمان"
    },
    {
      "id": 23,
      "start": 6428.0,
      "end": 6430.0,
      "formatted_start": "01:47:08.000",
      "formatted_end": "01:47:10.000",
      "text": "یا سر پردرمان"
    },
    {
      "id": 24,
      "start": 6430.0,
      "end": 6432.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:12.000",
      "text": "تیروید کمکاره"
    },
    {
      "id": 25,
      "start": 6432.0,
      "end": 6434.0,
      "formatted_start": "01:47:12.000",
      "formatted_end": "01:47:14.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 26,
      "start": 6434.0,
      "end": 6436.0,
      "formatted_start": "01:47:14.000",
      "formatted_end": "01:47:16.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 27,
      "start": 6436.0,
      "end": 6438.0,
      "formatted_start": "01:47:16.000",
      "formatted_end": "01:47:18.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 28,
      "start": 6438.0,
      "end": 6440.0,
      "formatted_start": "01:47:18.000",
      "formatted_end": "01:47:20.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 29,
      "start": 6440.0,
      "end": 6442.0,
      "formatted_start": "01:47:20.000",
      "formatted_end": "01:47:22.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 30,
      "start": 6442.0,
      "end": 6444.0,
      "formatted_start": "01:47:22.000",
      "formatted_end": "01:47:24.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 31,
      "start": 6444.0,
      "end": 6446.0,
      "formatted_start": "01:47:24.000",
      "formatted_end": "01:47:26.000",
      "text": "میتامیده کمی هست"
    },
    {
      "id": 32,
      "start": 6446.0,
      "end": 6452.0,
      "formatted_start": "01:47:26.000",
      "formatted_end": "01:47:32.000",
      "text": "من اینجا از همه وقتی که اومدم پیش شما، اونجا نخورده بودم پایین"
    },
    {
      "id": 33,
      "start": 6452.0,
      "end": 6454.0,
      "formatted_start": "01:47:32.000",
      "formatted_end": "01:47:34.000",
      "text": "من بودم نخورده بودم؟"
    },
    {
      "id": 34,
      "start": 6454.0,
      "end": 6458.0,
      "formatted_start": "01:47:34.000",
      "formatted_end": "01:47:38.000",
      "text": "نه، تو نخورده بودم نخورده بودم که دیگه آزمایش بدم ببینم چجوری بوده"
    },
    {
      "id": 35,
      "start": 6458.0,
      "end": 6465.0,
      "formatted_start": "01:47:38.000",
      "formatted_end": "01:47:45.000",
      "text": "تو بکی بخوردید، کبتتونم چرب شده، شما نوعی ساختار بدنیتون چاق شده و نسبه"
    },
    {
      "id": 36,
      "start": 6465.0,
      "end": 6472.0,
      "formatted_start": "01:47:45.000",
      "formatted_end": "01:47:52.000",
      "text": "از این باشه مواد قندی، چاق میخونه، چربی کبت میگیرید که داریم"
    },
    {
      "id": 37,
      "start": 6472.0,
      "end": 6481.0,
      "formatted_start": "01:47:52.000",
      "formatted_end": "01:48:01.000",
      "text": "چربی خونه تو نسبت دقیقه قبلی که آزماش دادید کمی تر شده ولی برسید"
    },
    {
      "id": 38,
      "start": 6481.0,
      "end": 6483.0,
      "formatted_start": "01:48:01.000",
      "formatted_end": "01:48:03.000",
      "text": "رحمت داری؟"
    },
    {
      "id": 39,
      "start": 6483.0,
      "end": 6485.0,
      "formatted_start": "01:48:03.000",
      "formatted_end": "01:48:05.000",
      "text": "جا"
    },
    {
      "id": 40,
      "start": 6485.0,
      "end": 6487.0,
      "formatted_start": "01:48:05.000",
      "formatted_end": "01:48:07.000",
      "text": "صنعت زنونم داری؟"
    },
    {
      "id": 41,
      "start": 6487.0,
      "end": 6492.0,
      "formatted_start": "01:48:07.000",
      "formatted_end": "01:48:12.000",
      "text": "او صنعت اونم یک ماه پیش آرائی اوماری نه انجام دارم"
    },
    {
      "id": 42,
      "start": 6492.0,
      "end": 6497.0,
      "formatted_start": "01:48:12.000",
      "formatted_end": "01:48:17.000",
      "text": "و بعد که خواهد دارو اصاف کردم دوباره ماهرم دوباره نمیدونم"
    },
    {
      "id": 43,
      "start": 6497.0,
      "end": 6499.0,
      "formatted_start": "01:48:17.000",
      "formatted_end": "01:48:19.000",
      "text": "برگون اقساسی براش می مشتم"
    },
    {
      "id": 44,
      "start": 6499.0,
      "end": 6501.0,
      "formatted_start": "01:48:19.000",
      "formatted_end": "01:48:21.000",
      "text": "زخامت رهنم 11"
    },
    {
      "id": 45,
      "start": 6501.0,
      "end": 6503.0,
      "formatted_start": "01:48:21.000",
      "formatted_end": "01:48:23.000",
      "text": "باز کنو زیاد کن شدید میشه یادم"
    },
    {
      "id": 46,
      "start": 6503.0,
      "end": 6505.0,
      "formatted_start": "01:48:23.000",
      "formatted_end": "01:48:25.000",
      "text": "نه نه"
    },
    {
      "id": 47,
      "start": 6505.0,
      "end": 6507.0,
      "formatted_start": "01:48:25.000",
      "formatted_end": "01:48:27.000",
      "text": "خوبه؟ آره"
    },
    {
      "id": 48,
      "start": 6507.0,
      "end": 6509.0,
      "formatted_start": "01:48:27.000",
      "formatted_end": "01:48:29.000",
      "text": "بعد آهم می کنیم"
    },
    {
      "id": 49,
      "start": 6509.0,
      "end": 6511.0,
      "formatted_start": "01:48:29.000",
      "formatted_end": "01:48:31.000",
      "text": "اینجا"
    },
    {
      "id": 50,
      "start": 6511.0,
      "end": 6513.0,
      "formatted_start": "01:48:31.000",
      "formatted_end": "01:48:33.000",
      "text": "برم میدم به شما آیران فرکس"
    },
    {
      "id": 51,
      "start": 6513.0,
      "end": 6515.0,
      "formatted_start": "01:48:33.000",
      "formatted_end": "01:48:35.000",
      "text": "60 درست"
    },
    {
      "id": 52,
      "start": 6515.0,
      "end": 6517.0,
      "formatted_start": "01:48:35.000",
      "formatted_end": "01:48:37.000",
      "text": "باز برم میشه مشته باشیم در اینکه"
    },
    {
      "id": 53,
      "start": 6517.0,
      "end": 6519.0,
      "formatted_start": "01:48:37.000",
      "formatted_end": "01:48:39.000",
      "text": "این سوا بود؟"
    },
    {
      "id": 54,
      "start": 6519.0,
      "end": 6521.0,
      "formatted_start": "01:48:39.000",
      "formatted_end": "01:48:41.000",
      "text": "این مریض نسیم بود من خودم"
    },
    {
      "id": 55,
      "start": 6521.0,
      "end": 6523.0,
      "formatted_start": "01:48:41.000",
      "formatted_end": "01:48:43.000",
      "text": "دخترم سواست"
    },
    {
      "id": 56,
      "start": 6523.0,
      "end": 6525.0,
      "formatted_start": "01:48:43.000",
      "formatted_end": "01:48:45.000",
      "text": "مثلا برعکس نمیشتم"
    },
    {
      "id": 57,
      "start": 6525.0,
      "end": 6531.0,
      "formatted_start": "01:48:45.000",
      "formatted_end": "01:48:51.000",
      "text": "شما نستین نستین من به اشتباه نمیشتم"
    },
    {
      "id": 58,
      "start": 6531.0,
      "end": 6533.0,
      "formatted_start": "01:48:51.000",
      "formatted_end": "01:48:53.000",
      "text": "چی کنیم بیا برعکس بشیم"
    },
    {
      "id": 59,
      "start": 6533.0,
      "end": 6535.0,
      "formatted_start": "01:48:53.000",
      "formatted_end": "01:48:55.000",
      "text": "بشیم در اینجور درخواه رو خودم میدونم که"
    },
    {
      "id": 60,
      "start": 6535.0,
      "end": 6540.0,
      "formatted_start": "01:48:55.000",
      "formatted_end": "01:49:00.000",
      "text": "میدونم بگم درست کنید دقیقه بعد میایید باز چون این باید ادامه درمان داشته باشه"
    },
    {
      "id": 61,
      "start": 6540.0,
      "end": 6542.0,
      "formatted_start": "01:49:00.000",
      "formatted_end": "01:49:02.000",
      "text": "میگم برای ممشی درست خواهد برم"
    },
    {
      "id": 62,
      "start": 6542.0,
      "end": 6546.0,
      "formatted_start": "01:49:02.000",
      "formatted_end": "01:49:06.000",
      "text": "خانم بارانی بیا اینجور"
    },
    {
      "id": 63,
      "start": 6546.0,
      "end": 6548.0,
      "formatted_start": "01:49:06.000",
      "formatted_end": "01:49:08.000",
      "text": "بید بشین"
    },
    {
      "id": 64,
      "start": 6548.0,
      "end": 6551.0,
      "formatted_start": "01:49:08.000",
      "formatted_end": "01:49:11.000",
      "text": "من این رو تقریبا من به اشتباه نمیشتم"
    },
    {
      "id": 65,
      "start": 6551.0,
      "end": 6554.0,
      "formatted_start": "01:49:11.000",
      "formatted_end": "01:49:14.000",
      "text": "همیشه هم اشتباه نمیشتم دستایی برای اون رو"
    },
    {
      "id": 66,
      "start": 6554.0,
      "end": 6558.0,
      "formatted_start": "01:49:14.000",
      "formatted_end": "01:49:18.000",
      "text": "این ها رو اینجا بریمیست؟"
    },
    {
      "id": 67,
      "start": 6558.0,
      "end": 6562.0,
      "formatted_start": "01:49:18.000",
      "formatted_end": "01:49:22.000",
      "text": "در کرا رو باز این ها رو اینجا بریمیست"
    },
    {
      "id": 68,
      "start": 6562.0,
      "end": 6566.0,
      "formatted_start": "01:49:22.000",
      "formatted_end": "01:49:26.000",
      "text": "این رو رکیزم"
    },
    {
      "id": 69,
      "start": 6566.0,
      "end": 6570.0,
      "formatted_start": "01:49:26.000",
      "formatted_end": "01:49:30.000",
      "text": "به تن مختلف؟"
    },
    {
      "id": 70,
      "start": 6570.0,
      "end": 6574.0,
      "formatted_start": "01:49:30.000",
      "formatted_end": "01:49:34.000",
      "text": "توی من، من دیگر هست"
    },
    {
      "id": 71,
      "start": 6574.0,
      "end": 6578.0,
      "formatted_start": "01:49:34.000",
      "formatted_end": "01:49:38.000",
      "text": "توش دیگر داره، نوشت میریزه، خواب حالود"
    },
    {
      "id": 72,
      "start": 6578.0,
      "end": 6582.0,
      "formatted_start": "01:49:38.000",
      "formatted_end": "01:49:42.000",
      "text": "صبح دیر میداره، میشه شبابت اخلاقی میکنه، این ها توی منی کرای دارن"
    },
    {
      "id": 73,
      "start": 6582.0,
      "end": 6585.0,
      "formatted_start": "01:49:42.000",
      "formatted_end": "01:49:45.000",
      "text": "نمیشه بهش کمک نمی کنه تو کاروی کنه"
    },
    {
      "id": 74,
      "start": 6585.0,
      "end": 6587.0,
      "formatted_start": "01:49:45.000",
      "formatted_end": "01:49:47.000",
      "text": "اصلا دستش نمیشه"
    },
    {
      "id": 75,
      "start": 6587.0,
      "end": 6589.0,
      "formatted_start": "01:49:47.000",
      "formatted_end": "01:49:49.000",
      "text": "دستش هم نمیشه"
    },
    {
      "id": 76,
      "start": 6589.0,
      "end": 6592.0,
      "formatted_start": "01:49:49.000",
      "formatted_end": "01:49:52.000",
      "text": "نه این باره تو خوبه"
    },
    {
      "id": 77,
      "start": 6592.0,
      "end": 6595.0,
      "formatted_start": "01:49:52.000",
      "formatted_end": "01:49:55.000",
      "text": "با داروش رو که از آن دخترهایی نیستش که کاروی کنه"
    },
    {
      "id": 78,
      "start": 6595.0,
      "end": 6598.0,
      "formatted_start": "01:49:55.000",
      "formatted_end": "01:49:58.000",
      "text": "صحبت اینکه هنی پیدیویتیش دیگه"
    },
    {
      "id": 79,
      "start": 6598.0,
      "end": 6600.0,
      "formatted_start": "01:49:58.000",
      "formatted_end": "01:50:00.000",
      "text": "پیدیویتیش از زمانی که"
    }
  ],
  "status": "completed"
}