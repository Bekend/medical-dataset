    {
      "id": 128,
      "start": 7492.32,
      "end": 7495.06,
      "formatted_start": "02:04:52.320",
      "formatted_end": "02:04:55.060",
      "text": "بره از این کشید"
    },
    {
      "id": 129,
      "start": 7495.06,
      "end": 7496.18,
      "formatted_start": "02:04:55.060",
      "formatted_end": "02:04:56.180",
      "text": "خانم اومدم"
    },
    {
      "id": 130,
      "start": 7496.18,
      "end": 7498.1,
      "formatted_start": "02:04:56.180",
      "formatted_end": "02:04:58.100",
      "text": "آقای عجم میخواد به ساعت چند بیاد"
    }
