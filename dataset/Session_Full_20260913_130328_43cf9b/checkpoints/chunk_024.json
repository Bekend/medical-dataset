      "text": "بهترین"
    },
    {
      "id": 81,
      "start": 7382.32,
      "end": 7386.32,
      "formatted_start": "02:03:02.320",
      "formatted_end": "02:03:06.320",
      "text": "یکی یکی یا دو دو"
    },
    {
      "id": 82,
      "start": 7386.32,
      "end": 7392.32,
      "formatted_start": "02:03:06.320",
      "formatted_end": "02:03:12.320",
      "text": "با اینکه این دو کدر هم مشکل نداره"
    },
    {
      "id": 83,
      "start": 7392.32,
      "end": 7394.32,
      "formatted_start": "02:03:12.320",
      "formatted_end": "02:03:14.320",
      "text": "کدر؟"
    },
    {
      "id": 84,
      "start": 7394.32,
      "end": 7396.32,
      "formatted_start": "02:03:14.320",
      "formatted_end": "02:03:16.320",
      "text": "کدر"
    },
    {
      "id": 85,
      "start": 7396.32,
      "end": 7398.32,
      "formatted_start": "02:03:16.320",
      "formatted_end": "02:03:18.320",
      "text": "کدر مشکل نداره"
    },
    {
      "id": 86,
      "start": 7398.32,
      "end": 7402.32,
      "formatted_start": "02:03:18.320",
      "formatted_end": "02:03:22.320",
      "text": "من اینجا باید آقای پجوهشگیر اتنامت میکردم"
    },
    {
      "id": 87,
      "start": 7402.32,
      "end": 7404.32,
      "formatted_start": "02:03:22.320",
      "formatted_end": "02:03:24.320",
      "text": "صد و سه"
    },
    {
      "id": 88,
      "start": 7404.32,
      "end": 7406.32,
      "formatted_start": "02:03:24.320",
      "formatted_end": "02:03:26.320",
      "text": "من از بالاتر برم"
    },
    {
      "id": 89,
      "start": 7406.32,
      "end": 7408.32,
      "formatted_start": "02:03:26.320",
      "formatted_end": "02:03:28.320",
      "text": "با؟"
    },
