      "id": 91,
      "start": 7410.32,
      "end": 7412.32,
      "formatted_start": "02:03:30.320",
      "formatted_end": "02:03:32.320",
      "text": "نواج فرق نمی کنه یکی هست"
    },
    {
      "id": 92,
      "start": 7412.32,
      "end": 7414.32,
      "formatted_start": "02:03:32.320",
      "formatted_end": "02:03:34.320",
      "text": "پراغروجی"
    },
    {
      "id": 93,
      "start": 7414.32,
      "end": 7418.32,
      "formatted_start": "02:03:34.320",
      "formatted_end": "02:03:38.320",
      "text": "شما بیتونی فقط با توت و خشک بخورید"
    },
    {
      "id": 94,
      "start": 7418.32,
      "end": 7420.32,
      "formatted_start": "02:03:38.320",
      "formatted_end": "02:03:40.320",
      "text": "چایی با توت و خشک"
    },
    {
      "id": 95,
      "start": 7420.32,
      "end": 7423.32,
      "formatted_start": "02:03:40.320",
      "formatted_end": "02:03:43.320",
      "text": "یا یک کشمه شیچیده کم وزنش"
    },
    {
      "id": 96,
      "start": 7423.32,
      "end": 7425.32,
      "formatted_start": "02:03:43.320",
      "formatted_end": "02:03:45.320",
      "text": "اگر نه از غند و شکر"
    },
    {
      "id": 97,
      "start": 7425.32,
      "end": 7427.32,
      "formatted_start": "02:03:45.320",
      "formatted_end": "02:03:47.320",
      "text": "یه داره غند و شکر"
    },
    {
      "id": 98,
      "start": 7427.32,
      "end": 7429.32,
      "formatted_start": "02:03:47.320",
      "formatted_end": "02:03:49.320",
      "text": "اصبت هست آفنامات وچه درستون هم با شکر"
    },
    {
      "id": 99,
      "start": 7429.32,
      "end": 7431.32,
      "formatted_start": "02:03:49.320",
      "formatted_end": "02:03:51.320",
      "text": "اون دیگه یکی هست"
    },
    {
      "id": 100,
      "start": 7431.32,
      "end": 7433.32,
      "formatted_start": "02:03:51.320",
      "formatted_end": "02:03:53.320",
      "text": "ارسال بوده ها"
    },
    {
      "id": 101,
      "start": 7433.32,
      "end": 7436.32,
      "formatted_start": "02:03:53.320",
      "formatted_end": "02:03:56.320",
      "text": "برای کردن هم آزمایش کجای دیگه نداره"
    },
    {
      "id": 102,
      "start": 7436.32,
      "end": 7438.32,
      "formatted_start": "02:03:56.320",
      "formatted_end": "02:03:58.320",
      "text": "همه چی میخواد"
    },
    {
      "id": 103,
      "start": 7438.32,
      "end": 7440.32,
      "formatted_start": "02:03:58.320",
      "formatted_end": "02:04:00.320",
      "text": "هم دارو داران برام نیست"
    },
