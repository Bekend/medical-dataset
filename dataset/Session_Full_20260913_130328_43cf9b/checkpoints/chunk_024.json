  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7205.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:05.000",
      "text": "این از آزمایشات و دکتر استفاده از همسطه باب همانه."
    },
    {
      "id": 1,
      "start": 7209.0,
      "end": 7211.0,
      "formatted_start": "02:00:09.000",
      "formatted_end": "02:00:11.000",
      "text": "خویرگیر کل رو هم خاموش کردی؟"
    },
    {
      "id": 2,
      "start": 7212.0,
      "end": 7216.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:16.000",
      "text": "این رو نوشتم برای ما انجام دادیم، شما تا به ویتامین دی کم بریم."
    },
    {
      "id": 3,
      "start": 7219.0,
      "end": 7220.0,
      "formatted_start": "02:00:19.000",
      "formatted_end": "02:00:20.000",
      "text": "کل رو خاموش کردی؟"
    },
    {
      "id": 4,
      "start": 7221.0,
      "end": 7222.0,
      "formatted_start": "02:00:21.000",
      "formatted_end": "02:00:22.000",
      "text": "بله."
    },
    {
      "id": 5,
      "start": 7223.0,
      "end": 7224.0,
      "formatted_start": "02:00:23.000",
      "formatted_end": "02:00:24.000",
      "text": "این رو بیره؟"
    },
    {
      "id": 6,
      "start": 7225.0,
      "end": 7226.0,
      "formatted_start": "02:00:25.000",
      "formatted_end": "02:00:26.000",
      "text": "بله."
    },
    {
      "id": 7,
      "start": 7226.0,
      "end": 7232.0,
      "formatted_start": "02:00:26.000",
      "formatted_end": "02:00:32.000",
      "text": "اینجا بسیار خبهگی میکنم. الان بکرم بهتر رمزه میکنم."
    },
    {
      "id": 8,
      "start": 7232.0,
      "end": 7234.0,
      "formatted_start": "02:00:32.000",
      "formatted_end": "02:00:34.000",
      "text": "کلیر بیشتر زندگی میکنیم."
    },
    {
      "id": 9,
      "start": 7234.0,
      "end": 7236.0,
      "formatted_start": "02:00:34.000",
      "formatted_end": "02:00:36.000",
      "text": "فقط کلیر."
    },
    {
      "id": 10,
      "start": 7236.0,
      "end": 7240.0,
      "formatted_start": "02:00:36.000",
      "formatted_end": "02:00:40.000",
      "text": "یعنی دمای 25 شد من دیگه جنم درگاهیم."
    },
    {
      "id": 11,
      "start": 7240.0,
      "end": 7242.0,
      "formatted_start": "02:00:40.000",
      "formatted_end": "02:00:42.000",
      "text": "هر اقام که دیگه چشمه."
    },
    {
      "id": 12,
      "start": 7242.0,
      "end": 7244.0,
      "formatted_start": "02:00:42.000",
      "formatted_end": "02:00:44.000",
      "text": "غذا چی میکنی؟"
    },
    {
      "id": 13,
      "start": 7244.0,
      "end": 7246.0,
      "formatted_start": "02:00:44.000",
      "formatted_end": "02:00:46.000",
      "text": "همچنین جنم مطابقه."
    },
    {
      "id": 14,
      "start": 7246.0,
      "end": 7250.0,
      "formatted_start": "02:00:46.000",
      "formatted_end": "02:00:50.000",
      "text": "دو تا بشمند."
    },
    {
      "id": 15,
      "start": 7250.0,
      "end": 7252.0,
      "formatted_start": "02:00:50.000",
      "formatted_end": "02:00:52.000",
      "text": "یکی گرمای هواست."
    },
    {
      "id": 16,
      "start": 7252.0,
      "end": 7254.0,
      "formatted_start": "02:00:52.000",
      "formatted_end": "02:00:54.000",
      "text": "یکی گرمای غذاست."
    },
    {
      "id": 17,
      "start": 7254.0,
      "end": 7256.0,
      "formatted_start": "02:00:54.000",
      "formatted_end": "02:00:56.000",
      "text": "گرم هایی که درونی میشه"
    },
    {
      "id": 18,
      "start": 7256.0,
      "end": 7260.0,
      "formatted_start": "02:00:56.000",
      "formatted_end": "02:01:00.000",
      "text": "چیزهایی که گرم هستند رو کلن باید حصه کنید"
    },
    {
      "id": 19,
      "start": 7260.0,
      "end": 7263.0,
      "formatted_start": "02:01:00.000",
      "formatted_end": "02:01:03.000",
      "text": "تو دوچار گرم ها زده ایه درونی شده"
    },
    {
      "id": 20,
      "start": 7263.0,
      "end": 7268.0,
      "formatted_start": "02:01:03.000",
      "formatted_end": "02:01:08.000",
      "text": "باید شیرینی هر چیزی که شکر داره باید بختش میده بید"
    },
    {
      "id": 21,
      "start": 7268.0,
      "end": 7271.0,
      "formatted_start": "02:01:08.000",
      "formatted_end": "02:01:11.000",
      "text": "هر چیزی در روغن داره این رو باید بکنید."
    },
    {
      "id": 22,
      "start": 7271.0,
      "end": 7273.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:13.000",
      "text": "آرشوشی و موجه"
    },
    {
      "id": 23,
      "start": 7273.0,
      "end": 7277.0,
      "formatted_start": "02:01:13.000",
      "formatted_end": "02:01:17.000",
      "text": "هر چیز شیعی و چربی به ازداخت عدویه جاید."
    },
    {
      "id": 24,
      "start": 7277.0,
      "end": 7282.0,
      "formatted_start": "02:01:17.000",
      "formatted_end": "02:01:22.000",
      "text": "این سه تا چیز رو باید به طور کامل قسمت کنید تا میتونید غرس نباشید."
    },
    {
      "id": 25,
      "start": 7282.0,
      "end": 7283.0,
      "formatted_start": "02:01:22.000",
      "formatted_end": "02:01:23.000",
      "text": "غذا مهم."
    },
    {
      "id": 26,
      "start": 7283.0,
      "end": 7287.0,
      "formatted_start": "02:01:23.000",
      "formatted_end": "02:01:27.000",
      "text": "خب، آب زیاد بخواید. خوب و بد میتونست دارد."
    },
    {
      "id": 27,
      "start": 7287.0,
      "end": 7294.0,
      "formatted_start": "02:01:27.000",
      "formatted_end": "02:01:34.000",
      "text": "بد شامل شکر، چربی، عدویه."
    },
    {
      "id": 28,
      "start": 7294.0,
      "end": 7296.0,
      "formatted_start": "02:01:34.000",
      "formatted_end": "02:01:36.000",
      "text": "عدویه."
    },
    {
      "id": 29,
      "start": 7296.0,
      "end": 7301.28,
      "formatted_start": "02:01:36.000",
      "formatted_end": "02:01:41.280",
      "text": "میوه های گردی بیسته عمبه، خرب، حسد این ها گردی هستند"
    },
    {
      "id": 30,
      "start": 7301.28,
      "end": 7304.4,
      "formatted_start": "02:01:41.280",
      "formatted_end": "02:01:44.400",
      "text": "عمبه، خرب، حسد این هستند"
    },
    {
      "id": 31,
      "start": 7304.4,
      "end": 7307.28,
      "formatted_start": "02:01:44.400",
      "formatted_end": "02:01:47.280",
      "text": "چیزو... چی خوردید؟ عمبه خوردید؟"
    },
    {
      "id": 32,
      "start": 7307.28,
      "end": 7308.4,
      "formatted_start": "02:01:47.280",
      "formatted_end": "02:01:48.400",
      "text": "عمبه و قرب"
    },
    {
      "id": 33,
      "start": 7308.4,
      "end": 7310.4,
      "formatted_start": "02:01:48.400",
      "formatted_end": "02:01:50.400",
      "text": "عمبه و قرب، این هستند"
    },
    {
      "id": 34,
      "start": 7310.4,
      "end": 7311.92,
      "formatted_start": "02:01:50.400",
      "formatted_end": "02:01:51.920",
      "text": "گردی"
    },
    {
      "id": 35,
      "start": 7311.92,
      "end": 7315.04,
      "formatted_start": "02:01:51.920",
      "formatted_end": "02:01:55.040",
      "text": "آب فرابا باید بکنید، آب جوشیده"
    },
    {
      "id": 36,
      "start": 7315.04,
      "end": 7316.56,
      "formatted_start": "02:01:55.040",
      "formatted_end": "02:01:56.560",
      "text": "تخم شروعی"
    },
    {
      "id": 37,
      "start": 7316.56,
      "end": 7319.2,
      "formatted_start": "02:01:56.560",
      "formatted_end": "02:01:59.200",
      "text": "شروعی باید جوشید، ده پر بلند شما بکنید"
    },
    {
      "id": 38,
      "start": 7319.2,
      "end": 7320.4,
      "formatted_start": "02:01:59.200",
      "formatted_end": "02:02:00.400",
      "text": "قلبت براد"
    },
    {
      "id": 39,
      "start": 7320.4,
      "end": 7322.0,
      "formatted_start": "02:02:00.400",
      "formatted_end": "02:02:02.000",
      "text": "آب لیمون"
    },
    {
      "id": 40,
      "start": 7322.0,
      "end": 7324.8,
      "formatted_start": "02:02:02.000",
      "formatted_end": "02:02:04.800",
      "text": "خانم مقدم بیا، بارانی بیا"
    },
    {
      "id": 41,
      "start": 7324.8,
      "end": 7328.66,
      "formatted_start": "02:02:04.800",
      "formatted_end": "02:02:08.660",
      "text": "بسیار قلت دارید"
    },
    {
      "id": 42,
      "start": 7328.66,
      "end": 7330.12,
      "formatted_start": "02:02:08.660",
      "formatted_end": "02:02:10.120",
      "text": "بنابراین"
    },
    {
      "id": 43,
      "start": 7330.12,
      "end": 7333.04,
      "formatted_start": "02:02:10.120",
      "formatted_end": "02:02:13.040",
