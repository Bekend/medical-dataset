      "id": 105,
      "start": 7442.32,
      "end": 7444.32,
      "formatted_start": "02:04:02.320",
      "formatted_end": "02:04:04.320",
      "text": "من چیزی که از دور می آییم معلومه"
    },
    {
      "id": 106,
      "start": 7444.32,
      "end": 7446.32,
      "formatted_start": "02:04:04.320",
      "formatted_end": "02:04:06.320",
      "text": "پرپاریه"
    },
    {
      "id": 107,
      "start": 7446.32,
      "end": 7448.32,
      "formatted_start": "02:04:06.320",
      "formatted_end": "02:04:08.320",
      "text": "از غذای زمستانی داریم"
    },
    {
      "id": 108,
      "start": 7448.32,
      "end": 7450.32,
      "formatted_start": "02:04:08.320",
      "formatted_end": "02:04:10.320",
      "text": "من صبح از کشاور برام"
    },
    {
      "id": 109,
      "start": 7450.32,
      "end": 7452.32,
      "formatted_start": "02:04:10.320",
      "formatted_end": "02:04:12.320",
      "text": "کشاور برام"
    },
    {
      "id": 110,
      "start": 7452.32,
      "end": 7454.32,
      "formatted_start": "02:04:12.320",
      "formatted_end": "02:04:14.320",
      "text": "صبح خیلی خیلی فجی"
    },
    {
      "id": 111,
      "start": 7454.32,
      "end": 7456.32,
      "formatted_start": "02:04:14.320",
      "formatted_end": "02:04:16.320",
      "text": "از خوابه شب من که بطیعه آرزه برام ترافت است"
    },
    {
      "id": 112,
      "start": 7456.32,
      "end": 7458.32,
      "formatted_start": "02:04:16.320",
      "formatted_end": "02:04:18.320",
      "text": "خوابه شب برام رهرماره"
    },
    {
      "id": 113,
      "start": 7458.32,
      "end": 7460.32,
      "formatted_start": "02:04:18.320",
      "formatted_end": "02:04:20.320",
      "text": "یک یادگاهی"
    },
    {
      "id": 114,
      "start": 7460.32,
      "end": 7462.32,
      "formatted_start": "02:04:20.320",
      "formatted_end": "02:04:22.320",
      "text": "از زندان موند"
    },
    {
      "id": 115,
      "start": 7462.32,
      "end": 7464.32,
      "formatted_start": "02:04:22.320",
      "formatted_end": "02:04:24.320",
      "text": "در سن ۱۰۰۸"
    },
    {
      "id": 116,
      "start": 7464.32,
      "end": 7466.32,
      "formatted_start": "02:04:24.320",
      "formatted_end": "02:04:26.320",
      "text": "کلوزافین ۲۵ بخوره"
    },
    {
      "id": 117,
      "start": 7466.32,
      "end": 7468.32,
      "formatted_start": "02:04:26.320",
      "formatted_end": "02:04:28.320",
      "text": "خود را بینیم 25 آشنا"
    },
    {
      "id": 118,
      "start": 7468.32,
      "end": 7469.32,
      "formatted_start": "02:04:28.320",
      "formatted_end": "02:04:29.320",
      "text": "خواب؟"
    },
    {
      "id": 119,
      "start": 7469.32,
      "end": 7471.32,
      "formatted_start": "02:04:29.320",
      "formatted_end": "02:04:31.320",
      "text": "اصلا خواب ندارم با دکتر"
    },
    {
      "id": 120,
      "start": 7471.32,
      "end": 7473.32,
      "formatted_start": "02:04:31.320",
      "formatted_end": "02:04:33.320",
      "text": "خواب هم که نداشتون شب"
    },
    {
      "id": 121,
      "start": 7473.32,
      "end": 7475.32,
      "formatted_start": "02:04:33.320",
      "formatted_end": "02:04:35.320",
      "text": "خوروخون میلیده به هم سرگرد"
    },
    {
      "id": 122,
      "start": 7475.32,
      "end": 7477.32,
      "formatted_start": "02:04:35.320",
      "formatted_end": "02:04:37.320",
      "text": "بیاین دسمت سرم سمت چپ"
    },
    {
      "id": 123,
      "start": 7477.32,
      "end": 7480.32,
      "formatted_start": "02:04:37.320",
      "formatted_end": "02:04:40.320",
      "text": "و شکرم برام کار نمی کنه"
    },
    {
      "id": 124,
      "start": 7480.32,
      "end": 7482.32,
      "formatted_start": "02:04:40.320",
      "formatted_end": "02:04:42.320",
      "text": "تا نخواب هم کار نمیدونه"
    },
    {
      "id": 125,
      "start": 7483.32,
      "end": 7485.32,
      "formatted_start": "02:04:43.320",
      "formatted_end": "02:04:45.320",
      "text": "جان آیا جان سلام"
    },
    {
      "id": 126,
      "start": 7485.32,
      "end": 7487.32,
      "formatted_start": "02:04:45.320",
      "formatted_end": "02:04:47.320",
      "text": "بفرم سلام"
    },
    {
      "id": 127,
      "start": 7489.32,
      "end": 7492.32,
      "formatted_start": "02:04:49.320",
      "formatted_end": "02:04:52.320",
      "text": "اشکال نداره فرد جان بگو بگو فرم بگو فرم"
