  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 4200.0,
      "end": 4205.0,
      "formatted_start": "01:10:00.000",
      "formatted_end": "01:10:05.000",
      "text": "همه این قسمت به پینجه بزشته میشوند، این موجه."
    },
    {
      "id": 1,
      "start": 4206.0,
      "end": 4215.0,
      "formatted_start": "01:10:06.000",
      "formatted_end": "01:10:15.000",
      "text": "برق رفته یه جایی، سروره قطع شده، انترنت نمی‌آید، با باتری می‌فرستن، مسیبت داریم."
    },
    {
      "id": 2,
      "start": 4215.0,
      "end": 4222.0,
      "formatted_start": "01:10:15.000",
      "formatted_end": "01:10:22.000",
      "text": "اما آخه انترنت برای چی؟ من بریم سر تو برو داروها رو بگیر دیگه، نه، باید بریم به انترنت،"
    },
    {
      "id": 3,
      "start": 4222.0,
      "end": 4229.0,
      "formatted_start": "01:10:22.000",
      "formatted_end": "01:10:29.000",
      "text": "تهران به فهم منشی می‌گیرسن که مالیاتشو بگیره دیگه، سهانه جوی گوشیشو بگارن."
    },
    {
      "id": 4,
      "start": 4229.0,
      "end": 4239.0,
      "formatted_start": "01:10:29.000",
      "formatted_end": "01:10:39.000",
      "text": "بعد خب این کار نیاز به یک بستر آماده داره، انترنت پر سرعت، بر و آماده، ممکنه بر نداره انترنت میتوش کنه"
    },
    {
      "id": 5,
      "start": 4239.0,
      "end": 4249.0,
      "formatted_start": "01:10:39.000",
      "formatted_end": "01:10:49.000",
      "text": "مثل این بازی پیرانی، کراوات بزنه، بزنی و ببینی مثلا تو نامبایی هم بار برن، با دمبایی"
    },
    {
      "id": 6,
      "start": 4249.0,
      "end": 4252.0,
      "formatted_start": "01:10:49.000",
      "formatted_end": "01:10:52.000",
      "text": "خواهید نمیشه که اون کراواته اینترنته"
    },
    {
      "id": 7,
      "start": 4252.0,
      "end": 4257.0,
      "formatted_start": "01:10:52.000",
      "formatted_end": "01:10:57.000",
      "text": "ولی بر نداریم، پیرن نپوشیده، واضع پیرنیه، به همپایی پوشیده"
    },
    {
      "id": 8,
      "start": 4257.0,
      "end": 4261.0,
      "formatted_start": "01:10:57.000",
      "formatted_end": "01:11:01.000",
      "text": "رفته نامبایی کارو کنه، کراوات هم بکنه، تو ما باید کراوات بزنیم"
    },
    {
      "id": 9,
      "start": 4262.0,
      "end": 4265.0,
      "formatted_start": "01:11:02.000",
      "formatted_end": "01:11:05.000",
      "text": "دوتوش هم زدیم، مفترین"
    },
    {
      "id": 10,
      "start": 4265.0,
      "end": 4295.0,
      "formatted_start": "01:11:05.000",
      "formatted_end": "01:11:35.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 11,
      "start": 4295.0,
      "end": 4304.0,
      "formatted_start": "01:11:35.000",
      "formatted_end": "01:11:44.000",
      "text": "آدویتون من با بکنون صحبت کردم، یکم در حال زده افتباهشون بود، نظرشون بود که آدویتون همباره کشته بودن"
    },
    {
      "id": 12,
      "start": 4304.0,
      "end": 4314.0,
      "formatted_start": "01:11:44.000",
      "formatted_end": "01:11:54.000",
      "text": "زده افتباهی، حالا ترنگ سید و آکنه پیت و لایت و بیرنگ رو اینها رو برنیسن که من برای شما تک رو تا سی و یک مداد انشاءالله برمیده"
    },
    {
      "id": 13,
      "start": 4314.0,
      "end": 4317.0,
      "formatted_start": "01:11:54.000",
      "formatted_end": "01:11:57.000",
      "text": "بعد این یکی آش رو قضی روش کنون"
    },
    {
      "id": 14,
      "start": 4317.0,
      "end": 4319.0,
      "formatted_start": "01:11:57.000",
      "formatted_end": "01:11:59.000",
      "text": "۶۶ بود"
    },
    {
      "id": 15,
      "start": 4319.0,
      "end": 4320.0,
      "formatted_start": "01:11:59.000",
      "formatted_end": "01:12:00.000",
      "text": "چیزشون نگذارد"
    },
    {
      "id": 16,
      "start": 4320.0,
      "end": 4323.0,
      "formatted_start": "01:12:00.000",
      "formatted_end": "01:12:03.000",
      "text": "آهان اونو اوکیه همون رو دارم عرض میکنم"
    },
    {
      "id": 17,
      "start": 4323.0,
      "end": 4327.0,
      "formatted_start": "01:12:03.000",
      "formatted_end": "01:12:07.000",
      "text": "گفتم اون نیاز سی دلات که اصلا تموم شد"
    },
    {
      "id": 18,
      "start": 4327.0,
      "end": 4329.0,
      "formatted_start": "01:12:07.000",
      "formatted_end": "01:12:09.000",
      "text": "این که اصلا تموم شده بود"
    },
    {
      "id": 19,
      "start": 4329.0,
      "end": 4331.0,
      "formatted_start": "01:12:09.000",
      "formatted_end": "01:12:11.000",
      "text": "اصلا ۶۰ بود از ۴۸ بود"
    },
    {
      "id": 20,
      "start": 4331.0,
      "end": 4333.0,
      "formatted_start": "01:12:11.000",
      "formatted_end": "01:12:13.000",
      "text": "اصلا اینجا ۳۰۰ بود"
    },
    {
      "id": 21,
      "start": 4333.0,
      "end": 4335.0,
      "formatted_start": "01:12:13.000",
      "formatted_end": "01:12:15.000",
      "text": "ببخشین اینو پس بی نویسید"
    },
    {
      "id": 22,
      "start": 4335.0,
      "end": 4337.0,
      "formatted_start": "01:12:15.000",
      "formatted_end": "01:12:17.000",
      "text": "۳۰۰ بود ۳۰۰ بود"
    },
    {
      "id": 23,
      "start": 4337.0,
      "end": 4342.0,
      "formatted_start": "01:12:17.000",
      "formatted_end": "01:12:22.000",
      "text": "این فرار رو بایشون پلستا درشه بیدیم"
    },
    {
      "id": 24,
      "start": 4342.0,
      "end": 4352.0,
      "formatted_start": "01:12:22.000",
      "formatted_end": "01:12:32.000",
      "text": "برای برگی زده افتابه هم نظرشونی بود که اینجا بیرنگ بیرنگیه این بیرنگیه اونی لایتیشه"
    },
    {
      "id": 25,
      "start": 4352.0,
      "end": 4358.0,
      "formatted_start": "01:12:32.000",
      "formatted_end": "01:12:38.000",
      "text": "خب خب روی زده افتابه یکم آقای دکتر دستشون چیز دار باشه بخورم باشم من بشم"
    },
    {
      "id": 26,
      "start": 4358.0,
      "end": 4360.0,
      "formatted_start": "01:12:38.000",
      "formatted_end": "01:12:40.000",
      "text": "برچشون"
    },
    {
      "id": 27,
      "start": 4360.0,
      "end": 4362.0,
      "formatted_start": "01:12:40.000",
      "formatted_end": "01:12:42.000",
      "text": "دستشون ها درنگه"
    },
    {
      "id": 28,
      "start": 4362.0,
      "end": 4364.0,
      "formatted_start": "01:12:42.000",
      "formatted_end": "01:12:44.000",
      "text": "پنجه هاش مورد چیزی همه درنگه"
    },
    {
      "id": 29,
      "start": 4364.0,
      "end": 4370.0,
      "formatted_start": "01:12:44.000",
      "formatted_end": "01:12:50.000",
      "text": "دستشون ها درنگه من چون بهشون گل داده بودم بخورتم چشمی را بگم"
    },
    {
      "id": 30,
      "start": 4370.0,
      "end": 4373.0,
      "formatted_start": "01:12:50.000",
      "formatted_end": "01:12:53.000",
      "text": "از صبح زخم لر شما، فدای محبت شما زیرم"
    },
    {
      "id": 31,
      "start": 4373.0,
      "end": 4375.0,
      "formatted_start": "01:12:53.000",
      "formatted_end": "01:12:55.000",
      "text": "از صبح زخم لر شما"
    },
    {
      "id": 32,
      "start": 4375.0,
      "end": 4377.0,
      "formatted_start": "01:12:55.000",
      "formatted_end": "01:12:57.000",
      "text": "از صبح زخم لر شما"
    },
    {
      "id": 33,
      "start": 4377.0,
      "end": 4379.0,
      "formatted_start": "01:12:57.000",
      "formatted_end": "01:12:59.000",
      "text": "از صبح زخم لر شما"
    },
    {
      "id": 34,
      "start": 4379.0,
      "end": 4380.0,
      "formatted_start": "01:12:59.000",
      "formatted_end": "01:13:00.000",
      "text": "از صبح زخم لر شما"
    },
    {
      "id": 35,
      "start": 4380.0,
      "end": 4382.0,
      "formatted_start": "01:13:00.000",
      "formatted_end": "01:13:02.000",
      "text": "سلام آقای دوستان، خانه شما خوب هستی؟"
    },
    {
      "id": 36,
      "start": 4382.0,
      "end": 4385.0,
      "formatted_start": "01:13:02.000",
      "formatted_end": "01:13:05.000",
      "text": "راستان بخیر باشه، سلامت باشین، بزرگاری"
    },
    {
      "id": 37,
      "start": 4385.0,
      "end": 4390.0,
      "formatted_start": "01:13:05.000",
      "formatted_end": "01:13:10.000",
      "text": "بزرگاری باشه، بزرگاری باشین، بازاری باشین، بازاری باشین"
    },
    {
      "id": 38,
      "start": 4390.0,
      "end": 4398.72,
      "formatted_start": "01:13:10.000",
      "formatted_end": "01:13:18.720",
      "text": "آقایی دیگه من تقریبا دستیدم و حالا خواستم بگم که روی تحکیم یا ادیاده بیشتر کنون کاری بنده نظرشونه"
    },
    {
      "id": 39,
      "start": 4398.72,
      "end": 4402.6,
      "formatted_start": "01:13:18.720",
      "formatted_end": "01:13:22.600",
      "text": "امپای لینا یا مثلا من تو که دیگه بهتون میدونم"
    },
    {
      "id": 40,
      "start": 4402.6,
      "end": 4417.44,
      "formatted_start": "01:13:22.600",
      "formatted_end": "01:13:37.440",
      "text": "بیشتر من امپا با لینا رو که گلوره تا در بعد چیز عمیدی"
    },
    {
      "id": 41,
      "start": 4417.44,
      "end": 4419.44,
      "formatted_start": "01:13:37.440",
      "formatted_end": "01:13:39.440",
      "text": "میشه این راست باید بگه؟"
    },
    {
      "id": 42,
      "start": 4419.44,
      "end": 4420.44,
      "formatted_start": "01:13:39.440",
      "formatted_end": "01:13:40.440",
      "text": "خشک"
    },
    {
      "id": 43,
      "start": 4420.44,
      "end": 4423.44,
      "formatted_start": "01:13:40.440",
      "formatted_end": "01:13:43.440",
      "text": "این راست باید بخورید دوتا دوتا باید بخورید دوتا صبح دوتا شب"
    },
    {
      "id": 44,
      "start": 4423.44,
      "end": 4425.44,
      "formatted_start": "01:13:43.440",
      "formatted_end": "01:13:45.440",
      "text": "درست شد؟"
    },
    {
      "id": 45,
      "start": 4425.44,
      "end": 4427.44,
      "formatted_start": "01:13:45.440",
      "formatted_end": "01:13:47.440",
      "text": "این پاماد به رد بخی سزاریانش بزنه"
    },
    {
      "id": 46,
      "start": 4427.44,
      "end": 4430.44,
      "formatted_start": "01:13:47.440",
      "formatted_end": "01:13:50.440",
      "text": "آیروویت رو میدیم میخوره آن همه شکل"
    },
    {
      "id": 47,
      "start": 4430.44,
      "end": 4432.44,
      "formatted_start": "01:13:50.440",
      "formatted_end": "01:13:52.440",
      "text": "باید کلورا روزی دو بار"
    },
    {
      "id": 48,
      "start": 4432.44,
      "end": 4435.44,
      "formatted_start": "01:13:52.440",
      "formatted_end": "01:13:55.440",
      "text": "که اون کلورا طبیعی رویش رو درست بکنه"
    },
    {
      "id": 49,
      "start": 4435.44,
      "end": 4440.44,
      "formatted_start": "01:13:55.440",
      "formatted_end": "01:14:00.440",
      "text": "بیسموت رنگ مدخوی خودش و بچهش رو بشکی میکنه اشکال نداره"
    },
    {
      "id": 50,
      "start": 4440.44,
      "end": 4443.44,
      "formatted_start": "01:14:00.440",
      "formatted_end": "01:14:03.440",
      "text": "امکولا تیه سرام برسید"
    },
    {
      "id": 51,
      "start": 4443.44,
      "end": 4445.44,
      "formatted_start": "01:14:03.440",
      "formatted_end": "01:14:05.440",
      "text": "تموم شده هستم"
    },
    {
      "id": 52,
      "start": 4445.44,
      "end": 4447.44,
      "formatted_start": "01:14:05.440",
      "formatted_end": "01:14:07.440",
      "text": "پرورس های دوستانی در هیوستان شده هستم"
    },
    {
      "id": 53,
      "start": 4447.44,
      "end": 4449.44,
      "formatted_start": "01:14:07.440",
      "formatted_end": "01:14:09.440",
      "text": "تا به دوستانه"
    },
    {
      "id": 54,
      "start": 4449.44,
      "end": 4451.44,
      "formatted_start": "01:14:09.440",
      "formatted_end": "01:14:11.440",
      "text": "مصرف با کنه فره"
    },
    {
      "id": 55,
      "start": 4451.44,
      "end": 4453.44,
      "formatted_start": "01:14:11.440",
      "formatted_end": "01:14:13.440",
      "text": "به فرمان"
    },
    {
      "id": 56,
      "start": 4453.44,
      "end": 4455.44,
      "formatted_start": "01:14:13.440",
      "formatted_end": "01:14:15.440",
      "text": "مرزه رو هم گیر دیارم"
    },
    {
      "id": 57,
      "start": 4455.44,
      "end": 4458.44,
      "formatted_start": "01:14:15.440",
      "formatted_end": "01:14:18.440",
      "text": "مرزه گاریج این شی بود؟"
    },
    {
      "id": 58,
      "start": 4458.44,
      "end": 4460.44,
      "formatted_start": "01:14:18.440",
      "formatted_end": "01:14:20.440",
      "text": "بلومکس بود دیگه قبلن"
    },
    {
      "id": 59,
      "start": 4460.44,
      "end": 4462.44,
      "formatted_start": "01:14:20.440",
      "formatted_end": "01:14:22.440",
      "text": "الان نیسته هم؟"
    },
    {
      "id": 60,
      "start": 4462.44,
      "end": 4464.44,
      "formatted_start": "01:14:22.440",
      "formatted_end": "01:14:24.440",
      "text": "نیسته هم"
    },
    {
      "id": 61,
      "start": 4464.44,
      "end": 4466.44,
      "formatted_start": "01:14:24.440",
      "formatted_end": "01:14:26.440",
      "text": "برای اصحاب بلومکس"
    },
    {
      "id": 62,
      "start": 4466.44,
      "end": 4468.44,
      "formatted_start": "01:14:26.440",
      "formatted_end": "01:14:28.440",
      "text": "کپرومین هم میگفتونو"
    },
    {
      "id": 63,
      "start": 4468.44,
      "end": 4472.9,
      "formatted_start": "01:14:28.440",
      "formatted_end": "01:14:32.900",
      "text": "این همون کلپوره که دو دمو بگیری به جای همونم میشه"
    },
    {
      "id": 64,
      "start": 4472.9,
      "end": 4476.14,
      "formatted_start": "01:14:32.900",
      "formatted_end": "01:14:36.140",
      "text": "الان کلپوره و مرزه برو از حتیری منو مندر کنم"
    },
    {
      "id": 65,
      "start": 4476.14,
      "end": 4479.78,
      "formatted_start": "01:14:36.140",
      "formatted_end": "01:14:39.780",
      "text": "نمیدونن چیه من هیگلو مکس میشن"
    },
    {
      "id": 66,
      "start": 4479.78,
      "end": 4481.5,
      "formatted_start": "01:14:39.780",
      "formatted_end": "01:14:41.500",
      "text": "نمیشن سنم"
    },
    {
      "id": 67,
      "start": 4481.5,
      "end": 4484.64,
      "formatted_start": "01:14:41.500",
      "formatted_end": "01:14:44.640",
      "text": "برو از حتیریشو بگیر همست"
    },
    {
      "id": 68,
      "start": 4484.64,
      "end": 4487.04,
      "formatted_start": "01:14:44.640",
      "formatted_end": "01:14:47.040",
      "text": "کلپوره کابر"
    },
    {
      "id": 69,
      "start": 4487.04,
      "end": 4491.48,
      "formatted_start": "01:14:47.040",
      "formatted_end": "01:14:51.480",
      "text": "کلپوره کابر مندر که حالا وقت خدمتون بذارم جدید"
    },
    {
      "id": 70,
      "start": 4491.48,
      "end": 4496.1,
      "formatted_start": "01:14:51.480",
      "formatted_end": "01:14:56.100",
      "text": "و بعد اینکه های دوتور در بار ساده بشن"
    },
    {
      "id": 71,
      "start": 4496.1,
      "end": 4499.1,
      "formatted_start": "01:14:56.100",
      "formatted_end": "01:14:59.100",
      "text": "من اینجا دیابته تو رو میخواستم بگیرم تو این چند باز"
    }
  ],
  "status": "completed"
}