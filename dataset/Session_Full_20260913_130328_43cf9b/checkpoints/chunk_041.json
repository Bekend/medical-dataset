  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12330.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:30.000",
      "text": "از این ازمان همه از این ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ازمان همه از ا"
    },
    {
      "id": 1,
      "start": 12330.0,
      "end": 12332.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:32.000",
      "text": "یا چیزی بقیه از کنه صاف"
    },
    {
      "id": 2,
      "start": 12332.0,
      "end": 12334.0,
      "formatted_start": "03:25:32.000",
      "formatted_end": "03:25:34.000",
      "text": "توش بود عکسشو بگیر"
    },
    {
      "id": 3,
      "start": 12334.0,
      "end": 12336.0,
      "formatted_start": "03:25:34.000",
      "formatted_end": "03:25:36.000",
      "text": "چون شانده بیا بشه"
    },
    {
      "id": 4,
      "start": 12340.0,
      "end": 12344.0,
      "formatted_start": "03:25:40.000",
      "formatted_end": "03:25:44.000",
      "text": "الان باید کاری که سمادنها باید جمع بدم"
    },
    {
      "id": 5,
      "start": 12344.0,
      "end": 12347.0,
      "formatted_start": "03:25:44.000",
      "formatted_end": "03:25:47.000",
      "text": "خونه تر درسته شنه کمتر میشه باز"
    },
    {
      "id": 6,
      "start": 12347.0,
      "end": 12349.0,
      "formatted_start": "03:25:47.000",
      "formatted_end": "03:25:49.000",
      "text": "شانده برای میره"
    },
    {
      "id": 7,
      "start": 12349.0,
      "end": 12351.0,
      "formatted_start": "03:25:49.000",
      "formatted_end": "03:25:51.000",
      "text": "با خونه کردن باید بردار"
    },
    {
      "id": 8,
      "start": 12351.0,
      "end": 12355.0,
      "formatted_start": "03:25:51.000",
      "formatted_end": "03:25:55.000",
      "text": "از سه ماهی داریم استفاده بود کمتر شده باید"
    },
    {
      "id": 9,
      "start": 12355.0,
      "end": 12356.0,
      "formatted_start": "03:25:55.000",
      "formatted_end": "03:25:56.000",
      "text": "بعدی ممکنه"
    },
    {
      "id": 10,
      "start": 12356.0,
      "end": 12358.0,
      "formatted_start": "03:25:56.000",
      "formatted_end": "03:25:58.000",
      "text": "شما یک جایی بری"
    },
    {
      "id": 11,
      "start": 12358.0,
      "end": 12365.0,
      "formatted_start": "03:25:58.000",
      "formatted_end": "03:26:05.000",
      "text": "همین مشتری خودت آمده به خودت دفته که ازم این کارو رو منجم دادیم باز درجه آب بیر بارم"
    },
    {
      "id": 12,
      "start": 12365.0,
      "end": 12366.0,
      "formatted_start": "03:26:05.000",
      "formatted_end": "03:26:06.000",
      "text": "نشده که"
    },
    {
      "id": 13,
      "start": 12366.0,
      "end": 12368.0,
      "formatted_start": "03:26:06.000",
      "formatted_end": "03:26:08.000",
      "text": "چرا اون ایراد رو باید ادام کنیم؟"
    },
    {
      "id": 14,
      "start": 12368.0,
      "end": 12376.0,
      "formatted_start": "03:26:08.000",
      "formatted_end": "03:26:16.000",
      "text": "ایرادش رو باید پیدا کنیم، درسته ایرادش، ایراد درجه آب بیر بارم اینه که یه جهانی کنده"
    },
    {
      "id": 15,
      "start": 12376.0,
      "end": 12382.0,
      "formatted_start": "03:26:16.000",
      "formatted_end": "03:26:22.000",
      "text": "ما مثلا ما ترپومب عوض کردیم، نمیدونم فران عوض کردیم، هرم نیم ترموستات هم عوض میکنیم"
    },
    {
      "id": 16,
      "start": 12382.0,
      "end": 12388.88,
      "formatted_start": "03:26:22.000",
      "formatted_end": "03:26:28.880",
      "text": "۸۴ میخواییم ۷۲ بگوییم، اینم رو تا میکنیم، اینم رو داریم بر جامعه، ترمستاتش رو میخواییم کم کنیم"
    },
    {
      "id": 17,
      "start": 12388.88,
      "end": 12396.4,
      "formatted_start": "03:26:28.880",
      "formatted_end": "03:26:36.400",
      "text": "ولی یه دفعه نمیشه اینه برداشت، خودت میدانی، این اتفاقات نمیگنی، یعنی این دکانیکه، اینه پزشکیه"
    },
    {
      "id": 18,
      "start": 12396.4,
      "end": 12401.92,
      "formatted_start": "03:26:36.400",
      "formatted_end": "03:26:41.920",
      "text": "یه جنب، یه دفعه هم نمیشه از برداشت، اون برای موتار سرد نباید کار میکنه"
    },
    {
      "id": 19,
      "start": 12401.92,
      "end": 12403.92,
      "formatted_start": "03:26:41.920",
      "formatted_end": "03:26:43.920",
      "text": "نه"
    },
    {
      "id": 20,
      "start": 12403.92,
      "end": 12409.2,
      "formatted_start": "03:26:43.920",
      "formatted_end": "03:26:49.200",
      "text": "نه درونا، بوتار، بر هفته، سه نه"
    },
    {
      "id": 21,
      "start": 12412.0,
      "end": 12434.0,
      "formatted_start": "03:26:52.000",
      "formatted_end": "03:27:14.000",
      "text": "اینجا همه چیزی هست که مرد سریع بازخوخ نمیده"
    },
    {
      "id": 22,
      "start": 12434.0,
      "end": 12453.0,
      "formatted_start": "03:27:14.000",
      "formatted_end": "03:27:33.000",
      "text": "اینجا باید بیشتر برد بشه که این رو بهتر از من برد باشه و اگر میشنختم حتما بهتر میگفتم"
    },
    {
      "id": 23,
      "start": 12453.0,
      "end": 12459.0,
      "formatted_start": "03:27:33.000",
      "formatted_end": "03:27:39.000",
      "text": "توجه این، من الان 35 ساله دارم کنه نبویباری اینجا میگن"
    },
    {
      "id": 24,
      "start": 12459.0,
      "end": 12464.0,
      "formatted_start": "03:27:39.000",
      "formatted_end": "03:27:44.000",
      "text": "توجه هم تو چی میگن؟ اگه من بشناسم از خود رقیب کنم، برای من حرام باشن"
    },
    {
      "id": 25,
      "start": 12464.0,
      "end": 12465.0,
      "formatted_start": "03:27:44.000",
      "formatted_end": "03:27:45.000",
      "text": "نه، واقعا"
    },
    {
      "id": 26,
      "start": 12465.0,
      "end": 12468.0,
      "formatted_start": "03:27:45.000",
      "formatted_end": "03:27:48.000",
      "text": "نه، پنج امید نیستن، اونقدر نمیدارن"
    },
    {
      "id": 27,
      "start": 12468.0,
      "end": 12474.0,
      "formatted_start": "03:27:48.000",
      "formatted_end": "03:27:54.000",
      "text": "ما پیش بهترین های تهران درس خواندیم و اینجور من مشکل فراغان نشیم به هر کل"
    },
    {
      "id": 28,
      "start": 12474.0,
      "end": 12476.0,
      "formatted_start": "03:27:54.000",
      "formatted_end": "03:27:56.000",
      "text": "و درست شد اینا؟"
    },
    {
      "id": 29,
      "start": 12476.0,
      "end": 12478.0,
      "formatted_start": "03:27:56.000",
      "formatted_end": "03:27:58.000",
      "text": "فراغان، فراغان"
    },
    {
      "id": 30,
      "start": 12478.0,
      "end": 12480.0,
      "formatted_start": "03:27:58.000",
      "formatted_end": "03:28:00.000",
      "text": "از اینجور جای امیدی هست؟"
    },
    {
      "id": 31,
      "start": 12480.0,
      "end": 12486.0,
      "formatted_start": "03:28:00.000",
      "formatted_end": "03:28:06.000",
      "text": "زیاد زیاد چایی میده از برده زیاد چایی میده از برده خیلی زیاد چایی میده از برده"
    },
    {
      "id": 32,
      "start": 12486.0,
      "end": 12488.0,
      "formatted_start": "03:28:06.000",
      "formatted_end": "03:28:08.000",
      "text": "کم روز در؟"
    },
    {
      "id": 33,
      "start": 12488.0,
      "end": 12490.0,
      "formatted_start": "03:28:08.000",
      "formatted_end": "03:28:10.000",
      "text": "روزی سوا؟"
    },
    {
      "id": 34,
      "start": 12490.0,
      "end": 12493.0,
      "formatted_start": "03:28:10.000",
      "formatted_end": "03:28:13.000",
      "text": "روزی سوا 3 تا 5 دقیقه خورده از برده"
    },
    {
      "id": 35,
      "start": 12493.0,
      "end": 12495.0,
      "formatted_start": "03:28:13.000",
      "formatted_end": "03:28:15.000",
      "text": "3 تا 5 دروها"
    },
    {
      "id": 36,
      "start": 12495.0,
      "end": 12500.0,
      "formatted_start": "03:28:15.000",
      "formatted_end": "03:28:20.000",
      "text": "من حالا اون دروها و این دروها اگر تکراره هست توش نمیدونم"
    },
    {
      "id": 37,
      "start": 12500.0,
      "end": 12503.0,
      "formatted_start": "03:28:20.000",
      "formatted_end": "03:28:23.000",
      "text": "این امکان رو تکراره ببینیم"
    },
    {
      "id": 38,
      "start": 12503.0,
      "end": 12505.0,
      "formatted_start": "03:28:23.000",
      "formatted_end": "03:28:25.000",
      "text": "من یه رنز کانتوست رو دادم دیوز یا نه"
    },
    {
      "id": 39,
      "start": 12505.0,
      "end": 12507.0,
      "formatted_start": "03:28:25.000",
      "formatted_end": "03:28:27.000",
      "text": "بازدواری مورسل این تاوش؟"
    },
    {
      "id": 40,
      "start": 12507.0,
      "end": 12508.0,
      "formatted_start": "03:28:27.000",
      "formatted_end": "03:28:28.000",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 12508.0,
      "end": 12511.0,
      "formatted_start": "03:28:28.000",
      "formatted_end": "03:28:31.000",
      "text": "برو سایی که تماشا باز دارم آزماش کنم یا نه؟"
    },
    {
      "id": 42,
      "start": 12511.0,
      "end": 12513.0,
      "formatted_start": "03:28:31.000",
      "formatted_end": "03:28:33.000",
      "text": "نه، نه، نه، با درماز کنم"
    },
    {
      "id": 43,
      "start": 12513.0,
      "end": 12514.0,
      "formatted_start": "03:28:33.000",
      "formatted_end": "03:28:34.000",
      "text": "جا؟"
    },
    {
      "id": 44,
      "start": 12515.0,
      "end": 12517.0,
      "formatted_start": "03:28:35.000",
      "formatted_end": "03:28:37.000",
      "text": "این مالی فریص برکردید، شروع داد"
    },
    {
      "id": 45,
      "start": 12517.0,
      "end": 12520.0,
      "formatted_start": "03:28:37.000",
      "formatted_end": "03:28:40.000",
      "text": "الان این اشتباهی، الان دادم، اون می آورد، الان آفرین به تو خواهیم"
    },
    {
      "id": 46,
      "start": 12520.0,
      "end": 12522.0,
      "formatted_start": "03:28:40.000",
      "formatted_end": "03:28:42.000",
      "text": "باید دنبالتو می دویم، هرد"
    },
    {
      "id": 47,
      "start": 12522.0,
      "end": 12523.0,
      "formatted_start": "03:28:42.000",
      "formatted_end": "03:28:43.000",
      "text": "زنگ دفتر خود دارید"
    },
    {
      "id": 48,
      "start": 12523.0,
      "end": 12524.0,
      "formatted_start": "03:28:43.000",
      "formatted_end": "03:28:44.000",
      "text": "جا؟"
    },
    {
      "id": 49,
      "start": 12524.0,
      "end": 12527.0,
      "formatted_start": "03:28:44.000",
      "formatted_end": "03:28:47.000",
      "text": "چارشنبه تو بیا، آره"
    },
    {
      "id": 50,
      "start": 12527.0,
      "end": 12530.0,
      "formatted_start": "03:28:47.000",
      "formatted_end": "03:28:50.000",
      "text": "نه، سال داری، دیگه شو فرما"
    },
    {
      "id": 51,
      "start": 12530.0,
      "end": 12531.0,
      "formatted_start": "03:28:50.000",
      "formatted_end": "03:28:51.000",
      "text": "بسر باش"
    },
    {
      "id": 52,
      "start": 12538.0,
      "end": 12568.0,
      "formatted_start": "03:28:58.000",
      "formatted_end": "03:29:28.000",
      "text": "۳۳۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰"
    },
    {
      "id": 53,
      "start": 12568.0,
      "end": 12572.0,
      "formatted_start": "03:29:28.000",
      "formatted_end": "03:29:32.000",
      "text": "این ها دادی میرم افتاده گردن و مردم هم بیرون خواهند دادن کش کردن"
    },
    {
      "id": 54,
      "start": 12572.0,
      "end": 12574.0,
      "formatted_start": "03:29:32.000",
      "formatted_end": "03:29:34.000",
      "text": "شماره نگرفته؟"
    },
    {
      "id": 55,
      "start": 12574.0,
      "end": 12576.0,
      "formatted_start": "03:29:34.000",
      "formatted_end": "03:29:36.000",
      "text": "نه شماره نگرفته"
    },
    {
      "id": 56,
      "start": 12576.0,
      "end": 12578.0,
      "formatted_start": "03:29:36.000",
      "formatted_end": "03:29:38.000",
      "text": "یه هر چی شماره نگرفته؟"
    },
    {
      "id": 57,
      "start": 12578.0,
      "end": 12580.0,
      "formatted_start": "03:29:38.000",
      "formatted_end": "03:29:40.000",
      "text": "خالی نازی آمد دیروز با دو خالی نازی برز کشید"
    },
    {
      "id": 58,
      "start": 12580.0,
      "end": 12582.0,
      "formatted_start": "03:29:40.000",
      "formatted_end": "03:29:42.000",
      "text": "باید بشه برد به دکتر من مشکلتو بگم"
    },
    {
      "id": 59,
      "start": 12582.0,
      "end": 12584.0,
      "formatted_start": "03:29:42.000",
      "formatted_end": "03:29:44.000",
      "text": "خودشم نیمونی بشه"
    },
    {
      "id": 60,
      "start": 12584.0,
      "end": 12586.0,
      "formatted_start": "03:29:44.000",
      "formatted_end": "03:29:46.000",
      "text": "دکتر رو باید بشه برد من یاد بده"
    },
    {
      "id": 61,
      "start": 12586.0,
      "end": 12588.0,
      "formatted_start": "03:29:46.000",
      "formatted_end": "03:29:48.000",
      "text": "باید بزنم جزئر با خالی نازی"
    },
    {
      "id": 62,
      "start": 12588.0,
      "end": 12590.0,
      "formatted_start": "03:29:48.000",
      "formatted_end": "03:29:50.000",
      "text": "خودشم نمیبرش کنم"
    },
    {
      "id": 63,
      "start": 12590.0,
      "end": 12594.0,
      "formatted_start": "03:29:50.000",
      "formatted_end": "03:29:54.000",
      "text": "نه بابا این پرسات شد. دیروز خانه نازی آمده صحبت کرده ای"
    },
    {
      "id": 64,
      "start": 12594.0,
      "end": 12600.0,
      "formatted_start": "03:29:54.000",
      "formatted_end": "03:30:00.000",
      "text": "باز میگه دکتر بدین من دکتر حالی کنم. نه میگم بگم. حالی کنم. بگم خیلی نرم کنم"
    }
  ],
  "status": "completed"
}