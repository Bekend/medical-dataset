  "stt_segments": [
    {
      "id": 0,
      "start": 2700.0,
      "end": 2713.0,
      "formatted_start": "00:45:00.000",
      "formatted_end": "00:45:13.000",
      "text": "رنگش ترتباط با من رو میخواد یاد بگیره، کمک بگیره."
    },
    {
      "id": 1,
      "start": 2713.0,
      "end": 2721.0,
      "formatted_start": "00:45:13.000",
      "formatted_end": "00:45:21.000",
      "text": "خب، ولی اینجوری دیگه هرچی کار کنه، عرضش نمیرسه بیمارو."
    },
    {
      "id": 2,
      "start": 2721.0,
      "end": 2725.0,
      "formatted_start": "00:45:21.000",
      "formatted_end": "00:45:25.000",
      "text": "ولی بالاً کمک شما مطمئن خیلی میکنه."
    },
    {
      "id": 3,
      "start": 2725.0,
      "end": 2728.0,
      "formatted_start": "00:45:25.000",
      "formatted_end": "00:45:28.000",
      "text": "اونو گفتو که اینجوری کمکش کنیم."
    },
    {
      "id": 4,
      "start": 2728.0,
      "end": 2729.0,
      "formatted_start": "00:45:28.000",
      "formatted_end": "00:45:29.000",
      "text": "انشاءالله، انشاءالله."
    },
    {
      "id": 5,
      "start": 2729.0,
      "end": 2734.34,
      "formatted_start": "00:45:29.000",
      "formatted_end": "00:45:34.340",
      "text": "من این کار رو نمی کنم تا ببینم که چطور می شود"
    },
    {
      "id": 6,
      "start": 2734.34,
      "end": 2737.16,
      "formatted_start": "00:45:34.340",
      "formatted_end": "00:45:37.160",
      "text": "من نمایت تداشت موقعی نمی کنم که"
    },
    {
      "id": 7,
      "start": 2737.16,
      "end": 2741.4,
      "formatted_start": "00:45:37.160",
      "formatted_end": "00:45:41.400",
      "text": "بجبور این که شما این رو درگاه خود کنید"
    },
    {
      "id": 8,
      "start": 2741.4,
      "end": 2746.0,
      "formatted_start": "00:45:41.400",
      "formatted_end": "00:45:46.000",
      "text": "وگرنه اون پافایی که بهتون دادیم همه من بیرم"
    },
    {
      "id": 9,
      "start": 2746.0,
      "end": 2750.1,
      "formatted_start": "00:45:46.000",
      "formatted_end": "00:45:50.100",
      "text": "این شامپوه رو می لیسید"
    },
    {
      "id": 10,
      "start": 2750.1,
      "end": 2754.34,
      "formatted_start": "00:45:50.100",
      "formatted_end": "00:45:54.340",
      "text": "بله بله بسمه ای تالا بیه"
    },
    {
      "id": 11,
      "start": 2754.34,
      "end": 2756.0,
      "formatted_start": "00:45:54.340",
      "formatted_end": "00:45:56.000",
      "text": "رد"
    },
    {
      "id": 12,
      "start": 2756.0,
      "end": 2762.0,
      "formatted_start": "00:45:56.000",
      "formatted_end": "00:46:02.000",
      "text": "ردن سیده خیلی خوب این منیم"
    },
    {
      "id": 13,
      "start": 2762.0,
      "end": 2766.0,
      "formatted_start": "00:46:02.000",
      "formatted_end": "00:46:06.000",
      "text": "انتی شده انتی هر لازم"
    },
    {
      "id": 14,
      "start": 2766.0,
      "end": 2769.0,
      "formatted_start": "00:46:06.000",
      "formatted_end": "00:46:09.000",
      "text": "عزیز شما همه نیست"
    },
    {
      "id": 15,
      "start": 2769.0,
      "end": 2774.0,
      "formatted_start": "00:46:09.000",
      "formatted_end": "00:46:14.000",
      "text": "از از چهارصد و پنج پنج بیست و پنج ها"
    },
    {
      "id": 16,
      "start": 2774.0,
      "end": 2776.0,
      "formatted_start": "00:46:14.000",
      "formatted_end": "00:46:16.000",
      "text": "بله بله"
    },
    {
      "id": 17,
      "start": 2776.0,
      "end": 2777.0,
      "formatted_start": "00:46:16.000",
      "formatted_end": "00:46:17.000",
      "text": "چیز چیز"
    },
    {
      "id": 18,
      "start": 2777.0,
      "end": 2780.0,
      "formatted_start": "00:46:17.000",
      "formatted_end": "00:46:20.000",
      "text": "چیزی برنامه دارید دستتون در نکنه"
    },
    {
      "id": 19,
      "start": 2780.0,
      "end": 2784.0,
      "formatted_start": "00:46:20.000",
      "formatted_end": "00:46:24.000",
      "text": "چیار دارید چقدر مونده خدا میدونه از این طریقه بود"
    },
    {
      "id": 20,
      "start": 2784.0,
      "end": 2787.54,
      "formatted_start": "00:46:24.000",
      "formatted_end": "00:46:27.540",
      "text": "دستتون در اشناق شما همیشه باشید"
    },
    {
      "id": 21,
      "start": 2787.54,
      "end": 2787.8,
      "formatted_start": "00:46:27.540",
      "formatted_end": "00:46:27.800",
      "text": "دارید"
    },
    {
      "id": 22,
      "start": 2787.8,
      "end": 2787.82,
      "formatted_start": "00:46:27.800",
