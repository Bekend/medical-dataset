  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2105.0,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:05.000",
      "text": "جل روشند پرنده دو تر برده شد."
    },
    {
      "id": 1,
      "start": 2105.0,
      "end": 2109.0,
      "formatted_start": "00:35:05.000",
      "formatted_end": "00:35:09.000",
      "text": "شست شامپوریزش بود، بیس چهار تا سرون برده شد."
    },
    {
      "id": 2,
      "start": 2109.0,
      "end": 2111.0,
      "formatted_start": "00:35:09.000",
      "formatted_end": "00:35:11.000",
      "text": "جل چی چی تمنید؟"
    },
    {
      "id": 3,
      "start": 2111.0,
      "end": 2114.0,
      "formatted_start": "00:35:11.000",
      "formatted_end": "00:35:14.000",
      "text": "جل روشند پرنده باید برده شد."
    },
    {
      "id": 4,
      "start": 2114.0,
      "end": 2116.0,
      "formatted_start": "00:35:14.000",
      "formatted_end": "00:35:16.000",
      "text": "باید تنیم."
    },
    {
      "id": 5,
      "start": 2116.0,
      "end": 2119.0,
      "formatted_start": "00:35:16.000",
      "formatted_end": "00:35:19.000",
      "text": "ده تا مونده شد."
    },
    {
      "id": 6,
      "start": 2119.0,
      "end": 2121.0,
      "formatted_start": "00:35:19.000",
      "formatted_end": "00:35:21.000",
      "text": "سپنه چی تمنید؟"
    },
    {
      "id": 7,
      "start": 2121.0,
      "end": 2123.0,
      "formatted_start": "00:35:21.000",
      "formatted_end": "00:35:23.000",
      "text": "قندی نمکی."
    },
    {
      "id": 8,
      "start": 2123.0,
      "end": 2126.0,
      "formatted_start": "00:35:23.000",
      "formatted_end": "00:35:26.000",
      "text": "بله، بله، بله."
    },
    {
      "id": 9,
      "start": 2126.0,
      "end": 2130.0,
      "formatted_start": "00:35:26.000",
      "formatted_end": "00:35:30.000",
      "text": "یک جدید همون کسی که شاملی رو ریزش کرد و بیشتر کسی رو ریزش کرد"
    },
    {
      "id": 10,
      "start": 2130.0,
      "end": 2132.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:32.000",
      "text": "که ما خورد خورد داریم برای شما میرسیم"
    },
    {
      "id": 11,
      "start": 2132.0,
      "end": 2135.0,
      "formatted_start": "00:35:32.000",
      "formatted_end": "00:35:35.000",
      "text": "به ایشون هم نگفتیم که ایش اسمی نزداشت نگفتیم که"
    },
    {
      "id": 12,
      "start": 2135.0,
      "end": 2137.0,
      "formatted_start": "00:35:35.000",
      "formatted_end": "00:35:37.000",
      "text": "تریاتش رو اصطاد می کنیم"
    },
    {
      "id": 13,
      "start": 2137.0,
      "end": 2141.0,
      "formatted_start": "00:35:37.000",
      "formatted_end": "00:35:41.000",
      "text": "الان هیچ دفتر رو میرسیدیم مثلا به 6 تا 7 تا بازیم"
    },
    {
      "id": 14,
      "start": 2141.0,
      "end": 2147.0,
      "formatted_start": "00:35:41.000",
      "formatted_end": "00:35:47.000",
      "text": "نقیبا، سعی میکنیم که این کار در یه آیه ماه نیم انجام باشه که به تین مفرد داشته باشه"
    },
    {
      "id": 15,
      "start": 2147.0,
      "end": 2150.0,
      "formatted_start": "00:35:47.000",
      "formatted_end": "00:35:50.000",
      "text": "من اصلا دیر مالی فصل رو بگم"
    },
    {
      "id": 16,
      "start": 2150.0,
      "end": 2154.0,
      "formatted_start": "00:35:50.000",
      "formatted_end": "00:35:54.000",
      "text": "شما اگه خودتون باشید اگه من این نشون دارم بگم"
    },
    {
      "id": 17,
      "start": 2154.0,
      "end": 2157.0,
      "formatted_start": "00:35:54.000",
      "formatted_end": "00:35:57.000",
      "text": "این حق اولی ای اتنون بود"
    },
    {
      "id": 18,
      "start": 2157.0,
      "end": 2162.0,
      "formatted_start": "00:35:57.000",
      "formatted_end": "00:36:02.000",
      "text": "چند رو بشان سه من دیروز دو تا سه زن نمیشتم یه دوره گرفتم"
    },
    {
      "id": 19,
      "start": 2162.0,
      "end": 2166.0,
      "formatted_start": "00:36:02.000",
      "formatted_end": "00:36:06.000",
      "text": "دیروز تو همیشه"
    },
    {
      "id": 20,
      "start": 2166.0,
      "end": 2169.0,
      "formatted_start": "00:36:06.000",
      "formatted_end": "00:36:09.000",
      "text": "شما اصلا گفتم این طبیعیه"
    },
    {
      "id": 21,
      "start": 2169.0,
      "end": 2172.0,
      "formatted_start": "00:36:09.000",
      "formatted_end": "00:36:12.000",
      "text": "اولین که سه روز تعدیلی بوده چارشن و اجرایی چی بوده"
    },
    {
      "id": 22,
      "start": 2172.0,
      "end": 2175.0,
      "formatted_start": "00:36:12.000",
      "formatted_end": "00:36:15.000",
      "text": "نه بابا که سه روز تعدیلی بودش برای دیروز رو برم"
    },
    {
      "id": 23,
      "start": 2175.0,
      "end": 2179.0,
      "formatted_start": "00:36:15.000",
      "formatted_end": "00:36:19.000",
      "text": "دیروز چند تا جوش داشتن مثل ریتشون بودن باشن"
    },
    {
      "id": 24,
      "start": 2179.0,
      "end": 2181.0,
      "formatted_start": "00:36:19.000",
      "formatted_end": "00:36:21.000",
      "text": "آره باشد اتفاقا"
    },
    {
      "id": 25,
      "start": 2181.0,
      "end": 2183.0,
      "formatted_start": "00:36:21.000",
      "formatted_end": "00:36:23.000",
      "text": "ببینید این پک مادر داره"
    },
    {
      "id": 26,
      "start": 2183.0,
      "end": 2187.0,
      "formatted_start": "00:36:23.000",
      "formatted_end": "00:36:27.000",
      "text": "اینا چیزهایی که براشون اومده"
    },
    {
      "id": 27,
      "start": 2187.0,
      "end": 2189.0,
      "formatted_start": "00:36:27.000",
      "formatted_end": "00:36:29.000",
      "text": "یعنی نیازیانومی کلی اومد"
    },
    {
      "id": 28,
      "start": 2189.0,
      "end": 2193.0,
      "formatted_start": "00:36:29.000",
      "formatted_end": "00:36:33.000",
      "text": "مثلا از این ششتا اومد این مثلا نوزه ششتا مادر"
    },
    {
      "id": 29,
      "start": 2193.0,
      "end": 2197.0,
      "formatted_start": "00:36:33.000",
      "formatted_end": "00:36:37.000",
      "text": "همینه میتونم با شما صرفت کنم که اینا رو کامل کنه"
    },
    {
      "id": 30,
      "start": 2197.0,
      "end": 2200.0,
      "formatted_start": "00:36:37.000",
      "formatted_end": "00:36:40.000",
      "text": "این پک واکی من بتونم با شما حساب بداخل کنم"
    },
    {
      "id": 31,
      "start": 2200.0,
      "end": 2203.0,
      "formatted_start": "00:36:40.000",
      "formatted_end": "00:36:43.000",
      "text": "بله اینا چه فردش مادر"
    },
    {
      "id": 32,
      "start": 2203.0,
      "end": 2206.0,
      "formatted_start": "00:36:43.000",
      "formatted_end": "00:36:46.000",
      "text": "فاصله هم چقدر این سیت را کنی؟"
    },
    {
      "id": 33,
      "start": 2206.0,
      "end": 2209.0,
      "formatted_start": "00:36:46.000",
      "formatted_end": "00:36:49.000",
      "text": "این ها اومده"
    },
    {
      "id": 34,
      "start": 2209.0,
      "end": 2212.0,
      "formatted_start": "00:36:49.000",
      "formatted_end": "00:36:52.000",
      "text": "این ها خودی شما هست"
    },
    {
      "id": 35,
      "start": 2212.0,
      "end": 2215.0,
      "formatted_start": "00:36:52.000",
      "formatted_end": "00:36:55.000",
      "text": "میخواییم بیاره به داروخونه"
    },
    {
      "id": 36,
      "start": 2215.0,
      "end": 2218.0,
      "formatted_start": "00:36:55.000",
      "formatted_end": "00:36:58.000",
      "text": "نه نه سیت اصلا اومده در داروخونه نشسته"
    },
    {
      "id": 37,
      "start": 2218.0,
      "end": 2221.0,
      "formatted_start": "00:36:58.000",
      "formatted_end": "00:37:01.000",
      "text": "یعنی سیت اومده هشت در نیمی؟"
    },
    {
      "id": 38,
      "start": 2221.0,
      "end": 2224.0,
      "formatted_start": "00:37:01.000",
      "formatted_end": "00:37:04.000",
      "text": "بله بله این رو من گفتم از خوردادان"
    },
    {
      "id": 39,
      "start": 2224.0,
      "end": 2227.0,
      "formatted_start": "00:37:04.000",
      "formatted_end": "00:37:07.000",
      "text": "یعنی از همین تاریخ رو بخواهم"
    },
    {
      "id": 40,
      "start": 2227.0,
      "end": 2230.0,
      "formatted_start": "00:37:07.000",
      "formatted_end": "00:37:10.000",
      "text": "من بدونم در کل از اون تاریخ که من بشه باشم باید گرم"
    },
    {
      "id": 41,
      "start": 2230.0,
      "end": 2232.82,
      "formatted_start": "00:37:10.000",
      "formatted_end": "00:37:12.820",
      "text": "30 داشت اومده یعنی مثلا 6 داشت با من مونده"
    },
    {
      "id": 42,
      "start": 2232.82,
      "end": 2235.58,
      "formatted_start": "00:37:12.820",
      "formatted_end": "00:37:15.580",
      "text": "این نوع اعتماد اصلا نمی اومد"
    },
    {
      "id": 43,
      "start": 2235.58,
      "end": 2238.54,
      "formatted_start": "00:37:15.580",
      "formatted_end": "00:37:18.540",
      "text": "این اعتماد ها یه مدت کسری بوده"
    },
    {
      "id": 44,
      "start": 2238.54,
      "end": 2241.64,
      "formatted_start": "00:37:18.540",
      "formatted_end": "00:37:21.640",
      "text": "ولی من با در اون صحبت رو هم پس این درگازت ها بگیریم"
    },
    {
      "id": 45,
      "start": 2241.64,
      "end": 2244.14,
      "formatted_start": "00:37:21.640",
      "formatted_end": "00:37:24.140",
      "text": "مثلا 6 داره اینو بگیریم 6 داره اینو بگیریم"
    },
    {
      "id": 46,
      "start": 2244.14,
      "end": 2246.8,
      "formatted_start": "00:37:24.140",
      "formatted_end": "00:37:26.800",
      "text": "که این پکتر نیاسی نیاسی نیاسی نیاسی کامل کردید"
    },
    {
      "id": 47,
      "start": 2246.8,
      "end": 2249.52,
      "formatted_start": "00:37:26.800",
      "formatted_end": "00:37:29.520",
      "text": "و اینکه مثلا نیاسی خوب چه داره"
    },
    {
      "id": 48,
      "start": 2249.52,
      "end": 2250.56,
      "formatted_start": "00:37:29.520",
      "formatted_end": "00:37:30.560",
      "text": "میشه داره میشه داره"
    },
    {
      "id": 49,
      "start": 2250.56,
      "end": 2253.22,
      "formatted_start": "00:37:30.560",
      "formatted_end": "00:37:33.220",
      "text": "بله بله از اون طایق ما 48 نیاسی"
    },
    {
      "id": 50,
      "start": 2253.22,
      "end": 2256.22,
      "formatted_start": "00:37:33.220",
      "formatted_end": "00:37:36.220",
      "text": "انا میگه اینجا چند تا مونده؟ بسرون میاسیده"
    },
    {
      "id": 51,
      "start": 2257.22,
      "end": 2258.22,
      "formatted_start": "00:37:37.220",
      "formatted_end": "00:37:38.220",
      "text": "شش تا مونده"
    },
    {
      "id": 52,
      "start": 2258.22,
      "end": 2259.22,
      "formatted_start": "00:37:38.220",
      "formatted_end": "00:37:39.220",
      "text": "چه دوتا مونده؟"
    },
    {
      "id": 53,
      "start": 2259.22,
      "end": 2260.22,
      "formatted_start": "00:37:39.220",
      "formatted_end": "00:37:40.220",
      "text": "آب سو دوتا"
    },
    {
      "id": 54,
      "start": 2266.22,
      "end": 2268.22,
      "formatted_start": "00:37:46.220",
      "formatted_end": "00:37:48.220",
      "text": "بعد این را چقدر میدن؟"
    },
    {
      "id": 55,
      "start": 2270.22,
      "end": 2274.22,
      "formatted_start": "00:37:50.220",
      "formatted_end": "00:37:54.220",
      "text": "آیا تو این پاکترون مزبغ اشتغال بوده؟"
    },
    {
      "id": 56,
      "start": 2274.22,
      "end": 2276.22,
      "formatted_start": "00:37:54.220",
      "formatted_end": "00:37:56.220",
      "text": "نه نه نه نقصه اشتغالش داره"
    },
    {
      "id": 57,
      "start": 2278.22,
      "end": 2279.22,
      "formatted_start": "00:37:58.220",
      "formatted_end": "00:37:59.220",
      "text": "چرا؟"
    },
    {
      "id": 58,
      "start": 2279.22,
      "end": 2292.22,
      "formatted_start": "00:37:59.220",
      "formatted_end": "00:38:12.220",
      "text": "ازش رسومت ستومند، فکر می کنم که یک درست تومند یا بیست تومند یا همچین چیزی بود آقای رو کنیم."
    },
    {
      "id": 59,
      "start": 2292.22,
      "end": 2297.22,
      "formatted_start": "00:38:12.220",
      "formatted_end": "00:38:17.220",
      "text": "من تو اون رسومت رو داشتم، تو این ندارم اون رسومت رو داشتم. نه، ما همچنان،"
    },
    {
      "id": 60,
      "start": 2297.22,
      "end": 2302.22,
      "formatted_start": "00:38:17.220",
      "formatted_end": "00:38:22.220",
      "text": "این رسومتش یک حد باید شدن داشتیم که قیمت همسایش گریه دا کرده بود."
    },
    {
      "id": 61,
      "start": 2302.22,
      "end": 2305.54,
      "formatted_start": "00:38:22.220",
      "formatted_end": "00:38:25.540",
      "text": "اینکه این تاییم بسیاری دامون رو برده چون قیمت افزایشی هده بود"
    },
    {
      "id": 62,
      "start": 2305.54,
      "end": 2309.74,
      "formatted_start": "00:38:25.540",
      "formatted_end": "00:38:29.740",
      "text": "افزایش برده بود و برای حساس همین درصد 24 همون برده میخویم"
    },
    {
      "id": 63,
      "start": 2309.74,
      "end": 2315.42,
      "formatted_start": "00:38:29.740",
      "formatted_end": "00:38:35.420",
      "text": "یعنی هر وقت ما افزایش قیمت داشته باشیم تو این اداده بیشتری شده باشه ما"
    },
    {
      "id": 64,
      "start": 2315.42,
      "end": 2318.14,
      "formatted_start": "00:38:35.420",
      "formatted_end": "00:38:38.140",
      "text": "تا که شما رو برای منصوب بیشتری کنیم"
    },
    {
      "id": 65,
      "start": 2318.14,
      "end": 2320.3,
      "formatted_start": "00:38:38.140",
      "formatted_end": "00:38:40.300",
      "text": "این اصلا چیز نداره بود"
    },
    {
      "id": 66,
      "start": 2320.3,
      "end": 2321.74,
      "formatted_start": "00:38:40.300",
      "formatted_end": "00:38:41.740",
      "text": "بسیار برده بود"
    },
    {
      "id": 67,
      "start": 2321.74,
      "end": 2322.9,
      "formatted_start": "00:38:41.740",
      "formatted_end": "00:38:42.900",
      "text": "بسیار برده بود"
    },
    {
      "id": 68,
      "start": 2322.9,
      "end": 2323.66,
      "formatted_start": "00:38:42.900",
      "formatted_end": "00:38:43.660",
      "text": "خیلی؟"
    },
    {
      "id": 69,
      "start": 2323.66,
      "end": 2327.66,
      "formatted_start": "00:38:43.660",
      "formatted_end": "00:38:47.660",
      "text": "هر کار چیزی که اضافه شده هم با این میتونن بفهمن دیگه"
    },
    {
      "id": 70,
      "start": 2327.66,
      "end": 2331.66,
      "formatted_start": "00:38:47.660",
      "formatted_end": "00:38:51.660",
      "text": "اگه هر چیزی که بکنم شما بیارین"
    },
    {
      "id": 71,
      "start": 2331.66,
      "end": 2335.66,
      "formatted_start": "00:38:51.660",
      "formatted_end": "00:38:55.660",
      "text": "بگید چون مثلا مقدار نوشتنش"
    },
    {
      "id": 72,
      "start": 2335.66,
      "end": 2339.66,
      "formatted_start": "00:38:55.660",
      "formatted_end": "00:38:59.660",
      "text": "زیادگوده ما برای این اساس"
    },
    {
      "id": 73,
      "start": 2339.66,
      "end": 2343.66,
      "formatted_start": "00:38:59.660",
      "formatted_end": "00:39:03.660",
      "text": "سران 6 تا بی 8 تا دیگه بزاریم شما او هم میتونه از این تخفیف"
    },
    {
      "id": 74,
      "start": 2343.66,
      "end": 2347.66,
      "formatted_start": "00:39:03.660",
      "formatted_end": "00:39:07.660",
      "text": "برخوردار بشه"
    },
    {
      "id": 75,
      "start": 2347.66,
      "end": 2351.66,
      "formatted_start": "00:39:07.660",
      "formatted_end": "00:39:11.660",
      "text": "چیزش هم میگه در درازده یک میده"
    },
    {
      "id": 76,
      "start": 2351.66,
      "end": 2357.66,
      "formatted_start": "00:39:11.660",
      "formatted_end": "00:39:17.660",
      "text": "این رو باید میدونیم. در حالت عادی ممکنه که شما از ما فرمیدونید."
    },
    {
      "id": 77,
      "start": 2357.66,
      "end": 2358.66,
      "formatted_start": "00:39:17.660",
      "formatted_end": "00:39:18.660",
      "text": "حالا چند میدونید؟"
    },
    {
      "id": 78,
      "start": 2358.66,
      "end": 2363.66,
      "formatted_start": "00:39:18.660",
      "formatted_end": "00:39:23.660",
      "text": "۱۲۰۰ فرمیدونید. یعنی بابت تکی هم بمیدونید ۱۲۰۰ فرمیدونید."
    },
    {
      "id": 79,
      "start": 2363.66,
      "end": 2369.66,
      "formatted_start": "00:39:23.660",
      "formatted_end": "00:39:29.660",
      "text": "نه، نگاه رو خواهید کسان باز بگو کنه که اگر نگیره، از همون چیزش از دستش میره."
    },
    {
      "id": 80,
      "start": 2369.66,
      "end": 2375.66,
      "formatted_start": "00:39:29.660",
      "formatted_end": "00:39:35.660",
      "text": "اینطوری فکر میکنم، این اشعاب هایش داره این زرد یک مادت کتاب هم باید شما این رو می نویسید، می توانید شما رو بشه"
    },
    {
      "id": 81,
      "start": 2375.66,
      "end": 2384.66,
      "formatted_start": "00:39:35.660",
      "formatted_end": "00:39:44.660",
      "text": "چند سال پیش که تازه اومده بود، اصلا حساب کتاب نمی بودست"
    },
    {
      "id": 82,
      "start": 2384.66,
      "end": 2390.66,
      "formatted_start": "00:39:44.660",
      "formatted_end": "00:39:50.660",
      "text": "خب، بعد بیشتر بازی میکرد، بازی های قاپیتری، حلاق منده"
    },
    {
      "id": 83,
      "start": 2390.66,
      "end": 2396.66,
      "formatted_start": "00:39:50.660",
      "formatted_end": "00:39:56.660",
      "text": "بعد شدت همه رو بازی های قاپیتری، خیلی هم مهارت داره"
    },
    {
      "id": 84,
      "start": 2396.66,
      "end": 2400.0,
      "formatted_start": "00:39:56.660",
      "formatted_end": "00:40:00.000",
      "text": "بهتر از هر تعمیر کار پاکیشه را"
    }
  ],
  "status": "completed"
}