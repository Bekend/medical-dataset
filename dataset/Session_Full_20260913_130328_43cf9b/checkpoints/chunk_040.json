  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12004.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:04.000",
      "text": "روی کفیت تاثیر چندانی نداشته."
    },
    {
      "id": 1,
      "start": 12007.0,
      "end": 12014.0,
      "formatted_start": "03:20:07.000",
      "formatted_end": "03:20:14.000",
      "text": "و روی تعداد، تعداد شیش میلیون، تعداد قبلی، بیشتر میلیون."
    },
    {
      "id": 2,
      "start": 12014.0,
      "end": 12021.0,
      "formatted_start": "03:20:14.000",
      "formatted_end": "03:20:21.000",
      "text": "یک کاری کردید که از این اثر منفی گذاشته."
    },
    {
      "id": 3,
      "start": 12022.0,
      "end": 12025.0,
      "formatted_start": "03:20:22.000",
      "formatted_end": "03:20:25.000",
      "text": "با درنامه چیز مصرفتون می آورد چیزی؟"
    },
    {
      "id": 4,
      "start": 12025.0,
      "end": 12031.0,
      "formatted_start": "03:20:25.000",
      "formatted_end": "03:20:31.000",
      "text": "یا محیط خیلی گرمه، ببین بیزر باید خنک بشه"
    },
    {
      "id": 5,
      "start": 12031.0,
      "end": 12035.0,
      "formatted_start": "03:20:31.000",
      "formatted_end": "03:20:35.000",
      "text": "خدافرد بیزر بیرون بذاشته که سی درجه باشه در مشکل"
    },
    {
      "id": 6,
      "start": 12035.0,
      "end": 12041.0,
      "formatted_start": "03:20:35.000",
      "formatted_end": "03:20:41.000",
      "text": "بدن سی و هفت درجه است، کفه چه برژه است بیزر باید سی درجه بشه"
    },
    {
      "id": 7,
      "start": 12041.0,
      "end": 12043.0,
      "formatted_start": "03:20:41.000",
      "formatted_end": "03:20:43.000",
      "text": "این رادیاتوری باید بذاشته باشه بیرون"
    },
    {
      "id": 8,
      "start": 12043.0,
      "end": 12049.0,
      "formatted_start": "03:20:43.000",
      "formatted_end": "03:20:49.000",
      "text": "این وقتی گرم می کنه فاریتش کم می شه"
    },
    {
      "id": 9,
      "start": 12049.0,
      "end": 12053.0,
      "formatted_start": "03:20:49.000",
      "formatted_end": "03:20:53.000",
      "text": "می گن یک کاسه بگیر چوننگ آب بذارید داخلش آب آرام آرام بیار"
    },
    {
      "id": 10,
      "start": 12053.0,
      "end": 12055.0,
      "formatted_start": "03:20:53.000",
      "formatted_end": "03:20:55.000",
      "text": "بیزه رو بزرگ داخل اینکه باز"
    },
    {
      "id": 11,
      "start": 12055.0,
      "end": 12057.0,
      "formatted_start": "03:20:55.000",
      "formatted_end": "03:20:57.000",
      "text": "روزی سه مرتبه"
    },
    {
      "id": 12,
      "start": 12057.0,
      "end": 12059.0,
      "formatted_start": "03:20:57.000",
      "formatted_end": "03:20:59.000",
      "text": "هر دفعه پنج دقیقه بیزه ها رو خنک کنید"
    },
    {
      "id": 13,
      "start": 12059.0,
      "end": 12061.0,
      "formatted_start": "03:20:59.000",
      "formatted_end": "03:21:01.000",
      "text": "دار"
    },
    {
      "id": 14,
      "start": 12061.0,
      "end": 12063.0,
      "formatted_start": "03:21:01.000",
      "formatted_end": "03:21:03.000",
      "text": "حتی کلر بیزه هم درست کردن"
    },
    {
      "id": 15,
      "start": 12063.0,
      "end": 12065.0,
      "formatted_start": "03:21:03.000",
      "formatted_end": "03:21:05.000",
      "text": "خارج از کشور"
    },
    {
      "id": 16,
      "start": 12065.0,
      "end": 12067.0,
      "formatted_start": "03:21:05.000",
      "formatted_end": "03:21:07.000",
      "text": "سببیه که"
    },
    {
      "id": 17,
      "start": 12067.0,
      "end": 12069.0,
      "formatted_start": "03:21:07.000",
      "formatted_end": "03:21:09.000",
      "text": "یخ میشه کلرش رو کمان بیبندند"
    },
    {
      "id": 18,
      "start": 12069.0,
      "end": 12071.0,
      "formatted_start": "03:21:09.000",
      "formatted_end": "03:21:11.000",
      "text": "بیزه رو دائم خنک می کنید تا خواهد بشه"
    },
    {
      "id": 19,
      "start": 12071.0,
      "end": 12073.0,
      "formatted_start": "03:21:11.000",
      "formatted_end": "03:21:13.000",
      "text": "بیزه با گرما"
    },
    {
      "id": 20,
      "start": 12073.0,
      "end": 12075.0,
      "formatted_start": "03:21:13.000",
      "formatted_end": "03:21:15.000",
      "text": "کمکار میشه"
    },
    {
      "id": 21,
      "start": 12075.0,
      "end": 12077.0,
      "formatted_start": "03:21:15.000",
      "formatted_end": "03:21:17.000",
      "text": "با سرما هم پرکار میشه"
    },
    {
      "id": 22,
      "start": 12077.0,
      "end": 12079.0,
      "formatted_start": "03:21:17.000",
      "formatted_end": "03:21:19.000",
      "text": "باید بیزه دائم خنک بشه"
    },
    {
      "id": 23,
      "start": 12079.0,
      "end": 12081.0,
      "formatted_start": "03:21:19.000",
      "formatted_end": "03:21:21.000",
      "text": "بیزه ها خیلی گرم میشه"
    },
    {
      "id": 24,
      "start": 12081.0,
      "end": 12083.0,
      "formatted_start": "03:21:21.000",
      "formatted_end": "03:21:23.000",
      "text": "آره"
    },
    {
      "id": 25,
      "start": 12083.0,
      "end": 12085.0,
      "formatted_start": "03:21:23.000",
      "formatted_end": "03:21:25.000",
      "text": "دست میسنید مثلا میدین که داقه"
    },
    {
      "id": 26,
      "start": 12085.0,
      "end": 12087.0,
      "formatted_start": "03:21:25.000",
      "formatted_end": "03:21:27.000",
      "text": "بیزه نباید داقه شد"
    },
    {
      "id": 27,
      "start": 12087.0,
      "end": 12089.0,
      "formatted_start": "03:21:27.000",
      "formatted_end": "03:21:29.000",
      "text": "این داقی"
    },
    {
      "id": 28,
      "start": 12089.0,
      "end": 12091.0,
      "formatted_start": "03:21:29.000",
      "formatted_end": "03:21:31.000",
      "text": "چیز میکنه"
    },
    {
      "id": 29,
      "start": 12091.0,
      "end": 12093.0,
      "formatted_start": "03:21:31.000",
      "formatted_end": "03:21:33.000",
      "text": "دارس که"
    },
    {
      "id": 30,
      "start": 12093.0,
      "end": 12095.0,
      "formatted_start": "03:21:33.000",
      "formatted_end": "03:21:35.000",
      "text": "اوه اوه اوه اوه"
    },
    {
      "id": 31,
      "start": 12095.0,
      "end": 12097.0,
      "formatted_start": "03:21:35.000",
      "formatted_end": "03:21:37.000",
      "text": "اوه اوه اوه"
    },
    {
      "id": 32,
      "start": 12097.0,
      "end": 12099.0,
      "formatted_start": "03:21:37.000",
      "formatted_end": "03:21:39.000",
      "text": "اوه اوه"
    },
    {
      "id": 33,
      "start": 12099.0,
      "end": 12101.0,
      "formatted_start": "03:21:39.000",
      "formatted_end": "03:21:41.000",
      "text": "اوه اوه"
    },
    {
      "id": 34,
      "start": 12101.0,
      "end": 12103.0,
      "formatted_start": "03:21:41.000",
      "formatted_end": "03:21:43.000",
      "text": "اوه اوه"
    },
    {
      "id": 35,
      "start": 12103.0,
      "end": 12105.0,
      "formatted_start": "03:21:43.000",
      "formatted_end": "03:21:45.000",
      "text": "اوه اوه"
    },
    {
      "id": 36,
      "start": 12105.0,
      "end": 12107.0,
      "formatted_start": "03:21:45.000",
      "formatted_end": "03:21:47.000",
      "text": "اوه"
    },
    {
      "id": 37,
      "start": 12107.0,
      "end": 12109.0,
      "formatted_start": "03:21:47.000",
      "formatted_end": "03:21:49.000",
      "text": "اما شما خنک می کنید."
    },
    {
      "id": 38,
      "start": 12109.0,
      "end": 12111.0,
      "formatted_start": "03:21:49.000",
      "formatted_end": "03:21:51.000",
      "text": "اینکه از این چیزی که می گوییم"
    },
    {
      "id": 39,
      "start": 12111.0,
      "end": 12113.0,
      "formatted_start": "03:21:51.000",
      "formatted_end": "03:21:53.000",
      "text": "بالاترین به تخصیص ایران"
    },
    {
      "id": 40,
      "start": 12113.0,
      "end": 12115.0,
      "formatted_start": "03:21:53.000",
      "formatted_end": "03:21:55.000",
      "text": "امای دکتر"
    },
    {
      "id": 41,
      "start": 12115.0,
      "end": 12117.0,
      "formatted_start": "03:21:55.000",
      "formatted_end": "03:21:57.000",
      "text": "اقصای دستور بی ما می داد"
    },
    {
      "id": 42,
      "start": 12117.0,
      "end": 12119.0,
      "formatted_start": "03:21:57.000",
      "formatted_end": "03:21:59.000",
      "text": "می گفت که کاسر بگیرند"
    },
    {
      "id": 43,
      "start": 12119.0,
      "end": 12121.0,
      "formatted_start": "03:21:59.000",
      "formatted_end": "03:22:01.000",
      "text": "شننگ آوان بذارند توش"
    },
    {
      "id": 44,
      "start": 12121.0,
      "end": 12123.0,
      "formatted_start": "03:22:01.000",
      "formatted_end": "03:22:03.000",
      "text": "آب خنک بیاد"
    },
    {
      "id": 45,
      "start": 12123.0,
      "end": 12125.0,
      "formatted_start": "03:22:03.000",
      "formatted_end": "03:22:05.000",
      "text": "و بیزشون توی آب بوتبر کنند"
    },
    {
      "id": 46,
      "start": 12125.0,
      "end": 12127.0,
      "formatted_start": "03:22:05.000",
      "formatted_end": "03:22:07.000",
      "text": "اینکه درمون فوق و فوق"
    },
    {
      "id": 47,
      "start": 12127.0,
      "end": 12129.0,
      "formatted_start": "03:22:07.000",
      "formatted_end": "03:22:09.000",
      "text": "درخصوص هایی رو دارند می گویید."
    },
    {
      "id": 48,
      "start": 12129.0,
      "end": 12131.0,
      "formatted_start": "03:22:09.000",
      "formatted_end": "03:22:11.000",
      "text": "تو زن شما یکی"
    },
    {
      "id": 49,
      "start": 12131.0,
      "end": 12133.0,
      "formatted_start": "03:22:11.000",
      "formatted_end": "03:22:13.000",
      "text": "فوق درخصوص هست که"
    },
    {
      "id": 50,
      "start": 12133.0,
      "end": 12135.0,
      "formatted_start": "03:22:13.000",
      "formatted_end": "03:22:15.000",
      "text": "آبخول ها خود بده دیگه"
    },
    {
      "id": 51,
      "start": 12135.0,
      "end": 12145.0,
      "formatted_start": "03:22:15.000",
      "formatted_end": "03:22:25.000",
      "text": "یکی میدونی که یک سیم از در این گال مرخی بسیار بشه و بدن همه اشکالاتش برطرف میشه"
    },
    {
      "id": 52,
      "start": 12145.0,
      "end": 12148.0,
      "formatted_start": "03:22:25.000",
      "formatted_end": "03:22:28.000",
      "text": "مشکل رادیاتور خیلی مشکل مهم نیست"
    },
    {
      "id": 53,
      "start": 12148.0,
      "end": 12155.0,
      "formatted_start": "03:22:28.000",
      "formatted_end": "03:22:35.000",
      "text": "باشر زدن نمیدونی که تمام خرابه ماشین از اینه که تمام خوب جا به جا نمیشه"
    },
    {
      "id": 54,
      "start": 12155.0,
      "end": 12159.0,
      "formatted_start": "03:22:35.000",
      "formatted_end": "03:22:39.000",
      "text": "یکی میبینید که نه، موتور رو خیلی سرد می کنید و سختش میره بالا"
    },
    {
      "id": 55,
      "start": 12159.0,
      "end": 12162.0,
      "formatted_start": "03:22:39.000",
      "formatted_end": "03:22:42.000",
      "text": "بعضی موتور طبیعتش گرده"
    },
    {
      "id": 56,
      "start": 12162.0,
      "end": 12166.0,
      "formatted_start": "03:22:42.000",
      "formatted_end": "03:22:46.000",
      "text": "ما باید بیزه رو خنک کنیم، کبد رو گرم کنیم."
    },
    {
      "id": 57,
      "start": 12166.0,
      "end": 12175.0,
      "formatted_start": "03:22:46.000",
      "formatted_end": "03:22:55.000",
      "text": "و عکس، بعضی داروهایی که میدن بیزه رو خنک کنن از اونوری کبد هم خنک می کنه، این کار خراب میشه."
    },
    {
      "id": 58,
      "start": 12175.0,
      "end": 12184.0,
      "formatted_start": "03:22:55.000",
      "formatted_end": "03:23:04.000",
      "text": "هنو برها این کاری که اینجا اینجا باید بدیم، باعث دائم بیزه رو موضعی سرد داریم."
    },
    {
      "id": 59,
      "start": 12184.0,
      "end": 12191.0,
      "formatted_start": "03:23:04.000",
      "formatted_end": "03:23:11.000",
      "text": "هم داروی گیاهی بهت میدن، هم داروی شیوگاهی، بله اینکه الان شما ندارد چیزی ندارد که شما ندارد."
    },
    {
      "id": 60,
      "start": 12191.0,
      "end": 12191.5,
      "formatted_start": "03:23:11.000",
      "formatted_end": "03:23:11.500",
      "text": "نه"
    },
    {
      "id": 61,
      "start": 12196.5,
      "end": 12199.0,
      "formatted_start": "03:23:16.500",
      "formatted_end": "03:23:19.000",
      "text": "دیروز دارو نوشتم تو برگه برای چون؟"
    },
    {
      "id": 62,
      "start": 12200.0,
      "end": 12201.0,
      "formatted_start": "03:23:20.000",
      "formatted_end": "03:23:21.000",
      "text": "برگه نوشتم برای؟"
    },
    {
      "id": 63,
      "start": 12201.0,
      "end": 12202.0,
      "formatted_start": "03:23:21.000",
      "formatted_end": "03:23:22.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 64,
      "start": 12202.5,
      "end": 12203.5,
      "formatted_start": "03:23:22.500",
      "formatted_end": "03:23:23.500",
      "text": "دارو نوشتم؟"
    },
    {
      "id": 65,
      "start": 12203.5,
      "end": 12205.0,
      "formatted_start": "03:23:23.500",
      "formatted_end": "03:23:25.000",
      "text": "آره نوشتی برای برگه برای چون؟"
    },
    {
      "id": 66,
      "start": 12205.0,
      "end": 12205.5,
      "formatted_start": "03:23:25.000",
      "formatted_end": "03:23:25.500",
      "text": "نه خریدی؟"
    },
    {
      "id": 67,
      "start": 12205.5,
      "end": 12206.0,
      "formatted_start": "03:23:25.500",
      "formatted_end": "03:23:26.000",
      "text": "چرا خریدی؟"
    },
    {
      "id": 68,
      "start": 12206.0,
      "end": 12207.0,
      "formatted_start": "03:23:26.000",
      "formatted_end": "03:23:27.000",
      "text": "خریدی؟ خریدی؟"
    },
    {
      "id": 69,
      "start": 12207.0,
      "end": 12207.5,
      "formatted_start": "03:23:27.000",
      "formatted_end": "03:23:27.500",
      "text": "خریدی"
    },
    {
      "id": 70,
      "start": 12208.0,
      "end": 12210.5,
      "formatted_start": "03:23:28.000",
      "formatted_end": "03:23:30.500",
      "text": "آقای بخمن یلوی بود؟"
    },
    {
      "id": 71,
      "start": 12211.0,
      "end": 12211.5,
      "formatted_start": "03:23:31.000",
      "formatted_end": "03:23:31.500",
      "text": "بله"
    },
    {
      "id": 72,
      "start": 12211.5,
      "end": 12213.5,
      "formatted_start": "03:23:31.500",
      "formatted_end": "03:23:33.500",
      "text": "علت اینکه نیاوردی چیه؟"
    },
    {
      "id": 73,
      "start": 12214.0,
      "end": 12214.5,
      "formatted_start": "03:23:34.000",
      "formatted_end": "03:23:34.500",
      "text": "خرابش کردی؟"
    },
    {
      "id": 74,
      "start": 12214.5,
      "end": 12217.0,
      "formatted_start": "03:23:34.500",
      "formatted_end": "03:23:37.000",
      "text": "دیروز کلاس دارم، برگه نوشتم"
    },
    {
      "id": 75,
      "start": 12217.0,
      "end": 12219.5,
      "formatted_start": "03:23:37.000",
      "formatted_end": "03:23:39.500",
      "text": "دیروز آزمایش هم اشتباه داد، آبه داد"
    },
    {
      "id": 76,
      "start": 12219.5,
      "end": 12222.5,
      "formatted_start": "03:23:39.500",
      "formatted_end": "03:23:42.500",
      "text": "آزمایش سه ماه پیش ماه داده بود"
    },
    {
      "id": 77,
      "start": 12222.5,
      "end": 12225.5,
      "formatted_start": "03:23:42.500",
      "formatted_end": "03:23:45.500",
      "text": "تو پریند، تاریکشو نگاه نکرده پریند تا زده دیگه؟"
    },
    {
      "id": 78,
      "start": 12225.5,
      "end": 12226.5,
      "formatted_start": "03:23:45.500",
      "formatted_end": "03:23:46.500",
      "text": "آره"
    },
    {
      "id": 79,
      "start": 12226.5,
      "end": 12231.5,
      "formatted_start": "03:23:46.500",
      "formatted_end": "03:23:51.500",
      "text": "اشتباهات اینجوری اشتباهات قابل انتظار هستن"
    },
    {
      "id": 80,
      "start": 12231.5,
      "end": 12234.5,
      "formatted_start": "03:23:51.500",
      "formatted_end": "03:23:54.500",
      "text": "میدونی؟ تو اینجور نگاه میکنه اسپتره را داخته"
    },
    {
      "id": 81,
      "start": 12234.5,
      "end": 12236.5,
      "formatted_start": "03:23:54.500",
      "formatted_end": "03:23:56.500",
      "text": "پاید پریند تاریکشو هم نگاه کنه دیگه"
    },
    {
      "id": 82,
      "start": 12236.5,
      "end": 12239.5,
      "formatted_start": "03:23:56.500",
      "formatted_end": "03:23:59.500",
      "text": "بگو بگو بگذاره این پریند میشه، فقط باشه غفلی بود"
    },
    {
      "id": 83,
      "start": 12239.5,
      "end": 12241.5,
      "formatted_start": "03:23:59.500",
      "formatted_end": "03:24:01.500",
      "text": "بردان راه نه، تو دو چیز تغییر میکنی؟"
    },
    {
      "id": 84,
      "start": 12241.5,
      "end": 12244.74,
      "formatted_start": "03:24:01.500",
      "formatted_end": "03:24:04.740",
      "text": "بله، بخواهید با یک داروی بطر بود تا یک گرمایی آزده شد و بشیشت"
    },
    {
      "id": 85,
      "start": 12244.74,
      "end": 12248.38,
      "formatted_start": "03:24:04.740",
      "formatted_end": "03:24:08.380",
      "text": "بله، به خاطر گرمای خواه هم روی این تاثیر مقبول بود"
    },
    {
      "id": 86,
      "start": 12248.38,
      "end": 12250.38,
      "formatted_start": "03:24:08.380",
      "formatted_end": "03:24:10.380",
      "text": "بازه، مثلا ما بطره"
    },
    {
      "id": 87,
      "start": 12250.38,
      "end": 12258.22,
      "formatted_start": "03:24:10.380",
      "formatted_end": "03:24:18.220",
      "text": "کپسول آنت، روست، سی تا، الان شما با آر خنک بکنید دروره بزنید"
    },
    {
      "id": 88,
      "start": 12258.22,
      "end": 12259.22,
      "formatted_start": "03:24:18.220",
      "formatted_end": "03:24:19.220",
      "text": "این کپسول..."
    },
    {
      "id": 89,
      "start": 12259.22,
      "end": 12264.34,
      "formatted_start": "03:24:19.220",
      "formatted_end": "03:24:24.340",
      "text": "آبادو شما چرا باید تخیل میدازم؟ من هم اینوز بسیار درورتونم، با شش روز تخیل میشم"
    },
    {
      "id": 90,
      "start": 12264.34,
      "end": 12266.82,
      "formatted_start": "03:24:24.340",
      "formatted_end": "03:24:26.820",
      "text": "با شش روز تخیل، که شروع شد؟"
    },
    {
      "id": 91,
      "start": 12266.82,
      "end": 12271.82,
      "formatted_start": "03:24:26.820",
      "formatted_end": "03:24:31.820",
      "text": "امروز صبح داروی ویروس چی دادن؟"
    },
    {
      "id": 92,
      "start": 12271.82,
      "end": 12272.82,
      "formatted_start": "03:24:31.820",
      "formatted_end": "03:24:32.820",
      "text": "داروی مختلف"
    },
    {
      "id": 93,
      "start": 12272.82,
      "end": 12274.82,
      "formatted_start": "03:24:32.820",
      "formatted_end": "03:24:34.820",
      "text": "تا آزمایش نمیشتم؟"
    },
    {
      "id": 94,
      "start": 12274.82,
      "end": 12275.82,
      "formatted_start": "03:24:34.820",
      "formatted_end": "03:24:35.820",
      "text": "آزمایش چند بود؟"
    },
    {
      "id": 95,
      "start": 12275.82,
      "end": 12276.82,
      "formatted_start": "03:24:35.820",
      "formatted_end": "03:24:36.820",
      "text": "چارده بود؟"
    },
    {
      "id": 96,
      "start": 12276.82,
      "end": 12278.82,
      "formatted_start": "03:24:36.820",
      "formatted_end": "03:24:38.820",
      "text": "چند بود که من برس دارم"
    },
    {
      "id": 97,
      "start": 12278.82,
      "end": 12279.82,
      "formatted_start": "03:24:38.820",
      "formatted_end": "03:24:39.820",
      "text": "چند برس دارم، که برس دارم"
    },
    {
      "id": 98,
      "start": 12279.82,
      "end": 12280.82,
      "formatted_start": "03:24:39.820",
      "formatted_end": "03:24:40.820",
      "text": "چند برس دارم، که برس دارم، که برس دارم"
    },
    {
      "id": 99,
      "start": 12280.82,
      "end": 12281.82,
      "formatted_start": "03:24:40.820",
      "formatted_end": "03:24:41.820",
      "text": "چند برس دارم، که برس دارم"
    },
    {
      "id": 100,
      "start": 12281.82,
      "end": 12282.82,
      "formatted_start": "03:24:41.820",
      "formatted_end": "03:24:42.820",
      "text": "چند برس دارم، که برس دارم"
    },
    {
      "id": 101,
      "start": 12282.82,
      "end": 12283.82,
      "formatted_start": "03:24:42.820",
      "formatted_end": "03:24:43.820",
      "text": "چند برس دارم، که برس دارم"
    },
    {
      "id": 102,
      "start": 12283.82,
      "end": 12284.82,
      "formatted_start": "03:24:43.820",
      "formatted_end": "03:24:44.820",
      "text": "چند برس دارم، که برس دارم"
    },
    {
      "id": 103,
      "start": 12284.82,
      "end": 12285.82,
      "formatted_start": "03:24:44.820",
      "formatted_end": "03:24:45.820",
      "text": "چند برس دارم، که برس دارم"
    }
  ],
  "status": "completed"
}