  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10216.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:16.000",
      "text": "در دیابتی ها که مجرد قطعه ها میشه، در افرادی که دیابت ندارن هم میتونه آقسه بده. این صوره بین دو لایه است. یه لایه پوشتی رو پادردیم، یه لایه پوست زخیمی."
    },
    {
      "id": 1,
      "start": 10216.0,
      "end": 10219.24,
      "formatted_start": "02:50:16.000",
      "formatted_end": "02:50:19.240",
      "text": "این بین این دوتا یک قایی وجود داره"
    },
    {
      "id": 2,
      "start": 10219.24,
      "end": 10223.06,
      "formatted_start": "02:50:19.240",
      "formatted_end": "02:50:23.060",
      "text": "که این شما سر این بار رو باز میدین باید درنش بسته باشید"
    },
    {
      "id": 3,
      "start": 10223.06,
      "end": 10227.38,
      "formatted_start": "02:50:23.060",
      "formatted_end": "02:50:27.380",
      "text": "شما درنش که باز کردی اگه آب بکشید تا این تخشونند"
    },
    {
      "id": 4,
      "start": 10227.38,
      "end": 10229.38,
      "formatted_start": "02:50:27.380",
      "formatted_end": "02:50:29.380",
      "text": "یک لحظه یک باشته جدا بشید"
    },
    {
      "id": 5,
      "start": 10229.38,
      "end": 10233.5,
      "formatted_start": "02:50:29.380",
      "formatted_end": "02:50:33.500",
      "text": "یه فرد این کاری کرده بود عکس شمایی کنیفتم"
    },
    {
      "id": 6,
      "start": 10233.5,
      "end": 10235.5,
      "formatted_start": "02:50:33.500",
      "formatted_end": "02:50:35.500",
      "text": "چی اشتباهی کردم درشو باز کردن؟"
    },
    {
      "id": 7,
      "start": 10235.5,
      "end": 10237.5,
      "formatted_start": "02:50:35.500",
      "formatted_end": "02:50:37.500",
      "text": "در آن، در آن بشید"
    },
    {
      "id": 8,
      "start": 10237.5,
      "end": 10241.38,
      "formatted_start": "02:50:37.500",
      "formatted_end": "02:50:41.380",
      "text": "آه دایی که من تعمالشو من رو..."
    },
    {
      "id": 9,
      "start": 10241.38,
      "end": 10244.58,
      "formatted_start": "02:50:41.380",
      "formatted_end": "02:50:44.580",
      "text": "نه، خوب میشه، میخوام بهترسونم دیگه میرم"
    },
    {
      "id": 10,
      "start": 10244.58,
      "end": 10246.18,
      "formatted_start": "02:50:44.580",
      "formatted_end": "02:50:46.180",
      "text": "دیگه از این کلک برم"
    },
    {
      "id": 11,
      "start": 10246.18,
      "end": 10250.18,
      "formatted_start": "02:50:46.180",
      "formatted_end": "02:50:50.180",
      "text": "آیا تو چرا بدن من اینقدر دونه و اینقدر کیس میدون؟"
    },
    {
      "id": 12,
      "start": 10250.18,
      "end": 10252.38,
      "formatted_start": "02:50:50.180",
      "formatted_end": "02:50:52.380",
      "text": "تو پولی دیگه، تو پولی ها اینجوری هست"
    },
    {
      "id": 13,
      "start": 10252.38,
      "end": 10255.58,
      "formatted_start": "02:50:52.380",
      "formatted_end": "02:50:55.580",
      "text": "باقت چربی یه جای جنب میشه، یه مدت خوبه"
    },
    {
      "id": 14,
      "start": 10255.58,
      "end": 10258.38,
      "formatted_start": "02:50:55.580",
      "formatted_end": "02:50:58.380",
      "text": "بعد این مدت لاغر که میشیم، مثلا رژیم میگیریم"
    },
    {
      "id": 15,
      "start": 10258.38,
      "end": 10261.38,
      "formatted_start": "02:50:58.380",
      "formatted_end": "02:51:01.380",
      "text": "اون چربی میدون، اون جاش خالی میشه مثل کیس میشه"
    },
    {
      "id": 16,
      "start": 10261.38,
      "end": 10266.18,
      "formatted_start": "02:51:01.380",
      "formatted_end": "02:51:06.180",
      "text": "آره، تو حالا چند وقتی رژیم میرسم، پولن، خیلی کیس"
    },
    {
      "id": 17,
      "start": 10266.18,
      "end": 10271.18,
      "formatted_start": "02:51:06.180",
      "formatted_end": "02:51:11.180",
      "text": "خب رژیم برات خوبه ولی اون چردی هایی که اینجاهایی پر کرده"
    },
    {
      "id": 18,
      "start": 10273.18,
      "end": 10274.18,
      "formatted_start": "02:51:13.180",
      "formatted_end": "02:51:14.180",
      "text": "خاری میشه"
    },
    {
      "id": 19,
      "start": 10274.18,
      "end": 10276.18,
      "formatted_start": "02:51:14.180",
      "formatted_end": "02:51:16.180",
      "text": "خرم خوب میشه بسیار آماین هاشه"
    },
    {
      "id": 20,
      "start": 10276.18,
      "end": 10278.18,
      "formatted_start": "02:51:16.180",
      "formatted_end": "02:51:18.180",
      "text": "آره اینجوریه تاشتش بگیرین چی شده"
    },
    {
      "id": 21,
      "start": 10278.18,
      "end": 10282.18,
      "formatted_start": "02:51:18.180",
      "formatted_end": "02:51:22.180",
      "text": "آهانده یکی دیگه هم به کسان خیلی اقتصاد فرسته"
    },
    {
      "id": 22,
      "start": 10282.18,
      "end": 10285.18,
      "formatted_start": "02:51:22.180",
      "formatted_end": "02:51:25.180",
      "text": "اشتراک اندرشو باز کردن؟"
    },
    {
      "id": 23,
      "start": 10285.18,
      "end": 10288.18,
      "formatted_start": "02:51:25.180",
      "formatted_end": "02:51:28.180",
      "text": "آره آره نمی برم، اونو الان ما می برنیم"
    },
    {
      "id": 24,
      "start": 10288.18,
      "end": 10290.18,
      "formatted_start": "02:51:28.180",
      "formatted_end": "02:51:30.180",
      "text": "یه دیگه باید باید بخشم انشالله"
    },
    {
      "id": 25,
      "start": 10290.18,
      "end": 10292.18,
      "formatted_start": "02:51:30.180",
      "formatted_end": "02:51:32.180",
      "text": "بخشم بخشم بخشم"
    },
    {
      "id": 26,
      "start": 10292.18,
      "end": 10297.18,
      "formatted_start": "02:51:32.180",
      "formatted_end": "02:51:37.180",
      "text": "این رو که انگوشتو شد"
    },
    {
      "id": 27,
      "start": 10297.18,
      "end": 10301.18,
      "formatted_start": "02:51:37.180",
      "formatted_end": "02:51:41.180",
      "text": "دیابت داشت، اینجورو شد"
    },
    {
      "id": 28,
      "start": 10301.18,
      "end": 10304.18,
      "formatted_start": "02:51:41.180",
      "formatted_end": "02:51:44.180",
      "text": "یکی دیگه این همون باره تو بخش نشانه که"
    },
    {
      "id": 29,
      "start": 10304.18,
      "end": 10316.18,
      "formatted_start": "02:51:44.180",
      "formatted_end": "02:51:56.180",
      "text": "اگر درموشن شد او درموشن میده او به هیچ فرشت نمیشه"
    },
    {
      "id": 30,
      "start": 10316.18,
      "end": 10320.18,
      "formatted_start": "02:51:56.180",
      "formatted_end": "02:52:00.180",
      "text": "با قیچی آدم جرایی نیست"
    },
    {
      "id": 31,
      "start": 10320.18,
      "end": 10326.18,
      "formatted_start": "02:52:00.180",
      "formatted_end": "02:52:06.180",
      "text": "قیچی قیمت عالی است که باش ناخون میدهید با چه بیدارید"
    },
    {
      "id": 32,
      "start": 10326.18,
      "end": 10328.18,
      "formatted_start": "02:52:06.180",
      "formatted_end": "02:52:08.180",
      "text": "قاقت بیدارید"
    },
    {
      "id": 33,
      "start": 10328.18,
      "end": 10330.18,
      "formatted_start": "02:52:08.180",
      "formatted_end": "02:52:10.180",
      "text": "قیچی عروی بود"
    },
    {
      "id": 34,
      "start": 10330.18,
      "end": 10337.72,
      "formatted_start": "02:52:10.180",
      "formatted_end": "02:52:17.720",
      "text": "چرایی کردی؟ قشنگ کنید و تشخیصی کردیش میبینید چیزی توش نیست"
    },
    {
      "id": 35,
      "start": 10337.72,
      "end": 10340.24,
      "formatted_start": "02:52:17.720",
      "formatted_end": "02:52:20.240",
      "text": "میبینید برای چیزی توش کامشه، میخواه رفته"
    },
    {
      "id": 36,
      "start": 10340.24,
      "end": 10343.16,
      "formatted_start": "02:52:20.240",
      "formatted_end": "02:52:23.160",
      "text": "این بابا خجاوت که چیزایی نمیدونه کار میکرده"
    },
    {
      "id": 37,
      "start": 10343.16,
      "end": 10347.3,
      "formatted_start": "02:52:23.160",
      "formatted_end": "02:52:27.300",
      "text": "نه تو هیچ کس بگیر، مگرانم بگو هیچ که کار میکرده"
    },
    {
      "id": 38,
      "start": 10347.3,
      "end": 10349.92,
      "formatted_start": "02:52:27.300",
      "formatted_end": "02:52:29.920",
      "text": "اصلا دست جراحی تو بدن تو نزده اید"
    },
    {
      "id": 39,
      "start": 10349.92,
      "end": 10353.5,
      "formatted_start": "02:52:29.920",
      "formatted_end": "02:52:33.500",
      "text": "اگر باید این پیشایی دیگه هم ببانیدونیستم"
    },
    {
      "id": 40,
      "start": 10353.5,
      "end": 10354.92,
      "formatted_start": "02:52:33.500",
      "formatted_end": "02:52:34.920",
      "text": "حتما باید باید ببانیدونیستم"
    },
    {
      "id": 41,
      "start": 10354.92,
      "end": 10358.92,
      "formatted_start": "02:52:34.920",
      "formatted_end": "02:52:38.920",
      "text": "دکتور برای چی باشه؟ دکتور دلت مجانی کرده که اینجور مراجعه کنید"
    },
    {
      "id": 42,
      "start": 10358.92,
      "end": 10364.92,
      "formatted_start": "02:52:38.920",
      "formatted_end": "02:52:44.920",
      "text": "خیلی هم شما رایگانه، سی ست تا ورن شما را هندوره بخورده بخورده بخورده نمیدن، گلاس نمیدن"
    },
    {
      "id": 43,
      "start": 10364.92,
      "end": 10372.92,
      "formatted_start": "02:52:44.920",
      "formatted_end": "02:52:52.920",
      "text": "خب؟ وقتی دکتور کلو سی ست تا بخورده، وقتی بخوردم چی رایگان، بعدی میده داره بر میگرده"
    },
    {
      "id": 44,
      "start": 10372.92,
      "end": 10378.22,
      "formatted_start": "02:52:52.920",
      "formatted_end": "02:52:58.220",
      "text": "این چیز دیگه یعنی از این مجاری تر چیزی که شاید این گیرست به خریف روشون بیرون پس بیدن"
    },
    {
      "id": 45,
      "start": 10378.22,
      "end": 10378.78,
      "formatted_start": "02:52:58.220",
      "formatted_end": "02:52:58.780",
      "text": "نه اینه"
    },
    {
      "id": 46,
      "start": 10378.78,
      "end": 10381.26,
      "formatted_start": "02:52:58.780",
      "formatted_end": "02:53:01.260",
      "text": "این شیطی شد"
    },
    {
      "id": 47,
      "start": 10381.26,
      "end": 10383.64,
      "formatted_start": "02:53:01.260",
      "formatted_end": "02:53:03.640",
      "text": "چقدر فرو رفته"
    },
    {
      "id": 48,
      "start": 10383.64,
      "end": 10384.6,
      "formatted_start": "02:53:03.640",
      "formatted_end": "02:53:04.600",
      "text": "نه فرو رفته"
    },
    {
      "id": 49,
      "start": 10384.6,
      "end": 10387.72,
      "formatted_start": "02:53:04.600",
      "formatted_end": "02:53:07.720",
      "text": "این زنه خودش کنده بود با قیچی"
    },
    {
      "id": 50,
      "start": 10387.72,
      "end": 10389.86,
      "formatted_start": "02:53:07.720",
      "formatted_end": "02:53:09.860",
      "text": "بعد از یک ماه"
    },
    {
      "id": 51,
      "start": 10389.86,
      "end": 10392.0,
      "formatted_start": "02:53:09.860",
      "formatted_end": "02:53:12.000",
      "text": "خواب حافظه کرد و باز نیموند"
    },
    {
      "id": 52,
      "start": 10392.0,
      "end": 10392.94,
      "formatted_start": "02:53:12.000",
      "formatted_end": "02:53:12.940",
      "text": "باز دوباره کنده بود"
    },
    {
      "id": 53,
      "start": 10392.94,
      "end": 10394.18,
      "formatted_start": "02:53:12.940",
      "formatted_end": "02:53:14.180",
      "text": "اقلف افتاده بود"
    },
    {
      "id": 54,
      "start": 10394.18,
      "end": 10395.88,
      "formatted_start": "02:53:14.180",
      "formatted_end": "02:53:15.880",
      "text": "وقتی افتاد آوردن اینجا"
    },
    {
      "id": 55,
      "start": 10395.88,
      "end": 10398.54,
      "formatted_start": "02:53:15.880",
      "formatted_end": "02:53:18.540",
      "text": "اولشه"
    },
    {
      "id": 56,
      "start": 10398.54,
      "end": 10399.66,
      "formatted_start": "02:53:18.540",
      "formatted_end": "02:53:19.660",
      "text": "گفت نه اولش نیست"
    },
    {
      "id": 57,
      "start": 10399.66,
      "end": 10405.02,
      "formatted_start": "02:53:19.660",
      "formatted_end": "02:53:25.020",
      "text": "یه ماه پیش من اینجوری کردم، غیچی زدم، فلان وفهان، اینه وفهان، دیگه من فرستم بمیرم"
    },
    {
      "id": 58,
      "start": 10405.02,
      "end": 10408.62,
      "formatted_start": "02:53:25.020",
      "formatted_end": "02:53:28.620",
      "text": "این دارم پر کردن، این شیش ماه دارو مصرف کرده ایم"
    },
    {
      "id": 59,
      "start": 10408.62,
      "end": 10409.12,
      "formatted_start": "02:53:28.620",
      "formatted_end": "02:53:29.120",
      "text": "بله"
    },
    {
      "id": 60,
      "start": 10409.12,
      "end": 10409.9,
      "formatted_start": "02:53:29.120",
      "formatted_end": "02:53:29.900",
      "text": "شیش ماه دارو"
    },
    {
      "id": 61,
      "start": 10409.9,
      "end": 10411.9,
      "formatted_start": "02:53:29.900",
      "formatted_end": "02:53:31.900",
      "text": "انا اینجوری من مصرف کردم، چقدر جور می کردی؟"
    },
    {
      "id": 62,
      "start": 10411.9,
      "end": 10412.9,
      "formatted_start": "02:53:31.900",
      "formatted_end": "02:53:32.900",
      "text": "اینجوری هفته دارم"
    },
    {
      "id": 63,
      "start": 10412.9,
      "end": 10413.9,
      "formatted_start": "02:53:32.900",
      "formatted_end": "02:53:33.900",
      "text": "سوالش"
    },
    {
      "id": 64,
      "start": 10413.9,
      "end": 10417.5,
      "formatted_start": "02:53:33.900",
      "formatted_end": "02:53:37.500",
      "text": "ممکنه دوباره باز عمرو کنم؟ اگه لاغر میشن، بدتر میشه؟"
    },
    {
      "id": 65,
      "start": 10417.5,
      "end": 10421.8,
      "formatted_start": "02:53:37.500",
      "formatted_end": "02:53:41.800",
      "text": "خب از این چیزها ایجاد میشه. میریم وقتی لاغر میشی این کیست ها ایجاد میشن."
    },
    {
      "id": 66,
      "start": 10421.8,
      "end": 10425.04,
      "formatted_start": "02:53:41.800",
      "formatted_end": "02:53:45.040",
      "text": "چون پدرن توش چربی پر کرده و اصلا تو قبقه بود."
    },
    {
      "id": 67,
      "start": 10425.04,
      "end": 10428.16,
      "formatted_start": "02:53:45.040",
      "formatted_end": "02:53:48.160",
      "text": "پدرن این قبقه با خالی میشه. جاش خالی بشه."
    },
    {
      "id": 68,
      "start": 10428.16,
      "end": 10431.26,
      "formatted_start": "02:53:48.160",
      "formatted_end": "02:53:51.260",
      "text": "و هر مواد بریم. یا بهش بهش بدن رو جزم می کنیم."
    },
    {
      "id": 69,
      "start": 10431.26,
      "end": 10434.26,
      "formatted_start": "02:53:51.260",
      "formatted_end": "02:53:54.260",
      "text": "باید بردن. چون نشاده چاقه دید. مامانه چاقه دید."
    },
    {
      "id": 70,
      "start": 10434.26,
      "end": 10437.26,
      "formatted_start": "02:53:54.260",
      "formatted_end": "02:53:57.260",
      "text": "بابات هم یک کل داره. باشه باید بردن همه چوریه."
    },
    {
      "id": 71,
      "start": 10437.26,
      "end": 10438.84,
      "formatted_start": "02:53:57.260",
      "formatted_end": "02:53:58.840",
      "text": "خب."
    },
    {
      "id": 72,
      "start": 10438.84,
      "end": 10442.28,
      "formatted_start": "02:53:58.840",
      "formatted_end": "02:54:02.280",
      "text": "آیا توی مورس هم واسه ما هم میبینیم تو دیده فرشیمه"
    },
    {
      "id": 73,
      "start": 10442.28,
      "end": 10444.28,
      "formatted_start": "02:54:02.280",
      "formatted_end": "02:54:04.280",
      "text": "بسیار شدید"
    },
    {
      "id": 74,
      "start": 10444.28,
      "end": 10447.28,
      "formatted_start": "02:54:04.280",
      "formatted_end": "02:54:07.280",
      "text": "مورس چهار دیگه"
    },
    {
      "id": 75,
      "start": 10447.28,
      "end": 10449.28,
      "formatted_start": "02:54:07.280",
      "formatted_end": "02:54:09.280",
      "text": "روزبستتی"
    },
    {
      "id": 76,
      "start": 10449.28,
      "end": 10453.28,
      "formatted_start": "02:54:09.280",
      "formatted_end": "02:54:13.280",
      "text": "شما برای این رابط شدن بیشتر با درزیسی این چیزی هم به معرفی می کنید؟"
    },
    {
      "id": 77,
      "start": 10453.28,
      "end": 10455.28,
      "formatted_start": "02:54:13.280",
      "formatted_end": "02:54:15.280",
      "text": "دارو میدیم، نشین میدیم"
    },
    {
      "id": 78,
      "start": 10455.28,
      "end": 10460.28,
      "formatted_start": "02:54:15.280",
      "formatted_end": "02:54:20.280",
      "text": "اونها، این مورد هزینهش ۸۰۰ رشیمه و اون چیزی بیدیم"
    },
    {
      "id": 79,
      "start": 10460.28,
      "end": 10462.28,
      "formatted_start": "02:54:20.280",
      "formatted_end": "02:54:22.280",
      "text": "خواهیم بخواییم ازش"
    },
    {
      "id": 80,
      "start": 10462.28,
      "end": 10464.28,
      "formatted_start": "02:54:22.280",
      "formatted_end": "02:54:24.280",
      "text": "برای این سیایی همه با همه ۳۰۰ رشیمه بشیم"
    },
    {
      "id": 81,
      "start": 10464.28,
      "end": 10472.28,
      "formatted_start": "02:54:24.280",
      "formatted_end": "02:54:32.280",
      "text": "خیلی هم می آمیزند. من باید 150 گلو داشتم و من باید 25 گلو گردیم."
    },
    {
      "id": 82,
      "start": 10472.28,
      "end": 10482.28,
      "formatted_start": "02:54:32.280",
      "formatted_end": "02:54:42.280",
      "text": "خب، بعد اینکه خانم دو تا کمال را یاد بدهدم، یک چست بزرگ را می بشتم، دوری کمال تن بزرگ را می بشتم، دستگاه دیگه نداشته باشیم."
    },
    {
      "id": 83,
      "start": 10482.28,
      "end": 10484.28,
      "formatted_start": "02:54:42.280",
      "formatted_end": "02:54:44.280",
      "text": "خیلی هم سلام بگیرم."
    },
    {
      "id": 84,
      "start": 10484.28,
      "end": 10486.28,
      "formatted_start": "02:54:44.280",
      "formatted_end": "02:54:46.280",
      "text": "خانم، اینکه محتکرم آمیز."
    },
    {
      "id": 85,
      "start": 10486.28,
      "end": 10488.28,
      "formatted_start": "02:54:46.280",
      "formatted_end": "02:54:48.280",
      "text": "خودش را باید اینجا بگیرم و سرد را رای باشیم."
    },
    {
      "id": 86,
      "start": 10488.28,
      "end": 10492.28,
      "formatted_start": "02:54:48.280",
      "formatted_end": "02:54:52.280",
      "text": "محتکرم آمیز. خیلی لطفی کردم. خدا می گذارم."
    },
    {
      "id": 87,
      "start": 10494.28,
      "end": 10497.28,
      "formatted_start": "02:54:54.280",
      "formatted_end": "02:54:57.280",
      "text": "بینانده یه چونیتی نیست در این درکت باشید"
    }
  ],
  "status": "completed"
}