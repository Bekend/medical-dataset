  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4806.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:06.000",
      "text": "این دو شرکت باید با هم نگه، برقرار باید توازنی با هم کشور انداره، ولی نباید غفرت هم بشه."
    },
    {
      "id": 1,
      "start": 4806.0,
      "end": 4823.0,
      "formatted_start": "01:20:06.000",
      "formatted_end": "01:20:23.000",
      "text": "به نظر من این هم باید حمایت بشه، نه برای کیفیتش هم داره، ولی اینکه یه چیزیه، در چه به خارجه، اگر عبیدی با کیفیتت به خاطر اینه که ما اکتوبر داریم، در رواقات بایمون،"
    },
    {
      "id": 2,
      "start": 4823.0,
      "end": 4828.0,
      "formatted_start": "01:20:23.000",
      "formatted_end": "01:20:28.000",
      "text": "اگر ما حکم را نداشتیم، عویدین هر چیزی از آن مجبور بودید قبول کنید."
    },
    {
      "id": 3,
      "start": 4828.0,
      "end": 4833.0,
      "formatted_start": "01:20:28.000",
      "formatted_end": "01:20:33.000",
      "text": "عویدین تولید داخلی میتونه تقلب کنه، از مقدار داروش کم کنه،"
    },
    {
      "id": 4,
      "start": 4833.0,
      "end": 4841.0,
      "formatted_start": "01:20:33.000",
      "formatted_end": "01:20:41.000",
      "text": "هر بلای سر بلای ایران بیاره مثل بقیه، مثل فارمه، دیدی میدونم، کیمی دارو، شرکت های دیگه بلای سر مردم بیاره،"
    },
    {
      "id": 5,
      "start": 4841.0,
      "end": 4847.0,
      "formatted_start": "01:20:41.000",
      "formatted_end": "01:20:47.000",
      "text": "هیچ رقیبی نداره، اما این رقیب داره، رقیب داره و رقیب بسیار سخت گیری هم داره،"
    },
    {
      "id": 6,
      "start": 4847.0,
      "end": 4877.0,
      "formatted_start": "01:20:47.000",
      "formatted_end": "01:21:17.000",
      "text": "که استاندارد خودشون کم نمی کنه، درست کار می کنه، درسته، پس باید این هم حمایت بشه اکتوبر تا بتونه عویدی هم عویدی بمونه، تنها بمونه آدم فاسد میشه، باید حتما یه رقم داشته باشه، یکی یه دوره خور میشه یه دیمونه، پس دوتا بچه میشن، ستا بچه میشن، در رقابت همه شون ساره، اما یکی یه دوره همین هر کاری کنه، مابانش خوشش می کنه، درسته، تا، اینه که من نظ"
    },
    {
      "id": 7,
      "start": 4877.0,
      "end": 4886.0,
      "formatted_start": "01:21:17.000",
      "formatted_end": "01:21:26.000",
      "text": "از عقیدی هم حمایت کنیم با اینکه باید یک طوری در داخلی در کلال این روایت با این و فکرهای اتاق فکر دارن"
    },
    {
      "id": 8,
      "start": 4886.0,
      "end": 4890.0,
      "formatted_start": "01:21:26.000",
      "formatted_end": "01:21:30.000",
      "text": "خب دکتر در خصوص محراسم ها و مهرمانی ها ما هم داریم"
    },
    {
      "id": 9,
      "start": 4890.0,
      "end": 4891.0,
      "formatted_start": "01:21:30.000",
      "formatted_end": "01:21:31.000",
      "text": "حالا نماینده اینکه"
    },
    {
      "id": 10,
      "start": 4891.0,
      "end": 4893.0,
      "formatted_start": "01:21:31.000",
      "formatted_end": "01:21:33.000",
      "text": "طالع درد نشونده"
    },
    {
      "id": 11,
      "start": 4893.0,
      "end": 4897.0,
      "formatted_start": "01:21:33.000",
      "formatted_end": "01:21:37.000",
      "text": "حالا هر روز ما یک کاز باز آموزی هم بگیریم از دارو سازا"
    },
    {
      "id": 12,
      "start": 4897.0,
      "end": 4903.0,
      "formatted_start": "01:21:37.000",
      "formatted_end": "01:21:43.000",
      "text": "مثلا دست ها سو خانوادشیم که دکو باشهره بودن و دکو برگانه و دکو بنکره بودن"
    },
    {
      "id": 13,
      "start": 4903.0,
      "end": 4904.0,
      "formatted_start": "01:21:43.000",
      "formatted_end": "01:21:44.000",
      "text": "باشگاره پر؟"
    },
    {
      "id": 14,
      "start": 4904.0,
      "end": 4905.0,
      "formatted_start": "01:21:44.000",
      "formatted_end": "01:21:45.000",
      "text": "آره"
    },
    {
      "id": 15,
      "start": 4905.0,
      "end": 4906.0,
      "formatted_start": "01:21:45.000",
      "formatted_end": "01:21:46.000",
      "text": "با لایر قلب تو بودن؟"
    },
    {
      "id": 16,
      "start": 4906.0,
      "end": 4911.0,
      "formatted_start": "01:21:46.000",
      "formatted_end": "01:21:51.000",
      "text": "آره، نه نه با نایند داخلی، آنها باشگاره برای محفظ کینرین میخواستن"
    },
    {
      "id": 17,
      "start": 4911.0,
      "end": 4914.0,
      "formatted_start": "01:21:51.000",
      "formatted_end": "01:21:54.000",
      "text": "فینرنام و پولو فینرنام، کینرین میخواستن سوپرداشتن"
    },
    {
      "id": 18,
      "start": 4914.0,
      "end": 4916.0,
      "formatted_start": "01:21:54.000",
      "formatted_end": "01:21:56.000",
      "text": "برای چیز چربیه؟"
    },
    {
      "id": 19,
      "start": 4916.0,
      "end": 4921.0,
      "formatted_start": "01:21:56.000",
      "formatted_end": "01:22:01.000",
      "text": "نه، کینرین برای افرادی که حالا دفعه آل بود، جدای از این ما توی سیکیلیا"
    },
    {
      "id": 20,
      "start": 4921.0,
      "end": 4924.0,
      "formatted_start": "01:22:01.000",
      "formatted_end": "01:22:04.000",
      "text": "من چیز نیستم، آشنا نیستم بگیادم"
    },
    {
      "id": 21,
      "start": 4924.0,
      "end": 4925.0,
      "formatted_start": "01:22:04.000",
      "formatted_end": "01:22:05.000",
      "text": "من نیستم چبرایی؟"
    },
    {
      "id": 22,
      "start": 4925.0,
      "end": 4927.0,
      "formatted_start": "01:22:05.000",
      "formatted_end": "01:22:07.000",
      "text": "نشورشو توی ماشی برده"
    },
    {
      "id": 23,
      "start": 4927.0,
      "end": 4935.0,
      "formatted_start": "01:22:07.000",
      "formatted_end": "01:22:15.000",
      "text": "این فیلوزی در واقع بر جوریه از فیلوز بافت قلب و کهلیه استفاده میشه"
    },
    {
      "id": 24,
      "start": 4935.0,
      "end": 4946.0,
      "formatted_start": "01:22:15.000",
      "formatted_end": "01:22:26.000",
      "text": "چون توضیح بافت میشه کهلیه که در این این اصد شما میدار کنم تو سه درم ببینم این الان یعنی چی؟"
    },
    {
      "id": 25,
      "start": 4946.0,
      "end": 4951.0,
      "formatted_start": "01:22:26.000",
      "formatted_end": "01:22:31.000",
      "text": "ایفی نرمون آیگوتون من مواد علمی شو براتون میارم تو ماشین بذاشتم برگشتیم"
    },
    {
      "id": 26,
      "start": 4951.0,
      "end": 4956.0,
      "formatted_start": "01:22:31.000",
      "formatted_end": "01:22:36.000",
      "text": "در مواد ایفی نرمون بکنم بگم مثلا برای کسی که ایف باره چهل دارن، هفت فیل هستن"
    },
    {
      "id": 27,
      "start": 4956.0,
      "end": 4959.0,
      "formatted_start": "01:22:36.000",
      "formatted_end": "01:22:39.000",
      "text": "جی ایف آر منصوبه توی ایف ایشونهای درکتون"
    },
    {
      "id": 28,
      "start": 4959.0,
      "end": 4960.0,
      "formatted_start": "01:22:39.000",
      "formatted_end": "01:22:40.000",
      "text": "ایف ایشونهای درکتون؟ آره"
    },
    {
      "id": 29,
      "start": 4960.0,
      "end": 4964.0,
      "formatted_start": "01:22:40.000",
      "formatted_end": "01:22:44.000",
      "text": "ایف ایشونهای درکتون برای اجکشن فریکشن ها؟ آره اجکشن فریکشنشون در واقع باره چهل هست"
    },
    {
      "id": 30,
      "start": 4964.0,
      "end": 4969.0,
      "formatted_start": "01:22:44.000",
      "formatted_end": "01:22:49.000",
      "text": "و هف هف هستن مثلا دکتر براش هر روز داره ایپرانوکران باید بینو نویسه"
    },
    {
      "id": 31,
      "start": 4969.0,
      "end": 4973.0,
      "formatted_start": "01:22:49.000",
      "formatted_end": "01:22:53.000",
      "text": "ولی خب برای ایپ زیر چهر باید برنسن هف رفیه دیگه"
    },
    {
      "id": 32,
      "start": 4973.0,
      "end": 4976.0,
      "formatted_start": "01:22:53.000",
      "formatted_end": "01:22:56.000",
      "text": "از این برای هف هف اینجوری دکتر استفاده کنه"
    },
    {
      "id": 33,
      "start": 4976.0,
      "end": 4979.0,
      "formatted_start": "01:22:56.000",
      "formatted_end": "01:22:59.000",
      "text": "جورگی از فیواز وافتر پرد و کولویه هست"
    },
    {
      "id": 34,
      "start": 4979.0,
      "end": 4985.0,
      "formatted_start": "01:22:59.000",
      "formatted_end": "01:23:05.000",
      "text": "و شما که کنید عده این مقصود مثلا یک کسی هست که مثلا در واقع هر کاری رو کنه"
    },
    {
      "id": 35,
      "start": 4985.0,
      "end": 5015.0,
      "formatted_start": "01:23:05.000",
      "formatted_end": "01:23:35.000",
      "text": "اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینک"
    },
    {
      "id": 36,
      "start": 5015.0,
      "end": 5017.0,
      "formatted_start": "01:23:35.000",
      "formatted_end": "01:23:37.000",
      "text": "این راه با امپا است"
    },
    {
      "id": 37,
      "start": 5017.0,
      "end": 5023.0,
      "formatted_start": "01:23:37.000",
      "formatted_end": "01:23:43.000",
      "text": "این راه با امپا میدیم که سلامت کلیا رو تصمیم کنه"
    },
    {
      "id": 38,
      "start": 5023.0,
      "end": 5025.0,
      "formatted_start": "01:23:43.000",
      "formatted_end": "01:23:45.000",
      "text": "هر کلیا هم برد"
    },
    {
      "id": 39,
      "start": 5025.0,
      "end": 5027.0,
      "formatted_start": "01:23:45.000",
      "formatted_end": "01:23:47.000",
      "text": "و از این روز پذولی غلطی هم شروع گیره کنه"
    },
    {
      "id": 40,
      "start": 5027.0,
      "end": 5031.0,
      "formatted_start": "01:23:47.000",
      "formatted_end": "01:23:51.000",
      "text": "مثلا تو سنایه ها سنای بانا است یا برای زن کنه"
    },
    {
      "id": 41,
      "start": 5031.0,
      "end": 5033.0,
      "formatted_start": "01:23:51.000",
      "formatted_end": "01:23:53.000",
      "text": "که شیره تا سنایه کنه میتونیم بیدیم"
    },
    {
      "id": 42,
      "start": 5033.0,
      "end": 5038.0,
      "formatted_start": "01:23:53.000",
      "formatted_end": "01:23:58.000",
      "text": "آیا دکتور این رو برای افرادی میدیم که دفعه آرگومی داره"
    },
    {
      "id": 43,
      "start": 5038.0,
      "end": 5041.0,
      "formatted_start": "01:23:58.000",
      "formatted_end": "01:24:01.000",
      "text": "دیابت دی که ایدیه مثلا دیابت داره"
    },
    {
      "id": 44,
      "start": 5041.0,
      "end": 5047.0,
      "formatted_start": "01:24:01.000",
      "formatted_end": "01:24:07.000",
      "text": "بعد شما فکر کنید که این دیابتی هیه که مثلا اومده سیکریدی هم داره میشه"
    },
    {
      "id": 45,
      "start": 5047.0,
      "end": 5050.0,
      "formatted_start": "01:24:07.000",
      "formatted_end": "01:24:10.000",
      "text": "بعد مشکل قلوی هم براش اینجا چده"
    },
    {
      "id": 46,
      "start": 5050.0,
      "end": 5051.0,
      "formatted_start": "01:24:10.000",
      "formatted_end": "01:24:11.000",
      "text": "بعد قلوی ها..."
    },
    {
      "id": 47,
      "start": 5051.0,
      "end": 5052.0,
      "formatted_start": "01:24:11.000",
      "formatted_end": "01:24:12.000",
      "text": "سه آیدکتر"
    },
    {
      "id": 48,
      "start": 5052.0,
      "end": 5053.0,
      "formatted_start": "01:24:12.000",
      "formatted_end": "01:24:13.000",
      "text": "دارو خودی کنید"
    },
    {
      "id": 49,
      "start": 5053.0,
      "end": 5058.0,
      "formatted_start": "01:24:13.000",
      "formatted_end": "01:24:18.000",
      "text": "بعد قلوی ها آیدکتر این قلوی هفت پیت میان استفاده می کن"
    },
    {
      "id": 50,
      "start": 5058.0,
      "end": 5062.0,
      "formatted_start": "01:24:18.000",
      "formatted_end": "01:24:22.000",
      "text": "چون امپا گلیپندوزین ها چه دیابت چکیه دیابت نسخه می کنند"
    },
    {
      "id": 51,
      "start": 5062.0,
      "end": 5065.0,
      "formatted_start": "01:24:22.000",
      "formatted_end": "01:24:25.000",
      "text": "دیگه قلوی ها بعد مثلا درواقع به نفتش"
    },
    {
      "id": 52,
      "start": 5065.0,
      "end": 5070.0,
      "formatted_start": "01:24:25.000",
      "formatted_end": "01:24:30.000",
      "text": "اینجا میان اگه این برای بیوست هم افتاده باشه چون برای هفته ما چیزی نداریم"
    },
    {
      "id": 53,
      "start": 5070.0,
      "end": 5072.0,
      "formatted_start": "01:24:30.000",
      "formatted_end": "01:24:32.000",
      "text": "این مکانیسمش چیه؟"
    },
    {
      "id": 54,
      "start": 5072.0,
      "end": 5076.0,
      "formatted_start": "01:24:32.000",
      "formatted_end": "01:24:36.000",
      "text": "آیدکتور در حال داره اون مکانیسمش من حتما برای توی قامل میان"
    },
    {
      "id": 55,
      "start": 5076.0,
      "end": 5081.0,
      "formatted_start": "01:24:36.000",
      "formatted_end": "01:24:41.000",
      "text": "چون من مکانیسم جمعیه در اجوریم و فقط آن چیزی که به من گفته شده"
    },
    {
      "id": 56,
      "start": 5081.0,
      "end": 5085.0,
      "formatted_start": "01:24:41.000",
      "formatted_end": "01:24:45.000",
      "text": "اینه که تاربکالومیه مصروف خیلی نسبت به بردیازه"
    },
    {
      "id": 57,
      "start": 5085.0,
      "end": 5091.0,
      "formatted_start": "01:24:45.000",
      "formatted_end": "01:24:51.000",
      "text": "خیلی کمه تما امر ای استرویدی هست آیدکتور"
    },
    {
      "id": 58,
      "start": 5091.0,
      "end": 5097.0,
      "formatted_start": "01:24:51.000",
      "formatted_end": "01:24:57.000",
      "text": "که در واقع مانه فیبروز باز داره"
    },
    {
      "id": 59,
      "start": 5097.0,
      "end": 5100.0,
      "formatted_start": "01:24:57.000",
      "formatted_end": "01:25:00.000",
      "text": "و توقف میشه که من معمولشو باز باز بگم"
    }
  ],
  "status": "completed"
}