  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8702.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:02.000",
      "text": "از اینجوری گفته هم آمدید، عادت نشده بودید؟"
    },
    {
      "id": 1,
      "start": 8702.0,
      "end": 8704.0,
      "formatted_start": "02:25:02.000",
      "formatted_end": "02:25:04.000",
      "text": "نه، نشده بودم. بیستوم شدم."
    },
    {
      "id": 2,
      "start": 8704.0,
      "end": 8706.0,
      "formatted_start": "02:25:04.000",
      "formatted_end": "02:25:06.000",
      "text": "اینکه صلاح این بشه."
    },
    {
      "id": 3,
      "start": 8706.0,
      "end": 8710.0,
      "formatted_start": "02:25:06.000",
      "formatted_end": "02:25:10.000",
      "text": "چهار، امروز، پنج، بیست و پنج."
    },
    {
      "id": 4,
      "start": 8710.0,
      "end": 8714.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:14.000",
      "text": "روز شش قایده دیگه است."
    },
    {
      "id": 5,
      "start": 8714.0,
      "end": 8717.0,
      "formatted_start": "02:25:14.000",
      "formatted_end": "02:25:17.000",
      "text": "درد سینه، درد سینه شکر داشتی یا نه؟"
    },
    {
      "id": 6,
      "start": 8717.0,
      "end": 8721.0,
      "formatted_start": "02:25:17.000",
      "formatted_end": "02:25:21.000",
      "text": "درد سینه، از سوزه شنگو که سینه داشتم و..."
    },
    {
      "id": 7,
      "start": 8721.0,
      "end": 8722.0,
      "formatted_start": "02:25:21.000",
      "formatted_end": "02:25:22.000",
      "text": "سوزه شنگو که سینه داشتی."
    },
    {
      "id": 8,
      "start": 8722.0,
      "end": 8728.0,
      "formatted_start": "02:25:22.000",
      "formatted_end": "02:25:28.000",
      "text": "مرسی جلیهی که گفتم دوباره زک زدی از همه ماه تا پرسیدی، اما سه روز خوردی دیگه؟"
    },
    {
      "id": 9,
      "start": 8728.0,
      "end": 8730.0,
      "formatted_start": "02:25:28.000",
      "formatted_end": "02:25:30.000",
      "text": "نقدار عادت خوب شد؟"
    },
    {
      "id": 10,
      "start": 8730.0,
      "end": 8732.0,
      "formatted_start": "02:25:30.000",
      "formatted_end": "02:25:32.000",
      "text": "نقدار عادت خوب شد؟"
    },
    {
      "id": 11,
      "start": 8732.0,
      "end": 8734.0,
      "formatted_start": "02:25:32.000",
      "formatted_end": "02:25:34.000",
      "text": "نقدار عادت خوب شد؟"
    },
    {
      "id": 12,
      "start": 8734.0,
      "end": 8736.0,
      "formatted_start": "02:25:34.000",
      "formatted_end": "02:25:36.000",
      "text": "نقدار عادت خوب شد؟"
    },
    {
      "id": 13,
      "start": 8736.0,
      "end": 8738.0,
      "formatted_start": "02:25:36.000",
      "formatted_end": "02:25:38.000",
      "text": "نسبت به همشه میگم این نفر زیشتر شد"
    },
    {
      "id": 14,
      "start": 8738.0,
      "end": 8740.0,
      "formatted_start": "02:25:38.000",
      "formatted_end": "02:25:40.000",
      "text": "آره سه روز بود، این نفر روز چهاره ماه تا خود شد"
    },
    {
      "id": 15,
      "start": 8740.0,
      "end": 8742.0,
      "formatted_start": "02:25:40.000",
      "formatted_end": "02:25:42.000",
      "text": "سیاهی کسی پیر آمد یا نه؟"
    },
    {
      "id": 16,
      "start": 8742.0,
      "end": 8744.0,
      "formatted_start": "02:25:42.000",
      "formatted_end": "02:25:44.000",
      "text": "سیاهی کسی پیر آمد یا نه؟"
    },
    {
      "id": 17,
      "start": 8744.0,
      "end": 8746.66,
      "formatted_start": "02:25:44.000",
      "formatted_end": "02:25:46.660",
      "text": "بعد این دنویجی که بذاشته بودم آره سیاه بود"
    },
    {
      "id": 18,
      "start": 8746.66,
      "end": 8747.86,
      "formatted_start": "02:25:46.660",
      "formatted_end": "02:25:47.860",
      "text": "سیاه بود"
    },
    {
      "id": 19,
      "start": 8747.86,
      "end": 8749.86,
      "formatted_start": "02:25:47.860",
      "formatted_end": "02:25:49.860",
      "text": "سیاهی خالج بشه"
    },
    {
      "id": 20,
      "start": 8749.86,
      "end": 8751.06,
      "formatted_start": "02:25:49.860",
      "formatted_end": "02:25:51.060",
      "text": "می کن برقری هست"
    },
    {
      "id": 21,
      "start": 8751.06,
      "end": 8753.06,
      "formatted_start": "02:25:51.060",
      "formatted_end": "02:25:53.060",
      "text": "رو تخت درست بکشیم"
    },
    {
      "id": 22,
      "start": 8753.06,
      "end": 8756.06,
      "formatted_start": "02:25:53.060",
      "formatted_end": "02:25:56.060",
      "text": "من اومدن رو تو"
    },
    {
      "id": 23,
      "start": 8756.06,
      "end": 8758.24,
      "formatted_start": "02:25:56.060",
      "formatted_end": "02:25:58.240",
      "text": "کنار روزه این نداشتم فرمانده نگاه نکردم"
    },
    {
      "id": 24,
      "start": 8758.24,
      "end": 8759.34,
      "formatted_start": "02:25:58.240",
      "formatted_end": "02:25:59.340",
      "text": "بنابراین فکر کردم تو عادت ها"
    },
    {
      "id": 25,
      "start": 8759.34,
      "end": 8760.82,
      "formatted_start": "02:25:59.340",
      "formatted_end": "02:26:00.820",
      "text": "ولی این بین دو عادته"
    },
    {
      "id": 26,
      "start": 8760.82,
      "end": 8762.1,
      "formatted_start": "02:26:00.820",
      "formatted_end": "02:26:02.100",
      "text": "گفتم یه شنواره بودی"
    },
    {
      "id": 27,
      "start": 8762.1,
      "end": 8762.5,
      "formatted_start": "02:26:02.100",
      "formatted_end": "02:26:02.500",
      "text": "نه نه نه"
    },
    {
      "id": 28,
      "start": 8762.5,
      "end": 8764.24,
      "formatted_start": "02:26:02.500",
      "formatted_end": "02:26:04.240",
      "text": "همجاز یه گشنواره یه شنواره بود"
    },
    {
      "id": 29,
      "start": 8764.24,
      "end": 8764.74,
      "formatted_start": "02:26:04.240",
      "formatted_end": "02:26:04.740",
      "text": "نه"
    },
    {
      "id": 30,
      "start": 8764.74,
      "end": 8766.74,
      "formatted_start": "02:26:04.740",
      "formatted_end": "02:26:06.740",
      "text": "درست بکشیم"
    },
    {
      "id": 31,
      "start": 8766.74,
      "end": 8768.74,
      "formatted_start": "02:26:06.740",
      "formatted_end": "02:26:08.740",
      "text": "عادت و عادت تو گشنواره است"
    },
    {
      "id": 32,
      "start": 8768.74,
      "end": 8771.74,
      "formatted_start": "02:26:08.740",
      "formatted_end": "02:26:11.740",
      "text": "خوب، برات چکم بود."
    },
    {
      "id": 33,
      "start": 8771.74,
      "end": 8774.74,
      "formatted_start": "02:26:11.740",
      "formatted_end": "02:26:14.740",
      "text": "الان با هم وقت چند موزن هم افتاد؟"
    },
    {
      "id": 34,
      "start": 8774.74,
      "end": 8776.74,
      "formatted_start": "02:26:14.740",
      "formatted_end": "02:26:16.740",
      "text": "در سه ویستون."
    },
    {
      "id": 35,
      "start": 8776.74,
      "end": 8780.74,
      "formatted_start": "02:26:16.740",
      "formatted_end": "02:26:20.740",
      "text": "بیستون باید میشودن؟ بیستون شودن."
    },
    {
      "id": 36,
      "start": 8780.74,
      "end": 8783.74,
      "formatted_start": "02:26:20.740",
      "formatted_end": "02:26:23.740",
      "text": "آهیبه شبه بود؟"
    },
    {
      "id": 37,
      "start": 8783.74,
      "end": 8786.74,
      "formatted_start": "02:26:23.740",
      "formatted_end": "02:26:26.740",
      "text": "بیستون بود که هر مورد چند جه بود."
    },
    {
      "id": 38,
      "start": 8786.74,
      "end": 8789.74,
      "formatted_start": "02:26:26.740",
      "formatted_end": "02:26:29.740",
      "text": "برات چکم بود."
    },
    {
      "id": 39,
      "start": 8789.74,
      "end": 8791.74,
      "formatted_start": "02:26:29.740",
      "formatted_end": "02:26:31.740",
      "text": "برات باید بستان میشود."
    },
    {
      "id": 40,
      "start": 8791.74,
      "end": 8793.74,
      "formatted_start": "02:26:31.740",
      "formatted_end": "02:26:33.740",
      "text": "جه بود."
    },
    {
      "id": 41,
      "start": 8793.74,
      "end": 8796.74,
      "formatted_start": "02:26:33.740",
      "formatted_end": "02:26:36.740",
      "text": "برات چکم بود."
    },
    {
      "id": 42,
      "start": 8796.74,
      "end": 8800.74,
      "formatted_start": "02:26:36.740",
      "formatted_end": "02:26:40.740",
      "text": "امروز سیاهی رو میدید و دیدید"
    },
    {
      "id": 43,
      "start": 8800.74,
      "end": 8804.74,
      "formatted_start": "02:26:40.740",
      "formatted_end": "02:26:44.740",
      "text": "سیاهی خونهای مانده قبلیه"
    },
    {
      "id": 44,
      "start": 8804.74,
      "end": 8808.74,
      "formatted_start": "02:26:44.740",
      "formatted_end": "02:26:48.740",
      "text": "که بایسته اینکه در دوره های پیشه"
    },
    {
      "id": 45,
      "start": 8808.74,
      "end": 8812.74,
      "formatted_start": "02:26:48.740",
      "formatted_end": "02:26:52.740",
      "text": "مثل لخته میشه و جای بارویلی رو میده"
    },
    {
      "id": 46,
      "start": 8812.74,
      "end": 8816.74,
      "formatted_start": "02:26:52.740",
      "formatted_end": "02:26:56.740",
      "text": "ولی خونها که بیان ره پازار پشه"
    },
    {
      "id": 47,
      "start": 8816.74,
      "end": 8818.74,
      "formatted_start": "02:26:56.740",
      "formatted_end": "02:26:58.740",
      "text": "میتونید..."
    },
    {
      "id": 48,
      "start": 8818.74,
      "end": 8821.74,
      "formatted_start": "02:26:58.740",
      "formatted_end": "02:27:01.740",
      "text": "حتی دوزای پیلیو دیم بیشتر شد اشکال نداره؟"
    },
    {
      "id": 49,
      "start": 8821.74,
      "end": 8824.74,
      "formatted_start": "02:27:01.740",
      "formatted_end": "02:27:04.740",
      "text": "نه، تا ده روز هم اشکال نداره"
    },
    {
      "id": 50,
      "start": 8824.74,
      "end": 8827.74,
      "formatted_start": "02:27:04.740",
      "formatted_end": "02:27:07.740",
      "text": "نسبت به فرق بشه"
    },
    {
      "id": 51,
      "start": 8827.74,
      "end": 8829.74,
      "formatted_start": "02:27:07.740",
      "formatted_end": "02:27:09.740",
      "text": "بله"
    },
    {
      "id": 52,
      "start": 8829.74,
      "end": 8833.74,
      "formatted_start": "02:27:09.740",
      "formatted_end": "02:27:13.740",
      "text": "روز چند روی پیروی میشه؟"
    },
    {
      "id": 53,
      "start": 8833.74,
      "end": 8835.74,
      "formatted_start": "02:27:13.740",
      "formatted_end": "02:27:15.740",
      "text": "از یازده میشه"
    },
    {
      "id": 54,
      "start": 8835.74,
      "end": 8838.74,
      "formatted_start": "02:27:15.740",
      "formatted_end": "02:27:18.740",
      "text": "من یازده و چارده برات بزنم"
    },
    {
      "id": 55,
      "start": 8838.74,
      "end": 8840.74,
      "formatted_start": "02:27:18.740",
      "formatted_end": "02:27:20.740",
      "text": "من یازده هاییم بچم"
    },
    {
      "id": 56,
      "start": 8840.74,
      "end": 8843.74,
      "formatted_start": "02:27:20.740",
      "formatted_end": "02:27:23.740",
      "text": "پیروی هم توم میشه، خیلی جدید افنات میگرم"
    },
    {
      "id": 57,
      "start": 8843.74,
      "end": 8847.74,
      "formatted_start": "02:27:23.740",
      "formatted_end": "02:27:27.740",
      "text": "شوهر خواهستی جل بیتشتی بدم"
    },
    {
      "id": 58,
      "start": 8847.74,
      "end": 8850.74,
      "formatted_start": "02:27:27.740",
      "formatted_end": "02:27:30.740",
      "text": "خب دست دستی که به خودش بسنه"
    },
    {
      "id": 59,
      "start": 8850.74,
      "end": 8852.74,
      "formatted_start": "02:27:30.740",
      "formatted_end": "02:27:32.740",
      "text": "تنظیم بشه شما هم شوزده برات"
    },
    {
      "id": 60,
      "start": 8852.74,
      "end": 8856.74,
      "formatted_start": "02:27:32.740",
      "formatted_end": "02:27:36.740",
      "text": "شما هر شب باید بشورید، شوهرتون پبلا از نزدیکی بشوره"
    },
    {
      "id": 61,
      "start": 8856.74,
      "end": 8860.74,
      "formatted_start": "02:27:36.740",
      "formatted_end": "02:27:40.740",
      "text": "بعد آب دهان به هم نیشونش نباید بزنه"
    },
    {
      "id": 62,
      "start": 8860.74,
      "end": 8867.74,
      "formatted_start": "02:27:40.740",
      "formatted_end": "02:27:47.740",
      "text": "موقعی نزدیکی، به اضافه اینکه قبلش پاک سازی هم الان بگیدم که تردنویز بشه کافی"
    },
    {
      "id": 63,
      "start": 8867.74,
      "end": 8869.74,
      "formatted_start": "02:27:47.740",
      "formatted_end": "02:27:49.740",
      "text": "به فرما چند رو بشور شد مادر؟"
    },
    {
      "id": 64,
      "start": 8869.74,
      "end": 8871.74,
      "formatted_start": "02:27:49.740",
      "formatted_end": "02:27:51.740",
      "text": "بیسته"
    },
    {
      "id": 65,
      "start": 8871.74,
      "end": 8873.74,
      "formatted_start": "02:27:51.740",
      "formatted_end": "02:27:53.740",
      "text": "بیسته، بچ، شروع شد"
    },
    {
      "id": 66,
      "start": 8873.74,
      "end": 8877.74,
      "formatted_start": "02:27:53.740",
      "formatted_end": "02:27:57.740",
      "text": "خود بیسته هم قصابه، میشه سیر یکم یا هستن"
    },
    {
      "id": 67,
      "start": 8877.74,
      "end": 8880.74,
      "formatted_start": "02:27:57.740",
      "formatted_end": "02:28:00.740",
      "text": "سیروم میشه برنامه، یا هستن"
    },
    {
      "id": 68,
      "start": 8880.74,
      "end": 8902.74,
      "formatted_start": "02:28:00.740",
      "formatted_end": "02:28:22.740",
      "text": "این روزهای نزدیکی درمان های روشیده ها، کرم، کریم و مایسین، امشب استفاده می کنید."
    },
    {
      "id": 69,
      "start": 8902.74,
      "end": 8906.74,
      "formatted_start": "02:28:22.740",
      "formatted_end": "02:28:26.740",
      "text": "باید که یک مقدار خوب بارید، باید همه کمال رو استفاده کنید"
    },
    {
      "id": 70,
      "start": 8906.74,
      "end": 8911.74,
      "formatted_start": "02:28:26.740",
      "formatted_end": "02:28:31.740",
      "text": "جل احتشادی بانوان شما هر شب باشن بشون"
    },
    {
      "id": 71,
      "start": 8911.74,
      "end": 8915.74,
      "formatted_start": "02:28:31.740",
      "formatted_end": "02:28:35.740",
      "text": "همسر چند دقیقه قبل از نزدیکی بشون خودشون"
    },
    {
      "id": 72,
      "start": 8915.74,
      "end": 8919.74,
      "formatted_start": "02:28:35.740",
      "formatted_end": "02:28:39.740",
      "text": "موقعی نزدیکی هم هیچ چی به خودش نزده نمیزه"
    },
    {
      "id": 73,
      "start": 8919.74,
      "end": 8921.74,
      "formatted_start": "02:28:39.740",
      "formatted_end": "02:28:41.740",
      "text": "و سوی رابطه از چه باشن؟"
    },
    {
      "id": 74,
      "start": 8921.74,
      "end": 8923.74,
      "formatted_start": "02:28:41.740",
      "formatted_end": "02:28:43.740",
      "text": "از سی وی خان"
    },
    {
      "id": 75,
      "start": 8923.74,
      "end": 8924.74,
      "formatted_start": "02:28:43.740",
      "formatted_end": "02:28:44.740",
      "text": "پنج روز دیگه؟"
    },
    {
      "id": 76,
      "start": 8924.74,
      "end": 8926.74,
      "formatted_start": "02:28:44.740",
      "formatted_end": "02:28:46.740",
      "text": "پنج روز دیگه، شیش روز دیگه"
    },
    {
      "id": 77,
      "start": 8926.74,
      "end": 8927.74,
      "formatted_start": "02:28:46.740",
      "formatted_end": "02:28:47.740",
      "text": "شیش روز دیگه؟"
    },
    {
      "id": 78,
      "start": 8927.74,
      "end": 8931.74,
      "formatted_start": "02:28:47.740",
      "formatted_end": "02:28:51.740",
      "text": "و اینو بشیم، 5 تا نزدیکی رو انجامیم"
    },
    {
      "id": 79,
      "start": 8931.74,
      "end": 8935.74,
      "formatted_start": "02:28:51.740",
      "formatted_end": "02:28:55.740",
      "text": "وسط اینو نزدیکی نماشه، بعد از درازدارو هم نزدیکی نماشه"
    },
    {
      "id": 80,
      "start": 8935.74,
      "end": 8939.74,
      "formatted_start": "02:28:55.740",
      "formatted_end": "02:28:59.740",
      "text": "تا 20 تا مراجعه میکنیم، یادتر نشان داشته بشه"
    },
    {
      "id": 81,
      "start": 8939.74,
      "end": 8943.74,
      "formatted_start": "02:28:59.740",
      "formatted_end": "02:29:03.740",
      "text": "آقای دکتورو که میتونه ارتعام کنم؟ اختلاف کردیم با پارشگارو"
    },
    {
      "id": 82,
      "start": 8943.74,
      "end": 8945.74,
      "formatted_start": "02:29:03.740",
      "formatted_end": "02:29:05.740",
      "text": "شما هم گفت بری ارتعام کنیم"
    },
    {
      "id": 83,
      "start": 8945.74,
      "end": 8949.74,
      "formatted_start": "02:29:05.740",
      "formatted_end": "02:29:09.740",
      "text": "میگن که، خواستم اون درست پایموارو بهتون نشان کنم"
    },
    {
      "id": 84,
      "start": 8949.74,
      "end": 8951.74,
      "formatted_start": "02:29:09.740",
      "formatted_end": "02:29:11.740",
      "text": "اما از خیلی من مشکلی ندارم بگیرم"
    },
    {
      "id": 85,
      "start": 8951.74,
      "end": 8955.74,
      "formatted_start": "02:29:11.740",
      "formatted_end": "02:29:15.740",
      "text": "میگن که شهر رویان رو یک دکتر دیگه پیدا کردیم اونجا بیا بریم"
    },
    {
      "id": 86,
      "start": 8955.74,
      "end": 8957.74,
      "formatted_start": "02:29:15.740",
      "formatted_end": "02:29:17.740",
      "text": "اسم دکتر رو بگیرم اگر خوب باشیم بگیرم بریم"
    },
    {
      "id": 87,
      "start": 8957.74,
      "end": 8959.74,
      "formatted_start": "02:29:17.740",
      "formatted_end": "02:29:19.740",
      "text": "اسم دکتر رو نه پرسیدم"
    },
    {
      "id": 88,
      "start": 8959.74,
      "end": 8963.74,
      "formatted_start": "02:29:19.740",
      "formatted_end": "02:29:23.740",
      "text": "ولی ما جوابش نوشتیم که پس اونو مثلا دو ماه اینجا برم سه ماه اونجا برم"
    },
    {
      "id": 89,
      "start": 8963.74,
      "end": 8965.74,
      "formatted_start": "02:29:23.740",
      "formatted_end": "02:29:25.740",
      "text": "یه جا برم نتیجه بگیرم"
    },
    {
      "id": 90,
      "start": 8965.74,
      "end": 8967.74,
      "formatted_start": "02:29:25.740",
      "formatted_end": "02:29:27.740",
      "text": "شما الآن داری اون"
    },
    {
      "id": 91,
      "start": 8967.74,
      "end": 8975.74,
      "formatted_start": "02:29:27.740",
      "formatted_end": "02:29:35.740",
      "text": "بعد سریع باشه هم بقص موشک میگن که نه هیرمیان اونها توی دربار طولانی میخونه بخاطر ویزیتش و اینها بخاطر کنن که پرسال هم همینجور کنن"
    },
    {
      "id": 92,
      "start": 8975.74,
      "end": 8980.74,
      "formatted_start": "02:29:35.740",
      "formatted_end": "02:29:40.740",
      "text": "نه هیرمیان چیز کاری نمی کنه، قسم می کنم، چیز کاری به جا رو بچه هم قسم می کنم"
    },
    {
      "id": 93,
      "start": 8980.74,
      "end": 8983.74,
      "formatted_start": "02:29:40.740",
      "formatted_end": "02:29:43.740",
      "text": "نه ما اینکه می کنیم، نه ما می گویم تنها می آفیرن دیگه"
    },
    {
      "id": 94,
      "start": 8983.74,
      "end": 8989.74,
      "formatted_start": "02:29:43.740",
      "formatted_end": "02:29:49.740",
      "text": "نه با شما، نه با شما، نه با هیچ کسی دیگه در اون رو هم چیز کاری نکردن"
    },
    {
      "id": 95,
      "start": 8989.74,
      "end": 8996.42,
      "formatted_start": "02:29:49.740",
      "formatted_end": "02:29:56.420",
      "text": "اولا چه این تصبیح در مورد هرمیان باطله درک بزنید"
    },
    {
      "id": 96,
      "start": 8996.42,
      "end": 8998.98,
      "formatted_start": "02:29:56.420",
      "formatted_end": "02:29:58.980",
      "text": "شما هرچی زودتر بردارید"
    }
  ],
  "status": "completed"
}