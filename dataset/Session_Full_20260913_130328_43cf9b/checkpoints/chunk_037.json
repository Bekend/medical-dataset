  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11108.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:08.000",
      "text": "خبر احلکار زیاد نداریم، همین میشه جنبهای تشکیلی."
    },
    {
      "id": 1,
      "start": 11108.0,
      "end": 11115.0,
      "formatted_start": "03:05:08.000",
      "formatted_end": "03:05:15.000",
      "text": "مثلا بالا دست خودشونو میخواند، دکتر بارد، شباب جسد رو دیده از جنبهای بینیم، شباب خود مردم بگن،"
    },
    {
      "id": 2,
      "start": 11115.0,
      "end": 11126.0,
      "formatted_start": "03:05:15.000",
      "formatted_end": "03:05:26.000",
      "text": "نداره هایی کسی که رفته تو شعر داره خوش بده، منظر ندارم، دینم نفرمم، آش مخورد، باغاری مخورد، چای مخورد، آقا فشار مخورد، بگیری چی بشه؟"
    },
    {
      "id": 3,
      "start": 11126.0,
      "end": 11128.0,
      "formatted_start": "03:05:26.000",
      "formatted_end": "03:05:28.000",
      "text": "شهرون برد می کنند"
    },
    {
      "id": 4,
      "start": 11128.0,
      "end": 11130.0,
      "formatted_start": "03:05:28.000",
      "formatted_end": "03:05:30.000",
      "text": "شهرون برد می کنند"
    },
    {
      "id": 5,
      "start": 11130.0,
      "end": 11132.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:32.000",
      "text": "خدای من این کار شما می گوینم برم"
    },
    {
      "id": 6,
      "start": 11132.0,
      "end": 11134.0,
      "formatted_start": "03:05:32.000",
      "formatted_end": "03:05:34.000",
      "text": "آخر اینکه اینکه اونجا مقابل ندارم"
    },
    {
      "id": 7,
      "start": 11134.0,
      "end": 11136.0,
      "formatted_start": "03:05:34.000",
      "formatted_end": "03:05:36.000",
      "text": "به خدای بردن علمی هست"
    },
    {
      "id": 8,
      "start": 11136.0,
      "end": 11138.0,
      "formatted_start": "03:05:36.000",
      "formatted_end": "03:05:38.000",
      "text": "بهترینه دارم"
    },
    {
      "id": 9,
      "start": 11138.0,
      "end": 11140.0,
      "formatted_start": "03:05:38.000",
      "formatted_end": "03:05:40.000",
      "text": "این یکی برد دو دیگه"
    },
    {
      "id": 10,
      "start": 11140.0,
      "end": 11142.0,
      "formatted_start": "03:05:40.000",
      "formatted_end": "03:05:42.000",
      "text": "یک رو بزرگ کنید"
    },
    {
      "id": 11,
      "start": 11142.0,
      "end": 11144.0,
      "formatted_start": "03:05:42.000",
      "formatted_end": "03:05:44.000",
      "text": "یک رو بزرگ کنید"
    },
    {
      "id": 12,
      "start": 11144.0,
      "end": 11146.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:46.000",
      "text": "یک رو بزرگ کنید"
    },
    {
      "id": 13,
      "start": 11146.0,
      "end": 11148.0,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:48.000",
      "text": "یک اده هستم"
    },
    {
      "id": 14,
      "start": 11148.0,
      "end": 11150.0,
      "formatted_start": "03:05:48.000",
      "formatted_end": "03:05:50.000",
      "text": "ارتباطات سیاسی دارم"
    },
    {
      "id": 15,
      "start": 11150.0,
      "end": 11152.0,
      "formatted_start": "03:05:50.000",
      "formatted_end": "03:05:52.000",
      "text": "اینکه اونو خواهی ندارم"
    },
    {
      "id": 16,
      "start": 11152.0,
      "end": 11154.0,
      "formatted_start": "03:05:52.000",
      "formatted_end": "03:05:54.000",
      "text": "یا دکتوری بجا بکنه"
    },
    {
      "id": 17,
      "start": 11154.0,
      "end": 11162.0,
      "formatted_start": "03:05:54.000",
      "formatted_end": "03:06:02.000",
      "text": "این بردار نمی کنه. شما باید نیروار رو با اون ببینید اونجا وقتشون رو میگینید. اعتبار اون عرضش کالشون رو بردارید."
    },
    {
      "id": 18,
      "start": 11162.0,
      "end": 11170.0,
      "formatted_start": "03:06:02.000",
      "formatted_end": "03:06:10.000",
      "text": "ما الان مثلا باید از آرودگی چاه های آب پیش گیریم. چه کاری بود این کار آب؟"
    },
    {
      "id": 19,
      "start": 11170.0,
      "end": 11176.0,
      "formatted_start": "03:06:10.000",
      "formatted_end": "03:06:16.000",
      "text": "بعضی فیلمون رو درست انجام میگیرد. دوستای ما رفتون آلمان پزشکتر."
    },
    {
      "id": 20,
      "start": 11176.0,
      "end": 11181.0,
      "formatted_start": "03:06:16.000",
      "formatted_end": "03:06:21.000",
      "text": "بعد با یک پزشک دیگه آلمانی با هم رفته بودم بیمار استم"
    },
    {
      "id": 21,
      "start": 11181.0,
      "end": 11186.0,
      "formatted_start": "03:06:21.000",
      "formatted_end": "03:06:26.000",
      "text": "صبح زودتر رفته بودم مثلا ساعت 8 باید بیاخته بودم هفته رو رفته بودم"
    },
    {
      "id": 22,
      "start": 11186.0,
      "end": 11192.0,
      "formatted_start": "03:06:26.000",
      "formatted_end": "03:06:32.000",
      "text": "بعد ماشینم گفته خب بریم اون جلو پارکینگ همون اولی پارکینگ بذاریم بگیر نزدیک داریم"
    },
    {
      "id": 23,
      "start": 11192.0,
      "end": 11196.0,
      "formatted_start": "03:06:32.000",
      "formatted_end": "03:06:36.000",
      "text": "گفتی نه ما زود آمدیم ما بذاریم دور بذاریم"
    },
    {
      "id": 24,
      "start": 11196.0,
      "end": 11202.0,
      "formatted_start": "03:06:36.000",
      "formatted_end": "03:06:42.000",
      "text": "کارمانی گفتی اون کسی که دیر میاد بره جلو در بذاری که زودتر به کارت برسه"
    },
    {
      "id": 25,
      "start": 11202.0,
      "end": 11206.0,
      "formatted_start": "03:06:42.000",
      "formatted_end": "03:06:46.000",
      "text": "برسته مهرم وقت داریم دیگه میریم دیر بیریم"
    },
    {
      "id": 26,
      "start": 11206.0,
      "end": 11212.0,
      "formatted_start": "03:06:46.000",
      "formatted_end": "03:06:52.000",
      "text": "ببین این رعایت زود آمده رعایت دیر آمده رو داره می کنیم"
    },
    {
      "id": 27,
      "start": 11212.0,
      "end": 11216.0,
      "formatted_start": "03:06:52.000",
      "formatted_end": "03:06:56.000",
      "text": "ما وقت زود آمده میریم برو باید کسی که دیر آمده"
    },
    {
      "id": 28,
      "start": 11216.0,
      "end": 11220.0,
      "formatted_start": "03:06:56.000",
      "formatted_end": "03:07:00.000",
      "text": "من باید من بیرم آه جروتر من که زود آمده هم جروتر"
    },
    {
      "id": 29,
      "start": 11220.0,
      "end": 11223.0,
      "formatted_start": "03:07:00.000",
      "formatted_end": "03:07:03.000",
      "text": "اصلا کسی هم بیرون اعتراض نیم گویم گریه باید باید زود آمده"
    },
    {
      "id": 30,
      "start": 11223.0,
      "end": 11228.0,
      "formatted_start": "03:07:03.000",
      "formatted_end": "03:07:08.000",
      "text": "اینکه از که الان تو ایران دیر آمده باشه اصلا توخه نداره کسی براش جا نگردش کشه"
    },
    {
      "id": 31,
      "start": 11228.0,
      "end": 11232.0,
      "formatted_start": "03:07:08.000",
      "formatted_end": "03:07:12.000",
      "text": "میگه که من دیر آمدم خوب برقبخت هستم یا باید برامون آخر بزنم"
    },
    {
      "id": 32,
      "start": 11232.0,
      "end": 11237.0,
      "formatted_start": "03:07:12.000",
      "formatted_end": "03:07:17.000",
      "text": "قیل از اینکه دیر آمدم مثلا مشکلی پیش آمده دیر آمده باشی رو پنجنگ کرده تصادفی کردن"
    },
    {
      "id": 33,
      "start": 11237.0,
      "end": 11240.0,
      "formatted_start": "03:07:17.000",
      "formatted_end": "03:07:20.000",
      "text": "بچه هم معیز شده دیر آمده بگیر"
    },
    {
      "id": 34,
      "start": 11240.0,
      "end": 11245.0,
      "formatted_start": "03:07:20.000",
      "formatted_end": "03:07:25.000",
      "text": "حالا که دیر آمده باید دورتر هم بزنم بودو بودو بیار دوتو کوچو اوبرتر"
    },
    {
      "id": 35,
      "start": 11245.0,
      "end": 11247.82,
      "formatted_start": "03:07:25.000",
      "formatted_end": "03:07:27.820",
      "text": "تا کارت بکشن باز دیرتر دیرتر هم میشه"
    },
    {
      "id": 36,
      "start": 11247.82,
      "end": 11248.46,
      "formatted_start": "03:07:27.820",
      "formatted_end": "03:07:28.460",
      "text": "دیرتر میشن"
    },
    {
      "id": 37,
      "start": 11248.46,
      "end": 11250.78,
      "formatted_start": "03:07:28.460",
      "formatted_end": "03:07:30.780",
      "text": "اما اینهایی که زود آمدن"
    },
    {
      "id": 38,
      "start": 11250.78,
      "end": 11252.94,
      "formatted_start": "03:07:30.780",
      "formatted_end": "03:07:32.940",
      "text": "اونجا در آلمان راقعیت"
    },
    {
      "id": 39,
      "start": 11252.94,
      "end": 11255.18,
      "formatted_start": "03:07:32.940",
      "formatted_end": "03:07:35.180",
      "text": "اون فرد دیگر را می کنن"
    },
    {
      "id": 40,
      "start": 11255.18,
      "end": 11256.82,
      "formatted_start": "03:07:35.180",
      "formatted_end": "03:07:36.820",
      "text": "این میشه نقلوستی"
    },
    {
      "id": 41,
      "start": 11256.82,
      "end": 11259.44,
      "formatted_start": "03:07:36.820",
      "formatted_end": "03:07:39.440",
      "text": "ما این را توی چه مکتبی"
    },
    {
      "id": 42,
      "start": 11259.44,
      "end": 11260.74,
      "formatted_start": "03:07:39.440",
      "formatted_end": "03:07:40.740",
      "text": "میتونیم پیاده بکنیم"
    },
    {
      "id": 43,
      "start": 11260.74,
      "end": 11263.48,
      "formatted_start": "03:07:40.740",
      "formatted_end": "03:07:43.480",
      "text": "که آیندگان ما این کار را بکنن"
    },
    {
      "id": 44,
      "start": 11263.48,
      "end": 11265.0,
      "formatted_start": "03:07:43.480",
      "formatted_end": "03:07:45.000",
      "text": "ما"
    },
    {
      "id": 45,
      "start": 11265.0,
      "end": 11267.36,
      "formatted_start": "03:07:45.000",
      "formatted_end": "03:07:47.360",
      "text": "اصلا توی جرافیت به هم راق نمیدیم"
    },
    {
      "id": 46,
      "start": 11267.36,
      "end": 11268.26,
      "formatted_start": "03:07:47.360",
      "formatted_end": "03:07:48.260",
      "text": "نمیدیم"
    },
    {
      "id": 47,
      "start": 11268.26,
      "end": 11270.74,
      "formatted_start": "03:07:48.260",
      "formatted_end": "03:07:50.740",
      "text": "که تا چه رسط به این که زودتر میریم"
    },
    {
      "id": 48,
      "start": 11270.74,
      "end": 11276.74,
      "formatted_start": "03:07:50.740",
      "formatted_end": "03:07:56.740",
      "text": "برای کسی که دیگر تر میاد بگیم نه بذار چرا بازمازاریم که اون بدبخته بیاد اقلی بتونه جا"
    },
    {
      "id": 49,
      "start": 11276.74,
      "end": 11283.74,
      "formatted_start": "03:07:56.740",
      "formatted_end": "03:08:03.740",
      "text": "این میگه اصلا من تزور مسلمان که که خوشحالان بیاد همه اش گیرم حضیت رو بگردم"
    },
    {
      "id": 50,
      "start": 11283.74,
      "end": 11292.74,
      "formatted_start": "03:08:03.740",
      "formatted_end": "03:08:12.740",
      "text": "علت اینکه ما بدبختیم همینه اصلا همینه ما میخوایم که جودتر بیاد جای کسی رو بگیریم"
    },
    {
      "id": 51,
      "start": 11292.74,
      "end": 11298.74,
      "formatted_start": "03:08:12.740",
      "formatted_end": "03:08:18.740",
      "text": "نمیخوایم بیاد برای کسی جانگردیم اصلا چرا ما اینکه نه اصلای میدیم"
    },
    {
      "id": 52,
      "start": 11298.74,
      "end": 11304.74,
      "formatted_start": "03:08:18.740",
      "formatted_end": "03:08:24.740",
      "text": "بنایی که مال جان مایی ها میدیم که این رو تمرین بکنیم"
    },
    {
      "id": 53,
      "start": 11304.74,
      "end": 11309.74,
      "formatted_start": "03:08:24.740",
      "formatted_end": "03:08:29.740",
      "text": "دادن رو به دیگران خدمت کردن و بخشیدن رو تمرین بکنیم"
    },
    {
      "id": 54,
      "start": 11309.74,
      "end": 11314.74,
      "formatted_start": "03:08:29.740",
      "formatted_end": "03:08:34.740",
      "text": "همگون میدیم چکار کنیم؟ نصیبونی میدیم، میدیم باز دوباره تو ترافیک را نمیدیم"
    },
    {
      "id": 55,
      "start": 11314.74,
      "end": 11319.74,
      "formatted_start": "03:08:34.740",
      "formatted_end": "03:08:39.740",
      "text": "خدا تیه کیه دیگه؟ دیگه چون پلو داردی، خب دستت درن کن"
    },
    {
      "id": 56,
      "start": 11319.74,
      "end": 11325.74,
      "formatted_start": "03:08:39.740",
      "formatted_end": "03:08:45.740",
      "text": "اما اینجا چرا راه ها نمیدی؟ راه میبنده، زودتر میده چون او نتونه بیاد"
    },
    {
      "id": 57,
      "start": 11325.74,
      "end": 11327.74,
      "formatted_start": "03:08:45.740",
      "formatted_end": "03:08:47.740",
      "text": "تمام دیگر مدیونیت داره بیشتر"
    },
    {
      "id": 58,
      "start": 11327.74,
      "end": 11334.74,
      "formatted_start": "03:08:47.740",
      "formatted_end": "03:08:54.740",
      "text": "ولی ما یک فرهنگ غیر الهی اونجا توی سر این رو فکر کنن"
    },
    {
      "id": 59,
      "start": 11334.74,
      "end": 11336.74,
      "formatted_start": "03:08:54.740",
      "formatted_end": "03:08:56.740",
      "text": "نهادیله کنن"
    },
    {
      "id": 60,
      "start": 11336.74,
      "end": 11339.74,
      "formatted_start": "03:08:56.740",
      "formatted_end": "03:08:59.740",
      "text": "ما نمیتونیم این رو نهادیله بکنیم"
    },
    {
      "id": 61,
      "start": 11339.74,
      "end": 11341.74,
      "formatted_start": "03:08:59.740",
      "formatted_end": "03:09:01.740",
      "text": "یعنی اصلا نمیتونیم این رو یه فرهنگ بکنیم"
    },
    {
      "id": 62,
      "start": 11341.74,
      "end": 11344.74,
      "formatted_start": "03:09:01.740",
      "formatted_end": "03:09:04.740",
      "text": "چون در بزرگ سالی شروع می کنیم"
    },
    {
      "id": 63,
      "start": 11344.74,
      "end": 11347.74,
      "formatted_start": "03:09:04.740",
      "formatted_end": "03:09:07.740",
      "text": "ما در تشوریت باید این رو"
    },
    {
      "id": 64,
      "start": 11347.74,
      "end": 11350.74,
      "formatted_start": "03:09:07.740",
      "formatted_end": "03:09:10.740",
      "text": "یعنی مادر باید بذاره دهان بچه اش"
    },
    {
      "id": 65,
      "start": 11350.74,
      "end": 11352.74,
      "formatted_start": "03:09:10.740",
      "formatted_end": "03:09:12.740",
      "text": "مادر می کنه راست اول باید بذاره"
    },
    {
      "id": 66,
      "start": 11352.74,
      "end": 11354.74,
      "formatted_start": "03:09:12.740",
      "formatted_end": "03:09:14.740",
      "text": "دو هم بزرگ، سه هم بزرگ"
    },
    {
      "id": 67,
      "start": 11354.74,
      "end": 11359.74,
      "formatted_start": "03:09:14.740",
      "formatted_end": "03:09:19.740",
      "text": "تو اون موقع خوبی به خودت میتونی افتخار بکنی که به دیگر هم مفهوم شد"
    },
    {
      "id": 68,
      "start": 11359.74,
      "end": 11362.74,
      "formatted_start": "03:09:19.740",
      "formatted_end": "03:09:22.740",
      "text": "یه زمان یه چیزی داشتی مثل پیشاهنگی"
    },
    {
      "id": 69,
      "start": 11362.74,
      "end": 11370.74,
      "formatted_start": "03:09:22.740",
      "formatted_end": "03:09:30.740",
      "text": "باشه که پیشاهنگی هر روز یک کار نیکی"
    },
    {
      "id": 70,
      "start": 11370.74,
      "end": 11374.74,
      "formatted_start": "03:09:30.740",
      "formatted_end": "03:09:34.740",
      "text": "ما پیشاهنگی بودیم، گفتن رو امروز چه کار میکنی؟ جا بدی؟"
    },
    {
      "id": 71,
      "start": 11374.74,
      "end": 11376.74,
      "formatted_start": "03:09:34.740",
      "formatted_end": "03:09:36.740",
      "text": "دیروز چه کار میکنی؟ جا بدی؟"
    },
    {
      "id": 72,
      "start": 11376.74,
      "end": 11377.74,
      "formatted_start": "03:09:36.740",
      "formatted_end": "03:09:37.740",
      "text": "باید توضیح میدونیم"
    },
    {
      "id": 73,
      "start": 11377.74,
      "end": 11383.62,
      "formatted_start": "03:09:37.740",
      "formatted_end": "03:09:43.620",
      "text": "می گفتیم دیوز مثلا می گه می روزنید ما ثبت سنگیر یا آرامی برد نمی توانست"
    },
    {
      "id": 74,
      "start": 11383.62,
      "end": 11385.42,
      "formatted_start": "03:09:43.620",
      "formatted_end": "03:09:45.420",
      "text": "ما گرفتیم بهش و مکنه"
    },
    {
      "id": 75,
      "start": 11385.42,
      "end": 11387.42,
      "formatted_start": "03:09:45.420",
      "formatted_end": "03:09:47.420",
      "text": "آفرین بله باز دوباره"
    },
    {
      "id": 76,
      "start": 11387.42,
      "end": 11388.46,
      "formatted_start": "03:09:47.420",
      "formatted_end": "03:09:48.460",
      "text": "زمان شما گفتید دیگه؟"
    },
    {
      "id": 77,
      "start": 11388.46,
      "end": 11388.78,
      "formatted_start": "03:09:48.460",
      "formatted_end": "03:09:48.780",
      "text": "بله"
    },
    {
      "id": 78,
      "start": 11388.78,
      "end": 11389.66,
      "formatted_start": "03:09:48.780",
      "formatted_end": "03:09:49.660",
      "text": "بله گفتید که اینجوری"
    },
    {
      "id": 79,
      "start": 11389.66,
      "end": 11391.06,
      "formatted_start": "03:09:49.660",
      "formatted_end": "03:09:51.060",
      "text": "چون چه کار میکنی که انجام بدی؟"
    },
    {
      "id": 80,
      "start": 11391.06,
      "end": 11392.74,
      "formatted_start": "03:09:51.060",
      "formatted_end": "03:09:52.740",
      "text": "گفتیم بله این کار میکنجام بدی"
    },
    {
      "id": 81,
      "start": 11392.74,
      "end": 11393.9,
      "formatted_start": "03:09:52.740",
      "formatted_end": "03:09:53.900",
      "text": "اون کار میکنجام بدی"
    },
    {
      "id": 82,
      "start": 11393.9,
      "end": 11396.54,
      "formatted_start": "03:09:53.900",
      "formatted_end": "03:09:56.540",
      "text": "خب هر روز باید این کار میکنجام بیادید"
    },
    {
      "id": 83,
      "start": 11396.54,
      "end": 11397.62,
      "formatted_start": "03:09:56.540",
      "formatted_end": "03:09:57.620",
      "text": "و گزارش میکنید"
    },
    {
      "id": 84,
      "start": 11397.62,
      "end": 11399.98,
      "formatted_start": "03:09:57.620",
      "formatted_end": "03:09:59.980",
      "text": "مرده از ممنون پوسته که بسره هستید"
    }
  ],
  "status": "completed"
}