  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12604.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:04.000",
      "text": "نمیدونم با خالی نازی باید بزنن به چاک یه دقیقه."
    },
    {
      "id": 1,
      "start": 12604.0,
      "end": 12606.0,
      "formatted_start": "03:30:04.000",
      "formatted_end": "03:30:06.000",
      "text": "برای آقا هست؟ برای شما هست؟"
    },
    {
      "id": 2,
      "start": 12606.0,
      "end": 12608.0,
      "formatted_start": "03:30:06.000",
      "formatted_end": "03:30:08.000",
      "text": "نه خالی نیست، خالی آقا هست."
    },
    {
      "id": 3,
      "start": 12608.0,
      "end": 12609.0,
      "formatted_start": "03:30:08.000",
      "formatted_end": "03:30:09.000",
      "text": "نه نه نه."
    },
    {
      "id": 4,
      "start": 12609.0,
      "end": 12610.0,
      "formatted_start": "03:30:09.000",
      "formatted_end": "03:30:10.000",
      "text": "اصلا شماره نمیگیره؟"
    },
    {
      "id": 5,
      "start": 12610.0,
      "end": 12611.0,
      "formatted_start": "03:30:10.000",
      "formatted_end": "03:30:11.000",
      "text": "نه."
    },
    {
      "id": 6,
      "start": 12612.0,
      "end": 12615.0,
      "formatted_start": "03:30:12.000",
      "formatted_end": "03:30:15.000",
      "text": "او شماره نگیره که نمیشه که خالی نازی شماره شما باشه."
    },
    {
      "id": 7,
      "start": 12615.0,
      "end": 12619.0,
      "formatted_start": "03:30:15.000",
      "formatted_end": "03:30:19.000",
      "text": "بگو بیا، بله یکی کسی، بیا دیجا من بگمش بگم."
    },
    {
      "id": 8,
      "start": 12619.0,
      "end": 12623.16,
      "formatted_start": "03:30:19.000",
      "formatted_end": "03:30:23.160",
      "text": "نه بگو خاللازی مریض که میاره شماره میگیرند"
    },
    {
      "id": 9,
      "start": 12623.16,
      "end": 12624.84,
      "formatted_start": "03:30:23.160",
      "formatted_end": "03:30:24.840",
      "text": "اینجوری نیستش که شماره نگیرند"
    },
    {
      "id": 10,
      "start": 12624.84,
      "end": 12626.66,
      "formatted_start": "03:30:24.840",
      "formatted_end": "03:30:26.660",
      "text": "بله زیاد خاللازی مریض میگیرند"
    },
    {
      "id": 11,
      "start": 12626.66,
      "end": 12628.46,
      "formatted_start": "03:30:26.660",
      "formatted_end": "03:30:28.460",
      "text": "آقای اتاتالی"
    },
    {
      "id": 12,
      "start": 12628.46,
      "end": 12631.96,
      "formatted_start": "03:30:28.460",
      "formatted_end": "03:30:31.960",
      "text": "خاللازی معرفی کرده شماره باید بگیرید"
    },
    {
      "id": 13,
      "start": 12631.96,
      "end": 12633.88,
      "formatted_start": "03:30:31.960",
      "formatted_end": "03:30:33.880",
      "text": "خاللازی برای بیمون بسته"
    },
    {
      "id": 14,
      "start": 12633.88,
      "end": 12635.14,
      "formatted_start": "03:30:33.880",
      "formatted_end": "03:30:35.140",
      "text": "اشون مریض در مره خوده"
    },
    {
      "id": 15,
      "start": 12635.14,
      "end": 12637.4,
      "formatted_start": "03:30:35.140",
      "formatted_end": "03:30:37.400",
      "text": "میدونم میگه خاللازی گفته"
    },
    {
      "id": 16,
      "start": 12637.4,
      "end": 12639.32,
      "formatted_start": "03:30:37.400",
      "formatted_end": "03:30:39.320",
      "text": "خاللازی کسی نیست داره من که"
    },
    {
      "id": 17,
      "start": 12639.32,
      "end": 12641.62,
      "formatted_start": "03:30:39.320",
      "formatted_end": "03:30:41.620",
      "text": "اشون بیماریاشو برای من میفرسته"
    },
    {
      "id": 18,
      "start": 12641.62,
      "end": 12643.3,
      "formatted_start": "03:30:41.620",
      "formatted_end": "03:30:43.300",
      "text": "سی ساله که مریض ها رو میفرسته"
    },
    {
      "id": 19,
      "start": 12643.3,
      "end": 12645.3,
      "formatted_start": "03:30:43.300",
      "formatted_end": "03:30:45.300",
      "text": "برای آمرانیتون شعاره میگیرند"
    },
    {
      "id": 20,
      "start": 12645.3,
      "end": 12647.3,
      "formatted_start": "03:30:45.300",
      "formatted_end": "03:30:47.300",
      "text": "نه میگید باید رنگ بزن"
    },
    {
      "id": 21,
      "start": 12647.3,
      "end": 12649.3,
      "formatted_start": "03:30:47.300",
      "formatted_end": "03:30:49.300",
      "text": "اون به من یاد نمیده که"
    },
    {
      "id": 22,
      "start": 12649.3,
      "end": 12651.3,
      "formatted_start": "03:30:49.300",
      "formatted_end": "03:30:51.300",
      "text": "اون به من میگه که این برسیره داره"
    },
    {
      "id": 23,
      "start": 12651.3,
      "end": 12653.3,
      "formatted_start": "03:30:51.300",
      "formatted_end": "03:30:53.300",
      "text": "متوجه هم حرف میزنید شما"
    },
    {
      "id": 24,
      "start": 12653.3,
      "end": 12655.3,
      "formatted_start": "03:30:53.300",
      "formatted_end": "03:30:55.300",
      "text": "برای کار نوره"
    },
    {
      "id": 25,
      "start": 12655.3,
      "end": 12657.3,
      "formatted_start": "03:30:55.300",
      "formatted_end": "03:30:57.300",
      "text": "حالا انجام بدید"
    },
    {
      "id": 26,
      "start": 12657.3,
      "end": 12659.3,
      "formatted_start": "03:30:57.300",
      "formatted_end": "03:30:59.300",
      "text": "باید برو شما"
    },
    {
      "id": 27,
      "start": 12659.3,
      "end": 12661.3,
      "formatted_start": "03:30:59.300",
      "formatted_end": "03:31:01.300",
      "text": "آقای فروندی"
    },
    {
      "id": 28,
      "start": 12661.3,
      "end": 12663.3,
      "formatted_start": "03:31:01.300",
      "formatted_end": "03:31:03.300",
      "text": "آقای فروندی سیاتیک داشتند"
    },
    {
      "id": 29,
      "start": 12663.3,
      "end": 12665.3,
      "formatted_start": "03:31:03.300",
      "formatted_end": "03:31:05.300",
      "text": "آقای فروندی سیاتیک داشتند"
    },
    {
      "id": 30,
      "start": 12665.3,
      "end": 12667.3,
