    },
    {
      "id": 39,
      "start": 3651.0,
      "end": 3653.0,
      "formatted_start": "01:00:51.000",
      "formatted_end": "01:00:53.000",
      "text": "بیس مورد"
    },
    {
      "id": 40,
      "start": 3653.0,
      "end": 3655.0,
      "formatted_start": "01:00:53.000",
      "formatted_end": "01:00:55.000",
      "text": "بیس مورد"
    },
    {
      "id": 41,
      "start": 3655.0,
      "end": 3657.0,
      "formatted_start": "01:00:55.000",
      "formatted_end": "01:00:57.000",
      "text": "بیس مورد"
    },
    {
      "id": 42,
      "start": 3657.0,
      "end": 3659.0,
      "formatted_start": "01:00:57.000",
      "formatted_end": "01:00:59.000",
      "text": "بچه سیره شد نه ترسی"
    },
    {
      "id": 43,
      "start": 3659.0,
      "end": 3661.0,
      "formatted_start": "01:00:59.000",
      "formatted_end": "01:01:01.000",
      "text": "سی تا سیره شد"
    },
    {
      "id": 44,
      "start": 3661.0,
      "end": 3663.0,
      "formatted_start": "01:01:01.000",
      "formatted_end": "01:01:03.000",
      "text": "اومدت که جرد شد"
    },
    {
      "id": 45,
      "start": 3663.0,
      "end": 3665.0,
      "formatted_start": "01:01:03.000",
      "formatted_end": "01:01:05.000",
      "text": "اما همه مالی منبت شدی؟"
    },
    {
      "id": 46,
      "start": 3665.0,
      "end": 3667.0,
      "formatted_start": "01:01:05.000",
      "formatted_end": "01:01:07.000",
      "text": "برنامه"
    },
    {
      "id": 47,
      "start": 3667.0,
      "end": 3669.0,
      "formatted_start": "01:01:07.000",
      "formatted_end": "01:01:09.000",
      "text": "برنامه"
    },
    {
      "id": 48,
      "start": 3669.0,
      "end": 3671.0,
      "formatted_start": "01:01:09.000",
      "formatted_end": "01:01:11.000",
      "text": "اون هم کار پولشه"
    },
    {
      "id": 49,
      "start": 3671.0,
      "end": 3673.0,
      "formatted_start": "01:01:11.000",
      "formatted_end": "01:01:13.000",
      "text": "پولش هم میده داره"
    },
    {
      "id": 50,
      "start": 3673.0,
      "end": 3675.0,
      "formatted_start": "01:01:13.000",
      "formatted_end": "01:01:15.000",
      "text": "این بیچارو دارن جامع میکنه"
    },
    {
      "id": 51,
      "start": 3675.0,
      "end": 3677.0,
      "formatted_start": "01:01:15.000",
      "formatted_end": "01:01:17.000",
      "text": "هیچ دوره یه زخم بکنه"
    },
    {
      "id": 52,
      "start": 3677.0,
      "end": 3679.0,
      "formatted_start": "01:01:17.000",
      "formatted_end": "01:01:19.000",
      "text": "میره از آنها داره"
    },
    {
      "id": 53,
      "start": 3679.0,
      "end": 3681.0,
      "formatted_start": "01:01:19.000",
      "formatted_end": "01:01:21.000",
      "text": "تو دلش میده کهی میره این بست"
    },
    {
      "id": 54,
      "start": 3681.0,
      "end": 3683.0,
      "formatted_start": "01:01:21.000",
      "formatted_end": "01:01:23.000",
      "text": "اون رو بردش"
    },
    {
      "id": 55,
      "start": 3683.0,
      "end": 3685.0,
      "formatted_start": "01:01:23.000",
      "formatted_end": "01:01:25.000",
      "text": "چون اون رو پرد اون رو درم داشته"
    },
    {
      "id": 56,
      "start": 3685.0,
      "end": 3688.0,
      "formatted_start": "01:01:25.000",
      "formatted_end": "01:01:28.000",
      "text": "میده خراب بوده نه بوده جهان"
    },
    {
      "id": 57,
      "start": 3688.0,
      "end": 3693.0,
      "formatted_start": "01:01:28.000",
      "formatted_end": "01:01:33.000",
      "text": "با شربت میده بخورو اون چیزها رو شربت داری یا کپسول میده یا فورس میده"
    },
    {
      "id": 58,
      "start": 3693.0,
      "end": 3696.0,
      "formatted_start": "01:01:33.000",
      "formatted_end": "01:01:36.000",
      "text": "آرزو راستی من اینجور در اینجور استفاده کردم"
    },
    {
      "id": 59,
      "start": 3696.0,
      "end": 3698.0,
      "formatted_start": "01:01:36.000",
      "formatted_end": "01:01:38.000",
      "text": "خیلی خوبه داری"
    },
    {
      "id": 60,
      "start": 3698.0,
      "end": 3702.0,
      "formatted_start": "01:01:38.000",
      "formatted_end": "01:01:42.000",
      "text": "چی کار نداره؟ من همونی که استفاده کردم میدم کلونش با هم"
    },
    {
      "id": 61,
      "start": 3702.0,
      "end": 3704.0,
      "formatted_start": "01:01:42.000",
      "formatted_end": "01:01:44.000",
      "text": "الان بعد از رای ما نمیداده بود"
    },
    {
      "id": 62,
      "start": 3704.0,
      "end": 3707.0,
      "formatted_start": "01:01:44.000",
      "formatted_end": "01:01:47.000",
      "text": "نه نه نه من رسیدم به چرا قرمز تا من رسیدم سرس شد"
    },
    {
      "id": 63,
      "start": 3707.0,
      "end": 3709.0,
      "formatted_start": "01:01:47.000",
      "formatted_end": "01:01:49.000",
      "text": "من فکر کردم اون زمان رو باید بگذاریم"
    },
    {
      "id": 64,
      "start": 3709.0,
      "end": 3715.0,
      "formatted_start": "01:01:49.000",
      "formatted_end": "01:01:55.000",
      "text": "نه، دایی میتونی کن چیزی میزرد، نه نه نه نه"
    },
    {
      "id": 65,
      "start": 3715.0,
      "end": 3724.0,
      "formatted_start": "01:01:55.000",
      "formatted_end": "01:02:04.000",
      "text": "عرق دلگان خوشکرده بود، یک گچه بیخواسیتی که توش عرق نه نه رو حل کرده"
    },
    {
      "id": 66,
      "start": 3724.0,
      "end": 3731.0,
      "formatted_start": "01:02:04.000",
      "formatted_end": "01:02:11.000",
      "text": "دایی میتونی کن جمیدنی، اون یکی هم که استاره دایی میتونی کنه، این استاره نه نه"
    },
    {
      "id": 67,
      "start": 3731.0,
      "end": 3734.0,
      "formatted_start": "01:02:11.000",
      "formatted_end": "01:02:14.000",
      "text": "چیز نیست، نگران نمیشه"
    },
    {
      "id": 68,
      "start": 3734.0,
      "end": 3740.0,
      "formatted_start": "01:02:14.000",
      "formatted_end": "01:02:20.000",
      "text": "اوسترالی نمی کنند و در آن همه شما باید گراه می کنند."
    },
    {
      "id": 69,
      "start": 3740.0,
      "end": 3742.0,
      "formatted_start": "01:02:20.000",
      "formatted_end": "01:02:22.000",
      "text": "پایین این را دوست دارند؟"
    },
    {
      "id": 70,
      "start": 3742.0,
      "end": 3746.0,
      "formatted_start": "01:02:22.000",
      "formatted_end": "01:02:26.000",
      "text": "نه، کشیدن پرده ها را می آرند و اونجا سجاف می کنند."
    },
    {
      "id": 71,
      "start": 3746.0,
      "end": 3748.0,
      "formatted_start": "01:02:26.000",
      "formatted_end": "01:02:28.000",
      "text": "در اینجا هم می کنند و دوست دارند."
    },
    {
      "id": 72,
      "start": 3748.0,
      "end": 3750.0,
      "formatted_start": "01:02:28.000",
      "formatted_end": "01:02:30.000",
      "text": "سه لایه، چهار لایه را دوست دارند."
    },
    {
      "id": 73,
      "start": 3750.0,
      "end": 3754.0,
      "formatted_start": "01:02:30.000",
      "formatted_end": "01:02:34.000",
      "text": "اوسترالی نمی کنند و سه چهار لایه را با هم می زنند و دوست دارند"
    },
    {
      "id": 74,
      "start": 3754.0,
      "end": 3756.0,
      "formatted_start": "01:02:34.000",
      "formatted_end": "01:02:36.000",
      "text": "که این دردش بیشتر نمی باشد."
    },
    {
      "id": 75,
      "start": 3756.0,
      "end": 3758.0,
      "formatted_start": "01:02:36.000",
      "formatted_end": "01:02:38.000",
      "text": "آره چپیونی مانده یاده"
    },
    {
      "id": 76,
      "start": 3758.0,
      "end": 3760.0,
      "formatted_start": "01:02:38.000",
      "formatted_end": "01:02:40.000",
      "text": "آره بیتوست"
    },
    {
      "id": 77,
      "start": 3760.0,
      "end": 3762.0,
      "formatted_start": "01:02:40.000",
      "formatted_end": "01:02:42.000",
      "text": "حسین نمیکنه دستیاره بیتوست"
    },
    {
      "id": 78,
      "start": 3762.0,
      "end": 3764.0,
      "formatted_start": "01:02:42.000",
      "formatted_end": "01:02:44.000",
      "text": "نه اونجا شماره شده بود"
    },
    {
      "id": 79,
      "start": 3764.0,
      "end": 3766.0,
      "formatted_start": "01:02:44.000",
      "formatted_end": "01:02:46.000",
      "text": "توم توم گفتن بزرگ بزرگ"
    },
    {
      "id": 80,
      "start": 3766.0,
      "end": 3768.0,
      "formatted_start": "01:02:46.000",
      "formatted_end": "01:02:48.000",
      "text": "باید بیمیز نمکنه"
    },
    {
      "id": 81,
      "start": 3768.0,
      "end": 3770.0,
      "formatted_start": "01:02:48.000",
      "formatted_end": "01:02:50.000",
      "text": "همون رو باید دایمان کنم"
    },
    {
      "id": 82,
      "start": 3770.0,
      "end": 3772.0,
      "formatted_start": "01:02:50.000",
      "formatted_end": "01:02:52.000",
      "text": "بیامان چیه؟"
    },
    {
      "id": 83,
      "start": 3772.0,
      "end": 3774.0,
      "formatted_start": "01:02:52.000",
      "formatted_end": "01:02:54.000",
      "text": "نه بگه"
    },
    {
      "id": 84,
      "start": 3774.0,
      "end": 3776.0,
      "formatted_start": "01:02:54.000",
      "formatted_end": "01:02:56.000",
      "text": "پرداشت رو همون رو باید همون رو دایمان کنم"
    },
    {
      "id": 85,
      "start": 3776.0,
      "end": 3778.0,
      "formatted_start": "01:02:56.000",
      "formatted_end": "01:02:58.000",
      "text": "چی پنجه پنجه منجا و پنجه مون؟"
    },
    {
      "id": 86,
      "start": 3778.0,
      "end": 3780.0,
      "formatted_start": "01:02:58.000",
      "formatted_end": "01:03:00.000",
      "text": "پنجه آنها برد"
    },
    {
      "id": 87,
      "start": 3780.0,
      "end": 3782.0,
      "formatted_start": "01:03:00.000",
      "formatted_end": "01:03:02.000",
      "text": "پس این سیره"
    },
    {
      "id": 88,
      "start": 3782.0,
      "end": 3784.0,
      "formatted_start": "01:03:02.000",
      "formatted_end": "01:03:04.000",
      "text": "که فهم کنه جایی"
    },
    {
      "id": 89,
      "start": 3784.0,
      "end": 3786.0,
      "formatted_start": "01:03:04.000",
      "formatted_end": "01:03:06.000",
      "text": "این رو باید برداریم"
    },
    {
      "id": 90,
      "start": 3786.0,
      "end": 3788.0,
      "formatted_start": "01:03:06.000",
      "formatted_end": "01:03:08.000",
      "text": "نه، این رو باید برداریم"
    },
    {
      "id": 91,
      "start": 3788.0,
      "end": 3790.0,
      "formatted_start": "01:03:08.000",
      "formatted_end": "01:03:10.000",
      "text": "این رو باید برداریم"
    },
    {
      "id": 92,
      "start": 3790.0,
      "end": 3792.0,
      "formatted_start": "01:03:10.000",
      "formatted_end": "01:03:12.000",
      "text": "نه، این رو باید برداریم"
    },
    {
      "id": 93,
      "start": 3792.0,
      "end": 3794.0,
      "formatted_start": "01:03:12.000",
      "formatted_end": "01:03:14.000",
      "text": "نه، این رو باید برداریم"
    },
    {
      "id": 94,
      "start": 3794.0,
      "end": 3796.0,
      "formatted_start": "01:03:14.000",
      "formatted_end": "01:03:16.000",
      "text": "نه، این رو باید برداریم"
    },
    {
      "id": 95,
      "start": 3796.0,
