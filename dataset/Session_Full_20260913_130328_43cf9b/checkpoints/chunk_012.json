    },
    {
      "id": 28,
      "start": 3629.0,
      "end": 3631.0,
      "formatted_start": "01:00:29.000",
      "formatted_end": "01:00:31.000",
      "text": "کار یه ذره شیره کم ده"
    },
    {
      "id": 29,
      "start": 3631.0,
      "end": 3633.0,
      "formatted_start": "01:00:31.000",
      "formatted_end": "01:00:33.000",
