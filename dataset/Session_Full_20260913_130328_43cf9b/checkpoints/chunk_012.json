    },
    {
      "id": 33,
      "start": 3639.0,
      "end": 3641.0,
      "formatted_start": "01:00:39.000",
      "formatted_end": "01:00:41.000",
      "text": "بیس مورد چی؟"
    },
    {
      "id": 34,
      "start": 3641.0,
      "end": 3643.0,
      "formatted_start": "01:00:41.000",
      "formatted_end": "01:00:43.000",
      "text": "بیس مورد مدفوع بچه سیاه بکنه"
    },
    {
      "id": 35,
      "start": 3643.0,
      "end": 3645.0,
      "formatted_start": "01:00:43.000",
      "formatted_end": "01:00:45.000",
      "text": "بردارم دونت برداریم"
    },
    {
      "id": 36,
      "start": 3645.0,
      "end": 3647.0,
      "formatted_start": "01:00:45.000",
      "formatted_end": "01:00:47.000",
      "text": "بردارم دونت برداریم"
    },
    {
      "id": 37,
      "start": 3647.0,
      "end": 3649.0,
      "formatted_start": "01:00:47.000",
      "formatted_end": "01:00:49.000",
      "text": "داریم؟"
    },
    {
      "id": 38,
      "start": 3649.0,
      "end": 3651.0,
      "formatted_start": "01:00:49.000",
      "formatted_end": "01:00:51.000",
