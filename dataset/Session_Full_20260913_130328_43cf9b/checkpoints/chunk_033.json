  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9902.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:02.000",
      "text": "این بیشترین جایی که میرسه هست."
    },
    {
      "id": 1,
      "start": 9902.0,
      "end": 9904.0,
      "formatted_start": "02:45:02.000",
      "formatted_end": "02:45:04.000",
      "text": "همون کاری میبردم."
    },
    {
      "id": 2,
      "start": 9904.0,
      "end": 9906.0,
      "formatted_start": "02:45:04.000",
      "formatted_end": "02:45:06.000",
      "text": "با این انباششون میگرفتم."
    },
    {
      "id": 3,
      "start": 9906.0,
      "end": 9908.0,
      "formatted_start": "02:45:06.000",
      "formatted_end": "02:45:08.000",
      "text": "پایین حسابیست. به همون براترین جایی که میرسه."
    },
    {
      "id": 4,
      "start": 9908.0,
      "end": 9910.0,
      "formatted_start": "02:45:08.000",
      "formatted_end": "02:45:10.000",
      "text": "اون دست را..."
    },
    {
      "id": 5,
      "start": 9910.0,
      "end": 9912.0,
      "formatted_start": "02:45:10.000",
      "formatted_end": "02:45:12.000",
      "text": "این حالی صابت است."
    },
    {
      "id": 6,
      "start": 9912.0,
      "end": 9914.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:14.000",
      "text": "تو بیس روز تغییر رکه داری."
    },
    {
      "id": 7,
      "start": 9914.0,
      "end": 9916.0,
      "formatted_start": "02:45:14.000",
      "formatted_end": "02:45:16.000",
      "text": "بودو بیا پیش من."
    },
    {
      "id": 8,
      "start": 9916.0,
      "end": 9918.0,
      "formatted_start": "02:45:16.000",
      "formatted_end": "02:45:18.000",
      "text": "اینجور بزن. آمدید. اشکال نداری."
    },
    {
      "id": 9,
      "start": 9918.0,
      "end": 9920.0,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:20.000",
      "text": "بیا. تمام."
    },
    {
      "id": 10,
      "start": 9920.0,
      "end": 9922.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:22.000",
      "text": "آره."
    },
    {
      "id": 11,
      "start": 9922.0,
      "end": 9924.0,
      "formatted_start": "02:45:22.000",
      "formatted_end": "02:45:24.000",
      "text": "این صابت کنده. یه دقیقه جایشش بیده."
    },
    {
      "id": 12,
      "start": 9924.0,
      "end": 9926.0,
      "formatted_start": "02:45:24.000",
      "formatted_end": "02:45:26.000",
      "text": "از آمدتونو بیدم."
    },
    {
      "id": 13,
      "start": 9926.0,
      "end": 9928.0,
      "formatted_start": "02:45:26.000",
      "formatted_end": "02:45:28.000",
      "text": "چشم."
    },
    {
      "id": 14,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "باید درد کنیم"
    },
    {
      "id": 15,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "نوشت کنه درد نداره"
    },
    {
      "id": 16,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "الان ما دارو میگیم دردو نفهمه"
    },
    {
      "id": 17,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "ولی چشم"
    },
    {
      "id": 18,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "آره بشه بینیم"
    },
    {
      "id": 19,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "یه دونه غرص 500ه"
    },
    {
      "id": 20,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "آب میکنیش"
    },
    {
      "id": 21,
      "start": 9944.0,
      "end": 9946.0,
      "formatted_start": "02:45:44.000",
      "formatted_end": "02:45:46.000",
      "text": "روزیر توبش میدیم"
    },
    {
      "id": 22,
      "start": 9946.0,
      "end": 9948.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:48.000",
      "text": "بس شب"
    },
    {
      "id": 23,
      "start": 9948.0,
      "end": 9950.0,
      "formatted_start": "02:45:48.000",
      "formatted_end": "02:45:50.000",
      "text": "ببین کنم تا وقتی کنم 15 جاودا شعبتش"
    },
    {
      "id": 24,
      "start": 9950.0,
      "end": 9952.0,
      "formatted_start": "02:45:50.000",
      "formatted_end": "02:45:52.000",
      "text": "دیگه تمام شده باید یه من دارو نگردم"
    },
    {
      "id": 25,
      "start": 9952.0,
      "end": 9954.0,
      "formatted_start": "02:45:52.000",
      "formatted_end": "02:45:54.000",
      "text": "آره نگردم"
    },
    {
      "id": 26,
      "start": 9954.0,
      "end": 9956.0,
      "formatted_start": "02:45:54.000",
      "formatted_end": "02:45:56.000",
      "text": "آره ببینیم از اینکه مای وقت بیاد"
    },
    {
      "id": 27,
      "start": 9956.0,
      "end": 9958.0,
      "formatted_start": "02:45:56.000",
      "formatted_end": "02:45:58.000",
      "text": "تمام شد"
    },
    {
      "id": 28,
      "start": 9958.0,
      "end": 9960.0,
      "formatted_start": "02:45:58.000",
      "formatted_end": "02:46:00.000",
      "text": "از اینجا باید ازش میگه"
    },
    {
      "id": 29,
      "start": 9960.0,
      "end": 9962.0,
      "formatted_start": "02:46:00.000",
      "formatted_end": "02:46:02.000",
      "text": "آه، بیا"
    },
    {
      "id": 30,
      "start": 9968.0,
      "end": 9970.0,
      "formatted_start": "02:46:08.000",
      "formatted_end": "02:46:10.000",
      "text": "جوشانش رو باید حدث کنم"
    },
    {
      "id": 31,
      "start": 9970.0,
      "end": 9972.0,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:12.000",
      "text": "من یه ازش رو کنم"
    },
    {
      "id": 32,
      "start": 9972.0,
      "end": 9974.0,
      "formatted_start": "02:46:12.000",
      "formatted_end": "02:46:14.000",
      "text": "محمد جان، تو برو پیش زرافه ببینیم"
    },
    {
      "id": 33,
      "start": 9974.0,
      "end": 9976.0,
      "formatted_start": "02:46:14.000",
      "formatted_end": "02:46:16.000",
      "text": "از زرافه که برندتری"
    },
    {
      "id": 34,
      "start": 9976.0,
      "end": 9978.0,
      "formatted_start": "02:46:16.000",
      "formatted_end": "02:46:18.000",
      "text": "این درقی محمد؟"
    },
    {
      "id": 35,
      "start": 9978.0,
      "end": 9980.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:20.000",
      "text": "آه، برای رست بگیش بالا"
    },
    {
      "id": 36,
      "start": 9980.0,
      "end": 9982.0,
      "formatted_start": "02:46:20.000",
      "formatted_end": "02:46:22.000",
      "text": "بالا بالا"
    },
    {
      "id": 37,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "اتریکم"
    },
    {
      "id": 38,
      "start": 9984.0,
      "end": 9986.0,
      "formatted_start": "02:46:24.000",
      "formatted_end": "02:46:26.000",
      "text": "آفرین، نه مانگه هست"
    },
    {
      "id": 39,
      "start": 9986.0,
      "end": 9988.0,
      "formatted_start": "02:46:26.000",
      "formatted_end": "02:46:28.000",
      "text": "اینجوری صادقه بود"
    },
    {
      "id": 40,
      "start": 9988.0,
      "end": 9989.0,
      "formatted_start": "02:46:28.000",
      "formatted_end": "02:46:29.000",
      "text": "صادقه؟"
    },
    {
      "id": 41,
      "start": 9989.0,
      "end": 9990.0,
      "formatted_start": "02:46:29.000",
      "formatted_end": "02:46:30.000",
      "text": "بله"
    },
    {
      "id": 42,
      "start": 9990.0,
      "end": 9992.0,
      "formatted_start": "02:46:30.000",
      "formatted_end": "02:46:32.000",
      "text": "یه مرچ دسته ببینم"
    },
    {
      "id": 43,
      "start": 9993.0,
      "end": 9995.0,
      "formatted_start": "02:46:33.000",
      "formatted_end": "02:46:35.000",
      "text": "نفسی"
    },
    {
      "id": 44,
      "start": 9996.0,
      "end": 9998.0,
      "formatted_start": "02:46:36.000",
      "formatted_end": "02:46:38.000",
      "text": "اونکی"
    },
    {
      "id": 45,
      "start": 9998.0,
      "end": 10000.0,
      "formatted_start": "02:46:38.000",
      "formatted_end": "02:46:40.000",
      "text": "سطح بازه"
    },
    {
      "id": 46,
      "start": 10000.0,
      "end": 10002.0,
      "formatted_start": "02:46:40.000",
      "formatted_end": "02:46:42.000",
      "text": "تو اینقدر اینجا درد میکن؟"
    },
    {
      "id": 47,
      "start": 10002.0,
      "end": 10004.0,
      "formatted_start": "02:46:42.000",
      "formatted_end": "02:46:44.000",
      "text": "آره، من برم"
    },
    {
      "id": 48,
      "start": 10004.0,
      "end": 10006.0,
      "formatted_start": "02:46:44.000",
      "formatted_end": "02:46:46.000",
      "text": "دردانت اینجاییست؟"
    },
    {
      "id": 49,
      "start": 10006.0,
      "end": 10008.0,
      "formatted_start": "02:46:46.000",
      "formatted_end": "02:46:48.000",
      "text": "دردانت اینجا"
    },
    {
      "id": 50,
      "start": 10008.0,
      "end": 10010.0,
      "formatted_start": "02:46:48.000",
      "formatted_end": "02:46:50.000",
      "text": "بله بازتو؟"
    },
    {
      "id": 51,
      "start": 10010.0,
      "end": 10012.0,
      "formatted_start": "02:46:50.000",
      "formatted_end": "02:46:52.000",
      "text": "بله بازم"
    },
    {
      "id": 52,
      "start": 10012.0,
      "end": 10014.0,
      "formatted_start": "02:46:52.000",
      "formatted_end": "02:46:54.000",
      "text": "چنش"
    },
    {
      "id": 53,
      "start": 10014.0,
      "end": 10021.0,
      "formatted_start": "02:46:54.000",
      "formatted_end": "02:47:01.000",
      "text": "اصلا برای محمد یه مرسش تموم شده اینو همین باز مونده و اصلا هر مرس هم بیرونه اما مایی همون بگذاره داریم"
    },
    {
      "id": 54,
      "start": 10021.0,
      "end": 10023.0,
      "formatted_start": "02:47:01.000",
      "formatted_end": "02:47:03.000",
      "text": "یعنی که این را بیرونه بیرونه بیرونه"
    },
    {
      "id": 55,
      "start": 10023.0,
      "end": 10024.0,
      "formatted_start": "02:47:03.000",
      "formatted_end": "02:47:04.000",
      "text": "تو دوتاش باید بکنی؟"
    },
    {
      "id": 56,
      "start": 10024.0,
      "end": 10025.0,
      "formatted_start": "02:47:04.000",
      "formatted_end": "02:47:05.000",
      "text": "تو دوتاش باید بکنی؟"
    },
    {
      "id": 57,
      "start": 10025.0,
      "end": 10026.0,
      "formatted_start": "02:47:05.000",
      "formatted_end": "02:47:06.000",
      "text": "پره 500 دوتاش بکنی؟"
    },
    {
      "id": 58,
      "start": 10026.0,
      "end": 10027.0,
      "formatted_start": "02:47:06.000",
      "formatted_end": "02:47:07.000",
      "text": "آهان"
    },
    {
      "id": 59,
      "start": 10027.0,
      "end": 10028.0,
      "formatted_start": "02:47:07.000",
      "formatted_end": "02:47:08.000",
      "text": "اون مونده ها"
    },
    {
      "id": 60,
      "start": 10028.0,
      "end": 10029.0,
      "formatted_start": "02:47:08.000",
      "formatted_end": "02:47:09.000",
      "text": "چند دوتای؟"
    },
    {
      "id": 61,
      "start": 10029.0,
      "end": 10030.0,
      "formatted_start": "02:47:09.000",
      "formatted_end": "02:47:10.000",
      "text": "اون را ریز بکنیم"
    },
    {
      "id": 62,
      "start": 10030.0,
      "end": 10031.0,
      "formatted_start": "02:47:10.000",
      "formatted_end": "02:47:11.000",
      "text": "پره این همین چند دوتا باید باشه؟"
    },
    {
      "id": 63,
      "start": 10031.0,
      "end": 10047.0,
      "formatted_start": "02:47:11.000",
      "formatted_end": "02:47:27.000",
      "text": "اگر هزار بدن دوتا اون با هزاری این پونسد دوتا اگر هزار این شکلی بدن یه دور در روز اگر هزارشو بدن دوتا"
    },
    {
      "id": 64,
      "start": 10047.0,
      "end": 10052.36,
      "formatted_start": "02:47:27.000",
      "formatted_end": "02:47:32.360",
      "text": "باش. برم. ده هم ها میگن. ده هم میاز. آره. آره."
    },
    {
      "id": 65,
      "start": 10060.36,
      "end": 10064.52,
      "formatted_start": "02:47:40.360",
      "formatted_end": "02:47:44.520",
      "text": "آره. این درموها هم داخلش گوشت درم آدمی بگو."
    },
    {
      "id": 66,
      "start": 10064.52,
      "end": 10069.0,
      "formatted_start": "02:47:44.520",
      "formatted_end": "02:47:49.000",
      "text": "جوشه میگه. گوشت. سر بالا میگه. جوش همینی هم درموها."
    },
    {
      "id": 67,
      "start": 10069.0,
      "end": 10074.52,
      "formatted_start": "02:47:49.000",
      "formatted_end": "02:47:54.520",
      "text": "گوشه. آره. کمباتی بگه. کمبات چشم. آره. کمبات چشم."
    },
    {
      "id": 68,
      "start": 10074.52,
      "end": 10077.52,
      "formatted_start": "02:47:54.520",
      "formatted_end": "02:47:57.520",
      "text": "اینجا مایزین بزن و جمع شوند"
    },
    {
      "id": 69,
      "start": 10077.52,
      "end": 10079.52,
      "formatted_start": "02:47:57.520",
      "formatted_end": "02:47:59.520",
      "text": "بیا بسرگاه"
    },
    {
      "id": 70,
      "start": 10079.52,
      "end": 10081.52,
      "formatted_start": "02:47:59.520",
      "formatted_end": "02:48:01.520",
      "text": "اینم با همه بچه هاین یه ماه دیگه"
    },
    {
      "id": 71,
      "start": 10081.52,
      "end": 10083.52,
      "formatted_start": "02:48:01.520",
      "formatted_end": "02:48:03.520",
      "text": "یه ماه دیگه بیارم داده ایشون"
    },
    {
      "id": 72,
      "start": 10083.52,
      "end": 10085.52,
      "formatted_start": "02:48:03.520",
      "formatted_end": "02:48:05.520",
      "text": "اگه این براشون تموم شد تا یه ماه تنبید کنن"
    },
    {
      "id": 73,
      "start": 10085.52,
      "end": 10087.52,
      "formatted_start": "02:48:05.520",
      "formatted_end": "02:48:07.520",
      "text": "یه تا خرم براشون"
    },
    {
      "id": 74,
      "start": 10087.52,
      "end": 10090.52,
      "formatted_start": "02:48:07.520",
      "formatted_end": "02:48:10.520",
      "text": "همه ده ۲۵ اینم باز جدید از این مرد"
    },
    {
      "id": 75,
      "start": 10090.52,
      "end": 10092.52,
      "formatted_start": "02:48:10.520",
      "formatted_end": "02:48:12.520",
      "text": "قبلی از این مرد"
    },
    {
      "id": 76,
      "start": 10092.52,
      "end": 10094.52,
      "formatted_start": "02:48:12.520",
      "formatted_end": "02:48:14.520",
      "text": "با تینام باشه"
    },
    {
      "id": 77,
      "start": 10094.52,
      "end": 10096.52,
      "formatted_start": "02:48:14.520",
      "formatted_end": "02:48:16.520",
      "text": "یه ماه دیگه دوباره بیارم"
    },
    {
      "id": 78,
      "start": 10096.52,
      "end": 10099.52,
      "formatted_start": "02:48:16.520",
      "formatted_end": "02:48:19.520",
      "text": "از روش اگه تا یه ماه هر که با تموم شد تا توشوند"
    },
    {
      "id": 79,
      "start": 10099.52,
      "end": 10102.52,
      "formatted_start": "02:48:19.520",
      "formatted_end": "02:48:22.520",
      "text": "بسیار باش. دست داریم. شروع بخورم. بسیار باش."
    },
    {
      "id": 80,
      "start": 10110.52,
      "end": 10113.52,
      "formatted_start": "02:48:30.520",
      "formatted_end": "02:48:33.520",
      "text": "سلام. سلام. خوهر من. بفرما."
    },
    {
      "id": 81,
      "start": 10115.52,
      "end": 10118.52,
      "formatted_start": "02:48:35.520",
      "formatted_end": "02:48:38.520",
      "text": "آیا دوست داریم به شما در اینجا کیست و موی داشتم. خب؟"
    },
    {
      "id": 82,
      "start": 10118.52,
      "end": 10119.52,
      "formatted_start": "02:48:38.520",
      "formatted_end": "02:48:39.520",
      "text": "بله. بری باسم."
    },
    {
      "id": 83,
      "start": 10119.52,
      "end": 10120.52,
      "formatted_start": "02:48:39.520",
      "formatted_end": "02:48:40.520",
      "text": "آره."
    },
    {
      "id": 84,
      "start": 10120.52,
      "end": 10121.52,
      "formatted_start": "02:48:40.520",
      "formatted_end": "02:48:41.520",
      "text": "دوری."
    },
    {
      "id": 85,
      "start": 10121.52,
      "end": 10122.52,
      "formatted_start": "02:48:41.520",
      "formatted_end": "02:48:42.520",
      "text": "داره."
    },
    {
      "id": 86,
      "start": 10122.52,
      "end": 10125.52,
      "formatted_start": "02:48:42.520",
      "formatted_end": "02:48:45.520",
      "text": "داره. دکتور یادگاهی نامی داریم. رفتون جرای کردم. خب؟"
    },
    {
      "id": 87,
      "start": 10125.52,
      "end": 10126.52,
      "formatted_start": "02:48:45.520",
      "formatted_end": "02:48:46.520",
      "text": "داره."
    },
    {
      "id": 88,
      "start": 10126.52,
      "end": 10131.5,
      "formatted_start": "02:48:46.520",
      "formatted_end": "02:48:51.500",
      "text": "و چند وقت دیگه از از چشمهای دیگه بین دوتا انگاشت پام یک دونه کوچکو زد"
    },
    {
      "id": 89,
      "start": 10131.5,
      "end": 10134.5,
      "formatted_start": "02:48:51.500",
      "formatted_end": "02:48:54.500",
      "text": "و دکتر رفتن بوده چه دستش ندار خوب میشه"
    },
    {
      "id": 90,
      "start": 10134.5,
      "end": 10141.0,
      "formatted_start": "02:48:54.500",
      "formatted_end": "02:49:01.000",
      "text": "ولی الان، اینجای پام دونه زده خیلی دردم میاد وقتی راه میرن"
    },
    {
      "id": 91,
      "start": 10141.0,
      "end": 10142.5,
      "formatted_start": "02:49:01.000",
      "formatted_end": "02:49:02.500",
      "text": "اینه"
    },
    {
      "id": 92,
      "start": 10142.5,
      "end": 10146.3,
      "formatted_start": "02:49:02.500",
      "formatted_end": "02:49:06.300",
      "text": "اینه"
    },
    {
      "id": 93,
      "start": 10146.3,
      "end": 10151.2,
      "formatted_start": "02:49:06.300",
      "formatted_end": "02:49:11.200",
      "text": "اینو خودم گرفتم با اینو که ایچی نامازش کردم داخلش چیز نداره، هیچی داخلش نیست"
    },
    {
      "id": 94,
      "start": 10151.2,
      "end": 10153.2,
      "formatted_start": "02:49:11.200",
      "formatted_end": "02:49:13.200",
      "text": "ولی مثلا این چیز میشه"
    },
    {
      "id": 95,
      "start": 10153.2,
      "end": 10157.88,
      "formatted_start": "02:49:13.200",
      "formatted_end": "02:49:17.880",
      "text": "اینجا باید بخشی همون میرن سرگ پایین با قشنگ نیکشن میارن باید بخشی تو راه میشه"
    },
    {
      "id": 96,
      "start": 10157.88,
      "end": 10162.12,
      "formatted_start": "02:49:17.880",
      "formatted_end": "02:49:22.120",
      "text": "ولی هر چی که پشان میدم هیچ چی داخلش نیست هیچ چی"
    },
    {
      "id": 97,
      "start": 10162.12,
      "end": 10167.92,
      "formatted_start": "02:49:22.120",
      "formatted_end": "02:49:27.920",
      "text": "الان یک دفعه با بیشی بازش کردم بابا هم داخلش چی دیدی نیست"
    },
    {
      "id": 98,
      "start": 10167.92,
      "end": 10171.8,
      "formatted_start": "02:49:27.920",
      "formatted_end": "02:49:31.800",
      "text": "نه چرکی نه سیزی ولی خب خیلی درد میاره آقایی دوست"
    },
    {
      "id": 99,
      "start": 10171.8,
      "end": 10175.6,
      "formatted_start": "02:49:31.800",
      "formatted_end": "02:49:35.600",
      "text": "این خیلی نابه از این وقت راه میرن واقعا دردم دیگه"
    },
    {
      "id": 100,
      "start": 10175.6,
      "end": 10176.72,
      "formatted_start": "02:49:35.600",
      "formatted_end": "02:49:36.720",
      "text": "قابل"
    },
    {
      "id": 101,
      "start": 10176.72,
      "end": 10178.48,
      "formatted_start": "02:49:36.720",
      "formatted_end": "02:49:38.480",
      "text": "دستش نزد"
    },
    {
      "id": 102,
      "start": 10178.48,
      "end": 10180.48,
      "formatted_start": "02:49:38.480",
      "formatted_end": "02:49:40.480",
      "text": "کمبت دو تا کمبت بده"
    },
    {
      "id": 103,
      "start": 10180.48,
      "end": 10190.48,
      "formatted_start": "02:49:40.480",
      "formatted_end": "02:49:50.480",
      "text": "اولا میزنید ادره جلد، اولا میزنید درد قیام سرکن و بعد یک کمال به تقلیب اونجا بره توش و به چست بزن"
    },
    {
      "id": 104,
      "start": 10190.48,
      "end": 10193.48,
      "formatted_start": "02:49:50.480",
      "formatted_end": "02:49:53.480",
      "text": "باشه، باشه"
    },
    {
      "id": 105,
      "start": 10193.48,
      "end": 10199.48,
      "formatted_start": "02:49:53.480",
      "formatted_end": "02:49:59.480",
      "text": "نمیزنید تقلیب جلد، بعد کمال، کمال زخم، پایی درستی"
    }
  ],
  "status": "completed"
}