  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13810.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:10.000",
      "text": "اول کچی بود، بعد باید خوارش مطابق شده، بعد دیگه بزرگ شد، الان یک زن کچکتر شده."
    },
    {
      "id": 1,
      "start": 13810.0,
      "end": 13813.0,
      "formatted_start": "03:50:10.000",
      "formatted_end": "03:50:13.000",
      "text": "کچی دور بزنی، از باید برد پید پیش من."
    },
    {
      "id": 2,
      "start": 13817.0,
      "end": 13820.0,
      "formatted_start": "03:50:17.000",
      "formatted_end": "03:50:20.000",
      "text": "اگر خوشتونم باشه، باز کنید من رو برم."
    },
    {
      "id": 3,
      "start": 13820.0,
      "end": 13822.0,
      "formatted_start": "03:50:20.000",
      "formatted_end": "03:50:22.000",
      "text": "دیگه لبنش."
    },
    {
      "id": 4,
      "start": 13826.0,
      "end": 13828.0,
      "formatted_start": "03:50:26.000",
      "formatted_end": "03:50:28.000",
      "text": "باید دست باز کنید."
    },
    {
      "id": 5,
      "start": 13828.0,
      "end": 13830.0,
      "formatted_start": "03:50:28.000",
      "formatted_end": "03:50:30.000",
      "text": "اینو هره"
    },
    {
      "id": 6,
      "start": 13832.0,
      "end": 13834.0,
      "formatted_start": "03:50:32.000",
      "formatted_end": "03:50:34.000",
      "text": "آره چوشه"
    },
    {
      "id": 7,
      "start": 13834.0,
      "end": 13838.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:38.000",
      "text": "در سر خوردن خورما، حلوه، شیرینی، حلوه شکره یکمونه"
    },
    {
      "id": 8,
      "start": 13838.0,
      "end": 13843.0,
      "formatted_start": "03:50:38.000",
      "formatted_end": "03:50:43.000",
      "text": "نه، احساس برام چون هر روزه خوردم بدنم میریزه معموله"
    },
    {
      "id": 9,
      "start": 13843.0,
      "end": 13845.0,
      "formatted_start": "03:50:43.000",
      "formatted_end": "03:50:45.000",
      "text": "اینم منجا چوش دارم ازه"
    },
    {
      "id": 10,
      "start": 13845.0,
      "end": 13847.0,
      "formatted_start": "03:50:45.000",
      "formatted_end": "03:50:47.000",
      "text": "این معمولیه پس نه؟"
    },
    {
      "id": 11,
      "start": 13847.0,
      "end": 13850.0,
      "formatted_start": "03:50:47.000",
      "formatted_end": "03:50:50.000",
      "text": "یه فرنسیه دیگه خیلی برچه یکمان"
    },
    {
      "id": 12,
      "start": 13850.0,
      "end": 13852.0,
      "formatted_start": "03:50:50.000",
      "formatted_end": "03:50:52.000",
      "text": "برس داره، میدم شده"
    },
    {
      "id": 13,
      "start": 13852.0,
      "end": 13854.0,
      "formatted_start": "03:50:52.000",
      "formatted_end": "03:50:54.000",
      "text": "اولین بار این توی شده"
    },
    {
      "id": 14,
      "start": 13854.0,
      "end": 13856.0,
      "formatted_start": "03:50:54.000",
      "formatted_end": "03:50:56.000",
      "text": "بعد، هران دو روزم آبو سیری میخورم"
    },
    {
      "id": 15,
      "start": 13856.0,
      "end": 13858.0,
      "formatted_start": "03:50:56.000",
      "formatted_end": "03:50:58.000",
      "text": "فلسطینی بود کاران داره؟"
    },
    {
      "id": 16,
      "start": 13858.0,
      "end": 13862.0,
      "formatted_start": "03:50:58.000",
      "formatted_end": "03:51:02.000",
      "text": "آیا نداره، باید کلینم آیسین نداره"
    },
    {
      "id": 17,
      "start": 13862.0,
      "end": 13864.0,
      "formatted_start": "03:51:02.000",
      "formatted_end": "03:51:04.000",
      "text": "کلینم آیسین نداره"
    },
    {
      "id": 18,
      "start": 13864.0,
      "end": 13866.0,
      "formatted_start": "03:51:04.000",
      "formatted_end": "03:51:06.000",
      "text": "کلینم خاصی بس نیست؟"
    },
    {
      "id": 19,
      "start": 13866.0,
      "end": 13868.0,
      "formatted_start": "03:51:06.000",
      "formatted_end": "03:51:08.000",
      "text": "خیلی چیز مهمیه ولی شراخ شده هست"
    },
    {
      "id": 20,
      "start": 13868.0,
      "end": 13870.0,
      "formatted_start": "03:51:08.000",
      "formatted_end": "03:51:10.000",
      "text": "یعنی پیچی ده نیست"
    },
    {
      "id": 21,
      "start": 13870.0,
      "end": 13874.0,
      "formatted_start": "03:51:10.000",
      "formatted_end": "03:51:14.000",
      "text": "کلینم آیسین"
    },
    {
      "id": 22,
      "start": 13874.0,
      "end": 13876.0,
      "formatted_start": "03:51:14.000",
      "formatted_end": "03:51:16.000",
      "text": "دو تا کمک داره"
    },
    {
      "id": 23,
      "start": 13876.0,
      "end": 13878.0,
      "formatted_start": "03:51:16.000",
      "formatted_end": "03:51:18.000",
      "text": "دو تا قرص داره"
    },
    {
      "id": 24,
      "start": 13878.0,
      "end": 13880.0,
      "formatted_start": "03:51:18.000",
      "formatted_end": "03:51:20.000",
      "text": "اسمشون یکیه"
    },
    {
      "id": 25,
      "start": 13880.0,
      "end": 13887.6,
      "formatted_start": "03:51:20.000",
      "formatted_end": "03:51:27.600",
      "text": "بعد آقای دکتور من می کنم از هفته بعد دوره واسه بدنسازی کلاکیون بگیرم"
    },
    {
      "id": 26,
      "start": 13887.6,
      "end": 13890.3,
      "formatted_start": "03:51:27.600",
      "formatted_end": "03:51:30.300",
      "text": "زیاد ضربه که نداره"
    },
    {
      "id": 27,
      "start": 13890.3,
      "end": 13892.3,
      "formatted_start": "03:51:30.300",
      "formatted_end": "03:51:32.300",
      "text": "باید آزمانش بگیرم"
    },
    {
      "id": 28,
      "start": 13892.3,
      "end": 13894.3,
      "formatted_start": "03:51:32.300",
      "formatted_end": "03:51:34.300",
      "text": "آزمانش بگیرم"
    },
    {
      "id": 29,
      "start": 13894.3,
      "end": 13901.52,
      "formatted_start": "03:51:34.300",
      "formatted_end": "03:51:41.520",
      "text": "بعد آقای دکتور راستی یک چکاب کامل از تیروید و همه چیزشونه"
    },
    {
      "id": 30,
      "start": 13901.52,
      "end": 13903.52,
      "formatted_start": "03:51:41.520",
      "formatted_end": "03:51:43.520",
      "text": "بسیاریم"
    },
    {
      "id": 31,
      "start": 13903.52,
      "end": 13908.0,
      "formatted_start": "03:51:43.520",
      "formatted_end": "03:51:48.000",
      "text": "افرادون هم چکاب کامل بعد چکاب کامل سوال کن که میتونید کلکترین بخوریم"
    },
    {
      "id": 32,
      "start": 13908.0,
      "end": 13910.0,
      "formatted_start": "03:51:48.000",
      "formatted_end": "03:51:50.000",
      "text": "دست شوید"
    },
    {
      "id": 33,
      "start": 13910.0,
      "end": 13912.0,
      "formatted_start": "03:51:50.000",
      "formatted_end": "03:51:52.000",
      "text": "این است منشی"
    },
    {
      "id": 34,
      "start": 13918.0,
      "end": 13920.0,
      "formatted_start": "03:51:58.000",
      "formatted_end": "03:52:00.000",
      "text": "سلام علیکم"
    },
    {
      "id": 35,
      "start": 13920.0,
      "end": 13922.0,
      "formatted_start": "03:52:00.000",
      "formatted_end": "03:52:02.000",
      "text": "سلام علیکم"
    },
    {
      "id": 36,
      "start": 13922.0,
      "end": 13924.0,
      "formatted_start": "03:52:02.000",
      "formatted_end": "03:52:04.000",
      "text": "دفعه اونو بگیر"
    },
    {
      "id": 37,
      "start": 13926.0,
      "end": 13928.0,
      "formatted_start": "03:52:06.000",
      "formatted_end": "03:52:08.000",
      "text": "دفعه اونو بگیر"
    },
    {
      "id": 38,
      "start": 13928.0,
      "end": 13930.0,
      "formatted_start": "03:52:08.000",
      "formatted_end": "03:52:10.000",
      "text": "دفعه اونو بگیر"
    },
    {
      "id": 39,
      "start": 13930.0,
      "end": 13932.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:12.000",
      "text": "دفعه اونو بگیر"
    },
    {
      "id": 40,
      "start": 13932.0,
      "end": 13934.0,
      "formatted_start": "03:52:12.000",
      "formatted_end": "03:52:14.000",
      "text": "چه مشکلی داری؟"
    },
    {
      "id": 41,
      "start": 13934.0,
      "end": 13936.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:16.000",
      "text": "از اینجور پاهم زندگی می کند"
    },
    {
      "id": 42,
      "start": 13936.0,
      "end": 13938.0,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:18.000",
      "text": "که از اینجور پاهم زندگی می کند"
    },
    {
      "id": 43,
      "start": 13938.0,
      "end": 13968.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:48.000",
      "text": "از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال از این حال ا"
    },
    {
      "id": 44,
      "start": 13968.0,
      "end": 13973.44,
      "formatted_start": "03:52:48.000",
      "formatted_end": "03:52:53.440",
      "text": "از این چیزی سنوی رو بیادید که من گفت که دوتا لفتر خونه نه"
    },
    {
      "id": 45,
      "start": 13973.44,
      "end": 13977.24,
      "formatted_start": "03:52:53.440",
      "formatted_end": "03:52:57.240",
      "text": "من گفت تو پروسات دیدی میشه که دکتر نه افتیا نه فهمیدی میگه"
    },
    {
      "id": 46,
      "start": 13977.24,
      "end": 13980.56,
      "formatted_start": "03:52:57.240",
      "formatted_end": "03:53:00.560",
      "text": "که به دکتر خودم رو نشان بدم که بهت رقمهای میکنه بود"
    },
    {
      "id": 47,
      "start": 13980.56,
      "end": 13982.56,
      "formatted_start": "03:53:00.560",
      "formatted_end": "03:53:02.560",
      "text": "الان مانده بیشتر مالیه"
    },
    {
      "id": 48,
      "start": 13982.56,
      "end": 13984.56,
      "formatted_start": "03:53:02.560",
      "formatted_end": "03:53:04.560",
      "text": "بله"
    },
    {
      "id": 49,
      "start": 13984.56,
      "end": 13986.56,
      "formatted_start": "03:53:04.560",
      "formatted_end": "03:53:06.560",
      "text": "شما رشید تحصیلی چیه؟ من"
    },
    {
      "id": 50,
      "start": 13986.56,
      "end": 13988.56,
      "formatted_start": "03:53:06.560",
      "formatted_end": "03:53:08.560",
      "text": "آزاد"
    },
    {
      "id": 51,
      "start": 13988.56,
      "end": 13989.56,
      "formatted_start": "03:53:08.560",
      "formatted_end": "03:53:09.560",
      "text": "چند؟"
    },
    {
      "id": 52,
      "start": 13989.56,
      "end": 13990.56,
      "formatted_start": "03:53:09.560",
      "formatted_end": "03:53:10.560",
      "text": "سه بارم سه بارم رقمهای"
    },
    {
      "id": 53,
      "start": 13990.56,
      "end": 13992.56,
      "formatted_start": "03:53:10.560",
      "formatted_end": "03:53:12.560",
      "text": "سه بارم رقمهای مالیه"
    },
    {
      "id": 54,
      "start": 13992.56,
      "end": 13993.56,
      "formatted_start": "03:53:12.560",
      "formatted_end": "03:53:13.560",
      "text": "باید"
    },
    {
      "id": 55,
      "start": 13993.56,
      "end": 13995.56,
      "formatted_start": "03:53:13.560",
      "formatted_end": "03:53:15.560",
      "text": "زبان ها یکی نیست"
    },
    {
      "id": 56,
      "start": 13995.56,
      "end": 14003.06,
      "formatted_start": "03:53:15.560",
      "formatted_end": "03:53:23.060",
      "text": "از اینجور برنظر بگویید که خالی نازی مثلا از شما ثباتش کمتره دیگه"
    },
    {
      "id": 57,
      "start": 14003.06,
      "end": 14009.56,
      "formatted_start": "03:53:23.060",
      "formatted_end": "03:53:29.560",
      "text": "به راست این تجربه شو مریضی ها زیاده ناسی سال کشور داره مریضی های اختراف رو میبینه"
    },
    {
      "id": 58,
      "start": 14009.56,
      "end": 14010.56,
      "formatted_start": "03:53:29.560",
      "formatted_end": "03:53:30.560",
      "text": "خب؟"
    },
    {
      "id": 59,
      "start": 14010.56,
      "end": 14014.56,
      "formatted_start": "03:53:30.560",
      "formatted_end": "03:53:34.560",
      "text": "اصلا زبانش با زبان شفیگور که یکی نیمشه که"
    },
    {
      "id": 60,
      "start": 14014.56,
      "end": 14016.56,
      "formatted_start": "03:53:34.560",
      "formatted_end": "03:53:36.560",
      "text": "با زبان شفیگور چیست دیگه؟"
    },
    {
      "id": 61,
      "start": 14016.56,
      "end": 14017.56,
      "formatted_start": "03:53:36.560",
      "formatted_end": "03:53:37.560",
      "text": "زبان این چیز دیگه"
    },
    {
      "id": 62,
      "start": 14017.56,
      "end": 14021.56,
      "formatted_start": "03:53:37.560",
      "formatted_end": "03:53:41.560",
      "text": "نباید ما بگیم کسی نفهمید یا نمیفهمه نسنید نفهمه"
    },
    {
      "id": 63,
      "start": 14021.56,
      "end": 14023.56,
      "formatted_start": "03:53:41.560",
      "formatted_end": "03:53:43.560",
      "text": "کسان برای کار چیشون؟"
    },
    {
      "id": 64,
      "start": 14023.56,
      "end": 14025.56,
      "formatted_start": "03:53:43.560",
      "formatted_end": "03:53:45.560",
      "text": "کارمون هر زد میفروشیه"
    },
    {
      "id": 65,
      "start": 14025.56,
      "end": 14026.56,
      "formatted_start": "03:53:45.560",
      "formatted_end": "03:53:46.560",
      "text": "میفروشیه"
    },
    {
      "id": 66,
      "start": 14026.56,
      "end": 14030.56,
      "formatted_start": "03:53:46.560",
      "formatted_end": "03:53:50.560",
      "text": "مثلا بگیم مثلا آلو شابرون رو شما نمیفهمی آلو شابرون"
    },
    {
      "id": 67,
      "start": 14030.56,
      "end": 14031.56,
      "formatted_start": "03:53:50.560",
      "formatted_end": "03:53:51.560",
      "text": "چون میگی؟"
    },
    {
      "id": 68,
      "start": 14031.56,
      "end": 14033.56,
      "formatted_start": "03:53:51.560",
      "formatted_end": "03:53:53.560",
      "text": "آلوی که داشتی آلوی خوب نبوده"
    },
    {
      "id": 69,
      "start": 14033.56,
      "end": 14034.56,
      "formatted_start": "03:53:53.560",
      "formatted_end": "03:53:54.560",
      "text": "درسته؟"
    },
    {
      "id": 70,
      "start": 14034.56,
      "end": 14037.56,
      "formatted_start": "03:53:54.560",
      "formatted_end": "03:53:57.560",
      "text": "چون میبینیم آلو شابرون رو نمیفهمی"
    },
    {
      "id": 71,
      "start": 14037.56,
      "end": 14039.56,
      "formatted_start": "03:53:57.560",
      "formatted_end": "03:53:59.560",
      "text": "میفهمی شابرون رو نمیفهمی"
    },
    {
      "id": 72,
      "start": 14039.56,
      "end": 14041.56,
      "formatted_start": "03:53:59.560",
      "formatted_end": "03:54:01.560",
      "text": "هلو رو از مثلا شلیل نمیشه نسید؟"
    },
    {
      "id": 73,
      "start": 14041.56,
      "end": 14046.56,
      "formatted_start": "03:54:01.560",
      "formatted_end": "03:54:06.560",
      "text": "میگه آدم... عادی یک کارمند شاید به شلیل هم بگه هلو"
    },
    {
      "id": 74,
      "start": 14046.56,
      "end": 14049.62,
      "formatted_start": "03:54:06.560",
      "formatted_end": "03:54:09.620",
      "text": "می آمد می گن اقای هرو را چنده شما می گویدن شریده"
    },
    {
      "id": 75,
      "start": 14049.62,
      "end": 14052.62,
      "formatted_start": "03:54:09.620",
      "formatted_end": "03:54:12.620",
      "text": "اون می گوید نه هرو ها تو می گوید شریده"
    },
    {
      "id": 76,
      "start": 14052.62,
      "end": 14054.62,
      "formatted_start": "03:54:12.620",
      "formatted_end": "03:54:14.620",
      "text": "جدا هرو ها جدا"
    },
    {
      "id": 77,
      "start": 14054.62,
      "end": 14056.62,
      "formatted_start": "03:54:14.620",
      "formatted_end": "03:54:16.620",
      "text": "ولی مشتری نیمی فرده"
    },
    {
      "id": 78,
      "start": 14056.62,
      "end": 14058.62,
      "formatted_start": "03:54:16.620",
      "formatted_end": "03:54:18.620",
      "text": "بگوید اینجا هر کار را می زنید"
    },
    {
      "id": 79,
      "start": 14058.62,
      "end": 14060.62,
      "formatted_start": "03:54:18.620",
      "formatted_end": "03:54:20.620",
      "text": "احتمال دوست در پیش هم می آرد مثلا یک خانم می آرد"
    },
    {
      "id": 80,
      "start": 14060.62,
      "end": 14062.62,
      "formatted_start": "03:54:20.620",
      "formatted_end": "03:54:22.620",
      "text": "می شده می گوید هرو"
    },
    {
      "id": 81,
      "start": 14062.62,
      "end": 14064.62,
      "formatted_start": "03:54:22.620",
      "formatted_end": "03:54:24.620",
      "text": "هرو را می گوید شریده"
    },
    {
      "id": 82,
      "start": 14064.62,
      "end": 14066.62,
      "formatted_start": "03:54:24.620",
      "formatted_end": "03:54:26.620",
      "text": "هر کسی از شما خودش را بردارید"
    },
    {
      "id": 83,
      "start": 14066.62,
      "end": 14068.62,
      "formatted_start": "03:54:26.620",
      "formatted_end": "03:54:28.620",
      "text": "آره زام چه را می گوید خربازه"
    },
    {
      "id": 84,
      "start": 14068.62,
      "end": 14070.62,
      "formatted_start": "03:54:28.620",
      "formatted_end": "03:54:30.620",
      "text": "تو می گوید زام چه را می گوید"
    },
    {
      "id": 85,
      "start": 14076.56,
      "end": 14078.56,
      "formatted_start": "03:54:36.560",
      "formatted_end": "03:54:38.560",
      "text": "توی این دیگه"
    },
    {
      "id": 86,
      "start": 14080.56,
      "end": 14082.56,
      "formatted_start": "03:54:40.560",
      "formatted_end": "03:54:42.560",
      "text": "دو دام لفته"
    },
    {
      "id": 87,
      "start": 14082.56,
      "end": 14084.56,
      "formatted_start": "03:54:42.560",
      "formatted_end": "03:54:44.560",
      "text": "من گفتم او دکتر آخونداد تاریخ"
    },
    {
      "id": 88,
      "start": 14084.56,
      "end": 14086.56,
      "formatted_start": "03:54:44.560",
      "formatted_end": "03:54:46.560",
      "text": "این رو همین نروته"
    },
    {
      "id": 89,
      "start": 14086.56,
      "end": 14088.56,
      "formatted_start": "03:54:46.560",
      "formatted_end": "03:54:48.560",
      "text": "هر چیزی هستی به من میگفت"
    },
    {
      "id": 90,
      "start": 14088.56,
      "end": 14090.56,
      "formatted_start": "03:54:48.560",
      "formatted_end": "03:54:50.560",
      "text": "میگفت"
    },
    {
      "id": 91,
      "start": 14090.56,
      "end": 14092.56,
      "formatted_start": "03:54:50.560",
      "formatted_end": "03:54:52.560",
      "text": "اون چیزی که در"
    },
    {
      "id": 92,
      "start": 14092.56,
      "end": 14094.56,
      "formatted_start": "03:54:52.560",
      "formatted_end": "03:54:54.560",
      "text": "پرستادور"
    },
    {
      "id": 93,
      "start": 14094.56,
      "end": 14096.56,
      "formatted_start": "03:54:54.560",
      "formatted_end": "03:54:56.560",
      "text": "گمان کرده به این مسئله و"
    },
    {
      "id": 94,
      "start": 14096.56,
      "end": 14098.56,
      "formatted_start": "03:54:56.560",
      "formatted_end": "03:54:58.560",
      "text": "آمد و به من"
    },
    {
      "id": 95,
      "start": 14098.56,
      "end": 14100.56,
      "formatted_start": "03:54:58.560",
      "formatted_end": "03:55:00.560",
      "text": "توضیح داد و گفت که من"
    }
  ],
  "status": "completed"
}