  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6608.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:08.000",
      "text": "این رو باید بسیار در اینجوری نقل میخواهد، نقل ها زود بشند که تغییر نیست."
    },
    {
      "id": 1,
      "start": 6608.0,
      "end": 6612.0,
      "formatted_start": "01:50:08.000",
      "formatted_end": "01:50:12.000",
      "text": "اون تخت راست که دیگه توقعاتی بودیم."
    },
    {
      "id": 2,
      "start": 6612.0,
      "end": 6616.0,
      "formatted_start": "01:50:12.000",
      "formatted_end": "01:50:16.000",
      "text": "خوشحالا، بشید."
    },
    {
      "id": 3,
      "start": 6616.0,
      "end": 6622.0,
      "formatted_start": "01:50:16.000",
      "formatted_end": "01:50:22.000",
      "text": "قبل از قایده ای، در رای سینه، کمک، چیزها ندارید."
    },
    {
      "id": 4,
      "start": 6622.0,
      "end": 6625.0,
      "formatted_start": "01:50:22.000",
      "formatted_end": "01:50:25.000",
      "text": "مطاعت چه سالی هستی شما؟"
    },
    {
      "id": 5,
      "start": 6625.0,
      "end": 6655.0,
      "formatted_start": "01:50:25.000",
      "formatted_end": "01:50:55.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا ب"
    },
    {
      "id": 6,
      "start": 6655.0,
      "end": 6658.0,
      "formatted_start": "01:50:55.000",
      "formatted_end": "01:50:58.000",
      "text": "اینجا است"
    },
    {
      "id": 7,
      "start": 6674.0,
      "end": 6677.0,
      "formatted_start": "01:51:14.000",
      "formatted_end": "01:51:17.000",
      "text": "بیماری پی سی او داریم"
    },
    {
      "id": 8,
      "start": 6677.0,
      "end": 6682.0,
      "formatted_start": "01:51:17.000",
      "formatted_end": "01:51:22.000",
      "text": "تو هم با ریزش روی شدیش و روی شدیش روی بدن"
    },
    {
      "id": 9,
      "start": 6682.0,
      "end": 6685.0,
      "formatted_start": "01:51:22.000",
      "formatted_end": "01:51:25.000",
      "text": "پی سی و دوستان بگویید"
    },
    {
      "id": 10,
      "start": 6685.0,
      "end": 6687.0,
      "formatted_start": "01:51:25.000",
      "formatted_end": "01:51:27.000",
      "text": "چانتی بگیرم"
    },
    {
      "id": 11,
      "start": 6687.0,
      "end": 6689.0,
      "formatted_start": "01:51:27.000",
      "formatted_end": "01:51:29.000",
      "text": "لیزر رفتید"
    },
    {
      "id": 12,
      "start": 6689.0,
      "end": 6690.0,
      "formatted_start": "01:51:29.000",
      "formatted_end": "01:51:30.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 6690.0,
      "end": 6692.0,
      "formatted_start": "01:51:30.000",
      "formatted_end": "01:51:32.000",
      "text": "و اصلاح میکنه زودتون"
    },
    {
      "id": 14,
      "start": 6692.0,
      "end": 6694.0,
      "formatted_start": "01:51:32.000",
      "formatted_end": "01:51:34.000",
      "text": "بیرون که که برام میشه باید بره شویش بگیرم"
    },
    {
      "id": 15,
      "start": 6694.0,
      "end": 6695.0,
      "formatted_start": "01:51:34.000",
      "formatted_end": "01:51:35.000",
      "text": "آها"
    },
    {
      "id": 16,
      "start": 6695.0,
      "end": 6698.0,
      "formatted_start": "01:51:35.000",
      "formatted_end": "01:51:38.000",
      "text": "نه لیزر برو برای صورتت برو"
    },
    {
      "id": 17,
      "start": 6698.0,
      "end": 6701.0,
      "formatted_start": "01:51:38.000",
      "formatted_end": "01:51:41.000",
      "text": "ولی برای بردمونو توصیلی بکنم"
    },
    {
      "id": 18,
      "start": 6701.0,
      "end": 6703.0,
      "formatted_start": "01:51:41.000",
      "formatted_end": "01:51:43.000",
      "text": "برای صورتت برو"
    },
    {
      "id": 19,
      "start": 6703.0,
      "end": 6705.0,
      "formatted_start": "01:51:43.000",
      "formatted_end": "01:51:45.000",
      "text": "بشکرم کن"
    },
    {
      "id": 20,
      "start": 6705.0,
      "end": 6707.0,
      "formatted_start": "01:51:45.000",
      "formatted_end": "01:51:47.000",
      "text": "و منم انشاءالله تنظیم کنم"
    },
    {
      "id": 21,
      "start": 6707.0,
      "end": 6709.0,
      "formatted_start": "01:51:47.000",
      "formatted_end": "01:51:49.000",
      "text": "آخر خواهیدگی کن که بوده؟"
    },
    {
      "id": 22,
      "start": 6709.0,
      "end": 6739.0,
      "formatted_start": "01:51:49.000",
      "formatted_end": "01:52:19.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 23,
      "start": 6739.0,
      "end": 6744.0,
      "formatted_start": "01:52:19.000",
      "formatted_end": "01:52:24.000",
      "text": "این تیره رنگو کرد ولی تقریبا به موقع و می آید اون رو ببینیم"
    },
    {
      "id": 24,
      "start": 6744.0,
      "end": 6752.0,
      "formatted_start": "01:52:24.000",
      "formatted_end": "01:52:32.000",
      "text": "یاد و فولیک، برس بیتامین، ده سه، برشنگران، جارس، برس کامپان"
    },
    {
      "id": 25,
      "start": 6752.0,
      "end": 6756.0,
      "formatted_start": "01:52:32.000",
      "formatted_end": "01:52:36.000",
      "text": "برس دمیترون رو می روزم در صورت تهامل بکنیم"
    },
    {
      "id": 26,
      "start": 6756.0,
      "end": 6759.0,
      "formatted_start": "01:52:36.000",
      "formatted_end": "01:52:39.000",
      "text": "اون برس ها مرق نداره؟"
    },
    {
      "id": 27,
      "start": 6759.0,
      "end": 6765.0,
      "formatted_start": "01:52:39.000",
      "formatted_end": "01:52:45.000",
      "text": "نه، اصلا، اصلا من بگم زرار نمی کنم برسید که من خیلی مطلع هستم"
    },
    {
      "id": 28,
      "start": 6765.0,
      "end": 6777.0,
      "formatted_start": "01:52:45.000",
      "formatted_end": "01:52:57.000",
      "text": "برای شبیه جنگیریه، جنگیری بیسمان دخترها هست و برای خنزی میخواهد یکی هست و از سر زده ریزش موری سر و زده موری شنوشن یعنی زده برنامه مردانه داره"
    },
    {
      "id": 29,
      "start": 6777.0,
      "end": 6785.0,
      "formatted_start": "01:52:57.000",
      "formatted_end": "01:53:05.000",
      "text": "رشیده رو هم کم کنه، با اون قرصان جنگیری فراموش داره، ولی با چینششون 21 گیر شبیه"
    },
    {
      "id": 30,
      "start": 6785.0,
      "end": 6787.0,
      "formatted_start": "01:53:05.000",
      "formatted_end": "01:53:07.000",
      "text": "از که شروع کنه برنامه؟"
    },
    {
      "id": 31,
      "start": 6787.0,
      "end": 6788.0,
      "formatted_start": "01:53:07.000",
      "formatted_end": "01:53:08.000",
      "text": "از این شروع"
    },
    {
      "id": 32,
      "start": 6788.0,
      "end": 6789.0,
      "formatted_start": "01:53:08.000",
      "formatted_end": "01:53:09.000",
      "text": "از اون 21 گیر شروع"
    },
    {
      "id": 33,
      "start": 6789.0,
      "end": 6791.0,
      "formatted_start": "01:53:09.000",
      "formatted_end": "01:53:11.000",
      "text": "بعدش قطع کنه؟"
    },
    {
      "id": 34,
      "start": 6791.0,
      "end": 6793.0,
      "formatted_start": "01:53:11.000",
      "formatted_end": "01:53:13.000",
      "text": "و قادم بشه میاز"
    },
    {
      "id": 35,
      "start": 6793.0,
      "end": 6795.0,
      "formatted_start": "01:53:13.000",
      "formatted_end": "01:53:15.000",
      "text": "تو باید برادر بشه"
    },
    {
      "id": 36,
      "start": 6795.0,
      "end": 6797.0,
      "formatted_start": "01:53:15.000",
      "formatted_end": "01:53:17.000",
      "text": "چند تا اون گریزه"
    },
    {
      "id": 37,
      "start": 6797.0,
      "end": 6799.0,
      "formatted_start": "01:53:17.000",
      "formatted_end": "01:53:19.000",
      "text": "بین دست مانشی بارد کنه"
    },
    {
      "id": 38,
      "start": 6799.0,
      "end": 6801.0,
      "formatted_start": "01:53:19.000",
      "formatted_end": "01:53:21.000",
      "text": "این جوشاش هم بخاطر همینه که جوش شد"
    },
    {
      "id": 39,
      "start": 6801.0,
      "end": 6803.0,
      "formatted_start": "01:53:21.000",
      "formatted_end": "01:53:23.000",
      "text": "همینه بارد"
    },
    {
      "id": 40,
      "start": 6803.0,
      "end": 6805.0,
      "formatted_start": "01:53:23.000",
      "formatted_end": "01:53:25.000",
      "text": "تو خوشحالت باید اسمش میگی"
    },
    {
      "id": 41,
      "start": 6805.0,
      "end": 6807.0,
      "formatted_start": "01:53:25.000",
      "formatted_end": "01:53:27.000",
      "text": "بیوزدگی"
    },
    {
      "id": 42,
      "start": 6807.0,
      "end": 6809.0,
      "formatted_start": "01:53:27.000",
      "formatted_end": "01:53:29.000",
      "text": "و بدون اونیکی مانشی بارد کنه این بارد"
    },
    {
      "id": 43,
      "start": 6809.0,
      "end": 6811.0,
      "formatted_start": "01:53:29.000",
      "formatted_end": "01:53:31.000",
      "text": "بردرسی که بردرسی"
    },
    {
      "id": 44,
      "start": 6811.0,
      "end": 6813.0,
      "formatted_start": "01:53:31.000",
      "formatted_end": "01:53:33.000",
      "text": "شما درست کنید اسم"
    },
    {
      "id": 45,
      "start": 6813.0,
      "end": 6815.0,
      "formatted_start": "01:53:33.000",
      "formatted_end": "01:53:35.000",
      "text": "مادر اونو بردرسی"
    },
    {
      "id": 46,
      "start": 6815.0,
      "end": 6817.0,
      "formatted_start": "01:53:35.000",
      "formatted_end": "01:53:37.000",
      "text": "بردرسی که از اینکه از اینکه از اینکه"
    },
    {
      "id": 47,
      "start": 6817.0,
      "end": 6819.0,
      "formatted_start": "01:53:37.000",
      "formatted_end": "01:53:39.000",
      "text": "با اسم خودتون میدونید"
    },
    {
      "id": 48,
      "start": 6819.0,
      "end": 6821.0,
      "formatted_start": "01:53:39.000",
      "formatted_end": "01:53:41.000",
      "text": "بگید دست منشی"
    },
    {
      "id": 49,
      "start": 6821.0,
      "end": 6823.0,
      "formatted_start": "01:53:41.000",
      "formatted_end": "01:53:43.000",
      "text": "منشی یکی شان وارد شده"
    },
    {
      "id": 50,
      "start": 6823.0,
      "end": 6825.0,
      "formatted_start": "01:53:43.000",
      "formatted_end": "01:53:45.000",
      "text": "یکی شان نرمیده"
    },
    {
      "id": 51,
      "start": 6825.0,
      "end": 6827.0,
      "formatted_start": "01:53:45.000",
      "formatted_end": "01:53:47.000",
      "text": "بفرما"
    },
    {
      "id": 52,
      "start": 6829.0,
      "end": 6831.0,
      "formatted_start": "01:53:49.000",
      "formatted_end": "01:53:51.000",
      "text": "مرسی"
    },
    {
      "id": 53,
      "start": 6831.0,
      "end": 6833.0,
      "formatted_start": "01:53:51.000",
      "formatted_end": "01:53:53.000",
      "text": "چی شده روی صدایی؟"
    },
    {
      "id": 54,
      "start": 6833.0,
      "end": 6835.0,
      "formatted_start": "01:53:53.000",
      "formatted_end": "01:53:55.000",
      "text": "من برم بگم"
    },
    {
      "id": 55,
      "start": 6835.0,
      "end": 6837.0,
      "formatted_start": "01:53:55.000",
      "formatted_end": "01:53:57.000",
      "text": "برم برم برم برم"
    },
    {
      "id": 56,
      "start": 6837.0,
      "end": 6839.0,
      "formatted_start": "01:53:57.000",
      "formatted_end": "01:53:59.000",
      "text": "الان چطور هستی؟ نصف قبلی رو نیواندی؟"
    },
    {
      "id": 57,
      "start": 6839.0,
      "end": 6841.0,
      "formatted_start": "01:53:59.000",
      "formatted_end": "01:54:01.000",
      "text": "نه"
    },
    {
      "id": 58,
      "start": 6841.0,
      "end": 6843.0,
      "formatted_start": "01:54:01.000",
      "formatted_end": "01:54:03.000",
      "text": "بیرون بگه من"
    },
    {
      "id": 59,
      "start": 6843.0,
      "end": 6845.0,
      "formatted_start": "01:54:03.000",
      "formatted_end": "01:54:05.000",
      "text": "برم برم برم"
    },
    {
      "id": 60,
      "start": 6845.0,
      "end": 6848.0,
      "formatted_start": "01:54:05.000",
      "formatted_end": "01:54:08.000",
      "text": "کند روز شده از اون سر؟"
    },
    {
      "id": 61,
      "start": 6848.0,
      "end": 6849.0,
      "formatted_start": "01:54:08.000",
      "formatted_end": "01:54:09.000",
      "text": "بده من"
    },
    {
      "id": 62,
      "start": 6851.0,
      "end": 6852.0,
      "formatted_start": "01:54:11.000",
      "formatted_end": "01:54:12.000",
      "text": "یاالله"
    },
    {
      "id": 63,
      "start": 6852.0,
      "end": 6853.0,
      "formatted_start": "01:54:12.000",
      "formatted_end": "01:54:13.000",
      "text": "18"
    },
    {
      "id": 64,
      "start": 6853.0,
      "end": 6854.0,
      "formatted_start": "01:54:13.000",
      "formatted_end": "01:54:14.000",
      "text": "امروز"
    },
    {
      "id": 65,
      "start": 6854.0,
      "end": 6855.0,
      "formatted_start": "01:54:14.000",
      "formatted_end": "01:54:15.000",
      "text": "25"
    },
    {
      "id": 66,
      "start": 6855.0,
      "end": 6859.0,
      "formatted_start": "01:54:15.000",
      "formatted_end": "01:54:19.000",
      "text": "دردت یکم کاهش بدا کرد؟"
    },
    {
      "id": 67,
      "start": 6859.0,
      "end": 6860.0,
      "formatted_start": "01:54:19.000",
      "formatted_end": "01:54:20.000",
      "text": "آره آره"
    },
    {
      "id": 68,
      "start": 6860.0,
      "end": 6861.0,
      "formatted_start": "01:54:20.000",
      "formatted_end": "01:54:21.000",
      "text": "برای خیلی"
    },
    {
      "id": 69,
      "start": 6861.0,
      "end": 6863.0,
      "formatted_start": "01:54:21.000",
      "formatted_end": "01:54:23.000",
      "text": "دردشو شو"
    },
    {
      "id": 70,
      "start": 6863.0,
      "end": 6866.0,
      "formatted_start": "01:54:23.000",
      "formatted_end": "01:54:26.000",
      "text": "بسته بزار روی تخت می کنی؟"
    },
    {
      "id": 71,
      "start": 6866.0,
      "end": 6868.0,
      "formatted_start": "01:54:26.000",
      "formatted_end": "01:54:28.000",
      "text": "بسته روی تخت بزار"
    },
    {
      "id": 72,
      "start": 6868.0,
      "end": 6870.0,
      "formatted_start": "01:54:28.000",
      "formatted_end": "01:54:30.000",
      "text": "با این اوتا اوتا"
    },
    {
      "id": 73,
      "start": 6870.0,
      "end": 6873.0,
      "formatted_start": "01:54:30.000",
      "formatted_end": "01:54:33.000",
      "text": "بسته بزار"
    },
    {
      "id": 74,
      "start": 6873.0,
      "end": 6875.0,
      "formatted_start": "01:54:33.000",
      "formatted_end": "01:54:35.000",
      "text": "این پابون؟"
    },
    {
      "id": 75,
      "start": 6875.0,
      "end": 6877.0,
      "formatted_start": "01:54:35.000",
      "formatted_end": "01:54:37.000",
      "text": "آره، اونیست همه خوبه"
    },
    {
      "id": 76,
      "start": 6879.0,
      "end": 6881.0,
      "formatted_start": "01:54:39.000",
      "formatted_end": "01:54:41.000",
      "text": "دختر کشی کشتن"
    },
    {
      "id": 77,
      "start": 6885.0,
      "end": 6887.0,
      "formatted_start": "01:54:45.000",
      "formatted_end": "01:54:47.000",
      "text": "اینجا چطوره؟"
    },
    {
      "id": 78,
      "start": 6887.0,
      "end": 6889.0,
      "formatted_start": "01:54:47.000",
      "formatted_end": "01:54:49.000",
      "text": "اینجا خوبه"
    },
    {
      "id": 79,
      "start": 6889.0,
      "end": 6891.0,
      "formatted_start": "01:54:49.000",
      "formatted_end": "01:54:51.000",
      "text": "فرضش یاد داده، ما اینجا میدیم"
    },
    {
      "id": 80,
      "start": 6891.0,
      "end": 6893.0,
      "formatted_start": "01:54:51.000",
      "formatted_end": "01:54:53.000",
      "text": "اینجا نه"
    },
    {
      "id": 81,
      "start": 6895.0,
      "end": 6897.0,
      "formatted_start": "01:54:55.000",
      "formatted_end": "01:54:57.000",
      "text": "خیلی کم شده"
    },
    {
      "id": 82,
      "start": 6897.0,
      "end": 6899.0,
      "formatted_start": "01:54:57.000",
      "formatted_end": "01:54:59.000",
      "text": "نه خیلی کم شده"
    },
    {
      "id": 83,
      "start": 6899.0,
      "end": 6901.0,
      "formatted_start": "01:54:59.000",
      "formatted_end": "01:55:01.000",
      "text": "ولی اینجا هستن"
    }
  ],
  "status": "completed"
}