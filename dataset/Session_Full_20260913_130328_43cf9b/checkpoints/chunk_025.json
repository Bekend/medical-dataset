  "stt_segments": [
    {
      "id": 0,
      "start": 7500.0,
      "end": 7529.98,
      "formatted_start": "02:05:00.000",
      "formatted_end": "02:05:29.980",
      "text": "بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 7530.0,
      "end": 7533.16,
      "formatted_start": "02:05:30.000",
      "formatted_end": "02:05:33.160",
      "text": "کمه چرب بینهایت"
    },
    {
      "id": 2,
      "start": 7533.16,
      "end": 7535.32,
      "formatted_start": "02:05:33.160",
      "formatted_end": "02:05:35.320",
      "text": "قضای زمستانی خوردیم"
    },
    {
      "id": 3,
      "start": 7535.32,
      "end": 7536.16,
      "formatted_start": "02:05:35.320",
      "formatted_end": "02:05:36.160",
      "text": "مثل عدس برو"
    },
    {
      "id": 4,
      "start": 7536.16,
      "end": 7537.4,
      "formatted_start": "02:05:36.160",
      "formatted_end": "02:05:37.400",
      "text": "تحچین"
    },
    {
      "id": 5,
      "start": 7537.4,
      "end": 7538.42,
      "formatted_start": "02:05:37.400",
      "formatted_end": "02:05:38.420",
      "text": "اینو برای زمستانی"
    },
    {
      "id": 6,
      "start": 7538.42,
      "end": 7542.76,
      "formatted_start": "02:05:38.420",
      "formatted_end": "02:05:42.760",
      "text": "تحچین برای زمستانی"
    },
    {
      "id": 7,
      "start": 7542.76,
      "end": 7544.32,
      "formatted_start": "02:05:42.760",
      "formatted_end": "02:05:44.320",
      "text": "ما میخواییم موقعی که برف بیا"
    },
    {
      "id": 8,
      "start": 7544.32,
      "end": 7546.82,
      "formatted_start": "02:05:44.320",
      "formatted_end": "02:05:46.820",
      "text": "زنگی زنگ خانم هم میگه برف داریم"
    },
    {
      "id": 9,
      "start": 7546.82,
      "end": 7548.34,
      "formatted_start": "02:05:46.820",
      "formatted_end": "02:05:48.340",
      "text": "تحچین درست برو گرد برو"
    },
    {
      "id": 10,
      "start": 7548.34,
      "end": 7549.3,
      "formatted_start": "02:05:48.340",
      "formatted_end": "02:05:49.300",
      "text": "شاده نشکار بود"
    },
    {
      "id": 11,
      "start": 7549.3,
      "end": 7552.64,
      "formatted_start": "02:05:49.300",
      "formatted_end": "02:05:52.640",
      "text": "توی زنگ شدن"
    },
    {
      "id": 12,
      "start": 7552.64,
      "end": 7553.96,
      "formatted_start": "02:05:52.640",
      "formatted_end": "02:05:53.960",
      "text": "خرابه"
    },
    {
      "id": 13,
      "start": 7553.96,
      "end": 7555.98,
      "formatted_start": "02:05:53.960",
      "formatted_end": "02:05:55.980",
      "text": "صد و هشت گیوه برزن شده"
    },
    {
      "id": 14,
      "start": 7555.98,
      "end": 7558.26,
      "formatted_start": "02:05:55.980",
      "formatted_end": "02:05:58.260",
      "text": "برای هشتات بودم خیلی آری بودم"
    },
    {
      "id": 15,
      "start": 7558.26,
      "end": 7560.26,
      "formatted_start": "02:05:58.260",
      "formatted_end": "02:06:00.260",
      "text": "بگی غصه نکنی"
    },
    {
      "id": 16,
      "start": 7560.26,
      "end": 7566.26,
      "formatted_start": "02:06:00.260",
      "formatted_end": "02:06:06.260",
      "text": "اما دو سه رقم داده ای تا شما و کسی شما نیام به هیچ دکتر حقیقه اعتقاد نداریم"
    },
    {
      "id": 17,
      "start": 7566.26,
      "end": 7568.26,
      "formatted_start": "02:06:06.260",
      "formatted_end": "02:06:08.260",
      "text": "اما اینقدر تنظیم کل به خدا"
    },
    {
      "id": 18,
      "start": 7568.26,
      "end": 7570.26,
      "formatted_start": "02:06:08.260",
      "formatted_end": "02:06:10.260",
      "text": "به دکتر همانطوری بناییم"
    },
    {
      "id": 19,
      "start": 7570.26,
      "end": 7572.26,
      "formatted_start": "02:06:10.260",
      "formatted_end": "02:06:12.260",
      "text": "اولا که خدا برده"
    },
    {
      "id": 20,
      "start": 7572.26,
      "end": 7576.26,
      "formatted_start": "02:06:12.260",
      "formatted_end": "02:06:16.260",
      "text": "درست شما خاله میداریم شاید از خانواده ای بگیره همه"
