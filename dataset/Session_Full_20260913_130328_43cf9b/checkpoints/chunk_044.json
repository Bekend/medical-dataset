      "text": "یک تارش دیگه نفتی بودیم"
    },
    {
      "id": 4,
      "start": 13264.0,
      "end": 13266.0,
      "formatted_start": "03:41:04.000",
      "formatted_end": "03:41:06.000",
      "text": "یک تارش پید بوده"
    },
    {
      "id": 5,
      "start": 13266.0,
      "end": 13268.0,
      "formatted_start": "03:41:06.000",
      "formatted_end": "03:41:08.000",
      "text": "چهار اکرام شده"
    },
    {
      "id": 6,
      "start": 13268.0,
      "end": 13270.0,
      "formatted_start": "03:41:08.000",
      "formatted_end": "03:41:10.000",
      "text": "ترم ها 25 این"
    },
    {
      "id": 7,
      "start": 13270.0,
      "end": 13272.0,
      "formatted_start": "03:41:10.000",
      "formatted_end": "03:41:12.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 8,
      "start": 13272.0,
      "end": 13274.0,
      "formatted_start": "03:41:12.000",
      "formatted_end": "03:41:14.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 9,
      "start": 13274.0,
      "end": 13276.0,
      "formatted_start": "03:41:14.000",
      "formatted_end": "03:41:16.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 10,
      "start": 13276.0,
      "end": 13278.0,
      "formatted_start": "03:41:16.000",
      "formatted_end": "03:41:18.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 11,
      "start": 13278.0,
      "end": 13280.0,
      "formatted_start": "03:41:18.000",
      "formatted_end": "03:41:20.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 12,
      "start": 13280.0,
      "end": 13282.0,
      "formatted_start": "03:41:20.000",
      "formatted_end": "03:41:22.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 13,
      "start": 13282.0,
      "end": 13284.0,
      "formatted_start": "03:41:22.000",
      "formatted_end": "03:41:24.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 14,
      "start": 13284.0,
      "end": 13286.0,
      "formatted_start": "03:41:24.000",
      "formatted_end": "03:41:26.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 15,
      "start": 13286.0,
      "end": 13288.0,
      "formatted_start": "03:41:26.000",
      "formatted_end": "03:41:28.000",
      "text": "بیستون و پترون"
    },
    {
      "id": 16,
      "start": 13288.0,
      "end": 13290.0,
      "formatted_start": "03:41:28.000",
      "formatted_end": "03:41:30.000",
      "text": "۲۰ تا ۱۰ رو بیرونیم"
    },
    {
      "id": 17,
      "start": 13290.0,
      "end": 13293.0,
      "formatted_start": "03:41:30.000",
      "formatted_end": "03:41:33.000",
      "text": "۳۰ تا ۱۰"
    },
    {
      "id": 18,
      "start": 13293.0,
      "end": 13296.0,
      "formatted_start": "03:41:33.000",
      "formatted_end": "03:41:36.000",
      "text": "۲۰ تا ۱۰"
    },
    {
      "id": 19,
      "start": 13296.0,
      "end": 13301.0,
      "formatted_start": "03:41:36.000",
      "formatted_end": "03:41:41.000",
      "text": "19, 5, 18"
    },
    {
      "id": 20,
      "start": 13301.0,
      "end": 13305.0,
      "formatted_start": "03:41:41.000",
      "formatted_end": "03:41:45.000",
      "text": "1, 3, 4, 3"
    },
    {
      "id": 21,
      "start": 13305.0,
      "end": 13308.0,
      "formatted_start": "03:41:45.000",
      "formatted_end": "03:41:48.000",
      "text": "2, 3, 36"
    },
    {
      "id": 22,
      "start": 13308.0,
      "end": 13310.0,
      "formatted_start": "03:41:48.000",
      "formatted_end": "03:41:50.000",
      "text": "تا مشکلی بیرون"
    },
    {
      "id": 23,
      "start": 13310.0,
      "end": 13313.0,
      "formatted_start": "03:41:50.000",
      "formatted_end": "03:41:53.000",
      "text": "این یکی اداره خوب شده برموند"
    },
    {
      "id": 24,
      "start": 13313.0,
      "end": 13317.0,
      "formatted_start": "03:41:53.000",
      "formatted_end": "03:41:57.000",
      "text": "1, 3, 36"
    },
    {
      "id": 25,
      "start": 13317.0,
      "end": 13320.0,
      "formatted_start": "03:41:57.000",
      "formatted_end": "03:42:00.000",
      "text": "تا برمونده بیرونده"
    },
    {
      "id": 26,
      "start": 13320.0,
      "end": 13324.0,
      "formatted_start": "03:42:00.000",
      "formatted_end": "03:42:04.000",
      "text": "1, 3, 45"
    },
    {
      "id": 27,
      "start": 13324.0,
      "end": 13326.0,
      "formatted_start": "03:42:04.000",
      "formatted_end": "03:42:06.000",
      "text": "محسن گوشتنجا چهتر؟"
    },
    {
      "id": 28,
      "start": 13326.0,
      "end": 13330.0,
      "formatted_start": "03:42:06.000",
      "formatted_end": "03:42:10.000",
      "text": "برد ستروسیب و شرکتیفن"
    },
    {
      "id": 29,
      "start": 13330.0,
      "end": 13335.0,
      "formatted_start": "03:42:10.000",
      "formatted_end": "03:42:15.000",
      "text": "ستر کپسون سرکسیب و دیویست ستر"
    },
    {
      "id": 30,
      "start": 13335.0,
      "end": 13337.0,
      "formatted_start": "03:42:15.000",
      "formatted_end": "03:42:17.000",
      "text": "شرکتیفن"
    },
    {
      "id": 31,
      "start": 13337.0,
      "end": 13339.0,
      "formatted_start": "03:42:17.000",
      "formatted_end": "03:42:19.000",
      "text": "در مامان خیلی خودش بیهاله"
    },
    {
      "id": 32,
      "start": 13339.0,
      "end": 13342.0,
      "formatted_start": "03:42:19.000",
      "formatted_end": "03:42:22.000",
      "text": "ایترامی خیلی خیلی خیلی خیلی ویدوینداری نیست"
    },
    {
      "id": 33,
      "start": 13342.0,
      "end": 13346.0,
      "formatted_start": "03:42:22.000",
      "formatted_end": "03:42:26.000",
      "text": "و خب برای بیهالیش آن پول بدن بزنه؟"
    },
    {
      "id": 34,
      "start": 13346.0,
      "end": 13348.0,
      "formatted_start": "03:42:26.000",
      "formatted_end": "03:42:28.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 35,
      "start": 13348.0,
      "end": 13350.0,
      "formatted_start": "03:42:28.000",
      "formatted_end": "03:42:30.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 36,
      "start": 13350.0,
      "end": 13352.0,
      "formatted_start": "03:42:30.000",
      "formatted_end": "03:42:32.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 37,
      "start": 13352.0,
      "end": 13354.0,
      "formatted_start": "03:42:32.000",
      "formatted_end": "03:42:34.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 38,
      "start": 13354.0,
      "end": 13356.0,
      "formatted_start": "03:42:34.000",
      "formatted_end": "03:42:36.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 39,
      "start": 13356.0,
      "end": 13358.0,
      "formatted_start": "03:42:36.000",
      "formatted_end": "03:42:38.000",
      "text": "اینکه باید برداری کنید و باید برداری کنید"
    },
    {
      "id": 40,
      "start": 13358.0,
      "end": 13361.0,
      "formatted_start": "03:42:38.000",
      "formatted_end": "03:42:41.000",
      "text": "سه رو هستیم این ده ها رو در سر بگیرم"
    },
    {
      "id": 41,
      "start": 13361.0,
      "end": 13363.0,
      "formatted_start": "03:42:41.000",
      "formatted_end": "03:42:43.000",
      "text": "سه سه سی دو تا سه رو بگیرم"
    },
    {
      "id": 42,
      "start": 13363.0,
      "end": 13367.0,
      "formatted_start": "03:42:43.000",
      "formatted_end": "03:42:47.000",
      "text": "با پایین دهیت رو رو چیزم برزده بخورم"
    },
    {
      "id": 43,
      "start": 13367.0,
      "end": 13368.0,
      "formatted_start": "03:42:47.000",
      "formatted_end": "03:42:48.000",
      "text": "سه رو هستیم"
    },
    {
      "id": 44,
      "start": 13368.0,
      "end": 13370.0,
      "formatted_start": "03:42:48.000",
      "formatted_end": "03:42:50.000",
      "text": "دهیت رو برزده بخورم"
    },
    {
      "id": 45,
      "start": 13370.0,
      "end": 13371.0,
      "formatted_start": "03:42:50.000",
      "formatted_end": "03:42:51.000",
      "text": "سه"
    },
    {
      "id": 46,
      "start": 13371.0,
      "end": 13373.0,
      "formatted_start": "03:42:51.000",
      "formatted_end": "03:42:53.000",
      "text": "دهیت رو برزده بخورم"
    },
    {
      "id": 47,
      "start": 13373.0,
      "end": 13375.0,
      "formatted_start": "03:42:53.000",
      "formatted_end": "03:42:55.000",
      "text": "این همه کن سه دیگه سی به دیویز"
    },
    {
      "id": 48,
      "start": 13375.0,
      "end": 13378.0,
      "formatted_start": "03:42:55.000",
      "formatted_end": "03:42:58.000",
      "text": "دهیتش رو برگرم یک جا نخورم ها"
    },
    {
      "id": 49,
      "start": 13378.0,
      "end": 13379.0,
      "formatted_start": "03:42:58.000",
      "formatted_end": "03:42:59.000",
      "text": "جا؟"
    },
    {
      "id": 50,
      "start": 13379.0,
      "end": 13380.0,
      "formatted_start": "03:42:59.000",
      "formatted_end": "03:43:00.000",
      "text": "یک جا نخورم تا"
    },
    {
      "id": 51,
      "start": 13380.0,
      "end": 13381.0,
      "formatted_start": "03:43:00.000",
      "formatted_end": "03:43:01.000",
      "text": "اوه"
    },
    {
      "id": 52,
      "start": 13381.0,
      "end": 13382.0,
      "formatted_start": "03:43:01.000",
      "formatted_end": "03:43:02.000",
      "text": "۲۵"
    },
    {
      "id": 53,
      "start": 13382.0,
      "end": 13383.0,
      "formatted_start": "03:43:02.000",
      "formatted_end": "03:43:03.000",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 13383.0,
      "end": 13392.0,
      "formatted_start": "03:43:03.000",
      "formatted_end": "03:43:12.000",
      "text": "نه که نه کنم چند وقت داریم دیگه هم نمیدونیم دیگه آخری رو بگیم دیدم که زخیره داروش میتونیم"
    },
    {
      "id": 55,
      "start": 13392.0,
      "end": 13396.0,
      "formatted_start": "03:43:12.000",
      "formatted_end": "03:43:16.000",
      "text": "آره باشیم که دیگه دوتا دفتر چه دیگه بیشتر هم که چیز نشیدیم"
    },
    {
      "id": 56,
      "start": 13396.0,
      "end": 13398.0,
      "formatted_start": "03:43:16.000",
      "formatted_end": "03:43:18.000",
      "text": "خطوه دیگه بیم"
    },
    {
      "id": 57,
      "start": 13404.0,
      "end": 13409.0,
      "formatted_start": "03:43:24.000",
      "formatted_end": "03:43:29.000",
      "text": "سرورستی یه وقتی همچین دستخیمون بیده که میتونم برگز میبنم بفروشیم"
    },
    {
      "id": 58,
      "start": 13409.0,
      "end": 13418.0,
      "formatted_start": "03:43:29.000",
      "formatted_end": "03:43:38.000",
      "text": "آه، می کنم که هشت فرق از شما نیست ولی اون نیست من. یه غذاکو بیزنن برای ما که..."
    },
    {
      "id": 59,
      "start": 13418.0,
      "end": 13426.0,
      "formatted_start": "03:43:38.000",
      "formatted_end": "03:43:46.000",
      "text": "ما مثل داروان بودیم، با خودم اروعین اندک که کم بوده دارو بود."
    },
    {
      "id": 60,
      "start": 13426.0,
      "end": 13428.0,
      "formatted_start": "03:43:46.000",
      "formatted_end": "03:43:48.000",
      "text": "برای کت مردم بودیم؟"
    },
    {
      "id": 61,
      "start": 13428.0,
      "end": 13433.0,
      "formatted_start": "03:43:48.000",
      "formatted_end": "03:43:53.000",
      "text": "نه هم، نه هم آمان هم اصلا یه دردجو زدن بود، اما که خودم بود."
    },
    {
      "id": 62,
      "start": 13433.0,
      "end": 13434.0,
      "formatted_start": "03:43:53.000",
      "formatted_end": "03:43:54.000",
      "text": "بله؟"
    },
    {
      "id": 63,
      "start": 13434.0,
      "end": 13436.0,
      "formatted_start": "03:43:54.000",
      "formatted_end": "03:43:56.000",
      "text": "اصلا از خودم بود."
    },
    {
      "id": 64,
      "start": 13436.0,
      "end": 13443.0,
      "formatted_start": "03:43:56.000",
      "formatted_end": "03:44:03.000",
      "text": "خود اربعین کجا بودی؟ روز اربعین بودی؟ روز اربعین بسیار ایران"
    },
    {
      "id": 65,
      "start": 13443.0,
      "end": 13445.0,
      "formatted_start": "03:44:03.000",
      "formatted_end": "03:44:05.000",
      "text": "اینجا بست؟ آره"
    },
    {
      "id": 66,
      "start": 13445.0,
      "end": 13447.0,
      "formatted_start": "03:44:05.000",
      "formatted_end": "03:44:07.000",
      "text": "که ازید شدید گرمون؟"
    },
    {
      "id": 67,
      "start": 13447.0,
      "end": 13450.0,
      "formatted_start": "03:44:07.000",
      "formatted_end": "03:44:10.000",
      "text": "من مریض شدم، من ازید شدم"
    },
    {
      "id": 68,
      "start": 13450.0,
      "end": 13451.0,
      "formatted_start": "03:44:10.000",
      "formatted_end": "03:44:11.000",
      "text": "مامان چی؟"
    },
    {
      "id": 69,
      "start": 13451.0,
      "end": 13455.0,
      "formatted_start": "03:44:11.000",
      "formatted_end": "03:44:15.000",
      "text": "مامان امسای نمی آمد، آبجی امتحان نهایی داره"
    },
    {
      "id": 70,
      "start": 13455.0,
      "end": 13456.0,
      "formatted_start": "03:44:15.000",
      "formatted_end": "03:44:16.000",
      "text": "با کی رفتی تو؟"
    },
    {
      "id": 71,
      "start": 13456.0,
      "end": 13458.0,
      "formatted_start": "03:44:16.000",
      "formatted_end": "03:44:18.000",
      "text": "من با عمه و شهر عمه بود"
    },
    {
      "id": 72,
      "start": 13458.0,
      "end": 13460.0,
      "formatted_start": "03:44:18.000",
      "formatted_end": "03:44:20.000",
      "text": "عمه و شهر عمه؟"
    },
    {
      "id": 73,
      "start": 13460.0,
      "end": 13461.0,
      "formatted_start": "03:44:20.000",
      "formatted_end": "03:44:21.000",
      "text": "آره"
    },
    {
      "id": 74,
      "start": 13461.0,
      "end": 13462.0,
      "formatted_start": "03:44:21.000",
      "formatted_end": "03:44:22.000",
      "text": "و مامان مام؟"
    },
    {
      "id": 75,
      "start": 13462.0,
      "end": 13465.0,
      "formatted_start": "03:44:22.000",
      "formatted_end": "03:44:25.000",
      "text": "مامان با آبجی موندن دیگه"
    },
    {
      "id": 76,
      "start": 13465.0,
      "end": 13468.0,
      "formatted_start": "03:44:25.000",
      "formatted_end": "03:44:28.000",
      "text": "و هیچ عذیتی هم نشدید دیگر؟"
    },
    {
      "id": 77,
      "start": 13468.0,
      "end": 13470.0,
      "formatted_start": "03:44:28.000",
      "formatted_end": "03:44:30.000",
      "text": "من اصلا عذیت نشدم"
    },
    {
      "id": 78,
      "start": 13470.0,
      "end": 13473.0,
      "formatted_start": "03:44:30.000",
      "formatted_end": "03:44:33.000",
      "text": "سرن تو اون طریق رفتن اصاله صفر آخشون؟"
    },
    {
      "id": 79,
      "start": 13473.0,
      "end": 13477.0,
      "formatted_start": "03:44:33.000",
      "formatted_end": "03:44:37.000",
      "text": "بسه میاد اونجا همه یک گرمزده بودن یک سرمو خورده بودن"
    },
    {
      "id": 80,
      "start": 13477.0,
      "end": 13478.0,
      "formatted_start": "03:44:37.000",
      "formatted_end": "03:44:38.000",
      "text": "تو مثل ایران بود؟"
    },
    {
      "id": 81,
      "start": 13478.0,
      "end": 13480.0,
      "formatted_start": "03:44:38.000",
      "formatted_end": "03:44:40.000",
      "text": "آره، ازم فرقردم"
    },
    {
      "id": 82,
      "start": 13480.0,
      "end": 13482.0,
      "formatted_start": "03:44:40.000",
      "formatted_end": "03:44:42.000",
      "text": "تهمتون بود"
    },
    {
      "id": 83,
      "start": 13482.0,
      "end": 13487.0,
      "formatted_start": "03:44:42.000",
      "formatted_end": "03:44:47.000",
      "text": "نه، از اینطور که ایران رو رسیدیم بازم مثلا علمان شده بودم"
    },
    {
      "id": 84,
      "start": 13487.0,
      "end": 13490.0,
