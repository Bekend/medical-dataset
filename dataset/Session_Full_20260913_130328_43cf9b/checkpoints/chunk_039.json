      "text": "این ها در چیزه؟"
    },
    {
      "id": 11,
      "start": 11762.0,
      "end": 11764.0,
      "formatted_start": "03:16:02.000",
      "formatted_end": "03:16:04.000",
      "text": "این هستاسیته"
    },
    {
      "id": 12,
      "start": 11764.0,
      "end": 11768.0,
      "formatted_start": "03:16:04.000",
      "formatted_end": "03:16:08.000",
      "text": "خرمز و عمبه هم نکاری"
    },
    {
      "id": 13,
      "start": 11768.0,
      "end": 11772.0,
      "formatted_start": "03:16:08.000",
      "formatted_end": "03:16:12.000",
      "text": "خرمزی کنند و سرده را عمبه هم نکاری"
    },
    {
      "id": 14,
      "start": 11772.0,
      "end": 11774.0,
      "formatted_start": "03:16:12.000",
      "formatted_end": "03:16:14.000",
      "text": "عمبه هم نمیخوره"
    },
    {
      "id": 15,
      "start": 11774.0,
      "end": 11776.0,
      "formatted_start": "03:16:14.000",
      "formatted_end": "03:16:16.000",
      "text": "شیر عمبه"
    },
    {
      "id": 16,
      "start": 11776.0,
      "end": 11778.0,
      "formatted_start": "03:16:16.000",
      "formatted_end": "03:16:18.000",
      "text": "عمبه وصلی"
    },
    {
      "id": 17,
      "start": 11778.0,
      "end": 11780.0,
      "formatted_start": "03:16:18.000",
      "formatted_end": "03:16:20.000",
      "text": "عمبه وصلی میخوره دیگه"
    },
    {
      "id": 18,
      "start": 11780.0,
      "end": 11782.0,
      "formatted_start": "03:16:20.000",
      "formatted_end": "03:16:22.000",
      "text": "عمبه زیاد بخوره رشتر میاری"
    },
    {
      "id": 19,
      "start": 11782.0,
      "end": 11784.0,
      "formatted_start": "03:16:22.000",
      "formatted_end": "03:16:24.000",
      "text": "رشتر میاری"
    },
    {
      "id": 20,
      "start": 11784.0,
      "end": 11786.0,
      "formatted_start": "03:16:24.000",
      "formatted_end": "03:16:26.000",
      "text": "نه زیاد که نیست"
    },
    {
      "id": 21,
      "start": 11786.0,
      "end": 11788.0,
      "formatted_start": "03:16:26.000",
      "formatted_end": "03:16:28.000",
      "text": "گرد میخورده دیگه"
    },
    {
      "id": 22,
      "start": 11788.0,
      "end": 11790.0,
      "formatted_start": "03:16:28.000",
      "formatted_end": "03:16:30.000",
      "text": "این روستا بودی"
    },
    {
      "id": 23,
      "start": 11790.0,
      "end": 11792.0,
      "formatted_start": "03:16:30.000",
      "formatted_end": "03:16:32.000",
      "text": "زیر درخت انجیر"
    },
    {
      "id": 24,
      "start": 11792.0,
      "end": 11795.0,
      "formatted_start": "03:16:32.000",
      "formatted_end": "03:16:35.000",
      "text": "آره اون گرده برگ انجیر اینجوری میتونه"
    },
    {
      "id": 25,
      "start": 11795.0,
      "end": 11798.0,
      "formatted_start": "03:16:35.000",
      "formatted_end": "03:16:38.000",
      "text": "یه مرباش هم نخور"
    },
    {
      "id": 26,
      "start": 11798.0,
      "end": 11802.0,
      "formatted_start": "03:16:38.000",
      "formatted_end": "03:16:42.000",
      "text": "یه اسپریه در روش رشته زده زنبور گذیده"
    },
    {
      "id": 27,
      "start": 11802.0,
      "end": 11806.0,
      "formatted_start": "03:16:42.000",
      "formatted_end": "03:16:46.000",
      "text": "میزنی ماساج بزن زنبور رو از اداعه هستاسیت کم میخوره"
    },
    {
      "id": 28,
      "start": 11806.0,
      "end": 11808.0,
      "formatted_start": "03:16:46.000",
      "formatted_end": "03:16:48.000",
      "text": "بعد کمات میباری"
    },
    {
      "id": 29,
      "start": 11808.0,
      "end": 11810.0,
      "formatted_start": "03:16:48.000",
      "formatted_end": "03:16:50.000",
      "text": "دونم قرص میخوری"
    },
    {
      "id": 30,
      "start": 11810.0,
      "end": 11840.0,
      "formatted_start": "03:16:50.000",
      "formatted_end": "03:17:20.000",
      "text": "از اینجا باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه باید بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه بردارید که اینکه برداری"
    },
    {
      "id": 31,
      "start": 11840.0,
      "end": 11842.0,
      "formatted_start": "03:17:20.000",
      "formatted_end": "03:17:22.000",
      "text": "قصد روش کرده؟ نه"
    },
    {
      "id": 32,
      "start": 11842.0,
      "end": 11844.0,
      "formatted_start": "03:17:22.000",
      "formatted_end": "03:17:24.000",
      "text": "روش نکرده؟ نه"
    },
    {
      "id": 33,
      "start": 11844.0,
      "end": 11846.0,
      "formatted_start": "03:17:24.000",
      "formatted_end": "03:17:26.000",
      "text": "قدش چند روی؟ قدش برن در خود"
    },
    {
      "id": 34,
      "start": 11846.0,
      "end": 11852.0,
      "formatted_start": "03:17:26.000",
      "formatted_end": "03:17:32.000",
      "text": "خب، اینو باید برای بروکش سونگرافی بکنیم ببینیم که وضعیت تختانش چجوری بود"
    },
    {
      "id": 35,
      "start": 11852.0,
      "end": 11854.0,
      "formatted_start": "03:17:32.000",
      "formatted_end": "03:17:34.000",
      "text": "دختر 11 ساله، الان همکراس ها شدن"
    },
    {
      "id": 36,
      "start": 11854.0,
      "end": 11856.0,
      "formatted_start": "03:17:34.000",
      "formatted_end": "03:17:36.000",
      "text": "الان مجموعه شدن"
    },
    {
      "id": 37,
      "start": 11856.0,
      "end": 11858.0,
      "formatted_start": "03:17:36.000",
      "formatted_end": "03:17:38.000",
      "text": "مجموعه چند روی؟"
    },
    {
      "id": 38,
      "start": 11858.0,
      "end": 11860.0,
      "formatted_start": "03:17:38.000",
      "formatted_end": "03:17:40.000",
      "text": "مجموعه میره هفته هم"
    },
    {
      "id": 39,
      "start": 11860.0,
      "end": 11862.0,
      "formatted_start": "03:17:40.000",
      "formatted_end": "03:17:42.000",
      "text": "همکراس هم همه عادت شدن میگه؟"
    },
    {
      "id": 40,
      "start": 11862.0,
      "end": 11875.56,
      "formatted_start": "03:17:42.000",
      "formatted_end": "03:17:55.560",
      "text": "همه نصره ها شدن. بازی ها شدن. هنجام ها شدن. شیشام ها شدن. میره هفتم. میره هفتم. اکسلا شدن. شیشام هفتم شدن. باید سونوگرافی بکنیم وضعیت اختبارشون رو ببینیم."
    },
    {
      "id": 41,
      "start": 11875.56,
      "end": 11887.5,
      "formatted_start": "03:17:55.560",
      "formatted_end": "03:18:07.500",
      "text": "اصابه شدن میتونه مربوط به وضعیت دختره ها میشه. با نقم از رکیبی کلن همیشه باید. باید کمی رگ سریعی کنیم. باید سونوگرافی انجام میدیم. باید سونوگرافی کنیم."
    },
    {
      "id": 42,
      "start": 11887.5,
      "end": 11889.92,
      "formatted_start": "03:18:07.500",
      "formatted_end": "03:18:09.920",
      "text": "من از این یه حالت دیگه اون حضورش نیست"
    },
    {
      "id": 43,
      "start": 11889.92,
      "end": 11894.08,
      "formatted_start": "03:18:09.920",
      "formatted_end": "03:18:14.080",
      "text": "من میگم مثلا خدا نکرده چون نقای کاشکالوسن بود"
    },
    {
      "id": 44,
      "start": 11894.08,
      "end": 11897.04,
      "formatted_start": "03:18:14.080",
      "formatted_end": "03:18:17.040",
      "text": "که مثلا تیری اصلا بیمی شد بچه بود"
    },
    {
      "id": 45,
      "start": 11897.04,
      "end": 11900.48,
      "formatted_start": "03:18:17.040",
      "formatted_end": "03:18:20.480",
      "text": "در موضوعش که اصلا بردیدن که مثلا بچه یک کمشکه و خونی داشت"
    },
    {
      "id": 46,
      "start": 11900.48,
      "end": 11902.06,
      "formatted_start": "03:18:20.480",
      "formatted_end": "03:18:22.060",
      "text": "یا مثلا یه چیزا نمی کنید"
    },
    {
      "id": 47,
      "start": 11902.06,
      "end": 11903.1,
      "formatted_start": "03:18:22.060",
      "formatted_end": "03:18:23.100",
      "text": "یا یه چه کار بکنید"
    },
    {
      "id": 48,
      "start": 11903.1,
      "end": 11904.86,
      "formatted_start": "03:18:23.100",
      "formatted_end": "03:18:24.860",
      "text": "یا آزمایش بگیم چون نمی کنید"
    },
    {
      "id": 49,
      "start": 11904.86,
      "end": 11906.44,
      "formatted_start": "03:18:24.860",
      "formatted_end": "03:18:26.440",
      "text": "نه ببینم چی رویه که چون نمی کنید"
    },
    {
      "id": 50,
      "start": 11906.44,
      "end": 11909.72,
      "formatted_start": "03:18:26.440",
      "formatted_end": "03:18:29.720",
      "text": "از اینجا با خودون صحبت میکنم که نقلها متوجه نشین"
    },
    {
      "id": 51,
      "start": 11909.72,
      "end": 11910.72,
      "formatted_start": "03:18:29.720",
      "formatted_end": "03:18:30.720",
      "text": "آره بخشیم"
    },
    {
      "id": 52,
      "start": 11910.72,
      "end": 11911.72,
      "formatted_start": "03:18:30.720",
      "formatted_end": "03:18:31.720",
      "text": "آره دستون نرمکانه"
    },
    {
      "id": 53,
      "start": 11911.72,
      "end": 11912.72,
      "formatted_start": "03:18:31.720",
      "formatted_end": "03:18:32.720",
      "text": "میشه"
    },
    {
      "id": 54,
      "start": 11912.72,
      "end": 11913.72,
      "formatted_start": "03:18:32.720",
      "formatted_end": "03:18:33.720",
      "text": "بیایید من وضعیت شدم"
    },
    {
      "id": 55,
      "start": 11913.72,
      "end": 11914.72,
      "formatted_start": "03:18:33.720",
      "formatted_end": "03:18:34.720",
      "text": "جانباش هم یه رو میشون بدن"
    },
    {
      "id": 56,
      "start": 11914.72,
      "end": 11915.72,
      "formatted_start": "03:18:34.720",
      "formatted_end": "03:18:35.720",
      "text": "باشه"
    },
    {
      "id": 57,
      "start": 11915.72,
      "end": 11916.72,
      "formatted_start": "03:18:35.720",
      "formatted_end": "03:18:36.720",
      "text": "دستون نرمکانه"
    },
    {
      "id": 58,
      "start": 11916.72,
      "end": 11917.72,
      "formatted_start": "03:18:36.720",
      "formatted_end": "03:18:37.720",
      "text": "بگیرین سفت کنم"
    },
    {
      "id": 59,
      "start": 11917.72,
      "end": 11918.72,
      "formatted_start": "03:18:37.720",
      "formatted_end": "03:18:38.720",
      "text": "سیستم سفت کنه"
    },
    {
      "id": 60,
      "start": 11918.72,
      "end": 11919.72,
      "formatted_start": "03:18:38.720",
      "formatted_end": "03:18:39.720",
      "text": "آره باشه باشه"
    },
    {
      "id": 61,
      "start": 11919.72,
      "end": 11920.72,
      "formatted_start": "03:18:39.720",
      "formatted_end": "03:18:40.720",
      "text": "برنامه چشم"
    },
    {
      "id": 62,
      "start": 11920.72,
      "end": 11921.72,
      "formatted_start": "03:18:40.720",
      "formatted_end": "03:18:41.720",
      "text": "برداری"
    },
    {
      "id": 63,
      "start": 11921.72,
      "end": 11922.72,
      "formatted_start": "03:18:41.720",
      "formatted_end": "03:18:42.720",
      "text": "این خانم تا تاریه"
    },
    {
      "id": 64,
      "start": 11922.72,
      "end": 11923.72,
      "formatted_start": "03:18:42.720",
      "formatted_end": "03:18:43.720",
      "text": "خانم بگیر برانوزگه رو تا تاریه"
    },
    {
      "id": 65,
      "start": 11923.72,
      "end": 11924.72,
      "formatted_start": "03:18:43.720",
      "formatted_end": "03:18:44.720",
      "text": "تا تاریه"
    },
    {
      "id": 66,
      "start": 11924.72,
      "end": 11954.72,
      "formatted_start": "03:18:44.720",
      "formatted_end": "03:19:14.720",
      "text": "همه زنشور ها برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداشت که برداش"
    },
    {
      "id": 67,
      "start": 11954.72,
      "end": 11977.72,
      "formatted_start": "03:19:14.720",
      "formatted_end": "03:19:37.720",
      "text": "از اینجور برگشت برگشت سهیده بود دیگه"
    },
    {
      "id": 68,
      "start": 11977.72,
      "end": 12000.0,
      "formatted_start": "03:19:37.720",
      "formatted_end": "03:20:00.000",
      "text": "بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، بله، ب"
    }
