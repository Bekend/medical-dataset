      "end": 8660.14,
      "formatted_start": "02:23:50.140",
      "formatted_end": "02:24:20.140",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 88,
      "start": 8660.14,
      "end": 8662.14,
      "formatted_start": "02:24:20.140",
      "formatted_end": "02:24:22.140",
      "text": "اینجورون باز بابرای نه ترسه"
    },
    {
      "id": 89,
      "start": 8662.14,
      "end": 8665.14,
      "formatted_start": "02:24:22.140",
      "formatted_end": "02:24:25.140",
      "text": "آره سه روز تر بی کنه و بعدش باید بیرزه بیرونه"
    },
    {
      "id": 90,
      "start": 8665.14,
      "end": 8670.14,
      "formatted_start": "02:24:25.140",
      "formatted_end": "02:24:30.140",
      "text": "اینجورون شیافه بی که کنار یه پنجه و نصف کنه و بزاره اینجور شو"
    },
    {
      "id": 91,
      "start": 8674.14,
      "end": 8676.14,
      "formatted_start": "02:24:34.140",
      "formatted_end": "02:24:36.140",
      "text": "خب سرنجا بفرما"
    },
    {
      "id": 92,
      "start": 8676.14,
      "end": 8679.64,
      "formatted_start": "02:24:36.140",
      "formatted_end": "02:24:39.640",
      "text": "نه من الان روز شیشه همه پیروزمه"
    },
    {
      "id": 93,
      "start": 8679.64,
      "end": 8682.84,
      "formatted_start": "02:24:39.640",
      "formatted_end": "02:24:42.840",
      "text": "پیروزمه من میشه سه روز بود چهار روز لکمه من"
    },
    {
      "id": 94,
      "start": 8682.84,
      "end": 8685.14,
      "formatted_start": "02:24:42.840",
      "formatted_end": "02:24:45.140",
      "text": "افراد این دیگه روزمه باستر میزنشم"
    },
    {
      "id": 95,
      "start": 8685.14,
      "end": 8691.14,
      "formatted_start": "02:24:45.140",
      "formatted_end": "02:24:51.140",
      "text": "اه، روز هفته هم، ها، من فکرم الان وسط"
    },
    {
      "id": 96,
      "start": 8691.14,
      "end": 8694.14,
      "formatted_start": "02:24:51.140",
      "formatted_end": "02:24:54.140",
      "text": "بین دو قایدگیه گفتم یه شماره بگیر"
    },
    {
      "id": 97,
      "start": 8694.14,
      "end": 8696.14,
      "formatted_start": "02:24:54.140",
      "formatted_end": "02:24:56.140",
      "text": "الان زمان عادتته؟"
    },
