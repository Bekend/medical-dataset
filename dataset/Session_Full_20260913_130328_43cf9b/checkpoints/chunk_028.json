  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8402.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:02.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 1,
      "start": 8402.0,
      "end": 8404.0,
      "formatted_start": "02:20:02.000",
      "formatted_end": "02:20:04.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 2,
      "start": 8404.0,
      "end": 8406.0,
      "formatted_start": "02:20:04.000",
      "formatted_end": "02:20:06.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 3,
      "start": 8406.0,
      "end": 8408.0,
      "formatted_start": "02:20:06.000",
      "formatted_end": "02:20:08.000",
      "text": "چی شده؟ خیلی سویده بیدید."
    },
    {
      "id": 4,
      "start": 8408.0,
      "end": 8410.0,
      "formatted_start": "02:20:08.000",
      "formatted_end": "02:20:10.000",
      "text": "چی شده؟ خیلی سویده بیدید."
    },
    {
      "id": 5,
      "start": 8410.0,
      "end": 8412.0,
      "formatted_start": "02:20:10.000",
      "formatted_end": "02:20:12.000",
      "text": "من یک موژه در روز رو روزمان دادم."
    },
    {
      "id": 6,
      "start": 8412.0,
      "end": 8414.0,
      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:14.000",
      "text": "من یک موژه در روز رو رو رو دادم."
    },
    {
      "id": 7,
      "start": 8414.0,
      "end": 8416.0,
      "formatted_start": "02:20:14.000",
      "formatted_end": "02:20:16.000",
      "text": "من یک موژه در رو رو دادم."
    },
    {
      "id": 8,
      "start": 8416.0,
      "end": 8418.0,
      "formatted_start": "02:20:16.000",
      "formatted_end": "02:20:18.000",
      "text": "نسخه تو نیرو بردی؟"
    },
    {
      "id": 9,
      "start": 8418.0,
      "end": 8420.0,
      "formatted_start": "02:20:18.000",
      "formatted_end": "02:20:20.000",
      "text": "نه."
    },
    {
      "id": 10,
      "start": 8420.0,
      "end": 8422.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:22.000",
      "text": "گفتی اطمین من یادمه دیگه به تو چی دادم."
    },
    {
      "id": 11,
      "start": 8422.0,
      "end": 8424.0,
      "formatted_start": "02:20:22.000",
      "formatted_end": "02:20:24.000",
      "text": "یک گلیز داشته بودم و تو بودیم"
    },
    {
      "id": 12,
      "start": 8424.0,
      "end": 8426.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:26.000",
      "text": "بعد هر سه ماه یک بار می آمده"
    },
    {
      "id": 13,
      "start": 8426.0,
      "end": 8428.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:28.000",
      "text": "منم یادمه"
    },
    {
      "id": 14,
      "start": 8428.0,
      "end": 8430.0,
      "formatted_start": "02:20:28.000",
      "formatted_end": "02:20:30.000",
      "text": "بعد قرصات تموم شده"
    },
    {
      "id": 15,
      "start": 8430.0,
      "end": 8432.0,
      "formatted_start": "02:20:30.000",
      "formatted_end": "02:20:32.000",
      "text": "دوباره سر از چی شده؟ می سوزه یا درد میکنه؟"
    },
    {
      "id": 16,
      "start": 8432.0,
      "end": 8434.0,
      "formatted_start": "02:20:32.000",
      "formatted_end": "02:20:34.000",
      "text": "نه"
    },
    {
      "id": 17,
      "start": 8434.0,
      "end": 8436.0,
      "formatted_start": "02:20:34.000",
      "formatted_end": "02:20:36.000",
      "text": "خود خود درد میکنه"
    },
    {
      "id": 18,
      "start": 8436.0,
      "end": 8438.0,
      "formatted_start": "02:20:36.000",
      "formatted_end": "02:20:38.000",
      "text": "درد میکنه؟"
    },
    {
      "id": 19,
      "start": 8438.0,
      "end": 8440.0,
      "formatted_start": "02:20:38.000",
      "formatted_end": "02:20:40.000",
      "text": "یک عکس هم گرفت"
    },
    {
      "id": 20,
      "start": 8440.0,
      "end": 8442.0,
      "formatted_start": "02:20:40.000",
      "formatted_end": "02:20:42.000",
      "text": "سینوزید داشت بوده"
    },
    {
      "id": 21,
      "start": 8442.0,
      "end": 8444.0,
      "formatted_start": "02:20:42.000",
      "formatted_end": "02:20:44.000",
      "text": "خب دیگه؟"
    },
    {
      "id": 22,
      "start": 8444.0,
      "end": 8446.0,
      "formatted_start": "02:20:44.000",
      "formatted_end": "02:20:46.000",
      "text": "بدن من هم کسه هست"
    },
    {
      "id": 23,
      "start": 8446.0,
      "end": 8448.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:48.000",
      "text": "بدنم درد میکنه"
    },
    {
      "id": 24,
      "start": 8448.0,
      "end": 8450.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:50.000",
      "text": "اگر او نه هم مالجه میشه که نه شده"
    },
    {
      "id": 25,
      "start": 8450.0,
      "end": 8452.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:52.000",
      "text": "برنامه بیاد خواستگیری"
    },
    {
      "id": 26,
      "start": 8452.0,
      "end": 8456.0,
      "formatted_start": "02:20:52.000",
      "formatted_end": "02:20:56.000",
      "text": "صبح بیدار میشه تا غلوم تا قرار توانده"
    },
    {
      "id": 27,
      "start": 8456.0,
      "end": 8458.0,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:20:58.000",
      "text": "دیگه چی؟ مدت چطوره؟"
    },
    {
      "id": 28,
      "start": 8458.0,
      "end": 8460.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:00.000",
      "text": "مدت خدا رو شکر کنم"
    },
    {
      "id": 29,
      "start": 8460.0,
      "end": 8462.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:02.000",
      "text": "تب نظر به طوله اسلامی بزنم"
    },
    {
      "id": 30,
      "start": 8462.0,
      "end": 8464.0,
      "formatted_start": "02:21:02.000",
      "formatted_end": "02:21:04.000",
      "text": "بودی و الان هم درامه اسلامی رو می کنی؟"
    },
    {
      "id": 31,
      "start": 8464.0,
      "end": 8466.0,
      "formatted_start": "02:21:04.000",
      "formatted_end": "02:21:06.000",
      "text": "نه دیگه با دفتر بیدم"
    },
    {
      "id": 32,
      "start": 8466.0,
      "end": 8468.0,
      "formatted_start": "02:21:06.000",
      "formatted_end": "02:21:08.000",
      "text": "باز گذار برم"
    },
    {
      "id": 33,
      "start": 8468.0,
      "end": 8470.0,
      "formatted_start": "02:21:08.000",
      "formatted_end": "02:21:10.000",
      "text": "بله"
    },
    {
      "id": 34,
      "start": 8470.0,
      "end": 8472.0,
      "formatted_start": "02:21:10.000",
      "formatted_end": "02:21:12.000",
      "text": "چشمت رو ببینم خانه"
    },
    {
      "id": 35,
      "start": 8472.0,
      "end": 8474.0,
      "formatted_start": "02:21:12.000",
      "formatted_end": "02:21:14.000",
      "text": "بخوانم باز کنم"
    },
    {
      "id": 36,
      "start": 8474.0,
      "end": 8476.0,
      "formatted_start": "02:21:14.000",
      "formatted_end": "02:21:16.000",
      "text": "دهنم باز کنم"
    },
    {
      "id": 37,
      "start": 8476.0,
      "end": 8478.0,
      "formatted_start": "02:21:16.000",
      "formatted_end": "02:21:18.000",
      "text": "دهنم سیزی باز کنم"
    },
    {
      "id": 38,
      "start": 8478.0,
      "end": 8483.46,
      "formatted_start": "02:21:18.000",
      "formatted_end": "02:21:23.460",
      "text": "ایشالله در نهایت که سوالی بود شب نکن دوباره درمش شروع میشه"
    },
    {
      "id": 39,
      "start": 8483.46,
      "end": 8486.9,
      "formatted_start": "02:21:23.460",
      "formatted_end": "02:21:26.900",
      "text": "بزرگ دو هفته دیگه که ادامه درمانه"
    },
    {
      "id": 40,
      "start": 8486.9,
      "end": 8490.46,
      "formatted_start": "02:21:26.900",
      "formatted_end": "02:21:30.460",
      "text": "آب دهن رو خفت بدیم"
    },
    {
      "id": 41,
      "start": 8490.46,
      "end": 8491.64,
      "formatted_start": "02:21:30.460",
      "formatted_end": "02:21:31.640",
      "text": "یه بار دیگه"
    },
    {
      "id": 42,
      "start": 8491.64,
      "end": 8494.58,
      "formatted_start": "02:21:31.640",
      "formatted_end": "02:21:34.580",
      "text": "لستون رو بزرگ سبت باز"
    },
    {
      "id": 43,
      "start": 8494.58,
      "end": 8507.14,
      "formatted_start": "02:21:34.580",
      "formatted_end": "02:21:47.140",
      "text": "همیشه دو کار هم نمند"
    },
    {
      "id": 44,
      "start": 8507.14,
      "end": 8509.14,
      "formatted_start": "02:21:47.140",
      "formatted_end": "02:21:49.140",
      "text": "هر دکتوری میری نسخه قبلی رو با خود میری"
    },
    {
      "id": 45,
      "start": 8509.14,
      "end": 8511.14,
      "formatted_start": "02:21:49.140",
      "formatted_end": "02:21:51.140",
      "text": "اما دکتورا دیگه نیاز نیست"
    },
    {
      "id": 46,
      "start": 8511.14,
      "end": 8513.14,
      "formatted_start": "02:21:51.140",
      "formatted_end": "02:21:53.140",
      "text": "اون دیگه نه"
    },
    {
      "id": 47,
      "start": 8513.14,
      "end": 8517.14,
      "formatted_start": "02:21:53.140",
      "formatted_end": "02:21:57.140",
      "text": "نه اونجور دکتور که میگه نیاز نیست نه"
    },
    {
      "id": 48,
      "start": 8517.14,
      "end": 8521.14,
      "formatted_start": "02:21:57.140",
      "formatted_end": "02:22:01.140",
      "text": "چون ما باید ادامه میدهن ما بیداریم چیه"
    },
    {
      "id": 49,
      "start": 8521.14,
      "end": 8523.14,
      "formatted_start": "02:22:01.140",
      "formatted_end": "02:22:03.140",
      "text": "اونا هلا به نسخه میاریم"
    },
    {
      "id": 50,
      "start": 8523.14,
      "end": 8525.14,
      "formatted_start": "02:22:03.140",
      "formatted_end": "02:22:05.140",
      "text": "شاید ها چند؟"
    },
    {
      "id": 51,
      "start": 8525.14,
      "end": 8527.14,
      "formatted_start": "02:22:05.140",
      "formatted_end": "02:22:07.140",
      "text": "یا آزده هرگز"
    },
    {
      "id": 52,
      "start": 8529.14,
      "end": 8531.14,
      "formatted_start": "02:22:09.140",
      "formatted_end": "02:22:11.140",
      "text": "مانمه بارانی پیو"
    },
    {
      "id": 53,
      "start": 8531.14,
      "end": 8533.14,
      "formatted_start": "02:22:11.140",
      "formatted_end": "02:22:13.140",
      "text": "نسخه قبلی رسیده"
    },
    {
      "id": 54,
      "start": 8533.14,
      "end": 8535.14,
      "formatted_start": "02:22:13.140",
      "formatted_end": "02:22:15.140",
      "text": "سلامتی"
    },
    {
      "id": 55,
      "start": 8535.14,
      "end": 8537.14,
      "formatted_start": "02:22:15.140",
      "formatted_end": "02:22:17.140",
      "text": "خوبه خوبه، از این روشی خوشی برم"
    },
    {
      "id": 56,
      "start": 8537.14,
      "end": 8541.14,
      "formatted_start": "02:22:17.140",
      "formatted_end": "02:22:21.140",
      "text": "این رو درد برم بسایی قبلش برم"
    },
    {
      "id": 57,
      "start": 8541.14,
      "end": 8543.14,
      "formatted_start": "02:22:21.140",
      "formatted_end": "02:22:23.140",
      "text": "از این روشی برم"
    },
    {
      "id": 58,
      "start": 8543.14,
      "end": 8547.14,
      "formatted_start": "02:22:23.140",
      "formatted_end": "02:22:27.140",
      "text": "گاره کردیم که اون شده اینقدر"
    },
    {
      "id": 59,
      "start": 8547.14,
      "end": 8551.14,
      "formatted_start": "02:22:27.140",
      "formatted_end": "02:22:31.140",
      "text": "این جیبه"
    },
